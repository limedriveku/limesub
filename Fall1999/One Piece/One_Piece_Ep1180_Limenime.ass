Dialogue: 0,0:00:21.28,0:00:23.32,sign,,0000,0000,0000,,[One Piece\NEpisode 1180]
Dialogue: 0,0:23:20.67,0:23:30.68,sign,,0000,0000,0000,,[Bersambung]
Dialogue: 0,0:00:11.81,0:00:15.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Berlarilah\Nsampai tiba di sana ♪
Dialogue: 0,0:00:15.31,0:00:19.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Sampai perasaanku\Ntersampaikan kepadamu ♪
Dialogue: 0,0:00:24.56,0:00:27.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Lautan yang begitu biru dan jernih ♪
Dialogue: 0,0:00:28.22,0:00:30.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Serpihan keajaiban yang bertebaran ♪
Dialogue: 0,0:00:31.62,0:00:34.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Jumlahnya tidak terhitung lagi ♪
Dialogue: 0,0:00:34.81,0:00:37.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Kita pun dipertemukan karenanya ♪
Dialogue: 0,0:00:37.72,0:00:40.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Perjalanan yang panjang\Nlangkah kaki tidak terhenti ♪
Dialogue: 0,0:00:40.44,0:00:44.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Titik akhir masih belum terlihat juga ♪
Dialogue: 0,0:00:44.38,0:00:47.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Namun kita pasti akan\Nmelompati segala rintangan ♪
Dialogue: 0,0:00:47.95,0:00:50.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Demi melihat senyuman itu ♪
Dialogue: 0,0:00:51.09,0:00:55.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Jika tenggelam dalam kebingungan\Ntidak akan bisa menerangi jalan di depan ♪
Dialogue: 0,0:00:55.26,0:00:58.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Mengolah kelemahanmu dengan teliti\Nhingga ia berubah menjadi nutrisi ♪
Dialogue: 0,0:00:59.07,0:01:04.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Kita yang berjuang sekuat tenaga\Ntetap saja ♪
Dialogue: 0,0:01:04.62,0:01:08.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Belum ada yang berubah ♪
Dialogue: 0,0:01:08.70,0:01:09.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Berlarilah ♪
Dialogue: 0,0:01:09.78,0:01:15.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Sampai tiba di sana\Nsampai perasaan tersampaikan kepadamu ♪
Dialogue: 0,0:01:17.27,0:01:23.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Meski belum menjadi legenda\Nmemangnya kenapa! ♪
Dialogue: 0,0:01:23.93,0:01:29.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Peta itu bersinar terang\Nsuatu hari kita menoleh sambil tersenyum ♪
Dialogue: 0,0:01:29.97,0:01:36.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Kini tidak lagi bimbang\Npara pejuang teruslah maju ke depan ♪
Dialogue: 0,0:01:51.78,0:01:52.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sommers.
Dialogue: 0,0:01:57.21,0:01:58.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Killingham.
Dialogue: 0,0:02:02.02,0:02:04.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Imu akan memperlihatkan kepada kalian...
Dialogue: 0,0:02:10.57,0:02:12.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Reversi dewa.
Dialogue: 0,0:02:15.84,0:02:23.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elbaph yang Putus Asa, Kontrak Iblis,\NDomi Reversi.
Dialogue: 0,0:02:27.70,0:02:28.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu kami.
Dialogue: 0,0:02:29.66,0:02:30.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak-anak.
Dialogue: 0,0:02:40.50,0:02:41.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketemu! Di sana!
Dialogue: 0,0:02:42.32,0:02:43.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak-anak!
Dialogue: 0,0:02:45.66,0:02:47.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Colon!
Dialogue: 0,0:02:49.27,0:02:51.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paman pemilik kedai arak!
Dialogue: 0,0:02:52.24,0:02:54.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah, kalian tidak apa-apa?
Dialogue: 0,0:02:54.38,0:02:55.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ylva!
Dialogue: 0,0:02:55.50,0:02:56.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu!
Dialogue: 0,0:02:56.70,0:02:58.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu.
Dialogue: 0,0:02:58.23,0:03:00.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau berjalan lagi!
Dialogue: 0,0:03:01.02,0:03:02.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayahku,
Dialogue: 0,0:03:04.08,0:03:07.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dijatuhkan ke Dunia Bawah!
Dialogue: 0,0:03:09.38,0:03:11.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Paman Ya-san...
Dialogue: 0,0:03:11.85,0:03:14.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya ulah siapa?
Dialogue: 0,0:03:16.25,0:03:17.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang itu yang melakukannya.
Dialogue: 0,0:03:18.25,0:03:20.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Wanita itu.\N- Wanita itu.
Dialogue: 0,0:03:21.57,0:03:24.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sangat kuat, hati-hati!
Dialogue: 0,0:03:26.94,0:03:28.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melayang di udara?
Dialogue: 0,0:03:29.04,0:03:32.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lupakan itu dulu,\Nmenyelamatkan anak-anak lebih penting.
Dialogue: 0,0:03:33.03,0:03:34.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian pasti ketakutan.
Dialogue: 0,0:03:34.48,0:03:36.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan segera membawamu pergi dari sini.
Dialogue: 0,0:03:46.38,0:03:46.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:03:47.14,0:03:48.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paman, kau kenapa?
Dialogue: 0,0:03:50.32,0:03:51.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku segera datang.
Dialogue: 0,0:03:51.40,0:03:52.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sentuh!
Dialogue: 0,0:03:54.65,0:03:55.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa sebenarnya?
Dialogue: 0,0:03:56.59,0:03:59.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada sesuatu di sekitar anak-anak.
Dialogue: 0,0:04:18.57,0:04:19.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berisik sekali.
Dialogue: 0,0:04:30.86,0:04:31.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini adalah...
Dialogue: 0,0:04:32.76,0:04:33.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei.
Dialogue: 0,0:04:37.71,0:04:39.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Jarul, ini...
Dialogue: 0,0:04:49.81,0:04:51.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bajingan!
Dialogue: 0,0:05:18.09,0:05:20.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak boleh ada perlawanan.
Dialogue: 0,0:05:22.77,0:05:23.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Killingham.
Dialogue: 0,0:05:24.57,0:05:27.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Monster mimpi burukmu\Nhanya sebegini kemampuannya?
Dialogue: 0,0:05:28.21,0:05:34.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, Tuan.\NBeberapa lubang mimpi buruk masih terbuka.
Dialogue: 0,0:05:37.96,0:05:41.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makhluk dalam mimpi ini\Ntidak mengenal konsep kematian.
Dialogue: 0,0:05:42.04,0:05:46.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan satu perintahku, mereka semua\Nbisa dihidupkan kembali kapan saja.
Dialogue: 0,0:05:50.65,0:05:55.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sommers, pimpin kelompok anak-anak itu.
Dialogue: 0,0:05:55.90,0:05:57.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, aku segera pergi.
Dialogue: 0,0:06:00.91,0:06:03.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang itu ternyata masih hidup.
Dialogue: 0,0:06:03.44,0:06:04.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana bisa?
Dialogue: 0,0:06:08.88,0:06:12.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial, sakit sekali, bajingan Gaban itu.
Dialogue: 0,0:06:12.91,0:06:19.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masalahnya, kita harus bernegosiasi dengan\Nsiapa jika anak-anak dijadikan umpan?
Dialogue: 0,0:06:22.04,0:06:24.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anda benar, Tuan.
Dialogue: 0,0:06:25.17,0:06:28.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan tidak ada raja,\Nnegara ini benar-benar tidak normal.
Dialogue: 0,0:06:43.25,0:06:45.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang ada di langit adalah\Nwanita tadi, 'kan?
Dialogue: 0,0:06:46.04,0:06:48.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia terlihat sangat berbeda sekarang.
Dialogue: 0,0:06:48.50,0:06:50.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di mana Luffy dan yang lain sekarang?
Dialogue: 0,0:06:51.17,0:06:55.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luffy, Zoro, dan Sanji sekarang...
Dialogue: 0,0:06:55.21,0:06:56.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada di sini.
Dialogue: 0,0:06:56.90,0:06:59.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Hajrudin dan yang lain\Njuga tidak ada.
Dialogue: 0,0:06:59.40,0:07:03.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di saat ini, mereka semua malah pergi\Nke Dunia Bawah yang jauh di bawah sana.
Dialogue: 0,0:07:19.83,0:07:23.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Robin, apa yang kau lakukan?\NSudah kubilang jangan gegabah.
Dialogue: 0,0:07:23.68,0:07:25.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus melakukan sesuatu.
Dialogue: 0,0:07:25.44,0:07:30.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak tahan terus terjebak\Nseperti ini.
Dialogue: 0,0:07:36.74,0:07:38.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terobos dari jalur samping.
Dialogue: 0,0:07:39.64,0:07:41.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manusia bertubuh kecil?
Dialogue: 0,0:07:43.14,0:07:44.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dorry si Raksasa Biru.
Dialogue: 0,0:07:46.54,0:07:48.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Brogy si Raksasa Merah.
Dialogue: 0,0:07:49.88,0:07:53.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Imu memerintahkan kalian\Nuntuk memerintah negara ini.
Dialogue: 0,0:07:54.80,0:07:57.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadilah raja-raja negara ini.
Dialogue: 0,0:07:59.96,0:08:03.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau manusia bertubuh kecil\Nyang tidak jelas asal-usulnya.
Dialogue: 0,0:08:06.21,0:08:09.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau anggota Kelompok Kesatria Dewa, ya?
Dialogue: 0,0:08:12.04,0:08:16.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kaulah yang membuat Elbaph kami kacau?
Dialogue: 0,0:08:16.15,0:08:17.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemimpin.
Dialogue: 0,0:08:17.57,0:08:18.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Brogy.
Dialogue: 0,0:08:18.83,0:08:22.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dorry, semuanya, cepat ke tempat\NColon dan yang lainnya.
Dialogue: 0,0:08:22.97,0:08:24.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hati-hati!
Dialogue: 0,0:08:24.74,0:08:25.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kami yang urus.
Dialogue: 0,0:08:29.11,0:08:34.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kembalikan anak-anak itu.\NMasih ada berapa banyak lagi rekanmu?
Dialogue: 0,0:08:34.39,0:08:40.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengar, Brogy.\NCari Jarul si Jenggot Gunung.
Dialogue: 0,0:08:42.14,0:08:44.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tebas kepalanya.
Dialogue: 0,0:08:45.96,0:08:47.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Angkat tinggi-tinggi.
Dialogue: 0,0:08:54.36,0:08:57.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Umumkan kepada rakyat
Dialogue: 0,0:08:59.48,0:09:02.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bahwa kalian adalah raja-raja Elbaph.
Dialogue: 0,0:09:03.81,0:09:12.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong kosong! Urusan negara kami\Nbukan hakmu untuk menentukan!
Dialogue: 0,0:09:47.34,0:09:50.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja bukan dengan wujudmu\Nyang sekarang.
Dialogue: 0,0:10:20.26,0:10:22.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Imu akan memberimu kekuatan dewa.
Dialogue: 0,0:10:36.69,0:10:38.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tangan pemimpin.
Dialogue: 0,0:10:39.22,0:10:40.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemimpin!
Dialogue: 0,0:10:48.12,0:10:54.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di bawah reversi Imu,\Ndengan mengorbankan sebagian umurmu,
Dialogue: 0,0:10:55.95,0:11:01.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan memberimu tubuh abadi\Ndan kekuatan di luar batas manusia biasa.
Dialogue: 0,0:11:06.19,0:11:09.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu jangan sombong!
Dialogue: 0,0:11:13.09,0:11:16.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akal sehat dan logika\Ntidak akan lagi membelenggumu.
Dialogue: 0,0:11:18.22,0:11:22.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iblis adalah satu-satunya wujud\Nyang semestinya dimiliki kehidupan.
Dialogue: 0,0:11:27.95,0:11:29.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kontrak Iblis.
Dialogue: 0,0:11:38.08,0:11:39.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini sebenarnya?
Dialogue: 0,0:11:40.34,0:11:43.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tadi menyebut iblis.\NApa yang ingin dia lakukan?
Dialogue: 0,0:12:00.66,0:12:05.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada... ada apa ini? Aku... aku tenggelam.
Dialogue: 0,0:12:06.41,0:12:07.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemimpin!
Dialogue: 0,0:12:21.96,0:12:24.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Domi Reversi.
Dialogue: 0,0:12:49.62,0:12:51.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemimpin!
Dialogue: 0,0:13:00.44,0:13:05.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tu... tunggu!
Dialogue: 0,0:13:18.62,0:13:19.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pe...
Dialogue: 0,0:13:21.82,0:13:22.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mimpin!
Dialogue: 0,0:14:02.62,0:14:06.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be... besar sekali!
Dialogue: 0,0:14:07.45,0:14:11.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, lihat! Tangannya melayang!
Dialogue: 0,0:14:11.56,0:14:12.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:14:12.31,0:14:17.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajahnya juga menakutkan.\NApa dia benar-benar berubah jadi iblis?
Dialogue: 0,0:14:17.93,0:14:20.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minggir, kalian sampah.
Dialogue: 0,0:14:23.04,0:14:27.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemimpin Brogy, kau tidak pernah\Nmenyerang kawanmu.
Dialogue: 0,0:14:27.74,0:14:29.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di mana kebanggaan pejuangmu?
Dialogue: 0,0:14:45.87,0:14:50.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya aku bisa melakukan apa saja.\NKenapa aku merasa begitu bersemangat?
Dialogue: 0,0:14:53.87,0:14:56.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Brogy!
Dialogue: 0,0:15:00.35,0:15:03.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau juga, kembalilah ke wujud iblis.
Dialogue: 0,0:15:04.08,0:15:05.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang ingin kau lakukan?
Dialogue: 0,0:15:07.31,0:15:09.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kontrak Iblis.
Dialogue: 0,0:15:12.15,0:15:14.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemimpin Dorry juga terkena.
Dialogue: 0,0:15:15.85,0:15:16.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Dorry.
Dialogue: 0,0:15:20.21,0:15:25.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pergi bunuh Jarul. Semuanya, ikut aku!
Dialogue: 0,0:15:25.97,0:15:27.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, Pemimpin.
Dialogue: 0,0:15:27.76,0:15:29.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat sadarlah.
Dialogue: 0,0:15:30.29,0:15:33.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kau melakukan itu,\Ntidak ada jalan kembali.
Dialogue: 0,0:15:33.42,0:15:35.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tidak menyelamatkan anak-anak lagi?
Dialogue: 0,0:15:44.45,0:15:47.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial, bahkan kalian juga...
Dialogue: 0,0:15:53.53,0:15:55.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, hei.
Dialogue: 0,0:15:55.51,0:15:58.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa karena terjepit\Ndi antara mereka berdua?
Dialogue: 0,0:15:58.59,0:16:00.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin.
Dialogue: 0,0:16:00.60,0:16:01.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat menjauh.
Dialogue: 0,0:16:18.87,0:16:20.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lumayan.
Dialogue: 0,0:16:22.36,0:16:23.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inilah
Dialogue: 0,0:16:27.98,0:16:29.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kekuatan Elbaph?
Dialogue: 0,0:16:31.74,0:16:35.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Negara ini tidak akan hancur.\NImu akan memerintahnya.
Dialogue: 0,0:16:35.97,0:16:42.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi lihat dulu seberapa berguna\Norang-orang ini dalam perang.
Dialogue: 0,0:16:51.41,0:16:53.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemimpin Dorry dan Brogy terlihat aneh.
Dialogue: 0,0:16:54.15,0:16:56.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat, suruh semua orang berlindung.
Dialogue: 0,0:16:56.16,0:16:57.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengerti.
Dialogue: 0,0:16:59.33,0:17:03.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya, cepat lari! Menjauh!
Dialogue: 0,0:17:04.35,0:17:07.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anda dengar, 'kan?\NTuan Jarul, Anda juga harus segera lari.
Dialogue: 0,0:17:10.08,0:17:10.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Jarul.
Dialogue: 0,0:17:13.97,0:17:18.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan suruh pejuang\Nlari dari pertarungan.
Dialogue: 0,0:17:21.04,0:17:22.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bunuh.
Dialogue: 0,0:17:23.55,0:17:28.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan lari, dasar sampah!
Dialogue: 0,0:17:28.79,0:17:30.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, para pemimpin.
Dialogue: 0,0:17:30.82,0:17:35.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Jarul adalah pejuang tertua di dunia,\Npahlawan legendaris.
Dialogue: 0,0:17:35.63,0:17:38.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah dia orang\Nyang selalu kita kagumi?
Dialogue: 0,0:17:39.58,0:17:41.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, Kashii.
Dialogue: 0,0:17:41.39,0:17:42.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu kenapa?
Dialogue: 0,0:17:42.57,0:17:46.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pejuang yang dulu kita kagumi\Nsudah tua dan tak berguna.
Dialogue: 0,0:17:46.91,0:17:50.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi harus mengirimnya\Nke alam baka, lalu...
Dialogue: 0,0:17:50.97,0:17:55.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akan menjadi raja-raja Elbaph.
Dialogue: 0,0:17:55.31,0:17:57.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elbaph tidak butuh dewa.
Dialogue: 0,0:17:57.89,0:18:04.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari hadirkan era perang,\Nmembangun era bagi yang kuat.
Dialogue: 0,0:18:11.76,0:18:13.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah bertambah banyak lagi?
Dialogue: 0,0:18:13.28,0:18:16.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kali ini masalahnya menjadi besar.
Dialogue: 0,0:18:43.40,0:18:44.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin.
Dialogue: 0,0:18:46.10,0:18:50.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan ini?
Dialogue: 0,0:18:51.57,0:18:55.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan wujud seperti ini, mana mungkin\Nmasih ada kebanggaan seorang pejuang?
Dialogue: 0,0:18:58.15,0:19:05.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa... apa yang kalian lakukan\Npada tanah air kalian sendiri?
Dialogue: 0,0:19:10.13,0:19:11.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat sadarlah!
Dialogue: 0,0:19:12.45,0:19:17.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guru Dorry! Guru Brogy!
Dialogue: 0,0:19:29.50,0:19:34.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan, sampai sejauh mana\Npermainan ini akan kita lanjutkan?
Dialogue: 0,0:19:40.82,0:19:43.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Papan permainan sudah dikuasai pihak kita.
Dialogue: 0,0:19:45.34,0:19:48.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kita sengaja membiarkan\Nmimpi buruk mereka sendiri,
Dialogue: 0,0:19:48.38,0:19:51.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mereka kemungkinan besar\Nakan menghancurkan diri sendiri.
Dialogue: 0,0:19:52.71,0:19:54.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai mereka hancur.
Dialogue: 0,0:19:59.15,0:20:01.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menghancurkan apa?
Dialogue: 0,0:20:09.22,0:20:11.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kehendak Elbaph.
Dialogue: 0,0:20:15.10,0:20:20.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Andai Harald tidak gagal saat itu,
Dialogue: 0,0:20:41.61,0:20:44.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}negara ini sudah lama\Nberada di bawah kekuasaan Imu.
Dialogue: 0,0:21:03.47,0:21:12.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Berusaha keras membuka mata lebar-lebar\Nuntuk memastikan situasi di depan ♪
Dialogue: 0,0:21:14.38,0:21:22.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Otak penuh khayalan dan keputusasaan\Nentah kenapa selalu agak menyimpang ♪
Dialogue: 0,0:21:22.49,0:21:31.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Kenangan-kenangan buruk selalu\Nmuncul kembali dengan sangat jelas ♪
Dialogue: 0,0:21:33.41,0:21:41.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Memunguti kebosanan tidak berarti\Nrasanya hampir jadi orang lain ♪
Dialogue: 0,0:21:42.91,0:21:45.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Masa depan seperti apa\Nyang sebenarnya menjadi milikku ♪
Dialogue: 0,0:21:45.99,0:21:52.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Berdiri di sini dan sejauh apa pun\Nmencari tetap tidak terlihat ♪
Dialogue: 0,0:21:52.19,0:22:02.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Menentang angin dan robek ilusi salah\Nserta membuangnya ke celah takdir ♪
Dialogue: 0,0:22:03.09,0:22:11.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Orang-orang terus berputar dalam siklus\Nkenyataan yang begitu keras ini ♪
Dialogue: 0,0:22:11.22,0:22:18.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Hari esok begitu riuh hingga tidak ada\Nwaktu untuk berdoa akan segera tiba ♪
Dialogue: 0,0:22:18.42,0:22:27.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Lihat masa depan itu\Nkarena ia adalah milikku ♪
Dialogue: 0,0:22:36.95,0:22:38.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang kedua sudah matang.
Dialogue: 0,0:22:39.59,0:22:41.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sampai lelah menunggu.
Dialogue: 0,0:22:41.35,0:22:44.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, hei, pendekar pedang berengsek.\NBiarkan Nona Gerth makan dulu.
Dialogue: 0,0:22:44.39,0:22:47.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan mempermasalahkan hal sepele.\NNanti kau bisa botak.
Dialogue: 0,0:22:47.51,0:22:48.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa katamu, bajingan?
Dialogue: 0,0:22:48.82,0:22:53.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, cepat ambilkan untukku!\NAku tidak bisa bergerak.
Dialogue: 0,0:22:53.37,0:22:56.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar, benar-benar tidak ada cara\Nmenghadapi orang ini.
