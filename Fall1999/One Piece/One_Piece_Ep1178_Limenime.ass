Dialogue: 0,0:00:21.28,0:00:23.32,sign,,0000,0000,0000,,[One Piece\NEpisode 1178]
Dialogue: 0,0:21:24.65,0:21:30.70,sign,,0000,0000,0000,,[Bersambung]
Dialogue: 0,0:23:21.98,0:23:30.82,sign,,0000,0000,0000,,[Satu Detik Menentukan,\NGaban VS Kelompok Kesatria Dewa]
Dialogue: 0,0:00:11.81,0:00:15.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Berlarilah\Nsampai tiba di sana ♪
Dialogue: 0,0:00:15.31,0:00:19.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Sampai perasaanku\Ntersampaikan kepadamu ♪
Dialogue: 0,0:00:24.56,0:00:27.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Lautan yang begitu biru dan jernih ♪
Dialogue: 0,0:00:28.22,0:00:30.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Serpihan keajaiban yang bertebaran ♪
Dialogue: 0,0:00:31.62,0:00:34.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Jumlahnya tidak terhitung lagi ♪
Dialogue: 0,0:00:34.81,0:00:37.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Kita pun dipertemukan karenanya ♪
Dialogue: 0,0:00:37.72,0:00:40.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Perjalanan yang panjang\Nlangkah kaki tidak terhenti ♪
Dialogue: 0,0:00:40.44,0:00:44.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Titik akhir masih belum terlihat juga ♪
Dialogue: 0,0:00:44.38,0:00:47.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Namun kita pasti akan\Nmelompati segala rintangan ♪
Dialogue: 0,0:00:47.95,0:00:50.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Demi melihat senyuman itu ♪
Dialogue: 0,0:00:51.09,0:00:55.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Jika tenggelam dalam kebingungan\Ntidak akan bisa menerangi jalan di depan ♪
Dialogue: 0,0:00:55.26,0:00:58.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Mengolah kelemahanmu dengan teliti\Nhingga ia berubah menjadi nutrisi ♪
Dialogue: 0,0:00:59.07,0:01:04.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Kita yang berjuang sekuat tenaga\Ntetap saja ♪
Dialogue: 0,0:01:04.62,0:01:08.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Belum ada yang berubah ♪
Dialogue: 0,0:01:08.70,0:01:09.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Berlarilah ♪
Dialogue: 0,0:01:09.78,0:01:15.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Sampai tiba di sana\Nsampai perasaan tersampaikan kepadamu ♪
Dialogue: 0,0:01:17.27,0:01:23.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Meski belum menjadi legenda\Nmemangnya kenapa! ♪
Dialogue: 0,0:01:23.93,0:01:29.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Peta itu bersinar terang\Nsuatu hari kita menoleh sambil tersenyum ♪
Dialogue: 0,0:01:29.97,0:01:36.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Kini tidak lagi bimbang\Npara pejuang teruslah maju ke depan ♪
Dialogue: 0,0:01:41.66,0:01:49.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melindungi Sejarah dan Masa Depan,\NRobin dan Gaban Menyerang.
Dialogue: 0,0:02:21.45,0:02:22.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:02:23.62,0:02:26.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku selalu merasa\Nakan ada sesuatu yang terjadi.
Dialogue: 0,0:02:41.09,0:02:42.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak panah.
Dialogue: 0,0:02:43.26,0:02:44.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan!
Dialogue: 0,0:03:04.34,0:03:04.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh.
Dialogue: 0,0:03:05.66,0:03:06.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh.
Dialogue: 0,0:03:07.19,0:03:08.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, eh, eh.
Dialogue: 0,0:03:11.62,0:03:12.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ronja?
Dialogue: 0,0:03:13.04,0:03:14.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau berjalan ke arah sana?
Dialogue: 0,0:03:15.15,0:03:17.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak tahu, kakiku bergerak sendiri.
Dialogue: 0,0:03:19.64,0:03:20.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa, Ronja.
Dialogue: 0,0:03:21.38,0:03:22.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat kembali.
Dialogue: 0,0:03:23.10,0:03:25.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ronja, kau sedang apa?
Dialogue: 0,0:03:26.60,0:03:28.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya ada apa ini? Aneh sekali.
Dialogue: 0,0:03:29.49,0:03:31.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ronja, kau akan jatuh!
Dialogue: 0,0:03:31.55,0:03:32.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan!
Dialogue: 0,0:03:33.36,0:03:36.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ylva, jangan menangis. Aku tidak apa-apa.
Dialogue: 0,0:03:38.91,0:03:40.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak apa-apa, tidak perlu khawatir.
Dialogue: 0,0:03:40.96,0:03:43.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti tidak akan terjadi apa-apa.\NTidak apa-apa.
Dialogue: 0,0:03:52.72,0:03:54.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin kau baik-baik saja!
Dialogue: 0,0:03:54.86,0:03:57.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ronja, di bawah itu adalah Dunia Bawah!
Dialogue: 0,0:03:57.29,0:03:59.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat kembali! Bahaya!
Dialogue: 0,0:04:08.68,0:04:09.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah berhenti.
Dialogue: 0,0:04:35.04,0:04:38.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sommers, persiapan untuk menjatuhkan\Nanak pertama sudah selesai.
Dialogue: 0,0:04:38.78,0:04:42.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus. Biarkan seluruh Elbaph\Nmendengar suaranya.
Dialogue: 0,0:04:42.92,0:04:44.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ronja!
Dialogue: 0,0:04:44.07,0:04:46.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat kembali, Ronja!
Dialogue: 0,0:05:04.41,0:05:08.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya, jangan khawatir.\NIni tidak apa-apa.
Dialogue: 0,0:05:09.69,0:05:13.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh tidak apa-apa. Aku tidak apa-apa.
Dialogue: 0,0:05:17.28,0:05:22.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, kalian semua sudah dengar.\NCepatlah buat keputusan.
Dialogue: 0,0:05:23.01,0:05:26.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak, anak pertama\Nakan kudorong ke bawah.
Dialogue: 0,0:05:31.69,0:05:36.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jarul si Jenggot Gunung, berikan perintah\Nkepada guru-guru di sekolah.
Dialogue: 0,0:05:40.30,0:05:42.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beraninya melakukan hal seperti ini!
Dialogue: 0,0:06:05.36,0:06:09.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perpustakaan itu simpan tulisan-tulisan\Npara pendahulu selama ribuan tahun.
Dialogue: 0,0:06:09.25,0:06:11.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja nyawa manusia lebih penting!\NApa yang kau katakan?
Dialogue: 0,0:06:11.95,0:06:13.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan itu inti masalahnya.
Dialogue: 0,0:06:13.83,0:06:18.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini hal besar yang akan tentukan Elbaph\Nakan tunduk kepada mereka atau tidak.
Dialogue: 0,0:06:18.39,0:06:20.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah demi itu,\Nnyawa anak-anak harus menjadi taruhannya?
Dialogue: 0,0:06:20.95,0:06:23.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hal seperti itu sama sekali\Ntidak boleh dibiarkan!
Dialogue: 0,0:06:23.36,0:06:28.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada orang di sekitar sini?\NCepat hentikan permainan gila ini!
Dialogue: 0,0:06:36.42,0:06:38.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chopper, kau tetap di sini.
Dialogue: 0,0:06:38.92,0:06:40.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Tetapi...
Dialogue: 0,0:06:41.13,0:06:46.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu. Kita tak boleh menyerang sebelum\Nmengetahui kemampuan mereka berdua.
Dialogue: 0,0:06:46.31,0:06:46.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena demikian...
Dialogue: 0,0:06:46.90,0:06:47.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetapi...
Dialogue: 0,0:06:49.81,0:06:52.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah tidak bisa tahan lagi.
Dialogue: 0,0:06:53.88,0:06:56.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baru mulai saja kalian sudah menjadikan\Nanak-anak sebagai sandera.
Dialogue: 0,0:06:56.85,0:06:59.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya seberapa gilanya kalian ini?
Dialogue: 0,0:06:59.02,0:07:02.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bahkan mau mendorongnya ke bawah?\NKau sudah gila?
Dialogue: 0,0:07:06.60,0:07:09.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Percuma saja kalian, manusia rendahan,\Nmenggurui aku soal moral.
Dialogue: 0,0:07:09.91,0:07:11.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bocah ini...
Dialogue: 0,0:07:11.51,0:07:16.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di saat seperti ini, apa yang sebenarnya\Nsedang dilakukan Luffy dan yang lainnya?
Dialogue: 0,0:07:18.21,0:07:20.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik. Kita juga pergi.
Dialogue: 0,0:07:26.71,0:07:27.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu.
Dialogue: 0,0:07:27.90,0:07:28.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial.
Dialogue: 0,0:07:51.61,0:07:55.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Franky Radikaru Bimu!
Dialogue: 0,0:08:01.63,0:08:02.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Franky!
Dialogue: 0,0:08:04.99,0:08:09.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beraninya kau menjadikan anak-anak\Nsebagai alat tukar-menukar. Sungguh keji.
Dialogue: 0,0:08:09.91,0:08:11.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Franky, aku juga pergi.
Dialogue: 0,0:08:12.33,0:08:14.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu. Cepat pergi.
Dialogue: 0,0:08:15.57,0:08:16.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hmm.
Dialogue: 0,0:08:18.75,0:08:20.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami juga pergi.
Dialogue: 0,0:08:21.39,0:08:23.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu kelompok menghadapi monster.
Dialogue: 0,0:08:24.65,0:08:25.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu.
Dialogue: 0,0:08:26.08,0:08:29.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelompok lainnya\Npergi menyelamatkan anak-anak.
Dialogue: 0,0:08:32.00,0:08:37.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Angkat senjata! Tidak mungkin kita\Nmembiarkan orang luar seenaknya di sini!
Dialogue: 0,0:08:37.29,0:08:38.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Angkat senjata!
Dialogue: 0,0:08:38.27,0:08:38.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat lari!
Dialogue: 0,0:08:38.98,0:08:40.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan menyerah! Angkat senjata!
Dialogue: 0,0:08:40.88,0:08:41.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pergi ke mana?
Dialogue: 0,0:08:41.78,0:08:42.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rute Cabang 8.
Dialogue: 0,0:08:42.65,0:08:43.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami juga pergi.
Dialogue: 0,0:08:43.90,0:08:44.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu kami!
Dialogue: 0,0:08:44.83,0:08:45.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak-anak!
Dialogue: 0,0:08:45.87,0:08:48.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jalankan kapalnya!
Dialogue: 0,0:08:54.68,0:08:57.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat pergi ke Rute Cabang 8!
Dialogue: 0,0:09:01.48,0:09:03.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat lari! Cepat lari!
Dialogue: 0,0:09:04.06,0:09:06.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak-anak, kami segera datang!
Dialogue: 0,0:09:09.52,0:09:10.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ronja.
Dialogue: 0,0:09:16.40,0:09:22.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, jangan bawa satu pun buku\Nsaat membakar sekolah dan perpustakaan.
Dialogue: 0,0:09:23.04,0:09:26.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena yang akan kami bakar adalah
Dialogue: 0,0:09:27.12,0:09:30.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}budaya dan sejarah kalian.
Dialogue: 0,0:09:38.27,0:09:39.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cien Fleur
Dialogue: 0,0:09:42.02,0:09:43.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Craspedia.
Dialogue: 0,0:10:00.98,0:10:01.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Robin!
Dialogue: 0,0:10:02.37,0:10:05.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Robin, Anda baik-baik saja?
Dialogue: 0,0:10:05.28,0:10:09.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hati-hati. Kita masih belum tahu\Nseluk-beluk kedua orang ini.
Dialogue: 0,0:10:11.89,0:10:13.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, aku mengerti.
Dialogue: 0,0:10:15.77,0:10:16.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau adalah...
Dialogue: 0,0:10:23.89,0:10:24.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuatro Mano
Dialogue: 0,0:10:25.62,0:10:27.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nico Rob...
Dialogue: 0,0:10:27.09,0:10:27.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Clutch!
Dialogue: 0,0:10:37.68,0:10:39.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus sekali, Robin.
Dialogue: 0,0:10:39.46,0:10:41.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bunyi retaknya jelas sekali.
Dialogue: 0,0:10:45.61,0:10:46.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:10:46.91,0:10:47.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum selesai.
Dialogue: 0,0:11:05.67,0:11:07.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial. Apakah orang itu juga zombi?
Dialogue: 0,0:11:07.66,0:11:09.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya makhluk apa mereka itu?
Dialogue: 0,0:11:13.19,0:11:16.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar. Berani-beraninya membuat\Nkeributan sebesar ini.
Dialogue: 0,0:11:19.29,0:11:21.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elbaph, bisa terdengar?
Dialogue: 0,0:11:22.31,0:11:24.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jarul, kenapa tidak menjawab?
Dialogue: 0,0:11:26.54,0:11:29.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka abadi. Kita tidak mungkin menang.
Dialogue: 0,0:11:39.35,0:11:43.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, apa yang ingin kau lakukan?\NApa kau jatuh cinta padaku?
Dialogue: 0,0:12:20.58,0:12:22.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kau lakukan, Robin?
Dialogue: 0,0:12:22.14,0:12:25.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana mungkin?\NIni seperti ingin mati bersama?
Dialogue: 0,0:12:26.43,0:12:28.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa-bisanya dia melompat!
Dialogue: 0,0:12:28.21,0:12:29.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau ingin mati?
Dialogue: 0,0:12:30.38,0:12:34.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebesar apa pun cintamu padaku,\Naku tidak mau mati bersama demi cinta.
Dialogue: 0,0:12:36.88,0:12:41.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah tahu kau orang yang hidup abadi\Ndan juga pengguna kekuatan Iba Iba no Mi.
Dialogue: 0,0:12:42.33,0:12:44.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau duri-duri tak terlihat itu lenyap,
Dialogue: 0,0:12:46.12,0:12:48.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami akan bisa menyelamatkan anak-anak.
Dialogue: 0,0:12:52.04,0:12:54.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, kau ingin melemparku ke bawah
Dialogue: 0,0:12:54.62,0:12:57.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}supaya anak-anak itu\Nkeluar dari jangkauan kemampuanku?
Dialogue: 0,0:12:58.29,0:13:00.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wanita yang sangat cerdas.
Dialogue: 0,0:13:14.07,0:13:15.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia menghilang!
Dialogue: 0,0:13:17.28,0:13:22.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya sudah sejauh apa wanita itu\Nmemperhitungkan semuanya?
Dialogue: 0,0:13:39.67,0:13:42.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Robin keren sekali,\Nsampai membuatku terpesona.
Dialogue: 0,0:13:45.39,0:13:47.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa. Tidak bisa dipotong.
Dialogue: 0,0:13:48.30,0:13:52.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar saja. Seberapa keras apa pun aku\Nberusaha, ini tak bergerak sedikit pun.
Dialogue: 0,0:13:52.62,0:13:57.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya, harus menumbangkan\Nwanita itu untuk melepaskannya.
Dialogue: 0,0:13:59.48,0:14:02.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah masih perlu hitungan mundur?
Dialogue: 0,0:14:04.59,0:14:05.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suara makhluk itu.
Dialogue: 0,0:14:13.52,0:14:14.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jawab aku.
Dialogue: 0,0:14:19.44,0:14:20.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jarul!
Dialogue: 0,0:14:26.63,0:14:29.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Gunko, biarkan mereka mendengar\Nsuara anak itu.
Dialogue: 0,0:14:34.90,0:14:35.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei.
Dialogue: 0,0:14:43.27,0:14:44.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katakan sesuatu.
Dialogue: 0,0:15:02.63,0:15:03.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Jarul.
Dialogue: 0,0:15:11.89,0:15:15.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ronja!
Dialogue: 0,0:15:20.82,0:15:21.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku
Dialogue: 0,0:15:25.28,0:15:26.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sangat menyukai sekolah.
Dialogue: 0,0:15:27.55,0:15:29.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena di sana ada teman-teman.
Dialogue: 0,0:15:29.88,0:15:32.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ronja, dia putriku.
Dialogue: 0,0:15:35.07,0:15:37.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga sangat menyukai perpustakaan.
Dialogue: 0,0:15:39.97,0:15:44.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buku bisa memberitahuku\Nsegala hal tentang dunia.
Dialogue: 0,0:15:50.94,0:15:55.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para guru di sekolah mengajari kami
Dialogue: 0,0:16:00.89,0:16:04.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}agar tidak merepotkan orang lain
Dialogue: 0,0:16:08.14,0:16:11.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan tidak melakukan\Nhal-hal yang dibenci orang lain.
Dialogue: 0,0:16:12.85,0:16:16.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau demi menyelamatkanku
Dialogue: 0,0:16:17.00,0:16:19.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita harus kehilangan\Nsekolah dan perpustakaan,
Dialogue: 0,0:16:22.97,0:16:25.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kurasa tidak akan ada yang bersedia.
Dialogue: 0,0:16:30.90,0:16:32.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh murid yang baik.
Dialogue: 0,0:16:37.27,0:16:40.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ronja, jangan!
Dialogue: 0,0:16:46.56,0:16:47.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ku...
Dialogue: 0,0:17:01.96,0:17:06.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa lebih baik aku yang jatuh!
Dialogue: 0,0:17:10.36,0:17:12.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kau katakan?
Dialogue: 0,0:17:12.74,0:17:14.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ronja!
Dialogue: 0,0:17:20.40,0:17:22.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya akan menunggu 30 detik lagi.
Dialogue: 0,0:17:23.06,0:17:26.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sampai waktunya habis\Nkalian belum memutuskan,
Dialogue: 0,0:17:26.90,0:17:29.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bocah ini akan langsung jatuh!
Dialogue: 0,0:17:35.84,0:17:37.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Jarul.
Dialogue: 0,0:17:40.74,0:17:42.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan kenapa-kenapa.
Dialogue: 0,0:17:44.98,0:17:45.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keberuntunganku
Dialogue: 0,0:17:48.12,0:17:49.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sangatlah baik.
Dialogue: 0,0:17:52.48,0:17:54.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti tidak akan terjadi apa-apa.
Dialogue: 0,0:17:58.94,0:18:00.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih tersisa 10 detik.
Dialogue: 0,0:18:00.58,0:18:01.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ronja.
Dialogue: 0,0:18:01.80,0:18:03.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah ini akan berakhir?
Dialogue: 0,0:18:08.58,0:18:09.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih tersisa 5 detik.
Dialogue: 0,0:18:11.40,0:18:11.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Empat.
Dialogue: 0,0:18:13.99,0:18:14.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiga.
Dialogue: 0,0:18:19.44,0:18:20.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dua.
Dialogue: 0,0:18:24.81,0:18:26.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu.
Dialogue: 0,0:18:26.75,0:18:28.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ange!
Dialogue: 0,0:18:33.17,0:18:34.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bakar
Dialogue: 0,0:18:35.37,0:18:37.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sekolahnya!
Dialogue: 0,0:18:38.65,0:18:39.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Jarul.
Dialogue: 0,0:18:44.30,0:18:49.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bakar juga perpustakaannya.
Dialogue: 0,0:19:04.63,0:19:05.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:19:15.97,0:19:16.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Robin!
Dialogue: 0,0:19:24.44,0:19:25.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Robin!
Dialogue: 0,0:19:32.58,0:19:38.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berani sekali kau menyerangku tadi,\Ndasar manusia rendahan.
Dialogue: 0,0:19:39.48,0:19:42.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Robin, cepat lari! Cepat pikirkan caranya!
Dialogue: 0,0:19:46.54,0:19:49.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau hanya akan membawa kesialan\Nbagi orang lain.
Dialogue: 0,0:19:49.80,0:19:51.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang sepertimu tidak pantas hidup.
Dialogue: 0,0:19:52.72,0:19:55.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, 'kan? Anak Iblis?
Dialogue: 0,0:19:56.02,0:19:57.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Robin!
Dialogue: 0,0:20:04.52,0:20:07.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ekspresi ini bagus sekali, Nico Robin.
Dialogue: 0,0:20:37.51,0:20:39.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial, ada apa ini?
Dialogue: 0,0:20:39.46,0:20:41.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aneh... Kenapa tidak beregenerasi?
Dialogue: 0,0:20:46.18,0:20:47.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa sebenarnya?
Dialogue: 0,0:20:47.34,0:20:47.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah.
Dialogue: 0,0:20:51.62,0:20:53.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lama tidak bertemu.
Dialogue: 0,0:20:53.46,0:20:54.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau adalah...
Dialogue: 0,0:20:55.02,0:20:56.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Scopper Gaban!
Dialogue: 0,0:21:34.17,0:21:42.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Berusaha keras membuka mata lebar-lebar\Nuntuk memastikan situasi di depan ♪
Dialogue: 0,0:21:45.08,0:21:52.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Otak penuh khayalan dan keputusasaan\Nentah kenapa selalu agak menyimpang ♪
Dialogue: 0,0:21:53.19,0:22:02.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Kenangan-kenangan buruk selalu\Nmuncul kembali dengan sangat jelas ♪
Dialogue: 0,0:22:04.11,0:22:12.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Memunguti kebosanan tidak berarti\Nrasanya hampir jadi orang lain ♪
Dialogue: 0,0:22:13.61,0:22:16.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Masa depan seperti apa\Nyang sebenarnya menjadi milikku ♪
Dialogue: 0,0:22:16.69,0:22:22.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Berdiri di sini dan sejauh apa pun\Nmencari tetap tidak terlihat ♪
Dialogue: 0,0:22:22.89,0:22:33.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Menentang angin dan robek ilusi salah\Nserta membuangnya ke celah takdir ♪
Dialogue: 0,0:22:33.79,0:22:41.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Orang-orang terus berputar dalam siklus\Nkenyataan yang begitu keras ini ♪
Dialogue: 0,0:22:41.92,0:22:48.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Hari esok begitu riuh hingga tidak ada\Nwaktu untuk berdoa akan segera tiba ♪
Dialogue: 0,0:22:49.12,0:22:57.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Lihat masa depan itu\Nkarena ia adalah milikku ♪
Dialogue: 0,0:23:04.39,0:23:08.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hadapi kekuatan Kelompok Kesatria Dewa,\NGeng Topi Jerami tidak mampu bergerak.
Dialogue: 0,0:23:08.76,0:23:10.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di Elbaph yang sedang berada dalam bahaya,
Dialogue: 0,0:23:10.59,0:23:14.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Tangan Kiri Raja Bajak Laut"\Nbangkit menyalakan api perlawanan.
Dialogue: 0,0:23:14.81,0:23:16.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saint Sommers berdiri mengadang mereka.
Dialogue: 0,0:23:16.81,0:23:20.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sementara itu,\NGunko menemukan kelemahan Gaban.
Dialogue: 0,0:23:20.64,0:23:21.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Episode selanjutnya, One Piece.
Dialogue: 0,0:23:22.02,0:23:25.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu Detik Menentukan,\NGaban VS Kelompok Kesatria Dewa.
Dialogue: 0,0:23:25.24,0:23:27.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menjadi Raja Bajak Laut!
