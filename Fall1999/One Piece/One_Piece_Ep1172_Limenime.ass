Dialogue: 0,0:05:14.83,0:05:17.82,sign,,0000,0000,0000,,[Kepala Sekolah Walrus, Kiba]
Dialogue: 0,0:13:34.35,0:13:38.77,sign,,0000,0000,0000,,[Elbaph, Dunia Bawah]
Dialogue: 0,0:21:24.46,0:21:30.58,sign,,0000,0000,0000,,[Bersambung]
Dialogue: 0,0:00:11.81,0:00:15.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Berlarilah\Nsampai tiba di sana ♪
Dialogue: 0,0:00:15.31,0:00:19.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Sampai perasaanku\Ntersampaikan kepadamu ♪
Dialogue: 0,0:00:21.28,0:00:23.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}[One Piece\NEpisode 1172]
Dialogue: 0,0:00:24.56,0:00:27.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Lautan yang begitu biru dan jernih ♪
Dialogue: 0,0:00:28.22,0:00:30.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Serpihan keajaiban yang bertebaran ♪
Dialogue: 0,0:00:31.62,0:00:34.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Jumlahnya tidak terhitung lagi ♪
Dialogue: 0,0:00:34.81,0:00:37.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Kita pun dipertemukan karenanya ♪
Dialogue: 0,0:00:37.72,0:00:40.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Perjalanan yang panjang\Nlangkah kaki tidak terhenti ♪
Dialogue: 0,0:00:40.44,0:00:44.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Titik akhir masih belum terlihat juga ♪
Dialogue: 0,0:00:44.38,0:00:47.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Namun kita pasti akan\Nmelompati segala rintangan ♪
Dialogue: 0,0:00:47.95,0:00:50.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Demi melihat senyuman itu ♪
Dialogue: 0,0:00:51.09,0:00:55.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Jika tenggelam dalam kebingungan\Ntidak akan bisa menerangi jalan di depan ♪
Dialogue: 0,0:00:55.26,0:00:58.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Mengolah kelemahanmu dengan teliti\Nhingga ia berubah menjadi nutrisi ♪
Dialogue: 0,0:00:59.07,0:01:04.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Kita yang berjuang sekuat tenaga\Ntetap saja ♪
Dialogue: 0,0:01:04.62,0:01:08.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Belum ada yang berubah ♪
Dialogue: 0,0:01:08.70,0:01:09.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Berlarilah ♪
Dialogue: 0,0:01:09.78,0:01:15.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Sampai tiba di sana\Nsampai perasaan tersampaikan kepadamu ♪
Dialogue: 0,0:01:17.27,0:01:23.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Meski belum menjadi legenda\Nmemangnya kenapa! ♪
Dialogue: 0,0:01:23.93,0:01:29.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Peta itu bersinar terang\Nsuatu hari kita menoleh sambil tersenyum ♪
Dialogue: 0,0:01:29.97,0:01:36.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Kini tidak lagi bimbang\Npara pejuang teruslah maju ke depan ♪
Dialogue: 0,0:01:41.60,0:01:42.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat di sana.
Dialogue: 0,0:01:45.02,0:01:49.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dulu, di ujung dahan itu ada\Nsebuah desa bernama Haugen.
Dialogue: 0,0:01:49.69,0:01:51.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Desa?
Dialogue: 0,0:01:52.08,0:01:54.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agar api tidak menjalar\Nke dahan-dahan lain,
Dialogue: 0,0:01:55.16,0:01:58.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}terpaksa dahan yang terbakar pun\Ndipotong bersama desa yang ikut terbakar.
Dialogue: 0,0:01:58.28,0:01:59.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh tak terbayangkan.
Dialogue: 0,0:02:00.09,0:02:04.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin inilah kelemahan Elbaph,\Nkebakaran dan petir.
Dialogue: 0,0:02:08.68,0:02:10.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku gagal.
Dialogue: 0,0:02:13.24,0:02:15.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang giliranku.
Dialogue: 0,0:02:20.02,0:02:21.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bidik dulu baru lempar.
Dialogue: 0,0:02:21.44,0:02:21.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:02:31.57,0:02:32.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:02:32.31,0:02:32.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hmm?
Dialogue: 0,0:02:33.61,0:02:34.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu manusia kecil?
Dialogue: 0,0:02:35.13,0:02:38.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paman-paman itu adalah siapa?
Dialogue: 0,0:03:12.97,0:03:20.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Munculnya Monster,\NMakhluk Mengerikan yang Menyerang Elbaph.
Dialogue: 0,0:03:34.01,0:03:34.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:03:35.07,0:03:35.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu apa?
Dialogue: 0,0:04:22.04,0:04:23.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ular yang besar sekali!
Dialogue: 0,0:04:23.13,0:04:25.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu Jormungandr, pasti Jormungandr!
Dialogue: 0,0:04:25.76,0:04:27.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu ular akhir zaman!
Dialogue: 0,0:04:27.52,0:04:29.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhir pekan? Hari Sabtu?
Dialogue: 0,0:04:32.70,0:04:33.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudaha akan dimakan.
Dialogue: 0,0:04:35.90,0:04:38.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guru!
Dialogue: 0,0:04:38.89,0:04:39.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong!
Dialogue: 0,0:04:39.88,0:04:41.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guru!
Dialogue: 0,0:04:41.33,0:04:44.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}[Guru Olahraga, Wolf.\NGuru Matematika, Blade]
Dialogue: 0,0:04:41.65,0:04:42.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:04:43.09,0:04:46.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak-anak serahkan padaku saja,\Nkau cepat laporkan pada Kepala Sekolah.
Dialogue: 0,0:04:46.85,0:04:47.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti.
Dialogue: 0,0:05:03.99,0:05:04.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guru Wolf.
Dialogue: 0,0:05:07.05,0:05:09.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat pergi ke dalam gedung sekolah.
Dialogue: 0,0:05:18.63,0:05:19.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat, guru sekalian!
Dialogue: 0,0:05:21.13,0:05:22.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa ini?
Dialogue: 0,0:05:26.97,0:05:28.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, sampai ribut-ribut begitu?
Dialogue: 0,0:05:28.76,0:05:32.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kepala Sekolah, ada ular raksasa\Nyang sangat mengerikan di lapangan.
Dialogue: 0,0:05:32.40,0:05:33.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ular?
Dialogue: 0,0:05:33.65,0:05:36.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Binatang buas dari Dunia Bawah,\Nmengapa bisa muncul di Dunia Matahari?
Dialogue: 0,0:05:36.28,0:05:38.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, itu bukan dari Dunia Bawah.
Dialogue: 0,0:05:38.85,0:05:40.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makhluk itu asal usulnya tak jelas.
Dialogue: 0,0:05:40.58,0:05:42.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang Guru Wolf masih menghadapinya.
Dialogue: 0,0:05:52.42,0:05:54.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makhluk apa itu?
Dialogue: 0,0:05:54.65,0:05:57.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga anak-anak bisa mengungsi\Ndengan selamat.
Dialogue: 0,0:05:57.12,0:05:58.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Panggil para pemimpin.
Dialogue: 0,0:05:58.99,0:06:02.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksud Anda? Saat para pemimpin\Ndatang, anak-anak sudah dalam bahaya.
Dialogue: 0,0:06:02.43,0:06:04.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan kemari!
Dialogue: 0,0:06:31.94,0:06:32.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aegir!
Dialogue: 0,0:06:34.62,0:06:36.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat lari.
Dialogue: 0,0:06:50.99,0:06:51.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kepala Sekolah.
Dialogue: 0,0:06:58.11,0:07:01.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guru! Mereka berdua akan dimakan!
Dialogue: 0,0:07:01.31,0:07:03.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aegir! Eirik!
Dialogue: 0,0:07:05.05,0:07:06.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyingkir!
Dialogue: 0,0:07:18.16,0:07:22.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan dekati anak-anak!
Dialogue: 0,0:07:31.68,0:07:33.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, aku datang terlambat.
Dialogue: 0,0:07:34.39,0:07:36.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kiba, cepat menyingkir!
Dialogue: 0,0:07:40.12,0:07:41.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kimatsu
Dialogue: 0,0:07:44.29,0:07:45.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shiken!
Dialogue: 0,0:08:07.68,0:08:09.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, pinggangku.
Dialogue: 0,0:08:08.50,0:08:17.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}[Mantan Bajak Laut Prajurit Raksasa,\NKiba (Kepala Sekolah)]
Dialogue: 0,0:08:10.07,0:08:12.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Saul, untung ada kau.
Dialogue: 0,0:08:12.28,0:08:13.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak masalah.
Dialogue: 0,0:08:13.67,0:08:15.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ular ini sebenarnya apa?
Dialogue: 0,0:08:15.77,0:08:17.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sama sekali tidak paham.
Dialogue: 0,0:08:19.52,0:08:20.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guru.
Dialogue: 0,0:08:21.57,0:08:24.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah aman, semuanya tenanglah.
Dialogue: 0,0:08:25.12,0:08:27.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Barusan itu apa?
Dialogue: 0,0:08:27.05,0:08:29.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa dulunya Kepala Sekolah\Njuga pernah menjadi pejuang?
Dialogue: 0,0:08:29.03,0:08:32.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata rumor itu benar,\NGuru Saul benar-benar kuat.
Dialogue: 0,0:08:32.98,0:08:34.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guru dulu anggota Angkatan Laut, bukan?
Dialogue: 0,0:08:34.47,0:08:36.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh keren.
Dialogue: 0,0:08:37.91,0:08:39.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus sekali.
Dialogue: 0,0:08:41.21,0:08:41.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:08:45.86,0:08:47.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian ada di sini.
Dialogue: 0,0:08:47.86,0:08:50.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kalian, sudah aman.
Dialogue: 0,0:08:50.34,0:08:54.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ular besar itu sudah ditumbangkan\Noleh Kepala Sekolah dan Guru Saul.
Dialogue: 0,0:08:54.36,0:08:56.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, kembali ke lapangan.
Dialogue: 0,0:09:01.43,0:09:02.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa dengan kalian?
Dialogue: 0,0:09:05.00,0:09:05.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei!
Dialogue: 0,0:09:12.79,0:09:14.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Besar sekali.
Dialogue: 0,0:09:14.72,0:09:17.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah di Dunia Matahari\Njuga ada monster seperti ini, Saul?
Dialogue: 0,0:09:17.68,0:09:22.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga tidak tahu,\Nbiasanya hanya ada hewan liar biasa.
Dialogue: 0,0:09:25.63,0:09:28.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, membuat kalian takut, ya.
Dialogue: 0,0:09:29.06,0:09:30.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa, terima kasih.
Dialogue: 0,0:09:30.77,0:09:33.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tinju tadi, tunjukkanlah pada kami lagi!
Dialogue: 0,0:09:33.26,0:09:34.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada yang terluka, 'kan?
Dialogue: 0,0:09:35.10,0:09:35.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:09:37.08,0:09:40.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu... Kalian pasti teman Luffy, ya?
Dialogue: 0,0:09:40.89,0:09:42.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, benar.
Dialogue: 0,0:09:52.13,0:09:54.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa Luffy sudah melakukan sesuatu\Npada kalian?
Dialogue: 0,0:09:56.97,0:09:58.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Ada masalah apa lagi?
Dialogue: 0,0:10:03.94,0:10:05.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guru Wolf!
Dialogue: 0,0:10:08.70,0:10:10.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guru Wolf, kuatkan dirimu.
Dialogue: 0,0:10:11.32,0:10:12.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan membalut lukamu.
Dialogue: 0,0:10:14.31,0:10:17.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak usah pedulikan aku.\NA... anak-anak...
Dialogue: 0,0:10:18.96,0:10:20.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa dengan anak-anak?
Dialogue: 0,0:10:21.92,0:10:23.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ylva dan yang lain menghilang.
Dialogue: 0,0:10:23.96,0:10:26.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka pergi entah ke mana begitu saja.
Dialogue: 0,0:10:26.17,0:10:27.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke mana mereka arah pergi mereka?
Dialogue: 0,0:10:27.33,0:10:28.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke sana.
Dialogue: 0,0:10:32.76,0:10:34.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guru Saul, harus berhati-hati.
Dialogue: 0,0:10:34.84,0:10:36.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau jangan bergerak!
Dialogue: 0,0:10:36.42,0:10:39.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak boleh menyentuh anak-anak itu.
Dialogue: 0,0:10:39.94,0:10:40.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:10:45.89,0:10:47.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke arah mana Ylva dan yang lainnya pergi?
Dialogue: 0,0:10:47.70,0:10:49.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke sana, ke arah pantai.
Dialogue: 0,0:10:53.65,0:10:56.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guru, sebenarnya ada apa dengan semuanya?
Dialogue: 0,0:10:56.58,0:10:58.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka tertidur, walau dipanggil\Ntetap tidak menjawab.
Dialogue: 0,0:10:58.71,0:11:01.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tertidur? Bukankah mereka masih berjalan?
Dialogue: 0,0:11:02.83,0:11:06.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, mereka sedang berjalan, tapi tertidur.
Dialogue: 0,0:11:08.83,0:11:11.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ylva dan Skaldi juga tidak menjawab.
Dialogue: 0,0:11:13.42,0:11:15.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian mau pergi ke mana?
Dialogue: 0,0:11:15.90,0:11:18.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, cepat kembali!
Dialogue: 0,0:11:20.48,0:11:22.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bunyikan terompet!
Dialogue: 0,0:11:23.54,0:11:26.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Umumkan ke seluruh negeri!
Dialogue: 0,0:11:27.44,0:11:30.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kiba, mengumumkan ke seluruh negeri itu\Nterlalu berlebihan.
Dialogue: 0,0:11:31.19,0:11:34.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, Saul, situasi ini tidak normal.
Dialogue: 0,0:11:35.02,0:11:36.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihatlah ke arah hutan sana.
Dialogue: 0,0:11:49.19,0:11:51.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada monster lagi!
Dialogue: 0,0:12:08.92,0:12:10.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, masih ada satu!
Dialogue: 0,0:12:10.49,0:12:12.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makhluk-makhluk ini bermunculan dari mana?
Dialogue: 0,0:12:12.58,0:12:16.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak tahu,\Ntapi ini jelas keadaan darurat.
Dialogue: 0,0:12:16.30,0:12:17.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kepala Sekolah.
Dialogue: 0,0:12:31.15,0:12:32.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak-anak...
Dialogue: 0,0:12:32.63,0:12:34.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana ini, semuanya sadarlah!
Dialogue: 0,0:12:35.61,0:12:36.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:12:39.73,0:12:40.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tertidur.
Dialogue: 0,0:12:41.24,0:12:42.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak paham.
Dialogue: 0,0:12:43.62,0:12:44.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya!
Dialogue: 0,0:12:49.19,0:12:50.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bangun, cepat bangun!
Dialogue: 0,0:12:50.81,0:12:52.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aegir!
Dialogue: 0,0:12:53.60,0:12:55.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang sebenarnya terjadi?
Dialogue: 0,0:12:55.51,0:12:58.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saul, turunkan aku,\Nbiar aku periksa mereka.
Dialogue: 0,0:12:58.41,0:13:02.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, kuserahkan padamu.\NAku benar-benar bingung.
Dialogue: 0,0:13:09.08,0:13:13.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika anak-anak terpenting ini kenapa-napa,\Naku tak tidak bisa pertanggungjawabkan.
Dialogue: 0,0:13:13.73,0:13:15.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guru Saul, Kepala Sekolah.
Dialogue: 0,0:13:16.43,0:13:17.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:13:17.76,0:13:23.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A... aku punya ingatan\Ntentang monster-monster itu.
Dialogue: 0,0:13:39.79,0:13:42.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya dengan membiarkan satu kaki\Nmemakai batu lautan,
Dialogue: 0,0:13:44.49,0:13:47.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalian pikir bisa menekan kekuatanku?
Dialogue: 0,0:13:48.23,0:13:49.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Naif sekali.
Dialogue: 0,0:14:02.49,0:14:08.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk menyelamatkan Elbaph,\Nsegera buka kunci gembok terakhir.
Dialogue: 0,0:14:09.04,0:14:12.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian pikir dengan begini\Naku tidak bisa melakukan apa-apa?
Dialogue: 0,0:14:13.67,0:14:15.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang akan kutunjukkan pada kalian.
Dialogue: 0,0:14:15.87,0:14:16.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau ini!
Dialogue: 0,0:14:17.72,0:14:19.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa dengan bocah ini?
Dialogue: 0,0:14:28.45,0:14:29.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pegang erat, ya.
Dialogue: 0,0:14:30.15,0:14:33.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pukul beberapa kali,\Npasti akan mengenai sesuatu.
Dialogue: 0,0:14:34.39,0:14:36.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Api akan menjalar.
Dialogue: 0,0:14:37.43,0:14:41.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian semua tahu apa\Nyang ditakuti Elbaph, bukan?
Dialogue: 0,0:14:43.61,0:14:46.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa membinasakan
Dialogue: 0,0:14:52.11,0:14:54.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalian semua!
Dialogue: 0,0:14:55.68,0:14:57.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhenti, Loki!
Dialogue: 0,0:15:20.47,0:15:21.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Loki!
Dialogue: 0,0:16:01.80,0:16:04.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhenti, Loki!
Dialogue: 0,0:16:17.68,0:16:18.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Loki!
Dialogue: 0,0:16:40.77,0:16:42.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi apa yang terjadi,\Napakah sambaran petir?
Dialogue: 0,0:16:42.58,0:16:45.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya juga ada suara terompet.
Dialogue: 0,0:16:46.53,0:16:48.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Jarul!
Dialogue: 0,0:16:49.66,0:16:51.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di selatan pulau ada kebakaran!
Dialogue: 0,0:16:52.70,0:16:56.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke... Kebakaran?
Dialogue: 0,0:16:58.14,0:16:59.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tidak bagus.
Dialogue: 0,0:17:01.47,0:17:04.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ce... cepat padamkan api!
Dialogue: 0,0:17:06.75,0:17:08.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah ini tidak masalah?
Dialogue: 0,0:17:08.40,0:17:10.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keadaan ini tidak baik-baik saja..
Dialogue: 0,0:17:16.02,0:17:17.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Napas dan denyut nadi normal.
Dialogue: 0,0:17:18.90,0:17:24.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkinkah keanehan pada anak-anak ada\Nhubungannya dengan kemunculan monster?
Dialogue: 0,0:17:28.41,0:17:32.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau benar-benar merasa\Nmengenali monster-monster itu, Guru Ange?
Dialogue: 0,0:17:37.42,0:17:39.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu hal yang terjadi\Nsaat pelajaran hari ini.
Dialogue: 0,0:17:45.17,0:17:46.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu Loki?
Dialogue: 0,0:17:47.09,0:17:48.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, benar.
Dialogue: 0,0:17:48.86,0:17:52.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Loki sambil memegang palu besar,\Nakan menghancurkan dunia, 'kan?
Dialogue: 0,0:17:52.60,0:17:53.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan begitu.
Dialogue: 0,0:17:54.95,0:17:58.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang menghancurkan dunia adalah Nika,\Ncoba lihat.
Dialogue: 0,0:17:59.89,0:18:01.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh menakutkan.
Dialogue: 0,0:18:01.10,0:18:04.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, Loki lebih menakutkan.
Dialogue: 0,0:18:06.70,0:18:09.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skaldi, jangan berdiri di atas meja.
Dialogue: 0,0:18:09.44,0:18:10.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Magg juga duduk yang baik.
Dialogue: 0,0:18:12.02,0:18:13.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Maaf.
Dialogue: 0,0:18:13.23,0:18:16.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetap hantu yang paling menakutkan.
Dialogue: 0,0:18:16.55,0:18:18.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, Draugr yang paling menakutkan.
Dialogue: 0,0:18:18.86,0:18:19.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Badai.
Dialogue: 0,0:18:20.32,0:18:21.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku takut petir.
Dialogue: 0,0:18:22.48,0:18:23.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Niddhoggr.
Dialogue: 0,0:18:23.65,0:18:25.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jormungandr.
Dialogue: 0,0:18:25.41,0:18:26.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku, aku.
Dialogue: 0,0:18:27.85,0:18:30.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibuku.
Dialogue: 0,0:18:31.52,0:18:34.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang ibunya Bent sangat menakutkan.
Dialogue: 0,0:18:37.51,0:18:39.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah, semuanya tenang.
Dialogue: 0,0:18:40.84,0:18:41.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guru.
Dialogue: 0,0:18:43.68,0:18:45.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, Ylva?
Dialogue: 0,0:18:47.40,0:18:52.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memikirkan begitu banyak hal menakutkan,\Nmalam ini aku pasti mimpi buruk.
Dialogue: 0,0:18:52.91,0:18:55.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa, jangan khawatir.
Dialogue: 0,0:18:56.90,0:19:00.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada kami, orang-orang dewasa di sini.
Dialogue: 0,0:19:00.37,0:19:03.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan saja pada kami\Ndan mimpi buruk bisa diatasi.
Dialogue: 0,0:19:05.79,0:19:10.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gambar dan karangan ini semua\Nmenunjukkan kepribadian kalian.
Dialogue: 0,0:19:10.35,0:19:13.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Imajinasi dan kemampuan ekspresi kalian\Njuga bagus.
Dialogue: 0,0:19:13.18,0:19:15.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guru sangat kagum.
Dialogue: 0,0:20:13.40,0:20:14.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua itu adalah
Dialogue: 0,0:20:15.55,0:20:19.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hal-hal menakutkan yang dibayangkan\Noleh anak-anak di dalam pikiran mereka.
Dialogue: 0,0:20:20.55,0:20:21.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin.
Dialogue: 0,0:20:23.22,0:20:28.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inilah dunia ketakutan terbesar anak-anak.
Dialogue: 0,0:20:39.17,0:20:42.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, semua sudah siap.
Dialogue: 0,0:20:44.76,0:20:47.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Killingham.
Dialogue: 0,0:20:51.47,0:20:56.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Batas waktunya adalah\Nsebelum bocah-bocah itu naik kapal.
Dialogue: 0,0:20:56.44,0:20:58.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pikir mereka bisa merebutnya kembali?
Dialogue: 0,0:21:01.19,0:21:04.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang namanya cinta ialah saling menyakiti.
Dialogue: 0,0:21:05.17,0:21:08.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, mereka masih bocah.
Dialogue: 0,0:21:08.72,0:21:11.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa-bisanya takut pada hal seperti itu.
Dialogue: 0,0:21:11.56,0:21:12.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Gunko.
Dialogue: 0,0:21:13.51,0:21:16.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau punya sesuatu yang kau takuti?
Dialogue: 0,0:21:23.51,0:21:24.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nika.
Dialogue: 0,0:21:34.17,0:21:42.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Berusaha keras membuka mata lebar-lebar\Nuntuk memastikan situasi di depan ♪
Dialogue: 0,0:21:45.08,0:21:52.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Otak penuh khayalan dan keputusasaan\Nentah kenapa selalu agak menyimpang ♪
Dialogue: 0,0:21:53.19,0:22:02.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Kenangan-kenangan buruk selalu\Nmuncul kembali dengan sangat jelas ♪
Dialogue: 0,0:22:04.11,0:22:12.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Memunguti kebosanan tidak berarti\Nrasanya hampir jadi orang lain ♪
Dialogue: 0,0:22:13.61,0:22:16.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Masa depan seperti apa\Nyang sebenarnya menjadi milikku ♪
Dialogue: 0,0:22:16.69,0:22:22.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Berdiri di sini dan sejauh apa pun\Nmencari tetap tidak terlihat ♪
Dialogue: 0,0:22:22.89,0:22:33.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Menentang angin dan robek ilusi salah\Nserta membuangnya ke celah takdir ♪
Dialogue: 0,0:22:33.79,0:22:41.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Orang-orang terus berputar dalam siklus\Nkenyataan yang begitu keras ini ♪
Dialogue: 0,0:22:41.92,0:22:48.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Hari esok begitu riuh hingga tidak ada\Nwaktu untuk berdoa akan segera tiba ♪
Dialogue: 0,0:22:49.12,0:22:57.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Lihat masa depan itu\Nkarena ia adalah milikku ♪
Dialogue: 0,0:23:05.46,0:23:07.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Monster-monster yang bergerak.
Dialogue: 0,0:23:07.08,0:23:08.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Api yang makin membesar.
Dialogue: 0,0:23:09.00,0:23:11.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak-anak terus berjalan maju\Ndalam tidurnya.
Dialogue: 0,0:23:11.67,0:23:13.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di tengah berbagai perubahan aneh\Nyang datang bertubi-tubi,
Dialogue: 0,0:23:13.86,0:23:16.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk melindungi anak-anak,\NSaul berlari sekencang-kencangnya.
Dialogue: 0,0:23:16.98,0:23:20.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah ada cara untuk keluar\Ndari kesulitan ini?
Dialogue: 0,0:23:20.77,0:23:22.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Episode selanjutnya, One Piece.
Dialogue: 0,0:23:22.06,0:23:30.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}[Permainan Mimpi Buruk,\NKonspirasi Kelompok Kesatria Dewa]
Dialogue: 0,0:23:22.27,0:23:25.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permainan Mimpi Buruk,\NKonspirasi Kelompok Kesatria Dewa.
Dialogue: 0,0:23:25.47,0:23:27.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menjadi Raja Bajak Laut!
