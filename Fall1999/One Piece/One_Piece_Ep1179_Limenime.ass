Dialogue: 0,0:00:21.28,0:00:23.32,sign,,0000,0000,0000,,[One Piece\NEpisode 1179]
Dialogue: 0,0:21:24.70,0:21:30.69,sign,,0000,0000,0000,,[Bersambung]
Dialogue: 0,0:23:21.49,0:23:30.75,sign,,0000,0000,0000,,[Elbaph yang Putus Asa, Kontrak Iblis,\NDomi Reversi]
Dialogue: 0,0:00:11.81,0:00:15.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Berlarilah\Nsampai tiba di sana ♪
Dialogue: 0,0:00:15.31,0:00:19.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Sampai perasaanku\Ntersampaikan kepadamu ♪
Dialogue: 0,0:00:24.56,0:00:27.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Lautan yang begitu biru dan jernih ♪
Dialogue: 0,0:00:28.22,0:00:30.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Serpihan keajaiban yang bertebaran ♪
Dialogue: 0,0:00:31.62,0:00:34.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Jumlahnya tidak terhitung lagi ♪
Dialogue: 0,0:00:34.81,0:00:37.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Kita pun dipertemukan karenanya ♪
Dialogue: 0,0:00:37.72,0:00:40.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Perjalanan yang panjang\Nlangkah kaki tidak terhenti ♪
Dialogue: 0,0:00:40.44,0:00:44.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Titik akhir masih belum terlihat juga ♪
Dialogue: 0,0:00:44.38,0:00:47.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Namun kita pasti akan\Nmelompati segala rintangan ♪
Dialogue: 0,0:00:47.95,0:00:50.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Demi melihat senyuman itu ♪
Dialogue: 0,0:00:51.09,0:00:55.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Jika tenggelam dalam kebingungan\Ntidak akan bisa menerangi jalan di depan ♪
Dialogue: 0,0:00:55.26,0:00:58.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Mengolah kelemahanmu dengan teliti\Nhingga ia berubah menjadi nutrisi ♪
Dialogue: 0,0:00:59.07,0:01:04.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Kita yang berjuang sekuat tenaga\Ntetap saja ♪
Dialogue: 0,0:01:04.62,0:01:08.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Belum ada yang berubah ♪
Dialogue: 0,0:01:08.70,0:01:09.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Berlarilah ♪
Dialogue: 0,0:01:09.78,0:01:15.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Sampai tiba di sana\Nsampai perasaan tersampaikan kepadamu ♪
Dialogue: 0,0:01:17.27,0:01:23.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Meski belum menjadi legenda\Nmemangnya kenapa! ♪
Dialogue: 0,0:01:23.93,0:01:29.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Peta itu bersinar terang\Nsuatu hari kita menoleh sambil tersenyum ♪
Dialogue: 0,0:01:29.97,0:01:36.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Kini tidak lagi bimbang\Npara pejuang teruslah maju ke depan ♪
Dialogue: 0,0:01:45.55,0:01:46.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Jarul.
Dialogue: 0,0:01:48.18,0:01:50.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan kenapa-kenapa.
Dialogue: 0,0:01:52.11,0:01:53.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keberuntunganku
Dialogue: 0,0:01:55.55,0:01:57.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sangatlah baik.
Dialogue: 0,0:01:59.68,0:02:01.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti tidak akan terjadi apa-apa.
Dialogue: 0,0:02:18.73,0:02:23.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bakar juga perpustakaannya.
Dialogue: 0,0:02:32.91,0:02:33.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau adalah...
Dialogue: 0,0:02:34.45,0:02:36.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Scopper Gaban!
Dialogue: 0,0:03:02.87,0:03:10.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu Detik Menentukan,\NGaban VS Kelompok Kesatria Dewa.
Dialogue: 0,0:03:34.53,0:03:34.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si...
Dialogue: 0,0:03:37.84,0:03:39.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa itu?
Dialogue: 0,0:03:42.39,0:03:43.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gerakanku sudah tumpul.
Dialogue: 0,0:03:49.50,0:03:51.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serangannya membuahkan hasil.
Dialogue: 0,0:04:02.38,0:04:03.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial.
Dialogue: 0,0:04:27.11,0:04:28.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tembok Duri!
Dialogue: 0,0:04:38.06,0:04:39.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemakan Gunung.
Dialogue: 0,0:04:40.31,0:04:42.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kau bisa berada di Elbaph?
Dialogue: 0,0:04:42.87,0:04:45.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bahas hal-hal serius\Nseperti itu dulu.
Dialogue: 0,0:05:04.40,0:05:06.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian pernah melihatnya di kastel?
Dialogue: 0,0:05:06.11,0:05:08.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, tadi kebetulan bertemu.
Dialogue: 0,0:05:08.52,0:05:10.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luffy dan Zoro sama-sama\Ndibuat kewalahan olehnya.
Dialogue: 0,0:05:10.95,0:05:12.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oleh pak tua itu?
Dialogue: 0,0:05:12.91,0:05:15.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak salah dengar,\Nnamanya Scopper Gaban.
Dialogue: 0,0:05:16.14,0:05:20.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, dia dikenal sejajar dengan Rayleigh\Nsebagai "Tangan Kiri Raja Bajak Laut".
Dialogue: 0,0:05:20.28,0:05:23.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tokoh sehebat itu ternyata\Nada di negara raksasa.
Dialogue: 0,0:05:24.24,0:05:28.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meskipun tidak bisa bergerak,\Nsetidaknya lindungi dengan kemampuan.
Dialogue: 0,0:05:30.64,0:05:33.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan gegabah, Robin.\NLawan menggunakan Duri Besi.
Dialogue: 0,0:05:34.12,0:05:37.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau akan sangat dirugikan\Njika bertarung jarak dekat.
Dialogue: 0,0:05:37.77,0:05:41.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu orang yang disebut Oimo dan\Nyang lainnya, ya. Pantas saja sekuat itu.
Dialogue: 0,0:06:00.10,0:06:03.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tangan kanan orang itu\Nbelum beregenerasi kembali.
Dialogue: 0,0:06:05.42,0:06:08.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saul jelas mengatakan\Nbahwa Kelompok Kesatria Dewa itu abadi.
Dialogue: 0,0:06:09.35,0:06:12.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa? Kenapa serangannya\Nbisa membuahkan hasil?
Dialogue: 0,0:06:12.73,0:06:15.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya bukan hanya\Nkarena dia cukup kuat.
Dialogue: 0,0:06:22.43,0:06:24.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bajingan!
Dialogue: 0,0:06:35.05,0:06:36.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa sebenarnya denganmu?
Dialogue: 0,0:06:39.61,0:06:41.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cukup sampai di sini!
Dialogue: 0,0:06:42.20,0:06:44.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serangan Duri Berjatuhan!
Dialogue: 0,0:06:57.31,0:06:59.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu kali lagi,\NSerangan Duri Berjatuhan.
Dialogue: 0,0:07:07.74,0:07:09.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serangan Duri Berjatuhan.
Dialogue: 0,0:07:11.26,0:07:12.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ditambah lagi...
Dialogue: 0,0:07:20.14,0:07:21.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Crimson Hell.
Dialogue: 0,0:07:22.13,0:07:25.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang kau bahkan tidak punya tempat\Nuntuk berpijak.
Dialogue: 0,0:07:25.43,0:07:26.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh?
Dialogue: 0,0:07:27.37,0:07:29.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di langit dan di bumi pun\Ntidak ada tempat untuk melarikan diri.
Dialogue: 0,0:07:29.92,0:07:32.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menusukmu\Nsampai seperti tusukan.
Dialogue: 0,0:07:40.33,0:07:42.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya sebegitu saja kemampuanmu.
Dialogue: 0,0:07:43.86,0:07:45.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh sayang.
Dialogue: 0,0:07:54.14,0:07:55.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sedang buru-buru.
Dialogue: 0,0:08:09.78,0:08:10.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo maju!
Dialogue: 0,0:08:25.96,0:08:26.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Futenraku.
Dialogue: 0,0:08:29.73,0:08:31.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial.
Dialogue: 0,0:08:57.38,0:09:00.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu aku, Colon, anak-anak.
Dialogue: 0,0:09:01.97,0:09:03.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku segera datang.
Dialogue: 0,0:09:25.53,0:09:27.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, hampir saja.
Dialogue: 0,0:09:34.56,0:09:36.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata dia berhasil menjatuhkannya.
Dialogue: 0,0:09:45.88,0:09:47.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, Tuan Chopper?
Dialogue: 0,0:09:47.85,0:09:49.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau juga ada di sini.
Dialogue: 0,0:09:50.02,0:09:51.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau pergi ke mana?
Dialogue: 0,0:09:55.15,0:09:58.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya dia yang berhasil melukai\Norang yang katanya abadi itu.
Dialogue: 0,0:09:58.17,0:10:01.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hal ini mungkin sangat penting,\Nharus diselidiki dengan jelas.
Dialogue: 0,0:10:08.20,0:10:09.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini baru benar.
Dialogue: 0,0:10:13.48,0:10:15.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, kerja bagus.
Dialogue: 0,0:10:18.63,0:10:21.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cukup tahu kalian bisa melakukannya.
Dialogue: 0,0:10:23.12,0:10:25.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagian sana akan aku tangani untuk kalian.
Dialogue: 0,0:10:36.94,0:10:38.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apinya benar-benar besar.
Dialogue: 0,0:10:48.16,0:10:50.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tulisan yang ditinggalkan\Npara pendahulu...
Dialogue: 0,0:10:52.06,0:10:54.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejarah...
Dialogue: 0,0:10:59.57,0:11:00.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perpustakaan...
Dialogue: 0,0:11:07.24,0:11:10.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Rimoshifu Killingham,\Npenyalaan api selesai.
Dialogue: 0,0:11:11.62,0:11:12.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kembali, anak kecil.
Dialogue: 0,0:11:24.82,0:11:26.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisakah kau sedikit senang?
Dialogue: 0,0:11:35.03,0:11:35.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:11:39.05,0:11:42.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku masih hidup, maaf.
Dialogue: 0,0:11:45.13,0:11:47.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya karena aku, semuanya terbakar.
Dialogue: 0,0:11:48.59,0:11:50.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ronja, ini bukan salahmu.
Dialogue: 0,0:11:51.03,0:11:52.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan begitu, Ronja.
Dialogue: 0,0:11:53.07,0:11:56.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku masih hidup, maaf.
Dialogue: 0,0:11:58.00,0:11:59.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:12:00.28,0:12:01.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:12:05.71,0:12:07.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:12:07.92,0:12:10.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak akan ada yang menyalahkanmu.
Dialogue: 0,0:12:17.60,0:12:22.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Budaya, sejarah, anak-anak,\Ndan juga kekuatan militer.
Dialogue: 0,0:12:23.11,0:12:26.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian tidak berwenang merampas apa pun.
Dialogue: 0,0:12:30.57,0:12:34.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awak Raja Bajak Laut,\Nkau ingin membangkang?
Dialogue: 0,0:12:34.69,0:12:37.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau berani membangkang,\Nsandera akan mati.
Dialogue: 0,0:12:39.15,0:12:40.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu Paman Ya-san.
Dialogue: 0,0:12:41.03,0:12:41.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:12:43.89,0:12:46.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah dia datang\Nuntuk menyelamatkan kita?
Dialogue: 0,0:12:46.17,0:12:46.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di mana?
Dialogue: 0,0:12:47.23,0:12:49.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Colon, Paman Ya-san datang!
Dialogue: 0,0:12:49.86,0:12:50.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:12:51.28,0:12:53.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan panggil aku, Colon.
Dialogue: 0,0:13:06.41,0:13:08.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus sekali!
Dialogue: 0,0:13:24.91,0:13:28.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah!
Dialogue: 0,0:13:35.56,0:13:40.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua orang akan selamat.\NAyahku yang terkuat.
Dialogue: 0,0:14:05.77,0:14:06.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:14:06.91,0:14:12.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau menantangku,\Nberarti aku boleh menghabisinya, 'kan?
Dialogue: 0,0:14:14.36,0:14:16.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang adalah kesempatan terakhir.
Dialogue: 0,0:14:17.42,0:14:21.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang masih bisa memadamkan\Nkebakaran besar di perpustakaan.
Dialogue: 0,0:14:21.81,0:14:26.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyelamatkan anak-anak,\Nbahkan menyelamatkan Elbaph.
Dialogue: 0,0:14:29.11,0:14:31.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asalkan bisa membunuhnya dalam sekejap.
Dialogue: 0,0:14:32.98,0:14:35.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan!
Dialogue: 0,0:14:36.79,0:14:38.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Colon, beri aku satu detik.
Dialogue: 0,0:14:39.59,0:14:42.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tahan sebentar. Kau anak yang kuat.
Dialogue: 0,0:14:42.88,0:14:45.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pasti akan memastikan kau tetap hidup.
Dialogue: 0,0:14:48.54,0:14:50.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, Ayah.
Dialogue: 0,0:14:50.70,0:14:54.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ini pejuang,\Nsedikit luka tidak masalah.
Dialogue: 0,0:14:55.23,0:14:59.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, cepat tumbangkan dia!
Dialogue: 0,0:15:02.80,0:15:05.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau nyawa sudah melayang,\Ntidak akan bisa kembali.
Dialogue: 0,0:15:10.14,0:15:10.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Colon.
Dialogue: 0,0:15:39.45,0:15:41.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini anak kita, Paman Ya-san.
Dialogue: 0,0:15:53.19,0:15:54.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh.
Dialogue: 0,0:15:55.06,0:15:57.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Besar dan imut sekali.
Dialogue: 0,0:15:57.89,0:16:00.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah melahirkannya, Ripley.
Dialogue: 0,0:16:50.65,0:16:54.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak dihentikan di sini,\Ndampaknya akan makin besar.
Dialogue: 0,0:16:55.70,0:16:57.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Colon, kau harus baik-baik saja.
Dialogue: 0,0:17:44.13,0:17:44.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Colon.
Dialogue: 0,0:18:42.67,0:18:43.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhenti.
Dialogue: 0,0:18:57.09,0:18:58.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menyerah.
Dialogue: 0,0:19:07.70,0:19:09.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Elbaph.
Dialogue: 0,0:19:09.87,0:19:11.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang-orang lemah.
Dialogue: 0,0:19:14.33,0:19:17.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Colon. Pasti sakit sekali, 'kan?
Dialogue: 0,0:19:18.49,0:19:19.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:19:29.31,0:19:32.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah!
Dialogue: 0,0:19:36.30,0:19:37.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah.
Dialogue: 0,0:19:38.32,0:19:40.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah, Ayah.
Dialogue: 0,0:19:41.24,0:19:42.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah.
Dialogue: 0,0:19:43.94,0:19:47.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah!
Dialogue: 0,0:19:49.65,0:19:52.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah... Ayahanda!
Dialogue: 0,0:19:54.71,0:19:56.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ingatan macam apa ini?
Dialogue: 0,0:19:58.85,0:20:02.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mimpiku adalah menjadi bajak laut.
Dialogue: 0,0:20:06.60,0:20:10.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, benar-benar mirip, ya.
Dialogue: 0,0:20:10.64,0:20:13.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari tadi kau bergumam sendiri apa?
Dialogue: 0,0:20:13.93,0:20:16.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat cari cara untuk keluar.
Dialogue: 0,0:20:16.32,0:20:17.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, maaf.
Dialogue: 0,0:20:19.27,0:20:19.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Brook?
Dialogue: 0,0:20:27.91,0:20:28.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah itu Brook?
Dialogue: 0,0:20:33.59,0:20:34.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sakit sekali.
Dialogue: 0,0:20:38.81,0:20:41.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sakit, sakit. Aku tidak bisa bergerak.
Dialogue: 0,0:20:41.90,0:20:43.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa masih mengulur waktu?
Dialogue: 0,0:20:45.52,0:20:48.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang Tanah Suci\Nsudah menjadi lautan api.
Dialogue: 0,0:20:49.05,0:20:49.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Imu.
Dialogue: 0,0:20:50.46,0:20:53.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan tempur itu mutlak diperlukan.
Dialogue: 0,0:20:58.97,0:21:02.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa dengan orang ini?\NWajahnya menjadi sangat menakutkan.
Dialogue: 0,0:21:19.52,0:21:21.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Imu akan memperlihatkan kepada kalian
Dialogue: 0,0:21:22.20,0:21:23.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}reversi dewa.
Dialogue: 0,0:21:34.17,0:21:42.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Berusaha keras membuka mata lebar-lebar\Nuntuk memastikan situasi di depan ♪
Dialogue: 0,0:21:45.08,0:21:52.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Otak penuh khayalan dan keputusasaan\Nentah kenapa selalu agak menyimpang ♪
Dialogue: 0,0:21:53.19,0:22:02.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Kenangan-kenangan buruk selalu\Nmuncul kembali dengan sangat jelas ♪
Dialogue: 0,0:22:04.11,0:22:12.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Memunguti kebosanan tidak berarti\Nrasanya hampir jadi orang lain ♪
Dialogue: 0,0:22:13.61,0:22:16.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Masa depan seperti apa\Nyang sebenarnya menjadi milikku ♪
Dialogue: 0,0:22:16.69,0:22:22.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Berdiri di sini dan sejauh apa pun\Nmencari tetap tidak terlihat ♪
Dialogue: 0,0:22:22.89,0:22:33.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Menentang angin dan robek ilusi salah\Nserta membuangnya ke celah takdir ♪
Dialogue: 0,0:22:33.79,0:22:41.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Orang-orang terus berputar dalam siklus\Nkenyataan yang begitu keras ini ♪
Dialogue: 0,0:22:41.92,0:22:48.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Hari esok begitu riuh hingga tidak ada\Nwaktu untuk berdoa akan segera tiba ♪
Dialogue: 0,0:22:49.12,0:22:57.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Lihat masa depan itu\Nkarena ia adalah milikku ♪
Dialogue: 0,0:23:04.85,0:23:07.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gunko berubah menjadi wujud seperti iblis.
Dialogue: 0,0:23:07.88,0:23:11.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Monster terus bertambah.\NUsopp dan yang lainnya masih terkurung.
Dialogue: 0,0:23:11.32,0:23:15.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bajak Laut Prajurit Raksasa yang murka\Nmenghadapi Kelompok Kesatria Dewa.
Dialogue: 0,0:23:15.91,0:23:17.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elbaph yang terjepit\Ndalam keadaan putus asa
Dialogue: 0,0:23:17.75,0:23:19.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kini diselimuti bayang-bayang reversi.
Dialogue: 0,0:23:19.96,0:23:21.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Episode selanjutnya, One Piece.
Dialogue: 0,0:23:21.55,0:23:25.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elbaph yang Putus Asa, Kontrak Iblis,\NDomi Reversi.
Dialogue: 0,0:23:25.71,0:23:27.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menjadi Raja Bajak Laut!
