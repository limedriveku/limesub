Dialogue: 0,0:00:21.28,0:00:23.32,sign,,0000,0000,0000,,{\an8}[One Piece\NEpisode 1174]
Dialogue: 0,0:04:28.62,0:04:31.46,sign,,0000,0000,0000,,{\an8}[Hal yang kutakuti: Petir]
Dialogue: 0,0:05:12.80,0:05:15.70,sign,,0000,0000,0000,,{\an8}[Hal yang kutakuti: Draugr]
Dialogue: 0,0:13:31.00,0:13:32.63,sign,,0000,0000,0000,,TD.
Dialogue: 0,0:16:46.35,0:16:49.53,sign,,0000,0000,0000,,{\an8}[Hal yang kutakuti: Fenrir]
Dialogue: 0,0:18:52.10,0:18:54.82,sign,,0000,0000,0000,,{\an8}[Hal yang kutakuti: Niddhoggr]
Dialogue: 0,0:18:58.52,0:19:01.26,sign,,0000,0000,0000,,{\an8}[Hal yang kutakuti: Monster]
Dialogue: 0,0:21:25.39,0:21:30.69,sign,,0000,0000,0000,,[Bersambung]
Dialogue: 0,0:23:20.13,0:23:30.83,sign,,0000,0000,0000,,{\an8}[Kebakaran Besar Elbaph! Kata Guruma\NSatu Tangan Jinbe yang Menggelegar!]
Dialogue: 0,0:00:11.81,0:00:15.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Berlarilah\Nsampai tiba di sana ♪
Dialogue: 0,0:00:15.31,0:00:19.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Sampai perasaanku\Ntersampaikan kepadamu ♪
Dialogue: 0,0:00:24.56,0:00:27.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Lautan yang begitu biru dan jernih ♪
Dialogue: 0,0:00:28.22,0:00:30.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Serpihan keajaiban yang bertebaran ♪
Dialogue: 0,0:00:31.62,0:00:34.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Jumlahnya tidak terhitung lagi ♪
Dialogue: 0,0:00:34.81,0:00:37.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Kita pun dipertemukan karenanya ♪
Dialogue: 0,0:00:37.72,0:00:40.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Perjalanan yang panjang\Nlangkah kaki tidak terhenti ♪
Dialogue: 0,0:00:40.44,0:00:44.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Titik akhir masih belum terlihat juga ♪
Dialogue: 0,0:00:44.38,0:00:47.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Namun kita pasti akan\Nmelompati segala rintangan ♪
Dialogue: 0,0:00:47.95,0:00:50.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Demi melihat senyuman itu ♪
Dialogue: 0,0:00:51.09,0:00:55.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Jika tenggelam dalam kebingungan\Ntidak akan bisa menerangi jalan di depan ♪
Dialogue: 0,0:00:55.26,0:00:58.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Mengolah kelemahanmu dengan teliti\Nhingga ia berubah menjadi nutrisi ♪
Dialogue: 0,0:00:59.07,0:01:04.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Kita yang berjuang sekuat tenaga\Ntetap saja ♪
Dialogue: 0,0:01:04.62,0:01:08.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Belum ada yang berubah ♪
Dialogue: 0,0:01:08.70,0:01:09.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Berlarilah ♪
Dialogue: 0,0:01:09.78,0:01:15.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Sampai tiba di sana\Nsampai perasaan tersampaikan kepadamu ♪
Dialogue: 0,0:01:17.27,0:01:23.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Meski belum menjadi legenda\Nmemangnya kenapa! ♪
Dialogue: 0,0:01:23.93,0:01:29.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Peta itu bersinar terang\Nsuatu hari kita menoleh sambil tersenyum ♪
Dialogue: 0,0:01:29.97,0:01:36.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Kini tidak lagi bimbang\Npara pejuang teruslah maju ke depan ♪
Dialogue: 0,0:01:43.15,0:01:45.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sommers, tenang saja.
Dialogue: 0,0:01:46.56,0:01:47.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan ada kecelakaan.
Dialogue: 0,0:01:48.96,0:01:52.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Empat Kaisar, Geng Topi Jerami\Nsudah mendarat.
Dialogue: 0,0:01:53.75,0:02:01.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamatkan Anak-Anak,\NPejuang Elbaph Menyerang.
Dialogue: 0,0:02:03.66,0:02:08.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I... ini benda apa sebenarnya?
Dialogue: 0,0:02:09.08,0:02:13.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba tebak ini apa.\NBenda ini sudah ada di sini sejak dulu.
Dialogue: 0,0:02:22.55,0:02:24.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini benar-benar penuh dengan sains.
Dialogue: 0,0:02:26.07,0:02:27.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau adalah cyborg,
Dialogue: 0,0:02:27.86,0:02:29.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku sudah menduga\Npasti kau yang paling senang.
Dialogue: 0,0:02:29.93,0:02:33.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana mungkin negara para pejuang\Nmemiliki fasilitas seperti ini?
Dialogue: 0,0:02:34.69,0:02:35.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Franky.
Dialogue: 0,0:02:36.46,0:02:38.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sini.
Dialogue: 0,0:02:40.77,0:02:42.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lilith, Bonney!
Dialogue: 0,0:02:42.60,0:02:45.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Franky, kau benar-benar berhasil\Nmenemukan tempat ini.
Dialogue: 0,0:02:45.61,0:02:48.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awalnya, aku ingin\Nmemberi tahu kalian nanti.
Dialogue: 0,0:02:48.19,0:02:50.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagian dalamnya luar biasa, Franky.
Dialogue: 0,0:02:51.13,0:02:53.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kalian bisa ada di sini?
Dialogue: 0,0:02:53.56,0:02:56.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah kalian pergi\Nmengurus izin tinggal?
Dialogue: 0,0:02:57.72,0:02:59.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awalnya memang itu rencananya.
Dialogue: 0,0:03:01.03,0:03:02.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alhasil, kami tersesat.
Dialogue: 0,0:03:03.07,0:03:05.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah menemukan kami.
Dialogue: 0,0:03:05.85,0:03:07.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan genius juga bisa tersesat, ya?
Dialogue: 0,0:03:08.74,0:03:12.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sungguh sial.\NUntung bertemu kalian di sini.
Dialogue: 0,0:03:12.87,0:03:16.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi entah dari mana terdengar alarm.
Dialogue: 0,0:03:16.27,0:03:17.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin ada bahaya di hutan.
Dialogue: 0,0:03:18.26,0:03:18.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alarm?
Dialogue: 0,0:03:22.56,0:03:24.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, ini sungguh mengejutkan.
Dialogue: 0,0:03:25.04,0:03:29.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fasilitas ini setidaknya sudah berusia\Nlebih dari tiga ribu tahun.
Dialogue: 0,0:03:30.18,0:03:32.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah, kau jangan mengarang.
Dialogue: 0,0:03:32.51,0:03:35.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tahukah kau tiga ribu tahun itu\Nselama apa?
Dialogue: 0,0:03:35.94,0:03:38.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak. Kali ini\Nmemang tidak bisa dikesampingkan.
Dialogue: 0,0:03:39.06,0:03:43.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan tidak ada orang di Elbaph\Nyang tahu sebenarnya ini bangunan apa.
Dialogue: 0,0:03:44.19,0:03:44.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:03:46.43,0:03:49.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jauh sebelum kita lahir,
Dialogue: 0,0:03:49.43,0:03:53.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebenarnya siapa yang membangun tempat ini\Ndan untuk tujuan apa?
Dialogue: 0,0:03:55.78,0:03:58.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sungguh layak diteliti.
Dialogue: 0,0:03:58.32,0:04:00.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku langsung saja\Ntinggal di sini.
Dialogue: 0,0:04:00.18,0:04:02.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau akan tersesat lagi. Sebaiknya jangan.
Dialogue: 0,0:04:03.49,0:04:06.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak peduli. Pokoknya, aku juga mau\Nmasuk dan melihatnya.
Dialogue: 0,0:04:06.77,0:04:08.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ke sana sekarang juga.
Dialogue: 0,0:04:09.67,0:04:11.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, Bonney?
Dialogue: 0,0:04:12.31,0:04:14.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di... di belakang...
Dialogue: 0,0:04:26.80,0:04:28.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada makhluk apa?
Dialogue: 0,0:04:33.03,0:04:36.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elbaph benar-benar tempat yang misterius.
Dialogue: 0,0:04:36.85,0:04:39.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, aku belum pernah melihat\Nmakhluk seperti ini.
Dialogue: 0,0:04:58.27,0:05:00.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapal Kabut Pemadam Kebakaran\Nditembak jatuh.
Dialogue: 0,0:05:00.77,0:05:02.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tengkorak yang bisa bergerak.
Dialogue: 0,0:05:05.71,0:05:06.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Draugr.
Dialogue: 0,0:05:27.04,0:05:29.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beraninya mereka menyerang\Ntim pemadam kebakaran!
Dialogue: 0,0:05:34.31,0:05:37.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima panahku ini!
Dialogue: 0,0:05:45.30,0:05:46.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhasil dikalahkan!
Dialogue: 0,0:05:55.38,0:05:57.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah ini zombi?
Dialogue: 0,0:06:10.33,0:06:14.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Monster-monster ini ada hubungannya\Ndengan imajinasi anak-anak.
Dialogue: 0,0:06:14.19,0:06:15.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang sebenarnya terjadi?
Dialogue: 0,0:06:15.53,0:06:19.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa yang tahu? Jangan pikirkan itu dulu.\NDi mana para pemimpin?
Dialogue: 0,0:06:19.46,0:06:20.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus meminta mereka mengarahkan.
Dialogue: 0,0:06:20.73,0:06:23.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka pergi ke toilet\Nkarena terlalu banyak minum.
Dialogue: 0,0:06:24.85,0:06:26.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di saat genting malah begini jadinya.
Dialogue: 0,0:06:28.34,0:06:31.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya bangun dan sadar\Ndari mabuk kalian! Ambil senjata,
Dialogue: 0,0:06:31.85,0:06:34.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan usir monster-monster itu!
Dialogue: 0,0:06:47.24,0:06:49.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari penampilannya, rasanya akrab sekali.
Dialogue: 0,0:06:49.55,0:06:51.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar seperti versi raksasa diriku.
Dialogue: 0,0:06:51.95,0:06:56.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya kerusuhan seperti ini\Njuga sangat jarang terjadi di Elbaph.
Dialogue: 0,0:06:56.17,0:06:59.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa yang bisa membawa para tamu\Nke luar desa untuk mengungsi?
Dialogue: 0,0:06:59.30,0:07:00.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, Kepala Desa.
Dialogue: 0,0:07:00.87,0:07:02.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hup!
Dialogue: 0,0:07:03.91,0:07:05.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Angkat meja ini sekalian.
Dialogue: 0,0:07:05.43,0:07:07.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, tunggu. Jangan sungkan begitu.
Dialogue: 0,0:07:08.38,0:07:12.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Elbaph sedang dalam bahaya, mana\Nmungkin kami langsung melarikan diri?
Dialogue: 0,0:07:14.74,0:07:16.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami juga akan bertarung bersama kalian.
Dialogue: 0,0:07:16.58,0:07:18.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suaranya terlalu kecil, bukan?
Dialogue: 0,0:07:19.75,0:07:21.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan ini...
Dialogue: 0,0:07:37.44,0:07:38.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak boleh, Colon.
Dialogue: 0,0:07:38.76,0:07:42.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atas dasar apa? Lepaskan aku!
Dialogue: 0,0:07:43.99,0:07:46.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga seorang pejuang!\NAku ingin bertarung!
Dialogue: 0,0:07:46.62,0:07:47.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja tidak bisa.
Dialogue: 0,0:07:48.93,0:07:49.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku adalah...
Dialogue: 0,0:07:51.85,0:07:53.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putranya Gaban!
Dialogue: 0,0:07:55.65,0:07:57.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar. Karena itu, kau bukan Gaban.
Dialogue: 0,0:08:02.21,0:08:04.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak-anak harus tetap berada\Ndi tempat yang aman.
Dialogue: 0,0:08:04.41,0:08:05.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengerti?
Dialogue: 0,0:08:17.19,0:08:18.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jarul.
Dialogue: 0,0:08:19.98,0:08:21.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, Nona Muda?
Dialogue: 0,0:08:21.96,0:08:26.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada sesuatu yang selama ini\Ntidak pernah kuberitahukan kepadamu.
Dialogue: 0,0:08:26.26,0:08:26.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:08:28.56,0:08:29.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:08:30.27,0:08:33.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada penyusup di kota yang mirip\Ndengan Rambut Merah, Shanks.
Dialogue: 0,0:08:33.25,0:08:36.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, dua orang\Nyang kekuatannya luar biasa.
Dialogue: 0,0:08:39.28,0:08:42.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami bahkan sempat mengira mereka\Nadalah Rambut Merah, Shanks.
Dialogue: 0,0:08:43.05,0:08:45.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, Si Topi Jerami\Nmengatakan bahwa mereka pasti bukan dia.
Dialogue: 0,0:08:45.76,0:08:47.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harap berhati-hati.
Dialogue: 0,0:08:47.39,0:08:49.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salah satu dari mereka\Nmenggunakan kemampuan yang aneh.
Dialogue: 0,0:08:49.72,0:08:52.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu kami sadar,\Nsemuanya sudah menjadi seperti ini.
Dialogue: 0,0:08:52.06,0:08:54.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami benar-benar merasa bersalah.
Dialogue: 0,0:08:54.06,0:08:58.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika menghadapi kejadian aneh seperti ini,\Npertama harus mencurigai Buah Iblis.
Dialogue: 0,0:08:59.00,0:09:01.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika fenomena-fenomena itu\Nbelum pernah kalian lihat sebelumnya,
Dialogue: 0,0:09:01.21,0:09:04.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kemungkinan besar kedua orang itu adalah\NPengguna Buah Iblis.
Dialogue: 0,0:09:06.45,0:09:08.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benar-benar minta maaf.
Dialogue: 0,0:09:08.21,0:09:10.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak menyangka\Nakan menjadi seperti ini.
Dialogue: 0,0:09:10.19,0:09:11.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bukan salahmu.
Dialogue: 0,0:09:13.23,0:09:19.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beri tahu semua, ada 2 manusia selain\Nanggota Geng Topi Jerami yang menyusup.
Dialogue: 0,0:09:19.70,0:09:21.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu ditemukan, segera laporkan.
Dialogue: 0,0:09:21.80,0:09:23.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dimengerti. Segera dilaksanakan.
Dialogue: 0,0:09:24.25,0:09:28.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan begitu banyak fenomena aneh,\Napa benar hanya ada dua orang?
Dialogue: 0,0:09:29.21,0:09:32.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya kita bersiap menghadapi\Nkemungkinan jumlah yang lebih banyak.
Dialogue: 0,0:09:32.63,0:09:33.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih dari dua orang?
Dialogue: 0,0:09:34.10,0:09:35.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dimengerti.
Dialogue: 0,0:09:36.32,0:09:38.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa pun mereka, aku tidak peduli.
Dialogue: 0,0:09:38.64,0:09:41.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beraninya mereka menculik anak-anak\Ndi siang bolong!
Dialogue: 0,0:09:42.12,0:09:44.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana ada orang yang menculik\Nsecara terang-terangan seperti ini?
Dialogue: 0,0:09:44.71,0:09:47.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya apa yang diinginkan\Npara penyusup ini?
Dialogue: 0,0:09:47.91,0:09:52.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita belum bisa memastikannya. Namun,\Nmelihat betapa kasarnya tindakan mereka,
Dialogue: 0,0:09:53.03,0:09:58.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin mereka ingin menjadikan anak-anak\Nsebagai sandera untuk mengancam Elbaph.
Dialogue: 0,0:09:59.89,0:10:02.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sangat mungkin.
Dialogue: 0,0:10:02.40,0:10:07.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau anak-anak sampai ditangkap, bukankah\Nitu justru sesuai dengan keinginan mereka?
Dialogue: 0,0:10:07.51,0:10:09.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya mereka ingin memaksa Elbaph\Nmelakukan apa?
Dialogue: 0,0:10:09.78,0:10:11.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami tidak akan\Nmembiarkan mereka berhasil.
Dialogue: 0,0:10:11.20,0:10:14.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bajingan-bajingan ini\Nbenar-benar tidak bisa dimaafkan!
Dialogue: 0,0:10:15.11,0:10:16.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami juga akan membantu!
Dialogue: 0,0:10:17.05,0:10:18.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang bisa kami bantu?
Dialogue: 0,0:10:18.78,0:10:21.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan mengatakan kata-kata bodoh itu.\NKalian adalah tamu.
Dialogue: 0,0:10:21.76,0:10:24.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pergilah ke tempat aman\Ndan bersembunyilah.
Dialogue: 0,0:10:24.53,0:10:26.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah mengetahui semua situasinya.
Dialogue: 0,0:10:26.45,0:10:28.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akan segera kembali ke desa.
Dialogue: 0,0:10:28.97,0:10:29.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap!
Dialogue: 0,0:10:29.82,0:10:30.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami juga...
Dialogue: 0,0:10:31.36,0:10:32.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, sakit.
Dialogue: 0,0:10:33.41,0:10:37.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, ya. Ke mana perginya Dorry dan Brogy?
Dialogue: 0,0:10:37.56,0:10:41.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka berdua pergi ke toilet\Ndan belum kembali sejak saat itu.
Dialogue: 0,0:10:41.20,0:10:44.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa-bisanya sampai dibuat tak berdaya\Noleh arak.
Dialogue: 0,0:10:46.91,0:10:50.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, Jarul!
Dialogue: 0,0:10:50.51,0:10:51.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah pergi.
Dialogue: 0,0:10:52.53,0:10:53.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada pilihan.
Dialogue: 0,0:10:53.77,0:10:56.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lakukan saja apa yang bisa\Nkita lakukan terlebih dahulu.
Dialogue: 0,0:10:56.72,0:11:00.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk mencari orang seukuran manusia,\Nkita seharusnya lebih ahli.
Dialogue: 0,0:11:00.87,0:11:02.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, kita lakukan seperti itu.
Dialogue: 0,0:11:02.04,0:11:04.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang besar biar ditangani yang besar.
Dialogue: 0,0:11:04.22,0:11:06.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita pergi mencari para penyusup.
Dialogue: 0,0:11:06.43,0:11:08.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, Elbaph sangat luas.
Dialogue: 0,0:11:08.64,0:11:10.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya dengan kedua kaki kita,\Nsama sekali tidak bisa menemukannya.
Dialogue: 0,0:11:10.56,0:11:13.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah kita bisa\Nmenggunakan Kapal Kabut?
Dialogue: 0,0:11:13.80,0:11:17.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapal sebesar itu tidak bisa\Nkita gerakkan sendiri.
Dialogue: 0,0:11:17.43,0:11:20.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus mencari seseorang\Nuntuk mendayungnya.
Dialogue: 0,0:11:41.72,0:11:43.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang sedang kau lakukan?
Dialogue: 0,0:11:43.80,0:11:46.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A... aku hanya disuruh seseorang\Nuntuk menjadi kurir.
Dialogue: 0,0:11:57.56,0:11:58.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau datang di saat yang tepat.
Dialogue: 0,0:11:58.88,0:12:00.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Antarkan kami dengan kapal itu.
Dialogue: 0,0:12:03.74,0:12:05.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku masih mengira kalian akan mencegahku.
Dialogue: 0,0:12:05.63,0:12:06.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian mau naik kapal?
Dialogue: 0,0:12:07.53,0:12:09.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Tolong bantu kami, Colon.
Dialogue: 0,0:12:10.23,0:12:12.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku adalah kaptennya.
Dialogue: 0,0:12:12.22,0:12:12.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja.
Dialogue: 0,0:12:14.15,0:12:16.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus sekali.
Dialogue: 0,0:12:16.89,0:12:18.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Imut sekali.
Dialogue: 0,0:12:21.93,0:12:23.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita berlayar!
Dialogue: 0,0:12:29.11,0:12:31.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada akhirnya,\Nkita tetap harus mendayung sendiri.
Dialogue: 0,0:12:31.64,0:12:35.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bajak Laut Colon, maju!
Dialogue: 0,0:12:35.22,0:12:38.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tubuhmu sebesar itu,\Nsetidaknya harus ikut mendayung!
Dialogue: 0,0:13:03.14,0:13:06.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perhatian untuk seluruh\Nwilayah Dunia Matahari Elbaph.
Dialogue: 0,0:13:12.05,0:13:16.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manusia selain anggota Geng Topi Jerami\Ntelah ditemukan di Kastel Aurust.
Dialogue: 0,0:13:18.68,0:13:21.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka jelas-jelas menunjukkan permusuhan.
Dialogue: 0,0:13:24.94,0:13:27.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ritual setelah makan Gunko.
Dialogue: 0,0:13:27.49,0:13:30.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bukan ritual. Aku hanya menyukainya.
Dialogue: 0,0:13:38.07,0:13:40.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa pun yang salah\Nmemainkan nada akan...
Dialogue: 0,0:13:44.62,0:13:47.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hobi yang bisa dinikmati kapan saja\Nseperti ini bagus juga.
Dialogue: 0,0:13:47.30,0:13:49.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagu mana yang paling kau sukai?
Dialogue: 0,0:13:50.11,0:13:51.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}New World (Dunia Baru).
Dialogue: 0,0:13:53.69,0:13:55.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau tidak puas dengan dunia saat ini?
Dialogue: 0,0:13:55.61,0:13:59.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sommers, jangan mengejek\Nkesukaan orang lain.
Dialogue: 0,0:13:59.48,0:14:01.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah. Aku yang salah.
Dialogue: 0,0:14:03.79,0:14:04.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat mereka.
Dialogue: 0,0:14:05.48,0:14:09.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka benar-benar berusaha keras\Ndemi menyelamatkan anak-anak.
Dialogue: 0,0:14:10.58,0:14:12.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekumpulan orang dewasa ini...
Dialogue: 0,0:14:31.67,0:14:34.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang tidak bisa menusukku lagi.
Dialogue: 0,0:14:34.60,0:14:36.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan harap bisa maju satu langkah lagi!
Dialogue: 0,0:14:37.44,0:14:37.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saul.
Dialogue: 0,0:14:38.50,0:14:40.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Robin, tetap di sana dan jangan bergerak.
Dialogue: 0,0:14:40.89,0:14:43.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tubuh kalian tidak akan sanggup\Nmenahan duri-duri seperti ini.
Dialogue: 0,0:14:43.95,0:14:44.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:14:45.49,0:14:47.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan tempat ini kepada Saul.
Dialogue: 0,0:14:48.13,0:14:49.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semangat, Saul!
Dialogue: 0,0:14:55.18,0:14:58.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata, kalian berjalan\Nmengikuti kain ini.
Dialogue: 0,0:15:00.96,0:15:03.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kain putih itu mengarah langsung\Nke kobaran api.
Dialogue: 0,0:15:03.42,0:15:05.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak berhenti, kalian akan mati.
Dialogue: 0,0:15:06.77,0:15:08.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pasti akan menghentikan kalian.
Dialogue: 0,0:15:09.62,0:15:10.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon!
Dialogue: 0,0:15:20.51,0:15:22.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, mereka sudah berhenti.
Dialogue: 0,0:15:33.73,0:15:36.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Ylva, Skaldi.
Dialogue: 0,0:15:36.84,0:15:41.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana keadaan orang-orang\Ndi belakang? Olav, Karin?
Dialogue: 0,0:15:45.66,0:15:47.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat.
Dialogue: 0,0:15:48.00,0:15:52.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu hentikan satu orang, mereka akan\Ntertusuk oleh duri yang ada di tubuhnya.
Dialogue: 0,0:15:52.34,0:15:55.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kejam sekali. Mereka bahkan\Nmemasang mekanisme seperti ini.
Dialogue: 0,0:15:55.67,0:15:56.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saul.
Dialogue: 0,0:15:56.49,0:16:00.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tetap harus temukan Pengguna\NBuah Iblis yang menyebabkan semua ini.
Dialogue: 0,0:16:00.72,0:16:02.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkinkah dia berada di sekitar sini?
Dialogue: 0,0:16:02.95,0:16:07.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, kalau terus mencarinya seperti ini,\Nanak-anak akan masuk ke dalam bara api.
Dialogue: 0,0:16:09.55,0:16:12.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita cari cara untuk menghentikan mereka\Nterlebih dahulu.
Dialogue: 0,0:16:12.58,0:16:16.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak bisa dari depan, kita mulai\Ndari Bjorn yang paling belakang.
Dialogue: 0,0:16:30.06,0:16:32.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus. Dia sudah keluar dari barisan.
Dialogue: 0,0:16:33.03,0:16:37.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau menghentikan mereka satu\Nper satu begini, tidak akan ada masalah.
Dialogue: 0,0:17:11.08,0:17:12.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Monster sialan!
Dialogue: 0,0:17:13.16,0:17:16.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang aku tidak punya waktu\Nuntuk mengurus kalian.
Dialogue: 0,0:17:26.08,0:17:29.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan monster-monster ini\Nbekerja sama dalam serangan ini?
Dialogue: 0,0:17:29.16,0:17:32.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu kita menghentikan seorang anak,\Nmonster akan menyerang.
Dialogue: 0,0:17:36.25,0:17:38.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial!
Dialogue: 0,0:17:38.39,0:17:41.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya siapa yang mengendalikan\Nmereka, dan di mana?
Dialogue: 0,0:17:45.23,0:17:46.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Laporan selesai.
Dialogue: 0,0:17:47.90,0:17:50.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kepala Sekolah, bukan hanya Desa Barat.
Dialogue: 0,0:17:50.60,0:17:53.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di desa-desa lainnya juga muncul\Nmonster yang sama.
Dialogue: 0,0:17:56.38,0:17:59.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah monster-monster itu\Nsudah menyebar ke seluruh Elbaph?
Dialogue: 0,0:18:00.21,0:18:02.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti ini disebabkan oleh suatu kemampuan.
Dialogue: 0,0:18:03.78,0:18:06.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus segera menemukan pelakunya.
Dialogue: 0,0:18:19.30,0:18:20.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhasil dikalahkan.
Dialogue: 0,0:18:23.08,0:18:26.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya satu Draugr saja\Nsudah begitu sulit untuk dihadapi.
Dialogue: 0,0:18:26.37,0:18:27.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bawa para korban luka kembali ke desa.
Dialogue: 0,0:18:27.86,0:18:28.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:18:41.16,0:18:42.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Petir!
Dialogue: 0,0:18:46.45,0:18:47.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Niddhoggr!
Dialogue: 0,0:19:11.21,0:19:14.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa begini. Monster\Nterus bermunculan satu demi satu.
Dialogue: 0,0:19:14.50,0:19:16.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Desa ini tidak akan mampu bertahan.
Dialogue: 0,0:19:16.61,0:19:18.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua orang, mengungsi!
Dialogue: 0,0:19:40.32,0:19:42.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hakoku!
Dialogue: 0,0:20:09.13,0:20:10.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu...
Dialogue: 0,0:20:14.36,0:20:15.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini adalah...
Dialogue: 0,0:20:18.71,0:20:21.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapal Bajak Laut, Great Eirik!
Dialogue: 0,0:20:22.68,0:20:24.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Versi Kapal Kabut!
Dialogue: 0,0:20:26.11,0:20:28.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bajak Laut Prajurit Raksasa!
Dialogue: 0,0:20:29.17,0:20:31.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para pemimpin telah datang!
Dialogue: 0,0:20:36.71,0:20:38.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, kami datang terlambat.
Dialogue: 0,0:20:38.33,0:20:41.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayang sekali, tetapi kami sudah\Nmemuntahkan semua araknya.
Dialogue: 0,0:20:41.90,0:20:44.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan monster-monster itu kepada kami.
Dialogue: 0,0:20:45.03,0:20:47.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian pergi dan selamatkan anak-anak.
Dialogue: 0,0:20:48.69,0:20:52.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengapa kalian sampai sengaja\Nmenyadarkan diri dari mabuk?
Dialogue: 0,0:21:00.91,0:21:04.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau minum, ya harus sampai\Ntumbang karena mabuk baru puas!
Dialogue: 0,0:21:07.34,0:21:09.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemakan Gunung, Ya-san!
Dialogue: 0,0:21:10.56,0:21:15.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu saja, monster-monster di pulau ini.
Dialogue: 0,0:21:16.74,0:21:19.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapal itu benar-benar tidak terkalahkan.
Dialogue: 0,0:21:34.17,0:21:42.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Berusaha keras membuka mata lebar-lebar\Nuntuk memastikan situasi di depan ♪
Dialogue: 0,0:21:45.08,0:21:52.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Otak penuh khayalan dan keputusasaan\Nentah kenapa selalu agak menyimpang ♪
Dialogue: 0,0:21:53.19,0:22:02.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Kenangan-kenangan buruk selalu\Nmuncul kembali dengan sangat jelas ♪
Dialogue: 0,0:22:04.11,0:22:12.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Memunguti kebosanan tidak berarti\Nrasanya hampir jadi orang lain ♪
Dialogue: 0,0:22:13.61,0:22:16.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Masa depan seperti apa\Nyang sebenarnya menjadi milikku ♪
Dialogue: 0,0:22:16.69,0:22:22.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Berdiri di sini dan sejauh apa pun\Nmencari tetap tidak terlihat ♪
Dialogue: 0,0:22:22.89,0:22:33.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Menentang angin dan robek ilusi salah\Nserta membuangnya ke celah takdir ♪
Dialogue: 0,0:22:33.79,0:22:41.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Orang-orang terus berputar dalam siklus\Nkenyataan yang begitu keras ini ♪
Dialogue: 0,0:22:41.92,0:22:48.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Hari esok begitu riuh hingga tidak ada\Nwaktu untuk berdoa akan segera tiba ♪
Dialogue: 0,0:22:49.12,0:22:57.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Lihat masa depan itu\Nkarena ia adalah milikku ♪
Dialogue: 0,0:23:05.16,0:23:06.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Api besar melanda Elbaph.
Dialogue: 0,0:23:07.46,0:23:11.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kobaran api yang dahsyat hendak\Nmenelan anak-anak yang sedang tertidur.
Dialogue: 0,0:23:11.72,0:23:14.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Monster menghalangi jalan,\Ndan bahaya sudah di depan mata.
Dialogue: 0,0:23:14.48,0:23:17.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serangan dahsyat seperti apa\Nyang akan dilancarkan Jinbe?
Dialogue: 0,0:23:18.40,0:23:20.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Episode selanjutnya, One Piece.
Dialogue: 0,0:23:20.08,0:23:24.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kebakaran Besar Elbaph! Kata Guruma\NSatu Tangan Jinbe yang Menggelegar!
Dialogue: 0,0:23:25.08,0:23:27.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menjadi Raja Bajak Laut!
