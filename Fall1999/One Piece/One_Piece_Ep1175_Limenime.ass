Dialogue: 0,0:00:21.28,0:00:23.32,sign,,0000,0000,0000,,{\an8}[One Piece\NEpisode 1175]
Dialogue: 0,0:21:25.80,0:21:30.69,sign,,0000,0000,0000,,[Bersambung]
Dialogue: 0,0:23:22.06,0:23:30.79,sign,,0000,0000,0000,,{\an8}[Ancaman Buah Panah,\NGunko VS Geng Topi Jerami]
Dialogue: 0,0:00:11.81,0:00:15.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Berlarilah\Nsampai tiba di sana ♪
Dialogue: 0,0:00:15.31,0:00:19.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Sampai perasaanku\Ntersampaikan kepadamu ♪
Dialogue: 0,0:00:24.56,0:00:27.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Lautan yang begitu biru dan jernih ♪
Dialogue: 0,0:00:28.22,0:00:30.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Serpihan keajaiban yang bertebaran ♪
Dialogue: 0,0:00:31.62,0:00:34.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Jumlahnya tidak terhitung lagi ♪
Dialogue: 0,0:00:34.81,0:00:37.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Kita pun dipertemukan karenanya ♪
Dialogue: 0,0:00:37.72,0:00:40.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Perjalanan yang panjang\Nlangkah kaki tidak terhenti ♪
Dialogue: 0,0:00:40.44,0:00:44.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Titik akhir masih belum terlihat juga ♪
Dialogue: 0,0:00:44.38,0:00:47.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Namun kita pasti akan\Nmelompati segala rintangan ♪
Dialogue: 0,0:00:47.95,0:00:50.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Demi melihat senyuman itu ♪
Dialogue: 0,0:00:51.09,0:00:55.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Jika tenggelam dalam kebingungan\Ntidak akan bisa menerangi jalan di depan ♪
Dialogue: 0,0:00:55.26,0:00:58.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Mengolah kelemahanmu dengan teliti\Nhingga ia berubah menjadi nutrisi ♪
Dialogue: 0,0:00:59.07,0:01:04.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Kita yang berjuang sekuat tenaga\Ntetap saja ♪
Dialogue: 0,0:01:04.62,0:01:08.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Belum ada yang berubah ♪
Dialogue: 0,0:01:08.70,0:01:09.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Berlarilah ♪
Dialogue: 0,0:01:09.78,0:01:15.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Sampai tiba di sana\Nsampai perasaan tersampaikan kepadamu ♪
Dialogue: 0,0:01:17.27,0:01:23.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Meski belum menjadi legenda\Nmemangnya kenapa! ♪
Dialogue: 0,0:01:23.93,0:01:29.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Peta itu bersinar terang\Nsuatu hari kita menoleh sambil tersenyum ♪
Dialogue: 0,0:01:29.97,0:01:36.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Kini tidak lagi bimbang\Npara pejuang teruslah maju ke depan ♪
Dialogue: 0,0:02:00.74,0:02:03.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makhluk ini benar-benar besar sekali.
Dialogue: 0,0:02:04.33,0:02:06.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Serahkan pada kami.\N- Serahkan pada kami.
Dialogue: 0,0:02:06.16,0:02:07.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ia segera datang.
Dialogue: 0,0:02:10.03,0:02:10.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nash.
Dialogue: 0,0:02:13.92,0:02:17.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, tunggu sebentar!
Dialogue: 0,0:02:20.76,0:02:22.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang saatnya!
Dialogue: 0,0:02:28.73,0:02:29.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kirim aku ke sana.
Dialogue: 0,0:02:30.63,0:02:34.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku akan menendangmu\Nsampai kau tak bisa kembali lagi.
Dialogue: 0,0:02:34.79,0:02:36.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Armée de L'air...
Dialogue: 0,0:02:41.00,0:02:42.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Power Shoot!
Dialogue: 0,0:02:58.40,0:02:59.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhasil.
Dialogue: 0,0:03:02.62,0:03:04.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang kita bisa makan sepuasnya.
Dialogue: 0,0:03:05.00,0:03:07.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan untuk Suku Raksasa pun,\Nini cukup besar.
Dialogue: 0,0:03:07.99,0:03:10.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daging groggysaurus itu enak sekali.
Dialogue: 0,0:03:11.20,0:03:14.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meskipun lemak subkutannya banyak,\Njadi agak repot mengolahnya,
Dialogue: 0,0:03:15.47,0:03:18.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tetapi, jika dimasak dengan sake\Njuga tidak kalah enaknya.
Dialogue: 0,0:03:18.96,0:03:20.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya kita bawa sake dari mana?
Dialogue: 0,0:03:21.50,0:03:24.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di pondok pemburu,\Nperalatan masaknya lengkap.
Dialogue: 0,0:03:25.35,0:03:28.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita cari sedikit rempah-rempah\Ndi sepanjang jalan sebelum kembali.
Dialogue: 0,0:03:28.35,0:03:30.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, lupakan itu dulu.
Dialogue: 0,0:03:30.97,0:03:33.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa sebenarnya dengan makhluk ini?
Dialogue: 0,0:03:34.12,0:03:35.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah Buah Iblis?
Dialogue: 0,0:03:37.60,0:03:42.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ayahku pergi menyerbu Big Mom dulu,
Dialogue: 0,0:03:42.59,0:03:44.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}perisai ini dihidupkan olehnya.
Dialogue: 0,0:03:45.85,0:03:46.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Big Mom?
Dialogue: 0,0:03:47.00,0:03:49.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata ini sama seperti kejadian Zeus.
Dialogue: 0,0:03:51.94,0:03:54.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kalian mengenal Tuan Zeus?
Dialogue: 0,0:03:55.17,0:03:58.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia adalah salah satu petinggi Homies.
Dialogue: 0,0:03:59.06,0:04:02.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, sekarang dia\Njadi pelayan navigator kami.
Dialogue: 0,0:04:05.61,0:04:07.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo pergi.
Dialogue: 0,0:04:14.16,0:04:22.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kebakaran Besar Elbaph! Kata Guruma\NSatu Tangan Jinbe yang Menggelegar!
Dialogue: 0,0:04:27.26,0:04:28.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelompok Kesatria Dewa?
Dialogue: 0,0:04:34.33,0:04:35.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul.
Dialogue: 0,0:04:37.53,0:04:40.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka pernah ke sini.
Dialogue: 0,0:04:41.69,0:04:43.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orangnya Pemerintah Dunia?
Dialogue: 0,0:04:44.50,0:04:49.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kau dipukuli\Nsampai seperti ini oleh mereka.
Dialogue: 0,0:04:53.76,0:04:55.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:05:01.04,0:05:04.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Huh, kemungkinan besar\Nsaat membuat ulah di luar negeri waktu itu
Dialogue: 0,0:05:04.87,0:05:06.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau menarik perhatian musuh, 'kan?
Dialogue: 0,0:05:06.80,0:05:08.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan banyak omong kosong.
Dialogue: 0,0:05:09.26,0:05:13.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika harus terus bertempur\Nhingga bisa bertemu mereka,
Dialogue: 0,0:05:15.08,0:05:18.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku pasti sudah menjadi Raja Dunia\Nsejak lama.
Dialogue: 0,0:05:23.72,0:05:26.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesatria Pemerintah Dunia?
Dialogue: 0,0:05:29.67,0:05:31.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami sudah pulang dari berburu.
Dialogue: 0,0:05:31.39,0:05:32.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Besar sekali!
Dialogue: 0,0:05:32.69,0:05:34.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Groggysaurus.
Dialogue: 0,0:05:36.43,0:05:38.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kandungan gizinya sangat melimpah.
Dialogue: 0,0:05:40.56,0:05:42.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang mengalahkannya.
Dialogue: 0,0:05:42.48,0:05:44.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dilakukan dengan sangat bagus.
Dialogue: 0,0:05:44.17,0:05:47.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku masih mengira itu brokoli\Nyang terbang di langit.
Dialogue: 0,0:05:48.17,0:05:52.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Koki yang tidak kompeten\Nhanya layak menjadi pembantu di dapur.
Dialogue: 0,0:05:52.86,0:05:55.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bilang apa, Bola Lumut, brokoli?
Dialogue: 0,0:05:55.12,0:05:58.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Mau berkelahi, Alis Spiral, koki payah?\N- Hebat sekali.
Dialogue: 0,0:05:59.65,0:06:00.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menggemaskan sekali.
Dialogue: 0,0:06:01.55,0:06:02.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salah.
Dialogue: 0,0:06:03.21,0:06:05.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak boleh, kalian berdua, hentikan.
Dialogue: 0,0:06:06.96,0:06:09.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kumpulkan kayu bakarnya?
Dialogue: 0,0:06:10.12,0:06:12.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, semua ditaruh di sini. Terima kasih.
Dialogue: 0,0:06:13.06,0:06:15.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang seharusnya berterima kasih.
Dialogue: 0,0:06:16.28,0:06:19.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, saatnya menunjukkan kemampuanku.
Dialogue: 0,0:06:27.58,0:06:29.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wangi sekali.
Dialogue: 0,0:06:29.25,0:06:30.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa sudah selesai?
Dialogue: 0,0:06:30.50,0:06:32.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, sebentar lagi selesai.
Dialogue: 0,0:06:32.71,0:06:38.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nasi, daging, nasi, daging, daging.
Dialogue: 0,0:06:39.63,0:06:40.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum selesai juga?
Dialogue: 0,0:06:40.96,0:06:42.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah hampir selesai.
Dialogue: 0,0:06:43.48,0:06:45.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, sudah matang.
Dialogue: 0,0:06:45.72,0:06:47.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harum sekali.
Dialogue: 0,0:06:53.33,0:06:54.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh lezat.
Dialogue: 0,0:06:54.70,0:06:56.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, itu bukan untuk kau makan duluan.
Dialogue: 0,0:06:57.42,0:06:58.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya.
Dialogue: 0,0:07:00.33,0:07:02.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Loki, makanlah.
Dialogue: 0,0:07:03.12,0:07:04.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Panas sekali!
Dialogue: 0,0:07:04.98,0:07:06.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luffy, lukanya bisa terbuka.
Dialogue: 0,0:07:08.99,0:07:10.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau membunuhku, bajingan?
Dialogue: 0,0:07:11.93,0:07:13.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah kau cukup bersemangat?
Dialogue: 0,0:07:13.58,0:07:16.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya, makan dulu\Nagar kau cepat sembuh.
Dialogue: 0,0:07:21.42,0:07:24.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sulit sekali menelannya.\NPapah agar aku bisa berdiri.
Dialogue: 0,0:07:24.68,0:07:26.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana bisa makan sambil berbaring?
Dialogue: 0,0:07:26.36,0:07:28.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bocah ini sungguh merepotkan.
Dialogue: 0,0:07:30.48,0:07:32.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tersedak? Ada sup.
Dialogue: 0,0:07:33.40,0:07:34.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu aku.
Dialogue: 0,0:07:35.15,0:07:41.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Panas, panas!
Dialogue: 0,0:07:41.12,0:07:43.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, sup itu sudah mendidih!
Dialogue: 0,0:07:43.90,0:07:46.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan kemari!
Dialogue: 0,0:07:46.01,0:07:47.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Panas, panas!
Dialogue: 0,0:07:54.44,0:07:56.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bertambah satu luka bakar lagi.
Dialogue: 0,0:07:59.88,0:08:03.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jauhkan bocah itu dari sini.
Dialogue: 0,0:08:03.50,0:08:05.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar berisik.
Dialogue: 0,0:08:05.90,0:08:07.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu sebentar, Luffy!
Dialogue: 0,0:08:07.55,0:08:09.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, aku tidak sengaja.
Dialogue: 0,0:08:11.91,0:08:13.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa bahkan Nona Gerth juga...
Dialogue: 0,0:08:30.30,0:08:34.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, sebenarnya apa yang dia lakukan\Nsampai Suku Raksasa begitu membencinya?
Dialogue: 0,0:08:35.28,0:08:37.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti dia orang jahat, ‘kan?
Dialogue: 0,0:08:40.02,0:08:41.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Janjimu dengan Luffy,
Dialogue: 0,0:08:42.42,0:08:43.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ternyata palsu, 'kan?
Dialogue: 0,0:08:45.14,0:08:48.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal keberadaan Rambut Merah sekarang ini,
Dialogue: 0,0:08:49.72,0:08:52.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sayangnya, itu sungguh bukan kebohongan.
Dialogue: 0,0:08:54.77,0:08:58.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa tahu?\NKalau begitu, coba kau ceritakan.
Dialogue: 0,0:09:01.41,0:09:07.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian janji akan membuka belengguku,\Ntetapi belum ditepati, 'kan?
Dialogue: 0,0:09:10.93,0:09:13.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak disangka kau begitu ingin\Nbertemu Rambut Merah.
Dialogue: 0,0:09:14.58,0:09:19.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, mengenai rasa kagum terhadap\Nbajak laut yang ditemui semasa kecil,
Dialogue: 0,0:09:19.80,0:09:21.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hal itu masih bisa aku pahami.
Dialogue: 0,0:09:23.38,0:09:26.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kedengarannya kau juga pernah bertemu\Nseseorang seperti itu.
Dialogue: 0,0:09:27.48,0:09:29.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, pernah.
Dialogue: 0,0:09:32.52,0:09:36.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menyesal waktu itu aku masih bocah.
Dialogue: 0,0:09:41.79,0:09:47.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon, bawa aku pergi bersamamu.
Dialogue: 0,0:09:48.81,0:09:52.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak datang\Nuntuk bertemu bocah sepertimu.
Dialogue: 0,0:09:53.08,0:09:55.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya harus kuulangi\Nberapa kali lagi?
Dialogue: 0,0:09:57.18,0:09:59.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, bertarunglah denganku!
Dialogue: 0,0:10:01.07,0:10:01.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:10:15.82,0:10:18.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menghadapi anak kecil, kenapa sampai harus\Nmenggunakan senjata?
Dialogue: 0,0:10:18.73,0:10:20.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diam, Newgate.
Dialogue: 0,0:10:38.18,0:10:39.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku...
Dialogue: 0,0:10:43.07,0:10:46.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlahir di era yang salah.
Dialogue: 0,0:11:10.41,0:11:12.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang sebenarnya terjadi?
Dialogue: 0,0:11:12.41,0:11:14.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada kebakaran dan ada monster.
Dialogue: 0,0:11:14.46,0:11:16.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak-anak tidak apa-apa, 'kan?
Dialogue: 0,0:11:19.14,0:11:21.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Api makin membesar.
Dialogue: 0,0:11:21.64,0:11:22.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan menoleh.
Dialogue: 0,0:11:23.15,0:11:24.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat lari.
Dialogue: 0,0:11:24.92,0:11:28.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang, selamatkan anak-anak dulu!
Dialogue: 0,0:11:28.74,0:11:29.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap!
Dialogue: 0,0:11:43.02,0:11:45.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Draugr benar-benar seperti pasukan.
Dialogue: 0,0:11:59.74,0:12:01.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hantunya juga banyak.
Dialogue: 0,0:12:01.83,0:12:05.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang terpikirkan oleh anak kecil\Nmemang menggemaskan.
Dialogue: 0,0:12:10.41,0:12:11.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi-lagi muncul.
Dialogue: 0,0:12:11.96,0:12:13.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak ada habisnya.
Dialogue: 0,0:12:16.52,0:12:19.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Sapu bersih semuanya!\N- Sapu bersih semuanya!
Dialogue: 0,0:12:29.74,0:12:31.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti yang diharapkan\Ndari para pemimpin.
Dialogue: 0,0:12:31.81,0:12:33.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita juga tidak boleh kalah.
Dialogue: 0,0:12:37.20,0:12:38.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah ini Loki?
Dialogue: 0,0:12:44.18,0:12:45.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan padaku.
Dialogue: 0,0:12:56.44,0:12:57.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya-san.
Dialogue: 0,0:13:00.18,0:13:01.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tebasan ini sangat cekatan.
Dialogue: 0,0:13:01.98,0:13:04.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untungnya ini hanya Loki\Ndari imajinasi anak kecil.
Dialogue: 0,0:13:04.29,0:13:07.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau melihat aslinya,\Nakankah dia lebih kuat?
Dialogue: 0,0:13:08.16,0:13:10.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,\Nlebih baik ampuni aku saja.
Dialogue: 0,0:13:12.89,0:13:15.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada waktu untuk berbicara\Nhal-hal yang tidak penting.
Dialogue: 0,0:13:15.72,0:13:18.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rekan sekalian, jangan lengah!
Dialogue: 0,0:13:22.77,0:13:25.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar saja, bertambah banyak, ada 3.
Dialogue: 0,0:13:26.40,0:13:29.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suara ganjil yang tidak mungkin\Ndisembunyikan itu terdengar.
Dialogue: 0,0:13:31.04,0:13:33.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Elbaph saja tidak aman,
Dialogue: 0,0:13:34.83,0:13:36.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berarti dunia ini juga sudah tamat.
Dialogue: 0,0:13:40.77,0:13:42.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pompa airnya belum siap?
Dialogue: 0,0:13:43.82,0:13:45.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baru saja siap.
Dialogue: 0,0:13:45.99,0:13:46.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selang air.
Dialogue: 0,0:13:48.08,0:13:50.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah terhubung\Ndan dalam keadaan siap siaga.
Dialogue: 0,0:13:51.24,0:13:52.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua orang bersiap.
Dialogue: 0,0:13:54.83,0:13:55.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awan Laut!
Dialogue: 0,0:13:56.76,0:13:58.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siram!
Dialogue: 0,0:14:15.36,0:14:17.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyusup seharusnya\Nada di dekat anak-anak,
Dialogue: 0,0:14:18.09,0:14:20.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau di tempat mereka\Nbisa melihat anak-anak.
Dialogue: 0,0:14:20.95,0:14:23.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, kalau mereka berniat menculik.
Dialogue: 0,0:14:39.47,0:14:40.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya!
Dialogue: 0,0:14:42.57,0:14:43.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana ini?
Dialogue: 0,0:14:45.75,0:14:48.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau terus seperti ini\Nakan masuk ke dalam api.
Dialogue: 0,0:14:48.97,0:14:50.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Situasinya buruk.
Dialogue: 0,0:14:50.72,0:14:52.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus sesegera mungkin\Nmenghentikan mereka.
Dialogue: 0,0:14:52.47,0:14:55.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, bagaimana caranya?
Dialogue: 0,0:14:55.98,0:14:59.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya, cepat berhenti!
Dialogue: 0,0:15:06.74,0:15:07.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa bisa dipadamkan?
Dialogue: 0,0:15:08.28,0:15:09.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Api ini benar-benar...
Dialogue: 0,0:15:25.25,0:15:29.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tim pemadam kebakaran,\Nterima kasih sudah datang!
Dialogue: 0,0:15:29.62,0:15:31.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi harus lebih cepat lagi!
Dialogue: 0,0:15:32.83,0:15:37.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak-anak akan segera masuk ke dalam api!
Dialogue: 0,0:15:37.87,0:15:40.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami sedang menyemprot\Ndengan tekanan maksimal.
Dialogue: 0,0:15:43.83,0:15:45.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katup sudah di batas terbesarnya!
Dialogue: 0,0:15:46.82,0:15:48.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepatlah padam.
Dialogue: 0,0:15:49.31,0:15:52.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tim pemadam kebakaran,\Ntambah semangat lagi!
Dialogue: 0,0:15:53.85,0:15:55.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat, Gunko.
Dialogue: 0,0:15:55.76,0:15:58.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak-anak kecil itu\Nakan terbakar sampai mati.
Dialogue: 0,0:15:58.22,0:16:00.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh pemandangan yang menyenangkan.
Dialogue: 0,0:16:02.31,0:16:05.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam kondisi seperti itu,\Nakankah anak-anak itu terbangun?
Dialogue: 0,0:16:05.25,0:16:09.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka akan tersadar oleh panasnya api,\Nmenjerit kesakitan memanggil ibu dan ayah,
Dialogue: 0,0:16:10.64,0:16:13.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kemudian dilalap api\Nhingga tinggal tulang belulang saja.
Dialogue: 0,0:16:14.23,0:16:14.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei.
Dialogue: 0,0:16:16.22,0:16:18.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sangat mengharukan!
Dialogue: 0,0:16:30.66,0:16:32.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tim pemadam kebakaran, ada apa ini?
Dialogue: 0,0:16:32.98,0:16:34.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apinya belum padam.
Dialogue: 0,0:16:39.00,0:16:41.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami sudah berusaha keras menyemprotnya.
Dialogue: 0,0:16:42.44,0:16:43.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi,
Dialogue: 0,0:16:44.86,0:16:47.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apinya sudah terlalu besar.
Dialogue: 0,0:16:52.46,0:16:53.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon!
Dialogue: 0,0:16:58.40,0:16:59.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa tidak bisa?
Dialogue: 0,0:17:02.42,0:17:03.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya.
Dialogue: 0,0:17:09.31,0:17:10.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak-Anak!
Dialogue: 0,0:17:11.14,0:17:12.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat berhenti!
Dialogue: 0,0:17:13.21,0:17:14.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat berhenti!
Dialogue: 0,0:17:15.36,0:17:16.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhenti!
Dialogue: 0,0:17:17.34,0:17:18.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon pada kalian.
Dialogue: 0,0:17:21.04,0:17:25.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhenti!
Dialogue: 0,0:17:52.62,0:17:55.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awan Laut.
Dialogue: 0,0:17:57.04,0:17:58.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kata Guruma Satu Tangan.
Dialogue: 0,0:19:04.40,0:19:07.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa-bisanya melakukan hal\Nyang merusak suasana seperti ini.
Dialogue: 0,0:19:07.80,0:19:09.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, bukan, Gunko?
Dialogue: 0,0:19:24.09,0:19:25.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, sudah selesai.
Dialogue: 0,0:19:26.81,0:19:28.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah masih sempat?
Dialogue: 0,0:19:30.52,0:19:32.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jinbe!
Dialogue: 0,0:19:32.29,0:19:33.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke sini, cepat naik!
Dialogue: 0,0:19:34.13,0:19:34.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:19:37.56,0:19:39.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti yang diharapkan dari Jinbe.
Dialogue: 0,0:19:39.34,0:19:41.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar menggugah perasaan.
Dialogue: 0,0:19:43.24,0:19:46.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang penting anak-anak selamat.
Dialogue: 0,0:19:46.71,0:19:47.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat sekali.
Dialogue: 0,0:19:47.57,0:19:48.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh, aku pikir\Nakan terjadi bencana besar.
Dialogue: 0,0:19:48.59,0:19:50.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jinbe, kau luar biasa.
Dialogue: 0,0:19:51.36,0:19:54.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini adalah area hutan ke-2\Ndi Rute Cabang 8.
Dialogue: 0,0:19:55.30,0:19:57.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Api sudah padam.
Dialogue: 0,0:20:02.77,0:20:05.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak-anak selamat!
Dialogue: 0,0:20:05.78,0:20:08.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski anak-anak selamat dari api besar,
Dialogue: 0,0:20:08.61,0:20:11.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mereka masih terus berjalan.
Dialogue: 0,0:20:11.94,0:20:13.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyaris saja.
Dialogue: 0,0:20:13.45,0:20:15.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu kalian bisa melakukannya!
Dialogue: 0,0:20:15.37,0:20:18.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus, tim pemadam kebakaran!
Dialogue: 0,0:20:18.26,0:20:21.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dewa Pelindung Elbaph.
Dialogue: 0,0:20:21.68,0:20:24.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu... bukan kami yang melakukannya.
Dialogue: 0,0:20:24.95,0:20:27.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi yang penting mereka selamat.
Dialogue: 0,0:20:27.77,0:20:29.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh bagus sekali.
Dialogue: 0,0:20:31.57,0:20:32.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Robin, tadi itu...
Dialogue: 0,0:20:33.22,0:20:36.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Jinbe ada di dekat sini.
Dialogue: 0,0:20:37.50,0:20:39.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keren sekali.
Dialogue: 0,0:20:39.51,0:20:41.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jinbe, kau keren sekali.
Dialogue: 0,0:20:42.84,0:20:44.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Jinbe.
Dialogue: 0,0:20:44.76,0:20:46.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama-sama.
Dialogue: 0,0:20:47.33,0:20:50.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meskipun anak-anak di sekolah membenciku,
Dialogue: 0,0:20:53.20,0:20:56.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku menganggap mereka teman.
Dialogue: 0,0:20:57.31,0:20:58.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bagus sekali, Colon.
Dialogue: 0,0:21:00.03,0:21:02.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita pasti akan menyelamatkan mereka.
Dialogue: 0,0:21:06.87,0:21:07.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:21:08.57,0:21:11.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rupanya masih ada anak-anak\Ndi luar sekolah juga
Dialogue: 0,0:21:16.09,0:21:16.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa?
Dialogue: 0,0:21:21.99,0:21:23.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak yang energik.
Dialogue: 0,0:21:34.17,0:21:42.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Berusaha keras membuka mata lebar-lebar\Nuntuk memastikan situasi di depan ♪
Dialogue: 0,0:21:45.08,0:21:52.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Otak penuh khayalan dan keputusasaan\Nentah kenapa selalu agak menyimpang ♪
Dialogue: 0,0:21:53.19,0:22:02.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Kenangan-kenangan buruk selalu\Nmuncul kembali dengan sangat jelas ♪
Dialogue: 0,0:22:04.11,0:22:12.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Memunguti kebosanan tidak berarti\Nrasanya hampir jadi orang lain ♪
Dialogue: 0,0:22:13.61,0:22:16.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Masa depan seperti apa\Nyang sebenarnya menjadi milikku ♪
Dialogue: 0,0:22:16.69,0:22:22.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Berdiri di sini dan sejauh apa pun\Nmencari tetap tidak terlihat ♪
Dialogue: 0,0:22:22.89,0:22:33.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Menentang angin dan robek ilusi salah\Nserta membuangnya ke celah takdir ♪
Dialogue: 0,0:22:33.79,0:22:41.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Orang-orang terus berputar dalam siklus\Nkenyataan yang begitu keras ini ♪
Dialogue: 0,0:22:41.92,0:22:48.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Hari esok begitu riuh hingga tidak ada\Nwaktu untuk berdoa akan segera tiba ♪
Dialogue: 0,0:22:49.12,0:22:57.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Lihat masa depan itu\Nkarena ia adalah milikku ♪
Dialogue: 0,0:23:04.50,0:23:10.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyadari rencana penculikan anak-anak\Nterhambat, Gunko langsung muncul.
Dialogue: 0,0:23:10.59,0:23:13.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menghadapi perlawanan\Ndari Geng Topi Jerami,
Dialogue: 0,0:23:13.11,0:23:16.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia melepaskan kemampuan Buah Iblis\Nyang luar biasa.
Dialogue: 0,0:23:16.44,0:23:20.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan luar biasa Kelompok Kesatria Dewa\Nmulai menunjukkan taringnya.
Dialogue: 0,0:23:20.54,0:23:22.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Episode selanjutnya, One Piece.
Dialogue: 0,0:23:22.20,0:23:25.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ancaman Buah Panah,\NGunko VS Geng Topi Jerami.
Dialogue: 0,0:23:25.93,0:23:28.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menjadi Raja Bajak Laut!
