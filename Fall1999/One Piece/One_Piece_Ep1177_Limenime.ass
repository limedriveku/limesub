Dialogue: 0,0:00:21.28,0:00:23.32,sign,,0000,0000,0000,,[One Piece\NEpisode 1177]
Dialogue: 0,0:08:49.76,0:08:53.91,sign,,0000,0000,0000,,[Tenggara, Desa Perajin]
Dialogue: 0,0:08:56.22,0:08:58.74,sign,,0000,0000,0000,,[Barat Laut, Desa Pemburu]
Dialogue: 0,0:21:25.71,0:21:30.69,sign,,0000,0000,0000,,[Bersambung]
Dialogue: 0,0:23:21.41,0:23:30.82,sign,,0000,0000,0000,,[Melindungi Sejarah dan Masa Depan,\NRobin dan Gaban Menyerang]
Dialogue: 0,0:00:11.81,0:00:15.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Berlarilah\Nsampai tiba di sana ♪
Dialogue: 0,0:00:15.31,0:00:19.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Sampai perasaanku\Ntersampaikan kepadamu ♪
Dialogue: 0,0:00:24.56,0:00:27.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Lautan yang begitu biru dan jernih ♪
Dialogue: 0,0:00:28.22,0:00:30.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Serpihan keajaiban yang bertebaran ♪
Dialogue: 0,0:00:31.62,0:00:34.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Jumlahnya tidak terhitung lagi ♪
Dialogue: 0,0:00:34.81,0:00:37.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Kita pun dipertemukan karenanya ♪
Dialogue: 0,0:00:37.72,0:00:40.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Perjalanan yang panjang\Nlangkah kaki tidak terhenti ♪
Dialogue: 0,0:00:40.44,0:00:44.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Titik akhir masih belum terlihat juga ♪
Dialogue: 0,0:00:44.38,0:00:47.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Namun kita pasti akan\Nmelompati segala rintangan ♪
Dialogue: 0,0:00:47.95,0:00:50.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Demi melihat senyuman itu ♪
Dialogue: 0,0:00:51.09,0:00:55.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Jika tenggelam dalam kebingungan\Ntidak akan bisa menerangi jalan di depan ♪
Dialogue: 0,0:00:55.26,0:00:58.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Mengolah kelemahanmu dengan teliti\Nhingga ia berubah menjadi nutrisi ♪
Dialogue: 0,0:00:59.07,0:01:04.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Kita yang berjuang sekuat tenaga\Ntetap saja ♪
Dialogue: 0,0:01:04.62,0:01:08.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Belum ada yang berubah ♪
Dialogue: 0,0:01:08.70,0:01:09.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Berlarilah ♪
Dialogue: 0,0:01:09.78,0:01:15.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Sampai tiba di sana\Nsampai perasaan tersampaikan kepadamu ♪
Dialogue: 0,0:01:17.27,0:01:23.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Meski belum menjadi legenda\Nmemangnya kenapa! ♪
Dialogue: 0,0:01:23.93,0:01:29.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Peta itu bersinar terang\Nsuatu hari kita menoleh sambil tersenyum ♪
Dialogue: 0,0:01:29.97,0:01:36.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Kini tidak lagi bimbang\Npara pejuang teruslah maju ke depan ♪
Dialogue: 0,0:01:41.72,0:01:49.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permainan Sandera Keji,\NAncaman Sommers yang Sombong.
Dialogue: 0,0:02:06.61,0:02:09.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus sekali, apinya sudah padam.
Dialogue: 0,0:02:09.41,0:02:11.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggulah aku, anak-anak.
Dialogue: 0,0:02:17.22,0:02:17.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saul.
Dialogue: 0,0:02:26.40,0:02:29.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku baru mulai menikmatinya.
Dialogue: 0,0:02:33.69,0:02:34.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saul.
Dialogue: 0,0:02:35.00,0:02:37.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersembunyi, Robin, Chopper.
Dialogue: 0,0:02:38.05,0:02:42.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pernah melihat orang itu.\NDia anggota Kelompok Kesatria Dewa.
Dialogue: 0,0:02:46.64,0:02:49.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka abadi,\Nkita tidak mungkin mengalahkan mereka.
Dialogue: 0,0:02:49.93,0:02:53.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus bersembunyi demi anak-anak\Ndan menunggu saat yang tepat.
Dialogue: 0,0:02:55.47,0:02:58.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sungguh kejutan yang luar biasa.
Dialogue: 0,0:03:02.57,0:03:07.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kenapa kau bisa ada di sini?
Dialogue: 0,0:03:19.93,0:03:20.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan ini?
Dialogue: 0,0:03:23.61,0:03:27.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata ada dua penyintas Ohara.
Dialogue: 0,0:03:28.81,0:03:32.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Angkatan Laut benar-benar ceroboh\Nsaat membereskan semuanya.
Dialogue: 0,0:03:32.17,0:03:32.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sakit sekali.
Dialogue: 0,0:03:36.86,0:03:39.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa lebih pelan sedikit? Dasar.
Dialogue: 0,0:03:39.59,0:03:41.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, Gunko.
Dialogue: 0,0:03:43.05,0:03:45.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa sudah menangkap Geng Topi Jerami?
Dialogue: 0,0:03:47.32,0:03:48.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini akan menarik.
Dialogue: 0,0:03:49.61,0:03:53.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Killingham, apa kita harus\Nmembawa mereka pulang? Bagaimana?
Dialogue: 0,0:03:53.43,0:03:55.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan mengatakan hal bodoh, Sommers.
Dialogue: 0,0:03:55.70,0:03:59.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian mau membuat\NLuffy si Topi Jerami marah?
Dialogue: 0,0:03:59.98,0:04:02.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau misi sudah selesai,\Nkita harus kembali.
Dialogue: 0,0:04:05.45,0:04:08.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saul sudah dibuat babak belur,\Ndan Colon juga diculik.
Dialogue: 0,0:04:09.00,0:04:10.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan ini, Jinbe?
Dialogue: 0,0:04:10.49,0:04:13.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal kau ada di sini!\NCepat pikirkan sesuatu!
Dialogue: 0,0:04:14.31,0:04:17.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suaramu terlalu keras.\NAku sedang memikirkan caranya.
Dialogue: 0,0:04:19.69,0:04:24.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, sebenarnya kemampuan macam apa ini?
Dialogue: 0,0:04:25.30,0:04:29.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wanita itu mengerikan sekali.\NKukira aku bakal mati.
Dialogue: 0,0:04:30.81,0:04:32.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, wanita itu...
Dialogue: 0,0:04:36.18,0:04:39.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, mungkin aku saja\Nyang berpikiran macam-macam.
Dialogue: 0,0:04:42.26,0:04:44.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wanita zombi datang!
Dialogue: 0,0:04:47.92,0:04:50.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}No... Nona... Anda...
Dialogue: 0,0:04:54.94,0:04:55.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Brook!
Dialogue: 0,0:04:58.46,0:04:59.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, dasar bocah.
Dialogue: 0,0:05:00.97,0:05:07.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau akan membuat lagu untukku\Nseumur hidup dan menjadi budakku.
Dialogue: 0,0:05:07.41,0:05:07.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:05:13.72,0:05:16.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenryuubito ternyata adalah\Npenggemar Soul King.
Dialogue: 0,0:05:16.99,0:05:19.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia benar-benar disukai\Noleh orang yang mengerikan.
Dialogue: 0,0:05:20.62,0:05:22.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Gunko, lupakan saja.
Dialogue: 0,0:05:23.55,0:05:27.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak ingin bertarung\Ndengan salah satu dari Empat Kaisar.
Dialogue: 0,0:05:28.45,0:05:30.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat selesaikan pekerjaanmu.
Dialogue: 0,0:05:37.03,0:05:40.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata Anda dan Soul King adalah...
Dialogue: 0,0:05:41.78,0:05:43.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sungguh minta maaf, Nona.
Dialogue: 0,0:05:46.24,0:05:46.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ini,
Dialogue: 0,0:05:47.90,0:05:54.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sejak Kapten Luffy si Topi Jerami\Nmemberiku kehidupan kedua,
Dialogue: 0,0:05:54.81,0:05:57.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku hanya akan setia kepadanya.
Dialogue: 0,0:06:10.37,0:06:13.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana jika aku menolak,\Nlalu aku membunuhmu?
Dialogue: 0,0:06:14.96,0:06:19.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maka aku lebih memilih mati daripada\Nhidup dengan mengkhianati kehormatan.
Dialogue: 0,0:06:21.02,0:06:22.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Brook.
Dialogue: 0,0:06:53.03,0:06:53.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan!
Dialogue: 0,0:06:54.13,0:06:54.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Brook!
Dialogue: 0,0:07:01.63,0:07:03.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah kau sudah siap, Killingham?
Dialogue: 0,0:07:03.82,0:07:05.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, mari kita mulai.
Dialogue: 0,0:07:11.03,0:07:14.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo, Elbaph. Bisa dengar aku?
Dialogue: 0,0:07:15.46,0:07:17.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para pejuang Elbaph.
Dialogue: 0,0:07:27.27,0:07:28.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo.
Dialogue: 0,0:07:29.19,0:07:30.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa itu?
Dialogue: 0,0:07:30.65,0:07:32.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Komunikasi macam apa ini?
Dialogue: 0,0:07:33.02,0:07:36.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang para pejuang Elbaph\Npasti sedang sibuk menghadapi
Dialogue: 0,0:07:36.57,0:07:41.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berbagai kejadian aneh\Ndi sekitar mereka, bukan?
Dialogue: 0,0:07:42.86,0:07:46.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua kejadian aneh itu,\Nkami yang melakukannya.
Dialogue: 0,0:08:08.72,0:08:10.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemimpin!
Dialogue: 0,0:08:11.44,0:08:11.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:08:12.50,0:08:16.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemimpin, seseorang sedang mengirim\Nsiaran ke seluruh Elbaph.
Dialogue: 0,0:08:17.57,0:08:18.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di mana Ange?
Dialogue: 0,0:08:19.46,0:08:22.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo, apa bisa mendengarku?
Dialogue: 0,0:08:23.99,0:08:28.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami sedang memainkan\Nsebuah permainan di Elbaph.
Dialogue: 0,0:08:28.89,0:08:32.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, aku belum memperkenalkan diri.
Dialogue: 0,0:08:36.26,0:08:39.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku adalah belati yang dikirim langsung\Ndari Tanah Suci Marijoa,
Dialogue: 0,0:08:41.01,0:08:43.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sommers, dari Kelompok Kesatria Dewa.
Dialogue: 0,0:08:44.65,0:08:46.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelompok Kesatria Dewa?
Dialogue: 0,0:08:47.03,0:08:49.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa-bisanya dia berinisiatif\Nmengungkapkan identitasnya.
Dialogue: 0,0:08:50.05,0:08:51.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Marijoa?
Dialogue: 0,0:08:51.49,0:08:53.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang-orang dari Pemerintah Dunia?
Dialogue: 0,0:08:54.12,0:08:56.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa mereka melakukan hal ini?
Dialogue: 0,0:08:59.17,0:09:01.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah anak-anak aman?
Dialogue: 0,0:09:01.78,0:09:03.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian seharusnya sudah tahu,
Dialogue: 0,0:09:04.29,0:09:08.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami sedang menyandera 10 anak kecil.
Dialogue: 0,0:09:10.52,0:09:18.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pria jenggot oranye yang demi selamatkan\Nanak-anak, dari sekolah mengejar kemari,
Dialogue: 0,0:09:21.12,0:09:23.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kini telah tumbang\Ndengan tubuh berlumuran darah.
Dialogue: 0,0:09:23.96,0:09:25.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah maksudnya adalah Saul?
Dialogue: 0,0:09:27.15,0:09:28.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudnya, anak-anak
Dialogue: 0,0:09:28.46,0:09:33.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang selama ini kalian remehkan mengira\Nakan ada yang menyelamatkan mereka,
Dialogue: 0,0:09:35.88,0:09:39.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kini hanya akan terus berjalan\Nmenuju tujuan.
Dialogue: 0,0:09:40.96,0:09:42.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh membosankan.
Dialogue: 0,0:09:46.47,0:09:47.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya...
Dialogue: 0,0:09:47.77,0:09:49.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permainan baru saja dimulai.
Dialogue: 0,0:09:51.40,0:09:54.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh menyebalkan,\Nkarena tidak bisa mengirim gambar.
Dialogue: 0,0:09:57.70,0:10:03.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah kau bisa menyebutkan nama\Nsemua anak yang berjalan keluar tadi?
Dialogue: 0,0:10:03.34,0:10:05.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Te... tentu saja.
Dialogue: 0,0:10:07.13,0:10:09.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, beri tahu orang tua mereka.
Dialogue: 0,0:10:11.10,0:10:14.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah waktunya anak-anak itu\Nterbangun dari mimpi mereka.
Dialogue: 0,0:10:24.55,0:10:28.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kenapa tubuh kita berjalan sendiri?
Dialogue: 0,0:10:28.54,0:10:29.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita mau ke mana?
Dialogue: 0,0:10:30.58,0:10:33.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga tidak tahu.\NYang jelas, ke tempat yang sangat jauh.
Dialogue: 0,0:10:33.37,0:10:37.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bohong. Ini Rute Cabang 8,\Nini jalan pulangku.
Dialogue: 0,0:10:37.55,0:10:42.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, tapi kita tidak bisa bergerak\Nsesuka hati. Kita hanya bisa terus maju.
Dialogue: 0,0:10:43.33,0:10:45.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti ini semacam kutukan.
Dialogue: 0,0:10:45.85,0:10:48.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah lelah.
Dialogue: 0,0:10:48.75,0:10:50.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada gunanya merengek.
Dialogue: 0,0:10:51.24,0:10:55.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kita tidak akan bisa pulang?\NAku tidak mau seperti ini.
Dialogue: 0,0:10:59.92,0:11:03.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Colon, kita bisa pulang, 'kan?
Dialogue: 0,0:11:05.78,0:11:06.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Colon.
Dialogue: 0,0:11:11.75,0:11:13.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau.
Dialogue: 0,0:11:13.56,0:11:16.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin bertemu Ibu,\Naku ingin bertemu Ayah.
Dialogue: 0,0:11:16.97,0:11:20.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau! Ayah, Ibu!
Dialogue: 0,0:11:20.69,0:11:22.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak akan pernah bertemu mereka lagi!
Dialogue: 0,0:11:28.38,0:11:31.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak akan pernah bertemu lagi.\NIni namanya "penculikan"!
Dialogue: 0,0:11:37.84,0:11:41.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, penculikan?
Dialogue: 0,0:11:42.18,0:11:43.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenanglah. Aku ada di sini.
Dialogue: 0,0:11:44.42,0:11:47.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berbeda dari kalian, para pengecut.\NAku adalah seorang pejuang.
Dialogue: 0,0:11:47.98,0:11:48.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pejuang?
Dialogue: 0,0:11:49.23,0:11:49.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:11:50.20,0:11:51.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan melindungi kalian.
Dialogue: 0,0:11:58.68,0:12:00.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada siluman!
Dialogue: 0,0:12:00.00,0:12:01.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Monster!
Dialogue: 0,0:12:02.16,0:12:04.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Colon, selamatkan kami!
Dialogue: 0,0:12:04.14,0:12:06.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, bukankah kau bilang\Nkau adalah pejuang?
Dialogue: 0,0:12:12.62,0:12:15.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada hantu!
Dialogue: 0,0:12:17.50,0:12:19.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Colon!
Dialogue: 0,0:12:25.07,0:12:27.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya Saul sudah dikalahkan.
Dialogue: 0,0:12:27.93,0:12:31.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putar balik!\NKita harus menyelamatkan anak-anak.
Dialogue: 0,0:12:32.11,0:12:33.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, Pemimpin!
Dialogue: 0,0:12:33.84,0:12:35.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada lubang di dasar kapal!
Dialogue: 0,0:12:35.72,0:12:36.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:12:39.31,0:12:41.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kali ini dayungnya juga patah!
Dialogue: 0,0:12:44.43,0:12:46.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial, besar sekali daya hancurnya.
Dialogue: 0,0:12:47.23,0:12:49.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya makhluk mistis apa itu?
Dialogue: 0,0:12:49.36,0:12:51.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entahlah, itu monster wanita.
Dialogue: 0,0:12:54.28,0:12:57.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku selalu merasa dia mirip sekali\Ndengan istriku.
Dialogue: 0,0:12:57.15,0:12:59.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bocah, hati-hati, kau bisa kena pukul.
Dialogue: 0,0:12:59.04,0:13:02.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemimpin! Yang di sana juga mirip istriku!
Dialogue: 0,0:13:02.61,0:13:03.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:13:03.82,0:13:07.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu. Monster-monster ini...
Dialogue: 0,0:13:10.48,0:13:14.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin berasal dari rasa takut anak-anak.
Dialogue: 0,0:13:14.69,0:13:17.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, Ange memang berkata demikian.
Dialogue: 0,0:13:17.65,0:13:24.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena dia istrimu,\Nberarti dia ibunya Bent, 'kan?
Dialogue: 0,0:13:24.17,0:13:25.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang benar.
Dialogue: 0,0:13:26.93,0:13:33.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Bent membayangkan ibunya\Nsebagai sesuatu yang menakutkan,
Dialogue: 0,0:13:38.03,0:13:39.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}maka yang muncul adalah...
Dialogue: 0,0:13:50.93,0:13:53.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu!
Dialogue: 0,0:13:58.82,0:14:01.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, kami juga takut sekali!
Dialogue: 0,0:14:01.83,0:14:03.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa!
Dialogue: 0,0:14:03.29,0:14:05.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semangat pun hampir runtuh!
Dialogue: 0,0:14:08.10,0:14:11.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku, Ibu.
Dialogue: 0,0:14:20.04,0:14:23.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pukul!
Dialogue: 0,0:14:24.12,0:14:26.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tidak akan pernah bisa\Nmengalahkan Ibu.
Dialogue: 0,0:14:47.65,0:14:49.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu Great Eirik?
Dialogue: 0,0:14:51.38,0:14:53.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu, hentikan!
Dialogue: 0,0:14:55.32,0:14:58.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku lupa membuang sampah,\Nmaafkan aku, Ibu.
Dialogue: 0,0:14:58.22,0:15:01.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku selalu minum-minum di luar, Ibu.\NMaafkan aku.
Dialogue: 0,0:15:01.40,0:15:03.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memakan kue madu untuk tamu,\Nmaafkan aku.
Dialogue: 0,0:15:04.57,0:15:06.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat, Awan Pulau akan menghilang.
Dialogue: 0,0:15:07.28,0:15:08.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemimpin,
Dialogue: 0,0:15:08.88,0:15:10.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita akan jatuh!
Dialogue: 0,0:15:10.79,0:15:12.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku!
Dialogue: 0,0:15:16.58,0:15:20.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapal Bajak Laut Prajurit Raksasa\Nyang tadi begitu gagah itu jatuh.
Dialogue: 0,0:15:20.81,0:15:23.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya mereka bertemu dengan\NMMA (Monster Mimpi Buruk) yang kuat.
Dialogue: 0,0:15:23.50,0:15:26.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkinkah itu Dorry dan Brogy?
Dialogue: 0,0:15:28.60,0:15:30.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kapalnya jatuh.
Dialogue: 0,0:15:30.51,0:15:34.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin. Kapal Kabut\Nmilik Bajak Laut Prajurit Raksasa jatuh.
Dialogue: 0,0:15:34.50,0:15:35.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat ke sana!
Dialogue: 0,0:15:35.64,0:15:37.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah Pemimpin dan yang lainnya\Nselamat atau tidak.
Dialogue: 0,0:15:37.61,0:15:39.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akan tahu kalau sudah sampai.
Dialogue: 0,0:15:41.66,0:15:45.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,\Naku akan bicara terus terang.
Dialogue: 0,0:15:45.88,0:15:48.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pejuang legendaris,\NJarul si Jenggot Gunung.
Dialogue: 0,0:15:49.55,0:15:54.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elbaph saat ini tidak punya raja,\Njadi kaulah yang wakili memegang kendali.
Dialogue: 0,0:15:56.37,0:15:59.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tujuan kami sangat sederhana,
Dialogue: 0,0:16:00.03,0:16:04.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yaitu menjadikan kalian, para Suku Raksasa\Nsebagai budak untuk bertempur.
Dialogue: 0,0:16:05.57,0:16:12.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku ingin tahu seberapa efektif\Nmenyandera anak-anak ini.
Dialogue: 0,0:16:13.72,0:16:18.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian juga pasti ingin tahu orang tua\Ndari 10 anak yang diculik ini, bukan?
Dialogue: 0,0:16:19.49,0:16:20.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebutkan.
Dialogue: 0,0:16:24.01,0:16:30.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nama anak-anak yang diculik itu adalah...
Dialogue: 0,0:16:36.13,0:16:38.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama, Ylva.
Dialogue: 0,0:16:40.43,0:16:41.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu!
Dialogue: 0,0:16:41.99,0:16:42.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ylva.
Dialogue: 0,0:16:43.34,0:16:46.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Ternyata piut perempuanku, Ylva.
Dialogue: 0,0:16:47.03,0:16:48.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya adalah Skaldi.
Dialogue: 0,0:16:49.30,0:16:51.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisakah kita memikirkan cara sendiri?
Dialogue: 0,0:16:51.81,0:16:52.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Olav.
Dialogue: 0,0:16:53.11,0:16:55.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini mimpi, pasti ini mimpi!
Dialogue: 0,0:16:55.25,0:16:59.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemimpin, Olav adalah cucuku.
Dialogue: 0,0:16:59.56,0:17:00.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karin.
Dialogue: 0,0:17:00.85,0:17:04.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, aku memang selalu sial.
Dialogue: 0,0:17:05.30,0:17:05.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mag.
Dialogue: 0,0:17:06.53,0:17:09.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku punya kekuatan,\Ntetapi kakiku tidak bisa berhenti.
Dialogue: 0,0:17:09.42,0:17:10.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ronja.
Dialogue: 0,0:17:10.60,0:17:13.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa, pasti ada jalannya.
Dialogue: 0,0:17:13.96,0:17:16.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ronja? Kenapa anakku diculik?
Dialogue: 0,0:17:17.02,0:17:19.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rute Cabang 8, ya?\NAku akan segera menyelamatkanmu.
Dialogue: 0,0:17:24.30,0:17:25.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan tempat ini padaku.
Dialogue: 0,0:17:27.39,0:17:29.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, Bent.
Dialogue: 0,0:17:29.78,0:17:32.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan dimarahi Ibu.
Dialogue: 0,0:17:33.48,0:17:34.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Johanna.
Dialogue: 0,0:17:34.81,0:17:37.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senangnya, kalian semua\Nmasih punya orang tua.
Dialogue: 0,0:17:38.68,0:17:40.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak butuh.
Dialogue: 0,0:17:40.92,0:17:41.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bjorn.
Dialogue: 0,0:17:42.16,0:17:44.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisakah kau menyelamatkanku?\NWalau hanya aku sendiri juga boleh.
Dialogue: 0,0:17:44.89,0:17:47.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh payah.\NBjorn, apa yang kau katakan tadi?
Dialogue: 0,0:17:48.09,0:17:49.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma... maafkan aku.
Dialogue: 0,0:17:49.74,0:17:51.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sama persis seperti kakakmu.
Dialogue: 0,0:17:52.34,0:17:54.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan samakan aku\Ndengan orang seperti dia.
Dialogue: 0,0:17:59.03,0:18:07.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah anak-anak yang dibawa pergi\Ndari sekolah.
Dialogue: 0,0:18:12.60,0:18:14.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para pemimpin.
Dialogue: 0,0:18:16.09,0:18:17.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Situasinya benar-benar gawat.
Dialogue: 0,0:18:17.96,0:18:18.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paman Ya-san.
Dialogue: 0,0:18:20.08,0:18:20.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ripley.
Dialogue: 0,0:18:21.10,0:18:23.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah kalian semua baik-baik saja?
Dialogue: 0,0:18:23.49,0:18:24.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau ini...
Dialogue: 0,0:18:24.48,0:18:26.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan begitu, sudah ada sembilan anak.
Dialogue: 0,0:18:27.95,0:18:35.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, tadi ada pejuang kecil bernama\NColon yang menyelamatkan temannya.
Dialogue: 0,0:18:36.64,0:18:38.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, totalnya 10 orang.
Dialogue: 0,0:18:38.66,0:18:39.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Colon?
Dialogue: 0,0:18:40.94,0:18:42.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau dengar itu, Ripley?
Dialogue: 0,0:18:42.59,0:18:44.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat, putraku.
Dialogue: 0,0:18:44.67,0:18:47.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang bukan waktunya membicarakan itu.
Dialogue: 0,0:18:48.15,0:18:50.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, dengarkan perintah.
Dialogue: 0,0:18:50.57,0:18:52.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengarkan baik-baik, Elbaph.
Dialogue: 0,0:18:52.80,0:18:55.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bakar sekolah yang tak berguna\Nuntuk pertempuran itu,
Dialogue: 0,0:18:56.95,0:19:00.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan perpustakaan yang penuh\Ncatatan sejarah tak berguna itu,
Dialogue: 0,0:19:02.03,0:19:03.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sekarang juga!
Dialogue: 0,0:19:11.84,0:19:14.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersumpahlah setia kepada kami.
Dialogue: 0,0:19:19.20,0:19:27.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika tidak, aku akan memusnahkan\Nanak-anak ini satu per satu.
Dialogue: 0,0:19:38.82,0:19:41.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan yang dibicarakan bocah itu?
Dialogue: 0,0:19:44.44,0:19:46.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tahu di mana anak-anak itu.
Dialogue: 0,0:19:46.96,0:19:47.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:19:48.71,0:19:50.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hancurkan mereka sampai babak belur!
Dialogue: 0,0:19:51.29,0:19:53.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamatkan anak-anak!
Dialogue: 0,0:19:58.85,0:20:05.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, Tetua Jarul, kaulah yang memutuskan.
Dialogue: 0,0:20:06.47,0:20:07.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku?
Dialogue: 0,0:20:11.08,0:20:12.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu! Kumohon!
Dialogue: 0,0:20:13.19,0:20:19.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini keterlaluan! Sekolah adalah\Nsimbol perdamaian Elbaph saat ini.
Dialogue: 0,0:20:20.35,0:20:21.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perpustakaan...
Dialogue: 0,0:20:23.09,0:20:25.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perpustakaan menyimpan\Nsejarah panjang Elbaph,
Dialogue: 0,0:20:26.36,0:20:31.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pengetahuan seisi dunia yang diselamatkan\Npara cendekiawan Ohara dengan nyawanya.
Dialogue: 0,0:20:36.91,0:20:37.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Robin.
Dialogue: 0,0:20:37.71,0:20:42.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekayaan ini bukan hanya milik Elbaph!
Dialogue: 0,0:20:43.03,0:20:45.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ck, kau terlalu bersemangat.
Dialogue: 0,0:20:47.66,0:20:50.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenanglah, Robin.\NKita tidak bisa keluar sekarang.
Dialogue: 0,0:20:52.28,0:20:55.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pilihlah. Anak-anak
Dialogue: 0,0:20:59.15,0:21:00.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau kesetiaan.
Dialogue: 0,0:21:06.16,0:21:07.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paman Ya-san, aku mohon.
Dialogue: 0,0:21:09.22,0:21:09.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:21:18.85,0:21:20.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan pernah
Dialogue: 0,0:21:22.98,0:21:24.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}membiarkan kalian berhasil!
Dialogue: 0,0:21:34.17,0:21:42.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Berusaha keras membuka mata lebar-lebar\Nuntuk memastikan situasi di depan ♪
Dialogue: 0,0:21:45.08,0:21:52.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Otak penuh khayalan dan keputusasaan\Nentah kenapa selalu agak menyimpang ♪
Dialogue: 0,0:21:53.19,0:22:02.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Kenangan-kenangan buruk selalu\Nmuncul kembali dengan sangat jelas ♪
Dialogue: 0,0:22:04.11,0:22:12.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Memunguti kebosanan tidak berarti\Nrasanya hampir jadi orang lain ♪
Dialogue: 0,0:22:13.61,0:22:16.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Masa depan seperti apa\Nyang sebenarnya menjadi milikku ♪
Dialogue: 0,0:22:16.69,0:22:22.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Berdiri di sini dan sejauh apa pun\Nmencari tetap tidak terlihat ♪
Dialogue: 0,0:22:22.89,0:22:33.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Menentang angin dan robek ilusi salah\Nserta membuangnya ke celah takdir ♪
Dialogue: 0,0:22:33.79,0:22:41.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Orang-orang terus berputar dalam siklus\Nkenyataan yang begitu keras ini ♪
Dialogue: 0,0:22:41.92,0:22:48.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Hari esok begitu riuh hingga tidak ada\Nwaktu untuk berdoa akan segera tiba ♪
Dialogue: 0,0:22:49.12,0:22:57.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Lihat masa depan itu\Nkarena ia adalah milikku ♪
Dialogue: 0,0:23:04.70,0:23:08.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak-anak disandera,\NElbaph berada dalam situasi genting.
Dialogue: 0,0:23:08.52,0:23:10.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan mempertaruhkan nyawa seorang gadis,
Dialogue: 0,0:23:10.20,0:23:13.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelompok Kesatria Dewa\Nterus menekan dengan cara yang keji.
Dialogue: 0,0:23:13.09,0:23:15.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hitung mundur menuju kematian\Nmenggema di seluruh penjuru.
Dialogue: 0,0:23:15.63,0:23:19.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akankah Jarul dipaksa\Nmengambil keputusan yang menyakitkan?
Dialogue: 0,0:23:19.82,0:23:21.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Episode selanjutnya, One Piece.
Dialogue: 0,0:23:21.27,0:23:24.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melindungi Sejarah dan Masa Depan,\NRobin dan Gaban Menyerang.
Dialogue: 0,0:23:25.35,0:23:27.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menjadi Raja Bajak Laut!
