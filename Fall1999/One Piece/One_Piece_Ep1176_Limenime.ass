Dialogue: 0,0:00:21.28,0:00:23.32,sign,,0000,0000,0000,,{\an8}[One Piece\NEpisode 1176]
Dialogue: 0,0:21:24.65,0:21:30.65,sign,,0000,0000,0000,,[Bersambung]
Dialogue: 0,0:23:21.65,0:23:30.80,sign,,0000,0000,0000,,{\an8}[Permainan Sandera Keji,\NAncaman Sommers yang Sombong]
Dialogue: 0,0:00:11.81,0:00:15.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Berlarilah\Nsampai tiba di sana ♪
Dialogue: 0,0:00:15.31,0:00:19.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Sampai perasaanku\Ntersampaikan kepadamu ♪
Dialogue: 0,0:00:24.56,0:00:27.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Lautan yang begitu biru dan jernih ♪
Dialogue: 0,0:00:28.22,0:00:30.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Serpihan keajaiban yang bertebaran ♪
Dialogue: 0,0:00:31.62,0:00:34.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Jumlahnya tidak terhitung lagi ♪
Dialogue: 0,0:00:34.81,0:00:37.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Kita pun dipertemukan karenanya ♪
Dialogue: 0,0:00:37.72,0:00:40.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Perjalanan yang panjang\Nlangkah kaki tidak terhenti ♪
Dialogue: 0,0:00:40.44,0:00:44.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Titik akhir masih belum terlihat juga ♪
Dialogue: 0,0:00:44.38,0:00:47.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Namun kita pasti akan\Nmelompati segala rintangan ♪
Dialogue: 0,0:00:47.95,0:00:50.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Demi melihat senyuman itu ♪
Dialogue: 0,0:00:51.09,0:00:55.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Jika tenggelam dalam kebingungan\Ntidak akan bisa menerangi jalan di depan ♪
Dialogue: 0,0:00:55.26,0:00:58.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Mengolah kelemahanmu dengan teliti\Nhingga ia berubah menjadi nutrisi ♪
Dialogue: 0,0:00:59.07,0:01:04.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Kita yang berjuang sekuat tenaga\Ntetap saja ♪
Dialogue: 0,0:01:04.62,0:01:08.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Belum ada yang berubah ♪
Dialogue: 0,0:01:08.70,0:01:09.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Berlarilah ♪
Dialogue: 0,0:01:09.78,0:01:15.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Sampai tiba di sana\Nsampai perasaan tersampaikan kepadamu ♪
Dialogue: 0,0:01:17.27,0:01:23.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Meski belum menjadi legenda\Nmemangnya kenapa! ♪
Dialogue: 0,0:01:23.93,0:01:29.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Peta itu bersinar terang\Nsuatu hari kita menoleh sambil tersenyum ♪
Dialogue: 0,0:01:29.97,0:01:36.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Kini tidak lagi bimbang\Npara pejuang teruslah maju ke depan ♪
Dialogue: 0,0:01:43.88,0:01:45.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat, Gunko.
Dialogue: 0,0:01:45.49,0:01:48.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak-anak kecil itu\Nakan terbakar sampai mati.
Dialogue: 0,0:01:48.19,0:01:50.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh pemandangan yang menyenangkan.
Dialogue: 0,0:01:53.22,0:01:55.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami sudah berusaha keras menyemprotnya.
Dialogue: 0,0:01:56.56,0:01:57.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi,
Dialogue: 0,0:01:59.25,0:02:01.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apinya sudah terlalu besar.
Dialogue: 0,0:02:07.29,0:02:08.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhenti!
Dialogue: 0,0:02:09.25,0:02:10.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon pada kalian.
Dialogue: 0,0:02:12.95,0:02:17.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhenti!
Dialogue: 0,0:02:20.84,0:02:23.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awan Laut.
Dialogue: 0,0:02:25.18,0:02:27.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kata Guruma Satu Tangan.
Dialogue: 0,0:03:05.04,0:03:08.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini adalah area hutan ke-2\Ndi Rute Cabang 8.
Dialogue: 0,0:03:09.04,0:03:11.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Api sudah padam.
Dialogue: 0,0:03:13.00,0:03:15.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak-anak selamat!
Dialogue: 0,0:03:15.91,0:03:18.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski anak-anak selamat dari api besar,
Dialogue: 0,0:03:18.90,0:03:21.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mereka masih terus berjalan.
Dialogue: 0,0:03:22.40,0:03:25.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meskipun anak-anak di sekolah membenciku,
Dialogue: 0,0:03:28.80,0:03:31.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku menganggap mereka teman.
Dialogue: 0,0:03:32.92,0:03:34.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bagus sekali, Colon.
Dialogue: 0,0:03:35.63,0:03:37.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita pasti akan menyelamatkan mereka.
Dialogue: 0,0:03:42.37,0:03:42.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:03:43.98,0:03:46.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rupanya di luar sekolah\Nmasih ada anak-anak juga.
Dialogue: 0,0:03:51.52,0:03:52.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa?
Dialogue: 0,0:03:57.54,0:03:59.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh anak-anak yang penuh semangat.
Dialogue: 0,0:04:02.02,0:04:10.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ancaman Buah Panah,\NGunko VS Geng Topi Jerami.
Dialogue: 0,0:04:25.01,0:04:26.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya siapa kau ini?
Dialogue: 0,0:04:34.10,0:04:36.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ukuran tubuh hampir sama dengan kami.
Dialogue: 0,0:04:37.23,0:04:38.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini juga berarti
Dialogue: 0,0:04:38.61,0:04:42.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dialah dari suku manusia\Nyang membuat penjaga gerbang kota
Dialogue: 0,0:04:42.58,0:04:44.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tak berkutik.
Dialogue: 0,0:04:46.10,0:04:47.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyusup.
Dialogue: 0,0:04:47.80,0:04:49.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyusup?
Dialogue: 0,0:04:49.26,0:04:52.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti kalian yang menculik\Nanak-anak itu, ya?
Dialogue: 0,0:04:59.19,0:05:01.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa-bisanya kau bilang kami suku manusia?
Dialogue: 0,0:05:05.29,0:05:06.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami adalah...
Dialogue: 0,0:05:10.72,0:05:12.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dewa.
Dialogue: 0,0:05:19.49,0:05:20.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dewa?
Dialogue: 0,0:05:20.80,0:05:22.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pikir kau itu Enel?
Dialogue: 0,0:05:22.19,0:05:25.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cara bicaramu sama persis\Nseperti Tenryuubito.
Dialogue: 0,0:05:25.14,0:05:26.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh membosankan.
Dialogue: 0,0:05:26.55,0:05:28.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak peduli kau dewa atau apa,
Dialogue: 0,0:05:28.92,0:05:32.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tetap saja tidak bisa seenaknya\Nmemperlakukan anak-anak Elbaph.
Dialogue: 0,0:05:33.23,0:05:34.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:05:34.44,0:05:36.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka adalah temanku.
Dialogue: 0,0:05:36.90,0:05:38.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian ingin membawa mereka ke mana?
Dialogue: 0,0:05:38.73,0:05:40.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kembalikan mereka!
Dialogue: 0,0:05:41.51,0:05:44.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jaga mulutmu, bocah.
Dialogue: 0,0:05:47.07,0:05:50.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami juga ingin langsung menculik mereka\Ndengan cara sederhana.
Dialogue: 0,0:05:50.78,0:05:52.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetapi ukuran tubuh mereka terlalu besar.
Dialogue: 0,0:05:52.87,0:05:55.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, hanya bisa menyuruh mereka\Nberjalan sendiri
Dialogue: 0,0:05:56.06,0:06:00.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kemudian dikawal ke Tanah Suci\Nsesuai dengan rute yang telah ditentukan.
Dialogue: 0,0:06:01.25,0:06:03.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bilang Tanah Suci, Marijoa?
Dialogue: 0,0:06:03.79,0:06:06.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengapa harus dibawa\Nke tempat seperti itu?
Dialogue: 0,0:06:06.05,0:06:08.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkinkah kau benar-benar...
Dialogue: 0,0:06:09.18,0:06:10.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenryuubito?
Dialogue: 0,0:06:12.31,0:06:14.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yaitu gerombolan\Nyang sangat mengesalkan itu…
Dialogue: 0,0:06:15.89,0:06:19.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata memang berbeda dari Tenryuubito\Nyang kita kenal.
Dialogue: 0,0:06:19.56,0:06:22.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin kedudukan mereka\Nbahkan di atas Tenryuubito.
Dialogue: 0,0:06:22.73,0:06:23.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di atas?
Dialogue: 0,0:06:24.08,0:06:24.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:06:25.43,0:06:26.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang ini adalah
Dialogue: 0,0:06:28.03,0:06:29.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}anggota Kelompok Kesatria Dewa.
Dialogue: 0,0:06:31.71,0:06:32.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tepat sekali.
Dialogue: 0,0:06:35.29,0:06:36.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelompok Kesatria Dewa?
Dialogue: 0,0:06:37.09,0:06:38.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di atas Tenryuubito?
Dialogue: 0,0:06:38.94,0:06:43.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti anak-anak yang dibawa pergi itu\Nakan ditangkap untuk dijadikan budak?
Dialogue: 0,0:06:47.58,0:06:49.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan mimpi!
Dialogue: 0,0:06:54.69,0:06:55.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zeus.
Dialogue: 0,0:06:57.60,0:07:01.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau panggil aku, Nami?
Dialogue: 0,0:07:03.42,0:07:05.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, aku ikut juga.
Dialogue: 0,0:07:07.79,0:07:09.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa dengan panah ini?
Dialogue: 0,0:07:10.01,0:07:11.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ia terus mengikutiku.
Dialogue: 0,0:07:11.81,0:07:12.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pergi kau!
Dialogue: 0,0:07:14.41,0:07:15.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhenti!
Dialogue: 0,0:07:15.63,0:07:16.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa ini?
Dialogue: 0,0:07:16.40,0:07:17.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Usopp.
Dialogue: 0,0:07:18.38,0:07:19.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersiap maju.
Dialogue: 0,0:07:19.38,0:07:20.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:07:24.50,0:07:27.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Electric Shark
Dialogue: 0,0:07:28.68,0:07:29.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempo!
Dialogue: 0,0:07:37.14,0:07:38.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dunia ini
Dialogue: 0,0:07:41.78,0:07:43.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}seharusnya tiba-tiba lenyap
Dialogue: 0,0:07:46.49,0:07:47.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}suatu hari nanti.
Dialogue: 0,0:07:58.39,0:08:00.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat lari, Nami!
Dialogue: 0,0:08:07.85,0:08:11.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Nami.
Dialogue: 0,0:08:11.88,0:08:12.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini aku.
Dialogue: 0,0:08:12.78,0:08:15.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, kau. Terima kasih.
Dialogue: 0,0:08:15.61,0:08:17.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku, sebagai pelayan, sungguh tidak becus.
Dialogue: 0,0:08:17.47,0:08:19.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau menenangkan diri dulu.
Dialogue: 0,0:08:19.48,0:08:21.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, Zeus!
Dialogue: 0,0:08:21.61,0:08:22.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun,
Dialogue: 0,0:08:23.10,0:08:26.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}beberapa dari suku manusia\Nmenyadari hal ini,
Dialogue: 0,0:08:29.17,0:08:31.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bahkan memberi tahu seluruh dunia.
Dialogue: 0,0:08:39.90,0:08:40.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus sekali!
Dialogue: 0,0:08:46.64,0:08:48.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah beres?
Dialogue: 0,0:08:51.09,0:08:54.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pikir kami akan takut\Npada Tenryuubito?
Dialogue: 0,0:08:54.15,0:08:55.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bajingan!
Dialogue: 0,0:08:55.20,0:08:56.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Usopp benar-benar keren.
Dialogue: 0,0:09:11.71,0:09:13.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah keterlaluan, Usopp,\Ntindakanmu terlalu kejam!
Dialogue: 0,0:09:13.69,0:09:15.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Separuh atas tubuhnya hilang.
Dialogue: 0,0:09:15.46,0:09:17.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:09:28.55,0:09:31.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sedang hidup kembali.
Dialogue: 0,0:09:32.24,0:09:35.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski cukup malang,\Nhidup kembali itu sangat menjijikkan.
Dialogue: 0,0:09:35.33,0:09:36.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:09:36.44,0:09:38.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa hidup kembali itu\Nsungguh membuat orang tidak nyaman.
Dialogue: 0,0:09:38.50,0:09:40.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak berhak membicarakan hal ini.
Dialogue: 0,0:09:41.68,0:09:43.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah sampai di titik ini,
Dialogue: 0,0:09:44.88,0:09:46.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sudah tidak bisa berhenti lagi.
Dialogue: 0,0:09:48.68,0:09:50.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah tidak ada siapa pun lagi
Dialogue: 0,0:09:55.32,0:09:56.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang bisa menghentikanku.
Dialogue: 0,0:09:58.46,0:09:59.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa lagi-lagi aku?
Dialogue: 0,0:10:00.10,0:10:04.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Panah ini benar-benar mengunci\Nsasaran serangan, 'kan?
Dialogue: 0,0:10:05.11,0:10:07.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan pada kami, Usopp.
Dialogue: 0,0:10:07.26,0:10:12.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah jelas menunjukkan akan menyerang,\Nkalau masih terkena bukankah bodoh sekali?
Dialogue: 0,0:10:12.98,0:10:14.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semangatlah, kalian!
Dialogue: 0,0:10:15.04,0:10:16.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minggir, kau.
Dialogue: 0,0:10:19.62,0:10:22.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penghitungan mundur sudah dimulai.
Dialogue: 0,0:10:41.82,0:10:44.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebuah perang besar yang melanda\Nseluruh dunia
Dialogue: 0,0:10:48.05,0:10:50.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan segera dimulai.
Dialogue: 0,0:10:58.19,0:10:59.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada saat itu,
Dialogue: 0,0:10:59.83,0:11:02.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suku Raksasa akan berpihak di sisi mana
Dialogue: 0,0:11:03.33,0:11:07.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan menjadi masalah yang mengubah\Njalannya perang secara drastis.
Dialogue: 0,0:11:13.70,0:11:15.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau benar-benar bisa makan.
Dialogue: 0,0:11:15.88,0:11:18.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama sekali tidak seperti orang\Nyang hampir mati.
Dialogue: 0,0:11:18.59,0:11:19.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berisik sekali.
Dialogue: 0,0:11:19.92,0:11:21.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bahkan memakan porsi makananku.
Dialogue: 0,0:11:22.29,0:11:24.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bawakan daging lagi!
Dialogue: 0,0:11:24.74,0:11:26.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau ini memang menarik.
Dialogue: 0,0:11:58.65,0:12:00.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bari bari.
Dialogue: 0,0:12:04.15,0:12:06.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bari bari.
Dialogue: 0,0:12:16.97,0:12:20.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Lilith, di sini!
Dialogue: 0,0:12:20.98,0:12:22.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat ke sini.
Dialogue: 0,0:12:28.73,0:12:30.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:12:30.50,0:12:31.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah petir?
Dialogue: 0,0:12:32.70,0:12:34.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belum pernah melihat\Nmakhluk seperti ini.
Dialogue: 0,0:12:34.95,0:12:35.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peringatan tadi
Dialogue: 0,0:12:36.43,0:12:38.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin merujuk pada makhluk ini.
Dialogue: 0,0:12:39.53,0:12:41.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat ingin tahu apa fasilitas itu.
Dialogue: 0,0:12:41.64,0:12:44.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetapi, penjelajahan hanya bisa\Ndihentikan dulu di sini.
Dialogue: 0,0:12:44.60,0:12:46.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita berkumpul dulu dengan yang lain.
Dialogue: 0,0:12:47.11,0:12:47.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:12:51.54,0:12:52.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah akan datang.
Dialogue: 0,0:12:53.26,0:12:54.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pusarku akan dicabut!
Dialogue: 0,0:12:55.52,0:12:57.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan harap!
Dialogue: 0,0:12:59.30,0:13:00.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Franky!
Dialogue: 0,0:13:04.44,0:13:06.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Radikaru!
Dialogue: 0,0:13:08.48,0:13:10.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bimu!
Dialogue: 0,0:13:18.99,0:13:19.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yeay.
Dialogue: 0,0:13:20.06,0:13:21.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuat sekali.
Dialogue: 0,0:13:21.88,0:13:24.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus sekali, sungguh bisa diandalkan.
Dialogue: 0,0:13:25.25,0:13:28.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa sebenarnya makhluk ini?
Dialogue: 0,0:13:44.57,0:13:45.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak ada habisnya.
Dialogue: 0,0:13:54.41,0:13:56.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebuah perang besar yang akan
Dialogue: 0,0:13:56.77,0:13:58.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}melanda seluruh dunia?
Dialogue: 0,0:13:59.43,0:14:04.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah kalian berniat menguasai Elbaph\Ndemi mempersiapkan diri menghadapi perang?
Dialogue: 0,0:14:04.58,0:14:07.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menjadikan anak-anak sebagai sandera,
Dialogue: 0,0:14:08.13,0:14:09.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sungguh keji.
Dialogue: 0,0:14:10.27,0:14:11.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa bisa begini?
Dialogue: 0,0:14:13.06,0:14:14.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Payah sekali.
Dialogue: 0,0:14:14.85,0:14:18.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana mungkin\Nperang terjadi di seluruh dunia?
Dialogue: 0,0:14:18.89,0:14:22.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, aku makin tidak bisa\Nmenyerahkan anak-anak itu pada kalian.
Dialogue: 0,0:14:30.85,0:14:32.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga hanya menjalankan misi.
Dialogue: 0,0:14:32.99,0:14:35.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin semuanya hanya akan sia-sia.
Dialogue: 0,0:14:35.87,0:14:38.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya nyawa beberapa anak,
Dialogue: 0,0:14:39.06,0:14:40.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tak ada bedanya dengan sampah.
Dialogue: 0,0:14:41.32,0:14:45.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sama sekali\Ntidak mengerti konsep sandera.
Dialogue: 0,0:14:48.19,0:14:50.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa otakmu bermasalah?
Dialogue: 0,0:14:52.32,0:14:54.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bajingan!
Dialogue: 0,0:15:02.79,0:15:03.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Colon!
Dialogue: 0,0:15:13.37,0:15:15.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gosenmaigawara.
Dialogue: 0,0:15:15.26,0:15:16.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gavotte Bond en Avant.
Dialogue: 0,0:15:19.92,0:15:21.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seiken
Dialogue: 0,0:15:21.02,0:15:21.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Totsushingeki.
Dialogue: 0,0:15:24.78,0:15:25.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aloe.
Dialogue: 0,0:15:31.88,0:15:33.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lepaskan Colon.
Dialogue: 0,0:15:37.27,0:15:37.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nami!
Dialogue: 0,0:15:38.32,0:15:39.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berengsek!
Dialogue: 0,0:16:00.70,0:16:02.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Colon!
Dialogue: 0,0:16:14.01,0:16:18.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana? Apakah sudah siap, Killingham?
Dialogue: 0,0:16:23.57,0:16:27.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sistem komunikasi Elbaph\Nbenar-benar terbelakang.
Dialogue: 0,0:16:28.93,0:16:30.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar sekali.
Dialogue: 0,0:16:35.61,0:16:39.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi di setiap titik penting desa
Dialogue: 0,0:16:39.42,0:16:41.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sepertinya ada alat gelombang pikiran.
Dialogue: 0,0:16:48.66,0:16:49.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kepala Sekolah Kiba.
Dialogue: 0,0:16:55.81,0:16:57.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudut, sudut.
Dialogue: 0,0:16:58.25,0:17:01.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cari sudut benda keras.
Dialogue: 0,0:17:02.22,0:17:03.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini saja.
Dialogue: 0,0:17:08.15,0:17:09.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei.
Dialogue: 0,0:17:19.31,0:17:20.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kepala Sekolah.
Dialogue: 0,0:17:21.95,0:17:24.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tubuhku... tidak bisa bergerak.
Dialogue: 0,0:17:26.97,0:17:30.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar. Aku hanya membuat tubuhmu\Nmabuk dan tertidur lemas.
Dialogue: 0,0:17:32.02,0:17:34.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan terlalu heboh\Nuntuk hal sekecil ini.
Dialogue: 0,0:17:34.83,0:17:38.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya bertanya\Ntentang cara komunikasi di Elbaph.
Dialogue: 0,0:17:40.41,0:17:42.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang besar ini, 'kan?
Dialogue: 0,0:17:43.09,0:17:45.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namanya sepertinya Den Den Mushi.
Dialogue: 0,0:17:46.57,0:17:48.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belum pernah mendengar benda ini.
Dialogue: 0,0:17:50.78,0:17:51.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sommers.
Dialogue: 0,0:17:51.93,0:17:53.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bicaralah dengan Den Den Mushi.
Dialogue: 0,0:17:54.41,0:17:57.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melalui ini, seharusnya bisa tersebar\Nke seluruh Elbaph.
Dialogue: 0,0:17:59.00,0:18:00.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, mengerti.
Dialogue: 0,0:18:01.54,0:18:03.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi maaf.
Dialogue: 0,0:18:03.57,0:18:05.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu sebentar lagi, Killingham.
Dialogue: 0,0:18:07.09,0:18:09.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makhluk ini akan segera tumbang.
Dialogue: 0,0:18:25.74,0:18:29.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia adalah\Nmantan Wakil Laksamana Angkatan Laut
Dialogue: 0,0:18:30.89,0:18:33.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang seharusnya tewas di Ohara itu.
Dialogue: 0,0:18:39.86,0:18:41.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bahkan tidak bisa\Nberdiri tegak lagi, bukan?
Dialogue: 0,0:18:41.99,0:18:43.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepatlah akhiri penderitaanmu.
Dialogue: 0,0:19:06.28,0:19:07.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Robin, Chopper.
Dialogue: 0,0:19:08.42,0:19:10.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian jangan keluar.
Dialogue: 0,0:19:10.45,0:19:13.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teruslah bersembunyi di rambutku.
Dialogue: 0,0:19:16.69,0:19:17.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:19:17.38,0:19:18.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak-anak...
Dialogue: 0,0:19:35.16,0:19:37.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak-anak Elbaph
Dialogue: 0,0:19:39.19,0:19:40.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kuserahkan pada kalian.
Dialogue: 0,0:19:41.67,0:19:43.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pastikan selamatkan mereka.
Dialogue: 0,0:19:48.54,0:19:49.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saul.
Dialogue: 0,0:19:49.80,0:19:50.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo!
Dialogue: 0,0:19:51.06,0:19:52.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terjatuhlah ke depan!
Dialogue: 0,0:20:17.61,0:20:18.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti itu!
Dialogue: 0,0:20:30.39,0:20:31.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekolah?
Dialogue: 0,0:20:31.86,0:20:32.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perpustakaan?
Dialogue: 0,0:20:34.26,0:20:36.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hidup terlalu damai\Nmembuat kalian bodoh, ya?
Dialogue: 0,0:20:39.08,0:20:43.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian adalah pejuang.
Dialogue: 0,0:20:46.70,0:20:54.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunjukkan kembali kekuatan ganas kalian\Nyang dulu membuat dunia gempar.
Dialogue: 0,0:20:57.01,0:21:00.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadilah tentara bayaran kami!
Dialogue: 0,0:21:05.80,0:21:08.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, Raja Harald?
Dialogue: 0,0:21:13.71,0:21:15.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harald si bajingan itu,
Dialogue: 0,0:21:20.41,0:21:22.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia mengacaukan semuanya.
Dialogue: 0,0:21:34.17,0:21:42.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Berusaha keras membuka mata lebar-lebar\Nuntuk memastikan situasi di depan ♪
Dialogue: 0,0:21:45.08,0:21:52.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Otak penuh khayalan dan keputusasaan\Nentah kenapa selalu agak menyimpang ♪
Dialogue: 0,0:21:53.19,0:22:02.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Kenangan-kenangan buruk selalu\Nmuncul kembali dengan sangat jelas ♪
Dialogue: 0,0:22:04.11,0:22:12.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Memunguti kebosanan tidak berarti\Nrasanya hampir jadi orang lain ♪
Dialogue: 0,0:22:13.61,0:22:16.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Masa depan seperti apa\Nyang sebenarnya menjadi milikku ♪
Dialogue: 0,0:22:16.69,0:22:22.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Berdiri di sini dan sejauh apa pun\Nmencari tetap tidak terlihat ♪
Dialogue: 0,0:22:22.89,0:22:33.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Menentang angin dan robek ilusi salah\Nserta membuangnya ke celah takdir ♪
Dialogue: 0,0:22:33.79,0:22:41.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Orang-orang terus berputar dalam siklus\Nkenyataan yang begitu keras ini ♪
Dialogue: 0,0:22:41.92,0:22:48.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Hari esok begitu riuh hingga tidak ada\Nwaktu untuk berdoa akan segera tiba ♪
Dialogue: 0,0:22:49.12,0:22:57.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Lihat masa depan itu\Nkarena ia adalah milikku ♪
Dialogue: 0,0:23:04.75,0:23:06.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi menyelamatkan anak-anak,
Dialogue: 0,0:23:06.35,0:23:08.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}para Raksasa berlarian pontang-panting\Nmati-matian.
Dialogue: 0,0:23:08.96,0:23:13.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, Saint Sommers dari Kelompok\NKesatria Dewa justru mengejek mereka.
Dialogue: 0,0:23:13.56,0:23:15.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tipu muslihat keji\Nyang akan dia gunakan selanjutnya
Dialogue: 0,0:23:15.65,0:23:19.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan menyeret Elbaph\Nke dalam penderitaan yang lebih dalam.
Dialogue: 0,0:23:20.01,0:23:21.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Episode selanjutnya, One Piece.
Dialogue: 0,0:23:21.62,0:23:25.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permainan Sandera Keji,\NAncaman Sommers yang Sombong.
Dialogue: 0,0:23:25.86,0:23:27.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menjadi Raja Bajak Laut!
