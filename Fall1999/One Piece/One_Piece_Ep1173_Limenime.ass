Dialogue: 0,0:21:24.71,0:21:30.73,sign,,0000,0000,0000,,[Bersambung]
Dialogue: 0,0:23:21.57,0:23:30.79,sign,,0000,0000,0000,,{\an8}[Selamatkan Anak-Anak,\NPejuang Elbaph Menyerang]
Dialogue: 0,0:00:11.81,0:00:15.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Berlarilah\Nsampai tiba di sana ♪
Dialogue: 0,0:00:15.31,0:00:19.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Sampai perasaanku\Ntersampaikan kepadamu ♪
Dialogue: 0,0:00:24.56,0:00:27.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Lautan yang begitu biru dan jernih ♪
Dialogue: 0,0:00:28.22,0:00:30.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Serpihan keajaiban yang bertebaran ♪
Dialogue: 0,0:00:31.62,0:00:34.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Jumlahnya tidak terhitung lagi ♪
Dialogue: 0,0:00:34.81,0:00:37.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Kita pun dipertemukan karenanya ♪
Dialogue: 0,0:00:37.72,0:00:40.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Perjalanan yang panjang\Nlangkah kaki tidak terhenti ♪
Dialogue: 0,0:00:40.44,0:00:44.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Titik akhir masih belum terlihat juga ♪
Dialogue: 0,0:00:44.38,0:00:47.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Namun kita pasti akan\Nmelompati segala rintangan ♪
Dialogue: 0,0:00:47.95,0:00:50.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Demi melihat senyuman itu ♪
Dialogue: 0,0:00:51.09,0:00:55.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Jika tenggelam dalam kebingungan\Ntidak akan bisa menerangi jalan di depan ♪
Dialogue: 0,0:00:55.26,0:00:58.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Mengolah kelemahanmu dengan teliti\Nhingga ia berubah menjadi nutrisi ♪
Dialogue: 0,0:00:59.07,0:01:04.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Kita yang berjuang sekuat tenaga\Ntetap saja ♪
Dialogue: 0,0:01:04.62,0:01:08.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Belum ada yang berubah ♪
Dialogue: 0,0:01:08.70,0:01:09.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Berlarilah ♪
Dialogue: 0,0:01:09.78,0:01:15.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Sampai tiba di sana\Nsampai perasaan tersampaikan kepadamu ♪
Dialogue: 0,0:01:17.27,0:01:23.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Meski belum menjadi legenda\Nmemangnya kenapa! ♪
Dialogue: 0,0:01:23.93,0:01:29.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Peta itu bersinar terang\Nsuatu hari kita menoleh sambil tersenyum ♪
Dialogue: 0,0:01:29.97,0:01:36.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Kini tidak lagi bimbang\Npara pejuang teruslah maju ke depan ♪
Dialogue: 0,0:01:45.62,0:01:46.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak-Anak!
Dialogue: 0,0:01:48.37,0:01:50.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian mau pergi ke mana?
Dialogue: 0,0:01:50.90,0:01:52.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat kembali!
Dialogue: 0,0:01:59.72,0:02:00.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:02:01.19,0:02:01.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku...
Dialogue: 0,0:02:02.87,0:02:06.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingat monster-monster itu.
Dialogue: 0,0:02:08.57,0:02:09.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua itu adalah...
Dialogue: 0,0:02:16.53,0:02:20.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hal-hal menakutkan yang dibayangkan\Noleh anak-anak di dalam pikiran mereka.
Dialogue: 0,0:02:30.19,0:02:30.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini adalah
Dialogue: 0,0:02:33.39,0:02:37.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hal yang ditakuti anak-anak.
Dialogue: 0,0:02:52.72,0:03:00.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permainan Mimpi Buruk,\NKonspirasi Kelompok Kesatria Dewa.
Dialogue: 0,0:03:02.50,0:03:05.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hal-hal yang ditakuti anak-anak.
Dialogue: 0,0:03:06.60,0:03:08.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengapa hal-hal itu bisa...
Dialogue: 0,0:03:08.77,0:03:10.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga tidak paham.
Dialogue: 0,0:03:23.63,0:03:25.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sini sangat berbahaya.
Dialogue: 0,0:03:26.13,0:03:27.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bawa anak-anak masuk.
Dialogue: 0,0:03:37.30,0:03:39.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, berhenti! Kalian mau pergi ke mana?
Dialogue: 0,0:03:40.72,0:03:42.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang akan mengadang anak-anak ini.
Dialogue: 0,0:03:42.80,0:03:44.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sini kuserahkan padamu.
Dialogue: 0,0:03:44.52,0:03:45.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:03:45.75,0:03:46.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saul.
Dialogue: 0,0:03:47.60,0:03:48.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami ikut juga.
Dialogue: 0,0:03:49.92,0:03:50.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:04:11.20,0:04:13.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, kalian...
Dialogue: 0,0:04:13.63,0:04:16.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ylva, Mag, Ronja.
Dialogue: 0,0:04:16.89,0:04:18.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian mau ke mana?
Dialogue: 0,0:04:20.63,0:04:23.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka benar-benar berjalan sambil tidur.
Dialogue: 0,0:04:23.34,0:04:25.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang ada penyakit seperti itu.
Dialogue: 0,0:04:25.38,0:04:28.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku belum pernah dengar\Nkasusnya terjadi secara kolektif.
Dialogue: 0,0:04:34.00,0:04:34.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:04:35.08,0:04:36.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kain berwarna putih?
Dialogue: 0,0:04:45.02,0:04:46.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu!
Dialogue: 0,0:04:47.83,0:04:49.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, semuanya kembali.
Dialogue: 0,0:04:50.08,0:04:51.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hati-hati, Saul.
Dialogue: 0,0:04:51.58,0:04:54.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guru yang tadi bilang\Njangan menyentuh anak-anak.
Dialogue: 0,0:04:55.22,0:04:57.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, dia saja sampai berlumuran darah.
Dialogue: 0,0:04:58.23,0:05:02.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kelihatannya juga tidak apa-apa.
Dialogue: 0,0:05:03.23,0:05:06.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak dihentikan,\Nakan terlalu berbahaya bagi mereka.
Dialogue: 0,0:05:07.62,0:05:08.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo.
Dialogue: 0,0:05:20.42,0:05:21.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sakit sekali!
Dialogue: 0,0:05:28.21,0:05:29.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa?
Dialogue: 0,0:05:29.16,0:05:30.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terselamatkan.
Dialogue: 0,0:05:31.84,0:05:32.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saul.
Dialogue: 0,0:05:32.90,0:05:33.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:05:35.46,0:05:37.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada sesuatu yang menusukku.
Dialogue: 0,0:05:37.93,0:05:38.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menusukmu?
Dialogue: 0,0:05:46.17,0:05:47.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang, semuanya sudah lengkap, 'kan?
Dialogue: 0,0:05:47.75,0:05:48.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:05:48.88,0:05:50.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Segera hubungi para pemimpin.
Dialogue: 0,0:05:50.72,0:05:51.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:05:52.64,0:05:54.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini Sekolah Walrus.
Dialogue: 0,0:05:55.03,0:05:55.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa bisa dengar?
Dialogue: 0,0:05:56.07,0:06:00.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini adalah Sekolah Walrus.
Dialogue: 0,0:06:00.36,0:06:00.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:06:01.14,0:06:02.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Den Den Mushi?
Dialogue: 0,0:06:03.01,0:06:05.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan Den Den Mushi, ini telepon listrik.
Dialogue: 0,0:06:05.88,0:06:09.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya bisa digunakan\Ndi dalam negara Elbaph.
Dialogue: 0,0:06:09.40,0:06:11.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah ini suara Ange?
Dialogue: 0,0:06:11.57,0:06:13.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terjadi keadaan darurat\Nyang tidak diketahui sebabnya.
Dialogue: 0,0:06:14.00,0:06:17.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak-anak tiba-tiba tertidur semuanya.
Dialogue: 0,0:06:17.71,0:06:22.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan 9 di antaranya\Nmulai berjalan ke suatu tempat.
Dialogue: 0,0:06:22.70,0:06:25.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengapa mereka bisa berjalan, sebenarnya\Nfenomena apa ini, semuanya tidak jelas.
Dialogue: 0,0:06:25.24,0:06:26.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak-Anak.
Dialogue: 0,0:06:26.61,0:06:28.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anakku juga bersekolah di sana.
Dialogue: 0,0:06:29.12,0:06:31.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidur pun masih bisa sambil berjalan?
Dialogue: 0,0:06:31.42,0:06:33.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya apa maksudnya ini?
Dialogue: 0,0:06:33.34,0:06:37.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, juga muncul monster\Nyang tak diketahui asal-usulnya di hutan.
Dialogue: 0,0:06:37.03,0:06:38.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Monster?
Dialogue: 0,0:06:38.42,0:06:40.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama sekali tidak mengerti.
Dialogue: 0,0:06:40.02,0:06:41.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak-anak tidak apa-apa, 'kan?
Dialogue: 0,0:06:42.24,0:06:45.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa saja yang dilakukan\NKepala Sekolah Kiba dan para guru?
Dialogue: 0,0:06:45.43,0:06:48.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang anak-anak sedang berjalan\Nmenuju Rute Cabang 8.
Dialogue: 0,0:06:49.33,0:06:52.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guru Saul sedang berusaha\Nmenghentikan mereka.
Dialogue: 0,0:06:53.01,0:06:57.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya adalah sekolah tadi.
Dialogue: 0,0:06:57.04,0:06:58.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih ada kebakaran, bukan?
Dialogue: 0,0:06:58.77,0:07:00.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam sekejap, semuanya kacau balau.
Dialogue: 0,0:07:01.21,0:07:02.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bilang Rute Cabang 8?
Dialogue: 0,0:07:03.35,0:07:04.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cabang 8?
Dialogue: 0,0:07:04.59,0:07:05.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bilang Rute Cabang 8?
Dialogue: 0,0:07:06.16,0:07:08.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kebetulan daerah itu sedang terbakar.
Dialogue: 0,0:07:08.52,0:07:09.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah tidak masalah?
Dialogue: 0,0:07:11.49,0:07:13.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini kejadian besar.
Dialogue: 0,0:07:13.95,0:07:18.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cicitku, Ylva, masih di sekolah.
Dialogue: 0,0:07:18.35,0:07:20.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu cicit?
Dialogue: 0,0:07:20.44,0:07:22.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mabuk kalian sudah terlalu parah!
Dialogue: 0,0:07:22.81,0:07:27.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam situasi seperti ini,\Nsetidaknya sadarlah sedikit.
Dialogue: 0,0:07:27.07,0:07:28.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau juga!
Dialogue: 0,0:07:34.42,0:07:36.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, cepat sekali.
Dialogue: 0,0:07:36.90,0:07:37.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:07:38.25,0:07:40.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasukan Pemadam Kebakaran Elbaph.
Dialogue: 0,0:07:40.20,0:07:42.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekelompok pria pemberani\Nyang tidak takut mati.
Dialogue: 0,0:07:42.77,0:07:45.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mereka datang, aku bisa tenang.
Dialogue: 0,0:07:47.72,0:07:50.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasukan Pemadam Kebakaran Elbaph,\Nberangkat!
Dialogue: 0,0:07:53.44,0:07:55.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maju, pasukan pemadam kebakaran!
Dialogue: 0,0:07:55.36,0:07:57.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon bantuannya!
Dialogue: 0,0:07:58.30,0:08:00.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita segera tiba di lokasi.
Dialogue: 0,0:08:00.39,0:08:01.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersiap menyiramkan air.
Dialogue: 0,0:08:01.93,0:08:03.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapan saja siap.
Dialogue: 0,0:08:12.99,0:08:13.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:08:41.64,0:08:42.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Besar sekali.
Dialogue: 0,0:08:42.96,0:08:43.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:08:45.38,0:08:50.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu... itu monster!
Dialogue: 0,0:08:55.48,0:08:59.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah lihat? Wajah kaget raksasa itu\Nsetelah tertusuk duri.
Dialogue: 0,0:08:59.96,0:09:02.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua orang yang dicintai itu ada durinya.
Dialogue: 0,0:09:02.60,0:09:04.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah semuanya begitu?
Dialogue: 0,0:09:04.77,0:09:05.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entahlah.
Dialogue: 0,0:09:07.47,0:09:09.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh wanita yang menyedihkan, Gunko.
Dialogue: 0,0:09:09.76,0:09:14.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cinta ialah hasrat tetap merangkul duri\Nyang makin jelas saat makin dekat.
Dialogue: 0,0:09:18.13,0:09:21.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memainkan permainan ini\Nbersama keluarga paling seru.
Dialogue: 0,0:09:22.27,0:09:24.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang tua akan memeluk anak\Nberikut durinya.
Dialogue: 0,0:09:26.37,0:09:30.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak akan saksikan sendiri kematian\Norang tua yang paling tak mau dilihatnya,
Dialogue: 0,0:09:30.36,0:09:32.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu menangis keras!
Dialogue: 0,0:09:33.81,0:09:36.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pembunuhan pun\Nbisa membuat orang tersentuh.
Dialogue: 0,0:09:39.57,0:09:41.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mati karena cinta.
Dialogue: 0,0:09:41.93,0:09:43.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sangat menantikannya, 'kan?
Dialogue: 0,0:09:46.38,0:09:47.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul, 'kan?
Dialogue: 0,0:09:54.38,0:09:56.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa-bisanya kau sama sekali\Ntidak tertarik!
Dialogue: 0,0:09:56.47,0:09:59.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar kau ini, wanita tanpa rasa cinta!
Dialogue: 0,0:09:59.76,0:10:03.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gunko, kau pilih jalan yang mana?
Dialogue: 0,0:10:03.93,0:10:07.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di tengah pulau terdapat sebatang\Ndahan besar yang menembus seluruh pulau.
Dialogue: 0,0:10:07.69,0:10:10.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku suruh anak-anak berjalan lurus\Nmengikuti itu,
Dialogue: 0,0:10:10.58,0:10:12.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk mencapai Awan Laut di dalam desa.
Dialogue: 0,0:10:13.55,0:10:15.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tengah kota bagus juga, cukup mencolok.
Dialogue: 0,0:10:16.25,0:10:19.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mampu melihat dengan jelas kenyataan\Nyang membuat mereka tidak berdaya.
Dialogue: 0,0:10:19.64,0:10:21.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teruslah melaju lurus seperti ini,
Dialogue: 0,0:10:21.13,0:10:22.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}terus melaju lurus!
Dialogue: 0,0:10:23.47,0:10:25.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sommers, garamnya kurang.
Dialogue: 0,0:10:25.81,0:10:26.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Garam?
Dialogue: 0,0:10:43.49,0:10:45.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah garam batu Asupachi?
Dialogue: 0,0:10:45.52,0:10:47.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau memang pecinta kuliner.
Dialogue: 0,0:10:48.95,0:10:50.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah bisa bangun.
Dialogue: 0,0:10:53.84,0:10:56.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mengeluarkanku\Ndari mimpiku sendiri, ya.
Dialogue: 0,0:10:58.07,0:11:01.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana dengan monster yang kau tarik\Ndari mimpi bocah-bocah itu?
Dialogue: 0,0:11:01.26,0:11:03.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja kubiarkan mereka ikut berjalan.
Dialogue: 0,0:11:03.72,0:11:05.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu selanjutnya naik kapal?
Dialogue: 0,0:11:06.20,0:11:08.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memadukan dengan garam ini cocok sekali.
Dialogue: 0,0:11:08.44,0:11:09.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beri aku juga.
Dialogue: 0,0:11:09.75,0:11:14.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi dari ketinggian ini,\Nbagaimana caranya ke laut?
Dialogue: 0,0:11:14.92,0:11:18.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pakai kapal raksasa di desa.
Dialogue: 0,0:11:18.41,0:11:22.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya ada alat bernama painter\Nyang bisa menggambar pelangi di langit.
Dialogue: 0,0:11:22.44,0:11:23.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Pelangi?
Dialogue: 0,0:11:24.06,0:11:27.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya. Ikuti pelangi itu\Nuntuk kembali ke Tanah Suci.
Dialogue: 0,0:11:29.42,0:11:31.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh budaya yang unik.
Dialogue: 0,0:11:31.27,0:11:31.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak.
Dialogue: 0,0:11:48.73,0:11:51.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah ini sudah lolos?\NPermainan ini terlalu mudah.
Dialogue: 0,0:11:52.00,0:11:53.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kenyang sekali.
Dialogue: 0,0:11:53.79,0:11:55.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, apa ini tetap nol kalori?
Dialogue: 0,0:11:55.94,0:11:58.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimanapun juga, ini hanya mimpi.
Dialogue: 0,0:11:58.30,0:12:00.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi energi yang didapat juga nol.
Dialogue: 0,0:12:00.86,0:12:02.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sommers, tenang saja.
Dialogue: 0,0:12:04.86,0:12:06.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan ada kecelakaan.
Dialogue: 0,0:12:06.87,0:12:10.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku melihat ada kapal bajak laut\Nberlabuh di Awan Laut di dalam desa.
Dialogue: 0,0:12:11.31,0:12:14.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Empat Kaisar, Geng Topi Jerami\Nsudah mendarat.
Dialogue: 0,0:12:15.31,0:12:16.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Topi Jerami?
Dialogue: 0,0:12:17.75,0:12:19.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih ada lagi. Lihatlah.
Dialogue: 0,0:12:20.89,0:12:22.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat sekali kecelakaannya.
Dialogue: 0,0:12:32.21,0:12:33.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei.
Dialogue: 0,0:12:34.06,0:12:37.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah bocah-bocah itu\Nsedang berjalan menuju api?
Dialogue: 0,0:12:37.68,0:12:41.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kali ini, mereka semua akan mati.
Dialogue: 0,0:12:42.11,0:12:42.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.
Dialogue: 0,0:12:43.41,0:12:46.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mati, suruh gelombang berikutnya\Nyang jalan.
Dialogue: 0,0:12:48.01,0:12:49.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:12:49.83,0:12:52.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula masih banyak nyawa\Nyang bisa digunakan.
Dialogue: 0,0:12:55.58,0:12:57.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saul, lukamu harus diobati.
Dialogue: 0,0:12:57.99,0:12:59.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada waktu untuk itu.
Dialogue: 0,0:13:02.49,0:13:04.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak-anak harus dihentikan dulu.
Dialogue: 0,0:13:56.80,0:13:58.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Loki, kau...
Dialogue: 0,0:13:58.96,0:14:01.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo hentikan aku, Hajrudin!
Dialogue: 0,0:14:08.27,0:14:10.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian tidak akan bisa menghentikanku.
Dialogue: 0,0:14:10.89,0:14:15.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian saja tidak sanggup\Nmengangkat Ragnir.
Dialogue: 0,0:14:17.38,0:14:18.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Luffy.
Dialogue: 0,0:14:18.81,0:14:21.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapakah sebenarnya\Nraksasa yang sangat besar ini?
Dialogue: 0,0:14:21.49,0:14:22.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namanya Loki.
Dialogue: 0,0:14:23.07,0:14:26.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia terluka parah.\NTadinya aku ingin menyelamatkannya.
Dialogue: 0,0:14:27.27,0:14:28.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Petir tadi...
Dialogue: 0,0:14:29.02,0:14:31.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga tidak ada yang terluka\Ndi Dunia Matahari.
Dialogue: 0,0:14:32.03,0:14:33.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti ada.
Dialogue: 0,0:14:33.79,0:14:38.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Petir akan memicu api,\Ndan api akan membakar seluruh Elbaph.
Dialogue: 0,0:14:39.73,0:14:40.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pilihlah.
Dialogue: 0,0:14:41.31,0:14:43.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lepaskan belengguku dan biarkan aku pergi.
Dialogue: 0,0:14:48.98,0:14:51.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau kita semua mati bersama!
Dialogue: 0,0:14:52.08,0:14:57.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan terus merenggut\Nnyawa-nyawa lemah di Dunia Matahari itu!
Dialogue: 0,0:14:59.47,0:15:01.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak menjawab...
Dialogue: 0,0:15:05.97,0:15:06.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu.
Dialogue: 0,0:15:06.71,0:15:07.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah mengerti.
Dialogue: 0,0:15:09.17,0:15:11.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan termakan tipuannya, Hajrudin!
Dialogue: 0,0:15:11.89,0:15:12.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Roronoa Zoro.
Dialogue: 0,0:15:15.48,0:15:16.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada pilihan.
Dialogue: 0,0:15:16.60,0:15:18.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dia masih bisa bergerak,\Nbiar aku yang menghentikannya.
Dialogue: 0,0:15:18.47,0:15:20.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita sudah sepakat.
Dialogue: 0,0:15:20.41,0:15:21.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, Topi Jerami!
Dialogue: 0,0:15:22.00,0:15:24.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mendekat,\Nkau akan tersengat listrik.
Dialogue: 0,0:15:25.22,0:15:26.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah mengerti
Dialogue: 0,0:15:27.31,0:15:29.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jawaban kalian.
Dialogue: 0,0:15:31.62,0:15:33.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhenti, Loki!
Dialogue: 0,0:15:33.70,0:15:37.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mengenai rekan di Dunia Matahari,\Ntidak bisa diperbaiki lagi!
Dialogue: 0,0:15:48.23,0:15:50.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luffy, kurangi kekuatanmu!
Dialogue: 0,0:15:50.47,0:15:52.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sampai lukanya terbuka lagi.
Dialogue: 0,0:15:54.69,0:15:56.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gomu-gomu...
Dialogue: 0,0:16:09.66,0:16:12.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial.
Dialogue: 0,0:16:12.15,0:16:13.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kin'niku Fusen.
Dialogue: 0,0:16:57.04,0:16:59.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awalnya, orang ini sudah hampir mati.
Dialogue: 0,0:17:00.09,0:17:04.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mempertaruhkan segalanya\Ndengan napas penghabisannya.
Dialogue: 0,0:17:04.96,0:17:06.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bisa membodohi kita,
Dialogue: 0,0:17:07.31,0:17:11.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia berniat melarikan diri\Ndan mencari sudut untuk tumbang, 'kan?
Dialogue: 0,0:17:11.81,0:17:15.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah mengalirkan darah sebanyak itu pun\Ndia masih bisa melakukan ini.
Dialogue: 0,0:17:15.90,0:17:18.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Monster yang benar-benar luar biasa.
Dialogue: 0,0:17:18.18,0:17:21.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau mengobati dia atau tidak\Nterserah kalian.
Dialogue: 0,0:17:21.96,0:17:26.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memang juga ada urusan dengan Loki.
Dialogue: 0,0:17:26.31,0:17:27.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana bisa memikirkan itu,\Ndia sudah berlumuran darah.
Dialogue: 0,0:17:27.76,0:17:34.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang, hal Loki hampir dibunuh orang\Nberbeda dengan dosa-dosa yang dia perbuat.
Dialogue: 0,0:17:36.10,0:17:38.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hamba kira-kira sudah punya\Nsedikit gambaran.
Dialogue: 0,0:17:39.13,0:17:40.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hajrudin, aku mohon.
Dialogue: 0,0:17:41.87,0:17:43.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamatkanlah nyawanya dulu.
Dialogue: 0,0:17:46.63,0:17:48.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak peduli siapa pun orang ini,
Dialogue: 0,0:17:48.76,0:17:52.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tidak sanggup\Nmembiarkan seseorang mati begitu saja.
Dialogue: 0,0:17:59.84,0:18:00.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau berburu apa?
Dialogue: 0,0:18:01.13,0:18:01.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serigala?
Dialogue: 0,0:18:02.55,0:18:04.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk membuat Loki kenyang,
Dialogue: 0,0:18:05.04,0:18:07.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}harus mencari mangsa yang lebih besar.
Dialogue: 0,0:18:07.96,0:18:10.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, badannya sebesar itu.
Dialogue: 0,0:18:11.24,0:18:13.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat selesai berburu\Nlalu pulang, Alis Spiral.
Dialogue: 0,0:18:15.37,0:18:17.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan jadi beban, Bola Lumut.
Dialogue: 0,0:18:19.84,0:18:22.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak, boleh juga\Nkau yang menjadi sasaran pertama.
Dialogue: 0,0:18:22.86,0:18:24.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mampu, coba saja.
Dialogue: 0,0:18:24.33,0:18:27.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa tidak kalian\Nberhenti bertengkar di sampingku?
Dialogue: 0,0:18:42.58,0:18:43.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana?
Dialogue: 0,0:18:43.57,0:18:44.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa disembuhkan?
Dialogue: 0,0:18:45.06,0:18:46.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk sembuh total,
Dialogue: 0,0:18:46.95,0:18:48.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin butuh berbulan-bulan.
Dialogue: 0,0:18:51.24,0:18:53.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau benar mau menyembuhkannya,
Dialogue: 0,0:18:53.12,0:18:56.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jangan biarkan dia terbaring\Ndi tempat seperti ini.
Dialogue: 0,0:18:57.20,0:19:01.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dibawa pulang ke desa pasti ada\Nyang berteriak minta dia dihukum mati.
Dialogue: 0,0:19:02.09,0:19:03.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pasti akan dibunuh.
Dialogue: 0,0:19:03.95,0:19:06.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah dia sebegitu dibenci orang?
Dialogue: 0,0:19:06.03,0:19:09.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena dia memang\Nbajingan yang sudah tak ada harapan.
Dialogue: 0,0:19:09.07,0:19:11.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bukan karena kau yang bicara,
Dialogue: 0,0:19:11.08,0:19:12.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami juga...
Dialogue: 0,0:19:14.87,0:19:16.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanduknya ternyata asli.
Dialogue: 0,0:19:17.42,0:19:20.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu adalah ciri yang ditinggalkan\Noleh Suku Raksasa Kuno.
Dialogue: 0,0:19:20.36,0:19:22.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama seperti ayahnya, Harald.
Dialogue: 0,0:19:31.04,0:19:31.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hajrudin.
Dialogue: 0,0:19:32.75,0:19:33.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Loki.
Dialogue: 0,0:19:36.37,0:19:40.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian berdua adalah\Nputra-putraku yang penting.
Dialogue: 0,0:19:41.35,0:19:44.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berharap kalian, kakak beradik rukun
Dialogue: 0,0:19:44.81,0:19:46.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sama-sama menopang Elbaph.
Dialogue: 0,0:20:00.20,0:20:02.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bocah sekecil dan selemah ini,
Dialogue: 0,0:20:02.46,0:20:04.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tidak mau dia jadi kakakku.
Dialogue: 0,0:20:04.75,0:20:06.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau anak haram.
Dialogue: 0,0:20:07.13,0:20:08.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama sekali bukan anak sah.
Dialogue: 0,0:20:10.18,0:20:11.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hajrudin,
Dialogue: 0,0:20:11.63,0:20:14.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}darah ibumu kotor.
Dialogue: 0,0:20:39.10,0:20:40.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu!
Dialogue: 0,0:20:42.10,0:20:43.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon tunggu.
Dialogue: 0,0:20:43.72,0:20:45.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan gegabah, Hajrudin.
Dialogue: 0,0:20:45.30,0:20:46.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu perasaanmu.
Dialogue: 0,0:20:46.84,0:20:50.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak pernah memaafkan bocah ini.
Dialogue: 0,0:20:50.79,0:20:51.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia menghina ibuku,
Dialogue: 0,0:20:52.23,0:20:53.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bahkan membunuh Ayah.
Dialogue: 0,0:21:00.06,0:21:03.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Majulah, pejuang gila yang memilukan.
Dialogue: 0,0:21:05.99,0:21:09.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kau punya waktu untuk larut\Ndalam kesedihanmu sendiri,
Dialogue: 0,0:21:10.13,0:21:11.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lihatlah hutan itu.
Dialogue: 0,0:21:12.64,0:21:14.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau juga tidak berpikir
Dialogue: 0,0:21:15.39,0:21:24.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau aku benar-benar sengaja\Nmembunuh Ayah, 'kan?
Dialogue: 0,0:21:34.17,0:21:42.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Berusaha keras membuka mata lebar-lebar\Nuntuk memastikan situasi di depan ♪
Dialogue: 0,0:21:45.08,0:21:52.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Otak penuh khayalan dan keputusasaan\Nentah kenapa selalu agak menyimpang ♪
Dialogue: 0,0:21:53.19,0:22:02.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Kenangan-kenangan buruk selalu\Nmuncul kembali dengan sangat jelas ♪
Dialogue: 0,0:22:04.11,0:22:12.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Memunguti kebosanan tidak berarti\Nrasanya hampir jadi orang lain ♪
Dialogue: 0,0:22:13.61,0:22:16.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Masa depan seperti apa\Nyang sebenarnya menjadi milikku ♪
Dialogue: 0,0:22:16.69,0:22:22.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Berdiri di sini dan sejauh apa pun\Nmencari tetap tidak terlihat ♪
Dialogue: 0,0:22:22.89,0:22:33.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Menentang angin dan robek ilusi salah\Nserta membuangnya ke celah takdir ♪
Dialogue: 0,0:22:33.79,0:22:41.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Orang-orang terus berputar dalam siklus\Nkenyataan yang begitu keras ini ♪
Dialogue: 0,0:22:41.92,0:22:48.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Hari esok begitu riuh hingga tidak ada\Nwaktu untuk berdoa akan segera tiba ♪
Dialogue: 0,0:22:49.12,0:22:57.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Lihat masa depan itu\Nkarena ia adalah milikku ♪
Dialogue: 0,0:23:04.92,0:23:07.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya, monster-monster\Nmenyerbu desa raksasa.
Dialogue: 0,0:23:08.60,0:23:12.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nami dan yang lain terkejut\Nmelihatnya langsung.
Dialogue: 0,0:23:13.09,0:23:16.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Langkah anak-anak pun\Nmakin mendekati lautan api.
Dialogue: 0,0:23:16.79,0:23:20.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, bagaimana para raksasa\Nakan menghadapinya?
Dialogue: 0,0:23:20.17,0:23:21.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Episode selanjutnya, One Piece.
Dialogue: 0,0:23:21.61,0:23:25.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamatkan Anak-Anak,\NPejuang Elbaph Menyerang.
Dialogue: 0,0:23:25.51,0:23:27.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menjadi Raja Bajak Laut!
