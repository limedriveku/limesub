Dialogue: 0,0:03:03.51,0:03:07.68,sign,,0000,0000,0000,,BLUE BOX\NMUSIM 2
Dialogue: 0,0:04:30.01,0:04:31.10,sign,,0000,0000,0000,,SMA SWASTA EIMEI
Dialogue: 0,0:04:31.10,0:04:33.60,sign,,0000,0000,0000,,EPISODE 27\NKEKAGUMAN
Dialogue: 0,0:05:57.27,0:05:59.19,sign,,0000,0000,0000,,{\an8}RUANG LATIHAN
Dialogue: 0,0:07:34.99,0:07:37.41,sign,,0000,0000,0000,,{\an8}INOMATA
Dialogue: 0,0:08:03.02,0:08:04.94,sign,,0000,0000,0000,,KLINIK GIGI KIKUCHI
Dialogue: 0,0:08:42.56,0:08:44.68,sign,,0000,0000,0000,,{\an8}SILAKAN MENONTON
Dialogue: 0,0:09:53.71,0:09:55.13,sign,,0000,0000,0000,,{\an8}TEH BARLI
Dialogue: 0,0:10:06.73,0:10:08.48,sign,,0000,0000,0000,,TEH BARLI MANIS
Dialogue: 0,0:00:14.51,0:00:15.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yumeka.
Dialogue: 0,0:00:16.51,0:00:17.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:00:17.76,0:00:20.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serius?
Dialogue: 0,0:00:20.77,0:00:23.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau juga punya pacar?
Dialogue: 0,0:00:28.02,0:00:30.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah menyerah jadi juara nasional?
Dialogue: 0,0:00:35.45,0:00:36.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belum menyerah.
Dialogue: 0,0:00:40.04,0:00:41.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Begitu rupanya.
Dialogue: 0,0:00:41.70,0:00:44.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak dulu kau selalu cepat belajar.
Dialogue: 0,0:00:44.66,0:00:47.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal awalnya dribel pun tidak bisa.
Dialogue: 0,0:00:47.79,0:00:50.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang kau pemain utama.
Dialogue: 0,0:00:50.92,0:00:54.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu,\Nkehidupan pribadimu juga menyenangkan.
Dialogue: 0,0:00:54.63,0:00:57.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak sekali.
Dialogue: 0,0:00:57.72,0:00:58.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei.
Dialogue: 0,0:00:59.22,0:01:01.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tak bisa lebih sopan?
Dialogue: 0,0:01:01.01,0:01:02.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ucapanku biasa saja.
Dialogue: 0,0:01:02.97,0:01:05.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sebabnya\Nnilai Bahasa Jepang Modern-mu jelek.
Dialogue: 0,0:01:05.60,0:01:07.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nilaiku A, tahu.
Dialogue: 0,0:01:08.15,0:01:09.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:01:09.44,0:01:12.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya dia terpengaruh ketinggiannya.\NKami permisi.
Dialogue: 0,0:01:12.36,0:01:13.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya aku monyet?
Dialogue: 0,0:01:13.94,0:01:14.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}IQ monyet…
Dialogue: 0,0:01:14.99,0:01:16.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak perlu informasi itu.
Dialogue: 0,0:01:16.70,0:01:17.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak perlu?
Dialogue: 0,0:01:21.45,0:01:22.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia memelototiku.{\i0}
Dialogue: 0,0:01:24.91,0:01:26.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:01:26.00,0:01:27.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah dia…
Dialogue: 0,0:01:28.21,0:01:29.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anggota tim lamaku.
Dialogue: 0,0:01:30.59,0:01:33.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia di Eimei sampai SMP,
Dialogue: 0,0:01:33.21,0:01:35.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu pindah ke SMA lain.
Dialogue: 0,0:01:37.30,0:01:38.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pernah melihatnya.
Dialogue: 0,0:01:40.22,0:01:41.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jika membicarakan permainannya,{\i0}
Dialogue: 0,0:01:41.89,0:01:45.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dia lebih menarik perhatian\Ndaripada Kak Chinatsu.{\i0}
Dialogue: 0,0:01:47.02,0:01:49.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dengar rumor bahwa dia berhenti.
Dialogue: 0,0:01:50.31,0:01:51.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata dia seperti itu.
Dialogue: 0,0:01:56.11,0:01:57.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah larut.
Dialogue: 0,0:01:57.78,0:01:59.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya kita pulang.
Dialogue: 0,0:01:59.61,0:02:00.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:02:11.92,0:02:13.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi…
Dialogue: 0,0:02:13.92,0:02:15.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin kau bisa.
Dialogue: 0,0:02:16.84,0:02:18.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menjadi juara nasional.
Dialogue: 0,0:02:23.10,0:02:24.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja.
Dialogue: 0,0:02:28.94,0:02:30.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berapa stasiun lagi?
Dialogue: 0,0:02:30.85,0:02:32.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa tiga lagi.
Dialogue: 0,0:02:34.11,0:02:36.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bahu kami bersentuhan!{\i0}
Dialogue: 0,0:02:44.62,0:02:45.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Silakan!\N- Silakan!
Dialogue: 0,0:02:45.87,0:02:47.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:04:33.60,0:04:35.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lari!
Dialogue: 0,0:04:36.27,0:04:38.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yuki, terus jaga Nagisa!
Dialogue: 0,0:04:38.02,0:04:40.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian mau bermain seperti itu\Ndi Kejuaraan Musim Dingin?
Dialogue: 0,0:04:40.78,0:04:42.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kano, fokus pada sekitarmu!
Dialogue: 0,0:04:42.86,0:04:43.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:04:44.32,0:04:48.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar Kejuaraan Musim Dingin\Ndiadakan selama Natal.
Dialogue: 0,0:04:48.20,0:04:49.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah tahu.
Dialogue: 0,0:04:50.08,0:04:52.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Artinya kita harus makan malam\Nbersama tim.
Dialogue: 0,0:04:52.33,0:04:53.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedih sekali.
Dialogue: 0,0:04:53.71,0:04:55.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan begitu.
Dialogue: 0,0:04:55.29,0:05:00.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tahun lalu,\Nkita berkumpul sekelas, tapi tahun ini…
Dialogue: 0,0:05:01.84,0:05:03.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tahun ini kita berlatih.
Dialogue: 0,0:05:03.88,0:05:04.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:05:04.84,0:05:08.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa tidak berlatih\Ncuma karena malam Natal?
Dialogue: 0,0:05:08.09,0:05:10.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bukan karena aku kesepian
Dialogue: 0,0:05:10.14,0:05:11.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau benci orang yang punya pacar.
Dialogue: 0,0:05:11.89,0:05:15.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Latihan seharian sampai malam\Nadalah hadiah dariku.
Dialogue: 0,0:05:18.60,0:05:20.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau senang, 'kan, Haryu?
Dialogue: 0,0:05:21.44,0:05:22.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:05:22.48,0:05:25.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kakakku mengeluh.
Dialogue: 0,0:05:27.99,0:05:29.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau angkat beban.
Dialogue: 0,0:05:30.41,0:05:31.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ikut.
Dialogue: 0,0:05:36.25,0:05:40.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sepertinya dia tak bersama Kak Chinatsu\Nsaat Natal nanti.{\i0}
Dialogue: 0,0:05:42.13,0:05:44.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tidak boleh. Menguping itu buruk.{\i0}
Dialogue: 0,0:05:44.96,0:05:46.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku cuma kebetulan mendengarnya.{\i0}
Dialogue: 0,0:05:46.80,0:05:49.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku masih menggapai segelintir harapan.{\i0}
Dialogue: 0,0:05:49.84,0:05:53.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hina, sepertinya latihan saat Natal\Ntidak wajib. Bagaimana?
Dialogue: 0,0:05:55.93,0:05:56.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ikut.
Dialogue: 0,0:06:03.32,0:06:04.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Haryu.
Dialogue: 0,0:06:04.65,0:06:05.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya?
Dialogue: 0,0:06:05.82,0:06:07.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau bertanya.
Dialogue: 0,0:06:07.78,0:06:09.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:06:10.32,0:06:11.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Jangan tanya jika…\N- Aku…
Dialogue: 0,0:06:12.53,0:06:14.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau kenal Yumeka,\Nmantan anggota tim basket?
Dialogue: 0,0:06:16.54,0:06:19.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dari ekspresinya,\Ndia benar-benar tidak suka.{\i0}
Dialogue: 0,0:06:19.92,0:06:23.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah lama aku tak dengar nama\Nsi Menteri Sinis.
Dialogue: 0,0:06:24.38,0:06:27.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bertemu Yumeka tempo hari.
Dialogue: 0,0:06:28.51,0:06:29.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chii juga?
Dialogue: 0,0:06:29.43,0:06:31.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:06:31.30,0:06:32.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari mana kau tahu?
Dialogue: 0,0:06:33.01,0:06:33.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entahlah.
Dialogue: 0,0:06:34.76,0:06:36.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti sangat tegang, 'kan?
Dialogue: 0,0:06:36.85,0:06:37.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:06:38.18,0:06:40.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi penasaran kenapa dia berhenti.
Dialogue: 0,0:06:41.15,0:06:43.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga tak tahu detailnya.
Dialogue: 0,0:06:44.15,0:06:45.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Harga dirinya tinggi{\i0}
Dialogue: 0,0:06:45.57,0:06:48.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dan dia tak suka minta saran\Nkepada orang lain.{\i0}
Dialogue: 0,0:06:49.32,0:06:51.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi tak mungkin\Ndia tiba-tiba benci basket.
Dialogue: 0,0:06:53.07,0:06:54.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetap saja,
Dialogue: 0,0:06:54.28,0:06:57.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chii yang paling syok waktu itu.
Dialogue: 0,0:06:58.20,0:07:01.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia bermain basket bersamanya\Nsejak mereka tujuh tahun.{\i0}
Dialogue: 0,0:07:02.54,0:07:05.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kau tahu Chii selalu datang pagi-pagi\Nuntuk berlatih, 'kan?
Dialogue: 0,0:07:05.88,0:07:06.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Ya.
Dialogue: 0,0:07:07.46,0:07:08.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dulu katanya,{\i0}
Dialogue: 0,0:07:09.05,0:07:12.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dia harus begitu\Nagar bisa mengejar Yumeka.{\i0}
Dialogue: 0,0:07:15.76,0:07:19.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Yumeka membantu Kak Chinatsu terus maju.{\i0}
Dialogue: 0,0:07:21.23,0:07:22.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jadi, kenapa?{\i0}
Dialogue: 0,0:07:23.77,0:07:26.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bagaimana perasaan Kak Chinatsu{\i0}
Dialogue: 0,0:07:27.36,0:07:29.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}saat mendengar teman dan anggota tim\Nyang dia kagumi{\i0}
Dialogue: 0,0:07:30.36,0:07:33.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}menanyakan apakah dia\Nsudah berhenti basket?{\i0}
Dialogue: 0,0:07:38.41,0:07:40.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sakit!
Dialogue: 0,0:07:40.50,0:07:42.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Sakit gigi?
Dialogue: 0,0:07:43.12,0:07:46.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu karena belakangan ini\Nkau terus melamun saat gosok gigi.
Dialogue: 0,0:07:47.59,0:07:49.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau ke dokter gigi.
Dialogue: 0,0:07:49.17,0:07:50.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempat itu sudah tutup.
Dialogue: 0,0:07:50.59,0:07:51.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:07:52.01,0:07:54.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dokter gigi\Ndi dekat Stasiun Azumabara bagus.
Dialogue: 0,0:07:54.34,0:07:56.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba pergi ke sana saja.
Dialogue: 0,0:07:56.93,0:07:58.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:08:05.77,0:08:07.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi.
Dialogue: 0,0:08:08.15,0:08:10.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang membuat janji lewat telepon.
Dialogue: 0,0:08:10.36,0:08:12.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bawa kartu asuransi?
Dialogue: 0,0:08:12.07,0:08:13.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:08:14.49,0:08:15.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:08:17.45,0:08:19.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inomata…
Dialogue: 0,0:08:25.33,0:08:27.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taiki Inomata.
Dialogue: 0,0:08:33.22,0:08:34.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Canggung sekali.{\i0}
Dialogue: 0,0:08:35.38,0:08:36.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Benar juga, tonton TV saja.{\i0}
Dialogue: 0,0:08:36.80,0:08:37.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Belum selesai.{\i0}
Dialogue: 0,0:08:37.80,0:08:39.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong jangan sentuh tanpa izin.
Dialogue: 0,0:08:40.56,0:08:42.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa?{\i0}
Dialogue: 0,0:08:44.69,0:08:46.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia jelas membenciku.{\i0}
Dialogue: 0,0:08:46.60,0:08:49.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa karena dia pikir\Naku pacar Kak Chinatsu?{\i0}
Dialogue: 0,0:08:49.65,0:08:51.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku harus menjelaskan soal itu.{\i0}
Dialogue: 0,0:08:51.53,0:08:53.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tapi aku tak wajib menjelaskannya.{\i0}
Dialogue: 0,0:08:54.24,0:08:55.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sebenarnya,{\i0}
Dialogue: 0,0:08:56.24,0:08:59.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}jika aku bisa menyatakan\Nperasaanku hari itu…{\i0}
Dialogue: 0,0:08:59.12,0:09:00.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pak Inomata.
Dialogue: 0,0:09:00.45,0:09:01.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan.
Dialogue: 0,0:09:01.58,0:09:02.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:09:07.46,0:09:09.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sandalmu berbeda.
Dialogue: 0,0:09:09.42,0:09:10.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:09:11.84,0:09:12.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuganti dulu!
Dialogue: 0,0:09:12.80,0:09:14.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu saja tak apa-apa.
Dialogue: 0,0:09:15.09,0:09:16.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepatlah masuk.
Dialogue: 0,0:09:19.97,0:09:22.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sudah mencapai saraf.
Dialogue: 0,0:09:23.81,0:09:27.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku jelas berhak komplain\Natas pelayanannya!{\i0}
Dialogue: 0,0:09:28.31,0:09:30.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga lekas sembuh.
Dialogue: 0,0:09:30.27,0:09:32.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:09:36.32,0:09:38.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Totalnya 1.930 yen.
Dialogue: 0,0:09:39.12,0:09:43.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sepertinya aku harus ke dokter gigi ini\Nbeberapa kali lagi.{\i0}
Dialogue: 0,0:09:44.25,0:09:47.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Apakah ini artinya\Naku harus bertemu dengannya lagi?{\i0}
Dialogue: 0,0:09:57.09,0:09:59.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Langsung minum jus setelah perawatan gigi?
Dialogue: 0,0:10:02.39,0:10:03.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Ini teh.
Dialogue: 0,0:10:03.97,0:10:06.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, itu teh, tapi tetap mengandung gula.
Dialogue: 0,0:10:08.48,0:10:10.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga!
Dialogue: 0,0:10:11.73,0:10:13.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau memang dokter gigi.
Dialogue: 0,0:10:14.73,0:10:17.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma resepsionis paruh waktu.
Dialogue: 0,0:10:17.36,0:10:18.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paruh waktu?
Dialogue: 0,0:10:18.99,0:10:22.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau menghasilkan uang saku sendiri.
Dialogue: 0,0:10:23.37,0:10:25.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sebabnya kau berhenti main basket?
Dialogue: 0,0:10:30.83,0:10:31.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:10:32.29,0:10:33.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pergi.
Dialogue: 0,0:10:33.63,0:10:34.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan.
Dialogue: 0,0:10:36.38,0:10:39.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berhenti\Nkarena mulai membenci Chinatsu.
Dialogue: 0,0:10:41.93,0:10:42.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:10:42.85,0:10:44.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, aku mulai bosan.
Dialogue: 0,0:10:45.06,0:10:46.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku merasa sudah cukup bermain.
Dialogue: 0,0:10:47.35,0:10:48.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak mungkin begitu.
Dialogue: 0,0:10:48.39,0:10:49.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:10:49.64,0:10:52.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pikir tak mungkin\Nada yang membenci pacarmu?
Dialogue: 0,0:10:52.77,0:10:54.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan begitu!
Dialogue: 0,0:10:55.23,0:10:58.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mereka sangat akrab saat SMP.{\i0}
Dialogue: 0,0:11:00.07,0:11:01.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tapi sekarang…{\i0}
Dialogue: 0,0:11:03.07,0:11:04.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu.
Dialogue: 0,0:11:04.28,0:11:06.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tak beri tahu Kak Chinatsu, 'kan?
Dialogue: 0,0:11:07.95,0:11:08.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuberi tahu.
Dialogue: 0,0:11:20.72,0:11:22.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang, Taiki.
Dialogue: 0,0:11:27.06,0:11:28.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini dingin.
Dialogue: 0,0:11:32.60,0:11:34.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau pergi?
Dialogue: 0,0:11:34.15,0:11:35.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma berjalan-jalan.
Dialogue: 0,0:11:35.27,0:11:36.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat dingin begini?
Dialogue: 0,0:11:36.44,0:11:39.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau merasakan musim dingin.
Dialogue: 0,0:11:39.99,0:11:41.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau ikut?
Dialogue: 0,0:11:44.99,0:11:46.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita mau ke mana?
Dialogue: 0,0:11:46.37,0:11:47.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ke mana-mana.
Dialogue: 0,0:11:49.20,0:11:50.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mengingat waktu itu,{\i0}
Dialogue: 0,0:11:51.21,0:11:53.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}sebaiknya aku tak memberitahunya\Naku bertemu Yumeka.{\i0}
Dialogue: 0,0:11:56.34,0:11:57.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada bau kari.
Dialogue: 0,0:11:58.17,0:11:59.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kari?
Dialogue: 0,0:11:59.26,0:12:00.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:12:00.67,0:12:03.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti bau sebelum\Nmenambahkan roux ke sayuran.
Dialogue: 0,0:12:03.76,0:12:04.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Spesifik sekali.
Dialogue: 0,0:12:06.05,0:12:07.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang bau sampo.
Dialogue: 0,0:12:09.56,0:12:10.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pulang.
Dialogue: 0,0:12:11.73,0:12:13.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya aneh sekali.
Dialogue: 0,0:12:13.52,0:12:14.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:12:14.44,0:12:17.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dari dek observasi,{\i0}
Dialogue: 0,0:12:17.90,0:12:20.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}mereka cuma titik-titik cahaya kecil.{\i0}
Dialogue: 0,0:12:21.44,0:12:24.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi saat dilihat dari bawah sini,
Dialogue: 0,0:12:24.95,0:12:27.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}rasanya menenangkan.
Dialogue: 0,0:12:28.58,0:12:29.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu,
Dialogue: 0,0:12:30.66,0:12:32.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}maaf soal tempo hari.
Dialogue: 0,0:12:32.50,0:12:36.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenalanku… pasti membuatmu\Nmerasa tidak nyaman.
Dialogue: 0,0:12:36.46,0:12:38.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak. Tak apa-apa.
Dialogue: 0,0:12:39.59,0:12:41.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah kalau begitu.
Dialogue: 0,0:12:43.97,0:12:48.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bermain basket bersamamu\Nsejak kalian kecil, 'kan?
Dialogue: 0,0:12:50.31,0:12:52.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, sejak kelas dua.
Dialogue: 0,0:12:53.27,0:12:56.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak dulu dia seperti badai.
Dialogue: 0,0:12:57.52,0:13:01.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Saat aku masih mengira cara bermainnya\Ncuma asal melempar bolanya,{\i0}
Dialogue: 0,0:13:01.23,0:13:03.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}basket profesional mengejutkanku.{\i0}
Dialogue: 0,0:13:04.78,0:13:07.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu, aku juga mau coba itu!
Dialogue: 0,0:13:08.91,0:13:11.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beri salam dengan baik dan lantang.
Dialogue: 0,0:13:13.66,0:13:14.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo…
Dialogue: 0,0:13:15.58,0:13:17.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}- Melihat anak seusiaku…{\i0}\N- Ayo, Yumeka!
Dialogue: 0,0:13:17.96,0:13:20.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}…membawa bola dengan bebas,{\i0}
Dialogue: 0,0:13:20.46,0:13:23.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}berlari di lapangan, dan memasukkannya.{\i0}
Dialogue: 0,0:13:25.72,0:13:29.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Melihatnya melakukan semua itu\Nmembuatku mengaguminya.{\i0}
Dialogue: 0,0:13:34.98,0:13:37.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Kau anak baru?
Dialogue: 0,0:13:41.36,0:13:42.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei,
Dialogue: 0,0:13:43.15,0:13:45.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau mirip pion dari gim papan.
Dialogue: 0,0:13:46.32,0:13:48.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gim papan?
Dialogue: 0,0:13:49.49,0:13:52.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yumeka! Kau tak bisa beri salam\Ndengan normal?
Dialogue: 0,0:13:52.95,0:13:54.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bermain itu semalam.
Dialogue: 0,0:13:58.00,0:13:58.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Pion?
Dialogue: 0,0:14:00.75,0:14:02.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, begitu, Chinatsu.
Dialogue: 0,0:14:02.50,0:14:03.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:14:03.75,0:14:05.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lemaskan pergelangan tanganmu.
Dialogue: 0,0:14:14.22,0:14:15.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yumeka hebat, ya?
Dialogue: 0,0:14:16.81,0:14:18.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia berbakat.
Dialogue: 0,0:14:19.23,0:14:21.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia memahami lapangan meski masih muda,
Dialogue: 0,0:14:21.23,0:14:24.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan kemampuan membawa bolanya\Nlebih baik dari yang lain.
Dialogue: 0,0:14:25.03,0:14:28.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau harus berusaha keras\Nagar bisa mengejarnya.
Dialogue: 0,0:14:29.91,0:14:30.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Istirahat!
Dialogue: 0,0:14:32.66,0:14:34.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berikutnya, latihan mengoper.
Dialogue: 0,0:14:35.79,0:14:39.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya kami boleh mengoper!
Dialogue: 0,0:14:39.04,0:14:40.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bagus.
Dialogue: 0,0:14:48.05,0:14:50.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pelatih menyebutnya bakat,{\i0}
Dialogue: 0,0:14:51.72,0:14:53.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}tapi menurutku dibanding yang lain,{\i0}
Dialogue: 0,0:14:53.97,0:14:56.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}pasti Yumeka\Nyang paling lama bermain bola.{\i0}
Dialogue: 0,0:15:16.24,0:15:19.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak baru itu tidak berkembang.
Dialogue: 0,0:15:19.50,0:15:21.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudmu yang dari SD Kita?
Dialogue: 0,0:15:21.58,0:15:24.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, namanya Kano, kalau tak salah.
Dialogue: 0,0:15:24.34,0:15:26.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bahkan tak bisa memasukkan bola.
Dialogue: 0,0:15:26.25,0:15:28.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah bisa sejak awal.
Dialogue: 0,0:15:28.84,0:15:30.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, operannya selalu memeleset.
Dialogue: 0,0:15:30.80,0:15:32.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak mau berpasangan dengannya.
Dialogue: 0,0:15:33.26,0:15:35.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berlatih dengannya merepotkan!
Dialogue: 0,0:15:36.51,0:15:38.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pergi dulu!
Dialogue: 0,0:15:38.02,0:15:39.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:15:40.64,0:15:44.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yumeka tak pernah ikut\Nobrolan seperti ini.
Dialogue: 0,0:15:45.86,0:15:48.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pasti menganggap kita tak jauh berbeda
Dialogue: 0,0:15:48.48,0:15:49.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dari anak baru itu.
Dialogue: 0,0:15:50.90,0:15:52.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Karena dia genius.{\i0}
Dialogue: 0,0:16:05.13,0:16:06.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo.
Dialogue: 0,0:16:07.13,0:16:07.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei.
Dialogue: 0,0:16:11.76,0:16:12.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu!
Dialogue: 0,0:16:19.14,0:16:20.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buruk sekali.
Dialogue: 0,0:16:23.31,0:16:24.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti itu!
Dialogue: 0,0:16:27.15,0:16:28.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana caranya?
Dialogue: 0,0:16:29.65,0:16:31.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti ini! Lempar!
Dialogue: 0,0:16:32.57,0:16:33.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi!
Dialogue: 0,0:16:35.28,0:16:37.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa aku harus mengajarimu?
Dialogue: 0,0:16:37.70,0:16:38.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini?
Dialogue: 0,0:16:40.24,0:16:41.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau tak dengar?
Dialogue: 0,0:16:43.75,0:16:44.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu!
Dialogue: 0,0:16:44.83,0:16:48.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lemparan Yumeka sangat keren!
Dialogue: 0,0:16:51.42,0:16:53.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chinatsu, kami mengandalkanmu.
Dialogue: 0,0:16:53.88,0:16:56.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seragam! Ini seragamku!
Dialogue: 0,0:16:56.64,0:16:58.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yumeka, lihat!
Dialogue: 0,0:16:58.05,0:16:59.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku lihat.
Dialogue: 0,0:17:08.52,0:17:10.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyebalkan!
Dialogue: 0,0:17:10.02,0:17:13.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa malah dia yang masuk ke dalam tim?
Dialogue: 0,0:17:13.19,0:17:16.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah bermain basket lebih lama!
Dialogue: 0,0:17:16.95,0:17:19.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia cuma dapat seragam itu\Nkarena dikasihani!
Dialogue: 0,0:17:19.83,0:17:21.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenanglah, Yuna.
Dialogue: 0,0:17:23.54,0:17:25.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daripada mengeluh, lebih baik berlatih.
Dialogue: 0,0:17:26.46,0:17:27.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yumeka.
Dialogue: 0,0:17:27.58,0:17:29.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu yang Chinatsu lakukan.
Dialogue: 0,0:17:30.34,0:17:31.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hasil kerja kerasnya
Dialogue: 0,0:17:32.50,0:17:34.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah seragam itu.
Dialogue: 0,0:17:34.97,0:17:36.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku terlahir berbakat,
Dialogue: 0,0:17:36.47,0:17:39.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi aku tak paham rasanya\Nmengagumi bakat seseorang,
Dialogue: 0,0:17:39.47,0:17:44.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kemampuannya untuk berusaha keras\Nmembuatku kagum.
Dialogue: 0,0:17:49.06,0:17:50.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia seperti badai.{\i0}
Dialogue: 0,0:17:51.73,0:17:54.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia tak membiarkan apa pun menghalanginya{\i0}
Dialogue: 0,0:17:54.23,0:17:57.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dan kehadirannya menarik perhatian orang.{\i0}
Dialogue: 0,0:17:58.11,0:17:59.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau dapat rekomendasi ke Eimei?
Dialogue: 0,0:18:00.66,0:18:01.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau ikut?
Dialogue: 0,0:18:03.58,0:18:07.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia membuatku merasa semuanya\Nbaik-baik saja asal aku mengikutinya.{\i0}
Dialogue: 0,0:18:08.21,0:18:09.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengaguminya.
Dialogue: 0,0:18:10.79,0:18:14.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berlatih dengan keras\Nkarena mau jadi seperti dia.
Dialogue: 0,0:18:18.26,0:18:20.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan sekarang, terkadang aku berpikir,
Dialogue: 0,0:18:21.64,0:18:24.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}andai Yumeka ada di tim ini.{\i0}
Dialogue: 0,0:18:26.43,0:18:29.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tak peduli\Ndalam olahraga individual atau tim.{\i0}
Dialogue: 0,0:18:30.60,0:18:31.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Semuanya punya sesuatu.{\i0}
Dialogue: 0,0:18:32.61,0:18:34.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Semuanya punya perjuangan sendiri.{\i0}
Dialogue: 0,0:18:37.40,0:18:38.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau benar-benar berhenti?
Dialogue: 0,0:18:38.70,0:18:39.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:18:40.16,0:18:41.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa kata orang tuamu?{\i0}
Dialogue: 0,0:18:41.57,0:18:43.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ini bukan urusan mereka.{\i0}
Dialogue: 0,0:18:43.12,0:18:44.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Anak itu bagaimana?{\i0}
Dialogue: 0,0:18:44.49,0:18:47.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Anak dari Kelas B. Kalau tak salah, Kano?{\i0}
Dialogue: 0,0:18:47.04,0:18:49.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kalian sudah lama bermain bersama, 'kan?{\i0}
Dialogue: 0,0:18:49.12,0:18:50.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa yang peduli?
Dialogue: 0,0:18:50.87,0:18:53.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia selalu mengikutiku ke mana-mana.
Dialogue: 0,0:18:56.84,0:18:57.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benci.
Dialogue: 0,0:19:03.64,0:19:04.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rebound!
Dialogue: 0,0:19:04.89,0:19:06.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus!
Dialogue: 0,0:19:06.89,0:19:08.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Istirahat sepuluh menit.
Dialogue: 0,0:19:10.39,0:19:12.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku harus lebih baik.{\i0}
Dialogue: 0,0:19:12.65,0:19:13.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Lebih baik lagi.{\i0}
Dialogue: 0,0:19:16.23,0:19:17.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlalu lambat!
Dialogue: 0,0:19:18.90,0:19:20.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pukul ke mana? Kanan!
Dialogue: 0,0:19:20.78,0:19:21.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kiri!
Dialogue: 0,0:19:21.91,0:19:23.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus!
Dialogue: 0,0:19:40.47,0:19:42.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak mungkin ini bisa dimakan!
Dialogue: 0,0:19:51.06,0:19:54.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juara pertama saat olahraga!
Dialogue: 0,0:19:56.57,0:19:57.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sudah kuduga,{\i0}
Dialogue: 0,0:19:58.11,0:20:01.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}aku tak bisa membayangkan{\i0}
Dialogue: 0,0:20:01.03,0:20:02.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Yumeka membenci Kak Chinatsu.{\i0}
Dialogue: 0,0:20:03.82,0:20:05.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mungkin dia cedera{\i0}
Dialogue: 0,0:20:05.24,0:20:07.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dan tak bisa bermain basket lagi.{\i0}
Dialogue: 0,0:20:08.24,0:20:11.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jadi, dia bersikap begitu\Ndemi menyembunyikannya.{\i0}
Dialogue: 0,0:20:15.50,0:20:16.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial!
Dialogue: 0,0:20:16.42,0:20:17.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mudah sekali.
Dialogue: 0,0:20:18.13,0:20:20.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia masih bisa bermain basket!
Dialogue: 0,0:20:22.22,0:20:23.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini cukup di sini.
Dialogue: 0,0:20:23.51,0:20:24.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:20:24.93,0:20:26.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo bermain lagi!
Dialogue: 0,0:20:28.47,0:20:30.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau masih bermain?
Dialogue: 0,0:20:30.18,0:20:31.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma main-main.
Dialogue: 0,0:20:34.44,0:20:37.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah sayang jika cuma main-main?
Dialogue: 0,0:20:37.94,0:20:41.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kata semua orang, kau genius.
Dialogue: 0,0:20:42.95,0:20:45.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitukah pendapat orang tentangku?
Dialogue: 0,0:20:45.78,0:20:48.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memang belajar lebih cepat\Ndaripada kebanyakan orang.
Dialogue: 0,0:20:48.74,0:20:49.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia sinis?{\i0}
Dialogue: 0,0:20:49.87,0:20:52.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga bisa mengendalikan bola\Ndengan bebas.
Dialogue: 0,0:20:52.29,0:20:53.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia jelas sinis!{\i0}
Dialogue: 0,0:20:54.00,0:20:54.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi…
Dialogue: 0,0:20:55.92,0:20:59.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}ada banyak orang di dunia\Nyang jauh lebih hebat dariku.{\i0}
Dialogue: 0,0:21:01.76,0:21:03.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin itu benar, tapi…
Dialogue: 0,0:21:04.59,0:21:06.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pernah memikirkannya?
Dialogue: 0,0:21:06.47,0:21:09.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hidupmu akan bagaimana\Njika kau cuma fokus pada olahraga?
Dialogue: 0,0:21:10.22,0:21:14.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa gunanya\Nberlatih sangat keras setiap hari?{\i0}
Dialogue: 0,0:21:14.73,0:21:17.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Padahal tak akan jadi profesional.{\i0}
Dialogue: 0,0:21:17.06,0:21:20.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Cuma pemenang\Nyang pulang sambil tersenyum.{\i0}
Dialogue: 0,0:21:20.11,0:21:21.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jadi, apa gunanya{\i0}
Dialogue: 0,0:21:22.94,0:21:24.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}mencurahkan segalanya?{\i0}
Dialogue: 0,0:21:25.74,0:21:27.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau membuat alasan apa?
Dialogue: 0,0:21:27.74,0:21:28.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:21:28.95,0:21:32.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua itu sudah jelas sejak awal.
Dialogue: 0,0:21:32.87,0:21:34.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kita tetap mengejar kemenangan.
Dialogue: 0,0:21:35.71,0:21:38.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita terus mengejar tembakannya\Nkarena menyenangkan.
Dialogue: 0,0:21:39.50,0:21:40.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sekarang aku paham.{\i0}
Dialogue: 0,0:21:40.88,0:21:43.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jawabannya sangat sederhana.{\i0}
Dialogue: 0,0:21:43.63,0:21:45.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak peduli orang lain bagaimana
Dialogue: 0,0:21:45.22,0:21:47.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau seburuk apa permainanmu.
Dialogue: 0,0:21:47.72,0:21:50.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru itu alasan kau tak boleh berhenti.
Dialogue: 0,0:21:50.26,0:21:53.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bakatnya membuatnya takut gagal,\Nmaka itu dia kabur.{\i0}
Dialogue: 0,0:21:54.64,0:21:56.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sayang sekali.{\i0}
Dialogue: 0,0:21:56.10,0:21:57.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sangat disayangkan.{\i0}
Dialogue: 0,0:21:57.94,0:22:00.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bisa menebusnya saat SMA.
Dialogue: 0,0:22:00.94,0:22:03.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Wajar ada orang yang lebih baik dari kita.
Dialogue: 0,0:22:03.78,0:22:05.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Tapi bukan itu.
Dialogue: 0,0:22:05.90,0:22:07.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan itu intinya.
Dialogue: 0,0:22:10.03,0:22:11.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa?{\i0}
Dialogue: 0,0:22:11.70,0:22:12.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja…
Dialogue: 0,0:22:13.66,0:22:17.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mudah mengatakan hal yang benar\Nkarena bukan kau yang mengalaminya.
Dialogue: 0,0:23:48.92,0:23:53.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Terjemahan subtitle oleh Sudirman Lius
