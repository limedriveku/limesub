Dialogue: 0,0:00:27.02,0:00:30.32,sign,,0000,0000,0000,,{\an8}SMA SWASTA EIMEI
Dialogue: 0,0:00:53.17,0:00:55.09,sign,,0000,0000,0000,,DEKORASI
Dialogue: 0,0:05:57.48,0:06:01.65,sign,,0000,0000,0000,,BLUE BOX MUSIM 2
Dialogue: 0,0:07:24.56,0:07:28.65,sign,,0000,0000,0000,,EPISODE 31\NMALAM NATAL
Dialogue: 0,0:13:28.84,0:13:30.80,sign,,0000,0000,0000,,AYAM
Dialogue: 0,0:14:08.34,0:14:09.26,sign,,0000,0000,0000,,{\an8}JUARA
Dialogue: 0,0:00:15.39,0:00:17.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Nagisa.
Dialogue: 0,0:00:17.64,0:00:19.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baru ingat ada urusan.
Dialogue: 0,0:00:19.89,0:00:22.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:01:26.71,0:01:28.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jantungku hampir copot!
Dialogue: 0,0:01:28.71,0:01:30.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan mengejutkanku begitu!
Dialogue: 0,0:01:30.59,0:01:34.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Maaf.\N- Kukira kau hantu.
Dialogue: 0,0:01:34.17,0:01:36.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan Sinterklas?
Dialogue: 0,0:01:36.63,0:01:37.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:01:47.10,0:01:50.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, sedang apa kau di sini?
Dialogue: 0,0:01:50.19,0:01:51.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana pertandingannya?
Dialogue: 0,0:01:53.61,0:01:55.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami lolos ronde pertama.
Dialogue: 0,0:01:56.86,0:01:58.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat.
Dialogue: 0,0:01:59.07,0:02:00.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:02:00.91,0:02:03.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih juga atas tiketnya.
Dialogue: 0,0:02:05.95,0:02:09.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkatmu aku bisa berbaikan dengan Yumeka.
Dialogue: 0,0:02:13.92,0:02:17.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar kau berlari tanpa henti\Ndemi mendapat tiket itu.
Dialogue: 0,0:02:18.30,0:02:19.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:02:19.38,0:02:21.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bukan apa-apa!
Dialogue: 0,0:02:21.89,0:02:23.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma berlari santai.
Dialogue: 0,0:02:26.47,0:02:29.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya aku sudah lama tahu.
Dialogue: 0,0:02:30.77,0:02:33.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bahwa Yumeka memiliki masalah sendiri.{\i0}
Dialogue: 0,0:02:34.94,0:02:40.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku diam saja\Nkarena dia tak pernah membicarakannya.
Dialogue: 0,0:02:56.50,0:02:58.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat menyesalinya.
Dialogue: 0,0:02:59.05,0:03:04.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi hari ini, aku bisa menebus\Nsebagian penyesalanku.
Dialogue: 0,0:03:05.26,0:03:09.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, Taiki, aku benar-benar...
Dialogue: 0,0:03:14.11,0:03:16.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berterima kasih kepadamu.
Dialogue: 0,0:03:20.45,0:03:23.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tak perlu berterima kasih.
Dialogue: 0,0:03:29.87,0:03:34.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama seperti Yumeka memotivasimu,
Dialogue: 0,0:03:35.42,0:03:38.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau juga memotivasiku.
Dialogue: 0,0:03:40.38,0:03:42.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma membalas budi!
Dialogue: 0,0:04:36.02,0:04:37.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:05:07.51,0:05:08.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:05:14.77,0:05:15.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebentar saja...
Dialogue: 0,0:05:17.35,0:05:18.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}biarkan aku memelukmu.
Dialogue: 0,0:08:23.46,0:08:24.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:08:29.17,0:08:30.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama-sama.
Dialogue: 0,0:08:44.35,0:08:45.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei...
Dialogue: 0,0:08:46.31,0:08:47.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Chinatsu...
Dialogue: 0,0:08:53.40,0:08:54.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya kita pergi.
Dialogue: 0,0:08:56.91,0:08:57.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:09:03.33,0:09:04.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chinatsu?
Dialogue: 0,0:09:13.05,0:09:15.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa-apaan itu tadi?{\i0}
Dialogue: 0,0:09:17.51,0:09:19.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia... Dia memelukku!{\i0}
Dialogue: 0,0:09:21.47,0:09:24.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kehangatannya masih terasa di bahuku.{\i0}
Dialogue: 0,0:09:30.48,0:09:32.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mungkin dia gugup soal pertandingan besok{\i0}
Dialogue: 0,0:09:32.73,0:09:34.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dan ingin dukungan?{\i0}
Dialogue: 0,0:09:35.99,0:09:39.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Atau dia terbawa perasaan{\i0}
Dialogue: 0,0:09:39.99,0:09:41.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}setelah berbaikan dengan Yumeka?{\i0}
Dialogue: 0,0:09:43.12,0:09:44.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Atau mungkin...{\i0}
Dialogue: 0,0:09:47.04,0:09:48.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yo, Taiki!
Dialogue: 0,0:09:48.37,0:09:50.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemarilah!
Dialogue: 0,0:09:56.97,0:09:58.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jangan-jangan...{\i0}
Dialogue: 0,0:10:35.67,0:10:37.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu! Kak Chinatsu mana?
Dialogue: 0,0:10:38.38,0:10:40.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sudah pergi dari tadi.
Dialogue: 0,0:10:40.89,0:10:43.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertandingan keduanya mulai pukul 13.00.
Dialogue: 0,0:10:43.85,0:10:45.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:10:45.18,0:10:47.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah kau juga ada\Nlatihan badminton sore ini?
Dialogue: 0,0:10:47.68,0:10:49.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepatlah bersiap.
Dialogue: 0,0:10:49.60,0:10:50.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:11:04.20,0:11:07.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kenapa kau melamun?\N- Tak apa-apa!
Dialogue: 0,0:11:08.58,0:11:10.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus mampir ke ruang klub!
Dialogue: 0,0:11:18.13,0:11:21.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku terus memikirkan kemarin.{\i0}
Dialogue: 0,0:11:25.35,0:11:29.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku mau menanyakannya tentang Yumeka.{\i0}
Dialogue: 0,0:11:30.68,0:11:34.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Setelah mereka berbaikan,\Napa dia akan mulai bermain basket lagi?{\i0}
Dialogue: 0,0:11:35.48,0:11:39.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kalau begitu, Kak Chinatsu pasti senang.{\i0}
Dialogue: 0,0:11:40.99,0:11:42.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia sangat senang sampai...{\i0}
Dialogue: 0,0:11:45.12,0:11:48.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku terus memikirkannya!{\i0}
Dialogue: 0,0:11:49.12,0:11:51.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ada yang sakit selain gigimu?
Dialogue: 0,0:12:02.97,0:12:05.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yumeka, rambutmu...
Dialogue: 0,0:12:07.39,0:12:10.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rambut pendek\Ndi musim seperti ini agak dingin.
Dialogue: 0,0:12:12.27,0:12:14.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi jika tidak, mengganggu main basket.
Dialogue: 0,0:12:18.27,0:12:19.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak mahir lagi,
Dialogue: 0,0:12:20.07,0:12:23.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku berniat bergabung\Ndengan tim basket sekolahku.
Dialogue: 0,0:12:24.28,0:12:25.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitukah?
Dialogue: 0,0:12:25.82,0:12:30.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus berlatih sangat keras\Njika mau mengejar Natsu.
Dialogue: 0,0:12:32.91,0:12:36.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apakah aku telah membangkitkan\Nmusuh yang sangat kuat?{\i0}
Dialogue: 0,0:12:36.83,0:12:41.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, agar Natsu\Ntak membuang waktunya sepertiku,
Dialogue: 0,0:12:41.05,0:12:42.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau harus terus mendukungnya.
Dialogue: 0,0:12:43.63,0:12:45.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kau pacarnya.
Dialogue: 0,0:12:49.85,0:12:52.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kami tidak berpacaran!\N- Apa?
Dialogue: 0,0:12:53.06,0:12:55.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau salah paham!
Dialogue: 0,0:12:56.48,0:12:58.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau juga punya pacar?
Dialogue: 0,0:12:59.61,0:13:01.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Benar juga, aku tak menyangkalnya.{\i0}
Dialogue: 0,0:13:02.65,0:13:04.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:13:05.07,0:13:08.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kau bahkan bukan pacar Natsu,
Dialogue: 0,0:13:08.20,0:13:12.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi repot-repot setengah mati\Ndemi mendapatkan tiket itu?
Dialogue: 0,0:13:12.66,0:13:14.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:13:15.16,0:13:17.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau suka Natsu, 'kan?
Dialogue: 0,0:13:18.92,0:13:19.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku...
Dialogue: 0,0:13:20.84,0:13:23.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan, dia menolakmu?
Dialogue: 0,0:13:23.01,0:13:26.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belum menyatakan perasaanku.
Dialogue: 0,0:13:26.72,0:13:28.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar burger ayam penakut.
Dialogue: 0,0:13:30.80,0:13:32.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa burger?
Dialogue: 0,0:13:32.89,0:13:36.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kurasa Natsu memang sulit ditebak.
Dialogue: 0,0:13:37.06,0:13:39.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga tak merasa\Ndia tertarik berpacaran.
Dialogue: 0,0:13:40.36,0:13:41.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu masalahnya.
Dialogue: 0,0:13:43.44,0:13:45.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan membuat alasan.
Dialogue: 0,0:13:53.66,0:13:56.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Cinta itu perasaan yang terkuat, tahu?{\i0}
Dialogue: 0,0:13:59.08,0:14:01.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Esok harinya, Kak Chinatsu\Ndan tim basketnya{\i0}
Dialogue: 0,0:14:02.46,0:14:05.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}kalah di ronde ketiga.{\i0}
Dialogue: 0,0:14:05.26,0:14:08.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Lawan mereka\Nkemudian memenangkan turnamen.{\i0}
Dialogue: 0,0:14:09.26,0:14:11.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tetap saja, setelah kalah,{\i0}
Dialogue: 0,0:14:12.30,0:14:16.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}turnamen itu membuat mereka merasa\Ntelah melangkah lebih jauh lagi.{\i0}
Dialogue: 0,0:14:17.77,0:14:21.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Di tengah semua itu,\Naku masih belum sempat menanyakannya...{\i0}
Dialogue: 0,0:14:22.77,0:14:25.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}arti pelukan itu.{\i0}
Dialogue: 0,0:14:40.83,0:14:44.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang tuamu tiba di Jepang\Npukul 20.00, 'kan?
Dialogue: 0,0:14:44.63,0:14:48.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar. Jadi, aku berniat pergi pukul 18.00\Nuntuk menemui mereka.
Dialogue: 0,0:14:48.13,0:14:51.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu kalian\Nakan mengunjungi kakekmu di Nagano
Dialogue: 0,0:14:52.05,0:14:53.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan di sana sampai Tahun Baru?
Dialogue: 0,0:14:54.60,0:14:56.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami pasti merindukanmu!
Dialogue: 0,0:14:57.52,0:14:58.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat pagi.
Dialogue: 0,0:14:58.77,0:15:03.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rambutmu berantakan sekali. Rapikan dulu!
Dialogue: 0,0:15:12.36,0:15:13.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuci rambut dulu!
Dialogue: 0,0:15:14.53,0:15:16.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti botak kalau terlalu sering.
Dialogue: 0,0:15:24.34,0:15:26.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku harus bagaimana di dekatnya?{\i0}
Dialogue: 0,0:15:27.17,0:15:30.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku tak bisa bicara dengannya di rumah\Nkarena ada Ibu.{\i0}
Dialogue: 0,0:15:36.26,0:15:37.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jika begini...{\i0}
Dialogue: 0,0:15:42.94,0:15:44.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktunya bersih-bersih akhir tahun.
Dialogue: 0,0:15:45.27,0:15:47.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersihkan sampai mengilap!
Dialogue: 0,0:15:47.65,0:15:49.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Baik!\N- Baik!
Dialogue: 0,0:15:51.40,0:15:55.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taiki, area itu sudah selesai,\Nbisa bantu di tempat lain?
Dialogue: 0,0:15:56.03,0:15:56.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah!
Dialogue: 0,0:16:04.54,0:16:07.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Saat aku menatapnya,\Ndia bertingkah seolah tak terjadi apa-apa.{\i0}
Dialogue: 0,0:16:08.80,0:16:10.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apakah waktu itu cuma mimpi?{\i0}
Dialogue: 0,0:16:16.10,0:16:19.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa tak pajang saja sepanjang tahun?
Dialogue: 0,0:16:19.01,0:16:21.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Apa?\N- Hei, kalian!
Dialogue: 0,0:16:22.27,0:16:23.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan dilap memutar!
Dialogue: 0,0:16:24.56,0:16:27.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lap dengan gerakan naik turun yang lurus!
Dialogue: 0,0:16:27.19,0:16:29.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan lupa debu di pojok!
Dialogue: 0,0:16:29.90,0:16:32.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kemarilah, noda-noda jahat!
Dialogue: 0,0:16:32.74,0:16:35.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Ternyata manajer sangat ketat\Nsoal bersih-bersih.
Dialogue: 0,0:16:35.20,0:16:37.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Awalnya aku senang\Nkarena manajer kita manis,
Dialogue: 0,0:16:37.57,0:16:38.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}tapi lebih galak dari ibuku!
Dialogue: 0,0:16:39.58,0:16:42.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Jangan diam saja, Inota.\N- Aku...
Dialogue: 0,0:16:42.33,0:16:46.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika tugasmu sudah selesai,\Nperiksa peralatannya!
Dialogue: 0,0:16:51.84,0:16:55.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sulit dipercaya ini tempat kami\Nberpelukan saat Malam Natal.{\i0}
Dialogue: 0,0:16:56.47,0:16:58.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mungkin itu memang cuma mimpi.{\i0}
Dialogue: 0,0:17:01.93,0:17:03.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Nak.
Dialogue: 0,0:17:03.81,0:17:04.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:17:04.98,0:17:06.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih juga.
Dialogue: 0,0:17:08.11,0:17:10.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya di sini lengkap.
Dialogue: 0,0:17:10.77,0:17:12.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, sepertinya begitu.
Dialogue: 0,0:17:12.48,0:17:13.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:17:14.53,0:17:15.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Lihat?{\i0}
Dialogue: 0,0:17:16.03,0:17:18.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kak Chinatsu bersikap seperti biasa.{\i0}
Dialogue: 0,0:17:19.16,0:17:21.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Seolah kami tak pernah berpelukan.{\i0}
Dialogue: 0,0:17:21.45,0:17:23.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi, aku mau lewat.
Dialogue: 0,0:17:35.34,0:17:36.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf!
Dialogue: 0,0:17:38.05,0:17:39.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak apa-apa.
Dialogue: 0,0:17:40.76,0:17:41.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:17:44.56,0:17:47.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menyerahkan ini dulu.\NTolong urus sisanya.
Dialogue: 0,0:17:47.39,0:17:48.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:18:00.53,0:18:02.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal waktu itu...
Dialogue: 0,0:18:06.29,0:18:07.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau tidak suka?
Dialogue: 0,0:18:14.34,0:18:18.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bukan begitu...{\i0}
Dialogue: 0,0:18:20.26,0:18:22.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}- Aku...{\i0}\N- Hei!
Dialogue: 0,0:18:22.85,0:18:25.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita dapat jus!
Dialogue: 0,0:18:34.07,0:18:35.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tak mungkin aku tidak suka!{\i0}
Dialogue: 0,0:18:37.28,0:18:38.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bukan begitu.{\i0}
Dialogue: 0,0:18:40.36,0:18:41.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bukan begitu!{\i0}
Dialogue: 0,0:18:51.00,0:18:53.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chono, bisa bantu aku bawa ini?
Dialogue: 0,0:18:54.55,0:18:55.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:18:55.80,0:18:57.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke ruang guru.
Dialogue: 0,0:18:58.26,0:19:00.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini lumayan berat.
Dialogue: 0,0:19:01.64,0:19:04.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh saja. Aku tak tahu kau selemah ini.
Dialogue: 0,0:19:04.43,0:19:07.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tapi kau rutin berolahraga.\N- Memangnya kau tidak?
Dialogue: 0,0:19:20.15,0:19:23.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senang sekali setelah tempatnya bersih!
Dialogue: 0,0:19:23.16,0:19:25.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kalian mau makan?\N- Aku pulang dulu!
Dialogue: 0,0:19:25.08,0:19:26.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei!
Dialogue: 0,0:19:30.62,0:19:32.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku harus memberitahunya!{\i0}
Dialogue: 0,0:19:35.21,0:19:36.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bahwa aku bukan tidak suka.{\i0}
Dialogue: 0,0:19:38.30,0:19:39.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku justru senang.{\i0}
Dialogue: 0,0:19:40.42,0:19:44.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Habisnya, itu kali pertama\Naku dipeluk orang yang kusukai!{\i0}
Dialogue: 0,0:20:22.76,0:20:25.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:20:50.66,0:20:54.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku tak bisa\Nberhenti memikirkannya sejak itu.{\i0}
Dialogue: 0,0:21:01.34,0:21:02.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tapi...{\i0}
Dialogue: 0,0:21:07.14,0:21:08.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tapi...{\i0}
Dialogue: 0,0:21:12.64,0:21:15.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku harus mengucapkannya kepadanya!{\i0}
Dialogue: 0,0:21:25.32,0:21:26.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pulang!
Dialogue: 0,0:21:27.07,0:21:29.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga. Kenapa buru-buru?
Dialogue: 0,0:21:29.91,0:21:32.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kak Chinatsu mana?\N- Dia sudah pergi.
Dialogue: 0,0:21:35.41,0:21:37.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pesawat orang tuanya tiba lebih cepat.
Dialogue: 0,0:21:38.29,0:21:40.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah baru mengantarnya ke bandara.
Dialogue: 0,0:21:43.55,0:21:46.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:21:52.06,0:21:54.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kenapa dia tidak di sini?{\i0}
Dialogue: 0,0:23:48.92,0:23:53.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Terjemahan subtitle oleh Sudirman Lius
