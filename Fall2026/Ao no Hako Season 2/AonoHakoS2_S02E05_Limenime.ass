Dialogue: 0,0:00:13.01,0:00:16.43,sign,,0000,0000,0000,,{\an8}KEJUARAAN MUSIM DINGIN SOFTBANK
Dialogue: 0,0:00:41.29,0:00:42.70,sign,,0000,0000,0000,,TIKET REKAN RESMI
Dialogue: 0,0:03:29.45,0:03:33.63,sign,,0000,0000,0000,,BLUE BOX MUSIM 2
Dialogue: 0,0:04:56.62,0:04:59.29,sign,,0000,0000,0000,,EPISODE 30\NMENEMUKANNYA KEMBALI
Dialogue: 0,0:04:59.29,0:05:00.96,sign,,0000,0000,0000,,SMA SWASTA EIMEI
Dialogue: 0,0:09:07.17,0:09:08.67,sign,,0000,0000,0000,,EIMEI 59 - KIRIGASAKI 55
Dialogue: 0,0:11:16.09,0:11:20.09,sign,,0000,0000,0000,,{\an8}KEJUARAAN MUSIM DINGIN SOFTBANK
Dialogue: 0,0:11:20.09,0:11:22.51,sign,,0000,0000,0000,,SMA SWASTA EIMEI\NAKADEMI KIRIGASAKI
Dialogue: 0,0:17:15.74,0:17:16.66,sign,,0000,0000,0000,,TAK SETINGGI LUTUT...
Dialogue: 0,0:18:41.91,0:18:44.08,sign,,0000,0000,0000,,KUIL OYASU
Dialogue: 0,0:18:53.67,0:18:55.46,sign,,0000,0000,0000,,ELEVEN SEVEN\NATM - MIRAS - ROKOK
Dialogue: 0,0:19:23.82,0:19:26.91,sign,,0000,0000,0000,,SMA SWASTA EIMEI
Dialogue: 0,0:19:58.53,0:20:01.53,sign,,0000,0000,0000,,SELAMAT NATAL
Dialogue: 0,0:00:27.98,0:00:29.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf sudah mengganggu.
Dialogue: 0,0:00:33.36,0:00:36.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Andai aku tetap di sisi Natsu waktu itu,{\i0}
Dialogue: 0,0:00:36.28,0:00:40.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}apakah aku bisa menyukai basket lagi?{\i0}
Dialogue: 0,0:00:45.50,0:00:46.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:00:46.46,0:00:50.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini tiket pertandingan\NKejuaraan Musim Dingin Kak Chinatsu.
Dialogue: 0,0:00:52.01,0:00:53.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untukmu.
Dialogue: 0,0:00:59.14,0:01:00.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak boleh aku yang datang.
Dialogue: 0,0:01:01.39,0:01:03.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika soal basket, harus kau orangnya.
Dialogue: 0,0:01:07.06,0:01:10.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pasti akan sadar\Nbahwa kau masih menyukai basket.
Dialogue: 0,0:01:50.65,0:01:52.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eimei!
Dialogue: 0,0:02:04.58,0:02:05.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia hebat.{\i0}
Dialogue: 0,0:02:06.66,0:02:09.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia melihat Natsu\Nlangsung menembus ke ring.{\i0}
Dialogue: 0,0:02:21.14,0:02:25.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pertahanan mereka ketat,\Njadi mereka bisa bermain agresif.{\i0}
Dialogue: 0,0:02:25.35,0:02:28.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eimei!
Dialogue: 0,0:02:39.28,0:02:43.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apakah waktu memang berjalan secepat ini?{\i0}
Dialogue: 0,0:02:44.66,0:02:49.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku ingat tiap detik terasa lebih lama\Nsaat bertanding.{\i0}
Dialogue: 0,0:02:49.75,0:02:52.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kemudian rasanya\Nseperti hanya sekilas saat selesai.{\i0}
Dialogue: 0,0:03:18.19,0:03:19.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sudah dua tahun.{\i0}
Dialogue: 0,0:03:22.11,0:03:25.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Baru dua tahun...{\i0}
Dialogue: 0,0:05:08.01,0:05:11.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Semoga Yumeka pergi menontonnya.{\i0}
Dialogue: 0,0:05:17.69,0:05:21.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apakah aku\Nperlu memberi tahu Kak Chinatsu?{\i0}
Dialogue: 0,0:05:21.65,0:05:24.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tapi jika ternyata dia tidak datang...{\i0}
Dialogue: 0,0:05:36.58,0:05:38.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Rusa kutub dalam masalah?{\i0}
Dialogue: 0,0:05:39.83,0:05:43.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau perlu bantuan?
Dialogue: 0,0:05:54.81,0:05:56.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kostum itu untuk apa?
Dialogue: 0,0:05:57.10,0:06:00.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami mau menampilkan tema Natal.
Dialogue: 0,0:06:00.06,0:06:03.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, seluruh tim senam irama\Nmemakai kostum.
Dialogue: 0,0:06:03.27,0:06:05.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah sulit bergerak memakai itu?
Dialogue: 0,0:06:05.19,0:06:06.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini nyaman dan hangat.
Dialogue: 0,0:06:07.61,0:06:10.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu memang menunjukkan tema Natal.
Dialogue: 0,0:06:11.12,0:06:14.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menikmati acara seperti ini penting.
Dialogue: 0,0:06:15.12,0:06:18.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kami akan menyanyikan lagu Natal\Nsaat karaoke,{\i0}
Dialogue: 0,0:06:18.66,0:06:22.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}sebelum itu,\Nkami akan berfoto bersama di bilik foto.{\i0}
Dialogue: 0,0:06:22.13,0:06:26.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku juga akan makan kue\Nsepuasnya hari ini.{\i0}
Dialogue: 0,0:06:27.84,0:06:30.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami tak perlu punya pacar\Nuntuk bergembira.
Dialogue: 0,0:06:33.30,0:06:35.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku tak tahu harus menjawab apa.
Dialogue: 0,0:06:38.06,0:06:40.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teruslah menyesalinya.
Dialogue: 0,0:06:42.77,0:06:44.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sini saja.
Dialogue: 0,0:06:48.61,0:06:50.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:06:50.95,0:06:51.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hina.
Dialogue: 0,0:07:03.50,0:07:06.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau harus nyanyikan lagu Mariah\Nuntuk Moriya.
Dialogue: 0,0:07:06.30,0:07:08.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja, itu sudah masuk daftarku.
Dialogue: 0,0:07:08.63,0:07:11.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menyanyi sampai suaraku habis!
Dialogue: 0,0:07:11.34,0:07:13.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan lupa beli\Npermen pelega tenggorokan!
Dialogue: 0,0:07:37.58,0:07:40.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini Malam Natal?
Dialogue: 0,0:07:41.08,0:07:43.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat orang tanya apa rencana Natal kita,
Dialogue: 0,0:07:43.08,0:07:46.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}rasanya mereka menanyakan\Napa yang penting bagi kita, 'kan?
Dialogue: 0,0:07:46.92,0:07:47.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak juga.
Dialogue: 0,0:07:48.55,0:07:53.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Biasanya orang merayakannya bersama orang\Nyang disayang seperti teman dan keluarga.
Dialogue: 0,0:07:53.47,0:07:57.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan kata lain,\Naku cuma punya tim badminton!
Dialogue: 0,0:07:57.47,0:07:59.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Badminton yang paling penting bagiku!
Dialogue: 0,0:07:59.68,0:08:01.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya itu buruk?
Dialogue: 0,0:08:01.10,0:08:03.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga mau pergi kencan!
Dialogue: 0,0:08:03.60,0:08:04.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya kau jujur.
Dialogue: 0,0:08:04.73,0:08:07.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benci orang yang punya pacar!
Dialogue: 0,0:08:07.44,0:08:09.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berpacaran juga bukan hal yang mudah.
Dialogue: 0,0:08:11.24,0:08:14.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku selalu bingung\Nmau memberikan hadiah apa,
Dialogue: 0,0:08:14.36,0:08:17.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan semua tempat\Nbutuh reservasi lebih dulu saat Natal.
Dialogue: 0,0:08:17.91,0:08:20.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru aku juga mau merasakannya!
Dialogue: 0,0:08:21.79,0:08:23.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayang sekali, Taiki.
Dialogue: 0,0:08:23.79,0:08:27.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pasti juga mau\Nmenikmati Natal bersamanya.
Dialogue: 0,0:08:29.25,0:08:33.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bukan pacarnya,\Njadi aku tak ada rencana saat Natal.
Dialogue: 0,0:08:34.63,0:08:35.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula,
Dialogue: 0,0:08:37.01,0:08:40.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}ada hal lebih penting\Nyang harus Kak Chinatsu lakukan.{\i0}
Dialogue: 0,0:08:43.89,0:08:46.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika Natal itu soal apa yang penting,
Dialogue: 0,0:08:46.35,0:08:49.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}maka melakukan hal\Nyang kita sukai juga cocok!
Dialogue: 0,0:08:52.44,0:08:53.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pokoknya,{\i0}
Dialogue: 0,0:08:54.78,0:08:57.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}aku harap Malam Natal ini\Nakan menyenangkan.{\i0}
Dialogue: 0,0:08:59.28,0:09:01.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bagi Yumeka juga.{\i0}
Dialogue: 0,0:09:08.67,0:09:09.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eimei!
Dialogue: 0,0:09:13.26,0:09:14.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyaris!
Dialogue: 0,0:09:24.27,0:09:26.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:09:26.02,0:09:27.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semangat!
Dialogue: 0,0:10:15.61,0:10:17.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Belum selesai!{\i0}
Dialogue: 0,0:10:18.03,0:10:21.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eimei!
Dialogue: 0,0:10:40.64,0:10:42.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, Natsu!
Dialogue: 0,0:11:14.17,0:11:15.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masuk!
Dialogue: 0,0:11:39.11,0:11:43.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yumeka, kenapa kau di sini?
Dialogue: 0,0:11:44.45,0:11:47.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak kelas satu tim badminton itu\Nmemberiku tiket.
Dialogue: 0,0:11:49.37,0:11:51.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat sudah memenangkan ronde pertama.
Dialogue: 0,0:11:51.75,0:11:53.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertandingannya hebat.
Dialogue: 0,0:11:57.67,0:11:59.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf soal waktu itu.
Dialogue: 0,0:11:59.00,0:12:02.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bicara seolah-olah\Nkau hanya bermalas-malasan.
Dialogue: 0,0:12:04.01,0:12:06.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata pikiranku yang terlalu sempit.
Dialogue: 0,0:12:08.56,0:12:11.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga minta maaf.
Dialogue: 0,0:12:12.27,0:12:13.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga salah
Dialogue: 0,0:12:13.98,0:12:18.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena tak mengatakan apa yang kupikirkan.
Dialogue: 0,0:12:21.15,0:12:22.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku...
Dialogue: 0,0:12:22.78,0:12:26.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mau bermain basket lebih lama bersamamu.
Dialogue: 0,0:12:28.41,0:12:31.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak mau kau berhenti bermain basket.
Dialogue: 0,0:12:35.37,0:12:38.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berharap kau bicara kepadaku\Nsebelum berhenti.
Dialogue: 0,0:12:39.30,0:12:42.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku bisa...
Dialogue: 0,0:12:43.42,0:12:46.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau menangis?
Dialogue: 0,0:12:47.09,0:12:48.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau juga menangis.
Dialogue: 0,0:12:48.30,0:12:49.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak...
Dialogue: 0,0:12:52.02,0:12:56.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga mau bermain basket\Nlebih lama bersamamu.
Dialogue: 0,0:12:56.69,0:12:59.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, kenapa kau berhenti?
Dialogue: 0,0:13:00.19,0:13:01.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:13:01.48,0:13:03.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku merindukanmu.
Dialogue: 0,0:13:04.24,0:13:06.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, maaf.
Dialogue: 0,0:13:07.20,0:13:08.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:13:08.74,0:13:10.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kalian menangis?
Dialogue: 0,0:13:11.95,0:13:13.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini salah Yumeka.
Dialogue: 0,0:13:13.54,0:13:14.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini salah Natsu.
Dialogue: 0,0:13:14.71,0:13:18.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya kalian anak kecil?
Dialogue: 0,0:13:29.30,0:13:31.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini!
Dialogue: 0,0:13:32.39,0:13:33.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paham?
Dialogue: 0,0:13:45.03,0:13:46.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Cinta adalah hal terkuat.{\i0}
Dialogue: 0,0:13:47.91,0:13:51.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kita bukan saja jadi mahir\Ndalam hal yang kita cintai.{\i0}
Dialogue: 0,0:13:51.33,0:13:56.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Memiliki sesuatu yang penting\Nbagi kita memberikan kekuatan.{\i0}
Dialogue: 0,0:13:56.71,0:13:58.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu pengakuan diri terkuat.{\i0}
Dialogue: 0,0:13:59.63,0:14:00.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Natsu.
Dialogue: 0,0:14:03.30,0:14:05.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo bermain basket bersama lagi.
Dialogue: 0,0:14:16.23,0:14:17.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:14:25.40,0:14:26.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ayah.{\i0}
Dialogue: 0,0:14:27.53,0:14:28.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku...{\i0}
Dialogue: 0,0:14:29.82,0:14:31.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}menemukan kekuatanku kembali.{\i0}
Dialogue: 0,0:14:46.34,0:14:47.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah!
Dialogue: 0,0:14:47.26,0:14:51.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malam Natal telah tiba!
Dialogue: 0,0:14:52.68,0:14:56.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ulang tahun Yesus! Artinya,\Nini hari untuk merayakan kehidupan.
Dialogue: 0,0:14:56.72,0:14:58.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya cocok untuk berolahraga!
Dialogue: 0,0:14:58.93,0:15:00.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:15:00.77,0:15:03.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,\Nkalian tak butuh camilan, 'kan?
Dialogue: 0,0:15:05.40,0:15:08.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayang sekali. Padahal Santa Ayame\Nsudah membawakan kukis.
Dialogue: 0,0:15:10.78,0:15:12.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Santa Yang Mulia!
Dialogue: 0,0:15:12.03,0:15:13.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami mohon!
Dialogue: 0,0:15:13.53,0:15:14.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus.
Dialogue: 0,0:15:14.53,0:15:15.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan.
Dialogue: 0,0:15:15.74,0:15:18.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senangnya.
Dialogue: 0,0:15:20.87,0:15:22.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan.
Dialogue: 0,0:15:23.17,0:15:24.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak sekali.
Dialogue: 0,0:15:24.67,0:15:29.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga membuatnya untuk adik-adikmu\Nkarena bahannya masih banyak.
Dialogue: 0,0:15:29.09,0:15:31.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tak perlu repot-repot.
Dialogue: 0,0:15:32.34,0:15:34.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini tidak merepotkan.
Dialogue: 0,0:15:34.39,0:15:36.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tak bisa berterima kasih saja?
Dialogue: 0,0:15:36.60,0:15:39.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:15:40.18,0:15:41.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus!
Dialogue: 0,0:15:42.10,0:15:44.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manajer, aku juga mau.
Dialogue: 0,0:15:44.61,0:15:45.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:15:55.78,0:15:57.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kyo, kerja bagus hari ini!
Dialogue: 0,0:15:57.66,0:15:58.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau juga.
Dialogue: 0,0:16:13.88,0:16:15.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai jumpa.
Dialogue: 0,0:16:15.76,0:16:19.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Kyo, selamat Natal.
Dialogue: 0,0:16:19.64,0:16:20.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:16:22.56,0:16:24.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hinacchi, Niina!
Dialogue: 0,0:16:24.31,0:16:26.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada kakak kelas yang punya kupon karaoke!
Dialogue: 0,0:16:26.77,0:16:27.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:16:27.69,0:16:28.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus!
Dialogue: 0,0:16:28.65,0:16:30.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:16:30.03,0:16:32.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ayo pergi!\N- Aku akan menyanyi sepuasnya!
Dialogue: 0,0:16:32.24,0:16:33.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:16:35.24,0:16:38.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pertandingannya sudah selesai, 'kan?{\i0}
Dialogue: 0,0:16:38.03,0:16:39.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Andai aku tahu hasilnya.{\i0}
Dialogue: 0,0:16:39.49,0:16:41.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita berolahraga!
Dialogue: 0,0:16:42.54,0:16:45.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan KFC, kita makan dada ayam.
Dialogue: 0,0:16:45.08,0:16:48.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan kue Natal, kita minum protein!
Dialogue: 0,0:16:48.04,0:16:50.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal ini Malam Natal.
Dialogue: 0,0:16:50.09,0:16:53.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cinta sejati kita adalah protein!
Dialogue: 0,0:16:57.18,0:16:59.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, ayo!
Dialogue: 0,0:16:59.51,0:17:01.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu baru semangat!
Dialogue: 0,0:17:01.68,0:17:03.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku penasaran mereka bagaimana,{\i0}
Dialogue: 0,0:17:03.85,0:17:06.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}tapi aku tak mau terlalu mengganggu.{\i0}
Dialogue: 0,0:17:07.40,0:17:09.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Lagi pula,\NMalam Natal cuma sekali setahun.{\i0}
Dialogue: 0,0:17:32.17,0:17:33.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku juga harus menikmatinya!{\i0}
Dialogue: 0,0:17:41.60,0:17:44.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampaikan terima kasihku atas tiketnya.
Dialogue: 0,0:17:44.14,0:17:46.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya dia bersusah payah\Ndemi mendapatkannya.
Dialogue: 0,0:17:48.23,0:17:49.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chinatsu.
Dialogue: 0,0:17:50.81,0:17:52.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami mau pergi makan malam.
Dialogue: 0,0:17:52.98,0:17:54.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:17:55.49,0:17:57.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Nagisa.
Dialogue: 0,0:17:58.82,0:18:00.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baru ingat ada urusan.
Dialogue: 0,0:18:00.99,0:18:03.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:18:11.34,0:18:13.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pulang.
Dialogue: 0,0:18:15.38,0:18:17.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia belum pulang.{\i0}
Dialogue: 0,0:18:21.72,0:18:23.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang!
Dialogue: 0,0:18:23.01,0:18:24.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama, selamat atas...
Dialogue: 0,0:18:25.64,0:18:26.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:18:27.48,0:18:29.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa dia pergi ke minimarket?{\i0}
Dialogue: 0,0:20:01.53,0:20:05.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bunyi bel, bunyi bel\NSepanjang jalan{\i0}
Dialogue: 0,0:20:05.53,0:20:07.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sangatlah menyenangkan{\i0}
Dialogue: 0,0:20:07.53,0:20:09.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Naik kereta luncur{\i0}
Dialogue: 0,0:20:09.54,0:20:13.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bunyi bel, bunyi bel\NSepanjang jalan{\i0}
Dialogue: 0,0:20:13.37,0:20:17.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sangatlah menyenangkan\NNaik kereta luncur{\i0}
Dialogue: 0,0:20:17.54,0:20:19.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hore!
Dialogue: 0,0:20:20.96,0:20:23.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Ada Kano.
Dialogue: 0,0:20:23.18,0:20:24.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tak bertanding?
Dialogue: 0,0:20:24.72,0:20:27.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada barangku yang tertinggal.
Dialogue: 0,0:20:27.97,0:20:31.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau ikut pesta Natal kami?
Dialogue: 0,0:20:31.23,0:20:34.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Band rock sekolah mengadakan konser Natal.
Dialogue: 0,0:20:34.48,0:20:38.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nishida menyuruh adik kelasnya beres-beres\Nagar dia bisa ke sini.
Dialogue: 0,0:20:38.77,0:20:40.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kata Taiki tak apa!
Dialogue: 0,0:20:40.11,0:20:44.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, apakah teman Taiki\Ndatang menonton pertandinganmu?
Dialogue: 0,0:20:44.49,0:20:45.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:20:45.57,0:20:47.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya dia memberikan tiketnya.
Dialogue: 0,0:20:47.62,0:20:50.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sampai bertanding melawan Matsuoka\Nuntuk tiket itu.
Dialogue: 0,0:20:50.99,0:20:52.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lari bolak-balik, ya?
Dialogue: 0,0:20:52.66,0:20:55.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia berlari sampai sempoyongan.
Dialogue: 0,0:20:55.12,0:20:57.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku penasaran
Dialogue: 0,0:20:57.50,0:21:01.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}seperti apa temannya sampai dia\Nbersusah payah seperti itu.
Dialogue: 0,0:21:01.09,0:21:04.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan dia pacarnya?
Dialogue: 0,0:21:05.68,0:21:06.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:21:06.59,0:21:08.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya dia ada urusan lain.
Dialogue: 0,0:21:09.55,0:21:10.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, lagu berikutnya.
Dialogue: 0,0:21:16.60,0:21:19.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Selamat Hari Natal{\i0}
Dialogue: 0,0:21:19.56,0:21:22.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dan Tahun Baru{\i0}
