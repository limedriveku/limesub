Dialogue: 0,0:01:49.48,0:01:53.65,sign,,0000,0000,0000,,BLUE BOX MUSIM 2
Dialogue: 0,0:03:16.77,0:03:20.53,sign,,0000,0000,0000,,EPISODE 28\NSATU HAL YANG SAMA
Dialogue: 0,0:04:06.20,0:04:07.12,sign,,0000,0000,0000,,SEMANGAT
Dialogue: 0,0:09:10.46,0:09:12.26,sign,,0000,0000,0000,,05.30 ALARM\NSTOP - SNOOZE
Dialogue: 0,0:12:39.34,0:12:40.75,sign,,0000,0000,0000,,TIKET REKAN RESMI
Dialogue: 0,0:15:23.42,0:15:28.42,sign,,0000,0000,0000,,KLINIK GIGI KIKUCHI
Dialogue: 0,0:00:14.22,0:00:16.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau membuat alasan apa?
Dialogue: 0,0:00:16.18,0:00:17.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:00:17.93,0:00:20.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bisa menebusnya saat SMA.
Dialogue: 0,0:00:20.97,0:00:23.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Wajar ada orang yang lebih baik dari kita.
Dialogue: 0,0:00:23.94,0:00:25.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Tapi bukan itu.
Dialogue: 0,0:00:25.94,0:00:27.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan itu intinya.
Dialogue: 0,0:00:29.61,0:00:30.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa?{\i0}
Dialogue: 0,0:00:30.98,0:00:32.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja...
Dialogue: 0,0:00:33.24,0:00:36.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mudah mengatakan hal yang benar\Nkarena bukan kau yang mengalaminya.
Dialogue: 0,0:00:49.42,0:00:50.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ucapanku tidak salah, 'kan?
Dialogue: 0,0:00:50.80,0:00:52.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sangat menyebalkan.
Dialogue: 0,0:00:52.88,0:00:56.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ekspresimu yang merasa pasti benar itu\Nsangat menyebalkan.
Dialogue: 0,0:00:57.59,0:01:00.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan ganggu aku. Lagi pula,\Naku tak akan bertemu Natsu lagi.
Dialogue: 0,0:01:01.14,0:01:04.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau yang tiba-tiba mengatakan\Nhal jahat kepadanya!
Dialogue: 0,0:01:05.48,0:01:08.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Karena dia bermain-main setelah bilang\Nmau mencapai tingkat nasional!
Dialogue: 0,0:01:08.98,0:01:11.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia masih berlatih dengan giat!
Dialogue: 0,0:01:11.15,0:01:12.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dulu dia lebih sering berlatih!
Dialogue: 0,0:01:12.73,0:01:14.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dulu hidupnya cuma seputar basket.
Dialogue: 0,0:01:14.86,0:01:18.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bisa sehebat itu karena berusaha\Nlebih keras daripada siapa pun!
Dialogue: 0,0:01:18.57,0:01:20.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tak bisa mencapai puncak\Njika bermain-main.
Dialogue: 0,0:01:25.91,0:01:27.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tunggu.{\i0}
Dialogue: 0,0:01:28.58,0:01:32.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ternyata ini karena dia\Nmencemaskan Kak Chinatsu.{\i0}
Dialogue: 0,0:01:32.25,0:01:34.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Goto?
Dialogue: 0,0:01:34.01,0:01:36.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pak Inomata? Ada apa?
Dialogue: 0,0:01:37.80,0:01:39.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak ada apa-apa.
Dialogue: 0,0:01:41.05,0:01:45.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Hubungan mereka tak boleh terus begini.{\i0}
Dialogue: 0,0:03:32.08,0:03:33.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat pagi.
Dialogue: 0,0:03:36.54,0:03:39.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taiki, masukkan makanannya ke kotak bekal!
Dialogue: 0,0:03:40.59,0:03:42.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu kesiangan?
Dialogue: 0,0:03:42.30,0:03:44.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Habisnya, drama Korea-nya sangat seru!
Dialogue: 0,0:03:45.09,0:03:47.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Alasannya kekanakan sekali.{\i0}
Dialogue: 0,0:03:48.01,0:03:49.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Chinatsu mana?
Dialogue: 0,0:03:49.93,0:03:51.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia berangkat lebih dulu.
Dialogue: 0,0:03:51.89,0:03:54.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kejuaraan Musim Dingin sudah dekat.
Dialogue: 0,0:03:55.69,0:03:58.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong bawakan bekalnya.
Dialogue: 0,0:03:58.32,0:04:00.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taruh saja di depan ruang klubnya.
Dialogue: 0,0:04:00.07,0:04:01.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:04:03.07,0:04:05.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bekal Kak Chinatsu.{\i0}
Dialogue: 0,0:04:07.12,0:04:10.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa dia senang jika kubuat seperti ini?{\i0}
Dialogue: 0,0:04:12.04,0:04:13.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Meski tak akan kubuat begitu.{\i0}
Dialogue: 0,0:04:14.25,0:04:16.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku berikan sosis yang besar.{\i0}
Dialogue: 0,0:04:16.46,0:04:18.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sayur yang banyak.{\i0}
Dialogue: 0,0:04:18.71,0:04:20.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Telur gulung yang paling rapi.{\i0}
Dialogue: 0,0:04:23.68,0:04:26.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kalau begitu, tak mungkin bisa ditutup.
Dialogue: 0,0:04:26.05,0:04:27.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Sudah kuduga.
Dialogue: 0,0:04:29.06,0:04:30.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berangkat!
Dialogue: 0,0:04:37.65,0:04:38.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taiki!
Dialogue: 0,0:04:39.98,0:04:41.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini kau terlambat.
Dialogue: 0,0:04:41.78,0:04:43.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mampir ke minimarket dulu.
Dialogue: 0,0:04:43.57,0:04:45.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Berikutnya!\N- Baik!
Dialogue: 0,0:04:46.99,0:04:48.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Berikutnya!\N- Baik!
Dialogue: 0,0:04:50.37,0:04:52.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Turnamen tim basket sudah dekat, 'kan?
Dialogue: 0,0:04:53.71,0:04:58.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suasana di gedung olahraga\Nberubah saat ada turnamen.
Dialogue: 0,0:04:58.38,0:05:00.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi tenang dan tegang.
Dialogue: 0,0:05:01.42,0:05:03.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kegugupan mereka sampai terasa.
Dialogue: 0,0:05:04.22,0:05:05.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:05:09.05,0:05:10.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku paham maksudmu.
Dialogue: 0,0:05:11.22,0:05:12.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat pagi.
Dialogue: 0,0:05:12.35,0:05:13.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pagi.
Dialogue: 0,0:05:15.81,0:05:17.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pagi.
Dialogue: 0,0:05:21.32,0:05:23.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Pagi.\N- Dah.
Dialogue: 0,0:05:26.65,0:05:27.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja.
Dialogue: 0,0:05:29.16,0:05:32.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski sikapnya sedang begitu,\Nsenam iramanya tetap luar biasa.
Dialogue: 0,0:05:33.45,0:05:38.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya pengaruhmu dalam hidup Hina\Ntak sebesar dugaanku.
Dialogue: 0,0:05:41.17,0:05:43.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa maksudnya?{\i0}
Dialogue: 0,0:06:00.69,0:06:03.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bekal siapa?
Dialogue: 0,0:06:03.98,0:06:05.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Punyaku.
Dialogue: 0,0:06:21.04,0:06:23.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo cepat, Chinatsu.
Dialogue: 0,0:06:23.21,0:06:24.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:06:26.96,0:06:27.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oper!
Dialogue: 0,0:06:28.59,0:06:29.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maju!
Dialogue: 0,0:06:29.97,0:06:31.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rebut satu poin!
Dialogue: 0,0:06:36.31,0:06:37.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus!
Dialogue: 0,0:06:37.23,0:06:38.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kembali bertahan!
Dialogue: 0,0:06:43.15,0:06:44.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Istirahat sepuluh menit!
Dialogue: 0,0:06:44.52,0:06:45.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:06:55.08,0:06:57.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yuna, ada waktu sebentar?
Dialogue: 0,0:06:58.12,0:06:59.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:07:00.04,0:07:03.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di permainan tadi,\Nkau bisa menembak ke ring sendiri.
Dialogue: 0,0:07:04.50,0:07:07.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tim lawan mengepung Saya.
Dialogue: 0,0:07:07.96,0:07:12.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini cuma masukan, kurasa\Nkau bisa bermain lebih agresif.
Dialogue: 0,0:07:12.64,0:07:16.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika mau, aku bisa berlatih bersamamu\Nsetelah ini atau besok pagi.
Dialogue: 0,0:07:16.26,0:07:17.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Maaf!
Dialogue: 0,0:07:17.47,0:07:19.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah tahu!
Dialogue: 0,0:07:19.77,0:07:23.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu aku payah\Ndan cuma membebani yang lain.
Dialogue: 0,0:07:24.69,0:07:25.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Tapi...
Dialogue: 0,0:07:26.52,0:07:30.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan kira semua orang\Nbisa berusaha sekeras dirimu!
Dialogue: 0,0:07:33.49,0:07:36.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf! Aku terbawa emosi!
Dialogue: 0,0:07:36.49,0:07:38.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak apa-apa.
Dialogue: 0,0:07:38.49,0:07:42.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga tidak sempurna.\NAyo tetap berusaha bersama-sama.
Dialogue: 0,0:08:09.28,0:08:11.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau yang pertama datang lagi?
Dialogue: 0,0:08:11.28,0:08:12.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:08:12.65,0:08:15.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tak pernah merasa mau bolos\Ndan bermain gim?
Dialogue: 0,0:08:15.95,0:08:19.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku mulai bermain basket\Nlebih lambat dari yang lain.
Dialogue: 0,0:08:19.99,0:08:24.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, setidaknya aku harus berlatih\Nsejam lebih lama tiap hari untuk mengejar.
Dialogue: 0,0:08:24.21,0:08:28.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejam tiap hari berarti\Nbertambah satu hari tiap 24 hari,
Dialogue: 0,0:08:28.63,0:08:33.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi dalam setahun...
Dialogue: 0,0:08:33.59,0:08:35.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak punya waktu untuk hal lain!
Dialogue: 0,0:08:36.59,0:08:39.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memikirkannya dan mewujudkannya\Nsangat berbeda.
Dialogue: 0,0:08:39.97,0:08:43.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa mewujudkan itu adalah bakatmu.
Dialogue: 0,0:09:21.10,0:09:25.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan kira semua orang\Nbisa berusaha sekeras dirimu!
Dialogue: 0,0:09:26.69,0:09:27.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat!
Dialogue: 0,0:09:56.22,0:09:57.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat pagi.
Dialogue: 0,0:09:57.51,0:09:59.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat pagi!
Dialogue: 0,0:09:59.26,0:10:00.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat pagi.
Dialogue: 0,0:10:01.01,0:10:03.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bekalmu ada di meja.
Dialogue: 0,0:10:03.22,0:10:05.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini dibungkus dengan rapi.
Dialogue: 0,0:10:05.85,0:10:07.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena tak kesiangan.
Dialogue: 0,0:10:07.27,0:10:08.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:10:08.73,0:10:11.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya kau bersyukur\NIbu bangun pagi tiap hari
Dialogue: 0,0:10:11.56,0:10:13.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk mengikuti jadwal kalian.
Dialogue: 0,0:10:13.82,0:10:15.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah bersyukur.
Dialogue: 0,0:10:15.69,0:10:17.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:10:17.07,0:10:20.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,\Ntolong belikan kue dari toko.
Dialogue: 0,0:10:21.32,0:10:22.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu langsung minta?
Dialogue: 0,0:10:30.17,0:10:32.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Hei, Taiki.\N- Ya?
Dialogue: 0,0:10:32.34,0:10:36.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pernah merasa mau bolos latihan pagi?
Dialogue: 0,0:10:38.13,0:10:43.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kurasa aku pasti mau bolos\Njika tak ada Kak Chinatsu.{\i0}
Dialogue: 0,0:10:45.72,0:10:47.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Tentu saja pernah.
Dialogue: 0,0:10:47.85,0:10:50.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Terkadang aku malas bangun dari ranjang.
Dialogue: 0,0:10:52.15,0:10:56.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi saat begitu, aku cuma membayangkan\Ndiriku di masa depan.
Dialogue: 0,0:10:56.94,0:11:00.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemungkinan besar,\Naku akan menyesal karena tidur lagi
Dialogue: 0,0:11:00.95,0:11:04.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan jadi sedikit membenci diriku.
Dialogue: 0,0:11:04.66,0:11:07.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, saat membayangkan itu,\Naku bisa bangun.
Dialogue: 0,0:11:18.92,0:11:21.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sangat tekun.
Dialogue: 0,0:11:22.39,0:11:24.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kau juga sama!{\i0}
Dialogue: 0,0:11:44.95,0:11:47.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jika dia menanyakan itu,{\i0}
Dialogue: 0,0:11:47.70,0:11:51.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}apakah itu artinya terkadang\Ndia juga merasa mau bolos latihan?{\i0}
Dialogue: 0,0:11:52.50,0:11:54.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pasti begitu.{\i0}
Dialogue: 0,0:11:54.79,0:11:57.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Lagi pula, dia mulai\Nbermain basket karena Yumeka.{\i0}
Dialogue: 0,0:11:58.59,0:12:02.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tapi terus berlatih tanpa istirahat\Nmemang sudah sifat Kak Chinatsu.{\i0}
Dialogue: 0,0:12:07.68,0:12:10.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Yumeka salah paham.{\i0}
Dialogue: 0,0:12:11.06,0:12:14.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kak Chinatsu terus berusaha keras sendiri.{\i0}
Dialogue: 0,0:12:15.69,0:12:18.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tapi itu cuma karena dia punya tujuan.{\i0}
Dialogue: 0,0:12:19.44,0:12:21.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bukan berarti itu tidak berat.{\i0}
Dialogue: 0,0:12:22.61,0:12:27.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Andai Yumeka tetap menemani Kak Chinatsu.{\i0}
Dialogue: 0,0:12:30.58,0:12:32.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tim basket perempuan mana?
Dialogue: 0,0:12:32.20,0:12:34.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka ada latih tanding pagi ini.
Dialogue: 0,0:12:35.75,0:12:37.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei.
Dialogue: 0,0:12:37.25,0:12:39.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, Pak Pelatih?
Dialogue: 0,0:12:40.75,0:12:43.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang mau tiket\NKejuaraan Musim Dingin pertama mereka?
Dialogue: 0,0:12:44.51,0:12:49.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Istriku membeli tiketnya,\Ntapi pinggul ibunya terluka,
Dialogue: 0,0:12:49.47,0:12:51.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi dia harus pulang merawatnya.
Dialogue: 0,0:12:51.39,0:12:53.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia dapat tempat duduk yang bagus.
Dialogue: 0,0:12:53.64,0:12:55.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, aku! Aku mau!
Dialogue: 0,0:12:57.06,0:13:00.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Boleh saja, tapi bukankah kau ada latihan?
Dialogue: 0,0:13:00.48,0:13:04.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan untukku, untuk temanku.
Dialogue: 0,0:13:06.24,0:13:08.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, untukku saja.
Dialogue: 0,0:13:11.08,0:13:13.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Sebaiknya utamakan orang\Nyang pasti bisa pergi.
Dialogue: 0,0:13:13.62,0:13:15.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Yang mana saja boleh.
Dialogue: 0,0:13:15.12,0:13:16.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak boleh!
Dialogue: 0,0:13:16.71,0:13:17.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:13:17.88,0:13:21.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya lebih cocok\Nkarena aku juga anggota tim basket.
Dialogue: 0,0:13:21.46,0:13:23.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang minta lebih dulu!
Dialogue: 0,0:13:23.59,0:13:26.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tak bilang kau yang dapat.
Dialogue: 0,0:13:26.88,0:13:31.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Aku cuma tak mau\Ndia mendekati Kak Chinatsu!{\i0}
Dialogue: 0,0:13:31.60,0:13:34.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Pernah dengar "siapa cepat, dia dapat"?
Dialogue: 0,0:13:34.27,0:13:37.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah lama aku tak dengar itu\Ndalam bahasa Jepang.
Dialogue: 0,0:13:37.98,0:13:40.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Lagi-lagi pamer\Nkarena pernah tinggal di luar negeri!{\i0}
Dialogue: 0,0:13:41.48,0:13:43.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesuka kalian saja.
Dialogue: 0,0:13:44.32,0:13:46.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,\Nbagaimana kalau kita bersaing?
Dialogue: 0,0:13:47.20,0:13:50.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misalnya,
Dialogue: 0,0:13:50.20,0:13:54.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang bisa berlari bolak-balik lebih lama\Nyang menang.
Dialogue: 0,0:13:54.70,0:13:56.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berlari bolak-balik?
Dialogue: 0,0:13:56.08,0:14:00.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa berlari lebih adil\Ndaripada memilih salah satu olahraga kita.
Dialogue: 0,0:14:00.88,0:14:02.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tinggal berlari bolak-balik.
Dialogue: 0,0:14:04.84,0:14:09.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, stamina pemain basket\Numumnya lebih kuat.
Dialogue: 0,0:14:09.68,0:14:11.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia juga lebih tua.
Dialogue: 0,0:14:11.64,0:14:15.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya dia juga berlari 10 kilometer\Nsetiap hari saat di Amerika.
Dialogue: 0,0:14:15.47,0:14:18.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya Matsuoka akan unggul.
Dialogue: 0,0:14:19.69,0:14:20.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana?
Dialogue: 0,0:14:22.31,0:14:23.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh!
Dialogue: 0,0:14:25.03,0:14:30.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Hitung mundur dimulai dari lima,\Nkemudian tes dimulai.{\i0}
Dialogue: 0,0:14:31.74,0:14:32.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dalam lima detik.{\i0}
Dialogue: 0,0:14:33.49,0:14:36.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tiga, dua, satu.{\i0}
Dialogue: 0,0:14:36.50,0:14:37.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mulai!{\i0}
Dialogue: 0,0:14:52.18,0:14:55.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita kembali lagi ke sekolah\Nuntuk berlatih?
Dialogue: 0,0:14:55.01,0:14:57.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku sudah habis-habisan\Nsaat bertanding.
Dialogue: 0,0:14:57.39,0:15:00.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kita jadi bisa langsung\Nmemperbaiki kekurangan kita.
Dialogue: 0,0:15:00.14,0:15:03.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya jemput kita dengan bus.
Dialogue: 0,0:15:03.31,0:15:05.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jaraknya bisa ditempuh jalan kaki.
Dialogue: 0,0:15:08.61,0:15:12.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau mampir ke rumah dulu\Nuntuk mengambil baju ganti.
Dialogue: 0,0:15:12.16,0:15:13.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:15:28.42,0:15:31.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ini klinik gigi yang Taiki kunjungi.{\i0}
Dialogue: 0,0:15:31.68,0:15:34.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan pergi ke sana!
Dialogue: 0,0:15:34.43,0:15:37.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah membantu.
Dialogue: 0,0:15:37.10,0:15:39.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kembali sekitar 30 menit lagi.
Dialogue: 0,0:15:41.31,0:15:42.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pergi...
Dialogue: 0,0:15:49.03,0:15:50.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, Nona Goto.
Dialogue: 0,0:15:50.32,0:15:53.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa tolong beli tisu toilet juga?
Dialogue: 0,0:15:53.70,0:15:54.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:15:58.12,0:15:59.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Goto?
Dialogue: 0,0:16:01.83,0:16:04.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira nama belakangmu Kido.
Dialogue: 0,0:16:05.21,0:16:09.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang tuaku bercerai saat aku lulus SMP.
Dialogue: 0,0:16:10.51,0:16:12.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baru tahu.
Dialogue: 0,0:16:13.09,0:16:17.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Itu bukan hal penting,\Njadi kurasa tak perlu kukatakan.
Dialogue: 0,0:16:19.06,0:16:23.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kau benar-benar\Ntak pernah memberitahuku apa pun.
Dialogue: 0,0:16:33.61,0:16:37.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mau sekali tiket itu?
Dialogue: 0,0:16:37.74,0:16:39.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa perlu lari sampai begitu?
Dialogue: 0,0:16:40.54,0:16:43.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah jelas ada sesuatu.
Dialogue: 0,0:16:43.79,0:16:44.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudmu?
Dialogue: 0,0:16:45.37,0:16:47.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakimu pasti mulai terasa berat.
Dialogue: 0,0:16:47.88,0:16:49.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku masih kuat!
Dialogue: 0,0:16:51.80,0:16:55.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, karena ini\Nbahkan bukan pemanasan bagiku.
Dialogue: 0,0:16:56.30,0:16:58.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia tampak percaya diri.{\i0}
Dialogue: 0,0:17:00.56,0:17:03.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong,
Dialogue: 0,0:17:03.39,0:17:08.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bagaimana kalau yang kalah\Nmenyerah mendekati Natsu juga?
Dialogue: 0,0:17:10.73,0:17:13.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak mungkin aku akan setuju.
Dialogue: 0,0:17:14.53,0:17:17.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perasaanku terlalu kuat\Nuntuk menyerah karena hal sepele!
Dialogue: 0,0:17:17.99,0:17:19.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitukah?
Dialogue: 0,0:17:20.03,0:17:21.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:17:24.33,0:17:30.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}meski tak setuju, kau akan tampak payah\Njika kalah dariku di sini.
Dialogue: 0,0:17:37.22,0:17:39.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tak pernah memberitahuku apa pun.
Dialogue: 0,0:17:46.52,0:17:48.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bekerja di sini?
Dialogue: 0,0:17:50.48,0:17:51.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:17:52.69,0:17:54.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Maka Taiki pasti sudah tahu.{\i0}
Dialogue: 0,0:17:58.99,0:18:03.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah kau pindah sekolah saat SMA\Nkarena orang tuamu?
Dialogue: 0,0:18:03.95,0:18:05.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tak ada hubungannya.
Dialogue: 0,0:18:06.37,0:18:07.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitukah?
Dialogue: 0,0:18:08.46,0:18:12.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Andai kau bercerita kepadaku\Ntentang hal seperti ini.
Dialogue: 0,0:18:13.38,0:18:15.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi cuma karena aku temanmu,
Dialogue: 0,0:18:15.30,0:18:17.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bukan berarti\Nkau harus menceritakan semuanya.
Dialogue: 0,0:18:18.05,0:18:21.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga tak mau\Nberlagak memahami perasaanmu.
Dialogue: 0,0:18:22.22,0:18:24.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu kehidupanmu sendiri.
Dialogue: 0,0:18:24.97,0:18:26.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Apa boleh buat, 'kan?
Dialogue: 0,0:18:34.02,0:18:36.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf mengganggumu belanja.
Dialogue: 0,0:18:39.53,0:18:40.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana bisa kuceritakan?
Dialogue: 0,0:18:44.28,0:18:45.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana bisa kutunjukkan kelemahanku?
Dialogue: 0,0:18:46.58,0:18:47.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apalagi kepadamu!{\i0}
Dialogue: 0,0:18:52.25,0:18:54.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena dulu aku panutanmu!
Dialogue: 0,0:19:00.01,0:19:05.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Memang ada masa-masa kita berdua\Ngembira sebagai teman.
Dialogue: 0,0:19:05.01,0:19:10.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kau mengagumiku\Nkarena aku pandai bermain basket.{\i0}
Dialogue: 0,0:19:11.02,0:19:12.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Awalnya, itu membuatku senang.{\i0}
Dialogue: 0,0:19:14.02,0:19:19.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi perlahan-lahan,\Nsemangatku bermain basket mulai pudar.
Dialogue: 0,0:19:21.57,0:19:22.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bohong.
Dialogue: 0,0:19:22.95,0:19:24.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak berbohong.
Dialogue: 0,0:19:28.87,0:19:31.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yumeka, Ibu dan Ayah...
Dialogue: 0,0:19:33.13,0:19:36.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak sekeren yang kau kira.
Dialogue: 0,0:19:37.17,0:19:39.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku selalu merasa mau bolos latihan.{\i0}
Dialogue: 0,0:19:40.51,0:19:45.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Begitu sadar bakat itu tak penting,\Naku mau lari dari basket.{\i0}
Dialogue: 0,0:19:47.31,0:19:51.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, justru aku yang mengagumimu.
Dialogue: 0,0:19:53.69,0:19:55.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak pernah merasa mau bolos latihan,
Dialogue: 0,0:19:56.52,0:19:58.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau selalu fokus\Npada yang perlu kau perbaiki,
Dialogue: 0,0:19:58.98,0:20:00.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tak bisa mengimbangi.
Dialogue: 0,0:20:00.69,0:20:03.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku malu karena perbedaan kita berdua
Dialogue: 0,0:20:04.24,0:20:06.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dan aku jadi membencimu.{\i0}
Dialogue: 0,0:20:08.08,0:20:10.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana bisa aku memberitahumu itu?
Dialogue: 0,0:20:13.83,0:20:16.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kemampuannya untuk berusaha keras
Dialogue: 0,0:20:16.79,0:20:18.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}membuatku kagum.
Dialogue: 0,0:20:19.21,0:20:22.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa mewujudkan itu adalah bakatmu.
Dialogue: 0,0:20:25.72,0:20:28.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku melihatmu.
Dialogue: 0,0:20:29.14,0:20:31.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Hari setelah pertandingan final kita\Nsaat SMP.{\i0}
Dialogue: 0,0:20:37.15,0:20:39.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku melihatmu berlatih sendirian.{\i0}
Dialogue: 0,0:20:41.44,0:20:44.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu itu aku sedang depresi
Dialogue: 0,0:20:44.70,0:20:48.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan bahkan merasa lega\Nsaat semuanya sudah selesai.
Dialogue: 0,0:20:50.95,0:20:54.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pasti sangat kecewa.
Dialogue: 0,0:20:54.16,0:20:58.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membayangkan kau yang pasti berusaha\Nsangat keras kecewa seperti itu...
Dialogue: 0,0:21:02.17,0:21:04.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu aku sangat terkejut.
Dialogue: 0,0:21:05.55,0:21:08.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Melihatmu bermain-main dengan anak lelaki.{\i0}
Dialogue: 0,0:21:08.89,0:21:13.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu bukan Natsu yang membuatku\Nmerasa minder.{\i0}
Dialogue: 0,0:21:13.68,0:21:17.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tergila-gila dengan basket\Nsampai tak bisa memikirkan hal lain,
Dialogue: 0,0:21:17.77,0:21:20.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}berlatih sendirian diam-diam.{\i0}
Dialogue: 0,0:21:20.07,0:21:21.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah dirimu!
Dialogue: 0,0:21:21.82,0:21:23.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kau salah!
Dialogue: 0,0:21:25.20,0:21:26.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bukan hal lain.
Dialogue: 0,0:21:28.45,0:21:31.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bagiku, itu semua satu hal yang sama.{\i0}
Dialogue: 0,0:21:34.71,0:21:36.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah kau berhenti,
Dialogue: 0,0:21:37.08,0:21:42.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}aku kehilangan tujuan yang kukejar\Ndan orang yang paling kuandalkan.{\i0}
Dialogue: 0,0:21:44.05,0:21:45.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat kesepian.
Dialogue: 0,0:21:48.93,0:21:51.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Memenangkan kejuaraan nasional\Nadalah tujuan yang tinggi.{\i0}
Dialogue: 0,0:21:52.93,0:21:58.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Lalu tepat saat aku mulai meragukan\Napakah terus menerus berlatih seperti ini{\i0}
Dialogue: 0,0:21:58.23,0:21:59.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}ada gunanya...{\i0}
Dialogue: 0,0:22:04.99,0:22:06.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Di saat aku mulai putus asa,{\i0}
