Dialogue: 0,0:00:16.47,0:00:20.64,sign,,0000,0000,0000,,BLUE BOX MUSIM 2
Dialogue: 0,0:03:09.64,0:03:11.56,sign,,0000,0000,0000,,KLINIK GIGI KIKUCHI
Dialogue: 0,0:10:53.65,0:10:55.07,sign,,0000,0000,0000,,TIKET REKAN RESMI
Dialogue: 0,0:12:02.76,0:12:06.68,sign,,0000,0000,0000,,TIKET REKAN RESMI
Dialogue: 0,0:15:19.50,0:15:20.58,sign,,0000,0000,0000,,BAWA SAJA
Dialogue: 0,0:16:42.96,0:16:44.04,sign,,0000,0000,0000,,DESEMBER
Dialogue: 0,0:16:44.04,0:16:46.00,sign,,0000,0000,0000,,{\an8}KEJUARAAN MUSIM DINGIN\NJADI JUARA!
Dialogue: 0,0:19:23.78,0:19:26.28,sign,,0000,0000,0000,,KAFE DAN RESTORAN GONATHAN'S
Dialogue: 0,0:20:27.01,0:20:28.01,sign,,0000,0000,0000,,IMPIAN\NPEMAIN BASKET
Dialogue: 0,0:20:58.13,0:20:59.21,sign,,0000,0000,0000,,MENYEDIHKAN
Dialogue: 0,0:21:18.15,0:21:20.77,sign,,0000,0000,0000,,BENCI
Dialogue: 0,0:21:20.77,0:21:22.57,sign,,0000,0000,0000,,CINTA
Dialogue: 0,0:21:42.42,0:21:43.50,sign,,0000,0000,0000,,{\an8}KEJUARAAN SOFTBANK
Dialogue: 0,0:22:20.96,0:22:23.88,sign,,0000,0000,0000,,EPISODE 29\NCINTA ADALAH PERASAAN YANG TERKUAT
Dialogue: 0,0:02:04.95,0:02:07.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tembakan bagus. Kau memang anakku.
Dialogue: 0,0:02:07.83,0:02:08.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa begitu.
Dialogue: 0,0:02:09.75,0:02:10.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yumeka.
Dialogue: 0,0:02:11.54,0:02:12.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau cinta basket?
Dialogue: 0,0:02:14.84,0:02:16.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja!
Dialogue: 0,0:02:16.09,0:02:17.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih dari sayang Papa?
Dialogue: 0,0:02:17.67,0:02:18.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Menyebalkan.
Dialogue: 0,0:02:25.01,0:02:28.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengar, Yumeka.\NJaga perasaan itu baik-baik.
Dialogue: 0,0:02:30.60,0:02:32.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasa "cinta" itu
Dialogue: 0,0:02:33.15,0:02:35.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah perasaan yang terkuat.
Dialogue: 0,0:02:39.61,0:02:41.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kalau begitu, Papa yang terkuat.
Dialogue: 0,0:02:41.95,0:02:43.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Karena sangat sayang Mama!
Dialogue: 0,0:02:43.78,0:02:47.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Benar! Papa sangat sayang kau dan Mama!
Dialogue: 0,0:02:49.21,0:02:50.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Papa sayang kalian!
Dialogue: 0,0:03:00.34,0:03:01.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf sudah mengganggu.
Dialogue: 0,0:03:12.15,0:03:13.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku sudah tahu.{\i0}
Dialogue: 0,0:03:14.52,0:03:16.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bahwa aku menyalahkanmu.{\i0}
Dialogue: 0,0:03:17.65,0:03:21.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bahwa aku melampiaskan amarahku kepadamu\Nkarena aku berhenti bermain basket.{\i0}
Dialogue: 0,0:03:27.12,0:03:30.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak itu masih kelas satu,\Ntapi sudah masuk tim.
Dialogue: 0,0:03:30.96,0:03:34.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar dia cukup terkenal saat masih SD.
Dialogue: 0,0:03:34.17,0:03:36.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat sekali.
Dialogue: 0,0:03:36.54,0:03:38.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski tak terlihat begitu.
Dialogue: 0,0:03:38.88,0:03:39.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sial!{\i0}
Dialogue: 0,0:03:40.55,0:03:44.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku sudah tahu ini tak akan mudah,\Ntapi aku kesulitan mengejar.{\i0}
Dialogue: 0,0:03:45.01,0:03:48.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kurasa itu wajar karena mereka berlatih\Nsatu, dua tahun lebih lama dariku.{\i0}
Dialogue: 0,0:03:57.44,0:04:02.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mungkin aku berbakat saat SD,\Ntapi sekarang kemampuanku sebatas ini.{\i0}
Dialogue: 0,0:04:07.41,0:04:08.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kido.
Dialogue: 0,0:04:09.20,0:04:11.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lain kali, kuharap kau lebih baik lagi.
Dialogue: 0,0:04:14.04,0:04:15.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:04:15.63,0:04:19.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Benar juga.\NAku tinggal berusaha lebih keras.{\i0}
Dialogue: 0,0:04:19.84,0:04:22.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku cuma perlu\Nberlatih keras seperti Natsu.{\i0}
Dialogue: 0,0:04:23.47,0:04:25.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku ada di sini karena mereka\Nmenaruh harapan padaku.{\i0}
Dialogue: 0,0:04:26.72,0:04:28.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku harus berusaha keras.{\i0}
Dialogue: 0,0:04:32.81,0:04:35.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sampai mulutku merasakan darah.{\i0}
Dialogue: 0,0:04:36.65,0:04:39.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sampai tanganku kering kerontang.{\i0}
Dialogue: 0,0:04:47.49,0:04:49.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sampai jantungku hampir meledak.{\i0}
Dialogue: 0,0:04:59.71,0:05:02.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Lalu semua itu\Nmulai mencabikku perlahan-lahan.{\i0}
Dialogue: 0,0:05:04.59,0:05:05.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pikirkan keluargamu!
Dialogue: 0,0:05:05.72,0:05:07.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pulang.
Dialogue: 0,0:05:07.01,0:05:08.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini lagi?
Dialogue: 0,0:05:08.39,0:05:12.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku paham kau sibuk,\Ntapi kau harus dengar ucapanku.
Dialogue: 0,0:05:12.47,0:05:14.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita sudah membicarakan ini.
Dialogue: 0,0:05:14.31,0:05:17.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tak memikirkan Yumeka\Ndan aku sama sekali!
Dialogue: 0,0:05:17.81,0:05:19.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kau seperti itu...
Dialogue: 0,0:05:19.56,0:05:21.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Jadi, aku yang salah?\N- Kau mulai lagi.
Dialogue: 0,0:05:21.73,0:05:23.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau juga sama saja.
Dialogue: 0,0:05:23.40,0:05:26.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak tahan lagi.\NUcapanku selalu sia-sia.
Dialogue: 0,0:05:26.40,0:05:27.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan begitu.
Dialogue: 0,0:05:33.16,0:05:34.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun, apa boleh buat?{\i0}
Dialogue: 0,0:05:35.46,0:05:37.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Perasaan bisa berubah.{\i0}
Dialogue: 0,0:05:42.00,0:05:44.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukumu baru?
Dialogue: 0,0:05:44.05,0:05:45.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:05:45.42,0:05:46.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, 'kan?
Dialogue: 0,0:05:47.47,0:05:48.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ayah.{\i0}
Dialogue: 0,0:05:49.39,0:05:53.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku bisa merasakan tenagaku makin lemah.{\i0}
Dialogue: 0,0:05:54.43,0:05:56.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tapi tak apa-apa, 'kan?{\i0}
Dialogue: 0,0:05:57.14,0:06:00.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku cuma kelelahan\Nkarena latihan yang berat saat ini,{\i0}
Dialogue: 0,0:06:02.98,0:06:06.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}tapi tenagaku akan pulih lagi, 'kan?{\i0}
Dialogue: 0,0:06:15.75,0:06:17.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat pagi, Yumeka!
Dialogue: 0,0:06:21.38,0:06:22.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau datang pagi seperti biasa.
Dialogue: 0,0:06:25.05,0:06:26.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo berlatih bersamaku.
Dialogue: 0,0:06:33.93,0:06:36.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku harus merahasiakan ini dari Natsu.{\i0}
Dialogue: 0,0:06:37.39,0:06:42.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku tak mau dia terpengaruh\Nperasaan negatifku.{\i0}
Dialogue: 0,0:06:48.57,0:06:50.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Karena dia masih cinta basket.{\i0}
Dialogue: 0,0:06:52.87,0:06:56.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dalam kompetisi, kita bukan dinilai\Ndari lama latihan.{\i0}
Dialogue: 0,0:06:56.24,0:06:57.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rebound!
Dialogue: 0,0:06:57.16,0:06:58.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus!
Dialogue: 0,0:06:58.08,0:06:59.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yumeka!
Dialogue: 0,0:07:00.58,0:07:05.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Melainkan kepercayaan\Nbahwa usaha kita akan memberi kekuatan.{\i0}
Dialogue: 0,0:07:06.34,0:07:07.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku...{\i0}
Dialogue: 0,0:07:08.71,0:07:10.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku harus mencetak poin di sini.{\i0}
Dialogue: 0,0:07:11.38,0:07:13.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jika begitu, aku masih bisa...{\i0}
Dialogue: 0,0:07:15.89,0:07:17.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun, pada akhirnya,{\i0}
Dialogue: 0,0:07:18.22,0:07:19.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dibandingkan dia...{\i0}
Dialogue: 0,0:07:46.00,0:07:50.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kenapa aku tak lebih sering berlatih?{\i0}
Dialogue: 0,0:07:52.51,0:07:55.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kenapa aku tak lebih serius dalam basket?{\i0}
Dialogue: 0,0:07:59.02,0:08:01.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa aku akan terus merasa seperti ini?{\i0}
Dialogue: 0,0:08:03.60,0:08:06.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Untuk apa aku berusaha keras selama ini?{\i0}
Dialogue: 0,0:08:09.61,0:08:11.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ini tidak menyenangkan.{\i0}
Dialogue: 0,0:08:12.53,0:08:14.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku lelah.{\i0}
Dialogue: 0,0:08:17.91,0:08:20.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Untuk apa aku terus berusaha?{\i0}
Dialogue: 0,0:08:40.06,0:08:41.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yumeka.
Dialogue: 0,0:08:43.52,0:08:44.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus bicara.
Dialogue: 0,0:08:46.44,0:08:48.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Aku mau tidur.
Dialogue: 0,0:08:51.15,0:08:52.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengar.
Dialogue: 0,0:08:52.32,0:08:53.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:08:55.66,0:08:58.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu dan Ayah akan bercerai.
Dialogue: 0,0:09:02.16,0:09:04.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Apanya yang perasaan terkuat?
Dialogue: 0,0:09:17.39,0:09:18.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tolong!{\i0}
Dialogue: 0,0:09:24.81,0:09:29.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku cuma mau bermain basket seperti dulu.{\i0}
Dialogue: 0,0:09:30.36,0:09:34.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Saat memasukkan bolanya ke ring\Nsudah membuatku gembira.{\i0}
Dialogue: 0,0:09:39.03,0:09:41.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku tak mau menerima kenyataan ini!{\i0}
Dialogue: 0,0:09:58.63,0:10:03.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mungkin aku...{\i0}
Dialogue: 0,0:10:05.14,0:10:06.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}tidak cinta basket lagi...{\i0}
Dialogue: 0,0:10:25.87,0:10:27.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Rasanya sangat menyiksa.{\i0}
Dialogue: 0,0:10:28.46,0:10:31.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Seiring aku makin negatif,{\i0}
Dialogue: 0,0:10:31.92,0:10:34.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Natsu terus melangkah maju.{\i0}
Dialogue: 0,0:10:36.21,0:10:37.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Andai saja...{\i0}
Dialogue: 0,0:10:38.63,0:10:39.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yumeka!
Dialogue: 0,0:10:41.80,0:10:44.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Andai aku tetap di sisi Natsu waktu itu,{\i0}
Dialogue: 0,0:10:47.14,0:10:48.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}apakah aku{\i0}
Dialogue: 0,0:10:49.39,0:10:51.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}bisa menyukai basket lagi?{\i0}
Dialogue: 0,0:10:57.90,0:10:58.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:10:58.99,0:11:03.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini tiket pertandingan\NKejuaraan Musim Dingin Kak Chinatsu.
Dialogue: 0,0:11:04.41,0:11:06.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untukmu.
Dialogue: 0,0:11:07.66,0:11:10.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Ini tiket pertandingan\NKejuaraan Musim Dingin Kak Chinatsu.
Dialogue: 0,0:11:11.33,0:11:12.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untukmu.
Dialogue: 0,0:11:13.58,0:11:15.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, tolong pergi...
Dialogue: 0,0:11:16.50,0:11:18.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sempoyongan.
Dialogue: 0,0:11:18.05,0:11:19.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakiku seperti mau copot.
Dialogue: 0,0:11:20.72,0:11:23.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudmu itu untukku?
Dialogue: 0,0:11:24.01,0:11:25.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Ada orang seperti itu di hidupku...
Dialogue: 0,0:11:29.35,0:11:31.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah lebih baik kau yang pergi?
Dialogue: 0,0:11:32.23,0:11:34.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Natsu pasti lebih senang jika kau datang.
Dialogue: 0,0:11:35.36,0:11:36.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak boleh aku yang datang.
Dialogue: 0,0:11:37.61,0:11:39.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika soal basket, harus kau orangnya.
Dialogue: 0,0:11:41.86,0:11:46.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa salahnya menonton\Npertandingan basket teman lama?
Dialogue: 0,0:11:48.91,0:11:52.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya, aku sudah bersusah payah\Nmemenangkan tiket ini,
Dialogue: 0,0:11:52.33,0:11:53.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi jangan disia-siakan!
Dialogue: 0,0:11:56.38,0:11:57.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku minta tolong.
Dialogue: 0,0:12:09.77,0:12:13.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak kusangka anak kelas satu itu menang.
Dialogue: 0,0:12:13.19,0:12:16.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Matsuoka pasti sangat kesal.
Dialogue: 0,0:12:19.28,0:12:22.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya kau putus asa.\NKau mau berikan tiketnya kepada siapa?
Dialogue: 0,0:12:24.78,0:12:28.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski tak kau beri tahu, aku tinggal tanya\Nkepada anggota tim perempuan.
Dialogue: 0,0:12:28.70,0:12:29.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Curang!
Dialogue: 0,0:12:32.29,0:12:34.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu untuk Yumeka.
Dialogue: 0,0:12:34.04,0:12:35.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yumeka?
Dialogue: 0,0:12:36.33,0:12:38.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mantan anggota tim basket saat SMP.
Dialogue: 0,0:12:38.46,0:12:39.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah tahu itu.
Dialogue: 0,0:12:40.55,0:12:42.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, apa maumu?
Dialogue: 0,0:12:42.26,0:12:43.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:12:43.34,0:12:44.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sudah berhenti.
Dialogue: 0,0:12:45.30,0:12:49.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika orang seperti kita terlibat,\NYumeka hanya akan makin kesal.
Dialogue: 0,0:12:49.85,0:12:52.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, dia tak bisa kembali ke Eimei.
Dialogue: 0,0:12:56.98,0:12:57.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu memang benar.
Dialogue: 0,0:12:58.94,0:13:01.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin ini sudah terlambat.
Dialogue: 0,0:13:02.57,0:13:05.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagi Kak Chinatsu,\NYumeka bukan hanya potongan masa lalu.
Dialogue: 0,0:13:05.82,0:13:07.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bagian darinya.
Dialogue: 0,0:13:09.91,0:13:11.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kak Chinatsu yang kukagumi{\i0}
Dialogue: 0,0:13:12.29,0:13:15.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}tak mungkin menjadi dirinya sekarang\Ntanpa Yumeka.{\i0}
Dialogue: 0,0:13:16.83,0:13:19.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin mereka berteman lagi.
Dialogue: 0,0:13:22.80,0:13:24.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anggap saja ini keegoisanku.
Dialogue: 0,0:13:29.47,0:13:32.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana anak kelas satu kami?
Dialogue: 0,0:13:32.60,0:13:36.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pasti masih bisa terus berlari\Njika tak tergelincir keringatmu.
Dialogue: 0,0:13:37.73,0:13:39.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu karena kemampuan.
Dialogue: 0,0:13:39.27,0:13:40.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudmu?
Dialogue: 0,0:13:41.48,0:13:46.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pasti sudah lelah\Nsetelah lari pagi tadi.
Dialogue: 0,0:13:47.24,0:13:50.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tetap menantangnya\Nkarena mengira bisa menang.
Dialogue: 0,0:13:50.28,0:13:52.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini juga untuk mengukur kemampuanku.
Dialogue: 0,0:13:52.74,0:13:55.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu kebiasaan burukmu.
Dialogue: 0,0:13:55.16,0:13:56.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitukah?
Dialogue: 0,0:13:56.75,0:14:00.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada hal yang bisa kau capai\Njika mengerahkan segalanya.
Dialogue: 0,0:14:02.75,0:14:05.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutku itu tak akan mengubah\Nhasil kali ini.
Dialogue: 0,0:14:06.92,0:14:08.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:14:23.65,0:14:24.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berangkat.
Dialogue: 0,0:14:41.17,0:14:42.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:14:43.92,0:14:45.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Chinatsu?
Dialogue: 0,0:14:45.59,0:14:47.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau di sini?
Dialogue: 0,0:14:47.76,0:14:48.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Latihannya bagaimana?
Dialogue: 0,0:14:48.84,0:14:51.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ada urusan mendadak!
Dialogue: 0,0:14:51.84,0:14:53.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bolos.
Dialogue: 0,0:14:54.85,0:14:57.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sebaiknya aku tak memberitahunya\Nsoal Yumeka, 'kan?{\i0}
Dialogue: 0,0:15:06.03,0:15:07.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:15:07.11,0:15:09.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika keringatmu tak diseka,\Nnanti kau flu lagi.
Dialogue: 0,0:15:10.40,0:15:12.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi itu handukmu.
Dialogue: 0,0:15:12.16,0:15:14.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini masih baru. Tenang saja.
Dialogue: 0,0:15:14.58,0:15:16.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya tenang...
Dialogue: 0,0:15:20.58,0:15:22.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong jangan berekspresi seperti itu.
Dialogue: 0,0:15:28.76,0:15:30.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini, silakan pakai juga.
Dialogue: 0,0:15:34.55,0:15:36.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau meniruku?
Dialogue: 0,0:15:36.31,0:15:37.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:15:38.97,0:15:41.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah menerima banyak hal darimu.
Dialogue: 0,0:15:41.73,0:15:43.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesekali aku harus membalas budi.
Dialogue: 0,0:15:48.61,0:15:50.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berikutnya kau akan memberikanku apa?
Dialogue: 0,0:15:52.20,0:15:53.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bercanda.
Dialogue: 0,0:15:56.66,0:16:00.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma bercanda! Jangan terlalu dipikirkan!
Dialogue: 0,0:16:00.96,0:16:03.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku juga sudah menerima\Nbanyak hal darinya.{\i0}
Dialogue: 0,0:16:03.58,0:16:04.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:16:06.00,0:16:08.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}setiap kau sedang kesulitan,
Dialogue: 0,0:16:08.75,0:16:10.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan ada di sisimu.
Dialogue: 0,0:16:20.43,0:16:22.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, kau sudah berjanji.
Dialogue: 0,0:16:23.19,0:16:25.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menagihnya.
Dialogue: 0,0:16:27.52,0:16:28.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Boleh saja.
Dialogue: 0,0:16:30.36,0:16:31.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketika waktunya tiba,
Dialogue: 0,0:16:32.40,0:16:36.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}entah ke konser, ke pantai, ke mana saja.{\i0}
Dialogue: 0,0:16:36.99,0:16:38.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku akan pergi bersamamu.{\i0}
Dialogue: 0,0:16:54.47,0:16:57.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiba-tiba sudah 23 Desember?
Dialogue: 0,0:16:57.22,0:16:59.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau juga mengatakan itu\Npada awal Desember.
Dialogue: 0,0:16:59.35,0:17:00.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana ini?
Dialogue: 0,0:17:00.64,0:17:03.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kali terakhir aku jomlo waktu Natal\Nadalah saat kelas lima!
Dialogue: 0,0:17:03.81,0:17:05.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau terlalu dewasa.
Dialogue: 0,0:17:05.10,0:17:08.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau bisa tenang? Kau juga jomlo.
Dialogue: 0,0:17:08.11,0:17:10.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kenapa kau tidak panik?\N- Aku tak perlu panik.
Dialogue: 0,0:17:11.73,0:17:14.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku merayakannya\Nbersama keluargaku setiap tahun.
Dialogue: 0,0:17:15.07,0:17:18.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku punya tiga saudara, jadi memasak\Ndan menyiapkannya merepotkan.
Dialogue: 0,0:17:18.70,0:17:19.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiga saudara?
Dialogue: 0,0:17:20.28,0:17:22.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Tahun lalu,\Nkami bahkan membeli dua jenis kue.
Dialogue: 0,0:17:26.00,0:17:28.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba rayakan bersama keluargamu.
Dialogue: 0,0:17:28.00,0:17:31.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakakku selalu ada urusan setiap tahun.
Dialogue: 0,0:17:32.71,0:17:34.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tak mengutamakan keluarganya!
Dialogue: 0,0:17:34.59,0:17:35.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayame!
Dialogue: 0,0:17:37.13,0:17:38.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah latihan besok,
Dialogue: 0,0:17:38.39,0:17:41.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami mau pergi karaoke.
Dialogue: 0,0:17:41.18,0:17:42.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo ikut.
Dialogue: 0,0:17:43.02,0:17:44.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hina!
Dialogue: 0,0:17:45.56,0:17:48.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teman memang yang paling berharga!
Dialogue: 0,0:17:48.90,0:17:50.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Musikal Hina luar biasa.
Dialogue: 0,0:17:50.73,0:17:51.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:17:55.32,0:17:58.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malam Natal itu tidak penting, 'kan?
Dialogue: 0,0:18:00.82,0:18:03.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo berlatih!
Dialogue: 0,0:18:05.04,0:18:07.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taiki, kau mau ikut?
Dialogue: 0,0:18:08.79,0:18:11.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Besok kami mau pergi karaoke.
Dialogue: 0,0:18:15.84,0:18:16.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:18:17.34,0:18:20.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berjanji akan berlatih\Nbersama Kak Nishida.
Dialogue: 0,0:18:20.89,0:18:23.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya besok\NMalam Melatih Otot khusus lelaki.
Dialogue: 0,0:18:24.85,0:18:25.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitukah?
Dialogue: 0,0:18:26.81,0:18:30.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lupakan si penggila otot ini!\NAyo bergembira sepuasnya!
Dialogue: 0,0:18:30.23,0:18:31.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ide bagus!
Dialogue: 0,0:18:31.94,0:18:33.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pandai menyanyi?
Dialogue: 0,0:18:33.90,0:18:36.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat Hina menyanyi,\Nkau bisa melihat panggung.
Dialogue: 0,0:18:36.53,0:18:38.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Niina, jangan dilebih-lebihkan.
Dialogue: 0,0:18:39.11,0:18:41.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai jumpa besok.
Dialogue: 0,0:18:43.08,0:18:47.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo tetap fokus\Nuntuk Kejuaraan Musim Dingin Besok!
Dialogue: 0,0:18:47.83,0:18:49.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:18:49.00,0:18:50.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan kalah dengan dinginnya!
Dialogue: 0,0:18:50.87,0:18:51.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:18:51.96,0:18:53.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bakar semangat untuk menang!
Dialogue: 0,0:18:53.92,0:18:55.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:18:55.00,0:18:57.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, Eimei!
Dialogue: 0,0:18:57.17,0:18:58.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:18:58.76,0:19:01.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Besok tim basket perempuan\Nakan bertanding.
Dialogue: 0,0:19:01.09,0:19:02.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari pukul berapa?
Dialogue: 0,0:19:02.22,0:19:03.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin pukul 13.00?
Dialogue: 0,0:19:03.72,0:19:05.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semangat!
Dialogue: 0,0:19:05.89,0:19:07.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih!
Dialogue: 0,0:19:09.02,0:19:10.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Semangat.\N- Terima kasih.
Dialogue: 0,0:19:10.77,0:19:12.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:19:26.29,0:19:28.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Besok bisa bertemu pukul 13.00?
Dialogue: 0,0:19:28.33,0:19:29.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:19:29.91,0:19:31.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk kencan Natal kita.
Dialogue: 0,0:19:31.42,0:19:34.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akan saling membeli hadiah,
Dialogue: 0,0:19:34.00,0:19:36.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menikmati kopi di kafe,
Dialogue: 0,0:19:36.04,0:19:38.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu melihat gemerlap lampu Natal.
Dialogue: 0,0:19:38.13,0:19:39.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bisa pergi ke...
Dialogue: 0,0:19:39.38,0:19:40.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Hei, Sosuke.
Dialogue: 0,0:19:40.92,0:19:44.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika boleh, aku mau\Nkau pakai kaus kaki setinggi lutut.
Dialogue: 0,0:19:44.43,0:19:46.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma bercanda.
Dialogue: 0,0:19:47.10,0:19:48.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau ke kamar mandi.
Dialogue: 0,0:19:48.97,0:19:49.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:20:01.32,0:20:03.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Itu...\N- Apa ini?
Dialogue: 0,0:20:03.95,0:20:06.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiket untuk pertandingan basket SMA besok?
Dialogue: 0,0:20:07.91,0:20:09.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kau harus menontonnya!
Dialogue: 0,0:20:09.08,0:20:11.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis waktu itu akan bertanding, 'kan?
Dialogue: 0,0:20:11.33,0:20:15.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan cemaskan aku.\NKita bisa pergi kencan setelahnya.
Dialogue: 0,0:20:16.21,0:20:18.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa berdiri saja? Duduklah.
Dialogue: 0,0:20:18.25,0:20:19.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:20:20.38,0:20:25.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dulu kau mau menjadi apa saat SD?
Dialogue: 0,0:20:28.76,0:20:30.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Impianku atlet sepak bola.
Dialogue: 0,0:20:30.27,0:20:31.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baru tahu.
Dialogue: 0,0:20:31.81,0:20:34.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga sudah lupa.
Dialogue: 0,0:20:34.60,0:20:38.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya aku menyerah,\Ntapi rasanya seperti sudah memudar.
Dialogue: 0,0:20:39.36,0:20:41.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi bagiku,
Dialogue: 0,0:20:41.36,0:20:44.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sepertinya dulu kau punya\Ntujuan yang jelas,
Dialogue: 0,0:20:45.24,0:20:48.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}jadi sekarang kau kebingungan\Nharus bagaimana.{\i0}
Dialogue: 0,0:20:51.62,0:20:53.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Maksudku,
Dialogue: 0,0:20:53.71,0:20:57.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}saat itu terjadi,\Nkau harus mengupas keropengnya.
Dialogue: 0,0:20:57.04,0:20:58.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengupasnya?
Dialogue: 0,0:20:59.21,0:21:04.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dalam hidup, hal negatif biasanya menempel\Npada hal yang menyenangkan.{\i0}
Dialogue: 0,0:21:07.39,0:21:10.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jika kau mengupasnya satu per satu{\i0}
Dialogue: 0,0:21:10.01,0:21:11.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dan melihat intinya,{\i0}
Dialogue: 0,0:21:13.23,0:21:16.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau pasti akan sadar\Nbahwa kau masih menyukai basket.
Dialogue: 0,0:21:26.53,0:21:30.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin obsesimu bukan hal yang buruk.
Dialogue: 0,0:21:33.16,0:21:34.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat.
Dialogue: 0,0:21:35.41,0:21:39.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biasanya kau memegang ponimu\Nsaat mau menyembunyikan perasaanmu.
Dialogue: 0,0:21:39.88,0:21:41.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Apa?\N- Kau tak sadar?
Dialogue: 0,0:21:43.51,0:21:45.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Ini penuh perjuangan.{\i0}
Dialogue: 0,0:21:46.43,0:21:49.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tapi ada orang\Nyang menanganinya dengan mudah.{\i0}
Dialogue: 0,0:21:50.68,0:21:51.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tak apa-apa berhenti.{\i0}
Dialogue: 0,0:21:52.60,0:21:54.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tak perlu memaksakan diri.{\i0}
Dialogue: 0,0:22:04.44,0:22:05.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tapi...{\i0}
Dialogue: 0,0:22:06.57,0:22:08.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}jangan lupakan kegembiraan itu.{\i0}
Dialogue: 0,0:22:09.45,0:22:11.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Percaya pada hal yang kau cintai.{\i0}
Dialogue: 0,0:22:15.62,0:22:16.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Karena perasaan ini...{\i0}
Dialogue: 0,0:22:18.33,0:22:19.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}menjadikanmu yang terkuat!{\i0}
