Dialogue: 0,0:00:14.18,0:00:16.51,sign,,0000,0000,0000,,{\an8}STASIUN IKEBUKURO
Dialogue: 0,0:01:24.45,0:01:28.63,sign,,0000,0000,0000,,{\an8}BLUE BOX MUSIM 2
Dialogue: 0,0:02:51.04,0:02:52.54,sign,,0000,0000,0000,,STASIUN SHINJUKU
Dialogue: 0,0:02:52.54,0:02:55.55,sign,,0000,0000,0000,,EPISODE 26\NDEJAVU
Dialogue: 0,0:03:07.39,0:03:09.23,sign,,0000,0000,0000,,SPORTS DEPO\NTOKO UTAMA
Dialogue: 0,0:04:09.04,0:04:11.37,sign,,0000,0000,0000,,CUMI-CUMI
Dialogue: 0,0:04:27.30,0:04:29.35,sign,,0000,0000,0000,,TANGKAPAN BESAR
Dialogue: 0,0:04:35.44,0:04:36.40,sign,,0000,0000,0000,,PASTI MENANG
Dialogue: 0,0:04:38.65,0:04:39.48,sign,,0000,0000,0000,,SALAM NERAKA
Dialogue: 0,0:04:41.69,0:04:44.70,sign,,0000,0000,0000,,MEREGANG
Dialogue: 0,0:05:13.77,0:05:16.19,sign,,0000,0000,0000,,KAMAR GANTI
Dialogue: 0,0:16:53.88,0:16:56.30,sign,,0000,0000,0000,,{\an8}BERIKUTNYA - OMOTESANDO
Dialogue: 0,0:18:01.03,0:18:03.12,sign,,0000,0000,0000,,{\an8}SMA - KENCAN - PEMANDANGAN MALAM
Dialogue: 0,0:18:03.12,0:18:04.04,sign,,0000,0000,0000,,{\an8}JALAN-JALAN
Dialogue: 0,0:18:59.72,0:19:00.72,sign,,0000,0000,0000,,PENGHARGAAN
Dialogue: 0,0:00:16.51,0:00:17.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ada orang yang mau kutemui.{\i0}
Dialogue: 0,0:00:25.85,0:00:29.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku Taiki Inomata,\Nmurid kelas satu di SMA Swasta Eimei.{\i0}
Dialogue: 0,0:00:31.40,0:00:35.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku jatuh cinta kepada Kak Chinatsu\Nyang setahun lebih tua dariku.{\i0}
Dialogue: 0,0:00:36.32,0:00:38.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tinggal bersama kita\Nmulai musim semi ini.
Dialogue: 0,0:00:39.70,0:00:40.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon bantuannya.
Dialogue: 0,0:00:42.08,0:00:45.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah menyatakan perasaanku\Nkepada Taiki.
Dialogue: 0,0:00:45.83,0:00:49.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak bisa menjadi pacarmu.
Dialogue: 0,0:00:49.59,0:00:52.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jaket olahraga!\NAku mau beli jaket olahraga!
Dialogue: 0,0:00:52.21,0:00:53.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ini kencan!{\i0}
Dialogue: 0,0:00:54.34,0:00:58.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ini peluangku untuk menyatakan perasaan.{\i0}
Dialogue: 0,0:00:58.05,0:01:01.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Di depan petak bunga.{\i0}
Dialogue: 0,0:03:11.85,0:03:16.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada di bagian badminton\Natau di bagian aparel?
Dialogue: 0,0:03:20.19,0:03:22.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taiki, ayo ke lantai dua.
Dialogue: 0,0:03:22.32,0:03:23.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:03:28.58,0:03:33.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ini kali pertama aku yang mengajaknya.{\i0}
Dialogue: 0,0:03:33.37,0:03:36.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Artinya ini kencan sungguhan pertama kami.{\i0}
Dialogue: 0,0:03:37.38,0:03:39.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat libur nanti,\Nmau pergi bersama ke suatu tempat?
Dialogue: 0,0:03:39.92,0:03:43.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada kafe yang ingin kudatangi.\NBoleh ke sana juga?
Dialogue: 0,0:03:43.84,0:03:45.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kafe!{\i0}
Dialogue: 0,0:03:47.35,0:03:49.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ada berbagai macam olahraga.{\i0}
Dialogue: 0,0:03:50.85,0:03:54.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pakaian olahraganya juga beragam!{\i0}
Dialogue: 0,0:04:04.32,0:04:07.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Gawat, aku terbawa suasana.{\i0}
Dialogue: 0,0:04:07.45,0:04:08.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taiki.
Dialogue: 0,0:04:11.37,0:04:12.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau yang ini bagaimana?
Dialogue: 0,0:04:15.42,0:04:17.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau serius?
Dialogue: 0,0:04:17.04,0:04:18.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serius, serius.
Dialogue: 0,0:04:18.38,0:04:21.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kau mau pakai itu?\N- Tidak.
Dialogue: 0,0:04:21.17,0:04:23.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, kenapa kau pikir aku mau?
Dialogue: 0,0:04:24.68,0:04:25.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira kau mau.
Dialogue: 0,0:04:31.31,0:04:33.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Suasana santai seperti ini juga seru!{\i0}
Dialogue: 0,0:04:34.52,0:04:35.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini!
Dialogue: 0,0:04:37.69,0:04:38.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini!
Dialogue: 0,0:04:44.70,0:04:46.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau yang ini?
Dialogue: 0,0:04:49.08,0:04:50.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang ini bagus.
Dialogue: 0,0:04:52.20,0:04:53.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutku keren.
Dialogue: 0,0:04:56.04,0:04:59.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada ukuran yang lebih besar\Njika terlalu ketat.
Dialogue: 0,0:05:03.05,0:05:04.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang ini saja.
Dialogue: 0,0:05:04.63,0:05:07.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jaket olahraga keren, ya?
Dialogue: 0,0:05:08.22,0:05:10.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin aku juga akan beli kaus.
Dialogue: 0,0:05:11.10,0:05:12.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku coba pakai dulu.
Dialogue: 0,0:05:12.85,0:05:13.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:05:18.77,0:05:22.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tak apa-apa aku menunggu\Ntepat di depan kamar ganti?{\i0}
Dialogue: 0,0:05:22.78,0:05:26.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tapi mungkin dia mau\Nmemperlihatkannya kepadaku.{\i0}
Dialogue: 0,0:05:26.82,0:05:29.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jadi, sebaiknya aku tetap dekat.{\i0}
Dialogue: 0,0:05:35.20,0:05:37.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ukurannya pas sekali.{\i0}
Dialogue: 0,0:05:38.21,0:05:39.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku akan coba tanya Taiki.{\i0}
Dialogue: 0,0:05:40.84,0:05:41.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:05:41.92,0:05:44.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Inomata!
Dialogue: 0,0:05:44.67,0:05:46.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yokomura…
Dialogue: 0,0:05:46.05,0:05:47.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kebetulan sekali.
Dialogue: 0,0:05:47.47,0:05:49.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau beli pakaian voli?
Dialogue: 0,0:05:51.43,0:05:53.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepatu wanita?
Dialogue: 0,0:05:54.77,0:05:56.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:05:56.48,0:05:59.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak kusangka. Salut.
Dialogue: 0,0:05:59.27,0:06:00.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semangat, Bung.
Dialogue: 0,0:06:00.27,0:06:01.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan begitu…
Dialogue: 0,0:06:01.77,0:06:04.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan merahasiakannya, tenang saja.
Dialogue: 0,0:06:04.23,0:06:05.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:06:05.23,0:06:08.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku mau pastikan sesuatu.
Dialogue: 0,0:06:08.74,0:06:09.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Apakah Chono orangnya?
Dialogue: 0,0:06:11.82,0:06:12.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:06:13.45,0:06:15.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, ikut campur itu tidak baik.
Dialogue: 0,0:06:15.70,0:06:16.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai jumpa.
Dialogue: 0,0:06:17.96,0:06:20.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Orang pikir kami berpacaran?{\i0}
Dialogue: 0,0:06:21.54,0:06:23.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kami memang akrab.{\i0}
Dialogue: 0,0:06:38.23,0:06:39.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia tak mengenakannya.{\i0}
Dialogue: 0,0:06:40.06,0:06:41.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana?
Dialogue: 0,0:06:41.19,0:06:43.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Sedikit terlalu besar.
Dialogue: 0,0:06:44.44,0:06:46.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:06:46.11,0:06:48.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa aku beli lain kali saja.
Dialogue: 0,0:06:48.86,0:06:51.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, aku bayar ini dulu.
Dialogue: 0,0:06:51.95,0:06:53.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak sabar pergi ke kafe itu.
Dialogue: 0,0:06:54.78,0:06:55.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:07:18.56,0:07:20.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di dekat sini, 'kan?
Dialogue: 0,0:07:20.02,0:07:23.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Aku pernah datang bersama Nagisa.
Dialogue: 0,0:07:23.86,0:07:25.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Rupanya dia sudah pernah datang.{\i0}
Dialogue: 0,0:07:26.44,0:07:30.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutku, pai apelnya pai terlezat\Nyang pernah kumakan.
Dialogue: 0,0:07:31.28,0:07:33.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku mau kau coba juga.
Dialogue: 0,0:07:35.37,0:07:38.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kalau begitu, aku juga mau kau\Nmencoba makan sesuatu.
Dialogue: 0,0:07:38.41,0:07:39.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Ayo pergi lain kali.
Dialogue: 0,0:07:41.29,0:07:42.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Boleh.
Dialogue: 0,0:07:50.84,0:07:52.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang.
Dialogue: 0,0:07:53.80,0:07:54.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dua orang…
Dialogue: 0,0:07:57.01,0:07:58.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sendirian?
Dialogue: 0,0:07:58.14,0:08:00.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mau, ayo mengobrol dengan kami.
Dialogue: 0,0:08:00.35,0:08:01.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Matsuoka?
Dialogue: 0,0:08:04.02,0:08:05.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Natsu!
Dialogue: 0,0:08:08.86,0:08:11.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bertemu di tempat seperti ini\Npasti takdir.
Dialogue: 0,0:08:11.49,0:08:12.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bodoh sekali.
Dialogue: 0,0:08:12.78,0:08:16.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Natsu, silakan duduk di sini.\NKursi satu lagi sudah ditempati.
Dialogue: 0,0:08:17.28,0:08:18.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa?{\i0}
Dialogue: 0,0:08:20.45,0:08:21.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau si fan?
Dialogue: 0,0:08:21.37,0:08:24.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Inomata.\NKau sudah melihatku dari tadi!
Dialogue: 0,0:08:26.33,0:08:29.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kalian bersama?
Dialogue: 0,0:08:33.72,0:08:35.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak boleh begitu, Natsu.
Dialogue: 0,0:08:35.30,0:08:39.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bawa fan kemari\Nkarena kau tak berani ke kafe sendirian.
Dialogue: 0,0:08:39.39,0:08:41.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak masalah datang sendiri.
Dialogue: 0,0:08:41.43,0:08:43.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya, silakan duduk.
Dialogue: 0,0:08:48.27,0:08:49.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pada awalnya,{\i0}
Dialogue: 0,0:08:50.90,0:08:53.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}kukira dia orang yang sangat jahat.{\i0}
Dialogue: 0,0:08:53.61,0:08:54.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ke toilet dulu.
Dialogue: 0,0:08:54.95,0:08:58.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tapi mungkin dia cuma tak peka\Ndan tak bisa membaca suasana.{\i0}
Dialogue: 0,0:09:04.79,0:09:07.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Fan, sekarang kesempatanmu.
Dialogue: 0,0:09:08.17,0:09:09.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:09:10.09,0:09:11.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Pulang sana.
Dialogue: 0,0:09:11.71,0:09:15.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Pulang sana.{\i0}
Dialogue: 0,0:09:15.72,0:09:17.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tidak.{\i0}
Dialogue: 0,0:09:17.72,0:09:22.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia memang jahat!{\i0}
Dialogue: 0,0:09:25.06,0:09:27.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, kau tak paham bahasa Inggris?
Dialogue: 0,0:09:27.73,0:09:30.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku minta kau pergi baik-baik.
Dialogue: 0,0:09:30.98,0:09:33.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Baik-baik?\NItu jelas-jelas kalimat perintah!{\i0}
Dialogue: 0,0:09:34.61,0:09:36.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Seharusnya aku yang mengatakan itu.
Dialogue: 0,0:09:36.90,0:09:41.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku berencana menikmati hari ini\Nberdua dengan Kak Chinatsu.
Dialogue: 0,0:09:41.16,0:09:43.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kau yang mengganggu…\N- Aku kembali.
Dialogue: 0,0:09:45.29,0:09:47.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang, Natsu.
Dialogue: 0,0:09:47.08,0:09:51.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kak Chinatsu, kau harus lihat\Nsifat asli di balik senyuman palsunya!{\i0}
Dialogue: 0,0:09:51.67,0:09:54.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi-lagi ekspresimu mencurigakan.
Dialogue: 0,0:09:54.09,0:09:55.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kejam sekali.
Dialogue: 0,0:09:55.42,0:09:57.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Dia sudah tahu?{\i0}
Dialogue: 0,0:09:57.43,0:09:58.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau pesan apa, Natsu?
Dialogue: 0,0:09:58.84,0:10:00.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pai apel dan teh.
Dialogue: 0,0:10:00.22,0:10:02.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga, kau suka teh.
Dialogue: 0,0:10:02.72,0:10:04.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sering minum teh di kelas.
Dialogue: 0,0:10:04.72,0:10:06.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga tahu itu!
Dialogue: 0,0:10:06.98,0:10:08.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi!
Dialogue: 0,0:10:08.27,0:10:09.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau pesan apa?
Dialogue: 0,0:10:09.60,0:10:10.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau…
Dialogue: 0,0:10:11.31,0:10:12.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Protein?
Dialogue: 0,0:10:12.65,0:10:14.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia terus menyindirku!{\i0}
Dialogue: 0,0:10:15.23,0:10:18.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga mau pai apel dan teh\Nyang Kak Chinatsu rekomendasikan…
Dialogue: 0,0:10:18.36,0:10:22.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi teringat waktu itu saat SMP.
Dialogue: 0,0:10:22.58,0:10:24.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dengarkan aku!{\i0}
Dialogue: 0,0:10:24.04,0:10:27.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seluruh tim basket\Npergi ke kafe setelah latihan.
Dialogue: 0,0:10:27.29,0:10:28.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah mau pesan?
Dialogue: 0,0:10:28.91,0:10:32.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami mau pesan ini dua porsi.
Dialogue: 0,0:10:32.42,0:10:34.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:10:34.09,0:10:35.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi rindu!
Dialogue: 0,0:10:35.88,0:10:38.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita mau pergi ke tempat yang modis.
Dialogue: 0,0:10:38.26,0:10:39.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:10:40.13,0:10:43.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taiki, kau tahu kafe di Nichome itu?
Dialogue: 0,0:10:43.93,0:10:44.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang itu…
Dialogue: 0,0:10:44.85,0:10:48.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu cukup mahal untuk uang saku anak SMP.
Dialogue: 0,0:10:48.68,0:10:51.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Nagisa memesan espreso\Nkarena mau tampak keren.
Dialogue: 0,0:10:52.77,0:10:54.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Yumeka yang pesan itu.
Dialogue: 0,0:10:58.69,0:10:59.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Suasananya berubah?{\i0}
Dialogue: 0,0:10:59.78,0:11:03.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah? Tapi waktu itu\Nsemuanya kacau saat kita pulang…
Dialogue: 0,0:11:03.82,0:11:05.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Yumeka siapa?{\i0}
Dialogue: 0,0:11:08.33,0:11:10.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah menunggu.
Dialogue: 0,0:11:25.10,0:11:28.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Perpaduan kulit pai renyah\Ndan apel yang manis!{\i0}
Dialogue: 0,0:11:32.85,0:11:34.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong…
Dialogue: 0,0:11:36.69,0:11:38.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak sekali.
Dialogue: 0,0:11:56.71,0:11:58.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang…
Dialogue: 0,0:11:59.46,0:12:00.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau ke mana lagi?
Dialogue: 0,0:12:02.26,0:12:06.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Hei!\N- Karena sudah makan, mau main boling?
Dialogue: 0,0:12:08.89,0:12:11.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, ada yang tertinggal di kafe.\NAku ambil dulu.
Dialogue: 0,0:12:15.27,0:12:17.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Padahal kami sudah berduaan{\i0}…
Dialogue: 0,0:12:30.20,0:12:31.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:12:31.12,0:12:33.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia jelas sengaja.{\i0}
Dialogue: 0,0:12:33.16,0:12:34.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengar.
Dialogue: 0,0:12:35.79,0:12:38.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau yakin\Npunya waktu untuk bermesraan?
Dialogue: 0,0:12:45.01,0:12:49.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah kau\Nbaru dikalahkan Haryu tempo hari?
Dialogue: 0,0:12:49.47,0:12:50.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan cuma dikalahkan dia.
Dialogue: 0,0:12:51.39,0:12:53.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, bagiku kelihatannya
Dialogue: 0,0:12:53.14,0:12:56.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau tak lebih hebat\Ndaripada anggota timmu yang lain.
Dialogue: 0,0:12:57.40,0:13:00.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku sangat jago basket,
Dialogue: 0,0:13:00.57,0:13:03.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi aku bisa seimbangkan keduanya\Ndengan mudah.
Dialogue: 0,0:13:05.36,0:13:06.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa lakukan keduanya.
Dialogue: 0,0:13:09.78,0:13:11.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:13:16.42,0:13:17.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf sudah menunggu!
Dialogue: 0,0:13:18.29,0:13:19.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak masalah.
Dialogue: 0,0:13:23.13,0:13:25.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ucapannya sangat menusuk.{\i0}
Dialogue: 0,0:13:25.93,0:13:27.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku sampai berkeringat dingin.{\i0}
Dialogue: 0,0:13:28.26,0:13:31.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tapi aku sudah memutuskan\Ntak akan membiarkan rasa takut{\i0}
Dialogue: 0,0:13:32.43,0:13:34.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}menahanku lagi.{\i0}
Dialogue: 0,0:13:34.64,0:13:36.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, Matsuoka…
Dialogue: 0,0:13:36.64,0:13:38.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebentar, ada pesan.
Dialogue: 0,0:13:39.86,0:13:41.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pas sekali!
Dialogue: 0,0:13:41.69,0:13:46.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenalanku dari Universitas Yusei\Nsedang bermain basket.
Dialogue: 0,0:13:46.28,0:13:47.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo ikut, Natsu!
Dialogue: 0,0:13:48.16,0:13:49.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:13:52.28,0:13:55.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tim basket Universitas Yusei kuat,
Dialogue: 0,0:13:55.12,0:13:56.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi kau bisa belajar banyak.
Dialogue: 0,0:13:57.46,0:13:58.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi…
Dialogue: 0,0:14:00.63,0:14:03.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya aku boleh ajak siapa saja.
Dialogue: 0,0:14:04.92,0:14:06.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya kau pergi!
Dialogue: 0,0:14:09.30,0:14:13.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bisa belajar banyak\Ndari berlatih bersama mahasiswa!
Dialogue: 0,0:14:13.97,0:14:15.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak perlu mengkhawatirkanku!
Dialogue: 0,0:14:16.56,0:14:19.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, aku juga mau pulang\Ndan berlatih!
Dialogue: 0,0:14:23.32,0:14:24.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sendiri bilang begitu.
Dialogue: 0,0:14:24.78,0:14:26.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo pergi!
Dialogue: 0,0:14:27.53,0:14:30.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ayo.\N- Tapi…
Dialogue: 0,0:14:30.03,0:14:31.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke sini.
Dialogue: 0,0:14:33.16,0:14:34.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai jumpa!
Dialogue: 0,0:14:35.58,0:14:37.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bukan melakukannya demi kau!
Dialogue: 0,0:14:57.35,0:15:00.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku masih mau jalan-jalan bersamanya,{\i0}
Dialogue: 0,0:15:03.77,0:15:06.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}tapi aku juga mau mendukungnya\Ndalam basket.{\i0}
Dialogue: 0,0:15:09.11,0:15:11.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku tahu bertengkar dengan si Matsu itu…{\i0}
Dialogue: 0,0:15:16.58,0:15:19.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}tak akan membantu Kak Chinatsu.{\i0}
Dialogue: 0,0:15:45.86,0:15:48.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira kau sudah naik kereta itu.
Dialogue: 0,0:15:48.57,0:15:50.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ke toilet dulu.
Dialogue: 0,0:15:51.95,0:15:54.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tak jadi ke latihan basket itu?
Dialogue: 0,0:15:57.79,0:16:01.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah kupikir-pikir,\Nternyata aku tak bawa pakaian ganti.
Dialogue: 0,0:16:08.55,0:16:10.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, ayo pulang bersama!
Dialogue: 0,0:16:14.47,0:16:15.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Senang sekali.{\i0}
Dialogue: 0,0:16:16.39,0:16:18.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku senang dia kembali.{\i0}
Dialogue: 0,0:16:18.81,0:16:20.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku senang kami bisa pulang bersama.{\i0}
Dialogue: 0,0:16:21.81,0:16:26.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tapi meski aku senang,\Nmasih banyak yang harus kulakukan.{\i0}
Dialogue: 0,0:16:26.81,0:16:28.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Nagisa.
Dialogue: 0,0:16:29.40,0:16:31.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menemukan ini saat bersih-bersih.
Dialogue: 0,0:16:31.86,0:16:33.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nomor empat ini siapa?
Dialogue: 0,0:16:33.95,0:16:35.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia?
Dialogue: 0,0:16:36.45,0:16:37.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yumeka Kido.
Dialogue: 0,0:16:41.75,0:16:44.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pai apel tadi sangat enak, ya?
Dialogue: 0,0:16:44.67,0:16:46.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang terlezat yang pernah kumakan!
Dialogue: 0,0:16:47.42,0:16:48.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah.
Dialogue: 0,0:16:48.84,0:16:50.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini terasa sangat cepat.
Dialogue: 0,0:16:51.55,0:16:53.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:16:57.93,0:16:59.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Chinatsu.
Dialogue: 0,0:16:59.39,0:17:02.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau pergi ke tempat lain dulu\Nsebelum pulang?
Dialogue: 0,0:17:09.65,0:17:13.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku tahu tempat sempurna\Nsaat sore seperti ini.{\i0}
Dialogue: 0,0:17:27.42,0:17:29.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Indahnya.
Dialogue: 0,0:17:29.63,0:17:31.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita datang pada waktu yang tepat.
Dialogue: 0,0:17:32.84,0:17:36.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, rasanya seperti waktu melambat.
Dialogue: 0,0:17:38.09,0:17:39.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Andai waktu bisa berhenti!{\i0}
Dialogue: 0,0:17:42.68,0:17:44.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar indah.
Dialogue: 0,0:17:44.60,0:17:46.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:17:52.65,0:17:54.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku agak terkejut.
Dialogue: 0,0:17:54.19,0:17:55.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:17:55.19,0:17:58.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak menyangka\Nkau tahu tempat seperti ini.
Dialogue: 0,0:17:59.70,0:18:01.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku…
Dialogue: 0,0:18:04.04,0:18:06.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Karena aku meneliti berjam-jam!{\i0}
Dialogue: 0,0:18:06.12,0:18:08.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Jangan-jangan kau…\N- Ya?
Dialogue: 0,0:18:09.54,0:18:10.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}…datang dengan gadis lain?
Dialogue: 0,0:18:10.92,0:18:13.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak!
Dialogue: 0,0:18:13.30,0:18:15.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini kali pertama aku kemari,
Dialogue: 0,0:18:15.88,0:18:18.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku sangat cemas kita tersesat\Nsaat ke sini.
Dialogue: 0,0:18:26.14,0:18:28.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku juga baru pertama kali ke sini.
Dialogue: 0,0:18:29.90,0:18:34.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai sekarang, kukira menongkrong\Nsama seperti bermalas-malasan.
Dialogue: 0,0:18:36.90,0:18:38.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Yumeka siapa?{\i0}
Dialogue: 0,0:18:38.32,0:18:41.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa kalian tak tahu\Njika baru masuk Eimei saat SMA.
Dialogue: 0,0:18:43.58,0:18:47.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Begitu saja kau tak bisa?
Dialogue: 0,0:18:47.33,0:18:49.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian tak mungkin tahu\Nlatihan Sparta Yumeka
Dialogue: 0,0:18:49.83,0:18:51.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan sarkasmenya!
Dialogue: 0,0:18:52.58,0:18:54.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Tapi dia benar-benar genius.
Dialogue: 0,0:18:55.42,0:18:57.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia dan Chinatsu sangat cocok{\i0}
Dialogue: 0,0:18:57.63,0:18:59.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}karena mereka bermain bersama sejak kecil.{\i0}
Dialogue: 0,0:19:01.34,0:19:02.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:19:02.68,0:19:03.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi…
Dialogue: 0,0:19:03.60,0:19:06.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, dia berhenti bermain saat SMP.
Dialogue: 0,0:19:07.22,0:19:08.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tanpa mengatakan apa pun.{\i0}
Dialogue: 0,0:19:09.94,0:19:12.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia berhenti dari sekolah kita dan basket.
Dialogue: 0,0:19:23.16,0:19:24.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau kedinginan?
Dialogue: 0,0:19:24.78,0:19:26.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, aku tak apa-apa.
Dialogue: 0,0:19:28.87,0:19:30.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini, pakailah.
Dialogue: 0,0:19:30.91,0:19:34.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jaket olahraga yang baru kubeli\Nseharusnya menahan angin.
Dialogue: 0,0:19:34.75,0:19:37.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya aku masih punya\Npenghangat tangan.
Dialogue: 0,0:19:37.30,0:19:39.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibuku menyuruhku membawanya.
Dialogue: 0,0:19:39.13,0:19:42.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya ada di sini…
Dialogue: 0,0:19:47.26,0:19:48.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:19:51.89,0:19:54.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya dejavu.
Dialogue: 0,0:19:57.44,0:20:00.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei! Silakan pakai ini jika mau!
Dialogue: 0,0:20:00.82,0:20:02.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini baru dicuci!
Dialogue: 0,0:20:03.95,0:20:06.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu… ini teh hangat.
Dialogue: 0,0:20:06.74,0:20:09.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Termos ini menjaganya tetap hangat\Ndengan baik.
Dialogue: 0,0:20:09.37,0:20:11.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu ada sarung tangan\Ndan penghangat saku!
Dialogue: 0,0:20:12.46,0:20:14.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini menghangat jika dikocok…
Dialogue: 0,0:20:17.46,0:20:19.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika diingat, kau pasti jijik.
Dialogue: 0,0:20:19.88,0:20:24.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Adik kelas yang tak kau kenal\Ntiba-tiba menyodorkan syalnya.
Dialogue: 0,0:20:24.01,0:20:25.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejujurnya, aku terkejut.
Dialogue: 0,0:20:25.55,0:20:26.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:20:29.89,0:20:32.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Tapi aku tidak jijik.
Dialogue: 0,0:20:33.19,0:20:37.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Karena meski kita belum pernah bicara,\Naku melihatmu setiap pagi.
Dialogue: 0,0:20:42.44,0:20:44.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah tahu kau pasti
Dialogue: 0,0:20:44.99,0:20:49.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}orang yang benar-benar jujur\Ndan pekerja keras, serta berintegritas.
Dialogue: 0,0:20:58.46,0:21:01.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berikutnya, kau mau membawakanku apa lagi?
Dialogue: 0,0:21:10.35,0:21:11.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Cuma bercanda.
Dialogue: 0,0:21:17.85,0:21:19.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak ada yang bisa kuberikan kepadamu,
Dialogue: 0,0:21:19.77,0:21:21.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi…
Dialogue: 0,0:21:22.90,0:21:25.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ada yang mau kusampaikan kepadamu.
Dialogue: 0,0:21:27.91,0:21:29.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Natsu?
Dialogue: 0,0:21:38.04,0:21:39.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yumeka.
Dialogue: 0,0:21:40.54,0:21:42.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tunggu, nama itu…{\i0}
Dialogue: 0,0:21:43.46,0:21:45.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:21:45.05,0:21:47.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serius?
Dialogue: 0,0:21:48.64,0:21:51.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau juga punya pacar?
Dialogue: 0,0:21:51.05,0:21:53.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, aku bukan pacarnya.
Dialogue: 0,0:21:55.14,0:21:56.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:21:57.81,0:22:00.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau cuma peduli pada basket.
Dialogue: 0,0:22:00.81,0:22:04.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak kusangka Natsu juga berkencan.
Dialogue: 0,0:22:08.53,0:22:09.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu…
Dialogue: 0,0:22:12.12,0:22:14.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau pasti sudah menyerah dengan basket.
Dialogue: 0,0:23:48.92,0:23:53.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Terjemahan subtitle oleh Sudirman Lius
