Dialogue: 0,0:01:44.10,0:01:47.60,sign,,0000,0000,0000,,EPISODE 32\NADA YANG HARUS KUKATAKAN KEPADAMU
Dialogue: 0,0:02:45.70,0:02:48.50,sign,,0000,0000,0000,,IBU\NCHINATSU! SELAMAT TAHUN BARU!
Dialogue: 0,0:02:56.84,0:02:58.26,sign,,0000,0000,0000,,AYAH\NBAGAIMANA TEMPAT KAKEKMU?
Dialogue: 0,0:03:05.72,0:03:07.39,sign,,0000,0000,0000,,CHINATSU KANO\NSELAMAT TAHUN BARU!
Dialogue: 0,0:03:08.47,0:03:10.77,sign,,0000,0000,0000,,DI SINI TURUN SALJU.\NMENGGALINYA JADI OLAHRAGA…
Dialogue: 0,0:03:18.36,0:03:20.90,sign,,0000,0000,0000,,KAK NISHIDA\NAYO PERGI KE KUIL!
