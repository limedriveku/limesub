Dialogue: 0,0:01:48.27,0:01:50.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu…
Dialogue: 0,0:01:51.48,0:01:53.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa yang memperlambat permainan?
Dialogue: 0,0:01:53.53,0:01:54.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jelas Kakek.
Dialogue: 0,0:01:55.82,0:01:57.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tiap tahun seperti ini.{\i0}
Dialogue: 0,0:01:57.74,0:02:00.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kami main kartu sambil menyalakan TV\Nwalau tak ditonton.{\i0}
Dialogue: 0,0:02:01.41,0:02:04.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tiap Malam Tahun Baru selalu begini.{\i0}
Dialogue: 0,0:02:05.41,0:02:07.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apakah kejadian Malam Natal waktu itu{\i0}
Dialogue: 0,0:02:07.75,0:02:11.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}atau tinggal bersamanya saat ini\Ncuma mimpi?{\i0}
Dialogue: 0,0:02:13.42,0:02:14.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tapi ini bukan mimpi.{\i0}
Dialogue: 0,0:02:15.71,0:02:17.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau tidak suka?
Dialogue: 0,0:02:19.05,0:02:21.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku belum sempat\Nbicara dengannya sejak itu.{\i0}
Dialogue: 0,0:02:24.14,0:02:24.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lewat.
Dialogue: 0,0:02:25.06,0:02:27.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hore, kartuku habis!
Dialogue: 0,0:02:30.44,0:02:32.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku akan kirim pesan "Selamat Tahun Baru."{\i0}
Dialogue: 0,0:02:33.44,0:02:35.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah hampir waktunya.
Dialogue: 0,0:02:36.44,0:02:38.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Enam, lima…{\i0}
Dialogue: 0,0:02:38.44,0:02:39.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Lalu…{\i0}
Dialogue: 0,0:02:39.65,0:02:42.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tiga, dua, satu.{\i0}
Dialogue: 0,0:02:42.53,0:02:44.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Selamat Tahun Baru!{\i0}
Dialogue: 0,0:02:44.66,0:02:45.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:02:49.08,0:02:51.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chinatsu pasti sedang di Nagano.
Dialogue: 0,0:02:51.62,0:02:53.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga keluarganya senang\Nberkumpul bersama.
Dialogue: 0,0:02:53.79,0:02:56.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kenapa malah Ibu\Nyang mengirim pesan lebih dulu?{\i0}
Dialogue: 0,0:03:00.26,0:03:01.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mereka mengirim pesan di grup,{\i0}
Dialogue: 0,0:03:01.84,0:03:04.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}rasanya jadi canggung jika aku\Nmengirim pesan pribadi.{\i0}
Dialogue: 0,0:03:12.02,0:03:13.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bahkan saat dia jauh,{\i0}
Dialogue: 0,0:03:14.36,0:03:16.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}aku tetap senang seperti ini.{\i0}
Dialogue: 0,0:03:26.91,0:03:28.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu dia!
Dialogue: 0,0:03:29.00,0:03:31.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya kau datang, Taiki!
Dialogue: 0,0:03:32.46,0:03:34.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syalku baru ketemu.
Dialogue: 0,0:03:34.50,0:03:36.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lama tak berjumpa, Karen.
Dialogue: 0,0:03:36.79,0:03:38.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tampak lebih tinggi.
Dialogue: 0,0:03:38.38,0:03:40.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Apa?\N- Benarkah?
Dialogue: 0,0:03:40.38,0:03:42.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bertemu dengannya tiap hari.
Dialogue: 0,0:03:44.64,0:03:47.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah makin dewasa.
Dialogue: 0,0:03:48.01,0:03:49.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:03:52.10,0:03:54.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, cepat jalan!
Dialogue: 0,0:04:00.86,0:04:03.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu. Aku mau beli minuman.
Dialogue: 0,0:04:06.57,0:04:07.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kutraktir.
Dialogue: 0,0:04:08.58,0:04:09.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:04:10.41,0:04:14.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena adik-adikku sangat suka\Nkukis pemberianmu saat Natal.
Dialogue: 0,0:04:31.81,0:04:33.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ramai sekali.
Dialogue: 0,0:04:33.64,0:04:35.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Antreannya pasti lama.
Dialogue: 0,0:04:45.07,0:04:49.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku mendoakan kesehatan, badminton,\Nasmara, nilaiku, dan perdamaian dunia.{\i0}
Dialogue: 0,0:04:50.74,0:04:52.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kumohon,{\i0}
Dialogue: 0,0:04:52.08,0:04:56.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}semoga tahun ini\Naku bisa makin dekat dengan tujuanku.{\i0}
Dialogue: 0,0:04:59.09,0:05:02.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktunya kertas ramalan!
Dialogue: 0,0:05:04.47,0:05:06.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}"Sial"?
Dialogue: 0,0:05:06.22,0:05:08.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan terus ambil\Nsampai dapat Sangat Mujur!
Dialogue: 0,0:05:08.93,0:05:10.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya boleh?
Dialogue: 0,0:05:10.18,0:05:12.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada aturannya.
Dialogue: 0,0:05:16.60,0:05:19.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Sangat Sial?{\i0}
Dialogue: 0,0:05:19.11,0:05:22.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berikutnya pasti Sangat Mujur!
Dialogue: 0,0:05:22.61,0:05:24.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Yang kedua, Lumayan Mujur.{\i0}
Dialogue: 0,0:05:24.61,0:05:27.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Yang ketiga, Tidak Pasti.{\i0}
Dialogue: 0,0:05:28.16,0:05:29.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Yang keempat!{\i0}
Dialogue: 0,0:05:31.78,0:05:33.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}"Sangat Mujur"!{\i0}
Dialogue: 0,0:05:39.54,0:05:42.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}"Asmara… Jangan ragu."{\i0}
Dialogue: 0,0:05:46.97,0:05:49.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau dapat apa, Hinacchi?
Dialogue: 0,0:05:50.89,0:05:52.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Jreng!
Dialogue: 0,0:05:53.72,0:05:54.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kalau kau?
Dialogue: 0,0:05:55.18,0:05:58.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma peduli ramalan soal asmaraku.
Dialogue: 0,0:05:58.64,0:06:01.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Asmara… Jalanmu penuh duri."
Dialogue: 0,0:06:04.15,0:06:06.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau ambil lagi!
Dialogue: 0,0:06:07.20,0:06:09.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sangat Mujur!{\i0}
Dialogue: 0,0:06:12.08,0:06:13.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan begitu!
Dialogue: 0,0:06:14.16,0:06:17.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktunya beli makanan!
Dialogue: 0,0:06:18.16,0:06:20.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo minum {\i1}amazake!{\i0}
Dialogue: 0,0:06:20.08,0:06:22.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sampai tersesat.
Dialogue: 0,0:06:30.18,0:06:31.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:06:32.10,0:06:34.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya kau menyeret kakimu.
Dialogue: 0,0:06:34.89,0:06:37.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi ada yang menginjak\Npergelangan kakiku.
Dialogue: 0,0:06:38.48,0:06:40.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya lecet.
Dialogue: 0,0:06:40.56,0:06:43.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bawa plester.\NKita bisa tempel dulu di sana.
Dialogue: 0,0:06:43.86,0:06:45.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi yang lain…
Dialogue: 0,0:06:48.74,0:06:49.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Moriya.
Dialogue: 0,0:06:50.66,0:06:53.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beri tahu mereka kami akan menyusul.
Dialogue: 0,0:06:54.53,0:06:56.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:07:03.58,0:07:06.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku terpisah.{\i0}
Dialogue: 0,0:07:06.09,0:07:11.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak satu pun kakak kelas memeriksa\Napakah kami mengikuti di belakang.
Dialogue: 0,0:07:12.43,0:07:13.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku kirim pesan saja.{\i0}
Dialogue: 0,0:07:21.81,0:07:22.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Hei!{\i0}
Dialogue: 0,0:07:23.48,0:07:25.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Selamat Tahun Baru, Chii!
Dialogue: 0,0:07:26.15,0:07:29.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Jangan tiba-tiba meneleponku lewat video.{\i0}
Dialogue: 0,0:07:30.11,0:07:33.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus mengucapkan "Selamat Tahun Baru"\Ntatap muka denganmu.
Dialogue: 0,0:07:34.74,0:07:37.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami pergi ke kuil bersama.
Dialogue: 0,0:07:37.99,0:07:38.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat?
Dialogue: 0,0:07:44.33,0:07:45.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:07:45.33,0:07:47.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taiki sudah hilang sejak tadi.
Dialogue: 0,0:07:47.92,0:07:50.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Padahal kuharap mereka bisa bertatap muka.{\i0}
Dialogue: 0,0:07:53.38,0:07:55.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kalian sudah ambil kertas ramalan?
Dialogue: 0,0:07:55.30,0:07:56.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pas sekali!{\i0}
Dialogue: 0,0:07:58.89,0:08:00.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau baru dapat pesan?
Dialogue: 0,0:08:00.81,0:08:02.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa telepon nanti kalau kau sibuk.
Dialogue: 0,0:09:17.18,0:09:19.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rupanya kau di sini.
Dialogue: 0,0:09:20.01,0:09:22.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi terlambat, lalu kau tersesat.\NLancang sekali.
Dialogue: 0,0:09:22.97,0:09:24.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:09:24.73,0:09:27.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan terlambat untuk main ski\Ntanggal 4 dan 5.
Dialogue: 0,0:09:27.27,0:09:29.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan atur 20 alarm.
Dialogue: 0,0:09:30.44,0:09:32.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kyo dan Hina mana?
Dialogue: 0,0:09:35.99,0:09:37.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian juga terpisah?
Dialogue: 0,0:09:37.41,0:09:39.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, kami ada urusan sendiri.
Dialogue: 0,0:09:39.82,0:09:42.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini masalahnya\Ndengan atlet olahraga individual.
Dialogue: 0,0:09:42.45,0:09:43.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar sekali.
Dialogue: 0,0:09:43.66,0:09:46.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Yang mirip selalu berkumpul."
Dialogue: 0,0:09:46.25,0:09:47.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, aku juga dihitung?
Dialogue: 0,0:09:51.79,0:09:54.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Dah!\N- Sampai jumpa saat latihan!
Dialogue: 0,0:10:00.39,0:10:04.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti berat mengelola orang-orang\Nyang suka berkegiatan sendiri.
Dialogue: 0,0:10:04.22,0:10:05.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hebat, 'kan?
Dialogue: 0,0:10:06.23,0:10:08.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata kau bisa mengurus orang.
Dialogue: 0,0:10:08.48,0:10:10.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudmu "ternyata"?
Dialogue: 0,0:10:10.35,0:10:13.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hati-hati, orang sepertimu\Ncenderung terpikat oleh pecundang.
Dialogue: 0,0:10:13.40,0:10:16.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah tahu.
Dialogue: 0,0:10:16.19,0:10:20.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi anak berkacamata itu sepertinya baik.
Dialogue: 0,0:10:20.99,0:10:22.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudmu Kasahara?
Dialogue: 0,0:10:22.83,0:10:24.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau menyukainya, 'kan?
Dialogue: 0,0:10:24.54,0:10:27.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tampak sangat cemburu\Nmelihatnya bersama Hina.
Dialogue: 0,0:10:27.71,0:10:29.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin!
Dialogue: 0,0:10:29.46,0:10:33.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku lebih suka pria keren\Nyang super menawan.{\i0}
Dialogue: 0,0:10:38.30,0:10:40.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ekspresiku begitu{\i0}
Dialogue: 0,0:10:40.64,0:10:43.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}karena aku tahu perasaan Hinacchi.{\i0}
Dialogue: 0,0:10:43.85,0:10:46.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mungkin Kasahara…{\i0}
Dialogue: 0,0:10:48.31,0:10:50.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin begitu.
Dialogue: 0,0:10:51.19,0:10:52.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:10:53.23,0:10:55.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah kalau begitu.
Dialogue: 0,0:11:07.12,0:11:07.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya lezat.
Dialogue: 0,0:11:08.04,0:11:10.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kerjaku bagus, 'kan?\N- Ya.
Dialogue: 0,0:11:10.96,0:11:12.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang.
Dialogue: 0,0:11:12.63,0:11:14.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ini!\N- Jalannya diperbaiki.
Dialogue: 0,0:11:14.17,0:11:15.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Benar, 'kan?\N- Makasih.
Dialogue: 0,0:11:17.30,0:11:18.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Ayo ke sungai!
Dialogue: 0,0:11:18.63,0:11:19.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}- Boleh!\N- Tunggu!
Dialogue: 0,0:11:19.59,0:11:21.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Ayo ke taman di sana.
Dialogue: 0,0:11:34.77,0:11:37.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Rasanya waktu sangat lambat.{\i0}
Dialogue: 0,0:11:42.15,0:11:45.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kak Chinatsu baru pulang tanggal 6.{\i0}
Dialogue: 0,0:11:45.57,0:11:48.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Meski pergi bermain ski\Nbersama tim badminton tanggal 4 dan 5,{\i0}
Dialogue: 0,0:11:48.74,0:11:50.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}itu masih empat hari lagi.{\i0}
Dialogue: 0,0:11:52.62,0:11:54.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku sangat merindukannya.{\i0}
Dialogue: 0,0:11:59.67,0:12:02.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mungkin aku tak mau bertemu dengannya.{\i0}
Dialogue: 0,0:12:02.97,0:12:05.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Karena saat kami bertemu nanti…{\i0}
Dialogue: 0,0:12:11.10,0:12:12.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau pergi lari.
Dialogue: 0,0:12:15.15,0:12:18.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal istirahat beberapa hari saja\Ntak apa-apa.
Dialogue: 0,0:12:18.19,0:12:20.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sifatnya memang begitu.
Dialogue: 0,0:13:10.33,0:13:12.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sampai setahun lalu,{\i0}
Dialogue: 0,0:13:12.75,0:13:15.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}kami hampir tak pernah mengobrol.{\i0}
Dialogue: 0,0:13:17.96,0:13:19.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Lalu, tiba-tiba saja…{\i0}
Dialogue: 0,0:14:17.56,0:14:19.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pagi, Taiki!{\i0}
Dialogue: 0,0:14:39.12,0:14:40.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pulang.
Dialogue: 0,0:14:42.25,0:14:46.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kartu ucapan hari raya yang kita terima\NIbu taruh di meja.
Dialogue: 0,0:15:04.77,0:15:07.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}"Selamat Tahun Baru!{\i0}
Dialogue: 0,0:15:07.40,0:15:10.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Aku bisa menikmati tahun pelajaran ini{\i0}
Dialogue: 0,0:15:10.65,0:15:13.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}berkat kalian semua, keluarga Inomata."{\i0}
Dialogue: 0,0:15:22.50,0:15:24.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku sangat merindukannya.{\i0}
Dialogue: 0,0:15:25.71,0:15:28.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Membacanya saja\Nmembuatku merasa ingin menemuinya.{\i0}
Dialogue: 0,0:15:29.30,0:15:33.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bahkan saat dia tidak di sini,\Naku terus memikirkannya.{\i0}
Dialogue: 0,0:15:34.80,0:15:37.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kehadirannya saja membuatku bahagia.{\i0}
Dialogue: 0,0:15:39.81,0:15:41.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itulah cinta{\i0}
Dialogue: 0,0:15:41.73,0:15:43.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}yang kurasakan sekarang.{\i0}
Dialogue: 0,0:16:34.24,0:16:36.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapan kau bangun?
Dialogue: 0,0:16:37.37,0:16:38.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah bangun!
Dialogue: 0,0:16:41.45,0:16:42.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat pagi.
Dialogue: 0,0:16:42.79,0:16:44.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat pagi, Chii.
Dialogue: 0,0:16:45.12,0:16:46.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau moci apa?
Dialogue: 0,0:16:46.96,0:16:48.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kacang merah? Kecap asin?
Dialogue: 0,0:16:48.92,0:16:51.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biarkan dia duduk dulu.
Dialogue: 0,0:16:56.47,0:16:57.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat makan.
Dialogue: 0,0:17:02.85,0:17:06.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakek menanam sayurannya sendiri.
Dialogue: 0,0:17:10.90,0:17:13.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau makan banyak.
Dialogue: 0,0:17:14.36,0:17:15.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Habisnya, ini enak.
Dialogue: 0,0:17:16.45,0:17:18.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah mana?
Dialogue: 0,0:17:18.66,0:17:20.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pergi menyapa para tetangga.
Dialogue: 0,0:17:20.99,0:17:23.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Habisnya, dia sudah lama tak kembali.
Dialogue: 0,0:17:23.87,0:17:26.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ceritakan tentangmu, Chii.
Dialogue: 0,0:17:27.00,0:17:28.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana tim basketnya?
Dialogue: 0,0:17:28.92,0:17:30.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana nilaimu?
Dialogue: 0,0:17:31.34,0:17:33.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya lancar.
Dialogue: 0,0:17:33.67,0:17:35.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah punya pacar?
Dialogue: 0,0:17:36.01,0:17:40.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayang, anak zaman sekarang\Ntidak suka pertanyaan seperti itu.
Dialogue: 0,0:17:41.01,0:17:43.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Apa kau tidak cemas?\N- Astaga.
Dialogue: 0,0:17:47.31,0:17:48.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian berdua bertemu
Dialogue: 0,0:17:48.85,0:17:51.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di tempat kerja Nenek, 'kan?
Dialogue: 0,0:17:51.82,0:17:53.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Benar, di penginapan tradisional.{\i0}
Dialogue: 0,0:17:54.03,0:17:58.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kakekmu mengantarkan sayuran tiap pagi.{\i0}
Dialogue: 0,0:17:58.57,0:18:01.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapan Kakek jatuh cinta pada Nenek?
Dialogue: 0,0:18:02.79,0:18:06.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakek-kakek zaman sekarang\Ntidak suka pertanyaan seperti itu.
Dialogue: 0,0:18:06.91,0:18:09.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cerdik sekali!
Dialogue: 0,0:18:10.00,0:18:12.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakek lupa, itu sudah sangat lama.
Dialogue: 0,0:18:12.84,0:18:15.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakek malu-malu kalau membahas soal ini.
Dialogue: 0,0:18:18.76,0:18:19.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chinatsu.
Dialogue: 0,0:18:20.47,0:18:22.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah makan, tolong gali saljunya.
Dialogue: 0,0:18:22.43,0:18:23.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:18:51.00,0:18:52.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau jalan-jalan sebentar.
Dialogue: 0,0:18:53.50,0:18:55.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang masih sangat dingin.
Dialogue: 0,0:18:55.17,0:18:58.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tak suka diam saja di rumah.
Dialogue: 0,0:19:12.52,0:19:14.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dinginnya.
Dialogue: 0,0:19:14.44,0:19:16.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya pakai baju yang lebih hangat.
Dialogue: 0,0:19:16.90,0:19:18.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:19:19.44,0:19:21.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tak apa-apa?
Dialogue: 0,0:19:21.36,0:19:22.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak bisa kembali lagi.
Dialogue: 0,0:19:22.70,0:19:23.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sampai sakit.
Dialogue: 0,0:19:42.97,0:19:45.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat saljunya!
Dialogue: 0,0:19:47.31,0:19:49.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo perang bola salju!
Dialogue: 0,0:19:50.77,0:19:53.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Beri aku sepuluh detik dulu!\N- Apa?
Dialogue: 0,0:20:20.51,0:20:22.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan pakai ini jika mau!
Dialogue: 0,0:20:26.51,0:20:28.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jaga dirimu tetap hangat.
Dialogue: 0,0:20:28.85,0:20:30.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Taiki Inomata.{\i0}
Dialogue: 0,0:20:41.90,0:20:44.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau hebat bisa bangun pagi sekali\Nsetiap hari.
Dialogue: 0,0:21:06.89,0:21:08.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat pagi.
Dialogue: 0,0:21:16.85,0:21:18.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia datang lagi hari ini.{\i0}
Dialogue: 0,0:21:19.82,0:21:21.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Taiki juga datang hari ini.{\i0}
Dialogue: 0,0:21:23.07,0:21:24.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Hari ini juga.{\i0}
Dialogue: 0,0:21:37.17,0:21:39.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chii!
Dialogue: 0,0:21:39.08,0:21:40.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal yang kau tanyakan tadi…
Dialogue: 0,0:21:41.21,0:21:43.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar Nenek ceritakan sisanya.
Dialogue: 0,0:21:43.59,0:21:45.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang kutanyakan tadi?
Dialogue: 0,0:21:45.63,0:21:49.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ucapan kakekmu\Nsaat dia menyatakan perasaannya.
Dialogue: 0,0:22:05.65,0:22:07.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakekmu sangat malu
Dialogue: 0,0:22:07.65,0:22:10.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}saat mengatakan ini kepada Nenek.
Dialogue: 0,0:22:14.70,0:22:16.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}"Tanpa kusadari,{\i0}
Dialogue: 0,0:22:17.16,0:22:18.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}ternyata aku{\i0}
Dialogue: 0,0:22:19.50,0:22:22.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}ingin kau menjadi orang pertama\Nyang kulihat di pagi hari."{\i0}
Dialogue: 0,0:23:48.80,0:23:53.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Terjemahan subtitle oleh Sudirman Lius
