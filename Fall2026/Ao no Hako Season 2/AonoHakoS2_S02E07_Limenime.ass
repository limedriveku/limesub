Dialogue: 0,0:15:44.27,0:15:46.73,sign,,0000,0000,0000,,{\an8}1 JANUARI, NAGANO
Dialogue: 0,0:16:16.35,0:16:18.01,sign,,0000,0000,0000,,{\an8}TAIKI\NBISA KITA BICARA SAAT KAU PULANG?
Dialogue: 0,0:16:18.10,0:16:19.26,sign,,0000,0000,0000,,{\an8}ADA YANG HARUS KUKATAKAN KEPADAMU
