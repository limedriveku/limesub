Dialogue: 0,0:02:46.29,0:02:51.33,sign,,0000,0000,0000,,EPISODE 2: JALAN UNTUK MENJADI LEBIH KUAT
Dialogue: 0,0:03:47.46,0:03:48.93,sign,,0000,0000,0000,,TEKNIK GERHANA DARAH: I LOVE\NPENGABDIAN MURNI DAN MENGERIKAN
Dialogue: 0,0:10:40.93,0:10:42.18,sign,,0000,0000,0000,,RANBU: TARIAN BULAN SABIT TERAKHIR
Dialogue: 0,0:23:06.63,0:23:11.05,sign,,0000,0000,0000,,SELANJUTNYA\NTUJUAN HIDUP
Dialogue: 0,0:00:10.34,0:00:11.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ichinose!
Dialogue: 0,0:00:15.51,0:00:17.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, ya. Ada apa, Danocchi?
Dialogue: 0,0:00:18.01,0:00:19.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku minta kau siap siaga.
Dialogue: 0,0:00:20.02,0:00:22.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ha? Menurutmu mereka perlu diselamatkan?
Dialogue: 0,0:00:23.14,0:00:24.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita lihat saja nanti.
Dialogue: 0,0:00:24.62,0:00:27.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keputusannya ditentukan oleh kesanggupan\NByobugaura untuk melewati rintangan.
Dialogue: 0,0:00:27.23,0:00:28.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lantas aku harus bagaimana?
Dialogue: 0,0:00:28.69,0:00:30.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jawablah aku!
Dialogue: 0,0:00:30.86,0:00:32.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ichinose!
Dialogue: 0,0:00:32.92,0:00:36.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika dia tampak tak sanggup,\Naku akan turun tangan.
Dialogue: 0,0:00:40.45,0:00:42.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demamnya tinggi.
Dialogue: 0,0:00:45.50,0:00:46.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Byobugaura.
Dialogue: 0,0:00:46.96,0:00:47.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ichinose?
Dialogue: 0,0:00:48.46,0:00:51.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau selamat dari longsor barusan?
Dialogue: 0,0:00:52.17,0:00:53.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ha?
Dialogue: 0,0:00:53.17,0:00:56.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baik-baik saja. Berkat dirimu.
Dialogue: 0,0:00:57.35,0:01:00.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, syukurlah.
Dialogue: 0,0:01:02.98,0:01:03.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ichinose?
Dialogue: 0,0:01:11.26,0:01:15.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus melakukan sesuatu.
Dialogue: 0,0:02:53.17,0:02:57.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kalian ingin menyelamatkannya,\Nhadapilah aku.
Dialogue: 0,0:02:59.26,0:03:00.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah. Ayo kita tinggalkan saja dia.
Dialogue: 0,0:03:00.84,0:03:01.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sazanami!
Dialogue: 0,0:03:02.14,0:03:04.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya, kita bisa berduaan.
Dialogue: 0,0:03:04.52,0:03:06.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari juga sudah mulai gelap, benar?
Dialogue: 0,0:03:06.60,0:03:07.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudmu, benar?
Dialogue: 0,0:03:08.00,0:03:09.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kejam sekali!
Dialogue: 0,0:03:09.43,0:03:11.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar kalian monster!
Dialogue: 0,0:03:13.01,0:03:14.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan menangis, Nak.
Dialogue: 0,0:03:15.53,0:03:18.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau telah merasakan pengalaman berharga.
Dialogue: 0,0:03:18.51,0:03:22.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelak, pengalaman itu akan membantumu\Ndi masa depan.
Dialogue: 0,0:03:24.28,0:03:26.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pak Innami...
Dialogue: 0,0:03:26.54,0:03:27.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin saja. Kemungkinan besar.
Dialogue: 0,0:03:27.77,0:03:29.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malah berkelit!
Dialogue: 0,0:03:30.00,0:03:32.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sazanami, aku kasihan padanya.
Dialogue: 0,0:03:32.60,0:03:36.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ha? Wah, kau ini memang pria baik hati, ya?
Dialogue: 0,0:03:36.74,0:03:38.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi kekasihku yang manis...
Dialogue: 0,0:03:40.37,0:03:42.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bersedia membantu.
Dialogue: 0,0:03:42.93,0:03:44.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekasih?
Dialogue: 0,0:03:44.72,0:03:47.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teknik Gerhana Darah: I Love!
Dialogue: 0,0:03:49.27,0:03:50.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersiaplah, wahai mayat hidup!
Dialogue: 0,0:03:51.09,0:03:53.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kubuat kau muntah darah!
Dialogue: 0,0:04:03.20,0:04:04.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serangan seperti itu tak akan mengenaiku!
Dialogue: 0,0:04:04.74,0:04:08.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jurus ini perlu persiapan,\Nmakanya mudah dihindari.
Dialogue: 0,0:04:09.95,0:04:12.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akhiri ini sekarang juga!
Dialogue: 0,0:04:13.33,0:04:14.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:04:20.17,0:04:21.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sazanami!
Dialogue: 0,0:04:21.80,0:04:25.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jari kelima dan jari keempat\Nbisa melepaskan tembakan akurat.
Dialogue: 0,0:04:25.85,0:04:27.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, kekuatannya lemah.
Dialogue: 0,0:04:28.56,0:04:29.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial.
Dialogue: 0,0:04:30.18,0:04:33.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hidup itu tidak hanya berkutat\Nsoal hal-hal yang kau kuasai.
Dialogue: 0,0:04:33.58,0:04:36.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang terpenting adalah memahaminya
Dialogue: 0,0:04:36.94,0:04:40.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan menemukan orang yang melengkapi\Nkekuranganmu, begitu pula sebaliknya.
Dialogue: 0,0:04:42.19,0:04:46.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa dibilang, kekurangan kitalah\Nyang menjadi penghubung sesama manusia.
Dialogue: 0,0:04:47.78,0:04:48.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rokuro!
Dialogue: 0,0:04:49.62,0:04:51.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong Sazanami!
Dialogue: 0,0:04:51.50,0:04:53.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Aku tak bisa!
Dialogue: 0,0:04:53.50,0:04:54.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kepalaku pusing.
Dialogue: 0,0:04:54.86,0:04:55.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin aku sedang sakit.
Dialogue: 0,0:04:56.00,0:04:57.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah aku akan mati?
Dialogue: 0,0:04:57.04,0:04:58.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak akan mati! Bantu sana!
Dialogue: 0,0:04:58.34,0:04:59.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diam!
Dialogue: 0,0:05:00.67,0:05:02.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau di situ saja!
Dialogue: 0,0:05:02.99,0:05:05.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kuurus semuanya,
Dialogue: 0,0:05:05.71,0:05:08.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mulai dari membereskan kekacauanmu\Nsampai menghabisi musuh-musuhmu!
Dialogue: 0,0:05:09.16,0:05:12.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cintamu yang menyimpang itu pun\Nadalah suatu bentuk keyakinan.
Dialogue: 0,0:05:14.15,0:05:16.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau berniat menghadapiku\Ndengan keyakinan sedahsyat itu,
Dialogue: 0,0:05:17.41,0:05:20.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku siap menyambutnya.
Dialogue: 0,0:05:20.65,0:05:22.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin aku akan melemparmu\Nke tempat yang sedikit lebih jauh.
Dialogue: 0,0:05:25.61,0:05:26.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rokuro!
Dialogue: 0,0:05:27.20,0:05:29.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau biarkan gadis bertarung seorang diri!
Dialogue: 0,0:05:29.58,0:05:31.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu memalukan namanya!
Dialogue: 0,0:05:31.80,0:05:33.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu memalukan namanya!
Dialogue: 0,0:05:33.52,0:05:34.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu memalukan namanya!
Dialogue: 0,0:05:36.25,0:05:38.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengajar ini bawel sekali!
Dialogue: 0,0:05:38.96,0:05:39.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terbanglah.
Dialogue: 0,0:05:43.84,0:05:45.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sazanami?
Dialogue: 0,0:05:48.39,0:05:50.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bilang memalukan?\NAku sangat tersinggung.
Dialogue: 0,0:05:52.35,0:05:54.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.\NSelanjutnya, biar aku yang menghadapinya.
Dialogue: 0,0:05:57.51,0:05:59.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau...
Dialogue: 0,0:05:59.27,0:06:01.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kini, waktunya giliranku.
Dialogue: 0,0:06:01.57,0:06:02.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru
Dialogue: 0,0:06:03.30,0:06:05.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ini giliranku seorang diri!
Dialogue: 0,0:06:07.07,0:06:09.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah. Sepertinya situasi di sana\Nsudah mulai seru.
Dialogue: 0,0:06:10.72,0:06:12.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, urusan kita di sini sudah selesai.
Dialogue: 0,0:06:13.34,0:06:14.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial.
Dialogue: 0,0:06:14.51,0:06:17.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah tiga kali menggunakan jurusku,\Njadi aku tak berdaya lagi!
Dialogue: 0,0:06:18.10,0:06:20.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sungguh menyedihkan.
Dialogue: 0,0:06:20.38,0:06:21.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diam!
Dialogue: 0,0:06:21.64,0:06:24.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana bisa aku bertambah kuat\Nuntuk membunuh Momotaro dengan cara ini?
Dialogue: 0,0:06:24.91,0:06:25.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh?
Dialogue: 0,0:06:25.95,0:06:29.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kau sadar kalau latihan seperti ini\Ntidak akan membuatmu lebih kuat.
Dialogue: 0,0:06:29.22,0:06:30.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:06:31.36,0:06:32.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enyah kau.
Dialogue: 0,0:06:32.41,0:06:35.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hadapilah Momotaro sendirian dan mati saja.
Dialogue: 0,0:06:36.39,0:06:38.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan mencelakakan teman-temanmu.
Dialogue: 0,0:06:39.98,0:06:42.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para berengsek itu bukan temanku!
Dialogue: 0,0:06:42.65,0:06:43.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para berengsek itu?
Dialogue: 0,0:06:47.32,0:06:48.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia menghilang!
Dialogue: 0,0:06:49.66,0:06:52.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat kau melancarkan serangan,\Nkau langsung ketahuan.
Dialogue: 0,0:06:52.55,0:06:54.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belajarlah untuk menyembunyikan niatmu.
Dialogue: 0,0:06:54.23,0:06:56.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan membawanya.
Dialogue: 0,0:06:56.32,0:06:57.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak minta ditolong!
Dialogue: 0,0:06:57.73,0:06:59.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Jangan ikut campur!\N- Apa?
Dialogue: 0,0:06:59.57,0:07:00.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:07:01.13,0:07:04.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bisa diperalat untuk merepotkanmu.
Dialogue: 0,0:07:05.59,0:07:06.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei! Jangan lari...
Dialogue: 0,0:07:11.47,0:07:13.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya dia bisa berubah\Nmenjadi dua orang lagi.
Dialogue: 0,0:07:14.31,0:07:15.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yaoroshi?
Dialogue: 0,0:07:18.52,0:07:19.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menari.
Dialogue: 0,0:07:23.69,0:07:26.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boneka darah takkan bisa menghentikanku.
Dialogue: 0,0:07:26.65,0:07:28.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luar biasa.
Dialogue: 0,0:07:28.19,0:07:29.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,
Dialogue: 0,0:07:29.37,0:07:30.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bagaimana dengan yang ini?
Dialogue: 0,0:07:32.70,0:07:36.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ledakan hanya akan menyebarkan\Nkelopak-kelopak bunga dengan indah.
Dialogue: 0,0:07:38.87,0:07:39.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia menangkisnya?
Dialogue: 0,0:07:41.42,0:07:42.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seranganku belum berhenti.
Dialogue: 0,0:07:54.63,0:07:56.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai kapan kau bisa bertahan?
Dialogue: 0,0:07:56.44,0:07:58.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketahui batas kemampuanmu.
Dialogue: 0,0:07:59.98,0:08:02.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sampai jadi seperti aku!
Dialogue: 0,0:08:07.60,0:08:10.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya untuk sementara\Nwaktu dia akan menjadi bebanmu.
Dialogue: 0,0:08:10.79,0:08:12.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, apa rencanamu?
Dialogue: 0,0:08:21.54,0:08:22.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayang sekali.
Dialogue: 0,0:08:26.54,0:08:29.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, tapi aku datang kemari\Nbukan untuk bertarung.
Dialogue: 0,0:08:30.95,0:08:32.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, bangunlah! Kita pergi dari sini!
Dialogue: 0,0:08:33.38,0:08:35.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak perlu menolongku!
Dialogue: 0,0:08:36.50,0:08:37.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:08:38.26,0:08:40.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika aku menyerang setelah berubah wujud\Nmenjadi salah satu teman mereka,
Dialogue: 0,0:08:41.00,0:08:44.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mereka pasti akan kebingungan\Nmenentukan siapa orang yang asli.
Dialogue: 0,0:08:44.55,0:08:46.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kumanfaatkan keraguan sekejap itu.
Dialogue: 0,0:08:51.78,0:08:53.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ragu sedikit pun?
Dialogue: 0,0:08:55.46,0:08:57.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia membuatku naik pitam,\Njadi aku membungkamnya.
Dialogue: 0,0:08:59.24,0:09:00.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sampai membuatnya pingsan?
Dialogue: 0,0:09:00.99,0:09:02.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan menyerahkannya.
Dialogue: 0,0:09:05.54,0:09:06.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai nanti.
Dialogue: 0,0:09:07.21,0:09:09.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pikir aku akan membiarkanmu kabur?
Dialogue: 0,0:09:18.70,0:09:20.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hmph.
Dialogue: 0,0:09:20.06,0:09:21.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh juga.
Dialogue: 0,0:09:22.61,0:09:25.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cara yang bagus\Nuntuk memanfaatkan area sekitarmu.
Dialogue: 0,0:09:25.93,0:09:27.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kali ini, kau boleh pergi.
Dialogue: 0,0:09:28.06,0:09:29.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, hanya kali ini saja.
Dialogue: 0,0:09:36.15,0:09:38.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guru, ritmemu mengagumkan.
Dialogue: 0,0:09:40.83,0:09:43.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempo seranganmu menyenangkan!
Dialogue: 0,0:09:44.81,0:09:46.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkat Guru, aku sampai berkeringat banyak.
Dialogue: 0,0:09:46.82,0:09:48.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus.
Dialogue: 0,0:09:48.41,0:09:51.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keringat adalah bukti bahwa kau\Nbekerja keras meraih sesuatu.
Dialogue: 0,0:09:51.30,0:09:53.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teruslah berkeringat dalam menjalani hidupmu!
Dialogue: 0,0:09:55.65,0:09:57.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus coba mencari celah.
Dialogue: 0,0:09:58.04,0:09:59.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau itu bagaikan sol sepatu.
Dialogue: 0,0:09:59.91,0:10:02.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau naik makin tinggi\Ndengan melangkah secara perlahan.
Dialogue: 0,0:10:03.00,0:10:06.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Debu yang terkelupas dari sol sepatu\Nakibat perjalanan itu adalah keringatmu!
Dialogue: 0,0:10:06.68,0:10:09.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak bisa melangkah maju dengan\Nsol sepatu yang bersih tanpa noda, 'kan?
Dialogue: 0,0:10:11.42,0:10:14.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan menganggapku tak ada\Ndan meracau tak jelas seperti itu!
Dialogue: 0,0:10:14.82,0:10:16.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, aku belum melupakanmu.
Dialogue: 0,0:10:19.91,0:10:21.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Sazanami!
Dialogue: 0,0:10:22.69,0:10:24.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau membantuku menemukan ungkapan baru.
Dialogue: 0,0:10:27.22,0:10:30.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guru, terimalah seranganku!
Dialogue: 0,0:10:32.38,0:10:33.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:10:33.42,0:10:34.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, serang aku.
Dialogue: 0,0:10:38.35,0:10:40.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ranbu: Tarian Bulan Sabit Terakhir.
Dialogue: 0,0:10:42.33,0:10:44.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia justru mengincar gerbang torii?
Dialogue: 0,0:10:45.18,0:10:46.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ha?
Dialogue: 0,0:10:47.27,0:10:48.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa bergerak!
Dialogue: 0,0:10:48.44,0:10:49.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita pergi dari sini!
Dialogue: 0,0:10:50.39,0:10:52.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf aku membohongimu, Guru,
Dialogue: 0,0:10:52.52,0:10:56.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tetapi tujuan utama kami adalah ke puncak.
Dialogue: 0,0:11:00.05,0:11:01.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya ampun.
Dialogue: 0,0:11:01.50,0:11:03.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bermaksud untuk terbawa suasana.
Dialogue: 0,0:11:04.56,0:11:06.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, tidak masalah.
Dialogue: 0,0:11:06.04,0:11:07.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus!
Dialogue: 0,0:11:08.45,0:11:11.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tekad untuk terus melaju\Ntanpa melupakan tujuanmu.
Dialogue: 0,0:11:11.96,0:11:14.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semangat untuk bekerja sama\Ndan menghadapi kesulitan bersama.
Dialogue: 0,0:11:14.84,0:11:18.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitulah cara anak muda berkembang!
Dialogue: 0,0:11:18.27,0:11:22.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hidup adalah perkembangan tiada henti!
Dialogue: 0,0:11:33.56,0:11:34.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak berhasil.
Dialogue: 0,0:11:35.84,0:11:37.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana ini?
Dialogue: 0,0:11:37.38,0:11:39.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga aku tak sanggup...
Dialogue: 0,0:11:52.19,0:11:53.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:12:10.21,0:12:11.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah bangun?
Dialogue: 0,0:12:13.84,0:12:15.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Byobugaura.
Dialogue: 0,0:12:15.27,0:12:16.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah.
Dialogue: 0,0:12:16.98,0:12:19.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau menggendongku sampai ke sini?
Dialogue: 0,0:12:20.11,0:12:21.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Y-Ya.
Dialogue: 0,0:12:22.05,0:12:23.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, api itu...
Dialogue: 0,0:12:23.53,0:12:26.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perlu waktu lama sampai menyala.
Dialogue: 0,0:12:29.77,0:12:30.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:12:31.00,0:12:32.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ha?
Dialogue: 0,0:12:32.62,0:12:35.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah kau ada di sini.
Dialogue: 0,0:12:41.09,0:12:44.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua ini terjadi gara-gara aku.
Dialogue: 0,0:12:45.54,0:12:48.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya menghambat orang lain.
Dialogue: 0,0:12:48.35,0:12:50.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak berguna.
Dialogue: 0,0:12:52.85,0:12:54.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku penasaran...
Dialogue: 0,0:12:56.29,0:12:59.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau berusaha keras. Kau sungguh hebat.
Dialogue: 0,0:12:59.79,0:13:02.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa sering merendahkan diri sendiri?
Dialogue: 0,0:13:08.71,0:13:12.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sama sekali tidak hebat.
Dialogue: 0,0:13:13.79,0:13:16.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bahkan tak mampu menolong kakakku
Dialogue: 0,0:13:17.13,0:13:20.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan aku membunuh warga sipil.\NAku sungguh tidak berguna!
Dialogue: 0,0:13:23.03,0:13:25.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berengsek! Dasar tak berguna!
Dialogue: 0,0:13:25.98,0:13:26.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pergi dari sini!
Dialogue: 0,0:13:27.49,0:13:28.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Matilah!
Dialogue: 0,0:13:29.01,0:13:30.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belikan aku miras!
Dialogue: 0,0:13:31.06,0:13:32.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak berguna.
Dialogue: 0,0:13:32.52,0:13:38.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah perkataan yang sering kudengar\Ndari ayahku saat aku berusia 14 tahun.
Dialogue: 0,0:13:38.26,0:13:39.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan!
Dialogue: 0,0:13:42.95,0:13:43.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cih.
Dialogue: 0,0:13:45.45,0:13:46.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Homare.
Dialogue: 0,0:13:47.12,0:13:48.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau baik-baik saja?
Dialogue: 0,0:13:48.95,0:13:51.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mati saja kalian!\NTapi, belikan dulu aku miras!
Dialogue: 0,0:13:54.08,0:13:55.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang.
Dialogue: 0,0:13:56.62,0:13:58.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada Kakak.
Dialogue: 0,0:13:59.96,0:14:01.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak perempuanku, Sumire.
Dialogue: 0,0:14:03.40,0:14:05.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia selalu hadir
Dialogue: 0,0:14:05.94,0:14:09.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan melindungiku\Ndari ucapan Ayah yang menyakitkan.
Dialogue: 0,0:14:11.38,0:14:15.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin segera menjauh\Ndari ayah bajingan itu.
Dialogue: 0,0:14:16.14,0:14:20.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika sudah cukup umur untuk menyewa rumah,\Nkita pergi dari sini dan tinggal bersama.
Dialogue: 0,0:14:20.25,0:14:22.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau tinggal di mana?
Dialogue: 0,0:14:24.19,0:14:26.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di mana saja, asalkan bersamamu.
Dialogue: 0,0:14:27.24,0:14:30.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kita wajib cari tempat tinggal\Nyang punya kamar mandi dan toilet terpisah.
Dialogue: 0,0:14:30.37,0:14:31.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya ada?
Dialogue: 0,0:14:32.24,0:14:35.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih banyak sekali hal\Nyang belum kau ketahui, Homare.
Dialogue: 0,0:14:39.46,0:14:43.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tahun depan usia Kakak 16 tahun,\Nmakin banyak pilihan kerja paruh waktu.
Dialogue: 0,0:14:43.40,0:14:44.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan begitu, kita bisa hidup bersama.
Dialogue: 0,0:14:44.96,0:14:47.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga akan bekerja paruh waktu\Ndengan giat.
Dialogue: 0,0:14:47.88,0:14:49.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau akan bersekolah.
Dialogue: 0,0:14:51.22,0:14:53.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak pastikan kau bisa bersekolah.
Dialogue: 0,0:14:54.68,0:14:55.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mau!
Dialogue: 0,0:14:56.41,0:14:58.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga ingin membantu Kakak!
Dialogue: 0,0:14:59.45,0:15:01.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menggemaskan. Rasakan ini!
Dialogue: 0,0:15:02.02,0:15:03.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan!
Dialogue: 0,0:15:04.71,0:15:05.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:15:07.43,0:15:13.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak lebih senang kalau bisa\Nmelihatmu bersekolah dan hidup normal.
Dialogue: 0,0:15:15.91,0:15:18.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang! Serahkan saja pada Kakak!
Dialogue: 0,0:15:20.12,0:15:22.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setiap kali Kakak menenangkanku,
Dialogue: 0,0:15:22.96,0:15:26.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku benar-benar yakin kalau semuanya\Nakan berjalan lancar.
Dialogue: 0,0:15:27.55,0:15:29.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hingga tibalah malam itu.
Dialogue: 0,0:15:32.05,0:15:33.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial!
Dialogue: 0,0:15:33.22,0:15:35.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suatu hari nanti\Naku akan menghancurkan tempat itu.
Dialogue: 0,0:15:38.75,0:15:39.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cih.
Dialogue: 0,0:15:42.52,0:15:43.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berisik sekali!
Dialogue: 0,0:15:45.69,0:15:46.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku.
Dialogue: 0,0:15:46.89,0:15:48.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya aku terserang flu.
Dialogue: 0,0:15:49.24,0:15:50.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cih.
Dialogue: 0,0:15:50.50,0:15:53.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tak bisa diam, mati saja!
Dialogue: 0,0:15:53.03,0:15:54.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku!
Dialogue: 0,0:15:56.41,0:15:58.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku!
Dialogue: 0,0:16:01.49,0:16:04.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, adik perempuannya.
Dialogue: 0,0:16:04.16,0:16:05.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pendiam.
Dialogue: 0,0:16:06.00,0:16:08.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Ayolah, tawar lebih tinggi lagi.
Dialogue: 0,0:16:09.81,0:16:11.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Payudaranya besar.
Dialogue: 0,0:16:12.31,0:16:14.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia masih perawan.
Dialogue: 0,0:16:15.26,0:16:17.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paling tidak,\Nkau harus membayar seratus ribu yen.
Dialogue: 0,0:16:17.49,0:16:18.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:16:18.97,0:16:20.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ha?
Dialogue: 0,0:16:24.19,0:16:26.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mati saja, dasar sampah.
Dialogue: 0,0:16:27.23,0:16:29.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak?
Dialogue: 0,0:16:31.11,0:16:32.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurang ajar...
Dialogue: 0,0:16:32.80,0:16:34.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sakit, tahu!
Dialogue: 0,0:16:38.95,0:16:40.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak Bodoh.
Dialogue: 0,0:16:44.70,0:16:45.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Homare.
Dialogue: 0,0:16:45.75,0:16:47.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pikir aku siapa?
Dialogue: 0,0:16:47.15,0:16:48.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus menyelamatkannya.
Dialogue: 0,0:16:48.80,0:16:50.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus...
Dialogue: 0,0:16:50.30,0:16:51.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Matilah, Jalang!
Dialogue: 0,0:17:02.66,0:17:06.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada saat itu, aku...
Dialogue: 0,0:17:12.63,0:17:14.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berubah menjadi Oni.
Dialogue: 0,0:17:20.49,0:17:23.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak ingat kejadian setelahnya.
Dialogue: 0,0:17:23.73,0:17:27.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hidup dalam persembunyian\Nhingga bertemu dengan Pak Mudano.
Dialogue: 0,0:17:28.72,0:17:31.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Raksasa darah itu adalah Sumire.
Dialogue: 0,0:17:31.95,0:17:34.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penampilannya mencerminkan kemarahannya.
Dialogue: 0,0:17:34.69,0:17:40.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin itu kemarahannya kepadaku\Nkarena gagal menyelamatkannya hari itu,
Dialogue: 0,0:17:40.35,0:17:43.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}serta segala hal lainnya\Nyang membuatnya menjadi seperti itu.
Dialogue: 0,0:17:43.52,0:17:46.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tidak benar.
Dialogue: 0,0:17:48.01,0:17:53.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakakmu masih melindungimu\Nbahkan hingga detik ini.
Dialogue: 0,0:17:56.61,0:17:59.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski dia sudah tiada.
Dialogue: 0,0:18:02.08,0:18:05.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau tidak bisa memahami hal itu,
Dialogue: 0,0:18:07.24,0:18:10.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}siapa lagi yang bisa?
Dialogue: 0,0:18:12.97,0:18:14.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ichinose!
Dialogue: 0,0:18:14.77,0:18:16.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketemu.
Dialogue: 0,0:18:18.19,0:18:20.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ingin menggunakan asap,\Nseharusnya samarkan dengan benar.
Dialogue: 0,0:18:21.26,0:18:22.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat…
Dialogue: 0,0:18:25.09,0:18:27.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh? Kondisimu sedang parah.
Dialogue: 0,0:18:27.45,0:18:29.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau menyerah saja?
Dialogue: 0,0:18:31.82,0:18:33.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau mau mencoba melawanku?
Dialogue: 0,0:18:35.56,0:18:37.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku juga
Dialogue: 0,0:18:38.06,0:18:40.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak akan menahan diri.
Dialogue: 0,0:18:41.65,0:18:42.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus...
Dialogue: 0,0:18:46.08,0:18:47.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku...
Dialogue: 0,0:18:55.51,0:18:56.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Homare!
Dialogue: 0,0:18:58.97,0:19:00.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak!
Dialogue: 0,0:19:03.10,0:19:04.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ha?
Dialogue: 0,0:19:04.11,0:19:05.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh!
Dialogue: 0,0:19:05.26,0:19:07.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapan Kakak pernah membencimu?
Dialogue: 0,0:19:07.60,0:19:10.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapan Kakak pernah marah padamu?\NJawab aku!
Dialogue: 0,0:19:10.60,0:19:15.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi saat itu aku gagal menyelamatkanmu.
Dialogue: 0,0:19:16.49,0:19:18.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak berguna.
Dialogue: 0,0:19:20.69,0:19:24.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin Kakak orang yang membuatmu\Nkehilangan rasa percaya diri.
Dialogue: 0,0:19:24.16,0:19:27.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak selalu melindungimu dan menuntunmu.
Dialogue: 0,0:19:28.16,0:19:30.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira itu tugas seorang kakak.
Dialogue: 0,0:19:32.33,0:19:35.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi mungkin Kakak justru\Nmenghalangimu untuk melangkah maju.
Dialogue: 0,0:19:36.17,0:19:37.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tidak benar!
Dialogue: 0,0:19:37.87,0:19:39.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, percaya dirilah!
Dialogue: 0,0:19:39.52,0:19:40.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beranilah melangkah!
Dialogue: 0,0:19:46.47,0:19:50.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai sekarang, mari kita berdampingan.
Dialogue: 0,0:19:51.50,0:19:54.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita saling percaya pada orang lain.
Dialogue: 0,0:19:54.58,0:19:56.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak sendirian.
Dialogue: 0,0:19:57.82,0:19:59.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:19:59.48,0:20:01.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Homare, apa rencanamu sekarang?
Dialogue: 0,0:20:03.53,0:20:05.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin menyelamatkan Ichinose.
Dialogue: 0,0:20:05.98,0:20:07.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang keras!
Dialogue: 0,0:20:08.00,0:20:09.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku...
Dialogue: 0,0:20:12.89,0:20:15.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin menyelamatkan Ichinose!
Dialogue: 0,0:20:16.72,0:20:17.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Besar sekali!
Dialogue: 0,0:20:17.74,0:20:18.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak masuk akal.
Dialogue: 0,0:20:19.51,0:20:22.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi mustahil seorang bocah bisa\Nmengendalikan darah sebanyak itu.
Dialogue: 0,0:20:22.74,0:20:23.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo maju, Kakak!
Dialogue: 0,0:20:28.35,0:20:30.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang benar saja.
Dialogue: 0,0:20:30.18,0:20:33.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira dia cuma gadis yang pemalu,\Ntapi ini melampaui perkiraanku.
Dialogue: 0,0:22:11.28,0:22:13.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, aku terkejut.
Dialogue: 0,0:22:13.63,0:22:16.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak kusangka kau sampai ke puncak\Ndengan cara seperti ini.
Dialogue: 0,0:22:18.49,0:22:19.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demamnya tinggi.
Dialogue: 0,0:22:20.29,0:22:22.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar. Gara-gara aku.
Dialogue: 0,0:22:23.15,0:22:24.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan khawatir.
Dialogue: 0,0:22:24.56,0:22:26.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada aku.
Dialogue: 0,0:22:28.18,0:22:30.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakakmu luar biasa.
Dialogue: 0,0:22:30.80,0:22:31.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ichinose!
Dialogue: 0,0:22:33.39,0:22:34.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Byobugaura...
Dialogue: 0,0:22:35.39,0:22:37.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang karena
Dialogue: 0,0:22:37.69,0:22:41.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalian telah menolongku.
Dialogue: 0,0:22:42.95,0:22:44.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak masalah.
Dialogue: 0,0:22:44.86,0:22:47.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan saja padaku kapan pun.
Dialogue: 0,0:22:47.70,0:22:50.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah berubah\Nsejak kita berada di kaki gunung.
Dialogue: 0,0:22:51.66,0:22:53.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku suka tatapan matamu yang sekarang.
Dialogue: 0,0:22:54.44,0:22:57.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin ada seseorang\Nyang juga senang melihatnya.
Dialogue: 0,0:22:58.92,0:23:01.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah berkembang.
