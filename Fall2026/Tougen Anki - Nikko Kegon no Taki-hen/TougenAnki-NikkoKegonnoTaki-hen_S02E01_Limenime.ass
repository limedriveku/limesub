Dialogue: 0,0:02:14.00,0:02:17.00,sign,,0000,0000,0000,,EPISODE 1: LATIHAN DIMULAI
Dialogue: 0,0:02:43.08,0:02:43.76,sign,,0000,0000,0000,,PENGAJAR PARUH WAKTU AKADEMI RASETSU\NNEKOSAKI HAGURE
Dialogue: 0,0:03:30.36,0:03:31.54,sign,,0000,0000,0000,,PENGAJAR PARUH WAKTU AKADEMI RASETSU\NINNAMI YU
Dialogue: 0,0:06:17.52,0:06:19.34,sign,,0000,0000,0000,,"TEKNIK GERHANA DARAH: LIAR LIAR"
Dialogue: 0,0:08:27.02,0:08:27.50,sign,,0000,0000,0000,,TEKNIK GERHANA DARAH
Dialogue: 0,0:10:44.47,0:10:46.29,sign,,0000,0000,0000,,TEKNIK GERHANA DARAH: DI MANA ENGKAU
Dialogue: 0,0:11:49.00,0:11:50.62,sign,,0000,0000,0000,,TEKNIK GERHANA DARAH: PINANG DIBELAH DUA
Dialogue: 0,0:18:07.42,0:18:09.02,sign,,0000,0000,0000,,ONI
Dialogue: 0,0:20:03.66,0:20:04.20,sign,,0000,0000,0000,,SURAT PERINTAH: MOMOKUSA YOMOGI DISTRIK\NSUMIDA, TOKYO, DIPINDAHTUGASKAN KE UNIT 7
Dialogue: 0,0:20:04.20,0:20:04.82,sign,,0000,0000,0000,,PANGKAT: WAKIL KAPTEN MOMODERA MIKADO.\NPREFEKTUR KAGOSHIMA DIPINDAHTUGASKAN
Dialogue: 0,0:20:04.82,0:20:05.45,sign,,0000,0000,0000,,KE UNIT KIRISHIMA DITURUNKAN DARI\NWAKIL KAPTEN MENJADI PASUKAN BIASA
Dialogue: 0,0:20:14.47,0:20:15.02,sign,,0000,0000,0000,,MOMODERA MIKADO, PREFEKTUR KAGOSHIMA,\NDIPINDAHTUGASKAN KE UNIT KIRISHIMA
Dialogue: 0,0:23:06.30,0:23:10.95,sign,,0000,0000,0000,,SELANJUTNYA\NJALAN UNTUK MENJADI LEBIH KUAT
Dialogue: 0,0:00:03.93,0:00:08.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dahulu kala,\Nhiduplah Oni yang kejam dan ditakuti.
Dialogue: 0,0:00:09.97,0:00:11.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oni mengendalikan darah
Dialogue: 0,0:00:11.49,0:00:14.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan menggunakan kekuatannya\Nuntuk membinasakan manusia.
Dialogue: 0,0:00:16.27,0:00:20.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi melindungi umat manusia,\Nmuncul Momotaro untuk melawan Oni.
Dialogue: 0,0:00:22.94,0:00:26.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kini, pertempuran itu telah diwariskan\Nkepada keturunan mereka
Dialogue: 0,0:00:27.16,0:00:29.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan diam-diam berlanjut sampai sekarang.
Dialogue: 0,0:00:31.58,0:00:34.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hingga semua Oni dimusnahkan.
Dialogue: 0,0:00:34.71,0:00:37.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hingga semua Momotaro ditaklukkan.
Dialogue: 0,0:00:38.63,0:00:39.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun...
Dialogue: 0,0:00:41.09,0:00:43.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oni tidak menginginkan perang ini!
Dialogue: 0,0:00:43.84,0:00:46.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kita bersedia\Nsaling mendengarkan dan berkompromi,
Dialogue: 0,0:00:46.59,0:00:48.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita mungkin bisa mengakhiri perang ini.
Dialogue: 0,0:00:49.26,0:00:50.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkompromi dengan mereka?
Dialogue: 0,0:00:50.93,0:00:53.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengapa kita, Momotaro yang mulia,\Nharus melakukan hal seperti itu?
Dialogue: 0,0:00:53.52,0:00:55.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu usulan yang sangat tidak pantas!
Dialogue: 0,0:00:55.65,0:00:57.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diam.
Dialogue: 0,0:00:57.77,0:00:59.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menarik.
Dialogue: 0,0:00:59.40,0:01:01.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita dengarkan pendapatmu.
Dialogue: 0,0:01:01.90,0:01:04.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Yang Mulia Kaisar.
Dialogue: 0,0:01:05.99,0:01:07.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oni yang saya jumpai terus melawan
Dialogue: 0,0:01:08.01,0:01:12.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}agar Momotaro bersedia duduk\Ndi meja perundingan.
Dialogue: 0,0:01:13.50,0:01:15.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oni yang mengamuk memang berbahaya.
Dialogue: 0,0:01:15.75,0:01:19.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, saya juga melihat langsung\Nbetapa tersiksanya mereka berjuang.
Dialogue: 0,0:01:19.38,0:01:21.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya mengusulkan\Nagar kita menemui Oni, berdiskusi,
Dialogue: 0,0:01:21.63,0:01:24.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan saling bekerja sama\Nuntuk menentukan masa depan kita,
Dialogue: 0,0:01:24.28,0:01:26.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}termasuk cara mengatasi amukan Oni\Nyang tak terkendali.
Dialogue: 0,0:01:28.01,0:01:29.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti kita bertemu lagi, ya.
Dialogue: 0,0:01:30.35,0:01:32.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya yakin dengan apa yang saya lihat.
Dialogue: 0,0:01:37.85,0:01:39.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oni dan Momotaro.
Dialogue: 0,0:01:39.98,0:01:43.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Haruskah keduanya bertarung\Nhingga salah satunya musnah?
Dialogue: 0,0:01:51.91,0:01:53.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teknik Gerhana Darah!
Dialogue: 0,0:01:55.25,0:02:01.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini adalah kisah tentang kaum\Nyang berjuang mencari keadilan.
Dialogue: 0,0:02:03.92,0:02:06.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasakan ini!
Dialogue: 0,0:02:17.02,0:02:18.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dingin sekali!
Dialogue: 0,0:02:19.10,0:02:21.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akan memulai latihan praktik.
Dialogue: 0,0:02:22.65,0:02:24.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya satu hal yang perlu kalian lakukan:
Dialogue: 0,0:02:24.90,0:02:26.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}daki gunung ini.
Dialogue: 0,0:02:26.53,0:02:29.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Raih puncaknya dalam waktu 24 jam.
Dialogue: 0,0:02:29.82,0:02:33.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan kemampuan fisik Oni,\Nproses pendakian tak akan sulit.
Dialogue: 0,0:02:34.60,0:02:37.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku memanggil bantuan\Nuntuk menghambat latihan kalian.
Dialogue: 0,0:02:38.29,0:02:39.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salam kenal.
Dialogue: 0,0:02:39.87,0:02:43.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Nekosaki Hagure, pengajar paruh waktu.
Dialogue: 0,0:02:43.77,0:02:47.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah menjadi murid Senior Mudano\Nselama bertahun-tahun.
Dialogue: 0,0:02:47.67,0:02:51.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang bisa membantu\Ndalam latihan kali ini.
Dialogue: 0,0:02:51.13,0:02:52.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senang bertemu dengan kalian!
Dialogue: 0,0:02:52.84,0:02:54.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, hai.
Dialogue: 0,0:02:56.10,0:02:57.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelihatannya dia orang baik.
Dialogue: 0,0:02:58.64,0:02:59.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hai.
Dialogue: 0,0:03:03.07,0:03:03.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hai.
Dialogue: 0,0:03:04.01,0:03:05.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo!
Dialogue: 0,0:03:05.09,0:03:06.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hai.
Dialogue: 0,0:03:06.23,0:03:07.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}H-Hai.
Dialogue: 0,0:03:07.73,0:03:08.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hai.
Dialogue: 0,0:03:08.74,0:03:09.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sentuh aku!
Dialogue: 0,0:03:10.03,0:03:10.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hai.
Dialogue: 0,0:03:11.01,0:03:13.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf kalau kau harus menyapa orang sepertiku.
Dialogue: 0,0:03:13.29,0:03:14.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hai!
Dialogue: 0,0:03:15.49,0:03:16.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cih.
Dialogue: 0,0:03:17.29,0:03:19.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Murid-muridmu luar biasa, ya.
Dialogue: 0,0:03:19.75,0:03:20.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya.
Dialogue: 0,0:03:20.96,0:03:21.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:03:24.58,0:03:27.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senang bertemu kalian,\Npemuda-pemudi harapan masa depan.
Dialogue: 0,0:03:29.30,0:03:30.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namaku Innami Yu.
Dialogue: 0,0:03:31.55,0:03:35.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senang bisa menghabiskan waktu\Nbersama anak-anak muda berbakat.
Dialogue: 0,0:03:36.55,0:03:38.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, dia batuk darah!
Dialogue: 0,0:03:38.43,0:03:41.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenggorokanku memang lemah,\Nmakanya aku sering batuk.
Dialogue: 0,0:03:42.19,0:03:43.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berobatlah ke rumah sakit!
Dialogue: 0,0:03:44.85,0:03:46.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baik-baik saja.
Dialogue: 0,0:03:46.44,0:03:48.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kau yakin baik-baik saja,\Nsemuanya akan baik-baik saja.
Dialogue: 0,0:03:48.93,0:03:51.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal sudah di ambang maut,\Ntapi masih bisa berpikir positif.
Dialogue: 0,0:03:51.78,0:03:54.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka berdua akan berupaya\Nuntuk menghambat jalan kalian menuju puncak.
Dialogue: 0,0:03:54.78,0:03:57.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kebetulan, mereka berdua\Nmerupakan perwira aktif.
Dialogue: 0,0:03:57.70,0:03:59.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oleh karena itu,\Nmereka diizinkan menggunakan darah.
Dialogue: 0,0:03:59.95,0:04:02.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian juga boleh menggunakannya.\NCapailah puncaknya.
Dialogue: 0,0:04:02.66,0:04:06.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shiki, biar kuingatkan lagi,\Njangan pakai kekuatan Kishin.
Dialogue: 0,0:04:06.29,0:04:07.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap!
Dialogue: 0,0:04:08.04,0:04:10.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kyoya akan menunggu di puncak gunung,
Dialogue: 0,0:04:10.71,0:04:14.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi kuminta Nekosaki dan Innami\Nuntuk melawan kalian dengan serius.
Dialogue: 0,0:04:15.93,0:04:20.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dibiarkan menunggu sendirian di sini?\NDanocchi, kau ini jahat sekali.
Dialogue: 0,0:04:20.56,0:04:23.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terakhir, entah bagaimanapun caranya,
Dialogue: 0,0:04:24.06,0:04:26.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalian harus mencapai puncak bersama-sama.
Dialogue: 0,0:04:26.27,0:04:28.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau satu gagal, semua gagal.
Dialogue: 0,0:04:28.52,0:04:30.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami semua? Kenapa?
Dialogue: 0,0:04:30.90,0:04:33.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para pecundang ini hanya akan membebaniku.
Dialogue: 0,0:04:33.49,0:04:36.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga saja bukan kau yang jadi beban.
Dialogue: 0,0:04:36.32,0:04:37.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ha?
Dialogue: 0,0:04:37.66,0:04:40.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau kusingkirkan dari latihan ini\Nsekarang juga?
Dialogue: 0,0:04:40.70,0:04:42.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau? Mau menyingkirkanku?
Dialogue: 0,0:04:43.00,0:04:44.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya kau bisa bercanda.
Dialogue: 0,0:04:44.83,0:04:46.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka benar-benar serius.
Dialogue: 0,0:04:46.62,0:04:47.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diam.
Dialogue: 0,0:04:47.73,0:04:50.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mencapai puncak gunung bersama-sama\Nadalah keharusan.
Dialogue: 0,0:04:50.84,0:04:52.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemungkinan besar kalian akan selamat,
Dialogue: 0,0:04:52.63,0:04:55.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tetapi kalau kalian tidak serius,\Nkalian mungkin bisa mati di sini.
Dialogue: 0,0:04:55.43,0:04:57.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerahkan upaya terbaik kalian. Sekian.
Dialogue: 0,0:04:58.34,0:04:59.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Latihan dimulai sekarang.
Dialogue: 0,0:05:03.35,0:05:06.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jarak pandang yang buruk ini\Npasti bakal jadi masalah.
Dialogue: 0,0:05:06.24,0:05:07.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa-bisa kita celaka kalau terpisah.
Dialogue: 0,0:05:07.81,0:05:09.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di-Dinginnya.
Dialogue: 0,0:05:09.65,0:05:11.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kedinginan, peluk saja aku.
Dialogue: 0,0:05:12.90,0:05:16.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya-Yaoroshi! Jangan pergi terlalu jauh!
Dialogue: 0,0:05:16.61,0:05:17.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diam!
Dialogue: 0,0:05:18.03,0:05:20.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru kalianlah yang seharusnya\Ntidak tertinggal dariku.
Dialogue: 0,0:05:20.94,0:05:23.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak mau menanggung beban.
Dialogue: 0,0:05:23.23,0:05:25.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku.
Dialogue: 0,0:05:25.66,0:05:29.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau marah-marah seperti itu?\NKita harus tetap bersama!
Dialogue: 0,0:05:29.54,0:05:32.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kemari untuk menjadi lebih kuat.
Dialogue: 0,0:05:32.50,0:05:35.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus mencapai puncak bersama-sama?\NOmong kosong macam apa itu?
Dialogue: 0,0:05:35.17,0:05:38.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tujuanku kemari bukanlah untuk mencari teman.
Dialogue: 0,0:05:38.93,0:05:40.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya sudah, pergilah sesukamu.
Dialogue: 0,0:05:41.14,0:05:42.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ha?
Dialogue: 0,0:05:42.26,0:05:46.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kau egois memisahkan diri,\Nkita semua akan gagal.
Dialogue: 0,0:05:46.89,0:05:50.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ha? Jadi, siapa yang jadi beban di sini?
Dialogue: 0,0:05:50.56,0:05:52.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau cari gara-gara denganku?
Dialogue: 0,0:05:52.52,0:05:54.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, bukan saatnya bertengkar!
Dialogue: 0,0:05:54.90,0:05:56.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:05:56.28,0:05:57.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ha? Shiki?
Dialogue: 0,0:05:57.82,0:05:59.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ha?\N- Ha?
Dialogue: 0,0:05:59.28,0:06:01.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada dua Shiki!
Dialogue: 0,0:06:01.87,0:06:02.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Apa?\N- Apa?
Dialogue: 0,0:06:03.28,0:06:05.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Aku ada dua?
Dialogue: 0,0:06:09.04,0:06:09.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba!
Dialogue: 0,0:06:10.04,0:06:11.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:06:11.88,0:06:14.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku mengagetkan kalian?
Dialogue: 0,0:06:14.47,0:06:17.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teknik Gerhana Darah: Liar Liar.
Dialogue: 0,0:06:17.52,0:06:19.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inilah kemampuanku.
Dialogue: 0,0:06:19.43,0:06:21.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa berubah menjadi\Napa pun yang kusentuh.
Dialogue: 0,0:06:25.60,0:06:27.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, saat itu, ya...
Dialogue: 0,0:06:27.25,0:06:29.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa menyimpan tiga transformasi.
Dialogue: 0,0:06:29.56,0:06:31.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salah satunya adalah Ichinose.
Dialogue: 0,0:06:31.19,0:06:35.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa kalian tebak,\Nkira-kira siapa dua transformasi lainnya?
Dialogue: 0,0:06:35.90,0:06:38.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Transformasi? Itu bahaya.
Dialogue: 0,0:06:38.61,0:06:41.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak. Itu tidak terlalu berbahaya.
Dialogue: 0,0:06:41.61,0:06:45.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya Nekosaki sengaja\Nmembocorkan kemampuannya.
Dialogue: 0,0:06:46.62,0:06:48.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akankah mereka sadar kalau ini jebakan?
Dialogue: 0,0:06:49.58,0:06:52.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berdasarkan kemampuan itu,\Nmungkin dia Oni tipe pendukung.
Dialogue: 0,0:06:52.96,0:06:54.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita pasti bisa mengalahkannya.
Dialogue: 0,0:06:54.96,0:06:57.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengalahkanku, ya?
Dialogue: 0,0:06:59.09,0:07:00.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat sekali!
Dialogue: 0,0:07:02.01,0:07:03.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kougasaki!
Dialogue: 0,0:07:05.64,0:07:06.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia menghilang?
Dialogue: 0,0:07:11.35,0:07:12.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan main-main denganku!
Dialogue: 0,0:07:21.36,0:07:24.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seandainya ini pisau sungguhan,\Nkalian pasti sudah mati.
Dialogue: 0,0:07:24.63,0:07:27.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untungnya ini cuma mainan.
Dialogue: 0,0:07:30.16,0:07:32.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Barusan cuma pemanasan.
Dialogue: 0,0:07:32.46,0:07:34.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya, aku akan pakai pisau asli.
Dialogue: 0,0:07:34.88,0:07:35.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cih!
Dialogue: 0,0:07:35.82,0:07:36.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial!
Dialogue: 0,0:07:37.13,0:07:40.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal bukan bagian unit tempur,\Ntapi kenapa dia bisa sekuat ini?
Dialogue: 0,0:07:40.80,0:07:44.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapan aku bilang kalau aku\Nbukan anggota unit tempur?
Dialogue: 0,0:07:44.51,0:07:47.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau berasumsi begitu hanya karena\Nkemampuanku cuma bertransformasi?
Dialogue: 0,0:07:47.54,0:07:51.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu menghina namanya.\NMenilai diriku berdasarkan kemampuan itu?
Dialogue: 0,0:07:53.27,0:07:57.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ini anggota unit tempur, Bodoh.
Dialogue: 0,0:07:57.94,0:07:59.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gaya bicaranya berubah total.
Dialogue: 0,0:08:00.03,0:08:02.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah sikap ramahnya cuma sandiwara?
Dialogue: 0,0:08:03.03,0:08:05.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sialan, Mudano.
Dialogue: 0,0:08:05.20,0:08:07.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memaksaku untuk mengikuti latihan ini.
Dialogue: 0,0:08:07.74,0:08:09.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku punya urusan lebih penting.
Dialogue: 0,0:08:10.70,0:08:13.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teruslah meremehkan aku,
Dialogue: 0,0:08:14.46,0:08:17.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}maka di antara kalian pasti ada yang mati.
Dialogue: 0,0:08:18.17,0:08:20.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain bisa berubah wujud,\Ndia juga jago berduel?
Dialogue: 0,0:08:20.88,0:08:22.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Latihan ini sulitnya minta ampun.
Dialogue: 0,0:08:25.68,0:08:27.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teknik Gerhana Darah!
Dialogue: 0,0:08:32.17,0:08:33.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh?
Dialogue: 0,0:08:33.64,0:08:35.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau membidik ke arah mana?\NSeranganmu meleset!
Dialogue: 0,0:08:35.55,0:08:38.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berniat mengecohnya.\NAyo kita kabur selagi sempat!
Dialogue: 0,0:08:38.12,0:08:38.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti!
Dialogue: 0,0:08:38.94,0:08:40.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, aku mengerti!
Dialogue: 0,0:08:41.03,0:08:42.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ha?
Dialogue: 0,0:08:42.28,0:08:44.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yaoroshi, apa yang kau lakukan?\NAyo kita pergi!
Dialogue: 0,0:08:45.36,0:08:46.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau bertarung dengannya.
Dialogue: 0,0:08:47.01,0:08:48.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:08:48.12,0:08:51.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cih! Tujuan kedua pengajar ini adalah\Nmencegah kita mencapai puncak.
Dialogue: 0,0:08:51.93,0:08:53.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kita terus berhenti\Nuntuk melawan mereka,
Dialogue: 0,0:08:53.86,0:08:55.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita bisa kehabisan waktu.
Dialogue: 0,0:08:55.41,0:08:58.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hmph. Masa bodoh dengan tujuan kita.
Dialogue: 0,0:08:58.50,0:09:01.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menghadapinya akan membuatku makin kuat.
Dialogue: 0,0:09:01.17,0:09:02.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian para pengecut, pergi saja!
Dialogue: 0,0:09:03.01,0:09:04.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau ini kenapa, sih?
Dialogue: 0,0:09:04.75,0:09:06.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tinggalkan saja dia. Kita pergi dari sini.
Dialogue: 0,0:09:06.55,0:09:07.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau yakin?
Dialogue: 0,0:09:07.64,0:09:08.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku punya rencana.
Dialogue: 0,0:09:09.72,0:09:12.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yaoroshi, kalau ingin bertarung,\Njangan sampai kalah!
Dialogue: 0,0:09:14.56,0:09:17.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya, tak ada yang menghalangiku.\NMari kita bertarung satu lawan satu.
Dialogue: 0,0:09:19.31,0:09:24.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau itu beban,\Ntipe anggota yang mencelakakan seluruh tim.
Dialogue: 0,0:09:25.03,0:09:26.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ha?
Dialogue: 0,0:09:26.15,0:09:29.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi bagiku, idealnya memang begini.
Dialogue: 0,0:09:29.66,0:09:31.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya ampun...
Dialogue: 0,0:09:31.24,0:09:37.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku senang mematahkan\Nsemangat orang seperti dirimu.
Dialogue: 0,0:09:50.18,0:09:53.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei! Apa rencana yang kau maksud?
Dialogue: 0,0:09:53.64,0:09:55.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami sudah cukup jauh\Ndari kejaran pengajar itu.
Dialogue: 0,0:09:56.27,0:09:57.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Hei!\N- Berisik!
Dialogue: 0,0:09:58.60,0:10:00.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya, berhenti dulu!
Dialogue: 0,0:10:02.11,0:10:06.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yusurube, gunakan kemampuanmu\Nuntuk melacak Yaoroshi.
Dialogue: 0,0:10:06.82,0:10:10.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama kita tidak kehilangan jejaknya,\Nkita bisa berkumpul dengannya nanti.
Dialogue: 0,0:10:10.87,0:10:13.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau si pemarah itu dilumpuhkan?
Dialogue: 0,0:10:13.45,0:10:15.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dilumpuhkan?\NMaksudmu dia bisa saja terbunuh?
Dialogue: 0,0:10:15.95,0:10:17.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mungkin dihajar setengah mampus.
Dialogue: 0,0:10:18.71,0:10:21.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, dokter genit ada di sekitar sini.\NDia pasti baik-baik saja.
Dialogue: 0,0:10:21.11,0:10:22.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama, kita akan menuju ke puncak.
Dialogue: 0,0:10:23.09,0:10:26.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bisa menjemput Yaoroshi\Nsetelah kita sampai di sana.
Dialogue: 0,0:10:26.09,0:10:28.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berdasarkan kemampuan kita,\Nkau atau aku yang akan menyelamatkannya.
Dialogue: 0,0:10:28.76,0:10:30.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke! Aku yang akan pergi!
Dialogue: 0,0:10:30.72,0:10:34.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap. Menurutku, rencana Kougasaki\Nadalah pilihan terbaik kita.
Dialogue: 0,0:10:41.31,0:10:44.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teknik Gerhana Darah: Di Mana Engkau?
Dialogue: 0,0:10:46.73,0:10:49.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh juga analisis Kougasaki.
Dialogue: 0,0:10:49.78,0:10:52.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kini dia lebih tenang mengambil keputusan.
Dialogue: 0,0:10:53.49,0:10:56.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, keadaan selalu berubah.
Dialogue: 0,0:10:56.87,0:10:59.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau sampai kapan dia bisa tenang?
Dialogue: 0,0:11:00.29,0:11:04.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana, Yusurube?\NPeriksa juga lokasi kedua pengajar itu.
Dialogue: 0,0:11:04.50,0:11:06.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menemukan Yaoroshi.
Dialogue: 0,0:11:06.71,0:11:09.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nekosaki mungkin ada di dekatnya.
Dialogue: 0,0:11:09.40,0:11:11.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di mana pengajar yang satunya lagi?
Dialogue: 0,0:11:13.14,0:11:14.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia ada di sini!
Dialogue: 0,0:11:15.89,0:11:19.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian mungkin masih pemula\Ndan perlu banyak belajar,
Dialogue: 0,0:11:19.43,0:11:21.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tetapi kalian berani menghadapi\Ntantangan yang merintangi.
Dialogue: 0,0:11:21.85,0:11:23.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat...
Dialogue: 0,0:11:25.19,0:11:29.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika itu membuat kalian berkembang,\Naku bersedia menjadi tembok penghalang.
Dialogue: 0,0:11:30.63,0:11:32.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial, kita malah berpapasan dengannya!
Dialogue: 0,0:11:41.21,0:11:42.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat!
Dialogue: 0,0:11:45.67,0:11:48.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teknik Gerhana Darah: Pinang Dibelah Dua.
Dialogue: 0,0:11:50.67,0:11:52.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Bagaimana ini?
Dialogue: 0,0:11:53.18,0:11:54.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lari?
Dialogue: 0,0:11:54.22,0:11:55.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jelas.
Dialogue: 0,0:11:59.18,0:12:03.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi karena sudah terjebak begini,\Nmari kita cari tahu dulu kemampuannya.
Dialogue: 0,0:12:03.48,0:12:07.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski sudah memutuskan untuk kabur,\Nkalian masih berupaya menggali informasi.
Dialogue: 0,0:12:07.81,0:12:08.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat...
Dialogue: 0,0:12:09.42,0:12:10.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pintu Shoji?
Dialogue: 0,0:12:10.94,0:12:11.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perisai?
Dialogue: 0,0:12:12.19,0:12:14.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku akan menghadapi kalian\Ndengan segenap kemampuan.
Dialogue: 0,0:12:27.21,0:12:28.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:12:36.26,0:12:37.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil.
Dialogue: 0,0:12:38.85,0:12:40.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia membuka jalan yang menembus hutan.
Dialogue: 0,0:12:41.89,0:12:44.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian sudah melihat teknik milikku.
Dialogue: 0,0:12:44.56,0:12:47.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalian akan mengatasinya?
Dialogue: 0,0:12:49.15,0:12:50.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin.
Dialogue: 0,0:12:51.03,0:12:55.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mereka ketakutan,\Nkami tak akan bisa kabur.
Dialogue: 0,0:12:55.49,0:12:57.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayolah. Ayolah.
Dialogue: 0,0:12:57.20,0:12:58.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan menyerah dulu.
Dialogue: 0,0:12:59.95,0:13:01.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa rencana kita?
Dialogue: 0,0:13:01.33,0:13:02.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, semuanya!
Dialogue: 0,0:13:03.12,0:13:05.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serangan itu bukan masalah\Nasalkan tidak mengenai kita.
Dialogue: 0,0:13:06.12,0:13:07.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita pasti baik-baik saja!
Dialogue: 0,0:13:07.83,0:13:09.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk saat ini, sebaiknya kita mundur.
Dialogue: 0,0:13:10.09,0:13:11.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:13:11.21,0:13:13.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya dia sangat lambat.\NKita bisa kabur.
Dialogue: 0,0:13:14.63,0:13:15.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setuju.
Dialogue: 0,0:13:16.09,0:13:17.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bodoh.
Dialogue: 0,0:13:17.09,0:13:18.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei! Aku dengar, tahu!
Dialogue: 0,0:13:18.97,0:13:20.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Byobugaura, kau bisa berdiri?
Dialogue: 0,0:13:21.01,0:13:22.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Y-Ya.
Dialogue: 0,0:13:23.47,0:13:24.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lari! Lari!
Dialogue: 0,0:13:25.77,0:13:28.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melarikan diri adalah salah satu pilihan\Nyang sah dalam hidup.
Dialogue: 0,0:13:29.73,0:13:34.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, jangan pernah menilai\Nkecepatan seseorang hanya dari penampilannya.
Dialogue: 0,0:13:35.74,0:13:37.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akankah dia menangkap kita?
Dialogue: 0,0:13:38.11,0:13:39.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata dia memang lambat!
Dialogue: 0,0:13:41.37,0:13:43.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan menyerah, jantungku.
Dialogue: 0,0:13:44.16,0:13:46.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan menyerah, kakiku.
Dialogue: 0,0:13:48.75,0:13:51.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kita terus membuatnya berlari,\Ndia akan mati dengan sendirinya, ’kan?
Dialogue: 0,0:13:51.79,0:13:52.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan lengah!
Dialogue: 0,0:13:53.63,0:13:54.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu!
Dialogue: 0,0:13:54.96,0:13:57.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akan lolos dari pengajar itu\Ndan menuju ke puncak.
Dialogue: 0,0:14:00.94,0:14:03.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Byobugaura, kau tak apa-apa?\NKau masih bisa berlari?
Dialogue: 0,0:14:04.06,0:14:06.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku baik-baik saja.
Dialogue: 0,0:14:11.15,0:14:12.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahaya!
Dialogue: 0,0:14:16.19,0:14:17.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Byobugaura!
Dialogue: 0,0:14:18.15,0:14:19.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Bagaimana ini?
Dialogue: 0,0:14:21.07,0:14:22.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka berdua terjatuh.
Dialogue: 0,0:14:23.78,0:14:26.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau jatuh dari ketinggian ini...
Dialogue: 0,0:14:26.29,0:14:27.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus membantu mereka!
Dialogue: 0,0:14:37.92,0:14:40.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rokuro, berlindunglah di belakangku.
Dialogue: 0,0:14:41.01,0:14:43.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian masih di sini?
Dialogue: 0,0:14:45.01,0:14:47.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ingin melarikan diri,\Nlarilah sekuat tenaga kalian.
Dialogue: 0,0:14:47.73,0:14:50.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ingin bertarung,\Nbertarunglah sekuat tenaga kalian.
Dialogue: 0,0:14:50.27,0:14:53.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mumpung kalian masih muda,\Nbelajarlah memilih dan jalani pilihan itu.
Dialogue: 0,0:14:55.02,0:14:56.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa rencana kita?
Dialogue: 0,0:14:56.15,0:14:57.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita pergi ke puncak.
Dialogue: 0,0:14:57.65,0:14:58.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Tapi...
Dialogue: 0,0:14:59.20,0:15:02.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski kewalahan, aku yakin Shiki\Npasti berhasil sampai ke puncak.
Dialogue: 0,0:15:02.70,0:15:04.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita hanya perlu percaya padanya.
Dialogue: 0,0:15:04.91,0:15:06.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selagi kita kabur, kita akan terus\Nmembuat pengajar itu mengejar kita.
Dialogue: 0,0:15:06.95,0:15:08.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan begitu,\Ndia tidak akan berhenti untuk mengejar Shiki.
Dialogue: 0,0:15:08.70,0:15:09.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti.
Dialogue: 0,0:15:09.91,0:15:10.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita pergi!
Dialogue: 0,0:15:12.79,0:15:14.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kalian memilih kabur, ya.
Dialogue: 0,0:15:15.54,0:15:16.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu juga tidak masalah.
Dialogue: 0,0:15:17.00,0:15:21.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, mungkin sudah waktunya\Nkita masuk ke tahap berikutnya.
Dialogue: 0,0:15:26.81,0:15:28.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sakit!
Dialogue: 0,0:15:28.50,0:15:29.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ha?
Dialogue: 0,0:15:29.31,0:15:31.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tak apa-apa, Byobugaura?
Dialogue: 0,0:15:31.94,0:15:33.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Y-Ya.
Dialogue: 0,0:15:34.90,0:15:36.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kau terluka!
Dialogue: 0,0:15:37.98,0:15:39.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan memaksakan diri untuk bergerak!
Dialogue: 0,0:15:40.86,0:15:43.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kakimu patah, ya?
Dialogue: 0,0:15:45.12,0:15:47.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin sulit jika membawanya ke atas.
Dialogue: 0,0:15:47.83,0:15:50.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kugendong kau sampai kita\Nmenemukan tempat yang aman.
Dialogue: 0,0:15:51.22,0:15:52.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, naiklah.
Dialogue: 0,0:15:52.25,0:15:53.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku!
Dialogue: 0,0:15:53.32,0:15:54.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok malah bersujud?
Dialogue: 0,0:15:54.92,0:15:57.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong tinggalkan saja aku di sini.
Dialogue: 0,0:15:57.06,0:15:58.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak berguna.
Dialogue: 0,0:15:58.20,0:16:00.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma merepotkan semua orang.
Dialogue: 0,0:16:01.02,0:16:03.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita terjatuh karena salahku.
Dialogue: 0,0:16:03.88,0:16:06.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong, biarkan saja aku di sini. Aku serius.
Dialogue: 0,0:16:06.72,0:16:09.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin aku\Nmeninggalkan rekanku seorang diri?
Dialogue: 0,0:16:09.10,0:16:10.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, naik saja.
Dialogue: 0,0:16:10.93,0:16:13.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau baik sekali.\NAku jadi makin merasa bersalah.
Dialogue: 0,0:16:15.77,0:16:18.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan darah Oni,\Nlukamu pasti akan segera sembuh.
Dialogue: 0,0:16:18.69,0:16:20.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita cari tempat istirahat.
Dialogue: 0,0:16:21.28,0:16:23.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku. Maafkan aku.
Dialogue: 0,0:16:24.03,0:16:26.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pakaian kita basah kuyup dan kedinginan,
Dialogue: 0,0:16:26.37,0:16:29.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku ingin menyalakan api,\Ntapi musuh bisa melihat kepulan asapnya.
Dialogue: 0,0:16:30.20,0:16:32.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Andai ada gua atau semacamnya.
Dialogue: 0,0:16:32.33,0:16:34.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bisa membuat api di gunung bersalju?
Dialogue: 0,0:16:34.58,0:16:37.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membuat api dengan teknik gesekan\Nmemang berhasil.
Dialogue: 0,0:16:37.71,0:16:38.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah.
Dialogue: 0,0:16:39.09,0:16:41.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asalkan kita punya bahan berserat dan kayu.
Dialogue: 0,0:16:41.92,0:16:46.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pernah membacanya di sebuah buku,\Ntapi tak kusangka itu benar-benar berhasil.
Dialogue: 0,0:16:46.47,0:16:47.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya! Ya!
Dialogue: 0,0:16:47.68,0:16:49.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau banyak tahu soal itu.
Dialogue: 0,0:16:49.31,0:16:53.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dulu aku sering baca buku bertahan hidup.\NKubaca dan kucoba semuanya sendiri.
Dialogue: 0,0:16:53.35,0:16:56.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya, ayo kita bergegas sambil\Nmemastikan kita tidak ketahuan.
Dialogue: 0,0:17:02.07,0:17:04.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga Shiki baik-baik saja.
Dialogue: 0,0:17:04.40,0:17:06.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, perutku mulai sakit.
Dialogue: 0,0:17:07.06,0:17:10.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau baik-baik saja?\NBiar kuhangatkan tubuhmu!
Dialogue: 0,0:17:10.16,0:17:11.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kougasaki!
Dialogue: 0,0:17:12.20,0:17:15.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kita terlalu jauh,\Nkita tak akan bisa melacak Yaoroshi!
Dialogue: 0,0:17:15.45,0:17:17.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia belum beranjak dari tempat yang tadi.
Dialogue: 0,0:17:17.96,0:17:18.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah Nekosaki berhasil mengalahkannya?
Dialogue: 0,0:17:19.92,0:17:23.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang akan pergi!\NKalian bertiga, terus saja menuju puncak!
Dialogue: 0,0:17:24.20,0:17:25.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap!
Dialogue: 0,0:17:25.20,0:17:26.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di mana dia?
Dialogue: 0,0:17:26.30,0:17:27.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lurus ke arah selatan dari sini!
Dialogue: 0,0:17:29.18,0:17:30.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sialan!
Dialogue: 0,0:17:32.26,0:17:36.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat terjadi hal tak terduga,\Nmampukah kau memilih dengan tenang?
Dialogue: 0,0:17:36.81,0:17:40.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat di lapangan, satu keputusan\Ndapat menjadi penentu antara hidup dan mati.
Dialogue: 0,0:17:40.81,0:17:42.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, kita sebaiknya...
Dialogue: 0,0:17:45.69,0:17:48.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar kontak kulit adalah\Ncara terbaik menghangatkan diri.
Dialogue: 0,0:17:48.36,0:17:50.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang ketiga dalam hubungan segitiga.
Dialogue: 0,0:17:51.24,0:17:53.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak. Bukan waktunya memikirkan itu.
Dialogue: 0,0:17:53.83,0:17:55.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita pergi dari sini!
Dialogue: 0,0:17:55.33,0:17:56.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ha?
Dialogue: 0,0:18:03.59,0:18:04.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yusurube!
Dialogue: 0,0:18:05.01,0:18:06.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:18:06.34,0:18:07.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gerbang Torii?
Dialogue: 0,0:18:09.33,0:18:10.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak bisa bergerak.
Dialogue: 0,0:18:10.59,0:18:12.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa karena genangan darah di bawah kakiku?
Dialogue: 0,0:18:13.47,0:18:15.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tangan kiri mengikat.
Dialogue: 0,0:18:16.23,0:18:18.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Barang siapa terjebak dalam gerbang Torii,\Nia tak akan bisa bergerak.
Dialogue: 0,0:18:19.48,0:18:21.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melarikan diri juga penting.
Dialogue: 0,0:18:21.98,0:18:23.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun,
Dialogue: 0,0:18:23.61,0:18:26.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}terkadang ada momen ketika kalian\Nterpaksa melawan dan bertarung.
Dialogue: 0,0:18:29.03,0:18:30.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau adalah sanderaku.
Dialogue: 0,0:18:32.03,0:18:35.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wahai anak-anak muda,\Njika ingin menyelamatkannya, hadapi aku.
Dialogue: 0,0:18:37.50,0:18:40.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai saat ini,\Nkalian harus berani melawanku.
Dialogue: 0,0:18:44.75,0:18:47.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat, sebentar lagi malam akan tiba.
Dialogue: 0,0:18:47.80,0:18:51.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku. Tinggalkan saja aku di sini.
Dialogue: 0,0:18:51.89,0:18:54.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja. Aku tidak akan meninggalkanmu.
Dialogue: 0,0:18:54.30,0:18:58.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kita memang perlu\Nmencari tempat istirahat sebelum gelap.
Dialogue: 0,0:19:01.73,0:19:03.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, seram. Gempa bumi?
Dialogue: 0,0:19:05.52,0:19:08.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ichinose, tolong tinggalkan aku di sini.
Dialogue: 0,0:19:08.90,0:19:09.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:19:10.15,0:19:13.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak, kita berdua bisa mati!
Dialogue: 0,0:19:14.03,0:19:15.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:19:19.46,0:19:21.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang benar saja! Ayo kita lari!
Dialogue: 0,0:19:28.71,0:19:31.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bisa berlindung di tebing itu!
Dialogue: 0,0:19:31.30,0:19:32.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga sempat!
Dialogue: 0,0:19:32.84,0:19:34.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tinggalkan aku di sini!
Dialogue: 0,0:19:34.39,0:19:35.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin!
Dialogue: 0,0:19:35.80,0:19:37.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Byobugaura!
Dialogue: 0,0:19:37.21,0:19:38.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:19:38.97,0:19:40.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan melemparmu...
Dialogue: 0,0:19:40.68,0:19:42.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, bersiaplah untuk mendarat!
Dialogue: 0,0:19:45.43,0:19:46.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhasil!
Dialogue: 0,0:19:47.77,0:19:50.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya sekarang kau aman.
Dialogue: 0,0:19:51.57,0:19:52.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ichinose!
Dialogue: 0,0:19:55.95,0:19:58.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ichinose!
Dialogue: 0,0:20:05.46,0:20:07.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Turun pangkat dan dikirim ke Kagoshima.
Dialogue: 0,0:20:07.88,0:20:10.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh sebuah pelecehan\Nyang terang-terangan.
Dialogue: 0,0:20:10.51,0:20:14.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya Sang Kaisar Agung\Ntidak berniat mendengarkanmu.
Dialogue: 0,0:20:15.22,0:20:16.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Turut prihatin.
Dialogue: 0,0:20:16.89,0:20:20.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, selama ada Oni\Nyang berpotensi mengamuk,
Dialogue: 0,0:20:20.81,0:20:22.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita hanya bisa memusnahkan mereka.
Dialogue: 0,0:20:23.52,0:20:24.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak dungu.
Dialogue: 0,0:20:25.73,0:20:28.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga menentang usulanmu, Bodoh.
Dialogue: 0,0:20:29.23,0:20:32.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti bosan rasanya jika tidak ada orang\Nyang bisa kita ajak berduel.
Dialogue: 0,0:20:33.86,0:20:37.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayang sekali, mantan elite.
Dialogue: 0,0:20:38.12,0:20:41.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dengar ada Oni\Nyang sangat kuat di Kyushu.
Dialogue: 0,0:20:41.12,0:20:43.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin kau akan baik-baik saja,
Dialogue: 0,0:20:43.15,0:20:45.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi semoga kita bisa bertemu lagi\Nselagi kamu masih hidup.
Dialogue: 0,0:20:46.53,0:20:48.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau suatu saat kau ingin\Nmendapatkan ramalan nasib,
Dialogue: 0,0:20:48.22,0:20:49.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hubungi saja aku.
Dialogue: 0,0:20:52.88,0:20:55.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak peduli dengan promosi atau status.
Dialogue: 0,0:21:00.89,0:21:03.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di mana pun aku berada,\Nrencanaku tetaplah sama.
Dialogue: 0,0:21:05.44,0:21:08.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Mulia Kaisar terkadang memang kejam.
Dialogue: 0,0:21:08.57,0:21:10.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya tak menyangka Anda bersedia mendengarkan
Dialogue: 0,0:21:10.76,0:21:12.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}usulan dari orang dungu seperti itu.
Dialogue: 0,0:21:12.32,0:21:14.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami sempat dibuat panik.
Dialogue: 0,0:21:15.20,0:21:18.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak perlu dibahas lagi.\NBagaimana perkembangan soal masalah itu?
Dialogue: 0,0:21:19.74,0:21:23.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada pasukan pemberontak berisi\Nsekumpulan Oni yang tidak saling berkaitan.
Dialogue: 0,0:21:25.17,0:21:26.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Brigade Oni.
Dialogue: 0,0:21:28.21,0:21:32.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemimpin mereka adalah Keturunan Kishin juga.
