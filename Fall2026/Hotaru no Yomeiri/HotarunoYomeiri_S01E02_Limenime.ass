Dialogue: 0,0:03:36.99,0:03:38.07,sign,,0000,0000,0000,,PULAU TENNYO
Dialogue: 0,0:10:06.04,0:10:08.30,sign,,0000,0000,0000,,PERNIKAHAN KUNANG-KUNANG
Dialogue: 0,0:00:05.65,0:00:07.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kubahagiakan kau.
Dialogue: 0,0:00:09.03,0:00:09.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya kau
Dialogue: 0,0:00:10.57,0:00:13.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa menerimaku apa adanya.
Dialogue: 0,0:00:16.12,0:00:20.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, kamu benar-benar\Ningin menikah denganku?!
Dialogue: 0,0:00:20.67,0:00:22.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jelas.
Dialogue: 0,0:00:22.92,0:00:27.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya apa yang sedang\Ndipikirkan pria ini?
Dialogue: 0,0:00:27.01,0:00:29.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia benar-benar ingin menikahiku?
Dialogue: 0,0:00:29.51,0:00:32.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pria yang bisa menebas orang\Nsambil tersenyum ini?
Dialogue: 0,0:00:32.25,0:00:34.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti akan datang pengejar yang lain.
Dialogue: 0,0:00:34.43,0:00:36.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo segera pergi dari sini.
Dialogue: 0,0:00:36.81,0:00:39.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya siapa yang mengincar nyawaku?!
Dialogue: 0,0:00:39.89,0:00:43.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma diperintah untuk membunuh.
Dialogue: 0,0:00:43.06,0:00:44.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sendiri tidak tahu siapa?
Dialogue: 0,0:00:44.82,0:00:47.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misalnya, ada yang dendam padamu?
Dialogue: 0,0:00:50.70,0:00:54.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, mana mungkin sampai sejauh ini.
Dialogue: 0,0:00:54.91,0:00:56.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada orang yang seperti itu.
Dialogue: 0,0:00:56.79,0:01:01.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti ulah penjahat tak dikenal\Nyang mengincar uang tebusan.
Dialogue: 0,0:01:01.33,0:01:02.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:01:02.96,0:01:07.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau kita kembali\Nke markas mereka dan menghabisi semuanya?
Dialogue: 0,0:01:08.59,0:01:10.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hal senekat itu...
Dialogue: 0,0:01:10.26,0:01:12.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih aman kalau mengandalkan polisi!
Dialogue: 0,0:01:12.68,0:01:14.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong kembalikan saja aku ke rumah!
Dialogue: 0,0:01:14.68,0:01:16.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau incarannya tebusan,
Dialogue: 0,0:01:16.65,0:01:19.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa jadi rumahmu diintai,\Nlalu kau disergap di sana, lo.
Dialogue: 0,0:01:20.81,0:01:22.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudahlah.
Dialogue: 0,0:01:22.69,0:01:25.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, kita kawin lari saja!
Dialogue: 0,0:01:25.15,0:01:29.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bangun rumah kecil\Nlalu hidup bahagia berdua.
Dialogue: 0,0:01:29.19,0:01:30.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya?
Dialogue: 0,0:01:30.69,0:01:33.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejauh mana omongannya bisa dianggap serius?
Dialogue: 0,0:01:36.91,0:01:40.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang benar, dengan tubuhku ini,\Nkalau sampai disergap...
Dialogue: 0,0:01:41.71,0:01:44.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku juga tidak bisa\Nmemercayai perkataan pria ini.
Dialogue: 0,0:01:45.42,0:01:48.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk hari ini, ayo kita sembunyi\Ndi penginapan sekitar sini.
Dialogue: 0,0:01:48.38,0:01:49.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penginapan?!
Dialogue: 0,0:01:49.42,0:01:52.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tidak akan bisa lari\Ndari tempat ini semudah itu.
Dialogue: 0,0:01:52.42,0:01:54.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kupikirkan rencana lain.
Dialogue: 0,0:01:55.09,0:01:56.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti kujelaskan di penginapan.
Dialogue: 0,0:01:57.68,0:02:02.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di tempat asing ini,\Nyang bisa kuandalkan cuma pria ini.
Dialogue: 0,0:02:02.69,0:02:03.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mau ikut?
Dialogue: 0,0:03:34.07,0:03:36.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pernikahan Kunang-kunang
Dialogue: 0,0:03:38.07,0:03:39.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kondisimu bagaimana?
Dialogue: 0,0:03:39.49,0:03:41.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.
Dialogue: 0,0:03:41.24,0:03:44.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, tubuhku lengket semua rasanya.
Dialogue: 0,0:03:44.50,0:03:47.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bahas setelah membersihkan badan saja.
Dialogue: 0,0:03:47.58,0:03:49.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau kita berendam bersama?
Dialogue: 0,0:03:50.96,0:03:51.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?!
Dialogue: 0,0:03:51.96,0:03:54.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita ini suami istri,\Njadi tidak masalah, kan?
Dialogue: 0,0:03:54.34,0:03:58.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak usah!\NAku tidak sekotor itu!
Dialogue: 0,0:03:58.26,0:04:00.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku masuk duluan.
Dialogue: 0,0:04:00.59,0:04:03.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yakin tidak apa-apa sendirian di sini?
Dialogue: 0,0:04:08.35,0:04:10.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nikmat sekali.
Dialogue: 0,0:04:10.40,0:04:12.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku ingin berendam berdua.
Dialogue: 0,0:04:12.77,0:04:15.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa sudi berendam sama pembunuh bayaran?!
Dialogue: 0,0:04:15.78,0:04:18.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku juga takut sendirian.
Dialogue: 0,0:04:18.64,0:04:21.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh iya, aku belum tanya namamu.
Dialogue: 0,0:04:22.91,0:04:25.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Haruskah pakai nama samaran?
Dialogue: 0,0:04:25.45,0:04:28.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, bisa jadi dia tanya begitu\Npadahal sudah tahu.
Dialogue: 0,0:04:28.37,0:04:30.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya jujur saja di sini.
Dialogue: 0,0:04:30.37,0:04:32.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namaku Satoko.
Dialogue: 0,0:04:32.04,0:04:34.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satoko, ya.
Dialogue: 0,0:04:34.00,0:04:36.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nama yang indah dan berkelas.
Dialogue: 0,0:04:36.59,0:04:37.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cocok sekali denganmu.
Dialogue: 0,0:04:39.38,0:04:41.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namaku Goto Shinpei.
Dialogue: 0,0:04:41.51,0:04:42.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Umurmu berapa?
Dialogue: 0,0:04:42.89,0:04:44.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enam belas tahun.
Dialogue: 0,0:04:44.72,0:04:46.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dua tahun di bawahku, ya.
Dialogue: 0,0:04:47.02,0:04:48.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Satoko.
Dialogue: 0,0:04:49.18,0:04:50.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gosok punggungku, dong.
Dialogue: 0,0:04:50.64,0:04:51.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa aku harus melakukannya?!
Dialogue: 0,0:04:51.94,0:04:54.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau selalu waspada padaku, kan?
Dialogue: 0,0:04:54.40,0:04:56.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin kau segera terbuka padaku.
Dialogue: 0,0:04:56.98,0:04:59.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau lihat kejadian semengerikan itu,\Nsiapa juga yang...
Dialogue: 0,0:04:59.90,0:05:02.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anggap saja ucapan terima kasih\Nkarena sudah diselamatkan.
Dialogue: 0,0:05:03.32,0:05:05.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga, kalau tidak ada dia...
Dialogue: 0,0:05:06.29,0:05:09.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, bisa repot kalau dia kesal\Nkarena kutolak...
Dialogue: 0,0:05:11.08,0:05:14.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, iya, di situ... Enak sekali...
Dialogue: 0,0:05:15.29,0:05:16.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waduh, keras sekali!
Dialogue: 0,0:05:16.67,0:05:19.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau digosok lebih kuat lagi,\Nnanti bisa lecet.
Dialogue: 0,0:05:19.55,0:05:23.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dibilang begitu pun,\Nmemangnya aku harus lihat ke mana...
Dialogue: 0,0:05:24.47,0:05:26.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lukanya banyak sekali.
Dialogue: 0,0:05:26.89,0:05:29.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sulit dipercaya ini badan orang\Nyang baru berusia 18 tahun.
Dialogue: 0,0:05:29.93,0:05:33.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya sejak kapan dia\Nbekerja sebagai pembunuh?
Dialogue: 0,0:05:33.44,0:05:34.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo gantian.
Dialogue: 0,0:05:34.61,0:05:35.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?!
Dialogue: 0,0:05:35.56,0:05:38.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Badan Satoko juga cukup kotor, lo.
Dialogue: 0,0:05:41.95,0:05:44.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Situasi macam apa ini?
Dialogue: 0,0:05:45.07,0:05:49.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kaya dan cantik begitu,\Npasti banyak lamaran yang datang, kan?
Dialogue: 0,0:05:50.16,0:05:51.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:05:51.33,0:05:54.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya saja, kondisi tubuhku begini.
Dialogue: 0,0:05:55.38,0:05:59.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bilang tidak akan hidup lama,\Nmemangnya berapa sisa usiamu?
Dialogue: 0,0:06:00.01,0:06:04.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dokter bahkan ragu apakah\Naku bisa hidup sampai dewasa.
Dialogue: 0,0:06:04.30,0:06:07.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Bukankah 16 tahun itu sudah dewasa?
Dialogue: 0,0:06:07.51,0:06:09.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal kelihatannya sehat begitu.
Dialogue: 0,0:06:09.72,0:06:12.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, karena sudah dekat sama kematian,
Dialogue: 0,0:06:12.52,0:06:15.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}makanya kau tidak takut padaku, ya?
Dialogue: 0,0:06:15.56,0:06:17.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus berterima kasih pada penyakitmu.
Dialogue: 0,0:06:19.15,0:06:21.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak berperasaan sekali dia!
Dialogue: 0,0:06:24.41,0:06:25.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:06:25.28,0:06:31.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin dia pria pertama\Nyang tidak sungkan setelah tahu penyakitku.
Dialogue: 0,0:06:32.25,0:06:32.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?!
Dialogue: 0,0:06:32.75,0:06:36.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, aku bukannya\Nmau nikah betulan sama dia!
Dialogue: 0,0:06:37.17,0:06:38.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rambutnya juga kotor.
Dialogue: 0,0:06:38.79,0:06:39.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:06:40.75,0:06:42.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, aku bisa sendi...
Dialogue: 0,0:06:42.55,0:06:47.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sudah menikah, setiap hari aku ingin\Nmencuci rambut Satoko seperti ini.
Dialogue: 0,0:06:48.80,0:06:53.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satoko, tolong cuci kimonoku\Nyang kotor sehabis bekerja, ya.
Dialogue: 0,0:06:53.39,0:06:55.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tanganmu lecet karena mencuci\Nnoda yang membandel,
Dialogue: 0,0:06:55.98,0:06:59.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan kugenggam tanganmu dan kudekap erat\Nsambil tidur setiap malam.
Dialogue: 0,0:07:00.07,0:07:02.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada kebahagiaan yang seindah ini.
Dialogue: 0,0:07:02.65,0:07:07.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah kapan aku akan mati,\Ndan kalau mati, aku pasti masuk neraka.
Dialogue: 0,0:07:08.66,0:07:10.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau menemaniku?
Dialogue: 0,0:07:12.16,0:07:15.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal pernikahan,\Nbelum tentu Ayahanda akan mengizinkannya!
Dialogue: 0,0:07:16.33,0:07:18.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu, sih, tidak penting.
Dialogue: 0,0:07:18.17,0:07:20.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Toh kau tidak akan pulang lagi ke rumah.
Dialogue: 0,0:07:20.25,0:07:22.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan diputuskan seenaknya!
Dialogue: 0,0:07:22.00,0:07:24.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan menyerah untuk pulang!
Dialogue: 0,0:07:24.55,0:07:27.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang duluan mengajak menikah itu Satoko, lo.
Dialogue: 0,0:07:32.01,0:07:36.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak jadi menikah,\Naku harus bagaimana, ya?
Dialogue: 0,0:07:37.31,0:07:39.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mati saja kali, ya?
Dialogue: 0,0:07:39.02,0:07:40.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:07:40.36,0:07:44.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetap hidup juga tidak asyik,\Ncuma bikin repot saja.
Dialogue: 0,0:07:45.07,0:07:48.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sedang mengerjaiku?
Dialogue: 0,0:07:49.49,0:07:51.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kedengarannya begitu?
Dialogue: 0,0:07:53.58,0:07:54.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sini, ya?
Dialogue: 0,0:07:54.95,0:07:57.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, kita bunuh begitu ada kesempatan.
Dialogue: 0,0:07:57.16,0:07:58.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah ketahuan?!
Dialogue: 0,0:07:59.71,0:08:03.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang aku harus menjawab\Ndengan apa yang ingin dia dengar.
Dialogue: 0,0:08:03.09,0:08:05.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua akan berakhir kalau aku ditinggal!
Dialogue: 0,0:08:05.84,0:08:07.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana?
Dialogue: 0,0:08:07.97,0:08:10.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dipikir lagi sekarang, orang ini selalu
Dialogue: 0,0:08:10.64,0:08:15.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}membiarkanku memilih padahal dia tahu\Naku tidak bisa menolak.
Dialogue: 0,0:08:15.60,0:08:18.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak mau kalau aku mati?
Dialogue: 0,0:08:18.23,0:08:21.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seolah sedang memastikan cinta\Nyang ditujukan pada dirinya.
Dialogue: 0,0:08:22.27,0:08:24.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh pria yang menjengkelkan.
Dialogue: 0,0:08:24.78,0:08:26.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau seperti itu...
Dialogue: 0,0:08:27.11,0:08:28.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong aku.
Dialogue: 0,0:08:29.32,0:08:31.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma dirimu yang bisa kuandalkan!
Dialogue: 0,0:08:32.28,0:08:35.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin ada suami\Nyang tega meninggalkan istrinya!
Dialogue: 0,0:08:35.12,0:08:38.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga akan memanfaatkannya!
Dialogue: 0,0:08:40.96,0:08:43.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja!
Dialogue: 0,0:08:43.03,0:08:46.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamanya aku akan melindungi Satoko.
Dialogue: 0,0:08:47.21,0:08:49.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:08:51.05,0:08:53.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal jawaban atas pertanyaanmu tadi,
Dialogue: 0,0:08:54.01,0:08:56.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}silakan saja kalau kamu memang mau mati.
Dialogue: 0,0:08:57.81,0:09:00.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kita berhasil kabur dengan selamat,\Naku tidak akan menghentikanmu.
Dialogue: 0,0:09:01.35,0:09:06.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski kita menikah, aku tidak yakin bisa\Nmengubah hidupmu yang membosankan itu.
Dialogue: 0,0:09:06.86,0:09:08.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:09:08.65,0:09:11.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat itu terjadi, jantungmu ini...
Dialogue: 0,0:09:11.07,0:09:14.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}maukah kamu menyerahkannya padaku?
Dialogue: 0,0:09:18.08,0:09:20.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suaranya terdengar dari sini.
Dialogue: 0,0:09:20.04,0:09:21.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita serang bersamaan!
Dialogue: 0,0:09:24.50,0:09:25.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo? Eh?
Dialogue: 0,0:09:26.38,0:09:28.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada siapa-siapa?
Dialogue: 0,0:09:33.51,0:09:37.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, ayo pergi\Nsebelum pengejar yang lain tiba.
Dialogue: 0,0:09:43.02,0:09:45.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jawaban yang kuberikan padanya,
Dialogue: 0,0:09:46.27,0:09:48.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kira-kira dia tanggapi seperti apa, ya?
Dialogue: 0,0:09:49.36,0:09:51.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kuturunkan di sini.
Dialogue: 0,0:09:51.03,0:09:53.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti menarik perhatian kalau kugendong.
Dialogue: 0,0:10:08.30,0:10:11.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira aku akan dibawa\Nke tempat yang berbahaya.
Dialogue: 0,0:10:11.80,0:10:14.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata sama sekali bukan.
Dialogue: 0,0:10:14.51,0:10:17.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para wanita yang berdandan\Ndengan begitu meriah.
Dialogue: 0,0:10:17.51,0:10:19.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bangunan yang begitu indah.
Dialogue: 0,0:10:20.60,0:10:23.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya seperti masuk ke dunia lain!
Dialogue: 0,0:10:24.39,0:10:26.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sebenarnya di mana?
Dialogue: 0,0:10:26.81,0:10:29.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempat ini adalah sebuah pulau.
Dialogue: 0,0:10:29.52,0:10:30.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pulau?
Dialogue: 0,0:10:31.23,0:10:33.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini pulau tempat para pelacur kelas atas
Dialogue: 0,0:10:33.86,0:10:37.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang dibeli dari berbagai kota di Jepang\Nmenjajakan diri mereka.
Dialogue: 0,0:10:37.03,0:10:39.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebutannya Pulau Tennyo.
Dialogue: 0,0:10:39.33,0:10:41.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pulau Tennyo.
Dialogue: 0,0:10:41.04,0:10:43.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Shinpei!
Dialogue: 0,0:10:43.33,0:10:44.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:10:44.08,0:10:45.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Shinpei?!
Dialogue: 0,0:10:45.42,0:10:47.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu di sana.
Dialogue: 0,0:10:47.79,0:10:49.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, benar!
Dialogue: 0,0:10:49.46,0:10:53.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Shinpei, sekali-kali mampir\Nke tempatku juga, dong.
Dialogue: 0,0:10:53.72,0:10:55.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, ya, aku sudah punya janji duluan.
Dialogue: 0,0:10:55.80,0:10:57.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebentar saja, kok.
Dialogue: 0,0:10:57.76,0:10:59.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, baiklah...
Dialogue: 0,0:10:59.18,0:11:01.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, ini bukan waktunya mampir-mampir!
Dialogue: 0,0:11:01.31,0:11:03.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma sebentar, boleh, ya?
Dialogue: 0,0:11:03.73,0:11:05.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, aku
Dialogue: 0,0:11:05.06,0:11:08.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sepertinya harus mati kalau keluar dari sini.
Dialogue: 0,0:11:09.69,0:11:11.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pria ini...
Dialogue: 0,0:11:12.03,0:11:13.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}merepotkan sekali!
Dialogue: 0,0:11:13.90,0:11:14.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo!
Dialogue: 0,0:11:14.44,0:11:15.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu sebentar!
Dialogue: 0,0:11:15.20,0:11:16.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bebal sekali kamu!
Dialogue: 0,0:11:17.45,0:11:20.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah, padahal tanganmu cuma kutepis.
Dialogue: 0,0:11:20.45,0:11:23.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau cari perhatian Tuan Shinpei, ya?
Dialogue: 0,0:11:23.20,0:11:25.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Licik sekali.
Dialogue: 0,0:11:25.79,0:11:29.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jatuh terduduk di depan banyak orang?
Dialogue: 0,0:11:29.21,0:11:30.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai dilihat orang-orang...
Dialogue: 0,0:11:33.96,0:11:35.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ditertawakan.
Dialogue: 0,0:11:36.38,0:11:37.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Parah sekali.
Dialogue: 0,0:11:37.88,0:11:42.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal kalau di rumah Kirigaya,\Naku tidak akan dapat perlakuan seperti ini.
Dialogue: 0,0:11:43.01,0:11:47.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dipikir-pikir lagi,\Naku tidak pernah pergi ke luar seorang diri.
Dialogue: 0,0:11:48.40,0:11:50.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau gara-gara ini aku sampai\Nditinggalkan pria itu...
Dialogue: 0,0:11:52.27,0:11:54.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, aku tidak boleh menyerah!
Dialogue: 0,0:11:55.57,0:11:57.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisakah Anda menolong saya?!
Dialogue: 0,0:11:57.07,0:11:58.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:11:58.24,0:12:00.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyawaku sedang diincar!
Dialogue: 0,0:12:00.99,0:12:02.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:12:02.53,0:12:04.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Habis membunuh pelangganmu, ya?
Dialogue: 0,0:12:04.29,0:12:05.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan!
Dialogue: 0,0:12:05.50,0:12:07.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku diculik dan dibawa ke sini...
Dialogue: 0,0:12:07.29,0:12:08.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diculik siapa?
Dialogue: 0,0:12:09.21,0:12:13.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}O-Oleh para pria tidak dikenal...
Dialogue: 0,0:12:13.04,0:12:15.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah, dia ini kenapa, sih?
Dialogue: 0,0:12:15.67,0:12:16.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bikin repot saja.
Dialogue: 0,0:12:18.51,0:12:20.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon, tolong aku!
Dialogue: 0,0:12:21.09,0:12:23.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti akan kuberi imbalan!
Dialogue: 0,0:12:23.18,0:12:25.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon, tolong dengarkan ceritaku!
Dialogue: 0,0:12:26.93,0:12:29.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, pengemis, ya?
Dialogue: 0,0:12:29.69,0:12:31.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jorok sekali.
Dialogue: 0,0:12:31.02,0:12:35.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat sekali kau selama ini\Nbisa hidup seperti itu.
Dialogue: 0,0:12:37.49,0:12:40.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak pernah ada bahaya sama sekali.
Dialogue: 0,0:12:40.07,0:12:43.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena selalu ada orang yang melindungiku.
Dialogue: 0,0:12:43.58,0:12:46.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena aku selalu mengandalkan orang lain.
Dialogue: 0,0:12:47.20,0:12:49.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kesal...
Dialogue: 0,0:12:49.37,0:12:52.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada diriku yang ternyata\Nbegitu tak berdaya!
Dialogue: 0,0:12:57.38,0:12:59.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan dirundung begitu.
Dialogue: 0,0:12:59.30,0:13:02.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paling wanita ini berbuat onar\Ndan diusir dari kedainya.
Dialogue: 0,0:13:02.89,0:13:05.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini, makanlah biar ada tenaga.
Dialogue: 0,0:13:05.93,0:13:09.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mau berterima kasih,\Ntunjukkan saja tarianmu.
Dialogue: 0,0:13:09.14,0:13:10.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baguslah, ya.
Dialogue: 0,0:13:10.81,0:13:12.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harus kamu terima dengan senang hati.
Dialogue: 0,0:13:12.69,0:13:13.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah!
Dialogue: 0,0:13:15.19,0:13:17.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, maaf, ya!
Dialogue: 0,0:13:36.25,0:13:38.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih atas hidangannya.
Dialogue: 0,0:13:41.17,0:13:45.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau berkenan, izinkan saya\Nmemberikan ucapan terima kasih di sini.
Dialogue: 0,0:13:45.10,0:13:47.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, oke...
Dialogue: 0,0:13:47.56,0:13:50.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bolehkah saya meminjam kipas lipat?
Dialogue: 0,0:13:53.69,0:13:56.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak boleh diam saja.
Dialogue: 0,0:13:56.90,0:13:59.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak punya kekuatan\Nuntuk bertahan hidup,
Dialogue: 0,0:13:59.78,0:14:02.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tinggal cari saja sekarang!
Dialogue: 0,0:14:58.63,0:15:01.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimanapun caranya,\Naku harus keluar dari sini!
Dialogue: 0,0:15:03.05,0:15:06.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pulang ke rumah, lalu menikah.
Dialogue: 0,0:15:06.30,0:15:11.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu untuk pertama kalinya\Naku akan berguna bagi keluarga Kirigaya!
Dialogue: 0,0:15:26.24,0:15:27.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cih!
Dialogue: 0,0:15:29.62,0:15:31.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, namamu siapa?!
Dialogue: 0,0:15:31.41,0:15:32.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja di kedai mana?!
Dialogue: 0,0:15:32.99,0:15:35.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, aku yang duluan!
Dialogue: 0,0:15:35.04,0:15:36.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau belakangan saja!
Dialogue: 0,0:15:36.58,0:15:37.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo pergi.
Dialogue: 0,0:15:40.46,0:15:43.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis-gadis tadi kenalanku.
Dialogue: 0,0:15:43.17,0:15:47.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku lahir dan besar di sini,\Njadi semua orang mengenalku.
Dialogue: 0,0:15:47.55,0:15:49.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak menanyakan apa pun.
Dialogue: 0,0:15:50.55,0:15:52.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kau kelihatan marah.
Dialogue: 0,0:15:52.18,0:15:56.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asalkan ada yang mau menolong,\Naku tidak peduli jika itu bukan dirimu.
Dialogue: 0,0:15:56.64,0:16:00.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi juga banyak pria\Nyang mengajakku bicara.
Dialogue: 0,0:16:00.65,0:16:04.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sampai bilang begitu,\Nbagaimana kalau dia meninggalkanku...
Dialogue: 0,0:16:04.94,0:16:09.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kalau dipikir untuk ke depannya,\Nsekali-kali memang harus bisa tegas.
Dialogue: 0,0:16:10.28,0:16:11.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan begitu!
Dialogue: 0,0:16:11.70,0:16:14.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf sudah menjailimu!
Dialogue: 0,0:16:14.58,0:16:16.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satoko itu harus bersamaku!
Dialogue: 0,0:16:16.83,0:16:18.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak akan selamat kalau bukan denganku!
Dialogue: 0,0:16:19.42,0:16:20.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya...
Dialogue: 0,0:16:22.34,0:16:23.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:16:24.00,0:16:25.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong maafkan aku.
Dialogue: 0,0:16:26.26,0:16:29.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa ini?\NKenapa tiba-tiba jadi panik begitu?
Dialogue: 0,0:16:29.93,0:16:33.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, jelas sekali dia kelihatan beda\Ndari selama ini.
Dialogue: 0,0:16:33.35,0:16:35.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sedang sedih?
Dialogue: 0,0:16:36.39,0:16:37.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo sini.
Dialogue: 0,0:16:37.35,0:16:38.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?!
Dialogue: 0,0:17:01.37,0:17:04.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satoko pernah lihat kunang-kunang?
Dialogue: 0,0:17:04.38,0:17:07.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum, baru kali ini...
Dialogue: 0,0:17:07.21,0:17:09.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sulit dipercaya.
Dialogue: 0,0:17:10.47,0:17:13.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti sedang diselubungi cahaya.
Dialogue: 0,0:17:14.51,0:17:16.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah suasana hatimu sudah membaik.
Dialogue: 0,0:17:16.77,0:17:21.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kupikir Tuan Putri\Npasti belum pernah ke tempat seperti ini.
Dialogue: 0,0:17:22.15,0:17:23.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau senang?
Dialogue: 0,0:17:24.90,0:17:27.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm, iya.
Dialogue: 0,0:17:30.40,0:17:32.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke-Kenapa, sih, tiba-tiba sekali?!
Dialogue: 0,0:17:32.74,0:17:36.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jantung ini sudah jadi milik Satoko.
Dialogue: 0,0:17:36.62,0:17:39.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anggap saja badanku sebagai alatmu.
Dialogue: 0,0:17:39.25,0:17:42.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pergunakan aku semaumu, aku tidak masalah.
Dialogue: 0,0:17:42.92,0:17:44.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mencintaimu.
Dialogue: 0,0:17:46.09,0:17:48.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan pernah pergi dari sisiku.
Dialogue: 0,0:17:54.22,0:17:56.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tangannya bertulang besar, tapi ramping.
Dialogue: 0,0:17:57.06,0:17:59.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Genggamannya terasa begitu lembut.
Dialogue: 0,0:18:00.52,0:18:04.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik pemandangan rumah bordil\Nmaupun pemandangan indah ini,
Dialogue: 0,0:18:04.85,0:18:07.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak akan pernah kulihat\Njika tidak ada pria ini.
Dialogue: 0,0:18:08.02,0:18:11.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia memang berbuat hal-hal di luar nalar,\Ntapi aku tidak bisa membencinya.
Dialogue: 0,0:18:11.78,0:18:16.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Andai saja dia bukan pembunuh bayaran,\Nmungkin aku bisa dekat dengannya.
Dialogue: 0,0:18:16.45,0:18:17.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga!
Dialogue: 0,0:18:17.28,0:18:20.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah keluar dari sini,\Nayo lihat kunang-kunang tiap hari!
Dialogue: 0,0:18:21.37,0:18:25.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}O-Oh iya, katanya kamu punya rencana\Nuntuk keluar dari tempat ini!
Dialogue: 0,0:18:25.46,0:18:29.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, aku ini, kenapa malah\Nberpikiran bodoh seperti itu?!
Dialogue: 0,0:18:29.13,0:18:31.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, benar juga.
Dialogue: 0,0:18:31.09,0:18:34.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pulau ini adalah tempat khusus\Nyang tidak terjangkau hukum.
Dialogue: 0,0:18:35.55,0:18:38.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buktinya aku bisa\Nmembawa katana ke mana-mana.
Dialogue: 0,0:18:38.97,0:18:43.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya ada satu cara agar wanita\Nbisa keluar dari pulau ini.
Dialogue: 0,0:18:43.14,0:18:44.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:18:44.64,0:18:46.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menjadi pelacur.
Dialogue: 0,0:18:50.57,0:18:53.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin Satoko menjadi pelacur.
Dialogue: 0,0:18:58.16,0:19:00.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini titik tertinggi di pulau ini.
Dialogue: 0,0:19:03.54,0:19:06.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempat ini jaraknya sekitar tiga ri\Ndari daratan utama.
Dialogue: 0,0:19:06.37,0:19:11.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pulau ini dikenal sangat tertutup,\Njadi orang tidak bisa bebas keluar masuk.
Dialogue: 0,0:19:12.05,0:19:14.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini tempat kesukaan\Npara pria berkedudukan tinggi.
Dialogue: 0,0:19:14.97,0:19:18.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyawa orang bisa dengan mudah direnggut\Ndemi melindungi rahasia pulau.
Dialogue: 0,0:19:19.30,0:19:21.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agar wanita bisa keluar\Ndengan selamat dari pulau,
Dialogue: 0,0:19:22.14,0:19:25.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}caranya hanya dengan jadi pelacur\Nlalu ditebus pelanggan kaya.
Dialogue: 0,0:19:27.23,0:19:30.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku nanti bisa ikut belakangan,\Njadi tenang saja.
Dialogue: 0,0:19:30.57,0:19:31.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:19:32.15,0:19:35.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belum pernah benar-benar\Nbicara dengan pria,
Dialogue: 0,0:19:35.61,0:19:38.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mana bisa bersama pria tidak kukenal...
Dialogue: 0,0:19:39.16,0:19:41.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Artinya harus tidur bersama, kan?
Dialogue: 0,0:19:41.24,0:19:42.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin!
Dialogue: 0,0:19:42.58,0:19:44.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sampai begitu,
Dialogue: 0,0:19:44.25,0:19:47.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku bakal membunuh pria yang menemanimu.
Dialogue: 0,0:19:47.50,0:19:49.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satoko memang secantik itu.
Dialogue: 0,0:19:49.79,0:19:52.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cukup bertemu dan mengobrol saja,\Npasti pria mana pun menyukaimu.
Dialogue: 0,0:19:53.67,0:19:56.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa tidak ada cara lain?
Dialogue: 0,0:19:56.47,0:19:59.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa juga kabur dengan mencuri kapal.
Dialogue: 0,0:19:59.09,0:20:03.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya saja di dermaga ada banyak\Npenjaga yang bawa pistol.
Dialogue: 0,0:20:03.22,0:20:06.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ketahuan, pasti bakal\Ndihujani peluru sampai bolong-bolong.
Dialogue: 0,0:20:07.39,0:20:11.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak ingin percaya,\Ntapi inilah kenyataannya.
Dialogue: 0,0:20:12.82,0:20:14.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Satoko.
Dialogue: 0,0:20:14.19,0:20:15.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku membuatmu sedikit takut, ya.
Dialogue: 0,0:20:15.78,0:20:17.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedikit.
Dialogue: 0,0:20:17.65,0:20:20.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlalu banyak hal yang terjadi\Nsecara bersamaan.
Dialogue: 0,0:20:20.28,0:20:21.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:20:21.87,0:20:24.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak sudah membawaku ke sini.
Dialogue: 0,0:20:26.25,0:20:29.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi lega setelah memahami\Nsituasi yang kualami sekarang.
Dialogue: 0,0:20:30.00,0:20:35.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi mendapat lebih banyak informasi\Ndan sekutu, aku tidak boleh terus ragu.
Dialogue: 0,0:20:35.96,0:20:38.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Antarkan aku ke rumah bordil!
Dialogue: 0,0:22:10.56,0:22:13.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar bodoh kau ini!
Dialogue: 0,0:22:13.35,0:22:16.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa-bisanya kau lengah\Nmengawasi Nona Satoko!
Dialogue: 0,0:22:17.73,0:22:20.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tamat sudah keluarga Ogawa kita!
Dialogue: 0,0:22:20.36,0:22:21.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gara-gara ulahmu...
Dialogue: 0,0:22:21.69,0:22:23.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah, cukup sampai di situ.
Dialogue: 0,0:22:23.95,0:22:25.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan!
Dialogue: 0,0:22:25.20,0:22:26.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ta-Tapi!
Dialogue: 0,0:22:26.37,0:22:29.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua ini tanggung jawab saya.
Dialogue: 0,0:22:30.83,0:22:33.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya tidak akan membela diri.
Dialogue: 0,0:22:33.16,0:22:36.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan beri saya hukuman\Nyang setara dengan kematian.
Dialogue: 0,0:22:36.13,0:22:39.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya saja, saya punya satu permintaan.
Dialogue: 0,0:22:39.30,0:22:40.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:22:41.05,0:22:44.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong lepaskan tali ini sekarang juga.
Dialogue: 0,0:22:45.68,0:22:49.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya berjanji akan menerima\Nhukumannya nanti.
Dialogue: 0,0:22:49.39,0:22:53.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya pasti akan membawa Nona Satoko pulang!
