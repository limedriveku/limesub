Dialogue: 0,0:00:40.77,0:00:42.27,sign,,0000,0000,0000,,ISEKICHI
Dialogue: 0,0:03:28.98,0:03:35.65,sign,,0000,0000,0000,,IBLIS DAN JANTUNG
Dialogue: 0,0:14:18.21,0:14:20.21,sign,,0000,0000,0000,,ISEKICHI
Dialogue: 0,0:15:52.81,0:15:53.67,sign,,0000,0000,0000,,ISEKICHI
Dialogue: 0,0:00:08.20,0:00:11.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa keberadaan Satoko masih belum diketahui?
Dialogue: 0,0:00:11.53,0:00:14.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, penyelidikan sepertinya\Nmengalami kesulitan.
Dialogue: 0,0:00:15.79,0:00:19.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satoko, pergi ke mana kamu?
Dialogue: 0,0:00:19.29,0:00:20.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan.
Dialogue: 0,0:00:20.17,0:00:21.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm?
Dialogue: 0,0:00:21.17,0:00:23.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada tamu yang datang.
Dialogue: 0,0:00:23.09,0:00:24.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi.
Dialogue: 0,0:00:25.42,0:00:26.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu siapa?
Dialogue: 0,0:00:26.88,0:00:29.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perkenalkan, saya Nitobe Eishin.
Dialogue: 0,0:00:30.68,0:00:34.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya datang membawa pesan\Nyang dititipkan Satoko.
Dialogue: 0,0:00:42.27,0:00:44.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malam ini mau keluar dari pulau?!
Dialogue: 0,0:00:45.36,0:00:47.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bilangnya mendadak sekali.
Dialogue: 0,0:00:47.57,0:00:49.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya bagaimana caranya?
Dialogue: 0,0:00:49.20,0:00:51.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan menyogok tukang kapal.
Dialogue: 0,0:00:51.82,0:00:55.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang membuatku harus segera\Nkeluar dari pulau.
Dialogue: 0,0:00:55.91,0:00:57.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu akan kembali lagi, kan?
Dialogue: 0,0:01:01.29,0:01:03.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak diselamatkan Satoko,
Dialogue: 0,0:01:03.88,0:01:07.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bekerja selama lima hari ini\Nterasa sangat menyenangkan.
Dialogue: 0,0:01:07.59,0:01:11.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga berterima kasih karena\Nsikap Yukari dan yang lainnya ikut berubah.
Dialogue: 0,0:01:11.84,0:01:14.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akan terus berteman, kan?
Dialogue: 0,0:01:15.85,0:01:16.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:01:18.56,0:01:20.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akan terus jadi teman!
Dialogue: 0,0:01:22.77,0:01:24.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baguslah.
Dialogue: 0,0:01:38.91,0:01:41.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Singkat sekali rasanya.
Dialogue: 0,0:01:42.71,0:01:44.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Walau hanya sebentar,
Dialogue: 0,0:01:45.29,0:01:47.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}terima kasih atas kebaikanmu.
Dialogue: 0,0:03:26.39,0:03:28.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pernikahan Kunang-kunang
Dialogue: 0,0:03:40.16,0:03:43.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kira-kira butuh berapa lama\Nuntuk sampai ke seberang?
Dialogue: 0,0:03:44.79,0:03:46.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin empat atau lima jam.
Dialogue: 0,0:03:46.46,0:03:49.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, lama juga ternyata.
Dialogue: 0,0:03:50.25,0:03:53.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti baru sampai saat fajar, ya.
Dialogue: 0,0:03:53.34,0:03:54.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harusnya begitu.
Dialogue: 0,0:03:57.55,0:04:00.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suasananya canggung sekali!
Dialogue: 0,0:04:00.47,0:04:02.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus mengajaknya bicara!
Dialogue: 0,0:04:02.55,0:04:05.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, bicara soal apa?
Dialogue: 0,0:04:05.60,0:04:08.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal sebentar lagi aku dan orang ini...
Dialogue: 0,0:04:08.44,0:04:13.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, setelah tiba di daratan utama,\Norang ini katanya mau menculikku.
Dialogue: 0,0:04:13.40,0:04:15.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu serius atau tidak, ya?
Dialogue: 0,0:04:18.95,0:04:22.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gelagat Tuan Shinpei aneh sekali...
Dialogue: 0,0:04:22.07,0:04:25.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak awal memang tidak jelas\Napa isi pikirannya,
Dialogue: 0,0:04:25.06,0:04:27.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi hari ini lebih parah.
Dialogue: 0,0:04:27.45,0:04:31.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya, aku sudah tidak mau\Nmembohongi atau menipu dia lagi!
Dialogue: 0,0:04:31.88,0:04:33.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf!
Dialogue: 0,0:04:33.79,0:04:38.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kepikiran, bisakah dirimu mengantarku\Nsampai ke kediaman keluarga Kirigaya?
Dialogue: 0,0:04:38.01,0:04:40.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Izinkan aku memberi\Nucapan terima kasih yang layak!
Dialogue: 0,0:04:41.47,0:04:43.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Walau aku tidak bisa menikah denganmu...
Dialogue: 0,0:04:44.14,0:04:46.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu sampai seberang,
Dialogue: 0,0:04:46.39,0:04:50.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}rasanya salah kalau aku\Nkemudian lari meninggalkanmu.
Dialogue: 0,0:04:51.60,0:04:54.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin menikah dengan Satoko.
Dialogue: 0,0:04:55.73,0:04:59.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, Satoko ingin sekali pulang ke rumah.
Dialogue: 0,0:04:59.74,0:05:02.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kularang rasanya juga salah.
Dialogue: 0,0:05:02.82,0:05:06.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku terus kepikiran harus bagaimana\Nsetelah tiba di seberang.
Dialogue: 0,0:05:07.24,0:05:09.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ini menyukai Satoko,
Dialogue: 0,0:05:09.71,0:05:13.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi aku tidak mau Satoko tidak bahagia.
Dialogue: 0,0:05:16.88,0:05:19.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya selama ini kamu canggung begini.
Dialogue: 0,0:05:19.84,0:05:21.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya canggung, ya?
Dialogue: 0,0:05:21.43,0:05:23.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata aku canggung, ya.
Dialogue: 0,0:05:23.34,0:05:26.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, sepertinya memang harus\Ndiputuskan mau bagaimana.
Dialogue: 0,0:05:28.97,0:05:33.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon maaf,\Ntapi perasaanku tidak bisa diubah.
Dialogue: 0,0:05:35.81,0:05:37.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga sama.
Dialogue: 0,0:05:37.15,0:05:41.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski kebahagiaan Satoko\Nbukanlah menikah denganku,
Dialogue: 0,0:05:41.65,0:05:45.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa pun jadinya nanti,\Naku ingin menikah dengan Satoko.
Dialogue: 0,0:05:45.70,0:05:47.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa bodoh sama orang lain.
Dialogue: 0,0:05:49.04,0:05:53.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, jadilah orang dengan status\Nyang bisa disetujui Ayahanda.
Dialogue: 0,0:05:54.17,0:05:56.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau baru mulai sekarang, bisa atau tidak?
Dialogue: 0,0:05:56.54,0:05:57.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin akan sulit.
Dialogue: 0,0:05:57.92,0:06:00.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, kamu mengerjaiku!
Dialogue: 0,0:06:03.43,0:06:07.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Andai saja kita dipertemukan\Ndengan cara yang berbeda,
Dialogue: 0,0:06:07.55,0:06:11.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin kita bisa menjalin\Nhubungan yang berbeda.
Dialogue: 0,0:06:11.48,0:06:15.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awalnya kukira dirimu itu menyeramkan.
Dialogue: 0,0:06:15.81,0:06:18.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, sekarang aku merasa bersyukur\Nbertemu denganmu.
Dialogue: 0,0:06:23.03,0:06:27.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satoko memang dewasa, ya.\NSelalu bisa menenangkanku.
Dialogue: 0,0:06:27.62,0:06:30.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama hidupku hingga sekarang,
Dialogue: 0,0:06:30.49,0:06:33.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}saat-saat bersama Satoko inilah\Nyang paling menyenangkan.
Dialogue: 0,0:06:52.10,0:06:53.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah...
Dialogue: 0,0:06:53.64,0:06:56.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata memang ketahuan, ya.
Dialogue: 0,0:06:56.23,0:06:57.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu?
Dialogue: 0,0:06:58.11,0:07:00.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengejar dari pulau.
Dialogue: 0,0:07:03.40,0:07:06.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, niat membunuhnya sudah sampai ubun-ubun.
Dialogue: 0,0:07:07.78,0:07:09.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satoko menunduk saja.
Dialogue: 0,0:07:09.37,0:07:11.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kutenggelamkan dulu beberapa kapalnya.
Dialogue: 0,0:07:11.37,0:07:12.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?!
Dialogue: 0,0:07:12.16,0:07:14.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil melawan jumlah sebanyak itu!
Dialogue: 0,0:07:14.41,0:07:16.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita teruskan lari saja!
Dialogue: 0,0:07:17.08,0:07:19.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak mau aku mati?
Dialogue: 0,0:07:22.34,0:07:26.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak ingin kamu mati!\NPokoknya tidak!
Dialogue: 0,0:07:34.14,0:07:35.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja.
Dialogue: 0,0:07:36.39,0:07:38.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku janji tidak akan mati.
Dialogue: 0,0:07:39.44,0:07:40.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu saja.
Dialogue: 0,0:07:40.65,0:07:42.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan cepat selesai, kok.
Dialogue: 0,0:07:44.49,0:07:46.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Shinpei!
Dialogue: 0,0:07:52.20,0:07:56.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak kusangka kau mencoba kabur dari pulau.
Dialogue: 0,0:07:56.21,0:07:59.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal kau bisa bilang saja padaku.
Dialogue: 0,0:07:59.71,0:08:01.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alah.
Dialogue: 0,0:08:01.04,0:08:02.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya bakal kau biarkan lari?
Dialogue: 0,0:08:02.71,0:08:05.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan langsung kubunuh di sana.
Dialogue: 0,0:08:07.38,0:08:11.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian semua, jangan biarkan mereka\Nkabur hidup-hidup dari pulau!
Dialogue: 0,0:08:11.80,0:08:13.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bunuh dia!
Dialogue: 0,0:08:42.28,0:08:44.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma menang badan gede, ya?
Dialogue: 0,0:08:54.14,0:08:55.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan takut...
Dialogue: 0,0:08:55.56,0:08:56.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, tahu!
Dialogue: 0,0:08:56.93,0:09:00.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya saja, itu bukan manusia...
Dialogue: 0,0:09:02.31,0:09:03.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi iblis!
Dialogue: 0,0:09:04.40,0:09:05.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Goto!
Dialogue: 0,0:09:05.57,0:09:08.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kubalas dendam atas lengan kiriku!
Dialogue: 0,0:09:10.78,0:09:12.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia siapa, ya?
Dialogue: 0,0:09:18.12,0:09:20.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mundur saja, Mitsueda.
Dialogue: 0,0:09:20.66,0:09:24.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau anak buahmu habis lebih banyak lagi,\Nnanti tidak bisa kerja, kan?
Dialogue: 0,0:09:29.67,0:09:31.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada yang habis, tuh.
Dialogue: 0,0:09:37.43,0:09:40.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tidak membunuh seorang pun?
Dialogue: 0,0:09:41.06,0:09:44.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti apa pun orangnya,\Ntidak boleh kamu bunuh.
Dialogue: 0,0:09:45.36,0:09:49.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan, karena omonganku waktu itu?
Dialogue: 0,0:09:49.15,0:09:51.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dirimu tidak seperti biasanya.
Dialogue: 0,0:09:51.57,0:09:53.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau ini kenapa sebenarnya?
Dialogue: 0,0:09:53.99,0:09:57.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betulan sudah dibikin jinak sama wanita, ya?
Dialogue: 0,0:09:57.49,0:10:00.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, kembalilah, Goto.
Dialogue: 0,0:10:00.91,0:10:03.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak perlu mati, kan?
Dialogue: 0,0:10:06.75,0:10:07.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei!
Dialogue: 0,0:10:08.34,0:10:09.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lepaskan!
Dialogue: 0,0:10:13.59,0:10:15.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bikin repot saja!
Dialogue: 0,0:10:15.68,0:10:17.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurut saja!
Dialogue: 0,0:10:22.73,0:10:25.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Shinpei, ayo lari selagi sempat!
Dialogue: 0,0:10:50.59,0:10:52.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Shinpei!
Dialogue: 0,0:10:52.01,0:10:53.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya ampun!
Dialogue: 0,0:10:53.42,0:10:54.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak apa-apa?!
Dialogue: 0,0:10:59.47,0:11:01.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sentuh dia!
Dialogue: 0,0:11:07.27,0:11:08.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Shinpei!
Dialogue: 0,0:11:08.86,0:11:10.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Shinpei!
Dialogue: 0,0:11:10.77,0:11:12.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Shinpei...
Dialogue: 0,0:11:15.86,0:11:18.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satoko...
Dialogue: 0,0:11:20.24,0:11:21.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya?
Dialogue: 0,0:11:22.83,0:11:24.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan ku...
Dialogue: 0,0:11:25.91,0:11:29.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kuberikan jantungku...
Dialogue: 0,0:11:46.60,0:11:48.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Shinpei!
Dialogue: 0,0:11:48.44,0:11:49.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Shinpei!
Dialogue: 0,0:11:50.11,0:11:51.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minggir!
Dialogue: 0,0:11:53.19,0:11:56.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Singkirkan kakimu!
Dialogue: 0,0:12:01.12,0:12:03.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minggir...
Dialogue: 0,0:12:03.70,0:12:05.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minggir sana!
Dialogue: 0,0:12:08.17,0:12:10.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cukup, Shido.
Dialogue: 0,0:12:11.21,0:12:14.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Shinpei!
Dialogue: 0,0:12:14.59,0:12:16.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona kenapa, sih?
Dialogue: 0,0:12:16.55,0:12:19.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau dia mati juga bukan urusanmu, kan?
Dialogue: 0,0:12:22.72,0:12:24.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sudah tidak bisa diharapkan.
Dialogue: 0,0:12:25.31,0:12:29.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih baik segera dihabisi\Nagar tidak menderita.
Dialogue: 0,0:12:54.50,0:12:56.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia malah kabur?!
Dialogue: 0,0:12:57.38,0:12:58.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biarkan.
Dialogue: 0,0:12:58.42,0:13:00.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil bisa kembali hidup-hidup\Ndengan luka itu.
Dialogue: 0,0:13:00.84,0:13:03.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, Bos!\NDaya hidupnya tidak seperti orang biasa!
Dialogue: 0,0:13:03.51,0:13:05.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kubilang biar saja.
Dialogue: 0,0:13:06.64,0:13:08.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biarkan saja.
Dialogue: 0,0:13:19.03,0:13:23.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pernikahan Kunang-kunang
Dialogue: 0,0:13:23.49,0:13:26.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Shinpei!
Dialogue: 0,0:13:32.04,0:13:33.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya Tuhan...
Dialogue: 0,0:13:33.88,0:13:35.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan sudah...
Dialogue: 0,0:13:35.54,0:13:37.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, tenang dulu.
Dialogue: 0,0:13:37.92,0:13:40.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa, ini tidak apa-apa.
Dialogue: 0,0:13:40.34,0:13:43.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya air di tubuhnya\Nharus dikeluarkan dulu.
Dialogue: 0,0:13:43.05,0:13:45.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ingat yang pernah diberi tahu dokter...
Dialogue: 0,0:13:45.60,0:13:47.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cara itu...
Dialogue: 0,0:13:53.56,0:13:56.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon, bukalah matamu!
Dialogue: 0,0:14:00.24,0:14:01.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Shinpei!
Dialogue: 0,0:14:05.57,0:14:07.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo berhenti!
Dialogue: 0,0:14:08.24,0:14:10.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhenti, berhenti, ayo berhenti!
Dialogue: 0,0:14:10.95,0:14:12.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satoko!
Dialogue: 0,0:14:15.58,0:14:16.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aoi?!
Dialogue: 0,0:14:20.80,0:14:22.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lumayan parah juga.
Dialogue: 0,0:14:22.72,0:14:25.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luka di punggungnya lumayan dalam.
Dialogue: 0,0:14:25.72,0:14:29.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untung luka yang di perut\Nkelihatannya tidak melukai organ dalam.
Dialogue: 0,0:14:29.51,0:14:33.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tulangnya juga remuk di sana-sini,\Nmasih hidup saja sudah ajaib.
Dialogue: 0,0:14:34.98,0:14:35.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar.
Dialogue: 0,0:14:35.98,0:14:38.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa bisa jadi begini?
Dialogue: 0,0:14:43.82,0:14:45.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suhu badannya juga lumayan rendah.
Dialogue: 0,0:14:45.74,0:14:49.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begini terus,\Nkemungkinan dia meninggal cukup tinggi.
Dialogue: 0,0:14:52.29,0:14:54.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti kuperiksa lagi kondisinya.
Dialogue: 0,0:14:55.83,0:14:57.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedang apa kalian ini?!
Dialogue: 0,0:14:57.75,0:14:59.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat bersiap sana!
Dialogue: 0,0:14:59.38,0:15:01.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satoko.
Dialogue: 0,0:15:01.42,0:15:02.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aoi.
Dialogue: 0,0:15:03.34,0:15:06.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat berterima kasih\Nkamu sudah datang.
Dialogue: 0,0:15:06.34,0:15:07.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak usah.
Dialogue: 0,0:15:07.59,0:15:11.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma merasa kesepian,\Njadi ingin mengantar kepergian kalian.
Dialogue: 0,0:15:16.02,0:15:18.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satoko, ayo percaya dan tunggu saja!
Dialogue: 0,0:15:18.81,0:15:21.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Shinpei pasti tidak apa-apa.
Dialogue: 0,0:15:21.65,0:15:25.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu itu dia juga terluka parah,\Ntapi pulih begitu cepat sampai sulit dipercaya...
Dialogue: 0,0:15:53.68,0:15:55.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, anak baru.
Dialogue: 0,0:15:55.31,0:15:57.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Shinpei sudah siuman atau belum?
Dialogue: 0,0:16:02.11,0:16:04.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih belum.
Dialogue: 0,0:16:04.28,0:16:07.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah hari ketujuh, kan?\NKondisinya bagaimana?
Dialogue: 0,0:16:07.78,0:16:09.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum berubah.
Dialogue: 0,0:16:09.36,0:16:11.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar aku gantian yang mengurusnya.
Dialogue: 0,0:16:11.62,0:16:13.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sementara itu, kau tidur siang sana.
Dialogue: 0,0:16:13.83,0:16:17.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, aku lebih cakap daripada dirimu.
Dialogue: 0,0:16:18.50,0:16:20.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih atas perhatiannya.
Dialogue: 0,0:16:21.46,0:16:23.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku ingin di sisinya.
Dialogue: 0,0:16:26.42,0:16:28.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajahnya itu...
Dialogue: 0,0:16:28.17,0:16:30.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya yang sekarat itu siapa, sih?
Dialogue: 0,0:16:30.80,0:16:32.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar tidak ada manis-manisnya.
Dialogue: 0,0:16:32.97,0:16:35.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa tidak kelihatan panik sedikit saja?
Dialogue: 0,0:16:36.73,0:16:39.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak bisa, ya tidak akan bisa.
Dialogue: 0,0:16:39.39,0:16:42.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manusia itu memang rapuh.
Dialogue: 0,0:17:33.32,0:17:37.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa sangka, kita bisa keluar dari pulau ini\Ndengan aman naik kapal!
Dialogue: 0,0:17:37.58,0:17:38.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh iya!
Dialogue: 0,0:17:38.45,0:17:39.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah keluar dari sini,
Dialogue: 0,0:17:39.50,0:17:42.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ayo bangun rumah di tempat\Nyang tiap tahun didatangi kunang-kunang.
Dialogue: 0,0:17:42.71,0:17:46.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sakit, aku berdarah...
Dialogue: 0,0:17:46.00,0:17:50.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dibanding aku,\Nluka Satoko tidak ada apa-apanya.
Dialogue: 0,0:17:50.05,0:17:53.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jantung ini sudah jadi milik Satoko.
Dialogue: 0,0:17:53.89,0:17:56.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pasti tidak akan mati, kok.
Dialogue: 0,0:17:56.55,0:17:59.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang bertugas melindungi Satoko itu aku.
Dialogue: 0,0:18:00.18,0:18:04.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di mana pun berada,\Nakan kubuat Satoko jadi bebas.
Dialogue: 0,0:18:51.65,0:18:53.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini surga?
Dialogue: 0,0:19:03.50,0:19:04.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satoko...
Dialogue: 0,0:19:07.92,0:19:08.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak terluka?
Dialogue: 0,0:19:08.96,0:19:10.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bangun!
Dialogue: 0,0:19:10.04,0:19:11.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak apa-apa, kok!
Dialogue: 0,0:19:11.84,0:19:13.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, akan kupanggilkan orang...
Dialogue: 0,0:19:16.97,0:19:18.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, ya.
Dialogue: 0,0:19:18.43,0:19:20.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lain kali pasti akan lancar.
Dialogue: 0,0:19:21.85,0:19:23.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah kenapa selama ini
Dialogue: 0,0:19:24.06,0:19:27.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebelah badanku terasa hangat.
Dialogue: 0,0:19:28.10,0:19:31.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satoko yang sudah menghangatkannya, ya.
Dialogue: 0,0:19:32.11,0:19:33.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang.
Dialogue: 0,0:19:34.07,0:19:37.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Satoko di sampingku seperti itu,
Dialogue: 0,0:19:37.49,0:19:40.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin mati seperti itu pun tidak masalah.
Dialogue: 0,0:19:42.91,0:19:46.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak butuh jantungmu...
Dialogue: 0,0:19:47.00,0:19:49.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, kau bilang apa?
Dialogue: 0,0:19:50.38,0:19:53.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak butuh jantungmu!
Dialogue: 0,0:19:54.34,0:19:57.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya mati pun tidak masalah?!
Dialogue: 0,0:19:57.84,0:20:02.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benci sekali candaanmu\Nyang tidak pantas itu!
Dialogue: 0,0:20:12.48,0:20:15.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal kamu bilang tidak akan mati!
Dialogue: 0,0:20:15.99,0:20:17.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya aku percaya!
Dialogue: 0,0:20:17.99,0:20:21.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya juga bilang\Nmungkin tidak akan siuman!
Dialogue: 0,0:20:21.28,0:20:25.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya, aku begitu takut!
Dialogue: 0,0:20:40.64,0:20:41.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei...
Dialogue: 0,0:20:41.43,0:20:43.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Tuan Shinpei!
Dialogue: 0,0:20:43.68,0:20:44.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kamu...
Dialogue: 0,0:20:46.85,0:20:49.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}He-Hentikan, jangan lakukan ini...
Dialogue: 0,0:20:49.31,0:20:53.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tu-Tuan Shinpei, kumohon...
Dialogue: 0,0:21:00.82,0:21:04.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Uwah!
Dialogue: 0,0:21:05.49,0:21:06.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?!
Dialogue: 0,0:21:06.49,0:21:08.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan Tuan Shinpei...!
Dialogue: 0,0:21:10.37,0:21:12.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Ini...
Dialogue: 0,0:21:13.38,0:21:15.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata dia segar bugar begitu.
Dialogue: 0,0:21:15.55,0:21:19.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Da-Da-Dasar...
Dialogue: 0,0:21:19.05,0:21:21.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wanita licik!
