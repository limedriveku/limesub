Dialogue: 0,0:00:31.88,0:00:33.06,sign,,0000,0000,0000,,ISEKICHI
Dialogue: 0,0:01:02.06,0:01:04.43,sign,,0000,0000,0000,,"BAJU GANTINYA KUTARUH DI SINI, YA"
Dialogue: 0,0:01:05.51,0:01:05.97,sign,,0000,0000,0000,,PASTI TAKUT, BIAR KUTEMANI TIDUR, YA
Dialogue: 0,0:01:46.85,0:01:48.63,sign,,0000,0000,0000,,MENDELIK
Dialogue: 0,0:04:00.02,0:04:02.52,sign,,0000,0000,0000,,"TIKUS YANG MENGAWASI"
Dialogue: 0,0:13:15.46,0:13:16.87,sign,,0000,0000,0000,,AKAN KUAWASI DARI SINI
Dialogue: 0,0:00:06.55,0:00:11.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya ada satu cara agar wanita\Nbisa keluar dari pulau ini.
Dialogue: 0,0:00:11.60,0:00:14.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin Satoko menjadi pelacur.
Dialogue: 0,0:00:16.60,0:00:20.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi lega setelah memahami\Nsituasi yang kualami sekarang.
Dialogue: 0,0:00:20.75,0:00:25.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi mendapat lebih banyak informasi\Ndan sekutu, aku tidak boleh terus ragu.
Dialogue: 0,0:00:26.60,0:00:28.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Antarkan aku ke rumah bordil!
Dialogue: 0,0:00:33.96,0:00:36.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini tempatnya?
Dialogue: 0,0:00:37.47,0:00:40.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesannya berbeda dari tempat lain.
Dialogue: 0,0:00:40.42,0:00:41.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya tempat ini
Dialogue: 0,0:00:41.48,0:00:45.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}rumah bordil kelas paling rendah yang mau\Nmempekerjakan siapa saja yang datang.
Dialogue: 0,0:00:45.31,0:00:46.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paling rendah?!
Dialogue: 0,0:00:46.67,0:00:50.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa benar pria yang mampu menebus pelacur\Nakan datang ke sini?!
Dialogue: 0,0:00:50.46,0:00:52.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja.
Dialogue: 0,0:00:56.91,0:00:59.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf untuk kemarin.
Dialogue: 0,0:00:59.68,0:01:01.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal apa?
Dialogue: 0,0:01:01.00,0:01:02.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan!
Dialogue: 0,0:01:02.06,0:01:04.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gara-gara melempar ember padaku di kamar mandi?
Dialogue: 0,0:01:04.43,0:01:05.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan!
Dialogue: 0,0:01:05.98,0:01:08.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau gara-gara tidak membiarkanku\Nmasuk ke futonmu?
Dialogue: 0,0:01:09.91,0:01:11.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu-Bukan.
Dialogue: 0,0:01:11.59,0:01:14.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena sudah membuatmu berjaga\Nsemalam suntuk.
Dialogue: 0,0:01:14.84,0:01:16.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak masalah, kok!
Dialogue: 0,0:01:16.59,0:01:19.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku suka sifat malu-malu kucingmu itu, kok!
Dialogue: 0,0:01:20.04,0:01:24.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Shinpei!\NSudah saya tunggu kedatangan Tuan.
Dialogue: 0,0:01:24.36,0:01:27.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pak Yamamoto, ini gadis yang kumaksud.
Dialogue: 0,0:01:28.96,0:01:30.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senang bertemu Anda.
Dialogue: 0,0:01:31.55,0:01:34.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, ternyata secantik ini...
Dialogue: 0,0:01:34.70,0:01:38.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah titip pesan\Nbahwa aku akan membawa anak baru
Dialogue: 0,0:01:39.10,0:01:40.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kepada mereka.
Dialogue: 0,0:01:42.27,0:01:45.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka semua yang kemarin...
Dialogue: 0,0:01:49.23,0:01:52.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, sepertinya mereka\Ntidak menerimaku dengan ikhlas.
Dialogue: 0,0:01:52.74,0:01:56.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu,\Nkelihatannya dia sangat disegani.
Dialogue: 0,0:01:56.96,0:01:59.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa mereka tidak tahu kalau\Ndia pembunuh bayaran?
Dialogue: 0,0:01:59.86,0:02:03.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pria ini sebenarnya siapa?
Dialogue: 0,0:02:03.74,0:02:05.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kau!
Dialogue: 0,0:02:05.64,0:02:09.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita urus dulu kimono lusuhmu itu!
Dialogue: 0,0:02:13.18,0:02:15.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf sudah menunggu lama.
Dialogue: 0,0:03:57.38,0:03:59.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pernikahan Kunang-kunang
Dialogue: 0,0:04:00.02,0:04:02.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, Satoko!
Dialogue: 0,0:04:02.52,0:04:05.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau cantik sekali!
Dialogue: 0,0:04:09.53,0:04:14.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harus membiarkanmu pergi menemui pria lain,\Nrasanya bikin hatiku sakit.
Dialogue: 0,0:04:14.67,0:04:17.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya ingin kusembunyikan kau\Ndari pandangan orang lain
Dialogue: 0,0:04:17.81,0:04:21.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan memiliki Satoko\Nuntuk diriku sendiri selamanya.
Dialogue: 0,0:04:23.86,0:04:27.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, mau bagaimana lagi.\NIni demi masa depan kita berdua.
Dialogue: 0,0:04:28.18,0:04:30.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya sudah, ayo pergi.
Dialogue: 0,0:04:30.21,0:04:31.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pergi ke mana?
Dialogue: 0,0:04:31.55,0:04:33.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pergi menyapa pelangganmu.
Dialogue: 0,0:04:34.79,0:04:36.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Langsung sekarang?!
Dialogue: 0,0:04:36.27,0:04:37.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu sebentar!
Dialogue: 0,0:04:37.71,0:04:39.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya orangnya seperti apa?
Dialogue: 0,0:04:39.85,0:04:42.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namanya Nitobe Eishin.
Dialogue: 0,0:04:42.17,0:04:44.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia putra kepala kepolisian.
Dialogue: 0,0:04:44.27,0:04:47.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pu-Putra kepala kepolisian?!
Dialogue: 0,0:04:47.26,0:04:49.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, keren, kan?
Dialogue: 0,0:04:49.82,0:04:52.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya saja, dia sedikit bermasalah.
Dialogue: 0,0:04:53.06,0:04:56.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadinya, dia dicekal\Nhampir semua rumah bordil di pulau ini.
Dialogue: 0,0:04:56.66,0:04:57.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dicekal?!
Dialogue: 0,0:05:01.24,0:05:03.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak usah cemas.
Dialogue: 0,0:05:03.07,0:05:05.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia cuma agak lupa diri kalau mabuk,
Dialogue: 0,0:05:05.38,0:05:07.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku sudah minta\Nagar dia tidak disuguhi alkohol.
Dialogue: 0,0:05:07.87,0:05:09.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:05:09.87,0:05:12.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti aku harus pelan-pelan mendekatinya...
Dialogue: 0,0:05:12.70,0:05:14.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak akan bertemu dia berkali-kali.
Dialogue: 0,0:05:14.58,0:05:16.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesempatannya cuma sekali, hari ini saja.
Dialogue: 0,0:05:16.86,0:05:18.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau gagal, ya sudah selesai.
Dialogue: 0,0:05:18.90,0:05:21.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma sekali?!
Dialogue: 0,0:05:21.58,0:05:25.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak tertarik padamu,\Ndia bakal pergi ke rumah bordil lain.
Dialogue: 0,0:05:25.62,0:05:30.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rumah bordil kelas rendah seperti ini\Njarang didatangi tamu berada.
Dialogue: 0,0:05:31.02,0:05:36.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau tidak mau, kita harus menyerah\Ndan bersembunyi di pulau ini selamanya.
Dialogue: 0,0:05:36.34,0:05:39.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, mungkin itu tidak buruk juga.
Dialogue: 0,0:05:39.71,0:05:42.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dia terus berada dalam bahaya,
Dialogue: 0,0:05:42.22,0:05:47.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin aku bisa jadi sosok\Nyang selalu dibutuhkan Satoko.
Dialogue: 0,0:05:49.07,0:05:52.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana bisa aku hidup selamanya\Ndengan pria seperti ini...
Dialogue: 0,0:05:53.02,0:05:54.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah!
Dialogue: 0,0:05:54.87,0:05:58.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kubuat ini berhasil agar kita\Nbisa segera keluar dari pulau ini!
Dialogue: 0,0:05:58.79,0:06:02.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti aku harus mulai dengan\Nmembuatnya merasa nyaman dulu.
Dialogue: 0,0:06:02.03,0:06:03.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau anak kepala kepolisian,
Dialogue: 0,0:06:03.63,0:06:06.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pasti banyak kekangan dan batasan\Ndalam kesehariannya.
Dialogue: 0,0:06:06.66,0:06:09.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin karena mentalnya terbebani,\Ndia melampiaskannya lewat alkohol.
Dialogue: 0,0:06:09.91,0:06:11.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kali ini dia tidak akan disuguhi alkohol.\N- Satoko?
Dialogue: 0,0:06:11.44,0:06:14.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku harus membuatnya\Nmau bicara terbuka,
Dialogue: 0,0:06:14.21,0:06:15.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu menawarkan diri untuk
Dialogue: 0,0:06:15.19,0:06:18.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tidak usah terlalu serius begitu, kok.\N- mendengarkan cerita dan masalah yang biasanya
Dialogue: 0,0:06:18.26,0:06:20.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Lagi pula, Satoko tetaplah istriku...\N- tidak diceritakan ke orang lain.
Dialogue: 0,0:06:20.30,0:06:22.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong lupakan itu dulu sebentar!
Dialogue: 0,0:06:22.59,0:06:24.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, apa maksudnya itu?
Dialogue: 0,0:06:24.41,0:06:28.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana bisa ini berjalan lancar kalau\Ndi kepalaku masih ada pria lain.
Dialogue: 0,0:06:28.17,0:06:31.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini aku hanya ingin memikirkan\Ntamuku nanti.
Dialogue: 0,0:06:31.01,0:06:34.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bisa memahami perasaannya,\Npeluang pasti akan terbuka.
Dialogue: 0,0:06:34.06,0:06:37.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tapi, memaksanya membuka hati itu tidak baik.\N- Ah, kok aku jadi tidak suka begini, ya.
Dialogue: 0,0:06:37.39,0:06:39.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Jadi, aku harus bersiap matang agar dia mau terbuka,\N- Memang baiknya kubunuh saja dia
Dialogue: 0,0:06:39.82,0:06:41.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- lalu dengan senyuman...\N- lalu hidup selamanya sama Satoko...
Dialogue: 0,0:06:41.39,0:06:43.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong diam sebentar!
Dialogue: 0,0:06:43.31,0:06:45.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu yang punya ide agar aku ditebus!
Dialogue: 0,0:06:45.95,0:06:47.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan apa-apa diselesaikan dengan kekerasan
Dialogue: 0,0:06:47.98,0:06:50.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan cobalah lebih bertanggung jawab\Npada ucapanmu!
Dialogue: 0,0:06:50.77,0:06:53.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kali ini serahkan saja padaku\Ndan jangan ganggu!
Dialogue: 0,0:06:53.65,0:06:54.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Anu...
Dialogue: 0,0:06:55.10,0:06:57.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pasti akan keluar hidup-hidup\Ndari pulau ini.
Dialogue: 0,0:06:57.95,0:06:59.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu menikah!
Dialogue: 0,0:07:08.83,0:07:12.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku baru saja dilamar?!
Dialogue: 0,0:07:14.63,0:07:16.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa dia akan baik-baik saja.
Dialogue: 0,0:07:17.29,0:07:19.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Toh kami juga sudah berhati-hati.
Dialogue: 0,0:07:23.09,0:07:24.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga saja begitu.
Dialogue: 0,0:07:30.35,0:07:32.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi tegang.
Dialogue: 0,0:07:32.85,0:07:35.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau ternyata\Norangnya sangat seram?
Dialogue: 0,0:07:36.05,0:07:38.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan malah pesimis begitu!
Dialogue: 0,0:07:38.19,0:07:41.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimanapun orangnya,\Nharus kubuat dia jatuh hati padaku.
Dialogue: 0,0:07:44.73,0:07:47.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya anak baru bernama Satoko.
Dialogue: 0,0:07:47.94,0:07:50.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bolehkah saya menyambut Anda?
Dialogue: 0,0:07:51.83,0:07:54.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, masuklah.
Dialogue: 0,0:08:03.66,0:08:05.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus duduk di mana...
Dialogue: 0,0:08:05.93,0:08:07.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan cuma di pojok begitu.
Dialogue: 0,0:08:07.93,0:08:08.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sini... ah!
Dialogue: 0,0:08:09.43,0:08:10.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh!
Dialogue: 0,0:08:11.27,0:08:12.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anda tidak apa-apa?
Dialogue: 0,0:08:12.63,0:08:13.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar saya lap.
Dialogue: 0,0:08:16.35,0:08:17.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:08:19.29,0:08:23.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhadapan dengan wanita cantik\Nmembuatku tegang.
Dialogue: 0,0:08:24.87,0:08:26.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini mungkin berhasil!
Dialogue: 0,0:08:29.41,0:08:32.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku telanjur membayangkan\Norangnya sudah biasa main ke rumah bordil.
Dialogue: 0,0:08:33.75,0:08:36.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begini, aku mungkin...
Dialogue: 0,0:08:36.01,0:08:37.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namamu Satoko, ya.
Dialogue: 0,0:08:37.65,0:08:39.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, benar!
Dialogue: 0,0:08:39.01,0:08:41.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah berapa lama kerja di sini?
Dialogue: 0,0:08:41.82,0:08:42.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm...
Dialogue: 0,0:08:43.42,0:08:45.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya baru hari ini.
Dialogue: 0,0:08:46.31,0:08:47.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh...
Dialogue: 0,0:08:50.10,0:08:52.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Obrolannya tidak mengalir!
Dialogue: 0,0:08:52.27,0:08:55.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus cari topik...
Dialogue: 0,0:08:55.01,0:08:57.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak usah tegang seperti itu.
Dialogue: 0,0:08:57.83,0:08:59.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mo-Mohon maaf...
Dialogue: 0,0:09:01.43,0:09:04.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang tegang justru aku, ya.
Dialogue: 0,0:09:05.11,0:09:08.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin karena pekerjaanku\Nbiasanya penuh kekangan,
Dialogue: 0,0:09:08.55,0:09:11.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi cuma di sini aku bisa santai.
Dialogue: 0,0:09:11.43,0:09:17.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu aku juga ingin para pelacur\Nbisa menikmati waktu mereka bersamaku.
Dialogue: 0,0:09:17.87,0:09:19.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski bilang begitu,
Dialogue: 0,0:09:19.39,0:09:22.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku belum pernah benar-benar\Nmenjalin asmara dengan wanita,
Dialogue: 0,0:09:22.49,0:09:24.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}makanya aku tidak tahu harus berbuat apa.
Dialogue: 0,0:09:25.33,0:09:29.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti karena itulah aku jadi\Nbertingkah aneh setelah minum alkohol.
Dialogue: 0,0:09:29.85,0:09:32.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu aku dianggap pembuat onar di mana-mana.
Dialogue: 0,0:09:33.09,0:09:34.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar memalukan.
Dialogue: 0,0:09:36.81,0:09:38.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia orang yang tulus.
Dialogue: 0,0:09:39.43,0:09:43.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang seperti ini kena cekal?\NSama sekali tidak terbayang olehku.
Dialogue: 0,0:09:45.09,0:09:49.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya juga tidak terbiasa bicara dengan pria.
Dialogue: 0,0:09:50.03,0:09:54.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, ucapan barusan membuat saya\Nsedikit lebih tenang.
Dialogue: 0,0:09:55.71,0:09:57.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:09:59.14,0:10:00.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya?
Dialogue: 0,0:10:00.27,0:10:01.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baguslah.
Dialogue: 0,0:10:02.29,0:10:04.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh kutanyakan sesuatu?
Dialogue: 0,0:10:04.62,0:10:05.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya?
Dialogue: 0,0:10:05.62,0:10:08.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa Satoko bekerja di kedai seperti ini?
Dialogue: 0,0:10:09.25,0:10:14.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena penampilan dan tindak-tandukmu\Nterlihat berkelas.
Dialogue: 0,0:10:14.87,0:10:18.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana ini?\NHarus kujelaskan seperti apa?
Dialogue: 0,0:10:18.54,0:10:21.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa jadi masalah kalau ketahuan\Naku orang luar.
Dialogue: 0,0:10:22.75,0:10:25.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa benar akan jadi masalah?
Dialogue: 0,0:10:25.23,0:10:28.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ayahnya kepala kepolisian,
Dialogue: 0,0:10:28.05,0:10:31.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa mungkin dia mau menolongku\Nkalau kujelaskan situasinya?
Dialogue: 0,0:10:31.50,0:10:35.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya aku bekerja di kepolisian.
Dialogue: 0,0:10:35.53,0:10:38.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu ada masalah,\Nmungkin bisa kubantu.
Dialogue: 0,0:10:38.62,0:10:40.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanpa harus ditebus pun,
Dialogue: 0,0:10:41.17,0:10:44.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin aku bisa segera keluar\Ndari pulau ini.
Dialogue: 0,0:10:44.29,0:10:47.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maukah Anda mendengar cerita saya?!
Dialogue: 0,0:10:49.53,0:10:51.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga.
Dialogue: 0,0:10:51.01,0:10:52.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi begitu ceritanya.
Dialogue: 0,0:10:52.79,0:10:54.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain dengan ditebus,
Dialogue: 0,0:10:54.67,0:10:58.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}saya dengar tidak ada cara lain\Nbagi wanita untuk keluar dari pulau ini.
Dialogue: 0,0:10:58.31,0:10:59.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa benar demikian?
Dialogue: 0,0:11:00.85,0:11:04.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin memang benar begitu.
Dialogue: 0,0:11:04.67,0:11:09.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan polisi pun tidak bisa\Nikut campur urusan di pulau ini.
Dialogue: 0,0:11:09.87,0:11:13.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, padahal tadi kubilang\Nmungkin bisa membantu.
Dialogue: 0,0:11:14.58,0:11:16.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi begitu.
Dialogue: 0,0:11:17.14,0:11:19.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,\Nbagaimana kalau lewat cara itu saja?
Dialogue: 0,0:11:20.67,0:11:22.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar aku yang menebus.
Dialogue: 0,0:11:22.49,0:11:24.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan begitu,\Ndirimu bisa keluar dari pulau ini.
Dialogue: 0,0:11:26.35,0:11:27.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak!
Dialogue: 0,0:11:28.09,0:11:30.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepulangnya ke rumah,\Nsaya janji uang tebusannya...
Dialogue: 0,0:11:30.50,0:11:32.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, bukan seperti itu.
Dialogue: 0,0:11:32.85,0:11:36.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin dirimu jadi istriku secara sah.
Dialogue: 0,0:11:36.55,0:11:39.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya aku jatuh cinta padamu\Npada pandangan pertama.
Dialogue: 0,0:11:41.13,0:11:44.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih atas perasaan Anda.
Dialogue: 0,0:11:44.06,0:11:48.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, seperti saya ceritakan tadi,\Nbadan saya begitu lemah.
Dialogue: 0,0:11:49.42,0:11:52.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya tidak yakin apakah orang tua Anda\Nbisa menerimanya.
Dialogue: 0,0:11:52.85,0:11:55.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kubujuk sampai mereka setuju!
Dialogue: 0,0:11:55.87,0:12:00.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar dokter dari seluruh negeri memeriksamu,\Napa benar penyakitmu tak bisa disembuhkan.
Dialogue: 0,0:12:01.28,0:12:04.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin melindungimu dengan tanganku ini!
Dialogue: 0,0:12:07.16,0:12:08.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menikah...
Dialogue: 0,0:12:09.25,0:12:14.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau calonnya dari keluarga seperti itu,\NAyahanda pasti akan senang.
Dialogue: 0,0:12:14.95,0:12:17.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada alasan untukku menolak...
Dialogue: 0,0:12:18.06,0:12:19.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mencintaimu.
Dialogue: 0,0:12:20.71,0:12:23.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, bagaimana dengan orang itu?
Dialogue: 0,0:12:24.29,0:12:26.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa jadi dia akan mengincar\Nnyawa Tuan Nitobe.
Dialogue: 0,0:12:26.94,0:12:29.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti harus kusampaikan sekarang juga.
Dialogue: 0,0:12:29.65,0:12:33.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ajakan menikah itu hanya demi bertahan hidup,\Nlagi pula dia penjahat kelas kakap.
Dialogue: 0,0:12:33.95,0:12:35.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi tidak perlu kupikirkan.
Dialogue: 0,0:12:37.15,0:12:38.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetapi...
Dialogue: 0,0:12:38.82,0:12:43.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah aku bisa tetap menipu\Norang yang sudah menolongku?
Dialogue: 0,0:12:50.83,0:12:53.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke-Ke-Kenapa kamu ada di situ?!
Dialogue: 0,0:12:53.42,0:12:54.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapan dia masuknya?!
Dialogue: 0,0:12:54.59,0:12:55.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ada sesuatu...
Dialogue: 0,0:12:55.78,0:12:57.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada apa-apa!
Dialogue: 0,0:12:58.27,0:12:59.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ada serangga?
Dialogue: 0,0:12:59.90,0:13:02.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak usah malu segala.
Dialogue: 0,0:13:03.64,0:13:05.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sering muncul di kedai seperti ini, kok.
Dialogue: 0,0:13:05.31,0:13:06.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?!
Dialogue: 0,0:13:06.48,0:13:07.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu setakut itu...
Dialogue: 0,0:13:07.82,0:13:08.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada tikus!
Dialogue: 0,0:13:08.83,0:13:10.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada tikus yang lewat!
Dialogue: 0,0:13:10.69,0:13:11.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja!
Dialogue: 0,0:13:11.86,0:13:14.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak apa-apa, keluar saja sana!
Dialogue: 0,0:13:18.69,0:13:19.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah!
Dialogue: 0,0:13:19.74,0:13:21.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tikusnya lari ke balik sekat lipat!
Dialogue: 0,0:13:21.53,0:13:22.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku takut!
Dialogue: 0,0:13:22.80,0:13:25.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sini, biar kuusir saja.
Dialogue: 0,0:13:25.62,0:13:27.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hayo, kamu ke mana?
Dialogue: 0,0:13:28.24,0:13:29.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada, tuh.
Dialogue: 0,0:13:29.51,0:13:31.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin lari ke pojok sana!
Dialogue: 0,0:13:32.22,0:13:34.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya kubilang serahkan saja padaku?!
Dialogue: 0,0:13:34.46,0:13:37.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Habisnya aku khawatir\Nkau berduaan sama pria.
Dialogue: 0,0:13:37.74,0:13:40.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau satu pun jarinya\Nmenyentuh Satoko.
Dialogue: 0,0:13:41.51,0:13:44.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayolah!\NAku janji enggak bakal ketahuan!
Dialogue: 0,0:13:44.38,0:13:45.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak boleh!
Dialogue: 0,0:13:45.30,0:13:47.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayolah, kumohon! Ya!
Dialogue: 0,0:13:47.39,0:13:50.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi terganggu, keluar sana!
Dialogue: 0,0:13:51.78,0:13:53.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, baiklah.
Dialogue: 0,0:13:54.21,0:13:57.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, setidaknya ingatlah ini.
Dialogue: 0,0:13:57.78,0:14:00.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang bertugas melindungi Satoko\Nitu bukan Nitobe.
Dialogue: 0,0:14:00.86,0:14:01.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melainkan aku.
Dialogue: 0,0:14:04.54,0:14:05.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok tidak ketemu, ya?
Dialogue: 0,0:14:05.95,0:14:08.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin sudah kabur ke luar.
Dialogue: 0,0:14:08.47,0:14:11.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya? Maaf.
Dialogue: 0,0:14:11.26,0:14:12.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kembali ke topik kita.
Dialogue: 0,0:14:13.71,0:14:17.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal tawaran pernikahanku,\Nbagaimana menurutmu?
Dialogue: 0,0:14:21.30,0:14:24.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya terlalu cepat membahas itu\Nkarena kita baru saja bertemu.
Dialogue: 0,0:14:24.15,0:14:28.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya sudah, izinkan aku\Nmemperkenalkan diri lebih jauh lagi.
Dialogue: 0,0:14:37.15,0:14:37.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Nitobe?!
Dialogue: 0,0:14:39.49,0:14:40.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Nitobe!
Dialogue: 0,0:14:43.02,0:14:45.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Airnya sudah kutukar dengan alkohol.
Dialogue: 0,0:14:45.75,0:14:50.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begini, kita bisa berdalih\Nkoki yang salah.
Dialogue: 0,0:14:50.90,0:14:53.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sifatnya yang itu\Nkeluar gara-gara alkohol...
Dialogue: 0,0:14:53.35,0:14:57.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak baru itu pasti tidak akan bisa\Nkeluar dari kamar sampai pagi.
Dialogue: 0,0:14:57.63,0:15:00.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tuan Nitobe, Anda kenapa?!\N- Baru hari pertama, langsung dapat kerjaan berat.
Dialogue: 0,0:15:08.91,0:15:12.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang akan jadi mangsa si cabul kali ini
Dialogue: 0,0:15:12.74,0:15:14.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah gadis itu.
Dialogue: 0,0:15:16.01,0:15:16.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pernikahan Kunang-kunang
Dialogue: 0,0:15:16.95,0:15:19.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang sebenarnya terjadi?
Dialogue: 0,0:15:19.27,0:15:21.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia terlihat sangat berbeda dari tadi...
Dialogue: 0,0:15:29.25,0:15:33.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah lama aku tidak bersenang-senang\Nsaat masih terang begini.
Dialogue: 0,0:15:33.79,0:15:35.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anda mabuk?
Dialogue: 0,0:15:35.62,0:15:37.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong kendalikan diri Anda!
Dialogue: 0,0:15:37.50,0:15:40.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kendalikan diriku, ya?
Dialogue: 0,0:15:41.59,0:15:46.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak dulu Eishin memang dibesarkan\Noleh orang tuanya dengan keras.
Dialogue: 0,0:15:46.34,0:15:50.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pun jadi dewasa tanpa tahu\Nrasanya alkohol dan wanita.
Dialogue: 0,0:15:50.27,0:15:55.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadinya dia tidak tahu caranya\Nmelampiaskan nafsu
Dialogue: 0,0:15:55.05,0:15:58.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu memunculkan kepribadian kedua.
Dialogue: 0,0:15:58.27,0:16:03.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat dia hampir meledak,\Nakan kugiring ke pulau ini
Dialogue: 0,0:16:03.60,0:16:06.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk melepaskan stres tubuh dan pikirannya.
Dialogue: 0,0:16:06.77,0:16:11.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini akibat orang-orang di sekitarnya\Nyang terus menyuruhnya mengendalikan diri.
Dialogue: 0,0:16:12.29,0:16:13.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lepas bajumu.
Dialogue: 0,0:16:14.22,0:16:17.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah menikah,\Nkau akan melayaniku tiap malam.
Dialogue: 0,0:16:18.33,0:16:21.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang coba puaskan aku di sini dulu.
Dialogue: 0,0:16:23.64,0:16:25.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat lepas bajumu!
Dialogue: 0,0:16:25.65,0:16:27.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan buang-buang waktu!
Dialogue: 0,0:16:31.57,0:16:33.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini?
Dialogue: 0,0:16:33.63,0:16:34.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luka?
Dialogue: 0,0:16:34.63,0:16:37.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menjijikkan sekali.
Dialogue: 0,0:16:38.35,0:16:41.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, aku tahu, ini bekas operasi.
Dialogue: 0,0:16:41.74,0:16:42.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong lepaskan.
Dialogue: 0,0:16:42.98,0:16:45.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagi wanita, ini cacat yang fatal.
Dialogue: 0,0:16:45.98,0:16:49.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pria pasti akan kehilangan gairah\Ntiap kali kau buka baju.
Dialogue: 0,0:16:51.73,0:16:54.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sana, hadap belakang.
Dialogue: 0,0:16:55.74,0:16:57.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Punggungmu tidak ada bekas lukanya, ya.
Dialogue: 0,0:16:57.75,0:17:02.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa boleh buat, setiap malam\Nkau menghadap belakang saja.
Dialogue: 0,0:17:02.09,0:17:06.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajahmu menawan,\Nkau juga menyandang nama keluarga Kirigaya.
Dialogue: 0,0:17:06.19,0:17:08.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, soal tebusan tetap kulanjutkan.
Dialogue: 0,0:17:12.10,0:17:15.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kubilang dirimu akan kutebus.
Dialogue: 0,0:17:15.25,0:17:16.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cobalah senang sedikit.
Dialogue: 0,0:17:18.85,0:17:22.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kedai ini tempat berkumpulnya\Npara pelacur bermasalah.
Dialogue: 0,0:17:22.86,0:17:27.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang tampangnya jelek,\Nyang mencoba bunuh diri bersama kekasihnya.
Dialogue: 0,0:17:27.99,0:17:30.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang sudah membunuh pelanggannya.
Dialogue: 0,0:17:30.50,0:17:34.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua barang cacat, membuatku sangat muak!
Dialogue: 0,0:17:34.45,0:17:39.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, begitu kusinggung soal tebusan,\Nmereka langsung mendekat.
Dialogue: 0,0:17:39.37,0:17:44.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka mau menuruti apa pun yang kusuruh,\Nrasanya luar biasa.
Dialogue: 0,0:17:45.03,0:17:49.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketertiban Jepang bisa kacau kalau\Nmereka dikeluarkan dari pulau.
Dialogue: 0,0:17:49.34,0:17:53.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampah tidak seharusnya keluar\Ndari tempat sampah.
Dialogue: 0,0:17:55.02,0:17:57.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Obrolannya jadi melantur.
Dialogue: 0,0:17:57.58,0:17:59.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya aku akan menikahimu.
Dialogue: 0,0:17:59.54,0:18:02.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Toh bagiku itu bukan ide yang buruk.
Dialogue: 0,0:18:02.71,0:18:07.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putra kepala kepolisian dan\Nmenantu keluarga bangsawan Kirigaya.
Dialogue: 0,0:18:07.27,0:18:10.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dapat keduanya,\Naku bisa bergerak lebih leluasa.
Dialogue: 0,0:18:10.15,0:18:13.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seluruh pelacur di pulau ini pun\Nbisa kubeli sepuasnya!
Dialogue: 0,0:18:14.71,0:18:19.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asalkan punya status yang bagus,\NAyahanda pasti bisa tenang.
Dialogue: 0,0:18:20.17,0:18:24.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa pun orangnya,\Naku rela menikah dengannya.
Dialogue: 0,0:18:24.79,0:18:25.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetapi...
Dialogue: 0,0:18:28.29,0:18:32.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Izinkan saya menolak tawaran tebusan Anda.
Dialogue: 0,0:18:34.13,0:18:35.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:18:36.09,0:18:38.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bercanda.
Dialogue: 0,0:18:38.34,0:18:42.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau menikah denganku,\Nkau bisa segera keluar dari sini, lo?
Dialogue: 0,0:18:42.53,0:18:45.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak usah sok kuat, turuti saja aku.
Dialogue: 0,0:18:45.57,0:18:48.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayahanda pasti tidak menginginkan
Dialogue: 0,0:18:48.50,0:18:51.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku menikah dengan pria seperti ini.
Dialogue: 0,0:18:51.06,0:18:52.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, saya tidak bisa membiarkan
Dialogue: 0,0:18:53.45,0:18:56.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}orang rendahan menyandang nama Kirigaya.
Dialogue: 0,0:18:58.21,0:18:59.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berengsek!
Dialogue: 0,0:18:59.87,0:19:05.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paham, tidak? Orang penyakitan sepertimu\Nadalah barang cacat paling busuk!
Dialogue: 0,0:19:05.67,0:19:08.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pikir siapa aku ini?!
Dialogue: 0,0:19:08.01,0:19:10.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berlutut dan minta ampun!
Dialogue: 0,0:19:10.83,0:19:13.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satoko...
Dialogue: 0,0:19:18.86,0:19:20.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku datang menolongmu.
Dialogue: 0,0:19:21.34,0:19:22.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa kau?!
Dialogue: 0,0:19:22.97,0:19:24.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang kedai ini, ya?!
Dialogue: 0,0:19:24.86,0:19:27.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa yang mengizinkanmu masuk ke sini...
Dialogue: 0,0:19:31.93,0:19:35.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Singkirkan dulu tangan kotormu itu.
Dialogue: 0,0:19:38.53,0:19:42.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti katamu,\Nsebaiknya lupakan saja orang ini.
Dialogue: 0,0:19:43.74,0:19:45.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bunuh!
Dialogue: 0,0:19:45.01,0:19:47.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kubunuh kalian berdua!
Dialogue: 0,0:19:47.39,0:19:51.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kubeberkan kalau kau ada di sini!
Dialogue: 0,0:19:53.65,0:19:56.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan mendekat!
Dialogue: 0,0:19:56.43,0:19:57.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan!
Dialogue: 0,0:19:58.18,0:19:59.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bunuh dia!
Dialogue: 0,0:20:04.30,0:20:05.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei!
Dialogue: 0,0:20:07.58,0:20:09.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, sayang sekali.
Dialogue: 0,0:20:09.93,0:20:14.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku tidak tahu cara lain selain\Nmemanfaatkan dia untuk keluar dari pulau.
Dialogue: 0,0:20:15.39,0:20:17.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, mau bagaimana lagi.
Dialogue: 0,0:20:17.58,0:20:21.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penjahat yang melukai istriku\Nmemang harus dihabisi.
Dialogue: 0,0:20:21.99,0:20:23.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah, hentikan!
Dialogue: 0,0:20:23.02,0:20:24.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bisa betulan mati!
Dialogue: 0,0:20:46.59,0:20:49.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kubunuh wanita ini kalau berani mendekat!
Dialogue: 0,0:20:49.07,0:20:51.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Hei, jangan banyak gerak!\N- Shinpei!
Dialogue: 0,0:20:51.26,0:20:53.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong jawab aku!
Dialogue: 0,0:20:54.50,0:20:56.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu suara tembakan.
Dialogue: 0,0:20:56.78,0:20:58.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perlu kita lihat?
Dialogue: 0,0:20:59.35,0:21:00.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan dipikirkan.
Dialogue: 0,0:21:00.89,0:21:05.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau terdengar suara tembakan atau teriakan,
Dialogue: 0,0:21:05.54,0:21:09.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya jangan berani\Nmasuk ke kamar, katanya.
Dialogue: 0,0:21:09.17,0:21:10.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:21:13.06,0:21:16.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya dia tidak mau ada yang mengganggu
Dialogue: 0,0:21:18.33,0:21:23.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kesempatan untuk membuat orang\Nyang dia cintai makin cinta padanya.
