Dialogue: 0,0:00:04.98,0:00:07.74,sign,,0000,0000,0000,,ISEKICHI
Dialogue: 0,0:03:20.97,0:03:21.92,sign,,0000,0000,0000,,PERASAAN JUJUR
Dialogue: 0,0:09:50.36,0:09:51.70,sign,,0000,0000,0000,,ISEKICHI
Dialogue: 0,0:20:02.22,0:20:04.72,sign,,0000,0000,0000,,ISEKICHI
Dialogue: 0,0:22:11.02,0:22:13.73,sign,,0000,0000,0000,,BEBERAPA BULAN KEMUDIAN
Dialogue: 0,0:00:08.10,0:00:09.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya sudah, selamat istirahat.
Dialogue: 0,0:00:12.45,0:00:13.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:00:13.58,0:00:14.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau tidur bareng?
Dialogue: 0,0:00:14.70,0:00:15.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mau!
Dialogue: 0,0:00:15.91,0:00:17.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat istirahat!
Dialogue: 0,0:00:24.17,0:00:26.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dimaafkan.
Dialogue: 0,0:00:27.13,0:00:29.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah tidak peduli lagi.
Dialogue: 0,0:00:29.34,0:00:32.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asal Satoko berada di sampingku.
Dialogue: 0,0:00:32.18,0:00:36.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal sudah kubohongi,\Ntapi dia ternyata masih mau menolongku.
Dialogue: 0,0:00:36.93,0:00:40.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal banyak yang harus dipikirkan.
Dialogue: 0,0:00:41.56,0:00:47.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak kusangka aku akan sebahagia ini\Nhanya karena dia tidak meninggalkanku.
Dialogue: 0,0:00:55.99,0:00:56.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei.
Dialogue: 0,0:00:58.58,0:00:59.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sedang mengintip?
Dialogue: 0,0:00:59.91,0:01:02.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jelek sekali hobimu.
Dialogue: 0,0:01:02.04,0:01:03.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mitsueda.
Dialogue: 0,0:01:04.09,0:01:05.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah lama sejak waktu itu, ya.
Dialogue: 0,0:01:06.30,0:01:07.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada perlu apa?
Dialogue: 0,0:01:07.38,0:01:12.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kasar sekali bicaramu,\Npadahal kau sudah menghabisi banyak anak buahku.
Dialogue: 0,0:01:12.76,0:01:14.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau kita pindah tempat?
Dialogue: 0,0:01:14.30,0:01:17.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti runyam kalau sampai dilihat si Nona.
Dialogue: 0,0:01:26.94,0:01:28.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama sekali tidak bisa tidur.
Dialogue: 0,0:01:33.07,0:01:35.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Shinpei?
Dialogue: 0,0:01:42.37,0:01:44.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang kembali.
Dialogue: 0,0:03:18.39,0:03:20.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pernikahan Kunang-kunang
Dialogue: 0,0:03:21.93,0:03:25.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mengajak Tuan Shinpei ke gudang, ya?
Dialogue: 0,0:03:25.56,0:03:29.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelihatannya pendiam,\Ntapi lacur sekali kelakuanmu.
Dialogue: 0,0:03:29.06,0:03:31.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak baru tapi sudah sok hebat.
Dialogue: 0,0:03:31.94,0:03:34.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Shinpei itu milikku.
Dialogue: 0,0:03:34.74,0:03:39.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Supaya tidak berulah lagi,\Nbiar kututup mulut bawahmu itu.
Dialogue: 0,0:03:39.24,0:03:40.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu sebentar!\NAku tidak...
Dialogue: 0,0:03:40.87,0:03:41.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berisik!
Dialogue: 0,0:03:41.78,0:03:44.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku paling benci orang sepertimu!
Dialogue: 0,0:03:44.41,0:03:47.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersikap manis buat mendekati Tuan Shinpei!
Dialogue: 0,0:03:47.54,0:03:48.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa saja...!
Dialogue: 0,0:03:49.88,0:03:52.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kutusuk matamu kalau teriak.
Dialogue: 0,0:03:53.17,0:03:55.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka benar-benar serius?
Dialogue: 0,0:03:59.30,0:04:02.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, Yukari, yakin tidak masalah?
Dialogue: 0,0:04:02.81,0:04:06.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sampai ketahuan, bukankah nanti\Nkita yang bakal dapat masalah...
Dialogue: 0,0:04:06.56,0:04:07.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:04:07.27,0:04:09.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian tidak mau menurut sama omonganku?
Dialogue: 0,0:04:10.40,0:04:11.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu-Bukan...
Dialogue: 0,0:04:11.61,0:04:12.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian ini,
Dialogue: 0,0:04:12.61,0:04:16.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ingin berterima kasih karena\Nselalu kubagi pelangganku, kan?
Dialogue: 0,0:04:16.52,0:04:17.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Te-Tentu saja!
Dialogue: 0,0:04:17.74,0:04:19.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja,\Nkita pastikan tidak akan ketahuan.
Dialogue: 0,0:04:21.62,0:04:23.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau saja yang jahit.
Dialogue: 0,0:04:23.28,0:04:24.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:04:24.20,0:04:28.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunjukkan kepatuhanmu kalau ke depannya\Ningin terus ada di dekatku.
Dialogue: 0,0:04:28.71,0:04:32.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau mau coba cari pelanggan\Ndengan usahamu sendiri?
Dialogue: 0,0:04:32.50,0:04:36.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jelas mustahil dengan mukamu itu.
Dialogue: 0,0:04:36.34,0:04:41.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, melihat rupamu yang putus asa\Nkarena tidak dapat pelanggan
Dialogue: 0,0:04:41.09,0:04:43.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}itu tidak buruk juga.
Dialogue: 0,0:04:48.68,0:04:50.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kau tertawakan?
Dialogue: 0,0:04:50.14,0:04:53.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Habisnya, kalau memang sebenci itu,
Dialogue: 0,0:04:53.86,0:04:57.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}seharusnya lakukan saja sendiri\Ntanpa menyuruh orang lain.
Dialogue: 0,0:04:57.53,0:04:58.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maumu?
Dialogue: 0,0:04:58.74,0:05:01.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau bilang aku takut, begitu?
Dialogue: 0,0:05:02.11,0:05:05.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak boleh terus bergantung\Npada perlindungan orang itu.
Dialogue: 0,0:05:05.87,0:05:08.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya aku harus bisa\Nmelindungi diriku sendiri.
Dialogue: 0,0:05:09.12,0:05:13.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kalian pernah merasakan diculik orang?
Dialogue: 0,0:05:14.25,0:05:17.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau dikeroyok?
Dialogue: 0,0:05:19.17,0:05:23.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang benar-benar berniat menyerang,\Nmata dan raut wajahnya berbeda.
Dialogue: 0,0:05:24.05,0:05:26.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada keraguan dalam tindakannya.
Dialogue: 0,0:05:27.56,0:05:29.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tangannya tidak akan gemetar.
Dialogue: 0,0:05:30.64,0:05:32.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah dengar dari Bu Tamaki.
Dialogue: 0,0:05:32.90,0:05:38.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian bertiga sering membuat masalah\Ndan dimasukkan ke kamar hukuman.
Dialogue: 0,0:05:38.40,0:05:40.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kalian tidak pernah membenahi sikap,
Dialogue: 0,0:05:40.94,0:05:43.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}beliau sepertinya sungguh murka.
Dialogue: 0,0:05:43.41,0:05:45.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau nanti membuat masalah lagi,
Dialogue: 0,0:05:45.57,0:05:49.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}katanya beliau bisa jadi tidak kuat\Nmenahan diri dan membunuh kalian.
Dialogue: 0,0:05:50.62,0:05:53.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian akan habis kalau aku\Nmelapor ke Bu Tamaki.
Dialogue: 0,0:05:54.21,0:05:57.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana, Sawarabi, Hatsune?
Dialogue: 0,0:05:58.34,0:06:00.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maukah kalian menolongku?
Dialogue: 0,0:06:00.17,0:06:01.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:06:01.17,0:06:04.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian berdua, tolong tahan Yukari!
Dialogue: 0,0:06:05.64,0:06:07.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bilang apa kau...
Dialogue: 0,0:06:09.01,0:06:11.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira kau mau bilang apa.
Dialogue: 0,0:06:11.52,0:06:14.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pikir mereka akan patuh sama omonganmu?
Dialogue: 0,0:06:14.65,0:06:18.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tamat riwayat kalian kalau berani\Nmelawanku di rumah bordil ini!
Dialogue: 0,0:06:18.32,0:06:21.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada tempat buat pelacur\Nyang tidak bisa dapat pelanggan!
Dialogue: 0,0:06:21.15,0:06:25.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka berakhir di sini karena sama sekali\Ntidak dapat pelanggan di rumah bordilnya dulu.
Dialogue: 0,0:06:25.95,0:06:28.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang kasihan mereka ini.
Dialogue: 0,0:06:28.78,0:06:32.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya aku yang mengasuh mereka.
Dialogue: 0,0:06:32.50,0:06:36.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu sebagai gantinya, mereka akan\Nmenuruti segala permintaanku.
Dialogue: 0,0:06:36.33,0:06:39.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami ini punya ikatan yang begitu dalam.
Dialogue: 0,0:06:39.96,0:06:41.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menggelikan sekali.
Dialogue: 0,0:06:41.55,0:06:44.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti kalau Yukari menyuruh\Nkalian hidup, kalian akan hidup,
Dialogue: 0,0:06:44.41,0:06:46.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan kalau disuruh mati, kalian akan mati?
Dialogue: 0,0:06:47.34,0:06:48.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak segila itu juga...
Dialogue: 0,0:06:48.64,0:06:50.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bertanya padamu.
Dialogue: 0,0:06:52.35,0:06:55.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan biarkan orang seperti ini\Nmenentukan kehendak kalian.
Dialogue: 0,0:06:55.10,0:06:57.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sudah bukan hidup kalian sendiri.
Dialogue: 0,0:06:57.60,0:07:00.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu hidup kita itu terbatas!
Dialogue: 0,0:07:01.78,0:07:04.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berjuanglah dan rebut kembali hidup kalian!
Dialogue: 0,0:07:06.61,0:07:10.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bicara sejahat itu, dong,\Nkasihan mereka.
Dialogue: 0,0:07:10.62,0:07:11.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sama aku...
Dialogue: 0,0:07:11.45,0:07:15.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya Yukari ini\Npelacur yang sehebat itu?
Dialogue: 0,0:07:15.62,0:07:16.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:07:16.83,0:07:19.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ingin memiliki\NTuan Shinpei seorang diri,
Dialogue: 0,0:07:19.29,0:07:22.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kenapa tidak dekati saja dia\Ndengan teknik kebanggaanmu itu?
Dialogue: 0,0:07:23.38,0:07:25.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata dirimu pengecut juga, ya.
Dialogue: 0,0:07:27.09,0:07:31.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saking pengecutnya, kerjamu cuma merendahkan\Ndan menertawakan orang di belakang,
Dialogue: 0,0:07:31.35,0:07:33.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu mengancam supaya bisa berkuasa.
Dialogue: 0,0:07:33.89,0:07:35.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena dirimu seperti itulah,
Dialogue: 0,0:07:35.31,0:07:38.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Shinpei tersayangmu\Ntidak mau melirikmu.
Dialogue: 0,0:07:39.31,0:07:44.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sepertinya tidak paham\Nseperti apa situasimu sekarang, ya?
Dialogue: 0,0:07:47.03,0:07:50.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau sampai kapan kayak begitu,\Ndasar pengecut.
Dialogue: 0,0:07:50.07,0:07:53.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau cukup menurut saja padaku.
Dialogue: 0,0:07:53.33,0:07:55.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hingga selamanya.
Dialogue: 0,0:08:00.33,0:08:03.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lepaskan, dasar bodoh!
Dialogue: 0,0:08:03.42,0:08:06.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hatsune, jangan cuma diam mematung!\NLakukan sesuatu!
Dialogue: 0,0:08:06.42,0:08:09.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekali-kali berguna, dong, dasar bego!
Dialogue: 0,0:08:12.72,0:08:16.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan pikir kalian akan selamat\Nsetelah melakukan ini...
Dialogue: 0,0:08:16.73,0:08:18.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, wah.
Dialogue: 0,0:08:18.14,0:08:21.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah mengerti bagaimana situasimu sekarang?
Dialogue: 0,0:08:21.40,0:08:25.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak enak kalau harus merepotkan Bu Tamaki.
Dialogue: 0,0:08:25.23,0:08:27.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi biar kuurus di sini.
Dialogue: 0,0:08:29.03,0:08:34.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak usah khawatir, aku ini jago menjahit.
Dialogue: 0,0:08:37.40,0:08:41.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak usah waspada begitu,\Naku datang bukan untuk membunuhmu.
Dialogue: 0,0:08:41.41,0:08:44.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru aku datang untuk memperingatkanmu.
Dialogue: 0,0:08:45.13,0:08:50.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau seharusnya tidak perlu\Nmenghajar Nitobe sampai sejauh itu, kan?
Dialogue: 0,0:08:50.43,0:08:52.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu-begitu dia punya jabatan.
Dialogue: 0,0:08:52.80,0:08:56.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa jadi nanti kita yang dirugikan.
Dialogue: 0,0:08:56.01,0:08:59.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Habisnya, dia membuat Satoko tidak nyaman.
Dialogue: 0,0:08:59.18,0:09:00.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sialan.
Dialogue: 0,0:09:00.77,0:09:03.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan kau jatuh hati sama nona itu?
Dialogue: 0,0:09:03.86,0:09:06.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, Mitsueda.
Dialogue: 0,0:09:06.36,0:09:08.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau meragukanku?
Dialogue: 0,0:09:09.74,0:09:11.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, bagaimana...
Dialogue: 0,0:09:13.24,0:09:16.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau misalkan aku bilang iya?
Dialogue: 0,0:09:22.62,0:09:24.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak boleh kamu bunuh.
Dialogue: 0,0:09:40.85,0:09:41.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau pulang.
Dialogue: 0,0:09:47.15,0:09:48.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa dia?
Dialogue: 0,0:09:54.87,0:09:56.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satoko!
Dialogue: 0,0:09:56.37,0:09:58.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku yang salah!
Dialogue: 0,0:09:58.20,0:10:00.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku minta maaf, jadi hentikan!
Dialogue: 0,0:10:01.50,0:10:02.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Shinpei?!
Dialogue: 0,0:10:05.08,0:10:06.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa ini?
Dialogue: 0,0:10:06.42,0:10:07.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, anu...
Dialogue: 0,0:10:07.63,0:10:09.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada apa-apa, kok.
Dialogue: 0,0:10:10.26,0:10:13.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baru kutinggal sebentar,\Nsudah main keroyok bertiga.
Dialogue: 0,0:10:13.84,0:10:16.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga kalian akan mengganggu Satoko.
Dialogue: 0,0:10:16.97,0:10:19.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, ternyata sampai sebodoh ini.
Dialogue: 0,0:10:19.89,0:10:22.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang menukar cangkir minum Nitobe\Nitu juga kalian?
Dialogue: 0,0:10:23.56,0:10:28.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya aku menghentikan kalian\Nsebelum jadi seperti ini.
Dialogue: 0,0:10:35.36,0:10:37.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ini baik-baik saja.
Dialogue: 0,0:10:39.12,0:10:43.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, bukankah paling tidak\Nkita lapor ke Bu Tamaki?
Dialogue: 0,0:10:43.12,0:10:47.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa mereka sudah tidak akan\Nbertindak seperti ini lagi.
Dialogue: 0,0:10:47.75,0:10:50.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka tidak punya\Nkuasa dan nyali untuk itu.
Dialogue: 0,0:10:50.55,0:10:52.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi tidak perlu dilaporkan.
Dialogue: 0,0:10:55.72,0:10:58.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa harus wanita ini?
Dialogue: 0,0:10:58.80,0:11:00.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jahat.
Dialogue: 0,0:11:00.22,0:11:01.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keterlaluan.
Dialogue: 0,0:11:01.97,0:11:04.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benar-benar menyukaimu.
Dialogue: 0,0:11:04.18,0:11:07.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin kamu sedikit saja melirikku.
Dialogue: 0,0:11:07.56,0:11:11.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yukari sudah baik padaku\Ndan aku berterima kasih untuk itu.
Dialogue: 0,0:11:12.07,0:11:14.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, setelah kau\Nmenyakiti Satoko seperti ini,
Dialogue: 0,0:11:14.72,0:11:16.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang ada di kepalaku\Ncuma ingin mencincangmu.
Dialogue: 0,0:11:17.82,0:11:19.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya saja,
Dialogue: 0,0:11:19.32,0:11:21.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perasaanmu itu
Dialogue: 0,0:11:21.70,0:11:24.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kurasa harus kujawab dengan jujur.
Dialogue: 0,0:11:25.08,0:11:28.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama ini, meski itu\Nbukan orang yang kusuka,
Dialogue: 0,0:11:28.54,0:11:31.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku selalu membalas dengan kata-kata manis.
Dialogue: 0,0:11:31.09,0:11:36.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, setelah dibohongi,\Naku jadi tahu betapa sedihnya rasanya.
Dialogue: 0,0:11:36.84,0:11:38.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana, ya?
Dialogue: 0,0:11:38.26,0:11:40.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski bukan sesuatu yang mengenakkan,
Dialogue: 0,0:11:40.14,0:11:44.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku ingin orang yang kusukai\Nbicara jujur padaku.
Dialogue: 0,0:11:45.64,0:11:47.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya, Yukari...
Dialogue: 0,0:11:48.65,0:11:51.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak pernah menganggap\NYukari itu spesial.
Dialogue: 0,0:11:52.48,0:11:53.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, ya.
Dialogue: 0,0:11:56.40,0:11:57.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yukari!
Dialogue: 0,0:12:07.04,0:12:09.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memang tidak boleh lengah\Nwalau cuma sedetik.
Dialogue: 0,0:12:12.34,0:12:15.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak sudah datang menolongku.
Dialogue: 0,0:12:16.26,0:12:22.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, sebisa mungkin aku ingin\Nmelindungi diriku sendiri.
Dialogue: 0,0:12:23.93,0:12:25.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedih...
Dialogue: 0,0:12:26.14,0:12:27.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau jangan jadi kuat, dong.
Dialogue: 0,0:12:29.39,0:12:32.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Masalahnya sudah selesai!
Dialogue: 0,0:12:32.02,0:12:34.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kembali saja ke kamarmu.
Dialogue: 0,0:12:34.32,0:12:35.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih belum selesai, lo.
Dialogue: 0,0:12:35.82,0:12:36.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:12:36.99,0:12:40.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau mengurung kami di gudang?
Dialogue: 0,0:12:40.57,0:12:41.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aoi.
Dialogue: 0,0:12:48.00,0:12:48.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pernikahan Kunang-kunang
Dialogue: 0,0:12:48.80,0:12:49.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aoi?
Dialogue: 0,0:12:49.87,0:12:53.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena tidak membahayakan,\Njadi aku diam saja.
Dialogue: 0,0:12:53.38,0:12:55.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kenapa kau mengurung kami?
Dialogue: 0,0:12:55.38,0:12:59.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya memeriksa keadaan,\Ntidak melakukan apa-apa.
Dialogue: 0,0:12:59.05,0:13:02.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gudang itu terkunci dari luar, lo.
Dialogue: 0,0:13:02.55,0:13:05.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Langkah kaki yang mendekat waktu itu\Njuga langkahmu.
Dialogue: 0,0:13:06.22,0:13:08.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau melakukan itu?
Dialogue: 0,0:13:09.14,0:13:11.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yukari yang salah.
Dialogue: 0,0:13:11.65,0:13:14.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena sudah menggoda kekasih gelapku.
Dialogue: 0,0:13:15.36,0:13:20.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebelum keluar dari sini, aku ingin\Nbalas dendam bagaimanapun caranya.
Dialogue: 0,0:13:20.07,0:13:23.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat Tuan Shinpei makin dekat dengan Satoko,
Dialogue: 0,0:13:23.78,0:13:26.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu kalau Yukari akan kesal.
Dialogue: 0,0:13:27.29,0:13:32.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betapa sakitnya saat orang\Nyang kau sayang direbut,
Dialogue: 0,0:13:32.25,0:13:35.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku ingin dia juga merasakannya.
Dialogue: 0,0:13:39.67,0:13:41.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:13:42.22,0:13:47.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memanfaatkan orang yang sudah akrab denganku\Nuntuk balas dendam itu parah sekali, kan?
Dialogue: 0,0:13:47.14,0:13:49.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa kerjaku sudah mau habis.
Dialogue: 0,0:13:49.89,0:13:54.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Besok aku akan keluar dari sini,\Njadi tolong maafkan aku.
Dialogue: 0,0:13:55.15,0:13:56.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satoko...
Dialogue: 0,0:13:57.61,0:13:59.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, ya.
Dialogue: 0,0:14:02.70,0:14:03.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aoi!
Dialogue: 0,0:14:04.03,0:14:05.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa kerjanya habis?
Dialogue: 0,0:14:05.62,0:14:08.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bicara apa dia, padahal pulau ini\Ntidak punya sistem seperti itu.
Dialogue: 0,0:14:10.20,0:14:14.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama tidak ditebus, pelacur pulau ini\Nsampai mati tidak akan bisa keluar.
Dialogue: 0,0:14:17.96,0:14:19.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satoko?!
Dialogue: 0,0:14:26.51,0:14:29.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelak ayo keluar dari sini\Ndan kita hidup bersama.
Dialogue: 0,0:14:30.97,0:14:33.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mendekati Yukari, kan?
Dialogue: 0,0:14:33.31,0:14:35.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa tidak sama dia saja?!
Dialogue: 0,0:14:35.23,0:14:36.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa yang bilang begitu?
Dialogue: 0,0:14:36.73,0:14:37.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu salah paham!
Dialogue: 0,0:14:37.77,0:14:39.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengarkan aku dulu!
Dialogue: 0,0:14:50.91,0:14:52.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aoi!
Dialogue: 0,0:14:52.79,0:14:55.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan berbuat nekat!
Dialogue: 0,0:14:55.04,0:14:56.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bahaya, cepat kemari...!
Dialogue: 0,0:14:56.58,0:14:58.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan mendekat!
Dialogue: 0,0:14:58.63,0:15:01.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau kembali pun\Nsudah tidak ada harapan di sana.
Dialogue: 0,0:15:01.96,0:15:04.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih baik mati saja.
Dialogue: 0,0:15:04.51,0:15:07.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiap hari diejek karena jelek.
Dialogue: 0,0:15:07.51,0:15:11.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para pria yang mengejekku itu\Nlalu meniduriku cuma karena penasaran.
Dialogue: 0,0:15:11.39,0:15:13.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kucoba untuk menyenangkan mereka.
Dialogue: 0,0:15:14.56,0:15:19.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu, aku masih bisa berjuang\Nkarena ada orang itu.
Dialogue: 0,0:15:20.07,0:15:24.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal mimpiku adalah keluar dari sini\Ndan hidup bersamanya.
Dialogue: 0,0:15:25.45,0:15:29.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi setelah kulabrak karena kabarnya dia\Nberpaling ke Yukari, dia tak pernah datang lagi.
Dialogue: 0,0:15:29.91,0:15:34.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku muak dengan diriku yang bahkan\Ntidak bisa sepenuhnya percaya padanya.
Dialogue: 0,0:15:34.66,0:15:36.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah bosan hidup.
Dialogue: 0,0:15:36.37,0:15:37.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pulang saja sana.
Dialogue: 0,0:15:38.33,0:15:41.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satoko, biarkan saja kalau dia serius.
Dialogue: 0,0:15:41.09,0:15:41.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo pulang.
Dialogue: 0,0:15:41.80,0:15:45.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah kamu bilang ingin kita akrab?!
Dialogue: 0,0:15:45.80,0:15:47.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu menganggap itu serius?
Dialogue: 0,0:15:47.47,0:15:49.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jelas saja aku bohong.
Dialogue: 0,0:15:49.59,0:15:50.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bohong pun tidak masalah!
Dialogue: 0,0:15:51.68,0:15:54.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benar-benar senang dengan\Nperkataanmu waktu itu!
Dialogue: 0,0:15:54.98,0:15:59.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah apa yang kamu pikirkan,\Ntapi aku tetap menganggapmu teman!
Dialogue: 0,0:16:00.98,0:16:03.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aoi, ayo pulang!
Dialogue: 0,0:16:03.61,0:16:06.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar aku yang menjelaskan\Nagar kamu tidak dihukum!
Dialogue: 0,0:16:06.70,0:16:09.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau pulang pun, orang itu sudah tidak ada!
Dialogue: 0,0:16:10.20,0:16:11.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudahlah, cukup.
Dialogue: 0,0:16:11.83,0:16:15.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah memutuskan untuk mati\Nsejak kehilangan dirinya.
Dialogue: 0,0:16:18.00,0:16:22.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lega rasanya bisa melihat\Nmuka Yukari yang seperti tadi.
Dialogue: 0,0:16:22.75,0:16:25.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana caranya aku menghentikan dia?
Dialogue: 0,0:16:25.88,0:16:28.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak peduli apa yang kubilang...
Dialogue: 0,0:16:29.84,0:16:31.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satoko!
Dialogue: 0,0:16:37.52,0:16:38.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bikin iri saja.
Dialogue: 0,0:16:40.48,0:16:43.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jatuh cinta itu memang terbaik.
Dialogue: 0,0:16:43.31,0:16:45.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu menikah saja sama Tuan Shinpei.
Dialogue: 0,0:16:45.78,0:16:48.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak, kamu pasti akan menyesal.
Dialogue: 0,0:16:48.15,0:16:50.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hidupmu nanti jadi sia-sia.
Dialogue: 0,0:16:51.74,0:16:56.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga pernah punya mimpi.
Dialogue: 0,0:16:57.08,0:17:00.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menikah dengan orang yang dicinta\Npasti bahagia rasanya.
Dialogue: 0,0:17:01.42,0:17:04.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, mimpiku jauh lebih penting\Ndaripada cinta.
Dialogue: 0,0:17:04.63,0:17:06.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cinta bukan yang nomor satu bagiku!
Dialogue: 0,0:17:07.67,0:17:10.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf sudah berbohong.
Dialogue: 0,0:17:10.68,0:17:13.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak ingin ada orang lagi\Nyang terluka karena kebohonganku.
Dialogue: 0,0:17:15.18,0:17:16.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:17:16.47,0:17:17.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayang sekali.
Dialogue: 0,0:17:18.18,0:17:20.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau memang seingin itu melompat,\Nsilakan lompat.
Dialogue: 0,0:17:21.81,0:17:24.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sudah tidak ada lagi yang mengganjal.
Dialogue: 0,0:17:24.23,0:17:27.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kau tidak akan menyesal,\Nsilakan akhiri saja.
Dialogue: 0,0:17:28.28,0:17:32.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya saja, aku tidak menyerah.
Dialogue: 0,0:17:32.61,0:17:34.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski mimpiku serasa mau hancur,
Dialogue: 0,0:17:34.57,0:17:37.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tetap akan berjuang\Nhingga saat terakhir.
Dialogue: 0,0:17:38.54,0:17:42.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hingga nyawaku ini terbakar habis!
Dialogue: 0,0:17:43.67,0:17:46.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin impianku masih belum tercapai,
Dialogue: 0,0:17:46.84,0:17:50.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi Aoi benar-benar hebat.
Dialogue: 0,0:17:50.09,0:17:56.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu keras mengejar mimpi\Nsampai rela untuk mati.
Dialogue: 0,0:17:58.10,0:17:59.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya kamu tahu apa?!
Dialogue: 0,0:18:01.14,0:18:02.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan kamu?!
Dialogue: 0,0:18:03.52,0:18:06.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana kutahu perasaan seseorang\Nyang mau melompat untuk mengakhiri hidupnya!
Dialogue: 0,0:18:06.56,0:18:08.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma bisa kuanggap bodoh!
Dialogue: 0,0:18:08.02,0:18:10.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau menurutmu aku bodoh, jangan kejar aku!
Dialogue: 0,0:18:10.61,0:18:13.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski bodoh, kau tetap kuanggap teman!
Dialogue: 0,0:18:13.11,0:18:14.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya aku ikut campur!
Dialogue: 0,0:18:14.95,0:18:18.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekalipun dikhianati seseorang,\Naku tidak akan memilih untuk mati!
Dialogue: 0,0:18:18.58,0:18:20.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan hidup dan membuktikan ke mereka!
Dialogue: 0,0:18:20.45,0:18:23.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan terus hidup dan membuktikan
Dialogue: 0,0:18:23.96,0:18:27.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bahwa aku adalah manusia\Nyang dibutuhkan di dunia ini!
Dialogue: 0,0:18:28.55,0:18:31.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bisa bilang begitu karena percaya diri!
Dialogue: 0,0:18:31.30,0:18:34.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama ini kau bisa mendapat segalanya\Ndengan kecantikanmu itu, kan?!
Dialogue: 0,0:18:34.63,0:18:38.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kecantikan adalah segalanya,\Nberusahalah lebih keras!
Dialogue: 0,0:18:38.05,0:18:40.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal masih banyak yang bisa dilakukan.
Dialogue: 0,0:18:40.60,0:18:42.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Merajuk dan sedih karena ditinggalkan,
Dialogue: 0,0:18:42.82,0:18:44.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu memilih mati,\Nbukankah itu cuma pelarian?!
Dialogue: 0,0:18:49.77,0:18:51.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jahat, jahat!
Dialogue: 0,0:18:51.07,0:18:52.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa ucapanmu sejahat itu?!
Dialogue: 0,0:18:53.99,0:18:56.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah begitu dekat dengan kematian,
Dialogue: 0,0:18:56.57,0:18:58.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}anehnya aku malah merasa lega.
Dialogue: 0,0:18:59.20,0:19:00.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku
Dialogue: 0,0:19:00.83,0:19:04.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak boleh betulan jadi temanmu?
Dialogue: 0,0:19:07.00,0:19:10.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ucapanmu yang bilang ingin akrab denganku,
Dialogue: 0,0:19:11.59,0:19:14.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedih rasanya kalau harus\Ndianggap tidak pernah ada.
Dialogue: 0,0:19:18.22,0:19:19.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai sekarang
Dialogue: 0,0:19:19.80,0:19:22.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku harus hidup seperti apa?
Dialogue: 0,0:19:23.60,0:19:25.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau cinta memang nomor satu,
Dialogue: 0,0:19:25.89,0:19:28.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau coba mencari\Ncinta yang baru?
Dialogue: 0,0:19:33.15,0:19:35.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bicara seolah itu mudah.
Dialogue: 0,0:19:56.88,0:20:00.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja, tidak akan kubiarkan lepas.
Dialogue: 0,0:20:08.10,0:20:09.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedang apa kalian?
Dialogue: 0,0:20:09.65,0:20:11.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Anu, Bu Tamaki, ini...
Dialogue: 0,0:20:11.81,0:20:15.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayu bakarnya kurang,\Njadi kalian ke gudang, kan?
Dialogue: 0,0:20:15.82,0:20:17.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yukari bilang begitu.
Dialogue: 0,0:20:27.08,0:20:29.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah, ya, Satoko.
Dialogue: 0,0:20:29.00,0:20:31.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sisanya tinggal keluar dari pulau.
Dialogue: 0,0:20:31.25,0:20:32.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:20:33.09,0:20:35.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu saja, Ayahanda.
Dialogue: 0,0:20:36.34,0:20:38.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satoko akhirnya akan pulang.
Dialogue: 0,0:22:13.73,0:22:15.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi.
Dialogue: 0,0:22:16.23,0:22:18.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, Pak Mizutani.
Dialogue: 0,0:22:18.73,0:22:22.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya khawatir karena lama tidak kelihatan.
Dialogue: 0,0:22:22.57,0:22:24.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pekerjaanku agak sibuk.
Dialogue: 0,0:22:24.61,0:22:25.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu.
Dialogue: 0,0:22:26.41,0:22:28.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini ingin memesan siapa?
Dialogue: 0,0:22:28.58,0:22:32.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini urusanku bukan untuk main.
Dialogue: 0,0:22:32.58,0:22:38.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sampai lama tidak menemuinya\Ndemi mengumpulkan uang sebanyak ini.
Dialogue: 0,0:22:49.06,0:22:52.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku datang untuk menebus Aoi.
