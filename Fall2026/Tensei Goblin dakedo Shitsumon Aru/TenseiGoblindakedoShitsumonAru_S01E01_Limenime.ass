Dialogue: 0,0:00:27.85,0:00:29.94,sign,,0000,0000,0000,,KAEDE
Dialogue: 0,0:02:37.64,0:02:40.89,sign,,0000,0000,0000,,"PENCARIAN - DARIPADA MENINGGALKAN"
Dialogue: 0,0:02:40.90,0:02:42.27,sign,,0000,0000,0000,,ESTIMASI: 431.000.000 HASIL
Dialogue: 0,0:02:54.99,0:02:57.65,sign,,0000,0000,0000,,"PENCARIAN LANJUTAN"
Dialogue: 0,0:02:57.66,0:02:59.38,sign,,0000,0000,0000,,HIDUP SELAMA 80 TAHUN\NESTIMASI: 6.600.000 HASIL
Dialogue: 0,0:03:19.64,0:03:20.35,sign,,0000,0000,0000,,PENCARIAN: PEWARISAN SKILL\N1 HASIL
Dialogue: 0,0:04:17.86,0:04:19.57,sign,,0000,0000,0000,,REINKARNASI KE ISEKAI
Dialogue: 0,0:06:07.02,0:06:12.10,sign,,0000,0000,0000,,EPISODE 1: BEREINKARNASI JADI GOBLIN,\NMEMANGNYA KENAPA?
Dialogue: 0,0:10:18.72,0:10:19.81,sign,,0000,0000,0000,,"HEAL"
Dialogue: 0,0:12:47.30,0:12:49.50,sign,,0000,0000,0000,,HUKUM ALAM
Dialogue: 0,0:15:14.18,0:15:16.06,sign,,0000,0000,0000,,"PENGLIHATAN JAUH"
Dialogue: 0,0:15:48.34,0:15:49.72,sign,,0000,0000,0000,,"IRON BODY"
Dialogue: 0,0:15:57.73,0:15:58.94,sign,,0000,0000,0000,,"STONE BLAST"
Dialogue: 0,0:17:55.71,0:17:56.44,sign,,0000,0000,0000,,HUKUM ALAM
Dialogue: 0,0:00:11.03,0:00:13.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Yagami, maaf.
Dialogue: 0,0:00:14.08,0:00:17.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gara-gara aku, Kakak jadi ikut lembur.
Dialogue: 0,0:00:17.54,0:00:18.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja.
Dialogue: 0,0:00:19.08,0:00:21.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak baru biasa membuat kesalahan.
Dialogue: 0,0:00:21.71,0:00:24.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang penting jadikan pelajaran\Ndan jangan diulangi.
Dialogue: 0,0:00:25.38,0:00:27.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, terima kasih banyak.
Dialogue: 0,0:00:33.76,0:00:35.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teleponnya tidak diangkat?
Dialogue: 0,0:00:36.85,0:00:38.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti kutelepon balik.
Dialogue: 0,0:00:38.51,0:00:39.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.
Dialogue: 0,0:00:39.55,0:00:40.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa tidak penting?
Dialogue: 0,0:00:41.56,0:00:44.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, hari ini pacarku ulang tahun
Dialogue: 0,0:00:44.32,0:00:46.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan juga hari jadi kami.
Dialogue: 0,0:00:51.03,0:00:52.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Yagami?
Dialogue: 0,0:00:52.95,0:00:54.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pulanglah.
Dialogue: 0,0:00:55.16,0:00:57.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, pekerjaannya masih banyak.
Dialogue: 0,0:00:57.50,0:00:59.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menyuruhmu lembur\Nagar kau introspeksi diri.
Dialogue: 0,0:00:59.83,0:01:01.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih cepat kukerjakan sendiri.
Dialogue: 0,0:01:01.37,0:01:02.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:01:02.63,0:01:04.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan biarkan pacarmu sendirian\Ndi hari spesial ini.
Dialogue: 0,0:01:08.30,0:01:09.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak!
Dialogue: 0,0:01:15.18,0:01:17.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pekerjaan hari ini akhirnya selesai juga.
Dialogue: 0,0:01:18.39,0:01:19.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Yagami!
Dialogue: 0,0:01:20.60,0:01:21.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takahashi.
Dialogue: 0,0:01:22.14,0:01:23.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:01:23.40,0:01:26.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf sekali soal tadi.
Dialogue: 0,0:01:26.27,0:01:28.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari tadi dia merasa bersalah
Dialogue: 0,0:01:28.01,0:01:31.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena melimpahkan pekerjaannya pada Anda.
Dialogue: 0,0:01:31.32,0:01:33.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kami belikan ini\Nsebagai tanda permintaan maaf.
Dialogue: 0,0:01:33.66,0:01:34.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, ya.
Dialogue: 0,0:01:35.16,0:01:36.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti kumakan di rumah.
Dialogue: 0,0:01:36.45,0:01:38.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kami antarkan ke stasiun.
Dialogue: 0,0:01:40.08,0:01:41.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah sempat.
Dialogue: 0,0:01:41.60,0:01:43.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daripada jadi obat nyamuk,
Dialogue: 0,0:01:43.83,0:01:46.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lebih baik kucari alasan\Nuntuk pulang lewat jalan lain.
Dialogue: 0,0:01:51.00,0:01:51.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahaya!
Dialogue: 0,0:02:06.06,0:02:07.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ambulans?
Dialogue: 0,0:02:09.86,0:02:11.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kak Yagami!\N- Ah, begitu.
Dialogue: 0,0:02:11.86,0:02:12.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bertahanlah!
Dialogue: 0,0:02:12.99,0:02:14.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kak Yagami!\N- Aku melindungi anak itu.
Dialogue: 0,0:02:14.70,0:02:16.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bertahanlah!
Dialogue: 0,0:02:16.24,0:02:17.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata begitu.
Dialogue: 0,0:02:18.49,0:02:20.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah...
Dialogue: 0,0:02:22.62,0:02:24.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suara mereka mulai hilang...
Dialogue: 0,0:02:25.33,0:02:27.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku akan mati?
Dialogue: 0,0:02:30.09,0:02:31.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memalukan...
Dialogue: 0,0:02:32.78,0:02:35.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal lebih baik menjadi pihak\Nyang ditinggalkan daripada yang meninggalkan.
Dialogue: 0,0:02:37.64,0:02:40.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau membuat mereka sedih.
Dialogue: 0,0:02:42.27,0:02:44.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku masih ingin hidup.
Dialogue: 0,0:02:45.73,0:02:47.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Umurku baru 29 tahun.
Dialogue: 0,0:02:47.69,0:02:49.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Genap 30 saja belum.
Dialogue: 0,0:02:50.48,0:02:53.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rata-rata orang Jepang\Numurnya mencapai 80 tahun, bukan?
Dialogue: 0,0:02:54.99,0:02:57.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Andai aku bisa hidup sampai umur 80...
Dialogue: 0,0:02:59.49,0:03:01.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayang sekali.
Dialogue: 0,0:03:01.83,0:03:05.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mati begini, semua kemampuanku\Nyang sudah kupelajari akan sia-sia.
Dialogue: 0,0:03:07.25,0:03:09.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa Takahashi akan baik-baik saja?
Dialogue: 0,0:03:10.46,0:03:12.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan dia\Nmembuat kesalahan yang sama lagi.
Dialogue: 0,0:03:13.46,0:03:17.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Andai kemampuanku bisa kuwariskan kepadanya.
Dialogue: 0,0:03:22.85,0:03:25.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya ini semua apa, ya?
Dialogue: 0,0:03:25.85,0:03:27.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mirip mesin pencari...
Dialogue: 0,0:03:36.65,0:03:37.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:03:38.16,0:03:41.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku... belum mati?
Dialogue: 0,0:03:43.83,0:03:45.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kulitku menjadi biru?
Dialogue: 0,0:03:49.46,0:03:50.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Goblin?
Dialogue: 0,0:03:51.74,0:03:53.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kalian siapa?
Dialogue: 0,0:03:54.60,0:03:55.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kawan, ya?
Dialogue: 0,0:03:57.68,0:03:59.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau jatuh dari langit.
Dialogue: 0,0:04:07.27,0:04:10.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi aku mati ditabrak truk,
Dialogue: 0,0:04:10.06,0:04:11.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu menjadi Goblin?
Dialogue: 0,0:04:11.36,0:04:12.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan,
Dialogue: 0,0:04:12.90,0:04:14.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ini yang namanya...
Dialogue: 0,0:04:15.64,0:04:17.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Reinkarnasi ke isekai.
Dialogue: 0,0:04:19.57,0:04:22.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bereinkarnasi jadi Goblin, memangnya kenapa?
Dialogue: 0,0:04:22.78,0:04:23.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya bercanda.
Dialogue: 0,0:04:26.40,0:04:36.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}So What's Wrong\Nwith Getting Reborn as a Goblin?
Dialogue: 0,0:06:16.23,0:06:18.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pagi.
Dialogue: 0,0:06:18.07,0:06:20.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rajin sekali, ya.
Dialogue: 0,0:06:20.69,0:06:21.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat pagi.
Dialogue: 0,0:06:22.36,0:06:25.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah sebulan\Nsejak aku bereinkarnasi menjadi Goblin.
Dialogue: 0,0:06:27.37,0:06:30.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sekitarku Goblin semua,\Ntermasuk aku sendiri.
Dialogue: 0,0:06:30.70,0:06:33.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Intinya, karena kami semua sama,
Dialogue: 0,0:06:33.62,0:06:35.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hidupku tidak ada masalah.
Dialogue: 0,0:06:36.00,0:06:39.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada beberapa hal yang kupelajari sebulan ini.
Dialogue: 0,0:06:39.38,0:06:42.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tingkat kelahiran Goblin itu sangat tinggi.
Dialogue: 0,0:06:42.42,0:06:45.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Goblin betina bisa hamil lagi\Nmeski sedang mengandung.
Dialogue: 0,0:06:45.97,0:06:47.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Isekai memang tidak masuk akal.
Dialogue: 0,0:06:48.76,0:06:52.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai gantinya, umur mereka pendek,\Nhanya sekitar tujuh hari.
Dialogue: 0,0:06:52.35,0:06:55.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lahirnya cepat, matinya juga cepat.
Dialogue: 0,0:06:55.39,0:06:58.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mirip hasil kawin silang\Nkelinci dengan tonggeret.
Dialogue: 0,0:06:58.69,0:07:02.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, tiap Goblin terlahir\Ndengan satu skill bawaan.
Dialogue: 0,0:07:02.99,0:07:05.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat mereka mati, skill itu nantinya...
Dialogue: 0,0:07:06.32,0:07:07.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya, kumpul!
Dialogue: 0,0:07:08.99,0:07:11.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ada... yang menemaniku?
Dialogue: 0,0:07:11.49,0:07:13.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, kami semua di sini.
Dialogue: 0,0:07:13.29,0:07:15.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja.
Dialogue: 0,0:07:16.54,0:07:21.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bahagia bisa menghabiskan waktu\Nbersama kalian.
Dialogue: 0,0:07:24.38,0:07:29.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat mati, skill mereka bisa diwariskan\Nkepada Goblin yang menemaninya.
Dialogue: 0,0:07:29.97,0:07:32.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, sebanyak apa pun skill mereka,
Dialogue: 0,0:07:32.14,0:07:35.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang bisa diwariskan\Nhanya skill bawaan lahir,
Dialogue: 0,0:07:35.48,0:07:37.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}beserta pesan terakhir mereka.
Dialogue: 0,0:07:38.10,0:07:41.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, skill bawaanku,\N"Umur Manusia 80 Tahun".
Dialogue: 0,0:07:41.98,0:07:44.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesuai namanya, skill ini membuat umurku\Nbisa mencapai 80 tahun.
Dialogue: 0,0:07:45.36,0:07:47.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, kita makamkan.
Dialogue: 0,0:07:47.28,0:07:48.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo!
Dialogue: 0,0:08:21.10,0:08:23.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah mewarisi lebih dari 200 skill,
Dialogue: 0,0:08:23.77,0:08:27.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi yang bisa kuwariskan\Nhanya skill "Umur Manusia 80 Tahun".
Dialogue: 0,0:08:27.24,0:08:29.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agak disayangkan juga,
Dialogue: 0,0:08:29.20,0:08:31.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi urusan itu kupikirkan nanti saja.
Dialogue: 0,0:08:36.40,0:08:39.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kira-kira hutan ini seluas apa, ya?
Dialogue: 0,0:08:39.00,0:08:41.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Desa Goblin dikelilingi hutan.
Dialogue: 0,0:08:41.16,0:08:44.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penduduknya jarang keluar dan hidup tenang.
Dialogue: 0,0:08:45.00,0:08:46.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku kadang-kadang pergi keluar.
Dialogue: 0,0:08:51.47,0:08:52.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak!
Dialogue: 0,0:08:52.76,0:08:56.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untunglah indra perasa manusiaku masih ada.
Dialogue: 0,0:08:56.31,0:08:58.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, aku bisa makan apa saja.
Dialogue: 0,0:09:00.39,0:09:03.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, Goblin tidak butuh tidur.
Dialogue: 0,0:09:04.23,0:09:06.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena umur mereka hanya tujuh hari,
Dialogue: 0,0:09:06.07,0:09:08.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mana sempat menghabiskan waktu untuk tidur.
Dialogue: 0,0:09:08.44,0:09:10.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu juga berlaku untukku.
Dialogue: 0,0:09:10.53,0:09:12.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah mulai terbiasa dengan tubuh ini.
Dialogue: 0,0:09:12.99,0:09:15.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu-satunya yang menjadi masalah...
Dialogue: 0,0:09:18.00,0:09:20.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat mudah terangsang...
Dialogue: 0,0:09:20.83,0:09:23.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini karena libido Goblin sangat tinggi.
Dialogue: 0,0:09:23.63,0:09:26.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kira-kira tiga kali lipat dibanding\Nsaat aku masih manusia.
Dialogue: 0,0:09:27.96,0:09:30.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Goblin betina memang manis,
Dialogue: 0,0:09:30.80,0:09:33.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi jelas tidak akan kujadikan pelampiasan.
Dialogue: 0,0:09:33.64,0:09:35.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, aku sangat populer.
Dialogue: 0,0:09:35.93,0:09:39.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal saat masih manusia,\Nlaku saja tidak pernah.
Dialogue: 0,0:10:13.97,0:10:15.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Goblin, ya?
Dialogue: 0,0:10:15.29,0:10:17.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bicara, biar kuobati dulu.
Dialogue: 0,0:10:18.72,0:10:19.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Heal!
Dialogue: 0,0:10:19.81,0:10:21.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemampuan penyembuhan.
Dialogue: 0,0:10:21.68,0:10:24.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salah satu skill\Nyang kuwarisi dari 200 Goblin.
Dialogue: 0,0:10:25.27,0:10:26.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedang apa kau?
Dialogue: 0,0:10:26.90,0:10:28.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tak takut pada Raja Iblis?
Dialogue: 0,0:10:28.98,0:10:30.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah kau Raja Iblis atau bukan...
Dialogue: 0,0:10:30.98,0:10:32.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, Raja Iblis?!
Dialogue: 0,0:10:33.49,0:10:35.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dilihat lagi, tampangnya memang seram.
Dialogue: 0,0:10:36.53,0:10:38.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata Raja Iblis benar-benar ada, ya.
Dialogue: 0,0:10:38.99,0:10:42.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat, entah kenapa aku jadi terharu...
Dialogue: 0,0:10:42.00,0:10:44.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, Raja Iblis jelas ada.
Dialogue: 0,0:10:44.37,0:10:46.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang Goblin saja ada, bukan?
Dialogue: 0,0:10:48.00,0:10:49.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau
Dialogue: 0,0:10:49.38,0:10:51.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sepertinya bukan Goblin biasa.
Dialogue: 0,0:10:51.46,0:10:53.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang, jangan bicara dulu!
Dialogue: 0,0:10:53.13,0:10:54.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti lukamu tidak menutup.
Dialogue: 0,0:10:55.97,0:10:59.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Percuma, lukaku tak bisa diobati.
Dialogue: 0,0:11:00.47,0:11:02.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memang makhluk semacam itu.
Dialogue: 0,0:11:05.48,0:11:07.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal sudah ku-Heal sekuat tenaga.
Dialogue: 0,0:11:08.06,0:11:09.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makhluk semacam itu?
Dialogue: 0,0:11:11.32,0:11:12.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa tidak ada cara lain?
Dialogue: 0,0:11:13.24,0:11:14.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku punya banyak skill untuk dicoba.
Dialogue: 0,0:11:16.53,0:11:17.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berapa banyak?
Dialogue: 0,0:11:18.16,0:11:20.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang ada 277 skill.
Dialogue: 0,0:11:20.62,0:11:23.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, skill bawaan lahirku,\N"Umur Manusia 80 Tahun".
Dialogue: 0,0:11:28.50,0:11:30.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata begitu.
Dialogue: 0,0:11:30.88,0:11:32.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hasil mutasi, ya.
Dialogue: 0,0:11:32.80,0:11:34.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pantas saja.
Dialogue: 0,0:11:35.30,0:11:38.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak apa-apa berteriak begitu?
Dialogue: 0,0:11:38.97,0:11:41.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau skill-mu sebanyak itu,
Dialogue: 0,0:11:41.14,0:11:43.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kapasitas tubuhmu pasti sudah meningkat.
Dialogue: 0,0:11:43.72,0:11:44.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapasitas tubuh?
Dialogue: 0,0:11:44.81,0:11:48.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mungkin bisa mewarisi\Nskill dari ras lain.
Dialogue: 0,0:11:48.60,0:11:49.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitukah?
Dialogue: 0,0:11:50.23,0:11:51.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana?
Dialogue: 0,0:11:51.98,0:11:55.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau mewarisi skill milikku?
Dialogue: 0,0:11:58.74,0:12:00.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah menyaksikan akhir hayat 276 Goblin
Dialogue: 0,0:12:01.37,0:12:04.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan mewarisi semua skill mereka.
Dialogue: 0,0:12:05.00,0:12:07.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya kulakukan dengan sepenuh hati.
Dialogue: 0,0:12:08.00,0:12:11.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa benar sang Raja Iblis rela\Nmenitipkan warisannya kepada Goblin?
Dialogue: 0,0:12:12.79,0:12:14.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku paham.
Dialogue: 0,0:12:14.63,0:12:17.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah Goblin atau Raja Iblis,\Npada dasarnya sama saja.
Dialogue: 0,0:12:18.51,0:12:21.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya ingin meninggalkan bukti\Nbahwa mereka pernah hidup.
Dialogue: 0,0:12:23.96,0:12:26.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, kuterima.
Dialogue: 0,0:12:51.71,0:12:54.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hukum Alam?
Dialogue: 0,0:12:54.00,0:12:59.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Monster memiliki insting untuk tunduk\Npada sosok yang lebih kuat.
Dialogue: 0,0:12:59.97,0:13:02.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skill ini membuat insting itu menjadi mutlak.
Dialogue: 0,0:13:02.84,0:13:04.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}He-Hei...
Dialogue: 0,0:13:04.55,0:13:07.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lawan yang pernah kau kalahkan\Nakan tunduk secara mutlak.
Dialogue: 0,0:13:08.31,0:13:11.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa pun yang terjadi,\Nmereka takkan mengkhianatimu.
Dialogue: 0,0:13:11.98,0:13:14.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkat skill itulah, aku menjadi Raja Iblis.
Dialogue: 0,0:13:14.98,0:13:17.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wahai Goblin tanpa nama,
Dialogue: 0,0:13:17.48,0:13:19.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kuwariskan ini padamu.
Dialogue: 0,0:13:20.45,0:13:22.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manfaatkanlah dengan baik.
Dialogue: 0,0:13:30.00,0:13:31.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari itu,
Dialogue: 0,0:13:33.00,0:13:37.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Raja Iblis yang menebar teror selama\Nratusan tahun akhirnya dipastikan tiada.
Dialogue: 0,0:13:41.38,0:13:43.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seluruh dunia bersukacita.
Dialogue: 0,0:13:48.97,0:13:51.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, umat manusia tak menyadari
Dialogue: 0,0:13:51.77,0:13:55.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bahwa ancaman Raja Iblis\Nbelum benar-benar sirna.
Dialogue: 0,0:13:56.94,0:13:58.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya, untuk sekarang.
Dialogue: 0,0:14:02.61,0:14:04.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa ini?
Dialogue: 0,0:14:04.91,0:14:08.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya, dia baru saja membunuh manusia.
Dialogue: 0,0:14:08.79,0:14:10.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manusia?
Dialogue: 0,0:14:10.20,0:14:11.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga!
Dialogue: 0,0:14:11.58,0:14:13.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia membunuh manusia?!
Dialogue: 0,0:14:13.33,0:14:15.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau melakukan itu?
Dialogue: 0,0:14:15.04,0:14:18.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata membunuh manusia\Ndianggap tabu di sini.
Dialogue: 0,0:14:18.04,0:14:20.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku terpaksa.
Dialogue: 0,0:14:20.05,0:14:22.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat mencari kayu bakar,\Naku tiba-tiba diserang.
Dialogue: 0,0:14:22.88,0:14:24.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kubalas.
Dialogue: 0,0:14:24.05,0:14:26.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajar dia melawan.
Dialogue: 0,0:14:26.05,0:14:28.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, sekarang akan bagaimana?
Dialogue: 0,0:14:28.35,0:14:32.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat, manusia akan menyerang desa!
Dialogue: 0,0:14:33.85,0:14:37.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meskipun memiliki skill,\NGoblin tetap saja lemah.
Dialogue: 0,0:14:37.40,0:14:40.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tingkat kelahiran yang tinggi menjadi bukti\Nbahwa mereka ras yang rapuh
Dialogue: 0,0:14:40.48,0:14:43.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan cepat punah jika tak beranak-pinak.
Dialogue: 0,0:14:43.45,0:14:45.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana ini?
Dialogue: 0,0:14:45.20,0:14:46.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tamat riwayat kita!
Dialogue: 0,0:14:46.87,0:14:48.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku takut!
Dialogue: 0,0:14:48.41,0:14:50.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajar mereka menjadi panik.
Dialogue: 0,0:14:53.04,0:14:55.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manusianya datang dari arah mana?
Dialogue: 0,0:14:55.04,0:14:57.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari arah aku datang tadi.
Dialogue: 0,0:14:57.79,0:14:59.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jumlahnya?
Dialogue: 0,0:14:59.04,0:15:01.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kira-kira 50 orang.
Dialogue: 0,0:15:01.05,0:15:02.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Se-Sebanyak itu?
Dialogue: 0,0:15:02.63,0:15:04.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus segera melarikan diri!
Dialogue: 0,0:15:04.05,0:15:06.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang, biar aku yang urus.
Dialogue: 0,0:15:06.43,0:15:09.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Mau kau urus bagaimana?\N- Kau mau melawan manusia?
Dialogue: 0,0:15:09.72,0:15:11.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan coba bicara dulu dengan mereka.
Dialogue: 0,0:15:14.18,0:15:16.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penglihatan Jauh!
Dialogue: 0,0:15:17.35,0:15:19.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya itu kelompok kesatria.
Dialogue: 0,0:15:20.07,0:15:22.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya masih bisa diajak bicara.
Dialogue: 0,0:15:22.61,0:15:23.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhenti!
Dialogue: 0,0:15:25.03,0:15:26.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi...
Dialogue: 0,0:15:27.03,0:15:29.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Boleh minta waktu sebentar?\N- Goblin rendahan.
Dialogue: 0,0:15:30.03,0:15:33.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kubuat kau paham\Nakibatnya melawan manusia.
Dialogue: 0,0:15:34.00,0:15:37.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- A-Aku sebenarnya mau bicara...\N- Siapkan senjata!
Dialogue: 0,0:15:38.88,0:15:40.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Habisi dia!\N- Siap!
Dialogue: 0,0:15:40.84,0:15:42.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, sudah kuduga.
Dialogue: 0,0:15:48.34,0:15:49.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iron Body!
Dialogue: 0,0:15:53.72,0:15:57.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sip, ini pertama kalinya\Naku memakai skill untuk bertarung.
Dialogue: 0,0:15:57.73,0:15:58.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Stone Blast!
Dialogue: 0,0:16:01.06,0:16:02.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan lengah!
Dialogue: 0,0:16:02.27,0:16:04.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Goblin yang memiliki banyak skill memang ada.
Dialogue: 0,0:16:13.24,0:16:15.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan ini, aku tidak perlu membunuh mereka.
Dialogue: 0,0:16:21.50,0:16:22.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil.
Dialogue: 0,0:16:23.00,0:16:25.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal hanya melawan Goblin.
Dialogue: 0,0:16:26.05,0:16:27.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau ketuanya?
Dialogue: 0,0:16:28.76,0:16:30.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin bicara.
Dialogue: 0,0:16:30.39,0:16:31.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa boleh?
Dialogue: 0,0:16:31.72,0:16:33.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Goblin mengajak bicara?
Dialogue: 0,0:16:35.02,0:16:37.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, katakan.
Dialogue: 0,0:16:39.06,0:16:42.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama-tama, maaf soal insiden kali ini.
Dialogue: 0,0:16:42.81,0:16:46.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meskipun membela diri,\Ntidak seharusnya dia membunuh.
Dialogue: 0,0:16:46.40,0:16:47.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh?
Dialogue: 0,0:16:47.69,0:16:51.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu, aku tidak bisa\Nmembiarkan kalian menyerang desa kami.
Dialogue: 0,0:16:51.70,0:16:53.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian mau menyerang desa kami, bukan?
Dialogue: 0,0:16:54.45,0:16:55.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:16:56.08,0:16:58.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami tak bisa membiarkan Goblin\Nyang membahayakan manusia.
Dialogue: 0,0:16:59.04,0:17:00.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga.
Dialogue: 0,0:17:02.04,0:17:05.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, apa kami diizinkan\Nuntuk mengadilinya sendiri?
Dialogue: 0,0:17:06.05,0:17:06.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:17:07.05,0:17:09.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kami sendiri yang mengadili Goblin itu.
Dialogue: 0,0:17:10.05,0:17:11.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai hukuman membunuh manusia.
Dialogue: 0,0:17:11.63,0:17:13.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau kurungan tujuh hari?
Dialogue: 0,0:17:14.51,0:17:15.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm, begini, ya?
Dialogue: 0,0:17:15.68,0:17:16.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bercanda!
Dialogue: 0,0:17:16.84,0:17:18.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa seringan itu!
Dialogue: 0,0:17:18.93,0:17:20.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:17:20.52,0:17:22.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Intinya sama dengan penjara seumur hidup.
Dialogue: 0,0:17:23.81,0:17:25.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Umur Goblin hanya tujuh hari.
Dialogue: 0,0:17:26.48,0:17:28.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak tahu sisa umurnya berapa hari,
Dialogue: 0,0:17:29.61,0:17:32.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kurungan tujuh hari sudah sama saja\Ndengan penjara seumur hidup.
Dialogue: 0,0:17:34.78,0:17:37.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian juga boleh ikut mengawasinya.
Dialogue: 0,0:17:37.83,0:17:41.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengawasi selama tujuh hari\Nbukan tugas berat bagi manusia, 'kan?
Dialogue: 0,0:17:43.21,0:17:48.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketua! Jangan dengarkan monster itu!
Dialogue: 0,0:17:48.30,0:17:51.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bunuh saja dia dan serbu desa mereka!
Dialogue: 0,0:17:51.05,0:17:53.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar! Jangan pedulikan dia!
Dialogue: 0,0:18:00.27,0:18:01.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf!
Dialogue: 0,0:18:01.89,0:18:04.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami patuh pada Anda, Tuan Goblin!
Dialogue: 0,0:18:05.06,0:18:06.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa dengan kalian?
Dialogue: 0,0:18:06.90,0:18:08.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skill Hukum Alam.
Dialogue: 0,0:18:08.78,0:18:12.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skill yang membuat lawan patuh mutlak\Nsetelah dikalahkan.
Dialogue: 0,0:18:12.70,0:18:14.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agak memalukan juga.
Dialogue: 0,0:18:18.03,0:18:20.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau Goblin yang menarik.
Dialogue: 0,0:18:20.33,0:18:21.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:18:21.25,0:18:23.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syaratnya, kurungannya di luar hutan.
Dialogue: 0,0:18:23.54,0:18:26.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agar penduduk kota bisa melihatnya.
Dialogue: 0,0:18:26.29,0:18:29.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, tidak masalah. Terima kasih.
Dialogue: 0,0:18:29.46,0:18:31.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau punya nama?
Dialogue: 0,0:18:31.76,0:18:33.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nama?
Dialogue: 0,0:18:33.05,0:18:36.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kusebut Yagami Akira,\Npasti dianggap aneh.
Dialogue: 0,0:18:36.43,0:18:40.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau diingat-ingat, Goblin lain juga\Nbelum pernah memanggil namaku.
Dialogue: 0,0:18:41.42,0:18:42.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:18:44.14,0:18:45.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namaku Akira.
Dialogue: 0,0:18:45.23,0:18:46.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Karen.
Dialogue: 0,0:18:46.98,0:18:48.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Personel pengawas keamanan.
Dialogue: 0,0:18:49.07,0:18:50.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karen.
Dialogue: 0,0:18:50.28,0:18:51.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita mundur!
Dialogue: 0,0:18:51.36,0:18:53.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang masih bisa berjalan,\Nbantu yang terluka parah!
Dialogue: 0,0:18:54.03,0:18:56.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kami yang menyiapkan kurungannya.
Dialogue: 0,0:18:56.66,0:18:58.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:18:58.70,0:19:01.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini pahlawan yang menyelamatkan desa!
Dialogue: 0,0:19:01.54,0:19:04.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat, kau bisa bernegosiasi dengan manusia!
Dialogue: 0,0:19:11.55,0:19:12.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh minta waktumu sebentar?
Dialogue: 0,0:19:22.06,0:19:24.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, malah menjadi begini.
Dialogue: 0,0:19:25.35,0:19:26.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bicara apa?
Dialogue: 0,0:19:26.77,0:19:28.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang penting semuanya aman, bukan?
Dialogue: 0,0:19:30.90,0:19:32.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, itu dia.
Dialogue: 0,0:19:32.53,0:19:34.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami ingin merayakan penangkapanmu!
Dialogue: 0,0:19:34.65,0:19:36.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, kita menari!
Dialogue: 0,0:19:36.28,0:19:38.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita berpesta untuk terakhir kalinya!
Dialogue: 0,0:19:58.80,0:19:59.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang sekali...
Dialogue: 0,0:20:01.05,0:20:03.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, padahal ini sedang ramai-ramainya.
Dialogue: 0,0:20:15.57,0:20:17.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kutepati janjiku!
Dialogue: 0,0:20:58.07,0:21:01.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku datang untuk mengabarkan hasil laporanku.
Dialogue: 0,0:21:01.66,0:21:02.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:21:03.43,0:21:06.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, Akira, baju apa itu?
Dialogue: 0,0:21:06.87,0:21:09.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kejadian itu,\Naku diangkat menjadi kepala desa...
Dialogue: 0,0:21:09.87,0:21:12.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama sekali tidak cocok.
Dialogue: 0,0:21:12.04,0:21:13.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak saja!
Dialogue: 0,0:21:13.33,0:21:16.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, untunglah kau\Nyang menjadi kepala desanya.
Dialogue: 0,0:21:16.34,0:21:17.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang kenapa?
Dialogue: 0,0:21:17.42,0:21:21.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian memang sudah memberi hukuman, tapi...
Dialogue: 0,0:21:21.26,0:21:23.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana menjelaskannya, ya?
Dialogue: 0,0:21:24.43,0:21:26.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atasanmu tidak setuju, ya?
Dialogue: 0,0:21:26.89,0:21:28.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kau bisa tahu?
Dialogue: 0,0:21:28.06,0:21:30.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, namanya juga birokrasi.
Dialogue: 0,0:21:30.44,0:21:33.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebelum mati, posisiku kurang lebih sama.
Dialogue: 0,0:21:34.06,0:21:36.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah susah payah mencari solusi di lapangan,
Dialogue: 0,0:21:36.86,0:21:40.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi ditolak mentah-mentah oleh atasan.
Dialogue: 0,0:21:41.03,0:21:42.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pasti kerepotan, ya.
Dialogue: 0,0:21:43.03,0:21:45.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak usah mengasihaniku!
Dialogue: 0,0:21:45.03,0:21:47.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Intinya, maaf merepotkan,
Dialogue: 0,0:21:47.29,0:21:49.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku ingin kau ikut untuk meyakinkan atasanku.
Dialogue: 0,0:21:50.04,0:21:52.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beliau pasti setuju jika melihatmu langsung.
Dialogue: 0,0:21:56.04,0:21:58.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika atasannya belum puas,
Dialogue: 0,0:21:58.30,0:22:00.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berarti keamanan desa kami masih terancam.
Dialogue: 0,0:22:01.05,0:22:03.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga telanjur menjadi kepala desa.
Dialogue: 0,0:22:03.43,0:22:05.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin\Nlangsung membuang tanggung jawab.
Dialogue: 0,0:22:07.06,0:22:09.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, ayo berangkat.
