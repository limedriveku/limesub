Dialogue: 0,0:02:04.56,0:02:11.42,sign,,0000,0000,0000,,EPISODE 2: BERTEMU KAKEK ANEH,\NMEMANGNYA KENAPA?
Dialogue: 0,0:09:27.28,0:09:28.14,sign,,0000,0000,0000,,"MULUS"
Dialogue: 0,0:09:28.14,0:09:29.92,sign,,0000,0000,0000,,"KLIMIS"
Dialogue: 0,0:09:56.83,0:09:58.27,sign,,0000,0000,0000,,STONE WALL
Dialogue: 0,0:12:02.12,0:12:03.08,sign,,0000,0000,0000,,"MERINDING"
Dialogue: 0,0:13:22.30,0:13:24.53,sign,,0000,0000,0000,,"HANZO GENERASI KEDUA"
Dialogue: 0,0:14:14.21,0:14:15.92,sign,,0000,0000,0000,,DUA MINGGU KEMUDIAN
Dialogue: 0,0:14:24.88,0:14:27.05,sign,,0000,0000,0000,,GUGUP
Dialogue: 0,0:15:45.22,0:15:47.18,sign,,0000,0000,0000,,"MATEMATIKA MENTAL"
Dialogue: 0,0:15:47.18,0:15:49.47,sign,,0000,0000,0000,,"TENAGA SUPER"
