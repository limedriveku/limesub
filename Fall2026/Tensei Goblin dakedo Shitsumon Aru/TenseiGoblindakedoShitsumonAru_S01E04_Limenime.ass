Dialogue: 0,0:00:35.45,0:00:36.55,sign,,0000,0000,0000,,PEMINTAL BENANG
Dialogue: 0,0:03:14.94,0:03:17.30,sign,,0000,0000,0000,,"EPISODE 4: MENJADI TARGET PEMBUNUH"
Dialogue: 0,0:03:17.30,0:03:18.93,sign,,0000,0000,0000,,"MEMANGNYA KENAPA?"
Dialogue: 0,0:04:34.62,0:04:35.02,sign,,0000,0000,0000,,KILATAN CAHAYA
Dialogue: 0,0:04:47.20,0:04:47.68,sign,,0000,0000,0000,,TENAGA SUPER
Dialogue: 0,0:05:02.86,0:05:03.36,sign,,0000,0000,0000,,PENGGANDAAN BAYANGAN
Dialogue: 0,0:10:48.96,0:10:50.33,sign,,0000,0000,0000,,"JARUM ES"
Dialogue: 0,0:10:53.98,0:10:54.90,sign,,0000,0000,0000,,GREAT HEAL
Dialogue: 0,0:17:35.03,0:17:35.99,sign,,0000,0000,0000,,SKETSA
Dialogue: 0,0:18:27.63,0:18:29.55,sign,,0000,0000,0000,,API HITAM (API KECIL)
Dialogue: 0,0:20:26.95,0:20:27.41,sign,,0000,0000,0000,,HUKUM ALAM
Dialogue: 0,0:20:53.25,0:20:53.60,sign,,0000,0000,0000,,ROCK GRAVE
Dialogue: 0,0:21:11.04,0:21:12.45,sign,,0000,0000,0000,,HUKUM ALAM
Dialogue: 0,0:21:59.80,0:22:01.52,sign,,0000,0000,0000,,GREAT HEAL
Dialogue: 0,0:00:07.99,0:00:10.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini?\NSepertinya aku akan diterkam.
Dialogue: 0,0:00:10.68,0:00:12.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, jangan berpikiran mesum dulu.
Dialogue: 0,0:00:41.90,0:00:42.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:00:43.40,0:00:45.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti ada yang tidak beres, bukan?
Dialogue: 0,0:00:47.20,0:00:50.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, menggoda Goblin itu sia-sia.
Dialogue: 0,0:00:51.19,0:00:52.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa begitu?
Dialogue: 0,0:00:52.95,0:00:56.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah melihat Hanzo dan Echigoya, bukan?
Dialogue: 0,0:00:58.41,0:01:01.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Goblin tidak bernafsu pada manusia.
Dialogue: 0,0:01:02.50,0:01:03.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:01:06.75,0:01:09.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, lupakan saja.
Dialogue: 0,0:01:14.51,0:01:17.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial, nafsu Goblinku meronta-ronta.
Dialogue: 0,0:01:26.27,0:01:30.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kenapa Karen melakukan itu, ya?
Dialogue: 0,0:01:30.82,0:01:32.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih baik lupakan saja.
Dialogue: 0,0:01:34.99,0:01:45.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}So What's Wrong with\NGetting Reborn as a Goblin?
Dialogue: 0,0:03:06.42,0:03:07.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karen.
Dialogue: 0,0:03:07.25,0:03:08.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia kenapa?
Dialogue: 0,0:03:08.75,0:03:10.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa tidak memakai baju?
Dialogue: 0,0:03:12.27,0:03:14.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Karen?
Dialogue: 0,0:03:14.94,0:03:17.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau di sini?
Dialogue: 0,0:03:17.30,0:03:18.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu...
Dialogue: 0,0:03:18.93,0:03:20.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bajumu mana?
Dialogue: 0,0:03:22.06,0:03:24.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, soal itu...
Dialogue: 0,0:03:24.93,0:03:27.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, pasti sedang dicuci, ya!
Dialogue: 0,0:03:27.31,0:03:31.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kuminta Echigoya membuatkan baju baru.
Dialogue: 0,0:03:31.44,0:03:33.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka biasa saja melihatku telanjang.
Dialogue: 0,0:03:33.94,0:03:37.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gara-gara Tuan Wedana,\Naku jadi malu sendiri...
Dialogue: 0,0:03:38.95,0:03:41.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka bisa lengah jika digoda.
Dialogue: 0,0:03:41.45,0:03:42.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan.
Dialogue: 0,0:03:42.23,0:03:47.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang bodoh karena mengira\NGoblin bisa bernafsu pada manusia.
Dialogue: 0,0:03:47.25,0:03:49.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bukan salah Tuan Wedana.
Dialogue: 0,0:03:52.25,0:03:54.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, bukan hanya itu.
Dialogue: 0,0:03:55.21,0:03:57.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa membunuhnya.
Dialogue: 0,0:03:57.93,0:03:59.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar aku yang ambil alih.
Dialogue: 0,0:04:11.48,0:04:14.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga Karen baik-baik saja.
Dialogue: 0,0:04:26.50,0:04:27.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lari!
Dialogue: 0,0:04:29.00,0:04:30.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa itu? Keluar kau!
Dialogue: 0,0:04:33.25,0:04:34.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:04:40.63,0:04:41.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karen!
Dialogue: 0,0:04:50.06,0:04:51.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau baik-baik saja?
Dialogue: 0,0:04:57.36,0:04:58.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kena.
Dialogue: 0,0:05:14.59,0:05:15.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini...
Dialogue: 0,0:05:21.80,0:05:23.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang apa ini?
Dialogue: 0,0:05:24.05,0:05:27.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang ini memancarkan\Naura kematian yang pekat.
Dialogue: 0,0:05:27.97,0:05:31.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu Goblin Slayer.
Dialogue: 0,0:05:32.02,0:05:35.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senjata yang dibuat khusus\Nuntuk membunuh Goblin.
Dialogue: 0,0:05:35.31,0:05:38.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya dengan satu goresan,\NGoblin mana pun akan langsung tewas.
Dialogue: 0,0:05:47.91,0:05:51.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, Simon sewaspada itu, ya?
Dialogue: 0,0:05:52.04,0:05:53.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah tahu?
Dialogue: 0,0:05:53.50,0:05:55.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, kurang lebih.
Dialogue: 0,0:05:55.92,0:05:58.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakek sepertinya mudah ditebak.
Dialogue: 0,0:05:58.67,0:06:01.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti ada akal bulus di balik senyumannya.
Dialogue: 0,0:06:02.84,0:06:04.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak marah?
Dialogue: 0,0:06:04.51,0:06:06.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia itu penguasa.
Dialogue: 0,0:06:06.80,0:06:09.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dia berhenti waspada,
Dialogue: 0,0:06:09.31,0:06:10.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}itu baru jadi masalah.
Dialogue: 0,0:06:11.23,0:06:12.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, bukan itu masalahnya.
Dialogue: 0,0:06:13.52,0:06:16.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa caranya berbelit begini?
Dialogue: 0,0:06:17.11,0:06:21.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dianggap ancaman,\Nkenapa tak langsung mengirim pasukan saja?
Dialogue: 0,0:06:21.78,0:06:22.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:06:23.07,0:06:26.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dipikir-pikir, cara beliau memang aneh.
Dialogue: 0,0:06:27.07,0:06:29.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beliau melapor kepada petinggi\Nbahwa kau bukan ancaman.
Dialogue: 0,0:06:29.49,0:06:31.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, diam-diam menyusun rencana\Ndi belakangmu.
Dialogue: 0,0:06:32.04,0:06:33.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:06:33.62,0:06:35.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata serumit itu.
Dialogue: 0,0:06:35.75,0:06:38.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bukan cara menghadapi monster.
Dialogue: 0,0:06:39.13,0:06:41.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kutanya langsung padanya.
Dialogue: 0,0:06:45.55,0:06:47.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rencananya gagal, ya.
Dialogue: 0,0:06:47.56,0:06:49.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tidak bisa digoda.
Dialogue: 0,0:06:49.47,0:06:51.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa justru aku yang merasa bersalah?
Dialogue: 0,0:06:51.81,0:06:52.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi...
Dialogue: 0,0:06:53.14,0:06:55.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau datang untuk membunuhku?
Dialogue: 0,0:06:56.44,0:06:58.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku datang untuk bicara.
Dialogue: 0,0:07:00.40,0:07:02.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau melakukan semua ini?
Dialogue: 0,0:07:05.90,0:07:07.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Goblin itu
Dialogue: 0,0:07:08.20,0:07:11.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mampu berevolusi sesuai dengan habitatnya.
Dialogue: 0,0:07:12.08,0:07:15.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di lingkungan kering,\Nmereka kebal kekeringan.
Dialogue: 0,0:07:15.16,0:07:17.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di lingkungan bersalju,\Nmereka kebal suhu dingin.
Dialogue: 0,0:07:18.17,0:07:22.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski lingkungan berubah,\Nmereka bisa cepat beradaptasi.
Dialogue: 0,0:07:22.75,0:07:28.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lima puluh tahun lalu,\N99% populasi Goblin musnah.
Dialogue: 0,0:07:29.34,0:07:32.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal pemicunya hal sepele.
Dialogue: 0,0:07:33.43,0:07:37.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat itu, manusia membantai Goblin\Nsecara besar-besaran.
Dialogue: 0,0:07:37.94,0:07:39.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tahu akibatnya?
Dialogue: 0,0:07:39.56,0:07:42.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada Goblin yang berevolusi pesat.
Dialogue: 0,0:07:46.70,0:07:47.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami menyebutnya "Last One".
Dialogue: 0,0:07:48.53,0:07:53.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Goblin terakhir dengan tiga skill\Nyang belum pernah kami ketahui.
Dialogue: 0,0:07:54.79,0:07:56.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama, keabadian.
Dialogue: 0,0:07:57.46,0:08:00.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak ada serangan yang mampu melukainya.
Dialogue: 0,0:08:01.34,0:08:03.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kedua, reproduksi tunggal.
Dialogue: 0,0:08:04.21,0:08:08.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bisa melahirkan ratusan Goblin lain\Ndengan membelah tubuhnya.
Dialogue: 0,0:08:09.09,0:08:11.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dialah leluhur para Goblin sekarang.
Dialogue: 0,0:08:12.14,0:08:13.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, yang ketiga...
Dialogue: 0,0:08:14.39,0:08:17.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bisa menggunakan semua skill\Nyang pernah dimiliki seluruh Goblin.
Dialogue: 0,0:08:19.69,0:08:23.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Last One sudah membunuh ratusan ribu manusia.
Dialogue: 0,0:08:23.36,0:08:26.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski tragedi itu sudah berlalu,
Dialogue: 0,0:08:26.61,0:08:29.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}manusia tetap sangat waspada.
Dialogue: 0,0:08:29.39,0:08:32.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itulah desa kalian sering diserang.
Dialogue: 0,0:08:32.53,0:08:33.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:08:34.24,0:08:37.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan menyerang desa-desa Goblin,
Dialogue: 0,0:08:38.00,0:08:41.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalian bisa mencegah Goblin\Nsepertiku terus berevolusi, ya?
Dialogue: 0,0:08:42.08,0:08:43.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:08:43.71,0:08:47.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, wajar aku mewaspadai\NGoblin spesial sepertimu.
Dialogue: 0,0:08:48.67,0:08:51.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau menilai dari kegagalan, 'kan?
Dialogue: 0,0:08:51.93,0:08:55.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menghindari kegagalan\Nyang sama memang penting,
Dialogue: 0,0:08:55.97,0:08:58.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kesalahan lain\Npasti tetap terjadi, bukan?
Dialogue: 0,0:08:59.27,0:09:01.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, benar.
Dialogue: 0,0:09:03.48,0:09:05.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jawabanmu santai sekali.
Dialogue: 0,0:09:06.07,0:09:08.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kegagalan itu bukan jalan buntu,
Dialogue: 0,0:09:08.69,0:09:10.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}melainkan jalan menuju keberhasilan.
Dialogue: 0,0:09:10.99,0:09:14.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama kita terus mencoba\Ndan belajar dari kesalahan,
Dialogue: 0,0:09:15.53,0:09:18.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}keberhasilan akan datang di kemudian hari.
Dialogue: 0,0:09:22.58,0:09:24.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ucapanmu ada benarnya.
Dialogue: 0,0:09:25.13,0:09:28.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak kusangka aku belajar\Nprinsip hidup darimu.
Dialogue: 0,0:09:29.30,0:09:30.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat.
Dialogue: 0,0:09:31.47,0:09:33.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi malu dipuji begitu.
Dialogue: 0,0:09:34.30,0:09:37.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, bagaimana ke depannya?
Dialogue: 0,0:09:37.93,0:09:39.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya mudah.
Dialogue: 0,0:09:39.60,0:09:40.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm?
Dialogue: 0,0:09:41.56,0:09:44.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya perlu dianggap berguna,\Nbukan ancaman.
Dialogue: 0,0:09:44.56,0:09:46.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudmu?
Dialogue: 0,0:09:46.48,0:09:50.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau membunuhku karena takut padaku, 'kan?
Dialogue: 0,0:09:50.69,0:09:51.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:09:52.03,0:09:55.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meskipun aku tahu\Nkau itu sobat yang bisa kupercaya.
Dialogue: 0,0:09:56.91,0:09:58.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Wedana,
Dialogue: 0,0:09:58.41,0:10:01.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kenapa Anda memercayai Akira?
Dialogue: 0,0:10:02.54,0:10:04.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa kami katakan!
Dialogue: 0,0:10:05.13,0:10:07.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu rahasia antarpria.
Dialogue: 0,0:10:09.84,0:10:12.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meskipun aku percaya padamu,
Dialogue: 0,0:10:12.12,0:10:16.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bangsawan, petinggi lain, dan bahkan Raja\Nbelum tentu percaya padamu.
Dialogue: 0,0:10:16.55,0:10:18.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:10:18.72,0:10:20.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, ya, Simon,
Dialogue: 0,0:10:20.02,0:10:23.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa para penguasa suka mencari obat mujarab?
Dialogue: 0,0:10:24.35,0:10:27.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, sebagian besar begitu.
Dialogue: 0,0:10:27.23,0:10:28.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga.
Dialogue: 0,0:10:29.36,0:10:30.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:10:30.61,0:10:34.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bilang kau mau menjual obat palsu.
Dialogue: 0,0:10:34.82,0:10:36.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak sampai sejauh itu.
Dialogue: 0,0:10:39.37,0:10:40.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lantas?
Dialogue: 0,0:10:43.91,0:10:44.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:10:48.96,0:10:50.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akira!
Dialogue: 0,0:11:00.93,0:11:02.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Burungnya...
Dialogue: 0,0:11:02.27,0:11:03.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Great Heal.
Dialogue: 0,0:11:04.39,0:11:08.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skill yang bisa menyembuhkan apa saja\Nselama target belum mati.
Dialogue: 0,0:11:08.52,0:11:10.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat.
Dialogue: 0,0:11:12.23,0:11:14.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bulbul, aku minta maaf.
Dialogue: 0,0:11:14.57,0:11:15.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajar ia marah.
Dialogue: 0,0:11:15.78,0:11:16.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu salahmu sendiri.
Dialogue: 0,0:11:21.12,0:11:23.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu skill yang sangat berguna.
Dialogue: 0,0:11:23.95,0:11:24.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, bukan?
Dialogue: 0,0:11:25.91,0:11:27.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama hubungan kita tetap terjaga,
Dialogue: 0,0:11:27.79,0:11:30.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku bisa menyembuhkan\Nsiapa saja saat darurat.
Dialogue: 0,0:11:30.67,0:11:34.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebesar apa pun ancaman\Ndari Goblin sepertinya,
Dialogue: 0,0:11:34.67,0:11:37.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia tidak akan melukai keluarga kerajaan.
Dialogue: 0,0:11:38.34,0:11:40.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daripada mewaspadainya,
Dialogue: 0,0:11:40.26,0:11:43.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia lebih berguna\Ndengan skill Great Heal miliknya.
Dialogue: 0,0:11:44.06,0:11:45.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu yang akan kulaporkan.
Dialogue: 0,0:11:49.10,0:11:51.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Karen.
Dialogue: 0,0:11:51.19,0:11:51.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:11:52.36,0:11:55.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bermaksud mempermalukanmu.
Dialogue: 0,0:11:55.82,0:11:56.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.
Dialogue: 0,0:11:56.78,0:11:59.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya paham kekhawatiran Anda.
Dialogue: 0,0:11:59.70,0:12:02.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, apa Anda yakin bisa memercayai Akira?
Dialogue: 0,0:12:03.41,0:12:05.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia itu mirip manusia.
Dialogue: 0,0:12:05.70,0:12:08.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlepas dari statusnya\Nsebagai Goblin berumur panjang
Dialogue: 0,0:12:08.83,0:12:11.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan pewaris skill Raja Iblis,
Dialogue: 0,0:12:12.75,0:12:17.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku percaya pada hati manusianya.
Dialogue: 0,0:12:18.47,0:12:19.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya paham.
Dialogue: 0,0:12:21.47,0:12:23.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Simon, bagaimana hasilnya?
Dialogue: 0,0:12:25.06,0:12:27.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal itu, aku minta maaf, Sobat.
Dialogue: 0,0:12:28.23,0:12:30.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Laporannya gagal, ya?
Dialogue: 0,0:12:30.73,0:12:33.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, semuanya lancar.
Dialogue: 0,0:12:34.78,0:12:36.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kau Goblin yang dimaksud itu, ya.
Dialogue: 0,0:12:39.49,0:12:41.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, siapa, ya?
Dialogue: 0,0:12:43.33,0:12:47.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia Albert, Pangeran Ketiga South Windsor.
Dialogue: 0,0:12:49.21,0:12:51.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang menyudutkan Raja Iblis.
Dialogue: 0,0:12:58.92,0:13:02.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang menyudutkan Raja Iblis...
Dialogue: 0,0:13:02.82,0:13:03.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana bisa?
Dialogue: 0,0:13:06.01,0:13:09.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan skill-ku, Percobaan Ulang.
Dialogue: 0,0:13:09.60,0:13:11.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Percobaan Ulang?
Dialogue: 0,0:13:12.02,0:13:13.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari namanya,
Dialogue: 0,0:13:13.56,0:13:18.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia bisa mengulang kembali saat gagal.
Dialogue: 0,0:13:18.78,0:13:22.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itukah yang mencegah skill Hukum Alam\Nmilik Raja Iblis aktif?
Dialogue: 0,0:13:22.74,0:13:27.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau jauh lebih berbahaya\Ndaripada laporan yang kudengar.
Dialogue: 0,0:13:28.70,0:13:31.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari namanya saja,\Nkau sudah menebak apa skill-ku, 'kan?
Dialogue: 0,0:13:32.12,0:13:34.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, begitulah.
Dialogue: 0,0:13:35.88,0:13:37.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ulang...
Dialogue: 0,0:13:40.59,0:13:42.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyudutkan Raja Iblis...
Dialogue: 0,0:13:42.68,0:13:43.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana bisa?
Dialogue: 0,0:13:44.80,0:13:46.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu rahasia.
Dialogue: 0,0:13:47.14,0:13:48.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga, ya.
Dialogue: 0,0:13:48.81,0:13:50.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, sampai bisa menyudutkan Raja Iblis,
Dialogue: 0,0:13:51.10,0:13:54.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}artinya skill Anda bisa\Nmembatalkan skill milik Raja Iblis.
Dialogue: 0,0:13:55.27,0:13:59.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin skill yang dapat mengulang kegagalan.
Dialogue: 0,0:14:00.90,0:14:03.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau memang berbahaya.
Dialogue: 0,0:14:04.66,0:14:05.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:14:05.62,0:14:08.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin lebih baik langsung ke intinya saja.
Dialogue: 0,0:14:09.24,0:14:11.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang menyudutkan Raja Iblis
Dialogue: 0,0:14:11.58,0:14:15.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}diminta mengawasi orang\Nyang mewarisi skill Raja Iblis.
Dialogue: 0,0:14:15.92,0:14:17.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:14:17.38,0:14:20.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paman memang pandai menilai orang,
Dialogue: 0,0:14:20.55,0:14:22.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi dia mudah diperdaya alasan aneh.
Dialogue: 0,0:14:22.92,0:14:24.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak salah.
Dialogue: 0,0:14:24.93,0:14:26.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bicara apa kau?
Dialogue: 0,0:14:32.64,0:14:35.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, Simon,\Nkau ini kakeknya Pangeran Albert?
Dialogue: 0,0:14:36.77,0:14:39.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beliau ini paman ayahku,\NKaisar South Windsor.
Dialogue: 0,0:14:39.94,0:14:42.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti, kurang lebih cucunya, ya.
Dialogue: 0,0:14:43.78,0:14:46.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Albert ini cerdas, tapi...
Dialogue: 0,0:14:46.95,0:14:48.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ya, begitulah.
Dialogue: 0,0:14:48.78,0:14:49.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudnya?
Dialogue: 0,0:14:49.99,0:14:53.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia ini pangeran,\Ntapi hanya setia pada satu tunangannya.
Dialogue: 0,0:14:55.54,0:14:58.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyayangi satu perempuan boleh-boleh saja,
Dialogue: 0,0:14:58.67,0:15:02.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku tak setuju menyerahkan negeri kepada\Npria yang tak berpengalaman dengan wanita.
Dialogue: 0,0:15:02.55,0:15:03.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat, bukan?
Dialogue: 0,0:15:03.47,0:15:07.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inilah sebabnya aku tak bisa memercayainya.
Dialogue: 0,0:15:07.97,0:15:10.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, aku datang melihat langsung.
Dialogue: 0,0:15:10.60,0:15:11.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajar.
Dialogue: 0,0:15:11.93,0:15:14.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, soal skill Great Heal-mu,
Dialogue: 0,0:15:14.94,0:15:17.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa kau memberikannya secara cuma-cuma?
Dialogue: 0,0:15:17.23,0:15:18.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, begini...
Dialogue: 0,0:15:18.69,0:15:21.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal itu, aku masih belum bisa memutuskannya.
Dialogue: 0,0:15:22.03,0:15:23.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa sebaiknya kuberikan gratis,
Dialogue: 0,0:15:23.94,0:15:27.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau kuberikan dengan harga tinggi.
Dialogue: 0,0:15:28.07,0:15:30.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih baik dipatok dengan harga tinggi.
Dialogue: 0,0:15:30.33,0:15:31.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:15:32.24,0:15:36.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika monster melakukannya tanpa\Nmeminta imbalan sedikit pun,
Dialogue: 0,0:15:36.41,0:15:37.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}orang-orang malah akan curiga.
Dialogue: 0,0:15:38.50,0:15:42.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, asalkan dianggap berguna\Ndan nyawaku tidak diincar,
Dialogue: 0,0:15:42.46,0:15:44.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tidak keberatan\Nmemberi penyembuhan cuma-cuma.
Dialogue: 0,0:15:45.13,0:15:48.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kalau untuk rakyat biasa,\Nseharusnya tidak apa-apa.
Dialogue: 0,0:15:48.51,0:15:49.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:15:49.68,0:15:52.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bayaran hanya kuminta dari bangsawan.
Dialogue: 0,0:15:52.93,0:15:54.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, ide yang bagus.
Dialogue: 0,0:15:58.52,0:16:01.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa pendapatmu setelah melihatnya?
Dialogue: 0,0:16:02.27,0:16:04.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin aku bukan tandingannya.
Dialogue: 0,0:16:06.24,0:16:09.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bahkan memikirkan soal biaya.
Dialogue: 0,0:16:09.49,0:16:11.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia nyaris seperti manusia.
Dialogue: 0,0:16:11.74,0:16:15.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski sekuat tenaga melawannya,\Npeluangku hanya 50-50.
Dialogue: 0,0:16:18.08,0:16:19.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitukah?
Dialogue: 0,0:16:19.79,0:16:23.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melawannya saat dia merasa di pihak kita\Nseharusnya lebih mudah, bukan?
Dialogue: 0,0:16:23.29,0:16:26.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih untung kalau nyawaku saja\Nyang terancam.
Dialogue: 0,0:16:26.51,0:16:28.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku
Dialogue: 0,0:16:28.22,0:16:31.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak mau ini menjadi masalah besar.
Dialogue: 0,0:16:31.85,0:16:35.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paman seyakin itu padanya?
Dialogue: 0,0:16:35.68,0:16:36.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:16:39.31,0:16:41.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku punya usul.
Dialogue: 0,0:16:43.23,0:16:46.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau kita jadikan dia\NRaja Iblis berikutnya?
Dialogue: 0,0:16:52.99,0:16:54.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pangeran Albert.
Dialogue: 0,0:16:54.96,0:16:58.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bisa saja menjadi musuh\Njika keadaan mengharuskan.
Dialogue: 0,0:16:58.58,0:16:59.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seandainya harus kulawan,
Dialogue: 0,0:16:59.83,0:17:02.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku perlu memahami kelemahan\Nskill milik Raja Iblis dulu.
Dialogue: 0,0:17:03.59,0:17:06.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan yang bisa membatalkan kekalahan.
Dialogue: 0,0:17:06.71,0:17:09.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, bisa jadi ini jebakan.
Dialogue: 0,0:17:09.72,0:17:13.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk berjaga-jaga, sebaiknya jangan\Ngunakan dulu skill Hukum Alam padanya.
Dialogue: 0,0:17:16.01,0:17:16.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chloe.
Dialogue: 0,0:17:17.39,0:17:18.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akira.
Dialogue: 0,0:17:23.09,0:17:25.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sedang apa?
Dialogue: 0,0:17:25.56,0:17:27.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku merasakan hawa yang tak asing.
Dialogue: 0,0:17:27.78,0:17:29.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak asing?
Dialogue: 0,0:17:29.34,0:17:30.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudmu?
Dialogue: 0,0:17:32.36,0:17:33.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, Chloe.
Dialogue: 0,0:17:38.08,0:17:40.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata kau pintar menggambar!
Dialogue: 0,0:17:40.33,0:17:42.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau kenal orang ini?
Dialogue: 0,0:17:43.17,0:17:44.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:17:44.33,0:17:46.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh. Ya sudah.
Dialogue: 0,0:17:47.96,0:17:50.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak masalah dia tak tahu.
Dialogue: 0,0:17:50.63,0:17:54.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika skill-nya benar\Nseperti yang kubayangkan,
Dialogue: 0,0:17:54.89,0:17:57.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}wajar kalau Chloe tidak mengenalinya.
Dialogue: 0,0:17:57.06,0:17:58.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Artinya...
Dialogue: 0,0:17:59.18,0:18:00.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata memang ada.
Dialogue: 0,0:18:00.64,0:18:01.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chloe?
Dialogue: 0,0:18:04.37,0:18:06.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial, merepotkan saja.
Dialogue: 0,0:18:10.15,0:18:11.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sisa pasukan Raja Iblis!
Dialogue: 0,0:18:12.05,0:18:15.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manusia... berani sekali kalian!
Dialogue: 0,0:18:15.37,0:18:17.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadikan mereka sandera...
Dialogue: 0,0:18:18.41,0:18:19.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan.
Dialogue: 0,0:18:20.20,0:18:22.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Api hitam?
Dialogue: 0,0:18:22.66,0:18:24.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si Panglima Goblin?
Dialogue: 0,0:18:24.83,0:18:27.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Aku dijuluki begitu?
Dialogue: 0,0:18:29.59,0:18:32.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mundur! Mundur!
Dialogue: 0,0:18:32.88,0:18:34.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akira memang hebat!
Dialogue: 0,0:18:34.93,0:18:37.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Caramu membakar mereka keren sekali.
Dialogue: 0,0:18:37.72,0:18:39.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak membunuh mereka.
Dialogue: 0,0:18:41.18,0:18:43.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kenapa mereka diserang?
Dialogue: 0,0:18:46.43,0:18:50.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eirene, Dike, Eunomia.
Dialogue: 0,0:18:51.19,0:18:52.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka teman-temanku.
Dialogue: 0,0:18:58.70,0:18:59.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini di mana?
Dialogue: 0,0:19:00.70,0:19:02.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Masamune!
Dialogue: 0,0:19:02.50,0:19:04.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, Pak Kades?
Dialogue: 0,0:19:04.87,0:19:06.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masamune generasi keempat.
Dialogue: 0,0:19:06.36,0:19:09.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kepala urusan dapur yang punya skill memasak.
Dialogue: 0,0:19:09.96,0:19:12.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong buatkan makanan untuk orang sakit, ya.
Dialogue: 0,0:19:12.26,0:19:13.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mudah.
Dialogue: 0,0:19:13.97,0:19:15.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga mau bantu.
Dialogue: 0,0:19:22.77,0:19:25.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah menyelamatkan kami.
Dialogue: 0,0:19:25.56,0:19:27.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak usah bersujud segala.
Dialogue: 0,0:19:27.98,0:19:29.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak salah, namamu...
Dialogue: 0,0:19:29.98,0:19:31.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya Dike.
Dialogue: 0,0:19:31.23,0:19:32.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Akira.
Dialogue: 0,0:19:32.94,0:19:34.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, Tuan Akira.
Dialogue: 0,0:19:34.61,0:19:37.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak usah pakai "Tuan" segala.
Dialogue: 0,0:19:37.33,0:19:41.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak. Melihat Chloe patuh\Ndan mau tinggal di sini,
Dialogue: 0,0:19:41.24,0:19:44.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}artinya Anda orang\Nyang mewarisi posisi Raja Iblis.
Dialogue: 0,0:19:44.25,0:19:46.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya mewarisi skill-nya.
Dialogue: 0,0:19:47.25,0:19:48.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Akira.
Dialogue: 0,0:19:48.75,0:19:53.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon, perintahkan kakak\Ndan adikku untuk terus hidup.
Dialogue: 0,0:19:54.26,0:19:56.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ras Elf itu berumur panjang.
Dialogue: 0,0:19:56.44,0:19:58.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena umur yang terlalu panjang,
Dialogue: 0,0:19:58.25,0:20:00.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jangankan melanjutkan keturunan,
Dialogue: 0,0:20:00.01,0:20:03.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebagian dari kami kehilangan\Nhasrat untuk hidup.
Dialogue: 0,0:20:03.47,0:20:04.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:20:05.16,0:20:09.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka bahkan kehilangan hasrat\Nuntuk sekadar makan.
Dialogue: 0,0:20:10.38,0:20:11.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pernah dengar soal itu.
Dialogue: 0,0:20:12.19,0:20:15.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada penyakit yang membuat Elf\Nkehilangan minat untuk hidup.
Dialogue: 0,0:20:16.28,0:20:17.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak kapan kau di situ?
Dialogue: 0,0:20:17.53,0:20:19.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ini pengawasmu.
Dialogue: 0,0:20:19.78,0:20:22.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kami ras Elf terakhir,
Dialogue: 0,0:20:22.53,0:20:26.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Raja Iblis tidak tega dan\Nmemerintahkan mereka untuk tetap hidup.
Dialogue: 0,0:20:27.41,0:20:30.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, perintahnya batal saat dia mati?
Dialogue: 0,0:20:30.33,0:20:32.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kau sendiri?
Dialogue: 0,0:20:32.38,0:20:34.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya tidak terkena penyakit itu.
Dialogue: 0,0:20:35.63,0:20:36.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon.
Dialogue: 0,0:20:37.17,0:20:40.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong perintahkan mereka untuk hidup!
Dialogue: 0,0:20:40.89,0:20:41.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti.
Dialogue: 0,0:20:44.51,0:20:46.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:20:52.11,0:20:53.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rock Grave!
Dialogue: 0,0:20:54.65,0:20:55.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:20:59.78,0:21:01.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak! Eunomia!
Dialogue: 0,0:21:13.00,0:21:15.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian berdua, teruslah hidup!
Dialogue: 0,0:21:33.86,0:21:35.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:21:35.52,0:21:37.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus hidup, ya.
Dialogue: 0,0:21:40.11,0:21:42.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah, kalian berdua...
Dialogue: 0,0:21:44.12,0:21:45.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pak Kades!
Dialogue: 0,0:21:45.49,0:21:47.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanannya sudah siap!
Dialogue: 0,0:21:47.49,0:21:48.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chloe...
Dialogue: 0,0:21:50.29,0:21:51.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teman-teman...
Dialogue: 0,0:21:52.33,0:21:54.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya sudah cukup, bukan?
Dialogue: 0,0:22:02.09,0:22:03.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skill penukar, ya?
Dialogue: 0,0:22:04.30,0:22:05.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar kau ini.
Dialogue: 0,0:22:06.61,0:22:09.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana Raja Iblis\Nmemerintah mereka dulu, ya?
