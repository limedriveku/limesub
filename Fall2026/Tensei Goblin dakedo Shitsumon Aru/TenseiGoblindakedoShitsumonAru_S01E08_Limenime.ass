Dialogue: 0,0:01:32.19,0:01:37.95,sign,,0000,0000,0000,,EPISODE 8: JADI PETINGGI DEMI KEBAIKAN BERSAMA,\NMEMANGNYA KENAPA?
Dialogue: 0,0:03:28.87,0:03:30.72,sign,,0000,0000,0000,,"PEMINUM ULUNG"
Dialogue: 0,0:13:51.49,0:13:52.14,sign,,0000,0000,0000,,PENUNGGANG
Dialogue: 0,0:14:24.78,0:14:25.47,sign,,0000,0000,0000,,ALKIMIA
Dialogue: 0,0:16:48.13,0:16:48.94,sign,,0000,0000,0000,,API
Dialogue: 0,0:18:30.88,0:18:32.65,sign,,0000,0000,0000,,KILAT
Dialogue: 0,0:19:21.99,0:19:22.39,sign,,0000,0000,0000,,HALILINTAR
Dialogue: 0,0:19:44.12,0:19:45.54,sign,,0000,0000,0000,,"SEARCH EYE"
Dialogue: 0,0:19:46.51,0:19:47.95,sign,,0000,0000,0000,,KOSONG
Dialogue: 0,0:21:54.79,0:21:55.92,sign,,0000,0000,0000,,PENANDA
Dialogue: 0,0:00:00.00,0:00:10.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}So What's Wrong with\NGetting Reborn as a Goblin?
Dialogue: 0,0:01:44.78,0:01:47.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akira manis sekali.
Dialogue: 0,0:01:47.73,0:01:49.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian berdua jangan heboh.
Dialogue: 0,0:01:49.69,0:01:51.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akira sampai salah tingkah.
Dialogue: 0,0:01:53.59,0:01:55.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, Simon.
Dialogue: 0,0:01:56.95,0:01:58.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kita datang ke sini?
Dialogue: 0,0:01:59.52,0:02:01.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu salahmu sendiri, Sobatku.
Dialogue: 0,0:02:03.36,0:02:06.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau membuat mereka tergila-gila padamu,
Dialogue: 0,0:02:06.36,0:02:09.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi setelah itu jarang mampir lagi.
Dialogue: 0,0:02:10.72,0:02:11.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedih, sedih.
Dialogue: 0,0:02:14.45,0:02:18.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, mereka memohon padaku\Nuntuk mengajakmu ke sini.
Dialogue: 0,0:02:18.95,0:02:19.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:02:20.08,0:02:22.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, belakangan ini aku sibuk.
Dialogue: 0,0:02:22.83,0:02:26.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karen bilang kau ingin bertemu denganku,
Dialogue: 0,0:02:26.71,0:02:29.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi sekalian saja kita ke sini.
Dialogue: 0,0:02:29.42,0:02:32.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, tolong hentikan.
Dialogue: 0,0:02:34.01,0:02:35.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya kau senang
Dialogue: 0,0:02:35.80,0:02:37.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa jadi wanitaku.
Dialogue: 0,0:02:43.98,0:02:45.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan.
Dialogue: 0,0:02:47.90,0:02:50.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya Goblin biasa rupanya.
Dialogue: 0,0:02:50.52,0:02:52.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Mama!
Dialogue: 0,0:02:52.00,0:02:54.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak kapan tempat ini memelihara binatang?
Dialogue: 0,0:02:55.62,0:02:58.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang ini tidak bisa diajak\Nbicara baik-baik.
Dialogue: 0,0:02:59.34,0:03:02.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau kita adu minum?
Dialogue: 0,0:03:02.53,0:03:04.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Goblin menantangku adu minum?
Dialogue: 0,0:03:04.46,0:03:05.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menarik.
Dialogue: 0,0:03:06.19,0:03:07.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bawakan gelasnya!
Dialogue: 0,0:03:08.38,0:03:09.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita mulai.
Dialogue: 0,0:03:10.88,0:03:12.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan menyesal nanti.
Dialogue: 0,0:03:24.24,0:03:27.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baru sebegitu sudah besar mulut.
Dialogue: 0,0:03:27.27,0:03:28.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membosankan.
Dialogue: 0,0:03:28.87,0:03:30.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skill Peminum Ulung.
Dialogue: 0,0:03:30.72,0:03:33.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skill yang membuatku\Ntahan alkohol puluhan kali lipat.
Dialogue: 0,0:03:33.80,0:03:35.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bicara apa kau?
Dialogue: 0,0:03:39.32,0:03:41.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Anu...
Dialogue: 0,0:03:41.82,0:03:44.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Anda jadi terseret begini.
Dialogue: 0,0:03:44.45,0:03:46.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daripada dia terus diganggu,
Dialogue: 0,0:03:46.50,0:03:48.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lebih baik pelanggan itu kuberi pelajaran.
Dialogue: 0,0:03:49.71,0:03:51.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:03:51.90,0:03:53.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Akira hebat, ya.
Dialogue: 0,0:03:54.30,0:03:55.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:03:55.49,0:03:59.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mengarahkan amarah\Npria kurang ajar itu pada dirinya sendiri.
Dialogue: 0,0:04:00.80,0:04:01.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Simon.
Dialogue: 0,0:04:02.49,0:04:03.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bertindak seenaknya.
Dialogue: 0,0:04:05.65,0:04:07.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalaupun kau tidak bertindak,
Dialogue: 0,0:04:07.98,0:04:10.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku sendiri yang akan menghajarnya.
Dialogue: 0,0:04:12.06,0:04:16.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, baru pertama kali datang\Nsudah berani bilang "wanitaku".
Dialogue: 0,0:04:16.69,0:04:19.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cara merayunya seperti perjaka.\NMemalukan sekali.
Dialogue: 0,0:04:21.39,0:04:22.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedas juga, ya.
Dialogue: 0,0:04:22.74,0:04:26.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutmu, pria minimal harus\Nberpengalaman dengan seribu wanita, 'kan?
Dialogue: 0,0:04:26.77,0:04:30.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm, kalau pakai patokan itu,\NAlbert benar-benar payah.
Dialogue: 0,0:04:31.11,0:04:34.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena hanya mencintai satu wanita,\Npikirannya jadi sempit.
Dialogue: 0,0:04:34.80,0:04:39.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gara-gara itu, dia sampai berniat\Nmenjadikanmu Raja Iblis.
Dialogue: 0,0:04:40.59,0:04:41.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menjadikanku Raja Iblis?!
Dialogue: 0,0:04:43.45,0:04:45.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya?
Dialogue: 0,0:04:45.56,0:04:48.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manusia sudah lama menderita\Nkarena Raja Iblis.
Dialogue: 0,0:04:49.28,0:04:52.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anjing yang terpojok pun bisa melompati\Ntembok yang lebih tinggi dari kucing.
Dialogue: 0,0:04:56.97,0:05:01.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari anjing-anjing itulah lahir pahlawan\Nyang berhasil memojokkan Raja Iblis.
Dialogue: 0,0:05:05.28,0:05:07.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manusia menderita, ya...
Dialogue: 0,0:05:08.01,0:05:10.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dia bisa mengatakannya seenteng itu,
Dialogue: 0,0:05:10.75,0:05:13.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berarti sudah banyak hal yang terjadi.
Dialogue: 0,0:05:14.57,0:05:16.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sobatku.
Dialogue: 0,0:05:17.20,0:05:20.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutmu, bagaimana cara mencegah\Nancaman Raja Iblis sebelum terjadi?
Dialogue: 0,0:05:22.05,0:05:23.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertanyaan ini pasti ada maksudnya.
Dialogue: 0,0:05:24.24,0:05:27.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mencari jawaban atau persetujuan?
Dialogue: 0,0:05:27.66,0:05:28.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika dilihat alurnya...
Dialogue: 0,0:05:30.14,0:05:31.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mencari persetujuan.
Dialogue: 0,0:05:31.36,0:05:34.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian mau mengangkat Raja Iblis sendiri?
Dialogue: 0,0:05:35.11,0:05:36.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:05:37.10,0:05:39.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Raja Iblis pilihan kami sendiri.
Dialogue: 0,0:05:39.64,0:05:45.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu rencana Albert, dan dia memilihmu\Nkarena kau bisa diajak berunding.
Dialogue: 0,0:05:46.73,0:05:49.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau hanya mendengar\Nrencana Pangeran Albert,
Dialogue: 0,0:05:50.15,0:05:53.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku pasti berpikir mana mungkin\Nmanusia bisa menentukan Raja Iblis,
Dialogue: 0,0:05:53.97,0:05:55.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu menganggapnya lelucon.
Dialogue: 0,0:05:56.84,0:05:58.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, bagi orang Jepang modern,
Dialogue: 0,0:05:59.38,0:06:01.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menurut pemahaman mayoritas orang,
Dialogue: 0,0:06:02.69,0:06:05.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Raja Iblis itu bos terakhir\Nyang menutup sebuah cerita.
Dialogue: 0,0:06:06.47,0:06:09.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak ada yang memikirkan\Nnasib dunia setelahnya.
Dialogue: 0,0:06:09.75,0:06:13.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal selama monster masih ada,\NRaja Iblis baru pasti akan muncul.
Dialogue: 0,0:06:14.83,0:06:17.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kau mau jadi Raja Iblis?
Dialogue: 0,0:06:18.11,0:06:19.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu itu, aku tak menangkap maksudnya.
Dialogue: 0,0:06:20.36,0:06:22.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu dia punya niat tersembunyi,
Dialogue: 0,0:06:22.86,0:06:28.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku juga sadar pihak manusia\Npasti punya niatnya sendiri.
Dialogue: 0,0:06:28.91,0:06:31.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian tak bisa berunding dengan\NRaja Iblis sebelumnya?
Dialogue: 0,0:06:31.89,0:06:34.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya dia juga tidak jahat,
Dialogue: 0,0:06:34.44,0:06:36.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}setidaknya di mata para monster.
Dialogue: 0,0:06:37.33,0:06:39.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena posisi masing-masing,\Nkeduanya tak bisa berunding,
Dialogue: 0,0:06:40.17,0:06:42.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi rupanya Raja Iblis sebelumnya dihormati.
Dialogue: 0,0:06:42.88,0:06:44.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski pertemuan kami singkat,
Dialogue: 0,0:06:44.57,0:06:48.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku bisa merasakan Raja Iblis\Nsebelumnya bukan orang jahat.
Dialogue: 0,0:06:48.89,0:06:53.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia raja yang dihormati monster seperti\NChloe dan memberi Elf kesempatan hidup.
Dialogue: 0,0:06:54.01,0:06:55.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti apa sosoknya, ya?
Dialogue: 0,0:06:58.20,0:07:01.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kau yang jadi Raja Iblis,\Ntak akan ada masalah.
Dialogue: 0,0:07:01.94,0:07:05.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tak berniat menghancurkan dunia\Ndan memusnahkan manusia, 'kan?
Dialogue: 0,0:07:06.99,0:07:08.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja tidak.
Dialogue: 0,0:07:09.16,0:07:12.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, 'kan?\NBerarti tak masalah.
Dialogue: 0,0:07:12.91,0:07:15.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, kenapa tadi kau seolah menentangnya?
Dialogue: 0,0:07:16.37,0:07:20.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah buruknya pria\Nyang hanya mencintai satu wanita.
Dialogue: 0,0:07:21.31,0:07:23.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saking semangatnya, dia jadi terburu-buru.
Dialogue: 0,0:07:23.34,0:07:25.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diam-diam menyiapkan semua sendiri.
Dialogue: 0,0:07:26.38,0:07:29.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Persis bocah yang mau melamar\Ndengan memberi kejutan.
Dialogue: 0,0:07:31.10,0:07:35.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dibandingkan dia, Tiga Bangsawan\Nmasih lebih baik.
Dialogue: 0,0:07:36.60,0:07:40.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Albert yakin yang dilakukannya\Ndemi kebaikan umat manusia.
Dialogue: 0,0:07:41.40,0:07:45.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sementara Tiga Bangsawan melakukannya\Nhanya demi kepuasan sendiri.
Dialogue: 0,0:07:46.45,0:07:49.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutmu, mana yang lebih baik?
Dialogue: 0,0:07:50.10,0:07:52.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang yakin dirinya\Nbertindak demi kebaikan
Dialogue: 0,0:07:52.37,0:07:55.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}biasanya justru yang paling merepotkan.
Dialogue: 0,0:07:56.16,0:07:57.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keduanya sama-sama bermasalah.
Dialogue: 0,0:07:58.75,0:08:00.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau menceritakan ini padaku?
Dialogue: 0,0:08:00.83,0:08:03.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena aku belajar darimu, Sobatku.
Dialogue: 0,0:08:04.21,0:08:07.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pernah bilang, untuk melihat sifat\Nasli seseorang, lihatlah kegagalannya.
Dialogue: 0,0:08:08.59,0:08:11.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah merenungkan kata-katamu itu.
Dialogue: 0,0:08:11.29,0:08:14.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pandanganmu unik dan tepat sasaran.
Dialogue: 0,0:08:15.22,0:08:17.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Albert itu orang luar biasa.
Dialogue: 0,0:08:17.75,0:08:21.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tak pernah gagal dan\Nselalu mengerjakan semuanya sendiri.
Dialogue: 0,0:08:22.19,0:08:24.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika skill-nya sesuai dugaanku,
Dialogue: 0,0:08:24.53,0:08:25.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}artinya masuk akal.
Dialogue: 0,0:08:26.10,0:08:29.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan saat tidur dengan tunangannya,\Ndia hanya diam.
Dialogue: 0,0:08:32.74,0:08:33.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa bahas itu?
Dialogue: 0,0:08:34.24,0:08:36.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, kenapa dia tahu\Nurusan ranjang orang?
Dialogue: 0,0:08:37.08,0:08:41.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia hanya diam dan berusaha\Nmemberikan yang terbaik.
Dialogue: 0,0:08:44.90,0:08:47.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, itu tidak salah.
Dialogue: 0,0:08:47.63,0:08:49.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah itu sudah cukup?
Dialogue: 0,0:08:49.69,0:08:51.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa benar begitu?
Dialogue: 0,0:08:51.96,0:08:54.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bercinta dengan wanita itu soal komunikasi.
Dialogue: 0,0:08:54.89,0:08:58.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perhatikan seleranya, kondisi tubuhnya,\Njuga suasananya,
Dialogue: 0,0:08:58.68,0:09:01.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bukan memaksakan diri untuk tampil sempurna.
Dialogue: 0,0:09:02.02,0:09:03.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:09:03.75,0:09:07.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sendiri setuju kau jadi Raja Iblis,
Dialogue: 0,0:09:07.54,0:09:10.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi rasanya salah kalau dipaksakan.
Dialogue: 0,0:09:11.15,0:09:13.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, aku memutuskan\Nuntuk bicara terus terang.
Dialogue: 0,0:09:14.28,0:09:15.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, begitu.
Dialogue: 0,0:09:16.66,0:09:19.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena Albert tak pernah merasakan gagal,
Dialogue: 0,0:09:19.12,0:09:22.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia cenderung mengerjakan semuanya sendiri.
Dialogue: 0,0:09:22.79,0:09:24.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru itulah kegagalannya.
Dialogue: 0,0:09:25.25,0:09:28.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, kuakui kau luar biasa.
Dialogue: 0,0:09:30.63,0:09:31.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketahuan, ya.
Dialogue: 0,0:09:32.43,0:09:34.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Simon menolak cara si Pangeran
Dialogue: 0,0:09:34.76,0:09:37.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang mau membereskan semua\Ntanpa berunding dengan orang lain.
Dialogue: 0,0:09:37.84,0:09:40.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia justru memujiku\Nyang sering datang menemuinya.
Dialogue: 0,0:09:40.56,0:09:44.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tahu aku datang menemuinya\Nsaat sedang butuh bantuan.
Dialogue: 0,0:09:44.40,0:09:45.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, dia membahas ini.
Dialogue: 0,0:09:46.77,0:09:50.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Simon, bagaimana caranya jadi\Npetinggi manusia?
Dialogue: 0,0:09:57.71,0:09:59.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Se-Selamat pagi.
Dialogue: 0,0:10:00.41,0:10:01.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pagi.
Dialogue: 0,0:10:02.45,0:10:04.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku membuat dia kesal?
Dialogue: 0,0:10:05.00,0:10:09.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak tahu dia marah\Nkarena apa, bisa gawat.
Dialogue: 0,0:10:09.38,0:10:11.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, otak, berpikirlah!
Dialogue: 0,0:10:14.34,0:10:15.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudahlah.
Dialogue: 0,0:10:16.39,0:10:18.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah selesai bicara dengan Tuan Wedana?
Dialogue: 0,0:10:19.26,0:10:21.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, ya.
Dialogue: 0,0:10:21.55,0:10:23.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dapat informasi penting.
Dialogue: 0,0:10:24.21,0:10:25.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian membahas apa?
Dialogue: 0,0:10:26.48,0:10:28.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal cara menjadi petinggi manusia.
Dialogue: 0,0:10:29.90,0:10:31.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau jadi petinggi?
Dialogue: 0,0:10:31.42,0:10:34.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, rencananya begitu.
Dialogue: 0,0:10:35.49,0:10:37.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Supaya aku bisa jadi pemilik sah hutan ini.
Dialogue: 0,0:10:38.69,0:10:39.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk apa?
Dialogue: 0,0:10:40.66,0:10:43.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karen, menurutmu bagaimana\Ncaranya agar hidup kita
Dialogue: 0,0:10:43.78,0:10:45.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tak jungkir balik dalam sekejap?
Dialogue: 0,0:10:45.37,0:10:46.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana, ya?
Dialogue: 0,0:10:47.29,0:10:48.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belum pernah terpikir.
Dialogue: 0,0:10:49.51,0:10:51.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masuk ke organisasi atau sistem.
Dialogue: 0,0:10:52.01,0:10:55.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebutannya bisa macam-macam,\Npokoknya masuk saja ke dalamnya.
Dialogue: 0,0:10:55.63,0:10:56.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:10:57.09,0:11:00.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kalau masuk organisasi,\Nhidup kita seperti naik tangga?
Dialogue: 0,0:11:00.43,0:11:01.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:11:01.42,0:11:04.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tangga itu biasanya hanya punya satu jalur,
Dialogue: 0,0:11:04.77,0:11:08.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi sekali sudah naik,\Njarang ada perubahan drastis.
Dialogue: 0,0:11:08.41,0:11:10.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum mau membesarkan namamu dulu?
Dialogue: 0,0:11:10.88,0:11:12.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hasilnya, ya, keadaanku sekarang.
Dialogue: 0,0:11:13.65,0:11:15.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak mengharapkan hal sebesar itu.
Dialogue: 0,0:11:16.91,0:11:17.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau menurutmu?
Dialogue: 0,0:11:18.44,0:11:19.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau itu hasil pemikiranmu,
Dialogue: 0,0:11:20.30,0:11:21.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pasti tidak salah.
Dialogue: 0,0:11:22.43,0:11:24.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia percaya padaku, ya.
Dialogue: 0,0:11:24.77,0:11:27.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, bagaimana caranya jadi petinggi?
Dialogue: 0,0:11:28.17,0:11:30.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sekadar Demang, bisa saja.
Dialogue: 0,0:11:31.34,0:11:33.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cukup membuat perjanjian\Ndengan Wedana sepertiku,
Dialogue: 0,0:11:33.86,0:11:38.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu berikan upeti dan pasukan\Nsesuai luas wilayahmu.
Dialogue: 0,0:11:40.15,0:11:41.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, begitulah.
Dialogue: 0,0:11:41.60,0:11:45.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesekali, mungkin sebagian timmu\Nharus dikirim ikut ekspedisi.
Dialogue: 0,0:11:45.68,0:11:46.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, boleh.
Dialogue: 0,0:11:47.10,0:11:48.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, tidak keberatan?
Dialogue: 0,0:11:48.94,0:11:51.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Toh, ini sama saja seperti\NEchigoya dan yang lain, 'kan?
Dialogue: 0,0:11:51.73,0:11:53.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kuterima dengan senang hati.
Dialogue: 0,0:11:53.67,0:11:55.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Hanzo.
Dialogue: 0,0:11:56.74,0:11:58.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti tinggal satu masalah lagi.
Dialogue: 0,0:12:00.91,0:12:04.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang dikirim sebaiknya yang kelihatan kuat.
Dialogue: 0,0:12:04.58,0:12:06.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuat atau tidaknya sebenarnya bukan masalah,
Dialogue: 0,0:12:07.21,0:12:09.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku mau mereka benar-benar seperti pasukan.
Dialogue: 0,0:12:09.79,0:12:11.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang kuserahkan kepada Simon\Nitu kekuatan militer,
Dialogue: 0,0:12:11.96,0:12:14.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi wujudnya harus seperti pasukan.
Dialogue: 0,0:12:14.77,0:12:17.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Timmu yang sekarang\Nkurang mirip pasukan, 'kan?
Dialogue: 0,0:12:17.99,0:12:19.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:12:19.88,0:12:22.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau pakai naga?
Dialogue: 0,0:12:22.05,0:12:25.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Izyz, pakai naga bagaimana?
Dialogue: 0,0:12:25.43,0:12:28.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti manusia yang bertarung\Nsambil menunggang kuda.
Dialogue: 0,0:12:29.48,0:12:30.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasukan penunggang naga, ya?
Dialogue: 0,0:12:31.13,0:12:33.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bisa, itu hebat.
Dialogue: 0,0:12:34.32,0:12:35.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya bisa?
Dialogue: 0,0:12:35.73,0:12:38.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa memanggil naga-naga lain kemari.
Dialogue: 0,0:12:38.96,0:12:41.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau membantu sejauh itu?
Dialogue: 0,0:12:41.90,0:12:45.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini-begini, aku sudah hidup lama.
Dialogue: 0,0:12:45.59,0:12:47.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berpikir jangka panjang, ya.
Dialogue: 0,0:12:47.38,0:12:48.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, mohon bantuannya.
Dialogue: 0,0:12:49.10,0:12:50.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, kupanggil mereka, ya.
Dialogue: 0,0:12:51.10,0:12:52.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang juga?!
Dialogue: 0,0:13:13.10,0:13:14.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu...
Dialogue: 0,0:13:14.74,0:13:16.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku tak mendekat...
Dialogue: 0,0:13:17.48,0:13:21.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skill-ku tak bisa mengulang kejadian\Nyang tak kusaksikan langsung.
Dialogue: 0,0:13:22.20,0:13:23.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus bergegas.
Dialogue: 0,0:13:32.04,0:13:34.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka diam seperti anjing penurut.
Dialogue: 0,0:13:34.42,0:13:36.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar seperti bawahan.
Dialogue: 0,0:13:36.78,0:13:38.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka bisa ditunggangi?
Dialogue: 0,0:13:39.13,0:13:39.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu bisa.
Dialogue: 0,0:13:40.51,0:13:42.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pinjamkan punggung kalian, ya.
Dialogue: 0,0:13:43.68,0:13:45.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana? Mau coba naik?
Dialogue: 0,0:13:46.05,0:13:46.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kucoba!
Dialogue: 0,0:13:52.68,0:13:53.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, terbang!
Dialogue: 0,0:13:57.77,0:14:00.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat. Padahal tanpa pelana\Ndan tali kekang.
Dialogue: 0,0:14:01.11,0:14:03.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tak salah,\NHanzo punya skill Penunggang.
Dialogue: 0,0:14:03.78,0:14:04.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pantas saja.
Dialogue: 0,0:14:05.12,0:14:07.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, sistem buatanmu ada hasilnya juga, ya.
Dialogue: 0,0:14:08.33,0:14:08.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:14:09.46,0:14:10.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, ya.
Dialogue: 0,0:14:12.08,0:14:13.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ke sana sebentar.
Dialogue: 0,0:14:15.33,0:14:16.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pak Kades.
Dialogue: 0,0:14:16.54,0:14:17.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anginnya nyaman sekali...
Dialogue: 0,0:14:17.54,0:14:18.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo.
Dialogue: 0,0:14:22.61,0:14:24.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku paham, Pak Kades.
Dialogue: 0,0:14:25.51,0:14:26.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alkimia!
Dialogue: 0,0:14:34.94,0:14:36.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanzo memang hebat.
Dialogue: 0,0:14:36.48,0:14:37.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Insting bertarungnya luar biasa.
Dialogue: 0,0:14:38.44,0:14:39.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akira kelihatan terdesak.
Dialogue: 0,0:14:40.15,0:14:41.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru Akira yang lebih unggul.
Dialogue: 0,0:14:41.90,0:14:42.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudnya?
Dialogue: 0,0:14:43.49,0:14:45.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka ibarat guru dan murid.
Dialogue: 0,0:14:47.34,0:14:50.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akira sedang melatih Hanzo.
Dialogue: 0,0:14:51.24,0:14:54.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga. Akira kelihatan\Nsama sekali belum lelah.
Dialogue: 0,0:14:55.46,0:14:57.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, pengalaman mereka jauh berbeda.
Dialogue: 0,0:15:01.34,0:15:01.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kena!
Dialogue: 0,0:15:08.39,0:15:09.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertarungan selesai.
Dialogue: 0,0:15:14.26,0:15:16.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat, Pak Kades memang kuat!
Dialogue: 0,0:15:16.67,0:15:17.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau juga, Hanzo.
Dialogue: 0,0:15:18.23,0:15:20.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baru pertama kali, tapi sudah bisa\Nmengendalikan naga sebaik itu.
Dialogue: 0,0:15:21.09,0:15:22.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:15:22.62,0:15:23.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berbeda dari kuda,
Dialogue: 0,0:15:23.79,0:15:27.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}naga bisa menggigit dan mencakar.
Dialogue: 0,0:15:28.62,0:15:30.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kelebihan itu bisa\Ndimanfaatkan saat bertarung,
Dialogue: 0,0:15:30.99,0:15:32.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau bisa menyerang titik buta lawan.
Dialogue: 0,0:15:33.41,0:15:34.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga, Pak Kades!
Dialogue: 0,0:15:36.01,0:15:37.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Karen!
Dialogue: 0,0:15:37.43,0:15:39.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana pertarunganku tadi?
Dialogue: 0,0:15:39.67,0:15:42.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat. Kau sudah setara\Nkavaleri kelas satu.
Dialogue: 0,0:15:43.23,0:15:44.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:15:44.30,0:15:46.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan terus berlatih!
Dialogue: 0,0:15:46.86,0:15:48.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski berganti generasi,
Dialogue: 0,0:15:48.43,0:15:50.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ingatan mereka seolah ikut terwariskan.
Dialogue: 0,0:15:51.18,0:15:55.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melihatnya akrab dengan Karen,\Naku jadi ikut senang.
Dialogue: 0,0:16:01.38,0:16:03.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pangeran... Albert?
Dialogue: 0,0:16:03.76,0:16:04.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa Anda di sini?
Dialogue: 0,0:16:05.52,0:16:06.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akira...
Dialogue: 0,0:16:09.03,0:16:12.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata kau tak bermusuhan dengan\Nsang Naga Langit Hitam.
Dialogue: 0,0:16:12.69,0:16:14.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, memang tidak.
Dialogue: 0,0:16:14.90,0:16:16.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku terlalu cepat menyimpulkan.
Dialogue: 0,0:16:16.96,0:16:19.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, baguslah kalau tak terjadi apa-apa.
Dialogue: 0,0:16:20.08,0:16:20.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ulang.
Dialogue: 0,0:16:26.97,0:16:27.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:16:28.88,0:16:30.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada apa-apa.
Dialogue: 0,0:16:33.47,0:16:35.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau lapar setelah bertarung?
Dialogue: 0,0:16:37.23,0:16:39.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Naga itu makan apa, ya?
Dialogue: 0,0:16:44.60,0:16:45.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau...
Dialogue: 0,0:16:47.03,0:16:48.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}makanlah ini.
Dialogue: 0,0:16:59.16,0:16:59.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Naga Api?
Dialogue: 0,0:17:00.23,0:17:02.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia berevolusi karena memakan skill?
Dialogue: 0,0:17:02.46,0:17:04.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Izyz, dia...
Dialogue: 0,0:17:06.25,0:17:08.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kau lakukan?
Dialogue: 0,0:17:09.92,0:17:12.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya seperti katak yang dipelototi ular.
Dialogue: 0,0:17:14.39,0:17:15.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudmu?
Dialogue: 0,0:17:15.97,0:17:18.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya memberinya skill,\Nsama seperti padamu waktu itu.
Dialogue: 0,0:17:19.56,0:17:20.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ada yang salah?
Dialogue: 0,0:17:25.81,0:17:27.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Naga sebesar itu pun sampai ketakutan.
Dialogue: 0,0:17:28.53,0:17:32.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini, semuanya tunduk\Ndi bawah tatapan tajam Izyz.
Dialogue: 0,0:17:34.24,0:17:35.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sampai kaget.
Dialogue: 0,0:17:35.71,0:17:37.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata bisa begini, ya.
Dialogue: 0,0:17:38.84,0:17:41.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat, kau jadi makin keren.
Dialogue: 0,0:17:42.37,0:17:45.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau juga baru pertama kali melihatnya?
Dialogue: 0,0:17:45.25,0:17:47.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, aku belum pernah melihat ini.
Dialogue: 0,0:17:48.05,0:17:49.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini baru pertama kali.
Dialogue: 0,0:17:49.50,0:17:52.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kau yang bilang baru pertama kali,\Naku jadi takut.
Dialogue: 0,0:17:53.30,0:17:55.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah kau juga memakan skill?
Dialogue: 0,0:17:55.76,0:17:58.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biasanya, memakan skill\Ntidak memicu evolusi.
Dialogue: 0,0:17:58.85,0:17:59.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka juga begitu?
Dialogue: 0,0:18:00.64,0:18:01.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:18:01.73,0:18:03.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti mereka memang memakan skill,
Dialogue: 0,0:18:03.98,0:18:06.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi baru kali ini skill memicu evolusi.
Dialogue: 0,0:18:06.34,0:18:07.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau merasakan perubahan lain?
Dialogue: 0,0:18:12.03,0:18:12.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat!
Dialogue: 0,0:18:13.20,0:18:14.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia benar-benar jadi makhluk lain.
Dialogue: 0,0:18:15.49,0:18:16.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:18:16.91,0:18:19.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba berikan skill-nya sekali lagi.
Dialogue: 0,0:18:19.45,0:18:20.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:18:24.50,0:18:25.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak terjadi apa-apa.
Dialogue: 0,0:18:26.21,0:18:27.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa, ya?
Dialogue: 0,0:18:28.63,0:18:29.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau dia?
Dialogue: 0,0:18:37.43,0:18:39.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, ternyata benar.
Dialogue: 0,0:18:39.18,0:18:40.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia berevolusi.
Dialogue: 0,0:18:42.18,0:18:43.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian masih mau makan?
Dialogue: 0,0:18:46.19,0:18:46.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo?
Dialogue: 0,0:18:47.19,0:18:50.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pak Kades, sepertinya mereka sudah kenyang.
Dialogue: 0,0:18:50.99,0:18:51.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, 'kan?
Dialogue: 0,0:18:56.43,0:18:58.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah akrab sekali, ya.
Dialogue: 0,0:18:59.45,0:19:00.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akira.
Dialogue: 0,0:19:00.55,0:19:04.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebelumnya kau mengevolusi\Nskill Hanzo dan Chloe, 'kan?
Dialogue: 0,0:19:04.45,0:19:06.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, benar.
Dialogue: 0,0:19:06.75,0:19:10.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skill mereka jadi lebih kuat\Ndaripada skill biasa, 'kan?
Dialogue: 0,0:19:14.67,0:19:18.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertanyaan Karen pasti ada tujuannya.\NAku paham maksudnya.
Dialogue: 0,0:19:18.42,0:19:20.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kucoba memberinya skill tingkat atas.
Dialogue: 0,0:19:20.94,0:19:21.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halilintar.
Dialogue: 0,0:19:22.43,0:19:24.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skill peninggalan Hanzo sebelumnya.
Dialogue: 0,0:19:39.74,0:19:41.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat.
Dialogue: 0,0:19:41.53,0:19:43.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia jadi makin besar\Ndan kelihatan makin kuat.
Dialogue: 0,0:19:44.12,0:19:45.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Search Eye.
Dialogue: 0,0:19:48.13,0:19:51.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, pada dasarnya mereka\Ntidak punya skill.
Dialogue: 0,0:19:51.29,0:19:52.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:19:52.25,0:19:54.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena mereka belum makan.
Dialogue: 0,0:19:55.17,0:19:57.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, jadi begitu patokannya.
Dialogue: 0,0:19:58.32,0:20:00.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya aku masih mau mencoba lagi.
Dialogue: 0,0:20:01.18,0:20:03.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, dia kelihatannya juga sudah kenyang.
Dialogue: 0,0:20:05.89,0:20:07.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon kerja samanya untuk latihan besok, ya.
Dialogue: 0,0:20:07.82,0:20:09.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, tapi...
Dialogue: 0,0:20:09.60,0:20:11.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa besok aku boleh pulang cepat?
Dialogue: 0,0:20:11.41,0:20:13.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, boleh.
Dialogue: 0,0:20:13.82,0:20:15.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh? Syukurlah!
Dialogue: 0,0:20:17.99,0:20:20.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena setelah latihan besok,
Dialogue: 0,0:20:20.03,0:20:22.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku sudah janji mau membuat anak.
Dialogue: 0,0:20:22.49,0:20:24.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu namanya bendera kematian.
Dialogue: 0,0:20:29.96,0:20:31.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Echigoya,
Dialogue: 0,0:20:34.03,0:20:36.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sudah membuatkan baju untuk putriku.
Dialogue: 0,0:20:38.01,0:20:41.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, seragam pelayan buatan Echigoya\Nyang kuidamkan!
Dialogue: 0,0:20:41.22,0:20:42.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Ayah.
Dialogue: 0,0:20:43.33,0:20:45.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru berkat pengawalanmu,
Dialogue: 0,0:20:45.28,0:20:48.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami bisa berdagang dengan tenang.
Dialogue: 0,0:20:48.14,0:20:50.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baju begitu saja bukan apa-apa.
Dialogue: 0,0:20:51.44,0:20:53.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya melakukan tugasku.
Dialogue: 0,0:20:54.19,0:20:56.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sayang sekali pada putrimu, ya.
Dialogue: 0,0:20:56.91,0:20:58.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia hartaku.
Dialogue: 0,0:20:58.62,0:21:00.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak tergantikan oleh apa pun.
Dialogue: 0,0:21:01.24,0:21:03.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga ingin cepat punya anak.
Dialogue: 0,0:21:03.83,0:21:04.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:21:05.08,0:21:06.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau membuat banyak!
Dialogue: 0,0:21:06.87,0:21:09.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putrimu juga sudah waktunya\Nmembuat anak, 'kan?
Dialogue: 0,0:21:11.63,0:21:15.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membuat... anak?
Dialogue: 0,0:21:15.30,0:21:17.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kau mau menikahi putriku...\N- Kainas?
Dialogue: 0,0:21:18.05,0:21:20.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mati kau!
Dialogue: 0,0:21:20.09,0:21:23.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Takkan kuserahkan dia padamu!\N- Aku salah bicara, ya? Maaf!
Dialogue: 0,0:21:29.06,0:21:30.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mundur, Echigoya!
Dialogue: 0,0:21:34.77,0:21:35.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat lari!
Dialogue: 0,0:21:40.95,0:21:41.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kainas!
Dialogue: 0,0:21:42.70,0:21:44.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lumayan untuk ukuran manusia.
Dialogue: 0,0:21:56.88,0:21:58.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, Pak Kades?
Dialogue: 0,0:21:58.53,0:22:02.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk berjaga-jaga, aku sudah memasang\Nskill Penanda pada Echigoya.
Dialogue: 0,0:22:02.55,0:22:03.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong jaga desa kita.
Dialogue: 0,0:22:03.97,0:22:04.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:22:07.35,0:22:09.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Echigoya, semoga kau baik-baik saja.
