Dialogue: 0,0:03:45.83,0:03:47.74,sign,,0000,0000,0000,,EPISODE 5: DIBENCI ELF YANG SEDANG PUBER,\NMEMANGNYA KENAPA?
Dialogue: 0,0:04:40.76,0:04:43.55,sign,,0000,0000,0000,,SINIS
Dialogue: 0,0:04:51.56,0:04:53.39,sign,,0000,0000,0000,,EMBUSAN ANGIN
Dialogue: 0,0:07:00.92,0:07:01.29,sign,,0000,0000,0000,,PILAR ES
Dialogue: 0,0:09:36.78,0:09:37.13,sign,,0000,0000,0000,,TATO
Dialogue: 0,0:09:38.64,0:09:40.12,sign,,0000,0000,0000,,AKU DIKALAHKAN GOBLIN
Dialogue: 0,0:09:49.63,0:09:50.05,sign,,0000,0000,0000,,ANJING
Dialogue: 0,0:17:00.27,0:17:01.04,sign,,0000,0000,0000,,AKU DIKALAHKAN GOBLIN
Dialogue: 0,0:17:57.20,0:17:59.39,sign,,0000,0000,0000,,"HUKUM ALAM"
Dialogue: 0,0:00:01.02,0:00:02.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:00:02.77,0:00:04.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus hidup, ya.
Dialogue: 0,0:00:07.40,0:00:10.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah, kalian berdua.
Dialogue: 0,0:00:11.24,0:00:12.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pak Kades!
Dialogue: 0,0:00:12.78,0:00:14.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanannya sudah siap!
Dialogue: 0,0:00:14.79,0:00:15.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chloe.
Dialogue: 0,0:00:17.50,0:00:18.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teman-teman...
Dialogue: 0,0:00:21.25,0:00:22.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Akira!
Dialogue: 0,0:00:22.50,0:00:26.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah bagaimana kami harus membalas Anda.
Dialogue: 0,0:00:27.01,0:00:28.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah, tidak usah.
Dialogue: 0,0:00:28.80,0:00:31.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya, Dike, akan mengabdi kepada Anda.
Dialogue: 0,0:00:31.89,0:00:34.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya bersedia melakukan apa saja.
Dialogue: 0,0:00:35.22,0:00:36.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau berlebihan.
Dialogue: 0,0:00:42.15,0:00:44.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Echigoya, kemari sebentar!
Dialogue: 0,0:00:44.90,0:00:46.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap!
Dialogue: 0,0:00:47.15,0:00:51.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini Eirene, Dike, dan Eunomia.
Dialogue: 0,0:00:51.86,0:00:53.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baju mereka sudah robek-robek.
Dialogue: 0,0:00:53.78,0:00:56.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong buatkan baju baru untuk mereka, ya.
Dialogue: 0,0:00:56.66,0:00:59.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap, laksanakan!
Dialogue: 0,0:00:59.04,0:00:59.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan!
Dialogue: 0,0:00:59.96,0:01:03.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Akira, tidak usah repot-repot.
Dialogue: 0,0:01:03.50,0:01:07.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, yang sedang senggang,\Ntemani mereka ke tempat pemandian, ya.
Dialogue: 0,0:01:12.01,0:01:14.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga mau ikut mandi!
Dialogue: 0,0:01:16.68,0:01:17.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo!
Dialogue: 0,0:01:32.86,0:01:35.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karen, tolong kabarkan soal ini\Nkepada Simon, ya.
Dialogue: 0,0:01:35.99,0:01:36.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:01:36.78,0:01:39.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kabarkan... bukan, maksudku laporkan.
Dialogue: 0,0:01:43.17,0:01:47.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Laporkan bahwa aku menampung ras Elf\Nmantan pasukan Raja Iblis di desa kami,
Dialogue: 0,0:01:47.00,0:01:51.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan tak perlu cemas karena mereka\Nbisa kukendalikan dengan skill-ku.
Dialogue: 0,0:01:52.09,0:01:53.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengerti.
Dialogue: 0,0:01:53.72,0:01:54.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:01:54.76,0:01:57.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika ini nantinya diizinkan,
Dialogue: 0,0:01:57.81,0:02:02.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku punya alasan sah untuk melindungi mereka\Nsaat kembali diincar manusia.
Dialogue: 0,0:02:03.52,0:02:05.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti kusampaikan.
Dialogue: 0,0:02:06.36,0:02:08.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau benar-benar berhati-hati, ya.
Dialogue: 0,0:02:08.86,0:02:10.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon bantuannya, ya.
Dialogue: 0,0:02:11.00,0:02:21.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}So What's Wrong with\NGetting Reborn as a Goblin?
Dialogue: 0,0:03:42.91,0:03:44.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pak Kades!
Dialogue: 0,0:03:44.54,0:03:45.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat sini!
Dialogue: 0,0:03:47.75,0:03:50.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, cantik sekali.
Dialogue: 0,0:03:50.25,0:03:51.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Echigoya memang hebat.
Dialogue: 0,0:03:53.59,0:03:55.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka memang cantik,
Dialogue: 0,0:03:55.46,0:03:57.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku juga tidak kalah cantik.
Dialogue: 0,0:03:57.51,0:03:59.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami boleh memakai ini?
Dialogue: 0,0:03:59.39,0:04:01.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku suka baju ini!
Dialogue: 0,0:04:01.93,0:04:05.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baju-baju buatan Echigoya sudah rutin\Ndikirim ke kota manusia.
Dialogue: 0,0:04:05.81,0:04:08.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya laris dan menjadi bisnis yang bagus.
Dialogue: 0,0:04:09.10,0:04:11.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian belum pulih total,\Nistirahat saja dulu.
Dialogue: 0,0:04:12.15,0:04:13.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Akira...
Dialogue: 0,0:04:14.57,0:04:17.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa benar tidak apa-apa
Dialogue: 0,0:04:18.20,0:04:19.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami diberi baju sebagus ini?
Dialogue: 0,0:04:21.77,0:04:25.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu... apa saya kelihatan aneh?
Dialogue: 0,0:04:25.29,0:04:27.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak aneh.
Dialogue: 0,0:04:28.21,0:04:29.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah.
Dialogue: 0,0:04:37.13,0:04:38.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Akira...
Dialogue: 0,0:04:43.55,0:04:46.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, barusan itu tidak sengaja.
Dialogue: 0,0:04:46.27,0:04:48.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maaf!
Dialogue: 0,0:04:48.64,0:04:50.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi...
Dialogue: 0,0:04:50.31,0:04:51.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Embusan Angin!
Dialogue: 0,0:04:54.90,0:04:55.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak apa-apa?
Dialogue: 0,0:04:55.94,0:04:57.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Y-Ya.
Dialogue: 0,0:04:57.82,0:05:01.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau baju ini membuatmu sulit bergerak,\Nnanti kuminta dibuatkan yang baru.
Dialogue: 0,0:05:01.70,0:05:03.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak masalah.
Dialogue: 0,0:05:03.49,0:05:04.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:05:04.33,0:05:08.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena Anda senang\Nmelihat saya memakai baju ini...
Dialogue: 0,0:05:09.37,0:05:10.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bilang apa?
Dialogue: 0,0:05:11.83,0:05:14.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu-Bukan apa-apa!
Dialogue: 0,0:05:15.34,0:05:16.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan jatuh lagi, ya.
Dialogue: 0,0:05:18.71,0:05:21.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Echigoya memang luar biasa.
Dialogue: 0,0:05:21.09,0:05:24.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa-bisanya terpikir\Nmembuat baju haram seperti itu.
Dialogue: 0,0:05:24.60,0:05:25.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akira...
Dialogue: 0,0:05:26.97,0:05:29.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan berangkat menemui Tuan Wedana.
Dialogue: 0,0:05:29.48,0:05:31.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, mohon bantuannya.
Dialogue: 0,0:05:32.10,0:05:32.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akira...
Dialogue: 0,0:05:33.69,0:05:34.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau...
Dialogue: 0,0:05:38.48,0:05:40.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan apa-apa!
Dialogue: 0,0:05:40.95,0:05:42.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lupakan saja!
Dialogue: 0,0:05:43.95,0:05:45.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia kenapa?
Dialogue: 0,0:06:00.13,0:06:01.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pergilah.
Dialogue: 0,0:06:01.38,0:06:03.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian sudah memasuki area Desa Goblin.
Dialogue: 0,0:06:03.76,0:06:04.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan lengah.
Dialogue: 0,0:06:04.97,0:06:06.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mungkin si Panglima Goblin.
Dialogue: 0,0:06:07.22,0:06:11.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wahai Dewi Bumi yang agung,\Nberikan kami perlindungan.
Dialogue: 0,0:06:11.39,0:06:12.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skill penguat, ya.
Dialogue: 0,0:06:17.90,0:06:19.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja sama tim yang bagus.
Dialogue: 0,0:06:19.98,0:06:23.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu fokus bertahan, yang lain menyerang.
Dialogue: 0,0:06:23.57,0:06:25.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cih, gesit juga dia.
Dialogue: 0,0:06:25.20,0:06:27.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan gegabah! Kita sudutkan dia!
Dialogue: 0,0:06:27.49,0:06:28.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Api Hitam!
Dialogue: 0,0:06:32.16,0:06:33.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wahai sang Penguasa Langit!
Dialogue: 0,0:06:33.66,0:06:36.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jawab seruanku dengan gelegar halilintar!
Dialogue: 0,0:06:38.88,0:06:40.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:06:40.21,0:06:41.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat ke mana kau?
Dialogue: 0,0:06:41.92,0:06:42.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sulur Kelam!
Dialogue: 0,0:06:46.01,0:06:49.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil, dia bisa membaca taktik kita?
Dialogue: 0,0:06:49.18,0:06:51.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taktik kalian bagus, tapi...
Dialogue: 0,0:06:54.98,0:06:57.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bertahanlah! Perisai Suci!
Dialogue: 0,0:06:58.98,0:06:59.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:06:59.98,0:07:00.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pilar Es!
Dialogue: 0,0:07:04.57,0:07:05.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau menyerang apa?
Dialogue: 0,0:07:05.65,0:07:06.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Api Hitam!
Dialogue: 0,0:07:19.75,0:07:20.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Laporannya selesai.
Dialogue: 0,0:07:21.71,0:07:23.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat juga.
Dialogue: 0,0:07:24.97,0:07:27.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atas persetujuan Tuan Wedana dan Pangeran,
Dialogue: 0,0:07:27.97,0:07:31.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau diizinkan menampung ras iblis dan Elf\Ndi desamu.
Dialogue: 0,0:07:32.01,0:07:33.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke depannya, kau tak perlu melapor lagi.
Dialogue: 0,0:07:34.22,0:07:36.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya. Syukurlah.
Dialogue: 0,0:07:36.73,0:07:38.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baju zirahmu baru, ya.
Dialogue: 0,0:07:38.48,0:07:41.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku minta dibuatkan Echigoya\Nagar gerakanku lebih leluasa.
Dialogue: 0,0:07:42.36,0:07:42.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karen.
Dialogue: 0,0:07:44.65,0:07:46.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau jadi lebih cantik.
Dialogue: 0,0:07:47.03,0:07:47.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:07:49.45,0:07:51.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal perizinan tadi...
Dialogue: 0,0:07:52.12,0:07:56.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena prosesnya cepat,\Nkurasa izin ini sudah mereka siapkan.
Dialogue: 0,0:07:56.08,0:07:57.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pastinya.
Dialogue: 0,0:07:57.62,0:07:59.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si Pangeran itu orangnya seperti apa?
Dialogue: 0,0:07:59.79,0:08:02.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Intinya, dia orang sempurna.
Dialogue: 0,0:08:02.46,0:08:04.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak pernah sekali pun gagal.
Dialogue: 0,0:08:04.92,0:08:07.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kecuali saat melawan Raja Iblis, 'kan?
Dialogue: 0,0:08:07.26,0:08:08.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, benar.
Dialogue: 0,0:08:09.47,0:08:14.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti, skill Albert kemungkinan\Nbisa meniadakan kesalahan.
Dialogue: 0,0:08:15.52,0:08:19.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin skill-nya bisa memutar\Natau mengulang arus waktu...
Dialogue: 0,0:08:20.23,0:08:24.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan waktu itu\Naku sudah terkena skill-nya.
Dialogue: 0,0:08:25.69,0:08:28.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ekspresinya mirip orang\Nyang sudah melakukan kesalahan.
Dialogue: 0,0:08:29.07,0:08:31.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dia bisa melakukan itu...
Dialogue: 0,0:08:31.53,0:08:33.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa mungkin ada batas waktunya?
Dialogue: 0,0:08:34.95,0:08:36.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa mereka penyusup?
Dialogue: 0,0:08:37.03,0:08:41.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, manusia masih sering\Nmenyusup ke desa kami.
Dialogue: 0,0:08:41.78,0:08:44.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Wedana juga sudah mengingatkan,
Dialogue: 0,0:08:44.84,0:08:46.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi karena kalian ini Goblin...
Dialogue: 0,0:08:47.51,0:08:50.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena alasan apa lagi?
Dialogue: 0,0:08:50.80,0:08:54.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama ini kau mengusir penyusup\Ntanpa melukai mereka dengan parah, 'kan?
Dialogue: 0,0:08:54.81,0:08:56.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, benar.
Dialogue: 0,0:08:57.27,0:08:59.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya mereka cukup diperingatkan.
Dialogue: 0,0:08:59.31,0:09:00.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga tidak mau melukai orang.
Dialogue: 0,0:09:01.48,0:09:04.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akibatnya, mereka meremehkanmu\Nkarena tahu takkan dilukai.
Dialogue: 0,0:09:04.98,0:09:06.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu alasannya mereka terus berdatangan.
Dialogue: 0,0:09:07.15,0:09:08.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:09:08.90,0:09:12.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, sebaiknya aku memberi\Nlebih dari sekadar peringatan, ya.
Dialogue: 0,0:09:12.78,0:09:14.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:09:16.58,0:09:20.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama belum ada yang terluka parah,\Nmereka akan terus datang, ya.
Dialogue: 0,0:09:22.62,0:09:24.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:09:24.33,0:09:27.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti, caraku selama ini gagal.
Dialogue: 0,0:09:28.09,0:09:30.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku perlu cara lain.
Dialogue: 0,0:09:31.09,0:09:32.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka ini menyusup.
Dialogue: 0,0:09:32.55,0:09:34.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kuberi saja hukuman setimpal.
Dialogue: 0,0:09:34.97,0:09:36.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hukuman apa?
Dialogue: 0,0:09:37.18,0:09:37.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tato.
Dialogue: 0,0:09:43.10,0:09:44.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini...
Dialogue: 0,0:09:44.85,0:09:46.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lumayan memalukan.
Dialogue: 0,0:09:46.86,0:09:49.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagi sebagian orang,\Nini lebih buruk daripada mati.
Dialogue: 0,0:09:50.07,0:09:51.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dulu, tato seperti ini digunakan
Dialogue: 0,0:09:51.82,0:09:53.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk menandai penjahat.
Dialogue: 0,0:09:54.07,0:09:57.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa negara ini tidak punya\Nkonsep hukuman tato?
Dialogue: 0,0:09:57.87,0:09:59.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belum pernah dengar.
Dialogue: 0,0:10:00.08,0:10:03.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kurasa ini akan efektif.
Dialogue: 0,0:10:03.50,0:10:07.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke depannya, tiap penyusup\Nakan kuhadiahi tato begini.
Dialogue: 0,0:10:07.54,0:10:10.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Idemu menarik juga.
Dialogue: 0,0:10:13.97,0:10:15.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Akira!
Dialogue: 0,0:10:20.47,0:10:22.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:10:22.14,0:10:24.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa berlari-lari?
Dialogue: 0,0:10:25.65,0:10:26.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu...
Dialogue: 0,0:10:28.15,0:10:29.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa Anda lapar?
Dialogue: 0,0:10:30.40,0:10:31.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lapar?
Dialogue: 0,0:10:31.69,0:10:35.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, saya belajar memasak dari Masamune.
Dialogue: 0,0:10:35.99,0:10:40.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kalau Anda tidak keberatan...
Dialogue: 0,0:10:41.20,0:10:43.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, belajar memasak, ya.
Dialogue: 0,0:10:43.16,0:10:44.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh, aku mau coba!
Dialogue: 0,0:10:45.96,0:10:47.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya siapkan dulu.
Dialogue: 0,0:10:50.34,0:10:51.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untung tidak jatuh...
Dialogue: 0,0:10:54.84,0:10:55.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eunomia.
Dialogue: 0,0:10:55.97,0:10:58.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa dia menguntit begitu?
Dialogue: 0,0:10:58.39,0:10:59.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hai, Eunomia.
Dialogue: 0,0:10:59.93,0:11:01.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kau sudah...\N- Jangan harap...
Dialogue: 0,0:11:02.64,0:11:03.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:11:03.10,0:11:06.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan harap bisa sedekat itu\Ndengan Kak Dike!
Dialogue: 0,0:11:11.94,0:11:12.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:11:16.32,0:11:17.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Akira!
Dialogue: 0,0:11:17.61,0:11:19.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedang memasak apa?
Dialogue: 0,0:11:19.70,0:11:21.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga Anda menyukainya.
Dialogue: 0,0:11:25.29,0:11:26.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini kan nikujaga.
Dialogue: 0,0:11:27.17,0:11:28.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nikujaga?
Dialogue: 0,0:11:28.83,0:11:32.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu resep rebusan daging\Ndan kentang buatanku!
Dialogue: 0,0:11:32.92,0:11:34.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat.
Dialogue: 0,0:11:34.13,0:11:36.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau menciptakan nikujaga di dunia ini.
Dialogue: 0,0:11:37.22,0:11:38.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau hebat, Masamune.
Dialogue: 0,0:11:41.97,0:11:43.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dike juga membantu memasak?
Dialogue: 0,0:11:44.10,0:11:45.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Y-Ya.
Dialogue: 0,0:11:45.64,0:11:49.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Besok, aku juga akan membantu memasak!
Dialogue: 0,0:11:49.48,0:11:51.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, ya.
Dialogue: 0,0:11:52.11,0:11:53.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat makan.
Dialogue: 0,0:11:58.24,0:11:59.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak.
Dialogue: 0,0:12:01.24,0:12:03.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dike, kau pasti jadi istri idaman.
Dialogue: 0,0:12:05.75,0:12:08.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga memasak sup itu setiap hari.
Dialogue: 0,0:12:08.83,0:12:11.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bukan sup, tapi rebusan ciptaanku!
Dialogue: 0,0:12:11.21,0:12:12.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak!
Dialogue: 0,0:12:12.88,0:12:14.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ikut aku!
Dialogue: 0,0:12:14.17,0:12:15.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, Mia...
Dialogue: 0,0:12:18.26,0:12:19.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dibenci, ya.
Dialogue: 0,0:12:20.05,0:12:23.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak kusangka sifatnya begitu.
Dialogue: 0,0:12:23.56,0:12:27.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyakit Elf yang bisa merenggut semangat\Ngadis seceria dia memang mengerikan.
Dialogue: 0,0:12:29.02,0:12:31.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, rebusan ini mungkin bisa mengubahnya.
Dialogue: 0,0:12:37.94,0:12:39.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak sekali.
Dialogue: 0,0:12:40.11,0:12:42.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daging dan bumbunya didapat dari mana?
Dialogue: 0,0:12:42.37,0:12:47.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kubeli di kota dari hasil penjualan\Nbaju buatan Echigoya.
Dialogue: 0,0:12:47.04,0:12:48.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bajunya lumayan laris.
Dialogue: 0,0:12:49.08,0:12:50.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pastinya.
Dialogue: 0,0:12:53.42,0:12:55.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa bisnis dagang kalian lancar?
Dialogue: 0,0:12:56.76,0:13:00.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau perlu, aku bisa membicarakannya\Ndengan Tuan Wedana supaya dilancarkan.
Dialogue: 0,0:13:01.64,0:13:04.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, tapi tidak perlu.
Dialogue: 0,0:13:04.01,0:13:05.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau gagal, kami tinggal berhenti.
Dialogue: 0,0:13:07.22,0:13:08.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa tidak masalah?
Dialogue: 0,0:13:09.02,0:13:10.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam bisnis,
Dialogue: 0,0:13:10.19,0:13:14.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pihak yang memiliki potensi rugi terkecil\Npunya posisi terkuat.
Dialogue: 0,0:13:14.90,0:13:18.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami nyaris tidak rugi apa-apa\Njika bisnis dagang ini gagal.
Dialogue: 0,0:13:18.90,0:13:22.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Desa Goblin sudah cukup makmur\Ndengan kondisinya yang sekarang.
Dialogue: 0,0:13:23.66,0:13:26.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah memikirkan sejauh itu, ya.
Dialogue: 0,0:13:28.33,0:13:29.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak, lihat!
Dialogue: 0,0:13:35.42,0:13:37.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak suka bunga, 'kan?
Dialogue: 0,0:13:38.09,0:13:40.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, aku bawa Kakak kemari...
Dialogue: 0,0:13:44.72,0:13:46.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Mia.
Dialogue: 0,0:13:51.60,0:13:56.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan memetik bunga untuk menghias\Nkamar Kakak seperti dulu, lalu...
Dialogue: 0,0:13:57.11,0:13:58.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Akira...
Dialogue: 0,0:13:59.32,0:14:01.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia suka bunga atau tidak, ya?
Dialogue: 0,0:14:07.74,0:14:10.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak bodoh!
Dialogue: 0,0:14:10.87,0:14:12.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eunomia?
Dialogue: 0,0:14:12.41,0:14:15.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bodoh, bodoh, bodoh!\NKakak bodoh sekali!
Dialogue: 0,0:14:17.59,0:14:18.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eunomia!
Dialogue: 0,0:14:18.75,0:14:20.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahaya keluar terlalu jauh dari desa.
Dialogue: 0,0:14:20.88,0:14:23.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan kira kau sudah menang!
Dialogue: 0,0:14:27.14,0:14:28.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menang apanya?
Dialogue: 0,0:14:29.01,0:14:30.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal begini malah tidak peka.
Dialogue: 0,0:14:41.44,0:14:43.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak, apa enak kugosok begini?
Dialogue: 0,0:14:44.65,0:14:47.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak. Terima kasih, ya.
Dialogue: 0,0:14:48.20,0:14:50.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bilas, ya. Setelah ini, kita gantian.
Dialogue: 0,0:14:54.00,0:14:56.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang kau sudah ceria lagi.
Dialogue: 0,0:14:57.58,0:14:59.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf membuat Kakak cemas.
Dialogue: 0,0:15:00.71,0:15:01.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.
Dialogue: 0,0:15:02.17,0:15:06.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ras kita memang begitu, jadi apa boleh buat.
Dialogue: 0,0:15:06.80,0:15:10.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, Kakak paling suka kau ceria begini.
Dialogue: 0,0:15:13.14,0:15:16.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, aku akan terus ceria demi Kakak.
Dialogue: 0,0:15:22.69,0:15:24.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, tempat ini aneh, ya.
Dialogue: 0,0:15:26.20,0:15:28.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemandian sebagus ini...
Dialogue: 0,0:15:28.11,0:15:32.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manusia atau ras iblis kaya pun\Njarang punya, 'kan?
Dialogue: 0,0:15:32.29,0:15:34.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal ini hanya Desa Goblin biasa.
Dialogue: 0,0:15:35.37,0:15:37.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bukan Desa Goblin biasa.
Dialogue: 0,0:15:38.21,0:15:40.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini desa pimpinan Tuan Akira.
Dialogue: 0,0:15:43.63,0:15:47.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak juga sudah bertanya kepada Tuan Akira,
Dialogue: 0,0:15:47.43,0:15:52.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}katanya mandi itu membersihkan\Ndan menyembuhkan jiwa raga kita,
Dialogue: 0,0:15:52.22,0:15:53.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena itu penting.
Dialogue: 0,0:15:55.14,0:15:58.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beliau bahkan meminta Oyuya\Nuntuk mengurus pemandian ini.
Dialogue: 0,0:15:59.31,0:16:02.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beliau memang bijak dan luar biasa.
Dialogue: 0,0:16:03.61,0:16:05.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia kan hanya Goblin biasa!
Dialogue: 0,0:16:12.16,0:16:14.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sedang apa di sini?
Dialogue: 0,0:16:15.12,0:16:19.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Eunomia, jangan berkeliaran.\N- Sedang patroli?
Dialogue: 0,0:16:19.62,0:16:21.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedang mengawasi manusia?
Dialogue: 0,0:16:21.08,0:16:22.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak didengarkan...
Dialogue: 0,0:16:23.29,0:16:24.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitulah.
Dialogue: 0,0:16:24.67,0:16:26.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau itu Raja Iblis, 'kan?
Dialogue: 0,0:16:26.13,0:16:28.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suruh saja anak buahmu!
Dialogue: 0,0:16:28.22,0:16:30.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bukan Raja Iblis, tapi kepala desa.
Dialogue: 0,0:16:30.89,0:16:32.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sistem desa masih belum selesai kususun.
Dialogue: 0,0:16:33.26,0:16:34.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sistem?
Dialogue: 0,0:16:34.76,0:16:37.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tugas pemimpin adalah
Dialogue: 0,0:16:37.02,0:16:41.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}membuat sistem agar pekerjaan\Nbisa diserahkan kepada bawahan.
Dialogue: 0,0:16:41.94,0:16:46.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena sistemnya belum rampung,\Naku yang turun tangan.
Dialogue: 0,0:16:46.61,0:16:48.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau ini bodoh, ya?
Dialogue: 0,0:16:48.11,0:16:51.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau kan Raja Iblis!\NPakai saja kekuatanmu biar cepat beres!
Dialogue: 0,0:16:52.28,0:16:54.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama sekali tidak didengarkan.
Dialogue: 0,0:16:55.79,0:16:57.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya ketemu.
Dialogue: 0,0:16:59.00,0:17:00.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memalukan...
Dialogue: 0,0:17:03.13,0:17:04.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kubunuh kau!
Dialogue: 0,0:17:04.79,0:17:06.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eunomia, sembunyi!
Dialogue: 0,0:17:07.30,0:17:08.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baik.
Dialogue: 0,0:17:08.21,0:17:11.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gara-gara kau, aku jadi bahan tertawaan!
Dialogue: 0,0:17:14.80,0:17:16.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Petualang yang kuusir waktu itu, ya.
Dialogue: 0,0:17:16.81,0:17:19.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang memalukan, tapi itu pantas.
Dialogue: 0,0:17:19.93,0:17:23.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejauh ini, tato berhasil memberi efek jera.
Dialogue: 0,0:17:23.09,0:17:25.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyusup baru pun berkurang drastis.
Dialogue: 0,0:17:26.19,0:17:28.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, yang datang lagi untuk balas dendam\Nmalah bertambah.
Dialogue: 0,0:17:28.74,0:17:29.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, yah...
Dialogue: 0,0:17:30.03,0:17:32.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Mati kau!\N- Itu bukan masalah.
Dialogue: 0,0:17:38.75,0:17:40.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan pernah masuk ke hutan ini lagi.
Dialogue: 0,0:17:41.08,0:17:44.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengerti. Aku takkan ke hutan ini lagi.
Dialogue: 0,0:17:44.58,0:17:46.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah boleh keluar.
Dialogue: 0,0:17:51.01,0:17:51.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:17:52.34,0:17:53.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau takut?
Dialogue: 0,0:17:53.84,0:17:55.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak!
Dialogue: 0,0:17:55.14,0:17:56.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, wajahmu pucat.
Dialogue: 0,0:17:57.20,0:17:59.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau terluka, aku bisa menyembuhkanmu...
Dialogue: 0,0:18:00.18,0:18:02.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang, tidak!
Dialogue: 0,0:18:11.24,0:18:12.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah kalau begitu.
Dialogue: 0,0:18:15.70,0:18:16.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuantar kau pulang ke desa.
Dialogue: 0,0:18:19.58,0:18:20.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:18:21.96,0:18:25.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau tidak menggunakan\Nskill Raja Iblis padaku?
Dialogue: 0,0:18:26.13,0:18:27.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudmu skill Hukum Alam?
Dialogue: 0,0:18:28.63,0:18:31.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, padahal aku sudah membangkang.
Dialogue: 0,0:18:33.88,0:18:35.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak berbahaya,
Dialogue: 0,0:18:35.89,0:18:38.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi untuk apa kukendalikan?
Dialogue: 0,0:18:40.18,0:18:45.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidur nyenyak, berlari dengan semangat,\Ndan makan dengan lahap.
Dialogue: 0,0:18:46.15,0:18:49.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin Dike senang melihatmu\Nyang suka membangkang begini.
Dialogue: 0,0:18:50.44,0:18:51.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu...
Dialogue: 0,0:18:51.15,0:18:52.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:18:52.94,0:18:55.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau memang lebih cocok ceria begini.
Dialogue: 0,0:18:59.78,0:19:00.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti...
Dialogue: 0,0:19:00.99,0:19:01.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti...
Dialogue: 0,0:19:02.41,0:19:03.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak mau!
Dialogue: 0,0:19:04.58,0:19:07.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya aku tidak mau terima!
Dialogue: 0,0:19:11.17,0:19:13.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedang puber, ya?
Dialogue: 0,0:19:27.10,0:19:27.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan masuk.
Dialogue: 0,0:19:32.19,0:19:33.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah baikan?
Dialogue: 0,0:19:35.49,0:19:36.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eirene.
Dialogue: 0,0:19:37.32,0:19:38.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, lumayan.
Dialogue: 0,0:19:39.70,0:19:41.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dike sudah bercerita.
Dialogue: 0,0:19:41.70,0:19:44.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau menyelamatkan kami\Ndengan kekuatan orang itu.
Dialogue: 0,0:19:45.71,0:19:46.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang itu, dia bilang?
Dialogue: 0,0:19:47.79,0:19:52.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, tapi bukankah itu alasan\Nkalian mencariku ke hutan ini?
Dialogue: 0,0:19:53.71,0:19:54.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitulah.
Dialogue: 0,0:19:55.59,0:19:59.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, walau tujuan kami hanya skill-nya,
Dialogue: 0,0:19:59.14,0:20:02.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami tidak tahu sifat pemilik barunya.
Dialogue: 0,0:20:02.81,0:20:04.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, sama saja bertaruh, ya.
Dialogue: 0,0:20:04.97,0:20:07.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi paham beban pikiran Dike.
Dialogue: 0,0:20:10.86,0:20:12.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:20:12.73,0:20:15.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak memusuhiku seperti Eunomia, 'kan?
Dialogue: 0,0:20:16.82,0:20:18.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia memang begitu.
Dialogue: 0,0:20:20.74,0:20:23.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku berbeda dengannya.
Dialogue: 0,0:20:27.50,0:20:29.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku merasa berutang budi.
Dialogue: 0,0:20:43.39,0:20:44.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini?!
Dialogue: 0,0:20:45.01,0:20:48.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini ungkapan rasa terima kasihku.
Dialogue: 0,0:20:49.89,0:20:51.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga, astaga, astaga!
Dialogue: 0,0:20:51.59,0:20:52.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu.
Dialogue: 0,0:20:53.77,0:20:56.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Goblin itu nafsunya tinggi.
Dialogue: 0,0:21:00.32,0:21:02.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku diminta Kakak untuk meminta maaf.
Dialogue: 0,0:21:07.54,0:21:08.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, wah...
Dialogue: 0,0:21:09.62,0:21:13.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat, 'kan?\NGoblin memang makhluk bejat!
Dialogue: 0,0:21:14.00,0:21:17.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau telanjur begini,\Nakan sulit diajak bicara.
Dialogue: 0,0:21:18.09,0:21:19.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal salah paham.
Dialogue: 0,0:21:20.43,0:21:21.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bercanda.
Dialogue: 0,0:21:22.55,0:21:26.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai balasanku, aku rela tidur denganmu.
Dialogue: 0,0:21:28.39,0:21:30.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, diam dan tenang saja, ya.
Dialogue: 0,0:21:31.10,0:21:34.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Akira, Anda lihat Mia?
Dialogue: 0,0:21:34.44,0:21:36.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, Kakak?
Dialogue: 0,0:21:37.23,0:21:39.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan menggodaku.
Dialogue: 0,0:21:41.03,0:21:42.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia baru saja lari keluar.
Dialogue: 0,0:21:43.28,0:21:44.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ikut bantu cari.
Dialogue: 0,0:21:45.99,0:21:47.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak!
Dialogue: 0,0:22:04.89,0:22:08.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh, terima kasih.
