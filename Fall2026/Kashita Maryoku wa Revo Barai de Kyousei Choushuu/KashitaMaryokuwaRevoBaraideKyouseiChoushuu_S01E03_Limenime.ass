Dialogue: 0,0:00:54.20,0:00:56.08,sign,,0000,0000,0000,,MERISSA, 24 TAHUN, SNIPER, 260 DAYA SIHIR\NRANK PETUALANG: C, RANK PARTY SEBELUMNYA: C
Dialogue: 0,0:02:16.32,0:02:17.41,sign,,0000,0000,0000,,MISA, 20 TAHUN, PENYIHIR TINGKAT LANJUT\NDAYA SIHIR: 0/1.400
Dialogue: 0,0:03:59.26,0:04:02.64,sign,,0000,0000,0000,,EPISODE 3: PENGOPERASIAN
Dialogue: 0,0:06:57.40,0:06:58.10,sign,,0000,0000,0000,,LENT, 20 TAHUN,\NPENYIMPANAN SIHIR TANPA BATAS "SSS"
Dialogue: 0,0:07:06.36,0:07:07.08,sign,,0000,0000,0000,,RUANG BUATAN
Dialogue: 0,0:08:12.01,0:08:14.64,sign,,0000,0000,0000,,"SEGEL KUTUKAN PENGERINGAN DARAH"
Dialogue: 0,0:08:14.64,0:08:16.18,sign,,0000,0000,0000,,"SEGEL KUTUKAN PEMBELENGGU"
Dialogue: 0,0:09:33.22,0:09:35.58,sign,,0000,0000,0000,,"LENT, 20 TAHUN"
Dialogue: 0,0:09:35.58,0:09:36.43,sign,,0000,0000,0000,,PENYIMPANAN SIHIR TANPA BATAS "SSS". DAYA SIHIR:\N1.200/1.210, PENYIMPANAN: 4.010/TANPA BATAS RANK
Dialogue: 0,0:09:36.43,0:09:36.79,sign,,0000,0000,0000,,PETUALANG: E, PARTY: TIDAK ADA
Dialogue: 0,0:10:44.80,0:10:45.91,sign,,0000,0000,0000,,"PEMULIH DAYA SIHIR, HARGA: 10.000 GOLD"
Dialogue: 0,0:12:27.31,0:12:28.04,sign,,0000,0000,0000,,LENT, 20 TAHUN,\NPENYIMPANAN SIHIR TANPA BATAS "SSS"
Dialogue: 0,0:12:28.05,0:12:29.87,sign,,0000,0000,0000,,"DAYA SIHIR: 50/4.709, PENYIMPANAN: 1.140/TANPA BATAS"
Dialogue: 0,0:12:29.87,0:12:32.23,sign,,0000,0000,0000,,"RANK PETUALANG: E, PARTY: TIDAK ADA"
Dialogue: 0,0:13:16.90,0:13:17.94,sign,,0000,0000,0000,,SKILL: PEMINJAMAN DAYA SIHIR\NPENYESUAIAN STATUS
Dialogue: 0,0:13:20.21,0:13:20.85,sign,,0000,0000,0000,,PENAGIHAN PAKSA PADA PEDANG PEMECAH LANGIT\NPENGOPERASIAN DAYA SIHIR
Dialogue: 0,0:16:18.00,0:16:20.50,sign,,0000,0000,0000,,TIKUS LOMPAT BERTELINGA BESAR\NSANGAT MENYUKAI DAGING MANUSIA
Dialogue: 0,0:16:51.99,0:16:53.74,sign,,0000,0000,0000,,TEKNIK BELATI, LEVEL 1
Dialogue: 0,0:18:15.74,0:18:18.24,sign,,0000,0000,0000,,SIHIR API, LEVEL 1
Dialogue: 0,0:00:09.12,0:00:11.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, apa yang bisa kau lakukan?
Dialogue: 0,0:00:11.54,0:00:12.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gift-ku adalah Thief.
Dialogue: 0,0:00:12.93,0:00:14.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku percaya diri dengan kegesitanku.
Dialogue: 0,0:00:14.99,0:00:19.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf saja, tapi kami tak mau berurusan dengan\Npencuri yang merebut barang orang lain.
Dialogue: 0,0:00:20.29,0:00:21.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:00:21.20,0:00:23.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti moral Pedang Pemecah Langit bisa turun.
Dialogue: 0,0:00:24.45,0:00:25.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sialan!
Dialogue: 0,0:00:25.42,0:00:26.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pergi!
Dialogue: 0,0:00:26.80,0:00:28.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya.
Dialogue: 0,0:00:29.90,0:00:31.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gift-ku adalah Sihir Hitam.
Dialogue: 0,0:00:31.60,0:00:34.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan kalah dari anak-anak muda.
Dialogue: 0,0:00:37.46,0:00:41.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kami tidak mau\Nmerawat orang tua di sini.
Dialogue: 0,0:00:41.23,0:00:44.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau\Nrata-rata usia party kita naik drastis.
Dialogue: 0,0:00:44.19,0:00:45.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lancang sekali! Aku ini...
Dialogue: 0,0:00:45.90,0:00:46.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pulang sana.
Dialogue: 0,0:00:46.82,0:00:48.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sana pulang, pecundang.
Dialogue: 0,0:00:48.80,0:00:50.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wawancara hari ini kita sudahi saja.
Dialogue: 0,0:00:50.82,0:00:52.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Apa?\N- Apa maksudmu?!
Dialogue: 0,0:00:52.99,0:00:54.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurang ajar sekali kau.
Dialogue: 0,0:00:56.67,0:01:00.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga, padahal pelamarnya banyak,\Ntapi tidak ada yang bagus.
Dialogue: 0,0:01:00.11,0:01:04.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya orang-orang yang tak pantas\Nmasuk Pedang Pemecah Langit.
Dialogue: 0,0:01:04.40,0:01:05.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:01:05.82,0:01:09.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kayaknya petualang ini lumayan berguna.
Dialogue: 0,0:01:09.55,0:01:10.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia penembak jitu.
Dialogue: 0,0:01:12.51,0:01:15.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah kenapa, dia mirip orang itu.
Dialogue: 0,0:01:15.30,0:01:18.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan kau\Nmasih belum merelakan si Lent?
Dialogue: 0,0:01:18.64,0:01:19.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku?
Dialogue: 0,0:01:19.87,0:01:23.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang selemah dan selembek dia itu\Nsecara naluri saja tidak cocok untukku!
Dialogue: 0,0:01:23.55,0:01:26.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu,\Nsetelah bertualang, aku jadi tahu.
Dialogue: 0,0:01:26.91,0:01:28.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tipe yang aku suka itu,
Dialogue: 0,0:01:28.75,0:01:32.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}orang yang sangat percaya diri\Ndan bisa diandalkan.
Dialogue: 0,0:01:32.07,0:01:33.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misa.
Dialogue: 0,0:01:33.57,0:01:34.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guy.
Dialogue: 0,0:01:35.09,0:01:36.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu dulu!
Dialogue: 0,0:01:36.74,0:01:39.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan menggoda Guy milikku!
Dialogue: 0,0:01:39.37,0:01:41.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudmu milikmu?!
Dialogue: 0,0:01:41.14,0:01:42.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak suka?
Dialogue: 0,0:01:42.75,0:01:45.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah, sudah, hentikan.
Dialogue: 0,0:01:45.14,0:01:47.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi repot sendiri.
Dialogue: 0,0:01:48.38,0:01:51.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Misa, bekas lebam apa itu?
Dialogue: 0,0:01:52.90,0:01:53.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebam?
Dialogue: 0,0:01:54.14,0:01:56.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, benar.
Dialogue: 0,0:01:56.97,0:01:58.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elle, kau juga ada.
Dialogue: 0,0:01:59.89,0:02:01.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan aku juga ada?
Dialogue: 0,0:02:01.57,0:02:02.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada!
Dialogue: 0,0:02:02.69,0:02:03.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi apa?
Dialogue: 0,0:02:06.27,0:02:08.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini?!
Dialogue: 0,0:02:08.19,0:02:09.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Segel?
Dialogue: 0,0:02:09.47,0:02:11.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini semacam kutukan?
Dialogue: 0,0:02:11.78,0:02:14.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seingatku, aku tidak pernah\Nditempeli apa-apa.
Dialogue: 0,0:02:14.16,0:02:16.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh iya, coba lihat status kita!
Dialogue: 0,0:02:18.85,0:02:20.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin.
Dialogue: 0,0:02:20.29,0:02:21.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak apa-apa?
Dialogue: 0,0:02:21.66,0:02:22.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daya sihirku...
Dialogue: 0,0:02:23.42,0:02:25.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daya sihirku habis.
Dialogue: 0,0:02:41.32,0:02:43.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daya Sihir yang Dipinjam\NAkan Ditagih Paksa dengan Sistem Cicilan
Dialogue: 0,0:04:06.68,0:04:09.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daya sihir di Penyimpanan Sihir\Nbertambah lagi.
Dialogue: 0,0:04:14.80,0:04:19.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini para sampah itu\Npasti sedang panik setengah mati.
Dialogue: 0,0:04:20.89,0:04:22.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan, ini cumi bakarnya.
Dialogue: 0,0:04:22.49,0:04:24.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asyik! Makan cumi bakar!
Dialogue: 0,0:04:24.53,0:04:28.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau mereka tahu\Nbahwa penyebabnya adalah skill milikku?
Dialogue: 0,0:04:28.61,0:04:32.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa mereka bakal mencariku?
Dialogue: 0,0:04:33.71,0:04:35.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Master tidak mau makan?
Dialogue: 0,0:04:36.21,0:04:38.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sedang gelisah gara-gara\Nmemikirkan soal tadi.
Dialogue: 0,0:04:39.86,0:04:41.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya ampun.
Dialogue: 0,0:04:42.82,0:04:44.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Master ini benar-benar
Dialogue: 0,0:04:46.48,0:04:49.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}takut dengan mereka, ya?
Dialogue: 0,0:04:49.06,0:04:52.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya, bagaimana kalau mereka menyerangku?
Dialogue: 0,0:04:53.89,0:04:55.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sampai itu terjadi,
Dialogue: 0,0:04:55.38,0:04:58.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita lawan balik saja.
Dialogue: 0,0:04:58.99,0:05:00.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku melawan balik?
Dialogue: 0,0:05:00.13,0:05:02.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku yang sekarang mana bisa.
Dialogue: 0,0:05:03.02,0:05:06.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu kan baru "yang sekarang".
Dialogue: 0,0:05:07.47,0:05:12.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Master itu sebenarnya\Npunya berbagai macam skill.
Dialogue: 0,0:05:18.45,0:05:19.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu...
Dialogue: 0,0:05:20.51,0:05:24.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gunakanlah Pengoperasian Daya Sihir\Nyang baru Tuan Master pelajari.
Dialogue: 0,0:05:27.86,0:05:30.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, berkembanglah perlahan-lahan.
Dialogue: 0,0:05:31.06,0:05:32.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, Empee,
Dialogue: 0,0:05:33.14,0:05:35.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}syarat untuk meningkatkan Gift itu
Dialogue: 0,0:05:35.23,0:05:38.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah dengan terus mengoperasikannya?
Dialogue: 0,0:05:39.62,0:05:43.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kembalikan yang selama ini aku pinjamkan!\N- Teriakan Tuan Master yang menggebu-gebu waktu itu
Dialogue: 0,0:05:43.12,0:05:47.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah tangisan pertama seorang petualang\Nyang baru terlahir ke dunia ini.
Dialogue: 0,0:05:57.71,0:06:01.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kehidupan yang hanya bergantung\Npada orang lain sudah berakhir.
Dialogue: 0,0:06:02.30,0:06:06.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai sekarang, Tuan akan menjalani\Npetualangan dengan cara Tuan sendiri.
Dialogue: 0,0:06:07.47,0:06:10.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Master punya kekuatan\Nuntuk melakukannya.
Dialogue: 0,0:06:10.43,0:06:12.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, percaya dirilah.
Dialogue: 0,0:06:13.82,0:06:15.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ada masalah,
Dialogue: 0,0:06:15.30,0:06:18.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan mendukungmu dengan sepenuh tenaga.
Dialogue: 0,0:06:18.74,0:06:19.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Empee.
Dialogue: 0,0:06:20.74,0:06:21.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:06:21.90,0:06:23.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, sebaiknya cepat dimakan
Dialogue: 0,0:06:23.66,0:06:26.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau cumi bakarnya keburu dingin.
Dialogue: 0,0:06:26.46,0:06:27.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:06:33.41,0:06:35.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cumi bakarnya enak!
Dialogue: 0,0:06:35.06,0:06:36.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, 'kan?
Dialogue: 0,0:06:36.29,0:06:37.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, pesan satu porsi lagi!
Dialogue: 0,0:06:38.08,0:06:40.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan cuma satu porsi,\Nkita makan yang banyak!
Dialogue: 0,0:06:40.34,0:06:43.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Master mantap!\NMemang dermawan!
Dialogue: 0,0:06:43.44,0:06:46.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi, tolong tambah cumi bakarnya\Ntiga porsi lagi.
Dialogue: 0,0:06:46.51,0:06:48.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap, dengan senang hati.
Dialogue: 0,0:06:50.62,0:06:53.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, soal rencana kita selanjutnya.
Dialogue: 0,0:06:54.27,0:06:57.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti yang terlihat di status ini.
Dialogue: 0,0:06:58.11,0:06:59.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan lebih baik jika menaikkan level
Dialogue: 0,0:06:59.68,0:07:03.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan mengalahkan monster\Ndan mengoperasikan daya sihir.
Dialogue: 0,0:07:03.82,0:07:06.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, kalau begitu, aku tahu tempat yang bagus.
Dialogue: 0,0:07:07.09,0:07:09.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di pinggiran Kota Melba,
Dialogue: 0,0:07:09.14,0:07:12.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ada dungeon yang dibuat oleh penyihir kuno.
Dialogue: 0,0:07:22.59,0:07:26.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dulu, setelah membentuk\NPedang Pemecah Langit,
Dialogue: 0,0:07:26.02,0:07:28.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami mengurung diri di sana untuk berlatih.
Dialogue: 0,0:07:28.40,0:07:30.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di mana lokasi kota itu?
Dialogue: 0,0:07:30.26,0:07:32.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari sini lumayan jauh.
Dialogue: 0,0:07:32.43,0:07:35.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pakai kereta kuda cepat saja\Nbutuh dua mingguan.
Dialogue: 0,0:07:36.72,0:07:39.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kebetulan sekali.
Dialogue: 0,0:07:39.22,0:07:42.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalaupun mereka mengejar,\Nkita bisa mengulur waktu.
Dialogue: 0,0:07:43.73,0:07:46.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, ayo kita segera berangkat\Nke kota itu.
Dialogue: 0,0:07:47.20,0:07:47.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:07:49.39,0:07:50.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiga minggu.
Dialogue: 0,0:07:51.87,0:07:54.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ada waktu tiga minggu,\Nkita pasti bisa dapat kekuatan
Dialogue: 0,0:07:54.75,0:07:57.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk mengalahkan sampah-sampah itu.
Dialogue: 0,0:07:58.45,0:07:59.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan?
Dialogue: 0,0:08:03.49,0:08:05.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana? Masih ada?
Dialogue: 0,0:08:05.01,0:08:06.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih ada.
Dialogue: 0,0:08:06.46,0:08:09.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sialan, bagaimana cara menghilangkannya?
Dialogue: 0,0:08:09.13,0:08:12.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Digosok seperti itu\Ntidak mungkin bisa hilang, lah!
Dialogue: 0,0:08:12.01,0:08:14.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya besok kita periksakan ke ahli sihir.
Dialogue: 0,0:08:14.64,0:08:16.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin dia tahu sesuatu.
Dialogue: 0,0:08:16.18,0:08:18.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa boleh buat, deh!
Dialogue: 0,0:08:21.86,0:08:22.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama,
Dialogue: 0,0:08:22.91,0:08:24.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku coba habiskan 1.000 daya sihir
Dialogue: 0,0:08:25.01,0:08:28.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk menaikkan kapasitas daya sihir\Nsebesar 10 poin.
Dialogue: 0,0:08:31.04,0:08:33.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skill: Pengoperasian Daya Sihir.
Dialogue: 0,0:08:41.16,0:08:42.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempat ini...
Dialogue: 0,0:08:43.60,0:08:44.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di mana?
Dialogue: 0,0:08:53.65,0:08:55.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang keluar!
Dialogue: 0,0:08:58.32,0:09:00.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak dingin?
Dialogue: 0,0:09:01.50,0:09:02.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malahan
Dialogue: 0,0:09:03.28,0:09:04.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}terasa hangat.
Dialogue: 0,0:09:21.58,0:09:24.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat! Betulan naik!
Dialogue: 0,0:09:26.90,0:09:28.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syarat terpenuhi.
Dialogue: 0,0:09:29.70,0:09:30.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang apa?
Dialogue: 0,0:09:31.17,0:09:33.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkat Pengoperasian Daya Sihir,
Dialogue: 0,0:09:33.22,0:09:35.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pemulihan daya sihir meningkat dua kali lipat.
Dialogue: 0,0:09:36.80,0:09:39.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, sekarang pulihnya 20%, ya.
Dialogue: 0,0:09:39.07,0:09:41.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biasanya cuma 10%.
Dialogue: 0,0:09:42.02,0:09:44.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemampuan ini sangat bagus, lo.
Dialogue: 0,0:09:44.74,0:09:47.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perjalanan kita mungkin akan panjang,
Dialogue: 0,0:09:47.34,0:09:50.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi, sebaiknya manfaatkan waktunya\Nuntuk terus berlatih.
Dialogue: 0,0:09:51.57,0:09:54.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kereta kuda tujuan Melba\Nakan segera berangkat!
Dialogue: 0,0:09:55.17,0:09:57.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagi penumpang yang hendak ikut,\Nsilakan segera naik!
Dialogue: 0,0:10:00.33,0:10:02.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fireball!
Dialogue: 0,0:10:04.35,0:10:06.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sampai tergores.
Dialogue: 0,0:10:06.59,0:10:10.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal biasanya lawan keroco begini\Nbisa kukalahkan tanpa luka.
Dialogue: 0,0:10:11.41,0:10:13.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gara-gara kutukan ini.
Dialogue: 0,0:10:18.91,0:10:20.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini juga bukan.
Dialogue: 0,0:10:20.06,0:10:21.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang ini juga.
Dialogue: 0,0:10:21.44,0:10:22.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagian yang ini...
Dialogue: 0,0:10:22.50,0:10:24.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih belum tahu juga?!
Dialogue: 0,0:10:25.58,0:10:28.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah 80 tahun aku menekuni pekerjaan ini.
Dialogue: 0,0:10:28.57,0:10:32.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak kusangka aku bisa menemukan\Nsegel kutukan yang belum pernah kulihat.
Dialogue: 0,0:10:32.77,0:10:34.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa malah terkesan?!
Dialogue: 0,0:10:34.67,0:10:36.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami ini membayar, tahu!
Dialogue: 0,0:10:36.80,0:10:38.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maafkan aku.
Dialogue: 0,0:10:39.38,0:10:41.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untungnya, sih,
Dialogue: 0,0:10:41.33,0:10:43.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kutukan ini tidak terus-terusan\Nmenyedot daya sihir.
Dialogue: 0,0:10:44.80,0:10:45.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau minum ini,
Dialogue: 0,0:10:45.91,0:10:48.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita masih bisa memulihkan daya sihir.
Dialogue: 0,0:10:48.45,0:10:50.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berapa banyak yang kau punya?
Dialogue: 0,0:10:50.93,0:10:53.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk sekarang, aku punya 50 botol.
Dialogue: 0,0:10:54.06,0:10:55.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}500.000 gold, ya.
Dialogue: 0,0:10:55.93,0:10:59.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya kita masih punya tabungan\Ndari hasil kerja selama ini.
Dialogue: 0,0:10:59.78,0:11:01.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Elle, sembuhkan aku.
Dialogue: 0,0:11:01.68,0:11:02.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mau.
Dialogue: 0,0:11:04.29,0:11:07.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa, soalnya daya sihirku habis.
Dialogue: 0,0:11:07.10,0:11:08.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bilang tidak bisa!
Dialogue: 0,0:11:08.90,0:11:11.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat minum dan isi ulang daya sihirmu!
Dialogue: 0,0:11:11.07,0:11:13.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya pahit, aku tidak mau minum.
Dialogue: 0,0:11:13.53,0:11:15.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bicara seperti anak kecil!
Dialogue: 0,0:11:15.99,0:11:19.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau ini tidak berguna\Nkalau tak punya daya sihir!
Dialogue: 0,0:11:23.12,0:11:24.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, tunggu.
Dialogue: 0,0:11:26.88,0:11:29.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, tunggu dulu, Guy!
Dialogue: 0,0:11:29.67,0:11:30.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berisik!
Dialogue: 0,0:11:31.31,0:11:34.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elle yang salah karena tak mau minum!
Dialogue: 0,0:11:34.37,0:11:38.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang salah adalah kutukan ini.
Dialogue: 0,0:11:40.14,0:11:41.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang benar saja!
Dialogue: 0,0:11:41.86,0:11:44.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kembalikan daya sihirku!
Dialogue: 0,0:11:51.14,0:11:52.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan...
Dialogue: 0,0:11:52.16,0:11:54.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang memasang kutukan ini
Dialogue: 0,0:11:58.08,0:11:59.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah Lent?
Dialogue: 0,0:12:00.08,0:12:02.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Empee, dari tadi kau lihat keluar terus.
Dialogue: 0,0:12:02.67,0:12:05.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak pernah bosan memandanginya.
Dialogue: 0,0:12:06.10,0:12:08.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu gunung berapi apa?
Dialogue: 0,0:12:08.34,0:12:09.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu gunung berapi Guremo.
Dialogue: 0,0:12:09.79,0:12:12.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya, ada naga yang bersarang\Ndi puncaknya.
Dialogue: 0,0:12:13.86,0:12:15.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak disangka.
Dialogue: 0,0:12:15.46,0:12:19.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pikir dia tahu banyak hal\Ntentang dunia ini.
Dialogue: 0,0:12:20.43,0:12:22.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini, tepat enam hari\Nsejak kami memulai perjalanan.
Dialogue: 0,0:12:23.23,0:12:27.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku terus menghabiskan daya sihirku\Nuntuk meningkatkan kapasitasnya.
Dialogue: 0,0:12:28.05,0:12:29.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkat itu, daya sihirku
Dialogue: 0,0:12:29.87,0:12:32.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sekarang 4.709 poin.
Dialogue: 0,0:12:32.40,0:12:35.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jumlah daya sihir yang sebanding\Ndengan Penyihir Agung.
Dialogue: 0,0:12:35.81,0:12:36.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh iya,
Dialogue: 0,0:12:36.94,0:12:40.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}selama perjalanan,\Naku mempelajari Manajemen Daya Sihir.
Dialogue: 0,0:12:40.64,0:12:42.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skill untuk mengambil\Ndan memasukkan daya sihir
Dialogue: 0,0:12:42.78,0:12:44.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dari Penyimpanan Sihir dengan bebas.
Dialogue: 0,0:12:44.91,0:12:47.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, untuk sekarang\Naku belum tahu cara memakainya.
Dialogue: 0,0:12:49.23,0:12:50.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kata Empee,
Dialogue: 0,0:12:50.50,0:12:53.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}suatu hari nanti,\Naku akan tahu kehebatan dari kemampuan ini.
Dialogue: 0,0:12:54.10,0:12:56.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski hanya duduk terguncang-guncang\Ndi kereta kuda,
Dialogue: 0,0:12:56.43,0:12:59.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku sudah tidak sabar\Nmelihat perkembanganku sendiri.
Dialogue: 0,0:13:00.40,0:13:04.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Total 350.000 daya sihir telah digunakan\Ndalam Pengoperasian Daya Sihir.
Dialogue: 0,0:13:05.28,0:13:06.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syarat terpenuhi.
Dialogue: 0,0:13:06.83,0:13:09.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Level Pengoperasian Daya Sihir naik 1.
Dialogue: 0,0:13:09.81,0:13:12.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fitur "Pembelian Skill" kini dapat digunakan.
Dialogue: 0,0:13:13.09,0:13:14.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pembelian?
Dialogue: 0,0:13:14.24,0:13:16.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Master berhasil!
Dialogue: 0,0:13:17.95,0:13:20.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gulungannya penuh dengan status?
Dialogue: 0,0:13:20.85,0:13:23.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang, Tuan tinggal swipe saja.
Dialogue: 0,0:13:23.99,0:13:25.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Swipe... apa?
Dialogue: 0,0:13:26.21,0:13:28.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, swipe.
Dialogue: 0,0:13:28.70,0:13:31.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menggulir kertasnya dari bawah ke atas.
Dialogue: 0,0:13:35.97,0:13:36.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buset!
Dialogue: 0,0:13:37.25,0:13:38.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak banget!
Dialogue: 0,0:13:38.85,0:13:41.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pilihannya ada banyak, lo.
Dialogue: 0,0:13:41.98,0:13:43.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Tapi...
Dialogue: 0,0:13:44.06,0:13:47.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skill itu harusnya hanya bisa diberikan\Noleh sang Pencipta
Dialogue: 0,0:13:47.60,0:13:50.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan tidak bisa kita dapatkan sendiri.
Dialogue: 0,0:13:51.39,0:13:52.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi di sini...
Dialogue: 0,0:13:53.55,0:13:54.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata...
Dialogue: 0,0:13:55.19,0:13:56.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima ini!
Dialogue: 0,0:13:58.64,0:13:59.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa dibeli!
Dialogue: 0,0:14:06.93,0:14:08.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang sudah paham?
Dialogue: 0,0:14:08.86,0:14:13.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa Penyimpanan Sihir Tanpa Batas\Nmenyandang rank SSS?
Dialogue: 0,0:14:16.22,0:14:17.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, Tuan Master,
Dialogue: 0,0:14:17.94,0:14:20.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}petualangan apa yang Tuan inginkan?
Dialogue: 0,0:14:21.15,0:14:24.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan memberikan\Nsaran pengoperasian yang cermat.
Dialogue: 0,0:14:24.88,0:14:26.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena setiap skill
Dialogue: 0,0:14:26.80,0:14:30.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}membutuhkan daya sihir yang lumayan besar.
Dialogue: 0,0:14:38.16,0:14:40.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ramai sekali, ya.
Dialogue: 0,0:14:40.44,0:14:42.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya petualang dari seluruh dunia
Dialogue: 0,0:14:42.42,0:14:45.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berkumpul di sini demi Dungeon Agung Melba.
Dialogue: 0,0:14:47.18,0:14:49.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, Tuan Lent yang belum memiliki party,
Dialogue: 0,0:14:50.12,0:14:53.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apakah tidak masalah memindahkan\Ndomisili ke Melba?
Dialogue: 0,0:14:53.95,0:14:54.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:14:59.60,0:15:01.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Prosesnya telah selesai.
Dialogue: 0,0:15:01.82,0:15:04.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan ini, Tuan memiliki izin\Nuntuk memasuki Dungeon Agung.
Dialogue: 0,0:15:05.10,0:15:06.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:15:09.73,0:15:12.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan begini, mereka jadi bisa melacakku.
Dialogue: 0,0:15:13.10,0:15:15.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalaupun ada yang mengejar,
Dialogue: 0,0:15:15.23,0:15:17.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}nantinya Tuan tidak perlu takut lagi.
Dialogue: 0,0:15:23.94,0:15:26.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh! Itu dia dungeon-nya.
Dialogue: 0,0:15:28.67,0:15:30.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, Tuan Master.
Dialogue: 0,0:15:47.57,0:15:49.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo? Kok tiba-tiba di luar?
Dialogue: 0,0:15:50.01,0:15:51.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inilah Dungeon Agung Melba.
Dialogue: 0,0:15:52.22,0:15:55.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pikir dungeon itu lebih gelap dan lembap.
Dialogue: 0,0:15:55.98,0:16:00.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini adalah lantai pertama\Nyang biasa disebut Dataran Luas.
Dialogue: 0,0:16:00.27,0:16:03.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya, ini ruang dimensi\Nyang diciptakan oleh penyihir kuno.
Dialogue: 0,0:16:03.54,0:16:06.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di setiap lantai terhampar\Nberbagai macam dunia.
Dialogue: 0,0:16:06.83,0:16:10.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja, ada juga tempat-tempat\Nyang bisa Empee bayangkan.
Dialogue: 0,0:16:10.32,0:16:11.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:16:11.86,0:16:14.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski aku sendiri juga tidak tahu\Nkenapa bisa begitu.
Dialogue: 0,0:16:22.96,0:16:25.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Master, ada monster!
Dialogue: 0,0:16:25.81,0:16:27.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pas sekali.
Dialogue: 0,0:16:27.47,0:16:30.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktunya mencoba skill yang baru aku beli!
Dialogue: 0,0:16:32.56,0:16:34.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pilih yang mana, ya?
Dialogue: 0,0:16:34.56,0:16:37.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya, mulai dari skill\Nserangan jarak dekat dulu.
Dialogue: 0,0:16:37.76,0:16:38.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:16:41.36,0:16:43.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku punya belati untuk melindungi diri, sih.
Dialogue: 0,0:16:44.45,0:16:46.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku hampir tak pernah menggunakannya.
Dialogue: 0,0:16:47.24,0:16:48.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa!
Dialogue: 0,0:16:48.93,0:16:50.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita pakai skill itu saja!
Dialogue: 0,0:16:59.71,0:17:01.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eng...
Dialogue: 0,0:17:02.38,0:17:04.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ruangan ini lagi?
Dialogue: 0,0:17:07.22,0:17:08.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keluar lagi!
Dialogue: 0,0:17:11.38,0:17:14.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ada yang berubah?
Dialogue: 0,0:18:05.97,0:18:08.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya, serangan jarak jauh.
Dialogue: 0,0:18:10.54,0:18:13.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga ingin sihir yang bisa\Nditembakkan berkali-kali.
Dialogue: 0,0:18:13.44,0:18:15.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,\Nbagaimana dengan sihir yang ini?
Dialogue: 0,0:18:20.88,0:18:22.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini lagi?
Dialogue: 0,0:18:52.82,0:18:54.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fireball!
Dialogue: 0,0:19:02.48,0:19:04.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mantap, Tuan Master!
Dialogue: 0,0:19:04.46,0:19:06.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Langsung mahir memakainya!
Dialogue: 0,0:19:06.56,0:19:07.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:19:07.54,0:19:10.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tubuhku terasa ringan,\Ndan daya sihirku mudah digunakan.
Dialogue: 0,0:19:10.64,0:19:13.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini berkat skill penguatan\Nyang Empee sarankan.
Dialogue: 0,0:19:13.60,0:19:14.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih!
Dialogue: 0,0:19:20.64,0:19:23.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Monster yang kukalahkan\Nmeninggalkan batu cantik.
Dialogue: 0,0:19:23.92,0:19:25.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu batu sihir.
Dialogue: 0,0:19:25.58,0:19:27.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Monster yang dikalahkan di dalam dungeon
Dialogue: 0,0:19:27.56,0:19:30.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan berubah jadi batu sihir\Nsesuai tingkat kekuatannya.
Dialogue: 0,0:19:33.06,0:19:35.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dibawa ke guild, nanti bisa dijual.
Dialogue: 0,0:19:35.65,0:19:37.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya!
Dialogue: 0,0:19:37.41,0:19:39.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi makin bersemangat!
Dialogue: 0,0:19:46.26,0:19:48.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Obat penyembuhku sudah habis!
Dialogue: 0,0:19:49.14,0:19:50.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita mundur dulu!
Dialogue: 0,0:19:51.63,0:19:53.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya mereka petualang pemula, ya.
Dialogue: 0,0:19:53.88,0:19:56.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dulu aku juga seperti itu.
Dialogue: 0,0:19:56.34,0:19:57.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan lebih buruk.
Dialogue: 0,0:19:57.95,0:20:00.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya meminjamkan\Ndaya sihir dari belakang.
Dialogue: 0,0:20:02.08,0:20:04.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka mengincar kita!
Dialogue: 0,0:20:06.93,0:20:08.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, sekarang berbeda!
Dialogue: 0,0:20:08.77,0:20:10.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jantungku berdebar-debar!
Dialogue: 0,0:20:10.96,0:20:13.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belum pernah merasakan hal seperti ini!
Dialogue: 0,0:20:16.46,0:20:17.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Heal!
Dialogue: 0,0:20:19.60,0:20:20.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau terus begini,
Dialogue: 0,0:20:20.82,0:20:23.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin kita akan bisa ke lantai berikutnya.
Dialogue: 0,0:20:23.25,0:20:23.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:20:24.58,0:20:25.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:20:27.38,0:20:30.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku masih ingin mencoba kekuatan ini\Nsedikit lebih lama di sini.
Dialogue: 0,0:20:33.74,0:20:37.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini, Tuan Master terlihat senang, ya.
Dialogue: 0,0:20:37.58,0:20:38.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:20:46.18,0:20:47.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Heal.
Dialogue: 0,0:20:50.13,0:20:51.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, ya.
Dialogue: 0,0:20:51.22,0:20:52.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Santai saja.
Dialogue: 0,0:20:52.58,0:20:54.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maaf...
Dialogue: 0,0:20:54.46,0:20:56.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa tolong berikan
Dialogue: 0,0:20:57.23,0:20:59.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}penyembuhan padaku juga?
Dialogue: 0,0:20:59.86,0:21:02.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Itu kan cuma luka gores biasa.
Dialogue: 0,0:21:02.74,0:21:05.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daya sihir itu berharga.
Dialogue: 0,0:21:05.20,0:21:07.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami tak punya daya sihir lebih\Nuntuk dihabiskan padamu.
Dialogue: 0,0:21:07.87,0:21:10.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal kau tak banyak berkontribusi.
Dialogue: 0,0:21:10.67,0:21:12.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak saja kau, Rinka.
Dialogue: 0,0:21:13.36,0:21:14.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku.
