Dialogue: 0,0:00:08.99,0:00:11.74,dialog,,0,0,0,,Gift yang aku dapatkan, Penyimpanan Sihir,
Dialogue: 0,0:00:12.06,0:00:16.46,dialog,,0,0,0,,merupakan Gift Unik rank S\Nyang membuat siapa pun terpukau.
Dialogue: 0,0:00:16.83,0:00:20.32,dialog,,0,0,0,,Aku hanya bisa berdiri di belakang\Ndan meminjamkan daya sihir.
Dialogue: 0,0:00:21.30,0:00:24.82,dialog,,0,0,0,,Aku juga tidak menginginkan Gift ini.
Dialogue: 0,0:00:24.82,0:00:27.06,dialog,,0,0,0,,Tapi, mereka...
Dialogue: 0,0:00:27.76,0:00:30.47,dialog,,0,0,0,,Tidak berguna?\NMakanya aku dikeluarkan?
Dialogue: 0,0:00:31.30,0:00:32.08,dialog,,0,0,0,,Kalau begitu...
Dialogue: 0,0:00:32.30,0:00:33.58,dialog,,0,0,0,,Kalau begitu, setidaknya...
Dialogue: 0,0:00:33.58,0:00:35.66,dialog,,0,0,0,,Kembalikan semua daya sihir
Dialogue: 0,0:00:36.08,0:00:40.23,dialog,,0,0,0,,yang selama ini aku pinjamkan!
Dialogue: 0,0:00:40.85,0:00:43.26,dialog,,0,0,0,,Gift telah memenuhi syarat untuk berevolusi.
Dialogue: 0,0:00:44.10,0:00:47.58,dialog,,0,0,0,,Penyimpanan Sihir telah berevolusi menjadi\NPenyimpanan Sihir Tanpa Batas.
Dialogue: 0,0:00:47.58,0:00:49.24,dialog,,0,0,0,,Suara apa ini?
Dialogue: 0,0:00:56.06,0:00:59.25,dialog,,0,0,0,,Selamat atas evolusi Gift Anda, Tuan Master.
Dialogue: 0,0:01:00.38,0:01:01.07,dialog,,0,0,0,,Siapa?
Dialogue: 0,0:02:35.63,0:02:39.44,dialog,,0,0,0,,Selamat atas evolusi Gift Anda,
Dialogue: 0,0:02:39.44,0:02:41.14,dialog,,0,0,0,,Tuan Master.
Dialogue: 0,0:02:45.31,0:02:46.54,dialog,,0,0,0,,Apa ini?
Dialogue: 0,0:02:47.90,0:02:50.77,dialog,,0,0,0,,Aku sudah menunggu sangat lama
Dialogue: 0,0:02:50.77,0:02:53.15,dialog,,0,0,0,,untuk bisa bertemu dengan Tuan Master.
Dialogue: 0,0:02:54.21,0:02:55.53,dialog,,0,0,0,,Tapi,
Dialogue: 0,0:02:56.57,0:03:01.04,dialog,,0,0,0,,kita malah baru bertemu\Nlima tahun setelah Upacara Kedewasaan!
Dialogue: 0,0:03:01.65,0:03:04.03,dialog,,0,0,0,,Jangan-jangan kau...
Dialogue: 0,0:03:04.41,0:03:05.84,dialog,,0,0,0,,Peri Gift?
Dialogue: 0,0:03:06.40,0:03:08.42,dialog,,0,0,0,,Benar sekali.
Dialogue: 0,0:03:08.58,0:03:13.21,dialog,,0,0,0,,Oh iya, waktu Upacara Kedewasaan,\NTuan Orphes pernah bilang,
Dialogue: 0,0:03:13.21,0:03:17.09,dialog,,0,0,0,,bahwa ada peri yang akan\Nmendampingi pemilik Gift Unik.
Dialogue: 0,0:03:17.92,0:03:19.47,dialog,,0,0,0,,Ternyata betulan ada!
Dialogue: 0,0:03:19.95,0:03:22.22,dialog,,0,0,0,,Halo, halo, salam kenal.
Dialogue: 0,0:03:22.22,0:03:26.14,dialog,,0,0,0,,Aku adalah Empee, Magical Planner.
Dialogue: 0,0:03:27.31,0:03:29.52,dialog,,0,0,0,,Senang bertemu denganmu.
Dialogue: 0,0:03:29.90,0:03:31.44,dialog,,0,0,0,,Imut banget.
Dialogue: 0,0:03:31.61,0:03:34.32,dialog,,0,0,0,,Tapi, dia...
Dialogue: 0,0:03:34.78,0:03:37.07,dialog,,0,0,0,,Tunggu, Tuan Master!
Dialogue: 0,0:03:37.32,0:03:41.08,dialog,,0,0,0,,Kenapa perlengkapanmu jelek banget?
Dialogue: 0,0:03:42.64,0:03:44.10,dialog,,0,0,0,,Keluar dari mana itu?!
Dialogue: 0,0:03:47.07,0:03:49.44,dialog,,0,0,0,,Pelindung dada besi.
Dialogue: 0,0:03:49.82,0:03:52.40,dialog,,0,0,0,,Mantel kain butut.
Dialogue: 0,0:03:53.10,0:03:55.55,dialog,,0,0,0,,Terus, celana kain.
Dialogue: 0,0:03:56.58,0:03:59.55,dialog,,0,0,0,,Yang dipakai itu sandal?
Dialogue: 0,0:03:59.90,0:04:01.47,dialog,,0,0,0,,Iya, 'kan?
Dialogue: 0,0:04:05.63,0:04:07.69,dialog,,0,0,0,,Kalau ditotal jadi 116 gold.
Dialogue: 0,0:04:08.27,0:04:11.54,dialog,,0,0,0,,Yang begini nanti bisa diremehkan, lo.
Dialogue: 0,0:04:11.54,0:04:15.04,dialog,,0,0,0,,Kalau mau meminjamkan daya sihir,\Npenampilanmu harus menarik.
Dialogue: 0,0:04:15.52,0:04:17.55,dialog,,0,0,0,,Aneh banget, dah.
Dialogue: 0,0:04:17.82,0:04:20.45,dialog,,0,0,0,,Oh iya, tadi kau bilang evolusi?
Dialogue: 0,0:04:20.45,0:04:21.87,dialog,,0,0,0,,Oh, soal itu...
Dialogue: 0,0:04:21.87,0:04:24.20,dialog,,0,0,0,,Coba buka gulungan perkamenmu.
Dialogue: 0,0:04:24.77,0:04:26.20,dialog,,0,0,0,,Saat Gift berevolusi,
Dialogue: 0,0:04:26.20,0:04:29.00,dialog,,0,0,0,,isi gulungannya juga ikut diperbarui.
Dialogue: 0,0:04:29.38,0:04:30.58,dialog,,0,0,0,,Ternyata benar!
Dialogue: 0,0:04:30.58,0:04:33.96,dialog,,0,0,0,,Nama Gift-nya dari Penyimpanan Sihir\Njadi Penyimpanan Sihir Tanpa Batas.
Dialogue: 0,0:04:34.37,0:04:38.54,dialog,,0,0,0,,Kalau dipikir-pikir, Gift milik Guy\Ndan yang lain juga berevolusi saat bertarung.
Dialogue: 0,0:04:39.04,0:04:40.91,dialog,,0,0,0,,"SSS"?
Dialogue: 0,0:04:40.91,0:04:43.51,dialog,,0,0,0,,Maksudnya, ini rank di atas S?
Dialogue: 0,0:04:45.22,0:04:48.23,dialog,,0,0,0,,Daripada itu, coba lihat bagian ini.
Dialogue: 0,0:04:48.39,0:04:50.27,dialog,,0,0,0,,Simbol apa ini?
Dialogue: 0,0:04:56.69,0:04:59.09,dialog,,0,0,0,,Artinya tanpa batas.
Dialogue: 0,0:05:00.51,0:05:03.04,dialog,,0,0,0,,Sekarang kau tak perlu lagi\Nmemusingkan kapasitas,
Dialogue: 0,0:05:03.04,0:05:05.03,dialog,,0,0,0,,karena bisa menyimpannya tanpa batas.
Dialogue: 0,0:05:06.29,0:05:08.05,dialog,,0,0,0,,Ini imut juga.
Dialogue: 0,0:05:08.69,0:05:10.66,dialog,,0,0,0,,Ta-Tanpa batas?!
Dialogue: 0,0:05:12.08,0:05:15.79,dialog,,0,0,0,,Ada dua syarat untuk berevolusi menjadi\NPenyimpanan Sihir Tanpa Batas.
Dialogue: 0,0:05:15.96,0:05:19.67,dialog,,0,0,0,,Pertama, pernah meminjamkan daya sihir\Nmelebihi jumlah tertentu.
Dialogue: 0,0:05:19.84,0:05:21.67,dialog,,0,0,0,,Yang kedua...
Dialogue: 0,0:05:22.43,0:05:24.29,dialog,,0,0,0,,Dengan emosi yang meluap-luap,
Dialogue: 0,0:05:24.29,0:05:26.93,dialog,,0,0,0,,menuntut agar semua\Nyang dipinjamkan dikembalikan!
Dialogue: 0,0:05:27.34,0:05:31.39,dialog - atas,,0,0,0,,Kembalikan yang selama ini aku pinjamkan!
Dialogue: 0,0:05:28.46,0:05:31.39,dialog,,0,0,0,,Oh, jadi teriakanku yang waktu itu?
Dialogue: 0,0:05:31.39,0:05:32.54,dialog,,0,0,0,,Tapi,
Dialogue: 0,0:05:32.54,0:05:36.88,dialog,,0,0,0,,kalau syaratnya semudah ini,\Nkenapa butuh lima tahun, Tuan Master?
Dialogue: 0,0:05:37.23,0:05:39.46,dialog,,0,0,0,,Mu-Mudah apanya?!
Dialogue: 0,0:05:39.87,0:05:41.26,dialog,,0,0,0,,Apa iya?
Dialogue: 0,0:05:42.32,0:05:44.14,dialog,,0,0,0,,Mereka menakutkan.
Dialogue: 0,0:05:44.85,0:05:47.10,dialog,,0,0,0,,Makanya, aku selalu menahan diri
Dialogue: 0,0:05:47.10,0:05:49.33,dialog,,0,0,0,,dan melakukan apa yang menguntungkan mereka.
Dialogue: 0,0:05:50.08,0:05:54.21,dialog,,0,0,0,,Kalau jatah hari ini dibayar, nanti jadi\Ntak bisa bertualang beberapa hari, tahu.
Dialogue: 0,0:05:54.38,0:05:56.03,dialog,,0,0,0,,- Benar.\N- Benar banget.
Dialogue: 0,0:05:56.40,0:05:58.30,dialog,,0,0,0,,Kalau aku menagihnya,
Dialogue: 0,0:05:58.30,0:06:01.42,dialog,,0,0,0,,perkembangan party bakal terhambat.
Dialogue: 0,0:06:01.63,0:06:04.62,dialog,,0,0,0,,Tuan Master ini baik sekali, ya.
Dialogue: 0,0:06:05.62,0:06:06.97,dialog,,0,0,0,,Empee.
Dialogue: 0,0:06:07.30,0:06:09.52,dialog,,0,0,0,,Aku sama sekali tidak memujimu, tahu.
Dialogue: 0,0:06:09.52,0:06:10.94,dialog,,0,0,0,,Sama sekali tidak.
Dialogue: 0,0:06:10.94,0:06:12.68,dialog,,0,0,0,,Ah, begitu.
Dialogue: 0,0:06:14.03,0:06:15.30,dialog,,0,0,0,,Jadi, ayo...
Dialogue: 0,0:06:15.30,0:06:17.69,dialog,,0,0,0,,Kita lanjutkan membaca status tadi.
Dialogue: 0,0:06:18.48,0:06:20.43,dialog,,0,0,0,,Masih ada evolusi lainnya?
Dialogue: 0,0:06:21.62,0:06:25.36,dialog,,0,0,0,,2.678.087...
Dialogue: 0,0:06:25.36,0:06:27.60,dialog,,0,0,0,,Angka besar apa ini?
Dialogue: 0,0:06:27.60,0:06:31.98,dialog,,0,0,0,,Itu adalah total daya sihir yang Tuan Master\Npinjamkan ke Pedang Pemecah Langit.
Dialogue: 0,0:06:31.98,0:06:32.75,dialog,,0,0,0,,Sebanyak ini?
Dialogue: 0,0:06:32.75,0:06:33.96,dialog,,0,0,0,,Soalnya sudah lima tahun.
Dialogue: 0,0:06:34.53,0:06:37.38,dialog,,0,0,0,,Lalu, yang di bawahnya adalah\Njumlah daya sihir yang bisa ditagih.
Dialogue: 0,0:06:37.38,0:06:41.30,dialog,,0,0,0,,1.435.837 daya sihir.
Dialogue: 0,0:06:41.30,0:06:44.19,dialog,,0,0,0,,Itu jumlah yang sudah lewat setahun\Nsejak dipinjamkan.
Dialogue: 0,0:06:44.19,0:06:47.22,dialog,,0,0,0,,Skill: Penagihan Paksa?
Dialogue: 0,0:06:47.22,0:06:51.47,dialog,,0,0,0,,Mengambil daya sihir\Ndari peminjam secara paksa.
Dialogue: 0,0:06:51.78,0:06:53.02,dialog,,0,0,0,,Bisa kembali!
Dialogue: 0,0:06:53.39,0:06:55.46,dialog,,0,0,0,,Daya sihir yang selama ini aku pinjamkan!
Dialogue: 0,0:06:57.28,0:06:58.90,dialog,,0,0,0,,Ekspresi itu...
Dialogue: 0,0:06:58.90,0:06:59.86,dialog,,0,0,0,,Semuanya...
Dialogue: 0,0:06:59.86,0:07:02.46,dialog,,0,0,0,,Benar-benar ekspresi yang pantas\Ndimiliki Tuan Master.
Dialogue: 0,0:07:02.46,0:07:04.90,dialog,,0,0,0,,Empee, bagaimana cara memakai skill ini?
Dialogue: 0,0:07:05.40,0:07:07.63,dialog,,0,0,0,,Tenang, tenang, jangan buru-buru.
Dialogue: 0,0:07:07.63,0:07:10.45,dialog,,0,0,0,,Ada syarat untuk memakainya.
Dialogue: 0,0:07:10.45,0:07:13.41,dialog,,0,0,0,,Kau butuh kontrak dengan pihak yang berutang.
Dialogue: 0,0:07:13.66,0:07:14.58,dialog,,0,0,0,,Kontrak?
Dialogue: 0,0:07:16.18,0:07:20.13,dialog,,0,0,0,,Selain itu, Penagihan Paksa juga\Nada berbagai macam jenis.
Dialogue: 0,0:07:20.13,0:07:22.05,dialog,,0,0,0,,Tapi, karena caranya ribet,
Dialogue: 0,0:07:22.80,0:07:25.78,dialog,,0,0,0,,kali ini serahkan saja padaku!
Dialogue: 0,0:07:25.78,0:07:27.05,dialog,,0,0,0,,Soalnya ini yang pertama kali.
Dialogue: 0,0:07:27.89,0:07:29.44,dialog,,0,0,0,,Lihat dia.
Dialogue: 0,0:07:29.60,0:07:30.30,dialog,,0,0,0,,Ya.
Dialogue: 0,0:07:30.47,0:07:32.74,dialog - atas,,0,0,0,,Oh, jadi begitu.
Dialogue: 0,0:07:33.43,0:07:35.23,dialog - atas,,0,0,0,,Aku bisa atau tidak, ya?
Dialogue: 0,0:07:33.44,0:07:35.22,dialog,,0,0,0,,Kenapa dia bicara sendiri?
Dialogue: 0,0:07:35.23,0:07:37.35,dialog - atas,,0,0,0,,Bagaimana kalau gagal?
Dialogue: 0,0:07:35.54,0:07:37.36,dialog,,0,0,0,,Sudah, biarkan.
Dialogue: 0,0:07:37.35,0:07:39.06,dialog - atas,,0,0,0,,Nanti Guy pasti...
Dialogue: 0,0:07:37.36,0:07:38.18,dialog,,0,0,0,,Kita pergi saja.
Dialogue: 0,0:07:43.79,0:07:47.81,dialog,,0,0,0,,Lega banget si Lent yang tak berguna itu\Nsudah pergi.
Dialogue: 0,0:07:48.07,0:07:49.99,dialog,,0,0,0,,Kita yang sekarang,
Dialogue: 0,0:07:49.99,0:07:53.54,dialog,,0,0,0,,sudah tidak butuh pecundang\Nyang cuma bisa meminjamkan daya sihir.
Dialogue: 0,0:07:53.54,0:07:55.95,dialog,,0,0,0,,Kau lihat wajah Lent waktu itu?
Dialogue: 0,0:07:56.75,0:07:58.33,dialog,,0,0,0,,Se-Sesak.
Dialogue: 0,0:07:58.46,0:08:00.02,dialog,,0,0,0,,Lucu banget.
Dialogue: 0,0:08:00.02,0:08:02.34,dialog,,0,0,0,,Konyol banget.
Dialogue: 0,0:08:03.74,0:08:04.88,dialog,,0,0,0,,Hei, Paman.
Dialogue: 0,0:08:06.66,0:08:08.14,dialog,,0,0,0,,Ini bayaran penginapannya.
Dialogue: 0,0:08:08.86,0:08:10.58,dialog,,0,0,0,,Kembaliannya ambil saja.
Dialogue: 0,0:08:10.76,0:08:14.14,dialog,,0,0,0,,Karena mulai sekarang aku bisa mendapatkan\Nuang sebanyak yang kumau.
Dialogue: 0,0:08:14.58,0:08:15.64,dialog,,0,0,0,,Terima kasih!
Dialogue: 0,0:08:15.81,0:08:17.64,dialog,,0,0,0,,Ditunggu kedatangannya lagi!
Dialogue: 0,0:08:17.64,0:08:21.57,dialog,,0,0,0,,Baiklah, sekarang waktunya\Nkita cari anggota baru di guild.
Dialogue: 0,0:08:24.19,0:08:25.28,dialog,,0,0,0,,Lent?
Dialogue: 0,0:08:26.00,0:08:27.58,dialog,,0,0,0,,Kau mau kembali lagi?
Dialogue: 0,0:08:27.89,0:08:29.04,dialog,,0,0,0,,Maaf saja, ya.
Dialogue: 0,0:08:29.04,0:08:32.03,dialog,,0,0,0,,Kau sudah dikeluarkan dari party.
Dialogue: 0,0:08:32.03,0:08:34.74,dialog,,0,0,0,,Kau sudah tak punya tempat lagi di sini.
Dialogue: 0,0:08:34.74,0:08:36.66,dialog,,0,0,0,,Sudah tidak ada tempat lagi!
Dialogue: 0,0:08:36.96,0:08:38.58,dialog,,0,0,0,,Kebetulan sekali.
Dialogue: 0,0:08:41.82,0:08:43.42,dialog,,0,0,0,,Ini barang-barangmu.
Dialogue: 0,0:08:43.79,0:08:47.17,dialog,,0,0,0,,Pemilik penginapan\Nsampai repot-repot mengumpulkannya.
Dialogue: 0,0:08:47.46,0:08:50.85,dialog,,0,0,0,,Padahal kami bilang dibuang saja.
Dialogue: 0,0:08:55.81,0:08:59.64,dialog,,0,0,0,,2.678.087 daya sihir!
Dialogue: 0,0:08:59.94,0:09:03.12,dialog,,0,0,0,,Itulah jumlah daya sihir yang selama ini\Nkupinjamkan pada kalian!
Dialogue: 0,0:09:03.12,0:09:04.44,dialog,,0,0,0,,Hah?
Dialogue: 0,0:09:04.44,0:09:07.69,dialog,,0,0,0,,Apakah kalian berniat\Nmengembalikan semuanya padaku?
Dialogue: 0,0:09:07.86,0:09:09.28,dialog,,0,0,0,,Mengembalikan?
Dialogue: 0,0:09:09.28,0:09:11.11,dialog,,0,0,0,,Kau ini bicara apa, sih?
Dialogue: 0,0:09:11.11,0:09:11.97,dialog,,0,0,0,,Jangan bohong!
Dialogue: 0,0:09:11.97,0:09:15.99,dialog,,0,0,0,,Kalian pasti tahu\Nkalau kalian meminjam daya sihir dariku.
Dialogue: 0,0:09:16.16,0:09:19.47,dialog,,0,0,0,,Dan kalian juga tahu harus mengembalikannya.
Dialogue: 0,0:09:20.14,0:09:23.76,dialog,,0,0,0,,Gift milikku bukan sekadar\Nalat seperti gelang itu!
Dialogue: 0,0:09:25.82,0:09:27.02,dialog,,0,0,0,,Lent!
Dialogue: 0,0:09:27.41,0:09:30.88,dialog,,0,0,0,,Begini caramu meminta pada orang lain, hah?
Dialogue: 0,0:09:31.86,0:09:33.72,dialog,,0,0,0,,Sok banget kau ini.
Dialogue: 0,0:09:34.02,0:09:35.28,dialog,,0,0,0,,Dasar tidak berguna!
Dialogue: 0,0:09:42.75,0:09:44.99,dialog,,0,0,0,,Ma-Maafkan aku.
Dialogue: 0,0:09:45.60,0:09:46.75,dialog,,0,0,0,,Anu...
Dialogue: 0,0:09:48.18,0:09:49.44,dialog,,0,0,0,,Aku mohon...
Dialogue: 0,0:09:50.05,0:09:51.53,dialog,,0,0,0,,Sedikit saja...
Dialogue: 0,0:09:51.70,0:09:53.58,dialog,,0,0,0,,Sedikit demi sedikit saja tidak apa-apa.
Dialogue: 0,0:09:54.36,0:09:56.94,dialog,,0,0,0,,Tolong kembalikan daya sihir
Dialogue: 0,0:09:56.94,0:09:58.40,dialog,,0,0,0,,yang aku pinjamkan.
Dialogue: 0,0:10:00.02,0:10:03.42,dialog,,0,0,0,,Jangan pernah dekati kami lagi!
Dialogue: 0,0:10:07.71,0:10:09.12,dialog,,0,0,0,,Kau mengerti?!
Dialogue: 0,0:10:09.12,0:10:11.41,dialog,,0,0,0,,Jangan pernah dekati kami!
Dialogue: 0,0:10:21.84,0:10:23.10,dialog,,0,0,0,,Selamat tinggal.
Dialogue: 0,0:10:23.65,0:10:26.61,dialog,,0,0,0,,Bayarnya nanti kalau sudah lunas.
Dialogue: 0,0:10:27.23,0:10:29.18,dialog,,0,0,0,,Apaan, sih? Lucu banget.
Dialogue: 0,0:10:34.94,0:10:35.99,dialog,,0,0,0,,Akhirnya bilang juga.
Dialogue: 0,0:10:36.18,0:10:37.33,dialog,,0,0,0,,Dia sudah mengatakannya.
Dialogue: 0,0:10:37.54,0:10:39.60,dialog,,0,0,0,,Di sini Yggdrasil.
Dialogue: 0,0:10:41.87,0:10:43.71,dialog,,0,0,0,,Pengutang teridentifikasi.
Dialogue: 0,0:10:44.77,0:10:46.96,dialog,,0,0,0,,Kontrak paksa telah selesai.
Dialogue: 0,0:10:50.14,0:10:51.00,dialog,,0,0,0,,Skill:
Dialogue: 0,0:10:54.88,0:10:57.43,dialog,,0,0,0,,Penagihan Paksa!
Dialogue: 0,0:11:02.64,0:11:03.43,dialog,,0,0,0,,Skill:
Dialogue: 0,0:11:06.08,0:11:08.56,dialog,,0,0,0,,Penagihan Paksa!
Dialogue: 0,0:11:10.02,0:11:12.69,dialog,,0,0,0,,Ternyata penguntit itu benar-benar ada, ya.
Dialogue: 0,0:11:12.69,0:11:14.96,dialog,,0,0,0,,Aku sampai merinding.
Dialogue: 0,0:11:14.96,0:11:19.20,dialog,,0,0,0,,Yah, habis dilabrak begitu\Npasti takkan berani balik lagi.
Dialogue: 0,0:11:19.39,0:11:22.70,dialog,,0,0,0,,Aku malah ingin menghajarnya\Nlebih parah lagi.
Dialogue: 0,0:11:22.87,0:11:25.14,dialog,,0,0,0,,Misa ini tidak ada ampunnya, ya.
Dialogue: 0,0:11:25.14,0:11:26.46,dialog,,0,0,0,,Kau juga sama.
Dialogue: 0,0:11:34.94,0:11:35.84,dialog,,0,0,0,,Ada apa?
Dialogue: 0,0:11:36.05,0:11:37.55,dialog,,0,0,0,,Tidak, bukan apa-apa.
Dialogue: 0,0:11:37.97,0:11:40.64,dialog,,0,0,0,,Apa kau merasa sedang ditatap Lent\Ndari suatu tempat?
Dialogue: 0,0:11:40.64,0:11:41.51,dialog,,0,0,0,,Hah?
Dialogue: 0,0:11:42.21,0:11:44.22,dialog,,0,0,0,,Jangan bicara yang menjijikkan begitu.
Dialogue: 0,0:11:46.88,0:11:47.66,dialog,,0,0,0,,Dasar.
Dialogue: 0,0:11:55.49,0:11:58.22,dialog,,0,0,0,,Maafkan aku, Tuan Master.
Dialogue: 0,0:11:58.80,0:12:00.96,dialog,,0,0,0,,Kenapa tiba-tiba serius begitu?
Dialogue: 0,0:12:01.12,0:12:03.89,dialog,,0,0,0,,Pria bernama Guy itu...
Dialogue: 0,0:12:04.14,0:12:09.54,dialog,,0,0,0,,Kayaknya lebih cocok jadi rentenir\Ndaripada Tuan Master, deh.
Dialogue: 0,0:12:09.54,0:12:12.54,dialog,,0,0,0,,Cepat bayar utangmu sampai lunas!
Dialogue: 0,0:12:12.54,0:12:14.51,dialog,,0,0,0,,He-Hei, Empee.
Dialogue: 0,0:12:14.51,0:12:17.01,dialog,,0,0,0,,Bercanda, kok, Tuan Master.
Dialogue: 0,0:12:17.17,0:12:18.55,dialog,,0,0,0,,Kau serius?
Dialogue: 0,0:12:18.72,0:12:20.55,dialog,,0,0,0,,Oh, sudah waktunya.
Dialogue: 0,0:12:33.74,0:12:35.07,dialog,,0,0,0,,Jangan-jangan yang tadi itu...
Dialogue: 0,0:12:35.23,0:12:37.63,dialog,,0,0,0,,Daya sihir yang berhasil ditagih.
Dialogue: 0,0:12:37.63,0:12:40.53,dialog,,0,0,0,,Sepertinya kontraknya berhasil terjalin.
Dialogue: 0,0:12:41.50,0:12:42.45,dialog,,0,0,0,,Mulai sekarang,
Dialogue: 0,0:12:42.45,0:12:46.45,dialog,,0,0,0,,penagihannya akan dilakukan secara berkala\Nmengikuti pemulihan otomatis
Dialogue: 0,0:12:46.45,0:12:49.16,dialog,,0,0,0,,para sampah yang tak mau bayar utang itu.
Dialogue: 0,0:12:50.34,0:12:51.50,dialog,,0,0,0,,Ternyata benar.
Dialogue: 0,0:12:51.50,0:12:53.50,dialog,,0,0,0,,Daya sihir di penyimpananku bertambah.
Dialogue: 0,0:12:54.38,0:12:57.55,dialog,,0,0,0,,Mendapatkan skill Pengelolaan Daya Sihir.
Dialogue: 0,0:12:57.55,0:13:00.30,dialog,,0,0,0,,Sepertinya kau mendapatkan skill baru lagi.
Dialogue: 0,0:13:00.74,0:13:02.34,dialog,,0,0,0,,Pengelolaan Daya Sihir?
Dialogue: 0,0:13:02.55,0:13:06.05,dialog,,0,0,0,,Menggunakan daya sihir sendiri\Natau yang ada di penyimpanan
Dialogue: 0,0:13:06.22,0:13:09.26,dialog,,0,0,0,,untuk meningkatkan kapasitas daya sihir.
Dialogue: 0,0:13:10.06,0:13:12.24,dialog,,0,0,0,,Setiap 100 daya sihir,
Dialogue: 0,0:13:12.24,0:13:15.46,dialog,,0,0,0,,kapasitasnya bertambah satu...?
Dialogue: 0,0:13:16.34,0:13:17.57,dialog,,0,0,0,,Ada apa?
Dialogue: 0,0:13:17.76,0:13:21.49,dialog,,0,0,0,,Tidak, rasanya kok biasa saja?
Dialogue: 0,0:13:21.97,0:13:24.03,dialog,,0,0,0,,Bicara apa kau ini?
Dialogue: 0,0:13:24.03,0:13:26.08,dialog,,0,0,0,,Skill ini bisa membuatmu berkembang, tahu!
Dialogue: 0,0:13:26.08,0:13:27.65,dialog,,0,0,0,,Ma-Maaf!
Dialogue: 0,0:13:29.54,0:13:30.79,dialog,,0,0,0,,Tapi,
Dialogue: 0,0:13:30.96,0:13:33.83,dialog,,0,0,0,,aku kan sudah punya\NPenyimpanan Sihir Tanpa Batas.
Dialogue: 0,0:13:34.06,0:13:36.53,dialog,,0,0,0,,Jadi untuk apa meningkatkan\Nkapasitasku sendiri?
Dialogue: 0,0:13:37.01,0:13:38.42,dialog,,0,0,0,,Oh iya, Empee...
Dialogue: 0,0:13:38.70,0:13:42.47,dialog,,0,0,0,,Waktu itu kau bilang\NPenagihan Paksa ada berbagai jenis.
Dialogue: 0,0:13:42.47,0:13:44.34,dialog,,0,0,0,,Maksudnya apa saja?
Dialogue: 0,0:13:44.67,0:13:46.67,dialog,,0,0,0,,Karena kontraknya sudah berhasil,
Dialogue: 0,0:13:46.67,0:13:49.06,dialog,,0,0,0,,akan kujelaskan sekarang.
Dialogue: 0,0:13:49.06,0:13:52.98,dialog,,0,0,0,,Secara garis besar, ada tiga cara penagihan\Nyang bisa Tuan Master lakukan.
Dialogue: 0,0:13:53.42,0:13:55.17,dialog,,0,0,0,,Yang pertama, bayar lunas.
Dialogue: 0,0:13:55.17,0:13:58.73,dialog,,0,0,0,,Yaitu jenis yang menagih seluruh\Ndaya sihir yang dipinjamkan.
Dialogue: 0,0:13:59.82,0:14:00.65,dialog,,0,0,0,,Terima kasih!
Dialogue: 0,0:14:01.55,0:14:03.57,dialog,,0,0,0,,Yang kedua, bayar cicil.
Dialogue: 0,0:14:04.34,0:14:07.78,dialog,,0,0,0,,Ini adalah jenis yang menagih\Ndengan menentukan berapa kali pembayaran.
Dialogue: 0,0:14:08.14,0:14:10.19,dialog,,0,0,0,,Jenis ini akan dikenakan bunga.
Dialogue: 0,0:14:10.19,0:14:10.83,dialog,,0,0,0,,Bunga! Bunga!
Dialogue: 0,0:14:10.83,0:14:13.49,dialog,,0,0,0,,Akan kubayar dalam 12 kali cicilan!
Dialogue: 0,0:14:14.27,0:14:15.29,dialog,,0,0,0,,Terima kasih!
Dialogue: 0,0:14:15.29,0:14:16.93,dialog,,0,0,0,,Oh, jadi begitu.
Dialogue: 0,0:14:17.17,0:14:18.30,dialog,,0,0,0,,Lalu,
Dialogue: 0,0:14:18.75,0:14:21.20,dialog,,0,0,0,,pintu masuk ke neraka.
Dialogue: 0,0:14:21.44,0:14:23.43,dialog,,0,0,0,,Cicilan daya sihir bergulir.
Dialogue: 0,0:14:23.94,0:14:25.86,dialog,,0,0,0,,Neraka? Bergulir?
Dialogue: 0,0:14:25.86,0:14:29.42,dialog,,0,0,0,,Tentu saja, kontraknya aku buat\Ndengan jenis yang ini.
Dialogue: 0,0:14:31.09,0:14:32.21,dialog,,0,0,0,,Tapi,
Dialogue: 0,0:14:32.21,0:14:36.19,dialog,,0,0,0,,memangnya cicilan bergulir ini\Nsemengerikan itu?
Dialogue: 0,0:14:36.53,0:14:37.41,dialog,,0,0,0,,Baiklah, monyet.
Dialogue: 0,0:14:37.41,0:14:37.98,dialog,,0,0,0,,Monyet?
Dialogue: 0,0:14:38.90,0:14:40.77,dialog,,0,0,0,,Maksudku, akan kujelaskan pelan-pelan
Dialogue: 0,0:14:40.77,0:14:44.57,dialog,,0,0,0,,tentang cicilan bergulir\Nagar Tuan Master paham.
Dialogue: 0,0:14:45.22,0:14:47.18,dialog,,0,0,0,,Situasi macam apa ini?
Dialogue: 0,0:14:47.18,0:14:49.23,dialog,,0,0,0,,Ada suara aneh pula.
Dialogue: 0,0:14:49.23,0:14:52.50,dialog,,0,0,0,,Sudah, sudah, jangan terlalu dipikirkan.
Dialogue: 0,0:14:52.50,0:14:54.66,dialog,,0,0,0,,Baiklah, kita mulai penjelasannya.
Dialogue: 0,0:14:55.33,0:14:56.94,dialog,,0,0,0,,Cicilan daya sihir bergulir
Dialogue: 0,0:14:56.94,0:15:00.03,dialog,,0,0,0,,adalah jenis penagihan bagi pengutang
Dialogue: 0,0:15:00.03,0:15:02.05,dialog,,0,0,0,,yang takkan bisa kabur apa pun caranya
Dialogue: 0,0:15:02.05,0:15:05.30,dialog,,0,0,0,,karena utangnya sudah terlalu membengkak.
Dialogue: 0,0:15:05.47,0:15:06.48,dialog,,0,0,0,,Meski begitu,
Dialogue: 0,0:15:06.48,0:15:09.89,dialog,,0,0,0,,kita hanya menagih jumlah\Ntertentu secara berkala.
Dialogue: 0,0:15:10.37,0:15:13.74,dialog,,0,0,0,,Tapi, bukankah itu sama saja\Ndengan cicilan biasa?
Dialogue: 0,0:15:13.74,0:15:14.96,dialog,,0,0,0,,Kalau bayar cicil,
Dialogue: 0,0:15:14.96,0:15:18.80,dialog,,0,0,0,,jumlah utangnya dibagi\Nmenjadi beberapa kali pembayaran.
Dialogue: 0,0:15:18.98,0:15:21.23,dialog,,0,0,0,,Meski cicilan per harinya terasa berat,
Dialogue: 0,0:15:21.23,0:15:24.35,dialog,,0,0,0,,pengutang tetap yakin bisa melunasinya.
Dialogue: 0,0:15:26.11,0:15:27.20,dialog,,0,0,0,,Namun,
Dialogue: 0,0:15:27.20,0:15:28.87,dialog,,0,0,0,,cicilan bergulir itu beda!
Dialogue: 0,0:15:28.87,0:15:30.49,dialog,,0,0,0,,Eh? Apa bedanya?
Dialogue: 0,0:15:30.72,0:15:33.31,dialog,,0,0,0,,Mau pinjam seratus atau sepuluh ribu,
Dialogue: 0,0:15:33.31,0:15:37.22,dialog,,0,0,0,,jumlah yang ditagih akan selalu sama.
Dialogue: 0,0:15:41.63,0:15:44.38,dialog,,0,0,0,,Biar kujelaskan lagi dengan cara\Nyang lebih mudah dipahami.
Dialogue: 0,0:15:44.38,0:15:46.88,dialog,,0,0,0,,Misalnya pada kasus tiga orang ini.
Dialogue: 0,0:15:46.88,0:15:51.47,dialog,,0,0,0,,Si Bodoh yang merasa sukses berkat\Nusahanya sendiri punya 1.000 daya sihir.
Dialogue: 0,0:15:51.79,0:15:55.52,dialog,,0,0,0,,Si Sialan yang tidak mau bayar utang\Npunya 1.400 daya sihir.
Dialogue: 0,0:15:55.52,0:16:00.27,dialog,,0,0,0,,Dan si Bego yang pinjam melulu\Ntanpa pikir panjang punya 1.200 daya sihir.
Dialogue: 0,0:16:00.27,0:16:03.44,dialog,,0,0,0,,Lalu, jumlah daya sihir yang bisa dipulihkan
Dialogue: 0,0:16:03.44,0:16:06.24,dialog,,0,0,0,,adalah 10% setiap jamnya,
Dialogue: 0,0:16:06.24,0:16:07.49,dialog,,0,0,0,,jadi si Bodoh 100,
Dialogue: 0,0:16:07.74,0:16:09.32,dialog,,0,0,0,,si Sialan 140,
Dialogue: 0,0:16:09.78,0:16:11.30,dialog,,0,0,0,,dan si Bego 120.
Dialogue: 0,0:16:11.30,0:16:14.62,dialog,,0,0,0,,Dan kalau dikalikan 24 jam,
Dialogue: 0,0:16:14.62,0:16:16.58,dialog,,0,0,0,,maka si Bodoh 2.400,
Dialogue: 0,0:16:16.94,0:16:19.31,dialog,,0,0,0,,si Sialan 3.360,
Dialogue: 0,0:16:19.65,0:16:22.59,dialog,,0,0,0,,dan si Bego 2.880,
Dialogue: 0,0:16:23.25,0:16:25.63,dialog,,0,0,0,,jadi, totalnya 8.640
Dialogue: 0,0:16:25.63,0:16:28.74,dialog,,0,0,0,,adalah jumlah yang bisa dipulihkan\Nmereka bertiga dalam sehari.
Dialogue: 0,0:16:28.98,0:16:30.74,dialog,,0,0,0,,Iya, benar juga.
Dialogue: 0,0:16:30.91,0:16:34.13,dialog,,0,0,0,,Selain itu,\Njumlah yang bisa dipulihkan gelang mereka
Dialogue: 0,0:16:34.13,0:16:36.77,dialog,,0,0,0,,adalah 3.000 daya sihir,
Dialogue: 0,0:16:37.06,0:16:40.40,dialog,,0,0,0,,jadi kalau digabungkan\Ndengan 8.640 daya sihir,
Dialogue: 0,0:16:40.70,0:16:44.15,dialog,,0,0,0,,totalnya jadi 11.640 daya sihir.
Dialogue: 0,0:16:45.04,0:16:47.39,dialog,,0,0,0,,Kalau masih bingung soal konsep daya sihir,
Dialogue: 0,0:16:47.39,0:16:51.52,dialog,,0,0,0,,bayangkan saja sebagai uang\Nyang bisa mereka bayar dalam sehari.
Dialogue: 0,0:16:51.82,0:16:53.74,dialog,,0,0,0,,Sampai sini bisa dimengerti?
Dialogue: 0,0:16:53.74,0:16:55.16,dialog,,0,0,0,,Ya, lumayan.
Dialogue: 0,0:16:55.42,0:16:57.78,dialog,,0,0,0,,Di sisi lain, seperti yang sudah dijelaskan,
Dialogue: 0,0:16:57.78,0:17:01.07,dialog,,0,0,0,,total daya sihir yang Tuan Master pinjamkan\Npada para sampah itu
Dialogue: 0,0:17:01.07,0:17:04.82,dialog,,0,0,0,,adalah 2.678.087 daya sihir,
Dialogue: 0,0:17:04.82,0:17:09.73,dialog,,0,0,0,,dan jumlah yang bisa ditagih\Nsetelah setahun berlalu
Dialogue: 0,0:17:09.73,0:17:13.39,dialog,,0,0,0,,adalah 1.435.837 daya sihir.
Dialogue: 0,0:17:14.93,0:17:18.45,dialog,,0,0,0,,Karena bunganya 8% untuk 10 hari,
Dialogue: 0,0:17:18.45,0:17:22.14,dialog,,0,0,0,,jadi hasilnya 114.866,96.
Dialogue: 0,0:17:22.14,0:17:24.11,dialog,,0,0,0,,Biar lebih gampang,
Dialogue: 0,0:17:24.50,0:17:27.78,dialog,,0,0,0,,kita bulatkan saja jadi 115.000 daya sihir!
Dialogue: 0,0:17:27.78,0:17:28.86,dialog,,0,0,0,,Tunggu dulu!
Dialogue: 0,0:17:28.86,0:17:31.57,dialog,,0,0,0,,Skill-ku bisa menghasilkan bunga juga?
Dialogue: 0,0:17:31.57,0:17:32.80,dialog,,0,0,0,,Tentu saja.
Dialogue: 0,0:17:32.80,0:17:35.58,dialog,,0,0,0,,Inilah kekuatan dari\NPenyimpanan Sihir Tanpa Batas.
Dialogue: 0,0:17:35.89,0:17:38.66,dialog,,0,0,0,,Kalau kita menagih tiga orang\Nyang selalu meminjam itu,
Dialogue: 0,0:17:38.66,0:17:42.48,dialog,,0,0,0,,batas maksimum yang bisa ditagih per hari
Dialogue: 0,0:17:42.48,0:17:46.13,dialog,,0,0,0,,adalah 11.640 daya sihir,
Dialogue: 0,0:17:46.13,0:17:50.29,dialog,,0,0,0,,berarti, dalam 10 hari\Nbisa menghasilkan 116.400 daya sihir.
Dialogue: 0,0:17:50.80,0:17:52.85,dialog,,0,0,0,,Bunga yang dihasilkan dalam 10 hari,
Dialogue: 0,0:17:52.85,0:17:55.72,dialog,,0,0,0,,adalah 115.000 daya sihir.
Dialogue: 0,0:17:55.72,0:17:57.10,dialog,,0,0,0,,Itu artinya...
Dialogue: 0,0:17:57.63,0:18:00.98,dialog,,0,0,0,,Daya sihir pokok mereka\Nhampir tidak berkurang sama sekali.
Dialogue: 0,0:18:04.22,0:18:08.19,dialog,,0,0,0,,Aku bisa menaikkan bunga\Ndan menagih semuanya sekaligus,
Dialogue: 0,0:18:08.36,0:18:11.11,dialog,,0,0,0,,tapi nanti mereka cepat bangkrut,\Njadi tidak seru.
Dialogue: 0,0:18:11.53,0:18:14.95,dialog,,0,0,0,,Jadi aku tetapkan saja 8%\Nagar mereka tetap hidup terjerat utang.
Dialogue: 0,0:18:15.25,0:18:18.83,dialog,,0,0,0,,Hidup mereka cuma untuk membayar bunga.
Dialogue: 0,0:18:18.83,0:18:20.05,dialog,,0,0,0,,Begitu berganti bulan,
Dialogue: 0,0:18:20.05,0:18:22.69,dialog,,0,0,0,,beban yang harus dibayar akan menumpuk,
Dialogue: 0,0:18:22.69,0:18:24.99,dialog,,0,0,0,,dan mereka akan terus menderita.
Dialogue: 0,0:18:25.73,0:18:27.50,dialog,,0,0,0,,Kau merencanakan hal seperti itu?!
Dialogue: 0,0:18:27.74,0:18:32.50,dialog,,0,0,0,,Ya, soalnya sikap mereka sangat pantas\Nuntuk masuk neraka cicilan bergulir.
Dialogue: 0,0:18:32.50,0:18:35.01,dialog,,0,0,0,,Pantas untuk masuk neraka cicilan bergulir?
Dialogue: 0,0:18:35.01,0:18:35.97,dialog,,0,0,0,,Benar.
Dialogue: 0,0:18:35.97,0:18:38.76,dialog,,0,0,0,,Yang mudah terjerumus\Ndalam neraka cicilan bergulir,
Dialogue: 0,0:18:38.76,0:18:43.30,dialog,,0,0,0,,biasanya si Bodoh yang terlalu yakin\Nsemuanya akan baik-baik saja.
Dialogue: 0,0:18:43.56,0:18:47.31,dialog,,0,0,0,,Si Sialan yang bodoh\Ntapi merasa dirinya pintar.
Dialogue: 0,0:18:47.65,0:18:51.50,dialog,,0,0,0,,Lalu si Bego yang tak bisa\Nmemikirkan apa pun.
Dialogue: 0,0:18:52.21,0:18:53.90,dialog,,0,0,0,,Pokoknya tiga tipe ini.
Dialogue: 0,0:18:54.08,0:18:58.78,dialog,,0,0,0,,Sistem cicilan bergulir\Nsebenarnya tidak mengerikan.
Dialogue: 0,0:18:59.54,0:19:01.57,dialog,,0,0,0,,Tergantung orangnya.
Dialogue: 0,0:19:07.15,0:19:09.60,dialog,,0,0,0,,Kita tak butuh orang seperti Lent.
Dialogue: 0,0:19:09.60,0:19:12.10,dialog,,0,0,0,,Kita butuhnya yang bisa bantu\Ndalam bertarung.
Dialogue: 0,0:19:12.10,0:19:14.67,dialog,,0,0,0,,Aku sudah kapok bawa beban seperti dia.
Dialogue: 0,0:19:14.67,0:19:18.55,dialog,,0,0,0,,Dia itu bukan beban lagi,\Ntapi seonggok sampah.
Dialogue: 0,0:19:18.72,0:19:20.05,dialog,,0,0,0,,Benar banget.
Dialogue: 0,0:19:25.90,0:19:28.85,dialog,,0,0,0,,Tapi, rasanya itu berlebihan.
Dialogue: 0,0:19:28.85,0:19:30.19,dialog,,0,0,0,,Tidak apa-apa.
Dialogue: 0,0:19:30.59,0:19:34.94,dialog,,0,0,0,,Selama ini mereka tak pernah berterima kasih\Nmaupun menghargai Tuan Master.
Dialogue: 0,0:19:35.28,0:19:38.13,dialog,,0,0,0,,Belum lagi mencaci maki\Ndan memperlakukan seenaknya.
Dialogue: 0,0:19:38.49,0:19:40.83,dialog,,0,0,0,,Lalu, mengusir Tuan Master dari party.
Dialogue: 0,0:19:41.37,0:19:42.83,dialog,,0,0,0,,Empee?
Dialogue: 0,0:19:45.55,0:19:48.74,dialog,,0,0,0,,Sampah seperti itu tidak perlu dikasihani.
Dialogue: 0,0:19:48.74,0:19:50.22,dialog,,0,0,0,,Sudutkan saja mereka,
Dialogue: 0,0:19:50.22,0:19:55.63,dialog,,0,0,0,,peras semaksimal mungkin dan jatuhkan\Nke jurang keputusasaan sampai sadar.
Dialogue: 0,0:19:56.06,0:19:59.47,dialog,,0,0,0,,Kita lihat siapa yang sebenarnya\Ntidak berguna.
Dialogue: 0,0:20:00.08,0:20:01.14,dialog,,0,0,0,,Empee!
Dialogue: 0,0:20:01.14,0:20:02.64,dialog,,0,0,0,,Iya, Tuan Master!
Dialogue: 0,0:20:03.52,0:20:05.36,dialog,,0,0,0,,Ngeri banget, tahu.
Dialogue: 0,0:20:05.36,0:20:08.52,dialog,,0,0,0,,Aku cuma menyuarakan\Nperasaan Tuan Master, kok.
Dialogue: 0,0:20:08.52,0:20:11.02,dialog,,0,0,0,,Aku tidak memikirkan hal seperti itu, kok.
Dialogue: 0,0:20:11.02,0:20:13.02,dialog,,0,0,0,,Masa?
Dialogue: 0,0:20:13.41,0:20:14.64,dialog,,0,0,0,,Kenapa dia?
Dialogue: 0,0:20:14.93,0:20:17.03,dialog,,0,0,0,,Dia duduk sendirian, 'kan?
Dialogue: 0,0:20:17.03,0:20:19.16,dialog,,0,0,0,,Masa iya?
Dialogue: 0,0:20:22.42,0:20:23.28,dialog,,0,0,0,,Tapi,
Dialogue: 0,0:20:23.28,0:20:26.99,dialog,,0,0,0,,rencana kontraknya\Nbisa diubah kapan pun, kok.
Dialogue: 0,0:20:26.99,0:20:28.11,dialog,,0,0,0,,Sungguh?
Dialogue: 0,0:20:28.11,0:20:28.92,dialog,,0,0,0,,Ya.
Dialogue: 0,0:20:29.82,0:20:33.22,dialog,,0,0,0,,Misalnya, kalau sampai benar-benar terjadi,
Dialogue: 0,0:20:33.22,0:20:36.67,dialog,,0,0,0,,para sampah itu\Nmemohon ampun dan meminta maaf,
Dialogue: 0,0:20:37.25,0:20:40.37,dialog,,0,0,0,,nanti kita bisa pikirkan cara yang lainnya.
Dialogue: 0,0:20:43.49,0:20:46.29,dialog,,0,0,0,,Tuan Master memang baik sekali, ya.
Dialogue: 0,0:20:46.62,0:20:48.74,dialog,,0,0,0,,Sungguh?
Dialogue: 0,0:20:48.74,0:20:51.84,dialog,,0,0,0,,Lebih tepatnya terlalu polos, sih.
Dialogue: 0,0:20:52.27,0:20:55.39,dialog,,0,0,0,,Terlalu naif, tidak berpengalaman,
Dialogue: 0,0:20:55.39,0:20:57.36,dialog,,0,0,0,,tipe yang mudah ditipu,
Dialogue: 0,0:20:57.36,0:20:59.63,dialog,,0,0,0,,atau tipe yang gampang dimanfaatkan orang.
Dialogue: 0,0:20:59.63,0:21:01.25,dialog,,0,0,0,,Sudah, cukup!
Dialogue: 0,0:21:01.25,0:21:01.86,dialog,,0,0,0,,Tapi,
Dialogue: 0,0:21:04.50,0:21:07.45,dialog,,0,0,0,,menjadi orang yang tulus itu\Nadalah hal yang luar biasa.
