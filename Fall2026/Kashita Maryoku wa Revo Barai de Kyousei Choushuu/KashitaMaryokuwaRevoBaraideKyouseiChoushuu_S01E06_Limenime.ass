Dialogue: 0,0:00:08.86,0:00:09.66,sign,,0000,0000,0000,,PENYIMPANAN: 96.599/TANPA BATAS\NRANK PETUALANG: D, PARTY: DUA ANOMALI
Dialogue: 0,0:00:22.04,0:00:26.01,sign,,0000,0000,0000,,DUA ANOMALI/TWICE EXCEPTIONAL, RANK F\NANGGOTA: LENT DAN RINKA
Dialogue: 0,0:00:42.06,0:00:42.59,sign,,0000,0000,0000,,PEMINJAMAN DAYA SIHIR LEVEL 1:\NPEMINJAMAN KE PARTY
Dialogue: 0,0:00:42.59,0:00:44.16,sign,,0000,0000,0000,,"BARU! LEVEL 2: AUTO CHARGE"
Dialogue: 0,0:00:44.17,0:00:44.60,sign,,0000,0000,0000,,PENYESUAIAN STATUS
Dialogue: 0,0:00:44.60,0:00:45.69,sign,,0000,0000,0000,,"PENAGIHAN PAKSA PADA PEDANG PEMECAH LANGIT"
Dialogue: 0,0:02:43.49,0:02:45.24,sign,,0000,0000,0000,,"EPISODE 6: KUTUKAN"
Dialogue: 0,0:03:41.74,0:03:43.95,sign,,0000,0000,0000,,DESTRA, GIFT: PENDEKAR PEDANG KEMBAR (S)
Dialogue: 0,0:03:43.99,0:03:46.46,sign,,0000,0000,0000,,SINISTRA, GIFT: PENDEKAR PEDANG KEMBAR (S)
Dialogue: 0,0:03:46.50,0:03:48.83,sign,,0000,0000,0000,,RORY, GIFT: PENGINTAI TINGKAT KHUSUS (A)
Dialogue: 0,0:03:48.87,0:03:51.46,sign,,0000,0000,0000,,SERIKA, GIFT: PENYEMBUH TINGKAT LANJUT (S)
Dialogue: 0,0:03:51.50,0:03:53.96,sign,,0000,0000,0000,,SHANNON, GIFT: PENYIHIR TINGKAT KHUSUS (A)
Dialogue: 0,0:14:06.91,0:14:09.24,sign,,0000,0000,0000,,CAIRAN PERBAIKAN/REPAIR LIQUID
Dialogue: 0,0:14:52.04,0:14:53.83,sign,,0000,0000,0000,,GOROU, 15 TAHUN, PANDAI BESI (E)
Dialogue: 0,0:16:43.11,0:16:47.57,sign,,0000,0000,0000,,DUNGEON AGUNG MELBA,\NLANTAI DUA: HUTAN BELANTARA GOBLIN
Dialogue: 0,0:16:59.08,0:16:59.48,sign,,0000,0000,0000,,TEBASAN PERTAMA
Dialogue: 0,0:17:14.83,0:17:15.25,sign,,0000,0000,0000,,RINKA, 18 TAHUN, JALAN BERTARUNG ASURA "SSS"
Dialogue: 0,0:17:15.26,0:17:16.30,sign,,0000,0000,0000,,"DAYA SIHIR: 10/10, RANK PETUALANG: F"
Dialogue: 0,0:17:16.30,0:17:19.83,sign,,0000,0000,0000,,"PARTY: DUA ANOMALI"
Dialogue: 0,0:00:03.87,0:00:06.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pendaftaran party baru telah selesai.
Dialogue: 0,0:00:11.78,0:00:13.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:00:14.45,0:00:16.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga petualangan kalian lancar.
Dialogue: 0,0:00:16.45,0:00:17.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:00:26.40,0:00:28.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anda telah bergabung ke party kedua.
Dialogue: 0,0:00:31.06,0:00:33.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syarat perkembangan skill telah terpenuhi.
Dialogue: 0,0:00:33.72,0:00:36.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peminjaman Daya Sihir meningkat ke level 2.
Dialogue: 0,0:00:37.34,0:00:38.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:00:39.79,0:00:41.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skill-ku sepertinya berkembang.
Dialogue: 0,0:00:42.59,0:00:44.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Auto Charge?
Dialogue: 0,0:00:44.60,0:00:45.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemampuan apa ini?
Dialogue: 0,0:00:45.90,0:00:49.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skill ini akan otomatis\Nmeminjamkan daya sihir
Dialogue: 0,0:00:49.22,0:00:52.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ketika daya sihir peminjam berkurang\Ndi bawah batas yang ditentukan.
Dialogue: 0,0:00:52.87,0:00:54.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan ini,
Dialogue: 0,0:00:54.40,0:00:57.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau jadi tak perlu memeriksa\Nsisa daya sihir rekanmu.
Dialogue: 0,0:00:58.03,0:01:00.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, praktis juga!
Dialogue: 0,0:01:00.46,0:01:02.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bicara soal memeriksa daya sihir,
Dialogue: 0,0:01:02.74,0:01:07.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}para sampah itu sudah memeriksa\Ndaya sihir yang mereka pinjam atau belum, ya?
Dialogue: 0,0:01:22.37,0:01:24.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daya Sihir yang Dipinjam\NAkan Ditagih Paksa dengan Sistem Cicilan
Dialogue: 0,0:02:39.34,0:02:42.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini dia, 20 botol pemulih daya sihir.
Dialogue: 0,0:02:43.49,0:02:45.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, Kak.
Dialogue: 0,0:02:45.25,0:02:46.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:02:46.62,0:02:49.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak enak bilang begini\Nkarena kau pelanggan tetap,
Dialogue: 0,0:02:49.94,0:02:53.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi, efek obat ini bisa dibilang\Nseperti meminjam nyawa.
Dialogue: 0,0:02:54.16,0:02:55.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau terlalu sering digunakan...
Dialogue: 0,0:02:55.78,0:02:57.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, aku tahu, kok.
Dialogue: 0,0:02:57.92,0:03:00.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ramuan pemulih daya sihir itu adiktif.
Dialogue: 0,0:03:00.74,0:03:04.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dikonsumsi berlebihan bisa\Nmenyebabkan mual atau pusing,
Dialogue: 0,0:03:04.42,0:03:07.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan direkomendasikan\Nmaksimal lima botol sehari.
Dialogue: 0,0:03:07.31,0:03:08.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bingo, 'kan?
Dialogue: 0,0:03:08.85,0:03:10.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bi-Bingo?
Dialogue: 0,0:03:10.42,0:03:13.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak punya waktu mendengarkan ceramahmu.
Dialogue: 0,0:03:13.31,0:03:15.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau aku ketinggalan kereta kuda?
Dialogue: 0,0:03:15.62,0:03:16.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:03:18.51,0:03:20.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, "bingo" itu apa...?
Dialogue: 0,0:03:23.68,0:03:28.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kereta kuda tujuan Melba\Nakan segera berangkat!
Dialogue: 0,0:03:33.97,0:03:36.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, orang yang paling belakang itu...
Dialogue: 0,0:03:37.68,0:03:38.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka kan...
Dialogue: 0,0:03:38.86,0:03:41.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serigala Perak Berkepala Dua?
Dialogue: 0,0:03:54.26,0:03:56.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tak salah, mereka party rank B, 'kan?
Dialogue: 0,0:03:56.88,0:03:57.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:03:57.98,0:04:00.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti, perjalanan kali ini bakal aman.
Dialogue: 0,0:04:03.58,0:04:06.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, rombongan di sana.
Dialogue: 0,0:04:06.74,0:04:09.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa tukar tempat duduk?
Dialogue: 0,0:04:11.71,0:04:13.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sofa yang empuk.
Dialogue: 0,0:04:13.22,0:04:15.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bikin iri.
Dialogue: 0,0:04:16.07,0:04:19.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempat duduk kami ini rasanya kurang nyaman.
Dialogue: 0,0:04:20.70,0:04:23.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Intinya, enyahlah.
Dialogue: 0,0:04:23.97,0:04:25.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tak salah, kalian kan...
Dialogue: 0,0:04:25.68,0:04:28.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Naik ke rank B dengan waktu tercepat\Nsepanjang sejarah.
Dialogue: 0,0:04:29.09,0:04:30.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang Pemecah Langit.
Dialogue: 0,0:04:31.97,0:04:35.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan kalian pasti\NSerigala Perak Berkepala Dua.
Dialogue: 0,0:04:35.09,0:04:37.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rank B spesialis keroco, ya?
Dialogue: 0,0:04:37.67,0:04:39.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sombong sekali kau.
Dialogue: 0,0:04:39.47,0:04:41.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, wah, berarti benar, ya?
Dialogue: 0,0:04:41.97,0:04:43.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan remehkan kami, sialan.
Dialogue: 0,0:04:47.14,0:04:49.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, di mana Lent?
Dialogue: 0,0:04:49.39,0:04:50.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:04:50.81,0:04:53.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beban seperti dia sudah dibuang.
Dialogue: 0,0:04:53.23,0:04:56.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya dia orang tidak berguna\Nyang tak bisa apa-apa.
Dialogue: 0,0:05:05.44,0:05:08.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia punya Gift Unik.
Dialogue: 0,0:05:08.03,0:05:10.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orangnya sangat menarik.
Dialogue: 0,0:05:10.02,0:05:11.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong bertemanlah dengannya.
Dialogue: 0,0:05:12.10,0:05:13.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Anu...
Dialogue: 0,0:05:13.82,0:05:16.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Lent dari Pedang Pemecah Langit.
Dialogue: 0,0:05:16.67,0:05:19.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peranku hanya meminjamkan daya sihir,
Dialogue: 0,0:05:19.55,0:05:22.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi ketiga rekanku\Nbenar-benar pekerja keras.
Dialogue: 0,0:05:22.78,0:05:26.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon dukungannya\Nuntuk Pedang Pemecah Langit.
Dialogue: 0,0:05:44.21,0:05:47.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau kursi ini\Nkita berikan saja pada mereka?
Dialogue: 0,0:05:47.25,0:05:48.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau benar.
Dialogue: 0,0:05:53.87,0:05:55.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu dulu, Ketua!
Dialogue: 0,0:05:57.68,0:06:01.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan, kursinya kuberikan pada kalian,\NPedang Pemecah Langit.
Dialogue: 0,0:06:02.59,0:06:03.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar pengecut.
Dialogue: 0,0:06:03.82,0:06:04.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hus, hus.
Dialogue: 0,0:06:05.05,0:06:07.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Empuk banget!
Dialogue: 0,0:06:10.88,0:06:12.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersulang!
Dialogue: 0,0:06:15.98,0:06:17.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyebalkan.
Dialogue: 0,0:06:18.40,0:06:21.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau yakin tidak masalah, Ketua?
Dialogue: 0,0:06:21.49,0:06:23.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini adalah kereta kuda cepat.
Dialogue: 0,0:06:23.63,0:06:27.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kereta kuda yang bisa dua kali\Nlebih cepat daripada kereta biasa.
Dialogue: 0,0:06:28.03,0:06:30.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa cepat karena melewati\Njalan pintas berbahaya
Dialogue: 0,0:06:30.82,0:06:33.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang tidak dilalui kereta kuda biasa.
Dialogue: 0,0:06:33.94,0:06:35.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di kereta kuda cepat,\Nada aturan tak tertulis:
Dialogue: 0,0:06:35.97,0:06:37.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}siapa pun yang duduk paling belakang
Dialogue: 0,0:06:37.92,0:06:41.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bertugas menjadi pelindung\Npara penumpang lain.
Dialogue: 0,0:06:43.47,0:06:46.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Merekalah yang memilih\Nmengemban tugas tersebut.
Dialogue: 0,0:06:46.64,0:06:49.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita hanya menghargai semangat mereka.
Dialogue: 0,0:06:49.68,0:06:51.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, tunggu dulu.
Dialogue: 0,0:06:51.15,0:06:54.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jelas-jelas mereka cuma pengin\Nduduk di tempat yang bagus.
Dialogue: 0,0:06:56.14,0:06:57.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malah minum-minum pula!
Dialogue: 0,0:06:58.11,0:06:59.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah, tidak sopan.
Dialogue: 0,0:07:00.13,0:07:04.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin petualang berpikiran dangkal\Nseperti itu menjadi party rank B.
Dialogue: 0,0:07:05.10,0:07:08.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, mereka itu orang-orang\Nyang tega membuang Lent, lo!
Dialogue: 0,0:07:08.53,0:07:13.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin karena mereka sudah\Ncukup kuat bahkan tanpa Lent.
Dialogue: 0,0:07:14.99,0:07:17.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa Renren baik-baik saja?
Dialogue: 0,0:07:23.15,0:07:25.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti biasa, hutannya mengerikan.
Dialogue: 0,0:07:25.67,0:07:26.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:07:30.53,0:07:32.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan kereta kudanya!
Dialogue: 0,0:07:32.10,0:07:33.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di depan ada High Orc!
Dialogue: 0,0:07:33.90,0:07:34.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:07:37.36,0:07:38.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah muncul, ya.
Dialogue: 0,0:07:38.85,0:07:39.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:07:43.60,0:07:44.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial, kereta barangnya.
Dialogue: 0,0:07:45.18,0:07:46.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kejam sekali.
Dialogue: 0,0:07:48.69,0:07:49.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada tiga High Orc!
Dialogue: 0,0:07:49.97,0:07:51.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong kirimkan bala bantuan!
Dialogue: 0,0:07:52.66,0:07:53.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo.
Dialogue: 0,0:07:53.73,0:07:54.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktunya bekerja.
Dialogue: 0,0:07:57.78,0:08:00.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, yang di belakang, jangan tidur melulu!
Dialogue: 0,0:08:02.50,0:08:04.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita sudah sampai?
Dialogue: 0,0:08:04.71,0:08:06.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada High Orc muncul!
Dialogue: 0,0:08:07.02,0:08:08.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami serahkan pada kalian.
Dialogue: 0,0:08:09.23,0:08:10.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan berikan instruksi.
Dialogue: 0,0:08:13.47,0:08:15.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misa, Elle, bangun!
Dialogue: 0,0:08:19.66,0:08:21.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lawan kita adalah High Orc.
Dialogue: 0,0:08:21.92,0:08:24.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita ini party rank B,
Dialogue: 0,0:08:24.91,0:08:26.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pasti menang mudah!
Dialogue: 0,0:08:27.23,0:08:28.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian urus yang kanan,
Dialogue: 0,0:08:29.76,0:08:31.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan aku akan urus yang kiri.
Dialogue: 0,0:08:32.58,0:08:34.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para penjaga urus yang tengah!
Dialogue: 0,0:08:34.58,0:08:35.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:08:35.58,0:08:37.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekeliling kita hutan lebat.
Dialogue: 0,0:08:37.63,0:08:40.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selesaikan dengan cepat\Nsebelum monster lain datang!
Dialogue: 0,0:08:40.41,0:08:42.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, seperti biasa.
Dialogue: 0,0:08:42.58,0:08:44.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita langsung serang.
Dialogue: 0,0:08:47.42,0:08:48.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Speed Up!
Dialogue: 0,0:09:05.74,0:09:07.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Double Bind!
Dialogue: 0,0:09:10.94,0:09:13.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lightning Pierce!
Dialogue: 0,0:09:23.73,0:09:26.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhasil dikalahkan dalam 39 detik.
Dialogue: 0,0:09:26.30,0:09:28.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayang sekali gagal cetak rekor baru.
Dialogue: 0,0:09:34.64,0:09:35.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Rasakan!\N- Terima ini!
Dialogue: 0,0:09:49.71,0:09:51.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silver Scissors!
Dialogue: 0,0:09:56.82,0:09:58.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita selamat.
Dialogue: 0,0:09:58.26,0:10:00.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian memang luar biasa.
Dialogue: 0,0:10:00.40,0:10:02.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian juga sudah bertahan\Ndengan sangat baik.
Dialogue: 0,0:10:03.65,0:10:05.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:10:08.77,0:10:12.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Elle! Cepat gunakan sihir penguat!
Dialogue: 0,0:10:12.55,0:10:15.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belum minum obatnya, jadi tidak bisa.
Dialogue: 0,0:10:15.84,0:10:17.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga tidak bisa.
Dialogue: 0,0:10:17.58,0:10:19.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minum satu botol saja sudah mual.
Dialogue: 0,0:10:19.97,0:10:22.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sialan, mereka ini benar-benar tidak berguna.
Dialogue: 0,0:10:29.50,0:10:32.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang sedang mereka lakukan?
Dialogue: 0,0:10:32.05,0:10:33.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Payah.
Dialogue: 0,0:10:35.36,0:10:37.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awas! Mereka datang lagi!
Dialogue: 0,0:10:37.03,0:10:39.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guy, lakukanlah sesuatu!
Dialogue: 0,0:10:39.50,0:10:42.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berisik! Dasar tidak berguna!
Dialogue: 0,0:10:44.12,0:10:45.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sialan!
Dialogue: 0,0:10:45.17,0:10:48.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam pertarungan mendadak begini,\Nefek obatnya tidak langsung terasa.
Dialogue: 0,0:10:49.12,0:10:51.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apalagi aku baru bangun!
Dialogue: 0,0:10:52.38,0:10:53.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halah, persetan!
Dialogue: 0,0:10:53.78,0:10:56.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanpa skill pun, aku masih bisa melawanmu!
Dialogue: 0,0:11:11.62,0:11:13.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kau lakukan, Bodoh?!
Dialogue: 0,0:11:13.49,0:11:17.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita sudah sering lawan High Orc, 'kan?
Dialogue: 0,0:11:17.60,0:11:20.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berisik, aku tahu!
Dialogue: 0,0:11:29.98,0:11:31.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keroco begini...
Dialogue: 0,0:11:31.62,0:11:34.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}harusnya gampang kalau\Nada skill dan daya sihir!
Dialogue: 0,0:11:43.62,0:11:45.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Parallel Execution.
Dialogue: 0,0:11:51.66,0:11:53.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertarungan selesai.
Dialogue: 0,0:11:53.44,0:11:54.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Status siaga dicabut.
Dialogue: 0,0:11:59.33,0:12:01.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, kami ikut membantu dari belakang.
Dialogue: 0,0:12:03.17,0:12:06.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami hanya mengikuti arahanmu\Nuntuk menyelesaikannya dengan cepat.
Dialogue: 0,0:12:08.99,0:12:10.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan seenaknya ikut campur.
Dialogue: 0,0:12:11.04,0:12:13.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanpa bantuan kalian pun aku masih bisa!
Dialogue: 0,0:12:14.51,0:12:18.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata tanpa Lent, kalian tak bisa\Nbertarung dengan benar, ya.
Dialogue: 0,0:12:19.15,0:12:21.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kecewa dengan Pedang Pemecah Langit.
Dialogue: 0,0:12:22.06,0:12:24.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Reputasi bagus ternyata\Ntak bisa dijadikan patokan.
Dialogue: 0,0:12:24.62,0:12:26.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa katamu?!
Dialogue: 0,0:12:26.08,0:12:27.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, sakit.
Dialogue: 0,0:12:28.64,0:12:31.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serika, sembuhkan mereka\Ndengan sihir pemulihanmu.
Dialogue: 0,0:12:31.54,0:12:34.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Buang-buang daya sihir saja.
Dialogue: 0,0:12:34.91,0:12:37.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pakai seperlunya saja.
Dialogue: 0,0:12:39.11,0:12:40.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gila.
Dialogue: 0,0:12:40.16,0:12:42.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemampuan begitu disebut rank B?
Dialogue: 0,0:12:42.74,0:12:45.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya rumor itu memang benar.
Dialogue: 0,0:12:45.41,0:12:46.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rumor?
Dialogue: 0,0:12:46.75,0:12:48.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya, karena suatu "kutukan",
Dialogue: 0,0:12:48.54,0:12:51.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mereka jadi tak bisa menggunakan skill lagi.
Dialogue: 0,0:12:51.50,0:12:54.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kalau memang mereka rank B,
Dialogue: 0,0:12:54.38,0:12:57.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}harusnya masih bisa bertarung\Nmeski tanpa skill, 'kan?
Dialogue: 0,0:12:57.41,0:12:59.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah, cepat berdiri.
Dialogue: 0,0:12:59.71,0:13:01.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita berangkat sebelum monster lain muncul.
Dialogue: 0,0:13:12.05,0:13:14.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka parah sekali.
Dialogue: 0,0:13:14.85,0:13:16.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memalukan.
Dialogue: 0,0:13:25.70,0:13:27.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, kalau dipikir-pikir,
Dialogue: 0,0:13:27.20,0:13:30.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau tak ada kutukan itu,\Nkita pasti bisa bertarung.
Dialogue: 0,0:13:30.00,0:13:31.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:13:31.60,0:13:34.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua ini gara-gara si bodoh itu!
Dialogue: 0,0:13:34.43,0:13:37.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ketemu, akan kubunuh dia!
Dialogue: 0,0:13:37.98,0:13:41.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awas saja kau, Lent!
Dialogue: 0,0:13:48.54,0:13:50.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bicara soal memeriksa daya sihir,
Dialogue: 0,0:13:50.85,0:13:55.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}para sampah itu sudah memeriksa\Ndaya sihir yang mereka pinjam atau belum, ya?
Dialogue: 0,0:13:55.86,0:13:57.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalaupun sudah mereka periksa,
Dialogue: 0,0:13:57.94,0:14:01.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku ragu mereka akan melunasinya.
Dialogue: 0,0:14:01.92,0:14:03.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh iya, Lent.
Dialogue: 0,0:14:04.05,0:14:06.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Barang yang kau pinjamkan semalam...
Dialogue: 0,0:14:09.50,0:14:13.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah dioleskan ke perlengkapanku,\Nsemuanya jadi terlihat baru.
Dialogue: 0,0:14:13.86,0:14:16.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah kalau ternyata berguna.
Dialogue: 0,0:14:16.26,0:14:17.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya!
Dialogue: 0,0:14:17.87,0:14:20.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harusnya sebentar lagi itu juga selesai!
Dialogue: 0,0:14:20.40,0:14:21.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Itu"?
Dialogue: 0,0:14:21.65,0:14:22.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, ikut aku saja.
Dialogue: 0,0:14:22.99,0:14:24.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Ba-Baik.
Dialogue: 0,0:14:30.53,0:14:31.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang...
Dialogue: 0,0:14:31.57,0:14:32.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, Lent!
Dialogue: 0,0:14:33.86,0:14:36.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Itu"-nya sudah jadi?
Dialogue: 0,0:14:36.02,0:14:39.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedang diselesaikan oleh Pak Tukang.
Dialogue: 0,0:14:39.86,0:14:42.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan, dia yang namanya Rinka?
Dialogue: 0,0:14:42.19,0:14:42.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:14:43.34,0:14:46.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rinka, dia adalah Gorou,\Nanak magang pandai besi.
Dialogue: 0,0:14:46.59,0:14:49.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia juga dari Desa Alto, sama sepertiku.
Dialogue: 0,0:14:55.83,0:14:59.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beberapa hari lalu, aku tak sengaja\Nketemu dia lagi setelah lima tahun.
Dialogue: 0,0:14:59.95,0:15:02.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kebetulan waktu itu lagi di kedai minum.
Dialogue: 0,0:15:02.82,0:15:04.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutmu dia lagi apa, coba?
Dialogue: 0,0:15:05.15,0:15:07.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bergumam sendirian
Dialogue: 0,0:15:07.22,0:15:09.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sambil latihan ciuman.
Dialogue: 0,0:15:10.27,0:15:12.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harusnya sekarang "itu" sudah selesai, 'kan?
Dialogue: 0,0:15:12.91,0:15:14.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Sudah, hentikan!\N- Dia benar-benar gila.
Dialogue: 0,0:15:14.90,0:15:16.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf menunggu.
Dialogue: 0,0:15:20.08,0:15:21.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini...
Dialogue: 0,0:15:24.98,0:15:27.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedangmu rusak, 'kan?
Dialogue: 0,0:15:27.94,0:15:28.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu,
Dialogue: 0,0:15:28.77,0:15:32.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku memintanya untuk menempa senjata\NQuad Skeleton yang kita bawa pulang.
Dialogue: 0,0:15:34.45,0:15:37.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senjata itu benar-benar sangat bagus.
Dialogue: 0,0:15:37.79,0:15:40.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi puas menempanya.
Dialogue: 0,0:15:45.28,0:15:46.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana?
Dialogue: 0,0:15:47.46,0:15:49.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya ini bisa membelah apa pun.
Dialogue: 0,0:15:49.66,0:15:51.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi ingin segera mencobanya.
Dialogue: 0,0:15:52.56,0:15:56.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh, terima kasih karena kalian\Nsudah melakukan ini untukku.
Dialogue: 0,0:15:57.65,0:15:59.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah dengar dari Lent.
Dialogue: 0,0:15:59.42,0:16:03.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya, kau menderita\Nkarena Gift-mu sendiri.
Dialogue: 0,0:16:06.45,0:16:11.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sendiri juga awalnya\Ntidak suka Gift Pandai Besi ini.
Dialogue: 0,0:16:11.62,0:16:16.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi sekarang, menurutku tak ada Gift lain\Nyang lebih seru dan memuaskan daripada ini.
Dialogue: 0,0:16:17.42,0:16:18.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu...
Dialogue: 0,0:16:18.78,0:16:23.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin, suatu hari kau juga pasti\Nakan menyukai Gift-mu sendiri.
Dialogue: 0,0:16:25.86,0:16:27.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:16:28.61,0:16:30.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:16:30.19,0:16:31.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:16:31.10,0:16:32.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Datang lagi, ya.
Dialogue: 0,0:16:32.48,0:16:33.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:16:36.14,0:16:37.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa cuma perasaanku?
Dialogue: 0,0:16:38.30,0:16:42.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi, sesaat aku merasakan\Nhawa membunuh darinya.
Dialogue: 0,0:16:48.13,0:16:51.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, akan aku jelaskan\Nkembali kemampuanku.
Dialogue: 0,0:16:52.37,0:16:55.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skill yang aku gunakan\Nadalah Tebasan Pertama.
Dialogue: 0,0:16:55.78,0:16:58.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa memperkuat diri\Nmenggunakan daya sihir.
Dialogue: 0,0:16:59.49,0:17:02.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu diaktifkan,\Nskill ini tak bisa dihentikan
Dialogue: 0,0:17:02.40,0:17:05.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sampai daya sihir habis\Natau monster yang kulawan kalah.
Dialogue: 0,0:17:06.35,0:17:08.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengaktifkannya butuh 7 daya sihir.
Dialogue: 0,0:17:09.35,0:17:13.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu berkurang 1 setiap 10 detik.
Dialogue: 0,0:17:15.26,0:17:16.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun,
Dialogue: 0,0:17:16.30,0:17:19.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena jumlah daya sihirku hanya 10,
Dialogue: 0,0:17:20.64,0:17:22.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}efeknya hanya bisa bertahan 40 detik.
Dialogue: 0,0:17:25.83,0:17:28.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kalau daya sihirnya tidak habis-habis,
Dialogue: 0,0:17:28.91,0:17:32.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berarti efek penguat skill-mu\Nbisa terus aktif, 'kan?
Dialogue: 0,0:17:32.72,0:17:33.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:17:33.81,0:17:35.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agar hal itu bisa dilakukan,
Dialogue: 0,0:17:35.81,0:17:38.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita pakai skill milikku,\NPeminjaman Daya Sihir,
Dialogue: 0,0:17:38.05,0:17:40.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan skill yang baru kupelajari,\Nyaitu Auto Charge.
Dialogue: 0,0:17:41.58,0:17:43.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa benar-benar bisa dilakukan?
Dialogue: 0,0:17:50.54,0:17:51.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terompet Goblin?
Dialogue: 0,0:17:52.85,0:17:55.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya kita ketahuan penjaga mereka.
Dialogue: 0,0:17:55.78,0:17:57.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, bukankah bagus?
Dialogue: 0,0:17:58.46,0:17:59.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:17:59.57,0:18:02.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita langsung coba dengan\NPeminjaman Daya Sihir-ku.
Dialogue: 0,0:18:02.56,0:18:03.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?!
Dialogue: 0,0:18:04.16,0:18:05.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja.
Dialogue: 0,0:18:05.55,0:18:06.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Percayalah padaku...
Dialogue: 0,0:18:06.85,0:18:09.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, percayalah pada dirimu sendiri.
Dialogue: 0,0:18:10.90,0:18:11.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:18:12.96,0:18:13.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka datang.
Dialogue: 0,0:18:24.43,0:18:26.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tebasan pertama adalah tebasan terakhir.
Dialogue: 0,0:18:27.47,0:18:30.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di tempat pertarungan pedang\Nterbentang sebuah neraka.
Dialogue: 0,0:18:31.52,0:18:33.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maju satu langkah,
Dialogue: 0,0:18:33.82,0:18:35.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jalan Bertarung Asura!
Dialogue: 0,0:18:36.58,0:18:38.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekaranglah waktunya, Tuan Master!
Dialogue: 0,0:18:38.46,0:18:39.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:18:39.68,0:18:41.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Auto Charge!
Dialogue: 0,0:19:15.88,0:19:18.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi ini... Tebasan Pertama.
Dialogue: 0,0:19:37.04,0:19:39.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gift miliknya memang bukan main.
Dialogue: 0,0:19:40.58,0:19:42.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Efek penguatannya benar-benar berbeda.
Dialogue: 0,0:19:42.82,0:19:46.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu-satunya kelemahan mungkin\Nkonsumsi daya sihirnya yang boros.
Dialogue: 0,0:19:46.88,0:19:51.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pantas saja party biasa tak bisa\Nmengeluarkan potensi kekuatannya.
Dialogue: 0,0:19:52.84,0:19:53.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi!
Dialogue: 0,0:19:54.19,0:19:56.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penilaianku memang tidak salah!
Dialogue: 0,0:19:56.75,0:20:00.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peminjaman 1 daya sihir setiap 10 detik!
Dialogue: 0,0:20:00.13,0:20:04.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tergantung perkembangannya nanti,\Npinjaman ini bisa jadi untung besar!
Dialogue: 0,0:20:06.98,0:20:08.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu...
Dialogue: 0,0:20:09.46,0:20:12.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari yang kulihat,\Ndaripada disebut penguatan,
Dialogue: 0,0:20:12.48,0:20:13.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}rasanya seperti...
Dialogue: 0,0:20:13.98,0:20:14.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}orang yang berbeda.
Dialogue: 0,0:20:49.30,0:20:50.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luar biasa.
Dialogue: 0,0:20:51.28,0:20:53.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dapat batu sihir!
Dialogue: 0,0:20:55.57,0:20:56.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau luar biasa, Rinka!
Dialogue: 0,0:20:57.31,0:21:00.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa mengalahkan banyak goblin\Nhanya dalam beberapa menit!
Dialogue: 0,0:21:00.78,0:21:02.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gift Unikmu memang luar biasa...
Dialogue: 0,0:21:13.47,0:21:14.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rinka?!
