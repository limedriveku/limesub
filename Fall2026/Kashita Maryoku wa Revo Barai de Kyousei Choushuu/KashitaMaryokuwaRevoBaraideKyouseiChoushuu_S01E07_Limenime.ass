Dialogue: 0,0:02:23.58,0:02:24.42,sign,,0000,0000,0000,,EPISODE 7: REUNI
Dialogue: 0,0:02:44.81,0:02:47.77,sign,,0000,0000,0000,,"DAYA SIHIR: 10/10"
Dialogue: 0,0:02:47.77,0:02:51.28,sign,,0000,0000,0000,,"DAYA SIHIR: 14/14"
Dialogue: 0,0:04:21.07,0:04:24.91,sign,,0000,0000,0000,,DUNGEON AGUNG MELBA,\NLANTAI DELAPAN: PEGUNUNGAN WYVERN
Dialogue: 0,0:05:51.75,0:05:53.67,sign,,0000,0000,0000,,SKILL: WAR CRY\NBERTERIAK UNTUK MENARIK PERHATIAN MUSUH
Dialogue: 0,0:14:53.29,0:14:55.01,sign,,0000,0000,0000,,DUA TAHUN LALU
Dialogue: 0,0:17:39.00,0:17:40.23,sign,,0000,0000,0000,,MELBIAN DOG,\NBAGIAN DALAM: SOSIS DAGING SAPI LIAR
Dialogue: 0,0:17:40.23,0:17:41.46,sign,,0000,0000,0000,,BAGIAN LUAR: ADONAN\NTEPUNG YANG DIGORENG
Dialogue: 0,0:18:06.11,0:18:06.79,sign,,0000,0000,0000,,RINKA, 18 TAHUN
Dialogue: 0,0:18:06.80,0:18:10.69,sign,,0000,0000,0000,,"JALAN BERTARUNG ASURA (SSS)"
Dialogue: 0,0:18:12.11,0:18:13.31,sign,,0000,0000,0000,,PETUALANG: E, PARTY: DUA ANOMALI
Dialogue: 0,0:00:05.74,0:00:07.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau luar biasa, Rinka!
Dialogue: 0,0:00:07.52,0:00:10.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa mengalahkan banyak goblin\Nhanya dalam beberapa menit!
Dialogue: 0,0:00:10.96,0:00:12.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gift Unikmu memang luar biasa...
Dialogue: 0,0:00:19.54,0:00:20.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rinka?!
Dialogue: 0,0:00:22.54,0:00:23.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lent?
Dialogue: 0,0:00:25.76,0:00:27.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku.
Dialogue: 0,0:00:27.14,0:00:30.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku terbawa suasana.
Dialogue: 0,0:00:30.56,0:00:33.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya, ini pertama kalinya skill-ku
Dialogue: 0,0:00:33.98,0:00:36.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa bertahan selama ini.
Dialogue: 0,0:00:36.90,0:00:38.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rinka.
Dialogue: 0,0:00:39.73,0:00:41.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, maaf!
Dialogue: 0,0:00:41.36,0:00:43.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Polos sekali, ya,
Dialogue: 0,0:00:44.02,0:00:45.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalian ini.
Dialogue: 0,0:01:00.43,0:01:03.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daya Sihir yang Dipinjam\NAkan Ditagih Paksa dengan Sistem Cicilan
Dialogue: 0,0:02:17.30,0:02:20.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Batu sihir goblin semuanya ada 1.043 buah.
Dialogue: 0,0:02:21.00,0:02:23.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nilainya jadi 104.300 gold.
Dialogue: 0,0:02:24.43,0:02:28.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Batu sihir Goblin Leader ada 18,\Njadi nilainya 9.000 gold.
Dialogue: 0,0:02:28.26,0:02:33.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Goblin Seed dari penaklukan koloni goblin\Nada 18 buah, jadi nilainya 36.000 gold.
Dialogue: 0,0:02:33.54,0:02:35.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini total bayarannya.
Dialogue: 0,0:02:35.63,0:02:37.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gila, kau lagi?
Dialogue: 0,0:02:37.94,0:02:40.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini, dialah yang melakukannya.
Dialogue: 0,0:02:42.74,0:02:44.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat, Lent!
Dialogue: 0,0:02:44.81,0:02:47.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ju-Jumlah maksimum daya sihirku...
Dialogue: 0,0:02:47.77,0:02:51.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hanya dalam sehari bertambah empat!
Dialogue: 0,0:02:51.65,0:02:52.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat.
Dialogue: 0,0:02:53.60,0:02:55.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal selama tiga tahun menjadi petualang,
Dialogue: 0,0:02:55.98,0:02:58.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jumlahnya hanya bertambah dua.
Dialogue: 0,0:02:59.44,0:03:01.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua ini berkatmu, Lent.
Dialogue: 0,0:03:02.22,0:03:03.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:03:03.90,0:03:06.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya memberikan dukungan.
Dialogue: 0,0:03:06.13,0:03:08.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya berkat kemampuanmu, kok.
Dialogue: 0,0:03:08.17,0:03:12.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku masih belum percaya\Ndengan apa yang telah terjadi.
Dialogue: 0,0:03:12.77,0:03:14.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau itu benar-benar kuat.
Dialogue: 0,0:03:15.09,0:03:16.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banggalah pada dirimu sendiri.
Dialogue: 0,0:03:17.14,0:03:18.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lent.
Dialogue: 0,0:03:18.37,0:03:21.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo, halo, maaf mengganggu.
Dialogue: 0,0:03:21.54,0:03:25.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin mengumumkan jumlah\Npinjaman daya sihir Rinka.
Dialogue: 0,0:03:25.73,0:03:28.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena skill-nya diaktifkan 18 kali,
Dialogue: 0,0:03:28.81,0:03:31.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jumlahnya jadi 126 daya sihir.
Dialogue: 0,0:03:31.12,0:03:34.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Durasi aktivasinya 1 jam 21 menit 40 detik.
Dialogue: 0,0:03:34.74,0:03:37.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena diambil 1 daya sihir per 10 detik,
Dialogue: 0,0:03:38.45,0:03:42.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}totalnya jadi 616 daya sihir.
Dialogue: 0,0:03:42.78,0:03:46.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menjadi lebih kuat\Ndan mengembalikannya dengan benar!
Dialogue: 0,0:03:46.67,0:03:50.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, bunganya 10%\Ndan tidak ada batas waktunya.
Dialogue: 0,0:03:51.50,0:03:52.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:03:52.46,0:03:54.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dipikir-pikir,\Nrasanya sudah lama sekali
Dialogue: 0,0:03:55.09,0:03:57.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sejak kekuatanku dihargai seperti ini.
Dialogue: 0,0:03:57.78,0:03:59.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skill-ku naik level!
Dialogue: 0,0:03:59.86,0:04:01.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini berkat Lent.
Dialogue: 0,0:04:01.55,0:04:02.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Terima kasih.\N- Terima kasih, ya.
Dialogue: 0,0:04:03.44,0:04:05.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan gagal lagi.
Dialogue: 0,0:04:05.68,0:04:07.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kali ini, kami pasti akan menjadi kuat!
Dialogue: 0,0:04:07.84,0:04:09.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Master!
Dialogue: 0,0:04:09.66,0:04:13.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo makan yang enak-enak\Nuntuk merayakan terbentuknya party kita.
Dialogue: 0,0:04:13.86,0:04:15.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:04:15.01,0:04:16.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rinka, kau mau makan apa?
Dialogue: 0,0:04:16.37,0:04:17.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau daging!
Dialogue: 0,0:04:17.70,0:04:19.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Aku suka banget daging!\N- Makanan tepung juga enak, lo.
Dialogue: 0,0:04:31.92,0:04:33.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia datang, Jin.
Dialogue: 0,0:04:33.36,0:04:34.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aegis!
Dialogue: 0,0:04:42.51,0:04:44.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begini takkan ada habisnya.
Dialogue: 0,0:04:44.68,0:04:46.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya sudah, kita jatuhkan saja dia.
Dialogue: 0,0:04:47.10,0:04:48.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namilia!
Dialogue: 0,0:04:48.18,0:04:49.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke.
Dialogue: 0,0:04:53.41,0:04:55.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Physical Boost!
Dialogue: 0,0:04:59.87,0:05:00.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasakan!
Dialogue: 0,0:05:05.82,0:05:06.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tombak Penembus Langit!
Dialogue: 0,0:05:11.00,0:05:12.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jatuhlah!
Dialogue: 0,0:05:12.19,0:05:14.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Comet Strike!
Dialogue: 0,0:05:26.14,0:05:28.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang di daratan, kurasa?
Dialogue: 0,0:05:28.24,0:05:30.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, kita sambut dengan kekuatan penuh.
Dialogue: 0,0:05:33.84,0:05:35.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Speed Boost!
Dialogue: 0,0:05:55.98,0:05:57.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Block Guard!
Dialogue: 0,0:06:00.85,0:06:02.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tusukan Beruntun!
Dialogue: 0,0:06:05.68,0:06:07.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Comet, empaskan aku.
Dialogue: 0,0:06:08.19,0:06:09.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Whirlwind.
Dialogue: 0,0:06:14.43,0:06:15.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skill Boost!
Dialogue: 0,0:06:20.02,0:06:21.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tebasan Dahsyat!
Dialogue: 0,0:06:33.12,0:06:35.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gede, berat pula.
Dialogue: 0,0:06:35.23,0:06:38.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melepas satu saja sudah susah payah.
Dialogue: 0,0:06:38.02,0:06:41.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misinya butuh 30 lembar sisik ini.
Dialogue: 0,0:06:41.42,0:06:42.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}30?
Dialogue: 0,0:06:42.78,0:06:44.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Repot juga.
Dialogue: 0,0:06:44.78,0:06:48.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata mengumpulkan material\Nlebih melelahkan daripada mengalahkan wyvern.
Dialogue: 0,0:06:51.74,0:06:52.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kembali.
Dialogue: 0,0:06:53.68,0:06:56.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Roger? Dari mana saja kau?
Dialogue: 0,0:06:56.48,0:06:57.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini.
Dialogue: 0,0:06:57.94,0:07:00.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bawakan hati wyvern.
Dialogue: 0,0:07:00.40,0:07:03.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, kau masuk ke dalam tubuh wyvern?
Dialogue: 0,0:07:04.21,0:07:08.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, hampir saja aku larut\Noleh asam lambungnya.
Dialogue: 0,0:07:08.24,0:07:09.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar bodoh!
Dialogue: 0,0:07:09.50,0:07:12.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang berkali-kali\Njangan lakukan hal berbahaya!
Dialogue: 0,0:07:12.46,0:07:13.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, maaf.
Dialogue: 0,0:07:20.98,0:07:23.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu parasit dalam tubuh wyvern.
Dialogue: 0,0:07:23.76,0:07:27.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, tolong lakukan sesuatu.
Dialogue: 0,0:07:27.50,0:07:29.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tidak.\N- Jangan bersuara aneh, Namilia!
Dialogue: 0,0:07:29.60,0:07:31.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu kau, Comet!\NKatakanlah sesuatu!
Dialogue: 0,0:07:32.77,0:07:33.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya ampun.
Dialogue: 0,0:07:38.34,0:07:39.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?!
Dialogue: 0,0:07:39.78,0:07:42.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makan bersama anggota Gugus Meteor?
Dialogue: 0,0:07:42.57,0:07:45.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu sampai kaget begitu.
Dialogue: 0,0:07:45.89,0:07:47.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:07:47.82,0:07:50.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu itu aku diajak oleh Roger.
Dialogue: 0,0:07:50.54,0:07:54.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mumpung ada kesempatan,\Naku ingin mengajakmu.
Dialogue: 0,0:07:54.33,0:07:58.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, tidak!\NAku hanya petualang rank F yang lemah!
Dialogue: 0,0:07:58.27,0:07:59.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bahkan tak pantas duduk bersama!
Dialogue: 0,0:07:59.73,0:08:02.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Geleng-geleng begitu lehermu bisa putus, lo.
Dialogue: 0,0:08:03.04,0:08:07.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, Lent, ternyata\Nkau kenal party Gugus Meteor, ya?
Dialogue: 0,0:08:07.33,0:08:08.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:08:08.98,0:08:13.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dulu, saat Pedang Pemecah Langit\Nmenarik perhatian banyak orang,
Dialogue: 0,0:08:13.06,0:08:15.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami beberapa kali minum bersama.
Dialogue: 0,0:08:17.10,0:08:18.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:08:18.80,0:08:23.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga ingin memperkenalkanmu,\Nrekan party baruku.
Dialogue: 0,0:08:25.87,0:08:28.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, sebaiknya aku tidak usah saja.
Dialogue: 0,0:08:29.28,0:08:32.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak ingin mengganggu reuni kalian.
Dialogue: 0,0:08:33.10,0:08:33.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:08:34.58,0:08:38.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lent, nikmati malam ini\Nsekalian untuk bagianku juga!
Dialogue: 0,0:08:46.78,0:08:50.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah lama sekali aku tidak minum\Nbersama Roger lagi.
Dialogue: 0,0:08:50.22,0:08:52.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak sabar, tapi rasanya sangat gugup.
Dialogue: 0,0:08:53.70,0:08:55.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, aku telat.
Dialogue: 0,0:08:58.83,0:09:00.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namilia?
Dialogue: 0,0:09:00.45,0:09:03.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, bukankah kau baru pulang bertualang?
Dialogue: 0,0:09:03.15,0:09:06.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya mau minum-minum bareng Lent.
Dialogue: 0,0:09:06.13,0:09:08.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sampai berdandan cantik dulu.
Dialogue: 0,0:09:10.88,0:09:13.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana penampilanku?
Dialogue: 0,0:09:14.41,0:09:18.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Me-Menurutku sangat menawan.
Dialogue: 0,0:09:19.18,0:09:22.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau ini! Lihat yang benar, dong!
Dialogue: 0,0:09:23.22,0:09:25.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai merah begini.
Dialogue: 0,0:09:25.94,0:09:28.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti biasa, kau ini menggemaskan.
Dialogue: 0,0:09:28.42,0:09:30.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei!
Dialogue: 0,0:09:31.58,0:09:35.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa penampilanmu kayak\Norang bodoh begitu?!
Dialogue: 0,0:09:35.04,0:09:38.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jahat banget!\NPadahal ini pakaian terbaikku.
Dialogue: 0,0:09:38.26,0:09:41.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei! Mukanya Lent sampai pucat begitu!
Dialogue: 0,0:09:42.51,0:09:44.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersulang!
Dialogue: 0,0:09:48.27,0:09:49.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tambah ale satu lagi!
Dialogue: 0,0:09:49.68,0:09:50.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga.
Dialogue: 0,0:09:50.99,0:09:53.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, ale dua gelas!
Dialogue: 0,0:09:53.20,0:09:56.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ikut-ikutan mereka,\Naku pasti bakal tumbang.
Dialogue: 0,0:09:58.13,0:09:59.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, terima kasih.
Dialogue: 0,0:10:06.51,0:10:10.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lent, aku sudah mendengar berbagai rumor\Ntentang Pedang Pemecah Langit.
Dialogue: 0,0:10:10.63,0:10:12.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kabarnya kau diusir, ya.
Dialogue: 0,0:10:14.53,0:10:16.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti berat, ya.
Dialogue: 0,0:10:17.98,0:10:21.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, padahal sedang minum-minum begini.
Dialogue: 0,0:10:22.66,0:10:24.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kejam sekali.
Dialogue: 0,0:10:24.98,0:10:27.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengusir rekan yang sudah\Nbersama selama lima tahun.
Dialogue: 0,0:10:27.81,0:10:32.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belakangan orang-orang bodoh itu\Nkabarnya sedang tidak bagus.
Dialogue: 0,0:10:32.30,0:10:35.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin mengusirmu adalah\Nawal kehancuran mereka.
Dialogue: 0,0:10:35.79,0:10:39.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skill milikmu itu\Nmeminjamkan daya sihir, 'kan?
Dialogue: 0,0:10:39.74,0:10:43.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya mereka lupa kalau dulu\Nsudah bergantung padamu.
Dialogue: 0,0:10:44.27,0:10:47.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apalagi mereka party yang naik\Nke rank B dengan cepat.
Dialogue: 0,0:10:47.67,0:10:50.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, tidak heran kalau sampai besar kepala.
Dialogue: 0,0:10:50.61,0:10:54.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dipikir-pikir, mungkin akulah\Nyang bergantung pada mereka.
Dialogue: 0,0:10:55.54,0:10:59.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama bisa menggunakan skill di belakang,\Naku bisa bertualang ke mana pun.
Dialogue: 0,0:10:59.62,0:11:03.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanpa harus membuka jalan\Ndengan usaha sendiri.
Dialogue: 0,0:11:04.10,0:11:06.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya aku dibuang.
Dialogue: 0,0:11:06.80,0:11:09.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang dulu benar-benar tidak berguna.
Dialogue: 0,0:11:10.78,0:11:13.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lent, kau sudah makin kuat.
Dialogue: 0,0:11:13.66,0:11:14.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:11:15.03,0:11:16.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, sangat.
Dialogue: 0,0:11:17.39,0:11:21.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku tidak setuju kalau dulu\Nkau tidak berguna.
Dialogue: 0,0:11:23.58,0:11:27.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau ingat saat pertama kali kita bertemu?
Dialogue: 0,0:11:27.37,0:11:28.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:11:28.45,0:11:33.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tak salah, sebelum kau\Nbergabung dengan Gugus Meteor.
Dialogue: 0,0:11:33.57,0:11:34.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:11:34.88,0:11:38.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kebetulan kedai guild-nya\Nsedang ramai seperti ini.
Dialogue: 0,0:11:39.06,0:11:43.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, hari itu aku baru keluar\Ndari party karena kecewa.
Dialogue: 0,0:11:44.18,0:11:47.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah muak karena mereka\Nterus-menerus menghambat kemajuanku.
Dialogue: 0,0:11:47.76,0:11:49.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, saat mau minum-minum\Nuntuk melepas penat...
Dialogue: 0,0:11:51.06,0:11:52.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kursi ini kosong?
Dialogue: 0,0:11:52.66,0:11:53.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kosong, kok.
Dialogue: 0,0:11:55.26,0:11:57.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Namilia, siapa namamu?
Dialogue: 0,0:11:57.89,0:11:58.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Lent.
Dialogue: 0,0:11:59.33,0:12:02.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baru kembali dari bertualang,\Nkau sendiri?
Dialogue: 0,0:12:02.62,0:12:03.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga.
Dialogue: 0,0:12:04.18,0:12:05.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh?
Dialogue: 0,0:12:05.33,0:12:08.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dilihat-lihat,\Nkau seperti tidak bisa bertarung.
Dialogue: 0,0:12:09.22,0:12:12.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, soalnya aku kelas pendukung.
Dialogue: 0,0:12:13.10,0:12:15.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus kau memanfaatkan rekan-rekanmu, begitu?
Dialogue: 0,0:12:16.37,0:12:18.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga kelas pendukung,
Dialogue: 0,0:12:18.34,0:12:20.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi tetap berusaha keras\Nuntuk menjadi lebih kuat.
Dialogue: 0,0:12:21.41,0:12:23.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau tak punya keinginan seperti itu?
Dialogue: 0,0:12:24.38,0:12:27.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja,\Nakan lebih bagus kalau aku juga kuat.
Dialogue: 0,0:12:28.46,0:12:31.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skill-ku bisa membuat\Nrekan-rekanku menjadi lebih kuat.
Dialogue: 0,0:12:31.06,0:12:35.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, daripada memperkuat diriku,\Naku ingin membantu mereka menjadi kuat.
Dialogue: 0,0:12:35.73,0:12:37.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena memberikan dukungan adalah tugasku.
Dialogue: 0,0:12:41.74,0:12:45.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alasan kenapa party-ku tidak berjalan lancar
Dialogue: 0,0:12:45.06,0:12:47.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ternyata bukan karena rekan-rekanku,
Dialogue: 0,0:12:47.90,0:12:51.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi karena aku pakai sihir penguatan\Ndemi kepentinganku sendiri.
Dialogue: 0,0:12:52.00,0:12:54.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan kata-kata itulah yang menyadarkanku.
Dialogue: 0,0:12:55.41,0:12:56.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, Lent,
Dialogue: 0,0:12:56.91,0:12:59.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jangan bilang kalau\Ndulunya kau tidak berguna.
Dialogue: 0,0:13:00.21,0:13:01.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:13:02.56,0:13:05.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dibandingkan denganmu\Nyang sudah bisa diandalkan,
Dialogue: 0,0:13:05.90,0:13:08.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ketua kami malah berperilaku\Nseperti anak-anak.
Dialogue: 0,0:13:08.68,0:13:09.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudmu aku?!
Dialogue: 0,0:13:10.16,0:13:13.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu mengalahkan wyvern juga begitu.
Dialogue: 0,0:13:13.02,0:13:14.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wyvern?!
Dialogue: 0,0:13:14.50,0:13:17.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah itu monster\Nyang muncul di lantai delapan?
Dialogue: 0,0:13:17.84,0:13:20.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami memang sedang\Nmenaklukkan lantai delapan.
Dialogue: 0,0:13:21.24,0:13:23.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}He-Hebat.
Dialogue: 0,0:13:23.36,0:13:26.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal itu area tempat\Nnaga-naga kuat bermunculan.
Dialogue: 0,0:13:26.49,0:13:29.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kadal-kadal seperti itu\N- Roger dan Namilia
Dialogue: 0,0:13:29.37,0:13:30.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- tidak ada apa-apanya di hadapanku.\N- adalah petualang yang sudah
Dialogue: 0,0:13:30.70,0:13:32.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}melangkah jauh di depanku.
Dialogue: 0,0:13:32.03,0:13:33.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Terus, saat mengumpulkan material\N- Tapi mereka mau menceritakan
Dialogue: 0,0:13:33.52,0:13:35.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- setelah mengalahkan wyvern,\N- kisah mereka padaku yang seperti ini.
Dialogue: 0,0:13:35.49,0:13:37.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- si Roger malah bikin kekacauan.\N- Rasanya seperti seorang teman.
Dialogue: 0,0:13:37.87,0:13:41.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, aku juga ingin menjadi\Npetualang seperti mereka.
Dialogue: 0,0:13:41.89,0:13:46.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang jelas, berikutnya kami ingin\Nmenuntaskan penaklukan lantai delapan.
Dialogue: 0,0:13:46.89,0:13:48.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu artinya...
Dialogue: 0,0:13:49.23,0:13:53.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang kami tuju adalah\Nlantai terdalam Dungeon Agung Melba.
Dialogue: 0,0:13:53.46,0:13:55.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lantai terdalam.
Dialogue: 0,0:13:55.07,0:13:58.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pencapaian tertinggi yang menjadi\Ntujuan banyak petualang.
Dialogue: 0,0:13:58.28,0:14:01.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong,\NDungeon Agung itu ada berapa lantai?
Dialogue: 0,0:14:01.97,0:14:04.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pastinya, aku juga tidak tahu.
Dialogue: 0,0:14:04.78,0:14:08.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, kita saja yang mengungkap\Nseluruh misteri Dungeon Agung itu!
Dialogue: 0,0:14:09.31,0:14:12.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh iya, aku juga ingin menyampaikan sesuatu.
Dialogue: 0,0:14:14.43,0:14:16.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau membuat party baru?
Dialogue: 0,0:14:16.58,0:14:17.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:14:17.50,0:14:18.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh?
Dialogue: 0,0:14:18.62,0:14:22.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku membentuk party bersama Rinka,\Norang yang sama-sama dibuang sepertiku.
Dialogue: 0,0:14:22.75,0:14:24.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wanita yang waktu itu, ya.
Dialogue: 0,0:14:27.14,0:14:28.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu artinya...
Dialogue: 0,0:14:29.78,0:14:31.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang kita rival, ya.
Dialogue: 0,0:14:32.50,0:14:33.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:14:33.73,0:14:35.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekali lagi, mohon kerja samanya.
Dialogue: 0,0:14:37.38,0:14:39.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak, Roger.
Dialogue: 0,0:14:39.65,0:14:40.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:14:41.44,0:14:45.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, ujung-ujungnya kita keduluan, ya.
Dialogue: 0,0:14:45.12,0:14:46.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bodoh.
Dialogue: 0,0:14:46.10,0:14:48.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana bisa kita bilang sesuatu seperti:
Dialogue: 0,0:14:48.77,0:14:51.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Mau gabung Gugus Meteor?"\Nke orang yang baru buat party?
Dialogue: 0,0:14:52.22,0:14:53.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu...
Dialogue: 0,0:14:55.07,0:14:57.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya kami akan meninggalkan tempat ini.
Dialogue: 0,0:14:57.89,0:15:02.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami akan kembali setelah dapat kekuatan\Nuntuk menaklukkan lantai delapan.
Dialogue: 0,0:15:02.58,0:15:04.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayang sekali akan terasa sepi di sini.
Dialogue: 0,0:15:07.97,0:15:09.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu,\Naku ingin menyampaikan sesuatu padamu.
Dialogue: 0,0:15:10.22,0:15:11.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:15:11.82,0:15:13.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau mau bergabung dengan Gugus Meteor?
Dialogue: 0,0:15:13.86,0:15:15.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, aku?
Dialogue: 0,0:15:16.34,0:15:20.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh tawaran yang berarti\Ndan sangat berharga untukku.
Dialogue: 0,0:15:20.61,0:15:25.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, aku memiliki rekan-rekan yang selalu\Nbersamaku sejak pertama kali bertualang.
Dialogue: 0,0:15:25.90,0:15:30.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mungkin mengabaikan mereka\Ndan bergabung dengan party lain.
Dialogue: 0,0:15:34.08,0:15:36.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal diperlakukan buruk,
Dialogue: 0,0:15:36.13,0:15:39.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia orang yang tak bisa\Nmeninggalkan Pedang Pemecah Langit.
Dialogue: 0,0:15:39.71,0:15:41.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi percuma saja mengajaknya.
Dialogue: 0,0:15:41.94,0:15:46.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, ajak saja sekalian dia\Ndan wanita yang baru bergabung itu.
Dialogue: 0,0:15:47.31,0:15:51.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dulu aku punya teman minum\Nyang kerjanya meminjamkan uang.
Dialogue: 0,0:15:52.24,0:15:56.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tak percaya siapa pun dan meraup\Nkeuntungan dengan bunga tinggi.
Dialogue: 0,0:15:56.96,0:15:59.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, dia dibenci banyak orang.
Dialogue: 0,0:16:00.14,0:16:03.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada akhirnya, dia dibunuh entah oleh siapa.
Dialogue: 0,0:16:04.24,0:16:06.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gift milik Lent juga meminjamkan daya sihir.
Dialogue: 0,0:16:06.74,0:16:10.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin ada yang lebih\Nmembutuhkannya daripada uang.
Dialogue: 0,0:16:11.01,0:16:13.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku khawatir pengalamannya diusir\Nmembuatnya tak percaya pada orang lain,
Dialogue: 0,0:16:13.86,0:16:17.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan mengulangi kesalahan yang sama.
Dialogue: 0,0:16:18.45,0:16:20.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia juga sudah punya rekan baru.
Dialogue: 0,0:16:21.02,0:16:22.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pasti sudah baik-baik saja.
Dialogue: 0,0:16:22.94,0:16:24.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya, kalau kita ajak...
Dialogue: 0,0:16:24.55,0:16:25.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo?
Dialogue: 0,0:16:26.75,0:16:30.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Lent, bagaimana kalau setelah ini\Nkita minum lagi berdua?
Dialogue: 0,0:16:30.09,0:16:33.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Rinka sudah menungguku di penginapan.
Dialogue: 0,0:16:33.68,0:16:36.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau pulang terlalu malam,\Nnanti dia khawatir.
Dialogue: 0,0:16:36.99,0:16:41.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo? Sekarang kau tertarik dengan Rinka?
Dialogue: 0,0:16:41.19,0:16:42.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan begitu.
Dialogue: 0,0:16:42.14,0:16:44.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami hanya rekan, tidak lebih dari itu.
Dialogue: 0,0:16:46.85,0:16:50.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekadar main-main pun aku tidak keberatan.
Dialogue: 0,0:16:50.78,0:16:52.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan mempermainkan Lent!
Dialogue: 0,0:16:53.28,0:16:54.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apaan, sih?
Dialogue: 0,0:16:54.32,0:16:57.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma minta Lent menemaniku minum lagi.
Dialogue: 0,0:16:57.76,0:17:00.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh iya, Lent, kenapa kau di sini?
Dialogue: 0,0:17:00.62,0:17:03.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa penginapan kita searah?
Dialogue: 0,0:17:04.83,0:17:08.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, aku ingin minta tolong\Npada kalian.
Dialogue: 0,0:17:10.16,0:17:12.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesuai perhitungan,
Dialogue: 0,0:17:12.80,0:17:15.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mereka datang setelah tiga minggu.
Dialogue: 0,0:17:15.35,0:17:19.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin sudah waktunya\Nmeminta Tuan Master membeli itu.
Dialogue: 0,0:17:19.56,0:17:19.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin sudah waktunya\Nmeminta Tuan Master membeli itu.\NAku sudah tahu semua informasi para pengutang
Dialogue: 0,0:17:19.64,0:17:23.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah tahu semua informasi para pengutang
Dialogue: 0,0:17:23.06,0:17:25.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di Yggdrasil ini.
Dialogue: 0,0:17:35.63,0:17:38.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gorengan tusuk ini rasanya enak.
Dialogue: 0,0:17:41.81,0:17:44.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya ini makanan khas guild di sini.
Dialogue: 0,0:17:44.96,0:17:47.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanan tepung yang sangat aku sukai.
Dialogue: 0,0:17:47.65,0:17:50.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah pakai Tebasan Pertama,\Naku jadi lapar sekali.
Dialogue: 0,0:17:50.90,0:17:52.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya aku bisa makan sebanyak apa pun.
Dialogue: 0,0:17:53.17,0:17:55.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, bagus.
Dialogue: 0,0:17:55.07,0:17:57.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makan banyak itu bagus untuk pertumbuhan.
Dialogue: 0,0:17:57.76,0:17:59.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau juga banyak makan, Empee.
Dialogue: 0,0:17:59.97,0:18:04.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh iya, Rinka, bukankah ada yang ingin\Nkau sampaikan pada Tuan Master?
Dialogue: 0,0:18:04.37,0:18:06.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, benar juga.
Dialogue: 0,0:18:06.80,0:18:10.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini, rank petualangku naik satu tingkat.
Dialogue: 0,0:18:10.69,0:18:12.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari F menjadi E.
Dialogue: 0,0:18:13.32,0:18:14.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat!
Dialogue: 0,0:18:14.48,0:18:17.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam empat hari kau sudah naik!
Dialogue: 0,0:18:17.28,0:18:18.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:18:18.02,0:18:21.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu,\Nmaksimum daya sihirku juga jadi 24.
Dialogue: 0,0:18:22.53,0:18:24.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gift yang selama ini aku benci
Dialogue: 0,0:18:24.82,0:18:28.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ternyata memberiku kepercayaan diri\Nuntuk bertualang.
Dialogue: 0,0:18:29.02,0:18:31.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua ini berkatmu, Lent.
Dialogue: 0,0:18:31.79,0:18:36.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebelumnya, aku juga berpikir\Nhal yang sama tentang Gift-ku.
Dialogue: 0,0:18:38.05,0:18:40.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, izinkan aku
Dialogue: 0,0:18:40.47,0:18:43.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}memberikan hadiah perayaan untukmu.
Dialogue: 0,0:18:43.20,0:18:44.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh?
Dialogue: 0,0:18:44.14,0:18:46.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang baru saja kau makan itu
Dialogue: 0,0:18:46.05,0:18:49.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah bagian renyah dari Melbian Dog.
Dialogue: 0,0:18:49.39,0:18:53.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagian terenaknya ada di sini.
Dialogue: 0,0:18:54.38,0:18:55.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagian yang tadi itu
Dialogue: 0,0:18:55.73,0:18:58.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak lebih dari sekadar hidangan pembuka!
Dialogue: 0,0:19:04.21,0:19:06.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harum dan enak!
Dialogue: 0,0:19:06.83,0:19:08.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, 'kan?
Dialogue: 0,0:19:17.50,0:19:18.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:19:18.76,0:19:21.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yo, Lent, akhirnya kutemukan juga kau.
Dialogue: 0,0:19:21.57,0:19:22.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada perlu apa?
Dialogue: 0,0:19:22.85,0:19:24.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah kalian sudah tak butuh aku lagi?
Dialogue: 0,0:19:24.98,0:19:27.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan pura-pura tidak tahu!
Dialogue: 0,0:19:29.12,0:19:32.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak saat itu, kau merampas daya sihir kami.
Dialogue: 0,0:19:32.93,0:19:35.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua itu ulahmu, 'kan?
Dialogue: 0,0:19:35.45,0:19:36.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Merampas?
Dialogue: 0,0:19:36.69,0:19:38.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah kalian sendiri yang merampasnya?
Dialogue: 0,0:19:38.57,0:19:39.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:19:39.52,0:19:41.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bukan memberikan daya sihir,
Dialogue: 0,0:19:41.98,0:19:43.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi meminjamkan.
Dialogue: 0,0:19:43.86,0:19:46.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalianlah yang tidak mengembalikannya.
Dialogue: 0,0:19:47.28,0:19:49.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya menagihnya dengan paksa.
Dialogue: 0,0:19:50.54,0:19:52.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurang ajar!
Dialogue: 0,0:19:53.22,0:19:54.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa kau?
Dialogue: 0,0:19:55.60,0:19:59.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku adalah orang\Nyang bertualang bersama Lent.
Dialogue: 0,0:19:59.50,0:20:01.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan tatapanmu itu?
Dialogue: 0,0:20:02.53,0:20:04.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bikin kesal saja.
Dialogue: 0,0:20:04.72,0:20:05.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan!
Dialogue: 0,0:20:05.60,0:20:07.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh? Kau cari masalah?
Dialogue: 0,0:20:08.75,0:20:11.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah, sudah, kalau mau berkelahi,\Nlakukanlah di luar.
Dialogue: 0,0:20:12.00,0:20:13.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau kan Roger?
Dialogue: 0,0:20:13.74,0:20:15.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waduh, waduh.
Dialogue: 0,0:20:15.76,0:20:17.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempat ini jadi berantakan.
Dialogue: 0,0:20:18.24,0:20:20.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanannya jadi mubazir.
Dialogue: 0,0:20:20.66,0:20:22.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, dengarkan kami dulu!
Dialogue: 0,0:20:22.77,0:20:26.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si bodoh ini mengganggu kami\Ndengan jurus aneh!
Dialogue: 0,0:20:26.88,0:20:28.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jurus aneh?
Dialogue: 0,0:20:28.04,0:20:30.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia merampas daya sihir kami!
Dialogue: 0,0:20:30.61,0:20:34.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia berniat balas dendam\Nkarena diusir dari party!
Dialogue: 0,0:20:34.67,0:20:37.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tak salah, dulu kalian\Nmeminjam daya sihir dari Lent,
Dialogue: 0,0:20:37.63,0:20:40.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan bertualang dengan kekuatan itu, 'kan?
Dialogue: 0,0:20:41.22,0:20:43.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang dipinjam harus dikembalikan.
Dialogue: 0,0:20:43.02,0:20:44.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harusnya begitu, 'kan?
Dialogue: 0,0:20:44.45,0:20:46.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, sih...
Dialogue: 0,0:20:46.47,0:20:50.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, dia menagih seenaknya\Ntanpa persetujuan kami!
Dialogue: 0,0:20:50.50,0:20:51.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah begitu?
Dialogue: 0,0:20:51.92,0:20:55.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, soalnya mereka sudah keterlaluan.
Dialogue: 0,0:20:56.44,0:20:57.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:20:57.50,0:21:01.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menagih dengan berlebihan\Nbisa jadi sumber masalah.
Dialogue: 0,0:21:02.45,0:21:05.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,\Nbagaimana kalau seperti ini saja.
Dialogue: 0,0:21:07.17,0:21:08.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duel.
Dialogue: 0,0:21:08.70,0:21:10.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita buktikan siapa yang benar.
