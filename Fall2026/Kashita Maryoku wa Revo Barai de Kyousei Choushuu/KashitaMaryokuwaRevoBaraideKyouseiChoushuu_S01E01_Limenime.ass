Dialogue: 0,0:00:47.98,0:00:51.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bukan attacker yang mengandalkan\Npedang maupun sihir.
Dialogue: 0,0:00:51.32,0:00:52.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fireball!
Dialogue: 0,0:00:55.70,0:00:58.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan pula healer yang menyembuhkan luka.
Dialogue: 0,0:01:02.02,0:01:03.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lent!
Dialogue: 0,0:01:05.06,0:01:07.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skill: Peminjaman Daya Sihir!
Dialogue: 0,0:01:12.66,0:01:13.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pergi dari sini!
Dialogue: 0,0:01:20.22,0:01:21.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lent, cepat!
Dialogue: 0,0:01:38.64,0:01:40.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai panas, nih.
Dialogue: 0,0:01:41.96,0:01:46.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keluarkan semua daya sihirnya!
Dialogue: 0,0:01:48.14,0:01:49.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tebasan Ledakan!
Dialogue: 0,0:02:06.96,0:02:09.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya perburuan kali ini bakal gampang.
Dialogue: 0,0:02:14.74,0:02:15.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:02:15.53,0:02:16.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guy!
Dialogue: 0,0:02:17.47,0:02:19.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau luar biasa!
Dialogue: 0,0:02:24.78,0:02:26.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekali serang doang.
Dialogue: 0,0:02:26.75,0:02:27.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gila.
Dialogue: 0,0:02:27.38,0:02:30.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, ayo kita habisi bosnya.
Dialogue: 0,0:02:30.80,0:02:32.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ya!\N- Ayo!
Dialogue: 0,0:02:37.58,0:02:39.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan nama Gift milikku adalah
Dialogue: 0,0:02:41.41,0:02:42.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyimpanan Sihir.
Dialogue: 0,0:02:44.52,0:02:46.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemampuan meminjamkan\Ndaya sihir pada orang lain.
Dialogue: 0,0:03:08.92,0:03:11.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daya Sihir yang Dipinjam\NAkan Ditagih Paksa dengan Sistem Cicilan
Dialogue: 0,0:04:28.00,0:04:29.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana?
Dialogue: 0,0:04:29.25,0:04:32.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gift-ku Pendekar Pedang, lo!
Dialogue: 0,0:04:32.25,0:04:33.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mantap, Guy!
Dialogue: 0,0:04:33.57,0:04:35.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu kelas petualang rank D!
Dialogue: 0,0:04:35.54,0:04:39.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memang ditakdirkan jadi petualang.
Dialogue: 0,0:04:39.17,0:04:41.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gift-ku dapatnya malah Pandai Besi.
Dialogue: 0,0:04:41.72,0:04:43.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rank E pula.
Dialogue: 0,0:04:43.46,0:04:45.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, dong?
Dialogue: 0,0:04:45.18,0:04:46.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau!
Dialogue: 0,0:04:46.38,0:04:47.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja.
Dialogue: 0,0:04:47.70,0:04:50.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kukalahkan musuh\Ndengan senjata yang kau tempa.
Dialogue: 0,0:04:50.26,0:04:51.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guy jadi Pendekar Pedang, ya.
Dialogue: 0,0:04:51.90,0:04:54.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga ingin dapat Gift kelas petualang.
Dialogue: 0,0:04:55.49,0:04:58.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di dunia ini,\Nsetiap orang yang menginjak usia 15 tahun
Dialogue: 0,0:04:58.83,0:05:00.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan menjalani Upacara Kedewasaan
Dialogue: 0,0:05:01.18,0:05:03.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk mendapatkan Gift dari sang Pencipta.
Dialogue: 0,0:05:04.19,0:05:07.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gift adalah kemampuan yang sesuai\Ndengan bakat seseorang
Dialogue: 0,0:05:07.75,0:05:09.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk menentukan pekerjaannya.
Dialogue: 0,0:05:10.46,0:05:12.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi Pendekar Pedang kayaknya keren.
Dialogue: 0,0:05:13.36,0:05:14.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lent.
Dialogue: 0,0:05:15.81,0:05:17.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misa?!
Dialogue: 0,0:05:19.50,0:05:20.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namamu dipanggil, tuh.
Dialogue: 0,0:05:21.59,0:05:23.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, serius?
Dialogue: 0,0:05:23.59,0:05:25.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga dapat Pendekar Pedang.
Dialogue: 0,0:05:25.60,0:05:26.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:05:39.36,0:05:42.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suasananya berbeda dari gereja yang biasa.
Dialogue: 0,0:05:47.42,0:05:49.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang, Lent.
Dialogue: 0,0:05:49.15,0:05:50.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Orphes.
Dialogue: 0,0:05:50.62,0:05:52.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peganglah perkamen ini,
Dialogue: 0,0:05:52.83,0:05:55.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu berdoalah di dalam cahaya altar.
Dialogue: 0,0:05:55.50,0:05:59.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan begitu, sang Pencipta\Nakan menurunkan wahyu kepadamu.
Dialogue: 0,0:05:59.51,0:06:00.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:06:26.24,0:06:27.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, sepertinya sudah selesai.
Dialogue: 0,0:06:29.49,0:06:30.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lent.
Dialogue: 0,0:06:32.21,0:06:33.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana hasilnya?
Dialogue: 0,0:06:36.04,0:06:39.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dapat Gift rank S.
Dialogue: 0,0:06:39.42,0:06:41.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Orphes juga sampai terkejut.
Dialogue: 0,0:06:46.89,0:06:48.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rank S?
Dialogue: 0,0:06:49.89,0:06:50.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba lihat!
Dialogue: 0,0:06:52.34,0:06:53.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betulan rank S!
Dialogue: 0,0:06:53.63,0:06:54.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi apa?
Dialogue: 0,0:06:55.10,0:06:56.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyimpanan Sihir?
Dialogue: 0,0:06:56.80,0:06:59.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin itu Gift Unik?
Dialogue: 0,0:06:59.31,0:07:02.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buset, daya sihirnya 1.200?
Dialogue: 0,0:07:02.32,0:07:03.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin!
Dialogue: 0,0:07:03.54,0:07:05.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daya sihirku saja cuma 20.
Dialogue: 0,0:07:05.38,0:07:06.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku malah 13.
Dialogue: 0,0:07:06.67,0:07:08.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku nol.
Dialogue: 0,0:07:14.16,0:07:16.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, apa kemampuanmu?
Dialogue: 0,0:07:16.61,0:07:20.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eng, semacam meminjamkan daya sihir.
Dialogue: 0,0:07:20.09,0:07:21.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meminjamkan?
Dialogue: 0,0:07:21.81,0:07:23.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudnya,
Dialogue: 0,0:07:23.01,0:07:27.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sama seperti meminjamkan uang,\Naku bisa meminjamkan daya sihirku.
Dialogue: 0,0:07:30.72,0:07:32.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk Guy, akan kupinjamkan...
Dialogue: 0,0:07:33.26,0:07:35.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Magic Point!
Dialogue: 0,0:07:35.81,0:07:36.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih!
Dialogue: 0,0:07:39.36,0:07:41.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti kalau aku pinjam daya sihir darimu,
Dialogue: 0,0:07:41.94,0:07:44.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku bisa pakai sihir dan skill sesukaku?
Dialogue: 0,0:07:45.94,0:07:47.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lent, kau hebat!
Dialogue: 0,0:07:47.78,0:07:48.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misa!
Dialogue: 0,0:07:48.53,0:07:51.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dapat Gift rank S itu beruntung banget!
Dialogue: 0,0:07:51.70,0:07:53.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitukah...?
Dialogue: 0,0:07:54.75,0:07:55.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat.
Dialogue: 0,0:07:58.72,0:07:59.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:08:00.04,0:08:01.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tepatnya,
Dialogue: 0,0:08:01.50,0:08:04.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}peminjaman daya sihir hanyalah\Nsalah satu dari skill yang aku punya.
Dialogue: 0,0:08:07.55,0:08:09.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya,
Dialogue: 0,0:08:09.06,0:08:11.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ini adalah kekuatan\Nuntuk menyimpan daya sihir.
Dialogue: 0,0:08:12.53,0:08:13.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada dasarnya,
Dialogue: 0,0:08:13.97,0:08:18.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}daya sihir adalah sebutan untuk energi\Nyang dikonsumsi saat memakai sihir atau skill.
Dialogue: 0,0:08:19.07,0:08:22.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daya sihir yang terpakai akan pulih otomatis\Ndengan istirahat atau tidur.
Dialogue: 0,0:08:22.83,0:08:25.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, ada batas maksimal\Nyang dapat disimpan,
Dialogue: 0,0:08:25.26,0:08:27.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sehingga tidak bisa pulih\Nmelebihi batas tersebut.
Dialogue: 0,0:08:28.05,0:08:31.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku bisa menyimpan kelebihannya itu\Nke dalam Penyimpanan Sihir.
Dialogue: 0,0:08:32.58,0:08:35.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapasitasnya sama\Ndengan jumlah maksimal daya sihirku.
Dialogue: 0,0:08:35.70,0:08:37.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi totalnya 2.400.
Dialogue: 0,0:08:39.78,0:08:41.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyimpanan Sihir, ya.
Dialogue: 0,0:08:41.58,0:08:44.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana cara memanfaatkan Gift seperti ini?
Dialogue: 0,0:08:45.28,0:08:49.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya, kunci menggunakan sihir\Nadalah membayangkannya dengan jelas.
Dialogue: 0,0:08:54.02,0:08:55.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Celengan.
Dialogue: 0,0:09:00.64,0:09:01.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misalnya...
Dialogue: 0,0:09:02.22,0:09:04.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memasukkan kelebihan daya sihirnya ke sini.
Dialogue: 0,0:09:07.42,0:09:09.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga! Ide bagus!
Dialogue: 0,0:09:09.66,0:09:11.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apalagi aku punya pengalaman menabung.
Dialogue: 0,0:09:12.16,0:09:13.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan uang,
Dialogue: 0,0:09:13.89,0:09:16.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi membayangkan\Nmenyimpan daya sihir ke sini.
Dialogue: 0,0:09:34.27,0:09:35.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fireball!
Dialogue: 0,0:09:38.56,0:09:41.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Percuma, aku tidak bisa mengontrolnya.
Dialogue: 0,0:09:41.84,0:09:42.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja.
Dialogue: 0,0:09:43.02,0:09:46.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kupinjamkan daya sihirku,\Njadi kau bisa berlatih sampai berhasil.
Dialogue: 0,0:09:47.39,0:09:48.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:09:51.25,0:09:52.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peminjaman Daya Sihir.
Dialogue: 0,0:09:58.12,0:10:00.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku merasakan kekuatan mengalir ke tubuhku.
Dialogue: 0,0:10:01.02,0:10:02.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, dicoba lagi!
Dialogue: 0,0:10:02.71,0:10:04.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, kali ini pasti bisa!
Dialogue: 0,0:10:07.71,0:10:09.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fireball!
Dialogue: 0,0:10:12.32,0:10:13.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kena!
Dialogue: 0,0:10:13.68,0:10:14.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhasil!
Dialogue: 0,0:10:14.78,0:10:16.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berhasil karena kau, Lent!
Dialogue: 0,0:10:16.86,0:10:18.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma diam saja.
Dialogue: 0,0:10:18.32,0:10:19.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh iya!
Dialogue: 0,0:10:20.27,0:10:22.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana cara mengembalikan daya sihirnya?
Dialogue: 0,0:10:23.25,0:10:26.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arahkan saja tanganmu ke sini,\Nlalu alirkan daya sihirmu.
Dialogue: 0,0:10:27.42,0:10:28.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini?
Dialogue: 0,0:10:28.26,0:10:29.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:10:37.50,0:10:40.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah meminjamkan daya sihirmu.
Dialogue: 0,0:10:42.45,0:10:43.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya.
Dialogue: 0,0:10:44.08,0:10:47.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, hei, jangan bermesraan\Ndi siang bolong begini.
Dialogue: 0,0:10:47.44,0:10:49.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu-Bukan begitu!
Dialogue: 0,0:10:49.59,0:10:51.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya bikin kesal,
Dialogue: 0,0:10:51.79,0:10:54.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi harus aku akui,\NGift-mu memang luar biasa.
Dialogue: 0,0:10:55.05,0:10:56.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be-Benarkah?
Dialogue: 0,0:10:57.33,0:10:58.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Lent.
Dialogue: 0,0:10:59.62,0:11:02.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau ikut bertualang bersama kami?
Dialogue: 0,0:11:04.08,0:11:08.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Besok, aku mau mendaftarkan party\Ndi guild kota.
Dialogue: 0,0:11:08.86,0:11:11.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku, Lent, dan Guy.
Dialogue: 0,0:11:11.58,0:11:13.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus kita cari satu orang lagi.
Dialogue: 0,0:11:14.15,0:11:16.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa tidak masalah aku ikut?
Dialogue: 0,0:11:16.82,0:11:18.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja.
Dialogue: 0,0:11:19.06,0:11:21.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apalagi aku jadi bisa pakai\Ndaya sihir sesukaku.
Dialogue: 0,0:11:21.42,0:11:24.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang, tidak bisa dipakai sesukanya.
Dialogue: 0,0:11:24.42,0:11:27.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan juga, daya sihir yang dipinjam\Nharus dikembalikan.
Dialogue: 0,0:11:27.06,0:11:29.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, aku tahu.
Dialogue: 0,0:11:29.29,0:11:31.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lent kan suka banget bilang begini,
Dialogue: 0,0:11:31.49,0:11:34.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Ingin bertualang dan menjalani hari\Nyang menyenangkan."
Dialogue: 0,0:11:34.96,0:11:35.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:11:35.66,0:11:37.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti sudah diputuskan.
Dialogue: 0,0:11:37.07,0:11:39.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nama party-nya sudah ditentukan?
Dialogue: 0,0:11:39.05,0:11:40.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja!
Dialogue: 0,0:11:43.42,0:11:44.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang Pemecah Langit!
Dialogue: 0,0:11:45.93,0:11:49.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suatu hari nanti,\Npedang ini akan mampu membelah langit!
Dialogue: 0,0:11:49.48,0:11:51.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, Guy.
Dialogue: 0,0:11:51.40,0:11:53.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau dipikirkan lagi?
Dialogue: 0,0:11:53.81,0:11:56.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Jelek banget.\N- Bagus, tuh! Keren banget!
Dialogue: 0,0:11:56.58,0:11:57.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, 'kan?
Dialogue: 0,0:11:57.49,0:11:59.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kalian seriusan?\N- Banget!
Dialogue: 0,0:12:00.74,0:12:04.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah itu, kami merekrut Elle,\Nseorang penyembuh.
Dialogue: 0,0:12:06.25,0:12:08.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Petualangan Pedang Pemecah Langit
Dialogue: 0,0:12:08.32,0:12:09.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pun dimulai.
Dialogue: 0,0:12:10.42,0:12:13.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami pun berkembang pesat\Ndan terus meraih prestasi.
Dialogue: 0,0:12:14.76,0:12:17.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku meminjamkan daya sihirku\Nyang berlimpah ke semua anggota,
Dialogue: 0,0:12:18.11,0:12:21.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan mengalahkan monster kuat\Ndengan mengaktifkan skill terus-menerus.
Dialogue: 0,0:12:21.84,0:12:24.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jumlah daya sihir yang dimiliki
Dialogue: 0,0:12:24.97,0:12:27.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}benar-benar menentukan kekuatan tempur party.
Dialogue: 0,0:12:33.20,0:12:34.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tebasan Angin!
Dialogue: 0,0:12:39.78,0:12:41.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat itu, aku
Dialogue: 0,0:12:41.70,0:12:44.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}percaya bahwa kami berempat\Nakan terus bersama.
Dialogue: 0,0:12:46.48,0:12:47.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun...
Dialogue: 0,0:12:53.33,0:12:56.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tahu Pedang Pemecah Langit?
Dialogue: 0,0:12:56.59,0:12:59.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, yang katanya rank petualangnya naik
Dialogue: 0,0:12:59.30,0:13:03.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dari F ke C cuma dalam dua tahun itu, 'kan?
Dialogue: 0,0:13:03.47,0:13:05.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya mereka yang paling cepat\Nnaik di sini.
Dialogue: 0,0:13:05.84,0:13:09.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin saja mereka bisa jadi party\Nyang menyaingi Gugus Meteor.
Dialogue: 0,0:13:10.37,0:13:13.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh? Pedang Pemecah Langit, ya?
Dialogue: 0,0:13:15.41,0:13:17.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana zirahku ini?
Dialogue: 0,0:13:17.48,0:13:19.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena sudah naik ke rank C,
Dialogue: 0,0:13:19.97,0:13:22.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}penampilanku juga harus keren, dong?
Dialogue: 0,0:13:22.95,0:13:23.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya,
Dialogue: 0,0:13:23.87,0:13:25.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}keren banget.
Dialogue: 0,0:13:26.03,0:13:28.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat, penampilanku juga manis, 'kan?
Dialogue: 0,0:13:28.66,0:13:30.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku suka banget ini!
Dialogue: 0,0:13:32.27,0:13:34.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian berdua cocok banget.
Dialogue: 0,0:13:34.10,0:13:35.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu...
Dialogue: 0,0:13:35.88,0:13:38.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku doang yang belum ganti perlengkapan.
Dialogue: 0,0:13:38.26,0:13:40.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau begitu saja sudah cukup.
Dialogue: 0,0:13:40.66,0:13:42.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma meminjamkan daya sihir
Dialogue: 0,0:13:42.34,0:13:44.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan tidak bertarung pula.
Dialogue: 0,0:13:44.30,0:13:46.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lent, daripada memikirkan itu,
Dialogue: 0,0:13:46.18,0:13:48.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mending kau cuci bajumu.
Dialogue: 0,0:13:48.22,0:13:50.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baunya agak kecut.
Dialogue: 0,0:13:51.27,0:13:53.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi ini baunya Lent?
Dialogue: 0,0:13:53.38,0:13:56.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Bau banget!\N- Awas saja kalau baunya menempel ke aku.
Dialogue: 0,0:13:56.27,0:13:58.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengenai skill milikku,
Dialogue: 0,0:13:58.38,0:14:00.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ada prinsip dasar "Peminjaman Daya Sihir".
Dialogue: 0,0:14:01.20,0:14:02.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka yang dipinjami daya sihir
Dialogue: 0,0:14:02.82,0:14:05.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}punya kewajiban untuk mengembalikannya.
Dialogue: 0,0:14:05.47,0:14:08.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika tidak dikembalikan,\Nskill milikku tidak akan berkembang.
Dialogue: 0,0:14:10.04,0:14:11.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:14:12.80,0:14:14.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kalian.
Dialogue: 0,0:14:14.16,0:14:16.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong kembalikan daya sihir
Dialogue: 0,0:14:17.47,0:14:18.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang kalian pinjam...
Dialogue: 0,0:14:18.59,0:14:20.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Hah?\N- Hah?
Dialogue: 0,0:14:20.09,0:14:22.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, bukan apa-apa.
Dialogue: 0,0:14:23.54,0:14:25.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa mengatakannya.
Dialogue: 0,0:14:26.85,0:14:31.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalimat yang dulu bisa kukatakan sesuka hati\Nketika kami masih setara...
Dialogue: 0,0:14:32.58,0:14:34.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pastikan daya sihirnya dikembalikan, ya.
Dialogue: 0,0:14:36.86,0:14:40.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketika seseorang berkembang,\Npemandangan yang dilihatnya pun berubah.
Dialogue: 0,0:14:40.78,0:14:43.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu pula dengan cara berpikirnya.
Dialogue: 0,0:14:53.74,0:14:55.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, semuanya,
Dialogue: 0,0:14:55.07,0:14:57.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ayo cepat kita bereskan bosnya.
Dialogue: 0,0:14:57.46,0:14:58.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ya!\N- Iya.
Dialogue: 0,0:15:16.37,0:15:20.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini dia, sihir penguatan!
Dialogue: 0,0:15:23.65,0:15:25.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dual Boost!
Dialogue: 0,0:15:32.19,0:15:34.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fire Tornado!
Dialogue: 0,0:15:41.78,0:15:43.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tebasan Angin!
Dialogue: 0,0:15:55.89,0:15:58.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Formasi andalan yang selalu membawa kemenangan!
Dialogue: 0,0:15:59.76,0:16:00.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar lemah.
Dialogue: 0,0:16:00.70,0:16:03.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya bos, tapi tidak ada apa-apanya.
Dialogue: 0,0:16:03.46,0:16:05.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian semua memang hebat.
Dialogue: 0,0:16:09.61,0:16:12.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daya sihirku sampai habis.
Dialogue: 0,0:16:12.00,0:16:14.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, ayo pulang dan lapor ke guild.
Dialogue: 0,0:16:14.75,0:16:16.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bakal dapat imbalan berapa, ya?
Dialogue: 0,0:16:16.69,0:16:18.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi tidak sabar!
Dialogue: 0,0:16:19.62,0:16:20.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kalian tahu?
Dialogue: 0,0:16:20.90,0:16:25.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya, party rank B kita ini\Nyang paling mendekati rank A, lo.
Dialogue: 0,0:16:25.28,0:16:27.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah! Jelas, lah!
Dialogue: 0,0:16:31.14,0:16:33.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, semuanya, di sana ada peti harta.
Dialogue: 0,0:16:34.31,0:16:35.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:16:37.17,0:16:37.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minggir!
Dialogue: 0,0:16:39.46,0:16:40.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, duh.
Dialogue: 0,0:17:01.71,0:17:04.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bilang... apa?
Dialogue: 0,0:17:04.71,0:17:06.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan buat aku mengatakannya lagi.
Dialogue: 0,0:17:07.11,0:17:09.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agar bisa mencapai\Ntingkat yang lebih tinggi lagi,
Dialogue: 0,0:17:09.97,0:17:12.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami akan merekrut petualang baru
Dialogue: 0,0:17:12.02,0:17:15.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan membentuk Pedang Pemecah Langit Versi 2.
Dialogue: 0,0:17:19.48,0:17:21.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu, kau harus keluar.
Dialogue: 0,0:17:21.59,0:17:23.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, tapi...
Dialogue: 0,0:17:23.49,0:17:25.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku masih kurang?
Dialogue: 0,0:17:25.86,0:17:27.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa tiba-tiba sekali?
Dialogue: 0,0:17:30.74,0:17:34.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu... gelang yang dari peti harta...
Dialogue: 0,0:17:34.99,0:17:38.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi kami minta toko\Nuntuk mengidentifikasinya.
Dialogue: 0,0:17:38.78,0:17:40.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemiliknya bahkan sampai terkejut.
Dialogue: 0,0:17:40.85,0:17:42.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya, gelang ini sangat langka.
Dialogue: 0,0:17:43.20,0:17:46.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gelang ini bisa memulihkan\Ndaya sihir penggunanya.
Dialogue: 0,0:17:46.46,0:17:50.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bilang seribu daya sihir per hari.
Dialogue: 0,0:17:50.24,0:17:51.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan kita dapat tiga gelang.
Dialogue: 0,0:17:53.26,0:17:56.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau digabung, jumlahnya melebihi\Ndaya sihir yang bisa kau pinjamkan.
Dialogue: 0,0:17:56.42,0:17:59.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang kami butuhkan hanyalah daya sihir.
Dialogue: 0,0:17:59.23,0:18:01.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi kau tidak dibutuhkan.
Dialogue: 0,0:18:02.06,0:18:03.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi bagus, dong?
Dialogue: 0,0:18:03.58,0:18:05.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ditambah dengan aku,
Dialogue: 0,0:18:05.46,0:18:08.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}totalnya jadi 5.000 daya sihir.
Dialogue: 0,0:18:08.18,0:18:10.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bisa pakai sihir sepuasnya.
Dialogue: 0,0:18:10.90,0:18:14.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, jangan keluarkan aku\Ndari Pedang Pemecah Langit.
Dialogue: 0,0:18:16.32,0:18:18.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kutes kau.
Dialogue: 0,0:18:18.24,0:18:20.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cobalah untuk lepas dari situasi ini.
Dialogue: 0,0:18:21.16,0:18:25.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pecundang yang cuma bisa meminjamkan\Ndaya sihir, tidak usah belagu.
Dialogue: 0,0:18:25.67,0:18:27.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan.
Dialogue: 0,0:18:28.11,0:18:30.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Se-Sesak.
Dialogue: 0,0:18:36.66,0:18:40.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku... bisa... mati.
Dialogue: 0,0:18:48.30,0:18:50.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia memang pecundang.
Dialogue: 0,0:19:01.33,0:19:02.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menjijikkan.
Dialogue: 0,0:19:02.82,0:19:04.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan wajahmu itu?
Dialogue: 0,0:19:04.45,0:19:06.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau dikasihani olehku?
Dialogue: 0,0:19:06.80,0:19:08.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak berguna.
Dialogue: 0,0:19:12.30,0:19:13.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Lent.
Dialogue: 0,0:19:13.94,0:19:16.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau ikut bertualang bersama kami?
Dialogue: 0,0:19:26.30,0:19:28.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat tinggal.
Dialogue: 0,0:19:32.00,0:19:34.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya bisa menyingkirkan si beban itu.
Dialogue: 0,0:19:34.40,0:19:38.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harusnya orang seperti dia\Nsudah diusir sejak dulu.
Dialogue: 0,0:19:42.20,0:19:44.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal kalian satu kampung,\Ntapi kejam banget.
Dialogue: 0,0:19:49.41,0:19:52.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat itu, aku tidak bisa berbuat apa-apa.
Dialogue: 0,0:19:53.41,0:19:55.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gift yang aku dapatkan,
Dialogue: 0,0:19:55.71,0:19:56.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyimpanan Sihir,
Dialogue: 0,0:19:57.46,0:19:59.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}merupakan Gift Unik rank S
Dialogue: 0,0:20:00.01,0:20:02.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang membuat siapa pun terpukau.
Dialogue: 0,0:20:03.15,0:20:06.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya bisa berdiri di belakang\Ndan meminjamkan daya sihir.
Dialogue: 0,0:20:10.50,0:20:13.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga tidak menginginkan Gift ini.
Dialogue: 0,0:20:15.28,0:20:17.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, mereka...
Dialogue: 0,0:20:18.40,0:20:21.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak berguna?\NMakanya aku dikeluarkan?
Dialogue: 0,0:20:21.98,0:20:24.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, setidaknya...
Dialogue: 0,0:20:24.66,0:20:26.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kembalikan semua daya sihir
Dialogue: 0,0:20:27.29,0:20:31.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang selama ini aku pinjamkan!
Dialogue: 0,0:20:44.35,0:20:45.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Petir?
Dialogue: 0,0:20:45.98,0:20:48.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Palingan petirnya menyambar dia.
Dialogue: 0,0:20:49.26,0:20:50.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kualat, tuh.
Dialogue: 0,0:20:53.50,0:20:55.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak peduli juga, sih.
Dialogue: 0,0:20:56.62,0:20:59.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gift telah memenuhi syarat untuk berevolusi.
Dialogue: 0,0:20:59.90,0:21:03.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyimpanan Sihir telah berevolusi menjadi\NPenyimpanan Sihir Tanpa Batas.
Dialogue: 0,0:21:03.36,0:21:04.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suara apa ini?
Dialogue: 0,0:21:06.49,0:21:10.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat atas evolusi Gift Anda, Master.
Dialogue: 0,0:21:16.19,0:21:17.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa?
