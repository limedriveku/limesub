Dialogue: 0,0:01:16.32,0:01:18.97,sign,,0000,0000,0000,,DAYA SIHIR YANG DIPINJAM\NAKAN DITAGIH PAKSA DENGAN SISTEM CICILAN
Dialogue: 0,0:02:32.01,0:02:34.09,sign,,0000,0000,0000,,DUNGEON AGUNG MELBA,\NLANTAI DUA: HUTAN BELANTARA GOBLIN
Dialogue: 0,0:02:34.09,0:02:35.38,sign,,0000,0000,0000,,PETUALANG YANG DISARANKAN: RANK E
Dialogue: 0,0:02:37.22,0:02:40.85,sign,,0000,0000,0000,,EPISODE 4: MUSUH KUAT
Dialogue: 0,0:02:51.44,0:02:54.40,sign,,0000,0000,0000,,DETEKSI KEBERADAAN LEVEL 1\NHARGA: 5.000 DAYA SIHIR
Dialogue: 0,0:03:30.86,0:03:34.07,sign,,0000,0000,0000,,PENYEMBUNYIAN KEBERADAAN LEVEL 1\NHARGA: 5.000 DAYA SIHIR
Dialogue: 0,0:05:30.31,0:05:33.23,sign,,0000,0000,0000,,GOBLIN LEADER: GOBLIN BESAR\NYANG MEMIMPIN PARA GOBLIN
Dialogue: 0,0:06:59.48,0:07:02.74,sign,,0000,0000,0000,,"TAKOYAKI: 600 GOLD"
Dialogue: 0,0:08:10.02,0:08:10.55,sign,,0000,0000,0000,,LENT, 20 TAHUN\NPENYIMPANAN SIHIR TANPA BATAS "SSS"
Dialogue: 0,0:08:10.55,0:08:11.17,sign,,0000,0000,0000,,RANK PETUALANG: E
Dialogue: 0,0:12:49.04,0:12:52.53,sign,,0000,0000,0000,,"JUMLAH PINJAMAN DAYA SIHIR PARTY: 2.678.078"
Dialogue: 0,0:13:10.19,0:13:10.71,sign,,0000,0000,0000,,MISA, 20 TAHUN, PENYIHIR TINGKAT LANJUT\NDAYA SIHIR: 0/1.400
Dialogue: 0,0:14:49.50,0:14:50.74,sign,,0000,0000,0000,,OSMAN, 62 TAHUN, PENYIHIR HITAM
Dialogue: 0,0:17:06.92,0:17:10.05,sign,,0000,0000,0000,,DUNGEON AGUNG MELBA,\NLANTAI TIGA: GUA ARWAH
Dialogue: 0,0:17:10.05,0:17:12.93,sign,,0000,0000,0000,,PETUALANG YANG DISARANKAN: RANK D
Dialogue: 0,0:00:07.73,0:00:08.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Misa.
Dialogue: 0,0:00:10.06,0:00:14.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata kau ingat mimpiku\Nuntuk melakukan petualangan besar, ya.
Dialogue: 0,0:00:14.83,0:00:16.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja.
Dialogue: 0,0:00:16.43,0:00:18.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena aku selalu
Dialogue: 0,0:00:19.04,0:00:20.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}memikirkanmu.
Dialogue: 0,0:00:23.59,0:00:25.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, saat nanti menjadi petualang,
Dialogue: 0,0:00:26.29,0:00:28.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku sudah putuskan untuk bersama Lent.
Dialogue: 0,0:00:34.58,0:00:37.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kau itu
Dialogue: 0,0:00:41.55,0:00:43.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}benar-benar orang yang tidak berguna.
Dialogue: 0,0:00:53.63,0:00:54.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma mimpi, ya?
Dialogue: 0,0:02:42.34,0:02:44.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hutannya rimbun sekali, ya.
Dialogue: 0,0:02:44.34,0:02:45.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jarak pandangnya juga buruk.
Dialogue: 0,0:02:46.40,0:02:47.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau seperti ini...
Dialogue: 0,0:02:54.40,0:02:57.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku merasakan ada goblin di depan sana.
Dialogue: 0,0:02:57.63,0:02:59.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sebanyak ini,
Dialogue: 0,0:02:59.14,0:03:02.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin di sana ada koloni goblin.
Dialogue: 0,0:03:02.58,0:03:06.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Secara individu,\Nmereka memang tidak seberapa.
Dialogue: 0,0:03:06.22,0:03:08.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, merepotkan kalau\Nmereka menyerang berkelompok.
Dialogue: 0,0:03:13.65,0:03:17.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah tiba saatnya skill "itu"\Nmenunjukkan kemampuannya.
Dialogue: 0,0:03:17.89,0:03:19.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skill itu?
Dialogue: 0,0:04:06.31,0:04:08.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Master, sekaranglah saatnya.
Dialogue: 0,0:04:13.28,0:04:15.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skill: Manajemen Sihir!
Dialogue: 0,0:04:22.86,0:04:24.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fireball!
Dialogue: 0,0:04:30.75,0:04:32.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa pakai sihir berkali-kali?
Dialogue: 0,0:04:33.00,0:04:34.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar sekali.
Dialogue: 0,0:04:34.59,0:04:36.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kalau terus-terusan pakai daya sihir,
Dialogue: 0,0:04:36.59,0:04:40.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}biasanya akan sangat membebani tubuh.
Dialogue: 0,0:04:40.38,0:04:45.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misalnya, apakah Tuan Master\Nsanggup berlari tanpa henti?
Dialogue: 0,0:04:45.26,0:04:46.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mana bisa.
Dialogue: 0,0:04:46.83,0:04:48.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti kehabisan napas dulu.
Dialogue: 0,0:04:48.61,0:04:50.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama halnya dengan daya sihir.
Dialogue: 0,0:04:51.01,0:04:54.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada dasarnya, tidak mungkin\Nmemakai sihir berkali-kali tanpa henti.
Dialogue: 0,0:04:55.58,0:04:58.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, dengan Manajemen Sihir ini,
Dialogue: 0,0:04:59.04,0:05:01.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}permukaan tubuh akan terselimuti daya sihir
Dialogue: 0,0:05:01.70,0:05:04.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang bisa langsung diubah menjadi sihir.
Dialogue: 0,0:05:05.03,0:05:07.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa menembakkan sihir yang sama,
Dialogue: 0,0:05:07.09,0:05:09.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak, bahkan sihir yang berbeda sekaligus!
Dialogue: 0,0:05:18.42,0:05:20.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mantap juga!
Dialogue: 0,0:05:49.06,0:05:52.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Master berhasil menaklukkan\Nkoloni goblin sendirian!
Dialogue: 0,0:05:52.38,0:05:53.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak sendirian.
Dialogue: 0,0:05:54.61,0:05:56.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada kau juga yang membantu, Empee.
Dialogue: 0,0:06:00.34,0:06:02.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi senang.
Dialogue: 0,0:06:03.18,0:06:06.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, ayo kita taklukkan dungeon ini!
Dialogue: 0,0:06:06.93,0:06:10.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu kumpulkan batu sihir sebanyak-banyaknya!
Dialogue: 0,0:06:14.38,0:06:17.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Batu sihir yang didapat berjumlah 1.341.
Dialogue: 0,0:06:18.26,0:06:20.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nilainya jadi 134.100 gold.
Dialogue: 0,0:06:23.38,0:06:26.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Batu sihir dari Goblin Leader ada 21,
Dialogue: 0,0:06:26.06,0:06:27.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi nilainya 10.500 gold.
Dialogue: 0,0:06:28.16,0:06:30.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau dapat semuanya sendirian?
Dialogue: 0,0:06:30.59,0:06:34.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Goblin Seed dari penaklukan\Nkoloni goblin jumlahnya 21,
Dialogue: 0,0:06:34.87,0:06:36.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi nilainya 42.000 gold.
Dialogue: 0,0:06:37.39,0:06:39.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti banyak banget, nih.
Dialogue: 0,0:06:39.80,0:06:42.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika ditotal semuanya...
Dialogue: 0,0:06:46.85,0:06:49.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi 186.600 gold.
Dialogue: 0,0:06:57.44,0:06:59.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takoyakinya enak banget!
Dialogue: 0,0:06:59.48,0:07:02.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luarnya renyah, dalamnya lumer.
Dialogue: 0,0:07:02.74,0:07:05.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasa sausnya benar-benar enak!
Dialogue: 0,0:07:06.62,0:07:09.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makan takoyaki setelah bertarung\Nmemang mantap, ya.
Dialogue: 0,0:07:11.23,0:07:14.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rank petualangku juga naik dari E ke D.
Dialogue: 0,0:07:15.38,0:07:19.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau memanfaatkan skill yang kubeli,\Nmungkin aku bisa lebih kuat lagi.
Dialogue: 0,0:07:21.23,0:07:22.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang, kalau mereka mengincarku,
Dialogue: 0,0:07:22.98,0:07:24.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau tahu laki-laki ini?
Dialogue: 0,0:07:24.59,0:07:26.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}setidaknya aku bisa melawan.
Dialogue: 0,0:07:27.79,0:07:30.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suatu saat kau pasti akan ketahuan.
Dialogue: 0,0:07:30.14,0:07:31.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Lent!
Dialogue: 0,0:07:32.88,0:07:36.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tinggal menunggu waktu sampai\Norang-orang bodoh itu
Dialogue: 0,0:07:36.54,0:07:40.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menyadari daya sihir mereka ditagih paksa.
Dialogue: 0,0:07:45.06,0:07:49.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, ayo kumpulkan 150.000 daya sihir lagi\Nuntuk membeli skill berikutnya.
Dialogue: 0,0:07:50.77,0:07:52.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}150.000?!
Dialogue: 0,0:07:52.08,0:07:55.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mahal banget, memangnya skill apa?
Dialogue: 0,0:07:55.25,0:07:57.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau itu, rahasia.
Dialogue: 0,0:07:57.08,0:07:59.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang jelas, kalau dapat skill itu,
Dialogue: 0,0:07:59.66,0:08:02.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita takkan perlu takut lagi pada mereka.
Dialogue: 0,0:08:05.02,0:08:08.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}150.000 daya sihir, ya.
Dialogue: 0,0:08:08.50,0:08:10.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih jauh banget.
Dialogue: 0,0:08:11.18,0:08:12.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma sebentar, kok.
Dialogue: 0,0:08:15.22,0:08:17.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih atas makanannya.
Dialogue: 0,0:08:17.55,0:08:19.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ada yang ingin kau makan lagi?
Dialogue: 0,0:08:19.26,0:08:21.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Masih boleh tambah lagi?
Dialogue: 0,0:08:21.69,0:08:22.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:08:22.70,0:08:26.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini, aku ingin berterima kasih\Nkarena kau selalu membantuku.
Dialogue: 0,0:08:27.82,0:08:30.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:08:30.94,0:08:32.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin daya sihir.
Dialogue: 0,0:08:32.95,0:08:33.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daya sihir?
Dialogue: 0,0:08:33.94,0:08:34.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar!
Dialogue: 0,0:08:34.95,0:08:39.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagi Peri Gift, daya sihir adalah\Nhidangan yang sangat lezat!
Dialogue: 0,0:08:39.62,0:08:43.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, harusnya kau bilang dari awal.
Dialogue: 0,0:08:43.34,0:08:45.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, aku tidak enak memintanya.
Dialogue: 0,0:08:45.55,0:08:49.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena memperkuat Tuan Master\Nadalah prioritas utama.
Dialogue: 0,0:08:49.47,0:08:50.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau seberapa banyak?
Dialogue: 0,0:08:52.14,0:08:54.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan sungguh mau memberikannya padaku?
Dialogue: 0,0:08:56.06,0:08:59.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk sekarang, aku ingin 100 daya sihir.
Dialogue: 0,0:08:59.52,0:09:01.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eng...
Dialogue: 0,0:09:01.10,0:09:03.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa boleh kuberikan lewat\NPeminjaman Daya Sihir?
Dialogue: 0,0:09:03.65,0:09:04.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih baik
Dialogue: 0,0:09:06.05,0:09:07.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berikan secara langsung saja.
Dialogue: 0,0:09:07.82,0:09:09.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Langsung?
Dialogue: 0,0:09:09.22,0:09:12.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan cara ini,\Ndaya sihirnya langsung meresap ke tubuh.
Dialogue: 0,0:09:17.71,0:09:18.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:09:42.53,0:09:44.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana?
Dialogue: 0,0:09:46.24,0:09:48.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mantap banget.
Dialogue: 0,0:09:49.15,0:09:53.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini bisa disebut ciuman pertama?
Dialogue: 0,0:09:56.26,0:09:57.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luar biasa.
Dialogue: 0,0:09:58.51,0:10:01.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apalagi itu Gift Unik rank S.
Dialogue: 0,0:10:02.10,0:10:05.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau memang ditakdirkan\Nuntuk jadi petualang, Lent!
Dialogue: 0,0:10:05.54,0:10:08.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guy juga bilang hal yang sama.
Dialogue: 0,0:10:08.34,0:10:11.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya, "Aku memang ditakdirkan\Nmenjadi petualang!"
Dialogue: 0,0:10:11.21,0:10:14.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia itu Pendekar Pedang, 'kan?\NSudah biasa.
Dialogue: 0,0:10:14.06,0:10:16.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gift rank D juga sudah jadi hal yang lumrah.
Dialogue: 0,0:10:17.33,0:10:19.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akan terus bersama, ya.
Dialogue: 0,0:10:19.15,0:10:21.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, ayo kita bertualang bersama.
Dialogue: 0,0:10:23.98,0:10:26.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan hanya bertualang,
Dialogue: 0,0:10:28.34,0:10:31.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di luar itu pun, kita akan selalu bersama.
Dialogue: 0,0:10:32.62,0:10:33.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misa.
Dialogue: 0,0:10:33.78,0:10:37.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lent, apa kau menyukaiku?
Dialogue: 0,0:10:38.14,0:10:39.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Te-Tentu saja!
Dialogue: 0,0:10:40.59,0:10:41.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:10:55.46,0:10:56.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemarahan.
Dialogue: 0,0:10:58.89,0:11:00.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesak...
Dialogue: 0,0:11:06.02,0:11:07.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menjijikkan.
Dialogue: 0,0:11:07.46,0:11:08.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan wajahmu itu?
Dialogue: 0,0:11:08.90,0:11:10.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau dikasihani olehku?
Dialogue: 0,0:11:10.59,0:11:11.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keputusasaan.
Dialogue: 0,0:11:11.92,0:11:13.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong kembalikan.
Dialogue: 0,0:11:14.85,0:11:18.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan pernah dekati kami lagi!
Dialogue: 0,0:11:22.88,0:11:24.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasa kehilangan.
Dialogue: 0,0:11:27.33,0:11:30.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seandainya aku tidak bertemu Empee,
Dialogue: 0,0:11:30.72,0:11:33.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}entah jadi apa aku sekarang ini.
Dialogue: 0,0:11:37.42,0:11:40.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perasaan ini bukan rasa cinta.
Dialogue: 0,0:11:41.04,0:11:44.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin berbeda juga\Ndari kasih sayang manusia.
Dialogue: 0,0:11:45.70,0:11:46.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi,
Dialogue: 0,0:11:47.87,0:11:50.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hanya dengan melihat wajah tidurmu saja,
Dialogue: 0,0:11:50.74,0:11:52.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hatiku terasa terobati.
Dialogue: 0,0:11:52.54,0:11:54.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semangat hidupku kembali meluap.
Dialogue: 0,0:11:55.54,0:11:57.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minta daya sihirnya lagi.
Dialogue: 0,0:12:01.45,0:12:02.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini,
Dialogue: 0,0:12:03.14,0:12:04.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku bahagia.
Dialogue: 0,0:12:05.50,0:12:07.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat malam, Empee.
Dialogue: 0,0:12:15.62,0:12:17.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar orang-orang tidak berguna.
Dialogue: 0,0:12:18.72,0:12:22.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti yang sudah disampaikan sebelumnya.
Dialogue: 0,0:12:22.34,0:12:26.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini, tempat tinggal Tuan Lent\Nmasih terdaftar di kota ini.
Dialogue: 0,0:12:27.85,0:12:29.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin!
Dialogue: 0,0:12:29.60,0:12:33.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami sudah keliling kota ini,\Ntapi tidak ketemu juga!
Dialogue: 0,0:12:34.05,0:12:35.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti sangat melelahkan.
Dialogue: 0,0:12:36.50,0:12:38.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurang ajar, dari tadi kau meremehkanku, ya.
Dialogue: 0,0:12:38.78,0:12:41.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guy, sudah hentikan.
Dialogue: 0,0:12:42.83,0:12:43.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sialan!
Dialogue: 0,0:12:47.70,0:12:49.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga.
Dialogue: 0,0:12:49.04,0:12:52.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jumlah daya sihir yang kita pinjam berkurang.
Dialogue: 0,0:12:52.54,0:12:53.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sialan!
Dialogue: 0,0:12:53.52,0:12:56.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi dia mencuri daya sihir kita?!
Dialogue: 0,0:12:56.67,0:12:58.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama ini aku tidak menyadarinya.
Dialogue: 0,0:12:59.17,0:13:01.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya aku tidak pernah\Nmemperhatikan angkanya.
Dialogue: 0,0:13:02.69,0:13:04.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, ada yang aneh.
Dialogue: 0,0:13:05.56,0:13:09.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Total daya sihir dari gelang\Nditambah pemulihan daya sihir alami kita,
Dialogue: 0,0:13:10.72,0:13:12.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jika dibandingkan,
Dialogue: 0,0:13:12.05,0:13:14.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pengurangan daya sihir\Nyang kita pinjam sangat sedikit.
Dialogue: 0,0:13:14.77,0:13:16.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa maksudnya?
Dialogue: 0,0:13:16.75,0:13:18.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mana tahu.
Dialogue: 0,0:13:18.65,0:13:22.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, mau sampai kapan kita\Nbergantung pada obat ini?
Dialogue: 0,0:13:22.85,0:13:25.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pahit, mahal, pokoknya tidak enak.
Dialogue: 0,0:13:26.30,0:13:28.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk sekarang, kita cuma bisa bersabar.
Dialogue: 0,0:13:28.51,0:13:30.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau satu orang\Nminum empat sampai lima botol,
Dialogue: 0,0:13:30.96,0:13:33.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}setidaknya daya sihir kita\Ntakkan habis dalam sehari.
Dialogue: 0,0:13:33.97,0:13:35.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah tidak mau lagi.
Dialogue: 0,0:13:35.71,0:13:37.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau merengek lagi?
Dialogue: 0,0:13:37.71,0:13:40.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suruh orang lain saja yang minum!
Dialogue: 0,0:13:41.98,0:13:42.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyuruh orang lain?
Dialogue: 0,0:13:50.69,0:13:52.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Kakek.
Dialogue: 0,0:13:54.52,0:13:57.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa Kakek masih ingat kami?
Dialogue: 0,0:13:57.36,0:14:00.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kalian kan dari Pedang Pemecah Langit?
Dialogue: 0,0:14:01.20,0:14:03.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata Kakek ingat.
Dialogue: 0,0:14:03.30,0:14:05.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami senang.
Dialogue: 0,0:14:05.82,0:14:10.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau ber-tu-a-lang bersama kami?
Dialogue: 0,0:14:11.68,0:14:14.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami ingin Kakek.
Dialogue: 0,0:14:14.42,0:14:16.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Ingin aku?
Dialogue: 0,0:14:21.07,0:14:22.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kutukan ini
Dialogue: 0,0:14:22.85,0:14:26.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}memang menyerap daya sihir\NPedang Pemecah Langit,
Dialogue: 0,0:14:27.18,0:14:30.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita tinggal rekrut saja\Norang yang daya sihirnya banyak,
Dialogue: 0,0:14:30.80,0:14:34.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}agar jumlah daya sihir kita bertambah.
Dialogue: 0,0:14:34.26,0:14:35.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:14:35.46,0:14:37.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beban yang kita tanggung jadi ikut berkurang.
Dialogue: 0,0:14:37.97,0:14:39.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misa memang cerdas!
Dialogue: 0,0:14:39.77,0:14:42.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka semua masih belum punya party.
Dialogue: 0,0:14:42.27,0:14:45.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, pendeta ini daya sihirnya\Nlumayan banyak.
Dialogue: 0,0:14:45.99,0:14:49.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakek ini daya sihirnya 4.200!
Dialogue: 0,0:14:50.79,0:14:53.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal tidak pakai Fireball,\Ntapi rasanya panas sekali.
Dialogue: 0,0:14:53.81,0:14:58.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar aku Boost bagian tubuh yang lembut ini.
Dialogue: 0,0:14:58.19,0:14:59.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Kek!
Dialogue: 0,0:15:01.30,0:15:02.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, aku telat.
Dialogue: 0,0:15:02.74,0:15:04.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, datang juga.
Dialogue: 0,0:15:06.99,0:15:08.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa mereka?
Dialogue: 0,0:15:08.30,0:15:09.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak,
Dialogue: 0,0:15:09.60,0:15:13.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku hanya kerepotan didekati wanita genit.
Dialogue: 0,0:15:13.58,0:15:15.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah kau tidak punya party?!
Dialogue: 0,0:15:15.73,0:15:16.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang.
Dialogue: 0,0:15:16.82,0:15:21.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh ya,\Nsepertinya kalian terkena kutukan aneh, ya.
Dialogue: 0,0:15:22.40,0:15:25.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian sudah jadi bahan gosip\Ndi seluruh guild, lo.
Dialogue: 0,0:15:25.22,0:15:28.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf saja, aku tidak mau mengurus\Norang-orang seperti kalian.
Dialogue: 0,0:15:35.66,0:15:38.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat, itu Pedang Pemecah Langit.
Dialogue: 0,0:15:38.67,0:15:41.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada yang mau direkrut mereka.
Dialogue: 0,0:15:41.07,0:15:42.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasakan!
Dialogue: 0,0:15:42.83,0:15:46.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya mereka selalu\Nmerendahkan petualang lain.
Dialogue: 0,0:15:46.70,0:15:48.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pantas saja ada yang dendam
Dialogue: 0,0:15:49.34,0:15:52.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sampai-sampai mengutuk mereka\Ndengan kutukan aneh.
Dialogue: 0,0:15:54.18,0:15:57.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal dulu mereka dikagumi.
Dialogue: 0,0:15:57.95,0:15:59.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang sudah jatuh.
Dialogue: 0,0:15:59.95,0:16:01.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa yang kau bilang jatuh?
Dialogue: 0,0:16:03.42,0:16:05.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katakan, siapa yang kau bilang sudah jatuh?!
Dialogue: 0,0:16:07.76,0:16:10.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa yang kau maksud wanita genit,\NKakek Mesum?!
Dialogue: 0,0:16:12.99,0:16:16.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian berdua, sudah hentikan!
Dialogue: 0,0:16:20.61,0:16:22.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang Pemecah Langit.
Dialogue: 0,0:16:23.20,0:16:27.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengenai Tuan Lent\Nyang kalian tanyakan sebelumnya,
Dialogue: 0,0:16:27.46,0:16:29.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami sudah mendapat informasinya.
Dialogue: 0,0:16:29.26,0:16:30.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Informasinya?
Dialogue: 0,0:16:30.32,0:16:31.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah tahu di mana dia?
Dialogue: 0,0:16:32.02,0:16:32.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:16:32.91,0:16:37.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baru saja, tempat tinggal Tuan Lent\Ndipindahkan ke Kota Melba.
Dialogue: 0,0:16:37.64,0:16:38.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melba?
Dialogue: 0,0:16:38.72,0:16:41.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kota Dungeon Agung itu?
Dialogue: 0,0:16:41.07,0:16:43.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak kapan dia ke kota yang jauh itu?
Dialogue: 0,0:16:43.36,0:16:45.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak peduli dia ada di mana.
Dialogue: 0,0:16:46.40,0:16:49.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kutemukan dan kuhabisi dia!
Dialogue: 0,0:16:54.66,0:16:56.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketemu!
Dialogue: 0,0:16:56.08,0:16:58.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pintu menuju lantai ketiga!
Dialogue: 0,0:16:58.90,0:17:01.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai dari sini,\Nmonster-monsternya lebih tangguh,
Dialogue: 0,0:17:01.38,0:17:02.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi harus waspada.
Dialogue: 0,0:17:20.69,0:17:22.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suasana yang mencekam ini...
Dialogue: 0,0:17:22.48,0:17:24.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lorong yang remang-remang...
Dialogue: 0,0:17:24.67,0:17:27.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ditambah suasana yang lembap ini!
Dialogue: 0,0:17:27.31,0:17:30.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya terasa seperti dungeon juga!
Dialogue: 0,0:17:30.88,0:17:31.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Empee.
Dialogue: 0,0:17:32.70,0:17:34.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, 'kan?!
Dialogue: 0,0:17:34.22,0:17:36.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga bersemangat banget!
Dialogue: 0,0:17:36.86,0:17:38.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ya, 'kan?\N- Ya!
Dialogue: 0,0:17:41.89,0:17:43.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Quick Stab!
Dialogue: 0,0:17:45.38,0:17:46.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hampir saja.
Dialogue: 0,0:17:46.96,0:17:51.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku lupa monster di sini\Nmenyerang berdasarkan suara.
Dialogue: 0,0:17:53.71,0:17:55.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:17:58.48,0:18:01.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau kita bicara\Nlewat hati seperti ini?
Dialogue: 0,0:18:02.91,0:18:04.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada suara dari dalam kepalaku?
Dialogue: 0,0:18:04.94,0:18:09.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salurannya sudah kusambung,\Nharusnya Tuan Master sudah bisa dengar.
Dialogue: 0,0:18:10.61,0:18:13.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo, Empee?
Dialogue: 0,0:18:13.34,0:18:15.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo, sudah kedengaran.
Dialogue: 0,0:18:17.25,0:18:20.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ada cara seberguna ini,
Dialogue: 0,0:18:20.06,0:18:23.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}harusnya kau beri tahu sejak kita di kereta.
Dialogue: 0,0:18:24.83,0:18:26.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:18:39.87,0:18:42.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Area ini ternyata lebih mudah\Ndaripada yang kubayangkan.
Dialogue: 0,0:18:42.77,0:18:45.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, gua ini cukup berliku-liku.
Dialogue: 0,0:18:45.92,0:18:48.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus hati-hati\Nagar tidak diserang mendadak.
Dialogue: 0,0:18:51.81,0:18:55.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di dekat sini ada petualang\Nyang sedang melawan monster.
Dialogue: 0,0:18:56.62,0:18:59.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo? Monster ini jangan-jangan...
Dialogue: 0,0:19:00.49,0:19:01.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat!
Dialogue: 0,0:19:03.17,0:19:06.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Master, ada apa?
Dialogue: 0,0:19:06.22,0:19:07.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada Irregular yang muncul!
Dialogue: 0,0:19:08.00,0:19:09.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Irregular?
Dialogue: 0,0:19:09.68,0:19:12.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebutan untuk monster\Nyang seharusnya tidak ada di lantai ini.
Dialogue: 0,0:19:13.89,0:19:17.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terkadang, monster berlevel tinggi\Nmasuk ke lantai-lantai awal.
Dialogue: 0,0:19:18.05,0:19:21.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di ruangan depan sana,\Nada petualang yang diserang Irregular!
Dialogue: 0,0:19:21.60,0:19:23.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa Tuan mau menolongnya?
Dialogue: 0,0:19:24.67,0:19:28.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, sepertinya aku memang\Nterlalu baik hati.
Dialogue: 0,0:19:28.37,0:19:29.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa tidak?
Dialogue: 0,0:19:30.24,0:19:34.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga merasakan aroma keuntungan\Ndari daya sihir ini!
Dialogue: 0,0:19:35.20,0:19:36.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh!
Dialogue: 0,0:19:36.36,0:19:38.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hati-hati, dong!
Dialogue: 0,0:19:38.13,0:19:39.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:19:39.12,0:19:40.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bukan waktunya cari masalah.
Dialogue: 0,0:19:41.79,0:19:46.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kau masih sayang nyawa,\Nsebaiknya jangan pergi ke sana.
Dialogue: 0,0:19:47.25,0:19:49.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kalian yakin?
Dialogue: 0,0:19:49.23,0:19:51.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daripada kita semua mati?
Dialogue: 0,0:19:51.42,0:19:55.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wanita itu juga pasti puas\Nkarena akhirnya bisa berguna.
Dialogue: 0,0:19:57.60,0:20:00.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah mereka petualang yang diserang itu?
Dialogue: 0,0:20:00.30,0:20:03.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, petualang yang aku deteksi tadi\Nada empat orang.
Dialogue: 0,0:20:03.90,0:20:05.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih ada satu orang.
Dialogue: 0,0:20:05.55,0:20:07.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa dia telat kabur?
Dialogue: 0,0:20:08.03,0:20:08.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entahlah.
Dialogue: 0,0:20:09.56,0:20:11.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ayo, Empee!\N- Baik!
Dialogue: 0,0:20:18.70,0:20:21.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo? Jalan buntu?
Dialogue: 0,0:20:21.57,0:20:22.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, coba perhatikan.
Dialogue: 0,0:20:23.26,0:20:26.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma tembok ini yang bentuknya\Nberbeda sendiri.
Dialogue: 0,0:20:26.98,0:20:28.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin dibuat dengan sihir.
Dialogue: 0,0:20:30.43,0:20:31.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terasa hangat.
Dialogue: 0,0:20:31.71,0:20:33.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti baru saja dibuat.
Dialogue: 0,0:20:35.59,0:20:38.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin karena orang-orang tadi.
Dialogue: 0,0:20:39.36,0:20:41.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Empee, menjauhlah sedikit.
Dialogue: 0,0:20:44.94,0:20:46.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fireball!
Dialogue: 0,0:20:54.05,0:20:55.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Itu...
Dialogue: 0,0:20:58.95,0:21:00.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Quad Skeleton!
Dialogue: 0,0:21:00.72,0:21:02.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Master, ada orang!
Dialogue: 0,0:21:07.41,0:21:09.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku masih bisa bertarung.
Dialogue: 0,0:21:11.54,0:21:13.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Majulah!
