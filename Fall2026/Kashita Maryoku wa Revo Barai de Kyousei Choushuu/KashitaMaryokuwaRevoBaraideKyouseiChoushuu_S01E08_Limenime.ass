Dialogue: 0,0:02:00.22,0:02:02.18,sign,,0000,0000,0000,,"EPISODE 8: DUEL"
Dialogue: 0,0:03:32.69,0:03:34.61,sign,,0000,0000,0000,,"PENJELASAN CICILAN BERGULIR"
Dialogue: 0,0:05:04.78,0:05:06.97,sign,,0000,0000,0000,,"JUMLAH PINJAMAN DAYA SIHIR PARTY: 2.678.078"
Dialogue: 0,0:08:19.97,0:08:20.90,sign,,0000,0000,0000,,SUMPAH DUEL ANTARA LENT DAN GUY\NWASIT: ROGER DARI GUGUS METEOR
Dialogue: 0,0:08:25.17,0:08:27.90,sign,,0000,0000,0000,,SUMPAH DUEL ANTARA LENT DAN GUY\NWASIT: ROGER DARI GUGUS METEOR
Dialogue: 0,0:11:39.29,0:11:40.89,sign,,0000,0000,0000,,"SIHIR KEGELAPAN LEVEL 2: ENCHANT BREAK"
Dialogue: 0,0:11:40.89,0:11:41.39,sign,,0000,0000,0000,,HARGA: 10.000 DAYA SIHIR
Dialogue: 0,0:12:12.59,0:12:13.80,sign,,0000,0000,0000,,SIHIR AIR LEVEL 1: WATER FLOW\NHARGA: 1.000 DAYA SIHIR
Dialogue: 0,0:12:22.22,0:12:23.43,sign,,0000,0000,0000,,SIHIR ANGIN LEVEL 1: WIND CUTTER\NHARGA: 1.000 DAYA SIHIR
Dialogue: 0,0:14:16.84,0:14:18.55,sign,,0000,0000,0000,,SIHIR ILUSI LEVEL 2: PHANTOM ESCAPE\NHARGA: 10.000 DAYA SIHIR
Dialogue: 0,0:15:44.30,0:15:45.75,sign,,0000,0000,0000,,API NERAKA PEMBAKAR LANGIT
Dialogue: 0,0:17:52.30,0:17:54.55,sign,,0000,0000,0000,,PERLINDUNGAN PENAGIH UTANG\NHARGA: 150.000 DAYA SIHIR
Dialogue: 0,0:00:03.55,0:00:07.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menagih dengan berlebihan\Nbisa jadi sumber masalah.
Dialogue: 0,0:00:08.59,0:00:11.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,\Nbagaimana kalau seperti ini saja.
Dialogue: 0,0:00:13.21,0:00:14.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duel.
Dialogue: 0,0:00:14.85,0:00:17.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita buktikan siapa yang benar.
Dialogue: 0,0:00:41.41,0:00:44.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daya Sihir yang Dipinjam\NAkan Ditagih Paksa dengan Sistem Cicilan
Dialogue: 0,0:02:00.22,0:02:02.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya besok, ya.
Dialogue: 0,0:02:02.64,0:02:06.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak sabar melihat wajah\Nputus asa sampah-sampah itu.
Dialogue: 0,0:02:07.01,0:02:10.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kalau benar-benar harus bertarung,\Napa aku bisa melakukannya?
Dialogue: 0,0:02:11.17,0:02:13.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa baru kepikiran sekarang?
Dialogue: 0,0:02:15.43,0:02:19.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, aku ingin minta tolong\Npada kalian.
Dialogue: 0,0:02:19.63,0:02:21.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minta tolong pada kami?
Dialogue: 0,0:02:23.67,0:02:27.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Besok, aku ingin kau menjadi wasit duel.
Dialogue: 0,0:02:28.95,0:02:30.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lawan duelku adalah
Dialogue: 0,0:02:31.24,0:02:32.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang Pemecah Langit.
Dialogue: 0,0:02:33.60,0:02:35.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau menghadapi mereka sendirian?
Dialogue: 0,0:02:37.45,0:02:38.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:02:39.11,0:02:42.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guy dan yang lain akan tiba di Melba\Nmenjelang fajar besok.
Dialogue: 0,0:02:42.73,0:02:44.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu tiba, mereka akan mencariku
Dialogue: 0,0:02:44.89,0:02:46.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan mencari gara-gara denganku.
Dialogue: 0,0:02:47.41,0:02:50.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketika itu terjadi,\Naku ingin mengusulkan duel.
Dialogue: 0,0:02:51.59,0:02:55.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka tidak akan mau\Nmendengarkan penjelasanku.
Dialogue: 0,0:02:56.03,0:02:59.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kalau kau yang menjelaskan,\Npasti akan beda hasilnya.
Dialogue: 0,0:03:05.04,0:03:06.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menarik juga.
Dialogue: 0,0:03:17.61,0:03:20.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agar Tuan Master bisa bersungguh-sungguh,
Dialogue: 0,0:03:20.81,0:03:25.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebelum duel,\Nkita lihat dulu situasi sampah-sampah itu.
Dialogue: 0,0:03:26.12,0:03:27.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan aku jelaskan
Dialogue: 0,0:03:29.96,0:03:32.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}secara perlahan-lahan.
Dialogue: 0,0:03:32.69,0:03:34.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita mulai, ya.
Dialogue: 0,0:03:35.55,0:03:37.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Reaksimu biasa banget.
Dialogue: 0,0:03:37.60,0:03:38.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekali lagi,
Dialogue: 0,0:03:38.83,0:03:42.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jumlah daya sihir yang Tuan Master pinjamkan
Dialogue: 0,0:03:42.28,0:03:46.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah 2.678.087 daya sihir.
Dialogue: 0,0:03:46.36,0:03:50.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari jumlah itu, sebesar 1.435.837\Ndaya sihir sudah bisa ditagih
Dialogue: 0,0:03:50.64,0:03:55.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena masa pinjamnya\Nsudah mencapai satu tahun.
Dialogue: 0,0:03:56.88,0:03:59.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk jumlah yang sudah bisa ditagih ini,
Dialogue: 0,0:03:59.17,0:04:01.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bunganya 8% setiap 10 hari,
Dialogue: 0,0:04:01.59,0:04:05.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jumlahnya 115.000 daya\Nsihir setelah dibulatkan.
Dialogue: 0,0:04:06.03,0:04:09.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jumlah maksimum yang bisa ditagih\Ndari sampah-sampah itu dalam 10 hari
Dialogue: 0,0:04:09.48,0:04:12.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah 116.400 daya sihir.
Dialogue: 0,0:04:12.53,0:04:14.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika dikurangi...
Dialogue: 0,0:04:14.48,0:04:17.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, mereka hampir cuma bayar bunganya.
Dialogue: 0,0:04:17.64,0:04:20.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, saat ini mereka\Ndibiarkan nyaris sekarat,
Dialogue: 0,0:04:20.52,0:04:22.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi tidak sampai mati.
Dialogue: 0,0:04:23.11,0:04:24.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetapi,
Dialogue: 0,0:04:26.93,0:04:29.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}semisal bunganya kita naikkan...
Dialogue: 0,0:04:31.12,0:04:33.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang saat ini sudah 8%
Dialogue: 0,0:04:33.17,0:04:36.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dinaikkan ke batas maksimal 10%,
Dialogue: 0,0:04:38.45,0:04:42.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mereka pasti akan langsung tumbang.
Dialogue: 0,0:04:44.49,0:04:46.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, Tuan Master!
Dialogue: 0,0:04:46.19,0:04:49.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bersimpati sedikit pun pada mereka.
Dialogue: 0,0:04:49.89,0:04:52.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, sih...
Dialogue: 0,0:04:55.03,0:04:59.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, harusnya selama ini\Nmereka punya banyak waktu untuk melunasi.
Dialogue: 0,0:04:59.32,0:05:03.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi merekalah yang salah\Nkarena mengabaikan semua itu.
Dialogue: 0,0:05:04.01,0:05:04.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:05:04.78,0:05:06.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di status para pengutang,
Dialogue: 0,0:05:06.97,0:05:10.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}terpampang jumlah yang mereka pinjam.
Dialogue: 0,0:05:10.08,0:05:13.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja, mereka bisa membayarnya\Nkapan pun tanpa harus ditagih.
Dialogue: 0,0:05:13.81,0:05:18.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, mereka tidak harus pakai\Ndaya sihir sendiri untuk membayar utangnya.
Dialogue: 0,0:05:18.04,0:05:19.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitukah?
Dialogue: 0,0:05:19.41,0:05:24.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daya sihir yang dipulihkan dengan ramuan\Npemulih pun bisa dipakai untuk bayar utang.
Dialogue: 0,0:05:28.25,0:05:30.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dari awal mereka cicil dengan benar,
Dialogue: 0,0:05:30.77,0:05:34.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pasti sudah bisa dilunasi\Ntanpa memakan waktu setahun.
Dialogue: 0,0:05:35.76,0:05:38.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka telah diberikan pilihan.
Dialogue: 0,0:05:40.36,0:05:43.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, mereka tidak memilih jalan\Nuntuk melunasinya.
Dialogue: 0,0:05:47.32,0:05:48.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu,
Dialogue: 0,0:05:48.75,0:05:51.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Masterlah yang akan menentukan
Dialogue: 0,0:05:51.29,0:05:53.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa yang akan dipertaruhkan dalam duel besok.
Dialogue: 0,0:05:54.05,0:05:56.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bunganya dinaikkan,
Dialogue: 0,0:05:56.42,0:05:58.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mereka bertiga pasti...
Dialogue: 0,0:06:12.14,0:06:14.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penontonnya banyak sekali, ya.
Dialogue: 0,0:06:14.35,0:06:16.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Panggung yang sempurna, dong?
Dialogue: 0,0:06:17.01,0:06:20.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bisa pamerkan kekuatan\Ndi depan banyak orang.
Dialogue: 0,0:06:31.39,0:06:34.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengaruh Roger memang luar biasa.
Dialogue: 0,0:06:34.85,0:06:37.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semangat, Nak!
Dialogue: 0,0:06:39.05,0:06:40.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jin?!
Dialogue: 0,0:06:40.39,0:06:43.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penghasilanku seminggu\Nsudah kupertaruhkan semuanya padamu!
Dialogue: 0,0:06:44.15,0:06:46.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awas saja kalau kalah!
Dialogue: 0,0:06:46.36,0:06:48.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiga lawan satu, lo.
Dialogue: 0,0:06:48.20,0:06:50.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si Jin nekat banget, dah.
Dialogue: 0,0:06:51.53,0:06:54.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi-lagi dia bertaruh.
Dialogue: 0,0:06:55.21,0:06:58.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, Lent dan Pedang Pemecah Langit.
Dialogue: 0,0:06:58.71,0:07:01.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan nyatakan apa yang kalian pertaruhkan.
Dialogue: 0,0:07:03.56,0:07:06.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama, dari Guy sebagai perwakilan party.
Dialogue: 0,0:07:07.90,0:07:11.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kami menang,\Nhentikan semua tagihan daya sihirmu!
Dialogue: 0,0:07:12.25,0:07:13.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang, Lent, silakan.
Dialogue: 0,0:07:13.68,0:07:14.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:07:15.21,0:07:16.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku menang,
Dialogue: 0,0:07:17.37,0:07:20.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan menaikkan bunga tagihannya.
Dialogue: 0,0:07:22.21,0:07:23.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:07:23.32,0:07:24.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bunga?
Dialogue: 0,0:07:24.61,0:07:27.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini bunganya adalah 8% setiap 10 hari.
Dialogue: 0,0:07:27.55,0:07:29.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan akan kunaikkan menjadi 10%.
Dialogue: 0,0:07:30.39,0:07:32.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tagihan daya sihir dihitung\Nsetiap akhir bulan.
Dialogue: 0,0:07:32.83,0:07:36.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kebetulan, mulai besok jumlah daya sihir\Nyang bisa ditagih bertambah 90.000.
Dialogue: 0,0:07:36.77,0:07:40.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka sedang berdebat soal uang, ya?
Dialogue: 0,0:07:40.04,0:07:42.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, kayaknya soal daya sihir.
Dialogue: 0,0:07:42.44,0:07:44.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika bunganya aku naikkan jadi 10%...
Dialogue: 0,0:07:45.09,0:07:46.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Dengan kata lain...\N- Tunggu dulu.
Dialogue: 0,0:07:46.51,0:07:48.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya "bunga"?
Dialogue: 0,0:07:50.03,0:07:50.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan,
Dialogue: 0,0:07:51.79,0:07:55.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}alasan kenapa jumlah utangnya\Ntidak berkurang...
Dialogue: 0,0:07:55.65,0:07:56.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:07:56.92,0:08:00.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setiap hari aku tagih paksa\Ndaya sihir dengan bunga.
Dialogue: 0,0:08:01.08,0:08:01.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan kata lain...
Dialogue: 0,0:08:02.57,0:08:06.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daya sihir yang dipinjam\Naku tagih paksa dengan cicilan bergulir.
Dialogue: 0,0:08:07.76,0:08:11.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari tadi kau banyak bicara!
Dialogue: 0,0:08:11.91,0:08:14.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Palingan hidupmu juga akan berakhir hari ini!
Dialogue: 0,0:08:14.99,0:08:17.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, jika tidak ada yang keberatan,
Dialogue: 0,0:08:18.14,0:08:19.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}silakan kalian bersumpah.
Dialogue: 0,0:08:31.59,0:08:34.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami bersumpah untuk mematuhi hasil
Dialogue: 0,0:08:35.15,0:08:36.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dari duel suci ini.
Dialogue: 0,0:08:37.96,0:08:41.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku, Roger,\Ndari Gugus Meteor akan menjadi wasit.
Dialogue: 0,0:08:51.93,0:08:53.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau terlihat cemas.
Dialogue: 0,0:08:54.28,0:08:56.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah ini pertama kalinya kau melihat duel?
Dialogue: 0,0:08:59.68,0:09:03.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sumpah yang diucapkan tadi itu mutlak.
Dialogue: 0,0:09:03.16,0:09:05.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berbeda dengan sekadar ucapan janji.
Dialogue: 0,0:09:06.32,0:09:09.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa pun yang melanggar sumpah tersebut
Dialogue: 0,0:09:09.07,0:09:11.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan merasakan penderitaan neraka.
Dialogue: 0,0:09:15.25,0:09:16.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau yang namanya Rinka, ya?
Dialogue: 0,0:09:16.85,0:09:18.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang satu party dengan Lent.
Dialogue: 0,0:09:19.25,0:09:21.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Kenapa kau kenal aku?
Dialogue: 0,0:09:28.21,0:09:30.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak seksi dari Gugus Meteor!
Dialogue: 0,0:09:30.75,0:09:32.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namaku Namilia.
Dialogue: 0,0:09:36.32,0:09:39.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semalam kami memang\Nmenghabiskan waktu bersama.
Dialogue: 0,0:09:39.14,0:09:41.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, yang minum-minum bersama itu?
Dialogue: 0,0:09:41.24,0:09:44.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu-begitu ternyata dia sangat jantan.
Dialogue: 0,0:09:44.91,0:09:47.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sampai bergairah.
Dialogue: 0,0:09:47.85,0:09:49.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian cuma minum-minum, 'kan?
Dialogue: 0,0:09:49.83,0:09:51.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya melakukan hal lain?
Dialogue: 0,0:09:51.53,0:09:53.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma bercanda, kok.
Dialogue: 0,0:09:54.05,0:09:56.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kalau soal Lent,
Dialogue: 0,0:09:56.36,0:09:58.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bukankah kau sendiri harusnya sudah tahu?
Dialogue: 0,0:09:59.61,0:10:01.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cobalah untuk percaya.
Dialogue: 0,0:10:02.24,0:10:03.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Percaya pada kemenangannya.
Dialogue: 0,0:10:04.09,0:10:04.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:10:04.79,0:10:06.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,
Dialogue: 0,0:10:06.03,0:10:08.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}izinkan aku mengatakan sesuatu.
Dialogue: 0,0:10:09.33,0:10:12.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Master takkan kalah dalam duel ini.
Dialogue: 0,0:10:12.41,0:10:13.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak akan.
Dialogue: 0,0:10:13.87,0:10:15.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Tidak akan"?
Dialogue: 0,0:10:27.55,0:10:29.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, ini dia...
Dialogue: 0,0:10:30.24,0:10:31.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duel
Dialogue: 0,0:10:31.93,0:10:32.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dimulai!
Dialogue: 0,0:10:37.94,0:10:38.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duel
Dialogue: 0,0:10:39.43,0:10:40.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dimulai!
Dialogue: 0,0:10:43.23,0:10:45.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang mereka lakukan?
Dialogue: 0,0:10:45.40,0:10:48.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal duelnya baru dimulai,
Dialogue: 0,0:10:48.01,0:10:50.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi mereka sudah minum ramuan pemulih.
Dialogue: 0,0:10:56.37,0:10:57.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elle.
Dialogue: 0,0:10:57.27,0:10:58.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau...
Dialogue: 0,0:10:58.87,0:11:01.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau untuk membunuh si bodoh itu,
Dialogue: 0,0:11:01.67,0:11:03.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang begini aku masih bisa tahan.
Dialogue: 0,0:11:04.27,0:11:08.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jumlah sebanyak itu hanya akan langsung\Nterpotong ke tagihan hari ini.
Dialogue: 0,0:11:08.22,0:11:12.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sialan!\NPuas-puaslah sombong selagi masih bisa!
Dialogue: 0,0:11:12.60,0:11:15.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sedang menunggu, cepat diminum.
Dialogue: 0,0:11:15.85,0:11:17.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita mulai.
Dialogue: 0,0:11:18.65,0:11:21.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Formasi kemenangan seperti biasa!
Dialogue: 0,0:11:21.19,0:11:24.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini dia, sihir penguatan!
Dialogue: 0,0:11:28.40,0:11:30.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dual Boost!
Dialogue: 0,0:11:39.29,0:11:40.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enchant Break.
Dialogue: 0,0:11:41.80,0:11:44.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meremehkan sekali kau!
Dialogue: 0,0:11:45.64,0:11:48.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar keroco\Nyang tidak bisa apa-apa sendirian!
Dialogue: 0,0:11:49.49,0:11:50.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mati kau!
Dialogue: 0,0:11:57.40,0:11:58.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kau...
Dialogue: 0,0:11:59.52,0:12:01.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fireball!
Dialogue: 0,0:12:10.71,0:12:11.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Water Flow!
Dialogue: 0,0:12:18.23,0:12:19.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tebasan Angin!
Dialogue: 0,0:12:20.47,0:12:21.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wind Cutter!
Dialogue: 0,0:12:25.09,0:12:26.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak kapan dia bisa pakai sihir?
Dialogue: 0,0:12:27.47,0:12:28.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurang ajar!
Dialogue: 0,0:12:30.23,0:12:33.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata dia sangat kuat.
Dialogue: 0,0:12:38.60,0:12:40.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada akhirnya pun...
Dialogue: 0,0:12:40.84,0:12:42.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mereka mengandalkan daya sihir.
Dialogue: 0,0:12:42.88,0:12:46.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dulu juga aku dipaksa oleh mereka.
Dialogue: 0,0:12:47.04,0:12:49.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daya sihirku sudah habis.
Dialogue: 0,0:12:49.65,0:12:50.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:12:50.72,0:12:54.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, minum ini biar pulih lagi.
Dialogue: 0,0:12:55.08,0:12:57.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sudah terisi,\Nberikan daya sihirmu padaku.
Dialogue: 0,0:12:59.87,0:13:02.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buset, dia muntah.
Dialogue: 0,0:13:02.03,0:13:03.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyedihkan sekali.
Dialogue: 0,0:13:04.52,0:13:06.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat itu benar-benar menyiksa.
Dialogue: 0,0:13:07.48,0:13:09.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Lent!\N- Kenapa kau melamun?!
Dialogue: 0,0:13:09.97,0:13:11.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sedang duel, lo!
Dialogue: 0,0:13:16.27,0:13:18.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tebasan Ledakan!
Dialogue: 0,0:13:20.23,0:13:21.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lent!
Dialogue: 0,0:13:25.45,0:13:27.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak... Lent...
Dialogue: 0,0:13:28.96,0:13:32.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Oh!\N- Sayang sekali, Jin.
Dialogue: 0,0:13:32.32,0:13:35.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waduh, yang benar saja.
Dialogue: 0,0:13:35.05,0:13:36.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lent.
Dialogue: 0,0:13:36.79,0:13:38.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah berakhir.
Dialogue: 0,0:13:39.27,0:13:41.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waduh, Guy.
Dialogue: 0,0:13:41.17,0:13:43.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau terlalu serius melawan keroco.
Dialogue: 0,0:13:43.88,0:13:46.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah lama tidak pakai sihir\Npenguatan milik Elle,
Dialogue: 0,0:13:46.60,0:13:48.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku jadi kelepasan pakai seluruh kekuatanku.
Dialogue: 0,0:13:48.69,0:13:50.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mampus dia.
Dialogue: 0,0:13:51.20,0:13:55.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau melihatnya, Roger,\Nkemampuanku yang sebenarnya ini?
Dialogue: 0,0:13:58.92,0:14:02.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, kenapa mukamu menyeramkan begitu?
Dialogue: 0,0:14:23.64,0:14:26.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah melihatnya\Nberkali-kali selama lima tahun.
Dialogue: 0,0:14:26.55,0:14:29.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tebasan Ledakan, Tebasan Angin,
Dialogue: 0,0:14:29.51,0:14:30.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fireball,
Dialogue: 0,0:14:30.93,0:14:32.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan Dual Boost.
Dialogue: 0,0:14:32.91,0:14:35.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian benar-benar tidak berubah, ya.
Dialogue: 0,0:14:41.93,0:14:43.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudmu?
Dialogue: 0,0:14:43.52,0:14:44.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minum saja.
Dialogue: 0,0:14:48.91,0:14:52.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga merasa kesal kalau dibilang kalah\Ngara-gara kekurangan daya sihir.
Dialogue: 0,0:14:53.24,0:14:54.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau bilang?
Dialogue: 0,0:14:55.09,0:14:57.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kuhancurkan semua tentang kalian.
Dialogue: 0,0:15:00.05,0:15:02.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kubuat kau menyesal di neraka!
Dialogue: 0,0:15:02.68,0:15:04.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lent...?
Dialogue: 0,0:15:06.51,0:15:07.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minumnya sudah selesai?
Dialogue: 0,0:15:09.17,0:15:10.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:15:10.88,0:15:12.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak berniat menggunakannya,
Dialogue: 0,0:15:13.04,0:15:14.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi akan kutunjukkan padamu.
Dialogue: 0,0:15:14.95,0:15:16.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inilah kekuatan kami bertiga.
Dialogue: 0,0:15:16.77,0:15:18.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Formasi mematikan!
Dialogue: 0,0:15:21.27,0:15:22.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, Elle!
Dialogue: 0,0:15:22.68,0:15:24.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Spiral Boost!
Dialogue: 0,0:15:30.86,0:15:32.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fire Tornado!
Dialogue: 0,0:15:33.47,0:15:35.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Flame Aura!
Dialogue: 0,0:15:42.00,0:15:42.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Api!
Dialogue: 0,0:15:42.50,0:15:43.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Neraka!
Dialogue: 0,0:15:43.00,0:15:43.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pembakar!
Dialogue: 0,0:15:43.55,0:15:44.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Langit!
Dialogue: 0,0:15:45.75,0:15:49.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Vortex Breaker!
Dialogue: 0,0:15:53.68,0:15:58.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mati kau!
Dialogue: 0,0:16:18.04,0:16:19.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fire Tornado!
Dialogue: 0,0:16:30.71,0:16:31.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misa!
Dialogue: 0,0:16:32.64,0:16:35.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elle! Cepat pulihkan aku!
Dialogue: 0,0:16:42.81,0:16:43.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengganggu.
Dialogue: 0,0:16:54.36,0:16:56.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rentetan enam serangan apa itu?
Dialogue: 0,0:16:56.53,0:16:58.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir tingkat tinggi Fireball?
Dialogue: 0,0:16:59.24,0:17:01.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pakai sihir secara beruntun!
Dialogue: 0,0:17:01.99,0:17:04.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku saja tidak bisa, lo!
Dialogue: 0,0:17:04.04,0:17:06.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Curang, dah! Curang!
Dialogue: 0,0:17:06.83,0:17:10.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau bisa memakai sihir...
Dialogue: 0,0:17:11.45,0:17:15.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Vortex Breaker adalah jurus mematikan
Dialogue: 0,0:17:15.39,0:17:18.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang menerjang dengan tebasan bertubi-tubi
Dialogue: 0,0:17:18.08,0:17:21.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu menyemburkan api ke celah luka\Ndan menghancurkannya dari dalam.
Dialogue: 0,0:17:21.58,0:17:24.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harusnya sekali kena saja dia sudah mati.
Dialogue: 0,0:17:24.99,0:17:27.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan aku bisa pastikan dia sudah tersentuh!
Dialogue: 0,0:17:27.77,0:17:30.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kenapa tidak terluka sama sekali?
Dialogue: 0,0:17:30.77,0:17:34.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang terjadi selama kami berpisah?
Dialogue: 0,0:17:34.28,0:17:36.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lent hebat!
Dialogue: 0,0:17:36.63,0:17:39.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah dia tidak terluka karena\NPenyimpanan Sihir Tanpa Batas?
Dialogue: 0,0:17:40.37,0:17:43.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, membeli "itu" memang merepotkan.
Dialogue: 0,0:17:43.99,0:17:44.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Itu"?
Dialogue: 0,0:17:45.88,0:17:49.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya terkumpul juga 150.000 daya sihir.
Dialogue: 0,0:17:50.20,0:17:52.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, aku beli.
Dialogue: 0,0:17:54.55,0:17:57.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skill: Perlindungan Penagih Utang,\Ndiaktifkan.
Dialogue: 0,0:17:58.93,0:18:01.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai saat ini akan aktif permanen.
Dialogue: 0,0:18:02.69,0:18:05.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan ini,\Nduel besok bisa kita menangkan telak.
Dialogue: 0,0:18:06.72,0:18:07.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:18:08.24,0:18:10.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski para pengutang itu menyerang balik,
Dialogue: 0,0:18:10.94,0:18:13.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau bisa terlindungi oleh skill ini.
Dialogue: 0,0:18:15.00,0:18:16.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Efek skill-nya adalah
Dialogue: 0,0:18:16.57,0:18:20.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menetralkan serangan pengutang\Nhingga batas tertentu.
Dialogue: 0,0:18:20.65,0:18:22.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jumlah serangan yang dinetralkan
Dialogue: 0,0:18:26.64,0:18:29.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebanding dengan jumlah\Ndaya sihir yang dipinjam.
Dialogue: 0,0:18:31.63,0:18:35.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Haduh, padahal terbuat dari mithril,\Ntapi sudah rusak begini.
Dialogue: 0,0:18:35.52,0:18:37.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian rawat tidak, sih?
Dialogue: 0,0:18:37.75,0:18:40.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang-orang bodoh\Nyang meminjam hingga jutaan itu
Dialogue: 0,0:18:40.30,0:18:43.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}takkan bisa melukai Tuan Master.
Dialogue: 0,0:18:43.87,0:18:45.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh iya,
Dialogue: 0,0:18:45.45,0:18:47.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena ramuan pemulih jadi prioritas kalian,
Dialogue: 0,0:18:47.64,0:18:51.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalian jadi tidak sempat\Nbeli cairan perbaikan, ya.
Dialogue: 0,0:18:58.64,0:18:59.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terbang ke sini!
Dialogue: 0,0:19:05.40,0:19:07.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bisa dijual atau tidak, ya?
Dialogue: 0,0:19:17.21,0:19:19.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lent!
Dialogue: 0,0:19:19.55,0:19:22.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin aku kalah!
Dialogue: 0,0:19:41.47,0:19:42.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duelnya selesai!
Dialogue: 0,0:19:42.77,0:19:44.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si Abang itu kuat banget!
Dialogue: 0,0:19:44.74,0:19:46.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya!
Dialogue: 0,0:19:46.23,0:19:47.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia curang lagi!
Dialogue: 0,0:19:47.53,0:19:49.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Curang! Dasar curang!
Dialogue: 0,0:19:53.61,0:19:54.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kembalikan.
Dialogue: 0,0:19:55.50,0:19:58.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat kembalikan daya sihirku.
Dialogue: 0,0:19:59.89,0:20:02.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah kehabisan tenaga.
Dialogue: 0,0:20:04.04,0:20:05.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya kuhabiskan untuk memakai skill.
Dialogue: 0,0:20:10.47,0:20:11.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lent?
Dialogue: 0,0:20:13.13,0:20:15.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan mengada-ada.
Dialogue: 0,0:20:15.52,0:20:17.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar tidak berguna!
Dialogue: 0,0:20:25.40,0:20:27.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lah, ini ada?
Dialogue: 0,0:20:27.76,0:20:29.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jiwa yang segar.
Dialogue: 0,0:20:30.60,0:20:34.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah akan jadi berapa kalau\Ndiubah jadi daya sihir.
Dialogue: 0,0:20:34.45,0:20:37.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi setidaknya bisa\Nuntuk membayar sedikit utangmu!
Dialogue: 0,0:20:43.25,0:20:45.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kalau aku lakukan,
Dialogue: 0,0:20:47.47,0:20:49.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jiwamu ini
Dialogue: 0,0:20:51.01,0:20:53.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan terlepas dari siklus reinkarnasi
Dialogue: 0,0:20:53.61,0:20:56.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan melayang di kehampaan abadi.
Dialogue: 0,0:20:58.83,0:21:02.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi itu bukan urusanku.
Dialogue: 0,0:21:05.40,0:21:08.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan, Lent.
Dialogue: 0,0:21:10.44,0:21:11.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak,
Dialogue: 0,0:21:12.12,0:21:13.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau...
Dialogue: 0,0:21:16.88,0:21:18.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}siapa?
