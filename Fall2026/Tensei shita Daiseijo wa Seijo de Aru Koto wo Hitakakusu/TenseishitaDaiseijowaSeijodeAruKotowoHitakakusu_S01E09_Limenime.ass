Dialogue: 0,0:01:39.41,0:01:44.21,sign,,0000,0000,0000,,REINKARNASI SANTA AGUNG YANG MENYEMBUNYIKAN\NJATI DIRINYA SEBAGAI SANTA
Dialogue: 0,0:02:55.03,0:02:55.91,sign,,0000,0000,0000,,EPISODE 9: FIA, MENUJU SUTHERLAND
Dialogue: 0,0:12:30.48,0:12:31.49,sign,,0000,0000,0000,,KERAJAAN NAV, IBU KOTA KERAJAAN,\NSUTHERLAND
Dialogue: 0,0:13:50.34,0:13:52.03,sign,,0000,0000,0000,,KAPTEN ORDO KESATRIA KETIGA BELAS,
Dialogue: 0,0:13:52.03,0:13:53.75,sign,,0000,0000,0000,,KURTIS BANNISTER
Dialogue: 0,0:23:35.06,0:23:40.06,sign,,0000,0000,0000,,EPISODE 10: RATAPAN SUTHERLAND
Dialogue: 0,0:00:25.49,0:00:29.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inilah rakyat yang harus kulindungi.
Dialogue: 0,0:00:29.00,0:00:32.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baru saja memikirkan hal yang sama.
Dialogue: 0,0:00:32.29,0:00:35.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inilah pemandangan yang harus kulindungi!
Dialogue: 0,0:00:35.96,0:00:37.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu pola pikir penguasa.
Dialogue: 0,0:00:42.42,0:00:46.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rambutmu dan bendera Kerajaan Nav\Nwarnanya sama, ya.
Dialogue: 0,0:00:46.57,0:00:48.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Benarkah?
Dialogue: 0,0:00:49.37,0:00:52.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untung kamu tidak punya kekuatan santa.
Dialogue: 0,0:00:52.33,0:00:57.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau punya sedikit saja kekuatan santa,\Nkamu pasti dipuja-puja.
Dialogue: 0,0:00:58.01,0:01:00.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf menyita waktumu.
Dialogue: 0,0:01:01.01,0:01:05.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Warna rambutmu mirip benderanya,\Njadi ingin kubandingkan.
Dialogue: 0,0:01:06.49,0:01:09.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata Ketum juga\Npunya sisi kekanak-kanakan, ya.
Dialogue: 0,0:01:09.91,0:01:13.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fia, jangan pernah mewarnai rambutmu.
Dialogue: 0,0:01:13.34,0:01:14.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:01:14.73,0:01:19.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Warna rambutku\Ntidak pernah berubah sejak dulu.
Dialogue: 0,0:01:19.10,0:01:20.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak dulu...
Dialogue: 0,0:01:21.32,0:01:24.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku suka warna ini.
Dialogue: 0,0:02:55.91,0:02:58.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku, Fia Ruud, telah kembali!
Dialogue: 0,0:02:58.81,0:03:00.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang, Fia.
Dialogue: 0,0:03:01.04,0:03:05.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerjamu bagus\Ndi Ordo Kesatria Monster Keempat.
Dialogue: 0,0:03:05.08,0:03:07.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senang melihatmu kembali.
Dialogue: 0,0:03:07.67,0:03:13.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zackary dan Quentin bilang kinerjamu\Nlebih baik dari yang diharapkan.
Dialogue: 0,0:03:13.79,0:03:17.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bawahanku dipuji kapten-kapten ordo lain.
Dialogue: 0,0:03:17.43,0:03:19.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku turut bangga sebagai kapten.
Dialogue: 0,0:03:19.30,0:03:21.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}E-Eh?
Dialogue: 0,0:03:21.69,0:03:24.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mengukur daya hidup\Npara hewan kontrak.
Dialogue: 0,0:03:24.76,0:03:27.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, Zavilia yang berjasa\Nsaat pencarian naga hitam.
Dialogue: 0,0:03:27.83,0:03:30.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa aku dipuji?
Dialogue: 0,0:03:30.19,0:03:32.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, apa kabar?
Dialogue: 0,0:03:34.25,0:03:37.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena ditinggal jauh oleh seorang teman,
Dialogue: 0,0:03:37.37,0:03:39.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}semalam kamu murung.
Dialogue: 0,0:03:41.88,0:03:46.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, kemarin kita mulai berteman.
Dialogue: 0,0:03:48.65,0:03:52.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bilang kesepian karena berpisah\Ndengan seorang teman.
Dialogue: 0,0:03:52.21,0:03:56.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku menawarkan diri sebagai temanmu.
Dialogue: 0,0:03:56.23,0:03:57.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu kamu setuju.
Dialogue: 0,0:03:57.99,0:03:59.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak mungkin!
Dialogue: 0,0:03:59.61,0:04:04.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil aku setuju menjadi\Nteman Kapten Cyril!
Dialogue: 0,0:04:04.01,0:04:09.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya, kamu selalu hilang ingatan\Ntiap kali minum alkohol.
Dialogue: 0,0:04:09.22,0:04:12.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih ingat soal semalam, tidak?
Dialogue: 0,0:04:12.68,0:04:14.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ta-Tapi...
Dialogue: 0,0:04:14.34,0:04:17.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutku, berteman itu hal bagus.
Dialogue: 0,0:04:21.01,0:04:23.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baiklah.
Dialogue: 0,0:04:23.34,0:04:27.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten Cyril adalah temanku,\Ntapi bukan pengganti Zavilia!
Dialogue: 0,0:04:29.81,0:04:32.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Fia.
Dialogue: 0,0:04:32.38,0:04:36.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fia, aku mau minta tolong sebagai teman.
Dialogue: 0,0:04:36.26,0:04:41.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kapten, jadi omongan soal pertemanan tadi\Ncuma siasat untuk minta tolong?
Dialogue: 0,0:04:41.70,0:04:43.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu yang bilang, kan?
Dialogue: 0,0:04:43.39,0:04:47.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teman itu saling bercerita,\Nbermain bersama,
Dialogue: 0,0:04:47.43,0:04:49.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan berbagi banyak hal.
Dialogue: 0,0:04:49.77,0:04:52.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya iya.
Dialogue: 0,0:04:52.66,0:04:55.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten mau berbagi apa?
Dialogue: 0,0:04:56.42,0:04:58.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenanganku.
Dialogue: 0,0:04:59.13,0:05:00.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenangan?
Dialogue: 0,0:05:00.33,0:05:01.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:05:02.03,0:05:04.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku punya tempat yang penuh kenangan.
Dialogue: 0,0:05:04.53,0:05:09.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiap tahun sekitar waktu ini,\Naku pergi ke sana untuk bernostalgia.
Dialogue: 0,0:05:09.82,0:05:11.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maukah kamu ikut?
Dialogue: 0,0:05:11.95,0:05:14.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eng, lokasinya di mana?
Dialogue: 0,0:05:14.86,0:05:16.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di wilayah kekuasaanku.
Dialogue: 0,0:05:16.76,0:05:17.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wilayah kekuasaan?
Dialogue: 0,0:05:18.76,0:05:22.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, apa marga Kapten Cyril?
Dialogue: 0,0:05:22.30,0:05:27.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fia, meski bertanya seakan sudah lupa,
Dialogue: 0,0:05:27.43,0:05:31.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sejak awal kamu memang\Ntidak tahu margaku, kan?
Dialogue: 0,0:05:31.22,0:05:32.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Sutherland.
Dialogue: 0,0:05:32.71,0:05:33.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sutherland?
Dialogue: 0,0:05:33.98,0:05:35.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga!
Dialogue: 0,0:05:35.39,0:05:38.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu wilayah Kesatria Biru,\Npengawalku di kehidupan lalu!
Dialogue: 0,0:05:39.08,0:05:42.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kapten Cyril keturunan Kesatria Biru?
Dialogue: 0,0:05:42.34,0:05:44.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tahu Kesatria Biru?
Dialogue: 0,0:05:44.36,0:05:47.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal beliau tidak terlalu terkenal.
Dialogue: 0,0:05:48.71,0:05:51.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengikuti warna biru dan putih\Nbendera kerajaan,
Dialogue: 0,0:05:51.59,0:05:54.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dua orang terbaik dari ordo kesatria
Dialogue: 0,0:05:54.14,0:05:57.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan diangkat jadi Kesatria Biru\Ndan Kesatria Putih, kan?
Dialogue: 0,0:05:57.38,0:06:00.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bendera kita memang pernah\Nberwarna biru dan putih,
Dialogue: 0,0:06:00.95,0:06:03.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi itu sekitar 300 tahun lalu.
Dialogue: 0,0:06:03.76,0:06:08.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bendera Kerajaan Nav saat ini berlatar merah\Ndengan lambang naga hitam.
Dialogue: 0,0:06:08.68,0:06:10.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul juga.
Dialogue: 0,0:06:10.26,0:06:11.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eng...
Dialogue: 0,0:06:11.47,0:06:16.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti, kesatria terhebat sekarang\Nadalah Kesatria Merah?
Dialogue: 0,0:06:16.41,0:06:18.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fia, merah itu warna terlarang.
Dialogue: 0,0:06:18.90,0:06:21.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak boleh dipakai sembarangan.
Dialogue: 0,0:06:21.53,0:06:23.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Benarkah?
Dialogue: 0,0:06:23.53,0:06:26.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, merah itu warna Santa Agung.
Dialogue: 0,0:06:26.78,0:06:31.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Warna Merah Santa Agung memang\Ndikhususkan untuk beliau.
Dialogue: 0,0:06:31.97,0:06:34.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Merah Santa Agung?
Dialogue: 0,0:06:34.65,0:06:39.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pantas saja tidak ada baju\Natau tirai berwarna merah.
Dialogue: 0,0:06:39.40,0:06:43.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ja-Jadi, Kapten Cyril keturunan Kesatria Biru?
Dialogue: 0,0:06:43.54,0:06:45.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayangnya bukan.
Dialogue: 0,0:06:45.42,0:06:48.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesatria Biru terakhir tidak punya pewaris.
Dialogue: 0,0:06:48.46,0:06:52.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya wilayah Sutherland\Ndiambil alih keluarga kerajaan.
Dialogue: 0,0:06:52.86,0:06:56.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemudian diserahkan ke ayahku\Nsekitar 30 tahun lalu.
Dialogue: 0,0:06:56.71,0:06:58.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}O-Oh, begitu.
Dialogue: 0,0:06:59.32,0:07:03.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesatria Biru sangat mencintai Sutherland.
Dialogue: 0,0:07:03.78,0:07:06.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti batu nisannya ada di sana.
Dialogue: 0,0:07:06.95,0:07:12.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan ziarah ke sana\Nsekalian menemani Kapten Cyril.
Dialogue: 0,0:07:13.96,0:07:17.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, aku siap menemanimu.
Dialogue: 0,0:07:18.05,0:07:19.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:07:22.55,0:07:26.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira permintaannya akan sulit,\Nternyata tidak.
Dialogue: 0,0:07:26.54,0:07:28.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo? Fia!
Dialogue: 0,0:07:28.17,0:07:29.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lama tidak berjumpa.
Dialogue: 0,0:07:29.43,0:07:30.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, Fabian!
Dialogue: 0,0:07:31.36,0:07:35.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baru sebentar tidak berjumpa,\Naura pangeranmu makin kuat saja.
Dialogue: 0,0:07:35.99,0:07:38.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu habis melapor ke Kapten Cyril?
Dialogue: 0,0:07:38.68,0:07:39.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:07:39.70,0:07:43.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar Kapten Cyril\Nakan mewakili Pangeran Saviz
Dialogue: 0,0:07:43.19,0:07:46.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pergi ke Dukedom of Sutherland.
Dialogue: 0,0:07:47.72,0:07:52.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan mewakili ketum ordo kesatria,\Ntapi mewakili pangeran?
Dialogue: 0,0:07:52.01,0:07:52.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:07:52.82,0:07:56.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti bukan agenda ordo kesatria,\Nmelainkan agenda kerajaan?
Dialogue: 0,0:07:56.95,0:07:58.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok aku baru tahu?
Dialogue: 0,0:08:06.84,0:08:08.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:08:08.87,0:08:11.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eng...
Dialogue: 0,0:08:11.05,0:08:14.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bangunan khusus ketum ordo kesatria, kan?
Dialogue: 0,0:08:14.89,0:08:21.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah sebaiknya memajang potret kesatria\Ntersohor ketimbang Santa Agung?
Dialogue: 0,0:08:21.48,0:08:24.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pendapatmu masuk akal.
Dialogue: 0,0:08:24.01,0:08:28.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi lukisan ini sudah dipajang\Nsejak 300 tahun lalu.
Dialogue: 0,0:08:28.90,0:08:31.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak 300 tahun lalu?
Dialogue: 0,0:08:31.11,0:08:37.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketum pertama Ordo Kesatria Naga Hitam\Ndiperintah memajang lukisan ini
Dialogue: 0,0:08:37.69,0:08:39.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk selamanya.
Dialogue: 0,0:08:39.48,0:08:43.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perasaan semasa hidupku,\Nbelum ada Ordo Kesatria Naga Hitam.
Dialogue: 0,0:08:50.55,0:08:53.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiga hari lagi kamu dan Cyril\Nakan ke Sutherland, ya?
Dialogue: 0,0:08:53.55,0:08:54.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:08:54.66,0:08:57.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fia belum diberi tahu detailnya.
Dialogue: 0,0:08:57.51,0:09:01.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena menurutku lebih baik\Nmenjelaskannya di depan Ketum.
Dialogue: 0,0:09:01.96,0:09:02.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:09:04.15,0:09:07.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fia, 10 tahun lalu di Sutherland
Dialogue: 0,0:09:07.31,0:09:10.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pernah terjadi perang saudara\Nyang dijuluki Ratapan Sutherland.
Dialogue: 0,0:09:11.19,0:09:15.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak yang masih trauma\Nakibat peristiwa itu.
Dialogue: 0,0:09:16.25,0:09:21.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mayoritas warganya membenci Ordo Kesatria\Nyang gagal meredam konflik itu dengan baik.
Dialogue: 0,0:09:22.78,0:09:24.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu masih dalam pelatihan.
Dialogue: 0,0:09:25.08,0:09:27.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pergilah dengan mental calon kesatria.
Dialogue: 0,0:09:28.54,0:09:32.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkunjunglah sebagai warga,\Nbukan sebagai kesatria.
Dialogue: 0,0:09:33.62,0:09:38.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nilailah dengan matamu sendiri,\Nsiapa yang harus diadili.
Dialogue: 0,0:09:39.10,0:09:40.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:09:40.97,0:09:44.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sana banyak pemuja Santa Agung.
Dialogue: 0,0:09:44.74,0:09:48.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayangnya 10 tahun lalu aku belum\Nsepenuhnya paham soal itu.
Dialogue: 0,0:09:48.94,0:09:52.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan santa, tapi santa agung?
Dialogue: 0,0:09:52.49,0:09:54.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong,
Dialogue: 0,0:09:54.66,0:09:58.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}siapa santa agung yang paling terkenal?
Dialogue: 0,0:09:58.20,0:10:01.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja Santa Agung Serafina.
Dialogue: 0,0:10:01.20,0:10:03.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku peringkat pertama?
Dialogue: 0,0:10:03.70,0:10:07.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya dari dulu cuma ada satu santa agung.
Dialogue: 0,0:10:09.59,0:10:14.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cu-Cuma satu?\NYang diberi gelar santa agung?
Dialogue: 0,0:10:15.22,0:10:17.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pantas saja aku peringkat pertama.
Dialogue: 0,0:10:17.97,0:10:23.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Warga Sutherland pasti bereaksi\Npada warna mata dan rambutmu
Dialogue: 0,0:10:23.26,0:10:25.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang persis seperti Santa Agung legendaris.
Dialogue: 0,0:10:25.98,0:10:28.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tidak tahu apa yang akan terjadi.
Dialogue: 0,0:10:28.65,0:10:30.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan pernah sendirian.
Dialogue: 0,0:10:31.31,0:10:32.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:10:32.61,0:10:36.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paduan warnamu tiada duanya.
Dialogue: 0,0:10:36.42,0:10:37.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waspadalah.
Dialogue: 0,0:10:40.41,0:10:43.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paduan yang tiada duanya...
Dialogue: 0,0:10:47.69,0:10:55.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya aku pernah diceramahi seperti itu.
Dialogue: 0,0:11:10.66,0:11:13.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putri! Putri!
Dialogue: 0,0:11:13.49,0:11:17.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berapa kali Putri harus kuceramahi, sih?
Dialogue: 0,0:11:17.24,0:11:21.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa santa agung yang istimewa malah begini?
Dialogue: 0,0:11:21.70,0:11:26.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Habisnya aku ingin segera melihat\Nwilayah kekuasaanmu, Canopus.
Dialogue: 0,0:11:26.31,0:11:28.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi aku agak buru-buru.
Dialogue: 0,0:11:28.54,0:11:31.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agak?\NAgak, ya?
Dialogue: 0,0:11:32.92,0:11:37.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memacu kuda terus-terusan\Ndua hari dua malam dibilang "agak"?
Dialogue: 0,0:11:37.51,0:11:39.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu keterlaluan!
Dialogue: 0,0:11:40.55,0:11:42.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:11:44.95,0:11:49.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya ampun, Putri selalu saja sembrono.
Dialogue: 0,0:11:49.15,0:11:51.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku adalah pengawalmu.
Dialogue: 0,0:11:51.90,0:11:56.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melindungi dan menolongmu\Nadalah kewajibanku.
Dialogue: 0,0:11:56.70,0:11:59.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, sebagai pemimpin Sutherland,
Dialogue: 0,0:12:00.29,0:12:03.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku sangat menghargai upaya Santa Agung.
Dialogue: 0,0:12:06.28,0:12:08.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Canopus.
Dialogue: 0,0:12:09.27,0:12:13.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar aku yang memeriksa wilayah kekuasaanmu\Nsetelah 300 tahun berlalu.
Dialogue: 0,0:12:17.55,0:12:24.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini, rombongan kami menuju Selatan\Nke arah Sutherland.
Dialogue: 0,0:12:24.06,0:12:27.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerajaan Nav berbatasan dengan laut
Dialogue: 0,0:12:27.06,0:12:30.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan merupakan negara besar\Nyang menguasai bagian barat benua.
Dialogue: 0,0:12:31.49,0:12:34.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sutherland terletak di ujung selatan.
Dialogue: 0,0:12:34.90,0:12:38.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Butuh 10 hari naik kereta kuda\Ndari ibu kota.
Dialogue: 0,0:12:38.75,0:12:42.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketum tepat sekali mengutus\NKapten Cyril jadi perwakilan.
Dialogue: 0,0:12:42.77,0:12:47.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baju bangsawannya terlihat anggun,\Nlayaknya keluarga kerajaan!
Dialogue: 0,0:12:48.53,0:12:51.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pergi ke tempat baru terasa menyegarkan.
Dialogue: 0,0:12:51.85,0:12:55.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemandangannya asing dan anak-anak\Nantusias melihat ordo kesatria.
Dialogue: 0,0:12:59.30,0:13:04.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seingatku, warga Sutherland\Nsifatnya lembut dan ramah.
Dialogue: 0,0:13:05.17,0:13:07.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi tidak sabar bertemu mereka.
Dialogue: 0,0:13:11.77,0:13:15.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak kusangka Sutherland jadi begini.
Dialogue: 0,0:13:17.05,0:13:20.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan tidak ada yang menyambut\Nkepulangan pemimpin mereka.
Dialogue: 0,0:13:23.14,0:13:25.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lama tidak berjumpa, Kapten Cyril.
Dialogue: 0,0:13:25.63,0:13:29.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah jauh-jauh datang kemari.
Dialogue: 0,0:13:29.16,0:13:34.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurtis, kamu juga seorang kapten ordo,\Njadi kita ini setara.
Dialogue: 0,0:13:34.17,0:13:36.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Panggil aku Cyril saja.
Dialogue: 0,0:13:36.67,0:13:41.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, Kapten Cyril juga\Njangan bicara formal padaku.
Dialogue: 0,0:13:41.14,0:13:42.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar.
Dialogue: 0,0:13:44.76,0:13:45.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perkenalkan.
Dialogue: 0,0:13:45.90,0:13:48.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini Kurtis, kapten Ordo Kesatria Ketiga Belas.
Dialogue: 0,0:13:48.51,0:13:49.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salam kenal.
Dialogue: 0,0:13:50.34,0:13:52.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Kurtis Bannister,
Dialogue: 0,0:13:52.03,0:13:53.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}senang bisa berkenalan.
Dialogue: 0,0:13:55.81,0:13:57.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duchess?
Dialogue: 0,0:13:58.53,0:14:01.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kamu menyebutku Duchess?
Dialogue: 0,0:14:01.95,0:14:06.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudmu, karismaku setara seorang Duchess?
Dialogue: 0,0:14:06.58,0:14:10.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa dia cuma salah orang\Ndan mengira kamu Duchess.
Dialogue: 0,0:14:10.49,0:14:13.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Berarti wilayah ini punya Duke?
Dialogue: 0,0:14:16.99,0:14:21.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo? Ucapanku aneh?
Dialogue: 0,0:14:23.93,0:14:25.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo, Nona Fia.
Dialogue: 0,0:14:25.97,0:14:28.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Cyril, Duke dari Sutherland.
Dialogue: 0,0:14:29.10,0:14:33.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fia sungguh tidak peduli padaku, ya.
Dialogue: 0,0:14:33.45,0:14:36.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal semua orang tahu bahwa aku Duke.
Dialogue: 0,0:14:36.90,0:14:40.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kebetulan, Fia, silakan kalau mau bertanya.
Dialogue: 0,0:14:41.86,0:14:46.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eng, karena tadi sudah dikira Duchess,
Dialogue: 0,0:14:46.93,0:14:50.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apakah aku mirip istri Kapten Cyril?
Dialogue: 0,0:14:50.58,0:14:53.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu-Bukan begitu!\NBe-Begini...
Dialogue: 0,0:14:53.85,0:14:59.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bermaksud memastikan apakah\Naku tipe Kapten Cyril atau bukan!
Dialogue: 0,0:15:00.18,0:15:02.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku masih lajang.
Dialogue: 0,0:15:02.59,0:15:05.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cyril Sutherland, 27 tahun.
Dialogue: 0,0:15:05.22,0:15:10.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tinggi 187 cm, kedua orang tua sudah tiada\Ndan tidak punya saudara.
Dialogue: 0,0:15:10.66,0:15:13.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayahku adik raja sebelumnya.
Dialogue: 0,0:15:13.49,0:15:18.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi aku seorang Duke\Npewaris takhta urutan kedua
Dialogue: 0,0:15:18.10,0:15:20.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sekaligus kapten Ordo Kesatria Pertama.
Dialogue: 0,0:15:20.86,0:15:23.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pe-Pewaris takhta?
Dialogue: 0,0:15:23.99,0:15:28.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Kurtis maksud pasti ibuku\Nyang meninggal 10 tahun lalu.
Dialogue: 0,0:15:29.09,0:15:33.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya rambut ibuku juga\Nmerah sepertimu.
Dialogue: 0,0:15:33.62,0:15:36.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten Kurtis, aku masih 15 tahun!
Dialogue: 0,0:15:36.61,0:15:40.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa kelihatan seperti sudah\Npunya anak sebesar ini?
Dialogue: 0,0:15:40.13,0:15:43.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ogah banget punya anak hebat\Ndan tanpa celah begini!
Dialogue: 0,0:15:43.43,0:15:45.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maaf!
Dialogue: 0,0:15:45.13,0:15:48.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penglihatanku kurang baik.
Dialogue: 0,0:15:48.10,0:15:51.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah 10 tahun tidak melihat\Nrambut merah lagi di sini.
Dialogue: 0,0:15:51.25,0:15:54.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf telah salah bicara.
Dialogue: 0,0:15:54.53,0:15:59.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, dari dekat ternyata kamu gadis kesatria\Nyang manis dan berwibawa.
Dialogue: 0,0:15:59.11,0:16:03.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pantas auranya mirip Duchess.
Dialogue: 0,0:16:03.51,0:16:06.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:16:07.11,0:16:08.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu dengar itu, Fabian?
Dialogue: 0,0:16:08.84,0:16:12.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya pancaran wibawaku\Nmalah bikin salah paham!
Dialogue: 0,0:16:19.39,0:16:22.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akan menginap 10 hari di sini, kan?
Dialogue: 0,0:16:22.20,0:16:23.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:16:24.93,0:16:28.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inilah tanah yang dicintai Canopus.
Dialogue: 0,0:16:28.41,0:16:31.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Barusan Kapten Cyril sudah bilang,
Dialogue: 0,0:16:31.57,0:16:33.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}upacara resminya tanggal tujuh.
Dialogue: 0,0:16:34.18,0:16:35.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Upacara resmi...
Dialogue: 0,0:16:35.83,0:16:40.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada hari terjadinya Ratapan Sutherland,\Nkeluarga kerajaan berkunjung kemari
Dialogue: 0,0:16:40.21,0:16:44.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk mendoakan warga Sutherland\Nyang gugur, kan?
Dialogue: 0,0:16:45.28,0:16:49.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang gugur bukan hanya warga.
Dialogue: 0,0:16:49.00,0:16:53.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu dan ayah Kapten Cyril\Njuga termasuk, kan?
Dialogue: 0,0:16:53.28,0:16:54.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:17:03.41,0:17:05.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Santa Agung!
Dialogue: 0,0:17:11.10,0:17:12.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rambut merah!
Dialogue: 0,0:17:12.43,0:17:13.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mata emas!
Dialogue: 0,0:17:13.19,0:17:14.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar Santa Agung!
Dialogue: 0,0:17:20.21,0:17:21.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Santa Agung!
Dialogue: 0,0:17:22.66,0:17:25.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat juga kamu bisa menjatuhkanku!
Dialogue: 0,0:17:25.81,0:17:27.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nih!
Dialogue: 0,0:17:27.35,0:17:28.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan!
Dialogue: 0,0:17:28.79,0:17:30.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}He-Hentikan, dong!
Dialogue: 0,0:17:30.43,0:17:32.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelihatan seru, ya, Fia.
Dialogue: 0,0:17:33.06,0:17:34.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kapten Cyril!
Dialogue: 0,0:17:38.88,0:17:41.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, yah...
Dialogue: 0,0:17:41.00,0:17:44.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eng, barusan itu latihan.
Dialogue: 0,0:17:53.25,0:17:56.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka anak-anak baik dan ceria.
Dialogue: 0,0:17:56.20,0:18:00.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, semoga mereka tumbuh sehat di sini.
Dialogue: 0,0:18:00.49,0:18:03.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti bisa kalau di wilayah\Nyang dipimpin Kapten.
Dialogue: 0,0:18:03.49,0:18:05.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:18:06.74,0:18:11.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buktinya setelah melihatku,\Nanak-anak tadi pergi.
Dialogue: 0,0:18:16.39,0:18:18.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eng...
Dialogue: 0,0:18:18.08,0:18:21.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten Cyril dan Kapten Kurtis akrab, ya?
Dialogue: 0,0:18:22.01,0:18:25.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awalnya aku anggota Ordo Kesatria Pertama,
Dialogue: 0,0:18:25.16,0:18:27.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bawahan Kapten Cyril.
Dialogue: 0,0:18:27.80,0:18:31.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dulu kesatria biasa,
Dialogue: 0,0:18:31.03,0:18:35.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu diangkat Kapten Cyril\Njadi kapten Ordo Kesatria Ketiga Belas.
Dialogue: 0,0:18:35.43,0:18:39.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurtis setiap tahun menemaniku\Nberkunjung kemari.
Dialogue: 0,0:18:40.16,0:18:43.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Warga wilayah ini muak terhadap kesatria.
Dialogue: 0,0:18:43.73,0:18:49.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi entah kenapa cuma Kurtis\Nyang mereka anggap teman.
Dialogue: 0,0:18:49.94,0:18:52.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski kurang dari segi kekuatan,
Dialogue: 0,0:18:52.53,0:18:57.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku direkomendasikan jadi kapten\Nkarena dekat dengan masyarakat.
Dialogue: 0,0:18:57.25,0:18:58.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurtis!
Dialogue: 0,0:18:58.41,0:19:01.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatanmu sudah sangat cukup!
Dialogue: 0,0:19:01.81,0:19:03.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih atas kepeduliannya.
Dialogue: 0,0:19:04.58,0:19:09.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi sudah bukan waktunya murung\Nkarena merasa lemah.
Dialogue: 0,0:19:09.89,0:19:12.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah paham betul kemampuanku
Dialogue: 0,0:19:12.89,0:19:15.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan akan melakukan yang terbaik.
Dialogue: 0,0:19:16.39,0:19:18.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf kalau begitu.
Dialogue: 0,0:19:23.54,0:19:25.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fia, aku mau minta tolong.
Dialogue: 0,0:19:29.19,0:19:31.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kapten Cyril?
Dialogue: 0,0:19:33.86,0:19:38.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini permintaan sebagai teman,\Nkamu berhak menolak.
Dialogue: 0,0:19:40.93,0:19:45.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak-anak tadi memanggilmu\NSanta Agung, kan?
Dialogue: 0,0:19:45.54,0:19:49.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sini rambut merah identik\Ndengan Santa Agung.
Dialogue: 0,0:19:49.59,0:19:50.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:19:51.53,0:19:57.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemicu Ratapan Sutherland juga\Nibuku yang berambut merah.
Dialogue: 0,0:19:57.75,0:20:03.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi warga yang tahu insiden itu\Nantipati terhadap rambut merah.
Dialogue: 0,0:20:04.55,0:20:07.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu di wilayah ini terhenti\Nselama 10 tahun.
Dialogue: 0,0:20:08.21,0:20:10.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hal itu tidak menguntungkan siapa pun.
Dialogue: 0,0:20:11.36,0:20:15.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya kita butuh langkah berani\Nuntuk mengatasinya.
Dialogue: 0,0:20:17.43,0:20:22.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fia, aku ingin kamu memikul peran itu\Nsebagai pemilik rambut merah.
Dialogue: 0,0:20:23.81,0:20:30.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Antipati warga terhadap rambut merah\Nbisa saja membahayakanmu.
Dialogue: 0,0:20:31.38,0:20:35.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau menolak, kamu akan ditugaskan\Ndi kediaman pemimpin.
Dialogue: 0,0:20:35.43,0:20:36.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi tidak perlu khawatir.
Dialogue: 0,0:20:37.67,0:20:38.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:20:39.46,0:20:45.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa pun pilihannya, aku ingin kamu\Nmelihat kondisi di sini dulu.
Dialogue: 0,0:20:47.83,0:20:52.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu.\NKapten Cyril menderita.
Dialogue: 0,0:20:53.33,0:20:59.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama 10 tahun jadi pemimpin,\Npasti Kapten sudah mencoba banyak hal.
Dialogue: 0,0:20:59.00,0:21:01.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi semuanya gagal
Dialogue: 0,0:21:01.89,0:21:06.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hingga karena putus asa,\Ndia minta bantuan kesatria biasa sepertiku.
Dialogue: 0,0:21:07.09,0:21:12.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski bisa langsung memerintah,\Ndia repot-repot menjalin pertemanan
Dialogue: 0,0:21:12.46,0:21:15.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan memberiku pilihan untuk menolak.
Dialogue: 0,0:21:15.21,0:21:18.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh kesatria yang baik hati.
Dialogue: 0,0:21:21.97,0:21:27.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin kebaikan ini\Ndirasakan oleh para warga.
Dialogue: 0,0:21:28.73,0:21:32.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten Cyril pemimpin yang hebat.
Dialogue: 0,0:21:32.45,0:21:34.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga suka warga Sutherland.
Dialogue: 0,0:21:35.15,0:21:40.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya aneh hidup tidak rukun,\Npadahal tidak ada yang salah.
Dialogue: 0,0:21:40.83,0:21:44.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah sejauh mana bisa berguna,
Dialogue: 0,0:21:45.99,0:21:47.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi izinkan aku membantu.
Dialogue: 0,0:21:55.69,0:21:58.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Fia.
