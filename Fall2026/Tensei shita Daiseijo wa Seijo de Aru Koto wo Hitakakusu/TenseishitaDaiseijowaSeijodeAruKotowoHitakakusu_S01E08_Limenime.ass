Dialogue: 0,0:01:03.46,0:01:08.26,sign,,0000,0000,0000,,REINKARNASI SANTA AGUNG YANG MENYEMBUNYIKAN\NJATI DIRINYA SEBAGAI SANTA
Dialogue: 0,0:02:18.99,0:02:24.00,sign,,0000,0000,0000,,EPISODE 8: TEMAN IMUTKU
Dialogue: 0,0:23:34.98,0:23:39.98,sign,,0000,0000,0000,,EPISODE 9: FIA, MENUJU SUTHERLAND
Dialogue: 0,0:00:06.07,0:00:11.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah melindungiku,\Nbiar kami para kesatria yang urus sisanya.
Dialogue: 0,0:00:11.07,0:00:13.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ra-Raja Naga Hitam?
Dialogue: 0,0:00:13.48,0:00:15.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sa-Sang naga legendaris!
Dialogue: 0,0:00:15.33,0:00:18.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luar biasa!\NWujudnya begitu gagah!
Dialogue: 0,0:00:18.60,0:00:21.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak kusangka bisa melihatnya!
Dialogue: 0,0:00:22.82,0:00:26.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat, aku berhalusinasi saking takutnya.
Dialogue: 0,0:00:26.48,0:00:30.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fia terlihat bicara dengan Raja Naga Hitam\Ndan menyentuhnya dengan akrab!
Dialogue: 0,0:00:30.93,0:00:32.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zavilia?
Dialogue: 0,0:00:32.18,0:00:36.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fia, terima kasih sudah memaklumi rengekanku
Dialogue: 0,0:00:36.67,0:00:39.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang enggan melawan naga biru.
Dialogue: 0,0:00:39.84,0:00:41.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku telah keliru.
Dialogue: 0,0:00:42.66,0:00:46.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata yang kuinginkan melindungimu.
Dialogue: 0,0:00:47.07,0:00:47.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:03:03.66,0:03:06.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zavilia ternyata sekuat itu?
Dialogue: 0,0:03:07.70,0:03:10.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya dia masih anak-anak?
Dialogue: 0,0:03:11.81,0:03:12.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo?
Dialogue: 0,0:03:12.91,0:03:16.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zavilia, sejak kapan kamu punya tanduk?
Dialogue: 0,0:03:16.69,0:03:20.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fia, aku berniat menjadi raja.
Dialogue: 0,0:03:20.06,0:03:22.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Ra-Raja?
Dialogue: 0,0:03:24.01,0:03:26.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak monster yang membentuk kawanan.
Dialogue: 0,0:03:26.92,0:03:29.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suatu saat aku bisa kalah karena jumlah.
Dialogue: 0,0:03:30.32,0:03:34.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya, aku akan jadi raja\Ndan menundukkan semua naga.
Dialogue: 0,0:03:35.19,0:03:39.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, ya...\NBaiklah kalau itu maumu.
Dialogue: 0,0:03:39.85,0:03:43.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Naga hitam akan punya tiga tanduk\Nkalau jadi raja.
Dialogue: 0,0:03:44.34,0:03:48.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awalnya aku tidak berminat menjadi raja.
Dialogue: 0,0:03:48.09,0:03:51.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi saat melindungimu,\Ntumbuh satu tanduk.
Dialogue: 0,0:03:52.06,0:03:54.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada raja yang sendirian.
Dialogue: 0,0:03:54.66,0:03:57.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah menaklukkan banyak naga,
Dialogue: 0,0:03:57.56,0:03:59.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan jadi raja
Dialogue: 0,0:03:59.40,0:04:02.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan tiga tanduk sebagai tandanya.
Dialogue: 0,0:04:04.56,0:04:08.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenekatanmu benar-benar di luar dugaan.
Dialogue: 0,0:04:08.36,0:04:12.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan kembali setelah layak\Njadi sosok pelindungmu.
Dialogue: 0,0:04:12.24,0:04:12.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:04:12.91,0:04:14.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Zavilia, astaga...\N- Astaga!
Dialogue: 0,0:04:14.94,0:04:17.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanduknya Tuan Raja Naga Hitam!
Dialogue: 0,0:04:19.06,0:04:20.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku titip Fia.
Dialogue: 0,0:04:21.12,0:04:25.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pastikan dia tetap hidup sampai aku kembali.
Dialogue: 0,0:04:26.22,0:04:28.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu upahnya.
Dialogue: 0,0:04:28.00,0:04:32.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi melindungi Fia,\Nganti pedang tumpul kalian dengan itu.
Dialogue: 0,0:04:32.88,0:04:36.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ta-Tanduk Tuan Raja Naga Hitam\Njadi pedangku?
Dialogue: 0,0:04:36.26,0:04:41.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bersumpah akan melindungi Nona Fia\Nmeski harus berkorban nyawa!
Dialogue: 0,0:04:42.51,0:04:44.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fia.
Dialogue: 0,0:04:44.56,0:04:46.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita ini terhubung.
Dialogue: 0,0:04:47.02,0:04:50.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu kenapa-kenapa,\Naku akan mati duluan.
Dialogue: 0,0:04:50.06,0:04:50.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:04:51.30,0:04:55.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jujur, aku masih ingin mencoba\Nbanyak hal bersamamu,
Dialogue: 0,0:04:55.34,0:04:57.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi jangan terlalu nekat, ya.
Dialogue: 0,0:04:57.65,0:05:00.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak akan!\NAku janji akan hati-hati!
Dialogue: 0,0:05:01.90,0:05:04.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu cukup jadi diri sendiri saja.
Dialogue: 0,0:05:05.38,0:05:07.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pasti datang kalau dipanggil.
Dialogue: 0,0:05:08.17,0:05:10.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebelum kamu keburu melupakanku
Dialogue: 0,0:05:10.50,0:05:12.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku pasti akan pulang.
Dialogue: 0,0:05:13.40,0:05:14.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai jumpa.
Dialogue: 0,0:05:18.93,0:05:19.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:05:20.92,0:05:23.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wahai teman imutku yang manja,
Dialogue: 0,0:05:23.75,0:05:30.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tukang tidur, cemburuan, penyindir,\Ntapi selalu membelaku.
Dialogue: 0,0:05:30.38,0:05:33.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zavilia, aku menyayangimu.
Dialogue: 0,0:05:33.17,0:05:36.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menunggu kepulanganmu.
Dialogue: 0,0:05:50.93,0:05:54.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}O-Oh, iya!\NKapten Quentin, lempar batunya!
Dialogue: 0,0:05:54.94,0:05:57.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lempar batu dari Gunung Hitam Legam!
Dialogue: 0,0:05:57.04,0:05:59.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baik!\NEh, waduh?
Dialogue: 0,0:06:05.53,0:06:11.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya-Yah, meski urutannya kacau,\Nprosedur sudah terpenuhi, kan?
Dialogue: 0,0:06:11.18,0:06:12.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian, sadarlah!
Dialogue: 0,0:06:13.31,0:06:15.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa dengar suaraku, tidak?
Dialogue: 0,0:06:16.73,0:06:20.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya bertemu Raja Naga Hitam\Nbikin kalian linglung.
Dialogue: 0,0:06:20.98,0:06:24.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ingat, sebagian besar hal\Nyang kalian lihat dan dengar
Dialogue: 0,0:06:24.61,0:06:26.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah halusinasi akibat rasa takut!
Dialogue: 0,0:06:27.24,0:06:28.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:06:28.50,0:06:32.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti akan kujelaskan mana yang nyata\Ndan mana yang halusinasi.
Dialogue: 0,0:06:32.68,0:06:35.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya tutup mulut saja dulu!\NPaham?
Dialogue: 0,0:06:35.68,0:06:36.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap!
Dialogue: 0,0:06:36.54,0:06:40.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, tiga orang di sisi kanan,\Ncari para santa.
Dialogue: 0,0:06:40.18,0:06:42.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sisanya gabung dengan regu lain.
Dialogue: 0,0:06:42.05,0:06:44.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita keluar dari hutan sehabis istirahat!
Dialogue: 0,0:06:44.30,0:06:45.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:06:45.93,0:06:49.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fia, kamu yang paling linglung.
Dialogue: 0,0:06:49.25,0:06:50.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paling kritis!
Dialogue: 0,0:06:50.18,0:06:51.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Aku?
Dialogue: 0,0:07:01.15,0:07:05.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, pasti kalian berdua\Npunya cerita untukku, kan?
Dialogue: 0,0:07:05.85,0:07:09.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepanjang apa pun akan kudengarkan,\Ncepat jelaskan!
Dialogue: 0,0:07:09.66,0:07:13.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tumben kamu ingin mendengar ceritaku.
Dialogue: 0,0:07:14.75,0:07:17.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah lihat keagungan\NTuan Raja Naga Hitam, kan?
Dialogue: 0,0:07:17.84,0:07:20.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa sangka wujud naganya\Nberevolusi jadi spesies purba.
Dialogue: 0,0:07:20.61,0:07:22.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Betapa sempurna...\N- Oke, paham.
Dialogue: 0,0:07:22.05,0:07:25.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Intinya kamu tidak mengerti\Nucapanku sedikit pun.
Dialogue: 0,0:07:25.76,0:07:30.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fia, darimu saja.\NBeri aku penjelasan.
Dialogue: 0,0:07:30.01,0:07:32.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.\NAku sedang kritis!
Dialogue: 0,0:07:32.57,0:07:33.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:07:33.06,0:07:36.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bilang aku sedang linglung, kan?
Dialogue: 0,0:07:36.62,0:07:41.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesatria baru sepertiku bisa makan sama\Npara kapten berpangkat tinggi saja
Dialogue: 0,0:07:41.65,0:07:43.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sudah jelas halusinasi!
Dialogue: 0,0:07:43.28,0:07:46.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, tunggu!\NLinglung yang kumaksud bukan itu!
Dialogue: 0,0:07:46.76,0:07:48.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu, jadi...
Dialogue: 0,0:07:48.37,0:07:52.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, Zackary ingin memuja Nona Fia\Nbak dewi dari kayangan
Dialogue: 0,0:07:52.42,0:07:56.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena bisa menundukkan\NTuan Raja Naga Hitam yang perkasa.
Dialogue: 0,0:07:57.21,0:07:59.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kenapa, sih?
Dialogue: 0,0:07:59.09,0:08:01.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi ini yang dimaksud Ketum
Dialogue: 0,0:08:01.26,0:08:04.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bahwa para kesatria jadi aneh\Nkalau bergaul sama Fia?
Dialogue: 0,0:08:04.81,0:08:09.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zackary, selama ini kamu tidak peka\Ndan cuma percaya apa yang terlihat.
Dialogue: 0,0:08:09.49,0:08:11.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi ini waktunya berubah!
Dialogue: 0,0:08:11.60,0:08:14.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cerewet! Kamu diam saja!
Dialogue: 0,0:08:14.02,0:08:15.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasakan dan terima kehebatan Nona Fia!
Dialogue: 0,0:08:15.82,0:08:16.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang...
Dialogue: 0,0:08:16.85,0:08:19.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian berdua, hentikan.
Dialogue: 0,0:08:20.65,0:08:22.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sudah begini...
Dialogue: 0,0:08:22.37,0:08:24.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo makan sama-sama.
Dialogue: 0,0:08:25.90,0:08:29.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian dongkol karena sedang lapar.
Dialogue: 0,0:08:29.13,0:08:30.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayak anak kecil, deh.
Dialogue: 0,0:08:39.36,0:08:40.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fia.
Dialogue: 0,0:08:40.24,0:08:41.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya?
Dialogue: 0,0:08:47.30,0:08:48.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:08:49.34,0:08:50.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:08:50.98,0:08:53.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya ini kuucapkan\Nsebelum mencecarmu.
Dialogue: 0,0:08:53.98,0:08:57.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak adanya korban jiwa\Nmeski banyak serangan monster
Dialogue: 0,0:08:57.80,0:08:59.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah berkatmu.
Dialogue: 0,0:08:59.48,0:09:02.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai kapten ordo kesatria,\Naku berterima kasih.
Dialogue: 0,0:09:02.24,0:09:05.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, Kapten Zackary!\NAku tidak berbuat banyak!
Dialogue: 0,0:09:05.32,0:09:08.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zavi... Naga hitam\Ndan para kesatria yang berjasa!
Dialogue: 0,0:09:08.42,0:09:09.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Angkat kepalamu.
Dialogue: 0,0:09:12.63,0:09:17.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fia, kekuatan rahasiamu dipakai\Ndemi melindungi para kesatria, kan?
Dialogue: 0,0:09:17.81,0:09:24.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}E-Eh, ada yang aku rahasiakan?\NSampai kupakai segala?
Dialogue: 0,0:09:24.58,0:09:27.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Nona Fia mencoba\Nmerahasiakan kekuatan?
Dialogue: 0,0:09:27.33,0:09:31.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku salut pada sikapnya\Nyang terbuka dan blak-blakan.
Dialogue: 0,0:09:31.58,0:09:34.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagian mana yang dirahasiakan?
Dialogue: 0,0:09:34.00,0:09:35.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Situasi apa ini?
Dialogue: 0,0:09:35.82,0:09:39.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten Zackary tahu sejauh mana?\NKapten Quentin sedang membelaku?
Dialogue: 0,0:09:39.77,0:09:42.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyadari ciri khas para monster.
Dialogue: 0,0:09:43.02,0:09:45.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengetahui jumlah monster di regu lain.
Dialogue: 0,0:09:46.30,0:09:48.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengendalikan hewan kontrak kesatria lain.
Dialogue: 0,0:09:48.99,0:09:52.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan menundukkan naga hitam.
Dialogue: 0,0:09:52.90,0:09:55.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma kamu yang bisa melakukan semua itu.
Dialogue: 0,0:09:55.58,0:09:59.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, dia belum tahu bahwa aku santa.
Dialogue: 0,0:09:59.58,0:10:04.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan spesial itu belum pernah ditunjukkan,\Njadi kupikir kamu merahasiakannya.
Dialogue: 0,0:10:05.47,0:10:10.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kali ini, daripada merahasiakannya,\Nkamu memilih melindungi para kesatria.
Dialogue: 0,0:10:10.47,0:10:13.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fia, aku menghormati pilihanmu.
Dialogue: 0,0:10:14.43,0:10:18.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu menceritakan semuanya.\NCeritakan saja yang kamu mau.
Dialogue: 0,0:10:19.26,0:10:21.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten Zackary...
Dialogue: 0,0:10:21.47,0:10:23.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku seorang kesatria.
Dialogue: 0,0:10:23.89,0:10:28.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku bersumpah sebagai kapten\NOrdo Kesatria Naga Hitam Kerajaan Nav
Dialogue: 0,0:10:28.86,0:10:31.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan menjaga rahasiamu.
Dialogue: 0,0:10:31.97,0:10:36.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zackary, jasa-jasa besar Nona Fia\Nyang kamu sebutkan tadi
Dialogue: 0,0:10:36.62,0:10:39.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kemungkinan besar berkat\NTuan Raja Naga Hitam.
Dialogue: 0,0:10:39.67,0:10:41.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Naga Hitam?
Dialogue: 0,0:10:41.41,0:10:45.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, monster biru yang bertengger\Ndi pundak Nona Fia
Dialogue: 0,0:10:45.18,0:10:47.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah Tuan Raja Naga Hitam yang menyamar.
Dialogue: 0,0:10:48.33,0:10:53.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wawasan dan kendali atas para monster itu\Nmilik Tuan Raja Naga Hitam.
Dialogue: 0,0:10:53.99,0:10:55.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah itu, Fia?
Dialogue: 0,0:10:55.43,0:11:01.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}E-Eng... Sudah pasti Zavi...\NNaga Hitam tahu ciri khas para monster.
Dialogue: 0,0:11:01.65,0:11:06.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu jenis dan jumlah para monster\Nkarena diberi tahu Naga Hitam.
Dialogue: 0,0:11:06.48,0:11:11.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para hewan kontrak patuh\Nberkat bunyi mengancam Naga Hitam.
Dialogue: 0,0:11:12.62,0:11:15.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau itu jawabanmu, akan kuterima.
Dialogue: 0,0:11:15.99,0:11:19.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo? Kok reaksinya terasa ambigu?
Dialogue: 0,0:11:19.45,0:11:24.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi ini faktanya.\NWalau faktor santanya dibuang, sih.
Dialogue: 0,0:11:24.90,0:11:30.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau justru ini saatnya aku mengakui\Njati diri sebagai santa?
Dialogue: 0,0:11:31.94,0:11:32.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten Zackary...
Dialogue: 0,0:11:35.81,0:11:36.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fia!
Dialogue: 0,0:11:39.92,0:11:43.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa, kekuatannya terlalu timpang.
Dialogue: 0,0:11:44.32,0:11:48.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten Zackary kuat, Kapten Quentin juga.
Dialogue: 0,0:11:48.64,0:11:52.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zavilia, Ketum Saviz,
Dialogue: 0,0:11:52.75,0:11:55.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan Kapten Cyril pun kuat.
Dialogue: 0,0:11:56.09,0:12:00.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi Tangan Kanan Raja Iblis\Njauh melampaui mereka!
Dialogue: 0,0:12:00.82,0:12:03.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tahu aku santa,
Dialogue: 0,0:12:03.21,0:12:06.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}majin itu pasti akan membunuhku.
Dialogue: 0,0:12:07.72,0:12:10.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau para kapten mencoba melindungiku...
Dialogue: 0,0:12:17.37,0:12:20.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal dia janji akan menjaga rahasiaku.
Dialogue: 0,0:12:20.01,0:12:22.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa membalas ketulusannya itu
Dialogue: 0,0:12:23.18,0:12:25.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menyakitkan sekali.
Dialogue: 0,0:12:27.02,0:12:27.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fia.
Dialogue: 0,0:12:29.89,0:12:33.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fia, kamu bisa dengar detak jantungku?
Dialogue: 0,0:12:34.96,0:12:39.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, selaraskan irama jantung kita.
Dialogue: 0,0:12:40.64,0:12:42.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buang napas pelan-pelan.
Dialogue: 0,0:12:44.05,0:12:46.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, pintar.
Dialogue: 0,0:12:47.36,0:12:48.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:12:49.17,0:12:54.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diulang ratusan kali pun,\Npilihanku tetap sama.
Dialogue: 0,0:12:54.37,0:12:56.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan mengungkapkan
Dialogue: 0,0:12:57.46,0:12:59.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jati diri sebagai santa.
Dialogue: 0,0:13:05.29,0:13:07.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fia, maaf.
Dialogue: 0,0:13:07.81,0:13:11.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku terlalu memaksa.\NMari akhiri topik ini.
Dialogue: 0,0:13:11.31,0:13:15.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita wajib lapor ke Ketum Saviz\Nsoal kejadian ini.
Dialogue: 0,0:13:16.04,0:13:18.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi akan kukaji dulu laporannya.
Dialogue: 0,0:13:18.69,0:13:20.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kupastikan kamu aman.
Dialogue: 0,0:13:23.78,0:13:28.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah melempar batu Gunung Hitam Legam,\NNaga Hitam kembali ke sarangnya.
Dialogue: 0,0:13:28.58,0:13:30.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Laporan selengkapnya akan menyusul.
Dialogue: 0,0:13:31.14,0:13:35.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus.\NUsut secara menyeluruh.
Dialogue: 0,0:13:35.38,0:13:36.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap!
Dialogue: 0,0:13:37.45,0:13:40.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanduk pemberian Tuan Raja Naga Hitam
Dialogue: 0,0:13:40.12,0:13:44.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kuanggap sebagai izin bagi kita\Nuntuk mengaku sebagai sekutunya.
Dialogue: 0,0:13:44.76,0:13:46.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau cuma ke segelintir orang,
Dialogue: 0,0:13:46.64,0:13:51.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita boleh mengakui bahwa Tuan Raja Naga Hitam\Nadalah hewan kontrak Nona Fia, kan?
Dialogue: 0,0:13:51.36,0:13:52.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:13:52.59,0:13:58.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Risiko semacam ini harus kita bagi dengan\NCyril dan Desmond yang tahu segala hal.
Dialogue: 0,0:13:59.98,0:14:03.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, hewan kontrak Fia adalah naga hitam.
Dialogue: 0,0:14:03.57,0:14:04.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:14:04.45,0:14:08.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zackary, aku sedang tidak bisa\Nmeladeni candaanmu.
Dialogue: 0,0:14:08.69,0:14:10.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula itu tidak lucu.
Dialogue: 0,0:14:10.45,0:14:13.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Desmond, Zackary mengatakan fakta.
Dialogue: 0,0:14:13.36,0:14:16.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini, pemilik harus jauh\Nlebih kuat dari monster
Dialogue: 0,0:14:16.82,0:14:19.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau mau menundukkannya.
Dialogue: 0,0:14:19.01,0:14:21.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa Fia lebih kuat dari naga hitam?
Dialogue: 0,0:14:26.79,0:14:28.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini tanduk Tuan Raja Naga Hitam.
Dialogue: 0,0:14:28.84,0:14:31.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Raja Naga Hitam memberikan\Ntanduk ini sebagai upah
Dialogue: 0,0:14:31.75,0:14:34.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}agar aku dan Zackary melindungi Nona Fia.
Dialogue: 0,0:14:35.77,0:14:38.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Langsung percaya memang sulit.
Dialogue: 0,0:14:38.78,0:14:41.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi hewan kontrak Fia memang naga hitam.
Dialogue: 0,0:14:41.69,0:14:43.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan pakai kekuatan.
Dialogue: 0,0:14:43.17,0:14:47.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Fia menjinakkan Tuan Raja Naga Hitam\Ndengan faktor lain.
Dialogue: 0,0:14:50.54,0:14:54.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menundukkan spesies purba\Nseperti Raja Naga Hitam?
Dialogue: 0,0:14:54.76,0:14:58.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, mungkin Fia ujian dari Tuhan untukku.
Dialogue: 0,0:14:58.67,0:15:02.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kalau itu benar,\Nbagaimana kita harus menyikapi Fia?
Dialogue: 0,0:15:02.64,0:15:05.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, Naga Hitam pulang ke sarangnya, kan?
Dialogue: 0,0:15:05.69,0:15:07.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jauh dari pemiliknya...
Dialogue: 0,0:15:07.30,0:15:11.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal itu, Nona Fia terhubung sempurna\Ndengan Tuan Raja Naga Hitam.
Dialogue: 0,0:15:12.48,0:15:17.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena penjinakan total,\NNaga Hitam bisa tahu pikiran Fia.
Dialogue: 0,0:15:17.42,0:15:22.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kalau Naga Hitam merasa\NFia dibuat tersinggung,
Dialogue: 0,0:15:22.90,0:15:26.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin kamu akan masuk\Ndaftar eksekusi sang Naga Hitam.
Dialogue: 0,0:15:27.33,0:15:28.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tu-Tunggu sebentar!
Dialogue: 0,0:15:28.90,0:15:32.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memang rela berkorban\Nsebagai kapten ordo kesatria,
Dialogue: 0,0:15:32.58,0:15:36.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi masa harus mati cuma gara-gara\Npertemanan Fia dan Naga Hitam?
Dialogue: 0,0:15:36.52,0:15:40.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cyril, ini karena didikanmu kurang ketat!
Dialogue: 0,0:15:40.54,0:15:45.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak dikabari duluan\Nkarena tidak dipercayai Fia, kan?
Dialogue: 0,0:15:45.28,0:15:50.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, akan kuusahakan jadi orang\Nyang bisa Fia percaya agar dikabari duluan.
Dialogue: 0,0:15:50.73,0:15:51.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, bagus...
Dialogue: 0,0:15:51.62,0:15:55.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya tunaikan tugasmu juga, ya.
Dialogue: 0,0:15:55.88,0:16:01.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gunakan tubuhmu untuk memastikan\Nhubungan Fia dan hewan kontraknya.
Dialogue: 0,0:16:01.78,0:16:03.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bersedia, kan, Desmond?
Dialogue: 0,0:16:04.97,0:16:08.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maaf menyalahkanmu seenaknya!\NAku kekanak-kanakan!
Dialogue: 0,0:16:08.98,0:16:10.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kapten Cyril!
Dialogue: 0,0:16:12.18,0:16:13.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu...
Dialogue: 0,0:16:13.31,0:16:15.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permohonan turun pangkat.
Dialogue: 0,0:16:15.52,0:16:19.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin berhenti dari jabatan wakil kapten\NOrdo Kesatria Monster Keempat!
Dialogue: 0,0:16:19.00,0:16:20.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, Gideon!\NApa-apaan kamu?
Dialogue: 0,0:16:20.88,0:16:26.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku telah berbuat lancang terhadap\NFia dan Tuan Raja Naga Hitam!
Dialogue: 0,0:16:26.01,0:16:29.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa sangka monster biru kecil itu\Nadalah Tuan Raja Naga Hitam.
Dialogue: 0,0:16:29.63,0:16:31.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sih wajar.
Dialogue: 0,0:16:31.28,0:16:36.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul, lehernya terlalu panjang dan janggal\Nuntuk seekor Merpati Biru.
Dialogue: 0,0:16:36.63,0:16:40.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak layak jadi wakil kapten!
Dialogue: 0,0:16:41.70,0:16:45.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu katanya.\NMau bagaimana, Quentin?
Dialogue: 0,0:16:45.89,0:16:48.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku paham perasaan Gideon.
Dialogue: 0,0:16:48.50,0:16:51.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada salahnya mengundurkan diri.
Dialogue: 0,0:16:51.50,0:16:52.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Quentin...
Dialogue: 0,0:16:52.78,0:16:58.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga berniat turun dari posisi kapten\Nlalu menjadi wakil kapten.
Dialogue: 0,0:16:58.02,0:16:59.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan ngawur!
Dialogue: 0,0:16:59.61,0:17:02.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu mundur,\Nposisi kapten bakal kosong!
Dialogue: 0,0:17:02.80,0:17:05.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk posisi kapten\NOrdo Kesatria Monster Keempat,
Dialogue: 0,0:17:05.52,0:17:07.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku mengusulkan Nona Fia!
Dialogue: 0,0:17:09.92,0:17:15.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hewan kontrak Nona Fia itu Tuan Raja Naga Hitam,\Ndan beliau bisa mengendalikan hewan kontrak lain.
Dialogue: 0,0:17:15.22,0:17:17.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bakatnya jauh di atasku!
Dialogue: 0,0:17:17.31,0:17:20.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi Quentin, dia belum matang...
Dialogue: 0,0:17:20.94,0:17:21.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru itu!
Dialogue: 0,0:17:21.88,0:17:25.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menopangnya\Nsebagai wakil kapten, Cyril.
Dialogue: 0,0:17:25.32,0:17:29.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadikan ini topik resmi\Nuntuk rapat selanjutnya.
Dialogue: 0,0:17:29.82,0:17:32.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Jangan, aku saja yang berhenti! Aku!\N- He-Hei...
Dialogue: 0,0:17:32.13,0:17:33.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tidak, biar aku!\N- Buat tercerai-berai
Dialogue: 0,0:17:33.47,0:17:34.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Sabar dulu.\N- Buat tercerai-berai
Dialogue: 0,0:17:34.62,0:17:35.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Aku yang berhenti!\N- hingga jadi debu, Angin Ribut.
Dialogue: 0,0:17:35.84,0:17:37.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Aku saja!\N- hingga jadi debu, Angin Ribut.
Dialogue: 0,0:17:40.41,0:17:43.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita lagi membahas apa, ya?
Dialogue: 0,0:17:43.20,0:17:48.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingat, Quentin dan Gideon\Nmau menempa diri, kan?
Dialogue: 0,0:17:48.78,0:17:51.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh pemikiran yang bagus.
Dialogue: 0,0:17:51.65,0:17:55.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cyril, tumben kamu memakai sihir\Nselain dalam pertarungan.
Dialogue: 0,0:17:55.29,0:17:59.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana buktinya?\NAku tidak memakainya, kok.
Dialogue: 0,0:17:59.43,0:18:01.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo? Sihir angin tadi...
Dialogue: 0,0:18:04.40,0:18:07.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyerahlah, Quentin.\NCyril tidak akan goyah.
Dialogue: 0,0:18:07.82,0:18:09.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, tapi...
Dialogue: 0,0:18:09.14,0:18:12.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, ayo minum dan lupakan soal hari ini!
Dialogue: 0,0:18:12.56,0:18:15.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada daging naga biru di jamuan malam ini!
Dialogue: 0,0:18:43.14,0:18:45.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fia, kebanyakan minum lagi?
Dialogue: 0,0:18:46.52,0:18:49.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bisa masuk angin kalau berlebihan.
Dialogue: 0,0:18:49.48,0:18:51.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten Cyril!
Dialogue: 0,0:18:51.09,0:18:52.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh duduk di sampingmu?
Dialogue: 0,0:18:52.85,0:18:54.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bo-Boleh.
Dialogue: 0,0:18:56.00,0:18:57.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan duduk juga.
Dialogue: 0,0:18:57.45,0:18:58.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:19:04.30,0:19:05.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pernahkah...
Dialogue: 0,0:19:06.72,0:19:10.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten terpisah dari teman?
Dialogue: 0,0:19:10.17,0:19:12.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teman?
Dialogue: 0,0:19:12.80,0:19:16.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku punya teman imut yang kuat.
Dialogue: 0,0:19:16.72,0:19:20.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini dia bilang ingin jadi raja\Ndan pergi jauh.
Dialogue: 0,0:19:22.45,0:19:27.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, Fia, bagaimana kalau\Naku yang jadi temanmu?
Dialogue: 0,0:19:27.77,0:19:30.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten Cyril jadi temanku?
Dialogue: 0,0:19:30.52,0:19:31.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:19:31.44,0:19:32.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:19:32.68,0:19:36.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maukah Kapten mendengarkan\Ncerita tidak pentingku?
Dialogue: 0,0:19:36.33,0:19:39.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belanja bareng, tertawa, dan marah bersama.
Dialogue: 0,0:19:39.57,0:19:42.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kadang juga tidur di atas perutku.
Dialogue: 0,0:19:42.28,0:19:45.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang bisa dan ada yang mustahil.
Dialogue: 0,0:19:45.87,0:19:49.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku tidur di atas perutmu,
Dialogue: 0,0:19:49.26,0:19:52.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa-bisa kamu penyek.
Dialogue: 0,0:19:52.52,0:19:54.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya jangan.
Dialogue: 0,0:19:54.52,0:19:59.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, sih, mustahil orang lain\Nbisa melakukannya.
Dialogue: 0,0:19:59.05,0:20:01.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kursi itu cuma miliknya seorang.
Dialogue: 0,0:20:01.78,0:20:03.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul.
Dialogue: 0,0:20:03.39,0:20:06.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi masa tidak ada kursi lain di mejamu?
Dialogue: 0,0:20:07.13,0:20:10.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisakah kamu menyiapkan kursi baru untukku?
Dialogue: 0,0:20:10.63,0:20:16.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten terlalu hebat dan cerdas,\Nkayaknya tidak akan cocok denganku.
Dialogue: 0,0:20:16.46,0:20:18.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini era keberagaman, lo.
Dialogue: 0,0:20:18.74,0:20:23.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak akan ada hal baru\Nkalau cuma bergaul dengan yang setipe.
Dialogue: 0,0:20:25.54,0:20:29.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memang punya jabatan\Ndan berbagai tanggung jawab.
Dialogue: 0,0:20:29.48,0:20:33.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kadang aku juga ragu\Nsaat mengambil keputusan.
Dialogue: 0,0:20:33.49,0:20:37.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat itu terjadi, saranmu sebagai teman\Nakan sangat berarti.
Dialogue: 0,0:20:40.80,0:20:43.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin karena mabuk,
Dialogue: 0,0:20:43.66,0:20:47.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku jadi ingin berteman dengan Kapten.
Dialogue: 0,0:20:47.18,0:20:52.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa rasa ingin berteman denganku\Njadi bukti bahwa kamu mabuk?
Dialogue: 0,0:20:53.02,0:20:58.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau mungkin Kapten Cyril yang mabuk\Nsampai-sampai ingin berteman denganku.
Dialogue: 0,0:20:58.18,0:20:59.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa?
Dialogue: 0,0:20:59.81,0:21:05.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten, kalau perasaanmu masih sama\Nsetelah sadar besok,
Dialogue: 0,0:21:05.05,0:21:07.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadikan aku teman.
Dialogue: 0,0:21:07.61,0:21:10.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, baiklah.
Dialogue: 0,0:21:11.66,0:21:15.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dadaku terasa hangat dan nyaman sekali.
Dialogue: 0,0:21:16.56,0:21:20.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, aku tahu cara\Nmengekspresikan perasaan ini!
Dialogue: 0,0:21:21.09,0:21:23.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pernah membacanya di buku.
Dialogue: 0,0:21:27.28,0:21:28.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bulannya indah, ya.
Dialogue: 0,0:21:29.54,0:21:30.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitulah.
Dialogue: 0,0:21:32.98,0:21:35.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya kamu bersyukur.
Dialogue: 0,0:21:35.33,0:21:38.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak banyak orang yang bisa memahami
Dialogue: 0,0:21:38.60,0:21:43.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}istilah darimu yang keliru\Ndan tidak sesuai konteks.
Dialogue: 0,0:21:44.24,0:21:47.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, apa yang kamu rasakan?
Dialogue: 0,0:21:47.60,0:21:49.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eng...
Dialogue: 0,0:21:49.88,0:21:53.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya orang-orang jahat lenyap\Noleh kilau rembulan.
Dialogue: 0,0:21:54.88,0:21:57.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu selalu ceria, ya.
Dialogue: 0,0:21:57.62,0:21:59.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini berkat Kapten.
Dialogue: 0,0:21:59.88,0:22:01.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:22:02.10,0:22:04.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bulannya indah, ya.
