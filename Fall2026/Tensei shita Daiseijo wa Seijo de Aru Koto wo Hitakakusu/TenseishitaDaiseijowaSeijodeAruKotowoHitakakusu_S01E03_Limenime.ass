Dialogue: 0,0:02:42.47,0:02:47.22,sign,,0000,0000,0000,,REINKARNASI SANTA AGUNG YANG MENYEMBUNYIKAN\NJATI DIRINYA SEBAGAI SANTA
Dialogue: 0,0:03:58.01,0:03:59.92,sign,,0000,0000,0000,,EPISODE 3: WUJUD SEORANG SANTA
Dialogue: 0,0:13:02.14,0:13:05.14,sign,,0000,0000,0000,,ORDO KESATRIA KEENAM, ZACKARY TOWNSEND
Dialogue: 0,0:23:35.06,0:23:43.65,sign,,0000,0000,0000,,EPISODE 4: ORDO KESATRIA MONSTER KEEMPAT
Dialogue: 0,0:00:03.96,0:00:08.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anggota baru wajib ikut membasmi monster.
Dialogue: 0,0:00:09.18,0:00:14.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dan Fabian masuk Regu Ketiga\Ndari Ordo Kesatria Keenam.
Dialogue: 0,0:00:14.66,0:00:19.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tujuannya agar kami belajar dari para senior.
Dialogue: 0,0:00:20.62,0:00:23.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih telah datang, Nona-Nona Santa.
Dialogue: 0,0:00:23.81,0:00:26.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kapten Regu Ketiga, Hector.
Dialogue: 0,0:00:26.96,0:00:29.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Mohon bantuannya hari ini.\N- Asyik!
Dialogue: 0,0:00:29.09,0:00:32.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para santa juga turut serta!
Dialogue: 0,0:00:33.18,0:00:39.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski baru bertemu di kehidupan ini,\Nbisa dibilang, kami rekan seprofesi.
Dialogue: 0,0:00:44.72,0:00:49.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka menitipkan tongkat\Nsebagai simbol kepercayaan?
Dialogue: 0,0:00:49.78,0:00:54.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau sekadar minta dibawakan?
Dialogue: 0,0:00:54.49,0:00:56.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah 300 tahun berlalu.
Dialogue: 0,0:00:56.70,0:00:59.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajar kalau ada pergeseran nilai.
Dialogue: 0,0:01:01.12,0:01:02.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah sejak kapan,
Dialogue: 0,0:01:02.77,0:01:06.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}manusia tidak lagi bisa menjalin\Nkontrak dengan roh
Dialogue: 0,0:01:06.21,0:01:09.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang memberikan daya sihir melimpah.
Dialogue: 0,0:01:09.30,0:01:15.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akibatnya, santa yang kuat menjadi langka.
Dialogue: 0,0:01:15.55,0:01:21.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Santa di era ini adalah sosok langka\Nyang mewarisi sedikit bakat leluhur
Dialogue: 0,0:01:21.55,0:01:24.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan sihir penyembuh.
Dialogue: 0,0:01:24.02,0:01:27.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajar mereka dihargai, sih...
Dialogue: 0,0:01:27.36,0:01:29.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketemu!
Dialogue: 0,0:01:29.11,0:01:31.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu Babi Hutan Ungu!
Dialogue: 0,0:01:44.88,0:01:46.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}La-Lah?
Dialogue: 0,0:01:46.09,0:01:48.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok malah asyik ngobrol?
Dialogue: 0,0:01:53.90,0:01:56.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sip, dia tumbang!
Dialogue: 0,0:02:00.22,0:02:03.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wahai cahaya surgawi yang penuh belas kasih.
Dialogue: 0,0:02:03.18,0:02:06.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ubahlah sihirku jadi kekuatan penyembuh.
Dialogue: 0,0:02:08.15,0:02:09.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyembuh!
Dialogue: 0,0:02:12.74,0:02:15.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona-Nona Santa, terima kasih!
Dialogue: 0,0:02:15.45,0:02:17.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok aneh?
Dialogue: 0,0:02:17.12,0:02:21.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya luka sekecil itu\Nlangsung sembuh tanpa mantra.
Dialogue: 0,0:02:21.79,0:02:23.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lah?
Dialogue: 0,0:02:23.83,0:02:28.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok santa jadi cupu banget?
Dialogue: 0,0:03:59.92,0:04:03.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang tadi itu kekuatan penuhnya santa?
Dialogue: 0,0:04:03.65,0:04:09.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau mereka cuma magang,\Ndan santa asli masih tetap kuat?
Dialogue: 0,0:04:09.98,0:04:11.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:04:12.27,0:04:15.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eng...\NPara santa hebat, ya.
Dialogue: 0,0:04:15.53,0:04:18.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luka separah itu bisa disembuhkan bertiga saja.
Dialogue: 0,0:04:18.72,0:04:20.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar hebat.
Dialogue: 0,0:04:21.79,0:04:23.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh...
Dialogue: 0,0:04:24.03,0:04:29.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, bisa menyembuhkan luka\Ncuma dengan uluran tangan
Dialogue: 0,0:04:29.25,0:04:31.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah mukjizat santa.
Dialogue: 0,0:04:34.64,0:04:36.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:04:44.01,0:04:46.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, Fia?\NKamu menangis?
Dialogue: 0,0:04:49.87,0:04:51.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entahlah.
Dialogue: 0,0:04:54.34,0:04:55.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak apa-apa?
Dialogue: 0,0:05:00.62,0:05:02.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bikin frustrasi.
Dialogue: 0,0:05:05.60,0:05:10.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal di kehidupan lalu,\Naku bangga menjadi santa.
Dialogue: 0,0:05:11.86,0:05:14.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku selalu maju ke medan tempur
Dialogue: 0,0:05:14.92,0:05:18.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan fokus menyembuhkan para kesatria.
Dialogue: 0,0:05:19.34,0:05:24.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Merekalah tamengku,\Ndan akulah tameng mereka.
Dialogue: 0,0:05:29.50,0:05:33.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak kapan santa menyimpang begini?
Dialogue: 0,0:05:33.48,0:05:36.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski pernah dijuluki Santa Agung,
Dialogue: 0,0:05:36.42,0:05:40.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku gagal mewariskan apa-apa.
Dialogue: 0,0:05:43.02,0:05:44.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah mendingan?
Dialogue: 0,0:05:45.14,0:05:45.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:05:46.38,0:05:49.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menghadapi monster membuatmu takut?
Dialogue: 0,0:05:49.22,0:05:52.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau kekuatan para santa membuatmu terharu?
Dialogue: 0,0:05:54.24,0:05:55.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan dua-duanya.
Dialogue: 0,0:05:56.99,0:06:01.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keran di mataku lupa ditutup,\Njadinya keluar air.
Dialogue: 0,0:06:03.01,0:06:07.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, beri tahu aku lokasi kerannya, dong.
Dialogue: 0,0:06:07.93,0:06:12.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kalau kamu lupa lagi,\Naku yang akan menutupnya.
Dialogue: 0,0:06:13.22,0:06:14.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:06:14.80,0:06:17.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu memang cowok keren.
Dialogue: 0,0:06:23.02,0:06:25.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sip, malam ini kita pesta daging!
Dialogue: 0,0:06:25.99,0:06:28.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melelahkan, kami mau pulang.
Dialogue: 0,0:06:28.99,0:06:29.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:06:30.29,0:06:32.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona-Nona Santa mau pulang!
Dialogue: 0,0:06:32.37,0:06:33.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Segera...
Dialogue: 0,0:06:33.71,0:06:35.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada monster!
Dialogue: 0,0:06:37.94,0:06:39.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten Regu!
Dialogue: 0,0:06:44.14,0:06:45.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rusa Tanduk Bunga?
Dialogue: 0,0:06:45.95,0:06:49.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa ada monster kelas B\Ndi pinggiran hutan?
Dialogue: 0,0:06:54.44,0:06:56.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fabian, bisakah kamu memimpin?
Dialogue: 0,0:06:56.62,0:06:59.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, aku tidak tahu monster itu.
Dialogue: 0,0:06:59.28,0:07:01.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sulit kalau tidak mengenali cirinya.
Dialogue: 0,0:07:01.49,0:07:02.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul juga.
Dialogue: 0,0:07:05.49,0:07:07.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bergerak!
Dialogue: 0,0:07:09.38,0:07:10.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat!
Dialogue: 0,0:07:10.83,0:07:14.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penguatan fisik, serangan kali tiga,\Nkecepatan kali tiga!
Dialogue: 0,0:07:24.59,0:07:25.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fia!
Dialogue: 0,0:07:29.60,0:07:33.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pernah menghadapi Rusa Tanduk Bunga!
Dialogue: 0,0:07:33.18,0:07:35.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Izin mengambil alih komando!
Dialogue: 0,0:07:38.94,0:07:41.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waspadalah pada satu hal!
Dialogue: 0,0:07:41.52,0:07:43.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat warna matanya!
Dialogue: 0,0:07:44.26,0:07:46.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau biru, dia menyerang!
Dialogue: 0,0:07:46.15,0:07:49.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau merah, menjauhlah dari apinya!
Dialogue: 0,0:07:49.34,0:07:50.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu saja!
Dialogue: 0,0:07:50.91,0:07:53.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fabian, panggil bantuan pakai peluit darurat!
Dialogue: 0,0:07:53.10,0:07:54.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah!
Dialogue: 0,0:07:57.81,0:07:58.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biru!
Dialogue: 0,0:08:06.30,0:08:10.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiga orang tim penyerang,\Ntahan tanduknya pakai tameng!
Dialogue: 0,0:08:10.59,0:08:12.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sisanya kepung dia!
Dialogue: 0,0:08:12.55,0:08:15.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waspadalah karena lompatannya sangat tinggi!
Dialogue: 0,0:08:19.10,0:08:21.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Incar bagian perutnya!
Dialogue: 0,0:08:21.54,0:08:23.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu titik paling lemah!
Dialogue: 0,0:08:23.65,0:08:26.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami kesulitan menyerang telak,\Nbagaimana ini?
Dialogue: 0,0:08:26.62,0:08:27.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fia!
Dialogue: 0,0:08:35.47,0:08:40.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mendengar peluit darurat,\Ntumben monster itu di sini.
Dialogue: 0,0:08:40.41,0:08:42.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten Cyril!
Dialogue: 0,0:08:42.38,0:08:46.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Monsternya sudah dikepung,\Njadi tidak akan bisa kabur.
Dialogue: 0,0:08:46.59,0:08:51.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daya hidupnya 450, masih tersisa 85%.
Dialogue: 0,0:08:51.50,0:08:55.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lima detik lagi matanya jadi biru\Ndan apinya akan padam.
Dialogue: 0,0:08:58.27,0:08:59.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fia...
Dialogue: 0,0:08:59.98,0:09:04.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku malah jadi kepikiran kamu\Ndaripada monsternya.
Dialogue: 0,0:09:04.48,0:09:07.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua sudah aman karena Kapten datang.
Dialogue: 0,0:09:07.52,0:09:10.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sosok hebatmu juga bikin aku kepikiran, kok.
Dialogue: 0,0:09:15.15,0:09:16.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketum?
Dialogue: 0,0:09:42.64,0:09:44.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, Ketum hebat!
Dialogue: 0,0:09:44.51,0:09:46.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Monsternya kalah sekali tebas.
Dialogue: 0,0:09:46.94,0:09:49.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajar kalau Ketum kuat.
Dialogue: 0,0:09:49.86,0:09:51.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru yang aneh...
Dialogue: 0,0:09:51.40,0:09:53.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fia, ke sini sebentar.
Dialogue: 0,0:09:54.36,0:09:56.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, Kapten.
Dialogue: 0,0:09:56.58,0:10:00.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, kami terselamatkan.
Dialogue: 0,0:10:00.53,0:10:04.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kebetulan sekali kalian berdua datang.
Dialogue: 0,0:10:04.50,0:10:07.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami sedang berburu di dekat sini.
Dialogue: 0,0:10:07.25,0:10:09.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fia, kamu terluka?
Dialogue: 0,0:10:09.96,0:10:11.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya.
Dialogue: 0,0:10:11.98,0:10:13.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat ke para santa...
Dialogue: 0,0:10:13.76,0:10:15.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong kawal yang benar!
Dialogue: 0,0:10:15.91,0:10:18.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau kami terluka?
Dialogue: 0,0:10:18.56,0:10:20.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon maaf.
Dialogue: 0,0:10:21.26,0:10:24.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Ini luka kecil, kok!\NNanti aku minum ramuan penyembuh...
Dialogue: 0,0:10:24.82,0:10:29.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan, harus diminum sekarang\Nkarena efeknya lama.
Dialogue: 0,0:10:30.34,0:10:34.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal tanpa minum pun,\Nbisa kusembuhkan sendiri.
Dialogue: 0,0:10:34.03,0:10:39.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fia, kamu takut rasa sakit sesaat\Nakibat minum ramuan penyembuh?
Dialogue: 0,0:10:39.97,0:10:42.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan kayak anak kecil.
Dialogue: 0,0:10:44.71,0:10:47.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buset! Pahit!
Dialogue: 0,0:10:47.26,0:10:49.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pahit banget!
Dialogue: 0,0:10:49.63,0:10:52.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku butuh yang manis-manis!
Dialogue: 0,0:10:56.14,0:10:58.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fia, cepat muntahkan!
Dialogue: 0,0:10:58.22,0:11:02.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski kelihatan manis,\Nbuah itu sangat pahit.
Dialogue: 0,0:11:02.14,0:11:04.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Ini manis banget, kok.
Dialogue: 0,0:11:04.64,0:11:07.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:11:07.10,0:11:08.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aneh sekali...
Dialogue: 0,0:11:11.62,0:11:15.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku memang bodoh telah memercayaimu.
Dialogue: 0,0:11:15.70,0:11:18.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cobalah, Ketum.\NIni sangat enak, lo.
Dialogue: 0,0:11:18.83,0:11:20.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke-Ketum!
Dialogue: 0,0:11:22.48,0:11:23.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini manis.
Dialogue: 0,0:11:23.70,0:11:25.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa?
Dialogue: 0,0:11:25.25,0:11:27.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fia, berikan satu pada Cyril.
Dialogue: 0,0:11:27.97,0:11:29.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:11:29.50,0:11:31.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan, Kapten.
Dialogue: 0,0:11:32.88,0:11:33.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manis.
Dialogue: 0,0:11:34.32,0:11:37.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa bisa begini?
Dialogue: 0,0:11:37.76,0:11:42.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Konon, dulunya para roh tinggal di hutan ini
Dialogue: 0,0:11:42.43,0:11:45.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan memberkahi orang-orang\Nyang mereka suka.
Dialogue: 0,0:11:45.98,0:11:50.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fia, mungkin kamu dicintai para roh.
Dialogue: 0,0:11:51.90,0:11:53.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayang sekali.
Dialogue: 0,0:11:53.52,0:11:58.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bisa sihir penyembuh,\Nkamu pasti jadi santa hebat.
Dialogue: 0,0:11:58.86,0:12:01.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.
Dialogue: 0,0:12:02.03,0:12:05.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah cukup diberkahi.
Dialogue: 0,0:12:05.58,0:12:09.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fia, aku jadi ingin bertanya lagi.
Dialogue: 0,0:12:09.57,0:12:10.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, soal apa?
Dialogue: 0,0:12:12.22,0:12:13.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fia?
Dialogue: 0,0:12:14.00,0:12:17.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya!\NAku minum ramuan penyembuh!
Dialogue: 0,0:12:17.47,0:12:20.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak cocok minum ramuan penyembuh?
Dialogue: 0,0:12:20.30,0:12:25.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat, sakitnya akan terus muncul\Nsampai lukanya pulih.
Dialogue: 0,0:12:25.50,0:12:28.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan sulit pulang bersama yang lain.
Dialogue: 0,0:12:28.59,0:12:29.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan!
Dialogue: 0,0:12:29.97,0:12:30.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:12:30.62,0:12:33.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya, aku harus pulang!
Dialogue: 0,0:12:33.69,0:12:36.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malam ini ada pesta daging!
Dialogue: 0,0:12:36.13,0:12:36.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:12:36.80,0:12:40.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daging Rusa Tanduk Bunga\Nlezatnya minta ampun!
Dialogue: 0,0:12:40.41,0:12:43.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong...\NTolong biarkan aku
Dialogue: 0,0:12:43.53,0:12:46.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}memakannya juga!
Dialogue: 0,0:12:48.70,0:12:54.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya aku sudah melahap\Ndaging lezat itu...
Dialogue: 0,0:13:02.14,0:13:05.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kumpul semua, kan?
Dialogue: 0,0:13:05.14,0:13:08.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, kayaknya aku akan diomeli.
Dialogue: 0,0:13:09.35,0:13:13.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alasan kita berkumpul di sini cuma satu.
Dialogue: 0,0:13:13.34,0:13:16.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami ingin memuji keberanian kalian.
Dialogue: 0,0:13:16.82,0:13:22.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanpa satu pun korban jiwa,\Nkalian sukses memojokkan monster kelas B.
Dialogue: 0,0:13:22.78,0:13:24.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Patut diapresiasi.
Dialogue: 0,0:13:24.66,0:13:25.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:13:25.87,0:13:32.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa yang memimpin malah orang baru\Ndari Ordo Kesatria Pertama?
Dialogue: 0,0:13:34.93,0:13:39.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, wah.\NTampaknya tidak ada yang mau menjawab.
Dialogue: 0,0:13:39.80,0:13:44.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, anggota ordoku pasti mau jujur.
Dialogue: 0,0:13:44.61,0:13:45.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, kan, Fia?
Dialogue: 0,0:13:49.20,0:13:51.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Te-Tentu saja, Kapten Cyril.
Dialogue: 0,0:13:51.46,0:13:54.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita mulai dari yang gampang.
Dialogue: 0,0:13:54.10,0:13:58.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu tahu banyak\Nsoal Rusa Tanduk Bunga?
Dialogue: 0,0:13:58.32,0:14:03.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be-Berkat... Ensiklopedia!\NAku baca ensiklopedia!
Dialogue: 0,0:14:03.53,0:14:07.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Info dari ensiklopedia monster lengkap, kan?
Dialogue: 0,0:14:07.73,0:14:09.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu dari situ.
Dialogue: 0,0:14:09.47,0:14:10.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:14:10.37,0:14:13.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bilang pernah menghadapinya, kan?
Dialogue: 0,0:14:13.26,0:14:15.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu cuma bualan.
Dialogue: 0,0:14:16.74,0:14:19.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang penting coba dulu.
Dialogue: 0,0:14:21.46,0:14:24.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa memimpin cuma modal ensiklopedia?
Dialogue: 0,0:14:24.85,0:14:27.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apalagi baru kali ini menghadapinya.\NKamu genius, ya?
Dialogue: 0,0:14:27.90,0:14:30.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waduh, ini sesi pujian?
Dialogue: 0,0:14:30.10,0:14:31.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan!
Dialogue: 0,0:14:31.31,0:14:35.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, pertanyaan selanjutnya.
Dialogue: 0,0:14:35.07,0:14:41.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu tahu jeda perubahan mata\Ndari Rusa Tanduk Bunga?
Dialogue: 0,0:14:41.03,0:14:41.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:14:41.65,0:14:46.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya sebelum Kapten datang,\Nmatanya sudah berubah-ubah.
Dialogue: 0,0:14:46.87,0:14:49.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat dihitung, jedanya lima detik.
Dialogue: 0,0:14:50.08,0:14:52.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertanyaan terakhir.
Dialogue: 0,0:14:52.11,0:14:55.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mengukur daya hidupnya jadi angka, kan?
Dialogue: 0,0:14:55.89,0:14:58.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana caranya?
Dialogue: 0,0:14:59.04,0:15:00.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eng...
Dialogue: 0,0:15:00.25,0:15:05.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa dilihat dari ukuran, postur berdiri,\Natau bahkan pola keringatnya.
Dialogue: 0,0:15:05.72,0:15:07.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski tidak selalu akurat, sih.
Dialogue: 0,0:15:09.17,0:15:14.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi kamu bisa tahu statistik monster\Ncuma dengan melihatnya?
Dialogue: 0,0:15:14.14,0:15:15.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, begitulah.
Dialogue: 0,0:15:17.94,0:15:23.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fia, kalau ucapanmu benar,\Nitu sungguh luar biasa.
Dialogue: 0,0:15:24.90,0:15:26.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:15:26.40,0:15:29.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan kalau mau bicara,\Naku tidak akan marah.
Dialogue: 0,0:15:29.70,0:15:34.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kenapa pesta daging hari ini\Nmalah jadi sesi ceramah?
Dialogue: 0,0:15:36.08,0:15:41.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bokongku bukan diciptakan\Nuntuk duduk di kursi keras ini!
Dialogue: 0,0:15:41.17,0:15:46.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanganku pun bukan ada untuk keringatan\Nsambil mencengkeram celana!
Dialogue: 0,0:15:46.26,0:15:50.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tangan ini ada untuk menyantap daging\Ndan alkohol yang lezat!
Dialogue: 0,0:15:53.09,0:15:55.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf soal itu.
Dialogue: 0,0:15:58.45,0:16:03.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain Fia, tampaknya kalian\Nperlu belajar lagi soal monster.
Dialogue: 0,0:16:06.57,0:16:09.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buat laporan dan kumpulkan ke Zackary.
Dialogue: 0,0:16:09.38,0:16:11.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu orang, 30 lembar!
Dialogue: 0,0:16:15.79,0:16:18.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nih, sudah matang.
Dialogue: 0,0:16:20.46,0:16:24.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fia, kamu paling berjasa hari ini,\Nmakanlah duluan.
Dialogue: 0,0:16:24.42,0:16:27.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, benarkah?
Dialogue: 0,0:16:27.26,0:16:29.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan senang hati.
Dialogue: 0,0:16:34.61,0:16:36.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enaknya!
Dialogue: 0,0:16:36.64,0:16:38.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fia, terima kasih, ya.
Dialogue: 0,0:16:38.96,0:16:41.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah jadi rekan kami.
Dialogue: 0,0:16:41.10,0:16:43.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu lagi bersikap kaku, oke?
Dialogue: 0,0:16:43.84,0:16:45.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap laksanakan!
Dialogue: 0,0:16:45.57,0:16:47.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dih, masih kaku, tuh!
Dialogue: 0,0:16:52.70,0:16:55.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu dengar, Fia?
Dialogue: 0,0:16:55.66,0:16:57.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Dengar apa?
Dialogue: 0,0:16:57.94,0:17:01.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang, Ketum punya enam kotak!
Dialogue: 0,0:17:02.34,0:17:04.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enam kotak?
Dialogue: 0,0:17:05.98,0:17:08.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajah Ketum selebar itu?
Dialogue: 0,0:17:08.19,0:17:11.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudku itu perutnya!\NBukan mukanya!
Dialogue: 0,0:17:11.31,0:17:14.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Otot perut Ketum ada enam!
Dialogue: 0,0:17:15.42,0:17:18.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya itu informasi erotis pribadi?
Dialogue: 0,0:17:18.06,0:17:19.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat aku!
Dialogue: 0,0:17:21.17,0:17:23.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Otot perutku ada berapa?
Dialogue: 0,0:17:23.28,0:17:27.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eng... Empat.\NAda empat.
Dialogue: 0,0:17:28.03,0:17:31.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul, otot perutku cuma empat.
Dialogue: 0,0:17:34.57,0:17:38.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski berlatih keras\Ndan memburu banyak monster,
Dialogue: 0,0:17:38.61,0:17:41.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}otot perutku tetap empat.
Dialogue: 0,0:17:41.34,0:17:45.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kambuh lagi, deh.\NHarap maklum, ya, Fia.
Dialogue: 0,0:17:45.22,0:17:48.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zackary! Lihat aku!
Dialogue: 0,0:17:48.05,0:17:49.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu kotak!
Dialogue: 0,0:17:49.76,0:17:55.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah punya empat otot perut saja\Nmasih mengeluh!
Dialogue: 0,0:17:55.17,0:17:59.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku saja cuma satu!\NBahkan, ini bukan otot!
Dialogue: 0,0:17:59.86,0:18:04.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi jangan pamer soal otot perutmu lagi!
Dialogue: 0,0:18:06.19,0:18:10.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, aku tidak akan membahasnya lagi.
Dialogue: 0,0:18:12.65,0:18:16.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mantap, kita selamat dari\Nkeluhan berulang itu!
Dialogue: 0,0:18:16.40,0:18:18.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fia pahlawan buncit kita!
Dialogue: 0,0:18:18.74,0:18:25.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buncit! Buncit! Buncit!
Dialogue: 0,0:18:27.50,0:18:29.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat malam.
Dialogue: 0,0:18:31.42,0:18:34.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dapat info rahasia.
Dialogue: 0,0:18:34.38,0:18:37.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya otot perut Ketum ada enam.
Dialogue: 0,0:18:37.60,0:18:40.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Semuanya juga tahu, kok.
Dialogue: 0,0:18:40.58,0:18:43.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, dia mabuk berat.
Dialogue: 0,0:18:43.94,0:18:48.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, aku cuma agak teler!\NPokoknya aman.
Dialogue: 0,0:18:48.75,0:18:50.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duduklah dulu.
Dialogue: 0,0:18:53.28,0:18:56.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fia, selamat atas perburuan hari ini.
Dialogue: 0,0:18:56.99,0:19:00.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita rayakan kemenanganmu.
Dialogue: 0,0:19:00.87,0:19:06.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Langit dan bumi menyertai\NOrdo Kesatria Naga Hitam Kerajaan Nav.
Dialogue: 0,0:19:10.45,0:19:15.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketum, terima kasih\Natas pertolonganmu hari ini.
Dialogue: 0,0:19:15.49,0:19:18.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fia, kamu benar-benar misterius.
Dialogue: 0,0:19:18.43,0:19:23.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melawan monster baru cuma berdasarkan data,\Nmenghitung daya hidupnya,
Dialogue: 0,0:19:23.93,0:19:27.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan dengan cepat mengetahui cirinya.
Dialogue: 0,0:19:28.06,0:19:31.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti matamu itu spesial.
Dialogue: 0,0:19:31.66,0:19:34.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mata?\NMataku memang tajam, sih.
Dialogue: 0,0:19:34.78,0:19:38.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bicara, kamu cuma bikin ruwet.
Dialogue: 0,0:19:38.90,0:19:39.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baik.
Dialogue: 0,0:19:39.91,0:19:42.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku masih bingung apa hebatnya kamu,
Dialogue: 0,0:19:42.91,0:19:45.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi faktanya semua tertolong.
Dialogue: 0,0:19:45.62,0:19:50.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal kamu tidak punya kekuatan spesial\Ndan tidak merahasiakan apa-apa.
Dialogue: 0,0:19:50.38,0:19:52.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, entahlah...
Dialogue: 0,0:20:02.72,0:20:05.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf jadi memakai jasmu segala!
Dialogue: 0,0:20:05.84,0:20:07.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidurmu nyenyak sekali.
Dialogue: 0,0:20:07.69,0:20:11.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baru kali ini ada orang yang ketiduran\Ndi ruang pribadi Ketum.
Dialogue: 0,0:20:12.10,0:20:13.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ruang pribadi Ketum?
Dialogue: 0,0:20:13.57,0:20:15.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak-anak memang suka tidur, ya.
Dialogue: 0,0:20:16.53,0:20:18.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bermeditasi.
Dialogue: 0,0:20:18.11,0:20:22.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sebelahku ada kesatria terkuat,\Njadi meditasinya nyaman.
Dialogue: 0,0:20:28.22,0:20:29.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fia?
Dialogue: 0,0:20:30.12,0:20:33.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa kesatria terkuat di ruangan ini?
Dialogue: 0,0:20:33.09,0:20:35.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah pasti Kapten Cyril.
Dialogue: 0,0:20:37.09,0:20:41.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah melihat cara kalian\Nmengayunkan pedang.
Dialogue: 0,0:20:41.12,0:20:45.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serangan dan kecepatan Kapten Cyril juaranya.
Dialogue: 0,0:20:47.89,0:20:51.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, itu menjawab kejanggalan
Dialogue: 0,0:20:51.87,0:20:56.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}saat kamu telat menyadari kehadiran Ketum.
Dialogue: 0,0:20:56.86,0:20:59.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon maaf soal itu.
Dialogue: 0,0:20:59.98,0:21:04.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena yakin Kapten Cyril sudah cukup\Nuntuk mengalahkan monster itu,
Dialogue: 0,0:21:04.37,0:21:06.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku jadi gagal fokus.
Dialogue: 0,0:21:06.85,0:21:09.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, aku sudah paham.
Dialogue: 0,0:21:10.27,0:21:14.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fia, maaf telah meremehkanmu.
Dialogue: 0,0:21:16.62,0:21:22.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku juga minta maaf sudah seenaknya.
Dialogue: 0,0:21:22.13,0:21:24.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mohon satu hal.
Dialogue: 0,0:21:24.43,0:21:29.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong rahasiakan soal diriku\Nyang lebih kuat dari Ketum.
Dialogue: 0,0:21:30.85,0:21:36.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anggapan bahwa Ketum-lah yang paling kuat\Nakan lebih masuk akal bagi para kesatria.
Dialogue: 0,0:21:36.88,0:21:38.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap laksanakan!
Dialogue: 0,0:21:38.96,0:21:40.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, Fia.
Dialogue: 0,0:21:40.10,0:21:41.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si-Siap!
Dialogue: 0,0:21:41.62,0:21:45.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maukah kamu pindah sementara\Nke Ordo Kesatria Monster Keempat?
Dialogue: 0,0:21:45.57,0:21:46.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo?
Dialogue: 0,0:21:46.37,0:21:49.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami ingin kemampuanmu bermanfaat.
Dialogue: 0,0:21:49.52,0:21:54.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu cuma sebagai anggota pinjaman\Ndari Ordo Kesatria Pertama.
Dialogue: 0,0:21:55.30,0:21:59.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu anak asuhku, tidak boleh pergi.
Dialogue: 0,0:22:00.05,0:22:03.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah larut, mari kita pulang.
Dialogue: 0,0:22:05.57,0:22:10.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fia, kamu baru pertama kali\Nbertugas bersama santa, kan?
Dialogue: 0,0:22:11.06,0:22:12.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa pendapatmu?
Dialogue: 0,0:22:16.86,0:22:18.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Berengsek!"
Dialogue: 0,0:22:19.63,0:22:21.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu.
Dialogue: 0,0:22:21.58,0:22:23.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para santanya?
Dialogue: 0,0:22:24.06,0:22:27.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, tapi orang yang membuat\Nmakna santa menyimpang.
Dialogue: 0,0:22:28.42,0:22:31.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Santa tidak seharusnya begitu.
Dialogue: 0,0:22:32.74,0:22:36.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin santa dari 300 tahun lalu\Nakan bersedih melihatnya.
Dialogue: 0,0:22:37.92,0:22:39.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:22:39.46,0:22:45.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan bukan cuma bersedih,\Ntapi menangis tersedu-sedu.
Dialogue: 0,0:22:45.62,0:22:48.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu berdasarkan buku juga?
Dialogue: 0,0:22:48.81,0:22:53.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, ini pendapat pribadiku.
Dialogue: 0,0:22:56.85,0:23:01.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketum, para santa mau kalian apakan?
Dialogue: 0,0:23:01.71,0:23:05.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau dipuja layaknya dewi?
Dialogue: 0,0:23:06.48,0:23:07.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu salah besar.
Dialogue: 0,0:23:09.51,0:23:15.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Santa bukanlah sosok yang menyembuhkan\Nsesuka hatinya dari kejauhan.
Dialogue: 0,0:23:16.69,0:23:20.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Santa adalah tameng para kesatria.
Dialogue: 0,0:23:31.68,0:23:33.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bulannya indah!
