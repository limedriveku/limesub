Dialogue: 0,0:01:16.19,0:01:18.39,sign,,0000,0000,0000,,KUAT
Dialogue: 0,0:01:18.39,0:01:20.85,sign,,0000,0000,0000,,LEMAH
Dialogue: 0,0:02:52.44,0:02:57.24,sign,,0000,0000,0000,,REINKARNASI SANTA AGUNG YANG MENYEMBUNYIKAN\NJATI DIRINYA SEBAGAI SANTA
Dialogue: 0,0:04:07.98,0:04:11.98,sign,,0000,0000,0000,,EPISODE 4: ORDO KESATRIA MONSTER KEEMPAT
Dialogue: 0,0:04:32.63,0:04:34.41,sign,,0000,0000,0000,,WAKIL KAPTEN ORDO KESATRIA MONSTER KEEMPAT,
Dialogue: 0,0:04:34.41,0:04:34.88,sign,,0000,0000,0000,,GIDEON OAKES
Dialogue: 0,0:05:59.56,0:06:01.36,sign,,0000,0000,0000,,ASISTEN WAKIL KAPTEN ORDO KESATRIA
Dialogue: 0,0:06:01.36,0:06:03.51,sign,,0000,0000,0000,,MONSTER KEEMPAT, PATTY CONAHAN
Dialogue: 0,0:23:34.98,0:23:39.98,sign,,0000,0000,0000,,EPISODE 5: MONSTER LEVEL BENCANA
Dialogue: 0,0:00:04.45,0:00:06.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu lupa kejadian semalam?
Dialogue: 0,0:00:07.23,0:00:08.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:00:09.78,0:00:14.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, ini salahku karena membahas\Npekerjaan saat pesta.
Dialogue: 0,0:00:14.80,0:00:20.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi untuk sementara, kamu dipindahkan\Nke Ordo Kesatria Monster Keempat.
Dialogue: 0,0:00:20.34,0:00:21.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:00:21.05,0:00:23.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ordo Kesatria Monster Keempat?
Dialogue: 0,0:00:23.22,0:00:24.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul.
Dialogue: 0,0:00:24.41,0:00:29.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tugasmu mengukur daya hidup hewan kontrak\Nmilik Ordo Kesatria Monster.
Dialogue: 0,0:00:29.82,0:00:31.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hewan kontrak, ya.
Dialogue: 0,0:00:33.15,0:00:37.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fia, kamu punya hewan kontrak?
Dialogue: 0,0:00:40.39,0:00:45.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus mengaku punya hewan kontrak\Nseekor naga hitam?
Dialogue: 0,0:00:45.45,0:00:49.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, tidak perlu mengatakan jenisnya.
Dialogue: 0,0:00:49.70,0:00:54.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu lapor kalau monsternya\Ndikontrak sebelum jadi kesatria.
Dialogue: 0,0:00:55.15,0:01:01.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru kalau ditanya monsternya apa,\Ncukup senyum dan jangan dijawab.
Dialogue: 0,0:01:02.28,0:01:06.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ketahuan punya hewan kontrak lemah,\Nkamu akan diolok-olok.
Dialogue: 0,0:01:07.30,0:01:08.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eng...
Dialogue: 0,0:01:08.71,0:01:12.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten tahu dari mana\Nkalau hewan kontrakku lemah?
Dialogue: 0,0:01:12.58,0:01:15.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari lebarnya tanda kontrak penjinakanmu.
Dialogue: 0,0:01:16.19,0:01:18.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biasanya makin lebar tandanya,
Dialogue: 0,0:01:18.39,0:01:20.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}makin kuat hewan kontraknya.
Dialogue: 0,0:01:20.85,0:01:25.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Monster terlemah pun\Npunya tanda walau satu senti.
Dialogue: 0,0:01:26.83,0:01:30.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan, ternyata Zavilia lemah?
Dialogue: 0,0:01:30.36,0:01:32.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih tepatnya,
Dialogue: 0,0:01:32.12,0:01:37.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}makin lama monsternya dijinakkan,\Nmakin lebar tandanya.
Dialogue: 0,0:01:38.75,0:01:43.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu itu memang Zavilia yang minta\Njadi hewan kontrakku, sih.
Dialogue: 0,0:01:43.43,0:01:49.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi kalau tandamu kelihatan,\Ntetaplah berlagak kuat dan misterius.
Dialogue: 0,0:01:49.06,0:01:52.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sebutkan juga jenisnya.
Dialogue: 0,0:01:53.20,0:01:56.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi entah triknya mempan atau tidak.
Dialogue: 0,0:01:57.23,0:01:58.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, Fia.
Dialogue: 0,0:01:59.44,0:02:02.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kuingatkan lagi\Nkarena semalam kamu lupa.
Dialogue: 0,0:02:03.58,0:02:08.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong rahasiakan soal diriku\Nyang lebih kuat dari Ketum.
Dialogue: 0,0:02:08.66,0:02:11.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap! Akan kurahasiakan!
Dialogue: 0,0:02:11.08,0:02:14.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan merepotkan Kapten!
Dialogue: 0,0:02:18.12,0:02:24.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masalahnya repot menurutmu\Ndan repot menurutku jauh berbeda.
Dialogue: 0,0:02:27.81,0:02:31.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi ini Ordo Kesatria Monster Keempat?\NBaiklah!
Dialogue: 0,0:02:32.88,0:02:37.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi, aku Fia Ruud\Ndari Ordo Kesatria Pertama!
Dialogue: 0,0:04:11.98,0:04:14.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya mau datang paling pagi?
Dialogue: 0,0:04:14.98,0:04:17.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesiangan, nih.
Dialogue: 0,0:04:17.23,0:04:19.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon maaf sebesar-besarnya!
Dialogue: 0,0:04:19.55,0:04:22.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat menyesal datang terlambat!
Dialogue: 0,0:04:22.74,0:04:28.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, aku kelamaan berada\Ndi ruangan Kapten Cyril!
Dialogue: 0,0:04:30.12,0:04:32.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Gideon Oakes,
Dialogue: 0,0:04:32.63,0:04:34.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}wakil kapten Ordo Kesatria Monster Keempat.
Dialogue: 0,0:04:34.88,0:04:40.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena Kapten absen untuk waktu lama,\Nakulah penanggung jawab di sini.
Dialogue: 0,0:04:40.26,0:04:45.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira Kapten Ordo Kesatria Pertama Cyril\Nmerekomendasikan orang hebat.
Dialogue: 0,0:04:45.49,0:04:48.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata yang datang malah anak ayam.
Dialogue: 0,0:04:49.78,0:04:54.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duh, galak banget.\NPasti dia benci bangun pagi.
Dialogue: 0,0:04:54.02,0:04:59.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, buat apa kami dititipkan\Nanggota Ordo Kesatria Pertama?
Dialogue: 0,0:04:59.22,0:05:03.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ordo Kesatria Pertama\Nselalu saja seenak jidat.
Dialogue: 0,0:05:03.98,0:05:05.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul banget, tuh.
Dialogue: 0,0:05:05.66,0:05:11.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mewujudkan ide yang baru dibuat semalam\Nbenar-benar seenaknya.
Dialogue: 0,0:05:11.41,0:05:16.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kudengar kamu bisa mengukur\Ndaya hidup monster?
Dialogue: 0,0:05:16.67,0:05:19.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, syukurlah ada kamu.
Dialogue: 0,0:05:19.67,0:05:21.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan harap dipuji begitu!
Dialogue: 0,0:05:21.95,0:05:24.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang ini ribet banget.
Dialogue: 0,0:05:26.46,0:05:28.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masuk!
Dialogue: 0,0:05:28.43,0:05:29.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf menyelang obrolannya.
Dialogue: 0,0:05:29.85,0:05:32.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wakil Kapten, R memanggilmu.
Dialogue: 0,0:05:32.16,0:05:34.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?\NAku akan ke sana!
Dialogue: 0,0:05:36.00,0:05:39.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak butuh bantuanmu,\Nterserah mau apa!
Dialogue: 0,0:05:41.84,0:05:44.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf atas sikap Wakil Kapten Gideon.
Dialogue: 0,0:05:45.41,0:05:50.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wakil Kapten merasa Ordo Kesatria Monster\Nselalu dianaktirikan.
Dialogue: 0,0:05:50.09,0:05:54.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya dia benci Ordo Kesatria Pertama\Nyang merupakan ordo kesatria teratas.
Dialogue: 0,0:05:56.96,0:05:59.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salam kenal, aku Patty Conahan
Dialogue: 0,0:05:59.56,0:06:01.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dari Ordo Kesatria Monster Keempat.
Dialogue: 0,0:06:01.36,0:06:03.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku asisten Wakil Kapten.
Dialogue: 0,0:06:03.51,0:06:06.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salam kenal, aku Fia Ruud.
Dialogue: 0,0:06:06.37,0:06:09.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski Wakil Kapten agak kekanak-kanakan,
Dialogue: 0,0:06:09.68,0:06:13.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebenarnya dia tekun dan tidak sebodoh itu.
Dialogue: 0,0:06:13.41,0:06:18.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai dia sadar dan memberikan tugas,\Nmaukah kamu menunggu?
Dialogue: 0,0:06:18.58,0:06:20.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:06:21.02,0:06:26.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, R itu siapa?\NPacarnya?
Dialogue: 0,0:06:27.14,0:06:31.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil Wakil Kapten punya pacar!
Dialogue: 0,0:06:31.16,0:06:34.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}R itu hewan kontraknya Wakil Kapten.
Dialogue: 0,0:06:34.72,0:06:38.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hewan kontrak cuma mau\Ndipanggil nama oleh pemiliknya.
Dialogue: 0,0:06:38.56,0:06:40.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi kami cuma pakai alfabet.
Dialogue: 0,0:06:40.72,0:06:42.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu.
Dialogue: 0,0:06:42.92,0:06:46.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menjinakkan monster memang bagian tersulit.
Dialogue: 0,0:06:46.34,0:06:49.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi perawatan rutinnya juga penting.
Dialogue: 0,0:06:49.63,0:06:55.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perawatannya akan menentukan\Ntingkat kepatuhannya.
Dialogue: 0,0:06:55.10,0:06:55.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:06:55.77,0:07:00.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa masternya akan diserang\Nkalau menelantarkannya?
Dialogue: 0,0:07:00.02,0:07:02.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak akan, sih.
Dialogue: 0,0:07:02.53,0:07:06.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka cuma mengibaskan ekor\Natau menerjang saat merajuk.
Dialogue: 0,0:07:06.28,0:07:09.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kadang itu menyebabkan cedera, sih.
Dialogue: 0,0:07:09.28,0:07:11.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terjangan...
Dialogue: 0,0:07:11.95,0:07:14.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serangan ekor...
Dialogue: 0,0:07:14.22,0:07:18.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mati...\NAku sudah pasti mati.
Dialogue: 0,0:07:18.00,0:07:19.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:07:19.61,0:07:22.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kebetulan, aku juga mengontrak monster.
Dialogue: 0,0:07:22.58,0:07:24.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Kamu punya hewan kontrak?
Dialogue: 0,0:07:24.51,0:07:28.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya, tapi dia malah kutelantarkan.
Dialogue: 0,0:07:32.11,0:07:34.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:07:34.04,0:07:39.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagi yang bukan Ordo Kesatria Monster,\Nbisa mengontrak monster saja sudah hebat.
Dialogue: 0,0:07:39.81,0:07:42.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba jemput saja hewan kontrakmu.
Dialogue: 0,0:07:42.66,0:07:44.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh?\NBaiklah!
Dialogue: 0,0:07:44.96,0:07:48.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa dia ada di sekitar jalan masuk\Nke Hutan Bintang Jatuh.
Dialogue: 0,0:07:49.63,0:07:51.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan tanda setipis itu,
Dialogue: 0,0:07:51.53,0:07:54.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}wajar kalau monsternya\Ndiam di jalan masuk.
Dialogue: 0,0:07:58.42,0:08:02.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat pertama bertemu,\NZavilia terluka parah, kan?
Dialogue: 0,0:08:03.46,0:08:06.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan berarti dia lemah.
Dialogue: 0,0:08:06.08,0:08:09.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa saja yang merundungnya lebih kuat.
Dialogue: 0,0:08:09.86,0:08:11.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dia terluka lagi...
Dialogue: 0,0:08:21.15,0:08:26.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bilang, panggilanku bisa terdengar\Ndari mana pun, kan?
Dialogue: 0,0:08:28.24,0:08:32.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zavilia! Zavilia!
Dialogue: 0,0:08:52.82,0:08:54.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}La-Lah?
Dialogue: 0,0:08:58.06,0:09:00.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fia, terima kasih sudah memanggil!
Dialogue: 0,0:09:01.76,0:09:03.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu Zavilia, kan?
Dialogue: 0,0:09:03.84,0:09:06.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Kamu sudah lupa aku?
Dialogue: 0,0:09:06.85,0:09:08.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu-Bukan begitu!
Dialogue: 0,0:09:08.57,0:09:11.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zavilia, kok kamu tambah besar?
Dialogue: 0,0:09:11.47,0:09:13.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayap dan tubuhmu makin lebar.
Dialogue: 0,0:09:13.70,0:09:16.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beda jauh dari empat bulan lalu.
Dialogue: 0,0:09:17.41,0:09:20.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namanya juga masa pertumbuhan, wajar saja.
Dialogue: 0,0:09:20.48,0:09:23.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa pertumbuhan?\NZavilia, berapa usiamu?
Dialogue: 0,0:09:23.78,0:09:24.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nol tahun.
Dialogue: 0,0:09:24.74,0:09:25.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nol?
Dialogue: 0,0:09:25.71,0:09:29.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kamu akan tambah besar?
Dialogue: 0,0:09:29.04,0:09:32.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, mungkin berkali-kali lipat\Ndari yang sekarang.
Dialogue: 0,0:09:34.75,0:09:38.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sedang kesulitan?\NAda yang bisa kubantu?
Dialogue: 0,0:09:38.89,0:09:42.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadinya aku mau membawamu pulang\Nkalau kamu bersedia.
Dialogue: 0,0:09:42.96,0:09:44.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mau membawaku?
Dialogue: 0,0:09:44.94,0:09:47.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, tapi...
Dialogue: 0,0:09:47.06,0:09:50.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tubuhmu terlalu besar,\Ndan warnamu juga...
Dialogue: 0,0:09:50.51,0:09:53.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makhluk yang bersayap hitam\Ncuma naga hitam.
Dialogue: 0,0:09:53.90,0:09:56.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Andai saja bisa jadi warna lain.
Dialogue: 0,0:09:56.95,0:10:01.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa menyusut, kok!\NTapi kalau warna...
Dialogue: 0,0:10:01.20,0:10:04.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasa bangga memiliki warna hitam,
Dialogue: 0,0:10:04.35,0:10:07.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}membuatku tidak bisa berubah warna.
Dialogue: 0,0:10:07.80,0:10:09.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, ya, Fia.
Dialogue: 0,0:10:09.96,0:10:11.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:10:11.67,0:10:13.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti...
Dialogue: 0,0:10:13.69,0:10:14.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya!
Dialogue: 0,0:10:14.84,0:10:18.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zavilia, bisakah kamu memburu\Nmonster tipe burung?
Dialogue: 0,0:10:18.46,0:10:21.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja, bisa kamu tutup telinga dulu?
Dialogue: 0,0:10:43.02,0:10:44.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu sebentar.
Dialogue: 0,0:10:48.04,0:10:51.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para monster jatuh oleh satu raungan?
Dialogue: 0,0:10:51.92,0:10:56.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana ini?\NTernyata Zavilia kuat banget.
Dialogue: 0,0:10:56.17,0:11:01.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil memperkenalkannya,\Nfirasat buruk membayangiku!
Dialogue: 0,0:11:03.81,0:11:07.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak keberatan langsung ikut denganku?
Dialogue: 0,0:11:07.43,0:11:11.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, karena aku memang selalu sendirian.
Dialogue: 0,0:11:11.36,0:11:13.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:11:17.97,0:11:21.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, cobalah menyusut seperti katamu tadi.
Dialogue: 0,0:11:21.86,0:11:22.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke.
Dialogue: 0,0:11:30.32,0:11:32.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Imut sekali.
Dialogue: 0,0:11:33.15,0:11:35.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zavilia, kamu tidak sesak?
Dialogue: 0,0:11:36.85,0:11:38.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:11:38.51,0:11:41.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sini hangat, Fia.
Dialogue: 0,0:11:57.67,0:11:59.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fia?
Dialogue: 0,0:11:59.16,0:12:00.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, sudah bangun?
Dialogue: 0,0:12:00.86,0:12:03.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memimpikan masa lalu.
Dialogue: 0,0:12:03.37,0:12:07.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada-ada saja,\Nmasa nol tahun punya masa lalu?
Dialogue: 0,0:12:09.25,0:12:11.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daripada itu...
Dialogue: 0,0:12:12.35,0:12:15.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini transformasi khusus untukmu!
Dialogue: 0,0:12:15.13,0:12:18.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu benar-benar persis Merpati Biru!
Dialogue: 0,0:12:18.51,0:12:22.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pakai bulu dua ekor burung\Nbiar hitamnya tertutup!
Dialogue: 0,0:12:22.06,0:12:24.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bulunya lebat dan elegan!
Dialogue: 0,0:12:24.01,0:12:26.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sempurna!
Dialogue: 0,0:12:28.78,0:12:30.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Zavilia.
Dialogue: 0,0:12:30.52,0:12:34.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebelum hewan kontrak kesatria lain\Ndipastikan sekuat dirimu,
Dialogue: 0,0:12:34.53,0:12:37.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}identitas sebagai naga hitam\Nsebaiknya dirahasiakan.
Dialogue: 0,0:12:37.97,0:12:42.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau pakai ide itu,\Naku akan selamanya jadi burung biru.
Dialogue: 0,0:12:47.44,0:12:50.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat senang berada di samping Fia.
Dialogue: 0,0:12:50.98,0:12:57.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi menyamar jadi monster terlemah ini\Nadalah penderitaan yang mengikis jiwa.
Dialogue: 0,0:12:58.83,0:13:02.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu masih polos dan menggemaskan, ya.
Dialogue: 0,0:13:15.86,0:13:18.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan cemas, Zavilia.
Dialogue: 0,0:13:20.13,0:13:22.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan melindungimu.
Dialogue: 0,0:13:25.35,0:13:29.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada yang boleh merundungmu lagi.
Dialogue: 0,0:13:34.79,0:13:36.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asisten Wakil Kapten Patty.
Dialogue: 0,0:13:38.09,0:13:40.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perutmu kenapa?
Dialogue: 0,0:13:40.51,0:13:44.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa cuma karena makan berlebihan?
Dialogue: 0,0:13:44.18,0:13:46.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini aku bawa hewan kontrak.
Dialogue: 0,0:13:47.43,0:13:49.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tertidur di dalam bajuku.
Dialogue: 0,0:13:49.69,0:13:51.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}O-Oh, begitu.
Dialogue: 0,0:13:51.86,0:13:53.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi-lagi kamu datang?
Dialogue: 0,0:13:53.90,0:13:55.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wakil Kapten!
Dialogue: 0,0:13:55.27,0:13:58.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wakil Kapten Gideon, selamat pagi!
Dialogue: 0,0:13:58.29,0:14:01.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fia Ruud, kamu akan kuberi tugas.
Dialogue: 0,0:14:01.41,0:14:02.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap!
Dialogue: 0,0:14:02.32,0:14:05.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada beberapa hewan kontrak\Nyang terluka di kandang.
Dialogue: 0,0:14:05.96,0:14:09.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ambil ramuan dari santa di istana terpisah.
Dialogue: 0,0:14:09.25,0:14:12.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu berikan dua kali\Ndi pagi dan sore hari.
Dialogue: 0,0:14:12.79,0:14:15.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk sekarang, lakukan itu tiap hari!
Dialogue: 0,0:14:15.29,0:14:16.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap laksanakan!
Dialogue: 0,0:14:16.77,0:14:19.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wakil Kapten, itu terlalu...
Dialogue: 0,0:14:19.41,0:14:20.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cerewet!
Dialogue: 0,0:14:20.13,0:14:24.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kabari petugas ramuan minggu ini\Nkalau dia digantikan!
Dialogue: 0,0:14:24.51,0:14:26.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si-Siap!
Dialogue: 0,0:14:33.27,0:14:35.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perutmu kenapa, tuh?
Dialogue: 0,0:14:35.27,0:14:37.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa cuma karena makan berlebihan?
Dialogue: 0,0:14:37.52,0:14:39.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini aku bawa hewan kontrak...
Dialogue: 0,0:14:39.52,0:14:41.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makhluk apa itu?
Dialogue: 0,0:14:41.25,0:14:45.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Patty memang bilang\Nkamu punya hewan kontrak, sih.
Dialogue: 0,0:14:46.33,0:14:49.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini hewan kontrakku\Nyang kuat dan imut, Merpati Biru.
Dialogue: 0,0:14:49.88,0:14:54.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya Merpati Biru itu\Nlehernya panjang kayak dia?
Dialogue: 0,0:14:57.75,0:15:03.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menjalin kontrak penjinakan\Nperlu perjuangan mati-matian.
Dialogue: 0,0:15:03.33,0:15:07.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami saling menarik leher\Nhingga lehernya memanjang!
Dialogue: 0,0:15:12.85,0:15:16.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master yang payah\Nmembuat hewan kontrak jadi nyeleneh, ya.
Dialogue: 0,0:15:16.90,0:15:20.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya dia bisa terbang\Ndengan postur aneh itu?
Dialogue: 0,0:15:20.01,0:15:21.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sembarangan!
Dialogue: 0,0:15:21.74,0:15:25.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makhluk seimut ini\Nsudah pasti kuat dan berguna!
Dialogue: 0,0:15:25.90,0:15:31.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok kamu sepercaya diri itu?\NAku enggak habis pikir.
Dialogue: 0,0:15:31.65,0:15:33.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bego, bego.
Dialogue: 0,0:15:34.60,0:15:35.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:15:35.75,0:15:37.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suara siapa tadi?
Dialogue: 0,0:15:37.22,0:15:40.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bego, bego, dungu.
Dialogue: 0,0:15:40.13,0:15:44.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zavilia, kamu membalaskan dendamku\Nyang tidak bisa melawan atasan
Dialogue: 0,0:15:44.29,0:15:47.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akibat sistem hierarki ini, ya?
Dialogue: 0,0:15:47.87,0:15:52.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuitannya berubah akibat leher\Nyang memanjang.
Dialogue: 0,0:15:52.09,0:15:54.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf bila kurang sedap didengar.
Dialogue: 0,0:15:54.57,0:15:57.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuitan apanya coba?
Dialogue: 0,0:15:57.44,0:16:00.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jelas-jelas dia menghinaku!
Dialogue: 0,0:16:00.28,0:16:04.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Merpati Biru mana paham bahasa manusia?\N- Bego, bego, dasar dungu.
Dialogue: 0,0:16:04.82,0:16:09.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu aku Fia Ruud, akan mengurus\Npenyembuhan para monster!
Dialogue: 0,0:16:09.09,0:16:10.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi!
Dialogue: 0,0:16:11.43,0:16:15.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dungu, dungu, dungu abis.
Dialogue: 0,0:16:16.07,0:16:18.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Da-Dasar...
Dialogue: 0,0:16:18.50,0:16:20.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hewan kontrak sialan!
Dialogue: 0,0:16:20.88,0:16:21.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat!
Dialogue: 0,0:16:21.93,0:16:26.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kabarnya kemarin, sang Raja Hitam muncul\Ndi Hutan Bintang Jatuh!
Dialogue: 0,0:16:26.43,0:16:27.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:16:29.09,0:16:30.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ramuan penyembuh, ya.
Dialogue: 0,0:16:31.23,0:16:32.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon tunggu.
Dialogue: 0,0:16:32.90,0:16:33.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:16:46.32,0:16:48.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para santa itu...
Dialogue: 0,0:16:53.17,0:16:55.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka sedang apa?
Dialogue: 0,0:17:20.09,0:17:22.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan...
Dialogue: 0,0:17:25.75,0:17:29.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya-Yah, namanya juga kekinian.
Dialogue: 0,0:17:29.11,0:17:33.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan jumlah santa yang sedikit,\Nefisiensi itu penting.
Dialogue: 0,0:17:33.81,0:17:36.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini hal wajar di zaman ini.
Dialogue: 0,0:17:39.81,0:17:41.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul.
Dialogue: 0,0:17:42.25,0:17:45.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:17:59.57,0:18:04.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Santa-santa 300 tahun lalu,\Nmemetik herba dengan rasa takjub
Dialogue: 0,0:18:04.73,0:18:07.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}terhadap kuasa dan keindahan alam.
Dialogue: 0,0:18:07.96,0:18:14.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka menimba air, lalu mengalirkan daya sihir\Nsambil membayangkan kesembuhan korban luka.
Dialogue: 0,0:18:14.37,0:18:17.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu ramuan penyembuh yang dihasilkan
Dialogue: 0,0:18:17.13,0:18:21.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mewarisi warna hijau pekat dari herbanya.
Dialogue: 0,0:18:22.21,0:18:23.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:18:23.62,0:18:27.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa ramuan zaman ini transparan?
Dialogue: 0,0:18:28.49,0:18:33.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin prosesnya berubah\Nsampai aku tidak paham lagi.
Dialogue: 0,0:18:39.81,0:18:44.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Efek penghilang nyerinya hilang\Nbersama warna hijaunya!
Dialogue: 0,0:18:46.34,0:18:49.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski terluka, aku akan tetap menghindari\Nramuan penyembuhnya.
Dialogue: 0,0:18:51.73,0:18:54.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak kusangka yang datang\Ngadis muda sepertimu.
Dialogue: 0,0:18:54.78,0:18:57.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah tahu kerjaannya, kan?
Dialogue: 0,0:18:57.75,0:19:01.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, meminumkan ramuan penyembuh\Nke hewan kontrak yang terluka.
Dialogue: 0,0:19:03.27,0:19:06.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ramuan penyembuh pahit\Ndan memicu rasa sakit.
Dialogue: 0,0:19:06.19,0:19:08.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biasanya mereka enggan meminumnya.
Dialogue: 0,0:19:08.63,0:19:12.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya pemberi obat wajib berdiri tegap\Ndi depan kandang
Dialogue: 0,0:19:12.42,0:19:15.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan terus memaksa mereka untuk minum.
Dialogue: 0,0:19:15.75,0:19:19.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biasanya ini dilakukan orang-orang\Nbermuka garang.
Dialogue: 0,0:19:19.39,0:19:21.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:19:21.38,0:19:26.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pantas saja Asisten Wakil Kapten Patty\Nsempat tidak setuju, dia baik sekali.
Dialogue: 0,0:19:29.59,0:19:32.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu yakin bisa sendiri?
Dialogue: 0,0:19:32.03,0:19:34.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, serahkan padaku!
Dialogue: 0,0:19:39.91,0:19:43.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, ada Babi Hutan Ungu.
Dialogue: 0,0:19:49.35,0:19:51.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini ramuan penyembuh.
Dialogue: 0,0:19:51.30,0:19:52.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minumlah.
Dialogue: 0,0:19:53.55,0:19:56.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau lekas sembuh, pemilikmu akan...
Dialogue: 0,0:20:05.94,0:20:08.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dapat luka yang bisa sembuh\Ndalam satu detik.
Dialogue: 0,0:20:12.23,0:20:14.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harus bagaimana, ya?
Dialogue: 0,0:20:14.28,0:20:16.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fia, boleh aku membantu?
Dialogue: 0,0:20:16.55,0:20:19.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Bo-Boleh.
Dialogue: 0,0:20:37.97,0:20:41.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Kamu bisa mengendalikan monster?
Dialogue: 0,0:20:41.35,0:20:43.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa.
Dialogue: 0,0:20:43.38,0:20:44.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi itu bunyi mengancam.
Dialogue: 0,0:20:44.69,0:20:49.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bunyi dariku istimewa,\Njadi ampuh pada kebanyakan monster.
Dialogue: 0,0:20:49.11,0:20:51.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, luar biasa!
Dialogue: 0,0:20:52.84,0:20:56.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kayak raja monster, ya.
Dialogue: 0,0:20:57.78,0:21:00.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, maaf.
Dialogue: 0,0:21:00.10,0:21:02.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belum layak jadi raja, ya.
Dialogue: 0,0:21:02.87,0:21:07.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, bukan...\NAku cuma merasa kamu kayak raja.
Dialogue: 0,0:21:07.21,0:21:09.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan raja pun tidak apa-apa.
Dialogue: 0,0:21:10.29,0:21:14.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu ingin aku jadi raja?
Dialogue: 0,0:21:14.30,0:21:17.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana, ya...
Dialogue: 0,0:21:20.95,0:21:25.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu imut, kuat, dan baik hati.
Dialogue: 0,0:21:26.88,0:21:29.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zavilia yang sekarang sudah cukup bagiku.
Dialogue: 0,0:21:30.97,0:21:34.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menjadi raja bukan cuma\Nsoal mau atau tidaknya.
Dialogue: 0,0:21:34.32,0:21:39.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu memang harus jadi raja,\Npasti ada jalannya.
Dialogue: 0,0:21:39.70,0:21:42.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putuskanlah kalau saatnya tiba.
Dialogue: 0,0:21:45.81,0:21:49.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, terima kasih, Fia.
Dialogue: 0,0:21:50.83,0:21:54.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang, ayo beri ramuannya\Nke hewan kontrak yang lain.
Dialogue: 0,0:21:54.96,0:21:57.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Anu, Nona Kesatria...
Dialogue: 0,0:22:01.03,0:22:02.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu...
