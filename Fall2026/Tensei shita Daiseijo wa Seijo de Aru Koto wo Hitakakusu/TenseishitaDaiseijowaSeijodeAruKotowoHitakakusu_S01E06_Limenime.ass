Dialogue: 0,0:04:35.50,0:04:40.22,sign,,0000,0000,0000,,REINKARNASI SANTA AGUNG YANG MENYEMBUNYIKAN\NJATI DIRINYA SEBAGAI SANTA
Dialogue: 0,0:05:51.00,0:05:56.00,sign,,0000,0000,0000,,EPISODE 6:\NOPERASI PENANGKAPAN SANG RAJA HITAM
Dialogue: 0,0:09:26.91,0:09:29.74,sign,,0000,0000,0000,,KAPTEN ORDO KESATRIA KELIMA
Dialogue: 0,0:09:29.74,0:09:31.26,sign,,0000,0000,0000,,CLARISSA ABERNETHY
Dialogue: 0,0:23:35.06,0:23:40.06,sign,,0000,0000,0000,,EPISODE 7: ZAVILIA
Dialogue: 0,0:00:04.90,0:00:09.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luar biasa, aku baru pertama melihat\Ntanda hewan kontrak serapi ini!
Dialogue: 0,0:00:11.26,0:00:12.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini tandaku.
Dialogue: 0,0:00:12.74,0:00:17.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari hewan kontrak kelas A yang harus\Ndikepung dulu oleh 80 kesatria.
Dialogue: 0,0:00:17.98,0:00:21.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tandamu satu garis sempurna tanpa putus!
Dialogue: 0,0:00:21.95,0:00:24.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma segaris!\NSatu milimeter pula!
Dialogue: 0,0:00:24.59,0:00:27.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penjinakan total...
Dialogue: 0,0:00:31.04,0:00:36.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Fia, boleh aku bertanya langsung\Npada Tuan Hewan Kontrak?
Dialogue: 0,0:00:36.49,0:00:40.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, coba kutanya dulu.
Dialogue: 0,0:00:40.23,0:00:41.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zavilia.
Dialogue: 0,0:00:50.11,0:00:55.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar, suaramu terdengar\Nmirip bahasa manusia, kan?
Dialogue: 0,0:00:55.45,0:00:57.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan bicara seperti itu.
Dialogue: 0,0:01:01.01,0:01:03.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lah, kok aneh?
Dialogue: 0,0:01:03.01,0:01:05.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan Kapten Quentin...
Dialogue: 0,0:01:05.63,0:01:08.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?\NWalau masih bayi naga hita—
Dialogue: 0,0:01:08.68,0:01:11.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa Tuan Hewan Kontrak bisa sekarat?
Dialogue: 0,0:01:11.63,0:01:15.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waduh, pantas saja dia muncul di hutan!
Dialogue: 0,0:01:17.35,0:01:20.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}...sudah tahu kalau Zavilia itu naga hitam?
Dialogue: 0,0:01:20.45,0:01:24.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa sebaiknya aku mengaku saja\Nsupaya diajari ini itu?
Dialogue: 0,0:01:25.03,0:01:30.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku dan Kapten Quentin akan serbasalah\Nkalau mengakuinya naga hitam.
Dialogue: 0,0:01:30.49,0:01:35.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya pasti wajib lapor\Nkalau sudah jelas tahu.
Dialogue: 0,0:01:36.03,0:01:39.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, aku tidak akan mengaku\Nkalau tidak ditanya!
Dialogue: 0,0:01:39.66,0:01:43.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedekat apa pun,\Nabu-abu tetap bukan hitam!
Dialogue: 0,0:01:44.17,0:01:47.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, mau tanya apa?
Dialogue: 0,0:01:48.35,0:01:51.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku malas basa-basi selain sama Fia,\Ntolong dipersingkat.
Dialogue: 0,0:01:51.99,0:01:57.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be-Begini, bolehkah aku tahu hubungan\NTuan Hewan Kontrak dan Nona Fia?
Dialogue: 0,0:01:57.39,0:01:59.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dan Fia sangat akrab.
Dialogue: 0,0:01:59.90,0:02:02.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penjinakan total seperti yang kamu bilang.
Dialogue: 0,0:02:02.94,0:02:03.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh!
Dialogue: 0,0:02:03.88,0:02:08.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misalnya, kalau daya hidup\Ndan sihir Fia berkurang,
Dialogue: 0,0:02:08.68,0:02:11.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku bisa memberinya meski cuma searah.
Dialogue: 0,0:02:11.07,0:02:14.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi Fia tidak akan mati\Nselama aku tidak.
Dialogue: 0,0:02:14.31,0:02:18.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fia juga tidak akan kehabisan daya sihir\Nselama aku tidak kehabisan.
Dialogue: 0,0:02:19.35,0:02:22.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa bersama Fia hingga ajal tiba.
Dialogue: 0,0:02:24.04,0:02:26.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Begitu, ya.\N- Kok aku baru tahu?
Dialogue: 0,0:02:26.14,0:02:28.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, Kapten!\NMinta handuk! Handuk!
Dialogue: 0,0:02:28.89,0:02:32.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon maaf, abaikan saja diriku.
Dialogue: 0,0:02:33.47,0:02:37.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Hewan Kontrak, benarkah itu mungkin?
Dialogue: 0,0:02:37.29,0:02:43.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau searah, daya hidup dan sihir\NNona Fia tidak mengalir padamu?
Dialogue: 0,0:02:43.21,0:02:44.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, tanpa seizinnya.
Dialogue: 0,0:02:44.85,0:02:49.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaliknya, tindakan, pikiran,\Ndan perasaan Fia mengalir padaku.
Dialogue: 0,0:02:49.65,0:02:51.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejauh apa pun kami terpisah.
Dialogue: 0,0:02:55.28,0:02:57.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku sungguh minta maaf!
Dialogue: 0,0:02:57.16,0:02:58.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mi-Minta handuk benaran!
Dialogue: 0,0:02:58.71,0:03:01.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya sulit dipercaya.
Dialogue: 0,0:03:01.22,0:03:06.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus bagaimana cara memahami master\Nkalau tidak melakukan itu?
Dialogue: 0,0:03:06.81,0:03:12.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masterku harus ditanya?\NOrang tengil bernama Gideon tadi mau dibunuh?
Dialogue: 0,0:03:12.51,0:03:15.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau mau dibunuh?
Dialogue: 0,0:03:16.04,0:03:18.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gi-Gideon, ya?
Dialogue: 0,0:03:19.93,0:03:24.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kebetulan nama wakil kaptenku juga itu.
Dialogue: 0,0:03:24.45,0:03:27.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu pura-pura bodoh.
Dialogue: 0,0:03:27.69,0:03:30.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memang membahas\Nwakil kapten sialan itu!
Dialogue: 0,0:03:30.73,0:03:34.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be-Benar juga, Gideon yang sialan\Ncuma ada di ordo kami!
Dialogue: 0,0:03:34.19,0:03:35.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sungguh minta maaf!
Dialogue: 0,0:03:35.99,0:03:40.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena dia telah lancang pada Nona Fia!
Dialogue: 0,0:03:40.41,0:03:42.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Angkat kepalamu!
Dialogue: 0,0:03:43.02,0:03:45.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedang apa kamu di sini?
Dialogue: 0,0:03:45.66,0:03:47.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Quentin, ayo pergi.
Dialogue: 0,0:03:47.53,0:03:48.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}O-Oh.
Dialogue: 0,0:03:49.23,0:03:51.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke rapat kapten ordo, ya?
Dialogue: 0,0:03:51.23,0:03:56.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maukah Nona Fia ikut denganku?\NMaaf mendadak begini.
Dialogue: 0,0:03:56.92,0:04:00.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku?\NBaiklah kalau boleh.
Dialogue: 0,0:04:01.19,0:04:04.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten yang bersikap aneh bertambah lagi,
Dialogue: 0,0:04:04.63,0:04:06.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan penyebabnya lagi-lagi Fia.
Dialogue: 0,0:04:06.73,0:04:08.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bilang apa tadi?
Dialogue: 0,0:04:08.35,0:04:10.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, bukan apa-apa.
Dialogue: 0,0:04:12.50,0:04:14.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon kerja samanya.
Dialogue: 0,0:06:02.84,0:06:06.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fia, kamu sehat-sehat saja, ya!
Dialogue: 0,0:06:06.77,0:06:09.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo, Kapten Ordo Kesatria Keenam Zackary!
Dialogue: 0,0:06:10.18,0:06:12.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku cuma melihatnya sekilas\Nwaktu pesta daging,
Dialogue: 0,0:06:12.95,0:06:15.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kok sapaannya ramah sekali?
Dialogue: 0,0:06:15.40,0:06:17.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau dia salah orang?
Dialogue: 0,0:06:19.27,0:06:21.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak memanggilku Zackary\Nseperti waktu itu?
Dialogue: 0,0:06:23.06,0:06:25.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu boleh memanggilku pakai nama, kok!
Dialogue: 0,0:06:25.78,0:06:29.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bahkan berbagi\Ninformasi erotis pribadinya Ketum!
Dialogue: 0,0:06:29.01,0:06:31.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Istilah bodoh ciptaan siapa itu?
Dialogue: 0,0:06:33.50,0:06:36.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, Quentin?\NRambutmu basah, tuh.
Dialogue: 0,0:06:36.64,0:06:39.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kena sembur Nona Fia.
Dialogue: 0,0:06:40.50,0:06:45.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kapten Quentin,\Nitu kan kecelakaan saat makan!
Dialogue: 0,0:06:45.08,0:06:48.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Quentin, kamu makan bareng Fia?
Dialogue: 0,0:06:48.39,0:06:52.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya kamu ogah makan bareng perempuan,\Nbahkan bawahan sendiri?
Dialogue: 0,0:06:52.64,0:06:56.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini ajakan Nona Fia.\NAku tidak berhak menolak.
Dialogue: 0,0:06:56.72,0:06:59.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Momen tadi sangat berharga.
Dialogue: 0,0:06:59.97,0:07:03.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku rela mengorbankan apa pun\Ndemi momen-momen itu.
Dialogue: 0,0:07:03.57,0:07:08.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapan lagi bisa memegang\Nlengan kiri Nona Fia sepuasnya.
Dialogue: 0,0:07:08.64,0:07:12.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kepalaku disembur air pun\Ntermasuk momen penting.
Dialogue: 0,0:07:12.88,0:07:16.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat bersyukur telah dibuat tersadar.
Dialogue: 0,0:07:16.21,0:07:20.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ja-Jangan bicara lagi, Kapten Quentin!
Dialogue: 0,0:07:20.18,0:07:22.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemilihan katamu kacau sekali!
Dialogue: 0,0:07:22.96,0:07:26.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}No-Nona Fia, jangan marah!\NAku minta maaf sepenuh hati!
Dialogue: 0,0:07:26.21,0:07:29.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemilihan katamu bikin salah paham, tahu!
Dialogue: 0,0:07:29.60,0:07:32.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu selalu tampak ceria, ya, Fia.
Dialogue: 0,0:07:32.60,0:07:34.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke-Ketum Saviz!
Dialogue: 0,0:07:34.60,0:07:40.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu tingkah para kesatria jadi aneh\Nkalau bergaul denganmu.
Dialogue: 0,0:07:40.87,0:07:43.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti juga mereka normal lagi.
Dialogue: 0,0:07:43.11,0:07:47.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul sekali!\NTerima kasih, Ketum Saviz!
Dialogue: 0,0:07:47.06,0:07:50.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya masalah selesai\Nsesuai harapanmu, ya.
Dialogue: 0,0:07:50.60,0:07:52.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, kemarilah.
Dialogue: 0,0:07:52.48,0:07:55.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya kamu itu Ordo Kesatria Pertama.
Dialogue: 0,0:07:55.09,0:07:56.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baik.
Dialogue: 0,0:07:57.62,0:08:01.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bicara apa kamu, Cyril?\NAkulah yang mengajak Nona Fia.
Dialogue: 0,0:08:01.59,0:08:05.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, dia masih aktif\Nbertugas di ordo kami.
Dialogue: 0,0:08:05.27,0:08:07.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya bersamaku, dong?
Dialogue: 0,0:08:08.85,0:08:14.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teknik yang hebat,\Ndia jengkel tapi tetap tersenyum.
Dialogue: 0,0:08:15.55,0:08:19.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daripada menimbulkan konflik,\Nmending ikut aku saja, Fia!
Dialogue: 0,0:08:19.81,0:08:20.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo?
Dialogue: 0,0:08:21.02,0:08:22.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya...
Dialogue: 0,0:08:23.02,0:08:26.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, Fia, kamu maunya ke mana?
Dialogue: 0,0:08:26.65,0:08:28.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertanyaan bagus, Ketum.
Dialogue: 0,0:08:28.65,0:08:31.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejujurnya, aku mau pulang saja.
Dialogue: 0,0:08:55.06,0:08:56.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cewek cantik...
Dialogue: 0,0:08:56.30,0:08:58.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fia, jangan tertipu!
Dialogue: 0,0:08:58.19,0:09:03.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia makhluk terkuat bermental baja\Nyang kejam dan tanpa ampun!
Dialogue: 0,0:09:03.06,0:09:04.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zackary benar!
Dialogue: 0,0:09:04.83,0:09:07.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia belalang sembah betina\Nberwarna merah muda!
Dialogue: 0,0:09:07.41,0:09:11.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia makhluk mengerikan\Nyang memangsa para kesatria muda!
Dialogue: 0,0:09:11.49,0:09:13.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau ikut dengannya!
Dialogue: 0,0:09:13.39,0:09:16.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lah? Bukannya kalian tidak saling kenal?
Dialogue: 0,0:09:18.11,0:09:23.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Fia Ruud, izin berjaga di belakangmu\Nselama rapat kapten ordo.
Dialogue: 0,0:09:25.39,0:09:26.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, senangnya.
Dialogue: 0,0:09:26.91,0:09:28.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Clarissa Abernethy,
Dialogue: 0,0:09:28.32,0:09:29.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kapten Ordo Kesatria Kelima.
Dialogue: 0,0:09:29.74,0:09:31.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salam kenal.
Dialogue: 0,0:09:31.78,0:09:35.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rapat kapten ordo resmi dimulai.
Dialogue: 0,0:09:35.96,0:09:40.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Topiknya adalah penangkapan Raja Hitam.
Dialogue: 0,0:09:40.02,0:09:46.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rencana awalnya, selagi Raja Hitam\Nmasih dalam tahap bayi naga,
Dialogue: 0,0:09:46.65,0:09:49.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita akan menangkapnya kalau ketemu.
Dialogue: 0,0:09:50.27,0:09:51.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi,
Dialogue: 0,0:09:51.40,0:09:54.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}saksi di Hutan Bintang Jatuh bilang,
Dialogue: 0,0:09:54.14,0:09:59.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pertumbuhan Raja Hitam\Ntelah melampaui dugaan kita.
Dialogue: 0,0:09:59.06,0:10:01.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti mustahil menangkapnya.
Dialogue: 0,0:10:01.54,0:10:03.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya Raja Hitam pulang
Dialogue: 0,0:10:03.85,0:10:06.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ke sarangnya di Gunung Hitam Legam.
Dialogue: 0,0:10:08.92,0:10:13.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira bisa dapat buruan besar\Nsetelah sekian lama.
Dialogue: 0,0:10:13.14,0:10:15.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, butuh berapa orang?
Dialogue: 0,0:10:15.06,0:10:18.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sampai dikira musuh\Noleh Raja Hitam...
Dialogue: 0,0:10:18.77,0:10:24.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin 15 orang Ordo Kesatria Monster\Ndan 35 orang Ordo Kesatria Keenam.
Dialogue: 0,0:10:24.56,0:10:27.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ih, takutnya.
Dialogue: 0,0:10:27.06,0:10:31.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sampai Raja Hitam\Nmasuk ke ibu kota, ya.
Dialogue: 0,0:10:31.62,0:10:35.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau warga ibu kota kesayanganku terancam,
Dialogue: 0,0:10:35.06,0:10:38.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa-bisa aku marah, lo.
Dialogue: 0,0:10:38.48,0:10:40.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kami usahakan.
Dialogue: 0,0:10:40.31,0:10:43.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena ingatan yang belum pulih\Nsetelah reinkarnasi,
Dialogue: 0,0:10:43.82,0:10:47.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin dia berkeliaran\Ndi Hutan Bintang Jatuh.
Dialogue: 0,0:10:48.51,0:10:55.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Quentin, kamu membawa potongan jasad\Ndan bebatuan gua dari sarang Raja Hitam, kan?
Dialogue: 0,0:10:55.05,0:10:59.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin kalau melihat itu ingatannya akan pulih\Ndan dia akan kembali ke sarang?
Dialogue: 0,0:10:59.22,0:11:00.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita coba.
Dialogue: 0,0:11:07.02,0:11:09.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap, Kapten Quentin!
Dialogue: 0,0:11:09.47,0:11:12.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Naga hitam muncul saat para kesatria\Nmemeriksa hutan,
Dialogue: 0,0:11:12.74,0:11:14.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten Quentin akan melempar batu,
Dialogue: 0,0:11:14.86,0:11:17.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu naga hitam akan terbang\Nke arah sarangnya.
Dialogue: 0,0:11:18.15,0:11:19.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudnya itu, kan?
Dialogue: 0,0:11:19.99,0:11:25.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Quentin, jangan melirik anggotaku saat rapat.
Dialogue: 0,0:11:25.01,0:11:26.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Merusak ketertiban.
Dialogue: 0,0:11:26.50,0:11:30.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma minta Nona Fia berpartisipasi
Dialogue: 0,0:11:30.31,0:11:32.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dalam pencarian Raja Hitam.
Dialogue: 0,0:11:32.28,0:11:36.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, tampaknya aku dan Nona Fia\Nbisa kompak cuma pakai tatapan.
Dialogue: 0,0:11:37.20,0:11:41.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu yang mengenalnya lebih lama\Nbelum bisa begitu, ya?
Dialogue: 0,0:11:45.89,0:11:46.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tung...
Dialogue: 0,0:11:46.81,0:11:49.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu populer, ya, Fia.
Dialogue: 0,0:11:49.09,0:11:51.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi sabar dulu.
Dialogue: 0,0:11:51.90,0:11:55.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu harus mengulur-ulur
Dialogue: 0,0:11:55.78,0:11:59.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sampai mereka tidak bisa lagi\Nmenahan diri.
Dialogue: 0,0:12:01.28,0:12:05.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuh, kan!\NWanita selalu saja mengundang perkara!
Dialogue: 0,0:12:07.79,0:12:11.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita di hadapan Ketum Saviz!\NJaga sikap kalian!
Dialogue: 0,0:12:12.29,0:12:15.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sudah sepakat, besok kita berangkat.
Dialogue: 0,0:12:15.51,0:12:19.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kubawa 35 prajurit elite\Ndari Ordo Kesatria Keenam.
Dialogue: 0,0:12:19.93,0:12:24.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan membawa kesatria\Nyang punya monster bersayap
Dialogue: 0,0:12:24.50,0:12:27.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk jadi pemandu Raja Hitam\Nkembali ke sarang.
Dialogue: 0,0:12:28.25,0:12:29.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bagus.
Dialogue: 0,0:12:30.05,0:12:34.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akibat Raja Hitam muncul mendadak,\Npergerakan para monster pasti kacau.
Dialogue: 0,0:12:35.32,0:12:37.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya, jangan gegabah.
Dialogue: 0,0:12:43.19,0:12:47.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Langit dan bumi menyertai\NOrdo Kesatria Naga Hitam Kerajaan Nav!
Dialogue: 0,0:12:47.70,0:12:52.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Langit dan bumi menyertai\NOrdo Kesatria Naga Hitam Kerajaan Nav!
Dialogue: 0,0:13:00.22,0:13:03.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rapat kapten ordo melelahkan, ya.
Dialogue: 0,0:13:09.94,0:13:12.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zavilia, apa itu?
Dialogue: 0,0:13:12.98,0:13:14.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daftar eksekusi.
Dialogue: 0,0:13:14.61,0:13:16.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daftar eksekusi?
Dialogue: 0,0:13:17.17,0:13:20.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama, Wakil Kapten Gideon.\NKedua, Kapten Zackary.
Dialogue: 0,0:13:20.74,0:13:22.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketiga, Kapten Cyril?
Dialogue: 0,0:13:23.45,0:13:25.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini...
Dialogue: 0,0:13:25.62,0:13:29.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai hewan kontrak unggulan,\Naku selalu selangkah lebih maju.
Dialogue: 0,0:13:29.94,0:13:33.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memilih orang-orang\Nyang mungkin akan merugikanmu
Dialogue: 0,0:13:33.14,0:13:36.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan berniat melenyapkan mereka\Nsebelum itu terjadi.
Dialogue: 0,0:13:36.25,0:13:38.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melenyapkan?
Dialogue: 0,0:13:38.13,0:13:40.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zavilia, tenanglah!
Dialogue: 0,0:13:40.07,0:13:43.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada yang membahayakan di daftar ini!
Dialogue: 0,0:13:43.59,0:13:45.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Idemu ditolak!
Dialogue: 0,0:13:45.85,0:13:49.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagian Kapten Cyril salah apa\Nsampai jadi peringkat ketiga?
Dialogue: 0,0:13:50.42,0:13:54.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia berbudi luhur, baik hati,\Ndan kapten yang hebat.
Dialogue: 0,0:13:55.42,0:14:00.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru karena kamu bisa memuji\Ntiga hal darinya dengan lancar.
Dialogue: 0,0:14:00.40,0:14:02.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski patuh sebagai hewan kontrak,
Dialogue: 0,0:14:02.71,0:14:05.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tidak mau tergantikan siapa pun!
Dialogue: 0,0:14:05.82,0:14:10.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kalau pujianmu selancar itu,\Nposisiku terancam.
Dialogue: 0,0:14:10.91,0:14:15.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu imut, kuat, cerdas, perhatian,
Dialogue: 0,0:14:15.51,0:14:18.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan selalu mengutamakan aku!
Dialogue: 0,0:14:18.69,0:14:21.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pujian untukmu langsung lima, lo!
Dialogue: 0,0:14:21.23,0:14:23.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jauh lebih banyak dari Kapten Cyril!
Dialogue: 0,0:14:24.33,0:14:28.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, eksekusinya aku tunda dulu, deh.
Dialogue: 0,0:14:32.19,0:14:35.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Ini lebih melelahkan dari rapat tadi.
Dialogue: 0,0:14:36.09,0:14:37.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bilang apa tadi?
Dialogue: 0,0:14:37.94,0:14:41.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada, besok kita harus\Nke Hutan Bintang Jatuh pagi-pagi.
Dialogue: 0,0:14:44.49,0:14:46.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat tidur, Fia.
Dialogue: 0,0:14:46.31,0:14:48.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat tidur, Zavilia.
Dialogue: 0,0:15:03.82,0:15:07.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, dia melakukannya demi aku.
Dialogue: 0,0:15:29.02,0:15:31.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah menggemaskan,
Dialogue: 0,0:15:31.42,0:15:37.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau diberi pita dan mahkota bunga\Njadi kelewatan imutnya!
Dialogue: 0,0:15:37.00,0:15:38.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:15:38.24,0:15:40.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski sudah hidup lama,
Dialogue: 0,0:15:40.14,0:15:45.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}baru kamu yang memujiku imut\Natau menggemaskan.
Dialogue: 0,0:15:45.09,0:15:47.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Usiamu baru nol tahun, kan?
Dialogue: 0,0:15:47.29,0:15:51.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hidupmu belum cukup panjang\Nbuat dikomentari orang lain.
Dialogue: 0,0:16:12.97,0:16:15.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia hewan kontraknya Kapten Quentin, ya.
Dialogue: 0,0:16:16.01,0:16:19.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salam kenal, aku Fia Ruud\Ndari Ordo Kesatria Pertama.
Dialogue: 0,0:16:19.32,0:16:20.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini hewan kontrakku, Zavi...
Dialogue: 0,0:16:22.33,0:16:25.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hewan kontrakku, naga hitam kebahagiaan.
Dialogue: 0,0:16:29.81,0:16:32.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo? Kamu terluka.
Dialogue: 0,0:16:32.47,0:16:36.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemarin dia baru pulang dari ekspedisi\Nbersama Kapten Quentin,
Dialogue: 0,0:16:36.52,0:16:38.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa lukanya dari situ?
Dialogue: 0,0:16:44.81,0:16:48.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma terlihat menyentuh\Ngriffon-nya seperti biasa, kan?
Dialogue: 0,0:16:49.44,0:16:50.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyembuh.
Dialogue: 0,0:16:54.40,0:16:58.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Fia, kalau disembuhkan...
Dialogue: 0,0:17:00.71,0:17:02.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah aman.
Dialogue: 0,0:17:10.26,0:17:13.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, semuanya terluka.
Dialogue: 0,0:17:13.29,0:17:14.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke!
Dialogue: 0,0:17:14.39,0:17:15.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyembuh!
Dialogue: 0,0:17:32.41,0:17:34.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke-Kenapa ini?
Dialogue: 0,0:17:34.37,0:17:38.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau semuanya disembuhkan,\Nmereka akan menempel padamu, lo.
Dialogue: 0,0:17:38.91,0:17:41.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi aku mau bilang begitu.
Dialogue: 0,0:17:41.91,0:17:45.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fia selalu populer di kalangan monster, ya.
Dialogue: 0,0:17:46.44,0:17:51.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kamu yang paling imut, kok!\NTerkuat dan terimut!
Dialogue: 0,0:17:51.77,0:17:56.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang ingin kuberi mahkota bunga\Ndan pita cuma kamu, lo!
Dialogue: 0,0:17:57.79,0:18:00.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}No-Nona Fia...
Dialogue: 0,0:18:02.19,0:18:06.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maaf, dilarang menyentuh\Nhewan kontrak milik kesatria lain, ya?
Dialogue: 0,0:18:07.22,0:18:09.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Fia bertangan emas, ya?
Dialogue: 0,0:18:11.33,0:18:15.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira hewan kontrak cuma mau\Ndekat ke pemiliknya!
Dialogue: 0,0:18:15.07,0:18:19.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata semua hewan kontrak ini\Nbermanja-manja padamu!
Dialogue: 0,0:18:19.16,0:18:22.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai kapten Ordo Kesatria Monster,\Nwawasanku terlalu sempit!
Dialogue: 0,0:18:22.92,0:18:26.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, anu...\NTidak sehebat itu, kok!
Dialogue: 0,0:18:26.88,0:18:30.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sungguh minta maaf, Fia!
Dialogue: 0,0:18:31.32,0:18:32.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lah?
Dialogue: 0,0:18:32.43,0:18:38.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten bilang, kamu ke ordo kami\Natas perintah dari Ketum!
Dialogue: 0,0:18:38.45,0:18:43.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perintah Ketum pasti sudah diperhitungkan!
Dialogue: 0,0:18:43.43,0:18:49.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku malah baru sadar\Nsetelah semua pemandangan ini!
Dialogue: 0,0:18:49.32,0:18:51.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh memalukan!
Dialogue: 0,0:18:51.16,0:18:52.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}E-Eh, tidak...
Dialogue: 0,0:18:52.84,0:18:56.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku telah bersikap tidak pantas padamu!
Dialogue: 0,0:18:56.07,0:18:58.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sudah begini!
Dialogue: 0,0:18:58.28,0:19:03.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan mundur dari jabatan wakil kapten\Nsebagai permintaan maaf!
Dialogue: 0,0:19:03.92,0:19:05.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu!
Dialogue: 0,0:19:05.29,0:19:06.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sudah sepantasnya!
Dialogue: 0,0:19:06.85,0:19:09.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Woi! Kamu merasa keren, ya?
Dialogue: 0,0:19:09.04,0:19:10.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedikit!
Dialogue: 0,0:19:10.54,0:19:11.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minta maaf yang benar!
Dialogue: 0,0:19:11.74,0:19:16.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fia, kamu sedang diperebutkan?
Dialogue: 0,0:19:16.04,0:19:21.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, bukan!\NKapten Zackary salah paham!
Dialogue: 0,0:19:21.40,0:19:23.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, aku mengerti.
Dialogue: 0,0:19:23.31,0:19:27.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daripada menimbulkan konflik,\Nmending ikut aku saja.
Dialogue: 0,0:19:27.97,0:19:31.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para santa sudah tiba, ayo berangkat.
Dialogue: 0,0:19:31.32,0:19:33.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fia akan bersama reguku.
Dialogue: 0,0:19:33.44,0:19:36.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian perlakukan para santa\Nseakan mereka Fia.
Dialogue: 0,0:19:36.76,0:19:37.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paham?
Dialogue: 0,0:19:45.71,0:19:51.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di eksplorasi ini ada Regu Quentin,\NRegu Gideon, dan Regu Zackary.
Dialogue: 0,0:19:51.89,0:19:57.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami meniup peluit secara berkala\Nuntuk mengabari lokasi masing-masing.
Dialogue: 0,0:19:57.59,0:19:59.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi pengawal santa.
Dialogue: 0,0:20:01.44,0:20:06.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo? Kapan Zavilia harus muncul, ya?
Dialogue: 0,0:20:06.48,0:20:10.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dan Kapten Quentin\Nbelum merundingkannya.
Dialogue: 0,0:20:12.73,0:20:15.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, saat makan siang nanti...
Dialogue: 0,0:20:15.00,0:20:16.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada monster!
Dialogue: 0,0:20:21.24,0:20:26.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya ampun, kenapa Burung Mimpi\Nada di tepi hutan?
Dialogue: 0,0:20:27.50,0:20:30.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fia, mundurlah bersama Nona Santa!
Dialogue: 0,0:20:30.13,0:20:31.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:20:34.15,0:20:37.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyihir dan Tim Pemanah, serang!
Dialogue: 0,0:20:40.49,0:20:42.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Monster yang cukup merepotkan.
Dialogue: 0,0:20:43.48,0:20:45.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Burung Mimpi.
Dialogue: 0,0:20:45.59,0:20:48.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Monster kelas B yang membuat\Nlawan berhalusinasi.
Dialogue: 0,0:20:50.14,0:20:51.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tembak!
Dialogue: 0,0:20:55.65,0:20:58.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia terbang memutar\Nseakan membuat lingkaran,
Dialogue: 0,0:20:58.90,0:21:02.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan orang yang di dalamnya\Nakan mulai berhalusinasi.
Dialogue: 0,0:21:03.85,0:21:06.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi dia harus cepat dikalahkan.
Dialogue: 0,0:21:06.41,0:21:08.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Incar kepalanya!
Dialogue: 0,0:21:12.51,0:21:14.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, apa-apaan kalian?
Dialogue: 0,0:21:16.39,0:21:19.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo? Tadi Burung Mimpi-nya di situ!
Dialogue: 0,0:21:19.64,0:21:21.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan melantur!\NBurungnya di situ!
Dialogue: 0,0:21:21.62,0:21:23.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, dia mendekat!
Dialogue: 0,0:21:23.34,0:21:24.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia di sana!
Dialogue: 0,0:21:24.76,0:21:26.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di mana, sih?
Dialogue: 0,0:21:32.32,0:21:34.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, gawat.
Dialogue: 0,0:21:37.72,0:21:41.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Burung Mimpi akan membesar\Nsetelah membuat ruang halusinasi.
Dialogue: 0,0:21:46.40,0:21:49.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tubuh warna-warninya\Nakan dilapisi sisik hijau.
Dialogue: 0,0:21:50.25,0:21:53.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu dalam sekejap...
Dialogue: 0,0:21:54.51,0:21:57.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia berubah jadi monster kelas A!
