Dialogue: 0,0:01:00.50,0:01:05.25,sign,,0000,0000,0000,,REINKARNASI SANTA AGUNG YANG MENYEMBUNYIKAN\NJATI DIRINYA SEBAGAI SANTA
Dialogue: 0,0:02:16.45,0:02:20.49,sign,,0000,0000,0000,,EPISODE 2: FIA DAN ORDO KESATRIA
Dialogue: 0,0:08:29.15,0:08:32.00,sign,,0000,0000,0000,,PEWARIS SAH KELUARGA MARQUIS WINER
Dialogue: 0,0:08:32.00,0:08:32.53,sign,,0000,0000,0000,,FABIAN WINER
Dialogue: 0,0:10:03.54,0:10:07.65,sign,,0000,0000,0000,,ORDO KESATRIA NAGA HITAM KERAJAAN NAV
Dialogue: 0,0:11:49.23,0:11:52.93,sign,,0000,0000,0000,,KETUM ORDO KESATRIA NAGA HITAM KERAJAAN NAV,\NSAVIZ NAV
Dialogue: 0,0:16:13.49,0:16:14.77,sign,,0000,0000,0000,,KAPTEN ORDO KESATRIA PERTAMA
Dialogue: 0,0:16:14.77,0:16:15.91,sign,,0000,0000,0000,,CYRIL SUTHERLAND
Dialogue: 0,0:21:21.36,0:21:22.68,sign,,0000,0000,0000,,KAPTEN ORDO KESATRIA KEDUA
Dialogue: 0,0:21:22.68,0:21:24.47,sign,,0000,0000,0000,,SEKALIGUS KOMANDAN POLISI MILITER, DESMOND RONAN
Dialogue: 0,0:22:26.57,0:22:31.94,sign,,0000,0000,0000,,KAPTEN ORDO KESATRIA PENYIHIR KETIGA, ENOCH
Dialogue: 0,0:23:34.98,0:23:42.00,sign,,0000,0000,0000,,EPISODE 3: WUJUD SEORANG SANTA
Dialogue: 0,0:00:03.87,0:00:09.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak upacara kedewasaan, kekuatan dan ingatan\Nkehidupanku sebelumnya makin jelas.
Dialogue: 0,0:00:09.76,0:00:11.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiga bulan setelahnya,
Dialogue: 0,0:00:11.74,0:00:13.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku mulai mahir memakai sihir
Dialogue: 0,0:00:13.99,0:00:17.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan telah berlatih mendalami diri sendiri.
Dialogue: 0,0:00:20.00,0:00:22.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus jadi kesatria!
Dialogue: 0,0:00:22.99,0:00:28.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seingatku, kita bisa lulus ujian pertama\Nkalau menahan serangan penguji 10 kali.
Dialogue: 0,0:00:28.38,0:00:30.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana tenagamu?
Dialogue: 0,0:00:30.78,0:00:32.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bang Leon?
Dialogue: 0,0:00:32.14,0:00:35.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa kalian tidak bisa menangkis pedangku?
Dialogue: 0,0:00:35.64,0:00:36.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mulai!
Dialogue: 0,0:00:36.46,0:00:38.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lemah! Lamban!
Dialogue: 0,0:00:38.14,0:00:39.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial!
Dialogue: 0,0:00:40.38,0:00:41.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lamban!
Dialogue: 0,0:00:41.65,0:00:44.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujian pertamanya kayak begini?
Dialogue: 0,0:02:20.49,0:02:24.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, Bang Leon tidak berniat\Nmeluluskan siapa pun.
Dialogue: 0,0:02:24.27,0:02:25.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu.
Dialogue: 0,0:02:27.25,0:02:30.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa cowok ganteng ini?\NMau apa dia?
Dialogue: 0,0:02:31.57,0:02:34.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Bajuku kusut, ya?
Dialogue: 0,0:02:34.05,0:02:37.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau ada sisa telur sarapan di wajahku?
Dialogue: 0,0:02:37.09,0:02:39.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, maaf membuatmu panik.
Dialogue: 0,0:02:39.76,0:02:42.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya penguji kita agak unik.
Dialogue: 0,0:02:42.85,0:02:44.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, selanjutnya.
Dialogue: 0,0:02:44.96,0:02:45.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lima!
Dialogue: 0,0:02:45.54,0:02:47.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enam! Berjuanglah!
Dialogue: 0,0:02:48.70,0:02:54.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi saat pesertanya menipis,\Nkurasa dia akan mulai meluluskan orang.
Dialogue: 0,0:02:56.43,0:03:02.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya peluang lulus kita makin besar\Nkalau mengantre di belakang, mau coba?
Dialogue: 0,0:03:02.58,0:03:04.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul juga.
Dialogue: 0,0:03:04.14,0:03:06.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih tawarannya.
Dialogue: 0,0:03:06.12,0:03:09.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fia, jangan kabur!\NMaju sini!
Dialogue: 0,0:03:10.59,0:03:14.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Abangku memanggil, aku harus pergi.
Dialogue: 0,0:03:15.51,0:03:18.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beraninya mencoba kabur.
Dialogue: 0,0:03:18.22,0:03:22.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sombong cuma karena menjinakkan\Nmakhluk mirip naga hitam!
Dialogue: 0,0:03:22.85,0:03:24.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makhluk mirip naga hitam?
Dialogue: 0,0:03:24.67,0:03:28.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menjinakkan?\NMenjinakkan monster?
Dialogue: 0,0:03:28.24,0:03:32.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku mau diam saja\Ndan menyembunyikan jati diri
Dialogue: 0,0:03:32.05,0:03:34.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}biar tetap aman!
Dialogue: 0,0:03:34.45,0:03:36.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan melamun!
Dialogue: 0,0:03:36.24,0:03:37.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Majulah!
Dialogue: 0,0:03:37.86,0:03:39.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa boleh buat.
Dialogue: 0,0:03:39.86,0:03:41.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon bimbingannya.
Dialogue: 0,0:03:42.62,0:03:46.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harus cepat kuakhiri biar mulutnya diam!
Dialogue: 0,0:03:47.22,0:03:51.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penguatan fisik, serangan kali 1,2,\Nkecepatan kali 1,2!
Dialogue: 0,0:03:55.05,0:03:56.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuat juga.
Dialogue: 0,0:03:56.64,0:03:57.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:03:57.78,0:04:02.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ubah penguatan fisik, serangan kali 1,5,\Nkecepatan kali 1,5!
Dialogue: 0,0:04:13.66,0:04:15.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat, aku jadi tontonan!
Dialogue: 0,0:04:16.45,0:04:18.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Penguji memang hebat!
Dialogue: 0,0:04:18.33,0:04:23.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku beruntung bisa beradu pedang 10 kali\Nkarena kamu menahan diri.
Dialogue: 0,0:04:24.19,0:04:28.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku izin pamit, terima kasih atas waktumu!
Dialogue: 0,0:04:31.96,0:04:34.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini ujian kedua.
Dialogue: 0,0:04:34.21,0:04:36.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktunya 100 menit.
Dialogue: 0,0:04:36.21,0:04:37.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai!
Dialogue: 0,0:04:42.32,0:04:45.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujian terakhirnya latih tanding\Nselama tiga menit.
Dialogue: 0,0:04:45.39,0:04:48.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pakai pedang tumpul\Nbekas latihan para kesatria.
Dialogue: 0,0:04:48.89,0:04:52.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau boleh pakai pedang\Nyang kalian pakai berlatih.
Dialogue: 0,0:04:52.90,0:04:57.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang pemberian Ayah saat aku\Nlulus upacara kedewasaan ini
Dialogue: 0,0:04:57.28,0:05:01.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}telah diberi efek serangan kali dua,\Nkecepatan kali dua,
Dialogue: 0,0:05:01.26,0:05:05.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan sihir kamuflase agar terlihat\Nseperti pedang biasa.
Dialogue: 0,0:05:05.81,0:05:11.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teknik memberi efek ke senjata sudah punah,\Nseharusnya tidak ada yang sadar.
Dialogue: 0,0:05:11.10,0:05:13.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa bertarung sepuasnya.
Dialogue: 0,0:05:21.36,0:05:22.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya!
Dialogue: 0,0:05:22.83,0:05:24.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon bimbingannya.
Dialogue: 0,0:05:24.43,0:05:26.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, orang yang tadi.
Dialogue: 0,0:05:29.68,0:05:33.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mengimbangi penguji?\NBahkan bisa menang?
Dialogue: 0,0:05:40.99,0:05:42.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski tidak ada yang sadar,
Dialogue: 0,0:05:42.93,0:05:45.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku yang dulunya santa agung menyadarinya.
Dialogue: 0,0:05:46.20,0:05:47.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lengan...
Dialogue: 0,0:05:47.95,0:05:49.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lengan kanannya patah.
Dialogue: 0,0:05:49.70,0:05:50.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awas!
Dialogue: 0,0:05:55.58,0:05:58.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, apa kamu terluka?
Dialogue: 0,0:05:59.46,0:06:02.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beradu pedang pun pasti terasa sakit.
Dialogue: 0,0:06:04.89,0:06:07.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berilah lengan kanannya perlindungan.
Dialogue: 0,0:06:15.10,0:06:18.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujian masih berlangsung, cepatlah kembali.
Dialogue: 0,0:06:18.45,0:06:21.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}O-Oke, terima kasih.
Dialogue: 0,0:06:21.24,0:06:25.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski sihirku simpel, seharusnya sakitnya\Nhilang selama lima menit.
Dialogue: 0,0:06:25.22,0:06:27.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang baris di belakang.
Dialogue: 0,0:06:27.06,0:06:28.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suara ini...
Dialogue: 0,0:06:28.37,0:06:32.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujian grup kami telah selesai.
Dialogue: 0,0:06:32.37,0:06:34.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemarilah sebagian.
Dialogue: 0,0:06:34.54,0:06:36.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata memang Bang Ardio.
Dialogue: 0,0:06:36.50,0:06:38.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesatria Es jadi penguji kita?
Dialogue: 0,0:06:38.99,0:06:41.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh sebuah kehormatan.
Dialogue: 0,0:06:41.41,0:06:43.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kehormatan dari mananya?
Dialogue: 0,0:06:46.22,0:06:49.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuh, kan?\NAbangku itu tidak kenal ampun.
Dialogue: 0,0:06:49.20,0:06:51.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya kamu, Fia.
Dialogue: 0,0:06:52.61,0:06:54.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Majulah dengan niat membunuh.
Dialogue: 0,0:06:54.60,0:06:58.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini tidak akan semudah melawan Bang Leon.
Dialogue: 0,0:06:58.36,0:07:01.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Batu sihir dari upacara kedewasaanku.
Dialogue: 0,0:07:01.36,0:07:04.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini juga telah kuberi sihir.
Dialogue: 0,0:07:04.36,0:07:08.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasakanlah jurus pedang setrumku, Bang.
Dialogue: 0,0:07:08.37,0:07:11.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya perkaya kosakatamu.
Dialogue: 0,0:07:11.74,0:07:14.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi-lagi ceramah.
Dialogue: 0,0:07:14.22,0:07:16.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, ayo mulai.
Dialogue: 0,0:07:16.34,0:07:17.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon bimbingannya.
Dialogue: 0,0:07:18.21,0:07:19.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mulai!
Dialogue: 0,0:07:23.92,0:07:26.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inilah kekuatan pedang setrumku!
Dialogue: 0,0:07:27.41,0:07:29.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Trik apa ini?
Dialogue: 0,0:07:29.05,0:07:30.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gangguan status.
Dialogue: 0,0:07:30.72,0:07:33.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang menyentuh pedang ini\Nakan lumpuh sementara.
Dialogue: 0,0:07:34.21,0:07:35.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang menang.
Dialogue: 0,0:07:35.93,0:07:39.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena Abang akan kaku\Nsampai waktunya habis.
Dialogue: 0,0:07:39.06,0:07:42.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tinggal tunggu waktu saja.
Dialogue: 0,0:07:42.57,0:07:46.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak malu menang pakai cara licik?
Dialogue: 0,0:07:46.64,0:07:48.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menang tetaplah menang.
Dialogue: 0,0:07:48.58,0:07:49.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu habis!
Dialogue: 0,0:07:49.82,0:07:51.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hore.
Dialogue: 0,0:07:57.33,0:08:00.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi-lagi jadi tontonan!
Dialogue: 0,0:08:08.22,0:08:12.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku lulus! Syukurlah!
Dialogue: 0,0:08:12.21,0:08:14.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku telah resmi jadi kesatria!
Dialogue: 0,0:08:14.60,0:08:19.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setahuku peserta yang lulus harus mendaftar\Nuntuk tinggal di asrama kesatria.
Dialogue: 0,0:08:19.57,0:08:22.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, harus tahu dulu masuk ordo mana.
Dialogue: 0,0:08:22.03,0:08:24.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita sama-sama lulus, ya.
Dialogue: 0,0:08:24.22,0:08:26.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu yang waktu itu...
Dialogue: 0,0:08:26.22,0:08:28.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Izin memperkenalkan diri, ya?
Dialogue: 0,0:08:29.15,0:08:32.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Fabian, pewaris sah Keluarga Marquis Winer.
Dialogue: 0,0:08:32.53,0:08:37.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, marquis benaran ada?\NKukira cuma mitos?
Dialogue: 0,0:08:38.41,0:08:43.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang marquis itu ayahku, sih.\NKami juga bukan sejenis hantu, kok.
Dialogue: 0,0:08:43.91,0:08:47.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maksudku bukan begitu.
Dialogue: 0,0:08:47.46,0:08:50.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Fia, putri kedua Keluarga Kesatria Ruud.
Dialogue: 0,0:08:50.55,0:08:53.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salam kenal, boleh aku memanggilmu Fia?
Dialogue: 0,0:08:53.92,0:08:56.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang kalau dipanggil Fab.
Dialogue: 0,0:08:56.67,0:08:57.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:08:57.31,0:09:00.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mencarimu untuk berterima kasih.
Dialogue: 0,0:09:00.51,0:09:03.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya lenganku cedera waktu ujian.
Dialogue: 0,0:09:03.63,0:09:08.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi sakitnya hilang\Nsetelah menerima pedang darimu.
Dialogue: 0,0:09:09.89,0:09:11.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:09:12.20,0:09:16.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayaknya dia tidak sadar\Nkuberikan sihir penyembuh.
Dialogue: 0,0:09:17.68,0:09:19.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lenganmu sudah sembuh?
Dialogue: 0,0:09:19.62,0:09:24.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, masa anggota baru lengannya patah?
Dialogue: 0,0:09:25.15,0:09:29.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi aku minum banyak ramuan penyembuh,\Nmenggeliat kesakitan,
Dialogue: 0,0:09:29.06,0:09:31.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan akhirnya disembuhkan langsung oleh santa.
Dialogue: 0,0:09:31.88,0:09:35.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waduh, ngeri banget.
Dialogue: 0,0:09:35.94,0:09:40.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekali lagi, terima kasih telah memungut\Npedangku waktu ujian.
Dialogue: 0,0:09:40.59,0:09:43.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin kamu adalah dewi keberuntungan.
Dialogue: 0,0:09:43.77,0:09:46.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duh, gawat!
Dialogue: 0,0:09:46.02,0:09:50.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia penakluk wanita alami yang marak\Ndi kalangan bangsawan!
Dialogue: 0,0:09:52.99,0:09:54.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fia.
Dialogue: 0,0:09:54.16,0:09:58.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu masuk Ordo Kesatria Pertama,\Nsama denganku.
Dialogue: 0,0:09:58.05,0:10:00.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lah, Ordo Kesatria Pertama?
Dialogue: 0,0:10:00.27,0:10:03.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, ada 20 ordo kesatria.
Dialogue: 0,0:10:03.54,0:10:04.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ordo Kesatria Pertama
Dialogue: 0,0:10:04.42,0:10:05.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang mengawal keluarga kerajaan
Dialogue: 0,0:10:05.71,0:10:07.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan Ordo Kesatria Kedua yang menjaga kastel
Dialogue: 0,0:10:07.65,0:10:11.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}umumnya diisi kesatria yang sudah\Nmengabdi lebih dari 10 tahun.
Dialogue: 0,0:10:11.30,0:10:17.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini pertama kalinya dalam sejarah\Nanggota baru seperti kita direkrut.
Dialogue: 0,0:10:17.18,0:10:19.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oleh pasukan super elite itu?
Dialogue: 0,0:10:19.89,0:10:23.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke-Keluarga kerajaan itu...
Dialogue: 0,0:10:24.03,0:10:29.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keturunan dari salah satu abang\Nyang menelantarkanku, dong?
Dialogue: 0,0:10:29.61,0:10:33.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus melindungi mereka?
Dialogue: 0,0:10:33.07,0:10:37.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ta-Takutnya aku kesal\Ndan malah menelantarkan mereka.
Dialogue: 0,0:10:37.62,0:10:38.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fia?
Dialogue: 0,0:10:38.87,0:10:40.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maaf.
Dialogue: 0,0:10:40.91,0:10:45.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kepikiran siapa saja keluarga kerajaannya.
Dialogue: 0,0:10:45.37,0:10:47.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh.
Dialogue: 0,0:10:47.50,0:10:52.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini cuma ada keluarga kerajaan.\NPaduka Raja dan Pangeran adik beliau.
Dialogue: 0,0:10:53.41,0:10:57.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, katanya Paduka Raja\Ntidak bisa mencintai wanita.
Dialogue: 0,0:10:57.46,0:11:01.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya Paduka mau mewariskan takhta\Nkepada Pangeran.
Dialogue: 0,0:11:03.14,0:11:05.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin kamu sudah tahu.
Dialogue: 0,0:11:05.46,0:11:09.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pangeran adalah ketum dari ordo kesatria.
Dialogue: 0,0:11:09.76,0:11:10.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketum?
Dialogue: 0,0:11:10.80,0:11:12.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baru tahu, ya?
Dialogue: 0,0:11:12.61,0:11:17.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski sempat dengar gosipnya,\Ntidak kusangka dia pangeran.
Dialogue: 0,0:11:17.02,0:11:20.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Besok beliau akan berpidato\Ndi upacara penerimaan.
Dialogue: 0,0:11:20.40,0:11:22.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat saja nanti.
Dialogue: 0,0:11:32.77,0:11:34.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ramai sekali!
Dialogue: 0,0:11:42.34,0:11:44.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suasananya berubah.
Dialogue: 0,0:11:45.81,0:11:48.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, jadi orang itu...
Dialogue: 0,0:11:52.93,0:11:57.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama, mari rayakan bertambahnya\Nrekan seperjuangan kita.
Dialogue: 0,0:11:57.95,0:12:02.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari bersumpah untuk hidup\Nsederhana, suci, dan setia.
Dialogue: 0,0:12:02.95,0:12:07.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan menjarah, mengucilkan,\Ndan takluk pada siapa pun.
Dialogue: 0,0:12:07.66,0:12:13.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Junjunglah 10 sumpah kesatria dan mengabdilah\Nuntuk rakyat hingga tetes darah terakhir!
Dialogue: 0,0:12:14.00,0:12:18.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Langit dan bumi menyertai\NOrdo Kesatria Naga Hitam Kerajaan Nav!
Dialogue: 0,0:12:19.05,0:12:21.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Langit dan bumi menyertai
Dialogue: 0,0:12:21.05,0:12:24.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ordo Kesatria Naga Hitam Kerajaan Nav!
Dialogue: 0,0:12:24.96,0:12:26.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat.
Dialogue: 0,0:12:26.68,0:12:30.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baru pertama aku melihat orang\Nseberpengaruh ini.
Dialogue: 0,0:12:30.56,0:12:35.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin hasil bakat dan keahlian\Nyang terus dia tunjukkan.
Dialogue: 0,0:12:35.69,0:12:37.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh hebat.
Dialogue: 0,0:12:39.57,0:12:41.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia melirikku?
Dialogue: 0,0:12:41.95,0:12:43.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayaknya.
Dialogue: 0,0:12:44.20,0:12:48.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi mustahil, paling aku cuma kepedean.
Dialogue: 0,0:12:48.46,0:12:51.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya, salam dari anggota baru.
Dialogue: 0,0:12:51.83,0:12:53.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fabian Winer!
Dialogue: 0,0:12:54.71,0:12:56.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Fabian Winer,
Dialogue: 0,0:12:56.10,0:12:58.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- izin mewakili para anggota baru.\N- Hei, ada gadis pendatang baru berambut merah.
Dialogue: 0,0:12:58.77,0:12:59.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kami berjumlah 200 orang.\N- Hei, ada gadis pendatang baru berambut merah.
Dialogue: 0,0:12:59.63,0:13:01.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kami berjumlah 200 orang.\N- Siapa dia?
Dialogue: 0,0:13:01.22,0:13:04.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Sebagai Ordo Kesatria Naga Hitam Kerajaan Nav,\N- Siap, dia Fia dari Keluarga Kesatria Ruud.
Dialogue: 0,0:13:04.47,0:13:07.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Sebagai Ordo Kesatria Naga Hitam Kerajaan Nav,\N- Anggota baru Ordo Kesatria Pertama.
Dialogue: 0,0:13:07.73,0:13:09.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- kami berjanji akan mengabdi untuk rakyat\N- Orang itu, ya.
Dialogue: 0,0:13:09.72,0:13:10.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- kami berjanji akan mengabdi untuk rakyat\N- Baiklah.
Dialogue: 0,0:13:10.72,0:13:12.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hingga tetes darah terakhir!
Dialogue: 0,0:13:12.74,0:13:16.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat sekali, lidahmu tidak keseleo.
Dialogue: 0,0:13:16.59,0:13:19.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa itu cuma berlaku buatmu.
Dialogue: 0,0:13:19.90,0:13:21.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:13:21.11,0:13:23.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya duel demonstrasi.
Dialogue: 0,0:13:23.46,0:13:28.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anggota baru akan diwakili\NFia Ruud dari Ordo Kesatria Pertama.
Dialogue: 0,0:13:29.06,0:13:30.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:13:30.05,0:13:35.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lawannya...\NDa-Dari... Ordo Kesatria Naga Hitam.
Dialogue: 0,0:13:36.24,0:13:38.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketum Saviz Nav!
Dialogue: 0,0:13:41.68,0:13:42.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:13:44.40,0:13:46.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang benar saja!
Dialogue: 0,0:13:46.14,0:13:47.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok ada bocah?
Dialogue: 0,0:13:47.76,0:13:50.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana ini?
Dialogue: 0,0:13:50.27,0:13:54.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketum, ini cuma akan jadi\Npembantaian sepihak!
Dialogue: 0,0:13:54.15,0:13:56.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ha-Harap tenang!
Dialogue: 0,0:13:56.15,0:13:59.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, badanku membeku saking gugupnya.
Dialogue: 0,0:13:59.31,0:14:00.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fia!
Dialogue: 0,0:14:00.50,0:14:01.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Abang!
Dialogue: 0,0:14:01.44,0:14:07.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa beradu pedang dengan Ketum Saviz\Nadalah karunia terbaik di hidupmu.
Dialogue: 0,0:14:07.22,0:14:10.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mati pun boleh, pokoknya coba dulu!
Dialogue: 0,0:14:10.58,0:14:11.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mati?
Dialogue: 0,0:14:12.08,0:14:14.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hampir lupa.
Dialogue: 0,0:14:14.33,0:14:17.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Abang-abangku kesatria yang fanatik.
Dialogue: 0,0:14:17.46,0:14:20.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi kesatria juga cita-citaku, kan?
Dialogue: 0,0:14:20.99,0:14:25.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini panggung impianku, tidak perlu takut.
Dialogue: 0,0:14:25.07,0:14:28.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku disadarkan omongan bodoh mereka.
Dialogue: 0,0:14:30.80,0:14:31.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fia Ruud.
Dialogue: 0,0:14:33.14,0:14:35.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan menyerang.
Dialogue: 0,0:14:36.64,0:14:38.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Majulah sekuat tenaga.
Dialogue: 0,0:14:42.53,0:14:46.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penguatan fisik, serangan kali tiga,\Nkecepatan kali tiga.
Dialogue: 0,0:14:47.12,0:14:49.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah memperkuat diri dengan maksimal.
Dialogue: 0,0:14:50.93,0:14:54.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini?\NCuma kecepatannya yang bisa kutandingi.
Dialogue: 0,0:14:54.82,0:14:56.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bagaikan monster!
Dialogue: 0,0:14:56.79,0:15:00.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Fia Ruud, izin duel dengan Ketum!
Dialogue: 0,0:15:11.89,0:15:13.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ge-Gesit sekali!
Dialogue: 0,0:15:13.68,0:15:16.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari suara benturannya,
Dialogue: 0,0:15:16.31,0:15:19.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pedang itu kayaknya berat!
Dialogue: 0,0:15:39.79,0:15:43.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duel selesai!\NPemenangnya Ketum Saviz!
Dialogue: 0,0:15:46.34,0:15:48.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak sah.
Dialogue: 0,0:15:48.11,0:15:52.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku telah melanggar janji\Nuntuk tidak menyerang.
Dialogue: 0,0:15:52.93,0:15:55.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fia Ruud, perlihatkan pedangmu.
Dialogue: 0,0:15:55.68,0:15:57.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Baik.
Dialogue: 0,0:16:02.64,0:16:03.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cyril.
Dialogue: 0,0:16:03.78,0:16:05.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap, hadir.
Dialogue: 0,0:16:06.53,0:16:11.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Warna selempang itu\Nmilik Ordo Kesatria Pertama...
Dialogue: 0,0:16:12.19,0:16:13.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:16:13.49,0:16:15.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten Ordo Kesatria Pertama, Cyril.
Dialogue: 0,0:16:15.91,0:16:17.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia atasanku.
Dialogue: 0,0:16:17.66,0:16:20.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Angkat pedangmu, ayo berduel.
Dialogue: 0,0:16:31.50,0:16:34.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang mithril-ku dipatahkan pedang besi?
Dialogue: 0,0:16:34.68,0:16:39.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang ini diberi sihir efek\Npenguat serangan dan kecepatan.
Dialogue: 0,0:16:39.23,0:16:43.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, diberi sihir kamuflase\Nagar efeknya tidak ketahuan.
Dialogue: 0,0:16:44.27,0:16:46.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ce-Celaka!
Dialogue: 0,0:16:46.94,0:16:51.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin bawahanmu yang di sana\Nbisa menjelaskannya.
Dialogue: 0,0:16:51.73,0:16:53.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, kan, Fia?
Dialogue: 0,0:16:55.20,0:17:01.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Umumnya penguatan serangan\Ncuma tambah 10 atau 15.
Dialogue: 0,0:17:01.30,0:17:05.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kulipatgandakan jadi "kali",\Nkekuatan Ketum malah melonjak!
Dialogue: 0,0:17:05.92,0:17:08.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Barang ini setara pusaka nasional.
Dialogue: 0,0:17:08.80,0:17:13.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Efek serangan pedang ini bukan sekadar\Ntambah 100 atau 200.
Dialogue: 0,0:17:14.05,0:17:17.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat memegangnya, aku serasa jadi Majin.
Dialogue: 0,0:17:17.68,0:17:20.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fia, coba jelaskan.
Dialogue: 0,0:17:20.03,0:17:21.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang itu...
Dialogue: 0,0:17:24.56,0:17:28.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang itu pemberian Ayah\Ndari upacara kedewasaanku!
Dialogue: 0,0:17:28.16,0:17:30.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mu-Mustahil!
Dialogue: 0,0:17:30.70,0:17:34.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang itu cuma asal ambil dari gudang!
Dialogue: 0,0:17:34.50,0:17:40.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tahu itu pedang sihir berharga,\Naku pasti langsung lapor!
Dialogue: 0,0:17:40.34,0:17:41.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu.
Dialogue: 0,0:17:41.92,0:17:44.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau tanya satu hal.
Dialogue: 0,0:17:47.18,0:17:50.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu terus menyerang sisi kiriku?
Dialogue: 0,0:17:52.67,0:17:54.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu jiwa kesatriaku.
Dialogue: 0,0:17:54.55,0:17:57.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena Ketum bilang tidak akan menyerang,
Dialogue: 0,0:17:57.79,0:18:01.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kurang pantas bagiku menyerang titik butamu.
Dialogue: 0,0:18:01.27,0:18:04.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bawa pedang sihir demi bisa menang
Dialogue: 0,0:18:04.72,0:18:06.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu sebut jiwa kesatria?
Dialogue: 0,0:18:07.66,0:18:11.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat, aku harus jujur biar dilepaskan.
Dialogue: 0,0:18:11.82,0:18:18.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, berusaha menang adalah bentuk\Nhormatku pada Ketum.
Dialogue: 0,0:18:18.47,0:18:23.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menyerang sisi kiri\Nkarena kaki kirimu cedera.
Dialogue: 0,0:18:23.29,0:18:26.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok bisa tahu kaki kiriku terluka?
Dialogue: 0,0:18:27.42,0:18:28.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Habisnya...
Dialogue: 0,0:18:28.55,0:18:32.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat berjalan, entakkan kaki kirimu
Dialogue: 0,0:18:32.78,0:18:37.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sedikit lebih cepat\Ndari entakkan kaki yang kanan.
Dialogue: 0,0:18:37.31,0:18:41.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat berdiri pun, tumpuan kakimu\Nterlihat condong ke kanan.
Dialogue: 0,0:18:43.18,0:18:48.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu-satunya yang bisa merusak keseimbangan\Nkesatria terlatih seperti Ketum,
Dialogue: 0,0:18:48.75,0:18:50.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}rasanya cuma cedera.
Dialogue: 0,0:18:55.07,0:18:57.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa omonganku aneh?
Dialogue: 0,0:18:57.92,0:19:01.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, aku sudah ingat namamu.
Dialogue: 0,0:19:05.12,0:19:08.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}U-Upacara penerimaan selesai!
Dialogue: 0,0:19:11.55,0:19:14.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cederaku memang belum pulih total.
Dialogue: 0,0:19:14.59,0:19:18.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu pun hanya diketahui segelintir orang.
Dialogue: 0,0:19:18.78,0:19:22.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari semua kesatria baru yang menggebu-gebu,
Dialogue: 0,0:19:22.54,0:19:25.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}cuma satu yang menatapku santai.
Dialogue: 0,0:19:26.13,0:19:28.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak terbawa suasana,
Dialogue: 0,0:19:28.10,0:19:30.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}cermat akan situasi,
Dialogue: 0,0:19:30.75,0:19:32.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan tatapan menganalisis.
Dialogue: 0,0:19:34.99,0:19:38.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia punya aura penguasa.
Dialogue: 0,0:19:39.49,0:19:43.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fia Ruud, siapa gadis itu sebenarnya?
Dialogue: 0,0:21:16.78,0:21:21.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, bagaimana anggota baru kita, Desmond?
Dialogue: 0,0:21:21.36,0:21:22.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entahlah.
Dialogue: 0,0:21:22.68,0:21:24.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok bilang begitu?
Dialogue: 0,0:21:24.47,0:21:26.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah seminggu berlalu.
Dialogue: 0,0:21:26.56,0:21:30.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena petinggi polisi militer sepertimu\Nbilang mau memastikannya,
Dialogue: 0,0:21:32.03,0:21:34.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku cuma bisa menunggu.
Dialogue: 0,0:21:34.98,0:21:36.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya...
Dialogue: 0,0:21:38.51,0:21:42.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fia itu istimewa.\NKami sudah main catur tiga kali.
Dialogue: 0,0:21:43.50,0:21:46.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski musuhnya lemah atau mengimbangi,
Dialogue: 0,0:21:46.90,0:21:49.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ujungnya dia pasti menang.
Dialogue: 0,0:21:49.79,0:21:55.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Secara tidak sadar, dia menilai kemampuan lawan\Ndan selalu berusaha menang tipis.
Dialogue: 0,0:21:58.02,0:22:02.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah apa alasannya.
Dialogue: 0,0:22:03.20,0:22:08.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baru tahu ahli analisis perilaku\Nsepertimu bisa kebingungan.
Dialogue: 0,0:22:09.31,0:22:11.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi biasanya dia tidak peka.
Dialogue: 0,0:22:11.93,0:22:16.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rambut Fabian dipotong tiga senti pun\Ndia tidak sadar.
Dialogue: 0,0:22:16.38,0:22:19.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa dibilang dia sangat tidak peka.
Dialogue: 0,0:22:19.57,0:22:22.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis yang penuh misteri, ya.
Dialogue: 0,0:22:23.82,0:22:26.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana denganmu, Enoch?
Dialogue: 0,0:22:26.57,0:22:29.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang itu punya efek dinamis
Dialogue: 0,0:22:29.24,0:22:31.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang cuma ada 300 tahun lalu
Dialogue: 0,0:22:31.94,0:22:34.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pada Era Keemasan Puncak.
Dialogue: 0,0:22:34.58,0:22:40.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makin kuat pemiliknya, makin kuat juga\Ndaya serang dan kecepatannya.
Dialogue: 0,0:22:40.58,0:22:45.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma ada tiga pedang efek dinamis\Nyang ada di negeri ini.
Dialogue: 0,0:22:45.15,0:22:48.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa masih ada lagi?
Dialogue: 0,0:22:48.14,0:22:51.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin titik-titik ini
Dialogue: 0,0:22:54.41,0:22:57.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}punya satu garis temu.
Dialogue: 0,0:22:57.46,0:22:59.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Walau entah di mana garisnya.
Dialogue: 0,0:23:00.34,0:23:01.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong,
Dialogue: 0,0:23:01.53,0:23:04.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu cuma boleh tanya jawab dengannya.
Dialogue: 0,0:23:04.93,0:23:06.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fia itu anggota ordoku.
Dialogue: 0,0:23:06.99,0:23:08.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia anak asuhku.
Dialogue: 0,0:23:08.99,0:23:11.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi jangan dekat-dekat lagi, ya.
Dialogue: 0,0:23:11.33,0:23:16.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma bertugas!\NJangan diperlakukan kayak orang mesum!
Dialogue: 0,0:23:20.08,0:23:26.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar, besok Fia anak asuhmu akan ikut\NOrdo Kesatria Keenam membasmi monster.
Dialogue: 0,0:23:26.09,0:23:29.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, itulah aturan kesatria tahun pertama.
Dialogue: 0,0:23:30.45,0:23:32.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga semua berjalan lancar.
