Dialogue: 0,0:02:44.44,0:02:49.23,sign,,0000,0000,0000,,REINKARNASI SANTA AGUNG YANG MENYEMBUNYIKAN\NJATI DIRINYA SEBAGAI SANTA
Dialogue: 0,0:04:00.01,0:04:04.52,sign,,0000,0000,0000,,EPISODE 7: ZAVILIA
Dialogue: 0,0:23:35.06,0:23:40.69,sign,,0000,0000,0000,,EPISODE 8: TEMAN IMUTKU
Dialogue: 0,0:00:07.73,0:00:09.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tim penyihir, pakai sihir jebakan!
Dialogue: 0,0:00:13.12,0:00:14.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:00:14.38,0:00:17.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir jebakan akan meledak\Nkalau diinjak Mimpi Buruk Hijau.
Dialogue: 0,0:00:17.71,0:00:20.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan begitu lokasinya bisa dilacak.
Dialogue: 0,0:00:24.26,0:00:25.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa?
Dialogue: 0,0:00:25.18,0:00:26.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok begini?
Dialogue: 0,0:00:26.27,0:00:30.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata Mimpi Buruk Hijau di depan\Ncuma ilusi, yang aslinya...
Dialogue: 0,0:00:30.90,0:00:32.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:00:35.77,0:00:38.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain sulit melacak lokasinya,
Dialogue: 0,0:00:38.51,0:00:40.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bahaya kalau bertarung berkelompok.
Dialogue: 0,0:00:40.86,0:00:44.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asal mengayun pedang akan melukai rekan.
Dialogue: 0,0:00:46.93,0:00:50.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku disuruh berjaga saja, tapi...
Dialogue: 0,0:00:51.72,0:00:54.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Insting bertahan hidup monster itu kuat.
Dialogue: 0,0:00:54.67,0:00:58.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka sangat menginginkan\Nkemampuan penyembuhmu.
Dialogue: 0,0:00:59.23,0:01:04.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya tanpa kontrak pun,\Nkamu yang punya kekuatan diakui master
Dialogue: 0,0:01:04.20,0:01:06.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan ditunggu perintahnya.
Dialogue: 0,0:01:06.55,0:01:07.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:01:17.56,0:01:21.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ilusinya cuma aktif dalam lingkaran\Nbuatan Burung Mimpi.
Dialogue: 0,0:01:21.99,0:01:26.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya para hewan kontrak di luar area ilusi\Nbisa terbang ke atas Mimpi Buruk Hijau
Dialogue: 0,0:01:26.46,0:01:30.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan memberi tahu lokasinya\Nke regu Kapten Zackary.
Dialogue: 0,0:01:30.48,0:01:33.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekanglah, niscaya dosa diampuni.
Dialogue: 0,0:01:33.99,0:01:35.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurungan Sederhana!
Dialogue: 0,0:01:37.17,0:01:40.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sembunyikan rahasia itu\Ndi balik niat baik dan niat jahat.
Dialogue: 0,0:01:40.91,0:01:42.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyelubungan Tingkat Dua!
Dialogue: 0,0:01:43.54,0:01:47.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan ini, Mimpi Buruk Hijau tidak akan bisa\Nmengusik para hewan kontrak.
Dialogue: 0,0:01:51.74,0:01:55.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia menyadarinya dan langsung\Nkembali ke wujud semula!
Dialogue: 0,0:01:58.98,0:02:02.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasakan ilusi balasan\Ndari kurungan tidak terlihat itu!
Dialogue: 0,0:02:02.82,0:02:05.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Balas dendam yang berkelas, kan?
Dialogue: 0,0:02:05.87,0:02:08.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Burung Mimpi berada 10 meter di atas tanah!
Dialogue: 0,0:02:08.83,0:02:11.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sudah keluar dari area ilusi!
Dialogue: 0,0:02:11.68,0:02:13.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang kini terlihat adalah lokasi aslinya!
Dialogue: 0,0:02:14.22,0:02:18.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten Zackary, suruh para pemanah\Ndan penyihir menghambatnya!
Dialogue: 0,0:02:18.17,0:02:21.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para Hewan Kontrak aman\Nkarena punya proteksi diri.
Dialogue: 0,0:02:21.51,0:02:24.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asal Burung Mimpi keluar\Ndari lingkaran buatannya,
Dialogue: 0,0:02:24.50,0:02:26.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ilusi ini akan hilang!
Dialogue: 0,0:02:26.67,0:02:27.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke.
Dialogue: 0,0:02:27.54,0:02:29.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya, menjauh dari situ!
Dialogue: 0,0:04:05.27,0:04:08.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, semuanya kembali normal.
Dialogue: 0,0:04:08.13,0:04:10.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita mulai dari awal, yuk.
Dialogue: 0,0:04:10.76,0:04:12.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fi-Fia...
Dialogue: 0,0:04:12.59,0:04:15.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekilas kamu bagaikan utusan dari neraka.
Dialogue: 0,0:04:15.81,0:04:18.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma kesatria baru yang taat, kok.
Dialogue: 0,0:04:18.91,0:04:23.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berjaga sesuai perintah\NKapten Zackary, kan?
Dialogue: 0,0:04:24.46,0:04:26.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia menyerah dan malah kemari!
Dialogue: 0,0:04:26.54,0:04:27.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serang!
Dialogue: 0,0:04:28.16,0:04:31.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Burung Mimpi membuat ruang ilusi
Dialogue: 0,0:04:31.10,0:04:33.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan terbang di berbagai ketinggian.
Dialogue: 0,0:04:34.38,0:04:37.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kalau Kapten Zackary memahami pola
Dialogue: 0,0:04:37.24,0:04:39.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan menunggu terbangnya rendah...
Dialogue: 0,0:04:39.60,0:04:40.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten!
Dialogue: 0,0:04:40.51,0:04:42.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Monster lain muncul!
Dialogue: 0,0:04:42.76,0:04:46.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Du-Dua Babi Hutan Ungu\Ndan Rusa Tanduk Bunga!
Dialogue: 0,0:04:46.50,0:04:48.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiga ekor lainnya?
Dialogue: 0,0:04:48.25,0:04:49.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita terdesak.
Dialogue: 0,0:04:49.35,0:04:54.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Monster selevel itu bisa\NKapten Zackary atasi, kok!
Dialogue: 0,0:04:54.40,0:04:56.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau buntu, kami punya...
Dialogue: 0,0:04:58.49,0:05:02.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat, ada naga di Barat,\Ndua ekor pula.
Dialogue: 0,0:05:02.54,0:05:06.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Naga itu kelas S, kan?\NSepertinya gawat.
Dialogue: 0,0:05:07.58,0:05:10.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hampir semua naga bisa kuatasi, sih.
Dialogue: 0,0:05:10.37,0:05:12.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, bisa diandalkan!
Dialogue: 0,0:05:12.11,0:05:15.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, monster apa\Nyang muncul di Timur?
Dialogue: 0,0:05:15.98,0:05:20.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu Rusa Tanduk Bunga\Ndan satu Babi Hutan Ungu.
Dialogue: 0,0:05:20.13,0:05:22.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti dibiarkan pun aman, ya.
Dialogue: 0,0:05:22.75,0:05:28.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten Zackary, Wakil Kapten Gideon bertemu\NRusa Tanduk Bunga dan Babi Hutan Ungu.
Dialogue: 0,0:05:28.11,0:05:29.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Tahu dari mana?
Dialogue: 0,0:05:29.84,0:05:33.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, mereka harus urus sendiri\Nkarena kita pun kewalahan.
Dialogue: 0,0:05:33.92,0:05:35.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampaikan itu pakai peluit darurat!
Dialogue: 0,0:05:35.90,0:05:37.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}O-Oke.
Dialogue: 0,0:05:39.72,0:05:43.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, Kapten Quentin bertemu dua ekor naga.
Dialogue: 0,0:05:43.10,0:05:44.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dua ekor naga?
Dialogue: 0,0:05:44.64,0:05:45.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu gawat!
Dialogue: 0,0:05:45.93,0:05:47.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul sekali.
Dialogue: 0,0:05:47.69,0:05:52.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agar bisa bergabung ke sana, ayo kalahkan\Nbabi hutan, rusa, dan burung itu!
Dialogue: 0,0:05:52.56,0:05:55.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enteng banget mulutmu.
Dialogue: 0,0:05:55.15,0:05:58.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten Zackary, tolong akhiri\Ndengan sekali tebas biar cepat!
Dialogue: 0,0:05:58.54,0:06:02.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kamu seenaknya sekali!
Dialogue: 0,0:06:02.17,0:06:05.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelemahan fisik, bobot kali dua!
Dialogue: 0,0:06:13.41,0:06:15.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus, Kapten Zackary!
Dialogue: 0,0:06:15.48,0:06:19.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar yang lain urus sisanya,\Nmari bantu Kapten Quentin!
Dialogue: 0,0:06:19.27,0:06:24.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih ada monster lain!\NMereka tidak bisa mengurusnya sendiri!
Dialogue: 0,0:06:24.00,0:06:28.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ordo Keenam sudah belajar cara memburu\NRusa Tanduk Bunga, kan?
Dialogue: 0,0:06:28.99,0:06:32.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita makan daging lezat itu sama-sama, kan?
Dialogue: 0,0:06:32.36,0:06:35.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kali ini giliran kalian yang traktir, ya!
Dialogue: 0,0:06:35.75,0:06:38.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, biar kami yang urus di sini!
Dialogue: 0,0:06:38.86,0:06:40.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malam ini pesta daging rusa!
Dialogue: 0,0:06:40.88,0:06:42.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka sungguh jantan!
Dialogue: 0,0:06:43.40,0:06:45.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang tidak perlu ragu lagi!
Dialogue: 0,0:06:45.60,0:06:47.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari susul Kapten Quentin!
Dialogue: 0,0:06:47.64,0:06:49.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}O-Oke...
Dialogue: 0,0:06:49.66,0:06:53.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ordo Kesatria Monster,\Nkami mau membantu Regu Quentin!
Dialogue: 0,0:06:53.28,0:06:54.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pinjam hewan kontrak kalian!
Dialogue: 0,0:06:54.75,0:06:58.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya, boleh saja kalau demi Kapten!
Dialogue: 0,0:06:58.40,0:07:00.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, hewan kontrak tidak akan...
Dialogue: 0,0:07:00.56,0:07:03.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah mengizinkan!
Dialogue: 0,0:07:04.78,0:07:06.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kupandu.
Dialogue: 0,0:07:06.77,0:07:09.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka ikut begitu saja!
Dialogue: 0,0:07:09.31,0:07:13.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan Fia itu\Npawang monster legendaris?
Dialogue: 0,0:07:24.27,0:07:27.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Situasinya timpang sekali.
Dialogue: 0,0:07:27.20,0:07:30.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten Quentin menghadapi dua naga biru?
Dialogue: 0,0:07:31.22,0:07:33.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dua naga itu sepasang.
Dialogue: 0,0:07:33.68,0:07:37.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin sedang mencari banyak mangsa\Nsebelum masuk musim kawin.
Dialogue: 0,0:07:37.42,0:07:41.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kesatria aneh itu benaran aneh, ya.
Dialogue: 0,0:07:41.02,0:07:45.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya monster dan manusia\Nsama-sama berharga baginya.
Dialogue: 0,0:07:45.57,0:07:49.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bahkan rela berkorban\Ndemi menolong hewan kontraknya.
Dialogue: 0,0:07:51.01,0:07:52.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial!
Dialogue: 0,0:07:52.09,0:07:53.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten Zackary!
Dialogue: 0,0:07:55.20,0:07:58.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya apa rencana mereka?
Dialogue: 0,0:07:58.05,0:07:59.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di mana para santa?
Dialogue: 0,0:08:00.03,0:08:02.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya mereka kabur.
Dialogue: 0,0:08:03.28,0:08:07.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fia, mungkin kamu belum tahu,\Ndulunya aku naga biru.
Dialogue: 0,0:08:07.85,0:08:10.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Naga biru?
Dialogue: 0,0:08:10.11,0:08:13.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, dulu?\NZavilia juga punya kehidupan lalu?
Dialogue: 0,0:08:13.84,0:08:18.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, aku pernah dengar.\NKalau naga hidup 1000 tahun...
Dialogue: 0,0:08:18.33,0:08:22.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul, naga yang hidup 1000 tahun\Nakan lahir kembali jadi naga hitam.
Dialogue: 0,0:08:22.42,0:08:23.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah diriku.
Dialogue: 0,0:08:25.15,0:08:28.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin ini terdengar naif,
Dialogue: 0,0:08:28.97,0:08:31.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi sebisa mungkin\Naku enggan melawan naga biru.
Dialogue: 0,0:08:32.12,0:08:34.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, ya, Fia.
Dialogue: 0,0:08:35.26,0:08:38.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja, Zavilia.\NSerahkan padaku.
Dialogue: 0,0:08:51.68,0:08:54.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten Zackary luar biasa.
Dialogue: 0,0:08:54.94,0:08:57.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski belum sempurna,
Dialogue: 0,0:08:57.93,0:09:03.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pengalaman bertarung membuatnya\Nmenguasai penguatan fisik secara naluriah.
Dialogue: 0,0:09:07.32,0:09:08.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhasil!
Dialogue: 0,0:09:08.29,0:09:09.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mundur!
Dialogue: 0,0:09:09.42,0:09:11.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemanah, penyihir, dan hewan kontrak!\NBerikan bantuan!
Dialogue: 0,0:09:11.78,0:09:15.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Segera mundur sambil mewaspadai naga birunya!
Dialogue: 0,0:09:21.50,0:09:23.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya kita bisa lolos!
Dialogue: 0,0:09:27.61,0:09:28.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fia!
Dialogue: 0,0:09:39.76,0:09:41.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di masa lalu nan jauh,
Dialogue: 0,0:09:47.68,0:09:51.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku naga biru tanpa nama\Ndengan satu sayap.
Dialogue: 0,0:09:55.66,0:09:58.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dan kakakku berada dalam satu telur.
Dialogue: 0,0:09:59.63,0:10:01.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami anak kembar.
Dialogue: 0,0:10:42.67,0:10:43.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemudian...
Dialogue: 0,0:10:50.80,0:10:52.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu hari.
Dialogue: 0,0:10:53.60,0:10:54.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dua hari.
Dialogue: 0,0:10:56.62,0:11:00.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiga hari menanti membuatku sadar.
Dialogue: 0,0:11:01.52,0:11:03.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu Naga tidak akan kembali.
Dialogue: 0,0:11:04.78,0:11:06.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku telah dibuang.
Dialogue: 0,0:11:08.50,0:11:11.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nama mengandung kekuatan dan ingatan.
Dialogue: 0,0:11:12.29,0:11:15.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak menetas,\NKakak Naga diberi nama khusus
Dialogue: 0,0:11:15.78,0:11:19.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan mewarisi kekuatan\Nsekaligus ingatan Ibu Naga.
Dialogue: 0,0:11:35.16,0:11:36.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedangkan aku...
Dialogue: 0,0:11:39.63,0:11:42.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang tidak diberi nama
Dialogue: 0,0:11:45.81,0:11:48.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hanya bisa bersikap rakus
Dialogue: 0,0:11:54.82,0:11:57.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}demi bisa bertahan hidup.
Dialogue: 0,0:11:59.87,0:12:02.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bertahan hidup selama setahun.
Dialogue: 0,0:12:03.33,0:12:06.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di tahun berikutnya...
Dialogue: 0,0:12:20.67,0:12:23.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sampai di sarang naga biru.
Dialogue: 0,0:12:42.40,0:12:46.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu aku diterima masuk kawanan.
Dialogue: 0,0:12:48.08,0:12:52.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}10 tahun kemudian, aku jadi yang terkuat\Nsetelah Ketua Kawanan.
Dialogue: 0,0:12:56.11,0:12:57.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di suatu malam...
Dialogue: 0,0:13:08.56,0:13:11.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami diserang kawanan fenrir.
Dialogue: 0,0:13:37.91,0:13:42.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat mencoba mendengar wasiat Ketua\Nyang bertarung demi meloloskan kami,
Dialogue: 0,0:13:42.94,0:13:44.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku mendekatkan wajah.
Dialogue: 0,0:13:47.93,0:13:54.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiba-tiba, Ketua yang hampir mati\Nmewariskan nama dan kekuatannya padaku.
Dialogue: 0,0:14:00.74,0:14:01.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zavilia.
Dialogue: 0,0:14:02.56,0:14:04.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nama itu jadi milikku.
Dialogue: 0,0:14:15.53,0:14:19.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menuju gua tempatku menetas.
Dialogue: 0,0:14:24.88,0:14:29.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sana ada Kakak Naga,\Nketua kawanannya,
Dialogue: 0,0:14:29.94,0:14:31.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}serta Ibu Naga.
Dialogue: 0,0:14:33.93,0:14:37.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah mewarisi kekuatan\Ndan jadi ketua baru,
Dialogue: 0,0:14:37.16,0:14:41.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku dan kawananku menetap\Ndi sebagian gua itu.
Dialogue: 0,0:14:41.82,0:14:47.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku percaya bahwa ketua bertugas\Nmelindungi kawanannya.
Dialogue: 0,0:14:47.68,0:14:52.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira itulah cara membalas budi\Nkawanan yang telah menerimaku.
Dialogue: 0,0:14:53.36,0:14:55.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu tibalah malam itu.
Dialogue: 0,0:14:56.38,0:15:01.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin bersama Kakak Naga,\Nkami bisa melindungi semuanya.
Dialogue: 0,0:15:01.52,0:15:03.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kupikir begitu.
Dialogue: 0,0:15:03.56,0:15:04.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:15:05.75,0:15:09.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menyesal tidak memakanmu seutuhnya\Nsaat di dalam telur!
Dialogue: 0,0:15:09.44,0:15:13.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan itu milikku, kembalikan!
Dialogue: 0,0:15:13.02,0:15:14.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenanglah, Kakak!
Dialogue: 0,0:15:14.99,0:15:18.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatannya tidak akan berpindah\Nmeski kamu memakanku!
Dialogue: 0,0:15:18.70,0:15:20.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita ini saudara!
Dialogue: 0,0:15:20.54,0:15:23.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru lebih berguna kalau bekerja sama!
Dialogue: 0,0:15:23.73,0:15:27.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu menipu dan mencuri\Nkekuatan Ketua Lama!
Dialogue: 0,0:15:27.17,0:15:29.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu sok berkuasa dengan kekuatan pinjaman!
Dialogue: 0,0:15:29.96,0:15:34.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sampah paling menjijikkan\Nyang pernah kulihat!
Dialogue: 0,0:15:36.79,0:15:39.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sana ada naga-naga kawananku.
Dialogue: 0,0:15:39.80,0:15:43.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak pernah sudi dipimpin olehmu!
Dialogue: 0,0:15:43.06,0:15:45.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar naga kasta terbawah!
Dialogue: 0,0:15:45.41,0:15:47.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beraninya mencuri kekuatan Ketua Lama!
Dialogue: 0,0:15:47.90,0:15:52.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau memang sebenci itu, kenapa tidak\Nmengajakku duel berebut takhta?
Dialogue: 0,0:15:52.61,0:15:55.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buat apa berduel dengan resmi?
Dialogue: 0,0:15:55.70,0:15:59.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu lebih cocok mati sia-sia di sini!
Dialogue: 0,0:16:13.96,0:16:18.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski dikhianati dan tidak bisa lagi\Nbertemu keluarga,
Dialogue: 0,0:16:18.22,0:16:21.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tidak sedih dan terbang ke Utara.
Dialogue: 0,0:16:22.32,0:16:24.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya aku tiba di Gunung Hitam Legam
Dialogue: 0,0:16:25.43,0:16:28.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan menghabiskan hampir\N1000 tahun sendirian.
Dialogue: 0,0:16:31.15,0:16:35.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu ketika sekarat dan ajal menghampiri,
Dialogue: 0,0:16:35.60,0:16:39.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}secara ajaib, aku melahirkan diriku sendiri.
Dialogue: 0,0:16:39.98,0:16:44.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Naga hitam yang konon cuma sebuah legenda.
Dialogue: 0,0:16:44.59,0:16:46.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah diriku.
Dialogue: 0,0:16:47.00,0:16:50.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang punya kekuatan dahsyat dan mutlak
Dialogue: 0,0:16:50.32,0:16:52.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak butuh siapa-siapa lagi.
Dialogue: 0,0:16:53.24,0:16:57.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan 1000 tahun berikutnya,\Ntanpa bergaul dengan siapa pun,
Dialogue: 0,0:16:57.92,0:17:02.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku hidup nyaman di kerajaan ciptaan sendiri.
Dialogue: 0,0:17:03.18,0:17:05.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu ajalku kembali tiba.
Dialogue: 0,0:17:07.13,0:17:10.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku terlahir kembali\Njadi naga hitam kecil yang lemah.
Dialogue: 0,0:17:12.30,0:17:15.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}1000 tahun yang sama akan terulang.
Dialogue: 0,0:17:15.66,0:17:17.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitulah pikirku.
Dialogue: 0,0:17:17.39,0:17:18.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:17:21.95,0:17:26.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa melemahku yang datang\Ntiap 1000 tahun sekali telah ditunggu.
Dialogue: 0,0:17:28.79,0:17:32.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku terbang sejauh mungkin.
Dialogue: 0,0:17:32.88,0:17:34.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah apa alasannya,
Dialogue: 0,0:17:34.96,0:17:37.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku menuju Barat Daya.
Dialogue: 0,0:17:38.70,0:17:42.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duh, padahal hampir sampai.
Dialogue: 0,0:17:42.78,0:17:44.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak sanggup lagi.
Dialogue: 0,0:17:48.78,0:17:50.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bikin frustrasi.
Dialogue: 0,0:17:50.86,0:17:55.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa naga hitam sepertiku\Nberakhir seperti ini?
Dialogue: 0,0:17:57.47,0:18:01.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada akhirnya, aku mati sendirian.
Dialogue: 0,0:18:04.17,0:18:07.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak burung berwarna hitam?
Dialogue: 0,0:18:07.74,0:18:11.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenanglah, tenanglah.
Dialogue: 0,0:18:36.27,0:18:40.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis yang tiba-tiba muncul di hadapanku\Nadalah seorang santa.
Dialogue: 0,0:18:41.05,0:18:42.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh menakjubkan.
Dialogue: 0,0:18:42.95,0:18:46.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis ini membatalkan ajal,
Dialogue: 0,0:18:46.36,0:18:49.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}konsep tidak pandang bulu\Nyang mustahil dihindari.
Dialogue: 0,0:18:50.65,0:18:53.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, aku ingin bersama gadis ini.
Dialogue: 0,0:18:53.74,0:18:56.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin merasakan berkah kekuatannya juga.
Dialogue: 0,0:18:57.07,0:18:59.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin mengabdi untuknya.
Dialogue: 0,0:18:59.71,0:19:04.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan begitu, aku akan terbebas\Ndari kematian mutlak.
Dialogue: 0,0:19:07.55,0:19:13.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku raja naga hitam Zavilia, menjalin kontrak\Ndengan masterku, Fia Ruud.
Dialogue: 0,0:19:13.98,0:19:17.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan darah, daging, dan jiwa ini,
Dialogue: 0,0:19:17.02,0:19:19.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku bersumpah setia.
Dialogue: 0,0:19:20.51,0:19:25.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, bisakah kamu merahasiakan\Nbahwa aku seorang santa?
Dialogue: 0,0:19:26.76,0:19:28.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja bisa.
Dialogue: 0,0:19:29.15,0:19:34.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah itu, aku mengawasi Fia baik dari jauh\Nmaupun bergerak bersamanya.
Dialogue: 0,0:19:35.42,0:19:41.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama 2000 tahun terakhir, setahuku cuma ada\Nsatu orang yang dipanggil santa agung.
Dialogue: 0,0:19:41.74,0:19:42.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi,
Dialogue: 0,0:19:42.92,0:19:50.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak seorang pun paham arti dan nilainya,\Nbahkan dirinya sendiri.
Dialogue: 0,0:19:50.78,0:19:53.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa tidur nyenyak di dekat Fia.
Dialogue: 0,0:19:54.05,0:19:57.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kadang, aku melihat mimpi masa lalu.
Dialogue: 0,0:19:57.52,0:20:00.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Momen-momen kesendirian selama 2000 tahun.
Dialogue: 0,0:20:03.42,0:20:05.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiba-tiba aku sadar.
Dialogue: 0,0:20:06.06,0:20:09.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, selama ini aku salah melindungi.
Dialogue: 0,0:20:11.01,0:20:14.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Naga-naga biru kawananku tidak penting.
Dialogue: 0,0:20:15.28,0:20:18.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya kutinggalkan mereka.
Dialogue: 0,0:20:20.57,0:20:24.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi perasaanku terhadap Fia berbeda.
Dialogue: 0,0:20:24.21,0:20:27.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa meninggalkannya\Napa pun yang terjadi.
Dialogue: 0,0:20:27.18,0:20:31.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa lalu yang kujalani sendirian tanpa arti
Dialogue: 0,0:20:31.89,0:20:36.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi pengingat betapa pentingnya\Nmomen bersama Fia.
Dialogue: 0,0:20:37.15,0:20:39.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Fia.
Dialogue: 0,0:20:39.38,0:20:44.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}2000 tahun sebelum bertemu denganmu\Ntidak ada artinya.
Dialogue: 0,0:20:45.23,0:20:49.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat dua ekor naga biru\Nmenukik tajam ke arah Fia,
Dialogue: 0,0:20:50.67,0:20:54.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sekujur tubuhku seolah mendidih\Noleh amarah yang melanda.
Dialogue: 0,0:20:56.93,0:20:58.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zavilia?
Dialogue: 0,0:21:00.67,0:21:05.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya Fia terluka dan tidak menyadarinya.
Dialogue: 0,0:21:05.00,0:21:11.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kacaunya persebaran para monster\Ndisebabkan aroma manis darah Fia.
Dialogue: 0,0:21:14.13,0:21:16.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah melindungiku.
Dialogue: 0,0:21:16.28,0:21:19.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sisanya biar kami para kesatria yang urus.
Dialogue: 0,0:21:21.39,0:21:25.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tulus menerima kenaifanku yang enggan
Dialogue: 0,0:21:25.05,0:21:27.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}melawan naga biru.
Dialogue: 0,0:21:27.90,0:21:32.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Santa ini sungguh aneh,\Nsembrono, dan manis.
Dialogue: 0,0:21:33.19,0:21:36.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fia tetap seorang santa.
Dialogue: 0,0:21:36.02,0:21:39.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski ingin merahasiakan jati diri\Nsebagai santa,
Dialogue: 0,0:21:39.00,0:21:43.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia tanpa ragu memakai kekuatan\Nsaat nyawa para kesatria terancam.
Dialogue: 0,0:21:43.22,0:21:45.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia begitu mudah berkorban.
Dialogue: 0,0:21:46.42,0:21:52.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayangnya, dia lemah, rapuh,\Ndan nyaris tidak berdaya.
Dialogue: 0,0:21:52.73,0:21:55.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya, aku harus jadi raja.
Dialogue: 0,0:21:56.03,0:21:58.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi jadi penjaganya.
Dialogue: 0,0:22:00.72,0:22:03.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi melindunginya dari segala hal.
