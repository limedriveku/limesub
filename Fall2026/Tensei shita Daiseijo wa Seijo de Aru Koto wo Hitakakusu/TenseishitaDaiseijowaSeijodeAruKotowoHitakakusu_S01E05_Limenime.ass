Dialogue: 0,0:02:06.52,0:02:11.24,sign,,0000,0000,0000,,REINKARNASI SANTA AGUNG YANG MENYEMBUNYIKAN\NJATI DIRINYA SEBAGAI SANTA
Dialogue: 0,0:03:21.97,0:03:26.98,sign,,0000,0000,0000,,EPISODE 5: MONSTER LEVEL BENCANA
Dialogue: 0,0:11:37.22,0:11:39.76,sign,,0000,0000,0000,,KAPTEN ORDO KESATRIA MONSTER KEEMPAT,\NQUENTIN AGUTTER
Dialogue: 0,0:23:34.98,0:23:39.98,sign,,0000,0000,0000,,EPISODE 6: OPERASI PENANGKAPAN SANG RAJA HITAM
Dialogue: 0,0:00:01.23,0:00:03.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Anu, Nona Kesatria...
Dialogue: 0,0:00:06.78,0:00:08.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu...
Dialogue: 0,0:00:11.88,0:00:14.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat siang, Nona Santa.
Dialogue: 0,0:00:14.20,0:00:15.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Anu...
Dialogue: 0,0:00:15.90,0:00:18.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}No-Nona Kesatria hebat, ya.
Dialogue: 0,0:00:18.96,0:00:23.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa meminumkan obat ke para monster\Nmeski bukan pemilik mereka.
Dialogue: 0,0:00:23.62,0:00:25.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namaku Fia.
Dialogue: 0,0:00:25.98,0:00:28.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan panggil nama saja.
Dialogue: 0,0:00:30.29,0:00:32.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namaku Charlotte!
Dialogue: 0,0:00:32.68,0:00:37.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, tolong panggil aku Charlotte!
Dialogue: 0,0:00:37.04,0:00:38.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Charlotte?
Dialogue: 0,0:00:38.36,0:00:40.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan, Charlotte saja!
Dialogue: 0,0:00:40.19,0:00:42.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, tolong bicara santai saja.
Dialogue: 0,0:00:42.89,0:00:46.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anggap saja keluarga sendiri!
Dialogue: 0,0:00:46.39,0:00:47.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keluarga?
Dialogue: 0,0:00:48.45,0:00:51.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sopankah aku begitu ke seorang santa?
Dialogue: 0,0:00:55.13,0:00:56.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Ada apa?
Dialogue: 0,0:00:56.67,0:01:02.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal namaku Charlotte,\Ntidak ada yang mau menyebutnya.
Dialogue: 0,0:01:02.22,0:01:04.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya memanggilku nona santa.
Dialogue: 0,0:01:04.44,0:01:06.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal itu bukan namaku.
Dialogue: 0,0:01:08.42,0:01:14.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dianggap santa dan dibawa ke gereja\Nsejak berumur tiga tahun.
Dialogue: 0,0:01:14.44,0:01:19.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau jadi santa hebat,\Naku dijanjikan boleh bertemu Ibu.
Dialogue: 0,0:01:19.36,0:01:22.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku sangat payah.
Dialogue: 0,0:01:22.44,0:01:26.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan santaku lemah dan tidak mampu\Nmembuat ramuan penyembuh.
Dialogue: 0,0:01:26.93,0:01:28.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh.
Dialogue: 0,0:01:28.60,0:01:29.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:01:33.00,0:01:35.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu akan kupanggil Charlotte.
Dialogue: 0,0:01:37.78,0:01:41.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Burung biru!\NIbu bilang itu membawa hoki!
Dialogue: 0,0:01:41.91,0:01:46.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, banyak hal menyenangkan\Nsemenjak ada dia.
Dialogue: 0,0:01:46.33,0:01:48.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti akan menular juga padamu, Charlotte.
Dialogue: 0,0:03:34.07,0:03:37.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, pasti sakit, ya?
Dialogue: 0,0:03:38.72,0:03:40.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kasihan sekali.
Dialogue: 0,0:03:40.77,0:03:44.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hati selembut itu cocok jadi santa.
Dialogue: 0,0:03:45.30,0:03:47.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Warna rambutnya juga...
Dialogue: 0,0:03:47.20,0:03:50.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Roh terpikat pada darah santa\Nuntuk menjalin kontrak,
Dialogue: 0,0:03:50.52,0:03:54.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}makanya rambut merah cocok jadi wadah santa\Nkarena warnanya persis darah.
Dialogue: 0,0:03:54.88,0:03:58.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rambut oranye pun wadah kelas atas\Nkarena mirip merah.
Dialogue: 0,0:03:59.26,0:04:03.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Charlotte, mau latihan membuat\Nramuan penyembuh bersamaku?
Dialogue: 0,0:04:09.50,0:04:11.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini kecil dan pas sekali.
Dialogue: 0,0:04:11.65,0:04:14.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fia, tapi aku...
Dialogue: 0,0:04:14.60,0:04:18.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja, aku tidak bisa\Nmemakai sihir penyembuh.
Dialogue: 0,0:04:18.26,0:04:21.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan tahu meski kamu gagal.
Dialogue: 0,0:04:21.12,0:04:22.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu,
Dialogue: 0,0:04:22.02,0:04:25.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}gagal itu wajar dalam latihan.
Dialogue: 0,0:04:25.27,0:04:27.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anggap saja ini latihan buat gagal.
Dialogue: 0,0:04:39.19,0:04:42.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, coba alirkan sihir penyembuhmu.
Dialogue: 0,0:04:42.10,0:04:46.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, tapi biasanya para santa\Nmembuat ramuan
Dialogue: 0,0:04:46.55,0:04:48.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pakai air dalam stoples.
Dialogue: 0,0:04:50.04,0:04:51.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba saja dulu.
Dialogue: 0,0:04:54.58,0:04:57.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, coba alirkan.
Dialogue: 0,0:05:02.32,0:05:05.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aliran daya sihirnya memang buruk, sih.
Dialogue: 0,0:05:05.52,0:05:07.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kupakai sedikit daya sihirku.
Dialogue: 0,0:05:13.24,0:05:17.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, coba alirkan daya sihirnya ke telaga.
Dialogue: 0,0:05:17.47,0:05:18.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa?
Dialogue: 0,0:05:23.65,0:05:25.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bayangkan,
Dialogue: 0,0:05:25.11,0:05:31.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di sini ada air yang menyerap kekuatan bumi\Ndan herba yang kaya akan kekuatan alam.
Dialogue: 0,0:05:31.02,0:05:36.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau semua itu dijadikan ramuan penyembuh,\Npara monster yang terluka pasti senang.
Dialogue: 0,0:05:37.61,0:05:42.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, tinggal disesuaikan\Npakai daya sihirku.
Dialogue: 0,0:05:53.76,0:05:55.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Indah sekali!
Dialogue: 0,0:05:56.38,0:06:00.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fi-Fia, tubuhku terasa aneh.
Dialogue: 0,0:06:00.63,0:06:06.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekujur tubuhku terasa hangat\Ndan dialiri kekuatan.
Dialogue: 0,0:06:06.39,0:06:11.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus, Charlotte!\NItulah cara kerja sihir penyembuh.
Dialogue: 0,0:06:12.37,0:06:14.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihatlah hasilnya.
Dialogue: 0,0:06:14.02,0:06:18.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seisi telaga ini jadi ramuan penyembuh!
Dialogue: 0,0:06:18.15,0:06:21.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seisi telaganya jadi ramuan penyembuh?
Dialogue: 0,0:06:21.43,0:06:24.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}E-Eng, Fia...
Dialogue: 0,0:06:24.66,0:06:27.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ramuan penyembuh itu transparan.
Dialogue: 0,0:06:27.11,0:06:31.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa telaga ini bukan ramuan penyembuh\Nkarena warnanya jadi hijau.
Dialogue: 0,0:06:33.09,0:06:37.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ramuan penyembuh transparan itu\Nproduk gagal, justru ini yang asli.
Dialogue: 0,0:06:43.67,0:06:45.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, mereka kenapa?
Dialogue: 0,0:06:45.51,0:06:49.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}E-Entah, baru kali ini aku melihat\Npara monster begini.
Dialogue: 0,0:06:50.31,0:06:51.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya sudah.
Dialogue: 0,0:06:56.81,0:06:58.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lah, kok?
Dialogue: 0,0:06:58.69,0:07:00.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Habis pakai sihir penyembuh, kan?
Dialogue: 0,0:07:00.77,0:07:06.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daya sihirnya mengaliri tubuhmu\Ndan tercium semerbak dari bekas luka tadi.
Dialogue: 0,0:07:07.61,0:07:11.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya bagi monster,\Nbau darah santa sangat menggoda.
Dialogue: 0,0:07:11.89,0:07:15.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Monster biasa pasti ingin memakanmu.
Dialogue: 0,0:07:15.58,0:07:21.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi hewan kontrak yang punya pemilik\Nsebatas ingin akrab denganmu.
Dialogue: 0,0:07:23.65,0:07:28.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, di kehidupan lalu tidak ada monster\Nyang terpikat oleh darahku.
Dialogue: 0,0:07:28.84,0:07:32.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di kehidupan lalu kamu mengontrak roh, kan?
Dialogue: 0,0:07:32.37,0:07:35.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa itu berkat roh milikmu.
Dialogue: 0,0:07:35.46,0:07:37.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, masuk akal.
Dialogue: 0,0:07:37.10,0:07:41.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin air hijau ini memang bukan\Nramuan penyembuh.
Dialogue: 0,0:07:41.57,0:07:44.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya mereka tidak kesakitan.
Dialogue: 0,0:07:45.11,0:07:47.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari tunggu sampai besok.
Dialogue: 0,0:07:55.37,0:08:00.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, terlalu kuat minum juga\Ntidak bagus, ya.
Dialogue: 0,0:08:00.28,0:08:02.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bicaralah lebih lembut.
Dialogue: 0,0:08:02.98,0:08:05.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sedang bersedih.
Dialogue: 0,0:08:06.13,0:08:10.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya aku dibilang berengsek\Noleh bawahan sendiri.
Dialogue: 0,0:08:11.88,0:08:15.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu kan bukan ditujukan khusus padamu.
Dialogue: 0,0:08:15.52,0:08:17.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, sih.
Dialogue: 0,0:08:17.28,0:08:21.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, tetap saja bikin kena mental.
Dialogue: 0,0:08:22.75,0:08:25.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para santa mau kalian apakan?
Dialogue: 0,0:08:26.11,0:08:29.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau dipuja layaknya dewi?
Dialogue: 0,0:08:29.53,0:08:31.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketum...
Dialogue: 0,0:08:31.52,0:08:33.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, lupakan saja.
Dialogue: 0,0:08:35.65,0:08:38.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cyril, ayo minum lagi!
Dialogue: 0,0:08:38.95,0:08:41.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja, Desmond.
Dialogue: 0,0:08:55.35,0:08:56.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah...
Dialogue: 0,0:08:57.94,0:08:59.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lapor.
Dialogue: 0,0:08:59.48,0:09:04.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemberian ramuan penyembuh\Nke para hewan kontrak sudah selesai.
Dialogue: 0,0:09:04.48,0:09:10.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus, Kapten Ordo Kesatria Pertama\Ntidak salah merekomendasikanmu.
Dialogue: 0,0:09:11.01,0:09:14.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enaknya bisa dipuji karena hal sepele.
Dialogue: 0,0:09:14.69,0:09:17.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sementara itu aku kurang tidur\Nkarena hal tidak terduga.
Dialogue: 0,0:09:17.70,0:09:21.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wakil Kapten Gideon, maaf lancang.
Dialogue: 0,0:09:21.09,0:09:22.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku juga kurang tidur.
Dialogue: 0,0:09:23.38,0:09:24.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena...
Dialogue: 0,0:09:25.28,0:09:26.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jreng!
Dialogue: 0,0:09:26.61,0:09:29.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agar hewan kontrakku tidak masuk angin,
Dialogue: 0,0:09:29.60,0:09:32.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku membuat baju hangat!
Dialogue: 0,0:09:32.12,0:09:36.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masukkan tangan ke lubang di ekornya,\Njadilah boneka tangan!
Dialogue: 0,0:09:39.09,0:09:44.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wakil Kapten Ordo Kesatria Monster pasti paham\Nkasih sayang ke hewan kontrak, dong?
Dialogue: 0,0:09:44.87,0:09:50.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga tahu hewan kontrak itu\Nsangat akrab denganmu!
Dialogue: 0,0:09:50.10,0:09:53.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan berusaha menjilat begitu!
Dialogue: 0,0:09:54.45,0:09:55.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masuklah!
Dialogue: 0,0:09:56.71,0:09:57.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten?
Dialogue: 0,0:09:58.40,0:10:01.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf datang pagi buta begini.
Dialogue: 0,0:10:01.38,0:10:05.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku datang untuk menengok bawahanku.
Dialogue: 0,0:10:05.76,0:10:08.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana pekerjaanmu?
Dialogue: 0,0:10:08.13,0:10:09.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya.
Dialogue: 0,0:10:09.72,0:10:12.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hewan kontrak yang terluka\Nsudah minum ramuan,
Dialogue: 0,0:10:12.80,0:10:14.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin besok mereka akan membaik.
Dialogue: 0,0:10:14.89,0:10:17.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudmu?
Dialogue: 0,0:10:17.20,0:10:21.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kupinjamkan ke sini untuk mengukur\Ndaya hidup para monster, lo.
Dialogue: 0,0:10:22.31,0:10:26.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baru ingat tujuan awalnya itu, eng...
Dialogue: 0,0:10:26.38,0:10:30.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fia, kamu boleh cerita nanti.
Dialogue: 0,0:10:30.07,0:10:36.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya bawahanku belum melakukan\Npekerjaan yang kuminta, ya.
Dialogue: 0,0:10:36.21,0:10:38.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tahu alasannya?
Dialogue: 0,0:10:39.16,0:10:44.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beri tahu aku, Gideon,\Napa dia sengaja lalai?
Dialogue: 0,0:10:44.21,0:10:50.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau ada orang dari Ordo Kesatria Monster Keempat\Nyang menghambat tugas aslinya?
Dialogue: 0,0:10:50.55,0:10:56.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya, aku sempat mendengarmu\Nmembentak keras dari balik pintu.
Dialogue: 0,0:10:56.34,0:10:58.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa yang dibentak?
Dialogue: 0,0:10:59.49,0:11:03.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah asistenmu yang berdiri di sini?
Dialogue: 0,0:11:03.72,0:11:09.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau justru anggota ordoku\Nyang diintimidasi?
Dialogue: 0,0:11:14.88,0:11:21.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu menelantarkan kesatria kirimanku,\NKapten Ordo Kesatria Pertama ini?
Dialogue: 0,0:11:21.59,0:11:27.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau dihukum atas kelalaian tugas\Natau kuhancurkan di sini?
Dialogue: 0,0:11:27.58,0:11:29.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu...
Dialogue: 0,0:11:34.39,0:11:36.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kapten Quentin!
Dialogue: 0,0:11:42.47,0:11:43.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang benar saja.
Dialogue: 0,0:11:43.91,0:11:49.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ditinggal sebentar, ruanganku sudah disinggahi\Ndua monster level bencana.
Dialogue: 0,0:11:54.21,0:11:58.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak dulu, aku bisa melihat\Nenergi orang samar-samar.
Dialogue: 0,0:11:58.25,0:12:02.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, belum pernah ada energi sekuat ini!
Dialogue: 0,0:12:02.33,0:12:07.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salah satunya berasal dari monster biru\Nyang ada di bahu gadis kesatria itu.
Dialogue: 0,0:12:08.05,0:12:10.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan ini?
Dialogue: 0,0:12:10.14,0:12:13.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski ukurannya kecil, auranya bukan main!
Dialogue: 0,0:12:13.74,0:12:16.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Konsentrasi energinya di atas normal!
Dialogue: 0,0:12:16.64,0:12:19.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti dia monster kelas SS...\NTidak, dia adalah...
Dialogue: 0,0:12:19.81,0:12:21.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Naga hitam!
Dialogue: 0,0:12:22.46,0:12:28.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Raja Hitam legendaris yang sudah setengah tahun\Nkucari di seluruh benua atas perintah Ketum!
Dialogue: 0,0:12:28.44,0:12:32.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Naga hitam yang sedang di masa kanak-kanak\Nyang cuma datang seribu tahun sekali!
Dialogue: 0,0:12:32.95,0:12:38.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia malah ada di ruang kerjaku\Ndan pakai kostum burung biru?
Dialogue: 0,0:12:38.98,0:12:42.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lelucon macam apa ini?\NSelain itu...
Dialogue: 0,0:12:44.23,0:12:47.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siluet energinya tidak terlihat\Nsaking besarnya.
Dialogue: 0,0:12:47.26,0:12:50.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok yang lain bisa tenang di ruangan ini?
Dialogue: 0,0:12:50.83,0:12:55.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salam kenal, Kapten Quentin!\NAku Fia dari Ordo Kesatria Pertama!
Dialogue: 0,0:12:56.29,0:13:01.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski katamu ada dua monster,\Nyang satunya cuma boneka buatanku, kok!
Dialogue: 0,0:13:01.97,0:13:03.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini jebakan?
Dialogue: 0,0:13:03.29,0:13:07.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan jadi gumpalan daging\Nkalau salah menjawab, ya?
Dialogue: 0,0:13:07.97,0:13:12.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boneka ini juga berfungsi\Nsebagai baju hangat.
Dialogue: 0,0:13:14.27,0:13:18.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wujudnya seolah hidup sungguhan!
Dialogue: 0,0:13:18.21,0:13:23.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ide motif burung biru sangat brilian!\NPuncak sebuah seni!
Dialogue: 0,0:13:23.18,0:13:25.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kontras biru dan hitamnya memukau!
Dialogue: 0,0:13:25.57,0:13:26.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:13:26.14,0:13:29.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten, kenapa bicaramu sopan sekali?
Dialogue: 0,0:13:29.65,0:13:31.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia cuma kesatria jelat—
Dialogue: 0,0:13:32.93,0:13:37.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kenapa, Quentin?\NTumben cari muka begitu?
Dialogue: 0,0:13:37.55,0:13:40.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cyril, kita harus bicara!
Dialogue: 0,0:13:40.81,0:13:43.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengar, aku yang paling tahu\Ncara menangani monster.
Dialogue: 0,0:13:43.69,0:13:46.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan komentari sikapku kalau mau hidup!
Dialogue: 0,0:13:46.08,0:13:49.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kira Merpati Biru itu ancaman?
Dialogue: 0,0:13:49.85,0:13:51.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang, diam!
Dialogue: 0,0:13:51.79,0:13:55.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kata yang salah bisa menyinggungnya!\NJaga ucapanmu!
Dialogue: 0,0:13:57.12,0:13:58.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mohon maaf.
Dialogue: 0,0:13:58.94,0:14:05.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski terlihat bijaksana, Cyril tidak tahu\Nbetapa luhurnya monster itu.
Dialogue: 0,0:14:05.26,0:14:09.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona pasti lelah berdiri, kan?\NSilakan duduk dulu.
Dialogue: 0,0:14:10.14,0:14:14.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Woi, kenapa mejanya terbelah dua?\NPasti ulahmu, Cyril!
Dialogue: 0,0:14:14.60,0:14:19.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak saja, jangan asal menuduh\Nkalau tidak punya bukti.
Dialogue: 0,0:14:19.36,0:14:23.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini keras banget, woi!\NMustahil Gideon dan Patty merusaknya!
Dialogue: 0,0:14:23.07,0:14:24.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain kamu, siapa lagi...
Dialogue: 0,0:14:26.15,0:14:28.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan, Nona?
Dialogue: 0,0:14:29.18,0:14:31.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Aku?
Dialogue: 0,0:14:31.43,0:14:35.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru itu bagus!\NKebetulan meja ini kebesaran!
Dialogue: 0,0:14:35.74,0:14:38.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau setengah begini pasti makin praktis!
Dialogue: 0,0:14:38.58,0:14:43.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Quentin, kamu pasti salah makan.
Dialogue: 0,0:14:44.34,0:14:49.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senang melihat para kapten akur,\Ntapi kapan aku boleh pergi?
Dialogue: 0,0:14:49.51,0:14:51.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, Fia?
Dialogue: 0,0:14:51.20,0:14:58.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eng, karena ada janji dengan Charlotte,\Naku mau izin pergi kalau boleh.
Dialogue: 0,0:14:58.11,0:15:00.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Charlotte itu siapa?
Dialogue: 0,0:15:00.35,0:15:03.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Santa yang tinggal di istana terpisah.
Dialogue: 0,0:15:03.06,0:15:06.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami janjian mau memberikan hewan kontrak\Nramuan penyembuh.
Dialogue: 0,0:15:06.23,0:15:10.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu diizinkan menyebut nama seorang santa?
Dialogue: 0,0:15:10.49,0:15:15.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, tampaknya Charlotte kesepian\Nkarena jauh dari keluarga.
Dialogue: 0,0:15:15.46,0:15:18.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin dia menganggapku seperti ibu sendiri.
Dialogue: 0,0:15:19.36,0:15:22.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, Kapten Cyril, perkenalkan.
Dialogue: 0,0:15:22.50,0:15:25.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini hewan kontrak imutku, Zavilia.
Dialogue: 0,0:15:25.66,0:15:30.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia hewan kontrak berusia nol tahun,\Nbisa dibilang akulah ibunya!
Dialogue: 0,0:15:30.99,0:15:36.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}No-Nona Fia, bisakah Tuan Hewan Kontrak\Ndisebut pakai inisial alfabet?
Dialogue: 0,0:15:36.64,0:15:41.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takutnya orang lain tidak sengaja\Nmenyebut namanya.
Dialogue: 0,0:15:41.70,0:15:45.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya monster benci namanya\Ndisebut orang selain pemiliknya.
Dialogue: 0,0:15:45.39,0:15:49.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten, monster selemah ini\Ncuma akan menyundul
Dialogue: 0,0:15:49.65,0:15:51.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau namanya disebut.
Dialogue: 0,0:15:51.69,0:15:52.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, kan?\NZavi—
Dialogue: 0,0:15:54.53,0:15:56.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kapten...
Dialogue: 0,0:15:56.28,0:16:00.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar orang-orang tidak peka!\NKalian diam saja!
Dialogue: 0,0:16:00.15,0:16:01.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau jadi gumpalan daging?
Dialogue: 0,0:16:01.41,0:16:05.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kalian mau jadi gumpalan daging, ya?\N- Eng, karena kalian terlihat sibuk...
Dialogue: 0,0:16:05.17,0:16:07.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Gumpalan daging, woi!\N- Fia Ruud izin pamit!
Dialogue: 0,0:16:11.15,0:16:14.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski katanya begitu,\Nkamu sendiri ingin dipanggil apa?
Dialogue: 0,0:16:15.87,0:16:19.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena namaku sudah lama tidak disebut,
Dialogue: 0,0:16:19.09,0:16:21.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku senang kalau dipanggil nama.
Dialogue: 0,0:16:21.49,0:16:24.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, tetap dipanggil Zavilia, ya.
Dialogue: 0,0:16:26.55,0:16:29.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luka monster-monsternya sembuh!
Dialogue: 0,0:16:29.19,0:16:33.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal luka para monster diperkirakan\Nbutuh berhari-hari untuk sembuh.
Dialogue: 0,0:16:33.23,0:16:37.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ramuan penyembuh hijau meningkatkan\Ndaya pulih peminumnya.
Dialogue: 0,0:16:38.24,0:16:42.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Air hijau ini benar-benar ramuan penyembuh?
Dialogue: 0,0:16:42.27,0:16:44.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, benar.
Dialogue: 0,0:16:47.63,0:16:50.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cha-Charlotte, ada apa?
Dialogue: 0,0:16:50.74,0:16:55.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luar biasa, semuanya tidak tersiksa\Ndan langsung sembuh.
Dialogue: 0,0:16:56.43,0:17:00.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ramuan penyembuh seperti inilah\Nyang selalu kuinginkan!
Dialogue: 0,0:17:02.21,0:17:05.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah aku kembali ke Ordo Kesatria Pertama,
Dialogue: 0,0:17:05.47,0:17:11.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}beri tahu soal ramuan penyembuh hijau ini\Nke Ordo Kesatria Monster, ya.
Dialogue: 0,0:17:11.06,0:17:12.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:17:12.05,0:17:16.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi kaptenku menengok kemari.
Dialogue: 0,0:17:16.56,0:17:19.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin sebentar lagi aku akan pulang.
Dialogue: 0,0:17:19.56,0:17:22.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fia, kamu mau pergi?
Dialogue: 0,0:17:22.06,0:17:24.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma kembali ke ordo asalku, kok.
Dialogue: 0,0:17:24.80,0:17:27.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bisa bertemu kapan pun kalau mau.
Dialogue: 0,0:17:28.75,0:17:30.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku punya permintaan.
Dialogue: 0,0:17:31.98,0:17:35.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena air di telaga itu terus muncul,
Dialogue: 0,0:17:35.59,0:17:38.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ramuannya akan menipis kalau didiamkan.
Dialogue: 0,0:17:38.78,0:17:43.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, maukah kamu mengalirkan sihir\Npenyembuh ke sana sehari sekali?
Dialogue: 0,0:17:43.85,0:17:44.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mau?
Dialogue: 0,0:17:44.85,0:17:47.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, bukan begitu.
Dialogue: 0,0:17:47.67,0:17:50.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah kamu seorang santa?
Dialogue: 0,0:17:50.73,0:17:51.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:17:51.73,0:17:54.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat berlatih membuat ramuan penyembuh,
Dialogue: 0,0:17:54.57,0:17:58.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}baru kali ini aku merasakan aliran\Ndaya sihir dalam tubuhku.
Dialogue: 0,0:17:58.36,0:18:03.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baru sadar sekarang,\Nmengubah telaga jadi ramuan penyembuh
Dialogue: 0,0:18:03.95,0:18:08.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bahkan mustahil\Nbagi 10 orang santa kelas atas.
Dialogue: 0,0:18:08.05,0:18:09.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu...
Dialogue: 0,0:18:09.37,0:18:13.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lukisan Santa Agung yang ada di gereja.
Dialogue: 0,0:18:13.07,0:18:16.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rambut merah terang dan mata kuningnya
Dialogue: 0,0:18:16.67,0:18:18.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}persis kamu.
Dialogue: 0,0:18:20.25,0:18:22.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti kamu seorang santa.
Dialogue: 0,0:18:22.64,0:18:26.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Santa terkuat yang pernah aku temui.
Dialogue: 0,0:18:27.96,0:18:31.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, Charlotte, soal itu...
Dialogue: 0,0:18:31.27,0:18:35.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja, aku ada di pihakmu.
Dialogue: 0,0:18:35.07,0:18:37.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan mengusik pilihanmu.
Dialogue: 0,0:18:38.17,0:18:44.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti kamu merahasiakan jati diri sebagai santa\Nkarena alasan tersendiri.
Dialogue: 0,0:18:44.04,0:18:46.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku akan tutup mulut.
Dialogue: 0,0:18:46.67,0:18:51.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ramuan penyembuh hijau itu pun\Nkhusus untuk monster di sini saja.
Dialogue: 0,0:18:51.07,0:18:52.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Charlotte...
Dialogue: 0,0:18:52.65,0:18:55.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biarkan aku berterima kasih, Fia.
Dialogue: 0,0:18:55.30,0:18:58.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah menjadikanku santa.
Dialogue: 0,0:18:58.30,0:19:00.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama-sama, Charlotte.
Dialogue: 0,0:19:00.85,0:19:03.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah menghargai perasaanku.
Dialogue: 0,0:19:03.89,0:19:05.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu,
Dialogue: 0,0:19:05.63,0:19:08.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}selamat telah menjadi santa hebat.
Dialogue: 0,0:19:11.69,0:19:14.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pilihan bijak, Santa Cilik.
Dialogue: 0,0:19:14.24,0:19:19.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu mengusik pilihan Fia,\Ntadinya aku mau turun tangan.
Dialogue: 0,0:19:28.77,0:19:30.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, Nona Fia!
Dialogue: 0,0:19:30.91,0:19:34.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten Quentin, mau ke mana?
Dialogue: 0,0:19:34.07,0:19:39.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku lapar karena belum sempat\Nmakan dengan benar.
Dialogue: 0,0:19:39.73,0:19:40.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini mau ke kantin.
Dialogue: 0,0:19:40.97,0:19:45.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, kebetulan aku juga mau makan siang!
Dialogue: 0,0:19:45.65,0:19:47.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa kita pergi bersama?
Dialogue: 0,0:19:47.33,0:19:49.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be-Bersama?
Dialogue: 0,0:19:52.31,0:19:54.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelihatan enak!
Dialogue: 0,0:19:54.81,0:19:59.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok cuma air?\NBukannya kamu bilang lapar?
Dialogue: 0,0:20:00.02,0:20:04.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akibat rasa gugup, aku tidak nafsu makan.
Dialogue: 0,0:20:04.82,0:20:10.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul, gugup bikin hilang nafsu makan.
Dialogue: 0,0:20:12.25,0:20:14.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau lihat pergelangan tanganku?
Dialogue: 0,0:20:14.74,0:20:16.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada tanda hewan kontraknya.
Dialogue: 0,0:20:16.71,0:20:21.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luar biasa, aku baru pertama melihat\Ntanda hewan kontrak serapi ini!
Dialogue: 0,0:20:23.05,0:20:24.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini tandaku.
Dialogue: 0,0:20:24.51,0:20:29.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari hewan kontrak kelas A yang harus\Ndikepung dulu oleh 80 kesatria.
Dialogue: 0,0:20:29.76,0:20:33.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tandamu satu garis sempurna tanpa putus!
Dialogue: 0,0:20:33.78,0:20:36.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma segaris!\NSatu milimeter pula!
Dialogue: 0,0:20:36.40,0:20:38.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penjinakan total...
Dialogue: 0,0:20:42.53,0:20:47.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong ajari cara selaras dengan hewan kontrak\Nbiar tandanya sesempurna ini!
Dialogue: 0,0:20:47.18,0:20:51.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia jadi hewan kontrakku karena kebetulan.
Dialogue: 0,0:20:51.95,0:20:57.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah kusembuhkan dari sekaratnya,\Ndia minta jadi hewan kontrakku.
Dialogue: 0,0:20:57.32,0:21:00.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?\NWalau masih bayi naga hita—
Dialogue: 0,0:21:00.11,0:21:03.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa Tuan Hewan Kontrak bisa sekarat?
Dialogue: 0,0:21:03.42,0:21:06.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan bisa pulih lewat faktor eksternal?
Dialogue: 0,0:21:06.08,0:21:08.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat, sulit dicerna akal sehatku!
Dialogue: 0,0:21:08.91,0:21:11.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana tingkat keselarasannya?
Dialogue: 0,0:21:11.10,0:21:12.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tingkat keselarasannya?
Dialogue: 0,0:21:12.99,0:21:15.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia akan datang kalau kupanggil\Nsejauh apa pun itu.
Dialogue: 0,0:21:15.74,0:21:18.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua ucapanku dipatuhi.
Dialogue: 0,0:21:18.05,0:21:21.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia juga tahu harus apa\Nmeski tidak kuucapkan.
Dialogue: 0,0:21:21.57,0:21:25.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waduh, ternyata dia muncul di hutan\Nkarena kamu panggil, toh!
Dialogue: 0,0:21:27.01,0:21:32.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Fia, boleh aku bertanya langsung\Npada Tuan Hewan Kontrak?
Dialogue: 0,0:21:32.49,0:21:36.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, coba kutanya dulu.
Dialogue: 0,0:21:36.35,0:21:37.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zavilia.
Dialogue: 0,0:21:46.24,0:21:51.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar suaramu mirip bahasa manusia, kan?
Dialogue: 0,0:21:51.46,0:21:53.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan bicara seperti itu.
Dialogue: 0,0:21:53.76,0:21:56.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lah, kok aneh?
Dialogue: 0,0:21:56.35,0:22:03.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan Kapten Quentin tahu\Nkalau Zavilia itu naga hitam?
