Dialogue: 0,0:00:17.47,0:00:18.50,sign,,0000,0000,0000,,ITEM.
Dialogue: 0,0:00:46.32,0:00:49.57,sign,,0000,0000,0000,,SELANJUTNYA: PENTHOUSE
Dialogue: 0,0:01:09.84,0:01:11.47,sign,,0000,0000,0000,,SELAMAT DATANG\NTERBUKA
Dialogue: 0,0:03:13.88,0:03:16.97,sign,,0000,0000,0000,,A CERTAIN ITEM OF DARK SIDE
Dialogue: 0,0:06:09.18,0:06:10.10,sign,,0000,0000,0000,,15 BELLS - SEDANG DIBERSIHKAN
Dialogue: 0,0:11:52.78,0:11:55.95,sign,,0000,0000,0000,,EPISODE 3: ANGGOTA KELIMA, HANANO CHOUBI
Dialogue: 0,0:14:43.16,0:14:45.61,sign,,0000,0000,0000,,LEVEL 5, MUSUH ALAMI SISI GELAP
Dialogue: 0,0:14:45.61,0:14:47.41,sign,,0000,0000,0000,,PERINGKAT 6 KOTA AKADEMI
Dialogue: 0,0:23:34.98,0:23:35.48,sign,,0000,0000,0000,,A CERTAIN ITEM OF DARK SIDE
Dialogue: 0,0:23:35.60,0:23:39.98,sign,,0000,0000,0000,,EPISODE 4: KOZAKU MITORI, LIQUID SHADOW
Dialogue: 0,0:00:02.94,0:00:07.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gedung komersial Fifteen Bells\Ndi distrik sekolah 15.
Dialogue: 0,0:00:07.28,0:00:12.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurut suara di telepon,\Nmereka ada di lantai paling atas, kan?
Dialogue: 0,0:00:12.12,0:00:16.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang-orang yang bakal\Nmenyambutku sebagai anggota baru...
Dialogue: 0,0:00:19.59,0:00:22.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama, pergi ke lantai teratas gedung.
Dialogue: 0,0:00:22.88,0:00:25.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kedua, bergabung dengan rekan-rekan.
Dialogue: 0,0:00:25.76,0:00:26.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketiga,
Dialogue: 0,0:00:27.88,0:00:29.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bergerak bersama empat orang lainnya.
Dialogue: 0,0:00:30.51,0:00:31.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu...
Dialogue: 0,0:00:34.76,0:00:36.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Autentifikasi telapak tangan?
Dialogue: 0,0:00:43.36,0:00:44.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pintu akan ditutup.
Dialogue: 0,0:00:44.94,0:00:46.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon berhati-hati.
Dialogue: 0,0:00:58.83,0:01:00.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keempat,
Dialogue: 0,0:01:00.79,0:01:03.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}wajib berkumpul tepat waktu.
Dialogue: 0,0:01:03.21,0:01:04.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya begitu.
Dialogue: 0,0:01:11.97,0:01:14.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pe-Permisi...
Dialogue: 0,0:01:14.72,0:01:17.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang, uangnya tidak bisa ditarik!
Dialogue: 0,0:01:17.89,0:01:19.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu dengar enggak, sih?
Dialogue: 0,0:01:20.39,0:01:26.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi, saya Hanano Choubi yang disuruh\Noleh suara di telepon untuk bergabung
Dialogue: 0,0:01:26.07,0:01:27.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- dengan ITEM...\N- Hei, bedebah berengsek!
Dialogue: 0,0:01:27.61,0:01:29.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal kami bekerja dengan baik,
Dialogue: 0,0:01:29.86,0:01:33.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kenapa upahnya belum masuk juga?
Dialogue: 0,0:01:33.58,0:01:36.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Selalu begini dasar kumpulan sampah!\N- Mugino, ada orang, tuh.
Dialogue: 0,0:01:40.08,0:01:40.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:01:41.71,0:01:44.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sa-Saya Hanano...
Dialogue: 0,0:01:44.08,0:01:46.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanano Choubi.
Dialogue: 0,0:03:20.47,0:03:21.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa itu?
Dialogue: 0,0:03:21.97,0:03:23.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia kenalan Kinuhata?
Dialogue: 0,0:03:23.77,0:03:25.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah.
Dialogue: 0,0:03:25.58,0:03:26.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:03:26.48,0:03:27.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lah...
Dialogue: 0,0:03:27.77,0:03:32.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang, upahnya sudah\Ndidepositokan ke rekening kalian.
Dialogue: 0,0:03:32.23,0:03:34.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asal tahu saja, tidak akan kukirim ulang.
Dialogue: 0,0:03:34.66,0:03:36.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Suara telepon yang biasanya...\N- Uang kalian tidak bisa ditarik
Dialogue: 0,0:03:36.62,0:03:40.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}gara-gara rekening kalian dibekukan\Ntanpa alasan yang jelas.
Dialogue: 0,0:03:40.16,0:03:44.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan lampiaskan ke aku,\Ntapi ke operator bank dungu itu.
Dialogue: 0,0:03:45.33,0:03:46.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyebabnya apa?
Dialogue: 0,0:03:46.66,0:03:50.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bukan dewi tutorial yang bisa\Nmenjawab semua hal, tahu.
Dialogue: 0,0:03:50.63,0:03:53.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dibekukan tanpa peringatan?
Dialogue: 0,0:03:53.80,0:03:58.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan kalian berulah sampai kena\Npemblokiran akun bank kriminal?
Dialogue: 0,0:03:58.05,0:04:00.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin kami sebodoh itu!
Dialogue: 0,0:04:00.22,0:04:02.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, yang mengerjai kalian.
Dialogue: 0,0:04:02.35,0:04:06.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah itu peretas atau pembeber rahasia\Nyang berkaitan dengan sisi gelap.
Dialogue: 0,0:04:08.52,0:04:09.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu...
Dialogue: 0,0:04:10.32,0:04:13.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada wajah yang asing di apartemen kami...
Dialogue: 0,0:04:16.52,0:04:18.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanano Choubi.
Dialogue: 0,0:04:18.18,0:04:22.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dulu kamu pernah bilang ITEM cuma ada\Ntiga orang, jadi minta organisasi mencari
Dialogue: 0,0:04:22.45,0:04:24.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pengguna penghalang, kan?
Dialogue: 0,0:04:24.20,0:04:25.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:04:25.08,0:04:26.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersyukurlah.
Dialogue: 0,0:04:26.87,0:04:30.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Anak itu level 0, tapi dia aset berharga.\N- Tiga orang?
Dialogue: 0,0:04:30.54,0:04:32.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Dia spesialis penyamaran dan penyusupan,\N- Tiga orang?
Dialogue: 0,0:04:32.92,0:04:35.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi kalian bisa melakukan\Nhal yang tadinya mustahil!
Dialogue: 0,0:04:36.71,0:04:38.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktunya...
Dialogue: 0,0:04:38.22,0:04:39.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak tepat.
Dialogue: 0,0:04:39.97,0:04:42.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau dipakai atau tidak\Nterserah kalian,
Dialogue: 0,0:04:42.64,0:04:45.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}masa garansi pembatalannya\N30 hari, ya.
Dialogue: 0,0:04:45.18,0:04:49.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus kalau mati atau jadi cacat,\Nkami tidak terima retur.
Dialogue: 0,0:04:49.98,0:04:53.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ITEM tidak mau pakai,\Nbakal kuoper ke tim lain.
Dialogue: 0,0:04:53.02,0:04:55.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski cuma masa percobaan,\Nperlakukan dengan baik, ya.
Dialogue: 0,0:04:55.48,0:04:58.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kamu pikir kami lagi dalam\Nkondisi bisa menambah orang?
Dialogue: 0,0:04:58.99,0:05:03.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau rekening kami dibekukan,\Nmana bisa bayar apartemen!
Dialogue: 0,0:05:03.12,0:05:06.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski sekarang era nontunai,\Nkalian masih punya uang tunai, kan?
Dialogue: 0,0:05:06.81,0:05:10.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asal punya satu yen,\Nkalian bisa buka rekening baru.
Dialogue: 0,0:05:10.04,0:05:14.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat buat saja akun yang tidak bisa dilacak\Ndengan nama apa pun!
Dialogue: 0,0:05:14.42,0:05:18.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami disuruh menyamar jadi orang lain\Ndan pergi ke bank bawa uang satu yen?
Dialogue: 0,0:05:18.71,0:05:19.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong,
Dialogue: 0,0:05:19.92,0:05:22.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}itu hal mudah bagi Hanano Choubi.
Dialogue: 0,0:05:23.76,0:05:26.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu tinggal kembali ke dasarnya.
Dialogue: 0,0:05:26.55,0:05:29.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ingin punya uang,\Nbekerjalah sendiri.
Dialogue: 0,0:05:29.31,0:05:30.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada pekerjaan?
Dialogue: 0,0:05:30.73,0:05:32.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada, besar pula.
Dialogue: 0,0:05:33.23,0:05:38.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyebab rekening kalian dibekukan\Njuga karena ini, deh.
Dialogue: 0,0:05:38.03,0:05:39.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyebab?
Dialogue: 0,0:05:39.65,0:05:43.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Artinya, musuh tahu\Nkalau aku akan minta tim ITEM
Dialogue: 0,0:05:43.03,0:05:45.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk menerima pekerjaan.
Dialogue: 0,0:05:45.24,0:05:50.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Musuh yang ketakutan menyerang duluan\Nagar tidak perlu bertempur.
Dialogue: 0,0:05:50.25,0:05:54.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagian siapa pun ogah kerja\Nkalau tidak dibayar.
Dialogue: 0,0:05:55.50,0:05:58.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa balas dendam sekaligus dapat uang, lo.
Dialogue: 0,0:05:58.25,0:06:00.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau dengar detail pekerjaannya?
Dialogue: 0,0:06:05.34,0:06:07.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo pergi!
Dialogue: 0,0:06:10.10,0:06:12.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, Kinuhata,
Dialogue: 0,0:06:12.44,0:06:15.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu bisa beli baju baru\Nmeski kartu kredit diblokir, ya.
Dialogue: 0,0:06:15.35,0:06:19.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujungnya, semua uang sisa\Ndikantongku dipakai semua.
Dialogue: 0,0:06:19.19,0:06:22.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untungnya ketemu beberapa biji\Nkartu debit prabayar.
Dialogue: 0,0:06:22.99,0:06:25.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tamatlah kita kalau tidak ada itu.
Dialogue: 0,0:06:31.62,0:06:33.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian tahu koloseum?
Dialogue: 0,0:06:34.15,0:06:37.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujungnya, itu acara pertarungan\Ndunia bawah tanpa aturan
Dialogue: 0,0:06:37.71,0:06:40.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang bebas pakai senjata\Ndan kemampuan, kan?
Dialogue: 0,0:06:40.50,0:06:43.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lokasinya beda-beda tempat,\Njadi sulit dilacak.
Dialogue: 0,0:06:43.59,0:06:46.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penonton dapat menikmati\Npertarungan saling bunuh
Dialogue: 0,0:06:46.84,0:06:50.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}melalui siaran langsung di situs gelap.
Dialogue: 0,0:06:50.01,0:06:52.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin karena sudah dipasang\Nprogram penghalang,
Dialogue: 0,0:06:52.89,0:06:55.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi tidak bisa merekam atau menangkap layar.
Dialogue: 0,0:06:55.23,0:06:57.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Difoto lewat ponsel pun gagal.
Dialogue: 0,0:06:57.36,0:06:59.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Latar belakang pesertanya beragam,
Dialogue: 0,0:06:59.57,0:07:02.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi semua dijanjikan uang banyak.
Dialogue: 0,0:07:03.28,0:07:04.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wawasan Frenda luas banget.
Dialogue: 0,0:07:04.90,0:07:07.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keren, Profesor Mahatahu.
Dialogue: 0,0:07:07.92,0:07:09.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujungnya, puji aku terus!
Dialogue: 0,0:07:09.91,0:07:12.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bukan waktunya buat\Nmembanggakan itu.
Dialogue: 0,0:07:12.79,0:07:14.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Secara garis besar,
Dialogue: 0,0:07:14.87,0:07:19.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berbeda dengan sistem level Kota Akademi\Nyang ditentukan oleh para peneliti,
Dialogue: 0,0:07:19.59,0:07:25.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}katanya ini pertarungan murni dan brutal\Nuntuk menentukan esper terkuat.
Dialogue: 0,0:07:25.65,0:07:29.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau orang-orang bodoh itu\Nmau saling bunuh silakan,
Dialogue: 0,0:07:29.05,0:07:33.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}masalahnya adalah uang banyak\Nyang disebutkan tadi.
Dialogue: 0,0:07:33.09,0:07:35.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hadiah juaranya 15 miliar yen.
Dialogue: 0,0:07:36.48,0:07:39.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurut kalian, itu dari mana asalnya?
Dialogue: 0,0:07:39.48,0:07:43.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin dari pendapatan\Niklan siaran langsung, kan?
Dialogue: 0,0:07:44.12,0:07:46.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Asuransi ji—\N- Asuransi jiwa.
Dialogue: 0,0:07:46.25,0:07:50.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Singkatnya, mereka membeli kebijakan asuransi\Njiwa senilai ratusan juta yen untuk tiap peserta,
Dialogue: 0,0:07:50.95,0:07:53.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu membunuh mereka\Npakai kedok pertandingan,
Dialogue: 0,0:07:53.16,0:07:58.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan mengatur agar seluruh uang diberikan\Nke pemenang tunggal yang tersisa.
Dialogue: 0,0:07:58.12,0:08:00.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo? Kesampingkan soal pesertanya,
Dialogue: 0,0:08:00.88,0:08:03.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pihak penyelenggaranya bagaimana?
Dialogue: 0,0:08:03.71,0:08:05.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asuransi perlu modal besar,
Dialogue: 0,0:08:05.55,0:08:08.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan dengan menanggung seluruh risiko,
Dialogue: 0,0:08:08.30,0:08:11.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bukankah mereka yang paling\Nmenginginkan uang?
Dialogue: 0,0:08:11.30,0:08:12.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa gadis itu?
Dialogue: 0,0:08:12.51,0:08:13.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, terserahlah.
Dialogue: 0,0:08:14.35,0:08:17.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka dapat untung tersendiri\Nsebagai penyelenggara.
Dialogue: 0,0:08:17.52,0:08:20.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain pendapatan iklan\Ndari siaran langsung,
Dialogue: 0,0:08:20.44,0:08:24.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mereka dapat cuan dari taruhan daring\Nsiapa petarung yang bakal mati.
Dialogue: 0,0:08:24.11,0:08:26.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus, ada fitur donasi
Dialogue: 0,0:08:26.19,0:08:30.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}agar penonton bisa kasih senjata\Nke petarung favorit saat bertanding.
Dialogue: 0,0:08:31.41,0:08:32.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujungnya,
Dialogue: 0,0:08:32.32,0:08:37.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}banyak petarung cowok bergaya host\Natau cewek seksi demi bertahan hidup.
Dialogue: 0,0:08:37.62,0:08:42.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, tipe seperti itu bakal mati\Nsaat penggemar mulai bosan.
Dialogue: 0,0:08:42.46,0:08:43.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar sekali.
Dialogue: 0,0:08:43.75,0:08:48.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Modal yang didapat itu diputar buat modal pinjol,\Nperdagangan ordal, dan lainnya.
Dialogue: 0,0:08:48.59,0:08:51.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka menjalankan banyak\Nbisnis kotor tanpa izin.
Dialogue: 0,0:08:51.39,0:08:56.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ketahuan pun, mereka sudah\Nmenyiapkan zona aman agar tidak tertangkap.
Dialogue: 0,0:08:57.10,0:09:00.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aset kripto itu memang serbaguna.
Dialogue: 0,0:09:00.50,0:09:03.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah bergerak seleluasa itu\Ntapi tidak bisa diusut.
Dialogue: 0,0:09:03.73,0:09:05.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitulah.
Dialogue: 0,0:09:05.07,0:09:08.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyelenggara tidak akan puas\Nhanya dengan 15 miliar yen.
Dialogue: 0,0:09:08.40,0:09:11.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asuransi kematian itu sekadar umpan.
Dialogue: 0,0:09:11.61,0:09:13.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus, kamu mau ITEM melakukan apa?
Dialogue: 0,0:09:14.58,0:09:18.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan hal konyol seperti menghentikan\Nacara saling bunuh ini, kan?
Dialogue: 0,0:09:18.87,0:09:20.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin.
Dialogue: 0,0:09:20.62,0:09:24.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini pekerjaan dari perusahaan asuransi\Nyang merasa dirugikan.
Dialogue: 0,0:09:24.59,0:09:27.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asuransi itu dasarnya kayak pacuan kuda.
Dialogue: 0,0:09:27.59,0:09:30.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisnis ini akan macet kalau uang\Nyang mereka beri ke nasabah
Dialogue: 0,0:09:30.63,0:09:33.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lebih besar dari uang\Nyang mereka dapatkan.
Dialogue: 0,0:09:33.07,0:09:36.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mereka harus mencarikan asuransi\Nbernilai fantantis secara beruntun,
Dialogue: 0,0:09:36.81,0:09:38.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}perusahaan bisa terancam bangkrut!
Dialogue: 0,0:09:38.47,0:09:42.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya, mereka minta dibantu\Ntutup kerannya sebelum bangkrut?
Dialogue: 0,0:09:42.65,0:09:44.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kata direktur eksekutif\Nyang jadi klien kita,
Dialogue: 0,0:09:44.61,0:09:47.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pakai metode apa pun tidak perlu lapor.
Dialogue: 0,0:09:47.60,0:09:52.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bebas melakukan apa saja selama tidak\Nmerepotkan perusahaan mereka.
Dialogue: 0,0:09:52.44,0:09:55.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyelenggara tidak akan puas\Nhanya dengan 15 miliar yen.
Dialogue: 0,0:09:55.70,0:09:58.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau bentuknya tumpukan uang\Natau emas batangan,
Dialogue: 0,0:09:58.04,0:10:00.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}intinya di brankas mereka\Nada harta karun
Dialogue: 0,0:10:00.91,0:10:03.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang nilainya jauh melebihi itu.
Dialogue: 0,0:10:03.92,0:10:05.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, menarik.
Dialogue: 0,0:10:06.75,0:10:10.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ingatlah, penyelenggara koloseum\Njelas menyimpan
Dialogue: 0,0:10:10.09,0:10:13.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}persenjataan berat yang tidak diumumkan.
Dialogue: 0,0:10:13.18,0:10:15.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekalipun ada segerombolan esper datang
Dialogue: 0,0:10:15.34,0:10:18.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan cari gara-gara,\Nmereka bisa menanganinya.
Dialogue: 0,0:10:19.18,0:10:22.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Artinya, kemungkinan mereka\Nadalah esper level tinggi dari sisi gelap.
Dialogue: 0,0:10:22.48,0:10:24.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan lupa kalian bisa\Nhilang nyawa kalau ceroboh.
Dialogue: 0,0:10:25.90,0:10:28.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makin menarik saja.
Dialogue: 0,0:10:30.23,0:10:32.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujungnya,\NMugino mau bagaimana?
Dialogue: 0,0:10:32.57,0:10:33.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong,
Dialogue: 0,0:10:33.28,0:10:35.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}situ dan situ.
Dialogue: 0,0:10:35.74,0:10:38.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anggota kelima mendadak muncul,
Dialogue: 0,0:10:38.20,0:10:41.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mari tentukan dulu apa peran mereka.
Dialogue: 0,0:10:43.25,0:10:45.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aktivitas sisi gelap
Dialogue: 0,0:10:45.42,0:10:50.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}butuh sistem pendukung\Nyang kokoh buat tiap anggotanya.
Dialogue: 0,0:10:50.30,0:10:54.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makin banyak anggota,\Nbiaya operasional akan melonjak.
Dialogue: 0,0:10:54.30,0:10:55.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari segi ekonomi,
Dialogue: 0,0:10:55.72,0:11:00.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}personel tempur sebuah organisasi\Nmentok 3 atau 4 orang.
Dialogue: 0,0:11:00.60,0:11:05.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, antara dua anak baru ini,\Nsatu jadi anggota inti, satu jadi jongos.
Dialogue: 0,0:11:05.60,0:11:07.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya jangan diadu!
Dialogue: 0,0:11:07.61,0:11:09.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anjing chihuahua ini jadi jongos.
Dialogue: 0,0:11:09.52,0:11:12.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu! Tunggu sebentar!
Dialogue: 0,0:11:12.19,0:11:14.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mugino ternyata baik hati.
Dialogue: 0,0:11:14.53,0:11:15.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:11:15.53,0:11:19.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau level 0 yang tidak bisa bertarung\Ndibiarkan bertarung di garis depan,
Dialogue: 0,0:11:19.91,0:11:22.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}risiko kematiannya bakal naik drastis.
Dialogue: 0,0:11:22.41,0:11:27.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus, beda dari Frenda,\Nkayaknya tidak bisa pakai senjata.
Dialogue: 0,0:11:28.21,0:11:30.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bakal langsung ada pekerjaan, kan?
Dialogue: 0,0:11:30.79,0:11:34.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujungnya lihat saja nanti siapa\Nyang lebih berguna.
Dialogue: 0,0:11:36.09,0:11:40.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ini tidak tertarik dengan ITEM.
Dialogue: 0,0:11:40.30,0:11:44.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asal sandang, pangan, dan papan terjamin,\Naku juga rela jadi jongos.
Dialogue: 0,0:11:44.52,0:11:45.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kinuhata.
Dialogue: 0,0:11:47.48,0:11:49.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan kabur dari pertandingan.
Dialogue: 0,0:11:49.50,0:11:51.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon!
Dialogue: 0,0:11:51.19,0:11:52.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong! Kumohon!
Dialogue: 0,0:11:52.78,0:11:55.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon dengan sangat!
Dialogue: 0,0:11:56.34,0:12:00.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita kan mau menyelidiki koloseum,\Ntapi mau mulai dari mana?
Dialogue: 0,0:12:00.53,0:12:05.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Identitas penyelenggaranya kan misterius\Ndan jejaknya juga tidak bisa dilacak...
Dialogue: 0,0:12:06.37,0:12:07.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm.
Dialogue: 0,0:12:07.33,0:12:08.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:12:08.08,0:12:11.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Klien kita direktur perusahaan\Nasuransi jiwa, kan?
Dialogue: 0,0:12:11.13,0:12:13.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita culik saja dia.
Dialogue: 0,0:12:13.92,0:12:17.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujungnya, begini lagi, ya?
Dialogue: 0,0:12:17.22,0:12:19.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal dia tahu banyak detail,
Dialogue: 0,0:12:19.47,0:12:22.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kesannya pelit dan tidak mau\Nberbagi informasi, ya.
Dialogue: 0,0:12:22.35,0:12:23.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitulah.
Dialogue: 0,0:12:23.85,0:12:28.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tidak ada waktu buat meladeni\Npesan berantai lewat perantara.
Dialogue: 0,0:12:28.06,0:12:31.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membereskan hal yang jelas ada\Ndi depan mata adalah prinsip dasar sisi gelap.
Dialogue: 0,0:12:31.69,0:12:33.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maaf, ja-jadi...
Dialogue: 0,0:12:33.65,0:12:35.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sedikit tidak paham!
Dialogue: 0,0:12:35.48,0:12:38.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pekerjaan kita diminta direktur\Nperusahaan asuransi itu, kan?
Dialogue: 0,0:12:38.70,0:12:43.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kalian malah menyerang\Nklien sendiri dan bukan musuh, sih?
Dialogue: 0,0:12:43.08,0:12:43.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:12:43.99,0:12:47.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya ini cara yang tercepat\Ndan tidak ribet.
Dialogue: 0,0:12:47.12,0:12:49.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian pikir siapa yang bakal\Nkasih upah nantinya?
Dialogue: 0,0:12:49.29,0:12:51.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bikin klien marah,\Nnanti malah tidak dibayar, lo!
Dialogue: 0,0:12:51.96,0:12:55.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, upah kecil dari sisi gelap\Nenggak begitu penting.
Dialogue: 0,0:12:55.84,0:12:58.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Target kita minimal senilai 15 miliar yen.
Dialogue: 0,0:12:58.67,0:13:01.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemungkinan besar isi brankas mereka\Njauh lebih besar dari itu, lo.
Dialogue: 0,0:13:01.68,0:13:04.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mending kita prioritaskan yang itu dulu.
Dialogue: 0,0:13:04.99,0:13:06.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masuk akal.
Dialogue: 0,0:13:06.55,0:13:08.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ta-Tapi dia pejabat berkuasa, loh!
Dialogue: 0,0:13:08.85,0:13:11.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sampai dibenci sama\Norang dewasa yang seram dan berkuasa,
Dialogue: 0,0:13:11.98,0:13:15.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}terus nyawa kita nanti diincar,\Nbagaimana coba?
Dialogue: 0,0:13:16.14,0:13:19.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pikir level 5 bakal kalah\Ncuma gara-gara hal sepele begitu?
Dialogue: 0,0:13:23.20,0:13:25.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, kalau dia memang klien penting,
Dialogue: 0,0:13:25.87,0:13:29.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}suara di telepon yang jadi perantara itu\Nenggak bakal asal membocorkan informasi.
Dialogue: 0,0:13:30.29,0:13:34.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harusnya dia cukup menyuruh kita\Nmenghancurkan koloseum,
Dialogue: 0,0:13:34.67,0:13:39.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi dia malah membeberkan informasi\Nsoal direktur perusahaan asuransi jiwa itu.
Dialogue: 0,0:13:39.17,0:13:42.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama saja kayak bilang\N"Lakukan sesuka kalian" secara tersirat.
Dialogue: 0,0:13:43.09,0:13:45.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Walau dia tidak blak-blakkan,\Nkita dapat izin.
Dialogue: 0,0:13:45.89,0:13:47.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Te-Tetap saja...
Dialogue: 0,0:13:47.68,0:13:52.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya itu bisa buat kalian tahu\Nperusahaan asuransi mana yang jadi kliennya?
Dialogue: 0,0:13:52.69,0:13:54.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perusahaannya lagi ada\Nmasalah internal, kan?
Dialogue: 0,0:13:54.69,0:13:56.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tinggal cari perusahaan asuransi
Dialogue: 0,0:13:56.86,0:14:00.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang belakangan ini gencar\Nmencari informasi sampai ke ranah sisi gelap
Dialogue: 0,0:14:00.40,0:14:03.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}buat cari penyebab masalahnya,\Npasti bisa mengerucut.
Dialogue: 0,0:14:03.71,0:14:04.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar kan, Frenda?
Dialogue: 0,0:14:04.87,0:14:06.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedikit lagi.
Dialogue: 0,0:14:07.12,0:14:12.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau ngomong apa pun, suara di telepon itu\Nenggak ada niatan melindungi klien.
Dialogue: 0,0:14:12.33,0:14:15.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya, prioritas kita sekarang\Nadalah menghancurkan koloseum dulu!
Dialogue: 0,0:14:15.92,0:14:17.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:14:17.86,0:14:20.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya yang lagi kesusahan itu\Norang-orang perusahaan asuransi?
Dialogue: 0,0:14:20.88,0:14:25.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujungnya, pasti ada kepentingan\Natau keuntungan lain di balik ini.
Dialogue: 0,0:14:25.01,0:14:28.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena informasinya tidak lengkap,\Njustru itu tujuan utamanya,
Dialogue: 0,0:14:28.26,0:14:30.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pihak yang ingin dilindungi\Nsama suara di telepon itu.
Dialogue: 0,0:14:31.52,0:14:32.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mugino.
Dialogue: 0,0:14:32.77,0:14:36.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski agak mencurigakan,\Nstatus mereka tetap warga sipil.
Dialogue: 0,0:14:36.83,0:14:38.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus hati-hati dalam menanganinya.
Dialogue: 0,0:14:39.32,0:14:40.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paling cuma karangan bebas.
Dialogue: 0,0:14:41.24,0:14:43.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peringkat 6 Kota Akademi,
Dialogue: 0,0:14:43.16,0:14:45.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sering pula disebut musuh alami sisi gelap.
Dialogue: 0,0:14:45.61,0:14:47.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya jangan dianggap remeh.
Dialogue: 0,0:14:50.16,0:14:55.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya ada penguntit berbahaya yang ditemukan\Ndalam keadaan tergantung.
Dialogue: 0,0:14:55.21,0:14:58.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus, kelompok penyelundup senjata\Nmusnah dalam semalam.
Dialogue: 0,0:14:59.42,0:15:01.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seorang anak berhasil direbut kembali
Dialogue: 0,0:15:01.00,0:15:03.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dari sindikat penculikan\Ndalam keadaan selamat tanpa cedera.
Dialogue: 0,0:15:03.88,0:15:08.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rumornya bak bintang di langit,\Ntapi identitasnya masih misterius.
Dialogue: 0,0:15:08.39,0:15:11.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagi orang lemah di Kota Akademi,\Ndia penyelamat.
Dialogue: 0,0:15:11.01,0:15:14.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagi yang diincar, dia bencana berjalan.
Dialogue: 0,0:15:14.48,0:15:16.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, itu kemampuan peringkat 6...
Dialogue: 0,0:15:17.44,0:15:20.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi Mugino peringkat 4, kan?
Dialogue: 0,0:15:20.48,0:15:22.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harusnya tidak masalah, kan?
Dialogue: 0,0:15:22.61,0:15:23.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa tidak jawab?
Dialogue: 0,0:15:23.44,0:15:27.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujung-ujungnya, kalau sesama level 5\Nbertempur habis-habisan,
Dialogue: 0,0:15:27.20,0:15:29.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mugino juga tidak bakal\Nmenang tanpa terluka.
Dialogue: 0,0:15:29.83,0:15:34.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi berdasarkan sifat Mugino,\Nhal tersebut akan sulit dihindari.
Dialogue: 0,0:15:34.81,0:15:36.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:15:36.04,0:15:40.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujungnya, kita siapkan jebakan\Ndalam sekejap
Dialogue: 0,0:15:40.42,0:15:43.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan langsung kabur.\NKurang lebih begitu, ya?
Dialogue: 0,0:15:44.92,0:15:46.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, begitu saja, deh.
Dialogue: 0,0:15:46.93,0:15:49.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini yang jadi klien kita kali ini?
Dialogue: 0,0:15:49.39,0:15:50.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudmu target kita, kan?
Dialogue: 0,0:15:51.31,0:15:54.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku... apa yang harus kulakukan banget?
Dialogue: 0,0:15:55.18,0:15:57.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Proyek Mei Gelap.
Dialogue: 0,0:15:57.23,0:16:02.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Otakmu ditanami pola pikir\Nperingkat 1 Kota Akademi, kan?
Dialogue: 0,0:16:02.65,0:16:04.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jujur saja, seberapa hebat kemampuanmu?
Dialogue: 0,0:16:04.65,0:16:06.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah...
Dialogue: 0,0:16:06.49,0:16:08.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekadar bunuh orang mah gampang.
Dialogue: 0,0:16:21.71,0:16:24.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Se-Serangan? Lebih ngebut lagi!
Dialogue: 0,0:16:24.13,0:16:25.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pak Direktur, harap tena—
Dialogue: 0,0:16:34.72,0:16:35.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mantap!
Dialogue: 0,0:16:35.94,0:16:39.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujungnya,\Nranjau daratku tepat sasaran!
Dialogue: 0,0:16:43.32,0:16:46.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, sekarang waktunya olahraga sedikit.
Dialogue: 0,0:16:46.86,0:16:48.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aksi kita agak berlebihan, ya?
Dialogue: 0,0:16:48.99,0:16:50.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benaran aman, nih?
Dialogue: 0,0:16:50.32,0:16:54.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya Takitsubo bilang kalau\Nmembunuh warga sipil itu bakal gawat?
Dialogue: 0,0:16:54.49,0:16:58.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mobil mereka kokoh, diperlakukan\Nbegini saja enggak bakal mati, lah.
Dialogue: 0,0:16:58.25,0:16:59.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu...
Dialogue: 0,0:17:02.50,0:17:06.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begini, pengawal kebanggaannya\Nenggak akan bisa keluar.
Dialogue: 0,0:17:07.51,0:17:09.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, langsung saja...
Dialogue: 0,0:17:09.83,0:17:12.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih situasi waspada ini, Anak Baru.
Dialogue: 0,0:17:13.14,0:17:15.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, oke banget.
Dialogue: 0,0:17:33.49,0:17:36.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal Mugino sudah bilang\Nmasih situasi waspada.
Dialogue: 0,0:17:36.33,0:17:37.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah waspada, kok.
Dialogue: 0,0:17:37.29,0:17:39.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya, dia tidak luka sedikit pun.
Dialogue: 0,0:17:39.62,0:17:41.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini direktur yang kita incar, kan?
Dialogue: 0,0:17:41.79,0:17:44.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau dibawa ke mana, nih?
Dialogue: 0,0:17:44.17,0:17:48.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski kedap suara, aku tidak mau\Nbawa dia ke markas kita.
Dialogue: 0,0:17:48.51,0:17:51.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti organisasi bawahan bakal\Nmencarikan tempat yang cocok.
Dialogue: 0,0:17:51.84,0:17:53.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa di pabrik bekas atau rumah sakit.
Dialogue: 0,0:17:53.97,0:17:55.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau dimasukkan ke tas itu?
Dialogue: 0,0:17:55.89,0:17:57.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bakal sesak banget, loh.
Dialogue: 0,0:17:58.18,0:17:59.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini ganti jaket pengaman.
Dialogue: 0,0:18:01.52,0:18:03.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pe-Pengawal!
Dialogue: 0,0:18:07.69,0:18:09.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya ampun.
Dialogue: 0,0:18:10.15,0:18:13.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemampuan? Logam?
Dialogue: 0,0:18:13.32,0:18:15.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahannya cairan pula.
Dialogue: 0,0:18:16.74,0:18:21.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bagi-bagi tisu jenis apa\Npakai baju seperti itu?
Dialogue: 0,0:18:22.71,0:18:25.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pikir ini cuma kostum biasa?
Dialogue: 0,0:18:25.96,0:18:30.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aslinya ini produk hasil penelitian\Nbahan peredam benturan kelas atas yang baru,
Dialogue: 0,0:18:30.26,0:18:33.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi untuk penerapan aktualnya\Nmasih terlalu berat.
Dialogue: 0,0:18:33.01,0:18:35.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi ini sangat cocok
Dialogue: 0,0:18:35.30,0:18:37.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk mengatasi kemampuanmu.
Dialogue: 0,0:18:37.60,0:18:41.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga tidak tertarik\Nsama om-om gendut begini,
Dialogue: 0,0:18:41.98,0:18:43.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi Om Jahat ini sudah janji
Dialogue: 0,0:18:43.77,0:18:48.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bakal cerita yang dia tahu\Ntentang Gedung Tanpa Jendela.
Dialogue: 0,0:18:48.61,0:18:50.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gedung Tanpa Jendela.
Dialogue: 0,0:18:50.82,0:18:54.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu ada urusan dengan\NDewan Eksekutif Kota Akademi?
Dialogue: 0,0:18:55.78,0:18:57.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitulah.
Dialogue: 0,0:18:57.32,0:19:01.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak ada perlu, sih, tapi sebelum\Nkuhancurkan, aku butuh denah bangunannya.
Dialogue: 0,0:19:02.79,0:19:07.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, nih. Apa kalian bisa\Nmembiarkanku menjalankan tugas?
Dialogue: 0,0:19:08.92,0:19:12.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujungnya, gadis penyendiri sepertimu\Nbisa apa sendirian?
Dialogue: 0,0:19:12.34,0:19:13.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami berlima!
Dialogue: 0,0:19:13.84,0:19:18.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil kamu bisa melawan kami\Nsambil melindungi target yang kabur!
Dialogue: 0,0:19:18.51,0:19:22.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pakai kemampuanmu buat nambah\Nlengan enam biji pun tetap tidak bakal bisa!
Dialogue: 0,0:19:22.14,0:19:24.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong jangan hitung aku, dong!
Dialogue: 0,0:19:24.10,0:19:28.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang kayak kamu cuma\Nsebatas musuh yang gerakannya gesit!
Dialogue: 0,0:19:32.44,0:19:33.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetesan air...
Dialogue: 0,0:19:33.78,0:19:35.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berwarna perak?
Dialogue: 0,0:19:36.28,0:19:38.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya, waspada di atas kepala!
Dialogue: 0,0:19:47.75,0:19:49.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hujan panah logam?
Dialogue: 0,0:19:50.04,0:19:53.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudnya dia bikin awan di atas langit\Nterus dibiarkan hujan ke bawah?
Dialogue: 0,0:19:58.72,0:20:01.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ledakan barusan membuat\Nsebarannya agak berantakan.
Dialogue: 0,0:20:01.22,0:20:02.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:20:02.81,0:20:03.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takitsubo!
Dialogue: 0,0:20:08.94,0:20:09.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takitsubo!
Dialogue: 0,0:20:11.98,0:20:14.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takitsubo tidak apa-apa.
Dialogue: 0,0:20:14.78,0:20:17.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini tugasku, kan?
Dialogue: 0,0:20:19.66,0:20:21.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanano juga semangat, ya.
Dialogue: 0,0:20:22.08,0:20:23.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu juga masih bisa\Nmembalikkan keadaan.
Dialogue: 0,0:20:31.13,0:20:34.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujungnya,\Nini tidak bisa dimaafkan.
Dialogue: 0,0:20:34.13,0:20:37.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai bikin warga sipil\Ntewas sia-sia begini.
Dialogue: 0,0:20:37.51,0:20:39.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mau main-main,\Ncari musuh yang kuat, dong!
Dialogue: 0,0:20:39.68,0:20:41.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setuju banget.
Dialogue: 0,0:20:42.26,0:20:44.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang giliran kami.
Dialogue: 0,0:20:56.07,0:20:58.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengabaikan pertahanan\Ndan fokus menyerang, ya?
Dialogue: 0,0:20:58.95,0:21:01.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak cantik bikin aku merinding, nih.
Dialogue: 0,0:21:01.03,0:21:03.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelakuanmu benaran\Nenggak pandang bulu, ya.
Dialogue: 0,0:21:03.78,0:21:07.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Metode pembuangan mayat\Nyang aman butuh biaya besar, tahu.
Dialogue: 0,0:21:09.08,0:21:14.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua kekacauan yang kamu timbulkan\Nbakal diurus pakai uangmu sendiri, kan?
Dialogue: 0,0:21:14.84,0:21:18.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sampai terdeteksi sama peringkat 6\Nyang konon musuh alami sisi gelap,
Dialogue: 0,0:21:18.55,0:21:21.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu urus sendiri, ya, bedebah.
Dialogue: 0,0:21:21.47,0:21:25.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan di saat begini, kamu masih\Nmarah atas kematian orang lain.
Dialogue: 0,0:21:25.31,0:21:26.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mugino memang baik.
Dialogue: 0,0:21:32.19,0:21:33.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cih!
Dialogue: 0,0:21:48.54,0:21:53.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bentuk boneka memang\Nyang paling gampang dikendalikan!
Dialogue: 0,0:21:54.79,0:21:59.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau soal sekutu,\Nkakak cantik ini juga tidak kekurangan.
Dialogue: 0,0:22:00.05,0:22:01.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah...
Dialogue: 0,0:22:01.34,0:22:04.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi bilang apa soal menang jumlah?
