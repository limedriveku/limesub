Dialogue: 0,0:00:00.00,0:00:03.73,sign,,0000,0000,0000,,A CERTAIN MAGICAL INDEX\NCERITA SAMPINGAN
Dialogue: 0,0:00:03.73,0:00:06.11,sign,,0000,0000,0000,,31 JULI, PUKUL 07.30 PAGI
Dialogue: 0,0:00:16.12,0:00:18.00,sign,,0000,0000,0000,,A CERTAIN ITEM OF DARK SIDE
Dialogue: 0,0:00:24.21,0:00:26.67,sign,,0000,0000,0000,,31 JULI
Dialogue: 0,0:03:54.51,0:03:55.05,sign,,0000,0000,0000,,PENGGALANGAN DANA UNTUK MENOLONG\NANAK-ANAK YANG MEMBUTUHKAN
Dialogue: 0,0:03:55.05,0:03:57.38,sign,,0000,0000,0000,,PANTI ASUNARO, NPO JANOMICHI CURES
Dialogue: 0,0:06:21.09,0:06:21.92,sign,,0000,0000,0000,,SD NEGERI HIRAHATA
Dialogue: 0,0:06:21.92,0:06:23.28,sign,,0000,0000,0000,,ASRAMA AOBA
Dialogue: 0,0:07:34.39,0:07:36.03,sign,,0000,0000,0000,,NPO JANOMICHI CURES
Dialogue: 0,0:11:04.48,0:11:05.05,sign,,0000,0000,0000,,#1 ITEM
Dialogue: 0,0:11:05.05,0:11:06.40,sign,,0000,0000,0000,,ITEM?
Dialogue: 0,0:16:48.53,0:16:51.78,sign,,0000,0000,0000,,DOKTER JANOMICHI
Dialogue: 0,0:17:00.58,0:17:03.04,sign,,0000,0000,0000,,MELTDOWNER - DISINTEGRASI ATOM
Dialogue: 0,0:17:16.57,0:17:23.02,sign,,0000,0000,0000,,OFFENSE ARMOR - ZIRAH NITROGEN
Dialogue: 0,0:17:26.42,0:17:28.94,sign,,0000,0000,0000,,AIM STALKER - PELACAK KEMAMPUAN
Dialogue: 0,0:18:02.14,0:18:05.23,sign,,0000,0000,0000,,RAILGUN - MERIAM ELEKTROMAGNETIK
Dialogue: 0,0:19:35.65,0:19:36.86,sign,,0000,0000,0000,,FRENDA
Dialogue: 0,0:21:12.50,0:21:13.96,sign,,0000,0000,0000,,FRENDA
Dialogue: 0,0:21:21.34,0:21:23.16,sign,,0000,0000,0000,,TAKITSUBO RIKOU
Dialogue: 0,0:22:41.01,0:22:42.51,sign,,0000,0000,0000,,SATU BULAN LALU - 30 JUNI
Dialogue: 0,0:23:34.98,0:23:35.48,sign,,0000,0000,0000,,A CERTAIN ITEM OF DARK SIDE
Dialogue: 0,0:23:35.48,0:23:39.94,sign,,0000,0000,0000,,#2 ANAK BARU, KINUHATA SAIAI
Dialogue: 0,0:00:07.82,0:00:09.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial.
Dialogue: 0,0:00:09.16,0:00:12.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal semalam aku sudah kerja lembur.
Dialogue: 0,0:00:13.08,0:00:16.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa hari ini masih harus ke sekolah?
Dialogue: 0,0:00:20.58,0:00:23.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Total populasi 2,3 juta.
Dialogue: 0,0:00:23.29,0:00:26.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}80% penduduknya adalah siswa.
Dialogue: 0,0:00:26.67,0:00:29.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inilah Kota Akademi.
Dialogue: 0,0:00:29.84,0:00:32.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pusat sains dan teknologi mutakhir.
Dialogue: 0,0:00:32.18,0:00:35.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alias, kota eksperimen raksasa.
Dialogue: 0,0:00:35.97,0:00:39.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Konon, teknologi di Kota Akademi lebih maju
Dialogue: 0,0:00:39.89,0:00:43.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}20 sampai 30 tahun dibanding kota lain.
Dialogue: 0,0:00:43.19,0:00:46.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, apa yang orang-orang\Npelajari di sini?
Dialogue: 0,0:00:46.65,0:00:47.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan.
Dialogue: 0,0:00:48.19,0:00:49.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan super?
Dialogue: 0,0:00:49.28,0:00:50.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul!
Dialogue: 0,0:00:50.07,0:00:52.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma di sini kamu bisa melakukannya.
Dialogue: 0,0:00:52.41,0:00:56.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin dalam beberapa tahun,\Nkalian juga akan berada
Dialogue: 0,0:00:56.20,0:00:59.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di puncak Kota Akademi\Nsebagai esper level 5!
Dialogue: 0,0:01:03.75,0:01:05.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan menangis.
Dialogue: 0,0:01:05.59,0:01:10.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami, Judgement, akan mencari\Nteman-teman yang terpisah darimu.
Dialogue: 0,0:01:10.80,0:01:14.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Komari, aku sudah menghubungi Anti-Skill!
Dialogue: 0,0:01:14.26,0:01:15.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:01:15.43,0:01:18.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kagum pada mereka yang menopang
Dialogue: 0,0:01:18.85,0:01:21.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kota Akademi di muka umum.
Dialogue: 0,0:01:22.44,0:01:25.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anggota Judgement itu\Nkayak tidak asing...
Dialogue: 0,0:01:25.36,0:01:26.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kinuhata.
Dialogue: 0,0:01:26.52,0:01:28.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau gabung sama mereka?
Dialogue: 0,0:01:28.32,0:01:30.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayaknya mustahil, deh.
Dialogue: 0,0:01:30.19,0:01:32.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Toh, aku juga tidak benci pekerjaan ini.
Dialogue: 0,0:01:33.07,0:01:34.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Takitsubo sendiri?
Dialogue: 0,0:01:34.95,0:01:35.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku
Dialogue: 0,0:01:36.45,0:01:38.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ingin ada di tempat Mugino berada.
Dialogue: 0,0:01:38.83,0:01:42.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, dia memang pemimpin\Nyang bisa diandalkan.
Dialogue: 0,0:01:42.50,0:01:47.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di luar sifat sumbu pendek,\Nsuper maksa, dan super kasarnya.
Dialogue: 0,0:01:47.34,0:01:47.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:01:49.88,0:01:51.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kadang aku penasaran.
Dialogue: 0,0:01:51.80,0:01:57.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang-orang kemarin, memangnya\Nperlu dimusnahkan semua?
Dialogue: 0,0:01:58.31,0:02:01.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin, karena mereka berniat\Nmelakukan terorisme.
Dialogue: 0,0:02:01.81,0:02:04.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempo hari juga terjadi.
Dialogue: 0,0:02:04.60,0:02:09.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diserangnya Ketua Dewan Eksekutif\Ndi gedung tanpa jendela itu, ya?
Dialogue: 0,0:02:09.03,0:02:11.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu penyebabnya?
Dialogue: 0,0:02:11.32,0:02:15.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, mungkin kita akan sibuk\Nuntuk sementara
Dialogue: 0,0:02:15.07,0:02:17.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena banyak pekerjaan kotor.
Dialogue: 0,0:02:17.24,0:02:19.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktunya bersih-bersih, ya.
Dialogue: 0,0:02:19.83,0:02:24.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku lebih suka hidup pas-pasan\Ntapi banyak luangnya, sih.
Dialogue: 0,0:02:25.04,0:02:26.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cih.
Dialogue: 0,0:02:26.21,0:02:28.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuacanya lagi panas pula.
Dialogue: 0,0:02:28.71,0:02:32.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, tadi itu Mugino Shizuri, kan?
Dialogue: 0,0:02:32.30,0:02:32.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:02:32.97,0:02:35.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Esper level 5 dari sekolah kita?
Dialogue: 0,0:02:35.30,0:02:36.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:02:36.55,0:02:39.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baru kali ini aku melihatnya langsung.
Dialogue: 0,0:02:39.14,0:02:41.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar dia jarang sekolah.
Dialogue: 0,0:02:42.02,0:02:44.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok libur musim panas malah datang?
Dialogue: 0,0:02:44.44,0:02:48.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin level 5 punya kurikulum khusus.
Dialogue: 0,0:02:48.19,0:02:49.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana ada!
Dialogue: 0,0:02:53.82,0:02:55.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:02:55.28,0:02:57.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerjaan baru?
Dialogue: 0,0:02:57.41,0:02:59.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang kemarin saja baru kelar!
Dialogue: 0,0:03:00.41,0:03:02.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anggota sisi gelap ada banyak, kan?
Dialogue: 0,0:03:02.87,0:03:06.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayak Paduka Nomor 1\Natau Yang Mulia Nomor 2.
Dialogue: 0,0:03:06.08,0:03:07.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suruh mereka saja.
Dialogue: 0,0:03:07.38,0:03:09.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada-ada saja.
Dialogue: 0,0:03:09.53,0:03:10.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula,
Dialogue: 0,0:03:10.81,0:03:14.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}orang yang kalian ringkus di TKP kemarin
Dialogue: 0,0:03:14.30,0:03:18.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ternyata klien dari organisasi mencurigakan.
Dialogue: 0,0:03:18.14,0:03:20.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajar kalau kalian yang urus, kan?
Dialogue: 0,0:03:21.39,0:03:23.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya dia kubunuh saja.
Dialogue: 0,0:03:23.77,0:03:27.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Upahnya pasti tinggi, kok.
Dialogue: 0,0:03:27.19,0:03:28.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemarin juga katamu begitu...
Dialogue: 0,0:03:28.73,0:03:32.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, ada Mugino!\NTumben banget.
Dialogue: 0,0:03:32.86,0:03:34.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersiaplah untuk pengarahan.
Dialogue: 0,0:03:34.86,0:03:36.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar...
Dialogue: 0,0:03:37.57,0:03:41.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak kusangka kita bertemu di sekolah\Nsaat libur musim panas.
Dialogue: 0,0:03:41.49,0:03:43.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mau apa?
Dialogue: 0,0:03:43.37,0:03:47.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dipanggil guru karena belum\Nmengumpulkan tugas ini itu.
Dialogue: 0,0:03:47.96,0:03:51.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana denganmu, Ketua Kelas?
Dialogue: 0,0:03:51.38,0:03:54.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku...\NKarena ini.
Dialogue: 0,0:03:55.05,0:03:57.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penggalangan donasi.
Dialogue: 0,0:03:57.84,0:03:59.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau bergabung?
Dialogue: 0,0:04:00.01,0:04:02.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku, Shiratori Okibi,\Nyang merekomendasikannya.
Dialogue: 0,0:04:02.60,0:04:04.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi donasi ini legal.
Dialogue: 0,0:04:04.22,0:04:08.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dananya untuk biaya hidup\Ndan berobat anak yatim piatu.
Dialogue: 0,0:04:08.81,0:04:10.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak, ah.
Dialogue: 0,0:04:10.40,0:04:13.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tidak cocok denganku,\Nkamu tahu, kan?
Dialogue: 0,0:04:14.23,0:04:20.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa tahu ada sisi lain\Ndi balik sisi jutekmu di sekolah.
Dialogue: 0,0:04:20.52,0:04:22.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hubungi aku kalau minat.
Dialogue: 0,0:04:22.49,0:04:23.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak akan.
Dialogue: 0,0:04:23.87,0:04:28.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya, aku kurang cocok\Ndengan kata keadilan.
Dialogue: 0,0:04:28.33,0:04:32.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima ini!\NTendangan Keadilan Gekota!
Dialogue: 0,0:04:32.25,0:04:33.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duar!
Dialogue: 0,0:04:33.34,0:04:34.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, iya.
Dialogue: 0,0:04:34.59,0:04:38.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti senang dapat edisi terbatas\Nkarakter favoritmu, kan?
Dialogue: 0,0:04:38.72,0:04:41.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujungnya, kolaborasi sama sentai, kan?
Dialogue: 0,0:04:41.14,0:04:41.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:04:41.84,0:04:45.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku paling suka yang merah\Nkarena kelihatan keren!
Dialogue: 0,0:04:45.68,0:04:48.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujungnya, sederhana itu bagus.
Dialogue: 0,0:04:48.73,0:04:52.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Frenda menganggapku\Nkayak anak kecil!
Dialogue: 0,0:04:52.90,0:04:54.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Niatku bukan begitu,
Dialogue: 0,0:04:54.52,0:04:58.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi anak SD memang masih kecil, kan?
Dialogue: 0,0:04:58.47,0:05:02.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, hari ini aku melerai\Npertengkaran orang dewasa, lo.
Dialogue: 0,0:05:02.66,0:05:03.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:05:03.74,0:05:06.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok kamu melakukan hal berbahaya?
Dialogue: 0,0:05:06.45,0:05:08.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Situasinya seperti apa?
Dialogue: 0,0:05:08.16,0:05:09.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini...
Dialogue: 0,0:05:10.04,0:05:13.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu aku dan temanku antre\Nuntuk mendapatkan ini,
Dialogue: 0,0:05:13.67,0:05:16.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mbak-mbak SMP yang ada di belakang...
Dialogue: 0,0:05:17.17,0:05:21.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, padahal sudah kelas 1 SMP,
Dialogue: 0,0:05:21.34,0:05:24.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kok antre bareng anak kecil?
Dialogue: 0,0:05:24.60,0:05:28.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pantas saja tubuhmu kayak anak kecil.
Dialogue: 0,0:05:28.72,0:05:29.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:05:29.64,0:05:31.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jelas-jelas kamu lebih pendek!
Dialogue: 0,0:05:31.98,0:05:35.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertumbuhanku lancar, kok.
Dialogue: 0,0:05:35.06,0:05:39.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tahun depan, tubuhku bakal jadi aduhai.
Dialogue: 0,0:05:39.24,0:05:41.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tubuhmu jadi aduhai,\Ntubuhku juga—
Dialogue: 0,0:05:41.99,0:05:43.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu...
Dialogue: 0,0:05:43.74,0:05:45.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku bilang ke mereka.
Dialogue: 0,0:05:45.95,0:05:49.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Kalau memang sudah SMP,\Ntolong jangan berkelahi."
Dialogue: 0,0:05:49.66,0:05:51.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu ini...
Dialogue: 0,0:05:51.04,0:05:53.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, syukurlah kalau selesai.
Dialogue: 0,0:05:53.67,0:05:57.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujungnya, jauhilah orang-orang\Nmenyedihkan begitu.
Dialogue: 0,0:05:57.00,0:05:58.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:05:58.17,0:06:00.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, bangunan itu hancur!
Dialogue: 0,0:06:00.13,0:06:02.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti ulah kaiju!
Dialogue: 0,0:06:02.56,0:06:04.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Saatnya pahlawan beraksi!\N- Bangunan itu
Dialogue: 0,0:06:04.18,0:06:06.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}masih sama, ya.
Dialogue: 0,0:06:06.55,0:06:09.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak, kamu jadi sedih?
Dialogue: 0,0:06:10.35,0:06:12.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?\NYa-Yah...
Dialogue: 0,0:06:12.60,0:06:15.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujungnya, jadi dewasa itu rumit.
Dialogue: 0,0:06:15.65,0:06:18.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, lagi-lagi aku dianggap anak kecil!
Dialogue: 0,0:06:18.52,0:06:19.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, maaf.
Dialogue: 0,0:06:21.92,0:06:23.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai nanti.
Dialogue: 0,0:06:23.28,0:06:26.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengarkan dan patuhi kata gurumu, ya?
Dialogue: 0,0:06:26.24,0:06:27.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:06:27.16,0:06:29.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, Kakak.
Dialogue: 0,0:06:29.83,0:06:30.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nih.
Dialogue: 0,0:06:32.00,0:06:33.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini?
Dialogue: 0,0:06:33.12,0:06:35.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kasih gratisannya buat Kakak.
Dialogue: 0,0:06:35.79,0:06:39.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya kalau Kakak sedih,\Naku juga ikut sedih.
Dialogue: 0,0:06:39.63,0:06:40.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, tidak usah.
Dialogue: 0,0:06:40.59,0:06:44.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sudah tidak sedih,\Nberikan itu ke orang yang bersedih!
Dialogue: 0,0:06:44.09,0:06:45.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dadah!
Dialogue: 0,0:06:47.76,0:06:50.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengarahan?
Dialogue: 0,0:06:52.39,0:06:55.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di tiap kota memang ada orang jahat,
Dialogue: 0,0:06:55.69,0:06:58.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi di Kota Akademi ini levelnya beda.
Dialogue: 0,0:06:58.02,0:07:01.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang merusak hidup orang\Ndengan teknologi aneh,
Dialogue: 0,0:07:02.49,0:07:05.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}merampas hasil penelitian\Npakai jasa preman,
Dialogue: 0,0:07:05.78,0:07:08.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan menipu anak kecil\Nuntuk dijadikan eksperimen.
Dialogue: 0,0:07:08.84,0:07:13.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, ada juga manusia klona\Nbernama Dolly, kan?
Dialogue: 0,0:07:13.54,0:07:16.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, itu cuma sebagian kecil.
Dialogue: 0,0:07:16.67,0:07:19.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duh, ada-ada saja...
Dialogue: 0,0:07:19.54,0:07:22.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, perlu urus yang mana?
Dialogue: 0,0:07:22.55,0:07:23.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak kecil.
Dialogue: 0,0:07:23.55,0:07:27.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malah yang paling memuakkan, deh.
Dialogue: 0,0:07:27.05,0:07:29.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Targetnya adalah organisasi ini.
Dialogue: 0,0:07:29.01,0:07:31.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Sekilas, organisasi itu tampak\N- Janomichi?
Dialogue: 0,0:07:31.47,0:07:33.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- seperti NPO yang resmi\N- Kayak pernah dengar...
Dialogue: 0,0:07:34.39,0:07:36.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu, ya?
Dialogue: 0,0:07:36.03,0:07:39.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pernah lihat pamfletnya.
Dialogue: 0,0:07:39.19,0:07:42.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka mengobati anak\Nyang sakit kronis atau apalah.
Dialogue: 0,0:07:42.23,0:07:45.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru fasilitas penuh teror itu
Dialogue: 0,0:07:45.07,0:07:49.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}memberi trauma fisik dan mental\Nke anak-anak yang sehat
Dialogue: 0,0:07:49.07,0:07:50.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}demi mengasah kemampuan mereka.
Dialogue: 0,0:07:50.78,0:07:55.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skalanya belum besar,\Nanak yang disandera baru lima.
Dialogue: 0,0:07:55.20,0:07:58.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau mungkin yang masih hidup sisa lima.
Dialogue: 0,0:07:58.21,0:08:00.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang sadis, sih.
Dialogue: 0,0:08:00.46,0:08:03.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi yang memakai anak kecil\Nuntuk penelitian kemampuan
Dialogue: 0,0:08:03.88,0:08:06.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bukan cuma mereka, kan?
Dialogue: 0,0:08:06.05,0:08:07.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul.
Dialogue: 0,0:08:07.38,0:08:09.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi yang bahayanya,
Dialogue: 0,0:08:09.51,0:08:13.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hasil uji coba mereka mau dibawa\Nke luar Kota Akademi.
Dialogue: 0,0:08:14.01,0:08:16.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau dipresentasikan\Ndi Konferensi Otak dan Syaraf
Dialogue: 0,0:08:16.48,0:08:19.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang digelar lusa di luar Kota Akademi.
Dialogue: 0,0:08:19.27,0:08:20.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:08:20.44,0:08:24.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujungnya, Dewan Eksekutif\Ntidak akan mengizinkannya!
Dialogue: 0,0:08:24.69,0:08:25.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:08:25.65,0:08:29.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa-bisa kredibilitas Kota Akademi\Nkena dampaknya.
Dialogue: 0,0:08:29.66,0:08:32.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi kami cuma perlu\Nmencegah presentasinya?
Dialogue: 0,0:08:32.99,0:08:34.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin, kan?
Dialogue: 0,0:08:34.28,0:08:35.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja.
Dialogue: 0,0:08:35.87,0:08:39.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masukkan CEO ini ke kantong mayat.
Dialogue: 0,0:08:39.00,0:08:40.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, ada satu imbauan.
Dialogue: 0,0:08:40.78,0:08:45.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang terkuat dari lima anak itu,\Ndia jadikan pengawal.
Dialogue: 0,0:08:46.63,0:08:50.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar, temboknya bisa\Nmenahan serangan apa pun.
Dialogue: 0,0:08:50.89,0:08:54.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tipe khusus pertahanan\Nseperti Kinuhata, ya?
Dialogue: 0,0:08:54.18,0:08:57.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, pertahanan apa pun\Nakan kami tembus.
Dialogue: 0,0:08:57.73,0:08:59.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau menerobos paksa?
Dialogue: 0,0:08:59.64,0:09:01.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bakal cepat mati kalau di sisi gelap.
Dialogue: 0,0:09:01.56,0:09:02.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:09:02.10,0:09:06.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Habis CEO-nya dibunuh,\Nsisanya diapakan?
Dialogue: 0,0:09:06.44,0:09:07.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sisanya?
Dialogue: 0,0:09:07.23,0:09:07.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudku...
Dialogue: 0,0:09:07.86,0:09:12.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudnya para staf dan anak-anak\Nyang jadi subjek uji coba.
Dialogue: 0,0:09:12.36,0:09:14.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, terserah kalian saja.
Dialogue: 0,0:09:14.70,0:09:19.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak yang bukan pengawal CEO\Npasti ada di tempat berbeda.
Dialogue: 0,0:09:19.37,0:09:21.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu.
Dialogue: 0,0:09:21.96,0:09:23.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah, Frenda.
Dialogue: 0,0:09:23.58,0:09:27.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, membunuh anak kecil\Nmemang bikin dilema.
Dialogue: 0,0:09:27.25,0:09:28.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengar!
Dialogue: 0,0:09:28.30,0:09:31.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beda denganmu, senjataku itu bom!
Dialogue: 0,0:09:31.05,0:09:35.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bom itu makan biaya,\Njadi sebaiknya hemat!
Dialogue: 0,0:09:35.81,0:09:37.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, deh.
Dialogue: 0,0:09:37.22,0:09:39.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku beri kesempatan.
Dialogue: 0,0:09:50.61,0:09:52.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah bangun, Kyo?
Dialogue: 0,0:09:53.32,0:09:56.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pialang pasar gelap sudah kuminta
Dialogue: 0,0:09:56.24,0:10:01.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}memalsukan ID kita dari basis data bank\Nseluruh Kota Akademi.
Dialogue: 0,0:10:01.00,0:10:04.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kabarnya, akan selesai malam ini.
Dialogue: 0,0:10:04.21,0:10:07.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kamu bisa segera keluar dari sini.
Dialogue: 0,0:10:07.38,0:10:08.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:10:08.80,0:10:10.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- A-Anu...\N- Benar!
Dialogue: 0,0:10:10.26,0:10:13.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu akan kupresentasikan di tempat\Nyang tidak seorang pun tahu!
Dialogue: 0,0:10:13.72,0:10:16.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seantero dunia pasti terkejut!
Dialogue: 0,0:10:16.01,0:10:20.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, Profesor Janomichi,\Nsaat keluar dari sini,
Dialogue: 0,0:10:20.81,0:10:23.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami semua akan keluar bersama, kan?
Dialogue: 0,0:10:23.48,0:10:25.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berapa kali harus kubilang.
Dialogue: 0,0:10:25.94,0:10:28.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak pernah berbohong.
Dialogue: 0,0:10:28.32,0:10:31.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak seperti kalian\Nyang ingin cepat malas-malasan.
Dialogue: 0,0:10:31.69,0:10:33.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maaf.
Dialogue: 0,0:10:34.28,0:10:38.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak berpikir bahwa profesor\Nyang sudah memungut kami akan berbohong.
Dialogue: 0,0:10:38.58,0:10:39.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pastinya.
Dialogue: 0,0:10:40.54,0:10:42.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya.
Dialogue: 0,0:10:42.33,0:10:46.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemarin ada klien yang diringkus\Noleh Dewan Eksekutif.
Dialogue: 0,0:10:46.92,0:10:50.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin saja para sisi gelap\Nakan datang kemari.
Dialogue: 0,0:10:50.46,0:10:52.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ada masalah,
Dialogue: 0,0:10:52.88,0:10:55.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tolong lindungi aku, Kyo.
Dialogue: 0,0:10:56.26,0:10:57.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:10:57.55,0:11:01.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kabarnya, yang akan beraksi kali ini
Dialogue: 0,0:11:01.60,0:11:04.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah tim bernama ITEM.
Dialogue: 0,0:11:22.41,0:11:26.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya kita perlu datang\Nsuper mencolok begini?
Dialogue: 0,0:11:26.37,0:11:30.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mau ke lantai 38 dari lantai 40,\Ncara ini paling cepat.
Dialogue: 0,0:11:30.50,0:11:33.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cara mencolok akan mempercepat pekerjaan.
Dialogue: 0,0:11:33.13,0:11:36.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini semacam prosedur khas sisi gelap?
Dialogue: 0,0:11:36.43,0:11:38.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para petugas keamanan
Dialogue: 0,0:11:38.89,0:11:42.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sedang dikecoh Petugas Aksi Terpisah.
Dialogue: 0,0:11:43.22,0:11:47.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua yang muncul nanti adalah musuh.
Dialogue: 0,0:11:47.52,0:11:50.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Super mudah dimengerti.
Dialogue: 0,0:11:51.44,0:11:52.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gagal.
Dialogue: 0,0:11:52.27,0:11:54.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah ada laporan penyusupan dari atap,
Dialogue: 0,0:11:54.86,0:11:58.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}saluran ke lantai lain\Ndan saluran eksternal juga putus.
Dialogue: 0,0:11:58.28,0:12:00.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sistem gedung sudah diambil alih?
Dialogue: 0,0:12:00.49,0:12:02.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil kita kabur.
Dialogue: 0,0:12:02.28,0:12:04.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenanglah.
Dialogue: 0,0:12:04.08,0:12:08.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyerangan ini sudah diduga, kan?\NMakanya kalian di sini.
Dialogue: 0,0:12:08.17,0:12:11.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi lawan kita punya esper\Nberlevel tinggi, kan?
Dialogue: 0,0:12:11.42,0:12:13.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita juga punya esper berlevel tinggi.
Dialogue: 0,0:12:13.96,0:12:17.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudmu, bocah sulit berdiri itu?
Dialogue: 0,0:12:17.09,0:12:19.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemampuannya tetap lancar, kok.
Dialogue: 0,0:12:19.97,0:12:20.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetap saja...
Dialogue: 0,0:12:20.97,0:12:25.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kehilangan kontak dengan kita,\Nbantuan pihak luar pasti datang.
Dialogue: 0,0:12:25.60,0:12:26.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ditambah,
Dialogue: 0,0:12:26.64,0:12:29.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ini situasi membunuh atau dibunuh.
Dialogue: 0,0:12:29.77,0:12:32.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah sisi gelap, kan?
Dialogue: 0,0:12:33.98,0:12:35.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pintunya dikunci.
Dialogue: 0,0:12:35.94,0:12:37.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Frenda.
Dialogue: 0,0:12:37.03,0:12:39.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa boleh buat kalau kunci biasa.
Dialogue: 0,0:12:40.49,0:12:43.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Frenda juga berjuang keras.
Dialogue: 0,0:12:44.91,0:12:47.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, akan kubuka.
Dialogue: 0,0:12:47.08,0:12:48.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kinuhata.
Dialogue: 0,0:12:48.16,0:12:50.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku paham betul.
Dialogue: 0,0:12:56.21,0:13:00.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf saja, kami dilarang ragu\Nkalau melawan esper.
Dialogue: 0,0:13:16.73,0:13:20.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takitsubo, kayak ada bau enak, ya?
Dialogue: 0,0:13:22.49,0:13:26.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin sampel krim tubuh\Nyang kudapat dari spa tadi?
Dialogue: 0,0:13:28.41,0:13:30.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dapat begituan juga?
Dialogue: 0,0:13:30.46,0:13:32.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti aku juga mau pakai, ah.
Dialogue: 0,0:13:34.13,0:13:39.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan mengobrol kayak wanita karier\Nyang pulang lembur, dong.
Dialogue: 0,0:13:39.09,0:13:40.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mugino.
Dialogue: 0,0:13:40.05,0:13:41.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:13:47.97,0:13:52.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kinuhata, ada yang pura-pura mati, tahu.
Dialogue: 0,0:13:52.23,0:13:53.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:13:53.85,0:13:55.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan lengah, Kinuhata.
Dialogue: 0,0:13:55.81,0:13:57.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, iya.
Dialogue: 0,0:13:57.15,0:14:00.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lain kali, akan kuhajar lebih keras.
Dialogue: 0,0:14:05.87,0:14:08.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Profesor Janomichi ada di belakangku.
Dialogue: 0,0:14:09.20,0:14:12.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisakah kamu pulang saja, Mbak?
Dialogue: 0,0:14:12.29,0:14:13.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu juga.
Dialogue: 0,0:14:13.92,0:14:17.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Kalau enggak mau terluka,\Nmenyingkir dari sana."
Dialogue: 0,0:14:17.96,0:14:23.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mau aku mengatakan\Ndialog film kelas B begitu?
Dialogue: 0,0:14:23.13,0:14:24.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak...
Dialogue: 0,0:14:26.14,0:14:28.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, ternyata kamu "Mas".
Dialogue: 0,0:14:28.72,0:14:32.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kamu bilang begitu\Nsambil lihat ke mana?
Dialogue: 0,0:14:32.23,0:14:34.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bocah kampret!
Dialogue: 0,0:14:35.65,0:14:37.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi dia pengawal yang dimaksud?
Dialogue: 0,0:14:37.98,0:14:38.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar aku tes dulu—
Dialogue: 0,0:14:42.90,0:14:44.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perubahan unsur?
Dialogue: 0,0:14:44.45,0:14:46.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemampuan untuk mengganggu unsur?
Dialogue: 0,0:14:46.87,0:14:49.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya sudah, tinggal kuserang langsung!
Dialogue: 0,0:14:50.87,0:14:51.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini...
Dialogue: 0,0:14:52.41,0:14:55.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nitrogen yang terkompresi\Nberubah jadi bunga?
Dialogue: 0,0:14:55.04,0:14:59.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, unsur di sekitarmu\Njadi terlibat juga.
Dialogue: 0,0:14:59.96,0:15:01.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, baguslah!
Dialogue: 0,0:15:03.01,0:15:04.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:15:04.17,0:15:07.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Profesor memercayakanku\Nmenjaga tempat ini.
Dialogue: 0,0:15:08.35,0:15:09.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar mons—
Dialogue: 0,0:15:11.93,0:15:14.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemampuanku bisa digunakan, tapi...
Dialogue: 0,0:15:14.85,0:15:18.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh? Tadi itu tembok\Nyang tidak tertembus?
Dialogue: 0,0:15:18.69,0:15:21.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kinuhata, kamu terlalu memaksa.
Dialogue: 0,0:15:21.28,0:15:22.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, maaf.
Dialogue: 0,0:15:22.40,0:15:27.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, bagaimana kalau aku pakai ini?
Dialogue: 0,0:15:27.61,0:15:30.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah cahaya apa itu,
Dialogue: 0,0:15:30.28,0:15:34.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi sepertinya akan berubah juga\Nseperti yang lain.
Dialogue: 0,0:15:34.50,0:15:37.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak tahu, kok bisa bilang begitu?
Dialogue: 0,0:15:37.67,0:15:39.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bakal cepat mati kalau di sisi gelap.
Dialogue: 0,0:15:40.46,0:15:41.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:15:41.75,0:15:43.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan, masih ada waktu.
Dialogue: 0,0:15:46.13,0:15:49.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian disiksa di tempat ini, kan?
Dialogue: 0,0:15:49.55,0:15:53.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu mau menyingkir,\Nkami bisa menyelamatkan kalian.
Dialogue: 0,0:15:54.02,0:15:55.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya, kemarilah.
Dialogue: 0,0:15:57.14,0:16:01.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mbak ini akan mencarikan\Ntempat yang cocok untukmu.
Dialogue: 0,0:16:01.82,0:16:02.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei!
Dialogue: 0,0:16:03.19,0:16:04.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu
Dialogue: 0,0:16:04.19,0:16:05.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mustahil.
Dialogue: 0,0:16:05.69,0:16:06.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:16:06.65,0:16:08.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa!
Dialogue: 0,0:16:08.45,0:16:12.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena anak lainnya disandera?
Dialogue: 0,0:16:12.70,0:16:14.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami cuma perlu menolong mereka, kan?
Dialogue: 0,0:16:14.62,0:16:15.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:16:15.58,0:16:17.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kami tolong.
Dialogue: 0,0:16:17.25,0:16:21.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Supaya kamu tidak perlu\Nmelindungi CEO itu lagi.
Dialogue: 0,0:16:22.92,0:16:25.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa masih ragu?
Dialogue: 0,0:16:25.38,0:16:30.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buat apa melindungi bajingan\Nyang sudah menyiksa anak kecil.
Dialogue: 0,0:16:30.84,0:16:34.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Didiamkan malah kelewatan.
Dialogue: 0,0:16:34.56,0:16:39.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia yang melindungiku\Natas rasa terima kasih.
Dialogue: 0,0:16:39.02,0:16:41.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, kan, Kyo?
Dialogue: 0,0:16:42.31,0:16:43.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:16:44.44,0:16:48.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi kamu CEO yang haus perhatian\Ntapi pengecut, ya?
Dialogue: 0,0:16:48.11,0:16:49.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi ingin membunuhmu
Dialogue: 0,0:16:49.89,0:16:51.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}meski tidak diperintah atasan.
Dialogue: 0,0:16:51.78,0:16:56.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang-orang terpilih sepertimu\Ntidak akan mengerti,
Dialogue: 0,0:16:56.33,0:16:58.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mugino Shizuri.
Dialogue: 0,0:16:58.04,0:17:00.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, peringkat 4 di Kota Akademi,
Dialogue: 0,0:17:00.58,0:17:03.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meltdowner.
Dialogue: 0,0:17:03.04,0:17:05.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan tembak.
Dialogue: 0,0:17:05.25,0:17:08.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu akan jadi poin pembuka\Nbuat presentasiku.
Dialogue: 0,0:17:08.17,0:17:13.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan bilang, "Inilah teori\Nyang bisa mengalahkan esper level tinggi!"
Dialogue: 0,0:17:13.80,0:17:16.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Offense Armor milik esper level 4,
Dialogue: 0,0:17:16.57,0:17:18.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kinuhata Saiai,
Dialogue: 0,0:17:18.02,0:17:20.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}manipulasi nitrogen sesuka hati.
Dialogue: 0,0:17:20.23,0:17:23.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, sia-sia saja di depan Kyo.
Dialogue: 0,0:17:23.02,0:17:26.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemampuan Takitsubo Rikou\Nyang juga level 4,
Dialogue: 0,0:17:26.42,0:17:28.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah AIM Stalker.
Dialogue: 0,0:17:28.94,0:17:33.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Merekam dan melacak medan difusi AIM\Nyang dipancarkan esper.
Dialogue: 0,0:17:33.53,0:17:36.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harusnya kamu jadi agen penarget\Nuntuk membantu Mugino.
Dialogue: 0,0:17:36.79,0:17:39.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya kali ini\Nkamu tidak akan berguna.
Dialogue: 0,0:17:39.08,0:17:40.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bocor semua.
Dialogue: 0,0:17:40.83,0:17:45.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meltdowner milikmu\Nbisa menembakkan elektron
Dialogue: 0,0:17:45.54,0:17:49.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk menghasilkan hambatan kuat\Ndan membakar objek yang disinari secara paksa.
Dialogue: 0,0:17:49.09,0:17:53.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemampuanmu yang hebat,\Ntapi tidak lebih.
Dialogue: 0,0:17:54.39,0:17:58.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya peringkatmu lebih rendah\Ndari Electromaster yang sama-sama
Dialogue: 0,0:17:58.77,0:18:00.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}punya kemampuan listrik.
Dialogue: 0,0:18:00.18,0:18:02.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belakangan ini,
Dialogue: 0,0:18:02.14,0:18:05.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}julukannya berubah jadi Railgun, ya?
Dialogue: 0,0:18:05.65,0:18:10.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu orang lagi, Frenda Seivelun.\NLevel 0, tidak punya kemampuan.
Dialogue: 0,0:18:10.82,0:18:13.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski terampil menggunakan bom,
Dialogue: 0,0:18:13.78,0:18:16.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia tidak ikut karena tidak berguna, ya?
Dialogue: 0,0:18:19.49,0:18:21.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tangganya
Dialogue: 0,0:18:21.08,0:18:23.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}benar-benar menyiksa!
Dialogue: 0,0:18:24.96,0:18:26.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berdasarkan info yang kuterima,
Dialogue: 0,0:18:26.46,0:18:31.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}semua yang tidak mengawal,\Nmalah jadi pengikat untuk si pengawal.
Dialogue: 0,0:18:31.51,0:18:33.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asuransi super, ya?
Dialogue: 0,0:18:33.76,0:18:34.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:18:34.97,0:18:39.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemudian berdasarkan yang baru kuselidiki,\Nselain sistem keamanan gedung tersebut,
Dialogue: 0,0:18:39.64,0:18:43.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}terdapat sistem independen\Nyang dipasang di lantai 38,
Dialogue: 0,0:18:43.52,0:18:45.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di tempat Janomichi Cures berada.
Dialogue: 0,0:18:45.69,0:18:48.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau memang terjadi sesuatu...
Dialogue: 0,0:18:48.23,0:18:50.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kamu belum bisa\Nmenghubungi atasan?
Dialogue: 0,0:18:50.98,0:18:52.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum.
Dialogue: 0,0:18:52.15,0:18:54.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial, bahkan respons\Nrobot keamanan juga...
Dialogue: 0,0:19:04.83,0:19:07.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial! Apa-apaan?
Dialogue: 0,0:19:08.67,0:19:12.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujungnya, hari ini tetap saja sial.
Dialogue: 0,0:19:14.26,0:19:16.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian sudah mengerti, kan?
Dialogue: 0,0:19:16.51,0:19:20.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di hadapan Kyo, kemampuan\Ndan senjata apa pun percuma.
Dialogue: 0,0:19:20.56,0:19:23.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil kalian bisa membunuhku.
Dialogue: 0,0:19:24.85,0:19:29.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu malah terdengar\Nminta cepat dibunuh.
Dialogue: 0,0:19:29.19,0:19:30.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mugino.
Dialogue: 0,0:19:30.40,0:19:32.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyusupan sukses.
Dialogue: 0,0:19:32.19,0:19:34.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, tunggu!\NMasih kurang satu anak!
Dialogue: 0,0:19:34.78,0:19:35.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:19:35.65,0:19:38.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujungnya, cuma ada tiga anak!
Dialogue: 0,0:19:38.49,0:19:41.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sini tiga, di situ satu.\NMana sisanya?
Dialogue: 0,0:19:41.74,0:19:44.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, yang di bawah sudah ketemu, ya.
Dialogue: 0,0:19:44.33,0:19:48.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya yang di sana memang\Nsulit disuruh bergerak.
Dialogue: 0,0:19:48.88,0:19:50.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja, Kyo.
Dialogue: 0,0:19:50.92,0:19:54.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Temanmu yang sehat\Nada di tempat teraman sedunia,
Dialogue: 0,0:19:54.63,0:19:56.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yaitu di belakangmu.
Dialogue: 0,0:20:00.30,0:20:02.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah cukup, Frenda.
Dialogue: 0,0:20:03.27,0:20:05.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah kasih kesempatan, kan?
Dialogue: 0,0:20:05.10,0:20:06.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mugino?
Dialogue: 0,0:20:09.52,0:20:10.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudmu?
Dialogue: 0,0:20:11.11,0:20:12.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minggir, Takitsubo.
Dialogue: 0,0:20:12.65,0:20:14.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih ada kesempatan.
Dialogue: 0,0:20:14.40,0:20:15.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:20:15.32,0:20:17.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan ucapan lembekmu itu?
Dialogue: 0,0:20:17.20,0:20:20.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mau kumusnahkan juga, Takitsubo?
Dialogue: 0,0:20:21.41,0:20:24.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takitsubo, jangan gunakan itu.
Dialogue: 0,0:20:24.24,0:20:26.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak lembek.
Dialogue: 0,0:20:27.00,0:20:30.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus menggunakannya\Nmeski harus berkorban nyawa.
Dialogue: 0,0:20:30.54,0:20:31.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cih!
Dialogue: 0,0:20:32.84,0:20:36.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau anak kecilnya sepenting itu,\Nakan kuberikan.
Dialogue: 0,0:20:36.38,0:20:39.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi biarkan aku pergi dari Kota Akademi.
Dialogue: 0,0:20:39.55,0:20:44.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ambisi para peneliti di sini terlalu lemah!
Dialogue: 0,0:20:44.10,0:20:49.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak pantas diperlakukan\Nserupa dengan rakyat jelata itu!
Dialogue: 0,0:20:49.44,0:20:51.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus lebih diapresiasi.
Dialogue: 0,0:20:51.90,0:20:54.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penelitianku akan dilihat seluruh dunia,
Dialogue: 0,0:20:54.52,0:20:56.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- diperhatikan, dikagumi...
Dialogue: 0,0:20:56.11,0:20:58.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- diperhatikan, dikagumi...\N- Mugino, 20 senti ke atas.
Dialogue: 0,0:21:05.95,0:21:07.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar.
Dialogue: 0,0:21:07.16,0:21:11.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan gila pengakuan di usia setua itu,
Dialogue: 0,0:21:11.04,0:21:12.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paman.
Dialogue: 0,0:21:14.50,0:21:16.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu dengar?
Dialogue: 0,0:21:16.63,0:21:18.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang di sini sudah beres.
Dialogue: 0,0:21:19.55,0:21:22.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Susah payah merancang strategi,
Dialogue: 0,0:21:22.23,0:21:24.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tahunya malah blunder.
Dialogue: 0,0:21:24.43,0:21:26.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana ini, Frenda?
Dialogue: 0,0:21:26.31,0:21:30.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu harus dihukum.
Dialogue: 0,0:21:31.19,0:21:33.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mati aku...
Dialogue: 0,0:21:36.73,0:21:38.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus untuk kemarin.
Dialogue: 0,0:21:38.86,0:21:40.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Upahnya sudah kutransfer.
Dialogue: 0,0:21:40.78,0:21:44.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku potong sedikit\Nuntuk yang kamu minta.
Dialogue: 0,0:21:44.20,0:21:45.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu.
Dialogue: 0,0:21:45.87,0:21:48.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Uang itu kamu alokasikan\Ndengan benar, kan?
Dialogue: 0,0:21:48.08,0:21:49.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja.
Dialogue: 0,0:21:49.25,0:21:51.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka berlima dalam pengobatan.
Dialogue: 0,0:21:51.75,0:21:54.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya, harus kita awasi\Nsampai bisa jalan.
Dialogue: 0,0:21:54.83,0:21:57.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rumah mereka yang berikutnya\Njuga sudah ditentukan.
Dialogue: 0,0:21:57.71,0:22:00.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja, mereka akan tetap berlima.
Dialogue: 0,0:22:00.01,0:22:00.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:22:00.92,0:22:03.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tapi, apa sebenarnya kemampuan\N- Baiklah, akan aku urus seterusnya.
Dialogue: 0,0:22:03.24,0:22:05.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- si Pengawal itu?\N- Tolong, ya.
Dialogue: 0,0:22:05.39,0:22:08.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu kemampuan memisahkan inti\Ndari sebuah atom
Dialogue: 0,0:22:08.31,0:22:10.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan mengubahnya jadi atom lain.
Dialogue: 0,0:22:11.52,0:22:14.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya itu tidak mempan ke Mugino.
Dialogue: 0,0:22:14.81,0:22:18.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meltdowner punya kemampuan\Nuntuk meluncurkan elektron
Dialogue: 0,0:22:18.48,0:22:21.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dalam bentuk murni tanpa bergantung\Npada atom atau ion lain.
Dialogue: 0,0:22:23.86,0:22:26.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka berlima sangat akrab, ya.
Dialogue: 0,0:22:26.95,0:22:30.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuharap anak-anak itu\Nbisa bersama selamanya.
Dialogue: 0,0:22:30.91,0:22:33.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya, sudah hampir genap sebulan
Dialogue: 0,0:22:34.25,0:22:36.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sejak Kinuhata bergabung ke ITEM.
Dialogue: 0,0:22:36.96,0:22:39.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, anak itu juga.
Dialogue: 0,0:22:44.59,0:22:47.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah, malam ini?
Dialogue: 0,0:22:47.35,0:22:50.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anti-Skill mempercepat jadwalnya,\Njadi harus lebih dulu dari mereka?
Dialogue: 0,0:22:51.85,0:22:54.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami harus turun tangan, kan?
Dialogue: 0,0:22:54.19,0:22:58.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untungnya, misi datang saat\Nkita bertiga sedang berkumpul.
Dialogue: 0,0:22:58.82,0:23:01.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, apa targetnya?
Dialogue: 0,0:23:01.86,0:23:05.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Proyek Mei Gelap.
