Dialogue: 0,0:00:03.57,0:00:05.74,sign,,0000,0000,0000,,1 JULI, KOTA AKADEMI, DISTRIK 17
Dialogue: 0,0:02:40.81,0:02:44.02,sign,,0000,0000,0000,,A CERTAIN ITEM OF DARK SIDE
Dialogue: 0,0:11:26.00,0:11:28.37,sign,,0000,0000,0000,,LEVEL 4: BOMBER LANCE, KUROYORU UMIDORI
Dialogue: 0,0:13:27.65,0:13:28.79,sign,,0000,0000,0000,,ITEM.
Dialogue: 0,0:13:45.51,0:13:48.02,sign,,0000,0000,0000,,#2 ANAK BARU, KINUHATA SAIAI
Dialogue: 0,0:13:49.52,0:13:50.98,sign,,0000,0000,0000,,KOTA AKADEMI, DISTRIK 15
Dialogue: 0,0:14:13.47,0:14:14.92,sign,,0000,0000,0000,,LIPUTAN KHUSUS: PENGEMBANGAN
Dialogue: 0,0:14:14.92,0:14:16.55,sign,,0000,0000,0000,,KEMAMPUAN BARU DI KOTA AKADEMI
Dialogue: 0,0:14:24.51,0:14:25.15,sign,,0000,0000,0000,,MEMANGGIL
Dialogue: 0,0:14:25.15,0:14:26.35,sign,,0000,0000,0000,,SEPIKER, KELUARGA
Dialogue: 0,0:18:22.96,0:18:27.12,sign,,0000,0000,0000,,TOKO ALAT OLAHRAGA COUP DE VENT
Dialogue: 0,0:18:33.38,0:18:35.60,sign,,0000,0000,0000,,HARGA: 780.000 YEN
Dialogue: 0,0:21:00.99,0:21:02.55,sign,,0000,0000,0000,,KERANJANG BELANJA
Dialogue: 0,0:21:02.55,0:21:03.20,sign,,0000,0000,0000,,PROSES PEMBAYARAN GAGAL,\NKARTU INI TIDAK DAPAT DIGUNAKAN
Dialogue: 0,0:23:33.44,0:23:34.98,sign,,0000,0000,0000,,ITEM.
Dialogue: 0,0:23:34.98,0:23:35.48,sign,,0000,0000,0000,,A CERTAIN ITEM OF DARK SIDE
Dialogue: 0,0:23:35.48,0:23:39.98,sign,,0000,0000,0000,,EPISODE 3:\NANGGOTA KELIMA, HANANO CHOUBI
Dialogue: 0,0:00:08.78,0:00:11.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujungnya, favoritku memang yang ini.
Dialogue: 0,0:00:12.12,0:00:16.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Air sadah yang ini kurang cocok di lidahku.
Dialogue: 0,0:00:16.00,0:00:17.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lumayan enak, kok.
Dialogue: 0,0:00:17.79,0:00:20.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Airnya sendiri sudah berasa.
Dialogue: 0,0:00:20.00,0:00:21.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, sih.
Dialogue: 0,0:00:21.35,0:00:26.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di kampung halamanku, ada air mineral\Njenis air sadah yang cukup terkenal.
Dialogue: 0,0:00:26.41,0:00:29.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masuk akal kalau ada yang suka.
Dialogue: 0,0:00:29.20,0:00:31.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Air sadah juga cocok buat diet.
Dialogue: 0,0:00:31.79,0:00:34.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi buat rasa buah-buahan,
Dialogue: 0,0:00:34.83,0:00:37.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}rasanya air lunak lebih cocok.
Dialogue: 0,0:00:37.69,0:00:39.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bagaimana, Mugino?
Dialogue: 0,0:00:39.48,0:00:41.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keduanya memang tidak sama.
Dialogue: 0,0:00:41.93,0:00:43.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi yang mana pun boleh.
Dialogue: 0,0:00:45.64,0:00:48.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku malas jalan,\Nlewat jalur belakang saja, ya.
Dialogue: 0,0:00:48.45,0:00:49.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap.
Dialogue: 0,0:00:56.47,0:00:59.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesuai info, area ini tidak dijaga.
Dialogue: 0,0:00:59.61,0:01:03.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesuai rencana, biar aku\Ndan Takitsubo yang duluan.
Dialogue: 0,0:01:03.16,0:01:05.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Frenda, masuklah lewat belakang.
Dialogue: 0,0:01:05.08,0:01:05.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke.
Dialogue: 0,0:01:06.55,0:01:08.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo cepat selesaikan terus pulang.
Dialogue: 0,0:01:08.79,0:01:11.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya bergadang tidak baik buat kulit.
Dialogue: 0,0:02:57.96,0:02:59.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hati-hati sama pijakanmu.
Dialogue: 0,0:02:59.57,0:03:00.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:03:02.90,0:03:03.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mugino.
Dialogue: 0,0:03:11.76,0:03:15.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Sial, seharusnya aku tidak makan roti.\N- Kenapa tidak terbuka?
Dialogue: 0,0:03:15.37,0:03:17.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakiku jadi melar.
Dialogue: 0,0:03:17.09,0:03:21.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masalahmu bukan makanan,\Ntapi kurang olahraga.
Dialogue: 0,0:03:21.19,0:03:25.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, hei, aku yang paling banyak\Nmembantai musuh, lo.
Dialogue: 0,0:03:25.07,0:03:27.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatanmu itu membunuh seketika.
Dialogue: 0,0:03:27.76,0:03:30.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa dihitung sebagai olahraga.
Dialogue: 0,0:03:32.36,0:03:33.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mugino.
Dialogue: 0,0:03:33.16,0:03:34.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu.
Dialogue: 0,0:03:35.25,0:03:36.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mugino! Mugino!
Dialogue: 0,0:03:36.65,0:03:36.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:03:36.99,0:03:39.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pintu keluar masuk sudah kublokir!
Dialogue: 0,0:03:39.09,0:03:44.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujungnya, dokumen kertas\Ndan data komputer kita musnahkan saja?
Dialogue: 0,0:03:44.03,0:03:45.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:03:45.04,0:03:45.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manusianya?
Dialogue: 0,0:03:46.80,0:03:48.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Singkirkan.
Dialogue: 0,0:03:48.79,0:03:50.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa tidak terbuka?
Dialogue: 0,0:03:53.00,0:03:54.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hup.
Dialogue: 0,0:04:01.12,0:04:02.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awas di atas.
Dialogue: 0,0:04:06.17,0:04:07.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Helikopter, ya?
Dialogue: 0,0:04:09.91,0:04:11.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awas di atas.
Dialogue: 0,0:04:11.53,0:04:12.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:04:14.05,0:04:15.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada cairan oranye menetes!
Dialogue: 0,0:04:15.91,0:04:20.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, pekerjaan kali ini\Nlumayan besar, kan?
Dialogue: 0,0:04:20.08,0:04:24.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belilah baju yang sesuai musim\Nkalau sudah ada uangnya.
Dialogue: 0,0:04:25.79,0:04:28.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayak gaun musim panas\Nyang tembus pandang,
Dialogue: 0,0:04:28.80,0:04:31.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau yukata yang terbuka.
Dialogue: 0,0:04:31.40,0:04:34.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujungnya, congsam juga\Nidentik musim panas, kan?
Dialogue: 0,0:04:34.71,0:04:37.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku paling suka jaket olahraga ini.
Dialogue: 0,0:04:38.91,0:04:43.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah gajian, aku mau\Nmendandani Takitsubo sepuasnya!
Dialogue: 0,0:04:43.89,0:04:45.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Frenda?
Dialogue: 0,0:04:45.21,0:04:46.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, Takitsubo.
Dialogue: 0,0:04:54.07,0:04:55.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mugino.
Dialogue: 0,0:04:55.21,0:04:55.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:04:56.56,0:04:59.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bawa Pil Kristal, nih.
Dialogue: 0,0:05:00.47,0:05:03.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Target kita bukan esper, simpan saja.
Dialogue: 0,0:05:03.56,0:05:06.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula target kali ini kayaknya dewasa.
Dialogue: 0,0:05:06.83,0:05:08.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhen—
Dialogue: 0,0:05:11.13,0:05:14.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, kamu Tuan Profesor, ya?
Dialogue: 0,0:05:15.29,0:05:18.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sang ahli eksperimen memakai anak-anak.
Dialogue: 0,0:05:18.60,0:05:20.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tu-Tunggu!
Dialogue: 0,0:05:20.16,0:05:24.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kalian boleh berbuat sesuka hati, kok!
Dialogue: 0,0:05:24.63,0:05:25.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:05:26.01,0:05:29.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihatlah! Aku menyerah!\NAku tidak melawan!
Dialogue: 0,0:05:31.13,0:05:35.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu esper level tinggi,\Nalias masih anak-anak!
Dialogue: 0,0:05:35.15,0:05:38.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian pahlawan yang tidak\Nterikat organisasi, kan?
Dialogue: 0,0:05:39.67,0:05:43.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian tidak terima\Nmelihat penelitian kejam ini, ya?
Dialogue: 0,0:05:43.51,0:05:46.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau kalian iba ke anak-anak\Nyang jadi percobaan?
Dialogue: 0,0:05:46.08,0:05:47.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kira-kira begitu, kan?
Dialogue: 0,0:05:47.96,0:05:50.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bakal mundur dan pensiun dini!
Dialogue: 0,0:05:50.96,0:05:54.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau memang tidak suka\Nnyawa orang disepelekan,
Dialogue: 0,0:05:54.72,0:05:56.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}meski aku penjahat,
Dialogue: 0,0:05:56.05,0:06:01.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalian pasti tidak tega membunuh\Nkalau kami tidak melawan, kan?
Dialogue: 0,0:06:01.47,0:06:03.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, kamu kira begitu?
Dialogue: 0,0:06:05.09,0:06:07.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu! Aku menyerah!
Dialogue: 0,0:06:09.41,0:06:12.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf saja, pekerjaan kami tidak begitu.
Dialogue: 0,0:06:12.69,0:06:13.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pekerjaan?
Dialogue: 0,0:06:13.51,0:06:17.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebentar lagi pahlawan yang asli datang,
Dialogue: 0,0:06:17.07,0:06:21.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi kami harus menghapus bukti\Nsebelum terkuak dan jadi ricuh.
Dialogue: 0,0:06:22.31,0:06:25.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah pekerjaan kotor kami.
Dialogue: 0,0:06:25.94,0:06:31.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan juga, termasuk informasi\Ndi kepala seseorang.
Dialogue: 0,0:06:34.71,0:06:35.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, ya.
Dialogue: 0,0:06:36.19,0:06:38.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau saja ada esper mental level 5 di sini,
Dialogue: 0,0:06:38.87,0:06:41.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin penjahat sepertimu
Dialogue: 0,0:06:41.20,0:06:45.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa diubah ingatannya\Nbiar hidup dari nol lagi.
Dialogue: 0,0:06:45.76,0:06:48.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mugino, ada sesuatu di sana.
Dialogue: 0,0:06:48.80,0:06:51.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin tidak begitu penting, sih.
Dialogue: 0,0:06:51.29,0:06:52.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu, ya?
Dialogue: 0,0:06:52.27,0:06:54.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujungnya itu, kan?
Dialogue: 0,0:06:54.04,0:06:58.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangankan ruangannya,\Npintu masuknya pun disembunyikan.
Dialogue: 0,0:06:58.25,0:07:00.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, beri aku lima menit.
Dialogue: 0,0:07:00.36,0:07:02.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu sampai semua orang kubunuh.
Dialogue: 0,0:07:07.48,0:07:11.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang, konsol gim\Nzaman sekarang itu canggih!
Dialogue: 0,0:07:11.52,0:07:14.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada gim fitnes yang bisa\Nbantu kelola kesehatan juga!
Dialogue: 0,0:07:16.32,0:07:19.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya mending daftar gim\Nbintang lima saja?
Dialogue: 0,0:07:19.72,0:07:22.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayak pilates atau hot yoga.
Dialogue: 0,0:07:22.21,0:07:23.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duh, duh, duh.
Dialogue: 0,0:07:23.37,0:07:27.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mugino, ujungnya, ini tujuannya diet—
Dialogue: 0,0:07:27.61,0:07:28.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:07:30.00,0:07:32.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi membentuk tubuh wanita dewasa\Nyang anggun dan menawan!
Dialogue: 0,0:07:32.99,0:07:36.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau harus menyisihkan\Nwaktu cuma buat itu,
Dialogue: 0,0:07:36.53,0:07:38.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ujungnya bakal sulit juga!
Dialogue: 0,0:07:38.63,0:07:44.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kita dibelenggu stres,\Nakan sulit kerja di bidang ini, kan?
Dialogue: 0,0:07:44.07,0:07:48.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya, aku mau perangkat lunak senam\Nyang latihannya sudah lengkap
Dialogue: 0,0:07:48.76,0:07:50.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dalam satu konsol gim!
Dialogue: 0,0:07:50.75,0:07:53.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku paling benci sama hal ribet!
Dialogue: 0,0:07:58.51,0:08:01.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujungnya, mereka dibekukan\Npakai cold sleep,
Dialogue: 0,0:08:01.47,0:08:04.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi detak jantung dan napasnya\Ntidak terdeteksi.
Dialogue: 0,0:08:04.84,0:08:09.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesuai isi dokumen,\Nsemuanya cuma loker manusia.
Dialogue: 0,0:08:09.48,0:08:13.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Intinya, mereka target\Nyang harus dilenyapkan
Dialogue: 0,0:08:13.31,0:08:16.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}demi menutup rapat\NProyek Mei Kegelapan.
Dialogue: 0,0:08:16.17,0:08:20.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau musuh tidak berdaya begini,\Naku jadi tidak semangat.
Dialogue: 0,0:08:21.72,0:08:22.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana?
Dialogue: 0,0:08:22.64,0:08:25.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujungnya, mau diledakkan semua?
Dialogue: 0,0:08:25.05,0:08:26.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:08:26.20,0:08:28.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo bawa buat oleh-oleh.
Dialogue: 0,0:08:28.25,0:08:30.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, satu orang saja cukup.
Dialogue: 0,0:08:31.67,0:08:35.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya kita diminta melenyapkan\Nsemua berkas dan manusia?
Dialogue: 0,0:08:35.45,0:08:37.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buat apa menurut banget?
Dialogue: 0,0:08:38.13,0:08:39.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, sih.
Dialogue: 0,0:08:39.59,0:08:42.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi bukan karena kenaifan\Ningin menolong orang, kan?
Dialogue: 0,0:08:42.84,0:08:44.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujungnya, apa alasanmu?
Dialogue: 0,0:08:44.67,0:08:46.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alasan pertama.
Dialogue: 0,0:08:46.99,0:08:50.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita disuruh melenyapkan data\Nyang gawat kalau terpublikasi.
Dialogue: 0,0:08:51.28,0:08:54.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di dokumen memang tertulis "target,"\Ntapi faktanya
Dialogue: 0,0:08:54.80,0:08:59.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mereka bahkan tidak tahu\Nkondisi di sini secara spesifik.
Dialogue: 0,0:08:59.50,0:09:02.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya anak-anak ini\Ntidak dianggap penting.
Dialogue: 0,0:09:03.31,0:09:05.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ingatlah detail pekerjaannya.
Dialogue: 0,0:09:05.64,0:09:09.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tim peneliti dan petugas keamanan\Nmemang perlu dibantai,
Dialogue: 0,0:09:09.09,0:09:11.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi para subjek percobaan\Ntidak disebut, kan?
Dialogue: 0,0:09:12.99,0:09:16.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, kita tidak wajib\Nmembunuh mereka.
Dialogue: 0,0:09:17.53,0:09:18.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:09:19.43,0:09:21.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takitsubo pelacak yang berharga,
Dialogue: 0,0:09:22.04,0:09:24.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi dia tidak bisa bertarung.
Dialogue: 0,0:09:24.49,0:09:29.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meltdowner milikku daya bunuhnya\Nterlalu besar, tidak cocok buat bertahan.
Dialogue: 0,0:09:29.01,0:09:30.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk menambal itu,
Dialogue: 0,0:09:30.85,0:09:35.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku merekrut kamu yang dirumorkan\Nsebagai level 0 yang bisa diandalkan.
Dialogue: 0,0:09:35.73,0:09:39.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi tahunya kamu spesialis bom,\Nbukan bela diri.
Dialogue: 0,0:09:40.97,0:09:43.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum pas jadi spesialis bertahan.
Dialogue: 0,0:09:43.57,0:09:47.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi kebetulan,\Nbanyak barang bagus di sini.
Dialogue: 0,0:09:47.25,0:09:51.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mugino, intinya kamu butuh\Nspesialis pertahanan?
Dialogue: 0,0:09:51.89,0:09:54.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Proyek Mei Kegelapan.
Dialogue: 0,0:09:54.85,0:10:00.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para esper imitasi tingkat tinggi\Nyang ditanami pola pikir Accelerator,
Dialogue: 0,0:10:00.28,0:10:02.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sang peringkat 1 di Kota Akademi.
Dialogue: 0,0:10:03.25,0:10:07.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, entah seberapa jauh mereka\Nbisa menyalin kemampuannya.
Dialogue: 0,0:10:07.96,0:10:11.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Punya kemampuan\Nrefleksnya saja sudah hoki.
Dialogue: 0,0:10:11.47,0:10:14.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lumayan oke buat jadi tamengmu, kan?
Dialogue: 0,0:10:16.96,0:10:21.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karya paling sukses di proyek ini\Nada dua subjek.
Dialogue: 0,0:10:22.24,0:10:23.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keduanya level 4.
Dialogue: 0,0:10:24.31,0:10:28.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kinuhata Saiai yang bisa bertahan\Nmemakai nitrogen lewat Offense Armor
Dialogue: 0,0:10:28.41,0:10:33.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan Kuroyoru Umidori yang bisa menyerang\Npakai nitrogen lewat Bomber Lance.
Dialogue: 0,0:10:33.92,0:10:35.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujungnya, bangkitkan yang mana?
Dialogue: 0,0:10:36.85,0:10:38.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si Tameng.
Dialogue: 0,0:10:39.40,0:10:41.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mugino, ada handuk, nih.
Dialogue: 0,0:10:44.64,0:10:45.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo.
Dialogue: 0,0:10:45.83,0:10:49.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namamu Kinuhata Saiai, kan?
Dialogue: 0,0:10:49.05,0:10:51.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu paham situasinya?
Dialogue: 0,0:10:52.56,0:10:54.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tidak menjerit.
Dialogue: 0,0:10:54.60,0:10:57.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bahkan enggak sadar lagi bugil.
Dialogue: 0,0:10:57.85,0:11:01.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Otaknya belum bekerja\Nkarena darahnya baru dicairkan.
Dialogue: 0,0:11:02.05,0:11:03.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:11:04.44,0:11:07.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mugino, arah barat daya ricuh.
Dialogue: 0,0:11:07.36,0:11:09.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus pergi.
Dialogue: 0,0:11:09.44,0:11:13.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, ternyata kinerja si Anti-Skill Biasa
Dialogue: 0,0:11:13.71,0:11:15.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa lebih cepat dari perkiraan, ya.
Dialogue: 0,0:11:15.41,0:11:17.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo mundur teratur dalam 180 detik!
Dialogue: 0,0:11:17.51,0:11:18.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:11:18.21,0:11:21.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, ujungnya, para subjek\Nyang masih beku ini mau diapakan?
Dialogue: 0,0:11:21.97,0:11:23.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih ada banyak, tuh!
Dialogue: 0,0:11:24.08,0:11:26.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu alasan keduaku.
Dialogue: 0,0:11:26.00,0:11:28.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pas banget kalau ada pelakunya.
Dialogue: 0,0:11:28.37,0:11:29.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelaku?
Dialogue: 0,0:11:29.76,0:11:32.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atur pencairannya ke mode lambat.
Dialogue: 0,0:11:32.73,0:11:37.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu Anti-Skill menerobos masuk\Ntepat saat bocah ini terbangun,
Dialogue: 0,0:11:37.29,0:11:40.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bocah yang baru mencair\Ndan otaknya belum jalan ini
Dialogue: 0,0:11:40.96,0:11:45.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan mengira bahwa amukan darinya\Nyang membuat labnya hancur.
Dialogue: 0,0:11:45.17,0:11:48.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujungnya, masa semulus itu?
Dialogue: 0,0:11:48.12,0:11:50.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dia diperlakukan seburuk ini,
Dialogue: 0,0:11:50.90,0:11:54.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}seharusnya ada motif dendam yang logis.
Dialogue: 0,0:11:54.91,0:11:58.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kredit terbesarnya kita berikan saja\Nke si Pembalas Dendam ini.
Dialogue: 0,0:11:58.81,0:12:02.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agar kita bisa kabur dengan aman\Nmeski telah membantai banyak orang.
Dialogue: 0,0:12:02.77,0:12:08.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, riwayat waktu pencairannya\Nkuubah ke satu jam yang lalu buat jaga-jaga.
Dialogue: 0,0:12:09.01,0:12:13.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beda spesifikasi kemampuanmu\Ndengan tombak nitrogen bocah itu
Dialogue: 0,0:12:13.55,0:12:16.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}seharusnya meninggalkan\Nbekas kerusakan yang berbeda.
Dialogue: 0,0:12:16.72,0:12:18.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang paham pasti tahu.
Dialogue: 0,0:12:18.60,0:12:20.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu yang kuincar.
Dialogue: 0,0:12:22.04,0:12:24.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau menyembunyikan\Nkejadian ini dengan sempurna,
Dialogue: 0,0:12:24.84,0:12:29.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita jadi tidak bisa membuktikan\Nkalau sudah menyelesaikan pekerjaan, kan?
Dialogue: 0,0:12:29.72,0:12:34.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya, selama ada petunjuk yang bisa\Ndipahami oleh sisi gelap, itu cukup.
Dialogue: 0,0:12:35.07,0:12:38.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau lupa detail ini,\Nupah kita bisa dipotong
Dialogue: 0,0:12:38.60,0:12:41.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau kena tikung oleh kompetitor asing.
Dialogue: 0,0:12:41.20,0:12:43.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Merebut balik uangnya bakal repot, lo.
Dialogue: 0,0:12:44.96,0:12:49.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo jalan yang benar dan cepat kabur!
Dialogue: 0,0:12:49.16,0:12:51.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sampai ketahuan Anti-Skill
Dialogue: 0,0:12:51.73,0:12:54.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang menjaga kedamaian\NKota Akademi siang dan malam.
Dialogue: 0,0:12:54.69,0:12:59.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya kalau ketahuan, kita harus\Nbantai semua orang! Hati-hati!
Dialogue: 0,0:13:01.01,0:13:06.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujungnya, kekhawatiranmu itu\Nberbanding terbalik dari para penjahat.
Dialogue: 0,0:13:06.61,0:13:07.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat!
Dialogue: 0,0:13:07.31,0:13:11.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasukan yang sudah siap,\Nlangsung masuk!
Dialogue: 0,0:13:15.08,0:13:17.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yey!
Dialogue: 0,0:13:18.60,0:13:20.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Yey.\N- Benaran sempurna!
Dialogue: 0,0:13:20.97,0:13:23.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujungnya, nilainya 100!
Dialogue: 0,0:13:25.19,0:13:27.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa kalian?
Dialogue: 0,0:13:28.79,0:13:31.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang jelas, kami bukan\Npahlawan kebenaran.
Dialogue: 0,0:13:33.57,0:13:36.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, setelah bebas,
Dialogue: 0,0:13:36.87,0:13:38.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bagaimana rasanya?
Dialogue: 0,0:13:44.75,0:13:45.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Super...
Dialogue: 0,0:13:46.01,0:13:47.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh juga.
Dialogue: 0,0:13:58.18,0:13:59.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujungnya, sudah bangun?
Dialogue: 0,0:14:00.87,0:14:05.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, cepat pakai ini!\NKita ada misi penting!
Dialogue: 0,0:14:13.47,0:14:16.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang 1 Juli, pukul 10 pagi.
Dialogue: 0,0:14:16.55,0:14:18.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Seenaknya saja mendeteksi wajah,\N- Berikutnya liputan khusus,
Dialogue: 0,0:14:18.65,0:14:21.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- dan menyiarkan acara yang ogah kulihat.\N- Kota Akademi yang dikenal...
Dialogue: 0,0:14:25.15,0:14:27.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Muda, selamat pagi.
Dialogue: 0,0:14:27.54,0:14:31.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mujinayama, kenapa kamu selalu\Ntelepon ke telepon rumah?
Dialogue: 0,0:14:31.75,0:14:33.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jarang cek pesan suara, lo.
Dialogue: 0,0:14:33.99,0:14:37.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Langsung telepon ponselku saja\Nbiar diangkat.
Dialogue: 0,0:14:37.87,0:14:40.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya tidak berani, Nona Muda.
Dialogue: 0,0:14:40.64,0:14:43.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya hanya pelayan biasa.
Dialogue: 0,0:14:43.64,0:14:48.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menghubungi Nona tanpa perantara\Nterlalu tidak sopan.
Dialogue: 0,0:14:48.58,0:14:52.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Walau saya juga tidak pantas\Nmenelepon ke telepon rumah,
Dialogue: 0,0:14:52.02,0:14:55.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berkat perantara\Ndari pengelola apartemen,
Dialogue: 0,0:14:55.91,0:14:58.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}martabat keluarga masih bisa terjaga.
Dialogue: 0,0:14:58.79,0:15:00.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Martabat, ya.
Dialogue: 0,0:15:00.26,0:15:01.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya sepenting itu?
Dialogue: 0,0:15:01.71,0:15:02.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja.
Dialogue: 0,0:15:02.62,0:15:07.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mugino adalah nama terhormat\Nyang sukses di bidang gandum sejak era Meiji.
Dialogue: 0,0:15:07.00,0:15:10.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu perusahaan pangan\Nyang menopang isi perut
Dialogue: 0,0:15:10.76,0:15:13.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}1,4 miliar orang di dunia.
Dialogue: 0,0:15:14.19,0:15:16.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal cuma komplotan mafia.
Dialogue: 0,0:15:17.10,0:15:18.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, aduh.
Dialogue: 0,0:15:18.40,0:15:23.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekerasan hanyalah salah satu\Nmetode bernegosiasi.
Dialogue: 0,0:15:23.46,0:15:27.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hal untuk dimanfaatkan,\Nbukan penentu keluarga Mugino.
Dialogue: 0,0:15:27.50,0:15:31.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski Nona Muda tinggal jauh\Ndari rumah utama,
Dialogue: 0,0:15:31.04,0:15:34.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mohon selalu ingat kehormatan dan tekad
Dialogue: 0,0:15:34.80,0:15:37.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}anggota keluarga Mugino yang berjaya.
Dialogue: 0,0:15:37.88,0:15:41.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pagi-pagi sudah ceramah halus.
Dialogue: 0,0:15:42.59,0:15:45.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin saya berani.
Dialogue: 0,0:15:45.16,0:15:48.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Adakah perkembangan terbaru,\NNona Muda?
Dialogue: 0,0:15:50.69,0:15:51.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada.
Dialogue: 0,0:15:51.90,0:15:54.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, saya lega.
Dialogue: 0,0:15:54.52,0:15:58.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kan salah satu\Ndari tujuh esper level 5 di sini.
Dialogue: 0,0:15:58.08,0:16:00.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak bakal segampang itu\Nkena masalah.
Dialogue: 0,0:16:00.90,0:16:02.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:16:02.03,0:16:03.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asalkan,
Dialogue: 0,0:16:03.24,0:16:06.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sesama esper level 5\Natau musuh bebuyutan sisi gelap
Dialogue: 0,0:16:06.70,0:16:09.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang peringkat 6 di Kota Akademi itu\Nenggak muncul.
Dialogue: 0,0:16:09.78,0:16:12.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kabar teman-teman Nona hari ini?
Dialogue: 0,0:16:12.43,0:16:13.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entahlah.
Dialogue: 0,0:16:13.63,0:16:15.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paling lagi saling colek di lantai bawah.
Dialogue: 0,0:16:20.51,0:16:23.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa toko ini sepi banget?
Dialogue: 0,0:16:23.92,0:16:27.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jam buka resmi toko ini\Nadalah jam 11 pagi!
Dialogue: 0,0:16:27.42,0:16:29.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu jam sebelum buka.
Dialogue: 0,0:16:29.59,0:16:30.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi sekarang
Dialogue: 0,0:16:30.68,0:16:34.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah jam khusus penghuni apartemen\Nuntuk belanja secara eksklusif!
Dialogue: 0,0:16:34.95,0:16:37.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini disebut jam rahasia!
Dialogue: 0,0:16:37.95,0:16:40.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau nonton itu?
Dialogue: 0,0:16:40.35,0:16:41.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, bukan.
Dialogue: 0,0:16:41.48,0:16:44.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata di sini ada bioskop, toh.
Dialogue: 0,0:16:45.06,0:16:46.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa, sih?
Dialogue: 0,0:16:48.36,0:16:50.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau soal dada,
Dialogue: 0,0:16:50.02,0:16:54.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}padahal aku yang selalu kena ledek!
Dialogue: 0,0:16:54.32,0:16:59.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata ada anak yang kedodoran\Npas pakai baju lungsuranku!
Dialogue: 0,0:16:59.04,0:17:02.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pinjam baju malah berujung\Nucapan nyelekit.
Dialogue: 0,0:17:03.24,0:17:08.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita benaran super bisa belanja di sini?
Dialogue: 0,0:17:08.44,0:17:14.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita ini komplotan penjahat yang dapat\Nuang haram dari pekerjaan kotor, kan?
Dialogue: 0,0:17:14.28,0:17:16.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aman, aman, pokoknya aman!
Dialogue: 0,0:17:17.06,0:17:20.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujungnya, kita baru menuntaskan\Npekerjaan besar.
Dialogue: 0,0:17:20.28,0:17:23.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Upahnya juga ditransfer hari ini,\Njadi jangan khawatir!
Dialogue: 0,0:17:23.79,0:17:24.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah!
Dialogue: 0,0:17:24.99,0:17:28.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saatnya Kartu Hitam impian ini\Ndipakai belanja foya-foya!
Dialogue: 0,0:17:28.86,0:17:32.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bakal pakaikan berbagai\Nmacam pakaian ke gadis polos ini!
Dialogue: 0,0:17:32.18,0:17:36.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si Cabul itu selalu begitu?
Dialogue: 0,0:17:36.35,0:17:39.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Adik perempuan yang selalu mau\Ndidandani olehnya
Dialogue: 0,0:17:39.16,0:17:41.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jatuh sakit karena flu musim panas.
Dialogue: 0,0:17:41.98,0:17:44.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadinya Frenda menahan nafsunya.
Dialogue: 0,0:17:44.60,0:17:50.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bilang bakal meledak\Nkalau stresnya tidak terlampiaskan.
Dialogue: 0,0:17:50.14,0:17:52.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bingung menanggapinya.
Dialogue: 0,0:17:52.55,0:17:58.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Adikku aslinya sudah sembuh,\Ntapi belum bisa diajak jalan jauh.
Dialogue: 0,0:17:58.02,0:18:01.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daripada itu, aku mau\Nmembelikanmu baju buat perayaan.
Dialogue: 0,0:18:01.95,0:18:04.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada permintaan khusus?
Dialogue: 0,0:18:04.47,0:18:08.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau boleh, aku mau baju\Nyang bikin lebih gampang bergerak.
Dialogue: 0,0:18:09.34,0:18:11.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ukuran yang pendek memang bagus,
Dialogue: 0,0:18:11.64,0:18:15.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kalau banyak rendanya\Nmalah terasa menghambat udara.
Dialogue: 0,0:18:15.59,0:18:17.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak nyaman.
Dialogue: 0,0:18:17.24,0:18:20.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti mau gaya yang agak tomboi, ya?
Dialogue: 0,0:18:21.03,0:18:22.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak peduli banget.
Dialogue: 0,0:18:27.12,0:18:31.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau urusan dunia balap sepeda,\Nmemang Prancis jagonya.
Dialogue: 0,0:18:37.99,0:18:39.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Takitsubo!
Dialogue: 0,0:18:39.80,0:18:41.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saatnya mengganti jaket olahraga!
Dialogue: 0,0:18:41.74,0:18:46.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Badan bohaimu dibungkus\Npakai baju balap yang ketat, ya?
Dialogue: 0,0:18:46.50,0:18:49.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, aku bakal dipakaikan\Nbaju warna-warni super ketat
Dialogue: 0,0:18:49.52,0:18:52.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- ala pilot cewek di anime robot.\N- Hei, hei, hei!
Dialogue: 0,0:18:52.66,0:18:55.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa melihat label harganya\Nkalian masih santai?
Dialogue: 0,0:18:55.68,0:19:00.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baju begini bakal gawat\Nkalau perawatannya asal, lo!
Dialogue: 0,0:19:00.59,0:19:06.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan remehkan selebritas tajir jahat\Nyang baru gajian dari misinya, Anak Baru!
Dialogue: 0,0:19:06.00,0:19:08.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujungnya, sudah ketemu yang cocok?
Dialogue: 0,0:19:08.04,0:19:09.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang kamu pegang itu?
Dialogue: 0,0:19:10.40,0:19:11.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, lagian
Dialogue: 0,0:19:11.80,0:19:14.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ini harganya kemahalan.
Dialogue: 0,0:19:14.20,0:19:17.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ayo, cepat masuk ke ruang ganti!\N- Lah?
Dialogue: 0,0:19:17.07,0:19:21.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat menikmati momen ganti baju\Nyang seru tapi malu
Dialogue: 0,0:19:21.34,0:19:24.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di balik sehelai kain tipis yang melambai\Nkalau kena angin AC!
Dialogue: 0,0:19:24.04,0:19:25.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang, ini kemahalan!
Dialogue: 0,0:19:25.64,0:19:27.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku takut memakainya!
Dialogue: 0,0:19:27.71,0:19:32.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu tidak tutup gordennya,\Nkamu bakal ganti baju
Dialogue: 0,0:19:32.92,0:19:36.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan status publik ala medsos\Nyang salah atur privasi, lo!
Dialogue: 0,0:19:36.66,0:19:38.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Super iya, deh!
Dialogue: 0,0:19:39.10,0:19:40.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu terlihat senang, ya?
Dialogue: 0,0:19:41.70,0:19:44.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujungnya, ini sudah tradisi!
Dialogue: 0,0:19:44.56,0:19:50.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak baru ITEM memang harus didandani\Nsenior yang setingkat di atasnya!
Dialogue: 0,0:19:50.86,0:19:52.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya pernah?
Dialogue: 0,0:19:52.58,0:19:54.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pernah!
Dialogue: 0,0:19:54.26,0:19:59.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu itu, aku disuruh memilih antara\Nderetan jaket olahraga polos 72 varian warna!
Dialogue: 0,0:19:59.03,0:20:02.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku trauma kena penguraian Gestalt\Nyang ringan waktu itu!
Dialogue: 0,0:20:02.00,0:20:04.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujungnya, aku masih ingat!
Dialogue: 0,0:20:07.40,0:20:08.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kupakai.
Dialogue: 0,0:20:10.20,0:20:13.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gaya ini belum pernah ada di ITEM.
Dialogue: 0,0:20:13.48,0:20:15.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, jadikan ini dasarnya
Dialogue: 0,0:20:15.44,0:20:18.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan kita variasi pakai campuran\Ngenre lainnya!
Dialogue: 0,0:20:18.52,0:20:20.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Maksudnya?
Dialogue: 0,0:20:20.34,0:20:21.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi!
Dialogue: 0,0:20:21.52,0:20:23.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujungnya, yang lagi dia coba
Dialogue: 0,0:20:23.46,0:20:26.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bakal langsung dipakai,\Ntolong dibuat notanya, ya.
Dialogue: 0,0:20:26.99,0:20:27.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:20:27.67,0:20:29.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tapi, angka nolnya...\N- Hei, Frenda.
Dialogue: 0,0:20:29.95,0:20:32.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, kita lupa\Nbeli celana dalam Kinuhata.
Dialogue: 0,0:20:32.43,0:20:36.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujungnya, itulah bagian terseru hari ini!
Dialogue: 0,0:20:36.74,0:20:39.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Antara lingeri dewasa kayak gim hukuman
Dialogue: 0,0:20:39.32,0:20:42.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau justru gambar anak kucing\Ndi bagian bokong.
Dialogue: 0,0:20:42.10,0:20:45.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kira-kira dia paling malu pakai yang mana?
Dialogue: 0,0:20:46.07,0:20:48.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi sekarang, kamu tidak pakai apa-apa?
Dialogue: 0,0:20:48.35,0:20:49.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bentar!
Dialogue: 0,0:20:49.03,0:20:50.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat, nih.
Dialogue: 0,0:20:51.68,0:20:53.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Apa yang mau kamu lakukan?\N- Permisi, Pelanggan.
Dialogue: 0,0:20:53.51,0:20:55.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kinuhata, ayo gunting saja label harganya.\N- Bisa bicara sebentar?
Dialogue: 0,0:20:55.64,0:20:57.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kinuhata, ayo gunting saja label harganya.\NApa? Apa?
Dialogue: 0,0:20:57.04,0:20:58.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa, sih, tiba-tiba?
Dialogue: 0,0:20:58.92,0:21:00.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok kamu bisa bawa gunting?
Dialogue: 0,0:21:05.32,0:21:07.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf sebelumnya,
Dialogue: 0,0:21:07.74,0:21:11.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mesin EDC di toko kami tidak bisa\Nmemverifikasi kartu ini.
Dialogue: 0,0:21:11.44,0:21:12.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:21:12.00,0:21:14.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujungnya, bukan EDC-nya yang rusak?
Dialogue: 0,0:21:14.98,0:21:17.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau bagian cip IC-nya?
Dialogue: 0,0:21:17.99,0:21:21.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayangnya bukan keduanya.
Dialogue: 0,0:21:21.50,0:21:25.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rekening yang terhubung ke kartu ini\Ntidak bisa digunakan.
Dialogue: 0,0:21:25.51,0:21:29.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Sepertinya dibekukan.\N- Ah, ya ampun!
Dialogue: 0,0:21:30.64,0:21:32.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sudah jadi punya Kinuhata.
Dialogue: 0,0:21:32.46,0:21:34.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Label cucinya digunting juga?
Dialogue: 0,0:21:34.70,0:21:37.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Barangnya jadi enggak bisa diretur lagi.
Dialogue: 0,0:21:37.35,0:21:39.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa harus begitu, sih...
Dialogue: 0,0:21:42.31,0:21:46.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah kenapa, firasatku buruk.
Dialogue: 0,0:23:19.41,0:23:23.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gedung komersial Fifteen Bells\Ndi distrik sekolah 15.
Dialogue: 0,0:23:23.95,0:23:28.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurut suara di telepon,\Nmereka ada di lantai paling atas, kan?
Dialogue: 0,0:23:28.60,0:23:32.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang-orang yang akan menyambutku\Nsebagai anggota baru...
