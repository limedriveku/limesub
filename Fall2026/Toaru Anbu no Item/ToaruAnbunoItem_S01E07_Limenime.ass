Dialogue: 0,0:02:05.90,0:02:08.97,sign,,0000,0000,0000,,A CERTAIN ITEM OF DARK SIDE
Dialogue: 0,0:07:56.66,0:07:59.17,sign,,0000,0000,0000,,GEL PELAPIS ANTI GESEKAN
Dialogue: 0,0:13:30.46,0:13:32.75,sign,,0000,0000,0000,,GEL PELAPIS ANTI GESEKAN
Dialogue: 0,0:15:15.94,0:15:18.98,sign,,0000,0000,0000,,EPISODE 7: ITEM VS ITEM
Dialogue: 0,0:21:40.90,0:21:42.32,sign,,0000,0000,0000,,AKU INGIN MENJADI REKAN PARA ITEM!
Dialogue: 0,0:21:42.32,0:21:43.95,sign,,0000,0000,0000,,SEMOGA KALIAN YANG TELAH MEMUNGUT
Dialogue: 0,0:21:43.95,0:21:45.12,sign,,0000,0000,0000,,DAN MENYELAMATKAN HIDUPKU
Dialogue: 0,0:21:45.12,0:21:48.33,sign,,0000,0000,0000,,MEMBUTUHKAN DIRIKU YANG SEPERTI INI.
Dialogue: 0,0:21:48.33,0:21:49.33,sign,,0000,0000,0000,,HANANO CHOUBI
Dialogue: 0,0:23:35.02,0:23:35.52,sign,,0000,0000,0000,,A CERTAIN ITEM OF DARK SIDE
Dialogue: 0,0:23:35.64,0:23:40.02,sign,,0000,0000,0000,,EPISODE 8: RENCANA
Dialogue: 0,0:00:01.18,0:00:05.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemikiran bahwa kamu bisa melakukan\Napa saja karena punya Meltdowner
Dialogue: 0,0:00:05.24,0:00:10.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}cuma citra semu yang diberikan\Norang-orang dewasa di kota ini, tahu.
Dialogue: 0,0:00:10.62,0:00:15.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu benaran percaya gelarmu\Nsebagai level 5 yang cuma ada 7 orang
Dialogue: 0,0:00:15.33,0:00:19.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di Kota Akademi ini bisa membuatmu\Nmenerobos segala halangan?
Dialogue: 0,0:00:19.46,0:00:22.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pikir sisi gelap kota ini\Nsedangkal itu?
Dialogue: 0,0:00:24.55,0:00:25.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi?
Dialogue: 0,0:00:25.80,0:00:27.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemampuan orang ini...
Dialogue: 0,0:00:27.30,0:00:29.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, kemampuanku bukan listrik, lo.
Dialogue: 0,0:00:30.39,0:00:33.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akulah peringkat 6 Kota Akademi...
Dialogue: 0,0:00:33.01,0:00:33.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:00:33.89,0:00:38.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Musuh bebuyutan sisi gelap\Nyang paling kalian takuti.
Dialogue: 0,0:02:09.44,0:02:12.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keunggulan basi seperti menjadi Level 5
Dialogue: 0,0:02:12.57,0:02:15.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sia-sia di hadapan kami.
Dialogue: 0,0:02:16.48,0:02:18.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak mungkin.
Dialogue: 0,0:02:18.58,0:02:23.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin level 5\Nbisa muncul sebegitu mudahnya!
Dialogue: 0,0:02:23.33,0:02:25.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Musuh bebuyutan sisi gelap\Nyang misterius?
Dialogue: 0,0:02:25.81,0:02:31.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa pun bisa mengaku-aku\Nsebagai peringkat 6 itu!
Dialogue: 0,0:02:31.13,0:02:35.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, ternyata kamu tidak tahu\Nkedalaman sisi gelap?
Dialogue: 0,0:02:35.34,0:02:39.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sisi gelap justru rumah\Nbagi para level 5, kan?
Dialogue: 0,0:02:39.75,0:02:42.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dua peringkat teratas itu\Nsudah jelas sekali.
Dialogue: 0,0:02:42.93,0:02:46.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau si Listrik dan si Mental,\Nbagaimana, ya?
Dialogue: 0,0:02:46.27,0:02:50.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski mereka bukan sisi gelap,\Ndari proyek yang diikuti,
Dialogue: 0,0:02:50.65,0:02:54.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mereka terhitung sudah\Nmenginjakkan satu kaki ke sini.
Dialogue: 0,0:02:54.03,0:02:58.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, harapan terakhir\Ntinggal si Nekat Bego, kan?
Dialogue: 0,0:02:58.20,0:03:04.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa mau bergantung ke manusia ngawur\Ncuma buat membenarkan pandangan kalian?
Dialogue: 0,0:03:05.29,0:03:09.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Musuh bebuyutan sisi gelap\Nternyata hidup di sisi gelap juga?
Dialogue: 0,0:03:09.63,0:03:12.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujungnya, ucapannya masuk akal\Nuntuk Kota Akademi.
Dialogue: 0,0:03:12.88,0:03:16.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu juga tidak bisa sepenuhnya\Nmenyangkalku, kan?
Dialogue: 0,0:03:16.93,0:03:21.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa gunanya cerita yang kalian dengar\Nsoal peringkat 6 Kota Akademi?
Dialogue: 0,0:03:22.39,0:03:27.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pikir info yang kalian punya\Nakan berguna di sini?
Dialogue: 0,0:03:27.44,0:03:29.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bukan gosip, kabar burung,
Dialogue: 0,0:03:29.48,0:03:32.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}maupun legenda mitos.
Dialogue: 0,0:03:32.23,0:03:35.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Faktanya, aku yang menyandang\Ngelar peringkat 6
Dialogue: 0,0:03:35.90,0:03:38.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sedang berada di sini.
Dialogue: 0,0:03:38.70,0:03:43.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sombong cuma gara-gara bisa\Nberdiri selevel denganku, Sampah.
Dialogue: 0,0:03:43.43,0:03:46.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di luar soal peringkat 6\Nitu bualan atau bukan,
Dialogue: 0,0:03:46.25,0:03:48.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia telah membelokkan Meltdowner.
Dialogue: 0,0:03:49.33,0:03:51.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ditambah menjebol atap pula.
Dialogue: 0,0:03:51.13,0:03:54.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan apa yang dia pakai?
Dialogue: 0,0:03:54.09,0:03:54.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mugino.
Dialogue: 0,0:03:55.20,0:03:56.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takitsubo, jangan bergerak!
Dialogue: 0,0:03:56.63,0:03:59.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanano, bawa Takitsubo keluar!
Dialogue: 0,0:03:59.43,0:04:02.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengar, lindungi dia apa pun yang terjadi!
Dialogue: 0,0:04:05.43,0:04:07.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami harus mengulur waktu\Nagar Takitsubo bisa kabur!
Dialogue: 0,0:04:10.02,0:04:11.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang benar saja.
Dialogue: 0,0:04:11.31,0:04:16.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Level 5 peringkat 6 benaran nona muda\Ndari sekolah elite Tokiwadai?
Dialogue: 0,0:04:16.82,0:04:22.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, kalian tampak bingung\Nkarena nona terhormat ada di sisi gelap?
Dialogue: 0,0:04:23.20,0:04:27.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Habisnya, kehidupan nona terhormat\Nbeda jauh dari orang biasa.
Dialogue: 0,0:04:27.66,0:04:30.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan berisik saat berjalan,\Njangan tertawa.
Dialogue: 0,0:04:30.12,0:04:32.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayak lagi melatih ninja saja.
Dialogue: 0,0:04:34.26,0:04:36.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kopernya tidak ada!
Dialogue: 0,0:04:39.34,0:04:41.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak ekskul seni dan atletik itu menghilang!
Dialogue: 0,0:04:43.85,0:04:44.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana ini?
Dialogue: 0,0:04:45.81,0:04:50.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keberadaan kami saja sudah dipaksakan,\Nwajar kalau terasa janggal.
Dialogue: 0,0:04:50.39,0:04:54.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sudah begitu, jarum jamnya\Nperlu dicocokkan kembali.
Dialogue: 0,0:04:54.86,0:04:58.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yaitu dengan mengenal fakta dunia ini\Nseburuk apa pun itu.
Dialogue: 0,0:04:58.65,0:05:01.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bertindak sejauh ini cuma demi\Nmemahami dunia luar?
Dialogue: 0,0:05:02.15,0:05:05.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Prioritas kami adalah\Nkoper berisi uang itu!
Dialogue: 0,0:05:05.12,0:05:07.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mugino yang paling kuat\Nharus mengejarnya!
Dialogue: 0,0:05:07.73,0:05:13.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian seharusnya bersimpati karena aku\Nsampai hancur karena terikat aturan ketat!
Dialogue: 0,0:05:13.63,0:05:17.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian yang bukan kaum elite asli\Ntidak akan paham, ya?
Dialogue: 0,0:05:18.42,0:05:19.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong...
Dialogue: 0,0:05:20.30,0:05:24.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang kelima kalian\Nmemang agak di luar dugaan,
Dialogue: 0,0:05:24.18,0:05:26.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi jangan kira kami akan diam saja.
Dialogue: 0,0:05:26.76,0:05:28.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu juga!
Dialogue: 0,0:05:28.06,0:05:30.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujungnya, mana mungkin\Naku kasih kalian waktu
Dialogue: 0,0:05:30.94,0:05:33.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}buat mengejar Takitsubo dan Hanano?
Dialogue: 0,0:05:34.11,0:05:37.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal tinggal kasih uangnya\Ndan perkara selesai!
Dialogue: 0,0:05:37.32,0:05:40.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Konyol banget malah minta mati meledak!
Dialogue: 0,0:05:47.79,0:05:48.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong, ya!
Dialogue: 0,0:05:48.58,0:05:49.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Super baiklah.
Dialogue: 0,0:05:52.87,0:05:53.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketemu.
Dialogue: 0,0:05:55.08,0:05:57.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa dibunuh sekali tembak.
Dialogue: 0,0:05:57.59,0:06:02.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi mubazir kalau koper\N80 miliarnya ikut lenyap.
Dialogue: 0,0:06:02.55,0:06:04.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus mendekat!
Dialogue: 0,0:06:19.57,0:06:20.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cih!
Dialogue: 0,0:06:20.53,0:06:23.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pantas larinya lambat,\Nternyata pasang jebakan!
Dialogue: 0,0:06:27.24,0:06:28.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diam dan minggir sana!
Dialogue: 0,0:06:30.37,0:06:31.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku selamat.
Dialogue: 0,0:06:32.16,0:06:34.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Terima ka...\N- Kamu juga menghalangi!
Dialogue: 0,0:06:36.33,0:06:38.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cih! Dia anggota Judgement, ya?
Dialogue: 0,0:06:38.84,0:06:41.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka juga ikutan, sial banget.
Dialogue: 0,0:06:41.30,0:06:45.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, bisa-bisanya dia menipu\Norang di Pasar Payung tadi.
Dialogue: 0,0:06:45.38,0:06:47.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata dia elite juga.
Dialogue: 0,0:06:58.19,0:06:59.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Planetarium?
Dialogue: 0,0:07:04.07,0:07:04.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketemu!
Dialogue: 0,0:07:05.53,0:07:06.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Targetnya garis tulang punggung.
Dialogue: 0,0:07:06.82,0:07:09.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padatkan jadi setipis pasta kering
Dialogue: 0,0:07:09.37,0:07:10.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu bunuh dalam sekejap.
Dialogue: 0,0:07:13.75,0:07:16.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Petak umpet sama aku saja,\Njangan Inoue!
Dialogue: 0,0:07:16.79,0:07:17.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:07:20.27,0:07:22.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salam kenal lagi, rekan sejawat.
Dialogue: 0,0:07:22.92,0:07:25.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Hanayama Kamitsu dari ITEM.
Dialogue: 0,0:07:25.42,0:07:27.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Panggil saja aku si Kurir.
Dialogue: 0,0:07:29.51,0:07:31.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kurir pembawa kematian.
Dialogue: 0,0:07:31.51,0:07:34.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengantarkan kekerasan dan bom.
Dialogue: 0,0:07:34.52,0:07:36.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan meski membawa emas batangan
Dialogue: 0,0:07:36.56,0:07:38.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau kotak P3K demi menolong orang,
Dialogue: 0,0:07:38.81,0:07:40.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pada akhirnya akan membawa petaka.
Dialogue: 0,0:07:40.94,0:07:43.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitulah sosokku.
Dialogue: 0,0:07:43.53,0:07:46.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan pernah lengah\Ndengan kebaikan penjahat.
Dialogue: 0,0:07:47.99,0:07:52.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak kecil pun tahu apa jadinya\Nkalau terbuai rayuan iblis.
Dialogue: 0,0:07:53.29,0:07:56.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo? Kamu tersinggung\Nsoal nama ITEM?
Dialogue: 0,0:07:56.66,0:08:00.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pikir punya hak paten nama itu?
Dialogue: 0,0:08:06.47,0:08:08.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bercanda, ah.
Dialogue: 0,0:08:08.26,0:08:12.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin kegelapan Kota Akademi\Nbersikap sebaik itu.
Dialogue: 0,0:08:12.18,0:08:15.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buat apa juga melindungi\Nhak paten penjahat.
Dialogue: 0,0:08:16.02,0:08:20.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang lebih berguna bagi sisi gelap\Nyang berhak punya nama ITEM.
Dialogue: 0,0:08:21.61,0:08:24.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitulah aturan dunia kita.
Dialogue: 0,0:08:24.90,0:08:28.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pembunuh yang boros uang saja\Ntidaklah cukup.
Dialogue: 0,0:08:28.65,0:08:31.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian cuma menghancurkan\Ntanpa menghasilkan apa-apa.
Dialogue: 0,0:08:31.70,0:08:34.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaliknya, kami mengejarkan tugas kotor
Dialogue: 0,0:08:34.40,0:08:38.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sambil tetap memberikan\Nkeuntungan nyata bagi mereka.
Dialogue: 0,0:08:40.16,0:08:43.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nilai kami jauh lebih tinggi, lo.
Dialogue: 0,0:08:43.73,0:08:45.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo bermain.
Dialogue: 0,0:08:45.13,0:08:46.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Palsu!
Dialogue: 0,0:08:46.92,0:08:51.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua kandidat lain akan dilibas\Noleh kami, ITEM yang asli!
Dialogue: 0,0:08:52.47,0:08:55.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mesin uji coba teknologi\Nyang mengabaikan aspek praktis,
Dialogue: 0,0:08:55.06,0:08:58.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menempel erat di tanah dan mampu\Nmelesat hingga 1.100 km/jam!
Dialogue: 0,0:08:58.85,0:09:04.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu akan kugilas dengan Dragon Motor\Nyang terkuat dan tercepat ini!
Dialogue: 0,0:09:12.36,0:09:14.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anggota terkuat malah kabur
Dialogue: 0,0:09:14.40,0:09:17.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan pemain cadangan\Nmau melawanku dan Chief?
Dialogue: 0,0:09:17.87,0:09:18.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Santai banget.
Dialogue: 0,0:09:19.25,0:09:21.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau kita tes?
Dialogue: 0,0:09:21.79,0:09:24.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, Waniguchi, mau mulai?
Dialogue: 0,0:09:24.25,0:09:25.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong, ya.
Dialogue: 0,0:09:43.90,0:09:45.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yey!
Dialogue: 0,0:09:45.52,0:09:48.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagi yang kecewa\Nkarena pertandingan dibatalkan,
Dialogue: 0,0:09:48.32,0:09:50.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ada acara dadakan yang super seru!
Dialogue: 0,0:09:50.65,0:09:54.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akan memulai sesi eksekusi\Nyang mendebarkan!
Dialogue: 0,0:09:57.37,0:09:59.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, hei! Yo, yo!
Dialogue: 0,0:09:59.41,0:10:02.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya beri tepuk tangan\Nuntuk masuknya sang Eksekutor!
Dialogue: 0,0:10:05.92,0:10:11.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siaran langsung penuh darah\Ndan daging hancur segera dimulai!
Dialogue: 0,0:10:11.76,0:10:12.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minggir, Anak Baru!
Dialogue: 0,0:10:20.00,0:10:22.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cih, mengincar sekering listrik?
Dialogue: 0,0:10:22.23,0:10:23.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak seru, ah.
Dialogue: 0,0:10:23.73,0:10:26.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siaran langsungnya terputus, ya?
Dialogue: 0,0:10:26.47,0:10:31.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal ponsel para penonton sudah disita\Nagar tidak ada yang diam-diam menyiarkan
Dialogue: 0,0:10:31.07,0:10:33.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pertandingan berharga ini ke situs video.
Dialogue: 0,0:10:34.20,0:10:35.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayang sekali.
Dialogue: 0,0:10:35.07,0:10:40.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memamerkan wajah ke publik itu\Nhal terburuk buat pekerja dunia bawah.
Dialogue: 0,0:10:40.58,0:10:42.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujungnya, lolos tipis.
Dialogue: 0,0:10:46.04,0:10:48.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kalian akan tetap kubunuh.
Dialogue: 0,0:10:48.21,0:10:50.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski cuma jadi acara eksklusif\Nbuat penonton di sini,
Dialogue: 0,0:10:50.77,0:10:53.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku bakal main brutal sebagai gantinya!
Dialogue: 0,0:10:58.39,0:11:01.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita belum tahu gaya bertarungnya,
Dialogue: 0,0:11:01.43,0:11:02.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi waspa—
Dialogue: 0,0:11:02.52,0:11:03.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu!
Dialogue: 0,0:11:03.52,0:11:07.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak pakai trik licik, ya?\NAku suka gayamu, Sampah Hidup!
Dialogue: 0,0:11:07.02,0:11:11.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bakal kuhias jadi gumpalan daging\Nyang bersinar dengan penuh rasa hormat!
Dialogue: 0,0:11:17.62,0:11:18.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bego, ya?
Dialogue: 0,0:11:18.95,0:11:21.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mentang-mentang berbadan keras,
Dialogue: 0,0:11:21.37,0:11:25.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kebiasaanmu menerjang\Nuntuk mendapat info harus diperbaiki!
Dialogue: 0,0:11:25.58,0:11:26.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahaya!
Dialogue: 0,0:11:29.17,0:11:33.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diam di tengah pertarungan maut\Ncuma buat ceramah
Dialogue: 0,0:11:33.34,0:11:35.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}justru cara cepat untuk mati.
Dialogue: 0,0:11:35.59,0:11:37.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sialan...
Dialogue: 0,0:11:37.97,0:11:41.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membalas penyelamatmu\Ndengan kekuatan penuh,
Dialogue: 0,0:11:41.10,0:11:44.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu sangat suka membangkang, ya?
Dialogue: 0,0:11:50.48,0:11:56.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aslinya ini cadangan kalau harimau putih\Nterlalu kuat dan membantai seluruh peserta.
Dialogue: 0,0:11:56.65,0:11:59.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kayak pertarungan\Nsesama hewan buas.
Dialogue: 0,0:11:59.99,0:12:00.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini, ya?
Dialogue: 0,0:12:00.78,0:12:04.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujungnya, kemampuan cewek itu\Nadalah mengendalikan hewan?
Dialogue: 0,0:12:04.33,0:12:05.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan.
Dialogue: 0,0:12:05.66,0:12:07.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu super tidak masuk akal.
Dialogue: 0,0:12:07.75,0:12:10.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus yang menjebol atap\Ndan tembok tadi itu apa?
Dialogue: 0,0:12:10.58,0:12:15.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagian meski terlihat sepele,\Nmikrofonnya juga melayang di udara tadi.
Dialogue: 0,0:12:18.47,0:12:20.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan cuma fokus ke beruangnya!
Dialogue: 0,0:12:35.82,0:12:37.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujungnya, serius, nih?
Dialogue: 0,0:12:38.24,0:12:43.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chief, silakan kalau mau main hewan,\Ntapi jangan libatkan aku, dong.
Dialogue: 0,0:12:43.12,0:12:46.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, ya.\NTolong maafkan aku.
Dialogue: 0,0:12:46.45,0:12:49.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya kendaliku sedikit gagal.
Dialogue: 0,0:12:49.47,0:12:50.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya ampun.
Dialogue: 0,0:12:50.92,0:12:54.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa senjataku bakal mempan padanya?
Dialogue: 0,0:13:03.39,0:13:05.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Leverage Struggle.
Dialogue: 0,0:13:05.31,0:13:07.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak berniat menyembunyikannya.
Dialogue: 0,0:13:07.98,0:13:11.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan ini sering kupamerkan\Nsaat mengeksekusi para pelanggar aturan.
Dialogue: 0,0:13:11.48,0:13:14.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gunting, linggis, jungkat-jungkit,\Nsampai kuncian sendi.
Dialogue: 0,0:13:14.94,0:13:18.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua prinsip tuas adalah senjataku.
Dialogue: 0,0:13:18.11,0:13:22.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pilar beton seukuran pinggangmu juga\Nbisa kupelintir pakai tangan kosong.
Dialogue: 0,0:13:22.78,0:13:25.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan yang lebih besar juga bisa, lo!
Dialogue: 0,0:13:25.51,0:13:29.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu serius bicara begitu,\Ndasar Bego Tingkat Akut?
Dialogue: 0,0:13:37.38,0:13:38.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, mau apa kamu?
Dialogue: 0,0:13:39.42,0:13:44.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waduh, gel pelapis anti gesekan\Npunya Hanayama malah direbut.
Dialogue: 0,0:13:44.43,0:13:47.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuncian sendi yang memakai prinsip tuas.
Dialogue: 0,0:13:47.43,0:13:51.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau memang modalnya itu,\Naku cuma perlu tidak tertangkap.
Dialogue: 0,0:13:51.85,0:13:55.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi buat seorang gadis,\Ncara mainmu terlalu barbar.
Dialogue: 0,0:13:55.15,0:13:58.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada yang tanya\Ntapi malah nyerocos sendiri.
Dialogue: 0,0:13:58.69,0:14:02.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cara membunuhmu itu\Nsuper banyak, tahu.
Dialogue: 0,0:14:05.78,0:14:08.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waniguchi, jangan menangis.
Dialogue: 0,0:14:08.83,0:14:11.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang jangan asal\Nbongkar kekuatanmu, kan?
Dialogue: 0,0:14:12.96,0:14:14.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chief!
Dialogue: 0,0:14:14.71,0:14:18.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayang, meski dia licin\Ndan tidak bisa ditangkap,
Dialogue: 0,0:14:18.80,0:14:23.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu bisa menghantam dan tarung\Njarak dekat dengan prinsip tang, kok.
Dialogue: 0,0:14:23.97,0:14:27.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membatasi pola pikir walau bisa\Npakai strategi licik lainnya
Dialogue: 0,0:14:27.85,0:14:30.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak bisa dibilang cerdas, lo.
Dialogue: 0,0:14:30.27,0:14:34.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan ikut menceramahiku, dong!
Dialogue: 0,0:14:35.52,0:14:36.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cup, cup.
Dialogue: 0,0:14:36.86,0:14:38.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Santai banget, ya.
Dialogue: 0,0:14:38.57,0:14:43.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pikir bisa bertarung dan menang\Ndari kami sambil melindungi si Bodoh itu?
Dialogue: 0,0:14:44.40,0:14:48.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuharap kamu bukan tipe\Nmodal otot tanpa otak juga.
Dialogue: 0,0:14:49.01,0:14:50.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, kamu benar.
Dialogue: 0,0:14:52.25,0:14:54.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetap saja kami yang akan menang.
Dialogue: 0,0:14:54.37,0:14:56.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bertarung sambil melindungi yang lemah?
Dialogue: 0,0:14:56.33,0:14:58.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa menang meski satu lawan dua?
Dialogue: 0,0:14:58.59,0:15:00.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, tentu bisa.
Dialogue: 0,0:15:00.75,0:15:03.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang kuat pasti bisa melawan\Nketidakadilan dunia ini.
Dialogue: 0,0:15:03.80,0:15:06.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin orang lemah sepertimu\Ntidak akan paham.
Dialogue: 0,0:15:06.80,0:15:11.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, mulai sekarang secara spesial,\Nmusuh bebuyutan sisi gelap,
Dialogue: 0,0:15:11.14,0:15:15.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}peringkat 6 Kota Akademi,\Nakan menunjukkan
Dialogue: 0,0:15:15.94,0:15:18.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}keseriusannya.
Dialogue: 0,0:15:28.37,0:15:29.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cih!
Dialogue: 0,0:15:32.70,0:15:34.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengabaikan hambatan udara?
Dialogue: 0,0:15:34.96,0:15:37.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bukan kecepatan yang bisa\Nditahan kulit manusia biasa.
Dialogue: 0,0:15:37.88,0:15:39.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gara-gara gel tadi, ya?
Dialogue: 0,0:15:42.00,0:15:43.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar wanita laba-laba!
Dialogue: 0,0:15:43.21,0:15:45.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar!
Dialogue: 0,0:15:48.72,0:15:50.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nomor atom 92.
Dialogue: 0,0:15:50.51,0:15:53.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katana membara dari uranium terdeplesi\Nyang mampu membelah tank!
Dialogue: 0,0:15:54.27,0:15:56.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bahkan tidak akan sadar\Nkalau sudah tertebas!
Dialogue: 0,0:15:57.02,0:16:00.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadilah Daruma Otoshi versi manusia!
Dialogue: 0,0:16:08.16,0:16:09.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo? Ketahuan?
Dialogue: 0,0:16:09.53,0:16:12.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku sudah berjanji\Nuntuk membunuhmu sebelum sadar.
Dialogue: 0,0:16:18.04,0:16:19.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kawat baja?
Dialogue: 0,0:16:19.58,0:16:22.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang, tebakanmu soal\Nwanita laba-laba itu sudah benar.
Dialogue: 0,0:16:22.84,0:16:24.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak akan kubiarkan kamu mendarat.
Dialogue: 0,0:16:24.63,0:16:27.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kubuatkan jaring laba-laba\Ndari benang mematikan untukmu!
Dialogue: 0,0:16:34.10,0:16:34.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial!
Dialogue: 0,0:16:36.43,0:16:39.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski bisa mengulur waktu\Ndengan melompat beberapa kali,
Dialogue: 0,0:16:39.23,0:16:42.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}seluruh reruntuhan akan jatuh\Ndan pijakanmu akan habis.
Dialogue: 0,0:16:42.36,0:16:44.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak akan bisa melayang\Ndi udara selamanya.
Dialogue: 0,0:16:44.57,0:16:47.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bencilah berat badanmu sendiri
Dialogue: 0,0:16:47.19,0:16:50.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sambil terpotong-potong\Nlayaknya agar-agar Tokoroten!
Dialogue: 0,0:16:54.62,0:16:57.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tembakan asal tidak akan\Nbisa mengenaiku.
Dialogue: 0,0:16:57.16,0:16:59.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat tinggal, level 5.
Dialogue: 0,0:16:59.04,0:17:02.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nama ITEM akan kami ambil alih!
Dialogue: 0,0:17:05.42,0:17:06.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang terjadi?
Dialogue: 0,0:17:08.51,0:17:13.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Secepat apa pun kamu bergerak\Nsampai tidak bisa aku bidik,
Dialogue: 0,0:17:14.22,0:17:17.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}percuma kalau tidak ada pijakan, bukan?
Dialogue: 0,0:17:17.22,0:17:18.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pembalap Jalanan.
Dialogue: 0,0:17:20.09,0:17:22.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Struktur bangunannya\Ntidak mampu bertahan!
Dialogue: 0,0:17:22.31,0:17:25.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serangannya barusan\Nbukan untuk mengincarku!
Dialogue: 0,0:17:25.98,0:17:27.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan...
Dialogue: 0,0:17:33.20,0:17:36.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau arah tujuanmu bisa diprediksi,\Nmembidik jadi mudah.
Dialogue: 0,0:17:37.66,0:17:38.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makan, nih!
Dialogue: 0,0:17:50.43,0:17:53.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, waktunya mengurus target utama.
Dialogue: 0,0:17:56.76,0:18:00.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tinggal kerahkan organisasi bawahan\Nke seluruh area sekitar
Dialogue: 0,0:18:00.06,0:18:02.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk menemukan wanita\Npembawa koper itu.
Dialogue: 0,0:18:02.69,0:18:07.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelahnya, cukup panggil Takitsubo\Nuntuk mendaftarkan medan difusi AIM-nya.
Dialogue: 0,0:18:08.48,0:18:12.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanano, kamu sudah berhasil\Nmengevakuasi Takitsubo?
Dialogue: 0,0:18:12.15,0:18:14.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau pakai AIM Stalker,\Njadi siapkan Body Crystal.
Dialogue: 0,0:18:14.61,0:18:19.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayangnya, anggota kelima\Nmisteriusmu sudah aku urus.
Dialogue: 0,0:18:19.91,0:18:22.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong jangan benci dia, ya.
Dialogue: 0,0:18:22.92,0:18:25.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanano sudah menjalankan perintahmu.
Dialogue: 0,0:18:25.50,0:18:28.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agar Takitsubo bisa kabur,\Ndia menahan rasa takut
Dialogue: 0,0:18:28.84,0:18:31.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan rela mengorbankan dirinya sendiri.
Dialogue: 0,0:18:32.09,0:18:35.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pujilah usaha seadanya darinya.
Dialogue: 0,0:18:35.44,0:18:37.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dia gagal dan tidak punya\Ntempat bernaung lagi,
Dialogue: 0,0:18:37.97,0:18:40.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku mau saja merekrutnya.
Dialogue: 0,0:18:41.14,0:18:42.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jalang...
Dialogue: 0,0:18:45.52,0:18:47.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami sangat minta maaf.
Dialogue: 0,0:18:48.52,0:18:50.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asal tahu saja.
Dialogue: 0,0:18:50.15,0:18:53.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa kabur dari situasi\Nseperti tadi saja sudah bagus.
Dialogue: 0,0:18:53.53,0:18:58.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, ragu memilih sasaran seperti memilih lauk\Ndengan sumpit memang kurang baik.
Dialogue: 0,0:18:58.20,0:19:01.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak akan bertahan sedetik pun\Nkalau aku yang hadapi.
Dialogue: 0,0:19:02.62,0:19:06.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah dibilang, aku ini\Nmusuh bebuyutan sisi gelap, kan?
Dialogue: 0,0:19:06.63,0:19:10.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah waktunya menyadari itu\Ndengan tubuhmu sendiri.
Dialogue: 0,0:19:10.00,0:19:14.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memburu orang-orang seperti kalian\Nadalah keahlianku.
Dialogue: 0,0:19:14.01,0:19:15.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama ada di kegelapan ini,
Dialogue: 0,0:19:15.84,0:19:19.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mustahil kalian bisa mengalahkanku.
Dialogue: 0,0:19:20.06,0:19:21.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bercanda, Sampah.
Dialogue: 0,0:19:22.21,0:19:27.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi kalau kami siswi SMA dari sisi terang\Natau pahlawan, kalian yang akan musnah?
Dialogue: 0,0:19:27.75,0:19:30.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah tahu jawabannya, lo.
Dialogue: 0,0:19:30.11,0:19:34.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebanyak apa pun mangsa\Nseperti kalian berkerumun,
Dialogue: 0,0:19:34.44,0:19:36.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}cuma akan jadi santapan.
Dialogue: 0,0:19:36.11,0:19:40.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cakar dan taring lemah kalian mustahil\Nmenggapai musuh alami sepertiku.
Dialogue: 0,0:19:40.87,0:19:44.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada hubungan tiga arah\Ndalam piramida rantai makanan.
Dialogue: 0,0:19:44.78,0:19:48.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang ada cuma hierarki atas\Ndan bawah yang mutlak.
Dialogue: 0,0:19:49.42,0:19:53.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami akan tetap bisa melanjutkan\Nkegiatan koloseum ini.
Dialogue: 0,0:19:53.88,0:19:57.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Informan dari perusahaan asuransi\Ndan lokasi panggung yang pindah-pindah,
Dialogue: 0,0:19:57.63,0:20:02.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}anggap saja semua itu barang sekali pakai\Nyang bisa diganti kapan saja.
Dialogue: 0,0:20:02.81,0:20:06.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu-satunya poin minus cuma...
Dialogue: 0,0:20:06.89,0:20:12.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu masih hidup,\NHanayama mati, ya?
Dialogue: 0,0:20:13.02,0:20:19.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, itu bukan masalah selama Hanano\Nbisa kubujuk untuk jadi rekan.
Dialogue: 0,0:20:19.07,0:20:24.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia ingin kujadikan koleksi\Nkarena berwajah manis.
Dialogue: 0,0:20:24.04,0:20:29.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekerasan, kelaparan, kurang tidur,\Nrasa sakit dan gatal, kotoran, kepanikan.
Dialogue: 0,0:20:29.79,0:20:34.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan meski kami harus melepaskan\Nkehendak bebas dari tubuh manusianya.
Dialogue: 0,0:20:35.46,0:20:38.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menantikan perlawanan imutnya.
Dialogue: 0,0:20:41.14,0:20:44.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu nyawa dibalas satu nyawa.
Dialogue: 0,0:20:44.77,0:20:48.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami yang ingin terus berbisnis\Ndan kalian yang ingin merusaknya.
Dialogue: 0,0:20:48.94,0:20:51.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skornya imbang, kan?
Dialogue: 0,0:20:51.10,0:20:51.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cih.
Dialogue: 0,0:21:08.37,0:21:09.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mugino.
Dialogue: 0,0:21:10.21,0:21:10.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:21:11.46,0:21:13.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bukan salahmu.
Dialogue: 0,0:21:13.17,0:21:15.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu cuma menuruti perintahku.
Dialogue: 0,0:21:15.55,0:21:18.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti ini juga bukan salahmu.
Dialogue: 0,0:21:18.45,0:21:21.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pikir menyuruhnya kabur duluan
Dialogue: 0,0:21:21.13,0:21:23.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah opsi paling aman, kan?
Dialogue: 0,0:21:39.95,0:21:42.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin menjadi rekan para ITEM!
Dialogue: 0,0:21:42.32,0:21:43.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga kalian yang telah memungut
Dialogue: 0,0:21:43.95,0:21:45.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan menyelamatkan hidupku
Dialogue: 0,0:21:45.12,0:21:48.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}membutuhkan diriku yang seperti ini!
Dialogue: 0,0:21:50.59,0:21:52.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Momennya tidak pas, tahu.
Dialogue: 0,0:21:53.42,0:21:54.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mugino.
Dialogue: 0,0:21:55.46,0:21:57.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum ada yang berakhir.
Dialogue: 0,0:21:57.67,0:22:02.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita selamatkan Hanano\Ndari ITEM palsu itu bersama-sama.
