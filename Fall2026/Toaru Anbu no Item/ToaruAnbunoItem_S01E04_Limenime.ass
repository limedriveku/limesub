Dialogue: 0,0:01:56.89,0:02:00.02,sign,,0000,0000,0000,,A CERTAIN ITEM OF DARK SIDE
Dialogue: 0,0:10:12.80,0:10:14.76,sign,,0000,0000,0000,,SET KEMBANG API KELUARGA
Dialogue: 0,0:10:49.13,0:10:52.17,sign,,0000,0000,0000,,PERHATIAN, DILARANG MASUK TANPA IZIN
Dialogue: 0,0:13:58.53,0:14:00.19,sign,,0000,0000,0000,,EPISODE 4:
Dialogue: 0,0:14:00.19,0:14:01.03,sign,,0000,0000,0000,,KOZAKU MITORI, LIQUID SHADOW
Dialogue: 0,0:14:04.49,0:14:07.95,sign,,0000,0000,0000,,7 JULI
Dialogue: 0,0:23:35.06,0:23:35.56,sign,,0000,0000,0000,,A CERTAIN ITEM OF DARK SIDE
Dialogue: 0,0:23:35.56,0:23:40.07,sign,,0000,0000,0000,,EPISODE 5: PENYUSUPAN
Dialogue: 0,0:00:13.12,0:00:18.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bentuk boneka memang\Npaling mudah dikontrol.
Dialogue: 0,0:00:19.96,0:00:24.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau soal sekutu,\Nkakak cantik ini juga tidak kekurangan.
Dialogue: 0,0:00:25.21,0:00:30.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, tadi bilang apa soal menang jumlah?
Dialogue: 0,0:02:00.60,0:02:02.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan ini?
Dialogue: 0,0:02:02.56,0:02:04.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak banget!
Dialogue: 0,0:02:04.27,0:02:06.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Liquid Shadow.
Dialogue: 0,0:02:07.15,0:02:09.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemampuan kakak cantik ini.
Dialogue: 0,0:02:09.78,0:02:12.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Bagaimana ini?
Dialogue: 0,0:02:15.16,0:02:15.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ber...
Dialogue: 0,0:02:16.49,0:02:17.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ju...
Dialogue: 0,0:02:17.91,0:02:18.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ang...
Dialogue: 0,0:02:19.33,0:02:20.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lah...
Dialogue: 0,0:02:21.08,0:02:23.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sudah berjuang, kok!
Dialogue: 0,0:02:23.33,0:02:29.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sambil meloloskan orang yang kukawal,\Nkalian akan kubantai di sini.
Dialogue: 0,0:02:29.09,0:02:32.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jumlah sebanyak ini\Nseharusnya cukup, kan?
Dialogue: 0,0:02:32.76,0:02:37.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malah, sekarang kalianlah\Nyang harus bertahan.
Dialogue: 0,0:02:41.27,0:02:44.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga kontrolnya manual.
Dialogue: 0,0:02:44.64,0:02:46.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bonekanya akan berhenti\Nkalau dia gagal fokus.
Dialogue: 0,0:02:46.77,0:02:50.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau kuhantam pakai telapak tangan
Dialogue: 0,0:02:50.36,0:02:52.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sampai bobotmu sisa separuh?
Dialogue: 0,0:02:54.70,0:02:57.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kira modalku cuma kemampuan?
Dialogue: 0,0:02:57.62,0:03:00.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar bedebah!
Dialogue: 0,0:03:00.03,0:03:03.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayaknya boost langka\Nbintang lima punyamu
Dialogue: 0,0:03:03.29,0:03:06.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak terlalu mempan\Npada kakak cantik ini.
Dialogue: 0,0:03:06.25,0:03:09.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar produk tiruan peringkat satu.
Dialogue: 0,0:03:09.00,0:03:11.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memercayai sistem peringkat murahan
Dialogue: 0,0:03:11.59,0:03:13.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}buatan Kota Akademi yang korup
Dialogue: 0,0:03:13.38,0:03:16.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sampai membeda-bedakan HAM segala.
Dialogue: 0,0:03:16.80,0:03:19.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh memuakkan!
Dialogue: 0,0:03:24.23,0:03:26.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bilah frekuensi tinggi?
Dialogue: 0,0:03:26.06,0:03:30.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pisau cukur bentuk T yang bergetar\Nkayak mainan ini memangnya ampuh?
Dialogue: 0,0:03:31.82,0:03:36.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mainan milik kakak cantik ini\Nlebih ekstrem dan asyik, lo.
Dialogue: 0,0:03:36.74,0:03:37.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujungnya,
Dialogue: 0,0:03:37.91,0:03:40.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu terlalu mengandalkan\Nketebalan zirah, Anak Baru!
Dialogue: 0,0:03:43.95,0:03:44.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cih!
Dialogue: 0,0:03:44.70,0:03:46.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seranganku gagal kena telak...
Dialogue: 0,0:03:50.08,0:03:51.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana bisa?
Dialogue: 0,0:03:51.71,0:03:53.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Drone Knife.
Dialogue: 0,0:03:53.75,0:03:56.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujungnya, orang itu punya\Nberapa banyak trik, sih?
Dialogue: 0,0:03:57.30,0:03:58.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Koyak dia.
Dialogue: 0,0:03:58.68,0:04:00.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial!
Dialogue: 0,0:04:04.89,0:04:05.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurang ajar!
Dialogue: 0,0:04:08.35,0:04:10.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh juga.
Dialogue: 0,0:04:12.86,0:04:17.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayangnya, boneka milikku\Nbisa bangkit berulang kali.
Dialogue: 0,0:04:22.02,0:04:24.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Massa jenisnya sekitar 20 g/mL, sih.
Dialogue: 0,0:04:24.74,0:04:28.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tubuh manusia sama kayak air\Nyang massa jenisnya 1 g/mL...
Dialogue: 0,0:04:28.04,0:04:32.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski kelihatan seksi,\Nberatnya sekitar 1 ton, lo.
Dialogue: 0,0:04:33.25,0:04:37.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti berat badanmu sekitar 50 kg, ya?
Dialogue: 0,0:04:37.22,0:04:38.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Super gend—
Dialogue: 0,0:04:38.01,0:04:40.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kan aku bilang "sekitar"!
Dialogue: 0,0:04:41.01,0:04:43.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar bocah kerempeng\Nkayak kertas kering!
Dialogue: 0,0:04:50.69,0:04:51.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kinuhata!
Dialogue: 0,0:04:51.52,0:04:55.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hal-hal kayak persahabatan itu\Nbikin muak saja!
Dialogue: 0,0:04:59.40,0:05:03.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zirah mirip udara itu tidak bisa\Nditembus pakai Drone Knife, ya.
Dialogue: 0,0:05:03.70,0:05:06.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih tepatnya, punyaku ini nitrogen.
Dialogue: 0,0:05:06.16,0:05:08.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terserah, lah.
Dialogue: 0,0:05:08.37,0:05:10.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kamu pasang badan,
Dialogue: 0,0:05:10.92,0:05:14.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}si baju olahraga beban itu\Nkomandan kalian, ya?
Dialogue: 0,0:05:15.50,0:05:19.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata menyerang dia\Nadalah pilihan tepat.
Dialogue: 0,0:05:20.38,0:05:24.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakinya tidak boleh dipotong,\Nbiar bisa jalan sendiri.
Dialogue: 0,0:05:24.89,0:05:26.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, Mbak Komandan.
Dialogue: 0,0:05:26.51,0:05:30.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kedua lenganmu kutebas dulu, ya.
Dialogue: 0,0:05:30.31,0:05:32.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya?
Dialogue: 0,0:05:32.23,0:05:36.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sedih gara-gara kamu lupakan, nih.
Dialogue: 0,0:05:41.32,0:05:42.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Percuma.
Dialogue: 0,0:05:42.99,0:05:46.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bonekaku bisa bangkit berulang ka—
Dialogue: 0,0:05:47.45,0:05:49.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan air maupun besi.
Dialogue: 0,0:05:49.62,0:05:53.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sengaja mengendalikan\Nlogam cair yang tergolong langka
Dialogue: 0,0:05:53.92,0:05:58.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena kemampuan itu\Njangkauannya pendek, kan?
Dialogue: 0,0:05:58.50,0:06:01.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hasil penelitian bahan peredam tercanggih.
Dialogue: 0,0:06:01.22,0:06:06.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, massa jenisnya 20 g/mL dan terlalu berat\Nuntuk penggunaan umum, kan?
Dialogue: 0,0:06:07.14,0:06:11.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu cuma bisa mengontrol molekul logam\Nbuatan pabrik tertentu, kan?
Dialogue: 0,0:06:11.27,0:06:14.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti, tinggal menyalurkan\Nbanyak elektron
Dialogue: 0,0:06:14.48,0:06:16.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk mengubah komposisi molekulnya.
Dialogue: 0,0:06:16.77,0:06:19.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengendalikan ion itu mudah bagiku.
Dialogue: 0,0:06:20.40,0:06:21.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat pasir, udara,
Dialogue: 0,0:06:21.82,0:06:25.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan berbagai kotoran menyatu\Ndi tingkat mikroskopis,
Dialogue: 0,0:06:25.53,0:06:28.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}logam khusus bermassa jenis 20\Nbakal jadi ringan.
Dialogue: 0,0:06:28.37,0:06:32.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama kayak menjatuhkan\Npermen leleh ke bak pasir.
Dialogue: 0,0:06:32.08,0:06:34.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu semuanya campur aduk,
Dialogue: 0,0:06:34.58,0:06:38.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu tidak bisa makan permen\Npemberian ibumu lagi.
Dialogue: 0,0:06:38.29,0:06:39.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana bisa begi...
Dialogue: 0,0:06:39.92,0:06:40.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cih.
Dialogue: 0,0:06:40.67,0:06:42.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini Kota Akademi, tahu!
Dialogue: 0,0:06:42.84,0:06:45.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa begitu saja bingung?
Dialogue: 0,0:06:45.13,0:06:48.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah dibilang kemampuanku\Nbisa menghancurkan atom!
Dialogue: 0,0:06:48.80,0:06:50.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus kenapa?
Dialogue: 0,0:06:51.22,0:06:55.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senjata yang kusiapkan di ketinggian\N10.000 meter masih ada banyak!
Dialogue: 0,0:06:55.02,0:06:57.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Total beratnya 1.000 ton!
Dialogue: 0,0:06:57.44,0:07:00.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bakal jadi perang kalau semuanya\Ndijatuhkan dan kujadikan boneka!
Dialogue: 0,0:07:01.53,0:07:02.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai empat digit?
Dialogue: 0,0:07:02.90,0:07:04.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan itu?
Dialogue: 0,0:07:04.11,0:07:07.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senjata rahasiamu\Nada berapa banyak, sih?
Dialogue: 0,0:07:08.07,0:07:11.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau berniat meratakan\NGedung Tanpa Jendela itu,
Dialogue: 0,0:07:11.37,0:07:14.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}daya tempur empat digit pun\Nmasih kurang.
Dialogue: 0,0:07:14.71,0:07:17.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, masih banyak guna lainnya.
Dialogue: 0,0:07:17.17,0:07:21.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski bergelar esper level tinggi,\Nkamu cuma petarung solo, kan?
Dialogue: 0,0:07:21.71,0:07:24.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dilawan ramai-ramai,\Naku yang untung.
Dialogue: 0,0:07:24.22,0:07:25.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, masa?
Dialogue: 0,0:07:26.13,0:07:28.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi ITEM bukan cuma aku seorang.
Dialogue: 0,0:07:28.72,0:07:32.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami petarung tim yang rukun\Ndan kompak, lo.
Dialogue: 0,0:07:36.14,0:07:37.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyamar jadi mayat?
Dialogue: 0,0:07:40.56,0:07:44.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah dibilang, kan?\NAku sedih gara-gara kamu lupakan.
Dialogue: 0,0:07:44.57,0:07:48.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus, kami mengandalkan kerja tim!
Dialogue: 0,0:07:54.66,0:07:55.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cih.
Dialogue: 0,0:08:07.55,0:08:09.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga ada di sini!
Dialogue: 0,0:08:09.22,0:08:12.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sampai kena aku!
Dialogue: 0,0:08:20.19,0:08:24.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga, dia menyemburkan\Nsemua cairan agar bisa kabur?
Dialogue: 0,0:08:24.78,0:08:28.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cara kaburnya pun\Ndipikirkan secara matang.
Dialogue: 0,0:08:28.07,0:08:31.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertarungannya sudah selesai, ya?
Dialogue: 0,0:08:32.03,0:08:32.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanano!
Dialogue: 0,0:08:32.78,0:08:34.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya?\NA-Ada apa?
Dialogue: 0,0:08:34.70,0:08:38.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa sosok hamba yang kerdil ini\Nmenyinggung hati Paduka?
Dialogue: 0,0:08:38.96,0:08:40.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bicara apa kamu?
Dialogue: 0,0:08:41.25,0:08:44.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus buat terjangan tadi.
Dialogue: 0,0:08:44.21,0:08:45.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lega rasanya.
Dialogue: 0,0:08:48.67,0:08:51.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mugino, mau dilacak?
Dialogue: 0,0:08:53.35,0:08:56.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu pakai Tubuh Kristal.
Dialogue: 0,0:08:56.47,0:08:58.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Toh, tidak jadi duit.
Dialogue: 0,0:09:01.69,0:09:04.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begini, upahnya batal.
Dialogue: 0,0:09:04.15,0:09:07.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Info soal Gedung Tanpa Jendela\Nbakal ditunda lagi.
Dialogue: 0,0:09:09.28,0:09:11.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apanya yang kerja tim?
Dialogue: 0,0:09:11.66,0:09:17.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal sudah tenggelam ke sisi gelap\Nsampai membunuh dan merampas sesuka hati.
Dialogue: 0,0:09:17.12,0:09:19.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka mengistimewakan diri sendiri
Dialogue: 0,0:09:19.83,0:09:23.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan sok-sokan mementingkan\Nteman dan keluarga.
Dialogue: 0,0:09:23.71,0:09:28.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para perampas sosok yang lebih penting\Ndari nyawaku juga sama saja.
Dialogue: 0,0:09:29.22,0:09:32.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di luar laboratorium, mereka\Npasti punya keluarga dan teman.
Dialogue: 0,0:09:33.34,0:09:36.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski punya rasa kemanusiaan,\Nmereka tetap bilang...
Dialogue: 0,0:09:37.31,0:09:38.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Dia cuma klona."
Dialogue: 0,0:09:39.60,0:09:43.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Semua esper cuma marmot percobaan."
Dialogue: 0,0:09:45.82,0:09:47.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak itu tidak akan
Dialogue: 0,0:09:47.94,0:09:49.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kembali lagi.
Dialogue: 0,0:09:51.28,0:09:54.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tidak bisa kumaafkan!
Dialogue: 0,0:09:54.53,0:09:56.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski harus kotor di sisi gelap,
Dialogue: 0,0:09:57.20,0:10:00.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan menumbangkan\Npuncak tertinggi kota ini!
Dialogue: 0,0:10:04.38,0:10:06.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Super oke.
Dialogue: 0,0:10:06.13,0:10:08.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, ayo jalan!
Dialogue: 0,0:10:08.75,0:10:10.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanano, kamu sedang apa?
Dialogue: 0,0:10:10.34,0:10:10.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo cepat!
Dialogue: 0,0:10:10.84,0:10:12.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baik, aku segera datang!
Dialogue: 0,0:10:19.68,0:10:22.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bekas darahnya hilang tanpa sisa, ya?
Dialogue: 0,0:10:22.73,0:10:25.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya ada semprotan\Npembersih kotoran.
Dialogue: 0,0:10:25.02,0:10:25.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takitsubo.
Dialogue: 0,0:10:26.36,0:10:28.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana lukanya Frenda?
Dialogue: 0,0:10:28.19,0:10:33.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah diberi pertolongan darurat,\Ntinggal diperiksa dokter nanti.
Dialogue: 0,0:10:34.74,0:10:37.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujungnya, kulit mulusku jadi rusak.
Dialogue: 0,0:10:37.49,0:10:40.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tangguh juga, Frenda.
Dialogue: 0,0:10:40.24,0:10:42.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih bisa lanjut, kan?
Dialogue: 0,0:10:42.12,0:10:45.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan ini?
Dialogue: 0,0:10:45.08,0:10:46.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini di mana?
Dialogue: 0,0:10:46.50,0:10:49.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa aku diikat begini?
Dialogue: 0,0:10:49.13,0:10:52.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serius dia kliennya?
Dialogue: 0,0:10:52.17,0:10:56.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita cuma tahu nama perusahaan asuransi\Ndan jabatannya selaku direktur eksekutif, kan?
Dialogue: 0,0:10:56.64,0:10:59.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak harus kliennya langsung, kok.
Dialogue: 0,0:10:59.97,0:11:05.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesama eksekutif di perusahaan tersebut\Npasti tahu masalahnya.
Dialogue: 0,0:11:05.02,0:11:09.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kalau memang tidak tahu-menahu,
Dialogue: 0,0:11:09.15,0:11:11.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buat apa dia membawa\Npistol mitraliur segala?
Dialogue: 0,0:11:12.99,0:11:17.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagian, mustahil orang biasa\Nmenyewa jasa pengawalan sisi gelap.
Dialogue: 0,0:11:17.99,0:11:19.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh.
Dialogue: 0,0:11:19.20,0:11:23.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian kelompok preman ITEM\Nyang dimaksud "Suara di Telepon" itu?
Dialogue: 0,0:11:23.08,0:11:26.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar begini, aku klien kalian!
Dialogue: 0,0:11:26.25,0:11:28.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana situasi di koloseum?
Dialogue: 0,0:11:28.54,0:11:31.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan pikir bisa lolos\Ndari semua perbuatan ini!
Dialogue: 0,0:11:31.75,0:11:33.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bakal kulaporkan ke "Suara di Telepon"!
Dialogue: 0,0:11:33.55,0:11:35.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gaji kalian akan dipotong!
Dialogue: 0,0:11:37.64,0:11:41.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jujur saja, aku tidak jago menyiksa.
Dialogue: 0,0:11:41.39,0:11:45.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya targetku keburu mati melulu\Nsebelum angkat bicara.
Dialogue: 0,0:11:46.48,0:11:48.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mayatnya sudah tidak ada,
Dialogue: 0,0:11:48.27,0:11:52.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi serpihan tembok hangusnya\Nmasih tersisa, kok.
Dialogue: 0,0:11:52.19,0:11:54.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sana dan di sana.
Dialogue: 0,0:11:55.61,0:11:58.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katakan semua yang kamu tahu\Nsoal koloseum.
Dialogue: 0,0:11:59.24,0:12:03.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti ada yang kamu rahasiakan\Ndari "Suara di Telepon", kan?
Dialogue: 0,0:12:03.24,0:12:04.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mugino.
Dialogue: 0,0:12:04.33,0:12:05.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:12:05.70,0:12:09.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takut dia keburu mati olehku\Nsebelum angkat bicara, kan?
Dialogue: 0,0:12:09.04,0:12:11.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujungnya, aku yang ambil alih?
Dialogue: 0,0:12:11.84,0:12:16.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masukkan bahan peledak ukuran kecil\Nlewat lubang hidung ke dalam kepala
Dialogue: 0,0:12:16.26,0:12:19.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}biar dia tidak bisa mati meskipun ingin.
Dialogue: 0,0:12:19.89,0:12:24.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus tinggal ancam untuk bicara\Nkalau tidak mau wajahnya hancur, kan?
Dialogue: 0,0:12:24.39,0:12:25.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak usah.
Dialogue: 0,0:12:25.52,0:12:27.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian berdua.
Dialogue: 0,0:12:27.98,0:12:33.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa pun yang resmi diterima nantinya,\Nkalian harus terbiasa sama pekerjaan ini.
Dialogue: 0,0:12:33.19,0:12:36.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pilihlah alat yang kalian suka\Ndari kotak perkakas ini
Dialogue: 0,0:12:36.65,0:12:39.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan siksa pak tua itu\Nasal jangan sampai mati, ya?
Dialogue: 0,0:12:39.95,0:12:44.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cukup lunakkan saja dagingnya,\Njangan sampai mati sebelum buka mulut.
Dialogue: 0,0:12:44.58,0:12:47.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu!\NTunggu sebentar!
Dialogue: 0,0:12:47.04,0:12:50.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini jelas beda kasus dari membela diri
Dialogue: 0,0:12:50.37,0:12:52.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dari serangan penjahat, kan?
Dialogue: 0,0:12:52.63,0:12:53.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Me-Menyiksa?
Dialogue: 0,0:12:53.88,0:12:56.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyiksa pak tua mirip wakepsek\Nyang tidak berdaya ini
Dialogue: 0,0:12:56.88,0:12:58.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pakai palu dan gergaji?
Dialogue: 0,0:12:58.97,0:13:00.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa! Tidak bisa!
Dialogue: 0,0:13:00.34,0:13:03.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil aku melakukannya!
Dialogue: 0,0:13:07.77,0:13:12.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah dibilang, kalau aku yang urus,\N100% dia dapat gelar almarhum.
Dialogue: 0,0:13:12.81,0:13:13.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya...
Dialogue: 0,0:13:14.19,0:13:18.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mau ada peluang 1% saja\Nbiar pak tua ini selamat,
Dialogue: 0,0:13:18.03,0:13:20.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu harus melakukannya sendiri.
Dialogue: 0,0:13:21.28,0:13:24.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berulang kali aku ingatkan\Njangan sampai dia mati, kan?
Dialogue: 0,0:13:24.91,0:13:28.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekerasan untuk membunuh orang\Nmungkin sulit dilakukan.
Dialogue: 0,0:13:28.79,0:13:32.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi beda cerita kalau kekerasannya\Ndipakai untuk menolong, kan?
Dialogue: 0,0:13:32.83,0:13:37.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penjaga kedamaian Kota Akademi\Nseperti Anti Skill dan Judgement
Dialogue: 0,0:13:37.63,0:13:39.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}melakukannya juga, lo.
Dialogue: 0,0:13:42.43,0:13:45.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, mau apa kalian?
Dialogue: 0,0:13:45.51,0:13:46.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:13:46.43,0:13:48.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kikir? Obeng?
Dialogue: 0,0:13:48.06,0:13:51.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benda-benda itu mau dipakai buat apa?
Dialogue: 0,0:13:51.02,0:13:55.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Habisnya kamu akan mati\Nkalau kami tidak begini.
Dialogue: 0,0:13:55.06,0:14:00.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua ini demi kebaikanmu.
Dialogue: 0,0:14:07.95,0:14:09.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mugino.
Dialogue: 0,0:14:11.66,0:14:12.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mugino.
Dialogue: 0,0:14:12.79,0:14:14.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm?
Dialogue: 0,0:14:15.83,0:14:18.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu di sini?
Dialogue: 0,0:14:18.00,0:14:19.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya kasurnya kurang.
Dialogue: 0,0:14:21.72,0:14:26.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gara-gara ada dua anak baru,\Npembagian kamar jadi kacau.
Dialogue: 0,0:14:27.18,0:14:30.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sialnya uang operasional kita\Nsedang dibekukan,
Dialogue: 0,0:14:30.31,0:14:33.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi belum bisa beli furnitur baru.
Dialogue: 0,0:14:33.81,0:14:36.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah seminggu kita membahas ini, lo.
Dialogue: 0,0:14:37.90,0:14:43.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan berarti boleh menyelinap\Nke kasur orang seenaknya, kan?
Dialogue: 0,0:14:43.65,0:14:47.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suruh saja dua anak baru itu\Nbikin kasur sendiri.
Dialogue: 0,0:14:47.91,0:14:51.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan bukankah kamu bilang mau lari pagi
Dialogue: 0,0:14:51.41,0:14:54.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebelum cuaca makin panas?
Dialogue: 0,0:14:57.58,0:15:01.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak sadar\Nsudah kubangunkan tiga kali?
Dialogue: 0,0:15:02.30,0:15:05.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mataharinya sudah makin tinggi, lo?
Dialogue: 0,0:15:05.97,0:15:07.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya, aku ngantuk.
Dialogue: 0,0:15:07.72,0:15:10.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, sudah gagal total.
Dialogue: 0,0:15:10.60,0:15:13.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dunia tidak kiamat hari ini.
Dialogue: 0,0:15:13.56,0:15:16.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai besok juga bisa, kan?
Dialogue: 0,0:15:16.65,0:15:21.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Misal bilang begitu, tampar bokongku saja\Nsampai bangun dari kasur."
Dialogue: 0,0:15:21.07,0:15:24.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu amanat darimu semalam.
Dialogue: 0,0:15:24.11,0:15:25.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nih.
Dialogue: 0,0:15:25.86,0:15:29.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suaramu yang kuinput ke IC Recorder.
Dialogue: 0,0:15:29.58,0:15:31.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial.
Dialogue: 0,0:15:31.12,0:15:34.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin mengutuk diriku\Nyang sok rajin semalam.
Dialogue: 0,0:15:35.41,0:15:38.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanabata! Tanabata!
Dialogue: 0,0:15:38.88,0:15:42.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tana, tana, tana, tana, Tanabata!\N- Pagi-pagi semangat sekali.
Dialogue: 0,0:15:42.92,0:15:45.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tana, tana, tana, tana, Tanabata!\N- Lukamu sudah sembuh?
Dialogue: 0,0:15:46.05,0:15:47.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah, dong!
Dialogue: 0,0:15:48.26,0:15:51.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di meja ada kertas harapan,\Ntulislah keinginanmu!
Dialogue: 0,0:15:51.18,0:15:52.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti kugantung!
Dialogue: 0,0:15:52.76,0:15:54.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keinginan?
Dialogue: 0,0:15:54.43,0:15:57.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa gunanya di Kota Akademi\Nyang serbacanggih ini?
Dialogue: 0,0:15:57.52,0:16:00.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kertas harapan itu akhirnya diapakan?
Dialogue: 0,0:16:00.56,0:16:03.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya tidak asal dibuang, kan?
Dialogue: 0,0:16:03.36,0:16:05.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana kutahu soal mantra begituan.
Dialogue: 0,0:16:11.66,0:16:17.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, rasanya ingin mengutuk\Nhawa musim panas dan lemahnya kakiku.
Dialogue: 0,0:16:18.54,0:16:22.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini gara-gara keseringan makan roti.
Dialogue: 0,0:16:22.34,0:16:24.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Budaya gandum itu dalangnya.
Dialogue: 0,0:16:25.01,0:16:27.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak cocok sama panjang usus\Norang Jepang.
Dialogue: 0,0:16:28.47,0:16:29.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar makanan barat.
Dialogue: 0,0:16:38.10,0:16:40.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ja-Jadi begini...
Dialogue: 0,0:16:41.69,0:16:46.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di koloseum, mereka memanfaatkan\Nasuransi kematian bernilai fantastis
Dialogue: 0,0:16:46.65,0:16:49.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk mendapat uang hadiah juaranya.
Dialogue: 0,0:16:49.86,0:16:54.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan mengeklaim asuransi\Ndari seluruh peserta kecuali sang juara.
Dialogue: 0,0:16:54.41,0:16:55.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ratusan juta, lo?
Dialogue: 0,0:16:55.87,0:16:59.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa transaksi sebesar itu\Ntidak dicurigai?
Dialogue: 0,0:16:59.21,0:17:02.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Se-Seharusnya memang mustahil!
Dialogue: 0,0:17:02.63,0:17:05.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiap ada transaksi kontrak\Natau pembayaran tidak wajar,
Dialogue: 0,0:17:05.96,0:17:09.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}alarm otomatis di peladen pusat\Nakan langsung merespons.
Dialogue: 0,0:17:09.58,0:17:13.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, pasti ketahuan!
Dialogue: 0,0:17:14.84,0:17:16.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus?
Dialogue: 0,0:17:20.14,0:17:23.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Makanya aku\Ndiancam para dalang utama
Dialogue: 0,0:17:23.31,0:17:28.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}buat akses peladen pusat lewat jaringan\Ninternal dan otak-atik pengaturannya!
Dialogue: 0,0:17:28.90,0:17:30.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya aku minta bantuan kalian!
Dialogue: 0,0:17:30.82,0:17:34.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa minta tolong\Nke Anti Skill biasa!
Dialogue: 0,0:17:34.28,0:17:36.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena perkara ini harus tertutup,
Dialogue: 0,0:17:36.45,0:17:41.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}membereskannya di sisi gelap\Nadalah opsi terbaik!
Dialogue: 0,0:17:41.42,0:17:45.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya tidak kujelaskan detail\Nsaat minta tolong.
Dialogue: 0,0:17:45.09,0:17:47.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena walaupun masalahnya beres,
Dialogue: 0,0:17:47.75,0:17:51.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku ogah kena pemerasan\Nkarena alasan yang sama.
Dialogue: 0,0:17:52.43,0:17:56.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma mau melindungi\Nkeluargaku yang tidak berdosa.
Dialogue: 0,0:18:02.64,0:18:04.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat pagi.
Dialogue: 0,0:18:04.44,0:18:05.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:18:05.44,0:18:07.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu juga habis lari pagi?
Dialogue: 0,0:18:07.44,0:18:08.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pagi?
Dialogue: 0,0:18:08.69,0:18:13.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, dari tadi aku nonton film\Ndi bioskop bawah.
Dialogue: 0,0:18:13.28,0:18:14.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tujuh film berturut-turut.
Dialogue: 0,0:18:15.37,0:18:20.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena nonton dari kemarin malam,\Nbadanku jadi super kaku.
Dialogue: 0,0:18:20.50,0:18:23.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya aku mau peregangan\Nsebelum tidur.
Dialogue: 0,0:18:23.17,0:18:24.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Film, ya?
Dialogue: 0,0:18:24.75,0:18:27.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di tempat kita juga ada layar lebar, kan?
Dialogue: 0,0:18:27.92,0:18:30.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu memang super sayang\Nbuat dilewatkan,
Dialogue: 0,0:18:30.59,0:18:32.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi bioskop asli lebih oke.
Dialogue: 0,0:18:32.80,0:18:35.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira tempat itu bioskop gaul\Nkhusus pasangan,
Dialogue: 0,0:18:35.89,0:18:38.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ternyata isinya\Npara pencinta film sungguhan.
Dialogue: 0,0:18:38.14,0:18:44.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bioskop yang memutar film Zombie Panic\NAmerika Selatan itu jarang banget!
Dialogue: 0,0:18:44.52,0:18:46.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sesuka itu sama film?
Dialogue: 0,0:18:46.40,0:18:50.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya pas dikurung di fasilitas penelitian,\Nhiburanku sedikit banget.
Dialogue: 0,0:18:51.69,0:18:56.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin mereka takut kalau aku dikasih mainan,\Nmalah akan mencelakai orang.
Dialogue: 0,0:18:57.95,0:19:01.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak-anak subjek penelitian\Ndikumpulkan di ruangan putih bersih
Dialogue: 0,0:19:01.66,0:19:05.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu cuma diputarkan film\Nlewat layar buat presentasi.
Dialogue: 0,0:19:05.54,0:19:07.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, itu terukir di ingatanku.
Dialogue: 0,0:19:09.17,0:19:13.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, mungkin filmnya disusupi\Npesan tersembunyi
Dialogue: 0,0:19:13.80,0:19:18.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau frekuensi tingkat rendah\Nyang entah apa maksudnya.
Dialogue: 0,0:19:18.55,0:19:22.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo? Berarti pas kita cek misi waktu itu...
Dialogue: 0,0:19:22.72,0:19:24.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, benar.
Dialogue: 0,0:19:24.43,0:19:25.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesuai dugaanmu,
Dialogue: 0,0:19:25.85,0:19:31.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}itu bioskop pertama yang sejak dulu\Nkuimpikan dalam hidup.
Dialogue: 0,0:19:31.65,0:19:37.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gara-gara ada si Super Bodoh\Nyang menyebar berkas pembunuhan di sana.
Dialogue: 0,0:19:37.61,0:19:39.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Turut berduka cita, deh.
Dialogue: 0,0:19:40.87,0:19:44.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku ingin\Nkerja paruh waktu di bioskop...
Dialogue: 0,0:19:44.20,0:19:44.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba saja.
Dialogue: 0,0:19:44.75,0:19:45.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}E-Eh?
Dialogue: 0,0:19:46.04,0:19:48.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Palsukan sendiri KTP-mu, ya.
Dialogue: 0,0:19:48.42,0:19:50.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh ambil kerjaan lain?
Dialogue: 0,0:19:50.29,0:19:52.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada larangan khusus, kok.
Dialogue: 0,0:19:52.38,0:19:57.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seingatku, Frenda juga pernah\Ncoba-coba kerja di tempat lain.
Dialogue: 0,0:19:57.22,0:19:58.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba-coba?
Dialogue: 0,0:19:58.55,0:20:02.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya dia spesialis peledak?
Dialogue: 0,0:20:02.35,0:20:06.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih tepatnya, ilmu kimia\Ntermasuk peledak dan bahan sejenisnya.
Dialogue: 0,0:20:06.94,0:20:09.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, ini bukan aksi penyelidikan\Ndemi keadilan,
Dialogue: 0,0:20:10.15,0:20:13.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi lebih ke arah mencari tahu\Nsiapa yang menyerang teman kita
Dialogue: 0,0:20:13.69,0:20:16.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk target balas dendam.
Dialogue: 0,0:20:16.82,0:20:20.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, aman selama tidak mengusik\Npekerjaan utama kita.
Dialogue: 0,0:20:20.12,0:20:24.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya, apa ada perkembangan\Nsoal pekerjaan kita?
Dialogue: 0,0:20:24.70,0:20:28.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski sudah tanya\Nke anak Skill Out dunia bawah,
Dialogue: 0,0:20:28.25,0:20:31.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}informasi soal koloseum\Nsama sekali tidak muncul.
Dialogue: 0,0:20:32.13,0:20:36.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu-satunya petunjuk cuma rekaman\Nobrolan direktur yang dicoba diputar ulang,
Dialogue: 0,0:20:36.59,0:20:38.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hasilnya tetap nihil.
Dialogue: 0,0:20:38.47,0:20:41.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti buntu?
Dialogue: 0,0:20:45.27,0:20:47.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buntu, ya?
Dialogue: 0,0:20:48.23,0:20:50.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang dengan informasi yang ada,
Dialogue: 0,0:20:50.27,0:20:52.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami tidak akan sampai ke koloseum.
Dialogue: 0,0:20:53.11,0:20:54.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:20:54.32,0:20:56.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selesai!
Dialogue: 0,0:20:56.57,0:21:00.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga tidak ada satu pun\Nanggota ITEM yang terluka!
Dialogue: 0,0:21:00.45,0:21:02.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Super baik hati, ya.
Dialogue: 0,0:21:02.12,0:21:03.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jelas!
Dialogue: 0,0:21:03.66,0:21:09.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga mau uang, jabatan, kehormatan, libur,\Npopularitas, dan teman, tanda seru dua kali.
Dialogue: 0,0:21:09.66,0:21:14.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bisa, pakai tanda seru\Nlima kali lebih banyak.
Dialogue: 0,0:21:14.34,0:21:16.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Super serakah, ya.
Dialogue: 0,0:21:16.00,0:21:17.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jelas!
Dialogue: 0,0:21:17.38,0:21:20.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, kalian semua juga tulis!\NAyo gantung!
Dialogue: 0,0:21:21.18,0:21:23.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak ada keinginan khusus.
Dialogue: 0,0:21:23.43,0:21:26.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya hiasan Tanabata\Nkayak begitu?
Dialogue: 0,0:21:27.60,0:21:28.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin?
Dialogue: 0,0:21:29.43,0:21:30.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kutulis.
Dialogue: 0,0:21:30.52,0:21:31.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunjukkan!
Dialogue: 0,0:21:31.56,0:21:33.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak boleh!\NMalu, tahu!
Dialogue: 0,0:21:33.98,0:21:35.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa, sih?
Dialogue: 0,0:21:35.48,0:21:37.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah dipasang,\Nsemuanya bisa lihat, kan?
Dialogue: 0,0:21:37.73,0:21:40.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sih sudah beda kasus!
Dialogue: 0,0:21:40.49,0:21:43.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dilihat tanpa kusadari oke saja,
Dialogue: 0,0:21:43.95,0:21:48.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kalau harapan yang baru ditulis\Nlangsung dibacakan, akan memalukan!
Dialogue: 0,0:21:48.91,0:21:50.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak malu sama sekali, kok!
Dialogue: 0,0:21:50.96,0:21:52.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Intinya malu!
Dialogue: 0,0:21:52.21,0:21:53.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya ogah!
Dialogue: 0,0:21:53.25,0:21:54.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanano!
Dialogue: 0,0:21:54.08,0:21:55.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ampun, Paduka! Ampun!
Dialogue: 0,0:21:55.96,0:21:58.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Aku mau bahas pekerjaan.
Dialogue: 0,0:21:59.76,0:22:01.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Giliranmu, Hanano.
Dialogue: 0,0:22:01.84,0:22:05.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita pakai rencana yang memakai dirimu.
