Dialogue: 0,0:03:38.99,0:03:40.06,sign,,0000,0000,0000,,DISTRIK 3
Dialogue: 0,0:08:37.15,0:08:37.76,sign,,0000,0000,0000,,MASUKKAN KATA SANDI ANDA
Dialogue: 0,0:08:37.76,0:08:39.58,sign,,0000,0000,0000,,EROR\NKATA SANDI YANG ANDA MASUKKAN SALAH
Dialogue: 0,0:14:14.50,0:14:16.96,sign,,0000,0000,0000,,EPISODE 5: PENYUSUPAN
Dialogue: 0,0:15:53.56,0:15:54.30,sign,,0000,0000,0000,,MASAKAN TIONGHOA SUPER ILMIAH
Dialogue: 0,0:16:21.60,0:16:22.32,sign,,0000,0000,0000,,EDISI TERBATAS MUSIM PANAS
Dialogue: 0,0:16:22.32,0:16:23.47,sign,,0000,0000,0000,,MI DINGIN MUSIM PANAS
Dialogue: 0,0:17:23.73,0:17:25.69,sign,,0000,0000,0000,,CABAI BUBUK
Dialogue: 0,0:18:42.68,0:18:44.82,sign,,0000,0000,0000,,TUNDA\NMATIKAN
Dialogue: 0,0:21:25.39,0:21:26.10,sign,,0000,0000,0000,,7 JULI, 16.04
Dialogue: 0,0:21:26.10,0:21:27.47,sign,,0000,0000,0000,,PESAN BARU DARI MUGINO SHIZURI
Dialogue: 0,0:23:34.97,0:23:35.50,sign,,0000,0000,0000,,A CERTAIN ITEM OF DARK SIDE
Dialogue: 0,0:23:35.50,0:23:39.98,sign,,0000,0000,0000,,EPISODE 6: KOLOSEUM
Dialogue: 0,0:00:04.28,0:00:06.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pulang.
Dialogue: 0,0:00:21.95,0:00:25.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sip, kondisi badan ini lumayan oke.
Dialogue: 0,0:00:25.59,0:00:27.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:00:28.24,0:00:33.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pria usia 52 tahun,\Nrambut hitam agak berminyak.
Dialogue: 0,0:00:33.23,0:00:35.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Persebaran uban lihat di lembar terpisah.
Dialogue: 0,0:00:36.19,0:00:38.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jenis kulit rona dasar dingin,\Nagak berminyak.
Dialogue: 0,0:00:39.15,0:00:42.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pupil hitam bercampur sedikit cokelat.
Dialogue: 0,0:00:42.43,0:00:46.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tekstur kulitnya dibuat\Nsedikit lebih kasar, deh.
Dialogue: 0,0:00:47.03,0:00:50.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, direktur eksekutif juga tidak merokok.
Dialogue: 0,0:00:50.03,0:00:52.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bau rokok pantangan banget, nih.
Dialogue: 0,0:00:53.22,0:00:57.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tinggal pakai tablet penyegar tanpa bau.
Dialogue: 0,0:00:58.42,0:01:02.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pakai bahasa standar\Ncampur sedikit logat Tokai.
Dialogue: 0,0:01:02.76,0:01:07.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mata kering dan ada pegal-pegal\Ndari leher sampai kedua bahu.
Dialogue: 0,0:01:07.41,0:01:10.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Condong bertumpu ke kanan saat berdiri.
Dialogue: 0,0:01:10.74,0:01:13.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cara memegang sumpitnya salah.
Dialogue: 0,0:01:13.15,0:01:15.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cenderung menjawab\Ndengan balik bertanya.
Dialogue: 0,0:01:16.18,0:01:18.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suka meremehkan orang\Nyang jabatannya lebih rendah.
Dialogue: 0,0:01:18.72,0:01:21.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau panik, bernapas lewat mulut.
Dialogue: 0,0:01:21.72,0:01:23.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini saatnya, Hanano.
Dialogue: 0,0:01:23.22,0:01:25.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita manfaatkan dirimu.
Dialogue: 0,0:01:26.10,0:01:28.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Percuma menanyakan\Norang-orang dunia bawah,
Dialogue: 0,0:01:28.99,0:01:31.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}info soal koloseum tidak akan keluar.
Dialogue: 0,0:01:31.62,0:01:35.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Petunjuk kita cuma direktur eksekutif\Nperusahaan asuransi itu.
Dialogue: 0,0:01:36.00,0:01:37.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya, Hanano.
Dialogue: 0,0:01:37.14,0:01:38.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, iya!
Dialogue: 0,0:01:38.08,0:01:43.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tugasmu adalah mencari tahu siapa\Nyang membayar dan menerima asuransi.
Dialogue: 0,0:01:43.46,0:01:46.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Langsung dari server pusat kantor mereka.
Dialogue: 0,0:01:46.00,0:01:48.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, tapi aku tidak bisa meretas server...
Dialogue: 0,0:01:48.98,0:01:52.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bukan sesuatu yang bisa\Ndiretas dari luar.
Dialogue: 0,0:01:52.14,0:01:54.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru di situlah tugasmu.
Dialogue: 0,0:01:54.55,0:01:58.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyamarlah jadi direktur\Ndan masuklah lewat pintu depan.
Dialogue: 0,0:01:59.74,0:02:02.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kira-kira begini, ya?
Dialogue: 0,0:02:03.52,0:02:08.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau punya teman yang bisa diajak\Ncosplay Magical Powered Kanamin.
Dialogue: 0,0:03:40.06,0:03:41.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aduh.
Dialogue: 0,0:03:41.86,0:03:44.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Badanku rasanya kaku banget.
Dialogue: 0,0:03:44.42,0:03:46.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mobil bak tidak nyaman.
Dialogue: 0,0:03:46.78,0:03:47.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujungnya,
Dialogue: 0,0:03:47.89,0:03:52.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau dana operasional menipis,\Nterpaksa harus hemat dari hal begini.
Dialogue: 0,0:03:54.85,0:03:56.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang main kembang api?
Dialogue: 0,0:03:58.34,0:03:59.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terbuka!
Dialogue: 0,0:03:59.46,0:04:00.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terbang ke arah sana!
Dialogue: 0,0:04:00.46,0:04:02.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak-anak ceria, ya.
Dialogue: 0,0:04:02.36,0:04:06.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujungnya, belum libur musim panas,\Ntapi sudah main bolos?
Dialogue: 0,0:04:06.00,0:04:07.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin hari ulang tahun sekolah?
Dialogue: 0,0:04:07.94,0:04:12.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Frenda yang bisa mencium bau mesiu\Ndari jarak sejauh ini dengan antusias
Dialogue: 0,0:04:12.29,0:04:14.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}justru super tidak normal.
Dialogue: 0,0:04:15.12,0:04:17.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Frenda, kurasa itu bukan pujian.
Dialogue: 0,0:04:17.57,0:04:19.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kinuhata benaran jijik, lo.
Dialogue: 0,0:04:19.35,0:04:23.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, Mugino.\NKamu yakin mengirim Hanano?
Dialogue: 0,0:04:23.33,0:04:25.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke perusahaan om-om itu, kan?
Dialogue: 0,0:04:25.21,0:04:30.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujungnya, padahal tinggal menyusup\Npakai pesona imutku.
Dialogue: 0,0:04:30.74,0:04:32.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biasanya iya.
Dialogue: 0,0:04:32.38,0:04:37.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi mumpung ada ahli penyamaran,\Nmending pakai dia saja.
Dialogue: 0,0:04:37.30,0:04:39.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Sebal!"\NAku harus bilang begitu?
Dialogue: 0,0:04:39.76,0:04:43.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jatah kerjaku direbut, nih!
Dialogue: 0,0:04:43.22,0:04:48.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru Mugino khawatir padamu.\NSoalnya pakai pesona itu berisiko.
Dialogue: 0,0:04:48.65,0:04:50.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu!
Dialogue: 0,0:04:50.02,0:04:53.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, mereka tidak akan\Nkubiarkan menyentuh!
Dialogue: 0,0:04:53.66,0:04:59.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujungnya, pas lagi memancing,\Nharus jaga batasan tipis yang tidak terlihat!
Dialogue: 0,0:04:59.73,0:05:01.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanano, kamu bisa?
Dialogue: 0,0:05:01.81,0:05:03.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bi-Bisa.
Dialogue: 0,0:05:05.09,0:05:09.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}E-Entah penyusupan ini\Nberhasil atau tidak,
Dialogue: 0,0:05:09.80,0:05:12.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku pasti dilihat banyak orang, kan?
Dialogue: 0,0:05:12.72,0:05:17.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayaknya direktur yang asli juga\Nbisa ditangkap atas dugaan penyelewengan.
Dialogue: 0,0:05:17.08,0:05:18.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus kenapa?
Dialogue: 0,0:05:18.53,0:05:23.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sampah yang tidak lapor ke Anti-Skill\Nmeski tahu ada banyak orang mati
Dialogue: 0,0:05:23.38,0:05:28.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan nekat melakukan penyelewengan\Ndi perusahaan sendiri agar bisa selamat.
Dialogue: 0,0:05:28.21,0:05:30.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kalau dia punya keluarga,
Dialogue: 0,0:05:30.36,0:05:34.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebaiknya kasih tahu keluarganya\Nbiar cerai secepatnya.
Dialogue: 0,0:05:34.53,0:05:36.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ide bagus.
Dialogue: 0,0:05:36.74,0:05:41.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau baru sibuk cerai\Nsetelah si bodoh itu ditangkap,
Dialogue: 0,0:05:41.30,0:05:45.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa-bisa keluarganya dianggap terlibat\Ndan harus ikut bayar ganti rugi.
Dialogue: 0,0:05:45.76,0:05:49.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Iya, kan?\N- Inilah nasihat terbaik dari empati mereka,
Dialogue: 0,0:05:49.29,0:05:51.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi sisi gelap itu asli seramnya.
Dialogue: 0,0:05:51.80,0:05:55.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kebetulan ini jam masuk kerja\Npara pejabat eksekutif.
Dialogue: 0,0:05:55.21,0:05:55.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanano.
Dialogue: 0,0:05:55.96,0:05:56.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya!
Dialogue: 0,0:05:56.93,0:05:59.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masukilah gedung perusahaan asuransi\Nsebagai si direktur.
Dialogue: 0,0:05:59.89,0:06:02.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Langsung lewat pintu depan.
Dialogue: 0,0:06:02.96,0:06:04.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelahnya?
Dialogue: 0,0:06:04.06,0:06:09.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Naik elevator khusus lantai atas\Npakai kartu akses staf eksekutif
Dialogue: 0,0:06:09.24,0:06:11.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan langsung ke ruang server pusat.
Dialogue: 0,0:06:11.56,0:06:17.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti saat pakai elevator di lantai satu,\Nusahakan sendirian, ya?
Dialogue: 0,0:06:17.28,0:06:18.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, mantap.
Dialogue: 0,0:06:18.66,0:06:19.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nih.
Dialogue: 0,0:06:19.38,0:06:22.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu kamu hubungkan alat itu\Nke server pusat pakai kabel,
Dialogue: 0,0:06:22.49,0:06:25.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}programnya bakal otomatis\Nmenyedot data yang diperlukan.
Dialogue: 0,0:06:25.85,0:06:28.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak usah berbuat yang tidak perlu.
Dialogue: 0,0:06:28.21,0:06:30.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sampai ketahuan\Ndi resepsionis, ya.
Dialogue: 0,0:06:31.16,0:06:32.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tent...
Dialogue: 0,0:06:34.21,0:06:36.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja.
Dialogue: 0,0:06:36.13,0:06:38.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan meremehkanku.
Dialogue: 0,0:06:42.37,0:06:45.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, aku masuk.
Dialogue: 0,0:06:47.38,0:06:50.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jalur komunikasi dan kamera pengawas\Naman, Hanano.
Dialogue: 0,0:06:51.18,0:06:54.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, melewati semua kamera pengawas\Ndi gedung target?
Dialogue: 0,0:06:54.93,0:06:57.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujungnya, bagaimana caranya menyusup?
Dialogue: 0,0:06:58.10,0:07:02.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua kabel serat optik kamera pengawas\Nawalnya digabung jadi satu jalur besar
Dialogue: 0,0:07:02.14,0:07:06.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebelum dikirim ke perusahaan keamanan.
Dialogue: 0,0:07:06.44,0:07:10.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, tinggal retas bagian itu\Nbuat memantau videonya.
Dialogue: 0,0:07:10.04,0:07:14.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu urusan para pegawai di sana,\Naku sendiri kurang paham.
Dialogue: 0,0:07:14.17,0:07:16.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Apa-apaan kamu?
Dialogue: 0,0:07:16.04,0:07:18.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Apa salahnya kalau aku datang jalan kaki?\N- Lo? Dia ketahuan?
Dialogue: 0,0:07:18.75,0:07:21.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kenapa para eksekutif harus datang pakai mobil?\N- Super bagaimana ini?
Dialogue: 0,0:07:21.38,0:07:23.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Karena sering bolos tanpa izin,\N- Bu-Bukan begitu, Pak.
Dialogue: 0,0:07:23.68,0:07:24.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- mungkin akunnya dikasih tanda peringatan?\N- Bu-Bukan begitu, Pak.
Dialogue: 0,0:07:24.81,0:07:26.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- mungkin akunnya dikasih tanda peringatan?\N- Biasanya Anda datang naik mobil,
Dialogue: 0,0:07:26.54,0:07:28.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tapi bahaya kalau dia emosi dan keceplosan\N- saya cuma khawatir terjadi sesuatu.
Dialogue: 0,0:07:28.80,0:07:31.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- soal liburan bareng selingkuhan,\N- saya cuma khawatir terjadi sesuatu.
Dialogue: 0,0:07:31.85,0:07:33.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- jadi tidak ada pegawai\N- Baguslah kalau kamu paham.
Dialogue: 0,0:07:33.19,0:07:35.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- yang berani tanya blak-blakan.\N- Baguslah kalau kamu paham.
Dialogue: 0,0:07:40.88,0:07:43.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Cepat! Cepat! Cepat!\N- Ujungnya,
Dialogue: 0,0:07:43.78,0:07:46.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bergumam begitu berbahaya, ada apa?
Dialogue: 0,0:07:46.30,0:07:48.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bikin tantangan khusus?
Dialogue: 0,0:07:48.06,0:07:50.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma nonton sih gampang!
Dialogue: 0,0:07:50.54,0:07:53.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyawa dan masa depanku\Njadi taruhannya, lo!
Dialogue: 0,0:07:53.34,0:07:55.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan tinggalkan aku\Nkalau ada masalah, ya?
Dialogue: 0,0:07:55.78,0:07:56.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Janji, ya?
Dialogue: 0,0:07:58.50,0:08:03.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mugino, ruang server pusat\Nada di lantai berapa?
Dialogue: 0,0:08:03.74,0:08:05.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lantai 28.
Dialogue: 0,0:08:05.40,0:08:10.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanano, kamu tidak akan bisa lari\Nkalau dikepung tim keamanan.
Dialogue: 0,0:08:11.18,0:08:13.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian akan aku kutuk!
Dialogue: 0,0:08:14.44,0:08:18.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa yang makan berondong jagung\Ndi dekat mikrofon itu?
Dialogue: 0,0:08:18.10,0:08:21.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, parah banget malah begitu.
Dialogue: 0,0:08:29.84,0:08:32.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini ruang server pusat?
Dialogue: 0,0:08:34.01,0:08:37.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kata sandinya sepuluh digit.
Dialogue: 0,0:08:39.58,0:08:41.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, kok begini?
Dialogue: 0,0:08:41.70,0:08:44.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok tidak mau terbuka?
Dialogue: 0,0:08:45.52,0:08:47.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang sebenarnya terjadi?
Dialogue: 0,0:08:47.74,0:08:53.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya kamu sudah sepekan penuh mengulik\Ndirektur dari sidik jari sampai pupilnya?
Dialogue: 0,0:08:53.36,0:08:55.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masalahnya di sepekan itu!
Dialogue: 0,0:08:55.85,0:08:58.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kode pintunya ternyata diganti tiap pekan.
Dialogue: 0,0:08:58.86,0:09:03.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Artinya, data direktur yang kita punya\Ncuma berlaku sampai tanggal 1 Juli,
Dialogue: 0,0:09:03.72,0:09:07.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi aku tidak tahu kata sandi\Nyang benar untuk pekan ini!
Dialogue: 0,0:09:07.40,0:09:09.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti?
Dialogue: 0,0:09:10.42,0:09:12.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak punya teknik cadangan?
Dialogue: 0,0:09:12.86,0:09:17.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, kalau ada bencana besar\Nyang bisa meruntuhkan gedung ini,
Dialogue: 0,0:09:17.66,0:09:23.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}semua kunci pintu akan terbuka\Ndemi keselamatan nyawa pekerja.
Dialogue: 0,0:09:25.22,0:09:27.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Frenda, jangan kabur.
Dialogue: 0,0:09:28.80,0:09:30.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Frenda, awasi sekitar.
Dialogue: 0,0:09:30.69,0:09:33.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Duh, kucegah juga tidak mempan, ya.\N- Takitsubo, pakai itu.
Dialogue: 0,0:09:33.26,0:09:34.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap.
Dialogue: 0,0:09:34.22,0:09:36.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, ayo bergerak!
Dialogue: 0,0:09:36.22,0:09:37.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, deh.
Dialogue: 0,0:09:38.02,0:09:43.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujungnya, tidak ada warga sipil malang\Nyang menyaksikan kejahatan sisi gelap.
Dialogue: 0,0:09:48.16,0:09:50.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sensor mendeteksi kejanggalan.
Dialogue: 0,0:09:50.36,0:09:51.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Staf dan karyawan\N- A-Apa yang kamu lakukan, sih?
Dialogue: 0,0:09:51.76,0:09:52.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- harap evakuasi ke luar gedung.\N- A-Apa yang kamu lakukan, sih?
Dialogue: 0,0:09:52.98,0:09:54.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- harap evakuasi ke luar gedung.\N- Kok masih tanya?
Dialogue: 0,0:09:54.20,0:09:57.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua kunci pintu bakal terbuka\Nkalau ada bencana besar, kan?
Dialogue: 0,0:09:57.58,0:09:59.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku pakai cara cepat.
Dialogue: 0,0:10:00.42,0:10:02.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja.
Dialogue: 0,0:10:02.01,0:10:07.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma menghancurkan bagian\Nyang sudah dipastikan kosong oleh Takitsubo.
Dialogue: 0,0:10:07.37,0:10:11.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mugino hebat, dia sadar\Nharus hemat anggaran.
Dialogue: 0,0:10:11.14,0:10:14.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi gedung ini punya\Nperusahaan biasa, lo.
Dialogue: 0,0:10:14.86,0:10:19.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bikin gaduh separah ini,\Nmusuh bebuyutan sisi gelap akan tahu!
Dialogue: 0,0:10:19.69,0:10:23.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bakal dikejar oleh peringkat 6 itu
Dialogue: 0,0:10:23.34,0:10:26.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- lalu disikat di sudut gang sempit!\N- Hei, Hanano.
Dialogue: 0,0:10:26.00,0:10:28.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pintu di depanmu masih tertutup?
Dialogue: 0,0:10:28.40,0:10:32.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku masih harus menembak\Nbagian yang vital, ya?
Dialogue: 0,0:10:32.09,0:10:34.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau pilar utama atau struktur\Npenahan gempanya?
Dialogue: 0,0:10:34.50,0:10:37.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, iya!\NPintunya terbuka!
Dialogue: 0,0:10:37.05,0:10:40.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah cukup, terima kasih bantuannya!
Dialogue: 0,0:10:41.37,0:10:42.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar cewek monster!
Dialogue: 0,0:10:42.69,0:10:43.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:10:43.53,0:10:45.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayaknya yang terakhir itu
Dialogue: 0,0:10:45.61,0:10:47.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- isi hatinya yang bocor.\N- Aku sudah terhubung ke server!
Dialogue: 0,0:10:47.38,0:10:51.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Dan orangnya tidak sadar sudah keceplosan.\N- Sedang proses menyedot data!
Dialogue: 0,0:10:51.69,0:10:52.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya sudahlah.
Dialogue: 0,0:10:52.90,0:10:55.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujungnya, wajar di situasi begitu.
Dialogue: 0,0:10:55.88,0:10:57.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sialan.
Dialogue: 0,0:10:59.49,0:11:04.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa data ini benaran bisa menunjukkan\Nke siapa uang klaim asuransi bakal cair
Dialogue: 0,0:11:04.36,0:11:07.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}saat peserta koloseum tewas?
Dialogue: 0,0:11:07.29,0:11:10.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya, garis besarnya bakal jelas.
Dialogue: 0,0:11:10.30,0:11:13.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau pakai nama palsu atau ID buatan,
Dialogue: 0,0:11:13.15,0:11:15.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tetap akan meninggalkan jejak.
Dialogue: 0,0:11:15.72,0:11:19.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau bisa saja pakai tumbal\Nkayak modus penipuan transfer bank.
Dialogue: 0,0:11:19.26,0:11:19.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:11:20.13,0:11:23.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau yang di sini\Ntidak ada hasilnya?
Dialogue: 0,0:11:23.96,0:11:26.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya, pasti ada hasilnya.
Dialogue: 0,0:11:27.16,0:11:30.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si Dalang memang dijaga ketat.
Dialogue: 0,0:11:30.50,0:11:33.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, tidak dengan peserta\Nyang jadi tumbal.
Dialogue: 0,0:11:33.82,0:11:35.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tidak cari mayat atau pelakunya,
Dialogue: 0,0:11:35.82,0:11:39.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi pemegang polis asuransi\Nyang masih hidup.
Dialogue: 0,0:11:39.68,0:11:41.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syarat utamanya,
Dialogue: 0,0:11:41.48,0:11:45.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pelajar usia belasan tahun,\Nklaim kematiannya bernilai ratusan juta,
Dialogue: 0,0:11:45.62,0:11:49.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan polisnya baru dibuat\Ndalam sebulan terakhir.
Dialogue: 0,0:11:49.62,0:11:51.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau nama dan wajahnya ketemu,
Dialogue: 0,0:11:51.62,0:11:55.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita tinggal membuntutinya\Nsampai ke koloseum.
Dialogue: 0,0:11:55.76,0:11:58.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:11:59.88,0:12:01.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah selesai.
Dialogue: 0,0:12:01.36,0:12:02.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mundur sekarang.
Dialogue: 0,0:12:03.36,0:12:04.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo?
Dialogue: 0,0:12:05.25,0:12:07.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sistemnya mati total\Ngara-gara ledakan barusan!
Dialogue: 0,0:12:09.37,0:12:12.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Turun saja lewat tangga!\NLumayan buat olahraga!
Dialogue: 0,0:12:13.97,0:12:17.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar Dewa Penghancur\Ntukang meratakan daratan!
Dialogue: 0,0:12:18.46,0:12:21.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanano keceplosan lagi.
Dialogue: 0,0:12:21.93,0:12:23.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tipe ceroboh yang imut.
Dialogue: 0,0:12:23.88,0:12:27.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan level ceroboh lagi,\Ntapi tipe yang gampang mati.
Dialogue: 0,0:12:27.84,0:12:29.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mugino! Tahan, tahan!
Dialogue: 0,0:12:29.49,0:12:32.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mau dijadikan arang,\Nminimal tunggu dia pulang!
Dialogue: 0,0:12:35.40,0:12:37.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Turun 28 lantai
Dialogue: 0,0:12:37.32,0:12:40.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sudah setara menuruni gunung kecil, lo.
Dialogue: 0,0:12:41.21,0:12:43.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banjir keringat di bawah topeng pula.
Dialogue: 0,0:12:43.00,0:12:45.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kulit palsunya terasa bakal meleleh...
Dialogue: 0,0:12:46.18,0:12:47.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baru juga dibilang!
Dialogue: 0,0:12:47.92,0:12:50.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat, kalau ada yang lewat...
Dialogue: 0,0:12:50.20,0:12:52.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cek sekilas tiap lantai.
Dialogue: 0,0:12:52.65,0:12:55.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Regu A dan B ikut denganku.
Dialogue: 0,0:12:57.14,0:12:58.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada seseorang di sana?
Dialogue: 0,0:12:58.54,0:13:00.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus, Pak!
Dialogue: 0,0:13:01.09,0:13:02.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu datang dari atas?
Dialogue: 0,0:13:02.62,0:13:03.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajahmu asing...
Dialogue: 0,0:13:03.33,0:13:04.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:13:04.52,0:13:06.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar sekali, Pak!
Dialogue: 0,0:13:06.22,0:13:08.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya sudahlah.
Dialogue: 0,0:13:08.98,0:13:11.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Langsung gabung dengan\Nregu lainnya di bawah.
Dialogue: 0,0:13:11.44,0:13:13.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Laksanakan!
Dialogue: 0,0:13:19.48,0:13:24.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untung aku menyiapkan penyamaran\Ntim keamanan untuk kondisi darurat.
Dialogue: 0,0:13:24.80,0:13:28.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di situasi seperti ini, gertakan spontan\Nmemang paling ampuh.
Dialogue: 0,0:13:28.42,0:13:33.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanano, mau menyamar jadi apa pun,\Nkamu tetap direkam kamera pengawas.
Dialogue: 0,0:13:33.60,0:13:37.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mau jalan pintas yang enak,\Nlihatlah dinding bagian dalam.
Dialogue: 0,0:13:46.68,0:13:47.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:13:47.09,0:13:50.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa yang kamu lakukan?
Dialogue: 0,0:13:50.30,0:13:55.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya kamu yang minta\Njangan ditelantarkan saat terpojok?
Dialogue: 0,0:13:55.45,0:13:56.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo cepat.
Dialogue: 0,0:13:57.05,0:13:58.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, sebentar.
Dialogue: 0,0:13:58.88,0:13:59.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:14:00.56,0:14:01.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan khawatir.
Dialogue: 0,0:14:01.78,0:14:07.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak akan mati kalau aku pakai\NOffense Armor sebagai bantalan.
Dialogue: 0,0:14:07.76,0:14:11.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetap saja ada cara lain\Nyang lebih manusiawi dari ini!
Dialogue: 0,0:14:11.92,0:14:16.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang sisi gelap memang sinting!
Dialogue: 0,0:14:17.62,0:14:18.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lama banget.
Dialogue: 0,0:14:19.35,0:14:21.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sudah jam makan siang, lo.
Dialogue: 0,0:14:21.12,0:14:24.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kabur dari gedung biasa saja\Nkok lama banget?
Dialogue: 0,0:14:24.90,0:14:28.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mode Tuan Putri ini orang kumat lagi.
Dialogue: 0,0:14:29.68,0:14:34.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah makan siang, ayo bedah\Nisi data ini dan mulai lacak pesertanya.
Dialogue: 0,0:14:34.10,0:14:37.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tidak perlu buru-buru kabur?
Dialogue: 0,0:14:37.83,0:14:41.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dilihat dari sini pun\Npemandangannya gawat banget.
Dialogue: 0,0:14:41.47,0:14:43.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau berpikir begitu, cepatlah naik.
Dialogue: 0,0:14:46.07,0:14:47.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tu-Tunggu sebentar!
Dialogue: 0,0:14:47.94,0:14:50.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus ganti baju di mobil sempit ini?
Dialogue: 0,0:14:50.26,0:14:54.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di depan kalian semua,\Ncuma aku sendiri yang telanjang?
Dialogue: 0,0:14:54.24,0:14:56.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dilihat tidak ada pengaruhnya.
Dialogue: 0,0:14:56.46,0:15:00.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak cepat ganti baju,\Nnanti keburu sampai tempat tujuan, lo.
Dialogue: 0,0:15:00.19,0:15:02.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya, deh!
Dialogue: 0,0:15:02.83,0:15:04.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja, Hanano.
Dialogue: 0,0:15:04.94,0:15:07.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga mendukung kamu\Nyang seperti itu.
Dialogue: 0,0:15:07.42,0:15:09.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si Jaket Dada Brutal!
Dialogue: 0,0:15:09.07,0:15:11.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa tatapanmu kayak kasihan?
Dialogue: 0,0:15:11.20,0:15:14.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini gara-gara korset pembentuk tubuh!
Dialogue: 0,0:15:16.35,0:15:19.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makan siang!
Dialogue: 0,0:15:19.99,0:15:24.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa makan di sana seenak itu\Nsampai kamu bersenandung?
Dialogue: 0,0:15:24.70,0:15:27.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujungnya, aku cuma tahu dari internet, sih!
Dialogue: 0,0:15:27.22,0:15:32.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya itu tempat berkumpulnya\Npara pekerja kantoran elite di Distrik 3.
Dialogue: 0,0:15:32.35,0:15:34.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kota pegawai kantoran memang beda.
Dialogue: 0,0:15:34.92,0:15:38.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujungnya, banyak mbak-mbak rok mini\Nmembagikan bir kaleng.
Dialogue: 0,0:15:38.68,0:15:41.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Niat banget di cuaca terik begini.
Dialogue: 0,0:15:42.23,0:15:45.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, restorannya di mana?
Dialogue: 0,0:15:46.12,0:15:48.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di lantai paling atas gedung itu!
Dialogue: 0,0:15:48.67,0:15:50.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:15:54.30,0:15:55.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biasa banget.
Dialogue: 0,0:15:55.84,0:15:58.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saking biasanya,\Naku ingin memukul Frenda.
Dialogue: 0,0:15:58.55,0:16:01.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Se-Sesekali yang biasa juga\Ntidak ada salahnya!
Dialogue: 0,0:16:01.67,0:16:04.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain tidak perlu antre panjang,
Dialogue: 0,0:16:04.30,0:16:09.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tokonya cukup ramai\Ndan penilaiannya tinggi, ya.
Dialogue: 0,0:16:09.42,0:16:12.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujungnya, pas dicoba,\Nbisa saja lumayan enak, kan?
Dialogue: 0,0:16:12.79,0:16:13.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:16:14.22,0:16:17.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pesan set gioza\Ntanpa bawang putih, deh.
Dialogue: 0,0:16:17.52,0:16:19.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari uji kemampuan koki\Nrestoran ini dari menu dasar.
Dialogue: 0,0:16:19.96,0:16:20.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menu dasar?
Dialogue: 0,0:16:20.83,0:16:21.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takitsubo pesan apa?
Dialogue: 0,0:16:22.32,0:16:23.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini.
Dialogue: 0,0:16:24.16,0:16:27.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya ada yang pesan mi dingin!
Dialogue: 0,0:16:27.07,0:16:29.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga mau yang bumbu wijen!
Dialogue: 0,0:16:29.12,0:16:32.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Musim panas, ya?\NSampai bikin muak.
Dialogue: 0,0:16:32.09,0:16:34.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku pesan...
Dialogue: 0,0:16:34.90,0:16:37.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini nasi goreng boga\Nbahari kuah kentalnya!
Dialogue: 0,0:16:38.22,0:16:39.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat makan.
Dialogue: 0,0:16:39.91,0:16:44.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal nasinya sudah makanan berminyak,\Ndi atasnya malah ditambah bongkahan kalori.
Dialogue: 0,0:16:44.60,0:16:48.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mugino ingin melatih kakinya,\Napa perlu kuingatkan?
Dialogue: 0,0:16:50.98,0:16:54.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak jadi, kalau asal ngomong,\Nseparuh tubuh atasku bisa lenyap
Dialogue: 0,0:16:54.86,0:16:58.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan berat badanku mendadak\Nberkurang setengah.
Dialogue: 0,0:16:58.92,0:17:00.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kinuhata.
Dialogue: 0,0:17:01.19,0:17:02.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Giozamu berwarna hijau?
Dialogue: 0,0:17:02.96,0:17:05.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanlah banyak daging.
Dialogue: 0,0:17:05.58,0:17:07.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa tiba-tiba bilang begitu?
Dialogue: 0,0:17:07.44,0:17:09.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayak orang super tua saja.
Dialogue: 0,0:17:09.06,0:17:12.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak, badanmu tidak akan tumbuh.
Dialogue: 0,0:17:12.09,0:17:14.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mbak tetek boros tempat\Nyang cuma pakai jaket kumal
Dialogue: 0,0:17:14.57,0:17:18.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lancang banget menghina\Ndan bawa-bawa ukuran dada?
Dialogue: 0,0:17:18.18,0:17:20.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ngajak berantem banget, nih?\N- Hanano.
Dialogue: 0,0:17:20.77,0:17:22.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kamu dengar, tidak?\N- Kalau laukmu tumis daging sayur,
Dialogue: 0,0:17:22.75,0:17:23.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kinuhata, berisik.\N- coba pakai ini.
Dialogue: 0,0:17:23.73,0:17:25.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelihatannya enak, sih.
Dialogue: 0,0:17:26.06,0:17:29.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, merias ulang wajah itu\Nrepot banget, jadi tidak dulu.
Dialogue: 0,0:17:29.23,0:17:33.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagian, kalau makan bubuk cabai,\Nbibir yang nantinya jadi bengkak dan tebal
Dialogue: 0,0:17:33.39,0:17:36.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bukan cuma ada di komik komedi, lo.
Dialogue: 0,0:17:36.12,0:17:40.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada pelembap bibir yang mengandung\Nkapsaisin buat bikin bibir tebal, kan?
Dialogue: 0,0:17:40.74,0:17:41.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanano.
Dialogue: 0,0:17:43.10,0:17:47.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong jangan pasang mata berbinar\Nsaat merekomendasikannya!
Dialogue: 0,0:17:49.02,0:17:50.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih makanannya.
Dialogue: 0,0:17:50.62,0:17:52.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Yah, rasanya lumayan.\N- Satu! Satu suap saja!
Dialogue: 0,0:17:52.59,0:17:54.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Satu suap tahu almonku\N- Kaldu buatan pabrik Kota Akademi
Dialogue: 0,0:17:54.29,0:17:55.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- ditukar satu pangsit wijen\N- Kaldu buatan pabrik Kota Akademi
Dialogue: 0,0:17:55.43,0:17:57.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- bukan barter yang buruk, kan?\N- memang legit banget.
Dialogue: 0,0:17:57.18,0:17:58.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- bukan barter yang buruk, kan?\N- Jadi, Frenda.
Dialogue: 0,0:17:58.56,0:17:59.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa lagi, Mugino?
Dialogue: 0,0:18:00.10,0:18:03.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu suka nonton pertandingan\Nkoloseum di internet, kan?
Dialogue: 0,0:18:03.36,0:18:05.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertandingan hari ini mulai jam berapa?
Dialogue: 0,0:18:06.98,0:18:09.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadwal paling dekat dari sekarang
Dialogue: 0,0:18:09.94,0:18:12.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sekitar jam 8 malam, sih.
Dialogue: 0,0:18:12.91,0:18:16.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sering nonton sambil\Nmakan malam di kamar, jadinya ingat.
Dialogue: 0,0:18:16.80,0:18:19.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu rentang waktu\Njam tayang utama, kan?
Dialogue: 0,0:18:19.44,0:18:23.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa si Dalang sengaja\Nmengincar waktu kumpul keluarga?
Dialogue: 0,0:18:24.42,0:18:28.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buat ukuran hobi orang-orang sisi gelap,\Nini tergolong imut, lo.
Dialogue: 0,0:18:28.52,0:18:30.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang jam 1 siang.
Dialogue: 0,0:18:30.39,0:18:33.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti mengejar peserta sekarang pun\Ntidak ada gunanya.
Dialogue: 0,0:18:34.08,0:18:36.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita mulai pelacakannya\Nsekitar jam 5 saja.
Dialogue: 0,0:18:46.18,0:18:49.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidur siang efeknya malah buruk, ya?
Dialogue: 0,0:18:49.38,0:18:51.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kepalaku sakit.
Dialogue: 0,0:18:51.46,0:18:53.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mau bergerak jam 5,
Dialogue: 0,0:18:53.24,0:18:55.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita harus mulai persiapannya sekarang.
Dialogue: 0,0:18:55.64,0:19:00.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak, nanti dilempar Mugino\Nkeluar gedung dengan muka bangun tidur.
Dialogue: 0,0:19:00.07,0:19:01.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, sih.
Dialogue: 0,0:19:03.79,0:19:07.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus untuk penyusupan\Nyang tadi, Hanano.
Dialogue: 0,0:19:08.16,0:19:09.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya...
Dialogue: 0,0:19:09.80,0:19:13.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jujur saja, awalnya kukira bakal gawat.
Dialogue: 0,0:19:13.66,0:19:18.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di hari pertama, kamu berantem\Nsama pengawal VIP licik itu, kan?
Dialogue: 0,0:19:19.39,0:19:21.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si Boneka Logam itu?
Dialogue: 0,0:19:21.28,0:19:26.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu itu, Mugino mengabaikan pertahanan\Ndan langsung menyerang
Dialogue: 0,0:19:26.87,0:19:30.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena kalau pertarungan makin lama,\Nkamu bisa mati.
Dialogue: 0,0:19:30.26,0:19:32.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya, dia pikir harus\Ncepat mengakhiri pertarungan.
Dialogue: 0,0:19:32.80,0:19:35.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, jangan bilang ini ke Mugino.
Dialogue: 0,0:19:35.11,0:19:38.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bakal gengsi parah terus\Npotong badanku sampai mati.
Dialogue: 0,0:19:39.32,0:19:44.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, nyatanya kamu berhasil\Nmembuktikan bisa berguna.
Dialogue: 0,0:19:44.04,0:19:47.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik di pertarungan langsung\Nmaupun penyusupan tidak langsung.
Dialogue: 0,0:19:47.60,0:19:52.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak, kita tidak bakal dapat\Ninformasi dari gedung itu dan berakhir buntu.
Dialogue: 0,0:19:53.36,0:19:55.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa Mugino bukan tipe\Norang yang gampang menyerah,
Dialogue: 0,0:19:55.98,0:19:59.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi dia pasti bakal pakai cara super kasar.
Dialogue: 0,0:19:59.07,0:20:03.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melubangi gedung ternyata\Nmasih tergolong cara yang halus, ya.
Dialogue: 0,0:20:03.42,0:20:04.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitulah.
Dialogue: 0,0:20:06.04,0:20:08.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya, kami utang budi padamu.
Dialogue: 0,0:20:09.70,0:20:11.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ada yang ingin kamu lakukan?
Dialogue: 0,0:20:11.88,0:20:13.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Barang juga boleh, kok.
Dialogue: 0,0:20:13.88,0:20:17.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seniormu ini akan mengabulkan\Npermintaanmu secara khusus!
Dialogue: 0,0:20:18.66,0:20:21.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:20:24.32,0:20:25.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serius?
Dialogue: 0,0:20:25.30,0:20:27.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu lumayan berbahaya, lo.
Dialogue: 0,0:20:27.64,0:20:30.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah masuk ke dunia sisi gelap,
Dialogue: 0,0:20:30.04,0:20:33.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa dibilang ini buat persiapan\Ndi kondisi darurat.
Dialogue: 0,0:20:33.08,0:20:37.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku merasa paling tepat\Nminta tolong soal ini padamu.
Dialogue: 0,0:20:37.59,0:20:39.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, boleh saja.
Dialogue: 0,0:20:39.34,0:20:41.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, akan segera kusiapkan.
Dialogue: 0,0:20:42.22,0:20:43.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi.
Dialogue: 0,0:20:43.99,0:20:45.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanano di sini?
Dialogue: 0,0:20:45.63,0:20:47.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo? Kinuhata?
Dialogue: 0,0:20:47.76,0:20:49.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:20:49.36,0:20:53.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan berkat\Nsatu keberhasilan barusan,
Dialogue: 0,0:20:53.04,0:20:55.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu berhasil dapat banyak teman\Nyang selama ini kamu idamkan?
Dialogue: 0,0:20:56.08,0:20:57.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bicara apa, sih?
Dialogue: 0,0:20:58.48,0:21:03.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya sudah jadi tradisi kalau anggota baru\Nharus didandani sama seniornya.
Dialogue: 0,0:21:04.50,0:21:05.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:21:08.12,0:21:10.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini hitungannya sudah dalaman, kan?
Dialogue: 0,0:21:10.34,0:21:14.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini pakaian super tipis yang transparan\Npas kena cipratan air terjun, kan?
Dialogue: 0,0:21:14.34,0:21:15.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja.
Dialogue: 0,0:21:15.34,0:21:17.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini cuma yukata mini super biasa\Nyang cocok untuk Tanabata.
Dialogue: 0,0:21:18.44,0:21:20.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, memang tembus pandang.
Dialogue: 0,0:21:20.16,0:21:24.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kulitku kelihatan! Mati aku!\NApalagi aku ini gadis muda yang pemalu!
Dialogue: 0,0:21:26.10,0:21:27.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari Mugino.
Dialogue: 0,0:21:27.78,0:21:32.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siswa yang diduga sebagai peserta\Nasuransi jiwa sudah teridentifikasi.
Dialogue: 0,0:21:32.78,0:21:37.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya kita diminta membuntutinya\Ndari asrama siswa di Distrik 7.
Dialogue: 0,0:21:38.19,0:21:39.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takitsubo!
Dialogue: 0,0:21:39.32,0:21:41.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kamu makan itu?
Dialogue: 0,0:21:42.06,0:21:45.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Es krim daun bambu\Nedisi terbatas Tanabata.
Dialogue: 0,0:21:45.15,0:21:47.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dijual di toko sebelah sana.
Dialogue: 0,0:21:47.47,0:21:50.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manisan ini kelihatan kayak\Nmakanan panda, ya.
Dialogue: 0,0:21:50.48,0:21:51.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mugino.
Dialogue: 0,0:21:51.88,0:21:55.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan asal menjilat es krimku\Ndari samping, dong.
Dialogue: 0,0:21:55.60,0:21:57.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang lain juga jangan ikut-ikutan.
Dialogue: 0,0:21:57.71,0:21:59.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia keluar.
Dialogue: 0,0:21:59.43,0:22:00.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mugino.
Dialogue: 0,0:22:00.52,0:22:02.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar dia orangnya?
Dialogue: 0,0:22:02.24,0:22:03.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, benar dia.
Dialogue: 0,0:22:05.08,0:22:10.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siswa yang didaftarkan asuransi jiwa\Nbernilai tinggi dan bakal tanding malam ini.
Dialogue: 0,0:22:10.64,0:22:13.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, mari biarkan dia menuntun kita
Dialogue: 0,0:22:13.03,0:22:16.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ke arena saling bantai\Nyang membuat darah bergejolak.
