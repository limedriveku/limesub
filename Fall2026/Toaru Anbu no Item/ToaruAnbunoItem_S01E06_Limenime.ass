Dialogue: 0,0:23:35.48,0:23:39.98,sign,,0000,0000,0000,,EPISODE 7: ITEM VS ITEM
Dialogue: 0,0:00:00.56,0:00:05.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa data ini benaran bisa menunjukkan\Nke siapa uang klaim asuransi bakal cair
Dialogue: 0,0:00:05.32,0:00:07.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}saat peserta koloseum tewas?
Dialogue: 0,0:00:07.82,0:00:10.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si Dalang memang dijaga ketat.
Dialogue: 0,0:00:10.91,0:00:13.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, tidak dengan peserta\Nyang jadi tumbal.
Dialogue: 0,0:00:13.87,0:00:16.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tidak cari mayat atau pelakunya,
Dialogue: 0,0:00:16.12,0:00:19.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi pemegang polis asuransi\Nyang masih hidup.
Dialogue: 0,0:00:19.96,0:00:21.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syarat utamanya,
Dialogue: 0,0:00:21.79,0:00:25.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pelajar usia belasan tahun,\Nklaim kematiannya bernilai ratusan juta,
Dialogue: 0,0:00:25.78,0:00:29.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan polisnya baru dibuat\Ndalam sebulan terakhir.
Dialogue: 0,0:00:29.95,0:00:31.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau nama dan wajahnya ketemu,
Dialogue: 0,0:00:31.84,0:00:35.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita tinggal membuntutinya\Nsampai ke koloseum.
Dialogue: 0,0:00:35.93,0:00:39.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:00:39.55,0:00:40.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takitsubo!
Dialogue: 0,0:00:40.52,0:00:42.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kamu makan itu?
Dialogue: 0,0:00:43.03,0:00:46.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Es krim daun bambu\Nedisi terbatas Tanabata.
Dialogue: 0,0:00:46.16,0:00:47.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dijual di toko sebelah sana.
Dialogue: 0,0:00:48.42,0:00:51.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manisan ini kelihatan kayak\Nmakanan panda, ya.
Dialogue: 0,0:00:51.42,0:00:55.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mugino, jangan asal menjilat\Nes krimku dari samping, dong.
Dialogue: 0,0:00:56.20,0:00:57.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang lain juga jangan ikut-ikutan.
Dialogue: 0,0:00:58.37,0:00:59.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia keluar.
Dialogue: 0,0:00:59.83,0:01:02.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mugino, benar dia orangnya?
Dialogue: 0,0:01:03.29,0:01:04.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, benar dia.
Dialogue: 0,0:01:04.95,0:01:09.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siswa yang didaftarkan asuransi jiwa\Nbernilai tinggi dan bakal tanding malam ini.
Dialogue: 0,0:01:10.33,0:01:12.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, mari biarkan dia menuntun kita
Dialogue: 0,0:01:12.68,0:01:16.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ke arena saling bantai\Nyang membuat darah bergejolak.
Dialogue: 0,0:02:49.98,0:02:52.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buat seorang petarung dunia bawah,
Dialogue: 0,0:02:52.53,0:02:56.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia tidak kelihatan berotot, ya.
Dialogue: 0,0:02:56.65,0:02:59.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma kayak cewek biasa yang berjalan
Dialogue: 0,0:02:59.08,0:03:01.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sambil mengayunkan rambut kepangnya.
Dialogue: 0,0:03:02.15,0:03:04.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama sepertimu, kan?
Dialogue: 0,0:03:04.08,0:03:06.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak terlihat kayak tukang pukul.
Dialogue: 0,0:03:06.21,0:03:10.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kita jalan di belakangnya, lo.
Dialogue: 0,0:03:10.00,0:03:13.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bakal ketahuan membuntuti\Nkalau dia menoleh, kan?
Dialogue: 0,0:03:13.84,0:03:16.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya, ayo senyum!
Dialogue: 0,0:03:16.47,0:03:17.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh...
Dialogue: 0,0:03:17.05,0:03:19.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti kita malah dicurigai, Frenda!
Dialogue: 0,0:03:19.89,0:03:21.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terbalik, Hanano.
Dialogue: 0,0:03:21.34,0:03:26.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru aneh kalau empat atau lima gadis\Nkumpul tanpa main ponsel.
Dialogue: 0,0:03:27.05,0:03:31.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru di keramaian begini,\Nkita akan sulit dicurigai, kan?
Dialogue: 0,0:03:31.44,0:03:34.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gampang panik malah bahaya, tahu.
Dialogue: 0,0:03:34.24,0:03:35.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan takut, Hanano.
Dialogue: 0,0:03:35.97,0:03:39.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu anggota ITEM,\Nbersikaplah tenang.
Dialogue: 0,0:03:41.85,0:03:44.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ta-Tapi, bagaimana kalau dia
Dialogue: 0,0:03:44.62,0:03:47.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bawa barang berbahaya di dalam tas itu?
Dialogue: 0,0:03:47.58,0:03:51.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau meski kelihatan biasa,\Nternyata ngeri kalau buka baju.
Dialogue: 0,0:03:51.59,0:03:53.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bicara apa, sih?
Dialogue: 0,0:03:53.51,0:03:56.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudku, sisi gelap itu macam-macam.
Dialogue: 0,0:03:56.92,0:03:59.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan katanya ada yang melihat\Nnaga raksasa
Dialogue: 0,0:03:59.09,0:04:01.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di langit malam Kota Akademi.
Dialogue: 0,0:04:01.55,0:04:02.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa, sih?
Dialogue: 0,0:04:02.81,0:04:05.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya itu mustahil.
Dialogue: 0,0:04:06.06,0:04:09.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi isi tasnya memang berbahaya.
Dialogue: 0,0:04:09.31,0:04:10.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tahu dari mana?
Dialogue: 0,0:04:10.77,0:04:11.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:04:11.56,0:04:14.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin isinya kostum super mesum!
Dialogue: 0,0:04:14.98,0:04:15.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei!
Dialogue: 0,0:04:15.44,0:04:18.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bilang "mesum"\Ndi tempat umum, dong!
Dialogue: 0,0:04:18.24,0:04:20.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti menarik perhatian!
Dialogue: 0,0:04:20.27,0:04:21.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bercanda, ah!
Dialogue: 0,0:04:21.57,0:04:23.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bercanda, lo.
Dialogue: 0,0:04:23.91,0:04:27.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peserta koloseum yang populer bisa\Ndapat item berbayar dari penonton
Dialogue: 0,0:04:27.71,0:04:31.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan itu membuat alur pertandingan\Nlebih menguntungkan.
Dialogue: 0,0:04:31.71,0:04:36.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Intinya, makin lemah pesertanya,\Nmakin wajib pakai kostum binal.
Dialogue: 0,0:04:36.55,0:04:38.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, Mugino?
Dialogue: 0,0:04:38.13,0:04:40.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tu-Tunggu sebentar!
Dialogue: 0,0:04:40.38,0:04:44.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bento salmon sebanyak ini cuma 400 kkal?
Dialogue: 0,0:04:44.64,0:04:46.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang benar saja!
Dialogue: 0,0:04:46.39,0:04:48.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini pelopor revolusi!
Dialogue: 0,0:04:48.39,0:04:51.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini baru porsi yang pas!
Dialogue: 0,0:04:51.31,0:04:53.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}400 kkal buat sekali makan
Dialogue: 0,0:04:53.94,0:04:56.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bukannya tinggal makan saja?
Dialogue: 0,0:04:56.73,0:05:00.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pola makannya seperti apa, sih?
Dialogue: 0,0:05:00.03,0:05:01.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Pakai tempel kartu.\N- Kalau tidak buru-buru,
Dialogue: 0,0:05:01.57,0:05:03.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- targetnya akan hilang, lo.\N- Mugino.
Dialogue: 0,0:05:03.32,0:05:03.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm?
Dialogue: 0,0:05:04.15,0:05:06.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi aku melihat grafiti itu juga.
Dialogue: 0,0:05:06.87,0:05:10.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin mereka memakai\Ngrafiti atau stiker
Dialogue: 0,0:05:10.87,0:05:14.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk memandu orang-orang\Nyang mau ke koloseum.
Dialogue: 0,0:05:15.59,0:05:16.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:05:16.55,0:05:18.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi gampang kalau tahu caranya.
Dialogue: 0,0:05:18.81,0:05:21.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya sudah, kami akan membuntutinya.
Dialogue: 0,0:05:21.13,0:05:23.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bergabunglah setelah makan.
Dialogue: 0,0:05:23.01,0:05:24.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Eh?\N- Iya, baiklah!
Dialogue: 0,0:05:25.11,0:05:26.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makannya pelan-pelan saja.
Dialogue: 0,0:05:26.85,0:05:28.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan makan terburu-buru.
Dialogue: 0,0:05:30.31,0:05:32.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak banget!
Dialogue: 0,0:05:32.14,0:05:36.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Orang-orang ini semaunya banget.\N- Ikan salmon memang maknyus.
Dialogue: 0,0:06:29.91,0:06:32.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si Kepang Tiga masuk ke sini?
Dialogue: 0,0:06:34.77,0:06:35.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempat ini...
Dialogue: 0,0:06:35.79,0:06:37.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasar Payung, ya.
Dialogue: 0,0:06:37.46,0:06:39.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata digelar di sini kali ini.
Dialogue: 0,0:06:39.88,0:06:41.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasar Payung?
Dialogue: 0,0:06:41.38,0:06:41.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:06:42.34,0:06:47.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benteng Kowloon era modern yang muncul\Nbagai fatamorgana dan menjual apa saja.
Dialogue: 0,0:06:47.55,0:06:51.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja, tidak berizin resmi\Ndan tidak mematuhi hukum.
Dialogue: 0,0:06:51.52,0:06:55.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujungnya, yang dijual pun\Nbarang aneh dan mencurigakan.
Dialogue: 0,0:06:55.85,0:06:58.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ada masalah, mereka bisa kabur
Dialogue: 0,0:06:58.56,0:07:02.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}layaknya pasar kaget dunia bawah.
Dialogue: 0,0:07:02.74,0:07:05.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok ada steik wagyu mahal\Ndi tempat seperti ini?
Dialogue: 0,0:07:05.78,0:07:06.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat baik-baik.
Dialogue: 0,0:07:06.70,0:07:08.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu daging tiruan dari kedelai
Dialogue: 0,0:07:08.91,0:07:10.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang disuntik minyak sapi, Kinuhata.
Dialogue: 0,0:07:10.91,0:07:11.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya.
Dialogue: 0,0:07:11.95,0:07:14.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka super jujur, ya.
Dialogue: 0,0:07:14.21,0:07:18.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau pembeli tahu dari awal,\Nbisa dinikmati dengan murah dan enak.
Dialogue: 0,0:07:18.75,0:07:22.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dirahasiakan, justru jadi heboh\Natas penipuan bahan makanan.
Dialogue: 0,0:07:22.63,0:07:27.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, ujungnya, yang keluyuran\Ndi sini dan di jam ini
Dialogue: 0,0:07:27.18,0:07:30.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak terlalu peduli soal detail rasa.
Dialogue: 0,0:07:30.51,0:07:33.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serius, nih? Teknik rias Umisuna Seiru?
Dialogue: 0,0:07:34.56,0:07:39.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penulisnya ditangkap, jadi versi digitalnya\Ndiblokir dari toko daring!
Dialogue: 0,0:07:39.06,0:07:40.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buku ini sangat langka!
Dialogue: 0,0:07:40.90,0:07:41.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:07:41.65,0:07:46.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sana ada kosmetik baru musim gugur\Nyang belum rilis di pasaran!
Dialogue: 0,0:07:49.19,0:07:51.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kinuhata, ayo jalan.
Dialogue: 0,0:07:51.16,0:07:53.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baru tahu ada labirin begini.
Dialogue: 0,0:07:53.79,0:07:56.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sisi gelap memang luar biasa.
Dialogue: 0,0:07:56.41,0:07:59.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini mah cuma permukaan sisi gelap.
Dialogue: 0,0:07:59.04,0:08:01.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mayoritas pengunjungnya pun warga sipil.
Dialogue: 0,0:08:01.95,0:08:04.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, pengelola koloseum cerdik juga.
Dialogue: 0,0:08:04.96,0:08:05.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:08:05.55,0:08:08.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para preman di sini hidungnya tajam.
Dialogue: 0,0:08:08.22,0:08:11.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat Anti-Skill atau Judgement\Nnekat menggerebek,
Dialogue: 0,0:08:11.43,0:08:13.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mereka bakal langsung tahu\Ndan kabur serentak.
Dialogue: 0,0:08:13.89,0:08:16.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujungnya, mereka memakai jalur ini
Dialogue: 0,0:08:16.14,0:08:19.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebagai sinyal instan\Nkalau ada peserta yang dibuntuti.
Dialogue: 0,0:08:21.33,0:08:25.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, sesama orang sisi gelap\Ntidak akan dicurigai.
Dialogue: 0,0:08:25.70,0:08:29.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya, kita bisa lancar membuntuti.
Dialogue: 0,0:08:29.36,0:08:34.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia asyik makan es serut\Ndan tidak mewaspadai sekitar.
Dialogue: 0,0:08:34.45,0:08:35.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benaran amatir.
Dialogue: 0,0:08:35.62,0:08:37.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, dia nyut-nyutan.
Dialogue: 0,0:08:42.78,0:08:44.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hup, aman.
Dialogue: 0,0:08:44.96,0:08:46.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak apa-apa?
Dialogue: 0,0:08:47.21,0:08:47.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:08:48.79,0:08:52.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- A-Aku tidak apa-apa!\N- Hei, esmu...
Dialogue: 0,0:08:52.34,0:08:54.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia semangat banget.
Dialogue: 0,0:08:54.71,0:08:58.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ceroboh banget, dia benaran peserta?
Dialogue: 0,0:08:58.27,0:09:00.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, larinya memang kencang.
Dialogue: 0,0:09:01.29,0:09:06.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujungnya, orang pakai jaket kulit\Nsaat panas begini jelas mencurigakan!
Dialogue: 0,0:09:06.19,0:09:08.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asbun banget.
Dialogue: 0,0:09:08.11,0:09:09.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kejar dia.
Dialogue: 0,0:09:18.54,0:09:21.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arenanya di sana, ya?
Dialogue: 0,0:09:21.29,0:09:22.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di luar dugaan.
Dialogue: 0,0:09:22.54,0:09:24.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya itu perpustakaan?
Dialogue: 0,0:09:24.13,0:09:26.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita sampai di tujuan, nih?
Dialogue: 0,0:09:27.80,0:09:31.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hampir dua jam kita dibuat berputar-putar.
Dialogue: 0,0:09:31.63,0:09:32.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:09:32.26,0:09:37.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti waktu yang tersisa buat pemanasan\Ndan pemeriksaan awal kurang dari satu jam?
Dialogue: 0,0:09:37.22,0:09:41.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang, tidak ada yang tahu\Nlokasi arena koloseum.
Dialogue: 0,0:09:41.06,0:09:46.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujungnya, ini arena tarung dunia bawah\Nyang rawan digerebek.
Dialogue: 0,0:09:46.74,0:09:51.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mereka menyewa tempat seharian\Nkayak turnamen olahraga resmi
Dialogue: 0,0:09:51.74,0:09:53.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pasti sudah ketahuan dari lama.
Dialogue: 0,0:09:53.78,0:09:56.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya selama ini dibiarkan?
Dialogue: 0,0:09:56.20,0:10:00.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peringkat 6 yang katanya musuh sisi gelap\Nsedang tidur siang atau apa?
Dialogue: 0,0:10:02.46,0:10:03.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah.
Dialogue: 0,0:10:03.75,0:10:05.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujungnya, kita mau menyusup dari mana?
Dialogue: 0,0:10:06.22,0:10:09.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua pintu masuk pasti dijaga ketat.
Dialogue: 0,0:10:09.46,0:10:12.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau butuh pintu masuk,\Naku bisa jebol tembok...
Dialogue: 0,0:10:12.09,0:10:16.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebelum Ratu Iblis Sadis ini menembak,\Ntolong cari jalan masuknya!
Dialogue: 0,0:10:16.85,0:10:19.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa boleh buat, deh.
Dialogue: 0,0:10:24.14,0:10:26.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, ayo super bergegas.
Dialogue: 0,0:10:28.66,0:10:32.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pojok tempat ini super berdebu.
Dialogue: 0,0:10:32.11,0:10:33.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mertua galak, ya?
Dialogue: 0,0:10:33.86,0:10:37.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka tidak bisa membiarkan\Nrobot pembersih
Dialogue: 0,0:10:37.16,0:10:41.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bekerja asal-asalan di area\Nkhusus buku tua yang sensitif ini.
Dialogue: 0,0:10:42.07,0:10:45.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa repot kalau cipratan deterjennya\Nsampai kena buku-buku.
Dialogue: 0,0:10:45.98,0:10:50.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin itu sebabnya tempat ini\Nsengaja dipilih jadi lokasi rahasia.
Dialogue: 0,0:10:51.34,0:10:54.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamera pengawasnya makin sedikit\Nakan menguntungkan.
Dialogue: 0,0:10:54.84,0:10:56.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Intinya...
Dialogue: 0,0:10:56.14,0:11:00.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa dipastikan kepala perpustakaan\Natau jajaran manajemennya kena ancam.
Dialogue: 0,0:11:00.06,0:11:02.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayak direktur perusahaan asuransi itu.
Dialogue: 0,0:11:03.37,0:11:04.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mugino.
Dialogue: 0,0:11:04.79,0:11:06.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Udaranya terasa riuh.
Dialogue: 0,0:11:17.28,0:11:21.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, hei, maaf untuk penonton\Nyang sedang makan malam!
Dialogue: 0,0:11:21.33,0:11:25.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inilah koloseum modern yang mewarnai\Nhari suntuk dengan pertarungan berdarah!
Dialogue: 0,0:11:25.54,0:11:27.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini taruhan dalam jumlah besar
Dialogue: 0,0:11:27.29,0:11:30.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- bakal berputar, pasang posisi kalian!\N- Hei, hei, berisik sekali.
Dialogue: 0,0:11:30.25,0:11:32.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagi penonton daring,
Dialogue: 0,0:11:32.34,0:11:34.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- taruhan masih dibuka.\N- Frenda, jelaskan.
Dialogue: 0,0:11:34.55,0:11:38.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ujungnya, ini layanan buat penonton daring.\N- Jangan lupa pasang taruhan kalian!
Dialogue: 0,0:11:38.09,0:11:40.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Konon, pengguna yang rela\N- Judi yang mempertaruhkan nyawa orang
Dialogue: 0,0:11:40.18,0:11:42.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- bakar uang banyak buat lempar koin\N- bikin pertandingan terasa beda!
Dialogue: 0,0:11:42.51,0:11:45.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa berkesempatan ikut\Nundian penonton langsung.
Dialogue: 0,0:11:45.52,0:11:46.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:11:46.77,0:11:50.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, dari mana orang sebanyak ini masuk?
Dialogue: 0,0:11:50.15,0:11:54.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ada antrean panjang\Ndi depan perpustakaan bakal aneh, sih.
Dialogue: 0,0:11:54.40,0:12:00.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paling mereka diangkut pakai truk bak\Ndan diantar lewat parkiran bawah tanah.
Dialogue: 0,0:12:00.32,0:12:04.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat kurungan di sana, Mugino!\NAda kejutan besar!
Dialogue: 0,0:12:04.41,0:12:08.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di slot peserta tambahan,\Nada harimau putih ukuran tiga meter!
Dialogue: 0,0:12:10.96,0:12:16.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini benar-benar turnamen sadis yang dari awal\Nmengasumsikan akan ada korban, ya.
Dialogue: 0,0:12:16.55,0:12:18.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jahat sekali memaksa hewan bertarung.
Dialogue: 0,0:12:19.46,0:12:21.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga orang-orang ini kena azab.
Dialogue: 0,0:12:22.49,0:12:26.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka dapat harimau putih\Ndari mana coba?
Dialogue: 0,0:12:26.60,0:12:29.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlebih, banyak kamera\Nskala produksi profesional.
Dialogue: 0,0:12:29.90,0:12:32.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lensa yang mengelilingi ring itu
Dialogue: 0,0:12:32.40,0:12:35.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}alat khusus buat siaran simulasi VR, ya.
Dialogue: 0,0:12:35.96,0:12:39.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil dapat peralatan ini\Nkalau cuma pakai uang.
Dialogue: 0,0:12:39.41,0:12:43.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Butuh koneksi industri\Ndan itu pun makan biaya besar.
Dialogue: 0,0:12:43.83,0:12:48.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil menyediakan alat dan panggung\Nmegah begini tanpa modal besar.
Dialogue: 0,0:12:49.21,0:12:51.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya butuh 15 miliar yen.
Dialogue: 0,0:12:52.06,0:12:52.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang...
Dialogue: 0,0:12:52.96,0:12:55.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ceritanya makin terasa nyata.
Dialogue: 0,0:13:07.19,0:13:09.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah!
Dialogue: 0,0:13:09.02,0:13:11.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga mau ikut bertanding!
Dialogue: 0,0:13:11.27,0:13:14.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku susah payah mengimpor\Nharimau putih buat hari ini, lo!
Dialogue: 0,0:13:14.73,0:13:16.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biarkan aku ikut bertarung!
Dialogue: 0,0:13:17.61,0:13:22.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waniguchi, kamu itu eksekutor\Nyang bertugas menyingkirkan
Dialogue: 0,0:13:22.53,0:13:26.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pelanggar aturan di pertandingan\Nmaupun taruhan, kan?
Dialogue: 0,0:13:26.16,0:13:28.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak ada pelanggaran,\Ncukup diam saja.
Dialogue: 0,0:13:29.66,0:13:31.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, Chief...
Dialogue: 0,0:13:31.25,0:13:32.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sudah bagus.
Dialogue: 0,0:13:32.17,0:13:34.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nikmati saja kedamaian ini.
Dialogue: 0,0:13:34.13,0:13:34.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial!
Dialogue: 0,0:13:34.79,0:13:37.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira bakal seru kalau di posisi ini!
Dialogue: 0,0:13:37.25,0:13:41.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini semua karena semuanya penakut\Nmeskipun anggota sisi gelap!
Dialogue: 0,0:13:41.84,0:13:45.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buat apa juga penjahat taat aturan?
Dialogue: 0,0:13:45.22,0:13:49.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tahu begini aku daftar jadi peserta saja.
Dialogue: 0,0:13:49.02,0:13:51.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bakal menang terus, dong.
Dialogue: 0,0:13:51.89,0:13:55.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyelenggara mana bisa\Nbikin taruhan kalau begitu?
Dialogue: 0,0:13:55.48,0:13:57.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berisik, Hanayama!
Dialogue: 0,0:13:57.39,0:14:01.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waniguchi, kenapa kamu sekesal itu?
Dialogue: 0,0:14:01.24,0:14:02.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paha.
Dialogue: 0,0:14:03.91,0:14:05.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku digigit nyamuk lagi!
Dialogue: 0,0:14:05.91,0:14:08.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pantas saja dari tadi\Nrasanya gatal dan bikin emosi!
Dialogue: 0,0:14:08.70,0:14:11.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya aku benci duduk di sini,\Nbanyak nyamuk!
Dialogue: 0,0:14:11.83,0:14:14.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Semprotan nyamuknya mana?\N- Waniguchi.
Dialogue: 0,0:14:14.33,0:14:17.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu kamu kepalang digigit,\Ntapi kemarilah.
Dialogue: 0,0:14:17.92,0:14:19.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kuoleskan obat gatal.
Dialogue: 0,0:14:19.92,0:14:20.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asy—
Dialogue: 0,0:14:22.38,0:14:24.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inoue Laspezia!
Dialogue: 0,0:14:24.26,0:14:25.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, Sis Waniguchi?
Dialogue: 0,0:14:25.93,0:14:27.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tempatku!
Dialogue: 0,0:14:27.89,0:14:29.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan menyerobot!
Dialogue: 0,0:14:29.47,0:14:31.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, jangan cuek!
Dialogue: 0,0:14:31.14,0:14:34.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian harus akur, dong.
Dialogue: 0,0:14:34.31,0:14:36.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, Chief...
Dialogue: 0,0:14:37.36,0:14:39.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chief, ini apa?
Dialogue: 0,0:14:39.65,0:14:41.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Film horor?
Dialogue: 0,0:14:41.61,0:14:43.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski ini film kelas tiga,
Dialogue: 0,0:14:43.65,0:14:47.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pemeran penggantinya benaran tewas\Npas kecelakaan syuting, lo.
Dialogue: 0,0:14:47.57,0:14:49.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dilihat secara teliti,
Dialogue: 0,0:14:50.16,0:14:55.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ada adegan saat orangnya kejatuhan\Ndan tergencet alat sampai tewas.
Dialogue: 0,0:14:55.42,0:14:58.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti ini kena edit kalau disiarkan.
Dialogue: 0,0:14:59.59,0:15:01.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hobimu aneh banget.
Dialogue: 0,0:15:01.13,0:15:05.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sekolah tuan putri lagi tren film\Nkayak begitu, Nona Ibotanokikoji?
Dialogue: 0,0:15:06.39,0:15:10.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau para guru nan santun lihat ini,\Nmereka bisa pingsan.
Dialogue: 0,0:15:10.01,0:15:11.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dih.
Dialogue: 0,0:15:11.14,0:15:14.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau cuma mau lihat mayat,\Nmasukkan saja aku ke ring.
Dialogue: 0,0:15:14.64,0:15:16.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Darah akan berceceran.
Dialogue: 0,0:15:16.73,0:15:21.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar, tidak perlu memperlihatkan\Nmayat secara jelas.
Dialogue: 0,0:15:21.55,0:15:25.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin merias diri\Ndengan aura kematian orang lain.
Dialogue: 0,0:15:25.49,0:15:28.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi tidak mau yang norak dan gampangan.
Dialogue: 0,0:15:28.56,0:15:32.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mayat manusia dipadatkan,\Nbisa jadi butiran berlian.
Dialogue: 0,0:15:32.49,0:15:35.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, tidak perlu dipamerkan\Nke semua orang.
Dialogue: 0,0:15:36.05,0:15:40.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makin tidak disadari orang awam,\Nmakin layak disebut elegan.
Dialogue: 0,0:15:41.11,0:15:43.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Uang yang dihasilkan\Ndari koloseum juga sama.
Dialogue: 0,0:15:43.13,0:15:47.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bungkus dengan sensasi kemalangan\Nlalu tidurkan dengan lembut.
Dialogue: 0,0:15:47.84,0:15:49.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dih.
Dialogue: 0,0:15:49.28,0:15:51.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanayama, kamu mau ikutan juga?
Dialogue: 0,0:15:51.68,0:15:53.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:15:53.02,0:15:56.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesama cewek memang manis\Nkalau lagi akur,
Dialogue: 0,0:15:56.48,0:15:59.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi bakal merepotkan\Nkalau ada masalah.
Dialogue: 0,0:15:59.19,0:16:03.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau saja menonton,\Ntapi ogah kalau terlibat.
Dialogue: 0,0:16:04.07,0:16:07.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, aku juga mau coba rokok elektrik!
Dialogue: 0,0:16:07.07,0:16:09.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini tabung oksigen portabel.
Dialogue: 0,0:16:09.41,0:16:11.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada rasanya.
Dialogue: 0,0:16:11.16,0:16:13.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, terus apa enaknya?
Dialogue: 0,0:16:13.74,0:16:16.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya oksigen bagus\Nkalau dimasukkan terus
Dialogue: 0,0:16:16.91,0:16:18.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ke dalam tubuh?
Dialogue: 0,0:16:18.00,0:16:20.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanayama itu gadis atletik, sih.
Dialogue: 0,0:16:20.79,0:16:22.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya sudah, tidak jadi.
Dialogue: 0,0:16:23.42,0:16:24.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya, kalian nonton berita?
Dialogue: 0,0:16:24.88,0:16:29.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya si direktur itu ditangkap\Ngara-gara menyerang perusahaannya sendiri.
Dialogue: 0,0:16:29.51,0:16:31.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus kenapa?
Dialogue: 0,0:16:31.14,0:16:35.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Uang asuransi buat pertandingan kali ini\Ntetap bakal dibayarkan, kok.
Dialogue: 0,0:16:36.10,0:16:40.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagian perusahaan asuransi\Nada banyak di Kota Akademi ini.
Dialogue: 0,0:16:40.17,0:16:42.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lengkap sama eksekutif dungu\Ndan gampang disetir.
Dialogue: 0,0:16:44.37,0:16:47.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Inoue, kali ini mau pakai\Ncara kejam apa lagi?
Dialogue: 0,0:16:48.54,0:16:51.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, tidak perlu rumit-rumit.
Dialogue: 0,0:16:51.74,0:16:55.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ada kasus pembunuhan\Ndi sekitar sini,
Dialogue: 0,0:16:55.12,0:16:57.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku cuma perlu memalsukan\Nbarang buktinya di TKP.
Dialogue: 0,0:16:58.62,0:17:00.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anggota ekskul seni memang hebat.
Dialogue: 0,0:17:00.54,0:17:02.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak dulu, jarimu selalu terampil.
Dialogue: 0,0:17:02.75,0:17:05.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hobi bikin figur dan ahli kerajinan tangan.
Dialogue: 0,0:17:05.63,0:17:08.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beda jauh sama kita yang tipe atletis.
Dialogue: 0,0:17:08.51,0:17:10.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bawa-bawa aku, Waniguchi.
Dialogue: 0,0:17:10.57,0:17:15.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski level 0, aku tidak akan kalah\Ndari siapa pun soal memalsukan barang 3D.
Dialogue: 0,0:17:16.24,0:17:20.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin di luar jangkauan\Npemikiran bocah kepala batu, sih.
Dialogue: 0,0:17:20.14,0:17:22.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kampret, kamu menyindirku?
Dialogue: 0,0:17:23.01,0:17:25.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bikin apa, Inoue?
Dialogue: 0,0:17:25.35,0:17:28.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pisau cukur yang sudah dicat\Ndengan sidik jari dan noda darah korban.
Dialogue: 0,0:17:28.86,0:17:31.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jenis pisau yang biasa dipakai\Ntukang pangkas rambut.
Dialogue: 0,0:17:31.49,0:17:36.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ada ini, kita bisa menimpakan\Ntuduhan palsu ke orang tidak bersalah.
Dialogue: 0,0:17:36.41,0:17:40.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada salahnya menimbun\NSDM yang bisa dimanfaatkan.
Dialogue: 0,0:17:41.21,0:17:44.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau pemodel ekskul seni marah,\Nternyata ngeri juga.
Dialogue: 0,0:17:45.00,0:17:50.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekalinya fokus, Inoue akan teliti\Npada setiap detail.
Dialogue: 0,0:17:50.34,0:17:51.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan, Kaede.
Dialogue: 0,0:17:52.41,0:17:54.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:17:54.61,0:17:58.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan ini, kita dapat satu kartu as\Nyang bebas dipakai kapan pun.
Dialogue: 0,0:17:58.89,0:18:01.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, ayo ambil kesimpulannya.
Dialogue: 0,0:18:01.70,0:18:03.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Direktur eksekutif itu memang kasihan,
Dialogue: 0,0:18:03.98,0:18:06.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi penyelidikan tidak akan bisa\Nmenyentuh kita.
Dialogue: 0,0:18:06.69,0:18:10.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dompet baru juga akan segera\Nkita dapatkan.
Dialogue: 0,0:18:10.03,0:18:13.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Artinya, sistem yang kita rancang
Dialogue: 0,0:18:13.57,0:18:16.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sudah berfungsi dengan baik\Ntermasuk katup pengamannya.
Dialogue: 0,0:18:16.66,0:18:21.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akan tetap melanjutkan\Noperasional koloseum seperti biasa.
Dialogue: 0,0:18:21.83,0:18:23.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setuju!
Dialogue: 0,0:18:23.54,0:18:24.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja.
Dialogue: 0,0:18:24.42,0:18:29.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita, ITEM, bakal ambil semua keuntungan\Ndari tewasnya semua orang.
Dialogue: 0,0:18:29.80,0:18:30.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mugino.
Dialogue: 0,0:18:30.71,0:18:34.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cewek-cewek sialan itu menyebut\Ndiri mereka ITEM, kan?
Dialogue: 0,0:18:34.09,0:18:36.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Itu seragam Tokiwadai?\N- Apa maksudnya?
Dialogue: 0,0:18:36.47,0:18:37.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kalau pakai nama kami\N- Ujungnya,
Dialogue: 0,0:18:37.85,0:18:39.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- buat ambil misi dari sisi gelap,\N- Kenapa anak sekolah bergengsi
Dialogue: 0,0:18:39.35,0:18:41.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- seharusnya gaya dan tampilan kami ditiru.\N- bisa ada di sisi gelap?
Dialogue: 0,0:18:41.91,0:18:44.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, mereka tidak begitu.
Dialogue: 0,0:18:44.48,0:18:49.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Artinya, orang lain tidak tahu dan cuma mereka\Npakai nama ITEM di lingkup pribadi.
Dialogue: 0,0:18:49.73,0:18:53.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Artinya, ini bukan akting,\Ntapi kode rahasia mereka?
Dialogue: 0,0:18:53.82,0:18:54.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu, kan...
Dialogue: 0,0:18:54.70,0:18:56.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, lumayan!
Dialogue: 0,0:18:56.66,0:18:57.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini baru tanggal tujuh, lo.
Dialogue: 0,0:18:57.99,0:19:00.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku selalu bayar gaji kalian tepat waktu.
Dialogue: 0,0:19:01.27,0:19:03.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan boros-boros, ya.
Dialogue: 0,0:19:03.21,0:19:06.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduhai, Ibotanokikoji Kaede!
Dialogue: 0,0:19:06.29,0:19:07.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu itu sempurna
Dialogue: 0,0:19:07.46,0:19:09.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- kalau enggak banyak ngomel!\N- Money card hitam?
Dialogue: 0,0:19:09.67,0:19:13.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak salah, itu kartu prabayar\Nyang dijual di minimarket, kan?
Dialogue: 0,0:19:13.80,0:19:15.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Warnanya beda.
Dialogue: 0,0:19:15.47,0:19:18.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu beda dari yang biasa,\Nnominalnya sangat besar.
Dialogue: 0,0:19:18.43,0:19:21.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu kartu isinya bisa\Nlima atau 10 juta yen.
Dialogue: 0,0:19:21.35,0:19:24.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biasa buat beli barang bermerek\Ndi toko daring
Dialogue: 0,0:19:24.18,0:19:29.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau dipakai memberi tip besar\Nke kreator di situs siaran langsung.
Dialogue: 0,0:19:30.29,0:19:32.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, encer juga otak mereka.
Dialogue: 0,0:19:32.69,0:19:35.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu memang lebih praktis\Ndari uang ataupun emas.
Dialogue: 0,0:19:36.41,0:19:40.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu takut rekening\Ndibekukan mendadak oleh bank.
Dialogue: 0,0:19:40.30,0:19:44.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Disimpan sembarangan juga\Ntidak akan tergores kayak berlian.
Dialogue: 0,0:19:44.41,0:19:48.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu diubah ke bentuk kartu,\Nuangnya juga otomatis tercuci.
Dialogue: 0,0:19:48.75,0:19:52.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa langsung dicairkan jadi\Nuang tunai kalau digadaikan.
Dialogue: 0,0:19:52.88,0:19:53.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mugino.
Dialogue: 0,0:19:54.88,0:19:56.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Koper?
Dialogue: 0,0:19:56.47,0:19:59.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain cuci uang, mereka juga\Ntidak percaya sama bank
Dialogue: 0,0:19:59.26,0:20:03.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sampai pakai deposit box segala.\NTeliti banget.
Dialogue: 0,0:20:03.39,0:20:07.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, bakal gampang kita rebut, dong.
Dialogue: 0,0:20:07.98,0:20:09.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Super setuju.
Dialogue: 0,0:20:09.65,0:20:10.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu!
Dialogue: 0,0:20:10.31,0:20:14.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu dulu, semuanya!\NKenapa tujuannya malah jadi uang?
Dialogue: 0,0:20:14.77,0:20:18.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau uangnya kita rebut,\Noperasional mereka bakal terhenti, kan?
Dialogue: 0,0:20:18.75,0:20:20.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suara di Telepon juga pasti paham.
Dialogue: 0,0:20:20.99,0:20:22.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau koper itu
Dialogue: 0,0:20:22.41,0:20:25.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}penuh sama kartu nominal 10 juta,\Ntotalnya sekitar 80 miliar yen, ya?
Dialogue: 0,0:20:25.66,0:20:26.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}80 miliar...
Dialogue: 0,0:20:26.41,0:20:27.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sana.
Dialogue: 0,0:20:31.65,0:20:36.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Selamat sore, Para Pencuri Bejat.\N- Aduh...
Dialogue: 0,0:20:37.99,0:20:41.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyihir yang menukar nyawa orang\Ndemi uang beraninya sok bijak.
Dialogue: 0,0:20:41.34,0:20:46.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, wah, kamu kelihatan\Npercaya diri banget, Level 5.
Dialogue: 0,0:20:46.90,0:20:52.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian tidak pernah berpikir\Nkenapa bisa menang terus sampai sekarang?
Dialogue: 0,0:20:52.71,0:20:56.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atasan cuma memberikan pekerjaan\Nyang bisa kalian menangkan
Dialogue: 0,0:20:56.11,0:20:59.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan membiasakan pemula nan malang\Nmenikmati rasanya menang.
Dialogue: 0,0:20:59.19,0:21:04.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau obat terlarang atau judi, semua hal jahat\Ndi dunia ini awalnya selalu begitu, kan?
Dialogue: 0,0:21:04.84,0:21:06.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, semua itu berakhir di sini.
Dialogue: 0,0:21:06.71,0:21:10.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang waktunya pemerasan\Nuntuk kalian.
Dialogue: 0,0:21:10.42,0:21:13.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu siap kuubah jadi abu gosok, kan?
Dialogue: 0,0:21:13.67,0:21:14.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya?
Dialogue: 0,0:21:14.88,0:21:20.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sudah tahu lawannya Mugino,\Ntapi masih sesantai itu?
Dialogue: 0,0:21:23.26,0:21:24.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu...
Dialogue: 0,0:21:24.51,0:21:25.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malang sekali.
Dialogue: 0,0:21:25.72,0:21:27.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba pikir sedikit.
Dialogue: 0,0:21:27.77,0:21:32.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemikiran bahwa kamu bisa melakukan\Napa saja karena punya Meltdowner
Dialogue: 0,0:21:32.15,0:21:37.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}cuma citra semu yang diberikan\Norang-orang dewasa di kota ini, tahu.
Dialogue: 0,0:21:37.15,0:21:41.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu benaran percaya gelarmu\Nsebagai level 5 yang cuma ada 7 orang
Dialogue: 0,0:21:41.28,0:21:46.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di Kota Akademi ini bisa membuatmu\Nmenerobos segala halangan?
Dialogue: 0,0:21:46.41,0:21:49.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pikir sisi gelap kota ini\Nsedangkal itu?
Dialogue: 0,0:21:51.79,0:21:53.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi?
Dialogue: 0,0:21:53.00,0:21:54.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemampuan orang ini...
Dialogue: 0,0:21:54.29,0:21:56.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, kemampuanku bukan listrik, lo.
Dialogue: 0,0:21:56.84,0:21:59.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akulah peringkat 6 Kota Akademi...
Dialogue: 0,0:22:00.09,0:22:02.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, musuh bebuyutan sisi gelap
Dialogue: 0,0:22:02.97,0:22:04.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang paling kalian takuti.
