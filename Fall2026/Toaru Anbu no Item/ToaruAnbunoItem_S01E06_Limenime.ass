Dialogue: 0,0:02:43.85,0:02:47.02,sign,,0000,0000,0000,,A CERTAIN ITEM OF DARK SIDE
Dialogue: 0,0:03:59.09,0:04:01.55,sign,,0000,0000,0000,,BAZAR TANABATA
Dialogue: 0,0:04:01.55,0:04:02.81,sign,,0000,0000,0000,,OBRAL MINUMAN
Dialogue: 0,0:04:40.38,0:04:44.64,sign,,0000,0000,0000,,BENTO SALMON PERAK, PANGGANG GARAM SEHAT
Dialogue: 0,0:06:05.55,0:06:08.01,sign,,0000,0000,0000,,SEPEDA BOLEH MELINTAS\NKHUSUS PEJALAN KAKI
Dialogue: 0,0:06:58.56,0:07:00.61,sign,,0000,0000,0000,,DAGING WAGYU PREMIUM
Dialogue: 0,0:07:00.61,0:07:02.07,sign,,0000,0000,0000,,DAGING TIRUAN GLUTEN RASA WAGYU
Dialogue: 0,0:07:06.70,0:07:08.91,sign,,0000,0000,0000,,DAGING WAGYU PREMIUM
Dialogue: 0,0:07:08.91,0:07:11.95,sign,,0000,0000,0000,,DAGING TIRUAN GLUTEN RASA WAGYU
Dialogue: 0,0:07:27.18,0:07:28.84,sign,,0000,0000,0000,,SOJU UBI JALAR
Dialogue: 0,0:07:28.84,0:07:30.51,sign,,0000,0000,0000,,ALKOHOL SINTETIS - RASA TEQUILA
Dialogue: 0,0:07:30.51,0:07:33.60,sign,,0000,0000,0000,,TEKNIK RIASAN UMISUNA SEIRU
