Dialogue: 0,0:01:28.53,0:01:36.70,sign,,0000,0000,0000,,(The Detective Is Already Dead. Season 2)
Dialogue: 0,0:02:49.15,0:02:52.03,sign,,0000,0000,0000,,(Episode 6 - Pelindung Dunia)
Dialogue: 0,0:23:34.98,0:23:39.98,sign,,0000,0000,0000,,(Episode 7 - Mencari Satu-satunya Masa Depan)
Dialogue: 0,0:00:07.19,0:00:08.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kimihiko.
Dialogue: 0,0:00:09.07,0:00:10.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima ini.
Dialogue: 0,0:00:11.11,0:00:12.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini?
Dialogue: 0,0:00:12.12,0:00:14.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari Nona Siesta.
Dialogue: 0,0:00:14.95,0:00:20.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku diminta memberikannya ke kalian\Nberempat begitu kalian menyelesaikan tugas.
Dialogue: 0,0:00:20.25,0:00:25.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua yang perlu diketahui Kimihiko\Nada di dalam situ.
Dialogue: 0,0:00:25.25,0:00:26.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu.
Dialogue: 0,0:00:26.59,0:00:29.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pekerjaanmu sampai sini, ya.
Dialogue: 0,0:00:29.09,0:00:29.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:00:30.59,0:00:35.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan sejauh inilah masa depan\Nyang diperkirakan Nona Siesta.
Dialogue: 0,0:00:35.93,0:00:37.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:00:37.43,0:00:40.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami akan berbuat sesuka kami\Nmulai sekarang.
Dialogue: 0,0:00:42.31,0:00:46.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong urus Nona Siesta.
Dialogue: 0,0:00:46.40,0:00:48.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, serahkan padaku.
Dialogue: 0,0:00:48.86,0:00:50.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suatu saat pasti.
Dialogue: 0,0:00:50.65,0:00:54.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami akan membangkitkan Siesta.
Dialogue: 0,0:00:57.45,0:00:59.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku serahkan pada kalian.
Dialogue: 0,0:01:10.88,0:01:13.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Detektif sudah mati.
Dialogue: 0,0:01:14.34,0:01:17.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kami tidak akan\Nmenerima akhir itu!
Dialogue: 0,0:01:19.31,0:01:30.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buket bunga yang\Ntak pernah layu di jantungku♪
Dialogue: 0,0:01:39.66,0:01:45.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, mungkin sudah terlambat,\Ntapi aku ingin tanya sesuatu♪
Dialogue: 0,0:01:45.96,0:01:52.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah kamu bahagia melewati\Nhari-hari yang kita habiskan bersama?♪
Dialogue: 0,0:01:52.09,0:01:58.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak pernah bermimpi tentang\Nmasa depan tanpa kehilangan apa-apa♪
Dialogue: 0,0:01:58.68,0:02:06.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bila bisa memelukmu sekali lagi\Nuntuk terakhir kali♪
Dialogue: 0,0:02:06.61,0:02:12.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma tidur sedikit lebih lama, kok♪
Dialogue: 0,0:02:12.19,0:02:18.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan berwajah begitu♪
Dialogue: 0,0:02:18.53,0:02:25.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama jantungku masih\Nberdetak dalam dirimu♪
Dialogue: 0,0:02:25.42,0:02:32.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pasti takkan pernah\Nmelupakan kesedihan itu♪
Dialogue: 0,0:02:32.55,0:02:35.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak terlihat apa-apa,\Ntapi tampak samar-samar♪
Dialogue: 0,0:02:35.76,0:02:39.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bak cahaya yang menyinari\Nlautan di malam hari♪
Dialogue: 0,0:02:39.01,0:02:46.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memandangi kelanjutan\Nmimpi putih itu di sampingmu♪
Dialogue: 0,0:02:49.85,0:02:52.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maka dari itu, Bocah Tengik.
Dialogue: 0,0:02:52.39,0:02:55.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau dijatuhi hukuman penjara\Nselama 20.000 tahun.
Dialogue: 0,0:02:55.90,0:02:57.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Absurd.
Dialogue: 0,0:02:57.65,0:02:59.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak tahu karena apa.
Dialogue: 0,0:02:59.53,0:03:01.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak tahu karena apa?
Dialogue: 0,0:03:01.66,0:03:05.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Heh. Sayang sekali,\NKimizuka Kimihiko.
Dialogue: 0,0:03:05.40,0:03:09.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu melanggar batas\Nkecepatan dengan sepeda motor,
Dialogue: 0,0:03:09.23,0:03:11.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pelanggaran berulang terhadap\NUU Sajam dan Senpi,
Dialogue: 0,0:03:11.96,0:03:14.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tindak kekerasan,\Npenganiayaan, dan juga...
Dialogue: 0,0:03:14.94,0:03:18.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dituduh menghalangi\Ntugas pejabat publik.
Dialogue: 0,0:03:20.13,0:03:21.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kase.
Dialogue: 0,0:03:22.51,0:03:26.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti yang kamu tahu,\Nbagi Kimizuka,
Dialogue: 0,0:03:26.02,0:03:29.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siesta adalah sosok yang\Ntak tergantikan oleh apa pun.
Dialogue: 0,0:03:30.18,0:03:33.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, demi Siesta,
Dialogue: 0,0:03:33.15,0:03:37.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia bisa memukul polisi ataupun\NPenjaga sampai terhempas!
Dialogue: 0,0:03:38.32,0:03:40.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oi, aku tidak bilang itu—
Dialogue: 0,0:03:40.86,0:03:41.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat saja!
Dialogue: 0,0:03:42.32,0:03:47.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kimizuka mencintai Siesta.
Dialogue: 0,0:03:47.12,0:03:51.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mencintai Siesta\Ndari dalam lubuk hatinya!
Dialogue: 0,0:03:51.25,0:03:52.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oi!
Dialogue: 0,0:03:52.84,0:03:55.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tarik ucapanmu! Itu salah!
Dialogue: 0,0:03:52.84,0:03:57.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak! Kimizuka, aku takut!
Dialogue: 0,0:03:58.09,0:04:01.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia cuma partner kerja.
Dialogue: 0,0:03:59.42,0:04:01.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepuluh hari.
Dialogue: 0,0:04:02.13,0:04:04.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku beri kalian sepuluh hari.
Dialogue: 0,0:04:04.35,0:04:09.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buktikan kalian mampu mengalahkan\NSeed dalam waktu itu.
Dialogue: 0,0:04:09.85,0:04:14.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah belas kasihan paling maksimal\Nyang bisa kuberikan pada kalian.
Dialogue: 0,0:04:15.90,0:04:21.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi cara mengalahkan Seed\Nhanya dengan kami berempat...
Dialogue: 0,0:04:21.28,0:04:24.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, ternyata itu maksudnya.
Dialogue: 0,0:04:24.99,0:04:26.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kunci?
Dialogue: 0,0:04:26.61,0:04:29.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat aku tinggal bersama Siesta dulu,
Dialogue: 0,0:04:30.18,0:04:34.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku pernah melihat dia menyembunyikan\Nsesuatu di dalam laci meja.
Dialogue: 0,0:04:40.71,0:04:42.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau penasaran banget,
Dialogue: 0,0:04:43.09,0:04:47.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}coba rebut kunci ini dariku\Nsuatu saat nanti.
Dialogue: 0,0:04:48.01,0:04:52.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kunci ini jatuh\Nke tanganku di saat ini,
Dialogue: 0,0:04:52.05,0:04:55.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pasti ada sebuah petunjuk di sana.
Dialogue: 0,0:04:57.98,0:05:01.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku akan pergi besok.
Dialogue: 0,0:05:01.97,0:05:04.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku juga ikut.
Dialogue: 0,0:05:04.47,0:05:08.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengurus asisten itu tugas\Nseorang detektif juga.
Dialogue: 0,0:05:10.99,0:05:14.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, kalian boleh pergi.
Dialogue: 0,0:05:14.54,0:05:16.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi dua orang sisanya...
Dialogue: 0,0:05:16.59,0:05:21.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian harus belajar cara\Nbertarung melawan Seed.
Dialogue: 0,0:05:22.29,0:05:27.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama, ada pekerjaan yang belum\Nselesai untuk Charlotte.
Dialogue: 0,0:05:27.88,0:05:30.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentunya, kamu mau\Nmengerjakannya, 'kan?
Dialogue: 0,0:05:32.18,0:05:34.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si-Siapa takut.
Dialogue: 0,0:05:35.56,0:05:38.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, Saikawa Yui...
Dialogue: 0,0:05:40.35,0:05:42.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar aku awasi.
Dialogue: 0,0:05:43.90,0:05:45.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Koumori!
Dialogue: 0,0:05:45.78,0:05:48.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah kau sudah menyerah?
Dialogue: 0,0:05:49.82,0:05:53.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak awal tujuan kita memang sama.
Dialogue: 0,0:05:53.62,0:05:58.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi tidak ada salahnya aku bergabung\Ndalam regu penumpas SPES.
Dialogue: 0,0:05:59.25,0:06:04.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku membebaskannya lebih awal\Nuntuk menjadikannya pengawas Saikawa Yui.
Dialogue: 0,0:06:04.84,0:06:08.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, tapi kepercayaanku itu\Nmalah dikhianati.
Dialogue: 0,0:06:08.14,0:06:10.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti yang kubilang sebelumnya,
Dialogue: 0,0:06:10.05,0:06:14.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku bisa meningkatkan kemampuan\Ngadis ini lebih tinggi lagi.
Dialogue: 0,0:06:14.48,0:06:17.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, begitulah intinya.
Dialogue: 0,0:06:18.39,0:06:20.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana, Nona?
Dialogue: 0,0:06:20.94,0:06:23.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekalipun kau tidak tertarik balas dendam,
Dialogue: 0,0:06:23.75,0:06:27.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa kau tidak mau\Nbertarung demi temanmu?
Dialogue: 0,0:06:29.15,0:06:30.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah!
Dialogue: 0,0:06:30.79,0:06:33.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku minta tolong padamu!
Dialogue: 0,0:06:34.24,0:06:35.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau yakin?
Dialogue: 0,0:06:36.00,0:06:39.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, aku tidak mau cuma dilindungi.
Dialogue: 0,0:06:39.67,0:06:43.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin jadi kuat\Nagar bisa melindungi kalian juga!
Dialogue: 0,0:06:45.88,0:06:47.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yui.
Dialogue: 0,0:06:48.71,0:06:50.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:06:52.30,0:06:53.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Char...
Dialogue: 0,0:06:54.93,0:06:57.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah mereka sudah baikan.
Dialogue: 0,0:06:59.52,0:07:02.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa tolong pijat kakiku?
Dialogue: 0,0:07:02.69,0:07:04.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, ya.
Dialogue: 0,0:07:05.65,0:07:09.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Koreksi, deh. Sepertinya\Nmasih butuh waktu lama.
Dialogue: 0,0:07:09.82,0:07:13.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi setidaknya\Nkita sudah punya arah, 'kan?
Dialogue: 0,0:07:13.85,0:07:18.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya. Kita mencari petunjuk\Nyang ditinggalkan Siesta.
Dialogue: 0,0:07:18.49,0:07:22.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yui dan Char mengasah kekuatan\Nuntuk melawan Seed.
Dialogue: 0,0:07:23.00,0:07:25.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tanya buat jaga-jaga saja, Watson.
Dialogue: 0,0:07:25.25,0:07:29.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau yakin mau berurusan dengan Seed?
Dialogue: 0,0:07:30.30,0:07:35.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keinginan terbesarmu adalah\Nmembangkitkan Detektif Hebat, 'kan?
Dialogue: 0,0:07:35.97,0:07:38.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, itu memang benar.
Dialogue: 0,0:07:38.56,0:07:39.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:07:39.89,0:07:45.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dunia ini hancur\Nsaat dia kembali hidup, jadinya sia-sia.
Dialogue: 0,0:07:45.69,0:07:48.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku akan bertarung\Nmelawan SPES.
Dialogue: 0,0:07:48.28,0:07:49.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan mengalahkan Seed.
Dialogue: 0,0:07:50.21,0:07:53.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma itu saja.
Dialogue: 0,0:07:55.49,0:07:59.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin seharusnya ini\Ntak perlu aku katakan.
Dialogue: 0,0:08:04.37,0:08:09.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di tempat yang kalian tuju,\Nada satu lagi Penjaga.
Dialogue: 0,0:08:11.21,0:08:16.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Konon, dia bisa melihat segala hal di dunia ini\Nberkat kemampuan prediksi masa depannya.
Dialogue: 0,0:08:16.68,0:08:20.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika memang ada masa depan\Ndi mana Detektif Hebat hidup kembali,
Dialogue: 0,0:08:20.89,0:08:24.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia mungkin bisa\Nmenunjukkan jalan itu.
Dialogue: 0,0:08:24.94,0:08:26.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Prediksi masa depan?
Dialogue: 0,0:08:27.02,0:08:29.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa Penjaga itu?
Dialogue: 0,0:08:33.11,0:08:36.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Miko. Mia Whitlock.
Dialogue: 0,0:08:55.63,0:08:57.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya jadi kangen.
Dialogue: 0,0:09:00.26,0:09:01.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya juga.
Dialogue: 0,0:09:01.69,0:09:05.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini tempat pertemuan pertamamu\Ndengan Siesta, ya.
Dialogue: 0,0:09:06.60,0:09:08.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, kebetulan.
Dialogue: 0,0:09:09.10,0:09:12.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, tak terhindari.
Dialogue: 0,0:09:13.44,0:09:16.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lama tidak bertemu, Tuan.
Dialogue: 0,0:09:20.24,0:09:21.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau...
Dialogue: 0,0:09:22.12,0:09:25.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ada seorang detektif\Ndi antara penumpang?
Dialogue: 0,0:09:25.67,0:09:27.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang waktu itu!
Dialogue: 0,0:09:27.14,0:09:30.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah\Nmembantu kami waktu itu.
Dialogue: 0,0:09:30.54,0:09:35.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf terlambat memperkenalkan diri.\NNama saya Olivia.
Dialogue: 0,0:09:35.41,0:09:39.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya senang bisa bertemu\NAnda kembali, Tuan Kimizuka.
Dialogue: 0,0:09:39.72,0:09:42.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kimizuka, kamu kenal dia?
Dialogue: 0,0:09:42.34,0:09:45.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenal pramugari?
Dialogue: 0,0:09:45.10,0:09:49.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan kenalan juga, kami cuma\Npernah terlibat insiden yang sama.
Dialogue: 0,0:09:49.77,0:09:52.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kali ini sedang bulan madu?
Dialogue: 0,0:09:55.69,0:09:57.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, bukan!
Dialogue: 0,0:09:57.35,0:10:00.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma mau mengambil\Nbarang yang ketinggalan.
Dialogue: 0,0:10:00.08,0:10:03.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus, ada orang yang ingin kutemui.
Dialogue: 0,0:10:04.16,0:10:05.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:10:05.93,0:10:09.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, semoga perjalanan\Nkalian berdua menyenangkan.
Dialogue: 0,0:10:10.12,0:10:13.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Izinkan kami melayani\Nkalian sepenuh hati.
Dialogue: 0,0:10:34.98,0:10:37.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak gerakanmu yang sia-sia.
Dialogue: 0,0:10:37.73,0:10:39.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bantu juga, dong!
Dialogue: 0,0:10:39.70,0:10:42.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mau membiarkan\Nbawahanmu mati begitu saja?
Dialogue: 0,0:10:42.45,0:10:44.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu ini ngomong apa?
Dialogue: 0,0:10:44.40,0:10:47.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini pekerjaanmu\Nsejak setahun lalu, 'kan?
Dialogue: 0,0:10:47.83,0:10:49.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, sih...
Dialogue: 0,0:10:49.96,0:10:53.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa gunanya memburu\Nsisa-sisa SPES sekarang?
Dialogue: 0,0:10:53.67,0:10:57.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih cepat kalau cari\Ncara mengalahkan Seed langsung, 'kan?
Dialogue: 0,0:10:58.26,0:11:01.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk menyingkirkan\Nkandidat wadah lainnya.
Dialogue: 0,0:11:01.77,0:11:07.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini, tidak diragukan lagi Saikawa Yui\Nadalah kandidat utama menjadi wadah.
Dialogue: 0,0:11:07.27,0:11:08.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:11:08.35,0:11:13.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemungkinan manusia buatan lain dikorbankan\Nsebagai wadah Seed tak bisa disangkal.
Dialogue: 0,0:11:13.61,0:11:17.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada ruginya\Nmencegah sebelum terjadi.
Dialogue: 0,0:11:18.32,0:11:21.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau pakai logika itu,\NKimizuka juga termasuk—
Dialogue: 0,0:11:21.91,0:11:26.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah yang aku maksud,\NCharlotte Arisaka Anderson!
Dialogue: 0,0:11:33.37,0:11:37.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu bersimpati pada musuh\Nyang harus dikalahkan?
Dialogue: 0,0:11:37.50,0:11:42.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu harus bisa membedakan mana yang\Nmau kamu lindungi dan tidak bisa dilindungi.
Dialogue: 0,0:11:42.51,0:11:44.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka tidak bisa melakukan itu.
Dialogue: 0,0:11:44.93,0:11:46.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kamu yang harus melakukannya!
Dialogue: 0,0:11:47.51,0:11:52.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Walau kamu bisa membuat\Nseluruh dunia memusuhimu.
Dialogue: 0,0:11:56.65,0:11:58.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa melindungi\Nsemuanya, begitu?
Dialogue: 0,0:11:59.73,0:12:03.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanyakan itu setelah kamu punya\Nkekuatan untuk melindungi semuanya.
Dialogue: 0,0:12:05.95,0:12:10.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kenapa kamu membantu\Nmenumpas SPES?
Dialogue: 0,0:12:11.59,0:12:16.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa membantu pekerjaan\Nyang ditinggalkan Nona?
Dialogue: 0,0:12:17.33,0:12:19.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga gagal membunuh itu.
Dialogue: 0,0:12:21.71,0:12:23.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyelinap keluar dari fasilitas,
Dialogue: 0,0:12:23.72,0:12:28.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menghabisinya yang sudah\Nmenjadi kandidat wadah Seed
Dialogue: 0,0:12:28.39,0:12:31.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah perintah yang\Ndiberikan padaku waktu itu.
Dialogue: 0,0:12:32.64,0:12:35.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi dia selamat,
Dialogue: 0,0:12:35.27,0:12:40.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kemampuannya diakui dan masuk\Nke dalam jajaran Penjaga.
Dialogue: 0,0:12:40.19,0:12:43.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, tugas mengalahkan SPES
Dialogue: 0,0:12:43.32,0:12:46.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}diserahkan sepenuhnya\Npada Detektif Hebat.
Dialogue: 0,0:12:47.36,0:12:48.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar.
Dialogue: 0,0:12:48.66,0:12:53.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sudah merebut pekerjaan orang lain,\Nkerjakan sampai selesai, dong.
Dialogue: 0,0:13:08.59,0:13:14.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku sama sekali tidak bisa\Nmembayangkan Yui dapat latihan seperti apa.
Dialogue: 0,0:13:14.63,0:13:16.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya juga.
Dialogue: 0,0:13:16.73,0:13:19.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi Saikawa juga bukan orang biasa.
Dialogue: 0,0:13:19.89,0:13:22.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pasti baik-baik saja.
Dialogue: 0,0:13:22.86,0:13:26.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang kuat, sih.\NChar dan Yui.
Dialogue: 0,0:13:29.24,0:13:31.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, Kimizuka...
Dialogue: 0,0:13:33.45,0:13:37.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu sampai di sana,\Nada yang ingin kulakukan.
Dialogue: 0,0:13:45.43,0:13:48.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sesedih itu juga,\Ntoh sudah biasa.
Dialogue: 0,0:13:48.94,0:13:51.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, sih.
Dialogue: 0,0:13:51.77,0:13:56.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baru juga sampai, bisa-bisanya\Ndompet dan kunciku dicuri.
Dialogue: 0,0:13:56.65,0:14:02.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah, sudah. Kita sudah minta Olivia\Nmemeriksa pesawat sekali lagi,
Dialogue: 0,0:14:02.28,0:14:04.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}nanti juga dihubungi lagi.
Dialogue: 0,0:14:04.20,0:14:06.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga saja.
Dialogue: 0,0:14:09.33,0:14:11.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf lama.
Dialogue: 0,0:14:11.83,0:14:14.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dompet dan kuncinya ketemu?
Dialogue: 0,0:14:14.79,0:14:18.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, kami janjian bertemu\Nuntuk mengambilnya.
Dialogue: 0,0:14:18.47,0:14:21.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, ya.\NPadahal kita ada acara begini.
Dialogue: 0,0:14:21.18,0:14:23.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Santai saja.
Dialogue: 0,0:14:32.52,0:14:36.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf aku lama datangnya, Daisy.
Dialogue: 0,0:14:36.73,0:14:38.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Natsunagi...
Dialogue: 0,0:14:38.90,0:14:41.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, aku tahu.
Dialogue: 0,0:14:42.07,0:14:46.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah menerima masa lalu itu.
Dialogue: 0,0:14:47.49,0:14:52.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan melakukan penebusan semaksimal\Nmungkin setelah menerima masa lalu itu.
Dialogue: 0,0:14:53.29,0:14:55.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kamu pergi duluan saja, Kimizuka.
Dialogue: 0,0:14:56.38,0:14:58.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau yakin?
Dialogue: 0,0:14:58.50,0:15:00.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja.
Dialogue: 0,0:15:01.01,0:15:03.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak sendirian.
Dialogue: 0,0:15:04.93,0:15:06.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:15:07.14,0:15:10.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya sudah, hubungi aku\Nkalau ada apa-apa.
Dialogue: 0,0:15:10.35,0:15:12.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, sampai nanti.
Dialogue: 0,0:15:27.32,0:15:28.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo?
Dialogue: 0,0:15:33.00,0:15:35.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu kenalannya putriku?
Dialogue: 0,0:15:36.54,0:15:40.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lama tidak bertemu, Rose Bennett.
Dialogue: 0,0:15:40.30,0:15:45.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf sudah merepotkan\Ndi saat yang sulit.
Dialogue: 0,0:15:46.47,0:15:52.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eng, apa kita pernah bertemu?
Dialogue: 0,0:15:57.31,0:16:02.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah satu tahun berlalu\Nsejak insiden itu, ya.
Dialogue: 0,0:16:02.07,0:16:04.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu cepat berlalu.
Dialogue: 0,0:16:05.53,0:16:08.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini ulang tahun putriku.
Dialogue: 0,0:16:08.08,0:16:10.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, aku tahu.
Dialogue: 0,0:16:10.56,0:16:12.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itulah aku ziarah.
Dialogue: 0,0:16:12.70,0:16:14.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu.
Dialogue: 0,0:16:14.45,0:16:20.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang ada orang selain diriku\Nyang mengingat putriku.
Dialogue: 0,0:16:31.68,0:16:35.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa dia tidak suka bunga ini?
Dialogue: 0,0:16:35.93,0:16:39.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa menanyakan itu lagi.
Dialogue: 0,0:16:43.19,0:16:47.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suatu hari, putriku\Ntiba-tiba menghilang,
Dialogue: 0,0:16:47.19,0:16:50.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu menjadi abu yang\Ntak bisa bicara lagi.
Dialogue: 0,0:16:51.45,0:16:54.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa bisa?
Dialogue: 0,0:17:01.84,0:17:03.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:17:03.67,0:17:07.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi tolong jangan rebut
Dialogue: 0,0:17:07.84,0:17:09.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sesuatu yang bisa\Nkulakukan demi dirinya.
Dialogue: 0,0:17:13.30,0:17:15.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pun mengerti.
Dialogue: 0,0:17:15.60,0:17:19.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kata-kataku, uluran tanganku...
Dialogue: 0,0:17:19.90,0:17:24.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa menjadi tongkat\Nuntuk membantunya bangkit kembali.
Dialogue: 0,0:17:24.40,0:17:27.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lantas, suara siapa lagi?\NKira-kira siapa...
Dialogue: 0,0:17:27.28,0:17:33.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kira-kira siapa yang bisa\Nmengusap air mata seorang ibu
Dialogue: 0,0:17:33.11,0:17:35.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang menangisi putrinya?
Dialogue: 0,0:17:40.71,0:17:44.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mohon, bantu aku.
Dialogue: 0,0:17:49.47,0:17:53.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang dari awal,\Naku yang akan melakukannya.
Dialogue: 0,0:17:54.18,0:17:56.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan seenaknya memikul dosaku.
Dialogue: 0,0:17:56.89,0:18:01.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang akan bertanggung jawab sendiri\Natas dosa yang kulakukan.
Dialogue: 0,0:18:13.32,0:18:14.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:18:16.28,0:18:22.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini adalah satu-satunya hak sekaligus\Nkewajiban yang diberikan kepadaku.
Dialogue: 0,0:18:23.46,0:18:27.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rose Bennett, ini bukan dariku.
Dialogue: 0,0:18:27.92,0:18:30.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini hadiah darinya.
Dialogue: 0,0:18:32.47,0:18:35.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan benihku adalah roh kata.
Dialogue: 0,0:18:35.80,0:18:38.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang memiliki kekuatan\Nspiritual dalam kata-kata
Dialogue: 0,0:18:38.77,0:18:43.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dapat bertukar kata dengan orang\Nyang telah berbagi darah denganku.
Dialogue: 0,0:18:44.94,0:18:47.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, ini
Dialogue: 0,0:18:48.23,0:18:52.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah kata-kata terakhir\Nyang ditinggalkan Daisy Bennett.
Dialogue: 0,0:18:54.20,0:18:56.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mencintaimu, Ibu.
Dialogue: 0,0:19:04.79,0:19:06.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daisy!
Dialogue: 0,0:19:17.43,0:19:18.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:19:19.30,0:19:23.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin dosaku\Nsetahun yang lalu
Dialogue: 0,0:19:23.81,0:19:26.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan dimaafkan hanya karena ini.
Dialogue: 0,0:19:26.19,0:19:28.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seterusnya pun mustahil.
Dialogue: 0,0:19:29.44,0:19:33.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi yang bisa kulakukan ke depannya
Dialogue: 0,0:19:33.49,0:19:36.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah terus menyelamatkan orang
Dialogue: 0,0:19:36.28,0:19:39.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tanpa terbatasi posisiku\Nsebagai detektif.
Dialogue: 0,0:19:40.08,0:19:42.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, 'kan, Kimizuka?
Dialogue: 0,0:19:49.63,0:19:52.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak punya kenangan\Nyang indah di sini.
Dialogue: 0,0:19:54.72,0:19:56.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada pilihan lain.
Dialogue: 0,0:20:04.73,0:20:07.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Olivia?
Dialogue: 0,0:20:08.10,0:20:09.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon maaf.
Dialogue: 0,0:20:10.36,0:20:14.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.\NTernyata itu ulahmu.
Dialogue: 0,0:20:14.38,0:20:17.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau yang mencuri dompet\Ndan kunciku di dalam pesawat.
Dialogue: 0,0:20:18.16,0:20:20.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa tujuanmu melakukan ini?
Dialogue: 0,0:20:21.20,0:20:25.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk mengantar Tuan Kimizuka\Nke hadapan Nona Miko.
Dialogue: 0,0:20:27.12,0:20:30.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya adalah suruhan Nona Miko.
Dialogue: 0,0:20:30.88,0:20:35.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika Tuan percaya pada saya\Nwalau hanya sedikit,
Dialogue: 0,0:20:36.09,0:20:38.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}silakan masuk.
Dialogue: 0,0:20:42.60,0:20:48.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Miko adalah orang yang tak mau\Nbertemu dengan Penjaga lain.
Dialogue: 0,0:20:48.90,0:20:53.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oleh karena itu, saya harus\Nmenyeleksi lebih dulu
Dialogue: 0,0:20:53.11,0:20:56.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}orang-orang yang ingin\Nmenghadap beliau.
Dialogue: 0,0:20:58.15,0:21:00.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak insiden empat tahun lalu,
Dialogue: 0,0:21:00.66,0:21:04.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami memantau semua\Npergerakan Tuan Kimizuka.
Dialogue: 0,0:21:04.62,0:21:07.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan sudah melalui banyak hal, ya.
Dialogue: 0,0:21:07.54,0:21:11.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku penasaran "semua" itu apa saja...
Dialogue: 0,0:21:12.46,0:21:16.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa berarti kami lolos dari seleksimu?
Dialogue: 0,0:21:16.30,0:21:21.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, saya pribadi merasa begitu.
Dialogue: 0,0:21:21.76,0:21:22.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:21:27.02,0:21:28.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini tempatnya.
Dialogue: 0,0:21:49.25,0:21:50.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa?
Dialogue: 0,0:21:54.21,0:21:56.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi kau Miko, ya?
Dialogue: 0,0:21:56.46,0:22:00.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong beri tahu aku\Ncara mengubah masa depan.
Dialogue: 0,0:22:01.55,0:22:03.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mia Whitlock!
Dialogue: 0,0:22:05.39,0:22:10.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di pagi kau membuka matamu♪
Dialogue: 0,0:22:10.35,0:22:15.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagai cahaya yang menyinari♪
Dialogue: 0,0:22:15.86,0:22:24.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku biarkan gorden\Ndan jendela kamar terbuka sedikit♪
Dialogue: 0,0:22:24.95,0:22:30.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari-hari yang polos itu\Nbegitu menyilaukan♪
Dialogue: 0,0:22:30.87,0:22:35.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kepolosan yang membuatku\Ntanpa sadar memalingkan pandangan♪
Dialogue: 0,0:22:35.00,0:22:40.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sembari menelusuri\Ningatan yang terjatuh♪
Dialogue: 0,0:22:40.38,0:22:46.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berlarian di pantai telanjang kaki♪
Dialogue: 0,0:22:46.47,0:22:51.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak tertahankan,\Ntak kuat kubendung lagi♪
Dialogue: 0,0:22:51.77,0:22:56.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menghubungkan masa kini\Nyang meluap-luap menuju hari esok♪
Dialogue: 0,0:22:56.90,0:23:05.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Janji kelingkingku denganmu\Ndalam mimpi♪
Dialogue: 0,0:23:07.37,0:23:12.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesedihan dan kegundahan,\Njuga cinta yang begitu menyakitkan♪
Dialogue: 0,0:23:12.66,0:23:22.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena rasa dalam hati ini\Nbukan cuma milikku seorang♪
Dialogue: 0,0:23:22.00,0:23:25.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menjaganya♪
Dialogue: 0,0:23:25.93,0:23:32.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai kau terbangun♪
