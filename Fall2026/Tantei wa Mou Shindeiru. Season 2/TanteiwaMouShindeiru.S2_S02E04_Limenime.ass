Dialogue: 0,0:03:12.50,0:03:20.68,sign,,0000,0000,0000,,(The Detective Is Already Dead. Season 2)
Dialogue: 0,0:04:33.04,0:04:35.50,sign,,0000,0000,0000,,(Episode 4 - Hal yang Bisa Dilakukan Kita\Nyang Masih Hidup)
Dialogue: 0,0:08:21.56,0:08:22.77,sign,,0000,0000,0000,,(Kimihiko cukup awasi saja\NSaikawa Yui mengambil keputusan)
Dialogue: 0,0:23:35.02,0:23:40.02,sign,,0000,0000,0000,,(Episode 5 - Itu Jawaban Terakhir\Nyang Diberikan)
Dialogue: 0,0:00:02.48,0:00:03.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wadah?
Dialogue: 0,0:00:03.85,0:00:05.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudmu?
Dialogue: 0,0:00:06.32,0:00:09.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ceritanya bermula\Ndari beberapa dekade lalu.
Dialogue: 0,0:00:09.69,0:00:14.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seed datang dari luar planet ini\Nsebagai sebuah benih.
Dialogue: 0,0:00:14.08,0:00:18.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, ia tidak dapat beradaptasi\Nsepenuhnya dengan lingkungan Bumi.
Dialogue: 0,0:00:18.87,0:00:22.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oleh karena itu,\NSeed mencari wadah manusia
Dialogue: 0,0:00:22.54,0:00:24.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}demi memungkinkan\Nkelangsungan hidupnya.
Dialogue: 0,0:00:25.42,0:00:28.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi bukan berarti boleh\Ndengan tubuh apa saja.
Dialogue: 0,0:00:28.55,0:00:33.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syarat minimalnya adalah wadah itu\Nharus cocok dengan benihnya.
Dialogue: 0,0:00:33.38,0:00:35.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cocok dengan benih?
Dialogue: 0,0:00:35.21,0:00:36.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan...
Dialogue: 0,0:00:36.55,0:00:39.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fasilitas yang disebut Natsunagi?
Dialogue: 0,0:00:39.56,0:00:41.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya sudah terhubung.
Dialogue: 0,0:00:42.44,0:00:46.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi eksperimennya\Ntidak berjalan mulus.
Dialogue: 0,0:00:46.23,0:00:51.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski benihnya cocok,\Nbanyak kasus terjadi efek samping.
Dialogue: 0,0:00:51.11,0:00:52.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Efek samping?
Dialogue: 0,0:00:52.57,0:00:54.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:00:54.10,0:00:56.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Efek sampingnya merenggut\Npancaindra manusia,
Dialogue: 0,0:00:56.62,0:00:59.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bahkan melahap habis masa hidupnya.
Dialogue: 0,0:00:59.31,0:01:02.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itulah Seed mencari\Nwadah yang sempurna
Dialogue: 0,0:01:02.79,0:01:05.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan menemukan dua kandidat\Nsebagai sampel.
Dialogue: 0,0:01:05.71,0:01:06.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu adalah...
Dialogue: 0,0:01:06.71,0:01:08.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siesta dan Hel, ya?
Dialogue: 0,0:01:08.84,0:01:14.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kau sendiri tahu hasilnya, 'kan, Watson?
Dialogue: 0,0:01:14.88,0:01:16.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setahun yang lalu,
Dialogue: 0,0:01:16.39,0:01:18.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tubuh si detektif mati,
Dialogue: 0,0:01:18.39,0:01:22.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sementara wadah yang satunya lagi\Nkapasitasnya sudah penuh
Dialogue: 0,0:01:22.14,0:01:24.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena menampung\Nkesadaran dari tiga orang.
Dialogue: 0,0:01:24.90,0:01:27.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika mencoba membukanya secara paksa,
Dialogue: 0,0:01:27.61,0:01:30.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}wadahnya kemungkinan besar akan rusak.
Dialogue: 0,0:01:30.86,0:01:33.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maka dari itu, Seed terus menunggu.
Dialogue: 0,0:01:33.78,0:01:35.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari di mana mereka berdua berpisah lagi.
Dialogue: 0,0:01:37.41,0:01:39.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi hari itu tak kunjung datang.
Dialogue: 0,0:01:39.50,0:01:41.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu dia masalahnya.
Dialogue: 0,0:01:41.50,0:01:45.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maka, dia memutuskan untuk\Nmengamankan wadah baru.
Dialogue: 0,0:01:45.52,0:01:47.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu adalah Saikawa Yui.
Dialogue: 0,0:01:48.46,0:01:52.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak salah lagi yang diincar\NSeed berikutnya adalah gadis itu.
Dialogue: 0,0:01:52.30,0:01:56.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kita harus mengambil langkah\Nbalasan lebih dulu.
Dialogue: 0,0:01:56.97,0:01:59.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, gadis itu juga
Dialogue: 0,0:01:59.10,0:02:02.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}punya alasan bertarung\Nmelawan SPES lebih dari siapa pun.
Dialogue: 0,0:02:02.96,0:02:04.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku?
Dialogue: 0,0:02:05.10,0:02:06.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya.
Dialogue: 0,0:02:06.44,0:02:09.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak diberi tahu\Nalasan mata kiri itu
Dialogue: 0,0:02:09.98,0:02:11.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tertanam dalam dirimu, ya?
Dialogue: 0,0:02:12.40,0:02:16.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baru tahu belum lama ini,\Ngadis itu menderita tumor ganas
Dialogue: 0,0:02:16.03,0:02:18.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di mata kirinya tak lama setelah lahir.
Dialogue: 0,0:02:19.16,0:02:22.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Metode pengobatan\Njika gejalanya makin parah
Dialogue: 0,0:02:22.25,0:02:24.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah operasi pengangkatan bola mata,
Dialogue: 0,0:02:24.42,0:02:27.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi itu tidak menjamin\Nakan sembuh seutuhnya.
Dialogue: 0,0:02:28.19,0:02:32.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya orang tua Saikawa\Nbergantung pada SPES?
Dialogue: 0,0:02:32.71,0:02:34.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak...
Dialogue: 0,0:02:36.51,0:02:37.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan...
Dialogue: 0,0:02:37.80,0:02:41.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dugaan kecurangan keuangan\Nberkaitan dengan fasilitas itu...
Dialogue: 0,0:02:41.64,0:02:43.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong jawab satu pertanyaanku.
Dialogue: 0,0:02:43.81,0:02:46.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika ada orang biasa
Dialogue: 0,0:02:46.10,0:02:49.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang menjalin kontrak\Ndan mengetahui rahasia SPES,
Dialogue: 0,0:02:50.06,0:02:53.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu saat kontrak itu berakhir,
Dialogue: 0,0:02:54.19,0:02:57.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa yang dilakukan SPES\Npada orang biasa itu?
Dialogue: 0,0:02:58.61,0:03:01.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak salah lagi, dibunuh.
Dialogue: 0,0:03:03.29,0:03:14.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buket bunga yang\Ntak pernah layu di jantungku♪
Dialogue: 0,0:03:23.64,0:03:29.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, mungkin sudah terlambat,\Ntapi aku ingin tanya sesuatu♪
Dialogue: 0,0:03:29.94,0:03:36.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah kamu bahagia melewati\Nhari-hari yang kita habiskan bersama?♪
Dialogue: 0,0:03:36.07,0:03:42.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak pernah bermimpi tentang\Nmasa depan tanpa kehilangan apa-apa♪
Dialogue: 0,0:03:42.66,0:03:50.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bila bisa memelukmu sekali lagi\Nuntuk terakhir kali♪
Dialogue: 0,0:03:50.58,0:03:56.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma tidur sedikit lebih lama, kok♪
Dialogue: 0,0:03:56.17,0:04:02.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan berwajah begitu♪
Dialogue: 0,0:04:02.51,0:04:09.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama jantungku masih\Nberdetak dalam dirimu♪
Dialogue: 0,0:04:09.40,0:04:16.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pasti takkan pernah\Nmelupakan kesedihan itu♪
Dialogue: 0,0:04:16.53,0:04:19.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak terlihat apa-apa,\Ntapi tampak samar-samar♪
Dialogue: 0,0:04:19.74,0:04:22.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bak cahaya yang menyinari\Nlautan di malam hari♪
Dialogue: 0,0:04:22.99,0:04:30.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memandangi kelanjutan\Nmimpi putih itu di sampingmu♪
Dialogue: 0,0:04:36.54,0:04:37.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin...
Dialogue: 0,0:04:37.92,0:04:38.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saikawa!
Dialogue: 0,0:04:41.46,0:04:43.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah mengerti, 'kan?
Dialogue: 0,0:04:43.66,0:04:46.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saikawa Yui punya\Nalasan untuk bertarung.
Dialogue: 0,0:04:46.97,0:04:49.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Punya takdir untuk menodongkan\Nsenjata ke SPES.
Dialogue: 0,0:04:52.89,0:04:54.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Koumori—
Dialogue: 0,0:04:54.15,0:04:56.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar, payah sekali.
Dialogue: 0,0:04:56.73,0:05:01.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa-bisanya kau berpikir bisa membujuk\Ndengan cara negosiasi seperti itu,
Dialogue: 0,0:05:01.61,0:05:03.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dasar mamalia!
Dialogue: 0,0:05:05.82,0:05:08.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mundur saja.
Dialogue: 0,0:05:08.66,0:05:11.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Vampir, jangan salah paham.
Dialogue: 0,0:05:11.45,0:05:15.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memang minta bekerja sama,\Ntapi aku tidak jadi bawahan—
Dialogue: 0,0:05:15.29,0:05:18.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan belagu, makhluk rendahan!
Dialogue: 0,0:05:24.92,0:05:30.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan mengampuni\Nseorang manusia lancang kepadaku.
Dialogue: 0,0:05:30.31,0:05:33.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sujudlah di situ terus\Nsambil melihat contoh dariku.
Dialogue: 0,0:05:34.72,0:05:36.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah.
Dialogue: 0,0:05:36.18,0:05:38.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana, Gadis Sapphire?
Dialogue: 0,0:05:38.98,0:05:42.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau mau membantu\Nkami menumpas SPES,
Dialogue: 0,0:05:42.32,0:05:44.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan mengabulkan\Nsatu permintaanmu.
Dialogue: 0,0:05:45.02,0:05:46.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permintaan?
Dialogue: 0,0:05:46.53,0:05:49.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, benar. Apa saja boleh.
Dialogue: 0,0:05:49.94,0:05:54.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misalnya, bagaimana kalau\Nmembangkitkan orang tuamu?
Dialogue: 0,0:05:55.20,0:05:59.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membangkitkan Ayah dan Ibu?
Dialogue: 0,0:05:59.67,0:06:01.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil.
Dialogue: 0,0:06:01.30,0:06:03.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang sudah mati
Dialogue: 0,0:06:03.26,0:06:05.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak bisa dibangkitkan semudah itu!
Dialogue: 0,0:06:06.21,0:06:08.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, kau benar.
Dialogue: 0,0:06:08.09,0:06:11.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku adalah vampir.\NRaja keabadian.
Dialogue: 0,0:06:11.81,0:06:17.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah itu tulang ataupun rambut.\NApa saja bisa selama masih ada DNA-nya.
Dialogue: 0,0:06:17.27,0:06:20.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misalnya, benda seperti ini juga.
Dialogue: 0,0:06:21.32,0:06:23.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu... benih?!
Dialogue: 0,0:06:24.32,0:06:27.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kembalilah, reptil!
Dialogue: 0,0:06:43.09,0:06:44.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cha-Chameleon?!
Dialogue: 0,0:06:44.84,0:06:50.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Darah keabadian yang mengalir dalam tubuhku\Ndapat membangkitkan orang mati
Dialogue: 0,0:06:50.22,0:06:52.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan mempertahankan naluri\Nterkuat mereka semasa hidup.
Dialogue: 0,0:06:52.87,0:06:58.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan kata lain, mereka bisa mewujudkan\Nkeinginan mereka semasa hidup.
Dialogue: 0,0:07:00.27,0:07:03.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana, Gadis Sapphire?
Dialogue: 0,0:07:03.11,0:07:06.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutmu apa naluri orang tua?
Dialogue: 0,0:07:07.48,0:07:10.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kasih sayang tanpa pamrih pada anaknya.
Dialogue: 0,0:07:11.28,0:07:15.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika keinginan itu bisa terkabul\Nbahkan setelah mati,
Dialogue: 0,0:07:15.54,0:07:18.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bukankah itu hal yang\Nsangat membahagiakan?
Dialogue: 0,0:07:22.63,0:07:27.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika tidak cepat kau putuskan,\Nnalurinya takkan tinggal diam.
Dialogue: 0,0:07:35.22,0:07:37.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan begini kesepakatannya.
Dialogue: 0,0:07:38.56,0:07:40.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Vampir!
Dialogue: 0,0:07:40.27,0:07:43.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, hebat juga masih\Nbisa bergerak, Koumori.
Dialogue: 0,0:07:44.81,0:07:50.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengajukan kesepakatan dengan asumsi\Nbisa membangkitkan orang mati
Dialogue: 0,0:07:50.07,0:07:51.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dalam wujud sempurna.
Dialogue: 0,0:07:51.87,0:07:53.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolol.
Dialogue: 0,0:07:53.66,0:07:56.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana ada keajaiban\Ntanpa harga yang harus dibayar?
Dialogue: 0,0:07:56.79,0:07:58.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau jangan-jangan...
Dialogue: 0,0:07:58.61,0:08:04.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau serius berpikir aku bisa mewujudkan\Nharapanmu dengan sehelai rambut?
Dialogue: 0,0:08:06.25,0:08:09.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana sekarang, Gadis Sapphire?
Dialogue: 0,0:08:10.00,0:08:13.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau ingin bertemu\Ndengan orang tuamu lagi?
Dialogue: 0,0:08:17.97,0:08:19.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saikawa...
Dialogue: 0,0:08:32.53,0:08:34.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kasihan sekali.
Dialogue: 0,0:08:34.86,0:08:37.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah tidak perlu bertarung lagi.
Dialogue: 0,0:08:37.58,0:08:44.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertarunganmu sudah diakhiri Detektif Hebat\Nyang baik hati dan asistennya.
Dialogue: 0,0:08:45.79,0:08:46.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi...
Dialogue: 0,0:08:47.50,0:08:50.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon istirahatlah.
Dialogue: 0,0:08:54.51,0:08:57.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bilang, "Tolong bernyanyilah."
Dialogue: 0,0:08:58.14,0:08:59.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh?
Dialogue: 0,0:08:59.98,0:09:02.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah. Aku tidak tahu.
Dialogue: 0,0:09:02.72,0:09:05.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi apa boleh buat, 'kan?
Dialogue: 0,0:09:05.89,0:09:09.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang mati tak bisa\Nmengatakan apa-apa lagi.
Dialogue: 0,0:09:09.73,0:09:15.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, walau kita dianggap\Nsombong dan egois,
Dialogue: 0,0:09:15.61,0:09:19.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita cuma perlu pikirkan\Napa yang orang itu inginkan,
Dialogue: 0,0:09:20.24,0:09:24.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}percaya itu dan melakukannya.
Dialogue: 0,0:09:26.96,0:09:29.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, kau benar.
Dialogue: 0,0:09:29.65,0:09:31.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, maaf.
Dialogue: 0,0:09:31.70,0:09:35.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku percaya ini yang kamu inginkan.
Dialogue: 0,0:09:36.88,0:09:41.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hal yang tak terlihat ada di sini♪
Dialogue: 0,0:09:41.60,0:09:46.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu terasa sangat hangat♪
Dialogue: 0,0:09:46.27,0:09:50.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mimpi yang ditinggalkan seseorang♪
Dialogue: 0,0:09:50.48,0:09:56.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menanti pemiliknya kembali dalam sunyi♪
Dialogue: 0,0:09:56.66,0:09:59.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saikawa tidak dibutakan dendam.
Dialogue: 0,0:09:56.66,0:10:00.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hal yang biru dan tak terlihat♪
Dialogue: 0,0:09:59.73,0:10:01.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tidak baca suasana,
Dialogue: 0,0:10:00.83,0:10:04.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kuyakin ada di sini♪
Dialogue: 0,0:10:01.49,0:10:04.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia bernyanyi mengabaikan\Nmanusia buatan dan vampir.
Dialogue: 0,0:10:04.79,0:10:13.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pungut harapan yang tumpah\Ndan terus bernyanyi♪
Dialogue: 0,0:10:05.29,0:10:07.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi tidak masalah.
Dialogue: 0,0:10:07.96,0:10:10.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saikawa Yui haruslah begitu.
Dialogue: 0,0:10:18.09,0:10:19.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pulang!
Dialogue: 0,0:10:20.05,0:10:22.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf pulang telat.
Dialogue: 0,0:10:25.35,0:10:27.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Capeknya.
Dialogue: 0,0:10:29.77,0:10:34.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus siap-siap pulang,\Njadi aku balik ke ruang ganti duluan, ya.
Dialogue: 0,0:10:34.28,0:10:36.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya...
Dialogue: 0,0:10:45.62,0:10:48.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada juga orang yang menarik, ya.
Dialogue: 0,0:11:11.14,0:11:12.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan khawatir.
Dialogue: 0,0:11:12.81,0:11:16.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tidak sebodoh itu sampai\Nterus-terusan membuntutimu.
Dialogue: 0,0:11:17.23,0:11:18.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Scarlet.
Dialogue: 0,0:11:18.57,0:11:23.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau bekerja sama\Ndengan Koumori, bukan Seed?
Dialogue: 0,0:11:23.61,0:11:25.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma keisengan.
Dialogue: 0,0:11:25.66,0:11:27.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anggap saja begitu.
Dialogue: 0,0:11:27.70,0:11:32.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin coba memastikan\NSingularitas dulu.
Dialogue: 0,0:11:32.00,0:11:33.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Singularitas?
Dialogue: 0,0:11:34.71,0:11:40.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, imbalan yang ditawarkan\Nkepadaku di awal
Dialogue: 0,0:11:40.05,0:11:41.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidaklah normal.
Dialogue: 0,0:11:41.93,0:11:42.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:11:42.59,0:11:43.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekalian saja.
Dialogue: 0,0:11:43.97,0:11:46.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau bertanya satu hal juga.
Dialogue: 0,0:11:46.98,0:11:51.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Adakah orang yang ingin kau bangkitkan?
Dialogue: 0,0:11:53.02,0:11:55.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, aku tidak butuh jawabanmu sekarang.
Dialogue: 0,0:11:56.11,0:11:58.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai jumpa, manusia.
Dialogue: 0,0:12:02.40,0:12:03.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nagisa!
Dialogue: 0,0:12:04.66,0:12:06.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nagisa!
Dialogue: 0,0:12:06.71,0:12:08.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nagisa!
Dialogue: 0,0:12:10.42,0:12:11.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Natsunagi!
Dialogue: 0,0:12:14.46,0:12:16.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kimizuka...
Dialogue: 0,0:12:17.51,0:12:19.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yui...
Dialogue: 0,0:12:19.93,0:12:21.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lari...
Dialogue: 0,0:12:27.27,0:12:28.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:12:33.15,0:12:37.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oi, oi, kau berbeda dari biasanya.
Dialogue: 0,0:12:37.16,0:12:39.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Charlotte Arisaka Anderson.
Dialogue: 0,0:12:40.70,0:12:41.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lari.
Dialogue: 0,0:12:41.58,0:12:42.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi!
Dialogue: 0,0:12:42.41,0:12:43.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Percuma.
Dialogue: 0,0:12:43.70,0:12:46.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski harus mengejarmu\Nsampai ujung dunia,
Dialogue: 0,0:12:46.40,0:12:48.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan membunuh Saikawa Yui.
Dialogue: 0,0:12:48.96,0:12:50.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:12:50.17,0:12:53.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal kita bersama tadi pagi\Ndan banyak mengobrol!
Dialogue: 0,0:12:53.96,0:12:57.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baru saja dapat perintah itu.
Dialogue: 0,0:12:57.76,0:12:59.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada alasan lain.
Dialogue: 0,0:13:04.72,0:13:06.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu mengganggu,
Dialogue: 0,0:13:07.22,0:13:10.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku juga akan membunuhmu di sini!
Dialogue: 0,0:13:13.61,0:13:18.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga, keputusanku tepat\Nmengisap darahmu waktu itu.
Dialogue: 0,0:13:22.41,0:13:26.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh juga kau bisa memotong lenganku.
Dialogue: 0,0:13:26.41,0:13:28.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk seorang manusia.
Dialogue: 0,0:13:29.29,0:13:30.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa?
Dialogue: 0,0:13:30.96,0:13:35.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya, keberadaanku ini tidak normal.
Dialogue: 0,0:13:36.71,0:13:39.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Scarlet, kenapa kau ada di sini?
Dialogue: 0,0:13:39.84,0:13:43.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang, aku cuma lupa\Nmemberikan sesuatu padamu.
Dialogue: 0,0:13:43.72,0:13:47.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Imbalan yang seharusnya\Nkuterima dari Koumori.
Dialogue: 0,0:13:47.06,0:13:51.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kontraknya dibatalkan,\Naku mau mengembalikan ini padanya.
Dialogue: 0,0:13:51.44,0:13:53.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku malah diminta\Nmemberikannya padamu.
Dialogue: 0,0:13:54.25,0:13:55.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini...
Dialogue: 0,0:13:55.73,0:13:59.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya benda ini bisa membuatku\Nberjalan di bawah sinar matahari,
Dialogue: 0,0:13:59.65,0:14:01.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku tidak tahu kebenarannya.
Dialogue: 0,0:14:01.32,0:14:05.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tawaran yang sangat\Nmenggiurkan bagi vampir.
Dialogue: 0,0:14:06.37,0:14:08.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, manusia...
Dialogue: 0,0:14:08.50,0:14:10.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Urusanku sudah selesai.
Dialogue: 0,0:14:10.71,0:14:12.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf mengganggu.
Dialogue: 0,0:14:12.50,0:14:14.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, vampir.
Dialogue: 0,0:14:15.79,0:14:18.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisakah kau kabur\Nmembawa dua orang ini?
Dialogue: 0,0:14:19.92,0:14:22.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu kontrak resmi?
Dialogue: 0,0:14:22.51,0:14:23.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika begitu...
Dialogue: 0,0:14:23.88,0:14:24.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bayarannya
Dialogue: 0,0:14:25.47,0:14:27.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah darahku yang kau isap tadi.
Dialogue: 0,0:14:29.76,0:14:31.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu.
Dialogue: 0,0:14:31.31,0:14:34.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi apa kau yakin tidak\Nmembuat kontrak denganku
Dialogue: 0,0:14:34.52,0:14:37.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk membunuh gadis pirang itu?
Dialogue: 0,0:14:37.47,0:14:38.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:14:38.81,0:14:42.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia harus kuhajar dulu.
Dialogue: 0,0:14:43.24,0:14:46.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.\NAku mengabulkan permintaanmu.
Dialogue: 0,0:14:47.01,0:14:51.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lain kali, temui aku lagi\Ndengan membawa imbalan baru.
Dialogue: 0,0:14:51.62,0:14:53.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Singularitas.
Dialogue: 0,0:14:54.58,0:14:56.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kimizuka!
Dialogue: 0,0:14:56.08,0:14:58.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita pasti bertemu lagi!
Dialogue: 0,0:15:01.59,0:15:03.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah...
Dialogue: 0,0:15:03.20,0:15:05.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah siap?
Dialogue: 0,0:15:05.05,0:15:06.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Char.
Dialogue: 0,0:15:06.97,0:15:09.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang harusnya tanya itu.
Dialogue: 0,0:15:25.74,0:15:27.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial!
Dialogue: 0,0:15:46.47,0:15:50.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kimizuka, kamu pasti\Ntidak akan bisa menikah.
Dialogue: 0,0:15:50.10,0:15:51.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil!
Dialogue: 0,0:15:51.18,0:15:55.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang orang normal tega memukul\Ngadis lemah? Di zaman ini?
Dialogue: 0,0:15:55.77,0:15:57.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Absurd.
Dialogue: 0,0:15:57.46,0:16:00.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku terluka lebih parah, tahu.
Dialogue: 0,0:16:03.36,0:16:04.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Char.
Dialogue: 0,0:16:05.15,0:16:07.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak berniat membunuhku.
Dialogue: 0,0:16:07.86,0:16:09.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, 'kan?
Dialogue: 0,0:16:10.37,0:16:15.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga takkan segan-segan\Nkalau kamu mengganggu lagi.
Dialogue: 0,0:16:15.37,0:16:19.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan berarti kau berkhianat, 'kan?
Dialogue: 0,0:16:19.21,0:16:21.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, benar.
Dialogue: 0,0:16:21.11,0:16:25.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bertindak berdasarkan\Nperintah dari organisasi.
Dialogue: 0,0:16:25.26,0:16:28.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, orang yang memberikan\Nperintah kepadaku
Dialogue: 0,0:16:28.68,0:16:32.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}punya tujuan yang sama\Nuntuk memusnahkan SPES.
Dialogue: 0,0:16:32.71,0:16:37.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang membedakan cuma tekad\Nuntuk melakukannya.
Dialogue: 0,0:16:37.85,0:16:41.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perintah dari organisasi itu\Nadalah membunuh Saikawa?
Dialogue: 0,0:16:42.56,0:16:44.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu juga sudah mengerti, 'kan?
Dialogue: 0,0:16:45.98,0:16:49.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika tak ada lagi target\Nuntuk dirasuki, Seed akan mati.
Dialogue: 0,0:16:50.05,0:16:54.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau mengorbankan Saikawa sebagai\Nwadah untuk mengalahkan Seed?
Dialogue: 0,0:16:55.83,0:16:57.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Char.
Dialogue: 0,0:16:58.08,0:17:02.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau adalah agen yang patuh\Nmutlak pada perintah atasan,
Dialogue: 0,0:17:02.50,0:17:04.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan protes menggantikanmu.
Dialogue: 0,0:17:05.34,0:17:07.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi beri tahu aku.
Dialogue: 0,0:17:07.08,0:17:11.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa atasanmu yang terpikirkan\Nstrategi tidak masuk akal itu?
Dialogue: 0,0:17:11.43,0:17:12.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku.
Dialogue: 0,0:17:14.68,0:17:19.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang memberikan perintah kepadanya\Nuntuk membunuh Saikawa Yui.
Dialogue: 0,0:17:19.73,0:17:22.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu Fuubi?
Dialogue: 0,0:17:30.61,0:17:34.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Charlotte.\NApa yang kamu lakukan?
Dialogue: 0,0:17:34.32,0:17:38.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah bilang untuk menghabisi\NSaikawa Yui di sini, 'kan?
Dialogue: 0,0:17:38.54,0:17:40.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kau lakukan?!
Dialogue: 0,0:17:43.58,0:17:45.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan mengganggu.
Dialogue: 0,0:17:46.59,0:17:48.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tembakan kedua takkan meleset.
Dialogue: 0,0:17:49.34,0:17:50.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kase Fuubi...
Dialogue: 0,0:17:51.21,0:17:53.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa kau sebenarnya?
Dialogue: 0,0:17:54.59,0:17:56.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pembunuh.
Dialogue: 0,0:17:57.60,0:18:00.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau salah satu Penjaga juga?
Dialogue: 0,0:18:00.60,0:18:01.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah...
Dialogue: 0,0:18:01.90,0:18:04.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah tahu kata itu, ya.
Dialogue: 0,0:18:05.27,0:18:10.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal selama ini aku percaya\Nkau polisi wanita baik hati.
Dialogue: 0,0:18:13.95,0:18:16.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Polisi cuma samaran.
Dialogue: 0,0:18:16.82,0:18:19.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyembunyikan diri, menipu dunia,
Dialogue: 0,0:18:19.91,0:18:21.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan membunuh musuh.
Dialogue: 0,0:18:22.04,0:18:24.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah pekerjaan pembunuh.
Dialogue: 0,0:18:24.87,0:18:28.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika aku tidak kerepotan\Ndengan robot itu,
Dialogue: 0,0:18:28.21,0:18:30.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku pasti bisa bergerak lebih cepat.
Dialogue: 0,0:18:30.88,0:18:32.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh?
Dialogue: 0,0:18:32.42,0:18:36.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Koumori bisa muncul di hadapan kami\Npadahal Noches bilang bakal mengurusnya,
Dialogue: 0,0:18:36.76,0:18:40.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}itu karena Noches mengurus\NFuubi yang lebih mengancam, ya?
Dialogue: 0,0:18:42.39,0:18:46.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, Charlotte...\NMereka di mana sekarang?
Dialogue: 0,0:18:46.30,0:18:48.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pasti tahu itu.
Dialogue: 0,0:18:48.77,0:18:49.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya...
Dialogue: 0,0:18:49.93,0:18:52.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, ayo cepat berdiri.
Dialogue: 0,0:18:52.61,0:18:53.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo.
Dialogue: 0,0:18:55.24,0:18:56.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu.
Dialogue: 0,0:18:57.24,0:19:00.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pikir aku akan\Nmembiarkanmu begitu saja?
Dialogue: 0,0:19:03.20,0:19:05.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu menghalangi petugas.
Dialogue: 0,0:19:13.26,0:19:17.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harusnya melanggar UU Kepemilikan\NSenjata Tajam dan Senpi dulu, 'kan?
Dialogue: 0,0:19:32.07,0:19:34.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siesta...
Dialogue: 0,0:19:38.66,0:19:39.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu!
Dialogue: 0,0:19:39.91,0:19:41.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan pergi, Siesta!
Dialogue: 0,0:19:42.49,0:19:43.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siesta!
Dialogue: 0,0:19:45.66,0:19:46.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh.
Dialogue: 0,0:19:48.67,0:19:50.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siesta?
Dialogue: 0,0:19:52.30,0:19:54.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bodoh, ya, Kimihiko?
Dialogue: 0,0:19:55.47,0:19:57.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memalukan sekali.
Dialogue: 0,0:19:59.34,0:20:02.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau juga tampak mengenaskan.
Dialogue: 0,0:20:02.31,0:20:04.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan berarti aku kalah.
Dialogue: 0,0:20:04.43,0:20:08.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma mundur sementara\Ndemi strategi.
Dialogue: 0,0:20:08.35,0:20:11.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harga dirimu tinggi seperti Siesta.
Dialogue: 0,0:20:15.53,0:20:18.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, aku harus apa?
Dialogue: 0,0:20:18.95,0:20:23.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin kau juga tahu,\Ntapi kondisinya buntu.
Dialogue: 0,0:20:24.54,0:20:26.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa malah bingung?
Dialogue: 0,0:20:26.70,0:20:29.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam kasusmu, mengingat watakmu,
Dialogue: 0,0:20:29.71,0:20:32.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}seluruh dunia seolah jadi musuh, 'kan?
Dialogue: 0,0:20:32.13,0:20:34.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dosaku dalam sekali.
Dialogue: 0,0:20:34.13,0:20:37.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dosa besar apa yang kulakukan\Ndi kehidupanku sebelumnya?
Dialogue: 0,0:20:38.59,0:20:41.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, kalaupun\Nmemang benar begitu,
Dialogue: 0,0:20:42.14,0:20:44.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ada Siesta.
Dialogue: 0,0:20:45.31,0:20:46.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi...
Dialogue: 0,0:20:48.14,0:20:51.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kimihiko mau apa?
Dialogue: 0,0:20:52.27,0:20:53.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi...
Dialogue: 0,0:20:53.86,0:20:56.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mau apa setelah ini?
Dialogue: 0,0:20:57.61,0:20:58.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siesta.
Dialogue: 0,0:21:00.91,0:21:02.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk kali ini saja.
Dialogue: 0,0:21:03.28,0:21:05.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maukah kau jadi asistenku?
Dialogue: 0,0:21:08.79,0:21:10.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:21:10.74,0:21:15.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, aku bukan Nona Siesta,\Ntapi Noches.
Dialogue: 0,0:21:20.26,0:21:21.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini...
Dialogue: 0,0:21:22.51,0:21:25.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sirius ver Beta.
Dialogue: 0,0:21:26.47,0:21:28.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong...
Dialogue: 0,0:21:28.47,0:21:30.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa berpakaian seperti itu?
Dialogue: 0,0:21:31.48,0:21:33.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo cepat berangkat.
Dialogue: 0,0:21:35.52,0:21:37.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pegangan yang erat.
Dialogue: 0,0:21:40.40,0:21:43.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Noches.\NJangan-jangan kau...
Dialogue: 0,0:21:43.99,0:21:44.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah...
Dialogue: 0,0:21:44.98,0:21:48.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo menghukum muridku.
Dialogue: 0,0:21:48.75,0:21:51.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sirius, meluncur!
Dialogue: 0,0:21:54.33,0:21:57.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jelek banget tadi.
Dialogue: 0,0:21:58.46,0:22:00.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jatuhkan kamu, lo.
Dialogue: 0,0:22:05.43,0:22:10.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di pagi kau membuka matamu♪
Dialogue: 0,0:22:10.39,0:22:15.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagai cahaya yang menyinari♪
Dialogue: 0,0:22:15.90,0:22:24.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku biarkan gorden\Ndan jendela kamar terbuka sedikit♪
Dialogue: 0,0:22:24.99,0:22:30.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari-hari yang polos itu\Nbegitu menyilaukan♪
Dialogue: 0,0:22:30.91,0:22:35.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kepolosan yang membuatku\Ntanpa sadar memalingkan pandangan♪
Dialogue: 0,0:22:35.04,0:22:40.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sembari menelusuri\Ningatan yang terjatuh♪
Dialogue: 0,0:22:40.42,0:22:46.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berlarian di pantai telanjang kaki♪
Dialogue: 0,0:22:46.51,0:22:51.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak tertahankan,\Ntak kuat kubendung lagi♪
Dialogue: 0,0:22:51.81,0:22:56.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menghubungkan masa kini\Nyang meluap-luap menuju hari esok♪
Dialogue: 0,0:22:56.94,0:23:05.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Janji kelingkingku denganmu\Ndalam mimpi♪
Dialogue: 0,0:23:07.41,0:23:12.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesedihan dan kegundahan,\Njuga cinta yang begitu menyakitkan♪
Dialogue: 0,0:23:12.70,0:23:22.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena rasa dalam hati ini\Nbukan cuma milikku seorang♪
Dialogue: 0,0:23:22.05,0:23:25.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menjaganya♪
Dialogue: 0,0:23:25.97,0:23:32.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai kau terbangun♪
