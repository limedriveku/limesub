Dialogue: 0,0:01:20.52,0:01:28.69,sign,,0000,0000,0000,,(The Detective Is Already Dead. Season 2)
Dialogue: 0,0:02:41.06,0:02:44.02,sign,,0000,0000,0000,,(Episode 3 - Pekerjaan Gampang\Nyang Cuma Memproduseri Idola)
Dialogue: 0,0:05:46.16,0:05:51.41,sign,,0000,0000,0000,,(Orang Tua Saikawa Yui Terlibat Penipuan\NKeuangan, Apa Dampaknya ke Dia?)
Dialogue: 0,0:05:57.92,0:06:00.05,sign,,0000,0000,0000,,(Orang Tua Saikawa Yui Terlibat Penipuan\NKeuangan, Apa Dampaknya ke Dia?)
Dialogue: 0,0:06:06.93,0:06:13.56,sign,,0000,0000,0000,,(Perfect Record - Saikawa Yui)
Dialogue: 0,0:13:26.54,0:13:27.83,sign,,0000,0000,0000,,(Saikawa Yui)
Dialogue: 0,0:13:27.83,0:13:29.54,sign,,0000,0000,0000,,(Aku dikhianati!\N#SaikawaYui #PenipuanKeuangan)
Dialogue: 0,0:16:30.76,0:16:31.76,sign,,0000,0000,0000,,(Memang Yui harusnya begini!)
Dialogue: 0,0:16:31.76,0:16:32.76,sign,,0000,0000,0000,,(Pasti berat, tapi aku mendukungmu, kok!)
Dialogue: 0,0:23:35.02,0:23:35.06,sign,,0000,0000,0000,,(Episode 4 - Hal yang Bisa Dilakukan Kita\Nyang Masih Hidup)
Dialogue: 0,0:00:03.77,0:00:05.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yui.
Dialogue: 0,0:00:11.07,0:00:14.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo lepas perbannya.
Dialogue: 0,0:00:14.18,0:00:15.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:00:21.37,0:00:23.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nih, coba lihat.
Dialogue: 0,0:00:24.83,0:00:29.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu dibuat khusus untuk Yui.
Dialogue: 0,0:00:30.13,0:00:32.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cantik!
Dialogue: 0,0:00:32.80,0:00:35.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bola mata itu cocok untuk Yui.
Dialogue: 0,0:00:35.42,0:00:39.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku harap Yui bisa bersinar\Ndi hadapan orang-orang
Dialogue: 0,0:00:39.14,0:00:43.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mengenakan gaun indah\Nseperti permata biru itu.
Dialogue: 0,0:00:43.36,0:00:44.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah...
Dialogue: 0,0:00:44.65,0:00:49.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi mewujudkan itu, kamu harus\Npergi ke luar dan mencari teman.
Dialogue: 0,0:00:50.65,0:00:54.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asal ada Ibu dan Ayah,\Nitu sudah cukup!
Dialogue: 0,0:00:54.95,0:00:56.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengar.
Dialogue: 0,0:00:57.07,0:01:00.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mata itu akan menyinari hidupmu.
Dialogue: 0,0:01:00.82,0:01:04.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu kamu pasti akan\Nmenemukan hal yang berharga.
Dialogue: 0,0:01:04.17,0:01:05.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi...
Dialogue: 0,0:01:05.88,0:01:10.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan melepaskan mata kirimu itu\Napa pun yang terjadi.
Dialogue: 0,0:01:11.30,0:01:22.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buket bunga yang\Ntak pernah layu di jantungku♪
Dialogue: 0,0:01:31.65,0:01:37.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, mungkin sudah terlambat,\Ntapi aku ingin tanya sesuatu♪
Dialogue: 0,0:01:37.95,0:01:44.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah kamu bahagia melewati\Nhari-hari yang kita habiskan bersama?♪
Dialogue: 0,0:01:44.08,0:01:50.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak pernah bermimpi tentang\Nmasa depan tanpa kehilangan apa-apa♪
Dialogue: 0,0:01:50.67,0:01:58.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bila bisa memelukmu sekali lagi\Nuntuk terakhir kali♪
Dialogue: 0,0:01:58.60,0:02:04.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma tidur sedikit lebih lama, kok♪
Dialogue: 0,0:02:04.19,0:02:10.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan berwajah begitu♪
Dialogue: 0,0:02:10.53,0:02:17.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama jantungku masih\Nberdetak dalam dirimu♪
Dialogue: 0,0:02:17.41,0:02:24.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pasti takkan pernah\Nmelupakan kesedihan itu♪
Dialogue: 0,0:02:24.54,0:02:27.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak terlihat apa-apa,\Ntapi tampak samar-samar♪
Dialogue: 0,0:02:27.75,0:02:31.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bak cahaya yang menyinari\Nlautan di malam hari♪
Dialogue: 0,0:02:31.01,0:02:38.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memandangi kelanjutan\Nmimpi putih itu di sampingmu♪
Dialogue: 0,0:02:44.30,0:02:46.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mencium bau wanita lain!
Dialogue: 0,0:02:46.52,0:02:50.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saikawa, jangan mengendus bau\Nkamar orang lain.
Dialogue: 0,0:02:50.60,0:02:53.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada bau mencurigakan dari arah sini.
Dialogue: 0,0:02:53.69,0:02:57.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Natsunagi tidur di situ.\NJangan ganggu.
Dialogue: 0,0:02:57.74,0:03:01.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Akhirnya Kimizuka jadi laki-laki?
Dialogue: 0,0:03:01.24,0:03:04.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bodoh, ya?\NAda banyak alasannya, tahu.
Dialogue: 0,0:03:05.16,0:03:06.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf lama.
Dialogue: 0,0:03:07.62,0:03:10.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, Saikawa, apa kau serius?
Dialogue: 0,0:03:11.16,0:03:12.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang tuamu
Dialogue: 0,0:03:12.99,0:03:16.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dituduh melakukan\Npenyelewengan keuangan.
Dialogue: 0,0:03:16.67,0:03:20.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, aku masih belum tahu\Nkebenarannya,
Dialogue: 0,0:03:20.30,0:03:23.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kemungkinan beritanya\Nakan tersiar besok.
Dialogue: 0,0:03:23.68,0:03:25.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu.
Dialogue: 0,0:03:25.18,0:03:28.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya kau kabur\Ntengah malam begini, ya.
Dialogue: 0,0:03:28.06,0:03:29.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:03:29.02,0:03:34.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku sedang mencari\Ntempat sembunyi sementara waktu.
Dialogue: 0,0:03:34.35,0:03:39.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah lebih baik minta\Nke Natsunagi soal itu?
Dialogue: 0,0:03:39.44,0:03:43.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti lebih nyaman\Nkalau sama-sama cewek.
Dialogue: 0,0:03:43.03,0:03:44.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:03:44.07,0:03:48.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku ingin Kimizuka\Njadi produser.
Dialogue: 0,0:03:48.29,0:03:50.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa jadi begitu?
Dialogue: 0,0:03:50.17,0:03:54.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengingat aku tidak bisa ke rumah\Ndan kantor sementara waktu,
Dialogue: 0,0:03:54.04,0:04:00.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mending aku minta Kimizuka saja\Nyang mengurus keperluanku sehari-hari.
Dialogue: 0,0:04:01.76,0:04:05.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kalau aku menjadi produser,
Dialogue: 0,0:04:05.14,0:04:08.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku harus berada\Ndi dekat Saikawa, 'kan?
Dialogue: 0,0:04:08.55,0:04:12.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keamanan rumah ini terlalu rendah\Nuntuk menyembunyikanmu.
Dialogue: 0,0:04:13.98,0:04:17.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, pakai saja rumahku.
Dialogue: 0,0:04:17.23,0:04:20.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keamanannya lebih ketat\Ndari apartemen menara pusat kota.
Dialogue: 0,0:04:20.49,0:04:21.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh!
Dialogue: 0,0:04:21.99,0:04:25.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti, kita mulai hidup seatap di situ!
Dialogue: 0,0:04:26.16,0:04:28.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hidup seatap...
Dialogue: 0,0:04:31.79,0:04:34.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini cuma tinggal bersama demi strategi.
Dialogue: 0,0:04:35.08,0:04:37.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah dengar ceritanya!
Dialogue: 0,0:04:37.52,0:04:38.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nagisa!
Dialogue: 0,0:04:38.92,0:04:40.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Natsunagi, kau ini...
Dialogue: 0,0:04:40.68,0:04:45.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, soalnya aku dengar kata seru\N"tinggal seatap"...
Dialogue: 0,0:04:45.66,0:04:48.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah tidak apa-apa?
Dialogue: 0,0:04:48.80,0:04:51.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, tidak apa-apa.
Dialogue: 0,0:04:52.64,0:04:54.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:04:54.39,0:04:58.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk sementara, persembunyian Noches\Nakan dijadikan markas melindungi Saikawa.
Dialogue: 0,0:04:58.98,0:05:00.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak keberatan, 'kan?
Dialogue: 0,0:05:00.49,0:05:05.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlepas dari Kimihiko yang seenaknya\Nmelanjutkan pembicaraan padahal itu rumahku,
Dialogue: 0,0:05:05.53,0:05:06.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tidak keberatan.
Dialogue: 0,0:05:06.74,0:05:09.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlepas dari Kimizuka\Nyang lebih menonjol
Dialogue: 0,0:05:09.45,0:05:12.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebagai tokoh utama,\Npadahal aku detektifnya,
Dialogue: 0,0:05:12.83,0:05:13.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tidak keberatan.
Dialogue: 0,0:05:13.75,0:05:17.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku bilang tidak takut\Ntinggal seatap dengan Kimizuka,
Dialogue: 0,0:05:17.71,0:05:19.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}nanti jadi bohong.
Dialogue: 0,0:05:19.55,0:05:20.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menahannya!
Dialogue: 0,0:05:21.84,0:05:25.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sip, semuanya sepakat.
Dialogue: 0,0:05:27.77,0:05:30.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon maaf.
Dialogue: 0,0:05:30.27,0:05:32.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengenai itu...
Dialogue: 0,0:05:32.10,0:05:33.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:05:33.23,0:05:36.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami belum bisa\Nmemberikan jawaban resmi...
Dialogue: 0,0:05:36.51,0:05:39.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik. Terima kasih.
Dialogue: 0,0:05:40.48,0:05:42.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja itu jahat.
Dialogue: 0,0:05:45.48,0:05:48.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, selanjutnya bagaimana kabar
Dialogue: 0,0:05:48.32,0:05:51.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tentang Saikawa Yui\Nyang beraktivitas sebagai idola?
Dialogue: 0,0:05:51.91,0:05:53.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski ini masalah orang tuanya,
Dialogue: 0,0:05:53.83,0:05:57.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saikawa Yui sebagai putrinya\Nmasih aktif di industri hiburan.
Dialogue: 0,0:05:58.19,0:06:00.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa dibilang tak berkaitan.
Dialogue: 0,0:06:00.04,0:06:04.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peringkat album mingguan terbaru!
Dialogue: 0,0:06:04.46,0:06:06.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peringkat satu...
Dialogue: 0,0:06:07.63,0:06:11.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Perfect Record" dari Saikawa Yui!
Dialogue: 0,0:06:11.01,0:06:13.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat!
Dialogue: 0,0:06:13.72,0:06:15.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luar biasa!
Dialogue: 0,0:06:15.89,0:06:20.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyanyian Saikawa Yui selalu menyemangati\Norang-orang yang mendengarnya.
Dialogue: 0,0:06:21.23,0:06:26.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Album kali ini menjadi karya\Nyang sangat istimewa, bukan?
Dialogue: 0,0:06:26.73,0:06:31.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, ada tur konser merayakan\Nperingatan perilisan album...
Dialogue: 0,0:06:31.70,0:06:35.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tak bisa memalingkan\Npandangan dari sepak terjangnya!
Dialogue: 0,0:06:35.58,0:06:39.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya akan kami sampaikan\Ninformasi penting di luar peringkat.
Dialogue: 0,0:06:37.37,0:06:39.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bangunkan mereka dulu, deh.
Dialogue: 0,0:06:43.09,0:06:44.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oi!
Dialogue: 0,0:06:44.71,0:06:46.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo cepat bangun.
Dialogue: 0,0:06:51.47,0:06:53.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manisnya...
Dialogue: 0,0:06:53.08,0:06:55.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duh, bukan itu!
Dialogue: 0,0:06:55.42,0:06:58.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo bangun, aku buatkan sarapan.
Dialogue: 0,0:07:03.19,0:07:06.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sosis... Kimizuka...
Dialogue: 0,0:07:14.07,0:07:15.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Char.
Dialogue: 0,0:07:15.32,0:07:17.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak kapan kau di sini?
Dialogue: 0,0:07:17.12,0:07:20.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}E-Enggak begitu!\NKamu salah paham!
Dialogue: 0,0:07:20.12,0:07:24.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma mencium bantal ini\Nkarena ada bau Nona!
Dialogue: 0,0:07:24.80,0:07:28.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa pernyataan itu cukup bermasalah.
Dialogue: 0,0:07:29.38,0:07:31.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sudah begini...
Dialogue: 0,0:07:31.51,0:07:35.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus merenggut\Ningatan Kimizuka!
Dialogue: 0,0:07:35.52,0:07:38.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhenti, Char! Tenang!
Dialogue: 0,0:07:36.30,0:07:38.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan melawan!
Dialogue: 0,0:07:39.40,0:07:42.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian berdua sedang apa?
Dialogue: 0,0:07:44.48,0:07:46.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, ini yang namanya\Npasangan bertengkar?
Dialogue: 0,0:07:46.90,0:07:48.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Bukan!\N- Bukan!
Dialogue: 0,0:07:49.57,0:07:52.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bunuh kalian!
Dialogue: 0,0:07:52.58,0:07:56.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kamu salah paham, Nagisa!\NCuma keenakan!
Dialogue: 0,0:07:56.83,0:07:58.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan itu, kecelakaan!
Dialogue: 0,0:08:03.46,0:08:04.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelihatan.
Dialogue: 0,0:08:05.12,0:08:09.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, apa tidak apa-apa\Ndikerjakan mereka berdua?
Dialogue: 0,0:08:09.42,0:08:11.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau bagaimana lagi?
Dialogue: 0,0:08:11.26,0:08:13.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah kenapa mereka semangat begitu.
Dialogue: 0,0:08:14.93,0:08:17.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang Nagisa bisa masak?
Dialogue: 0,0:08:18.64,0:08:22.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Char... Aku tidak akan kalah darimu!
Dialogue: 0,0:08:23.02,0:08:25.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ngomong doang gampang.
Dialogue: 0,0:08:23.02,0:08:27.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nagisa dan Char masih saja\Ntidak akur, ya.
Dialogue: 0,0:08:26.19,0:08:27.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat saja!
Dialogue: 0,0:08:27.57,0:08:31.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Mana coba?\N- Masakanku pasti enak!
Dialogue: 0,0:08:27.57,0:08:32.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, daripada canggung terus,\Nmending begini.
Dialogue: 0,0:08:32.37,0:08:34.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, kalian mau buat apa?
Dialogue: 0,0:08:38.41,0:08:41.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lobster biru Bretagne tumis.
Dialogue: 0,0:08:41.33,0:08:44.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Disajikan dengan sayur musiman\Ndan saus mousseline, kurasa?
Dialogue: 0,0:08:44.63,0:08:46.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok bisa tahu menu begituan?
Dialogue: 0,0:08:46.51,0:08:49.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu sambil kelaparan, ya.
Dialogue: 0,0:08:50.79,0:08:51.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aneh.
Dialogue: 0,0:08:51.84,0:08:55.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu karena kamu langsung\Nbuat masakan rumit.
Dialogue: 0,0:08:55.59,0:08:57.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa boleh buat, deh.
Dialogue: 0,0:08:57.60,0:09:01.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku buatkan nasi goreng.\NTunggu saja.
Dialogue: 0,0:09:02.14,0:09:03.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aneh.
Dialogue: 0,0:09:03.81,0:09:07.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi walau tampilannya aneh,\Nbisa jadi rasanya enak begitu dimakan.
Dialogue: 0,0:09:07.27,0:09:09.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makan saja sendiri kalau yakin.
Dialogue: 0,0:09:09.97,0:09:12.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar, apa boleh buat.
Dialogue: 0,0:09:12.70,0:09:14.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar aku yang masak.
Dialogue: 0,0:09:14.65,0:09:17.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau menyiapkan stok sekalian,\Njadi masak kari saja.
Dialogue: 0,0:09:18.28,0:09:20.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nagisa, tolong potong dagingnya.
Dialogue: 0,0:09:20.49,0:09:21.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya...
Dialogue: 0,0:09:21.71,0:09:25.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Char, tolong hangatkan lagi nasinya.
Dialogue: 0,0:09:25.00,0:09:26.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya...
Dialogue: 0,0:09:26.73,0:09:32.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah kenapa selalu saja\NSaikawa yang bisa diandalkan.
Dialogue: 0,0:09:33.25,0:09:37.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena aku sudah melewati\Nmasa-masa sulit selama ini.
Dialogue: 0,0:09:38.30,0:09:39.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi...
Dialogue: 0,0:09:40.01,0:09:42.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari keterampilan mengurus\Nrumah dan usia,
Dialogue: 0,0:09:42.60,0:09:45.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku unggul dua langkah.
Dialogue: 0,0:09:47.60,0:09:50.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yui.
Dialogue: 0,0:09:50.44,0:09:54.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ki-Kimizuka, kakak-kakak ini seram!
Dialogue: 0,0:09:54.78,0:09:56.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau yang salah tadi.
Dialogue: 0,0:09:57.65,0:09:59.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berangkat.
Dialogue: 0,0:09:59.40,0:10:01.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hati-hati, Yui.
Dialogue: 0,0:10:08.37,0:10:10.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa Nagisa baik-baik saja?
Dialogue: 0,0:10:11.17,0:10:13.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudmu soal Koumori\Nyang kabur dari penjara?
Dialogue: 0,0:10:13.51,0:10:16.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada Char, jadi tidak apa-apa.
Dialogue: 0,0:10:16.45,0:10:20.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daripada keluar, lebih aman\Nkalau mereka di sana.
Dialogue: 0,0:10:20.72,0:10:25.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si Koumori sedang\Nditangani Noches, 'kan?
Dialogue: 0,0:10:25.56,0:10:27.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, seharusnya begitu.
Dialogue: 0,0:10:28.00,0:10:30.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Serahkan saja ini padaku.
Dialogue: 0,0:10:30.52,0:10:35.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kimihiko cukup awasi saja\NSaikawa Yui mengambil keputusan."
Dialogue: 0,0:10:35.15,0:10:36.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu kata dia.
Dialogue: 0,0:10:36.49,0:10:38.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengawasiku...
Dialogue: 0,0:10:38.57,0:10:40.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu cocok sekali untuk Kimizuka,
Dialogue: 0,0:10:40.62,0:10:44.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tipe otaku berlagak jadi pacar yang\Nmenyilangkan tangan melihat dari belakang?
Dialogue: 0,0:10:44.26,0:10:45.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saikawa.
Dialogue: 0,0:10:45.79,0:10:49.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau berpikir bakal aku maafkan\Nmau bicara apa pun, ya?
Dialogue: 0,0:10:49.50,0:10:51.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, betul.
Dialogue: 0,0:10:51.60,0:10:54.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena aku percaya
Dialogue: 0,0:10:54.55,0:10:58.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kimizuka akan memihakku\Napa pun yang terjadi.
Dialogue: 0,0:11:00.72,0:11:02.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong...
Dialogue: 0,0:11:02.01,0:11:05.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini buah tangan atau semacamnya\Nuntuk sesama pemeran?
Dialogue: 0,0:11:05.50,0:11:07.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, bukan.
Dialogue: 0,0:11:07.60,0:11:11.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau mampir ke suatu tempat\Nsebelum syuting.
Dialogue: 0,0:11:19.07,0:11:21.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah sampai. Di sini.
Dialogue: 0,0:11:21.79,0:11:26.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah dan ibuku tidur di sini.
Dialogue: 0,0:11:41.84,0:11:46.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin mereka berdua lega karena\Naku sudah menemukan pendamping hidup.
Dialogue: 0,0:11:47.06,0:11:48.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang benar saja.
Dialogue: 0,0:11:48.27,0:11:51.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kembali ke suasana bercanda lagi?
Dialogue: 0,0:11:52.93,0:11:57.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku masih merasa\Nsedang bermimpi.
Dialogue: 0,0:11:57.57,0:11:58.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mimpi?
Dialogue: 0,0:11:58.78,0:12:00.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana, ya...
Dialogue: 0,0:12:00.49,0:12:03.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti semuanya\Ncuma prank besar-besaran.
Dialogue: 0,0:12:03.82,0:12:08.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, mereka akan keluar\Nuntuk mengagetkanku.
Dialogue: 0,0:12:08.58,0:12:12.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada akhirnya, aku cemas kalau sendirian.
Dialogue: 0,0:12:12.59,0:12:16.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku selalu ingin diperhatikan seseorang.
Dialogue: 0,0:12:19.80,0:12:22.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya kau jadi idola?
Dialogue: 0,0:12:22.38,0:12:24.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin saja.
Dialogue: 0,0:12:24.80,0:12:28.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi Ayah pernah bilang.
Dialogue: 0,0:12:29.18,0:12:33.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia ingin aku mengenakan gaun indah.
Dialogue: 0,0:12:33.69,0:12:36.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersinar di hadapan orang-orang.
Dialogue: 0,0:12:36.31,0:12:39.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu juga menyuruhku pergi ke dunia luar.
Dialogue: 0,0:12:39.94,0:12:41.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya aku...
Dialogue: 0,0:12:42.82,0:12:48.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku tidak bisa jadi idola selamanya.
Dialogue: 0,0:12:48.16,0:12:52.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa saja krisis dunia\Nsudah di depan mata.
Dialogue: 0,0:12:53.95,0:12:55.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu...
Dialogue: 0,0:12:56.46,0:13:01.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terkadang, aku merasa capek.
Dialogue: 0,0:13:10.35,0:13:12.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alam memang bagus.
Dialogue: 0,0:13:12.98,0:13:14.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo pergi sekarang.
Dialogue: 0,0:13:16.35,0:13:18.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Saikawa.
Dialogue: 0,0:13:18.18,0:13:19.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah cukup.
Dialogue: 0,0:13:20.15,0:13:22.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kembalikan!
Dialogue: 0,0:13:22.44,0:13:25.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa jahat begitu?
Dialogue: 0,0:13:25.24,0:13:26.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu karena
Dialogue: 0,0:13:26.90,0:13:29.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau selalu memandangi ini.
Dialogue: 0,0:13:29.54,0:13:30.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}(Gara-gara orang tuanya, Saikawa Yui\Npasti wisuda dari idola wkwkwk
Dialogue: 0,0:13:32.24,0:13:35.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak masalah kalau cuma\Naku yang dijelek-jelekkan.
Dialogue: 0,0:13:35.91,0:13:37.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:13:37.71,0:13:41.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penghinaan terhadap Ayah dan Ibu...
Dialogue: 0,0:13:41.05,0:13:42.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak akan kubiarkan.
Dialogue: 0,0:13:49.05,0:13:50.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kimizuka!
Dialogue: 0,0:13:55.56,0:13:59.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Persetan!
Dialogue: 0,0:13:59.02,0:14:00.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ki-Kimizuka?!
Dialogue: 0,0:14:00.98,0:14:05.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang sekali\Nkamu marah menggantikanku,
Dialogue: 0,0:14:05.61,0:14:07.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku jadi malu...
Dialogue: 0,0:14:07.53,0:14:10.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sok keren\Nlalu pergi sendirian!
Dialogue: 0,0:14:10.50,0:14:14.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siesta tolol!
Dialogue: 0,0:14:14.17,0:14:16.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Te-Ternyata itu...
Dialogue: 0,0:14:16.69,0:14:18.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yuk, Saikawa.
Dialogue: 0,0:14:18.67,0:14:21.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luapkan semua isi pikiranmu.
Dialogue: 0,0:14:22.63,0:14:26.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang idola boleh\Nmengucapkan kata-kata kotor?
Dialogue: 0,0:14:27.43,0:14:30.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang belum jamnya jadi idola, 'kan?
Dialogue: 0,0:14:42.99,0:14:45.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bodoh!
Dialogue: 0,0:14:46.11,0:14:48.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang-orang tidak tahu apa-apa!
Dialogue: 0,0:14:48.49,0:14:50.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bangsat-bangsat.
Dialogue: 0,0:14:50.82,0:14:52.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bangsat-bangsat...
Dialogue: 0,0:14:52.45,0:14:55.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah dan Ibu yang kucintai...
Dialogue: 0,0:14:57.67,0:15:01.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan menghina mereka!
Dialogue: 0,0:15:07.88,0:15:10.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa mereka berdua dengar juga?
Dialogue: 0,0:15:10.97,0:15:12.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:15:12.51,0:15:16.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teriakan bagus sampai terdengar\Nke menara pemancar.
Dialogue: 0,0:15:16.97,0:15:19.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terdengar penggemarku juga.
Dialogue: 0,0:15:22.44,0:15:26.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sampai viral,\Ntolong bantu klarifikasi, ya.
Dialogue: 0,0:15:27.27,0:15:29.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Produser.
Dialogue: 0,0:15:36.74,0:15:39.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yui, terima kasih!
Dialogue: 0,0:15:39.46,0:15:42.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Idola banget, ya.
Dialogue: 0,0:15:42.45,0:15:44.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan idola biasa.
Dialogue: 0,0:15:45.17,0:15:49.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku idola terimut sedunia,\NSaikawa Yui!
Dialogue: 0,0:15:49.84,0:15:51.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ceria sekali!
Dialogue: 0,0:15:51.89,0:15:55.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi pasti berat, 'kan?
Dialogue: 0,0:15:56.60,0:16:00.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf terjadi kegaduhan\Nkarena orang tuaku.
Dialogue: 0,0:16:00.56,0:16:03.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku tetaplah aku.
Dialogue: 0,0:16:03.06,0:16:07.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku ingin kalian cuma\Nmelihatku saja di momen ini.
Dialogue: 0,0:16:07.74,0:16:09.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi tetap saja...
Dialogue: 0,0:16:09.99,0:16:13.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin cuma bualan cantik, tapi...
Dialogue: 0,0:16:13.32,0:16:16.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu, aku akan terus membual.
Dialogue: 0,0:16:17.32,0:16:18.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena
Dialogue: 0,0:16:20.12,0:16:25.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}idola harus selalu tampil cantik, 'kan?
Dialogue: 0,0:16:30.76,0:16:32.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat.
Dialogue: 0,0:16:32.76,0:16:35.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti kata Noches,
Dialogue: 0,0:16:35.00,0:16:38.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ujung-ujungnya aku cuma mengawasi.
Dialogue: 0,0:16:38.02,0:16:40.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi lama juga.
Dialogue: 0,0:16:45.56,0:16:47.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang benar saja.
Dialogue: 0,0:16:47.40,0:16:49.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak tahan beginian.
Dialogue: 0,0:16:50.36,0:16:53.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada umpan jatuh\Ndi tempat yang pas, ya.
Dialogue: 0,0:17:01.79,0:17:03.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa kau?
Dialogue: 0,0:17:07.00,0:17:09.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, manusia?
Dialogue: 0,0:17:10.54,0:17:14.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum pernah melihat vampir?
Dialogue: 0,0:17:17.72,0:17:20.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah bangun, manusia?
Dialogue: 0,0:17:23.48,0:17:28.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa menatapi darahmu\Nsendiri seserius itu?
Dialogue: 0,0:17:28.51,0:17:30.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa kau?
Dialogue: 0,0:17:32.61,0:17:34.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Scarlet.
Dialogue: 0,0:17:34.66,0:17:38.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa lalu, masa kini, masa depan,\Nselama-lamanya.
Dialogue: 0,0:17:38.45,0:17:40.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu namaku.
Dialogue: 0,0:17:40.71,0:17:43.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Raja yang menyatukan seluruh malam\Ndan menguasai rakyat jelata hina.
Dialogue: 0,0:17:45.13,0:17:48.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan kaku begitu, manusia.
Dialogue: 0,0:17:48.30,0:17:49.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak usah khawatir.
Dialogue: 0,0:17:49.88,0:17:52.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan mengisap darahmu lagi.
Dialogue: 0,0:17:52.22,0:17:56.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, aku cuma tertarik\Npada hal yang indah.
Dialogue: 0,0:17:56.52,0:17:59.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu kenapa kau mengisap darahku?
Dialogue: 0,0:17:59.19,0:18:03.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, aku lupa makan 2 minggu.
Dialogue: 0,0:18:03.77,0:18:07.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak ada kau di sana,\Naku pasti sudah mati kelaparan.
Dialogue: 0,0:18:07.57,0:18:09.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oi, tunggu, kampret.
Dialogue: 0,0:18:09.11,0:18:12.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitukah sikapmu ke orang\Nyang menyelamatkan nyawamu?
Dialogue: 0,0:18:13.78,0:18:15.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Scarlet.
Dialogue: 0,0:18:15.95,0:18:18.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau Penjaga, 'kan?
Dialogue: 0,0:18:19.91,0:18:22.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, kau tahu?
Dialogue: 0,0:18:22.08,0:18:26.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar Hakuchumu tidak\Nmemberitahumu soal itu.
Dialogue: 0,0:18:27.12,0:18:28.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hakuchumu?
Dialogue: 0,0:18:28.80,0:18:31.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa hubunganmu dengan Siesta?
Dialogue: 0,0:18:32.09,0:18:33.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja.
Dialogue: 0,0:18:33.55,0:18:38.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hubunganku dengan wanita itu\Ntidak seperti yang kau sangka.
Dialogue: 0,0:18:38.30,0:18:41.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang, aku cuma dapat\Nsebuah permintaan.
Dialogue: 0,0:18:41.35,0:18:42.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permintaan?
Dialogue: 0,0:18:42.35,0:18:45.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, dalam kasusku, ini kontrak.
Dialogue: 0,0:18:45.56,0:18:48.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai ganti mengabulkan harapanku,
Dialogue: 0,0:18:48.03,0:18:51.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku membayar harga yang sepadan.
Dialogue: 0,0:18:51.36,0:18:54.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama kau bisa memuaskanku,
Dialogue: 0,0:18:54.57,0:18:57.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan membantumu\Nmeski dunia jadi musuhmu.
Dialogue: 0,0:18:57.87,0:19:03.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti, orang yang menawarkan kontrak itu\Npunya urusan denganku?
Dialogue: 0,0:19:03.21,0:19:04.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedikit keliru.
Dialogue: 0,0:19:04.87,0:19:07.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan ada perlu denganmu.
Dialogue: 0,0:19:07.38,0:19:08.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan aku?
Dialogue: 0,0:19:09.17,0:19:10.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saikawa, ya?
Dialogue: 0,0:19:10.83,0:19:12.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maumu dengan Saikawa?
Dialogue: 0,0:19:12.62,0:19:14.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa yang membuat kontrak itu?!
Dialogue: 0,0:19:14.76,0:19:17.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bicara soal orang yang\Nmengabdi pada vampir,
Dialogue: 0,0:19:17.47,0:19:20.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menurutku cuma\Nada satu kemungkinan.
Dialogue: 0,0:19:21.10,0:19:22.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Koumori!
Dialogue: 0,0:19:23.60,0:19:25.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bertemu lagi, Watson.
Dialogue: 0,0:19:26.52,0:19:28.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kimizuka!
Dialogue: 0,0:19:30.48,0:19:34.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya Noches yang mengurusmu.
Dialogue: 0,0:19:34.74,0:19:37.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lepaskan Saikawa, Koumori.
Dialogue: 0,0:19:38.57,0:19:40.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Produser yang berbahaya.
Dialogue: 0,0:19:40.99,0:19:42.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biarlah.
Dialogue: 0,0:19:42.49,0:19:45.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berat juga kalau aku bawa terus begini.
Dialogue: 0,0:19:45.25,0:19:47.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kimizuka!
Dialogue: 0,0:19:47.33,0:19:48.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak apa-apa?
Dialogue: 0,0:19:48.42,0:19:50.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bilang aku berat!
Dialogue: 0,0:19:50.17,0:19:52.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat tembak orang itu sekarang!
Dialogue: 0,0:19:52.55,0:19:54.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, kau baik-baik saja.
Dialogue: 0,0:19:54.84,0:19:58.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Koumori, kenapa kau bersama Scarlet?
Dialogue: 0,0:19:58.72,0:20:01.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya kau bekerja sama dengan Seed?
Dialogue: 0,0:20:01.27,0:20:04.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oi, oi, tanyanya satu-satu.
Dialogue: 0,0:20:04.77,0:20:08.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Koumori, tolong kau yang jelaskan.
Dialogue: 0,0:20:08.15,0:20:10.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya aku baru bangun.
Dialogue: 0,0:20:10.27,0:20:12.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kimizuka, apa itu tadi?
Dialogue: 0,0:20:12.69,0:20:15.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia vampir.
Dialogue: 0,0:20:15.03,0:20:18.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa hubunganmu dengan Scarlet?
Dialogue: 0,0:20:18.95,0:20:24.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awalnya, Seed meminta Scarlet\Nuntuk membawaku kembali.
Dialogue: 0,0:20:25.25,0:20:28.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya SPES kekurangan orang\Nsampai-sampai mengandalkanku,
Dialogue: 0,0:20:28.67,0:20:32.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}padahal sempat berpisah jalan.
Dialogue: 0,0:20:32.04,0:20:35.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku tidak minat kembali ke SPES.
Dialogue: 0,0:20:35.38,0:20:39.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaliknya, kepentinganku sama\Ndengan Scarlet karena suatu alasan,
Dialogue: 0,0:20:39.59,0:20:42.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadinya kami bekerja sama.
Dialogue: 0,0:20:42.72,0:20:46.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu kenapa kau melakukan\Nkontak denganku dan Saikawa?
Dialogue: 0,0:20:46.06,0:20:49.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma datang merekrutmu.
Dialogue: 0,0:20:49.48,0:20:51.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maukah jadi rekan kami?
Dialogue: 0,0:20:51.82,0:20:52.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:20:52.73,0:20:54.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Simpel saja.
Dialogue: 0,0:20:54.57,0:20:57.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudku, maukah kau\Nmengalahkan Seed bersama kami?
Dialogue: 0,0:20:57.66,0:21:01.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama SPES masih ada,\Naku tidak bisa bebas.
Dialogue: 0,0:21:01.70,0:21:06.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kepentingan kita menghancurkan\NSPES harusnya sama.
Dialogue: 0,0:21:06.58,0:21:09.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, sama dengan\Nputri Sapphire,
Dialogue: 0,0:21:09.58,0:21:12.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku yang memiliki benih\Nwalau masih seorang manusia,
Dialogue: 0,0:21:12.92,0:21:17.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku bisa meningkatkan lagi\Nkekuatan mata kirimu itu.
Dialogue: 0,0:21:18.34,0:21:20.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, Saikawa Yui.
Dialogue: 0,0:21:20.09,0:21:22.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ikutlah bersamaku.
Dialogue: 0,0:21:23.34,0:21:26.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pikir aku bakal menyerahkan\NSaikawa padamu begitu saja?
Dialogue: 0,0:21:26.85,0:21:32.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu, Watson dan nona muda yang baru\Nmenjadi detektif juga boleh ikut.
Dialogue: 0,0:21:32.63,0:21:35.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya, aku butuh tenaga sekarang.
Dialogue: 0,0:21:35.51,0:21:39.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, ini juga demi\NSaikawa Yui sendiri.
Dialogue: 0,0:21:40.40,0:21:44.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam setahun ini, Seed yang tidak\Nmelakukan pergerakan mencolok,
Dialogue: 0,0:21:44.62,0:21:47.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mengapa mengambil langkah berikutnya?
Dialogue: 0,0:21:48.04,0:21:50.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pernah memikirkan itu?
Dialogue: 0,0:21:51.33,0:21:53.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada alasan khusus?
Dialogue: 0,0:21:55.04,0:21:58.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mengincar wadah baru.
Dialogue: 0,0:21:59.59,0:22:03.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wadah bernama Saikawa Yui.
Dialogue: 0,0:22:05.43,0:22:10.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di pagi kau membuka matamu♪
Dialogue: 0,0:22:10.39,0:22:15.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagai cahaya yang menyinari♪
Dialogue: 0,0:22:15.90,0:22:24.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku biarkan gorden\Ndan jendela kamar terbuka sedikit♪
Dialogue: 0,0:22:24.99,0:22:30.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari-hari yang polos itu\Nbegitu menyilaukan♪
Dialogue: 0,0:22:30.91,0:22:35.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kepolosan yang membuatku\Ntanpa sadar memalingkan pandangan♪
Dialogue: 0,0:22:35.04,0:22:40.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sembari menelusuri\Ningatan yang terjatuh♪
Dialogue: 0,0:22:40.42,0:22:46.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berlarian di pantai telanjang kaki♪
Dialogue: 0,0:22:46.51,0:22:51.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak tertahankan,\Ntak kuat kubendung lagi♪
Dialogue: 0,0:22:51.81,0:22:56.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menghubungkan masa kini\Nyang meluap-luap menuju hari esok♪
Dialogue: 0,0:22:56.94,0:23:05.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Janji kelingkingku denganmu\Ndalam mimpi♪
Dialogue: 0,0:23:07.41,0:23:12.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesedihan dan kegundahan,\Njuga cinta yang begitu menyakitkan♪
Dialogue: 0,0:23:12.70,0:23:22.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena rasa dalam hati ini\Nbukan cuma milikku seorang♪
Dialogue: 0,0:23:22.05,0:23:25.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menjaganya♪
Dialogue: 0,0:23:25.97,0:23:32.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai kau terbangun♪
