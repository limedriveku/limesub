Dialogue: 0,0:02:04.56,0:02:12.74,sign,,0000,0000,0000,,(The Detective Is Already Dead. Season 2)
Dialogue: 0,0:03:25.02,0:03:27.31,sign,,0000,0000,0000,,(Episode 2 - Cerita Hari Itu\Nyang Tidak Diketahui Siapa pun)
Dialogue: 0,0:23:34.98,0:23:39.98,sign,,0000,0000,0000,,(Episode 3 - Pekerjaan Gampang\Nyang Cuma Memproduseri Idola)
Dialogue: 0,0:00:01.39,0:00:04.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lama tidak bertemu, Nona.
Dialogue: 0,0:00:05.82,0:00:07.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu...
Dialogue: 0,0:00:07.78,0:00:09.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diriku yang lain?
Dialogue: 0,0:00:11.15,0:00:13.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajah-wajah yang buatku rindu.
Dialogue: 0,0:00:13.99,0:00:15.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi...
Dialogue: 0,0:00:15.31,0:00:19.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada perlu apa memanggilku\Nsetelah satu tahun?
Dialogue: 0,0:00:19.58,0:00:23.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang ingin kami tanyakan\Npadamu tentang Siesta.
Dialogue: 0,0:00:23.83,0:00:26.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di antara kejadian setahun lalu,
Dialogue: 0,0:00:26.29,0:00:28.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kesalahan apa yang dilakukan Siesta.
Dialogue: 0,0:00:28.71,0:00:29.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak tahu.
Dialogue: 0,0:00:30.97,0:00:32.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama setahun ini,
Dialogue: 0,0:00:32.55,0:00:35.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tidak bisa keluar ke dunia luar\Nkarena Detektif Hebat itu.
Dialogue: 0,0:00:35.68,0:00:38.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sampai naik pitam.
Dialogue: 0,0:00:38.51,0:00:42.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sebutkan nama itu lagi\Ndi hadapanku.
Dialogue: 0,0:00:43.19,0:00:44.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:00:44.90,0:00:48.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai gantinya,\Ntolong beri tahu aku tentangmu.
Dialogue: 0,0:00:51.11,0:00:55.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah menjelaskan tentang diriku\Ndi pertarungan setahun yang lalu.
Dialogue: 0,0:00:55.81,0:00:57.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada yang bisa kuceritakan lagi...
Dialogue: 0,0:00:57.66,0:00:58.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:00:58.91,0:01:02.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan misi atau arti bertarung...
Dialogue: 0,0:01:02.81,0:01:06.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan itu yang kumaksud.
Dialogue: 0,0:01:06.42,0:01:10.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misalnya, rasa teh yang kamu sukai.
Dialogue: 0,0:01:10.13,0:01:12.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu mendengar musik populer?
Dialogue: 0,0:01:12.76,0:01:15.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu orang yang mandinya lama?
Dialogue: 0,0:01:15.76,0:01:19.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong beri tahu aku sisimu itu.
Dialogue: 0,0:01:23.68,0:01:25.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya
Dialogue: 0,0:01:25.44,0:01:28.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona sendiri yang paling tahu itu.
Dialogue: 0,0:01:30.15,0:01:33.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang melahirkanku adalah Nona sendiri.
Dialogue: 0,0:01:33.86,0:01:37.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daripada bertanya padaku,\Nlebih baik selami ingatanmu sendiri.
Dialogue: 0,0:01:37.58,0:01:38.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:01:38.66,0:01:41.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Natsunagi tidak bisa\Nmengingatnya saat ini.
Dialogue: 0,0:01:41.50,0:01:42.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:01:43.08,0:01:44.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kubantu.
Dialogue: 0,0:01:46.67,0:01:50.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, ayo ceritakan menggantikanku.
Dialogue: 0,0:01:50.75,0:01:53.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cerita Nona sendiri.
Dialogue: 0,0:01:55.34,0:02:06.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buket bunga yang\Ntak pernah layu di jantungku♪
Dialogue: 0,0:02:15.70,0:02:22.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, mungkin sudah terlambat,\Ntapi aku ingin tanya sesuatu♪
Dialogue: 0,0:02:22.00,0:02:28.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah kamu bahagia melewati\Nhari-hari yang kita habiskan bersama?♪
Dialogue: 0,0:02:28.13,0:02:34.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak pernah bermimpi tentang\Nmasa depan tanpa kehilangan apa-apa♪
Dialogue: 0,0:02:34.97,0:02:42.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bila bisa memelukmu sekali lagi\Nuntuk terakhir kali♪
Dialogue: 0,0:02:42.64,0:02:48.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma tidur sedikit lebih lama, kok♪
Dialogue: 0,0:02:48.23,0:02:54.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan berwajah begitu♪
Dialogue: 0,0:02:54.57,0:03:01.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama jantungku masih\Nberdetak dalam dirimu♪
Dialogue: 0,0:03:01.45,0:03:08.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pasti takkan pernah\Nmelupakan kesedihan itu♪
Dialogue: 0,0:03:08.57,0:03:11.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak terlihat apa-apa,\Ntapi tampak samar-samar♪
Dialogue: 0,0:03:11.80,0:03:15.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bak cahaya yang menyinari\Nlautan di malam hari♪
Dialogue: 0,0:03:15.05,0:03:22.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memandangi kelanjutan\Nmimpi putih itu di sampingmu♪
Dialogue: 0,0:03:35.86,0:03:38.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Punggungku sakit.
Dialogue: 0,0:03:39.66,0:03:41.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oi, sini!
Dialogue: 0,0:03:41.53,0:03:43.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu!
Dialogue: 0,0:03:47.04,0:03:48.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enaknya.
Dialogue: 0,0:04:01.05,0:04:04.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ada pangeran\Nyang mau menjemputku?
Dialogue: 0,0:04:04.77,0:04:09.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku yang bukan pangeran\Nmending pergi saja?
Dialogue: 0,0:04:10.40,0:04:11.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada perlu apa?
Dialogue: 0,0:04:12.22,0:04:13.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siesta.
Dialogue: 0,0:04:14.11,0:04:17.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal temanmu datang\Nmenemanimu bermain.
Dialogue: 0,0:04:17.44,0:04:19.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu dingin banget, Nagisa.
Dialogue: 0,0:04:21.03,0:04:21.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo?
Dialogue: 0,0:04:21.87,0:04:24.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok wajahmu kotor?
Dialogue: 0,0:04:25.74,0:04:29.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tadi membuat bom,\Nterus gagal, makanya kotor.
Dialogue: 0,0:04:29.08,0:04:32.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bicara seolah-olah\Nkamu lagi membuat bola lumpur.
Dialogue: 0,0:04:32.63,0:04:35.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak boleh buat bom!
Dialogue: 0,0:04:35.58,0:04:39.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alicia duluan yang mengajakku\Nmembuat bom.
Dialogue: 0,0:04:41.01,0:04:43.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang, panggil aku Achan!
Dialogue: 0,0:04:43.76,0:04:45.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alicia!
Dialogue: 0,0:04:45.51,0:04:47.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu ikutan datang?
Dialogue: 0,0:04:48.27,0:04:49.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Reaksi apa itu?
Dialogue: 0,0:04:49.94,0:04:51.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nachan jahat!
Dialogue: 0,0:04:51.06,0:04:52.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Panggil aku Achan!
Dialogue: 0,0:04:52.94,0:04:54.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, iya.
Dialogue: 0,0:04:54.15,0:04:57.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar. Kita trio besti, 'kan?
Dialogue: 0,0:04:58.23,0:05:00.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, iya, Achan.
Dialogue: 0,0:05:03.20,0:05:04.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi.
Dialogue: 0,0:05:05.28,0:05:08.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo? Ada kalian juga, toh.
Dialogue: 0,0:05:08.62,0:05:11.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah bilang kalian\Ntidak boleh masuk kemari.
Dialogue: 0,0:05:13.41,0:05:15.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini. Hadiah.
Dialogue: 0,0:05:18.21,0:05:21.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari orang kaya yang biasanya lagi?
Dialogue: 0,0:05:21.05,0:05:24.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia juga punya putri yang seumuran.
Dialogue: 0,0:05:24.95,0:05:27.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami sering menerima sesuatu\Nbersamaan dengan sumbangan.
Dialogue: 0,0:05:27.39,0:05:29.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak salah, orang Jepang, ya?
Dialogue: 0,0:05:29.85,0:05:31.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin ke sana suatu saat nanti.
Dialogue: 0,0:05:32.31,0:05:33.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi...
Dialogue: 0,0:05:33.60,0:05:35.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada perlu apa?
Dialogue: 0,0:05:35.81,0:05:38.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu memang jeli, ya.
Dialogue: 0,0:05:38.77,0:05:42.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin minta bantuan kalian lagi.
Dialogue: 0,0:05:43.90,0:05:46.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, baiklah.
Dialogue: 0,0:05:46.66,0:05:48.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa boleh buat, deh.
Dialogue: 0,0:05:50.70,0:05:52.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ogah-ogahan banget.
Dialogue: 0,0:05:53.41,0:05:57.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi ini demi kalian juga.
Dialogue: 0,0:05:58.04,0:05:59.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong mengerti.
Dialogue: 0,0:05:59.65,0:06:00.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:06:03.21,0:06:04.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih kerja samanya.
Dialogue: 0,0:06:05.05,0:06:06.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}602.
Dialogue: 0,0:06:07.68,0:06:09.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salah.
Dialogue: 0,0:06:10.72,0:06:13.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namaku bukan 602.
Dialogue: 0,0:06:13.93,0:06:15.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nagisa.
Dialogue: 0,0:06:18.77,0:06:20.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:07:07.70,0:07:11.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiap kali menghela napas, peluangmu\Nmenikah bakal mundur setahun, lo.
Dialogue: 0,0:07:15.49,0:07:19.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, jangan teriak-teriak,\Nnanti aku ditangkap.
Dialogue: 0,0:07:19.25,0:07:23.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}O-Orang berbahaya kayak kamu\Nmending cepat tertangkap!
Dialogue: 0,0:07:25.50,0:07:26.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kesepian?
Dialogue: 0,0:07:27.13,0:07:28.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak!
Dialogue: 0,0:07:28.72,0:07:32.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang bisa sendirian\Nsetelah sekian lama.
Dialogue: 0,0:07:32.10,0:07:34.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu bohong, peluangmu\Nmenikah jadi tertunda, lo.
Dialogue: 0,0:07:36.35,0:07:39.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian serius mau bikin\Naku henti jantung, ya?!
Dialogue: 0,0:07:39.48,0:07:40.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nagisa.
Dialogue: 0,0:07:41.85,0:07:44.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau lihat laut bareng?
Dialogue: 0,0:07:44.69,0:07:47.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi masih cerah...
Dialogue: 0,0:07:47.86,0:07:50.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan melihat laut\Nsaat kita menyelinap malam-malam.
Dialogue: 0,0:07:51.20,0:07:54.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita melihat laut\Nterang-terangan siang bolong.
Dialogue: 0,0:07:55.12,0:07:59.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sembuhkan jantungmu\Ndan berlarian di tepi pantai sesukamu.
Dialogue: 0,0:08:00.58,0:08:02.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita ciptakan masa depan itu.
Dialogue: 0,0:08:04.71,0:08:07.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya aku berobat sekarang...
Dialogue: 0,0:08:07.55,0:08:10.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah tiga bulan berlalu\Nsejak datang ke fasilitas ini.
Dialogue: 0,0:08:10.97,0:08:13.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada sesuatu yang buatku penasaran.
Dialogue: 0,0:08:16.35,0:08:17.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:08:17.89,0:08:19.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyadap.
Dialogue: 0,0:08:20.39,0:08:23.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal menerima sumbangan\Nsecara rutin seperti ini,
Dialogue: 0,0:08:23.68,0:08:26.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}uji klinis untuk operasional fasilitas\Nbukannya berkurang,
Dialogue: 0,0:08:26.61,0:08:28.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}malah terus bertambah.
Dialogue: 0,0:08:28.65,0:08:32.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fasilitas ini menyembunyikan\Nsesuatu dari anak-anak.
Dialogue: 0,0:08:33.57,0:08:35.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya?
Dialogue: 0,0:08:35.16,0:08:37.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setop, Nachan!
Dialogue: 0,0:08:37.45,0:08:40.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelanjutannya kita bahas\Ndi tempat yang lebih bagus!
Dialogue: 0,0:08:41.41,0:08:42.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:08:43.17,0:08:44.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang!
Dialogue: 0,0:08:44.83,0:08:47.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke markas rahasia kami!
Dialogue: 0,0:08:47.92,0:08:50.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Markas rahasia?
Dialogue: 0,0:08:50.34,0:08:51.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul!
Dialogue: 0,0:08:53.85,0:08:55.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini?
Dialogue: 0,0:08:55.31,0:08:56.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang buat!
Dialogue: 0,0:08:56.93,0:08:59.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Santai banget!
Dialogue: 0,0:08:59.51,0:09:01.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian mau apa?
Dialogue: 0,0:09:02.05,0:09:05.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma ingin mengungkap\Nrahasia fasilitas ini saja.
Dialogue: 0,0:09:05.89,0:09:06.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya saja...
Dialogue: 0,0:09:06.98,0:09:09.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada ruginya berjaga-jaga.
Dialogue: 0,0:09:11.69,0:09:13.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan...
Dialogue: 0,0:09:13.43,0:09:15.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi aku?
Dialogue: 0,0:09:16.20,0:09:18.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudmu?
Dialogue: 0,0:09:18.70,0:09:21.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak usah khawatir, Nachan.
Dialogue: 0,0:09:21.29,0:09:24.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan saja ini pada kami!
Dialogue: 0,0:09:24.17,0:09:25.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mau.
Dialogue: 0,0:09:25.87,0:09:29.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita trio besti, 'kan?
Dialogue: 0,0:09:29.63,0:09:32.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa cuma aku yang\Ntidak melakukan apa-apa?
Dialogue: 0,0:09:32.51,0:09:35.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau begitu.
Dialogue: 0,0:09:39.18,0:09:40.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:09:41.31,0:09:43.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau bantu juga, Nagisa?
Dialogue: 0,0:09:46.27,0:09:47.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:09:47.56,0:09:49.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, kita mulai lagi...
Dialogue: 0,0:09:49.86,0:09:53.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bertiga bersama-sama
Dialogue: 0,0:09:53.32,0:09:55.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan mengungkap rahasia fasilitas ini!
Dialogue: 0,0:09:55.57,0:09:57.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:10:36.61,0:10:38.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah waktunya.
Dialogue: 0,0:10:39.49,0:10:42.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak akan kubiarkan berjalan\Nsesuai keinginan mereka lagi.
Dialogue: 0,0:10:42.51,0:10:43.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar!
Dialogue: 0,0:10:44.02,0:10:46.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inilah jawaban kami!
Dialogue: 0,0:10:56.47,0:10:59.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo? Ada pengunjung?
Dialogue: 0,0:11:02.31,0:11:05.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itukah manusia buatan?
Dialogue: 0,0:11:07.60,0:11:08.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga.
Dialogue: 0,0:11:09.05,0:11:11.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu melakukan\Neksperimen manusia, ya.
Dialogue: 0,0:11:12.11,0:11:14.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah menyelidiki sejauh apa?
Dialogue: 0,0:11:14.82,0:11:18.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Percobaan untuk memberikan kemampuan fisik\Nyang melampaui manusia normal
Dialogue: 0,0:11:18.86,0:11:23.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan menyuntikkan suatu bentuk energi\Nyang belum diketahui ke dalam tubuh.
Dialogue: 0,0:11:23.77,0:11:26.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian melakukan percobaan itu\Npada anak-anak yatim piatu
Dialogue: 0,0:11:26.96,0:11:29.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan tujuan menciptakan\Nmanusia buatan...
Dialogue: 0,0:11:29.79,0:11:31.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kira-kira sejauh itu yang kutahu.
Dialogue: 0,0:11:32.25,0:11:33.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu juga...
Dialogue: 0,0:11:33.75,0:11:35.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}manusia buatan?
Dialogue: 0,0:11:39.22,0:11:42.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku adalah Benih Purba.
Dialogue: 0,0:11:42.01,0:11:43.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seed.
Dialogue: 0,0:11:53.90,0:11:57.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wujud ini yang paling pas\Nuntukku sekarang.
Dialogue: 0,0:11:58.19,0:11:59.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi...
Dialogue: 0,0:11:59.95,0:12:05.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang mau kau lakukan\Ndengan menyelidiki tujuan fasilitas ini?
Dialogue: 0,0:12:05.53,0:12:06.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah jelas.
Dialogue: 0,0:12:06.94,0:12:08.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kuhentikan secara paksa.
Dialogue: 0,0:12:09.66,0:12:11.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bergerak,\Naku akan menekan tombol ini
Dialogue: 0,0:12:11.75,0:12:13.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan meledakkan laboratorium ini!
Dialogue: 0,0:12:14.42,0:12:16.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Konyol.
Dialogue: 0,0:12:16.38,0:12:18.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak punya keberanian\Nuntuk menekannya, 'kan?
Dialogue: 0,0:12:18.55,0:12:20.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu ada!
Dialogue: 0,0:12:20.09,0:12:22.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, coba tekan.
Dialogue: 0,0:12:24.80,0:12:26.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tu-Tunggu, kenapa?
Dialogue: 0,0:12:30.81,0:12:33.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu! Tunggu! Jangan!
Dialogue: 0,0:12:37.11,0:12:39.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan begitu, dong, kalian berdua.
Dialogue: 0,0:12:40.11,0:12:43.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengarahkan benda berbahaya begitu.
Dialogue: 0,0:12:45.12,0:12:46.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Achan?
Dialogue: 0,0:12:48.29,0:12:49.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, ya.
Dialogue: 0,0:12:49.75,0:12:53.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak awal, aku di pihak mereka.
Dialogue: 0,0:12:53.33,0:12:54.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?!
Dialogue: 0,0:12:54.67,0:12:57.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajar saja mengikuti\Npihak yang kuat, 'kan?
Dialogue: 0,0:12:58.63,0:13:01.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka payah.
Dialogue: 0,0:13:01.26,0:13:04.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang-orang yang\Ngampang tertipu begini
Dialogue: 0,0:13:04.26,0:13:06.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak mungkin berguna.
Dialogue: 0,0:13:07.18,0:13:08.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi...
Dialogue: 0,0:13:08.50,0:13:12.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai gantinya,\Nberikan benihnya padaku.
Dialogue: 0,0:13:12.68,0:13:13.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benih.
Dialogue: 0,0:13:13.90,0:13:17.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai penemu, aku juga tertarik.
Dialogue: 0,0:13:17.98,0:13:20.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga sudah banyak membantu.
Dialogue: 0,0:13:20.52,0:13:22.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, 'kan? Boleh, 'kan?
Dialogue: 0,0:13:23.03,0:13:26.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa masih terlalu cepat untukmu.
Dialogue: 0,0:13:26.95,0:13:28.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.
Dialogue: 0,0:13:28.53,0:13:30.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa tahan.
Dialogue: 0,0:13:30.91,0:13:33.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pasti bisa menggunakan benihnya.
Dialogue: 0,0:13:35.83,0:13:37.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:13:37.50,0:13:39.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana dengan mereka berdua?
Dialogue: 0,0:13:40.34,0:13:43.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bebaskan saja setelah hapus\Nsebagian ingatan mereka.
Dialogue: 0,0:13:44.26,0:13:46.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bisa menghapus ingatan\Nyang tak berguna, 'kan?
Dialogue: 0,0:13:47.13,0:13:51.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya! Tolong buat mereka\Nmelupakan aku juga!
Dialogue: 0,0:13:52.02,0:13:55.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jijik juga kalau mereka ingat aku terus.
Dialogue: 0,0:13:57.06,0:13:59.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu yakin dengan itu?
Dialogue: 0,0:13:59.94,0:14:02.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berdasarkan cerita tadi,
Dialogue: 0,0:14:02.32,0:14:04.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu akan menjadi korban sendirian
Dialogue: 0,0:14:04.77,0:14:08.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan kami akan selamat.
Dialogue: 0,0:14:10.62,0:14:13.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa salahnya dengan pilihan ini?
Dialogue: 0,0:14:14.45,0:14:17.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika aku bisa menggunakan\Nbenihnya dengan baik,
Dialogue: 0,0:14:17.04,0:14:18.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}eksperimen ini berakhir!
Dialogue: 0,0:14:18.80,0:14:20.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya bisa terselamatkan!
Dialogue: 0,0:14:20.34,0:14:21.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, 'kan?
Dialogue: 0,0:14:21.84,0:14:23.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar aku yang melakukannya!
Dialogue: 0,0:14:23.30,0:14:25.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan mewarisi benih itu!
Dialogue: 0,0:14:25.59,0:14:27.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, biarkan mereka berdua...
Dialogue: 0,0:14:27.55,0:14:28.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:14:31.10,0:14:32.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Achan!
Dialogue: 0,0:14:38.69,0:14:39.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nagisa!
Dialogue: 0,0:14:40.44,0:14:41.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pergilah...
Dialogue: 0,0:14:45.24,0:14:47.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan begitu, dong.
Dialogue: 0,0:14:47.28,0:14:50.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa mengganggu eksperimen ini?
Dialogue: 0,0:14:52.41,0:14:53.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terimalah.
Dialogue: 0,0:14:54.02,0:14:56.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inilah benihku.
Dialogue: 0,0:15:11.51,0:15:13.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Achan.
Dialogue: 0,0:15:13.64,0:15:15.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sichan.
Dialogue: 0,0:15:16.98,0:15:18.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong cepat
Dialogue: 0,0:15:19.73,0:15:22.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lupakan aku.
Dialogue: 0,0:15:27.65,0:15:29.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alicia!
Dialogue: 0,0:15:34.03,0:15:37.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya... Aku dan Siesta...
Dialogue: 0,0:15:37.42,0:15:39.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, bersama Siesta...
Dialogue: 0,0:15:39.67,0:15:43.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, Alicia juga... Kami bertiga...
Dialogue: 0,0:15:45.59,0:15:50.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami melawan SPES\Ndi pulau terpencil itu.
Dialogue: 0,0:15:51.18,0:15:56.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata Alicia itu sungguhan ada\Nterpisah dengan Natsunagi, ya.
Dialogue: 0,0:15:57.18,0:16:01.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sosok itu adalah Alicia
Dialogue: 0,0:16:01.06,0:16:03.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dalam pikiran Natsunagi\Nyang tak ia sadari.
Dialogue: 0,0:16:03.73,0:16:08.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah itu, ingatan\NDetektif Hebat direbut,
Dialogue: 0,0:16:08.53,0:16:11.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi ia berhasil mencuri benih\Ndan keluar dari pulau itu.
Dialogue: 0,0:16:11.95,0:16:16.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski lupa bertarung demi apa\Ndan siapa lawannya,
Dialogue: 0,0:16:16.71,0:16:19.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia tidak lupa apa\Nyang harus ia lakukan.
Dialogue: 0,0:16:22.17,0:16:23.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hel.
Dialogue: 0,0:16:23.59,0:16:26.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang terjadi padaku setelah itu?
Dialogue: 0,0:16:26.58,0:16:30.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak kehilangan Alicia\Ndi depan mataku...
Dialogue: 0,0:16:31.26,0:16:34.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tepat setelah itu, aku lahir.
Dialogue: 0,0:16:35.51,0:16:39.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih tepatnya,\Nsaat itulah pertama kalinya
Dialogue: 0,0:16:39.31,0:16:41.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku muncul di permukaan.
Dialogue: 0,0:16:41.77,0:16:44.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah itu, aku menjadi anggota SPES
Dialogue: 0,0:16:44.90,0:16:47.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan terus mengabdi pada organisasi.
Dialogue: 0,0:16:47.61,0:16:49.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu...
Dialogue: 0,0:16:49.10,0:16:52.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menjadi orang istimewa\Nbagi Ayahanda.
Dialogue: 0,0:16:52.65,0:16:57.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau sangat setia mengabdi\Npada SPES dan Seed?
Dialogue: 0,0:16:57.23,0:16:59.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan buatku mengulang lagi.
Dialogue: 0,0:17:00.41,0:17:01.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cinta.
Dialogue: 0,0:17:02.29,0:17:05.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inti semacam itu diperlukan.
Dialogue: 0,0:17:05.88,0:17:06.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inti?
Dialogue: 0,0:17:06.79,0:17:07.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:17:07.92,0:17:12.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa dibilang itu sebagai pasak\Nyang menjaga dunia ini.
Dialogue: 0,0:17:12.22,0:17:15.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika tidak, rasanya aku bakal hilang.
Dialogue: 0,0:17:15.30,0:17:17.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena aku cuma tiruan.
Dialogue: 0,0:17:18.47,0:17:21.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu menertawakanku\Nyang menginginkan cinta?
Dialogue: 0,0:17:22.27,0:17:26.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang tidak mau hilang dari dunia,\Nmembuat orang tak berdosa tersiksa,
Dialogue: 0,0:17:26.78,0:17:30.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akhirnya kalah\Ndan kehilangan kekuatan...
Dialogue: 0,0:17:30.65,0:17:31.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian menertawakanku?
Dialogue: 0,0:17:31.95,0:17:33.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak akan.
Dialogue: 0,0:17:33.66,0:17:35.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin bisa.
Dialogue: 0,0:17:36.07,0:17:38.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kamu
Dialogue: 0,0:17:38.45,0:17:43.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menjadi anggota SPES\Nuntuk melindungiku.
Dialogue: 0,0:17:43.04,0:17:44.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, 'kan?
Dialogue: 0,0:17:44.54,0:17:47.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kamu katakan?
Dialogue: 0,0:17:48.00,0:17:50.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku melakukannya demi Nona?
Dialogue: 0,0:17:50.42,0:17:54.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat itu, Alicia mati.
Dialogue: 0,0:17:54.51,0:17:58.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga harusnya mati seperti dia.
Dialogue: 0,0:17:58.89,0:18:01.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kamu tidak muncul.
Dialogue: 0,0:18:02.60,0:18:06.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu menunjukkan dirimu bakal berguna
Dialogue: 0,0:18:06.02,0:18:10.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan bersumpah setia\Ndemi menyelamatkan nyawaku.
Dialogue: 0,0:18:10.32,0:18:14.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu menjadi iblis\Ndemi melindungiku.
Dialogue: 0,0:18:15.78,0:18:17.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa buktinya?
Dialogue: 0,0:18:17.87,0:18:20.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alasanmu menyebabkan\Ninsiden saat itu
Dialogue: 0,0:18:20.28,0:18:23.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah untuk mencegah tubuhku mati\Nsetelah kehilangan jantungku
Dialogue: 0,0:18:23.83,0:18:25.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dalam pertarungan dengan Siesta.
Dialogue: 0,0:18:25.96,0:18:31.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu terus mencari jantung\Nyang sesuai untukku.
Dialogue: 0,0:18:31.92,0:18:36.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Detektif Hebat itu tidak mengatakan\Nsoal itu sama sekali.
Dialogue: 0,0:18:36.78,0:18:41.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku melakukan itu hanya\Ndemi diriku bertahan hidup.
Dialogue: 0,0:18:41.47,0:18:44.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona mau menyangkal itu?
Dialogue: 0,0:18:44.98,0:18:46.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan.
Dialogue: 0,0:18:46.02,0:18:50.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siesta sendiri yang bilang\Nkesimpulan itu salah.
Dialogue: 0,0:18:51.94,0:18:53.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:18:54.32,0:18:57.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siesta salah memahami\Nmotif kejahatan Hel...
Dialogue: 0,0:18:57.26,0:19:00.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, dia salah memahami emosi Hel.
Dialogue: 0,0:19:00.99,0:19:04.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah kesalahan Siesta...
Dialogue: 0,0:19:04.54,0:19:08.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, Noches meminta kami\Nmencari kesalahannya.
Dialogue: 0,0:19:09.17,0:19:13.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siesta melanjutkan pembicaraan\Ndenganmu dalam diriku,
Dialogue: 0,0:19:13.21,0:19:15.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu mendapatkan kesimpulan.
Dialogue: 0,0:19:15.84,0:19:17.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, kamu
Dialogue: 0,0:19:17.88,0:19:22.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sangat peduli padaku\Nlebih dari apa pun.
Dialogue: 0,0:19:23.06,0:19:24.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak hanya dicintai.
Dialogue: 0,0:19:24.98,0:19:27.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sendiri juga mencintai.
Dialogue: 0,0:19:27.90,0:19:30.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mencintaiku.
Dialogue: 0,0:19:31.65,0:19:32.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan.
Dialogue: 0,0:19:32.98,0:19:39.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu menanggung derita\Ndan rasa sakitku.
Dialogue: 0,0:19:39.36,0:19:41.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kali ini...
Dialogue: 0,0:19:41.12,0:19:45.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan ikut memikul dosa\Ndan rasa sakitmu.
Dialogue: 0,0:19:45.00,0:19:47.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menebusnya seumur hidup.
Dialogue: 0,0:19:48.46,0:19:49.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan!
Dialogue: 0,0:19:49.78,0:19:51.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau itu!
Dialogue: 0,0:19:51.46,0:19:52.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak menginginkan itu!
Dialogue: 0,0:19:58.38,0:19:59.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena...
Dialogue: 0,0:20:00.72,0:20:04.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin ada hubungan
Dialogue: 0,0:20:04.89,0:20:07.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang selalu menerima\Natau memberi saja.
Dialogue: 0,0:20:10.64,0:20:13.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu juga setuju, 'kan?
Dialogue: 0,0:20:17.19,0:20:18.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar.
Dialogue: 0,0:20:19.86,0:20:23.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Majikanku benar-benar bodoh.
Dialogue: 0,0:20:24.53,0:20:28.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah melindungiku
Dialogue: 0,0:20:30.25,0:20:31.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}selama ini.
Dialogue: 0,0:20:36.34,0:20:37.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi...
Dialogue: 0,0:20:37.30,0:20:40.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bohong menggunakan\Ncermin berhadapan
Dialogue: 0,0:20:40.09,0:20:41.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk memanggil Hel, 'kan?
Dialogue: 0,0:20:43.43,0:20:47.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa dipungkiri Nagisa\Nsudah berbicara dengan Hel.
Dialogue: 0,0:20:47.22,0:20:51.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nagisa memanggil Hel yang selama ini\Ntertidur di alam bawah sadarnya,
Dialogue: 0,0:20:51.15,0:20:54.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan berulang kali berdialog\Ndengan dirinya sendiri.
Dialogue: 0,0:20:54.65,0:20:57.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan begini, Nagisa benar-benar
Dialogue: 0,0:20:57.49,0:20:59.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mendapatkan\Nsemua ingatannya kembali.
Dialogue: 0,0:21:00.22,0:21:01.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata begitu.
Dialogue: 0,0:21:01.78,0:21:05.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi tak kusangka Siesta\Nbisa salah perhitungan.
Dialogue: 0,0:21:05.91,0:21:10.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin penyebabnya juga\Nkarena lupa ingatan.
Dialogue: 0,0:21:16.21,0:21:17.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo.
Dialogue: 0,0:21:19.05,0:21:21.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada kabar buruk dan kabar buruk.
Dialogue: 0,0:21:22.42,0:21:24.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau dengar dari yang mana dulu?
Dialogue: 0,0:21:24.97,0:21:27.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan pilihan itu namanya.
Dialogue: 0,0:21:27.56,0:21:29.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, kabar pertama.
Dialogue: 0,0:21:29.89,0:21:32.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seed dan Koumori bekerja sama.
Dialogue: 0,0:21:33.39,0:21:37.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Koumori melarikan diri\Ndengan bantuan Seed.
Dialogue: 0,0:21:37.00,0:21:39.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian jangan lengah juga.
Dialogue: 0,0:21:40.23,0:21:43.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, kabar buruk satunya lagi.
Dialogue: 0,0:21:45.24,0:21:46.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oi.
Dialogue: 0,0:21:46.28,0:21:47.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu.
Dialogue: 0,0:21:48.49,0:21:52.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sopan sekali sampai\Nmenekan bel segala.
Dialogue: 0,0:21:52.58,0:21:53.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Koumori.
Dialogue: 0,0:21:54.96,0:21:57.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sa-Saikawa?
Dialogue: 0,0:21:58.13,0:21:59.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kimizuka.
Dialogue: 0,0:22:00.21,0:22:01.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong
Dialogue: 0,0:22:01.92,0:22:04.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadilah produserku!
Dialogue: 0,0:22:05.39,0:22:10.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di pagi kau membuka matamu♪
Dialogue: 0,0:22:10.35,0:22:15.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagai cahaya yang menyinari♪
Dialogue: 0,0:22:15.86,0:22:24.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku biarkan gorden\Ndan jendela kamar terbuka sedikit♪
Dialogue: 0,0:22:24.95,0:22:30.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari-hari yang polos itu\Nbegitu menyilaukan♪
Dialogue: 0,0:22:30.87,0:22:35.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kepolosan yang membuatku\Ntanpa sadar memalingkan pandangan♪
Dialogue: 0,0:22:35.00,0:22:40.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sembari menelusuri\Ningatan yang terjatuh♪
Dialogue: 0,0:22:40.38,0:22:46.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berlarian di pantai telanjang kaki♪
Dialogue: 0,0:22:46.47,0:22:51.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak tertahankan,\Ntak kuat kubendung lagi♪
Dialogue: 0,0:22:51.77,0:22:56.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menghubungkan masa kini\Nyang meluap-luap menuju hari esok♪
Dialogue: 0,0:22:56.90,0:23:05.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Janji kelingkingku denganmu\Ndalam mimpi♪
Dialogue: 0,0:23:07.37,0:23:12.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesedihan dan kegundahan,\Njuga cinta yang begitu menyakitkan♪
Dialogue: 0,0:23:12.66,0:23:22.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena rasa dalam hati ini\Nbukan cuma milikku seorang♪
Dialogue: 0,0:23:22.00,0:23:25.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menjaganya♪
Dialogue: 0,0:23:25.93,0:23:32.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai kau terbangun♪
