Dialogue: 0,0:01:50.55,0:01:58.72,sign,,0000,0000,0000,,(The Detective Is Already Dead. Season 2)
Dialogue: 0,0:03:17.97,0:03:20.93,sign,,0000,0000,0000,,(Episode 1 - Demi Bertemu denganmu Sekali Lagi)
Dialogue: 0,0:23:34.98,0:23:39.98,sign,,0000,0000,0000,,(Episode 2 - Cerita Hari Itu\Nyang Tidak Diketahui Siapa pun)
Dialogue: 0,0:00:13.87,0:00:16.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kamu lakukan di situ?
Dialogue: 0,0:00:18.49,0:00:20.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mendengarkan suara laut.
Dialogue: 0,0:00:21.83,0:00:23.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma mendengarkan?
Dialogue: 0,0:00:24.29,0:00:25.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak melihatnya?
Dialogue: 0,0:00:25.88,0:00:27.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya...
Dialogue: 0,0:00:28.05,0:00:29.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak terlihat, 'kan?
Dialogue: 0,0:00:31.51,0:00:34.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, datang siang saja, 'kan?
Dialogue: 0,0:00:35.22,0:00:37.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maunya begitu, sih.
Dialogue: 0,0:00:37.77,0:00:40.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi bisa ketahuan kalau siang.
Dialogue: 0,0:00:41.02,0:00:43.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, kamu siapa?
Dialogue: 0,0:00:43.96,0:00:46.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya kita baru bertemu.
Dialogue: 0,0:00:46.86,0:00:49.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dibawa kemari akhir-akhir ini.
Dialogue: 0,0:00:49.95,0:00:52.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada alasannya.
Dialogue: 0,0:00:52.70,0:00:54.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh...
Dialogue: 0,0:00:54.20,0:00:55.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namamu siapa?
Dialogue: 0,0:00:57.49,0:00:59.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}602.
Dialogue: 0,0:00:59.33,0:01:02.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang-orang dewasa memanggilku begitu.
Dialogue: 0,0:01:21.69,0:01:23.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nagisa.
Dialogue: 0,0:01:25.73,0:01:29.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan memanggilmu begitu\Nkarena kamu suka laut.
Dialogue: 0,0:01:30.82,0:01:32.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa namamu?
Dialogue: 0,0:01:32.70,0:01:34.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak punya nama.
Dialogue: 0,0:01:35.03,0:01:36.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:01:36.33,0:01:37.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi?
Dialogue: 0,0:01:38.07,0:01:40.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku punya nama sandi.
Dialogue: 0,0:01:41.33,0:01:52.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buket bunga yang\Ntak pernah layu di jantungku♪
Dialogue: 0,0:02:01.68,0:02:07.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, mungkin sudah terlambat,\Ntapi aku ingin tanya sesuatu♪
Dialogue: 0,0:02:07.98,0:02:14.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah kamu bahagia melewati\Nhari-hari yang kita habiskan bersama?♪
Dialogue: 0,0:02:14.11,0:02:20.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak pernah bermimpi tentang\Nmasa depan tanpa kehilangan apa-apa♪
Dialogue: 0,0:02:20.95,0:02:28.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bila bisa memelukmu sekali lagi\Nuntuk terakhir kali♪
Dialogue: 0,0:02:28.63,0:02:34.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma tidur sedikit lebih lama, kok♪
Dialogue: 0,0:02:34.22,0:02:40.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan berwajah begitu♪
Dialogue: 0,0:02:40.56,0:02:47.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama jantungku masih\Nberdetak dalam dirimu♪
Dialogue: 0,0:02:47.44,0:02:54.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pasti takkan pernah\Nmelupakan kesedihan itu♪
Dialogue: 0,0:02:54.51,0:02:57.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak terlihat apa-apa,\Ntapi tampak samar-samar♪
Dialogue: 0,0:02:57.78,0:03:01.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bak cahaya yang menyinari\Nlautan di malam hari♪
Dialogue: 0,0:03:01.04,0:03:08.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memandangi kelanjutan\Nmimpi putih itu di sampingmu♪
Dialogue: 0,0:03:18.17,0:03:20.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini di mana?
Dialogue: 0,0:03:31.44,0:03:33.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ngapain, sih, Natsunagi?
Dialogue: 0,0:03:33.44,0:03:35.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang harusnya tanya!
Dialogue: 0,0:03:35.57,0:03:38.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan coba-coba mencium\Ncewek sekelasmu yang lagi tidur!
Dialogue: 0,0:03:39.28,0:03:41.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Absurd.
Dialogue: 0,0:03:41.12,0:03:44.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian berisik sejak tadi.
Dialogue: 0,0:03:44.57,0:03:46.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saikawa?
Dialogue: 0,0:03:46.33,0:03:48.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau juga di sini?
Dialogue: 0,0:03:49.04,0:03:53.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Alasanku tidur sama Kimizuka?
Dialogue: 0,0:03:53.13,0:03:55.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok malah tanya aku?
Dialogue: 0,0:03:55.34,0:03:58.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kesannya ambigu begitu?
Dialogue: 0,0:03:58.43,0:04:00.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Bukan aku yang membawa kamu, 'kan?
Dialogue: 0,0:04:00.84,0:04:03.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian benar-benar tidak ingat?
Dialogue: 0,0:04:03.60,0:04:04.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Char...
Dialogue: 0,0:04:04.97,0:04:08.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam perjalanan ziarah\Nke makam Nona,
Dialogue: 0,0:04:08.06,0:04:10.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ada seseorang yang\Nmenculik kita ke sini.
Dialogue: 0,0:04:11.06,0:04:12.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Iya!\N- Benar juga!
Dialogue: 0,0:04:12.48,0:04:14.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya juga.
Dialogue: 0,0:04:14.11,0:04:18.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar. Kalian ini lengah melulu.
Dialogue: 0,0:04:18.36,0:04:20.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu juga diculik, 'kan?\N- Char juga diculik.\N- Char juga diculik, 'kan?
Dialogue: 0,0:04:20.45,0:04:22.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duh, iya, deh! Maaf!
Dialogue: 0,0:04:34.13,0:04:38.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika rekaman ini diputar,
Dialogue: 0,0:04:38.80,0:04:43.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berarti Kimizuka Kimihiko,\NNatsunagi Nagisa,
Dialogue: 0,0:04:43.67,0:04:47.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saikawa Yui,\NCharlotte Arisaka Anderson
Dialogue: 0,0:04:47.47,0:04:49.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sedang bersama.
Dialogue: 0,0:04:50.89,0:04:52.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Siesta...\N- Nona!
Dialogue: 0,0:04:52.75,0:04:55.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lama tidak bertemu, Char.
Dialogue: 0,0:04:55.02,0:05:00.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi maaf, ini adalah rekaman\Nuntuk mengantisipasi hari ini
Dialogue: 0,0:05:00.28,0:05:01.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang diambil setahun lalu.
Dialogue: 0,0:05:02.28,0:05:03.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona...
Dialogue: 0,0:05:04.32,0:05:07.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang ini... Siesta?
Dialogue: 0,0:05:07.64,0:05:12.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, ada alasan aku\Nmengumpulkan kalian di sini.
Dialogue: 0,0:05:12.62,0:05:15.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin kalian segera tahu.
Dialogue: 0,0:05:15.63,0:05:18.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentang apa yang terjadi\Npadaku setahun lalu.
Dialogue: 0,0:05:19.92,0:05:22.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang terjadi?
Dialogue: 0,0:05:23.55,0:05:26.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin kalian menyimaknya.
Dialogue: 0,0:05:26.43,0:05:29.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peristiwa itu yang terjadi pada kita.
Dialogue: 0,0:05:29.35,0:05:31.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan kebenaran di balik kematianku.
Dialogue: 0,0:05:31.69,0:05:33.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, selain itu...
Dialogue: 0,0:05:34.14,0:05:36.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin kalian memutuskan.
Dialogue: 0,0:05:38.98,0:05:43.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemudian dimulailah\Ningatanku dengan Siesta
Dialogue: 0,0:05:43.28,0:05:45.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}selama tiga tahun.
Dialogue: 0,0:05:46.61,0:05:50.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami bertemu 10.000 meter di atas tanah\Ndi dalam pesawat yang dibajak,
Dialogue: 0,0:05:50.58,0:05:54.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami memulai petualangan\Nyang menakjubkan.
Dialogue: 0,0:05:54.58,0:05:58.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya, kami bertarung melawan\Norganisasi rahasia bernama SPES,
Dialogue: 0,0:05:58.34,0:06:00.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu bertemu gadis misterius\Nbernama Alicia.
Dialogue: 0,0:06:00.84,0:06:02.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, tanpa sepengetahuan Alicia,
Dialogue: 0,0:06:02.93,0:06:05.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ada kepribadian lain\Nbernama Hel dalam dirinya.
Dialogue: 0,0:06:06.88,0:06:11.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemudian kami menuju ke persembunyian\Nmusuh untuk mengejar Hel
Dialogue: 0,0:06:11.89,0:06:13.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau untuk menyelamatkan Alicia.
Dialogue: 0,0:06:14.06,0:06:16.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami bertemu bos musuh di sana, Seed.
Dialogue: 0,0:06:17.73,0:06:22.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, Siesta terjun ke pertarungan\Nterakhir dengan Hel.
Dialogue: 0,0:06:23.11,0:06:26.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setahun yang lalu,\Napa yang terjadi di pulau itu?
Dialogue: 0,0:06:26.81,0:06:30.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa detektif sudah mati?
Dialogue: 0,0:06:31.08,0:06:32.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka...
Dialogue: 0,0:06:33.08,0:06:35.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pun tahu alasannya.
Dialogue: 0,0:06:35.58,0:06:39.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari itu, yang merenggut\Nnyawa Siesta di tempat itu...
Dialogue: 0,0:06:39.82,0:06:41.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pelakunya.
Dialogue: 0,0:06:43.80,0:06:46.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang membunuh Siesta...
Dialogue: 0,0:06:47.72,0:06:51.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku merenggut orang\Npaling berhargamu.
Dialogue: 0,0:06:51.93,0:06:53.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:06:53.34,0:06:56.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak! Natsunagi\Nsama sekali tidak salah!
Dialogue: 0,0:06:56.02,0:06:57.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak melakukan apa-apa!
Dialogue: 0,0:06:57.60,0:06:59.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu orang lain!
Dialogue: 0,0:06:59.94,0:07:03.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat aku bilang menerima\Ntransplantasi jantung,
Dialogue: 0,0:07:03.19,0:07:07.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebenarnya aku cuma\Nmerebut jantung Siesta.
Dialogue: 0,0:07:07.32,0:07:11.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenangan masa kecilku tentang\Nlama dirawat di rumah sakit juga
Dialogue: 0,0:07:11.24,0:07:15.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena kenangan yang tersisa\Ndari saat aku ditawan di SPES.
Dialogue: 0,0:07:18.29,0:07:20.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Natsunagi pun mengetahui semuanya.
Dialogue: 0,0:07:20.92,0:07:22.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau lebih tepatnya, mengingatnya.
Dialogue: 0,0:07:23.09,0:07:26.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis bernama Alicia dan Hel
Dialogue: 0,0:07:26.67,0:07:28.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah dirinya sendiri.
Dialogue: 0,0:07:29.60,0:07:33.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia hilang ingatan\Nkarena serbuk sari itu, ya?
Dialogue: 0,0:07:33.64,0:07:36.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nagisa dan Kimizuka.
Dialogue: 0,0:07:36.35,0:07:39.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau selama ini ingat, ya, Char.
Dialogue: 0,0:07:39.81,0:07:40.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:07:40.90,0:07:42.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Char, aku—
Dialogue: 0,0:07:42.19,0:07:43.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bicara apa pun!
Dialogue: 0,0:07:44.23,0:07:47.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu kamu tidak salah.
Dialogue: 0,0:07:47.31,0:07:51.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya saja, tolong... tunggu sebentar.
Dialogue: 0,0:07:52.49,0:07:53.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:07:55.87,0:07:58.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa!\NAyo tenangkan diri!
Dialogue: 0,0:07:59.25,0:08:03.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Genggam tanganmu. Rilekskan tubuhmu.\NRitmekan napasmu.
Dialogue: 0,0:08:04.09,0:08:08.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tutup mata sebentar,\Nlalu tarik napas dalam dan keluarkan.
Dialogue: 0,0:08:08.09,0:08:09.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Darah akan mengalir lancar.
Dialogue: 0,0:08:09.78,0:08:14.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu membuka mata,\Npandangan kabur pun jadi tampak jernih.
Dialogue: 0,0:08:15.26,0:08:16.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saikawa?
Dialogue: 0,0:08:16.89,0:08:20.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu itu selesai,\Nbagaimana kalau kita minum teh?
Dialogue: 0,0:08:21.39,0:08:25.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga. Kenapa malah kau\Nyang paling dewasa?
Dialogue: 0,0:08:27.69,0:08:30.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau minum teh?\NSepertinya asyik.
Dialogue: 0,0:08:30.41,0:08:32.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin ikut juga.
Dialogue: 0,0:08:36.66,0:08:39.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu menyentuh tubuh ini lagi,
Dialogue: 0,0:08:39.46,0:08:41.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan menghancurkan\Nseluruh tulangmu.
Dialogue: 0,0:08:41.92,0:08:43.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Absurd.
Dialogue: 0,0:08:46.50,0:08:48.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa kau?
Dialogue: 0,0:08:50.51,0:08:52.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siesta?
Dialogue: 0,0:09:02.35,0:09:05.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayangnya, tidak ada camilan\Natau kudapan,
Dialogue: 0,0:09:05.19,0:09:07.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bagaimana kalau pakai pesan antar?
Dialogue: 0,0:09:07.47,0:09:09.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kimihiko yang traktir.
Dialogue: 0,0:09:09.19,0:09:11.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oi, jangan lupa utang budimu padaku.
Dialogue: 0,0:09:12.28,0:09:16.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kami dibawa ke mana?
Dialogue: 0,0:09:16.12,0:09:20.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini adalah salah satu markas Siesta.
Dialogue: 0,0:09:21.37,0:09:23.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baru dengar.
Dialogue: 0,0:09:27.29,0:09:30.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar mirip Nona.
Dialogue: 0,0:09:30.26,0:09:32.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Charlotte, aku ingatkan sekali lagi.
Dialogue: 0,0:09:32.93,0:09:35.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma robot.
Dialogue: 0,0:09:35.18,0:09:38.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Android biologis yang mengacu\Npada tubuh, ingatan,
Dialogue: 0,0:09:38.60,0:09:42.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan sebagian kemampuan\NNona Siesta semasa hidupnya.
Dialogue: 0,0:09:43.21,0:09:45.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nama yang diberikan\NNona Siesta padaku...
Dialogue: 0,0:09:45.96,0:09:47.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Noches.
Dialogue: 0,0:09:47.90,0:09:50.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sulit dipercaya, tapi harus percaya.
Dialogue: 0,0:09:50.86,0:09:55.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siesta asli pasti membiarkanku bersandar\Ndi pangkuan pahanya sambil minum.
Dialogue: 0,0:09:56.41,0:09:59.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah memeriksa pangkalan data,
Dialogue: 0,0:09:59.12,0:10:01.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi tidak ada catatan seperti itu.
Dialogue: 0,0:10:01.12,0:10:03.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan terang-terangan\Nmemalingkan wajahmu!
Dialogue: 0,0:10:03.12,0:10:06.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika referensimu Siesta,\Njangan membenciku!
Dialogue: 0,0:10:06.45,0:10:09.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru karena aku dibuat\Nberdasarkan Nona Siesta,
Dialogue: 0,0:10:09.55,0:10:11.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}makanya aku membencimu.
Dialogue: 0,0:10:11.59,0:10:14.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang jangan lupakan\Nutang budimu padaku, 'kan?
Dialogue: 0,0:10:14.55,0:10:18.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan obrolan santai ini\Nseolah mereka pasutri tua?
Dialogue: 0,0:10:18.76,0:10:21.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yui, berhenti menggambarkan\Nmereka seperti pasutri!
Dialogue: 0,0:10:21.14,0:10:22.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Veteran pelawak saja.
Dialogue: 0,0:10:23.93,0:10:28.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Noches. Apa kau tahu\Npelaku yang menculik kami?
Dialogue: 0,0:10:28.82,0:10:32.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu berarti kau ada keperluan\Ndengan kami, 'kan?
Dialogue: 0,0:10:34.61,0:10:40.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Siesta mempersiapkan banyak hal\Nsebelum hari itu datang.
Dialogue: 0,0:10:40.32,0:10:45.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan aku diberi tugas memberi tahu\Nkebenaran pada kalian.
Dialogue: 0,0:10:47.83,0:10:48.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nagisa.
Dialogue: 0,0:10:49.84,0:10:54.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkat kamu, tekad Siesta tidak hilang.
Dialogue: 0,0:10:54.21,0:10:58.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harapan dan pekerjaan\Nterakhir Nona Siesta
Dialogue: 0,0:10:58.68,0:11:02.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah membuatmu bertahan hidup\Ndan bersekolah.
Dialogue: 0,0:11:02.76,0:11:05.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku mewakili Nona Siesta\Nuntuk mengatakan ini.
Dialogue: 0,0:11:06.73,0:11:08.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:11:10.10,0:11:11.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku...
Dialogue: 0,0:11:15.40,0:11:19.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kenapa baru sekarang\Nmenceritakan soal masa lalu?
Dialogue: 0,0:11:19.74,0:11:23.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di mana orang yang\Nmerahasiakannya selama ini?
Dialogue: 0,0:11:23.25,0:11:25.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada beberapa alasannya.
Dialogue: 0,0:11:25.62,0:11:30.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama, Nona Siesta\Nbutuh waktu yang lama
Dialogue: 0,0:11:30.00,0:11:35.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk menekan kepribadian kejam Hel\Nyang tertidur dalam tubuh Nagisa,
Dialogue: 0,0:11:35.13,0:11:37.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}serta menstabilkan kondisi Nagisa.
Dialogue: 0,0:11:38.05,0:11:39.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kedua...
Dialogue: 0,0:11:39.76,0:11:44.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia menunggu perasaan\Nkalian berempat menyatu.
Dialogue: 0,0:11:45.31,0:11:47.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, alasan terakhir.
Dialogue: 0,0:11:47.69,0:11:49.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu adalah...
Dialogue: 0,0:11:49.69,0:11:51.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seed.
Dialogue: 0,0:11:52.27,0:11:57.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seed tidak melakukan aksi mencolok\Ndalam setahun ini.
Dialogue: 0,0:11:57.24,0:12:02.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi akhir-akhir ini,\Nsituasinya berubah.
Dialogue: 0,0:12:02.27,0:12:05.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menghentikan itu...
Dialogue: 0,0:12:05.04,0:12:06.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah pekerjaanmu, Nagisa.
Dialogue: 0,0:12:06.82,0:12:09.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pekerjaanku?
Dialogue: 0,0:12:09.24,0:12:12.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bukan masalah yang harus\Ndipikul Natsunagi sendiri, 'kan?
Dialogue: 0,0:12:12.41,0:12:14.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu memang benar.
Dialogue: 0,0:12:14.31,0:12:18.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, peran yang dimiliki Nagisa
Dialogue: 0,0:12:18.09,0:12:21.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lebih penting daripada Kimihiko,\NYui, dan Charlotte.
Dialogue: 0,0:12:21.80,0:12:25.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu karena Nagisa\Nadalah Detektif Hebat.
Dialogue: 0,0:12:27.43,0:12:32.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya. Nona Siesta belum\Nmemberi tahu kalian.
Dialogue: 0,0:12:32.35,0:12:34.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Istilah "Detektif Hebat"\Nyang kita bahas...
Dialogue: 0,0:12:34.69,0:12:35.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu!
Dialogue: 0,0:12:35.89,0:12:40.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bicara lebih dari itu,\Nkamu bisa melanggar Piagam Federasi.
Dialogue: 0,0:12:40.48,0:12:42.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak masalah.
Dialogue: 0,0:12:42.23,0:12:45.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena mereka juga terlibat.
Dialogue: 0,0:12:50.00,0:12:54.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Detektif Hebat adalah salah satu\Ndari 12 tameng yang melindungi dunia.
Dialogue: 0,0:12:54.70,0:12:57.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salah satu peran dalam Penjaga.
Dialogue: 0,0:12:57.42,0:12:59.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penjaga?
Dialogue: 0,0:12:59.13,0:13:04.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Krisis yang muncul berkala atau terjadi\Ndi berbagai tempat bersamaan di dunia ini.
Dialogue: 0,0:13:05.05,0:13:09.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang-orang yang ditunjuk\Norganisasi internasional
Dialogue: 0,0:13:09.06,0:13:11.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk menghadapi ancaman itu.
Dialogue: 0,0:13:11.06,0:13:13.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Merekalah Penjaga.
Dialogue: 0,0:13:13.64,0:13:16.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Total ada 12 Penjaga.
Dialogue: 0,0:13:16.11,0:13:17.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peran mereka pun bermacam-macam,
Dialogue: 0,0:13:17.90,0:13:20.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}seperti Pencuri, Miko, dan Pembunuh.
Dialogue: 0,0:13:20.74,0:13:25.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan, konon di antara\Nmereka ada Vampir.
Dialogue: 0,0:13:25.16,0:13:26.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Vampir?
Dialogue: 0,0:13:26.95,0:13:28.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:13:28.41,0:13:31.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setahun yang lalu,\NNona Siesta tewas.
Dialogue: 0,0:13:31.75,0:13:35.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peran Detektif Hebat yang bertugas\Nmembasmi SPES pun
Dialogue: 0,0:13:35.79,0:13:37.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menjadi kosong.
Dialogue: 0,0:13:37.79,0:13:41.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika begini terus,\NDetektif Hebat selanjutnya
Dialogue: 0,0:13:41.30,0:13:44.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kemungkinan adalah kamu, Nagisa.
Dialogue: 0,0:13:44.80,0:13:47.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja ini belum final.
Dialogue: 0,0:13:47.79,0:13:51.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, ia memiliki jantung\Nmantan Detektif Hebat,
Dialogue: 0,0:13:51.56,0:13:53.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan atas kehendaknya sendiri\Nmeneruskan tekadnya.
Dialogue: 0,0:13:53.81,0:13:59.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan bisa menggunakan kekuatan\Nyang tak dimiliki manusia biasa.
Dialogue: 0,0:13:59.31,0:14:04.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti banyak yang berpikir kamu cukup\Nberkualifikasi menjadi Detektif Hebat.
Dialogue: 0,0:14:04.07,0:14:07.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siesta sudah tidak akan muncul\Ndi tubuh Natsunagi lagi, lo.
Dialogue: 0,0:14:07.78,0:14:09.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu.
Dialogue: 0,0:14:09.57,0:14:13.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku mewakili Nona Siesta\Nuntuk menanyakan ini.
Dialogue: 0,0:14:14.25,0:14:19.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nagisa, apa kamu benar-benar ingin\Nmewarisi tekad Detektif Hebat?
Dialogue: 0,0:14:20.46,0:14:22.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku...
Dialogue: 0,0:14:22.50,0:14:23.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misal...
Dialogue: 0,0:14:24.09,0:14:27.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misal Natsunagi memutuskan\Nmenjadi Detektif Hebat,
Dialogue: 0,0:14:27.51,0:14:29.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia harus apa dulu?
Dialogue: 0,0:14:30.26,0:14:31.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal itu...
Dialogue: 0,0:14:34.85,0:14:38.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, mari kita bermain\Nmencari kesalahan.
Dialogue: 0,0:14:42.19,0:14:46.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika Natsunagi ragu\Nuntuk menjadi Detektif Hebat,
Dialogue: 0,0:14:46.99,0:14:51.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}belum terlambat untuk mengungkap\Nkejanggalan dalam rekaman
Dialogue: 0,0:14:51.41,0:14:54.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang kami lihat kemarin,\Nyang berasal dari setahun yang lalu.
Dialogue: 0,0:14:55.75,0:14:58.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Noches mengatakan itu,
Dialogue: 0,0:14:56.33,0:14:58.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Reaksi aneh apaan itu?
Dialogue: 0,0:14:58.25,0:15:00.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:14:58.83,0:15:01.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu membebaskan kami.
Dialogue: 0,0:15:04.26,0:15:05.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:15:06.00,0:15:08.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada petunjuknya.
Dialogue: 0,0:15:19.02,0:15:20.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin.
Dialogue: 0,0:15:21.44,0:15:25.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan, kamu tidur di sini\Nsetelah makan siang sendirian?
Dialogue: 0,0:15:26.45,0:15:29.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makan siang yang dimakan\Ndi atap itu enak, lo.
Dialogue: 0,0:15:29.20,0:15:31.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan malah klaim itunya.
Dialogue: 0,0:15:31.20,0:15:35.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pasti jadi menginap di sekolah\Nkalau tidak kubangunkan, 'kan?
Dialogue: 0,0:15:35.54,0:15:37.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gimana kalau cari teman?
Dialogue: 0,0:15:37.44,0:15:39.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya aku tidak mencari teman,
Dialogue: 0,0:15:39.88,0:15:41.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi tidak bisa.
Dialogue: 0,0:15:42.88,0:15:48.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, kamu boleh menghitungku\Njadi temanmu.
Dialogue: 0,0:15:48.72,0:15:52.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Punya teman yang bisa diajak bicara\Napa saja itu enak, 'kan?
Dialogue: 0,0:15:52.51,0:15:53.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Imut pula.
Dialogue: 0,0:15:55.35,0:15:58.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mengerti\Nkarena tidak punya teman.
Dialogue: 0,0:15:58.44,0:16:00.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar aneh.
Dialogue: 0,0:16:00.31,0:16:03.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa-bisanya kamu akur dengan Siesta.
Dialogue: 0,0:16:03.54,0:16:06.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seingatku tidak seakur itu.
Dialogue: 0,0:16:06.15,0:16:08.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami bertengkar\Nsetidaknya tiga hari sekali.
Dialogue: 0,0:16:08.68,0:16:12.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu yang minta maaf duluan?
Dialogue: 0,0:16:12.03,0:16:13.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biasanya.
Dialogue: 0,0:16:13.97,0:16:18.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kadang aku juga keras kepala\Ndan mengabaikannya sekitar seminggu.
Dialogue: 0,0:16:18.29,0:16:19.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus?
Dialogue: 0,0:16:19.62,0:16:22.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia jadi gelisah.
Dialogue: 0,0:16:22.29,0:16:24.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siesta imut banget.
Dialogue: 0,0:16:24.34,0:16:27.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus, saat aku mulai\Nmengajaknya bicara,
Dialogue: 0,0:16:27.22,0:16:30.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}wajahnya langsung\Nterlihat lega, setelah itu...
Dialogue: 0,0:16:30.88,0:16:34.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mukanya merengut lagi terus bilang,\N"Kamu bodoh, ya?"
Dialogue: 0,0:16:34.89,0:16:36.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, benar!
Dialogue: 0,0:16:36.56,0:16:39.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus. Kamu bisa lulus\Nujian Siesta tingkat satu.
Dialogue: 0,0:16:41.35,0:16:42.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dipikir-pikir...
Dialogue: 0,0:16:42.77,0:16:46.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kimizuka terlihat senang sekali\Nsaat membicarakan Siesta.
Dialogue: 0,0:16:47.94,0:16:52.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kimizuka cuma butuh Siesta, 'kan.
Dialogue: 0,0:16:53.61,0:16:55.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan dipikirkan.
Dialogue: 0,0:16:55.28,0:16:58.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebelum bertemu Siesta,\Naku sendirian.
Dialogue: 0,0:16:59.58,0:17:02.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu baik, deh, Kimizuka.
Dialogue: 0,0:17:03.00,0:17:05.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi tetap tidak bisa.
Dialogue: 0,0:17:05.63,0:17:08.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bicara dengan teman di kelas,
Dialogue: 0,0:17:08.51,0:17:10.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dihibur oleh Kimizuka begini pun,
Dialogue: 0,0:17:11.26,0:17:14.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pemandangan itu tetap\Nmenghantui pikiranku.
Dialogue: 0,0:17:14.64,0:17:17.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, bukan cuma Siesta.
Dialogue: 0,0:17:18.39,0:17:19.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf lama.
Dialogue: 0,0:17:18.39,0:17:23.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku membunuh orang-orang\Ntak berdosa dengan tanganku...
Dialogue: 0,0:17:20.00,0:17:21.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo? Nagi mana?
Dialogue: 0,0:17:21.69,0:17:24.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pulang duluan.
Dialogue: 0,0:17:31.86,0:17:33.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suram.
Dialogue: 0,0:17:33.20,0:17:34.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-A-A-Apa...
Dialogue: 0,0:17:36.11,0:17:37.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengar, Natsunagi.
Dialogue: 0,0:17:37.70,0:17:40.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini masih giliranku buat marah, tahu!
Dialogue: 0,0:17:40.91,0:17:43.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini fetismu, 'kan?
Dialogue: 0,0:17:43.58,0:17:46.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Ba-Ba-Bantai!
Dialogue: 0,0:17:48.04,0:17:49.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dulu...
Dialogue: 0,0:17:50.13,0:17:54.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat aku terpuruk dan sedih...
Dialogue: 0,0:17:54.47,0:17:57.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siesta menabok punggungku.
Dialogue: 0,0:17:57.89,0:18:01.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku juga bisa menabok\Npunggung orang kapan pun,
Dialogue: 0,0:18:01.97,0:18:03.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bahkan menggenggam\Ntangan mereka.
Dialogue: 0,0:18:05.56,0:18:09.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kamu mengelus punggungku\Ndengan jarimu, lo?
Dialogue: 0,0:18:09.77,0:18:12.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersedihlah sepuasmu sekarang.
Dialogue: 0,0:18:12.57,0:18:16.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu boleh beli makanan\Npesan antar sepuasmu.
Dialogue: 0,0:18:16.35,0:18:20.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu juga boleh memaki segala\Nketidakadilan yang menyebalkan.
Dialogue: 0,0:18:21.08,0:18:24.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika itu tidak mengurangi\Nrasa bersalahmu,
Dialogue: 0,0:18:24.42,0:18:26.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan ikut memikul setengahnya.
Dialogue: 0,0:18:26.48,0:18:29.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat itu, aku juga tak bisa\Nmenyelamatkan Siesta.
Dialogue: 0,0:18:30.21,0:18:33.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, setidaknya aku bersedia
Dialogue: 0,0:18:33.97,0:18:35.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menerima rasa sakitmu.
Dialogue: 0,0:18:36.68,0:18:38.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kimizuka...
Dialogue: 0,0:18:38.76,0:18:41.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, tapi...
Dialogue: 0,0:18:41.22,0:18:45.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya aku tak bisa kabur lagi\Nkalau mengatakan itu.
Dialogue: 0,0:18:45.93,0:18:48.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku terbiasa ditindas perempuan.
Dialogue: 0,0:18:53.78,0:18:58.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Kenapa tiba-tiba\Nadu pengakuan fetis?
Dialogue: 0,0:18:58.37,0:19:01.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau ini! Aku ini berusaha menghiburmu!
Dialogue: 0,0:19:01.24,0:19:04.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Caramu menghiburku dengan\Nmengaku sebagai masokhis.
Dialogue: 0,0:19:04.62,0:19:08.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Stres. Ternyata Kimizuka stres banget.
Dialogue: 0,0:19:08.62,0:19:10.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tadi bohong.
Dialogue: 0,0:19:10.50,0:19:12.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma mencoba\Nmembuatmu tertawa,
Dialogue: 0,0:19:12.92,0:19:15.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tidak punya fetis semacam itu!
Dialogue: 0,0:19:19.01,0:19:20.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bodoh, ah.
Dialogue: 0,0:19:22.55,0:19:24.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu benar-benar bodoh.
Dialogue: 0,0:19:26.77,0:19:28.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa coba?
Dialogue: 0,0:19:31.48,0:19:34.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah lama menahannya, ya.
Dialogue: 0,0:19:51.00,0:19:53.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, setelah Kimizuka puas menangis...
Dialogue: 0,0:19:53.96,0:19:57.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita bahas soal permainan\Nmencari kesalahan dari Noches.
Dialogue: 0,0:19:57.61,0:20:00.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu punya petunjuk, Kimizuka?
Dialogue: 0,0:20:00.35,0:20:02.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, sama sekali.
Dialogue: 0,0:20:02.76,0:20:03.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya saja...
Dialogue: 0,0:20:04.18,0:20:05.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebelum mati,
Dialogue: 0,0:20:05.98,0:20:09.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siesta bilang pada kita kalau\Nmasa lalu itu adalah kebenaran.
Dialogue: 0,0:20:09.60,0:20:12.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, dia tetap bilang\Nada kesalahan di sana.
Dialogue: 0,0:20:13.13,0:20:18.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu berarti Siesta saat masih hidup\Nmelakukan kesalahan.
Dialogue: 0,0:20:18.49,0:20:22.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi memang Siesta bisa\Nmelakukan kesalahan begitu?
Dialogue: 0,0:20:22.99,0:20:24.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:20:24.45,0:20:29.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin lebih cepat tanya\Nke orang terkait.
Dialogue: 0,0:20:29.54,0:20:34.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain aku, Siesta, dan Natsunagi,\Nsiapa lagi yang bisa ditanya?
Dialogue: 0,0:20:34.25,0:20:38.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Char tidak mengatakan sesuatu saat itu
Dialogue: 0,0:20:38.51,0:20:40.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin karena dia\Ntidak punya petunjuk.
Dialogue: 0,0:20:40.55,0:20:42.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau musuh?
Dialogue: 0,0:20:42.26,0:20:44.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}SPES, ya?
Dialogue: 0,0:20:44.08,0:20:47.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, yang bisa diajak bicara...
Dialogue: 0,0:20:53.27,0:20:54.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hel.
Dialogue: 0,0:20:55.61,0:20:59.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, Siesta sudah menyegel\NHel dalam diriku, 'kan?
Dialogue: 0,0:20:59.90,0:21:01.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau memanggilnya?
Dialogue: 0,0:21:02.07,0:21:04.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siesta menyegelnya jadi sia-sia...
Dialogue: 0,0:21:04.62,0:21:05.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu tahun.
Dialogue: 0,0:21:07.33,0:21:10.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siesta menghabiskan satu tahun\Nuntuk membujuknya.
Dialogue: 0,0:21:10.87,0:21:12.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti tidak apa-apa.
Dialogue: 0,0:21:13.29,0:21:16.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi bagaimana caranya...
Dialogue: 0,0:21:16.33,0:21:18.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah mendengar cerita kalian.
Dialogue: 0,0:21:19.17,0:21:23.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan padaku\Nkalau mau memanggil Hel.
Dialogue: 0,0:21:24.63,0:21:27.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kenapa harus di rumahku?
Dialogue: 0,0:21:27.35,0:21:32.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini tempat paling dekat yang aman\Nkalau berisik.
Dialogue: 0,0:21:32.06,0:21:35.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemiliknya tidak bilang\Nkalian boleh berisik.
Dialogue: 0,0:21:37.36,0:21:42.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, memang boleh detektif\Nminta bantuan kliennya?
Dialogue: 0,0:21:42.45,0:21:45.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kimihiko memang bodoh, ya.
Dialogue: 0,0:21:45.70,0:21:48.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Siesta pasti bilang begini, 'kan?
Dialogue: 0,0:21:48.58,0:21:52.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lakukan apa saja untuk\Nmelindungi kepentingan klien.
Dialogue: 0,0:21:54.00,0:21:56.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:21:58.46,0:22:00.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Noches.
Dialogue: 0,0:22:00.21,0:22:05.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana caranya aku\Nbertemu Hel, diriku yang lain?
Dialogue: 0,0:22:09.35,0:22:12.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan memanggil Hel\Ndi dalam cermin itu.
Dialogue: 0,0:22:16.02,0:22:21.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bawalah ini dan tataplah dirimu\Ndalam cermin.
Dialogue: 0,0:22:21.28,0:22:22.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cermin berhadapan?
Dialogue: 0,0:22:22.90,0:22:26.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada sebuah rumor\Ntentang cermin berhadapan.
Dialogue: 0,0:22:26.16,0:22:29.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Konon, cermin itu bisa memanggil iblis.
Dialogue: 0,0:22:29.58,0:22:33.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Konon, cermin itu dapat menunjukkan\Nmasa lalu dan masa depan.
Dialogue: 0,0:22:34.00,0:22:36.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini tidak sulit.
Dialogue: 0,0:22:36.04,0:22:38.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama kamu ingin bertemu dia,
Dialogue: 0,0:22:38.63,0:22:42.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan sedikit pemicu,\Nkamu pasti bisa bertemu Hel.
Dialogue: 0,0:22:42.38,0:22:47.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kamu cukup menatap\Nke cermin saja, Nagisa.
Dialogue: 0,0:23:20.25,0:23:21.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Natsunagi?
Dialogue: 0,0:23:24.50,0:23:26.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lama tidak bertemu.
Dialogue: 0,0:23:32.18,0:23:34.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan.
