Dialogue: 0,0:00:42.65,0:00:50.32,sign,,0000,0000,0000,,SASAKI DAN PIPI S2
Dialogue: 0,0:02:01.98,0:02:06.27,sign,,0000,0000,0000,,EPISODE 6: PERJAMUAN DAN HUBUNGAN
Dialogue: 0,0:02:58.53,0:03:00.54,sign,,0000,0000,0000,,TOLONG JANGAN BERI MAKAN DAGING\NKE GELATIK JAWA
Dialogue: 0,0:03:00.54,0:03:06.37,sign,,0000,0000,0000,,YANG BUKAN REINKARNASI MAHARDIKA!
Dialogue: 0,0:21:51.46,0:21:53.42,sign,,0000,0000,0000,,PANGGILAN - FUTARI SHIZUKA
Dialogue: 0,0:00:12.95,0:00:15.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkat akomodasi Futari Shizuka,
Dialogue: 0,0:00:15.33,0:00:18.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami bisa mengadakan\Npesta penyambutan Nona Elsa.
Dialogue: 0,0:00:18.37,0:00:23.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, untuk merayakan\Nkedatangan tamu yang langka...
Dialogue: 0,0:00:23.34,0:00:27.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersulang!
Dialogue: 0,0:00:30.13,0:00:31.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersulang!
Dialogue: 0,0:02:06.67,0:02:10.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kepiting yang gurih\Ndan manisnya bulu babi segar.
Dialogue: 0,0:02:10.82,0:02:14.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ditambah sentuhan elegan dari kaviar.
Dialogue: 0,0:02:14.74,0:02:19.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana?\NBanyak hidangan lezat, kan?
Dialogue: 0,0:02:19.37,0:02:22.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, mantap.
Dialogue: 0,0:02:22.08,0:02:24.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, bagus.
Dialogue: 0,0:02:26.00,0:02:28.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana, Nona Elsa?
Dialogue: 0,0:02:29.92,0:02:33.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Budaya kuliner di dunia ini juga maju, ya!
Dialogue: 0,0:02:33.63,0:02:38.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya enak, terlihat cantik,\Nsungguh luar biasa!
Dialogue: 0,0:02:38.35,0:02:40.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senang mendengarnya.
Dialogue: 0,0:02:41.47,0:02:44.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, dia bilang apa?
Dialogue: 0,0:02:44.52,0:02:47.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Elsa sangat senang.
Dialogue: 0,0:02:47.65,0:02:50.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, syukurlah.
Dialogue: 0,0:02:50.94,0:02:54.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sungkan,\Nmakanlah sampai pingsan.
Dialogue: 0,0:02:55.31,0:02:56.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:03:00.54,0:03:04.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gelatik jawa itu sudah gila, ya?
Dialogue: 0,0:03:04.25,0:03:06.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, dia masih normal.
Dialogue: 0,0:03:07.97,0:03:09.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak! Ini enak banget!
Dialogue: 0,0:03:09.88,0:03:13.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kematangan dan takaran garam sempurna\Nmenonjolkan pesona chateaubriand-nya.
Dialogue: 0,0:03:13.84,0:03:17.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa sangka kamu bisa\Nmenyajikan hidangan ini!
Dialogue: 0,0:03:17.55,0:03:20.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu boleh juga.
Dialogue: 0,0:03:20.89,0:03:24.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu memujiku cuma karena ini?
Dialogue: 0,0:03:24.85,0:03:26.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada saus di wajahmu, tuh.
Dialogue: 0,0:03:28.81,0:03:30.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Imutnya...
Dialogue: 0,0:03:32.82,0:03:35.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dagingnya seenak itu?
Dialogue: 0,0:03:35.57,0:03:36.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:03:36.36,0:03:38.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namanya chateaubriand.
Dialogue: 0,0:03:38.20,0:03:41.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harta karun dunia ini\Nyang setara dengan internet.
Dialogue: 0,0:03:48.49,0:03:52.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya kamu tahu cita rasa ini.
Dialogue: 0,0:03:52.00,0:03:54.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada jalan kembali.
Dialogue: 0,0:03:56.34,0:04:01.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hidangan ini dinikmati dengan cara\Nmencelupkan makanan ke aliran cokelat.
Dialogue: 0,0:04:01.43,0:04:04.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, menarik juga!
Dialogue: 0,0:04:14.44,0:04:18.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}E-Enak banget!
Dialogue: 0,0:04:21.82,0:04:26.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, berteman denganku\Nbanyak untungnya, kan?
Dialogue: 0,0:04:26.87,0:04:31.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau menjalin kepercayaan\Nsedikit lebih dalam?
Dialogue: 0,0:04:31.93,0:04:33.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maumu?
Dialogue: 0,0:04:33.42,0:04:34.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kutukan itu.
Dialogue: 0,0:04:35.38,0:04:37.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong hapus itu sekarang.
Dialogue: 0,0:04:37.97,0:04:39.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mau.
Dialogue: 0,0:04:40.07,0:04:42.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba ingat-ingat saja\Ntingkahmu di masa lalu.
Dialogue: 0,0:04:42.97,0:04:47.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cih, gelatik jawa ini\Nmasih saja ketus padaku!
Dialogue: 0,0:04:48.68,0:04:51.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sate "burung" ini enak banget!
Dialogue: 0,0:04:51.31,0:04:53.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagian ini juga enak!
Dialogue: 0,0:04:53.65,0:04:55.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sate "burung" memang enak!
Dialogue: 0,0:04:55.94,0:04:58.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kutukannya nanti berkembang, lo.
Dialogue: 0,0:05:02.62,0:05:05.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senang melihatmu makan dengan lahap.
Dialogue: 0,0:05:05.79,0:05:08.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sini, biar Nenek kupaskan\Nkepiting untukmu.
Dialogue: 0,0:05:10.50,0:05:11.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nih.
Dialogue: 0,0:05:11.42,0:05:13.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih!
Dialogue: 0,0:05:16.30,0:05:18.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kepiting cokelat!
Dialogue: 0,0:05:20.13,0:05:22.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya cocok?
Dialogue: 0,0:05:24.43,0:05:27.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perang proksi malaikat dan iblis, ya.
Dialogue: 0,0:05:27.39,0:05:29.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cukup menarik.
Dialogue: 0,0:05:29.52,0:05:32.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang jelas, untung kamu baik-baik saja.
Dialogue: 0,0:05:32.73,0:05:34.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Pipi.
Dialogue: 0,0:05:34.86,0:05:36.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, itu apa?
Dialogue: 0,0:05:36.73,0:05:41.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, ini sake Jepang.\NAlkohol yang dibuat dari beras.
Dialogue: 0,0:05:41.61,0:05:42.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau coba?
Dialogue: 0,0:05:47.45,0:05:51.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, ini enak!\NSegar dan ringan diminum.
Dialogue: 0,0:05:51.66,0:05:53.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah.
Dialogue: 0,0:05:53.37,0:05:58.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minum sake bersama Pipi begini\Nterasa baru dan menyenangkan.
Dialogue: 0,0:06:02.93,0:06:05.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berguna banget.
Dialogue: 0,0:06:05.30,0:06:08.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini pertama kalinya\Naku memakainya seperti ini.
Dialogue: 0,0:06:09.10,0:06:11.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya.
Dialogue: 0,0:06:11.52,0:06:13.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah larut.
Dialogue: 0,0:06:13.31,0:06:17.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebelum mabuk dan tidak bisa bergerak,\Naku harus pergi ke dunia sana.
Dialogue: 0,0:06:18.94,0:06:22.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Internet itu bagus, lo.
Dialogue: 0,0:06:22.07,0:06:23.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, Pipi.
Dialogue: 0,0:06:24.24,0:06:27.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal agenda dunia lain hari ini...
Dialogue: 0,0:06:27.53,0:06:30.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, bisa tunggu sebentar?
Dialogue: 0,0:06:30.75,0:06:34.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sedang menjelaskan\Nkehebatan internet ke anak ini.
Dialogue: 0,0:06:34.50,0:06:37.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Boleh saja, sih.
Dialogue: 0,0:06:37.59,0:06:39.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu akan kupanggil setelah selesai.
Dialogue: 0,0:06:39.71,0:06:40.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke.
Dialogue: 0,0:06:41.80,0:06:46.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Internet berguna untuk banyak hal\Nselain menonton sandiwara.
Dialogue: 0,0:06:47.43,0:06:50.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa buka peta, bisa untuk belanja.
Dialogue: 0,0:06:50.39,0:06:52.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah.
Dialogue: 0,0:06:52.10,0:06:56.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, bisa juga merekam video\Nyang kamu ambil sendiri.
Dialogue: 0,0:06:56.56,0:06:58.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Halo!\N- Itu juga bisa?
Dialogue: 0,0:06:58.36,0:07:01.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Utangku tambah banyak!
Dialogue: 0,0:07:01.15,0:07:03.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bokek!
Dialogue: 0,0:07:03.32,0:07:07.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Eh? Siapa pria ini?\N- Orang yang punya utang 100 juta yen
Dialogue: 0,0:07:07.03,0:07:10.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- boleh pakai fasilitas umum, tidak?\N- Sepertinya dia sedang stres
Dialogue: 0,0:07:10.12,0:07:10.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Boleh minum air di taman?\N- karena banyak utang.
Dialogue: 0,0:07:10.99,0:07:12.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Boleh minum air di taman?\N- Kasihan, ya.
Dialogue: 0,0:07:12.50,0:07:15.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Orang yang punya utang ratusan juta\N- Oh, iya, bagaimana kalau kita
Dialogue: 0,0:07:15.58,0:07:17.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- tidak berhak minum-minum, kan?\N- merekam video untuk Julius?
Dialogue: 0,0:07:17.17,0:07:17.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo!
Dialogue: 0,0:07:17.96,0:07:19.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong rekam aku!
Dialogue: 0,0:07:19.96,0:07:23.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa saja, pinjam uang!
Dialogue: 0,0:07:26.85,0:07:28.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat juga.
Dialogue: 0,0:07:28.26,0:07:30.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kebetulan lagi seru-serunya.
Dialogue: 0,0:07:31.01,0:07:32.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:07:32.64,0:07:36.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Temani aku minum sebentar.
Dialogue: 0,0:07:36.31,0:07:39.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong jangan banyak-banyak.
Dialogue: 0,0:07:41.18,0:07:43.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang.
Dialogue: 0,0:07:44.82,0:07:46.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini pasti dipaksa minum.
Dialogue: 0,0:07:47.20,0:07:51.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, nanti juga Pipi memanggilku.
Dialogue: 0,0:07:51.81,0:07:55.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku nikmati saja minumannya, deh.
Dialogue: 0,0:07:59.04,0:08:03.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, kamu bisa mengeluarkan\Nbanyak hal selain api, kan?
Dialogue: 0,0:08:04.84,0:08:06.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, begitulah.
Dialogue: 0,0:08:06.72,0:08:09.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa bikin oplosan?
Dialogue: 0,0:08:09.89,0:08:13.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku tidak tahu air ini\Nbisa diminum atau tidak, lo.
Dialogue: 0,0:08:19.65,0:08:21.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh juga!
Dialogue: 0,0:08:21.19,0:08:22.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:08:22.58,0:08:24.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, lanjut!
Dialogue: 0,0:08:24.32,0:08:25.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:08:31.66,0:08:33.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak, enak.
Dialogue: 0,0:08:33.53,0:08:34.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:08:34.99,0:08:37.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu ronde lagi!
Dialogue: 0,0:08:37.08,0:08:38.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:08:38.12,0:08:41.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aman, nanti Pipi membangunkanku.
Dialogue: 0,0:08:44.16,0:08:47.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aman, ada Pipi.
Dialogue: 0,0:08:47.59,0:08:50.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada Pipi, kok.
Dialogue: 0,0:08:51.30,0:08:54.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pipi imut!
Dialogue: 0,0:08:54.56,0:08:56.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aman!
Dialogue: 0,0:09:01.84,0:09:05.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa? Sudah menyerah?
Dialogue: 0,0:09:06.65,0:09:10.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, satu ronde lagi!
Dialogue: 0,0:09:10.49,0:09:13.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku istirahat dulu.
Dialogue: 0,0:09:14.70,0:09:19.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yakin mau lengah di depanku?
Dialogue: 0,0:09:21.31,0:09:25.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa-bisa aku membuat\Ntuduhan yang tidak-tidak, lo.
Dialogue: 0,0:09:25.63,0:09:28.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan asal bicara.
Dialogue: 0,0:09:28.51,0:09:30.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nih.
Dialogue: 0,0:09:33.05,0:09:36.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Serius mau tidur?
Dialogue: 0,0:09:43.27,0:09:44.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serius?
Dialogue: 0,0:09:51.79,0:09:55.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pipi! Pipi! Bangun!
Dialogue: 0,0:09:57.83,0:09:59.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maaf!
Dialogue: 0,0:09:59.62,0:10:03.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bodohnya aku terlena alkohol!
Dialogue: 0,0:10:03.54,0:10:06.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.\NAku juga sama, kok.
Dialogue: 0,0:10:06.85,0:10:09.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sungguh minta maaf.
Dialogue: 0,0:10:09.38,0:10:13.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu malam yang berharga\Nterbuang sia-sia karena salahku.
Dialogue: 0,0:10:15.22,0:10:18.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, aku juga minta maaf\Nterlalu mengandalkanmu.
Dialogue: 0,0:10:18.85,0:10:21.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, setelah ini...
Dialogue: 0,0:10:22.94,0:10:26.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menitipkan Futari Shizuka\Ndan Nona Elsa ke Pipi,
Dialogue: 0,0:10:26.94,0:10:28.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu bergegas ke kantor.
Dialogue: 0,0:10:29.51,0:10:32.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga harus pergi\Nke dunia lain malam ini.
Dialogue: 0,0:10:38.77,0:10:39.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sasaki.
Dialogue: 0,0:10:40.95,0:10:43.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat pagi, Hoshizaki.
Dialogue: 0,0:10:43.66,0:10:47.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memeriksa riwayat\Nlokasi perangkatmu.
Dialogue: 0,0:10:47.30,0:10:51.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemarin, kamu berkeliling\Ndi sekitar sekolahku, kan?
Dialogue: 0,0:10:51.05,0:10:54.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Ah, iya...
Dialogue: 0,0:10:54.51,0:10:56.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam rangka apa?
Dialogue: 0,0:10:56.26,0:10:59.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eng, soal itu...
Dialogue: 0,0:11:01.39,0:11:02.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu...
Dialogue: 0,0:11:02.52,0:11:05.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu memeriksa riwayatku?
Dialogue: 0,0:11:06.35,0:11:08.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Te-Terserah aku, dong!
Dialogue: 0,0:11:08.81,0:11:11.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jawab dulu pertanyaanku!
Dialogue: 0,0:11:11.86,0:11:14.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Jangan bilang kamu menguntitku—\N- Selamat pagi, Sasaki.
Dialogue: 0,0:11:15.28,0:11:18.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, selamat pagi, Pak Kabag.
Dialogue: 0,0:11:18.03,0:11:21.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kebetulan saya mau melapor.
Dialogue: 0,0:11:21.33,0:11:22.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melapor?
Dialogue: 0,0:11:23.33,0:11:25.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentang kejadian kemarin.
Dialogue: 0,0:11:25.41,0:11:29.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma melaporkan info\Nseminimal mungkin ke Kabag Akutsu.
Dialogue: 0,0:11:29.51,0:11:32.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja, tetanggaku\Ndan Abaddon tidak kusebut.
Dialogue: 0,0:11:33.21,0:11:37.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan menciptakan\Nruang khusus, ya.
Dialogue: 0,0:11:37.38,0:11:42.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk sekarang, aku ingin kamu\Nmenulis laporan soal kasus ini.
Dialogue: 0,0:11:42.35,0:11:45.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya cara penyelidikan\Njuga perlu ditinjau kembali.
Dialogue: 0,0:11:45.94,0:11:47.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:11:50.27,0:11:51.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong...
Dialogue: 0,0:11:52.61,0:11:56.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hoshizaki, tadi kamu mau bilang apa?
Dialogue: 0,0:11:56.28,0:11:57.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi?
Dialogue: 0,0:11:57.49,0:11:59.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebelum rapat dimulai.
Dialogue: 0,0:11:59.57,0:12:03.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau perlu, aku pesankan\Nulang ruang rapatnya.
Dialogue: 0,0:12:04.97,0:12:08.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu-Bukan apa-apa!\NLupakan saja!
Dialogue: 0,0:12:08.92,0:12:10.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh?
Dialogue: 0,0:12:10.29,0:12:11.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:12:11.38,0:12:12.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan apa-apa!
Dialogue: 0,0:12:12.84,0:12:15.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}O-Oh.
Dialogue: 0,0:12:17.09,0:12:18.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai jumpa!
Dialogue: 0,0:12:18.01,0:12:20.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Papa jaga kesehatan juga, ya!
Dialogue: 0,0:12:22.71,0:12:25.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata alat semacam ini\Nbenar-benar ada, ya.
Dialogue: 0,0:12:26.56,0:12:30.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya, saya bawakan ini lebih cepat.
Dialogue: 0,0:12:30.56,0:12:33.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf jadi harus menunggu lama.
Dialogue: 0,0:12:33.65,0:12:38.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus terang saja,\Nsemalam saya kebanyakan minum.
Dialogue: 0,0:12:39.58,0:12:41.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:12:41.87,0:12:43.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini kesalahanku.
Dialogue: 0,0:12:44.10,0:12:49.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, aku sangat bersyukur\Nbisa melihat putriku.
Dialogue: 0,0:12:49.92,0:12:53.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Sasaki, bisakah pesan video ini
Dialogue: 0,0:12:53.96,0:12:57.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menampilkan diriku juga?
Dialogue: 0,0:12:57.05,0:13:00.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja, biar saya siapkan.
Dialogue: 0,0:13:00.18,0:13:01.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, tidak usah.
Dialogue: 0,0:13:01.79,0:13:04.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku minta lain kali saja.
Dialogue: 0,0:13:05.29,0:13:09.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, ada hal yang ingin\Nsegera kusampaikan pada kalian.
Dialogue: 0,0:13:20.24,0:13:25.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seingatku, pekerjaan konstruksi\Nbaru dipesan dua bulan di dunia ini.
Dialogue: 0,0:13:25.49,0:13:28.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal ini mau dijadikan alasan\Nuntuk mengurung diri
Dialogue: 0,0:13:28.58,0:13:30.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di wilayah kekuasaanku selama\Nbeberapa tahun ke depan.
Dialogue: 0,0:13:35.71,0:13:40.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah Marc yang memerintah di lokasi?
Dialogue: 0,0:13:40.84,0:13:44.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, dia yang memimpin\Nkeseluruhan proyek ini.
Dialogue: 0,0:13:44.85,0:13:47.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, dia sibuk akhir-akhir ini.
Dialogue: 0,0:13:47.14,0:13:50.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Koordinator para pekerja di sini\Njadinya orang lain.
Dialogue: 0,0:13:50.73,0:13:52.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang lain?
Dialogue: 0,0:13:58.73,0:14:01.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi.
Dialogue: 0,0:14:01.07,0:14:02.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan!
Dialogue: 0,0:14:02.53,0:14:04.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}French?
Dialogue: 0,0:14:04.07,0:14:05.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok kamu di sini?
Dialogue: 0,0:14:06.09,0:14:10.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata Tuan datang.\NTuan pernah bilang, kan?
Dialogue: 0,0:14:10.91,0:14:14.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan ada konstruksi penting\Ndi kawasan ini.
Dialogue: 0,0:14:14.08,0:14:16.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya, sih.
Dialogue: 0,0:14:16.00,0:14:20.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}French memang kenal dengan Marc
Dialogue: 0,0:14:20.34,0:14:22.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan sempat mengobrol sedikit.
Dialogue: 0,0:14:22.30,0:14:23.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah itu,
Dialogue: 0,0:14:23.97,0:14:28.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku selalu gemas ingin membantu Tuan\Nsebanyak mungkin.
Dialogue: 0,0:14:29.29,0:14:34.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah ada junior yang bisa mengurus kedai,\Njadi aku membantu di sini.
Dialogue: 0,0:14:34.27,0:14:37.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak Tuan French andil,
Dialogue: 0,0:14:37.23,0:14:40.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}para langganan kedai pun\Nikut membantu.
Dialogue: 0,0:14:40.82,0:14:42.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para langganan?
Dialogue: 0,0:14:44.20,0:14:46.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, French.
Dialogue: 0,0:14:46.37,0:14:49.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar Baron Sasaki datang.
Dialogue: 0,0:14:49.16,0:14:50.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya?
Dialogue: 0,0:14:50.47,0:14:54.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari penampilan itu,\Nkamu pasti Baron Sasaki.
Dialogue: 0,0:14:54.29,0:14:58.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tu-Tunggu, mereka adalah bangsawan.
Dialogue: 0,0:14:58.54,0:14:59.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong...
Dialogue: 0,0:15:00.22,0:15:03.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salam kenal, aku Sasaki.
Dialogue: 0,0:15:09.22,0:15:10.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana?
Dialogue: 0,0:15:10.43,0:15:12.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lokasi kerjanya lumayan bagus, kan?
Dialogue: 0,0:15:12.52,0:15:15.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak perajin andal juga, lo.
Dialogue: 0,0:15:20.19,0:15:23.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah dengar tentang kalian.
Dialogue: 0,0:15:23.15,0:15:28.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah bersedia datang\Nke tempat terpencil ini.
Dialogue: 0,0:15:28.49,0:15:32.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon kerja samanya.
Dialogue: 0,0:15:32.74,0:15:35.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti yang terlihat,\Naku ini orang asing.
Dialogue: 0,0:15:35.69,0:15:40.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada dasarnya, ini tanah milik kalian,\Npenduduk Kerajaan Hertz.
Dialogue: 0,0:15:40.75,0:15:44.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski tanah ini sudah dianugerahkan\Nsebagai wilayah Baron Sasaki,
Dialogue: 0,0:15:44.21,0:15:48.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku cuma meminjam tanah kalian.
Dialogue: 0,0:15:49.01,0:15:51.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu serius mengatakan itu?
Dialogue: 0,0:15:51.55,0:15:52.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:15:52.64,0:15:56.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, French adalah teman baikku.
Dialogue: 0,0:15:56.60,0:15:59.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena telah berbaik hati padanya,
Dialogue: 0,0:15:59.98,0:16:02.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalian termasuk teman\Nyang wajib kusambut juga.
Dialogue: 0,0:16:03.13,0:16:07.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bukan di kondisi formal,\Ntidak perlu merasa sungkan.
Dialogue: 0,0:16:07.86,0:16:12.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau diperlakukan lebih santai,\Nmungkin kerjaan mereka bisa melambat.
Dialogue: 0,0:16:13.39,0:16:15.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata French benar!
Dialogue: 0,0:16:15.70,0:16:20.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Su-Sudah kubilang, kan?\NTuan itu berhati lapang.
Dialogue: 0,0:16:20.63,0:16:23.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Tunggu.
Dialogue: 0,0:16:25.59,0:16:28.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon maaf atas kelancangan kami!
Dialogue: 0,0:16:28.55,0:16:30.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon maaf!
Dialogue: 0,0:16:30.05,0:16:31.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:16:32.10,0:16:35.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bekerja di bidang konstruksi.
Dialogue: 0,0:16:35.60,0:16:39.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dan French jadi akrab\Nkarena sering mampir ke kedainya.
Dialogue: 0,0:16:39.98,0:16:42.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, tiba-tiba French bilang
Dialogue: 0,0:16:42.98,0:16:47.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mau membantu membangun benteng\Nuntuk penyelamat nyawanya.
Dialogue: 0,0:16:48.50,0:16:51.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami khawatir dia ditipu.
Dialogue: 0,0:16:52.20,0:16:55.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi tampaknya kami salah.
Dialogue: 0,0:16:55.91,0:16:59.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang kami bisa\Nbekerja dengan fokus!
Dialogue: 0,0:16:59.29,0:17:02.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelan-pelan saja.
Dialogue: 0,0:17:02.50,0:17:05.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pendanaannya akan kuusahakan,
Dialogue: 0,0:17:05.08,0:17:08.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}silakan bangun benteng\Nyang bagus pelan-pelan.
Dialogue: 0,0:17:08.81,0:17:10.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu dengar itu?
Dialogue: 0,0:17:10.43,0:17:14.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baron Sasaki sangat berjiwa kesatria!
Dialogue: 0,0:17:14.22,0:17:15.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sip!
Dialogue: 0,0:17:15.56,0:17:17.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus bangun benteng yang bagus!
Dialogue: 0,0:17:22.01,0:17:24.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf sudah merepotkan.
Dialogue: 0,0:17:24.98,0:17:26.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja tidak.
Dialogue: 0,0:17:26.90,0:17:30.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}French mengurus semuanya di lokasi.
Dialogue: 0,0:17:33.53,0:17:35.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf lama.
Dialogue: 0,0:17:35.24,0:17:38.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengenai pembayaran kali ini,\Nbagaimana kalau seperti ini?
Dialogue: 0,0:17:38.79,0:17:41.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk pembayaran kali ini,
Dialogue: 0,0:17:41.00,0:17:45.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisakah semuanya dialokasikan\Nuntuk pembangunan benteng?
Dialogue: 0,0:17:46.96,0:17:48.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan yakin?
Dialogue: 0,0:17:48.84,0:17:51.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena sudah lepas tangan ke kalian,
Dialogue: 0,0:17:51.51,0:17:55.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}setidaknya saya ingin memastikan\Npendanaannya lancar jaya.
Dialogue: 0,0:17:56.93,0:17:58.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:17:58.43,0:18:02.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau itu kehendak Tuan,\Nsaya simpan pembayaran penuhnya.
Dialogue: 0,0:18:02.90,0:18:05.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak, Sasaki.
Dialogue: 0,0:18:08.37,0:18:13.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah menyelesaikan transaksi\Ndengan Joseph dan kembali ke Beitrium,
Dialogue: 0,0:18:13.03,0:18:17.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami mendatangi Count Müller\Nyang bilang ada urusan mendesak.
Dialogue: 0,0:18:18.38,0:18:21.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi...
Dialogue: 0,0:18:21.41,0:18:22.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Sasaki.
Dialogue: 0,0:18:22.87,0:18:27.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beliau Viscount Ohm yang datang\Nsebagai utusan Duke Einhart.
Dialogue: 0,0:18:33.47,0:18:40.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengenai pembangunan benteng,\NDuke Einhart mengakui upayamu.
Dialogue: 0,0:18:40.56,0:18:43.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oleh karena itu, sebagai penggagas,
Dialogue: 0,0:18:43.60,0:18:48.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}beliau berbelas kasih memberikan\Nbantuan atas kinerja Baron.
Dialogue: 0,0:18:50.61,0:18:56.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai sesama pihak yang meyakini\NPangeran Adonis akan menjadi Raja Hertz,
Dialogue: 0,0:18:56.16,0:18:58.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}semoga Baron Sasaki memakai\Ndukungan dari Duke Einhart...
Dialogue: 0,0:18:58.95,0:19:01.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- untuk berupaya lebih keras lagi demi negara.\N- Intinya, setelah melempar pekerjaan
Dialogue: 0,0:19:01.75,0:19:03.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- untuk berupaya lebih keras lagi demi negara.\N- dan ternyata berjalan lancar,
Dialogue: 0,0:19:03.71,0:19:06.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia mau mengakuinya sebagai pencapaiannya.
Dialogue: 0,0:19:06.04,0:19:11.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya, aku sendiri yang akan\Nmemimpin langsung di lapangan.
Dialogue: 0,0:19:12.81,0:19:15.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akan merombak pekerja
Dialogue: 0,0:19:15.26,0:19:19.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan mendatangkan\Nkelompok perajin dari wilayahku.
Dialogue: 0,0:19:19.89,0:19:23.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan tukang kayu biasa\Ndari sembarang tempat.
Dialogue: 0,0:19:23.39,0:19:28.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita cuma akan memberi pekerjaan\Npada perajin yang lolos seleksi ketat.
Dialogue: 0,0:19:28.88,0:19:31.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau itu sampai terjadi...
Dialogue: 0,0:19:31.11,0:19:36.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita kerahkan pasukan zeni agar proyek\Nlebih cepat tuntas dan hasilnya lebih terjamin.
Dialogue: 0,0:19:36.74,0:19:37.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang...
Dialogue: 0,0:19:37.45,0:19:39.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon maaf.
Dialogue: 0,0:19:39.95,0:19:43.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Izinkan kami menolak tawaran itu.
Dialogue: 0,0:19:46.42,0:19:48.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa katamu?
Dialogue: 0,0:19:48.33,0:19:52.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kinerja kali ini hanyalah\Nmembangun sedikit tembok
Dialogue: 0,0:19:52.13,0:19:55.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di perbatasan dengan Kekaisaran Ohgen.
Dialogue: 0,0:19:55.05,0:19:59.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu sampai meminta\Nbantuan dari Duke Einhart.
Dialogue: 0,0:20:00.89,0:20:02.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bedebah!
Dialogue: 0,0:20:02.01,0:20:05.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mau menentang perintah Duke?
Dialogue: 0,0:20:07.44,0:20:10.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau apakah bantuan dari Duke
Dialogue: 0,0:20:10.19,0:20:13.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lebih besar dari Usaha Dagang Kepler?
Dialogue: 0,0:20:16.99,0:20:19.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Itu...
Dialogue: 0,0:20:19.47,0:20:23.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan memanfaatkan nama Joseph\Nsang direktur utama.
Dialogue: 0,0:20:24.33,0:20:28.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Walau faktanya, itu cuma\Npakai uang pribadiku dan Pipi.
Dialogue: 0,0:20:28.00,0:20:29.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja.
Dialogue: 0,0:20:29.79,0:20:31.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebelum tembok selesai dibangun,
Dialogue: 0,0:20:31.88,0:20:34.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tidak akan datang ke ibu kota.
Dialogue: 0,0:20:34.21,0:20:39.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisakah sampaikan ke Duke Einhart\Nagar memberikan pengertian
Dialogue: 0,0:20:40.26,0:20:42.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atas tindakan kami?
Dialogue: 0,0:20:48.64,0:20:52.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf sudah merepotkan.
Dialogue: 0,0:20:52.94,0:20:54.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.
Dialogue: 0,0:20:54.07,0:20:59.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hubungan dengan Duke Einhart memang penting,\Ntapi kurasa itu sudah benar.
Dialogue: 0,0:20:59.78,0:21:01.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:21:01.57,0:21:05.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, ada satu hal\Nyang ingin kusampaikan.
Dialogue: 0,0:21:05.16,0:21:06.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:21:06.33,0:21:10.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu... Bagaimana, ya...
Dialogue: 0,0:21:10.04,0:21:14.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mahardika Bintang tidak kuat\Nminum-minum alkohol.
Dialogue: 0,0:21:14.17,0:21:16.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Benarkah?
Dialogue: 0,0:21:16.00,0:21:21.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski tidak berubah setelah minum banyak,\Nterkadang dia sangat mabuk.
Dialogue: 0,0:21:21.51,0:21:25.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kadang juga ingatan sebelum\Ndan sesudah mabuknya hilang.
Dialogue: 0,0:21:25.76,0:21:27.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata begitu.
Dialogue: 0,0:21:28.18,0:21:31.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menemukan sisi lemah Pipi\Nyang tidak terduga.
Dialogue: 0,0:21:32.02,0:21:37.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena biasanya tampak sempurna,\Njustru ini membuatnya makin imut.
Dialogue: 0,0:21:46.16,0:21:47.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo, ini Sasaki...
Dialogue: 0,0:21:47.37,0:21:51.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang gelatik jawamu lakukan?
Dialogue: 0,0:21:51.96,0:21:53.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:21:53.85,0:21:58.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keseharian yang kudambakan\Nmenuju kehancuran lagi.
Dialogue: 0,0:22:00.14,0:22:03.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian benar-benar berengsek.
Dialogue: 0,0:22:05.70,0:22:08.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berengsek!
