Dialogue: 0,0:02:52.65,0:03:00.33,sign,,0000,0000,0000,,SASAKI DAN PIPI S2
Dialogue: 0,0:04:12.36,0:04:16.44,sign,,0000,0000,0000,,EPISODE 4: MALAIKAT DAN PEMUDA
Dialogue: 0,0:19:25.64,0:19:27.10,sign,,0000,0000,0000,,SIHIR BEAM
Dialogue: 0,0:00:05.90,0:00:09.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada suara musik.
Dialogue: 0,0:00:09.03,0:00:11.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu kegiatan ekskul, ya?
Dialogue: 0,0:00:11.66,0:00:14.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu ikut ekskul juga?
Dialogue: 0,0:00:16.45,0:00:18.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perang proksi malaikat dan iblis.
Dialogue: 0,0:00:19.12,0:00:21.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah ditandai Abaddon,
Dialogue: 0,0:00:21.67,0:00:26.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku menjadi Utusan-nya\Nuntuk ikut permainan maut.
Dialogue: 0,0:00:26.09,0:00:30.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak itu, iblis ini terus mengikutiku.
Dialogue: 0,0:00:30.39,0:00:35.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hal itu diperlukan demi menang\Ndi perang proksi.
Dialogue: 0,0:00:35.64,0:00:39.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan kekuatan menyerap kehidupan\Nyang Abaddon berikan,
Dialogue: 0,0:00:39.23,0:00:43.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tubuhku menjadi bugar\Nkarena gizi yang tercukupi.
Dialogue: 0,0:00:43.94,0:00:48.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, harapan seorang Utusan\Nyang mengalahkan Utusan lawan
Dialogue: 0,0:00:48.74,0:00:51.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan terwujud sebagai hadiah.
Dialogue: 0,0:00:52.20,0:00:55.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu itu tidak berjalan mulus,
Dialogue: 0,0:00:55.24,0:00:59.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi ini kesempatan emas\Nuntuk mendekati Om.
Dialogue: 0,0:01:01.37,0:01:02.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Serius?
Dialogue: 0,0:01:02.75,0:01:04.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, keren banget!
Dialogue: 0,0:01:07.63,0:01:08.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Abaddon.
Dialogue: 0,0:01:08.76,0:01:12.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya kita kedatangan\NUtusan malaikat.
Dialogue: 0,0:01:12.22,0:01:15.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sini sempit, mau ke lapangan saja?
Dialogue: 0,0:01:15.93,0:01:17.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:01:21.52,0:01:23.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Matahari senja indah, ya.
Dialogue: 0,0:01:23.77,0:01:26.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bikin pengin memandanginya\Nsampai malam datang.
Dialogue: 0,0:01:26.98,0:01:29.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iblis juga merasakan hal semacam itu?
Dialogue: 0,0:01:29.40,0:01:32.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begini, dulu aku malaikat\Nyang cinta bunga
Dialogue: 0,0:01:32.74,0:01:34.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan menyanyi di langit, lo.
Dialogue: 0,0:01:36.62,0:01:40.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu lebih cocok menuang air\Nke sarang semut.
Dialogue: 0,0:01:40.29,0:01:42.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu hobimu, kan?
Dialogue: 0,0:01:42.12,0:01:44.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan menyebarkan pola pikir anehmu, dong.
Dialogue: 0,0:01:44.88,0:01:46.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan.
Dialogue: 0,0:01:46.09,0:01:48.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, langsung saja...
Dialogue: 0,0:01:49.51,0:01:52.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita sudah terdeteksi musuh.
Dialogue: 0,0:01:54.59,0:01:58.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jumlahnya banyak sekali.\NTidak berbahaya?
Dialogue: 0,0:01:58.51,0:02:02.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin ini hasil kecolongan\Ndi insiden sebelumnya.
Dialogue: 0,0:02:02.31,0:02:06.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan,\Nkamu sedang menyalahkanku?
Dialogue: 0,0:02:06.06,0:02:08.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, aku cuma bicara fakta.
Dialogue: 0,0:02:08.94,0:02:11.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buktinya dia bawa kawan.
Dialogue: 0,0:02:11.03,0:02:12.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya?
Dialogue: 0,0:02:12.28,0:02:16.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi ini agak di luar dugaanku.
Dialogue: 0,0:02:16.24,0:02:18.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih baik kita kabur, kan?
Dialogue: 0,0:02:18.53,0:02:21.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bisa jadi salah satu pilihan.
Dialogue: 0,0:02:21.25,0:02:24.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku ingin membuat lawan\Nkewalahan dulu.
Dialogue: 0,0:02:24.96,0:02:27.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Supaya lawan segan,
Dialogue: 0,0:02:27.71,0:02:30.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}memberi peringatan di awal juga penting.
Dialogue: 0,0:02:30.88,0:02:32.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya bisa?
Dialogue: 0,0:02:32.84,0:02:35.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Percayalah padaku.
Dialogue: 0,0:02:35.51,0:02:37.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:02:38.39,0:02:41.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Abaddon, muncullah sekarang juga.
Dialogue: 0,0:04:21.32,0:04:25.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah itu, aku langsung memastikan\Nlokasi Futari Shizuka.
Dialogue: 0,0:04:25.62,0:04:29.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, sosoknya di luar sihir penghalang\Nsudah tidak ada.
Dialogue: 0,0:04:29.92,0:04:35.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa dipastikan, sihir penghalang bersinar\Nbegitu suara menghilang.
Dialogue: 0,0:04:35.25,0:04:38.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Reaksinya persis seperti\Nyang Futari Shizuka katakan.
Dialogue: 0,0:04:39.13,0:04:43.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan ini, hipotesis awalku terbukti.
Dialogue: 0,0:04:43.47,0:04:47.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemampuan supranatural misterius ini\Nbereaksi pada sihir penghalang.
Dialogue: 0,0:04:50.85,0:04:52.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Andai saja menghubungi Pipi...
Dialogue: 0,0:04:52.48,0:04:54.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eriel, muncullah.
Dialogue: 0,0:04:58.69,0:05:02.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak melihat iblis di sekitar.\NWaspadalah.
Dialogue: 0,0:05:02.11,0:05:03.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:05:04.62,0:05:08.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eriel, kenapa ada Utusan\Nberjalan seorang diri?
Dialogue: 0,0:05:08.41,0:05:12.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin terpisah dari iblisnya,\Nitu biasa terjadi.
Dialogue: 0,0:05:12.25,0:05:16.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti, kita bisa mengalahkannya?
Dialogue: 0,0:05:16.09,0:05:18.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, bisa.
Dialogue: 0,0:05:18.42,0:05:21.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mengatakan hal berbahaya!
Dialogue: 0,0:05:21.13,0:05:23.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga kita bisa menang.
Dialogue: 0,0:05:23.68,0:05:27.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau lapor ke pasukan utama,\Npasti direbut orang lain.
Dialogue: 0,0:05:27.22,0:05:30.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harapanku tidak akan pernah terkabul\Nkalau terus begitu.
Dialogue: 0,0:05:30.48,0:05:32.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harapan?
Dialogue: 0,0:05:33.15,0:05:37.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, Utusan itu akan kulenyapkan.
Dialogue: 0,0:05:37.11,0:05:39.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tu-Tunggu dulu!
Dialogue: 0,0:05:39.49,0:05:42.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa kamu salah orang!
Dialogue: 0,0:05:42.07,0:05:46.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ucapan seorang sekutu iblis\Ntidak akan mengecoh malaikat sepertiku.
Dialogue: 0,0:06:04.01,0:06:05.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eriel?
Dialogue: 0,0:06:11.81,0:06:15.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, bisa bicara sebentar?
Dialogue: 0,0:06:15.65,0:06:17.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ja-Jangan mendekat!
Dialogue: 0,0:06:17.02,0:06:19.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil malaikat kalah dari Utusan!
Dialogue: 0,0:06:19.44,0:06:20.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa kamu, Om?
Dialogue: 0,0:06:20.99,0:06:25.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa beri tahu aku apa arti "Utusan"?
Dialogue: 0,0:06:25.20,0:06:28.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Kamu Utusan iblis, kan?
Dialogue: 0,0:06:28.16,0:06:29.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sok polos!
Dialogue: 0,0:06:29.41,0:06:34.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malaikat dan iblis, Utusan,\Nlalu ruang isolasi.
Dialogue: 0,0:06:34.62,0:06:38.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu kata kunci yang kudengar\Ndi dunia tanpa orang ini.
Dialogue: 0,0:06:38.39,0:06:42.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira sumbernya adalah kekuatan\Nbocah misterius itu,
Dialogue: 0,0:06:42.38,0:06:45.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi cara berlakunya terlalu seragam.
Dialogue: 0,0:06:46.22,0:06:48.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pemilik kekuatan dari mana?
Dialogue: 0,0:06:48.93,0:06:50.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan dari biro, kan?
Dialogue: 0,0:06:50.81,0:06:52.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemilik kekuatan?
Dialogue: 0,0:06:52.39,0:06:54.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Om sinting, ya?
Dialogue: 0,0:06:54.02,0:06:56.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, tentu tidak.
Dialogue: 0,0:06:56.19,0:07:01.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira pemilik kekuatan\Nadalah kata umum yang tepat.
Dialogue: 0,0:07:01.15,0:07:04.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi pemuda ini tidak terlihat berbohong.
Dialogue: 0,0:07:04.36,0:07:09.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dunia tanpa orang ini mungkin sama\Ndengan Gadis Penyihir dan Pipi.
Dialogue: 0,0:07:10.24,0:07:13.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang pertama dari dunia peri.\NYang kedua dari dunia lain.
Dialogue: 0,0:07:13.33,0:07:16.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masing-masing punya sistem berbeda\Ndari dunia modern.
Dialogue: 0,0:07:16.62,0:07:18.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dunia penuh misteri.
Dialogue: 0,0:07:19.00,0:07:21.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau mengulur waktu?
Dialogue: 0,0:07:21.05,0:07:23.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi itu trik terakhirmu, ya?
Dialogue: 0,0:07:23.42,0:07:27.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin tanya soal malaikat,\Niblis, dan Utusan.
Dialogue: 0,0:07:27.80,0:07:30.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mendengarku, tidak?
Dialogue: 0,0:07:30.01,0:07:32.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu mau menjawab,
Dialogue: 0,0:07:32.56,0:07:34.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}luka orang itu akan kuobati.
Dialogue: 0,0:07:36.31,0:07:39.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan, kamu Utusan Abaddon?
Dialogue: 0,0:07:39.52,0:07:40.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Abaddon?
Dialogue: 0,0:07:40.86,0:07:44.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, aku tidak tahu orang\Natau organisasi semacam itu.
Dialogue: 0,0:07:44.24,0:07:45.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh?
Dialogue: 0,0:07:45.70,0:07:47.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, sungguh.
Dialogue: 0,0:07:52.08,0:07:53.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Regenerasi?
Dialogue: 0,0:07:53.74,0:07:58.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan yang dimiliki Utusan\Nsebanding dengan kekuatan iblis.
Dialogue: 0,0:07:58.04,0:08:00.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iblis yang jadi rekan orang ini
Dialogue: 0,0:08:00.46,0:08:02.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kemungkinan besar belum kalah.
Dialogue: 0,0:08:02.96,0:08:05.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus segera mundur
Dialogue: 0,0:08:05.34,0:08:09.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan lapor ke pasukan utama\Ntentang adanya musuh selain Abaddon.
Dialogue: 0,0:08:09.14,0:08:11.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus kabur?
Dialogue: 0,0:08:11.60,0:08:15.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayangnya, aku tidak bisa\Nmenghadapinya sendirian.
Dialogue: 0,0:08:15.64,0:08:18.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis itu pasang badan\Natas kehendak sendiri.
Dialogue: 0,0:08:18.69,0:08:22.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajar saja dia disebut malaikat.
Dialogue: 0,0:08:22.11,0:08:27.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saking lemahnya Eriel,\Nmelawan Utusan saja tidak bisa.
Dialogue: 0,0:08:27.03,0:08:28.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon maaf.
Dialogue: 0,0:08:28.99,0:08:32.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku tetap menyukaimu.
Dialogue: 0,0:08:32.65,0:08:35.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, nuansa komedi romantisnya\Ncukup menggemaskan.
Dialogue: 0,0:08:35.58,0:08:39.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, boleh kami pergi?
Dialogue: 0,0:08:39.62,0:08:43.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh saja, tapi beri tahu aku satu hal.
Dialogue: 0,0:08:43.96,0:08:46.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, serius?\NKamu yakin?
Dialogue: 0,0:08:46.30,0:08:50.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari yang kulihat,\Nmalaikat dan iblis berseteru
Dialogue: 0,0:08:50.47,0:08:53.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}melalui orang-orang yang disebut Utusan.
Dialogue: 0,0:08:53.26,0:08:56.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu dunia tanpa orang ini
Dialogue: 0,0:08:56.47,0:08:59.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah tempat bertarung\Nkedua belah pihak, ya?
Dialogue: 0,0:08:59.98,0:09:02.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dugaanku benar,
Dialogue: 0,0:09:02.65,0:09:05.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tolong beri tahu syarat\Nterbentuknya dunia ini.
Dialogue: 0,0:09:07.19,0:09:09.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini terjadi ketika lebih\Ndari sepuluh malaikat
Dialogue: 0,0:09:09.57,0:09:11.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan iblis berkumpul di satu tempat.
Dialogue: 0,0:09:11.91,0:09:15.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu cara kerjanya.
Dialogue: 0,0:09:15.28,0:09:19.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertarungan malaikat dan iblis\Nyang seharusnya tidak diketahui manusia.
Dialogue: 0,0:09:19.66,0:09:22.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi kami telah tanpa sadar
Dialogue: 0,0:09:22.00,0:09:26.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menghalangi upaya mereka\Nuntuk menutupi pertarungannya?
Dialogue: 0,0:09:27.38,0:09:30.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, kami akan pergi.
Dialogue: 0,0:09:58.24,0:09:59.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Abaddon!
Dialogue: 0,0:10:08.59,0:10:10.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya ampun.
Dialogue: 0,0:10:20.98,0:10:22.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:10:22.35,0:10:25.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bergerak dulu dari situ, ya.
Dialogue: 0,0:10:33.82,0:10:36.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa itu?
Dialogue: 0,0:10:54.47,0:10:58.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Merepotkan sekali\Nkalau Serafim ikut-ikutan.
Dialogue: 0,0:10:58.47,0:11:02.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kita bisa menang tanpa risiko\Nkalau terus dilanjutkan?
Dialogue: 0,0:11:02.56,0:11:06.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus mengikis malaikat tingkat rendah\Nlalu mundur dari sini.
Dialogue: 0,0:11:07.35,0:11:08.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:11:08.90,0:11:12.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, sekarang giliran kami.
Dialogue: 0,0:11:20.78,0:11:22.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dekat.
Dialogue: 0,0:11:22.08,0:11:24.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya aku enggan terlibat.
Dialogue: 0,0:11:24.37,0:11:28.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, takutnya aku terlempar\Nke dunia ini lagi.
Dialogue: 0,0:11:37.55,0:11:39.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak jadi!
Dialogue: 0,0:11:39.18,0:11:41.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau pulang saja!
Dialogue: 0,0:11:58.78,0:12:04.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Firasatku berkata,\Ntetanggaku itu Utusan iblis!
Dialogue: 0,0:12:04.08,0:12:06.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tidak ada kerjaan, nih.
Dialogue: 0,0:12:06.75,0:12:08.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sabar dan tunggu saja.
Dialogue: 0,0:12:08.83,0:12:10.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesepakatannya begitu, kan?
Dialogue: 0,0:12:10.38,0:12:15.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Tapi kita jadi tidak tahu\Nberkumpul untuk apa, kan?
Dialogue: 0,0:12:15.21,0:12:19.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul, jadi tidak semangat\Nkalau tidak ada imbalan.
Dialogue: 0,0:12:19.55,0:12:21.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Imbalan dan keinginan...
Dialogue: 0,0:12:21.60,0:12:26.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mengalahkan kubu lawan,\Nada imbalannya?
Dialogue: 0,0:12:26.43,0:12:29.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau cuma satu, kita boleh\Npakai sesuka hati di sini, kan?
Dialogue: 0,0:12:29.98,0:12:30.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, kan?
Dialogue: 0,0:12:30.98,0:12:33.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malaikat tidak mungkin\Nmenentang perintah kita.
Dialogue: 0,0:12:33.52,0:12:36.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau cepat selesaikan terus pulang.
Dialogue: 0,0:12:46.66,0:12:50.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Abaddon, bukankah repot\Nkalau tidak bisa terbang?
Dialogue: 0,0:12:50.96,0:12:54.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Percuma minta hal yang mustahil.
Dialogue: 0,0:12:54.46,0:12:58.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kita berhasil selamat,\Nberi aku hadiah bisa terbang!
Dialogue: 0,0:12:58.38,0:13:02.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, akan kupertimbangkan dengan optimis.
Dialogue: 0,0:13:12.52,0:13:15.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Abaddon, lengket banget.
Dialogue: 0,0:13:15.65,0:13:17.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menjijikkan.
Dialogue: 0,0:13:17.15,0:13:21.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku puas kalau kamu masih bisa\Nminta aneh-aneh di situasi ini.
Dialogue: 0,0:13:21.11,0:13:23.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah menolongku.
Dialogue: 0,0:13:23.91,0:13:25.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu tadi?
Dialogue: 0,0:13:25.12,0:13:30.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serafim, dia karakter kuat kelas bos\Nkalau menurut istilah kekinian.
Dialogue: 0,0:13:30.37,0:13:33.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari mana kamu mempelajarinya?
Dialogue: 0,0:13:33.38,0:13:36.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Datang, lo!\NPegangan yang erat!
Dialogue: 0,0:14:16.46,0:14:18.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benci itu.
Dialogue: 0,0:14:27.30,0:14:29.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhir yang begitu cepat.
Dialogue: 0,0:14:30.39,0:14:34.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tahu begini, seharusnya si Om\Naku perkosa saja.
Dialogue: 0,0:14:36.06,0:14:39.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan memikirkan dia saja.
Dialogue: 0,0:14:40.31,0:14:44.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena setelah ini, tidak akan bisa lagi.
Dialogue: 0,0:14:45.32,0:14:47.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma itu yang membuatku kesal.
Dialogue: 0,0:14:50.95,0:14:52.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Om...
Dialogue: 0,0:15:03.09,0:15:04.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gapai tanganku!
Dialogue: 0,0:15:05.84,0:15:07.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Om?
Dialogue: 0,0:15:17.81,0:15:18.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu baik-baik saja?
Dialogue: 0,0:15:20.40,0:15:22.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya.
Dialogue: 0,0:15:22.69,0:15:26.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan, kamu iblis juga?
Dialogue: 0,0:15:27.87,0:15:30.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Abaddon, kamu selamat?
Dialogue: 0,0:15:30.74,0:15:32.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga bersyukur kamu selamat.
Dialogue: 0,0:15:32.83,0:15:34.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, kamu siapa?
Dialogue: 0,0:15:34.83,0:15:37.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iblis yang mematuhinya.
Dialogue: 0,0:15:37.25,0:15:40.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak yang ingin kutanyakan padamu,
Dialogue: 0,0:15:40.09,0:15:43.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi terima kasih\Ntelah menyelamatkan Utusan-ku.
Dialogue: 0,0:15:43.17,0:15:46.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Abaddon, tolong percayai orang ini.
Dialogue: 0,0:15:46.88,0:15:50.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa menolak\Nkalau kamu bilang begitu.
Dialogue: 0,0:15:50.22,0:15:52.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jelas tidak boleh.
Dialogue: 0,0:15:52.06,0:15:58.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku penasaran dampak keputusanmu\Ndalam perang proksi ini.
Dialogue: 0,0:15:58.31,0:16:01.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Dia pasti mau berterima kasih padaku.\N- Aku refleks bergerak,
Dialogue: 0,0:16:01.19,0:16:04.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tidak salah lagi.\N- ternyata lubangnya dalam juga.
Dialogue: 0,0:16:04.07,0:16:07.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan kalau suara ini kudengar baik-baik...
Dialogue: 0,0:16:07.20,0:16:09.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bocah yang membantai\NTakayoshi dan yang lain!
Dialogue: 0,0:16:09.99,0:16:12.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Abaddon yang disebut Eriel\Ndan Utusan-nya...
Dialogue: 0,0:16:20.54,0:16:23.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sensasi aneh apa itu tadi?
Dialogue: 0,0:16:47.03,0:16:49.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenalanmu hebat juga.
Dialogue: 0,0:16:49.74,0:16:52.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga kaget.
Dialogue: 0,0:17:01.58,0:17:03.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ditembus!
Dialogue: 0,0:17:19.48,0:17:20.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Om...
Dialogue: 0,0:17:21.23,0:17:23.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, ya.\NKamu terluka?
Dialogue: 0,0:17:27.69,0:17:29.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kasihan.
Dialogue: 0,0:17:29.36,0:17:33.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pasti cemas sekali\Nterlibat urusan ini di usia muda.
Dialogue: 0,0:17:34.99,0:17:40.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Abaddon, tanpa basa-basi,\Naku mau bertanya.
Dialogue: 0,0:17:40.33,0:17:42.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan tanya apa saja!
Dialogue: 0,0:17:42.62,0:17:47.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin pergi dari kekacauan ini\Nsekarang juga.
Dialogue: 0,0:17:47.80,0:17:49.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senang mendengarnya.
Dialogue: 0,0:17:49.80,0:17:52.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kebetulan aku juga sama.
Dialogue: 0,0:17:52.51,0:17:55.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Termasuk hubungannya dengan tetanggaku,
Dialogue: 0,0:17:55.18,0:17:58.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}gumpalan daging misterius ini\Ndipenuhi tanda tanya.
Dialogue: 0,0:17:58.97,0:18:02.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku masih bisa menguaknya\Nsetelah kabur dari sini.
Dialogue: 0,0:18:02.73,0:18:06.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kalau begini terus juga bahaya.
Dialogue: 0,0:18:14.17,0:18:18.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka jelas banget mau mengakhiri kami.
Dialogue: 0,0:18:18.33,0:18:20.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Abaddon, tumben sekali.
Dialogue: 0,0:18:20.66,0:18:23.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malaikat itu lebih kuat darimu?
Dialogue: 0,0:18:23.50,0:18:25.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entahlah.
Dialogue: 0,0:18:25.38,0:18:28.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang jelas dia lawan yang buruk untukku.
Dialogue: 0,0:18:28.34,0:18:33.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para malaikat yang melawanmu selama ini\Npasti berpikir hal yang sama.
Dialogue: 0,0:18:33.18,0:18:37.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya, kata-kata itu\Nmembakar semangatku.
Dialogue: 0,0:18:37.18,0:18:40.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga mau tanya tanpa basa-basi.
Dialogue: 0,0:18:40.39,0:18:42.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu punya ide bagus?
Dialogue: 0,0:18:42.81,0:18:44.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mendadak sekali, ya.
Dialogue: 0,0:18:44.64,0:18:49.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lawan kita bisa merusak sihir penghalang\Ndengan satu ayunan pedang.
Dialogue: 0,0:18:49.23,0:18:52.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir petir yang merupakan\Nteknik serangan terkuatku
Dialogue: 0,0:18:52.47,0:18:56.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}cuma bisa membelokkan jalur pedang\Nyang diayunkan malaikat bersayap enam.
Dialogue: 0,0:18:56.54,0:18:58.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar buntu.
Dialogue: 0,0:18:58.78,0:19:03.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski belum terlalu pasti,\Nmungkin aku bisa sedikit membantu.
Dialogue: 0,0:19:03.71,0:19:05.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Benarkah?
Dialogue: 0,0:19:05.58,0:19:09.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ada cara yang lebih baik,\Nsebaiknya yang lain saja.
Dialogue: 0,0:19:09.88,0:19:14.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, kita coba milikmu saja.
Dialogue: 0,0:19:14.55,0:19:16.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:19:44.79,0:19:45.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tembak!
Dialogue: 0,0:19:46.54,0:19:47.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku mulai!
Dialogue: 0,0:19:59.64,0:20:03.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada sesuatu yang tersedot perlahan\Ndari dalam tubuhku.
Dialogue: 0,0:20:04.45,0:20:08.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini rasanya kehabisan daya sihir?
Dialogue: 0,0:20:09.19,0:20:10.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatanku tidak mau keluar.
Dialogue: 0,0:20:11.11,0:20:12.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesadaranku memudar.
Dialogue: 0,0:20:16.49,0:20:18.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat, aku sudah...
Dialogue: 0,0:20:19.53,0:20:20.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Om!
Dialogue: 0,0:21:10.17,0:21:11.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Om!
Dialogue: 0,0:21:17.17,0:21:18.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Om!
Dialogue: 0,0:21:24.93,0:21:26.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat.
Dialogue: 0,0:21:26.97,0:21:28.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakiku tidak ada.
Dialogue: 0,0:21:28.10,0:21:30.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Om! Om!
Dialogue: 0,0:21:30.56,0:21:33.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bertahanlah, Om!
Dialogue: 0,0:21:33.02,0:21:35.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kacau.
Dialogue: 0,0:21:35.11,0:21:37.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Proses penyembuhannya\Ntidak bisa mengimbangi.
Dialogue: 0,0:21:44.00,0:21:47.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Om! Jangan mati! Om!
Dialogue: 0,0:21:51.37,0:21:53.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Om!
Dialogue: 0,0:21:53.67,0:21:55.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa saja! Abaddon!
Dialogue: 0,0:22:00.13,0:22:02.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Om... Om...
Dialogue: 0,0:22:02.34,0:22:04.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan, Om...
Dialogue: 0,0:22:04.68,0:22:07.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Om! Om!
