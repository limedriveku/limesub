Dialogue: 0,0:00:23.34,0:00:26.21,sign,,0000,0000,0000,,EPISODE 1: IBU DAN ANAK
Dialogue: 0,0:08:31.66,0:08:39.25,sign,,0000,0000,0000,,SASAKI DAN PIPI S2
Dialogue: 0,0:22:18.69,0:22:21.70,sign,,0000,0000,0000,,TOLONG JANGAN BERI MAKAN DAGING KE GELATIK
Dialogue: 0,0:22:21.70,0:22:28.16,sign,,0000,0000,0000,,JAWA YANG BUKAN REINKARNASI MAHARDIKA!
Dialogue: 0,0:22:48.14,0:22:49.26,sign,,0000,0000,0000,,GELATIK JAWA
Dialogue: 0,0:40:23.32,0:40:24.78,sign,,0000,0000,0000,,FUTARI SHIZUKA\NPANGGILAN MASUK
Dialogue: 0,0:00:12.41,0:00:15.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ibu!\N- Terima kasih banyak!
Dialogue: 0,0:00:15.66,0:00:20.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat aku SD, Ayah pergi dari rumah.
Dialogue: 0,0:00:20.71,0:00:23.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pindah bersama Ibu
Dialogue: 0,0:00:23.34,0:00:26.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan tinggal di rumah kecil.
Dialogue: 0,0:00:27.88,0:00:30.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai hari ini, kita tinggal di sini.
Dialogue: 0,0:00:31.76,0:00:33.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu rumah sebelumnya?
Dialogue: 0,0:00:34.81,0:00:35.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah.
Dialogue: 0,0:00:37.43,0:00:39.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah mana?
Dialogue: 0,0:00:39.77,0:00:41.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cerewet.
Dialogue: 0,0:00:41.10,0:00:43.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah di mana?
Dialogue: 0,0:00:43.31,0:00:44.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei.
Dialogue: 0,0:00:44.52,0:00:45.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cerewet!
Dialogue: 0,0:00:46.90,0:00:49.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bahas laki-laki itu!
Dialogue: 0,0:00:53.87,0:00:57.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak pindah, Ibu selalu marah.
Dialogue: 0,0:00:57.50,0:01:01.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya sakit tiap kena lemparan Ibu.
Dialogue: 0,0:01:01.00,0:01:02.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi-lagi kamu!
Dialogue: 0,0:01:02.83,0:01:06.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dikasih tahu berkali-kali\Nmasih saja tidak becus!
Dialogue: 0,0:01:06.34,0:01:08.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bikin repot!
Dialogue: 0,0:01:09.76,0:01:12.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Andai aku tidak melahirkanmu.
Dialogue: 0,0:01:13.26,0:01:15.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Andai kamu tidak ada...
Dialogue: 0,0:01:22.27,0:01:23.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yo.
Dialogue: 0,0:01:24.86,0:01:29.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Laki-laki yang bukan Ayah\Nmulai datang ke rumah.
Dialogue: 0,0:01:35.87,0:01:40.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiap laki-laki itu datang,\Naku diusir ke luar.
Dialogue: 0,0:01:41.12,0:01:45.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di rumah yang baru,\NIbu tidak memberiku makan.
Dialogue: 0,0:01:45.67,0:01:48.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dapat makan siang gratis di sekolah,
Dialogue: 0,0:01:48.84,0:01:50.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi tidak dapat kalau libur.
Dialogue: 0,0:01:50.84,0:01:55.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku menyembunyikan makanan\Ndi bawah tanah.
Dialogue: 0,0:02:02.14,0:02:05.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanan berhargaku...
Dialogue: 0,0:02:06.86,0:02:11.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Om dari apartemen sebelah mencurinya.
Dialogue: 0,0:02:14.78,0:02:17.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang dewasa yang jahat sekali.
Dialogue: 0,0:02:17.33,0:02:19.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitulah pikirku.
Dialogue: 0,0:02:22.71,0:02:27.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Om dari apartemen sebelah\Nmulai memberiku makanan.
Dialogue: 0,0:02:27.21,0:02:29.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bukan pencuri?
Dialogue: 0,0:02:30.76,0:02:33.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang sangat lapar
Dialogue: 0,0:02:34.63,0:02:37.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menerima makanan darinya.
Dialogue: 0,0:02:39.18,0:02:44.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak pindah rumah,\Nkadang ada tamu tidak dikenal.
Dialogue: 0,0:02:54.28,0:02:58.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah ada tamu,\Nsuasana hati Ibu memburuk.
Dialogue: 0,0:02:58.45,0:02:59.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berengsek!
Dialogue: 0,0:03:00.58,0:03:05.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Aku selalu meringkuk di pojok kamar.\N- Terus mau bagaimana lagi?
Dialogue: 0,0:03:05.62,0:03:07.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial! Sial!
Dialogue: 0,0:03:11.13,0:03:13.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu ringan tangan padaku.
Dialogue: 0,0:03:14.22,0:03:16.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah apa alasannya.
Dialogue: 0,0:03:19.26,0:03:21.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat masuk SMP,
Dialogue: 0,0:03:21.72,0:03:26.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku mulai sadar kondisi keluargaku\Nberbeda dengan keluarga lain.
Dialogue: 0,0:03:27.85,0:03:30.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak diberi makan.
Dialogue: 0,0:03:30.06,0:03:31.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat rumah kosong pun\Naku tidak bisa masuk.
Dialogue: 0,0:03:32.36,0:03:34.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku...
Dialogue: 0,0:03:39.87,0:03:42.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengutamakan bertahan hidup.
Dialogue: 0,0:03:43.37,0:03:48.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, aku jadi tahu siapa tamu\Nyang kadang datang ke rumah.
Dialogue: 0,0:03:48.46,0:03:50.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka dari lembaga perlindungan anak.
Dialogue: 0,0:03:50.88,0:03:54.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu lembaga perlindungan anak\Ndari buku di perpustakaan.
Dialogue: 0,0:03:55.51,0:03:59.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin Om atau tetangga yang melapor.
Dialogue: 0,0:04:00.26,0:04:03.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayangnya, Ibu pandai berkelit.
Dialogue: 0,0:04:03.51,0:04:07.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka langsung pulang\Nsetelah mengobrol sebentar.
Dialogue: 0,0:04:13.52,0:04:16.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski sudah hampir lulus SD,
Dialogue: 0,0:04:16.19,0:04:19.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hubunganku dan Ibu tetap dingin.
Dialogue: 0,0:04:19.70,0:04:22.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan kami sudah jarang bicara.
Dialogue: 0,0:04:23.66,0:04:26.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kami tetap tinggal seatap
Dialogue: 0,0:04:26.37,0:04:29.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di apartemen yang sempit,
Dialogue: 0,0:04:29.71,0:04:31.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}terbiasa memang hal yang mengerikan.
Dialogue: 0,0:04:32.84,0:04:35.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pola makanku masih sama.
Dialogue: 0,0:04:35.59,0:04:38.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu tidak memberiku makan.
Dialogue: 0,0:04:38.17,0:04:42.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi berkat pengetahuan\Ndan stamina yang bertambah,
Dialogue: 0,0:04:42.05,0:04:44.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kemandirianku pun meningkat.
Dialogue: 0,0:04:44.64,0:04:46.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa menikmati salad liar
Dialogue: 0,0:04:46.31,0:04:50.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pakai bumbu curian\Ndari ruang tata boga sekolah.
Dialogue: 0,0:04:50.90,0:04:55.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mesin swasaji bisa kuperiksa\Ndengan lebih efisien.
Dialogue: 0,0:04:55.02,0:04:58.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kulit roti pun bisa kudapatkan lebih banyak.
Dialogue: 0,0:05:04.41,0:05:07.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Oleh-olehmu apa?
Dialogue: 0,0:05:07.41,0:05:08.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cokelat yuba.
Dialogue: 0,0:05:08.66,0:05:10.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Apaan itu?
Dialogue: 0,0:05:10.12,0:05:12.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Aku tidak pernah ikut karyawisata\N- Ada di toko penginapan.
Dialogue: 0,0:05:12.81,0:05:14.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Aku tidak pernah ikut karyawisata\N- Aku enggak lihat.
Dialogue: 0,0:05:14.00,0:05:16.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- dan kegiatan di luar sekolah.\N- Aku enggak lihat.
Dialogue: 0,0:05:26.22,0:05:29.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Om pulang lebih larut dari biasanya.
Dialogue: 0,0:05:29.35,0:05:31.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa dia sibuk bekerja?
Dialogue: 0,0:05:32.73,0:05:33.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo?
Dialogue: 0,0:05:34.61,0:05:37.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mamamu belum pulang?
Dialogue: 0,0:05:43.61,0:05:46.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, sini ikut aku.
Dialogue: 0,0:05:46.37,0:05:48.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, terima kasih.
Dialogue: 0,0:05:48.58,0:05:50.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di luar dingin, kan?
Dialogue: 0,0:05:50.54,0:05:52.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo masuk ke dalam biar hangat.
Dialogue: 0,0:05:52.83,0:05:55.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak usah! Aku sudah biasa!
Dialogue: 0,0:05:55.13,0:05:58.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayolah, cepat masuk!
Dialogue: 0,0:05:58.63,0:06:01.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak! Buat apa?
Dialogue: 0,0:06:03.01,0:06:06.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu! Berhenti!
Dialogue: 0,0:06:06.39,0:06:09.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudahlah, jangan melawan.
Dialogue: 0,0:06:09.89,0:06:11.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan!
Dialogue: 0,0:06:11.06,0:06:11.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diam!
Dialogue: 0,0:06:14.69,0:06:18.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak mau terluka,\Njangan melawan.
Dialogue: 0,0:06:18.98,0:06:23.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya buat apa\Naku meniduri nenek itu?
Dialogue: 0,0:06:23.15,0:06:24.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sadar, kek.
Dialogue: 0,0:06:24.32,0:06:25.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nenek?
Dialogue: 0,0:06:25.28,0:06:27.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:06:28.33,0:06:30.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selangkangannya sudah longgar\Ndan tidak rapat.
Dialogue: 0,0:06:30.75,0:06:34.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sialnya lagi baunya juga tengik.
Dialogue: 0,0:06:34.62,0:06:37.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaliknya...
Dialogue: 0,0:06:38.17,0:06:41.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu benar-benar imut.
Dialogue: 0,0:06:49.10,0:06:50.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bedebah!
Dialogue: 0,0:06:50.64,0:06:53.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan melawan!
Dialogue: 0,0:06:53.02,0:06:55.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak akan lama, kok!
Dialogue: 0,0:06:55.06,0:06:56.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau kubantu?
Dialogue: 0,0:06:59.11,0:07:00.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak-anak?
Dialogue: 0,0:07:00.82,0:07:02.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa ada anak-anak di kamarku?
Dialogue: 0,0:07:02.82,0:07:04.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok dia terbang?
Dialogue: 0,0:07:04.86,0:07:06.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau kubantu?
Dialogue: 0,0:07:07.99,0:07:10.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong aku...
Dialogue: 0,0:07:10.45,0:07:11.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:07:11.54,0:07:14.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai gantinya, kamu mau\Nmenuruti permintaanku?
Dialogue: 0,0:07:15.46,0:07:16.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:07:17.08,0:07:18.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:07:21.25,0:07:23.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada orang?
Dialogue: 0,0:07:28.72,0:07:32.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang, dia cuma pingsan.
Dialogue: 0,0:07:32.31,0:07:35.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku membunuh orang\Ndi dunia fisik ini,
Dialogue: 0,0:07:35.10,0:07:38.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}nanti jadi pelanggaran serius.
Dialogue: 0,0:07:38.10,0:07:41.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat rapikan penampilanmu.
Dialogue: 0,0:07:41.44,0:07:44.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu siapa?
Dialogue: 0,0:07:44.74,0:07:48.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebelum itu, ada yang harus\Nkamu ucapkan dulu, kan?
Dialogue: 0,0:07:48.16,0:07:50.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:07:50.62,0:07:52.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, bagus.
Dialogue: 0,0:07:52.08,0:07:55.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku suka orang yang lugu begitu.
Dialogue: 0,0:07:56.33,0:08:00.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, kamu baik-baik saja?\NSudah diperkosa?
Dialogue: 0,0:08:00.42,0:08:02.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, belum.
Dialogue: 0,0:08:02.59,0:08:05.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, baguslah.
Dialogue: 0,0:08:05.92,0:08:10.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku harus apa?
Dialogue: 0,0:08:11.68,0:08:13.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku adalah iblis.
Dialogue: 0,0:08:13.97,0:08:17.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan kamu harus mewakiliku
Dialogue: 0,0:08:17.10,0:08:19.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bertarung melawan Utusan malaikat.
Dialogue: 0,0:09:51.61,0:09:54.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Langsung saja, mari kita bahas.
Dialogue: 0,0:09:57.66,0:10:00.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi-lagi editan murahan.
Dialogue: 0,0:10:00.96,0:10:03.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malah tampak menyedihkan.
Dialogue: 0,0:10:03.12,0:10:05.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau cuma editan,
Dialogue: 0,0:10:05.50,0:10:08.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita tidak mungkin dipanggil saat libur.
Dialogue: 0,0:10:08.09,0:10:11.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jelaskan secara gamblang.
Dialogue: 0,0:10:11.01,0:10:13.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebelumnya, Futari Shizuka\Npernah membawa
Dialogue: 0,0:10:13.63,0:10:15.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pemilik kekuatan dari luar negeri, kan?
Dialogue: 0,0:10:15.80,0:10:18.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti itu Nona Elsa.
Dialogue: 0,0:10:18.01,0:10:20.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya dia kenapa?
Dialogue: 0,0:10:20.47,0:10:22.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahasa yang dia tuturkan
Dialogue: 0,0:10:22.60,0:10:27.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan bahasa makhluk\Nyang jatuh dari langit ini,
Dialogue: 0,0:10:27.06,0:10:29.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kemungkinan besar sama.
Dialogue: 0,0:10:29.86,0:10:33.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jeli sekali.
Dialogue: 0,0:10:33.07,0:10:36.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah meminta staf lembaga terkait\Nmenganalisis video ini,
Dialogue: 0,0:10:36.78,0:10:38.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}keluarlah hasil itu.
Dialogue: 0,0:10:38.53,0:10:41.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan...
Dialogue: 0,0:10:41.00,0:10:43.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pak Kabag sendiri yang menyadari itu?
Dialogue: 0,0:10:43.75,0:10:47.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang ada pegawai lain\Nyang tahu keberadaannya?
Dialogue: 0,0:10:49.67,0:10:54.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya pikir dapat informasi\Ndari Futari Shizuka.
Dialogue: 0,0:10:54.59,0:10:59.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku meminta Futari Shizuka datang\Nuntuk memastikannya juga.
Dialogue: 0,0:10:59.64,0:11:01.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu.
Dialogue: 0,0:11:01.56,0:11:06.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pernah bilang bahasa ibu\Ntemanmu adalah bahasa minoritas.
Dialogue: 0,0:11:06.77,0:11:10.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih tepatnya, itu bahasa mana?
Dialogue: 0,0:11:10.11,0:11:12.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak tahu sejauh itu.
Dialogue: 0,0:11:12.90,0:11:15.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami tidak terlalu dekat.
Dialogue: 0,0:11:16.03,0:11:18.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak beberapa waktu lalu,
Dialogue: 0,0:11:18.28,0:11:20.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Futari Shizuka sudah\Nmenjadi pegawai resmi.
Dialogue: 0,0:11:20.78,0:11:22.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, langsung saja...
Dialogue: 0,0:11:22.75,0:11:26.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Video ini akan kukirim ke perangkatmu,
Dialogue: 0,0:11:26.12,0:11:29.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tolong terjemahkan audio di rekaman ini.
Dialogue: 0,0:11:29.21,0:11:33.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, aku juga tidak bisa bahasa itu.
Dialogue: 0,0:11:33.59,0:11:35.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:11:35.88,0:11:38.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pernah bilang, kan?
Dialogue: 0,0:11:38.43,0:11:42.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan telekinesis punya prospek cerah.
Dialogue: 0,0:11:42.06,0:11:45.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski tidak bisa berkomunikasi,\Nbanyak yang mengincarnya.
Dialogue: 0,0:11:45.85,0:11:50.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pikir aku berbohong?
Dialogue: 0,0:11:50.73,0:11:54.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Patut dipertimbangkan\Nsebagai sebuah kemungkinan, kan?
Dialogue: 0,0:11:54.53,0:11:56.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jahatnya.
Dialogue: 0,0:11:56.70,0:12:01.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak memercayai\Nkata-kata rekan sendiri.
Dialogue: 0,0:12:01.24,0:12:04.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rekan seperti ini wajar tidak dipercaya.
Dialogue: 0,0:12:04.75,0:12:06.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lupakan dulu itu.
Dialogue: 0,0:12:06.75,0:12:11.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak salah lagi, rekaman Lizardman\Nmembuat Pak Kabag curiga.
Dialogue: 0,0:12:11.96,0:12:17.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke depannya, aku harus lebih hati-hati\Nbepergian ke dunia lain.
Dialogue: 0,0:12:17.26,0:12:18.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:12:19.76,0:12:22.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan memercayai ucapan bawahanku.
Dialogue: 0,0:12:22.39,0:12:24.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh?
Dialogue: 0,0:12:24.39,0:12:26.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai gantinya,
Dialogue: 0,0:12:26.27,0:12:29.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku ingin kalian menyelidiki kasus ini.
Dialogue: 0,0:12:29.56,0:12:32.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pak Kabag, aku juga ikut sama mereka?
Dialogue: 0,0:12:32.69,0:12:34.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari keributan sebelumnya,
Dialogue: 0,0:12:34.78,0:12:37.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}terlihat peningkatan kekuatan Sasaki.
Dialogue: 0,0:12:37.78,0:12:41.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong pastikan ulang tingkat kasus\Nyang bisa dia tangani.
Dialogue: 0,0:12:41.16,0:12:42.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:12:45.87,0:12:48.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah larut banget.
Dialogue: 0,0:12:48.41,0:12:51.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pipi mungkin sudah tidur.
Dialogue: 0,0:12:55.50,0:12:57.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pulang, Pipi.
Dialogue: 0,0:13:00.26,0:13:02.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Imutnya!
Dialogue: 0,0:13:05.10,0:13:06.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah pulang, ya?
Dialogue: 0,0:13:06.72,0:13:08.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya...
Dialogue: 0,0:13:08.43,0:13:09.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pulang.
Dialogue: 0,0:13:10.98,0:13:14.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu benar-benar dipanggil\Nkarena kasus Lizardman, ya?
Dialogue: 0,0:13:14.65,0:13:17.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, sesuai dugaan.
Dialogue: 0,0:13:17.57,0:13:21.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa objek dunia lain\Nbisa muncul di dunia ini?
Dialogue: 0,0:13:21.61,0:13:23.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga penasaran.
Dialogue: 0,0:13:23.24,0:13:25.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin menyelidikinya.
Dialogue: 0,0:13:25.45,0:13:28.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga diperintah atasan\Nuntuk menyelidikinya.
Dialogue: 0,0:13:30.12,0:13:32.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti, sekali mendayung\Ndua tiga pulau terlampaui.
Dialogue: 0,0:13:32.88,0:13:35.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkat itu, aku bisa fokus
Dialogue: 0,0:13:35.96,0:13:38.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menjelajahi dunia lain tanpa rasa bersalah.
Dialogue: 0,0:13:38.63,0:13:39.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:13:39.97,0:13:42.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus, pengangkutan perbekalan.
Dialogue: 0,0:13:42.51,0:13:46.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa sebaiknya aku tanya kabar\Ndari Count Müller lebih dulu?
Dialogue: 0,0:13:46.72,0:13:50.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga ingin membahas soal\Npengangkutan dengan Joseph.
Dialogue: 0,0:13:50.31,0:13:51.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:13:51.52,0:13:53.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, ayo ke sana.
Dialogue: 0,0:13:55.52,0:13:58.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Sasaki, Mahardika Bintang.
Dialogue: 0,0:13:58.36,0:14:00.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah datang.
Dialogue: 0,0:14:00.36,0:14:03.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang harus segera saya sampaikan.
Dialogue: 0,0:14:04.53,0:14:06.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa terjadi sesuatu?
Dialogue: 0,0:14:06.78,0:14:09.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini soal perebutan takhta Yang Mulia.
Dialogue: 0,0:14:09.33,0:14:15.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Count Dietrich telah beralih pihak\Nke kubu Pangeran Kedua, Adonis.
Dialogue: 0,0:14:15.13,0:14:16.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:14:16.34,0:14:21.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak lama sejak perebutan takhta dimulai,\Nterjadi pembelotan.
Dialogue: 0,0:14:21.42,0:14:24.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masyarakat pun dilanda kegemparan.
Dialogue: 0,0:14:24.72,0:14:28.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, ada desas-desus tentang\Nketerkaitan Usaha Dagang Kepler.
Dialogue: 0,0:14:28.31,0:14:33.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keterkaitan itu pun\Nmenyeret nama Tuan Sasaki.
Dialogue: 0,0:14:33.02,0:14:34.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya?
Dialogue: 0,0:14:35.81,0:14:38.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan...
Dialogue: 0,0:14:41.24,0:14:43.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon maaf sebesar-besarnya.
Dialogue: 0,0:14:43.07,0:14:47.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkenankah Anda pergi\Nke istana bersama saya?
Dialogue: 0,0:14:49.87,0:14:52.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak seperti biasa, Julius.
Dialogue: 0,0:14:53.21,0:14:56.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisakah kamu jelaskan lebih rinci?
Dialogue: 0,0:14:56.71,0:14:58.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Itu...
Dialogue: 0,0:14:58.42,0:15:03.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah aku dan pria ini\Nsebegitunya tidak bisa diandalkan?
Dialogue: 0,0:15:03.01,0:15:07.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keren banget, mereka\Nseperti saling memahami!
Dialogue: 0,0:15:09.39,0:15:10.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putriku...
Dialogue: 0,0:15:12.60,0:15:15.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elsa dijadikan sandera.
Dialogue: 0,0:15:16.98,0:15:21.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu membela kami sejauh itu?
Dialogue: 0,0:15:21.73,0:15:23.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:15:23.24,0:15:25.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini semua kesalahanku.
Dialogue: 0,0:15:25.74,0:15:27.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah lawan kita ratu?
Dialogue: 0,0:15:27.32,0:15:30.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu bukan ulah Adonis, kan?
Dialogue: 0,0:15:30.45,0:15:31.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan.
Dialogue: 0,0:15:31.79,0:15:34.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu perintah dari Duke Einhart.
Dialogue: 0,0:15:35.16,0:15:36.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:15:36.58,0:15:39.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masuk akal kalau dia pelakunya.
Dialogue: 0,0:15:39.13,0:15:42.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duke Einhart? Siapa itu?
Dialogue: 0,0:15:42.13,0:15:45.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kubu pangeran kedua\Nternyata tidak sesolid itu, ya.
Dialogue: 0,0:15:45.59,0:15:49.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lantas, di mana putrimu?
Dialogue: 0,0:15:49.43,0:15:52.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya rasa di kediaman\Ndi ibu kota Arestos.
Dialogue: 0,0:15:52.47,0:15:57.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awalnya, duke mengusulkan\Nuntuk mendidik putri saya
Dialogue: 0,0:15:57.06,0:15:58.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bersiap jadi pengantin…
Dialogue: 0,0:15:59.98,0:16:02.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tertipu Duke Einhart, ya?
Dialogue: 0,0:16:02.48,0:16:04.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya sungguh teledor.
Dialogue: 0,0:16:06.40,0:16:08.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Count Müller.
Dialogue: 0,0:16:08.24,0:16:10.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau kita ke ibu kota?
Dialogue: 0,0:16:10.99,0:16:13.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mau membantu?
Dialogue: 0,0:16:13.33,0:16:17.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku merasa bertanggung jawab juga.
Dialogue: 0,0:16:18.17,0:16:19.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon maaf.
Dialogue: 0,0:16:19.88,0:16:23.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, ya, kami melibatkanmu terus.
Dialogue: 0,0:16:24.34,0:16:28.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga membebanimu, kan?
Dialogue: 0,0:16:29.09,0:16:33.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhir-akhir ini, aku sering memintamu\Njaga rumah sendirian.
Dialogue: 0,0:16:34.31,0:16:37.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga memintamu berpura-pura\Njadi burung gelatik jawa.
Dialogue: 0,0:16:37.56,0:16:40.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga membawamu\Npakai kandang saat bepergian.
Dialogue: 0,0:16:40.90,0:16:44.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku puas menghabiskan waktu
Dialogue: 0,0:16:44.32,0:16:46.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}internetan di kamarmu.
Dialogue: 0,0:16:46.78,0:16:49.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan kehilangan wujud manusia,
Dialogue: 0,0:16:49.49,0:16:53.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kesempatanku melihat hal\Nyang tidak tersadari bertambah.
Dialogue: 0,0:16:53.58,0:16:57.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk sementara, aku bisa\Nmenikmati waktu yang bermanfaat.
Dialogue: 0,0:16:57.12,0:16:58.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:16:59.12,0:17:03.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang punya sahabat\Ngelatik jawa yang perhatian.
Dialogue: 0,0:17:03.46,0:17:05.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, aku senang!
Dialogue: 0,0:17:07.17,0:17:10.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Count, ada tamu.
Dialogue: 0,0:17:11.89,0:17:13.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pangeran Adonis?
Dialogue: 0,0:17:13.80,0:17:15.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelihatannya
Dialogue: 0,0:17:15.26,0:17:19.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}masalah tadi sudah selesai, ya?
Dialogue: 0,0:17:19.52,0:17:21.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan bermurah hati,
Dialogue: 0,0:17:21.31,0:17:23.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mereka bersedia ikut.
Dialogue: 0,0:17:23.60,0:17:24.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,
Dialogue: 0,0:17:24.98,0:17:27.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ada yang ingin kubicarakan juga.
Dialogue: 0,0:17:30.11,0:17:34.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rencananya, Sasaki akan diberi gelar baron.
Dialogue: 0,0:17:34.62,0:17:37.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Baron?
Dialogue: 0,0:17:37.08,0:17:42.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kabar pendirian usaha dagang di Republik Lunge\Nbersama Usaha Dagang Kepler
Dialogue: 0,0:17:42.25,0:17:46.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sampai dari telinga Count Dietrich\Nhingga ke telinga Ibu.
Dialogue: 0,0:17:46.30,0:17:48.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sasaki mau mereka jadikan bangsawan
Dialogue: 0,0:17:48.71,0:17:50.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}agar bisa dikendalikan.
Dialogue: 0,0:17:50.92,0:17:53.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, mereka juga sedang membahas
Dialogue: 0,0:17:53.43,0:17:57.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk menganugerahkan Dataran Rectan\Npada Sasaki sebagai wilayah kekuasaan.
Dialogue: 0,0:17:58.85,0:18:00.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dataran Rectan...
Dialogue: 0,0:18:00.81,0:18:02.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempat waktu itu.
Dialogue: 0,0:18:02.31,0:18:04.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempat seperti itu?
Dialogue: 0,0:18:04.69,0:18:06.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangankan kota atau desa,
Dialogue: 0,0:18:06.44,0:18:09.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pemukiman kecil pun tidak ada.
Dialogue: 0,0:18:09.36,0:18:12.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana caranya dapat pajak?
Dialogue: 0,0:18:12.40,0:18:16.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya Ayahanda ingin wilayah itu
Dialogue: 0,0:18:16.70,0:18:20.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menjadi bagian negara kita sebagai\Nhasil perang melawan Kekaisaran Ohgen.
Dialogue: 0,0:18:20.12,0:18:25.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin beliau perintahkan pembangunan\Nsetidaknya satu parit pertahanan
Dialogue: 0,0:18:25.46,0:18:27.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk keadaan darurat.
Dialogue: 0,0:18:27.17,0:18:30.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu keterlaluan!
Dialogue: 0,0:18:30.21,0:18:33.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin ini salah satu aspek\Ndari sengketa internal
Dialogue: 0,0:18:33.47,0:18:36.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di dalam kubu Pangeran Kedua.
Dialogue: 0,0:18:36.09,0:18:39.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu pula dengan permintaan\NCount Müller agar aku pergi ke ibu kota.
Dialogue: 0,0:18:39.60,0:18:43.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duke Einhart yang tadi dibahas\Njuga mencurigakan.
Dialogue: 0,0:18:44.23,0:18:46.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi jangan-jangan...
Dialogue: 0,0:18:46.27,0:18:49.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada masalah juga, kan?
Dialogue: 0,0:18:50.23,0:18:54.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita buatkan saja satu atau dua parit.
Dialogue: 0,0:18:54.53,0:18:58.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selesaikan saja pelan-pelan\Ndalam beberapa tahun.
Dialogue: 0,0:18:58.12,0:19:00.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama kita bersusah payah\Ndi daerah terpencil,
Dialogue: 0,0:19:00.83,0:19:04.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin mereka tidak akan\Nmencari-cari kesalahan.
Dialogue: 0,0:19:04.29,0:19:08.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya, Pipi juga sepikiran denganku.
Dialogue: 0,0:19:08.50,0:19:11.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagi para bangsawan Kerajaan Hertz,
Dialogue: 0,0:19:11.00,0:19:14.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ini hanyalah penghinaan.
Dialogue: 0,0:19:14.17,0:19:18.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi bagi kami yang ingin hidup\Njauh dari hiruk pikuk,
Dialogue: 0,0:19:18.39,0:19:20.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ini justru menguntungkan.
Dialogue: 0,0:19:20.22,0:19:23.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, kalau kita menyebarkan uang,
Dialogue: 0,0:19:23.35,0:19:25.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}wilayahmu juga pasti makmur.
Dialogue: 0,0:19:25.77,0:19:28.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak usah memikirkan saya...
Dialogue: 0,0:19:28.81,0:19:33.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi apa Kekaisaran Ohgen\Nbakal mengganggu?
Dialogue: 0,0:19:33.69,0:19:36.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah pasti iya.
Dialogue: 0,0:19:36.57,0:19:38.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat, dong?
Dialogue: 0,0:19:38.37,0:19:39.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja.
Dialogue: 0,0:19:40.03,0:19:42.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku punya ide.
Dialogue: 0,0:19:42.99,0:19:47.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami pun tiba setelah diantar\NPangeran Adonis.
Dialogue: 0,0:19:47.42,0:19:49.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti yang dikabarkan,
Dialogue: 0,0:19:49.67,0:19:52.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku dianugerahi wilayah Dataran Rectan.
Dialogue: 0,0:19:52.00,0:19:56.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan sesuai dugaan lagi, aku diperintah\Nmembangun tembok pertahanan
Dialogue: 0,0:19:56.84,0:20:01.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di seluruh kawasan tersebut.
Dialogue: 0,0:20:01.51,0:20:06.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan saya kerahkan segenap jiwa raga\Nuntuk memenuhi harapan Anda.
Dialogue: 0,0:20:06.31,0:20:08.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus.
Dialogue: 0,0:20:08.02,0:20:10.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Izin bicara, Yang Mulia.
Dialogue: 0,0:20:10.02,0:20:13.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkenankah Yang Mulia\Nmendengarkan satu permohonan saya?
Dialogue: 0,0:20:13.53,0:20:16.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh? Coba katakan.
Dialogue: 0,0:20:16.49,0:20:19.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebelum tembok pertahanan\Ndi Dataran Rectan selesai,
Dialogue: 0,0:20:19.74,0:20:23.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}saya bersumpah tidak akan\Nkembali ke ibu kota Arestos.
Dialogue: 0,0:20:23.87,0:20:28.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya pasti akan mewujudkannya\Ndemi kemakmuran Kerajaan Hertz.
Dialogue: 0,0:20:29.08,0:20:30.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, saya mohon.
Dialogue: 0,0:20:30.79,0:20:34.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisakah Yang Mulia mengembalikan orang\Nyang mewarnai hidup Count Müller?
Dialogue: 0,0:20:34.92,0:20:36.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tu-Tuan Sasaki!
Dialogue: 0,0:20:36.88,0:20:38.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ku-Kurang ajar!
Dialogue: 0,0:20:38.84,0:20:41.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beraninya kesatria memohon\Npada Yang Mulia!
Dialogue: 0,0:20:41.55,0:20:43.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lancang sekali!
Dialogue: 0,0:20:44.06,0:20:45.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Warna?
Dialogue: 0,0:20:46.18,0:20:48.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kira-kira apa maksudmu?
Dialogue: 0,0:20:48.89,0:20:53.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengenai detailnya, harap konfirmasi\Nlangsung ke Duke Einhart.
Dialogue: 0,0:20:53.94,0:20:55.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:20:55.40,0:21:00.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan mengabulkan permohonan\Norang kepercayaan Adonis.
Dialogue: 0,0:21:00.36,0:21:02.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:21:04.16,0:21:05.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baron Sasaki!
Dialogue: 0,0:21:05.83,0:21:07.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah.
Dialogue: 0,0:21:07.79,0:21:11.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Elsa sudah kembali ke rumah, ya.
Dialogue: 0,0:21:11.04,0:21:14.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini semua berkat kamu
Dialogue: 0,0:21:14.42,0:21:18.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang memohon langsung\Nke Yang Mulia, kan?
Dialogue: 0,0:21:18.26,0:21:21.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benar-benar tidak menyangka
Dialogue: 0,0:21:21.09,0:21:23.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu seberani itu.
Dialogue: 0,0:21:23.76,0:21:26.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, itu...
Dialogue: 0,0:21:28.39,0:21:31.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Baron Sasaki!
Dialogue: 0,0:21:33.06,0:21:35.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, Tuan Sasaki.
Dialogue: 0,0:21:35.19,0:21:38.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal tembok pertahanan\Ndi Dataran Rectan.
Dialogue: 0,0:21:38.24,0:21:43.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau berkenan,\Nbolehkah aku turut membantu?
Dialogue: 0,0:21:43.07,0:21:45.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami cuma memasang penghalang.
Dialogue: 0,0:21:45.58,0:21:48.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak akan sesulit itu.
Dialogue: 0,0:21:48.29,0:21:49.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:21:49.58,0:21:53.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau salah langkah, nanti bisa\Nmemprovokasi Kekaisaran Ohgen.
Dialogue: 0,0:21:53.75,0:21:55.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak perlu memusingkan itu.
Dialogue: 0,0:21:55.84,0:21:58.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami akan mengurusnya sendiri.
Dialogue: 0,0:22:00.05,0:22:01.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya saja...
Dialogue: 0,0:22:01.97,0:22:05.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami butuh sedikit\Nbantuan orang kali ini.
Dialogue: 0,0:22:05.05,0:22:09.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami akan terbantu kalau kamu bisa\Nmembantu urusan tenaga dan material.
Dialogue: 0,0:22:09.85,0:22:13.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti kami hubungi lagi.
Dialogue: 0,0:22:14.31,0:22:16.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:22:16.06,0:22:18.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Izinkan saya membantu!
Dialogue: 0,0:22:18.69,0:22:21.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Count Müller terlihat senang sekali.
Dialogue: 0,0:22:21.70,0:22:23.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pasti tersentuh bisa membantu
Dialogue: 0,0:22:23.91,0:22:24.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mahardika Bintang.
Dialogue: 0,0:22:24.99,0:22:28.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pipi memang agak tsundere, sih.
Dialogue: 0,0:22:28.16,0:22:30.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Papa, kenapa tiba-tiba begitu?
Dialogue: 0,0:22:31.37,0:22:35.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok sopan sekali ke familiar-nya Sasaki?
Dialogue: 0,0:22:37.04,0:22:40.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya, Nona Elsa tidak tahu kalau Pipi
Dialogue: 0,0:22:40.63,0:22:43.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah Mahardika Bintang.
Dialogue: 0,0:22:44.80,0:22:46.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau memelihara gelatik jawa,
Dialogue: 0,0:22:46.51,0:22:49.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku sempat bertekad
Dialogue: 0,0:22:49.26,0:22:50.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan mengelus-elusnya.
Dialogue: 0,0:22:50.64,0:22:53.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah lama sekali sejak\Naku datang ke toko peliharaan itu.
Dialogue: 0,0:22:53.73,0:22:57.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah tahu Pipi adalah sosok hebat,
Dialogue: 0,0:22:57.36,0:23:01.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku jadi segan mau mengelus kepalanya.
Dialogue: 0,0:23:02.65,0:23:05.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang membuatmu kepikiran?
Dialogue: 0,0:23:05.28,0:23:07.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak! Tidak ada!
Dialogue: 0,0:23:07.70,0:23:09.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh.
Dialogue: 0,0:23:09.12,0:23:11.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baguslah.
Dialogue: 0,0:23:11.12,0:23:13.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita pergi ke Dataran Rectan besok.
Dialogue: 0,0:23:13.79,0:23:16.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Istirahatkan tubuhmu.
Dialogue: 0,0:23:16.54,0:23:17.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:23:19.54,0:23:23.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku buat seolah naga liar menjadikan\Nlubang besar ini sebagai sarangnya.
Dialogue: 0,0:23:23.55,0:23:26.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sementara waktu,\Naku berencana menjauhkan
Dialogue: 0,0:23:26.84,0:23:28.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pasukan Kekaisaran Ohgen\Ndari perbatasan.
Dialogue: 0,0:23:29.35,0:23:30.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Intinya, familiar.
Dialogue: 0,0:23:30.97,0:23:34.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Naga bisa dijinakkan semudah itu?
Dialogue: 0,0:23:34.23,0:23:36.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tergantung spesiesnya.
Dialogue: 0,0:23:36.98,0:23:40.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan begini, kita menjamin keamanan
Dialogue: 0,0:23:40.36,0:23:43.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pembangunan tembok pertahanan\Ntanpa harus menampakkan diri.
Dialogue: 0,0:23:43.44,0:23:44.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Naga...
Dialogue: 0,0:23:44.99,0:23:46.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku penasaran banget.
Dialogue: 0,0:23:46.53,0:23:50.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dunia lain itu naga.\NNaga itu dunia lain.
Dialogue: 0,0:23:52.37,0:23:54.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bila mungkin...
Dialogue: 0,0:23:54.29,0:23:57.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin punya peliharaan naga\Nyang muat di tangan!
Dialogue: 0,0:24:12.64,0:24:15.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berbeda dari naga yang kubayangkan,
Dialogue: 0,0:24:15.85,0:24:18.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi menurut Pipi,\Nkalau spesiesnya terlalu lemah,
Dialogue: 0,0:24:18.94,0:24:21.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}nanti bisa dibasmi Kekaisaran Ohgen.
Dialogue: 0,0:24:21.82,0:24:24.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, soal tuntutan membangun\Ntembok pertahanan
Dialogue: 0,0:24:24.73,0:24:27.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di perbatasan dengan Kekaisaran Ohgen.
Dialogue: 0,0:24:27.95,0:24:32.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami meminta Usaha Dagang Marc\Nmemasok orang-orang
Dialogue: 0,0:24:32.78,0:24:36.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan barang yang diperlukan\Nsebagai pesanan pribadi Baron Sasaki.
Dialogue: 0,0:24:36.08,0:24:39.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah dapat persetujuan\Ndari Joseph dan Marc.
Dialogue: 0,0:24:39.62,0:24:43.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan saat sibuk mengurus ini itu,
Dialogue: 0,0:24:43.46,0:24:46.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tahu-tahu beberapa hari sudah berlalu.
Dialogue: 0,0:24:46.09,0:24:50.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kali ini tidak ada waktu latihan sihir, ya.
Dialogue: 0,0:24:50.39,0:24:53.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya, aku ingin\Nmenikmati dunia lain
Dialogue: 0,0:24:53.05,0:24:56.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan lebih santai seperti berlibur.
Dialogue: 0,0:24:59.60,0:25:01.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kira-kira begitu.
Dialogue: 0,0:25:01.06,0:25:04.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Langsung saja, ayo jalin kontrak\Nuntuk permainan maut.
Dialogue: 0,0:25:04.77,0:25:07.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Butuh stempel?
Dialogue: 0,0:25:07.24,0:25:11.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah bersedia untuk bekerja sama.
Dialogue: 0,0:25:11.45,0:25:14.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma perlu menurunkan\Nsebagian rohku padamu.
Dialogue: 0,0:25:14.83,0:25:20.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin tubuhmu akan merasa\Nsedikit sensasi mengejutkan,
Dialogue: 0,0:25:20.08,0:25:22.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi tolong ditahan.
Dialogue: 0,0:25:39.23,0:25:41.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu hebat sekali menahannya.
Dialogue: 0,0:25:41.98,0:25:45.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baru kali ini Utusan tidak bersuara\Nsaat pemanggilan roh.
Dialogue: 0,0:25:45.69,0:25:50.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minimal biarkan aku siap-siap, kek.
Dialogue: 0,0:25:50.53,0:25:52.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, maaf.
Dialogue: 0,0:25:52.45,0:25:55.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus, soal permainannya.
Dialogue: 0,0:25:55.41,0:25:59.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutku, lebih baik belajar\Ndari pengalaman langsung.
Dialogue: 0,0:26:01.96,0:26:05.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di dunia ini ada iblis dan malaikat.
Dialogue: 0,0:26:05.96,0:26:10.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kedua belah pihak\Nsudah berseteru sejak dahulu,
Dialogue: 0,0:26:10.59,0:26:16.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kalau pemilik kekuatan besar\Nyang berhadapan secara langsung,
Dialogue: 0,0:26:16.01,0:26:18.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dunia ini bisa hancur.
Dialogue: 0,0:26:18.72,0:26:23.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya, kami menggunakan manusia\Nuntuk melakukan perang proksi.
Dialogue: 0,0:26:23.10,0:26:25.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alasan kamu memilih anak-anak sepertiku,
Dialogue: 0,0:26:25.86,0:26:30.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena pertarungan antara malaikat\Ndan iblis pernah berlangsung lama?
Dialogue: 0,0:26:30.57,0:26:33.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau hanya karena anak-anak
Dialogue: 0,0:26:33.15,0:26:36.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lebih mudah kalian manipulasi?
Dialogue: 0,0:26:36.20,0:26:39.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keduanya benar. Bagus!
Dialogue: 0,0:26:40.04,0:26:44.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perwakilan yang menjadi Utusan\Nakan dapat hadiah juga, kok.
Dialogue: 0,0:26:44.04,0:26:47.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau berhasil menghabisi Utusan lawan,
Dialogue: 0,0:26:47.38,0:26:50.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan mengabulkan satu\Npermintaanmu apa pun itu.
Dialogue: 0,0:26:50.76,0:26:52.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa pun itu?
Dialogue: 0,0:26:52.38,0:26:56.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untungnya, aku termasuk golongan iblis\Nyang lumayan tinggi,
Dialogue: 0,0:26:56.34,0:26:58.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi tidak akan kalah dengan mudah.
Dialogue: 0,0:26:58.39,0:27:00.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kata-kata orang belakangan ini...
Dialogue: 0,0:27:15.45,0:27:17.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, apa ini?
Dialogue: 0,0:27:17.78,0:27:21.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Langsung ada mangsa terpancing.
Dialogue: 0,0:27:21.58,0:27:25.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini ruang isolasi yang terbentuk\Nketika para Utusan
Dialogue: 0,0:27:25.62,0:27:27.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mendekat hingga jarak tertentu.
Dialogue: 0,0:27:27.38,0:27:31.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini semacam sinyal\Nyang memberi tahu permainan dimulai?
Dialogue: 0,0:27:31.17,0:27:32.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, iya.
Dialogue: 0,0:27:32.34,0:27:36.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lawan juga tahu lokasi kita?
Dialogue: 0,0:27:36.30,0:27:41.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak menyembunyikan lokasi,\Njadi kurasa kita sudah terdeteksi.
Dialogue: 0,0:27:41.85,0:27:46.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya, ucapkan ini padaku\Nbegitu kamu melihat lawan.
Dialogue: 0,0:27:46.19,0:27:47.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Muncullah."
Dialogue: 0,0:27:48.98,0:27:50.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Muncul...
Dialogue: 0,0:27:51.57,0:27:54.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, dia sudah datang.
Dialogue: 0,0:27:57.28,0:28:01.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, seriusan cewek SMP?
Dialogue: 0,0:28:04.00,0:28:05.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo!
Dialogue: 0,0:28:05.00,0:28:07.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat beri aku perintah!
Dialogue: 0,0:28:07.29,0:28:08.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya.
Dialogue: 0,0:28:09.38,0:28:12.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Abaddon, muncullah.
Dialogue: 0,0:28:12.17,0:28:15.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, serahkan padaku!
Dialogue: 0,0:28:33.57,0:28:36.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masayuki, ayo kabur dari sini.
Dialogue: 0,0:28:36.40,0:28:37.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Ta-Tapi...
Dialogue: 0,0:28:39.03,0:28:40.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu Abaddon.
Dialogue: 0,0:28:44.79,0:28:48.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bukan tandingannya sekarang.
Dialogue: 0,0:28:48.71,0:28:50.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan harap bisa kabur!
Dialogue: 0,0:29:06.43,0:29:08.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tertangkap!
Dialogue: 0,0:29:11.27,0:29:13.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Vi-Virtue!
Dialogue: 0,0:29:20.91,0:29:22.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh juga.
Dialogue: 0,0:29:39.13,0:29:41.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayang sekali.
Dialogue: 0,0:29:52.69,0:29:54.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana?
Dialogue: 0,0:29:54.15,0:29:56.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesuai ucapanku, kan?
Dialogue: 0,0:29:56.82,0:30:02.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang apa gunanya aku menemani?\NAku tidak melakukan apa-apa.
Dialogue: 0,0:30:02.32,0:30:06.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada dasarnya, kami tidak bisa bergerak\Nsesuka hati dengan mengabaikan
Dialogue: 0,0:30:06.28,0:30:08.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}perintah para perwakilan.
Dialogue: 0,0:30:08.04,0:30:10.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak ingat memberimu perintah.
Dialogue: 0,0:30:10.75,0:30:15.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bertemu malaikat, lalu aku diminta\Nmenampakkan diri di hadapannya.
Dialogue: 0,0:30:15.96,0:30:19.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin aku diam saja, kan?
Dialogue: 0,0:30:19.96,0:30:24.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, tolong pahami kami\Npunya kebebasan sebatas itu.
Dialogue: 0,0:30:24.68,0:30:28.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak, nanti kami malah didikte.
Dialogue: 0,0:30:28.51,0:30:31.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mengerti soal perintah itu.
Dialogue: 0,0:30:31.68,0:30:33.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Contohnya...
Dialogue: 0,0:30:33.39,0:30:37.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku ingin jalan lurus,\Ntapi kamu menyuruhku ke kanan,
Dialogue: 0,0:30:37.65,0:30:40.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tubuh ini akan berjalan ke kanan.
Dialogue: 0,0:30:40.03,0:30:42.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pahamkah kalau begitu?
Dialogue: 0,0:30:42.82,0:30:45.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perintahmu yang sepele ke depannya
Dialogue: 0,0:30:45.03,0:30:49.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bakal menentukan nasib kita,\Njadi tolong hati-hati.
Dialogue: 0,0:30:49.45,0:30:51.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa aku?
Dialogue: 0,0:30:53.00,0:30:57.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak gadis muda lain seusiaku, kan?
Dialogue: 0,0:30:57.13,0:30:58.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Penasaran?
Dialogue: 0,0:30:58.80,0:31:00.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mau tahu itu?
Dialogue: 0,0:31:00.38,0:31:02.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak usah kalau aku tidak perlu tahu.
Dialogue: 0,0:31:03.51,0:31:05.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu itu, ya...
Dialogue: 0,0:31:05.55,0:31:08.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku suka sisimu yang serius itu.
Dialogue: 0,0:31:08.01,0:31:10.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Top di antara seusiamu.
Dialogue: 0,0:31:11.89,0:31:13.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:31:13.31,0:31:16.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sisi lain, jauh di lubuk hatimu,
Dialogue: 0,0:31:16.31,0:31:18.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu membenci dunia ini.
Dialogue: 0,0:31:18.77,0:31:21.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mengenal rasa lapar.
Dialogue: 0,0:31:21.03,0:31:23.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan yang kamu pendam dalam dadamu
Dialogue: 0,0:31:23.69,0:31:26.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah hasrat cinta yang menyimpang.
Dialogue: 0,0:31:26.99,0:31:29.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagian itu kesukaan iblis.
Dialogue: 0,0:31:29.58,0:31:33.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih tepatnya, kesukaanku.
Dialogue: 0,0:31:33.41,0:31:36.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mengamatiku?
Dialogue: 0,0:31:36.25,0:31:40.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sederhananya, iya.
Dialogue: 0,0:31:40.09,0:31:42.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak menyembunyikannya, ya.
Dialogue: 0,0:31:42.55,0:31:44.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Percuma juga kusembunyikan.
Dialogue: 0,0:31:45.22,0:31:49.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini-begini, aku iblis yang jujur, lo.
Dialogue: 0,0:31:50.18,0:31:53.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Percuma juga berbohong soal hal sepele
Dialogue: 0,0:31:53.31,0:31:58.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ke pasangan yang mungkin akan bersamaku\Nselama bertahun-tahun.
Dialogue: 0,0:32:07.45,0:32:09.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malaikat dan iblis.
Dialogue: 0,0:32:09.03,0:32:12.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Utusan dari salah satu pihak binasa
Dialogue: 0,0:32:12.16,0:32:14.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau menjaga jarak tertentu,
Dialogue: 0,0:32:14.66,0:32:17.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ruang isolasi pun akan lenyap.
Dialogue: 0,0:32:17.25,0:32:20.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan dunia pun kembali seperti semula.
Dialogue: 0,0:32:20.33,0:32:23.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cairan tubuhku yang menempel\Ndi pakaianmu
Dialogue: 0,0:32:23.63,0:32:26.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sudah hilang juga, kan?
Dialogue: 0,0:32:26.26,0:32:30.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi luka yang disembuhkan\Ndalam ruang isolasi pun muncul lagi.
Dialogue: 0,0:32:31.72,0:32:36.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang terjadi pada laki-laki\Ndan malaikat tadi?
Dialogue: 0,0:32:36.06,0:32:38.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perwujudan roh malaikat akan lenyap.
Dialogue: 0,0:32:38.60,0:32:40.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi karena wujud aslinya ada di surga,
Dialogue: 0,0:32:40.40,0:32:42.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak ada kerusakan sama sekali.
Dialogue: 0,0:32:42.06,0:32:46.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena ruang isolasinya sudah lenyap,\Nmayat laki-lakinya mungkin ada di...
Dialogue: 0,0:32:47.11,0:32:49.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada.
Dialogue: 0,0:32:49.03,0:32:53.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejauh mana kondisi di ruang isolasi\Ntercermin pada tubuh fisik,
Dialogue: 0,0:32:53.87,0:32:55.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berbeda tergantung kasusnya.
Dialogue: 0,0:32:55.83,0:32:57.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tercermin?
Dialogue: 0,0:32:57.96,0:33:02.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tergantung situasi dan kemampuan\Nmasing-masing, kondisi kerusakan mayat
Dialogue: 0,0:33:02.17,0:33:05.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tercermin secara detail di dunia asal.
Dialogue: 0,0:33:05.67,0:33:09.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi ada juga yang jadi seolah\Nmati misterius.
Dialogue: 0,0:33:09.84,0:33:11.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu.
Dialogue: 0,0:33:12.97,0:33:16.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan, dia kalah\Ndalam permainan maut
Dialogue: 0,0:33:16.56,0:33:19.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan terusir dari ruang isolasi?
Dialogue: 0,0:33:19.35,0:33:23.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, aku yakin kamu punya\Nbanyak pertanyaan.
Dialogue: 0,0:33:23.02,0:33:24.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanya saja setelah pulang.
Dialogue: 0,0:33:24.94,0:33:26.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:33:31.70,0:33:34.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pikir berkat siapa\Nbisa hidup selama ini?
Dialogue: 0,0:33:34.95,0:33:38.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah, sudah, sudah cukup.
Dialogue: 0,0:33:38.66,0:33:42.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi dia membuatmu terluka.
Dialogue: 0,0:33:42.04,0:33:45.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putrimu pasti sudah menyesal.
Dialogue: 0,0:33:45.04,0:33:46.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, kan?
Dialogue: 0,0:33:46.84,0:33:50.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibumu tidak pandai menilai orang, ya.
Dialogue: 0,0:33:51.43,0:33:52.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu.
Dialogue: 0,0:33:54.97,0:33:59.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hampir diperkosa orang ini.
Dialogue: 0,0:34:05.86,0:34:07.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:34:07.61,0:34:09.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan mengada-ada!
Dialogue: 0,0:34:09.78,0:34:14.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu selalu bohong\Ndan cari-cari alasan?
Dialogue: 0,0:34:14.78,0:34:16.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar parasit!
Dialogue: 0,0:34:16.58,0:34:20.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak berubah, akan kuusir kamu!
Dialogue: 0,0:34:21.25,0:34:25.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau diusir, aku tidak bisa...
Dialogue: 0,0:34:26.17,0:34:28.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bisik-bisik apa?
Dialogue: 0,0:34:28.55,0:34:30.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Najis.
Dialogue: 0,0:34:30.21,0:34:34.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, ada yang belum kuberi tahu.
Dialogue: 0,0:34:34.67,0:34:38.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan dirasuki sebagian roh iblis atau malaikat,
Dialogue: 0,0:34:38.21,0:34:42.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}seorang Utusan bisa menggunakan\Nsebagian kekuatan itu.
Dialogue: 0,0:34:43.88,0:34:47.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bagi manusia, semacam sihir.
Dialogue: 0,0:34:47.61,0:34:49.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, iblis dan malaikat
Dialogue: 0,0:34:49.94,0:34:54.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak bisa membunuh\Nmanusia di luar ruang isolasi,
Dialogue: 0,0:34:54.32,0:34:57.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi Utusan tidak terikat batasan itu.
Dialogue: 0,0:34:58.08,0:35:00.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, bagaimana?
Dialogue: 0,0:35:00.12,0:35:01.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar!
Dialogue: 0,0:35:01.70,0:35:04.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar... parasit...
Dialogue: 0,0:35:04.71,0:35:06.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku diusir...
Dialogue: 0,0:35:07.04,0:35:10.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa tinggal di samping Om lagi.
Dialogue: 0,0:35:10.00,0:35:13.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku suka sisimu itu!
Dialogue: 0,0:35:14.43,0:35:18.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kuberi tahu dirimu\Nyang menyimpang itu.
Dialogue: 0,0:35:18.01,0:35:20.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba sentuh perlahan tubuh dia.
Dialogue: 0,0:35:20.68,0:35:23.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Andai aku tidak melahirkanmu.
Dialogue: 0,0:35:27.98,0:35:29.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:35:31.86,0:35:33.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}O-Oi!
Dialogue: 0,0:35:33.49,0:35:36.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana?\NSudah ingat sensasi tadi?
Dialogue: 0,0:35:36.86,0:35:39.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kalau begitu, selanjutnya kamu coba sendiri.\N- Kamu kenapa?
Dialogue: 0,0:35:39.62,0:35:40.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kalau begitu, selanjutnya kamu coba sendiri.\N- Woi!
Dialogue: 0,0:35:46.12,0:35:48.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu ambil kebanyakan,\Nmereka bisa mati, lo.
Dialogue: 0,0:35:53.51,0:35:57.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini bisa kulakukan\Ntanpa membuat orang pingsan?
Dialogue: 0,0:35:57.68,0:36:00.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa, kalau kamu pintar menahan diri.
Dialogue: 0,0:36:00.72,0:36:02.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu.
Dialogue: 0,0:36:02.14,0:36:04.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong,\Nboleh aku tanya satu hal?
Dialogue: 0,0:36:04.60,0:36:06.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:36:06.31,0:36:08.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bilang aku bakal dapat hadiah
Dialogue: 0,0:36:08.90,0:36:11.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau berhasil mengalahkan\NUtusan lawan, kan?
Dialogue: 0,0:36:11.48,0:36:15.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah pertarungan di mal tadi\Nsudah termasuk?
Dialogue: 0,0:36:15.28,0:36:19.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, muka jahat, tuh.
Dialogue: 0,0:36:19.37,0:36:21.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja tidak.
Dialogue: 0,0:36:21.70,0:36:24.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh, kok.\NBiar kuberi hadiah.
Dialogue: 0,0:36:24.29,0:36:27.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kamu inginkan\Ndari hasil pertarungan pertamamu?
Dialogue: 0,0:36:28.17,0:36:30.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:36:30.54,0:36:33.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hal yang kuinginkan...
Dialogue: 0,0:36:35.97,0:36:37.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang.
Dialogue: 0,0:36:39.80,0:36:41.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pulang.
Dialogue: 0,0:36:42.56,0:36:45.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhir-akhir ini, Om terlihat sibuk.
Dialogue: 0,0:36:45.72,0:36:47.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja?
Dialogue: 0,0:36:47.85,0:36:51.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya, kira-kira begitu.
Dialogue: 0,0:36:51.77,0:36:54.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, suaranya tidak berisik?
Dialogue: 0,0:36:54.98,0:36:56.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa masih terdengar?
Dialogue: 0,0:36:57.07,0:36:58.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.
Dialogue: 0,0:36:58.74,0:37:03.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga minta maaf\Nsudah tanya hal aneh.
Dialogue: 0,0:37:03.03,0:37:04.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.
Dialogue: 0,0:37:04.33,0:37:07.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masalah seperti ini sebaiknya\Ndiselesaikan secepatnya.
Dialogue: 0,0:37:07.79,0:37:11.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang boleh aku\Nmenerima sebanyak ini?
Dialogue: 0,0:37:11.00,0:37:15.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya aku bakal sering sibuk.
Dialogue: 0,0:37:15.13,0:37:18.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu juga mengubah ritme kehidupanku,
Dialogue: 0,0:37:18.76,0:37:21.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi kesempatan kita bertemu\Nmungkin akan berkurang.
Dialogue: 0,0:37:22.97,0:37:25.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa hidup berkat Om.
Dialogue: 0,0:37:26.31,0:37:29.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam beberapa tahun terakhir, selalu.
Dialogue: 0,0:37:30.98,0:37:32.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi...
Dialogue: 0,0:37:34.19,0:37:38.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena dia sudah merawat\Ndan memberi banyak hal,
Dialogue: 0,0:37:39.24,0:37:44.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku harus balas budi ke Om.
Dialogue: 0,0:37:46.99,0:37:50.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja, aku tidak memaksa.
Dialogue: 0,0:37:50.71,0:37:52.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:37:52.75,0:37:54.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, maaf, ya.
Dialogue: 0,0:37:54.71,0:37:55.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:37:56.59,0:37:59.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu dicintai seperti biasa, ya.
Dialogue: 0,0:38:00.34,0:38:04.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, iya. Aku tepati janjiku.
Dialogue: 0,0:38:12.90,0:38:15.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Om, ada apa?
Dialogue: 0,0:38:15.31,0:38:18.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, bukan apa-apa.
Dialogue: 0,0:38:18.07,0:38:21.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya sudah, aku pamit dulu.
Dialogue: 0,0:38:24.49,0:38:30.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang kamu cintai\Nimannya kuat, ya.
Dialogue: 0,0:38:30.25,0:38:31.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hadiah.
Dialogue: 0,0:38:31.71,0:38:34.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bilang cuma begini saja?
Dialogue: 0,0:38:34.75,0:38:37.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bakal mencarimu dalam waktu dekat.
Dialogue: 0,0:38:38.71,0:38:41.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harus, dong.
Dialogue: 0,0:38:51.68,0:38:54.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan itu tadi?
Dialogue: 0,0:38:54.27,0:38:56.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu kardiomiopati?
Dialogue: 0,0:38:56.77,0:39:01.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku belum pernah dengar\Nada gejala peningkatan hasrat seksual.
Dialogue: 0,0:39:01.36,0:39:03.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kisanak, ada apa?
Dialogue: 0,0:39:03.61,0:39:06.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya! Aku konsultasi ke Pipi saja!
Dialogue: 0,0:39:06.24,0:39:09.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku amati dulu, deh.
Dialogue: 0,0:39:09.79,0:39:14.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kamu punya sifat\Nyang merepotkan juga, ya.
Dialogue: 0,0:39:14.92,0:39:16.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iyakah?
Dialogue: 0,0:39:16.17,0:39:20.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bakal lebih cepat kalau\Nmembuatnya jatuh cinta padamu.
Dialogue: 0,0:39:20.80,0:39:23.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada artinya kalau begitu.
Dialogue: 0,0:39:23.13,0:39:28.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi masa cuma merangsang\Nhasrat seksualnya?
Dialogue: 0,0:39:28.60,0:39:31.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Om yang tidak kuat\Nmenahan hasrat seksualnya
Dialogue: 0,0:39:31.52,0:39:35.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}memerkosaku atas kehendaknya\Nsendiri, itu baru bagus.
Dialogue: 0,0:39:36.35,0:39:39.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah dia melampiaskan\Nhasratnya sesuka hati,
Dialogue: 0,0:39:39.77,0:39:43.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tiba-tiba dia kembali tenang dan menyesal,
Dialogue: 0,0:39:43.69,0:39:46.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu giliran aku yang menghiburnya.
Dialogue: 0,0:39:46.99,0:39:49.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Proses itulah yang penting.
Dialogue: 0,0:39:51.49,0:39:55.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang menerima luapan rasa itu\Npasti kelabakan.
Dialogue: 0,0:39:55.62,0:39:57.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja.
Dialogue: 0,0:39:57.29,0:40:00.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Om pasti mau menerimaku apa adanya.
Dialogue: 0,0:40:00.38,0:40:03.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kepercayaan dirimu datang dari mana?
Dialogue: 0,0:40:05.17,0:40:09.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kami mirip.
Dialogue: 0,0:40:10.47,0:40:14.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, ya. Perutku agak sakit.
Dialogue: 0,0:40:14.02,0:40:15.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu baik-baik saja?
Dialogue: 0,0:40:16.52,0:40:18.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya.
Dialogue: 0,0:40:18.31,0:40:22.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo? Ada kontak dari Futari Shizuka.
Dialogue: 0,0:40:26.15,0:40:28.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini aku! Aku!
Dialogue: 0,0:40:28.16,0:40:30.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah tidur?
Dialogue: 0,0:40:30.62,0:40:33.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya bukan hal mendesak, ya.
Dialogue: 0,0:40:33.54,0:40:38.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa kita bicara\Nsebelum ke kantor besok pagi?
Dialogue: 0,0:40:38.17,0:40:40.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang jemput juga boleh.
Dialogue: 0,0:40:40.13,0:40:43.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, boleh minta tolong?
Dialogue: 0,0:40:43.13,0:40:46.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bisa di swalayan dekat sini.
Dialogue: 0,0:40:46.88,0:40:48.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, siap laksanakan.
Dialogue: 0,0:40:48.84,0:40:50.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada urusan apa?
Dialogue: 0,0:40:50.72,0:40:51.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak tahu.
Dialogue: 0,0:40:51.97,0:40:55.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang jelas bukan urusan sepele, kan?
Dialogue: 0,0:40:59.65,0:41:02.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, bisa tolong jaga rumah?
Dialogue: 0,0:41:02.86,0:41:06.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, aku akan berselancar di internet.
Dialogue: 0,0:41:06.86,0:41:09.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pipi suka internet, ya.
Dialogue: 0,0:41:09.82,0:41:12.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Susah bosannya.
Dialogue: 0,0:41:12.62,0:41:14.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bisa menghiburku sementara waktu.
Dialogue: 0,0:41:16.08,0:41:17.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berangkat.
Dialogue: 0,0:41:17.25,0:41:19.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hati-hati.
Dialogue: 0,0:41:19.46,0:41:21.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Pipi.
Dialogue: 0,0:41:21.92,0:41:26.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahagia sekali rasanya\Nada yang mengantar kepergianku.
Dialogue: 0,0:41:34.64,0:41:36.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal tugas tempo hari.
Dialogue: 0,0:41:36.77,0:41:41.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengetahui banyak hal menarik\Ntentang atasanmu itu.
Dialogue: 0,0:41:41.77,0:41:44.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus terang saja.
Dialogue: 0,0:41:44.36,0:41:49.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keributan di arena boling itu\Nadalah ulahnya sendiri.
Dialogue: 0,0:41:49.36,0:41:50.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:41:50.07,0:41:54.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah mengonfirmasinya langsung\Ndengan rambut gondrong menjijikkan itu.
Dialogue: 0,0:41:54.24,0:41:56.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah itu?
Dialogue: 0,0:41:56.62,0:41:59.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa jadi diberi informasi palsu?
Dialogue: 0,0:41:59.25,0:42:00.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pikirku juga begitu, kok.
Dialogue: 0,0:42:00.96,0:42:04.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi walau aku mengungkit nama kalian,
Dialogue: 0,0:42:04.13,0:42:07.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pria itu tetap keras pada pendiriannya.
Dialogue: 0,0:42:07.25,0:42:11.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, kalau diingat-ingat lagi,\Ndalam kekacauan itu,
Dialogue: 0,0:42:11.43,0:42:13.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}semua orang menerima perintah,\Nbukan cuma aku.
Dialogue: 0,0:42:13.68,0:42:17.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Pokoknya jangan bunuh atasanmu."
Dialogue: 0,0:42:17.60,0:42:21.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu alasan yang sulit disangkal.
Dialogue: 0,0:42:21.64,0:42:26.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu itu, kupikir bisa dimanfaatkan...
Dialogue: 0,0:42:26.86,0:42:31.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jujur saja, saya tidak tahu\Napa yang bisa dimanfaatkan darinya.
Dialogue: 0,0:42:31.03,0:42:33.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga tidak tahu soal itu.
Dialogue: 0,0:42:33.86,0:42:35.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak paham sama sekali.
Dialogue: 0,0:42:35.32,0:42:39.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah ada kemungkinan dia bersekongkol\Ndengan pria berambut panjang itu?
Dialogue: 0,0:42:39.33,0:42:43.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, sponsornya saja\Nbermusuhan dengan kantor.
Dialogue: 0,0:42:43.42,0:42:46.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi bisa-bisanya bekerja sama.
Dialogue: 0,0:42:46.88,0:42:51.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak jelaskan rincinya,\Ntapi pihak luar mulai ikut campur.
Dialogue: 0,0:42:51.17,0:42:54.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenalan bersama, mungkin?
Dialogue: 0,0:42:54.59,0:42:57.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau mungkin di tahap ini
Dialogue: 0,0:42:57.64,0:43:00.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak ada keuntungan sama sekali.
Dialogue: 0,0:43:02.10,0:43:06.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, kamu kerja bersama dia,
Dialogue: 0,0:43:06.15,0:43:08.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak ada yang mengganjal pikiranmu?
Dialogue: 0,0:43:08.44,0:43:11.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misalnya, motif dasinya\Ntiba-tiba jadi mencolok
Dialogue: 0,0:43:11.69,0:43:14.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau terlihat dekat dengan wanita...
Dialogue: 0,0:43:14.36,0:43:17.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia orang yang tidak ada celahnya, sih.
Dialogue: 0,0:43:20.83,0:43:25.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutku, sementara ini kita\Nharus mewaspadainya.
Dialogue: 0,0:43:25.79,0:43:28.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, saya akan waspada.
Dialogue: 0,0:43:28.38,0:43:31.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya senang bersama kolega\Nyang dapat diandalkan.
Dialogue: 0,0:43:31.96,0:43:33.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:43:33.67,0:43:37.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, bisa tolong hilangkan\Nyang ada di punggung tanganku ini?
Dialogue: 0,0:43:45.85,0:43:50.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong minta ke Pipi.\NSaya sendiri tidak bisa.
Dialogue: 0,0:43:50.44,0:43:53.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa, sih?\NDasar kolega tidak berguna!
Dialogue: 0,0:44:02.04,0:44:06.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya mohon maaf soal itu.
Dialogue: 0,0:44:06.16,0:44:08.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serius?
Dialogue: 0,0:44:08.00,0:44:10.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Woi, bahaya banget!\N- Ya, saya berulang kali merasa tidak enak.
Dialogue: 0,0:44:10.50,0:44:11.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Lari! Lari!\N- Ya, saya berulang kali merasa tidak enak.
Dialogue: 0,0:44:11.55,0:44:13.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tunggu!\N- Kok ribut sekali?
Dialogue: 0,0:44:13.34,0:44:15.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Apa itu?\N- Kok ribut sekali?
Dialogue: 0,0:44:15.13,0:44:17.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ada monster raksasa yang menyerang?
Dialogue: 0,0:44:17.88,0:44:20.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tidak lucu, tahu.
Dialogue: 0,0:44:22.60,0:44:23.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:44:23.56,0:44:27.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sasaki, tolong ke TKP secepatnya.
Dialogue: 0,0:44:27.06,0:44:31.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya ke keributan\Nyang terjadi di depan mata kami?
Dialogue: 0,0:44:31.52,0:44:34.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang kamu langsung paham.
Dialogue: 0,0:44:34.74,0:44:38.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dilihat dari lokasi perangkat,\Nkamu bersama Futari Shizuka, kan?
Dialogue: 0,0:44:39.45,0:44:42.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelihatannya lawan bertindak sendiri,
Dialogue: 0,0:44:42.33,0:44:45.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi tolong selesaikan dengan cepat.
Dialogue: 0,0:44:45.29,0:44:47.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa lawannya?
Dialogue: 0,0:44:47.58,0:44:52.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis Penyihir mengamuk\Nke pemilik kekuatan liar.
Dialogue: 0,0:44:59.26,0:45:03.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Futari Shizuka, ada panggilan tugas.
Dialogue: 0,0:45:03.01,0:45:05.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya, ada Gadis Penyihir mengamuk.
Dialogue: 0,0:45:05.72,0:45:08.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis Penyihir itu lagi?
Dialogue: 0,0:45:08.94,0:45:10.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malasnya.
Dialogue: 0,0:45:10.56,0:45:13.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa boleh buat\Nkalau itu perintah atasan.
Dialogue: 0,0:45:13.36,0:45:16.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo semangat kerja.
Dialogue: 0,0:45:16.28,0:45:19.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya tidak bisa menanganinya sendiri.
Dialogue: 0,0:45:19.11,0:45:21.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, tolong bantuannya.
Dialogue: 0,0:45:28.79,0:45:30.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu!
Dialogue: 0,0:45:36.92,0:45:39.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kupikir bakal mati!
