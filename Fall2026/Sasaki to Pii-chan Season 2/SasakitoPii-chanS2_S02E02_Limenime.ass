Dialogue: 0,0:02:47.73,0:02:55.32,sign,,0000,0000,0000,,SASAKI DAN PIPI S2
Dialogue: 0,0:04:07.56,0:04:10.31,sign,,0000,0000,0000,,EPISODE 2: PERMAINAN MAUT DAN IBLIS
Dialogue: 0,0:05:45.07,0:05:47.08,sign,,0000,0000,0000,,ROTI HANGAT ANGEL
Dialogue: 0,0:00:16.45,0:00:19.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, enaknya bagaimana, ya?
Dialogue: 0,0:00:19.42,0:00:22.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana, ya...
Dialogue: 0,0:00:22.21,0:00:25.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau kamu olahraga sedikit?
Dialogue: 0,0:00:25.88,0:00:28.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mo-Mohon maaf.
Dialogue: 0,0:00:28.63,0:00:33.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Musuh cuma sendirian, bagaimana\Nkalau kita serang dari depan?
Dialogue: 0,0:00:33.26,0:00:37.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dia memakai bidang sihir,\Nnanti aku mati kutu, dong?
Dialogue: 0,0:00:37.64,0:00:41.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya juga, dulu juga kacau karena itu.
Dialogue: 0,0:00:41.69,0:00:44.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi-lagi bahas itu.
Dialogue: 0,0:00:58.50,0:01:02.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kolegamu ditembak, kok malah senang?
Dialogue: 0,0:01:02.50,0:01:05.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, yang penting kamu baik-baik saja.
Dialogue: 0,0:01:05.80,0:01:09.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski terlihat serius,\Nkamu punya sisi nyeleneh, ya.
Dialogue: 0,0:01:09.97,0:01:14.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah memasang sihir pelindung\Nuntuk mengantisipasi sinar ajaib.
Dialogue: 0,0:01:14.72,0:01:17.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lain kali bilang dulu, dong?
Dialogue: 0,0:01:18.64,0:01:22.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Om mau menggangguku lagi?
Dialogue: 0,0:01:22.52,0:01:25.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Om ini polisi.
Dialogue: 0,0:01:25.19,0:01:27.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi harus melindungi kota.
Dialogue: 0,0:01:27.23,0:01:29.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ih, jawaban macam apa itu?
Dialogue: 0,0:01:29.86,0:01:32.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak gaya banget.
Dialogue: 0,0:01:32.11,0:01:34.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa jangan menyelang dulu?
Dialogue: 0,0:01:34.12,0:01:35.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Habisnya...
Dialogue: 0,0:01:35.07,0:01:38.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku melulu yang jadi bulan-bulanan,\Njadi kesal melihatnya!
Dialogue: 0,0:01:38.83,0:01:41.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Om akrab dengan pemilik kekuatan?
Dialogue: 0,0:01:41.83,0:01:45.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, kami berdua adalah sohib!
Dialogue: 0,0:01:45.50,0:01:47.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu dulu!
Dialogue: 0,0:01:47.13,0:01:49.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan seenaknya menjawab\Nuntuk orang lain.
Dialogue: 0,0:01:49.59,0:01:50.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ih, jahat!
Dialogue: 0,0:01:50.76,0:01:54.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal kamu pernah bilang\Nmau akrab denganku!
Dialogue: 0,0:01:54.18,0:01:57.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minimal lihat situasinya, dong.
Dialogue: 0,0:01:58.10,0:02:00.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian terlihat akrab, ya.
Dialogue: 0,0:02:00.60,0:02:02.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga
Dialogue: 0,0:02:02.56,0:02:05.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ingin lebih akrab denganmu.
Dialogue: 0,0:02:05.94,0:02:08.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ih, gonta-ganti cewek.
Dialogue: 0,0:02:08.57,0:02:09.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar hidung belang.
Dialogue: 0,0:02:09.72,0:02:13.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Futari Shizuka, bisa diam sebentar?
Dialogue: 0,0:02:13.15,0:02:17.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa Om berteman\Ndengan pemilik kekuatan?
Dialogue: 0,0:02:17.62,0:02:21.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih menyenangkan berteman\Ndaripada bertengkar, kan?
Dialogue: 0,0:02:22.12,0:02:24.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama sekali tidak.
Dialogue: 0,0:02:25.12,0:02:28.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin membunuh\Npemilik kekuatan yang di situ.
Dialogue: 0,0:02:33.09,0:02:35.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini?
Dialogue: 0,0:04:07.56,0:04:10.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu melakukan sesuatu lagi?
Dialogue: 0,0:04:10.31,0:04:11.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:04:11.44,0:04:15.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tahu kekuatan super semacam ini?
Dialogue: 0,0:04:16.36,0:04:19.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belum bisa komentar.
Dialogue: 0,0:04:19.36,0:04:24.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini kekuatan yang secara selektif\Nmenyingkirkan benda-benda tertentu
Dialogue: 0,0:04:24.12,0:04:27.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dalam area terbatas,\Nterutama makhluk hidup?
Dialogue: 0,0:04:27.91,0:04:31.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya, Magical Pink juga\Ntidak tahu-menahu.
Dialogue: 0,0:04:31.75,0:04:35.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, andai saja ada Pipi...
Dialogue: 0,0:04:35.21,0:04:39.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekilas, rasanya ada cahaya\Nyang menyelimuti kita.
Dialogue: 0,0:04:39.34,0:04:41.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Benarkah?
Dialogue: 0,0:04:41.76,0:04:43.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum pasti, sih.
Dialogue: 0,0:04:43.68,0:04:47.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau terjadi di sekitar kita,\Nyang pertama kali terpikirkan
Dialogue: 0,0:04:47.48,0:04:51.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah sihir penghalang\Nyang diajarkan Pipi.
Dialogue: 0,0:04:53.94,0:04:56.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oi, ada sesuatu yang terbang.
Dialogue: 0,0:04:56.48,0:04:57.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:05:03.70,0:05:06.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlihat ramai, ya.
Dialogue: 0,0:05:06.70,0:05:08.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya begitu.
Dialogue: 0,0:05:08.87,0:05:10.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa bicara sebentar?
Dialogue: 0,0:05:10.29,0:05:11.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:05:12.17,0:05:16.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin kamu memang punya\Nunek-unek terhadap kami.
Dialogue: 0,0:05:16.75,0:05:21.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, bagaimana kalau kita\Nbekerja sama dulu untuk keluar
Dialogue: 0,0:05:21.18,0:05:23.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dari situasi janggal ini?
Dialogue: 0,0:05:23.72,0:05:28.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, gampangnya anggap saja\Ngencatan senjata dulu.
Dialogue: 0,0:05:31.39,0:05:35.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pun masih ingin bisa balas dendam\Nke para pemilik kekuatan, kan?
Dialogue: 0,0:05:37.48,0:05:40.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, aku akan membantu\NPenyihir Paruh Baya.
Dialogue: 0,0:05:42.15,0:05:45.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhasil!
Dialogue: 0,0:05:51.37,0:05:53.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kamu kalahkan?
Dialogue: 0,0:05:53.12,0:05:55.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat saja sendiri.
Dialogue: 0,0:06:05.72,0:06:07.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Naomi!
Dialogue: 0,0:06:07.10,0:06:09.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gila, cuma pakai satu serangan?
Dialogue: 0,0:06:09.52,0:06:11.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bukan iblis biasa.
Dialogue: 0,0:06:13.89,0:06:17.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana nasib Utusan\Nyang kehilangan partnernya?
Dialogue: 0,0:06:17.36,0:06:20.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja tidak tertolong.
Dialogue: 0,0:06:21.61,0:06:24.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, bisa beri aku perintah?
Dialogue: 0,0:06:25.36,0:06:28.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalahkan orang-orang\Nyang ada di depan juga.
Dialogue: 0,0:06:28.20,0:06:32.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wanita yang kabur sekaligus malaikat\Ndan Utusan yang mengejarnya,
Dialogue: 0,0:06:32.37,0:06:34.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menurutku bisa diurus belakangan.
Dialogue: 0,0:06:34.87,0:06:36.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keputusan bijak.
Dialogue: 0,0:06:36.83,0:06:39.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukasih nilai 60, deh.
Dialogue: 0,0:06:39.67,0:06:42.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sisa 40-nya bagaimana?
Dialogue: 0,0:06:42.17,0:06:46.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah pernah bilang,\Nbegitu ruang isolasi kembali,
Dialogue: 0,0:06:46.30,0:06:48.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}semuanya seolah tidak pernah terjadi.
Dialogue: 0,0:06:48.35,0:06:51.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau melawan malaikat biasa,\Naku bisa meratakan lawan
Dialogue: 0,0:06:51.81,0:06:55.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sekaligus area sekitar\Ndengan satu serangan.
Dialogue: 0,0:06:55.06,0:06:58.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lain kali akan kuberi perintah\Nyang lebih gila lagi.
Dialogue: 0,0:06:58.52,0:07:02.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}E-Eh, jangan-jangan iblis ini\Nyang mengalahkan Virtue?
Dialogue: 0,0:07:02.86,0:07:05.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malaikat masih aman kalau mati.
Dialogue: 0,0:07:05.24,0:07:07.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kita mati habislah sudah!
Dialogue: 0,0:07:07.78,0:07:10.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya kita mundur dulu.
Dialogue: 0,0:07:10.49,0:07:15.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cukup mengobrolnya,\Nayo kalahkan para malaikat.
Dialogue: 0,0:07:15.00,0:07:16.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong, Abaddon.
Dialogue: 0,0:07:16.96,0:07:18.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan padaku!
Dialogue: 0,0:07:21.38,0:07:22.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Curang, ah.
Dialogue: 0,0:07:22.92,0:07:27.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya polisi boleh mencuri sepeda?
Dialogue: 0,0:07:27.09,0:07:31.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kaki yang kamu banggakan itu\Nkenapa tidak dipakai?
Dialogue: 0,0:07:31.31,0:07:35.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu masih dendam sama kejadian\Nsebelum tiba di TKP?
Dialogue: 0,0:07:35.89,0:07:38.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, mana mungkin.
Dialogue: 0,0:07:41.61,0:07:43.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Barusan itu cukup dekat.
Dialogue: 0,0:07:43.69,0:07:46.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke-Kenapa?
Dialogue: 0,0:07:46.15,0:07:48.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak sendirian?
Dialogue: 0,0:07:49.37,0:07:50.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu...
Dialogue: 0,0:07:50.91,0:07:52.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan mendekat!
Dialogue: 0,0:07:54.12,0:07:57.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, kami ingin bicara sebentar.
Dialogue: 0,0:07:57.29,0:08:00.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang terbang itu iblis, kan?
Dialogue: 0,0:08:01.67,0:08:03.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku?
Dialogue: 0,0:08:03.21,0:08:06.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan kamu Utusan, kan?
Dialogue: 0,0:08:06.47,0:08:09.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, apa itu Utusan?
Dialogue: 0,0:08:09.80,0:08:14.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan mendekat! Jangan!\NTolong ampuni aku!
Dialogue: 0,0:08:14.43,0:08:19.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu akan dapat hadiah\Nkalau mengampuniku.
Dialogue: 0,0:08:19.60,0:08:22.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, tolong...
Dialogue: 0,0:08:22.65,0:08:25.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dirayu habis-habisan.
Dialogue: 0,0:08:25.44,0:08:30.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, saya tidak ada hubungan\Ndengan gadis ini.
Dialogue: 0,0:08:30.20,0:08:31.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bohong!
Dialogue: 0,0:08:31.78,0:08:34.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu kenapa kalian di ruang isolasi?
Dialogue: 0,0:08:34.65,0:08:36.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ruang isolasi?
Dialogue: 0,0:08:36.40,0:08:38.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu nama kekuatan supernya?
Dialogue: 0,0:08:38.87,0:08:41.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong biarkan aku pergi!
Dialogue: 0,0:08:41.53,0:08:44.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh, kan?\NNamaku Akemi.
Dialogue: 0,0:08:44.34,0:08:47.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa pun akan kulakukan\Ndemi cowok gagah sepertimu!
Dialogue: 0,0:08:47.92,0:08:49.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eng...
Dialogue: 0,0:08:49.88,0:08:52.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Naomi, kamu tidak apa-apa?
Dialogue: 0,0:08:52.05,0:08:53.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takayoshi!
Dialogue: 0,0:08:53.30,0:08:57.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takayoshi, mereka tiba-tiba\Ndatang untuk membunuhku.
Dialogue: 0,0:08:57.43,0:09:00.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja, aku akan melindungimu.
Dialogue: 0,0:09:00.81,0:09:05.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal tadi bilangnya Akemi,\Nsekarang jadi Naomi.
Dialogue: 0,0:09:05.40,0:09:06.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keren!
Dialogue: 0,0:09:06.65,0:09:10.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apaan wanita ini?\NSikapnya berubah-ubah.
Dialogue: 0,0:09:10.40,0:09:14.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa pun pasti begitu\Nkalau nyawanya terancam.
Dialogue: 0,0:09:14.07,0:09:16.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru yang membuatku penasaran...
Dialogue: 0,0:09:17.83,0:09:18.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia
Dialogue: 0,0:09:18.83,0:09:22.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}orang yang terbang\Ndi atas gedung tadi, kan?
Dialogue: 0,0:09:22.83,0:09:26.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami tidak akan terbunuh iblis!
Dialogue: 0,0:09:26.59,0:09:29.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dan Naomi pasti menang\Ndan bertahan hidup!
Dialogue: 0,0:09:29.22,0:09:31.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, benar!
Dialogue: 0,0:09:33.64,0:09:35.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat saja, Naomi.
Dialogue: 0,0:09:35.47,0:09:38.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan mengalahkan iblis ini\Ndengan mudah.
Dialogue: 0,0:09:38.18,0:09:40.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semangat, Takayoshi!\NAku mencintaimu!
Dialogue: 0,0:09:41.19,0:09:44.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak pemilik kekuatan?
Dialogue: 0,0:09:44.56,0:09:46.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:09:46.02,0:09:50.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertanyaan itu bisa mematikan\Nkalau salah jawab!
Dialogue: 0,0:09:50.74,0:09:54.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?\NKamu bicara apa, sih, Iblis?
Dialogue: 0,0:09:54.57,0:09:58.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, izin memastikan satu hal.
Dialogue: 0,0:09:58.66,0:10:01.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Utusan iblis sepertimu mau apa?
Dialogue: 0,0:10:01.71,0:10:05.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksud iblis\Nyang kamu bicarakan itu?
Dialogue: 0,0:10:05.42,0:10:09.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makhluk melayang ini\Niblis yang tunduk padamu, kan?
Dialogue: 0,0:10:09.67,0:10:12.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bocah berbaju khas Jepang itu\Njuga mencurigakan,
Dialogue: 0,0:10:12.68,0:10:14.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi biar sajalah.
Dialogue: 0,0:10:14.68,0:10:17.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama bisa mengalahkan iblisnya,
Dialogue: 0,0:10:17.14,0:10:19.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Utusan-nya bisa diurus belakangan.
Dialogue: 0,0:10:19.89,0:10:23.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, dia Magical Pink.
Dialogue: 0,0:10:23.35,0:10:28.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak merasakan kekuatan besar,\Ndia bukan iblis yang hebat, kan?
Dialogue: 0,0:10:28.11,0:10:29.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arkhe!
Dialogue: 0,0:10:29.11,0:10:30.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Habisi dia!
Dialogue: 0,0:10:30.61,0:10:32.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu yakin?
Dialogue: 0,0:10:32.28,0:10:35.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, kalau tidak bisa\Nmengalahkan satu iblis pun,
Dialogue: 0,0:10:35.91,0:10:39.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan malu pada malaikat\Nyang membantu Naomi.
Dialogue: 0,0:10:39.74,0:10:41.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:11:02.98,0:11:06.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang telah...
Dialogue: 0,0:11:09.19,0:11:11.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kaya nutrisi, ya.
Dialogue: 0,0:11:11.94,0:11:15.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah lama tidak mengisap sebanyak ini.
Dialogue: 0,0:11:15.24,0:11:16.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arkhe!
Dialogue: 0,0:11:18.70,0:11:20.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah.
Dialogue: 0,0:11:20.28,0:11:24.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, ayo kejar malaikat\Ndan Utusannya yang kabur.
Dialogue: 0,0:11:24.00,0:11:25.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo.
Dialogue: 0,0:11:26.37,0:11:31.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka menghapus keberadaannya,\Nbiar kucari dari ketinggian.
Dialogue: 0,0:11:31.21,0:11:33.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu ikuti dari bawah saja.
Dialogue: 0,0:11:33.42,0:11:37.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak mau memberiku\Nkekuatan untuk terbang?
Dialogue: 0,0:11:37.26,0:11:42.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma satu kekuatan yang bisa diberikan\Nmalaikat dan iblis ke Utusannya.
Dialogue: 0,0:11:42.51,0:11:43.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu...
Dialogue: 0,0:11:43.77,0:11:47.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah memberimu kekuatan\Nuntuk memanipulasi nyawa.
Dialogue: 0,0:11:47.73,0:11:50.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini juga aturan perang proksi.
Dialogue: 0,0:11:51.19,0:11:53.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu mau kekuatan tambahan,
Dialogue: 0,0:11:53.69,0:11:56.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mintalah sebagai hadiah\Ndari permainan ini.
Dialogue: 0,0:11:57.95,0:12:01.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu tidak keberatan\Nterbang sambil kupeluk,
Dialogue: 0,0:12:01.70,0:12:03.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa-bisa saja, sih.
Dialogue: 0,0:12:03.87,0:12:05.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:12:05.12,0:12:08.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan jalan dari bawah,\Ntunjukkan arahnya.
Dialogue: 0,0:12:08.71,0:12:10.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, serahkan padaku!
Dialogue: 0,0:12:11.67,0:12:14.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Om saja tidak pernah memelukku,
Dialogue: 0,0:12:14.34,0:12:17.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ogah banget dipeluk iblis tidak jelas itu.
Dialogue: 0,0:12:18.76,0:12:21.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru aku ingin memeluk Om.
Dialogue: 0,0:12:21.72,0:12:24.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin memeluk daripada dipeluk!
Dialogue: 0,0:12:24.01,0:12:27.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin membenamkan wajah ke dadanya,
Dialogue: 0,0:12:27.23,0:12:29.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu menarik napas dalam-dalam.
Dialogue: 0,0:12:33.40,0:12:34.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Om...
Dialogue: 0,0:12:40.45,0:12:42.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arkhe!
Dialogue: 0,0:12:47.16,0:12:51.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu maju?\NPadahal aku yang diincar.
Dialogue: 0,0:12:51.63,0:12:55.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita sedang dalam gencatan senjata, kan?
Dialogue: 0,0:12:55.84,0:12:59.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemungkinan karena tidak mau\Ndiserang dari belakang,
Dialogue: 0,0:12:59.38,0:13:01.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}makanya dia inisiatif ambil tindakan dulu.
Dialogue: 0,0:13:01.80,0:13:05.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku suka sifat cermatnya Futari Shizuka.
Dialogue: 0,0:13:05.89,0:13:07.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Takayoshi!
Dialogue: 0,0:13:07.35,0:13:10.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sia-sia saja kalau malaikatmu kalah, kan?
Dialogue: 0,0:13:10.35,0:13:12.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, tapi dia belum menghilang.
Dialogue: 0,0:13:12.69,0:13:16.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, selanjutnya yang mana dulu?
Dialogue: 0,0:13:17.48,0:13:22.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Futari Shizuka seharusnya tahu melumpuhkan\Ndan membawa seseorang ke markas
Dialogue: 0,0:13:22.53,0:13:24.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan dicurigai sebagai pemilik kekuatan.
Dialogue: 0,0:13:25.62,0:13:28.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, bagaimana?
Dialogue: 0,0:13:28.50,0:13:30.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sengaja mengancam, ya?
Dialogue: 0,0:13:30.37,0:13:31.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tu-Tunggu!
Dialogue: 0,0:13:31.79,0:13:33.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Bunuh aku saja, jangan Naomi!\N- Dia saja!
Dialogue: 0,0:13:34.96,0:13:36.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Naomi?
Dialogue: 0,0:13:36.67,0:13:38.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi itu bukan keputusanku.
Dialogue: 0,0:13:38.63,0:13:40.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terserah mau apakan laki-laki ini.
Dialogue: 0,0:13:40.63,0:13:42.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong, akan kulakukan apa pun.
Dialogue: 0,0:13:45.47,0:13:48.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, kasihan banget.
Dialogue: 0,0:13:48.56,0:13:53.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Blak-blakan begitu malah bikin aku lega.
Dialogue: 0,0:13:54.61,0:13:56.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemilik kekuatan akan kubunuh.
Dialogue: 0,0:13:56.82,0:14:00.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini gawat!\NDia mau pakai sinar ajaib!
Dialogue: 0,0:14:00.28,0:14:01.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu dulu...
Dialogue: 0,0:14:01.45,0:14:03.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketemu!
Dialogue: 0,0:14:07.41,0:14:09.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa dia ke sini?
Dialogue: 0,0:14:09.91,0:14:13.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu dulu!\NKenapa aku?
Dialogue: 0,0:14:13.12,0:14:16.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena perintah Utusan itu mutlak.
Dialogue: 0,0:14:16.25,0:14:18.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Izin menghabisimu.
Dialogue: 0,0:14:25.80,0:14:26.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Futari Shizuka!
Dialogue: 0,0:14:26.89,0:14:28.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Magical Pink juga!
Dialogue: 0,0:14:31.27,0:14:32.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mohon...
Dialogue: 0,0:14:32.27,0:14:36.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong aku...\NAku tidak mau mati...
Dialogue: 0,0:14:36.19,0:14:38.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayang sekali.
Dialogue: 0,0:14:39.78,0:14:42.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa.
Dialogue: 0,0:14:43.65,0:14:46.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak!
Dialogue: 0,0:14:53.71,0:14:55.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong...
Dialogue: 0,0:15:00.80,0:15:03.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ruang isolasinya hilang?
Dialogue: 0,0:15:05.22,0:15:07.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan ini?
Dialogue: 0,0:15:07.68,0:15:09.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita kembali ke dunia asal.
Dialogue: 0,0:15:11.06,0:15:13.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus mulai dari mana?
Dialogue: 0,0:15:13.14,0:15:16.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin melepas semuanya\Ndan kabur ke dunia lain.
Dialogue: 0,0:15:16.15,0:15:19.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malaikat atau iblis\Nyang kehilangan Utusan
Dialogue: 0,0:15:19.61,0:15:22.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan dipulangkan secara paksa\Nentah apa pun strateginya.
Dialogue: 0,0:15:22.94,0:15:23.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti,
Dialogue: 0,0:15:23.86,0:15:27.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mereka bukan malaikat, iblis,\Nataupun Utusan?
Dialogue: 0,0:15:28.45,0:15:31.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kalian siapa?
Dialogue: 0,0:15:33.33,0:15:34.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Futari Shizuka.
Dialogue: 0,0:15:34.87,0:15:37.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong hubungi Kabag.
Dialogue: 0,0:15:37.25,0:15:38.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:15:38.79,0:15:43.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Magical Pink, tolong turun ke tanah dulu.
Dialogue: 0,0:15:43.01,0:15:46.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, sesuai permintaan\NPenyihir Paruh Baya.
Dialogue: 0,0:15:46.30,0:15:47.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:15:47.84,0:15:52.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bilang kamu bisa melihatku\Nsaat kita bertemu sebelumnya?
Dialogue: 0,0:15:52.47,0:15:54.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya?
Dialogue: 0,0:15:54.27,0:15:56.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini pertemuan pertama kita, kan?
Dialogue: 0,0:15:56.89,0:15:59.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami kekurangan informasi.
Dialogue: 0,0:15:59.35,0:16:01.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belum bisa ambil keputusan.
Dialogue: 0,0:16:01.65,0:16:05.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya lebih baik menyembunyikan\Nsoal pemilik kekuatan.
Dialogue: 0,0:16:05.03,0:16:09.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, kamu baik-baik saja?\NTubuhmu penuh darah, lo.
Dialogue: 0,0:16:09.70,0:16:12.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa mengatakan ini ke dia.
Dialogue: 0,0:16:12.74,0:16:14.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kamu bicarakan?
Dialogue: 0,0:16:15.54,0:16:18.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, aku cuma bicara sendiri.
Dialogue: 0,0:16:18.25,0:16:23.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebentar lagi polisi akan datang.\NKalau bisa, hubungi orang tuamu...
Dialogue: 0,0:16:23.25,0:16:25.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya sudah, aku pergi dulu.
Dialogue: 0,0:16:25.88,0:16:27.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, tunggu dulu!
Dialogue: 0,0:16:33.47,0:16:34.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei.
Dialogue: 0,0:16:34.89,0:16:36.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:16:36.10,0:16:38.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada hal yang membuatku penasaran.
Dialogue: 0,0:16:38.77,0:16:42.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita sudah berjalan jauh, kan?
Dialogue: 0,0:16:42.52,0:16:44.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, benar.
Dialogue: 0,0:16:44.57,0:16:47.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktunya kembali.
Dialogue: 0,0:16:47.53,0:16:48.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:16:55.04,0:16:56.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:16:56.50,0:16:59.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya seperti diperdaya rubah, ya.
Dialogue: 0,0:16:59.67,0:17:02.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tidak bisa mengajukan lembur, deh.
Dialogue: 0,0:17:02.71,0:17:06.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata kamu rewel juga\Nsama hal begituan, ya.
Dialogue: 0,0:17:06.17,0:17:08.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak separah kamu, sih.
Dialogue: 0,0:17:08.92,0:17:10.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan pulang hari ini.
Dialogue: 0,0:17:10.38,0:17:11.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:17:11.08,0:17:14.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai jumpa,\NOm Penyihir Paruh Baya.
Dialogue: 0,0:17:14.93,0:17:18.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tidak pamitan ke aku, ya.
Dialogue: 0,0:17:18.27,0:17:20.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari berharap di kesempatan berikutnya.
Dialogue: 0,0:17:22.09,0:17:25.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah itu, menurut penjelasan petugas,
Dialogue: 0,0:17:25.35,0:17:29.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku dipromosikan dan naik pangkat\Ndari inspektur dua jadi inspektur satu.
Dialogue: 0,0:17:29.82,0:17:33.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya jabatan itu jauh\Ndi luar kemampuanku.
Dialogue: 0,0:17:33.32,0:17:37.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang jelas, kalau bisa menunjukkan\Ntelah berusaha keras,
Dialogue: 0,0:17:37.24,0:17:39.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin kehidupan kantorku\Nakan lebih ringan.
Dialogue: 0,0:17:40.79,0:17:43.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam laporan ke Kabag Akutsu,
Dialogue: 0,0:17:43.17,0:17:46.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku ditanyai soal percakapan kami\Ndengan Takayoshi dan Naomi,
Dialogue: 0,0:17:46.42,0:17:51.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tentang malaikat yang diisap\Nenerginya oleh Futari Shizuka,
Dialogue: 0,0:17:51.01,0:17:54.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bagaimana kami memastikan\Nwaktu kembali ke masa lalu,
Dialogue: 0,0:17:54.39,0:17:58.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hingga apa hubungan pemilik kekuatan\Nyang diserang oleh Magical Pink.
Dialogue: 0,0:17:58.56,0:18:01.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami dicerca pertanyaan.
Dialogue: 0,0:18:01.14,0:18:04.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kabag pun pasti kekurangan informasi
Dialogue: 0,0:18:04.15,0:18:06.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk dilaporkan ke pihak terkait.
Dialogue: 0,0:18:06.15,0:18:10.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada satu hal yang ingin\Nkupastikan dari kalian.
Dialogue: 0,0:18:10.11,0:18:12.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa cuma kalian di TKP
Dialogue: 0,0:18:12.82,0:18:16.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang menjadi sasaran\Nkekuatan pembalikan waktu?
Dialogue: 0,0:18:16.12,0:18:18.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dugaan juga tidak jadi masalah.
Dialogue: 0,0:18:18.66,0:18:23.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ada hal yang sedang kamu pikirkan\Nsaat ini, tolong katakan padaku juga.
Dialogue: 0,0:18:23.67,0:18:27.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami pun tidak paham soal itu.
Dialogue: 0,0:18:27.63,0:18:30.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin kami ikut terseret
Dialogue: 0,0:18:30.01,0:18:32.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}saat mengejar Magical Pink.
Dialogue: 0,0:18:35.05,0:18:38.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, saat ini sudah ada\Nsatu petunjuk pasti.
Dialogue: 0,0:18:38.89,0:18:44.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketiga orang yang berada di tempat itu\Ndiselimuti oleh kekuatan sihir.
Dialogue: 0,0:18:45.10,0:18:49.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin itu memengaruhi\Nkekuatan orang lain?
Dialogue: 0,0:18:49.86,0:18:54.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kalau begitu,\Ndunia tanpa orang itu
Dialogue: 0,0:18:54.07,0:18:57.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bukan ditujukan untuk kami.
Dialogue: 0,0:18:57.12,0:19:00.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malah, kami seakan tidak sengaja masuk
Dialogue: 0,0:19:00.83,0:19:06.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ke dalam ranah kekuatan orang lain.
Dialogue: 0,0:19:06.00,0:19:10.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,\Nwajar bocah misterius itu terkejut.
Dialogue: 0,0:19:10.13,0:19:12.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itulah...
Dialogue: 0,0:19:12.05,0:19:15.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak ingin membahas\Ntopik ini lebih jauh.
Dialogue: 0,0:19:15.01,0:19:17.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu.
Dialogue: 0,0:19:17.72,0:19:19.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayang sekali.
Dialogue: 0,0:19:19.72,0:19:23.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, Pak Kabag.\NKami ingin memastikan sesuatu juga.
Dialogue: 0,0:19:23.73,0:19:24.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:19:24.68,0:19:29.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana pekerjaan saya\Ndan Futari Shizuka mulai besok?
Dialogue: 0,0:19:29.15,0:19:33.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, aku ingin kamu melanjutkan\Npekerjaan yang sudah di berikan.
Dialogue: 0,0:19:33.36,0:19:35.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kasus Lizardmen itu, ya?
Dialogue: 0,0:19:35.82,0:19:41.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengenai kasus ini, aku akan memberikan\Ninstruksi setelah ada informasi baru.
Dialogue: 0,0:19:41.54,0:19:43.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:19:44.12,0:19:48.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah menyelesaikan tugas di kantor,\Naku bertemu dengan Pipi.
Dialogue: 0,0:19:48.58,0:19:51.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah mengambil pasokan untuk transaksi\Ndengan Usaha Dagang Kepler
Dialogue: 0,0:19:51.55,0:19:55.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di markas yang diamankan\Noleh Futari Shizuka,
Dialogue: 0,0:19:55.26,0:19:57.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}saatnya berangkat ke dunia lain.
Dialogue: 0,0:19:57.22,0:20:01.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhir-akhir ini, Futari Shizuka\Nbilang ingin ikut juga.
Dialogue: 0,0:20:01.10,0:20:03.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayangnya, aku harus menolak.
Dialogue: 0,0:20:03.97,0:20:07.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu singgah di dunia lain\Nadalah waktu kami melepas penat.
Dialogue: 0,0:20:07.94,0:20:12.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak boleh membawa\Nmasalah lebih dari ini.
Dialogue: 0,0:20:13.65,0:20:15.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Elsa bertunangan?
Dialogue: 0,0:20:15.86,0:20:17.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh?
Dialogue: 0,0:20:18.95,0:20:20.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:20:23.12,0:20:25.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai putri tunggal keluarga Müller,
Dialogue: 0,0:20:25.45,0:20:29.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ini adalah momen istimewa Nona Elsa\Nyang selama ini dibesarkan penuh kasih sayang.
Dialogue: 0,0:20:29.62,0:20:33.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Normalnya, ini acara\Nyang layak dirayakan...
Dialogue: 0,0:20:33.04,0:20:36.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa pasangannya?
Dialogue: 0,0:20:36.01,0:20:37.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu...
Dialogue: 0,0:20:37.84,0:20:43.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pangeran Pertama Louis\Nmeminta Elsa jadi selir utamanya.
Dialogue: 0,0:20:43.14,0:20:47.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata begitu.\NPantas kamu kesulitan.
Dialogue: 0,0:20:47.10,0:20:50.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Sasaki pernah bertemu dengannya\Nsaat beliau mengunjungi istana
Dialogue: 0,0:20:50.98,0:20:53.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di penganugerahan gelar baron.
Dialogue: 0,0:20:53.69,0:20:56.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pangeran Pertama Louis...
Dialogue: 0,0:20:58.74,0:21:00.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cowok ganteng itu...
Dialogue: 0,0:21:00.95,0:21:03.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf karena ini masalah pribadi.
Dialogue: 0,0:21:03.66,0:21:07.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi mungkin ini akan berpengaruh\Npada posisiku ke depannya,
Dialogue: 0,0:21:07.54,0:21:11.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi aku ingin membicarakan ini\Npada kalian lebih awal.
Dialogue: 0,0:21:11.37,0:21:15.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga sudah berkonsultasi\Ndengan Pangeran Adonis,
Dialogue: 0,0:21:15.46,0:21:19.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi ini masalah\Ndari orang-orang terkait.
Dialogue: 0,0:21:19.30,0:21:23.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya, Louis serius\Nmengincar takhta, ya.
Dialogue: 0,0:21:24.18,0:21:27.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu rela, Julius?
Dialogue: 0,0:21:27.06,0:21:30.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, mana mungkin bangsawan\Nrendahan seperti saya
Dialogue: 0,0:21:30.23,0:21:32.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menentang kehendak keluarga kerajaan.
Dialogue: 0,0:21:32.73,0:21:34.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:21:34.56,0:21:37.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini peristiwa penting sekali\Nseumur hidup bagi putrimu.
Dialogue: 0,0:21:38.36,0:21:40.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya tidak bisa membantahnya.
Dialogue: 0,0:21:40.90,0:21:44.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini semua masalah keluargamu.
Dialogue: 0,0:21:44.24,0:21:47.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami tidak akan terlalu ikut campur.
Dialogue: 0,0:21:47.12,0:21:47.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:21:48.66,0:21:52.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ada yang bisa dibantu,\Njangan sungkan bilang.
Dialogue: 0,0:21:52.42,0:21:55.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Mahardika Bintang...
Dialogue: 0,0:22:00.17,0:22:01.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ga-Gawat!
Dialogue: 0,0:22:01.59,0:22:03.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Elsa
Dialogue: 0,0:22:03.05,0:22:06.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ditemukan menggantung diri\Ndi kamarnya mencoba bunuh diri!
