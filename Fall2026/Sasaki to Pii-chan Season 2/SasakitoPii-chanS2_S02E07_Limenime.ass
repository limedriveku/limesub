Dialogue: 0,0:00:59.66,0:01:07.34,sign,,0000,0000,0000,,SASAKI DAN PIPI S2
Dialogue: 0,0:02:18.99,0:02:21.04,sign,,0000,0000,0000,,EPISODE 7: PERTUKARAN BUDAYA DAN HEROINE
Dialogue: 0,0:06:53.68,0:06:54.33,sign,,0000,0000,0000,,TERSANGKA - KABAG - WAKABAG
Dialogue: 0,0:07:08.99,0:07:11.33,sign,,0000,0000,0000,,KABAG
Dialogue: 0,0:07:11.33,0:07:13.70,sign,,0000,0000,0000,,TERSANGKA
Dialogue: 0,0:07:20.50,0:07:22.84,sign,,0000,0000,0000,,SESEORANG
Dialogue: 0,0:07:40.11,0:07:40.56,sign,,0000,0000,0000,,WAKABAG
Dialogue: 0,0:08:11.55,0:08:21.02,sign,,0000,0000,0000,,TERSANGKA - SESEORANG - KABAG - WAKABAG
Dialogue: 0,0:10:20.14,0:10:20.52,sign,,0000,0000,0000,,TOPIK - GELATIK JAWA DAN GADIS CANTIK\NYANG BICARA BAHASA MISTERIUS
Dialogue: 0,0:14:20.51,0:14:21.93,sign,,0000,0000,0000,,TOPIK - GELATIK JAWA DAN GADIS CANTIK
Dialogue: 0,0:14:21.93,0:14:23.47,sign,,0000,0000,0000,,YANG BICARA BAHASA MISTERIUS
Dialogue: 0,0:00:00.27,0:00:03.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian benar-benar berengsek!
Dialogue: 0,0:00:13.53,0:00:18.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keren! Kita masuk papan ini!
Dialogue: 0,0:00:18.41,0:00:20.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini namanya video.
Dialogue: 0,0:00:20.75,0:00:24.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penduduk dunia ini memakainya\Nsebagai pengganti buku harian.
Dialogue: 0,0:00:24.13,0:00:26.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke-Keren banget!
Dialogue: 0,0:00:26.55,0:00:27.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:00:27.97,0:00:31.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa bertukar video dengan orang-orang
Dialogue: 0,0:00:31.14,0:00:34.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang berada jauh untuk saling\Nberbagi informasi.
Dialogue: 0,0:00:34.68,0:00:38.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini internet yang dijelaskan\NTuan Burung, ya?
Dialogue: 0,0:00:38.81,0:00:42.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita aman tampil di sini?
Dialogue: 0,0:00:42.11,0:00:45.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aman asal tidak dipublikasikan\Nke dunia luar.
Dialogue: 0,0:00:46.03,0:00:48.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bahaya.
Dialogue: 0,0:02:21.04,0:02:22.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan...
Dialogue: 0,0:02:22.25,0:02:26.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mahardika Bintang tidak kuat\Nminum-minum alkohol.
Dialogue: 0,0:02:27.57,0:02:30.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pipi, kamu ingat kejadian ini?
Dialogue: 0,0:02:33.55,0:02:37.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, sudah paham situasi\Nyang kalian hadapi?
Dialogue: 0,0:02:37.80,0:02:39.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:02:39.76,0:02:42.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada panggilan juga dari Pak Kabag.
Dialogue: 0,0:02:42.06,0:02:45.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hampir saja saya menghadap\Ntanpa tahu apa-apa.
Dialogue: 0,0:02:45.56,0:02:49.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat temui pria itu.
Dialogue: 0,0:02:49.73,0:02:51.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tidak bisa apa-apa.
Dialogue: 0,0:02:51.19,0:02:55.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf selalu merepotkan.
Dialogue: 0,0:02:55.11,0:02:56.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang!
Dialogue: 0,0:02:56.91,0:02:59.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayaknya ini hari sialku.
Dialogue: 0,0:02:59.70,0:03:04.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami usahakan agar itu tidak terjadi.
Dialogue: 0,0:03:05.00,0:03:07.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ditunggu kabar baiknya.
Dialogue: 0,0:03:09.71,0:03:14.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pipi, kamu salah rekam video\Ndan malah jadi siaran video?
Dialogue: 0,0:03:14.72,0:03:18.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku sudah mengacau!
Dialogue: 0,0:03:18.64,0:03:20.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon maaf!
Dialogue: 0,0:03:20.72,0:03:24.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minta maaf memang tidak cukup,\Ntapi aku sungguh minta maaf!
Dialogue: 0,0:03:25.23,0:03:29.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, jangan terlalu dipikirkan.\NToh, sudah berlalu.
Dialogue: 0,0:03:29.11,0:03:33.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin aku jadi merebut\Ntempat tinggalmu di dunia ini.
Dialogue: 0,0:03:33.94,0:03:38.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau itu terjadi, aku tinggal pindah\Nsementara saja ke dunia lain.
Dialogue: 0,0:03:38.77,0:03:41.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bodohnya aku...
Dialogue: 0,0:03:41.28,0:03:43.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf saja tidak cukup!
Dialogue: 0,0:03:44.50,0:03:46.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh menggemaskan.
Dialogue: 0,0:03:47.12,0:03:51.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa-bisanya aku terlena alkohol\Ndan bikin kesalahan di internet.
Dialogue: 0,0:03:52.38,0:03:56.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, kadang kami juga begitu.
Dialogue: 0,0:03:56.01,0:03:57.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa dimaklumi, kok.
Dialogue: 0,0:03:57.47,0:04:01.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sungguh ceroboh!
Dialogue: 0,0:04:01.22,0:04:05.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Julukan Mahardika Bintang\Nmembuatku besar kepala!
Dialogue: 0,0:04:05.68,0:04:09.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku malah menginjak-injak\Nniat baikmu begini.
Dialogue: 0,0:04:09.81,0:04:12.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya aku puasa internet dulu.
Dialogue: 0,0:04:14.49,0:04:15.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:04:16.14,0:04:19.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya sudah, aku langsung\Nsetor muka ke kantor dulu.
Dialogue: 0,0:04:19.82,0:04:22.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, hati-hati.
Dialogue: 0,0:04:22.37,0:04:24.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kucoba berdalih sebaik mungkin.
Dialogue: 0,0:04:24.66,0:04:30.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai gantinya,\Nbisakah Pipi temani Nona Elsa?
Dialogue: 0,0:04:30.58,0:04:35.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pasti merasa khawatir juga\Nkalau cuma berdua dengan Futari Shizuka.
Dialogue: 0,0:04:35.80,0:04:37.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, baik.
Dialogue: 0,0:04:37.80,0:04:41.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bersumpah tidak akan\Nmengulangi kesalahan ini.
Dialogue: 0,0:04:43.05,0:04:45.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Langsung ke intinya saja.
Dialogue: 0,0:04:45.52,0:04:48.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa dia?
Dialogue: 0,0:04:48.06,0:04:52.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya sudah membahas itu sebelumnya.
Dialogue: 0,0:04:52.56,0:04:55.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami mengidentifikasi lokasinya\Ndari latar belakang video.
Dialogue: 0,0:04:55.40,0:04:58.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat memeriksa kamera\Ndi pintu masuk hotel,
Dialogue: 0,0:04:58.69,0:05:03.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}terlihat sosok yang diduga sebagai dirimu\Ndan Futari Shizuka sedang keluar masuk.
Dialogue: 0,0:05:03.99,0:05:08.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bilang kamu tidak terlibat?
Dialogue: 0,0:05:08.96,0:05:12.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bilang ingin tinggal\Nsementara waktu di negara ini.
Dialogue: 0,0:05:12.92,0:05:18.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku justru tertarik pada gelatik jawa\Nyang bahasanya sama dengan gadis itu.
Dialogue: 0,0:05:18.42,0:05:20.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau itu bukan palsu,
Dialogue: 0,0:05:20.88,0:05:25.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa jadi mereka dari tempat yang sama\Ndengan lizardman yang jatuh dari langit itu?
Dialogue: 0,0:05:26.18,0:05:32.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dengar juga, kamu memelihara\Ngelatik jawa di rumah.
Dialogue: 0,0:05:32.53,0:05:35.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertanyaannya tepat sasaran.
Dialogue: 0,0:05:35.52,0:05:37.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah tidak bisa mengelak lagi!
Dialogue: 0,0:05:37.73,0:05:42.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu belum tahu hubungan\Nantara Futari Shizuka dan gadis itu?
Dialogue: 0,0:05:42.74,0:05:47.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya, Futari Shizuka tidak tahu\Nbahasa dalam video itu.
Dialogue: 0,0:05:47.49,0:05:49.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:05:50.47,0:05:54.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya, itu yang kudengar.
Dialogue: 0,0:05:54.92,0:05:58.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan berusaha\Nuntuk tidak berbohong.
Dialogue: 0,0:05:58.21,0:06:00.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pakai strategi menerima fakta yang ada,
Dialogue: 0,0:06:00.88,0:06:04.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi tetap bersikeras\Npura-pura tidak tahu.
Dialogue: 0,0:06:06.26,0:06:11.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah kamu ingin tetap\Nmenjadi warga negara ini?
Dialogue: 0,0:06:11.68,0:06:16.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, kemungkinan ini ultimatum\Ndari atasan ke bawahan.
Dialogue: 0,0:06:16.27,0:06:21.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kehidupanku bakal berubah drastis\Ntergantung jawaban di sini.
Dialogue: 0,0:06:22.57,0:06:26.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, saya ingin terus mengabdi\Nuntuk tanah air.
Dialogue: 0,0:06:27.83,0:06:32.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, tuntaskan tugasmu\Nsebagai anggota biro.
Dialogue: 0,0:06:33.21,0:06:38.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, akan langsung saya laksanakan.
Dialogue: 0,0:06:39.24,0:06:42.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pak Kabag ingat keributan\Ndi arena boling?
Dialogue: 0,0:06:45.74,0:06:48.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok tiba-tiba ke situ?
Dialogue: 0,0:06:54.33,0:06:57.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya, Wakabag\Nyang menerima informasi palsu
Dialogue: 0,0:06:57.69,0:06:59.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dari kelompok tersangka.
Dialogue: 0,0:07:00.11,0:07:03.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anggota biro yang ada di TKP saat itu\Nmengalami luka parah.
Dialogue: 0,0:07:03.82,0:07:07.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Termasuk semua orang di dalam kendaraan\Nyang dijadikan markas komando.
Dialogue: 0,0:07:07.55,0:07:08.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, salah.
Dialogue: 0,0:07:11.33,0:07:13.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya, kecuali Pak Kabag.
Dialogue: 0,0:07:14.16,0:07:15.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ups.
Dialogue: 0,0:07:15.58,0:07:18.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menarik garis langsung dari sini\Nsepertinya keliru.
Dialogue: 0,0:07:24.71,0:07:29.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagi tersangka, berkurangnya jumlah petugas\Nmerupakan hal menguntungkan.
Dialogue: 0,0:07:29.76,0:07:34.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dilihat seperti ini, Pak Wakabag\Nyang tidak tahu apa-apa jadi kasihan.
Dialogue: 0,0:07:34.81,0:07:40.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kabarnya, dia akan dimutasi ke tempat lain\Nsebagai pertanggungjawaban atas kasus ini.
Dialogue: 0,0:07:40.56,0:07:45.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa Pak Kabag juga penasaran siapa\Nyang akan mengisi posisi ini?
Dialogue: 0,0:07:46.23,0:07:50.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sasaki, kamu orang dalam\NBadan Keamanan Publik?
Dialogue: 0,0:07:50.87,0:07:52.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia terpancing!
Dialogue: 0,0:07:52.69,0:07:54.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, bukan.
Dialogue: 0,0:07:54.50,0:07:57.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, kenapa kamu ada di sini?
Dialogue: 0,0:07:57.71,0:07:59.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong jangan salah paham.
Dialogue: 0,0:07:59.58,0:08:02.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pak Kabag yang lebih dulu cari ribut.
Dialogue: 0,0:08:03.05,0:08:07.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya ingin tetap rukun\Ndengan Pak Akutsu ke depannya.
Dialogue: 0,0:08:08.06,0:08:11.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu menyuruhku\Nmemercayai kata-katamu?
Dialogue: 0,0:08:11.55,0:08:14.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya ingin Pak Kabag percaya.
Dialogue: 0,0:08:14.60,0:08:17.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau saya memang berniat jahat,
Dialogue: 0,0:08:17.85,0:08:21.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak perlu repot-repot menjelaskan ini, kan?
Dialogue: 0,0:08:21.47,0:08:25.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, imbalan yang saya minta\Ncuma status pegawai biro biasa
Dialogue: 0,0:08:25.28,0:08:27.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tanpa keistimewaan apa pun.
Dialogue: 0,0:08:27.24,0:08:30.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jabatan pegawai biro semenarik itu?
Dialogue: 0,0:08:31.66,0:08:35.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dibandingkan tempat kerja saya sebelumnya,\Nini seperti surga.
Dialogue: 0,0:08:36.78,0:08:38.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:08:39.00,0:08:41.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa kamu sebenarnya?
Dialogue: 0,0:08:43.19,0:08:47.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dunia ini jauh lebih beragam\Ndari bayangan Pak Kabag.
Dialogue: 0,0:08:50.47,0:08:54.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau orang biasa sepertiku yang bilang,\Nrasanya kurang keren.
Dialogue: 0,0:08:54.35,0:08:58.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kata-kata ini lebih berkesan\Nkalau diucapkan Mahardika Bintang.
Dialogue: 0,0:08:58.89,0:09:02.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesan pria paruh baya sok keren\Nbikin geli banget.
Dialogue: 0,0:09:03.17,0:09:04.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, tapi...
Dialogue: 0,0:09:05.07,0:09:10.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, saya harap Pak Kabag\Ntidak mengungkit ini lebih lanjut.
Dialogue: 0,0:09:10.32,0:09:13.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya juga tidak akan ikut campur\Nurusan Pak Kabag.
Dialogue: 0,0:09:14.33,0:09:19.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan saya pikir kita berada di posisi\Nyang saling menguntungkan.
Dialogue: 0,0:09:20.75,0:09:23.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya, aku tidak mau\Njadi budak korporat lagi.
Dialogue: 0,0:09:24.29,0:09:27.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga tidak mau\Ndikejar-kejar penguasa.
Dialogue: 0,0:09:27.74,0:09:31.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang penting bisa makan\Ndan tidur dengan tenang.
Dialogue: 0,0:09:32.11,0:09:33.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:09:34.35,0:09:38.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perkataanmu benar, Sasaki.
Dialogue: 0,0:09:40.68,0:09:43.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sempat khawatir,
Dialogue: 0,0:09:43.23,0:09:45.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi untungnya berhasil berkelit.
Dialogue: 0,0:09:45.73,0:09:48.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang aku aman buat sementara.
Dialogue: 0,0:09:48.69,0:09:52.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, selanjutnya melapor\Nke Futari Shizuka.
Dialogue: 0,0:09:52.28,0:09:57.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga harus menyiapkan\Ntempat tinggal baru untuk Nona Elsa.
Dialogue: 0,0:09:57.83,0:10:02.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin masuk ke gedung itu\Ntanpa ketahuan orang sekitar.
Dialogue: 0,0:10:03.11,0:10:05.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau pakai hadiahmu?
Dialogue: 0,0:10:05.67,0:10:09.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hadiah dari pencapaianmu\Ndi ruang isolasi sebelumnya.
Dialogue: 0,0:10:09.05,0:10:10.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, tolong.
Dialogue: 0,0:10:10.42,0:10:12.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Langsung dijawab, ya.
Dialogue: 0,0:10:12.17,0:10:16.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemampuanmu mengambil keputusan\Nkalau menyangkut dia selalu gesit.
Dialogue: 0,0:10:16.39,0:10:20.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya, pilihan video\Nyang sedang ramai dibicarakan.
Dialogue: 0,0:10:20.52,0:10:23.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gelatik jawa dan gadis cantik\Nyang bicara bahasa misterius!
Dialogue: 0,0:10:23.83,0:10:26.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menarik sekali, ya!
Dialogue: 0,0:10:27.23,0:10:30.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, bukankah kita pernah\Nlihat gelatik jawa itu?
Dialogue: 0,0:10:30.96,0:10:32.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Abaddon juga sepemikiran?
Dialogue: 0,0:10:32.99,0:10:35.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti burung yang sama.
Dialogue: 0,0:10:35.57,0:10:40.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu wanita pirang itu siapanya Om?
Dialogue: 0,0:10:40.24,0:10:41.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah.
Dialogue: 0,0:10:53.92,0:10:57.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, mau apa tiba-tiba menyentuhku?
Dialogue: 0,0:11:06.82,0:11:09.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hotel tempat syutingnya juga\Nsudah terlacak.
Dialogue: 0,0:11:09.90,0:11:13.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bekerja sama denganmu\Nuntuk saat seperti ini.
Dialogue: 0,0:11:13.65,0:11:15.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya sudahlah.
Dialogue: 0,0:11:15.24,0:11:18.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan membantumu\Nmenangani masalah ini.
Dialogue: 0,0:11:22.33,0:11:23.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu tadi?
Dialogue: 0,0:11:23.91,0:11:26.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menyembunyikan wujudmu\Ndari pandangan sekitar.
Dialogue: 0,0:11:26.46,0:11:30.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang kamu bisa masuk gedung\Nterang-terangan lewat pintu depan.
Dialogue: 0,0:11:30.38,0:11:31.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke.
Dialogue: 0,0:11:39.90,0:11:44.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga, apa-apaan si Sasaki ini?
Dialogue: 0,0:11:44.56,0:11:47.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Abaddon, aku akan mengikuti dia.
Dialogue: 0,0:11:47.10,0:11:48.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, iya.
Dialogue: 0,0:11:55.78,0:12:00.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waduh, sepertinya firasatmu benar.
Dialogue: 0,0:12:00.99,0:12:05.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, pipimu tampak menegang.\NKarena apa, tuh?
Dialogue: 0,0:12:06.87,0:12:11.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku butuh Sasaki\Nsampai pensiun nanti.
Dialogue: 0,0:12:13.71,0:12:16.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya tenang sedikit.
Dialogue: 0,0:12:23.94,0:12:26.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini polisi! Buka pintunya!
Dialogue: 0,0:12:26.73,0:12:30.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu benar-benar ekspresif\Nkalau soal dia, ya.
Dialogue: 0,0:12:44.45,0:12:47.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya, firasatmu benar.
Dialogue: 0,0:12:57.01,0:13:01.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pemilik kekuatan kenalan Futari Shizuka\Nyang pernah datang ke Biro, kan?
Dialogue: 0,0:13:02.27,0:13:04.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kamu siapa?
Dialogue: 0,0:13:04.68,0:13:07.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya pintunya terkunci!
Dialogue: 0,0:13:07.69,0:13:10.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sungguh tidak paham ucapanmu.
Dialogue: 0,0:13:11.77,0:13:15.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oi, aku sudah menyiapkan\Nmarkas di tempat lain.
Dialogue: 0,0:13:15.90,0:13:18.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, sudah terlambat, ya.
Dialogue: 0,0:13:18.74,0:13:21.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, dia...
Dialogue: 0,0:13:21.32,0:13:23.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wanita yang bersama Om tempo hari.
Dialogue: 0,0:13:24.37,0:13:28.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Futari Shizuka, aku tahu kamu\Nbergerak bersama Sasaki.
Dialogue: 0,0:13:29.22,0:13:30.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baguslah.
Dialogue: 0,0:13:30.75,0:13:33.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan urusan ini padaku\Ndan kembalilah ke kantor.
Dialogue: 0,0:13:33.88,0:13:38.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis pirang itu pemilik kekuatan\Nkenalanmu, kan?
Dialogue: 0,0:13:38.21,0:13:39.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang kenapa?
Dialogue: 0,0:13:44.93,0:13:46.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa lagi ini?
Dialogue: 0,0:13:47.93,0:13:49.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tu-Tuan Burung!
Dialogue: 0,0:13:52.94,0:13:57.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada anak-anak melayang di langit.\NKamu tahu sesuatu?
Dialogue: 0,0:13:57.52,0:13:59.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya?
Dialogue: 0,0:14:05.25,0:14:07.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan membunuh pemilik kekuatan.
Dialogue: 0,0:14:07.99,0:14:10.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan malaikat ataupun iblis.
Dialogue: 0,0:14:10.92,0:14:14.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ruang isolasi tidak tercipta.\NSepertinya bukan Utusan malaikat.
Dialogue: 0,0:14:14.96,0:14:17.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke-Kenapa kamu tahu tempat ini?
Dialogue: 0,0:14:18.42,0:14:20.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Muncul di TV.
Dialogue: 0,0:14:20.51,0:14:23.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang muncul di tembok gedung.
Dialogue: 0,0:14:23.47,0:14:26.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, sampai seviral itu, ya?
Dialogue: 0,0:14:26.85,0:14:29.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian benar-benar bikin heboh, ya.
Dialogue: 0,0:14:29.52,0:14:32.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Abaddon, buat aku terlihat.
Dialogue: 0,0:14:32.77,0:14:34.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima risikonya sendiri, ya.
Dialogue: 0,0:14:34.73,0:14:36.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan masalah.
Dialogue: 0,0:14:38.15,0:14:40.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang muncul!
Dialogue: 0,0:14:47.49,0:14:49.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau tahu!
Dialogue: 0,0:14:49.95,0:14:52.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian ribut saja sendiri!
Dialogue: 0,0:14:53.21,0:14:56.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan membawa kalian semua ke Biro!
Dialogue: 0,0:14:56.25,0:14:59.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemilik kekuatan pasti akan kubunuh.
Dialogue: 0,0:14:59.46,0:15:02.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian kurang ajar,\Ntiba-tiba datang kemari!
Dialogue: 0,0:15:02.42,0:15:05.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Om itu milikku.\NTidak akan kuserahkan ke siapa pun.
Dialogue: 0,0:15:05.63,0:15:08.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian enggak cocok banget, ya.
Dialogue: 0,0:15:08.76,0:15:12.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat menyarankan\Nmundur secepatnya.
Dialogue: 0,0:15:12.59,0:15:14.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayangnya tidak bisa.
Dialogue: 0,0:15:14.60,0:15:18.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kena serangan tadi,\Nkamu bakal langsung mati, lo?
Dialogue: 0,0:15:18.48,0:15:19.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu.
Dialogue: 0,0:15:19.69,0:15:23.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya biarkan aku memastikan\Nhubungan mereka dengan Om.
Dialogue: 0,0:15:23.82,0:15:27.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu bicara sendiri?
Dialogue: 0,0:15:27.16,0:15:29.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kenalannya Sasaki juga?
Dialogue: 0,0:15:29.41,0:15:33.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sendiri siapa?\NApa hubunganmu dengan Om?
Dialogue: 0,0:15:33.33,0:15:34.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rekan kerja.
Dialogue: 0,0:15:35.25,0:15:38.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Om bilang dia bekerja\Ndi perusahaan dagang swasta.
Dialogue: 0,0:15:38.50,0:15:42.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia baru saja pindah kerja.\NSasaki tidak bilang?
Dialogue: 0,0:15:42.89,0:15:46.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau wanita lain bicara\Nseolah dia lebih paham soal Om.
Dialogue: 0,0:15:46.84,0:15:49.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang paling mengerti Om itu cuma aku.
Dialogue: 0,0:15:49.93,0:15:52.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pemilik kekuatan dari mana?
Dialogue: 0,0:15:52.39,0:15:55.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada kaitannya dengan\Ntempat asal Futari Shizuka?
Dialogue: 0,0:15:55.60,0:16:00.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski memang mengenal dia,\Naku tidak tahu soal "pemilik kekuatan".
Dialogue: 0,0:16:00.56,0:16:03.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti, sebaiknya kita tanya\Nke Futari Shizuka.
Dialogue: 0,0:16:04.23,0:16:06.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ampun, deh.
Dialogue: 0,0:16:07.70,0:16:09.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan membunuh\Nsemua pemilik kekuatan.
Dialogue: 0,0:16:15.62,0:16:17.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, ini pasti...
Dialogue: 0,0:16:17.87,0:16:20.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini harus kulaporkan ke Pak Kabag!
Dialogue: 0,0:16:22.59,0:16:24.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo, ini Sasaki!
Dialogue: 0,0:16:24.13,0:16:25.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini Akutsu.
Dialogue: 0,0:16:25.34,0:16:27.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin kamu sudah tahu.
Dialogue: 0,0:16:27.59,0:16:30.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemunculan gadis penyihir\Ntelah dikonfirmasi.
Dialogue: 0,0:16:30.05,0:16:31.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Segera pergi ke sana.
Dialogue: 0,0:16:31.64,0:16:36.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami juga akan mengirim personel,\Ntapi mengingat lokasi itu ramai,
Dialogue: 0,0:16:36.23,0:16:38.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tolong lakukan penutupan fakta.
Dialogue: 0,0:16:38.52,0:16:39.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:16:43.11,0:16:45.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi-lagi ditangkis.
Dialogue: 0,0:16:45.07,0:16:48.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama seperti saat melawan\NPenyihir Paruh Baya.
Dialogue: 0,0:16:48.53,0:16:52.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Burung...\NJangan-jangan ini...
Dialogue: 0,0:16:53.95,0:16:55.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyerahlah!
Dialogue: 0,0:16:58.25,0:17:00.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Barier sihirnya menghalangi...
Dialogue: 0,0:17:01.26,0:17:03.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Istilah aneh apa itu?
Dialogue: 0,0:17:04.43,0:17:09.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, aku bisa menyingkirkan Wanita Riasan\Ndengan bantuan Abaddon.
Dialogue: 0,0:17:09.30,0:17:11.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, larinya ke situ?
Dialogue: 0,0:17:11.64,0:17:15.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang tidak segan\Nmenembak anak-anak.
Dialogue: 0,0:17:15.21,0:17:17.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya disingkirkan secepatnya.
Dialogue: 0,0:17:17.92,0:17:19.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, mungkin aku...
Dialogue: 0,0:17:20.73,0:17:22.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benci wanita ini.
Dialogue: 0,0:17:28.03,0:17:29.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, kalian!
Dialogue: 0,0:17:29.70,0:17:33.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa mengamuk di rumah orang?
Dialogue: 0,0:17:41.92,0:17:43.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiba-tiba muncul orang!
Dialogue: 0,0:17:43.17,0:17:44.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan tembus pandang?
Dialogue: 0,0:17:44.75,0:17:47.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada pemilik kekuatan lagi.\NHarus kubunuh.
Dialogue: 0,0:17:48.71,0:17:50.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga!
Dialogue: 0,0:17:51.22,0:17:55.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik sekali kamu memberiku senjata.
Dialogue: 0,0:17:56.43,0:17:58.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersiaplah!
Dialogue: 0,0:18:04.05,0:18:05.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama-sama.
Dialogue: 0,0:18:05.48,0:18:07.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belum bilang apa-apa.
Dialogue: 0,0:18:09.86,0:18:11.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum selesai!
Dialogue: 0,0:18:13.03,0:18:15.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma kita yang terpojok, Abaddon.
Dialogue: 0,0:18:15.87,0:18:20.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita kekurangan pilihan gara-gara kamu\Nmemakai hadiah untuk hal sepele.
Dialogue: 0,0:18:20.45,0:18:24.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minimal harus menangkap satu orang!\NAtau harga diriku hancur!
Dialogue: 0,0:18:25.54,0:18:30.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hal yang bisa dilakukan Abaddon terbatas\Ndi luar ruang isolasi meski dia iblis.
Dialogue: 0,0:18:30.76,0:18:32.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Andai saja bisa mendekat...
Dialogue: 0,0:18:32.88,0:18:34.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eits, izin tampil!
Dialogue: 0,0:18:34.72,0:18:36.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini kesempatan emas\Nmembuatnya berutang budi!
Dialogue: 0,0:18:36.89,0:18:39.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kenapa memihak dia?
Dialogue: 0,0:18:39.77,0:18:41.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu anggota Biro, kan?
Dialogue: 0,0:18:41.18,0:18:43.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan berarti aku memihak dia.
Dialogue: 0,0:18:43.44,0:18:46.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini langkah terbaik untuk meredakan situasi.
Dialogue: 0,0:18:47.31,0:18:49.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekakmat!
Dialogue: 0,0:18:58.73,0:19:01.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Andai Abaddon bisa melakukan itu juga.
Dialogue: 0,0:19:02.20,0:19:05.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong ingat-ingat aksiku di ruang isolasi.
Dialogue: 0,0:19:05.67,0:19:08.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku keren! Ini dia!
Dialogue: 0,0:19:09.13,0:19:13.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah melihat ini, sulit percaya\Ndia bukan iblis ataupun Utusannya.
Dialogue: 0,0:19:13.34,0:19:17.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin kamu cuma lupa\Nwajah kenalanmu.
Dialogue: 0,0:19:17.01,0:19:21.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh? Kamu meragukan\Nperkataan tetanggamu?
Dialogue: 0,0:19:21.01,0:19:22.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan begitu maksudku.
Dialogue: 0,0:19:24.27,0:19:26.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan membunuh pemilik kekuatan.
Dialogue: 0,0:19:31.19,0:19:33.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu! Apa-apaan kamu?
Dialogue: 0,0:19:33.40,0:19:36.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum lama ini kita bekerja sama, kan?
Dialogue: 0,0:19:36.66,0:19:41.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Futari Shizuka, kamu anggota Biro,\Ntapi bekerja sama dengan gadis penyihir?
Dialogue: 0,0:19:41.12,0:19:44.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu-Bukan, itu ada alasannya.
Dialogue: 0,0:19:44.33,0:19:47.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tante, kamu sudah ditolong,
Dialogue: 0,0:19:47.50,0:19:50.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}minimal harus bilang terima kasih, kan?
Dialogue: 0,0:19:50.59,0:19:54.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tante itu seorang polisi,\Njadilah teladan bagi masyarakat.
Dialogue: 0,0:19:54.59,0:19:56.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ta-Tante?
Dialogue: 0,0:19:56.01,0:20:01.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari percakapan tadi, yang jadi kunci\Npasti gadis berpakaian Jepang ini.
Dialogue: 0,0:20:01.57,0:20:05.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada ruginya membangun\Nkesan baik di hadapannya.
Dialogue: 0,0:20:05.06,0:20:07.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ucapanmu bijak juga.
Dialogue: 0,0:20:07.89,0:20:09.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak tahu malu!
Dialogue: 0,0:20:09.27,0:20:12.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu cuma memanfaatkanku\Nuntuk kepentingan diri sendiri, kan?
Dialogue: 0,0:20:12.02,0:20:16.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang jelas, tindakannya memang\Nsudah menyelamatkan Tante.
Dialogue: 0,0:20:16.28,0:20:18.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, bisa berhenti panggil aku "Tante"?
Dialogue: 0,0:20:18.99,0:20:19.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:20:19.99,0:20:22.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya aku belum setua itu!
Dialogue: 0,0:20:22.91,0:20:26.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi dari mata kami,\Nkamu sudah setua itu.
Dialogue: 0,0:20:26.20,0:20:29.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?\NAku cewek SMA, tahu!
Dialogue: 0,0:20:31.58,0:20:34.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu cuma harapanmu, kan?
Dialogue: 0,0:20:34.30,0:20:36.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Tatapan macam apa itu?
Dialogue: 0,0:20:36.38,0:20:41.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dilihat dari sudut pandang masyarakat,\Nmungkin aku masuk kategori orang tidak waras.
Dialogue: 0,0:20:41.51,0:20:43.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu, aku...
Dialogue: 0,0:20:44.31,0:20:48.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu terasa sulit didekati.
Dialogue: 0,0:20:48.06,0:20:51.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benar-benar cewek SMA!
Dialogue: 0,0:20:51.19,0:20:55.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedikit-sedikit bilang cewek SMA,\Nkelihatan ngotot banget.
Dialogue: 0,0:20:57.08,0:21:01.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu. Kepribadianmu\Nbisa dididik seperti ini, ya?
Dialogue: 0,0:21:01.24,0:21:04.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cerewet, akan kubunuh\Nsemua pemilik kekuatan...
Dialogue: 0,0:21:04.45,0:21:08.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa tolong perkaya kosakatamu?
Dialogue: 0,0:21:15.05,0:21:19.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Abaddon, sepertinya kita\Nterpaksa harus mundur.
Dialogue: 0,0:21:19.88,0:21:21.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:21:21.26,0:21:25.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang kalau kamu ambil\Nkeputusan itu dari awal.
Dialogue: 0,0:21:25.68,0:21:29.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, bisa tolong bawa aku\Ndari jendela itu?
Dialogue: 0,0:21:30.31,0:21:32.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, serahkan padaku!
Dialogue: 0,0:21:34.40,0:21:36.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemilik kekuatan tidak akan kubiarkan kabur!
Dialogue: 0,0:21:37.36,0:21:38.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Abaddon!
Dialogue: 0,0:21:40.74,0:21:43.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja, itu sudah kuprediksi.
Dialogue: 0,0:21:54.08,0:21:55.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya!
Dialogue: 0,0:21:55.79,0:21:57.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu dulu!
Dialogue: 0,0:21:58.71,0:22:00.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Om?
Dialogue: 0,0:22:01.49,0:22:02.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sasaki?
