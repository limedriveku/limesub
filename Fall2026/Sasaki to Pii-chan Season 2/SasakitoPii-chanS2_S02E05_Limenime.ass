Dialogue: 0,0:00:33.64,0:00:41.31,sign,,0000,0000,0000,,SASAKI DAN PIPI S2
Dialogue: 0,0:01:53.01,0:01:57.18,sign,,0000,0000,0000,,EPISODE 5: PAHLAWAN DAN PERASAAN
Dialogue: 0,0:09:00.67,0:09:01.94,sign,,0000,0000,0000,,SUSU KEDELAI
Dialogue: 0,0:11:21.33,0:11:23.04,sign,,0000,0000,0000,,PANGGILAN TIDAK TERJAWAB\NFUTARI SHIZUKA
Dialogue: 0,0:00:06.95,0:00:09.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Abaddon, cepat urus para malaikat!
Dialogue: 0,0:00:17.04,0:00:18.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Om!
Dialogue: 0,0:02:07.90,0:02:11.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa bertahan hidup berkat Om.
Dialogue: 0,0:02:12.11,0:02:14.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Om tidak ada, aku pasti
Dialogue: 0,0:02:14.95,0:02:16.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sudah mati tergeletak di jalanan.
Dialogue: 0,0:02:18.12,0:02:20.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak-anak tidak berdaya sepertiku,
Dialogue: 0,0:02:21.87,0:02:24.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak bisa pergi dari Ibu.
Dialogue: 0,0:02:27.59,0:02:30.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga tidak bisa\Nmenolak pemberian Om.
Dialogue: 0,0:02:45.02,0:02:47.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh makhluk yang menyedihkan.
Dialogue: 0,0:02:51.35,0:02:53.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya seperti diriku
Dialogue: 0,0:02:53.72,0:02:57.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ditimpa oleh sesuatu.
Dialogue: 0,0:02:57.56,0:02:59.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sangat menakutkan.
Dialogue: 0,0:03:01.16,0:03:05.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku pikir bisa lebih lega\Ndengan berpasrah diri.
Dialogue: 0,0:03:09.13,0:03:12.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam kondisi kehilangan jati diri,
Dialogue: 0,0:03:16.97,0:03:19.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tiba-tiba aku kepikiran...
Dialogue: 0,0:03:20.76,0:03:22.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial, sial, sial!
Dialogue: 0,0:03:22.68,0:03:24.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa aku terus?
Dialogue: 0,0:03:25.06,0:03:26.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang benar saja.
Dialogue: 0,0:03:27.40,0:03:29.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak cuma menerima saja.
Dialogue: 0,0:03:29.81,0:03:32.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Andai aku bisa memberi juga.
Dialogue: 0,0:03:32.19,0:03:35.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin, jati diri ini bisa kembali.
Dialogue: 0,0:03:35.74,0:03:37.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu pikirku.
Dialogue: 0,0:03:39.82,0:03:43.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Om adalah manusia kesepian\Nsama sepertiku.
Dialogue: 0,0:03:45.25,0:03:46.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi...
Dialogue: 0,0:03:50.13,0:03:52.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dan dia mirip.
Dialogue: 0,0:03:58.75,0:04:00.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Om juga pasti
Dialogue: 0,0:04:00.93,0:04:03.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mengurusku karena berpikir
Dialogue: 0,0:04:04.27,0:04:06.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami ini sama.
Dialogue: 0,0:04:09.38,0:04:10.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau benar...
Dialogue: 0,0:04:10.86,0:04:14.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena telah dia urus,
Dialogue: 0,0:04:15.57,0:04:18.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku harus membalas budi.
Dialogue: 0,0:04:20.99,0:04:23.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi bagaimana caranya?
Dialogue: 0,0:04:27.17,0:04:31.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurosu yang tinggal di apartemen ini\Nmaksudnya kamu, kan?
Dialogue: 0,0:04:31.50,0:04:34.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong dengarkan dengan tenang.
Dialogue: 0,0:04:34.46,0:04:37.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibumu kritis karena tertabrak mobil.
Dialogue: 0,0:04:37.97,0:04:39.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibuku?
Dialogue: 0,0:04:39.09,0:04:41.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, dia ada di rumah sakit dekat sini.
Dialogue: 0,0:04:41.97,0:04:44.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi ikutlah dengan kami.
Dialogue: 0,0:04:44.06,0:04:48.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami kenalan dari tempat kerja ibumu.
Dialogue: 0,0:04:48.77,0:04:51.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, ibuku baik-baik saja?
Dialogue: 0,0:04:51.98,0:04:54.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum tahu hasilnya.
Dialogue: 0,0:04:54.48,0:04:59.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurosu, ayo jenguk ibumu bareng kami.
Dialogue: 0,0:04:59.82,0:05:03.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, kalian siapa?
Dialogue: 0,0:05:04.74,0:05:06.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa kamu?
Dialogue: 0,0:05:06.37,0:05:08.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ayahnya.
Dialogue: 0,0:05:11.00,0:05:13.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oi, kok dia punya ayah?
Dialogue: 0,0:05:13.96,0:05:15.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana ini?
Dialogue: 0,0:05:16.00,0:05:20.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami rekan kerja istrimu.
Dialogue: 0,0:05:20.84,0:05:24.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh minta kontak kantormu?
Dialogue: 0,0:05:25.30,0:05:28.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong beri tahu nama atasan kalian juga.
Dialogue: 0,0:05:28.56,0:05:31.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya aku tahu betul kantor istriku.
Dialogue: 0,0:05:35.02,0:05:36.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, ayo kabur!
Dialogue: 0,0:05:37.32,0:05:38.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar pengganggu!
Dialogue: 0,0:05:41.24,0:05:43.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kabur!
Dialogue: 0,0:05:43.57,0:05:44.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat!
Dialogue: 0,0:05:45.66,0:05:47.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Om...
Dialogue: 0,0:05:47.12,0:05:49.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pi-Pisaunya...
Dialogue: 0,0:05:52.12,0:05:53.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.
Dialogue: 0,0:05:53.61,0:05:57.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah menyiapkan ini\Nsebelum menegur mereka.
Dialogue: 0,0:05:57.71,0:05:59.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamera juga.
Dialogue: 0,0:06:01.84,0:06:05.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu seperti protagonis\Ndi film dan anime.
Dialogue: 0,0:06:05.43,0:06:07.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be-Benarkah?
Dialogue: 0,0:06:10.31,0:06:14.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu itu, Om tertawa malu.
Dialogue: 0,0:06:15.40,0:06:16.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi...
Dialogue: 0,0:06:16.94,0:06:19.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak menanyakan\Napa-apa lagi setelah itu.
Dialogue: 0,0:06:21.96,0:06:27.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagi diriku yang masih muda,\NOm terlihat seperti pahlawan asli.
Dialogue: 0,0:06:27.41,0:06:30.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia juga menyelamatkanku tadi.
Dialogue: 0,0:06:31.37,0:06:34.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai harus begini...
Dialogue: 0,0:06:35.08,0:06:37.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Om! Om!
Dialogue: 0,0:06:38.99,0:06:40.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat.
Dialogue: 0,0:06:41.38,0:06:42.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakiku hilang.
Dialogue: 0,0:06:48.29,0:06:52.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita benar-benar tidak cocok.
Dialogue: 0,0:06:52.72,0:06:54.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kacau.
Dialogue: 0,0:06:54.92,0:06:58.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Proses penyembuhannya\Ntidak bisa mengimbangi.
Dialogue: 0,0:07:00.19,0:07:03.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Om! Jangan mati, Om!
Dialogue: 0,0:07:03.32,0:07:06.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah kamu selamat.
Dialogue: 0,0:07:07.91,0:07:10.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lupakan saja tentangku!
Dialogue: 0,0:07:11.49,0:07:13.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang lebih penting,
Dialogue: 0,0:07:13.45,0:07:15.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu harus hidup!
Dialogue: 0,0:07:33.10,0:07:34.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita mundur dulu.
Dialogue: 0,0:07:41.99,0:07:45.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak! Aku mohon, Om!
Dialogue: 0,0:07:45.55,0:07:50.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong, hidup bahagialah demi aku...
Dialogue: 0,0:07:51.08,0:07:55.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kamu masih muda...
Dialogue: 0,0:07:55.79,0:07:59.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Om! Om!
Dialogue: 0,0:07:59.25,0:08:04.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan!\NAku belum balas budi pada Om!
Dialogue: 0,0:08:11.73,0:08:15.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Om, terima kasih untuk yang kemarin.
Dialogue: 0,0:08:15.89,0:08:18.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin kamu sudah tahu,
Dialogue: 0,0:08:18.02,0:08:20.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pelaku kemarin sudah tertangkap, lo.
Dialogue: 0,0:08:20.77,0:08:24.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, boleh aku balas budi?
Dialogue: 0,0:08:24.48,0:08:25.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Balas budi?
Dialogue: 0,0:08:26.21,0:08:28.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama aku sanggup,
Dialogue: 0,0:08:28.82,0:08:32.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}silakan minta apa saja.
Dialogue: 0,0:08:33.98,0:08:36.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:08:36.50,0:08:40.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti ada kiriman bahan makanan\Nyang kupesan daring,
Dialogue: 0,0:08:40.88,0:08:43.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi sayangnya kebanyakan.
Dialogue: 0,0:08:47.34,0:08:50.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, bukan yang seperti itu.
Dialogue: 0,0:08:50.47,0:08:54.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang lebih bermanfaat buat Om...
Dialogue: 0,0:08:54.14,0:08:56.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya.
Dialogue: 0,0:08:57.81,0:09:00.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan ambil ini kalau mau.
Dialogue: 0,0:09:01.94,0:09:04.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, aku berangkat dulu.
Dialogue: 0,0:09:05.61,0:09:07.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hati-hati di jalan.
Dialogue: 0,0:09:09.68,0:09:13.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benar-benar bisa hidup berkat Om.
Dialogue: 0,0:09:15.08,0:09:18.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemberian secara sepihak
Dialogue: 0,0:09:18.67,0:09:21.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa merusak harga diri\Nseseorang dengan mudah.
Dialogue: 0,0:09:22.12,0:09:23.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:09:24.04,0:09:26.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak cuma diberi terus.
Dialogue: 0,0:09:26.70,0:09:29.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Andai bisa membalas pemberiannya,
Dialogue: 0,0:09:29.92,0:09:32.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku bisa mengembalikan jati diri ini.
Dialogue: 0,0:09:32.93,0:09:35.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa begitu.
Dialogue: 0,0:09:35.69,0:09:40.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebelumnya, aku belum tahu caranya.
Dialogue: 0,0:09:43.60,0:09:48.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi tatapan tidak senonoh\Npara pria mesum itu jadi pengingat.
Dialogue: 0,0:09:48.61,0:09:52.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang kumiliki cuma tubuh ini.
Dialogue: 0,0:09:52.89,0:09:54.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi...
Dialogue: 0,0:09:55.20,0:09:57.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma bisa memanfaatkan yang ada.
Dialogue: 0,0:10:00.92,0:10:03.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bakal berjuang untuk tumbuh.
Dialogue: 0,0:10:05.46,0:10:08.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong tunggu aku, Om.
Dialogue: 0,0:10:09.05,0:10:12.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena aku dan Om itu mirip.
Dialogue: 0,0:10:12.59,0:10:16.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bisa saling melengkapi\Nkekurangan satu sama lain.
Dialogue: 0,0:10:16.61,0:10:18.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah begitu?
Dialogue: 0,0:10:19.35,0:10:21.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, kan, Om?
Dialogue: 0,0:10:34.03,0:10:35.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Om!
Dialogue: 0,0:10:42.83,0:10:46.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, apa ini berkat kamu?
Dialogue: 0,0:10:51.09,0:10:54.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Om! Om!
Dialogue: 0,0:10:56.64,0:10:59.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana ini...
Dialogue: 0,0:10:59.83,0:11:04.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh saja bahagia karena selamat,\Ntapi sesuaikan waktu dan tempat.
Dialogue: 0,0:11:05.81,0:11:07.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu...
Dialogue: 0,0:11:12.86,0:11:13.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hai!
Dialogue: 0,0:11:14.19,0:11:17.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini pertemuan kedua kita\Ndalam wujudku ini, ya.
Dialogue: 0,0:11:26.00,0:11:29.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, malaikat mungil itu di mana?
Dialogue: 0,0:11:29.42,0:11:32.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya, Utusannya sudah diusir.
Dialogue: 0,0:11:32.17,0:11:37.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku juga tidak bisa memperkirakan\Ntindakan apa yang akan lawan ambil.
Dialogue: 0,0:11:38.47,0:11:42.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, dengan adanya sosokmu\Nyang tidak terduga,
Dialogue: 0,0:11:42.10,0:11:44.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mereka pasti menjaga jarak
Dialogue: 0,0:11:44.56,0:11:47.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau mau bertarung penuh persiapan.
Dialogue: 0,0:11:47.69,0:11:52.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketika lebih dari 10 malaikat atau iblis\Nberkumpul di lokasi terbatas,
Dialogue: 0,0:11:52.40,0:11:55.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}katanya dunia misterius itu akan muncul.
Dialogue: 0,0:11:55.86,0:12:00.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam kasus ini, bisakah diasumsikan\Nbahwa kita kembali ke dunia asal
Dialogue: 0,0:12:00.91,0:12:04.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan lukaku pulih karena para malaikat\Nmenjauh dari lokasi?
Dialogue: 0,0:12:04.66,0:12:08.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemahamanmu keliru sekali.
Dialogue: 0,0:12:09.25,0:12:10.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang salah?
Dialogue: 0,0:12:11.13,0:12:12.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jumlah tidak ada hubungannya.
Dialogue: 0,0:12:12.96,0:12:17.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, target yang dimaksud itu Utusan,\Nbukan malaikat atau iblis.
Dialogue: 0,0:12:17.17,0:12:22.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena aku mengalahkan Utusan malaikat\Natau mengusirnya jauh-jauh,
Dialogue: 0,0:12:22.05,0:12:25.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mereka jadi jauh dari gadis ini\Nyang seorang Utusan iblis.
Dialogue: 0,0:12:25.47,0:12:27.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akibatnya ruang isolasi pun lenyap.
Dialogue: 0,0:12:28.49,0:12:32.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi aku lolos dari maut berkat itu, ya?
Dialogue: 0,0:12:32.48,0:12:34.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:12:34.61,0:12:39.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu juga sudah menyelamatkan dia,\Njadi kita impas.
Dialogue: 0,0:12:39.57,0:12:43.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata kamu sungguh\Ntidak tahu apa-apa, ya.
Dialogue: 0,0:12:43.45,0:12:47.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bisa, tolong beri tahu aku\Nberbagai petunjuk soal ini.
Dialogue: 0,0:12:47.91,0:12:52.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kami juga sama.
Dialogue: 0,0:12:52.17,0:12:53.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:12:53.67,0:12:57.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang, kan?\NKamu itu faktor tidak terduga.
Dialogue: 0,0:12:57.84,0:12:59.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:12:59.25,0:13:04.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para malaikat dan iblis tidak tahu\Nsoal kekuatan supranatural.
Dialogue: 0,0:13:04.73,0:13:09.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena ada tetanggaku,\Naku tidak ingin bermusuhan dengannya.
Dialogue: 0,0:13:10.19,0:13:14.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau kita bertukar info?
Dialogue: 0,0:13:14.40,0:13:17.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senang mendengar tawaran itu!
Dialogue: 0,0:13:17.36,0:13:21.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Om, aku senang sekali.
Dialogue: 0,0:13:21.03,0:13:22.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:13:22.66,0:13:26.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, aku juga spontan.
Dialogue: 0,0:13:26.20,0:13:28.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oi!
Dialogue: 0,0:13:28.04,0:13:32.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga boleh ke situ?\NBakal diserang, tidak?
Dialogue: 0,0:13:32.79,0:13:35.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenalan Om?
Dialogue: 0,0:13:35.00,0:13:38.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, dia rekan kerjaku.
Dialogue: 0,0:13:38.84,0:13:41.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi dia terlihat kecil.
Dialogue: 0,0:13:41.93,0:13:46.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu, dia orang dewasa\Nyang usianya di atas kamu.
Dialogue: 0,0:13:46.06,0:13:48.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Sungguh?
Dialogue: 0,0:13:48.64,0:13:52.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eng, nanti kujelaskan juga soal itu.
Dialogue: 0,0:13:52.98,0:13:54.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa pindah tempat dulu?
Dialogue: 0,0:13:54.90,0:13:57.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, baiklah.
Dialogue: 0,0:14:04.78,0:14:07.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu.
Dialogue: 0,0:14:07.12,0:14:11.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perang proksi malaikat dan iblis.\NSkalanya besar sekali.
Dialogue: 0,0:14:12.21,0:14:15.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permainan maut terdengar menyeramkan.
Dialogue: 0,0:14:15.83,0:14:19.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Om, kamu mengkhawatirkanku?
Dialogue: 0,0:14:19.67,0:14:23.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa pun pasti khawatir\Nkalau kenalannya terlibat hal seperti itu.
Dialogue: 0,0:14:23.80,0:14:27.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempat tinggalmu dekat dengannya, kan?
Dialogue: 0,0:14:27.10,0:14:28.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya kenapa?
Dialogue: 0,0:14:28.76,0:14:33.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu selangkah saja\Nlebih dekat dengannya,
Dialogue: 0,0:14:33.48,0:14:36.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami mungkin tidak akan bertemu.
Dialogue: 0,0:14:36.86,0:14:43.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan kalaupun bertemu, dia tidak akan\Nmenerima ajakanku ikut permainan ini.
Dialogue: 0,0:14:43.20,0:14:46.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Abaddon, jangan bilang begitu!
Dialogue: 0,0:14:46.32,0:14:48.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Faktanya begitu, kan?
Dialogue: 0,0:14:49.49,0:14:54.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang jelas, sosok kalian sangat berguna.
Dialogue: 0,0:14:54.21,0:14:57.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benci hal berbahaya begitu.
Dialogue: 0,0:14:57.46,0:14:59.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:14:59.42,0:15:04.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keuntungan bersekutu dengan malaikat\Ndan iblis seperti yang kujelaskan tadi.
Dialogue: 0,0:15:04.42,0:15:08.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa mengabulkan permohonan dengan\Nkekuatan melampaui nalar manusia, kan?
Dialogue: 0,0:15:09.22,0:15:12.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kami bukan Utusan.
Dialogue: 0,0:15:12.06,0:15:17.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya, partnerku menyukaimu.
Dialogue: 0,0:15:17.48,0:15:20.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau negosiasi lancar, aku bisa saja
Dialogue: 0,0:15:20.44,0:15:25.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}membantu kalian dengan dirinya\Nsebagai perantara.
Dialogue: 0,0:15:25.61,0:15:27.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin peserta permainan maut lain
Dialogue: 0,0:15:27.99,0:15:31.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}melakukan negosiasi serupa\Ndi berbagai tempat.
Dialogue: 0,0:15:31.49,0:15:34.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau benar, sudah pasti tujuan mereka
Dialogue: 0,0:15:34.33,0:15:37.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah mencapai jajaran tertinggi\Ndalam struktur kekuasaan.
Dialogue: 0,0:15:38.07,0:15:43.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya masalah waktu sebelum biro\Ntahu soal malaikat dan iblis.
Dialogue: 0,0:15:43.78,0:15:49.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apalagi dia tetangga apartemen\Nyang sudah kutempati bertahun-tahun.
Dialogue: 0,0:15:52.60,0:15:54.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah pasti berbahaya.
Dialogue: 0,0:15:55.56,0:15:59.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi itu memang tawaran menarik.
Dialogue: 0,0:15:59.06,0:16:04.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Futari Shizuka, Anda mau minta orang ini\Nmelepas kutukannya, kan?
Dialogue: 0,0:16:06.45,0:16:09.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok ketahuan?
Dialogue: 0,0:16:09.24,0:16:10.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja.
Dialogue: 0,0:16:10.95,0:16:13.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Reaksimu klise banget.
Dialogue: 0,0:16:14.29,0:16:19.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gara-gara kejadian ini, keberadaan kita\Ndiketahui para malaikat secara luas.
Dialogue: 0,0:16:20.63,0:16:24.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, kamu punya teman Utusan lain?
Dialogue: 0,0:16:24.59,0:16:29.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayangnya, partnerku ini pemalu.
Dialogue: 0,0:16:29.76,0:16:33.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Abaddon, kamu bicara\Nyang tidak perlu sejak tadi!
Dialogue: 0,0:16:33.97,0:16:37.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, satu tipe sama Hoshizaki, ya.
Dialogue: 0,0:16:37.94,0:16:41.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajar saja kalau dilihat\Ndari kondisi keluarganya.
Dialogue: 0,0:16:41.52,0:16:47.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diingat-ingat, aku belum pernah\Nmelihat dia bawa teman.
Dialogue: 0,0:16:48.03,0:16:50.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebentar, aku juga sama saja.
Dialogue: 0,0:16:51.62,0:16:56.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhir-akhir ini aku bersama Pipi,\Njadinya tiap hari menyenangkan.
Dialogue: 0,0:16:57.83,0:17:01.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimanapun,\Nkami punya niat untuk bekerja sama.
Dialogue: 0,0:17:01.67,0:17:04.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wow! Aku senang sekali!
Dialogue: 0,0:17:04.67,0:17:09.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Om! Jangan memaksakan diri!\NAku bisa sendiri!
Dialogue: 0,0:17:10.58,0:17:13.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau tanya blak-blakan.
Dialogue: 0,0:17:13.39,0:17:16.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau malaikat bersayap enam itu menyerang,
Dialogue: 0,0:17:16.68,0:17:19.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa Abaddon bisa mengatasinya sendirian?
Dialogue: 0,0:17:20.14,0:17:24.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dia sendiri,\Nsetidaknya aku tidak akan kalah.
Dialogue: 0,0:17:24.85,0:17:30.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi malaikatnya memang banyak, sih.
Dialogue: 0,0:17:30.24,0:17:33.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sekhawatir itu pada gadis ini?
Dialogue: 0,0:17:34.56,0:17:38.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak khawatir, aku tidak akan\Nikut campur waktu itu.
Dialogue: 0,0:17:42.75,0:17:46.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerugian pihak musuh juga\Ncukup besar kali ini.
Dialogue: 0,0:17:46.71,0:17:48.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asal Utusannya tidak bodoh,
Dialogue: 0,0:17:48.96,0:17:52.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kurasa mereka tidak akan minta\Ntanding ulang dalam waktu dekat.
Dialogue: 0,0:17:52.38,0:17:56.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Informasi tentangmu juga belum cukup.
Dialogue: 0,0:17:57.72,0:18:03.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku justru ingin minta bantuan kalian\Ndalam perselisihan antarmanusia.
Dialogue: 0,0:18:03.48,0:18:07.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah gagal meski mengerahkan\Nbanyak malaikat,
Dialogue: 0,0:18:07.02,0:18:11.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kurasa pola serang mereka\Nakan berubah nantinya.
Dialogue: 0,0:18:12.15,0:18:17.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk saat ini, dia mengharapkan\Nbantuan bersifat materi di dunia nyata.
Dialogue: 0,0:18:17.20,0:18:21.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tahu sihirnya Pipi,\Nmungkin dia akan berubah pikiran.
Dialogue: 0,0:18:21.79,0:18:26.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku izin pulang dulu\Ndan mempertimbangkannya lagi.
Dialogue: 0,0:18:26.59,0:18:27.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke!
Dialogue: 0,0:18:27.25,0:18:31.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong pertimbangkan dengan positif!
Dialogue: 0,0:18:31.21,0:18:32.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:18:32.94,0:18:37.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, Futari Shizuka.\NMaaf, tolong jaga tetanggaku.
Dialogue: 0,0:18:38.22,0:18:42.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tinggal antar saja ke apartemenmu, kan?
Dialogue: 0,0:18:42.27,0:18:44.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa tidak bisa?
Dialogue: 0,0:18:44.73,0:18:47.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lain kali aku kasih tarif, ah!
Dialogue: 0,0:18:49.30,0:18:51.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pergi dulu, ya.
Dialogue: 0,0:19:03.41,0:19:04.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi-lagi,
Dialogue: 0,0:19:05.29,0:19:08.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku bisa hidup berkat Om.
Dialogue: 0,0:19:08.59,0:19:13.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa cengar-cengir\Nmenjijikkan begitu?
Dialogue: 0,0:19:14.26,0:19:18.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak berhak\Nbilang begitu padaku, Abaddon!
Dialogue: 0,0:19:20.18,0:19:24.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Om pulang jam berapa hari ini, ya?
Dialogue: 0,0:19:24.89,0:19:29.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia terlihat sibuk, mungkin kami\Ntidak bisa bertemu hari ini.
Dialogue: 0,0:19:30.94,0:19:36.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, ujung-ujungnya kita tidak bisa\Nmemastikan siapa mereka.
Dialogue: 0,0:19:36.43,0:19:38.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Om adalah Om.
Dialogue: 0,0:19:38.37,0:19:41.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagiku, itu sudah cukup.
Dialogue: 0,0:19:41.37,0:19:46.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin kamu sedikit\Nmemperbaiki sifat itu.
Dialogue: 0,0:19:46.16,0:19:48.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku ubah pengucapannya.
Dialogue: 0,0:19:48.92,0:19:53.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bukan di posisi yang berhak\Nminta kepastian dari mereka.
Dialogue: 0,0:19:53.38,0:19:57.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan mengorek informasi sembarangan,
Dialogue: 0,0:19:57.09,0:20:01.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebaiknya kita menunggu\Nsampai mereka memberi tahu.
Dialogue: 0,0:20:01.60,0:20:04.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, itu benar, sih.
Dialogue: 0,0:20:04.43,0:20:09.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kamu sudah mengorek\Ninfo tentang dia, kan?
Dialogue: 0,0:20:09.10,0:20:10.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak!
Dialogue: 0,0:20:10.81,0:20:15.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu selalu menempelkan telinga\Ndi dinding untuk menguping, kan?
Dialogue: 0,0:20:15.99,0:20:19.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu juga pernah mengintip\Ndari luar jendela, kan?
Dialogue: 0,0:20:21.20,0:20:24.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sampai Om tahu soal itu.
Dialogue: 0,0:20:24.79,0:20:26.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, sayang banget!
Dialogue: 0,0:20:26.79,0:20:31.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak diperintah begini,\Naku pasti sudah mengadu!
Dialogue: 0,0:20:33.13,0:20:34.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buang-buang waktu.
Dialogue: 0,0:20:35.40,0:20:37.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin merasakan Om sekarang.
Dialogue: 0,0:20:38.45,0:20:42.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin memenuhi isi kepalaku\Ndengan memikirkan Om.
Dialogue: 0,0:20:43.00,0:20:45.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, Om...
Dialogue: 0,0:20:45.72,0:20:47.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ganteng banget.
Dialogue: 0,0:20:48.32,0:20:50.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin bicara dengannya terus.
Dialogue: 0,0:20:50.89,0:20:53.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin memandangi wajahnya terus.
Dialogue: 0,0:20:53.77,0:20:56.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin mendengarnya bicara.
Dialogue: 0,0:21:02.07,0:21:07.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya dengan memikirkan Om,\Naku sangat bahagia.
Dialogue: 0,0:21:07.91,0:21:12.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, siapa orang yang bersamanya?
Dialogue: 0,0:21:13.38,0:21:18.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski dibilang rekan kerjanya,\Ntapi jelas-jelas itu anak-anak.
Dialogue: 0,0:21:18.76,0:21:21.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu menyadari sesuatu?
Dialogue: 0,0:21:21.79,0:21:22.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:21:22.89,0:21:27.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku merasa dia bukan orang biasa,\Nsama seperti om itu.
Dialogue: 0,0:21:27.18,0:21:28.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:21:29.94,0:21:33.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?\NKok tiba-tiba diam?
Dialogue: 0,0:21:33.06,0:21:34.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan apa-apa.
Dialogue: 0,0:21:38.74,0:21:39.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja.
Dialogue: 0,0:21:39.95,0:21:44.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dan Om itu sama.\NKami berdua itu serasi.
Dialogue: 0,0:21:44.85,0:21:49.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kali ini aku yang akan\Nmenyelamatkan Om.
Dialogue: 0,0:21:49.04,0:21:53.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, setelah saling berlumuran darah\Nsatu sama lain,
Dialogue: 0,0:21:53.88,0:21:57.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hubungan kami akan lebih erat.
Dialogue: 0,0:21:57.75,0:21:59.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Indah sekali.
Dialogue: 0,0:22:00.70,0:22:01.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:22:02.09,0:22:07.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat bertemu lagi,\Naku akan mencari tahu siapa wanita
Dialogue: 0,0:22:07.01,0:22:08.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang gaya bicaranya aneh itu.
