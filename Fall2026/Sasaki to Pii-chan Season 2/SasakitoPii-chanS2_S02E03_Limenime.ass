Dialogue: 0,0:01:21.69,0:01:29.28,sign,,0000,0000,0000,,SASAKI DAN PIPI S2
Dialogue: 0,0:02:41.02,0:02:44.48,sign,,0000,0000,0000,,EPISODE 3: SEMBUNYI DAN MENYUSUP
Dialogue: 0,0:13:34.00,0:13:34.92,sign,,0000,0000,0000,,TOLONG DATANG KE TAMAN\NSAAT ISTIRAHAT SIANG, SHINDO
Dialogue: 0,0:14:23.22,0:14:24.93,sign,,0000,0000,0000,,RUANG KEPSEK
Dialogue: 0,0:14:59.00,0:14:59.80,sign,,0000,0000,0000,,TOLONG DATANG KE TAMAN
Dialogue: 0,0:14:59.80,0:15:00.67,sign,,0000,0000,0000,,SAAT ISTIRAHAT SIANG, SHINDO
Dialogue: 0,0:00:05.86,0:00:08.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elsa, kenapa...
Dialogue: 0,0:00:20.29,0:00:24.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam kasus gantung diri, konon korban\Nmasih hidup sesaat setelahnya.
Dialogue: 0,0:00:25.04,0:00:26.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asal masih hidup,
Dialogue: 0,0:00:26.59,0:00:29.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin dia bisa selamat\Npakai sihir pemulihan.
Dialogue: 0,0:00:44.61,0:00:47.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayahanda...
Dialogue: 0,0:00:48.86,0:00:50.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elsa...
Dialogue: 0,0:00:51.41,0:00:54.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah! Sungguh!
Dialogue: 0,0:00:55.45,0:00:58.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elsa, kenapa kamu bunuh diri?
Dialogue: 0,0:00:59.25,0:01:02.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daripada membebani Ayahanda,
Dialogue: 0,0:01:02.67,0:01:05.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku lebih baik mati.
Dialogue: 0,0:02:42.52,0:02:44.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ulangi lagi.
Dialogue: 0,0:02:44.92,0:02:47.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daripada membebani Ayahanda,
Dialogue: 0,0:02:47.44,0:02:49.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku lebih baik mati!
Dialogue: 0,0:02:51.44,0:02:52.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elsa.
Dialogue: 0,0:02:52.90,0:02:54.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengar baik-baik.
Dialogue: 0,0:02:55.17,0:02:57.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggan mempertaruhkan nyawamu
Dialogue: 0,0:02:57.95,0:03:00.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hanya demi melindungi keluarga ini.
Dialogue: 0,0:03:00.98,0:03:02.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah itu
Dialogue: 0,0:03:02.29,0:03:06.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebuah kelalaian sebagai\Nkepala keluarga Müller?
Dialogue: 0,0:03:10.59,0:03:14.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keluarga Müller termasuk\Ndalam faksi Pangeran Kedua, Adonis.
Dialogue: 0,0:03:14.26,0:03:18.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa menikahi\NPangeran Pertama Louis
Dialogue: 0,0:03:18.65,0:03:20.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk menjadi sanderanya.
Dialogue: 0,0:03:21.85,0:03:23.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu...
Dialogue: 0,0:03:23.39,0:03:25.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf kalau pertanyaan saya lancang.
Dialogue: 0,0:03:25.73,0:03:31.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah permintaan ini sulit ditolak?
Dialogue: 0,0:03:32.86,0:03:35.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seorang putri penguasa wilayah biasa
Dialogue: 0,0:03:35.82,0:03:38.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dipilih sebagai selir utama\Npangeran pertama
Dialogue: 0,0:03:38.87,0:03:41.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}belum pernah terjadi.
Dialogue: 0,0:03:41.20,0:03:45.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Normalnya, ini tawaran perjodohan\Nyang luar biasa.
Dialogue: 0,0:03:45.29,0:03:47.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau menolak tanpa alasan kuat,
Dialogue: 0,0:03:47.91,0:03:51.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}itu akan dianggap mencoreng\Nwibawa keluarga kerajaan.
Dialogue: 0,0:03:52.35,0:03:58.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau jadi beban keluarga\Nuntuk selamanya!
Dialogue: 0,0:03:58.78,0:04:02.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayahanda, tolong biarkan aku pergi.
Dialogue: 0,0:04:02.18,0:04:03.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elsa...
Dialogue: 0,0:04:05.81,0:04:07.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,
Dialogue: 0,0:04:07.10,0:04:09.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku punya usul.
Dialogue: 0,0:04:13.73,0:04:18.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Titipkan saja putrimu\Nke dunia orang ini untuk sementara.
Dialogue: 0,0:04:20.66,0:04:22.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu.
Dialogue: 0,0:04:22.37,0:04:25.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dunia Tuan Sasaki?
Dialogue: 0,0:04:25.87,0:04:30.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aliran waktu di dunia ini\Ndan dunia sana berbeda.
Dialogue: 0,0:04:31.05,0:04:34.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beberapa tahun di sini\Ncuma beberapa bulan di sana.
Dialogue: 0,0:04:34.71,0:04:37.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau menghilang dua sampai tiga tahun,
Dialogue: 0,0:04:37.22,0:04:41.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dunia pasti banyak berubah\Nterlepas dari keberadaan putrimu.
Dialogue: 0,0:04:41.99,0:04:44.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu, ada risikonya juga.
Dialogue: 0,0:04:45.22,0:04:48.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau terjadi sesuatu pada kami,
Dialogue: 0,0:04:48.48,0:04:51.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}putrimu harus hidup\Ndi tanah asing selamanya
Dialogue: 0,0:04:51.45,0:04:54.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tanpa bisa mengandalkan siapa pun.
Dialogue: 0,0:04:54.52,0:04:59.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Burung, Sasaki pernah bilang\Nbahwa itu mustahil.
Dialogue: 0,0:04:59.78,0:05:02.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Situasinya sudah berubah.
Dialogue: 0,0:05:02.37,0:05:03.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, kan?
Dialogue: 0,0:05:03.53,0:05:06.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutku Pipi benar.
Dialogue: 0,0:05:06.99,0:05:09.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alasannya adalah hubungan\Ndengan Futari Shizuka.
Dialogue: 0,0:05:10.67,0:05:12.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah kami bergaul beberapa waktu,
Dialogue: 0,0:05:12.96,0:05:16.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ternyata negosiasi dengannya\Ncukup fleksibel.
Dialogue: 0,0:05:16.42,0:05:18.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama membayar imbalan,
Dialogue: 0,0:05:18.71,0:05:21.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pasti dia bisa menyembunyikan satu orang.
Dialogue: 0,0:05:21.22,0:05:22.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:05:22.39,0:05:25.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama tidak membebani Ayahanda,
Dialogue: 0,0:05:25.60,0:05:28.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tidak keberatan dengan risikonya.
Dialogue: 0,0:05:28.22,0:05:31.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong bawa aku ke dunia sana!
Dialogue: 0,0:05:31.10,0:05:33.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elsa, pikirkanlah baik-baik!
Dialogue: 0,0:05:33.90,0:05:34.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayahanda.
Dialogue: 0,0:05:34.98,0:05:37.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesempatan ini tidak datang dua kali.
Dialogue: 0,0:05:37.82,0:05:39.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dunia mereka
Dialogue: 0,0:05:39.36,0:05:43.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jauh lebih canggih dari dunia kita.
Dialogue: 0,0:05:44.07,0:05:48.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bisa menerapkan ilmu\Ndari dunia sana ke dunia ini,
Dialogue: 0,0:05:48.45,0:05:51.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku yakin bisa membantu Ayahanda!
Dialogue: 0,0:05:52.70,0:05:54.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Count.
Dialogue: 0,0:05:54.78,0:05:57.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari saling bantu saat kesulitan.
Dialogue: 0,0:05:57.04,0:06:01.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Tuan Count berkenan,\Nkami akan membantu.
Dialogue: 0,0:06:08.02,0:06:09.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:06:10.73,0:06:13.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mereka memang bersedia,
Dialogue: 0,0:06:13.56,0:06:17.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku juga akan menghargai pilihanmu.
Dialogue: 0,0:06:17.15,0:06:20.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, jangan sampai merepotkan mereka.
Dialogue: 0,0:06:20.74,0:06:23.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berjanjilah atas nama baik keluarga.
Dialogue: 0,0:06:23.70,0:06:27.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menepati janji pada Ayahanda!
Dialogue: 0,0:06:27.66,0:06:28.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus.
Dialogue: 0,0:06:35.00,0:06:37.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia keras banget!
Dialogue: 0,0:06:37.25,0:06:39.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pakai shotgun saja kali, ya?
Dialogue: 0,0:06:42.51,0:06:44.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada perlu apa selarut ini?
Dialogue: 0,0:06:45.68,0:06:46.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:06:52.18,0:06:56.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, kamu jadi direpotkan\Noleh usulanku yang seenaknya.
Dialogue: 0,0:06:58.06,0:06:59.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.
Dialogue: 0,0:06:59.48,0:07:01.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutku itu ide bagus.
Dialogue: 0,0:07:01.73,0:07:04.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Futari Shizuka juga mau membantu.
Dialogue: 0,0:07:04.70,0:07:05.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:07:06.26,0:07:09.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia juga harus diberi imbalan\Nkarena sudah mau repot.
Dialogue: 0,0:07:10.02,0:07:12.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, akan kusiapkan batangan logamnya.
Dialogue: 0,0:07:12.83,0:07:14.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, tolong.
Dialogue: 0,0:07:20.75,0:07:25.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, aku mau menghafal mantra sihir dulu.
Dialogue: 0,0:07:26.63,0:07:28.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini...
Dialogue: 0,0:07:36.60,0:07:40.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, tunggu! Jangan!
Dialogue: 0,0:07:44.49,0:07:46.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah tahu belum?
Dialogue: 0,0:07:46.45,0:07:49.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Count Müller dari faksi Pangeran Kedua.
Dialogue: 0,0:07:49.78,0:07:54.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar, putrinya akan resmi menjadi\Nselir Pangeran Pertama.
Dialogue: 0,0:07:54.83,0:07:58.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pangeran Louis tega sekali.
Dialogue: 0,0:07:58.42,0:08:02.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pasti sedang menuju kemari.
Dialogue: 0,0:08:03.67,0:08:06.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elsa sudah bersedia, ya.
Dialogue: 0,0:08:07.44,0:08:08.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:08:08.72,0:08:11.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, dengan sifat itu
Dialogue: 0,0:08:11.18,0:08:13.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia bakal cekcok sama Pangeran\Nlalu dipulangkan.
Dialogue: 0,0:08:14.77,0:08:17.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga begitu.
Dialogue: 0,0:08:28.28,0:08:29.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serangan musuh!
Dialogue: 0,0:08:30.36,0:08:32.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada bandit!
Dialogue: 0,0:08:33.28,0:08:35.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya, angkat pedang kalian!
Dialogue: 0,0:08:35.28,0:08:37.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jauhkan mereka dari Elsa!
Dialogue: 0,0:08:52.34,0:08:54.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayahanda! Elsa!
Dialogue: 0,0:08:57.13,0:08:58.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakanda!
Dialogue: 0,0:09:12.02,0:09:15.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kita harus beralasan apa\Nke orang-orang?
Dialogue: 0,0:09:15.87,0:09:21.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo pakai cara yang sama\Ndengan cara Julius dulu.
Dialogue: 0,0:09:21.21,0:09:23.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Caraku?
Dialogue: 0,0:09:23.75,0:09:28.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita rekayasa serangan bandit\Ndan buat seolah putrimu mati.
Dialogue: 0,0:09:28.05,0:09:31.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski mungkin dikecam,\Nmereka tidak akan berkutik.
Dialogue: 0,0:09:31.80,0:09:33.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:09:33.05,0:09:36.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus menipu semua orang di sekitar.
Dialogue: 0,0:09:40.91,0:09:43.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, tolong urus sisanya.
Dialogue: 0,0:09:43.69,0:09:48.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan pada saya.\NTuan Sasaki, mohon bantuannya.
Dialogue: 0,0:09:48.19,0:09:50.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tegur saja dia kalau egois.
Dialogue: 0,0:09:50.78,0:09:54.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, Papa!\NAku tidak akan egois!
Dialogue: 0,0:09:55.19,0:10:00.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada alat untuk merekam suara\Ndan visual di dunia sana.
Dialogue: 0,0:10:00.45,0:10:02.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat berkunjung ke sini lagi,
Dialogue: 0,0:10:02.67,0:10:06.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan mengabadikan\Nfoto Elsa yang ceria.
Dialogue: 0,0:10:06.46,0:10:08.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:10:08.49,0:10:12.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sungguh berterima kasih padamu.
Dialogue: 0,0:10:13.18,0:10:14.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elsa.
Dialogue: 0,0:10:14.43,0:10:18.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan lupakan janji kita, ya.
Dialogue: 0,0:10:18.39,0:10:19.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:10:19.60,0:10:22.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayahanda juga, jagalah diri baik-baik.
Dialogue: 0,0:10:24.35,0:10:26.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, ayo pergi.
Dialogue: 0,0:10:26.48,0:10:27.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:10:29.90,0:10:32.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayahanda, aku pamit!
Dialogue: 0,0:10:42.91,0:10:44.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya datang juga.
Dialogue: 0,0:10:44.42,0:10:48.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah membantu\Npersiapannya, Futari Shizuka.
Dialogue: 0,0:10:48.00,0:10:49.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon bantuannya untuk sementara.
Dialogue: 0,0:10:49.67,0:10:53.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian sungguh seenaknya minta tolong.
Dialogue: 0,0:10:53.30,0:10:56.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku disuruh menyiapkan\Npenginapan berbulan-bulan
Dialogue: 0,0:10:56.09,0:10:59.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hanya dalam semalam.
Dialogue: 0,0:10:59.22,0:11:02.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada kunjungan kali ini,\NFutari Shizuka ini
Dialogue: 0,0:11:02.73,0:11:05.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang akan membantu kita.
Dialogue: 0,0:11:05.19,0:11:07.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mo-Mohon bantuannya!
Dialogue: 0,0:11:07.61,0:11:10.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beliau bilang, "Mohon bantuannya!"
Dialogue: 0,0:11:11.15,0:11:12.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, oke.
Dialogue: 0,0:11:12.69,0:11:15.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu gadis yang tahu tata krama.
Dialogue: 0,0:11:17.66,0:11:20.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin menggelar pesta sambutan,
Dialogue: 0,0:11:20.62,0:11:23.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi sudah waktunya kami bertugas.
Dialogue: 0,0:11:23.70,0:11:26.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pipi, bisa tolong jaga rumah?
Dialogue: 0,0:11:26.46,0:11:28.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, serahkan padaku.
Dialogue: 0,0:11:32.96,0:11:37.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata cuma aku yang tidak paham\Nkalian bicara apa.
Dialogue: 0,0:11:37.34,0:11:40.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan jadi penerjemahmu saat siang.
Dialogue: 0,0:11:40.39,0:11:42.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena aku selalu senggang.
Dialogue: 0,0:11:42.47,0:11:45.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf selalu merepotkan.
Dialogue: 0,0:11:45.77,0:11:47.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan dipikirkan.
Dialogue: 0,0:11:47.52,0:11:52.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mumpung senggang, hari ini\Nkamu akan kuajarkan soal internet.
Dialogue: 0,0:11:52.32,0:11:54.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Internet?
Dialogue: 0,0:11:54.78,0:11:58.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Laut pengetahuan dunia ini.
Dialogue: 0,0:11:58.32,0:11:59.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada hal semacam itu?
Dialogue: 0,0:12:00.16,0:12:03.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Internet itu bagus, lo.
Dialogue: 0,0:12:06.33,0:12:10.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mau tahu apa itu internet?
Dialogue: 0,0:12:10.17,0:12:11.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau!
Dialogue: 0,0:12:12.67,0:12:14.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Internet!
Dialogue: 0,0:12:16.26,0:12:21.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini, aku ingin kalian\Nmenyelidiki sekolah ini.
Dialogue: 0,0:12:21.26,0:12:23.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekolah?
Dialogue: 0,0:12:23.85,0:12:27.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salah satu pemuda yang terbunuh\Ndi insiden kemarin
Dialogue: 0,0:12:27.77,0:12:30.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bersekolah di sana.
Dialogue: 0,0:12:31.56,0:12:35.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, Takayoshi anak SMA?
Dialogue: 0,0:12:35.78,0:12:39.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di TKP, tolong selidiki informasi kekuatannya
Dialogue: 0,0:12:39.70,0:12:42.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan apakah ada pemilik kekuatan lain.
Dialogue: 0,0:12:43.28,0:12:47.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyelidikan semacam ini\Nbenar-benar khas abdi negara, ya.
Dialogue: 0,0:12:47.45,0:12:49.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi mencegah keributan,
Dialogue: 0,0:12:49.33,0:12:53.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pihak sekolah kami kabari bahwa kalian\Ndatang untuk meninjau alat keamanan.
Dialogue: 0,0:12:53.42,0:12:55.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Detailnya akan dikirim\Nke perangkat kalian.
Dialogue: 0,0:12:55.55,0:12:57.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan cek sendiri.
Dialogue: 0,0:12:57.59,0:12:59.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada pertanyaan?
Dialogue: 0,0:12:59.76,0:13:00.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu...
Dialogue: 0,0:13:00.93,0:13:04.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hoshizaki tidak ikut kali ini?
Dialogue: 0,0:13:04.81,0:13:09.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya dia lebih cocok\Nuntuk penyelidikan sekolah.
Dialogue: 0,0:13:09.85,0:13:11.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya.
Dialogue: 0,0:13:12.65,0:13:16.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hoshizaki juga sekolah di sini.
Dialogue: 0,0:13:18.32,0:13:20.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama seperti kepolisian,
Dialogue: 0,0:13:20.24,0:13:24.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kebijakan kita tidak membiarkan pegawai\Nmenyelidiki latar belakang mereka sendiri.
Dialogue: 0,0:13:24.45,0:13:28.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hoshizaki pun tidak diberi tahu soal ini.
Dialogue: 0,0:13:28.52,0:13:33.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selidikilah dengan hati-hati\Nagar tidak menarik perhatiannya.
Dialogue: 0,0:13:39.99,0:13:43.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cerita mencurigakan Kabag Akutsu?
Dialogue: 0,0:13:43.47,0:13:47.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, kabarnya sebentar lagi\Nakan ada mutasi.
Dialogue: 0,0:13:47.26,0:13:50.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan wakil kepala yang sekarang\Nakan dipindahkan.
Dialogue: 0,0:13:50.81,0:13:51.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:13:51.69,0:13:55.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rumornya terkait insiden\Ndi arena boling itu.
Dialogue: 0,0:13:55.21,0:13:57.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru Wakil Kepala sendiri\Nyang termakan info palsu
Dialogue: 0,0:13:57.78,0:14:01.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan mengerahkan para pegawai biro.
Dialogue: 0,0:14:01.39,0:14:02.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan...
Dialogue: 0,0:14:02.61,0:14:05.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang akan mengisi posisi\Nwakil kepala yang kosong...
Dialogue: 0,0:14:05.70,0:14:07.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul sekali.
Dialogue: 0,0:14:07.91,0:14:10.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari sandiwara pria itu,
Dialogue: 0,0:14:10.08,0:14:13.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kantor harus menelan korban\Ndan atasan pun jatuh.
Dialogue: 0,0:14:13.49,0:14:15.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujungnya, dia naik jabatan.
Dialogue: 0,0:14:17.21,0:14:21.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu juga harus hati-hati\Ndan serius bekerja.
Dialogue: 0,0:14:24.93,0:14:29.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, bolehkah kami\Nberkeliling area sekolah?
Dialogue: 0,0:14:29.93,0:14:30.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu!
Dialogue: 0,0:14:30.72,0:14:35.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau butuh sesuatu,\Nsilakan datang ke ruang guru.
Dialogue: 0,0:14:40.98,0:14:44.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kurang tidur gara-gara seseorang.
Dialogue: 0,0:14:44.07,0:14:45.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh tidur siang sebentar?
Dialogue: 0,0:14:47.07,0:14:49.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bercanda, bercanda.
Dialogue: 0,0:14:50.04,0:14:53.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya gadis itu sedang belajar, ya.
Dialogue: 0,0:14:53.95,0:14:59.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada pengandaian masa lalu dan pengandaian\Nmasa lampau yang sudah berlalu.
Dialogue: 0,0:14:59.00,0:15:01.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemudian, ada pemakaian "with"
Dialogue: 0,0:15:01.51,0:15:03.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk menggantikan klausa "if".
Dialogue: 0,0:15:03.63,0:15:07.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari lihat soal berikutnya\Nsambil menerapkan itu...
Dialogue: 0,0:15:10.10,0:15:13.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tergila-gila padamu\Nsejak pandangan pertama.
Dialogue: 0,0:15:13.48,0:15:14.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mencintaimu dari dulu.
Dialogue: 0,0:15:15.30,0:15:17.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga, Jake.
Dialogue: 0,0:15:17.73,0:15:19.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga.
Dialogue: 0,0:15:19.44,0:15:21.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelly...
Dialogue: 0,0:15:21.75,0:15:24.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jake...
Dialogue: 0,0:15:26.45,0:15:27.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu kata mereka.
Dialogue: 0,0:15:28.28,0:15:31.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ja-Jadi ini...
Dialogue: 0,0:15:31.79,0:15:34.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Internet!
Dialogue: 0,0:15:37.88,0:15:39.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama istirahat siang,
Dialogue: 0,0:15:39.63,0:15:42.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}temukan murid yang mungkin\Npunya info terkait.
Dialogue: 0,0:15:43.38,0:15:44.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:15:44.63,0:15:48.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar, si Takayoshi\Nbelum pulang sejak kemarin.
Dialogue: 0,0:15:48.89,0:15:50.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Masa?
Dialogue: 0,0:15:50.39,0:15:52.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Langsung ketemu!
Dialogue: 0,0:15:52.64,0:15:53.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke.
Dialogue: 0,0:15:53.81,0:15:56.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama, rekam wajah mereka.
Dialogue: 0,0:15:58.31,0:16:01.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang tuanya menelepon ke rumahku.
Dialogue: 0,0:16:01.57,0:16:03.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paling di rumah pacar barunya.
Dialogue: 0,0:16:03.94,0:16:05.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Toh, dia pamer banget.
Dialogue: 0,0:16:05.90,0:16:07.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, bisa jadi.
Dialogue: 0,0:16:07.91,0:16:12.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi orang tuanya khawatir banget.
Dialogue: 0,0:16:12.70,0:16:14.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, sih.
Dialogue: 0,0:16:14.41,0:16:17.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi tidak biasanya dia jarang pulang.
Dialogue: 0,0:16:17.12,0:16:19.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sip, wajahnya tertangkap.
Dialogue: 0,0:16:19.83,0:16:22.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, aku pindah dulu.
Dialogue: 0,0:16:25.71,0:16:29.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gambarnya sudah kukirim ke kantor,\Nidentitasnya sedang dicek.
Dialogue: 0,0:16:29.43,0:16:30.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:16:30.84,0:16:32.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya sudah, aku kembali...
Dialogue: 0,0:16:32.93,0:16:36.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eits, tahu-tahu gadis itu mendekat.
Dialogue: 0,0:16:36.73,0:16:38.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arah jam sembilan.
Dialogue: 0,0:16:38.23,0:16:39.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jam sembilan?
Dialogue: 0,0:16:49.20,0:16:53.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada perlu apa, Kak Shindo?\NKok memanggilku ke sini?
Dialogue: 0,0:16:55.02,0:16:57.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf tiba-tiba memanggilmu.
Dialogue: 0,0:16:58.71,0:17:00.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan, ini...
Dialogue: 0,0:17:02.08,0:17:05.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Anu, Hoshizaki.
Dialogue: 0,0:17:05.83,0:17:08.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau pacaran denganku?
Dialogue: 0,0:17:10.97,0:17:13.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, tidak bisa.
Dialogue: 0,0:17:13.80,0:17:18.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, jangan-jangan kamu\Nsudah punya pacar?
Dialogue: 0,0:17:18.89,0:17:19.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:17:19.81,0:17:21.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, kan?
Dialogue: 0,0:17:21.19,0:17:22.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang tidak ada.
Dialogue: 0,0:17:23.31,0:17:25.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi sudah ada orang yang kusukai.
Dialogue: 0,0:17:26.65,0:17:28.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Serius?
Dialogue: 0,0:17:28.06,0:17:29.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, serius.
Dialogue: 0,0:17:29.61,0:17:31.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di-Dia murid sekolah ini?
Dialogue: 0,0:17:31.74,0:17:32.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan.
Dialogue: 0,0:17:32.66,0:17:34.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau seorang guru?
Dialogue: 0,0:17:34.57,0:17:35.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan.
Dialogue: 0,0:17:35.95,0:17:37.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:17:37.24,0:17:39.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin mirip.
Dialogue: 0,0:17:39.96,0:17:42.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wa-Waduh.
Dialogue: 0,0:17:42.67,0:17:43.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dah.
Dialogue: 0,0:17:43.83,0:17:45.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Anu!
Dialogue: 0,0:17:45.50,0:17:47.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau bertukar kontak?
Dialogue: 0,0:17:47.92,0:17:49.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mau main, kabari aku...
Dialogue: 0,0:17:49.84,0:17:51.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:17:51.01,0:17:54.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah punya cukup teman bermain.
Dialogue: 0,0:17:56.29,0:17:58.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah boleh pergi, kan?
Dialogue: 0,0:17:58.27,0:18:00.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya.
Dialogue: 0,0:18:04.10,0:18:06.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Indahnya masa muda.
Dialogue: 0,0:18:07.27,0:18:10.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku kembali ke sana, ya.
Dialogue: 0,0:18:10.53,0:18:13.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata kamu cuma main-main, Jake?
Dialogue: 0,0:18:13.28,0:18:14.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mempermainkanku, ya?
Dialogue: 0,0:18:14.99,0:18:17.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak!\NTunggu, Amanda!
Dialogue: 0,0:18:17.53,0:18:18.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak!
Dialogue: 0,0:18:18.58,0:18:20.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku memercayaimu, Jake!
Dialogue: 0,0:18:20.95,0:18:22.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mengkhianatiku, ya?
Dialogue: 0,0:18:22.71,0:18:24.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu salah paham, Betty!
Dialogue: 0,0:18:24.33,0:18:25.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak!
Dialogue: 0,0:18:25.17,0:18:26.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan begitu, Amanda!
Dialogue: 0,0:18:26.50,0:18:27.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak!
Dialogue: 0,0:18:27.17,0:18:28.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan begitu!
Dialogue: 0,0:18:28.88,0:18:31.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak!
Dialogue: 0,0:18:31.49,0:18:32.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu kata mereka.
Dialogue: 0,0:18:34.72,0:18:36.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi ini...
Dialogue: 0,0:18:36.35,0:18:38.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Internet.
Dialogue: 0,0:18:44.02,0:18:46.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah pemuda ini?
Dialogue: 0,0:18:46.52,0:18:49.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, menurut informasi kantor,
Dialogue: 0,0:18:49.57,0:18:53.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hanya dia saja temannya sejak SD.
Dialogue: 0,0:18:53.61,0:18:56.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajar dia jadi pilihan utama, kan?
Dialogue: 0,0:18:56.57,0:18:57.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap.
Dialogue: 0,0:18:58.33,0:18:59.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ups.
Dialogue: 0,0:19:04.96,0:19:09.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin saja dia punya kekuatan.\NUntuk jaga-jaga...
Dialogue: 0,0:19:14.75,0:19:17.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, maaf!\NArah jam enam!
Dialogue: 0,0:19:17.47,0:19:19.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis itu belok!
Dialogue: 0,0:19:19.39,0:19:20.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu!
Dialogue: 0,0:19:29.40,0:19:31.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah dengar!
Dialogue: 0,0:19:33.03,0:19:36.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal ditembak Kak Shindo,
Dialogue: 0,0:19:36.61,0:19:39.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kenapa malah menolak mentah-mentah?
Dialogue: 0,0:19:39.24,0:19:41.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa apanya?
Dialogue: 0,0:19:41.49,0:19:44.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma dipanggil dan ditembak\Nsaat istirahat siang.
Dialogue: 0,0:19:44.50,0:19:46.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada alasan khusus.
Dialogue: 0,0:19:47.08,0:19:49.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si-Sikapmu itu menyebalkan, tahu!
Dialogue: 0,0:19:49.84,0:19:52.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selalu saja angkuh begitu!
Dialogue: 0,0:19:53.05,0:19:56.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Pikirkan perasaan orang lain juga, dong!\N- Cepat hubungi lembaga antiperundungan!
Dialogue: 0,0:19:56.72,0:19:59.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Karena itulah kamu selalu sendirian di kelas!\N- Hentikan lelucon begitu!
Dialogue: 0,0:19:59.26,0:20:01.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu cuma mau membahas itu?
Dialogue: 0,0:20:01.64,0:20:06.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagian, biar apa sok-sokan gaul\Ndi depan senior yang menembakmu?
Dialogue: 0,0:20:06.44,0:20:08.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kasihan Kak Shindo!
Dialogue: 0,0:20:08.52,0:20:10.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapan aku begitu?
Dialogue: 0,0:20:10.11,0:20:12.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penampilan kutu bukumu itu
Dialogue: 0,0:20:12.52,0:20:16.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk merayu senior\Nyang suka cewek rajin, kan?
Dialogue: 0,0:20:16.45,0:20:19.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal di tes kemarin,
Dialogue: 0,0:20:19.41,0:20:21.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu dapat nilai merah!
Dialogue: 0,0:20:22.37,0:20:23.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:20:24.62,0:20:28.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Hoshizaki terlalu fokus kerja?
Dialogue: 0,0:20:28.75,0:20:30.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penampilan begitu, tapi nilainya merah...
Dialogue: 0,0:20:30.86,0:20:32.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namanya penipuan.
Dialogue: 0,0:20:32.63,0:20:36.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak berhak berkata sejauh itu.
Dialogue: 0,0:20:36.63,0:20:39.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Te-Terus, kenapa penampilanmu begitu?
Dialogue: 0,0:20:39.43,0:20:43.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bilang kamu tahu\NNami suka Kak Shindo,
Dialogue: 0,0:20:43.60,0:20:46.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}terus sengaja dandan begitu?
Dialogue: 0,0:20:49.85,0:20:53.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana kutahu soal hal pribadi kalian.
Dialogue: 0,0:20:54.15,0:20:55.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula...
Dialogue: 0,0:20:56.51,0:20:57.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manami.
Dialogue: 0,0:20:59.03,0:21:02.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tahu banget soal Kak Shindo.
Dialogue: 0,0:21:02.78,0:21:04.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai terbawa emosi.
Dialogue: 0,0:21:04.87,0:21:09.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan,\Nkamu juga suka Kak Shindo?
Dialogue: 0,0:21:10.58,0:21:12.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak!
Dialogue: 0,0:21:13.81,0:21:18.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf kalau itu benar,\Naku harus lebih peka.
Dialogue: 0,0:21:18.13,0:21:18.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dah.
Dialogue: 0,0:21:21.63,0:21:25.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, asal tahu saja\Nbiar tidak ada gosip aneh.
Dialogue: 0,0:21:26.74,0:21:28.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku masih perawan.
Dialogue: 0,0:21:28.64,0:21:32.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ha-Hah? Tunggu!
Dialogue: 0,0:21:32.44,0:21:35.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa malah cabut seenaknya?
Dialogue: 0,0:21:35.07,0:21:36.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selesai disimpan.
Dialogue: 0,0:21:36.73,0:21:38.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat hapus.
Dialogue: 0,0:21:38.24,0:21:40.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bercanda!
Dialogue: 0,0:21:41.15,0:21:42.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Futari Shizuka?
Dialogue: 0,0:21:49.66,0:21:52.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini...\NJangan-jangan...
Dialogue: 0,0:21:55.38,0:21:57.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak salah lagi.
Dialogue: 0,0:21:57.84,0:21:59.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang waktu itu.
