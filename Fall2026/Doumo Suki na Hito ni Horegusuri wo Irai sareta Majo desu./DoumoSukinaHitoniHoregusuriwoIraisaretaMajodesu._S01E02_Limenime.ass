Dialogue: 0,0:03:08.98,0:03:13.40,sign,,0000,0000,0000,,{\an8}EPISODE 2: PENYIHIR "TERBAIK" DI DANAU
Dialogue: 0,0:14:38.50,0:14:40.38,sign,,0000,0000,0000,,{\an8}DOYA
Dialogue: 0,0:00:03.50,0:00:06.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Obat untuk menjadi populer\Ndi kalangan gadis jika dipakai di ketiak."
Dialogue: 0,0:00:06.79,0:00:10.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Obat untuk menghilangkan rasa gatal\Njika ditaburkan di telapak kaki."
Dialogue: 0,0:00:10.46,0:00:13.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Racun serangga mengusir\Nhanya dengan asap."
Dialogue: 0,0:00:13.76,0:00:15.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Tentu saja.
Dialogue: 0,0:00:16.22,0:00:18.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami akan mengurus obat-obat ini baik.
Dialogue: 0,0:00:19.60,0:00:21.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, tentang obat ini.
Dialogue: 0,0:00:21.77,0:00:23.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Obat ini populer setelah diganti botolnya.
Dialogue: 0,0:00:24.02,0:00:24.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya?
Dialogue: 0,0:00:24.94,0:00:28.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan khawatir, aku akan mengurus\Npenjualannya dengan sempurna.
Dialogue: 0,0:00:28.94,0:00:31.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menyebutnya "Bank Paman".
Dialogue: 0,0:00:31.57,0:00:32.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengatakan hal yang sama lagi.
Dialogue: 0,0:00:33.07,0:00:36.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nama banknya tak bisa dipercaya.\NDia pasti menggelapkan uang.
Dialogue: 0,0:00:36.78,0:00:38.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harap kau percaya kepadaku.
Dialogue: 0,0:00:39.58,0:00:42.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kau pergi,\Naku bisa memberimu uang, obat,
Dialogue: 0,0:00:42.79,0:00:44.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau apa pun.
Dialogue: 0,0:00:54.55,0:00:56.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bukan berarti ada maksud yang mendalam.\N{\i0}
Dialogue: 0,0:00:56.93,0:00:59.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku hanya mau menggantinya\Nkarena sudah lama sekali.\N{\i0}
Dialogue: 0,0:01:00.01,0:01:01.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tidak ada niat lain.\N{\i0}
Dialogue: 0,0:01:01.26,0:01:02.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu...
Dialogue: 0,0:01:03.52,0:01:04.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah kau menjual jubah?
Dialogue: 0,0:01:05.52,0:01:07.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak peduli jenis apa pun.
Dialogue: 0,0:01:08.36,0:01:10.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak membawanya hari ini.
Dialogue: 0,0:01:10.61,0:01:11.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:01:13.15,0:01:14.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, kau membutuhkannya.
Dialogue: 0,0:01:15.82,0:01:17.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan bawa secepat mungkin.
Dialogue: 0,0:01:17.53,0:01:18.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan bawa secepat mungkin.
Dialogue: 0,0:01:19.07,0:01:20.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Secepat mungkin.
Dialogue: 0,0:01:24.95,0:01:27.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun, kemarin aku baru memberitahunya.\N{\i0}
Dialogue: 0,0:01:29.96,0:01:31.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Lalu, hari ini.\N{\i0}
Dialogue: 0,0:03:13.48,0:03:16.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kain ini disulam dengan manik-manik\Nyang digunakan di istana kerajaan,
Dialogue: 0,0:03:16.82,0:03:19.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menggambarkan bunga\Nyang hanya mekar di oasis.
Dialogue: 0,0:03:20.40,0:03:24.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang ini bulu raksasa yang hanya muncul\Nketika ada matahari pada tengah malam.
Dialogue: 0,0:03:25.20,0:03:26.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya?
Dialogue: 0,0:03:26.37,0:03:27.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kain ini juga.
Dialogue: 0,0:03:27.54,0:03:31.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar. Dicelupkan ke air suci\Ndi wilayah bersalju, jadi warnanya cantik.
Dialogue: 0,0:03:31.50,0:03:33.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Warnanya tidak luntur meski dicuci...
Dialogue: 0,0:03:33.29,0:03:36.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku tidak berpikir dia membawa\Nsebanyak ini dalam satu hari.\N{\i0}
Dialogue: 0,0:03:36.75,0:03:38.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kau mau yang mana?
Dialogue: 0,0:03:39.13,0:03:40.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rose, "Penyihir Danau".
Dialogue: 0,0:03:42.38,0:03:45.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, pilihanku\Nadalah warna lavender ini.
Dialogue: 0,0:03:45.55,0:03:47.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, cocok untukmu.
Dialogue: 0,0:03:48.77,0:03:51.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, aku mau Rose\Nmemakai warna merah muda.
Dialogue: 0,0:03:52.06,0:03:53.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mau!
Dialogue: 0,0:03:53.19,0:03:54.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti.
Dialogue: 0,0:03:54.52,0:03:56.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah berpikir begitu.
Dialogue: 0,0:03:56.31,0:03:58.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rose memang seperti itu.
Dialogue: 0,0:03:59.23,0:04:00.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia ini!\N{\i0}
Dialogue: 0,0:04:00.82,0:04:02.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku harus menyumpal mulutnya.\N{\i0}
Dialogue: 0,0:04:03.07,0:04:06.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}"Obat raksasa hitam\Nketika ditempatkan di sudut rumah."\N{\i0}
Dialogue: 0,0:04:06.12,0:04:07.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tidak boleh.\N{\i0}
Dialogue: 0,0:04:07.45,0:04:09.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mungkin aku harus memberinya itu...\N{\i0}
Dialogue: 0,0:04:10.37,0:04:12.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tidak boleh. Itu terlalu ekstrem.\N{\i0}
Dialogue: 0,0:04:14.37,0:04:17.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau hanya membawa\Nwarna-warna cerah begitu?
Dialogue: 0,0:04:17.54,0:04:19.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tanya kenapa?
Dialogue: 0,0:04:19.75,0:04:25.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kau sama sekali tidak berminat\Ndengan perhiasan pusaka ibumu.
Dialogue: 0,0:04:25.09,0:04:27.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski kau mewarisi gelar Penyihir Danau!
Dialogue: 0,0:04:27.35,0:04:30.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku selalu mendesakmu,\Ntapi kau tetap tidak mau!
Dialogue: 0,0:04:31.22,0:04:34.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena orang-orang seperti kaulah\Nyang memintanya.
Dialogue: 0,0:04:35.35,0:04:38.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kau bisa mengerti\Nkenapa aku bersemangat.
Dialogue: 0,0:04:39.98,0:04:42.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan khawatir tentang harganya.
Dialogue: 0,0:04:42.90,0:04:46.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin sedikit terlambat,\Ntapi ini hadiah dariku untuk merayakanmu.
Dialogue: 0,0:04:47.28,0:04:50.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, bagaimana kalau pilih satu\Nyang sangat lucu dan bergaya?
Dialogue: 0,0:04:50.99,0:04:52.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lucu?
Dialogue: 0,0:04:53.41,0:04:58.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kenangan Tien tentangku pasti\Nketika usiaku sekitar sepuluh tahun.\N{\i0}
Dialogue: 0,0:04:58.92,0:05:01.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pertemuan pertama di balik rok nenek.\N{\i0}
Dialogue: 0,0:05:01.67,0:05:05.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Awalnya, ayah Tien datang\Nke daerah itu sebagai saudagar,\N{\i0}
Dialogue: 0,0:05:05.59,0:05:07.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dan Tien mengambil alih usaha itu.\N{\i0}
Dialogue: 0,0:05:09.10,0:05:10.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ketika nenekku meninggal,\N{\i0}
Dialogue: 0,0:05:11.01,0:05:15.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}kalau bukan karena Tien dan ayahnya,\Naku mungkin tidak bisa memakamkan Nenek.\N{\i0}
Dialogue: 0,0:05:15.98,0:05:18.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mereka sangat baik kepadaku.\N{\i0}
Dialogue: 0,0:05:21.82,0:05:22.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itulah sebabnya,\N{\i0}
Dialogue: 0,0:05:22.94,0:05:26.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}ketika dia mengatakan itu,\Naku tidak bisa berkata apa-apa.\N{\i0}
Dialogue: 0,0:05:27.49,0:05:29.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kau mau yang mana?
Dialogue: 0,0:05:29.70,0:05:32.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak tahu\Nmana yang lucu atau bergaya.
Dialogue: 0,0:05:33.16,0:05:36.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku rasa aku tidak bisa membuat obat\Nsambil memakai ini.
Dialogue: 0,0:05:37.58,0:05:40.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku rasa kau sudah dewasa\Nkarena sadar akan hal itu.
Dialogue: 0,0:05:40.88,0:05:44.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pakaianmu dulu selalu kotor\Napa pun keadaannya.
Dialogue: 0,0:05:44.80,0:05:47.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bicara seolah-olah aku bodoh.
Dialogue: 0,0:05:47.18,0:05:48.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya tidak tertarik.
Dialogue: 0,0:05:48.93,0:05:51.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bicara\Nseolah-olah kau punya akal sehat.
Dialogue: 0,0:05:51.39,0:05:55.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, aku senang kau tertarik\Nmeski sedikit.
Dialogue: 0,0:05:55.27,0:05:58.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini tidak seperti yang kau katakan\Nsama sekali.
Dialogue: 0,0:06:01.77,0:06:03.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa? Suka yang itu?
Dialogue: 0,0:06:04.03,0:06:05.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Mari kita buka dan lihat.\N- Berhenti.
Dialogue: 0,0:06:06.86,0:06:08.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tien, jangan.
Dialogue: 0,0:06:10.66,0:06:13.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku memang tampak tertarik pada kain ini.\N{\i0}
Dialogue: 0,0:06:14.83,0:06:16.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun, tidak bisa.\N{\i0}
Dialogue: 0,0:06:16.58,0:06:18.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kalau aku membuat jubah dengan kain itu,\N{\i0}
Dialogue: 0,0:06:19.00,0:06:22.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}aku akan merasa\Nseperti terbungkus dalam jubahnya.\N{\i0}
Dialogue: 0,0:06:23.80,0:06:25.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Karena kesalahpahaman itu,\N{\i0}
Dialogue: 0,0:06:25.71,0:06:28.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}aku mungkin bermimpi tentang dia.\N{\i0}
Dialogue: 0,0:06:31.59,0:06:33.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat ini.
Dialogue: 0,0:06:33.18,0:06:34.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini adalah warna yang cocok untukmu.
Dialogue: 0,0:06:36.64,0:06:39.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kedua kain ini mungkin tampak biasa.
Dialogue: 0,0:06:40.02,0:06:43.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, cara menenunnya\Nmembuatnya terlihat seperti bunga.
Dialogue: 0,0:06:43.65,0:06:45.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa terlihat ketika ada\Ndi bawah sinar matahari.
Dialogue: 0,0:06:46.07,0:06:49.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak selalu keluar.\NPilih saja warna yang aman.
Dialogue: 0,0:06:50.11,0:06:51.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, warna ini sempurna.
Dialogue: 0,0:06:52.12,0:06:53.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namanya Biru Viridian.
Dialogue: 0,0:06:53.95,0:06:55.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Warna hutan yang kau suka.
Dialogue: 0,0:06:56.79,0:06:58.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Warna hutan di permukaan air danau.\N{\i0}
Dialogue: 0,0:06:59.41,0:07:00.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, pilih warna ini!
Dialogue: 0,0:07:00.96,0:07:03.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini ditenun dengan benang sutra dan emas.
Dialogue: 0,0:07:03.54,0:07:06.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlihat sangat indah\Nketika disinari oleh cahaya lampu.
Dialogue: 0,0:07:07.13,0:07:10.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan menunjukkan kecantikannya\Nkepada siapa pun.
Dialogue: 0,0:07:10.59,0:07:11.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimanapun,
Dialogue: 0,0:07:11.72,0:07:15.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku bertanggung jawab\Nuntuk menerangkan produk ini.
Dialogue: 0,0:07:19.89,0:07:23.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekalian mau lipstik dan perona pipi?\NTerlihat sedikit segar.
Dialogue: 0,0:07:23.98,0:07:27.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa memerahkan kulit\Ndengan menampar pipiku.
Dialogue: 0,0:07:27.28,0:07:30.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa membiarkan\Npenyihir kecilku yang lucu
Dialogue: 0,0:07:30.40,0:07:32.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}asyik menampar dirinya sendiri.
Dialogue: 0,0:07:32.61,0:07:36.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kulitmu cerah, jadi warna\Nmerah muda kebiruan akan sempurna.
Dialogue: 0,0:07:36.70,0:07:39.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski membelinya,\Naku tidak menggunakannya.
Dialogue: 0,0:07:39.54,0:07:41.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak perlu membelinya.
Dialogue: 0,0:07:41.33,0:07:43.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau membelikan untuk Rose.
Dialogue: 0,0:07:45.71,0:07:47.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana yang kau pilih?
Dialogue: 0,0:07:47.59,0:07:49.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini dikenal semua orang.
Dialogue: 0,0:07:49.51,0:07:51.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ini mengikuti tren.\N{\i1}- Percuma menghentikannya.\N{\i0}
Dialogue: 0,0:07:51.09,0:07:52.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mari lanjutkan pekerjaan.\N{\i0}
Dialogue: 0,0:08:44.77,0:08:49.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku rasa tiba-tiba mengenakan jubah baru\Nakan terlalu terlihat.\N{\i0}
Dialogue: 0,0:09:09.92,0:09:10.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah!
Dialogue: 0,0:09:19.68,0:09:23.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sepuluh, sembilan, delapan, tujuh.\N{\i0}
Dialogue: 0,0:09:25.39,0:09:28.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Empat, tiga, dua.\N{\i0}
Dialogue: 0,0:09:34.32,0:09:35.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang.
Dialogue: 0,0:09:35.90,0:09:38.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah mendapatkan\Nbarang yang aku minta?
Dialogue: 0,0:09:38.87,0:09:39.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:09:52.96,0:09:54.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan periksa.
Dialogue: 0,0:10:03.89,0:10:05.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:10:05.39,0:10:06.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau lelah?
Dialogue: 0,0:10:06.85,0:10:09.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku punya obat yang bisa\Nmenghilangkan rasa lelahmu.
Dialogue: 0,0:10:10.44,0:10:11.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu.
Dialogue: 0,0:10:12.23,0:10:14.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Raut wajahnya penuh kecurigaan.\N{\i0}
Dialogue: 0,0:10:14.28,0:10:16.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mungkin dia tidak percaya\Npada obat penyihir.\N{\i0}
Dialogue: 0,0:10:19.07,0:10:21.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jadi, kenapa dia mau obat pengasih?\N{\i0}
Dialogue: 0,0:10:21.83,0:10:25.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku sudah memikirkan semua alasan\N{\i0}
Dialogue: 0,0:10:25.41,0:10:27.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}kenapa dia mau obat pengasih.\N{\i0}
Dialogue: 0,0:10:29.75,0:10:32.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Untung saja aku tidak memakai lipstik.\N{\i0}
Dialogue: 0,0:10:43.68,0:10:44.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:10:46.77,0:10:48.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak bisa merapikan sedikit?
Dialogue: 0,0:10:51.56,0:10:52.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayangnya,
Dialogue: 0,0:10:52.81,0:10:55.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak ada sihir yang bisa\Nmembereskan ruangan begitu saja.
Dialogue: 0,0:10:56.61,0:10:58.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau hanya perlu menggunakan dua tangan.
Dialogue: 0,0:10:59.74,0:11:02.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tangan ini, meski bisa menyeduh ramuan,\N{\i0}
Dialogue: 0,0:11:02.82,0:11:04.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}tidak bisa beres-beres.\N{\i0}
Dialogue: 0,0:11:04.37,0:11:05.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Karena aku seorang penyihir.\N{\i0}
Dialogue: 0,0:11:06.37,0:11:07.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Karena aku seorang penyihir.\N{\i0}
Dialogue: 0,0:11:10.33,0:11:11.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini?
Dialogue: 0,0:11:12.00,0:11:12.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:11:13.21,0:11:14.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selada beberapa hari yang lalu.
Dialogue: 0,0:11:17.09,0:11:20.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyihir benar-benar hanya makan selada?
Dialogue: 0,0:11:20.51,0:11:21.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kau menyukainya?
Dialogue: 0,0:11:21.68,0:11:22.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:11:22.72,0:11:25.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya menanam selada di kebunku.
Dialogue: 0,0:11:25.93,0:11:27.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa makan tanpa memasak.
Dialogue: 0,0:11:29.06,0:11:30.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:11:32.02,0:11:33.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:11:33.61,0:11:34.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dua kali dia begitu.\N{\i0}
Dialogue: 0,0:11:35.52,0:11:37.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kau hanya makan selada?
Dialogue: 0,0:11:37.65,0:11:41.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau pergi ke luar kota,\Naku makan makanan lain.
Dialogue: 0,0:11:41.20,0:11:42.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurang lebih begitu.
Dialogue: 0,0:11:59.01,0:12:01.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih banyak daging kaki ayam\Ndaripada dagingmu.
Dialogue: 0,0:12:01.80,0:12:03.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin seburuk itu.
Dialogue: 0,0:12:06.55,0:12:08.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Harij sedang menatapku.\N{\i0}
Dialogue: 0,0:12:08.56,0:12:10.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Wajah tampan dengan alis menyatu.\N{\i0}
Dialogue: 0,0:12:10.81,0:12:14.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku ditatap oleh seorang lelaki tampan\Ndari jarak sedekat ini.\N{\i0}
Dialogue: 0,0:12:17.86,0:12:19.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku minta maaf.
Dialogue: 0,0:12:19.19,0:12:20.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.
Dialogue: 0,0:12:23.66,0:12:26.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menyiapkan obat\Ndengan bahan-bahan ini.
Dialogue: 0,0:12:26.87,0:12:29.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan kembali sebulan lagi.
Dialogue: 0,0:12:30.33,0:12:32.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Butuh lebih banyak waktu, ya?
Dialogue: 0,0:12:46.72,0:12:48.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini hampir musim panas.
Dialogue: 0,0:12:50.02,0:12:51.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku mulai sering mandi\N{\i0}
Dialogue: 0,0:12:51.85,0:12:54.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}meski aku selalu menganggap\Nmandi itu merepotkan.\N{\i0}
Dialogue: 0,0:13:00.19,0:13:02.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti karena sekarang\Ncuacanya makin panas.
Dialogue: 0,0:13:02.40,0:13:04.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak punya niat lain.
Dialogue: 0,0:13:07.07,0:13:09.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebulan lagi?
Dialogue: 0,0:13:09.58,0:13:11.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sebulan adalah waktu\N{\i0}
Dialogue: 0,0:13:11.37,0:13:14.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}yang diperlukan untuk memproses\Nbahan-bahan ini.\N{\i0}
Dialogue: 0,0:13:15.21,0:13:18.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Harij tidak akan datang ke sini\Nsebelum itu.\N{\i0}
Dialogue: 0,0:13:20.59,0:13:24.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pikir aku pintar\Nmenyembunyikan emosiku.
Dialogue: 0,0:13:25.18,0:13:26.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku sudah menyembunyikannya selama ini.\N{\i0}
Dialogue: 0,0:13:27.47,0:13:28.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Karena aku seorang penyihir.\N{\i0}
Dialogue: 0,0:13:29.72,0:13:32.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ada alasan kenapa hanya penyihir\Nyang bisa menghasilkan ramuan\N{\i0}
Dialogue: 0,0:13:32.81,0:13:35.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dengan kekuatan\Nyang tidak bisa ditiru oleh manusia.\N{\i0}
Dialogue: 0,0:13:36.23,0:13:38.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Seorang penyihir\Nyang menggunakan trik sihir\N{\i0}
Dialogue: 0,0:13:38.65,0:13:40.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}tidak boleh menggunakan trik lain.\N{\i0}
Dialogue: 0,0:13:41.52,0:13:43.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sikap kami yang dingin dan menyebalkan...\N{\i0}
Dialogue: 0,0:13:44.44,0:13:47.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}adalah untuk menyembunyikan fakta\Nkami tidak bisa berbohong.\N{\i0}
Dialogue: 0,0:13:47.70,0:13:50.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ini semua tentang menjaga jarak\Ndengan orang lain.\N{\i0}
Dialogue: 0,0:13:51.83,0:13:53.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Meski tidak bisa berbohong,\N{\i0}
Dialogue: 0,0:13:53.70,0:13:57.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}kami bisa menyembunyikan kebenaran\Natau mengubah topik.\N{\i0}
Dialogue: 0,0:13:57.75,0:14:00.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Begitulah caraku berhasil bertahan hidup\Nsendirian sampai sekarang.\N{\i0}
Dialogue: 0,0:14:01.84,0:14:03.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Juga setelah ini.
Dialogue: 0,0:14:03.25,0:14:06.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan terus hidup sendirian.
Dialogue: 0,0:14:15.06,0:14:18.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus! Cuaca hari ini bagus.\NPakaian dalam juga perlu dicuci.
Dialogue: 0,0:14:37.29,0:14:38.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rusa?
Dialogue: 0,0:14:38.67,0:14:40.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rusa sombong itu lagi?
Dialogue: 0,0:14:54.64,0:14:55.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku minta maaf!
Dialogue: 0,0:15:06.32,0:15:08.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apakah dia melihatku? Dia melihat.\N{\i0}
Dialogue: 0,0:15:08.99,0:15:10.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Di antara banyak orang,\N{\i0}
Dialogue: 0,0:15:10.78,0:15:13.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}bagaimana malah Harij yang melihat\N{\i0}
Dialogue: 0,0:15:13.66,0:15:16.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}kulitku yang pucat tanpa memakai korset?\N{\i0}
Dialogue: 0,0:15:16.37,0:15:17.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kenapa dia ada di sini?\N{\i0}
Dialogue: 0,0:15:18.04,0:15:21.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Belum genap sebulan,\Nsekarang pun hari masih siang.\N{\i0}
Dialogue: 0,0:15:24.13,0:15:26.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama, kenakan jubah.
Dialogue: 0,0:15:39.81,0:15:41.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf membuatmu menunggu.
Dialogue: 0,0:15:41.39,0:15:42.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan datang.
Dialogue: 0,0:15:51.49,0:15:53.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benar-benar minta maaf\Nmengenai hal tadi.
Dialogue: 0,0:15:53.99,0:15:56.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan masalah. Aku juga minta maaf.
Dialogue: 0,0:15:56.24,0:15:59.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mengira Tuan Harij ada di sini.
Dialogue: 0,0:16:01.29,0:16:03.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tahu siapa aku?
Dialogue: 0,0:16:05.13,0:16:06.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Habislah.\N{\i0}
Dialogue: 0,0:16:06.38,0:16:08.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia tidak pernah memberitahuku namanya.\N{\i0}
Dialogue: 0,0:16:10.92,0:16:12.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tahu rupanya.
Dialogue: 0,0:16:13.22,0:16:15.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, benar.
Dialogue: 0,0:16:15.76,0:16:16.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak kapan?
Dialogue: 0,0:16:18.31,0:16:20.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku tidak bisa memikirkan cara yang pas\Nuntuk menghindar.\N{\i0}
Dialogue: 0,0:16:21.48,0:16:22.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong jawab.
Dialogue: 0,0:16:24.19,0:16:25.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Empat tahun lalu.
Dialogue: 0,0:16:25.61,0:16:26.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seawal itu?
Dialogue: 0,0:16:30.53,0:16:32.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku.
Dialogue: 0,0:16:32.74,0:16:35.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan mengungkapkan\Ninformasi Tuan kepada siapa pun.
Dialogue: 0,0:16:35.99,0:16:39.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berada dalam situasi\Nyang sangat tidak biasa sekarang.
Dialogue: 0,0:16:39.29,0:16:40.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menjadi gila.
Dialogue: 0,0:16:41.00,0:16:42.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kau mengajukan pertanyaan lagi...
Dialogue: 0,0:16:44.58,0:16:47.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aduh, aku sesak napas, pusing.\N{\i0}
Dialogue: 0,0:16:48.80,0:16:49.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya?
Dialogue: 0,0:16:51.26,0:16:52.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Harij sedang menatapku.\N{\i0}
Dialogue: 0,0:16:53.43,0:16:54.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku dilihat.\N{\i0}
Dialogue: 0,0:16:55.97,0:16:57.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyihir...
Dialogue: 0,0:16:57.47,0:17:01.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyihir tidak bisa berbohong\Nkarena efek penggunaan sihir!
Dialogue: 0,0:17:02.39,0:17:04.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa berbohong?
Dialogue: 0,0:17:04.60,0:17:05.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ini sudah berakhir.\N{\i0}
Dialogue: 0,0:17:06.06,0:17:08.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Akhirnya, aku memberitahunya\N{\i0}
Dialogue: 0,0:17:08.11,0:17:10.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}rahasia penyihir\Nyang seharusnya menjadi rahasia.\N{\i0}
Dialogue: 0,0:17:11.23,0:17:12.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya?
Dialogue: 0,0:17:12.57,0:17:14.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong. Aku minta maaf.
Dialogue: 0,0:17:14.99,0:17:16.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bertanya lagi.
Dialogue: 0,0:17:18.70,0:17:19.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:17:19.70,0:17:22.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku paham penyihir juga punya\Nmasalah sendiri.
Dialogue: 0,0:17:22.75,0:17:26.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, sebagai seorang kesatria,\Naku harus menanyakan ini.
Dialogue: 0,0:17:26.71,0:17:28.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kalau dia terus bertanya tentangku\Nseperti ini,\N{\i0}
Dialogue: 0,0:17:29.00,0:17:31.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}aku mungkin akan memberi tahu\Nsemuanya kepada Harij.\N{\i0}
Dialogue: 0,0:17:31.88,0:17:35.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cerita tentang kau mengenaliku\Nsejak empat tahun terakhir.
Dialogue: 0,0:17:35.55,0:17:39.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sepertinya dia menemukan kelemahanku.\N{\i0}
Dialogue: 0,0:17:39.97,0:17:43.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun, bagaimana kalau dia tahu\Ntentang perasaanku?\N{\i0}
Dialogue: 0,0:17:44.43,0:17:47.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kalau dia tahu wanita bodoh,\Nlemah, dan malang\N{\i0}
Dialogue: 0,0:17:47.40,0:17:51.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}seperti aku ini sudah jatuh cinta\Npada lelaki tampan, kuat, dan mulia.\N{\i0}
Dialogue: 0,0:17:52.69,0:17:54.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku lebih baik mati.
Dialogue: 0,0:17:55.95,0:17:56.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei!
Dialogue: 0,0:17:58.49,0:18:01.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku lupa karena hal ini sangat jelas.\N{\i0}
Dialogue: 0,0:18:01.95,0:18:04.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Obat seperti itu memang keahlianku.\N{\i0}
Dialogue: 0,0:18:06.67,0:18:08.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Karena aku seorang penyihir.\N{\i0}
Dialogue: 0,0:18:10.34,0:18:11.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang sedang kau buat?
Dialogue: 0,0:18:19.30,0:18:21.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bukan perempuan murahan. Aku penyihir.
Dialogue: 0,0:18:21.93,0:18:25.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagian besar uang\Ndihabiskan untuk bahan ramuan,
Dialogue: 0,0:18:25.52,0:18:27.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan aku tidak keberatan\Nkalau tidak ada pakaian baru.
Dialogue: 0,0:18:27.81,0:18:30.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah. Tunggu sebentar. Maaf.
Dialogue: 0,0:18:30.15,0:18:31.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang.
Dialogue: 0,0:18:31.52,0:18:34.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, aku tahu kau terkejut.
Dialogue: 0,0:18:49.33,0:18:50.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:18:54.38,0:18:55.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:18:55.84,0:19:00.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku minta maaf karena sudah membuka\Nrahasia sampai kau mau bunuh diri.
Dialogue: 0,0:19:00.80,0:19:04.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu aku akan merahasiakan\Napa yang terjadi tadi.
Dialogue: 0,0:19:04.68,0:19:06.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan memberi tahu siapa pun.
Dialogue: 0,0:19:06.73,0:19:09.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini adalah sumpah seorang kesatria.\NTolong percayalah.
Dialogue: 0,0:19:12.69,0:19:14.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau sangka itu racun?
Dialogue: 0,0:19:15.03,0:19:17.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena aku tidak tahu jenis obatnya.
Dialogue: 0,0:19:17.53,0:19:19.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku melihat sorot matamu.
Dialogue: 0,0:19:19.82,0:19:23.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biasanya orang yang putus asa\Nmemiliki raut wajah sepertimu.
Dialogue: 0,0:19:24.24,0:19:26.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untungnya aku sempat.
Dialogue: 0,0:19:27.20,0:19:29.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Benar juga.\N{\i0}
Dialogue: 0,0:19:29.58,0:19:31.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Harij memang orangnya begini.\N{\i0}
Dialogue: 0,0:19:32.42,0:19:36.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia baik dan perhatian\Nmeski nyawa penyihir dipertaruhkan.\N{\i0}
Dialogue: 0,0:19:42.09,0:19:43.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah kau sudah merasa tenang?
Dialogue: 0,0:19:45.31,0:19:46.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, bagus.
Dialogue: 0,0:19:46.85,0:19:49.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hampir terpaksa\Nmemakan semuanya sendirian.
Dialogue: 0,0:19:53.15,0:19:54.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Roti?
Dialogue: 0,0:19:54.36,0:19:58.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mungkin tidak pernah makan\Nmakanan lezat. Kau hanya makan selada.
Dialogue: 0,0:19:58.82,0:20:03.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimanapun, kau tetap gadis muda.
Dialogue: 0,0:20:03.32,0:20:05.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kau harus makan lebih banyak.
Dialogue: 0,0:20:05.62,0:20:07.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia mengkhawatirkanku.\N{\i0}
Dialogue: 0,0:20:07.79,0:20:10.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia memikirkanku meski untuk sesaat.\N{\i0}
Dialogue: 0,0:20:12.46,0:20:14.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ini membuatku bahagia.\N{\i0}
Dialogue: 0,0:20:15.25,0:20:16.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelihatannya enak.
Dialogue: 0,0:20:16.71,0:20:18.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Terima kasih.\N- Tunggu sebentar.
Dialogue: 0,0:20:18.76,0:20:20.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau makan di sana?
Dialogue: 0,0:20:20.88,0:20:22.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Kenapa?
Dialogue: 0,0:20:22.63,0:20:25.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama, rapikan dulu meja ini.
Dialogue: 0,0:20:30.06,0:20:31.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beginilah kalau menjadi bangsawan.
Dialogue: 0,0:20:32.02,0:20:33.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa mendengar.
Dialogue: 0,0:20:33.23,0:20:34.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memang mau kau mendengarnya.
Dialogue: 0,0:20:45.91,0:20:47.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Cerewet.\N{\i0}
Dialogue: 0,0:20:47.24,0:20:48.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia seperti ibu-ibu yang cerewet.\N{\i0}
Dialogue: 0,0:20:50.45,0:20:51.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.
Dialogue: 0,0:20:52.16,0:20:53.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untunglah.
Dialogue: 0,0:20:57.54,0:20:59.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa? Apakah wajahku kotor lagi?\N{\i0}
Dialogue: 0,0:21:00.05,0:21:01.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Wajahku?\N{\i0}
Dialogue: 0,0:21:01.42,0:21:03.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mau bagaimana lagi?\NTerima saja apa adanya.\N{\i0}
Dialogue: 0,0:21:03.80,0:21:04.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mau duduk?
Dialogue: 0,0:21:05.09,0:21:06.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:21:17.65,0:21:19.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ini bukan mimpi.\N{\i0}
Dialogue: 0,0:21:19.65,0:21:22.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Harij benar-benar ada di depanku.\N{\i0}
Dialogue: 0,0:21:22.65,0:21:25.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku tidak menyangka hari ini akan tiba.\N{\i0}
Dialogue: 0,0:21:29.03,0:21:29.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:21:30.70,0:21:33.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada apa-apa.\NHanya terlihat sedikit aneh.
Dialogue: 0,0:21:33.75,0:21:35.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah itu mentega?
Dialogue: 0,0:21:35.46,0:21:38.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang bilang ini mentega apel,\Nenak dioleskan dengan roti.
Dialogue: 0,0:21:40.46,0:21:42.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku suka apel, jadi aku senang.
Dialogue: 0,0:21:42.63,0:21:43.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Silakan.
Dialogue: 0,0:21:44.55,0:21:45.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:21:51.35,0:21:53.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ada bau apel yang manis.\N{\i0}
Dialogue: 0,0:23:37.95,0:23:39.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Terjemahan subtitle oleh Haseenah Musa
