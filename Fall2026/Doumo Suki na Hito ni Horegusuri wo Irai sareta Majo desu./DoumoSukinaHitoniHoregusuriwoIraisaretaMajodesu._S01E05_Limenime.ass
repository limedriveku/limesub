Dialogue: 0,0:03:11.98,0:03:15.98,sign,,0000,0000,0000,,{\an8}EPISODE 5: MENJADI SEORANG PENYIHIR
Dialogue: 0,0:00:02.79,0:00:06.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Aku tidak bisa pergi ke pesta dansa\Nseperti ini." Teriak gadis itu.
Dialogue: 0,0:00:06.75,0:00:09.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, penyihir itu melambaikan tongkatnya.
Dialogue: 0,0:00:09.96,0:00:11.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah itu,
Dialogue: 0,0:00:11.67,0:00:13.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}labu itu menjadi kereta kuda,
Dialogue: 0,0:00:13.43,0:00:15.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan pakaian lusuhnya menjadi gaun.
Dialogue: 0,0:00:16.39,0:00:19.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyihir itu kemudian\Nmembuat sepatu kaca...
Dialogue: 0,0:00:19.14,0:00:21.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyihir itu agak aneh.
Dialogue: 0,0:00:21.18,0:00:22.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aneh?
Dialogue: 0,0:00:22.48,0:00:26.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa dia memberikan gaun\Ndan kereta kuda tanpa meminta imbalan?
Dialogue: 0,0:00:28.36,0:00:29.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa menurutmu demikian?
Dialogue: 0,0:00:30.19,0:00:31.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rose pikir kenapa?
Dialogue: 0,0:00:32.65,0:00:34.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia harus membayarnya nanti?
Dialogue: 0,0:00:34.53,0:00:37.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau genius! Hebat! Lucunya!
Dialogue: 0,0:00:37.57,0:00:40.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah cukup. Jawab saja dengan benar.
Dialogue: 0,0:00:42.37,0:00:45.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin karena dia gadis\Nyang baik dan sangat disukai.
Dialogue: 0,0:00:46.50,0:00:47.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula,
Dialogue: 0,0:00:48.75,0:00:50.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin dia penyihir yang baik.
Dialogue: 0,0:00:51.00,0:00:52.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyihir yang baik?
Dialogue: 0,0:00:54.67,0:00:56.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Di mana ada penyihir baik atau jahat?
Dialogue: 0,0:00:56.72,0:01:00.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Penyihir itu hanya menyetujui permintaan\Ndengan imbalan.
Dialogue: 0,0:01:00.64,0:01:02.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Mereka melakukan pertukaran yang adil.
Dialogue: 0,0:01:04.23,0:01:05.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:01:06.35,0:01:07.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhenti!
Dialogue: 0,0:01:07.94,0:01:10.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak punya cerita penyihir\Nyang lebih baik?
Dialogue: 0,0:01:10.48,0:01:14.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelanggan kecil suka membuat\Npermintaan yang sulit.
Dialogue: 0,0:01:15.11,0:01:19.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tugas Tien adalah memenuhi\Npermintaan sulit itu, 'kan?
Dialogue: 0,0:01:19.24,0:01:20.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,
Dialogue: 0,0:01:20.37,0:01:23.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}biar aku menceritakan kisah penyihir\Nyang tinggal di tepi danau.
Dialogue: 0,0:01:24.41,0:01:26.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyihir ini terkadang membantu orang,
Dialogue: 0,0:01:27.04,0:01:29.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}terkadang membimbing orang,
Dialogue: 0,0:01:29.25,0:01:31.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan terkadang memenuhi keinginan orang.
Dialogue: 0,0:01:31.54,0:01:33.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyihir itu tidak aneh.
Dialogue: 0,0:01:34.01,0:01:35.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Penyihir manisku.\N{\i0}
Dialogue: 0,0:01:36.42,0:01:39.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kau akan menjadi seorang penyihir\Nyang seperti apa?\N{\i0}
Dialogue: 0,0:03:21.99,0:03:24.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau benar-benar sudah seperti penyihir.
Dialogue: 0,0:03:25.08,0:03:27.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudmu ketika mengatakan itu?
Dialogue: 0,0:03:27.33,0:03:28.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:03:28.29,0:03:31.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku rasa aku memujimu dengan caraku.
Dialogue: 0,0:03:32.00,0:03:34.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tampak sangat sibuk akhir-akhir ini.
Dialogue: 0,0:03:34.88,0:03:36.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak terlalu.
Dialogue: 0,0:03:36.50,0:03:39.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pekerjaan yang sudah lama aku usahakan\Nhampir siap.
Dialogue: 0,0:03:40.34,0:03:43.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Aku senang mendengarnya.
Dialogue: 0,0:03:57.65,0:03:59.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini tehmu.
Dialogue: 0,0:03:59.69,0:04:01.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:04:01.15,0:04:03.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Warna dan aromanya luar biasa.
Dialogue: 0,0:04:05.03,0:04:08.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mencoba menambahkan susu,\Nmengganti daun teh dan rempah.
Dialogue: 0,0:04:08.74,0:04:09.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:04:09.95,0:04:12.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rose yang tidak tertarik dengan makanan\Nbersedia melakukan itu?
Dialogue: 0,0:04:19.80,0:04:21.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Suhunya sesuai.
Dialogue: 0,0:04:21.80,0:04:25.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersyukur bisa mendapat minuman hangat\Npada hari yang dingin, 'kan?
Dialogue: 0,0:04:26.01,0:04:28.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan berkomentar tentang suhu saja.\NBagaimana rasanya?
Dialogue: 0,0:04:31.06,0:04:32.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja enak.
Dialogue: 0,0:04:32.98,0:04:35.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhir-akhir ini, cuaca sangat dingin.
Dialogue: 0,0:04:35.90,0:04:37.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cukup berbicara tentang suhu.
Dialogue: 0,0:04:38.11,0:04:41.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, diskusi tentang suhu ini penting.
Dialogue: 0,0:04:41.11,0:04:42.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Musim dingin akan segera tiba.
Dialogue: 0,0:04:42.99,0:04:47.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini musim warga lansia\Nmengeluh nyeri punggung dan bahu.
Dialogue: 0,0:04:47.87,0:04:50.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sebabnya aku mau membeli\Nbanyak kompres pereda nyeri.
Dialogue: 0,0:04:51.62,0:04:56.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga mau insektisida\Nuntuk persediaan sayuran musim dingin.
Dialogue: 0,0:04:56.71,0:04:58.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, obat mabuk dan lain-lain.
Dialogue: 0,0:05:00.96,0:05:03.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu aku meminta terlalu banyak.
Dialogue: 0,0:05:04.05,0:05:06.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau memesan sebanyak ini. Boleh?
Dialogue: 0,0:05:09.80,0:05:12.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku keluar untuk membeli kebutuhan,\Naku bisa melakukannya
Dialogue: 0,0:05:12.60,0:05:15.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, tapi jumlah ini terlalu banyak.
Dialogue: 0,0:05:19.11,0:05:20.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada cara lain.
Dialogue: 0,0:05:20.82,0:05:22.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menyediakannya kali ini.
Dialogue: 0,0:05:23.03,0:05:25.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena aku penyihir danau terbaik.
Dialogue: 0,0:05:25.78,0:05:28.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyihir danau terbaik?
Dialogue: 0,0:05:28.99,0:05:30.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyihir terbaik.
Dialogue: 0,0:05:34.62,0:05:36.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Pengaruhnya sangat besar.
Dialogue: 0,0:05:41.80,0:05:43.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kau sudah dewasa.
Dialogue: 0,0:05:44.63,0:05:46.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Apa sebenarnya yang dia bicarakan?
Dialogue: 0,0:05:48.47,0:05:50.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku senang karena kau sudah dewasa.\N{\i0}
Dialogue: 0,0:05:50.97,0:05:52.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun, entah kenapa.\N{\i0}
Dialogue: 0,0:05:52.60,0:05:55.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ketika aku melihatmu dulu\Nmampu berdiri sendiri...\N{\i0}
Dialogue: 0,0:05:57.39,0:06:00.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini rupanya perasaan seorang ayah, ya.
Dialogue: 0,0:06:01.40,0:06:03.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tien, sejak kapan kau punya anak?
Dialogue: 0,0:06:03.65,0:06:05.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar. Entah kapan, ya?
Dialogue: 0,0:06:05.78,0:06:07.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tahu-tahu anakku sebesar ini.
Dialogue: 0,0:06:07.78,0:06:09.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bukan anakmu!
Dialogue: 0,0:06:09.45,0:06:11.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sungguh menyentuh.
Dialogue: 0,0:06:11.62,0:06:15.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rose sudah mulai membuatkan teh untukku.
Dialogue: 0,0:06:16.12,0:06:17.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu,
Dialogue: 0,0:06:18.08,0:06:20.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rose sudah mulai menggunakan taplak meja.
Dialogue: 0,0:06:20.67,0:06:22.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rose memang sudah dewasa.
Dialogue: 0,0:06:22.88,0:06:23.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berlebihan sekali.
Dialogue: 0,0:06:24.09,0:06:26.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau menggunakan kain ini\Npada hari itu juga.
Dialogue: 0,0:06:27.05,0:06:29.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kain favorit?\N- Bukan favorit.
Dialogue: 0,0:06:32.01,0:06:34.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jadi, kain favorit orang lain itu?\N{\i0}
Dialogue: 0,0:06:36.35,0:06:38.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:06:38.10,0:06:40.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katun berkualitas tinggi\Ndan jahitan yang elegan.
Dialogue: 0,0:06:40.69,0:06:42.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang kain alas yang bagus.
Dialogue: 0,0:06:42.61,0:06:44.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:06:44.48,0:06:45.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak tahu.
Dialogue: 0,0:06:46.03,0:06:48.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisakah aku meminjamnya sebentar?
Dialogue: 0,0:06:48.11,0:06:49.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa.
Dialogue: 0,0:06:49.45,0:06:51.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu bukan milikku.
Dialogue: 0,0:06:55.54,0:06:57.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya? Sayang sekali.
Dialogue: 0,0:06:57.62,0:06:59.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tadinya mau membuat referensi.
Dialogue: 0,0:07:00.04,0:07:00.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.
Dialogue: 0,0:07:01.00,0:07:03.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu apa yang kau suka,\Njadi tidak ada masalah.
Dialogue: 0,0:07:03.71,0:07:06.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tinggal peti dan peralatan makan\Nyang serasi.
Dialogue: 0,0:07:06.76,0:07:08.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada meja rias juga bagus.
Dialogue: 0,0:07:09.34,0:07:11.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berapa banyak keledai yang aku butuhkan?
Dialogue: 0,0:07:11.63,0:07:13.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kau bicarakan?
Dialogue: 0,0:07:13.64,0:07:16.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.\NItu sesuatu yang harus kau nantikan.
Dialogue: 0,0:07:17.18,0:07:18.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akan sibuk.
Dialogue: 0,0:07:31.70,0:07:32.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyaknya.
Dialogue: 0,0:07:33.28,0:07:34.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak sekali pekerjaanku.
Dialogue: 0,0:07:36.03,0:07:39.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kompres, insektisida, obat mabuk,
Dialogue: 0,0:07:40.21,0:07:42.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan obat pengasih.
Dialogue: 0,0:07:50.97,0:07:53.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Setelah obatnya siap,\Naku perlu mengembalikan kain ini.
Dialogue: 0,0:07:57.72,0:07:59.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kalau obatnya siap,\N{\i0}
Dialogue: 0,0:08:00.27,0:08:01.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}dia sudah...\N{\i0}
Dialogue: 0,0:08:04.65,0:08:06.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ayo, berbelanja.\N{\i0}
Dialogue: 0,0:08:44.69,0:08:45.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang.
Dialogue: 0,0:08:49.69,0:08:51.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau herba dan ramuan obat.
Dialogue: 0,0:08:51.86,0:08:53.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah. Seperti biasa, ya.
Dialogue: 0,0:08:53.95,0:08:54.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:08:55.82,0:08:57.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau dua kali lipat.
Dialogue: 0,0:08:57.87,0:08:59.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dua kali lipat? Dari biasanya?
Dialogue: 0,0:09:00.20,0:09:02.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku minta maaf.
Dialogue: 0,0:09:02.12,0:09:03.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami akan kehabisan stok.
Dialogue: 0,0:09:04.04,0:09:06.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku beli seperti biasa.
Dialogue: 0,0:09:09.25,0:09:11.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, kau juga pelanggan tetapku.
Dialogue: 0,0:09:12.17,0:09:13.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu sebentar, ya.
Dialogue: 0,0:09:14.22,0:09:17.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei! Kapan pengiriman berikutnya?
Dialogue: 0,0:09:23.27,0:09:24.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik. Maaf membuatmu menunggu.
Dialogue: 0,0:09:25.52,0:09:28.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak cukup kalau dua kali lipat,\Nhanya ini yang kami punya.
Dialogue: 0,0:09:29.98,0:09:31.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:09:32.03,0:09:34.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menyimpan sisanya untuk nanti.
Dialogue: 0,0:09:34.74,0:09:35.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Datang lagi, ya!
Dialogue: 0,0:09:45.54,0:09:47.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih\Nkarena selalu membeli di sini.
Dialogue: 0,0:09:47.46,0:09:49.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini kembaliannya.
Dialogue: 0,0:09:49.13,0:09:49.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu.
Dialogue: 0,0:09:52.05,0:09:53.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dukung terus kami, ya!
Dialogue: 0,0:09:54.17,0:09:56.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, aku akan mampir lagi.
Dialogue: 0,0:09:56.80,0:09:58.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat!
Dialogue: 0,0:09:58.09,0:10:00.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akan kehilangan dia! Cepat!
Dialogue: 0,0:10:00.30,0:10:02.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, serang ketika dia kembali!
Dialogue: 0,0:10:02.26,0:10:04.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia akan tahu kalau kau berisik.
Dialogue: 0,0:10:35.38,0:10:36.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Penyihir!
Dialogue: 0,0:10:44.06,0:10:47.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat, benar apa kataku.\NAku sudah memata-matainya.
Dialogue: 0,0:10:47.73,0:10:48.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:10:48.69,0:10:50.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia datang dari dalam hutan.
Dialogue: 0,0:10:52.44,0:10:57.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei! Penyihir! Kami sama sekali\Ntidak takut kepadamu!
Dialogue: 0,0:10:59.82,0:11:01.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Rasakan ini!\N- Jangan biarkan dia lari!
Dialogue: 0,0:11:01.57,0:11:04.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jatuhkan dia! Jatuhkan ke danau!
Dialogue: 0,0:11:04.49,0:11:05.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ramuanku!\N{\i0}
Dialogue: 0,0:11:06.62,0:11:08.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lempar lagi! Lempar yang banyak!
Dialogue: 0,0:11:08.79,0:11:10.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalahkan penyihir itu!
Dialogue: 0,0:11:12.88,0:11:13.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasakan ini!
Dialogue: 0,0:11:17.92,0:11:19.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sakit!
Dialogue: 0,0:11:20.01,0:11:20.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kau sudah kalah?
Dialogue: 0,0:11:21.05,0:11:22.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Berhasil!
Dialogue: 0,0:11:22.18,0:11:24.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takut juga kau, ternyata sepadan!
Dialogue: 0,0:12:00.05,0:12:01.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona penyihir?
Dialogue: 0,0:12:08.60,0:12:09.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang sudah terjadi?
Dialogue: 0,0:12:10.35,0:12:11.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah kau baik-baik saja?
Dialogue: 0,0:12:11.64,0:12:13.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Aku baik-baik saja.
Dialogue: 0,0:12:25.41,0:12:27.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:12:32.54,0:12:33.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak-anak itu, 'kan?
Dialogue: 0,0:12:39.96,0:12:43.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Aku tak mau, turunkan aku!\N- Aku minta maaf!
Dialogue: 0,0:12:46.05,0:12:48.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lepaskan... Lepaskan kami.
Dialogue: 0,0:12:48.35,0:12:50.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Paman! Aku bilang lepaskan kami!
Dialogue: 0,0:12:51.02,0:12:52.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini saja?
Dialogue: 0,0:12:52.10,0:12:54.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak memperhatikan.
Dialogue: 0,0:12:54.35,0:12:57.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, orang yang mencurigakan!\NPengecut! Lepaskan aku!
Dialogue: 0,0:12:58.52,0:13:01.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menurunkan kalian\Nkalau kalian minta maaf.
Dialogue: 0,0:13:01.19,0:13:04.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mau! Aku tidak peduli, turunkan aku!
Dialogue: 0,0:13:04.20,0:13:06.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke sini! Ayo, cepat!
Dialogue: 0,0:13:09.66,0:13:12.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat di sana! Mereka semua ditangkap!
Dialogue: 0,0:13:12.12,0:13:13.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bantu mereka!
Dialogue: 0,0:13:17.83,0:13:19.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:13:20.09,0:13:22.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dengar ada penculik di sekitar sini.
Dialogue: 0,0:13:23.21,0:13:26.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak-anak ini melempar lumpur\Nke wanita ini
Dialogue: 0,0:13:26.34,0:13:27.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tanpa dia mampu melawan.
Dialogue: 0,0:13:31.56,0:13:32.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku minta maaf.
Dialogue: 0,0:13:33.22,0:13:35.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku, Nona.
Dialogue: 0,0:13:35.31,0:13:36.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak terluka?
Dialogue: 0,0:13:36.52,0:13:39.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami benar-benar minta maaf.\NPakaianmu kotor.
Dialogue: 0,0:13:39.73,0:13:41.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kau tidak keberatan, ambillah ini.
Dialogue: 0,0:13:41.48,0:13:42.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.
Dialogue: 0,0:13:42.69,0:13:44.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sepertinya ini menjadi serius.\N{\i0}
Dialogue: 0,0:13:47.78,0:13:50.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mencoba membujuk mereka\Nmenebus kesalahan dengan benar.
Dialogue: 0,0:13:50.95,0:13:53.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, seperti yang kalian lihat,\Nmereka tidak mau.
Dialogue: 0,0:13:53.79,0:13:55.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku menggunakan kekerasan.
Dialogue: 0,0:13:55.79,0:13:58.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kalian lakukan?
Dialogue: 0,0:13:58.21,0:14:00.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa melempar lumpur ke wanita?
Dialogue: 0,0:14:00.38,0:14:02.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, dia...
Dialogue: 0,0:14:03.63,0:14:04.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}penyihir!
Dialogue: 0,0:14:06.38,0:14:09.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong kosong apa\Nyang dikatakan anak kecil ini?
Dialogue: 0,0:14:09.72,0:14:12.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku, Nona.\NDia menyebutmu penyihir.
Dialogue: 0,0:14:19.06,0:14:21.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar. Kami semua melihat.
Dialogue: 0,0:14:21.23,0:14:23.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyihir itu meninggalkan rumah itu.
Dialogue: 0,0:14:23.57,0:14:25.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami telah memata-matainya dari dulu.
Dialogue: 0,0:14:25.53,0:14:28.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mau melakukan hal buruk\Nketika pergi ke kota.
Dialogue: 0,0:14:28.86,0:14:30.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia menculik anak-anak.
Dialogue: 0,0:14:30.28,0:14:32.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebelum itu, kami harus mengalahkannya.
Dialogue: 0,0:14:32.28,0:14:34.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian semua diam!
Dialogue: 0,0:14:34.54,0:14:35.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona.
Dialogue: 0,0:14:35.58,0:14:39.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah kau benar-benar seorang penyihir?
Dialogue: 0,0:14:44.75,0:14:45.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:14:48.88,0:14:50.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan kami.
Dialogue: 0,0:14:51.30,0:14:53.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong maafkan kami.
Dialogue: 0,0:14:53.35,0:14:55.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong maafkan kami.
Dialogue: 0,0:14:55.93,0:15:00.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak-anak ini masih kecil\Ndan tidak tahu bahwa kau penyihir hebat.
Dialogue: 0,0:15:00.60,0:15:04.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa yang ada di pikiran mereka\Ntentang pekerjaan penyihir?\N{\i0}
Dialogue: 0,0:15:06.28,0:15:08.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tidak ada yang berubah\Nsejak empat tahun terakhir.\N{\i0}
Dialogue: 0,0:15:09.36,0:15:11.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Penyihir hanyalah penyihir.\N{\i0}
Dialogue: 0,0:15:12.24,0:15:14.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan kami.
Dialogue: 0,0:15:14.33,0:15:16.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyihir terhebat di danau.
Dialogue: 0,0:15:17.41,0:15:19.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bukan penyihir hebat.
Dialogue: 0,0:15:20.00,0:15:23.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan mencoba menutupi\Nkesalahan mereka dengan memujinya.
Dialogue: 0,0:15:24.79,0:15:26.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada urusannya\Ndia penyihir atau orang hebat.
Dialogue: 0,0:15:27.01,0:15:29.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana boleh melempar lumpur ke orang lain.
Dialogue: 0,0:15:29.76,0:15:31.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, dia seorang penyihir!
Dialogue: 0,0:15:31.51,0:15:33.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia menyebabkan masalah bagi orang lain!
Dialogue: 0,0:15:33.30,0:15:36.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kami harap dia segera keluar dari sini!\N- Berhenti!
Dialogue: 0,0:15:36.18,0:15:38.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang penyihir ini\Nsudah lakukan kepada kalian?
Dialogue: 0,0:15:40.19,0:15:42.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Dia belum melakukan apa pun.
Dialogue: 0,0:15:42.65,0:15:44.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, bagaimana dia\Nbisa mengganggu kalian?
Dialogue: 0,0:15:51.20,0:15:52.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manusia memang lemah.
Dialogue: 0,0:15:52.74,0:15:54.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka takut pada hal-hal\Nyang tidak diketahui.
Dialogue: 0,0:15:58.50,0:16:00.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bolehkah aku memberi tahu mereka?
Dialogue: 0,0:16:01.71,0:16:03.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentang obat yang dibuat oleh penyihir.
Dialogue: 0,0:16:04.46,0:16:06.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah itu akan menjadi masalah bagimu?
Dialogue: 0,0:16:08.88,0:16:10.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:16:14.39,0:16:15.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah Tuan menanam tanaman?
Dialogue: 0,0:16:16.51,0:16:18.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, gandum dan sayuran.
Dialogue: 0,0:16:19.06,0:16:22.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, terkadang\Nkau menggunakan insektisida?
Dialogue: 0,0:16:22.31,0:16:24.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Tentu saja.
Dialogue: 0,0:16:24.52,0:16:27.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketika sakit punggung,\NTuan menggunakan kompres?
Dialogue: 0,0:16:27.48,0:16:29.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Ada juga.
Dialogue: 0,0:16:30.24,0:16:32.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyihir juga membuat\Nobat-obatan tersebut.
Dialogue: 0,0:16:35.49,0:16:38.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bilang penyihirlah\Nyang membuat semuanya.
Dialogue: 0,0:16:38.74,0:16:41.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, ada orang yang mendapatkan\Nmanfaat dari obat tersebut.
Dialogue: 0,0:16:41.45,0:16:43.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian mungkin takut\Nkarena kalian tidak tahu.
Dialogue: 0,0:16:44.00,0:16:47.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, mengarahkan rasa takut\Nkepada orang yang tidak bersalah
Dialogue: 0,0:16:47.88,0:16:49.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah tindakan yang sangat buruk.
Dialogue: 0,0:16:50.13,0:16:52.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, minta maaf sekarang.
Dialogue: 0,0:16:54.18,0:16:56.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kami minta maaf.\N- Kami minta maaf.
Dialogue: 0,0:16:58.72,0:17:00.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, tidak ada cara lain.
Dialogue: 0,0:17:02.18,0:17:05.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan membuatmu\Nmenyesalinya di danau yang dingin ini.
Dialogue: 0,0:17:05.60,0:17:08.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhenti main-main! Berhenti! Lepaskan!
Dialogue: 0,0:17:08.31,0:17:12.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudahlah, dia sudah mengerti.\NAku baik-baik saja.
Dialogue: 0,0:17:12.44,0:17:13.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, belum.
Dialogue: 0,0:17:15.74,0:17:17.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku minta maaf!
Dialogue: 0,0:17:18.28,0:17:20.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan pernah melakukannya lagi.
Dialogue: 0,0:17:20.45,0:17:22.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti penyihir itu marah.
Dialogue: 0,0:17:23.91,0:17:27.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan paksa dia menanggung beban\Nkarena kau tidak bisa mengajar anak-anak.
Dialogue: 0,0:17:29.54,0:17:32.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak perlu menjadi penyihir\Nuntuk menghukum orang.
Dialogue: 0,0:17:33.42,0:17:35.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu karena kalian\Nadalah orang dewasa yang waras.
Dialogue: 0,0:17:36.76,0:17:37.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengerti?
Dialogue: 0,0:17:37.97,0:17:41.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian harus memiliki kemampuan\Nuntuk melihat dengan mata kepala sendiri.
Dialogue: 0,0:17:47.90,0:17:49.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian semua juga lihat dengan benar.
Dialogue: 0,0:17:49.81,0:17:53.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang telah kalian lakukan\Ndan kepada siapa.
Dialogue: 0,0:18:04.79,0:18:07.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku minta maaf.
Dialogue: 0,0:18:18.34,0:18:19.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyihir.
Dialogue: 0,0:18:20.05,0:18:22.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah...
Dialogue: 0,0:18:26.69,0:18:29.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menyediakan pesananmu di toko.
Dialogue: 0,0:18:29.94,0:18:31.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti datang lagi, ya.
Dialogue: 0,0:18:39.82,0:18:40.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:18:42.08,0:18:44.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pasti kedinginan\Ndengan pakaian seperti itu.
Dialogue: 0,0:18:47.41,0:18:49.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tuan!\N- Tidak apa-apa, pakailah.
Dialogue: 0,0:18:56.46,0:18:59.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, terima kasih.\NAku pinjam dulu.
Dialogue: 0,0:18:59.93,0:19:00.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:19:11.81,0:19:14.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kalau aku sendirian,\Nsemuanya akan seperti biasa,\N{\i0}
Dialogue: 0,0:19:14.98,0:19:18.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}sama seperti hari itu,\Ntidak bisa berbuat apa-apa.\N{\i0}
Dialogue: 0,0:19:18.82,0:19:21.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku pasti tidak bisa membersihkan\Nnama "Penyihir Danau".\N{\i0}
Dialogue: 0,0:19:33.13,0:19:35.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Mantelmu...\N- Kau bisa mengembalikannya nanti.
Dialogue: 0,0:19:36.30,0:19:38.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Parah juga wajahmu.
Dialogue: 0,0:19:39.47,0:19:41.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Apakah di rumah ini ada kolam air panas?
Dialogue: 0,0:19:41.47,0:19:43.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Tidak mungkin ada.
Dialogue: 0,0:19:44.10,0:19:46.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kalau tidak ada masalah,\Ngunakan kamar mandi di rumahku.
Dialogue: 0,0:19:46.51,0:19:47.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Ada banyak masalah!
Dialogue: 0,0:19:48.52,0:19:50.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kalau begitu, aku bantu panaskan airnya.
Dialogue: 0,0:19:50.73,0:19:53.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Jangan bercanda denganku lagi.
Dialogue: 0,0:19:55.86,0:19:59.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,\Nbiarkan aku membersihkan kotoran ini.
Dialogue: 0,0:20:09.91,0:20:11.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa, sudah cukup.
Dialogue: 0,0:20:13.63,0:20:14.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:20:16.92,0:20:20.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ada sesuatu yang mengganggu hidupmu,
Dialogue: 0,0:20:20.38,0:20:23.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau kalau keamanan rumahmu diganggu,
Dialogue: 0,0:20:23.47,0:20:24.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}beri tahu aku.
Dialogue: 0,0:20:25.01,0:20:26.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pasti akan membantu.
Dialogue: 0,0:20:30.18,0:20:31.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:20:31.85,0:20:33.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku rasa itu sudah cukup.
Dialogue: 0,0:20:34.19,0:20:36.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berterima kasih kepadamu.
Dialogue: 0,0:20:36.44,0:20:38.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, tinggalkan aku sendiri.
Dialogue: 0,0:20:38.11,0:20:40.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau menyelesaikannya sendirian?
Dialogue: 0,0:20:40.11,0:20:41.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:20:41.78,0:20:44.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama ini, aku memang hidup sendiri.
Dialogue: 0,0:20:45.24,0:20:46.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun...
Dialogue: 0,0:20:47.24,0:20:51.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Penyihir hanya mengabulkan\Npermintaan orang dengan imbalan.\N{\i0}
Dialogue: 0,0:20:51.79,0:20:53.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Imbalan yang adil.\N{\i0}
Dialogue: 0,0:20:53.92,0:20:57.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia membayarku, dan aku membuat obat.\N{\i0}
Dialogue: 0,0:20:58.29,0:21:00.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itulah hubungan kami.\N{\i0}
Dialogue: 0,0:21:00.17,0:21:01.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu saja.\N{\i0}
Dialogue: 0,0:21:02.84,0:21:05.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jadi, sudah cukup.\N{\i0}
Dialogue: 0,0:21:05.93,0:21:08.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku tidak mau menerima lebih daripada ini.\N{\i0}
Dialogue: 0,0:21:08.89,0:21:11.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada urusannya\Ndia penyihir atau orang hebat.
Dialogue: 0,0:21:14.06,0:21:17.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Cukup dengan kata-katanya,\Naku bisa hidup sendiri mulai sekarang.\N{\i0}
Dialogue: 0,0:21:18.77,0:21:21.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Terima kasih banyak untuk hari ini.
Dialogue: 0,0:21:21.74,0:21:25.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku akan mengembalikan mantel ini\Nketika kita bertemu lain kali.
Dialogue: 0,0:21:29.78,0:21:31.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku harus menyiapkan obatnya.\N{\i0}
Dialogue: 0,0:21:31.70,0:21:33.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Secepat mungkin.\N{\i0}
Dialogue: 0,0:21:54.06,0:21:56.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sekitar sepekan setelah itu.\N{\i0}
Dialogue: 0,0:21:56.85,0:22:00.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku bergadang sepanjang malam\Nuntuk menyelesaikan penyesuaian terakhir.\N{\i0}
Dialogue: 0,0:22:01.11,0:22:03.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Akhirnya, obatnya sudah siap.\N{\i0}
Dialogue: 0,0:22:04.65,0:22:07.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Obat pengasih yang Harij inginkan.\N{\i0}
Dialogue: 0,0:23:37.95,0:23:39.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Terjemahan subtitle oleh Haseenah Musa
