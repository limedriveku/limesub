Dialogue: 0,0:05:22.98,0:05:28.74,sign,,0000,0000,0000,,{\an8}EPISODE 7: PENYIHIRLAH YANG MENYIHIR PUTRI
Dialogue: 0,0:00:09.34,0:00:12.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya Kvaravita mau bertemu\Ndengan Putri Villaura lagi
Dialogue: 0,0:00:12.55,0:00:15.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tentang istri diplomat Korsmas.
Dialogue: 0,0:00:15.68,0:00:19.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, pukul berapa kita mau memeriksa\Npakaian untuk terakhir kalinya?
Dialogue: 0,0:00:19.43,0:00:23.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan bertanya apakah kita bisa\Nmengubah jadwal kuliah Profesor Mashar.
Dialogue: 0,0:00:30.73,0:00:31.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masuk.
Dialogue: 0,0:00:36.95,0:00:40.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pikir masih terlalu dini\Nuntuk diundang ke makan malam.
Dialogue: 0,0:00:41.58,0:00:42.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:00:42.79,0:00:46.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengenai obat yang aku serahkan\Ntempo hari...
Dialogue: 0,0:00:46.46,0:00:49.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih atas bantuanmu.
Dialogue: 0,0:00:49.34,0:00:50.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan masalah. Aku...
Dialogue: 0,0:00:51.55,0:00:53.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah memberi tahu Putri\Nsecara langsung pada saat itu.
Dialogue: 0,0:00:53.88,0:00:59.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, aku sudah mencatat penggunaan,\Ndosis, bahaya kelalaian,
Dialogue: 0,0:00:59.18,0:01:01.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan langkah pencegahan...
Dialogue: 0,0:01:01.22,0:01:02.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sangat panjang.
Dialogue: 0,0:01:02.72,0:01:04.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan membacanya nanti.
Dialogue: 0,0:01:04.23,0:01:05.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taruh di sana.
Dialogue: 0,0:01:05.94,0:01:07.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:01:12.07,0:01:13.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski kau terlihat seperti itu,
Dialogue: 0,0:01:13.99,0:01:17.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tahu kau memperhatikan\Nhingga detailnya.
Dialogue: 0,0:01:17.57,0:01:18.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlihat seperti apa?
Dialogue: 0,0:01:18.82,0:01:22.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhir-akhir ini,\Nterkadang kau terlihat tegang,
Dialogue: 0,0:01:22.37,0:01:24.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi pada saat yang sama,\Nkau terlihat gugup
Dialogue: 0,0:01:27.79,0:01:29.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang sebenarnya terjadi?
Dialogue: 0,0:01:30.79,0:01:31.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada sama sekali.
Dialogue: 0,0:01:35.80,0:01:39.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih penting lagi, upacara pernikahan\Nakhirnya tiba bulan depan.
Dialogue: 0,0:01:39.97,0:01:41.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu benar.
Dialogue: 0,0:01:41.10,0:01:44.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putri Villaura terlihat terlalu tenang.
Dialogue: 0,0:01:45.02,0:01:46.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku terlihat begitu?
Dialogue: 0,0:01:47.23,0:01:50.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Yashum yang terlihat makin sedih.
Dialogue: 0,0:01:50.86,0:01:54.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa membawa kakakku\Npergi ke Nifried.
Dialogue: 0,0:01:54.73,0:01:57.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini adalah waktu terbaik\Nuntuk dia melepaskan adiknya.
Dialogue: 0,0:01:58.32,0:02:00.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya Putri sudah bertekad sepenuhnya.
Dialogue: 0,0:02:01.24,0:02:06.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tekad adalah sesuatu yang seharusnya\Naku persiapkan
Dialogue: 0,0:02:06.12,0:02:08.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sejak terlahir sebagai putri raja.
Dialogue: 0,0:02:09.71,0:02:12.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, kalau ada sesuatu\Nyang harus aku khawatirkan,
Dialogue: 0,0:02:13.92,0:02:15.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hanyalah masalah itu.
Dialogue: 0,0:02:15.17,0:02:16.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Obat pengasih itu?
Dialogue: 0,0:02:17.09,0:02:18.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:02:18.43,0:02:20.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski itu bukan tugasmu,
Dialogue: 0,0:02:20.39,0:02:22.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku yakin kau berusaha mendapatkannya.
Dialogue: 0,0:02:22.55,0:02:23.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski kedengarannya lancang,
Dialogue: 0,0:02:24.26,0:02:26.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku selalu anggap Putri sebagai adikku.
Dialogue: 0,0:02:26.98,0:02:30.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat berterima kasih\Nkarena dipercayakan untuk tugas ini.
Dialogue: 0,0:02:30.73,0:02:33.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku terlalu manja\Ndan membiarkanmu mengurus semua detailnya.
Dialogue: 0,0:02:34.69,0:02:36.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak kenal pembuatnya.
Dialogue: 0,0:02:37.28,0:02:40.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak tahu keahliannya\Natau latar belakangnya.
Dialogue: 0,0:02:40.61,0:02:41.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak tahu apa-apa.
Dialogue: 0,0:02:42.41,0:02:44.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku tidak bisa memastikannya.
Dialogue: 0,0:02:44.95,0:02:47.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah itu efektif atau tidak.
Dialogue: 0,0:02:47.37,0:02:48.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Obatnya bekerja.
Dialogue: 0,0:02:50.50,0:02:51.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Obatnya bekerja.
Dialogue: 0,0:02:51.71,0:02:53.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, tapi...
Dialogue: 0,0:02:53.50,0:02:55.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu benar-benar berhasil.
Dialogue: 0,0:02:57.30,0:02:59.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar?
Dialogue: 0,0:03:01.63,0:03:04.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kau berkata demikian,
Dialogue: 0,0:03:04.14,0:03:06.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia pasti penyihir yang terampil.
Dialogue: 0,0:03:06.56,0:03:08.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terampil dalam sihir, berpengetahuan luas,
Dialogue: 0,0:03:09.06,0:03:11.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan terampil dalam menciptakan\Nramuan yang menakutkan...
Dialogue: 0,0:03:11.31,0:03:13.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak salah lagi,\Ndia memang benar penyihir hebat.
Dialogue: 0,0:03:14.31,0:03:16.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, sebelum itu,\Ndia hanya seorang gadis biasa.
Dialogue: 0,0:03:21.57,0:03:22.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putri Villaura?
Dialogue: 0,0:03:23.57,0:03:25.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, ya.
Dialogue: 0,0:03:25.53,0:03:30.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini pertama kalinya aku tahu\Nkau terkadang menilai orang seperti ini.
Dialogue: 0,0:03:32.25,0:03:33.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku minta maaf.
Dialogue: 0,0:03:34.00,0:03:37.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena masih ada beberapa hari tersisa,\Nsemoga tidak ada penyesalan.
Dialogue: 0,0:03:50.02,0:03:52.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada penyesalan?
Dialogue: 0,0:05:26.03,0:05:28.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Angin musim dingin\Nmembawa musim gugur pergi,\N{\i0}
Dialogue: 0,0:05:28.82,0:05:31.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dan aroma musim dingin mulai\Nbercampur dengan kabut pagi.\N{\i0}
Dialogue: 0,0:05:33.50,0:05:36.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pondok penyihir sedang membuat\Npersediaan untuk musim dingin.\N{\i0}
Dialogue: 0,0:05:41.17,0:05:43.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku sudah menumpuk kayu bakar,\Nsekarang harus mengganti\N{\i0}
Dialogue: 0,0:05:43.38,0:05:46.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}sekam padi dan jerami\Nyang ditempatkan di ladang.\N{\i0}
Dialogue: 0,0:05:46.80,0:05:48.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kemudian...\N{\i0}
Dialogue: 0,0:05:49.76,0:05:50.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harij?
Dialogue: 0,0:05:53.52,0:05:55.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia sering ke sini akhir-akhir ini.\N{\i0}
Dialogue: 0,0:05:57.64,0:05:59.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Selama ini, aku bisa saja hidup sendiri.\N{\i0}
Dialogue: 0,0:06:00.31,0:06:04.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Lebih penting lagi, di mana aku menaruh\Nselimut dan jubah musim dingin?\N{\i0}
Dialogue: 0,0:06:11.32,0:06:13.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Matahari sudah terbenam.
Dialogue: 0,0:06:15.16,0:06:16.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kalau dipikir-pikir,\N{\i0}
Dialogue: 0,0:06:16.71,0:06:18.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}lonceng itu berbunyi pada siang hari.\N{\i0}
Dialogue: 0,0:06:19.04,0:06:21.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Hewan biasanya tidak terlalu aktif\Npada waktu begini.\N{\i0}
Dialogue: 0,0:06:32.64,0:06:35.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah kau pelangganku?
Dialogue: 0,0:06:37.14,0:06:38.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia sudah di sini sejak tadi?\N{\i0}
Dialogue: 0,0:06:39.81,0:06:41.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Obat penyihir itu mahal.\N{\i0}
Dialogue: 0,0:06:42.36,0:06:46.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pelanggan kelas atas biasanya\Nmengirim bawahannya,\N{\i0}
Dialogue: 0,0:06:47.11,0:06:49.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}tapi ada juga orang aneh\Nyang datang sendiri,\N{\i0}
Dialogue: 0,0:06:49.82,0:06:52.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dan mereka menunggu seperti ini\Nsampai diundang.\N{\i0}
Dialogue: 0,0:06:54.08,0:06:55.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya kau datang.
Dialogue: 0,0:06:55.87,0:06:59.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pelanggan seperti ini biasanya merepotkan.\N{\i0}
Dialogue: 0,0:07:00.46,0:07:01.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku akan dimarahi.\N{\i0}
Dialogue: 0,0:07:07.67,0:07:09.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau seorang penyihir?
Dialogue: 0,0:07:09.13,0:07:10.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:07:10.97,0:07:13.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bukan pelanggan,\Ntapi aku mau datang ke sini.
Dialogue: 0,0:07:18.43,0:07:20.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apakah ini semua salahku?\N{\i0}
Dialogue: 0,0:07:23.90,0:07:25.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rumahku agak berantakan.
Dialogue: 0,0:07:44.25,0:07:45.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan.
Dialogue: 0,0:07:45.54,0:07:46.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya Tuhan.
Dialogue: 0,0:07:47.34,0:07:48.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia sedang berdoa.\N{\i0}
Dialogue: 0,0:07:56.93,0:07:58.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak seburuk yang dibayangkan.
Dialogue: 0,0:07:58.85,0:08:01.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang kau menyukainya.
Dialogue: 0,0:08:01.85,0:08:02.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:08:04.73,0:08:07.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong panggil aku Raou.
Dialogue: 0,0:08:07.48,0:08:09.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah. Nona Raou.
Dialogue: 0,0:08:09.78,0:08:11.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bisa memanggilku penyihir.
Dialogue: 0,0:08:13.15,0:08:15.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia benar-benar datang ke sini\Ndengan sandal rumah?\N{\i0}
Dialogue: 0,0:08:16.57,0:08:19.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Melihat penampilannya,\Ndia berasal dari keluarga baik-baik,\N{\i0}
Dialogue: 0,0:08:20.41,0:08:23.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}jadi aku yakin orang-orang di sekitarnya\Npasti terkejut.\N{\i0}
Dialogue: 0,0:08:24.58,0:08:26.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuaca di luar pasti dingin.
Dialogue: 0,0:08:26.79,0:08:28.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menyalakan api di perapian.
Dialogue: 0,0:08:36.72,0:08:39.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin kau terkejut\Nkarena aku muncul secara tiba-tiba.
Dialogue: 0,0:08:39.97,0:08:43.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua pelangganku datang secara tiba-tiba.
Dialogue: 0,0:08:52.65,0:08:54.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Izinkan aku membantumu.
Dialogue: 0,0:08:55.32,0:08:56.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:08:58.58,0:09:00.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kakinya putih.\N{\i0}
Dialogue: 0,0:09:00.87,0:09:02.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu terlihat menyakitkan.\N{\i0}
Dialogue: 0,0:09:02.70,0:09:04.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Selain itu,\Ndia sudah lama tidak merawatnya.\N{\i0}
Dialogue: 0,0:09:12.13,0:09:15.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti sulit datang dari jauh\Nke sini sendirian.
Dialogue: 0,0:09:17.30,0:09:19.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak mau bertanya siapa aku?
Dialogue: 0,0:09:20.35,0:09:22.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Penyihir tidak pernah bertanya
Dialogue: 0,0:09:22.56,0:09:25.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}atau memberi tahu siapa pun\Ntentang orang yang mengunjungi tempat ini.
Dialogue: 0,0:09:26.31,0:09:28.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang bergantung kepada penyihir
Dialogue: 0,0:09:28.65,0:09:32.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}memiliki keinginan mendesak\Nyang tidak bisa mereka penuhi sendiri.
Dialogue: 0,0:09:34.32,0:09:37.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya menghasilkan obat\Nyang diminta oleh pelanggan.
Dialogue: 0,0:09:38.20,0:09:41.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terserah pelanggan apakah mereka mau
Dialogue: 0,0:09:41.33,0:09:43.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}memberi tahu kekhawatiran\Nmaupun kemauan mereka.
Dialogue: 0,0:09:44.50,0:09:47.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu memang mudah bagi pelanggan.
Dialogue: 0,0:09:48.38,0:09:50.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitulah cara kerja penyihir.
Dialogue: 0,0:09:51.21,0:09:54.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kau akan membuat obat apa pun\Nyang mereka minta?
Dialogue: 0,0:09:55.55,0:09:59.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau itu benar-benar hal\Nyang mereka mau dari lubuk hati mereka.
Dialogue: 0,0:10:00.43,0:10:02.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pikir niat tulus bisa membenarkan
Dialogue: 0,0:10:02.85,0:10:06.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tindakan memberikan obat\Nyang mengubah kesadaran kepada orang lain?
Dialogue: 0,0:10:12.32,0:10:14.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau akan merasa enggan\Nuntuk memberikan obat
Dialogue: 0,0:10:14.94,0:10:17.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kepada pasien yang benar-benar\Nmau tetap hidup?
Dialogue: 0,0:10:18.74,0:10:21.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudmu seperti diagnosis ahli farmasi?
Dialogue: 0,0:10:21.70,0:10:23.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagiku, tidak ada yang berubah.
Dialogue: 0,0:10:24.37,0:10:27.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesuatu yang memiliki efek khusus\Npada pikiran dan tubuh,
Dialogue: 0,0:10:27.58,0:10:28.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}itulah obat.
Dialogue: 0,0:10:29.75,0:10:33.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setiap orang yang datang ke rumah ini,\Nsemuanya sama saja.
Dialogue: 0,0:10:34.05,0:10:35.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya pelanggan penting.
Dialogue: 0,0:10:36.13,0:10:37.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah kau anak orang kaya?
Dialogue: 0,0:10:42.64,0:10:45.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya. Semua pelanggan penting?
Dialogue: 0,0:10:45.22,0:10:46.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:10:46.22,0:10:48.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dan semua orang sama.
Dialogue: 0,0:10:50.73,0:10:54.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun, menurutku dia tertawa\Nkarena alasan yang berbeda.\N{\i0}
Dialogue: 0,0:10:54.57,0:10:55.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tidak apa-apa.\N{\i0}
Dialogue: 0,0:11:02.99,0:11:03.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyihir.
Dialogue: 0,0:11:04.08,0:11:06.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga mau obat darimu.
Dialogue: 0,0:11:09.41,0:11:12.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak lama lagi,\Naku akan menikah dengan orang jauh.
Dialogue: 0,0:11:12.88,0:11:14.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di tempat yang amat sangat jauh.
Dialogue: 0,0:11:15.50,0:11:16.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:11:16.42,0:11:19.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku lahir dan dibesarkan di negeri ini.
Dialogue: 0,0:11:19.92,0:11:21.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat menyukai\Nsemua yang ada di sini.
Dialogue: 0,0:11:22.43,0:11:25.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sama seperti apa yang aku rasakan\Ntentang pondok ini.\N{\i0}
Dialogue: 0,0:11:25.89,0:11:30.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, tanah yang sudah aku lindungi\Nselama ini
Dialogue: 0,0:11:30.52,0:11:33.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin tidak akan bisa aku datangi lagi.
Dialogue: 0,0:11:38.57,0:11:40.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Maaf.\N- Tidak apa-apa.
Dialogue: 0,0:11:41.20,0:11:45.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memang mau pergi ke tempat lain,\Nsuatu hari nanti, demi keluargaku.
Dialogue: 0,0:11:46.45,0:11:49.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, asumsiku biasanya\Nterlalu optimistis.
Dialogue: 0,0:11:51.54,0:11:55.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sangat penting\Ndan menentukan segalanya
Dialogue: 0,0:11:55.46,0:11:57.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tentang masa depanku.
Dialogue: 0,0:11:59.42,0:12:04.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mungkin orang ini sudah hidup\Ntanpa keluar dari zona nyamannya.\N{\i0}
Dialogue: 0,0:12:05.55,0:12:06.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Seperti penyihir,\N{\i0}
Dialogue: 0,0:12:07.01,0:12:08.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}mereka juga terikat\Npada sesuatu sejak lahir.\N{\i0}
Dialogue: 0,0:12:22.90,0:12:24.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisakah aku mendengar lebih banyak?
Dialogue: 0,0:12:25.66,0:12:27.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:12:27.66,0:12:30.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya mau berbicara dengan seseorang.
Dialogue: 0,0:12:31.33,0:12:32.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, Penyihir.
Dialogue: 0,0:12:32.75,0:12:35.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pernahkah kau jatuh cinta\Nkepada seseorang?
Dialogue: 0,0:12:36.38,0:12:37.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku?
Dialogue: 0,0:12:38.00,0:12:38.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:12:39.05,0:12:40.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku pelanggan tetapmu,
Dialogue: 0,0:12:40.96,0:12:42.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bolehkah kau menceritakan\Nkisahmu kepadaku?
Dialogue: 0,0:12:43.43,0:12:44.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku...
Dialogue: 0,0:12:45.47,0:12:46.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku minta maaf.
Dialogue: 0,0:12:47.01,0:12:49.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya. Benar juga.
Dialogue: 0,0:12:49.72,0:12:51.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau mau tahu tentang aku?
Dialogue: 0,0:12:52.39,0:12:56.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada yang mau menceritakan\Nkisah seperti itu kepadaku.
Dialogue: 0,0:12:57.69,0:13:02.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu, teman, maupun bawahanku\Ntak pernah mengungkapkan perasaan mereka.
Dialogue: 0,0:13:02.19,0:13:03.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu...
Dialogue: 0,0:13:03.65,0:13:08.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, hanya kau yang mengatakan\Nbahwa aku sama saja dengan orang lain.
Dialogue: 0,0:13:10.58,0:13:15.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku rasa aku bisa menjadi\Ngadis biasa bernama Raou di pondok ini.
Dialogue: 0,0:13:20.88,0:13:22.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:13:23.13,0:13:25.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau cerita tentang orang lain\Nyang aku kenal... Bukan.
Dialogue: 0,0:13:25.22,0:13:28.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau orang lain di dunia ini, boleh?
Dialogue: 0,0:13:28.80,0:13:29.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau mendengarnya.
Dialogue: 0,0:13:32.97,0:13:34.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kata orang itu,
Dialogue: 0,0:13:34.60,0:13:37.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ada seseorang yang sering menerobos\Nmasuk ke dalam wilayahnya.
Dialogue: 0,0:13:38.69,0:13:42.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia benar-benar tidak mengerti\Nkenapa orang itu melakukannya.\N{\i0}
Dialogue: 0,0:13:42.61,0:13:43.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia tidak menyukainya?\N{\i0}
Dialogue: 0,0:13:44.28,0:13:45.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tidak.\N{\i0}
Dialogue: 0,0:13:45.45,0:13:48.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Hanya dia merasa seperti dipaksa\Nmemainkan permainan bangsawan\N{\i0}
Dialogue: 0,0:13:48.95,0:13:52.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}yang tidak bermakna,\Ndengan pisau di lehernya.\N{\i0}
Dialogue: 0,0:13:53.66,0:13:57.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia menerimanya dengan perasaan\Nsetengah senang dan setengah takut.\N{\i0}
Dialogue: 0,0:13:58.00,0:14:00.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kalau dia memang akan ditikam,\Ndia berharap bisa segera selesai.\N{\i0}
Dialogue: 0,0:14:01.75,0:14:04.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jadi, itu artinya,\Ndia sangat menyukainya orang itu?\N{\i0}
Dialogue: 0,0:14:05.01,0:14:06.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku kira demikian.\N{\i0}
Dialogue: 0,0:14:07.22,0:14:08.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sulit.
Dialogue: 0,0:14:08.97,0:14:10.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin juga.
Dialogue: 0,0:14:11.22,0:14:13.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Cinta selama bertahun-tahun memang berat.\N{\i0}
Dialogue: 0,0:14:14.14,0:14:17.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Berkali-kali aku berkata,\N"Aku harus berhenti mencintainya".\N{\i0}
Dialogue: 0,0:14:17.89,0:14:19.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku menangis sepanjang malam,\N{\i0}
Dialogue: 0,0:14:20.15,0:14:22.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}tapi setiap pagi aku masih mencintainya.\N{\i0}
Dialogue: 0,0:14:23.94,0:14:27.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku merasa sangat iri kepadanya.
Dialogue: 0,0:14:28.95,0:14:31.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belum pernah jatuh cinta\Ndengan siapa pun.
Dialogue: 0,0:14:32.16,0:14:34.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ditambah laki-laki yang akan aku nikahi
Dialogue: 0,0:14:34.41,0:14:37.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah seorang duda\Nberusia 40 tahun lebih tua dariku.
Dialogue: 0,0:14:37.08,0:14:38.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seorang duda?
Dialogue: 0,0:14:38.62,0:14:41.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak begitu mengenal\Npria yang akan aku nikahi.
Dialogue: 0,0:14:42.50,0:14:43.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:14:43.67,0:14:46.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingat dia baik hati kepadaku\Ndi pesta itu.
Dialogue: 0,0:14:46.92,0:14:48.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, itu tidak cukup.
Dialogue: 0,0:14:49.72,0:14:50.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:14:50.64,0:14:52.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pikir aku sudah siap,
Dialogue: 0,0:14:52.80,0:14:55.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi membayangkan hidup di sana\Nmembuatku takut.
Dialogue: 0,0:14:56.27,0:14:59.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau keluarga atau kesatria\Ntidak ada di sisiku,
Dialogue: 0,0:14:59.31,0:15:01.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku mau memiliki sesuatu untuk diandalkan.
Dialogue: 0,0:15:02.65,0:15:05.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, aku mau obatnya.
Dialogue: 0,0:15:07.74,0:15:08.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Obat dariku?
Dialogue: 0,0:15:09.20,0:15:12.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Obat pengasih yang kau buat.
Dialogue: 0,0:15:14.37,0:15:16.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan kecantikan seperti Nn. Raou,
Dialogue: 0,0:15:16.79,0:15:19.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}penyihir pun tidak bisa menandinginya.
Dialogue: 0,0:15:19.66,0:15:23.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Aku tidak mau menggunakannya\Nuntuk merayu orang.
Dialogue: 0,0:15:25.25,0:15:27.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku mau menggunakannya\Nuntuk membuat diriku jatuh cinta.
Dialogue: 0,0:15:33.76,0:15:35.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membuatmu jatuh cinta?
Dialogue: 0,0:15:36.22,0:15:39.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa pun yang terjadi\Natau dilakukan kepadaku,
Dialogue: 0,0:15:39.64,0:15:41.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku harus tetap tersenyum.
Dialogue: 0,0:15:42.52,0:15:45.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mencintai suamiku adalah kekuatanku.
Dialogue: 0,0:15:46.90,0:15:48.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun,
Dialogue: 0,0:15:48.40,0:15:51.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tidak yakin aku bisa menemukan\Ncinta sejati seperti ceritamu.
Dialogue: 0,0:15:52.74,0:15:55.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski aku menyerahkan nama dan tubuhku,
Dialogue: 0,0:15:55.66,0:15:57.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hatiku tidak bisa aku kendalikan.
Dialogue: 0,0:15:58.75,0:16:01.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sebabnya aku bergantung\Nkepadamu, Penyihir.
Dialogue: 0,0:16:03.58,0:16:05.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Caramu bicara membuat penyihir,
Dialogue: 0,0:16:06.50,0:16:08.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang orang benci, menjadi sumber harapan.
Dialogue: 0,0:16:09.46,0:16:10.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:16:10.67,0:16:12.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Kau akan menjadi penolongku.
Dialogue: 0,0:16:14.09,0:16:15.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu suatu kehormatan.
Dialogue: 0,0:16:17.31,0:16:19.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku merasa lega.
Dialogue: 0,0:16:19.52,0:16:23.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini pertama kalinya aku mengungkapkan\Nperasaan kepada orang begini.
Dialogue: 0,0:16:23.31,0:16:25.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berjalan di jalan yang disukai,
Dialogue: 0,0:16:25.23,0:16:27.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sendirian di hutan.
Dialogue: 0,0:16:27.19,0:16:29.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah kau tidak merasa kesepian?
Dialogue: 0,0:16:29.94,0:16:32.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak. Rasanya sangat menyegarkan.
Dialogue: 0,0:16:33.11,0:16:36.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tahu-tahu, matahari sudah terbenam.
Dialogue: 0,0:16:37.78,0:16:39.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah ini hari yang indah bagimu?
Dialogue: 0,0:16:40.45,0:16:42.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sangat indah.
Dialogue: 0,0:16:43.16,0:16:46.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kisahmu meninggalkan kesan\Nyang mendalam bagiku.
Dialogue: 0,0:16:47.67,0:16:48.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:16:49.84,0:16:51.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan membuatkanmu teh panas.
Dialogue: 0,0:16:52.30,0:16:53.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:17:01.56,0:17:02.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Raou.
Dialogue: 0,0:17:02.85,0:17:04.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya orang yang familier sudah tiba.
Dialogue: 0,0:17:04.69,0:17:05.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang familier?
Dialogue: 0,0:17:05.81,0:17:07.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan mengusirnya,
Dialogue: 0,0:17:07.52,0:17:09.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi harap tunggu sebentar.
Dialogue: 0,0:17:15.57,0:17:16.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rose.
Dialogue: 0,0:17:19.37,0:17:20.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah datang.
Dialogue: 0,0:17:20.99,0:17:22.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bingung karena tidak ada perahu.
Dialogue: 0,0:17:22.75,0:17:24.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong tenang.
Dialogue: 0,0:17:24.21,0:17:25.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, tapi hari ini...
Dialogue: 0,0:17:26.04,0:17:27.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, ini darurat.
Dialogue: 0,0:17:27.83,0:17:30.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah ada cara\Nuntuk menemukan barang hilang?
Dialogue: 0,0:17:30.50,0:17:32.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menyiapkan alat\Natau ramuan yang dibutuhkan...
Dialogue: 0,0:17:32.76,0:17:33.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei!
Dialogue: 0,0:17:37.68,0:17:38.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putri Villaura!
Dialogue: 0,0:17:40.01,0:17:43.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah itu Tuanku Putri?
Dialogue: 0,0:17:43.98,0:17:47.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentang orang yang kau cari...
Dialogue: 0,0:17:47.23,0:17:48.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku.
Dialogue: 0,0:17:48.65,0:17:50.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak lagi membutuhkannya.
Dialogue: 0,0:17:51.02,0:17:52.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya begitu.
Dialogue: 0,0:17:55.40,0:17:58.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa Putri menyelinap pergi\Ntanpa mengucapkan sepatah kata pun?
Dialogue: 0,0:17:59.12,0:18:00.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa datang ke tempat ini?
Dialogue: 0,0:18:00.74,0:18:03.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana boleh pergi ke sini sendirian?
Dialogue: 0,0:18:03.75,0:18:07.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin Putri berjalan ke sini\Nmemakai sepatu seperti itu.
Dialogue: 0,0:18:07.83,0:18:09.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, orang pikir Putri sembunyi...
Dialogue: 0,0:18:09.58,0:18:11.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku pikir dia bangsawan.\N{\i0}
Dialogue: 0,0:18:11.71,0:18:13.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Rupanya dia Putri Villaura.\N{\i0}
Dialogue: 0,0:18:13.46,0:18:14.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Artinya...\N{\i0}
Dialogue: 0,0:18:14.71,0:18:21.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kesatria Kerajaan Harij membeli\Nobat pengasih yang Villaura mau?\N{\i0}
Dialogue: 0,0:18:22.81,0:18:25.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putri tahu betapa kacau istana sekarang?
Dialogue: 0,0:18:26.10,0:18:28.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berapa banyak orang\Nyang mencari sang Putri?
Dialogue: 0,0:18:30.06,0:18:32.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf. Maafkan aku.
Dialogue: 0,0:18:34.32,0:18:38.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau mengalami hari ini\Nkarena tidak mau ada penyesalan.
Dialogue: 0,0:18:38.53,0:18:39.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putri Villaura.
Dialogue: 0,0:18:41.53,0:18:43.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf kalau aku kelewatan.
Dialogue: 0,0:18:44.24,0:18:47.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf karena aku jauh dari Putri
Dialogue: 0,0:18:47.50,0:18:49.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan tidak bisa melindungi Putri.
Dialogue: 0,0:18:49.83,0:18:51.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat senang Putri aman.
Dialogue: 0,0:18:53.55,0:18:54.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah menyusahkanmu.
Dialogue: 0,0:18:55.38,0:18:57.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dengan rendah hati
Dialogue: 0,0:18:57.38,0:19:02.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mau meminta Putri mengingat kata-kata itu\Nsampai kembali ke kamar.
Dialogue: 0,0:19:03.47,0:19:05.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan terlalu takut,\Naku sudah mau kembali.
Dialogue: 0,0:19:07.39,0:19:08.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putri Villaura.
Dialogue: 0,0:19:09.23,0:19:10.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong berhenti.
Dialogue: 0,0:19:11.69,0:19:12.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyihir.
Dialogue: 0,0:19:12.94,0:19:16.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku minta maaf\Nkarena membuat keributan di rumahmu.
Dialogue: 0,0:19:16.82,0:19:19.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lain kali, silakan datang ke sini\Nuntuk minum teh.
Dialogue: 0,0:19:20.45,0:19:22.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik. Habiskan lebih banyak waktu di sini.
Dialogue: 0,0:19:23.24,0:19:24.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, ayo kembali.
Dialogue: 0,0:19:26.24,0:19:27.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu sebentar.
Dialogue: 0,0:19:28.50,0:19:30.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak salah, ada di sekitar sini.
Dialogue: 0,0:19:33.13,0:19:36.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hutan pada malam hari itu\Ngelap dan berbahaya, jadi gunakan ini.
Dialogue: 0,0:19:37.30,0:19:39.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau juga punya sepatu bot?
Dialogue: 0,0:19:39.59,0:19:40.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Lebih kurang.
Dialogue: 0,0:19:41.22,0:19:44.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Oleh-oleh dari Tien\Nterkadang berguna juga.\N{\i0}
Dialogue: 0,0:19:44.93,0:19:46.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menerima kebaikanmu\Ndengan lapang dada.
Dialogue: 0,0:19:52.35,0:19:53.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyihir. Sampai jumpa lagi, ya.
Dialogue: 0,0:19:58.19,0:19:59.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepatu ini memudahkan pergerakanku.
Dialogue: 0,0:20:00.28,0:20:03.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada banyak hal\Nyang aku tidak tahu di dunia ini.
Dialogue: 0,0:20:04.07,0:20:05.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ringan dan hangat,
Dialogue: 0,0:20:05.99,0:20:08.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku bisa terbang\Nmelintasi hutan dalam sekejap.
Dialogue: 0,0:20:09.45,0:20:11.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami minta maaf karena mengganggumu.
Dialogue: 0,0:20:12.62,0:20:14.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Berhenti datang tiba-tiba,\Ntidak baik untuk jantungku!\N{\i0}
Dialogue: 0,0:20:16.04,0:20:18.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku minta maaf tentang sepatu bot itu.
Dialogue: 0,0:20:18.63,0:20:20.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku pasti akan menebusnya nanti.
Dialogue: 0,0:20:20.80,0:20:22.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Rambutmu masih berantakan.\N{\i0}
Dialogue: 0,0:20:25.05,0:20:28.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia selalu meninggikan diri\Nsampai jadi menyebalkan,\N{\i0}
Dialogue: 0,0:20:28.31,0:20:30.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}tapi hari ini saja,\Ndia meminta maaf berkali-kali.\N{\i0}
Dialogue: 0,0:20:33.85,0:20:38.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ini dan itu, semua terjadi karena Harij\Ndatang ke sini hampir setiap hari.\N{\i0}
Dialogue: 0,0:20:38.69,0:20:41.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia adalah orang yang mustahil aku gapai,\N{\i0}
Dialogue: 0,0:20:41.57,0:20:44.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}tapi dia membuatku merasa\Nseperti aku tahu segalanya tentang dia.\N{\i0}
Dialogue: 0,0:20:45.91,0:20:48.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisakah kau mempercepat\Npersiapan obat kedua ini?
Dialogue: 0,0:20:49.04,0:20:49.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:20:50.16,0:20:52.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama adalah untuk Nn. Raou.
Dialogue: 0,0:20:52.25,0:20:54.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kedua adalah demi\Nkepentingan pelanggan, 'kan?
Dialogue: 0,0:20:56.38,0:20:57.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku harus berhenti.\N{\i0}
Dialogue: 0,0:20:57.79,0:20:59.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Menanyakan urusan klien\N{\i0}
Dialogue: 0,0:20:59.63,0:21:02.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}adalah pengkhianatan\Nterhadap kepercayaan penyihir.\N{\i0}
Dialogue: 0,0:21:02.09,0:21:05.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah kau membutuhkannya\Nsebelum Nn. Raou menikah?
Dialogue: 0,0:21:06.76,0:21:11.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kata-kata buruk yang timbul\Nakibat rasa cemburu itu sangat memalukan,\N{\i0}
Dialogue: 0,0:21:11.27,0:21:14.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}meski aku tahu itu bodoh,\Naku tidak bisa menahan diri.\N{\i0}
Dialogue: 0,0:21:14.52,0:21:19.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku pesan obat itu\Nagar Nn. Raou tidak melupakanku.
Dialogue: 0,0:21:19.61,0:21:20.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan.
Dialogue: 0,0:21:20.73,0:21:23.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, kau tidak akan menghalangi.
Dialogue: 0,0:21:23.49,0:21:25.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bilang bukan.
Dialogue: 0,0:21:35.75,0:21:38.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh menakjubkan\Nkalau kau peduli dengan pelanggan.
Dialogue: 0,0:21:38.92,0:21:40.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mengecewakan.\N{\i0}
Dialogue: 0,0:21:41.34,0:21:43.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku seorang penyihir.\N{\i0}
Dialogue: 0,0:21:43.30,0:21:45.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kenapa aku melakukan hal tak berguna ini?\N{\i0}
Dialogue: 0,0:21:52.27,0:21:54.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa pun yang terjadi,\Naku pasti akan datang lagi.
Dialogue: 0,0:23:38.00,0:23:40.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Terjemahan subtitle oleh Haseenah Musa
