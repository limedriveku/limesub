Dialogue: 0,0:03:06.97,0:03:12.19,sign,,0000,0000,0000,,{\an8}EPISODE 3: LAGU PENYIHIR\NDENGAN AROMA TEH
Dialogue: 0,0:14:48.84,0:14:54.06,sign,,0000,0000,0000,,{\an8}YUM
Dialogue: 0,0:00:11.72,0:00:13.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Musim semi masih jauh.
Dialogue: 0,0:00:14.93,0:00:19.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah berapa lama kau melayaniku?
Dialogue: 0,0:00:19.14,0:00:21.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pikir tahun ini sudah tujuh tahun.
Dialogue: 0,0:00:21.77,0:00:23.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah tujuh tahun?
Dialogue: 0,0:00:24.98,0:00:27.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya lebih lama.
Dialogue: 0,0:00:28.36,0:00:32.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kau dekat denganku\Nsebagai teman masa kecil kakakku.
Dialogue: 0,0:00:32.94,0:00:35.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini juga sebuah pengalaman\Nyang sangat berharga bagiku.
Dialogue: 0,0:00:37.57,0:00:42.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat itu, aku lebih bergantung kepadamu\Ndibandingkan dengan kakakku.
Dialogue: 0,0:00:43.16,0:00:45.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih atas pujiannya.
Dialogue: 0,0:00:46.62,0:00:51.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harij. Apa yang akan aku katakan\Nbukan perintah seorang putri,
Dialogue: 0,0:00:51.09,0:00:52.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi karena kau sudah seperti kakakku.
Dialogue: 0,0:00:52.88,0:00:55.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa pertimbangkan permintaan egois ini?
Dialogue: 0,0:00:55.72,0:00:56.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permintaan?
Dialogue: 0,0:00:58.68,0:01:01.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau kau membantuku\Nmendapatkan obat pengasih.
Dialogue: 0,0:01:05.81,0:01:06.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:01:08.90,0:01:11.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alasannya jelas, 'kan?
Dialogue: 0,0:01:16.82,0:01:18.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun...
Dialogue: 0,0:01:18.28,0:01:21.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Obat pengasih adalah sesuatu\Nyang bisa menyesatkan hati manusia.
Dialogue: 0,0:01:21.66,0:01:24.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Itu tindakan menyimpang...\N- Tolong, Harij.
Dialogue: 0,0:01:25.46,0:01:27.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini permintaan sekali seumur hidup.
Dialogue: 0,0:01:29.04,0:01:33.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktuku tidak sampai\Nsatu tahun lagi untuk hidup.
Dialogue: 0,0:03:17.40,0:03:19.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku harus membawakannya untuknya.\N{\i0}
Dialogue: 0,0:03:21.82,0:03:24.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah kau tinggal sendirian?
Dialogue: 0,0:03:26.03,0:03:27.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:03:27.49,0:03:29.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah menurutmu tidak berbahaya?
Dialogue: 0,0:03:31.96,0:03:34.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak punya banyak pelanggan.
Dialogue: 0,0:03:34.92,0:03:39.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ada yang mencurigakan,\Naku segera sembunyi di ruang bawah tanah.
Dialogue: 0,0:03:39.21,0:03:42.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rupanya sudah beberapa kali\Nkau dalam bahaya.
Dialogue: 0,0:03:42.26,0:03:44.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bukan masalah besar.
Dialogue: 0,0:03:45.26,0:03:47.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah selama ini kau hidup seperti ini?
Dialogue: 0,0:03:48.31,0:03:49.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, seperti ini.
Dialogue: 0,0:03:52.27,0:03:55.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Seorang gadis muda sendirian\Ndi tempat seperti ini\N{\i0}
Dialogue: 0,0:03:55.44,0:03:57.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}tanpa bergantung kepada siapa pun.\N{\i0}
Dialogue: 0,0:03:59.86,0:04:01.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tidak.\N{\i0}
Dialogue: 0,0:04:01.15,0:04:04.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sebagai orang luar yang tidak berkaitan,\Napa yang bisa aku katakan?\N{\i0}
Dialogue: 0,0:04:21.76,0:04:22.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku masuk, ya.
Dialogue: 0,0:04:25.80,0:04:28.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bukan tempat untuk bersantai,\Nkau tahu itu?
Dialogue: 0,0:04:28.81,0:04:29.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan khawatir.
Dialogue: 0,0:04:32.23,0:04:33.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku tidak mengerti apa yang dia maksud.\N{\i0}
Dialogue: 0,0:04:34.56,0:04:35.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun!\N{\i0}
Dialogue: 0,0:04:36.65,0:04:38.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku akan memaafkanmu untuk keranjang ini.\N{\i0}
Dialogue: 0,0:04:38.77,0:04:40.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sesuatu yang berbau harum.\N{\i0}
Dialogue: 0,0:04:40.90,0:04:42.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini?
Dialogue: 0,0:04:42.65,0:04:43.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tarte Tatin.
Dialogue: 0,0:04:48.41,0:04:50.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tarte Tatin?
Dialogue: 0,0:04:50.99,0:04:52.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku potong, ya.
Dialogue: 0,0:04:52.33,0:04:53.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong potong.
Dialogue: 0,0:04:55.21,0:04:56.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Untungnya.\N{\i0}
Dialogue: 0,0:04:57.04,0:05:00.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku khawatir keadaan menjadi canggung\Nsetelah apa yang terjadi kemarin.\N{\i0}
Dialogue: 0,0:05:01.42,0:05:04.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku pikir aku bisa berbicara\Nlebih santai sekarang.\N{\i0}
Dialogue: 0,0:05:08.26,0:05:10.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Aku lupa apa yang aku tunjukkan kemarin.\N{\i0}
Dialogue: 0,0:05:10.64,0:05:12.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Aku benar-benar lupa!\N{\i0}
Dialogue: 0,0:05:12.22,0:05:14.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Taruh banyak daun teh.
Dialogue: 0,0:05:14.35,0:05:15.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daun teh?
Dialogue: 0,0:05:20.11,0:05:21.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:05:22.73,0:05:25.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku tidak berpikir untuk membuatkan teh.\N{\i0}
Dialogue: 0,0:05:25.53,0:05:27.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia pasti mau duduk lama sekali.\N{\i0}
Dialogue: 0,0:05:31.45,0:05:33.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Lagi pula, aku sudah menerima\Nhadiah dari dia.\N{\i0}
Dialogue: 0,0:05:39.75,0:05:44.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pasti ada teh dari pelanggan di sini.\N{\i0}
Dialogue: 0,0:05:50.68,0:05:51.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini dia.
Dialogue: 0,0:05:54.68,0:05:55.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Sudah berjamur.
Dialogue: 0,0:05:56.73,0:05:57.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebentar!
Dialogue: 0,0:05:57.64,0:06:00.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bilang kau mau membuat teh\Nmenggunakan benda itu!
Dialogue: 0,0:06:03.11,0:06:04.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Besok aku akan membawakan daun teh.
Dialogue: 0,0:06:05.57,0:06:06.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:06:06.82,0:06:08.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau datang besok juga?
Dialogue: 0,0:06:09.03,0:06:10.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:06:10.28,0:06:11.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah ada teh yang kau suka?
Dialogue: 0,0:06:11.70,0:06:13.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada.
Dialogue: 0,0:06:13.33,0:06:16.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bukan berarti kau mengganggu,\Ntapi hatiku tidak tahan.\N{\i0}
Dialogue: 0,0:06:16.37,0:06:17.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada masalah?
Dialogue: 0,0:06:18.58,0:06:23.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak. Kau selalu datang ke sini.\NJadi, aku khawatir dengan jadwalmu.
Dialogue: 0,0:06:23.38,0:06:24.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan masalah.
Dialogue: 0,0:06:24.50,0:06:27.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rekan kerjaku senang menyuruhku\Nmengambil cuti sesekali.
Dialogue: 0,0:06:28.51,0:06:29.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuti?
Dialogue: 0,0:06:29.84,0:06:34.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, Kesatria Kerajaan sulit\Nuntuk mengambil cuti sepanjang hari.
Dialogue: 0,0:06:34.81,0:06:36.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuti sepanjang hari?
Dialogue: 0,0:06:37.23,0:06:41.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin penyihir tidak punya konsep\Nhari kerja atau akhir pekan?
Dialogue: 0,0:06:42.77,0:06:44.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Tidak ada.
Dialogue: 0,0:06:46.65,0:06:48.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daripada mengambil cuti sehari,
Dialogue: 0,0:06:48.90,0:06:51.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku perpanjang istirahat makan siangku.
Dialogue: 0,0:06:55.58,0:06:58.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia datang ke sini dengan sengaja\Npada waktu istirahat?\N{\i0}
Dialogue: 0,0:06:58.96,0:07:00.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bawa hadiah juga.\N{\i0}
Dialogue: 0,0:07:00.96,0:07:03.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimanapun, aku merasa tenang di sini.
Dialogue: 0,0:07:09.67,0:07:12.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau menyukai hutan ini?
Dialogue: 0,0:07:13.05,0:07:14.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Aku menyukainya.
Dialogue: 0,0:07:18.68,0:07:19.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga.
Dialogue: 0,0:07:28.23,0:07:30.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku juga menyukainya.\N{\i0}
Dialogue: 0,0:07:31.57,0:07:35.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Orang yang aku suka\Ndan hal yang aku suka itu sama.\N{\i0}
Dialogue: 0,0:07:41.83,0:07:43.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayangnya, aku tidak punya teh.
Dialogue: 0,0:07:43.88,0:07:45.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Air panas boleh?
Dialogue: 0,0:07:45.29,0:07:46.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh saja.
Dialogue: 0,0:07:46.75,0:07:48.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku makan dulu.
Dialogue: 0,0:07:55.47,0:07:57.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sikapnya sangat sempurna.\N{\i0}
Dialogue: 0,0:08:03.85,0:08:07.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aroma apel yang menyegarkan\Ndan rasa karamel yang pahit dan manis.\N{\i0}
Dialogue: 0,0:08:07.90,0:08:09.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Inilah kebahagiaan sejati.\N{\i0}
Dialogue: 0,0:08:23.08,0:08:24.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bersihkan piringnya dulu.
Dialogue: 0,0:08:24.87,0:08:25.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf merepotkanmu.
Dialogue: 0,0:08:34.26,0:08:37.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kalau ini terus berlanjut,\Naku akan kehabisan piring.\N{\i0}
Dialogue: 0,0:08:40.81,0:08:41.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Seharusnya di sana\N{\i0}
Dialogue: 0,0:08:41.93,0:08:45.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}ada beberapa piring yang Nenek pakai\Nselagi masih hidup.\N{\i0}
Dialogue: 0,0:08:52.90,0:08:53.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau yang mana?
Dialogue: 0,0:08:54.07,0:08:56.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak perlu khawatir tentangku.
Dialogue: 0,0:08:56.87,0:08:58.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kau mau yang mana?
Dialogue: 0,0:08:58.41,0:09:00.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Lebih mudah kalau meminta bantuannya.\N{\i0}
Dialogue: 0,0:09:00.54,0:09:03.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, bisa bukakan\Npintu di sebelah kiri?
Dialogue: 0,0:09:04.00,0:09:05.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:09:10.30,0:09:11.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minggir.
Dialogue: 0,0:09:11.34,0:09:14.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesuatu mungkin akan terjatuh dari situ,\Ndan kau bisa terluka.
Dialogue: 0,0:09:23.93,0:09:25.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luar biasa.
Dialogue: 0,0:09:25.52,0:09:28.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau harus belajar\Nuntuk membereskan barang-barangmu!
Dialogue: 0,0:09:28.90,0:09:30.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kau mau yang mana?
Dialogue: 0,0:09:30.69,0:09:32.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di dalam lemari.
Dialogue: 0,0:09:32.48,0:09:33.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada lebih banyak di dalamnya?
Dialogue: 0,0:09:33.82,0:09:35.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sentuh botol kecil itu.
Dialogue: 0,0:09:35.65,0:09:37.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hati-hati dengan kantong kertas itu.
Dialogue: 0,0:09:37.99,0:09:40.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ada barang miring di kiri belakang.\N- Aku angkat kau.
Dialogue: 0,0:09:45.29,0:09:47.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Yang mana?\N- Ini.
Dialogue: 0,0:09:50.42,0:09:51.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah mengambilnya.
Dialogue: 0,0:09:56.84,0:09:58.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berat badanmu belum bertambah.
Dialogue: 0,0:09:59.18,0:10:01.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Dia hanya mau memeriksaku?\N{\i0}
Dialogue: 0,0:10:01.30,0:10:04.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Meski dia menganggapku manusia,\Ntapi menurutnya aku bukan perempuan?\N{\i0}
Dialogue: 0,0:10:06.27,0:10:07.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah terlihat. Ini dia.
Dialogue: 0,0:10:08.19,0:10:09.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Warnanya indah.
Dialogue: 0,0:10:09.69,0:10:11.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang membuatnya pasti sangat ahli.
Dialogue: 0,0:10:11.94,0:10:13.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cantik, 'kan?
Dialogue: 0,0:10:13.65,0:10:15.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, gunakan piring ini khusus untukmu...
Dialogue: 0,0:10:18.11,0:10:19.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku terkejut.\N{\i0}
Dialogue: 0,0:10:20.03,0:10:23.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku tidak percaya aku mulai berharap\N{\i0}
Dialogue: 0,0:10:23.70,0:10:26.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Harij akan membawakanku\Nlebih banyak makanan.\N{\i0}
Dialogue: 0,0:10:27.58,0:10:28.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:10:28.83,0:10:30.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada apa-apa.
Dialogue: 0,0:10:30.71,0:10:32.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelanggan makin bertambah.
Dialogue: 0,0:10:32.46,0:10:34.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku harus menambahkan piring.
Dialogue: 0,0:10:36.01,0:10:37.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Inilah sebabnya aku benci cinta.\N{\i0}
Dialogue: 0,0:10:37.97,0:10:39.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Cinta membuatku merasa bodoh.\N{\i0}
Dialogue: 0,0:10:57.69,0:10:59.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang sedang kau lakukan?
Dialogue: 0,0:10:59.24,0:11:00.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak melihat wajahmu.
Dialogue: 0,0:11:00.53,0:11:03.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak. Aku memang tidak mau\Nmenunjukkannya.
Dialogue: 0,0:11:03.12,0:11:05.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau menjual barang\Ntanpa menunjukkan wajahmu?
Dialogue: 0,0:11:05.45,0:11:06.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:11:06.83,0:11:09.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Obat penyihir terbuat\Ndari misteri dan rahasia!
Dialogue: 0,0:11:09.46,0:11:12.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini juga merupakan langkah keamanan!
Dialogue: 0,0:11:12.46,0:11:13.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang tidak perlu.
Dialogue: 0,0:11:13.67,0:11:16.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Perlu! Sangat perlu!\N{\i0}
Dialogue: 0,0:11:16.17,0:11:18.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ketika kau ada,\Naku harus menjadi seperti ini!\N{\i0}
Dialogue: 0,0:11:18.92,0:11:21.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau memberikan\Nbanyak perhatian kepadaku?
Dialogue: 0,0:11:21.55,0:11:22.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:11:22.97,0:11:26.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah semua orang tahu\Npenyihir tidak bisa berbohong?
Dialogue: 0,0:11:27.81,0:11:32.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, hanya aku yang bisa berbicara\Ndenganmu sambil menatap wajahmu.
Dialogue: 0,0:11:33.19,0:11:35.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya aku yang bisa kau ajak bicara
Dialogue: 0,0:11:35.32,0:11:39.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tentang hal-hal yang tidak mau kau katakan\Ndan menunjukkan reaksi yang jujur.
Dialogue: 0,0:11:39.69,0:11:41.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, sekarang semua itu\Ntidak diperlukan lagi.
Dialogue: 0,0:11:43.49,0:11:48.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mungkinkah dia mencoba menjadi\Nsatu-satunya teman bicaraku?\N{\i0}
Dialogue: 0,0:11:49.20,0:11:52.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu sebabnya dia ada di sini lagi\Nhari ini, tanpa alasan tertentu.\N{\i0}
Dialogue: 0,0:11:55.63,0:11:59.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dengan alasan yang sebagus itu,\Naku tidak bisa menolak.\N{\i0}
Dialogue: 0,0:12:01.93,0:12:03.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:12:06.47,0:12:11.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah lama tidak bicara dengan orang\Nsambil melihat wajah mereka seperti ini.
Dialogue: 0,0:12:11.64,0:12:13.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku minta maaf kalau aku kasar.
Dialogue: 0,0:12:16.73,0:12:19.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga, wajahmu sungguh imut.
Dialogue: 0,0:12:20.90,0:12:22.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak jadi!
Dialogue: 0,0:12:22.45,0:12:23.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf!
Dialogue: 0,0:12:23.49,0:12:27.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keponakanku sangat marah\Nkarena aku mengatakan ini!
Dialogue: 0,0:12:27.37,0:12:28.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bicara lagi.
Dialogue: 0,0:12:28.37,0:12:30.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak. Aku tidak mau membukanya lagi.
Dialogue: 0,0:12:30.29,0:12:32.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang salah. Maafkan aku!
Dialogue: 0,0:12:33.42,0:12:34.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Benci!\N{\i0}
Dialogue: 0,0:13:48.95,0:13:50.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah siap.
Dialogue: 0,0:13:52.58,0:13:57.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemarin, aku tidak menyangka\Nkau benar-benar membawakanku teh.
Dialogue: 0,0:13:57.42,0:13:59.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah berjanji, 'kan?
Dialogue: 0,0:13:59.08,0:14:00.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan datang besok.
Dialogue: 0,0:14:00.46,0:14:01.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:14:01.75,0:14:02.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak puas?
Dialogue: 0,0:14:02.71,0:14:04.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah menyerah.
Dialogue: 0,0:14:04.21,0:14:06.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya kau tidak menutupi kepalamu.
Dialogue: 0,0:14:06.76,0:14:09.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku masih merasa tidak aman.
Dialogue: 0,0:14:09.34,0:14:10.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Contohnya?
Dialogue: 0,0:14:11.18,0:14:12.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini rahasia penyihir.
Dialogue: 0,0:14:15.64,0:14:17.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku malu!\N{\i0}
Dialogue: 0,0:14:25.78,0:14:27.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baunya aneh.
Dialogue: 0,0:14:27.24,0:14:28.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini pertama kali\Naku meminumnya, enak juga.
Dialogue: 0,0:14:29.07,0:14:30.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama kali?
Dialogue: 0,0:14:30.32,0:14:31.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biasanya bagaimana rasanya?
Dialogue: 0,0:14:32.16,0:14:34.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku biasanya hanya minum teh.
Dialogue: 0,0:14:34.37,0:14:36.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa artinya minum tanpa rempah?
Dialogue: 0,0:14:36.83,0:14:39.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Ini pertama kalinya aku melihat\Nteh dimasak dalam panci.
Dialogue: 0,0:14:41.29,0:14:43.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutku teh ini cocok\Ndiminum dengan susu.
Dialogue: 0,0:14:43.84,0:14:44.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan membawanya nanti.
Dialogue: 0,0:14:45.42,0:14:46.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Susu, ya.
Dialogue: 0,0:14:49.38,0:14:50.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Lembut!\N{\i0}
Dialogue: 0,0:14:50.80,0:14:53.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Manisnya apel masuk ke dalam selai.\N{\i0}
Dialogue: 0,0:14:54.35,0:14:56.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cara makanmu kelihatannya enak.
Dialogue: 0,0:14:56.56,0:14:59.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada aturan untuk diet penyihir.
Dialogue: 0,0:14:59.98,0:15:03.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, kau harus makan\Nmakanan bergizi setiap hari.
Dialogue: 0,0:15:05.23,0:15:07.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanaman di ladang itu\Nkebanyakan tanaman obat?
Dialogue: 0,0:15:11.28,0:15:13.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanan apa yang selalu kau buat?
Dialogue: 0,0:15:14.70,0:15:18.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau selalu mencampurkan\Nobat yang mencurigakan?
Dialogue: 0,0:15:18.37,0:15:22.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Harij tahu tentang obat\Nyang mencurigakan itu.\N{\i0}
Dialogue: 0,0:15:23.00,0:15:26.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini termasuk "obat mengantuk",\N"obat memar",
Dialogue: 0,0:15:26.67,0:15:29.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan "obat kalau ada benda asing\Nmemasuki mata".
Dialogue: 0,0:15:29.97,0:15:32.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ada juga "obat untuk menjadi populer\Ndi kalangan gadis".\N{\i0}
Dialogue: 0,0:15:32.64,0:15:34.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun, aku tidak perlu mengatakannya.\N{\i0}
Dialogue: 0,0:15:34.55,0:15:37.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau juga membuat obat biasa.
Dialogue: 0,0:15:37.89,0:15:39.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada juga beberapa obat\Nyang kami gunakan di unit.
Dialogue: 0,0:15:40.39,0:15:41.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:15:42.44,0:15:48.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kalau obatku bisa menyembuhkan luka Harij,\Naku sudah senang.\N{\i0}
Dialogue: 0,0:15:49.65,0:15:53.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak salah,\Nkau juga menanam selada.
Dialogue: 0,0:15:54.53,0:15:56.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia ingat!\N{\i0}
Dialogue: 0,0:15:56.49,0:15:58.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selada bisa dijadikan obat?
Dialogue: 0,0:15:58.54,0:16:00.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku terkadang menggunakannya\Nuntuk menyejukkan badan.
Dialogue: 0,0:16:01.00,0:16:03.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, kami jarang sekali\Nmenjadikannya sebagai obat.
Dialogue: 0,0:16:03.42,0:16:04.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kenapa ditanam?
Dialogue: 0,0:16:04.75,0:16:06.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nenekku yang menyuruhku menanam selada.
Dialogue: 0,0:16:07.05,0:16:09.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nenekku adalah seorang penyihir\Ndan guruku.
Dialogue: 0,0:16:10.30,0:16:14.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ramuan obat yang langka\Njuga ditanam di ladang itu.
Dialogue: 0,0:16:14.30,0:16:18.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku diberi tahu sejak awal,\N"Apa pun yang terjadi, tetap seperti ini."
Dialogue: 0,0:16:19.18,0:16:21.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nenek sangat banyak mengoceh.
Dialogue: 0,0:16:25.36,0:16:26.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:16:26.73,0:16:27.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keluargamu yang lain?
Dialogue: 0,0:16:28.23,0:16:32.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibuku meninggal ketika aku masih kecil,
Dialogue: 0,0:16:32.45,0:16:34.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi aku tidak punya kenangan tentangnya.
Dialogue: 0,0:16:35.03,0:16:35.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu?
Dialogue: 0,0:16:36.03,0:16:38.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak yakin ayahku ada atau tidak.
Dialogue: 0,0:16:39.08,0:16:40.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pasti ada.
Dialogue: 0,0:16:41.04,0:16:43.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyihir tidak bisa tumbuh dari ladang.
Dialogue: 0,0:16:46.46,0:16:51.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nenekmu pasti khawatir denganmu\Nsetelah dia meninggal.
Dialogue: 0,0:16:52.67,0:16:55.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia khawatir kau tinggal sendirian.
Dialogue: 0,0:16:55.68,0:17:00.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau makan sesuka hatimu\Nsampai aku tak tega melihatnya.
Dialogue: 0,0:17:00.18,0:17:02.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat buruk seperti yang kau katakan?
Dialogue: 0,0:17:02.77,0:17:04.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku makan selada setiap hari dengan cukup.
Dialogue: 0,0:17:05.06,0:17:08.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak tahu bahwa makan selada\Nsetiap hari itu cukup.
Dialogue: 0,0:17:09.07,0:17:12.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menanam selada itu pasti rencana nenekmu.
Dialogue: 0,0:17:14.36,0:17:18.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pikir nenekmu sangat memahami sikapmu.
Dialogue: 0,0:17:18.74,0:17:19.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:17:20.58,0:17:22.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dia menyuruhmu\Nmemelihara tanaman herba,
Dialogue: 0,0:17:22.91,0:17:25.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau tidak punya pilihan\Nselain memelihara seladanya juga.
Dialogue: 0,0:17:25.62,0:17:29.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pasti berpikir sia-sia\Nkalau tidak makan selada itu.
Dialogue: 0,0:17:35.18,0:17:36.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Benar juga.\N{\i0}
Dialogue: 0,0:17:36.47,0:17:38.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku sudah berpikir\Nuntuk menjadikannya makanan.\N{\i0}
Dialogue: 0,0:17:44.10,0:17:46.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Setelah Nenek meninggal,\N{\i0}
Dialogue: 0,0:17:46.35,0:17:49.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}aku berpikir untuk hidup\Ndengan baik meski sendirian.\N{\i0}
Dialogue: 0,0:17:49.81,0:17:53.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun, menurutku masakanku tidak enak.\N{\i0}
Dialogue: 0,0:17:53.99,0:17:57.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Makan menjadi memberatkan\Nsampai aku membuat\N{\i0}
Dialogue: 0,0:17:57.32,0:17:59.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}"obat yang menahan rasa lapar".\N{\i0}
Dialogue: 0,0:17:59.91,0:18:01.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun,\N{\i0}
Dialogue: 0,0:18:01.16,0:18:03.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}aku menepati janjiku kepada Nenek\N{\i0}
Dialogue: 0,0:18:03.75,0:18:05.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dan mengusahakan ladang herba\Ndengan hati-hati.\N{\i0}
Dialogue: 0,0:18:06.87,0:18:09.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Selada selalu tumbuh lebih banyak,\Njadi aku mengambilnya.\N{\i0}
Dialogue: 0,0:18:09.54,0:18:12.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tidak ada maksud lain di baliknya.\N{\i0}
Dialogue: 0,0:18:12.96,0:18:17.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Nenek peduli kepadaku\Nlebih daripada yang aku bayangkan.\N{\i0}
Dialogue: 0,0:18:25.73,0:18:28.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Orang yang sadar\Nakan kasih sayang Nenek kepadaku\N{\i0}
Dialogue: 0,0:18:28.85,0:18:32.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}adalah Harij\Nkarena dia memikirkan hal itu.\N{\i0}
Dialogue: 0,0:18:34.44,0:18:35.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:18:36.44,0:18:38.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau harus berterima kasih kepada nenekmu.
Dialogue: 0,0:18:45.58,0:18:47.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah menduga, aku menyukainya.
Dialogue: 0,0:18:48.37,0:18:51.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti, 'kan? Karena roti ini enak.
Dialogue: 0,0:19:00.01,0:19:01.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ambillah.
Dialogue: 0,0:19:11.98,0:19:13.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau tambah lagi?
Dialogue: 0,0:19:14.52,0:19:15.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah menghabiskan yang ini.
Dialogue: 0,0:19:16.44,0:19:17.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:19:28.58,0:19:30.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagu ini masih tersimpan dalam ingatanku.
Dialogue: 0,0:19:30.92,0:19:33.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, hewan apa yang tidur?
Dialogue: 0,0:19:34.09,0:19:35.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ikan paus.
Dialogue: 0,0:19:35.63,0:19:39.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu, aku juga tidak tahu\Nberapa lama paus tidur.
Dialogue: 0,0:19:40.30,0:19:41.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga.
Dialogue: 0,0:19:41.22,0:19:43.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berapa banyak bahan\Nyang harus ditambahkan,
Dialogue: 0,0:19:43.26,0:19:46.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berapa banyak yang harus digiling,\Nberapa lama untuk merebus,
Dialogue: 0,0:19:46.77,0:19:50.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}seluruh proses pembuatan teh\Nada dalam irama lagu.
Dialogue: 0,0:19:50.23,0:19:51.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagu yang bagus.
Dialogue: 0,0:19:51.77,0:19:52.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:19:52.90,0:19:54.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah aku bernyanyi,
Dialogue: 0,0:19:54.40,0:19:57.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku bisa membuatnya kembali\Nrasa teh seperti buatan Nenek.
Dialogue: 0,0:19:57.40,0:19:58.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah nenekmu mengajarimu lagu ini?
Dialogue: 0,0:19:59.07,0:20:00.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin.
Dialogue: 0,0:20:00.24,0:20:02.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nenekku tidak suka bernyanyi.
Dialogue: 0,0:20:02.74,0:20:05.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, siapa yang mengajarimu lagu itu?
Dialogue: 0,0:20:11.37,0:20:13.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tumbuh besar\Ndengan mendengarkan lagu itu, 'kan?
Dialogue: 0,0:20:14.13,0:20:15.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:20:15.59,0:20:20.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku suka mendengar lagu ini\Ndengan suara panci mendidih.
Dialogue: 0,0:20:24.97,0:20:29.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Pasti ada seseorang yang bernyanyi\Nberulang kali di sampingmu.
Dialogue: 0,0:20:30.31,0:20:32.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Sampai kau bisa mengingatnya\Ndengan sempurna seperti ini.
Dialogue: 0,0:20:34.40,0:20:35.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Itu pasti...
Dialogue: 0,0:20:35.94,0:20:37.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tidak mungkin nenekmu.
Dialogue: 0,0:20:37.40,0:20:39.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tidak mungkin ayahmu\Nyang kau tidak tahu wujudnya.
Dialogue: 0,0:20:40.94,0:20:42.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu-satunya yang tersisa adalah...
Dialogue: 0,0:21:03.59,0:21:04.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu?
Dialogue: 0,0:21:06.14,0:21:08.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katamu kau tidak ingat apa-apa,
Dialogue: 0,0:21:08.30,0:21:10.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku masih mengingatmu\Ndengan baik, 'kan?
Dialogue: 0,0:21:16.90,0:21:20.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajah cemberutmu itu\Nrupanya hanya untuk menipu orang lain.
Dialogue: 0,0:21:22.78,0:21:24.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Penyihir tidak bisa berbohong.\N{\i0}
Dialogue: 0,0:21:25.36,0:21:29.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku takut diketahui,\Njadi aku menyembunyikan ekspresiku.\N{\i0}
Dialogue: 0,0:21:29.83,0:21:32.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Menyembunyikan kebenarannya\Nuntuk melindungi diriku sendiri.\N{\i0}
Dialogue: 0,0:21:34.25,0:21:35.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun...\N{\i0}
Dialogue: 0,0:21:35.75,0:21:36.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu juga benar.\N{\i0}
Dialogue: 0,0:21:37.50,0:21:40.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mustahil bagiku untuk menipunya lagi.\N{\i0}
Dialogue: 0,0:21:41.42,0:21:43.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Karena dia sudah mengetahui\Nrahasia penyihir.\N{\i0}
Dialogue: 0,0:21:44.01,0:21:47.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Meski begitu, dia tetap datang\Nuntuk berbicara denganku.\N{\i0}
Dialogue: 0,0:22:00.57,0:22:03.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku sangat senang sekarang.\N{\i0}
Dialogue: 0,0:23:37.95,0:23:39.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Terjemahan subtitle oleh Haseenah Musa
