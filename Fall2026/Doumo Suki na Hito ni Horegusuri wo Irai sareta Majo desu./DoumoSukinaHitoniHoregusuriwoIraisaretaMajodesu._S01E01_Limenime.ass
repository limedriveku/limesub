Dialogue: 0,0:02:41.24,0:02:43.70,sign,,0000,0000,0000,,MENGUNYAH
Dialogue: 0,0:22:04.53,0:22:10.03,sign,,0000,0000,0000,,{\an8}EPISODE 1: PENYIHIR DAN OBAT PENGASIH\NYANG MENGAKHIRI CINTA
Dialogue: 0,0:00:01.00,0:00:02.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Penyihir tidak bisa berbohong.\N{\i0}
Dialogue: 0,0:00:05.96,0:00:08.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu sebabnya para penyihir\Ntinggal jauh dari manusia\N{\i0}
Dialogue: 0,0:00:08.80,0:00:11.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dan hidup sebagai makhluk yang berbeda.\N{\i0}
Dialogue: 0,0:00:12.22,0:00:14.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku lahir dari seorang ibu\Nyang juga seorang penyihir,\N{\i0}
Dialogue: 0,0:00:14.59,0:00:16.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}jadi aku juga penyihir sejak lahir.\N{\i0}
Dialogue: 0,0:00:18.10,0:00:21.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ibuku meninggal ketika aku masih kecil,\Ndan aku tinggal bersama nenekku.\N{\i0}
Dialogue: 0,0:00:22.39,0:00:25.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun, nenekku juga meninggal\Nempat tahun lalu.\N{\i0}
Dialogue: 0,0:00:26.02,0:00:27.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kini aku sendirian.\N{\i0}
Dialogue: 0,0:00:30.07,0:00:32.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jauh di dalam hutan\Ndi pinggiran ibu kota kerajaan,\N{\i0}
Dialogue: 0,0:00:34.11,0:00:37.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}di pulau terpencil di tengah danau,\N{\i0}
Dialogue: 0,0:00:38.49,0:00:41.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}ada pertapaan seorang penyihir.\N{\i0}
Dialogue: 0,0:01:24.54,0:01:29.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Orang yang datang ke penginapanku\Nbiasanya mencari ramuan penyihir.\N{\i0}
Dialogue: 0,0:01:31.13,0:01:34.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mereka semua adalah orang\Nyang mencurigakan\N{\i0}
Dialogue: 0,0:01:34.17,0:01:37.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dan mau menyembunyikan\Nidentitas asli mereka.\N{\i0}
Dialogue: 0,0:01:38.01,0:01:40.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jadi, dengan kata lain...\N{\i0}
Dialogue: 0,0:01:42.81,0:01:44.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}mereka adalah tamu tidak diundang.\N{\i0}
Dialogue: 0,0:01:50.90,0:01:51.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf mengganggu.
Dialogue: 0,0:01:52.36,0:01:55.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah ini rumah Penyihir di Danau?
Dialogue: 0,0:01:56.44,0:01:57.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:01:58.07,0:01:59.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:01:59.24,0:02:01.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini adalah kediaman\NPenyihir "terbaik" di danau.
Dialogue: 0,0:02:03.54,0:02:05.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku punya permintaan.
Dialogue: 0,0:02:05.16,0:02:08.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Aku tak bisa mengungkapkan identitasku.\N{\i1}- Aku kenal dia.\N{\i0}
Dialogue: 0,0:02:09.04,0:02:10.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Harij Azm.\N{\i0}
Dialogue: 0,0:02:10.71,0:02:12.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kesatria elite di istana kerajaan.\N{\i0}
Dialogue: 0,0:02:16.84,0:02:19.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permintaan apa itu? Tuan?
Dialogue: 0,0:02:20.22,0:02:25.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Alangkah indahnya kalau aku bisa\Nmemanggil namanya saja, Tn. Harij.\N{\i0}
Dialogue: 0,0:02:28.27,0:02:30.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau membeli obat pengasih.
Dialogue: 0,0:02:34.07,0:02:36.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu maksudnya...
Dialogue: 0,0:02:45.54,0:02:49.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayangnya, aku kehabisan stok\Nobat pengasih untuk saat ini.
Dialogue: 0,0:02:49.29,0:02:50.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, buatlah lagi.
Dialogue: 0,0:02:53.63,0:02:54.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Habislah.\N{\i0}
Dialogue: 0,0:02:55.30,0:02:57.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku mungkin sudah melakukan kesalahan.\N{\i0}
Dialogue: 0,0:02:57.55,0:02:58.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, boleh.
Dialogue: 0,0:02:59.59,0:03:01.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, aku mau obatnya.
Dialogue: 0,0:03:01.22,0:03:04.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan mengumpulkan apa pun\Nyang diperlukan untuk membuat obat ini.
Dialogue: 0,0:03:05.06,0:03:06.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mahal harganya.
Dialogue: 0,0:03:06.64,0:03:08.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan membayar berapa pun harganya.
Dialogue: 0,0:03:08.18,0:03:10.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Prosesnya pun memakan waktu lama.
Dialogue: 0,0:03:11.48,0:03:12.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menunggu.
Dialogue: 0,0:03:20.11,0:03:21.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku minta maaf.
Dialogue: 0,0:03:21.65,0:03:23.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku punya alasan yang tidak bisa diubah.
Dialogue: 0,0:03:25.74,0:03:26.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti.
Dialogue: 0,0:03:27.04,0:03:29.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menulis bahan-bahan\Nyang diperlukan, harap tunggu.
Dialogue: 0,0:03:49.72,0:03:52.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisakah kau mengumpulkan bahan ini dulu?
Dialogue: 0,0:03:56.61,0:03:57.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:04:00.03,0:04:02.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Begitulah caranya penyihir ini...\N{\i0}
Dialogue: 0,0:04:02.95,0:04:05.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}mengalami patah hati akibat obat pengasih.\N{\i0}
Dialogue: 0,0:06:00.69,0:06:02.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada gunanya aku melakukan ini.
Dialogue: 0,0:06:09.86,0:06:11.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang.
Dialogue: 0,0:06:11.20,0:06:12.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah kau membawa semuanya?
Dialogue: 0,0:06:13.41,0:06:14.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:06:15.20,0:06:17.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar aku mengurus barang-barangmu.
Dialogue: 0,0:06:22.92,0:06:25.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang, izinkan aku\Nmemeriksa bahan-bahannya.
Dialogue: 0,0:06:26.01,0:06:30.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jantung tikus api yang mabuk\Nkarena jeritan kelelawar berjumbai.
Dialogue: 0,0:06:30.68,0:06:31.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:06:41.35,0:06:45.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, penyihir membuat obatnya\Ndi tempat seperti ini?
Dialogue: 0,0:06:45.90,0:06:46.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, benar.
Dialogue: 0,0:06:47.40,0:06:48.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:06:49.20,0:06:51.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Ini tidak salah lagi.
Dialogue: 0,0:06:51.53,0:06:54.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah lama tidak melihat\Nbahan seindah ini.
Dialogue: 0,0:06:56.16,0:06:57.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Akhirnya dengan ini...\N- Ya.
Dialogue: 0,0:06:58.00,0:06:59.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bisa mencari bahan selanjutnya.
Dialogue: 0,0:07:00.46,0:07:02.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Selanjutnya...\N- Ada lagi?
Dialogue: 0,0:07:03.29,0:07:04.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sudah berapa kali?
Dialogue: 0,0:07:04.96,0:07:07.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Serbuk sari dari bunga mekar\Ndi tebing curam,\N{\i0}
Dialogue: 0,0:07:07.88,0:07:10.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}tetesan air pertama dari langit!\N{\i0}
Dialogue: 0,0:07:10.63,0:07:12.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Akar tanaman obat\Nyang menjerit dengan keras!\N{\i0}
Dialogue: 0,0:07:13.55,0:07:15.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya sama sejak saat itu!
Dialogue: 0,0:07:15.14,0:07:17.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya adalah bahan\Nyang butuh waktu untuk ditemukan!
Dialogue: 0,0:07:18.14,0:07:20.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau tidak bilang sekaligus?
Dialogue: 0,0:07:20.60,0:07:23.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kau ahli farmasi kerajaan,\Nkau bisa dihukum!
Dialogue: 0,0:07:33.07,0:07:35.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku minta maaf karena meninggikan suaraku.
Dialogue: 0,0:07:35.62,0:07:37.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia pemarah, menakutkan,\N{\i0}
Dialogue: 0,0:07:38.04,0:07:39.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dan berbicara tanpa berpikir.\N{\i0}
Dialogue: 0,0:07:40.04,0:07:42.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun, suaranya sangat lembut.\N{\i0}
Dialogue: 0,0:07:42.79,0:07:44.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku minta maaf.
Dialogue: 0,0:07:46.25,0:07:47.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, aku merasa silau.
Dialogue: 0,0:07:49.13,0:07:51.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena wajah Tuan sangat tampan.
Dialogue: 0,0:07:53.09,0:07:54.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kau bicarakan?
Dialogue: 0,0:07:54.64,0:07:55.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti yang kau dengar.
Dialogue: 0,0:07:56.47,0:07:57.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak sanggup lagi.
Dialogue: 0,0:07:58.39,0:07:59.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ekspresi wajah ini juga bagus.\N{\i0}
Dialogue: 0,0:08:00.93,0:08:02.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia sangat tampan.\N{\i0}
Dialogue: 0,0:08:04.81,0:08:07.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, apa bahan setelahnya?
Dialogue: 0,0:08:08.07,0:08:09.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon tunggu sebentar.
Dialogue: 0,0:08:09.57,0:08:10.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menuliskan.
Dialogue: 0,0:08:10.99,0:08:12.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong tulis semuanya.
Dialogue: 0,0:08:14.49,0:08:18.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tuan Harij bukan hanya tidak tahu\Nkalau aku menyukainya,\N{\i0}
Dialogue: 0,0:08:19.29,0:08:21.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}tapi sepertinya dia juga tidak mengenalku.\N{\i0}
Dialogue: 0,0:08:23.08,0:08:27.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Hanya aku yang jatuh cinta kepadanya\Npada pandangan pertama sejak dulu.\N{\i0}
Dialogue: 0,0:08:27.75,0:08:29.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu saja.\N{\i0}
Dialogue: 0,0:08:30.01,0:08:33.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa yang bisa dilakukan penyihir\Nyang dikucilkan...\N{\i0}
Dialogue: 0,0:08:34.38,0:08:37.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}hanyalah mengulur waktu\Nsampai ramuan diserahkan.\N{\i0}
Dialogue: 0,0:08:39.64,0:08:41.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bahan selanjutnya.
Dialogue: 0,0:08:41.27,0:08:43.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Antena belalang pelangi.
Dialogue: 0,0:08:44.69,0:08:47.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pastikan kau mengambilnya\Npada malam bulan purnama.
Dialogue: 0,0:08:49.86,0:08:52.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bulan purnama baru minggu lalu, 'kan?
Dialogue: 0,0:08:52.90,0:08:53.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu benar.
Dialogue: 0,0:08:54.07,0:08:56.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak punya banyak waktu.
Dialogue: 0,0:08:58.53,0:09:01.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tidak bisa berbuat apa-apa\Njika kau tidak punya waktu.
Dialogue: 0,0:09:01.24,0:09:02.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sangat disayangkan.
Dialogue: 0,0:09:06.88,0:09:08.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa berbuat apa-apa?
Dialogue: 0,0:09:09.38,0:09:12.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia sangat terdesak\Nuntuk memenangkan hati orang itu.\N{\i0}
Dialogue: 0,0:09:14.38,0:09:15.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sia-sia!
Dialogue: 0,0:09:15.97,0:09:17.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:09:17.34,0:09:20.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lain kali tolong beri tahu aku\Njika kau mau mengeluh.
Dialogue: 0,0:09:21.85,0:09:24.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena keluhan lelaki tampan
Dialogue: 0,0:09:24.10,0:09:25.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa digunakan sebagai ramuan obat.
Dialogue: 0,0:09:27.27,0:09:28.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pasti tidak akan memberi tahu!
Dialogue: 0,0:09:40.53,0:09:43.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku bahkan tidak berharap kau menyukaiku.\N{\i0}
Dialogue: 0,0:09:44.83,0:09:47.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Hanya kalau kau bisa\Nmengingatku meski sedikit,\N{\i0}
Dialogue: 0,0:09:48.12,0:09:49.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}itu sudah cukup.\N{\i0}
Dialogue: 0,0:10:01.35,0:10:04.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh aneh melihatmu menguap.
Dialogue: 0,0:10:04.14,0:10:04.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:10:05.27,0:10:06.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ambillah.
Dialogue: 0,0:10:06.43,0:10:07.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:10:07.89,0:10:09.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak cukup tidur tadi malam.
Dialogue: 0,0:10:09.94,0:10:12.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Kau pergi bermain pada malam hari?
Dialogue: 0,0:10:12.77,0:10:15.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Itu bukan sifatmu...\N- Ya.
Dialogue: 0,0:10:15.69,0:10:17.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah lama tidak keluar.
Dialogue: 0,0:10:18.15,0:10:21.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengejar belalang\Nsepanjang malam tadi malam.
Dialogue: 0,0:10:22.08,0:10:23.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belalang?
Dialogue: 0,0:10:23.62,0:10:27.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku gantung irisan bawang dan seharusnya\Nmenariknya setelah belalang menggigit.
Dialogue: 0,0:10:27.58,0:10:29.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, cukup sulit untuk memahami caranya.
Dialogue: 0,0:10:29.87,0:10:31.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harus berpikir mendalam.
Dialogue: 0,0:10:31.58,0:10:34.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya menyenangkan.
Dialogue: 0,0:10:34.38,0:10:35.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:10:35.46,0:10:37.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekali mencoba, kau akan ketagihan.
Dialogue: 0,0:10:37.92,0:10:39.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya seperti kembali ke masa kecil.
Dialogue: 0,0:10:40.93,0:10:41.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harij.
Dialogue: 0,0:10:41.97,0:10:44.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa kalau mau mengejar serangga.
Dialogue: 0,0:10:44.18,0:10:47.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, menurutmu tidak ada hal lain\Nyang harus kau kejar?
Dialogue: 0,0:10:47.98,0:10:49.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hal lain yang harus aku kejar?
Dialogue: 0,0:10:50.98,0:10:51.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penjahat?
Dialogue: 0,0:10:52.06,0:10:52.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan!
Dialogue: 0,0:10:52.98,0:10:56.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam hal tugas kita sebagai kesatria,\Nitu tidak salah.
Dialogue: 0,0:10:56.19,0:10:57.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, bukan.
Dialogue: 0,0:10:58.70,0:10:59.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harij.
Dialogue: 0,0:10:59.78,0:11:01.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang perlu kau kejar...
Dialogue: 0,0:11:02.87,0:11:04.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah kebahagiaan.
Dialogue: 0,0:11:08.54,0:11:10.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada orang yang kau suka?
Dialogue: 0,0:11:10.33,0:11:12.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau seperti orang tuaku di desa.
Dialogue: 0,0:11:12.71,0:11:16.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, kalau kau sangat sibuk bekerja,\Nmemang sulit mencari calon.
Dialogue: 0,0:11:17.26,0:11:18.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada.
Dialogue: 0,0:11:18.38,0:11:19.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga.
Dialogue: 0,0:11:24.55,0:11:25.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada.
Dialogue: 0,0:11:48.75,0:11:49.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hai, Rose.
Dialogue: 0,0:11:50.41,0:11:52.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga, Tien rupanya.
Dialogue: 0,0:11:55.84,0:11:57.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namanya Tien Con.\N{\i0}
Dialogue: 0,0:11:57.88,0:12:00.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia adalah saudagar\Nyang sudah lama kami kenal\N{\i0}
Dialogue: 0,0:12:00.34,0:12:01.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}sejak nenekku masih hidup.\N{\i0}
Dialogue: 0,0:12:03.51,0:12:05.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak mendengar suara lonceng?
Dialogue: 0,0:12:05.72,0:12:07.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aneh.
Dialogue: 0,0:12:07.26,0:12:08.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dengar.
Dialogue: 0,0:12:08.47,0:12:10.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, tadi sangat gelap,\Naku tidak bisa melihat.
Dialogue: 0,0:12:10.73,0:12:14.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, lonceng ajaib warisan leluhurku\Ntidak terlalu hebat, ya?
Dialogue: 0,0:12:15.36,0:12:19.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, lonceng ini berguna\Nuntuk mendeteksi orang di dermaga.
Dialogue: 0,0:12:20.28,0:12:23.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau telah bekerja keras\Nmenghasilkan banyak obat.
Dialogue: 0,0:12:23.70,0:12:25.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita periksa sekarang.
Dialogue: 0,0:12:26.49,0:12:28.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Obat yang menjadi hangat ketika digosok.
Dialogue: 0,0:12:29.33,0:12:32.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Obat terlihat muda ketika dipakaikan\Npada rambut dan dibiarkan beberapa saat.
Dialogue: 0,0:12:33.21,0:12:36.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Juga obat untuk menghilangkan\Nkotoran periuk yang membandel.
Dialogue: 0,0:12:36.38,0:12:37.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, tidak salah lagi.
Dialogue: 0,0:12:38.55,0:12:40.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu warna yang bagus!
Dialogue: 0,0:12:41.09,0:12:42.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau luar biasa, Rose!
Dialogue: 0,0:12:42.88,0:12:44.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:12:44.13,0:12:48.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan hanya pandai membuat ramuan rahasia,\NRose juga pandai membuat obat sehari-hari.
Dialogue: 0,0:12:49.64,0:12:51.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa pun bisa melakukannya\Nkalau hanya ini.
Dialogue: 0,0:12:52.27,0:12:54.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin semua orang\Nbisa melakukannya.
Dialogue: 0,0:12:55.10,0:12:56.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyihir hanya lahir dari penyihir.
Dialogue: 0,0:12:57.48,0:12:59.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keberadaan mereka sangat berharga.
Dialogue: 0,0:12:59.65,0:13:00.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada zaman sekarang ini,
Dialogue: 0,0:13:00.78,0:13:03.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak banyak penyihir\Nyang memiliki kekuatan seperti itu.
Dialogue: 0,0:13:04.24,0:13:07.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku rasa Rose harus lebih percaya diri.
Dialogue: 0,0:13:07.91,0:13:09.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bukan tentang kepercayaan diri.
Dialogue: 0,0:13:10.37,0:13:12.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah melakukan pekerjaan ini\Nselama empat tahun.
Dialogue: 0,0:13:15.21,0:13:16.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah empat tahun?
Dialogue: 0,0:13:16.75,0:13:18.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu berlalu dengan sangat cepat.
Dialogue: 0,0:13:19.25,0:13:20.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:13:22.09,0:13:23.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah dewasa.
Dialogue: 0,0:13:24.42,0:13:27.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rose dulu sekecil ini.
Dialogue: 0,0:13:27.30,0:13:29.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin aku sekecil itu.
Dialogue: 0,0:13:29.68,0:13:30.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar?
Dialogue: 0,0:13:31.22,0:13:32.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pertama kali kita bertemu,\N{\i0}
Dialogue: 0,0:13:32.52,0:13:34.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}kau bersembunyi di balik rok,\N{\i0}
Dialogue: 0,0:13:34.81,0:13:36.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}jadi aku tidak melihat dengan jelas.\N{\i0}
Dialogue: 0,0:13:36.90,0:13:38.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong lupakan.
Dialogue: 0,0:13:40.32,0:13:44.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, itu saja\Nuntuk pengantaran kali ini.
Dialogue: 0,0:13:44.24,0:13:46.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengantaran setelah ini\Nkurang lebih seperti ini.
Dialogue: 0,0:13:48.20,0:13:50.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak juga, seperti dugaan.
Dialogue: 0,0:13:50.41,0:13:52.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya adalah obat sehari-hari.
Dialogue: 0,0:13:52.70,0:13:54.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tidak bisa melakukan apa-apa.
Dialogue: 0,0:13:55.00,0:13:57.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Obat penyihir Rose berkualitas tinggi
Dialogue: 0,0:13:57.42,0:13:59.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan mungkin memiliki\Npermintaan yang tinggi.
Dialogue: 0,0:13:59.42,0:14:01.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, bahannya terlalu mahal.
Dialogue: 0,0:14:01.54,0:14:03.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami tidak bisa menjual banyak.
Dialogue: 0,0:14:03.71,0:14:08.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku perlu membuat banyak\Nobat harian untuk mencari nafkah, 'kan?
Dialogue: 0,0:14:08.30,0:14:09.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:14:09.64,0:14:11.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu aku tahu.
Dialogue: 0,0:14:12.06,0:14:14.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cara lainnya\Nadalah dengan menaikkan harga.
Dialogue: 0,0:14:14.64,0:14:16.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Harga?\N- Ya.
Dialogue: 0,0:14:16.48,0:14:17.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tahu produk yang paling laris\Nakhir-akhir ini?
Dialogue: 0,0:14:18.06,0:14:20.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Obat yang ditabur di leher\Nsebelum kencan" itu?
Dialogue: 0,0:14:21.94,0:14:23.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, yang ini?
Dialogue: 0,0:14:23.48,0:14:24.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau pendapatmu.
Dialogue: 0,0:14:24.90,0:14:26.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau mengganti botolnya.
Dialogue: 0,0:14:27.90,0:14:32.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena obat ini sangat populer\Ndi kalangan gadis,
Dialogue: 0,0:14:32.24,0:14:33.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau kita memakai wadah yang lucu,
Dialogue: 0,0:14:34.04,0:14:36.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku rasa itu masih laku\Nmeski harganya naik.
Dialogue: 0,0:14:37.16,0:14:38.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh...
Dialogue: 0,0:14:38.83,0:14:40.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Contohnya. Mari kita lihat.
Dialogue: 0,0:14:41.67,0:14:43.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau menggunakan wadah ini?
Dialogue: 0,0:14:43.96,0:14:45.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak keberatan.
Dialogue: 0,0:14:46.21,0:14:47.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar?
Dialogue: 0,0:14:47.26,0:14:51.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, "obat yang dioleskan di leher\Nsebelum kencan" memakai botol ini.
Dialogue: 0,0:14:51.09,0:14:52.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namanya panjang.
Dialogue: 0,0:14:52.30,0:14:54.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak mau menamai obat ini?
Dialogue: 0,0:14:54.43,0:14:56.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekalian kita ganti botolnya.
Dialogue: 0,0:14:56.52,0:14:57.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:14:57.81,0:15:00.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak paham tentang itu,\Njadi tidak apa-apa.
Dialogue: 0,0:15:00.56,0:15:01.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga tidak tertarik.
Dialogue: 0,0:15:01.98,0:15:03.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak tertarik?
Dialogue: 0,0:15:04.02,0:15:05.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sudah pandai menjawab.
Dialogue: 0,0:15:05.90,0:15:08.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia dulu sangat manis.
Dialogue: 0,0:15:08.32,0:15:10.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Tien merasa sedih sekali.
Dialogue: 0,0:15:11.03,0:15:13.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Usiamu sudah tidak layak disebut kakak.
Dialogue: 0,0:15:13.37,0:15:15.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perbedaan usia kita\Nlebih dari sepuluh tahun.
Dialogue: 0,0:15:15.20,0:15:16.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau itu paman.
Dialogue: 0,0:15:16.75,0:15:18.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paman?
Dialogue: 0,0:15:18.58,0:15:20.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu juga boleh.
Dialogue: 0,0:15:24.42,0:15:27.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, Paman Tien pulang dulu.
Dialogue: 0,0:15:27.76,0:15:29.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paman akan segera kembali!
Dialogue: 0,0:15:29.72,0:15:31.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:15:31.09,0:15:33.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan selalu menjawab.
Dialogue: 0,0:15:33.43,0:15:34.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berisik.
Dialogue: 0,0:15:38.89,0:15:40.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku memang menjawab.\N{\i0}
Dialogue: 0,0:15:41.06,0:15:42.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Beberapa hari yang lalu,\N{\i0}
Dialogue: 0,0:15:42.15,0:15:45.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}orang yang aku suka dalam diam\Nselama empat tahun datang menemuiku.\N{\i0}
Dialogue: 0,0:15:46.44,0:15:49.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku membuat obat pengasih\Nuntuk orang yang aku cintai.\N{\i0}
Dialogue: 0,0:16:00.58,0:16:02.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malah jatuh.
Dialogue: 0,0:16:02.58,0:16:03.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari bersihkan.
Dialogue: 0,0:16:09.59,0:16:10.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini?
Dialogue: 0,0:16:15.05,0:16:17.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tepat setelah kematian nenekku,\N{\i0}
Dialogue: 0,0:16:18.47,0:16:20.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}aku kehabisan bahan untuk ramuanku.\N{\i0}
Dialogue: 0,0:16:20.60,0:16:23.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu adalah pertama kalinya\Naku ke ibu kota sendirian.\N{\i0}
Dialogue: 0,0:16:24.65,0:16:27.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku selalu dibawa ke sini oleh nenekku.\N{\i0}
Dialogue: 0,0:16:27.52,0:16:30.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jadi, aku tidak tahu toko\Nyang biasanya nenekku kunjungi.\N{\i0}
Dialogue: 0,0:16:30.82,0:16:33.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong tunjukkan semuanya.
Dialogue: 0,0:16:35.53,0:16:38.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku sama sekali tidak sempat\Nmerasakan keseruan ibu kota.\N{\i0}
Dialogue: 0,0:16:44.33,0:16:46.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Warga kota yang penuh gaya...\N{\i0}
Dialogue: 0,0:16:46.92,0:16:49.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}hanya membuatku merasa sedih\Ndengan keadaanku.\N{\i0}
Dialogue: 0,0:16:51.80,0:16:53.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kau tahu?
Dialogue: 0,0:16:53.34,0:16:55.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyihir Danau sudah meninggal.
Dialogue: 0,0:16:56.85,0:16:58.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:16:58.30,0:17:01.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nenek tua itu sudah ada\Nsejak aku masih kecil.
Dialogue: 0,0:17:01.31,0:17:03.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya dia berusia 200 tahun?
Dialogue: 0,0:17:03.31,0:17:07.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benar-benar berpikir\Ndia akan hidup selama 100 tahun lagi.
Dialogue: 0,0:17:07.94,0:17:08.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tidak.\N{\i0}
Dialogue: 0,0:17:09.07,0:17:11.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Nenek tidak hidup selama 200 tahun.\N{\i0}
Dialogue: 0,0:17:11.53,0:17:13.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kalau seperti itu,\Nnenekku seusia dengan leluhurku.\N{\i0}
Dialogue: 0,0:17:14.03,0:17:17.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku harus memperbaikinya demi nenekku.\N{\i0}
Dialogue: 0,0:17:17.66,0:17:20.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimanapun,\Nsekarang kita bisa bersantai!
Dialogue: 0,0:17:22.16,0:17:24.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bersantai? Kenapa?\N{\i0}
Dialogue: 0,0:17:24.16,0:17:27.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tahu penyihir itu datang saja\Nmembuatku merasa khawatir.
Dialogue: 0,0:17:27.42,0:17:30.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka berusaha menghindar\Nagar tidak terlihat.
Dialogue: 0,0:17:30.17,0:17:32.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti karena mereka melakukan\Nhal yang salah.
Dialogue: 0,0:17:32.63,0:17:33.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:17:34.01,0:17:36.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, mereka pergi ke kota\Ndengan wajah tenang.
Dialogue: 0,0:17:36.93,0:17:37.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menakutkan.
Dialogue: 0,0:17:38.05,0:17:39.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana jika seorang anak diculik?
Dialogue: 0,0:17:39.89,0:17:41.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu juga ada?
Dialogue: 0,0:17:41.43,0:17:45.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tahu, dulu ada seseorang hilang.
Dialogue: 0,0:17:45.69,0:17:48.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, itu pasti kejahatan penyihir.
Dialogue: 0,0:17:50.15,0:17:53.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, kini kita tidak perlu\Nkhawatir lagi!
Dialogue: 0,0:17:53.74,0:17:55.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untunglah!
Dialogue: 0,0:17:56.07,0:17:57.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pada waktu itu,\N{\i0}
Dialogue: 0,0:17:57.24,0:17:59.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}itulah pertama kalinya aku mengetahuinya.\N{\i0}
Dialogue: 0,0:17:59.24,0:18:02.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Para penyihir sangat dibenci\Nsampai kematian mereka dirayakan.\N{\i0}
Dialogue: 0,0:18:03.08,0:18:04.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Nenekku juga pasti tahu.\N{\i0}
Dialogue: 0,0:18:05.37,0:18:09.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mungkin nenekku menanggung\Nsemuanya sendirian.\N{\i0}
Dialogue: 0,0:18:09.83,0:18:11.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dari kejahatan ini.\N{\i0}
Dialogue: 0,0:18:11.21,0:18:13.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, minum untuk merayakan\Nkematian penyihir!
Dialogue: 0,0:18:14.46,0:18:16.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya salah kalau minum, 'kan?
Dialogue: 0,0:18:16.38,0:18:19.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa. Akhirnya kita merasa aman.
Dialogue: 0,0:18:21.68,0:18:25.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedih rasanya kalau ada orang merasa lega\Nkarena orang lain yang meninggal.
Dialogue: 0,0:18:26.52,0:18:28.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tuan, bayarannya.\N- Baik.
Dialogue: 0,0:18:29.10,0:18:30.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan orang, Kak.
Dialogue: 0,0:18:30.73,0:18:32.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang meninggal adalah penyihir.
Dialogue: 0,0:18:32.86,0:18:33.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lantas?
Dialogue: 0,0:18:34.44,0:18:35.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyihir juga manusia.
Dialogue: 0,0:18:36.53,0:18:39.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyihir pernah melakukan kejahatan\Nkepada kalian semua?
Dialogue: 0,0:18:40.20,0:18:41.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:18:41.62,0:18:42.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun...
Dialogue: 0,0:18:43.03,0:18:43.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:18:43.95,0:18:47.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku, aku akan menyumpahi siapa pun\Nyang bersukacita ketika aku meninggal.
Dialogue: 0,0:18:50.08,0:18:52.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harap dia penyihir yang baik.
Dialogue: 0,0:18:58.05,0:18:59.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hai, Harij!
Dialogue: 0,0:18:59.51,0:19:00.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesatria Azm.
Dialogue: 0,0:19:00.76,0:19:01.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu!
Dialogue: 0,0:19:03.72,0:19:07.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jubah biru itu. Dia seorang kesatria?
Dialogue: 0,0:19:07.27,0:19:08.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namanya Azm.
Dialogue: 0,0:19:08.77,0:19:11.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Hyzran punya nama yang sama, 'kan?
Dialogue: 0,0:19:11.31,0:19:13.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak membuatnya marah, 'kan?
Dialogue: 0,0:19:13.27,0:19:14.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita semua tidak ada hubungannya.
Dialogue: 0,0:19:15.82,0:19:17.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harij Azm...
Dialogue: 0,0:19:18.78,0:19:21.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku jatuh cinta pada hari itu.\N{\i0}
Dialogue: 0,0:19:22.74,0:19:26.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Meski aku tahu dia manusia\Nyang tidak bisa aku gapai.\N{\i0}
Dialogue: 0,0:19:35.84,0:19:37.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bunyi lonceng!
Dialogue: 0,0:19:38.17,0:19:39.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sakit!
Dialogue: 0,0:20:11.04,0:20:12.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bermaksud apa-apa.
Dialogue: 0,0:20:21.72,0:20:23.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bermaksud apa-apa.
Dialogue: 0,0:20:28.72,0:20:29.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bohong!
Dialogue: 0,0:20:30.52,0:20:32.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kalau Tn. Harij datang sekarang...\N{\i0}
Dialogue: 0,0:20:33.98,0:20:37.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tidak mungkin, sebelum ini,\Ndia hanya datang pada malam hari.\N{\i0}
Dialogue: 0,0:20:37.69,0:20:39.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun, bagaimana kalau dia datang?\N{\i0}
Dialogue: 0,0:20:52.79,0:20:53.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya aku peduli kepadanya!
Dialogue: 0,0:20:54.00,0:20:56.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sama sekali tidak peduli kepadanya!
Dialogue: 0,0:20:56.63,0:20:58.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar! Aku sama sekali\Ntidak bermaksud apa-apa!
Dialogue: 0,0:21:04.47,0:21:06.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Rasa lelah yang aneh.\N{\i0}
Dialogue: 0,0:21:06.89,0:21:10.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku tidak terbiasa\Nmerasakan emosi seperti ini.\N{\i0}
Dialogue: 0,0:21:11.64,0:21:13.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku selalu sendirian.\N{\i0}
Dialogue: 0,0:21:14.06,0:21:17.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kehidupanku juga hanyalah pengulangan\Nhal yang sama.\N{\i0}
Dialogue: 0,0:21:17.86,0:21:20.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Perasaan cinta yang dipendam\Nsejak empat tahun lalu.\N{\i0}
Dialogue: 0,0:21:20.57,0:21:23.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Terkadang aku keluar\Ndan melihatnya dari jauh,\N{\i0}
Dialogue: 0,0:21:24.24,0:21:26.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dan mengingatnya sebagai kenangan indah.\N{\i0}
Dialogue: 0,0:21:28.03,0:21:29.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Seharusnya begitu.\N{\i0}
Dialogue: 0,0:21:29.99,0:21:31.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Setiap kali lonceng berbunyi,\N{\i0}
Dialogue: 0,0:21:31.87,0:21:33.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}jantungku berdebar kencang.\N{\i0}
Dialogue: 0,0:21:33.91,0:21:35.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Lalu, aku menjadi takut.\N{\i0}
Dialogue: 0,0:21:36.46,0:21:40.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun, Tn. Harij bukan datang\Nuntuk menemui "aku".\N{\i0}
Dialogue: 0,0:21:42.13,0:21:43.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia datang untuk menemui "penyihir".\N{\i0}
Dialogue: 0,0:21:45.72,0:21:50.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku perlu memahami itu dengan lebih jelas.
Dialogue: 0,0:21:51.43,0:21:53.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku sudah mengetahui kebenarannya\Nsejak lama.\N{\i0}
Dialogue: 0,0:21:54.52,0:21:57.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Meski cintaku bertepuk sebelah tangan,\N{\i0}
Dialogue: 0,0:21:58.27,0:21:59.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}itu bukan masalah.\N{\i0}
Dialogue: 0,0:21:59.86,0:22:01.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku mencoba mengatakan tidak apa-apa.\N{\i0}
Dialogue: 0,0:22:02.36,0:22:03.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kalau bisa, baguslah, tapi...\N{\i0}
Dialogue: 0,0:22:05.11,0:22:08.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}aku juga tidak bisa\Nmembodohi diriku sendiri.\N{\i0}
Dialogue: 0,0:23:38.00,0:23:40.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Terjemahan subtitle oleh Haseenah Musa
