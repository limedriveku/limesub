Dialogue: 0,0:00:44.41,0:00:46.12,Dialog,BILLAURA,0,0,0,,Payungnya tidak diperlukan.
Dialogue: 0,0:00:46.12,0:00:48.18,Dialog,BILLAURA,0,0,0,,Batalkan pengamatan\Ndi kota sekitar kastel.
Dialogue: 0,0:00:48.18,0:00:51.09,Dialog,BILLAURA,0,0,0,,Sebagai gantinya, cari tahu apakah\NProfesor Marshall punya waktu luang.
Dialogue: 0,0:00:51.09,0:00:52.18,Dialog,MAID A,0,0,0,,Baik, Yang Mulia.
Dialogue: 0,0:00:52.18,0:00:57.39,Dialog,BILLAURA,0,0,0,,Sepertinya Nona Kosmas dari Nefrit\Nakan menghadiri jamuan malam ini.
Dialogue: 0,0:00:57.39,0:00:59.99,Dialog,BILLAURA,0,0,0,,Tanah kelahirannya Crielune, bukan?
Dialogue: 0,0:00:59.99,0:01:02.95,Dialog,BILLAURA,0,0,0,,Aku ingin mempelajari kembali sejarah\Nwilayah itu.
Dialogue: 0,0:01:04.11,0:01:05.43,Dialog,MAID A,0,0,0,,Dimengerti.
Dialogue: 0,0:01:07.06,0:01:08.82,Dialog,BILLAURA,0,0,0,,Di mana orkestra untuk hari ini?
Dialogue: 0,0:01:08.82,0:01:10.45,Dialog,BILLAURA,0,0,0,,Kita akan mengubah susunan acaranya.
Dialogue: 0,0:01:10.45,0:01:11.78,Dialog,MAID B,0,0,0,,Akan kusuruh\N mereka mempersiapkannya.
Dialogue: 0,0:01:11.78,0:01:17.34,Dialog,BILLAURA,0,0,0,,Tolong minta kepala koki menyajikan\Nsetidaknya satu hidangan khas Crielune.
Dialogue: 0,0:01:17.34,0:01:19.00,Dialog,MAID C,0,0,0,,Tentu.
Dialogue: 0,0:01:19.00,0:01:22.92,Dialog,BILLAURA,0,0,0,,Dia mungkin kesal karena kita memintanya\Nmendadak, tapi aku mengandalkanmu.
Dialogue: 0,0:01:23.20,0:01:24.62,Dialog,MAIDS,0,0,0,,Dimengerti.
Dialogue: 0,0:01:27.19,0:01:29.63,Dialog,BILLAURA,0,0,0,,Aku juga ingin menyiapkan beberapa\Ntopik pembicaraan sebelumnya.
Dialogue: 0,0:01:29.63,0:01:32.58,Dialog,BILLAURA,0,0,0,,Apa ada yang mengetahui keadaan terkini\Ndi Crielune?
Dialogue: 0,0:01:32.58,0:01:36.56,Dialog,MAID B,0,0,0,,Adik perempuan Nona Marmara menikah\Ndengan keluarga dari Crielune.
Dialogue: 0,0:01:36.56,0:01:41.04,Dialog,BILLAURA,0,0,0,,Kalau begitu, tolong tanyakan kepada Nona Marmara\Napakah beliau bisa meluangkan waktu untukku.
Dialogue: 0,0:01:41.04,0:01:42.35,Dialog,MAID B,0,0,0,,Dimengerti.
Dialogue: 0,0:01:43.94,0:01:46.56,Dialog,BILLAURA,0,0,0,,Oh, Profesor Marshall.
Dialogue: 0,0:01:47.94,0:01:50.85,Dialog,BILLAURA,0,0,0,,Maaf sudah memanggil Anda\Nsaat waktu istirahat.
Dialogue: 0,0:01:50.85,0:01:51.89,Dialog,MARSHALL,0,0,0,,Tidak perlu meminta maaf.
Dialogue: 0,0:01:52.14,0:01:56.48,Dialog,MARSHALL,0,0,0,,Aku baru saja bersyukur kepada Tuhan karena\Ndikaruniai murid yang begitu rajin belajar.
Dialogue: 0,0:01:56.48,0:01:58.81,Dialog,MAID C,0,0,0,,Putri Billaura, pakaian Anda.
Dialogue: 0,0:01:58.81,0:02:01.70,Dialog,BILLAURA,0,0,0,,Ya. Sampai nanti.
Dialogue: 0,0:02:21.19,0:02:24.93,Dialog,HARIJ-Internal,0,0,0,,Percuma saja menyimpan perasaan seperti itu\Nkepadanya, tapi kau tetap saja...
Dialogue: 0,0:02:26.42,0:02:31.27,Dialog,HARIJ-Internal,0,0,0,,Bagaimanapun, Putri Billaura akan menikah\N\ndua bulan lagi.
Dialogue: 0,0:02:43.04,0:02:48.08,Dialog,SIGN,0,0,0,,{\fad(2500,1000)}Halo, aku seorang {\fs35\c&HFABB4F&}P{\c&HD99F7B&}e{\c&H C88498&}n{\c&HB279B9&}y{\c&H8C65FB&}i{\c&H8C65FB&}h{\c&H8C65FB&}i{\c&H8C65FB&}r
Dialogue: 0,0:02:43.04,0:02:48.08,Dialog,SIGN,0,0,0,,{\fad(2500,1000)}dan orang yang {\fs46}kusukai {\fs40}ingin aku membuatkan {\fs46\c&H7E42E6&}Ramuan Cinta
Dialogue: 0,0:04:09.36,0:04:11.21,Dialog,GEONES,0,0,0,,Selamat datang kembali, Harij.
Dialogue: 0,0:04:12.33,0:04:13.73,Dialog,HARIJ,0,0,0,,Geones.
Dialogue: 0,0:04:14.04,0:04:19.51,Subtitle lain,SIGN,0,0,0,,{\fad(900,900)\pos(770,898)}Tugas Seorang Ksatria,\N Meski Tak Diketahui Sang Penyihir
Dialogue: 0,0:04:14.04,0:04:17.30,Dialog,GEONES,0,0,0,,{\an8}Kerja bagus. Akhirnya kau bisa\Nistirahat siang?
Dialogue: 0,0:04:17.30,0:04:20.66,Dialog,HARIJ,0,0,0,,{\an8}Ya, tapi ada tempat yang harus kudatangi\Nselagi ada waktu.
Dialogue: 0,0:04:20.66,0:04:22.01,Dialog,GEONES,0,0,0,,Tempat yang harus kau datangi?
Dialogue: 0,0:04:22.01,0:04:23.64,Dialog,HARIJ,0,0,0,,Aku mau pergi ke hutan.
Dialogue: 0,0:04:23.64,0:04:27.28,Dialog,HARIJ,0,0,0,,Tunggu, sebelum itu,\n\Naku harus mencari makanan dulu.
Dialogue: 0,0:04:27.28,0:04:29.72,Dialog,HARIJ,0,0,0,,Mungkin aku mampir ke kios makanan\Ndi kota terlebih dahulu.
Dialogue: 0,0:04:29.72,0:04:33.64,Dialog,GEONES,0,0,0,,Oh, begitu? Kau memang selalu\N\ngiat bekerja, ya.
Dialogue: 0,0:04:33.64,0:04:35.44,Dialog,HARIJ,0,0,0,,Bukan hal yang istimewa.
Dialogue: 0,0:04:35.44,0:04:38.38,Dialog,HARIJ,0,0,0,,Orang yang paling bekerja keras\n\Ndi sini bukan aku, melainkan—
Dialogue: 0,0:04:38.38,0:04:39.89,Dialog,GEONES,0,0,0,,Ini, seperti biasa.
Dialogue: 0,0:04:39.89,0:04:42.85,Dialog,GEONES,0,0,0,,Untuk mengisi kembali nutrisi\Nsaat kau kelelahan!
Dialogue: 0,0:04:44.05,0:04:45.75,Dialog,HARIJ,0,0,0,,Kau rekan kerja yang perhatian.
Dialogue: 0,0:04:46.13,0:04:51.13,Dialog,GEONES,0,0,0,,Putri Billaura menghabiskan pagi hari\ndi kediaman Nona Kvaravita, bukan?
Dialogue: 0,0:04:51.13,0:04:52.02,Dialog,HARIJ,0,0,0,,Ya.
Dialogue: 0,0:04:54.77,0:04:59.46,Dialog,LADY KVARAVITA,0,0,0,,Aduh, aduh. Silakan cicipi\n\Ntart lemon buatanku.
Dialogue: 0,0:04:59.46,0:05:01.98,Dialog,LADY KVARAVITA,0,0,0,,Oh, benar juga.\n\NMau dengar cerita ini?
Dialogue: 0,0:05:01.98,0:05:04.16,Dialog,LADY KVARAVITA,0,0,0,,Tadi malam cukup merepotkan,
Dialogue: 0,0:05:04.16,0:05:08.04,Dialog,LADY KVARAVITA,0,0,0,,Suamiku menghabiskan sebotol \Nanggur sendirian.
Dialogue: 0,0:05:08.04,0:05:10.35,Dialog,LADY KVARAVITA,0,0,0,,suasana hatinya \Nsedang bagus sekali,
Dialogue: 0,0:05:10.35,0:05:14.35,Dialog,LADY KVARAVITA,0,0,0,,sampai-sampai dia terus bercerita tentang\Nkehebatannya di masa muda.
Dialogue: 0,0:05:14.35,0:05:16.60,Dialog,LADY KVARAVITA,0,0,0,,Aduh, ceritanya panjang sekali.
Dialogue: 0,0:05:38.56,0:05:42.82,Dialog,GEONES,0,0,0,,Nona Kvaravita memang baik,\n\Ntapi ceritanya cenderung panjang.
Dialogue: 0,0:05:42.82,0:05:43.76,Dialog,HARIJ,0,0,0,,Ya.
Dialogue: 0,0:05:43.76,0:05:46.71,Dialog,HARIJ,0,0,0,,Jadi, itu sebabnya kau memberiku\Nramuan agar tetap terjaga.
Dialogue: 0,0:05:46.71,0:05:49.22,Dialog,HARIJ,0,0,0,,Namun, hari ini \Naku membawa kabar baik.
Dialogue: 0,0:05:49.22,0:05:50.18,Dialog,GEONES,0,0,0,,Apa itu?
Dialogue: 0,0:05:51.65,0:05:55.18,Dialog,HARIJ,0,0,0,,Di jamuan malam yang akan dihadiri\NPutri Billaura nanti...
Dialogue: 0,0:05:55.18,0:05:57.22,Dialog,GEONES,0,0,0,,Oh, yang di istana kerajaan itu.
Dialogue: 0,0:05:58.08,0:06:03.32,Dialog,HARIJ,0,0,0,,Kabarnya Nona Kosmas dari Nefrit\Nakan hadir.
Dialogue: 0,0:06:03.32,0:06:04.29,Dialog,GEONES,0,0,0,,Apa?
Dialogue: 0,0:06:04.29,0:06:07.31,Dialog,HARIJ,0,0,0,,Akan menguntungkan Putri Billaura,\Nyang akan menikah dengan keluarga kerajaan Nefrit,
Dialogue: 0,0:06:07.31,0:06:11.42,Dialog,HARIJ,0,0,0,,jika dia menjalin hubungan dekat\Ndengan para diplomat negara itu.
Dialogue: 0,0:06:11.42,0:06:15.10,Dialog,HARIJ,0,0,0,,Sepertinya jamuan malam ini adalah kesempatan\Nyang tepat untuk membangun hubungan tersebut.
Dialogue: 0,0:06:15.62,0:06:17.96,Dialog,GEONES,0,0,0,,Begitu, ya! Hmm?
Dialogue: 0,0:06:18.34,0:06:20.45,Dialog,GEONES,0,0,0,,Tapi tunggu, \Nkalau aku tidak salah ingat,
Dialogue: 0,0:06:20.45,0:06:24.79,Dialog,GEONES,0,0,0,,istri diplomat itu \Nterkenal sangat tertutup, bukan?
Dialogue: 0,0:06:24.79,0:06:28.79,Dialog,GEONES,0,0,0,,Kenapa dia sampai bersusah payah datang\Nke jamuan negara kita?
Dialogue: 0,0:06:28.79,0:06:30.33,Dialog,HARIJ,0,0,0,,Soal itu...
Dialogue: 0,0:06:32.71,0:06:36.03,Dialog,HARIJ,0,0,0,,Sepertinya Nona Kvaravita berhasil membujuknya\Nuntuk hadir.
Dialogue: 0,0:06:36.03,0:06:37.28,Dialog,GEONES,0,0,0,,Ah.
Dialogue: 0,0:06:37.28,0:06:40.98,Dialog,HARIJ,0,0,0,,Dia berusaha menunjukkan perhatian kepada Putri Billaura\Nkarena sang putri menikah di usia yang begitu muda.
Dialogue: 0,0:06:40.98,0:06:44.43,Dialog,GEONES,0,0,0,,Ternyata usaha Putri Billaura mendengarkan\Ncerita panjang Nona Kvaravita
Dialogue: 0,0:06:44.43,0:06:47.45,Dialog,GEONES,0,0,0,,tanpa sedikit pun menunjukkan rasa kesal\Nakhirnya membuahkan hasil!
Dialogue: 0,0:06:47.45,0:06:48.56,Dialog,HARIJ,0,0,0,,Ya.
Dialogue: 0,0:06:48.56,0:06:50.55,Dialog,HARIJ,0,0,0,,Putri Billaura\N berhasil menjalin hubungan itu
Dialogue: 0,0:06:50.55,0:06:53.50,Dialog,HARIJ,0,0,0,,berkat usahanya yang tak kenal lelah \Nmemakan\ndua potong
Dialogue: 0,0:06:53.50,0:06:55.99,Dialog,HARIJ,0,0,0,,pai lemon yang terlalu asam itu\Nsetiap kali berkunjung.
Dialogue: 0,0:06:59.25,0:07:00.67,Dialog,GEONES,0,0,0,,Harij...
Dialogue: 0,0:07:00.67,0:07:02.85,Dialog,GEONES,0,0,0,,Jangan bicara sembarangan.
Dialogue: 0,0:07:02.85,0:07:04.63,Dialog,HARIJ,0,0,0,,Kau sendiri\N yang mengatakannya duluan.
Dialogue: 0,0:07:08.73,0:07:10.56,Dialog,GEONES,0,0,0,,Ngomong-ngomong, \Ndi mana Putri Billaura?
Dialogue: 0,0:07:10.56,0:07:14.56,Dialog,GEONES,0,0,0,,Bukankah rencana sore ini adalah mengamati\Nkota sekitar kastel?
Dialogue: 0,0:07:14.56,0:07:16.49,Dialog,HARIJ,0,0,0,,Jadwalnya diundur ke hari lain.
Dialogue: 0,0:07:16.49,0:07:20.64,Dialog,GEONES,0,0,0,,Oh, acaranya molor gara-gara pai lemon\N\ndan obrolan panjang itu, ya?
Dialogue: 0,0:07:20.64,0:07:23.07,Dialog,HARIJ,0,0,0,,Yah, mungkin itu \Nsalah satu alasannya.
Dialogue: 0,0:07:23.51,0:07:26.66,Dialog,HARIJ,0,0,0,,Namun, begitu mendengar istri seorang diplomat\Ndari Nefrit akan hadir,
Dialogue: 0,0:07:26.66,0:07:29.74,Dialog,HARIJ,0,0,0,,dia langsung pergi belajar \Nbegitu kembali.
Dialogue: 0,0:07:29.74,0:07:32.91,Dialog,GEONES,0,0,0,,Itulah putri kita.\N Selalu mengagumkan.
Dialogue: 0,0:07:32.91,0:07:33.84,Dialog,HARIJ,0,0,0,,Ya.
Dialogue: 0,0:07:36.50,0:07:40.92,Dialog,HARIJ,0,0,0,,Akhir-akhir ini, dia tampak memaksakan diri\Nlebih keras dari biasanya, dan itu membuatku sedih.
Dialogue: 0,0:07:41.15,0:07:45.52,Dialog,HARIJ,0,0,0,,Nefrit memang kerajaan kuat yang sangat penting\Ndalam hubungan diplomatik dengan negara kita.
Dialogue: 0,0:07:49.68,0:07:51.54,Dialog,HARIJ,0,0,0,,Namun...
Dialogue: 0,0:07:52.38,0:07:55.39,Dialog,HARIJ,0,0,0,,Pria yang akan dinikahinya,\n\NRaja Nefrit, sudah tua,
Dialogue: 0,0:07:55.39,0:07:58.06,Dialog,HARIJ,0,0,0,,bahkan cucu-cucunya ada yang lebih tua\N\ndaripada Putri Billaura.
Dialogue: 0,0:08:00.02,0:08:01.97,Dialog,GEONES,0,0,0,,Cukup, Harij.
Dialogue: 0,0:08:08.50,0:08:11.10,Dialog,HARIJ-Internal,0,0,0,,Kerajaan Nefrit\N mengajukan tuntutan yang kejam.
Dialogue: 0,0:08:12.27,0:08:16.73,Dialog,HARIJ-Internal,0,0,0,,Sang raja menginginkan Putri Billaura,\nyang baru berusia 16 tahun, menjadi pasangannya.
Dialogue: 0,0:08:16.73,0:08:20.11,Dialog,HARIJ-Internal,0,0,0,,untuk memulai babak kedua hidupnya,\nsaat usianya sendiri hampir 60 tahun.
Dialogue: 0,0:08:21.16,0:08:24.63,Dialog,HARIJ-Internal,0,0,0,,Dalam sejarah panjang \Npernikahan kerajaan,
Dialogue: 0,0:08:24.63,0:08:27.11,Dialog,HARIJ-Internal,0,0,0,,pernikahan seperti itu tentu saja\Nsering terjadi.
Dialogue: 0,0:08:27.96,0:08:31.54,Dialog,HARIJ-Internal,0,0,0,,Meski begitu, sebagai orang yang selalu\Nmelayani dan melindungi Yang Mulia,
Dialogue: 0,0:08:32.01,0:08:34.87,Dialog,HARIJ-Internal,0,0,0,,aku berharap dia mendapatkan pernikahan\Nyang lebih bahagia daripada siapa pun.
Dialogue: 0,0:08:37.50,0:08:39.52,Dialog,GEONES,0,0,0,,Tinggal dua bulan lagi, ya...
Dialogue: 0,0:08:44.33,0:08:45.56,Dialog,HARIJ,0,0,0,,Benar.
Dialogue: 0,0:08:49.86,0:08:51.41,Dialog,HARIJ-Internal,0,0,0,,Dua bulan lagi.
Dialogue: 0,0:08:51.90,0:08:55.82,Dialog,HARIJ-Internal,0,0,0,,Aku harus mendapatkannya sebelum itu,\n\Napa pun yang terjadi.
Dialogue: 0,0:08:56.85,0:08:57.95,Dialog,BILLAURA {flashback},0,0,0,,Harij.
Dialogue: 0,0:08:58.40,0:09:01.55,Dialog,BILLAURA {flashback},0,0,0,,Maukah kau mendengarkan permintaanku,\nbukan sebagai perintah seorang putri,
Dialogue: 0,0:09:01.55,0:09:05.79,Dialog,BILLAURA {flashback},0,0,0,,melainkan sebagai permintaan egois dari Laura,\nyang menganggapmu seperti kakak sendiri?
Dialogue: 0,0:09:07.93,0:09:12.26,Dialog,HARIJ-Internal,0,0,0,,Aku harus mengabulkan permintaan egois pertama\ndan terakhir Putri Billaura.
Dialogue: 0,0:09:12.95,0:09:14.24,Dialog,HARIJ-Internal,0,0,0,,Aku harus mendapatkan ramuan cinta itu.
Dialogue: 0,0:09:29.53,0:09:30.60,Dialog,ROSE,0,0,0,,Hah?
Dialogue: 0,0:09:30.60,0:09:31.74,Dialog,ROSE,0,0,0,,Apa?
Dialogue: 0,0:09:31.74,0:09:33.94,Dialog,ROSE,0,0,0,,Dia benar-benar datang lagi hari ini?!
Dialogue: 0,0:09:33.94,0:09:36.18,Dialog,ROSE,0,0,0,,Sudah kubilang, \Nbukan hal mudah untuk membuatnya.
Dialogue: 0,0:09:36.18,0:09:38.81,Dialog,ROSE,0,0,0,,Memangnya seberapa terburu-buru\Nkesatria itu sampai terus mendesakku?
Dialogue: 0,0:09:41.79,0:09:44.56,Dialog,HARIJ {Flashback},0,0,0,,Seberapa banyak?
Dialogue: 0,0:09:44.56,0:09:47.08,Dialog,HARIJ {Flashback},0,0,0,,Sebanyak ini.
Dialogue: 0,0:09:55.45,0:09:56.54,Dialog,ROSE,0,0,0,,Yah...
Dialogue: 0,0:09:57.40,0:09:59.24,Dialog,ROSE,0,0,0,,Bukan berarti aku keberatan, sih.
Dialogue: 0,0:09:59.68,0:10:00.60,Dialog,ROSE,0,0,0,,Oh.
Dialogue: 0,0:10:05.52,0:10:06.74,Dialog,ROSE,0,0,0,,Baiklah.
Dialogue: 0,0:10:16.94,0:10:18.98,Dialog,HARIJ-Internal,0,0,0,,Perahu kecil yang \Nbiasa kugunakan tidak ada.
Dialogue: 0,0:10:21.16,0:10:23.46,Dialog,HARIJ-Internal,0,0,0,,Begitu, rupanya ada pelanggan lain.
Dialogue: 0,0:10:28.29,0:10:30.97,Dialog,TIEN,0,0,0,,Tempat ini rapi sekali hari ini, ya?
Dialogue: 0,0:10:30.97,0:10:32.25,Dialog,TIEN,0,0,0,,Ada apa?
Dialogue: 0,0:10:32.25,0:10:34.78,Dialog,ROSE,0,0,0,,Tidak. Aku cuma terlalu cepat \Nmengambil kesimpulan.
Dialogue: 0,0:10:35.47,0:10:36.67,Dialog,ROSE-Internal,0,0,0,,Benar juga...
Dialogue: 0,0:10:36.67,0:10:38.93,Dialog,ROSE-Internal,0,0,0,,Hari ini Tien\N memang akan datang.
Dialogue: 0,0:10:38.93,0:10:42.13,Dialog,TIEN,0,0,0,,Hmm, apa aku \Nsalah datang ke pertapaan?
Dialogue: 0,0:10:42.13,0:10:45.78,Dialog,ROSE,0,0,0,,Memangnya kau akan pergi ke pertapaan penyihir lain\nyang terpencil dan jauh dari keramaian
Dialogue: 0,0:10:45.78,0:10:47.98,Dialog,ROSE,0,0,0,,seperti tempat ini \Nuntuk mengisi persediaan,\nTien?
Dialogue: 0,0:10:47.98,0:10:50.85,Dialog,TIEN,0,0,0,,Lho, lho?\n\NKau cemburu, ya?
Dialogue: 0,0:10:52.43,0:10:54.27,Dialog,TIEN,0,0,0,,Meski begitu, aku terkejut.
Dialogue: 0,0:10:54.27,0:10:55.69,Dialog,TIEN,0,0,0,,Tak pernah kusangka \Nakan melihat hari
Dialogue: 0,0:10:55.69,0:10:59.54,Dialog,TIEN,0,0,0,,saat ruang untuk duduk\N di pertapaan ini\ndibersihkan lagi.
Dialogue: 0,0:10:59.89,0:11:02.36,Dialog,ROSE,0,0,0,,Aku cuma berubah pikiran, tahu!
Dialogue: 0,0:11:02.36,0:11:03.75,Dialog,ROSE,0,0,0,,Sudah, masuk saja.
Dialogue: 0,0:11:03.75,0:11:04.66,Dialog,ROSE,0,0,0,,Dingin.
Dialogue: 0,0:11:04.66,0:11:06.71,Dialog,TIEN,0,0,0,,Oh, maafkan aku.
Dialogue: 0,0:11:08.25,0:11:10.93,Dialog,TIEN,0,0,0,,Sekarang memang musim angin \Ndingin yang menusuk.
Dialogue: 0,0:11:11.33,0:11:13.55,Dialog,TIEN,0,0,0,,Musim gugur benar-benar \Nsudah tiba, ya?
Dialogue: 0,0:11:21.73,0:11:26.61,Dialog,ROSE-Internal,0,0,0,,Ternyata sudah selama itu sejak\NTuan Harij pertama kali datang ke sini, ya?
Dialogue: 0,0:11:29.38,0:11:31.50,Dialog,TIEN,0,0,0,,Sudah lama\N kita tak bertemu.
Dialogue: 0,0:11:31.50,0:11:33.32,Dialog,TIEN,0,0,0,,Semoga kesehatanmu baik-baik saja.
Dialogue: 0,0:11:33.32,0:11:34.20,Dialog,ROSE,0,0,0,,Oh.
Dialogue: 0,0:11:34.20,0:11:35.18,Dialog,TIEN,0,0,0,,Ada apa?
Dialogue: 0,0:11:35.18,0:11:36.81,Dialog,ROSE,0,0,0,,Oh, tidak, aku cuma...
Dialogue: 0,0:11:43.24,0:11:48.41,Dialog,ROSE-Internal,0,0,0,,Aku tidak mungkin berkata, "Tolong jangan duduk \Ndi situ. Itu tempat duduk khusus seseorang."
Dialogue: 0,0:11:48.88,0:11:51.64,Dialog,ROSE-Internal,0,0,0,,Bagi Tien, \Nitu hanya meja biasa.
Dialogue: 0,0:11:54.98,0:11:56.62,Dialog,ROSE,0,0,0,,Tidak... ada apa-apa.
Dialogue: 0,0:11:57.35,0:11:59.77,Dialog,ROSE-Internal,0,0,0,,Benar, tidak ada apa-apa.
Dialogue: 0,0:12:00.48,0:12:04.14,Dialog,ROSE-Internal,0,0,0,,Tidak ada makna apa pun\N di balik tempat duduk itu.
Dialogue: 0,0:12:04.94,0:12:07.55,Dialog,ROSE-Internal,0,0,0,,Sejak awal, tempat itu memang \Ntidak istimewa.
Dialogue: 0,0:12:13.13,0:12:15.06,Dialog,TIEN,0,0,0,,Kakimu terbentur sesuatu, ya?
Dialogue: 0,0:12:17.70,0:12:19.24,Dialog,ROSE,0,0,0,,Aku akan membuatkan teh\N untuk kita.
Dialogue: 0,0:12:19.24,0:12:20.27,Dialog,TIEN,0,0,0,,Apa?!
Dialogue: 0,0:12:20.27,0:12:23.50,Dialog,TIEN,0,0,0,,Tak kusangka Rose sudah punya \Nkemampuan bersosialisasi seperti ini!
Dialogue: 0,0:12:23.50,0:12:25.24,Dialog,TIEN,0,0,0,,Kau benar-benar sudah dewasa, ya?
Dialogue: 0,0:12:25.24,0:12:27.39,Dialog,TIEN,0,0,0,,Aku senang sekali.
Dialogue: 0,0:12:34.12,0:12:36.49,Dialog,HARIJ-Internal,0,0,0,,Aku belum pernah melihatnya menerima\Nklien lain sebelumnya,
Dialogue: 0,0:12:36.49,0:12:38.80,Dialog,HARIJ-Internal,0,0,0,,tapi ternyata ada klien lain\Nselain aku.
Dialogue: 0,0:12:39.25,0:12:41.54,Dialog,HARIJ-Internal,0,0,0,,Syukurlah \Nbisnisnya berjalan lancar.
Dialogue: 0,0:12:43.40,0:12:47.18,Dialog,HARIJ-Internal,0,0,0,,Tidak, ada klien lain atau tidak,\Nitu bukan masalah.
Dialogue: 0,0:12:47.53,0:12:49.68,Dialog,HARIJ-Internal,0,0,0,,Waktuku tinggal dua bulan.
Dialogue: 0,0:12:49.68,0:12:54.34,Dialog,HARIJ-Internal,0,0,0,,Apa pun caranya, aku harus mendesaknya agar\Nsegera menyelesaikan ramuan yang kuminta.
Dialogue: 0,0:12:54.99,0:12:57.53,Dialog,HARIJ-Internal,0,0,0,,Aku membawa \Nmakanan ini untuknya karena
Dialogue: 0,0:12:57.53,0:13:01.46,Dialog,HARIJ-Internal,0,0,0,,aku tidak mau dia pingsan karena\Nkelaparan sebelum ramuannya selesai.
Dialogue: 0,0:13:02.04,0:13:03.91,Dialog,HARIJ-Internal,0,0,0,,Apel sangat bergizi,
Dialogue: 0,0:13:03.91,0:13:06.45,Dialog,HARIJ-Internal,0,0,0,,dan karena itu buah kesukaan sang Penyihir,\Napel adalah pilihan yang tepat.
Dialogue: 0,0:13:06.45,0:13:09.25,Dialog,HARIJ-Internal,0,0,0,,Tidak lebih dan tidak kurang dari itu.
Dialogue: 0,0:13:12.38,0:13:16.04,Dialog,FEMALE STORE OWNER,0,0,0,,Roti kami dipanggang perlahan di tungku tradisional.\nKami bangga dengan hasil karya terbaik kami ini.
Dialogue: 0,0:13:16.04,0:13:18.23,Dialog,FEMALE STORE OWNER,0,0,0,,Aku yakin \Ndia akan menyukainya!
Dialogue: 0,0:13:18.23,0:13:19.94,Dialog,FEMALE STORE OWNER,0,0,0,,Hadiah untuk pacarmu, ya?
Dialogue: 0,0:13:19.94,0:13:20.85,Dialog,HARIJ,0,0,0,,Bukan.
Dialogue: 0,0:13:26.09,0:13:29.36,Dialog,HARIJ,0,0,0,,Yah... aku yakin\N dia akan menyukainya.
Dialogue: 0,0:13:33.42,0:13:35.90,Dialog,HARIJ-Internal,0,0,0,,Ini hanya persediaan.
Dialogue: 0,0:13:36.86,0:13:39.58,Dialog,HARIJ-Internal,0,0,0,,Tidak masalah apakah ini\N membuatnya senang atau—
Dialogue: 0,0:13:49.44,0:13:53.40,Dialog,HARIJ-Internal,0,0,0,,Dia sampai mengantarkan klien\N yang hendak pergi?
Dialogue: 0,0:14:05.25,0:14:08.29,Dialog,HARIJ-Internal,0,0,0,,Perpisahan mereka lama sekali...
Dialogue: 0,0:14:08.29,0:14:09.71,Dialog,HARIJ-Internal,0,0,0,,Kenapa perahunya belum kembali?
Dialogue: 0,0:14:35.29,0:14:39.33,Dialog,HARIJ-Internal,0,0,0,,Kukira hanya aku...
Dialogue: 0,0:14:39.75,0:14:42.71,Dialog,HARIJ-Internal,0,0,0,,Aku, satu-satunya orang yang mengetahui \Nrahasia sang Penyihir,
Dialogue: 0,0:14:42.71,0:14:45.30,Dialog,HARIJ-Internal,0,0,0,,adalah satu-satunya orang yang pernah dia \Nperlihatkan wajahnya setelah melepas tudungnya.
Dialogue: 0,0:15:13.00,0:15:15.94,Dialog,TIEN,0,0,0,,Aduh, maaf sudah membuatmu menunggu.
Dialogue: 0,0:15:15.94,0:15:17.57,Dialog,TIEN,0,0,0,,Melihat tempat ini seperti apa,
Dialogue: 0,0:15:17.57,0:15:20.94,Dialog,TIEN,0,0,0,,aku tak menyangka bakal ada antrean \Norang yang menunggu perahu.
Dialogue: 0,0:15:20.94,0:15:22.60,Dialog,HARIJ,0,0,0,,Aku mengerti.
Dialogue: 0,0:15:22.60,0:15:23.56,Dialog,HARIJ,0,0,0,,Kalau begitu.
Dialogue: 0,0:15:33.85,0:15:35.12,Dialog,TIEN,0,0,0,,Kau...
Dialogue: 0,0:15:36.25,0:15:37.60,Dialog,TIEN,0,0,0,,Hm?
Dialogue: 0,0:15:38.22,0:15:41.00,Dialog,HARIJ-Internal,0,0,0,,Jangan-jangan pria ini...
Dialogue: 0,0:15:41.00,0:15:43.68,Dialog,HARIJ-Internal,0,0,0,,Apa dia mengenaliku sebagai \Nkesatria istana kerajaan?
Dialogue: 0,0:15:47.35,0:15:48.69,Dialog,TIEN,0,0,0,,Kau...
Dialogue: 0,0:15:50.36,0:15:53.28,Dialog,TIEN,0,0,0,,Wajahmu tampan sekali, ya?!
Dialogue: 0,0:15:58.14,0:16:00.99,Dialog,TIEN,0,0,0,,Rose juga pernah mengatakan hal yang sama \Nkepadamu, kan?
Dialogue: 0,0:16:04.52,0:16:05.63,Dialog,HARIJ-Internal,0,0,0,,Rose?
Dialogue: 0,0:16:06.12,0:16:08.40,Dialog,HARIJ-Internal,0,0,0,,Apa itu nama...
Dialogue: 0,0:16:13.29,0:16:14.55,Dialog,TIEN,0,0,0,,Seperti dugaanku.
Dialogue: 0,0:16:14.55,0:16:18.56,Dialog,TIEN,0,0,0,,Jubah itu, taplak meja itu,\N \ndan perubahan sikapnya.
Dialogue: 0,0:16:18.56,0:16:20.15,Dialog,TIEN,0,0,0,,Begitu, begitu.
Dialogue: 0,0:16:21.52,0:16:24.36,Dialog,TIEN,0,0,0,,Tidak, tidak, maafkan aku.\N \nAku hanya bicara sendiri.
Dialogue: 0,0:16:24.81,0:16:27.73,Dialog,TIEN,0,0,0,,Sepertinya keadaan akan \n\Nmenjadi semakin sibuk.
Dialogue: 0,0:16:27.73,0:16:31.53,Dialog,TIEN,0,0,0,,Aku berutang banyak kepada penyihir sebelumnya,\Nyang telah begitu baik kepadaku.
Dialogue: 0,0:16:31.53,0:16:33.61,Dialog,TIEN,0,0,0,,Aku harus mengumpulkan beberapa\N \nbarang dari sana-sini.
Dialogue: 0,0:16:35.57,0:16:37.16,Dialog,TIEN,0,0,0,,Kalau begitu, permisi dulu.
Dialogue: 0,0:16:50.87,0:16:52.84,Dialog,ROSE,0,0,0,,Selamat datang.
Dialogue: 0,0:17:00.26,0:17:02.01,Dialog,ROSE,0,0,0,,Um...
Dialogue: 0,0:17:02.01,0:17:02.97,Dialog,HARIJ,0,0,0,,Siapa dia tadi?
Dialogue: 0,0:17:02.97,0:17:03.91,Dialog,ROSE,0,0,0,,Hah?
Dialogue: 0,0:17:06.29,0:17:09.05,Dialog,ROSE,0,0,0,,Aku tidak bisa membicarakan\N \nklienku yang lain...
Dialogue: 0,0:17:12.19,0:17:14.43,Dialog,HARIJ,0,0,0,,Tidak, kau benar.
Dialogue: 0,0:17:14.43,0:17:17.22,Dialog,ROSE,0,0,0,,Apa dia... melakukan sesuatu\N yang menyinggungmu?
Dialogue: 0,0:17:19.93,0:17:22.29,Dialog,ROSE,0,0,0,,Um, Tuan?
Dialogue: 0,0:17:33.46,0:17:34.88,Dialog,HARIJ,0,0,0,,Ini hadiah untukmu.
Dialogue: 0,0:17:38.62,0:17:40.77,Dialog,ROSE,0,0,0,,Baik sekali dirimu.
Dialogue: 0,0:17:41.34,0:17:43.52,Dialog,ROSE,0,0,0,,Ayo masuk dan kita makan bersama.
Dialogue: 0,0:17:43.52,0:17:45.24,Dialog,ROSE,0,0,0,,Ayo langsung kita nikmati.
Dialogue: 0,0:17:47.51,0:17:48.65,Dialog,ROSE-Internal,0,0,0,,Roti, dan...
Dialogue: 0,0:17:49.37,0:17:50.69,Dialog,ROSE-Internal,0,0,0,,Apel panggang!
Dialogue: 0,0:18:00.21,0:18:01.21,Dialog,HARIJ,0,0,0,,Rose.
Dialogue: 0,0:18:06.24,0:18:09.33,Dialog,HARIJ,0,0,0,,Itu namamu, kan, \NNona Penyihir?
Dialogue: 0,0:18:13.90,0:18:15.62,Dialog,HARIJ,0,0,0,,Mulai sekarang, \Naku akan memanggilmu—
Dialogue: 0,0:18:15.62,0:18:16.59,Dialog,ROSE,0,0,0,,Jangan!
Dialogue: 0,0:18:22.03,0:18:23.97,Dialog,HARIJ-Internal,0,0,0,,Penyihir \Ntidak bisa berbohong.
Dialogue: 0,0:18:24.44,0:18:29.73,Dialog,HARIJ-Internal,0,0,0,,Artinya, kau memang tidak ingin\N \naku memanggilmu dengan nama itu.
Dialogue: 0,0:18:31.41,0:18:33.93,Dialog,HARIJ-Internal,0,0,0,,Tapi kau membiarkan pria itu \n\Nmemanggilmu dengan nama tersebut.
Dialogue: 0,0:18:40.07,0:18:41.37,Dialog,HARIJ,0,0,0,,Kalau begitu, kembalikan.
Dialogue: 0,0:18:41.37,0:18:42.27,Dialog,ROSE,0,0,0,,Apa?
Dialogue: 0,0:18:42.51,0:18:44.19,Dialog,ROSE,0,0,0,,Kau serius, kan?!
Dialogue: 0,0:18:52.63,0:18:54.03,Dialog,HARIJ,0,0,0,,Aku hanya bercanda.
Dialogue: 0,0:19:18.76,0:19:20.45,Dialog,HARIJ-Internal,0,0,0,,Ini bukan masalah besar.
Dialogue: 0,0:19:20.91,0:19:24.31,Dialog,HARIJ-Internal,0,0,0,,Siapa pun yang duduk di sini,\N itu bukan masalah.
Dialogue: 0,0:19:27.07,0:19:29.60,Dialog,HARIJ-Internal,0,0,0,,Atau siapa yang memanggilnya \Ndengan namanya,
Dialogue: 0,0:19:29.60,0:19:31.70,Dialog,HARIJ-Internal,0,0,0,,atau melihat wajahnya,
Dialogue: 0,0:19:31.70,0:19:33.85,Dialog,HARIJ-Internal,0,0,0,,atau siapa yang dia jamu dengan teh \N\ndan keramahannya.
Dialogue: 0,0:19:34.29,0:19:37.38,Dialog,HARIJ-Internal,0,0,0,,Semua itu seharusnya \Ntidak ada hubungannya denganku.
Dialogue: 0,0:19:42.74,0:19:44.24,Dialog,ROSE,0,0,0,,Ada apa?
Dialogue: 0,0:19:44.24,0:19:45.70,Dialog,ROSE,0,0,0,,Kau tidak masuk?
Dialogue: 0,0:19:47.04,0:19:49.19,Dialog,HARIJ,0,0,0,,Tidak, kurasa cukup sampai hari ini.
Dialogue: 0,0:19:49.19,0:19:51.54,Dialog,ROSE,0,0,0,,Apa? \NPadahal kau baru saja datang.
Dialogue: 0,0:19:52.40,0:19:54.40,Dialog,ROSE,0,0,0,,Kau tidak mau makan dulu\N sebelum pergi?
Dialogue: 0,0:19:54.40,0:19:56.39,Dialog,ROSE,0,0,0,,Aku akan segera menyiapkan teh.
Dialogue: 0,0:20:01.53,0:20:04.44,Dialog,HARIJ-Internal,0,0,0,,Aku belum pernah melihat\N klien lain sebelumnya,
Dialogue: 0,0:20:05.29,0:20:07.38,Dialog,HARIJ-Internal,0,0,0,,jadi kukira hanya akulah \Nsatu-satunya orang yang istimewa.
Dialogue: 0,0:20:09.00,0:20:11.61,Dialog,ROSE,0,0,0,,Um... Tuan?
Dialogue: 0,0:20:19.13,0:20:20.67,Dialog,HARIJ-Internal,0,0,0,,Kukira hanya aku...
Dialogue: 0,0:20:37.17,0:20:38.22,Dialog,ROSE,0,0,0,,Apa?
Dialogue: 0,0:20:53.61,0:20:57.58,Dialog,ROSE,0,0,0,,Um, sebenarnya, \Napa ada yang salah?
Dialogue: 0,0:20:57.58,0:20:59.23,Dialog,ROSE,0,0,0,,Apa kau sedang tidak enak badan?
Dialogue: 0,0:20:59.23,0:21:01.08,Dialog,HARIJ,0,0,0,,Ya, kalau kau bilang begitu.
Dialogue: 0,0:21:01.43,0:21:02.79,Dialog,HARIJ,0,0,0,,Di sekitar sini.
Dialogue: 0,0:21:02.79,0:21:05.28,Dialog,ROSE,0,0,0,,Apa lambungmu terasa perih?\N Kau habis minum?
Dialogue: 0,0:21:05.28,0:21:07.30,Dialog,HARIJ,0,0,0,,Yah, semalam aku minum sedikit.
Dialogue: 0,0:21:07.68,0:21:10.72,Dialog,ROSE,0,0,0,,Aku akan membuatkan ramuan untuk \nmeredakan gangguan pencernaanmu.
Dialogue: 0,0:21:10.72,0:21:13.08,Dialog,ROSE,0,0,0,,Setidaknya, minumlah sedikit \N\nsebelum kau pergi.
Dialogue: 0,0:21:15.68,0:21:18.69,Dialog,ROSE,0,0,0,,Untuk gangguan pencernaan, um...
Dialogue: 0,0:21:18.94,0:21:21.39,Dialog,ROSE,0,0,0,,Aku butuh jus kubis, lalu...
Dialogue: 0,0:21:27.61,0:21:29.48,Dialog,HARIJ,0,0,0,,Tidak, maafkan aku.
Dialogue: 0,0:21:29.48,0:21:30.90,Dialog,HARIJ,0,0,0,,Sepertinya itu\N hanya perasaanku saja.
Dialogue: 0,0:21:31.28,0:21:33.47,Dialog,ROSE,0,0,0,,Syukurlah kalau begitu.
Dialogue: 0,0:21:33.47,0:21:35.91,Dialog,ROSE,0,0,0,,Tapi, demi berjaga-jaga, istirahatlah sebentar \N\nsebelum kau pergi.
Dialogue: 0,0:21:35.91,0:21:37.00,Dialog,ROSE,0,0,0,,Silakan.
Dialogue: 0,0:21:37.00,0:21:37.86,Dialog,HARIJ,0,0,0,,Ya.
