Dialogue: 0,0:03:10.85,0:03:17.86,sign,,0000,0000,0000,,{\an8}EPISODE 6\NPENYIHIR DAN OBAT PENGASIH YANG DIJANJIKAN
Dialogue: 0,0:00:07.92,0:00:09.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak!
Dialogue: 0,0:00:10.13,0:00:12.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pasti juga mencari oleh-oleh hari ini.
Dialogue: 0,0:00:12.97,0:00:14.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:00:14.30,0:00:17.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana dengan biskuit isi apel kering?
Dialogue: 0,0:00:17.26,0:00:19.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa diberikan kepada kekasihmu.
Dialogue: 0,0:00:19.51,0:00:21.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang, dia bukan kekasihku.
Dialogue: 0,0:00:22.48,0:00:24.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, ini kelihatannya enak.
Dialogue: 0,0:00:25.06,0:00:27.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong bungkus untuk dua orang.
Dialogue: 0,0:00:27.15,0:00:28.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih!
Dialogue: 0,0:00:32.24,0:00:34.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Penyihir itu sudah berkata\Nbegitu kepadaku.\N{\i0}
Dialogue: 0,0:00:35.16,0:00:36.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau menyelesaikannya sendirian?
Dialogue: 0,0:00:37.12,0:00:37.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:00:38.53,0:00:41.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama ini, aku memang hidup sendiri.
Dialogue: 0,0:00:44.83,0:00:46.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan.
Dialogue: 0,0:00:46.83,0:00:47.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:00:49.71,0:00:52.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa pun yang terjadi,\Ndia perlu makan dengan baik\N{\i0}
Dialogue: 0,0:00:52.96,0:00:55.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dan segera menyiapkan obatnya.\N{\i0}
Dialogue: 0,0:01:03.35,0:01:04.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku masuk, ya.
Dialogue: 0,0:01:12.82,0:01:13.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:01:14.19,0:01:16.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau aku mencari barang lagi?
Dialogue: 0,0:01:16.40,0:01:17.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf membuatmu menunggu.
Dialogue: 0,0:01:21.08,0:01:22.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Obat yang aku janjikan.
Dialogue: 0,0:01:23.87,0:01:26.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Obat pengasih sudah siap.
Dialogue: 0,0:03:04.51,0:03:06.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang meminum obat ini
Dialogue: 0,0:03:06.56,0:03:09.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan menyayangi orang\Nyang memberikannya selama setengah hari.
Dialogue: 0,0:03:10.35,0:03:12.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih daripada orang yang mereka suka.
Dialogue: 0,0:03:13.10,0:03:15.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih daripada pasangan lama mereka.
Dialogue: 0,0:03:15.86,0:03:17.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih daripada saudara kandung mereka.
Dialogue: 0,0:03:17.86,0:03:19.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Efeknya hanya setengah hari.
Dialogue: 0,0:03:19.99,0:03:21.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak terlalu lama.
Dialogue: 0,0:03:22.86,0:03:27.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenangan mendalamnya akan kekal\Nmeski efek obatnya sudah hilang.
Dialogue: 0,0:03:27.95,0:03:30.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tetap ada di hati, tubuh, dan jiwa.
Dialogue: 0,0:03:31.50,0:03:35.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu menjadi noda seumur hidup\Ndan terus berkembang selamanya.
Dialogue: 0,0:03:35.29,0:03:37.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu seperti kutukan.
Dialogue: 0,0:03:38.34,0:03:41.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hasil dari mencintai dari lubuk hati\Nsampai ke tulang,
Dialogue: 0,0:03:41.80,0:03:44.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ke dalam jiwa.
Dialogue: 0,0:03:44.34,0:03:47.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keinginan dasar yang ada\Ndalam diri manusia
Dialogue: 0,0:03:47.47,0:03:49.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebagai makhluk hidup juga akan meningkat.
Dialogue: 0,0:03:49.81,0:03:52.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Artinya, efek samping\Nseperti hasrat seksual...
Dialogue: 0,0:03:52.98,0:03:54.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bisa berhenti di situ.
Dialogue: 0,0:03:54.85,0:03:56.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana cara menggunakannya?
Dialogue: 0,0:03:57.57,0:04:00.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berikan bersama cairan tubuh pengguna.
Dialogue: 0,0:04:00.49,0:04:01.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cairan tubuh?
Dialogue: 0,0:04:02.11,0:04:04.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sulit. Bagaimana cara mengambilnya?
Dialogue: 0,0:04:05.57,0:04:08.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biasanya obat dimasukkan ke dalam gelas,
Dialogue: 0,0:04:08.91,0:04:11.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu berikan minuman itu\Nkepada orang yang dituju.
Dialogue: 0,0:04:12.04,0:04:13.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau berpengetahuan luas.
Dialogue: 0,0:04:13.50,0:04:15.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tertulis di buku panduan.
Dialogue: 0,0:04:20.30,0:04:21.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti.
Dialogue: 0,0:04:21.84,0:04:26.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai sekarang, aku tidak akan menerima\Ngelas dari siapa pun.
Dialogue: 0,0:04:28.22,0:04:29.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apakah dia tertawa?\N{\i0}
Dialogue: 0,0:04:32.39,0:04:34.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Harij sudah tertawa.\N{\i0}
Dialogue: 0,0:04:35.31,0:04:37.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku mencoba untuk tetap tenang\Nhari ini, tapi...\N{\i0}
Dialogue: 0,0:04:38.11,0:04:41.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun, hal sekecil itu pun\Nsudah membuatku bahagia.\N{\i0}
Dialogue: 0,0:04:43.32,0:04:45.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kau khawatir dengan dampaknya,
Dialogue: 0,0:04:48.95,0:04:53.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau bisa mencoba sampel yang efektif\Nsepanjang periode jam pasir ini.
Dialogue: 0,0:04:53.91,0:04:55.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, minumlah.
Dialogue: 0,0:04:55.12,0:04:56.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:04:59.17,0:05:00.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang minum?
Dialogue: 0,0:05:00.80,0:05:02.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu masuk akal, 'kan?
Dialogue: 0,0:05:04.17,0:05:08.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia tahu penyihir tidak bisa berbohong.\N{\i0}
Dialogue: 0,0:05:08.18,0:05:12.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tidak, itu sebabnya dia merasa\Naku pas untuk mencobanya!\N{\i0}
Dialogue: 0,0:05:13.85,0:05:16.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan masalah.
Dialogue: 0,0:05:16.81,0:05:21.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, kalau aku minum,\Nperubahan mungkin tidak terlalu terlihat.
Dialogue: 0,0:05:21.52,0:05:22.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:05:22.82,0:05:25.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Obat penyihir tidak berpengaruh\Nkepada penyihir itu sendiri?
Dialogue: 0,0:05:30.49,0:05:32.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Karena aku memang sudah menyukaimu.\N{\i0}
Dialogue: 0,0:05:47.05,0:05:48.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini boleh?
Dialogue: 0,0:05:55.64,0:05:57.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Begitu dia mendapatkan obat yang diminta,\N{\i0}
Dialogue: 0,0:05:58.44,0:06:02.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}tak ada lagi alasan bagi kesatria kerajaan\Ndatang ke tempat ini.\N{\i0}
Dialogue: 0,0:06:03.19,0:06:07.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ini yang terakhir kalinya\Naku bisa bertemu Harij.\N{\i0}
Dialogue: 0,0:06:12.58,0:06:15.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Hari ini adalah yang terakhir.\N{\i0}
Dialogue: 0,0:06:32.97,0:06:33.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Habislah.\N{\i0}
Dialogue: 0,0:06:45.36,0:06:50.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku tidak meremehkan kemampuanku\Nmaupun efektivitas obat ini.\N{\i0}
Dialogue: 0,0:06:51.24,0:06:52.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun...\N{\i0}
Dialogue: 0,0:06:53.45,0:06:54.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyihir?
Dialogue: 0,0:06:54.53,0:06:58.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- {\i1}...bagiku yang sudah mencintainya...\N{\i0}- Penyihir, kenapa? Penyihir?
Dialogue: 0,0:06:58.50,0:07:01.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}...aku tidak menyangka emosi sekuat ini\Nmampu menguasai diriku.\N{\i0}
Dialogue: 0,0:07:02.46,0:07:04.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah kau dengar?
Dialogue: 0,0:07:08.84,0:07:10.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kenapa dia begitu baik?\N{\i0}
Dialogue: 0,0:07:12.05,0:07:16.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia peduli\Ndan selalu bersikap baik kepadaku.\N{\i0}
Dialogue: 0,0:07:25.82,0:07:26.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyihir?
Dialogue: 0,0:07:31.70,0:07:34.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Habislah. Aku tidak tahan.\N{\i0}
Dialogue: 0,0:07:35.45,0:07:37.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa? Lihat aku.
Dialogue: 0,0:07:38.08,0:07:39.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku tidak bisa melihatmu.\N{\i0}
Dialogue: 0,0:07:40.16,0:07:43.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kau lakukan?\NAku tidak tahu obatnya efektif atau tidak.
Dialogue: 0,0:07:43.63,0:07:47.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku tidak peduli lagi kalau kau\Ntidak mau membeli obat ini.\N{\i0}
Dialogue: 0,0:07:47.30,0:07:50.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei! Apakah obat penyihir itu\Ntidak manjur?
Dialogue: 0,0:07:51.09,0:07:52.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Obat ini bekerja dengan baik.\N{\i0}
Dialogue: 0,0:07:53.22,0:07:57.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun, kalau terus begini,\Naku akan dihina sebagai penyihir.\N{\i0}
Dialogue: 0,0:07:57.39,0:07:59.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku tidak mau itu terjadi.\N{\i0}
Dialogue: 0,0:08:00.68,0:08:04.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku tidak mau mengatakan sama sekali\Nbahwa aku menyayanginya.\N{\i0}
Dialogue: 0,0:08:04.77,0:08:07.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku tidak mau mengungkapkan\Ncinta tanpa harapan ini.\N{\i0}
Dialogue: 0,0:08:08.27,0:08:13.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Hal yang bisa aku lakukan\Nhanyalah melindungi diri agar tak terluka.\N{\i0}
Dialogue: 0,0:08:14.11,0:08:16.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku harus menyalahkan obat ini,\N{\i0}
Dialogue: 0,0:08:16.87,0:08:18.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}tapi aku juga tidak berani.\N{\i0}
Dialogue: 0,0:08:20.29,0:08:23.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Karena aku benar-benar\N{\i0}
Dialogue: 0,0:08:24.00,0:08:25.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}menyukainya.\N{\i0}
Dialogue: 0,0:08:25.92,0:08:27.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini tidak akan ke mana-mana.
Dialogue: 0,0:08:27.96,0:08:30.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Lihat ke sini.\N- Aku tidak mau!
Dialogue: 0,0:08:33.88,0:08:36.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti.
Dialogue: 0,0:08:37.35,0:08:40.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, maksudnya sekarang kau
Dialogue: 0,0:08:42.73,0:08:45.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menyukaiku?
Dialogue: 0,0:08:46.52,0:08:47.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:08:47.69,0:08:50.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bodoh? Apakah dia bodoh?\N{\i0}
Dialogue: 0,0:08:50.78,0:08:52.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Meski hanya mau memastikan efek obatnya,\N{\i0}
Dialogue: 0,0:08:53.03,0:08:56.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}itu yang kau katakan kepada gadis\Nyang sudah jatuh cinta kepadamu?\N{\i0}
Dialogue: 0,0:08:56.78,0:08:59.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kenapa dia lambat berpikir,\Nhal ini saja tidak paham?\N{\i0}
Dialogue: 0,0:08:59.87,0:09:03.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tentu saja aku tidak akan menjawab\Npertanyaan seperti itu.\N{\i0}
Dialogue: 0,0:09:06.79,0:09:07.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:09:10.30,0:09:15.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jawaban yang sama sekali tidak sepadan\Ndengan empat tahun cinta tidak berbalas.\N{\i0}
Dialogue: 0,0:09:25.27,0:09:26.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak suka aku menyentuhmu?
Dialogue: 0,0:09:57.38,0:09:58.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku minta maaf.
Dialogue: 0,0:10:01.18,0:10:04.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minum obat ini akan membebani tubuh?
Dialogue: 0,0:10:06.39,0:10:07.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:10:08.40,0:10:10.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini hanya sangat menyedihkan.
Dialogue: 0,0:10:13.27,0:10:14.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyedihkan?
Dialogue: 0,0:10:19.61,0:10:22.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku menyukainya.\N{\i0}
Dialogue: 0,0:10:24.16,0:10:25.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Suka.\N{\i0}
Dialogue: 0,0:10:29.17,0:10:31.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena orang yang aku sukai...
Dialogue: 0,0:10:33.13,0:10:35.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ada di sini.
Dialogue: 0,0:10:42.97,0:10:44.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau berpikir demikian?
Dialogue: 0,0:10:44.68,0:10:48.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja. Karena kau datang\Nuntuk membeli obat pengasih.
Dialogue: 0,0:10:52.90,0:10:54.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mau! Berhenti!
Dialogue: 0,0:10:54.40,0:10:56.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan terlalu baik\Ndan membuatku berharap.
Dialogue: 0,0:10:57.82,0:10:59.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, obat ini...
Dialogue: 0,0:11:04.49,0:11:07.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa menjelaskannya,\Ntapi aku mau kau mengerti.
Dialogue: 0,0:11:08.20,0:11:10.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku membelinya\Nbukan untuk aku gunakan sendiri.
Dialogue: 0,0:11:14.88,0:11:16.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar?
Dialogue: 0,0:11:18.76,0:11:19.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Benar.
Dialogue: 0,0:11:28.48,0:11:29.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang!
Dialogue: 0,0:11:43.66,0:11:44.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku senang.\N{\i0}
Dialogue: 0,0:11:45.53,0:11:46.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Senangnya.\N{\i0}
Dialogue: 0,0:11:48.70,0:11:51.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku tidak bisa mengendalikan\Nsesuai keinginanku sendiri.\N{\i0}
Dialogue: 0,0:11:55.34,0:11:56.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Harij.
Dialogue: 0,0:11:58.51,0:12:00.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh? Bahkan sekali pun tidak apa-apa.
Dialogue: 0,0:12:01.09,0:12:02.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Panggil aku Rose.
Dialogue: 0,0:12:07.81,0:12:09.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisakah aku panggil?
Dialogue: 0,0:12:13.06,0:12:13.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rose.
Dialogue: 0,0:12:15.40,0:12:16.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:12:18.19,0:12:19.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rose.
Dialogue: 0,0:12:19.48,0:12:20.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:12:21.32,0:12:24.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku sangat senang\Ndengan luapan rasa cinta ini.\N{\i0}
Dialogue: 0,0:12:50.89,0:12:52.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah kau puas?
Dialogue: 0,0:12:58.90,0:13:01.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah datang.
Dialogue: 0,0:13:13.87,0:13:15.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Panasnya.
Dialogue: 0,0:13:15.67,0:13:17.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dadaku sakit.
Dialogue: 0,0:13:20.55,0:13:23.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harij. Hampir saja.
Dialogue: 0,0:13:27.18,0:13:29.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau melupakan! Ayo, lupakan!
Dialogue: 0,0:13:32.85,0:13:36.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bukan dia yang mau menggunakan\Nobat pengasih itu.\N{\i0}
Dialogue: 0,0:13:36.94,0:13:40.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku bahkan tidak memikirkannya sebelumnya.\N{\i0}
Dialogue: 0,0:13:40.90,0:13:42.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku hanya mau bahagia,\N{\i0}
Dialogue: 0,0:13:42.82,0:13:44.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}tapi tidak bisa bertemu Harij lagi.\N{\i0}
Dialogue: 0,0:13:46.95,0:13:49.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mungkin seharusnya aku memeras\Nlebih banyak uang darinya.\N{\i0}
Dialogue: 0,0:13:50.87,0:13:52.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mungkin dengan cara itu,\N{\i0}
Dialogue: 0,0:13:52.54,0:13:57.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dia akan mengingatku\Nsebagai "penyihir serakah".\N{\i0}
Dialogue: 0,0:14:02.38,0:14:04.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Baiklah! Mari kita bereskan.\N{\i0}
Dialogue: 0,0:14:04.46,0:14:06.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tidak akan ada habisnya kalau dipikirkan.\N{\i0}
Dialogue: 0,0:14:06.47,0:14:09.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jadi, tidak ada gunanya memikirkannya.\N{\i0}
Dialogue: 0,0:14:12.14,0:14:15.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Lonceng sapi, yang membuatku\Nbersemangat setiap kali mendengarnya.\N{\i0}
Dialogue: 0,0:14:17.94,0:14:21.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Seperangkat piring dan cangkir\Nyang cantik untuk dua orang.\N{\i0}
Dialogue: 0,0:14:22.65,0:14:25.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Taplak meja juga. Semuanya harus disimpan.\N{\i0}
Dialogue: 0,0:14:28.53,0:14:31.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Karena hatiku mulai berharap\Nsesuatu darinya.\N{\i0}
Dialogue: 0,0:14:31.99,0:14:34.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Karena hal ini membuatku\Nmengingat momen itu.\N{\i0}
Dialogue: 0,0:14:34.70,0:14:37.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ketika aku mencium aroma manis apel.\N{\i0}
Dialogue: 0,0:14:42.92,0:14:44.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tertinggal.
Dialogue: 0,0:14:47.92,0:14:48.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini biskuit.
Dialogue: 0,0:15:02.98,0:15:04.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Tidak ada rasa.
Dialogue: 0,0:15:12.57,0:15:15.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Beberapa hari setelah aku\Nmenyerahkan obat pengasih...\N{\i0}
Dialogue: 0,0:15:17.25,0:15:20.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kenapa dia ada di sini?\N{\i0}
Dialogue: 0,0:15:22.17,0:15:24.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang?
Dialogue: 0,0:15:24.96,0:15:25.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku masuk, ya.
Dialogue: 0,0:15:26.42,0:15:27.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:15:27.67,0:15:30.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa maksudnya?\NAku sudah menyelesaikan pesanannya.\N{\i0}
Dialogue: 0,0:15:31.05,0:15:33.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia seharusnya tidak datang\Nke tempat seperti ini lagi.\N{\i0}
Dialogue: 0,0:15:35.14,0:15:37.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Obat yang aku berikan memiliki masalah?
Dialogue: 0,0:15:38.27,0:15:40.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Efektivitasnya tidak dapat disangkal.
Dialogue: 0,0:15:40.35,0:15:41.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa?\N{\i0}
Dialogue: 0,0:15:41.48,0:15:42.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia tidak datang untuk mengeluh.\N{\i0}
Dialogue: 0,0:15:43.65,0:15:44.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jadi, kenapa datang ke sini?\N{\i0}
Dialogue: 0,0:15:45.07,0:15:48.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, obatnya sudah tidak ada padaku.
Dialogue: 0,0:15:49.03,0:15:52.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapan dan bagaimana penggunaannya,\Nitu bukan urusanku lagi.
Dialogue: 0,0:15:53.28,0:15:54.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun,
Dialogue: 0,0:15:54.37,0:15:57.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku sudah berulang kali mengingatkan\Ncara menggunakannya.
Dialogue: 0,0:15:57.99,0:16:00.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Juga perilaku mereka\Nyang meminum obat tersebut.
Dialogue: 0,0:16:02.17,0:16:05.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tidak mungkin. Kau mau mengungkit\Nkejadian waktu itu, 'kan?\N{\i0}
Dialogue: 0,0:16:08.71,0:16:13.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sebenarnya, aku masih ingat dengan jelas,\Nbahkan sampai hari ini.\N{\i0}
Dialogue: 0,0:16:15.85,0:16:18.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku pernah berpikir alangkah indahnya itu\N{\i0}
Dialogue: 0,0:16:19.02,0:16:22.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}kalau dia bisa mengingatku,\Nbahkan sekali dalam hidupnya.\N{\i0}
Dialogue: 0,0:16:22.89,0:16:25.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun, itu mustahil kalau aku memikirkan\N{\i0}
Dialogue: 0,0:16:25.86,0:16:28.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dia mengungkit perbuatanku yang memalukan.\N{\i0}
Dialogue: 0,0:16:28.82,0:16:32.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong lupakan hal-hal\Nterkait obat percobaan itu.
Dialogue: 0,0:16:32.74,0:16:34.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagiku pun,
Dialogue: 0,0:16:34.28,0:16:37.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}efek obat yang aku minum sudah habis.
Dialogue: 0,0:16:38.74,0:16:39.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Maksudku,\N{\i0}
Dialogue: 0,0:16:39.95,0:16:44.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}aku tidak mau\Ntopik mengerikan ini diangkat lagi.\N{\i0}
Dialogue: 0,0:16:44.08,0:16:45.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mari kita ganti topiknya.\N{\i0}
Dialogue: 0,0:16:45.71,0:16:47.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada urusan lain?
Dialogue: 0,0:16:48.17,0:16:52.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bersedia datang dari jauh\Nke tempat mencurigakan seperti ini.\N{\i0}
Dialogue: 0,0:16:52.88,0:16:56.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bahkan sampai menyamar\Ndan memakai pakaian pengembara.\N{\i0}
Dialogue: 0,0:16:56.14,0:16:57.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sebenarnya untuk tujuan apa?\N{\i0}
Dialogue: 0,0:17:07.90,0:17:08.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rose.
Dialogue: 0,0:17:11.69,0:17:13.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh? Bahkan sekali pun tidak apa-apa.
Dialogue: 0,0:17:14.57,0:17:16.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Panggil aku Rose.
Dialogue: 0,0:17:16.74,0:17:18.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu karena pengaruh obat.
Dialogue: 0,0:17:22.58,0:17:24.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah menyimpan taplak meja?
Dialogue: 0,0:17:28.38,0:17:30.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak menduga kain itu begitu penting.
Dialogue: 0,0:17:30.67,0:17:32.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan segera mengembalikannya.
Dialogue: 0,0:17:32.30,0:17:34.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan itu yang aku mau.
Dialogue: 0,0:17:35.26,0:17:39.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pikir kau tidak akan datang lagi,\Njadi menurutku itu sudah tidak perlu.
Dialogue: 0,0:17:44.81,0:17:46.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bukan untukku.
Dialogue: 0,0:17:47.65,0:17:50.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, tolong pikirkan tentang makananmu.
Dialogue: 0,0:17:52.23,0:17:55.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, aku sudah menerima bayaran.
Dialogue: 0,0:17:55.53,0:17:58.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku menerima sesuatu lagi darimu...
Dialogue: 0,0:17:58.45,0:18:02.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kalau aku menerimanya, meski sekali,\Naku pasti akan menantikannya lagi.\N{\i0}
Dialogue: 0,0:18:03.24,0:18:07.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Besok, lusa, dan hari-hari berikutnya.
Dialogue: 0,0:18:08.17,0:18:10.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan mulai berharap\Nagar dia datang lagi.
Dialogue: 0,0:18:11.88,0:18:15.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cinta bertepuk sebelah tangan tanpa akhir.\NSangat menakutkan.
Dialogue: 0,0:18:20.97,0:18:21.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:18:22.56,0:18:24.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku mau memesan obat lagi.
Dialogue: 0,0:18:29.48,0:18:30.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:18:31.61,0:18:32.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Obat apa?
Dialogue: 0,0:18:33.15,0:18:34.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Obat pengasih.
Dialogue: 0,0:18:37.36,0:18:39.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kali ini untuk penggunaan pribadi?
Dialogue: 0,0:18:40.03,0:18:43.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hobi seorang penyihir\Nadalah mempertanyakan pelanggan?
Dialogue: 0,0:18:44.04,0:18:44.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rose?
Dialogue: 0,0:18:48.54,0:18:49.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku minta maaf.
Dialogue: 0,0:18:50.71,0:18:53.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kali ini sudah jelas\Naku yang membuat kesalahan.\N{\i0}
Dialogue: 0,0:18:53.67,0:18:56.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kalau begini, aku tidak bisa\Nmenghentikan dia memanggil namaku.\N{\i0}
Dialogue: 0,0:18:56.67,0:19:00.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?\NKau tidak mau menerima pesanan obat baru?
Dialogue: 0,0:19:00.39,0:19:01.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rose?
Dialogue: 0,0:19:06.52,0:19:07.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti.
Dialogue: 0,0:19:08.23,0:19:10.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan membuatkan obat yang kau minta.
Dialogue: 0,0:19:10.69,0:19:12.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Obat ini akan memakan waktu lebih lama.
Dialogue: 0,0:19:13.90,0:19:15.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu yang aku mau.
Dialogue: 0,0:19:24.28,0:19:26.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang di rumah.
Dialogue: 0,0:19:26.20,0:19:29.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan. Tuan mau aku menyiapkan anggur?
Dialogue: 0,0:19:29.96,0:19:31.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini aku mau istirahat.
Dialogue: 0,0:19:31.67,0:19:33.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Safina dan yang lainnya juga bisa keluar.
Dialogue: 0,0:19:34.21,0:19:35.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:19:44.30,0:19:45.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Rose.\N{\i0}
Dialogue: 0,0:19:46.14,0:19:49.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku tidak diperbolehkan\Nmenyebut nama asli penyihir.\N{\i0}
Dialogue: 0,0:19:52.85,0:19:55.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku tidak punya masalah memanggil wanita\Ndengan nama mereka.\N{\i0}
Dialogue: 0,0:19:56.61,0:19:58.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun, ketika dilarang menyebut namanya,\N{\i0}
Dialogue: 0,0:19:58.57,0:20:00.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}aku merasa marah.\N{\i0}
Dialogue: 0,0:20:01.07,0:20:02.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun, pada saat itu,\N{\i0}
Dialogue: 0,0:20:02.74,0:20:07.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}aku pikir itu mungkin kebiasaan penyihir,\Njadi aku diam saja.\N{\i0}
Dialogue: 0,0:20:10.08,0:20:11.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Meski dia bilang begitu...\N{\i0}
Dialogue: 0,0:20:13.00,0:20:15.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh? Bahkan sekali pun tidak apa-apa.
Dialogue: 0,0:20:16.00,0:20:17.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Panggil aku Rose.
Dialogue: 0,0:20:19.30,0:20:21.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia yang sudah meminum obat pengasih,\N{\i0}
Dialogue: 0,0:20:21.55,0:20:23.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}mengizinkanku memanggil\Nnamanya dengan mudah.\N{\i0}
Dialogue: 0,0:20:25.05,0:20:28.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia membiarkanku memanggil namanya\Nmeski dia tidak menyukaiku.\N{\i0}
Dialogue: 0,0:20:29.35,0:20:31.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku merasa marah.\N{\i0}
Dialogue: 0,0:20:31.23,0:20:33.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Siapa sebenarnya yang boleh\Nmemanggil namanya?\N{\i0}
Dialogue: 0,0:20:34.06,0:20:36.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Karena aku dilarang sama sekali\Nmenyebutkan namanya.\N{\i0}
Dialogue: 0,0:20:37.86,0:20:38.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun...\N{\i0}
Dialogue: 0,0:20:39.48,0:20:40.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}ketika aku melihatnya,\N{\i0}
Dialogue: 0,0:20:42.45,0:20:44.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}aku tidak bisa menyalahkan dia.\N{\i0}
Dialogue: 0,0:20:49.70,0:20:52.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku begitu terpesona dengan gerakannya,\Nekspresinya,\N{\i0}
Dialogue: 0,0:20:53.04,0:20:55.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}segala sesuatu tentang dia.\N{\i0}
Dialogue: 0,0:20:56.00,0:20:58.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sampai aku tidak bisa memikirkan hal lain.\N{\i0}
Dialogue: 0,0:21:02.84,0:21:07.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pada hari itu, aku hanya mampu\Nmenyalahkan diri sendiri.\N{\i0}
Dialogue: 0,0:21:07.68,0:21:10.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku sudah bersumpah\Nuntuk tidak mempermainkan\N{\i0}
Dialogue: 0,0:21:10.39,0:21:13.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}cinta yang muncul akibat obat itu.\N{\i0}
Dialogue: 0,0:21:15.23,0:21:16.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Selama beberapa hari berikutnya,\N{\i0}
Dialogue: 0,0:21:17.23,0:21:18.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}entah aku terjaga atau tertidur,\N{\i0}
Dialogue: 0,0:21:18.82,0:21:23.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}aku tidak bisa melupakan suaranya,\Nsuhu tubuhnya, matanya yang redup...\N{\i0}
Dialogue: 0,0:21:24.82,0:21:27.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jantungku tidak berhenti berdegup kencang.\N{\i0}
Dialogue: 0,0:21:29.16,0:21:32.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Seolah-olah akulah\Nyang sudah diberi obat pengasih.\N{\i0}
Dialogue: 0,0:21:33.54,0:21:37.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kalau aku bertemu dengannya,\Nmungkin ini akan menjadi jelas.\N{\i0}
Dialogue: 0,0:21:37.08,0:21:38.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku rasa demikian.\N{\i0}
Dialogue: 0,0:21:40.17,0:21:43.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong lupakan hal-hal\Nterkait obat percobaan itu.
Dialogue: 0,0:21:45.01,0:21:46.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagiku pun,
Dialogue: 0,0:21:46.47,0:21:49.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}efek obat yang aku minum sudah habis.
Dialogue: 0,0:21:51.10,0:21:53.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia menolakku sepenuhnya.\N{\i0}
Dialogue: 0,0:21:57.90,0:21:59.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Taplak mejanya sudah tidak ada.\N{\i0}
Dialogue: 0,0:22:04.57,0:22:09.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku pikir masih banyak waktu untuk kami\Nmenikmati teh herba pekat ini\N{\i0}
Dialogue: 0,0:22:09.91,0:22:12.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}di bawah sinar matahari.\N{\i0}
Dialogue: 0,0:22:15.12,0:22:19.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Penyihir ini benar-benar berpikir\Ndia bisa mengusirku karena ini?\N{\i0}
Dialogue: 0,0:22:20.04,0:22:21.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ketika memikirkannya,\N{\i0}
Dialogue: 0,0:22:21.84,0:22:24.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}aku tidak bisa menahan diri\Nuntuk balas dendam.\N{\i0}
Dialogue: 0,0:22:25.09,0:22:26.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rose.
Dialogue: 0,0:22:29.22,0:22:30.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pantas aku mendapatkan ini.\N{\i0}
Dialogue: 0,0:22:33.81,0:22:37.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kenapa rasa dipermainkan seperti ini\Nsangat menyakitkan?\N{\i0}
Dialogue: 0,0:22:39.40,0:22:41.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu benar-benar efek obatnya.\N{\i0}
Dialogue: 0,0:22:42.61,0:22:44.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu hanyalah ilusi.\N{\i0}
Dialogue: 0,0:22:46.49,0:22:50.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku merasa seolah-olah\Nakan kehilangan segalanya.\N{\i0}
Dialogue: 0,0:22:51.07,0:22:53.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jadi, aku terus berbicara tanpa berpikir.\N{\i0}
Dialogue: 0,0:22:55.00,0:22:56.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau memesan obat lagi.
Dialogue: 0,0:23:02.75,0:23:04.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Obat pengasih.
Dialogue: 0,0:23:09.68,0:23:11.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku tidak mengerti kenapa ditolak olehnya\N{\i0}
Dialogue: 0,0:23:11.93,0:23:14.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}sungguh menyakitkan.\N{\i0}
Dialogue: 0,0:23:14.26,0:23:15.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku tidak tahu.\N{\i0}
Dialogue: 0,0:23:16.18,0:23:19.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Namun... anehnya, aku merasa puas.\N{\i0}
Dialogue: 0,0:23:19.98,0:23:21.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Tidak apa-apa.\N{\i0}
Dialogue: 0,0:23:21.65,0:23:23.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku tahu dia membutuhkan banyak waktu\N{\i0}
Dialogue: 0,0:23:23.52,0:23:25.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}untuk menyiapkan obat pengasih.\N{\i0}
Dialogue: 0,0:23:26.03,0:23:28.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Namun, kalau aku bisa meluangkan\Nlebih banyak waktu bersamanya,\N{\i0}
Dialogue: 0,0:23:29.61,0:23:33.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dia tidak akan berpikir\Nuntuk menolakku lagi.\N{\i0}
Dialogue: 0,0:23:35.66,0:23:38.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah. Setelah ini, apa lagi yang harus\Naku bawakan untuknya?
Dialogue: 0,0:23:38.83,0:23:40.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terjemahan subtitle oleh Haseenah Musa
