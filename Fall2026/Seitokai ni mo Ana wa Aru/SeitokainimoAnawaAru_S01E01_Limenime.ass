Dialogue: 0,0:23:36.08,0:23:38.86,sign,,0000,0000,0000,,TUJUH MISTERI SEKOLAH DAN TUGAS PATROLI MALAM,\NTAN PENOLONG, KEMUNCULAN KOMARO!
Dialogue: 0,0:23:38.86,0:23:41.06,sign,,0000,0000,0000,,NANTIKAN EPISODE BERIKUTNYA
Dialogue: 0,0:00:20.58,0:00:24.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi-lagi\Nterlambat ke sekolah...
Dialogue: 0,0:01:56.29,0:01:58.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak masuk sekolah sampai sekarang,
Dialogue: 0,0:01:58.63,0:02:01.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}nilai try-out Bahasa Jepang selalu sempurna.
Dialogue: 0,0:02:02.10,0:02:04.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Juga menerima banyak penghargaan sastra...
Dialogue: 0,0:02:04.60,0:02:07.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu hebat juga, ya, Mizunoe.
Dialogue: 0,0:02:08.66,0:02:10.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, itu bukan sesuatu\Nyang bisa dibanggakan...
Dialogue: 0,0:02:10.98,0:02:13.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan merendah.
Dialogue: 0,0:02:13.35,0:02:15.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kali ini nilai rata-ratanya\Ndi bawah 50, lo.
Dialogue: 0,0:02:16.08,0:02:19.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Huruf-hurufnya seperti menari\Ndi depan mataku.
Dialogue: 0,0:02:19.69,0:02:20.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ha?
Dialogue: 0,0:02:20.73,0:02:23.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seakan berkata,\N"Intensi penulisnya begini, lo..."
Dialogue: 0,0:02:23.25,0:02:24.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Uwah...
Dialogue: 0,0:02:24.41,0:02:27.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Bu Guru terjun ke dunia sastra\Njuga bisa begini, kok.
Dialogue: 0,0:02:27.12,0:02:28.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serius? Aku harus hati-hati.
Dialogue: 0,0:02:29.26,0:02:31.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, tapi ini benar-benar hebat, lo.
Dialogue: 0,0:02:31.62,0:02:34.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sopan dan berperilaku baik,\Njuga disukai para guru.
Dialogue: 0,0:02:34.88,0:02:36.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlalu berlebihan, ya.
Dialogue: 0,0:02:36.80,0:02:37.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, setuju.
Dialogue: 0,0:02:38.21,0:02:41.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa sangka orang\Nyang seperti ini bakal tinggal kelas?
Dialogue: 0,0:02:41.16,0:02:41.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:02:41.96,0:02:45.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Tinggal kelas?\NAku? Kenapa?
Dialogue: 0,0:02:45.18,0:02:47.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu bingung begitu?
Dialogue: 0,0:02:47.85,0:02:50.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan nilai hancur di semua\Nmata pelajaran sains ini?
Dialogue: 0,0:02:50.99,0:02:51.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ugh...
Dialogue: 0,0:02:51.70,0:02:56.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu ini, ya. Bahkan aku\Nyang penanggung jawab di kelas satu pun...
Dialogue: 0,0:02:56.36,0:03:00.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga, sih.\NTidak bisa diselesaikan dengan mudah...
Dialogue: 0,0:03:00.19,0:03:01.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bonusku bisa dipotong!
Dialogue: 0,0:03:02.03,0:03:03.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar guru sampah.
Dialogue: 0,0:03:03.42,0:03:04.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekedar informasi, nilai ini juga akan
Dialogue: 0,0:03:04.76,0:03:06.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mempengaruhi surat rekomendasimu.
Dialogue: 0,0:03:06.20,0:03:06.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:03:06.96,0:03:09.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan malah "eh?". Sudah jelas, lah.
Dialogue: 0,0:03:09.13,0:03:12.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu jadi kesulitan, 'kan?\NIngin berusaha memperbaikinya, 'kan?
Dialogue: 0,0:03:12.27,0:03:15.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi tidak banyak cara untuk\Nmeningkatkan evaluasi...
Dialogue: 0,0:03:15.46,0:03:18.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga, bagaimana kalau\Nikut OSIS?
Dialogue: 0,0:03:18.77,0:03:21.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}O-OSIS? Kenapa tiba-tiba?
Dialogue: 0,0:03:21.38,0:03:24.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, ide bagus, tuh.\NNilaimu bisa naik drastis,
Dialogue: 0,0:03:24.09,0:03:26.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}soalnya kamu bertugas mendukung para murid.
Dialogue: 0,0:03:26.54,0:03:28.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa, aku ada kegiatan ekskul...
Dialogue: 0,0:03:28.37,0:03:31.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu yang tidak populer ini pun\Nmungkin bisa menikmati masa muda.
Dialogue: 0,0:03:31.66,0:03:32.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:03:32.29,0:03:33.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}OSIS itu menyenangkan, lo.
Dialogue: 0,0:03:33.87,0:03:34.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mencurigakan.
Dialogue: 0,0:03:35.51,0:03:39.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, baru-baru ini ada yang keluar,\Njadi sedikit kerepotan.
Dialogue: 0,0:03:39.40,0:03:41.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata memang untuk\Nkepentingan sendiri, ya.
Dialogue: 0,0:03:41.23,0:03:42.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan begitu, dasar bodoh.
Dialogue: 0,0:03:43.14,0:03:46.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bakal kesepian kalau\Nkamu tidak ada tahun depan.
Dialogue: 0,0:03:50.01,0:03:51.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi ini permintaan pribadiku.
Dialogue: 0,0:03:52.30,0:03:53.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu Guru!
Dialogue: 0,0:03:53.73,0:03:59.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, sudah diputuskan! Bonusku aman.\NMakasih. Saatnya pulang, minum, dan tidur.
Dialogue: 0,0:03:59.11,0:04:00.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aktingnya sampai selesai, dong...
Dialogue: 0,0:04:03.89,0:04:06.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi ini ruang OSIS.
Dialogue: 0,0:04:06.16,0:04:10.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Papannya dipasang dengan gagah,\Nkayak simbol kekuatan saja, sombongnya.
Dialogue: 0,0:04:11.49,0:04:13.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh? Jangan-jangan kamu...
Dialogue: 0,0:04:13.76,0:04:16.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mizunoe Ume, ya? Aku sudah menunggumu.
Dialogue: 0,0:04:17.10,0:04:18.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ha-Halo...
Dialogue: 0,0:04:18.71,0:04:20.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cantik banget!
Dialogue: 0,0:04:20.41,0:04:24.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senior anggota OSIS, ya?\NMohon bantuannya...
Dialogue: 0,0:04:25.18,0:04:26.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senior...
Dialogue: 0,0:04:26.43,0:04:30.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga, aku seniormu.\NDuh, jadi malu.
Dialogue: 0,0:04:30.09,0:04:31.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Imutnya...
Dialogue: 0,0:04:31.66,0:04:33.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin OSIS bukan hal yang buruk.
Dialogue: 0,0:04:34.12,0:04:35.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, ayo kita masuk.
Dialogue: 0,0:04:35.59,0:04:35.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhasil, berhasil, berhasil!
Dialogue: 0,0:04:35.77,0:04:36.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ba-Baik.\N- Berhasil, berhasil, berhasil!
Dialogue: 0,0:04:36.45,0:04:37.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhasil, berhasil, berhasil!
Dialogue: 0,0:04:37.54,0:04:41.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya sudah jadi, Tatsuko Mk. 32,\Nversi otonom FormG.
Dialogue: 0,0:04:41.45,0:04:43.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya, kita bisa\Nmenang kontes robot!
Dialogue: 0,0:04:43.61,0:04:45.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan lari di lorong.
Dialogue: 0,0:04:48.99,0:04:50.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Mk. 32...!\N- Ayo, kita masuk.
Dialogue: 0,0:04:50.34,0:04:51.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berusahalah! Kamu pasti bisa...
Dialogue: 0,0:04:52.33,0:04:56.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perkenalkan. Aku bendahara, Terui.\NSalam kenal, ya.
Dialogue: 0,0:04:56.72,0:04:59.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, ya. Aku Mizunoe dari kelas 1.
Dialogue: 0,0:05:00.11,0:05:04.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sopan begini pada adik kelas,\Nsudah kuduga yang tadi cuma perasaanku...
Dialogue: 0,0:05:06.47,0:05:08.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duh, mata kita bertemu, ya.
Dialogue: 0,0:05:09.36,0:05:10.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang menakutkan!
Dialogue: 0,0:05:10.42,0:05:11.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo, halo!
Dialogue: 0,0:05:11.64,0:05:14.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, jangan-jangan anak baru, ya!
Dialogue: 0,0:05:14.72,0:05:17.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih keren dari yang kudengar!
Dialogue: 0,0:05:17.79,0:05:22.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senior Mizunouchi, 'kan?\NKacamata itu keren sekali, ya.
Dialogue: 0,0:05:22.07,0:05:26.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namaku Mizunoe! Apa-apaan kamu ini!?\NSeenaknya saja... Hah!?
Dialogue: 0,0:05:26.37,0:05:30.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kena, deh! Tadi lihat, 'kan!?\NPandangannya ke arah putingku, 'kan!?
Dialogue: 0,0:05:31.04,0:05:32.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, benar... Eh!?
Dialogue: 0,0:05:32.94,0:05:37.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, cowok itu gampang sekali\Nditebak, dasar mesum.
Dialogue: 0,0:05:37.60,0:05:40.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, bukan... Terlebih lagi,\Nkamu juga anggota OSIS?!
Dialogue: 0,0:05:41.10,0:05:47.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan ganti topik dong, kita kan lagi\Nbahas intipan Niorse Mesum.
Dialogue: 0,0:05:47.67,0:05:51.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, Niorse, kalau sudah begini\Nharus memberiku sesuatu, 'kan?
Dialogue: 0,0:05:51.82,0:05:54.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena ini baru yang pertama,\Njadi berikan 5000 yen sa...
Dialogue: 0,0:06:00.63,0:06:01.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, ya.
Dialogue: 0,0:06:01.96,0:06:06.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak ini anggota OSIS tapi suka\Nmenjebak cowok lain, kebiasaan...
Dialogue: 0,0:06:06.57,0:06:07.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa orang seperti itu bisa bergabung?
Dialogue: 0,0:06:08.88,0:06:11.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perkenalkan, ini Tanchan,\Nbagian Humas.
Dialogue: 0,0:06:12.14,0:06:14.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski penampilannya begini,\Ntapi dia ini anak lelaki.
Dialogue: 0,0:06:14.16,0:06:17.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang begini anggota OSIS,\Ndunia sudah mau kiamat.
Dialogue: 0,0:06:17.08,0:06:18.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Lelaki?
Dialogue: 0,0:06:18.70,0:06:22.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, bukannya sudah jelas karena\Nputingnya kelihatan? Di TV begini?
Dialogue: 0,0:06:22.51,0:06:23.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Masuk akal, sih...
Dialogue: 0,0:06:23.88,0:06:26.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, mungkin sekarang\Nsudah jadi cewek, sih.
Dialogue: 0,0:06:26.45,0:06:27.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:06:27.69,0:06:29.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lantainya jadi kotor.
Dialogue: 0,0:06:29.97,0:06:32.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa tolong bersihkan pakai ini?\NMaaf, ya, merepotkan.
Dialogue: 0,0:06:32.92,0:06:34.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Ah, aku tidak keberatan.
Dialogue: 0,0:06:35.51,0:06:39.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak kusangka tugas pertamaku\Nmembersihkan kelakuan orang mesum.
Dialogue: 0,0:06:39.97,0:06:42.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm, kain ini bentuknya aneh...
Dialogue: 0,0:06:44.06,0:06:45.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:06:45.41,0:06:48.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dor. Kejutan!\NBercanda.
Dialogue: 0,0:06:49.21,0:06:50.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Isengnya jelek banget, dah!
Dialogue: 0,0:06:50.59,0:06:53.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak suka yang begini, ya?
Dialogue: 0,0:06:53.27,0:06:57.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu-Bukan soal suka atau tidak,\Ntolong lebih santun, dong.
Dialogue: 0,0:06:57.84,0:06:59.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, menunggu lama.
Dialogue: 0,0:06:59.59,0:07:01.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rapatnya tidak selesai-selesai tadi,
Dialogue: 0,0:07:01.44,0:07:04.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hari ini ada anak baru yang datang, ya...
Dialogue: 0,0:07:05.63,0:07:07.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu celana dalamku!?
Dialogue: 0,0:07:07.27,0:07:08.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, siapa!?
Dialogue: 0,0:07:08.79,0:07:10.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kau lakukan!?
Dialogue: 0,0:07:10.48,0:07:11.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, bukan. Aku...
Dialogue: 0,0:07:11.70,0:07:13.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu barang jatuh yang\Nkutemukan kemarin.
Dialogue: 0,0:07:14.08,0:07:15.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Barang jatuh?
Dialogue: 0,0:07:15.50,0:07:17.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf jadi salah paham.
Dialogue: 0,0:07:18.04,0:07:18.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senior?
Dialogue: 0,0:07:18.78,0:07:20.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu-Bukan begitu!
Dialogue: 0,0:07:20.12,0:07:21.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak polos, ya.
Dialogue: 0,0:07:22.70,0:07:24.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan darah ini?
Dialogue: 0,0:07:24.36,0:07:27.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi tidak enak karena tidak sadar...
Dialogue: 0,0:07:27.52,0:07:28.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga, Ume.
Dialogue: 0,0:07:29.62,0:07:32.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dada besar yang sedang mencuci\Ncelana dalam di sana adalah ketua OSIS.
Dialogue: 0,0:07:32.79,0:07:34.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketua OSIS? Orang itu?
Dialogue: 0,0:07:34.95,0:07:38.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski terlihat seperti itu\Ndia unggul secara akademik dan olahraga.
Dialogue: 0,0:07:39.24,0:07:42.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya karena sedang mencuci celana dalam,\Njangan remehkan dia, ya.
Dialogue: 0,0:07:42.57,0:07:43.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang itu...
Dialogue: 0,0:07:44.52,0:07:46.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, ya. Mizunoe.
Dialogue: 0,0:07:46.83,0:07:49.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski terlambat, perkenalkan,\Naku Ketua OSIS, Kotobuki.
Dialogue: 0,0:07:49.83,0:07:51.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh kujelaskan tentang\Ntugasmu di OSIS?
Dialogue: 0,0:07:52.05,0:07:52.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, baik
Dialogue: 0,0:07:53.34,0:07:56.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bagan OSIS dan organisasi terkait.
Dialogue: 0,0:07:56.40,0:07:59.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga sudah menuliskan tugas\Nmasing-masing bagian.
Dialogue: 0,0:08:00.14,0:08:03.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf agak banyak, tapi kuharap bisa\Ndipahami dalam minggu ini.
Dialogue: 0,0:08:04.26,0:08:07.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat, sekali baca saja sudah bisa\Nlangsung paham.
Dialogue: 0,0:08:08.14,0:08:11.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, ini daftar program yang\Nsedang kukerjakan.
Dialogue: 0,0:08:11.81,0:08:14.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tujuan utamanya membangun relasi\Ndengan warga sekitar.
Dialogue: 0,0:08:14.58,0:08:18.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu tertarik untuk membacanya,\Naku akan senang sekali.
Dialogue: 0,0:08:18.62,0:08:20.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia ketua OSIS betulan, ya.
Dialogue: 0,0:08:20.62,0:08:22.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Me-Memang, kok.
Dialogue: 0,0:08:22.46,0:08:24.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hampir dianggap\Nmanusia celana dalam, ya.
Dialogue: 0,0:08:26.26,0:08:30.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kira-kira itulah tugas Mizunoe\Nsebagai sekretaris.
Dialogue: 0,0:08:30.82,0:08:31.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:08:31.47,0:08:33.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar kamu pintar dalam sastra,\Nekspektasiku cukup tinggi, lo.
Dialogue: 0,0:08:34.20,0:08:37.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku biasa peringkat 1 dalam try-out, sih.
Dialogue: 0,0:08:37.61,0:08:40.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat, ya. Bagaimana caranya bisa\Ndapat nilai segitu?
Dialogue: 0,0:08:40.68,0:08:44.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, kemampuan bahasa itu bukan\Nsesuatu yang bisa dipelajari dalam semalam.
Dialogue: 0,0:08:44.82,0:08:48.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harus dikembangkan melalui penggunaan\Nkata dalam keseharian dengan sepenuh hati.
Dialogue: 0,0:08:49.05,0:08:55.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak memandang kata sebagai alat, namun\Nberusaha meraih keindahan dalam untaian kata.
Dialogue: 0,0:08:55.37,0:08:58.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan kata lain, perlu punya\Nrasa cinta terhadap kata-kata, begitu.
Dialogue: 0,0:08:58.57,0:08:59.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, menjijikkan.
Dialogue: 0,0:09:00.15,0:09:01.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apanya?
Dialogue: 0,0:09:01.23,0:09:06.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, Mizunoe, untuk hari ini kamu\Nmulai mengamati pekerjaan setiap anggota.
Dialogue: 0,0:09:06.66,0:09:08.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, mengamati?\NSebagai sekretaris...?
Dialogue: 0,0:09:09.10,0:09:12.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, sebenarnya pekerjaan sekretaris\Ntidak banyak.
Dialogue: 0,0:09:12.31,0:09:14.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kuharap kamu bisa bantu\Npekerjaan anggota yang lain.
Dialogue: 0,0:09:15.36,0:09:16.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membantu...
Dialogue: 0,0:09:17.19,0:09:20.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan kata lain,\Nmembereskan kelakuan mereka, ya.
Dialogue: 0,0:09:21.97,0:09:24.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, mulai denganku sebagai Humas, ya.
Dialogue: 0,0:09:24.56,0:09:25.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berisik.
Dialogue: 0,0:09:25.24,0:09:26.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, mohon bantuannya...
Dialogue: 0,0:09:26.83,0:09:32.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, tapi aku ini sangat sibuk,\Nbagaimana, ya?
Dialogue: 0,0:09:32.18,0:09:33.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya tidak bisa.
Dialogue: 0,0:09:34.45,0:09:35.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, oke. Ya sudah.
Dialogue: 0,0:09:36.78,0:09:37.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lepaskan kakimu!
Dialogue: 0,0:09:38.39,0:09:43.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Humas, ya... Mempromosikan kegiatan OSIS?\NAku tidak suka pamer begitu.
Dialogue: 0,0:09:44.06,0:09:46.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Niorse ini naif sekali.
Dialogue: 0,0:09:46.32,0:09:47.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tutup kakimu.
Dialogue: 0,0:09:47.20,0:09:50.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat, ini grafik jumlah pengunjung
Dialogue: 0,0:09:50.37,0:09:52.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di festival kebudayaan kita.
Dialogue: 0,0:09:52.40,0:09:53.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tahun lalu meningkat drastis!?
Dialogue: 0,0:09:54.11,0:09:57.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, dong. Itu semua berkat\Nkemampuan Humas-ku.
Dialogue: 0,0:09:57.94,0:10:02.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu memang hebat, sih, memberikan\Nsemangat bagi sekolah juga.
Dialogue: 0,0:10:02.11,0:10:04.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi sebenarnya apa yang kamu lakukan\Nuntuk bisa mencapai itu?
Dialogue: 0,0:10:04.59,0:10:07.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku unggah ini di akun resmi dan jadi viral.
Dialogue: 0,0:10:07.28,0:10:08.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei. Cepat pecat orang ini.
Dialogue: 0,0:10:09.08,0:10:11.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengunggah tentang pengalaman pertama\Ndi akun resmi, dasar kamu ini...
Dialogue: 0,0:10:12.04,0:10:15.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Ini tentang pengalaman\Nmengecat rambut, lo.
Dialogue: 0,0:10:15.11,0:10:15.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ha?
Dialogue: 0,0:10:15.60,0:10:23.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kira apa? Niorse yang naif ini\Nmembayangkan apa dari kata "pertama"?
Dialogue: 0,0:10:23.46,0:10:25.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Uwah, wajahnya merah!
Dialogue: 0,0:10:25.21,0:10:27.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, hentikan, bodoh!
Dialogue: 0,0:10:27.08,0:10:31.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sembunyi. Tunjukkan wajah\Nmalu-malu itu lebih banyak lagi.
Dialogue: 0,0:10:33.41,0:10:35.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ainipple-ku!
Dialogue: 0,0:10:39.73,0:10:41.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berikutnya bendahara, ya.
Dialogue: 0,0:10:42.22,0:10:45.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bendahara itu kesannya banyak\Nberhubungan dengan angka.
Dialogue: 0,0:10:45.24,0:10:47.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kita bisa pakai perangkat lunak\Nuntuk hitungan rumitnya.
Dialogue: 0,0:10:47.15,0:10:47.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dekatnya...
Dialogue: 0,0:10:47.88,0:10:50.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini catatan anggaran tahun lalu.
Dialogue: 0,0:10:50.57,0:10:53.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita buat rancangan anggaran\Nberdasarkan ini, lalu...
Dialogue: 0,0:10:53.06,0:10:53.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa malah mendekat?
Dialogue: 0,0:10:54.69,0:10:57.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berikutnya, kita informasikan anggaran\Nyang akan diterima ke tiap ekskul.
Dialogue: 0,0:10:57.91,0:10:58.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:10:58.95,0:11:04.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak semua klub mendapat sesuai keinginan,\Njadi kadang kita harus menerima protes.
Dialogue: 0,0:11:05.06,0:11:09.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski sulit, ini tetap pekerjaan penting,\Nayo semangat.
Dialogue: 0,0:11:09.69,0:11:11.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senior ini berhati manusia juga...
Dialogue: 0,0:11:12.66,0:11:14.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hmm, 500 yen.
Dialogue: 0,0:11:14.67,0:11:17.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa!? Seharga set makan A!?
Dialogue: 0,0:11:17.21,0:11:18.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami sudah menghasilkan banyak\Npencapaian.
Dialogue: 0,0:11:19.06,0:11:23.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, 17 dari 19 pencapaian itu tidak bisa\Ndinilai dengan uang.
Dialogue: 0,0:11:23.83,0:11:25.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya penilaian di BOOB OFF!?
Dialogue: 0,0:11:26.00,0:11:28.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kouki bahkan menang di\Nkompetisi gitar...
Dialogue: 0,0:11:29.04,0:11:31.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada 1 laporan masuk.
Dialogue: 0,0:11:31.15,0:11:32.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?! Laporan apa?
Dialogue: 0,0:11:32.77,0:11:34.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepulang sekolah, di ruang klub\Nada aktivitas lesbi...
Dialogue: 0,0:11:34.32,0:11:36.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial, kondisinya kurang bagus,\Nayo kabur!
Dialogue: 0,0:11:36.19,0:11:37.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka ngapain, sih?
Dialogue: 0,0:11:38.25,0:11:39.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dipotong 40.000 yen.
Dialogue: 0,0:11:39.65,0:11:41.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke. Ayo kita berenang di alam terbuka!
Dialogue: 0,0:11:41.64,0:11:42.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, Kapten!
Dialogue: 0,0:11:43.06,0:11:45.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, semester depan!\NBerusahalah untuk semester depan!
Dialogue: 0,0:11:46.06,0:11:47.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dipotong 20 persen.
Dialogue: 0,0:11:48.08,0:11:50.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa beli pakan kalian lagi.
Dialogue: 0,0:11:50.49,0:11:53.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daripada melihat kalian kurus\Ndan kelaparan, sebaiknya aku...
Dialogue: 0,0:11:53.32,0:11:56.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Bagaimana kalau coba minta\Nsisa makanan dari kantin?
Dialogue: 0,0:11:56.29,0:11:57.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dipotong setengah.
Dialogue: 0,0:11:57.45,0:11:59.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa tingkatkan protein lagi...
Dialogue: 0,0:12:00.04,0:12:02.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, ototku bergerak dengan sendirinya.
Dialogue: 0,0:12:03.05,0:12:06.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau berkeliling dengan junior yang imut\Nmemang lebih menyenangkan, ya.
Dialogue: 0,0:12:06.87,0:12:08.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baguslah kalau begitu...
Dialogue: 0,0:12:08.99,0:12:12.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi kira-kira begitulah tugasnya,\Nkamu bisa?
Dialogue: 0,0:12:12.62,0:12:13.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bi-Bisa.
Dialogue: 0,0:12:14.20,0:12:16.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak masalah dengan tugasnya.
Dialogue: 0,0:12:16.33,0:12:19.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, anggotanya...
Dialogue: 0,0:12:19.82,0:12:22.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, pasti kamu tidak nyaman\Nberisik begini.
Dialogue: 0,0:12:23.04,0:12:24.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, bukan begitu.
Dialogue: 0,0:12:24.77,0:12:31.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, mereka menantikan kedatanganmu,\Nbahkan Terui sampai gugup sekali.
Dialogue: 0,0:12:31.53,0:12:36.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini belum semuanya berkumpul,\Ntapi mereka semua orang baik, karena itu...
Dialogue: 0,0:12:36.68,0:12:42.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Percayalah pada mereka,\Nsebagai rekan perwakilan seluruh murid.
Dialogue: 0,0:12:42.96,0:12:47.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Intinya, mohon bantuannya untuk\Nsetahun ini, ya, Mizunoe.
Dialogue: 0,0:12:47.84,0:12:48.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:12:49.50,0:12:53.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini? Rasanya seperti prolog novel\Ntema masa muda sekolah.
Dialogue: 0,0:12:53.96,0:12:57.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dadaku berdegup kencang seakan ini\Nawal dari sesuatu yang besar...
Dialogue: 0,0:12:57.72,0:13:02.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebentar!\NKenapa putingku jadi kena sensor?!
Dialogue: 0,0:13:02.64,0:13:05.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya ini?!\NJangan-jangan pen...
Dialogue: 0,0:13:05.37,0:13:10.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf mengganggu, sudah kuselesaikan,\Nsilakan lanjut.
Dialogue: 0,0:13:10.57,0:13:12.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, eng...\NMohon bantuannya.
Dialogue: 0,0:13:13.06,0:13:14.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, ya, pasti bukan.
Dialogue: 0,0:13:15.57,0:13:16.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon bantuannya!
Dialogue: 0,0:13:19.59,0:13:21.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa tolong tebalkan\Nhuruf yang di sana?
Dialogue: 0,0:13:21.96,0:13:22.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, baik.
Dialogue: 0,0:13:24.11,0:13:25.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Ada apa?
Dialogue: 0,0:13:25.64,0:13:30.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, kalau seperti ini,\Nrasanya kita benar-benar jadi 1 tim, ya.
Dialogue: 0,0:13:31.37,0:13:33.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaikan kumpulan bunga violet mekar
Dialogue: 0,0:13:33.35,0:13:35.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Oh, jadinya lumayan bagus, ya.\N- dengan anggunnya di celah retakan.
Dialogue: 0,0:13:37.33,0:13:40.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, yang ini sudah,\Nberikutnya merah...
Dialogue: 0,0:13:40.86,0:13:41.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah.
Dialogue: 0,0:13:43.28,0:13:46.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maaf, tidak sengaja!
Dialogue: 0,0:13:47.57,0:13:52.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malah jadi gandengan ala kekasih, ya!\NAku jadi deg-degan!
Dialogue: 0,0:13:53.19,0:13:54.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, ya... Aku juga.
Dialogue: 0,0:13:55.28,0:13:58.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bisa pakai yang itu?\NAku bawa sendiri, kok.
Dialogue: 0,0:13:59.06,0:14:00.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-baik.
Dialogue: 0,0:14:00.71,0:14:01.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dewasa sekali.
Dialogue: 0,0:14:02.26,0:14:05.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memegang tangan cowok.
Dialogue: 0,0:14:05.07,0:14:06.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya kekanakan.
Dialogue: 0,0:14:06.72,0:14:11.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama kalinya pegang!\NRasanya hangat, keras, dan besar...!
Dialogue: 0,0:14:11.57,0:14:12.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm?
Dialogue: 0,0:14:12.08,0:14:14.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, diam-diam mesum
Dialogue: 0,0:14:14.19,0:14:17.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hangat, panas, besar...
Dialogue: 0,0:14:20.81,0:14:23.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini kita lakukan kegiatan\Nmemberi salam!
Dialogue: 0,0:14:23.15,0:14:24.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Aku terlambat ke sekolah.\N- Siap.
Dialogue: 0,0:14:24.11,0:14:25.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Aku terlambat ke sekolah.\N- Cukup memberi salam pada orang di jalan, 'kan?
Dialogue: 0,0:14:25.41,0:14:27.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cukup memberi salam pada orang di jalan, 'kan?
Dialogue: 0,0:14:27.87,0:14:31.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, lakukan dengan penuh semangat,\Njangan bikin malu selempangan ini, ya!
Dialogue: 0,0:14:31.10,0:14:32.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, selain itu...
Dialogue: 0,0:14:32.36,0:14:34.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, dalam kesempatan ini kita juga...
Dialogue: 0,0:14:34.99,0:14:39.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melakukan inspeksi barang bawaan,\Nmenyenangkan, bukan, Ume?
Dialogue: 0,0:14:39.63,0:14:41.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh!? Aku, sih... Begitulah.
Dialogue: 0,0:14:42.09,0:14:48.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga mau menegakkan aturan, sih,\Ntapi tidak yakin bagaimana cara inspeksi...
Dialogue: 0,0:14:48.68,0:14:52.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang aku sedikit terlalu bersemangat...
Dialogue: 0,0:14:52.85,0:14:58.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, hari ini kita fokus memberi salam dulu,\Nbaru pelan-pelan melakukan inspeksi.
Dialogue: 0,0:14:58.79,0:14:59.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senior Terui...
Dialogue: 0,0:15:00.04,0:15:01.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, permen tidak boleh, ya.
Dialogue: 0,0:15:02.00,0:15:03.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cemilanku!
Dialogue: 0,0:15:03.34,0:15:04.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harus tahan...
Dialogue: 0,0:15:04.06,0:15:05.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau melakukannya...
Dialogue: 0,0:15:08.09,0:15:10.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat pagi, maaf,\Nboleh dicek bawaannya?
Dialogue: 0,0:15:10.71,0:15:12.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa!? Tidak kedengaran...
Dialogue: 0,0:15:13.05,0:15:14.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak berjalan mulus sama sekali.
Dialogue: 0,0:15:15.11,0:15:17.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya kesulitan, ya, Mizunoe.
Dialogue: 0,0:15:17.52,0:15:20.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di saat seperti ini, coba keluarkan suara\Ndari bagian perut.
Dialogue: 0,0:15:20.83,0:15:21.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nih, sekitar sini
Dialogue: 0,0:15:22.17,0:15:24.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul begitu, lebih keras lagi!
Dialogue: 0,0:15:24.38,0:15:25.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan berusaha!
Dialogue: 0,0:15:26.17,0:15:28.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, ayo coba lagi!\NEh?
Dialogue: 0,0:15:28.99,0:15:33.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seragam berantakan, headphone, tas juga,\Nsemua pelanggaran diborong!
Dialogue: 0,0:15:33.72,0:15:36.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus menjatuhkan palu keadilan\Npada berandalan ini!
Dialogue: 0,0:15:36.88,0:15:37.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu yang di sana!
Dialogue: 0,0:15:38.95,0:15:39.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:15:39.54,0:15:40.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tan sialan!
Dialogue: 0,0:15:41.66,0:15:43.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Aku kan bukan kelinci?
Dialogue: 0,0:15:43.58,0:15:45.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Salahku karena terlalu imut, ya?\N- Dia, 'kan...?!
Dialogue: 0,0:15:45.24,0:15:48.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Merokok sambil jalan? Bisa-bisanya\Ndi lingkungan sekolah begini!
Dialogue: 0,0:15:48.62,0:15:50.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harus segera diberi peringatan...
Dialogue: 0,0:15:50.28,0:15:51.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh? Mizunoe, ya?
Dialogue: 0,0:15:53.56,0:15:58.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm, itu Klub Musik yang sering membuat onar!\NAku sudah bisa merasakan pelanggaran!
Dialogue: 0,0:15:59.17,0:16:02.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat pagi, maaf,\Nboleh dicek bawaannya?
Dialogue: 0,0:16:03.38,0:16:04.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke.
Dialogue: 0,0:16:04.13,0:16:05.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, permisi.
Dialogue: 0,0:16:06.30,0:16:08.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, rasanya...
Dialogue: 0,0:16:08.54,0:16:12.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, anu, ini... pelanggaran...\Njadi harus disita...
Dialogue: 0,0:16:14.20,0:16:16.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kalau akhirnya nangis, ngapain\Nsok keren begitu tadi?
Dialogue: 0,0:16:16.81,0:16:18.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gimana, nih? Itu kan belinya patungan...
Dialogue: 0,0:16:18.92,0:16:19.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan, tuh?
Dialogue: 0,0:16:20.10,0:16:22.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anggaran Klub Musik\Nminus 10.000 yen.
Dialogue: 0,0:16:24.32,0:16:26.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, kita berhasil menyita\Ncukup banyak, ya.
Dialogue: 0,0:16:26.94,0:16:30.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Anu... Bagaimana dengan barang\Nyang kusita ini?
Dialogue: 0,0:16:30.61,0:16:34.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, biasanya, sih, akan dimusnahkan,\Ntapi jarang-jarang dapat yang begini.
Dialogue: 0,0:16:35.17,0:16:37.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja, ya.
Dialogue: 0,0:16:37.33,0:16:40.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi dia sampai nangis,\Nlagipula bukan salah bukunya.
Dialogue: 0,0:16:40.62,0:16:42.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau baca bersama?
Dialogue: 0,0:16:43.04,0:16:44.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Kenapa?!
Dialogue: 0,0:16:44.72,0:16:48.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurut aturan, komik harus dimusnahkan,\Ntapi novel dan lainnya akan dikembalikan.
Dialogue: 0,0:16:49.38,0:16:53.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski itu buku porno, tapi kita harus\Nmengecek isinya untuk bisa tahu.
Dialogue: 0,0:16:53.50,0:16:56.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senior paham perasaanku, ya.
Dialogue: 0,0:16:56.52,0:16:58.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Te-Terima kasih.
Dialogue: 0,0:16:58.43,0:17:01.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan masalah, itu perasaan\Nyang sangat penting, lo.
Dialogue: 0,0:17:02.13,0:17:03.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, langsung saja.
Dialogue: 0,0:17:03.84,0:17:06.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ume memang cowok, ya.
Dialogue: 0,0:17:07.18,0:17:09.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, kita mulai dari halaman 1...
Dialogue: 0,0:17:09.82,0:17:10.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, baik.
Dialogue: 0,0:17:11.33,0:17:13.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya ampun, foto mesum semua.
Dialogue: 0,0:17:13.94,0:17:18.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang, sih, tapi penjelasannya ada\Nsedikit nilai sastranya.
Dialogue: 0,0:17:18.84,0:17:23.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Ah, saat menyentuh daerah intim yang\Nbasah kuyub, kejantanannya pun bergetar..."
Dialogue: 0,0:17:23.23,0:17:25.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebentar! Jangan dibaca dengan\Nsuara keras begitu!
Dialogue: 0,0:17:25.35,0:17:29.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berani sekali, ya.\NBagaimana menurutmu, Ume?
Dialogue: 0,0:17:29.31,0:17:30.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh!? Apa maksudnya "bagaimana"?
Dialogue: 0,0:17:30.70,0:17:34.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu suka tidak?\NLihat terbuka lebar begini.
Dialogue: 0,0:17:34.87,0:17:37.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, kan tidak ada\Nhubungannya dengan seleraku!
Dialogue: 0,0:17:37.95,0:17:40.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ngomong-ngomong, Ketua...\NKetua?
Dialogue: 0,0:17:40.82,0:17:43.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ehem! A-Ada apa?
Dialogue: 0,0:17:43.24,0:17:45.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang barusan menurut Ketua gimana?
Dialogue: 0,0:17:45.56,0:17:48.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, soal itu...
Dialogue: 0,0:17:50.44,0:17:53.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa sangat mesum, ya...
Dialogue: 0,0:17:53.86,0:17:54.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah...
Dialogue: 0,0:17:55.62,0:17:57.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pembicaraan itu sudah selesai.
Dialogue: 0,0:17:58.00,0:18:00.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang sedang dibicarakan soal kendama.
Dialogue: 0,0:18:00.67,0:18:03.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh!? Ah, tentu saja begitu, ya.
Dialogue: 0,0:18:03.69,0:18:08.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu Hiratsuka, Bu Hiratsuka,\Nrapatnya sudah mau dimulai
Dialogue: 0,0:18:08.44,0:18:10.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong segera menuju ruang staf.
Dialogue: 0,0:18:10.75,0:18:13.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kejantanannya... bergetar...
Dialogue: 0,0:18:13.48,0:18:15.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak, masih belum selesai?
Dialogue: 0,0:18:15.52,0:18:19.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, ini hari upacara sekolah.
Dialogue: 0,0:18:19.51,0:18:24.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}OSIS akan naik podium memberikan\Npresentasi, kalian sudah siap?
Dialogue: 0,0:18:24.46,0:18:31.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah, Sensei sendiri baik-baik saja?\NKelihatan seperti panda yang lesu.
Dialogue: 0,0:18:31.41,0:18:34.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}He? Guru pembimbing kan tidak ikut\Nngomong, aman siap kapan saja.
Dialogue: 0,0:18:35.27,0:18:36.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah kalau begitu.
Dialogue: 0,0:18:37.16,0:18:39.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, sudah mau dimulai...
Dialogue: 0,0:18:39.38,0:18:41.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, boleh ke toilet dulu?
Dialogue: 0,0:18:41.94,0:18:43.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya sudah siap?!
Dialogue: 0,0:18:44.60,0:18:46.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu Guru belum datang?
Dialogue: 0,0:18:46.75,0:18:49.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurang dari 5 menit lagi,\Napakah terjadi sesuatu?
Dialogue: 0,0:18:50.16,0:18:51.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti pup.
Dialogue: 0,0:18:51.84,0:18:53.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, mungkin merokok?
Dialogue: 0,0:18:53.50,0:18:58.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga, sebelumnya juga pernah merokok\Ndi toilet sampai alarm kebakaran menyala.
Dialogue: 0,0:18:58.82,0:19:01.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang lemah terhadap hasrat\Nkeinginannya, ya.
Dialogue: 0,0:19:01.79,0:19:03.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu datang ke kelas begitu saja\Ndalam keadaan basah.
Dialogue: 0,0:19:03.98,0:19:06.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Merasa malas untuk hal yang\Nmerepotkan, ya.
Dialogue: 0,0:19:07.04,0:19:09.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada akhirnya aku terlambat.
Dialogue: 0,0:19:09.50,0:19:12.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih telah berkumpul\Ndi sini hari ini.
Dialogue: 0,0:19:12.95,0:19:15.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia hafal semuanya?\NPertama-tama, saya sebagai ketua OSIS.
Dialogue: 0,0:19:15.13,0:19:17.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Akan menjelaskan laporan kegiatan OSIS\N- Improvisasi, dia sudah biasa.
Dialogue: 0,0:19:17.84,0:19:21.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagipula otaknya cerdas,\Nnamanya juga juara di sekolah.
Dialogue: 0,0:19:21.62,0:19:21.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami melakukan gerakan memberi salam.
Dialogue: 0,0:19:21.76,0:19:23.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Hebatnya.\N- Kami melakukan gerakan memberi salam.
Dialogue: 0,0:19:23.08,0:19:24.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal diam-diam mesum.
Dialogue: 0,0:19:24.60,0:19:25.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Karena itu...\N- Padahal diam-diam mesum.
Dialogue: 0,0:19:26.20,0:19:28.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berikutnya, presentasi dari\Nbagian Humas.
Dialogue: 0,0:19:29.25,0:19:30.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Giliran Otori, ya.
Dialogue: 0,0:19:30.87,0:19:36.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bisa? Ada banyak guru,\Njadi lakukan dengan benar, lo.
Dialogue: 0,0:19:36.24,0:19:37.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hmph!
Dialogue: 0,0:19:37.50,0:19:44.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, dari Humas, ini menunjukkan pengaruh\Nkegiatan sekolah dengan laju revitalisasi lokal.
Dialogue: 0,0:19:44.67,0:19:46.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia melakukannya dengan benar!\NBahkan ganti baju juga.
Dialogue: 0,0:19:47.01,0:19:48.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tumben sekali.
Dialogue: 0,0:19:48.63,0:19:50.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekian dari Humas.
Dialogue: 0,0:19:51.02,0:19:53.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa denganmu?\NSalah makan apa?
Dialogue: 0,0:19:53.91,0:19:58.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, ini sih gampang kalau aku serius,\Nngomong-ngomong...
Dialogue: 0,0:19:58.59,0:20:04.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ume bisa? Ada banyak guru,\Njadi lakukan dengan benar, lo.
Dialogue: 0,0:20:04.47,0:20:06.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berikutnya dari sekretaris.
Dialogue: 0,0:20:06.28,0:20:07.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di-Dia...!
Dialogue: 0,0:20:08.11,0:20:12.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat, aku benar-benar gugup, Ketua dan\NOtori melakukannya dengan sempurna.
Dialogue: 0,0:20:13.41,0:20:14.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga harus melakukannya\Ndengan baik!
Dialogue: 0,0:20:15.03,0:20:16.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, leganya.
Dialogue: 0,0:20:17.33,0:20:20.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, Mizunoe?\NWajahmu pucat, kebelet pup?
Dialogue: 0,0:20:20.83,0:20:22.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, ini gugup.
Dialogue: 0,0:20:22.32,0:20:26.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar kamu ini, kamu sudah mempersiapkan\Nbanyak hal untuk hari ini, 'kan?
Dialogue: 0,0:20:26.64,0:20:31.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu cuma perlu menunjukkan semua itu,\NAku lihat kok, busungkan dadamu.
Dialogue: 0,0:20:31.31,0:20:32.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu Guru...
Dialogue: 0,0:20:32.36,0:20:34.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, aku baru diberi tahu kemarin.
Dialogue: 0,0:20:34.31,0:20:36.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Besok tolong, ya.
Dialogue: 0,0:20:36.08,0:20:36.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:20:37.10,0:20:38.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang sudah kamu lihat, sih?
Dialogue: 0,0:20:39.42,0:20:44.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, selanjutnya, salam dari sekretaris kami\Nyang baru bergabung, Mizunoe Ume.
Dialogue: 0,0:20:44.94,0:20:47.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ugh, orangnya banyak sekali!
Dialogue: 0,0:20:47.87,0:20:49.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sekretaris...
Dialogue: 0,0:20:49.40,0:20:50.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena gugup suaraku...
Dialogue: 0,0:20:51.29,0:20:52.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, Bu Guru...
Dialogue: 0,0:20:52.88,0:20:55.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat ke sini, Hiratsuka!
Dialogue: 0,0:20:55.54,0:20:58.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada akhirnya gugupku mereda dan\Nsemua berjalan dengan baik, tapi...
Dialogue: 0,0:20:58.38,0:21:00.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ah, dia panggil Bu Hiratsuka begitu...\N- Entah kenapa para murid jadi ribut.
Dialogue: 0,0:21:00.85,0:21:02.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, jangan-jangan mereka berdua...
Dialogue: 0,0:21:02.90,0:21:07.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf jadi ribut, padahal berikutnya\Ngiliran Senior.
Dialogue: 0,0:21:07.73,0:21:09.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, bukan masalah, kok.
Dialogue: 0,0:21:09.96,0:21:12.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya bendahara, Terui.
Dialogue: 0,0:21:13.58,0:21:14.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya ini pemakaman...?
Dialogue: 0,0:21:16.14,0:21:17.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekian dari OSIS.
Dialogue: 0,0:21:18.25,0:21:19.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih atas perhatiannya.
Dialogue: 0,0:21:19.13,0:21:20.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya selesai, ya.\NTerima kasih atas perhatiannya.
Dialogue: 0,0:21:20.37,0:21:20.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya selesai, ya.
Dialogue: 0,0:21:20.86,0:21:21.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:21:22.11,0:21:23.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membosankan!
Dialogue: 0,0:21:27.00,0:21:28.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tan, ini ketinggalan...
Dialogue: 0,0:21:34.10,0:21:36.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke-Kelincinya lagi...?!
Dialogue: 0,0:21:36.11,0:21:39.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, itu video hewan yang kuambil\Nsebelumnya, lucu, 'kan?
Dialogue: 0,0:21:39.63,0:21:41.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kepala sekolah!? Itu...
Dialogue: 0,0:21:41.28,0:21:42.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi kawin, 'kan?!
Dialogue: 0,0:21:42.79,0:21:44.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketua!
Dialogue: 0,0:21:44.18,0:21:44.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:21:44.58,0:21:44.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tolong ditutup!\N- Eh?
Dialogue: 0,0:21:44.72,0:21:46.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong ditutup!
Dialogue: 0,0:21:47.25,0:21:47.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mamografi...!?
Dialogue: 0,0:21:47.34,0:21:48.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ma, maaf!\N- Mamografi...!?
Dialogue: 0,0:21:48.45,0:21:48.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa tiba-tiba mamografi...!?
Dialogue: 0,0:21:48.99,0:21:50.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ap-apa-apa...!?\N- Kenapa tiba-tiba mamografi...!?
Dialogue: 0,0:21:50.38,0:21:52.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Upacara itu pun menjadi legenda.
Dialogue: 0,0:21:53.25,0:21:55.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa jadi pengantin lagi.
Dialogue: 0,0:21:55.26,0:21:57.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begini, Ume harus\Ntanggung jawab, ya.
Dialogue: 0,0:21:58.04,0:21:59.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:21:59.12,0:22:01.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan Mizunoe harus tanggung jawab\Nterhadap Kotobuki.
Dialogue: 0,0:22:02.39,0:22:03.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kakak!?
Dialogue: 0,0:22:03.13,0:22:03.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ume... tanggung-jawab...\N- Hei, kakak!?
Dialogue: 0,0:22:03.70,0:22:05.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ume... tanggung-jawab...
