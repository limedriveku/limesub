Dialogue: 0,0:04:13.76,0:04:16.76,sign,,0000,0000,0000,,KELAS 2 SMA, TERUI ARISU
Dialogue: 0,0:05:14.72,0:05:17.24,sign,,0000,0000,0000,,SMP KELAS 3, OTORI TAN
Dialogue: 0,0:06:59.59,0:07:01.44,sign,,0000,0000,0000,,KELAS 3 SMA, KOTOBUKI HISAKO
Dialogue: 0,0:07:32.79,0:07:34.66,sign,,0000,0000,0000,,KETUA OSIS KITA, HISAKOCHAN
Dialogue: 0,0:09:21.97,0:09:24.37,sign,,0000,0000,0000,,HUMAS, OTORI TAN
