Dialogue: 0,0:09:50.37,0:09:52.37,sign,,0000,0000,0000,,TAHUN LALU
Dialogue: 0,0:10:04.59,0:10:08.70,sign,,0000,0000,0000,,KAPAN PERTAMA KALI KAMU MELAKUKANNYA?
Dialogue: 0,0:10:39.73,0:10:41.83,sign,,0000,0000,0000,,BENDAHARA, TERUI ARISU
Dialogue: 0,0:11:11.89,0:11:12.63,sign,,0000,0000,0000,,EKSKUL MUSIK MODERN
Dialogue: 0,0:11:37.62,0:11:38.18,sign,,0000,0000,0000,,KLUB RENANG
Dialogue: 0,0:11:45.35,0:11:45.69,sign,,0000,0000,0000,,KLUB MAKHLUK HIDUP
Dialogue: 0,0:11:56.17,0:11:56.29,sign,,0000,0000,0000,,KLUB BINARAGA
