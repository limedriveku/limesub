Dialogue: 0,0:23:35.01,0:23:36.01,sign,,0000,0000,0000,,CUPLIKAN EPISODE BERIKUTNYA
Dialogue: 0,0:23:36.01,0:23:38.29,sign,,0000,0000,0000,,KEMAH OSIS! HUJAN DAN UME, BERDUA\NDI BAWAH PAYUNG OPERASI BESAR UMETANTAN!
Dialogue: 0,0:23:38.29,0:23:39.93,sign,,0000,0000,0000,,NANTIKAN EPISODE BERIKUTNYA, YA!
Dialogue: 0,0:00:05.45,0:00:06.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kotak saran?
Dialogue: 0,0:00:07.04,0:00:08.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata kita punya benda begituan, ya.
Dialogue: 0,0:00:08.79,0:00:11.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, aku menantikannya tiap bulan.
Dialogue: 0,0:00:11.50,0:00:13.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kira-kira ada banyak atau tidak, ya?
Dialogue: 0,0:00:18.87,0:00:19.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dua lembar.
Dialogue: 0,0:00:21.08,0:00:22.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keluar banyak.
Dialogue: 0,0:00:22.31,0:00:24.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu rupanya.
Dialogue: 0,0:00:28.33,0:00:30.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biasanya memang sebegini?
Dialogue: 0,0:00:30.08,0:00:32.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, kalau tidak kosong, cuma satu lembar.
Dialogue: 0,0:00:32.40,0:00:34.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bulan ini malah ada tiga lembar.
Dialogue: 0,0:00:34.20,0:00:37.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya baru dipasang tahun ini.
Dialogue: 0,0:00:37.59,0:00:39.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang buat, lo.
Dialogue: 0,0:00:39.79,0:00:40.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:00:40.95,0:00:42.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kenapa baru mulai tahun ini?
Dialogue: 0,0:00:42.91,0:00:47.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alasan resminya, supaya OSIS\Nbisa menampung banyak aspirasi.
Dialogue: 0,0:00:47.83,0:00:50.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi sebenarnya juga\Nsupaya Komachan punya kerjaan.
Dialogue: 0,0:00:50.25,0:00:51.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:00:51.66,0:00:53.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kira-kira isinya apa, ya?
Dialogue: 0,0:00:53.41,0:00:54.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saran seperti apa yang masuk?
Dialogue: 0,0:00:54.87,0:00:57.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang pertama dulu.
Dialogue: 0,0:00:57.45,0:00:58.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bilang saja ke bagian Tata Usaha.
Dialogue: 0,0:00:58.78,0:01:00.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lembar kedua.
Dialogue: 0,0:01:00.16,0:01:02.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dua-duanya soal bisbol.
Dialogue: 0,0:01:02.04,0:01:04.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lembar ketiga... struk belanja.
Dialogue: 0,0:01:04.16,0:01:05.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedendam apa, sih, dia sama roti?
Dialogue: 0,0:01:05.83,0:01:07.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini, sih, sudah jadi kotak bisbol.
Dialogue: 0,0:01:07.45,0:01:11.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya kita beri tahu lebih banyak orang\Nsoal kotak saran ini, ya.
Dialogue: 0,0:01:11.25,0:01:12.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini juga demi Komachan.
Dialogue: 0,0:01:13.45,0:01:15.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,\Naku tempel di papan pengumuman.
Dialogue: 0,0:01:15.62,0:01:17.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Papan pengumuman?
Dialogue: 0,0:01:17.08,0:01:18.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini zaman apa, sih?
Dialogue: 0,0:01:18.25,0:01:19.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuno.
Dialogue: 0,0:01:19.41,0:01:20.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berisik.
Dialogue: 0,0:01:20.20,0:01:21.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pakai tulisan itu tidak mempan.
Dialogue: 0,0:01:21.75,0:01:24.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang-orang malas baca, satu baris pun ogah.
Dialogue: 0,0:01:24.16,0:01:26.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang yang lagi tren itu video pendek.
Dialogue: 0,0:01:26.41,0:01:30.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dibawakan oleh influencer populer,\Ndengan musik ceria dan konten yang ringkas.
Dialogue: 0,0:01:30.25,0:01:32.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang meyakinkan...
Dialogue: 0,0:01:32.87,0:01:35.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang cukup 20.000 yen,\Naku bantu promosikan.
Dialogue: 0,0:01:35.83,0:01:37.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi influencer populernya itu kamu?
Dialogue: 0,0:01:37.58,0:01:41.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi video pendek mungkin bisa juga, ya.
Dialogue: 0,0:01:41.95,0:01:44.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, bagaimana kalau kita\Nmain sketsa komedi?
Dialogue: 0,0:01:44.91,0:01:46.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku suka yang lucu-lucu.
Dialogue: 0,0:01:46.58,0:01:48.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tawa bikin orang gampang ingat.
Dialogue: 0,0:01:48.37,0:01:50.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dipakai untuk promosi,\Nhasilnya pasti bagus.
Dialogue: 0,0:01:50.79,0:01:52.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu.
Dialogue: 0,0:01:52.75,0:01:53.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agak tak terduga.
Dialogue: 0,0:01:55.08,0:01:57.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski ini pertama kalinya\Naku mencoba sketsa,
Dialogue: 0,0:01:57.25,0:01:58.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}boleh juga.
Dialogue: 0,0:01:58.37,0:01:59.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sok jadi artis.
Dialogue: 0,0:02:00.29,0:02:01.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena ini soal kotak saran,
Dialogue: 0,0:02:01.54,0:02:03.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita bikin sketsa ruang konsultasi saja.
Dialogue: 0,0:02:03.58,0:02:04.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti ini.
Dialogue: 0,0:02:05.25,0:02:06.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang mau dimulai.
Dialogue: 0,0:02:09.50,0:02:11.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita mulai.
Dialogue: 0,0:02:11.41,0:02:13.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Ruang Konsultasi Aku Terlalu Imut!"
Dialogue: 0,0:02:13.62,0:02:17.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini pun aku akan menyebarkan\Nseluruh cinta di Bumi untuk kalian.
Dialogue: 0,0:02:17.62,0:02:19.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, konsultasi hari ini...
Dialogue: 0,0:02:31.20,0:02:32.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei!
Dialogue: 0,0:02:32.75,0:02:35.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ngapain masuk ke khayalanku?
Dialogue: 0,0:02:35.78,0:02:37.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak boleh?
Dialogue: 0,0:02:37.83,0:02:41.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kupikir ini perpaduan sempurna antara\Nlelucon pembuka dan lawakan absurd...
Dialogue: 0,0:02:41.95,0:02:45.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penonton punya standar tinggi\Nuntuk gaya lawakan seperti itu.
Dialogue: 0,0:02:45.87,0:02:48.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, komedian zaman sekarang\Nsudah tidak main pukul lagi.
Dialogue: 0,0:02:48.04,0:02:49.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu?
Dialogue: 0,0:02:49.83,0:02:51.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal imut.
Dialogue: 0,0:02:51.29,0:02:53.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau yang seperti ini?
Dialogue: 0,0:02:53.20,0:02:54.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo...
Dialogue: 0,0:02:55.04,0:02:57.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya, sketsanya kita tunda dulu.
Dialogue: 0,0:02:58.37,0:03:00.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bikin pusing, ya.
Dialogue: 0,0:03:00.79,0:03:02.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Komachan, ada ide bagus?
Dialogue: 0,0:03:03.95,0:03:06.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, aku sedang memikirkan sesuatu.
Dialogue: 0,0:03:06.29,0:03:07.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sedang membaca\Npermintaan-permintaan itu.
Dialogue: 0,0:03:07.87,0:03:09.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih baca saran sampah begitu?
Dialogue: 0,0:03:09.75,0:03:13.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak kepikiran\Ncara memperluas lapangan bisbolnya.
Dialogue: 0,0:03:13.58,0:03:16.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin bisa kalau kita tarik ramai-ramai.
Dialogue: 0,0:03:16.00,0:03:17.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, mana bisa.
Dialogue: 0,0:03:18.37,0:03:22.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga, tenagaku kecil.
Dialogue: 0,0:03:22.00,0:03:24.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan itu masalahnya...
Dialogue: 0,0:03:24.54,0:03:28.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutku tidak perlu dipikirkan\Nsampai seserius itu.
Dialogue: 0,0:03:28.20,0:03:31.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang memasukkan saran itu\Npasti juga tidak berpikir panjang.
Dialogue: 0,0:03:33.50,0:03:37.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi ini permintaan\Nyang susah payah kita dapatkan.
Dialogue: 0,0:03:37.37,0:03:40.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bilang begitu lagi.
Dialogue: 0,0:03:42.12,0:03:43.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga, ya.
Dialogue: 0,0:03:43.29,0:03:44.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memperluas lapangannya memang sulit,
Dialogue: 0,0:03:44.91,0:03:47.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi pasti ada yang bisa kita lakukan\Nuntuk Ekskul Bisbol.
Dialogue: 0,0:03:49.37,0:03:50.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih...
Dialogue: 0,0:03:51.91,0:03:53.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Michinoku!
Dialogue: 0,0:03:56.91,0:03:58.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak apa-apa?
Dialogue: 0,0:03:58.87,0:04:00.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bolanya seperti tersedot ke perutnya.
Dialogue: 0,0:04:00.91,0:04:03.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi, lihat bola kami, tidak?
Dialogue: 0,0:04:06.00,0:04:10.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan manfaatkan kotak saran, ya.
Dialogue: 0,0:04:10.66,0:04:13.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon!
Dialogue: 0,0:04:14.08,0:04:16.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ini lagi galang dana, ya?\N- Banyak sekali.
Dialogue: 0,0:04:16.04,0:04:18.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkat bantuan antusias Ekskul Bisbol,
Dialogue: 0,0:04:18.41,0:04:20.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kotak saran pun ramai luar biasa.
Dialogue: 0,0:04:21.25,0:04:23.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak tahu apa itu cinta?
Dialogue: 0,0:04:23.20,0:04:24.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gampang sekali.
Dialogue: 0,0:04:24.75,0:04:27.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama, tatap aku baik-baik.
Dialogue: 0,0:04:28.91,0:04:29.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, itu dia.
Dialogue: 0,0:04:29.87,0:04:33.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang kamu rasakan sekarang, itulah cinta.
Dialogue: 0,0:04:33.91,0:04:35.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya?
Dialogue: 0,0:04:36.08,0:04:37.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus, semuanya.
Dialogue: 0,0:04:37.79,0:04:40.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pekerjaan mendesak begini\Nbisa beres berkat kalian.
Dialogue: 0,0:04:40.33,0:04:43.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama-sama.\NSuatu kehormatan bisa membantu.
Dialogue: 0,0:04:43.83,0:04:45.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian belum makan siang, 'kan?
Dialogue: 0,0:04:45.37,0:04:47.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai tanda terima kasih,\Naku traktir kalian makan.
Dialogue: 0,0:04:47.33,0:04:48.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo ke kantin.
Dialogue: 0,0:04:49.04,0:04:50.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh, nih?
Dialogue: 0,0:04:50.25,0:04:52.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah lama aku tidak ke kantin.
Dialogue: 0,0:04:53.08,0:04:55.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menu sekarang cukup beragam, lo.
Dialogue: 0,0:04:55.50,0:05:00.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misalnya, Donburi Kuliner Aneh Dunia\Nedisi terbatas.
Dialogue: 0,0:05:01.25,0:05:04.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah bisa memuaskan lidahku, ya?
Dialogue: 0,0:05:04.33,0:05:05.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang nongol.
Dialogue: 0,0:05:06.70,0:05:08.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ramai, ya.
Dialogue: 0,0:05:08.91,0:05:10.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:05:10.25,0:05:12.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau traktir aku apa, nih?
Dialogue: 0,0:05:12.95,0:05:15.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kan tidak kerja apa-apa.
Dialogue: 0,0:05:15.45,0:05:16.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketua!
Dialogue: 0,0:05:16.75,0:05:18.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketua...
Dialogue: 0,0:05:18.20,0:05:20.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih buat yang waktu itu.
Dialogue: 0,0:05:20.04,0:05:21.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama-sama.
Dialogue: 0,0:05:21.20,0:05:22.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lain kali main boling bareng lagi, yuk.
Dialogue: 0,0:05:23.04,0:05:25.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Boleh.\N- Ketua populer sekali, ya.
Dialogue: 0,0:05:25.66,0:05:27.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ketua sangat membantuku.\N- Tentu saja.
Dialogue: 0,0:05:27.12,0:05:30.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pintar, baik hati, dan cantik pula.
Dialogue: 0,0:05:30.37,0:05:33.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, Ume kan suka yang "berisi".
Dialogue: 0,0:05:35.25,0:05:37.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pesan apa saja boleh, lo.
Dialogue: 0,0:05:37.70,0:05:39.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa saja...
Dialogue: 0,0:05:40.29,0:05:42.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku mau ini.
Dialogue: 0,0:05:44.33,0:05:47.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mumpung ada kesempatan,\Npilih yang lebih mahal saja.
Dialogue: 0,0:05:48.08,0:05:49.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senangnya.
Dialogue: 0,0:05:49.58,0:05:52.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menabung demi makan ini.
Dialogue: 0,0:05:54.50,0:05:55.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sederhana banget.
Dialogue: 0,0:05:55.95,0:05:58.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sehari-hari dia makan apa, sih?
Dialogue: 0,0:05:58.70,0:06:00.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Donburi kuliner aneh...
Dialogue: 0,0:06:00.20,0:06:01.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seleranya aneh banget.
Dialogue: 0,0:06:01.70,0:06:04.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Telur belanak, gelembung renang ikan,\Ndan nanas laut?
Dialogue: 0,0:06:08.12,0:06:10.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketua makan apa?
Dialogue: 0,0:06:11.00,0:06:13.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Set menu sayuran musim panas.
Dialogue: 0,0:06:13.66,0:06:17.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal rajin olahraga,\Ntapi makannya ringan sekali.
Dialogue: 0,0:06:19.08,0:06:22.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Musim begini,\Nterung dan sejenisnya enak, lo.
Dialogue: 0,0:06:22.25,0:06:23.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hisakochan,
Dialogue: 0,0:06:23.25,0:06:24.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hari ini pesan Donburi Daging Melimpah lagi?
Dialogue: 0,0:06:24.91,0:06:26.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu kasih porsi besar, ya.
Dialogue: 0,0:06:27.87,0:06:31.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya dapat nasi semangkuk besar.
Dialogue: 0,0:06:31.29,0:06:33.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat makan.
Dialogue: 0,0:06:39.29,0:06:40.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa, Michinoku?
Dialogue: 0,0:06:41.12,0:06:43.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ben-Bendera...
Dialogue: 0,0:06:53.62,0:06:54.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak.
Dialogue: 0,0:06:55.54,0:06:57.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong, satu bendera lagi!
Dialogue: 0,0:07:01.62,0:07:02.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata tomat.
Dialogue: 0,0:07:04.12,0:07:05.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benci tomat.
Dialogue: 0,0:07:05.20,0:07:08.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalamnya lembek, tapi kulitnya renyah.
Dialogue: 0,0:07:10.70,0:07:12.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sendiri yang pesan.
Dialogue: 0,0:07:13.04,0:07:15.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, buat aku saja.
Dialogue: 0,0:07:15.12,0:07:16.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak usah.
Dialogue: 0,0:07:17.12,0:07:20.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini traktiran, jadi harus dimakan.
Dialogue: 0,0:07:20.04,0:07:22.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau soal itu, pemikiranmu benar.
Dialogue: 0,0:07:24.62,0:07:25.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak, sih, enak,
Dialogue: 0,0:07:25.87,0:07:29.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kalau lauknya cuma sayur,\Nsusah mengimbangi nasinya.
Dialogue: 0,0:07:29.54,0:07:31.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bawa sedikit acar.
Dialogue: 0,0:07:32.04,0:07:33.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak keberatan dengan buatan sendiri.
Dialogue: 0,0:07:33.66,0:07:34.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Acar buatan sendiri?
Dialogue: 0,0:07:34.95,0:07:37.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku coba sedikit.
Dialogue: 0,0:07:39.33,0:07:40.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak.
Dialogue: 0,0:07:40.54,0:07:43.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhir-akhir ini,\Naku bikin nukazuke pakai kotak plastik.
Dialogue: 0,0:07:43.16,0:07:44.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi kucoba bikin acar.
Dialogue: 0,0:07:47.79,0:07:49.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak, terongnya Ume.
Dialogue: 0,0:07:49.41,0:07:50.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Acar!
Dialogue: 0,0:07:55.91,0:07:57.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:07:57.20,0:07:58.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kenyang?
Dialogue: 0,0:07:59.54,0:08:00.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan.
Dialogue: 0,0:08:00.20,0:08:02.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma senang\Nlihat semuanya makan dengan lahap,
Dialogue: 0,0:08:02.75,0:08:04.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi syukurlah aku mentraktir kalian.
Dialogue: 0,0:08:05.20,0:08:08.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam arti itu, aku memang sudah kenyang.
Dialogue: 0,0:08:08.70,0:08:10.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senior...
Dialogue: 0,0:08:10.45,0:08:12.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,\Nayam goreng di atas itu buat aku, ya.
Dialogue: 0,0:08:16.04,0:08:18.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku juga ingin makan bareng Arisu.
Dialogue: 0,0:08:18.45,0:08:20.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak salah, dia ada urusan.
Dialogue: 0,0:08:20.08,0:08:21.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:08:21.16,0:08:24.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya dia sibuk urusan ekskul.
Dialogue: 0,0:08:24.00,0:08:25.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia anggota Ekskul Kimia, 'kan?
Dialogue: 0,0:08:25.54,0:08:27.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia benar-benar hebat.
Dialogue: 0,0:08:27.62,0:08:30.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan jam istirahat pun dia tetap bekerja.
Dialogue: 0,0:08:30.04,0:08:32.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapan dia makannya, ya?
Dialogue: 0,0:08:33.20,0:08:34.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bukannya Arisu?
Dialogue: 0,0:08:36.00,0:08:37.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, benar.
Dialogue: 0,0:08:37.75,0:08:39.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi agak aneh.
Dialogue: 0,0:08:39.25,0:08:41.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa dia sembunyi-sembunyi begitu?
Dialogue: 0,0:08:46.58,0:08:48.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Donburi Kuliner Aneh!
Dialogue: 0,0:08:48.79,0:08:49.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serius?
Dialogue: 0,0:08:49.50,0:08:51.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senior Terui mau makan itu?
Dialogue: 0,0:09:05.91,0:09:08.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya jadi sungkan memanggilnya.
Dialogue: 0,0:09:08.50,0:09:12.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rupanya Senior Terui juga\Nbutuh pelepas stres.
Dialogue: 0,0:09:13.50,0:09:17.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua jadi tahu sisi lain Terui.
Dialogue: 0,0:09:21.04,0:09:23.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tembakkan Bazooka!
Dialogue: 0,0:09:24.25,0:09:26.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kamu bilang Ekskul Musik Modern\Ndi sebelah berisik?
Dialogue: 0,0:09:27.58,0:09:28.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:09:29.70,0:09:30.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitulah.
Dialogue: 0,0:09:30.87,0:09:34.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi dilihat dari kegiatannya,\Nitu tidak bisa dihindari.
Dialogue: 0,0:09:34.41,0:09:36.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, dengarkan dulu.
Dialogue: 0,0:09:36.95,0:09:39.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan cuma berisik.
Dialogue: 0,0:09:39.37,0:09:42.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana, ya, bilangnya?\NSemacam jeritan?
Dialogue: 0,0:09:42.62,0:09:44.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti ada yang dirundung?
Dialogue: 0,0:09:44.25,0:09:45.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kira-kira begitu rasanya.
Dialogue: 0,0:09:45.41,0:09:46.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dirundung?
Dialogue: 0,0:09:47.41,0:09:48.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Panas!
Dialogue: 0,0:09:48.54,0:09:50.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, tidak bisa dibiarkan.
Dialogue: 0,0:09:50.66,0:09:53.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, tapi...
Dialogue: 0,0:09:53.12,0:09:56.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beda juga dengan perundungan biasa.
Dialogue: 0,0:09:56.83,0:09:59.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah harus dibilang penuh gairah
Dialogue: 0,0:09:59.04,0:10:00.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau mesum...
Dialogue: 0,0:10:02.58,0:10:05.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Pokoknya, yang ke arah seksual.\N- Panas!
Dialogue: 0,0:10:05.95,0:10:07.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seksual?
Dialogue: 0,0:10:10.29,0:10:12.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bilangnya, sih, begitu,
Dialogue: 0,0:10:12.87,0:10:15.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi bagaimana cara memastikannya?
Dialogue: 0,0:10:15.41,0:10:17.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya juga tidak ada waktu.
Dialogue: 0,0:10:17.08,0:10:19.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tugas ini terlalu berat buatku.
Dialogue: 0,0:10:19.79,0:10:22.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula,\Nkalau bicara Ekskul Musik Modern...
Dialogue: 0,0:10:23.62,0:10:25.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya, masuk dulu saja.
Dialogue: 0,0:10:25.58,0:10:26.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mulai terbiasa.
Dialogue: 0,0:10:27.41,0:10:28.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi.
Dialogue: 0,0:10:31.79,0:10:37.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keberadaan sesuatu yang dinamakan cinta itu
Dialogue: 0,0:10:37.25,0:10:38.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hancur dan berjatuhan,\Nhanyalah serpihan-serpihan perasaan
Dialogue: 0,0:10:38.50,0:10:42.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suara nyanyian jernih yang menggema\Ndi langit musim gugur.
Dialogue: 0,0:10:42.00,0:10:43.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Angin berembus lewat.
Dialogue: 0,0:10:43.37,0:10:44.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya karena ingin bertemu,\Naku pun pergi menemuimu
Dialogue: 0,0:10:44.45,0:10:47.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, kenapa kakinya begitu?
Dialogue: 0,0:10:47.79,0:10:48.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keren.
Dialogue: 0,0:10:48.75,0:10:54.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak ada jawaban pasti di sana
Dialogue: 0,0:10:54.50,0:11:00.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, semua takkan bermakna\Njika itu bukan dirimu
Dialogue: 0,0:11:13.33,0:11:14.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:11:14.29,0:11:17.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, aku sampai terpana.
Dialogue: 0,0:11:17.66,0:11:19.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu... mau main?
Dialogue: 0,0:11:20.58,0:11:22.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, maksudnya main gitar?
Dialogue: 0,0:11:23.16,0:11:25.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dulu aku pernah main sedikit...
Dialogue: 0,0:11:29.29,0:11:31.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sini.
Dialogue: 0,0:11:34.62,0:11:36.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini?
Dialogue: 0,0:11:37.33,0:11:39.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lumayan, sudah ada gayanya.
Dialogue: 0,0:11:39.45,0:11:41.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini apa-apaan?
Dialogue: 0,0:11:41.33,0:11:43.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namaku Kouki.
Dialogue: 0,0:11:43.54,0:11:45.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tertarik dengan ekskul kami?
Dialogue: 0,0:11:47.54,0:11:49.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu...
Dialogue: 0,0:12:01.08,0:12:03.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan suasana makin mesra ini?!
Dialogue: 0,0:12:04.00,0:12:05.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan mengizinkannya!
Dialogue: 0,0:12:05.04,0:12:06.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudku, jangan sampai kamu tertipu.
Dialogue: 0,0:12:06.87,0:12:10.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia baru mulai main\Nsetelah lihat kamu masuk.
Dialogue: 0,0:12:11.16,0:12:12.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan begitu!
Dialogue: 0,0:12:12.29,0:12:15.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu itu, begitu sendirian\Nlangsung mulai sok keren.
Dialogue: 0,0:12:15.12,0:12:16.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu juga, jangan begitu.
Dialogue: 0,0:12:16.58,0:12:19.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan termakan rayuan\Nsi rambut puding yang sok keren ini.
Dialogue: 0,0:12:20.04,0:12:22.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku jadi dapat bahan bagus.
Dialogue: 0,0:12:22.20,0:12:24.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lumayan, sudah ada gayanya.
Dialogue: 0,0:12:24.45,0:12:26.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untung aku sabar menunggu momen.
Dialogue: 0,0:12:26.08,0:12:27.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Lumayan, sudah ada gayanya.\N- Kalian...
Dialogue: 0,0:12:27.95,0:12:30.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Lumayan, sudah ada gayanya.\N- Omong-omong, kamu anak OSIS, 'kan?
Dialogue: 0,0:12:30.04,0:12:31.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ngapain ke sini?
Dialogue: 0,0:12:31.95,0:12:33.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya...
Dialogue: 0,0:12:33.25,0:12:34.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal anggaran ekskul lagi?
Dialogue: 0,0:12:34.54,0:12:35.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tung...
Dialogue: 0,0:12:35.45,0:12:38.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kamu itu...
Dialogue: 0,0:12:38.79,0:12:40.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu lupa?
Dialogue: 0,0:12:40.00,0:12:43.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu itu buku pornomu kan disita sama dia.
Dialogue: 0,0:12:45.25,0:12:47.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, dia lagi pura-pura tegar.
Dialogue: 0,0:12:47.00,0:12:50.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sok menggurui orang\Nyang tahu aibnya sendiri.
Dialogue: 0,0:12:50.41,0:12:52.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang dia malu setengah mati.
Dialogue: 0,0:12:52.41,0:12:54.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa berhenti menjelaskan, tidak?
Dialogue: 0,0:12:54.50,0:12:57.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ke sini karena ada laporan\Nsoal suara yang terlalu bising.
Dialogue: 0,0:12:57.04,0:12:58.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bising?
Dialogue: 0,0:12:58.37,0:13:00.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami ini Ekskul Musik Modern.\NMau bagaimana lagi?
Dialogue: 0,0:13:00.50,0:13:02.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu memang benar, tapi...
Dialogue: 0,0:13:03.50,0:13:05.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}katanya ada jeritan yang ke arah seksual,
Dialogue: 0,0:13:05.66,0:13:08.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau ada yang dirundung...
Dialogue: 0,0:13:08.08,0:13:11.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku mana tahu soal begituan!
Dialogue: 0,0:13:11.29,0:13:12.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah...
Dialogue: 0,0:13:13.04,0:13:14.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti.
Dialogue: 0,0:13:14.75,0:13:16.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:13:17.58,0:13:19.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kasur lipat dan tisu sebanyak ini buat apa?
Dialogue: 0,0:13:19.58,0:13:20.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:13:20.70,0:13:21.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buat tidur siang.
Dialogue: 0,0:13:21.87,0:13:23.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya sebelum tampil,\Nkami harus latihan intensif menginap.
Dialogue: 0,0:13:23.79,0:13:25.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tisunya karena Kouki cengeng.
Dialogue: 0,0:13:25.75,0:13:27.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang nangis bagian atas, lo.
Dialogue: 0,0:13:31.70,0:13:34.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja karena bahu pegal.
Dialogue: 0,0:13:34.75,0:13:36.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak sekali kejanggalannya\Nsampai aku malas berkomentar.
Dialogue: 0,0:13:38.70,0:13:39.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hiks...
Dialogue: 0,0:13:40.58,0:13:43.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gara-gara kamu terus mendesak!
Dialogue: 0,0:13:43.29,0:13:46.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harga diri Kouki hancur berkeping-keping!
Dialogue: 0,0:13:46.08,0:13:48.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maaf.
Dialogue: 0,0:13:48.20,0:13:51.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi permainan gitar sambil menyanyi\Nyang Senior bawakan
Dialogue: 0,0:13:51.12,0:13:54.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}benar-benar keren, lo.
Dialogue: 0,0:13:54.20,0:13:57.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu ini, percuma saja...
Dialogue: 0,0:13:59.66,0:14:02.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan malah makin mesra!
Dialogue: 0,0:14:02.95,0:14:05.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, soal main gitar sambil nyanyi tadi...
Dialogue: 0,0:14:05.12,0:14:06.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah, diam, bodoh!
Dialogue: 0,0:14:06.25,0:14:08.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu lupa malunya barusan?
Dialogue: 0,0:14:09.49,0:14:12.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya, masalah ini berakhir
Dialogue: 0,0:14:12.16,0:14:15.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan Mizunoe sesekali datang memeriksa\Nsekaligus belajar gitar.
Dialogue: 0,0:14:16.33,0:14:17.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus.
Dialogue: 0,0:14:17.29,0:14:19.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, ya, membiarkanmu pergi sendirian.
Dialogue: 0,0:14:19.79,0:14:21.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.
Dialogue: 0,0:14:21.12,0:14:23.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin justru lebih baik sendirian.
Dialogue: 0,0:14:23.50,0:14:27.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa-apaan...?!
Dialogue: 0,0:14:30.79,0:14:32.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Debunya banyak.
Dialogue: 0,0:14:32.45,0:14:33.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm.
Dialogue: 0,0:14:34.00,0:14:35.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa gara-gara aku piket,
Dialogue: 0,0:14:35.16,0:14:37.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}semua tugas beres-beres dilempar ke aku.
Dialogue: 0,0:14:37.29,0:14:39.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal pelajaran olahraga saja\Nsudah bikin capek.
Dialogue: 0,0:14:39.87,0:14:41.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm.
Dialogue: 0,0:14:41.62,0:14:45.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu main dodgeball tadi,\NMichinoku mukanya kena lemparan keras, ya.
Dialogue: 0,0:14:48.12,0:14:49.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku khawatir sekali waktu itu.
Dialogue: 0,0:14:49.95,0:14:51.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm.
Dialogue: 0,0:14:51.58,0:14:53.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kena muka tidak dihitung keluar,
Dialogue: 0,0:14:53.83,0:14:56.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi aku senang bisa tetap di lapangan.
Dialogue: 0,0:14:56.25,0:14:59.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah kalau begitu.
Dialogue: 0,0:14:59.25,0:15:00.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, sudah beres.
Dialogue: 0,0:15:00.41,0:15:01.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo balik ke kelas.
Dialogue: 0,0:15:11.20,0:15:12.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa dibuka...
Dialogue: 0,0:15:12.37,0:15:13.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:15:13.95,0:15:14.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah.
Dialogue: 0,0:15:15.37,0:15:18.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pintu ini kalau sudah tertutup,\Ntidak bisa dibuka dari dalam.
Dialogue: 0,0:15:18.50,0:15:19.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Desain macam apa itu?
Dialogue: 0,0:15:19.95,0:15:22.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah di sini sejak SMP,\Ntapi tidak pernah dengar.
Dialogue: 0,0:15:23.75,0:15:26.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya aku sering terkunci di sini.
Dialogue: 0,0:15:26.58,0:15:28.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang biasa mungkin tidak tahu.
Dialogue: 0,0:15:28.75,0:15:30.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kasihan sekali.
Dialogue: 0,0:15:30.75,0:15:33.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memutuskan menunggu sampai jam ekskul.
Dialogue: 0,0:15:35.20,0:15:38.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, ini klise banget.
Dialogue: 0,0:15:38.08,0:15:39.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm.
Dialogue: 0,0:15:39.25,0:15:41.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setiap kali, sekeras apa pun aku berusaha,\Npintunya tidak bisa dibuka.
Dialogue: 0,0:15:41.62,0:15:44.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teriak sekencang apa pun,\Ntidak ada yang datang.
Dialogue: 0,0:15:44.08,0:15:45.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Adegan klasik, ya.
Dialogue: 0,0:15:45.75,0:15:48.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan selalu pas aku lagi menahan pipis.
Dialogue: 0,0:15:48.83,0:15:50.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu juga adegan klasik.
Dialogue: 0,0:15:52.70,0:15:53.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang pun aku...
Dialogue: 0,0:15:53.91,0:15:55.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga!
Dialogue: 0,0:15:55.20,0:15:56.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo cepat buka pintunya!
Dialogue: 0,0:15:56.50,0:15:58.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ditarik berdua, pasti bisa terbuka!
Dialogue: 0,0:16:00.16,0:16:02.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bergerak sama sekali.
Dialogue: 0,0:16:02.16,0:16:04.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Michinoku, lebih kuat lagi.
Dialogue: 0,0:16:05.91,0:16:06.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah tidak kuat.
Dialogue: 0,0:16:06.83,0:16:08.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat sekali menyerahnya.
Dialogue: 0,0:16:08.79,0:16:10.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Ume.
Dialogue: 0,0:16:11.12,0:16:12.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah mau keluar...
Dialogue: 0,0:16:12.00,0:16:13.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang itu juga jangan menyerah!
Dialogue: 0,0:16:14.75,0:16:16.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, lewat jendela itu.
Dialogue: 0,0:16:17.25,0:16:18.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Naik ke bahuku.
Dialogue: 0,0:16:18.62,0:16:20.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu keluar duluan.
Dialogue: 0,0:16:20.33,0:16:22.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selesai ke toilet, baru balik menolongku.
Dialogue: 0,0:16:23.08,0:16:24.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:16:31.25,0:16:32.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak sampai, ya?
Dialogue: 0,0:16:33.25,0:16:34.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak sampai.
Dialogue: 0,0:16:35.29,0:16:37.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedikit lagi.
Dialogue: 0,0:16:37.04,0:16:38.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakimu kupegang erat-erat.
Dialogue: 0,0:16:38.33,0:16:40.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa tegakkan badan sedikit lagi?
Dialogue: 0,0:16:40.79,0:16:41.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa...
Dialogue: 0,0:16:41.62,0:16:43.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:16:43.37,0:16:45.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sekarang aku tegakkan badan,
Dialogue: 0,0:16:45.37,0:16:46.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}nanti bocor.
Dialogue: 0,0:16:46.25,0:16:47.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sampai bocor!
Dialogue: 0,0:16:48.50,0:16:49.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat.
Dialogue: 0,0:16:50.33,0:16:52.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan jepit leherku pakai kakimu!
Dialogue: 0,0:16:52.16,0:16:55.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tahan! Kamu kan perempuan!
Dialogue: 0,0:16:56.20,0:16:57.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hai, hai.
Dialogue: 0,0:16:58.45,0:17:00.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian berdua tidak apa-apa?
Dialogue: 0,0:17:00.87,0:17:01.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tan!
Dialogue: 0,0:17:01.87,0:17:03.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu ada di sini?
Dialogue: 0,0:17:03.62,0:17:06.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini deduksi sederhana, Ume.
Dialogue: 0,0:17:06.86,0:17:09.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah jadi rahasia umum,\Nkalau ada perbuatan yang melewati batas,
Dialogue: 0,0:17:09.00,0:17:10.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pasti terjadinya di gudang olahraga.
Dialogue: 0,0:17:10.91,0:17:12.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku pasang kamera di sini.
Dialogue: 0,0:17:13.57,0:17:15.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk memeras dan dijual.
Dialogue: 0,0:17:16.20,0:17:17.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apanya yang deduksi?
Dialogue: 0,0:17:19.82,0:17:23.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi ternyata di sini begini, ya.
Dialogue: 0,0:17:23.25,0:17:25.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma agak macet.
Dialogue: 0,0:17:29.33,0:17:30.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:17:32.45,0:17:34.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ditarik bertiga, pasti bisa terbuka.
Dialogue: 0,0:17:34.12,0:17:36.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lelucon itu sudah dipakai.
Dialogue: 0,0:17:37.16,0:17:39.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tangan dan selangkanganku sudah mau lemas.
Dialogue: 0,0:17:39.87,0:17:40.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat.
Dialogue: 0,0:17:40.70,0:17:42.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Michinoku sudah tidak tahan.
Dialogue: 0,0:17:42.91,0:17:43.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, jadi situasinya begini.
Dialogue: 0,0:17:43.95,0:17:44.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:17:44.66,0:17:46.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu, itu...
Dialogue: 0,0:17:47.83,0:17:49.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada selotip, lo.
Dialogue: 0,0:17:49.12,0:17:51.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau dipakai menempel?\NPanik banget, sih.
Dialogue: 0,0:17:52.00,0:17:54.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayaknya sakit kalau dicabut.
Dialogue: 0,0:17:54.25,0:17:55.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau.
Dialogue: 0,0:17:55.00,0:17:56.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alasan menolaknya itu?
Dialogue: 0,0:17:56.58,0:17:58.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ume, tolong tahan.
Dialogue: 0,0:17:58.50,0:18:00.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimanapun juga, itu tidak boleh!
Dialogue: 0,0:18:01.12,0:18:02.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lewat jendela sebelah sana.
Dialogue: 0,0:18:02.33,0:18:03.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lelucon itu juga sudah dipakai.
Dialogue: 0,0:18:04.04,0:18:06.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini kita juga dapat data bagus, Asisten.
Dialogue: 0,0:18:06.54,0:18:08.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, Senior.
Dialogue: 0,0:18:14.29,0:18:15.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:18:24.04,0:18:24.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat...
Dialogue: 0,0:18:24.95,0:18:27.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manusia sedang kawin!
Dialogue: 0,0:18:27.58,0:18:30.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manusia sedang kawin...
Dialogue: 0,0:18:30.25,0:18:33.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tung-Tunggu dulu!
Dialogue: 0,0:18:33.79,0:18:35.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski gosip aneh jadi menyebar,
Dialogue: 0,0:18:35.79,0:18:37.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia berhasil sampai ke toilet tepat waktu.
Dialogue: 0,0:18:38.79,0:18:41.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manusia sedang kawin!
Dialogue: 0,0:20:11.58,0:20:12.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus.
Dialogue: 0,0:20:13.16,0:20:14.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini panas juga, ya.
Dialogue: 0,0:20:18.75,0:20:22.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya ampun, akhir-akhir ini\Ndia sepertinya sibuk sekali.
Dialogue: 0,0:20:22.64,0:20:23.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei.
Dialogue: 0,0:20:23.87,0:20:25.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mizunoe...
Dialogue: 0,0:20:25.33,0:20:26.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei.
Dialogue: 0,0:20:30.41,0:20:32.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya ampun, nanti kamu masuk angin.
Dialogue: 0,0:20:32.50,0:20:33.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sa-yang-ku.
Dialogue: 0,0:20:34.16,0:20:35.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bercanda...
Dialogue: 0,0:20:35.66,0:20:37.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus.
Dialogue: 0,0:20:37.20,0:20:39.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, Kotobuki?
Dialogue: 0,0:20:39.37,0:20:40.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belut taman?
Dialogue: 0,0:20:40.25,0:20:41.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, tidak apa-apa.
Dialogue: 0,0:20:41.87,0:20:43.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke... Bu...
Dialogue: 0,0:20:43.08,0:20:44.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, Bu Guru?
Dialogue: 0,0:20:44.87,0:20:46.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, iya.
Dialogue: 0,0:20:46.91,0:20:50.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini, soal acara rutin tahunan itu...
Dialogue: 0,0:20:50.45,0:20:52.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yaitu, itu...
Dialogue: 0,0:20:53.00,0:20:53.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, 'kan?
Dialogue: 0,0:20:53.87,0:20:56.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemah keakraban OSIS.
Dialogue: 0,0:20:57.04,0:20:59.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga, sudah waktunya kemah, ya.
Dialogue: 0,0:20:59.41,0:21:00.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul, betul.
Dialogue: 0,0:21:00.87,0:21:03.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku datang mau membahas soal kemah...
Dialogue: 0,0:21:03.50,0:21:06.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa dia tidur\Nala orang berendam di onsen?
Dialogue: 0,0:21:06.91,0:21:10.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajah tampan dipadu pose begitu,
Dialogue: 0,0:21:10.70,0:21:12.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lucu sekali, ya.
Dialogue: 0,0:21:12.04,0:21:13.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, 'kan?
Dialogue: 0,0:21:14.29,0:21:15.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bangunkan dia, ya.
Dialogue: 0,0:21:15.95,0:21:18.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ume, bangun.
Dialogue: 0,0:21:19.62,0:21:21.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apaan, sih, Kak...?
Dialogue: 0,0:21:21.45,0:21:22.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan dibangunkan.
Dialogue: 0,0:21:23.87,0:21:26.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biarkan dia tidur, Kak.
Dialogue: 0,0:21:26.29,0:21:27.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu Guru!
Dialogue: 0,0:21:27.79,0:21:29.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mizunoe, bangun.
Dialogue: 0,0:21:30.00,0:21:31.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:21:31.16,0:21:33.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhir-akhir ini, sepertinya aku kelelahan.
Dialogue: 0,0:21:33.58,0:21:34.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak usah dipikirkan.
Dialogue: 0,0:21:34.87,0:21:36.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga jago tidur.
Dialogue: 0,0:21:36.79,0:21:39.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemah keakraban OSIS, ya?
Dialogue: 0,0:21:39.95,0:21:40.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:21:40.83,0:21:43.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ada tempat yang ingin kamu datangi,\Nbilang saja.
Dialogue: 0,0:21:43.50,0:21:44.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar boleh?
Dialogue: 0,0:21:44.70,0:21:47.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,\Nbagaimana kalau berendam di onsen?
Dialogue: 0,0:21:47.00,0:21:48.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti Kawabata Yasunari.
Dialogue: 0,0:21:48.95,0:21:50.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu benar-benar suka berendam, ya.
Dialogue: 0,0:21:50.79,0:21:53.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Memangnya aku pernah cerita ke kalian?
Dialogue: 0,0:21:53.75,0:21:56.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Mizunoe.
Dialogue: 0,0:21:56.33,0:21:57.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Michinoku, menurutmu bagaimana?
Dialogue: 0,0:21:59.37,0:22:02.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga mau ke onsen.
Dialogue: 0,0:22:02.62,0:22:03.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu ikut-ikutan aku.
Dialogue: 0,0:22:03.70,0:22:06.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Badanku jadi terasa ringan, jadi aku suka.
Dialogue: 0,0:22:06.41,0:22:07.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Air rendaman yang penuh.
Dialogue: 0,0:22:08.50,0:22:10.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga suka berendam, lo.
Dialogue: 0,0:22:10.95,0:22:12.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski dadaku ringan.
Dialogue: 0,0:22:12.66,0:22:13.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah, jangan bahas.
Dialogue: 0,0:22:13.83,0:22:16.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, sudah diputuskan: ke onsen.
Dialogue: 0,0:22:17.08,0:22:18.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar boleh?
Dialogue: 0,0:22:18.87,0:22:21.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buat guru, ini dihitung dinas luar.
Dialogue: 0,0:22:21.87,0:22:24.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wisata onsen gratis atas permintaan murid.
Dialogue: 0,0:22:25.54,0:22:26.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Blak-blakan banget.
Dialogue: 0,0:22:27.08,0:22:29.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, ini jauh lebih baik\Ndari tahun lalu.
Dialogue: 0,0:22:30.12,0:22:31.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tahun lalu?
Dialogue: 0,0:22:31.04,0:22:33.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tahun lalu, atas desakan Otori,
Dialogue: 0,0:22:33.62,0:22:35.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami pergi lihat superkomputer Fugaku.
Dialogue: 0,0:22:35.25,0:22:36.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau satu.
Dialogue: 0,0:22:37.20,0:22:39.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Urusan penginapan biar Ibu yang atur.
Dialogue: 0,0:22:39.16,0:22:40.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sisanya Ibu serahkan pada kalian.
Dialogue: 0,0:22:40.45,0:22:41.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:22:42.58,0:22:44.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terakhir, Ibu kasih satu nasihat.
Dialogue: 0,0:22:45.45,0:22:48.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hati-hati, jangan sampai melakukan kesalahan\Nkarena gejolak darah muda, ya.
Dialogue: 0,0:22:48.95,0:22:50.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian kan lagi masa puber.
Dialogue: 0,0:22:50.50,0:22:52.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu yang mau dibilang di detik terakhir?
Dialogue: 0,0:22:52.37,0:22:54.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hal begitu tidak akan terjadi.
Dialogue: 0,0:22:54.33,0:22:55.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu pelecehan seksual, lo.
Dialogue: 0,0:22:55.41,0:22:56.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, ya?
Dialogue: 0,0:22:56.58,0:22:58.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi melihat sisi pribadi\Nyang berbeda dari biasanya,
Dialogue: 0,0:22:58.62,0:23:00.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu jadi berdebar-debar...
Dialogue: 0,0:23:00.33,0:23:01.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin.
Dialogue: 0,0:23:01.58,0:23:04.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau memanfaatkan kegelapan malam\Nuntuk bermesraan...
Dialogue: 0,0:23:04.83,0:23:06.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa yang mau begitu?
Dialogue: 0,0:23:06.91,0:23:09.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau menjahili waktu dia tidur...
Dialogue: 0,0:23:10.41,0:23:12.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu kebanyakan baca komik.
Dialogue: 0,0:23:12.20,0:23:14.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya ampun, ngomong ngawur terus.
Dialogue: 0,0:23:16.56,0:23:17.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketua?
Dialogue: 0,0:23:17.75,0:23:19.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan...
Dialogue: 0,0:23:19.08,0:23:20.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak pernah melakukannya...
Dialogue: 0,0:23:20.37,0:23:22.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok tiba-tiba jadi begini?
Dialogue: 0,0:23:22.04,0:23:24.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi berasap kayak kereta uap.
Dialogue: 0,0:23:24.58,0:23:26.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mau melakukannya,\Njangan sampai ketahuan, ya.
Dialogue: 0,0:23:27.58,0:23:28.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu pergi dulu.
Dialogue: 0,0:23:28.62,0:23:29.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu kesimpulannya?
Dialogue: 0,0:23:29.87,0:23:30.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ketahuan...\N- Kak, ayo makan.
Dialogue: 0,0:23:30.70,0:23:32.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Bu-Bukan, tapi...\N- Kak, ayo makan.
Dialogue: 0,0:23:32.25,0:23:34.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Panas. Ruangan ini kenapa, sih?
