Dialogue: 0,0:00:00.00,0:00:04.12,sign,,0000,0000,0000,,KOTAK SARAN\NRIANG, DEG-DEGAN
Dialogue: 0,0:00:25.00,0:00:28.00,sign,,0000,0000,0000,,EPISODE 4\NKOMARO DAN KOTAK SARAN
Dialogue: 0,0:00:39.14,0:00:39.78,sign,,0000,0000,0000,,MOTIF HARI INI
Dialogue: 0,0:00:47.40,0:00:47.82,sign,,0000,0000,0000,,KOTAK SARAN
Dialogue: 0,0:00:54.87,0:00:57.44,sign,,0000,0000,0000,,"ROTI DI KANTIN TERLALU MAHAL, EKSKUL BISBOL"
Dialogue: 0,0:00:58.78,0:01:00.16,sign,,0000,0000,0000,,"LAPANGAN BISBOLNYA TERLALU KECIL, EKSKUL BISBOL"
Dialogue: 0,0:01:35.09,0:01:35.82,sign,,0000,0000,0000,,OTORI TAN
Dialogue: 0,0:02:06.83,0:02:09.19,sign,,0000,0000,0000,,RUANG TANKO
Dialogue: 0,0:02:41.11,0:02:41.94,sign,,0000,0000,0000,,LESU...
Dialogue: 0,0:02:54.54,0:02:55.03,sign,,0000,0000,0000,,SAAT KEGIATAN MEMBERI SALAM, LEMPAR PAI SAJA
Dialogue: 0,0:04:05.60,0:04:05.99,sign,,0000,0000,0000,,KOTAK SARAN
Dialogue: 0,0:04:10.31,0:04:10.65,sign,,0000,0000,0000,,KOTAK SARAN
Dialogue: 0,0:04:35.17,0:04:36.07,sign,,0000,0000,0000,,RUANG ARSIP
Dialogue: 0,0:05:42.33,0:05:44.04,sign,,0000,0000,0000,,OMURICE MINI
Dialogue: 0,0:06:05.15,0:06:06.80,sign,,0000,0000,0000,,TING
Dialogue: 0,0:07:02.92,0:07:03.90,sign,,0000,0000,0000,,TOMAT CERI
Dialogue: 0,0:08:21.16,0:08:24.00,sign,,0000,0000,0000,,"EKSKUL KIMIA"
Dialogue: 0,0:08:36.00,0:08:37.55,sign,,0000,0000,0000,,"MENGENDAP-ENDAP..."
Dialogue: 0,0:08:39.25,0:08:41.15,sign,,0000,0000,0000,,"TERDUDUK..."
Dialogue: 0,0:09:19.79,0:09:21.04,sign,,0000,0000,0000,,SEBENARNYA AKU PENGGEMAR KUNCIR KUDA, LO
Dialogue: 0,0:09:21.04,0:09:23.20,sign,,0000,0000,0000,,"RUANG OSIS"
Dialogue: 0,0:09:26.56,0:09:27.57,sign,,0000,0000,0000,,EKSKUL UPACARA MINUM TEH - GAYA INGGRIS
Dialogue: 0,0:10:07.29,0:10:10.29,sign,,0000,0000,0000,,EPISODE 4\NKOUKICHAN DAN EKSKUL MUSIK MODERN
Dialogue: 0,0:10:10.29,0:10:12.62,sign,,0000,0000,0000,,"EKSKUL MUSIK MODERN"
Dialogue: 0,0:13:39.61,0:13:40.57,sign,,0000,0000,0000,,HIKS
Dialogue: 0,0:18:27.58,0:18:30.24,sign,,0000,0000,0000,,"WUSSS..."
Dialogue: 0,0:20:11.02,0:20:11.57,sign,,0000,0000,0000,,RUANG OSIS
Dialogue: 0,0:20:33.64,0:20:34.15,sign,,0000,0000,0000,,UH...
Dialogue: 0,0:21:27.39,0:21:27.78,sign,,0000,0000,0000,,UME TERBANGUN
Dialogue: 0,0:22:10.95,0:22:12.58,sign,,0000,0000,0000,,"PLAK!"
Dialogue: 0,0:22:25.17,0:22:25.53,sign,,0000,0000,0000,,UNTUNG, UNTUNG
Dialogue: 0,0:22:35.25,0:22:36.75,sign,,0000,0000,0000,,"KONTEN DISENSOR"
Dialogue: 0,0:23:16.56,0:23:17.75,sign,,0000,0000,0000,,"NGEBUL"
