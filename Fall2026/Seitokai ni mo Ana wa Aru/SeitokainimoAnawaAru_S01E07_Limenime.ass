Dialogue: 0,0:23:34.99,0:23:35.97,sign,,0000,0000,0000,,CUPLIKAN EPISODE BERIKUTNYA
Dialogue: 0,0:23:35.97,0:23:38.92,sign,,0000,0000,0000,,DUNIA SATOMI, KALAU SEMUA BERKUMPUL,\NTIPU DAYA TAN, UME DIDUGA PLAYBOY,
Dialogue: 0,0:23:38.92,0:23:41.88,sign,,0000,0000,0000,,SAKIT, SAKIT, TERBANGLAH!,\NBERES-BERES DAN BUAH DADA
Dialogue: 0,0:01:35.54,0:01:36.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm.
Dialogue: 0,0:01:37.22,0:01:38.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sip.
Dialogue: 0,0:01:39.51,0:01:41.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keesokan harinya.
Dialogue: 0,0:01:41.48,0:01:43.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, bisa istirahat sebentar.
Dialogue: 0,0:01:44.02,0:01:46.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Michinoku, makan siang mau bagaimana?
Dialogue: 0,0:01:46.96,0:01:48.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, soal itu...
Dialogue: 0,0:01:55.01,0:01:56.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Onigiri.
Dialogue: 0,0:01:56.30,0:01:56.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:01:57.45,0:01:58.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makan, deh.
Dialogue: 0,0:02:02.90,0:02:05.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Prototipe buat dijual di sekolah?
Dialogue: 0,0:02:06.18,0:02:07.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya. Cobain, dong.
Dialogue: 0,0:02:08.66,0:02:10.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada usulan masuk ke kotak saran.
Dialogue: 0,0:02:10.88,0:02:13.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya minta menu yang murah.
Dialogue: 0,0:02:13.45,0:02:14.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu.
Dialogue: 0,0:02:14.86,0:02:19.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang, harga di koperasi dan kantin\Nsekolah kita agak mahal, ya.
Dialogue: 0,0:02:19.49,0:02:21.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ekskul Bisbol juga bilang begitu.
Dialogue: 0,0:02:21.33,0:02:22.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:02:22.92,0:02:26.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi barusan sempat kukira\Nbekal cinta buat Ume.
Dialogue: 0,0:02:26.84,0:02:28.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Heh?! Bukan, bukan!
Dialogue: 0,0:02:29.11,0:02:30.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sempat kepikiran.
Dialogue: 0,0:02:30.80,0:02:34.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, Komachan,\Nini rencananya mau dijual bagaimana?
Dialogue: 0,0:02:35.69,0:02:38.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bikin sendiri pagi-pagi.
Dialogue: 0,0:02:38.02,0:02:41.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pas istirahat siang,\Naku buka lapak di lapangan.
Dialogue: 0,0:02:41.17,0:02:43.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bikin sendiri?! Itu, sih, agak...
Dialogue: 0,0:02:43.33,0:02:47.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, ada cara lain juga,\Nmisalnya pesan ke pengusaha terdekat.
Dialogue: 0,0:02:47.01,0:02:51.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Modal satu buahnya sekitar 40 yen, jadi...
Dialogue: 0,0:02:51.36,0:02:52.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kujual 40 yen.
Dialogue: 0,0:02:53.41,0:02:55.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasio modalnya 100%!
Dialogue: 0,0:02:55.77,0:02:58.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Y-Yah, urusan detailnya kesampingkan dulu.
Dialogue: 0,0:02:58.68,0:02:59.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita coba, yuk.
Dialogue: 0,0:03:00.09,0:03:00.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo!
Dialogue: 0,0:03:01.20,0:03:02.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm.
Dialogue: 0,0:03:02.49,0:03:04.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kira-kira bisa memuaskan lidahku, tidak?!
Dialogue: 0,0:03:04.59,0:03:05.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Datang lagi!
Dialogue: 0,0:03:06.23,0:03:09.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu selalu ngomong begitu,\Npadahal lidahmu kayak anak kecil.
Dialogue: 0,0:03:09.24,0:03:13.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ngomong apa, sih?\NLidahku ini kritis, lo.
Dialogue: 0,0:03:13.15,0:03:15.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, omong-omong, ada isi karaage mayones?
Dialogue: 0,0:03:15.14,0:03:18.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karaage itu mahal. Maaf.
Dialogue: 0,0:03:18.95,0:03:19.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lidah anak kecil.
Dialogue: 0,0:03:20.17,0:03:21.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saatnya mencicipi.
Dialogue: 0,0:03:22.16,0:03:24.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mm! Enak, ya!
Dialogue: 0,0:03:24.36,0:03:27.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar! Asinnya pas. Tapi...
Dialogue: 0,0:03:28.72,0:03:29.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini apa?
Dialogue: 0,0:03:30.19,0:03:33.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, itu cumi kering.\NYang sudah direndam biar lunak.
Dialogue: 0,0:03:33.53,0:03:34.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cumi kering?!
Dialogue: 0,0:03:34.43,0:03:38.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar murah, aku pakai\Nyang ada di rumah Bu Guru.
Dialogue: 0,0:03:38.55,0:03:40.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hee, ternyata masih ada sisa.
Dialogue: 0,0:03:40.50,0:03:42.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, ini aman, tidak?
Dialogue: 0,0:03:43.11,0:03:44.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih atas makanannya.
Dialogue: 0,0:03:44.94,0:03:45.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya,
Dialogue: 0,0:03:45.54,0:03:47.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- biar perut semua orang terpikat,\N- Iya, enak.
Dialogue: 0,0:03:47.04,0:03:50.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- isinya harus karaage lebih banyak.\N- Tapi rasanya agak susah kalau mau dijual.
Dialogue: 0,0:03:50.14,0:03:51.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Catat, catat.\N- Benar juga.
Dialogue: 0,0:03:51.41,0:03:55.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalaupun pesan ke pengusaha,\Nharga dan isinya harus dipikirkan.
Dialogue: 0,0:03:55.17,0:03:56.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cumi kering, sih, agak...
Dialogue: 0,0:03:56.88,0:04:01.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm...\NMengembangkan isi yang murah dan laris, ya.
Dialogue: 0,0:04:01.04,0:04:02.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana caranya?
Dialogue: 0,0:04:02.68,0:04:04.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus, semuanya!
Dialogue: 0,0:04:04.31,0:04:07.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo? Kenapa?\NMuka kalian pada kusut begitu.
Dialogue: 0,0:04:07.43,0:04:09.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, begini, begitu...
Dialogue: 0,0:04:09.41,0:04:12.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm. Memang itu masalah\Nyang belum beres, sih.
Dialogue: 0,0:04:13.23,0:04:15.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi Komachan juga aku ingin\Nmewujudkannya, tapi...
Dialogue: 0,0:04:16.22,0:04:18.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, kalau begitu, ke tempatku saja?
Dialogue: 0,0:04:18.20,0:04:20.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Kenapa...
Dialogue: 0,0:04:20.01,0:04:21.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, benar juga.
Dialogue: 0,0:04:21.88,0:04:24.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, maaf! Aku belum pernah bilang, ya?
Dialogue: 0,0:04:24.71,0:04:28.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di dekat stasiun ada\NRumah Makan Kotobuki, 'kan?
Dialogue: 0,0:04:28.10,0:04:29.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu punya keluargaku.
Dialogue: 0,0:04:29.32,0:04:30.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?!
Dialogue: 0,0:04:30.47,0:04:32.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di tempatku bahan dan alatnya lengkap.
Dialogue: 0,0:04:32.95,0:04:35.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bikin percobaan dan riset\Npasti lebih gampang, 'kan?
Dialogue: 0,0:04:35.58,0:04:37.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat! Ide bagus!
Dialogue: 0,0:04:37.71,0:04:39.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asyik, Komachan.
Dialogue: 0,0:04:39.75,0:04:40.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:04:41.16,0:04:42.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dapat jatah makan karyawan?
Dialogue: 0,0:04:42.74,0:04:46.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, kami terima tawarannya.\NDalam waktu dekat kami semua mampir, ya.
Dialogue: 0,0:04:46.49,0:04:47.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke! Siap!
Dialogue: 0,0:04:48.16,0:04:50.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kotobuki, ya.\N- Aku sudah beberapa kali ke sana.
Dialogue: 0,0:04:50.25,0:04:52.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Oh, pantas.\N- Aku baru pertama kali.
Dialogue: 0,0:04:52.31,0:04:56.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, berarti Mizunoe juga\Nbakal datang ke rumahku?
Dialogue: 0,0:04:56.15,0:04:57.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Bagaimana ini?
Dialogue: 0,0:04:57.37,0:04:59.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Pe-Pertama kali...\N- Kak, berisik!
Dialogue: 0,0:04:59.95,0:05:02.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga sudah coba pakai permen garam.
Dialogue: 0,0:05:02.69,0:05:04.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hoek.
Dialogue: 0,0:05:04.03,0:05:06.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus buat mencegah heatstroke, ya.
Dialogue: 0,0:05:06.32,0:05:07.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi ini musim dingin.
Dialogue: 0,0:05:08.56,0:05:11.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, tibalah hari uji coba onigiri.
Dialogue: 0,0:05:11.87,0:05:14.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, bahannya segini cukup kali, ya!
Dialogue: 0,0:05:14.70,0:05:17.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tinggal persiapan,\Nlalu meja dan pisau buat Komachan...
Dialogue: 0,0:05:19.75,0:05:22.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu, dari tadi lagi ngapain, sih?
Dialogue: 0,0:05:23.12,0:05:26.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Habisnya, teman-teman Hisako\Nmau datang, 'kan?
Dialogue: 0,0:05:26.46,0:05:29.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mumpung ada kesempatan,\NIbu mau keluarkan kue simpanan...
Dialogue: 0,0:05:29.56,0:05:31.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, tidak ada waktu. Nanti saja!
Dialogue: 0,0:05:32.00,0:05:33.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mending bantu persiapan...
Dialogue: 0,0:05:33.41,0:05:37.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah! Yokan Unrindo dan yokan Kuraya...
Dialogue: 0,0:05:37.03,0:05:39.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi tercampur! Harus dirapikan!
Dialogue: 0,0:05:39.96,0:05:40.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti saja, dong!
Dialogue: 0,0:05:42.14,0:05:43.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Hisako.
Dialogue: 0,0:05:43.77,0:05:46.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu panik lagi di saat yang tidak tepat.
Dialogue: 0,0:05:47.06,0:05:50.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duh! Yang benar, dong.\NIni hari penting.
Dialogue: 0,0:05:50.64,0:05:51.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya...
Dialogue: 0,0:05:51.62,0:05:52.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Huee...
Dialogue: 0,0:05:52.57,0:05:57.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal belakangan ini pelanggan\Nsudah mulai memuji Ibu, lo.
Dialogue: 0,0:05:57.14,0:05:58.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Ibu dipuji?
Dialogue: 0,0:05:58.79,0:06:01.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya. Katanya, "Bu Mayuki mantap, ya."
Dialogue: 0,0:06:01.95,0:06:03.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Mantap...\N- Itu pasti maksudnya lain!
Dialogue: 0,0:06:04.14,0:06:06.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu sendiri yang bilang mau bantu,\Njadi yang benar, dong!
Dialogue: 0,0:06:06.80,0:06:10.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin membantu adik kelasku!\NCuci berasnya!
Dialogue: 0,0:06:10.43,0:06:11.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:06:11.70,0:06:15.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Komachan yang pemalu itu\Nbilang ingin berusaha, jadi...
Dialogue: 0,0:06:15.12,0:06:16.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Walah.
Dialogue: 0,0:06:16.10,0:06:20.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hisako yang begini\Nbenar-benar mirip ayahmu, ya.
Dialogue: 0,0:06:20.07,0:06:21.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keren sekali.
Dialogue: 0,0:06:21.53,0:06:24.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari dulu dia juga selalu begitu.
Dialogue: 0,0:06:24.36,0:06:26.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya keren sekali, keren, ke...
Dialogue: 0,0:06:26.27,0:06:28.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya, jangan berhenti!
Dialogue: 0,0:06:28.25,0:06:33.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, tapi, Hisako panik begini\Npasti ada alasan lain juga, 'kan?
Dialogue: 0,0:06:33.69,0:06:35.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mizunoe Ume!
Dialogue: 0,0:06:35.22,0:06:36.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke-Kenapa Ibu tahu...
Dialogue: 0,0:06:36.69,0:06:38.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taiga yang kasih tahu Ibu.
Dialogue: 0,0:06:38.75,0:06:39.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taiga!
Dialogue: 0,0:06:39.95,0:06:43.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belakangan ini Kakak ngomongin\Nsi Ume-Ume itu terus!
Dialogue: 0,0:06:43.01,0:06:43.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan...
Dialogue: 0,0:06:43.93,0:06:47.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}katanya sudah mesra banget!
Dialogue: 0,0:06:47.19,0:06:48.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?!
Dialogue: 0,0:06:48.42,0:06:50.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu-Bukan. Bukan begitu, kok.
Dialogue: 0,0:06:50.85,0:06:51.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?!
Dialogue: 0,0:06:52.05,0:06:55.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Habisnya, Ibu dengar,\Nkatanya kamu mau dipinang...
Dialogue: 0,0:06:55.24,0:06:55.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah.
Dialogue: 0,0:06:56.00,0:06:57.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata benar.
Dialogue: 0,0:06:57.18,0:06:57.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti
Dialogue: 0,0:06:57.85,0:06:59.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ka-kalian sudah pacaran, ya?!
Dialogue: 0,0:06:59.42,0:07:00.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan!
Dialogue: 0,0:07:00.76,0:07:03.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian sudah "begituan", ya?
Dialogue: 0,0:07:03.06,0:07:04.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengarkan aku dulu!
Dialogue: 0,0:07:04.85,0:07:06.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah dijelaskan.
Dialogue: 0,0:07:06.37,0:07:10.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata soal dipinang itu cuma bercanda, ya.
Dialogue: 0,0:07:10.60,0:07:11.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa malah sedih?
Dialogue: 0,0:07:12.17,0:07:15.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu menikah pas seumuran Hisako,
Dialogue: 0,0:07:15.80,0:07:19.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi Ibu berharap suatu saat\NHisako juga punya orang yang baik.
Dialogue: 0,0:07:20.08,0:07:23.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu jadi senang. Maaf, ya.
Dialogue: 0,0:07:23.20,0:07:25.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kalau maksudnya begitu...
Dialogue: 0,0:07:25.55,0:07:27.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sedikit... mungkin iya?
Dialogue: 0,0:07:27.22,0:07:28.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Walah, walah!
Dialogue: 0,0:07:28.74,0:07:30.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah!
Dialogue: 0,0:07:30.19,0:07:34.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu sudah siapkan macam-macam\Nbiar bisa akrab sama Ume!
Dialogue: 0,0:07:34.86,0:07:35.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat.
Dialogue: 0,0:07:35.56,0:07:37.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Album pilihan Hisako.
Dialogue: 0,0:07:37.45,0:07:38.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan!
Dialogue: 0,0:07:38.48,0:07:41.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal Ibu sudah bergadang\Nmemilih fotonya.
Dialogue: 0,0:07:41.82,0:07:43.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Standar imut Ibu itu aneh!
Dialogue: 0,0:07:43.84,0:07:46.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya! Masih ada satu lagi, lo.
Dialogue: 0,0:07:46.38,0:07:47.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh...
Dialogue: 0,0:07:47.66,0:07:51.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu... Ibu tidak usah ikut campur.\NAku cuma suka sepihak, kok.
Dialogue: 0,0:07:51.53,0:07:52.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba lihat.
Dialogue: 0,0:07:54.30,0:07:55.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hup!
Dialogue: 0,0:07:56.22,0:08:00.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mau gabung sama anak SMA,\Nmungkin pakai seragam lebih pas.
Dialogue: 0,0:08:00.19,0:08:05.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin kelihatan tidak sesuai umur, sih,\Ntapi semalam Ibu bergadang menyetrikanya.
Dialogue: 0,0:08:05.94,0:08:07.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan.
Dialogue: 0,0:08:07.49,0:08:11.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya, ya. Ibu kan sudah 30.
Dialogue: 0,0:08:11.57,0:08:14.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, iya. Ibu tahu, kok.
Dialogue: 0,0:08:14.52,0:08:16.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duh. Ibu kan 38.
Dialogue: 0,0:08:17.05,0:08:20.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan itu masalahnya.\NAku cuma agak malu!
Dialogue: 0,0:08:20.22,0:08:21.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagian, mending persiapan dulu...
Dialogue: 0,0:08:21.71,0:08:23.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Permisi.\N- Ah?! Wah! Mereka sudah datang!
Dialogue: 0,0:08:24.20,0:08:25.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu, masuk ke dalam.
Dialogue: 0,0:08:25.82,0:08:28.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Iya! Silakan masuk.\N- Ibu?!
Dialogue: 0,0:08:28.25,0:08:29.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei! Kenapa malah keluar?!
Dialogue: 0,0:08:29.94,0:08:31.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagian, cepat banget pulihnya!
Dialogue: 0,0:08:31.94,0:08:35.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Habisnya, tidak enak\Nbikin teman-temanmu menunggu!
Dialogue: 0,0:08:35.10,0:08:37.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat bawah! Bajunya!
Dialogue: 0,0:08:37.17,0:08:41.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, sudah susah-susah disiapkan,\Nsekali-sekali harus dilihat, dong.
Dialogue: 0,0:08:41.41,0:08:42.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak, sayang, 'kan?
Dialogue: 0,0:08:42.85,0:08:45.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekali itu bisa jadi bencana!
Dialogue: 0,0:08:45.19,0:08:46.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Permisi.\N- Ngerti, tidak?!
Dialogue: 0,0:09:00.44,0:09:03.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu-Bukan begitu!
Dialogue: 0,0:09:07.13,0:09:08.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada bedanya.
Dialogue: 0,0:09:08.94,0:09:10.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi begitulah.
Dialogue: 0,0:09:10.78,0:09:12.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Mayuki, ibunya Hisako!
Dialogue: 0,0:09:12.94,0:09:14.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon bantuannya hari ini!
Dialogue: 0,0:09:14.67,0:09:15.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:09:16.05,0:09:18.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, ya, tadi Tante heboh sendiri.
Dialogue: 0,0:09:18.70,0:09:21.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kalian mau datang,\NTante jadi terlalu bersemangat...
Dialogue: 0,0:09:21.67,0:09:23.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah! Tidak! Aku sama sekali...
Dialogue: 0,0:09:23.45,0:09:24.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama sekali tidak keberatan, kok.
Dialogue: 0,0:09:26.11,0:09:27.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi Ketua...
Dialogue: 0,0:09:28.01,0:09:29.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketua tidak apa-apa?
Dialogue: 0,0:09:29.24,0:09:31.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, maaf, terima kasih!
Dialogue: 0,0:09:31.91,0:09:33.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}He-Hei, Arisu.
Dialogue: 0,0:09:34.31,0:09:35.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:09:35.70,0:09:39.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka berdua itu jangan-jangan\Nmemang pacaran, ya?
Dialogue: 0,0:09:40.03,0:09:42.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm. Bagaimana, ya?
Dialogue: 0,0:09:42.97,0:09:45.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat itu, Terui berpikir.
Dialogue: 0,0:09:45.18,0:09:48.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo? Bu Mayuki salah paham, ya?
Dialogue: 0,0:09:48.94,0:09:52.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti dia salah menafsirkan\Ninformasi lagi?
Dialogue: 0,0:09:52.23,0:09:54.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitulah. Tapi...
Dialogue: 0,0:09:54.28,0:09:57.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, benar. Kurang lebih begitu.
Dialogue: 0,0:09:58.31,0:10:00.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kelihatannya seru,\Ndia memutuskan ikut-ikutan.
Dialogue: 0,0:10:01.62,0:10:02.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai memasak.
Dialogue: 0,0:10:03.46,0:10:06.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah kumpulkan semua\Nyang bisa jadi isian!
Dialogue: 0,0:10:06.55,0:10:07.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak sekali!
Dialogue: 0,0:10:08.39,0:10:09.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini salmon?
Dialogue: 0,0:10:10.08,0:10:12.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya! Biar murah,\Npakai daging yang nempel di tulangnya!
Dialogue: 0,0:10:13.18,0:10:17.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu! Memang hebat Ketua,\Njago masak juga, ya.
Dialogue: 0,0:10:17.27,0:10:20.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku masih kalah sama Mizunoe.
Dialogue: 0,0:10:20.05,0:10:21.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arisu! Lihat itu!
Dialogue: 0,0:10:21.80,0:10:24.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, seperti pasangan suami istri.\NBenar-benar.
Dialogue: 0,0:10:25.67,0:10:26.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedang mencicipi.
Dialogue: 0,0:10:27.01,0:10:30.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mm! Kaldunya enak.\NHebat juga anak itu.
Dialogue: 0,0:10:30.06,0:10:33.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar! Memang Ketua,\Nenak sekali.
Dialogue: 0,0:10:33.92,0:10:34.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak!
Dialogue: 0,0:10:35.20,0:10:38.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak Tante itu... memang enak, ya?
Dialogue: 0,0:10:38.18,0:10:39.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Iya!
Dialogue: 0,0:10:39.58,0:10:42.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Walah, astaga. Begitu, ya.
Dialogue: 0,0:10:43.97,0:10:44.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ume.
Dialogue: 0,0:10:45.08,0:10:46.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, siap.
Dialogue: 0,0:10:46.50,0:10:47.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hati-hati, ya!
Dialogue: 0,0:10:48.71,0:10:50.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arisu! Anak itu...
Dialogue: 0,0:10:51.08,0:10:54.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, seperti orang tua dan anak, ya.
Dialogue: 0,0:10:55.45,0:10:56.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang tua dan anak?!
Dialogue: 0,0:10:57.10,0:10:58.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Namanya Komaro.
Dialogue: 0,0:10:58.86,0:11:00.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di kalangan tertentu, mereka disebut begini:
Dialogue: 0,0:11:01.09,0:11:03.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mama Hisako, Papa Ume, dan Komaro.
Dialogue: 0,0:11:04.34,0:11:05.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti...
Dialogue: 0,0:11:05.23,0:11:07.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cucu... maksudnya?! Cucuku...?!
Dialogue: 0,0:11:07.51,0:11:09.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, otomatis begitu.
Dialogue: 0,0:11:10.09,0:11:13.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ko-Komaro! Masak bareng Tante, yuk?
Dialogue: 0,0:11:13.87,0:11:14.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:11:14.89,0:11:17.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hup... hup...
Dialogue: 0,0:11:17.42,0:11:19.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, ah, Komaro.
Dialogue: 0,0:11:19.62,0:11:22.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau onigiri dipegang begini,\Nbentuknya bakal rapi, lo.
Dialogue: 0,0:11:23.06,0:11:23.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini?
Dialogue: 0,0:11:23.81,0:11:27.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, anu, begini, dibikin siku...
Dialogue: 0,0:11:27.48,0:11:29.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu.
Dialogue: 0,0:11:29.62,0:11:33.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah, hah. Inilah... cucu!
Dialogue: 0,0:11:34.09,0:11:34.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi!
Dialogue: 0,0:11:35.83,0:11:38.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cantik, kelihatannya enak.
Dialogue: 0,0:11:38.64,0:11:40.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah.
Dialogue: 0,0:11:40.00,0:11:41.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, langsung saja.
Dialogue: 0,0:11:41.63,0:11:42.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:11:43.49,0:11:44.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat makan.
Dialogue: 0,0:11:45.48,0:11:47.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak! Hasilnya bagus.
Dialogue: 0,0:11:47.98,0:11:52.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah!\NAh, Koma, ada yang nempel, tuh.
Dialogue: 0,0:11:52.38,0:11:53.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:11:53.78,0:11:55.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arisu, ini...
Dialogue: 0,0:11:55.66,0:11:56.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:11:56.84,0:11:58.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rumah dua generasi, ya.
Dialogue: 0,0:11:58.65,0:12:00.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, 'kan?! Bagaimana ini?
Dialogue: 0,0:12:01.38,0:12:03.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak untuk hari ini.
Dialogue: 0,0:12:03.59,0:12:06.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkat kalian berdua,\Nrasanya kami sudah maju jauh.
Dialogue: 0,0:12:07.11,0:12:09.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, ini berkat kalian semua!
Dialogue: 0,0:12:09.26,0:12:11.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah, tidak apa-apa, jangan dipikirkan.
Dialogue: 0,0:12:11.80,0:12:13.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, satu lagi, Tante Mayuki.
Dialogue: 0,0:12:15.25,0:12:19.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lain kali, aku ingin sekali\Nmencicipi masakan Tante Mayuki.
Dialogue: 0,0:12:23.73,0:12:27.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah, hari ini aku dapat cucu,
Dialogue: 0,0:12:27.68,0:12:28.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bahkan sampai ditembak segala.
Dialogue: 0,0:12:28.94,0:12:29.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pfft?!
Dialogue: 0,0:12:30.39,0:12:32.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Hentikan.\N- Papa 25 tahun
Dialogue: 0,0:12:32.23,0:12:34.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menikah dengan Mayuki 18 tahun,
Dialogue: 0,0:12:34.53,0:12:38.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu berhenti kerja dan meneruskan\Nusaha keluarga orang tua Mayuki.
Dialogue: 0,0:12:39.85,0:12:40.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sip.
Dialogue: 0,0:12:40.57,0:12:41.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi!
Dialogue: 0,0:12:41.74,0:12:43.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Proposal onigirinya selesai,
Dialogue: 0,0:12:43.68,0:12:46.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berkat Ketua dan Tante Mayuki,\Nsemuanya tersusun rapi.
Dialogue: 0,0:12:47.29,0:12:51.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka juga bersedia memproduksinya.\NKita benar-benar berutang budi, ya.
Dialogue: 0,0:12:51.82,0:12:55.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan pada Tante!\NDemi Ume dan Cucu-maro!
Dialogue: 0,0:12:55.38,0:12:57.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekalian promosi juga!
Dialogue: 0,0:12:57.02,0:12:57.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cucu?
Dialogue: 0,0:12:58.10,0:13:00.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Termasuk ongkos tenaga kerja,\Nsatu buah 70 yen.
Dialogue: 0,0:13:00.67,0:13:03.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan ini, keinginan Michinoku\Nbisa terwujud.
Dialogue: 0,0:13:03.82,0:13:05.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa pun yang lihat pasti bilang ini murah!
Dialogue: 0,0:13:05.70,0:13:08.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tinggal soal cara jualnya, ya.
Dialogue: 0,0:13:08.99,0:13:10.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah.
Dialogue: 0,0:13:10.50,0:13:13.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayaknya agak susah, deh.
Dialogue: 0,0:13:13.58,0:13:14.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, anu...
Dialogue: 0,0:13:15.12,0:13:16.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa, Bu?
Dialogue: 0,0:13:16.05,0:13:19.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini, koperasi sekolah itu\Ndikelola pihak luar.
Dialogue: 0,0:13:19.98,0:13:23.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi kurang pas kalau murid ikut campur...
Dialogue: 0,0:13:23.69,0:13:30.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Prinsip sekolah kita, menghargai kemandirian\Nmurid dan mendukung tantangannya, 'kan?
Dialogue: 0,0:13:30.50,0:13:32.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa ini sesuai dengan itu.
Dialogue: 0,0:13:32.64,0:13:35.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menu yang bisa direalisasikan\Njuga sudah kami buat, lo.
Dialogue: 0,0:13:35.59,0:13:37.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, iya, Ibu paham!
Dialogue: 0,0:13:37.41,0:13:39.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu paham perasaanmu.
Dialogue: 0,0:13:39.56,0:13:42.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kalau selain onigiri\Njadi tidak laku, gawat, 'kan?
Dialogue: 0,0:13:42.84,0:13:45.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zaman sekarang\Ndi mana-mana ekonomi lagi lesu.
Dialogue: 0,0:13:45.14,0:13:47.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pihak penyedianya pasti kesusahan.
Dialogue: 0,0:13:47.45,0:13:48.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Itu...
Dialogue: 0,0:13:49.34,0:13:54.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, harga di koperasi sekolah kita\Njauh lebih mahal dari rata-rata, 'kan?
Dialogue: 0,0:13:55.32,0:13:57.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana pendapat Ibu soal itu?
Dialogue: 0,0:13:57.40,0:13:57.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:13:58.33,0:14:01.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, ya, memang agak mahal, sih.
Dialogue: 0,0:14:02.00,0:14:05.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi harga kan tergantung\Nharga barang dan lokasi.
Dialogue: 0,0:14:05.15,0:14:08.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu keputusan pihak sana, 'kan?\NIbu juga tidak tahu, sih.
Dialogue: 0,0:14:08.65,0:14:11.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, pokoknya maaf, ya! Dah.
Dialogue: 0,0:14:12.32,0:14:14.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi, berkas yang itu.
Dialogue: 0,0:14:15.13,0:14:16.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm.
Dialogue: 0,0:14:17.06,0:14:18.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat, nih.
Dialogue: 0,0:14:18.63,0:14:19.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:14:20.01,0:14:22.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada cara lain, ya?
Dialogue: 0,0:14:22.56,0:14:24.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jurus jitu yang tidak merugikan siapa pun...
Dialogue: 0,0:14:24.71,0:14:27.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, siasat ajaib...\Nbukan, jurus super pemungkas...
Dialogue: 0,0:14:28.16,0:14:29.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebelum pulang sekolah,\Nharus ketemu solusinya...
Dialogue: 0,0:14:31.10,0:14:32.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Michinoku?!
Dialogue: 0,0:14:32.43,0:14:33.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yo.
Dialogue: 0,0:14:33.37,0:14:34.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Se-Sejak kapan...
Dialogue: 0,0:14:34.87,0:14:36.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagian, kain apa itu?
Dialogue: 0,0:14:36.50,0:14:37.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buat tes cicip.
Dialogue: 0,0:14:38.82,0:14:42.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Onigiri buat anak Ekskul Bisbol.\NKatanya enak.
Dialogue: 0,0:14:42.10,0:14:44.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, syukurlah!
Dialogue: 0,0:14:45.15,0:14:47.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya. Aku bikin sekitar 30 buah.
Dialogue: 0,0:14:47.98,0:14:48.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak banget.
Dialogue: 0,0:14:49.21,0:14:51.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Habis dalam sekitar 30 detik.\N- Nasi putih?! Ada isinya juga?!
Dialogue: 0,0:14:51.26,0:14:52.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak...
Dialogue: 0,0:14:52.30,0:14:53.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelaparan banget...
Dialogue: 0,0:14:53.70,0:14:55.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong...
Dialogue: 0,0:14:56.45,0:14:58.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Komachan, mana makan siangmu?
Dialogue: 0,0:14:58.63,0:15:00.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, lupa.
Dialogue: 0,0:15:00.70,0:15:02.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu ini, padahal bikin 30 buah.
Dialogue: 0,0:15:03.17,0:15:05.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya sudah, makan bekalku saja.
Dialogue: 0,0:15:05.55,0:15:08.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ume, yang tadi bikin kamu bingung itu,
Dialogue: 0,0:15:08.24,0:15:09.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}soal onigiri?
Dialogue: 0,0:15:09.25,0:15:12.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, bukan, itu...
Dialogue: 0,0:15:12.55,0:15:13.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, begitulah.
Dialogue: 0,0:15:15.20,0:15:18.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ta-Tapi baru sekali negosiasi\Nsama Tata Usaha, kok.
Dialogue: 0,0:15:18.08,0:15:20.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma ada sedikit hambatan.
Dialogue: 0,0:15:20.01,0:15:22.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, aku juga berencana\Nbicara baik-baik dengan mereka.
Dialogue: 0,0:15:26.38,0:15:28.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, ya.
Dialogue: 0,0:15:32.09,0:15:32.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:15:33.28,0:15:37.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa minta maaf?\NKami baru sekali negosiasi, lo.
Dialogue: 0,0:15:38.12,0:15:41.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar begini, aku jago negosiasi.
Dialogue: 0,0:15:41.49,0:15:43.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dibicarakan baik-baik, pasti beres.
Dialogue: 0,0:15:44.39,0:15:46.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, kalau dijelaskan sungguh-sungguh...
Dialogue: 0,0:15:47.14,0:15:48.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kujual 40 yen.
Dialogue: 0,0:15:49.43,0:15:52.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya ini harapan yang sudah\Nsusah-susah disampaikan ke kita.
Dialogue: 0,0:15:56.97,0:15:59.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti beres!
Dialogue: 0,0:16:03.32,0:16:04.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ume.
Dialogue: 0,0:16:05.38,0:16:08.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar sekali. Kalau kita, pasti bisa.
Dialogue: 0,0:16:09.08,0:16:10.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arisu? Ada apa?
Dialogue: 0,0:16:11.24,0:16:13.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita lakukan, yuk, jurus super pemungkas!
Dialogue: 0,0:16:13.61,0:16:14.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}★5-7-5-7-7
Dialogue: 0,0:16:22.43,0:16:23.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi.
Dialogue: 0,0:16:23.58,0:16:25.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, iya... lo?
Dialogue: 0,0:16:26.07,0:16:27.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian lagi?
Dialogue: 0,0:16:28.05,0:16:30.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisakah Ibu meluangkan waktu sekali lagi?
Dialogue: 0,0:16:30.98,0:16:34.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh. Tata Usaha dikira nganggur, ya?
Dialogue: 0,0:16:34.39,0:16:35.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini-begini, kami juga...
Dialogue: 0,0:16:36.49,0:16:36.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:16:37.31,0:16:40.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu menggelapkan uang koperasi, 'kan?
Dialogue: 0,0:16:43.97,0:16:45.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menggelapkan?!
Dialogue: 0,0:16:45.07,0:16:49.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Roti di koperasi sekolah kita\Nsejak dulu agak kemahalan, 'kan?
Dialogue: 0,0:16:50.53,0:16:51.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inilah alasannya.
Dialogue: 0,0:16:52.11,0:16:53.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Voucer belanja?
Dialogue: 0,0:16:53.61,0:16:56.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya staf itu\Nyang mendatangkan penyedianya,
Dialogue: 0,0:16:56.14,0:17:00.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan sebagai imbalan kontraknya,\Ndia menerima voucer.
Dialogue: 0,0:17:00.31,0:17:01.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Li-Licik banget.
Dialogue: 0,0:17:02.65,0:17:03.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:17:03.54,0:17:05.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ini kami sodorkan...
Dialogue: 0,0:17:07.48,0:17:07.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:17:08.81,0:17:09.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyebelin.
Dialogue: 0,0:17:10.46,0:17:15.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kirain datang semangat-semangat mau apa,\Nitu cuma kebetulan, tahu.
Dialogue: 0,0:17:15.17,0:17:16.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kebetulan!
Dialogue: 0,0:17:16.34,0:17:18.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Voucer itu cuma lupa dilaporkan!
Dialogue: 0,0:17:18.64,0:17:20.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama sekali tidak ada masalah.
Dialogue: 0,0:17:20.85,0:17:22.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jelek banget kelakuannya.
Dialogue: 0,0:17:22.81,0:17:25.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagian, kalian ini bodoh, ya?
Dialogue: 0,0:17:25.56,0:17:29.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asal tahu saja, aku ini\Nbenar-benar disukai semua guru.
Dialogue: 0,0:17:29.59,0:17:30.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian tidak tahu itu, ya?
Dialogue: 0,0:17:31.12,0:17:32.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan...?!
Dialogue: 0,0:17:32.50,0:17:34.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah bagaimana caranya kalian dapat itu,
Dialogue: 0,0:17:34.74,0:17:37.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi ini peretasan email\Ndan percobaan pemerasan.
Dialogue: 0,0:17:37.12,0:17:39.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kulaporkan ke para guru.
Dialogue: 0,0:17:40.26,0:17:42.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ugh. Licik!\NKalau begini terus...
Dialogue: 0,0:17:43.11,0:17:45.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa boleh buat. Hmm...
Dialogue: 0,0:17:46.00,0:17:49.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Ah, Guru Tanaka *** di bawah sana."
Dialogue: 0,0:17:49.94,0:17:51.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Se-Senior Terui?!
Dialogue: 0,0:17:51.50,0:17:54.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Botaknya Kepala Sekolah keren banget\Nsampai pengin kusembah."
Dialogue: 0,0:17:54.42,0:17:57.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Si monyet ngelirik, jadi kubusungkan dadaku.\NEnak banget."
Dialogue: 0,0:17:57.70,0:18:01.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Deg-deg ***...\NSMA is a wonderful *** world."
Dialogue: 0,0:18:01.73,0:18:04.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kebanyakan diposting tengah malam, ya.
Dialogue: 0,0:18:04.21,0:18:06.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minum alkohol, lalu jadi kesepian?
Dialogue: 0,0:18:06.71,0:18:08.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, itu... Jangan-jangan...
Dialogue: 0,0:18:10.07,0:18:12.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kamu dapat itu dari mana...
Dialogue: 0,0:18:12.09,0:18:13.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harus hati-hati, lo.
Dialogue: 0,0:18:14.06,0:18:16.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Merek lokal begitu gampang ketahuan.
Dialogue: 0,0:18:16.98,0:18:18.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, bagaimana, ya?
Dialogue: 0,0:18:18.94,0:18:21.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}***... ***...
Dialogue: 0,0:18:21.61,0:18:22.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah.
Dialogue: 0,0:18:23.15,0:18:27.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cantik-cantik begini,\Nternyata kurang belaian, ya.
Dialogue: 0,0:18:29.39,0:18:32.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana? Mau mengadu ke para guru?
Dialogue: 0,0:18:32.45,0:18:34.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak, tidak akan mengadu...
Dialogue: 0,0:18:34.73,0:18:36.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Onigirinya boleh dijual?
Dialogue: 0,0:18:36.81,0:18:38.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku usahakan.
Dialogue: 0,0:18:38.70,0:18:41.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai sekarang, Ibu akan menuruti\Nkata-kata kami?
Dialogue: 0,0:18:41.60,0:18:42.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan aku turuti.
Dialogue: 0,0:18:42.46,0:18:43.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mmh!
Dialogue: 0,0:18:43.65,0:18:47.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mizunoe pun merasa\Ntidak boleh melawan orang ini.
Dialogue: 0,0:18:47.97,0:18:49.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf mendadak, ya.
Dialogue: 0,0:18:49.40,0:18:51.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:18:52.30,0:18:53.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa, sih?
Dialogue: 0,0:18:53.62,0:18:55.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Barangnya banyak.
Dialogue: 0,0:18:56.20,0:18:57.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong jadi pijakan, ya.
Dialogue: 0,0:18:58.25,0:18:58.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hoek.
Dialogue: 0,0:19:00.40,0:19:01.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke! Akhirnya...
Dialogue: 0,0:19:01.78,0:19:03.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rak penjualan onigiri!
Dialogue: 0,0:19:03.78,0:19:04.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selesai!
Dialogue: 0,0:19:05.42,0:19:07.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Onigiri Tiga Generasi usulan Tante Mayuki...
Dialogue: 0,0:19:07.88,0:19:09.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namanya aneh, tapi bagus juga!
Dialogue: 0,0:19:09.95,0:19:11.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tante yang membentuknya.
Dialogue: 0,0:19:11.75,0:19:13.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Onigiri Tiga Generasi...
Dialogue: 0,0:19:13.58,0:19:16.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku, sih, lebih suka nama Onigiri Komaro...
Dialogue: 0,0:19:16.62,0:19:18.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, omong-omong...
Dialogue: 0,0:19:18.42,0:19:21.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saegusa, terima kasih\Nsudah jadi petugas penagih uang, ya.
Dialogue: 0,0:19:21.12,0:19:22.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berisik...
Dialogue: 0,0:19:22.68,0:19:23.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan panggil namaku begitu saja.
Dialogue: 0,0:19:23.81,0:19:25.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Huh, kenapa harus aku...
Dialogue: 0,0:19:25.83,0:19:28.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, kami kekurangan orang.
Dialogue: 0,0:19:28.19,0:19:31.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagian, pasti ada yang lebih cocok, 'kan?
Dialogue: 0,0:19:31.29,0:19:34.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini-begini aku\Nlulusan universitas negeri, lo.
Dialogue: 0,0:19:34.14,0:19:35.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, benar juga.
Dialogue: 0,0:19:35.41,0:19:37.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saegusa kan bisa saja\Nmenggelapkan uangnya, ya.
Dialogue: 0,0:19:37.90,0:19:39.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak akan, tahu! Jangan keras-keras!
Dialogue: 0,0:19:39.72,0:19:41.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, sial, uang 10 yen!
Dialogue: 0,0:19:41.59,0:19:43.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kembaliannya cukup, tidak, nih?!
Dialogue: 0,0:19:43.15,0:19:44.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, iya.
Dialogue: 0,0:19:44.00,0:19:46.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi dia tetap kerja dengan benar, ya.
Dialogue: 0,0:19:47.00,0:19:47.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Toko dibuka.
Dialogue: 0,0:19:48.10,0:19:49.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh! Sudah mulai, ya!
Dialogue: 0,0:19:49.47,0:19:50.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami datang untuk menyumbang!
Dialogue: 0,0:19:50.73,0:19:52.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kami sering dibantu OSIS, sih.\N- Anak-anak Ekskul Renang!
Dialogue: 0,0:19:52.63,0:19:54.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, murah banget! Kelihatannya enak!
Dialogue: 0,0:19:54.35,0:19:56.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, semuanya, beli sebanyak-banyaknya!
Dialogue: 0,0:19:56.32,0:19:57.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:20:00.42,0:20:01.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau kutalangi dulu?
Dialogue: 0,0:20:01.68,0:20:02.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Asyik!\N- Yo.
Dialogue: 0,0:20:02.84,0:20:03.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah! Halo.
Dialogue: 0,0:20:04.23,0:20:05.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, nih?
Dialogue: 0,0:20:05.67,0:20:08.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}OSIS lagi bikin acara jualan onigiri.
Dialogue: 0,0:20:08.44,0:20:10.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hmm, kalau begitu dua.
Dialogue: 0,0:20:11.28,0:20:12.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, semangat, ya.
Dialogue: 0,0:20:12.97,0:20:14.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak!
Dialogue: 0,0:20:15.06,0:20:18.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal dia sudah beli roti, lo.\NEnak.
Dialogue: 0,0:20:18.32,0:20:21.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin maksudnya mendukung?\NSok keren, ya.
Dialogue: 0,0:20:21.35,0:20:22.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bilang begitu, dong.
Dialogue: 0,0:20:23.18,0:20:25.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang-orang mulai berdatangan, ya!
Dialogue: 0,0:20:25.11,0:20:27.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lancar, nih, Michinoku!
Dialogue: 0,0:20:27.20,0:20:28.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo, Ume.
Dialogue: 0,0:20:28.85,0:20:30.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minta tiga, ya.
Dialogue: 0,0:20:30.71,0:20:31.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Batsunosuke.
Dialogue: 0,0:20:31.78,0:20:34.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiga? Terima kasih sudah beli banyak.
Dialogue: 0,0:20:34.47,0:20:37.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, iya. Disuruh Klub Riset Robot...
Dialogue: 0,0:20:37.53,0:20:40.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, sungguh, maaf...
Dialogue: 0,0:20:40.96,0:20:44.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membelikan untuk orang yang tidak datang\Nitu curang, tidak, ya?
Dialogue: 0,0:20:44.88,0:20:48.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apalagi tiga buah itu terlalu serakah.
Dialogue: 0,0:20:48.26,0:20:49.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini, 210 yen, ya.
Dialogue: 0,0:20:49.45,0:20:51.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Uooh! Onigiri Tiga Generasi!
Dialogue: 0,0:20:51.90,0:20:52.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ekskul Bisbol!
Dialogue: 0,0:20:52.52,0:20:53.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minta lima!
Dialogue: 0,0:20:53.34,0:20:54.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enam!
Dialogue: 0,0:20:54.28,0:20:55.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, iya.
Dialogue: 0,0:20:55.23,0:20:55.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak!
Dialogue: 0,0:20:55.74,0:20:57.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Laris banget, ya.\N- Rasanya mau naik ke surga...!
Dialogue: 0,0:20:57.42,0:20:58.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nasi... enak...
Dialogue: 0,0:20:59.06,0:21:00.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perut... kenyang...
Dialogue: 0,0:21:00.49,0:21:01.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi bencana kelaparan, ya?
Dialogue: 0,0:21:02.26,0:21:04.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, ini enak juga.
Dialogue: 0,0:21:04.30,0:21:05.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu Guru.
Dialogue: 0,0:21:05.60,0:21:08.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa-bisanya harganya segini.\NPantas laris.
Dialogue: 0,0:21:09.32,0:21:11.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai bisa meyakinkan\NTata Usaha yang keras kepala itu...
Dialogue: 0,0:21:11.95,0:21:13.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian sudah berusaha keras, ya.
Dialogue: 0,0:21:13.72,0:21:16.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Bu Guru, itu sudah dibayar?\N- Ibu juga ikut bantu, lo. Ke Michinoku.
Dialogue: 0,0:21:16.41,0:21:17.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keras kepala...
Dialogue: 0,0:21:17.52,0:21:19.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu juga sudah berusaha, ya.
Dialogue: 0,0:21:19.29,0:21:21.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat! Hampir habis terjual!
Dialogue: 0,0:21:21.73,0:21:22.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar!
Dialogue: 0,0:21:22.98,0:21:25.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, tapi capek juga.
Dialogue: 0,0:21:25.20,0:21:28.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya. Michinoku, istirahat dulu, yuk.
Dialogue: 0,0:21:28.61,0:21:29.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hee, onigiri?
Dialogue: 0,0:21:30.03,0:21:32.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh! Enak!\NBeli satu, ah.
Dialogue: 0,0:21:32.66,0:21:36.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya. Masih buka... jadi, mampir, ya.
Dialogue: 0,0:21:36.86,0:21:37.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:21:43.37,0:21:45.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untung kita lakukan, ya!
Dialogue: 0,0:21:46.30,0:21:46.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:21:47.51,0:21:49.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, rotinya...
Dialogue: 0,0:21:49.04,0:21:50.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ogah. Makan sendiri sana.
Dialogue: 0,0:21:50.89,0:21:52.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya jangan sok keren.
Dialogue: 0,0:21:52.96,0:21:54.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah kenyang, sih.
Dialogue: 0,0:21:54.49,0:21:56.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kan masih ada mulut bawah.
Dialogue: 0,0:21:56.49,0:21:57.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ih, menjijikkan!
Dialogue: 0,0:21:59.08,0:22:01.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau makan pakai mulut bawah?!
Dialogue: 0,0:22:01.06,0:22:03.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duh, ya sudah, deh! Aku bantu!
Dialogue: 0,0:22:03.42,0:22:05.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak jadi, kubawa pulang saja.
