Dialogue: 0,0:11:14.57,0:11:14.88,sign,,0000,0000,0000,,TARIK
Dialogue: 0,0:11:33.42,0:11:34.08,sign,,0000,0000,0000,,1 SEMUR URAT SAPI, 2 DAGING TULANG SALMON,\N3 KARAAGE MAYONES DADA AYAM
Dialogue: 0,0:11:34.86,0:11:35.29,sign,,0000,0000,0000,,4 DAUN BAWANG, NATTO, DAN TAHU GORENG\N5 SHIOKARA CUMI DAN KEJU
Dialogue: 0,0:11:35.29,0:11:35.58,sign,,0000,0000,0000,,6 MENTSUYU, REMAH TEMPURA, DAN DAUN BAWANG
Dialogue: 0,0:12:19.38,0:12:20.05,sign,,0000,0000,0000,,MAKSUDNYA MASAKAN DI RUMAH MAKAN
