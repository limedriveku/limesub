Dialogue: 0,0:17:20.60,0:17:21.96,sign,,0000,0000,0000,,ROTI 130 YEN DIBAGI UNTUK 2 KALI MAKAN\NMENADAH DENGAN TANGAN TIDAK SOPAN,
Dialogue: 0,0:17:21.96,0:17:23.56,sign,,0000,0000,0000,,TAPI MENADAH DENGAN DADA JUSTRU BERETIKA
Dialogue: 0,0:17:23.82,0:17:26.85,sign,,0000,0000,0000,,RUANG OSIS
Dialogue: 0,0:23:35.18,0:23:36.07,sign,,0000,0000,0000,,CUPLIKAN EPISODE BERIKUTNYA
Dialogue: 0,0:23:36.07,0:23:38.70,sign,,0000,0000,0000,,SYUKURLAH PEMBERSIHAN KOLAM RENANG,\NEPISODE BAJU RENANG!
Dialogue: 0,0:23:38.70,0:23:41.15,sign,,0000,0000,0000,,NANTIKAN EPISODE BERIKUTNYA, YA!
Dialogue: 0,0:00:02.45,0:00:05.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, hari ini kita melakukan kegiatan Humas!
Dialogue: 0,0:00:05.56,0:00:07.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Humas, ya?\NApa yang harus kita lakukan?
Dialogue: 0,0:00:07.88,0:00:10.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena poster baru sudah dibuat,\Nkita akan mengganti poster yang lama.
Dialogue: 0,0:00:11.21,0:00:16.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Otori mana?\NDia kan Humas.
Dialogue: 0,0:00:16.48,0:00:19.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, barusan dia info kalau baru bangun.
Dialogue: 0,0:00:19.12,0:00:20.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang sampah.
Dialogue: 0,0:00:20.63,0:00:22.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, ada lagi.
Dialogue: 0,0:00:22.80,0:00:23.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih sampah lagi.
Dialogue: 0,0:00:23.98,0:00:26.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa malah santai\Nbikin sarapan elegan begitu?
Dialogue: 0,0:02:00.55,0:02:04.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sip, ayo segera dipasang!\NTolong lepas poster yang lama, ya.
Dialogue: 0,0:02:05.00,0:02:06.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap.
Dialogue: 0,0:02:06.34,0:02:06.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:02:07.33,0:02:09.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, poster lama yang ini?
Dialogue: 0,0:02:09.72,0:02:10.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya...
Dialogue: 0,0:02:13.54,0:02:15.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Narsisnya tak terbendung lagi, ya.
Dialogue: 0,0:02:15.82,0:02:19.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dulu dia bikin sendiri posternya.\NLumayan banyak yang suka, sih.
Dialogue: 0,0:02:20.09,0:02:24.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf terlambat! Ada apa, nih?\NKalian lagi lihatin posterku?
Dialogue: 0,0:02:24.37,0:02:25.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si bodoh datang.
Dialogue: 0,0:02:25.62,0:02:27.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Poster ini bagus banget, 'kan?!
Dialogue: 0,0:02:27.88,0:02:30.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hampir kelihatan, tapi ternyata tidak!\NInilah erotisme!
Dialogue: 0,0:02:30.30,0:02:32.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,\Ndipakai untuk main tebak puting saja.
Dialogue: 0,0:02:32.82,0:02:33.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putingku?!
Dialogue: 0,0:02:34.11,0:02:36.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, ini hukuman karena terlambat.
Dialogue: 0,0:02:36.21,0:02:37.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berisik sekali.
Dialogue: 0,0:02:40.37,0:02:43.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanchan, hati-hati, nanti papannya rusak.
Dialogue: 0,0:02:43.95,0:02:44.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:02:44.78,0:02:47.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, peduli sekali sama papannya.
Dialogue: 0,0:02:48.56,0:02:49.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudmu?
Dialogue: 0,0:02:50.09,0:02:54.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Habisnya, kamu sendiri kan rata kayak papan.
Dialogue: 0,0:02:57.13,0:02:57.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Papannya...
Dialogue: 0,0:02:57.79,0:03:00.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo ke papan pengumuman berikutnya.
Dialogue: 0,0:03:02.43,0:03:04.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fiuh, akhirnya selesai juga.
Dialogue: 0,0:03:04.94,0:03:07.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita istirahat dulu.\NOmong-omong...
Dialogue: 0,0:03:08.55,0:03:12.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ume lebih suka yang "berisi"\Natau yang "tidak"?
Dialogue: 0,0:03:12.76,0:03:13.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:03:15.54,0:03:17.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang "tidak"... kayaknya...
Dialogue: 0,0:03:17.22,0:03:18.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, kebetulan aku juga.
Dialogue: 0,0:03:19.52,0:03:21.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?\NNgobrolin filosofi?
Dialogue: 0,0:03:24.17,0:03:26.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, ya, jadi merepotkan.
Dialogue: 0,0:03:26.31,0:03:28.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak masalah.\NYang itu bisa dibawa?
Dialogue: 0,0:03:28.93,0:03:31.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini-begini aku Ketua OSIS, lo.\NIni, sih, kecil!
Dialogue: 0,0:03:32.06,0:03:32.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa diandalkan, ya.
Dialogue: 0,0:03:33.08,0:03:35.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, ada lagi yang mau\Nkuminta tolong pada Mizunoe.
Dialogue: 0,0:03:36.26,0:03:37.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata lebih suka yang berisi, ya?
Dialogue: 0,0:03:37.84,0:03:38.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, tidak, bukan, kok!
Dialogue: 0,0:03:39.34,0:03:41.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, kalian lagi kerja, ya?
Dialogue: 0,0:03:41.67,0:03:42.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu Guru.
Dialogue: 0,0:03:42.81,0:03:44.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus.\NTolong bawa ke kelas 3, ya.
Dialogue: 0,0:03:44.90,0:03:46.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok malah ditambah?!
Dialogue: 0,0:03:46.62,0:03:47.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Laporan.
Dialogue: 0,0:03:47.66,0:03:49.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa boleh buat.
Dialogue: 0,0:03:50.11,0:03:51.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang lebih suka yang berisi, 'kan?
Dialogue: 0,0:03:51.51,0:03:52.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kubilang bukan!
Dialogue: 0,0:03:52.92,0:03:57.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata Ume suka yang berisi, ya.\NApa aku operasi implan saja, ya?
Dialogue: 0,0:03:57.49,0:03:58.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak usah, tidak usah.
Dialogue: 0,0:03:58.91,0:04:01.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, kenapa Senior\Npeduli sekali dengan seleraku?
Dialogue: 0,0:04:02.01,0:04:03.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kan cuma adik kelasmu.
Dialogue: 0,0:04:03.43,0:04:04.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh.
Dialogue: 0,0:04:06.35,0:04:08.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kamu imut, sih.
Dialogue: 0,0:04:09.75,0:04:11.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, setengahnya cuma bercanda, kok.
Dialogue: 0,0:04:12.10,0:04:12.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setengah?
Dialogue: 0,0:04:13.01,0:04:16.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa dibilang kamu adik kelas pertamaku,\Nkarena itu...
Dialogue: 0,0:04:17.22,0:04:20.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah mengapa, adik kelas biasanya\Nbanyak yang menghindariku.
Dialogue: 0,0:04:20.69,0:04:22.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanchan tidak dihitung, sih.
Dialogue: 0,0:04:23.16,0:04:27.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kuharap bisa akrab dengan Ume.
Dialogue: 0,0:04:28.31,0:04:29.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:04:30.03,0:04:31.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, tapi...
Dialogue: 0,0:04:31.56,0:04:34.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau terlalu berlebihan,\Ntahu akibatnya, 'kan?
Dialogue: 0,0:04:35.25,0:04:36.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Su...
Dialogue: 0,0:04:37.09,0:04:38.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, belnya sudah berbunyi.
Dialogue: 0,0:04:38.94,0:04:41.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, ayo kita pulang.\NSampai jumpa besok.
Dialogue: 0,0:04:41.59,0:04:43.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga dia menyeramkan.
Dialogue: 0,0:04:46.44,0:04:47.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah.
Dialogue: 0,0:04:48.13,0:04:51.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini komunikasiku cukup bagus, ya!
Dialogue: 0,0:04:51.82,0:04:56.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu terlihat seperti senior berwibawa,\Ntapi juga ramah dan suka bercanda.
Dialogue: 0,0:04:56.71,0:04:58.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dipikirkan berulang kali pun,\Nnilainya tetap sempurna.
Dialogue: 0,0:04:58.55,0:05:00.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arisu, waktunya makan.
Dialogue: 0,0:05:00.64,0:05:04.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti lobster bisque dan sole meuniere-nya\Nkeburu dingin.
Dialogue: 0,0:05:05.69,0:05:06.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ha...
Dialogue: 0,0:05:06.01,0:05:07.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hancur.
Dialogue: 0,0:05:07.55,0:05:08.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nilainya nol besar.
Dialogue: 0,0:05:08.81,0:05:10.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi naksir seseorang?
Dialogue: 0,0:05:10.64,0:05:12.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, bukan begitu.
Dialogue: 0,0:05:15.18,0:05:16.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih atas kerja kerasnya.
Dialogue: 0,0:05:16.85,0:05:18.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selesai juga.
Dialogue: 0,0:05:18.50,0:05:19.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, kerja bagus semuanya.
Dialogue: 0,0:05:20.43,0:05:22.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Ketua masih mau di sini?
Dialogue: 0,0:05:22.67,0:05:27.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, aku mau menyelesaikan buku panduan\Nkegiatan Ekskul Renang hari ini.
Dialogue: 0,0:05:27.43,0:05:29.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemarin mereka minta bantuan.
Dialogue: 0,0:05:29.61,0:05:33.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, kurasa bisa selesai dalam satu jam.\NKalian pulang saja, jangan khawatir.
Dialogue: 0,0:05:33.57,0:05:36.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Stok kopinya baru diisi lagi,\Nyakin satu jam selesai?
Dialogue: 0,0:05:37.01,0:05:37.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah!
Dialogue: 0,0:05:38.19,0:05:39.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh?
Dialogue: 0,0:05:39.50,0:05:41.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, tidak, itu...
Dialogue: 0,0:05:43.00,0:05:45.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga bisa selesai\Nsebelum sekolah dimulai besok.
Dialogue: 0,0:05:45.50,0:05:46.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu, sih, sehari penuh!
Dialogue: 0,0:05:47.04,0:05:49.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa terima kerjaan seperti itu?!
Dialogue: 0,0:05:49.10,0:05:52.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Uh, habisnya mereka\Nkelihatan sangat kesulitan.
Dialogue: 0,0:05:52.96,0:05:55.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar, lagi-lagi mempersulit diri sendiri.
Dialogue: 0,0:05:55.68,0:05:56.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Weks.
Dialogue: 0,0:05:57.04,0:05:59.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketua selalu membantu orang lain.
Dialogue: 0,0:05:59.86,0:06:04.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, sifat Ketua memang begitu, sih.\NTapi tak perlu disembunyikan dari kami, 'kan?
Dialogue: 0,0:06:04.59,0:06:06.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ha-Habisnya...
Dialogue: 0,0:06:06.72,0:06:09.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kubilang, nanti kalian\Njadi sungkan pulang...
Dialogue: 0,0:06:10.06,0:06:11.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik sekali...
Dialogue: 0,0:06:11.45,0:06:14.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, kalau begitu, aku pulang dulu!\NSelamat bekerja! Yuhu!
Dialogue: 0,0:06:14.74,0:06:15.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang ini, sih, sampah.
Dialogue: 0,0:06:18.04,0:06:22.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?! 30 halaman berwarna?!\NKenapa sebanyak ini?
Dialogue: 0,0:06:22.45,0:06:24.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, begitulah.
Dialogue: 0,0:06:24.53,0:06:27.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka beli komputer baru,\Njadi terlalu semangat bikin panduannya.
Dialogue: 0,0:06:27.85,0:06:31.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, kenapa bukan mereka sendiri\Nyang buat di komputer baru itu?
Dialogue: 0,0:06:31.27,0:06:32.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal itu...
Dialogue: 0,0:06:32.34,0:06:35.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka lupa mencolokkan kabelnya,\Njadi dikira komputernya rusak.
Dialogue: 0,0:06:36.14,0:06:38.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Renang itu paling bagus buat kesehatan!\N- Lalu malah dirusak beneran.
Dialogue: 0,0:06:38.37,0:06:40.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu, sih, sudah bukan sekadar gaptek lagi.
Dialogue: 0,0:06:40.35,0:06:41.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sip, ayo kita lakukan!
Dialogue: 0,0:06:41.77,0:06:43.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:06:43.43,0:06:44.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana cara memulai buku panduan, ya?
Dialogue: 0,0:06:45.00,0:06:47.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biasanya yang pertama ditulis apa?
Dialogue: 0,0:06:47.55,0:06:50.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm, kita coba cari saja.
Dialogue: 0,0:06:53.24,0:06:55.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, sepertinya sinyalnya jelek.
Dialogue: 0,0:06:58.06,0:07:00.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, aneh.
Dialogue: 0,0:07:00.84,0:07:04.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kata pengantarnya tidak ada.
Dialogue: 0,0:07:04.86,0:07:07.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, "pertama" ayo kita mulai.
Dialogue: 0,0:07:07.76,0:07:09.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, tidak, bukan itu.
Dialogue: 0,0:07:10.13,0:07:10.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah.
Dialogue: 0,0:07:11.50,0:07:13.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketua!
Dialogue: 0,0:07:16.70,0:07:18.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duh, sudah larut begini.
Dialogue: 0,0:07:19.46,0:07:21.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senior Terui sudah sampai... mana?
Dialogue: 0,0:07:21.81,0:07:22.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan belum mulai?!
Dialogue: 0,0:07:23.76,0:07:25.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, Ume.
Dialogue: 0,0:07:25.30,0:07:26.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Matanya kayak lagi sekarat!
Dialogue: 0,0:07:26.87,0:07:29.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah mengapa, melihat foto-foto ini\Nmembuat perasaanku tidak enak.
Dialogue: 0,0:07:29.98,0:07:30.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah.
Dialogue: 0,0:07:31.40,0:07:35.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Overdosis gambar dada menurunkan\Nefektivitas kerja hingga 90%.
Dialogue: 0,0:07:35.94,0:07:41.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketua tumbang, Senior Terui sekarat.\NTinggal aku sendiri yang bekerja!
Dialogue: 0,0:07:41.78,0:07:44.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ditambah lagi, aku tidak terbiasa\Npakai program ini.
Dialogue: 0,0:07:45.01,0:07:47.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begini terus,\Nbeneran besok pagi baru bisa selesai!
Dialogue: 0,0:07:48.00,0:07:50.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa pun! Tolong!
Dialogue: 0,0:07:51.08,0:07:51.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah.
Dialogue: 0,0:07:52.05,0:07:53.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu memanggilku?
Dialogue: 0,0:07:53.35,0:07:54.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si sampah!
Dialogue: 0,0:07:54.60,0:07:56.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya kamu sudah pulang?
Dialogue: 0,0:07:56.32,0:07:59.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang mau kulakukan,\Njadi sekalian saja kubantu.
Dialogue: 0,0:07:59.82,0:08:01.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi sudah sampai mana?
Dialogue: 0,0:08:01.31,0:08:02.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, daftar isi...
Dialogue: 0,0:08:03.61,0:08:05.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nih, coba cek.
Dialogue: 0,0:08:07.33,0:08:08.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, apaan, sih? Menjijikkan.
Dialogue: 0,0:08:11.35,0:08:13.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Su-Sudah selesai...
Dialogue: 0,0:08:13.53,0:08:16.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ehem, yah, kira-kira begitulah.
Dialogue: 0,0:08:16.43,0:08:18.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski menyebalkan,\Naku benar-benar tertolong.
Dialogue: 0,0:08:18.69,0:08:22.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sungkan. Kita kan rekan,\Nwajar kalau saling bantu.
Dialogue: 0,0:08:23.35,0:08:23.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu ini...
Dialogue: 0,0:08:24.02,0:08:26.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Puji dan sembah aku.
Dialogue: 0,0:08:26.33,0:08:27.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ogah menyembah.
Dialogue: 0,0:08:28.66,0:08:29.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk dijual...?
Dialogue: 0,0:08:30.32,0:08:31.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini?
Dialogue: 0,0:08:31.92,0:08:32.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, itu!
Dialogue: 0,0:08:33.38,0:08:35.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi tiba-tiba dapat ide!
Dialogue: 0,0:08:35.40,0:08:39.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau jual foto-foto Ekskul Renang\Ndi situs penggemarku!
Dialogue: 0,0:08:40.23,0:08:40.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh...?
Dialogue: 0,0:08:40.66,0:08:43.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, tentu saja wajahnya nanti kusensor.
Dialogue: 0,0:08:43.54,0:08:45.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cukup paham beginian!
Dialogue: 0,0:08:46.53,0:08:48.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ekskul Renang senang panduannya selesai.
Dialogue: 0,0:08:48.94,0:08:51.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengunjungku senang bisa lihat\Ngadis SMA berbaju renang.
Dialogue: 0,0:08:51.89,0:08:54.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan tentu saja, aku senang\Nkarena dapat bayarannya!
Dialogue: 0,0:08:54.34,0:08:56.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku genius sekali, bukan?
Dialogue: 0,0:08:58.48,0:09:00.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, tunggu, tunggu!
Dialogue: 0,0:09:00.74,0:09:01.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya ini?!
Dialogue: 0,0:09:02.26,0:09:04.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang genius ini!\NKenapa malah dipermalukan begini?!
Dialogue: 0,0:09:05.12,0:09:09.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, dilihat pakai baju renang\Nitu memalukan, bukan?
Dialogue: 0,0:09:09.21,0:09:12.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kan genius,\Njadi belajarlah dari pengalaman.
Dialogue: 0,0:09:12.47,0:09:16.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pendapatannya masuk ke dalam\Nanggaran Ekskul Renang.
Dialogue: 0,0:09:17.01,0:09:19.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Arisu, lagi senggang?
Dialogue: 0,0:09:19.31,0:09:21.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, iya, tunggu sebentar, ya.
Dialogue: 0,0:09:24.19,0:09:26.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minta bantuan patroli malam?
Dialogue: 0,0:09:26.79,0:09:29.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, tidak ada lagi yang bisa\Nkumintai tolong selain kalian.
Dialogue: 0,0:09:29.33,0:09:30.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seram.
Dialogue: 0,0:09:33.86,0:09:35.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau urusanku sudah beres,\Naku akan kembali.
Dialogue: 0,0:09:35.83,0:09:38.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Urusan? Mau menghajar berandalan\Natau bagaimana?
Dialogue: 0,0:09:39.40,0:09:40.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be...
Dialogue: 0,0:09:40.56,0:09:42.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berandalan?!
Dialogue: 0,0:09:44.52,0:09:45.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beli pernak-pernik.
Dialogue: 0,0:09:46.88,0:09:48.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gantungan kunci macaron.
Dialogue: 0,0:09:48.74,0:09:54.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Youkachan tingginya 193 cm,\Ntapi dia suka sekali hal-hal yang imut, lo.
Dialogue: 0,0:09:54.52,0:09:55.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Imutnya.
Dialogue: 0,0:09:58.08,0:10:00.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, ayo kita mulai patrolinya!
Dialogue: 0,0:10:01.05,0:10:05.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, sekolah di malam hari itu\Nmemang terasa menyeramkan, ya.
Dialogue: 0,0:10:05.05,0:10:07.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, ya. Kalau takut,\Nbiar aku saja yang patroli.
Dialogue: 0,0:10:07.83,0:10:08.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?!
Dialogue: 0,0:10:08.87,0:10:10.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?! Jangan-jangan Niorse takut, ya?!
Dialogue: 0,0:10:10.96,0:10:13.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku yang lebih muda saja\Ntidak takut sama sekali, tuh.
Dialogue: 0,0:10:13.29,0:10:17.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa boleh buat,\Ndaya imajinasiku lumayan tinggi.
Dialogue: 0,0:10:18.00,0:10:21.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duh, ya sudah, deh,\Nkamu bisa mengandalkanku!
Dialogue: 0,0:10:21.34,0:10:23.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan keimutanku,\Nsemua hantu akan tersucikan.
Dialogue: 0,0:10:23.77,0:10:25.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang bodoh hidupnya tenang, ya.
Dialogue: 0,0:10:25.74,0:10:29.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hmm, tara-ta-tan.
Dialogue: 0,0:10:33.63,0:10:35.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-A-Ada apa, Ketua?
Dialogue: 0,0:10:35.51,0:10:38.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Ah, maaf, tidak sengaja nabrak.
Dialogue: 0,0:10:39.40,0:10:41.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga mau diandalkan.
Dialogue: 0,0:10:41.67,0:10:44.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"SAMPAI DI LANTAI 2" Kita masuk makin jauh.
Dialogue: 0,0:10:44.13,0:10:46.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, ya, omong-omong...
Dialogue: 0,0:10:49.45,0:10:52.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekolah kita ini punya tujuh misteri, lo.\NSudah tahu?
Dialogue: 0,0:10:52.50,0:10:53.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agh.
Dialogue: 0,0:10:53.52,0:10:58.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gema suara korban yang melompat\Nbunuh diri di gedung barat.
Dialogue: 0,0:10:59.30,0:11:03.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si Tujuh Kaki yang mengelilingi\Ngedung SMA di malam hari.
Dialogue: 0,0:11:03.82,0:11:07.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mayat gantung yang menghantui kelas 2-1.
Dialogue: 0,0:11:07.72,0:11:12.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak tangga ke-13 terkutuk\Nyang muncul saat tengah malam.
Dialogue: 0,0:11:12.97,0:11:14.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu...
Dialogue: 0,0:11:15.27,0:11:17.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari kelas 2-4, Terui Arisu.
Dialogue: 0,0:11:17.73,0:11:19.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa cuma dia yang punya nama?
Dialogue: 0,0:11:20.09,0:11:22.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senior Terui memang tidak takut?
Dialogue: 0,0:11:22.95,0:11:25.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, bukan begitu.
Dialogue: 0,0:11:25.43,0:11:26.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang...?
Dialogue: 0,0:11:27.12,0:11:29.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru aku sangat penakut.
Dialogue: 0,0:11:29.82,0:11:33.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu kecil tidak bisa tidur\Ntanpa ditemani Papa.
Dialogue: 0,0:11:33.48,0:11:34.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, begitu, ya.
Dialogue: 0,0:11:34.32,0:11:38.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Papa? Papa?! Papa?!\NKamu manggilnya Papa?!
Dialogue: 0,0:11:38.46,0:11:42.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak yang manja sekali, ya.\NJangan-jangan sekarang pun masih dimandiin.
Dialogue: 0,0:11:43.11,0:11:44.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita pergi.
Dialogue: 0,0:11:44.34,0:11:46.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya ada yang dia takutkan?
Dialogue: 0,0:11:47.27,0:11:49.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah ini anak tangga\Nyang diceritakan Otori tadi?
Dialogue: 0,0:11:50.04,0:11:52.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak tangga ke-13 terkutuk, ya?
Dialogue: 0,0:11:53.05,0:11:55.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ume, aku takut!
Dialogue: 0,0:11:55.56,0:11:57.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, kelihatannya\Nsama sekali tidak takut, tuh.
Dialogue: 0,0:11:58.02,0:12:00.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang beneran takut sekarang itu aku...
Dialogue: 0,0:12:00.76,0:12:02.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Cuma tangga biasa, kok.\N- Aduh! Bahuku!
Dialogue: 0,0:12:02.92,0:12:04.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Hei, tenang saja, aman, kok.\N- Bahu?! Ada hantu?!
Dialogue: 0,0:12:04.82,0:12:07.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak! Lihat sendiri tangan kananmu!
Dialogue: 0,0:12:07.23,0:12:09.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuharap dia mau mengandalkanku.
Dialogue: 0,0:12:11.78,0:12:12.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fufu...
Dialogue: 0,0:12:12.87,0:12:18.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meninggalkanku yang imut ini...\NMereka harus dihukum...!
Dialogue: 0,0:12:19.34,0:12:23.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rencanaku begini!\NKugantung jaketku di pohon luar jendela!
Dialogue: 0,0:12:23.80,0:12:28.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat naik ke lantai 3, mereka pasti kaget\Ndan mengira itu mayat gantung!
Dialogue: 0,0:12:28.80,0:12:32.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu aku akan datang menolong mereka!\NMereka akan berterima kasih dan menyembahku!
Dialogue: 0,0:12:32.79,0:12:34.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari balas dendam jadi sok pamer.
Dialogue: 0,0:12:35.41,0:12:38.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Uh, jauhnya, sedikit lagi.
Dialogue: 0,0:12:39.39,0:12:39.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oi.
Dialogue: 0,0:12:39.90,0:12:40.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Uweh?
Dialogue: 0,0:12:48.28,0:12:49.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bigyaaaahh!
Dialogue: 0,0:12:50.72,0:12:52.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang barusan itu teriakan...?!
Dialogue: 0,0:12:54.25,0:12:56.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apaan, tuh?! Dari luar?!\NJangan-jangan korban yang lompat itu...
Dialogue: 0,0:13:01.41,0:13:02.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Auh...
Dialogue: 0,0:13:03.61,0:13:04.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senior Terui?!
Dialogue: 0,0:13:04.62,0:13:05.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu baik-baik saja?!
Dialogue: 0,0:13:05.90,0:13:08.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, bentar...\NKenapa tiba-tiba begini?!
Dialogue: 0,0:13:08.83,0:13:11.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan Senior beneran takut?!
Dialogue: 0,0:13:11.30,0:13:14.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kan sudah kubilang berulang kali...
Dialogue: 0,0:13:14.43,0:13:15.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu... di sana...
Dialogue: 0,0:13:17.53,0:13:19.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu...
Dialogue: 0,0:13:20.35,0:13:21.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mayat gantung!
Dialogue: 0,0:13:21.86,0:13:23.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, coba lihat, itu Tan.
Dialogue: 0,0:13:23.21,0:13:26.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketua, jangan lihat! Katanya kalau lihat\Nhal terkutuk, nanti bisa ikutan dikutuk!
Dialogue: 0,0:13:27.33,0:13:27.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah!
Dialogue: 0,0:13:27.99,0:13:30.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harapan Kotobuki akhirnya terwujud.
Dialogue: 0,0:13:34.45,0:13:35.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku.
Dialogue: 0,0:13:35.72,0:13:40.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah itu, Otori diselamatkan\Noleh si Tujuh Kaki alias Houjou.
Dialogue: 0,0:13:59.02,0:14:01.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah lama tidak ke sekolah.
Dialogue: 0,0:14:02.03,0:14:04.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi tidak sabar, uhuk.
Dialogue: 0,0:14:12.97,0:14:17.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Haa, capeknya. Pagi-pagi begini\Nsudah dipanggil Bu Guru.
Dialogue: 0,0:14:17.78,0:14:19.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah itu, buatkan cokelat untukku.
Dialogue: 0,0:14:19.09,0:14:21.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Katanya aku disuruh bantu menyiapkan kelas.\N- Yang itu tolong lakukan sendiri.
Dialogue: 0,0:14:21.87,0:14:24.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena sudah di sini,\Nsekalian kerjain tugas OSIS, deh.
Dialogue: 0,0:14:26.20,0:14:27.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm?
Dialogue: 0,0:14:28.35,0:14:30.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si Otori lupa mengunci pintunya lagi.
Dialogue: 0,0:14:39.31,0:14:40.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pembunuhan?!
Dialogue: 0,0:14:42.09,0:14:44.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, anu, kamu baik-baik saja?
Dialogue: 0,0:14:48.18,0:14:49.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Besar?
Dialogue: 0,0:14:51.95,0:14:52.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berat.
Dialogue: 0,0:14:53.18,0:14:55.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa dengan orang ini?\NTernyata bukan pembunuhan.
Dialogue: 0,0:14:56.63,0:14:57.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh?!
Dialogue: 0,0:14:57.41,0:14:59.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, tidak, ini...
Dialogue: 0,0:14:59.66,0:15:02.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm, tunggu sebentar.
Dialogue: 0,0:15:02.78,0:15:03.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suaranya serak.
Dialogue: 0,0:15:07.71,0:15:10.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rambut oke, sudah rapi.
Dialogue: 0,0:15:10.37,0:15:11.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu yang dirapikan?
Dialogue: 0,0:15:11.83,0:15:15.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, kamu berdarah, ada apa?\NLagi pula, kamu siapa?
Dialogue: 0,0:15:15.80,0:15:18.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, maaf, ini mimisan.
Dialogue: 0,0:15:19.93,0:15:21.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pas ditabrak mobil.
Dialogue: 0,0:15:22.09,0:15:22.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ditabrak?!
Dialogue: 0,0:15:23.43,0:15:26.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Urutan informasinya terbalik!\NLagi pula, infonya mengagetkan...!
Dialogue: 0,0:15:26.70,0:15:28.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terbalik? Ah, maaf.
Dialogue: 0,0:15:29.55,0:15:31.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Komaro.
Dialogue: 0,0:15:31.25,0:15:33.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan itu yang terbalik.
Dialogue: 0,0:15:35.51,0:15:37.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?! Kamu juga anggota OSIS?!
Dialogue: 0,0:15:39.09,0:15:40.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, bagian umum.
Dialogue: 0,0:15:42.74,0:15:46.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena terluka,\Naku izin tidak sekolah selama sebulan.
Dialogue: 0,0:15:46.73,0:15:49.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be-Begitu, ya. Nasibnya buruk, ya.
Dialogue: 0,0:15:50.43,0:15:53.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar sekarang aku punya junior di OSIS,\Nrasanya senang sekali.
Dialogue: 0,0:15:54.16,0:15:57.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana anaknya baik begini.\NMeski sedikit aneh.
Dialogue: 0,0:15:57.74,0:16:00.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, ya, aku harus segera bekerja.
Dialogue: 0,0:16:00.61,0:16:02.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerjaan bagian umum?\NKalau berdiri ternyata kecil!
Dialogue: 0,0:16:03.14,0:16:06.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, pekerjaannya banyak, lihatlah.
Dialogue: 0,0:16:10.50,0:16:12.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misalnya memungut yang seperti ini.
Dialogue: 0,0:16:12.43,0:16:14.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, hebat, ya.
Dialogue: 0,0:16:14.65,0:16:18.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayak kucing liar yang baru\Npertama kali dikasih makan.
Dialogue: 0,0:16:19.17,0:16:19.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:16:19.91,0:16:21.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, tidak.
Dialogue: 0,0:16:21.67,0:16:24.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma kepikiran, hebat juga kamu\Nbisa kerja keras padahal baru kecelakaan.
Dialogue: 0,0:16:25.37,0:16:26.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh.
Dialogue: 0,0:16:27.33,0:16:28.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, itu...
Dialogue: 0,0:16:29.52,0:16:31.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga ikut bantu, deh.
Dialogue: 0,0:16:33.80,0:16:34.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:16:35.08,0:16:36.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Ada apa?
Dialogue: 0,0:16:36.45,0:16:38.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Ume itu sekretaris, ya?
Dialogue: 0,0:16:38.36,0:16:39.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:16:40.10,0:16:44.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awalnya aku mau jadi sekretaris,\Ntapi katanya tidak bisa.
Dialogue: 0,0:16:44.92,0:16:49.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku mau lihat tugas sekretaris\Nseperti apa dari dekat, boleh tidak?
Dialogue: 0,0:16:49.38,0:16:52.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, tentu saja. Tiba-tiba jadi aktif.
Dialogue: 0,0:16:53.22,0:16:54.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:16:59.15,0:17:00.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:17:00.18,0:17:01.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tu-Tunggu...
Dialogue: 0,0:17:01.74,0:17:02.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo cepat.
Dialogue: 0,0:17:04.59,0:17:06.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ini "tanshi"?\N- Ya sudahlah.
Dialogue: 0,0:17:06.42,0:17:08.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, itu bacanya "tadashi".
Dialogue: 0,0:17:11.24,0:17:16.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini Michinoku, baru masuk lagi setelah izin.\NKalian yang ramah sama dia, ya.
Dialogue: 0,0:17:16.79,0:17:18.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata kita sekelas.
Dialogue: 0,0:17:18.73,0:17:20.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duduknya di belakang Mizunoe, ya.
Dialogue: 0,0:17:27.25,0:17:32.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm, jadi Koma dari bagian umum\Nsudah kembali, tapi kok...
Dialogue: 0,0:17:33.20,0:17:35.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak kapan kalian jadi seakrab itu?
Dialogue: 0,0:17:36.27,0:17:39.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, bukan, gara-gara kebetulan\Ntadi pagi, jadinya begini.
Dialogue: 0,0:17:39.61,0:17:40.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami jadi akrab.
Dialogue: 0,0:17:41.05,0:17:43.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang lihat saja jadi kesal.
Dialogue: 0,0:17:43.35,0:17:44.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:17:44.61,0:17:45.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enaknya.
Dialogue: 0,0:17:46.05,0:17:49.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, syukurlah Koma bisa kembali ke OSIS.
Dialogue: 0,0:17:49.64,0:17:52.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar. Kena aku, nih!
Dialogue: 0,0:17:53.10,0:17:57.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Koma di bagian umum. Tugasnya mirip,\Njadi akan sering kerja sama dengan Mizunoe.
Dialogue: 0,0:17:58.27,0:18:00.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, nanti kuajari yang kurang paham.
Dialogue: 0,0:18:00.05,0:18:02.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti tolong ajari Koma, ya, Mizunoe.
Dialogue: 0,0:18:02.87,0:18:03.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu.
Dialogue: 0,0:18:03.87,0:18:08.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, maaf, kalau di OSIS,\NKoma yang jadi senior, ya.
Dialogue: 0,0:18:08.63,0:18:10.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga dia diperlakukan seperti ini.
Dialogue: 0,0:18:11.18,0:18:13.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, kenapa Michinoku\Njadi bagian umum?
Dialogue: 0,0:18:14.10,0:18:15.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bilang mau jadi sekretaris?
Dialogue: 0,0:18:15.66,0:18:16.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau camilan?
Dialogue: 0,0:18:16.88,0:18:18.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, soal itu...
Dialogue: 0,0:18:20.27,0:18:24.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah! Dokumen ultra penting\Nyang susah payah kukerjakan!
Dialogue: 0,0:18:24.60,0:18:27.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, karena bagian umum tidak banyak\Nmemegang peran penting, sih.
Dialogue: 0,0:18:28.25,0:18:30.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya aku bisa paham.
Dialogue: 0,0:18:31.15,0:18:33.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat siang.\NKomachan sudah datang, ya?
Dialogue: 0,0:18:34.48,0:18:35.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, lo?
Dialogue: 0,0:18:35.85,0:18:37.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Se-Selamat siang.
Dialogue: 0,0:18:37.83,0:18:40.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berani sekali seperti ini di sekolah, ya?
Dialogue: 0,0:18:40.40,0:18:41.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan begitu.
Dialogue: 0,0:18:41.91,0:18:48.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, cuma salah paham, ya. Karena ini Koma,\Nkupikir mungkin saja terjadi. Maaf, ya.
Dialogue: 0,0:18:48.45,0:18:50.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti apa mereka memperlakukannya?
Dialogue: 0,0:18:50.79,0:18:55.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak ini kurang waspada,\Njadi sering terjebak bahaya.
Dialogue: 0,0:18:55.12,0:18:59.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti burung kakapo versi manusia,\Nyang hampir punah karena terlalu jinak.
Dialogue: 0,0:18:59.80,0:19:00.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakapo...?
Dialogue: 0,0:19:01.01,0:19:02.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau coba?
Dialogue: 0,0:19:02.56,0:19:03.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:19:03.66,0:19:04.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hup!
Dialogue: 0,0:19:05.91,0:19:09.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat, tidak ada reaksi sama sekali.\NJadi ingin melindunginya, 'kan?
Dialogue: 0,0:19:09.34,0:19:11.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, yang begitu cuma Senior.
Dialogue: 0,0:19:12.53,0:19:16.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duh, Komachan, kamu harus marah\Nkalau ada yang meremas dadamu begitu.
Dialogue: 0,0:19:16.90,0:19:18.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Situ pelakunya.
Dialogue: 0,0:19:18.15,0:19:19.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu...
Dialogue: 0,0:19:20.10,0:19:25.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak mau, harus tegas menolaknya,\Nsupaya tidak dijahati orang.
Dialogue: 0,0:19:25.36,0:19:30.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, tapi yang barusan aku tidak masalah,\Njadi boleh?
Dialogue: 0,0:19:31.41,0:19:32.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kyun!
Dialogue: 0,0:19:33.01,0:19:36.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat, dia imut sekali, sungguh polos.
Dialogue: 0,0:19:36.96,0:19:38.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia benar-benar diperlakukan\Nseperti peliharaan.
Dialogue: 0,0:19:39.26,0:19:44.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari tadi bilang dia imut terus,\Nmemangnya itu benar?!
Dialogue: 0,0:19:45.49,0:19:46.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya?
Dialogue: 0,0:19:46.48,0:19:51.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudku, antara dia yang kecil dan lugu\Ndengan aku yang pintar berprestasi,
Dialogue: 0,0:19:52.17,0:19:54.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa yang lebih imut?!
Dialogue: 0,0:19:54.73,0:19:56.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja Michinoku, 'kan...?
Dialogue: 0,0:19:56.42,0:19:59.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, secara objektif, sih, Komachan.
Dialogue: 0,0:19:59.26,0:20:00.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Haah?!
Dialogue: 0,0:20:00.84,0:20:03.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Maaf, ya, jadi ribut begini.\N- Cup, cup.
Dialogue: 0,0:20:03.64,0:20:05.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, ini kan sudah biasa.
Dialogue: 0,0:20:06.66,0:20:10.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, Koma sudah bertemu\NBu Hiratsuka?
Dialogue: 0,0:20:10.70,0:20:13.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah, katanya jadi tenang\Nsetelah melihatku kembali.
Dialogue: 0,0:20:13.41,0:20:13.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:20:14.63,0:20:18.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Michinoku akrab dengan Bu Hiratsuka?\NBukannya kamu baru masuk sini waktu SMA?
Dialogue: 0,0:20:19.28,0:20:21.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, kami bertemu saat SMP.
Dialogue: 0,0:20:22.32,0:20:26.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu Guru mengajakku ngobrol\Nwaktu aku menangkap serangga di taman.
Dialogue: 0,0:20:26.36,0:20:28.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wanita jomblo 29 tahun ini...
Dialogue: 0,0:20:29.44,0:20:33.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ume juga akrab dengan Bu Guru, 'kan?\NKadang-kadang Bu Guru cerita.
Dialogue: 0,0:20:33.94,0:20:35.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Benarkah?
Dialogue: 0,0:20:35.79,0:20:38.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya otakmu isinya cuma sastra,\Nuntuk sains payah sekali.
Dialogue: 0,0:20:38.43,0:20:39.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar...!
Dialogue: 0,0:20:39.82,0:20:42.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, tidak salah juga, sih, ugh.
Dialogue: 0,0:20:43.20,0:20:44.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perutmu sakit?
Dialogue: 0,0:20:45.70,0:20:47.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian semua akrab sekali.
Dialogue: 0,0:20:48.44,0:20:52.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, kalian berdua direkomendasikan\NBu Guru untuk ke OSIS, sih.
Dialogue: 0,0:20:52.94,0:20:54.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Michinoku juga?
Dialogue: 0,0:20:55.41,0:21:01.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, Bu Guru menitipkan murid-murid\Nyang punya sedikit masalah.
Dialogue: 0,0:21:01.72,0:21:02.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:21:03.44,0:21:06.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Koma tadinya sulit berkomunikasi\Ndengan orang lain,
Dialogue: 0,0:21:06.54,0:21:09.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi bisa cepat dekat denganmu.
Dialogue: 0,0:21:10.06,0:21:14.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin Bu Guru sudah memperkirakan\Nhal ini akan terjadi.
Dialogue: 0,0:21:14.63,0:21:15.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:21:15.91,0:21:19.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian seangkatan, 'kan?\NMalah sekelas.
Dialogue: 0,0:21:19.78,0:21:22.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau memikirkan kondisi Koma,\Nkalian pasangan yang cocok.
Dialogue: 0,0:21:23.28,0:21:24.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasangan?
Dialogue: 0,0:21:25.08,0:21:29.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutku pun, kalian saling melengkapi.
Dialogue: 0,0:21:29.27,0:21:31.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saking cocoknya, rasanya agak iri.
Dialogue: 0,0:21:31.98,0:21:33.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, itu...
Dialogue: 0,0:21:33.16,0:21:34.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, sungguh.
Dialogue: 0,0:21:34.84,0:21:36.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang.
Dialogue: 0,0:21:36.89,0:21:38.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari tadi kenapa wajahnya begitu?!
Dialogue: 0,0:21:39.17,0:21:43.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa menangis? Lagian, apa maksudnya\Nomongan soal pasangan itu?
Dialogue: 0,0:21:43.26,0:21:45.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, apa ini? Ingus?
Dialogue: 0,0:21:46.04,0:21:47.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya ingus keluar dari mata?!
Dialogue: 0,0:21:49.32,0:21:51.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Huwaaa!\N- Cup, cup.
Dialogue: 0,0:21:51.38,0:21:55.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pikir Ume mau diambil, ya?\NCuma salah paham, kok.
Dialogue: 0,0:21:56.46,0:21:59.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kotobuki, wanita yang sangat emosional.
Dialogue: 0,0:22:00.28,0:22:02.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku paling berterima kasih pada Ketua, kok.
Dialogue: 0,0:22:02.56,0:22:03.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?!
