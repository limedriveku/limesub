Dialogue: 0,0:17:30.74,0:17:32.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permintaan dan penawarannya seimbang, ya.
Dialogue: 0,0:17:33.00,0:17:34.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tapi apa ini aman buat sekolah?\N- Oke, cheese!
Dialogue: 0,0:17:36.21,0:17:36.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah.
Dialogue: 0,0:17:38.40,0:17:39.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu Hiratsuka.
Dialogue: 0,0:17:40.54,0:17:43.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih! Ah, satu penghangat, ya.
Dialogue: 0,0:17:43.93,0:17:45.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga, sih.
Dialogue: 0,0:17:46.71,0:17:49.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah! Itu Senior Houjou.
Dialogue: 0,0:17:50.93,0:17:52.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiga buah.
Dialogue: 0,0:17:52.56,0:17:53.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:17:53.65,0:17:54.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia payah.
Dialogue: 0,0:17:55.02,0:17:58.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tidak bisa menolak yang kecil dan imut.
Dialogue: 0,0:18:03.73,0:18:05.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suasana hatinya bagus, ya.
Dialogue: 0,0:18:05.93,0:18:07.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, itu!
Dialogue: 0,0:18:08.43,0:18:10.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Toko baju?
Dialogue: 0,0:18:13.50,0:18:14.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sarung tangan?
Dialogue: 0,0:18:14.42,0:18:16.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia serius banget memilihnya, ya.
Dialogue: 0,0:18:18.25,0:18:19.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke.
Dialogue: 0,0:18:19.71,0:18:20.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi.
Dialogue: 0,0:18:21.56,0:18:23.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sarung tangan ini, lima.
Dialogue: 0,0:18:23.66,0:18:26.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah! Terima kasih banyak, ya.
Dialogue: 0,0:18:26.59,0:18:27.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lima...
Dialogue: 0,0:18:28.11,0:18:30.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buat hadiah? Untuk keluarga?
Dialogue: 0,0:18:30.56,0:18:31.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm?
Dialogue: 0,0:18:33.18,0:18:35.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, kurang lebih begitu.
Dialogue: 0,0:18:37.61,0:18:39.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, yang ini mau dibungkus kado?
Dialogue: 0,0:18:39.62,0:18:41.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, boleh.
Dialogue: 0,0:18:41.71,0:18:42.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita pulang saja.
Dialogue: 0,0:18:43.01,0:18:43.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:18:47.12,0:18:49.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, aku dapat dari para penggemar,
Dialogue: 0,0:18:49.60,0:18:51.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}entah kenapa pas jumlahnya sesuai orang,
Dialogue: 0,0:18:51.60,0:18:53.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi kupikir pas banget, deh.
Dialogue: 0,0:18:53.18,0:18:54.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahannya bagus, ya.
Dialogue: 0,0:18:54.70,0:18:55.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:18:55.90,0:18:57.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, ya, Tan.
Dialogue: 0,0:19:01.05,0:19:02.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini buat Arisu.
Dialogue: 0,0:19:03.05,0:19:04.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:19:05.27,0:19:07.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah tahu pun, tetap bikin malu, ya.
Dialogue: 0,0:19:10.90,0:19:13.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sarung tangannya?
Dialogue: 0,0:19:13.37,0:19:17.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya ada bagian tubuh Arisu\Nyang kelihatan paling kedinginan.
Dialogue: 0,0:19:17.67,0:19:20.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Spesial! Pokoknya spesial.
Dialogue: 0,0:19:20.81,0:19:23.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana? Perhatian banget, 'kan?
Dialogue: 0,0:19:24.76,0:19:28.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sarung tangan untuk Terui\Nternyata sudah ada di dalam tas.
Dialogue: 0,0:19:29.08,0:19:31.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, sudah dipakai, ya.
Dialogue: 0,0:19:31.48,0:19:33.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, enak sekali.
Dialogue: 0,0:19:33.22,0:19:34.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:19:40.45,0:19:42.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini dingin sekali, ya.
Dialogue: 0,0:19:43.13,0:19:45.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}AC-nya juga belakangan rewel.
Dialogue: 0,0:19:46.24,0:19:46.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm?
Dialogue: 0,0:19:47.25,0:19:50.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, pantas saja dingin.
Dialogue: 0,0:19:54.69,0:19:56.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Musim dingin yang sunyi,
Dialogue: 0,0:19:56.44,0:19:58.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}duduk di atas batu,
Dialogue: 0,0:19:58.32,0:20:01.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku sendirian, ya.
Dialogue: 0,0:20:01.83,0:20:03.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu ngomong apa?
Dialogue: 0,0:20:04.53,0:20:05.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah datang?
Dialogue: 0,0:20:06.04,0:20:07.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dapat surat izin.
Dialogue: 0,0:20:07.92,0:20:11.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jualan onigiri boleh seminggu sekali,\Nberkat Ume.
Dialogue: 0,0:20:12.46,0:20:13.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah.
Dialogue: 0,0:20:13.70,0:20:14.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:20:15.17,0:20:17.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus, orang Tata Usaha itu baik, ya.
Dialogue: 0,0:20:17.90,0:20:19.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bantu macam-macam.
Dialogue: 0,0:20:19.40,0:20:20.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya beres juga.
Dialogue: 0,0:20:20.95,0:20:22.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, sepertinya begitu.
Dialogue: 0,0:20:23.58,0:20:25.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus, yang tadi itu apa?
Dialogue: 0,0:20:25.86,0:20:27.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Musim dingin kenapa?
Dialogue: 0,0:20:28.72,0:20:31.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu haiku karya Takahama Kyoshi.
Dialogue: 0,0:20:31.95,0:20:35.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, artinya dingin dan sepi.
Dialogue: 0,0:20:38.15,0:20:38.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm?
Dialogue: 0,0:20:39.69,0:20:40.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sini.
Dialogue: 0,0:20:43.11,0:20:44.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hangat?
Dialogue: 0,0:20:44.65,0:20:46.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, iya.
Dialogue: 0,0:20:46.02,0:20:47.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak kesepian?
Dialogue: 0,0:20:47.97,0:20:48.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:20:49.04,0:20:51.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belakangan kulit di pinggir kukuku\Nsering terkelupas.
Dialogue: 0,0:20:51.68,0:20:53.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makan sayur yang benar, dong.
Dialogue: 0,0:20:54.01,0:20:55.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus.
Dialogue: 0,0:20:55.81,0:20:57.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini dingin, ya.
Dialogue: 0,0:20:57.90,0:20:59.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Walah, walah.
Dialogue: 0,0:21:00.01,0:21:01.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus.
Dialogue: 0,0:21:01.82,0:21:03.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi aku bilang dingin, jadinya begini.
Dialogue: 0,0:21:03.94,0:21:05.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi menghangatkan.
Dialogue: 0,0:21:06.00,0:21:07.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:21:07.64,0:21:09.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku juga...
Dialogue: 0,0:21:12.32,0:21:15.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang hangat dan menyenangkan, ya.
Dialogue: 0,0:21:15.65,0:21:17.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu... Kok dekat?
Dialogue: 0,0:21:17.31,0:21:18.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa, goyang...?
Dialogue: 0,0:21:18.83,0:21:22.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seru, ya, oshikura manju.
Dialogue: 0,0:21:22.31,0:21:24.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari dulu aku ingin mencobanya.
Dialogue: 0,0:21:24.22,0:21:26.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak kusangka bisa di umur sebegini.
Dialogue: 0,0:21:26.23,0:21:28.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, bukan, ini...
Dialogue: 0,0:21:29.16,0:21:30.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:21:30.95,0:21:33.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tangan Ume dingin, ya.
Dialogue: 0,0:21:33.46,0:21:35.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, Michinoku yang hangat.
Dialogue: 0,0:21:36.03,0:21:39.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Walah, tanganku juga hangat, lo.
Dialogue: 0,0:21:39.06,0:21:40.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau coba?
Dialogue: 0,0:21:40.19,0:21:40.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:21:41.18,0:21:42.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, bagian itu...
Dialogue: 0,0:21:42.82,0:21:43.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Permisi.\N- Ayo, ayo...
Dialogue: 0,0:21:43.85,0:21:45.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, dingin!
Dialogue: 0,0:21:46.21,0:21:48.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, akhirnya!
Dialogue: 0,0:21:48.19,0:21:51.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oalah, kukira bakal dicekik.
Dialogue: 0,0:21:51.27,0:21:52.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, tidak sopan.
Dialogue: 0,0:21:52.76,0:21:54.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ikutan.
Dialogue: 0,0:21:54.99,0:21:56.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, ya, soal tangan,
Dialogue: 0,0:21:56.54,0:21:59.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}katanya orang yang tangannya dingin\Nhatinya hangat, lo.
Dialogue: 0,0:21:59.58,0:22:00.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mm!
Dialogue: 0,0:22:00.22,0:22:01.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi-lagi ngomong yang tidak perlu.
Dialogue: 0,0:22:02.38,0:22:05.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti orang yang tangannya hangat?
Dialogue: 0,0:22:05.53,0:22:07.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hatinya hangat.
Dialogue: 0,0:22:07.32,0:22:08.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teori kebaikan bawaan manusia.
Dialogue: 0,0:22:10.17,0:22:12.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saljunya makin deras, ya.
Dialogue: 0,0:22:12.44,0:22:14.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makin dingin.
Dialogue: 0,0:22:14.36,0:22:16.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, kita lakukan lagi?
Dialogue: 0,0:22:17.58,0:22:18.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:22:18.71,0:22:20.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya! Ada salju!
Dialogue: 0,0:22:20.84,0:22:21.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo keluar sebentar...
Dialogue: 0,0:22:23.46,0:22:25.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kalian semua lagi ngapain?
Dialogue: 0,0:22:25.64,0:22:28.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti yang terlihat, oshikura manju.
Dialogue: 0,0:22:28.27,0:22:29.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitulah.
Dialogue: 0,0:22:29.79,0:22:31.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Bagian mananya?
Dialogue: 0,0:22:31.91,0:22:34.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini dingin,\Njadi kami menghangatkan diri.
Dialogue: 0,0:22:34.92,0:22:37.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak ekskul olahraga\Nkan suka lari-lari di dalam ini.
Dialogue: 0,0:22:37.89,0:22:39.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bodoh, ya.
Dialogue: 0,0:22:39.40,0:22:40.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul.
Dialogue: 0,0:22:40.72,0:22:41.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meleset.
Dialogue: 0,0:22:42.32,0:22:43.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akrab sekali, ya.
Dialogue: 0,0:22:57.57,0:22:59.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketua tidak mau ikut juga?
Dialogue: 0,0:23:00.71,0:23:02.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be-Begitu, ya?
Dialogue: 0,0:23:03.17,0:23:06.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kalau begitu, permisi, ya.
Dialogue: 0,0:23:10.77,0:23:12.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hangat, ya.
Dialogue: 0,0:23:12.31,0:23:13.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, 'kan?
Dialogue: 0,0:23:13.42,0:23:14.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:23:22.52,0:23:24.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial, dingin banget.
Dialogue: 0,0:23:25.10,0:23:27.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saljunya menumpuk, ya.
Dialogue: 0,0:23:28.04,0:23:28.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasakan!
Dialogue: 0,0:23:28.85,0:23:29.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah!
Dialogue: 0,0:23:29.73,0:23:30.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awas, ya!
Dialogue: 0,0:23:31.32,0:23:32.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa, apa?
Dialogue: 0,0:23:32.80,0:23:33.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semangat sekali, ya.
Dialogue: 0,0:23:33.93,0:23:34.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
