Dialogue: 0,0:01:37.18,0:01:39.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyaman sekali.
Dialogue: 0,0:01:56.02,0:01:57.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berangkat.
Dialogue: 0,0:02:07.53,0:02:09.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, permisi.
Dialogue: 0,0:02:09.50,0:02:09.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm?
Dialogue: 0,0:02:10.22,0:02:12.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh minta sebatang?
Dialogue: 0,0:02:12.28,0:02:13.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya.
Dialogue: 0,0:02:13.56,0:02:15.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, cantik.
Dialogue: 0,0:02:15.68,0:02:17.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm?
Dialogue: 0,0:02:17.07,0:02:19.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, duh.
Dialogue: 0,0:02:19.65,0:02:21.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apinya juga boleh?
Dialogue: 0,0:02:21.50,0:02:22.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya.
Dialogue: 0,0:02:22.90,0:02:24.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cantik, sih, tapi...
Dialogue: 0,0:02:25.35,0:02:26.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi main gim, ya?
Dialogue: 0,0:02:26.92,0:02:28.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Ah, anu...
Dialogue: 0,0:02:28.61,0:02:30.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau jalan, lihat ke depan, ya.
Dialogue: 0,0:02:31.31,0:02:32.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belahan dadanya...
Dialogue: 0,0:02:35.22,0:02:36.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pagi.
Dialogue: 0,0:02:38.05,0:02:40.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat pagi, Bu Hiratsuka.
Dialogue: 0,0:02:40.82,0:02:42.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlambat lagi, ya.
Dialogue: 0,0:02:42.47,0:02:44.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, maaf.
Dialogue: 0,0:02:44.93,0:02:46.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini, ada apel pagi juga?
Dialogue: 0,0:02:46.67,0:02:48.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setiap hari ada.
Dialogue: 0,0:02:48.48,0:02:49.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, mejamu.
Dialogue: 0,0:02:50.62,0:02:52.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana mau jadi contoh untuk murid?
Dialogue: 0,0:02:52.76,0:02:54.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, ini.
Dialogue: 0,0:02:54.93,0:02:57.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini cukup efisien, lo.
Dialogue: 0,0:02:58.18,0:02:59.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berjatuhan.
Dialogue: 0,0:03:00.24,0:03:04.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu Guru, soal-soal ujian tahap dua\Nyang kemarin itu...
Dialogue: 0,0:03:04.10,0:03:06.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, iya, iya.
Dialogue: 0,0:03:06.33,0:03:08.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hasilnya bagus.
Dialogue: 0,0:03:08.60,0:03:10.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini contoh jawaban esai dan poin pentingnya.
Dialogue: 0,0:03:11.01,0:03:13.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, keren! Terima kasih.
Dialogue: 0,0:03:14.73,0:03:17.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau urusan murid,\NAnda tidak pernah telat, ya.
Dialogue: 0,0:03:17.06,0:03:18.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selalu begitu.
Dialogue: 0,0:03:18.33,0:03:20.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitulah.
Dialogue: 0,0:03:20.58,0:03:22.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, namanya juga guru.
Dialogue: 0,0:03:22.61,0:03:24.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:03:26.53,0:03:30.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berat. Kebanyakan soal esai, ya?
Dialogue: 0,0:03:30.42,0:03:32.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, habis ini...
Dialogue: 0,0:03:34.79,0:03:36.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedang apa?
Dialogue: 0,0:03:36.32,0:03:38.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana rapat gurunya?
Dialogue: 0,0:03:38.18,0:03:39.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyensor.
Dialogue: 0,0:03:42.00,0:03:45.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih atas kerja kerasnya\Ndi rapat, Bu Hiratsuka.
Dialogue: 0,0:03:45.41,0:03:47.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi telat karena ada kelas?
Dialogue: 0,0:03:47.32,0:03:48.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm.
Dialogue: 0,0:03:49.14,0:03:53.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, kalau boleh,\Nhabis ini mau makan bareng?
Dialogue: 0,0:03:53.04,0:03:54.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang traktir.
Dialogue: 0,0:03:54.49,0:03:57.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, tidak, hari ini...
Dialogue: 0,0:03:57.52,0:03:58.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:03:59.05,0:04:00.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm, tidak.
Dialogue: 0,0:04:01.40,0:04:03.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, deh. Makan.
Dialogue: 0,0:04:03.06,0:04:03.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:04:03.94,0:04:05.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya-Yakin?
Dialogue: 0,0:04:05.47,0:04:07.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gyudon, mau? Dibungkus.
Dialogue: 0,0:04:07.53,0:04:08.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo?
Dialogue: 0,0:04:11.34,0:04:13.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh.
Dialogue: 0,0:04:13.84,0:04:15.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak selesai-selesai.
Dialogue: 0,0:04:16.45,0:04:18.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, sudah mau jam 12 malam.
Dialogue: 0,0:04:18.98,0:04:21.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial, kelengahan.
Dialogue: 0,0:04:22.06,0:04:24.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minum kopi dulu, ah.
Dialogue: 0,0:04:25.72,0:04:27.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kedaluwarsa.
Dialogue: 0,0:04:28.03,0:04:29.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, biarlah.
Dialogue: 0,0:04:33.01,0:04:34.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malas banget.
Dialogue: 0,0:04:34.75,0:04:38.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nilai, sih, cukup lapor sendiri saja.
Dialogue: 0,0:04:38.65,0:04:40.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, Biologiku 5.
Dialogue: 0,0:04:40.34,0:04:42.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin, Bodoh.
Dialogue: 0,0:04:42.56,0:04:43.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm? Poin?
Dialogue: 0,0:04:44.31,0:04:45.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau poin, sih, iya juga.
Dialogue: 0,0:04:45.54,0:04:47.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau poin, jelas lebih dari itu, dong?
Dialogue: 0,0:04:50.83,0:04:53.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, hari ini yang ditunggu-tunggu.
Dialogue: 0,0:04:53.64,0:04:55.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kegiatan bersih-bersih!
Dialogue: 0,0:04:56.09,0:04:57.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, apa-apaan ini?
Dialogue: 0,0:04:58.98,0:05:00.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Turun sana!
Dialogue: 0,0:05:00.21,0:05:02.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apaan, sih? Tidak asyik.
Dialogue: 0,0:05:02.58,0:05:04.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si Botak minta tolong, nih.
Dialogue: 0,0:05:04.90,0:05:09.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membantu orang yang kesusahan\Njuga tugas OSIS, 'kan?
Dialogue: 0,0:05:09.23,0:05:10.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tumben ngomong begitu.
Dialogue: 0,0:05:12.11,0:05:13.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan...
Dialogue: 0,0:05:13.77,0:05:14.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:05:14.70,0:05:15.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sushi...
Dialogue: 0,0:05:16.20,0:05:18.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, yakiniku, ya?
Dialogue: 0,0:05:18.98,0:05:20.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, ketahuan?
Dialogue: 0,0:05:20.31,0:05:21.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar orang-orang dewasa payah.
Dialogue: 0,0:05:22.44,0:05:24.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya sudah.
Dialogue: 0,0:05:24.17,0:05:26.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian juga Ibu kasih hadiah.
Dialogue: 0,0:05:26.58,0:05:27.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya Ibu bangsawan?
Dialogue: 0,0:05:28.50,0:05:30.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau kasih apa?
Dialogue: 0,0:05:32.08,0:05:33.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Es krim Suika Bar, mungkin?
Dialogue: 0,0:05:33.24,0:05:36.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana ada anak SMA yang mempan disogok itu.
Dialogue: 0,0:05:36.53,0:05:38.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suika Bar...
Dialogue: 0,0:05:38.73,0:05:39.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata ada.
Dialogue: 0,0:05:40.06,0:05:41.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersih-bersih dimulai.
Dialogue: 0,0:05:42.15,0:05:44.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama, geser bangkunya.
Dialogue: 0,0:05:44.19,0:05:46.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mizunoe, pegang sebelah sana.
Dialogue: 0,0:05:46.24,0:05:47.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo? Bu Guru,
Dialogue: 0,0:05:47.61,0:05:49.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}omong-omong, jersey itu...
Dialogue: 0,0:05:49.72,0:05:52.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Punya Ibu waktu SMA.
Dialogue: 0,0:05:52.14,0:05:53.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih pantas, 'kan?
Dialogue: 0,0:05:54.93,0:05:56.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah tua masih cosplay?
Dialogue: 0,0:05:56.77,0:05:57.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hus!
Dialogue: 0,0:05:57.56,0:05:58.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:05:58.36,0:06:00.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu ini masih muda, tahu.
Dialogue: 0,0:06:01.89,0:06:03.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pinggangku encok...
Dialogue: 0,0:06:03.81,0:06:05.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hiratsuka gugur.
Dialogue: 0,0:06:05.62,0:06:07.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat, Penyihir Cowok Pengantar Paket!
Dialogue: 0,0:06:07.86,0:06:10.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski sempat ter-titit-puruk...
Dialogue: 0,0:06:10.52,0:06:12.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duh, padahal orangnya sudah berkurang.
Dialogue: 0,0:06:13.10,0:06:15.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa boleh buat.
Dialogue: 0,0:06:15.01,0:06:16.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanchan.
Dialogue: 0,0:06:16.30,0:06:18.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kantong buat daun keringnya...
Dialogue: 0,0:06:18.21,0:06:20.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Walah, ternyata belum dapat sama sekali, ya.
Dialogue: 0,0:06:23.81,0:06:24.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beres.
Dialogue: 0,0:06:25.04,0:06:26.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah biasa, ya.
Dialogue: 0,0:06:29.23,0:06:31.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagian ini sudah hampir selesai.
Dialogue: 0,0:06:32.05,0:06:33.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, berikutnya...
Dialogue: 0,0:06:33.91,0:06:36.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo? Arisu cuma sekantong?
Dialogue: 0,0:06:36.35,0:06:38.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku sudah dapat empat.
Dialogue: 0,0:06:41.34,0:06:42.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dua orang gugur.
Dialogue: 0,0:06:44.87,0:06:46.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suika Bar...
Dialogue: 0,0:06:46.56,0:06:48.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suika Bar...
Dialogue: 0,0:06:48.11,0:06:50.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Suika Bar...\N- Michinoku dari tadi berusaha keras, ya.
Dialogue: 0,0:06:50.80,0:06:52.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Suika Bar...\N- Tapi agak kikuk.
Dialogue: 0,0:06:52.60,0:06:54.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suika Bar...
Dialogue: 0,0:06:54.64,0:06:55.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suika Bar...
Dialogue: 0,0:06:55.76,0:06:57.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengki, biar aku saja.
Dialogue: 0,0:06:57.73,0:06:59.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke. Terima kasih.
Dialogue: 0,0:07:00.06,0:07:02.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hup, hup.
Dialogue: 0,0:07:03.55,0:07:05.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedikit lagi ke kanan.
Dialogue: 0,0:07:05.36,0:07:06.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke.
Dialogue: 0,0:07:07.04,0:07:08.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu.
Dialogue: 0,0:07:10.70,0:07:13.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bakal selesai sesuai jadwal, tidak?
Dialogue: 0,0:07:13.64,0:07:16.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya! Aku pinjam blower!
Dialogue: 0,0:07:16.56,0:07:18.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketua! Hebat!
Dialogue: 0,0:07:18.33,0:07:19.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh!
Dialogue: 0,0:07:19.30,0:07:21.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anginnya kencang sekali, ya!
Dialogue: 0,0:07:21.98,0:07:23.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita selesaikan sekaligus!
Dialogue: 0,0:07:25.53,0:07:26.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teringat.
Dialogue: 0,0:07:27.84,0:07:30.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sip, selesai!
Dialogue: 0,0:07:30.43,0:07:31.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus.
Dialogue: 0,0:07:31.80,0:07:34.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tinggal buang sampah, beres.
Dialogue: 0,0:07:34.28,0:07:35.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus.
Dialogue: 0,0:07:36.58,0:07:38.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih cepat dari dugaan.
Dialogue: 0,0:07:38.68,0:07:39.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pintar, pintar.
Dialogue: 0,0:07:39.86,0:07:41.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, Bu Guru.
Dialogue: 0,0:07:41.47,0:07:43.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya, ada dia.
Dialogue: 0,0:07:44.52,0:07:47.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melihat kalian semua tumbuh dewasa,\NIbu senang sekali.
Dialogue: 0,0:07:47.56,0:07:49.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu selalu begini, ya.
Dialogue: 0,0:07:50.42,0:07:53.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, kami buang sampah dulu.\NTunggu, ya.
Dialogue: 0,0:07:53.72,0:07:54.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:07:55.38,0:07:56.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tidak apa-apa, ya?
Dialogue: 0,0:07:56.89,0:07:57.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm?
Dialogue: 0,0:07:57.46,0:08:00.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ditinggal sendirian di sini\Npadahal tidak bisa bergerak.
Dialogue: 0,0:08:00.60,0:08:03.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga. Begitu-begitu dia cantik.
Dialogue: 0,0:08:03.91,0:08:06.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, gerbangnya sebentar lagi ditutup.
Dialogue: 0,0:08:08.29,0:08:09.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, Ume...
Dialogue: 0,0:08:10.48,0:08:12.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Botak.
Dialogue: 0,0:08:13.45,0:08:16.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, enak juga ditunggangi begini.
Dialogue: 0,0:08:16.18,0:08:17.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berat.
Dialogue: 0,0:08:17.76,0:08:20.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ja-Jangan sampai nempel begitu...
Dialogue: 0,0:08:20.87,0:08:21.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:08:22.38,0:08:24.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, Mizunoe,
Dialogue: 0,0:08:24.22,0:08:26.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berangkat!
Dialogue: 0,0:08:30.62,0:08:33.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu Guru, punggungku berat, nih.
Dialogue: 0,0:08:33.12,0:08:35.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Walah, cuma bagian itu yang gemukan, ya?
Dialogue: 0,0:08:35.58,0:08:37.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sengaja bilang "lepaskan", lo.
Dialogue: 0,0:08:38.36,0:08:41.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belakangan, Kotobuki juga digendong.
Dialogue: 0,0:08:41.39,0:08:44.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, Michinoku dapat dua batang Suika Bar.
Dialogue: 0,0:08:45.40,0:08:46.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:08:46.26,0:08:48.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik! Berikutnya aku!
Dialogue: 0,0:08:48.24,0:08:49.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, ya!
Dialogue: 0,0:08:49.67,0:08:51.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan keahlianku,
Dialogue: 0,0:08:51.68,0:08:53.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- cuma menempel poster gampang banget!\N- Hacih!
Dialogue: 0,0:08:53.62,0:08:54.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah...
Dialogue: 0,0:08:54.76,0:08:56.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo? Mizunoe, kamu masuk angin?
Dialogue: 0,0:08:56.75,0:09:00.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, cuma agak kurang enak badan.
Dialogue: 0,0:09:00.66,0:09:02.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, kepalaku.
Dialogue: 0,0:09:02.87,0:09:04.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebentar, boleh?
Dialogue: 0,0:09:08.33,0:09:10.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelenjar getah beningnya bengkak.
Dialogue: 0,0:09:10.41,0:09:12.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa jadi flu yang agak parah.
Dialogue: 0,0:09:12.70,0:09:13.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dokter?
Dialogue: 0,0:09:13.89,0:09:16.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Panasnya juga lumayan terasa.
Dialogue: 0,0:09:16.37,0:09:18.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama seperti saat adikku sakit.
Dialogue: 0,0:09:18.71,0:09:20.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu.
Dialogue: 0,0:09:20.59,0:09:23.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, ayo ke UKS bareng.
Dialogue: 0,0:09:23.35,0:09:24.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kasur?
Dialogue: 0,0:09:24.79,0:09:27.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kalau sampai sebegitunya...
Dialogue: 0,0:09:27.39,0:09:28.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Pekerjaannya juga masih...\N- Tidak boleh!
Dialogue: 0,0:09:29.22,0:09:31.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyakit itu harus ditangani sejak awal.
Dialogue: 0,0:09:31.20,0:09:32.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ikut aku.
Dialogue: 0,0:09:32.09,0:09:33.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:09:33.35,0:09:36.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Walah, Ketua jadi mode kakak.
Dialogue: 0,0:09:39.57,0:09:41.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo? Tidak ada orang.
Dialogue: 0,0:09:41.87,0:09:42.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:09:43.65,0:09:47.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Ada urusan mendadak, aku keluar sebentar.\NTunggulah, ya. Kozuka."
Dialogue: 0,0:09:47.97,0:09:50.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu Gurunya sepertinya tidak ada.
Dialogue: 0,0:09:50.47,0:09:51.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tunggu sebentar...
Dialogue: 0,0:09:51.75,0:09:52.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sip.
Dialogue: 0,0:09:52.71,0:09:53.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sini.
Dialogue: 0,0:09:54.12,0:09:55.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kasurnya sudah siap.
Dialogue: 0,0:09:55.73,0:09:57.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat sekali.
Dialogue: 0,0:09:58.21,0:09:59.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, dingin.
Dialogue: 0,0:09:59.60,0:10:01.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, beres.
Dialogue: 0,0:10:02.22,0:10:03.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:10:04.02,0:10:06.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti aku yang sampaikan ke Bu Guru.
Dialogue: 0,0:10:06.39,0:10:08.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pekerjaan tidak usah dipikirkan.\NTidur saja.
Dialogue: 0,0:10:08.77,0:10:09.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:10:09.61,0:10:11.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu, sih, biar aku...
Dialogue: 0,0:10:11.55,0:10:12.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak boleh.
Dialogue: 0,0:10:12.82,0:10:13.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:10:14.19,0:10:16.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku tidur saja.
Dialogue: 0,0:10:16.79,0:10:18.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:10:18.70,0:10:19.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, tidak.
Dialogue: 0,0:10:20.13,0:10:22.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kembali setelah memastikan\Nkamu benar-benar tidur.
Dialogue: 0,0:10:22.78,0:10:24.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:10:28.52,0:10:30.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Rasanya seperti punya kakak, ya?\N- Apa aku terlalu sok kakak, ya?
Dialogue: 0,0:10:31.00,0:10:33.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah tenang, dia jadi berpikir jernih.
Dialogue: 0,0:10:35.65,0:10:37.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sip, dia sudah tidur.
Dialogue: 0,0:10:39.19,0:10:41.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat tidur, Mizunoe.
Dialogue: 0,0:10:44.25,0:10:45.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm?
Dialogue: 0,0:10:48.30,0:10:48.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Ini
Dialogue: 0,0:10:48.89,0:10:50.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang disebut itu, 'kan?
Dialogue: 0,0:10:50.10,0:10:50.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti...
Dialogue: 0,0:10:50.42,0:10:51.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gara-gara aku?
Dialogue: 0,0:11:00.24,0:11:01.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Patah?
Dialogue: 0,0:11:07.33,0:11:09.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Bagaimana ini?
Dialogue: 0,0:11:09.18,0:11:11.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harus ditenangkan.
Dialogue: 0,0:11:13.09,0:11:15.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, lo? HP-ku tidak ada.
Dialogue: 0,0:11:15.61,0:11:17.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, jangan-jangan tadi...
Dialogue: 0,0:11:18.07,0:11:19.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oalah.
Dialogue: 0,0:11:19.73,0:11:21.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, kuambil...
Dialogue: 0,0:11:25.45,0:11:26.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuambil.
Dialogue: 0,0:11:29.14,0:11:31.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau masuk angin, pasti pakai supositoria.
Dialogue: 0,0:11:31.84,0:11:35.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mumpung ada kesempatan,\Nsekalian balas budi yang dulu.
Dialogue: 0,0:11:36.10,0:11:37.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi.
Dialogue: 0,0:11:39.44,0:11:41.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Ini, ya?
Dialogue: 0,0:11:42.54,0:11:43.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Posisinya...
Dialogue: 0,0:11:44.22,0:11:47.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu lagi legenda\NKotobuki si Mesum Diam-diam bertambah.
Dialogue: 0,0:11:47.65,0:11:48.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, keras.
Dialogue: 0,0:11:49.06,0:11:51.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sakit, sakit, sakit! Tolong!
Dialogue: 0,0:11:51.72,0:11:54.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Bagaimana ini, Bu Guru?\N- Maguro bakal mati!
Dialogue: 0,0:11:54.50,0:11:56.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan ribut!
Dialogue: 0,0:11:56.25,0:11:57.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma kram kaki!
Dialogue: 0,0:11:58.50,0:12:01.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin diperlakukan asal-asalan\Noleh Bu Kozuka.
Dialogue: 0,0:12:01.36,0:12:03.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu lagi?
Dialogue: 0,0:12:03.36,0:12:05.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ukur pakai dahi, dong.
Dialogue: 0,0:12:05.19,0:12:06.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini termometer.
Dialogue: 0,0:12:06.25,0:12:07.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Habis pakai, alkoholnya di situ.
