Dialogue: 0,0:05:02.44,0:05:02.73,sign,,0000,0000,0000,,KONTEN DISENSOR
Dialogue: 0,0:05:24.95,0:05:27.21,sign,,0000,0000,0000,,"PLONG"
Dialogue: 0,0:05:28.03,0:05:29.84,sign,,0000,0000,0000,,"KONTEN DISENSOR"
Dialogue: 0,0:05:40.02,0:05:42.78,sign,,0000,0000,0000,,KONTEN DISENSOR
Dialogue: 0,0:05:53.68,0:05:54.42,sign,,0000,0000,0000,,KINCIR SIKAT
Dialogue: 0,0:06:24.15,0:06:25.61,sign,,0000,0000,0000,,TEMUKAN AKU DI OSIS, OTORI TAN,\NMENGHADIRKAN MIMPI DAN CINTA
Dialogue: 0,0:06:28.82,0:06:30.78,sign,,0000,0000,0000,,BERHENTI
Dialogue: 0,0:06:47.78,0:06:50.43,sign,,0000,0000,0000,,KONTEN DISENSOR
Dialogue: 0,0:07:53.62,0:07:54.68,sign,,0000,0000,0000,,SUKA
Dialogue: 0,0:07:58.52,0:07:59.41,sign,,0000,0000,0000,,KESAL!
Dialogue: 0,0:09:04.87,0:09:05.30,sign,,0000,0000,0000,,SAKIT KEPALA, DEMAM, NYERI HAID
Dialogue: 0,0:09:34.40,0:09:37.88,sign,,0000,0000,0000,,KONTEN DISENSOR
Dialogue: 0,0:09:49.90,0:09:50.28,sign,,0000,0000,0000,,KONTEN DISENSOR
Dialogue: 0,0:09:57.47,0:09:58.61,sign,,0000,0000,0000,,GAGAL MENJADI MANUSIA -\NBOTCHAN - NAOMI KINKAKUJI.
Dialogue: 0,0:09:58.62,0:09:59.65,sign,,0000,0000,0000,,DI BALIK AYUNAN - PENGAKUAN SEBUAH TOPENG
Dialogue: 0,0:10:34.65,0:10:35.63,sign,,0000,0000,0000,,BREATH CURE
Dialogue: 0,0:10:38.36,0:10:40.82,sign,,0000,0000,0000,,BREATH CURE, PENYEGAR MULUT!\NKANDUNGAN MINT MAKSIMAL - 50 BUTIR
Dialogue: 0,0:10:43.16,0:10:44.41,sign,,0000,0000,0000,,KONTEN DISENSOR
Dialogue: 0,0:11:08.00,0:11:10.86,sign,,0000,0000,0000,,"MINGGU BERIKUTNYA"
Dialogue: 0,0:11:30.75,0:11:33.75,sign,,0000,0000,0000,,EPISODE 3\NSYUKURLAH
Dialogue: 0,0:11:33.75,0:11:36.79,sign,,0000,0000,0000,,RUANG OSIS
Dialogue: 0,0:11:48.16,0:11:48.58,sign,,0000,0000,0000,,TAK MASUK AKAL
Dialogue: 0,0:13:52.26,0:13:54.94,sign,,0000,0000,0000,,"BIOLOGI DASAR, KIMIA DASAR"
Dialogue: 0,0:14:19.12,0:14:19.50,sign,,0000,0000,0000,,KONTEN DISENSOR
Dialogue: 0,0:16:26.02,0:16:26.65,sign,,0000,0000,0000,,PENJASKES
Dialogue: 0,0:16:37.87,0:16:39.15,sign,,0000,0000,0000,,GUMAM
Dialogue: 0,0:16:55.45,0:16:56.30,sign,,0000,0000,0000,,HARI BERIKUTNYA
Dialogue: 0,0:17:23.54,0:17:24.06,sign,,0000,0000,0000,,KAKAK UME\NMIZUNOE SHOU
Dialogue: 0,0:22:04.24,0:22:04.97,sign,,0000,0000,0000,,SAMPAI JUMPA
Dialogue: 0,0:23:34.97,0:23:35.93,sign,,0000,0000,0000,,CUPLIKAN EPISODE BERIKUTNYA
Dialogue: 0,0:23:35.97,0:23:36.92,sign,,0000,0000,0000,,BERDUAAN DI GUDANG!\NRAHASIA SENIOR TERUI
Dialogue: 0,0:23:36.92,0:23:37.87,sign,,0000,0000,0000,,KOMARO DAN KOTAK SARAN KOUKICHAN\NDAN EKSKUL MUSIK MODERN
Dialogue: 0,0:23:37.87,0:23:39.93,sign,,0000,0000,0000,,NANTIKAN EPISODE BERIKUTNYA, YA!
Dialogue: 0,0:00:01.91,0:00:04.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, ini hari yang kita nantikan.
Dialogue: 0,0:00:04.62,0:00:06.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari bersih-bersih kolam renang!
Dialogue: 0,0:00:06.34,0:00:07.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:00:08.58,0:00:11.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini, Jepang cerah tanpa awan!\NBagus sekali!
Dialogue: 0,0:00:11.62,0:00:14.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar! Jepang tanpa awan!
Dialogue: 0,0:00:16.27,0:00:18.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketua semangat sekali, ya.
Dialogue: 0,0:00:18.10,0:00:21.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia memang orangnya suka bergerak, sih.
Dialogue: 0,0:00:21.36,0:00:23.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mantan anggota Ekskul Atletik.
Dialogue: 0,0:00:23.14,0:00:25.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Omong-omong, Otori mana?
Dialogue: 0,0:00:25.61,0:00:26.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh?
Dialogue: 0,0:02:04.37,0:02:08.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yo! Kamu Ume, ya?\NTerima kasih sudah datang membantu!
Dialogue: 0,0:02:08.16,0:02:10.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, ya, kamu yang dari Ekskul Renang...
Dialogue: 0,0:02:10.66,0:02:11.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:02:11.08,0:02:12.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari Ekskul Renang!
Dialogue: 0,0:02:13.00,0:02:14.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa diulang?
Dialogue: 0,0:02:14.24,0:02:19.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelas 3, Honma Kuroe!\NJulukanku "Tuna Fujinasu"!
Dialogue: 0,0:02:19.66,0:02:22.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Panggil saja aku Tunachan!
Dialogue: 0,0:02:22.22,0:02:24.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Itu, sih...
Dialogue: 0,0:02:24.29,0:02:25.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang terbuka sekali, ya.
Dialogue: 0,0:02:25.76,0:02:27.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, daya tarikku adalah...
Dialogue: 0,0:02:27.25,0:02:28.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Otot betis pipihku ini!
Dialogue: 0,0:02:28.87,0:02:30.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Julukannya tuna,\Ntapi andalannya malah ikan sebelah!
Dialogue: 0,0:02:30.93,0:02:32.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ototnya kencang sekali, 'kan?
Dialogue: 0,0:02:32.48,0:02:35.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu! Hentikan, hentikan!\NTerlalu terbuka!
Dialogue: 0,0:02:37.78,0:02:40.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sip, langsung masuk saja.
Dialogue: 0,0:02:40.20,0:02:42.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hati-hati, ya, agak licin.
Dialogue: 0,0:02:43.61,0:02:45.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar licin.
Dialogue: 0,0:02:46.38,0:02:47.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:02:47.90,0:02:50.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Licin begini rasanya enak.
Dialogue: 0,0:02:52.43,0:02:53.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ume?
Dialogue: 0,0:02:53.45,0:02:56.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap! Akan kusikat lantainya!
Dialogue: 0,0:02:58.26,0:03:01.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm? Ada apa, Michinoku?\NKenapa gemetar begitu?
Dialogue: 0,0:03:01.54,0:03:02.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedang berusaha.
Dialogue: 0,0:03:03.11,0:03:04.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berusaha apa?
Dialogue: 0,0:03:04.32,0:03:07.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bergerak sedikit saja...
Dialogue: 0,0:03:12.98,0:03:14.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi begini.
Dialogue: 0,0:03:14.27,0:03:16.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keseimbangan tubuhnya jelek sekali.
Dialogue: 0,0:03:20.39,0:03:23.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senior Terui, sedang apa?
Dialogue: 0,0:03:23.31,0:03:27.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedang mengumpulkan anak capung,\Nmasih nimfa.
Dialogue: 0,0:03:27.55,0:03:28.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:03:28.40,0:03:31.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dibiarkan,\Nmereka akan terseret arus air dan mati.
Dialogue: 0,0:03:31.80,0:03:34.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kasihan, 'kan?
Dialogue: 0,0:03:34.36,0:03:35.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senior...
Dialogue: 0,0:03:35.90,0:03:39.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik sekali. Mau dipelihara di rumah?
Dialogue: 0,0:03:39.40,0:03:42.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, tidak, mau dijadikan\Nmakanan ikan peliharaanku.
Dialogue: 0,0:03:43.08,0:03:45.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daripada mati sia-sia, 'kan?
Dialogue: 0,0:03:45.60,0:03:48.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi yang dikasihani cuma cara matinya.
Dialogue: 0,0:03:51.57,0:03:53.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kotorannya tidak mau lepas!
Dialogue: 0,0:03:53.90,0:03:55.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, ada sabun di sini.
Dialogue: 0,0:03:55.92,0:03:57.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serius?! Baguslah!
Dialogue: 0,0:03:57.89,0:03:58.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:03:58.93,0:04:00.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, tolong tuang di sebelah sana!
Dialogue: 0,0:04:00.66,0:04:01.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke.
Dialogue: 0,0:04:07.48,0:04:08.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga arwahnya tenang.
Dialogue: 0,0:04:09.18,0:04:10.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nimfa musnah.
Dialogue: 0,0:04:11.50,0:04:14.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fiuh. Lumayan capek juga.
Dialogue: 0,0:04:17.42,0:04:18.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus!
Dialogue: 0,0:04:19.19,0:04:22.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semangat, ya, kerjanya!\NKerja bagus semuanya!
Dialogue: 0,0:04:22.83,0:04:24.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi-lagi datang telat kayak bos.
Dialogue: 0,0:04:25.22,0:04:28.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Niorse, sikat lantai itu\Ncocok sekali denganmu.
Dialogue: 0,0:04:28.45,0:04:30.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Kamu tidak pakai baju renang cewek?
Dialogue: 0,0:04:30.68,0:04:32.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak! Sudah jelas, 'kan?!
Dialogue: 0,0:04:32.22,0:04:35.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, aku sama sekali\Ntidak hobi pakai baju cewek!
Dialogue: 0,0:04:35.96,0:04:36.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa?
Dialogue: 0,0:04:36.78,0:04:39.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah! Kamu yang di foto baju renang itu!
Dialogue: 0,0:04:39.68,0:04:41.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Tidak pakai baju renang cewek?
Dialogue: 0,0:04:41.84,0:04:42.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:04:42.96,0:04:43.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:04:44.16,0:04:45.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang,
Dialogue: 0,0:04:45.75,0:04:48.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}waktu itu dipaksa pakai oleh Arisu!
Dialogue: 0,0:04:48.02,0:04:49.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, itu bukan baju renangku!
Dialogue: 0,0:04:49.47,0:04:51.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu? Maaf, maaf.
Dialogue: 0,0:04:52.04,0:04:55.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, kupinjamkan, nih!\NAnggaran ekskul kita terbatas soalnya.
Dialogue: 0,0:04:55.08,0:04:56.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan begitu!
Dialogue: 0,0:04:57.53,0:04:59.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duh, capeknya.
Dialogue: 0,0:04:59.88,0:05:02.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tinggal bilas sekali lagi, lalu selesai.
Dialogue: 0,0:05:02.74,0:05:05.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, kalau begitu biar kuputar kerannya!
Dialogue: 0,0:05:05.50,0:05:08.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar, ambil pekerjaan paling mudah!
Dialogue: 0,0:05:08.16,0:05:11.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, kami yang sikat.\NTolong pegang selangnya, ya.
Dialogue: 0,0:05:11.17,0:05:11.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke.
Dialogue: 0,0:05:12.41,0:05:14.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm? Eh? Keran?
Dialogue: 0,0:05:14.74,0:05:16.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya aku melupakan sesuatu.
Dialogue: 0,0:05:17.06,0:05:18.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dah.
Dialogue: 0,0:05:21.04,0:05:22.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?!
Dialogue: 0,0:05:24.95,0:05:27.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, ya! Pipanya rusak!
Dialogue: 0,0:05:27.41,0:05:27.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oi!
Dialogue: 0,0:05:28.03,0:05:29.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tekanan airnya terlalu besar!
Dialogue: 0,0:05:29.95,0:05:31.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Otori! Matikan airnya.
Dialogue: 0,0:05:31.40,0:05:34.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial! Malah dengar musik\Nseakan kerjaannya sudah beres!
Dialogue: 0,0:05:37.38,0:05:38.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si-Sip!
Dialogue: 0,0:05:38.72,0:05:40.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa pun, tolong matikan airnya!
Dialogue: 0,0:05:43.00,0:05:44.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, anu, tunggu.
Dialogue: 0,0:05:45.44,0:05:47.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Mizunoe! Kumatikan sekarang.
Dialogue: 0,0:05:47.77,0:05:50.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak! Biar aku saja! Maaf!
Dialogue: 0,0:05:50.59,0:05:53.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Apa? Malah main air?
Dialogue: 0,0:05:54.43,0:05:57.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hukuman untuk Tan hari ini:\NSiksaan Kincir Sikat..
Dialogue: 0,0:05:57.31,0:05:59.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan ini, anggaran ekskul bertambah lagi!
Dialogue: 0,0:06:04.26,0:06:08.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin kita sedikit kelewatan.\NTanchan sepertinya kena flu.
Dialogue: 0,0:06:08.64,0:06:10.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal katanya orang bodoh\Ntidak bisa kena flu,
Dialogue: 0,0:06:10.56,0:06:12.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi si sampah itu bisa, ya.
Dialogue: 0,0:06:12.78,0:06:17.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biasanya, sih, aku yang ke sana,\Ntapi sekarang ada Ume yang sesama cowok.
Dialogue: 0,0:06:17.92,0:06:20.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisakah kamu menjenguknya?
Dialogue: 0,0:06:20.83,0:06:21.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:06:21.35,0:06:24.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, Ume sendiri mau lihat, 'kan?
Dialogue: 0,0:06:25.62,0:06:26.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apanya?
Dialogue: 0,0:06:31.79,0:06:34.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, ini rumahnya Otori?
Dialogue: 0,0:06:35.33,0:06:38.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak terbayang\Nbagaimana dia bisa lemah dan sakit.
Dialogue: 0,0:06:40.61,0:06:41.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sip.
Dialogue: 0,0:06:46.69,0:06:47.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:06:50.46,0:06:52.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa, ya?
Dialogue: 0,0:06:53.48,0:06:54.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Y-Yo.
Dialogue: 0,0:06:55.21,0:06:56.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Niorse?
Dialogue: 0,0:06:57.05,0:06:57.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, ya.
Dialogue: 0,0:06:58.54,0:07:02.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar kamu sakit,\Nini kubawakan berkas OSIS.
Dialogue: 0,0:07:02.08,0:07:03.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan...
Dialogue: 0,0:07:03.62,0:07:07.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Ohok-ohok" suka "ohok-ohok", ya?!
Dialogue: 0,0:07:07.56,0:07:09.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duh, apa "ohok-ohok" boleh "ohok-ohok"\Nbuat "ohok"?
Dialogue: 0,0:07:09.26,0:07:11.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah sekarat pun masih menyebalkan, ya.
Dialogue: 0,0:07:11.96,0:07:13.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan memaksakan diri.
Dialogue: 0,0:07:13.56,0:07:14.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ohok-ohok.
Dialogue: 0,0:07:14.92,0:07:18.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, sial, flu ini menyebalkan.
Dialogue: 0,0:07:18.51,0:07:20.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau saja bisa dilihat, pasti akan kuhajar.
Dialogue: 0,0:07:21.05,0:07:22.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenanglah.
Dialogue: 0,0:07:22.95,0:07:25.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nih, bubur. Tadi kubuat di rumah.
Dialogue: 0,0:07:25.22,0:07:25.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:07:26.04,0:07:28.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski flu, harus tetap makan, ya.
Dialogue: 0,0:07:29.35,0:07:30.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Niorse.
Dialogue: 0,0:07:31.62,0:07:33.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pakai daun bawang, tidak?
Dialogue: 0,0:07:33.31,0:07:36.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lidahku yang sensitif ini\Ntidak bisa makan yang pahit.
Dialogue: 0,0:07:37.93,0:07:39.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Panas!
Dialogue: 0,0:07:42.70,0:07:45.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari luar, dia kelihatan cukup sehat, 'kan?
Dialogue: 0,0:07:45.92,0:07:47.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Senior.
Dialogue: 0,0:07:47.87,0:07:49.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm? Apa?
Dialogue: 0,0:07:49.73,0:07:50.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu...
Dialogue: 0,0:07:51.15,0:07:53.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Ada apa? Sesak napas?
Dialogue: 0,0:07:54.70,0:07:55.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:07:55.54,0:07:57.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kutularkan flunya, ya.
Dialogue: 0,0:07:59.46,0:08:02.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apaan, nih?\NAku orang sakit, lo!
Dialogue: 0,0:08:02.52,0:08:03.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Supaya bisa tidur tenang.
Dialogue: 0,0:08:04.27,0:08:06.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa gerak!
Dialogue: 0,0:08:06.88,0:08:09.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, pantatku gatal! Niorse!
Dialogue: 0,0:08:09.66,0:08:12.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kelihatan sudah sehat,\Npulang saja, deh.
Dialogue: 0,0:08:13.57,0:08:14.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:08:15.86,0:08:18.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan kamu tinggal sendirian?
Dialogue: 0,0:08:19.07,0:08:20.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul.
Dialogue: 0,0:08:20.97,0:08:23.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya orang tuaku tidak ada.
Dialogue: 0,0:08:23.86,0:08:25.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke-Kenapa?
Dialogue: 0,0:08:25.66,0:08:28.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm, yah, karena satu dan lain hal?
Dialogue: 0,0:08:29.52,0:08:32.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak aku bisa mengingat,\NAyah sudah tidak ada,
Dialogue: 0,0:08:32.02,0:08:34.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu juga tidak pernah pulang.
Dialogue: 0,0:08:34.79,0:08:35.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu...
Dialogue: 0,0:08:37.11,0:08:38.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berterima kasih sudah datang hari ini.
Dialogue: 0,0:08:41.09,0:08:42.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bercanda!
Dialogue: 0,0:08:42.53,0:08:43.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, aku kan hebat.
Dialogue: 0,0:08:43.89,0:08:46.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sendirian pun, flunya bakal cepat sembuh\Ndengan semangatku.
Dialogue: 0,0:08:46.51,0:08:47.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Otori.
Dialogue: 0,0:08:48.59,0:08:51.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah ke dokter, belum?
Dialogue: 0,0:08:51.52,0:08:52.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Belum.
Dialogue: 0,0:08:52.64,0:08:53.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga.
Dialogue: 0,0:08:54.15,0:08:55.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harus berobat dengan benar, lo!
Dialogue: 0,0:08:56.13,0:08:58.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Obatnya? Pasti belum diminum, 'kan?
Dialogue: 0,0:08:58.63,0:09:00.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, itu, di lemari sana.
Dialogue: 0,0:09:01.62,0:09:02.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ta-Tapi...
Dialogue: 0,0:09:02.40,0:09:04.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini, ya?\NOtori, aku pasti akan...
Dialogue: 0,0:09:05.34,0:09:06.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memastikan kamu sembuh.
Dialogue: 0,0:09:07.36,0:09:09.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu supositoria.
Dialogue: 0,0:09:10.78,0:09:11.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Otori.
Dialogue: 0,0:09:11.92,0:09:12.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:09:12.49,0:09:13.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buka celanamu.
Dialogue: 0,0:09:13.35,0:09:14.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?! Tunggu, jangan-jangan...
Dialogue: 0,0:09:15.01,0:09:17.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mau, aku bisa sendiri!
Dialogue: 0,0:09:17.08,0:09:17.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak boleh.
Dialogue: 0,0:09:18.17,0:09:20.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pasti cuma pura-pura memakainya.
Dialogue: 0,0:09:21.54,0:09:22.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar aku saja.
Dialogue: 0,0:09:23.96,0:09:25.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:09:27.11,0:09:28.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku malu.
Dialogue: 0,0:09:30.32,0:09:32.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini tidak memalukan!
Dialogue: 0,0:09:32.32,0:09:34.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meyakinkan diri dengan suara keras.
Dialogue: 0,0:09:37.94,0:09:40.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baiklah, kumulai, ya.
Dialogue: 0,0:09:41.09,0:09:42.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:09:49.16,0:09:49.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sakit.
Dialogue: 0,0:09:50.31,0:09:51.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah! Maaf.
Dialogue: 0,0:09:52.40,0:09:53.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.
Dialogue: 0,0:09:55.55,0:09:57.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di situ.
Dialogue: 0,0:09:59.69,0:10:02.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pikiran Mizunoe dipenuhi judul novel.
Dialogue: 0,0:10:04.90,0:10:05.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah.
Dialogue: 0,0:10:07.08,0:10:11.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Capeknya! Kukira jantungku bakal meledak!
Dialogue: 0,0:10:11.40,0:10:12.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selesai dimasukkan.
Dialogue: 0,0:10:13.44,0:10:16.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, tapi syukurlah Otori sepertinya\Nbisa istirahat dengan tenang.
Dialogue: 0,0:10:19.27,0:10:20.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ume.
Dialogue: 0,0:10:26.19,0:10:27.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, pulang, ah.
Dialogue: 0,0:10:27.84,0:10:29.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Obatnya kutaruh di sini.
Dialogue: 0,0:10:30.14,0:10:30.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm?
Dialogue: 0,0:10:31.17,0:10:33.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Obatnya di lantai?
Dialogue: 0,0:10:33.96,0:10:34.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:10:35.66,0:10:38.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus yang kupegang ini apa?
Dialogue: 0,0:10:42.23,0:10:43.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm?
Dialogue: 0,0:10:44.43,0:10:47.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pantatku... rasanya hangat.
Dialogue: 0,0:10:47.61,0:10:48.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Otori.
Dialogue: 0,0:10:48.86,0:10:49.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm?
Dialogue: 0,0:10:49.80,0:10:50.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perlihatkan pantatmu.
Dialogue: 0,0:10:51.07,0:10:52.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Heh?!
Dialogue: 0,0:10:52.62,0:10:54.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apaan? Ume?
Dialogue: 0,0:10:54.70,0:10:57.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, pa-panas! Pantatku panas!
Dialogue: 0,0:10:58.08,0:10:59.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Panas! Pantat panas!
Dialogue: 0,0:11:00.15,0:11:03.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, itu salahku!\NMakanya cepat perlihatkan!
Dialogue: 0,0:11:03.12,0:11:04.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?!
Dialogue: 0,0:11:05.09,0:11:07.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari berikutnya, Mizunoe juga tertular flu.
Dialogue: 0,0:11:08.00,0:11:10.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Y-Yo, kamu baik-baik saja?
Dialogue: 0,0:11:10.93,0:11:13.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?! Ah, ya!
Dialogue: 0,0:11:13.81,0:11:14.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm?
Dialogue: 0,0:11:36.83,0:11:37.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guk!
Dialogue: 0,0:11:39.79,0:11:42.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, Mizunoe?\NTiba-tiba muram begitu.
Dialogue: 0,0:11:42.98,0:11:46.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, tidak. Entah kenapa\Nsepertinya akan dilakukan lagi.
Dialogue: 0,0:11:46.85,0:11:48.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujian berkala.
Dialogue: 0,0:11:48.72,0:11:51.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, apanya yang kenapa?\NSudah jelas, 'kan, dari namanya?
Dialogue: 0,0:11:51.70,0:11:55.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak salah,\NMizunoe kesulitan di pelajaran Sains, ya?
Dialogue: 0,0:11:55.81,0:11:57.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:11:57.27,0:11:59.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekeras apa pun dicoba,\Nrasanya seperti menggarami lautan...
Dialogue: 0,0:11:59.82,0:12:04.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, bagai air di daun talas...\NAh, lebih mirip main musik di depan kerbau.
Dialogue: 0,0:12:04.32,0:12:06.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu berusaha\Nmencari analoginya begitu.
Dialogue: 0,0:12:06.62,0:12:08.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal kamu pintar berkata-kata.
Dialogue: 0,0:12:09.30,0:12:11.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, seperti apa nilaimu di pelajaran Sains?
Dialogue: 0,0:12:12.11,0:12:18.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm... Mata pelajaran sains itu...\NAda apa saja, ya?
Dialogue: 0,0:12:18.33,0:12:21.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Matematika? Kimia?
Dialogue: 0,0:12:21.31,0:12:22.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu saja tidak ingat?
Dialogue: 0,0:12:22.81,0:12:26.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf. Mungkin lebih tepatnya\Naku benci itu semua.
Dialogue: 0,0:12:26.81,0:12:29.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berapa kali pun diulang,\Ntidak bisa masuk ke kepala.
Dialogue: 0,0:12:29.51,0:12:30.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:12:31.39,0:12:32.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, apa boleh buat!
Dialogue: 0,0:12:33.21,0:12:33.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:12:34.42,0:12:35.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Materi ujiannya sampai mana?
Dialogue: 0,0:12:36.42,0:12:39.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cukup suka pelajaran Sains.
Dialogue: 0,0:12:39.28,0:12:42.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau belajar bersama,\Nmungkin kebencianmu bisa sedikit berkurang.
Dialogue: 0,0:12:42.24,0:12:43.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketua!
Dialogue: 0,0:12:44.47,0:12:48.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, bagaimana nilai Ketua?\NKalau boleh tahu.
Dialogue: 0,0:12:49.57,0:12:50.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah...
Dialogue: 0,0:12:51.03,0:12:55.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah... Entah bagaimana\Naku dapat peringkat satu.
Dialogue: 0,0:12:56.25,0:12:57.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serius?
Dialogue: 0,0:12:57.42,0:13:00.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, tiap pelajaran\Ncuma masuk lima besar, sih.
Dialogue: 0,0:13:00.08,0:13:01.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa semua, tapi tak ada yang ahli.
Dialogue: 0,0:13:01.82,0:13:04.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetap saja hebat!
Dialogue: 0,0:13:04.26,0:13:06.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal sambil mengerjakan tugas OSIS.
Dialogue: 0,0:13:06.56,0:13:09.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketua memang hebat, tapi me...
Dialogue: 0,0:13:10.93,0:13:13.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kotobuki tak disangka dapat poin bonus.
Dialogue: 0,0:13:13.65,0:13:15.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, ayo segera kita mulai.
Dialogue: 0,0:13:15.38,0:13:16.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:13:17.11,0:13:19.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh? Mau belajar?
Dialogue: 0,0:13:19.53,0:13:21.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami juga bisa bantu.
Dialogue: 0,0:13:21.85,0:13:24.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Apa? Ume sepertinya kesulitan?
Dialogue: 0,0:13:24.79,0:13:26.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengganggunya datang.
Dialogue: 0,0:13:26.87,0:13:29.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena sebentar lagi ujian berkala,
Dialogue: 0,0:13:29.11,0:13:32.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku khawatir kamu bisa lulus\Npelajaran Sains atau tidak.
Dialogue: 0,0:13:32.80,0:13:35.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah. Sudah tahu, ya? Jadi malu.
Dialogue: 0,0:13:35.85,0:13:40.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujian sebelumnya, Kimia 13,\NMatematika 4, Biologi 18.
Dialogue: 0,0:13:40.70,0:13:41.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pfft.
Dialogue: 0,0:13:41.65,0:13:44.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kali ini, ayo berusaha\Nsupaya tidak dapat nilai merah.
Dialogue: 0,0:13:45.02,0:13:46.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok bisa tahu sedetail itu?
Dialogue: 0,0:13:46.93,0:13:50.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, aku akan membantu\Ndi Biologi dan Kimia.
Dialogue: 0,0:13:50.32,0:13:52.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, begitu, ya.
Dialogue: 0,0:13:52.26,0:13:54.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini-begini, aku lumayan ahli, lo.
Dialogue: 0,0:13:54.94,0:13:57.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan pernah dapat penghargaan di IBO.
Dialogue: 0,0:13:58.05,0:13:59.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, monster.
Dialogue: 0,0:13:59.80,0:14:04.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}IBO adalah Olimpiade biologi internasional\Nuntuk siswa SMA.
Dialogue: 0,0:14:04.99,0:14:07.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, tapi memang sesuai\Ndengan citra Senior, sih?
Dialogue: 0,0:14:08.69,0:14:10.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesuai citra?
Dialogue: 0,0:14:10.12,0:14:10.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah!
Dialogue: 0,0:14:11.85,0:14:15.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.\NSebenarnya aku memang suka makhluk hidup.
Dialogue: 0,0:14:15.86,0:14:19.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, ah, ya! Syukurlah.
Dialogue: 0,0:14:19.52,0:14:22.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ume hampir tidak naik kelas, ya.
Dialogue: 0,0:14:22.32,0:14:24.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal pakai kacamata, konyol sekali.
Dialogue: 0,0:14:24.74,0:14:25.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berisik.
Dialogue: 0,0:14:26.07,0:14:27.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagian, kamu kan masih SMP.
Dialogue: 0,0:14:27.84,0:14:30.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujian SMA itu susah, lo.
Dialogue: 0,0:14:30.29,0:14:31.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak kecil minggir saja.
Dialogue: 0,0:14:31.66,0:14:32.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh.
Dialogue: 0,0:14:32.78,0:14:36.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ilmu komputer dan fisika Tanchan\Nsudah setara mahasiswa, lo.
Dialogue: 0,0:14:36.25,0:14:38.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan sudah membuat software sendiri.
Dialogue: 0,0:14:38.14,0:14:38.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?!
Dialogue: 0,0:14:40.07,0:14:42.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa, nih, yang anak-anak?
Dialogue: 0,0:14:42.69,0:14:45.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, sembah aku kalau mau minta bantuan.
Dialogue: 0,0:14:45.30,0:14:46.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pembelaan yang licik.
Dialogue: 0,0:14:47.60,0:14:49.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kelewatan.
Dialogue: 0,0:14:50.16,0:14:53.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, mungkin aku bisa lulus\Npelajaran Sains, ya?
Dialogue: 0,0:14:53.99,0:14:55.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, tapi, Matematika...
Dialogue: 0,0:14:56.11,0:14:57.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah! Ka-Kalau begitu...
Dialogue: 0,0:14:57.85,0:15:01.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Matematika? Aku pintar Matematika.
Dialogue: 0,0:15:02.46,0:15:05.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pintar Matematika? Michinoku?
Dialogue: 0,0:15:05.44,0:15:06.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:15:06.59,0:15:11.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak kelihatan, sih, tapi anak ini\Npenerima beasiswa sekolah karena Matematika.
Dialogue: 0,0:15:11.22,0:15:12.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be-Benarkah?!
Dialogue: 0,0:15:13.00,0:15:16.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya kamu bilang\Nsaat aku kesulitan tadi.
Dialogue: 0,0:15:16.15,0:15:17.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, maaf.
Dialogue: 0,0:15:17.31,0:15:19.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya tadi aku kepikiran mau ke toilet.
Dialogue: 0,0:15:19.24,0:15:20.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang itu seharusnya segera bilang!
Dialogue: 0,0:15:21.45,0:15:25.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, ternyata semua juara satu\Npelajaran Sains berkumpul di sini.
Dialogue: 0,0:15:25.76,0:15:27.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:15:27.49,0:15:31.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin karena itu Bu Hiratsuka\Nmemasukkanku ke OSIS?
Dialogue: 0,0:15:31.79,0:15:33.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mizunoe, pinjam 100 yen.
Dialogue: 0,0:15:33.82,0:15:37.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski tidak tampak begitu,\Nsebenarnya Bu Guru itu cukup jeli, sih.
Dialogue: 0,0:15:38.73,0:15:41.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, ayo segera kita mulai.
Dialogue: 0,0:15:41.32,0:15:43.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik! Mohon bantuannya!
Dialogue: 0,0:15:45.60,0:15:47.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fungsi ini mulus,
Dialogue: 0,0:15:47.33,0:15:51.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bagian ini adalah deret Fourier dengan\Nperiode kontinu, dan syarat batasnya...
Dialogue: 0,0:15:51.92,0:15:53.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sama sekali tidak paham.
Dialogue: 0,0:15:55.05,0:15:57.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketua merajuk di pojokan sana.
Dialogue: 0,0:15:57.96,0:15:59.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, tidak apa-apa.
Dialogue: 0,0:15:59.77,0:16:02.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ini tipe orang yang bisa semua,\Ntapi tak ada yang ahli.
Dialogue: 0,0:16:02.31,0:16:03.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, tidak, tidak!
Dialogue: 0,0:16:03.90,0:16:04.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah!
Dialogue: 0,0:16:05.18,0:16:06.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada, kok, pelajaran yang Ketua dalami!
Dialogue: 0,0:16:06.98,0:16:08.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketua di peringkat satu.
Dialogue: 0,0:16:08.75,0:16:09.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:16:09.86,0:16:12.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja!\NTolong ajari aku pelajaran itu!
Dialogue: 0,0:16:12.34,0:16:14.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm, itu...
Dialogue: 0,0:16:15.01,0:16:16.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penjaskes.
Dialogue: 0,0:16:16.37,0:16:17.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:16:18.03,0:16:21.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, ah... Aku tidak terlalu ahli.
Dialogue: 0,0:16:21.75,0:16:23.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, tidak, jangan merendah!
Dialogue: 0,0:16:24.05,0:16:26.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu pelajaran penting\Ntentang kesehatan tubuh.
Dialogue: 0,0:16:26.71,0:16:30.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ume tampaknya kesulitan di pelajaran itu,\Njadi tolong bantu ajari, ya!
Dialogue: 0,0:16:30.44,0:16:31.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:16:31.98,0:16:33.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah! Em, kalau begitu...
Dialogue: 0,0:16:39.22,0:16:40.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Anak perempuan.
Dialogue: 0,0:16:41.35,0:16:42.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu...
Dialogue: 0,0:16:42.46,0:16:45.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah, tidak apa-apa, Ketua!\NJangan dipaksakan!
Dialogue: 0,0:16:45.67,0:16:47.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, kami pergi dulu.
Dialogue: 0,0:16:47.29,0:16:49.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketua, maaf sudah mengganggu.
Dialogue: 0,0:16:51.61,0:16:55.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada akhirnya, semua diajari oleh Kotobuki.
Dialogue: 0,0:16:56.34,0:16:59.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dua hari berturut-turut\Nmemang melelahkan, ya.
Dialogue: 0,0:16:59.54,0:17:03.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mizunoe tinggal sendiri di dekat sekolah.
Dialogue: 0,0:17:03.49,0:17:06.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, Ketua pintar mengajar,
Dialogue: 0,0:17:06.78,0:17:10.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi masih sempat belanja diskonan\Ndi supermarket. Syukurlah.
Dialogue: 0,0:17:12.22,0:17:14.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah lama tidak masak gratin...
Dialogue: 0,0:17:15.56,0:17:16.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh.
Dialogue: 0,0:17:16.72,0:17:17.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:17:17.36,0:17:18.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hai.
Dialogue: 0,0:17:18.21,0:17:21.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kakak? Lagi pula, itu celanaku!
Dialogue: 0,0:17:21.30,0:17:23.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, ini Kakak.
Dialogue: 0,0:17:24.08,0:17:26.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, kamu kaget, ya?
Dialogue: 0,0:17:26.81,0:17:29.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pulang ke Jepang\Nkarena urusan pekerjaan.
Dialogue: 0,0:17:29.72,0:17:33.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kupikir untuk bertemu\Nadik kesayanganku dulu...
Dialogue: 0,0:17:34.27,0:17:36.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, begitu. Harusnya kabari dulu, dong.
Dialogue: 0,0:17:36.85,0:17:40.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, kali ini sepertinya\Npekerjaan yang cukup besar.
Dialogue: 0,0:17:41.04,0:17:44.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, untuk kali ini,\Naku berusaha cukup keras.
Dialogue: 0,0:17:44.60,0:17:45.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh...
Dialogue: 0,0:17:46.51,0:17:48.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak dipuji?
Dialogue: 0,0:17:48.97,0:17:51.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, kalau tiba-tiba bilang begitu...
Dialogue: 0,0:17:51.75,0:17:55.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong,\Nngapain pegang celanaku dari tadi?
Dialogue: 0,0:17:55.54,0:17:59.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, aku mau memeriksa apakah\Nkamu bisa hidup sendirian dengan baik.
Dialogue: 0,0:18:00.43,0:18:01.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama-tama, cek pakaian.
Dialogue: 0,0:18:02.15,0:18:03.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong hentikan.
Dialogue: 0,0:18:03.24,0:18:06.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar, aku kan sudah bukan anak-anak.
Dialogue: 0,0:18:06.87,0:18:11.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf. Bagaimanapun, aku tetap khawatir\Npada adikku yang imut.
Dialogue: 0,0:18:13.92,0:18:16.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, aku belum bisa menikah.
Dialogue: 0,0:18:16.11,0:18:18.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru gara-gara itu kamu belum nikah.\NLagian, kembalikan itu.
Dialogue: 0,0:18:19.71,0:18:23.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi,\NUme, sepertinya kamu sedikit berubah, ya.
Dialogue: 0,0:18:23.63,0:18:25.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Bagian mananya?
Dialogue: 0,0:18:26.09,0:18:27.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:18:27.39,0:18:30.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya kamu jadi lebih populer\Ndi kalangan cewek.
Dialogue: 0,0:18:30.73,0:18:32.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mencurigakan!
Dialogue: 0,0:18:32.64,0:18:34.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, Kak, jangan-jangan...
Dialogue: 0,0:18:34.94,0:18:41.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, aku meretas LONE-mu\Ndan memblokir semua kontak cewek.
Dialogue: 0,0:18:41.22,0:18:43.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang hentikan!\NSelalu saja begitu.
Dialogue: 0,0:18:43.89,0:18:48.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Ume dekat-dekat cewek,\NKakak jadi kesepian.
Dialogue: 0,0:18:48.71,0:18:50.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai lagi, deh.
Dialogue: 0,0:18:51.31,0:18:55.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku rindu masa-masa kamu pura-pura\Npunya banyak teman, padahal tidak ada.
Dialogue: 0,0:18:55.31,0:18:57.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan mengingatkanku pada masa kelam!
Dialogue: 0,0:18:58.27,0:19:01.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kamu benar-benar tidak mau\Nikut ke Amerika bersamaku?
Dialogue: 0,0:19:01.55,0:19:03.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lupakan cewek yang sekarang.
Dialogue: 0,0:19:03.49,0:19:05.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak omong apa, sih?
Dialogue: 0,0:19:05.76,0:19:06.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo!
Dialogue: 0,0:19:06.82,0:19:07.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:19:07.99,0:19:09.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, itu Ume.
Dialogue: 0,0:19:09.48,0:19:10.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi.
Dialogue: 0,0:19:10.31,0:19:13.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, a-ada apa?
Dialogue: 0,0:19:13.46,0:19:18.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, sebenarnya mau diberikan di luar,\Ntapi kami tidak bisa menghubungimu.
Dialogue: 0,0:19:18.62,0:19:19.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, Komachan.
Dialogue: 0,0:19:20.89,0:19:23.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini kue dari pelajaran tata boga.
Dialogue: 0,0:19:23.36,0:19:23.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:19:24.15,0:19:27.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mau memberikan itu padamu,\Ntapi tidak bisa ngomongnya.
Dialogue: 0,0:19:27.16,0:19:28.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hasilnya bagus.
Dialogue: 0,0:19:28.74,0:19:30.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be-Begitu, ya.
Dialogue: 0,0:19:32.80,0:19:33.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:19:34.96,0:19:35.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:19:37.64,0:19:38.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu, ya?
Dialogue: 0,0:19:38.86,0:19:40.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bermusuhan begitu!
Dialogue: 0,0:19:40.78,0:19:42.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, orang yang di sana itu...
Dialogue: 0,0:19:42.70,0:19:43.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, dia ini...
Dialogue: 0,0:19:44.59,0:19:49.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo, aku Mizunoe Shou,\Nkakak yang paling mencintai Ume.
Dialogue: 0,0:19:50.07,0:19:51.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan! Itu memalukan!
Dialogue: 0,0:19:51.42,0:19:52.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, wah.
Dialogue: 0,0:19:52.40,0:19:56.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Terui, senior yang mengagumi Ume.
Dialogue: 0,0:19:56.07,0:19:57.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan ikut-ikutan!
Dialogue: 0,0:19:57.91,0:20:00.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, aku Komaro. Aku suka Ume.
Dialogue: 0,0:20:00.22,0:20:01.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Singkat dan padat?!
Dialogue: 0,0:20:01.49,0:20:03.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian berani juga.
Dialogue: 0,0:20:03.36,0:20:05.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, mereka cuma berusaha sopan.
Dialogue: 0,0:20:05.79,0:20:09.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi memangnya kalian tahu apa tentang Ume?
Dialogue: 0,0:20:09.60,0:20:10.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:20:10.64,0:20:12.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu segalanya.
Dialogue: 0,0:20:12.96,0:20:18.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari ukuran burungnya 10 tahun lalu\Nsampai kata sandi akun keduanya.
Dialogue: 0,0:20:18.80,0:20:19.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oi?!
Dialogue: 0,0:20:19.42,0:20:22.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, aku tahu ukurannya yang sekarang.
Dialogue: 0,0:20:22.98,0:20:24.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ukurannya besar.
Dialogue: 0,0:20:25.09,0:20:26.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terasa waktu duduk di pangkuannya.
Dialogue: 0,0:20:26.87,0:20:29.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu cukup tahu soal Ume, ya.
Dialogue: 0,0:20:29.91,0:20:30.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Besar...
Dialogue: 0,0:20:30.86,0:20:33.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, lagi pula,\Nitu informasi tidak penting.
Dialogue: 0,0:20:34.25,0:20:40.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi ukuran burung cuma luarnya saja.\NApa kamu tahu isi hati Ume?
Dialogue: 0,0:20:41.13,0:20:44.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misalnya, anak ini sangat mudah\Nmerasa kesepian.
Dialogue: 0,0:20:44.22,0:20:47.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu kecil, kalau tidak punya teman,\Ndia suka menangis di pelukanku.
Dialogue: 0,0:20:49.50,0:20:50.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang.
Dialogue: 0,0:20:50.32,0:20:53.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sedang sendirian, dia kelihatan\Nkesepian dan bolak-balik melirik pintu.
Dialogue: 0,0:20:53.91,0:20:55.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia kelihatan imut di saat seperti itu.
Dialogue: 0,0:20:55.89,0:20:57.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?!
Dialogue: 0,0:20:57.25,0:20:58.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok bisa tahu?
Dialogue: 0,0:21:04.10,0:21:06.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, kalian yang terbaik.
Dialogue: 0,0:21:06.73,0:21:09.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, tidak,\Nkami juga menikmati perbincangan ini.
Dialogue: 0,0:21:10.07,0:21:12.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pembicaraan mendalam tentang Ume.
Dialogue: 0,0:21:13.38,0:21:16.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, kami harus segera pulang.
Dialogue: 0,0:21:16.29,0:21:18.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebentar lagi jam makan malam.
Dialogue: 0,0:21:18.45,0:21:20.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya, sayang sekali.
Dialogue: 0,0:21:20.61,0:21:22.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ume, antar mereka pulang, ya.
Dialogue: 0,0:21:22.41,0:21:24.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya selesai juga.
Dialogue: 0,0:21:24.44,0:21:27.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ditaruh di mana mukaku besok di sekolah?
Dialogue: 0,0:21:27.68,0:21:28.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, wah.
Dialogue: 0,0:21:29.51,0:21:31.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuenya enak?
Dialogue: 0,0:21:31.27,0:21:32.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Enak.\N- Ume.
Dialogue: 0,0:21:34.77,0:21:36.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah.
Dialogue: 0,0:21:41.63,0:21:42.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan.
Dialogue: 0,0:21:43.82,0:21:45.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi malu.
Dialogue: 0,0:21:54.58,0:21:56.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar keras kepala.
Dialogue: 0,0:21:59.05,0:22:02.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari itu, semua celana dalam Ume hilang.
Dialogue: 0,0:22:02.80,0:22:04.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai jumpa.
