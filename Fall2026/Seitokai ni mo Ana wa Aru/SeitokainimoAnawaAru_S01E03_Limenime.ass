Dialogue: 0,0:00:26.08,0:00:28.04,sign,,0000,0000,0000,,OI! HARI INI ADA KERJAAN!\NAKU TERLAMBAT KARENA KASURKU BERAT
Dialogue: 0,0:02:00.97,0:02:03.97,sign,,0000,0000,0000,,EPISODE 3: PEMBERSIHAN KOLAM RENANG\N+ EPISODE BAJU RENANG!
Dialogue: 0,0:02:11.08,0:02:12.99,sign,,0000,0000,0000,,"KELAS 3 SMA, HONMA KUROE"
Dialogue: 0,0:04:08.87,0:04:09.17,sign,,0000,0000,0000,,NIMFA MUSNAH
