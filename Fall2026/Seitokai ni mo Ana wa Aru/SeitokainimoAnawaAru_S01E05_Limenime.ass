Dialogue: 0,0:01:40.64,0:01:40.99,sign,,0000,0000,0000,,BU HIRATSUKA
Dialogue: 0,0:01:57.78,0:01:58.55,sign,,0000,0000,0000,,"MOTIF HARI INI"
Dialogue: 0,0:02:38.42,0:02:41.57,sign,,0000,0000,0000,,"KONTEN DISENSOR"
Dialogue: 0,0:04:02.01,0:04:02.81,sign,,0000,0000,0000,,BERSERI!
Dialogue: 0,0:04:14.19,0:04:16.89,sign,,0000,0000,0000,,KONTEN DISENSOR
Dialogue: 0,0:04:32.57,0:04:34.72,sign,,0000,0000,0000,,KONTEN DISENSOR
Dialogue: 0,0:04:56.88,0:04:58.21,sign,,0000,0000,0000,,GLEK
Dialogue: 0,0:05:35.25,0:05:36.27,sign,,0000,0000,0000,,KONTEN DISENSOR
Dialogue: 0,0:05:47.49,0:05:47.90,sign,,0000,0000,0000,,KAMI...
Dialogue: 0,0:05:57.33,0:05:59.29,sign,,0000,0000,0000,,"AULA BESAR"
Dialogue: 0,0:06:24.46,0:06:29.36,sign,,0000,0000,0000,,NGOROOOOK
Dialogue: 0,0:06:57.58,0:06:58.21,sign,,0000,0000,0000,,HENING...
Dialogue: 0,0:08:12.22,0:08:15.43,sign,,0000,0000,0000,,"SENJATA MAKAN TUAN"
Dialogue: 0,0:08:33.26,0:08:37.01,sign,,0000,0000,0000,,HENING...
Dialogue: 0,0:10:10.38,0:10:11.48,sign,,0000,0000,0000,,UME\NKOTOBUKI
Dialogue: 0,0:10:15.63,0:10:17.42,sign,,0000,0000,0000,,"MOTIF HARI INI"
Dialogue: 0,0:10:31.42,0:10:32.74,sign,,0000,0000,0000,,RUANG OSIS
Dialogue: 0,0:11:00.28,0:11:01.22,sign,,0000,0000,0000,,MEMBANTU EKSKUL BASKET
Dialogue: 0,0:11:13.56,0:11:16.57,sign,,0000,0000,0000,,EPISODE 5\NOPERASI BESAR UMETANTAN!
Dialogue: 0,0:12:59.88,0:13:03.00,sign,,0000,0000,0000,,"SEJARAH JEPANG"
Dialogue: 0,0:14:41.78,0:14:43.39,sign,,0000,0000,0000,,KONTEN DISENSOR
Dialogue: 0,0:14:55.52,0:14:56.70,sign,,0000,0000,0000,,KOMARO KEWALAHAN PIKET
Dialogue: 0,0:15:27.03,0:15:30.03,sign,,0000,0000,0000,,EPISODE 5\NHUJAN DAN UME, BERDUA DI BAWAH PAYUNG
Dialogue: 0,0:15:34.43,0:15:36.24,sign,,0000,0000,0000,,"MENATAP TAJAM..."
Dialogue: 0,0:15:51.49,0:15:52.93,sign,,0000,0000,0000,,KOMARO SAAT INI
Dialogue: 0,0:15:52.93,0:15:54.89,sign,,0000,0000,0000,,BERHENTI
Dialogue: 0,0:16:11.70,0:16:13.69,sign,,0000,0000,0000,,"PENDEK, PANJANG"
Dialogue: 0,0:16:43.73,0:16:45.69,sign,,0000,0000,0000,,BERHENTI
Dialogue: 0,0:16:50.17,0:16:51.11,sign,,0000,0000,0000,,EMPUK?!
Dialogue: 0,0:17:48.63,0:17:50.61,sign,,0000,0000,0000,,"BASAH KUYUP..."
Dialogue: 0,0:18:08.20,0:18:10.48,sign,,0000,0000,0000,,"UME DI EKSKUL KERAJINAN TANGAN"
Dialogue: 0,0:18:28.54,0:18:31.13,sign,,0000,0000,0000,,"LUNGLAI"
Dialogue: 0,0:19:42.28,0:19:42.81,sign,,0000,0000,0000,,MENCEKAM...
Dialogue: 0,0:20:30.77,0:20:31.74,sign,,0000,0000,0000,,RUANG EKSKUL KUBERIKAN
Dialogue: 0,0:20:41.30,0:20:43.40,sign,,0000,0000,0000,,"ROBOT AKSI DUDUK, ROBOT MOGOK MAKAN"
Dialogue: 0,0:20:43.40,0:20:44.31,sign,,0000,0000,0000,,"PROTES HABIS-HABISAN!"
Dialogue: 0,0:21:25.86,0:21:26.41,sign,,0000,0000,0000,,HORE!
Dialogue: 0,0:21:49.45,0:21:49.85,sign,,0000,0000,0000,,HARI BERIKUTNYA
Dialogue: 0,0:22:00.34,0:22:03.57,sign,,0000,0000,0000,,"KELAS 1 SMA, KELAS 2 SMA"
Dialogue: 0,0:22:03.57,0:22:04.97,sign,,0000,0000,0000,,"MEREKA BERDUA TEMAN MASA KECIL"
Dialogue: 0,0:23:34.97,0:23:35.99,sign,,0000,0000,0000,,CUPLIKAN EPISODE BERIKUTNYA
Dialogue: 0,0:23:35.99,0:23:38.54,sign,,0000,0000,0000,,GAWAT, KELEPASAN! - UME DAN BU GURU - DUNIA KOMARO
Dialogue: 0,0:23:38.54,0:23:39.96,sign,,0000,0000,0000,,NANTIKAN EPISODE BERIKUTNYA, YA!
Dialogue: 0,0:01:30.77,0:01:33.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari perjalanan ke onsen pun tiba.
Dialogue: 0,0:01:33.19,0:01:35.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Dengar, ya? Gacha 10 kali di sini itu...\N- Bu Guru belum datang juga, ya.
Dialogue: 0,0:01:35.48,0:01:38.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Wuah, bintang 5! Hebat juga kamu, Koma!\N- Sudah lewat sepuluh menit. Ada apa, ya?
Dialogue: 0,0:01:38.79,0:01:40.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba aku telepon, ya.
Dialogue: 0,0:01:43.46,0:01:48.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, ada apa, Mizunoe?\NHari libur begini mau curhat ke Ibu?
Dialogue: 0,0:01:49.02,0:01:52.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini kemah OSIS, lo!\NEh, jangan-jangan Ibu lupa?
Dialogue: 0,0:01:52.59,0:01:54.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Ah...
Dialogue: 0,0:01:55.94,0:01:57.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah kasih tahu.
Dialogue: 0,0:01:57.78,0:01:58.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu berangkat sekarang.
Dialogue: 0,0:01:58.86,0:02:02.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa malah ngambek?!\NDitutup pula!
Dialogue: 0,0:02:02.17,0:02:06.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, kedatangan kami\Nakan sedikit terlambat.
Dialogue: 0,0:02:06.80,0:02:08.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waduh, tumpah! Sedotan, sedotan!
Dialogue: 0,0:02:11.06,0:02:12.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, datang juga.
Dialogue: 0,0:02:12.27,0:02:14.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duh, maaf, maaf.
Dialogue: 0,0:02:14.23,0:02:16.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga, Ibu telat tiga jam, lo.
Dialogue: 0,0:02:16.55,0:02:19.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, ini juga sudah buru-buru.
Dialogue: 0,0:02:19.21,0:02:22.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat, pakai sandal,\Nrambut juga masih berantakan.
Dialogue: 0,0:02:22.33,0:02:25.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya... beha juga lupa.
Dialogue: 0,0:02:25.16,0:02:26.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, kan mau ke onsen.
Dialogue: 0,0:02:26.82,0:02:27.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya?
Dialogue: 0,0:02:27.44,0:02:29.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Ya" apanya?!
Dialogue: 0,0:02:29.00,0:02:31.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu yakin bisa nyetir?
Dialogue: 0,0:02:31.00,0:02:34.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang, SIM Ibu bebas pelanggaran!
Dialogue: 0,0:02:34.21,0:02:36.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, berangkat!
Dialogue: 0,0:02:38.42,0:02:41.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm? Barusan ada yang kena di belakang?
Dialogue: 0,0:02:41.57,0:02:43.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}SIM-nya cuma pajangan!
Dialogue: 0,0:02:45.22,0:02:49.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai lancar, nih.\NIbu ingat lagi cara nyetir.
Dialogue: 0,0:02:49.10,0:02:50.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu Guru! Terlalu cepat!
Dialogue: 0,0:02:51.17,0:02:53.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat, dua orang di belakang juga\Nkelihatan tersiksa!
Dialogue: 0,0:02:53.68,0:02:54.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai nempel ke jendela!
Dialogue: 0,0:02:54.98,0:02:56.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah! Pemandangannya bagus banget!
Dialogue: 0,0:02:56.88,0:02:58.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata cuma kegirangan.
Dialogue: 0,0:02:58.32,0:03:00.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih ngebut lagi, dong!
Dialogue: 0,0:03:00.04,0:03:00.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap!
Dialogue: 0,0:03:00.95,0:03:02.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial! Malah jadi bumerang!
Dialogue: 0,0:03:04.49,0:03:07.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, lihat, lihat! Lautnya biru banget!
Dialogue: 0,0:03:07.02,0:03:09.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya, benar.
Dialogue: 0,0:03:09.06,0:03:11.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong soal biru,\Nmuka Koma juga biru banget.
Dialogue: 0,0:03:12.00,0:03:13.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga. Kamu tidak apa-apa?
Dialogue: 0,0:03:14.20,0:03:16.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemandangannya kelihatan\Nwarna-warni kayak pelangi.
Dialogue: 0,0:03:16.68,0:03:17.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sudah di batasnya!
Dialogue: 0,0:03:17.80,0:03:19.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah! Pelangi!
Dialogue: 0,0:03:20.02,0:03:22.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di dalam mobil pun muncul pelangi.
Dialogue: 0,0:03:24.15,0:03:25.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya, Komachan.
Dialogue: 0,0:03:25.56,0:03:27.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau jus ume?
Dialogue: 0,0:03:27.68,0:03:29.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar mulutnya segar.
Dialogue: 0,0:03:29.46,0:03:30.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:03:30.89,0:03:32.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ume juga, silakan.
Dialogue: 0,0:03:32.51,0:03:34.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, terima kasih.
Dialogue: 0,0:03:35.02,0:03:37.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Jus Ume" kedengarannya agak mesum, ya.
Dialogue: 0,0:03:37.62,0:03:39.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ngomong apa lagi, sih?
Dialogue: 0,0:03:39.49,0:03:42.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kotobuki, arahnya ke mana?\NBerikutnya?
Dialogue: 0,0:03:42.71,0:03:44.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, ah? Gairahnya?
Dialogue: 0,0:03:44.68,0:03:45.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:03:47.66,0:03:49.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai!
Dialogue: 0,0:03:49.37,0:03:51.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak apa-apa? Pelan-pelan...
Dialogue: 0,0:03:51.33,0:03:54.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah perjalanannya lancar jaya.
Dialogue: 0,0:03:54.02,0:03:56.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Telat lima jam begini, lancar dari mana?
Dialogue: 0,0:03:56.54,0:04:00.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus bagaimana?\NRencana tur museum panas bumi, misalnya?
Dialogue: 0,0:04:00.31,0:04:02.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Sudah jelas, 'kan?
Dialogue: 0,0:04:02.82,0:04:05.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo ke pemandian! Lupakan jadwal!
Dialogue: 0,0:04:05.77,0:04:09.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Museum panas bumi itu cuma formalitas.\NJujur saja, kalian juga ogah lihat, 'kan?
Dialogue: 0,0:04:09.60,0:04:11.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itukah punggung wali kelasku...
Dialogue: 0,0:04:16.91,0:04:18.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya hidup lagi...
Dialogue: 0,0:04:19.04,0:04:21.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu Guru, tidak boleh bawa minuman keras\Nke sini, lo.
Dialogue: 0,0:04:21.88,0:04:23.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian tidak paham, ya.
Dialogue: 0,0:04:23.57,0:04:27.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini hadiah buat orang dewasa\Nyang hidupnya berat.
Dialogue: 0,0:04:27.42,0:04:29.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ih, alasannya ngeles saja.
Dialogue: 0,0:04:29.55,0:04:31.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudahlah, toh tidak ada orang lain.
Dialogue: 0,0:04:31.88,0:04:32.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm?
Dialogue: 0,0:04:34.73,0:04:38.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemandian pria di sebelah sini, lo,\NKo-to-bu-ki.
Dialogue: 0,0:04:38.35,0:04:39.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Heh?!
Dialogue: 0,0:04:39.48,0:04:41.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, maklum lagi umur penasaran.
Dialogue: 0,0:04:41.82,0:04:43.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu-Bukan begitu!
Dialogue: 0,0:04:43.91,0:04:47.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, apa boleh buat.\NCoba lihat sekat ini baik-baik.
Dialogue: 0,0:04:47.24,0:04:47.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:04:47.68,0:04:50.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bolong-bolong, sudah tradisi.
Dialogue: 0,0:04:50.20,0:04:51.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bolongnya kebanyakan, dong?!
Dialogue: 0,0:04:51.66,0:04:52.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, 'kan?
Dialogue: 0,0:04:52.39,0:04:55.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, bisa-bisa\Ndua cowok itu datang mengintip, nih.
Dialogue: 0,0:04:58.68,0:05:01.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Masa, sih?
Dialogue: 0,0:05:01.48,0:05:03.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf menunggu.
Dialogue: 0,0:05:03.04,0:05:04.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh.
Dialogue: 0,0:05:04.28,0:05:06.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo? Sebelah ini pemandian wanita?
Dialogue: 0,0:05:06.31,0:05:09.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, kedengaran suara yang mirip Bu Guru.
Dialogue: 0,0:05:10.15,0:05:10.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau ngintip?
Dialogue: 0,0:05:11.75,0:05:13.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa? Ada apa?
Dialogue: 0,0:05:13.51,0:05:16.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu-Bukan,\Naku kan tidak pakai kacamata, jadi...
Dialogue: 0,0:05:16.87,0:05:19.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira tadi kamu cewek...
Dialogue: 0,0:05:22.22,0:05:24.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?! Jangan-jangan, Ume,\N"itu"-mu berdiri?!
Dialogue: 0,0:05:24.46,0:05:27.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ja-Jangan! Tidak berdiri, tahu!\NAku keluar duluan!
Dialogue: 0,0:05:27.31,0:05:31.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Santai dulu di sini, dong!
Dialogue: 0,0:05:36.28,0:05:38.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?! Kenapa?!
Dialogue: 0,0:05:39.65,0:05:42.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar tidak ada apa-apa?!
Dialogue: 0,0:05:42.11,0:05:44.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kotobuki, Ibu sudah mau keluar, nih.
Dialogue: 0,0:05:44.55,0:05:45.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Ah...
Dialogue: 0,0:05:45.44,0:05:47.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar tidak terjadi apa-apa.
Dialogue: 0,0:05:47.91,0:05:49.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, Tanchan?
Dialogue: 0,0:05:49.88,0:05:51.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.
Dialogue: 0,0:05:51.55,0:05:54.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami cuma lagi masa pertumbuhan, kok.
Dialogue: 0,0:05:57.33,0:05:59.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih atas makanannya!
Dialogue: 0,0:06:00.77,0:06:04.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, makanannya enak banget!
Dialogue: 0,0:06:04.26,0:06:08.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar lezat!\NApalagi shirako cakalangnya!
Dialogue: 0,0:06:08.46,0:06:11.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arisu memang suka, ya, sama sperma ik...
Dialogue: 0,0:06:11.95,0:06:14.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ih, Tanchan ini!
Dialogue: 0,0:06:14.31,0:06:15.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senior Terui?
Dialogue: 0,0:06:15.62,0:06:19.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, karena sudah makan,\Nkita lakukan "itu", yuk.
Dialogue: 0,0:06:19.75,0:06:21.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Itu" maksudnya...
Dialogue: 0,0:06:21.61,0:06:24.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Balik ke kamar, main UNO! UNO!
Dialogue: 0,0:06:29.36,0:06:32.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepatnya mereka tertidur\Nsudah jadi semacam tradisi.
Dialogue: 0,0:06:32.46,0:06:34.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya kecapekan, mungkin.
Dialogue: 0,0:06:34.55,0:06:37.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal kupikir bisa main. Ih!
Dialogue: 0,0:06:37.82,0:06:40.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana? Ini kamar cowok, lo.
Dialogue: 0,0:06:40.24,0:06:42.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, tapi bagaimana kalau kita bangunkan?
Dialogue: 0,0:06:42.42,0:06:44.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, kita bangunkan pakai permainan.
Dialogue: 0,0:06:44.91,0:06:45.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permainan?
Dialogue: 0,0:06:45.50,0:06:48.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perang bantal, khas acara kemah!
Dialogue: 0,0:06:48.60,0:06:50.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Langsung mulai dari dia?!
Dialogue: 0,0:06:50.42,0:06:51.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasakan!
Dialogue: 0,0:06:51.73,0:06:52.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agh!
Dialogue: 0,0:06:52.42,0:06:53.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanpa ampun!
Dialogue: 0,0:06:53.37,0:06:57.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasakan! Rasakan! Rasakan!
Dialogue: 0,0:06:58.22,0:07:00.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bangun.
Dialogue: 0,0:07:00.04,0:07:02.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal tadi kayak mau\Nbikin mereka tidur selamanya.
Dialogue: 0,0:07:02.75,0:07:04.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih hidup?
Dialogue: 0,0:07:04.02,0:07:06.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, berikutnya suit buka baju!
Dialogue: 0,0:07:06.55,0:07:10.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permainan yang pasti bikin bugil?\NItu, sih, sudah kayak begal.
Dialogue: 0,0:07:11.49,0:07:15.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ume, yang begitu mana muat.
Dialogue: 0,0:07:15.45,0:07:19.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, Ume lagi menyuapi dia\Nsesuatu, ya? Imutnya.
Dialogue: 0,0:07:20.60,0:07:23.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di dalam mimpi pun akrab, ya.
Dialogue: 0,0:07:23.06,0:07:25.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan begitu, dong.
Dialogue: 0,0:07:25.68,0:07:27.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hap!
Dialogue: 0,0:07:29.84,0:07:32.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudahlah, biarkan mereka tidur saja.
Dialogue: 0,0:07:32.60,0:07:33.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:07:35.20,0:07:37.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku juga tidur.
Dialogue: 0,0:07:37.35,0:07:38.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei?
Dialogue: 0,0:07:40.93,0:07:43.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senior Terui kenapa, ya, hari ini?
Dialogue: 0,0:07:43.93,0:07:47.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aslinya memang begitu, sih.
Dialogue: 0,0:07:47.22,0:07:50.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kayaknya ini gara-gara duduk\Ndi sebelah Bu Guru.
Dialogue: 0,0:07:50.70,0:07:52.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak.
Dialogue: 0,0:07:52.42,0:07:55.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shirako-nya jadi makin nikmat.
Dialogue: 0,0:07:55.04,0:07:56.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin dia mabuk.
Dialogue: 0,0:07:56.04,0:07:57.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mabuk uap sake shirako?
Dialogue: 0,0:07:57.79,0:08:00.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi sekarang aku benar-benar\Ntidak punya tempat...
Dialogue: 0,0:08:00.44,0:08:03.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, gara-gara para cewek kami.
Dialogue: 0,0:08:03.08,0:08:05.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa boleh buat, kita ke kamar cewek saja.
Dialogue: 0,0:08:05.22,0:08:05.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:08:06.08,0:08:07.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya tidak apa-apa?
Dialogue: 0,0:08:07.53,0:08:10.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?! Yah, kamarnya luas.
Dialogue: 0,0:08:10.33,0:08:12.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, kalau Mizunoe, sih,\Ntidak apa-apa.
Dialogue: 0,0:08:12.22,0:08:15.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, bukan! Maksudnya aku percaya padamu, ya!
Dialogue: 0,0:08:20.64,0:08:23.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, lampunya kumatikan, ya.
Dialogue: 0,0:08:23.73,0:08:26.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, iya, silakan.
Dialogue: 0,0:08:44.88,0:08:47.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, masih bangun?
Dialogue: 0,0:08:47.44,0:08:50.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, iya. Lampunya kan baru dimatikan.
Dialogue: 0,0:08:50.76,0:08:52.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:08:59.53,0:09:00.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma...
Dialogue: 0,0:09:00.44,0:09:02.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, maaf, ya.
Dialogue: 0,0:09:02.24,0:09:03.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:09:03.02,0:09:05.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa tiba-tiba?
Dialogue: 0,0:09:05.31,0:09:06.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, yah...
Dialogue: 0,0:09:06.60,0:09:10.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu itu,\NMizunoe tidur di ruang OSIS, 'kan?
Dialogue: 0,0:09:10.15,0:09:12.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku khawatir sudah memaksamu\Nkerja terlalu keras.
Dialogue: 0,0:09:13.95,0:09:15.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku agak kepikiran.
Dialogue: 0,0:09:15.97,0:09:19.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya aku sering bawa kerjaan tambahan.
Dialogue: 0,0:09:20.71,0:09:21.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayaknya...
Dialogue: 0,0:09:21.46,0:09:23.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duh, ngomong apa, sih?
Dialogue: 0,0:09:24.22,0:09:26.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku melakukannya karena suka, kok.
Dialogue: 0,0:09:41.33,0:09:43.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Ume.
Dialogue: 0,0:09:46.58,0:09:49.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Barusan aku ngomong hal\Nyang norak banget, ya?
Dialogue: 0,0:09:49.71,0:09:51.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata dia tidak dengar.
Dialogue: 0,0:09:53.57,0:09:56.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ugh, tahu-tahu aku ketiduran.
Dialogue: 0,0:09:58.57,0:09:59.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:09:59.49,0:10:03.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sip. Tidak "masuk", ya.\NCuma tidurnya berantakan.
Dialogue: 0,0:10:05.00,0:10:10.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahaya. Kalau sampai ada kejadian\Nselama aku jadi pendamping...
Dialogue: 0,0:10:12.46,0:10:15.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang itu gawat.\NAnggap saja tidak lihat.
Dialogue: 0,0:10:15.63,0:10:17.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Toilet, toilet.
Dialogue: 0,0:10:17.88,0:10:20.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sempat heboh karena Kotobuki
Dialogue: 0,0:10:20.78,0:10:26.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang ke toilet tengah malam\Nketahuan tidur di kasur Mizunoe,
Dialogue: 0,0:10:26.44,0:10:28.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kesalahpahaman itu akhirnya beres.
Dialogue: 0,0:10:32.75,0:10:33.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong,
Dialogue: 0,0:10:33.90,0:10:37.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku baru kepikiran sekarang,\Ntapi Senior Terui itu orangnya kayak apa?
Dialogue: 0,0:10:37.86,0:10:39.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudnya?
Dialogue: 0,0:10:39.31,0:10:40.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, yah...
Dialogue: 0,0:10:40.68,0:10:42.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kadang kukira galak, ternyata baik.
Dialogue: 0,0:10:42.82,0:10:45.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira menakutkan,\Nternyata ada sisi imutnya.
Dialogue: 0,0:10:45.68,0:10:47.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya orangnya misterius.
Dialogue: 0,0:10:51.84,0:10:55.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak kusangka Ume naksir Arisu.
Dialogue: 0,0:10:55.00,0:10:56.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah sama Ketua?
Dialogue: 0,0:10:56.95,0:10:59.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga kamu bakal bilang begitu.
Dialogue: 0,0:11:01.57,0:11:04.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma merasa banyak hal\Nyang belum kutahu.
Dialogue: 0,0:11:06.22,0:11:09.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya sudah. Ayo kita beraksi!
Dialogue: 0,0:11:09.85,0:11:13.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Operasi Besar Bongkar Rahasia Arisu!
Dialogue: 0,0:11:17.26,0:11:18.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu dia!
Dialogue: 0,0:11:19.82,0:11:20.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei.
Dialogue: 0,0:11:20.37,0:11:21.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:11:21.37,0:11:22.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ngintip?
Dialogue: 0,0:11:22.53,0:11:25.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kita melakukan hal\Nkayak penguntit begini?
Dialogue: 0,0:11:25.04,0:11:25.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:11:25.87,0:11:28.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mau kenal orang,\Nharus lihat sisi aslinya.
Dialogue: 0,0:11:28.91,0:11:31.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arisu biasanya jaga citranya, sih.
Dialogue: 0,0:11:31.08,0:11:32.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be-Begitu, ya?
Dialogue: 0,0:11:32.42,0:11:36.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagian, kalau dapat aibnya,\Nbisa jadi balas dendam!
Dialogue: 0,0:11:36.93,0:11:38.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Basmi kejahatan, colok pantatnya!
Dialogue: 0,0:11:38.62,0:11:42.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu memang begitu, ya. Dan yang benar,\N"basmi kejahatan, tegakkan kebenaran".
Dialogue: 0,0:11:42.01,0:11:43.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah!
Dialogue: 0,0:11:43.02,0:11:43.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?!
Dialogue: 0,0:11:43.86,0:11:46.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia nulis nama orang di papan tulis!
Dialogue: 0,0:11:46.17,0:11:46.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perundungan?!
Dialogue: 0,0:11:47.15,0:11:49.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, itu petugas piket besok, 'kan?
Dialogue: 0,0:11:49.48,0:11:50.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah!
Dialogue: 0,0:11:50.02,0:11:52.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang dia sembarangan\Nngutak-atik buku di meja guru!
Dialogue: 0,0:11:52.75,0:11:54.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu jurnal kelas.
Dialogue: 0,0:11:56.44,0:11:59.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia masukin kunci ke saku!\NMencuri?!
Dialogue: 0,0:11:59.90,0:12:01.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu kunci kelas.
Dialogue: 0,0:12:01.88,0:12:04.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan kamu selalu bolos piket, ya?
Dialogue: 0,0:12:05.26,0:12:06.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senior memang hebat.
Dialogue: 0,0:12:06.70,0:12:09.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai piket pun kerjanya teladan.
Dialogue: 0,0:12:09.44,0:12:11.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada celah sedikit pun.
Dialogue: 0,0:12:11.31,0:12:13.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membosankan.
Dialogue: 0,0:12:13.11,0:12:13.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya!
Dialogue: 0,0:12:14.13,0:12:15.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita panggil Arisu keluar!
Dialogue: 0,0:12:15.97,0:12:17.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inspeksi barang bawaan dadakan!
Dialogue: 0,0:12:17.75,0:12:19.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti kamu yang dibasmi, lo.
Dialogue: 0,0:12:19.55,0:12:25.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm, "Ume bilang dia ingin\Nlihat wajah Senior Terui"... kirim.
Dialogue: 0,0:12:25.26,0:12:25.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei!
Dialogue: 0,0:12:27.26,0:12:29.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah. Dibalas "Nanti kuhukum"...
Dialogue: 0,0:12:29.93,0:12:31.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang dihukum Ume, 'kan?
Dialogue: 0,0:12:31.35,0:12:33.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini, sih, jalur "basmi kejahatan".
Dialogue: 0,0:12:34.22,0:12:36.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia keluar! Operasinya berhasil?
Dialogue: 0,0:12:36.75,0:12:38.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin ke toilet?
Dialogue: 0,0:12:38.23,0:12:41.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke! Serbu, cek barang bawaan!
Dialogue: 0,0:12:41.11,0:12:42.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}He-Hei!
Dialogue: 0,0:12:42.57,0:12:44.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini meja Arisu, ya.
Dialogue: 0,0:12:44.70,0:12:47.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu! Kalau ke toilet,\Nbisa cepat balik, lo!
Dialogue: 0,0:12:47.64,0:12:49.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Tenang saja.
Dialogue: 0,0:12:49.54,0:12:51.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arisu kalau ke toilet lama,
Dialogue: 0,0:12:51.22,0:12:53.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia senam pembesar dada,\Nngumpulin lemak ketiak ke dada.
Dialogue: 0,0:12:53.48,0:12:57.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah itu aib yang kamu cari?
Dialogue: 0,0:12:57.04,0:12:59.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat, lihat. Dia corat-coret!
Dialogue: 0,0:12:59.88,0:13:03.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu akrab, ya, sama Senior.
Dialogue: 0,0:13:03.00,0:13:05.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami sudah lama kenal, sih.
Dialogue: 0,0:13:05.28,0:13:08.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak Arisu jadi bos geng\Ndiam-diam waktu SMP.
Dialogue: 0,0:13:09.35,0:13:11.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bo-Bos geng?!
Dialogue: 0,0:13:11.28,0:13:15.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, iya. Para berandalan kota\Njuga takut banget sama dia.
Dialogue: 0,0:13:15.56,0:13:19.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di kalangan mereka,\Ndia dijuluki "Siluman Talenan Psiko".
Dialogue: 0,0:13:19.51,0:13:22.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat, si Talenan Psiko!
Dialogue: 0,0:13:22.02,0:13:23.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu juga aib, 'kan?
Dialogue: 0,0:13:23.94,0:13:26.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, kamu sendiri waktu itu...
Dialogue: 0,0:13:26.42,0:13:29.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, kami ketemu waktu aku\Nkelas 1 SMP, kayaknya.
Dialogue: 0,0:13:30.75,0:13:34.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu itu aku dihajar habis-habisan.
Dialogue: 0,0:13:34.79,0:13:37.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?! Tapi aku tidak kalah, kok!
Dialogue: 0,0:13:37.57,0:13:40.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang pun aku lagi balas dendam,\Nbagai Tan mengintai mangsa!
Dialogue: 0,0:13:40.42,0:13:41.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harimau, bukan Tan.
Dialogue: 0,0:13:41.63,0:13:43.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo? Ini kan HP-nya!
Dialogue: 0,0:13:43.42,0:13:45.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, hei, yang itu jangan...
Dialogue: 0,0:13:46.57,0:13:47.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:13:48.80,0:13:51.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini kan foto waktu kemah.
Dialogue: 0,0:14:06.03,0:14:08.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita diam di sini sampai dia pergi.
Dialogue: 0,0:14:08.57,0:14:12.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Umetantan, Komarumaru
Dialogue: 0,0:14:12.75,0:14:16.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senior Terui menyanyikan\Nlagu buatannya sendiri yang konyol?
Dialogue: 0,0:14:16.66,0:14:20.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya aku baru lihat\Nsesuatu yang luar biasa...
Dialogue: 0,0:14:21.37,0:14:22.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?!
Dialogue: 0,0:14:22.40,0:14:23.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan...
Dialogue: 0,0:14:23.50,0:14:25.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya aku nemu aib luar biasa!
Dialogue: 0,0:14:25.91,0:14:27.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku kegirangan!
Dialogue: 0,0:14:27.48,0:14:29.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ha-Harus kurekam...
Dialogue: 0,0:14:29.00,0:14:30.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei! Jangan banyak gerak!
Dialogue: 0,0:14:36.35,0:14:39.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aib Arisu... dapat, nih!
Dialogue: 0,0:14:43.40,0:14:46.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak mau ini kusebar\Nke internet, lupakan.
Dialogue: 0,0:14:47.44,0:14:49.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang tidak bisa melawan dia.
Dialogue: 0,0:14:49.28,0:14:54.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rahasia Terui ternyata adalah\Ndia sayang banget sama semua anggota OSIS.
Dialogue: 0,0:14:58.66,0:15:00.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waduh.
Dialogue: 0,0:15:00.17,0:15:01.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hujan, ya.
Dialogue: 0,0:15:01.80,0:15:02.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:15:03.00,0:15:05.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Prakiraan cuacanya meleset jauh.
Dialogue: 0,0:15:05.51,0:15:07.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bawa payung lipat, sih.\NKalau Michinoku?
Dialogue: 0,0:15:07.97,0:15:10.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini ada.
Dialogue: 0,0:15:10.62,0:15:13.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Payung cadanganku\Ndi sekolah tumben masih ada.
Dialogue: 0,0:15:13.57,0:15:15.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biasanya entah kenapa selalu hilang.
Dialogue: 0,0:15:15.72,0:15:19.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baguslah.\NKalau begitu, ayo pulang.
Dialogue: 0,0:15:19.84,0:15:21.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:15:24.02,0:15:26.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiba-tiba hujan!
Dialogue: 0,0:15:30.03,0:15:31.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke-Ketua!
Dialogue: 0,0:15:32.36,0:15:34.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi mau pulang, ya?
Dialogue: 0,0:15:34.43,0:15:36.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Uwoh, Mizunoe!
Dialogue: 0,0:15:36.24,0:15:39.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maaf.\NBaru keluar, langsung kehujanan.
Dialogue: 0,0:15:39.88,0:15:41.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Prakiraannya kan cerah.
Dialogue: 0,0:15:41.87,0:15:44.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mizunoe juga mau pulang?
Dialogue: 0,0:15:44.24,0:15:47.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, iya. Kebetulan mau pulang\Nbareng Michinoku... Lo?
Dialogue: 0,0:15:48.71,0:15:50.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada?\NSudah pulang duluan, ya?
Dialogue: 0,0:15:55.62,0:15:57.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak berhenti juga, ya.
Dialogue: 0,0:15:57.22,0:16:01.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, mau pulang bareng pakai payungku?\NBercanda, sih.
Dialogue: 0,0:16:01.27,0:16:03.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih! Mau banget!
Dialogue: 0,0:16:03.06,0:16:03.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:16:03.52,0:16:06.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus masak buat adik-adikku!\NKamu sangat membantu!
Dialogue: 0,0:16:06.97,0:16:08.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Ah! Benar juga!
Dialogue: 0,0:16:08.98,0:16:10.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, ayo jalan.
Dialogue: 0,0:16:10.93,0:16:11.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh,
Dialogue: 0,0:16:11.70,0:16:13.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}payungnya unik, ya.
Dialogue: 0,0:16:13.70,0:16:16.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, Ketua sadar! Matanya jeli!
Dialogue: 0,0:16:16.44,0:16:19.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sebenarnya didesain\Nsupaya ransel tidak gampang basah.
Dialogue: 0,0:16:19.97,0:16:21.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu!
Dialogue: 0,0:16:21.16,0:16:24.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu strukturnya berdasarkan\Nilmu mekanika apalah,
Dialogue: 0,0:16:24.20,0:16:25.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- jadi kuat menahan angin kencang!\N- Wah, hebat!
Dialogue: 0,0:16:25.93,0:16:28.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Aku sudah tak sabar memakainya!\N- Senang lihat dia
Dialogue: 0,0:16:28.08,0:16:29.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Dari tampilannya juga ramping.\N- gembira begitu!
Dialogue: 0,0:16:29.95,0:16:31.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasangan bucin.
Dialogue: 0,0:16:31.17,0:16:33.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, ayo langsung pulang!
Dialogue: 0,0:16:33.13,0:16:34.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:16:38.47,0:16:41.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok dekat banget, ya?
Dialogue: 0,0:16:41.46,0:16:43.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebarnya justru sempit.
Dialogue: 0,0:16:51.11,0:16:52.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maaf!
Dialogue: 0,0:16:52.22,0:16:54.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, tidak, aku yang minta maaf!
Dialogue: 0,0:16:54.07,0:16:56.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ki-Kita jalan depan-belakang saja!
Dialogue: 0,0:16:56.08,0:16:59.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga! Payungnya kan panjang\Nke belakang! Ayo, jalan!
Dialogue: 0,0:16:59.66,0:17:00.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah!
Dialogue: 0,0:17:00.62,0:17:04.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, samakan langkah!\NMulai dari kanan, ya!
Dialogue: 0,0:17:04.34,0:17:06.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baik.
Dialogue: 0,0:17:06.02,0:17:08.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Satu, dua, kanan!\N- Ah, genangan air.
Dialogue: 0,0:17:08.67,0:17:12.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf banget. Gara-gara payungku...
Dialogue: 0,0:17:12.02,0:17:14.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, tidak!\NItu kan payung satu orang! Ini salahku.
Dialogue: 0,0:17:14.38,0:17:18.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah! Bagaimana kalau payungnya dimiringkan,\Nlalu kita jalan berdampingan?
Dialogue: 0,0:17:18.17,0:17:20.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga! Ide bagus!
Dialogue: 0,0:17:24.56,0:17:26.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bo-Boleh juga, ya!
Dialogue: 0,0:17:26.64,0:17:27.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:17:28.08,0:17:29.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah bisa teratasi.
Dialogue: 0,0:17:31.33,0:17:32.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, iya.
Dialogue: 0,0:17:32.82,0:17:34.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Payung ini...
Dialogue: 0,0:17:34.91,0:17:37.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lemah sama angin dari samping!
Dialogue: 0,0:17:37.48,0:17:39.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu ke-kelihatan...
Dialogue: 0,0:17:39.99,0:17:41.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak...
Dialogue: 0,0:17:41.99,0:17:44.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Michinoku?!
Dialogue: 0,0:17:48.63,0:17:50.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beli payung biasa.
Dialogue: 0,0:17:50.62,0:17:51.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hachi!
Dialogue: 0,0:17:51.51,0:17:53.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baik.
Dialogue: 0,0:17:53.00,0:17:55.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketiganya basah kuyup.
Dialogue: 0,0:17:56.04,0:17:58.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cewek SMA tadi dadanya besar banget.
Dialogue: 0,0:17:58.48,0:17:59.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makasih.
Dialogue: 0,0:17:59.66,0:18:01.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan kamu, maksudku.
Dialogue: 0,0:18:02.42,0:18:05.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fiuh, hari ini bisa pulang lebih awal.
Dialogue: 0,0:18:05.68,0:18:08.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya bisa mampir ke ekskul lagi.
Dialogue: 0,0:18:08.20,0:18:10.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, mungkin juga tidak ada yang datang.
Dialogue: 0,0:18:10.48,0:18:11.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh?
Dialogue: 0,0:18:11.97,0:18:14.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Batsunosuke?\NNgapain di depan ruang ekskul?
Dialogue: 0,0:18:14.22,0:18:20.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}U-Ume... Halo.\NMaaf, ya. Selalu gara-gara aku.
Dialogue: 0,0:18:20.73,0:18:22.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, sungguh.
Dialogue: 0,0:18:22.55,0:18:24.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Kenapa tiba-tiba?
Dialogue: 0,0:18:24.62,0:18:25.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu.
Dialogue: 0,0:18:26.35,0:18:28.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ruang ekskul kita direbut.
Dialogue: 0,0:18:28.54,0:18:31.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, apa-apaan ini?! Maksudnya apa?!
Dialogue: 0,0:18:31.13,0:18:32.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:18:32.38,0:18:34.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga tidak mengerti.
Dialogue: 0,0:18:34.73,0:18:37.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sadar-sadar,\Naku sudah di atas lantai linoleum dingin.
Dialogue: 0,0:18:37.02,0:18:38.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin!
Dialogue: 0,0:18:38.22,0:18:39.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pendudukan ilegal!
Dialogue: 0,0:18:39.88,0:18:42.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku agak ingat sesuatu.
Dialogue: 0,0:18:42.86,0:18:45.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayaknya di rapat ketua ekskul waktu itu\Nada pembahasan begitu.
Dialogue: 0,0:18:46.11,0:18:47.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu dia penyebabnya!
Dialogue: 0,0:18:47.02,0:18:49.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus bagaimana?\NBarang kita kan banyak!
Dialogue: 0,0:18:49.77,0:18:52.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu benar sekali. Maaf.
Dialogue: 0,0:18:52.48,0:18:54.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar aku yang ke sana dan bicara.
Dialogue: 0,0:18:54.62,0:18:55.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat, Senior.
Dialogue: 0,0:18:56.40,0:18:58.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Ada colokan listrik.
Dialogue: 0,0:18:58.80,0:19:01.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, ada meja dan kursi juga, Asisten.
Dialogue: 0,0:19:01.32,0:19:05.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini beneran, benar-benar milik kita.
Dialogue: 0,0:19:05.53,0:19:07.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, ini ruangan kita.
Dialogue: 0,0:19:07.88,0:19:08.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Susah ngomongnya.
Dialogue: 0,0:19:08.96,0:19:10.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pe-Permisi sebentar.
Dialogue: 0,0:19:10.97,0:19:11.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm?
Dialogue: 0,0:19:11.79,0:19:14.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?\NAda perlu di ruangan kami?
Dialogue: 0,0:19:14.60,0:19:17.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah benar-benar dianggap milik sendiri.
Dialogue: 0,0:19:17.13,0:19:21.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemindahan ruangan ini sudah pasti?\NKok mendadak sekali...
Dialogue: 0,0:19:21.91,0:19:22.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja!
Dialogue: 0,0:19:22.76,0:19:26.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya pria itu dengan cepat\Nlangsung tanda tangan dan cap!
Dialogue: 0,0:19:26.82,0:19:27.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:19:27.86,0:19:30.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu cepat banget\Nsoal hal yang tidak perlu?!
Dialogue: 0,0:19:30.52,0:19:34.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat. Ini sudah buntu total.
Dialogue: 0,0:19:34.02,0:19:34.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo?
Dialogue: 0,0:19:34.86,0:19:37.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ume? Ada apa?
Dialogue: 0,0:19:37.08,0:19:38.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senior Terui!
Dialogue: 0,0:19:38.42,0:19:41.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya Klub Riset Robot\Nbegini, begitu...
Dialogue: 0,0:19:41.35,0:19:42.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:19:42.82,0:19:47.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu pendudukan ilegal.\NKlub riset tidak diberi ruangan.
Dialogue: 0,0:19:47.04,0:19:48.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu?!
Dialogue: 0,0:19:48.25,0:19:50.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, aku senang sekali, Asisten!
Dialogue: 0,0:19:50.88,0:19:51.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, Senior!
Dialogue: 0,0:19:51.96,0:19:55.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak disangka kita dapat ruangan\Nsebelum resmi jadi ekskul...!
Dialogue: 0,0:19:55.80,0:19:58.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, dengan ini sebagai batu loncatan,\Nkita naik status jadi ekskul
Dialogue: 0,0:19:58.55,0:20:02.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan membalas si talenan\Nyang selalu mengganggu itu!
Dialogue: 0,0:20:02.00,0:20:03.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul, Senior!
Dialogue: 0,0:20:03.20,0:20:04.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi.
Dialogue: 0,0:20:04.30,0:20:06.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke-Kenapa OSIS ada di sini?!
Dialogue: 0,0:20:06.84,0:20:09.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo. Ada sedikit urusan.
Dialogue: 0,0:20:09.02,0:20:10.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini kesempatannya!
Dialogue: 0,0:20:10.16,0:20:12.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita lampiaskan semua dendam selama ini!
Dialogue: 0,0:20:12.48,0:20:15.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be-Benar juga! Hei, Terui!
Dialogue: 0,0:20:15.51,0:20:17.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:20:18.00,0:20:18.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senior?!
Dialogue: 0,0:20:18.78,0:20:20.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sadarlah, Senior!
Dialogue: 0,0:20:21.53,0:20:22.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu ikut-ikutan?
Dialogue: 0,0:20:22.65,0:20:26.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita kan punya ruangan\Ndari Ekskul Kerajinan Tangan!
Dialogue: 0,0:20:26.20,0:20:27.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini baru permulaan, 'kan?!
Dialogue: 0,0:20:27.26,0:20:30.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga! Kita yang sudah\Npunya ruangan tak terkalahkan!
Dialogue: 0,0:20:31.75,0:20:33.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Ada perlu apa di ruangan kami?
Dialogue: 0,0:20:33.55,0:20:35.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keren, Senior!
Dialogue: 0,0:20:35.58,0:20:39.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Klub riset tidak diizinkan punya ruangan.\NSilakan keluar.
Dialogue: 0,0:20:40.20,0:20:41.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senior!
Dialogue: 0,0:20:41.30,0:20:43.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duh, merepotkan.
Dialogue: 0,0:20:43.40,0:20:44.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan mendekat!
Dialogue: 0,0:20:44.32,0:20:47.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kutekan tombol penghancur!\NKami akan melawan sampai akhir!
Dialogue: 0,0:20:49.57,0:20:51.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Ada apa?
Dialogue: 0,0:20:51.33,0:20:53.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gara-gara aku, aku...
Dialogue: 0,0:20:53.06,0:20:56.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gara-gara aku tidak becus,\Njadi ribut begini... Maaf!
Dialogue: 0,0:20:56.93,0:20:59.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa orang ini minta maaf?
Dialogue: 0,0:20:59.06,0:21:00.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia memang begitu orangnya.
Dialogue: 0,0:21:00.65,0:21:02.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana tombol penghancurnya?
Dialogue: 0,0:21:02.48,0:21:04.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau saja ruangan ini tidak ada...
Dialogue: 0,0:21:04.84,0:21:07.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Heh?! Tu-Tunggu dulu,\Naku belum siap mental!
Dialogue: 0,0:21:08.24,0:21:09.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, makin kacau saja.
Dialogue: 0,0:21:09.62,0:21:13.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau sekalian dua-duanya\Nkita bubarkan saja? Bercanda.
Dialogue: 0,0:21:13.08,0:21:14.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, jangan...
Dialogue: 0,0:21:16.55,0:21:18.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh aku bicara sebentar?
Dialogue: 0,0:21:19.84,0:21:22.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lab Kimia jadi ruangan Klub Riset Robot?
Dialogue: 0,0:21:22.46,0:21:25.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, biar aku yang bicara\Ndengan guru penanggung jawab.
Dialogue: 0,0:21:26.42,0:21:28.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be-Beneran tidak apa-apa?
Dialogue: 0,0:21:28.04,0:21:31.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Urusan izin kepala sekolah\Nlumayan repot, lo.
Dialogue: 0,0:21:31.46,0:21:34.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, ini kan gara-gara temanku.
Dialogue: 0,0:21:34.10,0:21:39.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi pasti Bu Hiratsuka\Nbakal ngomong macam-macam...
Dialogue: 0,0:21:39.42,0:21:40.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bodoh, ya.
Dialogue: 0,0:21:40.53,0:21:43.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Klub Riset Robot?
Dialogue: 0,0:21:43.00,0:21:45.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ume yang bodoh.
Dialogue: 0,0:21:45.49,0:21:48.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu... Te-Terima kasih.
Dialogue: 0,0:21:48.00,0:21:49.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama-sama.
Dialogue: 0,0:21:49.93,0:21:51.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keesokan harinya.
Dialogue: 0,0:21:51.06,0:21:53.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Di sini juga ada colokan listrik!\N- Robotnya ditaruh di sini, ya?
Dialogue: 0,0:21:53.13,0:21:55.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada meja dan kursi juga!
Dialogue: 0,0:21:55.35,0:21:57.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, jangan berisik!
Dialogue: 0,0:21:57.93,0:22:00.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial, Mizunoe, apa kubakar saja dia?
Dialogue: 0,0:22:00.34,0:22:03.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku suka barang-barang imut. Bikin tenang.
Dialogue: 0,0:22:03.57,0:22:04.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak kepanasan?
