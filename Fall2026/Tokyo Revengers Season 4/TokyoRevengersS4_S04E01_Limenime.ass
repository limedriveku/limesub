Dialogue: 0,0:03:01.97,0:03:04.01,sign,,0000,0000,0000,,{\an8}PEMAKAMAN\NMENDIANG EMMA SANO
Dialogue: 0,0:03:06.10,0:03:07.22,sign,,0000,0000,0000,,{\an8}RESEPSIONIS
Dialogue: 0,0:03:30.41,0:03:31.83,sign,,0000,0000,0000,,{\an8}MENDIANG EMMA SANO
Dialogue: 0,0:11:31.23,0:11:33.06,sign,,0000,0000,0000,,KUIL MUSASHI
Dialogue: 0,0:14:31.41,0:14:33.45,sign,,0000,0000,0000,,PEMIMPIN GENERASI PERTAMA
Dialogue: 0,0:14:44.88,0:14:46.26,sign,,0000,0000,0000,,GENG TOKYO MANJI
Dialogue: 0,0:18:27.48,0:18:30.86,sign,,0000,0000,0000,,SEPEKAN KEMUDIAN, 15 MARET 2006
Dialogue: 0,0:23:40.92,0:23:42.58,sign,,0000,0000,0000,,FAIRY TALE REVENGERS - PETIT\N#1 "KEMBALINYA MOMOTARO"
Dialogue: 0,0:24:23.75,0:24:24.83,sign,,0000,0000,0000,,{\an8}BERSAMBUNG
Dialogue: 0,0:00:01.66,0:00:03.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bagaimana jika…{\i0}
Dialogue: 0,0:00:03.62,0:00:06.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}setelah aku mengubah masa depan,{\i0}
Dialogue: 0,0:00:07.38,0:00:11.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}ada orang lain\Nyang lebih mengubahnya?{\i0}
Dialogue: 0,0:00:12.76,0:00:15.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bagaimana jika Kisaki juga\Nbisa menjelajahi waktu?{\i0}
Dialogue: 0,0:00:17.39,0:00:19.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takemitchy…
Dialogue: 0,0:00:19.56,0:00:20.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:00:21.56,0:00:23.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong… jaga… Mikey…
Dialogue: 0,0:00:24.56,0:00:25.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}demi aku…
Dialogue: 0,0:00:26.19,0:00:27.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya?
Dialogue: 0,0:00:31.78,0:00:37.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bukan kakak Shinichiro,\Nkau, atau Emma.
Dialogue: 0,0:00:38.70,0:00:40.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jawab aku, Mikey…
Dialogue: 0,0:00:41.37,0:00:44.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisakah kau menyelamatkanku?
Dialogue: 0,0:00:49.42,0:00:50.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak akan lolos!
Dialogue: 0,0:00:50.92,0:00:55.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa membiarkanmu\Nkembali ke masa depan lagi!
Dialogue: 0,0:01:00.60,0:01:03.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Kembali ke masa depan"?
Dialogue: 0,0:01:04.52,0:01:09.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pikir aku Pelompat Waktu?
Dialogue: 0,0:01:09.69,0:01:11.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan?
Dialogue: 0,0:01:11.65,0:01:12.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku…
Dialogue: 0,0:01:16.28,0:01:17.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kisaki sudah mati.{\i0}
Dialogue: 0,0:01:18.74,0:01:20.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pertarunganku sudah berakhir.{\i0}
Dialogue: 0,0:01:22.37,0:01:23.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun,{\i0}
Dialogue: 0,0:01:24.71,0:01:30.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}sejak hari kematian Kisaki,\Naku tak bisa berhenti gemetar.{\i0}
Dialogue: 0,0:03:04.01,0:03:06.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}#51 Pembubaran
Dialogue: 0,0:03:31.83,0:03:36.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Terima kasih sudah menghadiri\Npemakaman adikku, Emma, hari ini.
Dialogue: 0,0:03:37.17,0:03:40.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada tanggal 22 Februari,\Nakibat kecelakaan tak terduga,
Dialogue: 0,0:03:40.30,0:03:42.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Emma meninggal.
Dialogue: 0,0:03:42.22,0:03:45.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kepada kalian semua\Nyang membantunya sepanjang hidupnya
Dialogue: 0,0:03:45.43,0:03:47.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan hadir hari ini untuk mendoakannya,
Dialogue: 0,0:03:48.43,0:03:51.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku berterima kasih dengan tulus.
Dialogue: 0,0:03:58.86,0:04:01.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mikey tetap tenang.{\i0}
Dialogue: 0,0:04:08.91,0:04:10.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Draken.{\i0}
Dialogue: 0,0:04:16.00,0:04:17.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mencintai Emma.
Dialogue: 0,0:04:22.80,0:04:24.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku.
Dialogue: 0,0:04:24.76,0:04:27.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak bisa melindunginya.
Dialogue: 0,0:04:35.35,0:04:37.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:04:37.23,0:04:39.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kau juga mencintainya.
Dialogue: 0,0:04:42.03,0:04:44.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kini aku yakin\Ndia akan beristirahat dengan tenang.
Dialogue: 0,0:05:20.52,0:05:21.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei.
Dialogue: 0,0:05:25.24,0:05:26.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Koko.
Dialogue: 0,0:05:31.70,0:05:33.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kutempuh jalanku sendiri.
Dialogue: 0,0:05:39.04,0:05:44.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak bisa membantumu lagi,\Njadi, jangan salah jalan, ya?
Dialogue: 0,0:05:48.09,0:05:49.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai jumpa.
Dialogue: 0,0:05:51.35,0:05:52.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:05:56.27,0:05:58.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih atas semuanya.
Dialogue: 0,0:05:59.60,0:06:00.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bodoh.
Dialogue: 0,0:06:01.11,0:06:02.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kembali.
Dialogue: 0,0:06:16.12,0:06:17.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salju!
Dialogue: 0,0:06:26.01,0:06:27.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lukamu parah, ya?
Dialogue: 0,0:06:30.47,0:06:32.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau membuat apa?
Dialogue: 0,0:06:35.14,0:06:38.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beristirahatlah dengan tenang, Izana.
Dialogue: 0,0:06:54.20,0:06:58.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pembunuhan Emma Sano\Ndan Izana Kurokawa secara resmi tercatat{\i0}
Dialogue: 0,0:06:58.87,0:07:00.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}sebagai kejahatan oleh dua pelaku.{\i0}
Dialogue: 0,0:07:00.92,0:07:05.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pelaku utamanya adalah Tetta Kisaki,\Ndan kaki tangannya adalah Shuji Hanma.{\i0}
Dialogue: 0,0:07:26.57,0:07:28.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Insiden lain?
Dialogue: 0,0:07:29.53,0:07:31.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keadaan makin berbahaya belakangan ini.
Dialogue: 0,0:07:31.99,0:07:34.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Hei, Pak Tua, tolong tagihannya.\N- Baik!
Dialogue: 0,0:07:35.49,0:07:38.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cih, belakangan ini membosankan.
Dialogue: 0,0:07:39.37,0:07:41.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih atas makanannya!
Dialogue: 0,0:07:46.92,0:07:49.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga muak menjadi buronan.
Dialogue: 0,0:07:52.47,0:07:55.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Shuji Hanma terus melarikan diri.{\i0}
Dialogue: 0,0:08:06.36,0:08:08.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah. Aku mengerti.
Dialogue: 0,0:08:12.45,0:08:16.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu, dua, tiga, empat,\Nma, nam, juh, pan, lan, luh, sebelas!
Dialogue: 0,0:08:17.24,0:08:19.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat, Takemitchy?
Dialogue: 0,0:08:19.16,0:08:20.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dua belas kali!
Dialogue: 0,0:08:31.34,0:08:33.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, bisa dimaklumi.
Dialogue: 0,0:08:34.01,0:08:37.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan kepergian Emma,\NIzana Kurokawa juga tewas.
Dialogue: 0,0:08:37.72,0:08:39.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Selain itu…\N- Kisaki.
Dialogue: 0,0:08:40.60,0:08:44.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku penasaran Kisaki orang seperti apa.
Dialogue: 0,0:08:48.40,0:08:50.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku keliru.
Dialogue: 0,0:08:51.40,0:08:54.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kisaki bukan Pelompat Waktu.\N- Apa?
Dialogue: 0,0:08:54.49,0:08:58.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam satu kehidupan,\Ndia memanipulasi Toman,
Dialogue: 0,0:08:59.45,0:09:01.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}membunuh banyak orang,
Dialogue: 0,0:09:01.79,0:09:04.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan naik ke puncak geng Jepang.
Dialogue: 0,0:09:06.00,0:09:10.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah berapa malam\Nyang dihabiskannya gemetar karena itu.
Dialogue: 0,0:09:11.21,0:09:14.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia petarung yang lemah, 'kan?
Dialogue: 0,0:09:15.30,0:09:17.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia naik ke puncak\Nhanya dengan otak dan nyali.
Dialogue: 0,0:09:18.39,0:09:19.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pria yang hebat.
Dialogue: 0,0:09:20.18,0:09:21.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei! Takemitchy!
Dialogue: 0,0:09:21.85,0:09:24.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa pentingnya dia hebat atau tidak?
Dialogue: 0,0:09:24.89,0:09:26.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bajingan!
Dialogue: 0,0:09:27.31,0:09:29.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tak perlu memikirkannya.
Dialogue: 0,0:09:29.86,0:09:31.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bajingan yang pantas mati.
Dialogue: 0,0:09:32.36,0:09:33.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, maksudku…
Dialogue: 0,0:09:38.07,0:09:39.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei! Takemitchy!
Dialogue: 0,0:09:42.66,0:09:43.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takemitchy!
Dialogue: 0,0:09:50.63,0:09:52.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kau lakukan? Bodoh!
Dialogue: 0,0:09:53.30,0:09:54.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chifuyu!
Dialogue: 0,0:09:55.67,0:09:59.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat membenci Kisaki!
Dialogue: 0,0:09:59.26,0:10:01.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sulit untuk tak membencinya!
Dialogue: 0,0:10:04.14,0:10:06.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil aku bisa menyukainya, tapi…
Dialogue: 0,0:10:12.40,0:10:14.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia memberitahuku!
Dialogue: 0,0:10:14.61,0:10:16.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bilang itu semua demi Hina!
Dialogue: 0,0:10:17.28,0:10:19.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bilang dia menghormatiku!
Dialogue: 0,0:10:21.20,0:10:22.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itulah…
Dialogue: 0,0:10:22.53,0:10:23.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itulah!
Dialogue: 0,0:10:24.49,0:10:27.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau menghadapinya lagi,\Nsebagai sesama pria!
Dialogue: 0,0:10:29.92,0:10:31.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial!
Dialogue: 0,0:10:34.59,0:10:36.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bisa terkena flu, Takemitchy.
Dialogue: 0,0:10:38.55,0:10:41.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah merasa lebih baik?
Dialogue: 0,0:10:42.64,0:10:46.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku merasa aneh, Chifuyu.
Dialogue: 0,0:10:46.85,0:10:48.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Aku tahu.
Dialogue: 0,0:10:55.32,0:11:00.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejahat apa pun dia, kehilangan seseorang\Nyang kau kenal itu sulit.
Dialogue: 0,0:11:02.32,0:11:04.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bilang dia mengagumiku.
Dialogue: 0,0:11:05.95,0:11:08.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia berkata seperti itu di akhir.
Dialogue: 0,0:11:09.46,0:11:11.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengagumi orang sepertiku…
Dialogue: 0,0:11:11.54,0:11:13.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak paham\Nkenapa dia mengatakan itu, tapi…
Dialogue: 0,0:11:13.79,0:11:16.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa itu artinya\Nsetidaknya dia pandai menilai karakter.
Dialogue: 0,0:11:17.17,0:11:18.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:11:18.55,0:11:19.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lupakan saja.
Dialogue: 0,0:11:35.40,0:11:36.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mikey.
Dialogue: 0,0:11:37.03,0:11:38.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf memanggilmu kemari.
Dialogue: 0,0:11:39.36,0:11:41.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau bicara denganmu, berdua saja.
Dialogue: 0,0:11:42.49,0:11:43.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa jawab aku?
Dialogue: 0,0:11:45.53,0:11:49.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa beritahu aku apa yang kau lakukan\Nsejak datang ke sini dari masa depan?
Dialogue: 0,0:11:52.37,0:11:53.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:11:55.29,0:12:00.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awalnya, di masa depan,\Nusiaku 26 tahun dan bekerja paruh waktu.
Dialogue: 0,0:12:01.51,0:12:03.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua yang kulakukan gagal.
Dialogue: 0,0:12:04.39,0:12:07.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau lebih tepatnya, aku berhenti\Nmemedulikan semuanya.
Dialogue: 0,0:12:08.97,0:12:10.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di masa depan, kudengar di berita
Dialogue: 0,0:12:10.56,0:12:13.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bahwa Hina meninggal\Nkarena terlibat konflik terkait Toman,
Dialogue: 0,0:12:13.60,0:12:15.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang telah menjadi geng yakuza.
Dialogue: 0,0:12:16.73,0:12:19.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai saat itu,\Naku adalah tipe pria putus asa
Dialogue: 0,0:12:19.44,0:12:23.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang telah melupakan Hina, mantan pacarku.
Dialogue: 0,0:12:25.11,0:12:31.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi pada tanggal 4 Juli 2017,\Naku tertabrak kereta di Stasiun Shibuya.
Dialogue: 0,0:12:32.46,0:12:37.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira aku sudah mati,\Ntapi aku kembali ke SMP, pada tahun 2005.
Dialogue: 0,0:12:38.96,0:12:41.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu hari saat aku\Ndan teman-temanku dari SMP Mizo
Dialogue: 0,0:12:41.51,0:12:43.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dipukuli oleh Kiyomasa dan anggotanya.
Dialogue: 0,0:12:43.68,0:12:46.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada hari kami\Ndipaksa menjadi prajuritnya.
Dialogue: 0,0:12:47.51,0:12:51.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira itu adegan yang terlintas\Ndi benakku sebelum mati.
Dialogue: 0,0:12:51.93,0:12:54.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi entah kenapa, rasanya berbeda.
Dialogue: 0,0:12:57.65,0:13:03.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu setelah itu, aku bertemu Hina,\Ndan tak mungkin kubiarkan dia mati.
Dialogue: 0,0:13:04.28,0:13:05.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitulah semuanya dimulai.
Dialogue: 0,0:13:09.20,0:13:10.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sudah berapa lama kami bicara?{\i0}
Dialogue: 0,0:13:11.74,0:13:17.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mikey hanya mengangguk sesekali,\Ndiam-diam mendengarkan semua perkataanku.{\i0}
Dialogue: 0,0:13:19.21,0:13:23.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Saat berbicara, aku mengingat\Nsemua hal yang telah terjadi,{\i0}
Dialogue: 0,0:13:23.46,0:13:26.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dan aku tak bisa menghentikan\Nemosi yang membanjiriku.{\i0}
Dialogue: 0,0:13:29.89,0:13:31.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Mikey.
Dialogue: 0,0:13:32.39,0:13:38.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak bisa menyelamatkan Emma atau Baji.
Dialogue: 0,0:13:42.07,0:13:43.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku.
Dialogue: 0,0:13:43.74,0:13:44.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku…
Dialogue: 0,0:13:45.82,0:13:47.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sungguh minta maaf!
Dialogue: 0,0:13:55.20,0:13:56.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aneh.
Dialogue: 0,0:13:57.50,0:13:58.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:13:59.38,0:14:01.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kali pertama aku melihatmu,
Dialogue: 0,0:14:02.00,0:14:05.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}kau dihajar babak belur oleh Kiyomasa\Ndalam pertarungan.{\i0}
Dialogue: 0,0:14:05.88,0:14:09.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tapi kau tampak lebih kuat dari siapa pun,{\i0}
Dialogue: 0,0:14:10.47,0:14:13.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}seolah-olah kau terbiasa\Nmemikul beban berat di pundakmu.{\i0}
Dialogue: 0,0:14:14.43,0:14:17.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa kau sungguh anak SMP?{\i0}
Dialogue: 0,0:14:19.19,0:14:20.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau luar biasa.
Dialogue: 0,0:14:22.73,0:14:25.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takemitchy, kau pahlawanku.
Dialogue: 0,0:14:33.45,0:14:36.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku selalu menduga\Nbahwa akulah yang akan menciptakan "era".
Dialogue: 0,0:14:40.46,0:14:42.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bangun, Takemitchy.
Dialogue: 0,0:14:43.42,0:14:44.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau dengar itu?
Dialogue: 0,0:14:46.84,0:14:48.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Langkah kaki era baru.
Dialogue: 0,0:14:50.76,0:14:53.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau terus berjuang tanpa pernah menyerah,
Dialogue: 0,0:14:53.14,0:14:56.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berapa kali pun kau tumbang,\Ndemi menyelamatkan semua orang.
Dialogue: 0,0:14:57.06,0:14:59.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini, kau menciptakan "era" ini.
Dialogue: 0,0:15:11.86,0:15:13.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini eramu.
Dialogue: 0,0:15:19.37,0:15:20.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku sudah memutuskan.
Dialogue: 0,0:15:22.50,0:15:23.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya, dengar!
Dialogue: 0,0:15:24.17,0:15:27.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita membayar mahal,\Ntapi kita menghancurkan Tenjiku,
Dialogue: 0,0:15:27.05,0:15:29.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan Toman berdiri di puncak Jepang.
Dialogue: 0,0:15:30.34,0:15:34.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita menciptakan era yang akan\Ndiingat selama beberapa generasi.
Dialogue: 0,0:15:35.39,0:15:38.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, aku mau mengakhirinya\Nselagi kita di puncak.
Dialogue: 0,0:15:42.15,0:15:46.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai hari ini,\NGeng Tokyo Manji dibubarkan!
Dialogue: 0,0:15:49.74,0:15:53.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai hari ini,\NGeng Tokyo Manji dibubarkan!
Dialogue: 0,0:15:54.82,0:15:56.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Apa?\N- Dibubarkan?
Dialogue: 0,0:15:58.74,0:16:01.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bicara apa?
Dialogue: 0,0:16:01.62,0:16:03.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dibubarkan?
Dialogue: 0,0:16:03.00,0:16:04.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya?
Dialogue: 0,0:16:04.29,0:16:05.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inikah akhir dari Toman?
Dialogue: 0,0:16:07.50,0:16:11.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten Divisi Satu,\NTakemichi Hanagaki, maju!
Dialogue: 0,0:16:11.05,0:16:12.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kenapa?\N- Di saat seperti ini?
Dialogue: 0,0:16:12.72,0:16:14.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal kita sudah sejauh ini?
Dialogue: 0,0:16:14.26,0:16:17.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini cara terbaik\Nuntuk mengubah masa depan, 'kan?
Dialogue: 0,0:16:17.68,0:16:18.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mikey.
Dialogue: 0,0:16:18.93,0:16:20.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun…
Dialogue: 0,0:16:20.02,0:16:22.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten Divisi Dua, Takashi Mitsuya, maju!
Dialogue: 0,0:16:28.86,0:16:29.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mikey.
Dialogue: 0,0:16:30.53,0:16:33.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkat kau, Toman bisa sampai sejauh ini.
Dialogue: 0,0:16:34.49,0:16:36.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu sebentar, Mikey.
Dialogue: 0,0:16:36.20,0:16:39.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten Interim Divisi Tiga,\NRyohei Hayashi!
Dialogue: 0,0:16:41.50,0:16:44.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah bekerja keras\Nselama Pah-chin tak ada.
Dialogue: 0,0:16:44.58,0:16:47.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau kapten interim terbaik\Nyang pernah ada.
Dialogue: 0,0:16:47.17,0:16:48.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mikey.
Dialogue: 0,0:16:48.42,0:16:51.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten Divisi Empat, Nahoya Kawata!
Dialogue: 0,0:16:53.72,0:16:56.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah mendukung\NToman selama ini.
Dialogue: 0,0:16:57.09,0:16:59.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bilang begitu, Mikey.
Dialogue: 0,0:16:59.68,0:17:01.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak mau bubar.
Dialogue: 0,0:17:01.56,0:17:04.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten Divisi Lima, Yasuhiro Muto!
Dialogue: 0,0:17:04.94,0:17:07.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski dia sedang ditahan dan tak ada,
Dialogue: 0,0:17:07.15,0:17:09.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan menganggapnya\Nsebagai anggota Toman sampai akhir!
Dialogue: 0,0:17:11.23,0:17:16.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terakhir, Wakil Ketua Geng Tokyo Manji,\NKen Ryuguji.
Dialogue: 0,0:17:23.04,0:17:26.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manjiro Sano, dasar egois.
Dialogue: 0,0:17:27.00,0:17:29.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pikir kau pusat alam semesta.
Dialogue: 0,0:17:30.96,0:17:35.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi karismamu menarik kami masuk\Ndan membuat kami mengikutimu sejauh ini.
Dialogue: 0,0:17:37.13,0:17:39.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak keberatan\Ndengan keputusan pemimpin kami.
Dialogue: 0,0:17:41.47,0:17:44.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih atas semua\Nyang kau lakukan untuk kami, Ketua!
Dialogue: 0,0:17:58.91,0:18:00.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Kenchin.
Dialogue: 0,0:18:01.28,0:18:09.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Toman!
Dialogue: 0,0:18:09.75,0:18:11.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Toman bubar hari ini.
Dialogue: 0,0:18:12.09,0:18:15.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa-masa terbaik pun harus berakhir!
Dialogue: 0,0:18:15.51,0:18:17.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini adalah harinya!
Dialogue: 0,0:18:17.59,0:18:19.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi jangan lupa,
Dialogue: 0,0:18:19.05,0:18:22.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Toman akan selalu ada di hati kalian!
Dialogue: 0,0:18:38.24,0:18:39.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:18:51.63,0:18:53.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sulit kupercaya.
Dialogue: 0,0:18:54.67,0:18:57.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Toman benar-benar berakhir hari ini, ya?
Dialogue: 0,0:18:57.92,0:18:59.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:18:59.80,0:19:03.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi jika aku di posisi Mikey,\Nmungkin akan kulakukan hal yang sama.
Dialogue: 0,0:19:04.26,0:19:08.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia kehilangan banyak hal berharga.
Dialogue: 0,0:19:09.81,0:19:11.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei.
Dialogue: 0,0:19:11.77,0:19:14.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang akan kau lakukan, Takemitchy?
Dialogue: 0,0:19:14.11,0:19:15.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chifuyu.
Dialogue: 0,0:19:15.94,0:19:18.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Toman sudah berakhir.\NKisaki juga sudah pergi.
Dialogue: 0,0:19:19.28,0:19:21.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak ada alasan bagimu\Nmenetap di masa lalu, 'kan?
Dialogue: 0,0:19:21.82,0:19:23.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena Kisaki sudah mati,
Dialogue: 0,0:19:23.87,0:19:27.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Naoto, yang dibunuh Kisaki\Ndi masa depan, seharusnya masih hidup.
Dialogue: 0,0:19:28.87,0:19:31.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku bisa kembali ke masa depan.
Dialogue: 0,0:19:31.21,0:19:33.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa kini seharusnya sudah membaik.
Dialogue: 0,0:19:33.00,0:19:34.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:19:34.46,0:19:37.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin kembali\Nke masa kini secepat mungkin.
Dialogue: 0,0:19:40.68,0:19:41.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:19:41.97,0:19:45.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika aku kembali, aku takkan bisa menemui\Nsemua orang di masa lalu lagi.
Dialogue: 0,0:19:46.85,0:19:47.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:19:47.93,0:19:51.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu juga agak mengecewakan.
Dialogue: 0,0:19:51.39,0:19:52.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takemitchy.
Dialogue: 0,0:19:53.85,0:19:55.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa aku akan merindukan semua orang.
Dialogue: 0,0:19:57.78,0:19:58.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Semuanya!
Dialogue: 0,0:19:59.69,0:20:02.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana jika kita mengubur kapsul waktu\Nmenandai akhir Toman?
Dialogue: 0,0:20:02.78,0:20:05.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Apa?\N- Kapsul waktu?
Dialogue: 0,0:20:05.16,0:20:06.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:20:06.24,0:20:07.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ide bagus.
Dialogue: 0,0:20:08.66,0:20:09.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu…
Dialogue: 0,0:20:11.29,0:20:13.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mari tulis surat untuk kita di masa depan.
Dialogue: 0,0:20:13.46,0:20:14.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Surat?
Dialogue: 0,0:20:16.13,0:20:17.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba kupikir…
Dialogue: 0,0:20:19.17,0:20:20.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari buka lagi dalam 12 tahun.
Dialogue: 0,0:20:21.47,0:20:22.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam 12 tahun?
Dialogue: 0,0:20:26.39,0:20:28.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa 12 tahun?
Dialogue: 0,0:20:28.31,0:20:30.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah. Tapi kedengarannya menyenangkan.
Dialogue: 0,0:20:31.85,0:20:33.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari bertemu di sini sepekan lagi
Dialogue: 0,0:20:33.52,0:20:36.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan surat diri kalian sendiri\Ndan hal berharga bagi kalian.
Dialogue: 0,0:20:38.65,0:20:40.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kau kubur?
Dialogue: 0,0:20:40.19,0:20:43.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bodoh, kalau tahu jadi tak seru, 'kan?
Dialogue: 0,0:20:43.15,0:20:44.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dua belas tahun…
Dialogue: 0,0:20:44.24,0:20:45.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu masih lama.
Dialogue: 0,0:20:45.95,0:20:47.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa aku akan lupa\Napa yang kumasukkan.
Dialogue: 0,0:20:47.95,0:20:49.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, tepat sekali.
Dialogue: 0,0:20:49.20,0:20:51.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bagian terbaik dari kapsul waktu.
Dialogue: 0,0:20:51.58,0:20:54.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Hakkai, kau pernah melakukannya?\N- Tidak.
Dialogue: 0,0:20:54.08,0:20:56.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tapi ini cukup seru.\N- Ya.
Dialogue: 0,0:20:56.29,0:20:58.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sangat seru.
Dialogue: 0,0:21:00.96,0:21:02.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan lupa, Semuanya.
Dialogue: 0,0:21:03.42,0:21:05.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dua belas tahun lagi,\Ndi hari berdirinya Toman,
Dialogue: 0,0:21:05.89,0:21:09.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tanggal 19 Juni, mari berkumpul lagi,\Ndengan anggota yang sama.
Dialogue: 0,0:21:15.69,0:21:18.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah mengantarku.
Dialogue: 0,0:21:20.86,0:21:22.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat tinggal, Takemitchy.
Dialogue: 0,0:21:24.32,0:21:27.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua orang punya tempat masing-masing.
Dialogue: 0,0:21:28.57,0:21:30.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempatmu bukan di sini, 'kan?
Dialogue: 0,0:21:33.16,0:21:34.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, aku…
Dialogue: 0,0:21:34.25,0:21:37.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takemitchy, aku berjanji.
Dialogue: 0,0:21:38.08,0:21:40.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai bertemu lagi\N12 tahun dari sekarang,
Dialogue: 0,0:21:40.75,0:21:44.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan melindungi\Nsemua orang di Toman, termasuk Hina.
Dialogue: 0,0:21:47.05,0:21:48.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa pun yang terjadi.
Dialogue: 0,0:21:50.05,0:21:51.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mikey.
Dialogue: 0,0:21:51.89,0:21:54.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski sulit untuk berpisah,
Dialogue: 0,0:21:55.52,0:21:57.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kembalilah ke masa depan, Takemitchy.
Dialogue: 0,0:21:58.60,0:22:01.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kembali ke masa 12 tahun dari sekarang,\Ntempat Hina menunggumu.
Dialogue: 0,0:22:02.19,0:22:03.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:23:42.58,0:23:43.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Fairy Tale Revengers.{\i0}
Dialogue: 0,0:23:43.67,0:23:46.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan, ini nasi iga yang kujanjikan.
Dialogue: 0,0:23:46.00,0:23:47.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelihatannya lezat.
Dialogue: 0,0:23:47.92,0:23:50.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perjalanan yang menyenangkan, 'kan?
Dialogue: 0,0:23:54.01,0:23:56.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau berkeliling lagi dengan semuanya.
Dialogue: 0,0:23:56.72,0:23:58.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Endus-endus.
Dialogue: 0,0:23:58.39,0:24:01.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aromanya enak sekali.
Dialogue: 0,0:24:01.27,0:24:02.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian juga mau?
Dialogue: 0,0:24:03.52,0:24:04.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bolehkah?
Dialogue: 0,0:24:04.65,0:24:06.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Terima kasih!\N- Apa?
Dialogue: 0,0:24:07.23,0:24:08.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, pelan-pelan.
Dialogue: 0,0:24:08.90,0:24:10.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau makan terlalu cepat.
Dialogue: 0,0:24:11.28,0:24:12.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baru makan satu.
Dialogue: 0,0:24:14.78,0:24:16.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, itu mereka!
Dialogue: 0,0:24:16.87,0:24:17.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka tidak jera!
Dialogue: 0,0:24:17.99,0:24:20.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi-lagi mereka mencuri nasi igaku!
Dialogue: 0,0:24:20.87,0:24:22.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Aduh.\N- Kuhancurkan kalian!
Dialogue: 0,0:24:22.50,0:24:23.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}- Tunggu!\N- Hei!
Dialogue: 0,0:24:24.83,0:24:26.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Diterjemahkan oleh Lia Agatha
