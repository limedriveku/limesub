Dialogue: 0,0:23:41.00,0:23:42.08,sign,,0000,0000,0000,,FAIRY TALE REVENGERS - PETIT
Dialogue: 0,0:23:42.08,0:23:43.50,sign,,0000,0000,0000,,#3 "RENCANA KABUR BESAR\NANJING DAN KUCING!"
Dialogue: 0,0:24:24.46,0:24:25.54,sign,,0000,0000,0000,,{\an8}PERGILAH!\NBERSAMBUNG
Dialogue: 0,0:00:02.66,0:00:05.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Apa Mikey masih hidup?
Dialogue: 0,0:00:14.18,0:00:17.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mikey dan aku berpisah 12 tahun lalu.
Dialogue: 0,0:00:19.31,0:00:21.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dua belas tahun lalu.{\i0}
Dialogue: 0,0:00:21.10,0:00:23.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Setelah aku pergi untuk kembali ke sini?{\i0}
Dialogue: 0,0:00:23.44,0:00:28.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berbohong agar kau\Nmenjalani hidup yang layak.
Dialogue: 0,0:00:28.94,0:00:30.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan salahkan Chifuyu, ya?
Dialogue: 0,0:00:30.73,0:00:33.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memohon agar dia mengikuti ceritaku.
Dialogue: 0,0:00:35.45,0:00:36.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takemitchy.
Dialogue: 0,0:00:36.78,0:00:38.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya?
Dialogue: 0,0:00:38.28,0:00:40.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan mencari informasi soal Mikey.
Dialogue: 0,0:00:40.37,0:00:41.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:00:43.29,0:00:44.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang itu...
Dialogue: 0,0:00:45.29,0:00:48.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Terakhir aku bertemu Mikey, 12 tahun lalu{\i0}...
Dialogue: 0,0:00:51.00,0:00:54.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bukan orang yang kukenal.
Dialogue: 0,0:01:13.99,0:01:16.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Naoto.
Dialogue: 0,0:01:16.15,0:01:18.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, kau menyelamatkan hidupku.
Dialogue: 0,0:01:18.82,0:01:20.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya ini bisa kulakukan.
Dialogue: 0,0:01:23.12,0:01:24.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini berkas soal Bonten.
Dialogue: 0,0:01:25.54,0:01:27.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti dugaanmu.
Dialogue: 0,0:01:27.67,0:01:30.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu organisasi seperti Toman dahulu,
Dialogue: 0,0:01:30.04,0:01:31.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebelum masa depan kau ubah.
Dialogue: 0,0:01:32.13,0:01:35.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bonten adalah organisasi kriminal\Nterbesar di Jepang.{\i0}
Dialogue: 0,0:01:35.55,0:01:39.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Judi, penipuan, prostitusi, pembunuhan.{\i0}
Dialogue: 0,0:01:39.05,0:01:42.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Konon, Bonten berperan\Ndi balik semua jenis kejahatan.{\i0}
Dialogue: 0,0:01:42.72,0:01:46.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tapi bahkan polisi tak punya\Ngambaran lengkapnya.{\i0}
Dialogue: 0,0:01:48.56,0:01:53.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skala dan kekejamannya tampaknya melampaui\NGeng Tokyo Manji dahulu.
Dialogue: 0,0:01:55.03,0:01:59.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dan pemimpin geng itu\Nadalah pria berambut putih.{\i0}
Dialogue: 0,0:02:00.28,0:02:02.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Izana Kurokawa?
Dialogue: 0,0:02:02.53,0:02:07.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Izana Kurokawa meninggal 12 tahun lalu.
Dialogue: 0,0:02:07.62,0:02:09.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pria berambut putih itu...
Dialogue: 0,0:02:10.25,0:02:11.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah Mikey yang Perkasa.
Dialogue: 0,0:02:11.75,0:02:12.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:02:13.88,0:02:18.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ketua Bonten adalah mantan ketua\NGeng Tokyo Manji, Manjiro Sano.{\i0}
Dialogue: 0,0:03:58.78,0:04:03.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}#53 Tersenyum lebar
Dialogue: 0,0:04:03.82,0:04:06.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biarkan para pengkhianat\Nmerasakan tinju besi Bonten!
Dialogue: 0,0:04:18.25,0:04:21.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengar. Mikey ingin mengatakan sesuatu.
Dialogue: 0,0:04:28.60,0:04:29.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bunuh mereka.
Dialogue: 0,0:04:50.41,0:04:52.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Yang tak patuh pada Bonten
Dialogue: 0,0:04:52.20,0:04:54.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}hanyalah sampah di tumpukan rongsokan!
Dialogue: 0,0:04:55.92,0:04:57.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Bersihkan dengan baik.
Dialogue: 0,0:04:59.00,0:05:00.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Hancurkan jasadnya jadi pakan ikan.
Dialogue: 0,0:05:07.51,0:05:11.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Jangan lupakan itu. Jika ada pengkhianat\NBonten, kita juga akan hancur!
Dialogue: 0,0:05:13.48,0:05:15.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitulah cara kerja Bonten.
Dialogue: 0,0:05:23.15,0:05:25.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mikey kepala organisasi kriminal?
Dialogue: 0,0:05:25.95,0:05:27.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Aku sangat yakin.
Dialogue: 0,0:05:29.83,0:05:31.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mikey?{\i0}
Dialogue: 0,0:05:31.99,0:05:36.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita menciptakan era yang akan\Ndiingat selama beberapa generasi.
Dialogue: 0,0:05:37.00,0:05:40.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, aku mau mengakhirinya\Nselagi kita di puncak.
Dialogue: 0,0:05:41.29,0:05:45.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai hari ini,\NGeng Tokyo Manji dibubarkan!
Dialogue: 0,0:05:46.30,0:05:48.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Ini cara terbaik\Nuntuk mengubah masa depan, 'kan?
Dialogue: 0,0:05:49.51,0:05:52.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mikey yang membubarkan Toman,{\i0}
Dialogue: 0,0:05:52.68,0:05:57.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}meski itu sangat berarti baginya?{\i0}
Dialogue: 0,0:05:58.40,0:05:59.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berjanji.
Dialogue: 0,0:05:59.98,0:06:02.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai bertemu lagi\N12 tahun dari sekarang,
Dialogue: 0,0:06:02.27,0:06:06.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan melindungi\Nsemua orang di Toman, termasuk Hina.
Dialogue: 0,0:06:07.24,0:06:08.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil.
Dialogue: 0,0:06:08.57,0:06:11.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil Mikey menjadi orang seperti itu.
Dialogue: 0,0:06:12.24,0:06:14.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudmu, informasiku salah?
Dialogue: 0,0:06:17.50,0:06:18.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berdasarkan apa?
Dialogue: 0,0:06:18.87,0:06:22.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah, tapi mustahil...
Dialogue: 0,0:06:22.67,0:06:24.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku paham kau tak mau memercayainya, tapi...
Dialogue: 0,0:06:24.96,0:06:26.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus menemui Mikey.
Dialogue: 0,0:06:27.47,0:06:31.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takemichi, apa kau sadar\Nbetapa berbahayanya itu?
Dialogue: 0,0:06:31.93,0:06:33.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengarkan aku.
Dialogue: 0,0:06:33.18,0:06:36.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau meremehkan perubahan dalam 12 tahun.
Dialogue: 0,0:06:36.02,0:06:39.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manjiro Sano saat ini\Nbukanlah orang yang kau kenal.
Dialogue: 0,0:06:41.19,0:06:44.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bukan pria yang dahulu kukenal.
Dialogue: 0,0:06:48.82,0:06:49.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jabat tanganku.
Dialogue: 0,0:06:50.74,0:06:51.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau ke masa lalu.
Dialogue: 0,0:06:51.99,0:06:54.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudmu?
Dialogue: 0,0:06:54.78,0:06:59.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kutemui Mikey di masa lalu.\NAku mau tahu pendapatnya yang sebenarnya.
Dialogue: 0,0:06:59.75,0:07:01.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sadarlah!
Dialogue: 0,0:07:01.46,0:07:03.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakakku selamat.
Dialogue: 0,0:07:03.17,0:07:05.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau dan aku sudah melakukan\Napa yang kita rencanakan!
Dialogue: 0,0:07:06.42,0:07:10.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau dan Manjiro Sano\Nbukan kenalan yang baik sejak awal.
Dialogue: 0,0:07:10.30,0:07:12.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau memedulikan pria seperti itu?
Dialogue: 0,0:07:12.68,0:07:14.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong lanjutkan saja hidupmu.
Dialogue: 0,0:07:14.64,0:07:17.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hiduplah bahagia bersama kakakku!
Dialogue: 0,0:07:17.68,0:07:18.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Naoto...
Dialogue: 0,0:07:22.40,0:07:24.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takemitchy, kau pahlawanku.
Dialogue: 0,0:07:28.23,0:07:29.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bukan karena Mikey...
Dialogue: 0,0:07:30.61,0:07:35.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanpa dia, aku takkan\Nmenjadi diriku yang sekarang.
Dialogue: 0,0:07:42.75,0:07:43.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon.
Dialogue: 0,0:07:44.58,0:07:46.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan segera kembali.
Dialogue: 0,0:07:56.14,0:07:57.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:07:57.60,0:07:59.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi cepatlah.
Dialogue: 0,0:07:59.72,0:08:01.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berjanjilah kepadaku.
Dialogue: 0,0:08:01.60,0:08:03.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Naoto.
Dialogue: 0,0:08:04.23,0:08:07.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejujurnya, aku tak bisa menang darimu.
Dialogue: 0,0:08:17.70,0:08:21.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Kita sudah berjabat tangan,\Ntapi aku tak menjelajah waktu.
Dialogue: 0,0:08:21.66,0:08:22.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa tidak?
Dialogue: 0,0:08:23.50,0:08:24.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:08:24.96,0:08:26.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Kenapa?
Dialogue: 0,0:08:26.42,0:08:28.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa begini, Naoto?
Dialogue: 0,0:08:28.80,0:08:34.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takemichi, aku tak ingin\Nmengubah keadaan terkini di masa depan.
Dialogue: 0,0:08:36.26,0:08:40.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Artinya, aku tak bisa menjadi pemicu\Nuntuk Lompatan Waktu lagi.
Dialogue: 0,0:08:40.60,0:08:42.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peranku sudah selesai.
Dialogue: 0,0:08:42.48,0:08:43.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:08:46.35,0:08:47.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini hanya hipotesis,
Dialogue: 0,0:08:48.48,0:08:53.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi mungkin kau tak bisa menjadi pemicu\Nkecuali sungguh mau mengubah masa lalu.
Dialogue: 0,0:08:55.16,0:08:56.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana mungkin...
Dialogue: 0,0:09:01.04,0:09:05.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, itu artinya kau tak bisa\Nmenjelajah waktu lagi?
Dialogue: 0,0:09:05.37,0:09:06.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:09:07.25,0:09:08.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh.
Dialogue: 0,0:09:09.25,0:09:12.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa kita sudah menyelamatkan Hina.
Dialogue: 0,0:09:12.05,0:09:15.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kurasa itu masuk akal.
Dialogue: 0,0:09:15.72,0:09:21.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chifuyu, aku mau bertemu Mikey.\NAku mau berbicara dengannya.
Dialogue: 0,0:09:21.22,0:09:23.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tahu, 'kan, Chifuyu?
Dialogue: 0,0:09:24.60,0:09:29.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa Mikey memilih jalan\Nyang buruk lagi?
Dialogue: 0,0:09:29.56,0:09:32.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tepat setelah aku kembali ke sini,\N12 tahun lalu...
Dialogue: 0,0:09:33.19,0:09:34.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari sudut pandangmu,
Dialogue: 0,0:09:34.69,0:09:38.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}baru kemarin kau masih\Nbersama Mikey yang lama.
Dialogue: 0,0:09:39.16,0:09:42.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejujurnya, tak ada tanda-tanda\Ndia akan melakukan hal seperti ini.
Dialogue: 0,0:09:44.33,0:09:49.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah Mikey menghilang,\Naku juga mencarinya ke mana-mana.
Dialogue: 0,0:09:51.42,0:09:54.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi pada akhirnya,\Naku tak pernah menemukan apa pun.
Dialogue: 0,0:09:54.84,0:09:56.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kuputuskan\Nuntuk berpikir seperti ini.
Dialogue: 0,0:09:57.68,0:10:00.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mikey pasti menemukan jalannya sendiri.
Dialogue: 0,0:10:01.64,0:10:03.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu pilihannya sendiri.
Dialogue: 0,0:10:05.68,0:10:09.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kuputuskan\Nuntuk menjalani hidupku sendiri juga.
Dialogue: 0,0:10:09.69,0:10:11.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chifuyu...
Dialogue: 0,0:10:14.48,0:10:16.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bukan anak-anak lagi.
Dialogue: 0,0:10:16.78,0:10:21.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini, kau punya jalan penting\Nuntuk membahagiakan Hina.
Dialogue: 0,0:10:21.74,0:10:23.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sadarlah, Takemitchy.
Dialogue: 0,0:10:29.92,0:10:32.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mungkin Chifuyu benar.{\i0}
Dialogue: 0,0:10:33.17,0:10:36.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jika aku tak bisa menjelajah waktu lagi,\Ntak ada yang bisa kulakukan.{\i0}
Dialogue: 0,0:10:37.72,0:10:41.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jika aku bisa kembali, mungkin\Nsecara tak sengaja kurenggut{\i0}
Dialogue: 0,0:10:41.43,0:10:44.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}kebahagiaan semua orang di masa kini.{\i0}
Dialogue: 0,0:10:46.27,0:10:48.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jalanku sendiri, ya.{\i0}
Dialogue: 0,0:10:51.35,0:10:53.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kita berdua sudah dewasa sekarang.{\i0}
Dialogue: 0,0:10:54.19,0:10:56.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku tak berhak ikut campur.{\i0}
Dialogue: 0,0:11:02.70,0:11:03.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun...{\i0}
Dialogue: 0,0:11:04.99,0:11:06.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tak bisa mengabaikan Mikey.
Dialogue: 0,0:11:10.04,0:11:11.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kazutora?
Dialogue: 0,0:11:11.92,0:11:13.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seolah-olah waktu berhenti bagiku
Dialogue: 0,0:11:14.50,0:11:17.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}saat aku dipenjara\Nselama lebih dari sepuluh tahun.
Dialogue: 0,0:11:18.51,0:11:21.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya aku kembali setelah sekian lama.\NTapi Toman bubar.
Dialogue: 0,0:11:22.18,0:11:24.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mikey tak ada.\NNamun, semua orang masih tersenyum.
Dialogue: 0,0:11:25.64,0:11:27.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku merasa seperti Taro Urashima.
Dialogue: 0,0:11:28.98,0:11:32.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi itu kenapa aku memahami sesuatu\Nyang tak dipahami orang lain.
Dialogue: 0,0:11:32.73,0:11:34.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mikey belum berubah.
Dialogue: 0,0:11:35.57,0:11:38.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tipe pria yang tak bisa\Nmenunjukkan kelemahannya kepada siapa pun.
Dialogue: 0,0:11:38.90,0:11:40.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia memikul semuanya sendiri.
Dialogue: 0,0:11:41.24,0:11:43.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ya, benar.{\i0}
Dialogue: 0,0:11:43.74,0:11:47.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cara hidup Mikey sekarang\Nbukan jalan yang dia pilih sendiri.
Dialogue: 0,0:11:48.91,0:11:52.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan membantumu,\NTakemichi Hanagaki.
Dialogue: 0,0:11:52.83,0:11:56.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kalau begitu,\Nkita harus mencarinya sendiri.{\i0}
Dialogue: 0,0:11:57.05,0:12:00.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Haruskah kita mulai\Ndengan melacak semua wajah lama?
Dialogue: 0,0:12:00.47,0:12:01.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:12:02.51,0:12:04.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Meski aku tak bisa kembali ke masa lalu,{\i0}
Dialogue: 0,0:12:04.47,0:12:07.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}kita bisa mencari Mikey di sini,\Ndi masa kini.{\i0}
Dialogue: 0,0:12:07.22,0:12:10.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya ingin menemuinya.
Dialogue: 0,0:12:10.68,0:12:13.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Selama apa pun itu...{\i0}
Dialogue: 0,0:12:13.02,0:12:14.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:12:16.52,0:12:21.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Sudah dua setengah bulan\Ndan kita masih belum punya petunjuk.
Dialogue: 0,0:12:21.24,0:12:24.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mulai mempertanyakan\Napakah dia masih hidup.
Dialogue: 0,0:12:24.70,0:12:28.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita juga belum dapat petunjuk\Nsoal anggota inti lainnya.
Dialogue: 0,0:12:28.37,0:12:31.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena ini sangat berisiko,\Nkurasa bantuanmu cukup, Akkun.
Dialogue: 0,0:12:31.29,0:12:33.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampaikan kepada anggota SMP Mizo lainnya.
Dialogue: 0,0:12:33.54,0:12:34.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan khawatir.
Dialogue: 0,0:12:34.87,0:12:37.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yamagishi melakukannya secara sukarela.
Dialogue: 0,0:12:37.75,0:12:39.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu. Kau tak menyerah, 'kan?
Dialogue: 0,0:12:39.46,0:12:40.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:12:40.96,0:12:45.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama apa pun itu,\Naku berjanji akan menemukan Mikey.
Dialogue: 0,0:12:45.97,0:12:49.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Setelah berkali-kali menjelajah waktu,\Nada satu hal yang kupelajari.{\i0}
Dialogue: 0,0:12:50.68,0:12:52.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Selama aku tak menyerah, semuanya lancar.{\i0}
Dialogue: 0,0:12:57.56,0:13:00.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Hei, Takemitchy.\NAku baru kembali ke Jepang.{\i0}
Dialogue: 0,0:13:00.94,0:13:02.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang kembali.
Dialogue: 0,0:13:02.99,0:13:05.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, besok hari besarnya.
Dialogue: 0,0:13:05.03,0:13:06.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa? Ada apa besok?{\i0}
Dialogue: 0,0:13:06.61,0:13:09.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tanggal 19 Juni.\N- {\i1}Apa?{\i0}
Dialogue: 0,0:13:09.95,0:13:12.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari kita membuka kapsul waktu.
Dialogue: 0,0:13:16.42,0:13:17.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}- Kau kubur apa?\N- Bodoh,
Dialogue: 0,0:13:17.79,0:13:19.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}kalau tahu jadi tak seru, 'kan?
Dialogue: 0,0:13:19.92,0:13:21.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Dua belas tahun...
Dialogue: 0,0:13:21.13,0:13:22.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu masih lama.
Dialogue: 0,0:13:22.63,0:13:24.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa aku akan lupa isinya.
Dialogue: 0,0:13:24.51,0:13:25.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, tepat sekali.
Dialogue: 0,0:13:25.76,0:13:28.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bagian terbaik dari kapsul waktu.
Dialogue: 0,0:13:28.64,0:13:30.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan lupa, Semuanya.
Dialogue: 0,0:13:30.18,0:13:32.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dua belas tahun lagi,\Ndi hari berdirinya Toman,
Dialogue: 0,0:13:33.02,0:13:36.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tanggal 19 Juni, mari berkumpul lagi,\Ndengan anggota yang sama.
Dialogue: 0,0:13:47.53,0:13:52.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Hari itu, bahkan setelah malam tiba,\NMikey tak muncul sama sekali.{\i0}
Dialogue: 0,0:13:55.87,0:13:57.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa boleh buat.
Dialogue: 0,0:13:57.62,0:13:59.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita buka.
Dialogue: 0,0:14:01.25,0:14:03.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dingin sekali.
Dialogue: 0,0:14:03.42,0:14:05.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanpa kabar dalam sepuluh tahun,
Dialogue: 0,0:14:05.34,0:14:07.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan kini dia juga melupakan hari ini.
Dialogue: 0,0:14:07.72,0:14:12.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat gali. Aku juga mau melihat isinya.
Dialogue: 0,0:14:12.26,0:14:14.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kumasukkan, ya?
Dialogue: 0,0:14:14.56,0:14:17.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kau ingat, Taka?\N- Lumayan.
Dialogue: 0,0:14:17.06,0:14:19.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang benar? Aku tak tahu sama sekali!
Dialogue: 0,0:14:19.77,0:14:22.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Baik, mari kita gali.\N- Ya.
Dialogue: 0,0:14:29.91,0:14:31.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Wah, kangen juga.
Dialogue: 0,0:14:31.78,0:14:33.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Apa? Buku tentang pesawat?
Dialogue: 0,0:14:33.74,0:14:37.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Ya, saat itu impianku\Nadalah menjadi pilot.
Dialogue: 0,0:14:39.12,0:14:40.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Impian kekanak-kanakan!
Dialogue: 0,0:14:40.54,0:14:43.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Kita memang masih anak-anak saat itu.
Dialogue: 0,0:14:43.71,0:14:47.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya impianmu sehebat apa?
Dialogue: 0,0:14:47.05,0:14:49.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan terkejut saat melihatnya.
Dialogue: 0,0:14:49.47,0:14:50.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bahkan tak ingat.
Dialogue: 0,0:14:53.93,0:14:57.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh? Itu impian pasaran anak SD.
Dialogue: 0,0:14:57.43,0:14:58.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luar angkasa?
Dialogue: 0,0:14:58.52,0:15:01.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau menulis begitu tanpa mengusahakannya.
Dialogue: 0,0:15:02.19,0:15:04.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sendiri bagaimana, Taka?
Dialogue: 0,0:15:04.57,0:15:07.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunjukkan masa lalumu\Nyang memalukan! Ayolah!
Dialogue: 0,0:15:07.69,0:15:09.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini isi kapsulku.
Dialogue: 0,0:15:09.11,0:15:10.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak mungkin, Taka!
Dialogue: 0,0:15:10.74,0:15:13.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bilang kau tak bisa tidur\Ntanpa memeluk boneka hewan?
Dialogue: 0,0:15:13.62,0:15:14.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bodoh!
Dialogue: 0,0:15:16.16,0:15:21.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}"Untuk diriku di masa depan,\Njangan lupa di mana kau memulai."
Dialogue: 0,0:15:21.21,0:15:26.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami miskin, jadi aku tak bisa membeli\Nmainan untuk Luna dan Mana.
Dialogue: 0,0:15:27.34,0:15:30.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini boneka hewan pertama\Nyang kubuat untuk mereka.
Dialogue: 0,0:15:32.55,0:15:36.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membuat hal seperti ini\Nmembuatku suka menjahit,
Dialogue: 0,0:15:36.26,0:15:40.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku mulai berpikir ingin bekerja\Nmembuat pakaian suatu hari nanti.
Dialogue: 0,0:15:41.85,0:15:43.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dilihat sekarang, ini cukup jelek.
Dialogue: 0,0:15:44.23,0:15:48.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kami tak miskin, mungkin aku\Ntakkan jadi diriku yang sekarang.
Dialogue: 0,0:15:50.07,0:15:52.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taka, keren sekali.
Dialogue: 0,0:15:53.45,0:15:54.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}"Kau populer, tidak?
Dialogue: 0,0:15:54.66,0:15:57.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Bekerja sebagai penghibur\Ndengan rambut terurai halus?"
Dialogue: 0,0:15:57.74,0:15:59.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Percaya ini, tidak?
Dialogue: 0,0:15:59.20,0:16:01.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Apa ini? Ada produk pengeriting rambut.
Dialogue: 0,0:16:01.87,0:16:05.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kau selalu mau rambut lurus\Ndan lembut, 'kan?
Dialogue: 0,0:16:10.63,0:16:12.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa Angry baru saja tersenyum?
Dialogue: 0,0:16:13.13,0:16:14.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Kepada Pah-chin.
Dialogue: 0,0:16:14.84,0:16:17.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah setengah tahun sejak kau\Ndikirim ke penjara remaja,
Dialogue: 0,0:16:17.89,0:16:21.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan rasanya seperti ada lubang di hatiku.
Dialogue: 0,0:16:21.73,0:16:25.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepatlah keluar agar kita bisa\Nmenjadi orang bodoh bersama lagi.
Dialogue: 0,0:16:25.56,0:16:26.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ryohei Hayashi.
Dialogue: 0,0:16:27.77,0:16:31.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}NB, kumasukkan juga majalah dewasa\Nyang sangat kau sukai."
Dialogue: 0,0:16:31.65,0:16:34.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini hal terbaik yang pernah ada!
Dialogue: 0,0:16:34.70,0:16:37.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bawa pulang tanpa diketahui istrimu.
Dialogue: 0,0:16:37.33,0:16:39.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pria yang beruntung!
Dialogue: 0,0:16:45.33,0:16:47.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Draken, apa yang kau masukkan?
Dialogue: 0,0:16:50.96,0:16:53.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ini.\N- Ini saat Toman dibubarkan.
Dialogue: 0,0:16:54.97,0:16:57.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Untuk diriku di masa depan.
Dialogue: 0,0:16:57.01,0:16:58.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ken Ryuguji.
Dialogue: 0,0:16:59.60,0:17:00.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau baik-baik saja?
Dialogue: 0,0:17:01.43,0:17:03.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih sangat menyukai sepeda motor?
Dialogue: 0,0:17:04.10,0:17:05.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah menikah?
Dialogue: 0,0:17:05.94,0:17:07.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau punya anak?
Dialogue: 0,0:17:08.02,0:17:11.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih diseret-seret oleh Mikey,\Nseperti biasa?
Dialogue: 0,0:17:14.20,0:17:17.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sedang berada di persimpangan hidup.
Dialogue: 0,0:17:17.70,0:17:19.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Toman dibubarkan.
Dialogue: 0,0:17:20.49,0:17:22.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak keberatan dengan keputusan bos.
Dialogue: 0,0:17:22.95,0:17:27.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu yang kukatakan di depan semua orang,\Ntapi sebenarnya, aku menyesalinya.
Dialogue: 0,0:17:27.71,0:17:30.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Toman adalah segalanya bagiku.
Dialogue: 0,0:17:30.38,0:17:32.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin semuanya\Nmerasakan hal yang sama.
Dialogue: 0,0:17:34.09,0:17:35.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menderita karenanya.
Dialogue: 0,0:17:36.30,0:17:37.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menangis.
Dialogue: 0,0:17:38.39,0:17:42.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku tahu Mikey lebih menderita.
Dialogue: 0,0:17:45.48,0:17:49.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kutinggalkan\Nsemua penyesalanku di sini.
Dialogue: 0,0:17:49.94,0:17:54.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan saat kau tua\Ndan berada di jalan yang benar,
Dialogue: 0,0:17:54.11,0:17:57.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bahkan jika kau lupa segalanya\Nsoal dirimu saat muda,
Dialogue: 0,0:17:57.03,0:17:59.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jangan lupakan satu hal ini.
Dialogue: 0,0:18:01.03,0:18:06.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahwa kau selalu punya Emma di sisimu."
Dialogue: 0,0:18:13.55,0:18:17.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia akhirnya tak muncul, tapi...
Dialogue: 0,0:18:19.34,0:18:21.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari buka suratnya juga.
Dialogue: 0,0:18:25.06,0:18:27.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari tulis surat untuk kita di masa depan.
Dialogue: 0,0:18:28.14,0:18:29.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku ingin tahu!{\i0}
Dialogue: 0,0:18:29.27,0:18:33.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa yang Mikey pikirkan\Nsaat mengatakannya di hari itu?{\i0}
Dialogue: 0,0:18:34.32,0:18:37.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mungkin ada petunjuk di sini\Nsoal keberadaannya sekarang.{\i0}
Dialogue: 0,0:18:39.53,0:18:43.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Untuk diriku di masa depan. Manjiro Sano.
Dialogue: 0,0:18:44.08,0:18:45.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah dua belas tahun, ya?
Dialogue: 0,0:18:45.91,0:18:47.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku penasaran apa yang akan kulakukan.
Dialogue: 0,0:18:48.50,0:18:50.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sulit kubayangkan."
Dialogue: 0,0:18:50.75,0:18:54.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mitsuya pasti terjun ke dunia mode.{\i0}
Dialogue: 0,0:18:55.80,0:19:00.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku yakin dia bekerja di tempat modis,\Nmembuat banyak pakaian keren.{\i0}
Dialogue: 0,0:19:00.22,0:19:01.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Hakkai amat sayang Mitsuya,{\i0}
Dialogue: 0,0:19:01.64,0:19:03.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}mungkin dia bekerja di industri yang sama.{\i0}
Dialogue: 0,0:19:04.43,0:19:06.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mungkin dia selalu\Nberkeliaran di tempat Mitsuya.{\i0}
Dialogue: 0,0:19:06.93,0:19:10.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pah-chin pasti mengambil alih\Nbisnis properti ayahnya.{\i0}
Dialogue: 0,0:19:11.10,0:19:12.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia selalu mengaguminya.{\i0}
Dialogue: 0,0:19:13.19,0:19:15.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Peh-yan adalah tangan kanan Pah-chin.{\i0}
Dialogue: 0,0:19:15.44,0:19:17.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ya, Pah butuh Peh, pasti.{\i0}
Dialogue: 0,0:19:19.45,0:19:20.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Smiley...{\i0}
Dialogue: 0,0:19:22.28,0:19:25.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia agak aneh, jadi, mungkin dia\Nmerencanakan hal gila.{\i0}
Dialogue: 0,0:19:25.03,0:19:28.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tapi Angry mendukungnya, jadi,\Ndia mungkin akan baik-baik saja.{\i0}
Dialogue: 0,0:19:28.29,0:19:29.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya aku yang dikritik.
Dialogue: 0,0:19:29.91,0:19:32.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Hanya satu jawaban untuk Ken.{\i0}
Dialogue: 0,0:19:32.25,0:19:33.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pasti bengkel sepeda motor.{\i0}
Dialogue: 0,0:19:33.88,0:19:36.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku yang paling mengenalnya.{\i0}
Dialogue: 0,0:19:36.88,0:19:38.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kalau Chifuyu, pasti terkait Baji.{\i0}
Dialogue: 0,0:19:39.59,0:19:42.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia takkan melupakan Baji,\Ndia pasti mengenangnya.{\i0}
Dialogue: 0,0:19:43.97,0:19:45.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Takemitchy.
Dialogue: 0,0:19:45.43,0:19:48.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau kau tak bisa membahagiakan Hina,\Naku akan membunuhmu.
Dialogue: 0,0:19:50.02,0:19:52.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membubarkan Toman bukan hanya untukmu.
Dialogue: 0,0:19:53.60,0:19:55.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu untuk semua orang.
Dialogue: 0,0:19:55.65,0:20:00.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang kalian butuhkan untuk menjadi dewasa\Nbukan sesuatu yang bisa diberikan Toman.
Dialogue: 0,0:20:00.86,0:20:04.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kalian semua,\Ncarilah yang kalian butuhkan.
Dialogue: 0,0:20:05.24,0:20:07.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku juga akan melakukan\Npencarian yang sama.{\i0}
Dialogue: 0,0:20:08.33,0:20:11.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku mungkin takkan pernah\Nbertemu kalian lagi."{\i0}
Dialogue: 0,0:20:16.38,0:20:19.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau yakin soal ini?\NHari ini tanggal 19 Juni.
Dialogue: 0,0:20:20.30,0:20:22.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Tak apa-apa.
Dialogue: 0,0:20:25.93,0:20:28.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}"Tapi kalian tahu, 'kan?{\i0}
Dialogue: 0,0:20:29.97,0:20:33.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejauh apa pun kita terpisah,\Nkita masih terhubung."
Dialogue: 0,0:20:39.15,0:20:41.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terpisah, tapi masih terhubung.
Dialogue: 0,0:20:41.40,0:20:44.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin itu artinya tumbuh dewasa.
Dialogue: 0,0:20:44.61,0:20:47.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perjalanan untuk menemukan\Napa yang kita butuhkan.
Dialogue: 0,0:20:47.37,0:20:51.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, sekarang,\Nkita berada di tengah perjalanan itu.
Dialogue: 0,0:20:51.20,0:20:54.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untunglah aku datang ke sini hari ini.
Dialogue: 0,0:20:55.33,0:21:01.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku punya firasat buruk soal Mikey\Nkarena dia tiba-tiba menghilang.
Dialogue: 0,0:21:01.09,0:21:06.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi meski terpisah, dia pasti\Nmemikirkan kita di suatu tempat.
Dialogue: 0,0:21:07.05,0:21:09.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Kau benar.
Dialogue: 0,0:21:11.14,0:21:14.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama kita terus memikirkannya,\Nkita tetap terhubung.
Dialogue: 0,0:21:15.44,0:21:19.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mungkin memaksakan pencarian Mikey\Ntak ada gunanya.{\i0}
Dialogue: 0,0:21:22.03,0:21:25.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Meski kita semua terpisah-pisah,\Nhati kita masih satu.{\i0}
Dialogue: 0,0:21:25.65,0:21:28.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, saatnya aku menuju\Nmasa depan juga.
Dialogue: 0,0:21:32.12,0:21:33.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Jahat sekali!
Dialogue: 0,0:21:33.25,0:21:35.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian semua pergi\Ntanpa melihat punyaku!
Dialogue: 0,0:21:36.04,0:21:38.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejujurnya, aku juga lupa.
Dialogue: 0,0:21:39.08,0:21:40.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa, ya?
Dialogue: 0,0:21:40.88,0:21:43.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Kuharap semua orang\Nmenemukan kebahagiaan."
Dialogue: 0,0:21:44.55,0:21:46.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu saja?
Dialogue: 0,0:21:46.88,0:21:49.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin memang lebih baik\Nsemua orang lupa.
Dialogue: 0,0:21:54.39,0:21:56.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini? Kaset video?
Dialogue: 0,0:21:57.81,0:21:59.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku yang memasukkannya di sini?
Dialogue: 0,0:23:45.50,0:23:47.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kau baik-baik saja?
Dialogue: 0,0:23:47.80,0:23:51.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka hanya bersantai\Nsementara kita terpaksa bekerja.
Dialogue: 0,0:23:52.64,0:23:53.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei.
Dialogue: 0,0:23:54.35,0:23:57.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian berdua, pergilah ke kota\Ndan cari uang.
Dialogue: 0,0:23:57.85,0:23:59.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu artinya...
Dialogue: 0,0:23:59.27,0:24:01.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kesempatan untuk kabur?{\i0}
Dialogue: 0,0:24:01.31,0:24:06.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memotong kayu saja tak cukup,\Npikirkan cara lain menghasilkan uang.
Dialogue: 0,0:24:06.69,0:24:09.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, itu keahlian kami!
Dialogue: 0,0:24:09.61,0:24:11.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak sabar untuk memulai.
Dialogue: 0,0:24:11.28,0:24:12.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, benar.
Dialogue: 0,0:24:12.70,0:24:15.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Baik, pakai ini.\N- Apa?
Dialogue: 0,0:24:15.95,0:24:19.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini cukup untuk menjangkau dari sini\Nke kota, tak masalah.
Dialogue: 0,0:24:19.20,0:24:20.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Berapa panjang tali ini?{\i0}
Dialogue: 0,0:24:21.29,0:24:24.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Jika kalian mencoba kabur,\Nkalian tahu apa yang akan terjadi, 'kan?
Dialogue: 0,0:24:25.54,0:24:27.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Diterjemahkan oleh Lia Agatha
