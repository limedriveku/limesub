Dialogue: 0,0:13:15.04,0:13:16.42,sign,,0000,0000,0000,,{\an8}15 MARET 2006
Dialogue: 0,0:13:45.24,0:13:47.53,sign,,0000,0000,0000,,{\an8}19 JUNI 2018
Dialogue: 0,0:14:27.61,0:14:28.91,sign,,0000,0000,0000,,MAJALAH BULANAN\NACE PILOT
Dialogue: 0,0:14:50.97,0:14:53.93,sign,,0000,0000,0000,,{\an8}HAKKAI SHIBA, 12 TAHUN LAGI\NKAU JADI ASTRONOT?
Dialogue: 0,0:15:52.11,0:15:53.45,sign,,0000,0000,0000,,{\an8}PROFESIONAL\NRAMBUT HALUS - LURUS
Dialogue: 0,0:16:06.04,0:16:07.92,sign,,0000,0000,0000,,{\an8}SEMOGA SMILEY DAN AKU\NBEKERJA SAMA DENGAN BAIK DAN JUJUR.
Dialogue: 0,0:16:07.92,0:16:08.92,sign,,0000,0000,0000,,{\an8}SOUYA
Dialogue: 0,0:16:49.38,0:16:50.96,sign,,0000,0000,0000,,GENERASI PERTAMA\NTOKYO MANJI
Dialogue: 0,0:18:18.26,0:18:19.34,sign,,0000,0000,0000,,UNTUKKU\NMANJIRO SANO
