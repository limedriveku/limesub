Dialogue: 0,0:00:05.46,0:00:08.13,sign,,0000,0000,0000,,{\an8}TIDAK! - BERANIKAN DIRI\NUNTUK MENOLAK UNDANGAN
Dialogue: 0,0:00:08.13,0:00:10.71,sign,,0000,0000,0000,,TUMPAS MINUM DAN MEROKOK\NDI BAWAH UMUR
Dialogue: 0,0:00:10.71,0:00:11.72,sign,,0000,0000,0000,,KEKERASAN ADALAH KEJAHATAN
Dialogue: 0,0:00:29.57,0:00:31.57,sign,,0000,0000,0000,,KANTOR KEPOLISIAN METROPOLITAN
Dialogue: 0,0:01:20.24,0:01:21.33,sign,,0000,0000,0000,,{\an8}PEMBANTAIAN SEKETIKA
Dialogue: 0,0:06:12.12,0:06:13.74,sign,,0000,0000,0000,,ROKUHARA TANDAI
Dialogue: 0,0:07:53.97,0:07:57.97,sign,,0000,0000,0000,,{\an8}BRUTAL DAN BIADAB\NUGAL-UGALAN
Dialogue: 0,0:08:30.84,0:08:32.84,sign,,0000,0000,0000,,TRINITY LAND
Dialogue: 0,0:08:32.84,0:08:33.97,sign,,0000,0000,0000,,HARI INI TUTUP
Dialogue: 0,0:10:58.99,0:11:00.11,sign,,0000,0000,0000,,MENGHUBUNGI\NTAKEMICHI
Dialogue: 0,0:15:49.28,0:15:50.36,sign,,0000,0000,0000,,{\an8}PEMIMPIN GENERASI KETIGA
Dialogue: 0,0:15:57.37,0:16:00.58,sign,,0000,0000,0000,,{\an8}KETUA RAGNAROK "REDCLIFF"\NSANTO UGAL-UGALAN - PERKASA
Dialogue: 0,0:16:08.80,0:16:10.46,sign,,0000,0000,0000,,HUJAN METEOR LIAR\NPEMIMPIN KODO RENGO
Dialogue: 0,0:16:15.09,0:16:16.39,sign,,0000,0000,0000,,{\an8}PEMIMPIN KODO RENGO\N"PANTER PUTIH"
Dialogue: 0,0:18:32.27,0:18:34.11,sign,,0000,0000,0000,,ROKUHARA TANDAI\NPERWAKILAN
Dialogue: 0,0:23:40.96,0:23:42.04,sign,,0000,0000,0000,,{\an8}FAIRY TALE REVENGERS - PETIT\N#9 PERTEMUAN PUTRI
Dialogue: 0,0:00:49.25,0:00:53.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malam ini pukul 19.00.\NDi taman hiburan itu.
Dialogue: 0,0:00:55.76,0:00:58.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kebetulan akan kosong.
Dialogue: 0,0:01:00.93,0:01:04.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar kau pernah membangun "era"\Ndi masa lalu.
Dialogue: 0,0:01:06.19,0:01:08.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengejar mimpi itu sekali lagi, ya?
Dialogue: 0,0:01:10.69,0:01:15.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu-satunya alasan kalian, Brahman,\Njadi salah satu pilar Tiga Raksasa
Dialogue: 0,0:01:15.49,0:01:18.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah karena statusmu\Nsebagai Generasi Pertama Black Dragon.
Dialogue: 0,0:01:19.16,0:01:20.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:01:21.33,0:01:25.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kau pikir Senju Kawaragi\Nbisa mengalahkanku atau Mikey?
Dialogue: 0,0:01:25.12,0:01:29.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau bertempur di sini?
Dialogue: 0,0:01:33.84,0:01:35.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Decrescendo.
Dialogue: 0,0:01:36.63,0:01:38.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malam ini, kubunuh kalian sekaligus.
Dialogue: 0,0:01:44.64,0:01:48.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dewa Perang!{\i0}
Dialogue: 0,0:01:48.48,0:01:51.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dewa Perang!
Dialogue: 0,0:01:51.69,0:01:53.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dewa Perang!{\i0}
Dialogue: 0,0:02:06.50,0:02:08.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak ada yang akan menghalangiku.
Dialogue: 0,0:02:09.75,0:02:10.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Takkan pernah!{\i0}
Dialogue: 0,0:03:53.15,0:03:54.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Hanagaki?
Dialogue: 0,0:04:13.25,0:04:14.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senju.
Dialogue: 0,0:04:16.71,0:04:19.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bukan salahmu, Senju.
Dialogue: 0,0:04:21.21,0:04:24.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudku, aku juga cukup bingung sekarang,
Dialogue: 0,0:04:26.01,0:04:27.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tak bisa berkata-kata.
Dialogue: 0,0:04:30.56,0:04:31.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau salah.
Dialogue: 0,0:04:33.48,0:04:38.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi-lagi aku melakukan sesuatu\Nyang tak bisa kuperbaiki.
Dialogue: 0,0:04:38.90,0:04:39.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Lagi-lagi?{\i0}
Dialogue: 0,0:04:40.86,0:04:41.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini salahku.
Dialogue: 0,0:04:44.49,0:04:47.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang, ini bukan salahmu.
Dialogue: 0,0:05:03.59,0:05:06.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Lawan kita adalah South Terano\Ndan Manjiro Sano.{\i0}
Dialogue: 0,0:05:07.51,0:05:11.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu artinya keinginanmu\Nakhirnya terwujud, Senju.
Dialogue: 0,0:05:13.31,0:05:16.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau membentuk tim ini\Nkarena mau melawan orang kuat, 'kan?
Dialogue: 0,0:05:19.31,0:05:22.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama, hari ini,\Nkita hancurkan Rokuhara.
Dialogue: 0,0:05:22.73,0:05:24.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berikutnya, Kanto Manji.
Dialogue: 0,0:05:25.15,0:05:27.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu kau akan mengambil alih Kanto.
Dialogue: 0,0:05:27.86,0:05:30.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang bisa dilakukan\Ndan yang bisa kita lakukan hanya itu.
Dialogue: 0,0:05:31.83,0:05:35.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah apa itu bisa memberikan\Npenghormatan kepada Draken.
Dialogue: 0,0:05:38.83,0:05:42.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika itu membawa Mikey kembali...
Dialogue: 0,0:05:44.38,0:05:46.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengar, Senju.
Dialogue: 0,0:05:46.01,0:05:47.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan menahan diri.
Dialogue: 0,0:06:52.03,0:06:53.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Crescendo.{\i0}
Dialogue: 0,0:07:17.89,0:07:19.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Forte.{\i0}
Dialogue: 0,0:07:25.11,0:07:27.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fortissimo!
Dialogue: 0,0:07:50.51,0:07:52.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Forte, fortissimo!
Dialogue: 0,0:08:06.36,0:08:09.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Semua prajurit sudah berkumpul?\N- Ya.
Dialogue: 0,0:08:20.83,0:08:21.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita siap pergi?
Dialogue: 0,0:08:22.96,0:08:23.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:08:24.54,0:08:28.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akan menghancurkan seluruh Rokuhara\Ndi tempat Draken dibunuh.
Dialogue: 0,0:08:29.75,0:08:30.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo!
Dialogue: 0,0:08:42.35,0:08:46.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Haruskah perang dimulai seperti ini?{\i0}
Dialogue: 0,0:08:47.27,0:08:52.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap untuk pertarungan balas dendam,\NSenju Kawaragi?
Dialogue: 0,0:08:54.24,0:08:58.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo. Mari kita mulai Armageddon!
Dialogue: 0,0:08:58.53,0:08:59.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Majulah.
Dialogue: 0,0:09:02.33,0:09:03.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kuakhiri di sini.
Dialogue: 0,0:09:06.12,0:09:07.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu! Kumohon!
Dialogue: 0,0:09:12.92,0:09:16.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon.\NTak bisakah perang ini dibatalkan?
Dialogue: 0,0:09:19.14,0:09:23.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumaafkan orang-orang\Nyang mencoba membunuhku.
Dialogue: 0,0:09:24.89,0:09:26.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudmu, Hanagaki?
Dialogue: 0,0:09:26.64,0:09:28.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Draken dibunuh!
Dialogue: 0,0:09:28.65,0:09:30.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Draken mati karena melindungiku.
Dialogue: 0,0:09:31.52,0:09:32.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akulah targetnya.
Dialogue: 0,0:09:33.86,0:09:36.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan kubilang aku memaafkan mereka.
Dialogue: 0,0:09:36.15,0:09:38.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Apa...\N- Dasar berandal.
Dialogue: 0,0:09:38.95,0:09:44.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pikir kau siapa,\Nmengambil alih di sini?
Dialogue: 0,0:09:48.37,0:09:53.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Draken juga tak pernah mau\Nmenjadi pemicu Perang Tiga Raksasa.
Dialogue: 0,0:09:56.51,0:10:01.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kematian Draken tak bisa\Ndijadikan alasan untuk perang ini!
Dialogue: 0,0:10:11.77,0:10:15.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dan Draken, kami...
Dialogue: 0,0:10:22.53,0:10:24.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Suara mesin itu...{\i0}
Dialogue: 0,0:10:24.16,0:10:25.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jangan-jangan...{\i0}
Dialogue: 0,0:10:39.63,0:10:41.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mikey...{\i0}
Dialogue: 0,0:11:00.11,0:11:02.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Di mana kau, Takemitchy?{\i0}
Dialogue: 0,0:11:11.75,0:11:13.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tidak, Mikey.{\i0}
Dialogue: 0,0:11:14.79,0:11:17.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kau tak bisa bertarung sekarang.{\i0}
Dialogue: 0,0:11:26.68,0:11:31.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bunuh mereka semua!
Dialogue: 0,0:11:34.98,0:11:38.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tangkis sebisanya,\Nbiarkan mereka melawan Rokuhara.
Dialogue: 0,0:11:38.07,0:11:39.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:12:05.01,0:12:07.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kita bisa serang Senju sekarang.\N- Hanagaki juga!
Dialogue: 0,0:12:07.64,0:12:09.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serang keduanya agar kita terkenal!
Dialogue: 0,0:12:22.90,0:12:23.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senju...
Dialogue: 0,0:12:23.99,0:12:26.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang aku akan melindungimu.
Dialogue: 0,0:12:29.45,0:12:31.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Sial...\N- Kau tetap di sini.
Dialogue: 0,0:12:35.54,0:12:36.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waka...
Dialogue: 0,0:12:36.79,0:12:39.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan memaksakan diri, Senju.
Dialogue: 0,0:12:39.00,0:12:40.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Simpan tenagamu.
Dialogue: 0,0:12:40.92,0:12:44.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kau tak perlu cemas...\N- Lagi pula, Hanagaki benar.
Dialogue: 0,0:12:45.43,0:12:48.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak ada alasan\Nlayak diperjuangkan dalam perang ini.
Dialogue: 0,0:12:48.26,0:12:52.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bukan tempat\Nuntuk menggunakan kekuatanmu.
Dialogue: 0,0:12:53.35,0:12:54.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waka?
Dialogue: 0,0:13:00.82,0:13:04.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanagaki, dia aset berharga.
Dialogue: 0,0:13:04.53,0:13:09.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pastikan putri kita\Ntak bertindak gegabah.
Dialogue: 0,0:13:09.95,0:13:11.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:13:23.51,0:13:25.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah dimulai...
Dialogue: 0,0:13:26.26,0:13:28.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Vivo!
Dialogue: 0,0:13:28.59,0:13:33.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mantan Tenjiku, tahan Kanto Manji.
Dialogue: 0,0:13:33.02,0:13:35.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama, kita hancurkan Brahman!
Dialogue: 0,0:13:35.85,0:13:37.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Diterima!
Dialogue: 0,0:14:04.09,0:14:06.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pukulan ringan untuk pria seukuranmu.
Dialogue: 0,0:14:17.52,0:14:21.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Compassione,{\i0}\NGenerasi Pertama Black Dragon!
Dialogue: 0,0:14:22.73,0:14:23.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minggir, sial!
Dialogue: 0,0:14:24.82,0:14:26.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jika harus bertarung, dia targetku.{\i0}
Dialogue: 0,0:14:27.57,0:14:29.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kenapa Mikey tak bergerak?{\i0}
Dialogue: 0,0:14:29.70,0:14:32.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakucho, mati kau!
Dialogue: 0,0:14:33.99,0:14:40.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejago apa pun kau,\Nlebih mudah pakai senjata.
Dialogue: 0,0:14:40.12,0:14:41.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:14:43.63,0:14:45.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:14:50.05,0:14:53.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, Toman?\NKau tak bisa bertarung lagi?
Dialogue: 0,0:14:55.43,0:14:57.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak mau bergerak, Bos?
Dialogue: 0,0:14:59.89,0:15:00.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bos?
Dialogue: 0,0:15:02.61,0:15:06.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tak terusik?
Dialogue: 0,0:15:07.69,0:15:08.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:15:15.20,0:15:17.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka benar-benar hancur.
Dialogue: 0,0:15:20.12,0:15:23.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, gelar "duo terkuat" masih bertahan.
Dialogue: 0,0:15:23.75,0:15:25.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa mereka berdua?
Dialogue: 0,0:15:26.25,0:15:29.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa bukan monster seperti mereka\Nyang memimpin?
Dialogue: 0,0:15:30.05,0:15:33.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wakasa Imaushi dan Keizo Arashi.
Dialogue: 0,0:15:33.97,0:15:36.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebelum Generasi Pertama\NBlack Dragon didirikan
Dialogue: 0,0:15:37.06,0:15:39.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}keduanya membagi Kanto di antara mereka.
Dialogue: 0,0:15:39.48,0:15:40.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa?{\i0}
Dialogue: 0,0:15:40.56,0:15:45.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kanto Barat dikelola oleh Ragnarok,{\i0}
Dialogue: 0,0:15:45.69,0:15:48.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}tim terbesar Jepang dengan 600 anggota.{\i0}
Dialogue: 0,0:15:50.36,0:15:53.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Pemimpin mereka disebut "Redcliff"\Nkarena tubuh besarnya{\i0}
Dialogue: 0,0:15:53.78,0:15:55.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}selalu bersimbah darah setelah bertarung{\i0}
Dialogue: 0,0:15:55.87,0:15:57.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Keizo Arashi.{\i0}
Dialogue: 0,0:16:00.58,0:16:03.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Untuk melawan Ragnarok,{\i0}
Dialogue: 0,0:16:03.96,0:16:08.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}12 tim Kanto Timur bersatu\Nmembentuk Kodo Rengo.{\i0}
Dialogue: 0,0:16:10.46,0:16:13.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dipimpin pria yang ditakuti\Nsebagai "Panter Putih".{\i0}
Dialogue: 0,0:16:13.59,0:16:14.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Wakasa Imaushi.{\i0}
Dialogue: 0,0:16:16.39,0:16:18.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Mereka sungguh sehebat itu?{\i0}
Dialogue: 0,0:16:20.31,0:16:23.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Keduanya di puncak,\Nselalu saling menyerang.{\i0}
Dialogue: 0,0:16:24.40,0:16:26.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Yang menyatukan mereka\Nbukan siapa-siapa saat itu.{\i0}
Dialogue: 0,0:16:27.57,0:16:29.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Shinichiro Sano.{\i0}
Dialogue: 0,0:16:33.36,0:16:35.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitulah Kanto bersatu.
Dialogue: 0,0:16:37.07,0:16:38.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takeomi sering berkata,
Dialogue: 0,0:16:39.49,0:16:41.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Soal kekuatan bertarung murni,
Dialogue: 0,0:16:41.58,0:16:43.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang terkuat di Jepang saat itu, tak lain...
Dialogue: 0,0:16:45.63,0:16:46.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah mereka berdua."
Dialogue: 0,0:16:49.17,0:16:51.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana dengan Mikey?
Dialogue: 0,0:16:51.38,0:16:53.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita terpaksa menghemat tenaga.
Dialogue: 0,0:16:53.88,0:16:56.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertarungan tiga arah ini\Nbukan bagian rencana.
Dialogue: 0,0:16:56.39,0:16:57.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo maju.
Dialogue: 0,0:16:57.85,0:16:59.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan lengah.
Dialogue: 0,0:17:00.18,0:17:02.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}South ada di tingkat Mikey.
Dialogue: 0,0:17:09.98,0:17:13.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Vivo!
Dialogue: 0,0:17:14.74,0:17:17.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serang aku, "legenda!"
Dialogue: 0,0:17:17.95,0:17:20.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami datang!
Dialogue: 0,0:17:20.33,0:17:22.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Forte!
Dialogue: 0,0:17:26.17,0:17:28.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bagaimana dia bertahan\Ndi udara begitu lama?{\i0}
Dialogue: 0,0:17:34.17,0:17:37.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Gila, menjatuhkan pria besar\Nseperti South dalam satu sapuan...{\i0}
Dialogue: 0,0:17:38.09,0:17:41.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Waka Secepat Petir"\Ndan "Benkei yang Kekar".
Dialogue: 0,0:17:41.97,0:17:45.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka duo terkuat\NGenerasi Pertama Black Dragon.
Dialogue: 0,0:17:53.57,0:17:54.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, Benkei.
Dialogue: 0,0:17:55.57,0:17:58.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mendaratkan pukulan pertama kita.
Dialogue: 0,0:17:59.66,0:18:00.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tak keberatan, Mikey?
Dialogue: 0,0:18:01.49,0:18:04.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika terus begini, mereka bisa menang\Ndan mengakhiri perang ini.
Dialogue: 0,0:18:05.87,0:18:07.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutmu begitu?
Dialogue: 0,0:18:08.46,0:18:13.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mengesankan, tapi rasanya terlalu mudah.{\i0}
Dialogue: 0,0:18:14.84,0:18:17.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Duo terkuat\NGenerasi Pertama Black Dragon.{\i0}
Dialogue: 0,0:18:18.47,0:18:20.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sekuat apa pun mereka,{\i0}
Dialogue: 0,0:18:21.39,0:18:23.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}mereka tak bisa mengalahkan South Terano.{\i0}
Dialogue: 0,0:18:35.40,0:18:37.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pria yang dicintai kekerasan.{\i0}
Dialogue: 0,0:18:42.74,0:18:48.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bilang ini sudah berakhir, Brahman.
Dialogue: 0,0:18:50.33,0:18:52.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kau monster.
Dialogue: 0,0:18:52.88,0:18:55.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dunia ini penuh kejutan.
Dialogue: 0,0:18:58.67,0:19:01.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada usia 12 tahun,\Ndengan tinju penuh cinta,
Dialogue: 0,0:19:02.01,0:19:06.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku memukuli pria yang bisa kusebut ayah...
Dialogue: 0,0:19:08.43,0:19:10.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sampai mati.
Dialogue: 0,0:19:10.69,0:19:12.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luka tembak?
Dialogue: 0,0:19:12.81,0:19:17.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada usia 14 tahun,\Nibuku dibunuh sebagai pembalasan,
Dialogue: 0,0:19:17.03,0:19:20.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan lukaku nyaris membunuhku.
Dialogue: 0,0:19:27.50,0:19:28.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun,
Dialogue: 0,0:19:29.66,0:19:32.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"dorongan" itu tidak pernah hilang.
Dialogue: 0,0:19:36.30,0:19:37.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}"Dorongan Gelap."{\i0}
Dialogue: 0,0:19:37.88,0:19:39.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}"Dorongan..."{\i0}
Dialogue: 0,0:19:59.40,0:20:01.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah lima tahun, ya.
Dialogue: 0,0:20:02.24,0:20:03.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah waktunya.
Dialogue: 0,0:20:14.04,0:20:15.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, Minami.
Dialogue: 0,0:20:16.09,0:20:18.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Mulai hari ini, namamu "South".
Dialogue: 0,0:20:24.84,0:20:25.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan, South!
Dialogue: 0,0:21:06.26,0:21:07.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan!
Dialogue: 0,0:21:22.07,0:21:26.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon, jangan bunuh anak ini...
Dialogue: 0,0:21:56.31,0:21:59.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pikir bisa menghentikan...
Dialogue: 0,0:21:59.65,0:22:01.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}irama ini?
Dialogue: 0,0:22:03.53,0:22:07.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berdenyut!
Dialogue: 0,0:22:08.36,0:22:09.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berdenyut!
Dialogue: 0,0:22:12.58,0:22:15.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Vivo!
Dialogue: 0,0:22:31.01,0:22:35.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Hanya orang yang dicintai kekerasan\Nyang bisa memahami irama ini.
Dialogue: 0,0:22:39.27,0:22:42.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Satu-satunya yang bisa memahami{\i0}
Dialogue: 0,0:22:42.94,0:22:45.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}"dorongan" ini mungkin\NMikey yang Perkasa.{\i0}
Dialogue: 0,0:22:48.61,0:22:51.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia menghabisi "duo legenda"\Ndalam sekejap...{\i0}
Dialogue: 0,0:22:51.53,0:22:52.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia monster...
Dialogue: 0,0:22:55.87,0:22:57.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Tak mungkin berakhir.
Dialogue: 0,0:22:58.08,0:23:00.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Tak mungkin berakhir di sini!
Dialogue: 0,0:23:01.38,0:23:03.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kami bukan tim yang berakhir begitu saja!
Dialogue: 0,0:23:12.51,0:23:13.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Maaf, Waka.
Dialogue: 0,0:23:14.39,0:23:16.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku tak bisa hanya menonton lagi!
Dialogue: 0,0:23:16.35,0:23:17.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Senju...
Dialogue: 0,0:23:24.57,0:23:25.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}South.
Dialogue: 0,0:23:26.82,0:23:28.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang akan menghancurkanmu!
Dialogue: 0,0:23:38.66,0:23:39.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Vivace.{\i0}
Dialogue: 0,0:23:42.04,0:23:45.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini kali pertama aku ke pesta teh.\NKuharap kami semua akur.
Dialogue: 0,0:23:45.71,0:23:47.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi...
Dialogue: 0,0:23:47.13,0:23:49.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau menatapku dengan sinis?\NKau mau mati?
Dialogue: 0,0:23:49.88,0:23:52.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya memintamu mengoper pudingnya.
Dialogue: 0,0:23:52.13,0:23:55.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Putri Otohime, selamat datang!\N- Berbeda dengan bayanganku...
Dialogue: 0,0:23:55.89,0:23:57.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Diterjemahkan oleh Lia Agatha
