Dialogue: 0,0:01:37.93,0:01:39.59,sign,,0000,0000,0000,,{\an8}PERWAKILAN ROKUHARA TANDAI\NSOUTH TERANO
Dialogue: 0,0:02:14.76,0:02:15.80,sign,,0000,0000,0000,,NAGA\NBUNGA KEMULIAAN
Dialogue: 0,0:03:07.77,0:03:08.97,sign,,0000,0000,0000,,{\an8}KETUA - KAKUCHO
Dialogue: 0,0:03:33.79,0:03:34.88,sign,,0000,0000,0000,,{\an8}NOMOR 4 - KANJI MOCHIZUKI
Dialogue: 0,0:03:55.15,0:03:56.52,sign,,0000,0000,0000,,{\an8}NOMOR 3 - RINDO HAITANI\NNOMOR 2 - RAN HAITANI
Dialogue: 0,0:04:50.62,0:04:51.91,sign,,0000,0000,0000,,{\an8}BRAHMAN
Dialogue: 0,0:05:20.77,0:05:22.02,sign,,0000,0000,0000,,{\an8}BOS BRAHMAN\NSENJU KAWARAGI
Dialogue: 0,0:06:06.19,0:06:08.03,sign,,0000,0000,0000,,{\an8}PETINGGI EKSEKUTIF (KAPTEN PENJAGA ELITE)\NKEIZO ARASHI
Dialogue: 0,0:07:26.44,0:07:27.52,sign,,0000,0000,0000,,{\an8}PETINGGI EKSEKUTIF BRAHMAN\NWAKASA IMAUSHI
Dialogue: 0,0:11:34.23,0:11:36.11,sign,,0000,0000,0000,,BENGKEL D & D
Dialogue: 0,0:12:13.02,0:12:15.40,sign,,0000,0000,0000,,{\an8}BENGKEL SEPEDA MOTOR D & D
Dialogue: 0,0:16:37.24,0:16:38.33,sign,,0000,0000,0000,,{\an8}STASIUN HARAJUKU
Dialogue: 0,0:18:22.14,0:18:23.22,sign,,0000,0000,0000,,{\an8}NOMOR SATU DI JEPANG
Dialogue: 0,0:21:05.80,0:21:07.14,sign,,0000,0000,0000,,GERBANG PERSIMPANGAN JINGUMAE
Dialogue: 0,0:23:41.00,0:23:42.08,sign,,0000,0000,0000,,FAIRY TALE REVENGERS - PETIT
Dialogue: 0,0:23:42.08,0:23:43.08,sign,,0000,0000,0000,,#6 "KEMBALIKAN PUTERI KAGUYA!"
Dialogue: 0,0:01:32.34,0:01:33.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}#56 Menunjukkan wajah aslinya
Dialogue: 0,0:01:33.42,0:01:34.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}"Era Tiga Raksasa."{\i0}
Dialogue: 0,0:01:34.80,0:01:37.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Dua dari tiga raksasa\Ntiba-tiba muncul bersamaan.{\i0}
Dialogue: 0,0:01:39.60,0:01:42.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Rokuhara Tandai dan Brahman.{\i0}
Dialogue: 0,0:01:42.35,0:01:44.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Apa yang akan terjadi sekarang?{\i0}
Dialogue: 0,0:01:53.69,0:01:54.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hujan.
Dialogue: 0,0:01:55.94,0:01:57.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shin sering bilang...
Dialogue: 0,0:02:02.53,0:02:05.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bahwa aku membawa hujan\Nke mana pun aku pergi.
Dialogue: 0,0:02:06.25,0:02:08.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kalian di sini?
Dialogue: 0,0:02:08.12,0:02:09.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Brahman!
Dialogue: 0,0:02:09.58,0:02:12.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian yang ada di wilayah kami.
Dialogue: 0,0:02:12.04,0:02:14.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya itu pertanyaanku,\NRokuhara Tandai.
Dialogue: 0,0:02:22.93,0:02:27.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski itu yang ingin kukatakan,\Nini sempurna.
Dialogue: 0,0:02:28.77,0:02:31.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Urusanku bukan dengan kalian!
Dialogue: 0,0:02:31.81,0:02:34.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku datang untuk menemui\NTakemichi Hanagaki!
Dialogue: 0,0:02:37.11,0:02:38.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku datang untuk merekrutmu.
Dialogue: 0,0:02:41.82,0:02:43.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Aku?
Dialogue: 0,0:02:44.58,0:02:47.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersama seluruh Brahman,\Nkusampaikan salam hormat
Dialogue: 0,0:02:47.79,0:02:51.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kepada mantan Kapten Divisi Satu\NGeng Tokyo Manji
Dialogue: 0,0:02:52.67,0:02:55.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan Pemimpin Generasi Kesebelas\NBlack Dragon.
Dialogue: 0,0:02:55.13,0:02:57.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:02:58.80,0:03:00.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bergabunglah dengan kami.
Dialogue: 0,0:03:00.68,0:03:02.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa aku?
Dialogue: 0,0:03:05.31,0:03:07.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak bisa kubiarkan ini terjadi.
Dialogue: 0,0:03:08.98,0:03:10.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Jika itu tujuanmu, aku takkan mundur.
Dialogue: 0,0:03:10.81,0:03:11.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kaku?
Dialogue: 0,0:03:14.36,0:03:15.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si Petarung?
Dialogue: 0,0:03:16.23,0:03:18.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau bekerja untuk South sekarang?
Dialogue: 0,0:03:19.11,0:03:20.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rajamu mati, jadi kau beralih?
Dialogue: 0,0:03:22.53,0:03:24.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa hakmu membuat tuduhan seperti itu?
Dialogue: 0,0:03:25.45,0:03:27.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah melupakan Shinichiro Sano?
Dialogue: 0,0:03:31.58,0:03:33.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, kita berdua gatal berkelahi.
Dialogue: 0,0:03:34.88,0:03:36.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Bukan begitu, Akashi?
Dialogue: 0,0:03:38.34,0:03:41.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Generasi Pertama Black Dragon,\NTakeomi Akashi.
Dialogue: 0,0:03:41.47,0:03:47.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku pemimpin Generasi Kesembilan\NBlack Dragon, Shion Madarame!
Dialogue: 0,0:03:47.43,0:03:50.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak peduli dengan semua\Nhal membosankan ini.
Dialogue: 0,0:03:50.68,0:03:52.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika mau bertengkar, ayo mulai.
Dialogue: 0,0:03:53.48,0:03:55.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kita mulai perang di sini?
Dialogue: 0,0:03:58.07,0:03:59.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mantan anggota Tenjiku?{\i0}
Dialogue: 0,0:04:00.61,0:04:03.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Generasi terburuk,\Nsemuanya berkumpul di sini.{\i0}
Dialogue: 0,0:04:03.11,0:04:06.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Rokuhara Tandai sungguh tim yang gila!{\i0}
Dialogue: 0,0:04:06.74,0:04:09.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa perang besar akan terjadi di sini?{\i0}
Dialogue: 0,0:04:11.37,0:04:13.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian bersemangat sekali, ya?
Dialogue: 0,0:04:14.50,0:04:18.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun, bagaimana Akashi ini\Nbisa begitu tenang?{\i0}
Dialogue: 0,0:04:18.96,0:04:22.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Shinichiro Sano, yang disebut Kaku, pasti...{\i0}
Dialogue: 0,0:04:23.68,0:04:26.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi muda enak, ya?
Dialogue: 0,0:04:26.76,0:04:28.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, Senju?
Dialogue: 0,0:04:30.77,0:04:32.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senju?
Dialogue: 0,0:04:54.83,0:04:55.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Payungnya.
Dialogue: 0,0:04:58.75,0:05:00.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:05:06.89,0:05:08.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak mau basah.
Dialogue: 0,0:05:12.27,0:05:15.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bos Brahman, Senju Kawaragi.
Dialogue: 0,0:05:18.77,0:05:19.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:05:22.03,0:05:23.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Mau mulai?
Dialogue: 0,0:05:25.78,0:05:29.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si pendek ini petinggi Brahman?
Dialogue: 0,0:05:31.37,0:05:33.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Grazioso!
Dialogue: 0,0:05:33.83,0:05:36.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lumayan, Senju Kawaragi!
Dialogue: 0,0:05:36.67,0:05:38.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi pusing!
Dialogue: 0,0:05:40.00,0:05:43.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kau lakukan kepada bos kami?
Dialogue: 0,0:05:43.76,0:05:46.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan ikut campur, Cebol Sialan!
Dialogue: 0,0:05:47.93,0:05:49.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Madarame!{\i0}
Dialogue: 0,0:05:49.30,0:05:50.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa kau?
Dialogue: 0,0:05:51.89,0:05:54.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Generasi Kesembilan Black Dragon...
Dialogue: 0,0:05:54.43,0:05:55.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Hei.\N- Apa?
Dialogue: 0,0:06:04.57,0:06:06.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kau aib bagi Black Dragon!
Dialogue: 0,0:06:08.03,0:06:09.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Jangan macam-macam!
Dialogue: 0,0:06:09.24,0:06:10.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aib?
Dialogue: 0,0:06:11.53,0:06:14.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa dia membicarakan Black Dragon...
Dialogue: 0,0:06:14.70,0:06:17.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia Generasi Pertama Black Dragon,\NKeizo Arashi.
Dialogue: 0,0:06:18.92,0:06:20.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia dikenal sebagai Benkei.
Dialogue: 0,0:06:20.71,0:06:23.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senju! Hari ini kita datang\Nbukan untuk bertarung!
Dialogue: 0,0:06:24.50,0:06:26.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita datang untuk Takemichi Hanagaki!
Dialogue: 0,0:06:26.38,0:06:27.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau cerewet, Benkei.
Dialogue: 0,0:06:28.43,0:06:32.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Benar juga, aku lupa\NBrahman mencoba merekrutku.{\i0}
Dialogue: 0,0:06:32.68,0:06:34.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kenapa?{\i0}
Dialogue: 0,0:06:34.97,0:06:36.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti kataku...
Dialogue: 0,0:06:45.36,0:06:46.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kaku?
Dialogue: 0,0:06:47.32,0:06:49.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takemichi sudah meninggalkan semua ini.
Dialogue: 0,0:06:49.95,0:06:53.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, jika dia kembali ke dunia ini,\Nbukan ke Brahman.
Dialogue: 0,0:06:54.37,0:06:56.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi ke kami, Rokuhara Tandai!
Dialogue: 0,0:06:56.54,0:06:59.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Benar, 'kan? Takemichi.\N- Apa?
Dialogue: 0,0:07:00.58,0:07:03.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pantas saja kau dijuluki Petarung.
Dialogue: 0,0:07:03.50,0:07:06.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rokuhara penuh dengan bakat.
Dialogue: 0,0:07:06.71,0:07:10.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal kekuatan bertarung,\Ndia nomor satu di Tenjiku.
Dialogue: 0,0:07:10.22,0:07:13.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mencari tempat untuk mati,\Njadi aku merekrutnya.
Dialogue: 0,0:07:13.93,0:07:15.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:07:16.14,0:07:18.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membuat darahmu terpompa, 'kan, Waka?
Dialogue: 0,0:07:20.02,0:07:21.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:07:22.35,0:07:23.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau...
Dialogue: 0,0:07:24.56,0:07:26.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Jika aku mau membunuhmu...
Dialogue: 0,0:07:27.53,0:07:29.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}...kau takkan berdiri sekarang.
Dialogue: 0,0:07:29.07,0:07:32.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Monster datang silih berganti.{\i0}
Dialogue: 0,0:07:32.78,0:07:35.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sok keren dan ikut campur, Waka.
Dialogue: 0,0:07:35.99,0:07:38.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya mengikuti perintah Senju.
Dialogue: 0,0:07:40.46,0:07:44.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak membuang-buang tenaga\Nuntuk pamer pada rendahan Tenjiku.
Dialogue: 0,0:07:46.92,0:07:48.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu Wakasa Imaushi.
Dialogue: 0,0:07:50.63,0:07:55.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duo terkuat Generasi Pertama\NBlack Dragons, Waka dan Benkei.
Dialogue: 0,0:07:56.89,0:08:00.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan Wakil Ketua Generasi Pertama\NBlack Dragon,
Dialogue: 0,0:08:01.48,0:08:03.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dewa Perang, Takeomi Akashi.
Dialogue: 0,0:08:05.27,0:08:09.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka bertiga adalah pendiri\NGenerasi Pertama Black Dragon.
Dialogue: 0,0:08:10.94,0:08:13.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Orang-orang yang memimpin\NGenerasi Pertama Black Dragon{\i0}
Dialogue: 0,0:08:14.66,0:08:17.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Shinichiro Sano menjadi\Nnomor satu di Jepang.{\i0}
Dialogue: 0,0:08:17.99,0:08:19.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Orang-orang ini...{\i0}
Dialogue: 0,0:08:20.58,0:08:25.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan kini pria misterius yang memimpin\Npara legenda hidup itu
Dialogue: 0,0:08:26.08,0:08:27.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah Senju yang Tak Terkalahkan.
Dialogue: 0,0:08:28.50,0:08:29.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senju Kawaragi!
Dialogue: 0,0:08:31.80,0:08:34.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan ini...
Dialogue: 0,0:08:34.80,0:08:36.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa bilang kalian bisa heboh tanpa aku?
Dialogue: 0,0:08:38.85,0:08:43.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, urusan kita\Nyang belum selesai, 'kan, South?
Dialogue: 0,0:08:44.94,0:08:49.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mesinku akhirnya memanas\Nsetelah sekian lama!
Dialogue: 0,0:08:50.61,0:08:52.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita mulai!
Dialogue: 0,0:08:52.53,0:08:54.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perkelahian skala penuh!
Dialogue: 0,0:08:54.11,0:08:56.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa yang akan terjadi di sini?{\i0}
Dialogue: 0,0:08:58.78,0:09:00.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa macet begini?
Dialogue: 0,0:09:00.54,0:09:01.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kecelakaan?
Dialogue: 0,0:09:04.96,0:09:09.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin membasmi kalian setelah menarik\NDraken, tapi ini lebih mudah.
Dialogue: 0,0:09:09.88,0:09:12.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo selesaikan di sini, Brahman!
Dialogue: 0,0:09:13.59,0:09:16.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian bahkan tak kami anggap, Rokuhara.
Dialogue: 0,0:09:17.89,0:09:22.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami hanya butuh Takemichi Hanagaki\Nsebagai sekutu sebelum melawan Toman.
Dialogue: 0,0:09:22.97,0:09:24.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Toman?
Dialogue: 0,0:09:24.73,0:09:27.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan seenaknya memutuskan, Sialan!
Dialogue: 0,0:09:27.94,0:09:31.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku takkan masuk ke mana pun,\Nbegitu juga Takemitchy!
Dialogue: 0,0:09:32.82,0:09:33.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku...{\i0}
Dialogue: 0,0:09:34.57,0:09:36.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong aku...
Dialogue: 0,0:09:36.86,0:09:38.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ya. Aku...{\i0}
Dialogue: 0,0:09:40.12,0:09:41.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya, aku akan menyelamatkanmu.
Dialogue: 0,0:09:43.12,0:09:46.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak tertarik\Npada Rokuhara atau Brahman.
Dialogue: 0,0:09:48.42,0:09:54.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau mengalahkan\Npemimpin Kanto Manji, Manjiro Sano!
Dialogue: 0,0:09:55.80,0:09:56.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu dia.{\i0}
Dialogue: 0,0:09:57.34,0:09:59.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu alasan aku di sini.{\i0}
Dialogue: 0,0:10:01.72,0:10:02.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:10:03.35,0:10:05.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sebabnya kau kembali ke garis depan.
Dialogue: 0,0:10:12.90,0:10:15.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau sudah gila?
Dialogue: 0,0:10:16.44,0:10:19.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu artinya kau masuk\Ndi antara Tiga Raksasa, 'kan?
Dialogue: 0,0:10:19.95,0:10:22.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bawahan sepertimu...
Dialogue: 0,0:10:30.04,0:10:32.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kali ini, South yang terhempas!{\i0}
Dialogue: 0,0:10:37.47,0:10:40.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika ada urusan dengan Takemitchy,\Nhadapi aku dahulu.
Dialogue: 0,0:10:41.43,0:10:44.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau mulai ronde kedua?
Dialogue: 0,0:10:44.60,0:10:47.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Vivo!
Dialogue: 0,0:10:49.73,0:10:50.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada polisi.
Dialogue: 0,0:10:51.56,0:10:52.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beri jalan.
Dialogue: 0,0:10:55.57,0:10:57.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ayo pergi, Semuanya.\N- South!
Dialogue: 0,0:10:58.32,0:11:01.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kutinggalkan masa laluku\Ndengan Geng Tokyo Manji.
Dialogue: 0,0:11:01.57,0:11:02.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak mau ikut Rokuhara!
Dialogue: 0,0:11:04.49,0:11:08.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari bersenang-senang lagi, Draken.
Dialogue: 0,0:11:13.46,0:11:15.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sudah kuduga, Draken tak berubah.{\i0}
Dialogue: 0,0:11:16.59,0:11:18.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Hatinya selalu bersama Toman.{\i0}
Dialogue: 0,0:11:20.01,0:11:21.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Draken.
Dialogue: 0,0:11:22.30,0:11:23.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan mampir nanti.
Dialogue: 0,0:11:27.47,0:11:28.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mereka saling kenal?{\i0}
Dialogue: 0,0:11:37.32,0:11:39.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, itu Hanagaki.
Dialogue: 0,0:11:44.49,0:11:47.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, aku berlebihan tadi.
Dialogue: 0,0:11:47.83,0:11:49.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak apa-apa.
Dialogue: 0,0:11:49.20,0:11:51.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau hebat, seperti biasa.
Dialogue: 0,0:11:51.71,0:11:55.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Draken, kau bilang Senju Kawaragi\Nakan bentrok dengan "Toman..."
Dialogue: 0,0:11:55.96,0:11:59.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu nama Kanto Manji sekarang.
Dialogue: 0,0:11:59.21,0:12:00.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:12:01.22,0:12:04.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takemitchy, ada yang ingin kukatakan.
Dialogue: 0,0:12:07.43,0:12:10.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku anggota Brahman sekarang.
Dialogue: 0,0:12:10.56,0:12:11.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:12:17.94,0:12:19.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Draken anggota Brahman.{\i0}
Dialogue: 0,0:12:20.90,0:12:22.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa maksudnya?{\i0}
Dialogue: 0,0:12:22.95,0:12:24.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini.
Dialogue: 0,0:12:24.28,0:12:25.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:12:29.12,0:12:30.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi itu benar-benar sial.
Dialogue: 0,0:12:31.33,0:12:32.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengacau.
Dialogue: 0,0:12:33.08,0:12:35.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya mengintai musuh dan tertangkap.
Dialogue: 0,0:12:37.25,0:12:38.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Draken memberitahumu?
Dialogue: 0,0:12:39.13,0:12:41.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudmu soal dia menjadi anggota Brahman?
Dialogue: 0,0:12:42.26,0:12:43.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:12:43.47,0:12:47.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kubilang aku juga akan ikut,\Ntapi dia melarang keras.
Dialogue: 0,0:12:48.81,0:12:51.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kucoba membuat diriku berguna,\Nmeski sedikit.
Dialogue: 0,0:12:54.02,0:12:57.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mencemaskan Draken.
Dialogue: 0,0:12:59.02,0:13:01.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Brahman pada dasarnya\Nadalah geng yakuza yang matang.
Dialogue: 0,0:13:01.57,0:13:05.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada rumor buruk seputar mereka juga.
Dialogue: 0,0:13:07.66,0:13:09.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka pasti berdebat tentangmu.
Dialogue: 0,0:13:11.24,0:13:12.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak tahu soal ini, Akashi!
Dialogue: 0,0:13:14.33,0:13:15.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan hanya Takemitchy.
Dialogue: 0,0:13:15.87,0:13:19.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita sudah berjanji tak melibatkan\Nmantan anggota Toman!
Dialogue: 0,0:13:19.84,0:13:21.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu... Draken!
Dialogue: 0,0:13:25.47,0:13:28.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong beri tahu aku apa yang terjadi.
Dialogue: 0,0:13:30.56,0:13:34.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Draken ingin mengembalikan Mikey.
Dialogue: 0,0:13:34.06,0:13:36.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senju Kawaragi.
Dialogue: 0,0:13:37.69,0:13:40.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang kau tak perlu datang.
Dialogue: 0,0:13:42.40,0:13:46.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Brahman mau menghancurkan Kanto Manji,\Ntermasuk Mikey.
Dialogue: 0,0:13:46.95,0:13:48.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tujuan kami sejalan.
Dialogue: 0,0:13:51.87,0:13:54.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku suka prinsip Geng Tokyo Manji.
Dialogue: 0,0:14:03.63,0:14:06.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan "ingin menjadi tim terbaik\Ndi Jepang",
Dialogue: 0,0:14:07.01,0:14:10.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi "membangun era berandal".\NItu sangat khas Mikey.
Dialogue: 0,0:14:12.81,0:14:14.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi dia berbeda sekarang.
Dialogue: 0,0:14:15.93,0:14:20.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika Mikey mau rusak sebagai orang dewasa,
Dialogue: 0,0:14:21.02,0:14:23.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}maka kami, orang dewasa rusak,\Nakan menghancurkannya.
Dialogue: 0,0:14:25.90,0:14:27.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takemichi Hanagaki.
Dialogue: 0,0:14:28.40,0:14:32.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau membuat deklarasi\Ndi depan dua tim besar.
Dialogue: 0,0:14:33.03,0:14:35.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Aku mau mengalahkan Manjiro Sano."
Dialogue: 0,0:14:36.33,0:14:40.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika itu sungguh tekadmu,\Nbergabunglah dengan kami.
Dialogue: 0,0:14:41.46,0:14:44.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Brahman akan menyambutmu.
Dialogue: 0,0:14:46.71,0:14:49.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku tak bisa menyeret\Nsemua anggota lama Toman.{\i0}
Dialogue: 0,0:14:50.34,0:14:53.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tapi aku tak punya petunjuk lain...{\i0}
Dialogue: 0,0:14:54.18,0:14:56.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Untuk mengalahkan Mikey...{\i0}
Dialogue: 0,0:14:57.23,0:14:59.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}untuk menghajarnya\Ndan mengembalikannya...{\i0}
Dialogue: 0,0:14:59.60,0:15:00.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}mungkin ini...{\i0}
Dialogue: 0,0:15:02.65,0:15:05.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Senju, jangan bercanda.
Dialogue: 0,0:15:05.36,0:15:08.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau sungguh mau menarik Takemitchy...
Dialogue: 0,0:15:10.49,0:15:12.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau selesaikan sekarang juga?
Dialogue: 0,0:15:16.54,0:15:17.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Draken.
Dialogue: 0,0:15:21.12,0:15:23.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan bergabung dengan Brahman.
Dialogue: 0,0:15:25.80,0:15:26.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Draken.
Dialogue: 0,0:15:28.76,0:15:31.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Brahman akan menghancurkan Kanto Manji.
Dialogue: 0,0:15:31.97,0:15:36.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bebas mengembalikan Mikey\Ndi tengah jalan...
Dialogue: 0,0:15:36.68,0:15:40.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kau seharusnya tahu itu takkan mudah.
Dialogue: 0,0:15:42.23,0:15:47.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mikey memercayai Hanagaki\Nseperti dia memercayaimu.
Dialogue: 0,0:15:48.19,0:15:52.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, meski harus melawan prinsipmu,\Njadikan dia salah satu dari kita.
Dialogue: 0,0:15:57.29,0:15:58.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takemitchy.
Dialogue: 0,0:15:58.37,0:15:59.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:15:59.62,0:16:03.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti yang kau dengar,\Nkami bekerja dengan Brahman
Dialogue: 0,0:16:03.04,0:16:05.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena kepentingan kami sejalan.
Dialogue: 0,0:16:09.51,0:16:11.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan lupakan itu.
Dialogue: 0,0:16:14.55,0:16:16.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biarkan aku melakukan ini juga.
Dialogue: 0,0:16:16.64,0:16:20.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pasti akan membawa Mikey kembali\Ndari jalan kejahatan.
Dialogue: 0,0:16:23.02,0:16:25.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, sudah beres, Hanagaki...
Dialogue: 0,0:16:27.65,0:16:28.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Payung?
Dialogue: 0,0:16:29.36,0:16:33.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bertemu di depan Stasiun Harajuku\Nbesok, pukul 15.00.
Dialogue: 0,0:16:38.33,0:16:40.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Kau membuatku menunggu lama, Hanagaki.{\i0}
Dialogue: 0,0:16:42.21,0:16:43.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo.
Dialogue: 0,0:16:43.87,0:16:46.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau siapa?
Dialogue: 0,0:16:46.21,0:16:49.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akan berbelanja, bawakan tasku, ya?
Dialogue: 0,0:16:50.13,0:16:52.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, tapi siapa kau?
Dialogue: 0,0:16:52.09,0:16:53.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jahat sekali.
Dialogue: 0,0:16:53.93,0:16:55.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Senju.
Dialogue: 0,0:16:55.47,0:16:56.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita kemarin berjanji, 'kan?
Dialogue: 0,0:16:58.26,0:17:00.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau perempuan?
Dialogue: 0,0:17:00.60,0:17:04.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Lalu? Kau menyebalkan.
Dialogue: 0,0:17:04.52,0:17:06.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, maksudku...
Dialogue: 0,0:17:06.69,0:17:08.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku bilang aku laki-laki?
Dialogue: 0,0:17:08.27,0:17:12.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, tapi tak terbayangkan\Npetinggi Brahman adalah...
Dialogue: 0,0:17:12.03,0:17:14.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Abaikan semua itu, ayo pergi.
Dialogue: 0,0:17:15.40,0:17:16.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu dulu.
Dialogue: 0,0:17:17.16,0:17:19.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bos salah satu Tiga Raksasa perempuan?
Dialogue: 0,0:17:19.16,0:17:20.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Hebat!\N- Kau menyebalkan.
Dialogue: 0,0:17:22.50,0:17:25.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah lama tak berbelanja,\Njadi kita akan ke banyak tempat.
Dialogue: 0,0:17:25.46,0:17:26.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kartu hitam.
Dialogue: 0,0:17:27.46,0:17:28.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini milik Takeomi.
Dialogue: 0,0:17:29.59,0:17:30.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takeomi?
Dialogue: 0,0:17:30.67,0:17:33.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Takeomi Akashi. Nomor dua kita.{\i0}
Dialogue: 0,0:17:35.47,0:17:37.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Ya, dia jauh lebih tua, 'kan?{\i0}
Dialogue: 0,0:17:37.26,0:17:38.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak usah terlalu sopan.
Dialogue: 0,0:17:39.30,0:17:40.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau juga tahun kedua, 'kan?
Dialogue: 0,0:17:41.64,0:17:44.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kau petinggi tim dan aku anak baru.
Dialogue: 0,0:17:44.48,0:17:45.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan khawatir.
Dialogue: 0,0:17:46.23,0:17:50.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Brahman penuh dengan pria tua,\Naku senang ada orang seusiaku bergabung.
Dialogue: 0,0:17:54.11,0:17:56.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini keren sekali!
Dialogue: 0,0:17:56.70,0:17:57.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo masuk.
Dialogue: 0,0:17:58.86,0:18:01.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu sebentar, kita ke sana saja.
Dialogue: 0,0:18:03.08,0:18:05.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini manis?
Dialogue: 0,0:18:05.20,0:18:06.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cocok!
Dialogue: 0,0:18:06.62,0:18:11.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, itu cocok untukmu, tapi agak terbuka.
Dialogue: 0,0:18:11.34,0:18:13.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus karena mudah bergerak.
Dialogue: 0,0:18:14.38,0:18:15.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, hentikan!
Dialogue: 0,0:18:15.55,0:18:16.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelihatan.
Dialogue: 0,0:18:16.92,0:18:19.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berikutnya! Ini mulai menyenangkan!
Dialogue: 0,0:18:20.85,0:18:22.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih mau belanja?
Dialogue: 0,0:18:23.22,0:18:24.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Ini bagaimana? Keren!
Dialogue: 0,0:18:24.89,0:18:26.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Ya, itu mencolok.
Dialogue: 0,0:18:27.69,0:18:29.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Tanganku sudah penuh, tahu?
Dialogue: 0,0:18:30.94,0:18:32.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Selera berpakaiannya sepayah aku,{\i0}
Dialogue: 0,0:18:33.02,0:18:36.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}tapi tak bisa disangkal\Ndia hanya gadis manis biasa.{\i0}
Dialogue: 0,0:18:36.69,0:18:38.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa dia sungguh petinggi Brahman?{\i0}
Dialogue: 0,0:18:39.28,0:18:40.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang itu juga cocok untukmu.
Dialogue: 0,0:18:41.37,0:18:42.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei.
Dialogue: 0,0:18:42.78,0:18:45.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa petingginya bukan Akashi?
Dialogue: 0,0:18:46.37,0:18:50.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia Generasi Pertama Black Dragon,
Dialogue: 0,0:18:50.42,0:18:54.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}usianya pertengahan 20-an, 'kan?\NAku terpikir soal urutan usianya.
Dialogue: 0,0:18:54.21,0:18:58.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Abangku ahli strategi.\NSejak zaman Black Dragon.
Dialogue: 0,0:18:59.30,0:19:01.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan aku yang mendirikan timnya.
Dialogue: 0,0:19:01.34,0:19:03.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Abang?
Dialogue: 0,0:19:03.51,0:19:04.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian bersaudara?
Dialogue: 0,0:19:06.10,0:19:08.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nama asliku Senju Akashi.
Dialogue: 0,0:19:09.56,0:19:11.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senju Kawaragi seperti nama panggung.
Dialogue: 0,0:19:12.27,0:19:13.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nama panggung...
Dialogue: 0,0:19:14.27,0:19:16.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Haruchiyo yang membuatnya.
Dialogue: 0,0:19:16.86,0:19:17.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Haruchiyo?
Dialogue: 0,0:19:18.57,0:19:20.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau juga pasti mengenalnya.
Dialogue: 0,0:19:20.15,0:19:24.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mantan Wakil Kapten Divisi Kelima\NGeng Tokyo Manji, Haruchiyo Sanzu.
Dialogue: 0,0:19:27.50,0:19:29.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sanzu... Maksudmu...{\i0}
Dialogue: 0,0:19:30.50,0:19:32.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mengenalnya?
Dialogue: 0,0:19:32.21,0:19:34.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, dia abang keduaku.
Dialogue: 0,0:19:35.21,0:19:36.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:19:36.30,0:19:38.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami tiga bersaudara misterius!
Dialogue: 0,0:19:38.17,0:19:40.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei! Pakai bajumu!
Dialogue: 0,0:19:40.26,0:19:42.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak apa-apa, aku pakai bra olahraga.
Dialogue: 0,0:19:42.59,0:19:44.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan itu intinya!
Dialogue: 0,0:19:45.72,0:19:48.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, Sanzu juga di Brahman sekarang?
Dialogue: 0,0:19:49.52,0:19:50.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:19:50.77,0:19:53.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia memihak Kanto Manji.
Dialogue: 0,0:19:53.06,0:19:54.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:19:54.86,0:19:57.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena dia membenciku.
Dialogue: 0,0:19:59.99,0:20:00.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Orang itu...{\i0}
Dialogue: 0,0:20:03.28,0:20:04.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jadi, itu Sanzu.{\i0}
Dialogue: 0,0:20:05.78,0:20:08.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jika dia juga bersama Mikey di masa depan...{\i0}
Dialogue: 0,0:20:08.62,0:20:13.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kanto Manji sungguh Bonten di masa depan.{\i0}
Dialogue: 0,0:20:14.88,0:20:17.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, ayo ke toko berikutnya, Hanagaki.
Dialogue: 0,0:20:17.59,0:20:19.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Lagi?
Dialogue: 0,0:20:24.22,0:20:26.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Untung aku bergabung dengan Brahman.{\i0}
Dialogue: 0,0:20:27.51,0:20:30.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sanzu jelas pemain kunci.{\i0}
Dialogue: 0,0:20:31.39,0:20:32.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dan gadis ini juga...{\i0}
Dialogue: 0,0:20:33.98,0:20:35.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada mesin penjual es krim otomatis.
Dialogue: 0,0:20:37.73,0:20:39.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kangen juga!
Dialogue: 0,0:20:39.11,0:20:41.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dahulu aku suka rasa cokelat min.
Dialogue: 0,0:20:42.65,0:20:44.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cokelat min?
Dialogue: 0,0:20:44.32,0:20:46.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasa min dan manis tak cocok, 'kan?
Dialogue: 0,0:20:51.12,0:20:52.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak!
Dialogue: 0,0:20:52.58,0:20:55.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya menarik!
Dialogue: 0,0:20:55.04,0:20:56.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, 'kan?
Dialogue: 0,0:20:56.17,0:20:59.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasa dingin min\Namat selaras dengan rasa manisnya.
Dialogue: 0,0:21:02.97,0:21:04.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti bayi dengan empeng.
Dialogue: 0,0:21:07.14,0:21:08.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih hari ini, Hanagaki.
Dialogue: 0,0:21:09.35,0:21:10.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyenangkan.
Dialogue: 0,0:21:11.14,0:21:14.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada rapat saat Tanabata, jangan lupa.
Dialogue: 0,0:21:14.39,0:21:15.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:21:15.98,0:21:18.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi sampai kapan kau pegang batang itu?
Dialogue: 0,0:21:23.03,0:21:25.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau makan rasa cokelat min\Ndenganmu lagi kapan-kapan.
Dialogue: 0,0:21:27.07,0:21:29.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kubelikan lagi. Janji.
Dialogue: 0,0:21:30.33,0:21:32.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan saja padaku untuk kubuang.
Dialogue: 0,0:21:33.95,0:21:35.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tak apa-apa.\N- Aku tak keberatan.
Dialogue: 0,0:21:36.29,0:21:38.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:21:48.01,0:21:49.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senju!
Dialogue: 0,0:21:50.26,0:21:51.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menepati...
Dialogue: 0,0:21:51.93,0:21:53.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}janjiku.
Dialogue: 0,0:21:59.61,0:22:01.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa?{\i0}
Dialogue: 0,0:22:02.02,0:22:03.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dah!
Dialogue: 0,0:22:05.28,0:22:08.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa itu tadi?{\i0}
Dialogue: 0,0:23:44.50,0:23:46.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hop. Putri Kaguya!
Dialogue: 0,0:23:47.25,0:23:51.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kita tak cepat membawanya pulang,\Npara dewa akan meneriaki kita lagi.
Dialogue: 0,0:23:52.51,0:23:53.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo!
Dialogue: 0,0:23:53.68,0:23:56.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau harus pakai pinggulmu,\Njika tidak, takkan terpotong.
Dialogue: 0,0:23:56.39,0:23:59.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bosan. Ayo bermain di tempat lain.
Dialogue: 0,0:23:59.06,0:24:01.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak bisa. Kita harus cari uang.
Dialogue: 0,0:24:01.85,0:24:04.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia memberi kita harta karun bulan\Ntempo hari!
Dialogue: 0,0:24:04.81,0:24:06.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tak perlu bekerja terlalu keras.
Dialogue: 0,0:24:06.94,0:24:10.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa. Itu hadiah dari Putri Kaguya.
Dialogue: 0,0:24:10.28,0:24:11.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, benar.
Dialogue: 0,0:24:11.49,0:24:14.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kita menjualnya,\Nperempuan tua itu akan marah.
Dialogue: 0,0:24:14.37,0:24:16.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Mau nasi kepal?\N- Tentu!
Dialogue: 0,0:24:16.70,0:24:18.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau kutancapkan bendera?
Dialogue: 0,0:24:18.08,0:24:19.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:24:19.87,0:24:21.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putri Kaguya...
Dialogue: 0,0:24:21.62,0:24:22.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa boleh buat.
Dialogue: 0,0:24:22.92,0:24:24.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan dimarahi lagi hari ini.
Dialogue: 0,0:24:24.92,0:24:26.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Terjemahan subtitle oleh Lia Agatha
