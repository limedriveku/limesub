Dialogue: 0,0:06:28.05,0:06:29.22,sign,,0000,0000,0000,,{\an8}GENERASI PERTAMA\NGENG TOKYO MANJI
Dialogue: 0,0:07:56.85,0:08:00.52,sign,,0000,0000,0000,,1 JANUARI 2005,\NMENGEJAR MATAHARI TERBIT PERTAMA
Dialogue: 0,0:10:31.33,0:10:33.71,sign,,0000,0000,0000,,GENG TOKYO MANJI
