Dialogue: 0,0:00:23.64,0:00:25.14,sign,,0000,0000,0000,,HOTEL PREMIUM HIBURAN DEWASA
Dialogue: 0,0:04:49.62,0:04:51.29,sign,,0000,0000,0000,,GENERASI PERTAMA TOKYO MANJI
Dialogue: 0,0:09:48.63,0:09:49.71,sign,,0000,0000,0000,,B1.
Dialogue: 0,0:12:50.06,0:12:52.31,sign,,0000,0000,0000,,TRINITY LAND
Dialogue: 0,0:17:15.74,0:17:18.12,sign,,0000,0000,0000,,BENGKEL SEPEDA MOTOR D & D
Dialogue: 0,0:23:41.08,0:23:43.00,sign,,0000,0000,0000,,FAIRY TALE REVENGERS - PETIT\N#7 "BALAS DENDAM PARA MENTERI!"
Dialogue: 0,0:24:17.70,0:24:18.70,sign,,0000,0000,0000,,GLEK!
Dialogue: 0,0:24:24.92,0:24:26.04,sign,,0000,0000,0000,,{\an8}BERSAMBUNG
Dialogue: 0,0:00:03.96,0:00:05.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senju!
Dialogue: 0,0:00:07.96,0:00:09.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanagaki...
Dialogue: 0,0:00:11.22,0:00:14.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menepati janjiu.
Dialogue: 0,0:00:15.80,0:00:18.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa-apaan itu?{\i0}
Dialogue: 0,0:00:18.68,0:00:21.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau melamun, Takemitchy?
Dialogue: 0,0:00:21.68,0:00:22.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:00:25.15,0:00:26.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kangen juga!
Dialogue: 0,0:00:27.11,0:00:29.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau masih tinggal di sini, ya?
Dialogue: 0,0:00:29.02,0:00:34.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inupi masih tinggal di atas bengkel,\Ndan penghidupanku masih agak sulit.
Dialogue: 0,0:00:34.24,0:00:37.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku membantu di sini\Nsebagai ganti diizinkan tinggal.
Dialogue: 0,0:00:39.03,0:00:41.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lantai empat, 'kan?
Dialogue: 0,0:00:41.04,0:00:42.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Ingatanmu bagus.
Dialogue: 0,0:00:43.50,0:00:45.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lantai empat.
Dialogue: 0,0:00:47.92,0:00:48.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Darah?{\i0}
Dialogue: 0,0:00:52.09,0:00:53.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:00:55.09,0:00:57.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tak ada apa-apa.{\i0}
Dialogue: 0,0:00:57.18,0:00:58.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:00:58.26,0:00:59.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak ada apa-apa.
Dialogue: 0,0:01:01.39,0:01:03.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Perasaan mendadak itu lagi.{\i0}
Dialogue: 0,0:01:03.77,0:01:06.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ada apa denganku?{\i0}
Dialogue: 0,0:02:39.07,0:02:43.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}#57 Sebuah firasat
Dialogue: 0,0:02:43.24,0:02:44.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku pulang.
Dialogue: 0,0:02:44.49,0:02:45.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Hei.
Dialogue: 0,0:02:46.70,0:02:49.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Ini Masawei. Dia membesarkanku.
Dialogue: 0,0:02:49.12,0:02:50.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Senang berkenalan.
Dialogue: 0,0:02:52.04,0:02:53.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kau pernah ke sini, ya?
Dialogue: 0,0:02:53.84,0:02:54.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Ya!
Dialogue: 0,0:02:56.21,0:02:59.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}- Ken, terima kasih atas tumpangannya.\N- Kembali.
Dialogue: 0,0:02:59.88,0:03:02.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ken, boleh minta nasihatmu nanti?
Dialogue: 0,0:03:02.30,0:03:04.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu, nanti.
Dialogue: 0,0:03:04.01,0:03:06.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau meraba otot perutmu hari ini.
Dialogue: 0,0:03:06.18,0:03:07.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:03:09.18,0:03:12.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini hari libur para perempuan\Nyang pernah kutemui?
Dialogue: 0,0:03:12.02,0:03:15.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka sudah tak ada.
Dialogue: 0,0:03:15.77,0:03:17.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perputaran di bisnis ini tinggi.
Dialogue: 0,0:03:22.11,0:03:25.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Entah kenapa\Nruangannya terasa lebih luas.
Dialogue: 0,0:03:25.03,0:03:28.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, kami sudah mengosongkan gudang.
Dialogue: 0,0:03:29.87,0:03:32.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak sekali foto Toman!
Dialogue: 0,0:03:32.17,0:03:33.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga ada.
Dialogue: 0,0:03:35.46,0:03:36.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Emma.{\i0}
Dialogue: 0,0:03:38.30,0:03:41.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai sekarang pun,\Nkudengar suara Emma di mimpiku.
Dialogue: 0,0:03:43.97,0:03:46.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Selamatkan Mikey."
Dialogue: 0,0:03:50.98,0:03:54.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak bisa meninggalkan Mikey.
Dialogue: 0,0:03:55.15,0:03:56.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Benar.{\i0}
Dialogue: 0,0:03:57.02,0:04:01.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Draken bahkan bergabung\Ndengan Brahman demi Mikey.{\i0}
Dialogue: 0,0:04:02.82,0:04:04.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jika aku bersama Draken, pasti...{\i0}
Dialogue: 0,0:04:07.41,0:04:08.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ceritakan, Takemitchy.
Dialogue: 0,0:04:08.99,0:04:10.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:04:10.12,0:04:12.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti apa Mikey di masa depan?
Dialogue: 0,0:04:19.38,0:04:20.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia kurus.
Dialogue: 0,0:04:21.51,0:04:24.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan lingkaran hitam\Ndi bawah matanya seperti jarang tidur.
Dialogue: 0,0:04:25.59,0:04:28.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia memimpin geng motor bernama "Bonten".
Dialogue: 0,0:04:28.81,0:04:32.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, lebih seperti organisasi kriminal.
Dialogue: 0,0:04:32.10,0:04:34.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Organisasi kriminal...
Dialogue: 0,0:04:34.35,0:04:35.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:04:36.65,0:04:40.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya dia tak bisa menahan\NDorongan Gelap di dalam dirinya.
Dialogue: 0,0:04:41.32,0:04:42.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dorongan Gelap...
Dialogue: 0,0:04:44.91,0:04:49.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi tak seperti semua masa depan\Nsebelumnya, Hina masih hidup.
Dialogue: 0,0:04:51.29,0:04:55.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Draken dan Mitsuya yang sebelumnya tewas{\i0}...\N{\i1}Chifuyu, Hakkai, Pah-chin, Peh-yan{\i0}...
Dialogue: 0,0:04:55.92,0:04:57.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mereka baik-baik saja.{\i0}
Dialogue: 0,0:05:00.05,0:05:03.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mikey berjanji kepadaku dua tahun lalu.
Dialogue: 0,0:05:05.13,0:05:09.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia berjanji melindungi semuanya\Nsampai kita bertemu lagi, 12 tahun lagi.
Dialogue: 0,0:05:11.06,0:05:13.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa depannya sesuai janjinya.
Dialogue: 0,0:05:14.52,0:05:15.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya saja...
Dialogue: 0,0:05:17.81,0:05:20.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hanya Mikey yang tak bahagia.
Dialogue: 0,0:05:26.40,0:05:27.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:05:28.70,0:05:30.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dorongan Gelap, ya?
Dialogue: 0,0:05:33.08,0:05:37.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terkadang dia bukan dirinya sendiri.
Dialogue: 0,0:05:38.71,0:05:41.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bahkan saat Toman masih segelintir orang.{\i0}
Dialogue: 0,0:05:42.50,0:05:45.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia menyadarinya sendiri,{\i0}
Dialogue: 0,0:05:45.42,0:05:46.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}tak bisa mengatasinya,{\i0}
Dialogue: 0,0:05:47.13,0:05:48.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dan itu menghancurkannya.{\i0}
Dialogue: 0,0:05:50.39,0:05:53.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tapi saat aku melihatnya di hari biasa,{\i0}
Dialogue: 0,0:05:54.39,0:05:56.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}rasanya aku hanya berkhayal.{\i0}
Dialogue: 0,0:05:59.52,0:06:01.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kalau dipikir-pikir,{\i0}
Dialogue: 0,0:06:01.11,0:06:05.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}mungkin aku juga melihat\Nbeberapa tanda dari Mikey.{\i0}
Dialogue: 0,0:06:06.15,0:06:11.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tapi aku senang dia menerimaku,\Nmemercayaiku.{\i0}
Dialogue: 0,0:06:15.50,0:06:18.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pasti berfirasat akan masa depan\Nyang berdampak pada semuanya.
Dialogue: 0,0:06:21.54,0:06:25.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, dia memilih untuk menjauhkan kita.
Dialogue: 0,0:06:26.42,0:06:28.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bukan hanya dengan menghilang,{\i0}
Dialogue: 0,0:06:29.43,0:06:31.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}tapi dengan menyakiti kita,{\i0}
Dialogue: 0,0:06:31.68,0:06:33.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}membuat kita membencinya.{\i0}
Dialogue: 0,0:06:34.43,0:06:36.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tak kusangka dia tega...{\i0}
Dialogue: 0,0:06:37.43,0:06:41.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak tahu apa sebenarnya\NDorongan Gelap ini.
Dialogue: 0,0:06:42.23,0:06:47.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi dengan membebaskan kita,\Ndia mengarahkan kita ke jalan yang benar.
Dialogue: 0,0:06:48.95,0:06:53.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu cara Mikey menepati janjinya kepadamu.{\i0}
Dialogue: 0,0:06:58.00,0:07:04.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin itu artinya dia melindungi kita\Ndari bahaya yang ada di dalam dirinya.
Dialogue: 0,0:07:04.88,0:07:07.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Janjinya kepadaku...
Dialogue: 0,0:07:09.92,0:07:11.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar bodoh.
Dialogue: 0,0:07:14.10,0:07:16.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang aku yakin, Takemitchy.
Dialogue: 0,0:07:16.77,0:07:19.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin aku melakukan hal yang benar.
Dialogue: 0,0:07:22.98,0:07:27.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa depan seharusnya sudah berbeda\Ndari yang kau lihat.
Dialogue: 0,0:07:27.94,0:07:29.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Benar.{\i0}
Dialogue: 0,0:07:29.94,0:07:33.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dengan bergabung dengan Brahman,\Naku sudah mengubah masa lalu.{\i0}
Dialogue: 0,0:07:34.99,0:07:38.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai sekarang, apa pun bisa terjadi.
Dialogue: 0,0:07:38.33,0:07:39.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau siap untuk itu?
Dialogue: 0,0:07:40.58,0:07:43.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akan membawa Mikey kembali.
Dialogue: 0,0:07:43.08,0:07:45.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akan menariknya dari Dorongan Gelap.
Dialogue: 0,0:07:45.84,0:07:47.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:07:47.05,0:07:48.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku akan menolongnya.{\i0}
Dialogue: 0,0:07:48.71,0:07:50.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa pun yang terjadi.{\i0}
Dialogue: 0,0:07:53.26,0:07:54.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf!
Dialogue: 0,0:07:57.97,0:07:59.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti darah.
Dialogue: 0,0:07:59.18,0:08:01.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lepaskan. Akan kucuci.
Dialogue: 0,0:08:02.77,0:08:04.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Seperti yang kulihat tadi!{\i0}
Dialogue: 0,0:08:05.86,0:08:07.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mungkinkah...{\i0}
Dialogue: 0,0:08:10.99,0:08:12.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa melihat masa depan?
Dialogue: 0,0:08:16.12,0:08:17.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:08:17.83,0:08:22.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka bahkan membawa yakuza\Nuntuk mengganggu bisnisku.
Dialogue: 0,0:08:23.16,0:08:26.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka mungkin akan mengincar keluargaku.
Dialogue: 0,0:08:26.54,0:08:28.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh aku minta bantuanmu?
Dialogue: 0,0:08:30.92,0:08:32.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa aku tak punya opsi.
Dialogue: 0,0:08:35.64,0:08:39.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan dukungan Brahman, kami jadi kuat.
Dialogue: 0,0:08:39.89,0:08:41.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengar.
Dialogue: 0,0:08:41.18,0:08:44.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pria biasa\Nyang terjun ke bisnis prostitusi.
Dialogue: 0,0:08:44.64,0:08:46.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya kau terjegal.
Dialogue: 0,0:08:46.56,0:08:47.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salahmu sendiri.
Dialogue: 0,0:08:48.98,0:08:51.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, permisi!
Dialogue: 0,0:08:53.74,0:08:55.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia klien besar, Senju.
Dialogue: 0,0:08:57.99,0:09:00.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu kita tak bisa\Nhanya melakukan bisnis bersih.
Dialogue: 0,0:09:01.66,0:09:05.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku kesal\Njika harus mengotori nama Brahman
Dialogue: 0,0:09:06.46,0:09:07.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk sampah seperti itu.
Dialogue: 0,0:09:07.88,0:09:09.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan libatkan emosimu.
Dialogue: 0,0:09:10.00,0:09:12.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah perbedaan\Nantara anak-anak dan orang dewasa.
Dialogue: 0,0:09:18.68,0:09:20.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mikey akan bersedia melakukannya.
Dialogue: 0,0:09:22.14,0:09:23.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitukah...
Dialogue: 0,0:09:30.32,0:09:33.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian mengadakan rapat Brahman\Ndi gedung biasa seperti ini?
Dialogue: 0,0:09:35.45,0:09:39.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Rupanya tidak biasa... Keamanannya gila.{\i0}
Dialogue: 0,0:09:46.00,0:09:48.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang mereka lakukan?
Dialogue: 0,0:09:50.79,0:09:53.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertarungan bawah tanah\Nyang diadakan Brahman.
Dialogue: 0,0:09:53.30,0:09:54.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:09:54.84,0:09:59.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para petinggi menontonnya\Ndi monitor dan bertaruh.
Dialogue: 0,0:09:59.22,0:10:02.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudmu judi?
Dialogue: 0,0:10:02.85,0:10:04.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira hari ini seharusnya rapat.
Dialogue: 0,0:10:05.23,0:10:09.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Profesi ini yang kita pakai\Nuntuk membangun pasukan elite.
Dialogue: 0,0:10:11.31,0:10:16.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah Brahman.\NGeng berandal tempur super.
Dialogue: 0,0:10:17.57,0:10:18.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cukup!
Dialogue: 0,0:10:21.83,0:10:23.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Matikan kameranya!
Dialogue: 0,0:10:23.28,0:10:24.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekian untuk malam ini!
Dialogue: 0,0:10:26.29,0:10:29.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senju!
Dialogue: 0,0:10:30.54,0:10:36.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan berkuasa di puncak pasukan elite ini,\Nyang terkuat dari semuanya...
Dialogue: 0,0:10:36.46,0:10:39.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senju!
Dialogue: 0,0:10:39.01,0:10:40.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}...adalah Senju Kawaragi.
Dialogue: 0,0:10:49.06,0:10:52.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang kita akan memulai\Nrapat umum Brahman.
Dialogue: 0,0:10:53.40,0:10:55.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuperkenalkan anggota baru.
Dialogue: 0,0:10:56.44,0:10:58.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maju! Takemichi Hanagaki!
Dialogue: 0,0:11:03.12,0:11:04.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertarungan 3/8!
Dialogue: 0,0:11:04.58,0:11:06.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halloween Berdarah!
Dialogue: 0,0:11:06.04,0:11:08.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Konflik Natal dengan Black Dragon!
Dialogue: 0,0:11:08.87,0:11:11.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan figur penting Insiden Kanto!
Dialogue: 0,0:11:12.92,0:11:16.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mantan Kapten Divisi Satu\NGeng Tokyo Manji yang legendaris,
Dialogue: 0,0:11:16.34,0:11:18.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan penerus terakhir Black Dragon!
Dialogue: 0,0:11:25.39,0:11:28.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang di Brahman,\NTakemichi Hanagaki.
Dialogue: 0,0:11:37.23,0:11:44.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada 14 Juli, Brahman akan menyerang\NKanto Manji dan Rokuhara Tandai bersamaan!
Dialogue: 0,0:11:44.32,0:11:47.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akan memulai Perang Tiga Raksasa!
Dialogue: 0,0:11:52.79,0:11:56.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ini akan membawaku ke Mikey.{\i0}
Dialogue: 0,0:12:03.13,0:12:05.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya! Berjalan lancar berkatmu.
Dialogue: 0,0:12:06.26,0:12:10.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putaran mesinnya terasa bagus,\Ndan tak ada kebocoran oli sejauh ini.
Dialogue: 0,0:12:10.52,0:12:14.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bagus. Jika terjadi sesuatu\Ndengan sepeda motornya, hubungi saja.{\i0}
Dialogue: 0,0:12:14.60,0:12:16.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, terima kasih.
Dialogue: 0,0:12:21.57,0:12:25.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Draken.\N{\i1}- Apa?{\i0}
Dialogue: 0,0:12:25.28,0:12:28.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senju Kawaragi itu orang seperti apa?
Dialogue: 0,0:12:29.20,0:12:30.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa maksudmu, "Seperti apa?"{\i0}
Dialogue: 0,0:12:31.12,0:12:34.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudku, dia tampak berbeda\Nsetiap kali aku melihatnya.
Dialogue: 0,0:12:45.22,0:12:46.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senju?
Dialogue: 0,0:12:47.80,0:12:49.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kencan.
Dialogue: 0,0:12:52.31,0:12:55.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tinggi sekali, Hanagaki.
Dialogue: 0,0:12:56.48,0:13:00.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Amat berkilau.\NTerakhir ke sini, aku kelas dua SD.
Dialogue: 0,0:13:07.53,0:13:11.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sungguh, dia seperti orang yang berbeda\Nsetiap kali kami bertemu.{\i0}
Dialogue: 0,0:13:12.20,0:13:15.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau baru belanja banyak baju.
Dialogue: 0,0:13:15.33,0:13:17.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa pakai seragam geng Brahman?
Dialogue: 0,0:13:17.29,0:13:21.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada akhirnya, ini yang paling nyaman.
Dialogue: 0,0:13:21.13,0:13:24.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo! Kuda hitam!
Dialogue: 0,0:13:24.34,0:13:27.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bersemangat juga\Nnaik wahana anak-anak.
Dialogue: 0,0:13:28.14,0:13:30.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia sulit ditebak.{\i0}
Dialogue: 0,0:13:30.10,0:13:32.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku tak tahu apa yang dipikirkannya.{\i0}
Dialogue: 0,0:13:36.44,0:13:38.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk Perang Tiga Raksasa tanggal 14 Juli,
Dialogue: 0,0:13:39.48,0:13:42.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau dan Draken akan menyerang Kanto Manji.
Dialogue: 0,0:13:42.86,0:13:43.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:13:44.57,0:13:47.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dan Takeomi\Nakan menghadapi Rokuhara Tandai.
Dialogue: 0,0:13:49.16,0:13:53.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, aku mau menyelesaikannya\Ndengan kekuatanku sendiri.
Dialogue: 0,0:13:54.75,0:13:58.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau mengalahkan Mikey dan South\Ndan menjadi nomor satu.
Dialogue: 0,0:14:05.67,0:14:06.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini dia.
Dialogue: 0,0:14:06.76,0:14:08.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:14:10.68,0:14:13.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa mati!
Dialogue: 0,0:14:15.43,0:14:18.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takeomi berubah.
Dialogue: 0,0:14:19.44,0:14:24.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pikir membuat Brahman besar\Nlebih penting daripada menguatkannya.
Dialogue: 0,0:14:26.61,0:14:29.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Toman menjadi besar karena kuat, 'kan?
Dialogue: 0,0:14:30.20,0:14:33.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari bicarakan ini di tempat yang tenang.
Dialogue: 0,0:14:34.54,0:14:38.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Incaran Takeomi\Nadalah hal besar yang berbeda.
Dialogue: 0,0:14:39.04,0:14:41.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa lebih rumit.
Dialogue: 0,0:14:41.92,0:14:44.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini tak seperti yang kubayangkan.
Dialogue: 0,0:14:46.84,0:14:51.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu banyak orang terseret,\Ndan beberapa takkan berakhir bahagia.
Dialogue: 0,0:14:54.35,0:14:55.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itulah...
Dialogue: 0,0:14:58.81,0:15:00.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Datang lagi.
Dialogue: 0,0:15:00.02,0:15:01.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:15:03.77,0:15:08.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya, sebelum jadi besar, aku mau\Nmenyelesaikan masalah di Era Tiga Titan!
Dialogue: 0,0:15:08.07,0:15:11.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bukan tempat untuk membicarakan ini!
Dialogue: 0,0:15:19.00,0:15:20.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku merasa mual.
Dialogue: 0,0:15:20.25,0:15:22.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat, Hanagaki.
Dialogue: 0,0:15:22.08,0:15:23.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kertas {\i1}tanzaku{\i0}.
Dialogue: 0,0:15:24.29,0:15:27.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini Tanabata, ya?
Dialogue: 0,0:15:29.59,0:15:31.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buat permohonan...
Dialogue: 0,0:15:32.55,0:15:34.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tulis sesuatu juga, Hanagaki.
Dialogue: 0,0:15:35.22,0:15:36.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu.
Dialogue: 0,0:15:41.64,0:15:42.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kau tulis?
Dialogue: 0,0:15:44.44,0:15:46.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Menghajar Mikey."
Dialogue: 0,0:15:47.90,0:15:48.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pria sederhana.
Dialogue: 0,0:15:48.99,0:15:52.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terserah. Aku hanya menulis\Nmotivasiku untuk masa depan.
Dialogue: 0,0:15:52.66,0:15:55.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, motivasiku adalah...
Dialogue: 0,0:15:56.70,0:15:57.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini.
Dialogue: 0,0:15:59.75,0:16:01.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Melindungi Hanagaki."
Dialogue: 0,0:16:01.62,0:16:04.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia terus terang sekali.{\i0}
Dialogue: 0,0:16:04.13,0:16:05.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:16:05.84,0:16:07.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini kali pertamaku\Nmelakukan hal seperti ini.
Dialogue: 0,0:16:10.17,0:16:12.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bolehkah kuanggap kita ini berteman?
Dialogue: 0,0:16:15.68,0:16:16.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu.
Dialogue: 0,0:16:18.60,0:16:20.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja.
Dialogue: 0,0:16:21.68,0:16:25.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku juga harus melindungimu\Njika terjadi sesuatu.
Dialogue: 0,0:16:25.27,0:16:26.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bodoh.
Dialogue: 0,0:16:26.98,0:16:28.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Janji yang tak berguna.
Dialogue: 0,0:16:28.86,0:16:30.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, aku lebih kuat darimu.
Dialogue: 0,0:16:32.20,0:16:33.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:16:35.16,0:16:37.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi terima kasih.
Dialogue: 0,0:16:41.16,0:16:42.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senju!
Dialogue: 0,0:16:45.50,0:16:46.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanagaki...
Dialogue: 0,0:16:47.63,0:16:50.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menepati janjiku.
Dialogue: 0,0:16:50.67,0:16:51.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Terjadi lagi.{\i0}
Dialogue: 0,0:16:52.47,0:16:55.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa? Taman hiburan?{\i0}
Dialogue: 0,0:16:56.22,0:16:57.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Lebih jelas dari sebelumnya.{\i0}
Dialogue: 0,0:16:59.56,0:17:01.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, Hanagaki?
Dialogue: 0,0:17:01.77,0:17:03.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa itu tadi?{\i0}
Dialogue: 0,0:17:06.23,0:17:07.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hujan.
Dialogue: 0,0:17:07.81,0:17:10.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Hujan, taman hiburan...{\i0}
Dialogue: 0,0:17:13.57,0:17:14.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mungkinkah...{\i0}
Dialogue: 0,0:17:19.83,0:17:22.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah bulan Juli, tapi hujan terus.
Dialogue: 0,0:17:24.21,0:17:25.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Draken!
Dialogue: 0,0:17:27.63,0:17:28.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, Inupi?
Dialogue: 0,0:17:28.83,0:17:30.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dengar kabar buruk.
Dialogue: 0,0:17:30.96,0:17:32.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanagaki dalam bahaya.
Dialogue: 0,0:17:36.30,0:17:38.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hujannya tak kunjung reda.
Dialogue: 0,0:17:43.06,0:17:46.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, Hanagaki?\NKau belum makan sama sekali.
Dialogue: 0,0:17:46.06,0:17:47.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:17:48.10,0:17:50.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Aku mau ke kamar mandi sebentar.\N- Baik.
Dialogue: 0,0:17:56.70,0:17:57.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku harus bagaimana?{\i0}
Dialogue: 0,0:17:58.53,0:18:01.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jika itu sungguh akan terjadi,{\i0}
Dialogue: 0,0:18:01.99,0:18:04.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}maka hari ini, di sini, Senju akan...{\i0}
Dialogue: 0,0:18:06.04,0:18:08.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial! Aku melamun.
Dialogue: 0,0:18:09.71,0:18:11.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senju!
Dialogue: 0,0:18:12.63,0:18:14.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kau ke mana, Senju?{\i0}
Dialogue: 0,0:18:24.52,0:18:28.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami mencarimu, Takemichi Hanagaki.
Dialogue: 0,0:18:29.60,0:18:31.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku yang mereka incar?{\i0}
Dialogue: 0,0:18:31.81,0:18:33.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tunggu. Kalau begitu, Senju...{\i0}
Dialogue: 0,0:18:34.65,0:18:37.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menepati janjimu.
Dialogue: 0,0:18:38.61,0:18:39.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanagaki!
Dialogue: 0,0:18:39.78,0:18:41.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senju!
Dialogue: 0,0:18:42.12,0:18:44.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia akan mati karena melindungiku!{\i0}
Dialogue: 0,0:18:44.58,0:18:46.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Jangan mendekat!\N- Jangan bergerak, Hanagaki!
Dialogue: 0,0:18:46.87,0:18:49.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Hentikan!\N- Berhenti, Senju!
Dialogue: 0,0:19:03.22,0:19:04.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kena kalian!
Dialogue: 0,0:19:07.60,0:19:08.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanagaki!
Dialogue: 0,0:19:08.81,0:19:10.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau baik-baik saja? Senju!
Dialogue: 0,0:19:11.98,0:19:12.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:19:13.56,0:19:14.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tak boleh mati.
Dialogue: 0,0:19:17.90,0:19:18.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial.
Dialogue: 0,0:19:18.99,0:19:21.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau menghindarinya, Berengsek?
Dialogue: 0,0:19:21.70,0:19:24.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sial, aku harus bagaimana?{\i0}
Dialogue: 0,0:19:24.16,0:19:26.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mati! Hanagaki!
Dialogue: 0,0:19:32.63,0:19:33.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:19:37.96,0:19:40.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau baik-baik saja, Takemitchy?
Dialogue: 0,0:19:40.63,0:19:42.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Draken!
Dialogue: 0,0:19:48.31,0:19:49.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hujannya deras sekali.
Dialogue: 0,0:19:50.73,0:19:53.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Ada apa, Bos?
Dialogue: 0,0:19:57.11,0:19:58.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Firasatku tak enak.
Dialogue: 0,0:20:00.36,0:20:01.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:20:01.74,0:20:02.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suara apa itu?
Dialogue: 0,0:20:15.63,0:20:18.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Draken.
Dialogue: 0,0:20:18.88,0:20:21.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melakukan sesuatu yang amat berbahaya...
Dialogue: 0,0:20:22.22,0:20:24.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senju! Kau baik-baik saja?\NKau tak terluka?
Dialogue: 0,0:20:24.80,0:20:27.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baik-baik saja.
Dialogue: 0,0:20:29.72,0:20:31.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau di sini?
Dialogue: 0,0:20:32.44,0:20:36.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inupi mendengar bahwa kau diincar.
Dialogue: 0,0:20:37.27,0:20:38.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:20:38.36,0:20:40.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka mungkin mau menjadi dikenal.
Dialogue: 0,0:20:40.53,0:20:42.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa aku?
Dialogue: 0,0:20:42.95,0:20:47.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau... Berdasarkan rekam jejakmu,\Nkau orang penting.
Dialogue: 0,0:20:47.32,0:20:49.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu, memakai pistol...
Dialogue: 0,0:20:50.87,0:20:54.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perang Tiga Raksasa bukan\Nsekadar pertarungan bocah lagi.
Dialogue: 0,0:20:55.08,0:20:58.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keserakahan dan ambisi, terjerat\Ndengan uang dan kepentingan pribadi.
Dialogue: 0,0:20:58.38,0:21:00.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keinginan setiap orang kini berbeda.
Dialogue: 0,0:21:02.42,0:21:06.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mikey mungkin sudah menduganya.
Dialogue: 0,0:21:07.05,0:21:11.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kulihat Senju mati di sini, melindungiku.
Dialogue: 0,0:21:12.52,0:21:15.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya aku mulai bisa\Nmelihat sedikit ke masa depan.
Dialogue: 0,0:21:16.56,0:21:18.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku berhasil menghentikannya.
Dialogue: 0,0:21:20.02,0:21:24.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkat kau, Draken,\Nsalah satu masa depan terburuk berubah.
Dialogue: 0,0:21:25.07,0:21:26.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:21:28.49,0:21:29.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baguslah.
Dialogue: 0,0:21:31.70,0:21:34.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kita juga harus pergi dari sini.
Dialogue: 0,0:21:34.29,0:21:35.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kacau jika ramai.
Dialogue: 0,0:21:36.46,0:21:37.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, kau benar.
Dialogue: 0,0:21:40.46,0:21:41.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Draken?
Dialogue: 0,0:21:41.88,0:21:42.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takemichi.
Dialogue: 0,0:21:45.22,0:21:46.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beri tahu Mikey sesuatu untukku.
Dialogue: 0,0:21:49.64,0:21:55.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katakan padanya jangan membuatku\Nterlalu mencemaskannya.
Dialogue: 0,0:21:56.52,0:21:58.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudmu? Katakan sendiri padanya.
Dialogue: 0,0:22:05.57,0:22:08.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya bisa sejauh ini.
Dialogue: 0,0:23:45.17,0:23:47.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berapa banyak lagi yang harus kita gali?
Dialogue: 0,0:23:47.09,0:23:49.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada lampu di bawah sini.
Dialogue: 0,0:23:49.05,0:23:51.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin ada lebih banyak harta karun juga.
Dialogue: 0,0:23:51.51,0:23:56.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tahu apa yang terjadi\Njika tak ada apa pun, 'kan?
Dialogue: 0,0:23:58.93,0:24:00.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam juga.
Dialogue: 0,0:24:00.43,0:24:02.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, kau masuk lebih dahulu.
Dialogue: 0,0:24:05.19,0:24:06.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sakit!
Dialogue: 0,0:24:07.78,0:24:09.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh ada harta karun.
Dialogue: 0,0:24:10.61,0:24:12.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat keluarkan dan pergi dari sini.
Dialogue: 0,0:24:12.99,0:24:15.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, cepat ambil semuanya.
Dialogue: 0,0:24:15.45,0:24:17.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Kenapa kalian di sini?
Dialogue: 0,0:24:19.37,0:24:22.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian mau pergi membawa\Nbarang-barang kami?
Dialogue: 0,0:24:22.75,0:24:23.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini...
Dialogue: 0,0:24:26.04,0:24:28.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Diterjemahkan oleh Lia Agatha
