Dialogue: 0,0:00:01.29,0:00:03.62,sign,,0000,0000,0000,,16 MARET 2006
Dialogue: 0,0:00:28.65,0:00:29.73,sign,,0000,0000,0000,,GEMURUH
Dialogue: 0,0:00:55.59,0:00:57.22,sign,,0000,0000,0000,,"T2?"
Dialogue: 0,0:00:59.97,0:01:01.56,sign,,0000,0000,0000,,T2D2.
Dialogue: 0,0:01:04.48,0:01:06.94,sign,,0000,0000,0000,,PERJALANAN WAKTU MENEGANGKAN YANG HEBAT\NRENCANA T2D2.
Dialogue: 0,0:03:13.06,0:03:14.52,sign,,0000,0000,0000,,16 MARET
Dialogue: 0,0:18:44.37,0:18:46.12,sign,,0000,0000,0000,,{\an8}BEBERAPA HARI KEMUDIAN
Dialogue: 0,0:19:08.43,0:19:09.85,sign,,0000,0000,0000,,RAMEN - SETAN KEMBAR
Dialogue: 0,0:19:48.77,0:19:50.68,sign,,0000,0000,0000,,GENERASI PERTAMA\NTOKYO MANJI
Dialogue: 0,0:21:07.22,0:21:08.30,sign,,0000,0000,0000,,BENGKEL SEPEDA MOTOR D & D
Dialogue: 0,0:21:42.59,0:21:43.67,sign,,0000,0000,0000,,{\an8}GENG MOTOR
Dialogue: 0,0:23:41.00,0:23:42.08,sign,,0000,0000,0000,,FAIRY TALE REVENGERS\NPETIT
Dialogue: 0,0:23:42.08,0:23:43.00,sign,,0000,0000,0000,,#2 "KEMBALIKAN TANDUK YANG PATAH!"
Dialogue: 0,0:23:58.52,0:23:59.60,sign,,0000,0000,0000,,BATU
Dialogue: 0,0:24:01.19,0:24:02.27,sign,,0000,0000,0000,,BUNGA
Dialogue: 0,0:24:04.44,0:24:06.02,sign,,0000,0000,0000,,TELINGA KELINCI
Dialogue: 0,0:24:25.88,0:24:26.92,sign,,0000,0000,0000,,{\an8}BERSAMBUNG
Dialogue: 0,0:00:05.08,0:00:07.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau menjelajahi waktu.
Dialogue: 0,0:00:09.42,0:00:10.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah…
Dialogue: 0,0:00:11.38,0:00:13.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya kau kembali ke 12 tahun\Ndi masa depan.
Dialogue: 0,0:00:14.43,0:00:15.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan merindukanmu.
Dialogue: 0,0:00:16.51,0:00:19.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak. Aku mau kembali ke dua hari lalu.
Dialogue: 0,0:00:20.81,0:00:23.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dua hari lalu adalah White Day,
Dialogue: 0,0:00:23.89,0:00:26.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan aku lupa memberi Hina hadiahnya!
Dialogue: 0,0:00:26.77,0:00:28.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Hina akan membunuhku!{\i0}
Dialogue: 0,0:00:29.73,0:00:32.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Habislah aku, Chifuyu!
Dialogue: 0,0:00:32.03,0:00:33.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak bisa menghadapi Hina!
Dialogue: 0,0:00:33.95,0:00:36.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bodoh, jangan lepaskan setangnya!\NJangan banyak bergerak!
Dialogue: 0,0:00:41.70,0:00:44.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Chifuyu.
Dialogue: 0,0:00:44.08,0:00:45.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takemitchy.
Dialogue: 0,0:00:45.17,0:00:46.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya?
Dialogue: 0,0:00:46.33,0:00:48.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau hanya perlu melakukan sesuatu\Nuntuk Hina
Dialogue: 0,0:00:48.42,0:00:50.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebagai imbalan Hari Kasih Sayang, 'kan?
Dialogue: 0,0:00:51.63,0:00:53.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan kepadaku!
Dialogue: 0,0:00:53.13,0:00:55.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rencana T2D2 yang Hebat!
Dialogue: 0,0:00:57.76,0:00:59.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu? Apa maksudmu?
Dialogue: 0,0:01:01.56,0:01:04.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rencana Perjalanan Waktu\NMenegangkan yang Hebat!
Dialogue: 0,0:02:40.78,0:02:41.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Untuk apa ini?
Dialogue: 0,0:02:41.87,0:02:43.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}#52 Tertinggal di masa lalu
Dialogue: 0,0:02:43.08,0:02:45.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}- Ini senjata rahasia cinta.\N- Apa?
Dialogue: 0,0:02:45.33,0:02:50.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kita akan mengubah hadiah\Nyang kau lupakan menjadi kejutan dramatis.
Dialogue: 0,0:02:50.83,0:02:53.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hina akan sangat senang.
Dialogue: 0,0:02:53.79,0:02:56.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutmu ini akan berhasil?
Dialogue: 0,0:02:56.88,0:03:00.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan kotak polkadot, pita,\Ndan buku catatan ini?
Dialogue: 0,0:03:01.26,0:03:02.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takemitchy,
Dialogue: 0,0:03:02.80,0:03:08.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}gadis di setiap era\Nsuka polkadot, pita, dan kejutan.
Dialogue: 0,0:03:09.02,0:03:10.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belajar itu dari manga.
Dialogue: 0,0:03:11.40,0:03:13.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa aku bisa mengandalkanmu!
Dialogue: 0,0:03:14.52,0:03:17.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama, tulis tanggal di tiga kotak,\Ndimulai dari dua hari lalu.
Dialogue: 0,0:03:17.94,0:03:21.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu berikan surat ini kepada Hina.
Dialogue: 0,0:03:22.95,0:03:27.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Naik dengan kaki, turun dengan bokong.\NBenda apa itu?"
Dialogue: 0,0:03:27.83,0:03:28.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perosotan?
Dialogue: 0,0:03:28.91,0:03:31.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Benar! Kau memang cerdas, Takemitchy.
Dialogue: 0,0:03:31.62,0:03:34.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, saat Hina melihat perosotannya…
Dialogue: 0,0:03:35.92,0:03:40.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia akan melihat kotak 16 Maret\Nberisi teka-teki lain.
Dialogue: 0,0:03:41.84,0:03:45.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Didorong maju-mundur,\Ntapi tak berpindah. Benda apa ini?"
Dialogue: 0,0:03:48.43,0:03:49.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayunan!
Dialogue: 0,0:03:49.52,0:03:51.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau Edison, ya?
Dialogue: 0,0:03:51.73,0:03:58.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu saat Hina memeriksa ayunannya,\Ndia akan menemukan kotak 15 Maret!
Dialogue: 0,0:03:58.48,0:04:01.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini luar biasa, Chifuyu!
Dialogue: 0,0:04:01.15,0:04:03.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya sungguh seperti menjelajahi waktu!
Dialogue: 0,0:04:03.82,0:04:05.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teka-teki terakhir, Takemitchy.
Dialogue: 0,0:04:07.33,0:04:08.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:04:08.41,0:04:11.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}"Jatuh di dalamnya takkan melukaimu,
Dialogue: 0,0:04:11.46,0:04:14.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}tapi bisa dilempar ke mata orang lain.\NBenda apa ini?"
Dialogue: 0,0:04:19.09,0:04:20.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:04:20.26,0:04:21.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini tak seperti dirimu.
Dialogue: 0,0:04:21.55,0:04:23.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak paham, Chifuyu.
Dialogue: 0,0:04:23.26,0:04:24.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar bodoh!
Dialogue: 0,0:04:26.09,0:04:29.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau takkan bisa memenangkan\Nhati Hina seperti itu!
Dialogue: 0,0:04:32.81,0:04:35.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Pasir!\N- Benar!
Dialogue: 0,0:04:35.10,0:04:39.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hadiah White Day-nya\Nada di dalam kotak terakhir!
Dialogue: 0,0:04:39.19,0:04:43.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan itu, maknanya adalah,\N"Kejutan ini hanya bisa terjadi hari ini."
Dialogue: 0,0:04:43.07,0:04:45.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luar biasa, Chifuyu.
Dialogue: 0,0:04:45.20,0:04:48.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau lebih pintar dari Socrates!
Dialogue: 0,0:04:48.12,0:04:50.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ini akan mengubah segalanya!\N- Ya!
Dialogue: 0,0:04:52.29,0:04:54.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang yang tersisa hanyalah masa kini.
Dialogue: 0,0:04:55.50,0:04:57.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Cincin?
Dialogue: 0,0:04:57.00,0:04:58.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Ya.
Dialogue: 0,0:04:58.08,0:05:00.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah apa Hina akan menyukainya.
Dialogue: 0,0:05:00.55,0:05:03.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja.\NMari panggil dia kemari sekarang.
Dialogue: 0,0:05:03.17,0:05:05.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan mengawasi dari kejauhan.
Dialogue: 0,0:05:05.38,0:05:06.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:05:13.23,0:05:14.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia datang, Takemitchy.
Dialogue: 0,0:05:17.60,0:05:18.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hina.
Dialogue: 0,0:05:23.49,0:05:24.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takemichi.
Dialogue: 0,0:05:25.45,0:05:30.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pertama, aku minta maaf kepadanya,\Nlalu memberikan surat itu.{\i0}
Dialogue: 0,0:05:30.78,0:05:33.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sial, tiba-tiba aku jadi gugup.{\i0}
Dialogue: 0,0:05:36.67,0:05:38.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku.
Dialogue: 0,0:05:39.29,0:05:40.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hina.
Dialogue: 0,0:05:40.50,0:05:42.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf karena aku murung selama ini.
Dialogue: 0,0:05:43.96,0:05:47.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal, kau lebih terluka daripada aku.
Dialogue: 0,0:05:48.89,0:05:50.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak kedengaran.
Dialogue: 0,0:05:50.80,0:05:52.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa Hina menundukkan kepala?
Dialogue: 0,0:05:53.52,0:05:57.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi sejak hari itu,\Naku tak bisa tidur nyenyak.
Dialogue: 0,0:05:59.19,0:06:02.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak Kisaki mati di hadapanku.
Dialogue: 0,0:06:04.48,0:06:06.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tepat di hadapanku.
Dialogue: 0,0:06:06.61,0:06:11.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak saat itu, aku takut.
Dialogue: 0,0:06:13.95,0:06:17.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku terus merasa apa yang terjadi\Npada Kisaki dan Emma
Dialogue: 0,0:06:17.29,0:06:21.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah kesalahanku.
Dialogue: 0,0:06:22.21,0:06:23.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hina…
Dialogue: 0,0:06:24.46,0:06:26.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tak kuduga kau merasa seperti ini.{\i0}
Dialogue: 0,0:06:28.17,0:06:30.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kau lakukan, Takemitchy?
Dialogue: 0,0:06:30.64,0:06:32.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah lupa?
Dialogue: 0,0:06:32.14,0:06:34.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rencana Perjalanan Waktu\NMenegangkan yang Hebat.
Dialogue: 0,0:06:34.76,0:06:36.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat di bawah perosotan!
Dialogue: 0,0:06:39.06,0:06:40.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hina.
Dialogue: 0,0:06:43.48,0:06:44.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bodoh!
Dialogue: 0,0:06:44.61,0:06:45.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kotak pasir terakhir!
Dialogue: 0,0:06:46.86,0:06:48.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hina, ini.
Dialogue: 0,0:06:51.16,0:06:52.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cincin?
Dialogue: 0,0:06:52.37,0:06:53.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:06:53.66,0:06:56.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf hadiah White Day untukmu terlambat.
Dialogue: 0,0:06:58.16,0:07:00.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang terjadi?
Dialogue: 0,0:07:01.00,0:07:06.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak punya bakat khusus,\Ndan mungkin takkan pernah kaya.
Dialogue: 0,0:07:07.80,0:07:08.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi…
Dialogue: 0,0:07:10.01,0:07:14.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dalam hal membahagiakanmu,\Ntak ada orang lain yang bisa melakukannya.
Dialogue: 0,0:07:18.52,0:07:19.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon…
Dialogue: 0,0:07:20.64,0:07:22.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menikahlah denganku!
Dialogue: 0,0:07:23.77,0:07:26.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Apa?\N- Setiap kali kau takut,
Dialogue: 0,0:07:26.40,0:07:28.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan hadir untuk melindungimu\Nagar kau merasa aman.
Dialogue: 0,0:07:30.36,0:07:33.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kumohon, jangan menangis lagi.
Dialogue: 0,0:07:36.49,0:07:37.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang terjadi?
Dialogue: 0,0:07:39.16,0:07:41.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari menikah 12 tahun lagi.
Dialogue: 0,0:07:42.71,0:07:44.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian mau menikah?
Dialogue: 0,0:07:44.58,0:07:48.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, tak perlu berteriak.
Dialogue: 0,0:07:48.05,0:07:50.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jelas, kami takkan menikah\Nsampai kami dewasa.
Dialogue: 0,0:07:50.38,0:07:52.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tiba-tiba melamar.
Dialogue: 0,0:07:52.80,0:07:54.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jantungku sampai berdegup kencang.
Dialogue: 0,0:07:55.47,0:07:57.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf membuatmu tiba-tiba\Nmenemui kami, Naoto.
Dialogue: 0,0:07:59.31,0:08:01.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini taman tempat kita\Npertama berjabat tangan.
Dialogue: 0,0:08:03.19,0:08:06.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, rasanya tepat\Nberjabat tangan terakhir di sini juga.
Dialogue: 0,0:08:06.65,0:08:08.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Naoto.
Dialogue: 0,0:08:09.07,0:08:15.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa di sini karena kau memercayaiku\Ndan karena kau membantuku di masa depan.
Dialogue: 0,0:08:15.12,0:08:16.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:08:16.20,0:08:19.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti kakakku dan aku selamat?
Dialogue: 0,0:08:19.95,0:08:21.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Aku yakin.
Dialogue: 0,0:08:23.33,0:08:24.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Naoto, jabat tanganku.
Dialogue: 0,0:08:30.67,0:08:32.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chifuyu. Hina.
Dialogue: 0,0:08:34.09,0:08:35.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai jumpa di masa depan.
Dialogue: 0,0:08:42.77,0:08:44.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kembali.
Dialogue: 0,0:08:45.35,0:08:46.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kalau begitu, sudah pasti.{\i0}
Dialogue: 0,0:08:46.90,0:08:50.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Naoto masih hidup!{\i0}
Dialogue: 0,0:08:51.40,0:08:53.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tapi kenapa aku memakai tuksedo?{\i0}
Dialogue: 0,0:08:54.11,0:08:56.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Di mana aku?{\i0}
Dialogue: 0,0:08:58.32,0:09:00.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tuksedo, lonceng berbunyi…{\i0}
Dialogue: 0,0:09:01.08,0:09:03.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa? Mungkinkah…{\i0}
Dialogue: 0,0:09:03.04,0:09:04.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mari menikah.{\i0}
Dialogue: 0,0:09:05.67,0:09:06.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tak mungkin!{\i0}
Dialogue: 0,0:09:11.05,0:09:12.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau terlambat.
Dialogue: 0,0:09:13.01,0:09:14.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, resepsinya akan segera dimulai.
Dialogue: 0,0:09:15.84,0:09:16.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hina…
Dialogue: 0,0:09:18.39,0:09:20.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Akhirnya aku…{\i0}
Dialogue: 0,0:09:21.26,0:09:22.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Akhirnya…{\i0}
Dialogue: 0,0:09:24.85,0:09:27.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, jangan sampai\Nbintang acaranya menunggu.
Dialogue: 0,0:09:27.69,0:09:29.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bintang acara?
Dialogue: 0,0:09:29.36,0:09:31.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini pernikahan Hayashida, ingat?
Dialogue: 0,0:09:31.73,0:09:33.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa? Hayashida?{\i0}
Dialogue: 0,0:09:33.57,0:09:35.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, cepat.
Dialogue: 0,0:09:35.07,0:09:36.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tunggu!{\i0}
Dialogue: 0,0:09:36.78,0:09:38.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku tak paham apa yang terjadi!{\i0}
Dialogue: 0,0:09:42.99,0:09:44.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau terlambat, Takemitchy.
Dialogue: 0,0:09:44.79,0:09:46.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Apa?\N- Cepat duduk.
Dialogue: 0,0:09:46.96,0:09:51.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang, pasangan yang berbahagia,\Nkedua mempelai!
Dialogue: 0,0:09:53.96,0:09:55.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hayashida…
Dialogue: 0,0:09:55.80,0:09:57.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu Pah-chin?
Dialogue: 0,0:09:58.55,0:10:02.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah bergabung dengan kami\Ndi hari yang cerah ini,
Dialogue: 0,0:10:02.18,0:10:05.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tak berawan, langitnya cerah…
Dialogue: 0,0:10:05.39,0:10:06.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini ramalan cuaca?
Dialogue: 0,0:10:06.85,0:10:08.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diam! Otak Pah-chin benar-benar rusak.
Dialogue: 0,0:10:08.85,0:10:11.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Isinya hanya debu!
Dialogue: 0,0:10:11.44,0:10:13.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peh-yan selalu kasar.
Dialogue: 0,0:10:13.61,0:10:16.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Diam, Mitsuya!\N- Peh-yan, sudahlah.
Dialogue: 0,0:10:16.65,0:10:20.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian berisik sekali,\Nharus kubunuh kalian agar diam.
Dialogue: 0,0:10:20.07,0:10:21.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau yang paling berisik.
Dialogue: 0,0:10:21.62,0:10:24.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Pah-chin belum selesai berpidato.
Dialogue: 0,0:10:24.37,0:10:28.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya kejam sekali.\NYa, 'kan? Takemitchy.
Dialogue: 0,0:10:28.33,0:10:30.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih atas bantuan kalian!
Dialogue: 0,0:10:30.42,0:10:33.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa? Kau hanya berdiri melamun.
Dialogue: 0,0:10:33.00,0:10:35.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini momen bahagia, Takemichi.
Dialogue: 0,0:10:36.17,0:10:38.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Semua orang masih hidup.{\i0}
Dialogue: 0,0:10:39.43,0:10:43.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Semuanya tertawa, terlihat sangat bahagia.{\i0}
Dialogue: 0,0:10:45.31,0:10:46.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:10:47.39,0:10:48.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya…
Dialogue: 0,0:10:49.02,0:10:50.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak percaya.
Dialogue: 0,0:10:52.02,0:10:53.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Hari itu…{\i0}
Dialogue: 0,0:10:53.94,0:10:58.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku takkan menyerah apa pun yang terjadi,\Nsampai kau masih hidup di masa depan!
Dialogue: 0,0:10:59.53,0:11:00.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku bersumpah.{\i0}
Dialogue: 0,0:11:02.37,0:11:03.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dan sekarang, kau di sini…{\i0}
Dialogue: 0,0:11:05.03,0:11:06.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}tepat di depanku.{\i0}
Dialogue: 0,0:11:07.25,0:11:09.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pah-chin, tunjukkan kejantananmu!
Dialogue: 0,0:11:09.00,0:11:12.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Potong dalam satu gerakan!\N- Lakukan dengan keren!
Dialogue: 0,0:11:12.17,0:11:13.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memotong kue pasti mudah, 'kan?
Dialogue: 0,0:11:13.88,0:11:15.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ayo!\N- Cepatlah.
Dialogue: 0,0:11:15.34,0:11:16.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Cepat!\N- Cepat!
Dialogue: 0,0:11:16.67,0:11:18.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Diam.\N- Berisik!
Dialogue: 0,0:11:18.92,0:11:21.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu, Takemichi.
Dialogue: 0,0:11:21.38,0:11:22.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:11:22.55,0:11:26.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dua belas tahun lalu,\Nhari ini kau kembali ke sini, 'kan?
Dialogue: 0,0:11:28.98,0:11:30.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luar biasa, 'kan?
Dialogue: 0,0:11:31.02,0:11:35.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Usiamu saat itu sama denganku sekarang.
Dialogue: 0,0:11:37.65,0:11:42.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah lama kunantikan hari ini.
Dialogue: 0,0:11:43.57,0:11:45.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang kembali, Takemichi.
Dialogue: 0,0:11:47.95,0:11:49.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bukan mimpi, 'kan?
Dialogue: 0,0:11:49.66,0:11:51.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau kucubit pipimu?
Dialogue: 0,0:11:53.75,0:11:55.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan hanya aku yang menunggu.
Dialogue: 0,0:11:56.38,0:11:58.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini agak lucu.
Dialogue: 0,0:11:58.21,0:11:59.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagi kami, sudah 12 tahun.
Dialogue: 0,0:12:00.30,0:12:03.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi bagimu, kita baru berpamitan, 'kan?
Dialogue: 0,0:12:04.14,0:12:06.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di taman depan rumah Hina.
Dialogue: 0,0:12:06.68,0:12:08.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gila, bukan?
Dialogue: 0,0:12:08.60,0:12:13.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita masih hidup sekarang adalah berkatmu.
Dialogue: 0,0:12:13.44,0:12:14.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chifuyu…
Dialogue: 0,0:12:15.27,0:12:16.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Draken…
Dialogue: 0,0:12:16.77,0:12:19.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Takemitchy.
Dialogue: 0,0:12:20.78,0:12:22.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau hebat, Takemichi.
Dialogue: 0,0:12:23.20,0:12:25.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau tahu berapa banyak\Nnyawa yang kau selamatkan.
Dialogue: 0,0:12:27.08,0:12:29.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak bisa melakukannya sendirian.
Dialogue: 0,0:12:29.45,0:12:31.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian semua membantuku.
Dialogue: 0,0:12:32.41,0:12:33.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei!
Dialogue: 0,0:12:33.79,0:12:36.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa mereka bersenang-senang tanpa aku?
Dialogue: 0,0:12:36.79,0:12:38.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini hari istimewaku!
Dialogue: 0,0:12:38.67,0:12:39.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bodoh.
Dialogue: 0,0:12:39.75,0:12:42.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan hari istimewamu,\Ntapi pengantin perempuannya.
Dialogue: 0,0:12:42.34,0:12:44.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau hanya figuran, Pah-chin.
Dialogue: 0,0:12:44.01,0:12:45.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, tapi tetap saja…
Dialogue: 0,0:12:46.68,0:12:49.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pah-chin mengambil alih\Nbisnis keluarga dan menjadi kaya.
Dialogue: 0,0:12:49.76,0:12:52.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengantin perempuannya\Nadalah teman masa kecilnya.
Dialogue: 0,0:12:53.48,0:12:56.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peh-yan masih mendukung\NPah-chin sampai sekarang.
Dialogue: 0,0:12:56.44,0:13:00.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mitsuya adalah perancang busana.\NTapi dia baru saja mulai.
Dialogue: 0,0:13:01.03,0:13:03.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia memenangkan penghargaan\Ndi kompetisi besar.
Dialogue: 0,0:13:03.78,0:13:04.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:13:04.86,0:13:07.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan kau harus tahu.
Dialogue: 0,0:13:07.41,0:13:10.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Hakkai adalah model top di luar negeri.\N- Apa?
Dialogue: 0,0:13:10.58,0:13:14.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taka, cepat sukses\Nagar kita bisa bekerja sama.
Dialogue: 0,0:13:14.29,0:13:16.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau akan langsung pamer.
Dialogue: 0,0:13:16.21,0:13:19.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yuzuha adalah manajer Hakkai\Nyang cerdas dan cakap.
Dialogue: 0,0:13:19.04,0:13:22.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kawata bersaudara\Nmengelola kedai ramen bersama.
Dialogue: 0,0:13:22.92,0:13:25.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Benarkah?\N- Cobalah ramen kami kapan-kapan.
Dialogue: 0,0:13:25.88,0:13:28.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lezat sekali.
Dialogue: 0,0:13:28.30,0:13:30.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan tentu saja, nama kedainya\N"Setan Kembar".
Dialogue: 0,0:13:30.47,0:13:32.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah!
Dialogue: 0,0:13:32.22,0:13:34.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kazutora membantu di toko Chifuyu.
Dialogue: 0,0:13:34.89,0:13:36.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kau lihat?
Dialogue: 0,0:13:36.85,0:13:38.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Toko Chifuyu?
Dialogue: 0,0:13:38.44,0:13:40.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, begitulah.
Dialogue: 0,0:13:40.57,0:13:42.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Toko hewan peliharaan.\N- Apa?
Dialogue: 0,0:13:42.73,0:13:45.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah itu impianmu, Matsuno?
Dialogue: 0,0:13:45.03,0:13:47.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tokonya masih kecil, tapi…
Dialogue: 0,0:13:47.99,0:13:49.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:13:49.78,0:13:52.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Baguslah, Chifuyu.\N- Ya.
Dialogue: 0,0:13:52.45,0:13:55.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, ya. Kau memesan karburator\Nuntuk motor Takemitchy?
Dialogue: 0,0:13:55.91,0:13:58.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, seharusnya tiba besok.
Dialogue: 0,0:13:58.25,0:14:00.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Motorku…
Dialogue: 0,0:14:00.08,0:14:02.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang mengurus motormu selama ini.
Dialogue: 0,0:14:02.71,0:14:06.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Draken punya bengkel motor bersama Inupi.
Dialogue: 0,0:14:07.63,0:14:09.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Hebat{\i0}…
Dialogue: 0,0:14:09.01,0:14:10.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Semuanya{\i0}…
Dialogue: 0,0:14:11.01,0:14:12.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takemichi.
Dialogue: 0,0:14:14.93,0:14:16.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya kau kembali.
Dialogue: 0,0:14:19.23,0:14:21.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau berhasil, seperti dugaanku.
Dialogue: 0,0:14:23.44,0:14:25.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Naoto!
Dialogue: 0,0:14:25.53,0:14:28.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah kau masih hidup!
Dialogue: 0,0:14:29.28,0:14:32.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pemicunya. Kalau aku mati,
Dialogue: 0,0:14:32.45,0:14:34.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau takkan bisa kembali ke sini.
Dialogue: 0,0:14:34.79,0:14:36.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu, tapi…
Dialogue: 0,0:14:36.79,0:14:37.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takemichi…
Dialogue: 0,0:14:38.66,0:14:40.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misi selesai.
Dialogue: 0,0:14:42.75,0:14:44.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini dunia tempat kakakku masih hidup.
Dialogue: 0,0:14:47.09,0:14:48.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Benar.{\i0}
Dialogue: 0,0:14:49.51,0:14:51.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ini masa depan terbaik.{\i0}
Dialogue: 0,0:14:52.14,0:14:53.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berjanji.
Dialogue: 0,0:14:54.31,0:14:56.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai bertemu lagi\N12 tahun dari sekarang,
Dialogue: 0,0:14:56.81,0:15:00.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan kulindungi semua anggota Toman,\Ndan Hina juga.
Dialogue: 0,0:15:01.19,0:15:05.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sesuai janjimu,\Nkau melindungi semua orang, Mikey.{\i0}
Dialogue: 0,0:15:08.82,0:15:11.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, di mana Mikey hari ini?
Dialogue: 0,0:15:20.08,0:15:24.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, Mikey menjalankan bisnis\Ndi luar negeri?
Dialogue: 0,0:15:24.42,0:15:26.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luar biasa!
Dialogue: 0,0:15:26.00,0:15:29.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya dia bekerja di industri makanan,\Ntapi kira-kira apa?
Dialogue: 0,0:15:29.59,0:15:30.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejenis toko taiyaki?
Dialogue: 0,0:15:30.84,0:15:32.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin pasti lezat.
Dialogue: 0,0:15:32.76,0:15:35.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlalu sibuk untuk datang\Nmembuktikan semua berjalan lancar.
Dialogue: 0,0:15:35.97,0:15:38.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayang sekali, tapi apa boleh buat!
Dialogue: 0,0:15:38.02,0:15:41.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Kita juga sibuk.
Dialogue: 0,0:15:41.10,0:15:43.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah punya waktu,\Nkita bisa mengobrol dengan baik.
Dialogue: 0,0:15:43.73,0:15:45.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:15:45.31,0:15:47.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? "Kita"?
Dialogue: 0,0:15:47.32,0:15:48.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:15:48.65,0:15:51.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang adalah waktu tersibuk bagi kita.
Dialogue: 0,0:15:51.82,0:15:52.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:15:52.91,0:15:57.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pernikahan kita bulan Juni,\Ntiga bulan dari sekarang.
Dialogue: 0,0:15:57.37,0:15:58.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:15:58.91,0:16:01.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah menunggu selama 12 tahun.
Dialogue: 0,0:16:01.50,0:16:03.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hina.
Dialogue: 0,0:16:03.58,0:16:05.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah bekerja keras selama ini,
Dialogue: 0,0:16:05.42,0:16:08.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}memikul beban hidup\Norang lain di pundakmu.
Dialogue: 0,0:16:10.30,0:16:14.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita tebus\Ndengan bahagia sebisa mungkin.
Dialogue: 0,0:16:19.35,0:16:21.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, kita akan sibuk!
Dialogue: 0,0:16:21.68,0:16:25.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita sudah memesan tempat,\Ntapi anggarannya sudah menipis,
Dialogue: 0,0:16:25.27,0:16:26.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan gaunku bahkan belum siap.
Dialogue: 0,0:16:28.61,0:16:30.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku sudah sangat bahagia!{\i0}
Dialogue: 0,0:16:32.32,0:16:34.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hina akan menjadi istri yang baik.
Dialogue: 0,0:16:35.36,0:16:38.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penawarannya sangat keras\Nhingga aku sulit membalas.
Dialogue: 0,0:16:38.16,0:16:40.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini ruang kerjamu?
Dialogue: 0,0:16:41.20,0:16:43.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seorang kenalanku\Nkebetulan memiliki tempat ini.
Dialogue: 0,0:16:43.50,0:16:45.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya menyewa loteng dengan murah.
Dialogue: 0,0:16:47.38,0:16:51.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini gaun pengantin yang diminta Hina?
Dialogue: 0,0:16:52.63,0:16:54.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Bagaimana menurutmu?
Dialogue: 0,0:16:54.38,0:16:57.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cantiknya! Astaga.
Dialogue: 0,0:16:57.47,0:17:00.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taka, kami sudah selesai berbelanja!
Dialogue: 0,0:17:00.43,0:17:02.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lama juga.
Dialogue: 0,0:17:02.31,0:17:07.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami dikerumuni penggemar,\Ndan dia membatu lagi.
Dialogue: 0,0:17:08.77,0:17:10.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus sekali.
Dialogue: 0,0:17:10.23,0:17:11.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini?
Dialogue: 0,0:17:11.44,0:17:13.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kain untuk tuksedomu.
Dialogue: 0,0:17:13.99,0:17:16.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bergerak, Takemitchy.
Dialogue: 0,0:17:16.32,0:17:17.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:17:17.78,0:17:20.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taka sangat serius saat mengukur baju.
Dialogue: 0,0:17:20.37,0:17:22.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, di sinilah semuanya dipastikan.
Dialogue: 0,0:17:22.70,0:17:24.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:17:25.16,0:17:27.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajah seriusnya sangat tampan\Ndari samping.
Dialogue: 0,0:17:27.25,0:17:29.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diam, Hakkai. Jangan menggodaku.
Dialogue: 0,0:17:29.29,0:17:30.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kau luar biasa.
Dialogue: 0,0:17:30.80,0:17:35.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau baru saja mandiri\Ndan sudah ada pekerjaan?
Dialogue: 0,0:17:35.01,0:17:37.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini lebih seperti pekerjaan kasar.
Dialogue: 0,0:17:37.47,0:17:38.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Angkat tanganmu.
Dialogue: 0,0:17:39.60,0:17:42.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian akan kembali\Nke Prancis hari ini, 'kan?
Dialogue: 0,0:17:42.14,0:17:44.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mampirlah dulu ke "Setan Kembar".\NSungguh lezat.
Dialogue: 0,0:17:44.56,0:17:47.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sungguh tak mau makan\Nramen buatan mereka.
Dialogue: 0,0:17:47.65,0:17:50.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau bermain dengan anjing,\Njadi aku mau mampir ke Chifuyu.
Dialogue: 0,0:17:51.77,0:17:55.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau ke Draken\Nuntuk memacu mesin motorku.
Dialogue: 0,0:17:55.70,0:17:59.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memacu mesin motor selalu\Nmembangkitkan kenangan masa lalu.
Dialogue: 0,0:18:00.83,0:18:02.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dipikir-pikir, ini kali pertama
Dialogue: 0,0:18:02.74,0:18:05.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku menjahit pakaianmu\Nsejak seragam geng Toman dahulu.
Dialogue: 0,0:18:05.75,0:18:07.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, kurasa begitu.
Dialogue: 0,0:18:09.17,0:18:10.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beberapa hal tak berubah.
Dialogue: 0,0:18:13.59,0:18:16.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Semua orang sama seperti dahulu.{\i0}
Dialogue: 0,0:18:18.38,0:18:20.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih!
Dialogue: 0,0:18:21.72,0:18:24.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama seperti dahulu!
Dialogue: 0,0:18:24.93,0:18:29.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah DVD dikembalikan,\Nsegera kembalikan ke rak, Bos.
Dialogue: 0,0:18:30.65,0:18:31.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:18:35.65,0:18:37.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ruangan ini kotor seperti biasanya.
Dialogue: 0,0:18:40.53,0:18:42.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tapi aku bahagia.{\i0}
Dialogue: 0,0:18:46.12,0:18:49.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Konflik memanas yang melibatkan\Norganisasi kriminal "Bonten"{\i0}
Dialogue: 0,0:18:49.58,0:18:53.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}kini telah memakan\Nkorban sipil pertama mereka.{\i0}
Dialogue: 0,0:18:53.17,0:18:55.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kurasa geng seperti Toman\Nmasih ada sampai sekarang.
Dialogue: 0,0:18:55.71,0:18:59.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Terdapat rekaman eksklusif yang diyakini\Nmenampilkan anggota inti Bonten.{\i0}
Dialogue: 0,0:19:05.18,0:19:07.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tato itu{\i0}…
Dialogue: 0,0:19:09.85,0:19:13.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku merasa pernah melihat desain itu\Ndi suatu tempat.{\i0}
Dialogue: 0,0:19:13.98,0:19:16.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kau dengar aku, tidak?
Dialogue: 0,0:19:16.44,0:19:18.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, aku mendengarkan.
Dialogue: 0,0:19:18.53,0:19:19.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gaunnya, 'kan?
Dialogue: 0,0:19:19.70,0:19:21.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cantik sekali.
Dialogue: 0,0:19:21.03,0:19:23.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, maksudku gladi bersih resepsi!
Dialogue: 0,0:19:23.57,0:19:24.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sungguh melamun!
Dialogue: 0,0:19:25.70,0:19:26.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan.
Dialogue: 0,0:19:26.87,0:19:30.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelihatannya enak sekali!\NYang mana punyaku?
Dialogue: 0,0:19:30.00,0:19:34.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tonkotsu putih "Smiley",\Ndan tonkotsu hitam "Angry".
Dialogue: 0,0:19:34.21,0:19:38.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku selalu pesan "Angry". Rasanya\Namat lembut, terlepas dari namanya.
Dialogue: 0,0:19:42.47,0:19:43.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedas sekali!
Dialogue: 0,0:19:43.55,0:19:45.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Smiley" tampak lembut, tapi pedas!
Dialogue: 0,0:19:47.47,0:19:48.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Foto itu…
Dialogue: 0,0:19:50.69,0:19:53.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu foto kenang-kenangan saat Toman bubar.
Dialogue: 0,0:19:53.56,0:19:56.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa mudaku dihabiskan di sana.
Dialogue: 0,0:19:57.19,0:20:00.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanggal 8 Maret, 12 tahun lalu.
Dialogue: 0,0:20:00.03,0:20:02.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita semua harus berkumpul kapan-kapan.
Dialogue: 0,0:20:03.16,0:20:05.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya Mikey juga baik-baik saja.
Dialogue: 0,0:20:05.20,0:20:08.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Apa? Sungguh?\N- Kami tak tahu.
Dialogue: 0,0:20:09.50,0:20:12.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian tak bertemu dengannya\Nsaat dia kembali ke Jepang?
Dialogue: 0,0:20:12.12,0:20:14.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia punya bisnis makanan\Ndi luar negeri, 'kan?
Dialogue: 0,0:20:14.46,0:20:16.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah, baru kudengar.
Dialogue: 0,0:20:16.59,0:20:17.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:20:17.67,0:20:19.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi Draken dan Chifuyu bilang…
Dialogue: 0,0:20:19.42,0:20:23.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Mereka sungguh menemui Mikey?\N- Apa?
Dialogue: 0,0:20:23.09,0:20:25.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah lebih dari sepuluh tahun\Nkami tak bertemu.
Dialogue: 0,0:20:25.55,0:20:27.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih dari sepuluh tahun?
Dialogue: 0,0:20:27.35,0:20:29.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira tak ada yang menemuinya.
Dialogue: 0,0:20:30.89,0:20:31.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa?{\i0}
Dialogue: 0,0:20:32.48,0:20:33.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa yang terjadi?{\i0}
Dialogue: 0,0:20:37.48,0:20:39.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takemichi?
Dialogue: 0,0:20:42.28,0:20:44.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tato itu…{\i0}
Dialogue: 0,0:20:45.28,0:20:46.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ini dari anting.{\i0}
Dialogue: 0,0:20:47.49,0:20:49.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Desain anting Izana Kurokawa!{\i0}
Dialogue: 0,0:20:50.45,0:20:51.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat makan!
Dialogue: 0,0:20:52.37,0:20:53.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takemichi?
Dialogue: 0,0:20:56.38,0:21:00.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mikey menjalankan bisnis restoran\Ndi luar negeri sekarang.
Dialogue: 0,0:21:00.63,0:21:02.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sangat sukses.
Dialogue: 0,0:21:02.76,0:21:06.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Entah kenapa,\Ntapi firasatku buruk tentang ini!{\i0}
Dialogue: 0,0:21:08.30,0:21:10.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Draken!\N- Takemitchy? Ada apa?
Dialogue: 0,0:21:10.77,0:21:12.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa ekspresi tegang begitu?
Dialogue: 0,0:21:12.77,0:21:14.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau membohongiku?
Dialogue: 0,0:21:15.44,0:21:17.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mikey ada di luar negeri…
Dialogue: 0,0:21:17.40,0:21:18.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bohong, 'kan?
Dialogue: 0,0:21:21.28,0:21:24.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Smiley dan yang lain tak menemuinya\Nsudah lebih dari sepuluh tahun.
Dialogue: 0,0:21:25.24,0:21:27.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mitsuya juga berkata hal yang sama.
Dialogue: 0,0:21:28.41,0:21:34.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, aku melihat seseorang\Ndi berita yang mirip Izana Kurokawa.
Dialogue: 0,0:21:35.12,0:21:38.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana jika Izana masih hidup…
Dialogue: 0,0:21:38.63,0:21:40.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mikey…
Dialogue: 0,0:21:40.92,0:21:42.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mikey…
Dialogue: 0,0:21:43.67,0:21:46.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Izana Kurokawa membenci Mikey{\i0}
Dialogue: 0,0:21:46.51,0:21:50.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}meski Mikey memaafkannya\Nkarena membunuh Emma.{\i0}
Dialogue: 0,0:21:51.76,0:21:52.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bilang…
Dialogue: 0,0:21:53.52,0:21:54.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia dibunuh oleh Izana…
Dialogue: 0,0:21:56.69,0:21:59.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Padahal kukira ini masa depan terbaik…{\i0}
Dialogue: 0,0:22:00.73,0:22:01.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa Mikey…
Dialogue: 0,0:22:03.57,0:22:06.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa Mikey masih hidup?
Dialogue: 0,0:23:43.00,0:23:45.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei! Kenapa tandukku belum sembuh?
Dialogue: 0,0:23:45.88,0:23:48.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Patah di bagian dasar.
Dialogue: 0,0:23:48.17,0:23:50.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Butuh waktu lama untuk tumbuh kembali.
Dialogue: 0,0:23:51.30,0:23:53.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si Persik Berengsek itu. Akan kubunuh dia!
Dialogue: 0,0:23:53.93,0:23:56.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei! Ada yang punya sesuatu\Nsebagai pengganti?
Dialogue: 0,0:23:59.60,0:24:01.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu terlalu kecil. Coba lagi!
Dialogue: 0,0:24:02.27,0:24:04.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana ada iblis memakai bunga? Coba lagi!
Dialogue: 0,0:24:06.02,0:24:07.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bergurau, ya?
Dialogue: 0,0:24:07.44,0:24:08.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lupakan saja.
Dialogue: 0,0:24:08.53,0:24:11.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kupatahkan tandukku\Ndan menempelkannya pada bos…
Dialogue: 0,0:24:12.28,0:24:14.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau melakukannya,\Nkau juga akan terluka, 'kan?
Dialogue: 0,0:24:14.87,0:24:17.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku tak rela\Nkau tanpa tanduk seperti ini…
Dialogue: 0,0:24:17.62,0:24:19.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Aku tak membutuhkannya.\N- Bos…
Dialogue: 0,0:24:19.70,0:24:22.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kurebut\Ntanduk bajingan bertelinga kelinci itu.
Dialogue: 0,0:24:22.46,0:24:24.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diterjemahkan oleh Lia Agatha
Dialogue: 0,0:24:24.54,0:24:25.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bos!
