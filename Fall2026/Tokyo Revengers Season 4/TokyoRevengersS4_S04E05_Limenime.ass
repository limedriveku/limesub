Dialogue: 0,0:00:12.67,0:00:14.18,sign,,0000,0000,0000,,20 JUNI 2008
Dialogue: 0,0:00:23.48,0:00:26.02,sign,,0000,0000,0000,,SELAMAT KEPADA TIM VOLI\NYANG MENEMPATI JUARA KEDUA
Dialogue: 0,0:02:01.58,0:02:03.45,sign,,0000,0000,0000,,RUANG PERSIAPAN ILMU SOSIAL
Dialogue: 0,0:02:56.76,0:02:59.88,sign,,0000,0000,0000,,GENERASI KE-7\NGENG MOTOR EL DORADO SHONAN
Dialogue: 0,0:03:02.43,0:03:04.05,sign,,0000,0000,0000,,{\an8}HANYA AKULAH
Dialogue: 0,0:03:14.36,0:03:16.53,sign,,0000,0000,0000,,{\an8}KANTO MANJI\NHANYA AKULAH YANG TERHORMAT
Dialogue: 0,0:03:40.88,0:03:43.26,sign,,0000,0000,0000,,{\an8}GENG KANTO MANJI\NHAJIME KOKONOI
Dialogue: 0,0:03:52.19,0:03:54.90,sign,,0000,0000,0000,,{\an8}KANTO MANJI\NHARUCHIYO SANZU
Dialogue: 0,0:04:11.00,0:04:13.79,sign,,0000,0000,0000,,{\an8}KANTO MANJI\NMANJIRO SANO
Dialogue: 0,0:04:32.14,0:04:35.02,sign,,0000,0000,0000,,{\an8}BRAHMAN BRAHMAN
Dialogue: 0,0:04:37.56,0:04:40.61,sign,,0000,0000,0000,,TOKYO REVENGERS
Dialogue: 0,0:04:40.61,0:04:43.95,sign,,0000,0000,0000,,BAB TERAKHIR DIMULAI
Dialogue: 0,0:11:17.92,0:11:19.34,sign,,0000,0000,0000,,GRUP HAYASHIDA
Dialogue: 0,0:14:13.60,0:14:14.68,sign,,0000,0000,0000,,TOKO HEWAN PELIHARAAN\NPALME
Dialogue: 0,0:15:48.19,0:15:49.28,sign,,0000,0000,0000,,KEN RYUGUJI
Dialogue: 0,0:15:59.91,0:16:02.87,sign,,0000,0000,0000,,BENGKEL SEPEDA MOTOR D & D\NHONMA - KAWASASA - SUZUKA
Dialogue: 0,0:16:02.87,0:16:05.00,sign,,0000,0000,0000,,BENGKEL SEPEDA MOTOR D & D
Dialogue: 0,0:18:04.41,0:18:09.63,sign,,0000,0000,0000,,{\an8}PERWAKILAN ROKUHARA TANDAI\NSOUTH TERANO
Dialogue: 0,0:21:35.92,0:21:37.00,sign,,0000,0000,0000,,{\an8}BRAHMAN NOMOR 2\NTAKEOMI AKASHI
Dialogue: 0,0:21:37.00,0:21:38.54,sign,,0000,0000,0000,,{\an8}(WAKIL KETUA GENERASI PERTAMA\NBLACK DRAGONS)
Dialogue: 0,0:21:46.68,0:21:50.10,sign,,0000,0000,0000,,{\an8}BRAHMAN
Dialogue: 0,0:23:40.92,0:23:42.00,sign,,0000,0000,0000,,FAIRY TALE REVENGERS - PETIT
Dialogue: 0,0:23:42.00,0:23:43.42,sign,,0000,0000,0000,,#5 "INGIN BERTEMU PUTRI OTOHIME"
Dialogue: 0,0:00:14.18,0:00:15.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tahun 2008?{\i0}
Dialogue: 0,0:00:16.97,0:00:18.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa-apaan ini?{\i0}
Dialogue: 0,0:00:30.32,0:00:32.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh, kau tak lihat?
Dialogue: 0,0:00:33.40,0:00:37.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kembali ke SMA!
Dialogue: 0,0:00:40.29,0:00:42.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa ini artinya aku menjelajahi waktu?{\i0}
Dialogue: 0,0:00:44.46,0:00:46.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi...
Dialogue: 0,0:00:46.17,0:00:47.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takemichi.
Dialogue: 0,0:00:48.09,0:00:49.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat pagi.
Dialogue: 0,0:00:49.67,0:00:51.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biasanya kau terlambat,\Nhari ini lebih awal.
Dialogue: 0,0:00:51.84,0:00:52.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:00:53.42,0:00:56.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yamagishi, Makoto,
Dialogue: 0,0:00:56.13,0:00:58.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takuya, Akkun.
Dialogue: 0,0:00:59.30,0:01:02.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kita kelas berapa sekarang?
Dialogue: 0,0:01:03.43,0:01:04.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bicara apa?
Dialogue: 0,0:01:04.73,0:01:06.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini tahun kedua kita. Lalu?
Dialogue: 0,0:01:06.90,0:01:09.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Setiap aku menjelajahi waktu,\Nselalu mundur 12 tahun.{\i0}
Dialogue: 0,0:01:11.11,0:01:13.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Takemitchy.
Dialogue: 0,0:01:14.19,0:01:15.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah belajar untuk tes akhir?
Dialogue: 0,0:01:16.95,0:01:20.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu duduk untuk belajar,\Naku langsung mengantuk.
Dialogue: 0,0:01:23.79,0:01:24.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Siapa ini?{\i0}
Dialogue: 0,0:01:25.75,0:01:30.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hakkai hanya tampan,\Ntapi otaknya tak berisi, ya?
Dialogue: 0,0:01:30.38,0:01:31.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar sekali.
Dialogue: 0,0:01:31.63,0:01:33.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Hakkai?{\i0}
Dialogue: 0,0:01:35.67,0:01:37.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa denganmu, Takemitchy?
Dialogue: 0,0:01:37.59,0:01:38.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau melamun.
Dialogue: 0,0:01:39.22,0:01:40.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tekanan darah rendah lagi?
Dialogue: 0,0:01:40.68,0:01:41.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo pergi.
Dialogue: 0,0:01:44.22,0:01:46.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Semua orang tampak agak lebih dewasa.{\i0}
Dialogue: 0,0:01:47.64,0:01:48.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei.
Dialogue: 0,0:01:50.36,0:01:51.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di mana Chifuyu?
Dialogue: 0,0:01:57.61,0:01:59.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, yang benar saja...
Dialogue: 0,0:02:04.37,0:02:05.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chifuyu!
Dialogue: 0,0:02:07.50,0:02:08.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takemitchy.
Dialogue: 0,0:02:09.33,0:02:10.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berisik sekali.
Dialogue: 0,0:02:12.21,0:02:13.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:02:20.34,0:02:22.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chifuyu...
Dialogue: 0,0:02:22.80,0:02:23.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku...
Dialogue: 0,0:02:26.68,0:02:29.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berjabat tangan\Ndengan Mikey dari masa depan.
Dialogue: 0,0:02:30.60,0:02:31.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bilang kau...
Dialogue: 0,0:02:32.15,0:02:33.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takemitchy dari masa depan?
Dialogue: 0,0:02:35.90,0:02:39.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu aku kembali ke sini.
Dialogue: 0,0:02:41.11,0:02:42.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:02:46.12,0:02:47.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entahlah.
Dialogue: 0,0:02:49.33,0:02:54.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi dia bilang, "Tolong aku."
Dialogue: 0,0:03:35.04,0:03:36.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan lupa.
Dialogue: 0,0:03:37.13,0:03:40.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tokyo tak butuh tim lain selain kita.
Dialogue: 0,0:03:44.93,0:03:47.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemandangan yang indah.
Dialogue: 0,0:03:48.35,0:03:52.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bos kita makin tak terhentikan.
Dialogue: 0,0:03:54.90,0:03:57.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mengalahkan mereka semua sendirian.
Dialogue: 0,0:04:06.03,0:04:07.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia datang.
Dialogue: 0,0:04:09.16,0:04:10.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takemitchy.
Dialogue: 0,0:06:15.33,0:06:16.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Wah.
Dialogue: 0,0:06:16.41,0:06:17.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}#55 Masa pergejolakkan
Dialogue: 0,0:06:17.50,0:06:20.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Jadi, aku tak kembali\Nke 12 tahun lalu kali ini.
Dialogue: 0,0:06:20.67,0:06:21.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Tidak.
Dialogue: 0,0:06:22.63,0:06:24.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kali ini, dua tahun kemudian.
Dialogue: 0,0:06:25.09,0:06:27.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Lompatan ke sepuluh tahun lalu.
Dialogue: 0,0:06:28.17,0:06:31.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Mungkin berubah\Ntergantung siapa pemicunya.
Dialogue: 0,0:06:31.60,0:06:35.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Artinya takkan mudah\Nkembali ke masa depan.
Dialogue: 0,0:06:36.27,0:06:37.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:06:37.43,0:06:39.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa rencana Mikey sekarang?
Dialogue: 0,0:06:47.24,0:06:49.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah dua tahun sejak Toman dibubarkan!
Dialogue: 0,0:06:49.49,0:06:52.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peta kekuatan Tokyo berubah drastis!
Dialogue: 0,0:06:52.62,0:06:55.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Toman adalah geng penguasa Kanto dulu.
Dialogue: 0,0:06:55.24,0:06:58.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah Toman bubar,\Ndunia bawah tanah Tokyo jadi kacau balau!
Dialogue: 0,0:06:58.58,0:07:00.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Baik.\N- Berhenti mencatat.
Dialogue: 0,0:07:00.33,0:07:04.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Persaingan panglima perang lokal,\Ndan Era Perang Saudara Tokyo dimulai!
Dialogue: 0,0:07:04.84,0:07:06.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Era Perang Saudara...
Dialogue: 0,0:07:06.17,0:07:08.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kemudian!
Dialogue: 0,0:07:08.42,0:07:10.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tiga sosok karismatik muncul,{\i0}
Dialogue: 0,0:07:10.47,0:07:13.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dan era itu tiba-tiba berakhir!{\i0}
Dialogue: 0,0:07:13.09,0:07:16.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tiga sosok karismatik?\N- Ya! South Terano,
Dialogue: 0,0:07:16.35,0:07:22.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mewakili kekuatan terbesar berbasis\Ndi Distrik Minato, Rokuhara Tandai!
Dialogue: 0,0:07:22.23,0:07:26.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senju Kawaragi, bos Brahman,\Ngeng misterius yang berbasis di Shinjuku
Dialogue: 0,0:07:26.27,0:07:28.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mengaku tak terkalahkan!
Dialogue: 0,0:07:28.03,0:07:32.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan Manjiro Sano, bos Geng Kanto Manji,\Nyang berbasis di Shibuya,
Dialogue: 0,0:07:32.78,0:07:34.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mengaku yang perkasa!
Dialogue: 0,0:07:34.66,0:07:39.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini, Tokyo berada\Ndalam persaingan di antara ketiga tim ini.
Dialogue: 0,0:07:39.75,0:07:42.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita berada di Era Tiga Raksasa!
Dialogue: 0,0:07:42.42,0:07:44.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi ada dua orang lain\Nyang setara dengan Mikey?
Dialogue: 0,0:07:44.92,0:07:46.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar sekali!
Dialogue: 0,0:07:46.46,0:07:48.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}South Terano berasal dari Brasil.
Dialogue: 0,0:07:48.55,0:07:51.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Konon, dia membunuh seseorang\Nsaat berusia lima tahun.
Dialogue: 0,0:07:51.88,0:07:55.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senju Kawaragi sungguh misterius,\Nhanya namanya yang dikenal.
Dialogue: 0,0:07:56.72,0:07:57.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau menyimak, tidak?
Dialogue: 0,0:07:58.47,0:08:01.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ayolah...\N{\i1}- Apa itu Geng Kanto Manji?{\i0}
Dialogue: 0,0:08:01.31,0:08:03.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bukankah tim Mikey adalah Bonten?{\i0}
Dialogue: 0,0:08:03.94,0:08:07.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Lagi pula, jika dia akan langsung\Nmembuat tim lain,{\i0}
Dialogue: 0,0:08:07.65,0:08:10.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}apa gunanya membubarkan Toman?{\i0}
Dialogue: 0,0:08:12.45,0:08:14.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku tak mau melibatkan mereka.{\i0}
Dialogue: 0,0:08:15.78,0:08:18.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Orang-orang di sekitarku\Npasti akan menderita.{\i0}
Dialogue: 0,0:08:18.74,0:08:22.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jadi, karena itu dia membuat tim baru?{\i0}
Dialogue: 0,0:08:23.25,0:08:25.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Takemitchy.
Dialogue: 0,0:08:25.71,0:08:28.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau seperti ini lagi, 'kan?
Dialogue: 0,0:08:31.13,0:08:33.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luar biasa betapa cepatnya kau berfokus.
Dialogue: 0,0:08:33.22,0:08:34.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:08:34.38,0:08:38.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mungkin memikirkan\Nbanyak hal tentang Mikey,
Dialogue: 0,0:08:38.10,0:08:41.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi bukankah ada orang lain\Nyang harus kau luruskan dahulu?
Dialogue: 0,0:08:43.27,0:08:44.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meluruskan?
Dialogue: 0,0:08:48.69,0:08:50.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hina, maafkan aku!
Dialogue: 0,0:08:50.19,0:08:52.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takemichi?
Dialogue: 0,0:08:52.07,0:08:56.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku melewatkan hari pernikahan kita\Ndan mati!
Dialogue: 0,0:08:57.53,0:08:58.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pernikahan...
Dialogue: 0,0:09:00.41,0:09:01.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Pernikahan?\N- Apa?
Dialogue: 0,0:09:02.00,0:09:04.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, kau kembali?
Dialogue: 0,0:09:10.67,0:09:13.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hina, aku paham sekarang.
Dialogue: 0,0:09:16.38,0:09:17.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada akhirnya...
Dialogue: 0,0:09:23.77,0:09:26.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini belum usai sampai Mikey selamat.
Dialogue: 0,0:09:40.70,0:09:44.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Andaikan pilihanmu itu salah,
Dialogue: 0,0:09:45.54,0:09:48.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan akhirnya mengarah\Nke masa depan terburuk.
Dialogue: 0,0:10:00.26,0:10:03.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan jika itu terjadi,\Naku akan tetap mendukungmu.
Dialogue: 0,0:10:13.27,0:10:15.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perkataanku bisa menusuk, ya?
Dialogue: 0,0:10:17.36,0:10:18.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Terima kasih, Hina.{\i0}
Dialogue: 0,0:10:21.37,0:10:25.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menyadarkan Manjiro Sano.
Dialogue: 0,0:10:28.83,0:10:30.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Chifuyu.
Dialogue: 0,0:10:30.21,0:10:32.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana cara menghajar Mikey?
Dialogue: 0,0:10:34.46,0:10:37.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau selalu punya ide gila.
Dialogue: 0,0:10:37.51,0:10:39.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku serius, Chifuyu.
Dialogue: 0,0:10:42.43,0:10:46.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama, kita harus mengumpulkan orang.
Dialogue: 0,0:10:46.02,0:10:47.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengumpulkan orang?
Dialogue: 0,0:10:47.43,0:10:50.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Toman sudah tak ada, 'kan?
Dialogue: 0,0:10:50.90,0:10:53.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita butuh cukup orang
Dialogue: 0,0:10:53.15,0:10:55.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk melawan Geng Kanto Manji Mikey.
Dialogue: 0,0:10:55.65,0:10:56.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:10:56.73,0:10:58.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini?
Dialogue: 0,0:10:58.36,0:11:01.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kedengarannya menyenangkan.\NKalian bicara apa?
Dialogue: 0,0:11:01.20,0:11:02.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengumpulkan siapa?
Dialogue: 0,0:11:02.28,0:11:03.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hakkai.
Dialogue: 0,0:11:04.08,0:11:05.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, bukan apa-apa.
Dialogue: 0,0:11:05.79,0:11:08.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku tak bisa\Nmenjelaskan situasinya kepadanya.{\i0}
Dialogue: 0,0:11:08.58,0:11:10.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian sedang senggang, 'kan?
Dialogue: 0,0:11:11.46,0:11:13.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo ikut aku.
Dialogue: 0,0:11:19.34,0:11:20.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yakuza sungguhan!
Dialogue: 0,0:11:20.76,0:11:23.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lama tak bertemu, Takemitchy.
Dialogue: 0,0:11:23.68,0:11:25.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa kau?
Dialogue: 0,0:11:25.22,0:11:26.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kejam sekali!
Dialogue: 0,0:11:26.43,0:11:29.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini aku, Haruki Hayashida.
Dialogue: 0,0:11:29.60,0:11:30.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pah-chin.
Dialogue: 0,0:11:30.69,0:11:32.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pah-chin?
Dialogue: 0,0:11:32.27,0:11:34.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah bebas?
Dialogue: 0,0:11:34.90,0:11:37.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayolah, lelucon macam apa itu?
Dialogue: 0,0:11:37.32,0:11:40.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa baru sekarang bertanya\Nkapan dia "bebas"?
Dialogue: 0,0:11:40.11,0:11:41.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mitsuya?
Dialogue: 0,0:11:41.57,0:11:44.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taka juga di sini? Kebetulan sekali.
Dialogue: 0,0:11:44.20,0:11:46.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, Takemitchy?
Dialogue: 0,0:11:46.28,0:11:47.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau juga mencari apartemen?
Dialogue: 0,0:11:47.99,0:11:49.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peh-yan!
Dialogue: 0,0:11:50.29,0:11:52.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taka, kau juga mencari apartemen?
Dialogue: 0,0:11:52.71,0:11:55.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, aku mau menyewa studio kecil.
Dialogue: 0,0:11:55.42,0:11:57.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengar, Hakkai.
Dialogue: 0,0:11:57.00,0:11:59.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mitsuya sangat pemilih soal tempat.
Dialogue: 0,0:11:59.88,0:12:01.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena yang kau tunjukkan jelek.
Dialogue: 0,0:12:01.67,0:12:03.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pah-chin, takkan kumaafkan...
Dialogue: 0,0:12:03.34,0:12:05.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Yang ini?\N- ...jika kau menipu Taka.
Dialogue: 0,0:12:05.55,0:12:07.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Yang mana?\N- Ini cuma 40 menit jalan kaki...
Dialogue: 0,0:12:07.97,0:12:09.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Oh, ya.{\i0}
Dialogue: 0,0:12:09.14,0:12:13.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pah-chin dan Peh-yan punya\Nbisnis properti di masa depan, 'kan?{\i0}
Dialogue: 0,0:12:13.35,0:12:16.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peh-yan, kau juga\Nmencarikanku tempat tinggal?
Dialogue: 0,0:12:16.77,0:12:19.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sungguh tak mau tinggal\Nbersama Yuzuha.
Dialogue: 0,0:12:19.07,0:12:20.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia berisik sekali.
Dialogue: 0,0:12:20.44,0:12:22.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, aku sudah membuat daftarnya.
Dialogue: 0,0:12:22.95,0:12:25.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga mau lihat.
Dialogue: 0,0:12:25.66,0:12:26.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu...
Dialogue: 0,0:12:26.74,0:12:29.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peh-yan, ini semua tak terlalu mahal?
Dialogue: 0,0:12:29.20,0:12:30.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya kenapa?
Dialogue: 0,0:12:30.45,0:12:32.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pakai uang orang tuamu, 'kan?
Dialogue: 0,0:12:32.50,0:12:35.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keren sekali.\NAku selalu mau tangga spiral.
Dialogue: 0,0:12:35.12,0:12:37.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, tempat ini tampak bagus,
Dialogue: 0,0:12:37.04,0:12:39.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi katanya tak bisa disewa untuk bisnis.
Dialogue: 0,0:12:40.21,0:12:41.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana bisa?
Dialogue: 0,0:12:41.34,0:12:42.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peh-yan! Kenapa?
Dialogue: 0,0:12:42.72,0:12:46.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kutambahkan ke daftar\Nkarena pemiliknya bilang bisa ditawar!
Dialogue: 0,0:12:46.84,0:12:49.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pah-chin, otak bebalmu itu\Nsungguh tak berguna!
Dialogue: 0,0:12:49.72,0:12:51.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, jangan terlalu memuji.
Dialogue: 0,0:12:52.73,0:12:54.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, Takemitchy.
Dialogue: 0,0:12:55.06,0:12:56.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba libatkan semua orang.
Dialogue: 0,0:12:56.65,0:12:59.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan Mitsuya dan yang lain,\Njadi setara seratus orang, 'kan?
Dialogue: 0,0:13:02.49,0:13:04.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak bisa memutuskan!
Dialogue: 0,0:13:04.32,0:13:05.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hakkai, kau berisik sekali.
Dialogue: 0,0:13:05.95,0:13:07.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kejam sekali, Taka.
Dialogue: 0,0:13:07.95,0:13:09.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, itu benar, tapi...
Dialogue: 0,0:13:11.49,0:13:12.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa aku tak mau.
Dialogue: 0,0:13:19.59,0:13:23.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luar biasa melihat Taka\Ndan yang lainnya menata hidup mereka.
Dialogue: 0,0:13:24.55,0:13:26.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga harus memperbaiki sikapku.
Dialogue: 0,0:13:26.76,0:13:28.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau baik-baik saja apa adanya.
Dialogue: 0,0:13:30.01,0:13:32.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin kau jadi orang hebat\Nsuatu hari nanti.
Dialogue: 0,0:13:32.81,0:13:33.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku?
Dialogue: 0,0:13:33.98,0:13:36.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari mana kau dapat ide itu?
Dialogue: 0,0:13:37.69,0:13:39.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah, hanya firasat.
Dialogue: 0,0:13:43.65,0:13:45.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Dah.\N- Sampai besok.
Dialogue: 0,0:13:48.16,0:13:50.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau tak minta bantuan mereka,
Dialogue: 0,0:13:50.37,0:13:52.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}meski kita sudah mampir menemui mereka?
Dialogue: 0,0:13:52.70,0:13:53.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entahlah.
Dialogue: 0,0:13:53.91,0:13:57.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melihat semuanya bekerja keras\Nmembuatku sulit meminta tolong.
Dialogue: 0,0:13:57.50,0:13:59.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu.
Dialogue: 0,0:13:59.25,0:14:00.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada siapa lagi?
Dialogue: 0,0:14:01.29,0:14:03.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang-orang dari SMP Mizo?
Dialogue: 0,0:14:03.42,0:14:04.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial.
Dialogue: 0,0:14:05.17,0:14:06.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus bekerja paruh waktu.
Dialogue: 0,0:14:06.72,0:14:09.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Takemitchy. Sampai besok.
Dialogue: 0,0:14:12.10,0:14:13.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja paruh waktu?
Dialogue: 0,0:14:14.68,0:14:15.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf aku terlambat!
Dialogue: 0,0:14:19.40,0:14:20.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Toko hewan peliharaan?{\i0}
Dialogue: 0,0:14:21.52,0:14:23.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kalau dipikir-pikir,{\i0}
Dialogue: 0,0:14:23.11,0:14:25.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Chifuyu punya toko sendiri di masa depan.{\i0}
Dialogue: 0,0:14:26.74,0:14:29.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ya, semuanya sudah tak bertindak\Nsesuka hati.{\i0}
Dialogue: 0,0:14:30.70,0:14:32.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mereka banyak berubah dalam dua tahun.{\i0}
Dialogue: 0,0:14:36.70,0:14:39.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mereka berbeda dari saat SMP.{\i0}
Dialogue: 0,0:14:39.12,0:14:40.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang.
Dialogue: 0,0:14:41.25,0:14:42.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Impian Chifuyu.{\i0}
Dialogue: 0,0:14:43.63,0:14:45.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tata letaknya bagus, tapi...
Dialogue: 0,0:14:45.88,0:14:47.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Impian Mitsuya.{\i0}
Dialogue: 0,0:14:47.30,0:14:48.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mitsuya rewel sekali.
Dialogue: 0,0:14:48.76,0:14:51.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pah-chin. Peh-yan.{\i0}
Dialogue: 0,0:14:51.43,0:14:53.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Hakkai jadi model di masa depan.{\i0}
Dialogue: 0,0:14:54.18,0:14:56.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Smiley dan Angry\Nakhirnya mengelola kedai ramen.{\i0}
Dialogue: 0,0:14:57.27,0:14:59.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Akkun juga menjadi penata rambut.{\i0}
Dialogue: 0,0:15:00.73,0:15:04.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan melindungi\Nsemua orang di Toman, termasuk Hina.
Dialogue: 0,0:15:05.78,0:15:07.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pada hari Toman dibubarkan...{\i0}
Dialogue: 0,0:15:08.15,0:15:12.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}aku memberi tahu Mikey bahwa semuanya\Nmati di masa depan.{\i0}
Dialogue: 0,0:15:13.87,0:15:15.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dua tahun kemudian,{\i0}
Dialogue: 0,0:15:16.08,0:15:19.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}ini masa depan yang Mikey lindungi\Ndemi kami.{\i0}
Dialogue: 0,0:15:31.97,0:15:33.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak bisa melibatkan mereka.
Dialogue: 0,0:15:35.05,0:15:36.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku harus melakukannya sendiri.{\i0}
Dialogue: 0,0:15:38.85,0:15:41.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tapi apa yang harus kulakukan?{\i0}
Dialogue: 0,0:15:41.60,0:15:43.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tak ada petunjuk sama sekali.{\i0}
Dialogue: 0,0:15:49.28,0:15:50.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Draken.
Dialogue: 0,0:15:53.57,0:15:54.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo.
Dialogue: 0,0:15:54.82,0:15:57.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Takemitchy, bisa kemari sekarang?{\i0}
Dialogue: 0,0:16:05.63,0:16:07.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lama tak bertemu, Draken.
Dialogue: 0,0:16:12.05,0:16:13.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei.
Dialogue: 0,0:16:14.01,0:16:15.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuperbaiki.
Dialogue: 0,0:16:15.72,0:16:18.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika olinya bocor lagi, beri tahu aku.
Dialogue: 0,0:16:18.81,0:16:20.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kupesan suku cadangnya.
Dialogue: 0,0:16:22.89,0:16:24.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ini sepeda motor pemberian Mikey.{\i0}
Dialogue: 0,0:16:26.27,0:16:28.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau mengendarainya?
Dialogue: 0,0:16:34.74,0:16:38.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya, jadi kau kembali lagi.
Dialogue: 0,0:16:38.41,0:16:39.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:16:39.91,0:16:44.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mikey berkali-kali membantuku.
Dialogue: 0,0:16:44.04,0:16:45.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kali ini, aku...
Dialogue: 0,0:16:45.12,0:16:47.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak ada lagi yang bisa dilakukan\Nsiapa pun untuk Mikey.
Dialogue: 0,0:16:49.63,0:16:51.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sulit dijelaskan,
Dialogue: 0,0:16:52.09,0:16:56.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kita semua kini hidup normal,\Ndan dia memutuskan hubungan dengan kita.
Dialogue: 0,0:16:58.72,0:17:01.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takemitchy, jangan kejar Mikey.
Dialogue: 0,0:17:02.39,0:17:05.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bukan orang yang sama\Nseperti saat di Toman.
Dialogue: 0,0:17:07.81,0:17:09.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia akan membunuhmu tanpa ragu.
Dialogue: 0,0:17:23.79,0:17:26.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kabur, Draken!\N- Inupi?
Dialogue: 0,0:17:26.96,0:17:29.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasakan ini!
Dialogue: 0,0:17:32.26,0:17:34.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minggir!
Dialogue: 0,0:17:34.22,0:17:36.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhenti!
Dialogue: 0,0:17:46.56,0:17:48.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Haruskah kita membiarkannya mekar?
Dialogue: 0,0:17:50.31,0:17:51.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nocturne.
Dialogue: 0,0:17:54.82,0:17:56.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Siapa dia?{\i0}
Dialogue: 0,0:18:00.45,0:18:04.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perwakilan Rokuhara Tandai,\NSouth yang "Tak Tertandingi".
Dialogue: 0,0:18:22.72,0:18:23.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kami terkepung?{\i0}
Dialogue: 0,0:18:23.97,0:18:25.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mereka banyak sekali.{\i0}
Dialogue: 0,0:18:30.86,0:18:32.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Draken.
Dialogue: 0,0:18:33.32,0:18:35.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bergabunglah dengan kruku.
Dialogue: 0,0:18:39.20,0:18:41.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jadi, ini Rokuhara Tandai.{\i0}
Dialogue: 0,0:18:41.78,0:18:43.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau baik-baik saja, Inupi?
Dialogue: 0,0:18:43.41,0:18:45.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, begitulah.
Dialogue: 0,0:18:47.37,0:18:49.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak peduli berapa kali\Nkau bertanya, South.
Dialogue: 0,0:18:50.42,0:18:52.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku takkan bergabung dengan Rokuhara.
Dialogue: 0,0:18:55.42,0:19:00.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Orang ini yang Yamagishi bilang\Nada di puncak Rokuhara Tandai.{\i0}
Dialogue: 0,0:19:00.47,0:19:01.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}South Terano.{\i0}
Dialogue: 0,0:19:04.01,0:19:06.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah pensiun dari semua itu sekarang.
Dialogue: 0,0:19:06.39,0:19:08.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak tertarik terlibat\Nperang wilayahmu.
Dialogue: 0,0:19:09.39,0:19:10.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pensiun?
Dialogue: 0,0:19:11.31,0:19:13.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei! Draken!
Dialogue: 0,0:19:15.02,0:19:16.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Forte!
Dialogue: 0,0:19:20.03,0:19:23.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia menghajar Draken?{\i0}
Dialogue: 0,0:19:23.12,0:19:24.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Draken!
Dialogue: 0,0:19:25.12,0:19:28.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku takkan membiarkanmu pensiun, Draken.
Dialogue: 0,0:19:29.79,0:19:34.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, kenapa Geng Tokyo Manji\Nmengaku sebagai yang terkuat?
Dialogue: 0,0:19:39.13,0:19:40.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berengsek.
Dialogue: 0,0:19:47.72,0:19:49.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Forte!
Dialogue: 0,0:19:53.94,0:19:56.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Draken terhempas!
Dialogue: 0,0:19:56.07,0:19:57.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fortissimo!
Dialogue: 0,0:20:00.24,0:20:03.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tidak, ini terlalu sepihak!{\i0}
Dialogue: 0,0:20:03.95,0:20:07.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia mungkin sudah pensiun,\Ntapi dia tetap Draken.{\i0}
Dialogue: 0,0:20:07.24,0:20:08.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa dia semacam monster?{\i0}
Dialogue: 0,0:20:10.00,0:20:11.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Membangun era berandal."
Dialogue: 0,0:20:12.54,0:20:15.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada orang-orang di Tokyo\Ndengan prinsip yang sama denganku.
Dialogue: 0,0:20:16.21,0:20:21.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau menghancurkan Geng Tokyo Manji.
Dialogue: 0,0:20:22.72,0:20:24.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takkan kubiarkan kau pensiun.
Dialogue: 0,0:20:25.01,0:20:28.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang terkuat harus tetap\Nmenjadi yang terkuat sampai dilahap.
Dialogue: 0,0:20:29.60,0:20:34.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitulah cara kerja hukum rimba!
Dialogue: 0,0:20:34.98,0:20:37.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jika prinsip kalian sama, kenapa tak akur?{\i0}
Dialogue: 0,0:20:38.48,0:20:40.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sederhana saja, Draken.
Dialogue: 0,0:20:40.82,0:20:43.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bergabunglah denganku, atau mati di sini.
Dialogue: 0,0:20:44.45,0:20:48.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, mantan Kapten Divisi Satu.
Dialogue: 0,0:20:49.83,0:20:51.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku?
Dialogue: 0,0:20:51.12,0:20:53.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa berlagak seperti orang luar?
Dialogue: 0,0:20:55.08,0:20:57.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau juga sudah sering babak belur, 'kan?
Dialogue: 0,0:20:57.79,0:20:59.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang giliranmu.
Dialogue: 0,0:20:59.38,0:21:01.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tunggu! Aku baru sampai,{\i0}
Dialogue: 0,0:21:01.63,0:21:04.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dan sudah menghadapi krisis besar?{\i0}
Dialogue: 0,0:21:07.34,0:21:09.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa yang terjadi?{\i0}
Dialogue: 0,0:21:19.82,0:21:21.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}South.
Dialogue: 0,0:21:22.74,0:21:25.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, jangan menghalangiku, Brahman.
Dialogue: 0,0:21:31.45,0:21:33.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mau berdiri di atas orang lain,
Dialogue: 0,0:21:33.91,0:21:35.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebaiknya kau juga waspada.
Dialogue: 0,0:21:44.80,0:21:46.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Brahman.{\i0}
Dialogue: 0,0:21:51.01,0:21:53.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Anggotanya juga banyak.{\i0}
Dialogue: 0,0:21:55.64,0:21:57.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}"Era Tiga Raksasa."{\i0}
Dialogue: 0,0:21:57.31,0:21:59.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dua dari tiga raksasa muncul{\i0}
Dialogue: 0,0:21:59.48,0:22:01.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}secara tiba-tiba dan bersamaan.{\i0}
Dialogue: 0,0:22:02.61,0:22:04.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Rokuhara Tandai dan Brahman.{\i0}
Dialogue: 0,0:22:04.86,0:22:06.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa yang akan terjadi sekarang?{\i0}
Dialogue: 0,0:23:44.71,0:23:46.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu dia! Istana Raja Naga!{\i0}
Dialogue: 0,0:23:47.59,0:23:48.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Urashima?
Dialogue: 0,0:23:51.88,0:23:54.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sulit dipercaya kau bisa kembali\Nke sini sendirian...
Dialogue: 0,0:23:54.76,0:23:57.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau bertemu Putri Otohime.
Dialogue: 0,0:23:57.51,0:24:01.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Urashima, aku akan segera\Nmemanggil Putri Otohime!
Dialogue: 0,0:24:01.44,0:24:02.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu sebentar.
Dialogue: 0,0:24:03.23,0:24:05.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiba-tiba aku takut.
Dialogue: 0,0:24:05.19,0:24:06.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah tua sekarang.
Dialogue: 0,0:24:06.98,0:24:09.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Jauh-jauh kemari, apa yang kau...\N- Urashima!
Dialogue: 0,0:24:10.03,0:24:11.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Putri Otohime?\N- Itu...
Dialogue: 0,0:24:15.78,0:24:18.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika aku juga jadi perempuan tua,\Nmungkin menyelesaikan masalah?
Dialogue: 0,0:24:19.20,0:24:21.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga mau bertemu denganmu selama ini.
Dialogue: 0,0:24:21.83,0:24:23.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berjanji kau akan membahagiakanku.
Dialogue: 0,0:24:23.50,0:24:24.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya! Seumur hidupku!
Dialogue: 0,0:24:24.83,0:24:26.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Diterjemahkan oleh Lia Agatha
