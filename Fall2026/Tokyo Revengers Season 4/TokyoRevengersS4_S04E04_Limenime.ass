Dialogue: 0,0:00:50.84,0:00:52.34,sign,,0000,0000,0000,,{\an8}SIDER STER\NSEGAR SAAT DITEGUK
Dialogue: 0,0:04:01.07,0:04:03.90,sign,,0000,0000,0000,,PERANGKAT VIDEO BEKAS, BARANG\NBEKAS, TUKAR-TAMBAH
Dialogue: 0,0:10:04.31,0:10:06.77,sign,,0000,0000,0000,,BOLING UDAGAWA
Dialogue: 0,0:18:31.11,0:18:32.61,sign,,0000,0000,0000,,{\an8}DI LANGIT DAN BUMI\NHANYA AKULAH YANG TERHORMAT
Dialogue: 0,0:18:34.86,0:18:38.24,sign,,0000,0000,0000,,PEMIMPIN GENERASI PERTAMA\NGENG TOKYO MANJI
Dialogue: 0,0:21:41.00,0:21:42.55,sign,,0000,0000,0000,,TANGGAL 20 JUNI 2008
Dialogue: 0,0:21:56.64,0:21:58.39,sign,,0000,0000,0000,,TAHUN 2008\NBUKU CATATAN SISWA
Dialogue: 0,0:23:41.00,0:23:42.08,sign,,0000,0000,0000,,FAIRY TALE REVENGERS - PETIT
Dialogue: 0,0:23:42.08,0:23:43.58,sign,,0000,0000,0000,,{\an8}#4 MEMBANGUN KEMBALI RUMAH KUE JAHE
Dialogue: 0,0:23:43.58,0:23:44.67,sign,,0000,0000,0000,,TOKO KUE
Dialogue: 0,0:23:57.22,0:23:58.31,sign,,0000,0000,0000,,{\an8}GULUNG, GULUNG, GULUNG...
Dialogue: 0,0:24:24.92,0:24:26.00,sign,,0000,0000,0000,,{\an8}BERSAMBUNG...
Dialogue: 0,0:00:07.79,0:00:09.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa kasetnya masih berfungsi.
Dialogue: 0,0:00:10.92,0:00:13.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bisa memakai ini\Ndan menontonnya di dek sebelah sana.
Dialogue: 0,0:00:13.59,0:00:16.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, antik!
Dialogue: 0,0:00:16.14,0:00:22.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}TV tabung dengan VCR.\NMelihatnya sekarang tampak keren.
Dialogue: 0,0:00:25.77,0:00:28.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku penasaran apa isinya.{\i0}
Dialogue: 0,0:00:28.11,0:00:29.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku sama sekali tak ingat.{\i0}
Dialogue: 0,0:00:30.11,0:00:32.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Agak memalukan jika ini film porno.{\i0}
Dialogue: 0,0:00:36.99,0:00:38.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terekam, tidak?
Dialogue: 0,0:00:38.74,0:00:41.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya kau sudah tahu\Ncara menggunakannya.
Dialogue: 0,0:00:41.25,0:00:42.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah SMA.
Dialogue: 0,0:00:42.45,0:00:43.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diam.
Dialogue: 0,0:00:45.46,0:00:47.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, sudah terekam, 'kan?
Dialogue: 0,0:00:52.34,0:00:54.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Adikku akan membuka tutup botol\Ndengan tendangan.
Dialogue: 0,0:00:54.72,0:00:56.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Siapa itu?
Dialogue: 0,0:01:00.93,0:01:03.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan melompat ketakutan, Shinichiro.
Dialogue: 0,0:01:03.10,0:01:06.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bodoh! Masa aku takut\Ndengan bocah empat tahun?
Dialogue: 0,0:01:06.52,0:01:08.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}- Ayo!\N- Ayo maju!{\i0}
Dialogue: 0,0:01:11.02,0:01:12.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil! Dalam sekali tendang?
Dialogue: 0,0:01:15.65,0:01:16.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu Mikey.{\i0}
Dialogue: 0,0:01:17.99,0:01:21.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kenapa benda seperti ini\Nada di kapsul waktuku?{\i0}
Dialogue: 0,0:01:21.83,0:01:23.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Isinya hangat.
Dialogue: 0,0:01:29.08,0:01:30.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:01:30.63,0:01:33.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Mikey! Kenapa kau merekam?
Dialogue: 0,0:01:33.38,0:01:35.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan! Ini memalukan!
Dialogue: 0,0:01:35.42,0:01:37.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa ini rekaman...{\i0}
Dialogue: 0,0:01:37.26,0:01:40.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}- Sejak kapan kau rekam?{\i0}\N- {\i1}...keluarga Mikey atau semacamnya?{\i0}
Dialogue: 0,0:01:40.39,0:01:41.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar. Lain kali...
Dialogue: 0,0:01:50.90,0:01:53.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pesan untuk Takemitchy, 12 tahun lagi.{\i0}
Dialogue: 0,0:03:23.99,0:03:25.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Pesan untuk Takemitchy, 12 tahun lagi.
Dialogue: 0,0:03:25.87,0:03:26.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}#54 Raih tanganku
Dialogue: 0,0:03:26.95,0:03:28.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Mikey...{\i0}
Dialogue: 0,0:03:30.12,0:03:32.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Sudah kukatakan semuanya di surat,
Dialogue: 0,0:03:33.08,0:03:35.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}tapi ada hal yang mau kukatakan\Nhanya kepadamu.
Dialogue: 0,0:03:38.46,0:03:41.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Apa ini pesan video untukku?{\i0}
Dialogue: 0,0:03:42.34,0:03:43.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Aku merasa...{\i0}
Dialogue: 0,0:03:45.93,0:03:49.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku merasa ada versi lain di dalam diriku.{\i0}
Dialogue: 0,0:03:49.89,0:03:51.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa?{\i0}
Dialogue: 0,0:03:54.65,0:03:56.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}"Dorongan Gelap."{\i0}
Dialogue: 0,0:03:58.73,0:04:01.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku tak bisa mengendalikannya sendiri.{\i0}
Dialogue: 0,0:04:03.91,0:04:06.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Saat itu menguasaiku,\Naku menjadi diri yang lain.{\i0}
Dialogue: 0,0:04:06.70,0:04:08.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sebuah dorongan...{\i0}
Dialogue: 0,0:04:08.91,0:04:11.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kau pernah melihatnya.{\i0}
Dialogue: 0,0:04:11.00,0:04:12.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa?{\i0}
Dialogue: 0,0:04:14.58,0:04:16.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa maksudnya saat itu...{\i0}
Dialogue: 0,0:04:22.97,0:04:25.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kalau saat itu Baji tak menghentikannya...{\i0}
Dialogue: 0,0:04:31.39,0:04:35.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Hari itu, Mikey pasti sudah\Nmembunuh Kazutora.{\i0}
Dialogue: 0,0:04:44.78,0:04:48.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mungkin bisa mengendalikan\Ndorongan ini
Dialogue: 0,0:04:49.70,0:04:54.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}berkat Shinichiro, Emma, dan Baji.{\i0}
Dialogue: 0,0:04:55.25,0:04:58.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka semua sudah tiada.
Dialogue: 0,0:05:01.67,0:05:03.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku takut dengan diriku 12 tahun lagi.
Dialogue: 0,0:05:04.42,0:05:07.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti aku akan membuat\Norang-orang di sekitarku menderita.
Dialogue: 0,0:05:07.64,0:05:11.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Makanya kuputuskan hubungan\Ndengan semua orang di Toman.{\i0}
Dialogue: 0,0:05:11.89,0:05:13.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku tak mau melibatkan mereka.{\i0}
Dialogue: 0,0:05:16.10,0:05:19.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takemitchy, berjanjilah.
Dialogue: 0,0:05:19.61,0:05:23.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jangan dekati aku 12 tahun lagi.{\i0}
Dialogue: 0,0:05:23.90,0:05:27.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jangan coba kembali ke masa lalu\Nuntuk menyelamatkanku.{\i0}
Dialogue: 0,0:05:29.24,0:05:31.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akulah yang memilih jalan ini.
Dialogue: 0,0:05:33.95,0:05:38.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Takemitchy, kita takkan bertemu lagi.{\i0}
Dialogue: 0,0:05:38.96,0:05:41.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jadi, aku mau mengatakan\Nsatu hal terakhir.{\i0}
Dialogue: 0,0:05:41.13,0:05:42.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Satu hal terakhir?{\i0}
Dialogue: 0,0:05:44.42,0:05:45.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berbahagialah.
Dialogue: 0,0:05:46.80,0:05:48.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Hentikan.{\i0}
Dialogue: 0,0:05:48.76,0:05:50.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jangan tersenyum begitu...{\i0}
Dialogue: 0,0:06:00.02,0:06:03.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jadi, bukan karena terjadi sesuatu,\Ndan bukan salah siapa pun.{\i0}
Dialogue: 0,0:06:04.90,0:06:05.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sebuah dorongan hati...{\i0}
Dialogue: 0,0:06:06.78,0:06:09.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu karena ada "Dorongan Gelap"\Ndi dalam diri Mikey.{\i0}
Dialogue: 0,0:06:10.91,0:06:13.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tak ada yang bisa dilakukan.{\i0}
Dialogue: 0,0:06:22.54,0:06:23.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takemitchy!
Dialogue: 0,0:06:23.71,0:06:25.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa teleponmu tak diangkat?
Dialogue: 0,0:06:26.09,0:06:27.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:06:27.17,0:06:30.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya aku dapat petunjuk soal Bonten.\NDi Shinjuku...
Dialogue: 0,0:06:30.18,0:06:31.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kazutora.
Dialogue: 0,0:06:32.64,0:06:34.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak perlu mencemaskannya lagi.
Dialogue: 0,0:06:34.47,0:06:35.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:06:38.89,0:06:41.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Takemitchy?
Dialogue: 0,0:06:41.86,0:06:43.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:06:43.23,0:06:46.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku takkan mengejar Bonten lagi.
Dialogue: 0,0:06:47.19,0:06:49.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mikey melarang kita.
Dialogue: 0,0:06:49.53,0:06:50.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:06:50.82,0:06:52.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau bilang begitu?
Dialogue: 0,0:06:54.74,0:06:55.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takemitchy!
Dialogue: 0,0:07:01.79,0:07:02.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei.
Dialogue: 0,0:07:03.29,0:07:04.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei!
Dialogue: 0,0:07:04.92,0:07:06.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Takemitchy!
Dialogue: 0,0:07:06.63,0:07:08.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau melamun?
Dialogue: 0,0:07:08.92,0:07:10.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya dia sudah siap.
Dialogue: 0,0:07:10.34,0:07:12.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana, Yuzuha?
Dialogue: 0,0:07:12.51,0:07:16.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak jago mendandani orang,\Nmungkin tak kulakukan dengan baik, tapi{\i1}...{\i0}
Dialogue: 0,0:07:20.44,0:07:21.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana menurutmu?
Dialogue: 0,0:07:24.90,0:07:26.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau cantik, Hina!
Dialogue: 0,0:07:26.52,0:07:28.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepuluh tahun,\NHakkai hanya terbiasa dengan Hina.
Dialogue: 0,0:07:28.99,0:07:30.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah rambutmu ditata, kau sempurna.
Dialogue: 0,0:07:30.86,0:07:34.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia terlalu cantik untukmu, Takemitchy.
Dialogue: 0,0:07:37.29,0:07:42.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Apa? Ada apa, Takemichi?\N- Maaf.
Dialogue: 0,0:07:43.12,0:07:45.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mulai berpikir\Nbetapa bahagianya aku, dan{\i1}...{\i0}
Dialogue: 0,0:07:45.75,0:07:47.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berbahagialah.
Dialogue: 0,0:07:50.09,0:07:51.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Benar.{\i0}
Dialogue: 0,0:07:52.51,0:07:56.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat aku tampak putus asa\Natau kehilangan arah,
Dialogue: 0,0:07:57.56,0:07:59.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku ingin kau menegurku, Takemitchy.
Dialogue: 0,0:08:03.10,0:08:04.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti abangku.
Dialogue: 0,0:08:06.61,0:08:08.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia selalu seperti itu.{\i0}
Dialogue: 0,0:08:13.45,0:08:16.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sebabnya aku ingin mengakhirinya\Nselagi kita di puncak.
Dialogue: 0,0:08:17.78,0:08:19.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Makin sulit keadaannya...{\i0}
Dialogue: 0,0:08:22.04,0:08:24.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan dekati aku 12 tahun lagi.
Dialogue: 0,0:08:25.71,0:08:27.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mikey, maafkan aku.{\i0}
Dialogue: 0,0:08:29.05,0:08:32.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku tak bisa menepati janji itu.{\i0}
Dialogue: 0,0:08:42.93,0:08:44.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan main-main!
Dialogue: 0,0:08:44.98,0:08:47.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Bonten" ini, "Bonten" itu.
Dialogue: 0,0:08:47.11,0:08:48.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhenti membuat keributan di tokoku!
Dialogue: 0,0:08:48.94,0:08:50.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paham?
Dialogue: 0,0:08:50.15,0:08:52.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan pernah masuk ke tokoku lagi!
Dialogue: 0,0:08:55.82,0:08:59.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak mau perhatian Bonten\Ntertuju kepadaku. Dasar bodoh.
Dialogue: 0,0:08:59.20,0:09:02.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sial, jalan buntu lagi.{\i0}
Dialogue: 0,0:09:03.91,0:09:07.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Takemichi, sudah cukup.\N- Tapi...
Dialogue: 0,0:09:07.54,0:09:09.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau terburu-buru?
Dialogue: 0,0:09:09.59,0:09:11.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah empat tempat.
Dialogue: 0,0:09:11.13,0:09:15.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah bertanya ke semua\Npersembunyian Bonten yang kau lacak,
Dialogue: 0,0:09:16.09,0:09:18.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku belum\Ndapat petunjuk tentang Mikey.
Dialogue: 0,0:09:18.93,0:09:20.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau terlalu blak-blakan.
Dialogue: 0,0:09:20.39,0:09:22.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika menyelidiki, kau harus lebih...
Dialogue: 0,0:09:22.18,0:09:25.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyuruhku tak panik itu mustahil!
Dialogue: 0,0:09:25.02,0:09:28.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takemichi, kalau kau terus gegabah,
Dialogue: 0,0:09:28.90,0:09:30.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau bisa mati!
Dialogue: 0,0:09:31.73,0:09:35.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak mau terlibat dalam kematianmu!
Dialogue: 0,0:09:36.24,0:09:37.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah berakhir.
Dialogue: 0,0:09:37.41,0:09:39.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, Kazutora!
Dialogue: 0,0:09:39.49,0:09:41.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak! Pernikahanmu tiga hari lagi.
Dialogue: 0,0:09:41.91,0:09:45.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana jika sesuatu terjadi padamu?
Dialogue: 0,0:09:45.87,0:09:48.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga takkan bisa\Nmenghadapi semua orang.
Dialogue: 0,0:09:49.63,0:09:51.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan menarik perhatian dulu.
Dialogue: 0,0:09:54.46,0:09:55.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sial...{\i0}
Dialogue: 0,0:10:06.77,0:10:10.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dari semua tempat yang digali Kazutora,\Nyang tersisa hanyalah...{\i0}
Dialogue: 0,0:10:19.36,0:10:24.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mustahil ada anggota Bonten\Ndi markas lama mereka sekarang, 'kan?{\i0}
Dialogue: 0,0:10:31.75,0:10:33.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa lagi sekarang?{\i0}
Dialogue: 0,0:10:34.34,0:10:36.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan mencari informasi soal Mikey.
Dialogue: 0,0:10:39.01,0:10:42.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manjiro Sano saat ini\Nbukanlah orang yang kau kenal.
Dialogue: 0,0:10:43.35,0:10:44.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa aku benar-benar...{\i0}
Dialogue: 0,0:10:45.22,0:10:48.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}takkan pernah bertemu Mikey lagi?{\i0}
Dialogue: 0,0:10:48.06,0:10:51.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kita takkan bertemu lagi.{\i0}
Dialogue: 0,0:10:52.02,0:10:56.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ini terlalu menyedihkan.{\i0}
Dialogue: 0,0:10:59.45,0:11:01.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kau balik badan, kutembak.
Dialogue: 0,0:11:01.41,0:11:02.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:11:06.58,0:11:09.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga, kau bau.
Dialogue: 0,0:11:09.91,0:11:15.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari dulu kau memang busuk,\Nbau seperti selokan.
Dialogue: 0,0:11:15.92,0:11:16.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dari dulu?{\i0}
Dialogue: 0,0:11:20.22,0:11:22.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa kau?
Dialogue: 0,0:11:54.75,0:11:56.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengar baik-baik.
Dialogue: 0,0:11:56.50,0:11:59.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bos mau mengatakan sesuatu.
Dialogue: 0,0:12:10.14,0:12:11.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa depan yang indah, 'kan?
Dialogue: 0,0:12:16.48,0:12:17.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:12:18.11,0:12:19.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa dia keluar?
Dialogue: 0,0:12:25.57,0:12:26.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kotor!
Dialogue: 0,0:12:27.41,0:12:28.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang benar saja!
Dialogue: 0,0:12:28.49,0:12:30.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beginilah kalau aku tak mampir.
Dialogue: 0,0:12:34.25,0:12:38.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya aku bersih-bersih. Apa?
Dialogue: 0,0:12:38.25,0:12:40.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga, kalungku.
Dialogue: 0,0:12:43.05,0:12:45.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini terasa seperti pertanda buruk...
Dialogue: 0,0:12:52.10,0:12:53.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa depan yang indah, 'kan?
Dialogue: 0,0:12:55.35,0:12:56.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mikey...
Dialogue: 0,0:12:58.98,0:13:01.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa lagi yang kau inginkan?
Dialogue: 0,0:13:10.74,0:13:13.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau memberimu ini.
Dialogue: 0,0:13:16.83,0:13:18.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini undangan pernikahanku.
Dialogue: 0,0:13:23.09,0:13:25.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sungguh berharap kau datang.
Dialogue: 0,0:13:28.97,0:13:31.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua orang baik-baik saja.
Dialogue: 0,0:13:32.64,0:13:35.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti janjimu kepadaku 12 tahun lalu.
Dialogue: 0,0:13:36.81,0:13:40.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hina dan yang lainnya tampak bahagia.
Dialogue: 0,0:13:40.86,0:13:43.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya kau yang tak tampak bahagia.
Dialogue: 0,0:13:44.19,0:13:46.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan membunuhmu.
Dialogue: 0,0:13:47.61,0:13:49.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beri kami waktu sebentar, Sanzu.
Dialogue: 0,0:13:51.24,0:13:52.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau bicara berdua dengannya.
Dialogue: 0,0:13:53.54,0:13:54.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:13:55.79,0:13:57.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kutunggu di bawah.
Dialogue: 0,0:14:12.76,0:14:13.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mikey.
Dialogue: 0,0:14:15.48,0:14:17.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu "Dorongan Gelap"?
Dialogue: 0,0:14:18.81,0:14:22.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku selalu berpikir alasan hidupmu hancur
Dialogue: 0,0:14:22.98,0:14:26.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah karena Kisaki, Shinichiro,\Ndan Emma tewas.
Dialogue: 0,0:14:27.57,0:14:30.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira itu penyebab semua ini.
Dialogue: 0,0:14:30.87,0:14:32.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi ternyata bukan.
Dialogue: 0,0:14:34.95,0:14:36.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku tak mengerti.
Dialogue: 0,0:14:37.46,0:14:38.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rekaman itu...
Dialogue: 0,0:14:39.12,0:14:41.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tiba-tiba menyebutkan\N"Dorongan Gelap" ini.
Dialogue: 0,0:14:43.88,0:14:48.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski berjabat tangan dengan Naoto,\Naku tak bisa kembali ke masa lalu.
Dialogue: 0,0:14:49.34,0:14:54.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin karena keinginanku dan Naoto\Nuntuk menyelamatkan Hina sudah terwujud.
Dialogue: 0,0:14:56.18,0:14:57.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini berkatmu.
Dialogue: 0,0:14:58.23,0:15:00.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanpa dibilang pun aku sudah tahu.
Dialogue: 0,0:15:01.31,0:15:04.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena masa kini ini\Namat berbeda dari sebelumnya.
Dialogue: 0,0:15:06.44,0:15:08.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau yang melindungi semua orang.
Dialogue: 0,0:15:12.37,0:15:13.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kali ini,
Dialogue: 0,0:15:14.78,0:15:16.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}giliranku menyelamatkanmu...
Dialogue: 0,0:15:17.29,0:15:18.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:16:08.34,0:16:10.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah. Selesai.
Dialogue: 0,0:16:12.05,0:16:14.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takemichi sedang apa?
Dialogue: 0,0:16:14.93,0:16:16.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sudah larut.
Dialogue: 0,0:16:45.63,0:16:47.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak mau bertemu denganmu.
Dialogue: 0,0:16:53.01,0:16:54.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena aku tahu akan seperti ini.
Dialogue: 0,0:17:00.43,0:17:02.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perjalanan panjangmu berakhir di sini.
Dialogue: 0,0:17:06.10,0:17:07.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan...
Dialogue: 0,0:17:10.61,0:17:12.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menyelamatkanmu.
Dialogue: 0,0:17:15.11,0:17:18.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berapa kali pun, aku akan menyelamatkanmu.
Dialogue: 0,0:17:19.53,0:17:20.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untukmu...
Dialogue: 0,0:17:22.04,0:17:25.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa pun untukmu.
Dialogue: 0,0:17:26.79,0:17:28.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berapa kali pun...
Dialogue: 0,0:17:42.39,0:17:44.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya berakhir di sini.
Dialogue: 0,0:18:00.53,0:18:02.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Hei.\N- Tampak berbahaya.
Dialogue: 0,0:18:02.62,0:18:04.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa dia akan melompat?
Dialogue: 0,0:18:04.83,0:18:06.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, ada orang di atap yang mau melompat!
Dialogue: 0,0:18:06.79,0:18:07.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:18:07.87,0:18:09.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Apa? Mustahil.\N- Hubungi polisi...
Dialogue: 0,0:18:11.54,0:18:12.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mikey?
Dialogue: 0,0:18:20.72,0:18:22.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bagaimana, Manjiro?{\i0}
Dialogue: 0,0:18:22.39,0:18:24.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bagaimana pemandangan dari atas?{\i0}
Dialogue: 0,0:18:24.64,0:18:25.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Menyenangkan, 'kan?{\i0}
Dialogue: 0,0:18:26.52,0:18:28.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kau melindungi semua orang, 'kan?{\i0}
Dialogue: 0,0:18:29.31,0:18:31.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku tahu itu, Mikey.{\i0}
Dialogue: 0,0:18:32.61,0:18:34.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Mikey! Mikey!{\i0}
Dialogue: 0,0:18:42.70,0:18:44.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, Semuanya!
Dialogue: 0,0:18:44.70,0:18:46.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan, Mikey!
Dialogue: 0,0:18:57.59,0:18:59.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku takkan...
Dialogue: 0,0:19:00.93,0:19:02.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}membiarkanmu mati!
Dialogue: 0,0:19:12.56,0:19:15.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat pegang tanganku!
Dialogue: 0,0:19:16.61,0:19:20.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau akan mati karena aku.
Dialogue: 0,0:19:21.95,0:19:23.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:19:23.03,0:19:24.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mikey...
Dialogue: 0,0:19:26.12,0:19:28.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tak ada waktu lagi.
Dialogue: 0,0:19:29.71,0:19:31.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan pingsan...
Dialogue: 0,0:19:33.54,0:19:34.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lepaskan aku.
Dialogue: 0,0:19:36.13,0:19:40.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya ingin mengakhiri semuanya.
Dialogue: 0,0:19:40.63,0:19:41.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat?
Dialogue: 0,0:19:42.34,0:19:43.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah menyesalinya.
Dialogue: 0,0:19:46.85,0:19:49.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mikey, cepat.
Dialogue: 0,0:19:50.56,0:19:52.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat...
Dialogue: 0,0:19:53.15,0:19:54.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berjanji...
Dialogue: 0,0:19:56.11,0:19:57.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan...
Dialogue: 0,0:19:58.32,0:19:59.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menyelamatkanmu.
Dialogue: 0,0:20:01.03,0:20:04.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berapa kali pun,\Naku akan kembali ke masa lalu.
Dialogue: 0,0:20:05.32,0:20:06.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski aku tak bisa kembali...
Dialogue: 0,0:20:08.49,0:20:10.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berapa kali pun...
Dialogue: 0,0:20:14.21,0:20:16.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku menembakmu tanpa sadar.
Dialogue: 0,0:20:19.38,0:20:20.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak mau melihatmu.
Dialogue: 0,0:20:21.88,0:20:23.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak mau berakhir seperti ini.
Dialogue: 0,0:20:27.60,0:20:28.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takemitchy...
Dialogue: 0,0:20:32.85,0:20:37.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biarkan aku tenang.
Dialogue: 0,0:20:39.78,0:20:42.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diam!
Dialogue: 0,0:20:44.20,0:20:46.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau selalu seperti ini!
Dialogue: 0,0:20:46.32,0:20:49.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menanggung semuanya sendiri, setiap kali!
Dialogue: 0,0:20:50.33,0:20:52.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Manjiro!
Dialogue: 0,0:20:52.46,0:20:53.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekali saja!
Dialogue: 0,0:20:54.87,0:20:59.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katakan saja, "Tolong aku!"
Dialogue: 0,0:21:01.63,0:21:05.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menyelamatkanmu,\Napa pun yang terjadi.
Dialogue: 0,0:21:06.97,0:21:08.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manjiro!
Dialogue: 0,0:21:19.32,0:21:20.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong aku,
Dialogue: 0,0:21:22.23,0:21:23.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takemitchy...
Dialogue: 0,0:21:38.58,0:21:39.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa?{\i0}
Dialogue: 0,0:21:42.55,0:21:43.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sekarang tahun 2008?{\i0}
Dialogue: 0,0:21:45.30,0:21:46.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa-apaan ini?{\i0}
Dialogue: 0,0:21:49.35,0:21:51.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa ini artinya aku menjelajahi waktu?{\i0}
Dialogue: 0,0:21:53.85,0:21:56.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tapi ini bukan 12 tahun lalu...{\i0}
Dialogue: 0,0:21:58.40,0:22:00.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ini sepuluh tahun lalu!{\i0}
Dialogue: 0,0:22:02.15,0:22:04.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Apa?\N- Sungguh, kau tak lihat?
Dialogue: 0,0:22:04.99,0:22:08.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kembali ke SMA!
Dialogue: 0,0:23:44.67,0:23:45.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Sebelumnya tak semahal ini!
Dialogue: 0,0:23:45.92,0:23:48.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bahkan tak bisa membuat\Nrumah anjing dengan ini.
Dialogue: 0,0:23:48.92,0:23:50.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial!
Dialogue: 0,0:23:50.09,0:23:52.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika monster itu\Ntak menghancurkan rumah kita...
Dialogue: 0,0:23:52.93,0:23:54.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu...
Dialogue: 0,0:23:54.93,0:23:57.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Hei, kau sungguh bekerja selamban itu?
Dialogue: 0,0:23:58.31,0:24:01.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}- Saat ini, hanya ini yang bisa kulakukan.\N- Berapa lama lagi?
Dialogue: 0,0:24:01.27,0:24:02.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lupakan saja.
Dialogue: 0,0:24:02.98,0:24:05.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lakukan sendiri, Bodoh.
Dialogue: 0,0:24:05.02,0:24:06.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Abang...
Dialogue: 0,0:24:06.27,0:24:08.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak-anak ini mau apa?
Dialogue: 0,0:24:08.23,0:24:10.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau beli kue?
Dialogue: 0,0:24:10.36,0:24:12.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, jangan mengantre tanpa alasan!
Dialogue: 0,0:24:12.99,0:24:14.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini toko kami...
Dialogue: 0,0:24:14.24,0:24:16.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kita memancing\Nsemua manusia dengan ini,
Dialogue: 0,0:24:16.95,0:24:19.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita bisa mengisap darah sepuasnya, 'kan?
Dialogue: 0,0:24:19.79,0:24:20.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:24:20.87,0:24:23.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah! Panggang biskuit lagi.
Dialogue: 0,0:24:23.50,0:24:24.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}- Malam ini, kita berpesta.\N- Ya!
Dialogue: 0,0:24:26.00,0:24:28.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Diterjemahkan oleh Lia Agatha
