Dialogue: 0,0:02:28.50,0:02:32.63,sign,,0000,0000,0000,,PENYIHIR PEDANG ES\NAKAN MENGUASAI DUNIA SEASON 2
Dialogue: 0,0:02:33.22,0:02:37.01,sign,,0000,0000,0000,,EPISODE 5: PEMUDA YANG MERUPAKAN PENYIHIR\NTERKUAT DI DUNIA KENCAN DI NEGERI ASING
Dialogue: 0,0:23:48.78,0:23:55.58,sign,,0000,0000,0000,,PRATINJAU
Dialogue: 0,0:24:01.46,0:24:02.05,sign,,0000,0000,0000,,(Kalau dicoba pasti bisa)
Dialogue: 0,0:24:02.05,0:24:03.05,sign,,0000,0000,0000,,(Enggak bisa nolak!)
Dialogue: 0,0:00:01.90,0:00:06.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak kecil, aku sadar bahwa aku berbeda\Ndari orang-orang di sekitarku.
Dialogue: 0,0:00:07.07,0:00:08.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayahku Manusia,
Dialogue: 0,0:00:08.91,0:00:11.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi ibuku Elf.
Dialogue: 0,0:00:11.66,0:00:13.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku blasteran Elf.
Dialogue: 0,0:00:15.25,0:00:16.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, lihat itu!
Dialogue: 0,0:00:16.91,0:00:18.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, telinganya aneh!
Dialogue: 0,0:00:18.75,0:00:22.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang-orang menatapku penasaran\Nkarena menganggapku aneh.
Dialogue: 0,0:00:23.25,0:00:24.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya...
Dialogue: 0,0:00:25.09,0:00:27.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak butuh teman.
Dialogue: 0,0:00:28.17,0:00:30.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu yang selalu kupikirkan.
Dialogue: 0,0:00:33.43,0:00:35.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, menakjubkan, ya!
Dialogue: 0,0:00:35.77,0:00:40.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Corak bangunan dan gaya busananya\Nbeda sekali dengan Kerajaan, ya.
Dialogue: 0,0:00:40.02,0:00:42.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi ini budaya Alferia.
Dialogue: 0,0:00:42.77,0:00:46.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena ini digelar untuk memperingati\Npersahabatan dengan Kerajaan Arnold,
Dialogue: 0,0:00:46.03,0:00:50.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pihak Alferia pasti mempersiapkannya\Ndengan sangat matang.
Dialogue: 0,0:00:50.20,0:00:51.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tepat sekali!
Dialogue: 0,0:00:51.66,0:00:56.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena Alferia yang terkenal konservatif\Nakhirnya membuka hubungan diplomatik!
Dialogue: 0,0:00:56.45,0:00:59.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini pasti jadi Festival Nyanyian Suci\Nyang dicatat sejarah!
Dialogue: 0,0:00:59.41,0:01:01.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, Tuan Putri Olivia?
Dialogue: 0,0:01:01.54,0:01:04.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lama tak jumpa, nona-nona!
Dialogue: 0,0:01:04.29,0:01:06.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Lama tak jumpa.\N- Lama tak jumpa.
Dialogue: 0,0:01:06.21,0:01:07.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jumpa...
Dialogue: 0,0:01:07.20,0:01:08.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, Maria.
Dialogue: 0,0:01:08.55,0:01:09.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:01:09.17,0:01:11.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ray-ku di mana, ya?
Dialogue: 0,0:01:11.30,0:01:13.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia belum kelihatan.
Dialogue: 0,0:01:13.14,0:01:14.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu...
Dialogue: 0,0:01:14.43,0:01:15.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ray...
Dialogue: 0,0:01:15.64,0:01:16.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ku?
Dialogue: 0,0:01:16.39,0:01:17.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maria...
Dialogue: 0,0:01:18.93,0:01:21.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu tahu sesuatu?
Dialogue: 0,0:01:21.06,0:01:21.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:01:21.94,0:01:24.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini, kami kemari tidak datang bareng...
Dialogue: 0,0:01:24.65,0:01:25.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu.
Dialogue: 0,0:01:25.73,0:01:28.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, kenapa Putri ada di sini?
Dialogue: 0,0:01:28.44,0:01:30.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiga Keluarga Besar memang jempolan.
Dialogue: 0,0:01:30.65,0:01:32.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka bahkan kenal dekat dengan Putri.
Dialogue: 0,0:01:32.91,0:01:35.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sana titik kumpulnya\Npara orang-orang penting, kan?
Dialogue: 0,0:01:35.41,0:01:36.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kita bisa gabung?
Dialogue: 0,0:01:37.33,0:01:38.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}He-Hei!
Dialogue: 0,0:01:38.95,0:01:40.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah...
Dialogue: 0,0:01:40.16,0:01:41.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu kan...
Dialogue: 0,0:01:42.17,0:01:43.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ray?
Dialogue: 0,0:01:43.33,0:01:45.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu... Elisa?
Dialogue: 0,0:01:46.34,0:01:49.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa Elisa ada di tempat seperti itu?
Dialogue: 0,0:01:49.34,0:01:50.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di-Dia...
Dialogue: 0,0:01:51.84,0:01:55.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia kekasihku!
Dialogue: 0,0:02:17.12,0:02:23.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:02:38.64,0:02:41.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elisa adalah anggota keluarga\NKerajaan Alferia?
Dialogue: 0,0:02:41.97,0:02:44.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya aku Putri Keempat.
Dialogue: 0,0:02:44.77,0:02:47.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum lama ini juga aku baru tahu.
Dialogue: 0,0:02:47.40,0:02:48.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm?
Dialogue: 0,0:02:48.66,0:02:50.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudnya bagaimana?
Dialogue: 0,0:02:50.72,0:02:54.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dulu, ibuku anggota keluarga\NKerajaan Alferia.
Dialogue: 0,0:02:55.15,0:02:58.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, karena beliau sering menyelinap\Nkeluar dari Kerajaan...
Dialogue: 0,0:02:58.66,0:03:02.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu beliau bertemu dengan Ayah\Ndan akhirnya kawin lari.
Dialogue: 0,0:03:02.59,0:03:05.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibumu aktif banget, ya.
Dialogue: 0,0:03:05.59,0:03:07.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kawin lari, ya.
Dialogue: 0,0:03:07.42,0:03:09.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kedengarannya romantis banget.
Dialogue: 0,0:03:09.00,0:03:10.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu.
Dialogue: 0,0:03:10.92,0:03:14.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, meski kamu bangsawan,\NElisa tetap Elisa.
Dialogue: 0,0:03:14.55,0:03:16.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada yang berubah.
Dialogue: 0,0:03:19.76,0:03:21.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:03:21.31,0:03:25.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami telah menyiapkan kamar masing-masing\Nuntuk kalian selama berada di sini!
Dialogue: 0,0:03:25.31,0:03:27.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:03:27.02,0:03:29.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemarin kita kan tidur sekamar!
Dialogue: 0,0:03:29.31,0:03:32.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon tenang sedikit!
Dialogue: 0,0:03:33.78,0:03:38.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baru saja ada kabar, bahwa teman-teman\Nsekolah Anda sudah memasuki Kerajaan.
Dialogue: 0,0:03:38.57,0:03:41.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebentar lagi, mereka pasti\Nakan sampai di tempat acara.
Dialogue: 0,0:03:41.45,0:03:42.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:03:46.29,0:03:47.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ray.
Dialogue: 0,0:03:47.37,0:03:48.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah.
Dialogue: 0,0:03:48.65,0:03:50.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sangat cocok denganmu.
Dialogue: 0,0:03:50.21,0:03:53.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan gaun itu,\Nkamu terlihat anggun bagaikan peri.
Dialogue: 0,0:03:54.30,0:03:56.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Te-Terima kasih.
Dialogue: 0,0:03:56.55,0:03:58.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, begini...
Dialogue: 0,0:03:58.30,0:03:59.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:03:59.47,0:04:03.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di pesta nanti, sepertinya aku harus\Nmenyapa orang-orang penting...
Dialogue: 0,0:04:03.97,0:04:06.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu bisa berada di sampingku?
Dialogue: 0,0:04:06.48,0:04:08.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, serahkan saja padaku.
Dialogue: 0,0:04:11.73,0:04:13.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi dia Putri Elisa yang dirumorkan itu?
Dialogue: 0,0:04:13.90,0:04:15.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, anak dari Putri Saria...
Dialogue: 0,0:04:15.82,0:04:17.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang katanya selama ini tinggal di Arnold!
Dialogue: 0,0:04:18.82,0:04:21.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, Elisa, selamat datang!
Dialogue: 0,0:04:22.58,0:04:25.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Abel Alferius, Raja di Alferia.
Dialogue: 0,0:04:25.08,0:04:27.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sa-Salam kenal.
Dialogue: 0,0:04:27.08,0:04:30.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibumu, Saria, adalah adikku.
Dialogue: 0,0:04:30.75,0:04:33.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa dibilang aku pamanmu.
Dialogue: 0,0:04:33.50,0:04:35.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be-Begitu, ya.
Dialogue: 0,0:04:35.84,0:04:38.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, dia adikku, Cyril.
Dialogue: 0,0:04:38.93,0:04:41.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salam kenal.\NAku menyambut kedatanganmu.
Dialogue: 0,0:04:41.09,0:04:42.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, baik.
Dialogue: 0,0:04:42.51,0:04:44.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salam kenal, ya.
Dialogue: 0,0:04:44.26,0:04:46.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Pangeran Pertama, Raldo.
Dialogue: 0,0:04:46.85,0:04:49.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suatu kehormatan memiliki\Nadik semanis dirimu.
Dialogue: 0,0:04:49.52,0:04:52.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mo-Mohon bantuannya.
Dialogue: 0,0:04:52.19,0:04:53.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu.
Dialogue: 0,0:04:53.02,0:04:54.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo, Elisa!
Dialogue: 0,0:04:55.40,0:04:58.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namaku Cathy, Putri Ketiga!
Dialogue: 0,0:04:58.19,0:04:59.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, iya.
Dialogue: 0,0:04:59.28,0:05:00.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salam kenal, Elisa!
Dialogue: 0,0:05:00.86,0:05:05.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak tahu punya adik,\Naku selalu ingin bertemu denganmu!
Dialogue: 0,0:05:05.45,0:05:09.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Punya adik semanis kamu\Nsudah seperti mimpi saja!
Dialogue: 0,0:05:09.04,0:05:11.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Panggil aku Mbakyu, ya!
Dialogue: 0,0:05:11.58,0:05:13.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ayunda juga boleh.\N- A-Anu...
Dialogue: 0,0:05:13.38,0:05:16.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi menurutku, sebaiknya sapa aku\Nyang lebih santai saja!
Dialogue: 0,0:05:16.13,0:05:18.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, mending Mbakyu saja, bagaimana?
Dialogue: 0,0:05:19.72,0:05:20.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu...
Dialogue: 0,0:05:20.97,0:05:22.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong...
Dialogue: 0,0:05:22.47,0:05:24.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manusia pria di sebelah sana...
Dialogue: 0,0:05:24.80,0:05:25.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:05:25.64,0:05:27.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa hubungannya denganmu?
Dialogue: 0,0:05:27.81,0:05:29.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, saya...
Dialogue: 0,0:05:29.23,0:05:30.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di-Dia...
Dialogue: 0,0:05:31.31,0:05:33.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia kekasihku!
Dialogue: 0,0:05:34.23,0:05:35.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekasihku!
Dialogue: 0,0:05:37.04,0:05:40.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Hah?\N- A-Apa?
Dialogue: 0,0:05:47.49,0:05:48.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:05:48.91,0:05:51.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya kekasihnya Elisa.
Dialogue: 0,0:05:56.59,0:06:00.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira dia anak yang pendiam.
Dialogue: 0,0:06:00.17,0:06:01.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh juga cara mainnya.
Dialogue: 0,0:06:04.13,0:06:06.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa?
Dialogue: 0,0:06:08.10,0:06:12.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, bisa ulangi lagi?
Dialogue: 0,0:06:12.10,0:06:13.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:06:13.25,0:06:15.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya berpura-pura menjadi kekasih Elisa.
Dialogue: 0,0:06:16.36,0:06:19.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon beri saya nasihat tentang\Ncara bersikap layaknya seorang kekasih.
Dialogue: 0,0:06:19.98,0:06:24.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kira mau bahas apa\Nsaat baru sampai di Alferia...
Dialogue: 0,0:06:24.44,0:06:25.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana menurutmu, Abbie?
Dialogue: 0,0:06:26.45,0:06:27.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak bisa komentar.
Dialogue: 0,0:06:29.94,0:06:34.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya-Yah, aku punya pengalaman\Npercintaan yang sangat luas.
Dialogue: 0,0:06:34.00,0:06:36.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, Master memang hebat!
Dialogue: 0,0:06:37.76,0:06:40.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, ada saran, Carla?
Dialogue: 0,0:06:40.88,0:06:45.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksud Anda tentang bersikap\Nlayaknya kekasih Nona Elisa?
Dialogue: 0,0:06:46.05,0:06:46.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:06:48.25,0:06:50.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf soal tadi!
Dialogue: 0,0:06:50.06,0:06:52.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, aku tidak keberatan.
Dialogue: 0,0:06:52.21,0:06:54.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, ada apa sebenarnya?
Dialogue: 0,0:06:54.39,0:07:00.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya semua orang\Nmemperlakukanku seperti barang...
Dialogue: 0,0:07:00.55,0:07:02.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi takut...
Dialogue: 0,0:07:03.13,0:07:07.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya ingin menjalankan peran kekasih\Ndengan sempurna demi Elisa!
Dialogue: 0,0:07:07.24,0:07:08.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya mengerti.
Dialogue: 0,0:07:08.49,0:07:09.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:07:10.08,0:07:13.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kira-kira, seberapa lama\Nhubungan kalian akan berlangsung?
Dialogue: 0,0:07:13.00,0:07:14.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ada yang membuat kalian jadi dekat?
Dialogue: 0,0:07:14.79,0:07:17.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kencan seperti apa yang disukai Nona Elisa?
Dialogue: 0,0:07:17.33,0:07:20.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, saya sama sekali\Ntidak memikirkannya.
Dialogue: 0,0:07:20.67,0:07:21.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu.
Dialogue: 0,0:07:21.92,0:07:25.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begini, sepertinya ada banyak hal\Nyang perlu saya ajarkan.
Dialogue: 0,0:07:25.51,0:07:26.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon bantuannya!
Dialogue: 0,0:07:26.93,0:07:31.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si Carla ini, jangan-jangan\Ndia pakar percintaan?
Dialogue: 0,0:07:31.43,0:07:33.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, mari mulai dari awal.
Dialogue: 0,0:07:33.81,0:07:34.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:07:37.35,0:07:40.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, jujur aku sempat kaget.
Dialogue: 0,0:07:40.19,0:07:41.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa sangka Ray sama Elisa...
Dialogue: 0,0:07:41.94,0:07:43.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya sejak kapan?
Dialogue: 0,0:07:43.94,0:07:47.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, aku tidak bisa jelaskan secara rinci.
Dialogue: 0,0:07:48.51,0:07:52.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, apa pun alasannya,\Nkami tetap ada di pihakmu, Ray.
Dialogue: 0,0:07:52.37,0:07:53.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:07:53.20,0:07:54.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian berdua...
Dialogue: 0,0:07:55.20,0:07:56.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah...
Dialogue: 0,0:07:56.46,0:07:57.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah waktunya...
Dialogue: 0,0:07:57.71,0:07:59.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah mau pergi?
Dialogue: 0,0:07:59.25,0:08:01.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, kalau tak segera lapor,\NAmelia dan yang lainnya—
Dialogue: 0,0:08:01.75,0:08:03.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Latihan otot! Kuncinya latihan otot!
Dialogue: 0,0:08:04.09,0:08:06.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, benar! Latihan otot!
Dialogue: 0,0:08:06.97,0:08:08.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai nanti, Ray!
Dialogue: 0,0:08:08.47,0:08:09.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ayo!\N- Ya...
Dialogue: 0,0:08:17.89,0:08:20.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu Ray White?
Dialogue: 0,0:08:21.34,0:08:23.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, memang benar...
Dialogue: 0,0:08:23.40,0:08:24.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu siapa?
Dialogue: 0,0:08:24.48,0:08:27.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namaku Marius Basset...
Dialogue: 0,0:08:27.74,0:08:29.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Marius...
Dialogue: 0,0:08:30.66,0:08:32.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyihir Gemilang.
Dialogue: 0,0:08:32.99,0:08:35.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salam kenal, Pedang Es...
Dialogue: 0,0:08:36.45,0:08:40.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan tinggal di sini\Nsementara waktu...
Dialogue: 0,0:08:40.00,0:08:42.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau butuh bantuan,\Nbilang saja, jangan sungkan.
Dialogue: 0,0:08:42.25,0:08:45.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, terima kasih banyak.
Dialogue: 0,0:08:46.84,0:08:49.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku permisi dulu.
Dialogue: 0,0:08:53.39,0:08:54.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa dia kepanasan?
Dialogue: 0,0:08:58.85,0:08:59.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh?
Dialogue: 0,0:08:59.77,0:09:00.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teman-teman.
Dialogue: 0,0:09:00.94,0:09:02.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke-Kebetulan, ya.
Dialogue: 0,0:09:02.52,0:09:05.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke-Kebetulan kami sedang jalan-jalan.
Dialogue: 0,0:09:05.19,0:09:06.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:09:06.28,0:09:08.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, begini...
Dialogue: 0,0:09:08.53,0:09:10.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurut Ray, bagaimana?
Dialogue: 0,0:09:10.95,0:09:12.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudnya?
Dialogue: 0,0:09:12.16,0:09:14.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami tidak bisa menjelaskan secara detail...
Dialogue: 0,0:09:14.87,0:09:18.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana pendapatmu\Nsoal hubungan kekasih dan percintaan?
Dialogue: 0,0:09:22.79,0:09:24.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurang tahu.
Dialogue: 0,0:09:25.04,0:09:29.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah tanya banyak hal ke Carla,\Ntapi masih belum paham.
Dialogue: 0,0:09:29.80,0:09:31.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu, ya!
Dialogue: 0,0:09:31.80,0:09:33.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu rupanya!
Dialogue: 0,0:09:34.64,0:09:37.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan apa-apa, kok.
Dialogue: 0,0:09:37.06,0:09:40.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami sekadar memastikan saja\Nuntuk berjaga-jaga.
Dialogue: 0,0:09:42.29,0:09:44.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Percintaan, ya?
Dialogue: 0,0:09:44.06,0:09:46.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Elisa bagaimana, ya?
Dialogue: 0,0:09:49.82,0:09:51.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yamoo.
Dialogue: 0,0:09:52.24,0:09:55.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Ray, malam ini\Nsilakan beristirahat di sini.
Dialogue: 0,0:09:56.05,0:09:56.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya permisi.
Dialogue: 0,0:10:00.29,0:10:02.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidur di lantai saja.
Dialogue: 0,0:10:02.25,0:10:06.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kita dikira sepasang kekasih...
Dialogue: 0,0:10:06.42,0:10:07.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku...
Dialogue: 0,0:10:09.00,0:10:12.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak keberatan!
Dialogue: 0,0:10:15.49,0:10:17.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ray, masih bangun?
Dialogue: 0,0:10:18.76,0:10:19.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:10:20.29,0:10:23.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini, sekali lagi maaf, ya.
Dialogue: 0,0:10:23.19,0:10:24.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu dipikirkan.
Dialogue: 0,0:10:24.81,0:10:26.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:10:26.19,0:10:28.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita ini sahabat.
Dialogue: 0,0:10:28.19,0:10:30.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau butuh bantuan, bilang saja.
Dialogue: 0,0:10:31.69,0:10:35.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, jangan bilang minta maaf,\Ntapi bilang terima kasih.
Dialogue: 0,0:10:36.12,0:10:37.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih?
Dialogue: 0,0:10:37.20,0:10:40.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, kamu tidak perlu merasa bersalah.
Dialogue: 0,0:10:40.70,0:10:42.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ucapkan saja terima kasih.
Dialogue: 0,0:10:42.71,0:10:43.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sudah cukup.
Dialogue: 0,0:10:44.55,0:10:48.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, Ray, terima kasih.
Dialogue: 0,0:10:48.34,0:10:49.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:10:50.17,0:10:53.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa sangka Elisa itu Putri Keempat.
Dialogue: 0,0:10:54.13,0:10:55.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Abbie, kamu juga tahu?
Dialogue: 0,0:10:55.97,0:10:57.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya tahu sedikit.
Dialogue: 0,0:10:57.60,0:10:59.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ini Kepala Akademi.
Dialogue: 0,0:10:59.39,0:11:01.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kepala Akademi memang hebat!
Dialogue: 0,0:11:01.27,0:11:06.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, dipanggil di momen seperti ini,\Napa ada maksud tertentu, ya?
Dialogue: 0,0:11:07.73,0:11:09.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga, ya.
Dialogue: 0,0:11:09.65,0:11:10.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:11:10.85,0:11:12.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia lagi kerepotan.
Dialogue: 0,0:11:13.24,0:11:16.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena harus menghadapi dirinya sendiri, kan?
Dialogue: 0,0:11:19.37,0:11:20.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elisa.
Dialogue: 0,0:11:20.92,0:11:23.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bangun, Elisa.
Dialogue: 0,0:11:28.29,0:11:31.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ray, selamat pagi.
Dialogue: 0,0:11:31.38,0:11:33.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, selamat pagi.
Dialogue: 0,0:11:33.71,0:11:37.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, rapikan kancing baju bagian dadamu.
Dialogue: 0,0:11:37.88,0:11:38.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:11:39.76,0:11:40.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah!
Dialogue: 0,0:11:43.80,0:11:45.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuacanya pas.
Dialogue: 0,0:11:45.27,0:11:47.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elisa, ayo kita kencan.
Dialogue: 0,0:11:47.52,0:11:49.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cenat-cenut!
Dialogue: 0,0:11:53.63,0:11:54.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo!
Dialogue: 0,0:11:55.40,0:11:56.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:11:56.48,0:11:59.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya, sekarang kita itu kopel.
Dialogue: 0,0:11:59.78,0:12:03.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu sebagai kopel,\Nkonon kalau saat di luar, kita harus
Dialogue: 0,0:12:03.96,0:12:05.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}gandengan tangan...
Dialogue: 0,0:12:05.73,0:12:07.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bicara soal kencan,\Nini tentang gandengan tangan.
Dialogue: 0,0:12:07.83,0:12:10.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kawal pasangan Anda dengan elegan.
Dialogue: 0,0:12:10.75,0:12:12.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa mungkin kamu merasa risi?
Dialogue: 0,0:12:12.84,0:12:13.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:12:13.55,0:12:15.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak.
Dialogue: 0,0:12:16.59,0:12:19.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...\NPermisi!
Dialogue: 0,0:12:22.35,0:12:23.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yey!
Dialogue: 0,0:12:23.56,0:12:24.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tori!
Dialogue: 0,0:12:24.52,0:12:25.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa, Sugary?
Dialogue: 0,0:12:25.68,0:12:27.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku padamu!
Dialogue: 0,0:12:27.02,0:12:28.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga!
Dialogue: 0,0:12:28.06,0:12:29.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yey!
Dialogue: 0,0:12:35.80,0:12:39.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyesuaikan langkah seorang gadis\Nadalah tugas pria sejati.
Dialogue: 0,0:12:43.80,0:12:48.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terkadang, menunjukkan\Nkemampuan fisik juga penting.
Dialogue: 0,0:12:51.08,0:12:56.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan begitu, pasangan akan merasa aman\Nsehingga bisa kencan dengan santai.
Dialogue: 0,0:12:59.78,0:13:01.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah.
Dialogue: 0,0:13:01.09,0:13:02.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bunganya unik, ya.
Dialogue: 0,0:13:02.76,0:13:07.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pernah melihatnya di ensiklopedia,\Ntapi baru kali ini melihat aslinya.
Dialogue: 0,0:13:07.22,0:13:08.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada Putri!
Dialogue: 0,0:13:08.81,0:13:09.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:13:09.89,0:13:10.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah!
Dialogue: 0,0:13:10.56,0:13:11.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putri!
Dialogue: 0,0:13:12.35,0:13:13.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, cantiknya!
Dialogue: 0,0:13:13.65,0:13:14.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anggun!
Dialogue: 0,0:13:14.73,0:13:15.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah...
Dialogue: 0,0:13:15.63,0:13:18.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bahkan dikenal anak-anak kecil, ya.
Dialogue: 0,0:13:18.24,0:13:19.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Anu...
Dialogue: 0,0:13:19.53,0:13:22.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kalian kopel, kan?
Dialogue: 0,0:13:22.17,0:13:23.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ciye, ciye!
Dialogue: 0,0:13:23.20,0:13:23.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:13:23.99,0:13:27.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, hubungan kalian\Nsudah sejauh mana?
Dialogue: 0,0:13:27.16,0:13:28.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejauh mana?
Dialogue: 0,0:13:28.87,0:13:30.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah saling menautkan jari?
Dialogue: 0,0:13:30.46,0:13:31.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ciye, ciye!
Dialogue: 0,0:13:31.12,0:13:32.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah tidur bareng?
Dialogue: 0,0:13:32.29,0:13:33.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cihuy!
Dialogue: 0,0:13:33.38,0:13:34.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cenat-cenut!
Dialogue: 0,0:13:34.92,0:13:36.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau malah...
Dialogue: 0,0:13:36.13,0:13:37.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian sudah
Dialogue: 0,0:13:37.84,0:13:38.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ciuman?
Dialogue: 0,0:13:38.88,0:13:40.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ciuman?
Dialogue: 0,0:13:40.59,0:13:43.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh? Elisa, kamu tidak apa-apa?
Dialogue: 0,0:13:44.09,0:13:45.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Adik-adik, maaf, ya.
Dialogue: 0,0:13:45.43,0:13:46.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh.
Dialogue: 0,0:13:46.39,0:13:48.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya Putri Elisa kelelahan.
Dialogue: 0,0:13:48.85,0:13:50.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami permisi dulu.
Dialogue: 0,0:13:50.31,0:13:51.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:13:54.48,0:13:58.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat, itu gaya gendong putri yang asli.
Dialogue: 0,0:13:58.11,0:13:59.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:13:59.19,0:14:00.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:14:00.44,0:14:03.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Umur para Elf lebih tua\Ndari penampilan luar mereka.
Dialogue: 0,0:14:09.95,0:14:11.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ray?
Dialogue: 0,0:14:11.96,0:14:13.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah siuman, ya?
Dialogue: 0,0:14:13.37,0:14:14.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah...
Dialogue: 0,0:14:14.29,0:14:16.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maaf!\NAku...
Dialogue: 0,0:14:16.54,0:14:17.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.
Dialogue: 0,0:14:20.55,0:14:22.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu...
Dialogue: 0,0:14:22.05,0:14:24.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata sulit juga, ya.
Dialogue: 0,0:14:24.72,0:14:27.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bertingkah layaknya kopel.
Dialogue: 0,0:14:28.97,0:14:31.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, benar juga.
Dialogue: 0,0:14:36.06,0:14:37.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elisa?
Dialogue: 0,0:14:37.23,0:14:38.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ray!
Dialogue: 0,0:14:39.53,0:14:41.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh aku latihan lagi!
Dialogue: 0,0:14:42.53,0:14:44.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, boleh.
Dialogue: 0,0:14:44.24,0:14:46.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu dulu!
Dialogue: 0,0:14:47.53,0:14:49.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putri Ketiga Cathy?
Dialogue: 0,0:14:50.83,0:14:54.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kekasihnya Elisa, ya, kan?
Dialogue: 0,0:14:54.33,0:14:56.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, benar.
Dialogue: 0,0:14:56.00,0:14:58.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa-bisanya masih pura-pura!
Dialogue: 0,0:14:58.95,0:15:00.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tadi lihat!
Dialogue: 0,0:15:00.46,0:15:03.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemarin, kamu dikerumuni\Ngadis-gadis manusia, kan?
Dialogue: 0,0:15:03.59,0:15:05.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu namanya selingkuh, tahu!\NDasar tidak setia!
Dialogue: 0,0:15:06.54,0:15:09.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak setia!\NDasar pria ganjen!
Dialogue: 0,0:15:09.35,0:15:11.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tukang selingkuh!
Dialogue: 0,0:15:13.35,0:15:15.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka itu teman saya.
Dialogue: 0,0:15:15.44,0:15:17.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan berarti saya tidak setia.
Dialogue: 0,0:15:17.02,0:15:18.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma ingin bilang!
Dialogue: 0,0:15:18.11,0:15:21.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu tahu punya adik,\Naku sangat senang!
Dialogue: 0,0:15:21.44,0:15:25.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah janji, apa pun situasinya,\Naku akan selalu menyayanginya!
Dialogue: 0,0:15:25.03,0:15:27.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau aku ajak jalan-jalan bersama,\Naku rias dia dengan baju imut,
Dialogue: 0,0:15:27.87,0:15:29.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menyisirkan rambutnya yang indah,
Dialogue: 0,0:15:29.58,0:15:31.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}membayangkan betapa indahnya itu semua,
Dialogue: 0,0:15:31.62,0:15:33.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}merawatnya dalam segala hal,
Dialogue: 0,0:15:33.37,0:15:36.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan membuatnya sangat mencintai Alferia!
Dialogue: 0,0:15:36.71,0:15:38.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kenapa?
Dialogue: 0,0:15:38.25,0:15:41.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elisa punya kekasih manusia?
Dialogue: 0,0:15:42.55,0:15:45.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu,\Naku berusaha untuk menerimanya!
Dialogue: 0,0:15:45.34,0:15:47.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena dia manusia pilihan Elisa,
Dialogue: 0,0:15:47.26,0:15:49.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kupikir dia bukan pria yang jahat...
Dialogue: 0,0:15:50.26,0:15:53.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi ternyata dugaanku benar!\NDasar Buaya Buntung!
Dialogue: 0,0:15:53.89,0:15:56.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putri Cathy, sebutan itu agak...
Dialogue: 0,0:15:56.31,0:15:57.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu, ya?
Dialogue: 0,0:15:57.60,0:15:58.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitulah.
Dialogue: 0,0:15:59.81,0:16:02.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar Buaya Darat tak tahu diri!
Dialogue: 0,0:16:03.69,0:16:06.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu memang tidak bisa dipercaya!
Dialogue: 0,0:16:06.45,0:16:10.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah jelas kamu tidak\Nmencintai Elisa dengan tulus!
Dialogue: 0,0:16:10.16,0:16:11.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, Nona Cathy...
Dialogue: 0,0:16:11.45,0:16:12.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tidak benar!
Dialogue: 0,0:16:13.16,0:16:16.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tulus mencintai Elisa!
Dialogue: 0,0:16:19.17,0:16:20.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elisa?
Dialogue: 0,0:16:20.17,0:16:23.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Elisa, kamu baik-baik saja?\N- Dasar, paling dia cuma gombal!
Dialogue: 0,0:16:23.00,0:16:26.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kalau kamu bisa\Nmelewati ujian yang kuberikan,
Dialogue: 0,0:16:26.92,0:16:30.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku mungkin akan merestuimu.
Dialogue: 0,0:16:30.93,0:16:32.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujian, ya?
Dialogue: 0,0:16:32.60,0:16:33.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:16:33.43,0:16:37.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di salah satu tempat\Npaling berbahaya di Alferia,
Dialogue: 0,0:16:37.18,0:16:38.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hutan Parade.
Dialogue: 0,0:16:38.48,0:16:42.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ambilkan tanaman Mandrake\Nyang tumbuh liar di sana!
Dialogue: 0,0:16:42.19,0:16:43.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cukup begitu saja?
Dialogue: 0,0:16:44.69,0:16:48.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini ujian tersulit bagi bangsa Elf.
Dialogue: 0,0:16:48.45,0:16:49.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena...
Dialogue: 0,0:16:49.95,0:16:52.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu Mandrake dicabut dari tanah!
Dialogue: 0,0:16:52.03,0:16:53.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mandrake akan mengeluarkan jeritan nyaring!
Dialogue: 0,0:16:53.89,0:16:55.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membuat pendengarnya pingsan dan tersiksa!
Dialogue: 0,0:16:55.74,0:16:57.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Intinya, sangat berbahaya!
Dialogue: 0,0:16:58.37,0:17:00.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana?\NSeram, kan?
Dialogue: 0,0:17:00.87,0:17:04.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sendiri tahu betul\Nseberapa konyolnya permintaan itu!
Dialogue: 0,0:17:04.58,0:17:08.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kebolehanmu itu sangat dibutuhkan\Nuntuk melindungi keluarga Alferia!
Dialogue: 0,0:17:08.33,0:17:11.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, kalau kamu minta maaf\Nsambil merengek dan putus dengan Elisa—
Dialogue: 0,0:17:11.80,0:17:12.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:17:12.51,0:17:13.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:17:13.65,0:17:16.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya akan pergi mengambil Mandrake.
Dialogue: 0,0:17:17.02,0:17:20.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya akan segera bersiap\Ndan berangkat besok pagi-pagi buta.
Dialogue: 0,0:17:21.01,0:17:22.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ada batas waktunya?
Dialogue: 0,0:17:22.73,0:17:23.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:17:23.77,0:17:27.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm... mungkin sampai matahari terbenam?
Dialogue: 0,0:17:27.85,0:17:29.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:17:29.69,0:17:30.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti kutuntaskan.
Dialogue: 0,0:17:35.66,0:17:37.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Mia.
Dialogue: 0,0:17:37.37,0:17:40.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malam ini aku akan melakukan persiapan\Nuntuk besok di sini.
Dialogue: 0,0:17:40.62,0:17:42.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong jaga Elisa.
Dialogue: 0,0:17:42.75,0:17:45.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, serahkan pada saya.
Dialogue: 0,0:17:47.34,0:17:49.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sendirian lagi.
Dialogue: 0,0:17:53.39,0:17:54.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:17:55.76,0:17:57.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Claris?
Dialogue: 0,0:17:57.64,0:17:58.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mampir!
Dialogue: 0,0:18:00.10,0:18:01.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh.
Dialogue: 0,0:18:01.64,0:18:05.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi sekarang, Ray sedang\Nmenghadapi ujian dari mbakyumu, ya?
Dialogue: 0,0:18:05.52,0:18:08.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, tanpa sadar, malah jadi begini.
Dialogue: 0,0:18:08.61,0:18:10.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya tanpa sadar?
Dialogue: 0,0:18:10.61,0:18:13.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, maksudku, tadi aku tidak memperhatikan!
Dialogue: 0,0:18:13.53,0:18:14.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh.
Dialogue: 0,0:18:14.66,0:18:19.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Se-Sejak datang ke negeri ini,\Nterjadi banyak hal yang membingungkan...
Dialogue: 0,0:18:20.79,0:18:25.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ditambah lagi, aku malah melibatkan Ray\Ndan merepotkannya...
Dialogue: 0,0:18:25.29,0:18:27.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus bagaimana?
Dialogue: 0,0:18:27.88,0:18:29.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu cemas.
Dialogue: 0,0:18:29.96,0:18:32.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ray pasti bisa melewati semuanya\Ndengan mudah!
Dialogue: 0,0:18:32.38,0:18:33.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:18:35.05,0:18:37.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putri Elisa, apa ada orang lain di dalam?
Dialogue: 0,0:18:37.89,0:18:40.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Tidak ada...\NAku bicara sendiri!
Dialogue: 0,0:18:40.43,0:18:41.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh.
Dialogue: 0,0:18:41.48,0:18:44.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, apa Anda ingin\Nmakan malam di kamar?
Dialogue: 0,0:18:44.64,0:18:46.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan makan di bawah.
Dialogue: 0,0:18:46.73,0:18:47.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:18:47.95,0:18:49.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kalau begitu, akan saya siapkan.\N- Aku pulang dulu, ya.
Dialogue: 0,0:18:49.61,0:18:51.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Terima kasih banyak!\N- Sampai besok.
Dialogue: 0,0:18:52.32,0:18:55.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Besok?\NKamu akan datang juga?
Dialogue: 0,0:18:56.66,0:18:58.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita kan sahabat.
Dialogue: 0,0:19:11.00,0:19:12.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah!
Dialogue: 0,0:19:26.60,0:19:28.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira dia menyadariku...
Dialogue: 0,0:19:28.77,0:19:30.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya aku aman.
Dialogue: 0,0:19:31.19,0:19:33.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, di balik sana
Dialogue: 0,0:19:33.28,0:19:35.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tempat yang dimaksud, ya?
Dialogue: 0,0:19:35.65,0:19:37.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, terserahlah.
Dialogue: 0,0:19:37.61,0:19:39.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak akan ikut campur.
Dialogue: 0,0:19:39.66,0:19:42.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Urus urusanmu sendiri.
Dialogue: 0,0:19:44.79,0:19:47.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, kenapa kamu diam terus?
Dialogue: 0,0:19:47.17,0:19:50.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malah menyalakan mata segala!\NKamu kebanyakan gaya!
Dialogue: 0,0:19:50.88,0:19:52.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar!
Dialogue: 0,0:19:54.30,0:19:57.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini, hutannya tampak\Nlebih berbahaya, ya.
Dialogue: 0,0:19:57.18,0:20:01.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau seperti ini, pasti mustahil\Nbisa mengambil Mandrake!
Dialogue: 0,0:20:01.01,0:20:03.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, apa dia benar-benar masuk ke sana?
Dialogue: 0,0:20:03.93,0:20:06.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, dia memang masuk ke sana.
Dialogue: 0,0:20:06.69,0:20:08.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yakin akan baik-baik saja?
Dialogue: 0,0:20:08.77,0:20:11.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ray, bagaimana ini?
Dialogue: 0,0:20:11.11,0:20:13.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja, Ray pasti bisa.
Dialogue: 0,0:20:15.90,0:20:17.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuh, lihat!
Dialogue: 0,0:20:17.66,0:20:18.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah!
Dialogue: 0,0:20:19.66,0:20:23.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ray!
Dialogue: 0,0:20:23.70,0:20:25.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf menunggu lama.
Dialogue: 0,0:20:26.31,0:20:28.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga kamu pasti\Nmenyerah dan kembali!
Dialogue: 0,0:20:29.03,0:20:31.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, keputusan yang bijak.
Dialogue: 0,0:20:31.00,0:20:32.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, sudah dapat.
Dialogue: 0,0:20:32.63,0:20:33.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:20:33.46,0:20:36.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok bisa secepat ini?
Dialogue: 0,0:20:36.01,0:20:38.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sekadar masuk lalu kembali.
Dialogue: 0,0:20:38.59,0:20:40.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekadar?
Dialogue: 0,0:20:40.09,0:20:41.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:20:41.01,0:20:43.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tung—\NBerat banget!
Dialogue: 0,0:20:44.43,0:20:46.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Mana mungkin...
Dialogue: 0,0:20:48.56,0:20:50.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:20:50.10,0:20:53.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang kamu masukkan pasti\Ncuma rumput liar!
Dialogue: 0,0:20:54.27,0:20:56.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuh, kan...
Dialogue: 0,0:20:56.05,0:20:56.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:21:01.39,0:21:03.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Putri Cathy!\N- Nona Cathy!
Dialogue: 0,0:21:03.24,0:21:05.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putri Cathy!
Dialogue: 0,0:21:06.14,0:21:08.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku melihat cahaya...
Dialogue: 0,0:21:11.29,0:21:12.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya.
Dialogue: 0,0:21:13.04,0:21:15.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih atas kehadirannya.
Dialogue: 0,0:21:15.09,0:21:17.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa malah kumpul di kamarku?
Dialogue: 0,0:21:17.13,0:21:18.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:21:18.09,0:21:21.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana pendapat kalian\Nperihal situasi ini?
Dialogue: 0,0:21:21.30,0:21:24.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutku ini sangat amat gawat.
Dialogue: 0,0:21:24.76,0:21:28.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, situasi ini sangat memprihatinkan.
Dialogue: 0,0:21:28.02,0:21:29.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau terus dibiarkan...
Dialogue: 0,0:21:29.85,0:21:32.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus kalau perasaan cinta\Nmilik Ray mulai bangkit.
Dialogue: 0,0:21:33.06,0:21:38.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kalau di saat itu yang ada\Ndi hadapannya adalah Elisa...
Dialogue: 0,0:21:38.19,0:21:42.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu akan jadi sangat teramat gawat!
Dialogue: 0,0:21:42.53,0:21:44.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa terjadi fenomena imprinting cinta!
Dialogue: 0,0:21:46.99,0:21:49.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fenomena imprinting cinta?
Dialogue: 0,0:21:50.33,0:21:52.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kita harus bagaimana?
Dialogue: 0,0:21:52.37,0:21:55.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih ada banyak kemungkinan.
Dialogue: 0,0:21:55.00,0:21:59.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengenai perkembangannya, saya minta\NClaris untuk terus memantau.
Dialogue: 0,0:22:00.13,0:22:02.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah dengar semuanya!
Dialogue: 0,0:22:02.81,0:22:06.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Artinya, kalian bertiga itu\Nrival cintaku, kan?
Dialogue: 0,0:22:08.27,0:22:08.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:22:10.00,0:22:13.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah melakukan penyelidikan mandiri!
Dialogue: 0,0:22:15.67,0:22:18.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau kita bekerja sama?
Dialogue: 0,0:22:20.65,0:22:22.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya!
Dialogue: 0,0:22:22.15,0:22:25.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mandrake saja belum cukup\Nuntuk membuatku mengakui kebolehanmu!
Dialogue: 0,0:22:25.91,0:22:27.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu benar!
Dialogue: 0,0:22:27.45,0:22:29.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudnya?
Dialogue: 0,0:22:29.04,0:22:32.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai dari sini, aku sendiri yang akan\Nmengawasimu dari dekat.
Dialogue: 0,0:22:32.91,0:22:34.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk ujian berikutnya.
Dialogue: 0,0:22:35.17,0:22:36.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:22:36.21,0:22:37.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tersenyumlah...
Dialogue: 0,0:22:37.67,0:22:38.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selagi bisa!
Dialogue: 0,0:22:38.92,0:22:40.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa semuanya bisa lancar?
Dialogue: 0,0:22:40.55,0:22:42.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Percaya sama Ray.
Dialogue: 0,0:22:42.63,0:22:43.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:22:45.66,0:22:47.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, coba kita lihat hasil pancinganmu!
Dialogue: 0,0:22:48.47,0:22:49.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah dapat.
Dialogue: 0,0:22:49.35,0:22:50.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak banget!
Dialogue: 0,0:22:50.43,0:22:52.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, bagaimana\Ndengan keahlian memasakmu?
Dialogue: 0,0:22:53.34,0:22:54.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terpanggang sempurna.
Dialogue: 0,0:22:54.73,0:22:55.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cih!
Dialogue: 0,0:22:55.19,0:22:57.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana dengan kematangannya?
Dialogue: 0,0:22:57.90,0:22:59.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak!
Dialogue: 0,0:22:59.57,0:23:01.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Garamnya pas sekali!
Dialogue: 0,0:23:02.36,0:23:05.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita lihat pergaulanmu\Ndengan para sepuh lokal di daerah sini.
Dialogue: 0,0:23:05.20,0:23:06.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ron!
Dialogue: 0,0:23:06.70,0:23:08.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kalah.
Dialogue: 0,0:23:10.69,0:23:11.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh juga!
Dialogue: 0,0:23:11.95,0:23:13.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa sudah selesai?
Dialogue: 0,0:23:13.50,0:23:15.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum, belum, belum...\NBelum!
Dialogue: 0,0:23:17.21,0:23:18.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya sudah dilipat.
Dialogue: 0,0:23:18.96,0:23:20.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekalian, ruangnya pun sudah kubersihkan.
Dialogue: 0,0:23:20.71,0:23:21.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ray...
Dialogue: 0,0:23:21.80,0:23:23.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu hebat, Ray!
Dialogue: 0,0:23:23.13,0:23:23.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar...
Dialogue: 0,0:23:23.84,0:23:26.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan jago bersih-bersih dan mencuci...
Dialogue: 0,0:23:27.72,0:23:31.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama sekali tak punya celah!
Dialogue: 0,0:23:31.31,0:23:33.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Celah... Celah...
Dialogue: 0,0:23:33.14,0:23:34.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama sekali tak punya celah.
Dialogue: 0,0:23:48.78,0:23:50.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namaku Cathy Alferius!
Dialogue: 0,0:23:50.41,0:23:52.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mbakyunya Elisa yang paling manis!
Dialogue: 0,0:23:52.12,0:23:53.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putri Cathy yang cantik berpendidikan tinggi!
Dialogue: 0,0:23:53.87,0:23:54.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Juga Elisa.
Dialogue: 0,0:23:54.66,0:23:55.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama Claris.
Dialogue: 0,0:23:55.58,0:23:56.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan pikir kamu sudah menang!
Dialogue: 0,0:23:56.87,0:23:58.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Anu, maaf...\N- Kita masih lanjut, Here We Go!
Dialogue: 0,0:23:58.42,0:23:58.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu!
Dialogue: 0,0:23:58.88,0:23:59.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- He Can Nice! (Anti-kapok)\N- Cold Be Nice! (Anti-caper)
Dialogue: 0,0:23:59.79,0:24:00.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Carry me tonight! (Anti-baper)
Dialogue: 0,0:24:00.50,0:24:01.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Need to get nice! (Anti-hengkang)\N- Make it nice! (Anti-nyerah)
Dialogue: 0,0:24:01.46,0:24:02.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yeah, Today, Yeah, right now!
Dialogue: 0,0:24:02.05,0:24:03.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Go to, and die!
Dialogue: 0,0:24:03.05,0:24:03.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya!
Dialogue: 0,0:24:03.59,0:24:05.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyihir Pedang Es akan Menguasai Dunia...
Dialogue: 0,0:24:05.26,0:24:06.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dua!
Dialogue: 0,0:24:07.22,0:24:09.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami masih lanjut, episode enam!
Dialogue: 0,0:24:09.05,0:24:11.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Pemuda yang Merupakan\NPenyihir Terkuat di Dunia
Dialogue: 0,0:24:11.47,0:24:13.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menghadapi Ujian yang Menghadang"!
