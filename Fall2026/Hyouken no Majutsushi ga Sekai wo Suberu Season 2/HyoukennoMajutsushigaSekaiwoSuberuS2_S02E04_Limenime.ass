Dialogue: 0,0:04:02.47,0:04:06.89,sign,,0000,0000,0000,,PENYIHIR PEDANG ES\NAKAN MENGUASAI DUNIA SEASON 2
Dialogue: 0,0:04:06.89,0:04:09.28,sign,,0000,0000,0000,,EPISODE 4: PEMUDA YANG MERUPAKAN\NPENYIHIR TERKUAT DI DUNIA
Dialogue: 0,0:04:09.28,0:04:10.98,sign,,0000,0000,0000,,BERINTERAKSI DENGAN KAWANNYA MELALUI TINJU
Dialogue: 0,0:23:48.82,0:23:53.87,sign,,0000,0000,0000,,PRATINJAU
Dialogue: 0,0:00:02.73,0:00:06.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga, kamu yang datang, Ray!
Dialogue: 0,0:00:07.57,0:00:08.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya!
Dialogue: 0,0:00:08.74,0:00:10.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf saja.
Dialogue: 0,0:00:11.20,0:00:13.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian berdua akan kukalahkan di sini!
Dialogue: 0,0:00:23.63,0:00:25.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Langsung serius di awal, ya.
Dialogue: 0,0:00:25.63,0:00:28.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, kami akan mengerahkan segalanya!
Dialogue: 0,0:00:28.01,0:00:30.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami tak akan basa-basi melawanmu!
Dialogue: 0,0:00:33.51,0:00:35.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serang sekarang!
Dialogue: 0,0:00:41.52,0:00:44.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh juga, tapi itu belum cukup...
Dialogue: 0,0:00:46.40,0:00:48.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu... Jangan-jangan...
Dialogue: 0,0:00:53.20,0:00:55.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aurum Reverse.
Dialogue: 0,0:00:55.85,0:00:57.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ariane, ayo kita selesaikan sekaligus.
Dialogue: 0,0:00:57.87,0:00:59.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita langsung gunakan sekarang?
Dialogue: 0,0:00:59.79,0:01:02.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Materia field sedahsyat itu...
Dialogue: 0,0:01:02.79,0:01:05.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bukan lawan yang bisa dianggap remeh.
Dialogue: 0,0:01:05.80,0:01:07.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:01:10.22,0:01:11.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ogre!
Dialogue: 0,0:01:15.14,0:01:16.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gerakan yang bagus.
Dialogue: 0,0:01:16.54,0:01:18.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daya serangnya juga lumayan...
Dialogue: 0,0:01:18.96,0:01:20.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi masih belum mempan padaku.
Dialogue: 0,0:01:25.19,0:01:26.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Amelia!
Dialogue: 0,0:01:27.61,0:01:29.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Butterfly Effect!
Dialogue: 0,0:01:31.20,0:01:34.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang Rahasia Kedelapan:\NPembalikan Senja.
Dialogue: 0,0:01:43.42,0:01:44.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengejutkan.
Dialogue: 0,0:01:44.92,0:01:47.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau hanya soal teknik\Nmenyusun kode sihir,
Dialogue: 0,0:01:47.55,0:01:49.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu hampir setara Tujuh Penyihir Agung.
Dialogue: 0,0:01:50.97,0:01:51.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Percuma!
Dialogue: 0,0:01:51.97,0:01:55.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hukum sebab akibat dunia ini sudah tercipta!
Dialogue: 0,0:02:00.98,0:02:05.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan cuma pertahanan fisik, tapi pertahanan\Nmutlak yang menguasai sebab akibat?
Dialogue: 0,0:02:05.44,0:02:06.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:02:06.52,0:02:08.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Butterfly Effect-nya Amelia,
Dialogue: 0,0:02:08.75,0:02:12.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}membuat serangan Lucas dipastikan\Ntidak akan mengenai targetnya.
Dialogue: 0,0:02:13.35,0:02:17.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Carla, apa si Pink Bodoh itu\Nhabis salah makan lagi?
Dialogue: 0,0:02:17.66,0:02:18.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entahlah...
Dialogue: 0,0:02:18.62,0:02:21.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Origin-mu merepotkan, ya.
Dialogue: 0,0:02:23.75,0:02:26.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita jadikan ini uji ketahanan.
Dialogue: 0,0:02:33.45,0:02:35.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm, kehabisan waktu, ya.
Dialogue: 0,0:02:36.47,0:02:39.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi kelemahan Butterfly Effect-mu...
Dialogue: 0,0:02:39.26,0:02:40.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Durasi aktivasinya, ya?
Dialogue: 0,0:02:44.77,0:02:45.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ariane.
Dialogue: 0,0:02:45.90,0:02:49.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak akan biarkan kamu kena serangan!
Dialogue: 0,0:02:49.21,0:02:51.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya, bertarunglah sepuasmu!
Dialogue: 0,0:02:51.57,0:02:53.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, tentu saja!
Dialogue: 0,0:02:54.51,0:02:57.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai sekarang, mereka sama-sama\Nberpacu dengan waktu.
Dialogue: 0,0:02:57.66,0:03:00.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebelum Butterfly Effect dibatalkan,
Dialogue: 0,0:03:00.54,0:03:04.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa Ariane Olgren mampu\Nmengalahkan Lucas Forst?
Dialogue: 0,0:03:05.87,0:03:08.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau Lucas akan mendesaknya\Ndan menang, kan?
Dialogue: 0,0:03:08.84,0:03:12.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar, jangan memotong komentarku!
Dialogue: 0,0:03:12.17,0:03:13.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berisik, Pink Bodoh.
Dialogue: 0,0:03:13.67,0:03:16.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya ini giliranku!
Dialogue: 0,0:03:16.05,0:03:19.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Sebenarnya mereka punya hubungan apa?\N- Apa salahnya, ya?
Dialogue: 0,0:03:47.08,0:03:49.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu kolor battle yang efektif buat gelut.
Dialogue: 0,0:03:49.13,0:03:50.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tahu, ya, Fran?
Dialogue: 0,0:03:50.21,0:03:50.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:03:50.84,0:03:52.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Busana pria yang diwariskan sejak zaman dulu,
Dialogue: 0,0:03:52.83,0:03:54.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan mengukir perasaannya di bokong.
Dialogue: 0,0:03:54.67,0:03:55.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah pantat tekad.
Dialogue: 0,0:03:55.97,0:03:57.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu teori perlindungan Arnold
Dialogue: 0,0:03:57.59,0:03:59.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bagi yang berpantat.
Dialogue: 0,0:04:15.23,0:04:18.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, berdansalah denganku!
Dialogue: 0,0:04:18.11,0:04:21.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayangnya, aku tak suka berdansa.
Dialogue: 0,0:04:21.74,0:04:23.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aurum Reverse...
Dialogue: 0,0:04:23.33,0:04:24.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:04:24.24,0:04:29.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di dalam domain ini, kita sama-sama\Ntak akan leluasa merapal sihir.
Dialogue: 0,0:04:29.10,0:04:30.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu.
Dialogue: 0,0:04:30.96,0:04:32.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudnya bagaimana, ya?
Dialogue: 0,0:04:32.50,0:04:33.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini...
Dialogue: 0,0:04:33.75,0:04:34.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Prima—
Dialogue: 0,0:04:34.34,0:04:36.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Origin tipe intervensi area luas
Dialogue: 0,0:04:36.76,0:04:39.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang bisa menahan aktivitas\NPrima Materia, bukan?
Dialogue: 0,0:04:39.76,0:04:41.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu!\NRebecca juga ikut memotong!
Dialogue: 0,0:04:42.51,0:04:44.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Rebecca memang cerdas!
Dialogue: 0,0:04:44.31,0:04:45.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, tidak juga.
Dialogue: 0,0:04:46.04,0:04:48.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak awal kalian mengincar situasi ini, ya?
Dialogue: 0,0:04:48.68,0:04:51.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau pakai sihir,\Nkami tak ada peluang menang.
Dialogue: 0,0:04:51.65,0:04:55.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inilah jalan menuju kemenangan\Nyang sudah kami rancang!
Dialogue: 0,0:04:55.40,0:04:59.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ray, ayo kita adu jotos!
Dialogue: 0,0:04:59.15,0:05:00.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:05:01.41,0:05:02.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuterima tantanganmu!
Dialogue: 0,0:05:02.70,0:05:04.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah!
Dialogue: 0,0:05:04.16,0:05:05.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah!
Dialogue: 0,0:05:05.28,0:05:07.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka telanjang!
Dialogue: 0,0:05:10.29,0:05:11.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:05:22.93,0:05:25.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanpa sihir penguatan pun\Ndia masih sekuat ini?
Dialogue: 0,0:05:26.39,0:05:27.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan kami
Dialogue: 0,0:05:27.81,0:05:28.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sangat timpang!
Dialogue: 0,0:05:30.52,0:05:32.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekujur tubuhku terasa sakit...
Dialogue: 0,0:05:32.98,0:05:35.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beban Aurum Reverse juga sangat besar...
Dialogue: 0,0:05:35.94,0:05:38.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kenapa?
Dialogue: 0,0:05:39.40,0:05:40.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini konyol...
Dialogue: 0,0:05:40.82,0:05:42.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, kan, Albert?
Dialogue: 0,0:05:42.15,0:05:44.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, benar!
Dialogue: 0,0:05:45.41,0:05:46.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ray...
Dialogue: 0,0:05:46.60,0:05:50.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkat bertemu denganmu,\Naku bisa berubah.
Dialogue: 0,0:05:50.54,0:05:52.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa melangkah maju.
Dialogue: 0,0:05:52.87,0:05:54.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sebabnya...
Dialogue: 0,0:05:54.67,0:05:57.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin menang darimu!
Dialogue: 0,0:06:05.80,0:06:07.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ray.
Dialogue: 0,0:06:07.81,0:06:09.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ray!
Dialogue: 0,0:06:18.57,0:06:22.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sisanya kuserahkan padamu, Albert...
Dialogue: 0,0:06:25.32,0:06:27.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja, Evi!
Dialogue: 0,0:06:30.13,0:06:33.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya kamu sudah\Nmencapai batas, Albert.
Dialogue: 0,0:06:33.08,0:06:34.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah bertambah kuat.
Dialogue: 0,0:06:35.58,0:06:37.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Majulah dengan seluruh tekadmu.
Dialogue: 0,0:06:38.13,0:06:40.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kuterima secara langsung.
Dialogue: 0,0:06:40.76,0:06:43.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya... Ayo!
Dialogue: 0,0:06:54.98,0:06:56.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu.
Dialogue: 0,0:06:56.35,0:06:58.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena sedang melindungimu,
Dialogue: 0,0:06:59.48,0:07:02.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berarti dia sedang rentan.
Dialogue: 0,0:07:02.99,0:07:04.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:07:04.03,0:07:07.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baru mampu memanipulasi\Nsatu sebab akibat saja.
Dialogue: 0,0:07:09.47,0:07:12.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tak akan kubiarkan mendekati Amelia!
Dialogue: 0,0:07:12.24,0:07:15.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua serangan lawan sudah dikunci.
Dialogue: 0,0:07:15.16,0:07:19.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tugasku hanya membuat Lucas Forst\Ntak lagi mampu bertarung!
Dialogue: 0,0:07:22.13,0:07:24.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir layaknya penyihir, ya?
Dialogue: 0,0:07:24.64,0:07:27.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, mirip milik Amelia.
Dialogue: 0,0:07:27.61,0:07:30.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu terlalu sulit untukku?
Dialogue: 0,0:07:30.14,0:07:31.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:07:31.76,0:07:35.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ariane adalah penyihir\Nyang cocok memakai inside code.
Dialogue: 0,0:07:35.04,0:07:37.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa dipungkiri kalau itu bakat.
Dialogue: 0,0:07:38.52,0:07:42.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, bukankah "layaknya penyihir"\Nitu ungkapan aneh?
Dialogue: 0,0:07:43.53,0:07:46.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau itu inside code atau outside code,
Dialogue: 0,0:07:46.82,0:07:48.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sihir tetaplah sihir.
Dialogue: 0,0:07:48.45,0:07:50.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak ada perbedaan di antara keduanya.
Dialogue: 0,0:07:53.06,0:07:56.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, aku suka dengan sihirmu.
Dialogue: 0,0:07:56.04,0:07:57.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:07:57.00,0:07:59.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teknik inside code-mu sangat luar biasa.
Dialogue: 0,0:07:59.92,0:08:03.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cara penggunaannya mencerminkan\Nkepribadianmu yang jujur dan lurus.
Dialogue: 0,0:08:03.05,0:08:05.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be-Begitu, ya?
Dialogue: 0,0:08:05.17,0:08:09.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau menguasai inside code dengan sempurna,\Npasti akan jadi kekuatan yang dahsyat.
Dialogue: 0,0:08:09.77,0:08:13.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu hanya perlu terus maju dengan lurus.
Dialogue: 0,0:08:19.77,0:08:24.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia selalu tenang dan berwajah dingin,
Dialogue: 0,0:08:24.90,0:08:27.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi hatinya sangat membara.
Dialogue: 0,0:08:27.53,0:08:30.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski kadang tingkahnya nyeleneh.
Dialogue: 0,0:08:31.93,0:08:36.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku suka wajahnya\Nyang tersenyum dengan tulus.
Dialogue: 0,0:08:36.58,0:08:39.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, begitu rupanya.
Dialogue: 0,0:08:44.27,0:08:48.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku selalu menyangkalnya\Ndemi fokus pada turnamen.
Dialogue: 0,0:08:49.05,0:08:52.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kalau mengakuinya,\Naku merasa diriku akan goyah.
Dialogue: 0,0:08:53.72,0:08:55.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seakan itu akan membuatku lemah.
Dialogue: 0,0:08:56.43,0:08:57.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:08:57.73,0:09:01.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu mengakuinya,\Nkekuatanku justru meluap-luap!
Dialogue: 0,0:09:09.45,0:09:10.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah!
Dialogue: 0,0:09:14.49,0:09:16.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Forst akhirnya...
Dialogue: 0,0:09:16.59,0:09:17.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tumbang!
Dialogue: 0,0:09:19.16,0:09:22.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peserta Ariane jatuh berlutut!
Dialogue: 0,0:09:33.51,0:09:37.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hampir saja, tapi...\Nsepertinya kalian kehabisan waktu.
Dialogue: 0,0:09:37.26,0:09:39.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa sangka!
Dialogue: 0,0:09:39.23,0:09:44.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peserta Forst kembali bangkit\Nseakan tak menerima serangan!
Dialogue: 0,0:09:44.36,0:09:45.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang benar saja...
Dialogue: 0,0:09:46.19,0:09:48.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa dia tak bisa dikalahkan?
Dialogue: 0,0:09:48.40,0:09:50.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, lihat baik-baik.
Dialogue: 0,0:09:50.15,0:09:51.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:09:51.90,0:09:54.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, betulan kena!
Dialogue: 0,0:09:54.03,0:09:55.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma sok tangguh, ya?
Dialogue: 0,0:09:55.32,0:09:56.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:09:58.24,0:09:59.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih sanggup berdiri?
Dialogue: 0,0:09:59.54,0:10:01.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja!
Dialogue: 0,0:10:01.00,0:10:02.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami masih sanggup bertarung!
Dialogue: 0,0:10:02.54,0:10:04.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh juga.
Dialogue: 0,0:10:04.17,0:10:07.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis yang sedang kasmaran itu sangat kuat!
Dialogue: 0,0:10:07.17,0:10:08.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu.
Dialogue: 0,0:10:16.97,0:10:19.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemenangnya, Tim Olgren!
Dialogue: 0,0:10:19.35,0:10:21.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka memenangkan Magicus War!
Dialogue: 0,0:10:22.31,0:10:23.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Al...
Dialogue: 0,0:10:23.14,0:10:24.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Evi...
Dialogue: 0,0:10:26.31,0:10:27.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hore!
Dialogue: 0,0:10:27.61,0:10:29.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka menang!
Dialogue: 0,0:10:29.02,0:10:31.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka hebat banget, ya!
Dialogue: 0,0:10:31.07,0:10:32.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ray-ku memang hebat!
Dialogue: 0,0:10:32.57,0:10:34.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Abang!
Dialogue: 0,0:10:34.07,0:10:36.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, Maria juga ikutan!
Dialogue: 0,0:10:36.07,0:10:38.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Abang!
Dialogue: 0,0:10:38.16,0:10:40.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia kan bukan abangku.
Dialogue: 0,0:10:40.24,0:10:42.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Abang!
Dialogue: 0,0:10:44.46,0:10:47.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ray... kamu keren.
Dialogue: 0,0:10:49.24,0:10:51.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu melihatnya, Carla?
Dialogue: 0,0:10:51.09,0:10:52.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, aku melihatnya.
Dialogue: 0,0:10:52.72,0:10:56.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ray kamu keren banget!\NAku padamu!
Dialogue: 0,0:10:56.47,0:10:58.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Laga yang bagus, ya.
Dialogue: 0,0:10:58.43,0:11:02.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah lama aku tak menyaksikan\Npertarungan seru.
Dialogue: 0,0:11:02.98,0:11:05.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ray, kamu nomor satu se-Arnold!
Dialogue: 0,0:11:05.56,0:11:07.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu berhasil, Ray.
Dialogue: 0,0:11:07.73,0:11:10.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menang...\NKita menang?
Dialogue: 0,0:11:10.32,0:11:12.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!\NRay yang memenangkannya!
Dialogue: 0,0:11:12.74,0:11:14.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ray...
Dialogue: 0,0:11:14.24,0:11:14.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ariane.
Dialogue: 0,0:11:14.99,0:11:15.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:11:16.29,0:11:19.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Barusan kamu merasa\Ningin menemui Ray, ya?
Dialogue: 0,0:11:19.12,0:11:20.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Eh?
Dialogue: 0,0:11:20.95,0:11:24.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak perlu disembunyikan begitu.\NDari dulu aku sudah tahu.
Dialogue: 0,0:11:24.46,0:11:26.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari dulu?
Dialogue: 0,0:11:26.12,0:11:30.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan sebelum aku menyadari perasaan ini,\Nkamu sudah tahu?
Dialogue: 0,0:11:30.71,0:11:32.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mudah ditebak.
Dialogue: 0,0:11:33.63,0:11:36.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti kamu juga sama!
Dialogue: 0,0:11:38.33,0:11:39.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitulah.
Dialogue: 0,0:11:39.60,0:11:42.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga mencintai Ray.
Dialogue: 0,0:11:43.67,0:11:44.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:11:44.91,0:11:47.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, mulai sekarang\Nkita ini rival cinta, ya.
Dialogue: 0,0:11:47.88,0:11:49.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rival cinta?
Dialogue: 0,0:11:49.48,0:11:50.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:11:50.40,0:11:53.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya, kita mencintai cowok yang sama.
Dialogue: 0,0:11:53.65,0:11:56.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Amelia, kamu...
Dialogue: 0,0:11:56.15,0:11:59.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu juga disentuh Ray, kan?
Dialogue: 0,0:11:59.24,0:12:00.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudku hatimu.
Dialogue: 0,0:12:01.77,0:12:03.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga, ya.
Dialogue: 0,0:12:03.16,0:12:07.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai sekarang, aku akan bersaing\Ndenganmu sebagai rival cinta.
Dialogue: 0,0:12:07.96,0:12:08.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:12:10.75,0:12:11.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:12:14.86,0:12:17.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Wah, kok aneh?\N- Kinokoon.
Dialogue: 0,0:12:17.42,0:12:19.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan Senior Rebecca juga, ya.
Dialogue: 0,0:12:19.64,0:12:21.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga, ya.
Dialogue: 0,0:12:23.89,0:12:25.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penampilanmu itu...
Dialogue: 0,0:12:25.68,0:12:26.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu.
Dialogue: 0,0:12:27.44,0:12:29.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh tim yang bagus.
Dialogue: 0,0:12:29.69,0:12:32.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bertarung dengan serius hingga akhir,
Dialogue: 0,0:12:32.73,0:12:35.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kalian sedikit lebih unggul dariku.
Dialogue: 0,0:12:35.69,0:12:36.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami tersanjung.
Dialogue: 0,0:12:36.99,0:12:40.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian juga sudah membuatku kewalahan,\Nsungguh tim yang luar biasa.
Dialogue: 0,0:12:40.57,0:12:41.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:12:41.99,0:12:46.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku masih ingin berduel\Nsatu lawan satu denganmu.
Dialogue: 0,0:12:47.36,0:12:50.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menantikanmu\Ndi Magicus Chavalier tahun depan.
Dialogue: 0,0:12:50.87,0:12:53.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu, aku pun menantikannya.
Dialogue: 0,0:13:00.13,0:13:01.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perlu kubantu?
Dialogue: 0,0:13:02.05,0:13:03.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu.
Dialogue: 0,0:13:05.66,0:13:07.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, kita kalah.
Dialogue: 0,0:13:07.81,0:13:10.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita belum bisa menandingi Ray.
Dialogue: 0,0:13:10.48,0:13:13.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, kalian sudah berjuang dengan baik.
Dialogue: 0,0:13:14.42,0:13:18.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa bertarung dalam tim juga\Njadi pengalaman bagus.
Dialogue: 0,0:13:18.84,0:13:21.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata berkawan itu lumayan juga.
Dialogue: 0,0:13:24.91,0:13:26.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Amelia! Ariane!
Dialogue: 0,0:13:26.74,0:13:27.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ray.
Dialogue: 0,0:13:27.75,0:13:28.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh!
Dialogue: 0,0:13:29.46,0:13:31.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu telanjang?
Dialogue: 0,0:13:31.25,0:13:32.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada alasannya!
Dialogue: 0,0:13:32.58,0:13:34.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, kita menang, ya!
Dialogue: 0,0:13:34.00,0:13:36.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemenangan ini berkat kalian berdua!
Dialogue: 0,0:13:36.00,0:13:38.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, ini berkat usaha kita semua...
Dialogue: 0,0:13:38.26,0:13:39.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:13:39.30,0:13:42.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini kemenangan yang kita raih bersama.
Dialogue: 0,0:13:42.05,0:13:43.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, benar sekali!
Dialogue: 0,0:13:43.76,0:13:46.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daripada bahas itu, cepat pakai bajumu!
Dialogue: 0,0:13:46.35,0:13:47.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Intip.
Dialogue: 0,0:13:49.27,0:13:50.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm...
Dialogue: 0,0:13:50.73,0:13:53.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Butterfly Effect, ya.
Dialogue: 0,0:13:53.73,0:13:55.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Amelia Rose, ya?
Dialogue: 0,0:13:57.40,0:13:59.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi makin menarik, ya.
Dialogue: 0,0:14:02.86,0:14:04.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saksikanlah, pemirsa!
Dialogue: 0,0:14:04.07,0:14:09.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Piala telah dianugerahkan pada Tim Olgren\Nyang memenangkan Magicus War!
Dialogue: 0,0:14:10.41,0:14:14.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari beri tepuk tangan meriah\Npada seluruh peserta yang telah bertarung
Dialogue: 0,0:14:14.42,0:14:15.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan sengit!
Dialogue: 0,0:14:15.92,0:14:18.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat, Tim Olgren.
Dialogue: 0,0:14:19.41,0:14:21.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kyaro-Kyaro terharu banget!
Dialogue: 0,0:14:22.84,0:14:24.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:14:24.51,0:14:27.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Aku ingin berdiri di samping Ray.\N- Kalian telah berjuang keras, ya.
Dialogue: 0,0:14:27.68,0:14:31.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tim Forst pun telah bertarung\Ndengan luar biasa.
Dialogue: 0,0:14:32.18,0:14:33.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah!
Dialogue: 0,0:14:34.19,0:14:36.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Al, kerja bagus!
Dialogue: 0,0:14:36.52,0:14:38.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu keren!
Dialogue: 0,0:14:38.27,0:14:39.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Evi.
Dialogue: 0,0:14:39.19,0:14:41.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat, ya, Nona Amelia!
Dialogue: 0,0:14:41.86,0:14:42.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyentuh banget!
Dialogue: 0,0:14:42.86,0:14:45.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertandingan yang bagus sekali!
Dialogue: 0,0:14:52.60,0:14:53.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Claris.
Dialogue: 0,0:14:55.55,0:14:59.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, aku pulang duluan, ya.
Dialogue: 0,0:14:59.04,0:15:00.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm? Eh?
Dialogue: 0,0:15:00.21,0:15:04.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk sementara,\Naku juga akan cuti bersekolah.
Dialogue: 0,0:15:05.47,0:15:07.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Tunggu...
Dialogue: 0,0:15:07.93,0:15:09.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elisa?
Dialogue: 0,0:15:09.47,0:15:12.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Si Pink Bodoh ke mana?\N- Seru sekali, ya, Lise!
Dialogue: 0,0:15:12.43,0:15:13.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Entah.\N- Benar.
Dialogue: 0,0:15:13.39,0:15:14.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Dasar.\N- Eh?
Dialogue: 0,0:15:14.35,0:15:16.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lise selalu bersikap dingin, ya.
Dialogue: 0,0:15:16.48,0:15:17.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Harusnya kamu lebih bergembira.\N- Jangan-jangan...
Dialogue: 0,0:15:17.90,0:15:19.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Aku gembira, kok.\N- Lagi?
Dialogue: 0,0:15:19.44,0:15:23.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, kali ini juga meriah, ya!
Dialogue: 0,0:15:23.36,0:15:27.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, buat menutup turnamen,\Npaling bagus ya nyanyi!
Dialogue: 0,0:15:27.41,0:15:28.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum waktunya.
Dialogue: 0,0:15:28.62,0:15:30.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, Abby?
Dialogue: 0,0:15:30.45,0:15:32.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana boleh nyanyi sekarang.
Dialogue: 0,0:15:32.87,0:15:35.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tidak benar!\NPenonton sudah menunggu!
Dialogue: 0,0:15:35.21,0:15:37.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya, jangan sekarang.
Dialogue: 0,0:15:39.50,0:15:41.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kenapa?\N- Mari, Nona Elisa.
Dialogue: 0,0:15:43.07,0:15:43.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:15:53.81,0:15:54.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melirik.
Dialogue: 0,0:15:56.21,0:16:00.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayang sekali Master dan Mbak Abby\Ntidak bisa ikut.
Dialogue: 0,0:16:00.27,0:16:01.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, ya.
Dialogue: 0,0:16:01.52,0:16:05.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka malah dipanggil\Nke rapat penanganan Eugenics,
Dialogue: 0,0:16:06.40,0:16:09.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar pergerakan mereka makin aktif, ya.
Dialogue: 0,0:16:10.62,0:16:11.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Carol?
Dialogue: 0,0:16:12.28,0:16:12.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Carol?
Dialogue: 0,0:16:12.91,0:16:13.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:16:13.66,0:16:14.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:16:14.91,0:16:17.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu terlihat sedang melamun...
Dialogue: 0,0:16:17.12,0:16:18.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak!
Dialogue: 0,0:16:18.79,0:16:21.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kyaro-Kyaro seperti biasa, kok!
Dialogue: 0,0:16:24.05,0:16:25.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu?
Dialogue: 0,0:16:26.26,0:16:27.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Festival Nyanyian Suci?
Dialogue: 0,0:16:28.05,0:16:31.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, liburan musim dingin itu\NFestival Nyanyian Suci, kan?
Dialogue: 0,0:16:31.55,0:16:32.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:16:32.97,0:16:35.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar itu berasal\Ndari Katedral Kerajaan Arnold
Dialogue: 0,0:16:35.35,0:16:38.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}saat orang-orang mulai\Nmenyanyikan lagu rohani...
Dialogue: 0,0:16:38.43,0:16:40.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti, kamu tahu ini?
Dialogue: 0,0:16:40.56,0:16:42.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhir-akhir ini, Festival Nyanyian Suci
Dialogue: 0,0:16:42.56,0:16:46.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sedang tren bagi para kopel buat\Nmenghabiskan waktu daripada dengan keluarga.
Dialogue: 0,0:16:46.07,0:16:47.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah.
Dialogue: 0,0:16:47.24,0:16:49.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus, jadi begini...
Dialogue: 0,0:16:49.07,0:16:51.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai anggota Ketiga Keluarga Besar,
Dialogue: 0,0:16:51.07,0:16:54.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku diundang ke pesta\Nyang diselenggarakan Asosiasi Sihir.
Dialogue: 0,0:16:54.70,0:16:55.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu mau...
Dialogue: 0,0:16:55.49,0:16:56.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kebetulan sekali, ya.
Dialogue: 0,0:16:56.91,0:16:57.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh?
Dialogue: 0,0:16:57.83,0:16:59.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga diundang,
Dialogue: 0,0:16:59.96,0:17:02.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebagai salah satu\Ndari Ketujuh Penyihir Agung.
Dialogue: 0,0:17:02.42,0:17:03.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, begitu, ya.
Dialogue: 0,0:17:03.96,0:17:06.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berencana hadir\Nkarena ini kesempatan bagus.
Dialogue: 0,0:17:06.42,0:17:09.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja Master, Abby,\Ndan Carol juga ikut.
Dialogue: 0,0:17:09.80,0:17:11.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu.
Dialogue: 0,0:17:13.64,0:17:15.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu, aku juga diundang!
Dialogue: 0,0:17:15.97,0:17:17.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senior Rebecca?
Dialogue: 0,0:17:19.48,0:17:21.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami juga diundang!
Dialogue: 0,0:17:21.65,0:17:24.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai peringkat dua Magicus War!
Dialogue: 0,0:17:24.77,0:17:28.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja, aku juga hadir!
Dialogue: 0,0:17:28.65,0:17:29.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ariane?
Dialogue: 0,0:17:30.74,0:17:32.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu ada di sini juga?
Dialogue: 0,0:17:32.70,0:17:34.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja!
Dialogue: 0,0:17:34.24,0:17:35.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Festival Nyanyian Suci kali ini\N- Jadi tidak sabar!
Dialogue: 0,0:17:35.93,0:17:37.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- sepertinya akan sangat meriah.\N- Iya, sama!
Dialogue: 0,0:17:37.37,0:17:38.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, ya.
Dialogue: 0,0:17:38.20,0:17:39.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi tidak sabar.
Dialogue: 0,0:17:40.50,0:17:43.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa Festival Nyanyian Suci\Ntahun ini digelar di Alferia?
Dialogue: 0,0:17:43.63,0:17:46.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm, kira-kira kenapa, ya?
Dialogue: 0,0:17:46.50,0:17:50.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerajaan yang penuh misteri\Nyang cuma dihuni kaum Elf.
Dialogue: 0,0:17:50.72,0:17:55.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak bergantinya raja setengah tahun lalu,\Nada banyak rumor yang beredar.
Dialogue: 0,0:17:55.47,0:17:58.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa sangka kita betulan\Nbisa masuk ke sana, ya.
Dialogue: 0,0:17:59.77,0:18:01.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetap saja aneh.
Dialogue: 0,0:18:02.02,0:18:03.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal sedang wisata singkat,
Dialogue: 0,0:18:03.85,0:18:06.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}rasanya tak wajar kalau Carol jadi pendiam.
Dialogue: 0,0:18:06.38,0:18:08.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa, Ray?
Dialogue: 0,0:18:08.03,0:18:09.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, bukan apa-apa.
Dialogue: 0,0:18:10.19,0:18:11.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu sebentar!
Dialogue: 0,0:18:11.78,0:18:15.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ray masih melirikku?
Dialogue: 0,0:18:15.95,0:18:17.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Panas!\NTatapannya membara banget!
Dialogue: 0,0:18:17.87,0:18:19.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagian, kita berduaan, kan?\NJadi gugup!
Dialogue: 0,0:18:19.70,0:18:22.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya Ray sudah hampir dewasa,\Nmakin tahun juga makin ganteng.
Dialogue: 0,0:18:22.91,0:18:25.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau saja tak setengah bercanda,\Naku tak sanggup pegang-pegang dia!
Dialogue: 0,0:18:25.92,0:18:27.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi tidak tahan!
Dialogue: 0,0:18:27.54,0:18:29.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku bisa menghibur Ray?
Dialogue: 0,0:18:29.96,0:18:32.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya, harusnya Ray menantikan\Nwisata sama teman-teman lain!
Dialogue: 0,0:18:32.67,0:18:34.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Aku tahu sebenernya dia tidak membenciku,\N- Carol?
Dialogue: 0,0:18:34.38,0:18:35.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- tapi dia selalu cuek padaku...\N- Carol?
Dialogue: 0,0:18:35.55,0:18:36.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya?
Dialogue: 0,0:18:37.97,0:18:40.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak enak badan,\Nminta saja keretanya berhenti.
Dialogue: 0,0:18:43.04,0:18:44.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sehat, kok!
Dialogue: 0,0:18:44.19,0:18:46.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sehat dan bugar!
Dialogue: 0,0:18:46.36,0:18:47.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya?
Dialogue: 0,0:18:48.77,0:18:50.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Po-Pokoknya...
Dialogue: 0,0:18:50.59,0:18:54.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di wisata ini, aku harus memimpin\Nsebagai Mbak yang bisa diandalkan!
Dialogue: 0,0:19:01.50,0:19:02.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah...
Dialogue: 0,0:19:02.45,0:19:05.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Butuh setengah hari lagi\Nbuat sampai ke Alferia.
Dialogue: 0,0:19:05.29,0:19:08.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini kita istirahat santai\Ndulu di sini, ya.
Dialogue: 0,0:19:09.46,0:19:11.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, kamar yang bagus.
Dialogue: 0,0:19:13.92,0:19:15.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemandangannya juga indah.
Dialogue: 0,0:19:16.72,0:19:17.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:19:18.55,0:19:20.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa-bisanya kita sekamar.
Dialogue: 0,0:19:22.89,0:19:27.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa-bisanya aku salah pesan\Ndan malah berakhir begini!
Dialogue: 0,0:19:28.23,0:19:29.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih atas hidangannya.
Dialogue: 0,0:19:31.65,0:19:34.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ray sudah besar, ya.
Dialogue: 0,0:19:34.24,0:19:37.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal dulu dia sangat imut.
Dialogue: 0,0:19:37.74,0:19:41.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang jadi seganteng ini.
Dialogue: 0,0:19:41.68,0:19:43.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu kembali ke kamar,\Nbagaimana kalau mandi?
Dialogue: 0,0:19:43.75,0:19:44.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:19:45.52,0:19:46.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma... Ma...
Dialogue: 0,0:19:46.50,0:19:49.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Carol?\NApa yang kamu pikirkan?
Dialogue: 0,0:19:49.54,0:19:52.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu saja yang duluan.
Dialogue: 0,0:19:52.75,0:19:54.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, Carol saja duluan.
Dialogue: 0,0:19:55.42,0:19:57.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mandiku lama!
Dialogue: 0,0:19:57.13,0:19:58.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu...
Dialogue: 0,0:19:58.43,0:20:00.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya bereskan piring yang kosong, ya.
Dialogue: 0,0:20:00.39,0:20:01.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, boleh.
Dialogue: 0,0:20:03.81,0:20:04.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Carol?
Dialogue: 0,0:20:04.89,0:20:06.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya permisi.
Dialogue: 0,0:20:06.44,0:20:07.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:20:08.63,0:20:11.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku malu kalau duluan.
Dialogue: 0,0:20:11.52,0:20:13.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah aku pakai, kamu nanti...
Dialogue: 0,0:20:13.73,0:20:15.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau tambah air minumnya?
Dialogue: 0,0:20:15.32,0:20:16.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu!
Dialogue: 0,0:20:19.56,0:20:22.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti giliran kamu yang masuk...
Dialogue: 0,0:20:24.90,0:20:27.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf karena tidak peka.
Dialogue: 0,0:20:27.01,0:20:28.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang akan mandi duluan.
Dialogue: 0,0:20:29.54,0:20:30.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:20:31.33,0:20:32.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:20:52.90,0:20:55.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar sudah tidur, ya.
Dialogue: 0,0:20:56.18,0:20:59.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ray, ini soal Elisa...
Dialogue: 0,0:20:59.28,0:21:02.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak hari itu,\Ndia cuti karena urusan keluarga, ya?
Dialogue: 0,0:21:02.70,0:21:06.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belakangan ini,\Ndia kelihatan terbebani sesuatu,
Dialogue: 0,0:21:06.62,0:21:08.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}makanya aku cemas...
Dialogue: 0,0:21:08.21,0:21:10.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga, ya.
Dialogue: 0,0:21:10.42,0:21:13.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang menjemput Elisa itu Elf, kan?
Dialogue: 0,0:21:13.21,0:21:13.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:21:13.96,0:21:16.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa tidak salah lagi...
Dialogue: 0,0:21:26.10,0:21:27.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yamoo.
Dialogue: 0,0:21:31.23,0:21:34.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Picu kebangkitan Ray White."
Dialogue: 0,0:21:34.48,0:21:36.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu yang atasan suruh.
Dialogue: 0,0:21:37.40,0:21:39.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, target utamaku itu dia...
Dialogue: 0,0:21:39.78,0:21:40.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:21:42.64,0:21:44.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, cuma masker.
Dialogue: 0,0:21:46.62,0:21:47.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cih!
Dialogue: 0,0:21:48.31,0:21:52.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar, benar-benar membuatku malas!
Dialogue: 0,0:21:52.77,0:21:55.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, prioritasku sekarang\Nadalah tanah suci, ya.
Dialogue: 0,0:21:56.20,0:21:57.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana perkembangan situasinya?
Dialogue: 0,0:21:57.96,0:22:00.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya berjalan lancar tanpa kendala.
Dialogue: 0,0:22:00.39,0:22:01.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu.
Dialogue: 0,0:22:09.67,0:22:11.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, indah banget!
Dialogue: 0,0:22:11.69,0:22:13.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi ini Alferia, ya.
Dialogue: 0,0:22:13.65,0:22:15.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih sulit dipercaya!
Dialogue: 0,0:22:15.69,0:22:19.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak yang berubah\Nsejak pergantian raja, ya.
Dialogue: 0,0:22:21.15,0:22:22.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makasih, Ray.
Dialogue: 0,0:22:23.28,0:22:25.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang di negeri kami.
Dialogue: 0,0:22:26.03,0:22:29.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami telah menantikan kedatangan Anda,\NTuan Ray White.
Dialogue: 0,0:22:30.15,0:22:33.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya bertugas memandu Anda\Nmenuju ke mansion.
Dialogue: 0,0:22:33.54,0:22:35.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nama saya Mia.
Dialogue: 0,0:22:35.92,0:22:39.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya datang kemari\Natas perintah majikan saya.
Dialogue: 0,0:22:41.75,0:22:44.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Majikan saya ada di dalam.
Dialogue: 0,0:22:46.87,0:22:48.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya telah mengantar mereka kemari.
Dialogue: 0,0:22:57.06,0:22:57.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elisa?
Dialogue: 0,0:22:57.73,0:22:58.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah!
Dialogue: 0,0:23:00.11,0:23:01.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ray.
Dialogue: 0,0:23:48.82,0:23:50.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktunya dengar bagian pratinjau.
Dialogue: 0,0:23:50.41,0:23:51.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan Elisa.
Dialogue: 0,0:23:51.20,0:23:52.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Juga Mia.
Dialogue: 0,0:23:52.08,0:23:53.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama lakon cewekmu, Kyaro-Kyaro!
Dialogue: 0,0:23:53.87,0:23:55.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, mau apa sih kalian?
Dialogue: 0,0:23:55.58,0:23:56.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum bisa komen.
Dialogue: 0,0:23:56.33,0:23:57.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kecepetan!
Dialogue: 0,0:23:57.08,0:23:58.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elisa, very good!
Dialogue: 0,0:23:58.75,0:24:00.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Penampilanmu beautiful!\N- Jedug!
Dialogue: 0,0:24:00.63,0:24:02.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Degupanmu kenceng banget, hey, yeah!
Dialogue: 0,0:24:02.67,0:24:03.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya.
Dialogue: 0,0:24:03.34,0:24:05.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyihir Pedang Es akan Menguasai Dunia...
Dialogue: 0,0:24:05.38,0:24:06.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dua!
Dialogue: 0,0:24:07.26,0:24:09.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bilang love you, di episode lima:
Dialogue: 0,0:24:09.18,0:24:11.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Pemuda yang Merupakan\NPenyihir Terkuat di Dunia
Dialogue: 0,0:24:11.68,0:24:13.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kencan di Negeri Asing"?
