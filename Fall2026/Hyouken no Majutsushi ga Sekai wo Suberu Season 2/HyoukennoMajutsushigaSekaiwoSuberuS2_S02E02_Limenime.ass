Dialogue: 0,0:03:15.47,0:03:19.68,sign,,0000,0000,0000,,PENYIHIR PEDANG ES\NAKAN MENGUASAI DUNIA SEASON 2
Dialogue: 0,0:03:20.18,0:03:23.98,sign,,0000,0000,0000,,EPISODE 2: PEMUDA YANG MERUPAKAN PENYIHIR\NTERKUAT DI DUNIA MEMAKAI TOPENGNYA... LAGI
Dialogue: 0,0:23:48.78,0:23:50.45,sign,,0000,0000,0000,,PRATINJAU
Dialogue: 0,0:00:33.76,0:00:35.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini?
Dialogue: 0,0:00:38.56,0:00:40.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan pikir sudah berakhir!
Dialogue: 0,0:00:41.69,0:00:43.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Maaf, Bundo!\N- Lantai dua!
Dialogue: 0,0:00:44.02,0:00:45.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lantai tiga!
Dialogue: 0,0:00:46.44,0:00:47.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu...
Dialogue: 0,0:00:47.49,0:00:48.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lantai empat.
Dialogue: 0,0:00:49.78,0:00:52.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kejayaan untuk kalian, para Petarung!
Dialogue: 0,0:00:52.78,0:00:55.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ada depan, berarti ada belakang!
Dialogue: 0,0:00:55.62,0:00:58.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah mengalahkan\NEmpat Jenderal Mercross
Dialogue: 0,0:00:58.79,0:01:01.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akhirnya kalian sampai kemari!
Dialogue: 0,0:01:07.88,0:01:09.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata tidak ada apa-apanya.
Dialogue: 0,0:01:09.92,0:01:11.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lekas biarkan kami lewat!
Dialogue: 0,0:01:11.47,0:01:13.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia di atas sana, kan?
Dialogue: 0,0:01:14.51,0:01:17.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajar kalian bisa sampai sejauh ini.
Dialogue: 0,0:01:17.35,0:01:18.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun,
Dialogue: 0,0:01:18.43,0:01:20.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau ingin menemuinya,
Dialogue: 0,0:01:21.39,0:01:24.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}temuilah setelah\Nmengalahkan aku, Shine Girard!
Dialogue: 0,0:01:24.98,0:01:27.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, siapa yang jadi lawanku...
Dialogue: 0,0:01:33.41,0:01:35.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akulah lawanmu!
Dialogue: 0,0:01:36.16,0:01:37.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Otot yang mantap...
Dialogue: 0,0:01:42.08,0:01:43.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eng...
Dialogue: 0,0:01:44.58,0:01:46.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini tempatnya, kan?
Dialogue: 0,0:01:51.84,0:01:53.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Disuruh masuk, ya?
Dialogue: 0,0:01:55.26,0:01:56.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi.
Dialogue: 0,0:02:14.95,0:02:18.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hai, selamat datang, Amelia Rose.
Dialogue: 0,0:02:18.03,0:02:18.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu...
Dialogue: 0,0:02:18.99,0:02:21.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salam kenal, anu...
Dialogue: 0,0:02:22.00,0:02:23.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Liselotte Eden.
Dialogue: 0,0:02:23.87,0:02:27.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin kamu lebih mengenalku\Nsebagai Penyihir Fabrikasi.
Dialogue: 0,0:02:29.05,0:02:30.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fabrikasi?
Dialogue: 0,0:02:31.55,0:02:32.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:03:00.41,0:03:02.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat pagi, Tuan Julius.
Dialogue: 0,0:03:02.66,0:03:04.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, selamat pagi, Emma.
Dialogue: 0,0:03:04.91,0:03:05.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan.
Dialogue: 0,0:03:08.96,0:03:12.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa selalu dikunyah, ya?
Dialogue: 0,0:03:25.85,0:03:27.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senang berkenalan dengan Anda sekalian.
Dialogue: 0,0:03:28.27,0:03:30.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nama saya Ariane Olgren.
Dialogue: 0,0:03:30.61,0:03:32.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon bantuannya mulai sekarang.
Dialogue: 0,0:03:32.69,0:03:34.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namaku Sasha White.
Dialogue: 0,0:03:34.28,0:03:35.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namaku Luther.
Dialogue: 0,0:03:35.53,0:03:36.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka orang tuaku.
Dialogue: 0,0:03:36.95,0:03:39.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka ayah dan ibuku, lo.
Dialogue: 0,0:03:40.74,0:03:43.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski rumah kami sempit,\Nsemoga kamu betah.
Dialogue: 0,0:03:43.04,0:03:47.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, justru saya yang mendadak\Nberkunjung dan merepotkan.
Dialogue: 0,0:03:47.52,0:03:48.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ariane.
Dialogue: 0,0:03:48.54,0:03:49.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya?
Dialogue: 0,0:03:49.71,0:03:52.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelatihannya langsung dimulai besok pagi.
Dialogue: 0,0:03:52.38,0:03:54.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama di sini, gunakan saja\Ntempat tidurnya Stella.
Dialogue: 0,0:03:55.51,0:03:57.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, Dik Stella bagaimana?
Dialogue: 0,0:03:57.18,0:04:00.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bakal tidur bareng Abang,\Njadi enggak usah sungkan.
Dialogue: 0,0:04:00.22,0:04:00.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ha?
Dialogue: 0,0:04:00.89,0:04:02.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, ini wajar.
Dialogue: 0,0:04:02.76,0:04:05.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hi? Hu? He? Ho?
Dialogue: 0,0:04:05.39,0:04:07.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, Stella ini.
Dialogue: 0,0:04:07.31,0:04:09.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar lengket sama abangnya.
Dialogue: 0,0:04:09.15,0:04:11.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti malam, kita mandi bareng, ya.
Dialogue: 0,0:04:11.23,0:04:12.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:04:12.32,0:04:13.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akur sekali, ya.
Dialogue: 0,0:04:14.61,0:04:16.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duh! Tunggu dulu!
Dialogue: 0,0:04:16.82,0:04:17.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm?
Dialogue: 0,0:04:17.61,0:04:18.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa, Ariane?
Dialogue: 0,0:04:19.77,0:04:20.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Se...
Dialogue: 0,0:04:20.27,0:04:23.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya berbaris di sana!
Dialogue: 0,0:04:23.24,0:04:25.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sana... na... na...
Dialogue: 0,0:04:27.08,0:04:28.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga.
Dialogue: 0,0:04:28.33,0:04:29.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu...
Dialogue: 0,0:04:30.08,0:04:34.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memang merasa kalau\Nakan jadi masalah, kan?
Dialogue: 0,0:04:34.25,0:04:35.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya...
Dialogue: 0,0:04:35.51,0:04:37.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak boleh!
Dialogue: 0,0:04:39.26,0:04:41.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meskipun mereka kakak-beradik yang akur,
Dialogue: 0,0:04:41.76,0:04:44.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bagaimana kalau kelak\NDik Stella tidak bisa menikah?
Dialogue: 0,0:04:46.02,0:04:47.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tinggal nikah sama Abang!
Dialogue: 0,0:04:47.85,0:04:50.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan itu masalahnya!
Dialogue: 0,0:04:51.85,0:04:52.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Abang.
Dialogue: 0,0:04:52.81,0:04:53.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, iya?
Dialogue: 0,0:04:53.69,0:04:57.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski kita terpisah,\Nhubungan kita enggak bakal berubah!
Dialogue: 0,0:04:57.82,0:05:00.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, tentu saja!
Dialogue: 0,0:05:00.45,0:05:02.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian berdua...
Dialogue: 0,0:05:02.03,0:05:03.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian sudah besar, ya.
Dialogue: 0,0:05:04.03,0:05:04.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Abangku!
Dialogue: 0,0:05:04.87,0:05:05.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Stella!
Dialogue: 0,0:05:05.62,0:05:06.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Abangku!
Dialogue: 0,0:05:06.45,0:05:06.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Stella!
Dialogue: 0,0:05:06.95,0:05:07.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Abangku!
Dialogue: 0,0:05:07.95,0:05:08.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Stella!
Dialogue: 0,0:05:08.75,0:05:10.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana bilangnya...
Dialogue: 0,0:05:11.12,0:05:13.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak-beradik yang mirip, ya.
Dialogue: 0,0:05:13.25,0:05:14.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:05:16.09,0:05:16.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf...
Dialogue: 0,0:05:17.46,0:05:19.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku diberitahu Ray...
Dialogue: 0,0:05:19.88,0:05:20.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:05:20.93,0:05:22.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia menitipkanmu padaku.
Dialogue: 0,0:05:23.47,0:05:24.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena aku berutang budi padanya.
Dialogue: 0,0:05:24.97,0:05:25.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Utang budi?
Dialogue: 0,0:05:25.97,0:05:26.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meskipun begitu,
Dialogue: 0,0:05:26.97,0:05:31.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku juga tertarik padamu, Amelia Rose.
Dialogue: 0,0:05:31.23,0:05:32.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:05:32.31,0:05:33.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Butterfly Effect...
Dialogue: 0,0:05:35.31,0:05:36.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Origin milikmu.
Dialogue: 0,0:05:37.48,0:05:40.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir yang mampu\Nmempengaruhi sebab dan akibat.
Dialogue: 0,0:05:41.32,0:05:42.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sampai gemetar.
Dialogue: 0,0:05:43.36,0:05:45.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gemetar, ya?
Dialogue: 0,0:05:45.07,0:05:47.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan tetapi, sihir yang terlalu kuat
Dialogue: 0,0:05:47.66,0:05:50.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}terkadang bisa membunuh\Npenggunanya sendiri.
Dialogue: 0,0:05:50.75,0:05:52.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sebabnya
Dialogue: 0,0:05:56.09,0:06:00.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku merasa harus\Nmembimbingmu dengan benar.
Dialogue: 0,0:06:00.09,0:06:00.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya...
Dialogue: 0,0:06:04.09,0:06:05.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kena!
Dialogue: 0,0:06:09.06,0:06:11.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus.\NPergilah...
Dialogue: 0,0:06:12.10,0:06:14.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia ada di atas sana...
Dialogue: 0,0:06:17.02,0:06:18.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus.
Dialogue: 0,0:06:19.44,0:06:20.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sip!
Dialogue: 0,0:06:20.53,0:06:21.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lanjut!
Dialogue: 0,0:06:21.82,0:06:24.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, akhirnya.
Dialogue: 0,0:06:33.29,0:06:34.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi!
Dialogue: 0,0:06:35.17,0:06:38.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami mau bicara, Kak Lucas Frost.
Dialogue: 0,0:06:40.71,0:06:41.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian...
Dialogue: 0,0:06:41.92,0:06:43.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kawan Ray White.
Dialogue: 0,0:06:44.30,0:06:47.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami ingin melawannya dengan serius!
Dialogue: 0,0:06:47.35,0:06:49.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu juga kan,
Dialogue: 0,0:06:49.31,0:06:51.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyihir Pedang Mutlak?
Dialogue: 0,0:06:51.72,0:06:53.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin melawan Sang Pedang Es.
Dialogue: 0,0:06:54.48,0:06:57.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyihir terkuat\Nadalah Sang Pedang Mutlak.
Dialogue: 0,0:06:57.56,0:07:00.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin membuktikannya padamu.
Dialogue: 0,0:07:00.11,0:07:01.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang Mutlak?
Dialogue: 0,0:07:02.07,0:07:04.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi itu sebabnya.
Dialogue: 0,0:07:04.24,0:07:07.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, hanya kamulah yang ingin kami ajak!
Dialogue: 0,0:07:07.57,0:07:09.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:07:09.08,0:07:09.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu.
Dialogue: 0,0:07:10.33,0:07:13.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak akan menggunakan katana.\NKalian boleh serang bersamaan.
Dialogue: 0,0:07:13.83,0:07:17.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunjukkan kekuatan\Ndan tekad kalian padaku.
Dialogue: 0,0:07:18.08,0:07:20.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu lagi, jangan injak\Ntatami-nya dengan sepatu kalian.
Dialogue: 0,0:07:22.34,0:07:24.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Majulah begitu kalian siap.
Dialogue: 0,0:07:35.85,0:07:37.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pasti sangat senang, ya,
Dialogue: 0,0:07:37.48,0:07:39.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena abangnya sudah pulang.
Dialogue: 0,0:07:39.77,0:07:41.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka akur sekali, ya.
Dialogue: 0,0:07:42.19,0:07:43.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ray dan Dik Stella.
Dialogue: 0,0:07:43.73,0:07:46.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, seperti saudara kandung, kan?
Dialogue: 0,0:07:47.28,0:07:51.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini-begini, dulunya\Nmereka sama-sama canggung, lo.
Dialogue: 0,0:07:51.37,0:07:53.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Benarkah?
Dialogue: 0,0:07:53.16,0:07:53.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:07:54.50,0:07:59.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lydia... adikku meminta\Nkami mengasuh Ray.
Dialogue: 0,0:07:59.00,0:08:01.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau diingat-ingat,\Nbanyak hal yang telah terjadi, ya.
Dialogue: 0,0:08:03.21,0:08:04.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penasaran?
Dialogue: 0,0:08:04.17,0:08:04.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:08:05.63,0:08:07.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cerita soal Ray waktu baru datang kemari.
Dialogue: 0,0:08:07.76,0:08:09.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Te-Tentu!
Dialogue: 0,0:08:10.51,0:08:14.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ariane, soal pelatihan besok...
Dialogue: 0,0:08:15.27,0:08:16.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:08:16.31,0:08:19.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, bukan apa-apa, kok.
Dialogue: 0,0:08:19.27,0:08:20.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya?
Dialogue: 0,0:08:20.77,0:08:22.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm? Stella!
Dialogue: 0,0:08:22.98,0:08:24.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan tidur di sini!
Dialogue: 0,0:08:24.40,0:08:26.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ekspresi tidurmu memang\Nterlalu imut seperti biasa,
Dialogue: 0,0:08:26.57,0:08:28.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi harusnya tidur di ranjang, kan?
Dialogue: 0,0:08:30.03,0:08:32.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lanjutannya besok, ya.
Dialogue: 0,0:08:32.03,0:08:33.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, baik.
Dialogue: 0,0:08:33.65,0:08:34.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga, Ariane.
Dialogue: 0,0:08:34.90,0:08:36.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, kenapa?
Dialogue: 0,0:08:36.87,0:08:39.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Besok kita berkumpul pukul 6 pagi.
Dialogue: 0,0:08:39.46,0:08:41.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya kamu segera tidur.
Dialogue: 0,0:08:41.03,0:08:43.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, benar juga, ya.
Dialogue: 0,0:08:45.42,0:08:48.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, Bunda, selamat tidur.
Dialogue: 0,0:08:48.17,0:08:50.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, selamat tidur.
Dialogue: 0,0:08:55.43,0:08:58.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku masih sanggup lari...
Dialogue: 0,0:09:01.94,0:09:02.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke.
Dialogue: 0,0:09:06.32,0:09:06.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial...
Dialogue: 0,0:09:06.94,0:09:09.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak satupun serangan kita\Nada yang kena...
Dialogue: 0,0:09:09.45,0:09:12.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inikah kebolehan Tujuh Penyihir Agung...
Dialogue: 0,0:09:12.16,0:09:14.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sanggup bertahan hingga selarut ini...
Dialogue: 0,0:09:14.45,0:09:15.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus.
Dialogue: 0,0:09:15.87,0:09:18.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami merasa terhormat...\Nmendengar pujianmu...
Dialogue: 0,0:09:18.83,0:09:22.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya, akan kubuat kamu\Nbergerak meski selangkah...
Dialogue: 0,0:09:28.30,0:09:30.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian menarik juga, ya.
Dialogue: 0,0:09:32.72,0:09:36.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Albert Alium dan Evi Armstrong, ya?
Dialogue: 0,0:09:37.56,0:09:40.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak sabar lagi, Ray White.
Dialogue: 0,0:09:44.69,0:09:47.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar dia turut berpartisipasi, lo.
Dialogue: 0,0:09:47.02,0:09:48.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, Sang Pedang Es, ya.
Dialogue: 0,0:09:48.86,0:09:51.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sang Pedang Mutlak\Nsepertinya juga berpartisipasi.
Dialogue: 0,0:09:51.70,0:09:53.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menarik juga.
Dialogue: 0,0:09:53.53,0:09:57.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak generasi sebelumnya, Pedang Mutlak\Nmemang terobsesi pada Pedang Es.
Dialogue: 0,0:09:57.70,0:10:02.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Helena Grady, Grim Reaper,\Nlalu Paratrogo.
Dialogue: 0,0:10:02.69,0:10:05.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sang Pedang Es telah mengalahkan\Nmasing-masing dari mereka.
Dialogue: 0,0:10:05.21,0:10:08.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak salah lagi\Nkuasanya telah pulih kembali.
Dialogue: 0,0:10:08.21,0:10:13.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya, overheat-nya\Nbukan sembarang overheat.
Dialogue: 0,0:10:13.97,0:10:18.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, selama ini kita telah membuat\Nbanyak subjek uji mengalami overheat,
Dialogue: 0,0:10:18.89,0:10:22.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tetapi kasus Sang Pedang Es\Nbisa dikatakan cukup unik.
Dialogue: 0,0:10:22.39,0:10:25.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, memang karena Akasha?
Dialogue: 0,0:10:26.98,0:10:29.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ray di mana, ya?
Dialogue: 0,0:10:29.48,0:10:32.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya Abang mau siap-siap dulu.
Dialogue: 0,0:10:32.74,0:10:34.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, begitu rupanya.
Dialogue: 0,0:10:34.82,0:10:35.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:10:35.74,0:10:38.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya, ayo kita berangkat\Nduluan ke Hutan Dogma!
Dialogue: 0,0:10:38.74,0:10:40.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersedia, siap, ya!
Dialogue: 0,0:10:42.25,0:10:43.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, tunggu dulu!
Dialogue: 0,0:10:43.79,0:10:45.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wus!
Dialogue: 0,0:10:45.17,0:10:46.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dik Stella?
Dialogue: 0,0:10:47.67,0:10:51.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mbak Ariane, ayo sini!
Dialogue: 0,0:10:52.51,0:10:54.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei!
Dialogue: 0,0:10:54.05,0:10:56.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lumayan jauh juga, ya...
Dialogue: 0,0:10:58.01,0:11:00.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inikah Hutan Dogma?
Dialogue: 0,0:11:00.56,0:11:03.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, mulai hari ini\Nkita bakal latihan di sini.
Dialogue: 0,0:11:03.52,0:11:04.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi begitu...
Dialogue: 0,0:11:04.85,0:11:06.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat pagi, Ariane!
Dialogue: 0,0:11:07.44,0:11:08.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ray?
Dialogue: 0,0:11:08.27,0:11:10.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah! Itu, kan...
Dialogue: 0,0:11:11.78,0:11:13.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu, kan!
Dialogue: 0,0:11:13.15,0:11:14.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Itu"?
Dialogue: 0,0:11:15.45,0:11:16.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu?
Dialogue: 0,0:11:24.29,0:11:25.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:11:26.12,0:11:28.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ray, kan?
Dialogue: 0,0:11:29.04,0:11:31.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namaku Master White...
Dialogue: 0,0:11:32.30,0:11:34.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Black!
Dialogue: 0,0:11:34.21,0:11:37.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Black... Black... Black...
Dialogue: 0,0:11:37.18,0:11:39.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai hari ini,\Naku akan menjadi instrukturmu!
Dialogue: 0,0:11:39.80,0:11:40.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:11:40.43,0:11:43.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master White...
Dialogue: 0,0:11:43.06,0:11:44.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Black?
Dialogue: 0,0:11:44.56,0:11:47.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu putih? Atau hitam?
Dialogue: 0,0:11:48.19,0:11:49.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sersan Pelatihan Ariane...
Dialogue: 0,0:11:49.69,0:11:50.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya?
Dialogue: 0,0:11:50.69,0:11:54.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya kamu sudah lupa,\Ntapi jawabannya adalah "Ranger."
Dialogue: 0,0:11:54.19,0:11:54.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:11:54.82,0:11:57.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kubilang jawabnya "Ranger," kan?
Dialogue: 0,0:11:57.57,0:12:00.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ra-Ranger!
Dialogue: 0,0:12:00.57,0:12:05.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai hari ini, kita akan melaksanakan\NBootcamp Ala Ainsworth yang meliputi
Dialogue: 0,0:12:05.58,0:12:07.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pelatihan bertahan hidup\Ndan pertempuran praktis.
Dialogue: 0,0:12:07.83,0:12:09.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bulatkan tekadmu!
Dialogue: 0,0:12:09.58,0:12:10.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hiyat!
Dialogue: 0,0:12:12.09,0:12:13.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang juga...
Dialogue: 0,0:12:13.34,0:12:15.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ra-Ranger...
Dialogue: 0,0:12:16.42,0:12:18.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jawab dengan tegas!
Dialogue: 0,0:12:18.22,0:12:20.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nger!
Dialogue: 0,0:12:20.76,0:12:21.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang lengkap.
Dialogue: 0,0:12:22.60,0:12:24.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ranger!
Dialogue: 0,0:12:27.94,0:12:31.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, kalau begitu langsung saja\Nkita mulai latihan tempur!
Dialogue: 0,0:12:31.19,0:12:32.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ranger!
Dialogue: 0,0:12:32.36,0:12:34.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,\Nkuperkenalkan kolaborator kita!
Dialogue: 0,0:12:34.36,0:12:35.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kolaborator?
Dialogue: 0,0:12:35.53,0:12:38.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat pagi, Sersan Pelatihan Ariane!
Dialogue: 0,0:12:38.24,0:12:39.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dik Stella?
Dialogue: 0,0:12:41.53,0:12:42.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:12:42.24,0:12:45.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa...
Dialogue: 0,0:12:46.29,0:12:48.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namaku Sister White...
Dialogue: 0,0:12:48.50,0:12:50.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Grey!
Dialogue: 0,0:12:50.17,0:12:52.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kubantu dengan sungguh-sungguh!
Dialogue: 0,0:12:53.21,0:12:54.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Grey?
Dialogue: 0,0:12:54.29,0:12:56.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan bukan putih maupun hitam...
Dialogue: 0,0:12:56.34,0:12:58.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu sebentar!
Dialogue: 0,0:12:58.38,0:13:00.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, Sersan Pelatihan Ariane?
Dialogue: 0,0:13:00.01,0:13:03.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hutan Dogma itu tingkat kesulitannya S, lo!
Dialogue: 0,0:13:03.10,0:13:04.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang kenapa?
Dialogue: 0,0:13:04.39,0:13:06.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Memang kenapa?"
Dialogue: 0,0:13:07.14,0:13:08.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan masalah.
Dialogue: 0,0:13:08.27,0:13:10.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam pertempuran jarak dekat,
Dialogue: 0,0:13:10.89,0:13:13.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kemampuannya setara denganku.
Dialogue: 0,0:13:13.77,0:13:16.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Monster di hutan itu tak perlu ditakuti.
Dialogue: 0,0:13:16.65,0:13:17.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:13:18.40,0:13:20.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang aja, Sersan Pelatihan Ariane.
Dialogue: 0,0:13:23.41,0:13:24.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:13:25.41,0:13:27.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski banyak yang perlu kuprotes,
Dialogue: 0,0:13:27.49,0:13:29.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mohon kerja samanya.
Dialogue: 0,0:13:44.01,0:13:46.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hu-Huge Scorpion?
Dialogue: 0,0:13:46.31,0:13:47.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:13:47.01,0:13:48.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sanggup, kan, Grey?
Dialogue: 0,0:13:48.52,0:13:50.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja, Bang—\NBlack.
Dialogue: 0,0:13:50.93,0:13:51.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:13:52.44,0:13:53.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Tunggu...
Dialogue: 0,0:14:05.41,0:14:07.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sip, sudah beres!
Dialogue: 0,0:14:07.41,0:14:08.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu, Ray...
Dialogue: 0,0:14:08.87,0:14:10.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master White Black.
Dialogue: 0,0:14:10.79,0:14:12.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, Tuan Black.
Dialogue: 0,0:14:12.58,0:14:13.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:14:14.21,0:14:16.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Barusan, Dik Ste—\NMaksudku Nona Grey...
Dialogue: 0,0:14:16.75,0:14:17.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekadar ditendang saja.
Dialogue: 0,0:14:17.96,0:14:18.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pakai sihir?
Dialogue: 0,0:14:18.88,0:14:20.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekadar penguatan fisik.
Dialogue: 0,0:14:20.55,0:14:23.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekadar penguatan fisik saja\Ncukup satu serangan?
Dialogue: 0,0:14:23.18,0:14:24.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, Ste—
Dialogue: 0,0:14:24.34,0:14:27.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Grey pandai menemukan\Ntitik lemah makhluk hidup.
Dialogue: 0,0:14:27.60,0:14:31.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, kalau dia sekadar menggunakan\Nbela diri tanpa sihir penguatan,
Dialogue: 0,0:14:31.43,0:14:33.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia pasti akan segera melampauiku.
Dialogue: 0,0:14:34.23,0:14:37.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena dia adalah spesialis\Npertarungan jarak dekat.
Dialogue: 0,0:14:38.98,0:14:40.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mbak Ariane!
Dialogue: 0,0:14:40.82,0:14:42.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kuat banget, kan?
Dialogue: 0,0:14:42.28,0:14:43.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya...
Dialogue: 0,0:14:43.49,0:14:47.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu dilatih Ra—\Noleh Tuan Black?
Dialogue: 0,0:14:47.07,0:14:49.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama Black dan Tante Lydia.
Dialogue: 0,0:14:49.83,0:14:53.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyihir Pedang Es generasi\Nsebelumnya dan sekarang, ya.
Dialogue: 0,0:14:53.50,0:14:56.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Didikannya kelewatan elite, ya.
Dialogue: 0,0:14:57.71,0:14:59.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitulah.
Dialogue: 0,0:14:59.00,0:15:02.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, kita mulai\Nlatihan pertempuran yang sebenarnya!
Dialogue: 0,0:15:02.09,0:15:03.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paham?
Dialogue: 0,0:15:03.09,0:15:04.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ranger!
Dialogue: 0,0:15:05.51,0:15:08.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kita akan berlatih di sini?
Dialogue: 0,0:15:08.60,0:15:09.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:15:09.43,0:15:12.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, untuk menggunakan sihir\Nbukannya perlu alat...
Dialogue: 0,0:15:12.10,0:15:13.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu khawatir.
Dialogue: 0,0:15:19.44,0:15:20.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Tempat ini...
Dialogue: 0,0:15:22.03,0:15:25.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa dibilang ruang yang diselimuti ilusi.
Dialogue: 0,0:15:25.11,0:15:27.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena hubungan sebab akibat\Ndengan dunia luar telah diputus,
Dialogue: 0,0:15:27.95,0:15:29.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa pun yang terjadi di sini akan aman saja.
Dialogue: 0,0:15:30.33,0:15:33.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inikah kekuatan Tujuh Penyihir Agung?
Dialogue: 0,0:15:33.04,0:15:36.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, akan kuberitahukan\Nrencana pelatihannya.
Dialogue: 0,0:15:37.37,0:15:42.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Butterfly Effect milikmu bisa dibilang\Nversi tingkat tinggi dari sihirku.
Dialogue: 0,0:15:42.25,0:15:44.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Aduh, itu tidak mungkin...\N- Memang benar,
Dialogue: 0,0:15:44.59,0:15:47.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}keahlianku sebagai\Npenyihir lebih unggul darimu.
Dialogue: 0,0:15:47.89,0:15:50.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, jika dilihat dari sifat\NButterfly Effect-mu
Dialogue: 0,0:15:50.26,0:15:52.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}perbedaannya akan sangat jelas.
Dialogue: 0,0:15:52.06,0:15:53.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sifat?
Dialogue: 0,0:15:53.14,0:15:57.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya mampu memengaruhi\Nsebagian sebab akibat di dunia ini.
Dialogue: 0,0:15:57.98,0:16:01.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedangkan kamu mampu\Nmemengaruhi segala sebab akibat.
Dialogue: 0,0:16:01.15,0:16:04.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sosok yang layak\Nmenjadi Tujuh Penyihir Agung.
Dialogue: 0,0:16:04.07,0:16:05.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku?
Dialogue: 0,0:16:05.40,0:16:09.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin kamu belum sadar,\Ntapi itulah faktanya.
Dialogue: 0,0:16:09.32,0:16:10.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula...
Dialogue: 0,0:16:10.82,0:16:12.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gelar Tujuh Penyihir Agung terus berganti.
Dialogue: 0,0:16:14.08,0:16:16.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,\Nmari kita mulai, Amelia Rose.
Dialogue: 0,0:16:16.66,0:16:18.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baik!
Dialogue: 0,0:16:18.71,0:16:21.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dik Stella benar-benar hebat, ya.
Dialogue: 0,0:16:21.67,0:16:23.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sama sekali bukan tandingannya.
Dialogue: 0,0:16:23.84,0:16:27.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, Ariane baru pertama kali ini\Nmelakukan pertempuran di hutan, kan?
Dialogue: 0,0:16:27.67,0:16:31.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Stella sudah terbiasa melakukan\Npertempuran nyata di lapangan.
Dialogue: 0,0:16:31.35,0:16:32.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perbedaannya tentu besar.
Dialogue: 0,0:16:32.68,0:16:36.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu, aku tetap kecewa\Ndengan ketidakmampuanku.
Dialogue: 0,0:16:36.18,0:16:37.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk itulah kamu berlatih.
Dialogue: 0,0:16:37.81,0:16:40.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, aku akan berusaha keras.
Dialogue: 0,0:16:41.10,0:16:44.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin Ariane mampu melaluinya.
Dialogue: 0,0:16:47.11,0:16:48.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:16:50.24,0:16:52.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, rasanya ada yang mengawasi...
Dialogue: 0,0:16:52.20,0:16:53.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengawasi?
Dialogue: 0,0:16:53.28,0:16:55.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rawr!
Dialogue: 0,0:16:57.20,0:16:59.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, cuma macan.
Dialogue: 0,0:16:59.21,0:17:00.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Eh?
Dialogue: 0,0:17:00.62,0:17:03.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau cuma macan liar\Ntak perlu dipedulikan.
Dialogue: 0,0:17:03.04,0:17:05.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, barusan itu, kan...
Dialogue: 0,0:17:07.55,0:17:10.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dipikir-pikir, jangan menyamar\Njadi binatang buas besar, dong!
Dialogue: 0,0:17:10.47,0:17:12.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untung kita bisa mengelabuinya!
Dialogue: 0,0:17:12.72,0:17:15.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi mana ada\Nkucing di tempat seperti ini?
Dialogue: 0,0:17:15.97,0:17:17.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya...
Dialogue: 0,0:17:18.48,0:17:20.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang tadi itu, bagaimana menurutmu?
Dialogue: 0,0:17:20.14,0:17:21.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutku?
Dialogue: 0,0:17:21.23,0:17:23.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya mereka terlalu dekat?
Dialogue: 0,0:17:23.48,0:17:27.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, Ray memang seperti itu\Nke semua orang...
Dialogue: 0,0:17:27.35,0:17:29.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya Ray, tapi Mbak Ariane!
Dialogue: 0,0:17:30.65,0:17:33.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, sepertinya dia tidak membencinya.
Dialogue: 0,0:17:33.41,0:17:36.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hubungan mereka perlahan makin dekat.
Dialogue: 0,0:17:36.62,0:17:37.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei.
Dialogue: 0,0:17:37.37,0:17:39.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kita
Dialogue: 0,0:17:39.25,0:17:41.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Aho! Aho!\N- berada di tempat seperti ini,
Dialogue: 0,0:17:41.04,0:17:42.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Idi*t! Otak udang!\N- berpakaian begini, dan melakukan ini?
Dialogue: 0,0:17:42.87,0:17:45.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagian, kok kamu bisa dapat alamatnya?
Dialogue: 0,0:17:45.96,0:17:48.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alamatnya kudapatkan\Ndengan wewenang anggota OSIS.
Dialogue: 0,0:17:49.26,0:17:51.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini demi Nona Rebecca.
Dialogue: 0,0:17:51.01,0:17:52.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang tidak apa-apa, tuh?
Dialogue: 0,0:17:52.72,0:17:54.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini semua demi Nona Rebecca!
Dialogue: 0,0:17:56.01,0:17:57.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, boleh aku pulang?
Dialogue: 0,0:17:57.22,0:17:58.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan, dong!
Dialogue: 0,0:17:58.77,0:18:01.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kesepian kalau sendirian!
Dialogue: 0,0:18:01.48,0:18:02.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya sudah, pulang saja, yuk.
Dialogue: 0,0:18:02.94,0:18:04.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan, dong!
Dialogue: 0,0:18:04.77,0:18:08.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang memahami perasaan\NNona Rebecca cuma kita berdua, lo!
Dialogue: 0,0:18:08.98,0:18:10.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh...
Dialogue: 0,0:18:10.53,0:18:11.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm?
Dialogue: 0,0:18:24.79,0:18:28.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai hari ini, kita akan menggelar\Nlatihan pertempuran gerilya.
Dialogue: 0,0:18:28.46,0:18:30.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pahami segala situasi dan lingkungannya,
Dialogue: 0,0:18:30.46,0:18:33.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}resapi dalam tubuh kalian\Ncara bertempur yang menguntungkan!
Dialogue: 0,0:18:33.80,0:18:35.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ingat baik-baik!
Dialogue: 0,0:18:38.47,0:18:39.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Huh?
Dialogue: 0,0:18:39.18,0:18:40.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duar!
Dialogue: 0,0:18:40.27,0:18:41.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Loh ya!
Dialogue: 0,0:18:41.98,0:18:43.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ranger!
Dialogue: 0,0:18:43.02,0:18:45.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita gaskan!
Dialogue: 0,0:18:45.31,0:18:48.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, latihan dimulai!
Dialogue: 0,0:18:52.99,0:18:58.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, rasakan aliran prima materia\Nyang berada di sekitar tubuhmu.
Dialogue: 0,0:19:17.93,0:19:19.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh...
Dialogue: 0,0:19:21.26,0:19:22.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Liselotte...
Dialogue: 0,0:19:23.52,0:19:25.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:19:25.60,0:19:29.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak. Mungkin pengajaranku\Nyang seharusnya lebih baik lagi.
Dialogue: 0,0:19:30.52,0:19:32.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Liselotte?
Dialogue: 0,0:19:32.86,0:19:34.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan apa-apa.
Dialogue: 0,0:19:34.36,0:19:36.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita lanjutkan.
Dialogue: 0,0:19:36.28,0:19:37.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:19:40.37,0:19:42.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mendadak sekali, sih...
Dialogue: 0,0:19:42.54,0:19:44.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, ketemu juga.
Dialogue: 0,0:19:45.29,0:19:46.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kenapa?
Dialogue: 0,0:19:46.62,0:19:48.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mbak Claris.
Dialogue: 0,0:19:48.13,0:19:49.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedang galau, ya?
Dialogue: 0,0:19:49.88,0:19:53.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, tidak. Bukan apa-apa, kok...
Dialogue: 0,0:19:56.01,0:19:58.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepi juga ya kalau enggak ada mereka.
Dialogue: 0,0:19:58.64,0:20:00.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang... benar.
Dialogue: 0,0:20:00.64,0:20:03.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka bakal pulang cepat enggak, ya?
Dialogue: 0,0:20:03.39,0:20:06.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga... bisa segera\Nbertemu mereka lagi, ya.
Dialogue: 0,0:20:08.77,0:20:10.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berat sekali, ya.
Dialogue: 0,0:20:11.06,0:20:13.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku merasa...
Dialogue: 0,0:20:13.57,0:20:14.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini.
Dialogue: 0,0:20:15.78,0:20:16.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bunda.
Dialogue: 0,0:20:16.99,0:20:19.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita sudah janji, kan.
Dialogue: 0,0:20:20.66,0:20:23.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ray datang ke rumah ini\Nsekitar tiga tahun lalu.
Dialogue: 0,0:20:24.24,0:20:28.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesan pertamaku,\Ndia seperti anak pendiam.
Dialogue: 0,0:20:28.62,0:20:32.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia terlalu pendiam untuk anak\Nberusia 12 tahunan.
Dialogue: 0,0:20:33.04,0:20:36.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu itu, Stella juga masih pemalu.
Dialogue: 0,0:20:36.09,0:20:38.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku terus mengamati mereka.
Dialogue: 0,0:20:40.09,0:20:41.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak disangka, kan?
Dialogue: 0,0:20:41.47,0:20:46.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, ya...\NAura yang dipancarkan Ray saat itu...
Dialogue: 0,0:20:46.02,0:20:48.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin itu yang\Nmembuat Stella takut padanya.
Dialogue: 0,0:20:50.02,0:20:52.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah dengar mengapa Ray\Ntinggal bersama kami?
Dialogue: 0,0:20:52.69,0:20:57.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah. Atas arahan Masternya\Nsetelah purna dari militer.
Dialogue: 0,0:20:57.44,0:20:58.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:20:58.53,0:21:00.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lydia mempercayakannya padaku.
Dialogue: 0,0:21:01.36,0:21:03.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seorang anak yang telah\Nmelihat neraka dunia
Dialogue: 0,0:21:04.03,0:21:06.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di usia 12 tahun.
Dialogue: 0,0:21:06.08,0:21:08.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh saya bertanya?
Dialogue: 0,0:21:08.46,0:21:09.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu.
Dialogue: 0,0:21:09.33,0:21:13.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa Masternya Ray, Nona Lydia\Nmemercayakannya pada Nyonya Sasha?
Dialogue: 0,0:21:13.59,0:21:16.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika terus bersamanya\Nyang hanya tahu medan perang,
Dialogue: 0,0:21:16.63,0:21:19.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia merasa Ray tak akan pernah bahagia.
Dialogue: 0,0:21:19.09,0:21:22.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan menjauhkannya dari pertempuran,\Ndia dapat jalani hidup sesuai usianya...
Dialogue: 0,0:21:22.51,0:21:25.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}seperti anak normal.
Dialogue: 0,0:21:25.81,0:21:27.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh minta tolong?
Dialogue: 0,0:21:27.85,0:21:30.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya bisa memercayakan Ray
Dialogue: 0,0:21:30.77,0:21:32.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pada keluarganya Mbak.
Dialogue: 0,0:21:32.85,0:21:35.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, percayakan pada Mbak.
Dialogue: 0,0:21:35.40,0:21:38.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, mempunyai putra itu\Nrasanya boleh juga.
Dialogue: 0,0:21:39.95,0:21:41.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:21:42.99,0:21:46.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ray benar-benar\Ndisayangi banyak orang, ya.
Dialogue: 0,0:21:46.08,0:21:47.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ia putra yang baik, kan?
Dialogue: 0,0:21:47.41,0:21:48.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, sangat baik.
Dialogue: 0,0:21:48.91,0:21:50.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sini rupanya.
Dialogue: 0,0:21:50.87,0:21:52.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, iya...
Dialogue: 0,0:21:52.25,0:21:54.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Latihan besok akan lebih berat.
Dialogue: 0,0:21:54.92,0:21:56.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya Ariane segera istirahat.
Dialogue: 0,0:21:56.92,0:21:58.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, tentu...
Dialogue: 0,0:21:58.26,0:22:00.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu juga, begadang itu\Ntidak baik untuk kulitmu.
Dialogue: 0,0:22:00.63,0:22:02.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, terima kasih.
Dialogue: 0,0:22:05.14,0:22:06.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kyupin!
Dialogue: 0,0:22:08.77,0:22:11.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih banyak yang bisa kuajarkan.
Dialogue: 0,0:22:11.77,0:22:12.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:22:14.65,0:22:16.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari ungguli rival-rivalmu!
Dialogue: 0,0:22:16.73,0:22:17.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Heh?
Dialogue: 0,0:22:18.69,0:22:21.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mendukung Mbak Ariane, loh.
Dialogue: 0,0:22:23.20,0:22:24.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:22:24.16,0:22:25.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ La-la-la ♪
Dialogue: 0,0:22:25.87,0:22:27.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ La-la-la ♪
Dialogue: 0,0:22:27.66,0:22:28.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:22:28.45,0:22:29.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mbak Ariane.
Dialogue: 0,0:22:29.66,0:22:30.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
