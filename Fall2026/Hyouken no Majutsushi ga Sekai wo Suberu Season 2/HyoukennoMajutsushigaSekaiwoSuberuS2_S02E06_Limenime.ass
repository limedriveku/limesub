Dialogue: 0,0:02:03.27,0:02:09.53,sign,,0000,0000,0000,,PENYIHIR PEDANG ES\NAKAN MENGUASAI DUNIA SEASON 2
Dialogue: 0,0:03:24.48,0:03:28.86,sign,,0000,0000,0000,,PENYIHIR PEDANG ES\NAKAN MENGUASAI DUNIA SEASON 2
Dialogue: 0,0:03:28.86,0:03:31.63,sign,,0000,0000,0000,,EPISODE 6: PEMUDA YANG MERUPAKAN\NPENYIHIR TERKUAT DI DUNIA
Dialogue: 0,0:03:31.63,0:03:32.98,sign,,0000,0000,0000,,MENGHADAPI UJIAN YANG MENGHADANG
Dialogue: 0,0:22:31.75,0:22:33.25,sign,,0000,0000,0000,,PRATINJAU
Dialogue: 0,0:00:00.96,0:00:02.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata memang Eugenics, ya.
Dialogue: 0,0:00:02.86,0:00:04.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:00:04.07,0:00:07.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Urusannya bisa cepat kalau kita tahu\Nmereka bersekongkol dengan siapa.
Dialogue: 0,0:00:07.82,0:00:10.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kuingatkan, seluruh lawan kita\Nadalah anggota Keluarga Kerajaan.
Dialogue: 0,0:00:10.99,0:00:12.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Merepotkan.
Dialogue: 0,0:00:12.99,0:00:15.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau langsung bereskan semuanya?
Dialogue: 0,0:00:18.12,0:00:20.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa yang datang jam sebegini?
Dialogue: 0,0:00:21.07,0:00:22.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan siapa?
Dialogue: 0,0:00:22.79,0:00:25.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bukan orang mencurigakan.
Dialogue: 0,0:00:26.76,0:00:29.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo, selamat malam.
Dialogue: 0,0:00:32.72,0:00:35.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Acara Keakraban Anak Muda, ya.
Dialogue: 0,0:00:35.10,0:00:35.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:00:35.93,0:00:39.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya mereka ingin mempertemukan muda-mudi Alferia dan Arnold
Dialogue: 0,0:00:39.06,0:00:41.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}agar bisa saling mengenal.
Dialogue: 0,0:00:41.94,0:00:43.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yo, Ray.
Dialogue: 0,0:00:44.52,0:00:45.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kawan-kawan!
Dialogue: 0,0:00:46.40,0:00:47.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putri Olivia?
Dialogue: 0,0:00:47.94,0:00:49.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rupanya Anda datang.
Dialogue: 0,0:00:49.61,0:00:51.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lama tidak bertemu, Ray.
Dialogue: 0,0:00:51.45,0:00:53.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kamu Elisa, ya?
Dialogue: 0,0:00:53.78,0:00:54.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, benar!
Dialogue: 0,0:00:54.95,0:00:58.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Olivia, Putri Kedua Kerajaan Arnold!
Dialogue: 0,0:00:58.96,0:00:59.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salam kenal, ya!
Dialogue: 0,0:00:59.91,0:01:01.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pu-Putri?
Dialogue: 0,0:01:01.46,0:01:03.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sa-Salam kenal juga!
Dialogue: 0,0:01:03.58,0:01:05.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suatu kehormatan bertemu dengan Anda!
Dialogue: 0,0:01:05.59,0:01:07.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama-sama.
Dialogue: 0,0:01:07.21,0:01:09.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu Putri Keempat, kan?
Dialogue: 0,0:01:09.63,0:01:12.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar Ray-ku banyak membantumu,
Dialogue: 0,0:01:12.51,0:01:14.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}makanya aku ingin menyapamu!
Dialogue: 0,0:01:15.85,0:01:17.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Ray-ku"?
Dialogue: 0,0:01:18.22,0:01:21.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hadirin sekalian dari Arnold,\Nselamat datang di Alferia.
Dialogue: 0,0:01:22.23,0:01:25.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagu ini kupersembahkan\Nuntuk Arnold dan Alferia.
Dialogue: 0,0:01:25.86,0:01:27.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk kalian yang hidup di kedua negeri ini.
Dialogue: 0,0:01:27.89,0:01:31.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga lagu ini menyatukan\Nperasaan kita yang hadir
Dialogue: 0,0:01:31.24,0:01:34.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}agar kita berani melangkah menuju\Nmasa depan yang cerah.
Dialogue: 0,0:01:34.66,0:01:37.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bernyanyi dengan\Nmenyampaikan harapan itu.
Dialogue: 0,0:01:37.12,0:01:39.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, selamat mendengarkan...
Dialogue: 0,0:01:40.75,0:01:42.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Diamond Dust".
Dialogue: 0,0:03:09.09,0:03:11.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih, masih, masih bisa lanjut, kan?
Dialogue: 0,0:03:33.65,0:03:35.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak!
Dialogue: 0,0:03:35.40,0:03:36.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai jumpa di konser berikutnya!
Dialogue: 0,0:03:36.99,0:03:40.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Konon nyanyian Elf lebih merdu\Ndari bidadari.
Dialogue: 0,0:03:40.47,0:03:42.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh indah suaranya.
Dialogue: 0,0:03:42.49,0:03:44.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!\NMenyentuh hati!
Dialogue: 0,0:03:44.79,0:03:46.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luar biasa sekali, ya!
Dialogue: 0,0:03:46.96,0:03:49.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang kalian menyukainya.
Dialogue: 0,0:03:49.75,0:03:51.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baginda Raja?
Dialogue: 0,0:03:51.92,0:03:54.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu seformal itu.
Dialogue: 0,0:03:54.51,0:03:59.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu, sepertinya kamu baru tahu\Nkalau dirimu anggota Keluarga Kerajaan.
Dialogue: 0,0:03:59.47,0:04:00.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:04:00.51,0:04:04.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu tidak banyak cerita soal masa lalunya.
Dialogue: 0,0:04:04.52,0:04:06.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:04:06.27,0:04:10.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saria memang meninggalkan negeri ini\Ndan keluarganya demi kekasihnya.
Dialogue: 0,0:04:10.44,0:04:12.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin dia merasa bersalah...
Dialogue: 0,0:04:12.52,0:04:14.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada akhirnya, dia tidak pernah pulang...
Dialogue: 0,0:04:15.61,0:04:18.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, aku tidak bermaksud menyalahkannya.
Dialogue: 0,0:04:18.91,0:04:22.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami benar-benar menyambut kedatanganmu.
Dialogue: 0,0:04:22.07,0:04:23.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:04:25.10,0:04:27.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu Ray White, ya?
Dialogue: 0,0:04:27.83,0:04:28.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:04:28.66,0:04:30.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harap Elisa
Dialogue: 0,0:04:30.21,0:04:35.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa mendukung negeri ini bersama kami\Nsebagai anggota Keluarga Kerajaan.
Dialogue: 0,0:04:35.80,0:04:36.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:04:36.67,0:04:38.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengingat kamu seorang ordinary
Dialogue: 0,0:04:38.01,0:04:39.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- dan manusia biasa,\N- Endap, endap...
Dialogue: 0,0:04:39.80,0:04:41.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}meski kalian sudah menjadi kopel,
Dialogue: 0,0:04:41.18,0:04:44.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami tak bisa merestui pernikahan\Nkalian semudah itu.
Dialogue: 0,0:04:44.10,0:04:45.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Artinya...
Dialogue: 0,0:04:45.68,0:04:48.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak akan kuserahkan keponakanku padamu!
Dialogue: 0,0:04:48.68,0:04:50.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak akan kuserahkan!
Dialogue: 0,0:04:50.85,0:04:52.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya memahaminya.
Dialogue: 0,0:04:52.48,0:04:53.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bercanda.
Dialogue: 0,0:04:53.69,0:04:57.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, aku selalu ingin mengatakan itu.
Dialogue: 0,0:04:57.94,0:05:02.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa sangka kata "pernikahan" akan keluar\Ndari mulut Baginda Raja.
Dialogue: 0,0:05:02.07,0:05:04.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu memang di luar dugaan.
Dialogue: 0,0:05:04.03,0:05:07.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin mereka sampai bablas menikah...
Dialogue: 0,0:05:07.20,0:05:08.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh terlalu...
Dialogue: 0,0:05:08.87,0:05:11.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagian, kenapa mesti di kamarku?
Dialogue: 0,0:05:12.21,0:05:15.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini gawat!\NIni masalah besar buat Ray-ku!
Dialogue: 0,0:05:15.55,0:05:16.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putri?
Dialogue: 0,0:05:16.67,0:05:19.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski mendadak, ayo kita kolab!
Dialogue: 0,0:05:19.09,0:05:20.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan Putri satunya?
Dialogue: 0,0:05:21.72,0:05:26.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Surat dari Ketua Asosiasi Sihir\NKerajaan Arnold, Greg Iamston
Dialogue: 0,0:05:26.26,0:05:28.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}telah kami sampaikan.
Dialogue: 0,0:05:28.27,0:05:29.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:05:29.28,0:05:32.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih atas kedatangan langsung\Nanggota Ketujuh Penyihir Agung.
Dialogue: 0,0:05:33.09,0:05:34.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini kesempatan bagus.
Dialogue: 0,0:05:34.61,0:05:38.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama tinggal di sini, aku ingin\Nkalian lebih mengenal negeri ini.
Dialogue: 0,0:05:38.73,0:05:40.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Baginda Raja.
Dialogue: 0,0:05:41.28,0:05:43.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, kami permisi.
Dialogue: 0,0:05:46.28,0:05:47.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baginda.
Dialogue: 0,0:05:47.95,0:05:49.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa gerangan?
Dialogue: 0,0:05:49.50,0:05:52.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Negeri yang selama ini gigih menutup\Nhubungan diplomatik
Dialogue: 0,0:05:52.71,0:05:54.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tiba-tiba membuka gerbangnya.
Dialogue: 0,0:05:54.50,0:05:57.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa baru sekarang?
Dialogue: 0,0:05:57.38,0:05:59.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami para Ras Elf adalah\Nras berumur panjang.
Dialogue: 0,0:06:00.16,0:06:03.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagian besar dari kami\Nmerasa angkuh karena hal itu,
Dialogue: 0,0:06:03.05,0:06:08.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menganggap dirinya ras unggul\Ndan memutus hubungan dengan ras lain.
Dialogue: 0,0:06:08.01,0:06:11.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, dunia manusia\Nterus berubah dan berkembang.
Dialogue: 0,0:06:12.51,0:06:16.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau terus begini,\Nkami akan tertinggal dari dunia.
Dialogue: 0,0:06:16.02,0:06:20.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru sekaranglah saatnya kami\Nmelakukan perubahan besar.
Dialogue: 0,0:06:20.03,0:06:21.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakanda.
Dialogue: 0,0:06:21.11,0:06:23.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu disembunyikan.
Dialogue: 0,0:06:23.15,0:06:25.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka pihak yang akan\Nbergandengan tangan dengan kita.
Dialogue: 0,0:06:26.99,0:06:29.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ada pihak lain yang kalian gandeng?
Dialogue: 0,0:06:30.54,0:06:33.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misalnya, Eugenics.
Dialogue: 0,0:06:34.08,0:06:36.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nama yang tidak pernah kudengar.
Dialogue: 0,0:06:36.21,0:06:39.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagi dunia yang menutup diri\Ndan tak begitu paham soal dunia luar,
Dialogue: 0,0:06:39.59,0:06:42.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mereka adalah ancaman\Nyang tak bisa kalian bayangkan.
Dialogue: 0,0:06:42.42,0:06:44.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lancang sekali!
Dialogue: 0,0:06:44.18,0:06:46.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudmu kami tidak tahu apa-apa, ya?
Dialogue: 0,0:06:46.47,0:06:47.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, ya.
Dialogue: 0,0:06:47.93,0:06:50.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulutnya Lydia tidak bisa dijaga.
Dialogue: 0,0:06:50.97,0:06:52.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak sopan, Gumpalan Pink.
Dialogue: 0,0:06:52.60,0:06:53.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:06:54.52,0:06:58.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhati-hati itu tidak ada salahnya.
Dialogue: 0,0:06:58.06,0:06:59.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, kita pergi.
Dialogue: 0,0:06:59.36,0:06:59.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm?
Dialogue: 0,0:06:59.94,0:07:01.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, Abbie!
Dialogue: 0,0:07:01.23,0:07:02.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami izin pamit.
Dialogue: 0,0:07:02.36,0:07:04.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salam sejahtera.
Dialogue: 0,0:07:06.20,0:07:10.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin kamu sudah muak,\Ntapi ujianmu masih berlanjut!
Dialogue: 0,0:07:10.33,0:07:11.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih lanjut!
Dialogue: 0,0:07:11.45,0:07:14.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.\NSilakan, sampai kalian semua puas!
Dialogue: 0,0:07:14.71,0:07:16.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama sekali tak gentar, ya.
Dialogue: 0,0:07:16.71,0:07:20.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya, ambilkan telur Thunderbird!
Dialogue: 0,0:07:20.04,0:07:23.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sarangnya ada di puncak pohon\Ntertinggi di hutan ini.
Dialogue: 0,0:07:23.09,0:07:25.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dimengerti!\NLangsung saja...
Dialogue: 0,0:07:25.30,0:07:26.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:07:27.09,0:07:28.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat!
Dialogue: 0,0:07:28.05,0:07:29.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putri Cathy...
Dialogue: 0,0:07:30.55,0:07:33.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elisa, perhatikan baik-baik.
Dialogue: 0,0:07:33.22,0:07:36.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kubongkar tabiat busuknya itu!
Dialogue: 0,0:07:36.35,0:07:37.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Busuk...
Dialogue: 0,0:07:37.81,0:07:39.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketawa macam apa itu?
Dialogue: 0,0:07:39.81,0:07:43.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, sebelumnya maaf,\Ntapi kamu harus membantu kami.
Dialogue: 0,0:07:43.48,0:07:45.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membantu?
Dialogue: 0,0:07:45.19,0:07:46.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi.
Dialogue: 0,0:07:48.86,0:07:49.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu...
Dialogue: 0,0:07:49.99,0:07:51.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja.
Dialogue: 0,0:07:51.37,0:07:53.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama sekali tak terasa sakit, kok.
Dialogue: 0,0:07:53.37,0:07:54.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami mau diapakan?
Dialogue: 0,0:07:57.08,0:07:58.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ray!
Dialogue: 0,0:07:58.42,0:07:59.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm?
Dialogue: 0,0:07:59.42,0:08:01.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ray!
Dialogue: 0,0:08:01.88,0:08:03.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ray!
Dialogue: 0,0:08:03.88,0:08:06.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ray!\N- Kak Rebecca?
Dialogue: 0,0:08:06.13,0:08:07.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ray!
Dialogue: 0,0:08:07.68,0:08:08.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kinokoon!
Dialogue: 0,0:08:15.31,0:08:17.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu baik-baik saja, Kak Rebecca?
Dialogue: 0,0:08:17.72,0:08:18.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ray.
Dialogue: 0,0:08:18.89,0:08:21.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa pakai kostum maid di tengah hutan?
Dialogue: 0,0:08:22.61,0:08:24.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertanyaan yang wajar.
Dialogue: 0,0:08:24.78,0:08:29.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana?\NKudengar Ray menyukainya...
Dialogue: 0,0:08:29.53,0:08:30.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:08:30.41,0:08:33.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di garis dunia mana pun,\Ntak mungkin ada orang yang membenci maid.
Dialogue: 0,0:08:33.70,0:08:35.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh cocok denganmu.
Dialogue: 0,0:08:35.15,0:08:39.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keanggunan Kak Rebecca\Nserta kecantikan yang berwibawa,
Dialogue: 0,0:08:39.46,0:08:43.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berpadu sempurna dengan kostum maid\Nyang santun namun menawan.
Dialogue: 0,0:08:43.88,0:08:47.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski sebagai maid,\Nkostummu ini terlalu mengumbar aurat...
Dialogue: 0,0:08:48.63,0:08:50.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa, sih?
Dialogue: 0,0:08:50.84,0:08:52.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kolab, ya?
Dialogue: 0,0:08:53.26,0:08:55.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kira-kira seperti apa rencananya?
Dialogue: 0,0:08:56.93,0:08:59.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu, menggodanya!
Dialogue: 0,0:08:59.81,0:09:00.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Me-Menggoda?
Dialogue: 0,0:09:00.81,0:09:01.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membuatnya tergoda?
Dialogue: 0,0:09:01.81,0:09:02.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:09:02.69,0:09:03.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:09:03.56,0:09:04.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi begitu.
Dialogue: 0,0:09:04.82,0:09:08.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menggunakan pesona kita\Nuntuk membuat Ray lupa akan ujiannya.
Dialogue: 0,0:09:08.94,0:09:11.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaikan sulap\N"simsalabim, satu, dua, menghilang!"
Dialogue: 0,0:09:11.82,0:09:13.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti itu, kan?
Dialogue: 0,0:09:14.49,0:09:17.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rebecca memang hebat,\Nselalu cepat tanggap.
Dialogue: 0,0:09:17.08,0:09:18.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya tersanjung.
Dialogue: 0,0:09:19.50,0:09:20.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, semuanya!
Dialogue: 0,0:09:20.92,0:09:21.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai sekarang,
Dialogue: 0,0:09:21.83,0:09:25.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}khusus masa kolaborasi,\Nserangan langsung pada Ray diizinkan!
Dialogue: 0,0:09:25.71,0:09:29.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini, menghalanginya saja sudah cukup...
Dialogue: 0,0:09:30.59,0:09:31.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putri Cathy.
Dialogue: 0,0:09:31.84,0:09:33.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- A-Apa?\N- Ini adalah pertempuran para gadis.
Dialogue: 0,0:09:33.76,0:09:36.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Mbakyu bicara apa, sih?\N- Oh...
Dialogue: 0,0:09:36.01,0:09:37.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kunamakan
Dialogue: 0,0:09:38.72,0:09:42.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Operasi Akbar Kilatan Cinta\NSetruman Thunderbolt!
Dialogue: 0,0:09:42.48,0:09:43.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Operasi akbar!
Dialogue: 0,0:09:44.73,0:09:48.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana pendapatmu soal aku...
Dialogue: 0,0:09:49.11,0:09:52.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak, kamu pasti kedinginan.
Dialogue: 0,0:09:52.03,0:09:55.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, dingin sekali.\NApa kamu mau menghangatkanku?
Dialogue: 0,0:09:55.95,0:09:57.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dimengerti.
Dialogue: 0,0:09:57.12,0:09:57.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:09:59.25,0:10:02.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, kamu langsung menyosor...
Dialogue: 0,0:10:03.37,0:10:04.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm?
Dialogue: 0,0:10:04.50,0:10:06.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan dipakai sebagai tindakan darurat.
Dialogue: 0,0:10:06.96,0:10:09.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebisa mungkin segeralah kembali.
Dialogue: 0,0:10:09.30,0:10:10.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu...
Dialogue: 0,0:10:10.30,0:10:12.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku harus segera lanjut.
Dialogue: 0,0:10:12.63,0:10:15.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:10:16.97,0:10:18.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takepoko!
Dialogue: 0,0:10:19.20,0:10:20.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takepoko!
Dialogue: 0,0:10:21.23,0:10:22.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu kan...
Dialogue: 0,0:10:22.18,0:10:24.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takepoko! Takepoko!
Dialogue: 0,0:10:24.27,0:10:25.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Amelia?
Dialogue: 0,0:10:26.27,0:10:27.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takepoko!
Dialogue: 0,0:10:27.52,0:10:28.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Amelia!
Dialogue: 0,0:10:28.90,0:10:30.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa di tempat seperti in?
Dialogue: 0,0:10:30.82,0:10:31.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ray...
Dialogue: 0,0:10:32.30,0:10:33.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penampilanmu ini...
Dialogue: 0,0:10:34.07,0:10:37.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gaun putih eksotis mancanegara nan serasi\Ndengan panorama salju keperakan ini
Dialogue: 0,0:10:37.99,0:10:41.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menonjolkan rambut\Nmerah delimamu yang membara,
Dialogue: 0,0:10:41.12,0:10:44.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menjadikan keseimbangan\Nsempurna antara manis dan seksi!
Dialogue: 0,0:10:44.57,0:10:46.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Te-Terima kasih...
Dialogue: 0,0:10:47.46,0:10:50.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya kakiku terkilir...
Dialogue: 0,0:10:50.75,0:10:51.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat!
Dialogue: 0,0:10:51.55,0:10:52.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kaki?
Dialogue: 0,0:10:52.67,0:10:58.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya, aku ingin kamu\Nmengantarku ke kamar...
Dialogue: 0,0:10:58.39,0:10:59.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:11:01.10,0:11:02.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm?
Dialogue: 0,0:11:02.68,0:11:03.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm?
Dialogue: 0,0:11:03.81,0:11:06.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, tapi tolong tunggu bantuan di sana.
Dialogue: 0,0:11:06.69,0:11:07.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Anu...
Dialogue: 0,0:11:07.86,0:11:09.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus bergegas.
Dialogue: 0,0:11:09.19,0:11:10.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu! Ray!
Dialogue: 0,0:11:10.57,0:11:12.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang benar saja...
Dialogue: 0,0:11:13.07,0:11:15.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sini Alpha First dan Beta Second.
Dialogue: 0,0:11:15.95,0:11:20.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Target melewati Pink Bradley\Ndan White Rose tanpa kendala.
Dialogue: 0,0:11:20.83,0:11:21.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ganti.
Dialogue: 0,0:11:21.87,0:11:24.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sini Delta Fourth, dimengerti.
Dialogue: 0,0:11:24.27,0:11:26.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Segera mundur, ganti.
Dialogue: 0,0:11:26.79,0:11:27.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dimengerti!
Dialogue: 0,0:11:27.83,0:11:29.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Target akan segera tiba.
Dialogue: 0,0:11:29.84,0:11:31.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo beri tahu anggota lain.
Dialogue: 0,0:11:31.71,0:11:32.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dimengerti!
Dialogue: 0,0:11:35.87,0:11:36.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:11:37.97,0:11:39.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kura-kura?
Dialogue: 0,0:11:39.51,0:11:42.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa aku harus memakai kostum ini?
Dialogue: 0,0:11:42.22,0:11:43.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan, kamu Maria, ya?
Dialogue: 0,0:11:44.48,0:11:45.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm...
Dialogue: 0,0:11:45.40,0:11:48.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski fesyenmu eksentrik\Ndengan cangkang kura-kura di punggung,
Dialogue: 0,0:11:48.19,0:11:51.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}justru makin menonjolkan\Nkecantikan murni nan alami Maria.
Dialogue: 0,0:11:51.94,0:11:54.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belum pernah melihat\Nkura-kura seanggun kamu.
Dialogue: 0,0:11:57.57,0:11:59.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hibernasi, ya?
Dialogue: 0,0:11:59.03,0:12:01.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Detailnya pun luar biasa rapi!
Dialogue: 0,0:12:01.33,0:12:03.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, tapi aku harus pergi.
Dialogue: 0,0:12:03.74,0:12:05.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berisik!
Dialogue: 0,0:12:05.45,0:12:07.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Turtle Bradley, telah ditenggelamkan.
Dialogue: 0,0:12:08.83,0:12:10.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ray!
Dialogue: 0,0:12:11.25,0:12:15.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ray!
Dialogue: 0,0:12:17.26,0:12:18.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ariane?
Dialogue: 0,0:12:18.59,0:12:19.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ray!
Dialogue: 0,0:12:19.51,0:12:22.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana gerangan penampilanku ini?
Dialogue: 0,0:12:23.33,0:12:26.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awalnya aku terpikat\Noleh telinga kelincimu yang imut,
Dialogue: 0,0:12:26.35,0:12:29.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi yang benar-benar memikatku\Nadalah otot-ototmu yang terlatih!
Dialogue: 0,0:12:29.48,0:12:32.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keindahan yang memperlihatkan\Nkerja kerasmu sekali pandang,
Dialogue: 0,0:12:32.15,0:12:34.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}benar-benar pantas disebut karya seni!
Dialogue: 0,0:12:34.27,0:12:36.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suatu kehormatan dapat pujian darimu.
Dialogue: 0,0:12:36.40,0:12:38.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, mari sama-sama berjuang!
Dialogue: 0,0:12:38.32,0:12:39.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentunya!
Dialogue: 0,0:12:40.78,0:12:41.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo?
Dialogue: 0,0:12:41.66,0:12:42.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya?
Dialogue: 0,0:12:42.78,0:12:45.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rabbit Olgren, hancur.
Dialogue: 0,0:12:45.16,0:12:47.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buu, buu! Buu, buu!
Dialogue: 0,0:12:47.66,0:12:48.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kirikabuu!
Dialogue: 0,0:12:48.91,0:12:49.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kirikabu?
Dialogue: 0,0:12:50.79,0:12:51.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggul pohon!
Dialogue: 0,0:12:51.85,0:12:54.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kirikabuu!
Dialogue: 0,0:12:54.38,0:12:55.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu kan...
Dialogue: 0,0:12:55.76,0:12:58.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putri Olivia?\NPenampilanmu...
Dialogue: 0,0:13:00.63,0:13:01.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana?
Dialogue: 0,0:13:02.80,0:13:04.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sangat cocok dengan Anda.
Dialogue: 0,0:13:04.35,0:13:07.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keceriaan Putri Olivia yang layaknya mentari
Dialogue: 0,0:13:07.06,0:13:10.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}saat terbalut busana anggun\Nyang memancarkan jiwa muda,
Dialogue: 0,0:13:10.64,0:13:13.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berpadu sempurna menjadi\Nkeimutan tiada tara!
Dialogue: 0,0:13:13.65,0:13:15.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be-Benarkah?
Dialogue: 0,0:13:17.19,0:13:18.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh!
Dialogue: 0,0:13:18.82,0:13:19.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini!
Dialogue: 0,0:13:22.20,0:13:23.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tantangan duel, ya?
Dialogue: 0,0:13:23.41,0:13:24.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini surat!
Dialogue: 0,0:13:25.12,0:13:29.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah susah payah\Nmenulis perasaanku padamu!
Dialogue: 0,0:13:30.11,0:13:33.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, setelah membacanya,\Naku mau dengar soal perasaanmu.
Dialogue: 0,0:13:33.83,0:13:34.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dimengerti.
Dialogue: 0,0:13:34.75,0:13:35.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Tunggu!
Dialogue: 0,0:13:35.67,0:13:36.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kepada Ray-ku tersayang.
Dialogue: 0,0:13:37.25,0:13:39.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak hari pertemuan kita,
Dialogue: 0,0:13:39.09,0:13:41.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hatiku jedag-jedug everyday.
Dialogue: 0,0:13:41.84,0:13:44.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar cinta cenat-cenut...
Dialogue: 0,0:13:45.60,0:13:48.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan dibaca sekarang!
Dialogue: 0,0:13:50.67,0:13:53.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sailor Arnold, meledak total.
Dialogue: 0,0:13:57.86,0:13:59.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Sebal!\N- Ray!
Dialogue: 0,0:13:59.74,0:14:00.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elisa.
Dialogue: 0,0:14:00.86,0:14:03.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh! Penampilanmu ini...
Dialogue: 0,0:14:03.11,0:14:07.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, Cathy menyuruhku memakainya...
Dialogue: 0,0:14:07.28,0:14:08.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya!
Dialogue: 0,0:14:08.79,0:14:10.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sangat cocok untukmu!
Dialogue: 0,0:14:10.33,0:14:12.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penampilanmu yang menyembuhkan itu
Dialogue: 0,0:14:12.00,0:14:15.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berpadu dengan kepribadianmu\Nyang hangat dan baik hati.
Dialogue: 0,0:14:15.04,0:14:19.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak berlebihan kalau kukatakan bidadari\Nbergaun putih telah turun ke dunia ini!
Dialogue: 0,0:14:19.42,0:14:21.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Te-Terima kasih...
Dialogue: 0,0:14:21.22,0:14:23.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kalau aku?
Dialogue: 0,0:14:23.72,0:14:26.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Claris juga terlihat cocok.
Dialogue: 0,0:14:26.01,0:14:28.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu ini, giliran aku\Ntanggapanmu cuma begitu, ya?
Dialogue: 0,0:14:29.52,0:14:31.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Cuma begitu?\N- Omong-omong...
Dialogue: 0,0:14:31.39,0:14:33.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedang apa kalian di hutan?
Dialogue: 0,0:14:33.89,0:14:34.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini...
Dialogue: 0,0:14:34.77,0:14:37.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Abaikan mereka!\NAyo kita lanjut!
Dialogue: 0,0:14:37.15,0:14:40.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini adalah ujian terakhirnya!
Dialogue: 0,0:14:42.65,0:14:47.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu harus bertarung melawan\NPangeran Pertama negeri ini, Kakanda Rald!
Dialogue: 0,0:14:47.62,0:14:52.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakandaku adalah pendekar terkuat\Nnomor satu se-Alferia!
Dialogue: 0,0:14:52.16,0:14:54.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf atas kegaduhan ini, ya.
Dialogue: 0,0:14:54.58,0:14:57.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya Cathy dan kawan-kawan\Nterlalu membesar-besarkannya.
Dialogue: 0,0:14:57.25,0:14:58.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak apa-apa.
Dialogue: 0,0:14:58.04,0:14:59.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ray White...
Dialogue: 0,0:14:59.92,0:15:02.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suatu kehormatan bisa\Nbertanding denganmu.
Dialogue: 0,0:15:03.42,0:15:06.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kita lihat seberapa jauh dia bisa meladeni Kakanda.\N- Kita lihat seberapa jauh dia bisa meladeni Ray.
Dialogue: 0,0:15:06.93,0:15:07.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm?
Dialogue: 0,0:15:07.80,0:15:10.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian berdua sudah siap?
Dialogue: 0,0:15:10.81,0:15:11.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:15:11.56,0:15:12.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap.
Dialogue: 0,0:15:12.43,0:15:15.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu... pertandingan dimulai!
Dialogue: 0,0:15:20.07,0:15:21.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat sekali!
Dialogue: 0,0:15:25.36,0:15:26.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti yang diharapkan.
Dialogue: 0,0:15:28.95,0:15:30.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu kan...
Dialogue: 0,0:15:30.20,0:15:30.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:15:30.95,0:15:34.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuda-kuda kemenangan Kakanda\Nyang sempurna tanpa celah!
Dialogue: 0,0:15:34.33,0:15:38.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tebasan secepat kilat tak tertandingi\Ndari kuda-kuda itu!
Dialogue: 0,0:15:38.33,0:15:43.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah yang menjadikan Kakanda\Npendekar terkuat di Alferia!
Dialogue: 0,0:15:59.81,0:16:01.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menyerah.
Dialogue: 0,0:16:01.23,0:16:04.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cukup sampai di sini!\NPemenangnya, Ray White!
Dialogue: 0,0:16:05.52,0:16:07.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai diperlihatkan hal seperti ini...
Dialogue: 0,0:16:07.82,0:16:08.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengagumkan.
Dialogue: 0,0:16:09.99,0:16:15.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, sejak awal aku tak punya\Nalasan menentang hubunganmu dan Elisa.
Dialogue: 0,0:16:15.41,0:16:17.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku pamit.
Dialogue: 0,0:16:18.12,0:16:21.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakanda?\NHei, Kakanda!
Dialogue: 0,0:16:28.01,0:16:31.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasukan kami sudah siap.
Dialogue: 0,0:16:31.01,0:16:33.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami siap bergerak kapan saja.
Dialogue: 0,0:16:34.43,0:16:35.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei!
Dialogue: 0,0:16:35.52,0:16:38.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti biasa, minimal jawab aku!
Dialogue: 0,0:16:38.52,0:16:41.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei! Halo?
Dialogue: 0,0:16:41.27,0:16:45.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga, kok jadi buru-buru, sih...
Dialogue: 0,0:16:47.19,0:16:50.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cathy, kamu masih tidak mau mengakui Ray?
Dialogue: 0,0:16:51.78,0:16:54.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar merepotkan, ya.
Dialogue: 0,0:16:55.29,0:16:56.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, benar.
Dialogue: 0,0:16:57.79,0:16:59.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cathy, ya?
Dialogue: 0,0:16:59.54,0:17:02.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat!\NAku sembunyi dulu, ya.
Dialogue: 0,0:17:02.29,0:17:03.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:17:05.96,0:17:06.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:17:09.05,0:17:10.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Clari—
Dialogue: 0,0:17:13.64,0:17:14.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elisa?
Dialogue: 0,0:17:17.06,0:17:18.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elisa?
Dialogue: 0,0:17:40.27,0:17:41.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ray!
Dialogue: 0,0:17:41.33,0:17:42.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Carol?
Dialogue: 0,0:17:43.42,0:17:45.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar, mereka malah panik.
Dialogue: 0,0:17:45.96,0:17:48.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak disangka terpancing semudah ini.
Dialogue: 0,0:17:48.17,0:17:50.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, persiapan mereka\Nmemang telah matang.
Dialogue: 0,0:17:50.97,0:17:54.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya, persis seperti tebakan Guru.
Dialogue: 0,0:17:54.34,0:17:56.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Marius sialan...
Dialogue: 0,0:17:56.22,0:18:01.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah pasti anggota Kerajaan Alferia\Npunya hubungan dengan Eugenics.
Dialogue: 0,0:18:01.45,0:18:05.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, bisa ikut permainan kecilku?
Dialogue: 0,0:18:05.23,0:18:07.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Musuh pasti akan mulai bergerak.
Dialogue: 0,0:18:07.77,0:18:12.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan begitu, tujuan asli\Ndari dalangnya akan terlihat jelas.
Dialogue: 0,0:18:13.95,0:18:16.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata memang kamu dalangnya,
Dialogue: 0,0:18:16.12,0:18:17.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cyril!
Dialogue: 0,0:18:17.37,0:18:20.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malam ini, sejarah negeri ini akan berubah.
Dialogue: 0,0:18:20.50,0:18:23.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita rayakan bersama,
Dialogue: 0,0:18:23.62,0:18:25.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakanda.
Dialogue: 0,0:18:28.88,0:18:30.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tahan!
Dialogue: 0,0:18:30.38,0:18:31.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hadang!
Dialogue: 0,0:18:31.42,0:18:32.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan biarkan lewat!
Dialogue: 0,0:18:32.80,0:18:37.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengar, segera sampaikan situasi ini\Npada Ketujuh Penyihir Agung!
Dialogue: 0,0:18:37.47,0:18:38.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:18:38.35,0:18:41.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tujuan Cyril adalah menahan\Nanggota Keluarga Kerajaan.
Dialogue: 0,0:18:41.14,0:18:42.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan ulurkan waktu.
Dialogue: 0,0:18:42.85,0:18:45.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sisanya kuserahkan padamu, Miriana.
Dialogue: 0,0:18:46.23,0:18:47.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertahankan penghalang.
Dialogue: 0,0:18:50.23,0:18:51.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:18:53.53,0:18:56.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di tengah kota begini aksimu\Nberlebihan, Tukang Bakar!
Dialogue: 0,0:18:56.03,0:18:59.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang,\Naku memperhatikan area sekitar.
Dialogue: 0,0:18:59.24,0:19:01.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah-sudah, nona-nona sekalian.
Dialogue: 0,0:19:01.41,0:19:03.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Selanjutnya giliranku, ya.\N- Ketujuh... Penyihir Agung!
Dialogue: 0,0:19:03.21,0:19:04.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Hati-hati sama bangunannya, ya.\N- Ketujuh... Penyihir Agung!
Dialogue: 0,0:19:04.87,0:19:06.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aman!
Dialogue: 0,0:19:07.25,0:19:08.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elisa!
Dialogue: 0,0:19:10.42,0:19:12.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ray White?
Dialogue: 0,0:19:12.09,0:19:13.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putri Cathy?
Dialogue: 0,0:19:13.67,0:19:15.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya, kalian baik-baik saja?
Dialogue: 0,0:19:16.59,0:19:20.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elisa dan gadis berkucir dua\Ndibawa pergi orang aneh...
Dialogue: 0,0:19:21.35,0:19:25.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, kami tidak bisa melakukan apa-apa.
Dialogue: 0,0:19:25.94,0:19:26.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ray!
Dialogue: 0,0:19:27.69,0:19:29.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang di sini biar kuurus.
Dialogue: 0,0:19:29.27,0:19:30.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pergilah ke kastel kerajaan.
Dialogue: 0,0:19:30.86,0:19:32.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kastel?
Dialogue: 0,0:19:32.07,0:19:34.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini arahannya Mbak Lydia.
Dialogue: 0,0:19:36.85,0:19:38.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya mereka ini apa?
Dialogue: 0,0:19:38.82,0:19:42.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau berani menyerang,\Nakan kuhajar sampai kapok!
Dialogue: 0,0:19:42.04,0:19:44.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maria, tolong jaga Putri Olivia.
Dialogue: 0,0:19:44.16,0:19:45.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:19:45.29,0:19:46.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putri Olivia.
Dialogue: 0,0:19:46.42,0:19:47.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, iya.
Dialogue: 0,0:19:54.30,0:19:55.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rupanya kalian di sini, ya!
Dialogue: 0,0:19:55.63,0:19:56.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm?
Dialogue: 0,0:19:56.59,0:19:58.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian baik-baik saja?
Dialogue: 0,0:19:59.72,0:20:01.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang mesum!
Dialogue: 0,0:20:01.35,0:20:04.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu-Bukan!\NKami habis sauna!
Dialogue: 0,0:20:04.31,0:20:06.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersama kawan-kawan Alferia!
Dialogue: 0,0:20:06.06,0:20:07.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mantap!
Dialogue: 0,0:20:07.98,0:20:09.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya jangan mendekat!
Dialogue: 0,0:20:09.73,0:20:10.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei!
Dialogue: 0,0:20:10.44,0:20:11.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh?\NMaria!
Dialogue: 0,0:20:16.53,0:20:17.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan pada kami!
Dialogue: 0,0:20:17.82,0:20:19.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sembunyilah di suatu tempat!
Dialogue: 0,0:20:20.01,0:20:22.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih... banyak.
Dialogue: 0,0:20:22.33,0:20:25.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, yang tadi itu bukan aku...
Dialogue: 0,0:20:27.50,0:20:31.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalang kudeta ini adalah Cyril,\Nadik Baginda Raja.
Dialogue: 0,0:20:31.42,0:20:35.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Faksi penolak pembukaan negeri\Nbersekongkol dengan Eugenics.
Dialogue: 0,0:20:35.14,0:20:36.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:20:36.34,0:20:39.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, sepertinya ada tujuan lain.
Dialogue: 0,0:20:39.05,0:20:40.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah itu Tanah Suci?
Dialogue: 0,0:20:40.59,0:20:42.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah apa yang ada di sana...
Dialogue: 0,0:20:43.76,0:20:46.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.\NAnda juga, ya,
Dialogue: 0,0:20:46.85,0:20:48.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pangeran Pertama?
Dialogue: 0,0:20:48.19,0:20:49.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:20:49.44,0:20:54.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pilihan keliru yang diambil Ayahanda\Nsebagai Raja harus kuluruskan.
Dialogue: 0,0:20:54.11,0:20:56.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu juga sependapat, kan, Ray?
Dialogue: 0,0:20:57.53,0:21:00.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, Penyihir Pedang Es!
Dialogue: 0,0:21:00.78,0:21:03.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya pikir Anda orang baik.
Dialogue: 0,0:21:03.37,0:21:04.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang!
Dialogue: 0,0:21:04.78,0:21:07.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentunya bagi negeri ini!
Dialogue: 0,0:21:13.46,0:21:14.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Abbie!
Dialogue: 0,0:21:14.88,0:21:17.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ray, percayakan tempat ini padaku.
Dialogue: 0,0:21:18.13,0:21:20.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyihir Api Membara, ya?
Dialogue: 0,0:21:20.13,0:21:22.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang akan meladeninya.
Dialogue: 0,0:21:22.22,0:21:23.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pergi saja.
Dialogue: 0,0:21:23.18,0:21:24.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:21:25.12,0:21:26.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan harap!
Dialogue: 0,0:21:33.09,0:21:35.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar, tak ada habisnya.
Dialogue: 0,0:21:35.32,0:21:38.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa mereka yang duluan menuju kastel\Nbaik-baik saja?
Dialogue: 0,0:21:38.94,0:21:41.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dia, tak perlu dikhawatirkan.
Dialogue: 0,0:21:41.20,0:21:42.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari bergegas!
Dialogue: 0,0:21:42.62,0:21:44.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm?\NApa itu?
Dialogue: 0,0:21:45.62,0:21:49.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf sebesar-besarnya,\Nmohon tidak melangkah lebih jauh.
Dialogue: 0,0:21:51.46,0:21:52.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian siapa?
Dialogue: 0,0:21:52.96,0:21:55.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Julius Orphe.
Dialogue: 0,0:21:55.09,0:21:58.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Izinkan aku menahan kalian,\NKetujuh Penyihir Agung.
Dialogue: 0,0:21:59.17,0:22:01.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, kamu itu "mantan", kan?
Dialogue: 0,0:22:01.99,0:22:04.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mia, menjauh dari sana.
Dialogue: 0,0:22:04.09,0:22:04.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:22:04.97,0:22:07.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perasaan apa ini?
Dialogue: 0,0:22:08.27,0:22:09.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh...
Dialogue: 0,0:22:09.84,0:22:12.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi ini Butterfly Effect, ya.
Dialogue: 0,0:22:12.48,0:22:15.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh.\NTunjukkan lagi padaku,
Dialogue: 0,0:22:15.48,0:22:17.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Amelia Rose.
Dialogue: 0,0:22:19.11,0:22:20.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, wah.
Dialogue: 0,0:22:20.74,0:22:23.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak yang berkumpul di sini, ya.
Dialogue: 0,0:22:25.74,0:22:29.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dark Triad System, aktifkan!
Dialogue: 0,0:22:31.75,0:22:32.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Julius Orphe.
Dialogue: 0,0:22:32.54,0:22:33.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Emma Clark.
Dialogue: 0,0:22:33.25,0:22:33.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cyril!
Dialogue: 0,0:22:33.67,0:22:34.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rald!
Dialogue: 0,0:22:34.33,0:22:35.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini dengan Bianca.
Dialogue: 0,0:22:35.13,0:22:36.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pratinjau dari kami!
Dialogue: 0,0:22:36.75,0:22:38.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Predator pencetus kudeta!
Dialogue: 0,0:22:38.46,0:22:40.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Muncul dari segala arah!
Dialogue: 0,0:22:40.09,0:22:40.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mantap, hebat.
Dialogue: 0,0:22:40.96,0:22:41.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duel.
Dialogue: 0,0:22:41.55,0:22:42.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dimulai dari sini!
Dialogue: 0,0:22:42.63,0:22:43.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Revolusiku!
Dialogue: 0,0:22:43.51,0:22:45.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menarilah sesuka hatimu!
Dialogue: 0,0:22:45.34,0:22:46.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya!
Dialogue: 0,0:22:46.05,0:22:48.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyihir Pedang Es akan Menguasai Dunia...
Dialogue: 0,0:22:48.22,0:22:49.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dua!
Dialogue: 0,0:22:49.64,0:22:51.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sana, di sini, episode tujuh...
Dialogue: 0,0:22:51.98,0:22:54.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Pemuda yang Merupakan\NPenyihir Terkuat di Dunia
Dialogue: 0,0:22:54.56,0:22:56.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyimpan Kuasa Biru dalam Dirinya".
Dialogue: 0,0:23:00.98,0:23:02.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tertolong.
Dialogue: 0,0:23:02.28,0:23:04.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah Anda baik-baik saja, Baginda.
Dialogue: 0,0:23:04.65,0:23:06.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, tapi langsung saja.
Dialogue: 0,0:23:06.49,0:23:08.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Segeralah menuju Tanah Suci.
Dialogue: 0,0:23:08.49,0:23:09.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanah Suci?
Dialogue: 0,0:23:09.53,0:23:12.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cyril dan Elisa pasti di sana.
Dialogue: 0,0:23:13.00,0:23:14.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong hentikan!
Dialogue: 0,0:23:15.33,0:23:17.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mohon, hentikan!
Dialogue: 0,0:23:17.79,0:23:22.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya perintahku cuma\Nmembawa Elisa kemari?
Dialogue: 0,0:23:22.09,0:23:23.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan!
Dialogue: 0,0:23:23.38,0:23:25.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar menyebalkan!
Dialogue: 0,0:23:25.93,0:23:29.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal dia sama sekali tak dibutuhkan!
Dialogue: 0,0:23:29.43,0:23:30.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan!
Dialogue: 0,0:23:31.01,0:23:32.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mohon...
Dialogue: 0,0:23:32.43,0:23:34.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar menyebalkan!
Dialogue: 0,0:23:37.60,0:23:38.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Claris!
Dialogue: 0,0:23:38.94,0:23:40.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elisa! Claris!
Dialogue: 0,0:23:41.44,0:23:42.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Claris!
Dialogue: 0,0:23:50.45,0:23:51.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:23:51.53,0:23:53.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Percuma!
Dialogue: 0,0:23:53.45,0:23:57.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di Tanah Suci, Prima Materia akan ditekan.
Dialogue: 0,0:23:57.21,0:24:00.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Artinya, sihir tak dapat\Nberfungsi dengan baik!
Dialogue: 0,0:24:01.80,0:24:03.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin...
Dialogue: 0,0:24:05.12,0:24:06.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:24:06.37,0:24:07.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya ini?
Dialogue: 0,0:24:07.84,0:24:10.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa sihir bisa digunakan?
