Dialogue: 0,0:03:54.21,0:03:56.09,sign,,0000,0000,0000,,EPISODE 1: PEMUDA YANG MERUPAKAN\NPENYIHIR TERKUAT DI DUNIA
Dialogue: 0,0:03:56.09,0:03:58.01,sign,,0000,0000,0000,,BERPARTISIPASI DALAM\NPERTEMPURAN SIHIR SKALA BESAR
Dialogue: 0,0:23:48.87,0:23:52.12,sign,,0000,0000,0000,,PRATINJAU
Dialogue: 0,0:00:16.79,0:00:19.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nih, teman kalian nambah.
Dialogue: 0,0:00:19.29,0:00:23.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang akur, ya, sampai besok!
Dialogue: 0,0:00:27.76,0:00:30.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, kamu baik-baik saja?
Dialogue: 0,0:00:30.68,0:00:31.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:00:32.29,0:00:34.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:00:35.35,0:00:37.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi dulu, ya.
Dialogue: 0,0:00:37.31,0:00:37.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:00:43.27,0:00:44.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah...
Dialogue: 0,0:00:51.70,0:00:53.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita pergi.
Dialogue: 0,0:00:56.45,0:00:57.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:00:58.96,0:01:00.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yaho!
Dialogue: 0,0:01:06.96,0:01:09.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon tunggu sebentar di sini.
Dialogue: 0,0:01:09.34,0:01:11.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Ah!
Dialogue: 0,0:01:11.84,0:01:13.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat malam.
Dialogue: 0,0:01:13.14,0:01:15.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kamu!
Dialogue: 0,0:01:15.89,0:01:17.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhenti!
Dialogue: 0,0:01:17.56,0:01:18.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mati aku!
Dialogue: 0,0:01:21.48,0:01:23.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih telah menunggu.
Dialogue: 0,0:01:24.40,0:01:25.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita pergi.
Dialogue: 0,0:01:25.90,0:01:27.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baik.
Dialogue: 0,0:01:31.65,0:01:35.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hayo, mau ke mana?
Dialogue: 0,0:01:37.24,0:01:40.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah bagaimana kamu bisa keluar...
Dialogue: 0,0:01:52.13,0:01:55.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih atas jamuannya.\NSekarang sudah aman.
Dialogue: 0,0:02:11.36,0:02:14.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seram sekali! Terima kasih!
Dialogue: 0,0:02:14.28,0:02:18.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak!
Dialogue: 0,0:02:18.62,0:02:20.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih!
Dialogue: 0,0:02:21.37,0:02:24.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon tenang, Tuan Putri Olivia.
Dialogue: 0,0:02:24.79,0:02:27.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Kenapa kamu tahu namaku?
Dialogue: 0,0:02:27.93,0:02:29.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah Anda selamat.
Dialogue: 0,0:02:29.80,0:02:32.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putri Kedua Olivia Arnold.
Dialogue: 0,0:02:32.30,0:02:33.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh?
Dialogue: 0,0:02:33.80,0:02:36.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu... Kamu siapa?
Dialogue: 0,0:02:36.30,0:02:39.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anggota ARTS,\NPasukan Khusus Kerajaan Arnold,
Dialogue: 0,0:02:39.31,0:02:41.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}nama saya Lily.
Dialogue: 0,0:02:45.14,0:02:50.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah pertemuan pertamaku dengan Ray.
Dialogue: 0,0:03:03.83,0:03:06.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku butuh asupan Ray, nih.
Dialogue: 0,0:03:34.11,0:03:35.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selemat pagi, Mas Ray.
Dialogue: 0,0:03:35.61,0:03:36.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat pagi, Elisa.
Dialogue: 0,0:03:36.78,0:03:38.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, kenapa?
Dialogue: 0,0:03:38.36,0:03:41.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, auramu kok terasa berbeda.
Dialogue: 0,0:03:41.62,0:03:42.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya?
Dialogue: 0,0:03:42.87,0:03:45.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku sendiri pangling sama Mas Ray.
Dialogue: 0,0:03:45.50,0:03:46.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa iya?
Dialogue: 0,0:04:06.02,0:04:11.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kejadian tempo hari adalah\Ntindakan mandiri Evan Bernstein?
Dialogue: 0,0:04:11.44,0:04:15.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama tidak ada pergerakan dari Eugenics,
Dialogue: 0,0:04:15.19,0:04:17.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kesimpulan itu masuk akal.
Dialogue: 0,0:04:17.11,0:04:21.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Om-Om Rakus yang jadi kolaboratornya\Nsudah dijebloskan ke penjara khusus.
Dialogue: 0,0:04:22.02,0:04:23.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Evan...
Dialogue: 0,0:04:23.87,0:04:26.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tewas, bukan?
Dialogue: 0,0:04:26.70,0:04:30.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penanganan pasca kejadian\Ntelah diurus oleh pihak Heil.
Dialogue: 0,0:04:32.08,0:04:35.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, Nak Lydia,\Nbagaimana keadaannya?
Dialogue: 0,0:04:35.55,0:04:36.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm?
Dialogue: 0,0:04:36.38,0:04:39.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, dia baik, kok.
Dialogue: 0,0:04:39.30,0:04:41.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menikmati kehidupan akademi\Nbersama kawan-kawannya.
Dialogue: 0,0:04:42.72,0:04:47.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lingkungannya sekarang\Npasti memberikan pengaruh baik padanya.
Dialogue: 0,0:04:48.98,0:04:53.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin lebih cepat dari dugaanku.
Dialogue: 0,0:04:54.82,0:04:56.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, sudah dengar, belum?
Dialogue: 0,0:04:56.19,0:04:57.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang "itu", kan?
Dialogue: 0,0:04:57.53,0:04:59.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudmu soal "itu"-nya Mas White?
Dialogue: 0,0:04:59.61,0:05:00.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:05:01.11,0:05:04.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan itu! Tapi Magicus War!
Dialogue: 0,0:05:04.03,0:05:04.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, itu...
Dialogue: 0,0:05:04.62,0:05:05.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh.
Dialogue: 0,0:05:05.79,0:05:08.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Pertempuran tim baru yang menghilangkan\N- Itu, maksudku, begini...
Dialogue: 0,0:05:08.00,0:05:09.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- batas akademi dan jenjang itu, ya?\N- Yang itu, lo.
Dialogue: 0,0:05:09.47,0:05:10.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- batas akademi dan jenjang itu, ya?\N- Tapi, itu, kan...
Dialogue: 0,0:05:10.50,0:05:14.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Digelar sebelum Festival Nyanyian Suci, kan?
Dialogue: 0,0:05:14.00,0:05:15.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itunya Mas White...
Dialogue: 0,0:05:15.96,0:05:17.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Hei.\N- Hei.
Dialogue: 0,0:05:17.51,0:05:20.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertempuran satu tim\Nberanggotakan tiga orang, kan?
Dialogue: 0,0:05:20.42,0:05:22.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Al pasti ikut, sih.
Dialogue: 0,0:05:22.51,0:05:24.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, tapi, kan...
Dialogue: 0,0:05:24.26,0:05:27.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya aku dan Wisel\Ncuma jadi bebannya Al?
Dialogue: 0,0:05:27.89,0:05:32.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini, ya, kalau seperti itu\Nkita pasti langsung kalah.
Dialogue: 0,0:05:32.69,0:05:34.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, ya.
Dialogue: 0,0:05:34.02,0:05:37.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belakangan ini kan dia sering\Nbergaul sama Mas Evi.
Dialogue: 0,0:05:37.27,0:05:38.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin...
Dialogue: 0,0:05:40.19,0:05:42.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pergaulan dua pria penuh semangat...
Dialogue: 0,0:05:42.61,0:05:43.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hustle!
Dialogue: 0,0:05:43.49,0:05:44.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Muscle!
Dialogue: 0,0:05:45.53,0:05:46.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Woi.
Dialogue: 0,0:05:47.45,0:05:50.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadinya bagaimana?
Dialogue: 0,0:05:50.29,0:05:54.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Amelia kan Raja Baru\Ndi Magicus Chevaliers.
Dialogue: 0,0:05:55.17,0:05:58.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelihatannya dia tidak begitu tertarik.
Dialogue: 0,0:05:58.00,0:05:59.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu, ya.
Dialogue: 0,0:05:59.67,0:06:02.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagian enggak ada alasan\Nbuat ikut turnamen.
Dialogue: 0,0:06:02.63,0:06:04.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:06:08.81,0:06:12.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, menyentuh banget.
Dialogue: 0,0:06:13.60,0:06:18.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Novel romansa karya Luna Ether\Nyang mulai kubaca karena Ray juga baca...
Dialogue: 0,0:06:19.82,0:06:23.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata bisa sampai menusuk hatiku.
Dialogue: 0,0:06:23.32,0:06:24.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh... Rest...
Dialogue: 0,0:06:27.66,0:06:28.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa, ya?
Dialogue: 0,0:06:28.58,0:06:33.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Amelia, mari berpartisipasi\Ndi Magicus War bersamaku!
Dialogue: 0,0:06:34.08,0:06:37.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Amelia, tolong buka pintunya.\NAmelia.
Dialogue: 0,0:06:38.00,0:06:39.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, iya.
Dialogue: 0,0:06:39.50,0:06:44.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Amelia, mau Magicus War bersama kami?
Dialogue: 0,0:06:47.35,0:06:50.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alamak!
Dialogue: 0,0:06:53.18,0:06:55.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paling soal itu, kan?
Dialogue: 0,0:06:56.35,0:06:57.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitulah.
Dialogue: 0,0:06:58.77,0:07:00.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ray sendiri bagaimana?
Dialogue: 0,0:07:00.52,0:07:04.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku perlu berkonsultasi dengan Master,\Ntapi aku berniat untuk ikut.
Dialogue: 0,0:07:04.95,0:07:06.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kondisimu baik, kan?
Dialogue: 0,0:07:06.36,0:07:09.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski cuma pendapat pribadi,\Nrasanya baik-baik saja.
Dialogue: 0,0:07:09.70,0:07:10.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:07:12.79,0:07:16.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, Ray sedang sakit?
Dialogue: 0,0:07:16.87,0:07:18.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei.
Dialogue: 0,0:07:18.88,0:07:23.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mau satu tim,\Nsebaiknya jelaskan padanya juga.
Dialogue: 0,0:07:23.55,0:07:24.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:07:24.97,0:07:27.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memang perlu menjelaskannya dulu.
Dialogue: 0,0:07:27.93,0:07:29.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedang bahas apa?
Dialogue: 0,0:07:29.89,0:07:31.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ariane.
Dialogue: 0,0:07:32.31,0:07:34.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku adalah Penyihir Pedang Es.
Dialogue: 0,0:07:36.06,0:07:37.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:07:37.40,0:07:39.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon tunggu sebentar.
Dialogue: 0,0:07:39.48,0:07:44.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya saya salah dengar,\Napa bisa diulangi lagi?
Dialogue: 0,0:07:44.28,0:07:47.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku adalah salah satu\Ndari Tujuh Penyihir Agung,
Dialogue: 0,0:07:47.32,0:07:49.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sang Penyihir Pedang Es.
Dialogue: 0,0:07:50.20,0:07:52.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah! Amelia?
Dialogue: 0,0:07:53.08,0:07:54.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:07:54.04,0:07:56.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak kapan kamu tahu?
Dialogue: 0,0:07:56.29,0:07:57.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu...
Dialogue: 0,0:07:58.58,0:08:01.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin sebelum Magicus Chevaliers.
Dialogue: 0,0:08:02.59,0:08:03.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Curang...
Dialogue: 0,0:08:03.67,0:08:04.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:08:04.80,0:08:06.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Curang!
Dialogue: 0,0:08:06.34,0:08:06.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:08:06.80,0:08:10.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu Amelia berlatih bersama Ray!
Dialogue: 0,0:08:10.09,0:08:13.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kenapa dan atas dasar apa\Nharus bersama Ray?
Dialogue: 0,0:08:13.14,0:08:15.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu yang selalu mengganjal di pikiranku!
Dialogue: 0,0:08:15.81,0:08:18.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi itu alasannya, ya!
Dialogue: 0,0:08:19.02,0:08:20.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku ulangi...
Dialogue: 0,0:08:21.44,0:08:22.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Curang!
Dialogue: 0,0:08:22.69,0:08:26.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa-bisanya selalu berlatih\Nbersama orang sehebat itu!
Dialogue: 0,0:08:27.70,0:08:30.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu... begini...
Dialogue: 0,0:08:30.36,0:08:31.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:08:33.37,0:08:34.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ariane...\N- Hm?
Dialogue: 0,0:08:34.74,0:08:36.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu memercayaiku?
Dialogue: 0,0:08:37.96,0:08:40.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Segala misterinya jadi terpecahkan.
Dialogue: 0,0:08:40.71,0:08:42.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ariane...
Dialogue: 0,0:08:42.33,0:08:44.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, begitu.
Dialogue: 0,0:08:45.88,0:08:49.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,\Naku akan sedikit bercerita soal masa lalu.
Dialogue: 0,0:08:51.34,0:08:54.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, hei, habis ini bagaimana?\NMau minum dulu?
Dialogue: 0,0:08:54.81,0:08:56.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga...
Dialogue: 0,0:08:56.02,0:08:57.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana, Lydia?
Dialogue: 0,0:08:57.48,0:08:59.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, sesekali boleh, lah.
Dialogue: 0,0:08:59.60,0:09:00.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana, Carla?
Dialogue: 0,0:09:00.81,0:09:02.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu, saya siap menemani.
Dialogue: 0,0:09:02.99,0:09:04.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senior Lydia.
Dialogue: 0,0:09:05.48,0:09:07.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa bicara sebentar?
Dialogue: 0,0:09:07.23,0:09:09.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, kamu juga ikut, kan?
Dialogue: 0,0:09:09.32,0:09:10.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf?
Dialogue: 0,0:09:15.24,0:09:18.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu sekarang, aku berada di sini.
Dialogue: 0,0:09:21.62,0:09:23.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh tak disangka-sangka!
Dialogue: 0,0:09:24.84,0:09:29.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kampanye Militer Timur Jauh\Nadalah perang dengan menggunakan sihir
Dialogue: 0,0:09:29.67,0:09:32.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan kudengar itu adalah\Nperang terburuk yang pernah ada.
Dialogue: 0,0:09:33.68,0:09:37.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berada di garda depan sejak belia...
Dialogue: 0,0:09:40.52,0:09:44.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, aku dipertemukan\Ndengan Master dan kawan-kawannya.
Dialogue: 0,0:09:44.02,0:09:45.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, sekarang aku ada di sini.
Dialogue: 0,0:09:45.77,0:09:50.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu pasca perang itu,\Nkamu mewarisi gelar itu dari Master-mu?
Dialogue: 0,0:09:50.03,0:09:51.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:09:51.11,0:09:54.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski aku belum bisa kerahkan seluruh\Nkemampuanku karena overheat,
Dialogue: 0,0:09:55.45,0:09:58.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku telah mewarisi\Nnama dan gelar ini dari Master.
Dialogue: 0,0:10:00.04,0:10:01.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ray.
Dialogue: 0,0:10:03.54,0:10:05.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari bertanding!
Dialogue: 0,0:10:05.04,0:10:08.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Kenapa?\NKok jadi ke situ?
Dialogue: 0,0:10:08.55,0:10:11.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Amelia, inilah kodrat seorang gadis!
Dialogue: 0,0:10:11.80,0:10:14.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kodrat seorang gadis?
Dialogue: 0,0:10:16.93,0:10:17.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aturannya?
Dialogue: 0,0:10:17.93,0:10:20.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang bilang "menyerah" dia yang kalah.
Dialogue: 0,0:10:21.23,0:10:22.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepakat.
Dialogue: 0,0:10:23.56,0:10:25.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah lama sejak saat itu, ya.
Dialogue: 0,0:10:25.56,0:10:26.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:10:26.94,0:10:30.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, meski situasinya sedikit berbeda.
Dialogue: 0,0:10:31.15,0:10:33.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong jadi wasitnya, Amelia.
Dialogue: 0,0:10:33.70,0:10:34.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:10:34.97,0:10:36.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, yakin, nih?
Dialogue: 0,0:10:36.70,0:10:39.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempo hari, kamu menggunakan kekuatanmu\Npada Kak Rebecca, kan?
Dialogue: 0,0:10:41.20,0:10:42.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:10:42.33,0:10:44.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kali ini aku tak akan\Nmelepaskan kekuatanku.
Dialogue: 0,0:10:44.58,0:10:47.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang bisa menang melawan Ariane?
Dialogue: 0,0:10:47.13,0:10:48.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya...
Dialogue: 0,0:10:48.21,0:10:49.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kucoba saja.
Dialogue: 0,0:10:50.38,0:10:51.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:10:51.84,0:10:52.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dimulai!
Dialogue: 0,0:10:52.84,0:10:53.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ogre!
Dialogue: 0,0:11:04.14,0:11:05.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:11:08.02,0:11:10.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku... menyerah.
Dialogue: 0,0:11:11.78,0:11:13.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu menggunakan semacam sihir khusus?
Dialogue: 0,0:11:13.99,0:11:17.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, aku sekadar memperkuat fisik\Ndengan inside code.
Dialogue: 0,0:11:17.99,0:11:19.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin!
Dialogue: 0,0:11:19.58,0:11:23.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inside code saja mampu melampaui Ogre-ku?
Dialogue: 0,0:11:23.75,0:11:26.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, aku tak berbohong.
Dialogue: 0,0:11:28.13,0:11:31.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi ini kebolehan\NTujuh Penyihir Agung, ya.
Dialogue: 0,0:11:31.42,0:11:35.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski sedang tidak prima,\Nkamu mampu mengalahkanku dengan telak.
Dialogue: 0,0:11:36.01,0:11:36.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ariane.
Dialogue: 0,0:11:36.80,0:11:37.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:11:37.62,0:11:41.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemenangan ini kuraih\Nkarena aku menyadari kelemahanmu.
Dialogue: 0,0:11:41.81,0:11:43.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelemahanku?
Dialogue: 0,0:11:43.68,0:11:46.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih ada ruang bagimu untuk berkembang!
Dialogue: 0,0:11:47.02,0:11:50.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ariane, apa kamu ingin bertambah kuat?
Dialogue: 0,0:11:51.82,0:11:53.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja mau!
Dialogue: 0,0:11:53.36,0:11:54.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tekad yang mantap.
Dialogue: 0,0:11:54.78,0:11:56.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, Ariane Algren!
Dialogue: 0,0:11:57.32,0:12:01.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan memberimu menu pelatihan spesial\Ndi Bootcamp Ala Ainsworth!
Dialogue: 0,0:12:01.28,0:12:03.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menantikannya!
Dialogue: 0,0:12:03.29,0:12:05.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya-Yang benar saja!
Dialogue: 0,0:12:05.12,0:12:08.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}He-Hei, aku kan sudah lulus,\Njadi enggak perlu ikut, kan?
Dialogue: 0,0:12:08.00,0:12:11.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah punya lencana Ranger,\Ncuma buat Ariane, kan?
Dialogue: 0,0:12:11.42,0:12:12.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:12:13.30,0:12:14.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetapi...
Dialogue: 0,0:12:14.34,0:12:16.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Amelia akan kuberi latihan berbeda!
Dialogue: 0,0:12:16.30,0:12:17.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:12:17.42,0:12:21.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daripada aspek fisik,\Nkamu perlu lebih fokus pada aspek sihir.
Dialogue: 0,0:12:21.51,0:12:22.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengar.
Dialogue: 0,0:12:22.39,0:12:25.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk menghadapi Magicus War,\Nkita perlu membentuk fisik dulu.
Dialogue: 0,0:12:25.56,0:12:28.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu satu hal yang paling penting.
Dialogue: 0,0:12:28.06,0:12:29.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jawabnya adalah "Ranger"!
Dialogue: 0,0:12:29.81,0:12:32.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah paham, Sersan Pelatihan Ariane?
Dialogue: 0,0:12:32.86,0:12:35.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ranger!
Dialogue: 0,0:12:35.82,0:12:38.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai besok kita langsung latihan!\NPaham, kan?
Dialogue: 0,0:12:38.70,0:12:40.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ranger!\N- Ranger!
Dialogue: 0,0:12:40.36,0:12:41.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekali lagi!
Dialogue: 0,0:12:41.20,0:12:45.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ranger... Enggak!\N- Eh?
Dialogue: 0,0:12:53.04,0:12:55.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat pagi, Mas Ray.
Dialogue: 0,0:12:56.67,0:12:58.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat pagi, Kak.
Dialogue: 0,0:12:58.59,0:13:00.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak berangkat pagi, ya.
Dialogue: 0,0:13:00.51,0:13:03.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu, karena hari ini jadwal piketku\Nbersama Mas Ray.
Dialogue: 0,0:13:03.93,0:13:05.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kondisimu?
Dialogue: 0,0:13:05.85,0:13:08.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, berkatmu aku baik-baik saja.
Dialogue: 0,0:13:08.73,0:13:11.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga bisa menggunakan\Nsihir tanpa kendala.
Dialogue: 0,0:13:11.10,0:13:12.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah kalau begitu.
Dialogue: 0,0:13:12.77,0:13:17.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu semua berkat sihir\Nyang Mas Ray berikan padaku.
Dialogue: 0,0:13:21.28,0:13:25.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga, kudengar kamu\Nmau berpartisipasi dalam Magicus War, ya?
Dialogue: 0,0:13:25.03,0:13:25.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:13:25.95,0:13:29.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku membentuk tim\Nbersama Amelia dan Ariane.
Dialogue: 0,0:13:31.21,0:13:32.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ada masalah?
Dialogue: 0,0:13:32.88,0:13:35.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mas Ray selalu saja dikelilingi wanita.
Dialogue: 0,0:13:35.50,0:13:36.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa benar?
Dialogue: 0,0:13:36.59,0:13:40.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya ada Evi dan Albert, juga kakak-kakak\Nsenior dari Klub Pengamat Lingkungan.
Dialogue: 0,0:13:41.47,0:13:43.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu beda cerita...
Dialogue: 0,0:13:44.14,0:13:46.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga ingin bersama Mas Ray...
Dialogue: 0,0:13:46.39,0:13:48.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan memaksakan diri dulu.
Dialogue: 0,0:13:48.97,0:13:51.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena aku mencemaskan kondisi Kakak.
Dialogue: 0,0:13:51.52,0:13:53.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cemas, ya?
Dialogue: 0,0:13:54.48,0:13:57.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, aku tak pernah berhenti\Nmemikirkan Kakak.
Dialogue: 0,0:13:57.98,0:13:59.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Deg!
Dialogue: 0,0:13:59.32,0:14:02.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aduh, dasar Mas Ray...
Dialogue: 0,0:14:02.99,0:14:05.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu selalu saja...
Dialogue: 0,0:14:07.33,0:14:08.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mas Ray.
Dialogue: 0,0:14:08.58,0:14:09.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak?
Dialogue: 0,0:14:09.75,0:14:11.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ray!
Dialogue: 0,0:14:11.00,0:14:12.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Amelia.
Dialogue: 0,0:14:12.21,0:14:14.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ternyata kamu memang di sini.\N- Cih.
Dialogue: 0,0:14:14.08,0:14:17.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang mau kubahas soal pelatihan.
Dialogue: 0,0:14:17.00,0:14:18.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:14:18.00,0:14:19.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan ke kelas setelah ini.
Dialogue: 0,0:14:19.55,0:14:21.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, kutunggu, ya.
Dialogue: 0,0:14:21.01,0:14:21.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ehem.
Dialogue: 0,0:14:21.97,0:14:23.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm?
Dialogue: 0,0:14:23.01,0:14:25.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat pagi, Mbak Amelia.
Dialogue: 0,0:14:25.27,0:14:26.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kinokoon!
Dialogue: 0,0:14:26.51,0:14:29.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat pagi, Kak Rebecca.
Dialogue: 0,0:14:29.01,0:14:30.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takepoko, takepoko.
Dialogue: 0,0:14:30.27,0:14:36.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah ini, Mas Ray akan sarapan\Nmesra berdua denganku,
Dialogue: 0,0:14:36.19,0:14:38.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- baru kuserahkan padamu.\N- Beri aku kari!
Dialogue: 0,0:14:38.65,0:14:41.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Oh, mau menyalahgunakan wewenang, ya?\N- Ada hayashi juga, lo.
Dialogue: 0,0:14:41.65,0:14:44.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai Ketua Klub, atau mungkin
Dialogue: 0,0:14:44.11,0:14:46.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebagai Ketua OSIS?
Dialogue: 0,0:14:46.41,0:14:49.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu tidak, mana mungkin aku\Nmenyalahgunakan wewenang?
Dialogue: 0,0:14:49.41,0:14:51.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takepoko, takepoko.
Dialogue: 0,0:14:53.08,0:14:55.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Apa-apaan tekanan ini?\N- Kinokoon, kinokoon!
Dialogue: 0,0:14:55.04,0:14:57.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Lalu, hewan aneh apa itu?\N- Takepoko, takepoko!
Dialogue: 0,0:14:57.17,0:14:58.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ikut sebentar!
Dialogue: 0,0:14:58.29,0:14:59.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:15:02.38,0:15:04.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, ada apa?
Dialogue: 0,0:15:04.05,0:15:05.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mbak Amelia.
Dialogue: 0,0:15:05.05,0:15:06.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya?
Dialogue: 0,0:15:06.89,0:15:08.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari buat kesepakatan.
Dialogue: 0,0:15:09.22,0:15:11.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesepakatan?
Dialogue: 0,0:15:11.68,0:15:13.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku merasa cemas!
Dialogue: 0,0:15:13.68,0:15:16.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal apa?
Dialogue: 0,0:15:16.06,0:15:17.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal Mbak Ariane.
Dialogue: 0,0:15:17.52,0:15:18.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ariane?
Dialogue: 0,0:15:18.69,0:15:20.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan dalih latihan,
Dialogue: 0,0:15:20.48,0:15:24.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia ingin terus bersama Mas Ray\Nsepanjang waktu, kan?
Dialogue: 0,0:15:24.15,0:15:26.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masuk akal juga.
Dialogue: 0,0:15:26.16,0:15:27.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahaya, tahu!
Dialogue: 0,0:15:27.70,0:15:29.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti dia juga suka pada Mas Ray...
Dialogue: 0,0:15:29.66,0:15:31.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, masa?\NEnggak mungkin, sih...
Dialogue: 0,0:15:31.66,0:15:34.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Letakkan tanganmu di dada dan renungkan!
Dialogue: 0,0:15:34.45,0:15:36.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pasti pernah merasakannya!
Dialogue: 0,0:15:38.92,0:15:41.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin hidup di sampingmu!
Dialogue: 0,0:15:41.46,0:15:43.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Amelia! Bangkit!
Dialogue: 0,0:15:43.34,0:15:44.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makan, yuk.
Dialogue: 0,0:15:44.46,0:15:45.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah!
Dialogue: 0,0:15:45.42,0:15:46.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana?
Dialogue: 0,0:15:46.26,0:15:48.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, tapi... enggak mungkin...
Dialogue: 0,0:15:48.72,0:15:52.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sampai buaya darat\Ntidak sadar diri itu
Dialogue: 0,0:15:52.22,0:15:54.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menambah saingan kita!
Dialogue: 0,0:15:55.14,0:15:57.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sepakat, kan?
Dialogue: 0,0:16:04.23,0:16:05.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ray!
Dialogue: 0,0:16:05.03,0:16:07.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu diajak Mbak Ariane, kan?
Dialogue: 0,0:16:07.65,0:16:08.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:16:09.36,0:16:13.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dipikir-pikir, kalian memang klop, ya.
Dialogue: 0,0:16:13.24,0:16:14.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal kepribadian.
Dialogue: 0,0:16:14.54,0:16:16.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Claris kenal Ariane, ya?
Dialogue: 0,0:16:16.50,0:16:19.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, kami sering ketemu\Ndi pestanya bangsawan.
Dialogue: 0,0:16:19.21,0:16:22.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana, ya...\NDia itu membara, ya?
Dialogue: 0,0:16:22.75,0:16:25.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang benar, Ariane memang membara.
Dialogue: 0,0:16:25.26,0:16:26.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di bagian jiwanya.
Dialogue: 0,0:16:26.97,0:16:28.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:16:28.84,0:16:30.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka memang mirip, ya.
Dialogue: 0,0:16:31.26,0:16:33.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi begitu, pantas saja.
Dialogue: 0,0:16:37.39,0:16:38.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi!
Dialogue: 0,0:16:39.69,0:16:42.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang, Mbak Amelia.
Dialogue: 0,0:16:43.02,0:16:43.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:16:45.03,0:16:46.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:16:46.44,0:16:47.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:16:48.74,0:16:50.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Rebecca.
Dialogue: 0,0:16:51.28,0:16:55.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengesahan perjanjian non-agresi\Nselama masa turnamen, ya.
Dialogue: 0,0:16:59.67,0:17:01.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya?
Dialogue: 0,0:17:01.00,0:17:02.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mbak Dina.
Dialogue: 0,0:17:02.04,0:17:03.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baik!
Dialogue: 0,0:17:03.67,0:17:05.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami minta tolong.
Dialogue: 0,0:17:05.55,0:17:07.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya?
Dialogue: 0,0:17:10.18,0:17:11.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kutunggu.
Dialogue: 0,0:17:11.43,0:17:14.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Evi, dan juga Albert.
Dialogue: 0,0:17:14.01,0:17:17.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya kau membentuk tim\Nbersama Amelia dan Nona Ariane, ya?
Dialogue: 0,0:17:17.18,0:17:18.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:17:18.98,0:17:21.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku ingin satu tim denganmu.
Dialogue: 0,0:17:21.19,0:17:22.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, ya.
Dialogue: 0,0:17:22.69,0:17:24.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, aku malah senang.
Dialogue: 0,0:17:24.35,0:17:27.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami ingin coba melawanmu.
Dialogue: 0,0:17:27.34,0:17:28.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti kalian...
Dialogue: 0,0:17:28.69,0:17:31.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, kami juga membentuk tim.
Dialogue: 0,0:17:31.49,0:17:33.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai sekarang kita rival.
Dialogue: 0,0:17:33.45,0:17:35.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu tim tiga orang, kan?
Dialogue: 0,0:17:35.72,0:17:36.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satunya lagi...
Dialogue: 0,0:17:37.73,0:17:39.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nantikan saja tanggal mainnya.
Dialogue: 0,0:17:39.29,0:17:41.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski belum pasti...
Dialogue: 0,0:17:42.17,0:17:43.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, telah kami putuskan.
Dialogue: 0,0:17:43.71,0:17:45.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:17:45.41,0:17:46.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita berjuang.
Dialogue: 0,0:17:47.38,0:17:48.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:17:50.88,0:17:52.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama-sama.
Dialogue: 0,0:17:53.64,0:17:56.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, Ray!\NKamu makin tinggi, ya?
Dialogue: 0,0:17:56.68,0:17:58.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, kok, Master.
Dialogue: 0,0:17:58.22,0:18:00.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu, ya.
Dialogue: 0,0:18:00.14,0:18:01.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, ada apa?
Dialogue: 0,0:18:01.44,0:18:02.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:18:02.29,0:18:03.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya...
Dialogue: 0,0:18:03.23,0:18:05.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Magicus War, kan?
Dialogue: 0,0:18:05.23,0:18:06.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master memang hebat.
Dialogue: 0,0:18:08.23,0:18:09.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa tidak?
Dialogue: 0,0:18:09.48,0:18:11.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Overheat-mu juga makin membaik, kan?
Dialogue: 0,0:18:11.99,0:18:12.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:18:12.78,0:18:13.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:18:13.74,0:18:16.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, putuskan saja sendiri.
Dialogue: 0,0:18:17.95,0:18:19.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong...
Dialogue: 0,0:18:20.58,0:18:21.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hai.
Dialogue: 0,0:18:21.62,0:18:24.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ray White, lama tak jumpa.
Dialogue: 0,0:18:25.58,0:18:27.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mbak Lieselotte.
Dialogue: 0,0:18:27.63,0:18:29.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kebetulan ada yang ingin\Nkubicarakan denganmu.
Dialogue: 0,0:18:29.88,0:18:33.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baru saja aku mau berkonsultasi\Ndengan Senior Lydia.
Dialogue: 0,0:18:33.93,0:18:35.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya mau konsul...
Dialogue: 0,0:18:35.26,0:18:36.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, kebetulan.
Dialogue: 0,0:18:36.85,0:18:37.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Woi.
Dialogue: 0,0:18:38.10,0:18:40.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Jangan mengabaikanku.\N- Aku juga mau konsul.
Dialogue: 0,0:18:45.77,0:18:48.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat pagi, Amelia.
Dialogue: 0,0:18:48.61,0:18:50.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pagi, Ariane.
Dialogue: 0,0:18:52.65,0:18:54.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:18:54.15,0:18:58.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, enggak, bukan apa-apa...
Dialogue: 0,0:18:58.03,0:18:59.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat pagi, Amelia, Ariane!
Dialogue: 0,0:19:01.70,0:19:02.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Datang juga!
Dialogue: 0,0:19:02.91,0:19:05.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat pagi, Ray.
Dialogue: 0,0:19:05.04,0:19:05.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:19:05.92,0:19:08.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu Ray, kan?
Dialogue: 0,0:19:10.13,0:19:10.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke.
Dialogue: 0,0:19:10.88,0:19:11.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:19:11.42,0:19:13.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita mulai dengan lari 20 km.
Dialogue: 0,0:19:13.92,0:19:15.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian sudah siap, kan?
Dialogue: 0,0:19:15.38,0:19:17.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ranger!
Dialogue: 0,0:19:17.05,0:19:18.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang ini masih sama.
Dialogue: 0,0:19:18.80,0:19:21.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sersan Pelatihan Amelia, jawabannya!
Dialogue: 0,0:19:21.64,0:19:22.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ra...
Dialogue: 0,0:19:22.72,0:19:29.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ranger!
Dialogue: 0,0:19:29.19,0:19:31.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ranger...
Dialogue: 0,0:19:33.69,0:19:37.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi ini Bootcamp Ala Ainsworth...
Dialogue: 0,0:19:38.12,0:19:40.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa aku juga kena...
Dialogue: 0,0:19:40.74,0:19:43.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini cuma demonstrasi\Nsebelum pelatihan sesungguhnya.
Dialogue: 0,0:19:44.70,0:19:46.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sersan Pelatihan Amelia,
Dialogue: 0,0:19:46.42,0:19:50.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mulai pekan depan, akan kuberi\Npelatihan khusus selama dua pekan.
Dialogue: 0,0:19:52.42,0:19:53.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini apa?
Dialogue: 0,0:19:53.59,0:19:55.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke sana dan kamu akan tahu.
Dialogue: 0,0:19:55.26,0:19:57.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat kembali dari sana nanti,
Dialogue: 0,0:19:57.22,0:20:01.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu pasti membawa hasil berupa\Nkemampuan sihirmu yang meningkat pesat.
Dialogue: 0,0:20:01.10,0:20:04.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sersan Pelatihan Ariane\Nakan berlatih sambil menginap di rumahku.
Dialogue: 0,0:20:04.52,0:20:06.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Eh?\N- Ranger!
Dialogue: 0,0:20:06.35,0:20:07.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:20:07.77,0:20:09.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu dulu!
Dialogue: 0,0:20:09.35,0:20:10.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:20:10.36,0:20:12.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga ikut ke rumahnya Ray!
Dialogue: 0,0:20:12.82,0:20:15.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, yang kamu perlukan\Nadalah pelatihan sihir.
Dialogue: 0,0:20:15.36,0:20:18.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, di sana kami hanya fokus\Ndalam pelatihan fisik.
Dialogue: 0,0:20:19.95,0:20:21.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ariane!
Dialogue: 0,0:20:21.07,0:20:21.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya?
Dialogue: 0,0:20:21.83,0:20:22.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ikut bentar!
Dialogue: 0,0:20:22.95,0:20:25.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ray tetap di sana!\N- Hei...
Dialogue: 0,0:20:25.00,0:20:27.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon pelan-pelan, ya.
Dialogue: 0,0:20:30.00,0:20:32.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atas, atas, bawah, bawah,\Nkiri, kanan, kiri, kanan.
Dialogue: 0,0:20:32.88,0:20:33.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh...
Dialogue: 0,0:20:33.88,0:20:35.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ray.
Dialogue: 0,0:20:35.01,0:20:37.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya aku setuju.
Dialogue: 0,0:20:37.26,0:20:39.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.\NBaguslah kalau begitu.
Dialogue: 0,0:20:39.97,0:20:41.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau boleh tahu, kalian bahas apa?
Dialogue: 0,0:20:44.08,0:20:46.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tidak perlu pikirkan kami.\N- Iya, iya.
Dialogue: 0,0:20:50.06,0:20:52.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini perlu dicatat!
Dialogue: 0,0:20:53.77,0:20:55.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa katamu?
Dialogue: 0,0:20:55.40,0:20:58.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya mulai pekan depan.
Dialogue: 0,0:21:00.07,0:21:04.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sulit dipercaya, sungguh tidak sadar diri.
Dialogue: 0,0:21:04.16,0:21:06.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga tidak terjadi apa-apa.
Dialogue: 0,0:21:06.54,0:21:08.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti terjadi, sih.
Dialogue: 0,0:21:20.18,0:21:22.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia ada di dalam sana, ya.
Dialogue: 0,0:21:22.34,0:21:23.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo.
Dialogue: 0,0:21:27.85,0:21:29.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah datang, ya.
Dialogue: 0,0:21:31.44,0:21:33.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf menunggu lama.
Dialogue: 0,0:21:34.81,0:21:36.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita berangkat, Ariane!
Dialogue: 0,0:21:37.65,0:21:38.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:21:43.95,0:21:46.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ariane, begitu melewatinya kita akan sampai!
Dialogue: 0,0:21:47.87,0:21:49.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik...
Dialogue: 0,0:21:52.04,0:21:53.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ray, ada apa?
Dialogue: 0,0:22:05.97,0:22:07.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jeduar!
Dialogue: 0,0:22:07.47,0:22:08.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ray?
Dialogue: 0,0:22:12.23,0:22:13.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak cewek?
Dialogue: 0,0:22:13.48,0:22:15.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lama tak jumpa, Stella.
Dialogue: 0,0:22:15.31,0:22:16.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu makin tinggi, ya?
Dialogue: 0,0:22:17.82,0:22:19.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma sedikit, sih.
Dialogue: 0,0:22:19.48,0:22:21.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Abang?
Dialogue: 0,0:22:21.07,0:22:22.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tinggiku masih sama.
Dialogue: 0,0:22:22.70,0:22:24.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Abang?
Dialogue: 0,0:22:24.24,0:22:26.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ariane, perkenalkan.
Dialogue: 0,0:22:26.99,0:22:28.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Stella White.
Dialogue: 0,0:22:28.54,0:22:30.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku adiknya Abang.
Dialogue: 0,0:22:30.33,0:22:32.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Abang?
Dialogue: 0,0:22:32.25,0:22:34.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Adik cewek?
Dialogue: 0,0:23:48.87,0:23:49.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan Rebecca.
Dialogue: 0,0:23:49.57,0:23:50.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama Amelia.
Dialogue: 0,0:23:50.41,0:23:51.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Juga Dina.
Dialogue: 0,0:23:51.24,0:23:52.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pratinjau!
Dialogue: 0,0:23:52.12,0:23:53.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk mempersiapkan Magicus War...
Dialogue: 0,0:23:53.62,0:23:55.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masing-masing peserta mulai berlatih!
Dialogue: 0,0:23:55.54,0:23:57.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di kedalaman hutan mana?
Dialogue: 0,0:23:57.46,0:23:58.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di kedalaman Hutan Dogma!
Dialogue: 0,0:23:58.88,0:24:00.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia kembali muncul!
Dialogue: 0,0:24:00.75,0:24:02.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus bagaimana?
Dialogue: 0,0:24:02.42,0:24:05.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Episode selanjutnya,\NPenyihir Pedang Es akan Menguasai Dunia...
Dialogue: 0,0:24:05.42,0:24:06.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dua!
Dialogue: 0,0:24:07.26,0:24:09.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Episode dua yang penuh pelatihan bertajuk...
Dialogue: 0,0:24:09.30,0:24:12.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Pemuda yang Merupakan Penyihir Terkuat\Ndi Dunia Memakai Topengnya...
Dialogue: 0,0:24:12.72,0:24:13.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi?"
