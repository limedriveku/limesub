Dialogue: 0,0:03:44.50,0:03:48.79,sign,,0000,0000,0000,,PENYIHIR PEDANG ES\NAKAN MENGUASAI DUNIA SEASON 2
Dialogue: 0,0:03:49.21,0:03:51.67,sign,,0000,0000,0000,,EPISODE 7: PEMUDA YANG MERUPAKAN\NPENYIHIR TERKUAT DI DUNIA
Dialogue: 0,0:03:51.67,0:03:53.00,sign,,0000,0000,0000,,MENYIMPAN KUASA BIRU DALAM DIRINYA
Dialogue: 0,0:23:48.74,0:23:55.41,sign,,0000,0000,0000,,PRATINJAU
Dialogue: 0,0:00:02.23,0:00:05.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke-Kenapa kamu bisa menggunakan sihir?
Dialogue: 0,0:00:14.49,0:00:16.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan membunuhmu.
Dialogue: 0,0:00:16.37,0:00:19.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kamu harus menerima\Nganjaran yang setimpal.
Dialogue: 0,0:00:22.96,0:00:25.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihirku... tidak stabil...
Dialogue: 0,0:00:36.33,0:00:39.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hidupku akan berakhir sedini ini...
Dialogue: 0,0:00:39.77,0:00:43.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}He-Hei!\NApa tidak ada solusi, Carol?
Dialogue: 0,0:00:43.23,0:00:44.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm...
Dialogue: 0,0:00:44.61,0:00:47.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa sebaiknya sekarang saja?
Dialogue: 0,0:00:47.07,0:00:51.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, mau bagaimana lagi, kan?\NHarus kulakukan, bukan?
Dialogue: 0,0:00:51.32,0:00:53.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya sudah waktunya...
Dialogue: 0,0:00:55.03,0:00:56.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh, kan?
Dialogue: 0,0:00:56.20,0:00:57.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:00:57.16,0:00:58.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke.
Dialogue: 0,0:00:58.20,0:01:01.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, kita mulai!
Dialogue: 0,0:01:02.96,0:01:07.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Carol in Wonder Underground!
Dialogue: 0,0:01:12.59,0:01:16.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian sudah siap, Alferia?
Dialogue: 0,0:01:16.10,0:01:18.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersorak!
Dialogue: 0,0:01:21.10,0:01:23.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita ini sedang apa?
Dialogue: 0,0:01:23.10,0:01:25.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, ayo mulai!
Dialogue: 0,0:01:25.36,0:01:26.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Compression!
Dialogue: 0,0:01:27.27,0:01:29.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lesatkan hati yang dipadatkan!
Dialogue: 0,0:01:38.11,0:01:42.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Adik-adik di rumah, lagunya Kyaro-Kyaro\Ndidengarkan nanti saja, ya.
Dialogue: 0,0:01:42.67,0:01:43.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kyapin!
Dialogue: 0,0:01:47.02,0:01:48.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana?
Dialogue: 0,0:01:48.38,0:01:51.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dark Triad System-ku ini?
Dialogue: 0,0:01:53.41,0:01:59.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi begitulah, api bisa dipadamkan\Ndengan api yang lebih dahsyat.
Dialogue: 0,0:01:59.85,0:02:01.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Igni Melk.
Dialogue: 0,0:02:06.52,0:02:09.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa?
Dialogue: 0,0:02:09.19,0:02:11.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, lumayan.
Dialogue: 0,0:02:11.28,0:02:14.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, esensi sihirku adalah akselerasi.
Dialogue: 0,0:02:15.03,0:02:17.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Api hanyalah sampingan.
Dialogue: 0,0:02:18.67,0:02:21.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin...
Dialogue: 0,0:02:22.54,0:02:25.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidurlah di sana dulu.
Dialogue: 0,0:03:33.11,0:03:34.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alferia...
Dialogue: 0,0:03:34.44,0:03:36.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kami lindungi!
Dialogue: 0,0:03:36.20,0:03:39.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka berdua...\NSerius, mending buruan pakai bajunya.
Dialogue: 0,0:04:04.52,0:04:06.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Konstruksi code-nya terlalu cepat!
Dialogue: 0,0:04:06.81,0:04:08.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya ini?
Dialogue: 0,0:04:09.02,0:04:10.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lambat sekali.
Dialogue: 0,0:04:13.91,0:04:14.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Lydia!
Dialogue: 0,0:04:19.11,0:04:22.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namanya juga "mantan"\NKetujuh Penyihir Agung.
Dialogue: 0,0:04:23.03,0:04:25.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu telah turun dari panggung.
Dialogue: 0,0:04:45.09,0:04:46.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah berakhir, ya?
Dialogue: 0,0:04:51.35,0:04:53.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai dari sini...
Dialogue: 0,0:04:55.11,0:04:57.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akulah lawanmu.
Dialogue: 0,0:04:59.15,0:05:00.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anda adalah...
Dialogue: 0,0:05:00.66,0:05:01.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan...
Dialogue: 0,0:05:02.19,0:05:07.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang disebut tertinggi dan terkuat\Ndi antara Ketujuh Penyihir Agung...
Dialogue: 0,0:05:07.08,0:05:09.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyihir Gemilang?
Dialogue: 0,0:05:09.62,0:05:11.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Marius Basset?
Dialogue: 0,0:05:11.75,0:05:14.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cih, jadi kamu datang kemari, ya.
Dialogue: 0,0:05:14.75,0:05:19.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, aku tidak akan membiarkanmu\Nterus bertindak sesuka hati.
Dialogue: 0,0:05:19.26,0:05:21.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, sayang sekali.
Dialogue: 0,0:05:21.55,0:05:22.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, bukan masalah.
Dialogue: 0,0:05:22.87,0:05:26.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gerbang pembebasan sihir\Nsudah mulai terbuka.
Dialogue: 0,0:05:26.01,0:05:27.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:05:27.35,0:05:31.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alasan kalian berani menyerang\Nmeski ada kekuatan tempur sebesar ini...
Dialogue: 0,0:05:31.02,0:05:33.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk memanfaatkan rencana itu, ya?
Dialogue: 0,0:05:34.07,0:05:36.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rupanya kamu ada di pihak\Nyang mengerti, ya?
Dialogue: 0,0:05:36.77,0:05:41.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru karena berkumpul,\Nfluktuasi pun tercipta di sini.
Dialogue: 0,0:05:41.86,0:05:43.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengamatannya sudah selesai.
Dialogue: 0,0:05:43.78,0:05:46.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daya tangkalnya masih berfungsi.
Dialogue: 0,0:05:46.16,0:05:47.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:05:47.54,0:05:51.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, begitu melampauinya,\Ndunia baru telah menanti kita.
Dialogue: 0,0:05:51.83,0:05:53.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pikir aku akan membiarkanmu?
Dialogue: 0,0:05:53.27,0:05:56.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayang sekali,\Naku sudah tidak ada di sini lagi.
Dialogue: 0,0:05:57.55,0:06:00.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyihir Gemilang dan Amelia Rose.
Dialogue: 0,0:06:00.17,0:06:02.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai jumpa lagi.
Dialogue: 0,0:06:04.19,0:06:05.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian baik-baik saja?
Dialogue: 0,0:06:05.72,0:06:08.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya!\NTerima kasih banyak.
Dialogue: 0,0:06:08.81,0:06:12.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan masalah.\NYang penting kalian selamat.
Dialogue: 0,0:06:12.56,0:06:14.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah! Ray bagaimana?
Dialogue: 0,0:06:14.06,0:06:15.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia baik-baik saja.
Dialogue: 0,0:06:15.19,0:06:19.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena yang di sana pun\Npasti akan segera selesai.
Dialogue: 0,0:06:24.49,0:06:27.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu apa yang sedang kamu pikirkan.
Dialogue: 0,0:06:27.20,0:06:30.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa aku berani berhadapan\Nlangsung dengan Pedang Es?
Dialogue: 0,0:06:30.83,0:06:35.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau melihat dari kemampuan,\Nsejak awal aku bukanlah tandinganmu.
Dialogue: 0,0:06:35.08,0:06:37.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau menyadarinya, segera menyerah.
Dialogue: 0,0:06:37.42,0:06:39.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau itu mustahil!
Dialogue: 0,0:06:39.34,0:06:44.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di Tanah Suci ini tersembunyi\Njalan menuju sihir sejati.
Dialogue: 0,0:06:44.57,0:06:48.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pembebasan sihir.\NKamu pikir itu benar-benar bisa diwujudkan?
Dialogue: 0,0:06:48.85,0:06:53.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu tak pernah terpikir\Nbahwa seluruh dunia ini adalah kepalsuan?
Dialogue: 0,0:06:53.35,0:06:54.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dunia ini bukan kepalsuan.
Dialogue: 0,0:06:54.77,0:06:55.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:06:56.10,0:06:57.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pembebasan sihir...
Dialogue: 0,0:06:57.67,0:07:01.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang menanti di baliknya\Nadalah neraka itu sendiri.
Dialogue: 0,0:07:04.61,0:07:09.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski itu benar, aku tak akan\Nberhenti melangkah maju!
Dialogue: 0,0:07:09.12,0:07:12.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Penyihir Pedang Es Akan Menguasai Dunia"!
Dialogue: 0,0:07:12.70,0:07:16.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kubunuh kamu yang jadi daya tangkalnya\Ndan membebaskan Tanah Suci ini...
Dialogue: 0,0:07:16.96,0:07:19.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan memanfaatkan gadis itu!
Dialogue: 0,0:07:19.21,0:07:20.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu...
Dialogue: 0,0:07:20.71,0:07:26.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elf dan Manusia, dia yang memiliki\Nengram keduanya sangat berharga.
Dialogue: 0,0:07:27.26,0:07:31.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya sihir rahasia Elf\Ndiwariskan padanya.
Dialogue: 0,0:07:31.22,0:07:35.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena telah kupastikan bahwa keluarga\Nkerajaan lain tidak mewarisinya!
Dialogue: 0,0:07:35.48,0:07:38.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon, Claris...
Dialogue: 0,0:07:41.02,0:07:45.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku perlu membuat Elisa beradaptasi\Ndengan Prima Materia di tempat ini
Dialogue: 0,0:07:45.11,0:07:47.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan memicu kebangkitannya.
Dialogue: 0,0:07:47.49,0:07:50.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah semuanya siap,\Ntinggal kamu, Pedang Es.
Dialogue: 0,0:07:50.83,0:07:53.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya perlu membunuhmu\Nyang menjadi penghalang.
Dialogue: 0,0:07:53.54,0:07:58.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Domain baru sihirku, dan aku bisa\Nmenjajalnya langsung padamu!
Dialogue: 0,0:07:58.83,0:08:01.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada yang lebih mendebarkan dari ini!
Dialogue: 0,0:08:03.05,0:08:05.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, mari kita mulai dengan ini!
Dialogue: 0,0:08:19.94,0:08:22.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm, begini saja belum mempan, ya?
Dialogue: 0,0:08:22.61,0:08:24.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:08:28.40,0:08:30.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang Es memang hebat.
Dialogue: 0,0:08:30.66,0:08:35.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak kusangka kamu bisa meniadakan\Nsemua serangan dahsyat itu.
Dialogue: 0,0:08:36.00,0:08:39.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanpa kekuatan setingkat\NKetujuh Penyihir Agung,
Dialogue: 0,0:08:39.08,0:08:42.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mustahil bisa menggunakan seluruh\Natribut sihir di level setingkat ini.
Dialogue: 0,0:08:42.91,0:08:44.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan...
Dialogue: 0,0:08:44.00,0:08:47.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang Es memang hebat.\NKamu menyadarinya, ya.
Dialogue: 0,0:08:47.21,0:08:50.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang terukir pada tubuhmu adalah engram!
Dialogue: 0,0:08:50.01,0:08:52.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun itu bukan milikmu!
Dialogue: 0,0:08:52.39,0:08:57.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, ini adalah tumpukan engram\Norang lain yang dilapis berkali-kali.
Dialogue: 0,0:08:57.73,0:09:00.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu tak sekadar ditumpuk begitu saja.
Dialogue: 0,0:09:00.52,0:09:05.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus menyeleksi\Nmana yang cocok dengan tubuhku.
Dialogue: 0,0:09:06.48,0:09:09.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, sudah berapa banyak\Norang yang kamu korbankan?
Dialogue: 0,0:09:09.53,0:09:12.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Korban?\NAku tidak ingat.
Dialogue: 0,0:09:12.78,0:09:17.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih tepatnya, ini semua\Ndisediakan oleh Eugenics!
Dialogue: 0,0:09:17.11,0:09:19.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi bukan urusanku!
Dialogue: 0,0:09:19.79,0:09:24.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Segala tindakan pemenang akan dibenarkan.\NItulah hakikat dari pertempuran, kan?
Dialogue: 0,0:09:24.42,0:09:27.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama seperti apa yang kamu lakukan\Ndi Perang Timur Jauh...
Dialogue: 0,0:09:27.55,0:09:32.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru karena kamu pembantai massal,\Nsegalanya dibenarkan!
Dialogue: 0,0:09:38.56,0:09:40.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}E-Elisa...
Dialogue: 0,0:09:40.43,0:09:42.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Claris, jangan bicara dulu!
Dialogue: 0,0:09:42.56,0:09:45.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elisa... kamu baik-baik saja?
Dialogue: 0,0:09:45.61,0:09:47.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baik-baik saja.
Dialogue: 0,0:09:47.44,0:09:49.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, Claris...
Dialogue: 0,0:09:49.28,0:09:50.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu...
Dialogue: 0,0:09:51.20,0:09:52.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah...
Dialogue: 0,0:09:52.61,0:09:56.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah, kamu tidak terluka sedikit pun...
Dialogue: 0,0:09:57.25,0:10:00.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu melindungiku?
Dialogue: 0,0:10:00.62,0:10:03.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:10:04.54,0:10:05.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya
Dialogue: 0,0:10:06.26,0:10:08.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita ini sahabat.
Dialogue: 0,0:10:10.63,0:10:14.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski dari keluarga kerajaan,\NElisa tetap Elisa.
Dialogue: 0,0:10:15.18,0:10:17.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita ini sahabat.
Dialogue: 0,0:10:20.39,0:10:21.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:10:22.13,0:10:24.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu selalu berada di sisiku.
Dialogue: 0,0:10:29.61,0:10:35.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elisa, jangan menangis.\NAku baik-baik saja...
Dialogue: 0,0:10:36.16,0:10:37.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang giliranku.
Dialogue: 0,0:10:37.99,0:10:38.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elisa...
Dialogue: 0,0:10:38.99,0:10:40.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Claris.
Dialogue: 0,0:10:40.62,0:10:43.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan berjuang!
Dialogue: 0,0:10:47.27,0:10:49.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harusnya kamu yang paling tahu!
Dialogue: 0,0:10:49.13,0:10:52.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahwa tanganmu berlumur noda!
Dialogue: 0,0:10:53.38,0:10:54.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak menyangkalnya.
Dialogue: 0,0:10:55.34,0:10:58.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa laluku memang berlumuran darah.
Dialogue: 0,0:10:58.05,0:11:01.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, sekarang aku tak berniat\Nmenempuh jalan yang sama lagi!
Dialogue: 0,0:11:02.24,0:11:04.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh! Boleh!
Dialogue: 0,0:11:04.77,0:11:08.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang akan kuakhiri riwayatmu!
Dialogue: 0,0:11:13.53,0:11:15.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anti-Material Code?
Dialogue: 0,0:11:16.41,0:11:17.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya adalah ini!
Dialogue: 0,0:11:17.91,0:11:20.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terkaget-kagetlah!
Dialogue: 0,0:11:27.04,0:11:27.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:11:28.87,0:11:29.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elisa?
Dialogue: 0,0:11:30.79,0:11:33.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menjadi kekuatanmu, Ray.
Dialogue: 0,0:11:35.01,0:11:37.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya apa yang bisa kamu lakukan?
Dialogue: 0,0:11:37.64,0:11:39.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Apa ini?
Dialogue: 0,0:11:41.12,0:11:43.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alfheim Circle!
Dialogue: 0,0:11:53.94,0:11:55.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sialan...
Dialogue: 0,0:11:55.78,0:11:56.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh...
Dialogue: 0,0:11:57.61,0:11:58.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:11:59.28,0:12:03.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Chronos Lock milik Ray White\Nmulai terlepas,
Dialogue: 0,0:12:03.26,0:12:05.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kutukanmu pun...
Dialogue: 0,0:12:05.37,0:12:07.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sialan, bersiaplah!
Dialogue: 0,0:12:08.37,0:12:11.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ora! Rasakan!
Dialogue: 0,0:12:23.06,0:12:24.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Lydia!
Dialogue: 0,0:12:26.17,0:12:28.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengejutkan sekali.
Dialogue: 0,0:12:30.40,0:12:34.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski sudah melemah,\Nkamu tetaplah Mantan Pedang Es, ya.
Dialogue: 0,0:12:35.03,0:12:38.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menarik sekali, Lydia Ainsworth.
Dialogue: 0,0:12:39.03,0:12:39.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Emma.
Dialogue: 0,0:12:41.03,0:12:42.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita sudah boleh kembali.
Dialogue: 0,0:12:44.03,0:12:47.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, kami undur diri.
Dialogue: 0,0:12:50.19,0:12:51.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Lydia!
Dialogue: 0,0:12:52.50,0:12:55.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Lydia, Anda baik-baik saja?
Dialogue: 0,0:12:55.05,0:12:56.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sialan!
Dialogue: 0,0:12:56.66,0:12:59.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lain kali, aku akan menghajarnya!
Dialogue: 0,0:13:05.06,0:13:08.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata kamu memang mewarisinya!
Dialogue: 0,0:13:09.06,0:13:12.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Domain yang menyerap Prima Materia
Dialogue: 0,0:13:12.56,0:13:15.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan domain yang memancarkannya.
Dialogue: 0,0:13:16.07,0:13:17.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini...
Dialogue: 0,0:13:17.36,0:13:19.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar!
Dialogue: 0,0:13:19.07,0:13:23.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengendalikan Prima Materia secara leluasa\Ndi dalam kedua domain tersebut.
Dialogue: 0,0:13:23.53,0:13:27.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Origin yang diwariskan pada\NKeluarga Kerajaan Alferia.
Dialogue: 0,0:13:27.33,0:13:29.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alfheim Circle!
Dialogue: 0,0:13:29.87,0:13:31.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan adanya kekuatan itu...
Dialogue: 0,0:13:31.83,0:13:35.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa menundukkan segalanya\Ndengan kekuatan!
Dialogue: 0,0:13:35.84,0:13:39.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Engram-mu itu akan kupatri dalam tubuhku,
Dialogue: 0,0:13:39.92,0:13:42.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elisa!
Dialogue: 0,0:13:42.97,0:13:43.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:13:47.37,0:13:48.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ceroboh sekali.
Dialogue: 0,0:13:48.72,0:13:51.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Prima Materia-ku!
Dialogue: 0,0:13:53.23,0:13:54.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ray!
Dialogue: 0,0:13:54.73,0:13:56.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang Es-mu!
Dialogue: 0,0:13:58.73,0:14:00.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tu-Tunggu!
Dialogue: 0,0:14:00.90,0:14:02.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Ini...
Dialogue: 0,0:14:02.40,0:14:05.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan kekuatan yang boleh\Ndiarahkan ke orang!
Dialogue: 0,0:14:05.24,0:14:08.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan mati!
Dialogue: 0,0:14:08.16,0:14:10.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan!
Dialogue: 0,0:14:11.25,0:14:13.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong hentikan, kumohon!
Dialogue: 0,0:14:13.75,0:14:15.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu itu, aku juga...
Dialogue: 0,0:14:15.33,0:14:18.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memohon padamu agar berhenti, kan?
Dialogue: 0,0:14:18.25,0:14:21.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maaf, waktu itu aku berbuat salah...
Dialogue: 0,0:14:21.34,0:14:24.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu lupa perbuatanmu pada Claris?
Dialogue: 0,0:14:25.02,0:14:28.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku masih ingat.
Dialogue: 0,0:14:29.16,0:14:31.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sialan!
Dialogue: 0,0:14:33.14,0:14:37.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anti-Material Code!
Dialogue: 0,0:14:37.36,0:14:39.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke...
Dialogue: 0,0:14:39.53,0:14:41.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:14:41.28,0:14:45.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya ini kekuatan yang mahakuasa?
Dialogue: 0,0:14:45.03,0:14:47.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di dunia ini, tidak ada\Nyang namanya mahakuasa.
Dialogue: 0,0:14:48.41,0:14:50.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ray dan aku...
Dialogue: 0,0:14:50.54,0:14:52.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serta engram
Dialogue: 0,0:14:52.54,0:14:55.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}milik para penyihir yang telah kamu rampas.
Dialogue: 0,0:14:55.29,0:14:59.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang es yang terbentuk dari massa\Nyang luar biasa ini mustahil diuraikan.
Dialogue: 0,0:15:00.71,0:15:02.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pandora.
Dialogue: 0,0:15:02.80,0:15:04.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penjara Es Nirbatas.
Dialogue: 0,0:15:18.06,0:15:19.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ray.
Dialogue: 0,0:15:20.57,0:15:24.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku sudah berguna?
Dialogue: 0,0:15:24.07,0:15:25.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:15:25.24,0:15:29.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku sudah mampu\Nberjuang demi sahabatku?
Dialogue: 0,0:15:29.74,0:15:30.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:15:34.25,0:15:36.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya aku ketakutan.
Dialogue: 0,0:15:36.08,0:15:41.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, karena selalu disemangati,\Naku jadi ingin terus berusaha.
Dialogue: 0,0:15:41.09,0:15:41.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:15:42.34,0:15:44.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, hei...
Dialogue: 0,0:15:44.34,0:15:46.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian tidak melupakanku, kan?
Dialogue: 0,0:15:46.84,0:15:48.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar...
Dialogue: 0,0:15:48.34,0:15:50.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Claris!
Dialogue: 0,0:15:50.10,0:15:54.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elisa, tangisanmu terlalu kencang...
Dialogue: 0,0:15:54.60,0:15:56.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Habisnya...
Dialogue: 0,0:15:56.60,0:16:00.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang aku baik-baik saja, kan?
Dialogue: 0,0:16:07.03,0:16:10.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku merasa sangat bersalah\Natas kejadian ini.
Dialogue: 0,0:16:10.37,0:16:12.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, Anda tidak perlu...
Dialogue: 0,0:16:12.03,0:16:16.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena dia adikku, aku terlalu yakin\Nbahwa kami bisa saling memahami.
Dialogue: 0,0:16:16.96,0:16:20.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenaifanku ini yang memicu insiden ini.
Dialogue: 0,0:16:21.29,0:16:24.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sungguh malu.
Dialogue: 0,0:16:24.00,0:16:27.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak. Syukurlah tidak sampai\Nmenimbulkan korban banyak.
Dialogue: 0,0:16:27.26,0:16:28.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:16:28.63,0:16:32.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya berkatmu dan kawan-kawanmu.
Dialogue: 0,0:16:32.72,0:16:35.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para dalang yang sedang ditahan\Ndi penjara bawah tanah
Dialogue: 0,0:16:35.86,0:16:38.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan kami interogasi lebih lanjut.
Dialogue: 0,0:16:38.89,0:16:39.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:16:41.06,0:16:44.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sikap Anda yang berusaha saling memahami,\Nmenurut saya sangatlah terpuji.
Dialogue: 0,0:16:45.07,0:16:48.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah mendengar ucapanmu,\Naku merasa sedikit lega.
Dialogue: 0,0:16:48.74,0:16:52.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, sepertinya putriku\Ningin meminta maaf padamu.
Dialogue: 0,0:16:52.91,0:16:54.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, begini...
Dialogue: 0,0:16:54.91,0:16:59.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar kamu yang meredam\Nkekacauan ini...
Dialogue: 0,0:16:59.92,0:17:02.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, begini...
Dialogue: 0,0:17:02.42,0:17:05.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maaf atas perbuatanku selama ini!
Dialogue: 0,0:17:05.05,0:17:05.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:17:05.92,0:17:09.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sosok pemberani\Nyang layak bersanding dengan Elisa!
Dialogue: 0,0:17:09.51,0:17:10.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:17:10.93,0:17:13.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sekadar melakukan hal yang seharusnya.
Dialogue: 0,0:17:13.80,0:17:15.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm?
Dialogue: 0,0:17:15.76,0:17:18.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dilihat lebih dekat,\Nwajah imut polosnya masih ada,
Dialogue: 0,0:17:18.89,0:17:23.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi sorot matanya tampak gagah...\NJadi, intinya dia...
Dialogue: 0,0:17:23.94,0:17:25.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ganteng?
Dialogue: 0,0:17:25.60,0:17:27.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm, ada apa?
Dialogue: 0,0:17:27.40,0:17:31.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah! Ti-Tidak, bukan apa-apa!
Dialogue: 0,0:17:31.11,0:17:35.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya, terima kasih.
Dialogue: 0,0:17:35.08,0:17:38.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau main ke sini nanti,\Nakan kusambut dengan baik.
Dialogue: 0,0:17:38.58,0:17:42.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.\NDia memang agak pemalu.
Dialogue: 0,0:17:42.37,0:17:43.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.
Dialogue: 0,0:17:43.29,0:17:45.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, dan juga...
Dialogue: 0,0:17:45.59,0:17:48.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah menolong Elisa.
Dialogue: 0,0:17:48.13,0:17:49.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu...
Dialogue: 0,0:17:49.59,0:17:53.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa nama "Ray Alferius" cocok untukmu.
Dialogue: 0,0:17:53.57,0:17:54.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana?
Dialogue: 0,0:17:54.47,0:17:55.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh...
Dialogue: 0,0:17:55.35,0:17:57.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keluarga kami selalu siap menyambutmu.
Dialogue: 0,0:17:57.47,0:17:58.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh...
Dialogue: 0,0:17:58.72,0:17:59.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti...
Dialogue: 0,0:17:59.98,0:18:03.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak\Natas bantuan Anda kali ini.
Dialogue: 0,0:18:03.73,0:18:07.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak atas\Ntindakan tulus Tuan Ray.
Dialogue: 0,0:18:07.23,0:18:08.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:18:08.03,0:18:09.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, jangan begitu.
Dialogue: 0,0:18:10.99,0:18:14.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Artinya kita tidak perlu\Nbicara dengan kaku lagi!
Dialogue: 0,0:18:15.16,0:18:16.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jreng!
Dialogue: 0,0:18:16.58,0:18:19.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai sekarang, tolong jaga Elisa, ya.
Dialogue: 0,0:18:19.75,0:18:20.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:18:20.66,0:18:23.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perkenalkan, dia Putri Kedua\Nkerajaan kami...
Dialogue: 0,0:18:24.17,0:18:26.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayunda?
Dialogue: 0,0:18:27.25,0:18:30.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, kuperkenalkan sekali lagi.
Dialogue: 0,0:18:30.34,0:18:33.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putri Kedua negeri kami, Miriana.
Dialogue: 0,0:18:33.59,0:18:35.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elisa.
Dialogue: 0,0:18:38.14,0:18:40.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu boleh panggil aku Mbakyu!
Dialogue: 0,0:18:40.72,0:18:42.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bachikoon.
Dialogue: 0,0:18:45.01,0:18:47.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya melelahkan sekali.
Dialogue: 0,0:18:47.65,0:18:50.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, menurutku cukup menarik.
Dialogue: 0,0:18:51.03,0:18:53.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alferia pasti akan menjadi\Nkerajaan yang bagus.
Dialogue: 0,0:18:53.40,0:18:54.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:18:55.86,0:18:59.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, Ayunda Cathy menawariku...
Dialogue: 0,0:18:59.41,0:19:03.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Mau menetap di sini saja, tidak?"
Dialogue: 0,0:19:04.54,0:19:05.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku...
Dialogue: 0,0:19:06.82,0:19:08.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ingin bersama kalian.
Dialogue: 0,0:19:09.57,0:19:12.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di mana pun aku berada,\Naku tetaplah diriku.
Dialogue: 0,0:19:12.55,0:19:17.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa, aku tidak perlu memaksakan\Ndiri memilih antara Manusia atau Elf.
Dialogue: 0,0:19:17.39,0:19:20.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, Elisa tetaplah Elisa.
Dialogue: 0,0:19:20.06,0:19:22.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, benar sekali.
Dialogue: 0,0:19:23.39,0:19:28.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau sampai kapan asyik sendiri\Ndi dunia kalian berdua?
Dialogue: 0,0:19:28.56,0:19:33.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini yang disebut Origin asli Alferia,\N"Alfheim Circle" itu?
Dialogue: 0,0:19:33.82,0:19:36.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu-Bukan, kok!
Dialogue: 0,0:19:37.91,0:19:39.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elisa...
Dialogue: 0,0:19:39.45,0:19:42.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu jadi agak agresif, ya?
Dialogue: 0,0:19:42.16,0:19:46.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Soalnya kupikir\Naku juga harus berubah...
Dialogue: 0,0:19:46.50,0:19:47.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:19:47.83,0:19:50.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, aku juga tidak berniat mengalah.
Dialogue: 0,0:19:50.84,0:19:52.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku juga...
Dialogue: 0,0:19:52.09,0:19:55.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ray, ada sesuatu yang ingin kukatakan.
Dialogue: 0,0:19:55.17,0:19:57.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, apa itu?
Dialogue: 0,0:19:58.22,0:20:01.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya apa hubunganmu\Ndengan Putri Olivia?
Dialogue: 0,0:20:01.76,0:20:02.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm?
Dialogue: 0,0:20:02.47,0:20:03.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, itu...
Dialogue: 0,0:20:04.98,0:20:09.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dan Ray sudah berjanji\Nuntuk mengarungi masa depan bersama.
Dialogue: 0,0:20:09.65,0:20:10.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudnya apa?
Dialogue: 0,0:20:10.98,0:20:13.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putri Olivia, itu...
Dialogue: 0,0:20:13.28,0:20:15.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa maksudnya masa depan?
Dialogue: 0,0:20:15.24,0:20:17.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin! Sejak kapan?
Dialogue: 0,0:20:17.07,0:20:18.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu benar?
Dialogue: 0,0:20:18.28,0:20:20.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami belum pernah dengar, Ray!
Dialogue: 0,0:20:22.70,0:20:25.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar, Ray selalu bikin heboh, ya.
Dialogue: 0,0:20:25.75,0:20:27.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Claris...
Dialogue: 0,0:20:27.04,0:20:29.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak ikut heboh juga?
Dialogue: 0,0:20:29.08,0:20:31.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Aku tidak usah...
Dialogue: 0,0:20:34.71,0:20:37.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, syukurlah.
Dialogue: 0,0:20:37.05,0:20:39.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lukanya tidak membekas.
Dialogue: 0,0:20:40.47,0:20:43.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini berkat sihir Elisa yang luar biasa.
Dialogue: 0,0:20:47.65,0:20:50.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, darah muda.
Dialogue: 0,0:20:50.06,0:20:51.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:20:51.56,0:20:52.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Abbie.
Dialogue: 0,0:20:52.48,0:20:53.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm?
Dialogue: 0,0:20:53.06,0:20:54.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa bicara sebentar?
Dialogue: 0,0:20:54.32,0:20:55.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:20:55.07,0:20:56.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:20:56.32,0:20:58.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau bikin band, ya?
Dialogue: 0,0:20:58.24,0:21:00.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami buka lowongan\Nsemua posisi selain vokalis!
Dialogue: 0,0:21:00.82,0:21:03.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja, kami serius ingin menjadi pro!
Dialogue: 0,0:21:03.07,0:21:05.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya langsung bubar saja,\NGumpalan Pink!
Dialogue: 0,0:21:05.62,0:21:06.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat sekali, ya.
Dialogue: 0,0:21:06.75,0:21:09.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Langsung beda visi bermusik?
Dialogue: 0,0:21:09.83,0:21:13.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, Kyaro-Kyaro yang main drum,\Ndan Lydia vokalisnya!
Dialogue: 0,0:21:13.67,0:21:15.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana?
Dialogue: 0,0:21:24.10,0:21:28.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ray, aku tahu kamu baru sampai,\Ntapi apa hatimu sudah siap?
Dialogue: 0,0:21:28.60,0:21:30.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja, Ayah...
Dialogue: 0,0:21:30.60,0:21:33.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk inilah aku buru-buru pulang...
Dialogue: 0,0:21:37.69,0:21:38.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo?
Dialogue: 0,0:21:38.40,0:21:39.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu?
Dialogue: 0,0:21:40.36,0:21:42.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tumben dia malu-malu.
Dialogue: 0,0:21:42.82,0:21:45.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Habisnya kalian terlalu berharap.
Dialogue: 0,0:21:45.49,0:21:47.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harap dimaklumi.
Dialogue: 0,0:21:47.12,0:21:51.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena ini momen yang akan\Nterukir abadi dalam sejarah.
Dialogue: 0,0:21:51.25,0:21:54.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duh, dasar ayah dan anak yang kompak...
Dialogue: 0,0:21:54.13,0:21:56.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, keluarlah.
Dialogue: 0,0:22:02.13,0:22:04.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku kelihatan aneh?
Dialogue: 0,0:22:04.14,0:22:07.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, Stella!\NMenakjubkan!
Dialogue: 0,0:22:07.14,0:22:09.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lu-Luar biasa...
Dialogue: 0,0:22:09.22,0:22:10.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Adikku yang dulunya begitu imut,
Dialogue: 0,0:22:10.89,0:22:14.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kini mendapat pesona baru\Nberupa keanggunan sekaligus kedewasaan!
Dialogue: 0,0:22:14.65,0:22:16.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar super!\NTidak!
Dialogue: 0,0:22:16.82,0:22:19.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Great Ultimate Perfect!
Dialogue: 0,0:22:19.40,0:22:21.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untung aku buru-buru pulang!
Dialogue: 0,0:22:22.24,0:22:22.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ray!
Dialogue: 0,0:22:22.90,0:22:24.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah!
Dialogue: 0,0:22:24.16,0:22:25.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ray!
Dialogue: 0,0:22:25.07,0:22:27.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian berdua terlalu lebai.
Dialogue: 0,0:22:27.41,0:22:28.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku terlihat cocok?
Dialogue: 0,0:22:28.91,0:22:30.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, sangat cocok.
Dialogue: 0,0:22:32.66,0:22:33.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi tidak sabar, ya.
Dialogue: 0,0:22:33.92,0:22:34.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh?
Dialogue: 0,0:22:35.08,0:22:36.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Upacara Penerimaan Murid Baru.
Dialogue: 0,0:22:38.71,0:22:39.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:22:39.92,0:22:41.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi sangat tidak sabar!
Dialogue: 0,0:23:48.74,0:23:50.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Abel Alferius.
Dialogue: 0,0:23:50.28,0:23:51.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama putrinya, Miriana.
Dialogue: 0,0:23:51.33,0:23:52.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Juga Cathy.
Dialogue: 0,0:23:52.12,0:23:53.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Elisa Griffith.
Dialogue: 0,0:23:53.66,0:23:55.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, ayo, waktunya pratinjau!
Dialogue: 0,0:23:55.41,0:23:57.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si ngetop yang baru datang itu.
Dialogue: 0,0:23:57.12,0:23:58.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajah baru ngeyel yang gampang ngambek.
Dialogue: 0,0:23:58.79,0:24:00.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang dibebankan pada Ray
Dialogue: 0,0:24:00.46,0:24:01.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Next Mission
Dialogue: 0,0:24:01.25,0:24:02.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Impossible!
Dialogue: 0,0:24:02.42,0:24:03.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu... Selanjutnya!
Dialogue: 0,0:24:03.34,0:24:05.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyihir Pedang Es akan Menguasai Dunia...
Dialogue: 0,0:24:05.22,0:24:06.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dua!
Dialogue: 0,0:24:06.93,0:24:08.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tahun ajaran baru!\NEpisode delapan,
Dialogue: 0,0:24:08.97,0:24:11.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Pemuda yang Merupakan\NPenyihir Terkuat di Dunia
Dialogue: 0,0:24:11.10,0:24:13.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyambut Murid Baru!"
