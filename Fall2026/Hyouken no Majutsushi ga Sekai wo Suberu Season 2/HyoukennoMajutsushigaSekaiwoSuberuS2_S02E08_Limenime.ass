Dialogue: 0,0:02:44.27,0:02:56.53,sign,,0000,0000,0000,,PENYIHIR PEDANG ES\NAKAN MENGUASAI DUNIA SEASON 2
Dialogue: 0,0:04:11.48,0:04:15.86,sign,,0000,0000,0000,,PENYIHIR PEDANG ES\NAKAN MENGUASAI DUNIA SEASON 2
Dialogue: 0,0:04:15.86,0:04:18.95,sign,,0000,0000,0000,,EPISODE 8: PEMUDA YANG MERUPAKAN\NPENYIHIR TERKUAT DI DUNIA
Dialogue: 0,0:04:18.95,0:04:19.99,sign,,0000,0000,0000,,MENYAMBUT MURID BARU
Dialogue: 0,0:23:48.82,0:23:52.33,sign,,0000,0000,0000,,PRATINJAU
Dialogue: 0,0:00:01.40,0:00:04.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini, aku masuk ke akademi ini.
Dialogue: 0,0:00:05.82,0:00:07.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat cewek itu.
Dialogue: 0,0:00:07.49,0:00:09.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi dia cewek nakal\Nyang sering jadi gosip itu?
Dialogue: 0,0:00:09.49,0:00:11.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia putri keluarga Bradley, kan?
Dialogue: 0,0:00:12.37,0:00:14.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah terbiasa menyendiri.
Dialogue: 0,0:00:16.01,0:00:19.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya, aku merasa tidak ada perubahan.
Dialogue: 0,0:00:19.42,0:00:22.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, ada seseorang yang ingin kutemui
Dialogue: 0,0:00:22.75,0:00:24.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di akademi ini!
Dialogue: 0,0:00:24.17,0:00:26.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, ada Maria!
Dialogue: 0,0:00:26.51,0:00:28.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei!
Dialogue: 0,0:00:28.51,0:00:29.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Stella...
Dialogue: 0,0:00:29.43,0:00:32.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maria!
Dialogue: 0,0:00:34.18,0:00:37.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mau mengirimku ke rumah sakit\Ndi hari pertama sekolah, ya?
Dialogue: 0,0:00:37.39,0:00:39.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku selalu begini kalau bersama Abang.
Dialogue: 0,0:00:39.89,0:00:40.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, kan?
Dialogue: 0,0:00:40.85,0:00:41.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:00:41.56,0:00:45.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, yang sanggup menerima pelukan itu\Ndi dunia ini, mungkin cuma aku.
Dialogue: 0,0:00:45.40,0:00:46.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:00:48.42,0:00:51.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai hari ini, kita bersama, ya.\NMohon bantuannya.
Dialogue: 0,0:00:51.03,0:00:52.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya...
Dialogue: 0,0:00:52.12,0:00:56.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maria, seperti yang kamu lihat,\Nadikku ini sangat imut dan menggemaskan.
Dialogue: 0,0:00:56.29,0:00:58.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga mohon bantuannya.
Dialogue: 0,0:00:58.16,0:00:59.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya...
Dialogue: 0,0:00:59.66,0:01:01.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya juga mohon bantuannya.
Dialogue: 0,0:01:01.96,0:01:03.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Putri Olivia?\N- Ada Olivia!
Dialogue: 0,0:01:03.79,0:01:06.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai hari ini, saya masuk ke akademi ini.
Dialogue: 0,0:01:06.75,0:01:08.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nama saya Olivia Arnold.
Dialogue: 0,0:01:08.59,0:01:10.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Putri Olivia?\N- Putri?
Dialogue: 0,0:01:13.39,0:01:15.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon bantuannya, Senior.
Dialogue: 0,0:01:15.05,0:01:18.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dipanggil senior, ya?\NRasanya terdengar berbeda.
Dialogue: 0,0:01:18.31,0:01:19.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, kan?
Dialogue: 0,0:01:19.48,0:01:22.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersama Olivia juga!\NAsyik!
Dialogue: 0,0:01:22.77,0:01:25.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, mohon bantuannya juga.
Dialogue: 0,0:01:25.06,0:01:26.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maria juga, ya.
Dialogue: 0,0:01:27.44,0:01:29.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lama tak jumpa...
Dialogue: 0,0:01:29.74,0:01:32.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seragamnya cocok sekali denganmu.
Dialogue: 0,0:01:32.32,0:01:33.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, cocok sekali.
Dialogue: 0,0:01:34.62,0:01:35.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedang menyindir, ya?
Dialogue: 0,0:01:35.95,0:01:36.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:01:36.85,0:01:39.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gayamu yang agak santai itu\Nmalah terlihat modis.
Dialogue: 0,0:01:39.45,0:01:41.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutku ini gaya khas Maria.
Dialogue: 0,0:01:43.50,0:01:45.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putri Olivia.
Dialogue: 0,0:01:45.08,0:01:46.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat pagi.
Dialogue: 0,0:01:46.65,0:01:47.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dih.
Dialogue: 0,0:01:47.21,0:01:48.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hai, Rebecca.
Dialogue: 0,0:01:48.88,0:01:50.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini di depan umum.
Dialogue: 0,0:01:50.51,0:01:53.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya Anda menahan diri\Ndari tindakan mencolok.
Dialogue: 0,0:01:53.80,0:01:55.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kinokoon.
Dialogue: 0,0:01:55.09,0:01:56.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:01:56.26,0:01:59.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku malah ingin mempererat\Nkeakrabanku dengan Senior Ray.
Dialogue: 0,0:01:59.89,0:02:01.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kirikabu.
Dialogue: 0,0:02:01.27,0:02:03.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau sewajarnya saja?
Dialogue: 0,0:02:03.23,0:02:06.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai seorang putri kerajaan,\Nmelakukan itu di khalayak ramai...
Dialogue: 0,0:02:06.23,0:02:08.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurut saya kurang enak dipandang.
Dialogue: 0,0:02:08.47,0:02:10.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tekanan apa ini?
Dialogue: 0,0:02:10.19,0:02:12.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu makhluk-makhluk aneh ini?
Dialogue: 0,0:02:12.49,0:02:15.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ucapan Senior Rebecca ada benarnya.
Dialogue: 0,0:02:16.24,0:02:17.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, mari berangkat!
Dialogue: 0,0:02:17.99,0:02:20.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke upacara penerimaan kita!
Dialogue: 0,0:02:20.37,0:02:21.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yuk!
Dialogue: 0,0:02:21.66,0:02:23.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yuk...
Dialogue: 0,0:02:26.92,0:02:28.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putri Olivia...
Dialogue: 0,0:02:28.91,0:02:29.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:02:29.67,0:02:32.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beliau berkeinginan keras\Nmasuk ke akademi ini.
Dialogue: 0,0:02:32.51,0:02:35.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perhatikan beliau secara diam-diam.\NMohon bantuannya.
Dialogue: 0,0:02:35.76,0:02:37.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dimengerti.
Dialogue: 0,0:02:40.63,0:02:43.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat atas diterimanya kalian.
Dialogue: 0,0:03:56.09,0:03:58.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maria, mulai sekarang kita sekamar, ya!
Dialogue: 0,0:03:58.37,0:03:59.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya, mohon bantuannya.
Dialogue: 0,0:03:59.77,0:04:01.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maria, kamu tidak memakai kamar pribadi?
Dialogue: 0,0:04:01.64,0:04:02.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, iya...
Dialogue: 0,0:04:02.54,0:04:04.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sesayang itu pada Stella, ya?
Dialogue: 0,0:04:04.39,0:04:05.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maria!
Dialogue: 0,0:04:05.31,0:04:06.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, bukan begitu!
Dialogue: 0,0:04:21.32,0:04:23.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang, segenap murid baru.
Dialogue: 0,0:04:23.12,0:04:27.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akademi sihir ini adalah lembaga\Npendidikan terbaik di dunia.
Dialogue: 0,0:04:27.00,0:04:28.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian yang ada di sini sekarang
Dialogue: 0,0:04:28.50,0:04:31.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah para murid yang diakui\Nbakatnya sebagai penyihir...
Dialogue: 0,0:04:32.39,0:04:34.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, jangan terlena dan teruslah berusaha.
Dialogue: 0,0:04:34.43,0:04:37.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa sangka Putri Olivia masuk\Nke akademi ini.
Dialogue: 0,0:04:37.87,0:04:41.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga, di mana pun dia,\Naku bisa langsung menemukan Stella.
Dialogue: 0,0:04:41.39,0:04:44.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia memancarkan kilauan imut\Nbagaikan permata.
Dialogue: 0,0:04:44.89,0:04:50.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekian sambutan dariku,\NKepala Akademi Sihir Arnold, Abbie Garnet!
Dialogue: 0,0:04:50.39,0:04:53.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Kepala Akademi.
Dialogue: 0,0:04:53.19,0:04:57.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya, sambutan dari\Nperwakilan murid baru.
Dialogue: 0,0:04:57.44,0:05:00.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya perwakilan murid baru, Nate Hoskins.
Dialogue: 0,0:05:00.78,0:05:04.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya merasa bangga karena terpilih\Nmenjadi perwakilan murid baru
Dialogue: 0,0:05:04.98,0:05:07.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akademi Sihir Arnold dan mendapat\Nkesempatan memberi sambutan.
Dialogue: 0,0:05:08.58,0:05:11.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nate yang jadi perwakilan murid baru, ya.
Dialogue: 0,0:05:11.71,0:05:13.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kenal dia?
Dialogue: 0,0:05:13.00,0:05:13.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:05:13.92,0:05:17.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hoskins adalah keluarga bangsawan\Nyang saat ini paling menonjol.
Dialogue: 0,0:05:17.80,0:05:19.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia putra sulung mereka.
Dialogue: 0,0:05:22.39,0:05:25.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terakhir, ayo berkenalan dengan pengajar\Nyang baru bergabung, ya!
Dialogue: 0,0:05:27.21,0:05:28.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah!
Dialogue: 0,0:05:30.31,0:05:31.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master?
Dialogue: 0,0:05:31.69,0:05:32.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, begini...
Dialogue: 0,0:05:32.94,0:05:35.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak pandai memberi sambutan,\Njadi singkat saja, ya.
Dialogue: 0,0:05:35.94,0:05:39.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Lydia Ainsworth, sang Penyihir Genius.
Dialogue: 0,0:05:39.65,0:05:40.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salam kenal.
Dialogue: 0,0:05:40.44,0:05:41.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lydia Ainsworth?
Dialogue: 0,0:05:41.99,0:05:43.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peneliti sihir itu?
Dialogue: 0,0:05:43.32,0:05:44.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tokoh super terkenal, kan?
Dialogue: 0,0:05:44.66,0:05:45.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar dia orangnya?
Dialogue: 0,0:05:45.95,0:05:49.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lydia Ainsworth kami undang\Nsebagai pengajar tamu.
Dialogue: 0,0:05:49.45,0:05:51.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelas Nona Lydia!
Dialogue: 0,0:05:51.25,0:05:54.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tahun ajaran ini, beliau akan mengampu\Nmata pelajaran untuk murid baru.
Dialogue: 0,0:05:55.59,0:05:57.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ray tahu soal ini?
Dialogue: 0,0:05:57.25,0:05:59.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, sama sekali...
Dialogue: 0,0:06:00.97,0:06:04.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, wali kelas baru kalian adalah
Dialogue: 0,0:06:04.72,0:06:06.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku, Kyaro-Kyaro!
Dialogue: 0,0:06:06.85,0:06:08.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon kerja samanya, ya!
Dialogue: 0,0:06:12.73,0:06:15.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya, sekelas dengan sirkelku!
Dialogue: 0,0:06:18.23,0:06:19.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu Ray White, ya?
Dialogue: 0,0:06:20.82,0:06:23.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu... Nate Hoskins?
Dialogue: 0,0:06:24.86,0:06:27.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sambutanmu tadi sangat memukau.
Dialogue: 0,0:06:27.37,0:06:28.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat atas diterima—
Dialogue: 0,0:06:29.79,0:06:32.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin kamu telah berbuat curang!
Dialogue: 0,0:06:32.62,0:06:34.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, apa maksudnya tiba-tiba begitu?
Dialogue: 0,0:06:34.87,0:06:38.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bisa menginjakkan kaki di akademi ini\Npadahal cuma seorang Ordinary.
Dialogue: 0,0:06:38.54,0:06:42.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bahkan diterima Ketiga Keluarga\NBangsawan Besar dan bangsawan kelas atas!
Dialogue: 0,0:06:42.26,0:06:44.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah koneksi macam apa\Nyang kamu gunakan,
Dialogue: 0,0:06:44.30,0:06:46.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bagaimanapun,\Nkedudukanmu itu tak masuk akal!
Dialogue: 0,0:06:46.64,0:06:49.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, jadi begitu pandangan orang luar.
Dialogue: 0,0:06:49.22,0:06:51.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu seharusnya membantah, Ray!
Dialogue: 0,0:06:51.52,0:06:54.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar tikus got menjijikkan,\Nseharusnya kamu tahu malu!
Dialogue: 0,0:06:54.27,0:06:55.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cukup sampai di situ.
Dialogue: 0,0:06:56.52,0:06:58.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Albert Allium.
Dialogue: 0,0:06:58.02,0:07:00.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke mana perginya harga dirimu\Nsebagai bangsawan kelas atas?
Dialogue: 0,0:07:00.82,0:07:03.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak malu bergaul dengan tikus got?
Dialogue: 0,0:07:03.40,0:07:06.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak semalu melihat tingkah lakumu sekarang.
Dialogue: 0,0:07:06.03,0:07:07.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa katamu?
Dialogue: 0,0:07:07.07,0:07:08.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:07:08.91,0:07:10.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedang adu mulut?
Dialogue: 0,0:07:10.37,0:07:10.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak...
Dialogue: 0,0:07:10.91,0:07:12.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-A-Amelia!
Dialogue: 0,0:07:12.41,0:07:15.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}La-La-La-Lama tak jumpa!
Dialogue: 0,0:07:15.11,0:07:17.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat telah diterima di sini, Nate.
Dialogue: 0,0:07:17.50,0:07:18.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suatu kehormatan.
Dialogue: 0,0:07:18.79,0:07:21.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sambutanmu sebagai perwakilan\Njuga bagus sekali.
Dialogue: 0,0:07:21.30,0:07:22.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:07:22.92,0:07:23.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya...
Dialogue: 0,0:07:23.67,0:07:26.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Aku dengar tahun lalu Amelia jadi perwakilan\N- Kami baru saja mau makan siang bersama.
Dialogue: 0,0:07:26.80,0:07:27.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- murid baru\N- Boleh, ayo.
Dialogue: 0,0:07:27.36,0:07:28.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- jadi meski agak lancang,\N- Boleh, ayo.
Dialogue: 0,0:07:28.25,0:07:29.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- aku berencana menjadikan pidato\N- Iya.
Dialogue: 0,0:07:29.97,0:07:31.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- sambutan Amelia sebagai referensi\N- Nate, sampai nanti, ya.
Dialogue: 0,0:07:31.81,0:07:33.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Sampai nanti.\N- Ya, sampai...
Dialogue: 0,0:07:33.31,0:07:34.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai...
Dialogue: 0,0:07:36.31,0:07:38.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ray White!
Dialogue: 0,0:07:38.56,0:07:42.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi rumor soal kamu yang memperdaya\NAmelia itu ternyata benar, ya!
Dialogue: 0,0:07:42.44,0:07:43.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:07:43.44,0:07:45.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia Amelia, yang paling cantik
Dialogue: 0,0:07:45.32,0:07:48.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di antara putri Ketiga Bangsawan Besar\Nyang sedang beranjak dewasa!
Dialogue: 0,0:07:48.57,0:07:51.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dibandingkan keluarga Bradley\Nyang kakaknya cuma sok angkuh
Dialogue: 0,0:07:51.78,0:07:53.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan adiknya benar-benar liar itu,
Dialogue: 0,0:07:53.23,0:07:55.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia jauh lebih anggun dan menawan!
Dialogue: 0,0:07:56.08,0:08:01.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih cerdas dan berbakat daripada\Nkeluarga Olgren yang berotak otot itu!
Dialogue: 0,0:08:02.38,0:08:03.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:08:03.59,0:08:06.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Anu, tunggu...\N- Dipikir pun tetap tidak masuk akal, kan?
Dialogue: 0,0:08:06.76,0:08:08.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa-bisanya serangga kotor sepertimu...
Dialogue: 0,0:08:08.63,0:08:11.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski dibilang begitu,\Nkami memang berteman.
Dialogue: 0,0:08:11.60,0:08:14.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diam!\NKecuranganmu pasti akan kubongkar!
Dialogue: 0,0:08:14.93,0:08:17.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kukupas habis\Ntopeng murahanmu itu, camkan!
Dialogue: 0,0:08:17.98,0:08:19.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Camkan itu!
Dialogue: 0,0:08:25.99,0:08:28.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang!
Dialogue: 0,0:08:32.28,0:08:35.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau disambut begitu terus,\Njantungku bisa copot.
Dialogue: 0,0:08:38.50,0:08:39.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maria.
Dialogue: 0,0:08:39.83,0:08:40.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:08:40.78,0:08:42.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Abang pernah bilang.
Dialogue: 0,0:08:42.50,0:08:47.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Adiknya Kak Rebecca itu\Nmeski sekilas terlihat seperti pisau,
Dialogue: 0,0:08:47.88,0:08:51.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia gadis berhati mulia yang lebih lembut\Ndan peka daripada siapa pun.
Dialogue: 0,0:08:51.84,0:08:54.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya manis banget."
Dialogue: 0,0:08:54.26,0:08:55.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Hah?
Dialogue: 0,0:08:55.64,0:08:57.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian akrab, kan?
Dialogue: 0,0:08:57.27,0:09:00.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga senang sekali\Nbisa berteman akrab denganmu!
Dialogue: 0,0:09:01.94,0:09:03.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silaunya...
Dialogue: 0,0:09:03.41,0:09:05.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, aku mengerti...
Dialogue: 0,0:09:05.32,0:09:06.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:09:13.32,0:09:14.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana sekolahmu?
Dialogue: 0,0:09:14.62,0:09:15.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seru!
Dialogue: 0,0:09:15.79,0:09:17.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga sudah punya teman.
Dialogue: 0,0:09:17.62,0:09:20.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terutama Maria dan Olivia,\Naku paling akrab dengan mereka.
Dialogue: 0,0:09:20.77,0:09:23.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.\NKalau begitu syukurlah.
Dialogue: 0,0:09:23.29,0:09:26.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Olivia sering sekali menanyakanmu.
Dialogue: 0,0:09:26.80,0:09:29.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal masa lalu Abang,\Nmakanan kesukaan, banyak hal!
Dialogue: 0,0:09:29.80,0:09:33.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Olivia juga sangat sayang pada Abang, ya!
Dialogue: 0,0:09:33.14,0:09:34.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu, ya...
Dialogue: 0,0:09:34.97,0:09:36.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus, terus...
Dialogue: 0,0:09:36.51,0:09:40.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya Maria pernah bertanya soal Mbak...
Dialogue: 0,0:09:41.89,0:09:45.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Abang kenal Lily, tidak?
Dialogue: 0,0:09:45.82,0:09:47.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:09:47.32,0:09:49.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita percepat larinya, Stella!
Dialogue: 0,0:09:49.44,0:09:50.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:09:54.32,0:09:55.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat pa...
Dialogue: 0,0:09:56.24,0:09:57.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}...gi?
Dialogue: 0,0:09:59.20,0:10:00.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, Ray?
Dialogue: 0,0:10:00.83,0:10:02.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini...
Dialogue: 0,0:10:02.54,0:10:03.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:10:03.33,0:10:04.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tumben memakai ba...
Dialogue: 0,0:10:04.75,0:10:06.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sewajarnya manusia, kan?
Dialogue: 0,0:10:07.20,0:10:10.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari, kita sambut anggota baru kita!
Dialogue: 0,0:10:10.34,0:10:12.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap!
Dialogue: 0,0:10:13.41,0:10:17.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang, para murid baru\Nyang penuh semangat membara!
Dialogue: 0,0:10:17.10,0:10:21.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Elio Grave, yang mulai tahun ajaran ini\Nmengemban tugas sebagai ketua klub!
Dialogue: 0,0:10:22.48,0:10:27.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bersumpah akan menjadi ketua yang tak akan\Nmempermalukan para senior hebat kita.
Dialogue: 0,0:10:27.23,0:10:30.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para murid baru, terima kasih\Ntelah hadir di uji coba klub!
Dialogue: 0,0:10:30.28,0:10:34.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti tahun-tahun sebelumnya,\Nkalian akan langsung berlatih dengan kami.
Dialogue: 0,0:10:34.60,0:10:36.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kegiatan klub kami sangatlah keras!
Dialogue: 0,0:10:36.81,0:10:39.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa pun yang tak sanggup\Nakan langsung gugur!
Dialogue: 0,0:10:39.24,0:10:41.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hadapi dengan tekad itu!
Dialogue: 0,0:10:41.25,0:10:42.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap!
Dialogue: 0,0:10:52.51,0:10:54.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gila...
Dialogue: 0,0:10:56.55,0:10:58.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya kita dapat bibit unggul lagi.
Dialogue: 0,0:11:03.52,0:11:07.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, para anggota baru,\Nsilakan memperkenalkan diri.
Dialogue: 0,0:11:07.86,0:11:08.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:11:08.65,0:11:10.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya Olivia Arnold.
Dialogue: 0,0:11:10.52,0:11:15.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon kerja samanya sebagai sesama\Nmurid baru di akademi ini.
Dialogue: 0,0:11:15.07,0:11:19.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya dengar Klub Berkebun itu secara tradisi\Nberanggotakan banyak putri bangsawan,
Dialogue: 0,0:11:19.07,0:11:22.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi tahun lalu, kabarnya\NSenior Ray White ikut bergabung...
Dialogue: 0,0:11:22.29,0:11:25.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya sangat tertarik padanya.
Dialogue: 0,0:11:25.00,0:11:26.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pachikon!
Dialogue: 0,0:11:27.54,0:11:28.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ray.
Dialogue: 0,0:11:28.54,0:11:30.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, ada apa?
Dialogue: 0,0:11:30.17,0:11:32.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan tekanan ini?
Dialogue: 0,0:11:32.05,0:11:34.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beliau dari keluarga kerajaan,
Dialogue: 0,0:11:34.17,0:11:37.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tolong jaga sikapmu saat di depannya.
Dialogue: 0,0:11:37.68,0:11:39.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Te-Tentu saja.
Dialogue: 0,0:11:39.68,0:11:41.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita berteman baik, Senior Ray.
Dialogue: 0,0:11:41.97,0:11:42.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja.
Dialogue: 0,0:11:42.97,0:11:43.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kirikabu.
Dialogue: 0,0:11:43.68,0:11:44.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kinokoon.
Dialogue: 0,0:11:44.68,0:11:47.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan, Putri Olivia juga...
Dialogue: 0,0:11:48.69,0:11:51.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelajaran hari ini adalah\Npraktik ilmu pedang.
Dialogue: 0,0:11:51.15,0:11:53.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau lengah hanya karena memakai\Npedang kayu, kalian bisa mati.
Dialogue: 0,0:11:53.98,0:11:54.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:11:54.69,0:11:57.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kali ini pun, Nate pasti juara!
Dialogue: 0,0:11:57.20,0:12:00.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya kamu lulus dengan peringkat satu!\NDi praktik pun pasti juara satu.
Dialogue: 0,0:12:01.78,0:12:04.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan mengatakan hal yang sudah jelas.
Dialogue: 0,0:12:06.58,0:12:10.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa-apaan ini?
Dialogue: 0,0:12:10.50,0:12:12.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu memang hebat,
Dialogue: 0,0:12:12.59,0:12:13.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Stella.
Dialogue: 0,0:12:13.42,0:12:15.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, Profesor!
Dialogue: 0,0:12:16.17,0:12:17.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu baik-baik saja?
Dialogue: 0,0:12:17.51,0:12:18.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:12:18.51,0:12:20.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak terluka?
Dialogue: 0,0:12:20.09,0:12:22.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Stella... White...
Dialogue: 0,0:12:22.35,0:12:23.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}White...
Dialogue: 0,0:12:24.35,0:12:26.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}White?
Dialogue: 0,0:12:27.89,0:12:30.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu seumuran mereka,
Dialogue: 0,0:12:30.52,0:12:33.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku selalu kesulitan berbaur\Ndengan orang di sekitar.
Dialogue: 0,0:12:34.15,0:12:36.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak kecil, aku menyukai sihir,
Dialogue: 0,0:12:36.65,0:12:41.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena merasa mempersembahkan segalanya\Nuntuk sihir adalah tujuan hidupku.
Dialogue: 0,0:12:41.37,0:12:44.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski tidak punya teman,\Naku merasa cukup.
Dialogue: 0,0:12:46.04,0:12:48.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akulah sang Genius Sejati!
Dialogue: 0,0:12:48.12,0:12:48.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, iya.
Dialogue: 0,0:12:48.83,0:12:52.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, segalanya berubah\Nsejak bertemu Lydia.
Dialogue: 0,0:12:52.04,0:12:56.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bakat sihirnya yang luar biasa,\Nkarisma yang memukau.
Dialogue: 0,0:12:56.05,0:13:00.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Oh, ternyata yang disebut Genius Sejati\Nadalah orang seperti Lydia, ya."
Dialogue: 0,0:13:00.84,0:13:05.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melihat sosoknya yang begitu bebas,\Naku merasa boleh berubah.
Dialogue: 0,0:13:05.56,0:13:08.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Carol, apa-apaan penampilanmu itu?
Dialogue: 0,0:13:08.06,0:13:09.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak cocok, ya?
Dialogue: 0,0:13:09.35,0:13:10.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti dimarahi!
Dialogue: 0,0:13:11.81,0:13:13.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, imut, kan?
Dialogue: 0,0:13:13.56,0:13:14.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah...
Dialogue: 0,0:13:15.36,0:13:17.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, kok.\NCocok denganmu.
Dialogue: 0,0:13:17.23,0:13:19.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bersyukur dipertemukan\Ndengan mereka berdua.
Dialogue: 0,0:13:19.57,0:13:22.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kehadiran mereka membuatku\Nmerasa terselamatkan.
Dialogue: 0,0:13:25.58,0:13:27.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa muda, ya.
Dialogue: 0,0:13:27.49,0:13:30.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oi, Gumpalan Pink, kenapa malah bengong?
Dialogue: 0,0:13:30.21,0:13:31.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo lanjutkan obrolan kita.
Dialogue: 0,0:13:31.58,0:13:33.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:13:34.67,0:13:36.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gosip tentang Stella?
Dialogue: 0,0:13:36.91,0:13:39.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah kenapa ceritanya\Ndilebih-lebihkan ke mana-mana,
Dialogue: 0,0:13:39.38,0:13:42.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mulai dari A sampai Z,\Ndari ujung kepala sampai ujung kaki,
Dialogue: 0,0:13:42.09,0:13:44.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}banyak sekali bumbunya.
Dialogue: 0,0:13:44.51,0:13:47.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa Stella baik-baik saja?
Dialogue: 0,0:13:47.51,0:13:48.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:13:48.64,0:13:50.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gosipnya pasti bagus!
Dialogue: 0,0:13:50.27,0:13:52.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya Stella adalah bidadari\Nyang turun ke bumi!
Dialogue: 0,0:13:56.77,0:13:58.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat pagi, Stella.
Dialogue: 0,0:13:59.11,0:14:00.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Abang...
Dialogue: 0,0:14:02.40,0:14:05.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Abang!
Dialogue: 0,0:14:06.14,0:14:07.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:14:08.87,0:14:12.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua orang mengejekku monster!
Dialogue: 0,0:14:12.87,0:14:16.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah dengar, belum?\NKatanya ada murid baru yang anomali!
Dialogue: 0,0:14:16.00,0:14:17.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tingginya dua meter.
Dialogue: 0,0:14:17.25,0:14:19.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baru berjalan saja, api neraka\Nlangsung melalap sekitarnya.
Dialogue: 0,0:14:19.80,0:14:22.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya, tinjunya mampu membelah bumi\Ndan menghancurkan gunung!
Dialogue: 0,0:14:23.23,0:14:26.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja.\NKamu itu yang paling imut sejagat raya.
Dialogue: 0,0:14:26.80,0:14:27.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh?
Dialogue: 0,0:14:27.76,0:14:28.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:14:28.89,0:14:32.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, setidaknya bisa kamu sebutkan\Nnama-nama mereka?
Dialogue: 0,0:14:32.18,0:14:34.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak boleh, kamu mau apakan mereka?
Dialogue: 0,0:14:34.31,0:14:36.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, cuma mau mengobrol...
Dialogue: 0,0:14:37.27,0:14:41.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak usah, asal Abang mengerti,\Naku baik-baik saja.
Dialogue: 0,0:14:41.86,0:14:43.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Stella tangguh sekali, ya.
Dialogue: 0,0:14:43.69,0:14:45.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Adikku memang hebat.
Dialogue: 0,0:14:45.57,0:14:46.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:14:47.95,0:14:52.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak masuknya para murid baru,\Nsituasi mulai berubah drastis.
Dialogue: 0,0:14:52.79,0:14:54.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terutama Putri Olivia...
Dialogue: 0,0:14:54.79,0:14:56.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidakkah menurut kalian berbahaya?
Dialogue: 0,0:14:56.79,0:14:58.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beliau memang sosok yang berani.
Dialogue: 0,0:14:58.67,0:15:02.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai anggota keluarga kerajaan,\Nbeliau terkesan acuh tak acuh pada sekitar...
Dialogue: 0,0:15:02.46,0:15:03.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya?
Dialogue: 0,0:15:03.72,0:15:04.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:15:04.30,0:15:07.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak pergi ke Alferia, Elisa juga begitu.
Dialogue: 0,0:15:07.61,0:15:08.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya...
Dialogue: 0,0:15:08.55,0:15:11.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Situasinya telah berubah drastis!
Dialogue: 0,0:15:11.06,0:15:11.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Benarkah?\N- Benar.
Dialogue: 0,0:15:11.85,0:15:15.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajar kalau sebentar lagi tawaran\Npertunangan mendatangi kita.
Dialogue: 0,0:15:15.89,0:15:17.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertunangan?
Dialogue: 0,0:15:17.06,0:15:21.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, meski dalam kasusku memang\Nada situasi yang agak khusus...
Dialogue: 0,0:15:21.07,0:15:24.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meskipun dari kalangan Ordinary,\NRay adalah "Penyihir Pedang Es",
Dialogue: 0,0:15:24.70,0:15:27.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sosok terkuat di antara\NKetujuh Penyihir Agung.
Dialogue: 0,0:15:27.41,0:15:32.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sangat pantas jadi tunangan kita\Nyang merupakan Ketiga Bangsawan Besar.
Dialogue: 0,0:15:32.24,0:15:36.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, itu juga berlaku\Npada Putri Olivia selaku Putri Kedua.
Dialogue: 0,0:15:36.46,0:15:38.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, itu benar.
Dialogue: 0,0:15:38.17,0:15:40.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maka dari itu, aku ada usulan.
Dialogue: 0,0:15:40.21,0:15:43.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau kita\Nbekerja sama sedikit lebih lama lagi?
Dialogue: 0,0:15:43.09,0:15:46.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau terus saling menghalangi,\Nsituasinya tak akan pernah maju.
Dialogue: 0,0:15:46.47,0:15:50.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan bergabungnya Putri Olivia,\Nsemuanya jadi kacau balau.
Dialogue: 0,0:15:50.01,0:15:53.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, mari bekerja sama dan menciptakan\Nkesempatan untuk masing-masing.
Dialogue: 0,0:15:53.60,0:15:55.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahasa bayinya?
Dialogue: 0,0:15:55.02,0:15:57.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duel kencan dengan Ray!
Dialogue: 0,0:15:57.10,0:15:57.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kencan?\N- Duel?
Dialogue: 0,0:15:57.98,0:15:59.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:15:59.02,0:16:02.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang kita akan hompimpa\Nuntuk menentukan giliran kencan dengan Ray.
Dialogue: 0,0:16:02.86,0:16:05.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aturannya, selama waktu tersebut\Nkita tidak boleh saling mengganggu.
Dialogue: 0,0:16:05.74,0:16:10.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah lebih baik saling memberi kesempatan\Ndaripada bertengkar sia-sia?
Dialogue: 0,0:16:10.20,0:16:11.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:16:11.24,0:16:12.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ariane, ini kencan, lo.
Dialogue: 0,0:16:12.78,0:16:13.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kencan?
Dialogue: 0,0:16:15.29,0:16:18.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kencan?
Dialogue: 0,0:16:18.67,0:16:21.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, sudah seperti kencan saja, ya.
Dialogue: 0,0:16:21.59,0:16:23.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita sedang di akademi.
Dialogue: 0,0:16:24.42,0:16:29.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akademi ini luas sekali.\NAku senang sekali bisa dipandu olehmu.
Dialogue: 0,0:16:29.34,0:16:31.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senang mendengarnya.
Dialogue: 0,0:16:31.26,0:16:33.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu... sudah waktunya.
Dialogue: 0,0:16:33.14,0:16:33.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm?
Dialogue: 0,0:16:33.93,0:16:36.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, sudah waktunya, ya.
Dialogue: 0,0:16:36.02,0:16:37.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Besok, minta tolong lagi—
Dialogue: 0,0:16:40.02,0:16:41.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anda baik-baik saja?
Dialogue: 0,0:16:43.15,0:16:44.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baik-baik saja.
Dialogue: 0,0:16:44.69,0:16:46.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}He-Hei!
Dialogue: 0,0:16:47.15,0:16:48.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu kan...
Dialogue: 0,0:16:49.15,0:16:52.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putri berduaan dengan Ordinary!
Dialogue: 0,0:16:52.24,0:16:54.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan, mereka sedang menjalin kasih?
Dialogue: 0,0:16:54.58,0:16:56.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka berpelukan, lo!
Dialogue: 0,0:16:56.33,0:16:58.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai berciuman juga!
Dialogue: 0,0:17:00.58,0:17:04.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar, bocah itu benar-benar, ya?\NApa perlu kukasih paham?
Dialogue: 0,0:17:04.96,0:17:07.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Lydia, Anda berniat makar, ya?
Dialogue: 0,0:17:08.45,0:17:09.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga.
Dialogue: 0,0:17:09.63,0:17:14.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sikap bebas Putri bukan hal buruk,\Ntapi begini jadinya...
Dialogue: 0,0:17:15.18,0:17:18.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putri Olivia menikmati kehidupan akademinya.
Dialogue: 0,0:17:18.31,0:17:19.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makar...
Dialogue: 0,0:17:19.39,0:17:21.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Bagaimana denganmu, Lydia?\N- Kalau terpaksa, ya boleh...
Dialogue: 0,0:17:21.56,0:17:24.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana rasanya kembali\Nke masyarakat pascapensiunmu?
Dialogue: 0,0:17:24.19,0:17:27.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah lama tak menghirup udara bebas.\NAku menikmatinya.
Dialogue: 0,0:17:27.19,0:17:28.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pilihan katamu jelek!
Dialogue: 0,0:17:28.56,0:17:31.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengurusi anak-anak muda...
Dialogue: 0,0:17:31.36,0:17:33.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, lumayan.
Dialogue: 0,0:17:33.57,0:17:35.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senang mendengarnya.
Dialogue: 0,0:17:35.20,0:17:38.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga hari-hari seperti ini\Nbisa terus berlanjut.
Dialogue: 0,0:17:38.08,0:17:40.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, benar sekali.
Dialogue: 0,0:17:40.91,0:17:41.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:17:42.25,0:17:45.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal lawan yang Lydia hadapi di Alferia,
Dialogue: 0,0:17:45.13,0:17:47.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Julius siapalah itu...
Dialogue: 0,0:17:47.55,0:17:50.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyihir yang kemampuannya\Nbisa menandingi Lydia, ya?
Dialogue: 0,0:17:50.59,0:17:53.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah dipikir, identitas aslinya...
Dialogue: 0,0:17:53.59,0:17:56.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Freesia Rozenkreutz.
Dialogue: 0,0:17:56.10,0:17:58.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Leluhur sihir, ya.
Dialogue: 0,0:17:58.35,0:18:01.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tokoh bersejarah dari beberapa\Ngenerasi lalu, benar?
Dialogue: 0,0:18:01.23,0:18:04.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu artinya, pembebasan sihir\Nyang mereka maksud adalah...
Dialogue: 0,0:18:05.36,0:18:07.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kebangkitan ilmu magis.
Dialogue: 0,0:18:10.69,0:18:13.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua syaratnya mulai terpenuhi.
Dialogue: 0,0:18:13.36,0:18:15.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berikutnya adalah menghubungkannya\Nke Akasha.
Dialogue: 0,0:18:15.78,0:18:17.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Julius.
Dialogue: 0,0:18:17.37,0:18:19.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal Bianca Miller,\Ndia bertindak seenaknya lagi...
Dialogue: 0,0:18:19.83,0:18:20.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh.
Dialogue: 0,0:18:20.87,0:18:23.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa, biarkan saja\Ndia bertindak sesukanya.
Dialogue: 0,0:18:23.75,0:18:26.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk saat ini, ya.
Dialogue: 0,0:18:26.38,0:18:27.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bercanda...
Dialogue: 0,0:18:27.71,0:18:29.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak terima!\NApa-apaan mereka itu...
Dialogue: 0,0:18:29.46,0:18:31.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Bagaimana sekolahmu?\N- Kecurangan mereka pasti kubongkar!
Dialogue: 0,0:18:31.72,0:18:32.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar parah!
Dialogue: 0,0:18:32.80,0:18:35.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ray White saja tidak bisa kuterima,
Dialogue: 0,0:18:35.05,0:18:37.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adiknya pasti memakai trik curang.\NTidak masuk akal!
Dialogue: 0,0:18:37.43,0:18:39.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu, ya.
Dialogue: 0,0:18:41.73,0:18:42.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nate.
Dialogue: 0,0:18:42.89,0:18:45.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu itu lebih kuat dari siapa pun.
Dialogue: 0,0:18:45.90,0:18:49.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di dunia ini, tak ada murid\Nyang sanggup mengalahkanmu.
Dialogue: 0,0:18:49.36,0:18:52.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ray White dan Stella White\Nsama-sama curang.
Dialogue: 0,0:18:52.94,0:18:54.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, benar sekali.
Dialogue: 0,0:18:54.40,0:18:58.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membongkar semua itu adalah tugasmu\Nsebagai putra sulung keluarga Hoskins, bukan?
Dialogue: 0,0:18:58.41,0:19:00.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, itu tugasku.
Dialogue: 0,0:19:00.58,0:19:02.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, berusahalah lebih keras.
Dialogue: 0,0:19:02.91,0:19:05.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, bagaimana dengan Amelia Rose?
Dialogue: 0,0:19:05.92,0:19:07.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Amelia sungguh menawan!
Dialogue: 0,0:19:07.96,0:19:10.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Parasnya memadukan kecantikan\Ndan keimutan yang saling beradu!
Dialogue: 0,0:19:10.63,0:19:13.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sosok yang memancarkan kasih,\Nkeanggunan, dan ketangguhan.
Dialogue: 0,0:19:13.47,0:19:16.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sudah menjadikannya yang terbaik\Ndi antara Ketiga Bangsawan Besar!
Dialogue: 0,0:19:16.30,0:19:18.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menguasai sastra maupun bela diri,\Ncerdas dan rupawan,
Dialogue: 0,0:19:18.64,0:19:21.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}langit menganugerahinya\Nratusan kelebihan sekaligus.
Dialogue: 0,0:19:21.18,0:19:22.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya berada di sisinya saja...
Dialogue: 0,0:19:22.43,0:19:24.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, iya, aku paham!
Dialogue: 0,0:19:24.68,0:19:27.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cowok ini kena pelet, kan?
Dialogue: 0,0:19:27.48,0:19:31.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya, terus amati dia\Ndengan saksama, ya.
Dialogue: 0,0:19:31.32,0:19:32.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, Amelia...
Dialogue: 0,0:19:33.44,0:19:35.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bidak yang mudah dikendalikan.
Dialogue: 0,0:19:35.24,0:19:37.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski agak merepotkan.
Dialogue: 0,0:19:37.24,0:19:39.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak seperti Helena Grady.
Dialogue: 0,0:19:39.99,0:19:43.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana caranya aku bisa\Nmembunuh Ray White?
Dialogue: 0,0:19:43.70,0:19:47.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mulai dikerumuni penyihir kuat.
Dialogue: 0,0:19:47.54,0:19:52.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan mereka yang mulai bangkit\Npasti bukan kebetulan.
Dialogue: 0,0:19:52.09,0:19:53.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketujuh Penyihir Agung akan terus berputar.
Dialogue: 0,0:19:53.96,0:19:56.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siklus pergantiannya\Ntak akan pernah terputus.
Dialogue: 0,0:19:56.97,0:20:00.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi menjaga kekuatan penangkal\Nbernama Ray White tetap berfungsi,
Dialogue: 0,0:20:00.35,0:20:03.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dunia menganugerahkan kekuatan\Npada orang selain dirinya.
Dialogue: 0,0:20:03.72,0:20:07.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga, sistem yang dia tinggalkan\Nbenar-benar merepotkan.
Dialogue: 0,0:20:08.48,0:20:09.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ameli...
Dialogue: 0,0:20:12.52,0:20:14.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pulang saja, deh.
Dialogue: 0,0:20:30.50,0:20:33.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari tadi aku merasakan tatapanmu.
Dialogue: 0,0:20:33.00,0:20:36.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengintip, ya?\NMenjijikkan sekali.
Dialogue: 0,0:20:36.01,0:20:39.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu penggemarku,\Nsebaiknya tahu batasan.
Dialogue: 0,0:20:39.76,0:20:41.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya itu menyebalkan!
Dialogue: 0,0:20:47.48,0:20:49.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata memang kamu, ya,
Dialogue: 0,0:20:49.39,0:20:50.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Helena Grady!
Dialogue: 0,0:20:51.15,0:20:54.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bianca Miller, apa tujuanmu?
Dialogue: 0,0:20:54.02,0:20:56.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu menguntitku\Nhanya karena penasaran?
Dialogue: 0,0:20:56.97,0:20:57.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jijik!
Dialogue: 0,0:20:57.78,0:20:59.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katakan padaku...
Dialogue: 0,0:20:59.32,0:21:03.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa tujuan Eugenics...\NTidak, apa tujuan Julius Orphe?
Dialogue: 0,0:21:03.03,0:21:04.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana kutahu.
Dialogue: 0,0:21:04.57,0:21:07.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bekerja sama dengannya\Nkarena kebetulan kepentingan kami sejalan.
Dialogue: 0,0:21:07.70,0:21:08.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan pura-pura bodoh!
Dialogue: 0,0:21:08.71,0:21:10.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa yang pura-pura?
Dialogue: 0,0:21:10.04,0:21:11.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jawab aku!
Dialogue: 0,0:21:14.44,0:21:15.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu...
Dialogue: 0,0:21:15.55,0:21:18.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akashic Materia.\NBelum pernah melihatnya?
Dialogue: 0,0:21:18.72,0:21:20.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama kalinya, ya.
Dialogue: 0,0:21:20.43,0:21:23.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,\Nakan kulakukan dengan lembut.
Dialogue: 0,0:21:24.18,0:21:25.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat!
Dialogue: 0,0:21:26.68,0:21:28.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlalu cepat!
Dialogue: 0,0:21:28.18,0:21:29.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi ini...
Dialogue: 0,0:21:34.19,0:21:36.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kabur, ya.
Dialogue: 0,0:21:36.11,0:21:37.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, biarlah.
Dialogue: 0,0:21:37.61,0:21:40.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asal dia mau diam untuk sementara waktu.
Dialogue: 0,0:21:51.96,0:21:54.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akashic Materia...
Dialogue: 0,0:21:54.08,0:21:58.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi itu rupanya tujuan Eugenics!
Dialogue: 0,0:22:03.34,0:22:06.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sebenarnya manusia yang lemah.
Dialogue: 0,0:22:07.01,0:22:09.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak punya karisma seperti Abbie,
Dialogue: 0,0:22:09.39,0:22:12.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}maupun kekuatan\Ndan rasa tanggung jawab seperti Lydia.
Dialogue: 0,0:22:12.60,0:22:16.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya, seharusnya aku tidak masuk militer.
Dialogue: 0,0:22:16.02,0:22:17.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tidak benar.
Dialogue: 0,0:22:19.57,0:22:24.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Carol tidak ada, Perang Timur Jauh\Npasti berakhir jauh lebih buruk.
Dialogue: 0,0:22:24.49,0:22:28.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada banyak sekali orang\Nyang terselamatkan berkat Carol.
Dialogue: 0,0:22:28.03,0:22:31.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku selalu menyaksikannya di sisimu.
Dialogue: 0,0:22:33.02,0:22:36.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.\NAku memang punya kemampuan,
Dialogue: 0,0:22:36.42,0:22:39.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi hatiku tidak sanggup menahannya.
Dialogue: 0,0:22:39.25,0:22:43.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dapat bertahan sampai sekarang\Nberkat Abbie dan Lydia.
Dialogue: 0,0:22:43.51,0:22:45.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu Ray juga.
Dialogue: 0,0:22:46.64,0:22:47.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:22:49.51,0:22:50.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin
Dialogue: 0,0:22:51.39,0:22:53.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Carol bahagia.
Dialogue: 0,0:22:59.07,0:23:02.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya aku bermimpi indah.
Dialogue: 0,0:23:04.40,0:23:07.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jalani hari dengan semangat lagi, yuk!
Dialogue: 0,0:23:11.29,0:23:12.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Ada apa?
Dialogue: 0,0:23:13.54,0:23:15.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kamu baik-baik saja?\N- Hei, bertahanlah!
Dialogue: 0,0:23:15.62,0:23:17.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya ini,
Dialogue: 0,0:23:17.04,0:23:18.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nate Hoskins?
Dialogue: 0,0:23:18.79,0:23:21.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diam, Albert Allium!
Dialogue: 0,0:23:21.55,0:23:23.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, hei!
Dialogue: 0,0:23:23.97,0:23:26.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dilarang berkelahi!
Dialogue: 0,0:23:26.05,0:23:28.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tidak baik!\NKalian harus akur!
Dialogue: 0,0:23:28.76,0:23:30.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:23:30.06,0:23:32.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berisik! Diam!
Dialogue: 0,0:23:32.22,0:23:34.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar emak-emak pink gatelan cerewet!
Dialogue: 0,0:23:34.64,0:23:40.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Emak-emak!
Dialogue: 0,0:23:41.44,0:23:44.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Murid laknat!
Dialogue: 0,0:23:48.82,0:23:52.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Carol Caroline, sedang patah hati stadium empat.
Dialogue: 0,0:23:52.33,0:23:53.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum genap setahun mengajar.
Dialogue: 0,0:23:53.83,0:23:55.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baru kali ini dibentak murid.
Dialogue: 0,0:23:55.54,0:23:57.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cerewet! Diam!
Dialogue: 0,0:23:57.17,0:23:58.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan berkelahi!
Dialogue: 0,0:23:58.08,0:23:59.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan urusanmu!
Dialogue: 0,0:23:59.04,0:24:01.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akademi kacau, gadis cantik itu\Nmuncul dengan gagahnya?
Dialogue: 0,0:24:01.13,0:24:02.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Secantik bunga bakung dan seputih salju!
Dialogue: 0,0:24:02.84,0:24:05.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya,\NPenyihir Pedang Es akan Menguasai Dunia...
Dialogue: 0,0:24:05.30,0:24:07.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dua!
Dialogue: 0,0:24:07.01,0:24:09.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bakung mekar di episode sembilan!
Dialogue: 0,0:24:09.43,0:24:12.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Gadis yang Merupakan Penyihir Terkuat\Ndi Dunia Mengawal Tuan Putri!"
