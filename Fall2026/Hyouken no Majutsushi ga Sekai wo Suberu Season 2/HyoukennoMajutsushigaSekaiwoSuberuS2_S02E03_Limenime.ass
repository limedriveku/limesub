Dialogue: 0,0:02:54.45,0:02:58.41,sign,,0000,0000,0000,,PENYIHIR PEDANG ES\NAKAN MENGUASAI DUNIA SEASON 2
Dialogue: 0,0:02:58.83,0:03:02.95,sign,,0000,0000,0000,,EPISODE 3: PEMUDA YANG MERUPAKAN PENYIHIR TERKUAT\NDI DUNIA BERDIRI BERSAMA KAWAN-KAWANNYA
Dialogue: 0,0:08:38.75,0:08:40.33,sign,,0000,0000,0000,,U.S.A!
Dialogue: 0,0:17:55.39,0:17:57.14,sign,,0000,0000,0000,,BRUAK!
Dialogue: 0,0:23:48.74,0:23:53.79,sign,,0000,0000,0000,,PRATINJAU
Dialogue: 0,0:00:02.57,0:00:04.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, absen dimulai!
Dialogue: 0,0:00:04.03,0:00:05.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu!
Dialogue: 0,0:00:07.99,0:00:09.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sersan Pelatihan Ariane?
Dialogue: 0,0:00:10.82,0:00:12.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sersan Pelatihan Ariane!
Dialogue: 0,0:00:12.12,0:00:12.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:00:13.24,0:00:15.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan lengah meski masih pagi buta.
Dialogue: 0,0:00:15.63,0:00:17.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sini, lengah bisa berakibat kematian!
Dialogue: 0,0:00:18.33,0:00:19.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ranger!
Dialogue: 0,0:00:19.37,0:00:20.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Absen diulangi!
Dialogue: 0,0:00:20.92,0:00:21.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu!
Dialogue: 0,0:00:21.92,0:00:23.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dua!
Dialogue: 0,0:00:23.75,0:00:24.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus!
Dialogue: 0,0:00:24.67,0:00:26.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, kita mulai pelatihan hari ini!
Dialogue: 0,0:00:27.51,0:00:30.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa karena masih pagi, ya?
Dialogue: 0,0:00:30.18,0:00:34.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Black... Ray terlihat lebih\Nberkilauan dari biasanya.
Dialogue: 0,0:00:35.33,0:00:37.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mbak Ariane demam, ya?
Dialogue: 0,0:00:37.77,0:00:39.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak apa-apa?
Dialogue: 0,0:00:39.44,0:00:42.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku tidak demam, kok.
Dialogue: 0,0:00:43.19,0:00:46.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini, aku sehat sentosa!
Dialogue: 0,0:00:46.15,0:00:48.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sentosa... Sentosa...
Dialogue: 0,0:00:48.70,0:00:50.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:00:50.57,0:00:52.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari kecil kelihatan besarnya.
Dialogue: 0,0:00:53.20,0:00:56.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita dapat info penting, nih!
Dialogue: 0,0:00:56.95,0:00:58.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Maria.
Dialogue: 0,0:00:58.71,0:01:00.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Maria!
Dialogue: 0,0:01:01.21,0:01:02.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Ada apa?
Dialogue: 0,0:01:02.50,0:01:04.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong sampaikan!
Dialogue: 0,0:01:16.47,0:01:18.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesuai dugaan.
Dialogue: 0,0:01:18.64,0:01:20.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harus segera kudatangi!
Dialogue: 0,0:01:25.48,0:01:26.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meluncur!
Dialogue: 0,0:01:29.82,0:01:31.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibunda?
Dialogue: 0,0:01:31.49,0:01:32.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rebecca.
Dialogue: 0,0:01:33.32,0:01:34.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau pergi ke mana?
Dialogue: 0,0:01:34.99,0:01:40.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak...\NSaya tidak berniat ke mana-mana...
Dialogue: 0,0:01:40.00,0:01:43.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertemuannya akan segera dimulai.\NLekaslah berganti pakaian!
Dialogue: 0,0:01:43.75,0:01:47.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga, penampilan macam apa itu?
Dialogue: 0,0:01:48.84,0:01:50.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa...
Dialogue: 0,0:02:39.06,0:02:41.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya, Abby ke mana?
Dialogue: 0,0:02:41.14,0:02:43.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mbak Abby kan jadi Ketua Panitia.
Dialogue: 0,0:02:43.31,0:02:45.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama masa turnamen,\Ndia akan sangat sibuk.
Dialogue: 0,0:02:45.81,0:02:47.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti berat.
Dialogue: 0,0:02:47.15,0:02:48.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Senior.
Dialogue: 0,0:02:48.31,0:02:49.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita mau pergi ke mana?
Dialogue: 0,0:02:49.73,0:02:51.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempat yang sepi.
Dialogue: 0,0:03:19.39,0:03:22.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mbak Ariane, kamu tidak apa-apa?
Dialogue: 0,0:03:22.27,0:03:25.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apa...
Dialogue: 0,0:03:27.23,0:03:29.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya, aku tidak apa-apa.
Dialogue: 0,0:03:29.98,0:03:31.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sersan Pelatihan Ariane!
Dialogue: 0,0:03:32.02,0:03:35.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Magicus War adalah\Npertempuran gerilya multipersonel.
Dialogue: 0,0:03:35.53,0:03:37.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selalu waspadai sekelilingmu!
Dialogue: 0,0:03:37.28,0:03:39.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan lupa menjaga jangkauan pandangmu!
Dialogue: 0,0:03:41.16,0:03:43.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anggap dirimu bisa mati\Nkalau tidak melakukannya.
Dialogue: 0,0:03:43.66,0:03:45.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ranger!
Dialogue: 0,0:03:45.25,0:03:46.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, kita lanjutkan!
Dialogue: 0,0:03:46.66,0:03:47.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ranger...
Dialogue: 0,0:03:49.17,0:03:50.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:03:50.67,0:03:53.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, tidak...
Dialogue: 0,0:03:54.26,0:03:55.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ariane?
Dialogue: 0,0:03:55.88,0:03:56.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eng...
Dialogue: 0,0:03:56.67,0:03:58.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu... Anu...
Dialogue: 0,0:03:59.43,0:04:00.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu demam?
Dialogue: 0,0:04:00.43,0:04:01.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak...
Dialogue: 0,0:04:01.18,0:04:03.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku baik-baik saja, kok!
Dialogue: 0,0:04:04.46,0:04:06.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, kalau begitu kita lanjut!
Dialogue: 0,0:04:06.43,0:04:07.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ranger!
Dialogue: 0,0:04:09.69,0:04:11.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa sebenarnya ini?
Dialogue: 0,0:04:11.61,0:04:14.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gejolak tiada henti dalam dadaku ini?
Dialogue: 0,0:04:20.70,0:04:22.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita lanjutkan.
Dialogue: 0,0:04:38.22,0:04:40.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, Ariane.
Dialogue: 0,0:04:40.22,0:04:41.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana pergerakanmu?
Dialogue: 0,0:04:44.22,0:04:45.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kena!
Dialogue: 0,0:04:49.10,0:04:52.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cih, padahal sedikit lagi.
Dialogue: 0,0:04:52.06,0:04:52.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Stella.
Dialogue: 0,0:04:53.48,0:04:55.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu bersuara.
Dialogue: 0,0:04:55.15,0:04:57.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu akan membuat lawan menyadarimu.
Dialogue: 0,0:04:57.07,0:04:58.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya, iya!
Dialogue: 0,0:04:59.57,0:05:01.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saking serunya, jadi keceplosan.
Dialogue: 0,0:05:01.49,0:05:03.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan lebih hati-hati.
Dialogue: 0,0:05:03.24,0:05:04.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:05:04.16,0:05:05.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke...
Dialogue: 0,0:05:05.62,0:05:07.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Adikku memang jempolan.
Dialogue: 0,0:05:07.75,0:05:12.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saking imutnya, aku sampai tak kuasa\Ningin mengelus kepalanya.
Dialogue: 0,0:05:14.59,0:05:16.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ray...
Dialogue: 0,0:05:16.46,0:05:17.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:05:17.88,0:05:21.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa ini terlalu memalukan...
Dialogue: 0,0:05:21.51,0:05:23.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau bagaimana lagi?
Dialogue: 0,0:05:23.55,0:05:25.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu memang ada benarnya...
Dialogue: 0,0:05:25.76,0:05:27.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aksimu hari ini sangat bagus.
Dialogue: 0,0:05:27.60,0:05:30.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benar-benar merasa mau mati.
Dialogue: 0,0:05:30.27,0:05:34.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sanggup sejam kabur dariku\Ndan Abang itu hebat banget!
Dialogue: 0,0:05:34.15,0:05:36.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, kamu melaluinya dengan baik.
Dialogue: 0,0:05:37.36,0:05:40.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau menyerah di sini,\Njatuhlah harga diriku sebagai gadis.
Dialogue: 0,0:05:40.95,0:05:42.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Ray.
Dialogue: 0,0:05:42.20,0:05:43.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:05:43.86,0:05:46.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku telah menjadi lebih kuat?
Dialogue: 0,0:05:46.78,0:05:48.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja.
Dialogue: 0,0:05:48.04,0:05:51.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya dalam dua hari, kamu mampu\Nmenghindari kami bersaudara.
Dialogue: 0,0:05:51.54,0:05:53.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bukti perkembanganmu.
Dialogue: 0,0:05:54.42,0:05:56.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya...
Dialogue: 0,0:06:00.27,0:06:02.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maju kalau berani...
Dialogue: 0,0:06:10.06,0:06:11.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ray...
Dialogue: 0,0:06:11.56,0:06:12.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti kedinginan.
Dialogue: 0,0:06:13.02,0:06:15.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:06:16.73,0:06:18.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak boleh begini.
Dialogue: 0,0:06:18.32,0:06:19.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm?
Dialogue: 0,0:06:19.48,0:06:22.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku selalu kecolongan dari belakang.
Dialogue: 0,0:06:22.49,0:06:24.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedang memikirkan sesuatu?
Dialogue: 0,0:06:24.78,0:06:27.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belum menyampaikannya\Ndengan benar, ya.
Dialogue: 0,0:06:27.24,0:06:29.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alasanku mengajakmu.
Dialogue: 0,0:06:30.41,0:06:34.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin bertempur bertiga\Nbersamamu dan Amelia.
Dialogue: 0,0:06:34.67,0:06:36.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang paling penting...
Dialogue: 0,0:06:37.50,0:06:39.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin mengubah diri sendiri.
Dialogue: 0,0:06:41.34,0:06:47.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin menjadi teladan bagi Amelia\Nyang ragu akan cara hidup bangsawan.
Dialogue: 0,0:06:47.35,0:06:50.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanpa memperlihatkan kelemahanku,\Ndan terus maju...
Dialogue: 0,0:06:50.97,0:06:53.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menjadi kuat...
Dialogue: 0,0:06:53.60,0:06:55.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kupikir itu kulakukan demi Amelia
Dialogue: 0,0:06:55.85,0:06:58.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebagai kewajiban seorang sahabat.
Dialogue: 0,0:06:59.98,0:07:00.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetapi...
Dialogue: 0,0:07:01.69,0:07:06.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bakat Amelia jauh lebih mengagumkan\Ndibandingkan milikku.
Dialogue: 0,0:07:06.99,0:07:10.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pun tersadar bahwa\Nselama ini aku terlalu besar kepala.
Dialogue: 0,0:07:11.74,0:07:14.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diri ini yang iri pada bakatnya
Dialogue: 0,0:07:14.87,0:07:17.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hanyalah keberadaan kecil\Nyang tak berarti.
Dialogue: 0,0:07:18.13,0:07:22.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang mengubah Amelia,\Ndan menyelamatkan hatinya
Dialogue: 0,0:07:22.71,0:07:24.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah kamu, Ray.
Dialogue: 0,0:07:25.63,0:07:30.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku merasa, kalau mengikutimu\Naku pun bisa berubah.
Dialogue: 0,0:07:31.68,0:07:34.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Egois sekali, bukan?
Dialogue: 0,0:07:34.89,0:07:36.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ariane.
Dialogue: 0,0:07:37.13,0:07:39.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetap menghadap ke sana,\Ndan dengarkan aku.
Dialogue: 0,0:07:39.65,0:07:43.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasa iri pada orang lain\Nbukanlah sesuatu yang memalukan.
Dialogue: 0,0:07:44.15,0:07:46.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iri pada mereka yang hidup damai...
Dialogue: 0,0:07:46.65,0:07:50.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sendiri terkadang sangat membenci diriku.
Dialogue: 0,0:07:52.41,0:07:55.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di saat seperti itulah\Nkita boleh mengandalkan orang lain.
Dialogue: 0,0:07:57.50,0:07:59.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa boleh begitu?
Dialogue: 0,0:08:03.30,0:08:04.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:08:04.84,0:08:05.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ray...
Dialogue: 0,0:08:06.92,0:08:08.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:08:12.10,0:08:13.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ariane.
Dialogue: 0,0:08:13.26,0:08:14.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Besok kita harus bangun pagi.
Dialogue: 0,0:08:15.43,0:08:16.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita kembali.
Dialogue: 0,0:08:17.56,0:08:18.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu.
Dialogue: 0,0:08:18.52,0:08:19.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, kembali.
Dialogue: 0,0:08:22.06,0:08:23.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:08:23.52,0:08:25.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini...
Dialogue: 0,0:08:25.07,0:08:29.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh aku menggenggam tanganmu\Nsampai kembali ke kamar?
Dialogue: 0,0:08:30.53,0:08:31.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu boleh.
Dialogue: 0,0:08:31.82,0:08:33.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Besok, ayo berjuang lagi.
Dialogue: 0,0:08:34.95,0:08:35.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:08:41.28,0:08:43.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertanda buruk...
Dialogue: 0,0:08:50.22,0:08:51.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Amelia?
Dialogue: 0,0:08:53.22,0:08:55.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Liselotte.
Dialogue: 0,0:08:55.14,0:08:56.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu baik-baik saja?
Dialogue: 0,0:08:57.56,0:08:59.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik-baik saja, kok.
Dialogue: 0,0:08:59.06,0:09:00.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedang membaca?
Dialogue: 0,0:09:00.31,0:09:01.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah!
Dialogue: 0,0:09:01.31,0:09:03.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Lise juga membacanya, ya,\Nkarya Luna Etel?
Dialogue: 0,0:09:04.57,0:09:05.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:09:05.65,0:09:07.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu juga suka?
Dialogue: 0,0:09:07.49,0:09:12.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena Ray, aku jadi menggemarinya.
Dialogue: 0,0:09:12.41,0:09:15.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, suatu kehormatan.
Dialogue: 0,0:09:15.12,0:09:15.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:09:15.99,0:09:19.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak pernah mendapatkan kesempatan\Nbertemu langsung dengan pembacaku.
Dialogue: 0,0:09:20.58,0:09:21.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan.
Dialogue: 0,0:09:24.50,0:09:27.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini novel baru yang belum diterbitkan.
Dialogue: 0,0:09:27.25,0:09:28.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:09:28.13,0:09:30.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuberikan padamu.
Dialogue: 0,0:09:30.01,0:09:30.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:09:30.63,0:09:35.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Novelis romansa misterius yang identitasnya\Ntak diketahui, Luna Etel.
Dialogue: 0,0:09:36.39,0:09:37.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah aku.
Dialogue: 0,0:09:37.64,0:09:41.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:09:46.27,0:09:50.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak akan menyerah!\NAkan kudaratkan satu serangan!
Dialogue: 0,0:10:05.25,0:10:07.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak apa-apa, Al?
Dialogue: 0,0:10:09.13,0:10:11.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, kurasa...
Dialogue: 0,0:10:11.47,0:10:12.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Albert.
Dialogue: 0,0:10:15.05,0:10:16.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa bicara sebentar?
Dialogue: 0,0:10:20.56,0:10:23.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wus!
Dialogue: 0,0:10:23.64,0:10:26.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlalu lambat, Sersan Pelatihan Ariane!
Dialogue: 0,0:10:34.41,0:10:36.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh juga kemampuannya.
Dialogue: 0,0:10:39.49,0:10:40.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Catat-catat.
Dialogue: 0,0:10:47.92,0:10:49.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh juga...
Dialogue: 0,0:11:09.11,0:11:11.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama 14 hari pelatihan,
Dialogue: 0,0:11:11.28,0:11:13.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalian telah berjuang keras.
Dialogue: 0,0:11:13.28,0:11:14.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ranger!
Dialogue: 0,0:11:14.78,0:11:16.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan ini, pelatihan terakhir dimulai!
Dialogue: 0,0:11:16.70,0:11:18.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ranger!
Dialogue: 0,0:11:18.45,0:11:22.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sersan Pelatihan Ariane akan membentuk tim\Nbersama Sister White Grey.
Dialogue: 0,0:11:22.45,0:11:23.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ranger!
Dialogue: 0,0:11:23.70,0:11:25.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diizinkan menggunakan sihir!
Dialogue: 0,0:11:25.96,0:11:28.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di kedalaman Hutan Dogma,
Dialogue: 0,0:11:28.29,0:11:30.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan menunggu kalian\Ndi bawah Pohon Dinsetsu.
Dialogue: 0,0:11:30.71,0:11:33.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu persiapan dan tekad kalian bulat,
Dialogue: 0,0:11:33.01,0:11:34.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kerahkan seluruh kemampuan kalian
Dialogue: 0,0:11:34.72,0:11:36.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan gugurkan mawar yang ada di dadaku!
Dialogue: 0,0:11:36.97,0:11:38.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ranger!
Dialogue: 0,0:11:38.89,0:11:40.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita mulai, Tuan Black!
Dialogue: 0,0:11:41.97,0:11:42.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ogre!
Dialogue: 0,0:11:53.23,0:11:55.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bertahanlah dengan sekuat tenaga!
Dialogue: 0,0:12:12.59,0:12:13.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini...
Dialogue: 0,0:12:14.17,0:12:15.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teknik Pergantian?
Dialogue: 0,0:12:15.09,0:12:17.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ciat!
Dialogue: 0,0:12:17.51,0:12:18.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jedor!
Dialogue: 0,0:12:20.59,0:12:21.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Stella!
Dialogue: 0,0:12:21.55,0:12:22.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mbak Ariane!
Dialogue: 0,0:12:22.76,0:12:26.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang, Mbak Ariane!
Dialogue: 0,0:12:32.52,0:12:35.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mbak Ariane, aku enggak sanggup lagi!
Dialogue: 0,0:12:35.19,0:12:37.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ranger!
Dialogue: 0,0:12:38.32,0:12:40.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ogre: Scintilla!
Dialogue: 0,0:12:52.79,0:12:54.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus, Sersan Pelatihan Ariane!
Dialogue: 0,0:12:54.96,0:12:57.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mbak Ariane, kita berhasil!
Dialogue: 0,0:12:57.26,0:13:00.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan ini, Bootcamp Ala Ainsworth
Dialogue: 0,0:13:00.05,0:13:03.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bab pelatihan bertahan hidup\Ndinyatakan selesai!
Dialogue: 0,0:13:06.31,0:13:09.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ranger!
Dialogue: 0,0:13:15.82,0:13:19.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Butterfly Effect-mu makin berkembang, ya.
Dialogue: 0,0:13:19.19,0:13:20.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus.
Dialogue: 0,0:13:24.62,0:13:29.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin kamu bisa membangkitkannya\Nkarena memang sudah takdirnya.
Dialogue: 0,0:13:29.62,0:13:30.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:13:30.21,0:13:32.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak perlu datang ke sini lagi.
Dialogue: 0,0:13:32.75,0:13:34.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa sudah selesai?
Dialogue: 0,0:13:34.92,0:13:35.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:13:35.96,0:13:38.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku telah mengajarkan dasarnya.
Dialogue: 0,0:13:38.51,0:13:40.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya tergantung padamu.
Dialogue: 0,0:13:40.67,0:13:43.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Utang budiku pada Ray White pun\Nsudah terbalas.
Dialogue: 0,0:13:43.34,0:13:46.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, apa hubungan Anda dengan Ray?
Dialogue: 0,0:13:46.10,0:13:47.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kekasihnya.
Dialogue: 0,0:13:47.22,0:13:48.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:13:49.93,0:13:51.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma bercanda.
Dialogue: 0,0:13:51.52,0:13:54.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hubungan kami tak perlu kamu cemaskan.
Dialogue: 0,0:13:54.73,0:13:57.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ja-Jangan bercanda, dong.
Dialogue: 0,0:13:57.02,0:14:00.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Candaanmu itu susah dipahami, tahu.
Dialogue: 0,0:14:00.11,0:14:01.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:14:01.61,0:14:03.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya saja, meski dari kalangan Ordinary,
Dialogue: 0,0:14:03.78,0:14:07.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia adalah Tujuh Penyihir Agung\Ntermuda sepanjang sejarah.
Dialogue: 0,0:14:07.12,0:14:10.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perjodohanmu dengannya pasti dapat diterima.
Dialogue: 0,0:14:10.04,0:14:11.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perjodohan?
Dialogue: 0,0:14:11.25,0:14:12.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutku kalian serasi.
Dialogue: 0,0:14:14.54,0:14:16.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya?
Dialogue: 0,0:14:16.04,0:14:18.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, aku akan mendukungmu.
Dialogue: 0,0:14:18.63,0:14:20.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh...
Dialogue: 0,0:14:22.55,0:14:25.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga kamu beruntung.
Dialogue: 0,0:14:25.48,0:14:28.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski hanya sebentar,\Nterima kasih atas segalanya.
Dialogue: 0,0:14:28.89,0:14:30.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terasa singkat sekali, ya.
Dialogue: 0,0:14:30.64,0:14:32.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami pasti merindukanmu.
Dialogue: 0,0:14:32.52,0:14:34.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mbak Ariane.
Dialogue: 0,0:14:34.14,0:14:35.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya?
Dialogue: 0,0:14:35.02,0:14:36.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semangat, ya.
Dialogue: 0,0:14:36.19,0:14:38.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:14:38.02,0:14:40.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik...
Dialogue: 0,0:14:41.78,0:14:45.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Abang, aku pasti datang mendukung kalian!
Dialogue: 0,0:14:45.45,0:14:47.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu harus menang, Mbak Ariane!
Dialogue: 0,0:14:47.78,0:14:49.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, pastinya!
Dialogue: 0,0:14:49.41,0:14:50.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, tentu saja.
Dialogue: 0,0:14:52.70,0:14:53.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo berangkat.
Dialogue: 0,0:14:55.08,0:14:56.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:15:00.00,0:15:00.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari
Dialogue: 0,0:15:00.67,0:15:02.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita juga pulang.
Dialogue: 0,0:15:02.67,0:15:04.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya bisa pulang...
Dialogue: 0,0:15:04.51,0:15:05.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian sedang apa?
Dialogue: 0,0:15:05.76,0:15:06.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waduh!
Dialogue: 0,0:15:07.01,0:15:09.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian bukan orang sini, kan?
Dialogue: 0,0:15:09.51,0:15:11.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eng...
Dialogue: 0,0:15:11.01,0:15:12.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu...
Dialogue: 0,0:15:12.56,0:15:13.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami...
Dialogue: 0,0:15:13.68,0:15:14.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini...
Dialogue: 0,0:15:14.39,0:15:15.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu...
Dialogue: 0,0:15:15.23,0:15:15.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apanya?
Dialogue: 0,0:15:15.94,0:15:17.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa enggak sakit?
Dialogue: 0,0:15:17.69,0:15:19.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, iya...
Dialogue: 0,0:15:19.69,0:15:21.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keren banget!
Dialogue: 0,0:15:21.61,0:15:23.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Ah, terima kasih.
Dialogue: 0,0:15:25.70,0:15:28.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami harus pulang ke negeri kami!
Dialogue: 0,0:15:28.03,0:15:29.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, selamat tinggal!
Dialogue: 0,0:15:29.95,0:15:30.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei!
Dialogue: 0,0:15:32.33,0:15:34.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lah?
Dialogue: 0,0:15:42.13,0:15:43.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo berjuang!
Dialogue: 0,0:15:43.09,0:15:44.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ranger!
Dialogue: 0,0:15:54.47,0:15:57.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ariane?
Dialogue: 0,0:15:57.52,0:15:58.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya!
Dialogue: 0,0:15:58.98,0:16:02.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Turnamennya benaran terasa\Nmau mulai, Elisa!
Dialogue: 0,0:16:02.77,0:16:03.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya...
Dialogue: 0,0:16:03.82,0:16:05.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kenapa?
Dialogue: 0,0:16:05.65,0:16:06.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm...
Dialogue: 0,0:16:06.74,0:16:09.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga...
Dialogue: 0,0:16:13.49,0:16:16.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, ajang Magicus War pertama\Nakan digelar!
Dialogue: 0,0:16:16.41,0:16:20.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arena telah dipadati antusiasme\Npenonton sejak penyisihan pertama!
Dialogue: 0,0:16:20.50,0:16:22.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, gugup banget.
Dialogue: 0,0:16:22.67,0:16:25.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya ampun, kenapa kamu ikutan gugup?
Dialogue: 0,0:16:25.88,0:16:27.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah siap, kan?\NAyo mulai!
Dialogue: 0,0:16:27.67,0:16:28.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aye aye, sir!
Dialogue: 0,0:16:28.68,0:16:30.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tu, wa...
Dialogue: 0,0:16:30.01,0:16:33.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Amelia, semangat!
Dialogue: 0,0:16:33.31,0:16:35.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya dimulai, ya, Elisa!
Dialogue: 0,0:16:35.02,0:16:35.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:16:35.68,0:16:37.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu kita akan mendukung\Ntimnya Mas Ray...
Dialogue: 0,0:16:37.68,0:16:39.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Timnya Evi dan Albert juga, ya!
Dialogue: 0,0:16:39.35,0:16:40.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:16:40.94,0:16:43.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, gede banget!
Dialogue: 0,0:16:43.15,0:16:45.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arenanya keren banget!
Dialogue: 0,0:16:45.28,0:16:48.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, yang datang sampai sebanyak ini.
Dialogue: 0,0:16:48.20,0:16:50.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, ini melebihi bayanganku...
Dialogue: 0,0:16:50.66,0:16:52.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cari Tante Lydia dulu, ya!
Dialogue: 0,0:16:52.95,0:16:54.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Stella!
Dialogue: 0,0:16:54.16,0:16:55.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, anak itu...
Dialogue: 0,0:16:56.79,0:17:00.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, tiketnya kan sudah diberikan padanya,\Nkita tunggu di kursi penonton saja.
Dialogue: 0,0:17:00.12,0:17:01.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh.
Dialogue: 0,0:17:01.25,0:17:04.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, Lise dan yang lain mana, ya?
Dialogue: 0,0:17:04.54,0:17:06.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sendirian, ya?
Dialogue: 0,0:17:06.13,0:17:06.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:17:06.92,0:17:09.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu enggak bersama ayah dan ibumu?
Dialogue: 0,0:17:10.33,0:17:12.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau kubantu cari?
Dialogue: 0,0:17:12.14,0:17:13.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu khawatir.
Dialogue: 0,0:17:13.84,0:17:14.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:17:14.43,0:17:16.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih atas perhatianmu.
Dialogue: 0,0:17:16.89,0:17:19.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh mengagumkan meski masih muda.
Dialogue: 0,0:17:19.43,0:17:22.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma ada satu...
Dialogue: 0,0:17:22.27,0:17:25.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ajang ini dipimpin oleh\NKetiga Keluarga Besar
Dialogue: 0,0:17:25.94,0:17:29.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}serta dihadiri banyak\Ntamu undangan kehormatan.
Dialogue: 0,0:17:29.49,0:17:30.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang terutama,
Dialogue: 0,0:17:30.95,0:17:34.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putri Kedua Olivia Arnold\Ndari Keluarga Kerajaan Arnold...
Dialogue: 0,0:17:34.47,0:17:36.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- berkenan hadir di tengah kita.\N- Rebecca dan Maria ke mana, sih?
Dialogue: 0,0:17:36.16,0:17:38.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Hadirin, beri tepuk tangan\N- Rebecca dan Maria ke mana, sih?
Dialogue: 0,0:17:38.45,0:17:40.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}meriah kepada Tuan Putri!
Dialogue: 0,0:17:41.50,0:17:42.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada!
Dialogue: 0,0:17:42.46,0:17:44.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Putri Olivia tidak ada di tempat!
Dialogue: 0,0:17:44.25,0:17:45.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa katamu?
Dialogue: 0,0:17:45.46,0:17:47.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ca... Ca-Ca-Ca...
Dialogue: 0,0:17:47.34,0:17:48.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cari!
Dialogue: 0,0:17:50.01,0:17:54.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ada di tempat sekaku itu,\Naku enggak bisa mendukung Ray, tahu.
Dialogue: 0,0:17:54.51,0:17:55.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah... Eh?
Dialogue: 0,0:17:58.43,0:18:00.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak apa-apa?
Dialogue: 0,0:18:01.56,0:18:03.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, iya...
Dialogue: 0,0:18:06.32,0:18:09.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekali lagi, komentator\Nuntuk kompetisi kali ini adalah saya,
Dialogue: 0,0:18:09.86,0:18:13.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dina Sera dari Akademi Sihir Arnold,
Dialogue: 0,0:18:13.20,0:18:16.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan analisisnya dipandu oleh Kyaro-Kyaro!
Dialogue: 0,0:18:16.20,0:18:17.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kyapin!
Dialogue: 0,0:18:17.33,0:18:19.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, Profesor Caroline...
Dialogue: 0,0:18:19.54,0:18:20.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa, ya?
Dialogue: 0,0:18:20.58,0:18:22.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beliau-beliau ini siapa?
Dialogue: 0,0:18:22.21,0:18:23.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ditanya, tuh.
Dialogue: 0,0:18:23.29,0:18:24.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak perlu dipedulikan.
Dialogue: 0,0:18:24.42,0:18:27.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma si Paling Super Ultra Duper Cantik\Nyang kebetulan lewat.
Dialogue: 0,0:18:27.46,0:18:29.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya maid cekatan\Nyang kebetulan berada di sini.
Dialogue: 0,0:18:29.71,0:18:31.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anggap kami tidak ada,\Ndalam berbagai artian.
Dialogue: 0,0:18:32.47,0:18:34.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya sudahlah.
Dialogue: 0,0:18:34.05,0:18:34.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu...
Dialogue: 0,0:18:34.84,0:18:36.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Rebecca sendiri?
Dialogue: 0,0:18:36.47,0:18:39.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kursi khusus bangsawan\Nterlalu jauh dari panggung,
Dialogue: 0,0:18:39.22,0:18:42.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menurutku paling pas menonton\Ndari barisan paling depan.
Dialogue: 0,0:18:42.98,0:18:44.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula...
Dialogue: 0,0:18:44.81,0:18:47.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ada banyak hal yang perlu kupastikan.\N- Kinokoon!
Dialogue: 0,0:18:47.73,0:18:49.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be-Begitu, ya...
Dialogue: 0,0:18:49.48,0:18:50.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kinokoon!
Dialogue: 0,0:18:50.23,0:18:53.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lise, tidak kusangka kamu akan datang.
Dialogue: 0,0:18:53.65,0:18:55.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku agak kaget.
Dialogue: 0,0:18:55.07,0:18:56.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya?
Dialogue: 0,0:18:56.16,0:18:57.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kaget banget...
Dialogue: 0,0:18:57.37,0:18:58.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berisik, Gumpalan Pink.
Dialogue: 0,0:18:59.24,0:19:01.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kyaro-Kyaro enggak berisik, kok.
Dialogue: 0,0:19:01.41,0:19:02.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mangap dikit saja sudah berisik.
Dialogue: 0,0:19:02.83,0:19:05.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mbak Lydia selalu aja begini!
Dialogue: 0,0:19:05.50,0:19:07.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu agak berubah, ya.
Dialogue: 0,0:19:07.83,0:19:09.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya?
Dialogue: 0,0:19:09.25,0:19:11.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, bagus, kan?
Dialogue: 0,0:19:11.17,0:19:12.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kyaro-Kyaro juga setuju!
Dialogue: 0,0:19:12.26,0:19:13.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berisik, Gumpalan Pink.
Dialogue: 0,0:19:14.42,0:19:15.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:19:15.38,0:19:17.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu adiknya Ray...
Dialogue: 0,0:19:17.09,0:19:19.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, Ray White itu abangku.
Dialogue: 0,0:19:23.27,0:19:26.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita berteman, Stella White!
Dialogue: 0,0:19:26.10,0:19:27.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang dan selamanya!
Dialogue: 0,0:19:27.52,0:19:29.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, selamanya!
Dialogue: 0,0:19:31.53,0:19:32.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo, ada Maria.
Dialogue: 0,0:19:32.98,0:19:34.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Putri Olivia?
Dialogue: 0,0:19:34.69,0:19:35.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah!
Dialogue: 0,0:19:36.61,0:19:39.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm? Kenapa?\NKalian saling kenal?
Dialogue: 0,0:19:39.37,0:19:41.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu...
Dialogue: 0,0:19:42.29,0:19:45.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, saya akan jelaskan\Naturan turnamen ini.
Dialogue: 0,0:19:45.54,0:19:48.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lokasi pertempuran ada di kastel tua\Ndi dekat perbatasan.
Dialogue: 0,0:19:48.38,0:19:50.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu tim terdiri dari tiga orang!
Dialogue: 0,0:19:50.63,0:19:53.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka akan berebut lima Artefak Sihir\Nyang ditempatkan di dalam kastel,
Dialogue: 0,0:19:53.73,0:19:57.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tim yang menguasai paling banyak dalam\Nbatas waktu itulah pemenangnya.
Dialogue: 0,0:19:58.89,0:20:03.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Artefak Sihirnya harus diisi prima materia\Ndalam jumlah tertentu!
Dialogue: 0,0:20:03.89,0:20:07.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengisiannya perlu dilakukan\Ndalam jangka waktu yang sudah ditentukan.
Dialogue: 0,0:20:07.02,0:20:08.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:20:08.31,0:20:11.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi tidak sepenuhnya bergantung pada\Nkemampuan individu. Cukup adil, ya.
Dialogue: 0,0:20:11.98,0:20:16.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena yang bertugas mengisi\Nakan kehilangan pertahanan.
Dialogue: 0,0:20:16.28,0:20:20.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pembagian tugas bertahan dan menyerang\Ndalam tim sangatlah diperlukan.
Dialogue: 0,0:20:20.41,0:20:21.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti itu, kan?
Dialogue: 0,0:20:21.66,0:20:22.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:20:22.78,0:20:26.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertempuran ini tak sekadar membutuhkan\Nkekuatan tempur, tapi strategi juga.
Dialogue: 0,0:20:29.04,0:20:31.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah! Berhasil, Al!
Dialogue: 0,0:20:31.67,0:20:34.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mas Evi, macho banget, deh!
Dialogue: 0,0:20:34.34,0:20:35.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Zuina?
Dialogue: 0,0:20:36.47,0:20:37.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Al...
Dialogue: 0,0:20:37.67,0:20:38.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kamu ini...
Dialogue: 0,0:20:39.84,0:20:42.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau seluruh lawan dilumpuhkan?
Dialogue: 0,0:20:42.60,0:20:45.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau itu terjadi, bukankah\Nkemenangannya dapat dipastikan?
Dialogue: 0,0:20:45.77,0:20:49.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kalau lawannya tumbang,\Nkita bisa bebas mengisi artefak.
Dialogue: 0,0:20:51.35,0:20:52.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semangat!
Dialogue: 0,0:20:52.27,0:20:53.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mas White!
Dialogue: 0,0:20:53.36,0:20:54.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Amelia!
Dialogue: 0,0:20:54.52,0:20:56.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang terbaik!
Dialogue: 0,0:20:56.28,0:20:57.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti jadi juara!
Dialogue: 0,0:20:57.86,0:21:01.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elisa! Sudah jelas timnya Ray\Nyang akan menguasai!
Dialogue: 0,0:21:01.36,0:21:03.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya! Mereka hebat sekali, ya!
Dialogue: 0,0:21:03.37,0:21:06.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, ternyata Ray sekuat itu, ya.
Dialogue: 0,0:21:06.37,0:21:07.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:21:07.79,0:21:11.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, cewek bernama Amelia itu\Nrivalnya Mbak Ariane...
Dialogue: 0,0:21:13.04,0:21:16.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para bangsawan tak berguna, saksikanlah!
Dialogue: 0,0:21:16.25,0:21:21.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inilah kebolehan Ray-ku yang dulu\Nkalian remehkan sebagai Ordinary!
Dialogue: 0,0:21:24.97,0:21:26.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu ada di sini?
Dialogue: 0,0:21:26.31,0:21:27.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo...
Dialogue: 0,0:21:28.64,0:21:30.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Mbah Fran.\N- Mbak Fran!
Dialogue: 0,0:21:30.39,0:21:33.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak boleh melewatkan\Npanggung kejayaan Ray.
Dialogue: 0,0:21:33.81,0:21:35.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, kan, Lise?
Dialogue: 0,0:21:35.23,0:21:37.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lama tak jumpa, Nyonya Fran.
Dialogue: 0,0:21:37.15,0:21:39.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Halah, mengganggu saja.\N- Sekarang nambah bocah.
Dialogue: 0,0:21:39.99,0:21:41.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Malas menanggapi.\N- Enggak asyik, ah.
Dialogue: 0,0:21:41.45,0:21:42.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, tuh, Mbak Lydia...
Dialogue: 0,0:21:42.82,0:21:44.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berisik, Gumpalan Pink.
Dialogue: 0,0:21:44.16,0:21:47.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, tak terasa\NMagicus War telah sampai di babak final!
Dialogue: 0,0:21:47.74,0:21:49.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dua tim yang memperebutkan gelar juara
Dialogue: 0,0:21:49.55,0:21:52.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah Tim Olgren pimpinan Mas Ray.
Dialogue: 0,0:21:52.12,0:21:52.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:21:54.00,0:21:56.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gerbang ke era baru telah terbuka!
Dialogue: 0,0:21:56.67,0:21:57.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si Cantik?
Dialogue: 0,0:21:57.42,0:21:59.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lawan mereka adalah Tim Forst!
Dialogue: 0,0:21:59.42,0:22:01.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Juara Magicus Chevalier sebelumnya!
Dialogue: 0,0:22:01.68,0:22:05.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Oh, jadi dia Lucas Forst!\N- Eh? Mbak Fran?
Dialogue: 0,0:22:06.85,0:22:08.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya pertandingan dimulai!
Dialogue: 0,0:22:12.44,0:22:15.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kedua pihak langsung melesat!
Dialogue: 0,0:22:15.19,0:22:17.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau seperti ini...
Dialogue: 0,0:22:17.07,0:22:18.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesuai dugaanku, Lucas Forst...
Dialogue: 0,0:22:18.69,0:22:20.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ray White!
Dialogue: 0,0:22:22.32,0:22:24.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang Es!
Dialogue: 0,0:22:24.57,0:22:26.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang Mutlak!
Dialogue: 0,0:22:32.12,0:22:36.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saksikan! Kedua pihak saling menebas\Ndan terus melesat maju!
Dialogue: 0,0:22:43.72,0:22:45.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya datang juga!
Dialogue: 0,0:22:45.26,0:22:46.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kami tunggu,
Dialogue: 0,0:22:47.01,0:22:48.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ray!
Dialogue: 0,0:23:48.74,0:23:49.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Evi!
Dialogue: 0,0:23:49.53,0:23:50.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Albert!
Dialogue: 0,0:23:50.37,0:23:52.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lucas Forst.
Dialogue: 0,0:23:52.04,0:23:53.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saatnya pratinjau episode berikutnya!
Dialogue: 0,0:23:53.79,0:23:54.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini!
Dialogue: 0,0:23:54.54,0:23:55.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya tiba!
Dialogue: 0,0:23:55.29,0:23:56.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semangat mantap!
Dialogue: 0,0:23:56.21,0:23:57.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, ayo!
Dialogue: 0,0:23:57.17,0:23:58.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertempuran panas!
Dialogue: 0,0:23:58.00,0:23:58.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Persaingan membara!
Dialogue: 0,0:23:58.83,0:24:00.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dada yang kulatih juga tebal!
Dialogue: 0,0:24:00.46,0:24:02.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paling tidak, semangat kita tersampaikan.
Dialogue: 0,0:24:02.42,0:24:03.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya!
Dialogue: 0,0:24:03.17,0:24:05.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyihir Pedang Es akan Menguasai Dunia...
Dialogue: 0,0:24:05.30,0:24:06.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dua!
Dialogue: 0,0:24:07.18,0:24:09.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami bertiga ditambah kamu,\Nepisode empat...
Dialogue: 0,0:24:09.09,0:24:11.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Pemuda yang Merupakan\NPenyihir Terkuat di Dunia
Dialogue: 0,0:24:11.55,0:24:13.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berinteraksi dengan Kawannya Melalui Tinju!"
