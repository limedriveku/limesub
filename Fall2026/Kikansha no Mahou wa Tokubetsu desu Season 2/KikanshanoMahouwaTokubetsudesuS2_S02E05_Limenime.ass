Dialogue: 0,0:01:43.96,0:01:48.46,sign,,0000,0000,0000,,SIHIR SANG PENGULANG JELAS ISTIMEWA\N- MUSIM KEDUA
Dialogue: 0,0:03:02.50,0:03:06.62,sign,,0000,0000,0000,,EPISODE 17: EROR
Dialogue: 0,0:23:40.52,0:23:45.47,sign,,0000,0000,0000,,EPISODE 18: PENYIHIR AGUNG
Dialogue: 0,0:00:18.83,0:00:20.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Clothesline...
Dialogue: 0,0:00:21.00,0:00:24.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian para bocah bangsawan\Ndari Akademi Hebrion, ya.
Dialogue: 0,0:00:25.17,0:00:27.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak punya dendam pada kalian...
Dialogue: 0,0:00:28.38,0:00:31.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, salahkan takdir kalian\Nkarena terlahir bangsawan.
Dialogue: 0,0:00:34.76,0:00:37.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menahan mereka dengan sihirku.
Dialogue: 0,0:00:37.60,0:00:38.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:00:39.52,0:00:41.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu, dua...
Dialogue: 0,0:00:41.98,0:00:42.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiga!
Dialogue: 0,0:00:50.57,0:00:51.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:00:56.37,0:00:57.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dinding Es!
Dialogue: 0,0:01:02.04,0:01:05.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu ini, setidaknya koordinasi\Ndengan kami dulu!
Dialogue: 0,0:01:05.88,0:01:07.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kuusahakan.
Dialogue: 0,0:01:16.22,0:01:18.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ciat!
Dialogue: 0,0:01:22.65,0:01:23.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian baik-baik saja?
Dialogue: 0,0:01:28.78,0:01:30.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya baik-baik saja...
Dialogue: 0,0:03:07.04,0:03:09.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harap berbaris!
Dialogue: 0,0:03:09.21,0:03:11.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang terluka harap kemari!
Dialogue: 0,0:03:18.43,0:03:21.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serangan Outer belum berakhir.
Dialogue: 0,0:03:21.31,0:03:22.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus bergegas!
Dialogue: 0,0:03:22.73,0:03:23.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu.
Dialogue: 0,0:03:23.81,0:03:25.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:03:25.23,0:03:27.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini hanya pengalihan?
Dialogue: 0,0:03:27.03,0:03:28.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemungkinan begitu.
Dialogue: 0,0:03:29.06,0:03:30.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jelaskan lebih lanjut.
Dialogue: 0,0:03:30.57,0:03:35.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serangan ke Rapat Kerajaan jelas mengincar\Npara perwakilan dari berbagai negara.
Dialogue: 0,0:03:35.87,0:03:39.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, tujuan dari keributan\Nyang mereka buat di kota tidaklah jelas.
Dialogue: 0,0:03:41.16,0:03:43.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mereka memang berniat\Nmenghancurkan tempat ini,
Dialogue: 0,0:03:43.74,0:03:45.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa dengan cara yang lebih efisien.
Dialogue: 0,0:03:47.42,0:03:51.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memblokade gerbang kota,\Nmenghancurkan jalur pasokan,
Dialogue: 0,0:03:51.59,0:03:53.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan kalau mereka ingin lebih banyak korban...
Dialogue: 0,0:03:53.80,0:03:55.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa saja menyerang sekolah,\Nrumah sakit,
Dialogue: 0,0:03:55.84,0:04:00.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bahkan Kejuaraan Laut Kuning hari ini.
Dialogue: 0,0:04:00.31,0:04:01.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, kan?
Dialogue: 0,0:04:02.60,0:04:05.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin musuh kita\Nmemiliki tujuan yang lebih besar.
Dialogue: 0,0:04:06.73,0:04:07.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jauh lebih besar.
Dialogue: 0,0:04:08.73,0:04:10.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku paham.
Dialogue: 0,0:04:10.73,0:04:11.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi!
Dialogue: 0,0:04:11.82,0:04:16.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak akan tinggal diam setelah mereka\Nberbuat seenaknya di kampung halamanku!
Dialogue: 0,0:04:17.32,0:04:18.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar sekali.
Dialogue: 0,0:04:19.31,0:04:21.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk sekarang, kita selamatkan orang-orang.
Dialogue: 0,0:04:21.57,0:04:22.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:04:27.66,0:04:30.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jumlah mereka banyak.\NHaruskah kita bertarung secara terpisah?
Dialogue: 0,0:04:31.03,0:04:32.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tidak tahu seberapa kuat musuh.
Dialogue: 0,0:04:32.75,0:04:33.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya jangan.
Dialogue: 0,0:04:34.09,0:04:35.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:04:35.97,0:04:37.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami juga akan ikut.
Dialogue: 0,0:04:49.10,0:04:53.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesatria Prillecha ternyata selemah ini.
Dialogue: 0,0:04:53.17,0:04:55.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kriminal terkutuk!
Dialogue: 0,0:04:55.11,0:05:00.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu hanyalah kesatria gagal yang tak bisa\Nmelindungi kota ini dari si kriminal!
Dialogue: 0,0:05:01.70,0:05:02.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat!
Dialogue: 0,0:05:02.82,0:05:04.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Matilah!
Dialogue: 0,0:05:08.16,0:05:09.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lamban.
Dialogue: 0,0:05:09.33,0:05:12.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bahkan tak sebanding\Ndengan Pendekar Sihir yang jelita itu.
Dialogue: 0,0:05:14.34,0:05:15.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa kamu?
Dialogue: 0,0:05:23.18,0:05:24.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu baik-baik saja?
Dialogue: 0,0:05:24.47,0:05:26.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, terima kasih sudah menyelamatkanku.
Dialogue: 0,0:05:28.22,0:05:29.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita lanjutkan.
Dialogue: 0,0:05:29.63,0:05:33.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih ada yang memerlukan bantuan kita.
Dialogue: 0,0:05:34.02,0:05:36.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah kenapa dia membuatku kesal.
Dialogue: 0,0:05:46.16,0:05:50.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pram, kamu terlalu di depan!\NKamu sebegitunya ingin dipuji Desir?
Dialogue: 0,0:05:50.16,0:05:53.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Habisnya turnamennya jadi ditunda!
Dialogue: 0,0:06:05.05,0:06:06.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka makin kuat, ya?
Dialogue: 0,0:06:06.43,0:06:08.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, itu semua berkatmu.
Dialogue: 0,0:06:08.97,0:06:11.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, ini berkat kerja keras semuanya.
Dialogue: 0,0:06:12.85,0:06:15.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sisakan juga musuhnya untukku,
Dialogue: 0,0:06:15.23,0:06:16.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pram.
Dialogue: 0,0:06:19.32,0:06:20.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Romantica.
Dialogue: 0,0:06:20.74,0:06:22.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu sebentar.
Dialogue: 0,0:06:48.01,0:06:49.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya di sekitar sini sudah aman.
Dialogue: 0,0:06:50.43,0:06:52.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini berkat kalian semua.
Dialogue: 0,0:06:52.20,0:06:53.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:06:53.68,0:06:55.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Tunggu...
Dialogue: 0,0:06:55.06,0:06:56.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terdapat mana yang kuat...
Dialogue: 0,0:06:57.48,0:06:59.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asalnya dari gerbang transfer!
Dialogue: 0,0:07:07.03,0:07:08.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu baik-baik saja?
Dialogue: 0,0:07:08.37,0:07:11.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para Outer keluar dari gerbang...
Dialogue: 0,0:07:12.62,0:07:15.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami berusaha merebut gerbangnya kembali,
Dialogue: 0,0:07:15.83,0:07:18.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi muncul musuh\Nyang kuat dan mengerikan...
Dialogue: 0,0:07:20.38,0:07:21.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan...
Dialogue: 0,0:07:21.83,0:07:23.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gerbang transfer antarkota...
Dialogue: 0,0:07:25.55,0:07:27.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dengar itu masih dalam tahap purwarupa.
Dialogue: 0,0:07:29.22,0:07:31.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi para Outer menggunakan ini?
Dialogue: 0,0:07:35.06,0:07:36.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Desir?
Dialogue: 0,0:07:36.73,0:07:39.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Romantica, kamu masih ingat janjimu, kan?
Dialogue: 0,0:07:41.82,0:07:43.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong jangan kamu lupakan.
Dialogue: 0,0:07:56.50,0:07:57.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:07:57.41,0:07:58.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini belum selesai!
Dialogue: 0,0:08:00.33,0:08:02.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Instingmu tajam juga, Bocah.
Dialogue: 0,0:08:02.75,0:08:06.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tampaknya lebih kuat\Ndaripada para Kesatria di sini.
Dialogue: 0,0:08:07.38,0:08:09.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tidak sedang main-main.
Dialogue: 0,0:08:09.05,0:08:12.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tugas kita adalah melindungi tempat ini.
Dialogue: 0,0:08:12.56,0:08:15.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku paham.
Dialogue: 0,0:08:16.06,0:08:19.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiga Penyihir dan satu Pendekar?
Dialogue: 0,0:08:20.44,0:08:23.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ditambah, mereka bangsawan Hebrion!
Dialogue: 0,0:08:24.69,0:08:27.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus kenapa?\NBeraninya kamu berbuat seenaknya!
Dialogue: 0,0:08:27.95,0:08:30.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak akan kumaafkan!
Dialogue: 0,0:08:32.45,0:08:33.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dinding Bumi!
Dialogue: 0,0:08:48.67,0:08:50.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih...
Dialogue: 0,0:08:57.93,0:08:59.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Azest!
Dialogue: 0,0:09:08.49,0:09:09.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak apa-apa?
Dialogue: 0,0:09:12.36,0:09:14.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang tadi itu?
Dialogue: 0,0:09:15.70,0:09:17.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia berhasil menghindar, ya?
Dialogue: 0,0:09:17.54,0:09:19.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak-anak itu kuat.
Dialogue: 0,0:09:27.88,0:09:29.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Blancium, ya?
Dialogue: 0,0:09:29.72,0:09:30.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Percuma saja!
Dialogue: 0,0:09:45.06,0:09:46.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia gesit.
Dialogue: 0,0:09:46.77,0:09:49.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu karena dia menerima\Npendidikan yang bagus.
Dialogue: 0,0:09:49.78,0:09:51.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu karena dia terlahir berbeda.
Dialogue: 0,0:09:51.28,0:09:56.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para bangsawan adalah penyebab\Nketidakadilan di dunia ini.
Dialogue: 0,0:09:56.12,0:09:58.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka harus dibunuh.
Dialogue: 0,0:10:00.87,0:10:02.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bilang "bunuh"?
Dialogue: 0,0:10:02.54,0:10:03.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:10:04.63,0:10:06.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Termasuk teman-temanku?
Dialogue: 0,0:10:06.46,0:10:07.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar!
Dialogue: 0,0:10:08.71,0:10:09.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:10:10.59,0:10:11.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:10:11.69,0:10:13.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa memaafkanmu.
Dialogue: 0,0:10:14.85,0:10:16.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Romantica, Pram.
Dialogue: 0,0:10:16.60,0:10:17.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita serang sekuat tenaga!
Dialogue: 0,0:10:17.81,0:10:18.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:10:18.53,0:10:19.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap!
Dialogue: 0,0:10:25.86,0:10:29.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih hidup rupanya?
Dialogue: 0,0:10:29.69,0:10:32.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata kamu memang yang terkuat, ya?
Dialogue: 0,0:10:32.78,0:10:36.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiga lainnya terlihat seperti keroco!
Dialogue: 0,0:10:36.28,0:10:37.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuat?
Dialogue: 0,0:10:37.89,0:10:39.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku?
Dialogue: 0,0:10:41.12,0:10:42.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penilaianmu salah.
Dialogue: 0,0:10:42.88,0:10:44.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru akulah yang terlemah.
Dialogue: 0,0:10:45.46,0:10:46.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:10:59.39,0:11:02.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa mengalahkan orang sepertimu!
Dialogue: 0,0:11:02.81,0:11:05.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi kamu Pendekar Sihir?
Dialogue: 0,0:11:15.95,0:11:18.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak kusangka ada bangsawan Pendekar Sihir!
Dialogue: 0,0:11:18.37,0:11:20.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu benar-benar mangsa terbaik!
Dialogue: 0,0:11:21.37,0:11:23.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa seranganku tidak mengenainya?
Dialogue: 0,0:11:25.71,0:11:27.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa merasakan mana yang samar...
Dialogue: 0,0:11:28.35,0:11:30.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir yang tidak aku tahu, ya?
Dialogue: 0,0:11:32.59,0:11:34.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kamu pikirkan?
Dialogue: 0,0:11:41.13,0:11:45.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berharap lebih karena kamu Pendekar Sihir,\Ntapi hanya sebegini saja?
Dialogue: 0,0:11:48.06,0:11:49.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudahlah.
Dialogue: 0,0:11:49.73,0:11:50.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Matilah!
Dialogue: 0,0:11:57.78,0:11:59.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Artefak, ya?
Dialogue: 0,0:12:08.25,0:12:09.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu...
Dialogue: 0,0:12:09.46,0:12:13.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kebiasaan burukku memang\Nterlalu banyak berpikir.
Dialogue: 0,0:12:13.59,0:12:15.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia juga bilang begitu.
Dialogue: 0,0:12:16.95,0:12:19.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak tahu apa kartu asmu,
Dialogue: 0,0:12:19.40,0:12:21.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku akan mengalahkanmu\Ndengan kekuatan murni!
Dialogue: 0,0:12:23.77,0:12:24.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:12:34.27,0:12:35.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita lanjutkan.
Dialogue: 0,0:12:39.70,0:12:42.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh juga nyalimu...
Dialogue: 0,0:12:45.20,0:12:46.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kubunuh kamu.
Dialogue: 0,0:12:57.38,0:12:59.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peluru Angin!
Dialogue: 0,0:13:03.97,0:13:05.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fata Ki Diva!
Dialogue: 0,0:13:11.52,0:13:14.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Presisi sihirnya\Nsetara denganmu, ya, Romantica.
Dialogue: 0,0:13:14.77,0:13:16.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau mungkin lebih tinggi?
Dialogue: 0,0:13:16.48,0:13:19.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil bisa menghancurkannya\Ntanpa sihir tingkat tinggi.
Dialogue: 0,0:13:20.49,0:13:22.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami akan mengulur waktu.
Dialogue: 0,0:13:23.24,0:13:24.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Romantica.
Dialogue: 0,0:13:25.28,0:13:26.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bisa, kan?
Dialogue: 0,0:13:28.58,0:13:29.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja!
Dialogue: 0,0:13:29.83,0:13:30.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus.
Dialogue: 0,0:13:32.17,0:13:33.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penguatan.
Dialogue: 0,0:13:35.54,0:13:37.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kujelaskan strategi kita, Pram.
Dialogue: 0,0:13:37.76,0:13:39.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, Desir!
Dialogue: 0,0:13:39.76,0:13:41.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lari lurus ke depan.
Dialogue: 0,0:13:41.26,0:13:43.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!\NAku akan lari lurus ke depan!
Dialogue: 0,0:13:43.51,0:13:44.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Incar si Penyihir.
Dialogue: 0,0:13:44.89,0:13:47.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!\NAku akan mengincar si Penyihir!
Dialogue: 0,0:13:47.64,0:13:48.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo!
Dialogue: 0,0:13:52.31,0:13:54.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terbanglah, Pram!
Dialogue: 0,0:13:57.69,0:13:58.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Imbuh!
Dialogue: 0,0:14:00.32,0:14:02.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kuhantam kamu!
Dialogue: 0,0:14:02.53,0:14:04.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bertarunglah, wahai pejuang!
Dialogue: 0,0:14:04.20,0:14:05.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hendaknya kejayaan menyertaimu!
Dialogue: 0,0:14:06.91,0:14:07.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:14:08.14,0:14:09.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia menantangku berduel!
Dialogue: 0,0:14:10.45,0:14:12.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kuincar si Penyihir!
Dialogue: 0,0:14:15.71,0:14:16.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:14:22.17,0:14:24.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pakaian yang luar biasa.
Dialogue: 0,0:14:25.09,0:14:26.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:14:26.85,0:14:30.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akulah pejuang Esteban!\NNamaku Batour!
Dialogue: 0,0:14:30.35,0:14:32.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namaku Desir Herrman!
Dialogue: 0,0:14:33.43,0:14:36.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hendaknya tinju ini membawa kemenangan!
Dialogue: 0,0:14:50.70,0:14:51.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Batour!
Dialogue: 0,0:14:53.54,0:14:55.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu teknik kepala suku?
Dialogue: 0,0:14:57.50,0:14:58.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tepat.
Dialogue: 0,0:14:59.75,0:15:02.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak tahu kenapa\Nkamu bisa menggunakannya.
Dialogue: 0,0:15:02.88,0:15:05.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat juga bisa melakukannya\Ndi umur semuda itu.
Dialogue: 0,0:15:07.29,0:15:09.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Andai saja kamu bukan bocah bangsawan,
Dialogue: 0,0:15:09.85,0:15:12.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu pasti bisa hidup lebih lama!
Dialogue: 0,0:15:32.45,0:15:35.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak akan kubiarkan kamu terus\Nberbuat seenaknya.
Dialogue: 0,0:15:37.54,0:15:38.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pembalikan?
Dialogue: 0,0:15:46.63,0:15:48.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersiaplah, Desir!
Dialogue: 0,0:15:57.48,0:16:00.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Badai Aquila!
Dialogue: 0,0:16:22.17,0:16:24.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Romantica!
Dialogue: 0,0:16:25.42,0:16:27.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak kapan kamu bisa memakainya?
Dialogue: 0,0:16:27.05,0:16:29.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sihir terkuat yang bisa kugunakan.
Dialogue: 0,0:16:29.55,0:16:32.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daya ledaknya jauh lebih tinggi\Ndaripada saat latihan.
Dialogue: 0,0:16:32.16,0:16:34.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi itu hebat, Romantica.
Dialogue: 0,0:16:41.31,0:16:43.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beraninya kamu...
Dialogue: 0,0:16:50.22,0:16:52.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu dihajar habis-habisan, ya.
Dialogue: 0,0:16:52.17,0:16:54.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu juga, kan?
Dialogue: 0,0:16:59.41,0:17:00.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Azest!
Dialogue: 0,0:17:00.67,0:17:02.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu baik-baik saja?
Dialogue: 0,0:17:02.43,0:17:04.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bukan apa-apa.
Dialogue: 0,0:17:04.33,0:17:08.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pergerakannya aneh.\NSeranganku sulit mengenainya.
Dialogue: 0,0:17:09.32,0:17:11.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senjatanya yang sekaligus artefak\Njuga merepotkan.
Dialogue: 0,0:17:15.47,0:17:17.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bukan artefak.
Dialogue: 0,0:17:18.81,0:17:20.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan kamu ini?
Dialogue: 0,0:17:27.35,0:17:30.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia hanya mengendalikan sabitnya\Ndengan Sihir Angin.
Dialogue: 0,0:17:31.36,0:17:33.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sialan!
Dialogue: 0,0:17:35.87,0:17:36.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar bodoh!
Dialogue: 0,0:17:46.13,0:17:47.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mengenainya?
Dialogue: 0,0:17:47.65,0:17:50.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia menyelimuti dirinya dengan aliran udara\Nuntuk membelokkan serangan.
Dialogue: 0,0:17:50.85,0:17:53.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini pun salah satu\Npengaplikasian Sihir Angin.
Dialogue: 0,0:17:53.28,0:17:54.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir?
Dialogue: 0,0:17:54.55,0:17:55.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:17:56.14,0:17:58.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia hanya Penyihir Angin biasa.
Dialogue: 0,0:17:58.39,0:18:01.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana yang dia pakai sangat sedikit\Nsampai tidak kamu sadari.
Dialogue: 0,0:18:03.98,0:18:05.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namamu Batour, benar?
Dialogue: 0,0:18:06.34,0:18:08.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu memang pejuang Esteban,
Dialogue: 0,0:18:08.07,0:18:10.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu harusnya memakai ornamen\Nyang membuktikannya!
Dialogue: 0,0:18:11.86,0:18:13.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kamu tidak memakainya,
Dialogue: 0,0:18:13.68,0:18:15.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berarti kamu terusir, ya?
Dialogue: 0,0:18:16.14,0:18:20.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyihir di belakangmu punya kapasitas mana\Nyang setara dengan Romantica,
Dialogue: 0,0:18:20.79,0:18:22.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi spesialisasinya di sihir bertahan.
Dialogue: 0,0:18:23.29,0:18:25.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu tidak terbiasa\Nmelukai orang lain?
Dialogue: 0,0:18:27.46,0:18:29.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah analisisku untuk kekuatan kalian.
Dialogue: 0,0:18:29.82,0:18:32.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak akan kubiarkan kalian\Nberbuat seenaknya lagi.
Dialogue: 0,0:18:33.09,0:18:33.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pram.
Dialogue: 0,0:18:33.85,0:18:34.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:18:35.22,0:18:37.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya tebas bersama zirah batunya.
Dialogue: 0,0:18:37.10,0:18:38.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:18:40.77,0:18:42.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Blancium...
Dialogue: 0,0:18:42.52,0:18:43.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak akan kubiarkan!
Dialogue: 0,0:18:44.29,0:18:48.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Romantica, sihir anginmu lebih unggul,\Naku percayakan padamu.
Dialogue: 0,0:18:48.19,0:18:49.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku paham!
Dialogue: 0,0:18:49.73,0:18:52.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Azest, tolong bantu Romantica.
Dialogue: 0,0:18:52.47,0:18:53.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap.
Dialogue: 0,0:18:54.48,0:18:56.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang akan menahannya.
Dialogue: 0,0:18:57.81,0:18:59.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kutanyakan sekali lagi.
Dialogue: 0,0:19:00.08,0:19:01.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu masih ingin bertarung?
Dialogue: 0,0:19:02.62,0:19:04.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan dia itu?
Dialogue: 0,0:19:04.62,0:19:05.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak tahu.
Dialogue: 0,0:19:06.25,0:19:07.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:19:08.25,0:19:10.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia yang paling berbahaya di antara mereka.
Dialogue: 0,0:19:11.71,0:19:14.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kita tidak boleh mundur begitu saja!
Dialogue: 0,0:19:14.01,0:19:15.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu!
Dialogue: 0,0:19:15.02,0:19:17.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus bertahan di sini sampai waktunya!
Dialogue: 0,0:19:17.78,0:19:18.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu?
Dialogue: 0,0:19:23.23,0:19:24.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia memanggil kita.
Dialogue: 0,0:19:24.46,0:19:26.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya begitu.
Dialogue: 0,0:19:26.14,0:19:28.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu!\NApa tujuan kalian?
Dialogue: 0,0:19:28.73,0:19:30.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu akan segera tahu.
Dialogue: 0,0:19:30.74,0:19:34.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai bertemu lagi,\Nitu pun kalau kalian bisa bertahan hidup.
Dialogue: 0,0:19:37.99,0:19:38.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:19:38.82,0:19:42.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu Sihir Spasial.\NMereka kabur, ya.
Dialogue: 0,0:19:42.20,0:19:43.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perlu kita kejar?
Dialogue: 0,0:19:43.01,0:19:45.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya mustahil.
Dialogue: 0,0:19:52.00,0:19:54.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa sebenarnya tujuan mereka?
Dialogue: 0,0:20:00.60,0:20:02.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus semuanya.
Dialogue: 0,0:20:03.39,0:20:06.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya akan dimulai, ya?
Dialogue: 0,0:20:06.03,0:20:07.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:20:07.89,0:20:12.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan kunci yang didapatkan\Nsi Badut dari Dunia Bayangan...
Dialogue: 0,0:20:17.20,0:20:20.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bisa memanggil Iblis Malapetaka
Dialogue: 0,0:20:21.12,0:20:24.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang ada di Dunia Bayangan, ke dunia ini.
Dialogue: 0,0:20:29.49,0:20:32.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dialah perwujudan bencana.
Dialogue: 0,0:20:32.63,0:20:35.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mampu membelah bumi,
Dialogue: 0,0:20:35.00,0:20:37.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan membumihanguskan laut emas.
Dialogue: 0,0:20:39.76,0:20:42.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eror. Eror.
Dialogue: 0,0:20:42.14,0:20:45.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Segala yang bernapas akan dihanguskannya...
Dialogue: 0,0:20:45.75,0:20:47.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada tanah ini
Dialogue: 0,0:20:47.14,0:20:50.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan dia bawa kehancuran dan ketenteraman!
Dialogue: 0,0:20:52.61,0:20:55.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terdeteksi akses tidak sah dari luar.
Dialogue: 0,0:20:57.78,0:20:59.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pujilah.
Dialogue: 0,0:21:02.53,0:21:03.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunduklah!
Dialogue: 0,0:21:05.87,0:21:07.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersukacitalah!
Dialogue: 0,0:21:18.30,0:21:20.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nomor Penyegelan,
Dialogue: 0,0:21:20.75,0:21:23.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}5001743.
Dialogue: 0,0:21:23.18,0:21:24.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dibuka secara paksa.
Dialogue: 0,0:21:26.92,0:21:29.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wahai Iblis Malapetaka!
Dialogue: 0,0:21:30.92,0:21:32.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Datanglah!
Dialogue: 0,0:21:47.20,0:21:49.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terhubung ke dunia nyata.
Dialogue: 0,0:23:41.23,0:23:43.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya: Penyihir Agung.
