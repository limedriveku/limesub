Dialogue: 0,0:00:21.54,0:00:24.08,sign,,0000,0000,0000,,DUNIA BAYANGAN
Dialogue: 0,0:00:24.08,0:00:24.88,sign,,0000,0000,0000,,KOTA BENTENG EVERNATTEN
Dialogue: 0,0:02:12.40,0:02:15.99,sign,,0000,0000,0000,,EPISODE 13: MENUJU BAYANGAN
Dialogue: 0,0:09:18.33,0:09:20.16,sign,,0000,0000,0000,,PENGUASA EVERNATTEN
Dialogue: 0,0:09:20.16,0:09:23.83,sign,,0000,0000,0000,,WILHELM EVERNATTEN
Dialogue: 0,0:12:19.71,0:12:22.93,sign,,0000,0000,0000,,KOKI - JEFFRAN
Dialogue: 0,0:12:30.01,0:12:32.68,sign,,0000,0000,0000,,GADIS PENGUNGSI: LIRIKA
Dialogue: 0,0:19:35.41,0:19:36.03,sign,,0000,0000,0000,,WILAYAH KELBAN
Dialogue: 0,0:19:51.75,0:19:55.01,sign,,0000,0000,0000,,PELAYAN - EMIL
Dialogue: 0,0:23:40.57,0:23:41.40,sign,,0000,0000,0000,,EPISODE 14: PENGHAKIMAN
Dialogue: 0,0:00:09.07,0:00:10.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dunia Bayangan...
Dialogue: 0,0:00:10.77,0:00:14.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah bencana yang paling berbahaya\Nyang dihadapi umat manusia.
Dialogue: 0,0:00:17.71,0:00:21.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ia terus berusaha menutupi\Nseluruh dunia ini
Dialogue: 0,0:00:21.54,0:00:24.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan kabut hitam.
Dialogue: 0,0:00:48.78,0:00:51.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serangan Esteban telah dimulai.
Dialogue: 0,0:01:20.31,0:01:21.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo.
Dialogue: 0,0:01:33.66,0:01:36.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata ada orang dengan insting tajam!
Dialogue: 0,0:01:37.37,0:01:38.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasakan ini!
Dialogue: 0,0:01:46.50,0:01:47.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pembalikan selesai.
Dialogue: 0,0:01:59.18,0:02:00.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dunia Bayangan:
Dialogue: 0,0:02:01.17,0:02:03.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jatuhnya Kerajaan Suci Evernatten.
Dialogue: 0,0:02:04.67,0:02:07.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu harus memperbaiki\Nsejarah yang salah ini.
Dialogue: 0,0:02:07.90,0:02:09.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Desir Herrman.
Dialogue: 0,0:02:23.62,0:02:24.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Percuma.
Dialogue: 0,0:02:25.96,0:02:26.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tombak!
Dialogue: 0,0:02:35.68,0:02:37.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ce-Cepatnya...
Dialogue: 0,0:02:37.26,0:02:40.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak akan kubiarkan kamu menyentuh Desir!
Dialogue: 0,0:02:43.77,0:02:45.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh juga!
Dialogue: 0,0:02:48.36,0:02:49.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mundurlah, Pram.
Dialogue: 0,0:02:49.82,0:02:50.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:02:53.34,0:02:54.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lelehan Es.
Dialogue: 0,0:03:08.88,0:03:09.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia berbahaya!
Dialogue: 0,0:03:09.79,0:03:10.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlambat!
Dialogue: 0,0:03:11.71,0:03:13.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Panggilan Guntur!
Dialogue: 0,0:03:22.87,0:03:26.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia lebih berbahaya dari Kepala Suku...
Dialogue: 0,0:03:34.43,0:03:36.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini gawat, Desir.
Dialogue: 0,0:03:44.69,0:03:46.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kejar dia!
Dialogue: 0,0:03:49.36,0:03:50.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja.
Dialogue: 0,0:03:58.76,0:04:00.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takhta Beku!
Dialogue: 0,0:04:18.91,0:04:26.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Koonlona!
Dialogue: 0,0:04:39.05,0:04:41.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuat!\NMereka kuat!
Dialogue: 0,0:04:42.45,0:04:45.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inilah pertarungan yang kami mau!
Dialogue: 0,0:04:46.02,0:04:48.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Koonlona!
Dialogue: 0,0:04:49.73,0:04:51.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dinding Es!
Dialogue: 0,0:04:51.56,0:04:54.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini?
Dialogue: 0,0:05:00.28,0:05:01.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya kamu yang tersisa.
Dialogue: 0,0:05:29.27,0:05:30.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wahai penyihir,
Dialogue: 0,0:05:30.81,0:05:32.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akulah yang akan menghabisimu!
Dialogue: 0,0:05:36.69,0:05:37.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melicin!
Dialogue: 0,0:05:45.41,0:05:46.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepatnya!
Dialogue: 0,0:05:54.04,0:05:55.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang tadi itu...
Dialogue: 0,0:06:08.58,0:06:09.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aura, ya?
Dialogue: 0,0:06:16.13,0:06:17.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perkenalkanlah dirimu.
Dialogue: 0,0:06:18.22,0:06:20.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akulah Elang Cakar Berdarah!
Dialogue: 0,0:06:20.97,0:06:24.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pejuang Esteban bermartabat!
Dialogue: 0,0:06:26.72,0:06:29.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namaku Azest Kingscrown.
Dialogue: 0,0:06:30.79,0:06:32.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Azest.
Dialogue: 0,0:06:32.16,0:06:36.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tebuslah nyawa saudara-saudaraku\Ndengan nyawamu itu!
Dialogue: 0,0:06:50.26,0:06:53.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemampuanmu memang mumpuni,\Ntapi kekuatanmu masih kurang!
Dialogue: 0,0:06:54.85,0:06:56.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zirah itu...
Dialogue: 0,0:06:56.94,0:06:59.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hanya mengganggu!
Dialogue: 0,0:07:21.80,0:07:24.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu masih bisa menghiburku?
Dialogue: 0,0:07:29.73,0:07:31.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu menikmati pertarungan ini?
Dialogue: 0,0:07:31.18,0:07:32.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:07:32.35,0:07:36.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami para Esteban sangat menikmati\Npertarungan yang mendebarkan.
Dialogue: 0,0:07:41.07,0:07:41.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia juga...
Dialogue: 0,0:07:42.72,0:07:44.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}selalu tersenyum.
Dialogue: 0,0:07:45.99,0:07:48.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah kamu juga menikmatinya?
Dialogue: 0,0:07:48.49,0:07:49.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:07:49.49,0:07:53.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak, aku tak akan bisa melampauinya!
Dialogue: 0,0:08:17.23,0:08:20.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil!\NIni benar-benar...
Dialogue: 0,0:08:20.77,0:08:22.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang Magis:
Dialogue: 0,0:08:22.11,0:08:24.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gelombang Es!
Dialogue: 0,0:08:56.17,0:08:59.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pejuang yang gagah.
Dialogue: 0,0:09:14.13,0:09:18.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pram Schnaizer, kamu tidak lebih\Ndari sekadar prajurit biasa.
Dialogue: 0,0:09:20.16,0:09:21.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Desir Herrman.
Dialogue: 0,0:09:21.72,0:09:23.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu seorang pelayan, benar?
Dialogue: 0,0:09:27.13,0:09:28.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jawab pertanyaanku.
Dialogue: 0,0:09:31.13,0:09:34.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kamu bisa\Nmemprediksi invasi Esteban?
Dialogue: 0,0:09:46.40,0:09:51.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama penyerangan Esteban semalam,\Nkamu pergi melindungi dinding kota.
Dialogue: 0,0:09:52.78,0:09:55.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kamu bisa tahu\Nmereka akan datang?
Dialogue: 0,0:09:55.07,0:09:56.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya tidak bisa menjawabnya.
Dialogue: 0,0:09:56.91,0:09:59.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu tidak meminta bantuan?
Dialogue: 0,0:09:59.04,0:10:00.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya tidak bisa menjawabnya.
Dialogue: 0,0:10:01.36,0:10:04.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bicara atau kamu akan dihukum.
Dialogue: 0,0:10:04.20,0:10:08.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa jadi kalianlah yang membiarkan\Npara Esteban itu masuk.
Dialogue: 0,0:10:09.36,0:10:11.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jatuhnya Kerajaan Suci Evernatten.
Dialogue: 0,0:10:12.89,0:10:15.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agar bisa menaklukkan Dunia Bayangan ini,
Dialogue: 0,0:10:15.22,0:10:18.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami harus menyelesaikan dua masalah.
Dialogue: 0,0:10:19.25,0:10:21.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wilayah Evernatten ada di perbatasan,
Dialogue: 0,0:10:21.77,0:10:25.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan selalu menerima serangan\Ndari musuh asing, yaitu Esteban.
Dialogue: 0,0:10:25.67,0:10:29.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyelesaikan masalah itu\Nadalah salah satu tujuan kami.
Dialogue: 0,0:10:29.82,0:10:31.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu tidak bisa menjawab?
Dialogue: 0,0:10:32.52,0:10:36.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski saya memberi penjelasan,\Nitu akan terdengar tidak masuk akal.
Dialogue: 0,0:10:37.87,0:10:39.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya?
Dialogue: 0,0:10:43.58,0:10:46.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}De-Desir...
Dialogue: 0,0:10:48.42,0:10:50.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu pertanyaan terakhir.
Dialogue: 0,0:10:51.05,0:10:52.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa tujuanmu?
Dialogue: 0,0:10:56.22,0:10:58.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk melindungi mereka\Nyang tinggal di sini!
Dialogue: 0,0:11:00.89,0:11:04.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka yang sangat terdampak\Nakibat serangan dari Esteban.
Dialogue: 0,0:11:05.64,0:11:10.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya tidak bisa tinggal diam dan melihat\Nmereka yang tidak bersalah dibunuh!
Dialogue: 0,0:11:13.03,0:11:15.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dewa macam apa yang mengabaikan pengikutnya?
Dialogue: 0,0:11:22.58,0:11:24.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu benar.
Dialogue: 0,0:11:26.46,0:11:29.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian berdua tidak akan dihukum.
Dialogue: 0,0:11:38.97,0:11:43.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih telah melindungi rakyatku.
Dialogue: 0,0:11:43.64,0:11:46.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai sekarang,\Nteruslah bekerja keras demi Evernatten.
Dialogue: 0,0:11:46.48,0:11:47.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:11:48.81,0:11:49.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:11:53.78,0:11:56.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah menerima kepercayaan Wilhelm,
Dialogue: 0,0:11:56.67,0:11:59.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Desir Herrman telah dipromosikan\Nmenjadi Penasihat.
Dialogue: 0,0:12:04.70,0:12:08.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Wilhelm.\NSaya punya permintaan.
Dialogue: 0,0:12:09.33,0:12:12.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu langsung ingin meminta sesuatu?\NAkan kudengarkan.
Dialogue: 0,0:12:12.29,0:12:14.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:12:18.30,0:12:19.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Desir!
Dialogue: 0,0:12:22.93,0:12:24.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Abang!
Dialogue: 0,0:12:33.37,0:12:35.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengkhawatirkanmu, lo.
Dialogue: 0,0:12:35.48,0:12:37.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, ya, Lirika.
Dialogue: 0,0:12:40.35,0:12:42.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peranku dimulai sebagai pelayan.
Dialogue: 0,0:12:43.73,0:12:45.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pram sebagai prajurit,
Dialogue: 0,0:12:45.64,0:12:48.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan Azest sebagai Komandan Kesatria.
Dialogue: 0,0:12:49.25,0:12:50.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari posisi kami masing-masing,
Dialogue: 0,0:12:50.79,0:12:53.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami bersiap memperbaiki\Nsejarah Dunia Bayangan ini.
Dialogue: 0,0:12:55.13,0:12:56.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah kamu baik-baik saja.
Dialogue: 0,0:12:56.88,0:12:59.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Wilhelm adalah penguasa yang baik.
Dialogue: 0,0:12:59.05,0:13:00.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ia memahamiku.
Dialogue: 0,0:13:00.72,0:13:03.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, aku juga tahu.
Dialogue: 0,0:13:03.91,0:13:05.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat mengetahuinya...
Dialogue: 0,0:13:06.31,0:13:07.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:13:07.36,0:13:10.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang dia sudah berubah.
Dialogue: 0,0:13:10.27,0:13:11.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudmu?
Dialogue: 0,0:13:11.31,0:13:13.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau sampai kapan kamu terus memeluknya?
Dialogue: 0,0:13:13.77,0:13:16.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gantian denganku setelah\Nkuhitung sampai sepuluh!
Dialogue: 0,0:13:16.11,0:13:18.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu, dua, tiga, empat,\Nlima, enam, tujuh...
Dialogue: 0,0:13:18.40,0:13:22.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enam, lima, empat...
Dialogue: 0,0:13:22.16,0:13:24.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiga, dua, satu!
Dialogue: 0,0:13:25.16,0:13:26.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:13:45.35,0:13:48.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kepala Suku Esteban, Elang Cakar Berdarah!
Dialogue: 0,0:13:53.12,0:13:56.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bukti seorang Kahn\Nyang memimpin seluruh suku Esteban!
Dialogue: 0,0:13:58.23,0:14:00.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini waktunya aku dieksekusi?
Dialogue: 0,0:14:00.69,0:14:02.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin bicara denganmu.
Dialogue: 0,0:14:02.57,0:14:04.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku siap untuk membebaskanmu.
Dialogue: 0,0:14:06.49,0:14:08.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan invasimu ke Evernatten.
Dialogue: 0,0:14:09.75,0:14:11.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil.
Dialogue: 0,0:14:11.83,0:14:15.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Esteban sangat menghargai\Npertarungan penuh keberanian.
Dialogue: 0,0:14:15.79,0:14:18.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa mencuri makanan di tengah kegelapan
Dialogue: 0,0:14:18.72,0:14:21.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah cara bertarung Esteban\Nyang penuh martabat?
Dialogue: 0,0:14:22.22,0:14:23.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetap saja!
Dialogue: 0,0:14:24.01,0:14:27.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai pemimpin,\Naku harus melindungi rakyatku!
Dialogue: 0,0:14:28.14,0:14:29.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bunuh aku!
Dialogue: 0,0:14:29.47,0:14:31.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu ingin mati sebagai bandit?
Dialogue: 0,0:14:31.89,0:14:32.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar!
Dialogue: 0,0:14:34.69,0:14:36.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana dengan anggota sukumu?
Dialogue: 0,0:14:36.56,0:14:38.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan ada yang menggantikanku.
Dialogue: 0,0:14:38.23,0:14:39.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu berbohong.
Dialogue: 0,0:14:42.49,0:14:44.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada pejuang yang lebih kuat darimu.
Dialogue: 0,0:14:45.32,0:14:46.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, kan?
Dialogue: 0,0:14:47.37,0:14:49.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wahai keturunan Kahn yang agung?
Dialogue: 0,0:14:50.74,0:14:53.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kamu bisa tahu?
Dialogue: 0,0:14:54.16,0:14:56.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teman lamaku yang memberitahuku.
Dialogue: 0,0:14:58.71,0:15:00.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin mencegah korban yang sia-sia.
Dialogue: 0,0:15:02.09,0:15:03.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang sudah terlambat.
Dialogue: 0,0:15:03.84,0:15:05.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rekan-rekanmu tidak ada yang mati.
Dialogue: 0,0:15:07.59,0:15:10.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari cari cara tanpa pertumpahan darah.
Dialogue: 0,0:15:16.10,0:15:17.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengaku kalah.
Dialogue: 0,0:15:19.02,0:15:22.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami, Esteban, mengagungkan sosok kuat.
Dialogue: 0,0:15:22.36,0:15:25.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terutama mereka yang kuat di medan tempur.
Dialogue: 0,0:15:26.66,0:15:30.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, tampaknya kamu memiliki\Nkekuatan yang berbeda.
Dialogue: 0,0:15:32.62,0:15:35.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kudengarkan usulanmu.
Dialogue: 0,0:15:37.21,0:15:39.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misi telah mengalami kemajuan.
Dialogue: 0,0:15:39.97,0:15:43.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu telah memasuki gencatan senjata\Ndengan Suku Elang dari Esteban.
Dialogue: 0,0:15:54.47,0:15:58.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teh yang kamu seduh memiliki\Naroma yang luar biasa.
Dialogue: 0,0:15:58.94,0:16:00.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:16:03.53,0:16:06.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus dalam menangani\Nurusan dengan Esteban.
Dialogue: 0,0:16:06.70,0:16:09.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak kusangka kamu bisa meyakinkan mereka.
Dialogue: 0,0:16:10.52,0:16:11.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana caramu melakukannya?
Dialogue: 0,0:16:12.91,0:16:15.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya menyampaikan ketulusanku.
Dialogue: 0,0:16:16.04,0:16:17.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya?
Dialogue: 0,0:16:18.17,0:16:19.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuharap kamu bisa terus membantuku.
Dialogue: 0,0:16:19.96,0:16:21.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:16:22.96,0:16:26.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan ini satu masalah teratasi.
Dialogue: 0,0:16:28.01,0:16:28.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:16:29.34,0:16:30.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu masalah selesai.
Dialogue: 0,0:16:31.51,0:16:32.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:16:34.85,0:16:38.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harap selesaikan krisis pengungsi\Ndi wilayah Evernatten.
Dialogue: 0,0:16:51.53,0:16:53.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana dengan keberadaan Romantica?
Dialogue: 0,0:16:55.45,0:16:57.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat kita memasuki Dunia Bayangan,
Dialogue: 0,0:16:57.43,0:16:59.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tak ada yang tahu\Nkita akan dikirim ke mana.
Dialogue: 0,0:17:00.19,0:17:02.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita beruntung bisa bertemu di sini.
Dialogue: 0,0:17:02.71,0:17:03.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya?
Dialogue: 0,0:17:05.13,0:17:07.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, yang kita bahas ini Romantica,
Dialogue: 0,0:17:07.49,0:17:09.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku yakin dia baik-baik saja.
Dialogue: 0,0:17:11.31,0:17:13.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu percaya padanya, ya?
Dialogue: 0,0:17:13.39,0:17:14.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:17:17.09,0:17:18.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya Komandan!
Dialogue: 0,0:17:20.94,0:17:22.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Panggil saja aku Azest.
Dialogue: 0,0:17:23.15,0:17:25.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu adalah orang\Nyang telah melindungi kami.
Dialogue: 0,0:17:25.69,0:17:27.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa memanggilmu begitu.
Dialogue: 0,0:17:31.28,0:17:32.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh!
Dialogue: 0,0:17:32.95,0:17:34.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini kue untukmu.
Dialogue: 0,0:17:34.45,0:17:36.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nikmatilah dengan kekasihmu.
Dialogue: 0,0:17:36.62,0:17:38.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke-Kekasih?
Dialogue: 0,0:17:39.87,0:17:41.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kuterima dengan senang hati.
Dialogue: 0,0:17:43.67,0:17:44.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Azest?
Dialogue: 0,0:17:46.69,0:17:48.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di-Dia bilang kekasih?
Dialogue: 0,0:17:52.47,0:17:53.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo.
Dialogue: 0,0:17:54.09,0:17:55.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Azest?
Dialogue: 0,0:17:57.39,0:17:59.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei!
Dialogue: 0,0:18:12.45,0:18:14.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, gawat!
Dialogue: 0,0:18:26.59,0:18:28.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana dengan para pengungsi?
Dialogue: 0,0:18:28.25,0:18:31.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami memusatkan para kesatria\Ndi sana untuk menjaga situasi...
Dialogue: 0,0:18:31.97,0:18:34.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi itu hanya langkah sementara.
Dialogue: 0,0:18:35.26,0:18:37.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tidak menyelesaikan\Nakar permasalahannya.
Dialogue: 0,0:18:39.83,0:18:43.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada dasarnya,\Npengungsi sebanyak ini sudah aneh.
Dialogue: 0,0:18:46.31,0:18:48.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Evernatten adalah kota perbatasan.
Dialogue: 0,0:18:48.47,0:18:50.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa dibilang garis terdepan.
Dialogue: 0,0:18:50.39,0:18:54.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada manusia yang mau pindah ke tempat\Nberbahaya seperti ini dengan senang hati.
Dialogue: 0,0:18:56.22,0:18:58.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih ada hal yang tidak kita tahu...
Dialogue: 0,0:18:59.74,0:19:01.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai kita bisa mengungkapnya,
Dialogue: 0,0:19:02.70,0:19:05.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita tidak akan bisa\Nmenaklukkan Dunia Bayangan ini.
Dialogue: 0,0:19:16.75,0:19:18.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Azest?
Dialogue: 0,0:19:18.26,0:19:22.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manusia akan jadi pesimis saat lapar.
Dialogue: 0,0:19:22.75,0:19:26.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak akan bisa memikirkan ide\Nkalau murung begitu.
Dialogue: 0,0:19:32.19,0:19:35.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak!
Dialogue: 0,0:19:39.03,0:19:41.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benar-benar tidak paham!
Dialogue: 0,0:19:41.66,0:19:46.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan ini? Kenapa aku harus jadi\Npedagang bahkan di Dunia Bayangan?
Dialogue: 0,0:19:46.50,0:19:50.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah puas merasakannya\Nsaat masih di kampung halamanku!
Dialogue: 0,0:19:51.75,0:19:53.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak keberatan kamu teriak,
Dialogue: 0,0:19:53.91,0:19:55.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi selesaikan pekerjaanmu.
Dialogue: 0,0:19:55.01,0:19:57.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya ketuk dulu!
Dialogue: 0,0:19:57.30,0:19:58.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah.
Dialogue: 0,0:20:01.96,0:20:06.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengembangkan bisnisku\Nuntuk mencari tentang Desir,
Dialogue: 0,0:20:06.56,0:20:09.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku tidak ketemu apa-apa...
Dialogue: 0,0:20:12.55,0:20:16.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Situasi di Kota Suci Gottheim\Ntidak terlihat baik.
Dialogue: 0,0:20:16.03,0:20:16.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya...
Dialogue: 0,0:20:16.70,0:20:19.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang-orang terus pergi dari sana.
Dialogue: 0,0:20:19.11,0:20:21.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pajak yang berat membebani mereka, lalu...
Dialogue: 0,0:20:21.66,0:20:23.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang menghilang secara misterius.
Dialogue: 0,0:20:23.25,0:20:25.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan anak-anak jadi korbannya.
Dialogue: 0,0:20:26.71,0:20:31.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka yang pergi dari Gottheim\Ntampaknya pindah ke wilayah sekitarnya.
Dialogue: 0,0:20:31.81,0:20:35.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, ada satu tempat\Nyang menerima imigran tanpa syarat.
Dialogue: 0,0:20:35.71,0:20:36.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di mana?
Dialogue: 0,0:20:36.97,0:20:39.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Evernatten di perbatasan utara.
Dialogue: 0,0:20:40.76,0:20:42.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Evernatten...
Dialogue: 0,0:20:42.97,0:20:46.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi karena itu,\Nmereka kekurangan bahan makanan.
Dialogue: 0,0:20:46.37,0:20:49.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya akan sulit bagi mereka\Nuntuk melewati musim dingin ini.
Dialogue: 0,0:20:51.31,0:20:52.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Romantica.
Dialogue: 0,0:20:53.73,0:20:57.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah berapa kali kubilang\Nuntuk mengetuk dulu?
Dialogue: 0,0:20:57.28,0:20:59.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami menemukan orang yang Anda cari.
Dialogue: 0,0:21:00.93,0:21:04.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pendekar wanita berwajah masam,\Nhewan kecil berambut biru,
Dialogue: 0,0:21:04.28,0:21:06.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan pria congkak yang selalu senyum.\NKetiganya telah ditemukan.
Dialogue: 0,0:21:06.95,0:21:09.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi? Ada di mana mereka?
Dialogue: 0,0:21:09.73,0:21:11.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka ada di Evernatten.
Dialogue: 0,0:21:14.82,0:21:17.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Emil, segera bersiap!
Dialogue: 0,0:21:17.13,0:21:19.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita pergi ke Evernatten.
Dialogue: 0,0:21:20.91,0:21:24.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dunia Bayangan:\NUsaha Evernatten Bertahan Hidup.
Dialogue: 0,0:21:25.33,0:21:30.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perbaikilah kesalahan dunia\Nyang telah dilupakan oleh sejarah.
Dialogue: 0,0:21:31.56,0:21:34.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku doakan keberhasilan kalian.
Dialogue: 0,0:22:48.89,0:22:51.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah lama kita tidak bicara seperti ini.
Dialogue: 0,0:22:51.61,0:22:54.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu masih sibuk dengan penelitianmu?
Dialogue: 0,0:22:54.81,0:22:56.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, begitulah.
Dialogue: 0,0:22:56.80,0:22:58.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suaramu terdengar riang.
Dialogue: 0,0:22:58.84,0:23:00.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ada hal baik yang terjadi?
Dialogue: 0,0:23:01.23,0:23:03.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mendapatkan bakat yang luar biasa.
Dialogue: 0,0:23:03.99,0:23:08.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sampai bicara seperti itu?\NDia pasti benar-benar hebat.
Dialogue: 0,0:23:10.06,0:23:11.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Priscilla...
Dialogue: 0,0:23:12.10,0:23:17.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin saja dia bisa menjawab\Nmasalah yang kamu pertanyakan.
Dialogue: 0,0:23:18.13,0:23:18.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:23:21.35,0:23:23.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah impresi yang diberikannya padaku.
Dialogue: 0,0:23:25.62,0:23:27.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Desir Herrman.
Dialogue: 0,0:23:28.12,0:23:31.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa merasakan sesuatu\Nyang misterius darinya.
Dialogue: 0,0:23:31.99,0:23:33.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu membuatku berekspektasi
Dialogue: 0,0:23:34.81,0:23:36.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan juga membuatku takut.
Dialogue: 0,0:23:41.40,0:23:43.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya: Penghakiman.
