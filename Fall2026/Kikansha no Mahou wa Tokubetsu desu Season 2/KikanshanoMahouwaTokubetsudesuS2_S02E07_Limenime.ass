Dialogue: 0,0:01:09.09,0:01:13.51,sign,,0000,0000,0000,,SIHIR SANG PENGULANG JELAS ISTIMEWA\N- MUSIM KEDUA
Dialogue: 0,0:02:27.50,0:02:31.51,sign,,0000,0000,0000,,EPISODE 19: KEBANGKITAN
Dialogue: 0,0:23:40.61,0:23:45.03,sign,,0000,0000,0000,,EPISODE 20: KATA-KATA KEHANCURAN
Dialogue: 0,0:00:13.04,0:00:14.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya sudah kubalikkan.
Dialogue: 0,0:00:15.48,0:00:18.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua sihir yang bisa\Nkamu gunakan dengan artefak itu.
Dialogue: 0,0:00:21.15,0:00:22.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah kalah.
Dialogue: 0,0:00:53.36,0:00:55.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar lawan yang merepotkan.
Dialogue: 0,0:02:44.85,0:02:46.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemutlakan Zero!
Dialogue: 0,0:03:20.56,0:03:21.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu baik-baik saja?
Dialogue: 0,0:03:23.05,0:03:25.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tepat seperti kata Desir.
Dialogue: 0,0:03:27.24,0:03:30.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makhluk itu tidak bisa dilukai\Ndengan sihir biasa.
Dialogue: 0,0:03:31.61,0:03:33.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan memakai sihir yang agak kuat.
Dialogue: 0,0:03:33.56,0:03:35.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mundurlah, Priscilla.
Dialogue: 0,0:03:35.82,0:03:36.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:03:57.01,0:03:58.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasak Dewa!
Dialogue: 0,0:04:24.87,0:04:28.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyihir terkuat di dunia memang hebat.
Dialogue: 0,0:04:28.12,0:04:29.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya...
Dialogue: 0,0:04:31.73,0:04:35.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa Desir bisa tahu tentang iblis ini?
Dialogue: 0,0:04:40.62,0:04:41.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Desir!
Dialogue: 0,0:04:41.59,0:04:43.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master Menara sudah mengalahkannya!
Dialogue: 0,0:04:44.67,0:04:46.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dadeinuf sudah kalah.
Dialogue: 0,0:04:47.98,0:04:50.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Revolusimu berhenti di sini!
Dialogue: 0,0:04:50.94,0:04:53.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Revolusi?\NMaksudmu...
Dialogue: 0,0:04:54.47,0:04:58.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dua belas tahun lalu, perang sipil\Nterjadi di Kekaisaran Hebrion.
Dialogue: 0,0:04:58.53,0:05:03.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seorang siswa bangkit untuk membebaskan\Nrakyat dari pemerintahan bangsawan.
Dialogue: 0,0:05:04.37,0:05:07.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, bangsawan yang justru\Nmemenangkan pertarungan itu.
Dialogue: 0,0:05:07.57,0:05:11.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diskriminasi berdasarkan\Nkelahiran seseorang pun kian mengakar.
Dialogue: 0,0:05:12.38,0:05:15.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Batour dan kawan-kawannya\Njuga benci pada bangsawan.
Dialogue: 0,0:05:15.82,0:05:19.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian para penyintas\Ndari revolusi itu, kan?
Dialogue: 0,0:05:21.95,0:05:24.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dunia ini penuh dengan keabsurdan.
Dialogue: 0,0:05:26.00,0:05:30.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua berpusat pada bangsawan\Ndan hanya mereka yang boleh memegang kuasa.
Dialogue: 0,0:05:30.06,0:05:32.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka pun memaksakan ideologi busuk itu.
Dialogue: 0,0:05:34.44,0:05:36.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan hanya Hebrion.
Dialogue: 0,0:05:37.21,0:05:43.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para bangsawan bodoh di seluruh dunia\Nmemaksakan standar dan keabsurdan mereka.
Dialogue: 0,0:05:48.83,0:05:52.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dunia ini telah bercela\Nsampai ke akar-akarnya!
Dialogue: 0,0:05:53.48,0:05:56.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan kamu tidak bisa membantahnya!
Dialogue: 0,0:05:56.04,0:05:56.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:05:56.92,0:05:58.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Desir?
Dialogue: 0,0:05:59.03,0:06:01.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diskriminasi bahkan masih\Nbertumbuh subur di akademi.
Dialogue: 0,0:06:02.37,0:06:04.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya karena terlahir berbeda,
Dialogue: 0,0:06:04.47,0:06:07.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}masa depan mereka\Nyang berbakat pun tertutup.
Dialogue: 0,0:06:07.97,0:06:09.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, lihat ini!
Dialogue: 0,0:06:10.50,0:06:12.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang kalian lukai
Dialogue: 0,0:06:12.73,0:06:15.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah orang yang harusnya kalian lindungi!
Dialogue: 0,0:06:15.73,0:06:20.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka yang pasrah tanpa berniat\Nmengubah keadaan juga berdosa!
Dialogue: 0,0:06:20.23,0:06:22.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maka akan kuhancurkan\Ndunia ini dan segala isinya,
Dialogue: 0,0:06:22.95,0:06:25.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan daripadanyalah\Nakan kulahirkan kesetaraan sejati!
Dialogue: 0,0:06:25.97,0:06:27.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang ini...
Dialogue: 0,0:06:29.58,0:06:31.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami akan menahanmu.
Dialogue: 0,0:06:34.32,0:06:37.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bilang sudah mengalahkan Dadeinuf, ya?
Dialogue: 0,0:06:38.57,0:06:40.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu patut dirayakan.
Dialogue: 0,0:06:40.63,0:06:41.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:06:42.13,0:06:44.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia adalah perwujudan malapetaka.
Dialogue: 0,0:06:44.84,0:06:48.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil manusia bisa mengalahkannya.
Dialogue: 0,0:06:51.27,0:06:52.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan...
Dialogue: 0,0:07:06.01,0:07:06.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:07:06.61,0:07:08.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini...
Dialogue: 0,0:07:29.79,0:07:31.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyerah saja.
Dialogue: 0,0:07:31.81,0:07:33.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian sudah kalah.
Dialogue: 0,0:07:33.81,0:07:35.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak akan kubiarkan!
Dialogue: 0,0:07:39.65,0:07:40.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia kabur.
Dialogue: 0,0:07:40.86,0:07:42.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Desir...
Dialogue: 0,0:07:44.81,0:07:46.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Desir?
Dialogue: 0,0:07:46.45,0:07:49.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Desir, aku akan bergabung dengan kalian.
Dialogue: 0,0:07:49.59,0:07:52.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya mustahil bagiku\Nuntuk menangani ini sendirian.
Dialogue: 0,0:07:54.29,0:07:56.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Desir?\NKamu dengar, tidak?
Dialogue: 0,0:07:56.33,0:07:57.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Desir!
Dialogue: 0,0:07:58.60,0:08:00.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Ah, iya, maaf.
Dialogue: 0,0:08:00.25,0:08:01.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu baik-baik saja?
Dialogue: 0,0:08:02.42,0:08:03.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak apa-apa.
Dialogue: 0,0:08:03.71,0:08:06.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami akan menuju lokasimu,\Ntetap di sana, ya.
Dialogue: 0,0:08:07.34,0:08:08.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:08:14.46,0:08:16.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa depan berubah?
Dialogue: 0,0:08:17.59,0:08:22.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertarungan kami melawan Dadeinuf\Nharusnya terjadi jauh di masa depan!
Dialogue: 0,0:08:22.77,0:08:25.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iblis Malapetaka\Nyang diceritakan di legenda,
Dialogue: 0,0:08:25.33,0:08:28.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kekuatannya benar-benar mirip bencana alam.
Dialogue: 0,0:08:29.21,0:08:31.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami bekerja sama\Nuntuk mengalahkan iblis itu.
Dialogue: 0,0:08:32.85,0:08:33.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:08:33.90,0:08:35.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harga yang harus dibayar
Dialogue: 0,0:08:36.62,0:08:38.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}terlalu besar.
Dialogue: 0,0:08:44.03,0:08:45.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana yang luar biasa.
Dialogue: 0,0:08:45.81,0:08:48.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia jauh lebih kuat dari sebelumnya.
Dialogue: 0,0:08:48.09,0:08:50.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana cara mengalahkannya?
Dialogue: 0,0:08:50.95,0:08:52.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Romantica... Aaron...
Dialogue: 0,0:08:53.35,0:08:54.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, Dadeinuf...
Dialogue: 0,0:08:55.29,0:08:56.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:08:56.58,0:08:59.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa dia muncul di dunia nyata?\NBukan di Dunia Bayangan?
Dialogue: 0,0:09:01.19,0:09:03.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa pengulanganku adalah penyebabnya?
Dialogue: 0,0:09:06.63,0:09:09.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku tidak bisa lepas dari takdir?
Dialogue: 0,0:09:11.16,0:09:12.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Desir?
Dialogue: 0,0:09:17.69,0:09:19.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang benar saja!
Dialogue: 0,0:09:19.16,0:09:20.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:09:23.15,0:09:25.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya Master Menara\Nyang bisa menangani Dadeinuf.
Dialogue: 0,0:09:25.74,0:09:27.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita hanya akan membebaninya.
Dialogue: 0,0:09:27.92,0:09:29.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus membantu evakuasi sekarang!
Dialogue: 0,0:09:29.84,0:09:32.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus menyelamatkan\Norang sebanyak mungkin!
Dialogue: 0,0:09:32.05,0:09:32.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:09:32.72,0:09:33.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku paham!
Dialogue: 0,0:09:33.59,0:09:34.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:09:50.57,0:09:51.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita selamat...
Dialogue: 0,0:09:51.82,0:09:54.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kota kita telah menjadi lautan api...
Dialogue: 0,0:09:55.60,0:09:57.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mama, lihat itu!
Dialogue: 0,0:09:57.16,0:09:58.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:09:58.58,0:10:00.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kembang api besar!
Dialogue: 0,0:10:10.00,0:10:11.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mahkota Es!
Dialogue: 0,0:10:21.48,0:10:23.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya baik-baik saja.
Dialogue: 0,0:10:35.24,0:10:38.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita andalkan mereka berdua\Nuntuk urusan di sana.
Dialogue: 0,0:10:38.08,0:10:39.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fokuslah, Romantica.
Dialogue: 0,0:10:39.99,0:10:41.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku paham.
Dialogue: 0,0:10:41.69,0:10:43.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arah jam dua, jarak 850.
Dialogue: 0,0:10:43.91,0:10:44.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap!
Dialogue: 0,0:10:48.75,0:10:49.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lanjut.
Dialogue: 0,0:10:49.71,0:10:51.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arah jam sebelas, jarak 1.200.
Dialogue: 0,0:11:04.14,0:11:05.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak sampai, ya?
Dialogue: 0,0:11:06.40,0:11:07.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:11:08.61,0:11:09.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pusaran!
Dialogue: 0,0:11:18.41,0:11:19.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu lagi.
Dialogue: 0,0:11:20.37,0:11:21.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sabel Obsidian!
Dialogue: 0,0:11:30.69,0:11:32.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf...
Dialogue: 0,0:11:32.05,0:11:33.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemulihan.
Dialogue: 0,0:11:40.88,0:11:43.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih...\NSekarang mundurlah.
Dialogue: 0,0:11:44.09,0:11:45.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Jangan-jangan...
Dialogue: 0,0:11:46.94,0:11:48.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini belum berakhir.
Dialogue: 0,0:12:07.64,0:12:09.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin...
Dialogue: 0,0:12:09.88,0:12:13.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya, nama "Iblis" itu\Nbukan sekadar isapan jempol.
Dialogue: 0,0:12:19.08,0:12:22.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Romantica, kapalnya sudah ada di jarak aman.
Dialogue: 0,0:12:22.05,0:12:23.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya sudah aman.
Dialogue: 0,0:12:23.83,0:12:25.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah...
Dialogue: 0,0:12:28.89,0:12:30.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu memang hebat.
Dialogue: 0,0:12:30.06,0:12:32.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang, itu yang membuatku kesal!
Dialogue: 0,0:12:33.19,0:12:35.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, untuk sekarang bukan masalah.
Dialogue: 0,0:12:39.70,0:12:41.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus segera mengungsi juga.
Dialogue: 0,0:12:51.20,0:12:52.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Romantica...
Dialogue: 0,0:12:53.03,0:12:54.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:13:00.84,0:13:03.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Desir, kami sudah tiba di stasiun.
Dialogue: 0,0:13:03.10,0:13:04.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana dengan kalian?
Dialogue: 0,0:13:05.56,0:13:07.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tinggal sebentar lagi.\NKalian duluan saja...
Dialogue: 0,0:13:07.89,0:13:08.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Akan kutunggu!\N- Aku menunggumu!
Dialogue: 0,0:13:11.00,0:13:12.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:13:15.27,0:13:16.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Romantica, kamu baik-baik saja?
Dialogue: 0,0:13:18.03,0:13:20.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku... baik-baik... saja.
Dialogue: 0,0:13:21.14,0:13:22.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelihatannya tidak begitu.
Dialogue: 0,0:13:24.78,0:13:27.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya terlalu banyak memakai manaku.
Dialogue: 0,0:13:34.32,0:13:36.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sip! Ayo jalan!
Dialogue: 0,0:13:36.30,0:13:37.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:13:38.66,0:13:40.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:13:40.00,0:13:41.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu para Outer yang tersisa!
Dialogue: 0,0:13:41.43,0:13:42.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di mana?
Dialogue: 0,0:13:43.12,0:13:44.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tak bisa membiarkan mereka.
Dialogue: 0,0:13:45.12,0:13:46.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Romantica, pergilah ke stasiun.
Dialogue: 0,0:13:46.72,0:13:48.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak!\NAku juga akan...
Dialogue: 0,0:13:48.43,0:13:51.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manamu sudah habis, kan?\NTak perlu memaksakan diri lagi.
Dialogue: 0,0:13:51.94,0:13:54.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu benar, tapi...
Dialogue: 0,0:13:57.13,0:13:59.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan gegabah, ya?
Dialogue: 0,0:13:59.86,0:14:01.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku paham.
Dialogue: 0,0:14:02.31,0:14:03.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh...
Dialogue: 0,0:14:04.24,0:14:06.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senyummu itu bikin kesal.
Dialogue: 0,0:14:14.35,0:14:16.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Romantica.
Dialogue: 0,0:14:24.41,0:14:27.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak ingin kejadian\Nyang sama terulang!
Dialogue: 0,0:14:34.42,0:14:35.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aaron...
Dialogue: 0,0:14:36.71,0:14:37.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu?
Dialogue: 0,0:14:38.44,0:14:40.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak ingat pernah\Nmengatakan namaku.
Dialogue: 0,0:14:41.14,0:14:42.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan kelancangan saya!
Dialogue: 0,0:14:42.49,0:14:45.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesatria Kerajaan Divide, Tuan Aaron.
Dialogue: 0,0:14:46.18,0:14:47.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh!
Dialogue: 0,0:14:47.32,0:14:50.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu penyihir yang mengevakuasi\Nraja dari kastel, ya?
Dialogue: 0,0:14:51.05,0:14:51.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar!
Dialogue: 0,0:14:52.04,0:14:54.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya Desir Herrman dari Akademi Hebrion.
Dialogue: 0,0:14:55.33,0:14:57.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Izinkan aku berterima kasih sekali lagi.
Dialogue: 0,0:14:59.11,0:15:00.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:15:00.38,0:15:01.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:15:02.99,0:15:05.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akulah yang ingin berterima kasih.
Dialogue: 0,0:15:07.05,0:15:08.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena aku bisa kembali
Dialogue: 0,0:15:09.05,0:15:11.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berbicara denganmu seperti ini lagi.
Dialogue: 0,0:15:15.79,0:15:18.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapal Kerajaan Divide\Nseharusnya sudah berangkat.
Dialogue: 0,0:15:18.53,0:15:20.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa Anda ada di sini, Komandan?
Dialogue: 0,0:15:20.77,0:15:24.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini memang masalah negara lain,\Ntapi aku tidak bisa tinggal diam.
Dialogue: 0,0:15:24.56,0:15:27.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sedang mencari\Nkalau ada yang tertinggal...
Dialogue: 0,0:15:27.45,0:15:30.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sampai dimarahi Yang Mulia.
Dialogue: 0,0:15:31.27,0:15:32.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tidak berubah...
Dialogue: 0,0:15:34.44,0:15:36.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harap segera pergi dari sini.
Dialogue: 0,0:15:36.04,0:15:36.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:15:37.67,0:15:41.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesaat lagi, kekuatan iblis itu\Nakan menjangkau tempat ini.
Dialogue: 0,0:15:41.65,0:15:44.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia masih belum menunjukkan\Nseluruh kekuatannya.
Dialogue: 0,0:15:45.59,0:15:46.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu...
Dialogue: 0,0:15:47.05,0:15:49.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya tidak ingin ada korban jiwa.
Dialogue: 0,0:15:53.07,0:15:54.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:15:54.31,0:15:55.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:15:56.29,0:15:57.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai nanti!
Dialogue: 0,0:16:38.27,0:16:39.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zod?
Dialogue: 0,0:16:39.83,0:16:40.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baik-baik saja.
Dialogue: 0,0:16:40.73,0:16:42.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kuakhiri.
Dialogue: 0,0:16:45.01,0:16:46.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemutlakan Zero.
Dialogue: 0,0:16:52.14,0:16:53.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Raungan Magma!
Dialogue: 0,0:17:28.47,0:17:30.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya dia tumbang juga.
Dialogue: 0,0:17:30.09,0:17:32.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus, Zod.
Dialogue: 0,0:17:32.15,0:17:33.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum!
Dialogue: 0,0:17:36.20,0:17:37.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudmu?
Dialogue: 0,0:17:37.95,0:17:41.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dadeinuf belum menunjukkan wujud aslinya.
Dialogue: 0,0:17:47.78,0:17:51.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iblis itu dikatakan pernah\Nmeluluhlantakkan kota dalam semalam.
Dialogue: 0,0:17:52.61,0:17:54.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wujud sejatinya adalah...
Dialogue: 0,0:18:30.16,0:18:32.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah Iblis Malapetaka...
Dialogue: 0,0:18:32.13,0:18:35.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wujud sejati dari Dadeinuf!
Dialogue: 0,0:18:39.67,0:18:41.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang harus kita lakukan?
Dialogue: 0,0:18:42.27,0:18:45.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Desir, tolong jaga Priscilla.
Dialogue: 0,0:18:45.14,0:18:48.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seorang santa diperlukan\Nuntuk menjaga kedamaian dunia.
Dialogue: 0,0:18:48.94,0:18:50.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan, Zod!
Dialogue: 0,0:18:51.39,0:18:53.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau untuk menjaga kedamaian dunia,
Dialogue: 0,0:18:53.53,0:18:56.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita juga tidak boleh\Nkehilangan Zod Exarion!
Dialogue: 0,0:18:58.02,0:19:02.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master Menara, berikan padaku sisa manamu.
Dialogue: 0,0:19:04.25,0:19:07.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu bisa mengalahkannya?
Dialogue: 0,0:19:07.54,0:19:08.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa!
Dialogue: 0,0:19:15.18,0:19:17.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mantra sihir tingkat rendah?
Dialogue: 0,0:19:18.27,0:19:20.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang ingin kamu lakukan dengan itu?
Dialogue: 0,0:19:20.01,0:19:20.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu.
Dialogue: 0,0:19:21.99,0:19:25.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir perlahan berevolusi,\Nmengikuti zamannya.
Dialogue: 0,0:19:25.88,0:19:27.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, satu hal yang tidak berubah...
Dialogue: 0,0:19:28.44,0:19:34.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yaitu kewajiban memproses mana\Nyang ada di atmosfer.
Dialogue: 0,0:19:35.99,0:19:41.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bisa mengalahkan iblis itu hanya dengan\Nmenumpuk mantra sihir yang simpel ini?
Dialogue: 0,0:19:41.77,0:19:42.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:19:43.29,0:19:46.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan manusia tidak bisa\Nmengalahkan iblis itu.
Dialogue: 0,0:19:55.16,0:19:56.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar...
Dialogue: 0,0:19:57.23,0:19:59.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini adalah kekuatan yang melebihi iblis itu!
Dialogue: 0,0:20:14.73,0:20:19.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mantra sihir milik ras yang dulu\Ndikenal sebagai asal muasal sihir,
Dialogue: 0,0:20:19.17,0:20:22.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ras yang kini keberadaannya\Ntelah dilupakan umat manusia.
Dialogue: 0,0:20:23.12,0:20:24.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang ingin kamu lakukan?
Dialogue: 0,0:20:33.18,0:20:37.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada dasarnya, mantra hanya\Nsekadar teknik bagi manusia,
Dialogue: 0,0:20:37.05,0:20:39.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk memproses mana\Ndan mengubahnya menjadi sihir.
Dialogue: 0,0:20:41.63,0:20:44.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagi dia, yang memiliki mana\Ndalam darahnya sendiri,
Dialogue: 0,0:20:45.41,0:20:47.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia tidak memerlukan mantra.
Dialogue: 0,0:20:48.89,0:20:52.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bisa memanggil kehancuran\Nhanya dengan kata-kata.
Dialogue: 0,0:20:54.03,0:20:55.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, kan?
Dialogue: 0,0:20:56.61,0:20:58.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boromir Napolitan!
Dialogue: 0,0:21:18.70,0:21:20.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menarik.
Dialogue: 0,0:21:21.45,0:21:24.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perlihatkan padaku, Desir Herrman!
Dialogue: 0,0:23:41.23,0:23:44.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya: Kata-Kata Kehancuran.
