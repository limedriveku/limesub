Dialogue: 0,0:01:40.00,0:01:44.46,sign,,0000,0000,0000,,SIHIR SANG PENGULANG JELAS ISTIMEWA\N- MUSIM KEDUA
Dialogue: 0,0:02:59.28,0:03:03.04,sign,,0000,0000,0000,,EPISODE 15: LAUT KUNING
Dialogue: 0,0:07:14.54,0:07:15.41,sign,,0000,0000,0000,,DESIR HEBAT
Dialogue: 0,0:08:37.40,0:08:39.03,sign,,0000,0000,0000,,DESIR HEBAT
Dialogue: 0,0:21:06.20,0:21:09.71,sign,,0000,0000,0000,,KERAJAAN DIVIDE - RAJA KOLORA BALDERISHU
Dialogue: 0,0:21:15.63,0:21:19.17,sign,,0000,0000,0000,,KERAJAAN FRELETZIA - RAJA GREED
Dialogue: 0,0:23:40.48,0:23:45.20,sign,,0000,0000,0000,,EPISODE 16: AWAL
Dialogue: 0,0:00:21.25,0:00:22.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Langit yang membara.
Dialogue: 0,0:00:25.31,0:00:28.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ombak suara tangis dan jerit rasa sakit.
Dialogue: 0,0:00:31.80,0:00:33.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempat apa ini?
Dialogue: 0,0:01:05.96,0:01:08.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iblis Kehancuran...
Dialogue: 0,0:01:08.51,0:01:09.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dadeinuf!
Dialogue: 0,0:01:19.73,0:01:21.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku paham.
Dialogue: 0,0:01:22.02,0:01:23.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus
Dialogue: 0,0:01:23.94,0:01:27.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}membalas dendam Romantica padanya!
Dialogue: 0,0:03:07.79,0:03:14.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hiks, hiks, hiks.
Dialogue: 0,0:03:16.01,0:03:21.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mumpung sedang libur musim panas,\Nbagaimana kalau lebih kita nikmati lagi?
Dialogue: 0,0:03:21.85,0:03:22.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:03:22.77,0:03:23.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hiks?
Dialogue: 0,0:03:24.64,0:03:26.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini semua salahmu.
Dialogue: 0,0:03:28.44,0:03:31.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kejuaraan Laut Kuning?
Dialogue: 0,0:03:31.61,0:03:35.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, sebentar lagi libur musim panas,\Naku rasa sebaiknya kita ikutan.
Dialogue: 0,0:03:35.65,0:03:39.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak salah,\Nitu kompetisi di Kerajaan Freletzia.
Dialogue: 0,0:03:39.12,0:03:42.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syarat mengikutinya hanyalah berumur\Ndi bawah dua puluh tahun.
Dialogue: 0,0:03:42.54,0:03:44.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mengecualikan\NPendekar ataupun Penyihir.
Dialogue: 0,0:03:44.79,0:03:45.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tahu banyak.
Dialogue: 0,0:03:45.62,0:03:47.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja.
Dialogue: 0,0:03:47.46,0:03:50.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerajaan Freletzia adalah kampung halamanku.
Dialogue: 0,0:03:50.46,0:03:54.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jujur saja, kompetisi itu\Nlevelnya cukup tinggi.
Dialogue: 0,0:03:54.09,0:03:57.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang ikut adalah calon komandan kesatria,\Neksekutif Menara Sihir.
Dialogue: 0,0:03:57.63,0:04:01.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada dasarnya, kompetisi itu\Ndipenuhi orang-orang berbakat, tahu?
Dialogue: 0,0:04:01.93,0:04:04.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Bagaimana nasib kita nanti?
Dialogue: 0,0:04:04.60,0:04:06.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita pasti bisa.
Dialogue: 0,0:04:06.60,0:04:09.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik! Kalau kamu bilang begitu,\Nkita pasti bisa!
Dialogue: 0,0:04:09.98,0:04:12.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kita hadapi mereka!\N- Apa boleh buat.
Dialogue: 0,0:04:12.27,0:04:13.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:04:13.48,0:04:15.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kompetisinya minggu depan.
Dialogue: 0,0:04:15.07,0:04:18.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita latihan keras sebelum itu.
Dialogue: 0,0:04:19.32,0:04:20.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya?
Dialogue: 0,0:04:20.36,0:04:21.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Desir?
Dialogue: 0,0:04:21.70,0:04:23.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu ada waktu?
Dialogue: 0,0:04:23.07,0:04:24.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master Menara?
Dialogue: 0,0:04:24.40,0:04:25.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:04:26.50,0:04:29.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesaat lagi Akademi Hebrion\Nakan libur musim panas, ya?
Dialogue: 0,0:04:29.96,0:04:30.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:04:30.83,0:04:33.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya ingin kamu mendampingi saya.
Dialogue: 0,0:04:33.71,0:04:35.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong luangkan jadwalmu minggu depan.
Dialogue: 0,0:04:35.84,0:04:37.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah!
Dialogue: 0,0:04:37.26,0:04:39.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, akan saya tunggu.
Dialogue: 0,0:04:43.89,0:04:46.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apanya yang "Kita pasti bisa?"
Dialogue: 0,0:04:46.77,0:04:47.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Heh!
Dialogue: 0,0:04:47.48,0:04:50.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau bagaimana lagi?\NAda urusan penting!
Dialogue: 0,0:04:50.64,0:04:52.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak akan menolak\Npermintaan Master Menara.
Dialogue: 0,0:04:52.82,0:04:53.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar sekali!
Dialogue: 0,0:04:53.98,0:04:59.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi kamu lebih menghargai\Nbeliau daripada kami?
Dialogue: 0,0:04:59.07,0:05:00.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hiks, hiks!
Dialogue: 0,0:05:00.86,0:05:02.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apanya yang Master Menara?
Dialogue: 0,0:05:02.87,0:05:06.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada akhirnya, pria tunduk terhadap wewenang!
Dialogue: 0,0:05:06.37,0:05:09.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita sudah ditelantarkan!
Dialogue: 0,0:05:09.66,0:05:12.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu sampai sekeji itu, Pram!
Dialogue: 0,0:05:12.00,0:05:13.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan bercandanya!
Dialogue: 0,0:05:13.79,0:05:16.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, iya.\NKalian mau apa?
Dialogue: 0,0:05:33.90,0:05:37.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang kembali, Nona Romantica.
Dialogue: 0,0:05:37.15,0:05:39.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pulang, semuanya!
Dialogue: 0,0:05:39.52,0:05:41.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah Anda riang seperti biasanya.
Dialogue: 0,0:05:41.40,0:05:42.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:05:42.53,0:05:45.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kuperkenalkan.\NMereka anggota timku.
Dialogue: 0,0:05:49.29,0:05:52.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata keluarganya Romantica\Ntajir melintir, ya!
Dialogue: 0,0:05:52.21,0:05:53.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:05:53.42,0:05:56.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka salah satu yang terkaya\Ndi Kerajaan Freletzia.
Dialogue: 0,0:05:56.21,0:05:57.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu,
Dialogue: 0,0:05:58.46,0:06:00.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu paham, bukan?
Dialogue: 0,0:06:01.01,0:06:02.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya...
Dialogue: 0,0:06:02.01,0:06:04.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini kita tidak akan latihan.
Dialogue: 0,0:06:04.17,0:06:05.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo main sepuasnya!
Dialogue: 0,0:06:05.39,0:06:08.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hore!
Dialogue: 0,0:06:09.14,0:06:11.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasakan!
Dialogue: 0,0:06:17.65,0:06:18.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Desir!
Dialogue: 0,0:06:18.90,0:06:19.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke!
Dialogue: 0,0:06:38.21,0:06:39.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yes!
Dialogue: 0,0:06:39.00,0:06:39.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus!
Dialogue: 0,0:06:39.96,0:06:42.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak sempat!
Dialogue: 0,0:06:42.97,0:06:45.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, apa boleh buat.
Dialogue: 0,0:06:47.03,0:06:50.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik kecepatan dan presisi rapalannya\Nbenar-benar meningkat.
Dialogue: 0,0:06:51.22,0:06:54.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia makin kuat setelah peringkatnya naik.
Dialogue: 0,0:06:54.35,0:06:55.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita balas mereka.
Dialogue: 0,0:06:55.39,0:06:56.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:07:02.74,0:07:03.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan padaku!
Dialogue: 0,0:07:03.86,0:07:07.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu akan membalikkan sihirnya,\Nkuhantam dengan kekuatan murni!
Dialogue: 0,0:07:09.53,0:07:11.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami juga akan memakai sihir.
Dialogue: 0,0:07:11.62,0:07:13.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu memang hebat, Desir!
Dialogue: 0,0:07:13.58,0:07:14.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Desir hebat!
Dialogue: 0,0:07:16.62,0:07:18.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pram, terima bolanya!
Dialogue: 0,0:07:18.04,0:07:18.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:07:21.96,0:07:22.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Azest?
Dialogue: 0,0:07:23.30,0:07:24.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari mana?
Dialogue: 0,0:07:24.84,0:07:26.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kena kalian!
Dialogue: 0,0:07:29.85,0:07:31.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Smesan tunda?
Dialogue: 0,0:07:31.35,0:07:33.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang akan kuhantam\Ndengan kekuatan murni.
Dialogue: 0,0:07:43.28,0:07:45.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana?
Dialogue: 0,0:07:45.19,0:07:47.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Desir!
Dialogue: 0,0:07:47.66,0:07:50.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, kalian berdua benar-benar kuat.
Dialogue: 0,0:07:50.30,0:07:53.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Latihan keras sejauh ini terbayarkan.
Dialogue: 0,0:07:53.20,0:07:55.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak perlu menahan diri, ya.
Dialogue: 0,0:07:56.33,0:07:57.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, Pram.
Dialogue: 0,0:07:57.42,0:07:58.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:08:00.67,0:08:01.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penguatan!
Dialogue: 0,0:08:09.39,0:08:10.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei...
Dialogue: 0,0:08:10.55,0:08:11.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan padaku.
Dialogue: 0,0:08:33.90,0:08:35.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu poin pertama.
Dialogue: 0,0:08:35.78,0:08:37.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Desir hebat!
Dialogue: 0,0:08:47.51,0:08:49.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Indah, bukan?
Dialogue: 0,0:08:49.55,0:08:52.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, luar biasa.
Dialogue: 0,0:08:52.80,0:08:54.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inilah Laut Kuning.
Dialogue: 0,0:08:55.06,0:08:59.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kilaunya begitu terang, bagaikan emas cair\Ntelah meleleh dan mengalir ke laut.
Dialogue: 0,0:08:59.31,0:09:03.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya laut ini mengandung mana\Nyang bereaksi ke sinar matahari?
Dialogue: 0,0:09:03.56,0:09:06.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu benar-benar tahu semuanya, ya?
Dialogue: 0,0:09:06.57,0:09:10.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku yakin kamu tidak tahu\Nada yang lebih indah dari ini.
Dialogue: 0,0:09:16.08,0:09:20.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dulu ada kota yang sangat makmur\Ndi sekitar sini.
Dialogue: 0,0:09:20.71,0:09:24.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, erupsi gunung berapi memusnahkannya.
Dialogue: 0,0:09:24.80,0:09:27.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal di sekitar sini\Ntidak ada gunung berapi.
Dialogue: 0,0:09:27.84,0:09:29.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aneh, bukan?
Dialogue: 0,0:09:38.27,0:09:40.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai!
Dialogue: 0,0:09:45.40,0:09:48.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana?\NLuar biasa, bukan?
Dialogue: 0,0:09:48.72,0:09:52.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah kenapa legenda mengatakan erupsi\Ngunung berapi meluluhlantakkan kotanya.
Dialogue: 0,0:09:53.32,0:09:55.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misteri itu belum terpecahkan.
Dialogue: 0,0:09:56.03,0:09:59.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, beragam legenda diturunkan\Nuntuk memenuhi kekosongannya.
Dialogue: 0,0:10:00.51,0:10:02.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari semua tempat,
Dialogue: 0,0:10:02.84,0:10:05.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kenapa harus di kampung halamanku?
Dialogue: 0,0:10:05.29,0:10:06.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang paling terkenal
Dialogue: 0,0:10:07.42,0:10:09.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah Legenda Iblis Malapetaka.
Dialogue: 0,0:10:10.46,0:10:13.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadinya ada vila di sekitar sini...
Dialogue: 0,0:10:13.88,0:10:17.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Laut emas yang berkilauan\Ndi sini sangatlah indah...
Dialogue: 0,0:10:17.64,0:10:22.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iblis itu muncul bersama api\Ndan membelah daratan.
Dialogue: 0,0:10:22.77,0:10:26.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak ingin mati di sini...
Dialogue: 0,0:10:26.27,0:10:31.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Laut ini bahkan dinamakan\Natas legenda itu, tapi...
Dialogue: 0,0:10:31.24,0:10:33.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa namanya, ya?
Dialogue: 0,0:10:33.65,0:10:34.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malapetaka...
Dialogue: 0,0:10:34.68,0:10:35.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:10:36.81,0:10:38.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Laut Malapetaka...
Dialogue: 0,0:10:38.64,0:10:40.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Istakar.
Dialogue: 0,0:10:40.04,0:10:41.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, itu!
Dialogue: 0,0:10:41.91,0:10:45.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, kamu benar-benar tahu semuanya, ya?
Dialogue: 0,0:10:45.04,0:10:47.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, aku sudah tidak kaget lagi, sih.
Dialogue: 0,0:10:50.67,0:10:53.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sinilah aku gagal melindungimu.
Dialogue: 0,0:10:54.84,0:10:56.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Romantica!
Dialogue: 0,0:10:56.93,0:10:58.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kenapa?
Dialogue: 0,0:10:58.63,0:11:00.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu baik-baik saja?
Dialogue: 0,0:11:02.73,0:11:03.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Desir?
Dialogue: 0,0:11:05.10,0:11:06.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Romantica...
Dialogue: 0,0:11:06.98,0:11:07.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:11:08.56,0:11:09.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai sekarang...
Dialogue: 0,0:11:10.40,0:11:12.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku menyuruhmu kabur...
Dialogue: 0,0:11:12.48,0:11:14.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa pun yang terjadi, kaburlah.
Dialogue: 0,0:11:14.24,0:11:15.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:11:20.66,0:11:26.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah menu latihan brutalmu itu ada\Nagar aku tidak perlu kabur?
Dialogue: 0,0:11:26.00,0:11:29.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lain kali kita pasti akan mengalahkan\Nsi Outer atau apalah itu.
Dialogue: 0,0:11:29.88,0:11:32.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin kamu tetap hidup.
Dialogue: 0,0:11:32.05,0:11:34.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kamu dari tadi bertingkah aneh...
Dialogue: 0,0:11:36.55,0:11:39.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berjanjilah padaku, kamu akan kabur.
Dialogue: 0,0:11:40.51,0:11:43.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan berusaha untuk melawan.
Dialogue: 0,0:11:43.56,0:11:46.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mohon, Romantica...
Dialogue: 0,0:11:48.77,0:11:50.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, aku paham.
Dialogue: 0,0:12:01.95,0:12:05.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, jangan berwajah seperti itu.
Dialogue: 0,0:12:13.92,0:12:15.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tegang sekali, ya.
Dialogue: 0,0:12:15.42,0:12:16.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:12:28.02,0:12:30.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami telah menunggu Anda, Master Menara.
Dialogue: 0,0:12:31.77,0:12:34.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah setengah bulan\Nsejak kita bertemu langsung.
Dialogue: 0,0:12:34.43,0:12:37.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhir-akhir ini saya selalu meneliti di lab.
Dialogue: 0,0:12:37.49,0:12:40.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya begitu terkesan dengan\Nide-ide yang kamu berikan.
Dialogue: 0,0:12:40.49,0:12:43.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah Anda menyukainya.
Dialogue: 0,0:12:43.66,0:12:47.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian anggota tim\Ndari penasihat teknis saya, benar?
Dialogue: 0,0:12:47.50,0:12:50.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar!\NNama saya Romantica Eru!
Dialogue: 0,0:12:50.50,0:12:53.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suatu kehormatan\Nbisa bertemu Anda, Master Menara!
Dialogue: 0,0:12:53.25,0:12:55.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu putri dari keluarga Eru, ya.
Dialogue: 0,0:12:55.73,0:12:59.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayahmu adalah partner bisnis penting\Nbagi Menara Penyihir.
Dialogue: 0,0:12:59.47,0:13:01.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuharap kita bisa terus bekerja sama.
Dialogue: 0,0:13:01.09,0:13:02.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:13:02.09,0:13:05.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya kemarin kamu baru saja\Nmengolok-olok Master Menara?
Dialogue: 0,0:13:05.72,0:13:07.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, kok.
Dialogue: 0,0:13:07.02,0:13:08.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, hei...
Dialogue: 0,0:13:08.18,0:13:09.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pram Schnaizer.
Dialogue: 0,0:13:09.81,0:13:10.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:13:10.77,0:13:14.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar kamu berhasil dapat satu poin\Nsaat melawan kepala keamananku.
Dialogue: 0,0:13:17.03,0:13:19.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu hebat bisa melakukannya\Npadahal masih muda.
Dialogue: 0,0:13:20.20,0:13:22.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Desir juga sering memujimu.
Dialogue: 0,0:13:22.87,0:13:24.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:13:27.16,0:13:29.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu Azest Kingscrown, benar?
Dialogue: 0,0:13:32.62,0:13:33.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senang bertemu denganmu.
Dialogue: 0,0:13:36.09,0:13:37.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu pula denganku.
Dialogue: 0,0:13:40.47,0:13:42.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya dengar kalian akan mengikuti kejuaraan.
Dialogue: 0,0:13:42.68,0:13:44.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, benar.
Dialogue: 0,0:13:44.30,0:13:48.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, ya, Desir harus saya pinjam\Nuntuk membantu kami.
Dialogue: 0,0:13:48.97,0:13:52.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan masalah!\NUrusan Anda jauh lebih penting.
Dialogue: 0,0:13:52.64,0:13:56.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anggap saja ini sebagai permintaan maaf,\Ndan biaya untuk menyewa Desir.
Dialogue: 0,0:14:07.24,0:14:08.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini?
Dialogue: 0,0:14:08.99,0:14:10.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukalah.
Dialogue: 0,0:14:10.58,0:14:11.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:14:13.87,0:14:15.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senapan?
Dialogue: 0,0:14:15.25,0:14:17.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penasihat teknis saya\Nmeminta saya untuk membuatnya.
Dialogue: 0,0:14:17.50,0:14:18.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Desir meminta Anda?
Dialogue: 0,0:14:18.75,0:14:19.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah!
Dialogue: 0,0:14:19.32,0:14:21.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terdapat Bijih Sihir kecil di dalamnya,
Dialogue: 0,0:14:21.48,0:14:24.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang bisa memperkuat kekuatan dari sihirmu.
Dialogue: 0,0:14:25.01,0:14:29.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan ini, sihirmu seharusnya\Nbisa sekuat sihir tingkat tinggi.
Dialogue: 0,0:14:29.82,0:14:31.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak!
Dialogue: 0,0:14:31.39,0:14:33.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya pun senang saat membuatnya.
Dialogue: 0,0:14:33.83,0:14:36.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan berikan kesanmu saat menggunakannya.
Dialogue: 0,0:14:36.15,0:14:37.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pastinya!
Dialogue: 0,0:14:37.96,0:14:39.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, ya!
Dialogue: 0,0:14:39.27,0:14:41.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan ini kamu tidak boleh kalah, ya.
Dialogue: 0,0:14:41.61,0:14:42.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja!
Dialogue: 0,0:14:42.99,0:14:44.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pasti akan jadi juara!
Dialogue: 0,0:14:44.85,0:14:48.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya akan sempurna\Nkalau kamu hadir, Desir.
Dialogue: 0,0:14:48.28,0:14:51.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kalian sampai final,\Naku bisa ke sana menyemangati kalian.
Dialogue: 0,0:14:51.33,0:14:52.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kami menangkan!
Dialogue: 0,0:14:52.85,0:14:54.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong jaga mereka berdua.
Dialogue: 0,0:14:54.21,0:14:55.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:14:56.83,0:14:58.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tim yang bagus.
Dialogue: 0,0:15:13.64,0:15:15.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pergi...
Dialogue: 0,0:15:15.35,0:15:18.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, apa boleh buat.\NDia harus mengurus sesuatu.
Dialogue: 0,0:15:18.83,0:15:20.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Konferensi Kerajaan.
Dialogue: 0,0:15:20.48,0:15:25.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perwakilan tiap negara berkumpul di sana\Nuntuk menentukan masa depan dunia.
Dialogue: 0,0:15:25.11,0:15:28.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi dia menghadiri\Nkonferensi penting seperti itu...
Dialogue: 0,0:15:28.09,0:15:29.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia memang hebat!
Dialogue: 0,0:15:29.83,0:15:31.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu selalu bilang begitu, Pram.
Dialogue: 0,0:15:33.97,0:15:35.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia memang luar biasa.
Dialogue: 0,0:15:39.88,0:15:42.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya telah membaca laporanmu\Nsoal Dunia Bayangan.
Dialogue: 0,0:15:42.98,0:15:44.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teori yang benar-benar menarik.
Dialogue: 0,0:15:45.17,0:15:47.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana menurut Anda, Master Menara?
Dialogue: 0,0:15:48.32,0:15:51.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dunia Bayangan memberikan Bijih Sihir,
Dialogue: 0,0:15:51.68,0:15:54.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sumber energi magis yang besar,\Nsaat kondisinya telah terpenuhi.
Dialogue: 0,0:15:54.98,0:15:58.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa dibilang mereka mirip dengan tambang.
Dialogue: 0,0:15:58.27,0:15:59.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:15:59.02,0:16:01.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, menurut teorimu...
Dialogue: 0,0:16:01.90,0:16:04.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin ini usaha seseorang
Dialogue: 0,0:16:04.75,0:16:08.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk menunjukkan sejarah\Nyang seharusnya terjadi.
Dialogue: 0,0:16:09.62,0:16:12.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan membiarkan mereka di dalamnya\Nmengalaminya sendiri.
Dialogue: 0,0:16:13.70,0:16:15.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Layaknya sebuah gim.
Dialogue: 0,0:16:17.50,0:16:19.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin saja kita sedang diuji.
Dialogue: 0,0:16:19.92,0:16:22.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oleh siapa?
Dialogue: 0,0:16:22.42,0:16:23.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oleh sejarah...
Dialogue: 0,0:16:23.97,0:16:27.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau sesuatu dari dunia ini sendiri.
Dialogue: 0,0:16:28.05,0:16:31.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimanapun,\Npersoalan ini menarik untuk dikaji.
Dialogue: 0,0:16:31.24,0:16:32.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya nantikan kelanjutannya.
Dialogue: 0,0:16:32.91,0:16:33.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:16:35.72,0:16:38.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Konferensinya dilakukan\Ndi Kastel Freletzia, ya?
Dialogue: 0,0:16:38.31,0:16:41.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kita tidak terlalu dini untuk rapatnya?
Dialogue: 0,0:16:41.33,0:16:43.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya sengaja agar kita datang lebih awal.
Dialogue: 0,0:16:44.93,0:16:48.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada seseorang yang ingin saya kenalkan\Npadamu sebelum konferensinya.
Dialogue: 0,0:16:48.70,0:16:51.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Santa Priscilla Heisilgard.
Dialogue: 0,0:16:51.45,0:16:52.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:16:53.20,0:16:55.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya menantikan ekspresimu itu.
Dialogue: 0,0:16:55.11,0:16:58.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena saya yang biasanya\Nselalu kamu kejutkan.
Dialogue: 0,0:17:05.33,0:17:06.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Priscilla...
Dialogue: 0,0:17:06.92,0:17:08.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah lama aku tidak bertemu dengannya.
Dialogue: 0,0:17:14.64,0:17:18.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia benar-benar menyeramkan\Nsaat sedang berdebat dengan Zod.
Dialogue: 0,0:17:38.33,0:17:41.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Mulia, saya Desir,\Nsiswa tahun pertama di Akademi Hebrion.
Dialogue: 0,0:17:41.58,0:17:43.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zod sudah bilang tentangmu.
Dialogue: 0,0:17:43.51,0:17:46.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Angkat wajahmu, Desir Herrman.
Dialogue: 0,0:17:47.13,0:17:47.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:17:49.34,0:17:51.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat menantikan bertemu denganmu.
Dialogue: 0,0:17:52.26,0:17:57.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namaku Priscilla Heisilgard,\Njuga dikenal sebagai Santa.
Dialogue: 0,0:18:08.28,0:18:09.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan duduk.
Dialogue: 0,0:18:09.48,0:18:10.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:18:11.70,0:18:14.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, ceritakan padaku.
Dialogue: 0,0:18:14.74,0:18:18.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kamu pelajari tentang jatuhnya\NKerajaan Suci di Dunia Bayangan?
Dialogue: 0,0:18:19.03,0:18:20.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesuai keinginan Anda.
Dialogue: 0,0:18:28.71,0:18:30.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:18:30.79,0:18:33.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi Kerajaan Suci hancur dari dalam.
Dialogue: 0,0:18:33.84,0:18:36.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada berbagai masalah yang terkait,
Dialogue: 0,0:18:36.72,0:18:39.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi setiap masalah itu\Nmenggoyangkan Kerajaan Suci.
Dialogue: 0,0:18:40.56,0:18:41.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:18:41.65,0:18:43.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wilhelm Evernatten.
Dialogue: 0,0:18:45.47,0:18:50.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dia bangkit, Kerajaan Suci\Nmungkin tidak akan hancur.
Dialogue: 0,0:18:50.90,0:18:52.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau itu terjadi...
Dialogue: 0,0:18:52.24,0:18:55.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin Kerajaan Suci akan bertahan,\Nmelindungi dunia ini,
Dialogue: 0,0:18:55.99,0:18:58.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan memenuhi tugasnya\Nsebagai Tameng Dewa.
Dialogue: 0,0:19:01.16,0:19:03.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku selalu penasaran.
Dialogue: 0,0:19:03.86,0:19:06.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gereja Artemis seharusnya melindungi rakyat.
Dialogue: 0,0:19:07.25,0:19:09.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa Kerajaan Suci bisa jatuh?
Dialogue: 0,0:19:12.80,0:19:15.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya aku dapat jawabannya.
Dialogue: 0,0:19:15.77,0:19:17.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:19:17.55,0:19:19.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senang bisa membantu.
Dialogue: 0,0:19:19.81,0:19:22.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus mencari cara\Nuntuk berterima kasih padamu.
Dialogue: 0,0:19:22.81,0:19:25.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ada yang bisa aku lakukan?
Dialogue: 0,0:19:28.06,0:19:32.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, saya ingin Persekutuan\NKerajaan Barat dan Kekaisaran Hebrion
Dialogue: 0,0:19:32.19,0:19:33.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menjalin hubungan persahabatan.
Dialogue: 0,0:19:34.82,0:19:37.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu paham yang telah kamu minta?
Dialogue: 0,0:19:38.28,0:19:39.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:19:39.62,0:19:41.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanpa adanya Dunia Bayangan,
Dialogue: 0,0:19:41.14,0:19:43.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}banyak negeri yang akan\Nsaling berperang saat ini juga.
Dialogue: 0,0:19:43.54,0:19:46.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan dengan adanya Dunia Bayangan.
Dialogue: 0,0:19:46.01,0:19:49.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak lama, Dunia Bayangan\Ntidak akan lagi menjadi ancaman.
Dialogue: 0,0:19:50.59,0:19:52.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlebih dengan pesatnya\Nperkembangan teknologi.
Dialogue: 0,0:19:53.55,0:19:55.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu semua berkat Master Menara Zod.
Dialogue: 0,0:19:55.34,0:19:56.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu...
Dialogue: 0,0:19:57.21,0:20:00.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau muncul Dunia Bayangan\Ndengan skala yang jauh lebih besar?
Dialogue: 0,0:20:00.90,0:20:04.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau muncul Dunia Bayangan\Nyang sangat banyak sampai sulit ditangani?
Dialogue: 0,0:20:05.18,0:20:07.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus bersiap untuk situasi terburuk.
Dialogue: 0,0:20:08.31,0:20:11.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sangat percaya diri\Ndengan prediksinya...
Dialogue: 0,0:20:11.21,0:20:12.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak...
Dialogue: 0,0:20:12.13,0:20:14.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia seolah yakin itu akan terjadi.
Dialogue: 0,0:20:15.01,0:20:18.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia akan melakukan berbagai hal\Ndemi mencapai tujuannya.
Dialogue: 0,0:20:19.03,0:20:21.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajar Zod tertarik padanya.
Dialogue: 0,0:20:21.66,0:20:23.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau terjadi situasi terburuk,
Dialogue: 0,0:20:23.65,0:20:27.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan umat manusia saling terpecah,\Ndunia ini akan hancur.
Dialogue: 0,0:20:27.87,0:20:29.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Layaknya Kerajaan Suci.
Dialogue: 0,0:20:29.96,0:20:30.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:20:31.23,0:20:34.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku setuju kalau kita harus bersiap\Nakan situasi terburuk.
Dialogue: 0,0:20:34.55,0:20:38.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku janji akan bekerja sama\Nkalau saat itu tiba.
Dialogue: 0,0:20:38.26,0:20:40.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak, Yang Mulia.
Dialogue: 0,0:20:42.85,0:20:43.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan.
Dialogue: 0,0:20:45.27,0:20:47.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah waktunya untuk konferensi Kerajaan.
Dialogue: 0,0:20:47.18,0:20:48.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:20:51.23,0:20:52.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Desir.
Dialogue: 0,0:20:52.15,0:20:52.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:20:53.44,0:20:56.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mirip dengan Zod, ya.
Dialogue: 0,0:20:56.19,0:20:57.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:21:16.88,0:21:19.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wahai para tamu terhormat dari berbagai negeri,
Dialogue: 0,0:21:19.17,0:21:22.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}beserta Master Menara,\Njuga Yang Mulia Santa.
Dialogue: 0,0:21:22.26,0:21:25.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak sudah berkumpul di sini.
Dialogue: 0,0:21:26.72,0:21:30.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan ini, aku nyatakan\NKonferensi Kerajaan Barat dibuka!
Dialogue: 0,0:21:32.81,0:21:37.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan-tuan dan nyonya-nyonya!
Dialogue: 0,0:21:38.15,0:21:40.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beri tepuk tangan yang meriah
Dialogue: 0,0:21:40.61,0:21:44.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pada para peserta pemberani muda\NKejuaraan Laut Kuning!
Dialogue: 0,0:21:47.70,0:21:50.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, pertandingan pertama mempertemukan
Dialogue: 0,0:21:50.00,0:21:54.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyihir Angin, Romantica Eru!
Dialogue: 0,0:21:55.38,0:22:01.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lawannya adalah Penyihir Bumi, Ruby Pidiora!
Dialogue: 0,0:22:02.37,0:22:04.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersedia...
Dialogue: 0,0:22:04.09,0:22:07.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap, mulai!
Dialogue: 0,0:23:41.27,0:23:44.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya: Awal.
