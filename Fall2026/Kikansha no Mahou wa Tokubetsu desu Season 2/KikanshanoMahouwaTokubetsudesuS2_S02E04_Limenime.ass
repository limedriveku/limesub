Dialogue: 0,0:01:13.09,0:01:17.52,sign,,0000,0000,0000,,SIHIR SANG PENGULANG JELAS ISTIMEWA\N- MUSIM KEDUA
Dialogue: 0,0:02:31.63,0:02:35.51,sign,,0000,0000,0000,,EPISODE 16: AWAL
Dialogue: 0,0:23:40.65,0:23:45.03,sign,,0000,0000,0000,,EPISODE 17: EROR
Dialogue: 0,0:00:12.99,0:00:14.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Bumi...
Dialogue: 0,0:00:14.70,0:00:16.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi teringat seseorang yang menyebalkan.
Dialogue: 0,0:00:40.60,0:00:41.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sialan!
Dialogue: 0,0:00:55.62,0:00:56.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasakan ini!
Dialogue: 0,0:02:44.34,0:02:47.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,\Nmari kita bahas agenda berikutnya.
Dialogue: 0,0:02:48.77,0:02:50.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yaitu Dunia Bayangan.
Dialogue: 0,0:02:51.23,0:02:56.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak Dunia Bayangan yang bermunculan,\Ntapi ada satu kekhawatiran utama...
Dialogue: 0,0:02:56.78,0:02:59.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, para Outer.
Dialogue: 0,0:02:59.28,0:03:00.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Outer?
Dialogue: 0,0:03:00.49,0:03:04.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka hanya sekumpulan kriminal,\Napa yang perlu dikhawatirkan?
Dialogue: 0,0:03:05.62,0:03:07.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harap lihat ini.
Dialogue: 0,0:03:08.84,0:03:13.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini Dunia Bayangan\Nyang tidak terawasi oleh kita.
Dialogue: 0,0:03:14.22,0:03:18.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya sudah ditangani\Ndan ancamannya telah diselesaikan.
Dialogue: 0,0:03:20.30,0:03:23.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masalahnya, yang menanganinya
Dialogue: 0,0:03:23.68,0:03:26.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah para Outer tersebut.
Dialogue: 0,0:03:26.14,0:03:31.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau para Outer itu memiliki teknologi\Nyang lebih canggih dari kita,
Dialogue: 0,0:03:31.40,0:03:34.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mereka mungkin akan menjadi ancaman.
Dialogue: 0,0:03:35.11,0:03:38.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana pendapat Anda, Master Menara?
Dialogue: 0,0:03:40.01,0:03:41.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti yang kalian tahu,
Dialogue: 0,0:03:41.33,0:03:45.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dua bulan lalu Menara Penyihir\Ndiserang oleh para Outer.
Dialogue: 0,0:03:45.46,0:03:46.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam kejadiannya,
Dialogue: 0,0:03:46.40,0:03:49.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami berhasil mengamankan orang\Nyang dianggap petingginya.
Dialogue: 0,0:03:50.42,0:03:51.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah menginterogasinya,
Dialogue: 0,0:03:51.92,0:03:55.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami berhasil menggagalkan\Nsebagian rencana Outer.
Dialogue: 0,0:03:55.59,0:04:00.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami pun berhasil mengungkap\Npara penyusup yang ada di Menara Penyihir.
Dialogue: 0,0:04:01.22,0:04:03.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jumlahnya lebih banyak dari perkiraan kami.
Dialogue: 0,0:04:05.02,0:04:08.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Outer menyusup dengan cara yang terampil.
Dialogue: 0,0:04:08.82,0:04:12.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada kemungkinan masih ada penyusup\Ndi Menara Penyihir.
Dialogue: 0,0:04:12.01,0:04:15.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kita juga perlu\Nmemikirkan kemungkinan lain.
Dialogue: 0,0:04:15.82,0:04:17.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yaitu pembahasan kita tadi.
Dialogue: 0,0:04:17.89,0:04:21.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alasan para Outer mampu menemukan
Dialogue: 0,0:04:21.37,0:04:23.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dunia Bayangan yang tidak bisa kita temukan,
Dialogue: 0,0:04:23.70,0:04:25.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bukanlah karena teknologi...
Dialogue: 0,0:04:26.12,0:04:30.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melainkan karena ada kemungkinan para Outer\Njuga menyusup ke berbagai negara.
Dialogue: 0,0:04:30.67,0:04:31.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:04:31.58,0:04:33.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zod...
Dialogue: 0,0:04:33.17,0:04:34.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tidak mungkin!
Dialogue: 0,0:04:34.55,0:04:36.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, kalau dipikir...
Dialogue: 0,0:04:36.42,0:04:39.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para Outer itu berhasil menyusup\Nke Menara Penyihir.
Dialogue: 0,0:04:39.01,0:04:41.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tidak bisa menyangkal kemungkinan itu.
Dialogue: 0,0:04:46.81,0:04:49.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya agak terburu-buru\Nkalau Anda mencurigai kami
Dialogue: 0,0:04:49.48,0:04:55.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hanya karena ada penyusup\Ndi Menara Penyihir, Zod Exarion?
Dialogue: 0,0:04:56.82,0:04:59.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksud Anda, Raja Balderishu?
Dialogue: 0,0:04:59.32,0:05:01.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mudah saja.
Dialogue: 0,0:05:01.24,0:05:05.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Musuh Kerajaan Barat bukan hanya Outer.
Dialogue: 0,0:05:05.33,0:05:07.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah ada orang-orang yang mampu
Dialogue: 0,0:05:07.33,0:05:11.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menaklukkan Dunia Bayangan\Ntanpa kita ketahui?
Dialogue: 0,0:05:13.33,0:05:17.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka adalah Kekaisaran Hebrion.
Dialogue: 0,0:05:19.38,0:05:20.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berikutnya!
Dialogue: 0,0:05:20.72,0:05:23.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pendekar Sihir Es dari Akademi Hebrion!
Dialogue: 0,0:05:23.39,0:05:26.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Azest Kingscrown!
Dialogue: 0,0:05:28.39,0:05:30.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jahat sekali...
Dialogue: 0,0:05:30.39,0:05:32.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa boleh buat.
Dialogue: 0,0:05:32.23,0:05:36.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hubungan keduanya seburuk itu\Nsampai-sampai perang bisa pecah kapan saja.
Dialogue: 0,0:05:38.03,0:05:41.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Perasaan kamu tadi baik-baik saja?
Dialogue: 0,0:05:41.40,0:05:44.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya kamu dapat\Ntepuk tangan saat menang tadi...
Dialogue: 0,0:05:44.16,0:05:46.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Habisnya, nama akademiku\Ntidak disebut tadi.
Dialogue: 0,0:05:46.91,0:05:49.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena ini kampung halamanku,\Naku cukup terkenal di sini.
Dialogue: 0,0:05:49.66,0:05:51.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terkenal dalam hal yang baik.
Dialogue: 0,0:05:51.00,0:05:52.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Curang!
Dialogue: 0,0:05:52.33,0:05:55.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang penting hasilnya bagus!
Dialogue: 0,0:05:55.54,0:05:58.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa Azest akan baik-baik saja?
Dialogue: 0,0:05:58.21,0:05:59.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja.
Dialogue: 0,0:05:59.92,0:06:02.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak perlu cemas.
Dialogue: 0,0:06:04.30,0:06:06.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku turut bersimpati.
Dialogue: 0,0:06:06.01,0:06:08.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena manusia tak bisa memilih\Ntempat kelahirannya.
Dialogue: 0,0:06:08.26,0:06:11.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, dunia kompetisi tak kenal ampun.
Dialogue: 0,0:06:11.02,0:06:13.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan melawanmu dengan sekuat tenaga.
Dialogue: 0,0:06:13.19,0:06:15.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wahai Pendekar Sihir yang jelita!
Dialogue: 0,0:06:24.82,0:06:26.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luar biasa!
Dialogue: 0,0:06:26.24,0:06:29.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Azest sepenuhnya fokus bertahan!
Dialogue: 0,0:06:29.62,0:06:31.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kuakhiri dengan satu serangan.
Dialogue: 0,0:06:33.91,0:06:35.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:06:40.42,0:06:41.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Naif sekali.
Dialogue: 0,0:06:41.76,0:06:43.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:06:52.89,0:06:54.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi itu pertandingan yang menarik.
Dialogue: 0,0:06:54.64,0:06:56.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertandingan selesai!
Dialogue: 0,0:06:56.77,0:06:59.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemenangnya adalah Azest Kingscrown!
Dialogue: 0,0:07:03.11,0:07:04.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang mengesalkan,
Dialogue: 0,0:07:04.70,0:07:08.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi Kekaisaran Hebrion memiliki\Nteknologi yang lebih canggih
Dialogue: 0,0:07:08.16,0:07:10.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}daripada kami di Kerajaan Barat.
Dialogue: 0,0:07:10.28,0:07:16.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maka dari itu, bukankah wajar\Nkalau kami beranggapan,
Dialogue: 0,0:07:16.21,0:07:18.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau kekaisaran bekerja sama\Ndengan para kriminal
Dialogue: 0,0:07:18.63,0:07:21.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk mengumpulkan Bijih Sihir?
Dialogue: 0,0:07:21.25,0:07:24.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana menurut Anda, Master Menara?
Dialogue: 0,0:07:24.65,0:07:27.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu salah satu kemungkinannya.
Dialogue: 0,0:07:27.13,0:07:30.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar!\NSangat mungkin Kekaisaran melakukannya!
Dialogue: 0,0:07:30.01,0:07:33.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka akan memakai cara apa pun\Nuntuk menghancurkan kita!
Dialogue: 0,0:07:34.39,0:07:37.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya, harap tenang!
Dialogue: 0,0:07:37.81,0:07:40.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harap tetaplah tenang!
Dialogue: 0,0:07:42.36,0:07:46.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya, sang Pendekar Gesit, Treviri!
Dialogue: 0,0:07:46.90,0:07:51.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jujur, aku tidak tahu harus apa\Nkalau mereka berdua lawanku...
Dialogue: 0,0:07:51.87,0:07:54.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kalau hanya dia, aku bisa menang!
Dialogue: 0,0:07:54.83,0:07:57.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kutunjukkan kemampuanku\Nyang telah kuasah ini!
Dialogue: 0,0:07:58.33,0:07:59.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:07:59.88,0:08:00.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai!
Dialogue: 0,0:08:07.88,0:08:09.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ciyaat!
Dialogue: 0,0:08:15.31,0:08:16.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menang!
Dialogue: 0,0:08:23.65,0:08:26.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya aku pernah lihat orang itu...
Dialogue: 0,0:08:26.19,0:08:27.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenal, tidak?
Dialogue: 0,0:08:27.11,0:08:28.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, aku baru melihatnya.
Dialogue: 0,0:08:28.78,0:08:31.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan ini?
Dialogue: 0,0:08:31.74,0:08:34.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekian kompetisi di pagi ini!
Dialogue: 0,0:08:34.12,0:08:37.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,\Nkita akan berkumpul kembali di sore hari!
Dialogue: 0,0:08:41.28,0:08:43.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus, teman-teman!
Dialogue: 0,0:08:43.28,0:08:44.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus.
Dialogue: 0,0:08:44.38,0:08:45.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:08:45.17,0:08:47.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang kita bertiga bisa menang!
Dialogue: 0,0:08:47.80,0:08:49.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah sewajarnya!
Dialogue: 0,0:08:49.34,0:08:50.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maunya bilang begitu,
Dialogue: 0,0:08:50.51,0:08:52.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi ini semua berkat latihan brutal darinya.
Dialogue: 0,0:08:52.85,0:08:54.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar sekali.
Dialogue: 0,0:08:54.22,0:08:55.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Desir memang hebat!
Dialogue: 0,0:08:56.43,0:08:58.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, sore nanti ada kompetisi tim, kan?
Dialogue: 0,0:08:58.98,0:09:01.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bertiga akan ikut serta bersama.
Dialogue: 0,0:09:01.35,0:09:04.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan adanya Romantica dan Azest,\Ntim kita tidak akan terkalahkan!
Dialogue: 0,0:09:05.32,0:09:08.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah itu, kompetisi individu...
Dialogue: 0,0:09:08.61,0:09:10.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya kita akan saling berhadapan dulu.
Dialogue: 0,0:09:10.95,0:09:12.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya begitu.
Dialogue: 0,0:09:12.45,0:09:15.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin melawanmu\Ndengan serius walau hanya sekali.
Dialogue: 0,0:09:15.45,0:09:18.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu pun denganku.
Dialogue: 0,0:09:20.21,0:09:21.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu...
Dialogue: 0,0:09:21.96,0:09:24.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berjuanglah, teman-teman!
Dialogue: 0,0:09:24.84,0:09:26.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku yang akan jadi juara.
Dialogue: 0,0:09:28.51,0:09:30.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pede amat, deh!
Dialogue: 0,0:09:30.01,0:09:33.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin dipuji oleh Desir!
Dialogue: 0,0:09:38.85,0:09:40.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:09:40.48,0:09:41.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Azest...
Dialogue: 0,0:09:42.31,0:09:44.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya bisa merasakan keberadaannya.
Dialogue: 0,0:09:44.81,0:09:46.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa dia masih di dekat sini?
Dialogue: 0,0:09:48.40,0:09:49.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sudah menjauh.
Dialogue: 0,0:09:49.74,0:09:51.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti apa orangnya?
Dialogue: 0,0:09:52.70,0:09:54.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jurang tak berdasar...
Dialogue: 0,0:09:54.78,0:09:58.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaikan jurang tak berdasar,\Nyang membuatmu terus jatuh ke dalamnya...
Dialogue: 0,0:09:59.29,0:10:02.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu... Mana Kegelapan.
Dialogue: 0,0:10:05.13,0:10:06.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Clothesline...
Dialogue: 0,0:10:07.42,0:10:10.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lencana yang diberikan\Nhanya pada Kelas Alfa
Dialogue: 0,0:10:10.92,0:10:13.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}oleh para bangsawan yang menjijikkan.
Dialogue: 0,0:10:14.43,0:10:16.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan hanya Hebrion...
Dialogue: 0,0:10:16.80,0:10:19.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seluruh dunia ini\Nsama sekali tidak berubah.
Dialogue: 0,0:10:20.52,0:10:22.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kedamaian semu.
Dialogue: 0,0:10:23.02,0:10:26.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang-orang tak berdosa\Nyang terkubur dalam bayangan...
Dialogue: 0,0:10:30.03,0:10:33.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takhta yang terbuat dari kebohongan...
Dialogue: 0,0:10:33.74,0:10:35.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lantas, kita hancurkan saja.
Dialogue: 0,0:10:35.91,0:10:38.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi mengembalikan kebenaran.
Dialogue: 0,0:10:43.15,0:10:47.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak akan kubiarkan Kekaisaran Hebrion\Nbertindak sesukanya!
Dialogue: 0,0:10:47.17,0:10:50.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus mengambil langkah\Nsebelum situasinya memburuk!
Dialogue: 0,0:10:50.67,0:10:52.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harap tunggu sebentar.
Dialogue: 0,0:10:52.21,0:10:54.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum tentu mereka yang...
Dialogue: 0,0:10:54.17,0:10:55.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak!
Dialogue: 0,0:10:55.26,0:10:58.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak salah lagi kalau mereka\Nbekerja sama dengan Outer!
Dialogue: 0,0:10:58.76,0:11:00.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setiap tahun selalu begini.
Dialogue: 0,0:11:00.31,0:11:03.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu, tampaknya tidak\Nbenar-benar terjadi perang, ya?
Dialogue: 0,0:11:03.68,0:11:06.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jawabannya simpel.
Dialogue: 0,0:11:06.02,0:11:09.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diskusinya akan berputar pada negeri mana\Nyang akan menginisiasi,
Dialogue: 0,0:11:09.52,0:11:11.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan diskusinya tidak akan maju lagi.
Dialogue: 0,0:11:11.86,0:11:13.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:11:13.24,0:11:16.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan begitu,\Nkedamaian pun tetap bertahan, ya?
Dialogue: 0,0:11:16.82,0:11:21.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tidak akan membuang waktu dan usaha\Nkalau semua bisa ditentukan dengan catur.
Dialogue: 0,0:11:21.88,0:11:25.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu dunia ini akan jadi milikmu,\NMaster Menara.
Dialogue: 0,0:11:25.62,0:11:28.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu akan merepotkan.
Dialogue: 0,0:11:31.96,0:11:34.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perasaan apa... ini?
Dialogue: 0,0:11:34.72,0:11:38.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bulu kudukku berdiri...\NJantungku berdetak kencang...
Dialogue: 0,0:11:44.14,0:11:46.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah sering merasakannya saat itu...
Dialogue: 0,0:11:51.57,0:11:53.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebuah firasat buruk...
Dialogue: 0,0:12:07.41,0:12:08.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master Menara!
Dialogue: 0,0:12:08.29,0:12:09.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku paham.
Dialogue: 0,0:12:09.12,0:12:09.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Merunduk!
Dialogue: 0,0:12:30.77,0:12:32.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian baik-baik saja?
Dialogue: 0,0:12:32.31,0:12:34.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, berkat bantuanmu, Romantica!
Dialogue: 0,0:12:34.11,0:12:35.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih!
Dialogue: 0,0:12:46.45,0:12:48.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan itu?
Dialogue: 0,0:12:48.83,0:12:51.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya terjadi ledakan dari arah kastel.
Dialogue: 0,0:12:51.54,0:12:53.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kastel?\NDesir!
Dialogue: 0,0:12:53.92,0:12:54.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan ke sana!
Dialogue: 0,0:12:54.55,0:12:56.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke-Kenapa?
Dialogue: 0,0:13:00.55,0:13:01.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan!
Dialogue: 0,0:13:25.74,0:13:27.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Uh... apa yang terjadi?
Dialogue: 0,0:13:27.75,0:13:30.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa Master Menara yang melindungi kita?
Dialogue: 0,0:13:30.33,0:13:32.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Mulia Santa, Anda baik-baik saja?
Dialogue: 0,0:13:32.37,0:13:34.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, aku baik-baik saja.
Dialogue: 0,0:13:39.76,0:13:41.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zod, yang tadi itu?
Dialogue: 0,0:13:41.47,0:13:44.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Tingkat Tinggi, Gerhana.
Dialogue: 0,0:13:44.47,0:13:46.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harusnya itu yang tadi menyerang kita.
Dialogue: 0,0:13:47.68,0:13:49.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa yang melakukannya?
Dialogue: 0,0:13:50.64,0:13:51.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Desir.
Dialogue: 0,0:13:51.73,0:13:53.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini, prioritas kita adalah mengevakuasi.
Dialogue: 0,0:13:54.23,0:13:56.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau salah satu dari mereka terbunuh,
Dialogue: 0,0:13:56.73,0:13:59.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}keseimbangan dunia tidak bisa dipertahankan.
Dialogue: 0,0:13:59.74,0:14:00.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:14:01.45,0:14:02.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya, lewat sini.
Dialogue: 0,0:14:03.31,0:14:05.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menjamin keselamatan kalian.
Dialogue: 0,0:14:08.45,0:14:10.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang dilakukan para penjaga?
Dialogue: 0,0:14:10.41,0:14:13.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan...\Nmereka semua sudah mati?
Dialogue: 0,0:14:13.21,0:14:15.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya begitu.
Dialogue: 0,0:14:17.00,0:14:17.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu.
Dialogue: 0,0:14:19.84,0:14:21.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunjukkan dirimu.
Dialogue: 0,0:14:25.34,0:14:27.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master Menara memang beda.
Dialogue: 0,0:14:36.61,0:14:39.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Topeng gagak?
Dialogue: 0,0:14:39.73,0:14:41.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian masih hidup rupanya?
Dialogue: 0,0:14:41.86,0:14:42.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memuakkan.
Dialogue: 0,0:14:42.82,0:14:44.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Apa kamu bilang?\N- Jaga cara bicaramu!
Dialogue: 0,0:14:47.24,0:14:48.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harap tenang.
Dialogue: 0,0:14:48.83,0:14:52.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Desir, langsung saja kita selesaikan\Nagar bisa bermain catur.
Dialogue: 0,0:14:52.41,0:14:53.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh juga.
Dialogue: 0,0:14:54.33,0:14:55.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah kalau begitu.
Dialogue: 0,0:14:58.88,0:15:01.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak tahu kamu siapa,
Dialogue: 0,0:15:01.96,0:15:03.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku saat ini sedang sibuk.
Dialogue: 0,0:15:04.87,0:15:06.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf saja,
Dialogue: 0,0:15:07.26,0:15:09.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku tidak akan menahan diri.
Dialogue: 0,0:15:10.18,0:15:13.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan anggap aku remeh, Zod Exarion!
Dialogue: 0,0:15:24.03,0:15:25.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu khawatir.
Dialogue: 0,0:15:25.61,0:15:29.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada Penyihir\Nyang mampu menandingi Zod.
Dialogue: 0,0:15:30.03,0:15:31.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:15:31.12,0:15:34.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak salah namanya\Nadalah Kraiken, ya?
Dialogue: 0,0:15:34.37,0:15:36.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya kamu lebih ahli daripada dia.
Dialogue: 0,0:15:36.33,0:15:39.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kamu bisa tahu nama itu?
Dialogue: 0,0:15:39.25,0:15:41.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pasti lebih pilih mati\Ndaripada membuka mulutnya.
Dialogue: 0,0:15:41.75,0:15:43.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mudah saja.
Dialogue: 0,0:15:43.80,0:15:46.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya membuatnya merasakan\Nyang lebih buruk dari kematian.
Dialogue: 0,0:15:46.43,0:15:48.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berengsek!
Dialogue: 0,0:15:58.72,0:16:00.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini tidak bagus...
Dialogue: 0,0:16:03.88,0:16:05.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita pindah tempat.
Dialogue: 0,0:16:07.95,0:16:09.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master Menara!
Dialogue: 0,0:16:15.45,0:16:18.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Niatku membuat kita pergi lebih jauh lagi...
Dialogue: 0,0:16:18.75,0:16:21.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata kamu bisa menggunakan\NSihir Spasial, ya?
Dialogue: 0,0:16:28.34,0:16:29.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita menjauh selagi bisa!
Dialogue: 0,0:16:29.93,0:16:31.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:16:31.30,0:16:33.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya kita ikuti sarannya.
Dialogue: 0,0:16:33.46,0:16:37.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master Menara tidak bisa\Nbertarung sesuka hati kalau kita di sini.
Dialogue: 0,0:16:37.14,0:16:39.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah... Baiklah.
Dialogue: 0,0:16:48.03,0:16:50.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan ganggu aku, Master Menara!
Dialogue: 0,0:16:50.95,0:16:52.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaliknya.
Dialogue: 0,0:16:52.03,0:16:53.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamulah yang menggangguku.
Dialogue: 0,0:16:53.78,0:16:58.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mengganggu kedamaian dunia\Ndan melukai orang-orang tak berdosa.
Dialogue: 0,0:17:00.75,0:17:05.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bicara seolah dunia\Nhanya berpusat pada kalian.
Dialogue: 0,0:17:05.71,0:17:07.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betapa arogan!
Dialogue: 0,0:17:07.71,0:17:12.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kedamaian dan kesejahteraan\Nadalah hasil dari kekuatan kita sendiri.
Dialogue: 0,0:17:12.05,0:17:14.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bukan kearoganan, tapi kebanggaan.
Dialogue: 0,0:17:14.72,0:17:16.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bertingkah sok!
Dialogue: 0,0:17:16.64,0:17:18.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pancaran Spektrum!
Dialogue: 0,0:17:19.98,0:17:21.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Raungan Magma.
Dialogue: 0,0:17:24.77,0:17:26.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rekuiem Peleleh!
Dialogue: 0,0:17:36.66,0:17:37.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa kamu?
Dialogue: 0,0:17:40.04,0:17:43.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya kamu tertarik padaku?
Dialogue: 0,0:17:43.67,0:17:46.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka sudah kabur, ya?
Dialogue: 0,0:17:46.59,0:17:48.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua ini salahmu.
Dialogue: 0,0:17:49.17,0:17:50.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:17:50.42,0:17:52.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rencana kalian telah berhasil kugagalkan.
Dialogue: 0,0:17:52.63,0:17:55.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua ini... salahmu.
Dialogue: 0,0:17:56.56,0:17:57.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan?
Dialogue: 0,0:17:57.47,0:18:01.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bilang ini adalah "salahmu",\NMaster Menara!
Dialogue: 0,0:18:04.13,0:18:07.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inilah akhir dari Persekutuan Kerajaan Barat!
Dialogue: 0,0:18:12.82,0:18:13.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:18:18.66,0:18:20.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pembalikan?
Dialogue: 0,0:18:31.55,0:18:32.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil!
Dialogue: 0,0:18:33.47,0:18:36.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Tingkat Tinggi, Gerhana.
Dialogue: 0,0:18:36.55,0:18:41.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ditambah Artefak yang bisa memicu sihir\Ndi saat yang kamu inginkan...
Dialogue: 0,0:18:41.56,0:18:42.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yaitu, Memori...
Dialogue: 0,0:18:45.77,0:18:48.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Artefak yang telah hilang\Ndalam insiden revolusi...
Dialogue: 0,0:18:48.90,0:18:51.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa bisa ada padamu?
Dialogue: 0,0:18:51.82,0:18:56.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hal yang perlu kutanyakan padamu...\Nkini bertambah.
Dialogue: 0,0:18:58.41,0:19:00.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar monster!
Dialogue: 0,0:19:00.08,0:19:02.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Monster, ya?
Dialogue: 0,0:19:02.33,0:19:04.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terdengar seperti pujian bagiku.
Dialogue: 0,0:19:05.04,0:19:07.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak lagi menahan diri mulai sekarang.
Dialogue: 0,0:19:09.59,0:19:10.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Raungan Magma!
Dialogue: 0,0:19:11.80,0:19:15.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayang sekali, aku sedang buru-buru.
Dialogue: 0,0:19:22.06,0:19:25.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat bertemu lagi, akan kubunuh kamu.
Dialogue: 0,0:19:29.56,0:19:32.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sangat ahli memakai Sihir Spasial.
Dialogue: 0,0:19:35.11,0:19:37.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untungnya kita selamat.
Dialogue: 0,0:19:37.32,0:19:41.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kamu bisa tahu kalau\Ndia sudah menyiapkan sihir di sana?
Dialogue: 0,0:19:41.74,0:19:45.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kita hanya bisa kabur\Nmelalui gerbang utama.
Dialogue: 0,0:19:45.04,0:19:46.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya?
Dialogue: 0,0:19:46.62,0:19:50.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Musuh kita melancarkan sihir yang sangat besar\Nsampai meliputi seluruh kastel.
Dialogue: 0,0:19:51.06,0:19:55.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka jelas tidak berniat\Nada satu orang pun yang selamat.
Dialogue: 0,0:19:55.67,0:19:59.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, mereka harus\Nbersiap kalau mereka gagal.
Dialogue: 0,0:19:59.93,0:20:05.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pria bertopeng itu menggiring kita kemari\Nagar masuk dalam jebakannya?
Dialogue: 0,0:20:05.68,0:20:06.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu maksudmu?
Dialogue: 0,0:20:06.85,0:20:08.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tepat sekali.
Dialogue: 0,0:20:08.52,0:20:11.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu benar-benar mirip dengan Zod.
Dialogue: 0,0:20:17.15,0:20:18.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah Anda baik-baik saja, Yang Mulia.
Dialogue: 0,0:20:25.70,0:20:30.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini kota kastel tengah diserang individu\Nyang tampaknya adalah Outer.
Dialogue: 0,0:20:30.54,0:20:31.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku paham.
Dialogue: 0,0:20:31.67,0:20:34.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita segera ke gerbang\Ndan kembali ke negeri kita.
Dialogue: 0,0:20:34.84,0:20:35.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:20:35.80,0:20:38.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harap tunggu sebentar, Raja Kolora!
Dialogue: 0,0:20:38.05,0:20:40.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan berbahaya kalau kita berpisah\Ndalam situasi seperti ini!
Dialogue: 0,0:20:40.80,0:20:42.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar!\NMohon tetap bersama kami...
Dialogue: 0,0:20:42.64,0:20:43.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menolak.
Dialogue: 0,0:20:45.06,0:20:47.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempat ini sudah jadi medan perang.
Dialogue: 0,0:20:47.52,0:20:51.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akibat ketidakberdayaan seorang raja\Nyang tak mampu menghalangi serangan teroris!
Dialogue: 0,0:20:51.06,0:20:52.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu...
Dialogue: 0,0:20:52.65,0:20:58.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengajak Prillecha ke dalam Persekutuan\NKerajaan Barat ternyata sebuah kesalahan.
Dialogue: 0,0:20:58.30,0:20:59.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo berangkat, Aaron.
Dialogue: 0,0:20:59.45,0:21:00.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap!
Dialogue: 0,0:21:03.03,0:21:06.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih telah melindungi raja kami.
Dialogue: 0,0:21:06.33,0:21:07.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan masalah...
Dialogue: 0,0:21:12.92,0:21:14.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aaron...
Dialogue: 0,0:21:18.51,0:21:20.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian baik-baik saja, ya?
Dialogue: 0,0:21:20.05,0:21:22.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ampun, tolong jangan tiba-tiba muncul begitu!
Dialogue: 0,0:21:23.26,0:21:25.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master Menara, pria tadi...
Dialogue: 0,0:21:25.47,0:21:27.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia berhasil kabur.
Dialogue: 0,0:21:27.06,0:21:28.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia cukup kuat.
Dialogue: 0,0:21:28.93,0:21:30.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin...
Dialogue: 0,0:21:31.06,0:21:34.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya ada korban juga di kota.
Dialogue: 0,0:21:34.23,0:21:35.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya...
Dialogue: 0,0:21:35.94,0:21:37.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan sisanya padaku.
Dialogue: 0,0:21:37.65,0:21:39.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kembali saja ke timmu.
Dialogue: 0,0:21:39.65,0:21:41.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:21:41.07,0:21:43.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mengkhawatirkan mereka, kan?
Dialogue: 0,0:21:44.87,0:21:45.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:21:47.54,0:21:50.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, semoga Anda berhasil!
Dialogue: 0,0:21:55.00,0:21:58.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuharap kalian semua baik-baik saja!
Dialogue: 0,0:23:41.44,0:23:43.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya: Eror.
