Dialogue: 0,0:00:58.08,0:01:02.50,sign,,0000,0000,0000,,SIHIR SANG PENGULANG JELAS ISTIMEWA\N- MUSIM KEDUA
Dialogue: 0,0:02:16.49,0:02:20.08,sign,,0000,0000,0000,,EPISODE 20: KATA-KATA KEHANCURAN
Dialogue: 0,0:23:14.66,0:23:15.99,sign,,0000,0000,0000,,- A...
Dialogue: 0,0:23:40.61,0:23:45.03,sign,,0000,0000,0000,,EPISODE 21: HARAPAN BARU
Dialogue: 0,0:00:16.98,0:00:20.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:00:21.58,0:00:24.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belum pernah\Nmelihat sihir seperti itu!
Dialogue: 0,0:00:25.51,0:00:27.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini pun kali pertamaku melihatnya!
Dialogue: 0,0:00:27.55,0:00:29.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu juga?
Dialogue: 0,0:00:29.91,0:00:33.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang pasti, itu bukan teknik sihir\Ndari zaman ini.
Dialogue: 0,0:00:34.11,0:00:37.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena aku tidak mengetahuinya.
Dialogue: 0,0:02:23.71,0:02:24.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zod!
Dialogue: 0,0:02:27.29,0:02:28.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa dia
Dialogue: 0,0:02:29.00,0:02:30.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}membalikkan sihirnya?
Dialogue: 0,0:02:30.13,0:02:31.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan.
Dialogue: 0,0:02:31.55,0:02:33.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia meniadakannya
Dialogue: 0,0:02:34.16,0:02:36.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan mana yang jauh lebih kuat.
Dialogue: 0,0:02:36.97,0:02:41.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Desir, apa yang ingin kamu lakukan?
Dialogue: 0,0:02:43.72,0:02:44.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya...
Dialogue: 0,0:02:49.32,0:02:50.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak ingin mati...
Dialogue: 0,0:02:50.78,0:02:52.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di tempat seperti ini...
Dialogue: 0,0:02:52.89,0:02:55.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Sakit!\N- Semua itu salahku...
Dialogue: 0,0:02:55.32,0:02:56.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya aku tidak kemari...
Dialogue: 0,0:02:57.97,0:03:02.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Semuanya...\N- Setidaknya... satu tebasan lagi...
Dialogue: 0,0:03:06.17,0:03:07.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini semua...
Dialogue: 0,0:03:07.91,0:03:09.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena diriku yang lemah...
Dialogue: 0,0:03:11.96,0:03:14.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Andai saja aku lebih kuat...
Dialogue: 0,0:03:16.08,0:03:17.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih belum!
Dialogue: 0,0:03:26.95,0:03:27.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Priscilla!
Dialogue: 0,0:03:28.27,0:03:29.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:03:37.26,0:03:38.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus!
Dialogue: 0,0:03:42.59,0:03:43.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih dari ini!
Dialogue: 0,0:03:52.86,0:03:55.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemulihanku tidak bisa mengimbanginya!
Dialogue: 0,0:03:55.05,0:03:57.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zod, apa yang dia lakukan?
Dialogue: 0,0:03:57.26,0:04:00.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia memakai kekuatan\Nyang melampaui batas manusia.
Dialogue: 0,0:04:00.26,0:04:01.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teruskan pemulihanmu, Priscilla.
Dialogue: 0,0:04:02.10,0:04:05.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya kamu yang bisa menyelamatkan Desir.
Dialogue: 0,0:04:06.81,0:04:07.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:04:27.11,0:04:28.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Indahnya...
Dialogue: 0,0:04:36.21,0:04:37.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teriakan yang menjijikkan.
Dialogue: 0,0:04:38.57,0:04:40.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya jangan mengganggu.
Dialogue: 0,0:04:40.99,0:04:42.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ledakan Elemental!
Dialogue: 0,0:05:09.77,0:05:11.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beri aku
Dialogue: 0,0:05:11.83,0:05:13.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kekuatan lagi...
Dialogue: 0,0:05:13.68,0:05:15.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak...
Dialogue: 0,0:05:31.71,0:05:33.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Angkat wajahmu.
Dialogue: 0,0:05:41.07,0:05:43.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bisa bertarung berkatmu.
Dialogue: 0,0:05:44.06,0:05:46.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kamu mampu\Nmembalikkan segala macam sihir.
Dialogue: 0,0:05:47.44,0:05:49.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu memang Anti-Penyihir terkuat.
Dialogue: 0,0:05:49.90,0:05:51.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Julukan yang bagus!
Dialogue: 0,0:05:52.04,0:05:53.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anti-Penyihir!
Dialogue: 0,0:05:54.32,0:05:55.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya...
Dialogue: 0,0:06:02.17,0:06:03.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Desir...
Dialogue: 0,0:06:04.36,0:06:05.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami percaya padamu.
Dialogue: 0,0:06:09.64,0:06:10.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya...
Dialogue: 0,0:06:11.71,0:06:13.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu.
Dialogue: 0,0:06:18.19,0:06:20.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak akan kubiarkan itu terulang...
Dialogue: 0,0:06:21.55,0:06:23.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kali ini, aku pasti...
Dialogue: 0,0:06:24.85,0:06:26.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan...
Dialogue: 0,0:06:26.89,0:06:30.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menyelamatkan semuanya!
Dialogue: 0,0:06:50.08,0:06:52.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, perlihatkan padaku...
Dialogue: 0,0:06:54.92,0:06:56.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mantra Naga:
Dialogue: 0,0:06:56.94,0:07:00.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perwujudan Geomagnetik Surya!
Dialogue: 0,0:07:23.49,0:07:24.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini...
Dialogue: 0,0:07:29.40,0:07:30.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Desir...
Dialogue: 0,0:07:31.33,0:07:32.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Romantica?
Dialogue: 0,0:07:32.69,0:07:33.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:07:35.02,0:07:36.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah kenapa...
Dialogue: 0,0:07:36.79,0:07:38.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku seperti mendengar suara Desir.
Dialogue: 0,0:07:39.63,0:07:42.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia... seperti menangis.
Dialogue: 0,0:09:46.65,0:09:48.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah apa yang kamu lakukan...
Dialogue: 0,0:09:49.05,0:09:51.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal kamu yang menyuruhku kabur...
Dialogue: 0,0:09:52.43,0:09:56.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin kamu sudah tahu semua ini.
Dialogue: 0,0:09:57.16,0:09:59.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik tentang kedatangan para Outer,
Dialogue: 0,0:09:59.48,0:10:01.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}maupun tentang iblis itu.
Dialogue: 0,0:10:02.27,0:10:06.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sudah tahu,\Nhalau mereka dengan lebih baik lagi.
Dialogue: 0,0:10:06.67,0:10:09.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sampai terluka seperti ini...
Dialogue: 0,0:10:09.63,0:10:11.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak seperti biasanya.
Dialogue: 0,0:10:17.96,0:10:22.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perlihatkan senyummu yang mengesalkan itu\Npadaku seperti biasa.
Dialogue: 0,0:10:23.04,0:10:25.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu boleh tersenyum seperti itu hari ini...
Dialogue: 0,0:10:29.32,0:10:32.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bangunlah, Desir...
Dialogue: 0,0:10:39.56,0:10:41.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Desir...
Dialogue: 0,0:10:42.31,0:10:43.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Desir!
Dialogue: 0,0:10:57.76,0:11:06.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Tiap kali kusentuh lembut telapakmu ♪
Dialogue: 0,0:11:06.89,0:11:09.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat pagi, Romantica.
Dialogue: 0,0:11:10.09,0:11:13.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Semilir lembut menyapu hatiku ♪
Dialogue: 0,0:11:13.49,0:11:14.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Desir!
Dialogue: 0,0:11:14.74,0:11:17.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, duh, duh!\NSakit! Sakit!
Dialogue: 0,0:11:17.95,0:11:20.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berisik! Ini hukumanmu\Nkarena membuatku khawatir!
Dialogue: 0,0:11:20.45,0:11:23.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf!\NAku minta maaf!
Dialogue: 0,0:11:24.61,0:11:26.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan lakukan lagi, ya?
Dialogue: 0,0:11:29.04,0:11:32.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Jangan malah diam! Jawab!\N- Aduh! Iya, tidak lagi!
Dialogue: 0,0:11:32.32,0:11:35.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan melakukan hal\Nyang membuatmu khawatir!
Dialogue: 0,0:11:35.51,0:11:36.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku janji!\NAduh, duh, duh!
Dialogue: 0,0:11:36.93,0:11:39.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Akhirnya kamu paham!\N- Ah!
Dialogue: 0,0:11:39.01,0:11:43.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Desir!
Dialogue: 0,0:11:44.50,0:11:48.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Aduh! Hentikan!\N- Desir! Desir!
Dialogue: 0,0:11:48.40,0:11:50.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah dia sudah bangun, Romantica.
Dialogue: 0,0:11:51.44,0:11:52.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya...
Dialogue: 0,0:11:52.86,0:11:56.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah! Bukan berarti\Naku mengkhawatirkannya, ya!
Dialogue: 0,0:11:56.86,0:11:58.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya?
Dialogue: 0,0:11:58.41,0:11:58.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:11:58.99,0:12:02.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu dengar tidak?\NAduh, sakit!
Dialogue: 0,0:12:02.87,0:12:05.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pram! Aku kesakitan!
Dialogue: 0,0:12:05.62,0:12:07.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Azest, tolong aku!
Dialogue: 0,0:12:07.79,0:12:09.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anggap saja itu obat.
Dialogue: 0,0:12:09.21,0:12:11.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu marah, ya?
Dialogue: 0,0:12:11.38,0:12:11.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:12:11.96,0:12:13.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Desir!
Dialogue: 0,0:12:14.84,0:12:17.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kepribadianmu juga sama saja!
Dialogue: 0,0:12:18.03,0:12:19.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini namanya kerja sama tim.
Dialogue: 0,0:12:20.40,0:12:22.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah tidak kuat.
Dialogue: 0,0:12:24.73,0:12:25.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Desir?
Dialogue: 0,0:12:26.92,0:12:28.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa kita bicara sebentar?
Dialogue: 0,0:12:32.52,0:12:34.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana keadaanmu?
Dialogue: 0,0:12:34.16,0:12:36.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seluruh tubuhku rasanya sakit.
Dialogue: 0,0:12:36.80,0:12:38.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya itu kurang tepat.
Dialogue: 0,0:12:39.35,0:12:42.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak bisa merasakan apa pun\Ndi bagian ini, kan?
Dialogue: 0,0:12:42.47,0:12:43.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:12:44.09,0:12:46.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada luka fisik.
Dialogue: 0,0:12:46.56,0:12:48.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena Priscilla memulihkanmu\Ndengan kekuatannya.
Dialogue: 0,0:12:49.45,0:12:52.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, matamu kehilangan fungsinya.
Dialogue: 0,0:12:52.71,0:12:54.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyebabnya tidak diketahui.
Dialogue: 0,0:12:57.29,0:13:00.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini harga yang harus kubayar setelah\Nmenginjakkan kaki di level para naga?
Dialogue: 0,0:13:01.33,0:13:02.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:13:02.72,0:13:04.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Desir Herrman,
Dialogue: 0,0:13:04.91,0:13:06.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}siapa kamu sebenarnya?
Dialogue: 0,0:13:08.39,0:13:10.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menanyakan ini sebagai Master Menara.
Dialogue: 0,0:13:11.38,0:13:14.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu sosok yang ingin mengacaukan\Nkedamaian dunia ini,
Dialogue: 0,0:13:15.55,0:13:18.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan menghabisimu saat ini juga.
Dialogue: 0,0:13:19.90,0:13:23.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pernah memprediksi serangan Outer\Nke Menara Penyihir,
Dialogue: 0,0:13:23.41,0:13:24.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan berhasil menghalaunya.
Dialogue: 0,0:13:25.21,0:13:29.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak saat itu, aku mencurigaimu\Nsebagai mata-mata Outer.
Dialogue: 0,0:13:30.61,0:13:33.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kira kamu menyerahkan rekanmu\Nuntuk mendapat kepercayaanku.
Dialogue: 0,0:13:33.55,0:13:36.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah sewajarnya\Naku berspekulasi seperti itu.
Dialogue: 0,0:13:37.00,0:13:40.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, tindakanmu setelahnya\Nmembuatku heran.
Dialogue: 0,0:13:40.96,0:13:44.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemrosesan Bijih Sihir,\Nteknik sihir yang baru.
Dialogue: 0,0:13:45.49,0:13:46.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu...
Dialogue: 0,0:13:48.19,0:13:52.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu selalu menunjukkan\Nhal yang menarik perhatianku.
Dialogue: 0,0:13:52.48,0:13:55.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seolah kamu sudah tahu sejak awal.
Dialogue: 0,0:13:56.11,0:13:57.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal itu...
Dialogue: 0,0:13:58.18,0:14:00.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak bisa menjawabnya, ya?
Dialogue: 0,0:14:00.04,0:14:03.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, akan kutanyakan\Nlangsung pada otakmu.
Dialogue: 0,0:14:04.87,0:14:08.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan tubuh terluka itu,\Nkurasa kamu tidak bisa membalikkan ini.
Dialogue: 0,0:14:10.98,0:14:12.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang harus kulakukan?
Dialogue: 0,0:14:12.46,0:14:14.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku harus memberi tahu semuanya?
Dialogue: 0,0:14:14.96,0:14:15.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak!
Dialogue: 0,0:14:15.67,0:14:18.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada jaminan Zod akan memercayaiku...
Dialogue: 0,0:14:19.41,0:14:20.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kuberi tahu sekarang,
Dialogue: 0,0:14:20.92,0:14:22.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}masa depan mungkin akan berubah lagi...
Dialogue: 0,0:14:23.41,0:14:25.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kukatakan lebih jauh,\Nakan berbahaya.
Dialogue: 0,0:14:25.55,0:14:27.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu sudah siap?
Dialogue: 0,0:14:30.97,0:14:35.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kukatakan semuanya sejak awal,\Napa aku tak akan dicurigai seperti ini?
Dialogue: 0,0:14:36.94,0:14:38.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal kita sudah bertemu lagi!
Dialogue: 0,0:14:39.68,0:14:42.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal dia rekan yang sangat kupercaya!
Dialogue: 0,0:14:45.27,0:14:47.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Zod...
Dialogue: 0,0:14:50.24,0:14:52.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu memanggilku seolah kita teman lama.
Dialogue: 0,0:14:54.39,0:14:56.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku minta maaf!
Dialogue: 0,0:14:57.36,0:14:59.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin gertakanku agak berlebihan.
Dialogue: 0,0:15:00.93,0:15:05.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu menghalau iblis itu\Ndan menghentikan rencana Outer.
Dialogue: 0,0:15:05.71,0:15:07.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan mengorbankan dirimu sendiri.
Dialogue: 0,0:15:08.83,0:15:11.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada mata-mata sebodoh itu.
Dialogue: 0,0:15:14.67,0:15:16.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya mencurigaimu di awal.
Dialogue: 0,0:15:17.38,0:15:22.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena intuisiku mengatakan\Ndugaanku itu salah.
Dialogue: 0,0:15:22.51,0:15:24.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:15:29.53,0:15:32.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena bermain catur denganmu\Nterasa menyenangkan.
Dialogue: 0,0:15:33.15,0:15:35.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu masih ingat janji kita, kan?
Dialogue: 0,0:15:36.48,0:15:37.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:15:37.52,0:15:39.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Izinkan aku menjadi lawanmu!
Dialogue: 0,0:15:44.45,0:15:46.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suatu saat aku pasti\Nakan mengatakan semuanya...
Dialogue: 0,0:15:47.16,0:15:49.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berjanji, Zod...
Dialogue: 0,0:16:03.47,0:16:05.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia benar-benar pria yang aneh.
Dialogue: 0,0:16:05.99,0:16:08.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku merasa tidak keberatan\Nmengikuti kata-katanya.
Dialogue: 0,0:16:09.39,0:16:11.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kata-katanya terasa nyaman...
Dialogue: 0,0:16:13.77,0:16:16.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harap bisa bertemu dengannya lagi.
Dialogue: 0,0:16:25.96,0:16:28.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya pertukarannya berjalan lancar.
Dialogue: 0,0:16:28.55,0:16:32.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu ada di hadapan raja.\NJaga tata kramamu.
Dialogue: 0,0:16:32.54,0:16:34.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi bohong.
Dialogue: 0,0:16:40.46,0:16:42.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar konyol.
Dialogue: 0,0:16:42.52,0:16:46.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini jadinya karena dia berpisah dengan\Nkesatria terkuat di kerajaan.
Dialogue: 0,0:16:46.91,0:16:49.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita berhasil merebut negara ini.
Dialogue: 0,0:16:51.87,0:16:54.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, apa benar Dadeinuf dikalahkan?
Dialogue: 0,0:16:54.91,0:16:55.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya...
Dialogue: 0,0:16:55.77,0:16:57.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, boleh juga si Zod itu.
Dialogue: 0,0:16:57.96,0:17:00.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salah, bukan Master Menara\Nyang mengalahkannya.
Dialogue: 0,0:17:00.17,0:17:00.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:17:01.19,0:17:04.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang paling berbahaya saat ini...
Dialogue: 0,0:17:05.65,0:17:07.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah Desir Herrman.
Dialogue: 0,0:17:28.28,0:17:31.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar rakyat jelata!
Dialogue: 0,0:17:38.00,0:17:40.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hati-hati saat melangkah, Desir.
Dialogue: 0,0:17:40.98,0:17:42.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau terasa sakit, langsung bilang, ya.
Dialogue: 0,0:17:42.92,0:17:45.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aman saja, Pram.
Dialogue: 0,0:17:45.04,0:17:49.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi hati-hati, dia suka berbohong\Ndi saat-saat penting!
Dialogue: 0,0:17:50.19,0:17:53.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi kamu sebenarnya kesakitan?
Dialogue: 0,0:17:53.68,0:17:55.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biarkan aku membantumu!
Dialogue: 0,0:17:55.68,0:17:57.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, sakit!
Dialogue: 0,0:17:57.68,0:18:01.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Romantica, jangan bicara\Naneh-aneh pada Pram!
Dialogue: 0,0:18:10.60,0:18:14.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Pahlawan memang keren!\NKamu jadi populer di kalangan perempuan!
Dialogue: 0,0:18:14.70,0:18:16.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhenti menjailiku.
Dialogue: 0,0:18:17.48,0:18:19.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan ancam mereka begitu!
Dialogue: 0,0:18:23.12,0:18:25.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu jadi pusat perhatian, ya?
Dialogue: 0,0:18:25.04,0:18:28.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini jadi kesempatan bagus\Nuntuk memperkenalkan tim kita.
Dialogue: 0,0:18:28.17,0:18:32.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak akan ada yang mau bergabung\Nsetelah tahu latihan gilamu itu.
Dialogue: 0,0:18:32.57,0:18:33.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:18:33.30,0:18:36.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak keberatan\Nselama bisa bersama Desir!
Dialogue: 0,0:18:37.47,0:18:40.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Selama bisa bersama Desir," ya?
Dialogue: 0,0:18:40.85,0:18:43.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kami hanya mengganggu?
Dialogue: 0,0:18:49.07,0:18:50.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Desir.
Dialogue: 0,0:18:51.49,0:18:52.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Profesor Brigitte?
Dialogue: 0,0:18:53.15,0:18:55.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa minta waktunya sebentar?
Dialogue: 0,0:18:58.43,0:19:00.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu benar-benar membuatku terkejut.
Dialogue: 0,0:19:00.71,0:19:03.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua artikel ramai membicarakanmu.
Dialogue: 0,0:19:06.86,0:19:10.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu masih ingat\Nsaat kita pertama bertemu?
Dialogue: 0,0:19:11.24,0:19:11.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:19:13.27,0:19:17.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mendatangiku sambil membawa buku\Ndan memintaku mengajarimu sihir.
Dialogue: 0,0:19:18.87,0:19:20.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benar-benar terkejut.
Dialogue: 0,0:19:20.26,0:19:22.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan kelancanganku saat itu.
Dialogue: 0,0:19:22.72,0:19:23.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.
Dialogue: 0,0:19:23.93,0:19:27.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bakat sihirmu memang lebih rendah\Ndari kebanyakan orang.
Dialogue: 0,0:19:28.53,0:19:31.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, tekadmu jauh lebih kuat\Ndari siapa pun.
Dialogue: 0,0:19:31.13,0:19:34.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tekad dalam mempelajari sihir.
Dialogue: 0,0:19:34.55,0:19:37.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bangga padamu, Desir.
Dialogue: 0,0:19:37.20,0:19:38.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:19:38.74,0:19:39.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:19:40.56,0:19:43.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu harus lebih menyayangi dirimu sendiri.
Dialogue: 0,0:19:45.71,0:19:50.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak ingin kamu mengorbankan\Ndirimu untuk orang lain.
Dialogue: 0,0:19:51.40,0:19:55.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini permintaanku sebagai guru pertamamu.
Dialogue: 0,0:20:03.58,0:20:08.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka menyuruh para peringkat tunggal\Nberkumpul untuk latihan hari ini...
Dialogue: 0,0:20:08.15,0:20:10.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Merepotkan saja.
Dialogue: 0,0:20:10.86,0:20:15.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya para rakyat jelata itu\Nsuka berisik seolah sedang ada festival.
Dialogue: 0,0:20:15.11,0:20:18.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya dia mengalahkan iblis?\NTapi aku tidak yakin.
Dialogue: 0,0:20:18.22,0:20:20.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paling juga dia dibantu Master Menara
Dialogue: 0,0:20:20.07,0:20:22.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan menganggap itu pencapaiannya sendiri.
Dialogue: 0,0:20:23.21,0:20:24.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka benar-benar menjijikkan.
Dialogue: 0,0:20:24.99,0:20:28.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka hanya tidak ingin mengakui Desir.
Dialogue: 0,0:20:30.17,0:20:32.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Desir Herrman!
Dialogue: 0,0:20:44.72,0:20:47.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bilang kamu melupakanku!
Dialogue: 0,0:20:47.77,0:20:50.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya bercanda, Senior Ladoria.
Dialogue: 0,0:20:50.36,0:20:52.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah banyak membantuku\Nsaat ujian masuk.
Dialogue: 0,0:20:52.69,0:20:54.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kepribadianmu itu jelek, tahu!
Dialogue: 0,0:20:55.60,0:20:56.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya sudahlah.
Dialogue: 0,0:20:57.54,0:20:59.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian Tim Desir yang sedang\Nramai dibicarakan, ya?
Dialogue: 0,0:20:59.80,0:21:02.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar kalian banyak berkontribusi\Ndi Kerajaan Prillecha.
Dialogue: 0,0:21:03.03,0:21:04.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya akan seru, ya.
Dialogue: 0,0:21:05.94,0:21:07.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudmu?
Dialogue: 0,0:21:07.29,0:21:09.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang dia maksud adalah\Npertandingan antartim.
Dialogue: 0,0:21:09.97,0:21:10.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senior Elheim?
Dialogue: 0,0:21:10.96,0:21:14.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu langsung\Nmemanggilnya begitu?
Dialogue: 0,0:21:14.25,0:21:16.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu pertandingan antartim?
Dialogue: 0,0:21:16.78,0:21:19.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ingat Pertandingan Peringkat waktu itu, kan?
Dialogue: 0,0:21:19.01,0:21:22.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudmu pertandingan di dunia bayangan\Nyang disiapkan oleh akademi, kan?
Dialogue: 0,0:21:22.37,0:21:23.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:21:23.22,0:21:25.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada dasarnya, keduanya mirip.
Dialogue: 0,0:21:25.32,0:21:26.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya saja...
Dialogue: 0,0:21:26.10,0:21:28.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertandingannya diadakan\Nuntuk seluruh tahun ajaran.
Dialogue: 0,0:21:28.90,0:21:33.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini kesempatan bagus untuk melihat\Napakah kemampuan itu sungguhan.
Dialogue: 0,0:21:33.03,0:21:34.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wahai Pahlawan Kerajaan Prillecha.
Dialogue: 0,0:21:35.52,0:21:37.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuharap kita bisa bertanding dengan santai.
Dialogue: 0,0:21:37.63,0:21:39.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya kalian sudah berkumpul.
Dialogue: 0,0:21:40.53,0:21:43.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akan mengadakan latihan\Npara peringkat tunggal
Dialogue: 0,0:21:43.28,0:21:46.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dari seluruh tahun ajaran.
Dialogue: 0,0:21:47.34,0:21:49.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Instruktur Erssenblanc.
Dialogue: 0,0:21:49.96,0:21:51.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajahnya menyeramkan!
Dialogue: 0,0:21:51.46,0:21:54.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, dia itu kuat.
Dialogue: 0,0:21:54.32,0:21:57.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mantan Komandan Kesatria\NKerajaan Hebrion.
Dialogue: 0,0:21:58.92,0:22:01.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Latihan ini bertujuan\Nagar para peringkat tunggal
Dialogue: 0,0:22:01.63,0:22:03.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bertanding layaknya pertarungan sungguhan
Dialogue: 0,0:22:03.70,0:22:07.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}demi lebih mengasah kemampuan mereka.
Dialogue: 0,0:22:07.75,0:22:09.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namamu Desir Herrman, benar?
Dialogue: 0,0:22:10.38,0:22:11.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:22:12.17,0:22:15.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar kamu mengalahkan iblis kuno\Nbersama Master Menara.
Dialogue: 0,0:22:15.90,0:22:17.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu benar?
Dialogue: 0,0:22:17.02,0:22:17.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:22:17.94,0:22:21.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dengar kamu menghalau\Nserangan Outer ke Menara Penyihir,
Dialogue: 0,0:22:21.36,0:22:22.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa itu juga benar?
Dialogue: 0,0:22:22.95,0:22:24.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:22:24.91,0:22:26.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengalaman bertarungmu cukup banyak.
Dialogue: 0,0:22:28.02,0:22:32.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sini ada orang yang lebih sering selamat\Ndari medan perang dari kalian semua!
Dialogue: 0,0:22:33.42,0:22:36.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ada yang ingin bertarung\Nmelawan Desir?
Dialogue: 0,0:22:40.51,0:22:41.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:22:41.92,0:22:44.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa tidak ada yang berani maju?
Dialogue: 0,0:22:50.39,0:22:52.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan melawannya.
Dialogue: 0,0:22:56.38,0:22:57.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa?
Dialogue: 0,0:22:57.95,0:23:00.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia Kelt Pasil Nifleka, siswa tahun kedua.
Dialogue: 0,0:23:00.69,0:23:02.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nifleka?
Dialogue: 0,0:23:02.13,0:23:04.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya aku pernah mendengar nama itu...
Dialogue: 0,0:23:04.32,0:23:06.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia adik Profesor Fergman.
Dialogue: 0,0:23:06.68,0:23:07.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:23:08.27,0:23:09.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia adiknya.
