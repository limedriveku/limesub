Dialogue: 0,0:02:41.05,0:02:45.47,sign,,0000,0000,0000,,SIHIR SANG PENGULANG JELAS ISTIMEWA - MUSIM KEDUA
Dialogue: 0,0:03:59.76,0:04:03.84,sign,,0000,0000,0000,,EPISODE 18: PENYIHIR AGUNG
Dialogue: 0,0:23:40.57,0:23:45.02,sign,,0000,0000,0000,,EPISODE 19: KEBANGKITAN
Dialogue: 0,0:00:16.10,0:00:17.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Desir?
Dialogue: 0,0:00:17.71,0:00:19.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia ke mana?
Dialogue: 0,0:00:25.28,0:00:26.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Desir!
Dialogue: 0,0:00:28.62,0:00:30.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa termenung begitu?
Dialogue: 0,0:00:31.28,0:00:32.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah...
Dialogue: 0,0:00:34.96,0:00:36.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku terpukau...
Dialogue: 0,0:00:55.64,0:00:58.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang banyak yang terjadi,
Dialogue: 0,0:00:58.87,0:01:00.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku bersyukur bisa\Nmelindungi tempat ini.
Dialogue: 0,0:01:02.27,0:01:04.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, kamu benar.
Dialogue: 0,0:01:07.15,0:01:08.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:01:08.58,0:01:12.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ekspresimu itu biasanya membuatku kesal...
Dialogue: 0,0:01:14.42,0:01:16.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, entah kenapa\Nsekarang membuatku tenang.
Dialogue: 0,0:01:18.68,0:01:19.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aneh sekali.
Dialogue: 0,0:01:21.79,0:01:23.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya?
Dialogue: 0,0:01:24.06,0:01:26.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau yang ini jelas membuatku kesal!
Dialogue: 0,0:01:26.52,0:01:28.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Desir!
Dialogue: 0,0:01:29.82,0:01:31.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serangan tumpukan roti?
Dialogue: 0,0:01:32.17,0:01:34.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini pemberian dari warga kota!
Dialogue: 0,0:01:34.03,0:01:36.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka berterima kasih atas bantuan kita.
Dialogue: 0,0:01:36.15,0:01:37.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa tidak kebanyakan?
Dialogue: 0,0:01:37.77,0:01:39.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami tidak tega menolaknya...
Dialogue: 0,0:01:39.55,0:01:42.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah kalian semua baik-baik saja.
Dialogue: 0,0:04:24.49,0:04:26.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa itu?
Dialogue: 0,0:04:27.11,0:04:28.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entahlah...
Dialogue: 0,0:04:28.65,0:04:30.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi... dia mengerikan.
Dialogue: 0,0:04:32.49,0:04:33.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Desir?
Dialogue: 0,0:04:41.61,0:04:42.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil...
Dialogue: 0,0:04:47.96,0:04:49.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana mungkin dia...
Dialogue: 0,0:04:54.07,0:04:56.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harusnya aku menghadapinya di Dunia Bayangan...
Dialogue: 0,0:04:58.48,0:05:00.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana bisa dia ke dunia ini?
Dialogue: 0,0:05:02.69,0:05:03.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Romantica...
Dialogue: 0,0:05:04.27,0:05:05.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, Aaron...
Dialogue: 0,0:05:06.97,0:05:09.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat itu mereka berdua\Nada di tempat yang sama...
Dialogue: 0,0:05:09.26,0:05:10.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu dia pun muncul!
Dialogue: 0,0:05:11.47,0:05:12.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini...
Dialogue: 0,0:05:14.91,0:05:16.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu tahu sesuatu, Desir?
Dialogue: 0,0:05:17.72,0:05:19.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master Menara?
Dialogue: 0,0:05:19.02,0:05:20.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan Yang Mulia Santa?
Dialogue: 0,0:05:21.84,0:05:23.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tahu sesuatu, ya?
Dialogue: 0,0:05:27.50,0:05:28.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:05:29.84,0:05:32.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia adalah Iblis Malapetaka, Dadeinuf.
Dialogue: 0,0:05:33.16,0:05:34.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iblis Malapetaka?
Dialogue: 0,0:05:35.24,0:05:38.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya itu iblis yang muncul\Ndi legenda Istakar?
Dialogue: 0,0:05:41.12,0:05:42.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu hanya cerita dongeng, kan?
Dialogue: 0,0:05:44.14,0:05:46.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama sekali bukan...
Dialogue: 0,0:06:27.28,0:06:28.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Romantica?
Dialogue: 0,0:06:28.35,0:06:29.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ki...
Dialogue: 0,0:06:29.68,0:06:31.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus menyelamatkan
Dialogue: 0,0:06:31.33,0:06:35.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}para warga kota\Ndan juga kampung halamanku...
Dialogue: 0,0:06:38.48,0:06:39.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan!
Dialogue: 0,0:06:40.01,0:06:42.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dibiarkan saja, para warga kota akan...
Dialogue: 0,0:06:42.30,0:06:43.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lepaskan aku!
Dialogue: 0,0:06:43.39,0:06:44.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah berjanji, kan?
Dialogue: 0,0:06:45.46,0:06:47.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin kamu tetap hidup!
Dialogue: 0,0:06:53.14,0:06:53.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Desir.
Dialogue: 0,0:06:55.64,0:06:58.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beri tahu aku semua\Nyang kamu tahu tentangnya.
Dialogue: 0,0:07:02.52,0:07:05.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelemahan Dadeinuf adalah inti\Nyang ada jauh di dalam tengkuknya.
Dialogue: 0,0:07:07.47,0:07:12.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kulit luarnya sangatlah keras.\NSerangan biasa tidak bisa menggoresnya.
Dialogue: 0,0:07:12.96,0:07:13.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menarik.
Dialogue: 0,0:07:14.62,0:07:16.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar aku coba.
Dialogue: 0,0:07:16.11,0:07:18.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu berniat untuk bertarung sendirian, Zod?
Dialogue: 0,0:07:19.21,0:07:21.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu terlalu gegabah,\Nbahkan untuk Anda, Master Menara!
Dialogue: 0,0:07:21.64,0:07:26.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah julukan yang terhebat di dunia\Nsebaiknya dibuktikan di saat seperti ini?
Dialogue: 0,0:07:34.38,0:07:36.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harap berhati-hati dengan taringnya.
Dialogue: 0,0:07:37.06,0:07:40.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah memunculkan huruf kuno,\Ndia akan melancarkan serangan cahaya tadi.
Dialogue: 0,0:07:41.23,0:07:44.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan Anda sekalipun\Ntidak mungkin bisa menangkisnya.
Dialogue: 0,0:07:44.90,0:07:46.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak sekali yang kamu tahu, ya.
Dialogue: 0,0:07:47.66,0:07:48.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu...
Dialogue: 0,0:07:50.76,0:07:51.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah ini,
Dialogue: 0,0:07:51.86,0:07:54.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}maukah kamu bermain\Ncatur denganku, Desir?
Dialogue: 0,0:07:56.79,0:07:57.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:07:59.14,0:08:01.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu jelas mustahil!
Dialogue: 0,0:08:01.98,0:08:04.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master Menara, kamu akan menghiburku
Dialogue: 0,0:08:04.96,0:08:07.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- sampai negeri ini hancur.\N- Sihir Spasial?
Dialogue: 0,0:08:07.77,0:08:08.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu terlambat selangkah.
Dialogue: 0,0:08:08.98,0:08:10.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak akan kubiarkan!
Dialogue: 0,0:08:19.34,0:08:20.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Desir!
Dialogue: 0,0:08:27.03,0:08:29.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beraninya kamu mengganggu, dasar keroco!
Dialogue: 0,0:08:30.33,0:08:31.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enyahlah.
Dialogue: 0,0:08:34.23,0:08:35.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini...
Dialogue: 0,0:08:35.78,0:08:36.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pembalikan?
Dialogue: 0,0:08:41.94,0:08:43.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu.
Dialogue: 0,0:08:43.53,0:08:46.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata kamu yang\Nmenggangguku saat di kastel, ya?
Dialogue: 0,0:08:46.59,0:08:47.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kalau begitu?
Dialogue: 0,0:08:48.80,0:08:50.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus berterima kasih padamu.
Dialogue: 0,0:08:51.26,0:08:54.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kuenyahkan kamu\Ndi hadapan Master Menara.
Dialogue: 0,0:08:54.97,0:08:57.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba saja kalau kamu bisa, Outer!
Dialogue: 0,0:09:19.42,0:09:20.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cakar Kelam!
Dialogue: 0,0:09:30.62,0:09:32.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kontrol Gravitasi!
Dialogue: 0,0:09:43.55,0:09:45.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pembalikan... Gravitasi!
Dialogue: 0,0:09:53.83,0:09:57.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Artefak yang meningkatkan\Njumlah mana, ya?
Dialogue: 0,0:09:57.59,0:10:01.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, mustahil kamu bisa\Nmembalikkan sihirku hanya dengan itu.
Dialogue: 0,0:10:01.87,0:10:03.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa kamu ini?
Dialogue: 0,0:10:03.82,0:10:05.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harusnya aku yang bertanya begitu!
Dialogue: 0,0:10:05.87,0:10:07.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk apa kamu melakukan semua ini?
Dialogue: 0,0:10:08.25,0:10:11.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bocah sepertimu yang memakai\NClothesline tidak akan paham!
Dialogue: 0,0:10:13.96,0:10:19.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian, bocah yang hidup di kedamaian semu,\Ntak akan tahu pengorbanan yang dilakukan
Dialogue: 0,0:10:19.39,0:10:22.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}agar kalian bisa menikmati\Nposisi kalian saat ini!
Dialogue: 0,0:10:22.14,0:10:23.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan...
Dialogue: 0,0:10:23.37,0:10:24.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu Revolusionis?
Dialogue: 0,0:10:25.91,0:10:29.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beraninya kamu menyebut kami\Ndengan mulut kotormu itu!
Dialogue: 0,0:10:29.70,0:10:31.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dimensi...
Dialogue: 0,0:10:34.16,0:10:35.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Percuma.
Dialogue: 0,0:10:41.22,0:10:43.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak akan kubiarkan kamu memakai sihirmu!
Dialogue: 0,0:10:44.12,0:10:46.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Divao La Gravitia!
Dialogue: 0,0:10:46.25,0:10:48.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Medan Pembeku!
Dialogue: 0,0:10:58.58,0:10:59.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi itu nyaris sekali!
Dialogue: 0,0:11:00.50,0:11:01.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, dengan ini...
Dialogue: 0,0:11:19.03,0:11:20.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada tanda-tanda dia memakai sihir...
Dialogue: 0,0:11:21.47,0:11:23.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, bagaimana bisa?
Dialogue: 0,0:11:28.52,0:11:31.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak kusangka aku\Nakan menggunakan ini.
Dialogue: 0,0:11:32.11,0:11:33.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tamatlah riwayatmu.
Dialogue: 0,0:11:43.35,0:11:45.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat, aku tidak akan sempat...
Dialogue: 0,0:11:46.92,0:11:47.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan mati...
Dialogue: 0,0:11:51.52,0:11:52.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:11:54.47,0:11:55.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir ini...
Dialogue: 0,0:11:56.54,0:11:58.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketemu!\NMereka sedang bertarung di jalan utama!
Dialogue: 0,0:12:00.36,0:12:01.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cakar Kelam!
Dialogue: 0,0:12:04.68,0:12:05.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak akan kubiarkan!
Dialogue: 0,0:12:07.05,0:12:08.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pram...
Dialogue: 0,0:12:11.08,0:12:13.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kulenyapkan kalian semua!
Dialogue: 0,0:12:16.50,0:12:18.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamulah yang akan lenyap.
Dialogue: 0,0:12:18.23,0:12:20.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serenade Beku!
Dialogue: 0,0:12:28.45,0:12:30.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pram... Azest...
Dialogue: 0,0:12:31.56,0:12:35.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar, ya! Kamu menyuruhku kabur,\Ntapi kamu sendiri malah bertarung!
Dialogue: 0,0:12:35.92,0:12:37.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan gegabah...
Dialogue: 0,0:12:38.14,0:12:39.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar.
Dialogue: 0,0:12:39.95,0:12:41.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Romantica...
Dialogue: 0,0:12:41.84,0:12:43.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Desir!
Dialogue: 0,0:12:46.66,0:12:48.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja sama tim adalah hal yang penting.
Dialogue: 0,0:12:48.51,0:12:49.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:12:53.62,0:12:54.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:12:56.98,0:12:59.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong bantu aku, teman-teman!
Dialogue: 0,0:12:59.33,0:13:00.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:13:00.06,0:13:00.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:13:00.75,0:13:02.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja!
Dialogue: 0,0:13:21.48,0:13:22.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersiap!
Dialogue: 0,0:13:25.45,0:13:27.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tembak!
Dialogue: 0,0:13:40.97,0:13:42.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teruskan!
Dialogue: 0,0:13:49.77,0:13:51.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Segera gunakan perisai!
Dialogue: 0,0:13:58.78,0:14:00.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar monster...
Dialogue: 0,0:14:10.92,0:14:14.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya dia bisa dihentikan\Nsebelum menembakkan serangannya.
Dialogue: 0,0:14:14.42,0:14:15.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master Menara?
Dialogue: 0,0:14:18.13,0:14:20.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bahkan tidak tergores\Nsetelah menerima seranganku.
Dialogue: 0,0:14:20.46,0:14:22.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia memang keras.
Dialogue: 0,0:14:23.81,0:14:25.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kupercayakan evakuasi warga padamu.
Dialogue: 0,0:14:25.27,0:14:25.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap!
Dialogue: 0,0:14:26.49,0:14:29.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, banyak dari unit kami yang terluka...
Dialogue: 0,0:14:30.34,0:14:31.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemulihan.
Dialogue: 0,0:14:39.68,0:14:41.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lukaku menghilang...
Dialogue: 0,0:14:41.97,0:14:44.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inilah kuasa penyembuhan\Ndari Yang Mulia Santa!
Dialogue: 0,0:14:45.70,0:14:48.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan tempat ini padaku dan Master Menara.
Dialogue: 0,0:14:48.61,0:14:49.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:14:51.97,0:14:53.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak perlu sampai turun tangan.
Dialogue: 0,0:14:55.49,0:14:57.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau memang benar itu iblis,
Dialogue: 0,0:14:58.57,0:15:00.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tidak bisa membiarkannya begitu saja.
Dialogue: 0,0:15:02.54,0:15:04.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi Santa ternyata merepotkan, ya?
Dialogue: 0,0:15:06.87,0:15:09.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita selesaikan secepat mungkin.
Dialogue: 0,0:15:25.89,0:15:27.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya agak panas, ya.
Dialogue: 0,0:15:30.22,0:15:31.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cocytus!
Dialogue: 0,0:15:49.66,0:15:51.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini pun bisa dihalau...
Dialogue: 0,0:15:51.67,0:15:52.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh juga.
Dialogue: 0,0:16:22.90,0:16:24.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia menangkisnya?
Dialogue: 0,0:16:24.98,0:16:27.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mantelnya memiliki sihir pertahanan!
Dialogue: 0,0:16:28.62,0:16:29.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, gawat!
Dialogue: 0,0:16:36.52,0:16:37.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cakar Kelam!
Dialogue: 0,0:16:45.56,0:16:49.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya sihir kelas atas yang bisa\Nmenembus sihir pertahanannya, ya?
Dialogue: 0,0:16:50.61,0:16:51.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:16:51.78,0:16:54.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang paling berbahaya adalah artefaknya.
Dialogue: 0,0:16:54.95,0:16:56.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya dengan mengubah kombinasinya,
Dialogue: 0,0:16:56.49,0:16:59.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia bisa melepaskan\Nberagam sihir secara instan.
Dialogue: 0,0:17:00.66,0:17:02.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pembalikanku tidak bisa mengikutinya...
Dialogue: 0,0:17:05.77,0:17:08.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Romantica, akan kujelaskan rencananya.
Dialogue: 0,0:17:13.68,0:17:14.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:17:18.66,0:17:20.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak apa-apa, Desir?
Dialogue: 0,0:17:20.92,0:17:22.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah cukup beristirahat.
Dialogue: 0,0:17:23.34,0:17:24.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia lawan yang kuat.
Dialogue: 0,0:17:24.84,0:17:25.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:17:26.28,0:17:28.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kita juga kuat!
Dialogue: 0,0:17:28.54,0:17:29.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penguatan!
Dialogue: 0,0:17:33.82,0:17:34.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo!
Dialogue: 0,0:17:34.59,0:17:35.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:17:35.41,0:17:36.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:17:36.50,0:17:37.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lembing Es!
Dialogue: 0,0:17:45.46,0:17:46.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tebas dia, Pram!
Dialogue: 0,0:17:46.75,0:17:47.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:17:55.65,0:17:58.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak akan bisa menebasnya\Nkalau tidak terlihat.
Dialogue: 0,0:17:59.96,0:18:01.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kubuat
Dialogue: 0,0:18:12.46,0:18:15.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalian semua terpanggang hingga mengabu!
Dialogue: 0,0:18:18.64,0:18:19.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Azest!
Dialogue: 0,0:18:20.66,0:18:21.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang Magis!
Dialogue: 0,0:18:27.82,0:18:29.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Napas Kizzard!
Dialogue: 0,0:18:39.12,0:18:40.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlihat!
Dialogue: 0,0:19:02.28,0:19:03.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar nyaris...
Dialogue: 0,0:19:04.26,0:19:07.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Butuh waktu untuk membalikkan sihir\Nyang pertama kali aku lihat.
Dialogue: 0,0:19:08.01,0:19:09.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sempat melakukannya berkatmu, Azest.
Dialogue: 0,0:19:10.02,0:19:13.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan bisa menangkisnya\Nkalau dia mengeluarkan sihir selevel itu.
Dialogue: 0,0:19:13.59,0:19:15.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku paham, tapi...
Dialogue: 0,0:19:19.14,0:19:22.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan berarti dia sendiri bisa\Nmemakai sihirnya tanpa batas.
Dialogue: 0,0:19:26.60,0:19:28.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang yang terbuat dari Blancium...
Dialogue: 0,0:19:28.60,0:19:31.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bukan sesuatu yang bisa\Ndidapat oleh rakyat jelata...
Dialogue: 0,0:19:32.64,0:19:35.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pendekar Magis Es\Ndan kemampuan berpedang itu...
Dialogue: 0,0:19:36.47,0:19:39.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu menerima latihan resmi, kan?
Dialogue: 0,0:19:39.57,0:19:44.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan kalian dibangun dari banyak\Npengorbanan rakyat yang tak berdosa!
Dialogue: 0,0:19:45.70,0:19:47.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu menyenangkan?
Dialogue: 0,0:19:47.05,0:19:49.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memakai kekuatan\Nyang berlumur dosa dan darah!
Dialogue: 0,0:19:51.56,0:19:53.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu salah!\NKami...
Dialogue: 0,0:19:53.30,0:19:54.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apanya yang salah?
Dialogue: 0,0:19:54.79,0:19:59.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian para bangsawan selalu memangsa\Nyang lemah di setiap zaman!
Dialogue: 0,0:19:59.82,0:20:01.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itulah...
Dialogue: 0,0:20:03.77,0:20:06.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan mengubah dunia ini!
Dialogue: 0,0:20:06.36,0:20:08.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pancaran Spektrum!
Dialogue: 0,0:20:27.88,0:20:30.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enyahlah kalian, bangsawan!
Dialogue: 0,0:20:46.17,0:20:47.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan yang luar biasa!
Dialogue: 0,0:20:47.85,0:20:50.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jauh lebih kuat dari\Nyang kita hadapi di Gerbang...
Dialogue: 0,0:20:52.72,0:20:54.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini semua berkat Master Menara...
Dialogue: 0,0:20:55.04,0:20:56.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan ini, dia pasti...
Dialogue: 0,0:21:04.00,0:21:05.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian semua...
Dialogue: 0,0:21:06.17,0:21:08.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak akan kumaafkan!
Dialogue: 0,0:21:09.93,0:21:11.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luka itu...
Dialogue: 0,0:21:16.95,0:21:18.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhenti...
Dialogue: 0,0:21:18.56,0:21:21.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhenti melihatku!
Dialogue: 0,0:21:21.92,0:21:24.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini... sihir yang meledakkan kastel!
Dialogue: 0,0:21:25.08,0:21:27.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lenyapkan segalanya!
Dialogue: 0,0:21:27.58,0:21:28.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gerhana!
Dialogue: 0,0:21:46.21,0:21:49.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu... Matilah!
Dialogue: 0,0:21:53.64,0:21:55.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan mengubah kombinasinya,
Dialogue: 0,0:21:55.60,0:21:58.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}artefak itu bisa melepaskan\Nsihir apa pun yang kamu mau.
Dialogue: 0,0:21:59.00,0:22:01.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir yang bisa digunakan\Npasti melebihi seribu.
Dialogue: 0,0:22:02.38,0:22:03.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:22:06.44,0:22:08.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya sudah kubalikkan.
Dialogue: 0,0:23:41.45,0:23:43.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya: Kebangkitan.
