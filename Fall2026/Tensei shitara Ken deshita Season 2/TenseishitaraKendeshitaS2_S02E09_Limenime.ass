Dialogue: 0,0:02:49.02,0:02:50.78,sign,,0000,0000,0000,,TENSEI SHITARA KEN DESHITA SEASON 2
Dialogue: 0,0:04:00.26,0:04:03.39,sign,,0000,0000,0000,,EPISODE 9:\NMISI PENYELAMATAN TAK TERDUGA
Dialogue: 0,0:08:47.92,0:08:50.51,sign,,0000,0000,0000,,GLADIO SEEDRUN
Dialogue: 0,0:08:50.51,0:08:53.10,sign,,0000,0000,0000,,GELAR: AJUDAN JENDERAL ANGKATAN LAUT
Dialogue: 0,0:09:27.71,0:09:29.05,sign,,0000,0000,0000,,GOODNESS GARUDI, KELAS: PENIPU
Dialogue: 0,0:09:29.05,0:09:30.80,sign,,0000,0000,0000,,GELAR: PENYIKSA
Dialogue: 0,0:09:30.80,0:09:33.14,sign,,0000,0000,0000,,PEMBUNUH SINTING, PEDAGANG BUDAK ILEGAL
Dialogue: 0,0:15:28.91,0:15:30.24,sign,,0000,0000,0000,,BANGGA
Dialogue: 0,0:16:10.99,0:16:12.95,sign,,0000,0000,0000,,BANGGA
Dialogue: 0,0:23:34.02,0:23:40.02,sign,,0000,0000,0000,,SELANJUTNYA:\NUCAPAN PUTRI JADI PEMICUNYA
Dialogue: 0,0:00:00.55,0:00:03.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Seedrun dan Raydoss bersekutu,
Dialogue: 0,0:00:03.88,0:00:06.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami hanya akan menjadi\Nnegara bawahan, koloni.
Dialogue: 0,0:00:06.74,0:00:10.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami harus menghentikan ini.
Dialogue: 0,0:00:10.74,0:00:13.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan kata lain, kepentingan kita sama.
Dialogue: 0,0:00:13.99,0:00:15.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran.
Dialogue: 0,0:00:15.10,0:00:19.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin kamu membantu kami\Nmenyelamatkan keluarga kerajaan Phyllius.
Dialogue: 0,0:00:19.65,0:00:21.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja, aku akan membantu.
Dialogue: 0,0:00:21.48,0:00:24.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pengawal Flut dan Satya.
Dialogue: 0,0:00:24.00,0:00:25.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:00:26.01,0:00:28.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akan bergerak besok malam.
Dialogue: 0,0:00:28.29,0:00:31.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akan menyusup ke istana\Ntempat mereka ditahan
Dialogue: 0,0:00:31.01,0:00:32.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan menyelamatkan mereka.
Dialogue: 0,0:00:35.29,0:00:38.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kara, Bike.\NBagaimana perkembangannya?
Dialogue: 0,0:00:38.67,0:00:42.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesuai rencana, pasukan pengalihan\Nakan menyerang pelabuhan.
Dialogue: 0,0:00:42.48,0:00:45.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para tentara akan ditarik ke sana\Ndan ke istana utama.
Dialogue: 0,0:00:45.69,0:00:49.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akan memanfaatkan kesempatan itu\Nuntuk bertemu pangeran dan putri di istana
Dialogue: 0,0:00:49.32,0:00:50.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan melarikan diri.
Dialogue: 0,0:00:50.85,0:00:53.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak buah Tuan Salut\Nseharusnya sudah tiba sekarang.
Dialogue: 0,0:00:54.62,0:00:56.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan jatuh!
Dialogue: 0,0:00:56.41,0:00:57.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Licin!
Dialogue: 0,0:01:01.33,0:01:03.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf sudah merepotkanmu.
Dialogue: 0,0:01:03.67,0:01:05.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.\NSudah kuduga akan begini.
Dialogue: 0,0:01:05.84,0:01:07.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bilang begitu!
Dialogue: 0,0:01:07.88,0:01:09.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu Tuan Salut?
Dialogue: 0,0:01:09.92,0:01:11.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih atas bantuanmu.
Dialogue: 0,0:01:11.59,0:01:13.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pasti Nona Miriam, ya?
Dialogue: 0,0:01:13.23,0:01:17.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti yang kusebutkan sebelumnya,\Nkedua Yang Mulia tidak dipenjara,
Dialogue: 0,0:01:17.18,0:01:19.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi dijadikan tahanan rumah.
Dialogue: 0,0:01:21.04,0:01:22.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mengalahkan mereka?
Dialogue: 0,0:01:23.20,0:01:25.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memakai Sihir Kegelapan\Nuntuk menidurkan mereka.
Dialogue: 0,0:01:25.44,0:01:27.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami sudah sangat merepotkanmu.
Dialogue: 0,0:01:27.82,0:01:29.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan sisanya pada kami!
Dialogue: 0,0:01:31.11,0:01:32.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran!
Dialogue: 0,0:01:32.57,0:01:34.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yos, mundur!
Dialogue: 0,0:01:35.28,0:01:36.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada siapa pun—
Dialogue: 0,0:01:38.91,0:01:41.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yos!
Dialogue: 0,0:01:46.57,0:01:48.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Valuza dari Taring Hitam.
Dialogue: 0,0:01:48.31,0:01:49.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:01:49.42,0:01:51.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu seharusnya melindungi istana utama.
Dialogue: 0,0:01:52.63,0:01:55.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar beberapa tikus tersesat\Ndan berkeliaran di sini.
Dialogue: 0,0:01:55.64,0:01:57.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana informasinya bisa bocor?
Dialogue: 0,0:01:57.97,0:01:58.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan...
Dialogue: 0,0:01:59.47,0:02:01.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Sellid mengkhianati kita?
Dialogue: 0,0:02:03.67,0:02:07.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pria tua itu ternyata cukup berguna.
Dialogue: 0,0:02:09.07,0:02:09.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran.
Dialogue: 0,0:02:10.50,0:02:13.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Valuza bukan lawan\Nyang bisa kita lewati begitu saja.
Dialogue: 0,0:02:14.22,0:02:15.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita mundur.
Dialogue: 0,0:02:15.14,0:02:16.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan pikir kalian bisa lolos.
Dialogue: 0,0:02:19.52,0:02:21.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesatria Gigi Naga!
Dialogue: 0,0:02:21.95,0:02:24.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesatria terkuat di Seedrun.
Dialogue: 0,0:02:27.61,0:02:28.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tangkap mereka.
Dialogue: 0,0:04:06.39,0:04:07.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita terpaksa melawannya?
Dialogue: 0,0:04:11.13,0:04:12.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maju sini.
Dialogue: 0,0:04:27.88,0:04:29.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran, tenanglah.
Dialogue: 0,0:04:40.26,0:04:41.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemampuanmu bagus juga.
Dialogue: 0,0:04:42.37,0:04:45.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skill pedang Fran sebenarnya\Nlebih tinggi dari miliknya.
Dialogue: 0,0:04:45.92,0:04:48.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi ini perbedaan pengalaman tempur?
Dialogue: 0,0:05:00.95,0:05:01.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran!
Dialogue: 0,0:05:02.32,0:05:03.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:05:03.53,0:05:05.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu seharusnya lebih baik dari ini.
Dialogue: 0,0:05:06.83,0:05:10.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kamu lakukan pada wajah Fran?
Dialogue: 0,0:05:18.29,0:05:19.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beraninya kamu membunuh Yos!
Dialogue: 0,0:05:21.73,0:05:23.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Miriam, larilah!
Dialogue: 0,0:05:23.83,0:05:25.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami akan menahan mereka di sini!
Dialogue: 0,0:05:26.08,0:05:28.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak boleh kabur sendirian!
Dialogue: 0,0:05:29.17,0:05:30.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat.
Dialogue: 0,0:05:30.52,0:05:34.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mengulur waktu,\Nkita yang rugi dan akan dihabisi.
Dialogue: 0,0:05:34.88,0:05:37.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kalau menggunakan jurus di sini,
Dialogue: 0,0:05:37.11,0:05:39.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Miriam dan yang lainnya akan ikut terkena.
Dialogue: 0,0:05:41.32,0:05:42.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran, serang!
Dialogue: 0,0:05:49.62,0:05:50.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus! Sekarang!
Dialogue: 0,0:05:50.66,0:05:51.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Urushi!
Dialogue: 0,0:06:00.67,0:06:02.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Telekinesis Jarak Jauh!
Dialogue: 0,0:06:11.00,0:06:12.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Naif sekali.
Dialogue: 0,0:06:12.88,0:06:15.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu masih bisa bergerak seperti itu\Ndengan kaki yang cedera?
Dialogue: 0,0:06:15.77,0:06:16.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:06:20.05,0:06:21.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu Taring Racun Mematikan.
Dialogue: 0,0:06:21.78,0:06:23.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wind Arrow!
Dialogue: 0,0:06:26.53,0:06:28.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wind Roar!
Dialogue: 0,0:06:30.35,0:06:31.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat...
Dialogue: 0,0:06:31.63,0:06:32.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini kesempatan kita!
Dialogue: 0,0:06:33.61,0:06:34.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mundur!
Dialogue: 0,0:06:35.94,0:06:38.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yos, maafkan aku.
Dialogue: 0,0:06:49.85,0:06:51.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lain kali aku pasti menang.
Dialogue: 0,0:06:53.25,0:06:57.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lain kali, kita selesaikan ini\Ndengan saling membunuh.
Dialogue: 0,0:07:00.52,0:07:02.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tangkap penyusupnya!
Dialogue: 0,0:07:02.15,0:07:02.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Baik!\N- Baik!
Dialogue: 0,0:07:02.90,0:07:05.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran, panggil boneka api.
Dialogue: 0,0:07:05.28,0:07:06.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:07:06.16,0:07:08.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Flame Servant!\N- Flame Servant!
Dialogue: 0,0:07:09.81,0:07:11.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat...
Dialogue: 0,0:07:11.04,0:07:12.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makhluk apa ini?
Dialogue: 0,0:07:12.33,0:07:14.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tebas mereka!
Dialogue: 0,0:07:19.01,0:07:23.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan serangan mereka tidak besar,\Ntapi bisa mengulur waktu.
Dialogue: 0,0:07:23.01,0:07:25.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu hebat, Gadis Kecil.
Dialogue: 0,0:07:25.28,0:07:29.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihirmu sehebat ini,\Ntapi kamu hanya petualang tingkat D.
Dialogue: 0,0:07:29.01,0:07:32.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku tidak bisa\Nmenyelamatkan Flut dan Satya.
Dialogue: 0,0:07:32.65,0:07:33.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran...
Dialogue: 0,0:07:34.50,0:07:35.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan murung.
Dialogue: 0,0:07:36.27,0:07:39.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita belum gagal.
Dialogue: 0,0:07:40.49,0:07:42.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pasti akan menyelamatkan mereka.
Dialogue: 0,0:07:43.03,0:07:47.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agar itu bisa terwujud,\Nkita harus kabur dulu.
Dialogue: 0,0:07:50.27,0:07:51.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Miriam.
Dialogue: 0,0:07:52.00,0:07:54.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu serius kita\Nakan lewat gerbang utama?
Dialogue: 0,0:07:55.02,0:07:57.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rencana kita sudah bocor.
Dialogue: 0,0:07:57.31,0:08:01.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rute masuk kita pasti sudah\Ndijaga ketat sekarang.
Dialogue: 0,0:08:02.49,0:08:03.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu benar.
Dialogue: 0,0:08:03.96,0:08:07.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akan mengejutkan mereka\Ndan kabur lewat gerbang utama.
Dialogue: 0,0:08:07.43,0:08:08.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu.
Dialogue: 0,0:08:08.99,0:08:10.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, kita pergi.
Dialogue: 0,0:08:13.58,0:08:15.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita sudah sampai di gerbang utama.
Dialogue: 0,0:08:15.60,0:08:17.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Miriam benar.
Dialogue: 0,0:08:18.77,0:08:20.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya ada beberapa penjaga.
Dialogue: 0,0:08:20.63,0:08:22.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kembali ke markas.
Dialogue: 0,0:08:26.47,0:08:27.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gerbangnya terbuka?
Dialogue: 0,0:08:30.68,0:08:32.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Miriam!
Dialogue: 0,0:08:34.02,0:08:35.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gladio...
Dialogue: 0,0:08:36.20,0:08:37.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa dia?
Dialogue: 0,0:08:37.15,0:08:39.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang paling hina dari yang hina.
Dialogue: 0,0:08:39.03,0:08:41.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sepupu Nona Sellimea dan Nona Miriam.
Dialogue: 0,0:08:41.96,0:08:44.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia juga orang kepercayaan Raja Suarez.
Dialogue: 0,0:08:44.67,0:08:46.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putra Jenderal Julius.
Dialogue: 0,0:08:46.84,0:08:47.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putri rendahan sepertimu
Dialogue: 0,0:08:47.92,0:08:50.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berani memberontak terhadap raja.
Dialogue: 0,0:08:50.51,0:08:53.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar tidak tahu terima kasih!
Dialogue: 0,0:08:54.00,0:08:57.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak sudi diceramahi pengecut\Nyang memihak saudaraku yang bodoh itu!
Dialogue: 0,0:08:57.60,0:09:01.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengar, tangkap Miriam hidup-hidup!
Dialogue: 0,0:09:01.06,0:09:02.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Baik!\N- Baik!
Dialogue: 0,0:09:04.23,0:09:08.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa pun yang menangkap mereka\Nakan menerima hadiah besar.
Dialogue: 0,0:09:09.89,0:09:13.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini gawat.\NPara prajurit mendekat.
Dialogue: 0,0:09:13.62,0:09:15.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Gladio.
Dialogue: 0,0:09:15.24,0:09:18.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak keberatan, mau kubantu?
Dialogue: 0,0:09:19.66,0:09:21.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Garudi.
Dialogue: 0,0:09:21.60,0:09:22.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan?
Dialogue: 0,0:09:23.29,0:09:26.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seorang bangsawan memanggilnya "Tuan".
Dialogue: 0,0:09:26.63,0:09:29.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa sebenarnya dia?
Dialogue: 0,0:09:29.05,0:09:33.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia ternyata cukup korup.
Dialogue: 0,0:09:34.22,0:09:35.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia Kucing Hitam.
Dialogue: 0,0:09:35.64,0:09:37.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kucing Biru...\N- Bau busuknya membuatku ingin muntah.
Dialogue: 0,0:09:37.85,0:09:38.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Fran.\N- Ayo tangkap dia.
Dialogue: 0,0:09:38.77,0:09:40.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Aku paham perasaanmu.\N- Kita jual atau bunuh?
Dialogue: 0,0:09:40.48,0:09:42.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kita harus kabur sekarang!
Dialogue: 0,0:09:42.60,0:09:43.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu.
Dialogue: 0,0:09:44.13,0:09:45.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gladio.
Dialogue: 0,0:09:45.40,0:09:48.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menyiksamu sebelum membunuhmu.
Dialogue: 0,0:09:50.14,0:09:51.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar sampah.
Dialogue: 0,0:09:51.68,0:09:54.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya kamu ingin aku\Nmenendang selangkanganmu lagi.
Dialogue: 0,0:10:00.96,0:10:02.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, Nona Miriam?
Dialogue: 0,0:10:02.71,0:10:04.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fire Wall.
Dialogue: 0,0:10:11.17,0:10:13.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Gladio, mundurlah!
Dialogue: 0,0:10:13.80,0:10:17.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Api?\NKucing Hitam itu menggunakannya?
Dialogue: 0,0:10:17.26,0:10:20.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu terbakar!
Dialogue: 0,0:10:20.68,0:10:22.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aqua Create.
Dialogue: 0,0:10:25.73,0:10:26.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fire Wall.
Dialogue: 0,0:10:28.69,0:10:30.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kepala kalian sudah dingin?
Dialogue: 0,0:10:31.93,0:10:33.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus kabur sekarang.
Dialogue: 0,0:10:33.70,0:10:36.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, kamu benar.
Dialogue: 0,0:10:36.95,0:10:37.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo.
Dialogue: 0,0:10:37.93,0:10:39.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya, berkumpul di satu tempat.
Dialogue: 0,0:10:39.92,0:10:40.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:10:41.35,0:10:42.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan biarkan mereka kabur.
Dialogue: 0,0:10:49.61,0:10:51.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, sekarang kita harus bagaimana?
Dialogue: 0,0:10:51.84,0:10:53.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master, kumohon.
Dialogue: 0,0:10:53.55,0:10:55.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, serahkan padaku.
Dialogue: 0,0:10:55.62,0:10:58.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Tanah, Stone Wall!
Dialogue: 0,0:11:01.56,0:11:02.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Urushi!
Dialogue: 0,0:11:07.88,0:11:09.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial.
Dialogue: 0,0:11:10.27,0:11:12.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Miriam!
Dialogue: 0,0:11:18.24,0:11:19.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jalan rahasia lainnya.
Dialogue: 0,0:11:19.74,0:11:21.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kabur langsung terlalu mencolok.
Dialogue: 0,0:11:21.33,0:11:23.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lokasi markas juga akan ketahuan.
Dialogue: 0,0:11:23.58,0:11:24.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran.
Dialogue: 0,0:11:24.28,0:11:27.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanyakan pada Miriam tentang kejadian tadi.
Dialogue: 0,0:11:28.46,0:11:29.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Miriam.
Dialogue: 0,0:11:29.75,0:11:32.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa pria bernama Garudi itu?
Dialogue: 0,0:11:32.51,0:11:34.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia utusan dari Kerajaan Raydoss.
Dialogue: 0,0:11:34.97,0:11:36.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Raydoss...
Dialogue: 0,0:11:36.30,0:11:39.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Korup sialan yang punya skill itu\Nutusan seluruh kerajaan?
Dialogue: 0,0:11:39.97,0:11:42.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia yang menghasut Raja Suarez
Dialogue: 0,0:11:42.14,0:11:45.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan dalang di balik kekacauan\Ndi negara kami.
Dialogue: 0,0:11:45.81,0:11:49.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar begitu dia bersepakat\Ndengan saudaraku yang bodoh, sang raja,
Dialogue: 0,0:11:49.15,0:11:53.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia akan resmi jadi duta besar\Nuntuk Seedrun.
Dialogue: 0,0:11:53.11,0:11:57.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau orang seperti dia\Nberkuasa di Seedrun,
Dialogue: 0,0:11:57.37,0:12:00.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}budak ilegal yang ditangkap\Ndi Granzell atau negara lain
Dialogue: 0,0:12:00.95,0:12:05.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan mengalir tanpa henti\Nmelalui Seedrun ke Raydoss.
Dialogue: 0,0:12:06.40,0:12:07.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia itu
Dialogue: 0,0:12:08.53,0:12:09.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}musuh.
Dialogue: 0,0:12:11.19,0:12:15.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kita harus menyelamatkan Flut\Ndan yang lainnya dulu.
Dialogue: 0,0:12:15.63,0:12:17.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:12:17.59,0:12:19.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi Yos yang gugur dalam pertempuran,
Dialogue: 0,0:12:19.66,0:12:22.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku bersumpah akan menyelamatkan\Npangeran dan putri!
Dialogue: 0,0:12:23.00,0:12:24.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja.
Dialogue: 0,0:12:26.67,0:12:29.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran, aku sudah memikirkan sebuah rencana.
Dialogue: 0,0:12:31.67,0:12:35.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi untuk itu,\Nkita harus membuat persiapan.
Dialogue: 0,0:12:37.86,0:12:39.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sini.
Dialogue: 0,0:12:39.09,0:12:42.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa sangka markasnya\Nada di tempat seperti ini.
Dialogue: 0,0:12:43.06,0:12:44.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu dia.
Dialogue: 0,0:12:45.27,0:12:46.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:12:46.90,0:12:50.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari nyalakan sinyal api\Nuntuk serangan balik kita!
Dialogue: 0,0:12:55.15,0:12:57.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Julius, di mana mereka?
Dialogue: 0,0:12:58.03,0:13:00.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka belum ditemukan.
Dialogue: 0,0:13:00.91,0:13:04.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akan segera tahu\Ndi mana Sellimea bersembunyi.
Dialogue: 0,0:13:04.35,0:13:07.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua berjalan sesuai rencanamu.
Dialogue: 0,0:13:08.17,0:13:10.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, panggil aku Yang Mulia.
Dialogue: 0,0:13:12.13,0:13:14.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mungkin saudara ayahku,
Dialogue: 0,0:13:14.44,0:13:17.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi jangan lupa kamu masih di bawahku.
Dialogue: 0,0:13:18.51,0:13:21.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku, Yang Mulia.
Dialogue: 0,0:13:22.27,0:13:24.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, di mana mereka sekarang?
Dialogue: 0,0:13:24.93,0:13:27.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya mereka melewati\Njalan rahasia di bawah rumah bangsawan
Dialogue: 0,0:13:27.83,0:13:30.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan menuju daerah kumuh barat.
Dialogue: 0,0:13:30.69,0:13:32.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rupanya daerah kumuh.
Dialogue: 0,0:13:38.23,0:13:41.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, Tuan Salut, ikutlah denganku.
Dialogue: 0,0:13:41.05,0:13:44.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di mana Putri Sellimea?
Dialogue: 0,0:13:44.69,0:13:46.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin bertemu dengannya.
Dialogue: 0,0:13:46.47,0:13:50.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, tapi mbakku tidak ada di sini.
Dialogue: 0,0:13:50.61,0:13:53.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami pindah persembunyian secara berkala.
Dialogue: 0,0:13:53.17,0:13:54.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu.
Dialogue: 0,0:13:54.48,0:13:56.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kapan aku bisa menemuinya?
Dialogue: 0,0:13:57.22,0:13:58.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Besok, tentunya.
Dialogue: 0,0:13:59.26,0:14:02.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon bersabar sampai saat itu.
Dialogue: 0,0:14:02.61,0:14:04.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.
Dialogue: 0,0:14:04.64,0:14:11.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya ingin berterima kasih karena dia\Nmembantu kami menolong pangeran dan putri.
Dialogue: 0,0:14:11.41,0:14:12.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu baik sekali.
Dialogue: 0,0:14:15.82,0:14:17.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran sudah kembali!
Dialogue: 0,0:14:17.50,0:14:19.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu baik-baik saja, ya.
Dialogue: 0,0:14:19.22,0:14:22.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran, aku sangat mencemaskanmu.
Dialogue: 0,0:14:22.01,0:14:25.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.\NAku baik-baik saja.
Dialogue: 0,0:14:25.18,0:14:27.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, di mana Flut dan yang lainnya?
Dialogue: 0,0:14:28.75,0:14:30.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku.
Dialogue: 0,0:14:30.92,0:14:32.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu.
Dialogue: 0,0:14:33.21,0:14:35.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka berdua baik-baik saja?
Dialogue: 0,0:14:35.27,0:14:37.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka seharusnya aman untuk saat ini.
Dialogue: 0,0:14:37.69,0:14:40.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,\Nlain kali semua akan berjalan lancar.
Dialogue: 0,0:14:41.59,0:14:42.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja.
Dialogue: 0,0:14:42.86,0:14:46.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Miriam dan yang lainnya\Nbelum menyerah sama sekali.
Dialogue: 0,0:14:52.23,0:14:53.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master.
Dialogue: 0,0:14:53.86,0:14:54.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:14:55.90,0:14:57.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku punya permintaan.
Dialogue: 0,0:15:00.19,0:15:02.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu yakin?
Dialogue: 0,0:15:02.59,0:15:03.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kari sayuran pedas sedang.
Dialogue: 0,0:15:03.88,0:15:05.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini yang terakhir.
Dialogue: 0,0:15:06.72,0:15:10.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mentraktir semua orang\Nmakan kari buatan Master!
Dialogue: 0,0:15:10.39,0:15:12.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu menangis?
Dialogue: 0,0:15:15.92,0:15:18.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini?\NEnak banget.
Dialogue: 0,0:15:18.31,0:15:19.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku suka ini.
Dialogue: 0,0:15:19.94,0:15:21.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski agak pedas.
Dialogue: 0,0:15:23.15,0:15:26.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagi pemula, kalau menaburkan keju di atasnya,\Npedasnya jadi berkurang.
Dialogue: 0,0:15:30.24,0:15:31.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak terasa pedas lagi!
Dialogue: 0,0:15:34.44,0:15:35.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ini...\N- Ini...
Dialogue: 0,0:15:35.77,0:15:39.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aroma harum dan sensasi pedasnya bergantian\Nterasa hingga ke pangkal hidungku.
Dialogue: 0,0:15:39.54,0:15:42.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memenuhi mulutku dengan kebahagiaan.
Dialogue: 0,0:15:43.74,0:15:45.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sangat lezat.
Dialogue: 0,0:15:48.94,0:15:52.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa merasakan energi mengalir\Ndari dalam tubuhku!
Dialogue: 0,0:15:52.39,0:15:55.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasa yang lembut dan mewah!
Dialogue: 0,0:15:56.13,0:16:00.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah mentraktir kami\Nmakanan lezat, Fran.
Dialogue: 0,0:16:01.34,0:16:02.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini yang terbaik.
Dialogue: 0,0:16:02.73,0:16:04.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini hidangan luar biasa buatan Master.
Dialogue: 0,0:16:05.31,0:16:08.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mastermu yang membuat ini?\NHebat.
Dialogue: 0,0:16:08.43,0:16:10.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master adalah master terbaik di dunia.
Dialogue: 0,0:16:10.99,0:16:12.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bisa melakukan apa pun.
Dialogue: 0,0:16:12.95,0:16:16.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, standarmu terlalu tinggi.
Dialogue: 0,0:16:16.73,0:16:20.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu memberi kami\Nsesuatu yang sangat berharga.
Dialogue: 0,0:16:20.33,0:16:22.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:16:22.65,0:16:25.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah lama aku tidak melihat\Nsemua orang senang seperti itu.
Dialogue: 0,0:16:25.38,0:16:27.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Fran.
Dialogue: 0,0:16:27.95,0:16:31.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, aku dengar dari Miriam.
Dialogue: 0,0:16:31.08,0:16:34.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Operasi itu hanya bisa dilakukan sekarang.
Dialogue: 0,0:16:34.79,0:16:37.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku percaya pada keputusanmu.
Dialogue: 0,0:16:37.84,0:16:39.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Segera laksanakan.
Dialogue: 0,0:16:44.72,0:16:45.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:16:46.36,0:16:48.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mengerahkan semua pasukan Sellimea
Dialogue: 0,0:16:48.36,0:16:50.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk membuat serangan tipuan lagi\Ndi istana terpisah?
Dialogue: 0,0:16:50.82,0:16:52.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu kamu akan menyerbu istana utama?
Dialogue: 0,0:16:52.99,0:16:55.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Salut, kamu terlalu berisik.
Dialogue: 0,0:16:56.69,0:16:58.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini, bawahan kita
Dialogue: 0,0:16:58.58,0:17:03.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menyebarkan rumor bahwa kita\Nakan menyerang istana terpisah lagi.
Dialogue: 0,0:17:03.79,0:17:04.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu.
Dialogue: 0,0:17:05.29,0:17:08.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan begitu, kamu akan melemahkan\Npertahanan istana terpisah
Dialogue: 0,0:17:08.76,0:17:11.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan melancarkan serangan kejutan\Nsaat istana utama rentan
Dialogue: 0,0:17:11.26,0:17:12.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk menjatuhkan Raja Suarez.
Dialogue: 0,0:17:12.89,0:17:16.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu kamu bisa menyelamatkan\Npangeran dan putri dengan aman.
Dialogue: 0,0:17:17.07,0:17:18.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu strategi yang bagus.
Dialogue: 0,0:17:18.91,0:17:21.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin kamu pasti lelah,
Dialogue: 0,0:17:21.48,0:17:23.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku ingin kamu mengerahkan segalanya.
Dialogue: 0,0:17:23.76,0:17:25.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dimengerti.
Dialogue: 0,0:17:33.43,0:17:34.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dimengerti.
Dialogue: 0,0:17:34.68,0:17:37.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami pasti akan menyukseskan operasi itu.
Dialogue: 0,0:17:37.77,0:17:41.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran, mereka mantan pengawal kerajaan\Ndari faksi Sellimea.
Dialogue: 0,0:17:41.25,0:17:43.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para penyintas Unit Sisik Naga.
Dialogue: 0,0:17:44.28,0:17:45.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka memang kuat.
Dialogue: 0,0:17:46.53,0:17:47.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bisa tahu?
Dialogue: 0,0:17:48.20,0:17:51.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kamu ahli sesungguhnya\Ndi sini, Gadis Kecil.
Dialogue: 0,0:17:51.58,0:17:54.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuserahkan Nona Miriam padamu.
Dialogue: 0,0:17:55.87,0:17:59.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, menyerang istana terpisah\Nsecara langsung
Dialogue: 0,0:17:59.06,0:18:00.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}terdengar menarik.
Dialogue: 0,0:18:00.50,0:18:03.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akan berhasil\Nmeski harus mengorbankan nyawa.
Dialogue: 0,0:18:03.84,0:18:05.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, semuanya.
Dialogue: 0,0:18:05.44,0:18:08.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya aku ingin\Nmenjelaskan semuanya pada kalian.
Dialogue: 0,0:18:08.90,0:18:11.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih atas perhatianmu.
Dialogue: 0,0:18:11.55,0:18:12.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau menyangkut informasi,
Dialogue: 0,0:18:12.86,0:18:16.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}makin sedikit orang yang tahu,\Nmakin kecil kemungkinannya bocor.
Dialogue: 0,0:18:16.33,0:18:19.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih baik berjaga-jaga.
Dialogue: 0,0:18:21.56,0:18:25.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik itu pengalihan atau umpan,\Nperintahkan saja kami.
Dialogue: 0,0:18:26.94,0:18:29.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengorbanan kalian tidak akan sia-sia.
Dialogue: 0,0:18:30.07,0:18:31.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:18:35.49,0:18:36.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami menerima laporan.
Dialogue: 0,0:18:36.64,0:18:40.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buronan dari negara lain\Nbersembunyi di wilayah ini.
Dialogue: 0,0:18:40.60,0:18:42.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Segera buka!
Dialogue: 0,0:18:43.42,0:18:45.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kamu mendengarku?
Dialogue: 0,0:18:47.51,0:18:49.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana mereka bisa\Nmenemukan tempat ini?
Dialogue: 0,0:18:49.48,0:18:51.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa informasinya bocor?
Dialogue: 0,0:18:52.39,0:18:53.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kamu lakukan?
Dialogue: 0,0:18:53.86,0:18:56.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Dobrak pintunya!\N- Suara itu...
Dialogue: 0,0:18:58.12,0:19:00.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, cari!
Dialogue: 0,0:19:00.12,0:19:03.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sellimea dan anak-anak ada di sini.
Dialogue: 0,0:19:03.23,0:19:05.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat kalau mereka ditemukan sekarang.
Dialogue: 0,0:19:08.36,0:19:09.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Laksamana Dwight.
Dialogue: 0,0:19:09.59,0:19:11.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada yang bersembunyi di gubuk ini.
Dialogue: 0,0:19:15.62,0:19:18.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, kumpulkan warga sampah\Ndari daerah kumuh.
Dialogue: 0,0:19:18.51,0:19:21.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita paksa saja mereka bicara.
Dialogue: 0,0:19:21.31,0:19:23.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar tidak berguna.
Dialogue: 0,0:19:23.96,0:19:25.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumpulkan semua penghuni di sini.
Dialogue: 0,0:19:25.77,0:19:27.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan biarkan satu pun lolos.
Dialogue: 0,0:19:27.44,0:19:28.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:19:31.27,0:19:33.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat mereka semua menggeliat.
Dialogue: 0,0:19:33.28,0:19:35.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti serangga\Nmengerumuni tumpukan sampah.
Dialogue: 0,0:19:35.99,0:19:39.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengar, dasar sampah daerah kumuh.
Dialogue: 0,0:19:39.37,0:19:42.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami tahu para pengkhianat,\NSellimea dan Miriam,
Dialogue: 0,0:19:42.91,0:19:46.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bersembunyi di sini bersama para buronan.
Dialogue: 0,0:19:46.29,0:19:50.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyembunyikan mereka\Nmembuat kalian sama bersalahnya.
Dialogue: 0,0:19:50.29,0:19:51.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi,
Dialogue: 0,0:19:51.88,0:19:55.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku laksamana terhormat\NAngkatan Laut Seedrun.
Dialogue: 0,0:19:55.59,0:19:58.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berhati penyayang.
Dialogue: 0,0:19:59.26,0:20:01.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini satu juta emas.
Dialogue: 0,0:20:01.56,0:20:04.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kalian menyerahkan para putri\Ndan buronan itu,
Dialogue: 0,0:20:04.85,0:20:07.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalian akan mendapatkan satu juta emas.
Dialogue: 0,0:20:07.34,0:20:11.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau kalian lebih suka mati\Nsebagai penjahat bersama pengkhianat itu?
Dialogue: 0,0:20:11.73,0:20:13.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentukan pilihan kalian.
Dialogue: 0,0:20:13.57,0:20:15.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sialan.
Dialogue: 0,0:20:17.22,0:20:20.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?\NKalian tidak mau uangnya?
Dialogue: 0,0:20:20.41,0:20:24.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian sangat ingin melindungi\Npara pengkhianat itu?
Dialogue: 0,0:20:25.08,0:20:28.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, akan kubakar\Nseluruh daerah kumuh ini!
Dialogue: 0,0:20:28.58,0:20:30.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bakar semuanya!
Dialogue: 0,0:20:37.66,0:20:39.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan!
Dialogue: 0,0:20:39.59,0:20:43.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Laksamana, kami menangkap satu buronan.
Dialogue: 0,0:20:44.86,0:20:46.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:20:46.18,0:20:48.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia ditangkap di Pulau Bajak Laut
Dialogue: 0,0:20:48.31,0:20:52.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan akan dijual sebagai budak.
Dialogue: 0,0:20:52.11,0:20:53.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kamu.
Dialogue: 0,0:20:53.27,0:20:56.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di mana rekan-rekanmu bersembunyi?
Dialogue: 0,0:20:58.83,0:21:01.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak mau bicara, lupakan saja.
Dialogue: 0,0:21:01.78,0:21:03.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kamu.\NJadikan dia contoh.
Dialogue: 0,0:21:03.78,0:21:05.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bebas melakukan apa pun padanya.
Dialogue: 0,0:21:06.12,0:21:07.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:21:08.33,0:21:10.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini pasti akan seru.
Dialogue: 0,0:21:10.21,0:21:12.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Hei, dia...\N- Aku penasaran jeritannya
Dialogue: 0,0:21:12.29,0:21:13.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Jangan! Berhenti!\N- akan seperti apa.
Dialogue: 0,0:21:17.13,0:21:19.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat baik-baik, kalian semua!
Dialogue: 0,0:21:19.30,0:21:22.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengorbanan ini\Nakibat perbuatan kalian sendiri!
Dialogue: 0,0:21:30.10,0:21:32.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada yang akan maju?
Dialogue: 0,0:21:32.02,0:21:35.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar pengecut dan tidak berperasaan.
Dialogue: 0,0:21:35.58,0:21:38.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan kata lain,\Nkalian tidak berguna sekarang.
Dialogue: 0,0:21:38.36,0:21:40.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Matilah!
Dialogue: 0,0:21:46.06,0:21:47.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran!
Dialogue: 0,0:21:48.44,0:21:49.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis itu...
Dialogue: 0,0:21:49.50,0:21:51.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga.
Dialogue: 0,0:21:51.58,0:21:53.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rupanya kamu bersembunyi di sini.
Dialogue: 0,0:21:53.93,0:21:57.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,\NSellimea dan Miriam pasti juga...
Dialogue: 0,0:22:02.01,0:22:03.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Matilah.
