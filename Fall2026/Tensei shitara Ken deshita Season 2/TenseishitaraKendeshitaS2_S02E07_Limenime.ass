Dialogue: 0,0:01:50.97,0:01:52.76,sign,,0000,0000,0000,,TENSEI SHITARA KEN DESHITA SEASON 2
Dialogue: 0,0:03:02.45,0:03:07.75,sign,,0000,0000,0000,,EPISODE 7: MONSTER LAUTNYA TERLALU BESAR
Dialogue: 0,0:07:48.86,0:07:50.62,sign,,0000,0000,0000,,TUNA PENGHANCUR KAPAL\NRAS: IKAN SIHIR, LEVEL 29
Dialogue: 0,0:12:30.44,0:12:32.11,sign,,0000,0000,0000,,MIDGARDSORMR
Dialogue: 0,0:12:32.11,0:12:34.11,sign,,0000,0000,0000,,RAS: ULAR LAUT, LEVEL 60
Dialogue: 0,0:12:34.11,0:12:37.03,sign,,0000,0000,0000,,LEVEL ANCAMAN A, BATU MANA DI JANTUNG
Dialogue: 0,0:13:58.53,0:13:59.53,sign,,0000,0000,0000,,PEDANG SIHIR, DEATH GAZE
Dialogue: 0,0:14:02.15,0:14:03.45,sign,,0000,0000,0000,,SKILL: KEMATIAN INSTAN
Dialogue: 0,0:14:03.45,0:14:04.82,sign,,0000,0000,0000,,PELUANG 3%
Dialogue: 0,0:14:04.82,0:14:06.28,sign,,0000,0000,0000,,MEMBUNUH INSTAN LAWAN
Dialogue: 0,0:23:33.93,0:23:39.94,sign,,0000,0000,0000,,SELANJUTNYA:\NNEGARA MARITIM ITU RUMIT
Dialogue: 0,0:00:06.74,0:00:10.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Target adalah dua bocah\Ndari keluarga kerajaan Phyllius.
Dialogue: 0,0:00:10.74,0:00:13.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skill: Deteksi Kehadiran.
Dialogue: 0,0:00:15.25,0:00:17.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, mereka belum menyadariku.
Dialogue: 0,0:00:18.12,0:00:19.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keamanannya juga tidak ketat.
Dialogue: 0,0:00:19.71,0:00:21.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kuselesaikan ini dengan cepat.
Dialogue: 0,0:00:24.84,0:00:26.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pembunuh bayaran?
Dialogue: 0,0:00:26.19,0:00:30.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tadi bicara sendiri bahwa pangeran\Ndan putri adalah targetnya.
Dialogue: 0,0:00:30.93,0:00:34.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus cari tahu apa dia\Npunya hubungan dengan Kucing Biru.
Dialogue: 0,0:00:35.96,0:00:37.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah sadar?
Dialogue: 0,0:00:37.85,0:00:40.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kamu lakukan padaku?
Dialogue: 0,0:00:40.35,0:00:42.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku membuatmu pingsan dan mengikatmu.
Dialogue: 0,0:00:42.36,0:00:43.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapan kamu melakukan itu?
Dialogue: 0,0:00:45.90,0:00:47.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:00:47.82,0:00:50.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benang sihir Master tidak akan putus.
Dialogue: 0,0:00:50.03,0:00:52.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katakan semua yang kamu tahu.
Dialogue: 0,0:00:52.57,0:00:54.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial, jadi berakhir di sini, ya?
Dialogue: 0,0:00:58.00,0:00:59.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia baru saja minum racun!
Dialogue: 0,0:01:00.12,0:01:02.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayang sekali, itu tidak akan berhasil.
Dialogue: 0,0:01:02.25,0:01:03.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Antidot.
Dialogue: 0,0:01:06.55,0:01:09.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Racun Kerajaan yang mematikan dinetralkan?
Dialogue: 0,0:01:09.01,0:01:12.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katakan semua yang kamu tahu.
Dialogue: 0,0:01:14.64,0:01:16.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang dia menggigit lidahnya!
Dialogue: 0,0:01:16.35,0:01:17.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Middle Heal.
Dialogue: 0,0:01:20.23,0:01:23.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cukup pandai dalam sihir penyembuhan.
Dialogue: 0,0:01:23.17,0:01:24.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa rencanamu?
Dialogue: 0,0:01:24.77,0:01:27.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mau menderita\Nsebelum memberi tahu kami semuanya?
Dialogue: 0,0:01:27.61,0:01:31.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak!
Dialogue: 0,0:03:03.25,0:03:05.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tidak bersama para pedagang budak.
Dialogue: 0,0:03:05.50,0:03:07.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi dia pembunuh bayaran bebas, ya?
Dialogue: 0,0:03:07.75,0:03:10.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya kita serahkan pada Salut saja.
Dialogue: 0,0:03:11.96,0:03:13.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pembunuh bayaran?
Dialogue: 0,0:03:14.38,0:03:18.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bilang targetnya Flut dan Satya.
Dialogue: 0,0:03:19.43,0:03:21.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa mereka berdua diincar?
Dialogue: 0,0:03:22.93,0:03:25.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keluarga kerajaan Phyllius istimewa.
Dialogue: 0,0:03:26.39,0:03:27.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Istimewa?
Dialogue: 0,0:03:28.40,0:03:30.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bahas sisanya besok.
Dialogue: 0,0:03:30.77,0:03:32.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga akan memberimu imbalan.
Dialogue: 0,0:03:32.69,0:03:34.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bisa menantikannya.
Dialogue: 0,0:03:34.36,0:03:37.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku lebih menantikan sarapan.
Dialogue: 0,0:03:38.57,0:03:42.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu boleh makan sepuasnya, jadi nikmatilah.
Dialogue: 0,0:03:46.12,0:03:48.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran, aku sudah dengar soal semalam.
Dialogue: 0,0:03:49.19,0:03:51.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya kamu\Nmenyelamatkan kami sekali lagi.
Dialogue: 0,0:03:51.75,0:03:52.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:03:53.59,0:03:54.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei.
Dialogue: 0,0:03:54.42,0:03:57.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan menjawab keluarga kerajaan saat makan.
Dialogue: 0,0:03:59.84,0:04:00.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran.
Dialogue: 0,0:04:00.76,0:04:03.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke mana tujuanmu berikutnya?
Dialogue: 0,0:04:03.56,0:04:04.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ulmutt.
Dialogue: 0,0:04:05.32,0:04:06.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu akan naik kapal?
Dialogue: 0,0:04:07.19,0:04:09.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama ke Bulbola.
Dialogue: 0,0:04:09.04,0:04:10.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu.
Dialogue: 0,0:04:11.30,0:04:12.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, Fran,
Dialogue: 0,0:04:12.94,0:04:14.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu sudah pesan kapal?
Dialogue: 0,0:04:15.26,0:04:18.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini, banyak orang yang bepergian\Nuntuk Festival Bulan.
Dialogue: 0,0:04:18.51,0:04:20.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa semua kapal penumpang sudah penuh.
Dialogue: 0,0:04:20.95,0:04:22.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serius?
Dialogue: 0,0:04:22.20,0:04:23.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak tahu itu.
Dialogue: 0,0:04:24.23,0:04:27.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, ada cara untuk naik kapal.
Dialogue: 0,0:04:28.62,0:04:32.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu tertarik jadi pengawal kami\Nsampai kita tiba di Bulbola?
Dialogue: 0,0:04:32.88,0:04:35.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudmu sebagai pengawal?
Dialogue: 0,0:04:35.59,0:04:37.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami akan bayar jasamu.
Dialogue: 0,0:04:37.67,0:04:39.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Mulia, jangan!
Dialogue: 0,0:04:39.72,0:04:43.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana bisa Anda mempekerjakan\Npetualang yang tak jelas asal-usulnya?
Dialogue: 0,0:04:43.80,0:04:47.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran adalah penyelamat dan temanku.
Dialogue: 0,0:04:48.81,0:04:49.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master?
Dialogue: 0,0:04:49.98,0:04:51.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah ini kesempatan bagus?
Dialogue: 0,0:04:51.60,0:04:53.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa naik kapal justru membantu kita.
Dialogue: 0,0:04:53.61,0:04:56.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, aku akan menerimanya.
Dialogue: 0,0:04:56.23,0:04:57.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serius?
Dialogue: 0,0:04:58.44,0:04:59.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:05:00.43,0:05:02.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan salahkan aku\Nkalau kalian nanti menyesal.
Dialogue: 0,0:05:02.91,0:05:06.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran juga butuh teman seusianya.
Dialogue: 0,0:05:06.89,0:05:09.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuharap mereka bisa akur.
Dialogue: 0,0:05:17.88,0:05:20.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski ini rasanya seperti liburan,
Dialogue: 0,0:05:20.88,0:05:23.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu tetap bertugas untuk melindungi kapal.
Dialogue: 0,0:05:32.44,0:05:34.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dua monster sihir di buritan kiri!
Dialogue: 0,0:05:34.98,0:05:35.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan padaku.
Dialogue: 0,0:05:35.90,0:05:38.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Semangat!\N- Kami mengandalkanmu!
Dialogue: 0,0:05:38.03,0:05:39.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo!
Dialogue: 0,0:05:39.15,0:05:41.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pancing mereka lalu lumpuhkan.
Dialogue: 0,0:05:41.20,0:05:41.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:05:41.99,0:05:43.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini kita makan ikan panggang.
Dialogue: 0,0:05:43.53,0:05:44.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:05:45.42,0:05:46.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus.\NSerang sekarang!
Dialogue: 0,0:05:46.49,0:05:48.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Flare Blast!\N- Flare Blast!
Dialogue: 0,0:05:52.21,0:05:54.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malah bablas.
Dialogue: 0,0:05:54.25,0:05:58.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti akan kubuatkan makanan\Ndengan bahan yang tadi.
Dialogue: 0,0:05:58.46,0:06:00.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu masih belum cukup.
Dialogue: 0,0:06:01.43,0:06:03.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada satu pun yang muncul\Nsejak yang tadi.
Dialogue: 0,0:06:03.59,0:06:06.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti pelayarannya aman.
Dialogue: 0,0:06:07.39,0:06:10.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran, semua orang pergi memancing.
Dialogue: 0,0:06:10.77,0:06:12.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mau ikut?
Dialogue: 0,0:06:13.31,0:06:15.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mereka tidak menyerang,\Nkita yang serang!
Dialogue: 0,0:06:15.61,0:06:17.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pandai memancing.
Dialogue: 0,0:06:18.40,0:06:19.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya?
Dialogue: 0,0:06:20.90,0:06:21.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat!
Dialogue: 0,0:06:21.74,0:06:23.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tangkapan yang bagus!\N- Banyak sekali ikannya!
Dialogue: 0,0:06:23.11,0:06:25.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Semua orang pada mahir, ya.\N- Sepertinya lezat.
Dialogue: 0,0:06:25.28,0:06:26.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master.
Dialogue: 0,0:06:26.49,0:06:28.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa menangkap satu pun.
Dialogue: 0,0:06:28.16,0:06:29.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa karena joran jelek ini?
Dialogue: 0,0:06:29.91,0:06:32.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan salahkan jorannya.
Dialogue: 0,0:06:32.50,0:06:34.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami menangkap cukup banyak.
Dialogue: 0,0:06:34.82,0:06:36.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih belum dapat, Fran?
Dialogue: 0,0:06:36.96,0:06:39.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang saatnya menunjukkan kemampuanmu.
Dialogue: 0,0:06:39.75,0:06:41.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berubah Wujud!
Dialogue: 0,0:06:41.05,0:06:43.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Joran Super Tak Terkalahkan!
Dialogue: 0,0:06:43.13,0:06:44.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:06:45.13,0:06:46.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedangnya...
Dialogue: 0,0:06:46.14,0:06:47.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belum pernah melihat yang seperti itu!
Dialogue: 0,0:06:48.44,0:06:49.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak memancing ikan kecil.
Dialogue: 0,0:06:51.31,0:06:54.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lauk malam ini adalah ikan goreng!
Dialogue: 0,0:06:54.06,0:06:55.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerakusan...
Dialogue: 0,0:06:55.31,0:06:57.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kadang bisa menyebabkan pertumbuhan.
Dialogue: 0,0:07:00.36,0:07:01.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang langsung menggigit!
Dialogue: 0,0:07:02.78,0:07:04.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tarikannya kuat sekali!
Dialogue: 0,0:07:06.28,0:07:08.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bukan ikan besar biasa!
Dialogue: 0,0:07:08.53,0:07:10.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran, gunakan skill-mu!
Dialogue: 0,0:07:11.23,0:07:13.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang Elemen, Petir!
Dialogue: 0,0:07:17.29,0:07:20.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang, kendalikan arusnya!
Dialogue: 0,0:07:21.00,0:07:22.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus!
Dialogue: 0,0:07:22.13,0:07:25.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Angin: Air Burst!
Dialogue: 0,0:07:30.93,0:07:32.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Besar sekali.
Dialogue: 0,0:07:32.60,0:07:34.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nama: Tuna Penghancur Kapal.
Dialogue: 0,0:07:34.93,0:07:37.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kepalanya sekeras Mithril.
Dialogue: 0,0:07:37.14,0:07:38.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menabrak dengan kecepatan sangat tinggi.
Dialogue: 0,0:07:38.98,0:07:40.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan bisa menghancurkan kapal.
Dialogue: 0,0:07:40.98,0:07:42.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Level Ancaman: D.
Dialogue: 0,0:07:42.36,0:07:44.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dagingnya sangat lezat.
Dialogue: 0,0:07:44.28,0:07:46.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dianggap hidangan lezat kelas atas.
Dialogue: 0,0:07:47.15,0:07:48.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhasil kutangkap!
Dialogue: 0,0:07:50.62,0:07:54.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu Fran kuat,\Ntapi tidak kusangka sekuat ini.
Dialogue: 0,0:07:54.45,0:07:56.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa mengalahkan monster Level Ancaman D!
Dialogue: 0,0:07:56.46,0:07:58.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia betulan lebih kuat daripada Salut.
Dialogue: 0,0:07:58.79,0:07:59.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat.
Dialogue: 0,0:08:02.00,0:08:04.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak!
Dialogue: 0,0:08:04.80,0:08:07.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Aku akan makan banyak.\N- Meleleh di mulut.
Dialogue: 0,0:08:07.34,0:08:08.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Lemaknya manis.\N- Boleh minta sepotong lagi?
Dialogue: 0,0:08:08.30,0:08:09.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini...
Dialogue: 0,0:08:09.47,0:08:14.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hanya irisan ikan di atas nasi,\Ntapi rasanya enak!
Dialogue: 0,0:08:14.47,0:08:16.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namanya susyi.
Dialogue: 0,0:08:16.10,0:08:19.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih enak ditambah garam atau kecap asin.
Dialogue: 0,0:08:19.52,0:08:20.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dibakar juga enak.
Dialogue: 0,0:08:20.81,0:08:22.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu tambah keju atau alpukat.
Dialogue: 0,0:08:22.40,0:08:25.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kami sangat menikmati makanannya!
Dialogue: 0,0:08:25.11,0:08:27.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senang bertemu denganmu, Fran.
Dialogue: 0,0:08:27.65,0:08:30.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Rengill, kapten kapal ini.
Dialogue: 0,0:08:31.24,0:08:32.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senang bertemu denganmu.
Dialogue: 0,0:08:32.69,0:08:34.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belum pernah melihat petualang
Dialogue: 0,0:08:34.70,0:08:37.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang bisa menangkap dan memotong\NTuna Penghancur Kapal.
Dialogue: 0,0:08:37.58,0:08:41.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak keberatan, tolong terima ini\Nsebagai tanda pertemanan.
Dialogue: 0,0:08:41.90,0:08:43.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Koin?
Dialogue: 0,0:08:43.21,0:08:46.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Markas Asosiasi Dagang Lucille,
Dialogue: 0,0:08:46.34,0:08:48.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tempatku bernaung ada di Bulbola.
Dialogue: 0,0:08:48.64,0:08:51.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunjukkan ini pada mereka, nanti kamu\Nakan dapat banyak keuntungan.
Dialogue: 0,0:08:51.55,0:08:52.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master?
Dialogue: 0,0:08:52.76,0:08:54.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ambil.
Dialogue: 0,0:08:54.64,0:08:56.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Rengill.
Dialogue: 0,0:08:57.27,0:09:00.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengandalkanmu\Nuntuk terus menjaga kami.
Dialogue: 0,0:09:00.52,0:09:01.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pergi dulu.
Dialogue: 0,0:09:03.34,0:09:05.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat!
Dialogue: 0,0:09:05.12,0:09:07.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asosiasi Dagang Lucille
Dialogue: 0,0:09:07.03,0:09:10.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah salah satu serikat dagang terbesar\Ndi Kerajaan Kranzel.
Dialogue: 0,0:09:10.93,0:09:12.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya?
Dialogue: 0,0:09:12.59,0:09:15.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu kamu diakui oleh salah satu\Neksekutif mereka.
Dialogue: 0,0:09:15.33,0:09:17.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia jelas mengamati Fran.
Dialogue: 0,0:09:17.66,0:09:20.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten Rengill, matamu sangat jeli.
Dialogue: 0,0:09:35.79,0:09:37.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, Fran?
Dialogue: 0,0:09:37.24,0:09:38.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang datang.
Dialogue: 0,0:09:48.73,0:09:51.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten, ada monster sihir yang muncul!
Dialogue: 0,0:09:51.32,0:09:53.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan, dia...
Dialogue: 0,0:09:55.57,0:09:57.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Midgardsormr?
Dialogue: 0,0:09:57.95,0:09:59.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Midgard...\NApa?
Dialogue: 0,0:09:59.58,0:10:02.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Semuanya, bersiap untuk benturan!\N- Midgardsormr.
Dialogue: 0,0:10:02.08,0:10:05.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Monster sihir besar yang dikenal\Nsebagai Pembuat Onar dari Laut.
Dialogue: 0,0:10:05.08,0:10:07.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia juga disebut Bencana Berjalan.
Dialogue: 0,0:10:07.17,0:10:11.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pernah memusnahkan\Nangkatan laut negara besar.
Dialogue: 0,0:10:11.09,0:10:13.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten, apa yang terjadi?
Dialogue: 0,0:10:13.36,0:10:16.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Mulia, ini berbahaya.\NKembalilah ke kabin.
Dialogue: 0,0:10:18.89,0:10:20.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang terjadi?
Dialogue: 0,0:10:20.77,0:10:23.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pantri buritan kanan rusak!
Dialogue: 0,0:10:24.98,0:10:27.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mengincar kargo yang jatuh!
Dialogue: 0,0:10:28.34,0:10:31.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tutup pantri yang rusak dengan sekat!\N- Sial!
Dialogue: 0,0:10:31.11,0:10:33.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tim pengendali kerusakan, pergi ke sana!\N- Mungkin karena bau tuna.
Dialogue: 0,0:10:33.15,0:10:34.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu yang menariknya.
Dialogue: 0,0:10:35.07,0:10:38.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rengill, jauhkan kapal selagi bisa.
Dialogue: 0,0:10:38.70,0:10:41.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, dia akan segera menyusul.
Dialogue: 0,0:10:41.66,0:10:42.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran?
Dialogue: 0,0:10:42.87,0:10:45.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master, apa dia bisa dimakan?
Dialogue: 0,0:10:47.11,0:10:49.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran, apa yang akan kamu lakukan?
Dialogue: 0,0:10:49.42,0:10:50.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita terpaksa harus melawannya.
Dialogue: 0,0:10:51.59,0:10:52.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo.
Dialogue: 0,0:10:52.42,0:10:56.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master dan aku akan mengalahkannya.
Dialogue: 0,0:10:59.00,0:11:01.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Me-Mengalahkannya?
Dialogue: 0,0:11:01.43,0:11:03.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Midgardsormr?
Dialogue: 0,0:11:03.93,0:11:05.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serangan pencegahan!
Dialogue: 0,0:11:06.63,0:11:08.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gunakan senjata terkuat!
Dialogue: 0,0:11:08.90,0:11:12.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Urushi, pancing dia ke permukaan.
Dialogue: 0,0:11:16.91,0:11:19.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran, gunakan Katapel Telekinesis!
Dialogue: 0,0:11:19.56,0:11:21.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita kalahkan dengan satu serangan.
Dialogue: 0,0:11:21.08,0:11:24.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tingkatkan kekuatan dengan Sihir Angin,\NLemparan, dan Pedang Elemen.
Dialogue: 0,0:11:24.96,0:11:26.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:11:27.58,0:11:31.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo!\NPikiran Serentak, Berubah Wujud!
Dialogue: 0,0:11:31.17,0:11:34.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berubah menjadi wujud\Nyang meningkatkan kekuatan.
Dialogue: 0,0:11:34.29,0:11:36.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bayangkan jadi peluru.
Dialogue: 0,0:11:37.18,0:11:40.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keraskan, Taring Getaran,\NTaring Racun Mematikan!
Dialogue: 0,0:11:40.68,0:11:44.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pusatkan mana dan jadilah lebih kuat.
Dialogue: 0,0:11:44.34,0:11:46.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manaku terkuras dengan cepat.
Dialogue: 0,0:11:46.69,0:11:50.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi ini bukan saatnya menahan diri!
Dialogue: 0,0:11:51.90,0:11:54.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran, kamu siap?
Dialogue: 0,0:11:55.03,0:11:56.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapan pun aku siap!
Dialogue: 0,0:11:56.32,0:11:57.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus.
Dialogue: 0,0:12:06.12,0:12:08.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, Urushi!
Dialogue: 0,0:12:08.00,0:12:09.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kembali!
Dialogue: 0,0:12:11.50,0:12:12.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo!
Dialogue: 0,0:12:13.25,0:12:17.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Angin: Sonic Jet!
Dialogue: 0,0:12:18.49,0:12:21.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasakan ini, cacing tanah raksasa!
Dialogue: 0,0:12:25.21,0:12:26.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus!
Dialogue: 0,0:12:26.79,0:12:27.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana?
Dialogue: 0,0:12:27.69,0:12:28.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Identifikasi.
Dialogue: 0,0:12:30.44,0:12:32.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang benar saja!
Dialogue: 0,0:12:32.11,0:12:34.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}HP-nya lebih dari 30.000?
Dialogue: 0,0:12:34.11,0:12:37.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dampak serangan tadi cuma di bawah sepuluh persen?
Dialogue: 0,0:12:37.85,0:12:40.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi ini monster Level Ancaman A.
Dialogue: 0,0:12:40.71,0:12:43.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, ke mana kepalanya?
Dialogue: 0,0:12:48.40,0:12:51.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lukanya sudah sembuh!
Dialogue: 0,0:12:57.38,0:12:58.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi itu apa?
Dialogue: 0,0:12:58.51,0:13:01.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya cairan pencernaan dengan sihir.
Dialogue: 0,0:13:01.59,0:13:03.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini merepotkan.
Dialogue: 0,0:13:03.43,0:13:04.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial.
Dialogue: 0,0:13:04.64,0:13:08.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku akan terus menyerang\Nsampai dia terlambat beregenerasi!
Dialogue: 0,0:13:08.56,0:13:11.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katapel Mental Tembakan Cepat!
Dialogue: 0,0:13:14.77,0:13:16.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana dengan itu?
Dialogue: 0,0:13:16.44,0:13:17.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Cepatlah—\N- HP-nya
Dialogue: 0,0:13:17.90,0:13:21.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}30.087 dari 38.709.
Dialogue: 0,0:13:21.61,0:13:23.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih tersisa sebanyak itu?
Dialogue: 0,0:13:23.57,0:13:24.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serius?
Dialogue: 0,0:13:28.62,0:13:30.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran, kita kembali.
Dialogue: 0,0:13:30.81,0:13:31.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:13:33.46,0:13:35.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedangnya kembali.
Dialogue: 0,0:13:35.25,0:13:37.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu skill manipulasi pedang?
Dialogue: 0,0:13:37.25,0:13:38.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semacam itu.
Dialogue: 0,0:13:39.21,0:13:41.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master, bagaimana situasinya?
Dialogue: 0,0:13:41.76,0:13:44.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil menghabisinya\Ndengan Katapel Telekinesis.
Dialogue: 0,0:13:44.72,0:13:46.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia benar-benar sekuat itu?
Dialogue: 0,0:13:46.43,0:13:49.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daripada dibilang kuat,\Ndia itu sangat tangguh.
Dialogue: 0,0:13:49.77,0:13:51.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus bagaimana?
Dialogue: 0,0:13:51.19,0:13:52.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa boleh buat.
Dialogue: 0,0:13:52.94,0:13:54.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master?
Dialogue: 0,0:13:54.15,0:13:55.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita pakai itu.
Dialogue: 0,0:13:56.36,0:13:58.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang yang kudapat dari Kesatria Tengkorak
Dialogue: 0,0:13:58.53,0:13:59.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di Pulau Melayang,
Dialogue: 0,0:13:59.53,0:14:02.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Death Gaze, yang punya efek kematian instan.
Dialogue: 0,0:14:02.15,0:14:03.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ini pedang,
Dialogue: 0,0:14:03.45,0:14:04.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi malah mengandalkan pedang lain.
Dialogue: 0,0:14:06.28,0:14:08.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran, itu...
Dialogue: 0,0:14:08.55,0:14:10.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang yang bisa membunuh instan lawan.
Dialogue: 0,0:14:10.85,0:14:12.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membunuh instan?
Dialogue: 0,0:14:12.16,0:14:15.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengaktifkan skill: Tarian Pedang!
Dialogue: 0,0:14:16.17,0:14:17.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia hebat!
Dialogue: 0,0:14:17.25,0:14:19.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.\NAyo, pedang sihir kecil!
Dialogue: 0,0:14:19.71,0:14:21.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga berhasil, Master!
Dialogue: 0,0:14:22.09,0:14:23.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan padaku!
Dialogue: 0,0:14:24.47,0:14:28.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan mengesampingkan harga diriku\Nsebagai pedang dan memakai pedang lain.
Dialogue: 0,0:14:28.56,0:14:31.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang, matilah dengan cepat\Ndan bersyukurlah!
Dialogue: 0,0:14:31.06,0:14:33.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasakan ini!
Dialogue: 0,0:14:34.02,0:14:36.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Efek kematian instan diaktifkan.
Dialogue: 0,0:14:36.73,0:14:38.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat tinggal.
Dialogue: 0,0:14:41.57,0:14:44.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus!\NGuru memang hebat!
Dialogue: 0,0:14:48.18,0:14:49.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oi... Jangan-jangan...
Dialogue: 0,0:14:53.08,0:14:56.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Apa yang terjadi\Ndengan efek kematian instannya?
Dialogue: 0,0:14:56.48,0:14:57.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran.
Dialogue: 0,0:14:57.46,0:15:02.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar Midgardsormr\Nmemiliki beberapa jantung.
Dialogue: 0,0:15:02.09,0:15:05.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak yakin efek kematian instan\Nakan berhasil.
Dialogue: 0,0:15:05.43,0:15:06.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serius?
Dialogue: 0,0:15:06.34,0:15:07.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master!
Dialogue: 0,0:15:07.39,0:15:10.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makhluk yang menggeliat itu\Nmungkin punya banyak jantung.
Dialogue: 0,0:15:11.79,0:15:14.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya Identifikasi juga menyebutkan itu.
Dialogue: 0,0:15:14.56,0:15:17.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku akan pakai\Npedang sihir kecil ini
Dialogue: 0,0:15:17.06,0:15:19.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk menebas semua jantungnya!
Dialogue: 0,0:15:21.90,0:15:24.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Efek kematian instan diaktifkan.
Dialogue: 0,0:15:28.70,0:15:30.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Efek kematian instan diaktifkan.
Dialogue: 0,0:15:31.41,0:15:33.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Efek kematian instan diaktifkan.
Dialogue: 0,0:15:33.83,0:15:35.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Efek kematian instan
Dialogue: 0,0:15:36.12,0:15:37.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}diaktifkan.
Dialogue: 0,0:15:38.54,0:15:40.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial, dia masih belum mati!
Dialogue: 0,0:15:40.67,0:15:42.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia punya berapa banyak jantung?
Dialogue: 0,0:15:43.17,0:15:45.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selagi efek kematian instan terpicu,
Dialogue: 0,0:15:45.05,0:15:49.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jantung yang rusak mungkin beregenerasi.
Dialogue: 0,0:15:49.04,0:15:50.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, sial!
Dialogue: 0,0:15:50.72,0:15:53.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten, dia mengejar!
Dialogue: 0,0:15:53.02,0:15:55.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan penuh ke unit sihir!
Dialogue: 0,0:15:55.35,0:15:57.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran sedang bertarung melawannya!
Dialogue: 0,0:15:57.48,0:15:59.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lakukan tugas kalian sebagai pelaut!
Dialogue: 0,0:16:00.77,0:16:01.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master.
Dialogue: 0,0:16:02.44,0:16:04.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sialan! Berhenti!
Dialogue: 0,0:16:04.40,0:16:06.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran ada di kapal itu!
Dialogue: 0,0:16:07.45,0:16:10.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak akan membiarkanmu melewatiku!
Dialogue: 0,0:16:20.33,0:16:21.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial.
Dialogue: 0,0:16:21.75,0:16:23.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak bisa kuhentikan.
Dialogue: 0,0:16:23.09,0:16:24.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski tidak bisa mengalahkannya,
Dialogue: 0,0:16:24.84,0:16:27.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku harus mencari cara\Nuntuk mengulur waktu!
Dialogue: 0,0:16:27.44,0:16:28.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku pakai racun...
Dialogue: 0,0:16:28.72,0:16:30.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, dia terlalu besar.
Dialogue: 0,0:16:30.72,0:16:32.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ada cara lain?
Dialogue: 0,0:16:32.05,0:16:35.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini terlalu berbahaya.\NKembalilah ke kabin!
Dialogue: 0,0:16:35.14,0:16:36.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Fran!\N- Kembali!
Dialogue: 0,0:16:37.73,0:16:39.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master...
Dialogue: 0,0:16:39.44,0:16:40.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana ini?
Dialogue: 0,0:16:40.60,0:16:43.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Amanda, bagaimana cara dia\Nmengalahkan makhluk ini?
Dialogue: 0,0:16:43.76,0:16:45.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Jean...
Dialogue: 0,0:16:47.80,0:16:50.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu! Jadi begitu!
Dialogue: 0,0:16:50.28,0:16:53.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus mempertaruhkan semuanya.
Dialogue: 0,0:16:59.92,0:17:02.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buka yang lebar, Cacing Tanah Raksasa!
Dialogue: 0,0:17:02.71,0:17:04.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, buka!
Dialogue: 0,0:17:06.71,0:17:09.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penghalang Mana dengan kekuatan penuh!
Dialogue: 0,0:17:13.01,0:17:14.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master!
Dialogue: 0,0:17:21.56,0:17:23.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini menjijikkan.
Dialogue: 0,0:17:23.52,0:17:26.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi seperti dugaanku,\Nini semua cairan pencernaan.
Dialogue: 0,0:17:28.35,0:17:30.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan dengan penghalang, ini masih...
Dialogue: 0,0:17:30.90,0:17:34.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daya tahan 930, 929...
Dialogue: 0,0:17:34.83,0:17:37.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus, aku harus masuk lebih dalam.
Dialogue: 0,0:17:38.45,0:17:40.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Percepat!
Dialogue: 0,0:17:40.08,0:17:42.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa lebih cepat lagi!
Dialogue: 0,0:17:48.71,0:17:50.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master.
Dialogue: 0,0:17:51.88,0:17:54.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini batasku?
Dialogue: 0,0:17:54.22,0:17:55.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:17:55.30,0:17:58.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kamu sangat lapar,\Nakan kuberikan semuanya!
Dialogue: 0,0:17:58.35,0:17:59.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanlah sampai kenyang!
Dialogue: 0,0:17:59.68,0:18:02.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sampah yang kusimpan\Ndari tangkapanku baru-baru ini!
Dialogue: 0,0:18:02.73,0:18:04.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyimpanan Dimensi!
Dialogue: 0,0:18:07.11,0:18:10.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tercekiklah oleh puing-puing\Ndari pulau melayang!
Dialogue: 0,0:18:10.84,0:18:14.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Batu besar dari pulau melayang\Nmemiliki atribut undead.
Dialogue: 0,0:18:14.99,0:18:18.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Konon, buanglah ke gunung berapi\Natau laut untuk menetralkannya.
Dialogue: 0,0:18:18.87,0:18:20.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena akan masuk ke laut,
Dialogue: 0,0:18:20.95,0:18:23.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebaiknya kutinggalkan saja di sini!
Dialogue: 0,0:18:24.04,0:18:24.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang terjadi?
Dialogue: 0,0:18:25.39,0:18:26.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tingkahnya aneh.
Dialogue: 0,0:18:28.80,0:18:30.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah semuanya?
Dialogue: 0,0:18:30.26,0:18:32.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memasukkan semuanya ke dalam.
Dialogue: 0,0:18:33.41,0:18:34.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus.
Dialogue: 0,0:18:34.30,0:18:36.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Ruang Waktu: Short Jump!
Dialogue: 0,0:18:40.04,0:18:42.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daya tahan tersisa 97.
Dialogue: 0,0:18:42.52,0:18:43.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serius?
Dialogue: 0,0:18:45.15,0:18:47.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hampir saja.
Dialogue: 0,0:18:48.01,0:18:51.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sulit kupercaya perutnya tidak meledak.
Dialogue: 0,0:18:52.30,0:18:54.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa perutnya lubang hitam?
Dialogue: 0,0:18:54.65,0:18:57.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu...
Dialogue: 0,0:18:57.32,0:18:59.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gerakannya melambat.
Dialogue: 0,0:18:59.58,0:19:01.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bisa kabur sekarang.
Dialogue: 0,0:19:07.58,0:19:09.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran, kamu sangat hebat.
Dialogue: 0,0:19:09.74,0:19:12.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mengendalikan pedangmu\Ndan mengalahkan monster sihir itu.
Dialogue: 0,0:19:12.59,0:19:16.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak membunuhnya,\Ntapi berhasil mengulur waktu.
Dialogue: 0,0:19:16.55,0:19:18.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keahlian pedang yang luar biasa!
Dialogue: 0,0:19:19.18,0:19:20.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master...
Dialogue: 0,0:19:20.10,0:19:23.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudku, pedangku sangat hebat!
Dialogue: 0,0:19:28.80,0:19:30.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu memang hebat, Master.
Dialogue: 0,0:19:30.97,0:19:33.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya?\NTerima kasih.
Dialogue: 0,0:19:34.49,0:19:35.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master.
Dialogue: 0,0:19:35.86,0:19:36.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:19:36.95,0:19:40.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makhluk yang menggeliat itu,\Nrasanya seperti apa, ya?
Dialogue: 0,0:19:40.41,0:19:42.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin rasanya tidak enak.
Dialogue: 0,0:19:42.37,0:19:44.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya?\NSayang sekali.
Dialogue: 0,0:19:44.50,0:19:45.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya aku ingin mencobanya.
Dialogue: 0,0:19:47.07,0:19:49.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah, sekarang sudah fajar.
Dialogue: 0,0:19:49.71,0:19:51.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidurlah sebentar.
Dialogue: 0,0:19:52.42,0:19:54.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat bangun, aku akan makan banyak.
Dialogue: 0,0:19:55.17,0:19:59.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan begitu, kami mengatasi\Ncobaan terbesar di kapal ini.
Dialogue: 0,0:20:05.18,0:20:06.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau begitulah menurut kami...
Dialogue: 0,0:20:06.98,0:20:11.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita sudah melenceng jauh\Ndari jalur selatan awal kita.
Dialogue: 0,0:20:12.11,0:20:13.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sungguh minta maaf.
Dialogue: 0,0:20:13.69,0:20:16.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten Rengill membuat keputusan yang tepat.
Dialogue: 0,0:20:16.95,0:20:23.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pergi ke Negara Laut Seedrun\Nuntuk perbaikan dan suplai itu penting.
Dialogue: 0,0:20:23.20,0:20:25.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersiap untuk serangan!
Dialogue: 0,0:20:25.00,0:20:27.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang bukan petarung, ke bawah dek!
Dialogue: 0,0:20:27.04,0:20:29.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu, aku tidak menduga\Nakan bertemu bajak laut.
Dialogue: 0,0:20:30.50,0:20:33.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kita bergerak, mereka akan menembak.
Dialogue: 0,0:20:34.25,0:20:36.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pangeran, Putri, masuklah ke sekoci.
Dialogue: 0,0:20:36.69,0:20:40.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran, bekerjalah dengan anak buahku\Nuntuk mengalihkan perhatian mereka.
Dialogue: 0,0:20:40.39,0:20:42.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami tidak boleh meninggalkan semua orang.
Dialogue: 0,0:20:42.77,0:20:44.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami juga tetap di sini.
Dialogue: 0,0:20:45.35,0:20:47.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus menyerah.
Dialogue: 0,0:20:47.81,0:20:48.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sellid.
Dialogue: 0,0:20:48.52,0:20:50.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kita memakai nama negara kita,
Dialogue: 0,0:20:50.56,0:20:54.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mereka seharusnya\Ntidak ingin menjadi musuh kita.
Dialogue: 0,0:20:54.02,0:20:54.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu terlalu naif.
Dialogue: 0,0:20:54.90,0:20:57.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka bajak laut.\NTidak ada jaminan seperti itu.
Dialogue: 0,0:20:57.90,0:21:00.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seorang kesatria biasa\Ntidak boleh ikut campur!
Dialogue: 0,0:21:00.20,0:21:01.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:21:01.01,0:21:02.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pengawal mereka!
Dialogue: 0,0:21:03.74,0:21:05.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu itu hanya orang luar.
Dialogue: 0,0:21:06.31,0:21:08.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mengaku telah meninggalkan\NKerajaan Raydoss.
Dialogue: 0,0:21:08.91,0:21:10.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sulit memercayainya.
Dialogue: 0,0:21:10.58,0:21:15.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya kamu mengincar\Npedang suci kerajaan kami, kan?
Dialogue: 0,0:21:16.76,0:21:19.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu menghinaku?
Dialogue: 0,0:21:19.55,0:21:20.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu.
Dialogue: 0,0:21:20.34,0:21:23.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Dia menyebutkan pedang suci?\N- Kamu membahayakan Yang Mulia!
Dialogue: 0,0:21:23.01,0:21:25.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa Phyllius punya pedang suci?
Dialogue: 0,0:21:26.35,0:21:29.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ceritakan soal pedang suci itu nanti.
Dialogue: 0,0:21:31.23,0:21:33.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan mengalahkan para bajak laut.
Dialogue: 0,0:21:33.56,0:21:35.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Urushi, lindungi kapal.
Dialogue: 0,0:21:36.69,0:21:38.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bos!
Dialogue: 0,0:21:39.53,0:21:40.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya
Dialogue: 0,0:21:40.70,0:21:44.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ada yang terbang dari kapal\Ndengan naik pedang.
Dialogue: 0,0:21:45.20,0:21:48.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master, beristirahatlah\Ndan fokuslah memperbaiki.
Dialogue: 0,0:21:48.85,0:21:49.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu yakin?
Dialogue: 0,0:21:51.00,0:21:52.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa menangani ini sendiri.
Dialogue: 0,0:21:56.21,0:21:56.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa kamu?
Dialogue: 0,0:21:56.92,0:22:00.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Akan kubuat kalian kotor di laut.\N- Kamu punya nyali, Bocah!
Dialogue: 0,0:22:02.34,0:22:03.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang benar itu dikubur di laut.
