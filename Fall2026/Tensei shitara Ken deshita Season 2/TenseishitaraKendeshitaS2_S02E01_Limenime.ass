Dialogue: 0,0:01:46.46,0:01:48.76,sign,,0000,0000,0000,,TENSEI SHITARA KEN DESHITA SEASON 2
Dialogue: 0,0:03:08.54,0:03:09.50,sign,,0000,0000,0000,,EPISODE 1:
Dialogue: 0,0:03:09.50,0:03:13.05,sign,,0000,0000,0000,,TERNYATA YANG MELAYANG DI LANGIT ITU PULAU
Dialogue: 0,0:04:54.82,0:04:56.05,sign,,0000,0000,0000,,LEGENDARY SKELETON DARK KNIGHT\NRAS: MONSTER, UNDEAD
Dialogue: 0,0:04:56.05,0:04:58.47,sign,,0000,0000,0000,,STATUS: PENJAGA, UNDEAD, LEVEL 24
Dialogue: 0,0:04:58.47,0:04:59.48,sign,,0000,0000,0000,,SKILL EKSTRA: PENGAKTIFAN POTENSI SKILL
Dialogue: 0,0:04:59.48,0:05:00.49,sign,,0000,0000,0000,,GELAR: PENJAGA DUNGEON
Dialogue: 0,0:05:11.42,0:05:12.67,sign,,0000,0000,0000,,PEDANG PANJANG BAJA BAYANGAN IBLIS
Dialogue: 0,0:05:22.39,0:05:23.26,sign,,0000,0000,0000,,PEDANG IBLIS: DEATH GAZE
Dialogue: 0,0:05:23.26,0:05:24.50,sign,,0000,0000,0000,,EFISIENSI SIHIR: B+
Dialogue: 0,0:05:24.50,0:05:25.72,sign,,0000,0000,0000,,SKILL: KEMATIAN INSTAN
Dialogue: 0,0:05:25.72,0:05:27.72,sign,,0000,0000,0000,,EFISIENSI SIHIR: B+, SKILL: KEMATIAN INSTAN
Dialogue: 0,0:07:37.23,0:07:38.48,sign,,0000,0000,0000,,HERBA UNDEAD, JENIS: RUMPUT ARWAH
Dialogue: 0,0:08:52.14,0:08:53.04,sign,,0000,0000,0000,,SKILL UNIK: MATA JIWA
Dialogue: 0,0:08:53.04,0:08:54.01,sign,,0000,0000,0000,,GELAR: ASSASSIN BERBAKAT, UNDEAD CREATOR,
Dialogue: 0,0:08:54.01,0:08:55.73,sign,,0000,0000,0000,,SANG PENJAGAL, NECROMANCER, RAJA UNDEAD
Dialogue: 0,0:08:55.73,0:08:57.03,sign,,0000,0000,0000,,JEAN DU VIX, 49 TAHUN
Dialogue: 0,0:08:57.03,0:08:58.50,sign,,0000,0000,0000,,RAS: IBLIS, KELAS: PEMANDU ARWAH
Dialogue: 0,0:08:58.50,0:09:00.60,sign,,0000,0000,0000,,LEVEL: 45
Dialogue: 0,0:10:06.67,0:10:07.36,sign,,0000,0000,0000,,TEH UNDEAD (TEH NECRO)
Dialogue: 0,0:10:07.36,0:10:09.67,sign,,0000,0000,0000,,KHASIAT: MENENANGKAN BATIN
Dialogue: 0,0:16:12.12,0:16:14.70,sign,,0000,0000,0000,,ANDY, RAS: MONSTER UNDEAD
Dialogue: 0,0:16:14.70,0:16:17.78,sign,,0000,0000,0000,,STATUS: PELIHARAAN UNDEAD YANG DIPERKUAT BERLEBIH
Dialogue: 0,0:16:17.78,0:16:18.99,sign,,0000,0000,0000,,(SKELETON WYVERN: OVERSPEC)\NARWAH PENDENDAM, TERIKAT KONTRAK
Dialogue: 0,0:16:18.99,0:16:20.58,sign,,0000,0000,0000,,PENGURANGAN KELEMAHAN
Dialogue: 0,0:23:33.98,0:23:45.28,sign,,0000,0000,0000,,SELANJUTNYA:\NJEAN DU VIX MEMANG HEBAT
Dialogue: 0,0:00:01.81,0:00:06.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}3 Juni 3616.\NAku tidak punya nama.
Dialogue: 0,0:00:07.73,0:00:10.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak ingat nama asliku.
Dialogue: 0,0:00:12.53,0:00:15.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}7 Juni 3616.
Dialogue: 0,0:00:16.85,0:00:20.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada anak-anak lain yang juga\Ntidak punya nama sepertiku.
Dialogue: 0,0:00:21.01,0:00:23.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagian dari mereka tatapan matanya kosong.
Dialogue: 0,0:00:24.43,0:00:27.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di antara mereka,\Naku punya teman mengobrol.
Dialogue: 0,0:00:28.03,0:00:31.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi ini rasanya punya teman?
Dialogue: 0,0:00:35.84,0:00:37.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau suatu saat bisa keluar dari sini,
Dialogue: 0,0:00:38.67,0:00:43.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin akan seru kalau kami bertiga\Nmembuat tim dan jadi petualang.
Dialogue: 0,0:00:45.06,0:00:47.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master, kita mau ke mana?
Dialogue: 0,0:00:47.60,0:00:50.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tujuan kita ke sebelah barat Alessa,\Nkota pelabuhan Daas.
Dialogue: 0,0:00:50.88,0:00:53.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Urushi, lari terus ke arah barat!
Dialogue: 0,0:00:53.83,0:00:57.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kota pelabuhan, tempat banyak ikan enak.\NJadi tidak sabar!
Dialogue: 0,0:00:57.98,0:01:00.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kamu terlalu cepat!
Dialogue: 0,0:01:01.50,0:01:04.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kehabisan mana, ya?
Dialogue: 0,0:01:05.23,0:01:09.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus, Urushi.\NMasuk ke dalam bayangan dan istirahatlah.
Dialogue: 0,0:01:10.90,0:01:14.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, kita tidak sedang buru-buru.\NAyo makan dulu.
Dialogue: 0,0:01:14.22,0:01:15.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kari?
Dialogue: 0,0:01:16.39,0:01:20.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kali ini, bagaimana kalau buat\Nkari sayuran gunung racikanku?
Dialogue: 0,0:01:21.27,0:01:23.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kari! Kari!
Dialogue: 0,0:01:23.68,0:01:27.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan begitu, lap dulu air liurmu.
Dialogue: 0,0:02:58.42,0:03:00.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah jadi!
Dialogue: 0,0:03:01.62,0:03:03.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Habis tanpa sisa.
Dialogue: 0,0:03:03.54,0:03:05.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nikmatnya.
Dialogue: 0,0:03:05.76,0:03:07.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master, tambah.
Dialogue: 0,0:03:09.50,0:03:13.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, kita malah makin jauh dari Alessa.
Dialogue: 0,0:03:14.96,0:03:15.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:03:15.94,0:03:18.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu Pulau Melayang.
Dialogue: 0,0:03:18.39,0:03:20.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, itu pulau?
Dialogue: 0,0:03:20.77,0:03:22.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, kadang melayang.
Dialogue: 0,0:03:23.50,0:03:27.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat masih jadi budak,\Nmelihat pulau itu satu-satunya hiburanku.
Dialogue: 0,0:03:27.82,0:03:30.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma satu-satunya hiburanmu?
Dialogue: 0,0:03:30.57,0:03:34.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kita bisa ke sana\Npakai skill Lompat Udara-nya Urushi?
Dialogue: 0,0:03:35.92,0:03:38.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana dia tidak akan cukup, ya?
Dialogue: 0,0:03:38.02,0:03:40.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, kita pakai skill Melayang!
Dialogue: 0,0:03:43.86,0:03:44.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh?
Dialogue: 0,0:03:44.66,0:03:45.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malah berhenti.
Dialogue: 0,0:03:45.83,0:03:49.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah mencapai batas ketinggian.\NTidak bisa naik lebih tinggi.
Dialogue: 0,0:03:49.86,0:03:52.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, terima kasih, Announcer.
Dialogue: 0,0:03:53.23,0:03:56.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, biar aku saja\Nyang pakai skill Telekinesis.
Dialogue: 0,0:03:56.03,0:03:57.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master, kamu curang.
Dialogue: 0,0:03:57.25,0:03:57.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:03:58.46,0:04:00.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga mau ikut.
Dialogue: 0,0:04:00.24,0:04:01.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga.
Dialogue: 0,0:04:04.59,0:04:06.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kunci kakimu dengan Telekinesis.
Dialogue: 0,0:04:07.12,0:04:09.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Urushi masuk ke bayanganku.
Dialogue: 0,0:04:09.47,0:04:11.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, kita pergi!
Dialogue: 0,0:04:11.44,0:04:13.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Air Ride Telekinesis!
Dialogue: 0,0:04:18.13,0:04:21.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu memang hebat, Fran.\NMahir jaga keseimbangan!
Dialogue: 0,0:04:21.60,0:04:25.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita langsung melesat ke Pulau Melayang!
Dialogue: 0,0:04:27.76,0:04:28.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:04:29.82,0:04:32.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master, ada yang datang.
Dialogue: 0,0:04:35.02,0:04:37.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skeleton?\NApa dia Undead?
Dialogue: 0,0:04:40.53,0:04:42.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya dia bukan mau menyambut kita.
Dialogue: 0,0:04:42.74,0:04:44.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, mari kita lawan!
Dialogue: 0,0:04:45.54,0:04:47.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak kena!
Dialogue: 0,0:04:47.34,0:04:48.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran!
Dialogue: 0,0:04:48.06,0:04:50.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fire Arrow!
Dialogue: 0,0:04:51.06,0:04:52.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?\NMonster ini...
Dialogue: 0,0:04:52.94,0:04:54.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Identifikasi!
Dialogue: 0,0:04:56.05,0:04:58.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir defensif dan skill bertarung jarak dekatnya
Dialogue: 0,0:04:58.47,0:05:00.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lebih kuat dari Greater Demon!
Dialogue: 0,0:05:01.95,0:05:04.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran, aku sudah kewalahan\Nmengendalikan Air Ride!
Dialogue: 0,0:05:04.62,0:05:06.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:05:06.05,0:05:06.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia datang!
Dialogue: 0,0:05:06.79,0:05:08.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gudang Dimensi.
Dialogue: 0,0:05:09.89,0:05:12.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu pedang rampasan Greater Demon!
Dialogue: 0,0:05:12.67,0:05:13.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serang!
Dialogue: 0,0:05:15.68,0:05:18.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya aku tidak rela\Nkamu pakai pedang lain.
Dialogue: 0,0:05:21.10,0:05:21.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:05:23.26,0:05:24.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang Iblis?
Dialogue: 0,0:05:24.50,0:05:25.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skill: Kematian Instan bisa aktif
Dialogue: 0,0:05:25.72,0:05:27.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan peluang rendah.
Dialogue: 0,0:05:27.72,0:05:29.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kematian Instan, ya?
Dialogue: 0,0:05:29.48,0:05:31.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Urushi, kamu bisa melawannya?
Dialogue: 0,0:05:35.69,0:05:37.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pakai Master memang solusinya!
Dialogue: 0,0:05:37.62,0:05:39.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja!
Dialogue: 0,0:05:39.73,0:05:40.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo!
Dialogue: 0,0:05:42.13,0:05:44.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master, tolong alihkan perhatiannya!
Dialogue: 0,0:05:44.11,0:05:46.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!\NUrushi, bantu kami juga!
Dialogue: 0,0:05:46.72,0:05:48.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Flare Blast!
Dialogue: 0,0:05:56.63,0:05:57.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bisa menahannya?
Dialogue: 0,0:05:58.43,0:05:59.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lompat Udara!
Dialogue: 0,0:06:00.51,0:06:02.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serang dia, Fran!
Dialogue: 0,0:06:02.05,0:06:04.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dragon Fang!
Dialogue: 0,0:06:08.01,0:06:08.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhasil!
Dialogue: 0,0:06:12.77,0:06:14.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Urushi, buat pijakan!
Dialogue: 0,0:06:15.48,0:06:18.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manamu habis?\NSembunyi ke dalam bayangan!
Dialogue: 0,0:06:19.57,0:06:22.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku akan pakai\NAir Ride Telekinesis-ku!
Dialogue: 0,0:06:22.36,0:06:24.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?\NAku juga kehabisan mana!
Dialogue: 0,0:06:26.29,0:06:27.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berikutnya kita pasti menang.
Dialogue: 0,0:06:32.13,0:06:34.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia berhenti mengejar kita dari sana?
Dialogue: 0,0:06:34.43,0:06:36.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa dia penjaga dungeon?
Dialogue: 0,0:06:36.46,0:06:38.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyebalkan!
Dialogue: 0,0:06:38.48,0:06:41.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial!\NPasti akan kubalas!
Dialogue: 0,0:06:46.19,0:06:48.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, sekarang kita harus bagaimana?
Dialogue: 0,0:06:48.69,0:06:50.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, kita jatuh.
Dialogue: 0,0:06:50.74,0:06:53.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pakai Lompat Udara agar jatuhnya melambat.
Dialogue: 0,0:06:53.42,0:06:54.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke.
Dialogue: 0,0:06:54.14,0:06:56.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lompat Udara.
Dialogue: 0,0:06:57.15,0:06:58.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gagal.
Dialogue: 0,0:06:58.21,0:07:00.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak!
Dialogue: 0,0:07:00.08,0:07:02.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begini, terus melompat\Nsampai mana kita habis!
Dialogue: 0,0:07:02.88,0:07:03.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dimengerti!
Dialogue: 0,0:07:08.13,0:07:10.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa ada rumah warga\Ndi tempat seperti ini?
Dialogue: 0,0:07:10.59,0:07:11.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master.
Dialogue: 0,0:07:12.06,0:07:13.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manaku habis.
Dialogue: 0,0:07:20.32,0:07:22.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran!\NKamu masih hidup?
Dialogue: 0,0:07:22.13,0:07:26.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.\NPantatku sakit.
Dialogue: 0,0:07:28.34,0:07:32.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini?\NAda kebun di dalam rumah?
Dialogue: 0,0:07:32.18,0:07:34.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.\NTanahnya empuk.
Dialogue: 0,0:07:35.10,0:07:38.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada jendela, tapi bisa tumbuh.
Dialogue: 0,0:07:39.57,0:07:40.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang kemari!
Dialogue: 0,0:07:40.93,0:07:42.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hati-hati!
Dialogue: 0,0:07:48.26,0:07:49.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tengkorak lagi...
Dialogue: 0,0:07:49.91,0:07:52.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran, batu sihirnya ada di dalam tubuhnya.
Dialogue: 0,0:07:52.42,0:07:54.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, serang sekali tebas!
Dialogue: 0,0:07:54.91,0:07:57.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong aku!
Dialogue: 0,0:07:57.60,0:08:00.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak enak!\NJangan makan aku!
Dialogue: 0,0:08:00.92,0:08:02.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak akan memakanmu.
Dialogue: 0,0:08:02.75,0:08:04.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia makhluk apa?
Dialogue: 0,0:08:04.34,0:08:08.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namaku Bernardo.\NAku tengkorak yang baik hati.
Dialogue: 0,0:08:08.30,0:08:11.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia punya nama?\NApa dia peliharaan seseorang?
Dialogue: 0,0:08:11.66,0:08:15.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuanku seorang necromancer\Nyang sangat hebat!
Dialogue: 0,0:08:15.31,0:08:17.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Necromancer?
Dialogue: 0,0:08:18.10,0:08:19.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:08:21.41,0:08:22.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa?
Dialogue: 0,0:08:22.66,0:08:25.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian ingin tahu?\NBaiklah, akan kujawab.
Dialogue: 0,0:08:25.78,0:08:29.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku raja para undead\Nyang hidup di dalam kegelapan,
Dialogue: 0,0:08:29.20,0:08:31.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}penjelajah dasar jurang kebijaksanaan.
Dialogue: 0,0:08:32.86,0:08:35.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namaku Jean du Vix!
Dialogue: 0,0:08:36.78,0:08:38.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mencurigakan.
Dialogue: 0,0:08:39.63,0:08:44.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beraninya kalian menerobos\Nke Lab Riset Undead-ku.
Dialogue: 0,0:08:44.16,0:08:48.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya kalian ingin tubuh kalian\Nkumanfaatkan untuk hal berguna, ya.
Dialogue: 0,0:08:48.38,0:08:51.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ada orang mencurigakan,\Nlangsung Identifikasi!
Dialogue: 0,0:08:53.04,0:08:55.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Dia lumayan kuat.
Dialogue: 0,0:08:55.73,0:08:58.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, dia dari bangsa Iblis dan necromancer.
Dialogue: 0,0:08:58.50,0:09:00.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa bangsa Iblis langka bagi kalian?
Dialogue: 0,0:09:00.60,0:09:04.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu wajar, karena jumlah kami\Ndi benua ini memang sedikit.
Dialogue: 0,0:09:04.45,0:09:07.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, aku necromancer.
Dialogue: 0,0:09:07.41,0:09:11.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak yang mengira aku jahat,\Ntapi itu cuma salah paham.
Dialogue: 0,0:09:11.11,0:09:13.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan penampilanmu\Nyang mencurigakan begitu?
Dialogue: 0,0:09:15.42,0:09:19.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daripada bahas itu,\Nakulah yang jadi korban di sini.
Dialogue: 0,0:09:25.54,0:09:29.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mayat dibiarkan, roh jahat akan\Nbersarang dan mengubahnya
Dialogue: 0,0:09:29.90,0:09:32.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menjadi undead yang berbahaya.
Dialogue: 0,0:09:32.54,0:09:38.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebelum itu terjadi, kami para necromancer,\Nmemberi mereka arti reinkarnasi.
Dialogue: 0,0:09:38.24,0:09:41.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang kami lakukan bukan hal jahat,\Ntapi tugas yang mulia.
Dialogue: 0,0:09:45.19,0:09:50.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang di Lab Riset Undead-ku\Nyang penuh kegelapan dan kematian ini!
Dialogue: 0,0:09:50.85,0:09:52.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari bicaranya dia terdengar hebat.
Dialogue: 0,0:09:52.75,0:09:54.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biasa saja.
Dialogue: 0,0:09:54.20,0:09:59.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agar bahaya tidak menyebar, lab utamanya\Nkuletakkan jauh di bawah tanah.
Dialogue: 0,0:09:59.54,0:10:03.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga, ada sihir aneh terasa\Ndari bawah tanah.
Dialogue: 0,0:10:03.17,0:10:05.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini tehnya, silakan diminum.
Dialogue: 0,0:10:05.47,0:10:06.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:10:07.36,0:10:09.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba lihat...
Dialogue: 0,0:10:09.67,0:10:13.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelihatannya seram,\Ntapi sebenarnya tidak berbahaya.
Dialogue: 0,0:10:13.52,0:10:15.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi rasanya tidak enak.
Dialogue: 0,0:10:18.06,0:10:21.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, lalu kalian jatuh ke sini.
Dialogue: 0,0:10:21.65,0:10:22.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:10:24.62,0:10:28.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bernardo, laporkan seberapa parah\Nkerusakan di kebun.
Dialogue: 0,0:10:28.83,0:10:31.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekitar 30% tanamannya rusak.
Dialogue: 0,0:10:31.70,0:10:37.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu Herba Undead, bahan penting\Nuntuk Necro Potion dan sihir arwah.
Dialogue: 0,0:10:37.35,0:10:41.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau disentuh orang hidup, energi kehidupannya\Ntercampur dan bahannya jadi tak berguna.
Dialogue: 0,0:10:41.41,0:10:48.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Necro Potion tingkat 3 ada di tokonya Randell,\Ntapi harganya 300.000 gold.
Dialogue: 0,0:10:48.02,0:10:49.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu sangat mahal?
Dialogue: 0,0:10:51.18,0:10:53.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menanam kualitas terbaik\Nbukan untuk dapat uang saja.
Dialogue: 0,0:10:54.83,0:10:56.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm, baiklah.
Dialogue: 0,0:10:56.93,0:11:00.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gantinya, kalian harus membantuku\Nmenyelesaikan satu tugas.
Dialogue: 0,0:11:01.28,0:11:02.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membantumu?
Dialogue: 0,0:11:02.42,0:11:04.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, sebelum itu...
Dialogue: 0,0:11:05.31,0:11:10.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah waktunya kamu bicara,\NIntelligent Weapon.
Dialogue: 0,0:11:11.03,0:11:18.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skill Unik Mata Jiwa-ku bisa melihat\Nskill yang terukir di dalam jiwa.
Dialogue: 0,0:11:18.21,0:11:20.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Percuma menutupinya\Ndengan Penghalang Identifikasi.
Dialogue: 0,0:11:21.22,0:11:23.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master, kita harus bagaimana?
Dialogue: 0,0:11:23.39,0:11:25.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa boleh buat.
Dialogue: 0,0:11:25.04,0:11:28.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tebakanmu benar, aku pedangnya Fran.
Dialogue: 0,0:11:28.50,0:11:31.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, kamu bicara lewat pikiran.
Dialogue: 0,0:11:31.06,0:11:33.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, kualitasmu sangat mengesankan.
Dialogue: 0,0:11:34.40,0:11:38.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, Master pedang yang super hebat!\NNama dia Master!
Dialogue: 0,0:11:38.43,0:11:43.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master? Nama yang sangat aneh\Nuntuk sebilah pedang sihir!
Dialogue: 0,0:11:46.14,0:11:48.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, kami harus bantu apa?
Dialogue: 0,0:11:48.51,0:11:52.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau menjadikan Fran bahan percobaan\Natau mau meminjamku, kami menolak.
Dialogue: 0,0:11:53.74,0:11:56.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak tertarik dengan hal seperti itu.
Dialogue: 0,0:11:56.70,0:11:59.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena aku tahu kalian berdua sangat kuat,
Dialogue: 0,0:11:59.81,0:12:03.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku ingin kalian membantuku\Nmenaklukkan dungeon.
Dialogue: 0,0:12:03.45,0:12:05.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga.
Dialogue: 0,0:12:06.35,0:12:08.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dungeon yang ada di Pulau Melayang, kan?
Dialogue: 0,0:12:08.46,0:12:13.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, Intelligent Weapon memang hebat,\Nkamu langsung paham.
Dialogue: 0,0:12:13.76,0:12:17.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya gelar kesatria tengkorak\Ntadi itu Penjaga Dungeon.
Dialogue: 0,0:12:17.97,0:12:21.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tepat di tengah Pulau Melayang\Nyang kalian tuju tadi,
Dialogue: 0,0:12:21.09,0:12:23.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ada tempat rahasia\Nyang cuma aku yang tahu.
Dialogue: 0,0:12:24.60,0:12:28.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya bermula sekitar sepuluh tahun lalu.
Dialogue: 0,0:12:28.44,0:12:30.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, apa ceritanya bakal panjang?
Dialogue: 0,0:12:30.94,0:12:34.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kepanjangan, Fran akan ketiduran,\Njadi jelaskan dengan singkat.
Dialogue: 0,0:12:34.26,0:12:35.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master.
Dialogue: 0,0:12:35.23,0:12:36.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:12:36.72,0:12:39.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sekarang sudah jadi petualang Rank D.
Dialogue: 0,0:12:39.60,0:12:42.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa tahan dengar cerita\Nyang agak panjang.
Dialogue: 0,0:12:42.20,0:12:47.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be-Begitu ya, maaf.\NAku tidak boleh terus menganggapmu bocah.
Dialogue: 0,0:12:47.71,0:12:50.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita lanjutkan.
Dialogue: 0,0:12:50.18,0:12:54.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat itu, demi menjadi necromancer yang lebih\Nhebat lagi, aku memperdalam sihir baru—
Dialogue: 0,0:12:54.96,0:12:59.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena Fran langsung tidur,\Nbiar aku yang merangkum ceritanya.
Dialogue: 0,0:13:00.30,0:13:04.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biasanya undead muncul di bekas\Nmedan perang atau kuburan.
Dialogue: 0,0:13:04.70,0:13:08.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Laporan munculnya monster di daerah kosong\Nadalah awal dari semuanya.
Dialogue: 0,0:13:09.49,0:13:12.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah diselidiki, Jean menemukan\Nkumpulan sihir abadi
Dialogue: 0,0:13:12.94,0:13:16.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di bebatuan besar dan tumbuhan.
Dialogue: 0,0:13:16.32,0:13:22.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata itulah asal mula para undead sekaligus\Npuing-puing yang jatuh dari Pulau Melayang.
Dialogue: 0,0:13:23.20,0:13:27.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk memastikan hal itu,\Nbeberapa tahun lalu aku pergi
Dialogue: 0,0:13:27.58,0:13:30.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menjelajahi dungeon\Ndi Pulau Melayang, tapi...
Dialogue: 0,0:13:31.22,0:13:34.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dungeon itu ternyata sarangnya\Nmonster-monster arwah jahat.
Dialogue: 0,0:13:34.64,0:13:38.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu di sana aku diserang\Nmonster buas yang sangat kuat.
Dialogue: 0,0:13:38.26,0:13:43.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku terpaksa menyuruh peliharaanku, Stefan,\Nmenahannya agar aku bisa kabur.
Dialogue: 0,0:13:43.86,0:13:45.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Monster buas yang sangat kuat?
Dialogue: 0,0:13:45.39,0:13:47.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemangsa Mayat.
Dialogue: 0,0:13:47.54,0:13:52.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski undead, dia memangsa undead.\NMonster dengan tingkat bahaya B.
Dialogue: 0,0:13:53.44,0:13:55.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Monster dengan tingkat bahaya B...
Dialogue: 0,0:13:55.84,0:13:58.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain kesatria tengkorak, masih ada\Nmusuh berbahaya seperti itu.
Dialogue: 0,0:13:59.14,0:14:02.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Herba Undead ingin kupakai\Nuntuk mengalahkan monster-monster itu.
Dialogue: 0,0:14:03.12,0:14:07.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi karena sudah kalian rusak,\Naku ingin kalian yang menggantikannya.
Dialogue: 0,0:14:07.35,0:14:08.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu terlalu berat?
Dialogue: 0,0:14:09.01,0:14:12.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak perlu cemas.\NMeski begini, aku petualang Rank D!
Dialogue: 0,0:14:13.86,0:14:16.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, kamu dari Guild Alessa, ya.
Dialogue: 0,0:14:16.66,0:14:17.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tahu tempat itu?
Dialogue: 0,0:14:17.84,0:14:20.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu, aku juga petualang.
Dialogue: 0,0:14:20.27,0:14:21.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu juga?
Dialogue: 0,0:14:21.36,0:14:22.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kaget mendengarnya.
Dialogue: 0,0:14:22.93,0:14:26.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begini, aku petualang Rank B!
Dialogue: 0,0:14:26.08,0:14:27.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, kartunya warna perak!
Dialogue: 0,0:14:27.89,0:14:28.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keren!
Dialogue: 0,0:14:28.93,0:14:34.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak orang memanggilku\Ndengan julukan seram "Jean si Pembantai".
Dialogue: 0,0:14:34.03,0:14:36.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Julukanmu seram, ya.
Dialogue: 0,0:14:36.06,0:14:37.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya tidak begitu.
Dialogue: 0,0:14:37.95,0:14:42.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat perang melawan Kerajaan Raydoss,\Naku cuma membangkitkan prajurit musuh
Dialogue: 0,0:14:42.86,0:14:45.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang sudah mati jadi pasukan undead\Nlalu memimpin mereka bertempur.
Dialogue: 0,0:14:45.76,0:14:48.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu perbuatan yang sangat mengerikan!
Dialogue: 0,0:14:48.03,0:14:53.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Intinya, ini permintaan langsung dariku\Ndan akan kuberi imbalan.
Dialogue: 0,0:14:53.13,0:14:54.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana?
Dialogue: 0,0:14:54.16,0:14:57.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kali ini kita yang salah\Nkarena sudah merusak kebunnya.
Dialogue: 0,0:14:57.23,0:14:59.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau menjelajah dungeon, aku senang.
Dialogue: 0,0:14:59.39,0:15:00.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu...
Dialogue: 0,0:15:00.30,0:15:03.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, kita harus balas kesatria tengkorak tadi.
Dialogue: 0,0:15:03.80,0:15:07.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, kita harus mengalahkannya.
Dialogue: 0,0:15:07.15,0:15:08.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, sudah diputuskan.
Dialogue: 0,0:15:08.80,0:15:11.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jean, kami terima tugas ini!
Dialogue: 0,0:15:12.00,0:15:16.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita berangkat besok.\NMalam ini kalian menginap di tempatku.
Dialogue: 0,0:15:16.96,0:15:19.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa, tidur di sini?
Dialogue: 0,0:15:22.89,0:15:24.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihatlah.
Dialogue: 0,0:15:24.44,0:15:27.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kehebatan sihir terkuat milikku ini!
Dialogue: 0,0:15:28.81,0:15:34.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tinggalkanlah siklus reinkarnasi alam baka\Ndan terimalah kehidupan sementara.
Dialogue: 0,0:15:34.12,0:15:38.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lepaskanlah rantai alam baka\Ndan bangkitlah di hadapanku sekarang!
Dialogue: 0,0:15:38.63,0:15:42.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Overspec: Undead Summoning!
Dialogue: 0,0:15:45.26,0:15:50.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuberi dirimu nama.\NNamamu Andy!
Dialogue: 0,0:15:51.14,0:15:54.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi ini jurus pemanggilan yang sebenarnya.
Dialogue: 0,0:15:56.60,0:16:00.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akan naik Andy dan terbang\Nke Pulau Melayang.
Dialogue: 0,0:16:01.18,0:16:03.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kamu baik-baik saja.
Dialogue: 0,0:16:04.04,0:16:05.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Andy, salam kenal.
Dialogue: 0,0:16:05.82,0:16:07.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Imut.
Dialogue: 0,0:16:09.57,0:16:12.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Overspec.
Dialogue: 0,0:16:12.12,0:16:14.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemampuan melampaui batas aslinya, ya.
Dialogue: 0,0:16:14.70,0:16:17.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia jauh lebih kuat dari Lesser Wyvern biasa.
Dialogue: 0,0:16:18.99,0:16:20.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja.
Dialogue: 0,0:16:20.58,0:16:25.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gantinya, dia akan lenyap dalam waktu 24 jam.
Dialogue: 0,0:16:25.38,0:16:26.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu, ya?
Dialogue: 0,0:16:26.94,0:16:30.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beda dengan Urushi,\Nfungsi dia untuk pertarungan singkat, ya.
Dialogue: 0,0:16:30.01,0:16:33.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serigala peliharaanmu itu juga hebat.
Dialogue: 0,0:16:33.51,0:16:36.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau buat dia mati sebentar\Ndan beri dia Overspec?
Dialogue: 0,0:16:36.70,0:16:37.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mau!
Dialogue: 0,0:16:37.62,0:16:39.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya tidak boleh!
Dialogue: 0,0:16:40.96,0:16:42.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sangat disayangkan.
Dialogue: 0,0:16:42.74,0:16:46.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Isi kepala necromancer seram juga, ya.
Dialogue: 0,0:16:46.28,0:16:51.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katamu cuma kamu yang tahu dungeon-nya,\Nberarti Guild tidak tahu apa pun?
Dialogue: 0,0:16:51.98,0:16:55.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, karena aku tidak pernah lapor.
Dialogue: 0,0:16:55.54,0:16:58.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah ada aturan wajib lapor?
Dialogue: 0,0:16:58.68,0:17:01.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pulau Melayang itu berkeliling\Nmelewati tiga negara,
Dialogue: 0,0:17:01.68,0:17:07.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Granzell, Raydoss di utara,\Ndan juga Belioth.
Dialogue: 0,0:17:07.42,0:17:11.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pulau itu bukan milik negara mana pun.\NItu sebabnya tidak wajib lapor.
Dialogue: 0,0:17:11.39,0:17:13.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi begitu.
Dialogue: 0,0:17:13.52,0:17:15.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, selama tidak ketahuan.
Dialogue: 0,0:17:15.97,0:17:17.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bernardo.
Dialogue: 0,0:17:17.83,0:17:19.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana dengan skill Wing Tiger Skeleton?
Dialogue: 0,0:17:19.64,0:17:21.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah siap.
Dialogue: 0,0:17:21.19,0:17:23.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wing Tiger?
Dialogue: 0,0:17:23.06,0:17:26.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka tengkorak umpan\Nuntuk mengoceh musuh.
Dialogue: 0,0:17:26.06,0:17:27.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu.
Dialogue: 0,0:17:27.74,0:17:33.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tujuan kita dungeon Pulau Melayang!\NAyo, terbanglah, Andy!
Dialogue: 0,0:17:38.66,0:17:40.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hati-hati di jalan.
Dialogue: 0,0:17:41.14,0:17:44.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayap dia cuma tulang, kenapa bisa terbang?
Dialogue: 0,0:17:44.33,0:17:47.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia asalnya monster terbang\Nyang menggunakan skill terbang.
Dialogue: 0,0:17:47.80,0:17:49.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu.
Dialogue: 0,0:17:49.86,0:17:52.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, ada yang datang.\NKesatria Tengkorak?
Dialogue: 0,0:17:53.95,0:17:54.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan.
Dialogue: 0,0:17:54.66,0:17:57.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ada tim yang mendekati Pulau Melayang,
Dialogue: 0,0:17:57.76,0:17:59.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}gerombolan Bone Bird akan menyerang.
Dialogue: 0,0:18:00.34,0:18:02.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu ada Lesser Wyvern Skeleton.
Dialogue: 0,0:18:02.85,0:18:06.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi skill Wing Tiger kita sudah maju\Nmelawan mereka.
Dialogue: 0,0:18:06.86,0:18:09.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jumlah musuhnya banyak sekali.
Dialogue: 0,0:18:09.64,0:18:12.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran dan Master,\Nbantu hadapi musuh di arah depan!
Dialogue: 0,0:18:12.49,0:18:15.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, aku dan Master akan bagi tugas!
Dialogue: 0,0:18:15.41,0:18:17.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Telekinesis!
Dialogue: 0,0:18:17.03,0:18:19.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang Permata Ilusi!
Dialogue: 0,0:18:20.88,0:18:22.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, kita serang mereka!
Dialogue: 0,0:18:33.76,0:18:35.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serap Batu Sihir.
Dialogue: 0,0:18:35.55,0:18:37.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serap sampai puas.
Dialogue: 0,0:18:42.72,0:18:44.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oi, oi!
Dialogue: 0,0:18:44.19,0:18:45.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya muncul juga.
Dialogue: 0,0:18:45.10,0:18:47.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebesar itu?
Dialogue: 0,0:18:52.50,0:18:53.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran!
Dialogue: 0,0:18:54.24,0:18:55.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oi, kita tertembak!
Dialogue: 0,0:18:55.74,0:18:57.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa Andy baik-baik saja?
Dialogue: 0,0:18:57.86,0:19:01.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini gawat, dia tak akan kuat\Nmenahan banyak serangan lagi.
Dialogue: 0,0:19:01.68,0:19:03.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya, mendekatlah!
Dialogue: 0,0:19:03.66,0:19:05.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Apa rencanamu?\N- Urushi.
Dialogue: 0,0:19:05.34,0:19:07.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akan terobos masuk!
Dialogue: 0,0:19:07.22,0:19:08.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:19:08.13,0:19:12.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Instant Sumoning: Undead Ooze!
Dialogue: 0,0:19:12.63,0:19:15.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masuklah ke sela-sela tulang rusuknya\Nbersama Ooze.
Dialogue: 0,0:19:15.86,0:19:17.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yakin ini aman?
Dialogue: 0,0:19:18.10,0:19:21.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuatur tidak beracun\Ndan tidak berbahaya.
Dialogue: 0,0:19:24.18,0:19:25.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Andy...
Dialogue: 0,0:19:28.65,0:19:30.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka terus mengejar kita, ya.
Dialogue: 0,0:19:33.54,0:19:34.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Andy!
Dialogue: 0,0:19:35.49,0:19:37.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mau apa?
Dialogue: 0,0:19:37.18,0:19:39.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak\Nsudah membantu kami, Andy.
Dialogue: 0,0:19:39.99,0:19:44.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, lakukan!\NFinal Reverse Breath!
Dialogue: 0,0:19:46.37,0:19:48.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akan terus terobos!
Dialogue: 0,0:19:50.38,0:19:51.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada barier?
Dialogue: 0,0:19:51.80,0:19:54.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, tapi ini bukan tandingan bagi Andy!
Dialogue: 0,0:19:54.38,0:19:56.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awas jangan sampai lidahmu tergigit, Fran!
Dialogue: 0,0:20:12.42,0:20:14.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran, kamu baik-baik saja?
Dialogue: 0,0:20:14.08,0:20:15.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baik-baik saja...
Dialogue: 0,0:20:16.84,0:20:18.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Andy...
Dialogue: 0,0:20:19.18,0:20:20.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu hebat.
Dialogue: 0,0:20:20.60,0:20:23.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, mananya habis terpakai.
Dialogue: 0,0:20:23.66,0:20:26.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Andy.
Dialogue: 0,0:20:26.16,0:20:30.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski singkat, waktu bersamamu seru.
Dialogue: 0,0:20:30.48,0:20:33.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terbang bersama Andy tadi terbaik!
Dialogue: 0,0:20:33.48,0:20:36.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu hebat, ya.
Dialogue: 0,0:20:36.52,0:20:39.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya biar aku yang mengantarmu pergi.
Dialogue: 0,0:20:39.44,0:20:41.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wahai serpihan jiwa,
Dialogue: 0,0:20:41.71,0:20:46.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lepaskanlah dirimu dari dendam,\Ndan istirahatlah dengan damai.
Dialogue: 0,0:20:46.18,0:20:47.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ascension!
Dialogue: 0,0:20:48.26,0:20:51.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Andy, kamu sudah berjuang keras.
Dialogue: 0,0:20:51.26,0:20:53.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dadah.
Dialogue: 0,0:20:53.68,0:20:57.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Pemurnian konon menguras banyak mana.
Dialogue: 0,0:20:57.78,0:21:02.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Andy bisa dibiarkan lenyap, tapi Jean tetap\Nmemilih mengantarnya pulang dengan sihir.
Dialogue: 0,0:21:02.82,0:21:06.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku melihat dia ada rasa bangga\Ndan tanggung jawab sebagai necromancer.
Dialogue: 0,0:21:09.16,0:21:12.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai dari sini, tugas ini akan\Nmembuat tulang kita remuk.
Dialogue: 0,0:21:12.55,0:21:15.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena lawan kita skeleton.
Dialogue: 0,0:21:15.32,0:21:17.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu guyonan necro!
Dialogue: 0,0:21:17.78,0:21:18.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya?
Dialogue: 0,0:21:18.92,0:21:20.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia kenapa?
Dialogue: 0,0:21:25.64,0:21:29.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}27 Agustus 3616.
Dialogue: 0,0:21:29.96,0:21:32.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kadang mendengar\Nsuara jeritan dari kejauhan.
Dialogue: 0,0:21:33.76,0:21:38.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang para petugas lakukan?\NApa dua orang itu baik-baik saja?
Dialogue: 0,0:21:38.44,0:21:42.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}30 Agustus 3616.
Dialogue: 0,0:21:43.02,0:21:45.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya aku tahu\Nalasan di balik jeritan itu.
Dialogue: 0,0:21:45.45,0:21:48.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami... hanyalah kelinci percobaan.
Dialogue: 0,0:21:49.88,0:21:52.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan! Hentikan!
Dialogue: 0,0:21:53.42,0:21:55.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan! Hentikan!
