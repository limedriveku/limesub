Dialogue: 0,0:02:26.04,0:02:27.75,sign,,0000,0000,0000,,TENSEI SHITARA KEN DESHITA SEASON 2
Dialogue: 0,0:03:55.47,0:04:00.47,sign,,0000,0000,0000,,EPISODE 8: NEGARA MARITIM ITU RUMIT
Dialogue: 0,0:05:50.62,0:05:51.87,sign,,0000,0000,0000,,VALUZA, USIA: 41
Dialogue: 0,0:05:51.87,0:05:53.83,sign,,0000,0000,0000,,RAS: MANUSIA, KELAS: KESATRIA KILAT, LEVEL 45
Dialogue: 0,0:05:53.83,0:05:54.63,sign,,0000,0000,0000,,ALAT: PEDANG BAJA SIHIR AIR,
Dialogue: 0,0:05:54.63,0:05:56.17,sign,,0000,0000,0000,,SEPATU KULIT NAGA LAUT
Dialogue: 0,0:05:56.17,0:05:57.34,sign,,0000,0000,0000,,MATA PAUS SIHIR, KALUNG NAPAS DALAM AIR,
Dialogue: 0,0:05:57.34,0:05:58.59,sign,,0000,0000,0000,,CINCIN MATA ELANG
Dialogue: 0,0:05:58.59,0:05:59.72,sign,,0000,0000,0000,,KEAHLIAN SPESIAL: PEDANG KILAT
Dialogue: 0,0:05:59.72,0:06:00.84,sign,,0000,0000,0000,,GELAR: KOMANDAN KESATRIA, PEMBUNUH
Dialogue: 0,0:10:31.32,0:10:32.82,sign,,0000,0000,0000,,MIRIAM SEEDRUN, USIA: 20
Dialogue: 0,0:10:32.82,0:10:34.97,sign,,0000,0000,0000,,RAS: MANUSIA, KELAS: PENOMBAK, LEVEL 28
Dialogue: 0,0:10:37.28,0:10:39.29,sign,,0000,0000,0000,,GELAR: PUTRI
Dialogue: 0,0:23:33.98,0:23:39.98,sign,,0000,0000,0000,,SELANJUTNYA:\NMISI PENYELAMATAN TAK TERDUGA
Dialogue: 0,0:00:07.03,0:00:08.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Mereka...
Dialogue: 0,0:00:09.28,0:00:10.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran, jangan bunuh mereka.
Dialogue: 0,0:00:11.78,0:00:12.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:00:17.96,0:00:18.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat.
Dialogue: 0,0:00:18.83,0:00:20.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis ini berbahaya!
Dialogue: 0,0:00:21.05,0:00:23.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu cukup hebat, Gadis Kecil.
Dialogue: 0,0:00:24.17,0:00:25.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi,
Dialogue: 0,0:00:25.46,0:00:28.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu belum punya pengalaman untuk naik\Nke kapal bajak lautku yang tanggu—
Dialogue: 0,0:00:30.34,0:00:31.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bos!
Dialogue: 0,0:00:31.51,0:00:32.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial!
Dialogue: 0,0:00:33.89,0:00:35.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya, menyerahlah.
Dialogue: 0,0:00:35.93,0:00:39.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau kupotong kaki dan tangan bos kalian.
Dialogue: 0,0:00:41.91,0:00:45.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?\NNelayan dari Negara Laut Seedrun?
Dialogue: 0,0:00:46.19,0:00:49.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skill mereka hanya memancing\Ndan melempar jaring.
Dialogue: 0,0:00:49.07,0:00:52.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Raja yang baru membebankan pajak tinggi
Dialogue: 0,0:00:52.91,0:00:54.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan rakyat tidak bisa membayarnya.
Dialogue: 0,0:00:55.56,0:00:59.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi mereka kabur ke luar negeri\Ndan jadi bajak laut?
Dialogue: 0,0:00:59.59,0:01:03.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar pergantian penguasa\Nmembuat negara ini kacau.
Dialogue: 0,0:01:03.29,0:01:05.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak kusangka rakyatnya\Nsampai melarikan diri.
Dialogue: 0,0:01:05.20,0:01:09.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Sellimea,\Nyang membela rakyat, menghilang.
Dialogue: 0,0:01:09.42,0:01:12.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan ada rumor bahwa dia dibunuh.
Dialogue: 0,0:01:12.22,0:01:14.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seedrun sudah tamat.
Dialogue: 0,0:01:14.85,0:01:16.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sellimea?
Dialogue: 0,0:01:16.72,0:01:20.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang, kita ke persembunyian\Nbajak laut ini dulu.
Dialogue: 0,0:01:20.48,0:01:23.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan bagus kalau kita bisa\Ndapat perbaikan atau persediaan.
Dialogue: 0,0:01:23.41,0:01:25.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terserah kalian saja.
Dialogue: 0,0:01:27.73,0:01:28.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daging?
Dialogue: 0,0:01:29.59,0:01:31.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daging...
Dialogue: 0,0:01:31.49,0:01:34.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bukan persediaan, Kapten.
Dialogue: 0,0:01:34.57,0:01:38.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tidak punya pilihan\Nselain singgah di Seedrun.
Dialogue: 0,0:01:39.12,0:01:42.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten, ada kapal di arah utara barat laut!
Dialogue: 0,0:01:42.04,0:01:43.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu...
Dialogue: 0,0:01:43.12,0:01:45.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu kapal perang dari Negara Laut Seedrun!
Dialogue: 0,0:01:45.46,0:01:46.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:01:46.63,0:01:48.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya, waspada.
Dialogue: 0,0:01:48.21,0:01:51.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersiap untuk berlayar kapan saja.
Dialogue: 0,0:01:52.23,0:01:56.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pastikan bukan kita yang memulai masalah.
Dialogue: 0,0:01:57.47,0:01:58.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu.
Dialogue: 0,0:02:01.48,0:02:04.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi bajak laut, lalu sekarang kapal perang?
Dialogue: 0,0:02:04.02,0:02:06.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perasaanku mulai tidak enak.
Dialogue: 0,0:03:42.70,0:03:44.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namaku Dwight,
Dialogue: 0,0:03:44.79,0:03:48.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}laksamana Angkatan Laut Seedrun.
Dialogue: 0,0:03:49.13,0:03:53.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menangkap kalian semua,\Npara bajak laut.
Dialogue: 0,0:03:53.13,0:03:55.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami bukan bajak laut!
Dialogue: 0,0:03:55.47,0:03:58.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian memakai jangkar bajak laut.
Dialogue: 0,0:03:58.93,0:04:00.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan konyol.
Dialogue: 0,0:04:00.47,0:04:03.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami awak dari Phyllius.
Dialogue: 0,0:04:03.01,0:04:05.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami punya izin berlayar ke Seedrun.
Dialogue: 0,0:04:06.77,0:04:09.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin itu palsu.
Dialogue: 0,0:04:09.15,0:04:11.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau melawan, kami akan membunuh kalian.
Dialogue: 0,0:04:11.27,0:04:12.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa jadi begini?
Dialogue: 0,0:04:12.69,0:04:13.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu!
Dialogue: 0,0:04:14.53,0:04:17.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami keluarga kerajaan Phyllius.
Dialogue: 0,0:04:17.32,0:04:19.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami jelas bukan bajak laut.
Dialogue: 0,0:04:19.20,0:04:21.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami tidak keberatan\Nmembuktikan identitas kami!
Dialogue: 0,0:04:22.12,0:04:27.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kalian tidak mengubah sikap,\Nini akan jadi insiden diplomatik.
Dialogue: 0,0:04:28.37,0:04:29.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keluarga kerajaan?
Dialogue: 0,0:04:29.92,0:04:32.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak penobatan raja baru,
Dialogue: 0,0:04:32.38,0:04:35.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}negara kami memutuskan hubungan\Ndengan Phyllius.
Dialogue: 0,0:04:35.71,0:04:36.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:04:36.51,0:04:41.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalaupun kalian memang keluarga kerajaan,
Dialogue: 0,0:04:41.47,0:04:43.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ini tetap pelanggaran perairan.
Dialogue: 0,0:04:43.76,0:04:45.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak...
Dialogue: 0,0:04:45.89,0:04:47.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia...
Dialogue: 0,0:04:47.57,0:04:49.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami datang untuk berlabuh darurat.
Dialogue: 0,0:04:49.69,0:04:52.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bersedia membantu,\Natas nama Asosiasi Dagang Lucille,
Dialogue: 0,0:04:52.23,0:04:54.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami akan menawarkan hadiah.
Dialogue: 0,0:04:54.61,0:04:55.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon.
Dialogue: 0,0:04:55.61,0:04:57.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mencoba menyuapku?
Dialogue: 0,0:04:57.07,0:04:58.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:04:58.28,0:05:01.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu menawarkan suap\Npada laksamana Angkatan Laut Seedrun.
Dialogue: 0,0:05:01.49,0:05:04.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menawarkan suap
Dialogue: 0,0:05:04.45,0:05:07.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah kejahatan serius.
Dialogue: 0,0:05:07.45,0:05:09.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu sebentar.
Dialogue: 0,0:05:09.00,0:05:12.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya bilang akan menawarkan hadiah!
Dialogue: 0,0:05:12.04,0:05:13.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diam!
Dialogue: 0,0:05:13.58,0:05:15.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tangkap mereka!
Dialogue: 0,0:05:17.00,0:05:18.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga.
Dialogue: 0,0:05:18.42,0:05:20.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia hanya cari masalah
Dialogue: 0,0:05:20.42,0:05:22.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan ingin menangkap semuanya.
Dialogue: 0,0:05:22.93,0:05:24.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemari, Bocah!
Dialogue: 0,0:05:24.68,0:05:26.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar kurang ajar!\NLepaskan Yang Mulia!
Dialogue: 0,0:05:39.86,0:05:41.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bergerak.
Dialogue: 0,0:05:41.93,0:05:42.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak kapan dia...
Dialogue: 0,0:05:43.49,0:05:47.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bergerak, akan kupenggal kepalamu\Ndan kepala keluarga kerajaan.
Dialogue: 0,0:05:47.37,0:05:49.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa dia?
Dialogue: 0,0:05:50.62,0:05:51.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia...
Dialogue: 0,0:05:51.87,0:05:53.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ahli Seni Pedang...
Dialogue: 0,0:05:53.83,0:05:56.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sangat mahir.
Dialogue: 0,0:05:56.17,0:05:57.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kalau adu kekuatan murni,
Dialogue: 0,0:05:57.34,0:05:58.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita lebih kuat.
Dialogue: 0,0:05:58.59,0:06:00.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi perbedaan pengalamannya terlalu besar.
Dialogue: 0,0:06:00.84,0:06:02.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sama sekali tak bisa bereaksi.
Dialogue: 0,0:06:02.55,0:06:04.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran, jangan bergerak dulu.
Dialogue: 0,0:06:07.01,0:06:11.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama kapten grup Taring Hitam,\NValuza, ada di sini,
Dialogue: 0,0:06:11.02,0:06:14.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Petualang tingkat C\Nakan dibunuh dalam sekejap.
Dialogue: 0,0:06:15.19,0:06:16.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Valuza...
Dialogue: 0,0:06:17.52,0:06:18.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu!
Dialogue: 0,0:06:18.52,0:06:21.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Valuza, kenapa kamu\Nmembunuh mereka begitu saja?
Dialogue: 0,0:06:21.99,0:06:25.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Laksamana bilang siapa pun\Nyang melawan harus dibunuh.
Dialogue: 0,0:06:26.49,0:06:28.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti.
Dialogue: 0,0:06:28.62,0:06:30.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua orang menjadi tahananmu.
Dialogue: 0,0:06:30.45,0:06:32.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong hentikan berbuat lebih.
Dialogue: 0,0:06:32.33,0:06:34.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana ini bisa terjadi?
Dialogue: 0,0:06:35.33,0:06:38.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuharap kamu tidak kasar\Ndengan anak-anak.
Dialogue: 0,0:06:39.38,0:06:42.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat bawa mereka semua pergi!
Dialogue: 0,0:06:43.01,0:06:44.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana dengan jasadnya?
Dialogue: 0,0:06:45.76,0:06:48.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berikan saja pada anjing pemburu.
Dialogue: 0,0:07:00.23,0:07:02.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kami bukan penjahat!
Dialogue: 0,0:07:02.90,0:07:04.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini keterlaluan!
Dialogue: 0,0:07:04.61,0:07:06.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bebaskan kami!
Dialogue: 0,0:07:08.99,0:07:11.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bahkan membunuh pengawal Pangeran.
Dialogue: 0,0:07:11.08,0:07:12.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pikir akan dimaafkan?
Dialogue: 0,0:07:12.87,0:07:14.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diam.
Dialogue: 0,0:07:15.87,0:07:19.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat kamu menghunus pedangmu,
Dialogue: 0,0:07:19.25,0:07:21.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu harus siap untuk mati.
Dialogue: 0,0:07:21.38,0:07:23.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kalian lemah, kalian akan mati.
Dialogue: 0,0:07:24.42,0:07:25.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesederhana itu.
Dialogue: 0,0:07:34.14,0:07:35.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kembali ke kastel.
Dialogue: 0,0:07:35.93,0:07:37.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:07:38.10,0:07:41.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial!\NApa yang akan terjadi pada kita?
Dialogue: 0,0:07:41.15,0:07:42.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana kutahu!
Dialogue: 0,0:07:42.32,0:07:44.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran...
Dialogue: 0,0:07:44.15,0:07:47.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan khawatir.\NAku akan melindungi semuanya.
Dialogue: 0,0:07:48.20,0:07:49.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran, kamu baik-baik saja?
Dialogue: 0,0:07:49.99,0:07:51.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master!
Dialogue: 0,0:07:51.16,0:07:52.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah!
Dialogue: 0,0:07:52.20,0:07:54.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Registrasi pengguna belum dinonaktifkan.
Dialogue: 0,0:07:54.66,0:07:56.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan ke tempatmu sekarang.
Dialogue: 0,0:07:57.11,0:07:58.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menunggumu.
Dialogue: 0,0:07:58.67,0:08:00.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berubah Wujud!
Dialogue: 0,0:08:02.50,0:08:04.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada orang di sana?
Dialogue: 0,0:08:05.05,0:08:06.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo?
Dialogue: 0,0:08:09.26,0:08:12.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata ini menguras mana.
Dialogue: 0,0:08:20.83,0:08:21.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serangga?
Dialogue: 0,0:08:21.69,0:08:22.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serangga!
Dialogue: 0,0:08:22.35,0:08:23.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, ini aku!
Dialogue: 0,0:08:23.73,0:08:24.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serangga!
Dialogue: 0,0:08:26.53,0:08:27.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master?
Dialogue: 0,0:08:27.82,0:08:29.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kembali.
Dialogue: 0,0:08:29.70,0:08:32.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang kembali, Master Mungil.
Dialogue: 0,0:08:32.40,0:08:36.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku tidak bisa mempertahankan\Nwujud ini untuk waktu yang lama.
Dialogue: 0,0:08:40.91,0:08:42.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, Urushi.
Dialogue: 0,0:08:42.53,0:08:43.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang datang.
Dialogue: 0,0:08:43.59,0:08:46.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kalian harusnya senang.
Dialogue: 0,0:08:46.34,0:08:48.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesepakatan telah tercapai.
Dialogue: 0,0:08:49.80,0:08:50.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah.
Dialogue: 0,0:08:50.80,0:08:55.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya Tuan Flut dan Nona Satya\Nberhasil menyelesaikan negosiasi.
Dialogue: 0,0:08:55.10,0:08:58.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa bawahan kesatria bernama Salut?
Dialogue: 0,0:08:58.81,0:09:00.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami.
Dialogue: 0,0:09:00.64,0:09:02.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bawa mereka pergi.
Dialogue: 0,0:09:03.61,0:09:07.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Dwight, apa kami boleh ikut juga?
Dialogue: 0,0:09:07.17,0:09:09.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian sudah dijual.
Dialogue: 0,0:09:09.74,0:09:10.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:09:10.72,0:09:13.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka memutuskan menjadikan kalian budak
Dialogue: 0,0:09:13.32,0:09:17.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk membebaskan keluarga\Nkerajaan Phyllius dan pengikut mereka.
Dialogue: 0,0:09:17.75,0:09:19.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pangeran dan Putri berteriak,
Dialogue: 0,0:09:19.83,0:09:22.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Kami tidak peduli pada yang lain."
Dialogue: 0,0:09:22.08,0:09:26.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Bebaskan saja rakyat kami!"
Dialogue: 0,0:09:27.40,0:09:29.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah itu hal bagus?
Dialogue: 0,0:09:29.30,0:09:32.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Besok, kalian akan jadi budak\Ndengan senang hati.
Dialogue: 0,0:09:32.51,0:09:34.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nikmatilah sepuasnya.
Dialogue: 0,0:09:34.93,0:09:37.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kehidupan yang lebih rendah daripada ternak.
Dialogue: 0,0:09:38.18,0:09:39.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan cemas.
Dialogue: 0,0:09:39.44,0:09:42.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Flut dan Satya tidak akan pernah\Nmelakukan itu.
Dialogue: 0,0:09:42.02,0:09:44.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran benar.
Dialogue: 0,0:09:44.01,0:09:46.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah memastikannya\Ndengan Hukum Kebohongan.
Dialogue: 0,0:09:47.36,0:09:50.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ucapan Dwight bercampur dengan kebohongan.
Dialogue: 0,0:09:50.69,0:09:54.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, memang benar\Nmereka berniat menjadikan kita budak.
Dialogue: 0,0:09:54.24,0:09:56.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita dalam masalah\Nkalau tidak keluar dari sini malam ini.
Dialogue: 0,0:09:56.70,0:09:58.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa jerujinya kupotong saja untuk kabur?
Dialogue: 0,0:09:58.97,0:09:59.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak usah.
Dialogue: 0,0:09:59.79,0:10:01.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain penjaga yang mengawasi kita,
Dialogue: 0,0:10:01.50,0:10:05.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}terlalu berbahaya bagi banyak orang\Nuntuk melewati tempat asing.
Dialogue: 0,0:10:07.42,0:10:08.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah waktunya ganti sif?
Dialogue: 0,0:10:14.84,0:10:15.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa dia?
Dialogue: 0,0:10:23.48,0:10:27.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian ada relasi\Ndengan Kerajaan Phyllius, kan?
Dialogue: 0,0:10:27.27,0:10:30.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Segera identifikasi siapa pun\Nyang mencurigakan.
Dialogue: 0,0:10:31.32,0:10:34.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatannya sekitar peringkat D...
Dialogue: 0,0:10:35.70,0:10:36.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:10:37.28,0:10:39.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu dulu!
Dialogue: 0,0:10:39.29,0:10:41.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Miriam Seedrun.
Dialogue: 0,0:10:41.37,0:10:43.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master, apa dia sekutu?
Dialogue: 0,0:10:43.33,0:10:44.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entahlah.
Dialogue: 0,0:10:45.04,0:10:48.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi satu hal yang pasti.\NDia putri kerajaan ini.
Dialogue: 0,0:10:48.21,0:10:49.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putri?
Dialogue: 0,0:10:51.83,0:10:54.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan membebaskan kalian semua.\NIkut aku.
Dialogue: 0,0:10:54.72,0:10:56.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu menyelamatkan kami?
Dialogue: 0,0:10:57.35,0:10:59.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu keinginan tuanku.
Dialogue: 0,0:10:59.93,0:11:01.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senjata?
Dialogue: 0,0:11:01.18,0:11:05.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan dari putri biasanya seorang raja, kan?
Dialogue: 0,0:11:05.27,0:11:06.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa?
Dialogue: 0,0:11:06.50,0:11:07.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa bilang.
Dialogue: 0,0:11:07.45,0:11:08.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Raja?
Dialogue: 0,0:11:08.38,0:11:09.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa?
Dialogue: 0,0:11:09.44,0:11:10.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu bilang begitu?
Dialogue: 0,0:11:10.97,0:11:13.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana aku bisa mematuhi\Nsaudara yang bodoh itu?
Dialogue: 0,0:11:13.69,0:11:15.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu siapa?
Dialogue: 0,0:11:15.07,0:11:17.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya punya satu raja.
Dialogue: 0,0:11:17.12,0:11:18.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia adalah mbakku, Sellimea.
Dialogue: 0,0:11:18.99,0:11:21.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya dia keceplosan.
Dialogue: 0,0:11:23.27,0:11:24.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sellimea?
Dialogue: 0,0:11:24.62,0:11:26.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga!
Dialogue: 0,0:11:26.92,0:11:29.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar dia dibunuh.
Dialogue: 0,0:11:29.54,0:11:32.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu rumor yang disebarkan\Noleh saudaraku yang bodoh, Suarez.
Dialogue: 0,0:11:32.42,0:11:34.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suarez?
Dialogue: 0,0:11:34.45,0:11:35.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Raja saat ini.
Dialogue: 0,0:11:36.83,0:11:39.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Situsinya jadi rumit.
Dialogue: 0,0:11:39.73,0:11:40.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang penting...
Dialogue: 0,0:11:40.68,0:11:44.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua perkataan Miriam sejauh ini benar.
Dialogue: 0,0:11:45.08,0:11:48.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.\NAku percaya padamu.
Dialogue: 0,0:11:48.06,0:11:50.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Fran berkata begitu,
Dialogue: 0,0:11:50.48,0:11:51.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami juga percaya.
Dialogue: 0,0:11:51.98,0:11:54.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus.\NKalau begitu, ayo bergegas.
Dialogue: 0,0:12:00.45,0:12:02.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada terlalu banyak prajurit di luar.
Dialogue: 0,0:12:02.74,0:12:04.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akan keluar lewat basemen.
Dialogue: 0,0:12:08.54,0:12:10.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jalan rahasia di penjara bawah tanah?
Dialogue: 0,0:12:10.95,0:12:13.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata betulan ada, ya.
Dialogue: 0,0:12:13.00,0:12:15.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu temuan yang bagus.
Dialogue: 0,0:12:19.64,0:12:21.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita di luar.
Dialogue: 0,0:12:21.26,0:12:22.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan berisik.
Dialogue: 0,0:12:23.26,0:12:24.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah menunggumu.
Dialogue: 0,0:12:24.88,0:12:27.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kara, bagaimana dengan jalan keluar lainnya?
Dialogue: 0,0:12:27.45,0:12:28.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah dibuka.
Dialogue: 0,0:12:28.77,0:12:32.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami juga memasang pengecoh\Nagar terlihat banyak orang yang lewat.
Dialogue: 0,0:12:32.86,0:12:34.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka sangat teliti.
Dialogue: 0,0:12:34.23,0:12:36.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi mereka meninggalkan jejak
Dialogue: 0,0:12:36.53,0:12:39.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di jalan keluar lain untuk mengecoh pengejar.
Dialogue: 0,0:12:39.49,0:12:42.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya, silakan naik ke kereta.
Dialogue: 0,0:12:51.07,0:12:53.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini kawasan kumuh?
Dialogue: 0,0:12:53.83,0:12:55.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bangsawan tinggal di tempat seperti ini?
Dialogue: 0,0:12:55.67,0:12:57.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita sudah sampai.
Dialogue: 0,0:12:57.16,0:12:58.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serius?
Dialogue: 0,0:13:04.87,0:13:08.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini tempat perlindungan darurat\Nyang dibangun mendiang raja.
Dialogue: 0,0:13:08.56,0:13:10.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan Suarez tidak tahu soal ini.
Dialogue: 0,0:13:11.48,0:13:13.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jalan rahasia lainnya.
Dialogue: 0,0:13:16.40,0:13:18.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan membawa kalian\Nmenemui tuanku sekarang.
Dialogue: 0,0:13:18.94,0:13:22.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku tidak bisa membawa semua orang.
Dialogue: 0,0:13:22.66,0:13:23.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu, lalu...
Dialogue: 0,0:13:23.49,0:13:25.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan panggil aku "kamu".\NAku Fran.
Dialogue: 0,0:13:25.20,0:13:26.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran?
Dialogue: 0,0:13:28.12,0:13:29.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu cukup kuat, ya.
Dialogue: 0,0:13:30.54,0:13:32.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia punya skill Identifikasi.
Dialogue: 0,0:13:34.19,0:13:35.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menantikan penampilanmu.
Dialogue: 0,0:13:36.34,0:13:37.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu kamu.
Dialogue: 0,0:13:38.84,0:13:41.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ikut aku.\NSisanya, tunggu di sini.
Dialogue: 0,0:13:44.72,0:13:47.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku punya alasan menyelamatkan kalian.
Dialogue: 0,0:13:48.47,0:13:52.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau terus begini, Pangeran dan Putri Phyllius\Nakan berada dalam bahaya besar.
Dialogue: 0,0:13:52.44,0:13:53.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:14:00.30,0:14:03.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mbak, kami kembali.
Dialogue: 0,0:14:03.26,0:14:05.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Miriam, kamu selamat.
Dialogue: 0,0:14:05.99,0:14:09.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami menyelinap dalam kegelapan,
Dialogue: 0,0:14:09.21,0:14:10.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi kami tak dapat masalah.
Dialogue: 0,0:14:10.58,0:14:13.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu selalu merepotkan.
Dialogue: 0,0:14:13.37,0:14:16.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti saat kamu memprovokasi\Nanjing penjaga istana,
Dialogue: 0,0:14:16.13,0:14:19.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau saat kamu terlempar dari kuda liar.
Dialogue: 0,0:14:19.17,0:14:22.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mbak, itu cerita lama!
Dialogue: 0,0:14:22.63,0:14:24.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan dibahas lagi.
Dialogue: 0,0:14:24.18,0:14:26.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, aku keceplosan.
Dialogue: 0,0:14:26.76,0:14:29.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, semuanya.
Dialogue: 0,0:14:29.06,0:14:30.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.
Dialogue: 0,0:14:30.22,0:14:32.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran, dia seorang putri.
Dialogue: 0,0:14:33.77,0:14:35.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.
Dialogue: 0,0:14:35.31,0:14:38.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,\Nizinkan aku memperkenalkan diri.
Dialogue: 0,0:14:38.48,0:14:41.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Sellimea Vermilion Seedrun,
Dialogue: 0,0:14:41.86,0:14:43.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}putri pertama negara ini.
Dialogue: 0,0:14:43.86,0:14:46.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Fran, seorang petualang.
Dialogue: 0,0:14:46.49,0:14:48.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pengawal Flut dan Satya.
Dialogue: 0,0:14:48.87,0:14:52.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mbak, Fran sangat kuat.
Dialogue: 0,0:14:52.54,0:14:54.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mungkin lebih kuat dariku.
Dialogue: 0,0:14:54.54,0:14:58.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, masih muda, tapi sudah hebat, ya.
Dialogue: 0,0:14:58.68,0:15:03.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pedagang dari Asosiasi Dagang Lucille,\NKapten Rengill.
Dialogue: 0,0:15:03.34,0:15:05.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih atas kerja kerasmu.
Dialogue: 0,0:15:05.30,0:15:08.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar mereka berdua dalam bahaya.\NAku ingin segera menyelamatkan mereka.
Dialogue: 0,0:15:08.72,0:15:10.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu benar.
Dialogue: 0,0:15:10.87,0:15:14.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebelum kita mulai, tolong suruh mereka\Nyang menunggu di luar untuk masuk.
Dialogue: 0,0:15:14.23,0:15:15.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kara.
Dialogue: 0,0:15:15.52,0:15:16.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:15:19.69,0:15:24.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, berapa banyak yang kamu tahu\Ntentang situasi di negara ini?
Dialogue: 0,0:15:24.57,0:15:27.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Raja digantikan oleh orang bodoh\Ndan semua orang menderita.
Dialogue: 0,0:15:28.72,0:15:29.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sangat ringkas, ya.
Dialogue: 0,0:15:29.95,0:15:31.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa orang bodoh menjadi raja?
Dialogue: 0,0:15:31.99,0:15:35.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayangnya, Suarez kuat.
Dialogue: 0,0:15:35.41,0:15:37.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seseorang bisa menjadi raja\Nhanya karena dia kuat?
Dialogue: 0,0:15:39.25,0:15:43.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seedrun awalnya didirikan oleh bajak laut
Dialogue: 0,0:15:43.38,0:15:45.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang memakai negeri ini sebagai markas.
Dialogue: 0,0:15:46.47,0:15:48.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rakyatnya adalah keturunan bajak laut.
Dialogue: 0,0:15:48.55,0:15:52.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan sekarang,\Nnegara kami masih menghargai kekuatan.
Dialogue: 0,0:15:52.60,0:15:55.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, militer memiliki pengaruh besar.
Dialogue: 0,0:15:55.93,0:16:00.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suarez naik takhta karena dia\Ndapat dukungan dari banyak tentara.
Dialogue: 0,0:16:01.26,0:16:05.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suarez menyingkirkan mereka\Nyang menentangnya satu per satu.
Dialogue: 0,0:16:05.57,0:16:07.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia membebankan pajak besar pada rakyat,
Dialogue: 0,0:16:07.49,0:16:09.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}memotong anggaran yang menguntungkan rakyat,
Dialogue: 0,0:16:09.61,0:16:11.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan hanya fokus pada perluasan militer.
Dialogue: 0,0:16:11.37,0:16:13.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerajaan ini telah menjadi\Ntempat yang buruk.
Dialogue: 0,0:16:14.87,0:16:16.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari rangkum yang kita dengar sejauh ini.
Dialogue: 0,0:16:16.91,0:16:19.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, Miriam dan mbaknya, Sellimea,
Dialogue: 0,0:16:19.42,0:16:22.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu raja saat ini, Suarez,\Nadalah tiran yang kuat, tapi bodoh.
Dialogue: 0,0:16:22.59,0:16:27.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, mereka berdua menentang Suarez?
Dialogue: 0,0:16:27.59,0:16:28.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran?
Dialogue: 0,0:16:28.84,0:16:30.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini topik rumit.
Dialogue: 0,0:16:30.01,0:16:31.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu sudah tidak sanggup?
Dialogue: 0,0:16:31.60,0:16:34.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, saudara mendiang raja,
Dialogue: 0,0:16:34.14,0:16:36.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}paman mereka, Jenderal Julius,
Dialogue: 0,0:16:36.31,0:16:38.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}juga memihak Suarez.
Dialogue: 0,0:16:38.35,0:16:40.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Julius?
Dialogue: 0,0:16:40.35,0:16:43.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran, dokumen yang waktu itu.
Dialogue: 0,0:16:44.40,0:16:46.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian berdua, lihat ini.
Dialogue: 0,0:16:47.57,0:16:51.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menemukan ini di persembunyian\Npedagang budak ilegal Dars.
Dialogue: 0,0:16:52.41,0:16:55.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paman Julius dan Raja menerima suap\Ndari pedagang budak ilegal?
Dialogue: 0,0:16:55.87,0:16:59.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini kontrak dokumen untuk menjual\Npenduduk kumuh menjadi budak.
Dialogue: 0,0:16:59.75,0:17:04.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini rencana untuk mengirim mereka\Nke Kerajaan Raydoss.
Dialogue: 0,0:17:04.60,0:17:08.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Raydoss sering berhubungan\Ndengan saudaraku belakangan ini.
Dialogue: 0,0:17:09.43,0:17:12.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tujuan mereka kemungkinan\Nadalah Kapal Naga Air kami.
Dialogue: 0,0:17:12.92,0:17:14.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapal Naga Air?
Dialogue: 0,0:17:14.39,0:17:15.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu senjata rahasia negara kami.
Dialogue: 0,0:17:15.93,0:17:18.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya ada empat di dunia.
Dialogue: 0,0:17:19.84,0:17:21.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senjata rahasia?
Dialogue: 0,0:17:22.19,0:17:24.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesuai namanya,
Dialogue: 0,0:17:24.19,0:17:28.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}itu kapal tempur raksasa\Nyang ditarik Naga Air peringkat B.
Dialogue: 0,0:17:28.31,0:17:31.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka berlayar tiga kali lebih cepat\Ndaripada kapal biasa.
Dialogue: 0,0:17:31.29,0:17:35.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan kekuatan Naga Air, mereka bisa\Nmenenggelamkan kapal sekali serang.
Dialogue: 0,0:17:35.58,0:17:37.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Level ancaman B?
Dialogue: 0,0:17:37.20,0:17:40.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu monster yang mampu\Nmenghancurkan seluruh negeri.
Dialogue: 0,0:17:40.54,0:17:42.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, ada empat?
Dialogue: 0,0:17:42.33,0:17:44.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapal Naga Air.\NKeren!
Dialogue: 0,0:17:44.88,0:17:46.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, kan?
Dialogue: 0,0:17:46.67,0:17:49.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keempatnya diberikan pada Suarez,
Dialogue: 0,0:17:49.01,0:17:50.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Julius,
Dialogue: 0,0:17:50.26,0:17:51.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sepupu kami, Gladio,
Dialogue: 0,0:17:52.22,0:17:54.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan mbakku, Sellimea.
Dialogue: 0,0:17:54.64,0:17:56.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Naga Air masih kerabat generasi pertama.
Dialogue: 0,0:17:56.76,0:18:00.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya majikan mereka yang terdaftar\Nyang bisa mengendalikan mereka.
Dialogue: 0,0:18:00.35,0:18:03.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Warnate-ku...
Dialogue: 0,0:18:03.27,0:18:05.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa dia kesepian?
Dialogue: 0,0:18:05.06,0:18:10.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapal mbakku sudah berlabuh\Ndi pelabuhan pribadi istana.
Dialogue: 0,0:18:11.07,0:18:14.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kapal Sellimea\Nsaat ini tidak bisa digunakan?
Dialogue: 0,0:18:14.16,0:18:17.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, ini masalah utamanya.
Dialogue: 0,0:18:17.25,0:18:21.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saudaraku yang bodoh, Suarez,\Nberusaha beraliansi dengan Raydoss.
Dialogue: 0,0:18:21.75,0:18:23.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aliansi?
Dialogue: 0,0:18:23.17,0:18:28.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Raydoss tampaknya menuntut\Nkami menyerahkan Kapal Naga Air.
Dialogue: 0,0:18:28.17,0:18:32.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, saudaraku pun tidak bisa\Nmenerima permintaan itu.
Dialogue: 0,0:18:32.01,0:18:34.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat negosiasi terhenti,
Dialogue: 0,0:18:34.51,0:18:36.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}keluarga kerajaan Phyllius muncul.
Dialogue: 0,0:18:38.58,0:18:40.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski Phyllius kerajaan kecil,
Dialogue: 0,0:18:40.64,0:18:43.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mereka pernah melawan invasi Raydoss.
Dialogue: 0,0:18:44.96,0:18:47.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu berkat Pedang Suci\Nyang melindungi Phyllius,
Dialogue: 0,0:18:47.77,0:18:49.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kekuatan Diablos.
Dialogue: 0,0:18:49.48,0:18:51.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang Suci?
Dialogue: 0,0:18:51.76,0:18:53.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang apa itu?
Dialogue: 0,0:18:53.83,0:18:57.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Konon, keluarga kerajaan Phyllius\Nmembuat perjanjian dengan Pedang Suci
Dialogue: 0,0:18:57.37,0:19:00.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk mengendalikan kekuatan iblis.
Dialogue: 0,0:19:01.13,0:19:03.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iblis?\NHebat.
Dialogue: 0,0:19:04.62,0:19:07.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dia bisa menangkap musuh Raydoss,
Dialogue: 0,0:19:07.75,0:19:10.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mereka bisa dijadikan alat tawar\Nsebagai ganti Kapal Naga Air.
Dialogue: 0,0:19:11.63,0:19:15.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi itu sebabnya dia ingin\Nmenyerahkan mereka pada Raydoss?
Dialogue: 0,0:19:15.72,0:19:19.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Seedrun dan Raydoss bersekutu,
Dialogue: 0,0:19:19.07,0:19:21.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami hanya akan menjadi\Nnegara bawahan, koloni.
Dialogue: 0,0:19:21.97,0:19:25.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami harus menghentikan ini.
Dialogue: 0,0:19:26.31,0:19:29.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan kata lain, kepentingan kita sama.
Dialogue: 0,0:19:30.01,0:19:30.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran.
Dialogue: 0,0:19:30.98,0:19:35.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin kamu membantu kami\Nmenyelamatkan keluarga kerajaan Phyllius.
Dialogue: 0,0:19:35.47,0:19:37.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja, aku akan membantu.
Dialogue: 0,0:19:37.23,0:19:39.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pengawal Flut dan Satya.
Dialogue: 0,0:19:40.20,0:19:41.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:19:41.41,0:19:45.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, kami sudah menghubungi\Npelayan mereka, Tuan Salut.
Dialogue: 0,0:19:46.58,0:19:48.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paman Kesatria Kegelapan itu?
Dialogue: 0,0:19:48.29,0:19:50.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akan bergerak besok malam.
Dialogue: 0,0:19:50.40,0:19:53.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akan menyusup ke istana\Ntempat pangeran dan putri ditahan
Dialogue: 0,0:19:53.09,0:19:54.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan menyelamatkan mereka.
Dialogue: 0,0:20:02.10,0:20:04.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Skill yang diintegrasikan Announcer...\N- Fran kalah lagi!
Dialogue: 0,0:20:04.43,0:20:06.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kamu terlalu lemah, Fran.\N- Sebaiknya kita latihan selagi bisa.
Dialogue: 0,0:20:06.81,0:20:08.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Sekali lagi!\N- Sebaiknya kita latihan selagi bisa.
Dialogue: 0,0:20:08.27,0:20:12.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama, skill gabungan\Ntipe angin: Angin Gila.
Dialogue: 0,0:20:17.15,0:20:18.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Udara Terkompresi.
Dialogue: 0,0:20:19.53,0:20:20.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:20:20.70,0:20:21.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat!
Dialogue: 0,0:20:22.95,0:20:24.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kalau aku bisa menguasai ini,\N- Nah, Fran kalah.
Dialogue: 0,0:20:24.37,0:20:26.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- konsumsi mana akan berkurang.\N- Kamu harus berpikir.
Dialogue: 0,0:20:26.54,0:20:28.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Aku merasa itu akan berguna.\N- Ini terlalu sulit.
Dialogue: 0,0:20:31.46,0:20:34.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kara, Bike, bagaimana perkembangannya?
Dialogue: 0,0:20:34.88,0:20:38.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesuai rencana, pasukan pengalihan\Nakan menyerang pelabuhan laut.
Dialogue: 0,0:20:38.81,0:20:41.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para tentara akan ditarik ke sana\Ndan ke istana utama.
Dialogue: 0,0:20:41.80,0:20:45.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akan gunakan kesempatan itu\Nuntuk bertemu pangeran dan putri di istana
Dialogue: 0,0:20:45.39,0:20:46.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan melarikan diri.
Dialogue: 0,0:20:46.93,0:20:50.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak buah Tuan Salut harusnya\Nsudah tiba sekarang.
Dialogue: 0,0:20:51.48,0:20:53.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf menunggu.
Dialogue: 0,0:20:53.15,0:20:54.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Yos dari Phyllius.
Dialogue: 0,0:20:55.65,0:20:58.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan membawamu menemui Tuan Salut.
Dialogue: 0,0:20:58.03,0:21:01.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran, kamu baik-baik saja?
Dialogue: 0,0:21:02.32,0:21:04.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sama sekali tidak mengingatmu.
Dialogue: 0,0:21:04.70,0:21:06.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan jatuh!
Dialogue: 0,0:21:06.50,0:21:07.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Licin!
Dialogue: 0,0:21:11.36,0:21:13.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf sudah merepotkanmu.
Dialogue: 0,0:21:13.75,0:21:15.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.\NSudah kuduga akan begini.
Dialogue: 0,0:21:15.88,0:21:17.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bilang begitu!
Dialogue: 0,0:21:17.98,0:21:20.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu Tuan Salut?
Dialogue: 0,0:21:20.09,0:21:21.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih atas bantuanmu.
Dialogue: 0,0:21:21.76,0:21:23.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pasti Nona Miriam, ya?
Dialogue: 0,0:21:23.39,0:21:25.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti yang kusebutkan sebelumnya,
Dialogue: 0,0:21:25.35,0:21:27.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kedua Yang Mulia tidak dipenjara,
Dialogue: 0,0:21:27.35,0:21:29.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi mereka menjadi tahanan rumah.
Dialogue: 0,0:21:31.13,0:21:32.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mengalahkan mereka?
Dialogue: 0,0:21:32.90,0:21:35.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pakai Sihir Kegelapan\Nuntuk menidurkan mereka.
Dialogue: 0,0:21:35.57,0:21:37.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami sudah sangat merepotkanmu.
Dialogue: 0,0:21:37.90,0:21:39.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sisanya serahkan pada kami!
Dialogue: 0,0:21:41.64,0:21:42.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran!
Dialogue: 0,0:21:42.66,0:21:44.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yos, mundur!
Dialogue: 0,0:21:45.37,0:21:46.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada siapa pun—
Dialogue: 0,0:21:49.04,0:21:50.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yos!
Dialogue: 0,0:21:51.19,0:21:53.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mendeteksi kehadiran tersembunyi, ya?
Dialogue: 0,0:21:54.71,0:21:56.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia muncul juga!
Dialogue: 0,0:21:56.56,0:21:57.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia...
Dialogue: 0,0:21:58.38,0:22:00.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Valuza Taring Hitam.
Dialogue: 0,0:22:00.97,0:22:02.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bertemu lagi.
