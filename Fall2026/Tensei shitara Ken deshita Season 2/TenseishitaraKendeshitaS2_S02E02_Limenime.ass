Dialogue: 0,0:01:51.34,0:01:53.76,sign,,0000,0000,0000,,TENSEI SHITARA KEN DESHITA SEASON 2
Dialogue: 0,0:03:04.96,0:03:09.96,sign,,0000,0000,0000,,EPISODE 2: JEAN DU VIX MEMANG HEBAT
Dialogue: 0,0:04:00.47,0:04:02.47,sign,,0000,0000,0000,,DUNGEON PULAU MELAYANG\NLANTAI 1 BAWAH TANAH
Dialogue: 0,0:04:20.52,0:04:25.06,sign,,0000,0000,0000,,ARWAH MIMIK, TINGKAT ANCAMAN: E
Dialogue: 0,0:04:25.06,0:04:29.37,sign,,0000,0000,0000,,ARWAH PENYAMAR, TINGKAT ANCAMAN: D
Dialogue: 0,0:04:38.17,0:04:39.01,sign,,0000,0000,0000,,PENGHALANG, TUBUH ASLI
Dialogue: 0,0:04:39.01,0:04:39.77,sign,,0000,0000,0000,,NAMA: FRAN, RAS KUCING HITAM, LEVEL: KUAT
Dialogue: 0,0:04:39.77,0:04:41.23,sign,,0000,0000,0000,,PERLENGKAPAN: MASTER, SKILL: BANYAK YANG KUAT
Dialogue: 0,0:04:41.23,0:04:42.32,sign,,0000,0000,0000,,PERINGATAN, PEMALSU, PALSU
Dialogue: 0,0:04:42.32,0:04:43.28,sign,,0000,0000,0000,,NAMA: MOFUMOFU, RAS BULU HALUS
Dialogue: 0,0:04:43.28,0:04:46.90,sign,,0000,0000,0000,,LEVEL: LEMAH, PERLENGKAPAN: GADA, DAUN
Dialogue: 0,0:04:46.90,0:04:48.68,sign,,0000,0000,0000,,SKILL: SUKA KARI, LENGAH
Dialogue: 0,0:05:37.82,0:05:38.96,sign,,0000,0000,0000,,SELKAN, UNDEAD MODIFIKASI, RAS: MONSTER, UNDEAD
Dialogue: 0,0:05:38.96,0:05:41.45,sign,,0000,0000,0000,,STATUS: KONTRAK, LEVEL 14
Dialogue: 0,0:06:20.05,0:06:22.24,sign,,0000,0000,0000,,PENJAGA LANTAI 1, ULAR UNDEAD
Dialogue: 0,0:06:56.40,0:06:57.84,sign,,0000,0000,0000,,KERONCONGAN
Dialogue: 0,0:07:48.82,0:07:50.83,sign,,0000,0000,0000,,DUNGEON PULAU MELAYANG\NLANTAI 2 BAWAH TANAH
Dialogue: 0,0:10:43.46,0:10:45.04,sign,,0000,0000,0000,,FRY, RAS: MONSTER, UNDEAD\NSTATUS: KONTRAK, LEVEL: 7
Dialogue: 0,0:11:22.56,0:11:23.66,sign,,0000,0000,0000,,PENJAGA LANTAI 2, OGRE ZOMBI
Dialogue: 0,0:11:54.80,0:11:57.36,sign,,0000,0000,0000,,MEMPEROLEH SKILL: BERUBAH BENTUK
Dialogue: 0,0:12:16.88,0:12:18.16,sign,,0000,0000,0000,,DUNGEON PULAU MELAYANG
Dialogue: 0,0:12:18.16,0:12:19.89,sign,,0000,0000,0000,,LANTAI 3 BAWAH TANAH
Dialogue: 0,0:13:49.58,0:13:55.61,sign,,0000,0000,0000,,TUAN
Dialogue: 0,0:15:22.86,0:15:24.86,sign,,0000,0000,0000,,DUNGEON PULAU MELAYANG\NLANTAI 4 BAWAH TANAH
Dialogue: 0,0:15:32.74,0:15:36.25,sign,,0000,0000,0000,,DUNGEON PULAU MELAYANG, LANTAI 5 BAWAH TANAH
Dialogue: 0,0:15:56.52,0:15:58.52,sign,,0000,0000,0000,,DUNGEON PULAU MELAYANG\NLANTAI 6 BAWAH TANAH
Dialogue: 0,0:16:13.66,0:16:14.27,sign,,0000,0000,0000,,DUNGEON PULAU MELAYANG
Dialogue: 0,0:16:14.27,0:16:15.66,sign,,0000,0000,0000,,LANTAI 7 BAWAH TANAH
Dialogue: 0,0:16:48.99,0:16:50.27,sign,,0000,0000,0000,,DUNGEON PULAU MELAYANG
Dialogue: 0,0:16:50.27,0:16:51.49,sign,,0000,0000,0000,,LANTAI 8 BAWAH TANAH
Dialogue: 0,0:18:17.66,0:18:20.33,sign,,0000,0000,0000,,PENJAGA LANTAI 8\NZOMBI PURBA, PENOMBAK AGUNG
Dialogue: 0,0:21:24.51,0:21:25.94,sign,,0000,0000,0000,,DUNGEON PULAU MELAYANG
Dialogue: 0,0:21:25.94,0:21:27.02,sign,,0000,0000,0000,,LANTAI 9 BAWAH TANAH, BAGIAN TERDALAM
Dialogue: 0,0:23:33.93,0:23:43.44,sign,,0000,0000,0000,,SELANJUTNYA:\NUNDEAD-NYA KERAS GILA
Dialogue: 0,0:00:13.08,0:00:16.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di tempat ini isinya undead semua, ya!
Dialogue: 0,0:00:16.07,0:00:17.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di depan sana ada dungeon.
Dialogue: 0,0:00:18.82,0:00:25.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jean, kami tak keberatan diberi imbalan sedikit\Nasal dapat Batu Sihir dari monster.
Dialogue: 0,0:00:26.19,0:00:28.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan masalah,\Ntapi mau dipakai untuk apa?
Dialogue: 0,0:00:28.67,0:00:30.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, begini...
Dialogue: 0,0:00:30.75,0:00:32.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mata Jiwa!
Dialogue: 0,0:00:32.14,0:00:34.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Batu Sihir... ini, ya?
Dialogue: 0,0:00:34.98,0:00:35.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:00:36.46,0:00:40.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu jadi lebih kuat\Nkarena menyerap Batu Sihir, ya?
Dialogue: 0,0:00:40.43,0:00:44.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar, skill unik Mata Jiwa-nya\Nmerepotkan, ya.
Dialogue: 0,0:00:44.26,0:00:44.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:00:44.86,0:00:49.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, aku belum pernah dengar\Nnilai kekuatan Batu Sihir.
Dialogue: 0,0:00:50.54,0:00:53.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan, kamu bisa dapat skill\Nsetelah memakainya?
Dialogue: 0,0:00:53.32,0:00:54.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:00:54.85,0:00:56.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tebakanku benar, ya?
Dialogue: 0,0:00:58.14,0:00:59.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memang hebat!
Dialogue: 0,0:00:59.79,0:01:02.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kaget.\NKenapa kamu bisa tahu?
Dialogue: 0,0:01:02.33,0:01:05.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya skill kalian agak janggal.
Dialogue: 0,0:01:05.41,0:01:08.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian punya skill yang harusnya\Ncuma dimiliki monster.
Dialogue: 0,0:01:08.72,0:01:11.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mata Jiwa ternyata skill yang seram.
Dialogue: 0,0:01:11.01,0:01:17.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya, di dungeon itu ada monster\Nyang skill-nya bisa menipu Mata Jiwa-ku.
Dialogue: 0,0:01:17.10,0:01:19.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa, serius?\NSkill apa itu?
Dialogue: 0,0:01:19.47,0:01:21.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, aku mau skill itu!
Dialogue: 0,0:01:21.98,0:01:25.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bisa bahas itu nanti.\NNah, kita sudah sampai!
Dialogue: 0,0:01:26.42,0:01:31.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saatnya masuk dan menjelajah\Nke dungeon Pulau Melayang!
Dialogue: 0,0:03:04.96,0:03:08.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hawa dendam ini... jadi nostalgia.
Dialogue: 0,0:03:08.90,0:03:09.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dendam?
Dialogue: 0,0:03:09.96,0:03:13.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hasrat seperti "Aku tak mau mati"\Natau "Aku tak boleh mati".
Dialogue: 0,0:03:13.92,0:03:16.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dendam yang menyatu dengan Batu Sihir\Nakan mengubahnya
Dialogue: 0,0:03:16.60,0:03:19.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menjadi undead arwah pendendam yang kuat.
Dialogue: 0,0:03:20.61,0:03:22.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama seperti Andy.
Dialogue: 0,0:03:22.96,0:03:24.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Andy juga?
Dialogue: 0,0:03:24.35,0:03:27.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami para necromancer\Nmampu mengendalikan kekuatan itu
Dialogue: 0,0:03:27.78,0:03:30.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan menyucikannya\Ndengan menyentuh jiwa mereka.
Dialogue: 0,0:03:30.69,0:03:35.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagi arwah penasaran yang menyimpan dendam,\Nitu bisa disebut sebagai penyelamatan.
Dialogue: 0,0:03:36.18,0:03:37.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:03:37.89,0:03:40.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagi aku pun, tempat ini sudah janggal.
Dialogue: 0,0:03:40.59,0:03:46.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa merasakan dendam pedih\Nyang tak mungkin ada di dungeon biasa.
Dialogue: 0,0:03:46.16,0:03:51.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Intinya ini tempat berbahaya, ya?\NApa ada yang harus kita waspadai?
Dialogue: 0,0:03:51.09,0:03:53.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar aku yang memandu\Ndan menghindari jebakan.
Dialogue: 0,0:03:53.86,0:03:56.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian fokus saja bertarung.
Dialogue: 0,0:03:57.49,0:03:58.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dimengerti.
Dialogue: 0,0:04:03.23,0:04:07.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jean, skill yang bisa menipu Mata Jiwa-mu\Nyang tadi kamu bahas itu apa?
Dialogue: 0,0:04:07.98,0:04:13.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di lantai 2 bawah tanah, ada monster arwah\Ndengan skill Pengganggu Identifikasi
Dialogue: 0,0:04:13.31,0:04:14.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bernama Arwah Mimik.
Dialogue: 0,0:04:14.73,0:04:18.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengganggu Identifikasi?\NKalau aku punya Penghalang Identifikasi.
Dialogue: 0,0:04:18.85,0:04:20.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah, dengarkan dulu.
Dialogue: 0,0:04:20.52,0:04:22.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di antara mereka, ada jenis langka tingkat tinggi
Dialogue: 0,0:04:22.73,0:04:25.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bernama Arwah Penyamar.
Dialogue: 0,0:04:25.06,0:04:27.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka punya skill unik
Dialogue: 0,0:04:27.11,0:04:29.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bernama Pemalsu Identifikasi.
Dialogue: 0,0:04:29.37,0:04:35.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skill itu bukan untuk mencegah identifikasi,\Ntapi menampilkan informasi palsu sesuka mereka.
Dialogue: 0,0:04:35.46,0:04:38.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi itu bisa membuat musuh lengah, ya?
Dialogue: 0,0:04:38.17,0:04:41.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau digabung dengan Penangkal Identifikasi,
Dialogue: 0,0:04:41.23,0:04:43.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}selain menangkalnya dengan sempurna,
Dialogue: 0,0:04:43.28,0:04:46.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}musuh pun percaya pada informasi palsu itu.
Dialogue: 0,0:04:46.90,0:04:48.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, hebat!
Dialogue: 0,0:04:48.68,0:04:51.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, apa itu berpengaruh juga ke Mata Jiwa?
Dialogue: 0,0:04:51.60,0:04:54.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berpengaruh.
Dialogue: 0,0:04:54.01,0:04:56.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya akan berpengaruh juga\Nke mata mistis lainnya.
Dialogue: 0,0:04:56.90,0:04:59.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau Pemalsu Identifikasi!
Dialogue: 0,0:04:59.26,0:05:01.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, kita harus dapat!
Dialogue: 0,0:05:01.41,0:05:02.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian jadi antusias, ya?
Dialogue: 0,0:05:02.91,0:05:03.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:05:03.98,0:05:05.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo cepat pergi!
Dialogue: 0,0:05:06.77,0:05:08.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, tunggu dulu!
Dialogue: 0,0:05:08.83,0:05:10.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat.
Dialogue: 0,0:05:11.42,0:05:14.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai dari area ini,\Nada banyak jebakan yang dipasang.
Dialogue: 0,0:05:14.99,0:05:16.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sangat klise.
Dialogue: 0,0:05:17.28,0:05:20.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran, tolong ambilkan\NBola Pemanggil #1 dari penyimpanan.
Dialogue: 0,0:05:20.93,0:05:24.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, yang dititipkan\Ndi penyimpanan dimensi waktu itu, ya?
Dialogue: 0,0:05:27.06,0:05:30.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Instant Summon: High Undead!
Dialogue: 0,0:05:31.44,0:05:34.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namanya Selkan!
Dialogue: 0,0:05:34.66,0:05:37.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi hari ini, aku terus mengembangkannya
Dialogue: 0,0:05:37.82,0:05:38.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan sihir undead khusus.
Dialogue: 0,0:05:38.96,0:05:41.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pelayan istimewaku.
Dialogue: 0,0:05:42.43,0:05:44.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pergi, Selkan!
Dialogue: 0,0:05:45.89,0:05:48.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, dia punya skill penjinak jebakan.
Dialogue: 0,0:05:49.45,0:05:50.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oi, oi.
Dialogue: 0,0:05:50.61,0:05:53.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia akan menjadi tameng\Nkalau jebakannya tak bisa dia jinakan.
Dialogue: 0,0:05:53.58,0:05:55.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu dia akan regenerasi seketika.
Dialogue: 0,0:05:57.09,0:06:00.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serius? Itu sangat hebat!
Dialogue: 0,0:06:01.39,0:06:03.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengesankan, Selkan!
Dialogue: 0,0:06:08.69,0:06:12.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau penjaga di dalam dikalahkan,\Nkita akan sampai di lantai 2 bawah tanah.
Dialogue: 0,0:06:12.58,0:06:13.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penjaga.
Dialogue: 0,0:06:13.92,0:06:15.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ruangan bos menengah, ya.
Dialogue: 0,0:06:15.48,0:06:20.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selkan akan fokus mengatasi jebakan,\Ndia sama sekali tak bisa bertarung.
Dialogue: 0,0:06:20.05,0:06:22.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, serahkan sisanya pada kami.
Dialogue: 0,0:06:22.24,0:06:23.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Urushi.
Dialogue: 0,0:06:24.56,0:06:26.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, ayo!
Dialogue: 0,0:06:26.07,0:06:29.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Api: Fire Javelin!
Dialogue: 0,0:06:29.16,0:06:30.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga ikut bantu.
Dialogue: 0,0:06:30.66,0:06:33.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Nekromansi: Hell Storm!
Dialogue: 0,0:06:36.86,0:06:39.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tri-Explosion!
Dialogue: 0,0:06:47.98,0:06:48.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus.
Dialogue: 0,0:06:49.57,0:06:51.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengesankan.
Dialogue: 0,0:06:51.07,0:06:52.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, menang mudah.
Dialogue: 0,0:06:53.95,0:06:56.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak apa-apa makan daging zombi?
Dialogue: 0,0:06:57.84,0:06:59.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku lapar.
Dialogue: 0,0:06:59.66,0:07:01.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar Urushi.
Dialogue: 0,0:07:02.24,0:07:05.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini ada kari spesial penuh\Ndengan sayuran buatanku!
Dialogue: 0,0:07:05.66,0:07:08.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makan sayurnya yang banyak juga, ya!
Dialogue: 0,0:07:08.13,0:07:11.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makan kari di dungeon memang terbaik.
Dialogue: 0,0:07:11.58,0:07:14.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, aromanya unik, ya.
Dialogue: 0,0:07:14.78,0:07:15.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu juga mau?
Dialogue: 0,0:07:15.76,0:07:17.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh?
Dialogue: 0,0:07:23.17,0:07:27.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, ini membuat nafsu makan naik!\NKari, ya? Ini sangat lezat!
Dialogue: 0,0:07:27.84,0:07:31.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, kari buatan Master itu terbaik,\Nnomor satu sedunia!
Dialogue: 0,0:07:31.83,0:07:33.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tambah lagi!
Dialogue: 0,0:07:33.14,0:07:35.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiga kali tambah.\NJean, kamu kebanyakan makan.
Dialogue: 0,0:07:35.66,0:07:37.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tambah lagi!
Dialogue: 0,0:07:37.06,0:07:40.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sendiri sudah lima kali tambah.
Dialogue: 0,0:07:40.82,0:07:42.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sendokku tak bisa berhenti!
Dialogue: 0,0:07:42.57,0:07:45.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jean, kamu tidak boleh tambah lagi.
Dialogue: 0,0:07:45.10,0:07:46.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:07:46.20,0:07:48.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah, masih ada banyak.
Dialogue: 0,0:07:51.49,0:07:53.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Areanya di sekitar sini.
Dialogue: 0,0:07:53.78,0:07:56.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, itu Arwah Mimik, ya?
Dialogue: 0,0:07:56.93,0:07:59.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di antara mereka ada jenis langka\NArwah Penyamar.
Dialogue: 0,0:07:59.76,0:08:04.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kemungkinan besar statusnya terlihat sama\Nseperti jenis biasa karena Pemalsu Identifikasi.
Dialogue: 0,0:08:04.94,0:08:09.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, kita tak akan tahu\Nsebelum menebasnya, ya?
Dialogue: 0,0:08:09.14,0:08:11.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, aku paham sekarang.
Dialogue: 0,0:08:11.18,0:08:13.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang Elemen: Api!
Dialogue: 0,0:08:13.25,0:08:16.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tebas, tebas, dan tebas semuanya!
Dialogue: 0,0:08:19.60,0:08:22.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}10 September 3616.
Dialogue: 0,0:08:22.90,0:08:27.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tangan kananku ditebas dan untuk sementara\Naku tak bisa menulis kalimat panjang.
Dialogue: 0,0:08:27.11,0:08:30.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin karena belum terbiasa,\Ntulisannya sangat jelek.
Dialogue: 0,0:08:30.26,0:08:33.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, mungkin tak akan ada orang\Nyang membacanya.
Dialogue: 0,0:08:34.99,0:08:38.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}11 September 3616.
Dialogue: 0,0:08:38.50,0:08:41.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah ini perasaanku saja\Natau jumlah anak-anak berkurang.
Dialogue: 0,0:08:41.22,0:08:45.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku bisa bertemu kembali\Ndengan dua orang itu.
Dialogue: 0,0:08:45.58,0:08:47.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mata kanan laki-laki itu dihancurkan,
Dialogue: 0,0:08:47.76,0:08:51.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan tubuh gadis itu penuh dengan luka.
Dialogue: 0,0:08:52.08,0:08:53.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak akan kumaafkan.
Dialogue: 0,0:08:53.60,0:08:56.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya kami salah apa?
Dialogue: 0,0:08:57.47,0:09:01.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}17 September 3616.
Dialogue: 0,0:09:01.85,0:09:06.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini sangat tenang.\NApa tidak ada eksperimen?
Dialogue: 0,0:09:06.36,0:09:10.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, aku ingin bertemu\Ndengan gadis dan laki-laki itu.
Dialogue: 0,0:09:11.36,0:09:12.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}18 September.
Dialogue: 0,0:09:13.59,0:09:17.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah eksperimen, untuk memastikan\Nseberapa cepat regenerasinya,
Dialogue: 0,0:09:17.87,0:09:20.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kedua kakiku dipotong.
Dialogue: 0,0:09:20.50,0:09:26.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya tempat ini adalah fasilitas eksperimen\Nuntuk mengubah manusia hidup jadi undead.
Dialogue: 0,0:09:26.77,0:09:28.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}20 September.
Dialogue: 0,0:09:28.77,0:09:32.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar rasa dendam akan disuntikkan\Nke tubuhku selagi aku masih hidup.
Dialogue: 0,0:09:33.26,0:09:36.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin ini dendam dari anak-anak\Nyang mati di fasilitas ini.
Dialogue: 0,0:09:37.44,0:09:42.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini pasti mengandung kebencian\N"mereka" yang sudah tiada.
Dialogue: 0,0:09:43.30,0:09:47.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, sebentar lagi kesadaranku akan hilang.
Dialogue: 0,0:09:53.41,0:09:57.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini, aku berhenti menjadi manusia.
Dialogue: 0,0:10:02.64,0:10:04.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini dia!
Dialogue: 0,0:10:04.04,0:10:06.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita dapat Pemalsu Identifikasi!
Dialogue: 0,0:10:06.43,0:10:07.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dapat!
Dialogue: 0,0:10:07.92,0:10:10.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, lebih cepat dari perkiraan, ya.
Dialogue: 0,0:10:11.22,0:10:12.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasang Pemalsu Identifikasi!
Dialogue: 0,0:10:12.88,0:10:15.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jean, coba lihat dengan Mata Jiwa-mu!
Dialogue: 0,0:10:17.49,0:10:20.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlihat tidak punya skill\Ndan statusnya juga rendah.
Dialogue: 0,0:10:20.14,0:10:21.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mantap!
Dialogue: 0,0:10:21.65,0:10:25.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi tidak punya skill sama sekali\Nterlalu mencurigakan.
Dialogue: 0,0:10:25.02,0:10:27.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atur lagi agar terlihat wajar.
Dialogue: 0,0:10:27.60,0:10:29.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu! Baiklah!
Dialogue: 0,0:10:29.94,0:10:32.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita sudah tak ada urusan lagi\Ndi lantai 2 ini.
Dialogue: 0,0:10:32.45,0:10:34.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran, tolong ambil Bola Pemanggil #2.
Dialogue: 0,0:10:34.93,0:10:35.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap!
Dialogue: 0,0:10:35.78,0:10:39.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Instant Summon: High Undead!
Dialogue: 0,0:10:39.26,0:10:41.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Muncullah, Fry!
Dialogue: 0,0:10:45.79,0:10:47.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, dia bertambah.
Dialogue: 0,0:10:47.30,0:10:48.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia monster undead
Dialogue: 0,0:10:48.46,0:10:52.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang kuberi skill untuk melakukan\Npemetaan otomatis.
Dialogue: 0,0:10:52.46,0:10:57.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Informasi peta yang dia pindai\Nakan terus dikirim ke otak kelabuku.
Dialogue: 0,0:10:57.28,0:10:58.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudmu pembuat peta, ya?
Dialogue: 0,0:10:58.93,0:11:01.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Undead praktis juga, ya.
Dialogue: 0,0:11:01.49,0:11:06.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan adanya Fry dan Selkan, menjelajah\Ndungeon jadi lancar tanpa kendala!
Dialogue: 0,0:11:06.88,0:11:09.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, hebat, kamu sangat pintar.
Dialogue: 0,0:11:10.46,0:11:12.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu boleh puji aku terus!
Dialogue: 0,0:11:15.07,0:11:18.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan begitu, Fry dan Selkan jalan duluan...
Dialogue: 0,0:11:20.16,0:11:22.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanpa kena jebakan atau tersesat,\Nkami berhasil
Dialogue: 0,0:11:22.56,0:11:25.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menaklukkan dungeon yang rumit
Dialogue: 0,0:11:25.66,0:11:27.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- dan berliku ini dengan lancar.\N- Flare Blast!
Dialogue: 0,0:11:33.17,0:11:37.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Batu Sihir telah terisi penuh,\Nefek Evolusi Diri aktif.
Dialogue: 0,0:11:37.33,0:11:39.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, Announcer.
Dialogue: 0,0:11:39.51,0:11:42.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mendapatkan 50 Poin Evolusi Diri.
Dialogue: 0,0:11:42.70,0:11:44.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya Evolusi Diri lagi\Nsetelah sekian lama!
Dialogue: 0,0:11:44.89,0:11:47.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Evolusi Diri, apa maksudnya itu?
Dialogue: 0,0:11:47.57,0:11:51.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, semacam naik level versi unikku.
Dialogue: 0,0:11:53.36,0:11:54.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mendapatkan skill baru:
Dialogue: 0,0:11:54.80,0:11:57.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berubah Bentuk melalui Evolusi Diri.
Dialogue: 0,0:11:58.16,0:11:59.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skill baru, ya.
Dialogue: 0,0:11:59.62,0:12:04.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berubah Bentuk: mengonsumsi mana\Nuntuk berubah bentuk sesuai keinginan.
Dialogue: 0,0:12:04.19,0:12:06.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi massanya tidak berubah.
Dialogue: 0,0:12:06.45,0:12:08.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, Master bentuk palu.
Dialogue: 0,0:12:09.38,0:12:12.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya jangan berubah bentuk jadi ini.\NKonsumsi mana-nya terlalu besar.
Dialogue: 0,0:12:12.69,0:12:15.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agak lumayan sulit\Nkalau dipakai terus menerus.
Dialogue: 0,0:12:18.16,0:12:19.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini aneh.
Dialogue: 0,0:12:21.02,0:12:22.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:12:22.86,0:12:25.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hawa undead di sekitar sini sedikit.
Dialogue: 0,0:12:25.14,0:12:27.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, ada bangkai\Nyang bukan kita kalahkan.
Dialogue: 0,0:12:28.08,0:12:33.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa mereka saling bunuh?\NTidak, tunggu dulu, jangan-jangan ini...
Dialogue: 0,0:12:33.15,0:12:35.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, mungkin dia dalangnya.
Dialogue: 0,0:12:35.78,0:12:37.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia?
Dialogue: 0,0:12:39.15,0:12:40.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang kemari.
Dialogue: 0,0:12:48.24,0:12:49.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketemu!
Dialogue: 0,0:12:49.92,0:12:52.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oi, Jean, apa dia yang kamu maksud?
Dialogue: 0,0:12:55.30,0:12:57.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemangsa Mayat.
Dialogue: 0,0:13:00.93,0:13:03.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketemu! Ketemu!
Dialogue: 0,0:13:03.93,0:13:05.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Identifikasi!
Dialogue: 0,0:13:07.44,0:13:09.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penghalang Identifikasi?
Dialogue: 0,0:13:10.23,0:13:11.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mendekat!
Dialogue: 0,0:13:12.48,0:13:13.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, Fran!
Dialogue: 0,0:13:14.86,0:13:15.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia menghindar?
Dialogue: 0,0:13:15.86,0:13:17.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat! Jean!
Dialogue: 0,0:13:17.36,0:13:18.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Urushi!
Dialogue: 0,0:13:21.16,0:13:25.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan, akhirnya kita bisa bertemu!
Dialogue: 0,0:13:27.63,0:13:31.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemangsa Mayat...\NBukan, apa kamu Stefan?
Dialogue: 0,0:13:31.60,0:13:35.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar!\NAku pelayanmu, Stefan!
Dialogue: 0,0:13:35.86,0:13:37.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Stefan?
Dialogue: 0,0:13:37.38,0:13:38.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa?
Dialogue: 0,0:13:39.12,0:13:43.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia peliharaan yang kusematkan saat lari\Ndari Pemangsa Mayat saat itu.
Dialogue: 0,0:13:43.97,0:13:45.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga, kamu pernah cerita itu.
Dialogue: 0,0:13:45.84,0:13:47.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belum pernah dengar.
Dialogue: 0,0:13:47.02,0:13:48.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya waktu itu kamu tidur.
Dialogue: 0,0:13:49.58,0:13:53.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Stefan kuberikan skill Imun Arwah, Imun Serap
Dialogue: 0,0:13:53.29,0:13:56.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan Fusi Erosi.
Dialogue: 0,0:13:56.48,0:13:59.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rencananya kubiarkan dia\Ndimakan Pemangsa Mayat
Dialogue: 0,0:13:59.89,0:14:02.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu bertahan dengan Imun Serap\Ndan mengerosinya dari dalam...
Dialogue: 0,0:14:02.61,0:14:05.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi sepertinya rencana itu gagal.
Dialogue: 0,0:14:05.04,0:14:07.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah berusaha keras bertahun-tahun!
Dialogue: 0,0:14:07.70,0:14:12.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan tuanmu yang tak berguna ini.\NKerja bagus, Stefan!
Dialogue: 0,0:14:12.19,0:14:13.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:14:13.84,0:14:19.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, seingatku Pemangsa Mayat itu raksasa.\NKenapa sekarang jadi kecil?
Dialogue: 0,0:14:19.55,0:14:24.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, sepertinya tubuh ini\Nbisa berubah bentuk.
Dialogue: 0,0:14:24.05,0:14:26.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena awalnya terlalu besar\Ndan sulit dikendalikan,
Dialogue: 0,0:14:26.82,0:14:30.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku mencoba menyesuaikannya\Ndengan kesadaran...
Dialogue: 0,0:14:30.54,0:14:32.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau kenangan...
Dialogue: 0,0:14:32.98,0:14:35.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang masih tersisa di tubuh ini.
Dialogue: 0,0:14:35.98,0:14:38.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong...
Dialogue: 0,0:14:39.98,0:14:45.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lama tidak melihat Tuan,\Ntapi tetap terlihat sangat keren!
Dialogue: 0,0:14:45.84,0:14:47.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sampai terpesona.
Dialogue: 0,0:14:47.99,0:14:49.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}O-Oh...
Dialogue: 0,0:14:49.99,0:14:53.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, kamu paham, ya?\NItu memang benar!
Dialogue: 0,0:14:53.92,0:14:58.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar ahli necromancer!\NTuan sangat hebat!
Dialogue: 0,0:14:58.21,0:15:00.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya kita berdua diabaikan, ya.
Dialogue: 0,0:15:01.02,0:15:05.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, apa kamu utusan baru Tuan?
Dialogue: 0,0:15:05.79,0:15:07.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan.
Dialogue: 0,0:15:08.85,0:15:14.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku! Ternyata kamu petualang\Nyang sedang membantunya.
Dialogue: 0,0:15:14.05,0:15:18.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, aku Fran.\NPedang ini Master dan yang ini Urushi.
Dialogue: 0,0:15:20.02,0:15:21.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Stefan.
Dialogue: 0,0:15:21.38,0:15:22.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salam kenal, ya.
Dialogue: 0,0:15:25.41,0:15:27.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan bergabungnya Stefan ke tim,
Dialogue: 0,0:15:27.46,0:15:32.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami menaklukkan dungeon dengan kecepatan\Nyang lebih tinggi dari sebelumnya.
Dialogue: 0,0:15:32.74,0:15:36.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku keluyuran bertahun-tahun membawa hasil.
Dialogue: 0,0:15:36.25,0:15:38.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan tugas memandu padaku.
Dialogue: 0,0:15:39.33,0:15:42.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sini sebentar lagi runtuh,\Njadi kita harus memutar.
Dialogue: 0,0:15:42.28,0:15:45.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Stefan sudah tahu semua jalan pintas
Dialogue: 0,0:15:45.31,0:15:48.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan cara melewati tempat sulit.
Dialogue: 0,0:15:50.14,0:15:51.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya, Tuan.
Dialogue: 0,0:15:58.52,0:15:59.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hell Blast!
Dialogue: 0,0:15:59.77,0:16:01.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hell Blaze!
Dialogue: 0,0:16:03.66,0:16:05.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bisa pakai sihir undead juga?
Dialogue: 0,0:16:05.90,0:16:10.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, sepertinya tubuh ini punya skill itu.
Dialogue: 0,0:16:10.41,0:16:13.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir undead, keren, ya.
Dialogue: 0,0:16:14.27,0:16:15.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita menang.
Dialogue: 0,0:16:25.67,0:16:27.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran, di belakangmu!
Dialogue: 0,0:16:29.34,0:16:30.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Stefan.
Dialogue: 0,0:16:31.09,0:16:32.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:16:34.24,0:16:35.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:16:36.24,0:16:38.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus, Stefan.
Dialogue: 0,0:16:39.07,0:16:40.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan.
Dialogue: 0,0:16:42.06,0:16:45.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bertarung dalam tim ternyata seru, ya!
Dialogue: 0,0:16:47.17,0:16:48.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:16:50.27,0:16:51.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa ditebas!
Dialogue: 0,0:16:52.30,0:16:53.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka Arcleis, ya?
Dialogue: 0,0:16:54.69,0:16:56.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan padaku.
Dialogue: 0,0:17:04.00,0:17:08.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebanyak itu lenyap dalam sekejap?\NPemangsa Mayat memang hebat.
Dialogue: 0,0:17:08.16,0:17:09.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Stefan hebat!
Dialogue: 0,0:17:09.65,0:17:11.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:17:11.90,0:17:13.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sangat membantu, Stefan.
Dialogue: 0,0:17:18.72,0:17:21.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di dalam tempat ini ada penjaga lantai 8.
Dialogue: 0,0:17:24.21,0:17:28.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran, Master,\Ndari sini aku akan bertindak sendiri.
Dialogue: 0,0:17:28.49,0:17:30.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?\NBegitu, ya?
Dialogue: 0,0:17:30.40,0:17:33.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, karena Tuan memberiku perintah rahasia.
Dialogue: 0,0:17:33.76,0:17:35.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, kuserahkan padamu.
Dialogue: 0,0:17:35.30,0:17:35.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:17:36.80,0:17:40.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sangat disayangkan, aku masih ingin\Nbertarung bersamamu sebentar lagi.
Dialogue: 0,0:17:40.83,0:17:42.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga merasa begitu.
Dialogue: 0,0:17:44.06,0:17:49.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Urushi, Master, Fran.\NTolong jaga Tuanku.
Dialogue: 0,0:17:49.15,0:17:50.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, serahkan pada kami.
Dialogue: 0,0:17:51.47,0:17:53.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu...
Dialogue: 0,0:17:53.02,0:17:54.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu?
Dialogue: 0,0:17:54.96,0:17:56.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak jadi...
Dialogue: 0,0:17:57.78,0:17:58.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pergi dulu.
Dialogue: 0,0:18:00.00,0:18:02.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya perintah rahasia?
Dialogue: 0,0:18:02.53,0:18:05.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya berniat melakukan\Ntindakan pencegahan.
Dialogue: 0,0:18:05.89,0:18:08.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti akan kuceritakan kalau sudah yakin.
Dialogue: 0,0:18:09.31,0:18:11.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, kita pergi.
Dialogue: 0,0:18:20.91,0:18:23.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, serang duluan dengan sihir!
Dialogue: 0,0:18:28.72,0:18:30.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:18:30.01,0:18:32.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia menebas sihir kita?
Dialogue: 0,0:18:33.38,0:18:34.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:18:34.55,0:18:36.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita adu tebas!
Dialogue: 0,0:18:36.20,0:18:38.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hati-hati, itu tombak sihir!
Dialogue: 0,0:18:39.47,0:18:43.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu dia punya skill Teknik Tombak Suci.\NJangan meremehkannya!
Dialogue: 0,0:18:51.10,0:18:55.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita juga punya Teknik Pedang Suci\Ndan pedang yang sangat super kuat!
Dialogue: 0,0:19:00.34,0:19:01.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Urushi!
Dialogue: 0,0:19:03.21,0:19:04.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu baik-baik saja, Fran?
Dialogue: 0,0:19:04.75,0:19:07.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, ini berkat perlindungan\Ndari perlengkapan Kucing Hitam.
Dialogue: 0,0:19:08.46,0:19:11.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penjaga kali ini kekuatannya\Njauh berbeda dari sebelumnya!
Dialogue: 0,0:19:12.34,0:19:13.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Urushi!
Dialogue: 0,0:19:14.30,0:19:16.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lompat Udara!
Dialogue: 0,0:19:24.38,0:19:26.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia juga bisa menangkis\Nserangan Fran yang ini?
Dialogue: 0,0:19:27.82,0:19:30.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oi, Fran, dia sedang mengumpulkan mana!
Dialogue: 0,0:19:34.83,0:19:36.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahaya.
Dialogue: 0,0:19:36.56,0:19:38.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tombaknya sangat merepotkan.
Dialogue: 0,0:19:38.14,0:19:41.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.\NKalau begitu, kita incar tombaknya!
Dialogue: 0,0:19:41.55,0:19:43.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga berpikir hal yang sama.
Dialogue: 0,0:19:43.55,0:19:48.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, aku akan meluncurkan sihir penguat.\NSerang dia di titik yang sama!
Dialogue: 0,0:19:48.99,0:19:50.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, ayo serang!
Dialogue: 0,0:19:50.50,0:19:52.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemikiran Terpisah!
Dialogue: 0,0:19:53.78,0:19:55.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fokus!
Dialogue: 0,0:19:55.26,0:19:57.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Explosion!
Dialogue: 0,0:20:03.35,0:20:04.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih belum!
Dialogue: 0,0:20:04.60,0:20:06.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serang sekali lagi!
Dialogue: 0,0:20:07.82,0:20:09.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang, Fran!\NGunakan teknik itu!
Dialogue: 0,0:20:09.87,0:20:11.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:20:11.11,0:20:12.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teknik Pedang Suci!
Dialogue: 0,0:20:12.86,0:20:15.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Impact Slash!
Dialogue: 0,0:20:25.71,0:20:27.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyerap Batu Sihir!
Dialogue: 0,0:20:28.16,0:20:29.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menang...
Dialogue: 0,0:20:29.84,0:20:32.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus, Fran.
Dialogue: 0,0:20:33.44,0:20:38.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat, aku sampai kagum!\NAku kira dia musuh yang sangat kuat.
Dialogue: 0,0:20:38.30,0:20:41.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bertarung terlalu lama,\Nkami yang akan terdesak.
Dialogue: 0,0:20:41.04,0:20:43.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami terpaksa mengerahkan semuanya dari awal.
Dialogue: 0,0:20:43.64,0:20:46.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teknik terakhir tadi sangat hebat.
Dialogue: 0,0:20:46.48,0:20:51.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Impact Slash,\Nteknik terkuat yang bisa dipakai Fran.
Dialogue: 0,0:20:51.39,0:20:54.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tak bisa mengalahkannya dengan itu,\Nmungkin kami dalam bahaya.
Dialogue: 0,0:20:56.30,0:21:01.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemampuan membaca situasi Master,\Nlalu kemampuan Fran yang cepat beradaptasi.
Dialogue: 0,0:21:01.95,0:21:04.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kombinasi yang luar biasa.
Dialogue: 0,0:21:04.00,0:21:04.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:21:04.99,0:21:08.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dan Master adalah kombinasi emas!
Dialogue: 0,0:21:08.12,0:21:10.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Emas!
Dialogue: 0,0:21:11.30,0:21:17.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, dungeon ini sampai lantai 10 bawah tanah.\NPenjaga lantai 8 sudah sekuat ini.
Dialogue: 0,0:21:18.08,0:21:20.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran, kita pulihkan tenaga dulu.
Dialogue: 0,0:21:20.70,0:21:22.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, sebentar lagi pasti...
Dialogue: 0,0:21:25.94,0:21:27.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah.
Dialogue: 0,0:21:27.02,0:21:32.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau berhasil melewati lantai ini,\Nsisanya tinggal Aula Inti dungeon.
Dialogue: 0,0:21:34.96,0:21:37.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penjaga lantai 9!
Dialogue: 0,0:21:37.49,0:21:40.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanpa ampun, kita serang serentak!
Dialogue: 0,0:21:50.24,0:21:51.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga.
Dialogue: 0,0:21:53.52,0:21:56.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya ketemu juga, tengkorak sialan.
Dialogue: 0,0:21:57.87,0:22:01.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Utang pertarungan di udara tempo hari...\Nakan kubalas!
