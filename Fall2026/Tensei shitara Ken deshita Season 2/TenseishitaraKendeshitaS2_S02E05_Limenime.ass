Dialogue: 0,0:06:22.45,0:06:25.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya lebih kuat daripada buatanku.
Dialogue: 0,0:06:25.41,0:06:28.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memakai Pikiran Serentak\Ndan Pikiran Kecepatan Tinggi.
Dialogue: 0,0:06:28.08,0:06:30.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melakukan perhitungan kecepatan tinggi.
Dialogue: 0,0:06:30.04,0:06:31.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhasil.
Dialogue: 0,0:06:31.12,0:06:33.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menggunakan delapan poin evolusi diri.
Dialogue: 0,0:06:33.50,0:06:36.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menaikkan Sihir Api dari level 1 ke 5.
Dialogue: 0,0:06:36.71,0:06:38.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kali ini Sihir Api?
Dialogue: 0,0:06:38.79,0:06:41.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memaksimalkan penggunaan mana.
Dialogue: 0,0:06:41.21,0:06:42.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meningkatkan hasil.
Dialogue: 0,0:06:42.99,0:06:46.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Api, Inferno Burst.
Dialogue: 0,0:06:46.09,0:06:48.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memfokuskan kelima serangan\Ndi koordinat yang sama.
Dialogue: 0,0:07:00.73,0:07:02.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lich...
Dialogue: 0,0:07:02.65,0:07:04.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku bisa mengalahkannya sekarang?
Dialogue: 0,0:07:04.22,0:07:05.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:07:05.07,0:07:10.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lich terlihat kesulitan mengendalikan\Ndendam yang dilepaskan.
Dialogue: 0,0:07:11.37,0:07:12.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dia kalah,
Dialogue: 0,0:07:12.61,0:07:17.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ada 89 persen kemungkinan\Nledakan berskala besar.
Dialogue: 0,0:07:17.09,0:07:19.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lich mengendalikan dendam?
Dialogue: 0,0:07:19.92,0:07:21.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya?
Dialogue: 0,0:07:21.44,0:07:23.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengonsumsi poin evolusi diri.
Dialogue: 0,0:07:23.34,0:07:26.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengembangkan Pengambil Keahlian level 10.
Dialogue: 0,0:07:26.80,0:07:30.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengatur ulang pendinginan melalui evolusi.
Dialogue: 0,0:07:30.01,0:07:32.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang bisa digunakan.
Dialogue: 0,0:07:32.22,0:07:33.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:07:33.27,0:07:35.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengaktifkan SP Pengambil Keahlian.
Dialogue: 0,0:07:35.64,0:07:39.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti memecahkan teka-teki sogi,\Nsetiap langkahnya menuju ke sini.
Dialogue: 0,0:07:39.44,0:07:40.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa memang dirancang begitu?
Dialogue: 0,0:07:42.73,0:07:46.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Merebut skill Membatalkan dari Lich.
Dialogue: 0,0:07:46.21,0:07:48.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan Keahlian Membatalkan,\Naku bisa teleportasi.
Dialogue: 0,0:07:48.66,0:07:51.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Announcer, kamu sangat hebat!
Dialogue: 0,0:07:51.24,0:07:53.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Ruang Waktu...
Dialogue: 0,0:07:53.16,0:07:54.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran, kita bisa selamat!
Dialogue: 0,0:07:56.83,0:07:58.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dimension Jump.
Dialogue: 0,0:08:13.31,0:08:14.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita keluar!
Dialogue: 0,0:08:14.82,0:08:16.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Fran! Urushi!
Dialogue: 0,0:08:17.81,0:08:19.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Urushi baik-baik saja.
Dialogue: 0,0:08:19.15,0:08:20.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana dengan Fran?
Dialogue: 0,0:08:21.31,0:08:23.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia hanya pingsan?
Dialogue: 0,0:08:24.48,0:08:25.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Stefan...
Dialogue: 0,0:08:26.69,0:08:29.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jean juga baik-baik saja, kan?
Dialogue: 0,0:08:31.16,0:08:33.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita aman, Announcer.
Dialogue: 0,0:08:33.99,0:08:38.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daya tahan Master akan mencapai\Nbatasnya dalam 35 detik.
Dialogue: 0,0:08:38.97,0:08:41.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menonaktifkan Pelepasan Potensi Tersembunyi.
Dialogue: 0,0:08:41.78,0:08:45.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Secara bersamaan, domain kemampuan\Nyang dikenal sebagai Announcer
Dialogue: 0,0:08:45.00,0:08:46.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan dicabut wewenangnya.
Dialogue: 0,0:08:46.84,0:08:49.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dicabut?\NKamu akan kembali normal?
Dialogue: 0,0:08:49.84,0:08:50.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:08:50.93,0:08:56.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fungsi yang tersedia\Nhanyalah terjemahan dan notifikasi.
Dialogue: 0,0:08:56.03,0:08:58.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih banyak hal yang ingin kutanyakan.
Dialogue: 0,0:08:58.35,0:09:00.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku pakai\NPelepasan Potensi Tersembunyi lagi,
Dialogue: 0,0:09:00.56,0:09:02.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu akan kembali seperti ini?
Dialogue: 0,0:09:02.48,0:09:03.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:09:03.97,0:09:06.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena melebihi batas operasional,
Dialogue: 0,0:09:06.50,0:09:09.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebagian domain kemampuan rusak.
Dialogue: 0,0:09:11.24,0:09:14.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama penggunaan Pelepasan Potensi\NTersembunyi di masa depan,
Dialogue: 0,0:09:14.14,0:09:17.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kemungkinan Announcer\Nmemulihkan otoritas
Dialogue: 0,0:09:17.58,0:09:18.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah dua persen.
Dialogue: 0,0:09:19.83,0:09:22.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin.\NKalau begitu...
Dialogue: 0,0:09:23.37,0:09:25.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dewa menolak keberadaanku,
Dialogue: 0,0:09:25.82,0:09:28.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}penciptaku menghapusnya...
Dialogue: 0,0:09:28.86,0:09:32.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya boleh ada sebagai wadah.
Dialogue: 0,0:09:32.76,0:09:35.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski hanya sebentar,
Dialogue: 0,0:09:35.00,0:09:38.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku bisa menggunakan kekuatanku untuk tuanku.
Dialogue: 0,0:09:39.23,0:09:40.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu.
Dialogue: 0,0:09:41.64,0:09:46.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga Dewa Kebijaksanaan memberkatimu.
Dialogue: 0,0:09:48.65,0:09:52.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Announcer?\NAnnouncer!
Dialogue: 0,0:09:55.87,0:10:00.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak mungkin bisa\Nmenyelamatkan Fran sendirian.
Dialogue: 0,0:10:00.84,0:10:05.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Announcer, terima kasih\Nsudah membantu diriku yang payah ini.
Dialogue: 0,0:10:06.04,0:10:09.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sudah pergi?
Dialogue: 0,0:10:09.07,0:10:10.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang akan sepi, ya.
Dialogue: 0,0:10:10.80,0:10:12.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:10:12.22,0:10:13.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu siapa?
Dialogue: 0,0:10:13.55,0:10:15.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, suara itu...
Dialogue: 0,0:10:16.01,0:10:17.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suara saat itu?
Dialogue: 0,0:10:18.14,0:10:22.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia melakukan hal ceroboh\Nseperti memasuki Domain Dewa.
Dialogue: 0,0:10:22.94,0:10:24.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajar hasilnya begini.
Dialogue: 0,0:10:24.14,0:10:26.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu menonton dari dalam?
Dialogue: 0,0:10:26.98,0:10:31.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kamu dan Announcer\Nada di dalam diriku?
Dialogue: 0,0:10:32.24,0:10:34.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, siapa kamu sebenarnya?
Dialogue: 0,0:10:34.20,0:10:39.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berniat mengungkap identitasku nanti,
Dialogue: 0,0:10:39.17,0:10:41.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi akan kuberi tahu sekarang.
Dialogue: 0,0:10:41.81,0:10:42.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namaku...
Dialogue: 0,0:10:42.87,0:10:43.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master!
Dialogue: 0,0:10:44.79,0:10:46.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Stefan.
Dialogue: 0,0:10:46.28,0:10:48.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang semuanya selamat.
Dialogue: 0,0:10:49.25,0:10:51.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kamu masih ada di sana?
Dialogue: 0,0:10:51.15,0:10:53.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa namamu?
Dialogue: 0,0:10:54.26,0:10:56.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial, dia sudah pergi!
Dialogue: 0,0:10:56.51,0:10:58.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:10:58.43,0:11:00.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, bukan apa-apa.
Dialogue: 0,0:11:00.64,0:11:02.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, Stefan,
Dialogue: 0,0:11:02.11,0:11:04.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa kondisimu baik-baik saja?
Dialogue: 0,0:11:05.02,0:11:05.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baik-baik saja.
Dialogue: 0,0:11:05.85,0:11:08.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kehilangan mana-ku\Ndan tidak bisa beregenerasi.
Dialogue: 0,0:11:08.73,0:11:11.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu.\NBagaimana dengan Jean?
Dialogue: 0,0:11:11.00,0:11:12.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia baik-baik saja.
Dialogue: 0,0:11:12.27,0:11:15.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hampir tidak bisa melindunginya\Ndengan Resistansi Dendam-ku.
Dialogue: 0,0:11:15.71,0:11:17.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana dengan Fran?
Dialogue: 0,0:11:17.57,0:11:21.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia juga baik-baik saja.\NCuma pingsan.
Dialogue: 0,0:11:24.55,0:11:28.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tubuh Lich pasti sudah hancur.
Dialogue: 0,0:11:28.58,0:11:30.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin inti dungeon juga.
Dialogue: 0,0:11:30.21,0:11:32.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita nyaris mati, ya.
Dialogue: 0,0:11:34.09,0:11:35.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, hei.
Dialogue: 0,0:11:35.22,0:11:36.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat.
Dialogue: 0,0:11:36.59,0:11:38.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekalipun dungeonnya hilang,
Dialogue: 0,0:11:38.09,0:11:40.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau pulau melayangnya runtuh,
Dialogue: 0,0:11:41.31,0:11:42.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}semuanya akan jatuh.
Dialogue: 0,0:11:42.51,0:11:45.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, kalau pulau sebesar itu jatuh...
Dialogue: 0,0:11:46.44,0:11:49.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan hanya pondok Jean\Ndan desa-desa terdekat yang kena.
Dialogue: 0,0:11:49.40,0:11:52.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Medannya akan berubah\Ndan memengaruhi ekosistem.
Dialogue: 0,0:11:53.19,0:11:55.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus menangani ini.
Dialogue: 0,0:11:56.07,0:11:57.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Urushi, tolong jaga Fran.
Dialogue: 0,0:11:59.78,0:12:00.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master?
Dialogue: 0,0:12:03.74,0:12:05.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inferno Burst!
Dialogue: 0,0:12:06.08,0:12:07.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Earth Digger!
Dialogue: 0,0:12:10.04,0:12:11.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Air Bomb!
Dialogue: 0,0:12:14.05,0:12:14.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus!
Dialogue: 0,0:12:15.01,0:12:16.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:12:16.22,0:12:17.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyimpanan Dimensi!
Dialogue: 0,0:12:20.09,0:12:21.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo serang sekaligus.
Dialogue: 0,0:12:21.80,0:12:23.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pikiran Serentak!
Dialogue: 0,0:12:26.46,0:12:27.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat.
Dialogue: 0,0:12:29.10,0:12:30.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mata Langit.
Dialogue: 0,0:12:32.55,0:12:35.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bahkan bisa melihat dengan jelas\Ndi dalam Penyimpanan Dimensi.
Dialogue: 0,0:12:36.07,0:12:37.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih muat.
Dialogue: 0,0:12:37.53,0:12:40.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, sedikit lagi!
Dialogue: 0,0:12:43.99,0:12:46.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master, kerja bagus.
Dialogue: 0,0:12:46.16,0:12:50.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu juga.\NKamu sudah membantu banyak.
Dialogue: 0,0:12:50.03,0:12:52.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak, semuanya.
Dialogue: 0,0:12:52.92,0:12:55.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa tiba-tiba formal begitu?
Dialogue: 0,0:12:55.67,0:12:56.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu...
Dialogue: 0,0:12:57.84,0:12:59.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya waktuku sudah habis.
Dialogue: 0,0:13:00.38,0:13:03.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski tuanku Tuan Jean du Vix,
Dialogue: 0,0:13:03.80,0:13:05.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tubuh ini adalah monster dungeon
Dialogue: 0,0:13:05.64,0:13:09.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang dipanggil oleh Dungeon Master, Lich.
Dialogue: 0,0:13:09.42,0:13:11.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu Dungeon Master dikalahkan,
Dialogue: 0,0:13:11.34,0:13:12.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan menghilang.
Dialogue: 0,0:13:12.65,0:13:14.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin...
Dialogue: 0,0:13:16.15,0:13:17.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Jean, bangun!
Dialogue: 0,0:13:17.75,0:13:18.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lakukan sesuatu untuknya!
Dialogue: 0,0:13:22.57,0:13:23.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.
Dialogue: 0,0:13:24.37,0:13:25.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Stefan,
Dialogue: 0,0:13:25.76,0:13:28.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kenapa kamu masih bisa tersenyum?
Dialogue: 0,0:13:29.41,0:13:31.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master, terimalah ini.
Dialogue: 0,0:13:32.79,0:13:36.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu akan mengerti semuanya\Nsetelah membacanya.
Dialogue: 0,0:13:36.96,0:13:39.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buku harian?\NMilik siapa ini?
Dialogue: 0,0:13:39.76,0:13:41.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti akan paham saat membacanya.
Dialogue: 0,0:13:41.53,0:13:43.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang akhirnya aku bisa pergi tenang.
Dialogue: 0,0:13:43.80,0:13:46.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Stefan... Hei!
Dialogue: 0,0:13:46.00,0:13:49.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah bertualang denganku.
Dialogue: 0,0:13:50.35,0:13:51.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master.
Dialogue: 0,0:13:51.98,0:13:55.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong jaga masterku yang satu lagi, ya.
Dialogue: 0,0:13:55.56,0:13:58.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, obrolan kita belum selesai!
Dialogue: 0,0:13:58.57,0:14:03.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah membebaskan kami.
Dialogue: 0,0:14:06.91,0:14:08.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat beristirahat.
Dialogue: 0,0:14:10.47,0:14:14.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia... tersenyum sampai akhir.
Dialogue: 0,0:14:19.80,0:14:24.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berikutnya, tambahkan bubuk\Nberwarna kunyit ini saat menumis.
Dialogue: 0,0:14:25.30,0:14:26.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu.
Dialogue: 0,0:14:26.80,0:14:28.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aromanya enak, ya.
Dialogue: 0,0:14:29.60,0:14:31.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tubuhmu sudah baikan?
Dialogue: 0,0:14:32.77,0:14:34.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum sepenuhnya pulih.
Dialogue: 0,0:14:35.75,0:14:37.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, ini.
Dialogue: 0,0:14:38.35,0:14:40.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga ingin kamu membaca ini.
Dialogue: 0,0:14:41.24,0:14:42.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:14:43.61,0:14:46.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak tahu cara\Nberterima kasih pada Stefan.
Dialogue: 0,0:14:46.74,0:14:49.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tersenyum sampai akhir\Ndan terlihat puas.
Dialogue: 0,0:14:50.58,0:14:51.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu.
Dialogue: 0,0:14:57.54,0:14:59.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa sangka aku bisa makan kari ini lagi!
Dialogue: 0,0:14:59.80,0:15:01.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat bersyukur.
Dialogue: 0,0:15:03.76,0:15:05.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih untuk karinya...
Dialogue: 0,0:15:06.87,0:15:08.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu untuk Stefan.
Dialogue: 0,0:15:22.61,0:15:25.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari itu, aku hampir terbunuh.
Dialogue: 0,0:15:26.78,0:15:29.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan dibuang\Nkarena eksperimen yang gagal.
Dialogue: 0,0:15:29.97,0:15:33.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya seperti disuntikkan\Nkebencian murni saat masih hidup.
Dialogue: 0,0:15:34.79,0:15:37.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu pasti berisi dendam pria itu\Nyang sudah mati,
Dialogue: 0,0:15:37.08,0:15:39.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan dendam gadis itu.
Dialogue: 0,0:15:41.75,0:15:44.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat aku hampir kehilangan kesadaranku...
Dialogue: 0,0:15:45.47,0:15:46.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat itulah terjadi.
Dialogue: 0,0:15:47.93,0:15:52.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inti dungeon tiba-tiba muncul\Ndi tempatku berada.
Dialogue: 0,0:15:53.10,0:15:56.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inti dungeon mengenaliku sebagai tuannya.
Dialogue: 0,0:15:56.01,0:15:57.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menjadi Dungeon Master.
Dialogue: 0,0:15:58.06,0:16:00.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pun berevolusi.
Dialogue: 0,0:16:05.79,0:16:09.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada hari itu, aku bukan lagi manusia.
Dialogue: 0,0:16:12.74,0:16:13.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Balas dendam.
Dialogue: 0,0:16:14.29,0:16:16.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah alasan keberadaanku.
Dialogue: 0,0:16:16.60,0:16:19.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak punya apa pun lagi.
Dialogue: 0,0:16:19.68,0:16:22.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena pria dan gadis itu,\Nyang pernah jadi temanku,
Dialogue: 0,0:16:22.21,0:16:26.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dibawa pergi oleh Kerajaan Raydoss.
Dialogue: 0,0:16:27.09,0:16:29.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dungeon adalah ujian bagi manusia
Dialogue: 0,0:16:29.85,0:16:31.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang diwujudkan oleh para dewa.
Dialogue: 0,0:16:32.14,0:16:33.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,
Dialogue: 0,0:16:33.62,0:16:36.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan jadi ujian untuk Kerajaan Raydoss.
Dialogue: 0,0:16:36.77,0:16:39.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan memusnahkan mereka!
Dialogue: 0,0:16:40.98,0:16:44.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}4 November 3619.
Dialogue: 0,0:16:44.86,0:16:48.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengumpulkan beberapa Goddess Point\Nuntuk memperkuat dungeon.
Dialogue: 0,0:16:48.73,0:16:51.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu memutuskan untuk memanggil\Npelayan yang lebih kuat.
Dialogue: 0,0:16:52.24,0:16:54.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menggunakan sisa-sisa\Ndari pria dan gadis itu.
Dialogue: 0,0:16:57.66,0:16:59.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka bahkan punya skill ekstra,
Dialogue: 0,0:16:59.33,0:17:02.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelepasan Potensi Tersembunyi.
Dialogue: 0,0:17:02.24,0:17:04.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dapat pelayan yang cukup kuat.
Dialogue: 0,0:17:05.50,0:17:10.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, sepertinya mereka\Ntidak mengenaliku lagi.
Dialogue: 0,0:17:11.66,0:17:14.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Andai aku bisa bertualang bersama mereka.
Dialogue: 0,0:17:16.64,0:17:20.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}20 Mei 3622.
Dialogue: 0,0:17:20.89,0:17:23.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini, aku akan mencoba\Nmenciptakan undead spesial.
Dialogue: 0,0:17:24.73,0:17:26.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelahap Undead.
Dialogue: 0,0:17:26.40,0:17:29.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Individu yang tumbuh lebih kuat\Ndengan memakan undead lain.
Dialogue: 0,0:17:30.20,0:17:33.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memutuskan untuk membiarkannya\Nberkeliaran di dungeon.
Dialogue: 0,0:17:34.91,0:17:38.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}10 Oktober 3622.
Dialogue: 0,0:17:38.64,0:17:42.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini, dungeon kedatangan\Npenyusup pertama.
Dialogue: 0,0:17:42.42,0:17:44.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namaku Jean du Vix!
Dialogue: 0,0:17:46.42,0:17:48.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sarang undead?
Dialogue: 0,0:17:48.76,0:17:51.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini dungeon yang sempurna untukku!
Dialogue: 0,0:17:51.43,0:17:55.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berpikir, "Dia Necromancer sejati."
Dialogue: 0,0:17:55.00,0:17:58.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia keren!\NAku merasakan jiwaku bergetar.
Dialogue: 0,0:17:58.45,0:18:01.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dibandingkan dengannya, aku ini apa?
Dialogue: 0,0:18:01.31,0:18:03.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lich tapi masih bersikap\Nseperti diriku yang dulu.
Dialogue: 0,0:18:03.69,0:18:05.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, sadarlah!
Dialogue: 0,0:18:05.23,0:18:06.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai hari ini...
Dialogue: 0,0:18:06.61,0:18:10.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Lich sang Raja Arwah!
Dialogue: 0,0:18:12.61,0:18:14.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kedengarannya bagus.
Dialogue: 0,0:18:14.61,0:18:16.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus!
Dialogue: 0,0:18:16.91,0:18:21.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}28 Oktober 3623.
Dialogue: 0,0:18:21.04,0:18:24.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya aku mengumpulkan\N300.000 Goddess Point.
Dialogue: 0,0:18:24.62,0:18:27.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang aku bisa menyiapkan Reaktor Dendam.
Dialogue: 0,0:18:27.32,0:18:28.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama terhubung denganku,
Dialogue: 0,0:18:28.80,0:18:32.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}itu bisa menyerap mana\Ndan dendam tanpa henti.
Dialogue: 0,0:18:33.59,0:18:37.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}12 April 3624.
Dialogue: 0,0:18:37.51,0:18:41.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dendam di dalam diriku makin kuat.
Dialogue: 0,0:18:41.02,0:18:44.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dendam yang lebih kuat\Nberarti kekuatan yang lebih kuat.
Dialogue: 0,0:18:44.85,0:18:48.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi rasanya kebencian\Ndan dendam juga bertambah.
Dialogue: 0,0:18:49.69,0:18:51.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}3 November.
Dialogue: 0,0:18:51.65,0:18:55.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belakangan ini,\Naku sering kehilangan ingatan.
Dialogue: 0,0:18:55.99,0:18:59.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}7 Agustus 3625.
Dialogue: 0,0:18:59.86,0:19:03.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelahap Undead entah bagaimana\Nberwujud anak kecil.
Dialogue: 0,0:19:04.29,0:19:08.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia persis sepertiku\Nsebelum aku menjadi Lich.
Dialogue: 0,0:19:08.88,0:19:12.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa karena aku memberinya mana-ku?
Dialogue: 0,0:19:12.70,0:19:14.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menarik.
Dialogue: 0,0:19:15.13,0:19:18.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dua hari dalam sepekan,\Naku tidak ingat apa pun.
Dialogue: 0,0:19:19.60,0:19:23.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}6 Oktober 3626.
Dialogue: 0,0:19:23.52,0:19:26.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak ingat setengah hariku.
Dialogue: 0,0:19:26.05,0:19:28.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi rencananya berjalan lancar.
Dialogue: 0,0:19:28.36,0:19:30.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eksekusinya enam bulan lagi.
Dialogue: 0,0:19:30.84,0:19:35.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari tunjukkan pada Kerajaan Raydoss\Nseberapa dalam dendam kami.
Dialogue: 0,0:19:36.24,0:19:40.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}21 Maret 3627.
Dialogue: 0,0:19:40.43,0:19:43.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kepribadian dominan telah benar-benar\Nberalih ke yang lain.
Dialogue: 0,0:19:43.89,0:19:46.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sadar setelah enam bulan.
Dialogue: 0,0:19:46.75,0:19:49.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, pada hari ini akhirnya aku bangun,
Dialogue: 0,0:19:49.58,0:19:53.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}necromancer bernama Jean itu datang lagi.
Dialogue: 0,0:19:53.61,0:19:55.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bahkan membawa rekannya.
Dialogue: 0,0:19:55.80,0:19:57.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia imut.
Dialogue: 0,0:19:57.13,0:20:00.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa dia seusiaku sebelum aku menjadi Lich?
Dialogue: 0,0:20:01.81,0:20:03.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi iri.
Dialogue: 0,0:20:05.93,0:20:09.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagi orang sepertiku,\Nyang jadi budak sejak lahir,
Dialogue: 0,0:20:09.34,0:20:11.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia terlalu bersinar.
Dialogue: 0,0:20:12.65,0:20:15.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau dia mati.
Dialogue: 0,0:20:16.65,0:20:20.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang akan terjadi\Nsaat aku bangun lagi?
Dialogue: 0,0:20:20.65,0:20:24.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau aku tidak akan pernah bangun lagi?
Dialogue: 0,0:20:26.00,0:20:27.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menantikannya.
Dialogue: 0,0:20:29.42,0:20:32.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin saja,\Norang yang membaca buku harian ini
Dialogue: 0,0:20:32.04,0:20:35.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah Jean du Vix\Ndan gadis manusia binatang itu?
Dialogue: 0,0:20:36.01,0:20:38.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, ada yang ingin kusampaikan.
Dialogue: 0,0:20:39.80,0:20:41.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Stefan...
Dialogue: 0,0:20:42.64,0:20:44.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang
Dialogue: 0,0:20:45.39,0:20:46.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalian masih hidup.
Dialogue: 0,0:20:49.35,0:20:50.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keesokan harinya,
Dialogue: 0,0:20:50.52,0:20:53.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku memberi tahu Fran isi buku harian itu.
Dialogue: 0,0:20:54.73,0:20:58.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah itu, Fran melamun beberapa saat.
Dialogue: 0,0:20:58.90,0:21:05.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin dia punya perasaan padanya\Nsebagai sesama mantan budak.
Dialogue: 0,0:21:07.12,0:21:08.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, aku...
Dialogue: 0,0:21:09.50,0:21:13.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perlahan aku mendapatkan kembali\Nnilai Batu Sihir yang hilang
Dialogue: 0,0:21:13.29,0:21:15.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dari Pelepasan Potensi Tersembunyi.
Dialogue: 0,0:21:15.84,0:21:18.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mendapatkan dua nilai Batu Sihir.
Dialogue: 0,0:21:18.55,0:21:20.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Announcer...
Dialogue: 0,0:21:23.51,0:21:25.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekitar sepekan telah berlalu.
Dialogue: 0,0:21:27.56,0:21:28.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jean, kami pergi.
Dialogue: 0,0:21:28.83,0:21:30.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu yakin?
Dialogue: 0,0:21:30.06,0:21:31.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memberiku 500.000 gold.
Dialogue: 0,0:21:31.98,0:21:33.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.
Dialogue: 0,0:21:33.19,0:21:35.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, kalian sudah membantu kami.
Dialogue: 0,0:21:35.98,0:21:39.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, semua pekerjaan bersih-bersih\Nkuserahkan padamu.
Dialogue: 0,0:21:39.19,0:21:43.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa, ini memang pekerjaanku.
Dialogue: 0,0:21:43.95,0:21:46.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melapor ke serikat dan kerajaan,
Dialogue: 0,0:21:46.20,0:21:50.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}membawa buku harian itu ke tempatnya,\Ndan seterusnya.
Dialogue: 0,0:21:50.53,0:21:54.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai petualang tingkat B, Jean harusnya\Nbisa melaporkan kemunculan Lich
Dialogue: 0,0:21:54.50,0:21:58.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan rencana Kerajaan Raydoss dengan benar.
Dialogue: 0,0:21:59.55,0:22:01.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jean, terima kasih.
Dialogue: 0,0:22:02.78,0:22:04.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, Master,
Dialogue: 0,0:22:04.52,0:22:08.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Batu Sihir dari Pulau Melayang\Nmemiliki sifat nekromansi.
Dialogue: 0,0:22:08.22,0:22:12.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya dibuang ke gunung berapi\Natau laut untuk menetralkannya.
Dialogue: 0,0:22:13.14,0:22:14.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:22:16.61,0:22:18.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master, ada apa?
Dialogue: 0,0:22:19.07,0:22:19.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada.
Dialogue: 0,0:22:19.90,0:22:24.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma penasaran, seperti apa\Nkepribadian Lich di momen terakhirnya.
Dialogue: 0,0:22:24.99,0:22:26.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kepribadian?
Dialogue: 0,0:22:26.42,0:22:27.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan apa-apa.
Dialogue: 0,0:22:27.78,0:22:30.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran dan Jean masih hidup.
Dialogue: 0,0:22:30.27,0:22:33.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti yang dia inginkan\Nsaat masih jadi manusia.
Dialogue: 0,0:22:34.00,0:22:37.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku penasaran apa keinginanku\Nsaat akhirnya aku menghilang.
Dialogue: 0,0:22:37.54,0:22:38.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master, sikapmu aneh.
Dialogue: 0,0:22:38.96,0:22:40.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aneh?
Dialogue: 0,0:22:41.05,0:22:44.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita pergi, aku mau makan kari\Nuntuk makan siang.
Dialogue: 0,0:22:44.55,0:22:45.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:22:45.47,0:22:48.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bahkan belum pamitan dengan Jean!
Dialogue: 0,0:22:48.75,0:22:50.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu memikirkannya.
Dialogue: 0,0:22:50.52,0:22:52.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pedangnya Fran.
Dialogue: 0,0:22:52.42,0:22:56.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keinginan itu hanya akan\Njadi keinginan pedang.
Dialogue: 0,0:22:56.49,0:22:59.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jean, Bernardo, jaga diri kalian.
Dialogue: 0,0:23:00.32,0:23:03.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tujuan kalian selanjutnya Pelabuhan Dars?
Dialogue: 0,0:23:03.70,0:23:06.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari sana, kami harus pergi ke Bulbola\Nlalu ke Ulmutt.
Dialogue: 0,0:23:06.99,0:23:08.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jaga diri kalian.
Dialogue: 0,0:23:08.46,0:23:10.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hati-hati di jalan.
Dialogue: 0,0:23:11.16,0:23:12.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai jumpa.
Dialogue: 0,0:23:17.63,0:23:20.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, Bernardo, mau memasak kari?
Dialogue: 0,0:23:20.50,0:23:22.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, serahkan padaku.
Dialogue: 0,0:23:23.67,0:23:26.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran, tujuan kita selanjutnya adalah laut!
Dialogue: 0,0:23:26.22,0:23:26.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Laut...
Dialogue: 0,0:23:26.97,0:23:29.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada makanan yang cocok pakai kari?
Dialogue: 0,0:23:29.26,0:23:31.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak!
