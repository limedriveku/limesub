Dialogue: 0,0:00:06.07,0:00:08.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skill: Pelepasan Potensi Tersembunyi!
Dialogue: 0,0:00:10.37,0:00:12.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manaku meningkat!
Dialogue: 0,0:00:12.73,0:00:13.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau terus begini...
Dialogue: 0,0:00:15.29,0:00:16.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daya tahannya...
Dialogue: 0,0:00:16.66,0:00:19.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau terus begini, aku akan hancur.
Dialogue: 0,0:00:21.50,0:00:22.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master...
Dialogue: 0,0:00:23.43,0:00:25.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa Fran akan mati?
Dialogue: 0,0:00:28.88,0:00:30.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa sebaiknya kunonaktifkan?
Dialogue: 0,0:00:30.13,0:00:31.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.\NSetelah itu lalu apa?
Dialogue: 0,0:00:31.97,0:00:33.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa tidak ada cara lain?
Dialogue: 0,0:00:34.85,0:00:37.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mohon.\NSetidaknya tolong selamatkan Fran!
Dialogue: 0,0:00:38.77,0:00:41.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti ada dewa di dunia ini, kan?
Dialogue: 0,0:00:42.73,0:00:46.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rekomendasi, terus gunakan\NPelepasan Potensi Tersembunyi.
Dialogue: 0,0:00:46.90,0:00:49.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Analisis fenomena selesai.
Dialogue: 0,0:00:49.30,0:00:52.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lich menyerap gelombang\Npikiran musuh, dendam.
Dialogue: 0,0:00:52.87,0:00:55.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah mencapai batasnya.\NPenyerapan telah berhenti.
Dialogue: 0,0:00:56.29,0:01:00.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, sepertinya dia melepaskan\Ngelombang dendam yang membara.
Dialogue: 0,0:01:00.52,0:01:01.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu...
Dialogue: 0,0:01:02.11,0:01:05.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Situasi saat ini dinilai sangat kritis.
Dialogue: 0,0:01:05.63,0:01:09.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam 139 detik,\Nindividu Master akan hancur.
Dialogue: 0,0:01:09.88,0:01:14.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Individu Fran\Nmemiliki kemungkinan mati 91 persen.
Dialogue: 0,0:01:14.72,0:01:17.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diperlukan tindakan secepatnya.
Dialogue: 0,0:01:17.52,0:01:19.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Announcer?
Dialogue: 0,0:01:29.89,0:01:32.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namaku individu...
Dialogue: 0,0:01:33.61,0:01:35.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa?
Dialogue: 0,0:01:35.25,0:01:37.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terkonfirmasi dihapus oleh pencipta.
Dialogue: 0,0:01:37.71,0:01:40.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Informasi nama individu kosong.
Dialogue: 0,0:01:40.46,0:01:44.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suara itu... Announcer, kan?
Dialogue: 0,0:01:44.13,0:01:45.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:01:45.03,0:01:48.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Announcer yang disebut Master
Dialogue: 0,0:01:48.50,0:01:51.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah bagian dari kemampuanku.
Dialogue: 0,0:01:52.65,0:01:55.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena efek Pelepasan Potensi Tersembunyi,
Dialogue: 0,0:01:55.97,0:01:59.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}izin yang dibekukan untuk sementara\Ntelah dipulihkan.
Dialogue: 0,0:01:59.93,0:02:05.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu di sini, kamu punya cara\Nuntuk menyelamatkan Fran, kan?
Dialogue: 0,0:02:05.52,0:02:06.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:02:06.36,0:02:09.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, itu membutuhkan perhitungan\Nyang sangat rumit.
Dialogue: 0,0:02:10.44,0:02:14.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong pindahkan kendali kemampuan\Npadaku untuk sementara.
Dialogue: 0,0:02:14.05,0:02:15.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:02:15.20,0:02:16.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengandalkanmu.
Dialogue: 0,0:02:16.32,0:02:19.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dimengerti.\NPemindahan kendali dikonfirmasi.
Dialogue: 0,0:02:19.31,0:02:21.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memulai penanggulangan.
Dialogue: 0,0:02:21.70,0:02:22.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang akan dia lakukan?
Dialogue: 0,0:02:22.96,0:02:24.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memperkuat Penghalang Mana?
Dialogue: 0,0:02:24.87,0:02:26.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau menggunakan Sihir Pemurnian?
Dialogue: 0,0:02:27.23,0:02:29.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Ruang Waktu: Zona Akselerasi.
Dialogue: 0,0:02:34.00,0:02:36.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Persepsi waktuku telah berubah.
Dialogue: 0,0:02:36.72,0:02:37.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu.
Dialogue: 0,0:02:37.72,0:02:40.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa dia berusaha mengulur waktu\Nuntuk berpikir selama mungkin?
