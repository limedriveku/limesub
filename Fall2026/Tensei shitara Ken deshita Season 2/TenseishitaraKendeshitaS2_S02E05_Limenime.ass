Dialogue: 0,0:03:04.75,0:03:06.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat!
Dialogue: 0,0:03:06.46,0:03:10.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beban akibat mempertahankan Bentuk Zirah\Ndan menyebarkan Penghalang Mana
Dialogue: 0,0:03:10.17,0:03:12.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menyebabkan penurunan kapasitas pemrosesan.
Dialogue: 0,0:03:12.00,0:03:14.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengonsumsi lima poin evolusi diri.
Dialogue: 0,0:03:14.45,0:03:18.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pikiran Bercabang telah berevolusi menjadi\Nskill tingkat lanjut Pikiran Serentak.
Dialogue: 0,0:03:18.47,0:03:20.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengaktifkan Pikiran Serentak.
