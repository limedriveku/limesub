Dialogue: 0,0:01:06.00,0:01:07.80,sign,,0000,0000,0000,,TENSEI SHITARA KEN DESHITA SEASON 2
Dialogue: 0,0:02:29.51,0:02:33.42,sign,,0000,0000,0000,,EPISODE 6: PANTAI PERTAMA RASANYA ASIN
Dialogue: 0,0:15:29.53,0:15:30.74,sign,,0000,0000,0000,,GELAR: PELANGGAR SUMPAH,\NKESATRIA HITAM PELINDUNG
Dialogue: 0,0:15:30.74,0:15:32.37,sign,,0000,0000,0000,,SKILL SPESIAL: AURA GELAP
Dialogue: 0,0:15:34.54,0:15:36.50,sign,,0000,0000,0000,,SALUT ORLAND, USIA: 55, RAS: MANUSIA
Dialogue: 0,0:15:36.50,0:15:37.46,sign,,0000,0000,0000,,KELAS: KESATRIA GELAP, LEVEL 31
Dialogue: 0,0:19:35.70,0:19:37.86,sign,,0000,0000,0000,,KOTOR
Dialogue: 0,0:23:34.02,0:23:39.44,sign,,0000,0000,0000,,SELANJUTNYA:\NMONSTER LAUTNYA TERLALU BESAR
Dialogue: 0,0:00:03.82,0:00:05.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bau anyir.
Dialogue: 0,0:00:05.19,0:00:07.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin aroma angin laut.
Dialogue: 0,0:00:08.70,0:00:10.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebentar lagi sampai di laut.
Dialogue: 0,0:00:14.54,0:00:15.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Laut!
Dialogue: 0,0:00:18.19,0:00:20.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat ingin melihat laut.
Dialogue: 0,0:00:20.08,0:00:22.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini kali pertamamu melihat laut, Urushi?
Dialogue: 0,0:00:23.96,0:00:26.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti kita pergi ke pantai bersama.
Dialogue: 0,0:00:27.63,0:00:28.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi tidak sabar.
Dialogue: 0,0:00:28.84,0:00:30.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu juga, Fran?
Dialogue: 0,0:00:30.66,0:00:32.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belum pernah ke pantai.
Dialogue: 0,0:00:33.22,0:00:34.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:00:34.61,0:00:37.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pernah naik kapal sebagai budak,
Dialogue: 0,0:00:37.23,0:00:40.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi belum pernah bermain di tepi laut?
Dialogue: 0,0:00:40.56,0:00:42.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa begitu!
Dialogue: 0,0:00:42.52,0:00:46.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus buat kenangan pantai\Nyang indah untukmu, Fran!
Dialogue: 0,0:02:22.31,0:02:25.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master, di mana pantainya?
Dialogue: 0,0:02:25.29,0:02:27.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita cari penginapan dulu.
Dialogue: 0,0:02:29.51,0:02:31.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita sudah di kota,
Dialogue: 0,0:02:31.26,0:02:33.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sekalian kita tidur di kamar empuk.
Dialogue: 0,0:02:33.95,0:02:36.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja.
Dialogue: 0,0:02:36.05,0:02:38.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari mana kamu belajar bicara begitu?
Dialogue: 0,0:02:38.55,0:02:40.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, ya, Dik.
Dialogue: 0,0:02:41.47,0:02:43.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sudah yang kelima!
Dialogue: 0,0:02:45.31,0:02:48.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa penginapan di Dars sepopuler itu?
Dialogue: 0,0:02:48.79,0:02:52.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya sudah,\Nayo kita ke Serikat Petualang dulu.
Dialogue: 0,0:02:53.07,0:02:57.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Resepsionis mungkin bisa\Nmerekomendasikan penginapan bagus.
Dialogue: 0,0:02:57.57,0:03:00.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Muda, peringkatmu D?
Dialogue: 0,0:03:01.04,0:03:03.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tingkat D betulan.
Dialogue: 0,0:03:03.63,0:03:06.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Resepsionisnya bukan mbak-mbak?
Dialogue: 0,0:03:09.50,0:03:11.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf sudah meragukanmu.
Dialogue: 0,0:03:11.59,0:03:12.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.
Dialogue: 0,0:03:13.21,0:03:14.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah biasa.
Dialogue: 0,0:03:15.01,0:03:15.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu.
Dialogue: 0,0:03:16.55,0:03:18.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kamu perlu apa?
Dialogue: 0,0:03:19.51,0:03:22.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita jual bahan-bahan yang sudah\Ndikumpulkan selama perjalanan.
Dialogue: 0,0:03:25.69,0:03:29.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin menjual ini lalu tolong\Nberi rekomendasi penginapan.
Dialogue: 0,0:03:30.61,0:03:32.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penginapan?
Dialogue: 0,0:03:32.11,0:03:34.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin agak sulit\Nmendapatkannya sekarang.
Dialogue: 0,0:03:34.71,0:03:36.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:03:36.01,0:03:38.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Festival Bulan Maret sebentar lagi.
Dialogue: 0,0:03:38.78,0:03:40.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Festival Bulan?
Dialogue: 0,0:03:40.95,0:03:45.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari saat ketujuh bulan\Ndi langit jadi purnama?
Dialogue: 0,0:03:45.16,0:03:46.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:03:46.41,0:03:49.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Festival Bulan diadakan empat kali setahun.
Dialogue: 0,0:03:49.08,0:03:53.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Festival besar diadakan di Bulbola,\Nkota dagang besar di selatan.
Dialogue: 0,0:03:53.13,0:03:54.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bulbola?
Dialogue: 0,0:03:54.78,0:03:57.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu kota yang kita tuju berikutnya.
Dialogue: 0,0:03:58.59,0:04:03.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini, semua yang berencana\Nberlayar ke Bulbola berkumpul di Dar.
Dialogue: 0,0:04:03.27,0:04:05.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sebabnya semua penginapan penuh.
Dialogue: 0,0:04:05.39,0:04:07.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu.
Dialogue: 0,0:04:08.15,0:04:10.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa merekomendasikan beberapa tempat,
Dialogue: 0,0:04:10.86,0:04:12.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi mungkin bakal sulit.
Dialogue: 0,0:04:12.90,0:04:14.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, kalau tidak dapat,
Dialogue: 0,0:04:14.19,0:04:17.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu bisa tidur\Ndi lantai pojok kedai serikat.
Dialogue: 0,0:04:17.17,0:04:21.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Tak akan kubiarkan Fran-ku\Nmelakukan hal seperti itu!
Dialogue: 0,0:04:25.29,0:04:27.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada tempat untuk tidur.
Dialogue: 0,0:04:27.21,0:04:29.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini gawat.\NKita harus bagaimana?
Dialogue: 0,0:04:30.69,0:04:33.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master, aku tidak keberatan tidur\Ndi lantai serikat.
Dialogue: 0,0:04:33.96,0:04:34.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:04:34.96,0:04:36.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi pertama, ayo ke pantai.
Dialogue: 0,0:04:38.88,0:04:42.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Laut!
Dialogue: 0,0:04:42.18,0:04:45.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, ayo kita ke sana sebelum gelap.
Dialogue: 0,0:05:06.08,0:05:09.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master, laut itu kejam.
Dialogue: 0,0:05:09.58,0:05:12.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Airnya asin karena garam laut.
Dialogue: 0,0:05:15.65,0:05:17.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku merasa
Dialogue: 0,0:05:17.21,0:05:19.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ini berbeda dari bayanganku.
Dialogue: 0,0:05:20.34,0:05:24.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini, pantai lebih dari\Nsekadar bermain di air!
Dialogue: 0,0:05:24.22,0:05:24.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat!
Dialogue: 0,0:05:24.93,0:05:26.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat memikirkan pantai, harus ada kari!
Dialogue: 0,0:05:26.72,0:05:28.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada daging monster goreng juga!
Dialogue: 0,0:05:31.23,0:05:33.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kari memang terbaik.
Dialogue: 0,0:05:34.73,0:05:36.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, selanjutnya apa?
Dialogue: 0,0:05:38.36,0:05:39.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dapat, Fran.
Dialogue: 0,0:05:39.32,0:05:40.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:05:41.95,0:05:44.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pancingan itu seperti bagian\Ndari tanganmu sendiri!
Dialogue: 0,0:05:45.37,0:05:46.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kepiting!
Dialogue: 0,0:05:46.53,0:05:48.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, Urushi!
Dialogue: 0,0:05:51.75,0:05:54.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bermainlah di pasir\Nsampai masakan ini matang.
Dialogue: 0,0:05:54.38,0:05:55.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:05:55.88,0:05:57.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kota Alessa.
Dialogue: 0,0:05:57.96,0:06:00.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa sangka dia punya bakat artistik.
Dialogue: 0,0:06:00.92,0:06:03.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mandi pasir.
Dialogue: 0,0:06:03.97,0:06:04.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuno sekali.
Dialogue: 0,0:06:05.80,0:06:08.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana?\NKalian bersenang-senang di pantai?
Dialogue: 0,0:06:09.52,0:06:10.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu.
Dialogue: 0,0:06:11.98,0:06:13.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah.
Dialogue: 0,0:06:16.56,0:06:17.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aqua Create.
Dialogue: 0,0:06:23.28,0:06:25.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lengketnya hilang.
Dialogue: 0,0:06:25.37,0:06:26.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:06:26.24,0:06:30.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah ganti pakaian, cari tempat menginap,\Nyang murah pun bukan masalah.
Dialogue: 0,0:06:30.13,0:06:31.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:06:32.87,0:06:34.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya penuh.
Dialogue: 0,0:06:35.08,0:06:36.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ngantuk.
Dialogue: 0,0:06:37.41,0:06:40.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo periksa area pelabuhan juga.
Dialogue: 0,0:06:42.59,0:06:46.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kelihatannya,\Ntidak ada penginapan yang kosong.
Dialogue: 0,0:06:46.30,0:06:48.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tidur di lantai serikat saja.
Dialogue: 0,0:06:51.27,0:06:52.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran.
Dialogue: 0,0:06:58.40,0:07:01.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira aku mencium bau muntahan kering.
Dialogue: 0,0:07:01.69,0:07:03.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata benar.
Dialogue: 0,0:07:03.53,0:07:07.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah itu gadis kecil\Ndari Ras Kucing Hitam?
Dialogue: 0,0:07:08.12,0:07:09.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tersesat?
Dialogue: 0,0:07:09.97,0:07:12.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kuantar.
Dialogue: 0,0:07:12.04,0:07:13.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ras Kucing Biru...
Dialogue: 0,0:07:13.83,0:07:17.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa mereka punya skill mencopet,\Nmembunuh, dan menginterogasi?
Dialogue: 0,0:07:17.08,0:07:19.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka sama sekali bukan orang baik.
Dialogue: 0,0:07:19.75,0:07:21.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku langsung tahu mereka sampah.
Dialogue: 0,0:07:21.80,0:07:24.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bicara, kamu bau.
Dialogue: 0,0:07:24.01,0:07:26.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan potong lidah dan kakimu.
Dialogue: 0,0:07:26.72,0:07:29.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan begitu, pembeli juga\Nakan senang membayarnya.
Dialogue: 0,0:07:29.76,0:07:32.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Angin: Silence.
Dialogue: 0,0:07:36.48,0:07:37.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suaraku...
Dialogue: 0,0:07:39.02,0:07:39.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang terjadi?
Dialogue: 0,0:07:40.27,0:07:42.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Tanah: Stone Wall.
Dialogue: 0,0:07:43.28,0:07:46.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang teriakan kalian\Ntidak akan terdengar.
Dialogue: 0,0:07:46.95,0:07:48.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu orang luar pun tak akan tahu.
Dialogue: 0,0:07:49.39,0:07:52.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ras Kucing Biru,\Nkalian tak akan kuberi ampun.
Dialogue: 0,0:07:53.70,0:07:56.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang, jangan bicara,\Nras Kucing Hitam!
Dialogue: 0,0:07:56.12,0:07:58.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita bungkam mulutnya!
Dialogue: 0,0:08:08.09,0:08:08.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:08:08.93,0:08:10.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang di sana sudah mati.
Dialogue: 0,0:08:10.72,0:08:12.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke-Kenapa jadi begini?
Dialogue: 0,0:08:13.12,0:08:14.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jawab pertanyaanku.
Dialogue: 0,0:08:14.60,0:08:16.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kalian pedagang budak ilegal?
Dialogue: 0,0:08:16.73,0:08:17.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di mana markas kalian?
Dialogue: 0,0:08:17.81,0:08:20.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berapa budak anak-anak\Nyang kalian miliki sekarang?
Dialogue: 0,0:08:21.17,0:08:23.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalaupun tahu, aku tak sudi\Nmemberi tahu pada ras Kucing Hitam!
Dialogue: 0,0:08:26.05,0:08:27.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Greater Heal.
Dialogue: 0,0:08:28.86,0:08:31.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski bisa sembuh,\Nkamu tetap akan kesakitan.
Dialogue: 0,0:08:31.70,0:08:32.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu!
Dialogue: 0,0:08:33.28,0:08:35.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan teruskan sampai kamu menjawab.
Dialogue: 0,0:08:38.78,0:08:40.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Lelah.\N- Fran tak pernah melunak
Dialogue: 0,0:08:40.96,0:08:43.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- pada ras Kucing Biru.\N- Ayo minum!
Dialogue: 0,0:08:44.78,0:08:46.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Greater Heal.
Dialogue: 0,0:08:48.14,0:08:49.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kucing Hitam!
Dialogue: 0,0:08:49.43,0:08:51.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu melakukan hal sekejam ini?
Dialogue: 0,0:08:52.68,0:08:55.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memotong kaki dan lidahmu,\Nlalu menyembuhkannya.
Dialogue: 0,0:08:55.31,0:08:56.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya mau di bagian mana?
Dialogue: 0,0:08:57.39,0:09:01.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kebanyakan ras Kucing Hitam\Ndiburu oleh ras Kucing Biru,
Dialogue: 0,0:09:01.81,0:09:07.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran percaya bahwa memusnahkan Kucing Biru\Nadalah cara melindungi Kucing Hitam.
Dialogue: 0,0:09:08.19,0:09:10.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, dia tidak akan\Nmenunjukkan belas kasihan.
Dialogue: 0,0:09:12.45,0:09:13.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sanity.
Dialogue: 0,0:09:17.12,0:09:19.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak akan membiarkanmu pingsan.
Dialogue: 0,0:09:19.00,0:09:21.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kuteruskan sampai kamu menjawabku.
Dialogue: 0,0:09:21.67,0:09:23.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baiklah!
Dialogue: 0,0:09:23.11,0:09:24.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan bicara!
Dialogue: 0,0:09:24.29,0:09:26.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kuberi tahu semuanya!
Dialogue: 0,0:09:32.09,0:09:33.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tempatnya?
Dialogue: 0,0:09:34.35,0:09:35.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo.
Dialogue: 0,0:09:46.23,0:09:48.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Merasakan Kehadiran: Indra Panas.
Dialogue: 0,0:09:49.28,0:09:51.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya mereka berkumpul di bawah.
Dialogue: 0,0:09:51.35,0:09:54.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa gawat kalau terjadi sesuatu\Npada anak-anak yang diculik.
Dialogue: 0,0:09:54.49,0:09:55.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita serang dari atas.
Dialogue: 0,0:09:56.56,0:09:58.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saatnya pembersihan menyeluruh.
Dialogue: 0,0:10:08.78,0:10:11.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Matilah, Bodoh.
Dialogue: 0,0:10:12.09,0:10:13.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu—
Dialogue: 0,0:10:20.18,0:10:20.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Telingaku...
Dialogue: 0,0:10:44.71,0:10:46.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini barang berkualitas tinggi.
Dialogue: 0,0:10:46.58,0:10:50.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si kembar itu sepertinya bisa dijual\Ndengan harga tinggi.
Dialogue: 0,0:10:50.00,0:10:51.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan begini, aku akan...
Dialogue: 0,0:11:01.39,0:11:04.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lantai dua ke atas, berhasil diamankan.
Dialogue: 0,0:11:05.06,0:11:06.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba kita lihat.
Dialogue: 0,0:11:06.48,0:11:09.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melewati Negara Laut Seedrun...
Dialogue: 0,0:11:09.53,0:11:12.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi para budak dikirim ke Kerajaan Raydoss?
Dialogue: 0,0:11:12.28,0:11:13.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Raydoss…
Dialogue: 0,0:11:13.80,0:11:20.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, orang-orang dari Seedrun ini,\NSuarez dan Julius, pasti terlibat.
Dialogue: 0,0:11:27.50,0:11:28.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu ini.
Dialogue: 0,0:11:28.79,0:11:30.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tangannya menggantung.
Dialogue: 0,0:11:30.92,0:11:32.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hati-hati memegangnya.
Dialogue: 0,0:11:32.76,0:11:35.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa gawat kalau mereka melihat wajahmu.
Dialogue: 0,0:11:35.22,0:11:38.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma kamu bocah\Nyang akan menyerang mereka.
Dialogue: 0,0:11:38.22,0:11:40.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan jadi masalah\Nkalau ada yang mengenalimu.
Dialogue: 0,0:11:40.90,0:11:43.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kosongkan ruangan lain dulu.
Dialogue: 0,0:11:43.06,0:11:44.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berikutnya basmi lima orang itu.
Dialogue: 0,0:11:44.93,0:11:48.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu basemen terakhir.\NAyo lakukan sesuai urutan.
Dialogue: 0,0:11:48.06,0:11:49.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke.
Dialogue: 0,0:12:09.46,0:12:11.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berikutnya basmi lima orang itu.
Dialogue: 0,0:12:11.83,0:12:15.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku pakai Silence sekarang,\Ntiga yang di basemen akan waspada.
Dialogue: 0,0:12:15.17,0:12:16.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak-anak nanti dalam bahaya.
Dialogue: 0,0:12:17.22,0:12:18.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Urushi, aku mengandalkanmu!
Dialogue: 0,0:12:20.80,0:12:23.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Sihir Kegelapan: Black Veil.\N- Apa ini?
Dialogue: 0,0:12:23.31,0:12:24.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Apa? Mataku...\N- Dengan ini,
Dialogue: 0,0:12:24.64,0:12:26.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Cepat nyalakan lampu!\N- penglihatan mereka hilang.
Dialogue: 0,0:12:27.27,0:12:29.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tebas mereka dengan cepat.
Dialogue: 0,0:12:31.06,0:12:33.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sisanya pakai Aura Blade.
Dialogue: 0,0:12:33.82,0:12:35.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, masuk ke Penyimpanan Dimensi.
Dialogue: 0,0:12:35.97,0:12:38.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lantai satu berhasil diamankan.
Dialogue: 0,0:12:38.95,0:12:40.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berikutnya basemen.
Dialogue: 0,0:12:41.43,0:12:44.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu, dari tadi mengomel apa?
Dialogue: 0,0:12:45.70,0:12:48.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teganya kamu memperlakukan\Nanak-anak sekejam ini!
Dialogue: 0,0:12:48.96,0:12:51.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Menculik dan menjual anak-anak!\N- Pakai tiga poin untuk memanggil!
Dialogue: 0,0:12:51.33,0:12:53.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kamu lebih buruk dari sampah!\N- Pakai efek ini untuk batalkan panggilan!
Dialogue: 0,0:12:53.17,0:12:54.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kamu bilang apa, Bocah?\N- Ini keterlaluan!
Dialogue: 0,0:12:54.63,0:12:56.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Yang sampah itu kamu!\N- Ini keterlaluan!
Dialogue: 0,0:12:56.46,0:12:57.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada tujuh anak-anak.
Dialogue: 0,0:12:57.97,0:12:59.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, ayo selamatkan mereka.
Dialogue: 0,0:13:01.01,0:13:03.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak peduli\Nkamu akan dijual atau tidak!
Dialogue: 0,0:13:03.18,0:13:06.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kucungkil mata dan lidahmu!
Dialogue: 0,0:13:13.40,0:13:14.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa?
Dialogue: 0,0:13:14.69,0:13:16.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pembela keadilan.
Dialogue: 0,0:13:16.78,0:13:17.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mundur.
Dialogue: 0,0:13:20.95,0:13:22.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jerujinya hancur oleh pedang?
Dialogue: 0,0:13:22.32,0:13:23.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku datang menyelamatkan kalian.
Dialogue: 0,0:13:23.62,0:13:24.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita kabur.
Dialogue: 0,0:13:26.29,0:13:28.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu pembunuh?
Dialogue: 0,0:13:30.58,0:13:31.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan.
Dialogue: 0,0:13:31.42,0:13:34.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran, petualang tingkat D.
Dialogue: 0,0:13:34.59,0:13:37.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari penampilanmu,\Nkamu terlihat sebaya dengan kami.
Dialogue: 0,0:13:38.10,0:13:42.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dilihat dari pakaiannya,\Napa mereka berdua bangsawan?
Dialogue: 0,0:13:42.34,0:13:44.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan lengah dulu.
Dialogue: 0,0:13:44.59,0:13:48.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada sekitar 20 pedagang budak ilegal\Ndi gedung ini.
Dialogue: 0,0:13:48.35,0:13:50.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Totalnya ada 22.
Dialogue: 0,0:13:51.06,0:13:52.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah membunuh mereka semua.
Dialogue: 0,0:13:53.77,0:13:55.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersama Urushi.
Dialogue: 0,0:13:59.15,0:14:01.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sini bau, sebaiknya kita pergi.
Dialogue: 0,0:14:01.78,0:14:02.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu dulu.
Dialogue: 0,0:14:03.66,0:14:06.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada sihir kontrak di kalung mereka.
Dialogue: 0,0:14:06.49,0:14:09.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mereka kabur sekarang,\Nsihirnya akan aktif.
Dialogue: 0,0:14:10.00,0:14:12.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian tidak perlu cemas.
Dialogue: 0,0:14:20.59,0:14:22.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan ini, kita bisa pergi.
Dialogue: 0,0:14:24.05,0:14:25.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu terluka?
Dialogue: 0,0:14:26.70,0:14:28.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Middle Heal.
Dialogue: 0,0:14:29.01,0:14:30.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan sihir penyembuhan juga.
Dialogue: 0,0:14:31.60,0:14:32.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita pergi dari sini.
Dialogue: 0,0:14:34.81,0:14:36.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang datang.
Dialogue: 0,0:14:37.86,0:14:40.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master, apa itu salah satu rekan mereka?
Dialogue: 0,0:14:40.33,0:14:43.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entahlah, tapi dia menggunakan skill\Nuntuk menyembunyikan kehadirannya.
Dialogue: 0,0:14:43.57,0:14:45.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia jelas seorang ahli.
Dialogue: 0,0:14:46.62,0:14:48.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya, tunggu di sini.
Dialogue: 0,0:14:48.95,0:14:50.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran!
Dialogue: 0,0:14:51.35,0:14:53.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran, kalau bisa jangan membunuhnya.
Dialogue: 0,0:14:53.58,0:14:57.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena dia ahli,\Nmungkin dia petinggi organisasi ini.
Dialogue: 0,0:14:57.13,0:14:59.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin mencari informasi.
Dialogue: 0,0:14:59.67,0:15:00.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:15:12.94,0:15:13.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perisai?
Dialogue: 0,0:15:24.03,0:15:26.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teknik menangkis pedangnya sangat hebat.
Dialogue: 0,0:15:26.95,0:15:28.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Identifikasi.
Dialogue: 0,0:15:30.74,0:15:32.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skill-nya juga lumayan bagus.
Dialogue: 0,0:15:32.37,0:15:34.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran, dia lawan yang sangat kuat.
Dialogue: 0,0:15:34.54,0:15:36.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan sulit menahan diri
Dialogue: 0,0:15:36.50,0:15:37.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk membunuhnya.
Dialogue: 0,0:15:37.46,0:15:39.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, kita lumpuhkan dia.
Dialogue: 0,0:15:40.59,0:15:41.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasakan ini.
Dialogue: 0,0:15:42.21,0:15:44.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Petir: Stun Bolt!
Dialogue: 0,0:15:49.26,0:15:50.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang Elemen.
Dialogue: 0,0:15:51.89,0:15:52.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Petir.
Dialogue: 0,0:15:54.64,0:15:56.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan kalah.
Dialogue: 0,0:15:57.73,0:15:59.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Kegelapan: Dark Arrow!
Dialogue: 0,0:16:03.94,0:16:05.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penghilang Kegelapan.
Dialogue: 0,0:16:05.65,0:16:08.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini skill Greater Demon.
Dialogue: 0,0:16:28.59,0:16:29.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Persiapkan dirimu.
Dialogue: 0,0:16:32.47,0:16:33.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu!
Dialogue: 0,0:16:34.35,0:16:35.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:16:39.60,0:16:41.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pangeran Flut, Putri Satya!
Dialogue: 0,0:16:41.77,0:16:43.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian selamat!
Dialogue: 0,0:16:45.36,0:16:47.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pangeran dan putri?
Dialogue: 0,0:16:49.99,0:16:52.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mengalahkan banyak musuh sendirian,
Dialogue: 0,0:16:52.05,0:16:54.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bahkan menyelamatkan pangeran dan putri.
Dialogue: 0,0:16:54.74,0:16:57.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Fran,\Naku sangat berterima kasih padamu.
Dialogue: 0,0:16:58.00,0:17:00.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga hampir memotong\Nlengan dan kakimu.
Dialogue: 0,0:17:00.56,0:17:01.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anggap saja impas.
Dialogue: 0,0:17:01.33,0:17:03.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lengan dan kaki?
Dialogue: 0,0:17:03.29,0:17:05.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia Salut.
Dialogue: 0,0:17:05.00,0:17:08.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia kesatria pengawal kami sejak kami kecil.
Dialogue: 0,0:17:09.01,0:17:10.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pangeran, Putri.
Dialogue: 0,0:17:10.68,0:17:12.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku telah gagal dalam tugasku.
Dialogue: 0,0:17:12.74,0:17:14.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sungguh minta maaf!
Dialogue: 0,0:17:14.34,0:17:16.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu minta maaf, Salut.
Dialogue: 0,0:17:16.22,0:17:19.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, kami yang salah karena meninggalkanmu.
Dialogue: 0,0:17:19.97,0:17:20.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan kami.
Dialogue: 0,0:17:22.90,0:17:25.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, aku belum memperkenalkan diri.
Dialogue: 0,0:17:25.35,0:17:27.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Flut Phyllius.
Dialogue: 0,0:17:27.48,0:17:29.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pangeran Kerajaan Phyllius.
Dialogue: 0,0:17:29.61,0:17:31.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Satya Phyllius.
Dialogue: 0,0:17:31.37,0:17:32.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putri dari kerajaan yang sama.
Dialogue: 0,0:17:32.91,0:17:36.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka bukan sekadar bangsawan.\NMereka keluarga kerajaan.
Dialogue: 0,0:17:36.10,0:17:38.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran, jangan bicara sembarangan.
Dialogue: 0,0:17:38.58,0:17:39.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keluarga kerajaan?
Dialogue: 0,0:17:39.91,0:17:42.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar!\NMereka berdua kembar.
Dialogue: 0,0:17:42.37,0:17:47.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pewaris takhta Phyllius keenam dan ketujuh!
Dialogue: 0,0:17:47.88,0:17:49.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Phyllius?
Dialogue: 0,0:17:49.51,0:17:50.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum pernah dengar.
Dialogue: 0,0:17:50.55,0:17:51.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei!
Dialogue: 0,0:17:51.93,0:17:53.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran, kamu tidak sopan!
Dialogue: 0,0:17:54.21,0:17:55.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:17:55.43,0:17:58.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu negara kecil di utara Dars.
Dialogue: 0,0:17:58.39,0:18:00.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetangga Kerajaan Granzell.
Dialogue: 0,0:18:00.48,0:18:02.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan senang kalau kamu mengingatnya.
Dialogue: 0,0:18:03.34,0:18:05.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan berusaha mengingatnya.
Dialogue: 0,0:18:05.56,0:18:07.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, hei.
Dialogue: 0,0:18:07.23,0:18:10.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kenapa pangeran dan putri\Nditangkap oleh pedagang budak?
Dialogue: 0,0:18:11.25,0:18:13.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalian bisa tertangkap?
Dialogue: 0,0:18:13.16,0:18:18.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami penasaran dengan jalanan\Nyang ramai selama Festival Bulan.
Dialogue: 0,0:18:18.08,0:18:19.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami ingin lihat-lihat,
Dialogue: 0,0:18:19.41,0:18:21.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan mencoba kabur dari pengawasan Salut,
Dialogue: 0,0:18:21.66,0:18:23.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu diam-diam menyusup ke kota.
Dialogue: 0,0:18:23.29,0:18:25.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu.
Dialogue: 0,0:18:25.08,0:18:29.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat itulah para Kucing Biru\Nmenemukan kalian.
Dialogue: 0,0:18:30.88,0:18:32.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya, ayo pergi dari sini.
Dialogue: 0,0:18:32.89,0:18:34.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:18:34.47,0:18:37.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rekan mereka yang lain\Nmungkin akan kembali.
Dialogue: 0,0:18:38.43,0:18:41.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita evakuasi ke penginapan\Ntempat kami menginap.
Dialogue: 0,0:18:43.71,0:18:45.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:18:45.31,0:18:47.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian memesan seluruh tempat ini?
Dialogue: 0,0:18:47.89,0:18:49.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat!
Dialogue: 0,0:18:49.73,0:18:51.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Keluarga kerajaan memang hebat, ya!\N- Indah!
Dialogue: 0,0:18:51.82,0:18:53.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baru pertama kali aku ke tempat seperti ini!
Dialogue: 0,0:18:55.03,0:18:57.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa berisik sekali?
Dialogue: 0,0:18:57.53,0:18:59.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sellid, kami kembali.
Dialogue: 0,0:18:59.74,0:19:02.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Mulia, aku sangat khawatir.
Dialogue: 0,0:19:03.37,0:19:07.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong jangan beri tahu Sellid\Nkami ditangkap.
Dialogue: 0,0:19:07.46,0:19:09.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti Salut akan ditegur.
Dialogue: 0,0:19:09.79,0:19:10.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:19:10.55,0:19:14.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, apa yang sebenarnya terjadi?
Dialogue: 0,0:19:14.05,0:19:16.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami terpisah dari Salut.
Dialogue: 0,0:19:16.59,0:19:17.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat kami tersesat,
Dialogue: 0,0:19:17.97,0:19:21.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mereka menawarkan\Nuntuk memandu kami pulang.
Dialogue: 0,0:19:21.06,0:19:23.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu.
Dialogue: 0,0:19:23.41,0:19:27.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, manusia hewan kotor di sana siapa?
Dialogue: 0,0:19:27.06,0:19:30.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master, apa aku kotor?
Dialogue: 0,0:19:30.19,0:19:32.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama sekali tidak, Fran!
Dialogue: 0,0:19:33.32,0:19:34.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jaga ucapanmu!
Dialogue: 0,0:19:35.70,0:19:37.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia Fran, seorang petualang.
Dialogue: 0,0:19:37.86,0:19:40.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia penolong yang mengantar kami kemari!
Dialogue: 0,0:19:41.20,0:19:46.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami menyambut Nona Fran\Ndan anak-anak sebagai tamu!
Dialogue: 0,0:19:46.71,0:19:47.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:19:47.59,0:19:50.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak bisa membiarkan kalian\Nseenaknya begitu!
Dialogue: 0,0:19:50.10,0:19:52.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong ingat status kalian berdua!
Dialogue: 0,0:19:52.75,0:19:55.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membiarkan orang rendahan\Nyang kotor masuk...
Dialogue: 0,0:19:56.09,0:19:57.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cukup.
Dialogue: 0,0:20:03.22,0:20:05.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau di mana pun, ada saja orang\Nyang menyebalkan.
Dialogue: 0,0:20:05.91,0:20:07.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benci dia.
Dialogue: 0,0:20:07.57,0:20:08.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran.
Dialogue: 0,0:20:09.06,0:20:12.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mau, kami akan menyiapkan kamar\Ndan makanan untukmu.
Dialogue: 0,0:20:12.23,0:20:13.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana?
Dialogue: 0,0:20:13.73,0:20:15.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Serius?\N- Kamu yakin?
Dialogue: 0,0:20:15.90,0:20:17.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu penyelamat kami.
Dialogue: 0,0:20:17.65,0:20:19.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Izinkan kami membalas kebaikanmu.
Dialogue: 0,0:20:19.99,0:20:22.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penginapan yang mustahil dipesan...
Dialogue: 0,0:20:22.54,0:20:24.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini memang anugerah!
Dialogue: 0,0:20:24.54,0:20:27.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya aku bisa tidur di ranjang empuk.
Dialogue: 0,0:20:29.29,0:20:30.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf soal tadi.
Dialogue: 0,0:20:30.50,0:20:33.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelayanku, Sellid, malah kasar.
Dialogue: 0,0:20:33.46,0:20:36.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pintar, tapi pikirannya sempit.
Dialogue: 0,0:20:36.63,0:20:38.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa, sudah biasa.
Dialogue: 0,0:20:38.43,0:20:39.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:20:40.09,0:20:42.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mentalmu ternyata kuat juga, ya, Fran.
Dialogue: 0,0:20:42.80,0:20:44.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:20:49.44,0:20:50.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:20:51.19,0:20:56.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aroma liar yang menusuk\Nsampai ke rongga hidungku...
Dialogue: 0,0:20:56.03,0:20:58.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat menikmati mandimu.
Dialogue: 0,0:21:00.45,0:21:03.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master, apa aku bau?
Dialogue: 0,0:21:03.25,0:21:07.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pedang, jadi aku tidak tahu.
Dialogue: 0,0:21:11.75,0:21:14.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master dan aku sama-sama bersih.
Dialogue: 0,0:21:16.17,0:21:17.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau berendam di air panas?
Dialogue: 0,0:21:17.63,0:21:19.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, mandi dulu.
Dialogue: 0,0:21:20.68,0:21:23.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mandi bersama sangat seru.
Dialogue: 0,0:21:23.05,0:21:26.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus berterima kasih\Npada pangeran dan putri.
Dialogue: 0,0:21:27.47,0:21:31.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka berdua bangsawan,\Ntapi sama sekali tidak menyebalkan.
Dialogue: 0,0:21:32.10,0:21:32.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Sellid?
Dialogue: 0,0:21:32.98,0:21:34.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tidak bisa diharapkan.
Dialogue: 0,0:21:36.51,0:21:37.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah mandi,
Dialogue: 0,0:21:37.78,0:21:42.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pangeran menjamu Fran\Ndan anak-anak yang diselamatkan.
Dialogue: 0,0:21:42.82,0:21:45.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak-anak yang tahu rumahnya\Ndikembalikan ke orang tuanya
Dialogue: 0,0:21:45.41,0:21:46.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagi anak-anak tunawisma,
Dialogue: 0,0:21:46.99,0:21:49.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mereka akan dibawa ke Phyllius untuk diurus.
Dialogue: 0,0:21:50.50,0:21:52.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka tampak seusia Fran,
Dialogue: 0,0:21:52.37,0:21:55.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi sudah memiliki\Nmartabat keluarga kerajaan.
Dialogue: 0,0:21:55.63,0:21:58.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka cukup bisa diandalkan.
Dialogue: 0,0:22:01.01,0:22:03.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa mangsanya di sini?
