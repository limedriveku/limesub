Dialogue: 0,0:02:28.25,0:02:30.76,sign,,0000,0000,0000,,TENSEI SHITARA KEN DESHITA SEASON 2
Dialogue: 0,0:03:58.01,0:04:01.47,sign,,0000,0000,0000,,EPISODE 4: RAJA UNDEAD ADALAH KEPUTUSASAAN
Dialogue: 0,0:12:21.43,0:12:22.56,sign,,0000,0000,0000,,LICH
Dialogue: 0,0:12:22.56,0:12:24.37,sign,,0000,0000,0000,,RAS: MONSTER, UNDEAD
Dialogue: 0,0:12:24.37,0:12:26.51,sign,,0000,0000,0000,,STATUS: ROH DENDAM AGUNG
Dialogue: 0,0:12:26.51,0:12:27.25,sign,,0000,0000,0000,,SKILL UNIK: PENYERAPAN DENDAM,
Dialogue: 0,0:12:27.25,0:12:28.42,sign,,0000,0000,0000,,KONVERSI DENDAM, PEMALSU IDENTIFIKASI
Dialogue: 0,0:12:28.42,0:12:29.23,sign,,0000,0000,0000,,SKILL EKSTRA: HUKUM KETIDAKMURNIAN 8
Dialogue: 0,0:12:29.23,0:12:29.71,sign,,0000,0000,0000,,GELAR: PENDOSA BESAR,
Dialogue: 0,0:12:29.71,0:12:30.13,sign,,0000,0000,0000,,DUNGEON MASTER, PEMBALAS DENDAM
Dialogue: 0,0:12:30.13,0:12:30.90,sign,,0000,0000,0000,,PERLENGKAPAN: JUBAH MURKA
Dialogue: 0,0:18:30.80,0:18:32.30,sign,,0000,0000,0000,,SIHIR RUANG WAKTU: 7
Dialogue: 0,0:18:32.30,0:18:33.80,sign,,0000,0000,0000,,PEMBATALAN SEGEL
Dialogue: 0,0:23:33.98,0:23:47.02,sign,,0000,0000,0000,,SELANJUTNYA:\NBERPISAH DENGAN SENYUMAN
Dialogue: 0,0:00:14.53,0:00:15.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini tempatnya.
Dialogue: 0,0:00:29.38,0:00:33.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia memanggil enam undead yang kekuatannya\Nsetara dengan Kesatria Tengkorak tadi?
Dialogue: 0,0:00:33.52,0:00:34.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran.
Dialogue: 0,0:00:35.42,0:00:38.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari awal aku sudah sangat serius!
Dialogue: 0,0:00:38.05,0:00:38.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:00:41.21,0:00:43.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar aku yang mengatasi di sini.
Dialogue: 0,0:00:46.05,0:00:48.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tongkat Sihir: Berkat Hades.
Dialogue: 0,0:00:52.16,0:00:53.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aktif.
Dialogue: 0,0:00:56.33,0:00:59.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagi jiwa-jiwa malang\Nyang ditelan kebencian.
Dialogue: 0,0:00:59.46,0:01:03.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagi jiwa-jiwa yang tak terselamatkan.\NIstirahatlah dengan tenang.
Dialogue: 0,0:01:08.72,0:01:10.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyanyiannya jelek.
Dialogue: 0,0:01:11.12,0:01:12.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serang mereka!
Dialogue: 0,0:01:15.35,0:01:16.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jean!
Dialogue: 0,0:01:16.69,0:01:18.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Strategi mengalahkan Dungeon Master.
Dialogue: 0,0:01:19.31,0:01:22.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah menyiapkannya demi momen ini.
Dialogue: 0,0:01:22.81,0:01:23.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wahai Hades.
Dialogue: 0,0:01:24.80,0:01:26.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beri dia berkatmu!
Dialogue: 0,0:01:39.15,0:01:40.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oi, serius?
Dialogue: 0,0:01:41.96,0:01:46.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma sekali serang dampaknya begini?\NKekuatannya luar biasa.
Dialogue: 0,0:01:47.33,0:01:50.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini tongkat yang bisa\Nmenyucikan undead di area luas
Dialogue: 0,0:01:50.24,0:01:52.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan membuat roh mereka\Npergi dengan tenang.
Dialogue: 0,0:01:52.82,0:01:54.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat...
Dialogue: 0,0:01:58.24,0:02:00.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luar biasa.
Dialogue: 0,0:02:00.13,0:02:03.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para pelayan tingkat tinggiku\Nbisa lenyap dalam sekejap.
Dialogue: 0,0:02:04.48,0:02:06.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi itu sampai membuatku kaget.
Dialogue: 0,0:02:06.73,0:02:07.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:03:41.49,0:03:42.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana bisa
Dialogue: 0,0:03:42.74,0:03:45.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}undead seperti dirimu masih bertahan?
Dialogue: 0,0:03:47.79,0:03:51.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya seranganmu ini\Nmengorbankan HP-mu,
Dialogue: 0,0:03:51.90,0:03:54.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi itu tak mempan padaku.
Dialogue: 0,0:03:54.05,0:03:55.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil...
Dialogue: 0,0:03:55.87,0:03:56.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Jean!\N- Jean!
Dialogue: 0,0:03:58.01,0:04:01.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}HP-mu hampir habis, ya?
Dialogue: 0,0:04:01.47,0:04:04.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu karena kamu memusnahkan\Nbanyak undead sekaligus.
Dialogue: 0,0:04:04.35,0:04:06.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajar kondisimu begitu.
Dialogue: 0,0:04:06.51,0:04:08.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jean, istirahatlah.
Dialogue: 0,0:04:08.14,0:04:09.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Greater Heal.
Dialogue: 0,0:04:11.60,0:04:15.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bukan karena terluka,\Nheal tak akan mempan.
Dialogue: 0,0:04:15.94,0:04:17.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:04:17.94,0:04:19.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya minum potion stamina ini.
Dialogue: 0,0:04:19.79,0:04:21.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf malah merepotkan.
Dialogue: 0,0:04:21.12,0:04:26.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia... sudah dimurnikan seperti itu\Nmasih belum terluka?
Dialogue: 0,0:04:26.12,0:04:27.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau pemurnian tak mempan...
Dialogue: 0,0:04:27.97,0:04:28.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:04:29.34,0:04:30.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tebas dia!
Dialogue: 0,0:04:34.67,0:04:35.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tebas!
Dialogue: 0,0:04:38.22,0:04:41.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedangnya tembus?\NDia sebenarnya makhluk apa?
Dialogue: 0,0:04:43.65,0:04:44.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fire Arrow!
Dialogue: 0,0:04:49.31,0:04:51.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tak punya wujud fisik?
Dialogue: 0,0:04:54.86,0:04:56.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini sihir ilusi?
Dialogue: 0,0:04:56.11,0:04:57.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih belum!
Dialogue: 0,0:05:07.26,0:05:09.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua serangan kita tembus.
Dialogue: 0,0:05:09.97,0:05:11.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bicara dulu, Fran.
Dialogue: 0,0:05:12.71,0:05:15.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pikir bisa menang\Nkalau bertarung jarak dekat?
Dialogue: 0,0:05:15.59,0:05:18.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}HP Fran berkurang setengah\Nhanya dengan sekali serang?
Dialogue: 0,0:05:18.61,0:05:20.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Greater Heal!
Dialogue: 0,0:05:20.55,0:05:25.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dampak serangannya fisik,\Nmustahil dia cuma ilusi.
Dialogue: 0,0:05:26.08,0:05:28.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serangan pedang elemen\Nharusnya mempan pada roh.
Dialogue: 0,0:05:29.23,0:05:31.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi serangannya masih tembus.
Dialogue: 0,0:05:31.44,0:05:33.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini semacam skill?
Dialogue: 0,0:05:33.81,0:05:37.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jean, kamu tahu ini fenomena apa?
Dialogue: 0,0:05:37.47,0:05:41.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, tapi Mata Jiwa-ku\Ntak mempan pada undead.
Dialogue: 0,0:05:41.97,0:05:44.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Identifikasi-ku pun tak mempan.
Dialogue: 0,0:05:44.22,0:05:46.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial, kita harus bagaimana?
Dialogue: 0,0:05:48.04,0:05:49.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master.
Dialogue: 0,0:05:50.41,0:05:53.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa ulur waktu untukku sebentar?
Dialogue: 0,0:05:53.12,0:05:55.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu punya rencana?
Dialogue: 0,0:05:55.17,0:05:57.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku masih belum yakin,
Dialogue: 0,0:05:57.34,0:05:58.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi tolong percayalah padaku!
Dialogue: 0,0:05:58.93,0:06:00.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, kami serahkan padamu!
Dialogue: 0,0:06:00.67,0:06:05.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, Fran! Lawan seperlunya\Nagar dia tak menyadari rencana kita.
Dialogue: 0,0:06:05.07,0:06:07.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hati-hati dengan serangan baliknya\Nyang seperti tadi.
Dialogue: 0,0:06:07.56,0:06:08.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:06:08.40,0:06:12.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Overspec: Undead Summoning!
Dialogue: 0,0:06:14.98,0:06:20.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi impian besarku,\Nakan kupastikan apakah kalian pantas
Dialogue: 0,0:06:20.29,0:06:22.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi pelayan abadi milikku.
Dialogue: 0,0:06:23.84,0:06:25.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Urushi, tolong lindungi Jean!
Dialogue: 0,0:06:26.99,0:06:29.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, serang aku.
Dialogue: 0,0:06:29.49,0:06:30.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran.
Dialogue: 0,0:06:30.43,0:06:31.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:06:31.33,0:06:33.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo!
Dialogue: 0,0:06:50.56,0:06:54.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para undead ini,\Nmereka lebih lemah dari yang tadi?
Dialogue: 0,0:06:56.40,0:07:00.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mencoba menggoyahkan\Nhati kita dengan jumlah.
Dialogue: 0,0:07:01.96,0:07:04.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia malah santai!
Dialogue: 0,0:07:04.00,0:07:05.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya dia juga punya rencana
Dialogue: 0,0:07:06.16,0:07:09.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menjadikan kita bahan\Nuntuk undead dia berikutnya.
Dialogue: 0,0:07:09.78,0:07:14.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi dia menahan diri\Nagar mayat kita tidak rusak, ya?
Dialogue: 0,0:07:15.16,0:07:20.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya kita semua\Nakan jadi bahan yang bagus.
Dialogue: 0,0:07:23.96,0:07:28.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?\NSerangan kalian mulai melambat.
Dialogue: 0,0:07:28.26,0:07:30.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kalian sudah mencapai batas?
Dialogue: 0,0:07:42.40,0:07:44.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita sudah satu jam bertarung.
Dialogue: 0,0:07:44.86,0:07:47.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jean, masih belum siap?
Dialogue: 0,0:08:02.26,0:08:05.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Percuma!\NSerangan kalian percuma!
Dialogue: 0,0:08:13.47,0:08:15.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana bisa?
Dialogue: 0,0:08:15.02,0:08:16.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran, jangan lengah!
Dialogue: 0,0:08:22.23,0:08:23.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kena!
Dialogue: 0,0:08:23.95,0:08:24.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran.
Dialogue: 0,0:08:27.61,0:08:29.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran!
Dialogue: 0,0:08:30.36,0:08:34.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, sepertinya aku berlebihan\Nmenggunakan kekuatanku.
Dialogue: 0,0:08:34.37,0:08:38.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sialan, beraninya kamu memukul wajah Fran!
Dialogue: 0,0:08:39.25,0:08:41.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pulihkan dia dengan benar!
Dialogue: 0,0:08:42.25,0:08:44.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih belum!
Dialogue: 0,0:08:44.13,0:08:47.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, harapanmu masih ada, ya?
Dialogue: 0,0:08:48.28,0:08:54.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi saat harapan itu berubah jadi keputusasaan,\Naku menantikan ekspresi wajahmu.
Dialogue: 0,0:08:56.93,0:09:01.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sialan!\NDia malah menikmati situasi ini!
Dialogue: 0,0:09:02.61,0:09:04.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kalau sekarang dia serius,
Dialogue: 0,0:09:04.69,0:09:07.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami pasti kalah dan tak bisa\Nmembalas serangannya!
Dialogue: 0,0:09:08.07,0:09:11.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami tak akan bisa menang\Nsebelum memecahkan misterinya!
Dialogue: 0,0:09:11.78,0:09:13.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, kalian kenapa?
Dialogue: 0,0:09:13.81,0:09:17.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir pemanggilanku hampir selesai.
Dialogue: 0,0:09:17.89,0:09:21.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Overlord: Undead Summoning.
Dialogue: 0,0:09:23.42,0:09:25.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi-lagi undead tingkat tinggi...
Dialogue: 0,0:09:27.53,0:09:30.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa mana dia tak terbatas?
Dialogue: 0,0:09:30.24,0:09:31.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus.
Dialogue: 0,0:09:31.34,0:09:36.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ekspresimu itu! Itulah ekspresi harapan\Nyang mulai ternodai oleh keputusasaan.
Dialogue: 0,0:09:58.87,0:10:00.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran!
Dialogue: 0,0:10:01.75,0:10:03.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini dia!
Dialogue: 0,0:10:07.07,0:10:08.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang terjadi?
Dialogue: 0,0:10:08.26,0:10:09.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Getaran apa ini?
Dialogue: 0,0:10:09.84,0:10:12.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya berhasil, ya.
Dialogue: 0,0:10:12.57,0:10:14.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini ulah Jean?
Dialogue: 0,0:10:14.19,0:10:15.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan aku.
Dialogue: 0,0:10:17.05,0:10:20.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:10:21.50,0:10:24.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mulai panik!\NIni kesempatan kita!
Dialogue: 0,0:10:26.58,0:10:30.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sensasi ini... jangan-jangan...\NTidak mungkin!
Dialogue: 0,0:10:30.82,0:10:33.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini ulah pelayanku.
Dialogue: 0,0:10:34.18,0:10:37.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Stefan telah menghancurkan Tungku Dendam!
Dialogue: 0,0:10:38.74,0:10:39.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Stefan!
Dialogue: 0,0:10:39.94,0:10:41.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tungku Dendam?
Dialogue: 0,0:10:41.58,0:10:47.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alat yang mengubah dendam\Ndi dungeon ini menjadi mana.
Dialogue: 0,0:10:47.52,0:10:50.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah sumber mana tak terbatasnya.
Dialogue: 0,0:10:50.73,0:10:52.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti...
Dialogue: 0,0:10:52.46,0:10:55.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasokan mana dari dungeon ini\Ntelah terputus!
Dialogue: 0,0:10:58.13,0:11:01.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana dari Tungku Dendam menghilang!
Dialogue: 0,0:11:01.01,0:11:03.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alasan balas dendamku\Npada kerajaan sialan itu,
Dialogue: 0,0:11:03.31,0:11:08.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang sudah kukumpulkan bertahun-tahun,\Nsekarang lenyap!
Dialogue: 0,0:11:09.22,0:11:12.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Balas dendam pada kerajaan?
Dialogue: 0,0:11:12.82,0:11:14.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak akan kumaafkan!
Dialogue: 0,0:11:15.49,0:11:20.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian tak akan kumaafkan!
Dialogue: 0,0:11:22.04,0:11:23.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana yang luar biasa.
Dialogue: 0,0:11:23.71,0:11:27.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oi, oi, bukankah dia harusnya melemah?
Dialogue: 0,0:11:27.42,0:11:30.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, sekarang dia hanya punya batasan.
Dialogue: 0,0:11:30.56,0:11:34.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, selisih mana kita dengannya\Nmasih timpang.
Dialogue: 0,0:11:34.01,0:11:37.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi ini kekuatan dia yang sesungguhnya?
Dialogue: 0,0:11:37.26,0:11:40.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak sudi lagi jadi pelayan kalian!
Dialogue: 0,0:11:40.99,0:11:46.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kusiksa kalian perlahan sampai mati\Ndan kubuat menyesal lahir ke dunia ini!
Dialogue: 0,0:11:46.27,0:11:50.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan harap kedamaian akan datang\Nmeski kalian sudah mati!
Dialogue: 0,0:11:51.12,0:11:52.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skill Panik?
Dialogue: 0,0:11:58.86,0:12:00.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jubah Tengkorak.
Dialogue: 0,0:12:01.36,0:12:03.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak takut
Dialogue: 0,0:12:03.20,0:12:05.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}padamu!
Dialogue: 0,0:12:05.70,0:12:07.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ekspresi macam apa itu?
Dialogue: 0,0:12:07.94,0:12:13.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bilang kamu masih punya\Nharapan naif bisa mengalahkanku?
Dialogue: 0,0:12:14.48,0:12:18.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, lihatlah ini baik-baik.\NNonaktifkan Pemalsu Identifikasi.
Dialogue: 0,0:12:19.25,0:12:20.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Identifikasi?
Dialogue: 0,0:12:22.56,0:12:24.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini?
Dialogue: 0,0:12:24.37,0:12:26.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Level kekuatannya beda kelas.
Dialogue: 0,0:12:26.51,0:12:28.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dari awal dia serius,
Dialogue: 0,0:12:28.42,0:12:30.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita pasti mati dalam sekejap.
Dialogue: 0,0:12:30.90,0:12:33.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran, jangan lengah sedetik pun!
Dialogue: 0,0:12:33.74,0:12:34.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:12:38.55,0:12:42.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa hatimu sudah hancur\Nmelihat kekuatan sejatiku?
Dialogue: 0,0:12:42.51,0:12:45.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ekspresimu mulai putus asa, ya!
Dialogue: 0,0:12:45.66,0:12:48.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Overlord: Undead Summoning.
Dialogue: 0,0:13:01.39,0:13:02.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran!
Dialogue: 0,0:13:13.90,0:13:16.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teruslah menderita!
Dialogue: 0,0:13:17.03,0:13:18.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran!
Dialogue: 0,0:13:19.61,0:13:25.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hancurlah.\NSihir Bumi: Gravity Pressure!
Dialogue: 0,0:13:28.62,0:13:30.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran...
Dialogue: 0,0:13:32.26,0:13:37.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian sudah menghancurkan Tungku Dendam-ku!\NTak akan kubiarkan kalian mati semudah ini!
Dialogue: 0,0:13:40.94,0:13:44.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan mengurusmu nanti.\NDiam dan tunggu di situ.
Dialogue: 0,0:13:46.85,0:13:48.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menderitalah!
Dialogue: 0,0:13:51.46,0:13:52.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial...
Dialogue: 0,0:13:52.44,0:13:53.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master...
Dialogue: 0,0:13:53.94,0:13:56.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak berdaya!\NBenar-benar tak berdaya!
Dialogue: 0,0:13:56.94,0:14:00.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kutuklah kalian sendiri\Natas ketidakberdayaan kalian itu!
Dialogue: 0,0:14:00.44,0:14:06.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Remuk dan matilah sambil menyesali\Ndosa besar yang telah kalian perbuat!
Dialogue: 0,0:14:15.86,0:14:17.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Urushi...
Dialogue: 0,0:14:17.94,0:14:19.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jean...
Dialogue: 0,0:14:19.97,0:14:21.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran...
Dialogue: 0,0:14:22.21,0:14:24.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, aku...
Dialogue: 0,0:14:27.14,0:14:31.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin mengubah kondisi\Nras Kucing Hitam yang saat ini tertindas!
Dialogue: 0,0:14:32.19,0:14:34.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak ada seorang pun\Ndari ras Kucing Hitam yang berevolusi.
Dialogue: 0,0:14:34.90,0:14:37.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sebabnya aku ingin berevolusi.
Dialogue: 0,0:14:38.06,0:14:41.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master, kamu pedang yang super kuat!
Dialogue: 0,0:14:42.40,0:14:45.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, dia benar.
Dialogue: 0,0:14:45.59,0:14:48.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak boleh mati di sini\Nsebelum dia berevolusi.
Dialogue: 0,0:14:50.78,0:14:53.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak akan kubiarkan kamu\Nmenggerakkan satu jari pun.
Dialogue: 0,0:14:53.75,0:14:55.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi itu masih belum cukup.
Dialogue: 0,0:14:55.70,0:15:00.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para pelayanku,\Ncabik dan kuliti mereka hidup-hidup!
Dialogue: 0,0:15:00.59,0:15:04.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hancurkan tulang mereka\Ndan sebarkan di tanah!
Dialogue: 0,0:15:04.83,0:15:07.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jean, kamu masih hidup?
Dialogue: 0,0:15:08.27,0:15:11.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku nyaris kewalahan.
Dialogue: 0,0:15:11.10,0:15:12.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku punya rencana.
Dialogue: 0,0:15:12.76,0:15:16.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo beri pelajaran dan hajar\Nsi sialan sombong itu!
Dialogue: 0,0:15:19.18,0:15:20.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu bisa?
Dialogue: 0,0:15:20.61,0:15:22.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertanyaan bodoh.
Dialogue: 0,0:15:22.56,0:15:24.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan mati, ya.
Dialogue: 0,0:15:26.13,0:15:29.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepatlah datang ke sisiku, wahai pelayanku.
Dialogue: 0,0:15:31.49,0:15:33.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa, Ahli Necromancer?
Dialogue: 0,0:15:34.18,0:15:36.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tatapan mata apa itu?
Dialogue: 0,0:15:36.62,0:15:38.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}High Undead Summoning!
Dialogue: 0,0:15:38.75,0:15:40.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Muncullah, Stefan!
Dialogue: 0,0:15:44.80,0:15:47.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?\NPemakan Undead?
Dialogue: 0,0:15:47.79,0:15:49.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan!
Dialogue: 0,0:15:49.01,0:15:51.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Stefan, kerja bagus.
Dialogue: 0,0:15:51.31,0:15:52.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:15:52.82,0:15:55.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu!\NSiapa dirimu?
Dialogue: 0,0:15:56.58,0:15:57.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master...
Dialogue: 0,0:15:58.31,0:16:00.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran, syukurlah kamu masih bertahan.
Dialogue: 0,0:16:00.43,0:16:02.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master dan Urushi juga.
Dialogue: 0,0:16:04.07,0:16:07.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuanku sekarang adalah Tuan Jean du Vix.
Dialogue: 0,0:16:09.81,0:16:14.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya aku tak sembarangan\Nmenggunakan sihir nekromansiku.
Dialogue: 0,0:16:14.79,0:16:18.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak kusangka pelayanku bisa direbut.
Dialogue: 0,0:16:19.20,0:16:20.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master.
Dialogue: 0,0:16:20.69,0:16:22.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita belum kalah!
Dialogue: 0,0:16:23.17,0:16:25.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak akan ada yang berubah,
Dialogue: 0,0:16:25.30,0:16:28.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}meski bertambah satu pemakan undead!
Dialogue: 0,0:16:32.45,0:16:34.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana keputusasaanmu?
Dialogue: 0,0:16:36.83,0:16:39.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu keputusasaan?
Dialogue: 0,0:16:39.27,0:16:42.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran kami sangat kuat!
Dialogue: 0,0:16:48.56,0:16:50.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Stefan, terima kasih.
Dialogue: 0,0:16:50.80,0:16:51.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran.
Dialogue: 0,0:16:51.99,0:16:54.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah kamu ada di tim ini.
Dialogue: 0,0:16:58.10,0:17:01.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga, senang ada di tim kalian!
Dialogue: 0,0:17:06.80,0:17:08.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:17:08.33,0:17:10.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kalian tertawakan?
Dialogue: 0,0:17:10.83,0:17:13.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran, kita bisa lakukan sesuai rencana, kan?
Dialogue: 0,0:17:13.73,0:17:15.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, bisa.
Dialogue: 0,0:17:16.19,0:17:18.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkat Hades, aktif.
Dialogue: 0,0:17:18.98,0:17:22.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tongkat itu lagi?\NItu tak akan mempan lagi padaku!
Dialogue: 0,0:17:22.73,0:17:25.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Bagi jiwa-jiwa malang yang ditelan kebencian.\N- Stefan.
Dialogue: 0,0:17:25.75,0:17:28.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berdirilah di belakangku\Nsebelum rapalanku selesai.
Dialogue: 0,0:17:28.46,0:17:29.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan...
Dialogue: 0,0:17:31.70,0:17:34.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, serang para pengganggu itu!
Dialogue: 0,0:17:40.96,0:17:44.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perkuat Pelindung Mana!
Dialogue: 0,0:17:46.34,0:17:49.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan, aku akan melindungimu\Nsampai rapalanmu selesai.
Dialogue: 0,0:17:52.51,0:17:56.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagi jiwa-jiwa yang tak terselamatkan.\NIstirahatlah dengan tenang.
Dialogue: 0,0:18:00.73,0:18:02.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Percuma!
Dialogue: 0,0:18:02.48,0:18:06.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wahai Hades, beri dia berkatmu!
Dialogue: 0,0:18:08.42,0:18:10.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak akan kubiarkan kamu kabur lagi!
Dialogue: 0,0:18:10.07,0:18:12.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skill Taker!
Dialogue: 0,0:18:14.24,0:18:15.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:18:16.40,0:18:20.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skill Taker berhasil merampas\NSihir Ruang dan Waktu level 7.
Dialogue: 0,0:18:25.14,0:18:27.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang terjadi?
Dialogue: 0,0:18:28.45,0:18:31.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Ruang Waktu: Dimension Shift.
Dialogue: 0,0:18:31.46,0:18:32.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir untuk menghindari
Dialogue: 0,0:18:32.30,0:18:34.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}serangan dengan melakukan teleportasi
Dialogue: 0,0:18:34.34,0:18:36.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ke ruang dimensi lain\Ndalam waktu yang sangat singkat.
Dialogue: 0,0:18:37.25,0:18:39.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di ruang antiteleportasi ini,
Dialogue: 0,0:18:39.89,0:18:44.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hanya yang punya skill Pembatalan Segel\Nyang bisa melakukan trik itu.
Dialogue: 0,0:18:44.90,0:18:49.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena Sihir Ruang Waktu dia kita rebut,\Ndia tak bisa teleportasi lagi!
Dialogue: 0,0:18:49.40,0:18:52.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang kita akan serang dia habis-habisan!
Dialogue: 0,0:18:52.32,0:18:53.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasakan ini!
Dialogue: 0,0:18:57.18,0:19:00.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cahayanya mulai mengikis dan menelanku...
Dialogue: 0,0:19:01.38,0:19:07.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil! Aku lenyap tanpa sempat\Nmembalaskan dendamku?
Dialogue: 0,0:19:07.74,0:19:11.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sosok seperti diriku...
Dialogue: 0,0:19:18.06,0:19:19.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan!
Dialogue: 0,0:19:23.48,0:19:24.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih belum!
Dialogue: 0,0:19:25.44,0:19:26.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:19:29.48,0:19:32.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang benar saja!\NDia masih bisa bertahan?
Dialogue: 0,0:19:35.99,0:19:37.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jeritan?
Dialogue: 0,0:19:37.23,0:19:38.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini?
Dialogue: 0,0:19:39.60,0:19:42.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini... hawa dendam?
Dialogue: 0,0:19:42.64,0:19:43.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan!
Dialogue: 0,0:19:45.02,0:19:49.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master sedang menyerap seluruh dendam\Ndari penjuru dungeon.
Dialogue: 0,0:19:49.07,0:19:50.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:19:50.00,0:19:54.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hukum Ketidakmurnian Master adalah skill\Nyang menyerap dendam dari undead lain
Dialogue: 0,0:19:54.93,0:19:57.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan mengubahnya jadi skill-nya sendiri.
Dialogue: 0,0:19:57.55,0:20:01.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jumlah dendam luar biasa yang terbebas\Ndari Tungku Dendam dan hilangnya tujuan dia,
Dialogue: 0,0:20:01.81,0:20:04.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kini mengalir deras\Nmasuk ke dalam diri Master!
Dialogue: 0,0:20:04.52,0:20:07.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kelihatannya dia tidak sedang\Nmemulihkan dirinya!
Dialogue: 0,0:20:07.97,0:20:13.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Puluhan ribu dendam menyerbu sekaligus\Nhingga tubuhnya tak sanggup lagi menampungnya.
Dialogue: 0,0:20:15.21,0:20:18.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hawa dendam yang sangat pekat\Nsampai terbentuk wujud.
Dialogue: 0,0:20:18.03,0:20:22.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dibiarkan, kita semua akan terseret\Npusaran deras dendam itu!
Dialogue: 0,0:20:25.65,0:20:28.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar aku yang mengurus Tuan!
Dialogue: 0,0:20:28.04,0:20:30.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku tak sanggup melindungi kalian...
Dialogue: 0,0:20:34.05,0:20:36.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penghalang Mana!
Dialogue: 0,0:20:36.05,0:20:36.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran!
Dialogue: 0,0:20:37.46,0:20:39.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita juga keluarkan Penghalang Mana\Nkekuatan penuh!
Dialogue: 0,0:20:39.75,0:20:40.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satukan dengan punyaku!
Dialogue: 0,0:20:40.99,0:20:41.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:20:41.70,0:20:43.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Urushi, sembunyi di dalam bayangan!
Dialogue: 0,0:20:46.66,0:20:49.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya, semoga kalian selamat!
Dialogue: 0,0:20:50.40,0:20:53.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buat barier tambahan dengan Sihir Pemurnian!
Dialogue: 0,0:20:56.67,0:20:59.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski sudah ditahan barier,\Nbenturannya masih kuat!
Dialogue: 0,0:21:00.16,0:21:02.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita hanya bisa bertahan sampai ini mereda!
Dialogue: 0,0:21:03.31,0:21:05.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, apa badai ini akan mereda?
Dialogue: 0,0:21:08.05,0:21:09.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan patah semangat!
Dialogue: 0,0:21:10.21,0:21:13.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran, kita pasti pulang hidup-hidup!
Dialogue: 0,0:21:13.01,0:21:16.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, bersama Urushi, Jean, dan Stefan...
Dialogue: 0,0:21:17.70,0:21:19.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita semua... akan makan kari!
Dialogue: 0,0:21:19.74,0:21:20.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:21:21.52,0:21:23.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan cari jalan keluar.
Dialogue: 0,0:21:26.67,0:21:28.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dendamnya menghilang?
Dialogue: 0,0:21:32.77,0:21:34.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fran!
Dialogue: 0,0:21:34.77,0:21:37.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dendam itu sengaja datang\Nuntuk menghabisi kita!
Dialogue: 0,0:21:37.53,0:21:39.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perubahan Bentuk!
Dialogue: 0,0:21:42.45,0:21:43.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master...
Dialogue: 0,0:21:44.45,0:21:47.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial, gawat kalau terus begini...
Dialogue: 0,0:21:47.70,0:21:51.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, pasti ada jalan keluarnya...
Dialogue: 0,0:21:52.54,0:21:55.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ingat lagi...\NCari!
Dialogue: 0,0:21:57.09,0:21:58.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skill ini...
Dialogue: 0,0:21:59.26,0:22:00.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus bertaruh pada ini!
