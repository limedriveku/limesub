Dialogue: 0,0:00:26.80,0:00:30.89,sign,,0000,0000,0000,,DEPAN BENTENG ARCANTEZ
Dialogue: 0,0:00:32.68,0:00:35.31,sign,,0000,0000,0000,,CANSES BUNDLE
Dialogue: 0,0:00:38.81,0:00:41.56,sign,,0000,0000,0000,,BASAMARC SAREMAQUIA
Dialogue: 0,0:00:41.56,0:00:44.06,sign,,0000,0000,0000,,CRAN SAREMAQUIA
Dialogue: 0,0:02:10.32,0:02:15.99,sign,,0000,0000,0000,,AS A REINCARNATED ARISTOCRAT, I'LL USE MY\NAPPRAISAL SKILL TO RISE IN THE WORLD SEASON 3
Dialogue: 0,0:02:16.66,0:02:20.51,sign,,0000,0000,0000,,EPISODE 29: AKHIR DARI BASAMARC
Dialogue: 0,0:02:37.26,0:02:39.47,sign,,0000,0000,0000,,LEMAIRE PILES
Dialogue: 0,0:06:53.92,0:06:59.94,sign,,0000,0000,0000,,AS A REINCARNATED ARISTOCRAT, I'LL USE MY\NAPPRAISAL SKILL TO RISE IN THE WORLD SEASON 3
Dialogue: 0,0:07:37.35,0:07:40.05,sign,,0000,0000,0000,,ISTANA ARCANTEZ
Dialogue: 0,0:09:58.37,0:09:59.84,sign,,0000,0000,0000,,KEPEMIMPINAN 46, AMBISI 90, KEBERANIAN 58,
Dialogue: 0,0:09:59.84,0:10:01.22,sign,,0000,0000,0000,,KEBIJAKSANAAN 54, POLITIK 54
Dialogue: 0,0:10:01.22,0:10:03.38,sign,,0000,0000,0000,,INFANTERI C, KAVALERI B, SIHIR D, KONSTRUKSI D
Dialogue: 0,0:10:03.38,0:10:06.63,sign,,0000,0000,0000,,ANGKATAN LAUT C, ANGKATAN UDARA B
Dialogue: 0,0:14:01.86,0:14:04.87,sign,,0000,0000,0000,,NIAT CRAN
Dialogue: 0,0:18:33.51,0:18:36.76,sign,,0000,0000,0000,,ISTANA CANARRE
Dialogue: 0,0:18:36.76,0:18:40.89,sign,,0000,0000,0000,,RAPAT DARURAT
Dialogue: 0,0:23:37.60,0:23:42.42,sign,,0000,0000,0000,,SELANJUTNYA: FUJIMIYA
Dialogue: 0,0:00:00.53,0:00:01.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gubernur!
Dialogue: 0,0:00:01.98,0:00:05.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tidak bisa mengalahkan\NArs Louvent untuk saat ini!
Dialogue: 0,0:00:05.92,0:00:08.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah itu, Provinsi Seitz setuju
Dialogue: 0,0:00:08.24,0:00:12.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berdamai dengan syarat\Nyang menguntungkan Missian.
Dialogue: 0,0:00:13.38,0:00:18.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, karena Tuan Cran minta\Nuntuk fokus ke pemulihan rakyat,
Dialogue: 0,0:00:18.67,0:00:22.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami tidak ikut andil\Nmemerangi Tuan Basamarc
Dialogue: 0,0:00:22.64,0:00:24.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan kembali ke Canarre.
Dialogue: 0,0:00:39.36,0:00:41.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar pria keras kepala.
Dialogue: 0,0:00:42.18,0:00:44.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita akhiri,
Dialogue: 0,0:00:44.06,0:00:45.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}wahai adikku.
Dialogue: 0,0:02:20.51,0:02:22.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anda mau pergi?
Dialogue: 0,0:02:22.75,0:02:26.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akulah yang harus memenggalnya.
Dialogue: 0,0:02:26.46,0:02:28.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah bilang begitu, kan?
Dialogue: 0,0:02:29.07,0:02:31.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong urus sisanya, Remus.
Dialogue: 0,0:02:37.26,0:02:39.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini katapel pasukan Seitz?
Dialogue: 0,0:02:46.52,0:02:50.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasukan sihir buat formasi!\NLindungi para prajurit!
Dialogue: 0,0:02:50.36,0:02:53.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mandartom rudere malum!
Dialogue: 0,0:02:59.99,0:03:01.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mandartom
Dialogue: 0,0:03:01.34,0:03:03.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}rudere malum!
Dialogue: 0,0:03:04.24,0:03:06.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Cran, cairan sihirnya habis!
Dialogue: 0,0:03:06.56,0:03:09.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu, makanya kita harus maju!
Dialogue: 0,0:03:09.66,0:03:12.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus menerobos mereka\Nkalau mau menang!
Dialogue: 0,0:03:13.39,0:03:16.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir pertahananmu ada batasnya.
Dialogue: 0,0:03:16.62,0:03:20.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau mundur atau lanjut?\NPilihlah, Cran!
Dialogue: 0,0:03:20.60,0:03:22.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ikuti aku!
Dialogue: 0,0:03:22.30,0:03:23.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Cran!
Dialogue: 0,0:03:23.98,0:03:25.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minggir!
Dialogue: 0,0:03:31.27,0:03:33.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasukan Pemanah, maju!
Dialogue: 0,0:03:47.70,0:03:48.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Cran!
Dialogue: 0,0:03:56.27,0:03:57.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Basamarc!
Dialogue: 0,0:04:01.30,0:04:05.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cran, kamu memang pria\Nyang memercayai diri sendiri.
Dialogue: 0,0:04:05.92,0:04:07.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersiaplah!
Dialogue: 0,0:04:16.26,0:04:17.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Lenge!
Dialogue: 0,0:04:17.95,0:04:22.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akulah anak Cran Saremaquia,\NLenge Saremaquia!
Dialogue: 0,0:04:22.70,0:04:25.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rekan pun akan kutebas kalau menghalangi!
Dialogue: 0,0:04:26.90,0:04:28.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Majulah, Cran!
Dialogue: 0,0:04:28.99,0:04:33.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Missian dan rakyatnya\Ntidak akan kuserahkan!
Dialogue: 0,0:04:33.66,0:04:36.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kuakhiri ambisimu!
Dialogue: 0,0:04:39.68,0:04:42.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu cuma mau bilang itu?
Dialogue: 0,0:04:42.18,0:04:44.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Missian adalah milikku.
Dialogue: 0,0:04:44.46,0:04:46.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi akan kuambil!
Dialogue: 0,0:04:46.06,0:04:48.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar bodoh!
Dialogue: 0,0:04:48.06,0:04:49.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berisik!
Dialogue: 0,0:05:01.30,0:05:04.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya pedangmu mampu\Nmelindungi tanah ini?
Dialogue: 0,0:05:07.15,0:05:08.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Basamarc!
Dialogue: 0,0:05:08.34,0:05:09.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Canses!
Dialogue: 0,0:05:09.68,0:05:12.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Cran, bersiaplah!
Dialogue: 0,0:05:12.29,0:05:14.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minggir, Canses!
Dialogue: 0,0:05:14.93,0:05:17.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong jaga Missian.
Dialogue: 0,0:05:18.17,0:05:19.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Canses!
Dialogue: 0,0:05:23.62,0:05:24.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Canses!
Dialogue: 0,0:05:30.61,0:05:32.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Lenge!
Dialogue: 0,0:05:46.58,0:05:48.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah!
Dialogue: 0,0:05:55.58,0:05:56.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah...
Dialogue: 0,0:06:00.38,0:06:02.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Cran baik-baik saja?
Dialogue: 0,0:06:02.30,0:06:03.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:06:17.06,0:06:18.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Canses...
Dialogue: 0,0:06:23.39,0:06:27.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Adik bodohku, kamu telah kalah.
Dialogue: 0,0:06:34.35,0:06:35.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bawa dia!
Dialogue: 0,0:06:36.30,0:06:39.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kabari semuanya, perang telah selesai!
Dialogue: 0,0:06:39.98,0:06:42.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Missian telah jadi milikku!
Dialogue: 0,0:06:45.55,0:06:48.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perang suksesi Missian yang berkepanjangan
Dialogue: 0,0:06:49.46,0:06:53.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berakhir dengan kekalahan Basamarc.
Dialogue: 0,0:07:00.34,0:07:01.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah terlihat.
Dialogue: 0,0:07:01.79,0:07:04.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu ibu kota, Arcantez?
Dialogue: 0,0:07:04.88,0:07:07.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah lama tidak ke sini.
Dialogue: 0,0:07:07.95,0:07:12.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul juga, dulu kamu pernah\Nbekerja di istana Arcantez, ya.
Dialogue: 0,0:07:12.98,0:07:18.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Ars, aku belum rela wanita ini mangkir\Ndari tugasnya di Lamberg
Dialogue: 0,0:07:18.38,0:07:20.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan malah ikut kemari!
Dialogue: 0,0:07:20.13,0:07:23.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan kaku begitu, dong, Rietz.
Dialogue: 0,0:07:23.15,0:07:25.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ada sedikit urusan.
Dialogue: 0,0:07:38.67,0:07:40.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf menunggu lama,
Dialogue: 0,0:07:40.05,0:07:41.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Ars Louvent.
Dialogue: 0,0:07:41.86,0:07:45.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon tunggu panggilan petugas.
Dialogue: 0,0:07:46.65,0:07:49.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ars, lama tidak berjumpa!
Dialogue: 0,0:07:49.41,0:07:50.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Lenge?
Dialogue: 0,0:07:50.90,0:07:52.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa Tuan Lenge kemari?
Dialogue: 0,0:07:52.91,0:07:55.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa, ini temanku!
Dialogue: 0,0:07:55.44,0:07:58.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu masih kecil saja, ya!
Dialogue: 0,0:07:58.14,0:08:00.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senang melihatmu sehat-sehat saja.
Dialogue: 0,0:08:00.11,0:08:02.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, biar kuantar.
Dialogue: 0,0:08:02.82,0:08:05.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya tidak sabar menemuimu, lo!
Dialogue: 0,0:08:10.89,0:08:12.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ars Louvent.
Dialogue: 0,0:08:12.16,0:08:13.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu Ars Louvent!
Dialogue: 0,0:08:13.89,0:08:16.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pria penyelamat Missian telah tiba!
Dialogue: 0,0:08:19.19,0:08:21.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu jadi buah bibir, lo.
Dialogue: 0,0:08:21.22,0:08:23.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu menghalau pasukan Seitz, kan?
Dialogue: 0,0:08:23.50,0:08:25.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami sangat berterima kasih.
Dialogue: 0,0:08:25.66,0:08:27.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Te-Terima kasih!
Dialogue: 0,0:08:27.45,0:08:29.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pahlawan Canarre datang, ya.
Dialogue: 0,0:08:30.99,0:08:32.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:08:32.65,0:08:35.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya, terima kasih sudah datang.
Dialogue: 0,0:08:35.85,0:08:38.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari rayakan kemenangan kita!
Dialogue: 0,0:08:39.95,0:08:44.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perang suksesi Missian yang panjang\Nakhirnya selesai.
Dialogue: 0,0:08:44.38,0:08:46.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini adalah perayaannya.
Dialogue: 0,0:08:59.56,0:09:03.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, kamu kelihatan murung, ya.
Dialogue: 0,0:09:03.81,0:09:05.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mireille?
Dialogue: 0,0:09:07.46,0:09:10.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya, terima kasih sudah mengikutiku.
Dialogue: 0,0:09:11.22,0:09:13.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita mulai dari penghargaan.
Dialogue: 0,0:09:13.89,0:09:16.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ars Louvent akan kuberikan hadiah
Dialogue: 0,0:09:17.15,0:09:20.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena paling berjasa di sini.
Dialogue: 0,0:09:20.14,0:09:21.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:09:21.50,0:09:24.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Te-Terima kasih, aku merasa terhormat!
Dialogue: 0,0:09:24.34,0:09:28.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak pernah gagal membuatku takjub.
Dialogue: 0,0:09:28.42,0:09:30.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertahankan, ya.
Dialogue: 0,0:09:30.09,0:09:31.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:09:31.59,0:09:35.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin memperkenalkan orang baru.
Dialogue: 0,0:09:42.10,0:09:48.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu dari tiga kota besar,\NSemplar akan dikelola Lenge Saremaquia.
Dialogue: 0,0:09:50.24,0:09:52.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Lenge jadi pemimpin?
Dialogue: 0,0:09:52.67,0:09:55.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keputusan yang berani, ya.
Dialogue: 0,0:09:55.02,0:09:56.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa?
Dialogue: 0,0:09:58.37,0:10:01.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Lenge pasti bisa.
Dialogue: 0,0:10:01.22,0:10:03.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nilainya naik dibanding dulu.
Dialogue: 0,0:10:03.38,0:10:06.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia telah bekerja keras sejak saat itu.
Dialogue: 0,0:10:06.63,0:10:08.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita menang perang.
Dialogue: 0,0:10:08.71,0:10:12.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi pembangunan baru saja dimulai.
Dialogue: 0,0:10:12.82,0:10:17.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Missian akan kita jadikan negara\Nyang makmur dan sejahtera!
Dialogue: 0,0:10:19.81,0:10:24.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya Missian telah lepas\Ndari belenggu perang.
Dialogue: 0,0:10:24.65,0:10:26.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:10:26.15,0:10:28.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma fokus menjaga wilayah sendiri
Dialogue: 0,0:10:28.85,0:10:32.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sejak terlahir jadi anak pemimpin wilayah.
Dialogue: 0,0:10:33.26,0:10:39.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa saja nanti ada perang saudara\Natau bentrok dengan provinsi lain.
Dialogue: 0,0:10:40.59,0:10:45.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski musuh, rasanya berat melawan\Nsesama rakyat Missian.
Dialogue: 0,0:10:45.66,0:10:49.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiap aku mengayun pedang,\Nwajah mereka terlihat meringis.
Dialogue: 0,0:10:49.92,0:10:54.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal mereka pun berjuang\Ndemi melindungi dan demi keadilan.
Dialogue: 0,0:10:54.17,0:10:55.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Ars...
Dialogue: 0,0:10:56.09,0:10:59.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kedamaian ini buah dari banyak pengorbanan.
Dialogue: 0,0:10:59.86,0:11:01.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan hal ringan.
Dialogue: 0,0:11:01.71,0:11:03.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita lindungi.
Dialogue: 0,0:11:03.68,0:11:04.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:11:05.56,0:11:10.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, aku belum membahas\Npemberontakan Basamarc.
Dialogue: 0,0:11:11.57,0:11:15.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah Basamarc kukalahkan,
Dialogue: 0,0:11:15.80,0:11:18.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sekarang dia akan dihukum mati.
Dialogue: 0,0:11:21.70,0:11:24.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Basamarc adalah adikku yang berbakat.
Dialogue: 0,0:11:24.70,0:11:29.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pembangunan negeri pasti lebih cepat\Nkalau dia tetap hidup.
Dialogue: 0,0:11:30.34,0:11:34.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku tidak bisa memaafkannya!
Dialogue: 0,0:11:35.07,0:11:41.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru karena sedarah, tindakan\Nmelawan kakaknya tidak bisa diampuni!
Dialogue: 0,0:11:41.92,0:11:44.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama Basamarc hidup,
Dialogue: 0,0:11:44.94,0:11:48.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}posisi gubernur tidak akan kokoh!
Dialogue: 0,0:11:49.10,0:11:52.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, Basamarc akan dipenggal!
Dialogue: 0,0:12:07.62,0:12:12.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemenggalan Basamarc Saremaquia\Nakan dilaksanakan!
Dialogue: 0,0:12:12.13,0:12:13.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bawa pelakunya!
Dialogue: 0,0:12:25.31,0:12:27.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi itu, Tuan Basamarc...
Dialogue: 0,0:12:29.33,0:12:32.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski dia dalang peperangannya,
Dialogue: 0,0:12:32.15,0:12:34.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dipenggal itu hukuman berat.
Dialogue: 0,0:12:34.34,0:12:37.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Ars tidak perlu menyaksikannya.
Dialogue: 0,0:12:38.51,0:12:42.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, Rietz, dialah lawan kita selama ini.
Dialogue: 0,0:12:43.15,0:12:47.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi para korban yang gugur,\Naku harus menyaksikan hingga akhir.
Dialogue: 0,0:12:47.91,0:12:51.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Warga Missian, kalian akan kuramal!
Dialogue: 0,0:12:52.11,0:12:54.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Missian akan terpecah belah!
Dialogue: 0,0:12:57.60,0:13:02.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pihak yang kalah\Ndan itu bukan masalah!
Dialogue: 0,0:13:02.26,0:13:05.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, percuma saja membunuhku!
Dialogue: 0,0:13:05.93,0:13:07.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sumber masalahnya!
Dialogue: 0,0:13:08.37,0:13:10.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cran Saremaquia!
Dialogue: 0,0:13:10.19,0:13:14.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dipimpin olehnya,\Nnegeri ini pasti hancur!
Dialogue: 0,0:13:17.12,0:13:18.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pikirkan baik-baik!
Dialogue: 0,0:13:18.99,0:13:24.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa justru aku\Nyang dijadikan pewaris oleh Ayah?
Dialogue: 0,0:13:24.78,0:13:28.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma aku yang tahu sifat asli pria itu!
Dialogue: 0,0:13:29.54,0:13:32.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian akan menyesal kalau sudah tahu.
Dialogue: 0,0:13:35.71,0:13:40.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keruntuhan Missian\Nterbayang jelas di mataku.
Dialogue: 0,0:13:55.36,0:14:00.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak itu, Provinsi Missian\Nbersatu sepenuhnya.
Dialogue: 0,0:14:04.87,0:14:08.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf memanggilmu sore-sore begini.
Dialogue: 0,0:14:08.40,0:14:11.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan masalah, Tuan ada perlu apa?
Dialogue: 0,0:14:11.12,0:14:13.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini soal putraku.
Dialogue: 0,0:14:13.44,0:14:17.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Menurutmu, Lenge ada perkembangan?\N- Ayah!
Dialogue: 0,0:14:18.08,0:14:22.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu, perkembangannya pun pesat!
Dialogue: 0,0:14:22.45,0:14:24.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja kerasnya terlihat jelas!
Dialogue: 0,0:14:24.89,0:14:27.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be-Benarkah?\NAh, aku jadi lega.
Dialogue: 0,0:14:28.87,0:14:32.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga kita bisa\Nmenjaga Missian tetap damai.
Dialogue: 0,0:14:33.36,0:14:34.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Damai, ya.
Dialogue: 0,0:14:34.90,0:14:36.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ars.
Dialogue: 0,0:14:37.04,0:14:39.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu benci peperangan?
Dialogue: 0,0:14:39.90,0:14:43.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makin sedikit yang terluka,\Nmakin bagus.
Dialogue: 0,0:14:48.83,0:14:51.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Cran tidak berpikir begitu?
Dialogue: 0,0:14:55.79,0:14:59.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan konyol, mana ada orang\Nyang suka perang.
Dialogue: 0,0:14:59.92,0:15:04.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be-Betul juga!\NLebih baik tidak ada perang.
Dialogue: 0,0:15:04.68,0:15:07.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, itu diperlukan.
Dialogue: 0,0:15:09.18,0:15:13.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tahu kenapa terjadi perang\Ndi tiap wilayah?
Dialogue: 0,0:15:14.05,0:15:18.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benua Summerforth terbagi\Njadi tujuh negara.
Dialogue: 0,0:15:18.06,0:15:23.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, bukan berarti perang sudah sesering ini
Dialogue: 0,0:15:23.87,0:15:26.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebelum Kekaisaran berdiri.
Dialogue: 0,0:15:26.00,0:15:27.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:15:27.98,0:15:31.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja ada perang di beberapa tempat.
Dialogue: 0,0:15:31.06,0:15:35.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi mereka damai setelah membuat\Nperjanjian setara.
Dialogue: 0,0:15:35.94,0:15:41.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi setelah satu komando\Ndan keluarga kekaisaran melemah,
Dialogue: 0,0:15:41.07,0:15:45.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}konflik besar mulai pecah\Ndi penjuru kekaisaran.
Dialogue: 0,0:15:45.97,0:15:51.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti, Kekaisaran Summerforth\Nadalah sumber konfliknya?
Dialogue: 0,0:15:51.09,0:15:52.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul.
Dialogue: 0,0:15:52.88,0:15:58.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak kecil, aku sudah melihat perang\Ndi luar maupun dalam Missian.
Dialogue: 0,0:15:59.10,0:16:03.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu aku tersadar, wajar terjadi perang.
Dialogue: 0,0:16:03.39,0:16:06.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiap provinsi berasal dari negara berbeda.
Dialogue: 0,0:16:06.38,0:16:09.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil bisa harmonis.
Dialogue: 0,0:16:09.84,0:16:13.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang-orang pikir kedamaian sejati
Dialogue: 0,0:16:13.30,0:16:17.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah saat semua provinsi hidup harmonis.
Dialogue: 0,0:16:17.89,0:16:24.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kalau salah satu provinsi menguat,\Nkeseimbangan akan runtuh.
Dialogue: 0,0:16:24.03,0:16:28.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan saling membatasi\Nsebagai negeri berbeda,
Dialogue: 0,0:16:28.06,0:16:31.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menurutku kedamaian akan tercipta.
Dialogue: 0,0:16:32.40,0:16:37.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau terus perang internal,\NSummerforth akan melemah
Dialogue: 0,0:16:37.94,0:16:40.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan malah dijajah benua lain.
Dialogue: 0,0:16:41.73,0:16:45.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu akan jadi konflik yang lebih tragis.
Dialogue: 0,0:16:46.28,0:16:50.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi gubernur demi mencegah itu.
Dialogue: 0,0:16:52.41,0:16:55.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Walau akan memicu perang
Dialogue: 0,0:16:55.52,0:16:59.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan mungkin menyengsarakan Missian,
Dialogue: 0,0:17:00.02,0:17:04.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ini diperlukan demi kedamaian sejati.
Dialogue: 0,0:17:04.29,0:17:07.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ars, kamu telah makin kuat.
Dialogue: 0,0:17:07.57,0:17:08.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:17:08.55,0:17:11.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu makin kuat setelah berperang.
Dialogue: 0,0:17:11.20,0:17:16.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin kamu tidak akan sehebat ini\Nkalau tidak ada perang.
Dialogue: 0,0:17:17.68,0:17:22.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perang memang terlihat merugikan.
Dialogue: 0,0:17:22.10,0:17:27.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi sebagai pembangun negara,\Nkita harus bisa melihat keuntungannya.
Dialogue: 0,0:17:28.16,0:17:30.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa pendapatmu, Ars?
Dialogue: 0,0:17:30.82,0:17:35.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku paham pemikiran Tuan Cran,\Ntapi...
Dialogue: 0,0:17:35.74,0:17:40.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah kedamaian\Ncuma bisa diraih lewat perang?
Dialogue: 0,0:17:41.50,0:17:42.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu...
Dialogue: 0,0:17:43.08,0:17:48.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah, itu cuma akan\Nmengulang hal yang sama?
Dialogue: 0,0:17:49.92,0:17:52.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan murung begitu.
Dialogue: 0,0:17:52.21,0:17:54.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu itu bawahan berhargaku.
Dialogue: 0,0:17:54.32,0:17:58.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma ingin bertukar pikiran.
Dialogue: 0,0:17:59.73,0:18:04.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski aku penasaran pendapatmu,\Njawab saja nanti kalau sudah tahu.
Dialogue: 0,0:18:04.88,0:18:09.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke manakah Missian harus melaju.
Dialogue: 0,0:18:13.36,0:18:18.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Ars, ada apa?\NAnda terlihat murung.
Dialogue: 0,0:18:18.51,0:18:21.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin karena kamu overprotektif.
Dialogue: 0,0:18:21.74,0:18:22.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa katamu?
Dialogue: 0,0:18:22.80,0:18:25.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rietz, Mireille.
Dialogue: 0,0:18:25.56,0:18:28.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisakah kita berkumpul setelah pulang?
Dialogue: 0,0:18:28.27,0:18:30.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang ingin kubicarakan.
Dialogue: 0,0:18:30.70,0:18:32.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal Keluarga Louvent ke depannya.
Dialogue: 0,0:18:36.76,0:18:40.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Cran bilang begitu?
Dialogue: 0,0:18:40.10,0:18:40.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:18:40.89,0:18:45.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah karena apa,\Ndia bersikeras ingin merdeka.
Dialogue: 0,0:18:45.47,0:18:48.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa, tidak lama lagi\Nitu akan dia proklamasikan.
Dialogue: 0,0:18:48.90,0:18:54.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan begitu, Missian akan berkonflik lagi.
Dialogue: 0,0:18:57.16,0:19:02.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya, aku ingin diskusi\Nsoal Keluarga Louvent ke depannya.
Dialogue: 0,0:19:02.41,0:19:05.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa tidak boleh merdeka?\NKita kan kuat?
Dialogue: 0,0:19:05.92,0:19:10.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau merdeka, Seitz akan punya alasan\Nbuat menyerang kita lagi!
Dialogue: 0,0:19:10.72,0:19:12.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}O-Oh, begitu?
Dialogue: 0,0:19:12.64,0:19:16.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Missian bersatu berkat bantuan\NProvinsi Paradille yang memihak kaisar.
Dialogue: 0,0:19:16.99,0:19:21.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau merdeka, kita akan dimusuhi\Nsebagai pengkhianat.
Dialogue: 0,0:19:21.56,0:19:27.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa saja keluarga kekaisaran membentuk\Npasukan gabungan untuk membasmi Missian.
Dialogue: 0,0:19:27.56,0:19:31.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, padahal baru damai,
Dialogue: 0,0:19:31.28,0:19:33.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita akan perang lagi?
Dialogue: 0,0:19:37.70,0:19:42.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, lagi pula kedamaian sejati\Nsudah seperti dongeng.
Dialogue: 0,0:19:42.70,0:19:47.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dilihat dari sejarahnya pun,\Nselalu saja ada perang.
Dialogue: 0,0:19:47.23,0:19:49.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perang pasti terjadi.
Dialogue: 0,0:19:49.66,0:19:54.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Negara-negara yang imbang\Nperang dengan skala tertentu,
Dialogue: 0,0:19:54.21,0:19:57.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan menjaga kedamaian seadanya.
Dialogue: 0,0:19:58.00,0:20:02.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu lebih realistis, seperti kata Cran.
Dialogue: 0,0:20:03.30,0:20:05.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:20:05.74,0:20:10.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah damai permanen itu mustahil?
Dialogue: 0,0:20:11.55,0:20:14.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita punya orang-orang hebat.
Dialogue: 0,0:20:14.83,0:20:19.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua krisis berhasil diatasi\Nberkat kerja keras kalian.
Dialogue: 0,0:20:19.71,0:20:23.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski kemungkinannya kecil,\Naku ingin kita mencobanya!
Dialogue: 0,0:20:23.74,0:20:26.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu serius?
Dialogue: 0,0:20:26.66,0:20:30.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menjaga kedamaian lebih perlu kekuatan\Ndibanding perang, lo.
Dialogue: 0,0:20:31.44,0:20:34.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harus bisa menguasai seisi benua.
Dialogue: 0,0:20:34.75,0:20:37.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yaitu sebagai kaisar.
Dialogue: 0,0:20:38.38,0:20:42.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sulit dan belum pernah ada yang bisa.
Dialogue: 0,0:20:42.90,0:20:47.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku yakin kamu bisa.
Dialogue: 0,0:20:48.64,0:20:50.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu, Mireille!
Dialogue: 0,0:20:50.34,0:20:54.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus pikirkan cara agar Tuan Ars\Nmakin bersinar!
Dialogue: 0,0:20:54.90,0:20:59.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya itu yang bisa kulakukan\Ndemi Tuan Ars!
Dialogue: 0,0:20:59.03,0:21:00.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rosell...
Dialogue: 0,0:21:00.82,0:21:02.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ars.
Dialogue: 0,0:21:02.66,0:21:06.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih ingat janjimu padaku dulu?
Dialogue: 0,0:21:06.29,0:21:10.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membuat tempat untuk anak-anak\Nbisa punya mimpi, kan?
Dialogue: 0,0:21:10.70,0:21:12.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak pernah lupa.
Dialogue: 0,0:21:12.67,0:21:16.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti aku cuma harus mengikutimu.
Dialogue: 0,0:21:16.42,0:21:18.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Charlotte...
Dialogue: 0,0:21:18.34,0:21:22.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kedamaian permanen mungkin bagaikan mimpi.
Dialogue: 0,0:21:22.80,0:21:27.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi punya cita-cita itu di dunia\Nyang penuh perang ini
Dialogue: 0,0:21:27.74,0:21:30.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah hal luar biasa.
Dialogue: 0,0:21:30.29,0:21:34.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah yang membuatku menghormatimu.
Dialogue: 0,0:21:37.95,0:21:40.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya, terima kasih!
Dialogue: 0,0:21:41.46,0:21:42.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kaisar...
Dialogue: 0,0:21:44.22,0:21:47.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong ikuti aku!
Dialogue: 0,0:23:25.74,0:23:30.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, kudengar Tuan Ars\Nberbuat nekat di perang kali ini.
Dialogue: 0,0:23:30.16,0:23:32.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah kamu marah?
Dialogue: 0,0:23:32.48,0:23:35.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Izinkan aku ceramah sebagai istri Bupati!
Dialogue: 0,0:23:35.39,0:23:36.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Izin kabur!
Dialogue: 0,0:23:36.27,0:23:37.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya, "Fujimiya".
Dialogue: 0,0:23:37.60,0:23:39.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan kabur!
