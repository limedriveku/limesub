Dialogue: 0,0:00:01.02,0:00:02.90,sign,,0000,0000,0000,,ISTANA ARCANTEZ
Dialogue: 0,0:00:02.90,0:00:06.16,sign,,0000,0000,0000,,TARGET PASUKAN SEITZ
Dialogue: 0,0:00:09.91,0:00:13.53,sign,,0000,0000,0000,,GUBERNUR PROVINSI SEITZ, GLENDA DOMARTSON
Dialogue: 0,0:00:13.53,0:00:16.18,sign,,0000,0000,0000,,BASAMARC SAREMAQUIA
Dialogue: 0,0:00:52.32,0:00:57.83,sign,,0000,0000,0000,,BOROTTS HEIGAND
Dialogue: 0,0:04:49.27,0:04:55.02,sign,,0000,0000,0000,,AS A REINCARNATED ARISTOCRAT, I'LL USE MY\NAPPRAISAL SKILL TO RISE IN THE WORLD SEASON 3
Dialogue: 0,0:04:55.02,0:04:59.36,sign,,0000,0000,0000,,EPISODE 26: CANARRE DALAM BAHAYA
Dialogue: 0,0:08:52.43,0:08:54.56,sign,,0000,0000,0000,,SATU MINGGU KEMUDIAN
Dialogue: 0,0:11:45.68,0:11:47.10,sign,,0000,0000,0000,,AS A REINCARNATED ARISTOCRAT, I'LL USE MY
Dialogue: 0,0:11:47.10,0:11:49.20,sign,,0000,0000,0000,,APPRAISAL SKILL TO RISE IN THE WORLD SEASON 3
Dialogue: 0,0:13:20.32,0:13:23.37,sign,,0000,0000,0000,,MALAM SEBELUM PERANG
Dialogue: 0,0:15:22.11,0:15:26.07,sign,,0000,0000,0000,,RASA TAKUT
Dialogue: 0,0:17:40.25,0:17:44.25,sign,,0000,0000,0000,,SUNGAI KHMER
Dialogue: 0,0:17:46.34,0:17:49.01,sign,,0000,0000,0000,,JENDERAL MUSUH, RANTOLK RODDER
Dialogue: 0,0:18:59.15,0:19:03.52,sign,,0000,0000,0000,,TEKAD MUSHA
Dialogue: 0,0:23:38.06,0:23:42.61,sign,,0000,0000,0000,,SELANJUTNYA: ZAT DAN BRAHAM
Dialogue: 0,0:00:02.90,0:00:06.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari rayakan aliansi kita
Dialogue: 0,0:00:06.16,0:00:09.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan pelantikanmu jadi gubernur Provinsi Seitz.
Dialogue: 0,0:00:09.91,0:00:13.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belum terbiasa disebut gubernur.
Dialogue: 0,0:00:13.53,0:00:16.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak seperti gubernur sebelumnya,
Dialogue: 0,0:00:16.18,0:00:19.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}terima kasih sudah mau beraliansi dengan kami.
Dialogue: 0,0:00:19.54,0:00:25.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin berhubungan baik\Ndengan calon gubernur Missian.
Dialogue: 0,0:00:25.04,0:00:28.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi tujuan kita sejalan.
Dialogue: 0,0:00:28.04,0:00:34.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atas nama martabat Seitz,\Nkami akan membantu rencana Tuan Basamarc.
Dialogue: 0,0:00:34.18,0:00:38.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin Canarre dipisahkan dari Missian.
Dialogue: 0,0:00:38.38,0:00:42.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan Canarre terlalu besar\Nbagi sebuah kabupaten.
Dialogue: 0,0:00:42.67,0:00:45.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong hambat pergerakan mereka.
Dialogue: 0,0:00:52.32,0:00:54.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia Borotts, bawahanku.
Dialogue: 0,0:00:54.83,0:00:57.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Panglima pemberontakan kami sebelumnya.
Dialogue: 0,0:00:57.83,0:01:00.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senang bertemu Anda.
Dialogue: 0,0:01:00.33,0:01:03.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia juga akan memimpin invasi ke Canarre.
Dialogue: 0,0:01:03.90,0:01:07.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami akan mengerahkan 80.000 prajurit.
Dialogue: 0,0:01:07.46,0:01:12.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak sekali, ya.\NItu 10 kali lipatnya pasukan Canarre.
Dialogue: 0,0:01:12.96,0:01:17.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya ada yang aku incar di Canarre.
Dialogue: 0,0:01:18.86,0:01:22.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu ingin bahan pangan, sumber daya,
Dialogue: 0,0:01:22.93,0:01:27.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan semua rampasan dari invasi Canarre, kan?
Dialogue: 0,0:01:27.23,0:01:29.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, itu saja.
Dialogue: 0,0:01:29.74,0:01:32.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mau kekuatan tempur mereka?
Dialogue: 0,0:01:32.85,0:01:34.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Izin undur diri.
Dialogue: 0,0:01:35.24,0:01:39.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami ingin segera bersiap.
Dialogue: 0,0:01:39.20,0:01:41.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau boleh tahu,
Dialogue: 0,0:01:41.65,0:01:47.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa tujuanmu jadi gubernur Missian?\NUntuk merdeka?
Dialogue: 0,0:01:48.56,0:01:52.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cran itu pria menyedihkan yang sulit\Nmemercayai orang lain.
Dialogue: 0,0:01:52.82,0:01:55.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan keluarganya sendiri.
Dialogue: 0,0:01:55.76,0:02:00.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin melindungi tanah air\Ndan rakyat yang Ayah jaga.
Dialogue: 0,0:02:00.11,0:02:01.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu saja.
Dialogue: 0,0:02:02.85,0:02:05.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami akan menaklukkan Canarre.
Dialogue: 0,0:02:05.67,0:02:10.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan tuntaskan urusan dengan kakakmu.
Dialogue: 0,0:02:16.24,0:02:20.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Borotts, kumpulkan pasukan dari seluruh Seitz.
Dialogue: 0,0:02:20.86,0:02:22.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Gubernur.
Dialogue: 0,0:02:22.99,0:02:27.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perang kali ini\Ntidak ada untungnya buat kita.
Dialogue: 0,0:02:28.05,0:02:32.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wilayah dan sumber dayanya tidak seberapa.
Dialogue: 0,0:02:32.26,0:02:36.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita baru saja perang saudara,\Nkenapa tidak minta lebih?
Dialogue: 0,0:02:36.00,0:02:37.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Borotts.
Dialogue: 0,0:02:37.79,0:02:41.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tahu pria bernama Ars Louvent?
Dialogue: 0,0:02:41.62,0:02:44.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bupati Canarre itu kenapa?
Dialogue: 0,0:02:44.08,0:02:49.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Usianya baru 13.\NTidak masuk akal, kan?
Dialogue: 0,0:02:49.12,0:02:53.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar, dia anak ajaib\Nyang bisa melihat bakat orang lain.
Dialogue: 0,0:02:54.30,0:02:56.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melihat bakat?
Dialogue: 0,0:02:56.61,0:03:01.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat kutelusuri,\Npengikutnya memang hebat-hebat.
Dialogue: 0,0:03:01.83,0:03:08.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin menaklukkan Canarre\Ndan mendapatkan Ars Louvent!
Dialogue: 0,0:03:08.38,0:03:12.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengandalkanmu,
Dialogue: 0,0:03:12.38,0:03:14.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}wahai tangan kananku.
Dialogue: 0,0:03:18.78,0:03:20.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ars Louvent...
Dialogue: 0,0:03:21.47,0:03:24.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang seperti apa dia?
Dialogue: 0,0:04:56.48,0:04:59.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inilah inti pesan Tuan Kral.
Dialogue: 0,0:04:59.87,0:05:06.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Provinsi Seitz mengirim sekitar 80.000 prajurit\Nke dekat perbatasan Provinsi Missian.
Dialogue: 0,0:05:06.48,0:05:09.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon segera bertindak."
Dialogue: 0,0:05:09.37,0:05:12.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}80.000? Benarkah?
Dialogue: 0,0:05:12.37,0:05:14.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu 10 kali lipatnya pasukan Canarre.
Dialogue: 0,0:05:15.09,0:05:20.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau itu benar, pasukan Khmer\Ntidak akan berkutik.
Dialogue: 0,0:05:20.88,0:05:23.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kenapa Provinsi Seitz?
Dialogue: 0,0:05:23.54,0:05:26.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka baru saja perang saudara, kan?
Dialogue: 0,0:05:26.74,0:05:27.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:05:28.38,0:05:34.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita sempat diam-diam membuat perjanjian damai\Ndengan Seitz yang sedang berperang.
Dialogue: 0,0:05:34.14,0:05:35.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi,
Dialogue: 0,0:05:35.06,0:05:39.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}gubernur sebelumnya diusir oleh sang bawahan.
Dialogue: 0,0:05:39.59,0:05:41.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemberontakannya berhasil.
Dialogue: 0,0:05:41.70,0:05:44.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akibatnya, perjanjian kita batal.
Dialogue: 0,0:05:45.50,0:05:47.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kenapa harus sekarang?
Dialogue: 0,0:05:47.98,0:05:52.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya kondisi mereka belum stabil.
Dialogue: 0,0:05:52.21,0:05:54.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Firasatku tidak enak.
Dialogue: 0,0:05:55.06,0:05:59.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rencananya, kamu mau bergabung\Ndengan pasukan Cran, kan?
Dialogue: 0,0:05:59.70,0:06:00.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:06:00.91,0:06:04.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya Seitz tidak asal bergerak.
Dialogue: 0,0:06:04.46,0:06:06.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada dalang di balik ini semua.
Dialogue: 0,0:06:07.79,0:06:09.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, aku terlambat.
Dialogue: 0,0:06:09.64,0:06:13.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fam, seperti apa pasukan musuh?
Dialogue: 0,0:06:13.78,0:06:15.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa dibilang...
Dialogue: 0,0:06:15.74,0:06:19.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat, aku baru lihat pasukan sebanyak itu.
Dialogue: 0,0:06:19.31,0:06:21.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Panglimanya pun hebat.
Dialogue: 0,0:06:21.12,0:06:23.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar, di perang sebelumnya,
Dialogue: 0,0:06:23.86,0:06:26.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia membantai 100.000 musuh\Nhanya dengan 50.000 prajurit.
Dialogue: 0,0:06:26.56,0:06:27.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu...
Dialogue: 0,0:06:28.45,0:06:29.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini
Dialogue: 0,0:06:30.02,0:06:32.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}batu sihir api, kan?
Dialogue: 0,0:06:32.18,0:06:33.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan...
Dialogue: 0,0:06:33.21,0:06:38.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, Seitz tidak punya batu sihir api.
Dialogue: 0,0:06:38.46,0:06:42.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat aku coba telusuri, ternyata benar.
Dialogue: 0,0:06:42.40,0:06:45.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di waktu yang sama dengan gerakan Seitz,
Dialogue: 0,0:06:45.38,0:06:48.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Basamarc mengirim pasukan ke Verzud.
Dialogue: 0,0:06:48.47,0:06:54.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga, Basamarc beraliansi\Ndengan Gubernur Baru Seitz.
Dialogue: 0,0:06:54.85,0:06:57.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita dalam bahaya?
Dialogue: 0,0:06:57.10,0:07:01.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan begitu, Tuan Cran\Ntidak bisa membantu kita.
Dialogue: 0,0:07:01.70,0:07:06.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus melawan 80.000 prajurit\Ntanpa bala bantuan.
Dialogue: 0,0:07:07.39,0:07:10.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana dengan sistem pertahanan kita?
Dialogue: 0,0:07:10.51,0:07:15.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski yang bertahan diuntungkan,\Nfasilitas pertahanan kita terbatas.
Dialogue: 0,0:07:16.67,0:07:19.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paling lama, cuma tahan setahun.
Dialogue: 0,0:07:22.21,0:07:24.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa-bisa Canarre ditaklukkan.
Dialogue: 0,0:07:24.82,0:07:26.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana ini?
Dialogue: 0,0:07:27.26,0:07:29.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bisa saja berkhianat.
Dialogue: 0,0:07:32.64,0:07:36.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau menyerah,\NCanarre memang akan direbut.
Dialogue: 0,0:07:36.75,0:07:39.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kamu masih bisa selamat.
Dialogue: 0,0:07:40.83,0:07:44.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemampuan penilaian itu bisa jadi jaminan.
Dialogue: 0,0:07:44.05,0:07:46.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bawahanmu juga bisa ditolong.
Dialogue: 0,0:07:47.81,0:07:49.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa.
Dialogue: 0,0:07:49.41,0:07:54.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Canarre adalah amanat Tuan Cran\Ndan warisan Tuan Lemaire.
Dialogue: 0,0:07:54.67,0:07:55.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu,
Dialogue: 0,0:07:56.21,0:07:58.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ayahku juga menjaganya.
Dialogue: 0,0:07:58.93,0:08:03.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi pemimpin wilayah\Ndemi menjaga tempat asalku.
Dialogue: 0,0:08:03.23,0:08:06.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyerah tanpa syarat itu mudah.
Dialogue: 0,0:08:06.58,0:08:10.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi rakyat akan menderita\Nkalau terjadi penjarahan.
Dialogue: 0,0:08:11.18,0:08:14.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berjuang sejauh ini,\Nagar itu tidak terjadi.
Dialogue: 0,0:08:15.10,0:08:17.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyerah bukanlah pilihan.
Dialogue: 0,0:08:17.84,0:08:21.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dan orang-orang yang menjaga Canarre
Dialogue: 0,0:08:22.21,0:08:24.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}harus memenangkan ini!
Dialogue: 0,0:08:26.82,0:08:29.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga jawabanmu begitu.
Dialogue: 0,0:08:29.57,0:08:33.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemungkinan, musuh akan bergerak\Nbeberapa minggu lagi.
Dialogue: 0,0:08:36.51,0:08:39.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Panggil semua pemimpin wilayah Canarre.
Dialogue: 0,0:08:39.78,0:08:43.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minggu depan, kita pergi ke wilayah Khmer.
Dialogue: 0,0:08:43.14,0:08:44.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:08:45.10,0:08:48.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baru beberapa bulan Keluarga Louvent merintis,
Dialogue: 0,0:08:48.54,0:08:50.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}langsung ada ujian saja.
Dialogue: 0,0:08:54.56,0:08:55.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Ars!
Dialogue: 0,0:08:55.97,0:08:58.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada surat dari Tuan Cran!\NDan juga...
Dialogue: 0,0:09:01.30,0:09:03.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Info diterima.
Dialogue: 0,0:09:03.57,0:09:06.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hidup mati kita ada di pertahanan Canarre.
Dialogue: 0,0:09:06.69,0:09:10.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski ini akan jadi pertempuran terberat,
Dialogue: 0,0:09:10.14,0:09:12.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku yakin kalian bisa mengatasinya.
Dialogue: 0,0:09:13.70,0:09:17.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin kamu tidak butuh,\Ntapi aku mengirim sedikit bantuan.
Dialogue: 0,0:09:17.58,0:09:19.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gunakanlah baik-baik.
Dialogue: 0,0:09:22.00,0:09:25.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Cran mengirim 20.000 prajurit!
Dialogue: 0,0:09:26.02,0:09:27.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luar biasa!
Dialogue: 0,0:09:30.70,0:09:32.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Clamant!
Dialogue: 0,0:09:32.34,0:09:36.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentara Bayaran Maitro!\NKita akan sangat terbantu!
Dialogue: 0,0:09:36.22,0:09:39.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal Tuan Cran juga\Nharus melawan Tuan Basamarc.
Dialogue: 0,0:09:39.86,0:09:41.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Ars!
Dialogue: 0,0:09:41.35,0:09:44.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Pemimpin Wilayah Trubequista,\NHammand Plaid!
Dialogue: 0,0:09:44.35,0:09:46.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Datang karena Canarre dalam bahaya!
Dialogue: 0,0:09:46.98,0:09:48.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Hammand!
Dialogue: 0,0:09:48.94,0:09:50.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan juga...
Dialogue: 0,0:09:52.59,0:09:54.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka sudah kubawa, Nak.
Dialogue: 0,0:09:54.87,0:09:58.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya berisik saking semangatnya.
Dialogue: 0,0:10:00.34,0:10:03.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Pemimpin Wilayah Lamberg,\NMireille Grangeon.
Dialogue: 0,0:10:03.90,0:10:06.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Datang atas perintah Tuan.
Dialogue: 0,0:10:06.54,0:10:10.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya bukan cuma Tuan Ars\Nyang merasa harus menang.
Dialogue: 0,0:10:12.51,0:10:13.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:10:15.58,0:10:18.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya, mohon bantuannya!
Dialogue: 0,0:10:29.82,0:10:31.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba jelaskan, Rosell.
Dialogue: 0,0:10:31.90,0:10:36.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana cara mengalahkan 80.000 prajurit\Ndengan 28.000 prajurit?
Dialogue: 0,0:10:36.03,0:10:39.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu mengalahkan mereka.
Dialogue: 0,0:10:39.03,0:10:41.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudnya?
Dialogue: 0,0:10:41.55,0:10:47.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasukan musuh baru saja berperang,\Nkondisi mereka tidak prima.
Dialogue: 0,0:10:47.30,0:10:51.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagi mereka, ini perang invasi.
Dialogue: 0,0:10:51.70,0:10:55.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak wajib menang\Nseperti waktu perang saudara.
Dialogue: 0,0:10:55.80,0:10:58.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, motivasi mereka rendah.
Dialogue: 0,0:10:59.76,0:11:02.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan membantu Tuan Basamarc,
Dialogue: 0,0:11:02.37,0:11:07.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin ada keuntungan yang mereka incar.
Dialogue: 0,0:11:07.15,0:11:11.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, buat saja mereka berpikir\Nperang ini merugikan.
Dialogue: 0,0:11:12.13,0:11:16.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu mengalahkan 80.000 musuh.
Dialogue: 0,0:11:16.49,0:11:19.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pakailah 28.000 prajurit kita
Dialogue: 0,0:11:19.34,0:11:24.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk membuat Seitz merasa rugi\Nhingga mereka menyerah!
Dialogue: 0,0:11:24.62,0:11:29.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik maupun buruk,\Nperang tidak melulu soal jumlah.
Dialogue: 0,0:11:29.26,0:11:31.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi itulah letak asyiknya.
Dialogue: 0,0:11:32.40,0:11:35.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti musuh tidak harus kalah.
Dialogue: 0,0:11:35.95,0:11:39.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka cuma harus dibuat patah arang, kan?
Dialogue: 0,0:11:39.07,0:11:41.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi Tuan Cran yang turut membantu,
Dialogue: 0,0:11:41.84,0:11:44.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mari kita berjuang!
Dialogue: 0,0:11:45.68,0:11:47.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah!
Dialogue: 0,0:11:47.10,0:11:49.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ukurannya juga pas!
Dialogue: 0,0:11:49.20,0:11:50.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:11:52.37,0:11:56.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di perang kali ini, aku tidak bisa\Nmendampingi Tuan.
Dialogue: 0,0:11:56.29,0:12:01.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai gantinya,\Nzirah itu yang akan melindungi Anda.
Dialogue: 0,0:12:01.98,0:12:03.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:12:03.20,0:12:04.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Ars.
Dialogue: 0,0:12:05.70,0:12:07.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga punya sesuatu.
Dialogue: 0,0:12:08.91,0:12:10.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lycia, apa itu?
Dialogue: 0,0:12:10.79,0:12:13.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Air olahan daun dan bunga Lula.
Dialogue: 0,0:12:13.79,0:12:16.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini jampi-jampi kuno khas Trubequista.
Dialogue: 0,0:12:18.35,0:12:23.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Konon dengan berpelukan,\Nkita akan pulang dengan selamat.
Dialogue: 0,0:12:24.32,0:12:27.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seingatku, tradisi Trubequista cuma airnya.
Dialogue: 0,0:12:27.94,0:12:33.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya, selama Tuan Ars pergi,\Naku akan menjaga Canarre.
Dialogue: 0,0:12:35.06,0:12:36.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berangkat.
Dialogue: 0,0:12:39.65,0:12:45.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akan berperang di sungai Khmer\Nyang jadi perbatasan Missian dan Seitz.
Dialogue: 0,0:12:45.20,0:12:49.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua jembatan sudah dihancurkan,\Npasti musuh akan lewat sini.
Dialogue: 0,0:12:49.52,0:12:52.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungainya sempit dan relatif dangkal.
Dialogue: 0,0:12:53.23,0:12:56.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma di situ 80.000 prajurit bisa menyeberang.
Dialogue: 0,0:12:56.46,0:13:01.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}20.000 pasukan utama kita akan bergabung\Nke pasukan Khmer yang bersiaga.
Dialogue: 0,0:13:01.50,0:13:05.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tahan garda depan musuh dari tepi sungai.
Dialogue: 0,0:13:05.64,0:13:09.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sisanya akan masuk ke Benteng Khmer.
Dialogue: 0,0:13:09.30,0:13:13.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tugasnya membantu pasukan utama\Ndan melawan musuh yang memutar.
Dialogue: 0,0:13:16.05,0:13:19.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasukan utama akan dipimpin Rietz.
Dialogue: 0,0:13:24.00,0:13:26.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih telah menahan musuh cukup lama.
Dialogue: 0,0:13:27.73,0:13:30.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami terbiasa perang untuk bertahan.
Dialogue: 0,0:13:30.34,0:13:32.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini baru permulaan.
Dialogue: 0,0:13:32.67,0:13:34.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita punya keunggulan medan.
Dialogue: 0,0:13:34.80,0:13:37.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Strategimu juga bagus.
Dialogue: 0,0:13:41.23,0:13:46.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Besok kita akan tiba di sungai Khmer,\Ntidurlah agar siap berperang.
Dialogue: 0,0:13:46.39,0:13:50.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil tidur, ini perang perdanaku.
Dialogue: 0,0:13:50.21,0:13:53.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat perang nanti, senjata perlu dicek.
Dialogue: 0,0:13:54.69,0:13:55.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini untukmu.
Dialogue: 0,0:13:55.79,0:13:58.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Te-Terima kasih.
Dialogue: 0,0:14:01.40,0:14:04.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa Abang jadi pengikut?
Dialogue: 0,0:14:04.21,0:14:07.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kalian penasaran?\NTidak ada alasan khusus, kok.
Dialogue: 0,0:14:07.99,0:14:11.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Habisnya, namamu sudah terkenal!
Dialogue: 0,0:14:11.55,0:14:14.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten veteran pasukan penyerbu\NTentara Bayaran Liben!
Dialogue: 0,0:14:14.85,0:14:17.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang sehebat kamu bergabung,
Dialogue: 0,0:14:17.26,0:14:20.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pasti demi tujuan besar, kan?
Dialogue: 0,0:14:20.59,0:14:22.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi uang.
Dialogue: 0,0:14:22.63,0:14:24.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Uang?
Dialogue: 0,0:14:24.37,0:14:29.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau jadi pengikut bangsawan,\Nuangku akan melimpah.
Dialogue: 0,0:14:29.18,0:14:30.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh...
Dialogue: 0,0:14:30.77,0:14:35.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kalian, kalau perang dimulai\Nbakal susah tidur, lo.
Dialogue: 0,0:14:35.71,0:14:38.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidur duluan, ah.
Dialogue: 0,0:14:39.06,0:14:43.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Charlotte memang hebat,\Nmentalnya kuat banget.
Dialogue: 0,0:14:43.33,0:14:46.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitulah sifatnya dari dulu.
Dialogue: 0,0:14:46.42,0:14:48.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beda banget sama kami!
Dialogue: 0,0:14:51.68,0:14:55.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Musha, ibu masih tetap khawatir.
Dialogue: 0,0:14:55.79,0:14:59.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak cocok berperang.
Dialogue: 0,0:14:59.26,0:15:02.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sifat kikukmu mirip denganku.
Dialogue: 0,0:15:03.79,0:15:10.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan rambut indah dan paras cantik,\Nkamu pasti dapat suami yang layak.
Dialogue: 0,0:15:10.72,0:15:13.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biarkan para pria yang berperang
Dialogue: 0,0:15:13.58,0:15:15.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan pulanglah ke rumah.
Dialogue: 0,0:15:20.02,0:15:22.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus tidur.
Dialogue: 0,0:15:29.44,0:15:31.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Charlotte.
Dialogue: 0,0:15:31.52,0:15:34.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, kukira siapa, ternyata Musha.
Dialogue: 0,0:15:34.51,0:15:36.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu masih bangun?
Dialogue: 0,0:15:36.32,0:15:39.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku merawat senjata untuk besok.
Dialogue: 0,0:15:39.12,0:15:41.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini rutinitasku sebelum perang.
Dialogue: 0,0:15:41.63,0:15:45.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gagal mengeluarkan kekuatan\Nkarena senjata rusak itu tidak lucu, kan?
Dialogue: 0,0:15:45.18,0:15:46.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti aku tidur.
Dialogue: 0,0:15:46.88,0:15:48.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu juga tidurlah.
Dialogue: 0,0:15:48.77,0:15:51.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa mau terkapar di perang perdana?
Dialogue: 0,0:15:51.20,0:15:52.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:15:54.60,0:15:58.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak takut berperang?
Dialogue: 0,0:15:58.90,0:16:04.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku merantau demi mengubah diriku\Nyang tidak bisa apa-apa.
Dialogue: 0,0:16:04.08,0:16:06.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski telah banyak berlatih,
Dialogue: 0,0:16:06.66,0:16:09.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku masih takut.
Dialogue: 0,0:16:09.76,0:16:12.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana cara agar berani?
Dialogue: 0,0:16:14.27,0:16:15.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga takut, kok.
Dialogue: 0,0:16:15.70,0:16:17.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, tapi...
Dialogue: 0,0:16:17.17,0:16:21.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi bukan takut mati.\NToh, aku yakin menang.
Dialogue: 0,0:16:21.22,0:16:22.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh.
Dialogue: 0,0:16:22.51,0:16:26.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah sering berperang,\Nmembunuh banyak orang,
Dialogue: 0,0:16:27.01,0:16:29.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan berusaha hidup tanpa penyesalan.
Dialogue: 0,0:16:29.99,0:16:31.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:16:31.65,0:16:33.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku takut
Dialogue: 0,0:16:33.60,0:16:35.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}gagal memenuhi harapan Ars.
Dialogue: 0,0:16:37.71,0:16:44.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ingin berubah, ingin percaya diri,\Nyang kucemaskan hanyalah diri sendiri.
Dialogue: 0,0:16:44.23,0:16:46.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, orang ini berbeda.
Dialogue: 0,0:16:47.15,0:16:48.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya dia kuat.
Dialogue: 0,0:16:49.26,0:16:50.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu.
Dialogue: 0,0:16:50.86,0:16:53.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh aku gabung?
Dialogue: 0,0:16:53.90,0:16:56.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh, sini kuajarkan.
Dialogue: 0,0:16:57.22,0:16:58.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga suatu saat
Dialogue: 0,0:16:59.38,0:17:01.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku bisa sepertinya.
Dialogue: 0,0:17:05.04,0:17:07.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berisik sekali.
Dialogue: 0,0:17:07.13,0:17:10.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong lakukan sesuatu, Zat!
Dialogue: 0,0:17:10.13,0:17:12.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana bisa tidur kalau begini?
Dialogue: 0,0:17:12.81,0:17:15.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten, jangan berisik...
Dialogue: 0,0:17:17.64,0:17:19.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Abang...
Dialogue: 0,0:17:20.03,0:17:21.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah...
Dialogue: 0,0:17:23.81,0:17:26.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti tidurnya gelisah akibat memeluk senjata.
Dialogue: 0,0:17:26.53,0:17:28.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar aku bereskan.
Dialogue: 0,0:17:29.04,0:17:30.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tinggal ditutup saja.
Dialogue: 0,0:17:30.83,0:17:33.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih kedengaran, lo!
Dialogue: 0,0:17:33.49,0:17:34.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita tidur.
Dialogue: 0,0:17:34.72,0:17:36.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok selimutnya dipakai semua?
Dialogue: 0,0:17:36.77,0:17:38.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, nih!
Dialogue: 0,0:17:46.34,0:17:49.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi Tuan Borotts!
Dialogue: 0,0:17:49.01,0:17:52.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maju!
Dialogue: 0,0:17:52.76,0:17:54.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mencegah musuh menyeberang.
Dialogue: 0,0:17:54.68,0:17:56.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah tugas kita.
Dialogue: 0,0:17:57.82,0:18:02.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Raih kemenangan demi Canarre\Ndan demi Tuan Ars!
Dialogue: 0,0:18:02.34,0:18:05.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasukan Jarak Jauh, bersiap!
Dialogue: 0,0:18:05.11,0:18:07.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tembak!
Dialogue: 0,0:18:07.70,0:18:10.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasukan Katapel, maju!
Dialogue: 0,0:18:14.07,0:18:16.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tembak!
Dialogue: 0,0:18:21.17,0:18:23.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasukan Sihir, buat pelindung!
Dialogue: 0,0:18:30.30,0:18:33.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasukan Tempur, maju!
Dialogue: 0,0:18:35.34,0:18:37.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasukan Jarak Jauh, serang para infanteri!
Dialogue: 0,0:18:44.14,0:18:46.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka pakai sihir pelindung!
Dialogue: 0,0:18:46.48,0:18:48.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar saja, jangan berhenti!
Dialogue: 0,0:18:49.57,0:18:53.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Charlotte, Musha, ini giliran kalian.
Dialogue: 0,0:18:53.97,0:18:57.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya mulai panas.
Dialogue: 0,0:18:57.65,0:18:59.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rencana dimulai.
Dialogue: 0,0:18:59.15,0:19:00.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya menakuti,
Dialogue: 0,0:19:00.93,0:19:03.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kita penentu menang dan kalahnya.
Dialogue: 0,0:19:03.52,0:19:04.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah siap?
Dialogue: 0,0:19:04.71,0:19:06.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:19:06.16,0:19:07.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja.
Dialogue: 0,0:19:07.60,0:19:09.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyawa semuanya dipertaruhkan...
Dialogue: 0,0:19:09.42,0:19:11.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pasti bisa.
Dialogue: 0,0:19:11.46,0:19:13.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis kampung sepertiku...
Dialogue: 0,0:19:13.82,0:19:15.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti bisa!
Dialogue: 0,0:19:15.32,0:19:16.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah bisa apa...
Dialogue: 0,0:19:16.74,0:19:17.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi,
Dialogue: 0,0:19:18.06,0:19:19.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku pasti bisa.
Dialogue: 0,0:19:20.83,0:19:22.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Forma.
Dialogue: 0,0:19:28.69,0:19:30.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak bisa.
Dialogue: 0,0:19:31.65,0:19:33.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti ada yang salah.
Dialogue: 0,0:19:33.82,0:19:38.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Habisnya, aku tidak pernah bisa apa-apa.
Dialogue: 0,0:19:38.67,0:19:40.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu...
Dialogue: 0,0:19:40.48,0:19:41.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu...
Dialogue: 0,0:19:44.77,0:19:47.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku percaya padamu.
Dialogue: 0,0:19:47.55,0:19:49.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu punya kekuatan.
Dialogue: 0,0:19:49.58,0:19:51.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ucapan Ars tidak mungkin salah.
Dialogue: 0,0:19:55.62,0:19:56.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Percayalah.
Dialogue: 0,0:19:59.38,0:20:03.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga ingin jadi sepertimu!
Dialogue: 0,0:20:06.35,0:20:09.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, aku minta pisau.
Dialogue: 0,0:20:10.24,0:20:13.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belum bisa percaya diri.
Dialogue: 0,0:20:13.09,0:20:15.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku ingin jadi kuat,
Dialogue: 0,0:20:15.90,0:20:18.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}agar bisa percaya diri.
Dialogue: 0,0:20:18.64,0:20:19.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu...
Dialogue: 0,0:20:27.37,0:20:31.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan memercayai Charlotte\Nyang percaya padaku.
Dialogue: 0,0:20:32.52,0:20:35.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Forma terra aquos...
Dialogue: 0,0:20:35.76,0:20:37.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Magnis!
Dialogue: 0,0:20:48.66,0:20:49.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini?
Dialogue: 0,0:20:52.53,0:20:53.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Airnya...
Dialogue: 0,0:20:53.65,0:20:56.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasukan Jarak Jauh, tembak!
Dialogue: 0,0:20:56.03,0:21:00.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Forma igni erupt!
Dialogue: 0,0:21:00.45,0:21:01.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mumpung surut!
Dialogue: 0,0:21:01.95,0:21:04.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo maju sekaligus!
Dialogue: 0,0:21:11.36,0:21:13.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya bisa beraksi!
Dialogue: 0,0:21:13.34,0:21:15.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zat, jangan sampai ketinggalan!
Dialogue: 0,0:21:15.97,0:21:18.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan terlalu maju!
Dialogue: 0,0:21:27.60,0:21:30.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan ini?
Dialogue: 0,0:21:33.19,0:21:37.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mu-Mundur!
Dialogue: 0,0:21:46.51,0:21:48.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus!
Dialogue: 0,0:21:53.49,0:21:54.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:23:26.26,0:23:29.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana Rietz?\NMusha kami hebat, kan?
Dialogue: 0,0:23:29.34,0:23:31.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, sikapnya pun baik\Nenggak kayak seseorang.
Dialogue: 0,0:23:31.84,0:23:34.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa katamu?\NAku juga baik, tahu!
Dialogue: 0,0:23:34.39,0:23:36.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, selanjutnya kisah mereka.
Dialogue: 0,0:23:36.81,0:23:38.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya,
Dialogue: 0,0:23:38.06,0:23:39.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Zat dan Braham".
