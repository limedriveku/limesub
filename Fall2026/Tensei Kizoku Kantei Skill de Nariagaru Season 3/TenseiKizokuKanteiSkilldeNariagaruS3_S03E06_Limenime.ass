Dialogue: 0,0:02:02.31,0:02:07.98,sign,,0000,0000,0000,,AS A REINCARNATED ARISTOCRAT, I'LL USE MY\NAPPRAISAL SKILL TO RISE IN THE WORLD SEASON 3
Dialogue: 0,0:02:08.52,0:02:11.99,sign,,0000,0000,0000,,ISTANA CANARRE
Dialogue: 0,0:02:25.29,0:02:28.71,sign,,0000,0000,0000,,LAMBERG, KEDIAMAN KELUARGA LOUVENT
Dialogue: 0,0:02:29.75,0:02:33.76,sign,,0000,0000,0000,,MASA DEPAN TEKNOLOGI
Dialogue: 0,0:02:33.76,0:02:36.43,sign,,0000,0000,0000,,SHIN SEIMARO
Dialogue: 0,0:06:34.62,0:06:37.59,sign,,0000,0000,0000,,KAWANAN BANDIT
Dialogue: 0,0:07:43.11,0:07:46.36,sign,,0000,0000,0000,,EPISODE 30: FUJIMIYA
Dialogue: 0,0:08:59.30,0:09:01.71,sign,,0000,0000,0000,,ORANG LUAR
Dialogue: 0,0:11:18.20,0:11:18.67,sign,,0000,0000,0000,,MAIKA FUJIMIYA, WANITA 17 TAHUN
Dialogue: 0,0:11:18.67,0:11:19.45,sign,,0000,0000,0000,,KEPEMIMPINAN 12, KEBERANIAN 9,
Dialogue: 0,0:11:19.45,0:11:20.39,sign,,0000,0000,0000,,KEBIJAKSANAAN 99, POLITIK 91, AMBISI 34
Dialogue: 0,0:11:20.39,0:11:21.67,sign,,0000,0000,0000,,INFANTERI D, KAVALERI D, MEMANAH D,
Dialogue: 0,0:11:21.67,0:11:22.69,sign,,0000,0000,0000,,SIHIR D, KONSTRUKSI D, KESENJATAAN A
Dialogue: 0,0:11:22.69,0:11:25.21,sign,,0000,0000,0000,,ANGKATAN UDARA D, STRATEGI S
Dialogue: 0,0:11:25.21,0:11:26.16,sign,,0000,0000,0000,,TAKAO FUJIMIYA, PRIA 16 TAHUN
Dialogue: 0,0:11:26.16,0:11:27.09,sign,,0000,0000,0000,,KEPEMIMPINAN 44, KEBERANIAN 90,
Dialogue: 0,0:11:27.09,0:11:27.97,sign,,0000,0000,0000,,KEBIJAKSANAAN 12, POLITIK 25, AMBISI 12
Dialogue: 0,0:11:27.97,0:11:29.76,sign,,0000,0000,0000,,INFANTERI S, KAVALERI A, MEMANAH A
Dialogue: 0,0:11:29.76,0:11:31.70,sign,,0000,0000,0000,,SIHIR D, KONSTRUKSI D, KESENJATAAN D,
Dialogue: 0,0:11:31.70,0:11:34.21,sign,,0000,0000,0000,,ANGKATAN LAUT D, ANGKATAN UDARA D
Dialogue: 0,0:11:42.68,0:11:43.93,sign,,0000,0000,0000,,RIKUYA FUJIMIYA, PRIA 18 TAHUN
Dialogue: 0,0:11:43.93,0:11:45.12,sign,,0000,0000,0000,,INFANTERI B, KAVALERI B, MEMANAH B,
Dialogue: 0,0:11:45.12,0:11:46.08,sign,,0000,0000,0000,,SIHIR D, KONSTRUKSI B, KESENJATAAN D
Dialogue: 0,0:11:46.08,0:11:49.68,sign,,0000,0000,0000,,ANGKATAN UDARA D, STRATEGI B
Dialogue: 0,0:11:49.68,0:11:50.36,sign,,0000,0000,0000,,KEPEMIMPINAN 60, KEBERANIAN 68, KEBIJAKSANAAN 63, POLITIK 65, AMBISI 54
Dialogue: 0,0:11:56.11,0:12:01.01,sign,,0000,0000,0000,,LAHIR 12 JUNI TAHUN 194 KALENDER KEKAISARAN,
Dialogue: 0,0:12:01.01,0:12:08.12,sign,,0000,0000,0000,,DI IBU KOTA TEN, KERAJAAN YOU
Dialogue: 0,0:12:29.92,0:12:32.32,sign,,0000,0000,0000,,AS A REINCARNATED ARISTOCRAT, I'LL USE MY\NAPPRAISAL SKILL TO RISE IN THE WORLD SEASON 3
Dialogue: 0,0:23:37.69,0:23:40.61,sign,,0000,0000,0000,,SELANJUTNYA: MISI PENYELAMATAN ARS
Dialogue: 0,0:00:02.48,0:00:05.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perang suksesi Missian yang panjang
Dialogue: 0,0:00:05.95,0:00:11.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ditutup dengan Cran sang kakak\Nyang mengeksekusi Basamarc sang adik.
Dialogue: 0,0:00:13.02,0:00:16.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah mengalahkan Borotts\Nsang jenderal ulung dari Seitz,
Dialogue: 0,0:00:16.87,0:00:20.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ars dan kelompoknya makin berkembang.
Dialogue: 0,0:00:20.82,0:00:24.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harapan akan kedamaian permanen
Dialogue: 0,0:00:24.16,0:00:27.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}membuat Ars bertekad menjadi kaisar.
Dialogue: 0,0:00:28.18,0:00:34.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi di sisi lain, perang telah mengukir\Nberbagai luka di Canarre.
Dialogue: 0,0:02:12.99,0:02:14.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Ars.
Dialogue: 0,0:02:14.83,0:02:17.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo? Tuan Ars mana?
Dialogue: 0,0:02:17.25,0:02:22.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Ars ke Lamberg\Nuntuk bicara dengan seseorang.
Dialogue: 0,0:02:22.05,0:02:24.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu.
Dialogue: 0,0:02:36.43,0:02:38.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mesin apa itu?
Dialogue: 0,0:02:40.39,0:02:44.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kira siapa...\NKamu sedang berkunjung?
Dialogue: 0,0:02:44.78,0:02:50.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkat uang dari menang perang,\Nanggaranku bertambah.
Dialogue: 0,0:02:50.29,0:02:53.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski jadi sibuk gara-gara banyak wacana, sih.
Dialogue: 0,0:02:53.40,0:02:55.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senang mendengarnya.
Dialogue: 0,0:02:55.28,0:03:00.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin kapal terbang raksasanya\Nbisa segera kuperlihatkan padamu.
Dialogue: 0,0:03:00.96,0:03:05.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di perang kali ini,\Nteknologimu sangat membantu.
Dialogue: 0,0:03:05.30,0:03:07.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami sukses melindungi Canarre berkat itu.
Dialogue: 0,0:03:08.77,0:03:13.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih telah memenuhi\Npermintaan mendadakku.
Dialogue: 0,0:03:13.17,0:03:16.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, kinerjaku cukup bagus.
Dialogue: 0,0:03:16.58,0:03:17.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:03:18.40,0:03:20.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shin, aku minta maaf
Dialogue: 0,0:03:20.88,0:03:26.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena memintamu jadi bawahanku\Nwaktu kita pertama bertemu.
Dialogue: 0,0:03:27.36,0:03:29.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perang tempo hari menyadarkanku.
Dialogue: 0,0:03:30.43,0:03:33.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai pakar teknologi yang bisa
Dialogue: 0,0:03:33.84,0:03:37.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mengubah cara hidup dan cara perang kami,
Dialogue: 0,0:03:37.58,0:03:42.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu harus kuperlakukan setara\Nsebagai teknisi, bukan bawahan.
Dialogue: 0,0:03:42.99,0:03:47.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di dataran jauh yang kukenal,\Npenduduknya gagal mengontrol teknologi
Dialogue: 0,0:03:47.95,0:03:50.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hingga terjadilah tragedi.
Dialogue: 0,0:03:50.61,0:03:55.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teknologi secanggih apa pun\Nbisa berakhir mengenaskan
Dialogue: 0,0:03:55.04,0:03:57.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau jatuh di tangan yang salah.
Dialogue: 0,0:03:58.16,0:04:00.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manusia jadi saling bunuh.
Dialogue: 0,0:04:00.88,0:04:04.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya, hentikan kalau mulai berbahaya!
Dialogue: 0,0:04:04.21,0:04:08.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu boleh pergi kapan saja\Nkalau merasa aku salah jalan.
Dialogue: 0,0:04:09.41,0:04:14.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena saat itu, aku sudah tidak layak\Nmenggunakan teknologimu.
Dialogue: 0,0:04:14.45,0:04:18.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, akulah yang bertanggung jawab\Natas semua teknologimu.
Dialogue: 0,0:04:20.57,0:04:22.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah pernah bilang,
Dialogue: 0,0:04:23.70,0:04:25.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Pasanglah wajah kesatria."
Dialogue: 0,0:04:28.50,0:04:35.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dulu aku kira, maksudnya harus siap\Nmembunuh dan dibunuh saat perang.
Dialogue: 0,0:04:36.19,0:04:41.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi amanat Ayah tidak sesimpel itu.
Dialogue: 0,0:04:42.26,0:04:46.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi kesatria artinya\Nharus siap bertanggung jawab.
Dialogue: 0,0:04:47.98,0:04:51.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sadar harus menerima\Nsisi baik maupun buruknya.
Dialogue: 0,0:04:52.86,0:04:59.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanggung jawab mungkin lebih berat\Ndaripada hidup mati di medan perang.
Dialogue: 0,0:04:59.55,0:05:03.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi memikulnya adalah tugasku\Nsebagai pemimpin.
Dialogue: 0,0:05:03.25,0:05:08.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bertanggung jawab menjamin\Nmasa depan yang lebih damai.
Dialogue: 0,0:05:09.29,0:05:15.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, Shin, izinkan aku\Nmemikul beban itu bersamamu.
Dialogue: 0,0:05:18.77,0:05:20.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau tanya satu hal.
Dialogue: 0,0:05:20.82,0:05:24.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu memberiku uang\Ndan mau bertanggung jawab.
Dialogue: 0,0:05:24.54,0:05:26.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa berbuat sejauh itu?
Dialogue: 0,0:05:26.72,0:05:29.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kalau teknologimu maju,
Dialogue: 0,0:05:29.44,0:05:33.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku yakin hidup semua orang\Nakan lebih makmur.
Dialogue: 0,0:05:33.47,0:05:35.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau gagal?
Dialogue: 0,0:05:35.22,0:05:38.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya kamu yang paling tahu, kan?
Dialogue: 0,0:05:40.21,0:05:42.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil sukses tanpa gagal dulu.
Dialogue: 0,0:05:46.85,0:05:51.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga, kamu selalu\Nmendukungku sejak awal.
Dialogue: 0,0:05:52.16,0:05:55.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, cita-citaku masih sama!
Dialogue: 0,0:05:55.62,0:05:57.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membuat kapal terbang yang bisa dinaiki!
Dialogue: 0,0:05:57.87,0:06:00.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sudah jadi, kamu pasti\Njadi penumpang pertama!
Dialogue: 0,0:06:00.87,0:06:02.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, aku tunggu!
Dialogue: 0,0:06:04.46,0:06:09.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya, saat bereksperimen untuk menambah\Ndaya gempur kapal terbangnya,
Dialogue: 0,0:06:09.30,0:06:11.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kebetulan aku menemukan ini.
Dialogue: 0,0:06:11.82,0:06:15.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Campuran dua bahan ini ledakannya mantap.
Dialogue: 0,0:06:15.10,0:06:17.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Shin?
Dialogue: 0,0:06:29.06,0:06:30.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat, kan?
Dialogue: 0,0:06:30.33,0:06:33.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan ini kita bisa hemat batu sihir.
Dialogue: 0,0:06:46.21,0:06:49.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat, ada tanda kehidupan.
Dialogue: 0,0:06:49.10,0:06:52.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti para bandit itu bermukim di sini.
Dialogue: 0,0:06:57.38,0:06:59.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cari dan tangkap mereka!
Dialogue: 0,0:06:59.41,0:07:03.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka bukan tandingan pasukan Canarre!
Dialogue: 0,0:07:03.39,0:07:05.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap!
Dialogue: 0,0:07:05.15,0:07:06.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa itu?
Dialogue: 0,0:07:07.60,0:07:08.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu musuh!
Dialogue: 0,0:07:08.48,0:07:10.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersiap bertempur!
Dialogue: 0,0:07:10.74,0:07:13.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa itu tadi?\NMana musuhnya?
Dialogue: 0,0:07:13.86,0:07:16.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka menyerang dari mana?
Dialogue: 0,0:07:16.42,0:07:18.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak terlihat!
Dialogue: 0,0:07:18.38,0:07:20.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak terlihat?
Dialogue: 0,0:07:20.66,0:07:22.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Musuhnya tidak terlihat!
Dialogue: 0,0:07:46.83,0:07:49.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rietz, aku kembali.
Dialogue: 0,0:07:49.42,0:07:51.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Ars, selamat datang.
Dialogue: 0,0:07:51.94,0:07:55.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf harus menyampaikan ini\Nmeski Tuan baru pulang...
Dialogue: 0,0:07:58.45,0:07:59.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kawanan bandit?
Dialogue: 0,0:07:59.88,0:08:04.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benteng yang kami lindungi\Ntiba-tiba diserang.
Dialogue: 0,0:08:04.29,0:08:07.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasukan kami ke gunung untuk mengejar
Dialogue: 0,0:08:07.52,0:08:11.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan telah menemukan persembunyian musuh.
Dialogue: 0,0:08:11.09,0:08:13.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kami diserang.
Dialogue: 0,0:08:13.10,0:08:17.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami dikalahkan tanpa bisa melihat mereka.
Dialogue: 0,0:08:17.60,0:08:19.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Musuhnya tidak terlihat?
Dialogue: 0,0:08:19.36,0:08:24.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, kami sudah waspada karena ada bunyinya,\Ntapi tidak melihat apa-apa.
Dialogue: 0,0:08:25.86,0:08:29.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasukan yang dikirim akhirnya dipukul mundur.
Dialogue: 0,0:08:29.33,0:08:35.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkinkah musuh tidak terlihat\Nkarena pakai sihir bayangan seperti Fam?
Dialogue: 0,0:08:35.86,0:08:40.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski belum terlalu yakin,\Nsepertinya ini bukan sihir.
Dialogue: 0,0:08:41.40,0:08:45.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kabarnya mereka menduduki\Nistana di perbatasan Canarre.
Dialogue: 0,0:08:45.41,0:08:47.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita perlu lekas bertindak.
Dialogue: 0,0:08:48.69,0:08:50.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana Rosell?
Dialogue: 0,0:08:50.16,0:08:52.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedang kunjungan diplomatik.
Dialogue: 0,0:08:52.62,0:08:54.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:08:54.82,0:08:58.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, ayo segera tangani.
Dialogue: 0,0:08:59.30,0:09:01.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka bandit yang digosipkan.
Dialogue: 0,0:09:01.71,0:09:04.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang tampak mencurigakan, sih.
Dialogue: 0,0:09:04.82,0:09:08.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak saja!\NSudah kubilang berkali-kali!
Dialogue: 0,0:09:08.45,0:09:10.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami bukan bandit!
Dialogue: 0,0:09:10.57,0:09:13.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus kenapa berpakaian aneh?
Dialogue: 0,0:09:13.36,0:09:15.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jelas-jelas mencurigakan!
Dialogue: 0,0:09:15.38,0:09:16.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu,
Dialogue: 0,0:09:16.86,0:09:20.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pedang milik pria itu terlihat mahal.
Dialogue: 0,0:09:20.96,0:09:24.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana buktinya kalau kalian\Nbukan kawanan bandit?
Dialogue: 0,0:09:24.96,0:09:26.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada, lah.
Dialogue: 0,0:09:26.38,0:09:29.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat ikut kami untuk diinterogasi!
Dialogue: 0,0:09:29.30,0:09:31.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan pegang-pegang!
Dialogue: 0,0:09:31.30,0:09:35.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makin mencurigakan saja!\NKalian pasti banditnya, kan?
Dialogue: 0,0:09:36.31,0:09:39.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya, ribut-ribut apa ini?
Dialogue: 0,0:09:39.52,0:09:41.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tu-Tuan Ars!
Dialogue: 0,0:09:41.33,0:09:43.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mau menangkap kami juga, ya?
Dialogue: 0,0:09:45.74,0:09:48.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudahlah, kami terobos saja\Nkalau dihalangi terus.
Dialogue: 0,0:09:48.99,0:09:53.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takao, bangun!\NLibas mereka!
Dialogue: 0,0:10:05.87,0:10:09.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Ilmu bela diri apa itu?\NKok aku baru lihat?
Dialogue: 0,0:10:09.71,0:10:10.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rietz!
Dialogue: 0,0:10:13.02,0:10:15.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, sabar dulu!
Dialogue: 0,0:10:16.11,0:10:18.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar, kamu terlalu sumbu pendek!
Dialogue: 0,0:10:20.98,0:10:23.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maaf, Kakanda.
Dialogue: 0,0:10:24.16,0:10:27.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maika, kamu juga.\NCepat minta maaf.
Dialogue: 0,0:10:27.76,0:10:30.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Habisnya, kita dituduh penjahat!
Dialogue: 0,0:10:35.05,0:10:36.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:10:37.26,0:10:39.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kami juga minta maaf.
Dialogue: 0,0:10:43.81,0:10:46.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pakaiannya tidak seperti dari Missian.
Dialogue: 0,0:10:47.28,0:10:50.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya kalian siapa?
Dialogue: 0,0:10:55.30,0:10:59.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami pengembara yang baru tiba\Ndi tanah ini kemarin.
Dialogue: 0,0:10:59.74,0:11:02.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami agak sensitif karena belum terbiasa.
Dialogue: 0,0:11:02.27,0:11:03.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon maaf.
Dialogue: 0,0:11:04.40,0:11:08.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para bandit muncul sebulan lalu, kan?
Dialogue: 0,0:11:08.27,0:11:12.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemungkinan, mereka bukan banditnya.
Dialogue: 0,0:11:12.00,0:11:14.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah kalau Tuan Ars yakin.
Dialogue: 0,0:11:18.67,0:11:20.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kebijaksanaannya tinggi
Dialogue: 0,0:11:20.39,0:11:22.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan strategi miliknya S?
Dialogue: 0,0:11:22.69,0:11:25.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia punya bakat jadi ahli strategi!
Dialogue: 0,0:11:25.21,0:11:27.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keberanian orang ini luar biasa!
Dialogue: 0,0:11:27.97,0:11:29.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bakat infanteri, kavaleri,
Dialogue: 0,0:11:29.76,0:11:31.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan memanahnya pun tinggi!
Dialogue: 0,0:11:31.70,0:11:34.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pasti gagah di medan perang.
Dialogue: 0,0:11:34.74,0:11:37.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski saling bertolak belakang,
Dialogue: 0,0:11:37.21,0:11:40.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mereka berbakat di bidang masing-masing.
Dialogue: 0,0:11:40.75,0:11:42.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau pria ini...
Dialogue: 0,0:11:42.68,0:11:46.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua statistiknya di atas rata-rata!
Dialogue: 0,0:11:46.08,0:11:49.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tipe seimbang yang serbabisa!
Dialogue: 0,0:11:50.78,0:11:54.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian bertiga aset berharga!
Dialogue: 0,0:11:56.11,0:11:59.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nama depannya sama semua?
Dialogue: 0,0:11:59.06,0:12:01.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka bersaudara?
Dialogue: 0,0:12:01.01,0:12:04.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka warga Kerajaan You dari benua tetangga.
Dialogue: 0,0:12:04.64,0:12:08.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pantas saja pakaiannya bernuansa timur.
Dialogue: 0,0:12:08.12,0:12:10.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu, anu...
Dialogue: 0,0:12:10.33,0:12:12.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf telah bikin gaduh!
Dialogue: 0,0:12:12.85,0:12:15.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maika, Takao, ayo!
Dialogue: 0,0:12:15.07,0:12:18.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tu-Tunggu, siapa kalian sebenarnya?
Dialogue: 0,0:12:18.91,0:12:22.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang, kami pengembara biasa!
Dialogue: 0,0:12:22.78,0:12:25.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa kita bicara sebentar?
Dialogue: 0,0:12:25.52,0:12:27.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tunggu!\N- Biarkan kami pergi!
Dialogue: 0,0:12:27.15,0:12:29.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebentar, kok!
Dialogue: 0,0:12:32.32,0:12:35.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan adalah pemimpin wilayah ini?
Dialogue: 0,0:12:35.03,0:12:37.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, begitulah.
Dialogue: 0,0:12:37.17,0:12:40.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia Bupati Canarre, Tuan Ars Louvent.
Dialogue: 0,0:12:42.91,0:12:47.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami juga minta maaf soal tadi.
Dialogue: 0,0:12:47.50,0:12:50.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belakangan ini,\Nwarga resah karena ulah bandit.
Dialogue: 0,0:12:50.92,0:12:53.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya Tuan turun langsung?
Dialogue: 0,0:12:53.94,0:12:56.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh aku bertanya juga?
Dialogue: 0,0:12:57.90,0:13:01.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa keluarga kerajaan\Nberkelana tanpa pengawalan?
Dialogue: 0,0:13:03.43,0:13:04.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keluarga kerajaan?
Dialogue: 0,0:13:10.78,0:13:13.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu mengira begitu?
Dialogue: 0,0:13:14.30,0:13:17.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di ornamen pedang milikmu
Dialogue: 0,0:13:17.68,0:13:20.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}terlihat ada Berlian Biru.
Dialogue: 0,0:13:22.11,0:13:26.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berlian Biru adalah permata\Nkhusus keluarga kerajaan
Dialogue: 0,0:13:26.06,0:13:29.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di Kerajaan You dari benua tetangga.
Dialogue: 0,0:13:30.35,0:13:35.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Artinya kamu keluarga kerajaan\Nkalau memilikinya.
Dialogue: 0,0:13:36.75,0:13:40.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buat apa keluarga Kerajaan You ke Canarre?
Dialogue: 0,0:13:44.74,0:13:46.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu benar.
Dialogue: 0,0:13:48.67,0:13:52.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katana ini pusaka warisan Keluarga Fujimiya.
Dialogue: 0,0:13:53.86,0:13:55.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katana Penebas Naga.
Dialogue: 0,0:13:55.95,0:13:58.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Konon, pedang ini bahkan bisa menebas naga.
Dialogue: 0,0:13:59.33,0:14:00.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menebas naga?
Dialogue: 0,0:14:01.25,0:14:02.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakanda!
Dialogue: 0,0:14:02.56,0:14:05.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa,\Nmereka tidak bisa dikelabui.
Dialogue: 0,0:14:07.14,0:14:10.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf telah pura-pura jadi pengembara.
Dialogue: 0,0:14:11.63,0:14:17.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kepala Keluarga Fujimiya yang dulunya\Nmemimpin Kerajaan You, Rikuya Fujimiya!
Dialogue: 0,0:14:17.59,0:14:19.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Raja Kerajaan You?
Dialogue: 0,0:14:19.70,0:14:22.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti, kamu kaisar dari benua lain?
Dialogue: 0,0:14:22.88,0:14:26.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa pejabat setinggi kamu ada di sini?
Dialogue: 0,0:14:29.58,0:14:31.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kudeta setahun lalu.
Dialogue: 0,0:14:33.73,0:14:35.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudeta?
Dialogue: 0,0:14:35.18,0:14:41.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, kudengar di Kerajaan You terjadi kudeta\Nyang menggulingkan keluarga kerajaan.
Dialogue: 0,0:14:41.04,0:14:44.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak kusangka ada yang selamat.
Dialogue: 0,0:14:45.02,0:14:48.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah terasing ke Benua Summerforth,
Dialogue: 0,0:14:48.67,0:14:55.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami berniat pulang kampung\Ndengan bantuan pejabat setempat.
Dialogue: 0,0:14:56.00,0:14:59.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, walau pernah menjalin\Nhubungan kerja sama,
Dialogue: 0,0:14:59.54,0:15:01.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mereka enggan membantu.
Dialogue: 0,0:15:01.73,0:15:06.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang jual saja katana itu\Nagar kita dapat uang!
Dialogue: 0,0:15:06.20,0:15:10.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana ada yang mau sukarela\Nmembantu pihak yang kalah!
Dialogue: 0,0:15:11.04,0:15:13.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sisa dana kita juga hampir habis.
Dialogue: 0,0:15:14.30,0:15:17.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lama-lama, bertahan hidup pun sulit.
Dialogue: 0,0:15:18.13,0:15:19.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Maika.
Dialogue: 0,0:15:20.46,0:15:23.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katana ini simbol pemimpin Kerajaan You.
Dialogue: 0,0:15:23.82,0:15:27.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inilah bukti bahwa aku adalah raja.
Dialogue: 0,0:15:27.95,0:15:31.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Percuma kalau tidak bisa pulang.
Dialogue: 0,0:15:35.23,0:15:38.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beginilah keadaannya.
Dialogue: 0,0:15:38.35,0:15:43.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka bisa saja mengirim pembunuh,\Njadi kami tidak bisa asal buka identitas.
Dialogue: 0,0:15:43.84,0:15:47.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, jadi begitu situasinya.
Dialogue: 0,0:15:48.02,0:15:51.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf asal bertindak tanpa pikir panjang.
Dialogue: 0,0:15:51.09,0:15:53.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak usah dipikirkan.
Dialogue: 0,0:15:56.38,0:16:02.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai seorang pejabat, bisakah kamu\Nmenghubungkan kami dengan Gubernur?
Dialogue: 0,0:16:02.19,0:16:06.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan sulit melakukannya kalau cuma kami.
Dialogue: 0,0:16:06.98,0:16:08.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja!
Dialogue: 0,0:16:08.24,0:16:13.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini pasti takdir,\Nkami akan membantu sebisa mungkin!
Dialogue: 0,0:16:15.33,0:16:17.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakanda, aku lapar.
Dialogue: 0,0:16:19.71,0:16:22.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama, Kakanda.
Dialogue: 0,0:16:22.04,0:16:24.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beberapa hari ini aku makan seadanya.
Dialogue: 0,0:16:24.84,0:16:27.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Mari ke Istana Canarre!
Dialogue: 0,0:16:27.18,0:16:30.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau berkenan, mari makan sama-sama.
Dialogue: 0,0:16:31.31,0:16:33.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:16:51.32,0:16:54.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah lama tidak dijamu!\NJadi tidak sabar!
Dialogue: 0,0:16:55.34,0:16:57.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh makan sampai kenyang?
Dialogue: 0,0:16:57.18,0:17:01.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita ini tamu, seharusnya boleh.
Dialogue: 0,0:17:01.25,0:17:03.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah, ya, Takao!
Dialogue: 0,0:17:03.04,0:17:04.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, Ayunda.
Dialogue: 0,0:17:04.58,0:17:06.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu yakin?
Dialogue: 0,0:17:06.85,0:17:08.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja.
Dialogue: 0,0:17:08.31,0:17:11.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong ceritakan lebih banyak\Nsoal Kerajaan You.
Dialogue: 0,0:17:11.56,0:17:12.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:17:12.83,0:17:15.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jamuan! Jamuan!
Dialogue: 0,0:17:16.55,0:17:19.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kami siapkan banyak makanan.
Dialogue: 0,0:17:27.65,0:17:29.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:17:29.42,0:17:30.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:17:30.75,0:17:32.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya ada seseorang.
Dialogue: 0,0:17:33.42,0:17:35.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekilas ada bau darah.
Dialogue: 0,0:17:39.25,0:17:41.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, gila banget.
Dialogue: 0,0:17:41.58,0:17:44.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku mengincar titik buta.
Dialogue: 0,0:17:44.93,0:17:47.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata kamu monster, ya.
Dialogue: 0,0:17:51.09,0:17:52.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masuklah ke kamar!
Dialogue: 0,0:18:02.60,0:18:05.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, Takao!\NHajar dia!
Dialogue: 0,0:18:15.07,0:18:16.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si-Sial!
Dialogue: 0,0:18:22.74,0:18:26.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mu-Musuh tidak terlihatnya kalah?
Dialogue: 0,0:18:26.63,0:18:29.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka menang dalam sekejap!
Dialogue: 0,0:18:30.67,0:18:32.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa kalian?
Dialogue: 0,0:18:32.70,0:18:36.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang kalian pakai itu alat sihir, kan?
Dialogue: 0,0:18:36.53,0:18:40.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pernah baca soal alat sihir\Nsupaya jadi tidak terlihat.
Dialogue: 0,0:18:40.21,0:18:46.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan pernah ada bandit\Nyang berulah di kota lalu menghilang.
Dialogue: 0,0:18:46.02,0:18:49.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti, kalian banditnya, kan?
Dialogue: 0,0:18:49.27,0:18:51.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tahu juga percuma.
Dialogue: 0,0:18:51.66,0:18:52.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rietz!
Dialogue: 0,0:18:54.98,0:18:56.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Ars!
Dialogue: 0,0:18:56.53,0:18:57.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakanda!
Dialogue: 0,0:18:57.47,0:19:00.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eits, jangan bergerak.
Dialogue: 0,0:19:00.04,0:19:04.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buang senjatamu!\NBiar setidaknya dia tidak kubunuh.
Dialogue: 0,0:19:14.42,0:19:17.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedangnya bagus, sesuai dugaanku.
Dialogue: 0,0:19:17.80,0:19:19.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa dijual mahal?
Dialogue: 0,0:19:19.87,0:19:24.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, pasti ada yang beli\Nmeski bentuknya aneh.
Dialogue: 0,0:19:24.06,0:19:27.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sudah kuincar sejak melihatnya di kota.
Dialogue: 0,0:19:28.54,0:19:32.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedangnya sudah dapat,\Nterus mereka diapakan?
Dialogue: 0,0:19:32.94,0:19:36.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, tumben ada orang luar.
Dialogue: 0,0:19:36.88,0:19:39.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita jual saja sebagai budak.
Dialogue: 0,0:19:39.83,0:19:45.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat, Rikuya dan lainnya\Nmalah terlibat masalah Canarre.
Dialogue: 0,0:19:45.65,0:19:47.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, wajahmu...
Dialogue: 0,0:19:48.05,0:19:50.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayaknya tidak asing.
Dialogue: 0,0:19:51.34,0:19:53.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kami...
Dialogue: 0,0:19:53.15,0:19:54.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedagang!
Dialogue: 0,0:19:54.94,0:19:56.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami tuan dan budak!
Dialogue: 0,0:19:57.71,0:20:02.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baguslah, tebusannya bakal mahal!
Dialogue: 0,0:20:02.10,0:20:04.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bang, Bos memanggilmu.
Dialogue: 0,0:20:04.72,0:20:06.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, aku datang.
Dialogue: 0,0:20:15.62,0:20:17.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Ars!
Dialogue: 0,0:20:17.84,0:20:20.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sungguh minta maaf!
Dialogue: 0,0:20:20.77,0:20:24.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku membuat kesalahan fatal\Nsebagai pendamping Tuan!
Dialogue: 0,0:20:24.74,0:20:27.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dosaku tidak termaafkan!
Dialogue: 0,0:20:27.12,0:20:30.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku yang salah karena lengah!
Dialogue: 0,0:20:30.10,0:20:32.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan terlalu merasa bersalah!
Dialogue: 0,0:20:32.24,0:20:34.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi... Tapi...
Dialogue: 0,0:20:35.63,0:20:38.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana ini, Kakanda?
Dialogue: 0,0:20:44.64,0:20:47.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ars diculik?
Dialogue: 0,0:20:47.56,0:20:49.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana bisa?
Dialogue: 0,0:20:49.26,0:20:51.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok kamu tidak mengawalnya?
Dialogue: 0,0:20:51.94,0:20:53.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu-Bukan begitu!
Dialogue: 0,0:20:53.57,0:20:58.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pintunya sudah kami jaga,\Ntapi ada serangan tidak kasatmata
Dialogue: 0,0:20:58.90,0:21:00.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang tidak bisa ditahan!
Dialogue: 0,0:21:00.95,0:21:03.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Musuhnya tidak terlihat?\NBenarkah?
Dialogue: 0,0:21:03.78,0:21:05.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be-Benar!
Dialogue: 0,0:21:05.26,0:21:08.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan kawanan bandit itu?
Dialogue: 0,0:21:08.33,0:21:11.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Po-Pokoknya ayo tolong mereka!\NMana Rosell?
Dialogue: 0,0:21:11.46,0:21:13.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedang kunjungan diplomatik!
Dialogue: 0,0:21:13.36,0:21:16.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus bagaimana strateginya?
Dialogue: 0,0:21:16.48,0:21:19.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja, ayo langsung serbu!
Dialogue: 0,0:21:19.89,0:21:23.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Anu, Nona Lycia baik-baik saja?
Dialogue: 0,0:21:24.45,0:21:29.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Braham, kirim Pasukan Elite\Nke markas musuh sekarang.
Dialogue: 0,0:21:30.10,0:21:31.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pimpinlah mereka.
Dialogue: 0,0:21:31.57,0:21:32.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke!
Dialogue: 0,0:21:32.91,0:21:35.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zat, ikutlah sebagai wakilnya.
Dialogue: 0,0:21:35.98,0:21:37.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baik.
Dialogue: 0,0:21:37.73,0:21:42.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka memang mau kubasmi,\Nkebetulan sekali.
Dialogue: 0,0:21:42.98,0:21:47.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Tuan Ars terluka setitik saja,
Dialogue: 0,0:21:48.75,0:21:52.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan kulenyapkan keluarga mereka tanpa sisa.
Dialogue: 0,0:23:25.81,0:23:30.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Lycia yang biasanya lembut\Njadi ngeri kalau soal Tuan Ars!
Dialogue: 0,0:23:30.43,0:23:33.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya Lycia sangat mencintai Ars.
Dialogue: 0,0:23:33.18,0:23:36.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cukup bergosipnya, ayo susun strategi!
Dialogue: 0,0:23:36.90,0:23:37.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya,
Dialogue: 0,0:23:37.69,0:23:40.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Misi Penyelamatan Ars".
