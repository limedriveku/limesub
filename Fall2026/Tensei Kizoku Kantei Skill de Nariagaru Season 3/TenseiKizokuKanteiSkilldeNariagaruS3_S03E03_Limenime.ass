Dialogue: 0,0:00:00.72,0:00:05.01,sign,,0000,0000,0000,,SUNGAI KHMER
Dialogue: 0,0:02:21.33,0:02:27.00,sign,,0000,0000,0000,,AS A REINCARNATED ARISTOCRAT, I'LL USE MY\NAPPRAISAL SKILL TO RISE IN THE WORLD SEASON 3
Dialogue: 0,0:02:27.00,0:02:32.02,sign,,0000,0000,0000,,EPISODE 27: ZAT DAN BRAHAM
Dialogue: 0,0:02:49.15,0:02:52.65,sign,,0000,0000,0000,,PROVINSI SEITZ, BENTENG PLURADE
Dialogue: 0,0:02:53.10,0:02:56.77,sign,,0000,0000,0000,,RANTOLK RODDER
Dialogue: 0,0:03:00.16,0:03:04.02,sign,,0000,0000,0000,,BOROTTS HEIGAND
Dialogue: 0,0:03:55.30,0:03:58.30,sign,,0000,0000,0000,,TITIK PENYEBERANGAN BARU
Dialogue: 0,0:05:29.89,0:05:32.90,sign,,0000,0000,0000,,HULU SUNGAI KHMER
Dialogue: 0,0:06:53.35,0:06:55.90,sign,,0000,0000,0000,,LINI BELAKANG
Dialogue: 0,0:11:48.98,0:11:52.74,sign,,0000,0000,0000,,AS A REINCARNATED ARISTOCRAT, I'LL USE MY\NAPPRAISAL SKILL TO RISE IN THE WORLD SEASON 3
Dialogue: 0,0:11:54.59,0:11:56.90,sign,,0000,0000,0000,,LAHIRNYA SANG PEJUANG
Dialogue: 0,0:12:14.84,0:12:19.14,sign,,0000,0000,0000,,BRAHAM JOE, 8 TAHUN
Dialogue: 0,0:19:06.17,0:19:08.70,sign,,0000,0000,0000,,MASA LALU ZAT
Dialogue: 0,0:21:18.59,0:21:22.34,sign,,0000,0000,0000,,BENTENG KHMER
Dialogue: 0,0:23:37.56,0:23:42.80,sign,,0000,0000,0000,,SELANJUTNYA: AKHIR PERANG
Dialogue: 0,0:00:14.85,0:00:17.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Musha, sihirmu hebat.
Dialogue: 0,0:00:17.52,0:00:19.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu makin jago saja.
Dialogue: 0,0:00:19.89,0:00:21.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:00:21.54,0:00:24.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan berusaha agar lebih berguna.
Dialogue: 0,0:00:26.26,0:00:29.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baru menang malah disuruh kerja kasar.
Dialogue: 0,0:00:29.44,0:00:32.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guru memang tidak kenal ampun.
Dialogue: 0,0:00:32.65,0:00:34.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bawa bata ini ke barat.
Dialogue: 0,0:00:34.90,0:00:35.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:00:35.78,0:00:37.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang ini ke dekat gerbang istana.
Dialogue: 0,0:00:37.43,0:00:37.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:00:39.39,0:00:42.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkat komando Rietz yang piawai,
Dialogue: 0,0:00:42.52,0:00:46.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}40.000 garda depan pasukan Seitz\Ndipukul mundur.
Dialogue: 0,0:00:46.28,0:00:52.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nama Malaikat Maut Louvent\Ndan dua penyihir dari Missian
Dialogue: 0,0:00:52.70,0:00:56.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mulai dikenal di kalangan bala tentara Seitz.
Dialogue: 0,0:02:27.68,0:02:32.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, ternyata pasukan Seitz tidak seberapa.
Dialogue: 0,0:02:32.02,0:02:34.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenagaku masih banyak, nih.
Dialogue: 0,0:02:34.03,0:02:35.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:02:35.86,0:02:37.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, tolong bawa ini.
Dialogue: 0,0:02:37.62,0:02:39.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gampang!
Dialogue: 0,0:02:46.03,0:02:48.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga saja mereka menyerah...
Dialogue: 0,0:02:49.15,0:02:52.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku, Tuan Borotts!
Dialogue: 0,0:02:53.10,0:02:56.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudahlah, justru kita jadi tahu kekuatan musuh.
Dialogue: 0,0:02:56.77,0:03:00.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pantas saja paduka rela perang lagi.
Dialogue: 0,0:03:00.16,0:03:02.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bekas kubu mantan gubernur sepertiku
Dialogue: 0,0:03:02.51,0:03:04.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}telah diampuni dan dipercaya,
Dialogue: 0,0:03:04.02,0:03:07.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi malah mencoreng nama Anda!
Dialogue: 0,0:03:07.97,0:03:11.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertahanan musuh bagus juga.
Dialogue: 0,0:03:11.62,0:03:14.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami serang ramai-ramai pun akan sulit.
Dialogue: 0,0:03:15.62,0:03:18.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jenderal bernama Rietz itu pintar juga.
Dialogue: 0,0:03:20.12,0:03:24.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Canarre, ya.\NAku jadi tambah penasaran.
Dialogue: 0,0:03:25.76,0:03:26.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya!
Dialogue: 0,0:03:27.25,0:03:29.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya pasukan Rietz menang!
Dialogue: 0,0:03:30.44,0:03:32.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rietz memang hebat!
Dialogue: 0,0:03:32.92,0:03:36.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal pasukan musuh\Njumlahnya dua kali lipat!
Dialogue: 0,0:03:36.40,0:03:40.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga saja musuh menyerah.
Dialogue: 0,0:03:40.03,0:03:41.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:03:42.32,0:03:45.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesuai rencana, langkah musuh terhenti.
Dialogue: 0,0:03:45.46,0:03:47.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sisanya tergantung reaksi mereka.
Dialogue: 0,0:03:49.55,0:03:50.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi.
Dialogue: 0,0:03:50.96,0:03:54.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa tolong kirim utusan ke kediaman Louvent?
Dialogue: 0,0:03:58.30,0:04:00.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, ini bagus.
Dialogue: 0,0:04:01.25,0:04:04.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk apa mengumpulkan rusa?
Dialogue: 0,0:04:04.53,0:04:07.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, lepaskan rusa-rusanya!
Dialogue: 0,0:04:07.09,0:04:07.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:04:10.26,0:04:12.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Giring rusanya dengan anjing dan prajurit!
Dialogue: 0,0:04:12.86,0:04:14.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arahkan ke sungai!
Dialogue: 0,0:04:22.05,0:04:24.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Borotts, apa ini?
Dialogue: 0,0:04:24.51,0:04:27.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat saja, nanti juga tahu.
Dialogue: 0,0:04:39.76,0:04:41.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rusanya menyeberang!
Dialogue: 0,0:04:41.26,0:04:43.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, belum.
Dialogue: 0,0:04:51.17,0:04:53.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu titik penyeberangan baru!
Dialogue: 0,0:04:53.38,0:04:55.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai sekarang kita lewat situ!
Dialogue: 0,0:04:55.49,0:04:56.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap!
Dialogue: 0,0:04:56.98,0:04:58.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Borotts...
Dialogue: 0,0:04:58.99,0:05:01.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anda sungguh luar biasa.
Dialogue: 0,0:05:01.20,0:05:02.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rantolk.
Dialogue: 0,0:05:02.16,0:05:03.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya?
Dialogue: 0,0:05:03.87,0:05:08.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu memimpin dengan cermat,\Nmakanya kujadikan jenderal.
Dialogue: 0,0:05:08.90,0:05:10.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan gagal lagi, ya.
Dialogue: 0,0:05:10.69,0:05:13.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap laksanakan!
Dialogue: 0,0:05:14.64,0:05:17.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Rietz, kabar buruk!
Dialogue: 0,0:05:17.68,0:05:20.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin!\NDalam waktu sesingkat ini?
Dialogue: 0,0:05:20.43,0:05:22.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi musuh memang bergerak!
Dialogue: 0,0:05:23.10,0:05:27.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mereka menyeberangi sungai,\Nkami tidak akan bisa bertahan!
Dialogue: 0,0:05:28.78,0:05:29.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana?
Dialogue: 0,0:05:30.46,0:05:32.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada 70.000 prajurit.
Dialogue: 0,0:05:34.26,0:05:35.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}70.000?
Dialogue: 0,0:05:35.65,0:05:38.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hampir dua kali lipat sebelumnya!
Dialogue: 0,0:05:38.75,0:05:43.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau ditambah atau dikali pun\Npasti rata oleh sihir Mbak, kan?
Dialogue: 0,0:05:44.26,0:05:45.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa.
Dialogue: 0,0:05:45.90,0:05:49.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tidak bawa katalis besar\Nkarena buru-buru kemari.
Dialogue: 0,0:05:49.86,0:05:53.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Strategi sihir sebelumnya tidak bisa dipakai!
Dialogue: 0,0:05:53.54,0:05:55.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti...
Dialogue: 0,0:05:55.42,0:05:57.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita terdesak, dong?
Dialogue: 0,0:05:57.67,0:06:00.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat bentuk formasi bertahan!
Dialogue: 0,0:06:00.24,0:06:03.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasukan Jarak Jauh,\Ncegah musuh menyeberang!
Dialogue: 0,0:06:07.18,0:06:09.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasukan musuh bergerak!
Dialogue: 0,0:06:09.62,0:06:13.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Garda Depan, aktifkan sihir pelindung!
Dialogue: 0,0:06:15.30,0:06:18.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waspada serangan sihir yang kuat!
Dialogue: 0,0:06:18.44,0:06:21.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasukan Jarak Jauh, bersiap!
Dialogue: 0,0:06:22.29,0:06:24.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tembak!
Dialogue: 0,0:06:25.15,0:06:30.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}20.000 pasukan Rietz melawan 70.000 musuh.
Dialogue: 0,0:06:30.56,0:06:32.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya masalah waktu
Dialogue: 0,0:06:32.78,0:06:38.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hingga pasukan Rietz dilibas pasukan Seitz\Nyang banyak dan bersemangat.
Dialogue: 0,0:06:41.74,0:06:44.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan perang!\NKita mundur dulu!
Dialogue: 0,0:06:44.72,0:06:47.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat! Mundur!
Dialogue: 0,0:06:47.09,0:06:48.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buang barang yang tidak penting!
Dialogue: 0,0:06:48.85,0:06:52.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini saatnya! Kejar!
Dialogue: 0,0:06:54.21,0:06:55.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Clamant!
Dialogue: 0,0:06:55.90,0:06:59.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan ke lini belakang\Ndan mencegah kejaran musuh!
Dialogue: 0,0:06:59.82,0:07:01.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa bantu aku?
Dialogue: 0,0:07:01.61,0:07:04.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahaya kalau jenderal tumbang.
Dialogue: 0,0:07:04.26,0:07:05.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar aku saja.
Dialogue: 0,0:07:05.79,0:07:06.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan!
Dialogue: 0,0:07:07.06,0:07:12.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat mundur, meminimalisasi korban\Nadalah tugas jenderal!
Dialogue: 0,0:07:12.45,0:07:14.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin turun tangan!
Dialogue: 0,0:07:15.38,0:07:18.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guru, biar aku saja!
Dialogue: 0,0:07:18.91,0:07:19.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Braham?
Dialogue: 0,0:07:19.84,0:07:23.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan pada kami, Pasukan Elite!
Dialogue: 0,0:07:23.73,0:07:25.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guru fokus saja memimpin.
Dialogue: 0,0:07:25.52,0:07:27.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini tidak main-main!
Dialogue: 0,0:07:27.60,0:07:30.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bertempur sambil mundur itu sulit!
Dialogue: 0,0:07:30.78,0:07:33.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengalamanmu belum cukup!
Dialogue: 0,0:07:33.10,0:07:34.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku serius.
Dialogue: 0,0:07:35.52,0:07:39.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin kami pasukan terkuat di Canarre.
Dialogue: 0,0:07:39.31,0:07:44.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru misi sulit adalah tugas kami\Nyang setingkat di bawah Guru.
Dialogue: 0,0:07:45.38,0:07:48.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah peran Pasukan Elite, kan?
Dialogue: 0,0:07:48.32,0:07:50.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan juga...
Dialogue: 0,0:07:50.45,0:07:54.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan apa-apa!\NPokoknya tenang saja!
Dialogue: 0,0:07:54.10,0:07:58.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inilah saatnya memamerkan\Nhasil dilatih oleh Guru!
Dialogue: 0,0:08:00.16,0:08:04.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, kupercayakan 20.000\Nnyawa prajurit padamu.
Dialogue: 0,0:08:04.53,0:08:06.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi taatilah satu hal.
Dialogue: 0,0:08:08.64,0:08:10.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pulanglah hidup-hidup.
Dialogue: 0,0:08:11.70,0:08:13.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu, sih, enteng!
Dialogue: 0,0:08:18.23,0:08:21.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, cepat isi cairan sihirnya!
Dialogue: 0,0:08:21.23,0:08:22.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akan terkejar!
Dialogue: 0,0:08:24.69,0:08:26.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Musha!
Dialogue: 0,0:08:39.21,0:08:44.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akulah Kapten Pasukan Elite Canarre!\NBraham Joe!
Dialogue: 0,0:08:45.15,0:08:49.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian punya ibu yang menunggu\Ndi rumah, tidak?
Dialogue: 0,0:08:52.94,0:08:57.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang mau tidur di pelukan ibunya,\Ncepat putar balik!
Dialogue: 0,0:09:00.45,0:09:05.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Majulah kalau siap jadi batu nisan\Ndan ditangisi ibu kalian!
Dialogue: 0,0:09:07.82,0:09:09.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo semuanya!
Dialogue: 0,0:09:18.13,0:09:21.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami harus melawan 70.000 musuh?
Dialogue: 0,0:09:21.14,0:09:22.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku takut.
Dialogue: 0,0:09:22.67,0:09:23.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kamu.
Dialogue: 0,0:09:23.71,0:09:24.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya?
Dialogue: 0,0:09:25.36,0:09:27.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pria sejati, ya.
Dialogue: 0,0:09:28.43,0:09:30.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gemetar tandanya antusias.
Dialogue: 0,0:09:31.06,0:09:34.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak sabar pamer kejantanan.\NBenar, kan?
Dialogue: 0,0:09:34.72,0:09:38.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ingat, kita adalah pria terkuat Canarre
Dialogue: 0,0:09:38.68,0:09:40.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang tidak takut mati!
Dialogue: 0,0:09:41.42,0:09:46.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Besok kita pasti akan dikenal\Nseantero Missian!
Dialogue: 0,0:09:48.90,0:09:50.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar!
Dialogue: 0,0:09:50.51,0:09:51.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa takut!
Dialogue: 0,0:09:51.90,0:09:53.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu juga sama, kan?
Dialogue: 0,0:09:55.23,0:09:56.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:10:04.10,0:10:05.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:10:06.35,0:10:11.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alasan Tuan Ars memilihnya mulai masuk akal.
Dialogue: 0,0:10:16.29,0:10:17.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Braham...
Dialogue: 0,0:10:21.41,0:10:25.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu berhasil diulur,\Npasukan utama kita pasti sudah mundur.
Dialogue: 0,0:10:25.26,0:10:27.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita juga sudah di ambang batas.
Dialogue: 0,0:10:29.30,0:10:30.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:10:30.96,0:10:34.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya, ayo segera mundur!
Dialogue: 0,0:10:37.99,0:10:39.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak saja!
Dialogue: 0,0:10:39.99,0:10:41.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Libas mereka!
Dialogue: 0,0:10:52.26,0:10:54.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten, pakai pedangku!
Dialogue: 0,0:10:54.88,0:10:56.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan dia?
Dialogue: 0,0:10:58.90,0:11:02.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti aku menyusul!\NKalian duluan saja!
Dialogue: 0,0:11:06.45,0:11:08.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten harus ditolong!
Dialogue: 0,0:11:08.06,0:11:12.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bodoh, musuhnya kebanyakan!\NIni saja belum semua!
Dialogue: 0,0:11:12.58,0:11:14.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa mau ditinggalkan?
Dialogue: 0,0:11:15.33,0:11:18.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah ini kesempatan?
Dialogue: 0,0:11:18.86,0:11:23.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau meninggalkannya,\Naku akan jadi kapten.
Dialogue: 0,0:11:23.49,0:11:26.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya aku ogah jadi bawahan bocah itu...
Dialogue: 0,0:11:26.99,0:11:28.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wakil Kapten, mohon perintah!
Dialogue: 0,0:11:31.34,0:11:32.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zat!
Dialogue: 0,0:11:33.12,0:11:37.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bawa pasukan kita!\NLalu sampaikan pada guru...
Dialogue: 0,0:11:38.45,0:11:41.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Maaf tidak bisa menaati perintah."
Dialogue: 0,0:11:44.62,0:11:48.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, ternyata aku memang bodoh.
Dialogue: 0,0:11:52.74,0:11:54.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sembilan tahun lalu,
Dialogue: 0,0:11:54.59,0:11:56.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}waktu usiaku baru delapan tahun...
Dialogue: 0,0:11:56.90,0:12:00.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini pasukan kami jagoannya.
Dialogue: 0,0:12:00.50,0:12:04.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan mimpi, kamilah kunci kemenangannya.
Dialogue: 0,0:12:09.23,0:12:11.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu Keluarga Joe.
Dialogue: 0,0:12:11.44,0:12:14.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kabarnya mereka sukses besar lagi.
Dialogue: 0,0:12:14.84,0:12:19.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama ada mereka, kita dijamin menang.
Dialogue: 0,0:12:19.65,0:12:21.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Abang! Ayah!
Dialogue: 0,0:12:21.84,0:12:23.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang.
Dialogue: 0,0:12:23.22,0:12:25.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami pulang, Braham.
Dialogue: 0,0:12:25.65,0:12:28.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah bisa naik kuda, lo.
Dialogue: 0,0:12:28.37,0:12:30.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pengin cepat perang bareng kalian!
Dialogue: 0,0:12:30.85,0:12:33.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senang mendengarnya.
Dialogue: 0,0:12:33.17,0:12:36.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi lihat tombak pusaka Keluarga Joe ini.
Dialogue: 0,0:12:36.74,0:12:40.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu harus bisa mengayunkannya,\Nbarulah dianggap layak.
Dialogue: 0,0:12:42.88,0:12:46.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak zaman kakek moyangku,
Dialogue: 0,0:12:46.03,0:12:50.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keluarga Joe telah turun-temurun\Nmenjadi prajurit kavaleri.
Dialogue: 0,0:12:51.09,0:12:54.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku, Abang, dan Ayah
Dialogue: 0,0:12:54.58,0:12:57.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}siap memenuhi panggilan\Nke seantero Summerforth.
Dialogue: 0,0:12:58.56,0:13:02.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena belum lancar pegang senjata\Ndan menunggang kuda,
Dialogue: 0,0:13:02.62,0:13:06.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku cuma jadi asisten mereka\Ndan tidak ikut berperang.
Dialogue: 0,0:13:06.88,0:13:08.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi suatu saat...
Dialogue: 0,0:13:09.22,0:13:13.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan naik kuda galak,\Nmengayun senjata besar,
Dialogue: 0,0:13:13.02,0:13:16.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan jadi pejuang hebat seperti mereka.
Dialogue: 0,0:13:16.67,0:13:18.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira begitu...
Dialogue: 0,0:13:20.05,0:13:21.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Braham!
Dialogue: 0,0:13:22.29,0:13:24.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Abang!
Dialogue: 0,0:13:24.58,0:13:26.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu baik-baik saja?\NMana Ayah?
Dialogue: 0,0:13:26.96,0:13:30.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baru mau menolongnya,\Nbawakan senjata.
Dialogue: 0,0:13:30.88,0:13:34.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lawan 10 orang pun Ayah pasti menang!
Dialogue: 0,0:13:34.16,0:13:36.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Abang jangan mau kalah!
Dialogue: 0,0:13:41.58,0:13:42.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Braham.
Dialogue: 0,0:13:43.52,0:13:45.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terimalah ini.
Dialogue: 0,0:13:45.52,0:13:46.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:13:49.73,0:13:53.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi ini benda penting, kan?\NKok tidak dibawa?
Dialogue: 0,0:13:53.58,0:13:57.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Habisnya musuhnya kegampangan.
Dialogue: 0,0:13:57.06,0:13:59.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, aku berangkat.
Dialogue: 0,0:14:00.38,0:14:03.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kembalilah dengan selamat!
Dialogue: 0,0:14:04.40,0:14:08.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, Abang dan Ayah tidak kembali.
Dialogue: 0,0:14:11.89,0:14:17.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski perang telah lama berakhir,\Nkeduanya tidak berkabar.
Dialogue: 0,0:14:18.52,0:14:21.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka lama sekali.
Dialogue: 0,0:14:21.02,0:14:22.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei.
Dialogue: 0,0:14:22.63,0:14:26.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bocah Keluarga Joe, kan?\NSedang apa di sini?
Dialogue: 0,0:14:26.91,0:14:30.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menunggu Abang dan Ayah pulang.
Dialogue: 0,0:14:30.52,0:14:34.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar bodoh, jelas-jelas mereka mati.
Dialogue: 0,0:14:35.04,0:14:36.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka tidak mati.
Dialogue: 0,0:14:36.64,0:14:39.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang-orang juga bilang mereka mati.
Dialogue: 0,0:14:39.68,0:14:42.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bohong, mustahil mereka kalah.
Dialogue: 0,0:14:42.98,0:14:45.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu kenapa tidak pulang?
Dialogue: 0,0:14:45.10,0:14:49.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau hidup tapi tidak pulang,\Nberarti kamu dibuang, dong?
Dialogue: 0,0:14:49.38,0:14:51.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tega sekali.
Dialogue: 0,0:14:53.78,0:14:58.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak saja!\NJangan menghina mereka!
Dialogue: 0,0:14:58.30,0:15:02.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terserah mau bilang apa,\NAbang dan Ayahku masih hidup!
Dialogue: 0,0:15:02.17,0:15:04.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin!
Dialogue: 0,0:15:06.43,0:15:07.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nak...
Dialogue: 0,0:15:12.62,0:15:14.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya.
Dialogue: 0,0:15:14.06,0:15:15.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini dia!
Dialogue: 0,0:15:18.85,0:15:24.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau terkenal pakai senjata ini,\NAbang dan Ayah akan tahu itu aku!
Dialogue: 0,0:15:24.53,0:15:30.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma perlu jadi pria hebat\Nsampai dikenal seisi Summerforth!
Dialogue: 0,0:15:35.68,0:15:38.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu aba-aba dulu.
Dialogue: 0,0:15:38.94,0:15:39.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lah?
Dialogue: 0,0:15:39.54,0:15:43.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Braham Joe!
Dialogue: 0,0:15:43.70,0:15:45.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Calon pria terkuat!
Dialogue: 0,0:15:47.78,0:15:49.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus jadi kuat.
Dialogue: 0,0:15:50.46,0:15:53.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harus makin kuat dan jadi terkenal.
Dialogue: 0,0:15:54.45,0:15:55.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan begitu...
Dialogue: 0,0:15:59.33,0:16:03.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suatu saat, mereka pasti pulang.
Dialogue: 0,0:16:10.00,0:16:11.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Braham!
Dialogue: 0,0:16:16.10,0:16:17.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zat, kamu...
Dialogue: 0,0:16:17.34,0:16:20.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa malah menyerah?\NCepat berdiri!
Dialogue: 0,0:16:20.83,0:16:23.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Musuhnya kebanyakan, cepat lari...
Dialogue: 0,0:16:23.94,0:16:26.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Braham Joe tidak akan begini!
Dialogue: 0,0:16:26.98,0:16:29.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah kamu calon pria terkuat?
Dialogue: 0,0:16:29.51,0:16:30.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial!
Dialogue: 0,0:16:32.80,0:16:36.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hidupmu tidak boleh berakhir semudah ini!
Dialogue: 0,0:16:39.34,0:16:43.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bertambah satu orang pun percuma!\NKepung mereka!
Dialogue: 0,0:16:48.18,0:16:51.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar kapten yang merepotkan.
Dialogue: 0,0:16:55.52,0:16:59.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Zat!\NAku hampir lupa!
Dialogue: 0,0:16:59.08,0:17:03.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku telah bersumpah pada tombak ini,\Nuntuk mencapai tujuanku!
Dialogue: 0,0:17:03.46,0:17:05.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum saatnya untuk mati!
Dialogue: 0,0:17:06.29,0:17:10.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Braham Joe, calon pria terkuat!
Dialogue: 0,0:17:10.83,0:17:14.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyatanya dia sekarat!\NSerang saja!
Dialogue: 0,0:17:21.94,0:17:23.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten!
Dialogue: 0,0:17:24.24,0:17:25.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Naiklah!
Dialogue: 0,0:17:29.36,0:17:33.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membunuh dua orang saja lama!\NCepat habisi...
Dialogue: 0,0:17:35.66,0:17:39.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten, jangan mencoba\Njadi legenda sendirian!
Dialogue: 0,0:17:40.27,0:17:42.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak boleh mati dengan keren!
Dialogue: 0,0:17:42.79,0:17:47.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian sama bodohnya denganku, ya!
Dialogue: 0,0:17:47.06,0:17:49.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, ayo mundur!
Dialogue: 0,0:17:49.51,0:17:52.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan dilepas! Kejar!
Dialogue: 0,0:18:06.98,0:18:09.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka sudah berhenti mengejar.
Dialogue: 0,0:18:09.87,0:18:11.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita berhasil.
Dialogue: 0,0:18:12.75,0:18:15.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten?\NHei, Kapten!
Dialogue: 0,0:18:20.53,0:18:21.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar.
Dialogue: 0,0:18:21.92,0:18:24.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bikin cemas saja.
Dialogue: 0,0:18:30.17,0:18:32.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka kembali!
Dialogue: 0,0:18:33.31,0:18:35.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami pulang!
Dialogue: 0,0:18:35.84,0:18:37.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka berhasil!
Dialogue: 0,0:18:37.95,0:18:40.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kejaran 70.000 prajurit telah dihalau!
Dialogue: 0,0:18:41.33,0:18:42.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guru!
Dialogue: 0,0:18:44.16,0:18:48.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus, Braham.\NKamu memang murid terbaikku.
Dialogue: 0,0:18:48.46,0:18:50.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, berhasil!
Dialogue: 0,0:18:50.40,0:18:52.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku, sih, sudah pasrah tadi.
Dialogue: 0,0:18:52.98,0:18:54.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Parah!
Dialogue: 0,0:18:56.46,0:18:58.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajar, dong?
Dialogue: 0,0:18:58.51,0:19:00.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa aku jadi teringat, ya?
Dialogue: 0,0:19:01.49,0:19:04.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal, mereka tidak mirip.
Dialogue: 0,0:19:06.17,0:19:08.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Papa mau pergi?
Dialogue: 0,0:19:08.70,0:19:12.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada pekerjaan berupah besar,\Naku akan pulang dalam dua minggu.
Dialogue: 0,0:19:12.90,0:19:15.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kutitipkan ke nenek di seberang.
Dialogue: 0,0:19:21.31,0:19:27.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengertilah, kita butuh uang\Ndemi membawamu ke dokter di ibu kota.
Dialogue: 0,0:19:27.60,0:19:31.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, tapi daripada itu...
Dialogue: 0,0:19:31.52,0:19:32.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:19:32.78,0:19:35.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu sehat, ayo main sepuasnya.
Dialogue: 0,0:19:36.34,0:19:38.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, hati-hati di jalan.
Dialogue: 0,0:19:39.58,0:19:44.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ingatanku saat itu,\Nhanya dipenuhi pertempuran.
Dialogue: 0,0:19:44.87,0:19:48.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bertempur dan bertempur\Ndemi mencari nafkah.
Dialogue: 0,0:19:48.88,0:19:51.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan ketika tiba di rumah...
Dialogue: 0,0:19:52.83,0:19:54.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anakku meninggal.
Dialogue: 0,0:19:55.63,0:19:57.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa diriku...
Dialogue: 0,0:19:59.78,0:20:05.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski tidak perlu bertempur lagi,\Npenyesalan soal uang tetap menempel
Dialogue: 0,0:20:05.36,0:20:08.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan membuatku sulit mengubah cara hidup.
Dialogue: 0,0:20:08.77,0:20:13.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, kalau mengaku telah salah langkah,
Dialogue: 0,0:20:13.38,0:20:16.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kewarasanku pasti hilang
Dialogue: 0,0:20:16.59,0:20:20.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena menyesal tidak menemaninya.
Dialogue: 0,0:20:20.78,0:20:22.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia juga sama.
Dialogue: 0,0:20:23.20,0:20:26.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku tidak berutang budi padanya.
Dialogue: 0,0:20:26.54,0:20:28.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih untung kalau membuangnya.
Dialogue: 0,0:20:29.25,0:20:34.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, masa dia juga harus jadi korban\Ndari cara hidupku?
Dialogue: 0,0:20:36.21,0:20:38.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa depan anakku telah pupus.
Dialogue: 0,0:20:39.31,0:20:40.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu...
Dialogue: 0,0:20:40.93,0:20:44.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada lagi mimpi anak-anak\Nyang boleh pupus!
Dialogue: 0,0:20:48.48,0:20:50.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wakil Kapten Zat.
Dialogue: 0,0:20:50.48,0:20:54.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami menyusul berkat inisiatifmu.
Dialogue: 0,0:20:54.98,0:20:57.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih!
Dialogue: 0,0:20:57.86,0:20:59.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bermaksud...
Dialogue: 0,0:20:59.55,0:21:01.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zat!
Dialogue: 0,0:21:10.34,0:21:12.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin kali ini,
Dialogue: 0,0:21:12.82,0:21:15.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pilihanku tidak salah.
Dialogue: 0,0:21:18.59,0:21:22.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya, perangnya pasti sulit.
Dialogue: 0,0:21:22.78,0:21:25.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah melindungi 20.000 pasukan.
Dialogue: 0,0:21:25.86,0:21:28.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bersyukur memilihmu.
Dialogue: 0,0:21:28.61,0:21:31.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, faktanya kami kalah.
Dialogue: 0,0:21:31.66,0:21:35.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Musuh berada di atas angin,\Nkita tidak bisa tinggal diam.
Dialogue: 0,0:21:35.71,0:21:38.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan cuma Rietz dan Charlotte.
Dialogue: 0,0:21:38.58,0:21:42.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Musha, Braham, dan juga Zat.
Dialogue: 0,0:21:42.32,0:21:45.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para pengikut baru pun telah berusaha keras.
Dialogue: 0,0:21:46.59,0:21:49.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini giliranku untuk berusaha!
Dialogue: 0,0:21:49.49,0:21:51.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita serang balik!
Dialogue: 0,0:21:51.68,0:21:54.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Giliran kita yang menyerang!
Dialogue: 0,0:23:26.51,0:23:28.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Braham sukses besar, ya.
Dialogue: 0,0:23:28.55,0:23:32.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bangga melihatnya makin tangguh.
Dialogue: 0,0:23:32.12,0:23:34.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktunya kita menyerang balik.
Dialogue: 0,0:23:34.89,0:23:36.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pasti akan melindungi Canarre!
Dialogue: 0,0:23:37.56,0:23:38.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya, "Akhir Perang".
