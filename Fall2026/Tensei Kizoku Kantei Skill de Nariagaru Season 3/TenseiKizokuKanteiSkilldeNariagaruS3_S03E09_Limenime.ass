Dialogue: 0,0:00:00.82,0:00:04.46,sign,,0000,0000,0000,,INFORMASI DARI BUYGO
Dialogue: 0,0:02:49.27,0:02:55.03,sign,,0000,0000,0000,,AS A REINCARNATED ARISTOCRAT, I'LL USE MY\NAPPRAISAL SKILL TO RISE IN THE WORLD SEASON 3
Dialogue: 0,0:02:55.03,0:02:57.78,sign,,0000,0000,0000,,SEMINGGU KEMUDIAN
Dialogue: 0,0:02:57.78,0:03:00.62,sign,,0000,0000,0000,,EPISODE 33: ASA YANG TERPENDAM
Dialogue: 0,0:03:36.78,0:03:40.03,sign,,0000,0000,0000,,PERSONEL BARU
Dialogue: 0,0:03:47.92,0:03:50.86,sign,,0000,0000,0000,,ENAN LUGEZ, WANITA 21 TAHUN
Dialogue: 0,0:03:50.86,0:03:52.77,sign,,0000,0000,0000,,KEPEMIMPINAN 22, KEBERANIAN 21,
Dialogue: 0,0:03:52.77,0:03:54.91,sign,,0000,0000,0000,,KECERDASAN 80, AMBISI 0
Dialogue: 0,0:03:54.91,0:03:57.63,sign,,0000,0000,0000,,INFANTERI D, KAVALERI D, MEMANAH D, SIHIR D,
Dialogue: 0,0:03:57.63,0:03:58.95,sign,,0000,0000,0000,,KONSTRUKSI B, KESENJATAAN S, ANGKATAN LAUT B,
Dialogue: 0,0:03:58.95,0:03:59.93,sign,,0000,0000,0000,,ANGKATAN UDARA B, STRATEGI C
Dialogue: 0,0:03:59.93,0:04:01.87,sign,,0000,0000,0000,,LAHIR DI MISSIAN, TAHUN 191 KALENDER KEKAISARAN
Dialogue: 0,0:04:01.87,0:04:04.43,sign,,0000,0000,0000,,ORANG TUA MASIH HIDUP, PUNYA DUA KAKAK LELAKI
Dialogue: 0,0:04:24.58,0:04:28.83,sign,,0000,0000,0000,,KARENA TIDAK BISA BICARA,\NBOLEH AKU KOMUNIKASI LEWAT TULISAN?
Dialogue: 0,0:06:50.62,0:06:53.23,sign,,0000,0000,0000,,PENYUSUPAN MAID
Dialogue: 0,0:09:44.31,0:09:46.94,sign,,0000,0000,0000,,WAJAH ITU PANTAS DIBINGKAI\NDAN DIPAJANG DI PINTU MASUK
Dialogue: 0,0:09:54.22,0:09:56.49,sign,,0000,0000,0000,,DI BAWAHNYA TINGGAL TULIS,\N"MOMEN NYONYA TERKEJUT"
Dialogue: 0,0:10:55.20,0:11:00.01,sign,,0000,0000,0000,,AS A REINCARNATED ARISTOCRAT, I'LL USE MY\NAPPRAISAL SKILL TO RISE IN THE WORLD SEASON 3
Dialogue: 0,0:11:00.58,0:11:03.97,sign,,0000,0000,0000,,MISTERI ENAN
Dialogue: 0,0:12:03.20,0:12:05.70,sign,,0000,0000,0000,,ENAN, 15 TAHUN
Dialogue: 0,0:14:57.33,0:15:00.84,sign,,0000,0000,0000,,KEBENARAN
Dialogue: 0,0:18:57.07,0:18:59.38,sign,,0000,0000,0000,,ENAN LUGEZ
Dialogue: 0,0:20:57.32,0:21:00.32,sign,,0000,0000,0000,,LAMBERG, KEDIAMAN KELUARGA LOUVENT
Dialogue: 0,0:23:37.52,0:23:42.05,sign,,0000,0000,0000,,SELANJUTNYA: DUA ORANG BERBAKAT
Dialogue: 0,0:00:00.82,0:00:04.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemungkinan Buygo disetir seseorang.
Dialogue: 0,0:00:04.46,0:00:07.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin Borotts memancing Buygo
Dialogue: 0,0:00:07.76,0:00:10.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk mengacau di Canarre.
Dialogue: 0,0:00:10.49,0:00:14.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alat sihir penghilang diri itu langka\Ndan sulit didapatkan.
Dialogue: 0,0:00:14.90,0:00:18.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin Borotts mengaturnya\Nagar bisa didapatkan Buygo.
Dialogue: 0,0:00:19.46,0:00:22.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga kepikiran salah satu ucapannya.
Dialogue: 0,0:00:22.85,0:00:27.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seingatku, Borotts bilang\NTuan Muda tidak boleh dibiarkan hidup.
Dialogue: 0,0:00:27.73,0:00:31.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia terang-terangan mau mengirim\Npembunuh bayaran.
Dialogue: 0,0:00:31.43,0:00:34.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, buat apa gembar-gembor segala?
Dialogue: 0,0:00:34.98,0:00:39.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemungkinan musuh tidak peduli\Nketahuan atau tidak.
Dialogue: 0,0:00:39.06,0:00:39.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:00:39.98,0:00:42.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Tuan Ars mengurung diri\Nkarena takut pembunuh,
Dialogue: 0,0:00:42.82,0:00:46.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}SDM tidak akan berkembang\Ndan Canarre akan mandek.
Dialogue: 0,0:00:46.43,0:00:49.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaliknya, kalau merekrut orang\Ntanpa tahu apa-apa,
Dialogue: 0,0:00:49.82,0:00:53.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa saja Tuan Ars dibunuh\Noleh orang kiriman Borotts.
Dialogue: 0,0:00:53.49,0:00:56.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan Tuan Ars aktif\Nkalau bertemu seseorang.
Dialogue: 0,0:00:56.89,0:00:59.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin dia berencana mengakali itu.
Dialogue: 0,0:00:59.58,0:01:03.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatanku memang muncul\Nkalau bertemu orang lain.
Dialogue: 0,0:01:03.95,0:01:08.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, seharusnya aku bisa membedakan\Nmana pembunuh dan mana yang bukan.
Dialogue: 0,0:01:08.72,0:01:11.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mataku mau diuji, boleh saja.
Dialogue: 0,0:01:11.97,0:01:16.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi Tuan Ars harus ekstra waspada.
Dialogue: 0,0:01:16.10,0:01:20.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena pembunuhnya bisa datang kapan saja.
Dialogue: 0,0:01:21.39,0:01:24.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah paham, kan?\NLakukan dengan baik.
Dialogue: 0,0:02:55.78,0:02:57.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok ramai banget?
Dialogue: 0,0:02:57.78,0:03:00.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkali-kali lipat dari sebelumnya!
Dialogue: 0,0:03:00.62,0:03:03.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini berkat prestasi Canarre.
Dialogue: 0,0:03:03.50,0:03:06.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pihak yang menang perang\Npasti lebih sejahtera.
Dialogue: 0,0:03:06.82,0:03:09.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Posisi militer di Canarre sangat diminati.
Dialogue: 0,0:03:09.70,0:03:13.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak Musha bergabung,\Npelamar wanita juga bertambah!
Dialogue: 0,0:03:13.74,0:03:18.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelamar dari provinsi lain juga ada,\NSDM kita akan makin beragam!
Dialogue: 0,0:03:18.26,0:03:21.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul juga, semuanya berkaitan.
Dialogue: 0,0:03:21.55,0:03:25.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau banyak SDM unggulan,\Nkami bisa menang perang.
Dialogue: 0,0:03:25.36,0:03:28.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemenangan itu akan menambah\NSDM unggulan lagi.
Dialogue: 0,0:03:28.48,0:03:32.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan saatnya takut pembunuh\Ndan berhenti bertemu orang!
Dialogue: 0,0:03:32.80,0:03:36.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus terus melaju demi Canarre!
Dialogue: 0,0:03:37.66,0:03:40.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang selanjutnya, silakan.
Dialogue: 0,0:03:47.92,0:03:50.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari 50 orang yang kulihat hari ini,
Dialogue: 0,0:03:50.86,0:03:52.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kebijaksanaannya paling tinggi!
Dialogue: 0,0:03:52.77,0:03:54.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesenjataannya pun S!
Dialogue: 0,0:03:54.91,0:03:57.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terakhir kali yang begini itu Shin!
Dialogue: 0,0:03:57.63,0:03:59.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin dia bisa membantu Shin
Dialogue: 0,0:03:59.93,0:04:01.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mengembangkan kapal terbang!
Dialogue: 0,0:04:01.87,0:04:04.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Latar belakangnya tidak mencurigakan.
Dialogue: 0,0:04:04.85,0:04:08.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daya tempurnya pun terlalu rendah\Nuntuk jadi pembunuh.
Dialogue: 0,0:04:08.14,0:04:10.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata masih ada orang seberbakat ini.
Dialogue: 0,0:04:11.65,0:04:15.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Ars Louvent, Bupati Canarre.
Dialogue: 0,0:04:15.01,0:04:17.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa sebutkan namamu?
Dialogue: 0,0:04:30.40,0:04:32.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, tentu saja.
Dialogue: 0,0:04:38.94,0:04:43.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enan Lugez, kamu datang dari Khmer?
Dialogue: 0,0:04:43.87,0:04:46.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tulisanmu bagus, ya.
Dialogue: 0,0:04:48.73,0:04:50.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa melamar?
Dialogue: 0,0:04:53.39,0:04:56.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Aku ingin bisa membantu"?
Dialogue: 0,0:04:56.00,0:04:57.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:04:58.42,0:05:02.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, silakan langsung bergabung!
Dialogue: 0,0:05:04.49,0:05:05.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini.
Dialogue: 0,0:05:23.20,0:05:26.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia kelihatan agak kebingungan,\Napa tidak jadi masalah?
Dialogue: 0,0:05:26.99,0:05:32.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, tidak ada hal mencurigakan.\NKurasa dia bukan pembunuh.
Dialogue: 0,0:05:32.05,0:05:33.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu dulu.
Dialogue: 0,0:05:33.90,0:05:37.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Firasat wanitaku bilang,\Ndia mencurigakan!
Dialogue: 0,0:05:37.40,0:05:38.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:05:38.57,0:05:44.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul, tulisannya terlalu bagus\Nuntuk orang yang bukan bangsawan.
Dialogue: 0,0:05:44.96,0:05:48.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Ars, bagaimana\Nkalau kita menyelidikinya?
Dialogue: 0,0:05:48.62,0:05:51.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku setuju dengan mereka.
Dialogue: 0,0:05:51.04,0:05:54.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fam, kenapa kamu setuju?
Dialogue: 0,0:05:54.19,0:05:57.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah apa tujuan gadis itu,
Dialogue: 0,0:05:57.34,0:06:00.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi dia mengamati istana\Nsambil mencatat sesuatu.
Dialogue: 0,0:06:00.55,0:06:02.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu?
Dialogue: 0,0:06:02.30,0:06:03.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:06:03.80,0:06:06.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fam, bisa tolong selidiki Enan?
Dialogue: 0,0:06:06.93,0:06:08.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja.
Dialogue: 0,0:06:22.24,0:06:23.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh.
Dialogue: 0,0:06:23.32,0:06:26.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu berhasil mengambil hati Tuan Ars, ya.
Dialogue: 0,0:06:30.83,0:06:33.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enan seorang maid?
Dialogue: 0,0:06:33.33,0:06:38.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, saat kubuntuti, dia masuk\Nke wisma saudagar di Khmer.
Dialogue: 0,0:06:39.23,0:06:42.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya dia maid yang mengabdi di sana.
Dialogue: 0,0:06:42.48,0:06:44.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa dia melamar ke sini?
Dialogue: 0,0:06:44.72,0:06:47.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya gaji di sana besar, kan?
Dialogue: 0,0:06:47.66,0:06:50.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja, biar kucari tahu.
Dialogue: 0,0:06:55.90,0:06:59.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah jadi, Nyonya!\NSemuanya baru matang!
Dialogue: 0,0:06:59.48,0:07:02.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, luar biasa!\NSemuanya kelihatan enak!
Dialogue: 0,0:07:02.99,0:07:07.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rin manis dan menggemaskan,\Naku beruntung merekrutmu.
Dialogue: 0,0:07:08.43,0:07:09.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sementara itu...
Dialogue: 0,0:07:10.43,0:07:13.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak suram itu bikin enek.
Dialogue: 0,0:07:13.52,0:07:15.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo makan bersama.
Dialogue: 0,0:07:15.62,0:07:16.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:07:17.12,0:07:21.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, Nyonya memang selalu keras pada Enan?
Dialogue: 0,0:07:21.63,0:07:23.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul!
Dialogue: 0,0:07:23.38,0:07:29.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bersikap baik ke semua orang,\Ntapi sinis pada Enan.
Dialogue: 0,0:07:29.42,0:07:32.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal Enan maid paling cekatan.
Dialogue: 0,0:07:32.34,0:07:36.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma Enan yang sudah mengabdi\Nsejak era Nyonya Lama.
Dialogue: 0,0:07:37.38,0:07:40.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi wisma ini besar sekali, ya.
Dialogue: 0,0:07:40.59,0:07:41.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, kan?
Dialogue: 0,0:07:41.94,0:07:45.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita keluarga saudagar terbesar di Khmer.
Dialogue: 0,0:07:45.07,0:07:49.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayangnya Tuan Besar jarang ada\Nkarena selalu keliling dunia.
Dialogue: 0,0:07:49.17,0:07:53.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya Lama juga kesohor,\Ntapi beliau meninggal karena sakit.
Dialogue: 0,0:07:53.55,0:07:57.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu digantikan oleh Nyonya yang sekarang.
Dialogue: 0,0:07:58.85,0:08:01.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok Enan tidak bisa bicara?\NPenyakit?
Dialogue: 0,0:08:01.92,0:08:06.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah, tapi kudengar dia bisa bicara\Ndi era Nyonya Lama.
Dialogue: 0,0:08:06.92,0:08:09.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ada yang aneh darinya?
Dialogue: 0,0:08:09.54,0:08:12.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misalnya, seperti rutin ke Provinsi Seitz?
Dialogue: 0,0:08:12.67,0:08:15.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa tidak, sih.
Dialogue: 0,0:08:15.14,0:08:16.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagian dia orang Khmer,
Dialogue: 0,0:08:16.89,0:08:19.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- keluar dari Canarre saja mungkin belum pernah.\N- Enan Lugez.
Dialogue: 0,0:08:19.50,0:08:21.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia terlalu penuh misteri.
Dialogue: 0,0:08:21.90,0:08:24.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya perlu kontak langsung.
Dialogue: 0,0:08:25.71,0:08:29.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Enan dibiarkan sendirian?
Dialogue: 0,0:08:29.07,0:08:32.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Marchioness akan berkunjung lusa.
Dialogue: 0,0:08:32.13,0:08:34.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi harus dibersihkan dari sekarang.
Dialogue: 0,0:08:34.97,0:08:37.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi hari mulai gelap.
Dialogue: 0,0:08:37.29,0:08:39.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau biar kami ikut membant—
Dialogue: 0,0:08:39.25,0:08:40.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo?
Dialogue: 0,0:08:40.16,0:08:42.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku percaya pada kemampuan Enan, kok.
Dialogue: 0,0:08:42.99,0:08:44.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis secekatan kamu pasti bisa, kan?
Dialogue: 0,0:08:46.96,0:08:49.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan ada yang membantunya.
Dialogue: 0,0:08:49.30,0:08:52.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, kita masuk sebelum hujan.
Dialogue: 0,0:09:07.26,0:09:10.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sendiri repot, kan?\NBiar kubantu.
Dialogue: 0,0:09:24.69,0:09:29.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selesai!\NDuh, capek banget!
Dialogue: 0,0:09:29.14,0:09:33.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya ampun, Nyonya mintanya aneh-aneh saja.
Dialogue: 0,0:09:34.30,0:09:36.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Terima kasih"?
Dialogue: 0,0:09:36.50,0:09:38.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, jangan dipikirkan.
Dialogue: 0,0:09:38.91,0:09:42.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melihat Nyonya melongo saja\Naku sudah puas.
Dialogue: 0,0:09:47.78,0:09:50.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ide bagus!
Dialogue: 0,0:09:50.19,0:09:54.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kalau memajang itu,\Nnanti para tamu minggat.
Dialogue: 0,0:09:57.39,0:10:02.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira dia gadis pemurung,\Nternyata tidak.
Dialogue: 0,0:10:02.40,0:10:05.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cara memotong rumputnya saja luwes.
Dialogue: 0,0:10:05.02,0:10:08.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penilaian Ars soal kemampuannya sudah tepat.
Dialogue: 0,0:10:09.20,0:10:12.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk sekarang, aku akan mengamatinya dulu
Dialogue: 0,0:10:42.50,0:10:45.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau apa dia selarut ini?
Dialogue: 0,0:10:47.50,0:10:49.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau ke mana coba?
Dialogue: 0,0:10:53.66,0:10:55.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hilang?
Dialogue: 0,0:11:00.58,0:11:03.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semalam Enan hilang di sini.
Dialogue: 0,0:11:03.97,0:11:05.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok bisa?
Dialogue: 0,0:11:35.84,0:11:39.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ars benar, dia punya kemampuan.
Dialogue: 0,0:11:41.47,0:11:44.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini daftar tanaman beracun!
Dialogue: 0,0:11:45.04,0:11:47.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enan mau meracuni Ars?
Dialogue: 0,0:11:54.19,0:11:55.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buku harian?
Dialogue: 0,0:11:56.16,0:11:57.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}8 Juli.
Dialogue: 0,0:11:57.84,0:12:02.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mulai membuat buku harian\Nuntuk latihan menulis.
Dialogue: 0,0:12:03.20,0:12:05.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihatlah, Nyonya! Sudah jadi!
Dialogue: 0,0:12:05.70,0:12:09.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, Enan!\NItu lebih bagus dari punyaku!
Dialogue: 0,0:12:09.89,0:12:12.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu selalu bisa mempelajari apa pun.
Dialogue: 0,0:12:12.77,0:12:15.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sangat cepat belajar.
Dialogue: 0,0:12:15.70,0:12:20.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak aku mulai jadi abdi di wisma,\NNyonya mengajariku banyak hal.
Dialogue: 0,0:12:20.70,0:12:24.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ingat, rahasiakan ruangan ini\Ndari Tuan Besar.
Dialogue: 0,0:12:24.10,0:12:27.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, cuma kita berdua yang tahu, ya!
Dialogue: 0,0:12:27.10,0:12:28.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Enan.
Dialogue: 0,0:12:29.27,0:12:32.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya kamu pergi dari sini\Nsuatu saat nanti.
Dialogue: 0,0:12:32.42,0:12:34.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Status abdimu akan kubebaskan.
Dialogue: 0,0:12:34.98,0:12:39.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Kenapa?\NAku tidak pandai mengurus rumah?
Dialogue: 0,0:12:39.06,0:12:43.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, mubazir kalau cuma jadi maid.
Dialogue: 0,0:12:43.17,0:12:46.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu cocoknya belajar keahlian\Ndan hidup mandiri.
Dialogue: 0,0:12:46.75,0:12:49.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penghasilanmu akan jauh lebih besar.
Dialogue: 0,0:12:50.05,0:12:54.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, karena kamu terampil,\Nbagaimana kalau jadi perajin?
Dialogue: 0,0:12:55.02,0:12:58.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pasti bisa jadi perajin hebat.
Dialogue: 0,0:13:01.01,0:13:05.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku ingin selalu bersama Nyonya!
Dialogue: 0,0:13:05.47,0:13:09.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duh, ada-ada saja.\NTapi aku senang.
Dialogue: 0,0:13:09.84,0:13:11.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya, kamu bisa menulis?
Dialogue: 0,0:13:12.46,0:13:13.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:13:13.47,0:13:16.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, sini aku ajarkan.
Dialogue: 0,0:13:17.15,0:13:21.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemudian, Nyonya meninggal\Nkarena penyakit misterius.
Dialogue: 0,0:13:23.89,0:13:28.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tulisan Enan bagus\Nkarena diajari Nyonya Lama rupanya.
Dialogue: 0,0:13:37.25,0:13:41.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah jam istirahat, ayo makan siang.
Dialogue: 0,0:13:45.36,0:13:50.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Aku disuruh belanja oleh Nyonya"?
Dialogue: 0,0:13:50.10,0:13:52.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu.
Dialogue: 0,0:13:55.02,0:13:57.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja tidak...
Dialogue: 0,0:13:57.90,0:14:01.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Enan disuruh belanja ke mana?
Dialogue: 0,0:14:01.28,0:14:04.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Tidak ada agenda belanja, kok.
Dialogue: 0,0:14:04.72,0:14:08.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak itu suka hilang kalau siang begini.
Dialogue: 0,0:14:08.58,0:14:10.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya juga.
Dialogue: 0,0:14:10.29,0:14:13.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Entah ke mana perginya...\N- Lain kali akan kubuntuti.
Dialogue: 0,0:14:13.04,0:14:15.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, alkoholnya habis.
Dialogue: 0,0:14:16.42,0:14:19.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, kamu cantik juga.
Dialogue: 0,0:14:19.05,0:14:21.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan itu!
Dialogue: 0,0:14:21.26,0:14:23.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia masih anak baru!
Dialogue: 0,0:14:23.05,0:14:27.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar, masa stok sebanyak itu\Nsudah dihabiskan?
Dialogue: 0,0:14:27.05,0:14:30.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu baik-baik saja, Rin?\NPasti kaget, ya?
Dialogue: 0,0:14:30.31,0:14:33.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa orang-orang seram itu?
Dialogue: 0,0:14:33.20,0:14:36.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengawal yang direkrut Nyonya Baru.
Dialogue: 0,0:14:36.20,0:14:38.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka tinggal di wisma.
Dialogue: 0,0:14:38.67,0:14:41.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang-orang itu nyeleneh.
Dialogue: 0,0:14:41.09,0:14:44.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mabuk-mabukan di siang hari\Ndan berjudi tiap hari.
Dialogue: 0,0:14:44.40,0:14:47.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah kenapa Nyonya merekrut mereka.
Dialogue: 0,0:14:53.26,0:14:57.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, belum ada panggilan\Ndari Istana Canarre?
Dialogue: 0,0:14:58.56,0:15:00.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapan datangnya, sih?
Dialogue: 0,0:15:01.31,0:15:05.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenggorokanmu belum sembuh\Nsetelah kami lukai waktu itu, ya?
Dialogue: 0,0:15:09.15,0:15:12.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah Nyonya Lama mendadak\Nmeninggal karena sakit,
Dialogue: 0,0:15:12.90,0:15:15.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya Baru datang.
Dialogue: 0,0:15:16.08,0:15:19.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mengaku sebagai teman Nyonya Lama
Dialogue: 0,0:15:19.14,0:15:23.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan berbaik hati menghiburku\Ntiap kali aku bersedih.
Dialogue: 0,0:15:23.74,0:15:25.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi pada suatu malam...
Dialogue: 0,0:15:26.11,0:15:28.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memindahkan makamnya sekarang?
Dialogue: 0,0:15:28.99,0:15:34.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Besar memang minta makamnya\Ndipindahkan ke lokasi yang bagus.
Dialogue: 0,0:15:34.35,0:15:37.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya menunggu Tuan Besar\Npulang dulu, kan?
Dialogue: 0,0:15:37.50,0:15:40.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau merepotkan Tuan Besar.
Dialogue: 0,0:15:40.75,0:15:43.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak perlu membantu,\Nsoalnya bahaya.
Dialogue: 0,0:15:47.09,0:15:51.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di badai sekencang ini,\NNyonya pasti kesulitan.
Dialogue: 0,0:15:51.35,0:15:53.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan membantu...
Dialogue: 0,0:15:54.35,0:15:57.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar, pakai racun segala, sih.
Dialogue: 0,0:15:57.73,0:15:59.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teh dari rumput Deo
Dialogue: 0,0:15:59.48,0:16:03.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah cara paling ampuh\Nuntuk membunuhnya.
Dialogue: 0,0:16:03.54,0:16:07.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buktinya tidak ada yang sadar\Ndia mati diracun, kan?
Dialogue: 0,0:16:07.24,0:16:09.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, cepat bersihkan.
Dialogue: 0,0:16:09.55,0:16:13.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat kalau ada yang melihat tulangnya\Nberubah warna akibat racun.
Dialogue: 0,0:16:13.71,0:16:14.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:16:15.31,0:16:16.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata...
Dialogue: 0,0:16:20.78,0:16:22.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya dibunuh?
Dialogue: 0,0:16:22.42,0:16:23.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo? Enan?
Dialogue: 0,0:16:23.92,0:16:28.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke-Kenapa kamu membunuhnya?\NBukankah kalian teman?
Dialogue: 0,0:16:28.67,0:16:31.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, karena dia pengganggu.
Dialogue: 0,0:16:31.52,0:16:33.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau jadi istri saudagar biar makmur.
Dialogue: 0,0:16:33.81,0:16:36.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma karena itu
Dialogue: 0,0:16:36.85,0:16:38.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu membunuh Nyonya?
Dialogue: 0,0:16:39.04,0:16:40.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa diampuni!
Dialogue: 0,0:16:40.73,0:16:43.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita apakan dia?\NBunuh saja?
Dialogue: 0,0:16:43.65,0:16:44.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bodoh!
Dialogue: 0,0:16:44.29,0:16:47.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dua orang mati berdekatan,\Nakan mencurigakan.
Dialogue: 0,0:16:47.25,0:16:52.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, dia disayang Tuan Besar,\Njadi tidak bisa sembarangan dipecat.
Dialogue: 0,0:16:52.59,0:16:54.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:16:54.45,0:16:57.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lukai saja sedikit
Dialogue: 0,0:16:57.63,0:16:59.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}biar dia tutup mulut.
Dialogue: 0,0:17:03.71,0:17:08.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa bicara lagi\Nsetelah tenggorokanku dirusak.
Dialogue: 0,0:17:08.74,0:17:11.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Barang buktinya pun dilenyapkan.
Dialogue: 0,0:17:11.58,0:17:14.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya tidak boleh berakhir begini.
Dialogue: 0,0:17:16.85,0:17:18.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kubongkar
Dialogue: 0,0:17:18.91,0:17:21.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}semua kebusukan ini!
Dialogue: 0,0:17:23.98,0:17:26.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, selanjutnya bagaimana?
Dialogue: 0,0:17:26.70,0:17:30.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akan menjual barang\Nke Canarre lewat dia.
Dialogue: 0,0:17:30.69,0:17:35.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bayaran tinggi dari Bupati\Npasti bikin kita makin kaya.
Dialogue: 0,0:17:35.47,0:17:37.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya memang cerdik.
Dialogue: 0,0:17:38.87,0:17:42.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Aku tidak akan menurut lagi.
Dialogue: 0,0:17:42.27,0:17:45.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kejahatanmu akan kulaporkan ke Tuan Ars.
Dialogue: 0,0:17:45.26,0:17:47.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengakulah sebelum terlambat."
Dialogue: 0,0:17:48.84,0:17:52.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu lupa akibatnya kalau melawanku?
Dialogue: 0,0:17:57.10,0:18:01.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah cukup, tidak kusangka\Nistri saudagar adalah pembunuh.
Dialogue: 0,0:18:01.85,0:18:05.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu si maid...\NTidak, siapa kamu?
Dialogue: 0,0:18:05.11,0:18:08.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti rasanya berat, Enan.\NTapi sudah aman.
Dialogue: 0,0:18:08.53,0:18:10.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kuurus sisanya.
Dialogue: 0,0:18:10.86,0:18:13.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenggorokanmu juga mau dirusak?
Dialogue: 0,0:18:13.57,0:18:14.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aduh!
Dialogue: 0,0:18:14.45,0:18:16.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bibi tidak sabaran, ya.
Dialogue: 0,0:18:16.21,0:18:17.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengawal!
Dialogue: 0,0:18:17.20,0:18:18.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap!
Dialogue: 0,0:18:28.46,0:18:30.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau tahu siapa aku?
Dialogue: 0,0:18:30.17,0:18:31.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Fam.
Dialogue: 0,0:18:31.72,0:18:34.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bawahan Bupati Canarre, Ars Louvent.
Dialogue: 0,0:18:34.94,0:18:37.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekaligus ketua Tentara Bayaran Shadow.
Dialogue: 0,0:18:37.93,0:18:39.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}U-Utusan Canarre?
Dialogue: 0,0:18:39.93,0:18:42.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bisa apa?\NBukti saja tidak punya!
Dialogue: 0,0:18:43.60,0:18:48.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bekas pembakaran alat penggalian makam,\Nkesaksian penjual tanaman beracun,
Dialogue: 0,0:18:48.82,0:18:53.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan daftar kandungan racun yang ada\Ndi tulang Nyonya Lama.
Dialogue: 0,0:18:53.82,0:18:55.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, kan, Enan?
Dialogue: 0,0:18:57.07,0:18:59.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini pasti palsu!
Dialogue: 0,0:18:59.38,0:19:02.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagian, tulangnya sudah kubuang ke sungai!
Dialogue: 0,0:19:05.94,0:19:08.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini tulang mendiang Nyonya Lama.
Dialogue: 0,0:19:18.35,0:19:20.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya...
Dialogue: 0,0:19:21.42,0:19:24.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial, kukira aku sudah main rapi.
Dialogue: 0,0:19:27.23,0:19:30.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan saja hancurkan tenggorokanku.
Dialogue: 0,0:19:30.86,0:19:31.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:19:32.23,0:19:36.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dosamu membunuh Nyonya tercintaku\Ntidak bisa diampuni!
Dialogue: 0,0:19:40.24,0:19:41.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi begitu?
Dialogue: 0,0:19:41.74,0:19:43.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Istri Kedua pun ditangkap.
Dialogue: 0,0:19:43.83,0:19:45.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atas kasus pembunuhan dan penganiayaan,
Dialogue: 0,0:19:45.97,0:19:49.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}komplotan mereka akan dipenjara cukup lama.
Dialogue: 0,0:19:49.38,0:19:53.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi itu alasan Enan terlihat kebingungan.
Dialogue: 0,0:19:53.98,0:19:58.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai pemimpin, aku juga salah\Nkarena tidak menyadarinya.
Dialogue: 0,0:19:58.67,0:20:02.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ada masalah sekecil apa pun,\Nsilakan ceritakan saja.
Dialogue: 0,0:20:02.78,0:20:07.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena tugasku melindungi warga\Ntidak bersalah sepertimu, Enan.
Dialogue: 0,0:20:09.02,0:20:14.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi sayang sekali, kamu datang\Nbukan untuk melamar kerja.
Dialogue: 0,0:20:14.72,0:20:19.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hati-hati di jalan pulang,\Nsemoga harimu menyenangkan.
Dialogue: 0,0:20:20.99,0:20:22.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu yakin, Enan?
Dialogue: 0,0:20:22.78,0:20:25.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau pulang dan jadi maid lagi?
Dialogue: 0,0:20:25.97,0:20:30.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini tempat yang bagus\Nuntuk mengembangkan kemampuanmu.
Dialogue: 0,0:20:30.86,0:20:33.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah itu amanat Nyonya Lama?
Dialogue: 0,0:20:38.82,0:20:43.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bekerja bersama,\Nbisakah kita lebih akrab?
Dialogue: 0,0:20:45.06,0:20:47.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, tentu saja.
Dialogue: 0,0:20:47.48,0:20:50.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ars, Enan mau bekerja di sini.
Dialogue: 0,0:20:50.50,0:20:52.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Serius?
Dialogue: 0,0:20:54.62,0:20:56.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon bimbingannya.
Dialogue: 0,0:20:57.32,0:21:00.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia ada di gudang itu.
Dialogue: 0,0:21:00.32,0:21:02.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, pokoknya santai saja.
Dialogue: 0,0:21:05.79,0:21:08.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu! Awas jatuh!
Dialogue: 0,0:21:08.29,0:21:11.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi-lagi begini.
Dialogue: 0,0:21:16.96,0:21:18.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapal terbangku keren, kan?
Dialogue: 0,0:21:18.94,0:21:22.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bisa terbang,\Nsetengah dari batu sihir...
Dialogue: 0,0:21:22.59,0:21:24.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Kayunya kurang melengkung"?
Dialogue: 0,0:21:24.99,0:21:26.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebelah mana?
Dialogue: 0,0:21:28.16,0:21:32.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujung sayapnya harus lebih miring\Nuntuk mengurangi hambatan udara.
Dialogue: 0,0:21:32.50,0:21:35.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi lengkungannya susah dibuat.
Dialogue: 0,0:21:35.06,0:21:37.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayunya ringan, tapi sulit dibentuk.
Dialogue: 0,0:21:38.26,0:21:39.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya aku bisa.
Dialogue: 0,0:21:39.86,0:21:42.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?\NKamu hebat sekali!
Dialogue: 0,0:21:42.18,0:21:44.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau membantuku, tidak?
Dialogue: 0,0:21:44.32,0:21:46.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memang datang untuk itu.
Dialogue: 0,0:21:46.12,0:21:50.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, kebetulan aku butuh asisten!\NUntung kamu datang!
Dialogue: 0,0:21:51.50,0:21:54.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, namamu Enan?\NMohon bantuannya!
Dialogue: 0,0:23:25.68,0:23:28.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah kamu dapat teman baru, Fam!
Dialogue: 0,0:23:28.80,0:23:29.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:23:29.54,0:23:31.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, apa kamu\Npernah punya teman?
Dialogue: 0,0:23:31.89,0:23:35.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ars, pokoknya gaji kali ini\Nharus 10 kali lipat dari biasanya.
Dialogue: 0,0:23:35.23,0:23:37.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Ampun!
Dialogue: 0,0:23:37.52,0:23:42.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya, "Dua Orang Berbakat".
