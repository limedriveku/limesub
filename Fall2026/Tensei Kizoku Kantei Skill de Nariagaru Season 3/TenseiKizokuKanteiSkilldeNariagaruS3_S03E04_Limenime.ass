Dialogue: 0,0:00:00.00,0:00:04.23,sign,,0000,0000,0000,,BENTENG KHMER
Dialogue: 0,0:00:04.23,0:00:08.99,sign,,0000,0000,0000,,EPISODE 28: AKHIR PERANG
Dialogue: 0,0:01:10.72,0:01:12.18,sign,,0000,0000,0000,,PROVINSI SEITZ, KABUPATEN PLURADE
Dialogue: 0,0:03:49.29,0:03:55.01,sign,,0000,0000,0000,,AS A REINCARNATED ARISTOCRAT, I'LL USE MY\NAPPRAISAL SKILL TO RISE IN THE WORLD SEASON 3
Dialogue: 0,0:03:55.01,0:03:59.01,sign,,0000,0000,0000,,KABUPATEN PLURADE, KOTA KECIL PLURADE
Dialogue: 0,0:04:04.26,0:04:07.81,sign,,0000,0000,0000,,PEJABAT SIPIL PASUKAN SEITZ, KAISAS LOPPERT
Dialogue: 0,0:04:12.86,0:04:16.74,sign,,0000,0000,0000,,TAKTIK FAM
Dialogue: 0,0:05:48.54,0:05:51.54,sign,,0000,0000,0000,,PROVINSI SEITZ, BENTENG PLURADE
Dialogue: 0,0:05:53.29,0:05:57.00,sign,,0000,0000,0000,,KAPTEN PASUKAN LOGISTIK SEITZ, RAKTOR BRANDEL
Dialogue: 0,0:07:50.20,0:07:53.58,sign,,0000,0000,0000,,BERBALIKNYA KEADAAN
Dialogue: 0,0:08:51.47,0:08:53.47,sign,,0000,0000,0000,,BENTENG KHMER
Dialogue: 0,0:10:50.96,0:10:53.22,sign,,0000,0000,0000,,SUNGAI KHMER, PANGKALAN MILITER SEITZ
Dialogue: 0,0:10:54.51,0:10:57.14,sign,,0000,0000,0000,,BOROTTS HEIGAND
Dialogue: 0,0:11:04.21,0:11:08.02,sign,,0000,0000,0000,,AS A REINCARNATED ARISTOCRAT, I'LL USE MY\NAPPRAISAL SKILL TO RISE IN THE WORLD SEASON 3
Dialogue: 0,0:11:08.02,0:11:09.90,sign,,0000,0000,0000,,TEKNOLOGI DAN PERANG
Dialogue: 0,0:14:56.33,0:14:59.34,sign,,0000,0000,0000,,BANJIR BANDANG
Dialogue: 0,0:17:21.44,0:17:24.90,sign,,0000,0000,0000,,DUEL JENDERAL
Dialogue: 0,0:23:37.50,0:23:40.96,sign,,0000,0000,0000,,SELANJUTNYA: AKHIR DARI BASAMARC
Dialogue: 0,0:00:04.82,0:00:08.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski berhasil kabur dari 70.000 prajurit,
Dialogue: 0,0:00:08.99,0:00:15.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pangkalan yang kita bangun\Ndan pasokannya direbut.
Dialogue: 0,0:00:15.02,0:00:17.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Situasinya buruk.
Dialogue: 0,0:00:17.50,0:00:19.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon maaf, Tuan Ars.
Dialogue: 0,0:00:20.13,0:00:23.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa boleh buat kalau musuh\Nberhasil menyeberang.
Dialogue: 0,0:00:23.10,0:00:28.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru terima kasih\Nsudah bertahan sejauh ini!
Dialogue: 0,0:00:28.34,0:00:32.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membawa pulang katalis besar\Ndan cairan sihir saja sudah bagus.
Dialogue: 0,0:00:32.91,0:00:38.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanpa itu, kita pasti kalah karena tidak bisa\Nmemakai sihir Charlotte.
Dialogue: 0,0:00:38.61,0:00:41.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang akan musuh lakukan?
Dialogue: 0,0:00:41.07,0:00:43.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Langsung menyerang kita?
Dialogue: 0,0:00:43.60,0:00:44.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:00:44.86,0:00:47.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena buru-buru menyeberang,
Dialogue: 0,0:00:47.94,0:00:51.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}seharusnya pasokan mereka\Nmasih tertinggal di Seitz.
Dialogue: 0,0:00:51.84,0:00:56.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka tidak akan menyerang\Nsebelum pasokan lengkap.
Dialogue: 0,0:00:56.34,0:00:58.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tinggal tunggu waktu saja.
Dialogue: 0,0:00:58.78,0:01:03.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah menyeberang dan dapat pangkalan,\Nmusuh sangat diunggulkan.
Dialogue: 0,0:01:03.57,0:01:07.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau cairan sihir mereka tiba,\Nkita pasti diserang.
Dialogue: 0,0:01:07.78,0:01:10.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja, Rietz
Dialogue: 0,0:01:12.18,0:01:15.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus mengurangi cairan sihir musuh, ya,
Dialogue: 0,0:01:16.03,0:01:23.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Provinsi Seitz memang miskin batu sihir\Nsampai harus dipasok Basamarc.
Dialogue: 0,0:01:23.42,0:01:26.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu titik vital pasukan mereka.
Dialogue: 0,0:01:26.13,0:01:28.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi musuh kita 70.000 orang!
Dialogue: 0,0:01:28.96,0:01:30.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak akan bisa!
Dialogue: 0,0:01:30.99,0:01:32.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:01:32.90,0:01:35.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak semudah kedengarannya.
Dialogue: 0,0:01:35.20,0:01:38.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada dua cara untuk mengikis\Ncairan sihir musuh.
Dialogue: 0,0:01:38.94,0:01:41.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama, menyerang pengirimannya.
Dialogue: 0,0:01:41.41,0:01:46.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, melawan prajurit sebanyak itu\Nakan sulit buat kita.
Dialogue: 0,0:01:46.66,0:01:49.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kedua, merusak gudang pasokannya.
Dialogue: 0,0:01:49.31,0:01:53.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi gudangnya tidak hanya satu\Ndan dijaga ketat.
Dialogue: 0,0:01:53.57,0:01:56.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan sulit merusak semuanya.
Dialogue: 0,0:01:56.05,0:01:59.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten, kurasa misi kali ini mustahil.
Dialogue: 0,0:01:59.76,0:02:01.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo tolak saja.
Dialogue: 0,0:02:02.13,0:02:05.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bukan lagi tentara bayaran independen.
Dialogue: 0,0:02:05.44,0:02:07.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perintah Ars itu mutlak.
Dialogue: 0,0:02:07.81,0:02:12.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia minta begitu karena yakin kita bisa.
Dialogue: 0,0:02:12.96,0:02:15.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo penuhi harapan tuan kita.
Dialogue: 0,0:02:17.12,0:02:20.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah berubah, ya, Kapten.
Dialogue: 0,0:02:20.56,0:02:21.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh.
Dialogue: 0,0:02:21.97,0:02:24.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku punya ide bagus.
Dialogue: 0,0:04:04.26,0:04:07.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapan santainya kalau perang melulu?
Dialogue: 0,0:04:07.81,0:04:10.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Andai di sini ada gadis muda...
Dialogue: 0,0:04:27.34,0:04:29.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh aku duduk di sini?
Dialogue: 0,0:04:29.17,0:04:32.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya, silakan!
Dialogue: 0,0:04:35.07,0:04:37.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu cantik sekali.
Dialogue: 0,0:04:37.60,0:04:42.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baru kali ini aku melihat\Nwajah secantik kamu.
Dialogue: 0,0:04:42.02,0:04:44.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, benarkah?
Dialogue: 0,0:04:45.65,0:04:49.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamarku ada di atas,\Nmau minum berdua?
Dialogue: 0,0:04:56.11,0:05:00.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waduh, hoki banget bisa minum-minum
Dialogue: 0,0:05:00.66,0:05:03.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bareng gadis secantik kamu.
Dialogue: 0,0:05:04.00,0:05:07.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mengajakku untuk ini, kan?
Dialogue: 0,0:05:09.34,0:05:11.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini apa?
Dialogue: 0,0:05:13.54,0:05:15.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok berbatang?
Dialogue: 0,0:05:18.34,0:05:20.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si-Siapa kamu?
Dialogue: 0,0:05:20.18,0:05:23.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten, aku sudah dapat data pribadinya.
Dialogue: 0,0:05:23.93,0:05:27.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan ini?\NSiapa kalian...
Dialogue: 0,0:05:31.02,0:05:33.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan meraba seenaknya!
Dialogue: 0,0:05:37.50,0:05:41.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luar biasa, ide Kapten sungguh nekat.
Dialogue: 0,0:05:41.86,0:05:44.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja.
Dialogue: 0,0:05:44.14,0:05:47.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sisanya adalah tugasmu.\NTolong, ya.
Dialogue: 0,0:05:47.18,0:05:48.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap!
Dialogue: 0,0:05:53.29,0:05:57.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk apa membuat pos logistik di bawah tanah?
Dialogue: 0,0:05:57.44,0:06:00.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agar pasokan aman dari incaran musuh.
Dialogue: 0,0:06:01.01,0:06:07.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentara bayaran bernama Shadow\Nsedang mengintai pasokan kita.
Dialogue: 0,0:06:07.46,0:06:11.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentara bayaran?\NTapi gudang pasokan kita dijaga ketat.
Dialogue: 0,0:06:11.95,0:06:14.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penjaganya juga baru ditambah.
Dialogue: 0,0:06:14.00,0:06:17.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lokasinya ketahuan pun\Nmustahil bisa dicuri, kan?
Dialogue: 0,0:06:17.06,0:06:20.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shadow itu pengguna sihir bayangan.
Dialogue: 0,0:06:20.28,0:06:24.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau diserang dadakan,\Ngudang kita tidak satu pun aman.
Dialogue: 0,0:06:24.90,0:06:27.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perlu segera diakali.
Dialogue: 0,0:06:27.81,0:06:33.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makin besar ukuran gudang,\Nbiasanya makin mudah diserang.
Dialogue: 0,0:06:34.19,0:06:38.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kalau di bawah tanah,\Nakan lebih sulit ditemukan.
Dialogue: 0,0:06:38.54,0:06:44.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Punya banyak gudang yang terhubung\Nakan menambah efisiensi.
Dialogue: 0,0:06:45.53,0:06:50.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi mengirim pasokan ke Missian\Nadalah prioritas kita.
Dialogue: 0,0:06:50.26,0:06:51.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salah.
Dialogue: 0,0:06:51.56,0:06:54.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru saat ini kita harus waspada.
Dialogue: 0,0:06:54.77,0:06:58.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Percuma kalau terburu-buru\Ndan malah diserang dadakan.
Dialogue: 0,0:06:58.67,0:07:00.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah banyak prajurit yang menyeberang.
Dialogue: 0,0:07:00.98,0:07:03.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu dan personel kita tidak cukup.
Dialogue: 0,0:07:04.26,0:07:07.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Solusinya adalah sihir tanah.
Dialogue: 0,0:07:07.07,0:07:08.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir tanah?
Dialogue: 0,0:07:08.98,0:07:15.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masuk akal, kita bisa membuat rubanah\Ndalam waktu singkat dengan itu.
Dialogue: 0,0:07:15.30,0:07:18.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi itu butuh cairan sihir.
Dialogue: 0,0:07:18.77,0:07:20.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Raktor.
Dialogue: 0,0:07:22.37,0:07:27.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agar pasukan logistik seperti kita\Nbisa menyamai prestasi pasukan garis depan,
Dialogue: 0,0:07:27.55,0:07:30.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}perlu ide yang inovatif.
Dialogue: 0,0:07:32.20,0:07:34.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, mari lakukan.
Dialogue: 0,0:07:35.10,0:07:37.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu dapat bonus kalau ini berhasil.
Dialogue: 0,0:07:37.78,0:07:38.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap!
Dialogue: 0,0:07:38.58,0:07:40.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:07:54.66,0:07:58.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para prajurit!\NSemua berjalan lancar!
Dialogue: 0,0:07:58.83,0:08:01.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berikutnya coba gali ke sisi Timur.
Dialogue: 0,0:08:03.84,0:08:07.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gudang bawah tanah selesai dibangun.
Dialogue: 0,0:08:07.09,0:08:10.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Musuh pasti kesulitan menemukannya.
Dialogue: 0,0:08:10.46,0:08:12.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus.
Dialogue: 0,0:08:12.06,0:08:16.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama logistik berjalan lancar,\Nkita tidak akan kalah.
Dialogue: 0,0:08:16.83,0:08:19.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada salahnya ekstra waspada.
Dialogue: 0,0:08:33.54,0:08:35.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah beres, ya.
Dialogue: 0,0:08:35.05,0:08:38.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, ayo selesaikan pekerjaan kita.
Dialogue: 0,0:08:38.30,0:08:39.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:08:45.55,0:08:48.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Angkut semua cairan sihirnya.
Dialogue: 0,0:08:48.19,0:08:50.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bakar yang tidak bisa diangkut!
Dialogue: 0,0:08:50.22,0:08:51.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:08:52.66,0:08:54.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ca...
Dialogue: 0,0:08:54.47,0:08:57.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cairan sihirnya banyak banget!
Dialogue: 0,0:08:57.98,0:09:01.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Wah, luar biasa!\N- Kudengar Shadow mencurinya dari Seitz.
Dialogue: 0,0:09:01.12,0:09:02.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mencurinya?
Dialogue: 0,0:09:02.72,0:09:04.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duh, capek banget.
Dialogue: 0,0:09:07.81,0:09:09.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fam!
Dialogue: 0,0:09:09.15,0:09:12.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menyamar jadi pedagang\Nuntuk menyelundupkannya, lo.
Dialogue: 0,0:09:12.62,0:09:15.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kok bisa?
Dialogue: 0,0:09:15.12,0:09:17.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami membuat jalur baru
Dialogue: 0,0:09:17.76,0:09:21.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk masuk ke gudang bawah tanah mereka.
Dialogue: 0,0:09:22.05,0:09:24.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi cairan sihirnya bisa kami curi semua.
Dialogue: 0,0:09:25.42,0:09:29.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski penjagaan Raktor ketat,\Npemikirannya luwes.
Dialogue: 0,0:09:30.40,0:09:33.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ambisinya buat naik jabatan\Nmalah jadi bumerang, deh.
Dialogue: 0,0:09:35.55,0:09:38.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasokan sebanyak itu mending buat kita.
Dialogue: 0,0:09:38.93,0:09:43.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan hanya mengurangi tapi mencurinya,\Nkamu genius, ya?
Dialogue: 0,0:09:43.44,0:09:44.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitulah.
Dialogue: 0,0:09:45.82,0:09:50.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, aku cuma menyuruh\Ntanpa tahu betapa sulitnya itu.
Dialogue: 0,0:09:50.38,0:09:54.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan kamu jadi harus\Nmemikirkan semuanya dari nol.
Dialogue: 0,0:09:54.50,0:09:55.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bicara apa kamu?
Dialogue: 0,0:09:56.85,0:10:01.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hal yang mustahil bagi kalian\Nadalah tugas kami.
Dialogue: 0,0:10:01.07,0:10:03.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sungkan.
Dialogue: 0,0:10:03.07,0:10:05.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua permintaanmu akan kukabulkan.
Dialogue: 0,0:10:05.46,0:10:08.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fam, terima kasih banyak!
Dialogue: 0,0:10:09.41,0:10:15.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, hasil kerja sebesar ini\Nupahnya pun pasti besar, dong?
Dialogue: 0,0:10:15.36,0:10:17.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak yang sudah andil pula.
Dialogue: 0,0:10:17.81,0:10:22.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pa-Pasti, kok!\NBiar kami pertimbangkan nominalnya!
Dialogue: 0,0:10:23.17,0:10:26.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan ini, situasi berbalik, kan?
Dialogue: 0,0:10:26.56,0:10:31.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya mereka sedang panik\Nkarena kecurian cairan sihir.
Dialogue: 0,0:10:31.76,0:10:35.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasukan logistik pasti lumpuh sementara.
Dialogue: 0,0:10:35.33,0:10:40.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi musuh bisa menyeberang\Nlewat jalur yang tidak kita ketahui, lo.
Dialogue: 0,0:10:41.39,0:10:46.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak lama lagi, mereka pasti\Nmenyusun sistem logistik baru.
Dialogue: 0,0:10:46.71,0:10:50.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mau menghantam Seitz, ini saatnya!
Dialogue: 0,0:10:54.51,0:10:57.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pangkalan musuh bagus juga.
Dialogue: 0,0:10:57.14,0:10:59.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka pakai sihir tanah.
Dialogue: 0,0:10:59.46,0:11:01.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Borotts.
Dialogue: 0,0:11:01.58,0:11:04.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Raktor dan Tuan Kaisas datang.
Dialogue: 0,0:11:08.02,0:11:09.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diserang mendadak?
Dialogue: 0,0:11:09.90,0:11:12.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasokan di bawah tanah telah dicuri.
Dialogue: 0,0:11:18.45,0:11:19.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:11:19.66,0:11:23.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Borotts, ada serangan sihir!
Dialogue: 0,0:11:27.63,0:11:30.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cairan sihir di gudang lain masih ada?
Dialogue: 0,0:11:31.33,0:11:33.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya hilang.
Dialogue: 0,0:11:33.41,0:11:37.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti semua pasokan kita\Ndi benteng ini, ya.
Dialogue: 0,0:11:39.90,0:11:41.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Musuhnya berapa?
Dialogue: 0,0:11:41.01,0:11:42.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Musuhnya tidak ada.
Dialogue: 0,0:11:42.98,0:11:44.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:11:50.56,0:11:52.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka ada di balik bukit.
Dialogue: 0,0:11:52.94,0:11:57.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?\NSeharusnya mereka tidak bisa melihat!
Dialogue: 0,0:11:57.76,0:12:00.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa bidikannya setepat ini?
Dialogue: 0,0:12:05.79,0:12:11.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak kusangka mesin terbang sekecil itu\Nbisa membuat kita unggul.
Dialogue: 0,0:12:11.49,0:12:14.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taktik ini idenya Ars.
Dialogue: 0,0:12:14.11,0:12:17.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku saja kaget saat dipanggil\Nke medan perang.
Dialogue: 0,0:12:18.19,0:12:20.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Shin.
Dialogue: 0,0:12:23.46,0:12:28.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir suara ditembak ke permukaan tanah\Nvia katalis di mesin terbang.
Dialogue: 0,0:12:29.00,0:12:32.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suara akan memantul kalau kena sesuatu.
Dialogue: 0,0:12:32.83,0:12:36.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat pantulan suaranya sampai\Ndi alat konversiku,
Dialogue: 0,0:12:36.40,0:12:38.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita bisa tahu ketinggian tempat itu.
Dialogue: 0,0:12:38.85,0:12:42.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau reaksinya kuat, musuh ada di situ.
Dialogue: 0,0:12:44.53,0:12:45.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bereaksi!
Dialogue: 0,0:12:45.95,0:12:50.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, tinggal ukur sudut dan titik\Ndari arah yang terdeteksi
Dialogue: 0,0:12:50.75,0:12:52.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk menentukan sasaran.
Dialogue: 0,0:12:52.71,0:12:56.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Forma igni erupt!
Dialogue: 0,0:13:12.08,0:13:13.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tepat sasaran!
Dialogue: 0,0:13:14.22,0:13:17.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, bawa cairan sihirnya lagi!
Dialogue: 0,0:13:18.35,0:13:21.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukit akan menutupi lokasi ini,
Dialogue: 0,0:13:21.31,0:13:26.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan dengan jangkauan yang meluas,\Njangkauan artileri kita makin jauh.
Dialogue: 0,0:13:26.41,0:13:29.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inilah militer udara.
Dialogue: 0,0:13:29.58,0:13:32.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teknologi yang melampaui logika.
Dialogue: 0,0:13:32.17,0:13:34.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebuah revolusi perang!
Dialogue: 0,0:13:41.55,0:13:46.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rantolk, kita cuma akan boros cairan sihir.
Dialogue: 0,0:13:46.05,0:13:49.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo tinggalkan pangkalan ini\Ndan mundur ke Seitz.
Dialogue: 0,0:13:50.18,0:13:51.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:13:51.07,0:13:55.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat, buang senjata dan pasokan,\Nbawa alat secukupnya saja.
Dialogue: 0,0:13:55.52,0:13:56.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serius?
Dialogue: 0,0:13:56.73,0:13:58.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal pangkalan ini baru kita rebut!
Dialogue: 0,0:13:58.94,0:14:02.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aman, lagi pula kita cuma mundur sementara.
Dialogue: 0,0:14:03.44,0:14:06.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tinggal rebut lagi saja nanti.
Dialogue: 0,0:14:06.20,0:14:10.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, kalau begitu\Nsilakan menyeberang duluan.
Dialogue: 0,0:14:10.78,0:14:13.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar aku yang jaga lini belakang.
Dialogue: 0,0:14:16.70,0:14:17.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Borotts?
Dialogue: 0,0:14:19.82,0:14:23.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bertahun-tahun aku mengikuti Paduka Glenda.
Dialogue: 0,0:14:23.12,0:14:26.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan Paduka berhasil jadi gubernur,
Dialogue: 0,0:14:26.34,0:14:30.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berkat andil dari diriku, tapi...
Dialogue: 0,0:14:30.77,0:14:36.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin menaklukkan Canarre\Ndan mendapatkan Ars Louvent!
Dialogue: 0,0:14:40.43,0:14:42.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan sisanya padaku!
Dialogue: 0,0:14:45.01,0:14:46.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:14:50.35,0:14:52.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar aku saja
Dialogue: 0,0:14:52.66,0:14:55.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang menghadang pergerakan musuh.
Dialogue: 0,0:14:57.76,0:14:59.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Ars!
Dialogue: 0,0:14:59.92,0:15:03.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Musuh mulai menyeberangi sungai\Nuntuk kembali Seitz.
Dialogue: 0,0:15:05.10,0:15:07.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Respons mereka cepat juga.
Dialogue: 0,0:15:07.55,0:15:11.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keputusan yang masuk akal memang mundur.
Dialogue: 0,0:15:11.38,0:15:15.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku salut mereka secepat ini\Nmeninggalkan pangkalan.
Dialogue: 0,0:15:15.77,0:15:18.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka tahu kalau perangnya panjang,
Dialogue: 0,0:15:18.59,0:15:23.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita yang akan rugi karena harus\Nmengurus Basamarc juga.
Dialogue: 0,0:15:23.58,0:15:27.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu yakin, Nak?\NMusuh kita berat, lo.
Dialogue: 0,0:15:27.15,0:15:27.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:15:28.19,0:15:31.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkat kalian, rencanaku lancar.
Dialogue: 0,0:15:33.50,0:15:35.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana situasinya?
Dialogue: 0,0:15:35.84,0:15:41.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Termasuk pos di sekitar, 30.000 sudah di Seitz\Ndan 10.000 masih menyeberang.
Dialogue: 0,0:15:41.34,0:15:44.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sisa 25.000-nya masih menunggu.
Dialogue: 0,0:15:44.21,0:15:48.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapkan sisa 25.000-nya\Nuntuk menyeberang juga.
Dialogue: 0,0:15:48.26,0:15:49.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap!
Dialogue: 0,0:15:50.85,0:15:54.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian juga segeralah ke Seitz.
Dialogue: 0,0:15:54.03,0:15:59.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampaikan kondisi Benteng Plurade\Nagar yang di sana bersiaga.
Dialogue: 0,0:15:59.65,0:16:00.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap!
Dialogue: 0,0:16:00.91,0:16:02.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga berhasil!
Dialogue: 0,0:16:03.70,0:16:07.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, kalian kemari naik kuda?
Dialogue: 0,0:16:08.08,0:16:08.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:16:08.86,0:16:10.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, betul.
Dialogue: 0,0:16:11.25,0:16:16.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu pertama menyeberang,\Nairnya merendam lutut meski naik kuda.
Dialogue: 0,0:16:17.46,0:16:20.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa surutnya sejauh itu?
Dialogue: 0,0:16:20.59,0:16:21.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan...
Dialogue: 0,0:16:24.71,0:16:26.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Forma
Dialogue: 0,0:16:27.58,0:16:30.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}terra fragilis!
Dialogue: 0,0:16:34.02,0:16:35.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:16:37.54,0:16:39.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banjir bandang!
Dialogue: 0,0:16:47.15,0:16:51.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membuat sebagian besar musuh mundur,\Nlalu membanjiri sungai
Dialogue: 0,0:16:51.82,0:16:54.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk memutus mereka dari pasukan utama.
Dialogue: 0,0:16:54.19,0:16:56.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be-Berhasil!
Dialogue: 0,0:16:56.33,0:17:00.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}20.000 prajurit di pangkalan,\Nmau tidak mau maju.
Dialogue: 0,0:17:02.34,0:17:05.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan kita tinggal menghantam\Npasukan yang tertinggal.
Dialogue: 0,0:17:05.96,0:17:09.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan begitu, Canarre akan menang.
Dialogue: 0,0:17:09.83,0:17:13.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama ini kita beradu strategi.
Dialogue: 0,0:17:13.94,0:17:14.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi,
Dialogue: 0,0:17:14.97,0:17:19.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita tutup pakai adu otot,\Ndengan bentrokan langsung!
Dialogue: 0,0:17:31.71,0:17:34.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski musuh, strateginya luar biasa.
Dialogue: 0,0:17:34.56,0:17:36.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan yang lebih mengerikan
Dialogue: 0,0:17:36.69,0:17:39.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah jenderal yang bisa\Nmewujudkan semua itu!
Dialogue: 0,0:17:39.83,0:17:42.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ars Louvent!
Dialogue: 0,0:17:42.74,0:17:45.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya, ini perang penentu!
Dialogue: 0,0:17:45.20,0:17:47.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penggal jenderal musuh!
Dialogue: 0,0:17:48.16,0:17:49.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maju!
Dialogue: 0,0:18:02.27,0:18:04.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi tanah air Canarre!
Dialogue: 0,0:18:08.85,0:18:10.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Borotts, kalau begini terus...
Dialogue: 0,0:18:15.22,0:18:18.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasukan cadangan, ikuti aku!
Dialogue: 0,0:18:19.49,0:18:22.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Rietz!\NMusuh datang menerjang!
Dialogue: 0,0:18:23.90,0:18:26.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan sekuat tenaga!
Dialogue: 0,0:18:29.42,0:18:30.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak akan kubiarkan.
Dialogue: 0,0:18:31.31,0:18:32.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Ars!
Dialogue: 0,0:18:33.43,0:18:36.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata anak itu?
Dialogue: 0,0:18:36.96,0:18:39.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ars Louvent!
Dialogue: 0,0:18:39.39,0:18:42.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berikan kepalamu!
Dialogue: 0,0:18:58.99,0:19:00.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Ars!
Dialogue: 0,0:19:02.08,0:19:04.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Panggil regu medis! Cepat!
Dialogue: 0,0:19:05.34,0:19:07.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Borotts terkapar!
Dialogue: 0,0:19:14.54,0:19:16.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serangan gagal!
Dialogue: 0,0:19:16.22,0:19:17.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kabur!
Dialogue: 0,0:19:17.34,0:19:18.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mundur!
Dialogue: 0,0:19:18.32,0:19:22.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum, aku harus memenggalnya!
Dialogue: 0,0:19:25.35,0:19:27.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Borotts!
Dialogue: 0,0:19:27.62,0:19:30.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil dilanjutkan, ayo mundur!
Dialogue: 0,0:19:31.90,0:19:33.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Borotts!
Dialogue: 0,0:19:35.54,0:19:36.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Ars!
Dialogue: 0,0:19:36.40,0:19:38.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jenderal musuh kabur!
Dialogue: 0,0:19:38.26,0:19:39.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Braham, kejar dia!
Dialogue: 0,0:19:39.79,0:19:40.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:19:40.90,0:19:42.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana regu medisnya?
Dialogue: 0,0:19:42.90,0:19:44.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rietz...
Dialogue: 0,0:19:44.18,0:19:47.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Ars, jangan bergerak!\NLukamu...
Dialogue: 0,0:19:47.84,0:19:50.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baik-baik saja.
Dialogue: 0,0:19:52.96,0:19:54.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu...
Dialogue: 0,0:20:01.47,0:20:06.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan ini, perang berat sebelah\N80.000 melawan 28.000 prajurit
Dialogue: 0,0:20:06.61,0:20:08.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}telah berakhir.
Dialogue: 0,0:20:08.90,0:20:12.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkat kekompakan dan kekuatan mereka,
Dialogue: 0,0:20:12.05,0:20:14.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasukan Canarre milik Ars menang.
Dialogue: 0,0:20:14.69,0:20:17.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Musha, kerja bagus!
Dialogue: 0,0:20:17.76,0:20:20.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak kusangka kita bisa menang!
Dialogue: 0,0:20:21.70,0:20:26.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada luka serius,\NAnda bisa bergerak seperti biasa.
Dialogue: 0,0:20:26.62,0:20:28.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:20:29.62,0:20:31.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah.
Dialogue: 0,0:20:32.13,0:20:36.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kehilangan Tuan Ars,\Nentah aku harus bilang apa ke Nona Lycia.
Dialogue: 0,0:20:37.53,0:20:41.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Janji ke mendiang Tuan Raven akan gugur.
Dialogue: 0,0:20:42.54,0:20:44.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, aku juga...
Dialogue: 0,0:20:44.72,0:20:48.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rietz, maaf membuatmu khawatir.
Dialogue: 0,0:20:50.26,0:20:53.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku percaya
Dialogue: 0,0:20:54.02,0:20:57.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}benda pemberianmu ini akan melindungiku.
Dialogue: 0,0:21:12.00,0:21:15.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasukan sihir berkekuatan dahsyat!
Dialogue: 0,0:21:15.25,0:21:18.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serangan-serangan di luar nalar!
Dialogue: 0,0:21:19.30,0:21:20.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasukan unggulan!
Dialogue: 0,0:21:21.14,0:21:25.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan juga, strategi yang mengolah\Nsemua aspek itu!
Dialogue: 0,0:21:26.11,0:21:29.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gubernur hanya fokus pada Ars Louvent!
Dialogue: 0,0:21:29.90,0:21:35.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, dia tidak sendiri!\NBawahannya juga tidak normal!
Dialogue: 0,0:21:36.29,0:21:40.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tidak boleh dibiarkan hidup!\NAkan berbahaya bagi Gubernur!
Dialogue: 0,0:21:40.98,0:21:44.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan!\NBahkan bagi provinsi Seitz!
Dialogue: 0,0:21:44.21,0:21:46.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan suatu saat...
Dialogue: 0,0:21:46.91,0:21:49.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pasti akan menjadi
Dialogue: 0,0:21:49.54,0:21:54.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pria paling berpengaruh di seluruh benua!
Dialogue: 0,0:23:25.97,0:23:29.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perang selesai, ayo kita liburan.
Dialogue: 0,0:23:29.81,0:23:31.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Santai sekali bicaramu.
Dialogue: 0,0:23:31.55,0:23:33.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Liburan?\NBoleh juga!
Dialogue: 0,0:23:33.42,0:23:35.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setuju, penyegaran itu penting!
Dialogue: 0,0:23:35.73,0:23:37.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si kocak...
Dialogue: 0,0:23:37.50,0:23:40.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya, "Akhir dari Basamarc".
