Dialogue: 0,0:00:00.00,0:00:03.96,sign,,0000,0000,0000,,EPISODE 32: HAL YANG SEORANG RAJA BUTUHKAN
Dialogue: 0,0:00:29.13,0:00:32.65,sign,,0000,0000,0000,,SERANGAN BALIK DIMULAI
Dialogue: 0,0:03:30.27,0:03:35.99,sign,,0000,0000,0000,,AS A REINCARNATED ARISTOCRAT, I'LL USE MY\NAPPRAISAL SKILL TO RISE IN THE WORLD SEASON 3
Dialogue: 0,0:03:36.65,0:03:40.16,sign,,0000,0000,0000,,BEBERAPA JAM SEBELUMNYA
Dialogue: 0,0:06:34.46,0:06:38.17,sign,,0000,0000,0000,,KEMAMPUAN KELUARGA FUJIMIYA
Dialogue: 0,0:09:31.30,0:09:32.99,sign,,0000,0000,0000,,KABUR
Dialogue: 0,0:12:43.37,0:12:50.37,sign,,0000,0000,0000,,AS A REINCARNATED ARISTOCRAT, I'LL USE MY\NAPPRAISAL SKILL TO RISE IN THE WORLD SEASON 3
Dialogue: 0,0:17:43.29,0:17:46.30,sign,,0000,0000,0000,,ISTANA CANARRE
Dialogue: 0,0:17:48.80,0:17:49.50,sign,,0000,0000,0000,,KELANJUTAN NASIB KELUARGA FUJIMIYA
Dialogue: 0,0:23:37.50,0:23:44.03,sign,,0000,0000,0000,,SELANJUTNYA: ASA YANG TERPENDAM
Dialogue: 0,0:00:03.96,0:00:05.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa jadi pemimpin,
Dialogue: 0,0:00:06.68,0:00:09.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena kepercayaan orang lain!
Dialogue: 0,0:00:09.49,0:00:10.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu,
Dialogue: 0,0:00:11.27,0:00:13.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jangan sentuh bawahanku!
Dialogue: 0,0:00:16.87,0:00:19.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kepercayaan orang lain...
Dialogue: 0,0:00:27.20,0:00:29.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Buygo, ini gawat!
Dialogue: 0,0:00:29.13,0:00:32.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kalian masuk seenaknya?
Dialogue: 0,0:00:36.40,0:00:38.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awasi dulu mereka.
Dialogue: 0,0:00:39.14,0:00:40.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:00:43.35,0:00:44.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku segera kembali.
Dialogue: 0,0:01:00.01,0:01:01.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rietz...
Dialogue: 0,0:01:03.28,0:01:04.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Ars!
Dialogue: 0,0:01:09.28,0:01:11.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lukanya parah sekali.
Dialogue: 0,0:01:11.65,0:01:13.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baik-baik saja.
Dialogue: 0,0:01:13.87,0:01:15.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa Tuan melindungiku?
Dialogue: 0,0:01:17.33,0:01:21.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita butuh kekuatanmu agar bisa kabur.
Dialogue: 0,0:01:22.22,0:01:27.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, aku benar-benar\Nmenganggapmu berharga.
Dialogue: 0,0:01:28.14,0:01:29.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untung kamu baik-baik saja.
Dialogue: 0,0:01:31.89,0:01:33.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Ars...
Dialogue: 0,0:01:41.47,0:01:43.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terjadi sesuatu di luar.
Dialogue: 0,0:01:43.82,0:01:45.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini kesempatan emas.
Dialogue: 0,0:01:48.82,0:01:53.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo selamatkan Maika dan Takao,\Nlalu kabur dari sini!
Dialogue: 0,0:03:42.62,0:03:44.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak Baru, ada apa?
Dialogue: 0,0:03:44.58,0:03:46.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, bukan apa-apa.
Dialogue: 0,0:03:50.21,0:03:52.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini rencananya.
Dialogue: 0,0:03:52.50,0:03:57.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah menyusup,\Npasang peledak ini di banyak tempat.
Dialogue: 0,0:03:58.11,0:04:03.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Ars sudah kamu amankan,\Nberi kami kode dengan meledakkan semuanya.
Dialogue: 0,0:04:04.02,0:04:06.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Isyarat yang mencolok, ya.
Dialogue: 0,0:04:06.48,0:04:13.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat kami datang merusuh,\Nkaburlah bersama Ars.
Dialogue: 0,0:04:13.66,0:04:16.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ingat baik-baik denah istananya.
Dialogue: 0,0:04:20.93,0:04:23.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, penjaranya di bawah tanah?
Dialogue: 0,0:04:23.49,0:04:27.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya...\NKok kamu tahu, sih?
Dialogue: 0,0:04:29.39,0:04:30.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana dia?
Dialogue: 0,0:04:33.00,0:04:34.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Ars!
Dialogue: 0,0:04:38.72,0:04:41.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa kalian?\NTuan Ars di mana?
Dialogue: 0,0:04:41.89,0:04:45.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan, kamu bantuan\Nyang Tuan Ars bilang?
Dialogue: 0,0:04:46.10,0:04:47.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kenal Tuan Ars?
Dialogue: 0,0:04:47.74,0:04:53.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, Bos musuh membawanya\Nbersama Rietz dan kakak kami!
Dialogue: 0,0:04:53.15,0:04:55.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, biar aku cari.
Dialogue: 0,0:04:55.19,0:04:58.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, izinkan kami ikut!
Dialogue: 0,0:04:59.63,0:05:04.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa, aku akan ketahuan\Nkalau membawa dua tahanan.
Dialogue: 0,0:05:04.91,0:05:06.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon.
Dialogue: 0,0:05:07.44,0:05:11.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakanda satu-satunya keluarga kami.
Dialogue: 0,0:05:19.82,0:05:21.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya sudah.
Dialogue: 0,0:05:21.28,0:05:24.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula pria di sampingmu terlihat kuat.
Dialogue: 0,0:05:25.33,0:05:26.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari bekerja sama.
Dialogue: 0,0:05:38.73,0:05:41.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya mereka ada di ruangan bos.
Dialogue: 0,0:05:41.15,0:05:43.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bos musuh?\NDi menara itu, ya?
Dialogue: 0,0:05:48.34,0:05:49.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah.
Dialogue: 0,0:05:51.28,0:05:53.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang kabur! Kejar!
Dialogue: 0,0:05:57.14,0:05:59.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takao, lompat ke atap!
Dialogue: 0,0:06:05.20,0:06:07.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka lari ke atap!
Dialogue: 0,0:06:07.66,0:06:10.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tangkap, woi!\NTangkap!
Dialogue: 0,0:06:10.34,0:06:11.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takao, lompat!
Dialogue: 0,0:06:22.15,0:06:24.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma tiga orang! Sikat!
Dialogue: 0,0:06:41.42,0:06:44.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak saja mau kabur.
Dialogue: 0,0:06:46.46,0:06:48.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami kalah jumlah.
Dialogue: 0,0:06:48.80,0:06:49.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takao.
Dialogue: 0,0:06:51.20,0:06:53.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunjukkan kekuatan Keluarga Fujimiya!
Dialogue: 0,0:06:53.66,0:06:54.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:07:11.63,0:07:12.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gila!
Dialogue: 0,0:07:12.78,0:07:14.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekali pukul?
Dialogue: 0,0:07:14.16,0:07:18.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu boleh juga,\Ncocok jadi pasukan kami.
Dialogue: 0,0:07:20.16,0:07:23.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka monster!
Dialogue: 0,0:07:29.62,0:07:32.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau bertemu sanderanya?
Dialogue: 0,0:07:33.41,0:07:37.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kalian aku siksa dulu, ya!
Dialogue: 0,0:07:37.56,0:07:38.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada Tuan Buygo!
Dialogue: 0,0:07:38.86,0:07:40.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si Bos datang!
Dialogue: 0,0:07:47.73,0:07:50.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat sekali!\NTenaganya pun dahsyat!
Dialogue: 0,0:07:59.39,0:08:01.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dari dekat, senjata itu sia-sia!
Dialogue: 0,0:08:01.89,0:08:02.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah!
Dialogue: 0,0:08:06.97,0:08:07.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takao!
Dialogue: 0,0:08:10.14,0:08:11.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mampus!
Dialogue: 0,0:08:11.68,0:08:13.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takao!
Dialogue: 0,0:08:18.31,0:08:23.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?\NMasa segampang ini?
Dialogue: 0,0:08:29.86,0:08:34.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya ampun, aku sudah kerja cukup keras.
Dialogue: 0,0:08:35.08,0:08:38.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa? Menyerah?
Dialogue: 0,0:08:39.10,0:08:42.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Ars dan Rietz ada di sana, kan?
Dialogue: 0,0:08:42.92,0:08:45.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga kamu antek Canarre.
Dialogue: 0,0:08:45.38,0:08:48.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayang sekali kamu gagal sok pahlawan.
Dialogue: 0,0:08:48.84,0:08:50.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:08:51.54,0:08:54.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sisanya biar mereka yang urus.
Dialogue: 0,0:09:03.98,0:09:06.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada ledakan di sana sini!
Dialogue: 0,0:09:06.23,0:09:09.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}100 prajurit elite akan menyerbu kemari.
Dialogue: 0,0:09:09.98,0:09:12.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian semua akan tamat di sini.
Dialogue: 0,0:09:13.12,0:09:16.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Cuma 100?
Dialogue: 0,0:09:16.04,0:09:20.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jumlah kami 500!\NMana sebanding?
Dialogue: 0,0:09:22.04,0:09:24.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yakin 500 cukup?
Dialogue: 0,0:09:25.12,0:09:26.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudnya?
Dialogue: 0,0:09:26.30,0:09:31.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu pasukan elite yang melindungi Canarre\Ndari 80.000 prajurit Seitz, lo.
Dialogue: 0,0:09:32.99,0:09:34.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:09:42.56,0:09:45.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasukan Elite Canarre tiba!
Dialogue: 0,0:09:45.52,0:09:48.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mundurlah kalau tidak mau mati!
Dialogue: 0,0:09:54.03,0:09:58.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kebanyakan memutar otak\Nbikin tubuhku kaku.
Dialogue: 0,0:09:58.18,0:10:00.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya bisa mengamuk!
Dialogue: 0,0:10:00.08,0:10:02.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski semangatmu memang bagus,
Dialogue: 0,0:10:02.67,0:10:04.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jangan lupa tujuan kita.
Dialogue: 0,0:10:04.25,0:10:08.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini misi penyelamatan Ars Louvent.
Dialogue: 0,0:10:08.70,0:10:10.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paham?
Dialogue: 0,0:10:10.38,0:10:11.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja!
Dialogue: 0,0:10:12.10,0:10:13.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gerbang utama diserang!
Dialogue: 0,0:10:13.46,0:10:16.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata mereka sudah dekat!
Dialogue: 0,0:10:16.11,0:10:20.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai mantan pasukan Seitz,\Nkamu tahu kekuatan mereka, kan?
Dialogue: 0,0:10:21.38,0:10:25.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar saja!\NKami masih punya sandera!
Dialogue: 0,0:10:29.71,0:10:31.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian...
Dialogue: 0,0:10:31.57,0:10:33.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu terlambat, Rietz.
Dialogue: 0,0:10:33.95,0:10:35.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakanda!
Dialogue: 0,0:10:35.07,0:10:37.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maika! Takao!
Dialogue: 0,0:10:37.87,0:10:40.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah keterlaluan tadi.
Dialogue: 0,0:10:40.79,0:10:43.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perbuatan kejimu terhadap Tuan Ars
Dialogue: 0,0:10:44.45,0:10:46.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan kuberi hukuman!
Dialogue: 0,0:10:50.63,0:10:53.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sadarilah tempatmu, Jahanam!
Dialogue: 0,0:11:03.20,0:11:06.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyentuhmu saja membuatku jijik.
Dialogue: 0,0:11:06.80,0:11:07.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bos!
Dialogue: 0,0:11:07.89,0:11:10.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Buygo dikalahkan?
Dialogue: 0,0:11:13.94,0:11:16.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Zat!
Dialogue: 0,0:11:16.38,0:11:18.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu datang menolongku, ya!
Dialogue: 0,0:11:19.94,0:11:22.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan babak belur.
Dialogue: 0,0:11:22.48,0:11:25.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi takut menghadap Nona Lycia.
Dialogue: 0,0:11:26.96,0:11:29.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Zat.
Dialogue: 0,0:11:29.06,0:11:33.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkat kericuhan yang kamu buat,\Nkami berhasil kabur.
Dialogue: 0,0:11:33.30,0:11:38.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama-sama, rasanya aneh\Ndapat terima kasih dari Rietz.
Dialogue: 0,0:11:38.22,0:11:39.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakanda!
Dialogue: 0,0:11:39.80,0:11:42.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lukamu parah, tidak?
Dialogue: 0,0:11:42.03,0:11:45.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, syukurlah kalian juga selamat.
Dialogue: 0,0:11:45.81,0:11:48.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanamu berhasil direbut kembali, ya.
Dialogue: 0,0:11:49.09,0:11:50.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya.
Dialogue: 0,0:11:55.94,0:11:58.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyerahlah, Buygo.
Dialogue: 0,0:12:00.75,0:12:03.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan pikir bisa kabur begitu saja!
Dialogue: 0,0:12:10.00,0:12:11.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa itu?
Dialogue: 0,0:12:11.81,0:12:13.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan...
Dialogue: 0,0:12:13.00,0:12:15.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ledakan lagi?
Dialogue: 0,0:12:15.15,0:12:16.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi bukan dariku!
Dialogue: 0,0:12:20.19,0:12:22.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mending kita mati sama-sama!
Dialogue: 0,0:12:22.83,0:12:25.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian akan mati di sini!
Dialogue: 0,0:12:33.97,0:12:35.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Istananya runtuh!
Dialogue: 0,0:12:35.48,0:12:37.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lari!
Dialogue: 0,0:12:37.06,0:12:38.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zat, ayo pergi!
Dialogue: 0,0:12:38.62,0:12:39.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:12:39.65,0:12:41.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo bergegas!
Dialogue: 0,0:13:05.31,0:13:06.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begini...
Dialogue: 0,0:13:06.82,0:13:09.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lewat sini, kita kabur dari dalam!
Dialogue: 0,0:13:17.84,0:13:19.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya-Yakin lewat sini?
Dialogue: 0,0:13:19.97,0:13:21.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada jalan lagi!
Dialogue: 0,0:13:21.36,0:13:22.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepatlah!
Dialogue: 0,0:13:26.13,0:13:27.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takao!
Dialogue: 0,0:13:28.21,0:13:30.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakanda, awas!
Dialogue: 0,0:13:33.63,0:13:35.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian baik-baik saja?
Dialogue: 0,0:13:49.39,0:13:50.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanaku!
Dialogue: 0,0:13:52.14,0:13:53.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan aneh-aneh, nanti mati!
Dialogue: 0,0:13:56.65,0:13:58.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Ars!
Dialogue: 0,0:14:19.28,0:14:22.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat kemari!\NSebelum keburu runtuh!
Dialogue: 0,0:14:27.87,0:14:29.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami tidak bisa pergi.
Dialogue: 0,0:14:30.19,0:14:31.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:14:31.79,0:14:33.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katananya tidak boleh ditinggalkan!
Dialogue: 0,0:14:33.73,0:14:36.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bicara apa kalian?\NCepatlah kemari!
Dialogue: 0,0:14:36.94,0:14:41.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa-bisa katananya hilang\Ntertimpa reruntuhan!
Dialogue: 0,0:14:41.89,0:14:45.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami akan ambil katananya\Ndan kabur lewat jalan lain!
Dialogue: 0,0:14:45.95,0:14:49.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian cuma akan setor nyawa!\NCepat kemari!
Dialogue: 0,0:14:51.68,0:14:56.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelangsungan Kerajaan You\Nlebih penting dari nyawa kami!
Dialogue: 0,0:14:56.50,0:15:01.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agar bisa kembali pulang sebagai raja,\NKakanda butuh katana itu!
Dialogue: 0,0:15:02.03,0:15:04.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maika, Takao, aku...
Dialogue: 0,0:15:04.83,0:15:05.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakanda!
Dialogue: 0,0:15:07.33,0:15:12.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Ars sosok yang hebat,\Ndia pasti membantu kita.
Dialogue: 0,0:15:13.46,0:15:17.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak kecil, kamu selalu merangkul kami.
Dialogue: 0,0:15:18.53,0:15:23.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebisa mungkin, kami ingin\Nmembuatmu menjadi Raja!
Dialogue: 0,0:15:25.61,0:15:28.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami merasa bahagia
Dialogue: 0,0:15:28.51,0:15:31.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau bisa membantumu.
Dialogue: 0,0:15:39.08,0:15:41.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakanda? Kok?
Dialogue: 0,0:15:43.89,0:15:45.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memang bodoh.
Dialogue: 0,0:15:45.86,0:15:49.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang kuperlukan bukan hal simbolis.
Dialogue: 0,0:15:50.53,0:15:52.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf terlambat menyadarinya.
Dialogue: 0,0:15:53.39,0:15:55.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Ars membuatku sadar.
Dialogue: 0,0:15:55.66,0:16:01.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanpa katana pun, aku sudah jadi raja\Nselama punya kalian!
Dialogue: 0,0:16:02.59,0:16:07.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maukah kalian mengabdi selamanya di sisiku?
Dialogue: 0,0:16:13.62,0:16:16.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja, Kakanda.
Dialogue: 0,0:16:16.27,0:16:18.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami janji akan mengabdi.
Dialogue: 0,0:16:23.86,0:16:26.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat! Lompat kemari!
Dialogue: 0,0:16:57.37,0:16:58.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei!
Dialogue: 0,0:17:04.80,0:17:09.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Istananya runtuh total\Ndan apinya menyala seharian.
Dialogue: 0,0:17:10.81,0:17:15.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kawanan bandit pun ditangkap\Ndan Buygo dibekuk hidup-hidup.
Dialogue: 0,0:17:17.50,0:17:19.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan setelah itu...
Dialogue: 0,0:17:26.10,0:17:27.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakanda!
Dialogue: 0,0:17:33.76,0:17:38.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Meski hilang berulang kali, dia akan kembali\Nke tangan orang yang layak jadi raja."
Dialogue: 0,0:17:38.74,0:17:42.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Konon, begitulah legenda\NKatana Penebas Naga.
Dialogue: 0,0:17:47.42,0:17:48.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Ars!
Dialogue: 0,0:17:49.50,0:17:52.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atas kemurahan hatimu,\Nkami sungguh berterima kasih!
Dialogue: 0,0:17:53.43,0:17:56.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waduh, jangan begitu!
Dialogue: 0,0:17:56.62,0:18:01.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian bertiga sudah membantu\Nmembasmi para bandit.
Dialogue: 0,0:18:01.33,0:18:04.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai Bupati, justru aku\Nyang berterima kasih.
Dialogue: 0,0:18:04.54,0:18:07.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekali lagi, terima kasih.
Dialogue: 0,0:18:09.25,0:18:11.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku!
Dialogue: 0,0:18:11.82,0:18:16.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat pertama kali bertemu,\Nbicaraku agak lancang!
Dialogue: 0,0:18:16.20,0:18:21.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi Tuan Ars dan para pengikut Tuan\Nmalah banyak membantu kami.
Dialogue: 0,0:18:22.43,0:18:27.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih telah menolong\Nkami dan Kakanda!
Dialogue: 0,0:18:29.16,0:18:31.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takao, tundukkan kepalamu juga!
Dialogue: 0,0:18:33.14,0:18:34.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Tuan Ars!
Dialogue: 0,0:18:34.97,0:18:39.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih juga untuk semua\Nyang menjamuku sampai kenyang!
Dialogue: 0,0:18:39.17,0:18:41.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pikiranmu ke makanan terus!
Dialogue: 0,0:18:42.74,0:18:44.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Utang budi kami terlalu banyak.
Dialogue: 0,0:18:45.55,0:18:49.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Ars bahkan mengajarkanku\Narti seorang pemimpin.
Dialogue: 0,0:18:49.87,0:18:54.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi sadar, mereka lebih penting\Ndaripada sebilah katana.
Dialogue: 0,0:18:54.48,0:18:57.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, tidak, kok!
Dialogue: 0,0:18:57.31,0:19:02.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, sebagai sesama pemimpin,\Nkuharap kita bisa belajar bersama.
Dialogue: 0,0:19:02.75,0:19:08.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, aku akan berusaha jadi raja\Nyang bisa mereka berdua banggakan.
Dialogue: 0,0:19:10.68,0:19:12.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa rencana kalian ke depannya?
Dialogue: 0,0:19:13.57,0:19:18.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar, Tuan Ars mencari orang kompeten\Nuntuk persiapan perang mendatang.
Dialogue: 0,0:19:19.30,0:19:26.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat awal bertemu, kamu bertanya soal identitas\Nkarena mau mencoba merekrut kami, kan?
Dialogue: 0,0:19:26.00,0:19:30.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maaf!\NTidak ada niatan memaksa!
Dialogue: 0,0:19:30.21,0:19:33.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ditambah, aku tidak tahu\Nkalian keluarga kerajaan!
Dialogue: 0,0:19:33.65,0:19:36.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, aku paham ketulusanmu.
Dialogue: 0,0:19:37.50,0:19:42.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayangnya sebagai seorang raja,\Naku tidak bisa jadi bawahan.
Dialogue: 0,0:19:42.88,0:19:46.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi banyak yang bisa kupelajari darimu.
Dialogue: 0,0:19:46.67,0:19:50.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi mengumpulkan kekuatan\Ndan membangun ulang Kerajaan You,
Dialogue: 0,0:19:51.55,0:19:56.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bolehkah aku bekerja bersama Tuan Ars\Nsebagai jenderal sekutu?
Dialogue: 0,0:19:59.36,0:20:04.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keberadaan kalian akan membuat\NCanarre makin solid!
Dialogue: 0,0:20:04.16,0:20:05.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja boleh!
Dialogue: 0,0:20:07.08,0:20:08.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:20:13.78,0:20:16.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai bisa pulang ke Kerajaan You nanti,
Dialogue: 0,0:20:17.36,0:20:22.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku bersumpah akan mengabdi\Ndengan raga dan katana ini!
Dialogue: 0,0:20:27.95,0:20:29.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon kerja samanya!
Dialogue: 0,0:20:33.59,0:20:35.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon bantuannya!
Dialogue: 0,0:20:35.01,0:20:35.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga sama.
Dialogue: 0,0:20:35.89,0:20:37.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, aku!
Dialogue: 0,0:20:37.31,0:20:39.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, aku mohon juga!
Dialogue: 0,0:20:39.72,0:20:42.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah, Tuan Ars.
Dialogue: 0,0:20:42.35,0:20:45.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, semuanya selamat...
Dialogue: 0,0:20:45.60,0:20:50.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo? Bagaimana nasib Buygo\Nsang bos para bandit?
Dialogue: 0,0:20:50.93,0:20:53.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan babak belur.
Dialogue: 0,0:20:53.34,0:20:56.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi takut menghadap Nona Lycia.
Dialogue: 0,0:20:58.24,0:21:02.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Anu, Buygo ditahan di mana?
Dialogue: 0,0:21:02.83,0:21:07.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Ars tidak perlu memikirkannya.
Dialogue: 0,0:21:07.04,0:21:08.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ja-Jangan bilang...
Dialogue: 0,0:21:08.53,0:21:10.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku apakan, ya?
Dialogue: 0,0:21:12.45,0:21:14.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Ars, tunggu!
Dialogue: 0,0:21:14.74,0:21:16.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buygo!
Dialogue: 0,0:21:19.93,0:21:22.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa tubuhmu diiris-iris?
Dialogue: 0,0:21:25.44,0:21:31.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga, mana mungkin aku seganas itu.
Dialogue: 0,0:21:31.10,0:21:34.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma mencecarnya sedikit.
Dialogue: 0,0:21:34.52,0:21:38.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo Buygo, pertama-tama harus bilang apa?
Dialogue: 0,0:21:38.80,0:21:40.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:21:40.19,0:21:44.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Muda, mohon maaf\Natas kelancanganku tempo hari!
Dialogue: 0,0:21:44.30,0:21:47.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, patuh sekali.
Dialogue: 0,0:21:48.82,0:21:53.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lycia ternyata memang menakutkan!
Dialogue: 0,0:23:25.50,0:23:29.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, Lycia, senyummu agak bikin merinding...
Dialogue: 0,0:23:29.30,0:23:33.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Ars kejam,\Npadahal aku sama seperti biasa.
Dialogue: 0,0:23:33.49,0:23:35.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aura murkamu terlihat, tuh!
Dialogue: 0,0:23:35.60,0:23:37.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untung cuma auranya.
Dialogue: 0,0:23:37.50,0:23:44.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya, "Asa yang Terpendam".
