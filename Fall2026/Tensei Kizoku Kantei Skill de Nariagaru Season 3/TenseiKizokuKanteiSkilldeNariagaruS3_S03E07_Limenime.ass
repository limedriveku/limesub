Dialogue: 0,0:00:00.00,0:00:03.36,sign,,0000,0000,0000,,ISTANA CANARRE
Dialogue: 0,0:02:04.31,0:02:09.97,sign,,0000,0000,0000,,AS A REINCARNATED ARISTOCRAT, I'LL USE MY\NAPPRAISAL SKILL TO RISE IN THE WORLD SEASON 3
Dialogue: 0,0:02:10.49,0:02:14.74,sign,,0000,0000,0000,,EPISODE 31: MISI PENYELAMATAN ARS
Dialogue: 0,0:08:03.75,0:08:07.13,sign,,0000,0000,0000,,PENYUSUPAN ZAT
Dialogue: 0,0:10:36.41,0:10:43.75,sign,,0000,0000,0000,,AS A REINCARNATED ARISTOCRAT, I'LL USE MY\NAPPRAISAL SKILL TO RISE IN THE WORLD SEASON 3
Dialogue: 0,0:10:44.25,0:10:46.35,sign,,0000,0000,0000,,RIKUYA FUJIMIYA
Dialogue: 0,0:11:32.25,0:11:34.97,sign,,0000,0000,0000,,KERAJAAN YOU, 10 TAHUN LALU
Dialogue: 0,0:18:22.96,0:18:26.34,sign,,0000,0000,0000,,SIKSAAN BUYGO
Dialogue: 0,0:18:45.48,0:18:46.41,sign,,0000,0000,0000,,KEPEMIMPINAN 59, KEBERANIAN 79,\NKEBIJAKSANAAN 56, POLITIK 41, AMBISI 74
Dialogue: 0,0:18:46.41,0:18:47.92,sign,,0000,0000,0000,,INFANTERI A, KAVALERI C, MEMANAH B
Dialogue: 0,0:18:47.92,0:18:49.71,sign,,0000,0000,0000,,SIHIR D, KONSTRUKSI C, KESENJATAAN D
Dialogue: 0,0:18:49.71,0:18:51.11,sign,,0000,0000,0000,,ANGKATAN LAUT C, ANGKATAN UDARA C, STRATEGI C
Dialogue: 0,0:23:37.98,0:23:42.53,sign,,0000,0000,0000,,SELANJUTNYA: HAL YANG SEORANG RAJA BUTUHKAN
Dialogue: 0,0:00:03.62,0:00:07.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, mari mulai operasi\Npenyelamatan Tuan Ars.
Dialogue: 0,0:00:07.96,0:00:09.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dilarang gagal.
Dialogue: 0,0:00:10.28,0:00:13.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lenyapkan semua musuh yang ada!
Dialogue: 0,0:00:13.60,0:00:15.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, siapa yang memimpin?
Dialogue: 0,0:00:15.60,0:00:18.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rosell sedang ke pelabuhan\Nuntuk urusan diplomatik.
Dialogue: 0,0:00:18.20,0:00:22.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menunggu Mireille datang\Ndari Lamberg pun butuh waktu.
Dialogue: 0,0:00:22.35,0:00:23.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:00:24.25,0:00:25.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus turun tangan!
Dialogue: 0,0:00:25.95,0:00:27.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Mana boleh!\N- Tenang dulu!
Dialogue: 0,0:00:27.99,0:00:30.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Charlotte, lepaskan aku!\N- Buat apa kamu yang ke sana?
Dialogue: 0,0:00:30.93,0:00:32.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tenanglah!\N- Buat apa kamu yang ke sana?
Dialogue: 0,0:00:32.63,0:00:36.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Izinkan aku mengemban tugas itu!
Dialogue: 0,0:00:37.17,0:00:38.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Thomas?
Dialogue: 0,0:02:11.11,0:02:14.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar kamu direkrut Mireille.
Dialogue: 0,0:02:15.16,0:02:18.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu alasanmu kemari, ya?
Dialogue: 0,0:02:19.49,0:02:24.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski aku belum resmi jadi bawahan,\Ntampaknya kalian kesulitan.
Dialogue: 0,0:02:24.87,0:02:25.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kubantu...
Dialogue: 0,0:02:27.79,0:02:30.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Thomas, terima kasih.
Dialogue: 0,0:02:31.32,0:02:32.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kan, aku belum...
Dialogue: 0,0:02:32.72,0:02:35.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sungguh berterima kasih.
Dialogue: 0,0:02:35.32,0:02:38.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu rela menolongnya\Nmeski pernah jadi musuh.
Dialogue: 0,0:02:39.69,0:02:43.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma merasa Tuan Muda\Nlebih layak dari Tuan Cran.
Dialogue: 0,0:02:43.59,0:02:46.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berjanji akan membawanya pulang.
Dialogue: 0,0:02:47.00,0:02:48.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:02:48.52,0:02:52.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Braham, Zat, semoga berhasil!
Dialogue: 0,0:02:52.05,0:02:54.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamatkan Tuan Ars apa pun yang terjadi!
Dialogue: 0,0:02:54.48,0:02:57.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja, biar kami yang urus!
Dialogue: 0,0:02:58.20,0:03:00.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa pun yang terjadi, lo?
Dialogue: 0,0:03:03.33,0:03:06.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, rencananya bagaimana?
Dialogue: 0,0:03:06.25,0:03:09.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gampang, mereka cuma bandit, kan?
Dialogue: 0,0:03:09.83,0:03:13.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita pasukan Canarre lebih kuat,\Nlibas saja semuanya.
Dialogue: 0,0:03:14.39,0:03:18.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka pasti kabur kalau diserbu ramai-ramai,
Dialogue: 0,0:03:18.16,0:03:20.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak akan mau bertempur langsung.
Dialogue: 0,0:03:20.83,0:03:22.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bayangkan nasib sanderanya.
Dialogue: 0,0:03:24.41,0:03:27.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bakal dibunuh biar tidak jadi beban?
Dialogue: 0,0:03:27.40,0:03:30.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul, lalu kamu akan dibunuh Nyonya Muda.
Dialogue: 0,0:03:30.90,0:03:33.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Nyonya Muda?
Dialogue: 0,0:03:37.49,0:03:41.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagian paman ini siapa?\NKenapa ikut campur?
Dialogue: 0,0:03:41.09,0:03:44.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasukan Elite Canarre\Nadalah yang terkuat di Missian!
Dialogue: 0,0:03:44.36,0:03:46.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami saja sudah cukup!
Dialogue: 0,0:03:46.27,0:03:47.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Bocah.
Dialogue: 0,0:03:47.37,0:03:48.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bo-Bocah?
Dialogue: 0,0:03:49.21,0:03:52.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian yang terkuat di Missian, kan?
Dialogue: 0,0:03:52.12,0:03:56.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi taktik perang bukan cuma\Nbawa tombak dan asal serbu.
Dialogue: 0,0:03:56.48,0:03:57.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama,
Dialogue: 0,0:03:58.19,0:04:00.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pelajarilah dulu musuhmu.
Dialogue: 0,0:04:03.45,0:04:06.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini tempat prajurit kita diserang?
Dialogue: 0,0:04:06.00,0:04:08.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok kayak tidak ada orang?
Dialogue: 0,0:04:14.19,0:04:15.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sudah lama, ya.
Dialogue: 0,0:04:16.72,0:04:17.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat ini.
Dialogue: 0,0:04:19.00,0:04:19.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa pendapatmu?
Dialogue: 0,0:04:20.35,0:04:21.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:04:21.36,0:04:23.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma bekas api unggun dan ember, kan?
Dialogue: 0,0:04:24.72,0:04:28.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ember ini terbuat dari baja.
Dialogue: 0,0:04:28.41,0:04:31.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Barang di Missian kebanyakan dari kayu.
Dialogue: 0,0:04:31.07,0:04:34.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jarang ada barang dari logam.
Dialogue: 0,0:04:34.24,0:04:37.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apalagi logamnya baja, sangat langka.
Dialogue: 0,0:04:37.97,0:04:40.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya juga, di sini langka.
Dialogue: 0,0:04:40.51,0:04:43.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Walau ketahuan oleh pasukan Canarre,
Dialogue: 0,0:04:43.52,0:04:46.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}masa barang seberharga ini dibuang?
Dialogue: 0,0:04:46.91,0:04:50.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin mereka buru-buru?
Dialogue: 0,0:04:50.08,0:04:52.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya kenapa?
Dialogue: 0,0:04:53.93,0:04:57.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu benar-benar tidak berpikir, ya.
Dialogue: 0,0:04:57.44,0:04:59.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perlu didikan dulu.
Dialogue: 0,0:04:59.95,0:05:01.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Didikan?
Dialogue: 0,0:05:02.35,0:05:03.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sini.
Dialogue: 0,0:05:03.05,0:05:05.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, tunggu!
Dialogue: 0,0:05:06.95,0:05:09.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya didikan?
Dialogue: 0,0:05:09.73,0:05:12.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang diperlukan untuk membuat baja?
Dialogue: 0,0:05:12.93,0:05:15.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eng...
Dialogue: 0,0:05:19.92,0:05:20.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu dia.
Dialogue: 0,0:05:25.85,0:05:27.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada penjaganya.
Dialogue: 0,0:05:27.79,0:05:29.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Matamu jeli juga.
Dialogue: 0,0:05:31.01,0:05:32.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga.
Dialogue: 0,0:05:33.04,0:05:34.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat seragamnya.
Dialogue: 0,0:05:36.13,0:05:39.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski sudah kusam,\Nitu seragam prajurit Seitz.
Dialogue: 0,0:05:39.49,0:05:40.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:05:40.48,0:05:43.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Firasatku tepat saat melihat sisa kemah itu.
Dialogue: 0,0:05:44.17,0:05:47.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba tebak kenapa para bandit\Nmemakai seragam Seitz?
Dialogue: 0,0:05:47.88,0:05:49.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena mencurinya, lah.
Dialogue: 0,0:05:50.36,0:05:54.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa jauh-jauh ke provinsi sebelah\Ncuma buat mencuri seragam?
Dialogue: 0,0:05:54.53,0:05:56.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sih ogah.
Dialogue: 0,0:05:57.87,0:05:59.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya juga.
Dialogue: 0,0:05:59.47,0:06:02.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baja adalah produk khas Seitz.
Dialogue: 0,0:06:02.16,0:06:05.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sangat cocok dengan batu sihir\Nyang ditambang di sana.
Dialogue: 0,0:06:05.93,0:06:07.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baja itu
Dialogue: 0,0:06:07.51,0:06:11.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bahan dasar ember yang ada\Ndi lokasi penyerangan, kan?
Dialogue: 0,0:06:11.89,0:06:15.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti, kayaknya mereka prajurit Seitz.
Dialogue: 0,0:06:15.35,0:06:18.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya punya baja dan seragam itu.
Dialogue: 0,0:06:18.32,0:06:19.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Wah, iya.\N- Betul.
Dialogue: 0,0:06:19.45,0:06:22.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Prajurit pelarian yang jadi bandit\Nsetelah kalah perang.
Dialogue: 0,0:06:22.75,0:06:24.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sering terjadi.
Dialogue: 0,0:06:24.32,0:06:26.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benar?
Dialogue: 0,0:06:26.33,0:06:30.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok Paman bisa tahu sejauh itu\Ncuma dari sebuah ember?
Dialogue: 0,0:06:31.19,0:06:32.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah biasa.
Dialogue: 0,0:06:32.52,0:06:33.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi masalahnya,
Dialogue: 0,0:06:33.79,0:06:38.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau kita asal serbu, mereka akan\Nmembakar semuanya dan kabur.
Dialogue: 0,0:06:38.73,0:06:40.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus bagaimana...
Dialogue: 0,0:06:40.43,0:06:43.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana menyelamatkan Ars Louvent, ya?
Dialogue: 0,0:06:43.92,0:06:47.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa dibilang, nasib Canarre\Nada di tanganmu, lo.
Dialogue: 0,0:06:48.20,0:06:49.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putar otakmu.
Dialogue: 0,0:06:51.27,0:06:52.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Otakku?
Dialogue: 0,0:06:53.63,0:06:57.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar, para bandit itu melonjak pesat.
Dialogue: 0,0:06:57.88,0:07:01.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti anggotanya tambah banyak, kan?
Dialogue: 0,0:07:01.13,0:07:05.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa prajurit Seitz lari ke Missian semua?
Dialogue: 0,0:07:05.56,0:07:08.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, mereka merekrut bandit liar!
Dialogue: 0,0:07:10.53,0:07:14.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo menyamar jadi bandit liar untuk menyusup!
Dialogue: 0,0:07:14.84,0:07:17.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mumpung anggotanya banyak,\Nmereka tidak akan sadar!
Dialogue: 0,0:07:18.31,0:07:21.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah maksudku soal memutar otak.
Dialogue: 0,0:07:21.32,0:07:23.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ingat baik-baik, Bocah.
Dialogue: 0,0:07:23.72,0:07:27.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hore!\NAku memang hebat!
Dialogue: 0,0:07:27.75,0:07:31.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Woi, jangan berisik!\NNanti ketahuan!
Dialogue: 0,0:07:31.85,0:07:34.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Seorang Braham memakai otaknya?\N- Ternyata aku bisa jadi ahli strategi.
Dialogue: 0,0:07:34.64,0:07:35.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini belum seberapa.
Dialogue: 0,0:07:35.95,0:07:37.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kalau dibimbing orang ini,\N- Belum bisa?
Dialogue: 0,0:07:37.81,0:07:41.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Belum.\N- mungkin pasukan kami akan lebih hebat!
Dialogue: 0,0:07:41.48,0:07:44.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tinggal menentukan siapa yang menyusup.
Dialogue: 0,0:07:44.41,0:07:46.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harus orang yang cerdas.
Dialogue: 0,0:07:46.83,0:07:47.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku, dong?
Dialogue: 0,0:07:47.76,0:07:50.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu mustahil buat Kapten.
Dialogue: 0,0:07:50.29,0:07:51.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok mustahil, sih?
Dialogue: 0,0:07:52.13,0:07:55.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bakal kelewat jujur kalau ditanya.
Dialogue: 0,0:07:55.25,0:07:56.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul juga.
Dialogue: 0,0:07:56.75,0:08:00.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, biar aku yang menyusup.
Dialogue: 0,0:08:00.25,0:08:02.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zat, tolong, ya!
Dialogue: 0,0:08:02.91,0:08:03.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berisik!
Dialogue: 0,0:08:07.96,0:08:08.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada musuh?
Dialogue: 0,0:08:09.33,0:08:14.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah, tapi...
Dialogue: 0,0:08:14.64,0:08:16.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sendirian!
Dialogue: 0,0:08:18.36,0:08:22.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa kamu?\NSudah tahu ini tempat apa?
Dialogue: 0,0:08:22.02,0:08:23.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tahu.
Dialogue: 0,0:08:23.25,0:08:25.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Luvius dari Paradille.
Dialogue: 0,0:08:25.99,0:08:29.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pembohong!\NKamu prajurit Missian, kan?
Dialogue: 0,0:08:29.80,0:08:31.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bosan hidup, ya?
Dialogue: 0,0:08:31.51,0:08:35.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian punya dendam pribadi\Nke orang Paradille?
Dialogue: 0,0:08:35.75,0:08:40.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi logatmu memang khas\Norang Paradille, sih.
Dialogue: 0,0:08:41.38,0:08:46.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku butuh pekerjaan,\Nboleh aku bergabung ke sini?
Dialogue: 0,0:08:48.05,0:08:52.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayangnya, anggota kami sudah cukup.
Dialogue: 0,0:08:52.03,0:08:54.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi tidak perlu pulang buru-buru.
Dialogue: 0,0:08:55.70,0:08:57.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan tasmu.
Dialogue: 0,0:08:57.35,0:09:02.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, masa kalian tidak butuh\Norang berpengalaman?
Dialogue: 0,0:09:03.48,0:09:08.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Butuh, sih, tapi itu bukan urusanmu.
Dialogue: 0,0:09:14.92,0:09:17.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Galak banget.
Dialogue: 0,0:09:17.03,0:09:20.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cukup terkenal di Paradille, lo!
Dialogue: 0,0:09:20.77,0:09:23.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dan Georg, bos bandit di Missian
Dialogue: 0,0:09:23.84,0:09:26.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sering minum bareng 10 tahun lalu.
Dialogue: 0,0:09:26.72,0:09:28.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kenalan Tuan Georg?
Dialogue: 0,0:09:28.76,0:09:30.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aneh sekali.
Dialogue: 0,0:09:30.40,0:09:34.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski pernah bekerja untuk Georg,\Naku tidak kenal namamu.
Dialogue: 0,0:09:36.20,0:09:39.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Georg ada di dalam juga, lo.
Dialogue: 0,0:09:39.56,0:09:40.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau kutanyakan?
Dialogue: 0,0:09:42.44,0:09:46.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh, sudah lama tidak minum bersamanya.
Dialogue: 0,0:09:48.35,0:09:50.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya dia jujur.
Dialogue: 0,0:09:50.29,0:09:53.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, biar kami antar ke Bos.
Dialogue: 0,0:09:54.44,0:09:56.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf mencurigaimu.
Dialogue: 0,0:09:56.08,0:10:00.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya sering ada yang cuma mengaku-aku.
Dialogue: 0,0:10:00.29,0:10:01.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baguslah.
Dialogue: 0,0:10:03.72,0:10:07.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, Georg sudah meninggal.
Dialogue: 0,0:10:07.49,0:10:09.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi aku cuma menggertak.
Dialogue: 0,0:10:09.92,0:10:13.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayang sekali,\Nsaatnya minum untuk mengenang.
Dialogue: 0,0:10:14.45,0:10:15.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jelas saja.
Dialogue: 0,0:10:16.63,0:10:20.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu jadi tentara bayaran,\Naku yang membunuh Georg.
Dialogue: 0,0:10:22.79,0:10:26.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyusupan berhasil, waktunya sabotase.
Dialogue: 0,0:10:27.40,0:10:31.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Braham, Thomas, kalian juga harus berhasil.
Dialogue: 0,0:10:46.35,0:10:49.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rikuya, kamu tidak bisa tidur?
Dialogue: 0,0:10:51.13,0:10:54.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf melibatkanmu ke masalah Canarre.
Dialogue: 0,0:10:55.53,0:10:59.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu kamu cemas,\Ntapi bantuan pasti datang.
Dialogue: 0,0:10:59.60,0:11:02.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Simpanlah tenagamu untuk nanti.
Dialogue: 0,0:11:02.95,0:11:05.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tertangkap karena memang lengah.
Dialogue: 0,0:11:05.80,0:11:09.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, bisa-bisa pedangku dijual.
Dialogue: 0,0:11:09.45,0:11:11.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah yang membuatku gelisah.
Dialogue: 0,0:11:12.87,0:11:16.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepenting itukah pedang itu?
Dialogue: 0,0:11:16.15,0:11:18.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski memang pusaka keluarga, sih.
Dialogue: 0,0:11:19.63,0:11:23.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya, bukan aku yang jadi raja.
Dialogue: 0,0:11:23.33,0:11:25.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Maksudnya?
Dialogue: 0,0:11:26.13,0:11:28.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh aku cerita sedikit?
Dialogue: 0,0:11:29.26,0:11:32.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentang yang terjadi di Kerajaan You
Dialogue: 0,0:11:32.25,0:11:34.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sekaligus tanah kelahiranku.
Dialogue: 0,0:11:35.36,0:11:38.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keluarga Fujimiya memimpin\Nsejak Kerajaan You berdiri.
Dialogue: 0,0:11:38.97,0:11:43.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku putra kelima dari istri sah\Nkepala keluarga generasi ke-13.
Dialogue: 0,0:11:43.27,0:11:46.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Posisiku sebagai pewaris terhitung rendah.
Dialogue: 0,0:11:48.12,0:11:49.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu...
Dialogue: 0,0:11:51.81,0:11:53.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maika, Takao.
Dialogue: 0,0:11:55.52,0:11:59.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami hidup bebas, tidak seperti para kakanda.
Dialogue: 0,0:11:59.43,0:12:03.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami sering menyelinap pergi ke permukiman.
Dialogue: 0,0:12:03.77,0:12:06.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski cuma saudara tiri seayah,
Dialogue: 0,0:12:06.12,0:12:10.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami sebaya dan sering main\Ndengan anak-anak permukiman.
Dialogue: 0,0:12:11.02,0:12:14.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketika tiap main sampai lupa waktu...
Dialogue: 0,0:12:15.63,0:12:17.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, wah.
Dialogue: 0,0:12:17.21,0:12:20.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibunda selalu menjemput kami.
Dialogue: 0,0:12:20.52,0:12:25.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waduh, siapa yang punya ide keluar istana?
Dialogue: 0,0:12:26.62,0:12:28.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Ini ide kami!
Dialogue: 0,0:12:28.75,0:12:31.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, ini ideku!
Dialogue: 0,0:12:31.40,0:12:33.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Habisnya aku yang mengajak!\N- Bukan, kok!
Dialogue: 0,0:12:33.37,0:12:34.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Habisnya aku yang mengajak!\N- Kami berdua!
Dialogue: 0,0:12:34.40,0:12:35.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Benaran, kok!\N- Aku yang duluan!
Dialogue: 0,0:12:35.17,0:12:37.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kami berdua!\N- Aku yang duluan!
Dialogue: 0,0:12:37.23,0:12:38.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita pulang.
Dialogue: 0,0:12:43.44,0:12:45.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, aku lupa.
Dialogue: 0,0:12:46.08,0:12:48.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jepit rambut ini terbuat\Ndari bunga di permukiman.
Dialogue: 0,0:12:49.45,0:12:51.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau kuberikan ke Ibunda.
Dialogue: 0,0:12:52.25,0:12:54.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, bisa saja kamu.
Dialogue: 0,0:13:00.12,0:13:02.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibunda cantik sekali.
Dialogue: 0,0:13:03.01,0:13:05.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Rikuya.
Dialogue: 0,0:13:05.68,0:13:08.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mencintai Ibunda, adik-adik,
Dialogue: 0,0:13:08.83,0:13:11.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan juga Kerajaan You.
Dialogue: 0,0:13:13.21,0:13:15.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat mulai dewasa,
Dialogue: 0,0:13:15.97,0:13:17.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami mulai
Dialogue: 0,0:13:17.03,0:13:20.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dilatih untuk membantu Ayahanda\Ndan para kakanda.
Dialogue: 0,0:13:22.44,0:13:25.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maika yang cerdas cocok\Ndi ahli strategi atau pejabat sipil.
Dialogue: 0,0:13:25.96,0:13:29.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takao yang kuat dilatih jadi pendekar.
Dialogue: 0,0:13:31.16,0:13:34.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski tidak terlalu menonjol,
Dialogue: 0,0:13:34.36,0:13:36.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku juga mengasah diri.
Dialogue: 0,0:13:39.05,0:13:40.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bau gosong?
Dialogue: 0,0:13:41.45,0:13:42.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakanda!
Dialogue: 0,0:13:50.53,0:13:51.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakanda...
Dialogue: 0,0:13:51.96,0:13:53.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Rikuya!
Dialogue: 0,0:13:53.27,0:13:55.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada serangan, pergi...
Dialogue: 0,0:13:55.90,0:13:57.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Segeralah pergi!
Dialogue: 0,0:14:01.90,0:14:04.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayahanda! Ibunda!
Dialogue: 0,0:14:07.09,0:14:08.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakanda!
Dialogue: 0,0:14:10.69,0:14:13.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rikuya?\NKamu Rikuya?
Dialogue: 0,0:14:13.45,0:14:14.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakanda...
Dialogue: 0,0:14:14.53,0:14:16.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat pergi.
Dialogue: 0,0:14:16.51,0:14:19.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diam dulu, lukamu harus...
Dialogue: 0,0:14:20.37,0:14:23.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lindungi Ayahanda!
Dialogue: 0,0:14:24.97,0:14:26.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakanda?
Dialogue: 0,0:14:28.47,0:14:30.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakanda!
Dialogue: 0,0:14:30.35,0:14:32.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakanda!
Dialogue: 0,0:14:33.40,0:14:34.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:14:35.37,0:14:37.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa mereka harus dibunuh?
Dialogue: 0,0:14:37.90,0:14:39.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayahanda!
Dialogue: 0,0:14:46.27,0:14:47.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rikuya?
Dialogue: 0,0:14:50.21,0:14:51.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayahanda!
Dialogue: 0,0:14:51.12,0:14:53.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para abdi berkhianat!
Dialogue: 0,0:14:53.85,0:14:55.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka mengincar takhta raja!
Dialogue: 0,0:14:56.15,0:14:57.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takhta raja?
Dialogue: 0,0:14:57.41,0:15:00.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana Ibunda?\NIbunda aman, kan?
Dialogue: 0,0:15:00.30,0:15:03.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, mereka menculiknya.
Dialogue: 0,0:15:06.21,0:15:07.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rikuya.
Dialogue: 0,0:15:07.69,0:15:09.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bawa ini dan pergilah!
Dialogue: 0,0:15:10.08,0:15:12.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah katana ini khusus kepala keluarga...
Dialogue: 0,0:15:12.84,0:15:13.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar!
Dialogue: 0,0:15:15.21,0:15:17.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu harus jadi raja!
Dialogue: 0,0:15:17.57,0:15:22.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rebut kembali Kerajaan You\Ndengan katana ini!
Dialogue: 0,0:15:22.28,0:15:24.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kepala keluarga?\NKenapa begitu?
Dialogue: 0,0:15:24.95,0:15:27.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Di dalam sini! Bunuh semuanya!\N- Bunuh Fujimiya!
Dialogue: 0,0:15:27.07,0:15:29.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para majikan, ayo lewat sini!
Dialogue: 0,0:15:35.19,0:15:38.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kami yang tahan, pergilah!
Dialogue: 0,0:15:39.20,0:15:41.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku titipkan negeri ini.
Dialogue: 0,0:15:46.43,0:15:51.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keluarga Fujimiya digulingkan\Noleh kudeta para abdi.
Dialogue: 0,0:15:51.23,0:15:54.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma aku, Maika, dan Takao yang selamat.
Dialogue: 0,0:16:02.08,0:16:06.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakanda, mari kita tinggalkan negeri ini!
Dialogue: 0,0:16:06.05,0:16:09.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka sudah menduduki seisi negeri.
Dialogue: 0,0:16:09.53,0:16:10.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibunda bagaimana?
Dialogue: 0,0:16:11.35,0:16:14.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dijadikan istri yang merebut takhta!
Dialogue: 0,0:16:15.01,0:16:18.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi cuma buat kedok, aslinya dikurung!
Dialogue: 0,0:16:22.72,0:16:24.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pasti...
Dialogue: 0,0:16:25.24,0:16:27.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pasti akan menyelamatkanmu.
Dialogue: 0,0:16:29.52,0:16:30.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibunda!
Dialogue: 0,0:16:34.76,0:16:37.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sisanya, seperti yang pernah kubilang.
Dialogue: 0,0:16:38.23,0:16:42.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami keliling sana sini\Nminta bantuan para pejabat.
Dialogue: 0,0:16:44.27,0:16:45.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku
Dialogue: 0,0:16:45.75,0:16:50.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak secerdas Maika\Ndan tidak sekuat Takao.
Dialogue: 0,0:16:50.49,0:16:55.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi sebagai pewaris takhta,\Naku harus merebut kembali negeri.
Dialogue: 0,0:16:55.45,0:16:59.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai pemimpin,\Naku cukup paham perasaanmu.
Dialogue: 0,0:17:00.75,0:17:01.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Ars.
Dialogue: 0,0:17:02.63,0:17:05.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pernah bertanya-tanya soal asal-usulmu?
Dialogue: 0,0:17:06.47,0:17:10.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai bangsawan, kita harus jadi pewaris.
Dialogue: 0,0:17:10.23,0:17:12.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kenapa harus mewarisi?
Dialogue: 0,0:17:13.72,0:17:16.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena punya darah keluarga kerajaan?
Dialogue: 0,0:17:18.99,0:17:22.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutku itu tidak penting.
Dialogue: 0,0:17:23.04,0:17:26.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya, hal itu tidak terlihat.
Dialogue: 0,0:17:27.20,0:17:31.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku hanya pemuda yang minim\Nwawasan dan kemampuan.
Dialogue: 0,0:17:32.16,0:17:36.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya diriku yang biasa saja ini
Dialogue: 0,0:17:36.92,0:17:40.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sanggup memikul beban negara sendirian?
Dialogue: 0,0:17:42.41,0:17:45.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya katana itu penting!
Dialogue: 0,0:17:45.77,0:17:50.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang bisa menjamin aku jadi raja\Nhanya katana itu!
Dialogue: 0,0:17:50.44,0:17:51.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katana Penebas Naga!
Dialogue: 0,0:17:52.85,0:17:57.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa merasa istimewa\Ncuma saat menggenggam katana itu!
Dialogue: 0,0:17:59.33,0:18:04.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya ada hal lain yang bisa\Nmembuktikan bahwa aku raja?
Dialogue: 0,0:18:04.80,0:18:07.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rikuya, kurasa kamu keliru.
Dialogue: 0,0:18:11.04,0:18:13.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bos, ada apa?
Dialogue: 0,0:18:13.45,0:18:15.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak muda, ras Marca,
Dialogue: 0,0:18:15.63,0:18:17.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan tuan rambut panjang itu
Dialogue: 0,0:18:18.03,0:18:20.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan kubawa ke tempat bagus.
Dialogue: 0,0:18:29.36,0:18:33.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ini benci pembohong.
Dialogue: 0,0:18:33.60,0:18:37.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal cuma mau mengobrol terus terang,
Dialogue: 0,0:18:37.03,0:18:39.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi semuanya selalu saja bohong.
Dialogue: 0,0:18:40.19,0:18:44.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah sering menghukum para pembohong.
Dialogue: 0,0:18:46.41,0:18:47.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang ini...
Dialogue: 0,0:18:47.92,0:18:51.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang ini bagus juga.
Dialogue: 0,0:18:51.55,0:18:54.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak buahku mungkin tidak sadar.
Dialogue: 0,0:18:54.89,0:18:58.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kok pengembara bisa punya barang ini?
Dialogue: 0,0:18:59.61,0:19:02.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu pusaka keluargaku.
Dialogue: 0,0:19:02.44,0:19:04.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Warisan dari ayahku.
Dialogue: 0,0:19:08.61,0:19:11.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti kamu bukan pengembara, kan?
Dialogue: 0,0:19:11.29,0:19:13.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tidak berbohong!
Dialogue: 0,0:19:15.31,0:19:17.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu melakukan ini?
Dialogue: 0,0:19:17.74,0:19:19.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mantan prajurit Seitz, kan?
Dialogue: 0,0:19:20.72,0:19:23.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, kamu tahu, ya.
Dialogue: 0,0:19:23.28,0:19:26.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak buahku percaya kamu pedagang.
Dialogue: 0,0:19:26.94,0:19:30.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku melihat wajahmu di perang itu, lo.
Dialogue: 0,0:19:30.61,0:19:33.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ars Louvent.
Dialogue: 0,0:19:33.21,0:19:35.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu juga, Rietz Muses.
Dialogue: 0,0:19:36.87,0:19:40.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luka ini oleh-oleh darimu\Nwaktu perang di Sungai Khmer!
Dialogue: 0,0:19:40.92,0:19:43.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makasih banyak, lo.
Dialogue: 0,0:19:44.45,0:19:48.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah kalah, aku jadi bandit\Nbersama anak-anak buahku.
Dialogue: 0,0:19:48.20,0:19:52.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi enak, lo!\NKami lebih kaya daripada jadi prajurit!
Dialogue: 0,0:19:52.97,0:19:54.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlebih lagi,
Dialogue: 0,0:19:55.21,0:20:00.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bahkan memegang nasib orang\Nyang mengalahkan Tuan Borotts.
Dialogue: 0,0:20:01.49,0:20:03.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba saja sentuh Tuan Ars!
Dialogue: 0,0:20:03.68,0:20:07.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jamin nyawamu melayang!
Dialogue: 0,0:20:09.04,0:20:11.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi ingat waktu perang.
Dialogue: 0,0:20:12.23,0:20:17.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tidak akan kubunuh, kok!\NNanti malah tidak bisa ditebus.
Dialogue: 0,0:20:17.13,0:20:21.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kebohongannya dan dendam luka ini
Dialogue: 0,0:20:21.20,0:20:22.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan kubalas tuntas!
Dialogue: 0,0:20:22.77,0:20:23.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rietz!
Dialogue: 0,0:20:24.85,0:20:28.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana, nih?\NKok enggak kayak pas perang?
Dialogue: 0,0:20:31.92,0:20:34.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersuara sedikit, dong.
Dialogue: 0,0:20:35.25,0:20:38.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mantan budak sudah biasa dicambuk, ya?
Dialogue: 0,0:20:42.93,0:20:44.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan!
Dialogue: 0,0:20:44.96,0:20:49.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau memang harus dihukum\Nkarena berbohong,
Dialogue: 0,0:20:49.41,0:20:51.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}biar aku saja sebagai tuannya!
Dialogue: 0,0:20:52.05,0:20:53.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Ars! Jangan!
Dialogue: 0,0:20:53.53,0:20:55.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bernyali juga kamu.
Dialogue: 0,0:20:58.95,0:21:00.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Ars!
Dialogue: 0,0:21:00.28,0:21:04.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana rasanya dicambuk,\NTuan Bangsawan?
Dialogue: 0,0:21:04.68,0:21:06.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan!
Dialogue: 0,0:21:07.76,0:21:13.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berlagak sekeren apa pun,\Nsemua akan jujur setelah dicambuk.
Dialogue: 0,0:21:14.99,0:21:16.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katakan saja.
Dialogue: 0,0:21:17.37,0:21:20.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Cambuk dia, jangan aku."
Dialogue: 0,0:21:21.63,0:21:23.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul, biar aku...
Dialogue: 0,0:21:23.24,0:21:24.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cambuk aku!
Dialogue: 0,0:21:28.87,0:21:30.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu bersikeras?
Dialogue: 0,0:21:31.15,0:21:33.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanpa Rietz,
Dialogue: 0,0:21:33.48,0:21:35.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku bukan siapa-siapa.
Dialogue: 0,0:21:36.01,0:21:38.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa jadi pemimpin,
Dialogue: 0,0:21:38.77,0:21:41.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena kepercayaan orang lain!
Dialogue: 0,0:21:41.47,0:21:42.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu...
Dialogue: 0,0:21:43.29,0:21:45.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sentuh bawahanku!
Dialogue: 0,0:23:26.13,0:23:28.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten akhirnya pakai otak.
Dialogue: 0,0:23:28.18,0:23:29.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana?\NHebat, kan?
Dialogue: 0,0:23:29.61,0:23:31.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal itu sindiran.
Dialogue: 0,0:23:31.43,0:23:32.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sindiran?
Dialogue: 0,0:23:32.52,0:23:33.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bahas makanan?
Dialogue: 0,0:23:34.27,0:23:36.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belajar dari si Paman lagi sana!
Dialogue: 0,0:23:36.91,0:23:37.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya,
Dialogue: 0,0:23:37.98,0:23:39.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Hal yang Seorang Raja Butuhkan".
