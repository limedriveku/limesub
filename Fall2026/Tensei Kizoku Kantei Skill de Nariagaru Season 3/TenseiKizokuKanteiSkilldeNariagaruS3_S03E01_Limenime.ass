Dialogue: 0,0:02:33.17,0:02:36.59,sign,,0000,0000,0000,,PEMIMPIN BARU
Dialogue: 0,0:05:58.00,0:05:58.67,sign,,0000,0000,0000,,ZAT BROZD, PRIA 31 TAHUN
Dialogue: 0,0:05:58.67,0:05:59.22,sign,,0000,0000,0000,,KEPEMIMPINAN 51, KEBERANIAN 81,
Dialogue: 0,0:05:59.22,0:06:00.11,sign,,0000,0000,0000,,KEBIJAKSANAAN 71, POLITIK 70, AMBISI 56
