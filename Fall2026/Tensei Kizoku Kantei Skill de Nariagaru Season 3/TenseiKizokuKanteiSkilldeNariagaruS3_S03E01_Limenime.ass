Dialogue: 0,0:09:06.62,0:09:07.39,sign,,0000,0000,0000,,MUSHA TRICK, WANITA 16 TAHUN
Dialogue: 0,0:09:07.39,0:09:08.19,sign,,0000,0000,0000,,MUSHA TRICK, KEPEMIMPINAN 76, KEBERANIAN 41,
Dialogue: 0,0:09:08.19,0:09:08.82,sign,,0000,0000,0000,,KEBIJAKSANAAN 73, POLITIK 75, AMBISI 32
Dialogue: 0,0:09:08.82,0:09:10.43,sign,,0000,0000,0000,,INFANTERI D, KAVALERI D, MEMANAH D, SIHIR A,
Dialogue: 0,0:09:10.43,0:09:11.79,sign,,0000,0000,0000,,KONSTRUKSI D, KESENJATAAN D, ANGKATAN LAUT D,
