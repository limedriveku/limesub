Dialogue: 0,0:13:54.31,0:13:57.94,sign,,0000,0000,0000,,AS A REINCARNATED ARISTOCRAT, I'LL USE MY\NAPPRAISAL SKILL TO RISE IN THE WORLD SEASON 3
Dialogue: 0,0:13:58.36,0:14:01.95,sign,,0000,0000,0000,,AS A REINCARNATED ARISTOCRAT, I'LL USE MY\NAPPRAISAL SKILL TO RISE IN THE WORLD SEASON 3
Dialogue: 0,0:18:48.44,0:18:51.03,sign,,0000,0000,0000,,ISTANA CANARRE
Dialogue: 0,0:23:37.48,0:23:40.48,sign,,0000,0000,0000,,SELANJUTNYA: CANARRE DALAM BAHAYA
Dialogue: 0,0:00:01.85,0:00:04.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tahun 211, kalender kekaisaran.
Dialogue: 0,0:00:04.68,0:00:07.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di Provinsi Missian, Kekaisaran Summerforth.
Dialogue: 0,0:00:07.68,0:00:10.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dibunuhnya gubernur memicu sengketa
Dialogue: 0,0:00:10.90,0:00:17.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}antara kedua putranya, Cran Saremaquia\Ndan Basamarc Saremaquia.
Dialogue: 0,0:00:17.08,0:00:22.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya, meletuslah perang saudara\Nyang disebut Perang Suksesi.
Dialogue: 0,0:00:23.59,0:00:26.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ars yang bereinkarnasi dan lahir
Dialogue: 0,0:00:26.26,0:00:28.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di wilayah terpencil Lamberg
Dialogue: 0,0:00:28.97,0:00:31.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menemukan bakat-bakat terpendam
Dialogue: 0,0:00:31.45,0:00:35.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan skill penilaian\Nyang dianugerahkan padanya.
Dialogue: 0,0:00:35.82,0:00:41.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mengumpulkan rekan-rekan hebat\Ndemi membuat wilayah terkuat.
Dialogue: 0,0:00:42.43,0:00:45.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menghadapi Provinsi Seitz\Nyang bersekutu dengan Basamarc,
Dialogue: 0,0:00:45.90,0:00:51.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelompok Ars berhasil bernegosiasi\Ndengan kekaisaran dengan lancar.
Dialogue: 0,0:00:51.97,0:00:56.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perang di Samuc\Nadalah kemenangan perdana Ars.
Dialogue: 0,0:00:56.12,0:01:01.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan di Rolto, teman-teman Ars\Nmenemukan bakat mereka.
Dialogue: 0,0:01:02.14,0:01:05.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah pertemuan baru,\Nkemenangan pun diraih.
Dialogue: 0,0:01:06.74,0:01:10.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah mengalahkan Thomas,\Ntangan kanan Basamarc,
Dialogue: 0,0:01:10.21,0:01:14.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pasukan Cran berhasil menaklukkan Verzud.
Dialogue: 0,0:01:15.18,0:01:21.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkat prestasi itu,\NArs diangkat jadi Bupati Canarre.
Dialogue: 0,0:01:24.58,0:01:26.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami buka lowongan!
Dialogue: 0,0:01:26.66,0:01:29.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jenis kelamin dan status bukan masalah,
Dialogue: 0,0:01:29.49,0:01:33.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Ars mencari pejuang\Nuntuk melindungi Canarre.
Dialogue: 0,0:01:33.28,0:01:37.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang berminat, silakan daftar!
Dialogue: 0,0:01:41.79,0:01:46.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, ternyata sudah sejauh itu.
Dialogue: 0,0:01:46.00,0:01:51.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebentar lagi, pasukan Tuan Cran\Npasti tiba di Arcantez.
Dialogue: 0,0:01:52.37,0:01:58.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak Anda memang luar biasa\Nbisa mengalahkan Thomas.
Dialogue: 0,0:01:58.88,0:02:02.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari dulu, keahliannya cuma kekerasan.
Dialogue: 0,0:02:09.57,0:02:13.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kirim kuda untuk memeriksa\Nkekuatan tempur mereka.
Dialogue: 0,0:02:13.36,0:02:16.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pakai kuda yang kuat melewati gunung.
Dialogue: 0,0:02:22.13,0:02:26.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beri hormat untuk Tuan Ars, Bupati Canarre!
Dialogue: 0,0:02:27.17,0:02:29.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah diangkat jadi bupati,
Dialogue: 0,0:02:29.81,0:02:33.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku pindah dari Lamberg ke Canarre.
Dialogue: 0,0:02:34.59,0:02:36.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, jangan petakilan!
Dialogue: 0,0:02:38.66,0:02:41.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kamar ini boleh buatku...
Dialogue: 0,0:02:41.65,0:02:44.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, siapa cepat dia dapat.
Dialogue: 0,0:02:46.37,0:02:48.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau kamar ini...
Dialogue: 0,0:02:49.46,0:02:50.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luas banget!
Dialogue: 0,0:02:50.24,0:02:51.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kasurku di sini!
Dialogue: 0,0:02:51.87,0:02:54.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ih, curang!
Dialogue: 0,0:02:55.50,0:02:58.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini kamarku, titik!
Dialogue: 0,0:02:58.43,0:03:00.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, kebetulan.
Dialogue: 0,0:03:01.26,0:03:03.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong urus aku, ya.
Dialogue: 0,0:03:03.52,0:03:05.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si-Sial banget.
Dialogue: 0,0:03:06.00,0:03:09.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada gudang anggur, mantap!
Dialogue: 0,0:03:16.47,0:03:21.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Ini jauh lebih luas dari di Lamberg,\Nsudah kayak labirin.
Dialogue: 0,0:03:21.34,0:03:24.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ars! Ini enak, lo!
Dialogue: 0,0:03:26.03,0:03:27.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Roti dari mana itu?
Dialogue: 0,0:03:27.74,0:03:31.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak-anak panti buka toko roti.
Dialogue: 0,0:03:31.07,0:03:32.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya sehat.
Dialogue: 0,0:03:32.94,0:03:36.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka tambah besar\Nsejak terakhir kita bertemu.
Dialogue: 0,0:03:36.21,0:03:38.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, mereka?
Dialogue: 0,0:03:42.98,0:03:46.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rietz, bisa tolong panggil yang lain?
Dialogue: 0,0:03:46.58,0:03:48.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin bicara.
Dialogue: 0,0:03:49.55,0:03:52.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi ada apa?
Dialogue: 0,0:03:52.21,0:03:56.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin salah satu dari kalian\Njadi pemimpin Lamberg.
Dialogue: 0,0:03:57.41,0:04:03.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perlu ada yang mengurus Lamberg\Nmenggantikan Tuan Ars, ya?
Dialogue: 0,0:04:03.99,0:04:06.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau pilih siapa?
Dialogue: 0,0:04:06.18,0:04:08.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku tidak akan bisa!
Dialogue: 0,0:04:08.77,0:04:12.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin Mireille jadi pemimpin di sana.
Dialogue: 0,0:04:12.22,0:04:14.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? A-Aku?
Dialogue: 0,0:04:14.19,0:04:18.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena menguasai militer dan politik,\Nkamu orang yang cocok.
Dialogue: 0,0:04:18.37,0:04:21.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, cuma Kakak yang bisa!
Dialogue: 0,0:04:21.08,0:04:23.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pejabat wanita, keren!
Dialogue: 0,0:04:23.41,0:04:27.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jujur aku lebih nyaman kayak sekarang, sih.
Dialogue: 0,0:04:27.86,0:04:29.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku setuju saja.
Dialogue: 0,0:04:29.62,0:04:32.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kurang paham, tapi sepertinya bagus.
Dialogue: 0,0:04:32.80,0:04:34.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan yakin?
Dialogue: 0,0:04:34.80,0:04:39.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dilihat dari kebiasaan saja,\Ndia jauh berbeda denganmu.
Dialogue: 0,0:04:40.22,0:04:44.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja, dia pasti bekerja dengan baik.
Dialogue: 0,0:04:44.54,0:04:47.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hubungannya dengan warga juga baik.
Dialogue: 0,0:04:47.78,0:04:51.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu banyak membantuku\Ndi perang sebelumnya.
Dialogue: 0,0:04:51.19,0:04:54.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma kamu yang bisa kupercayakan.
Dialogue: 0,0:04:54.98,0:04:56.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bersedia?
Dialogue: 0,0:05:00.35,0:05:03.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa boleh buat kalau sebegitunya.
Dialogue: 0,0:05:03.82,0:05:06.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sip, sudah diputuskan!
Dialogue: 0,0:05:06.08,0:05:08.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan benar-benar yakin?
Dialogue: 0,0:05:08.96,0:05:12.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, saatnya serah terima pekerjaan.
Dialogue: 0,0:05:12.46,0:05:17.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Nak, boleh kupikir-pikir dulu?
Dialogue: 0,0:05:17.02,0:05:19.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak akan lama, kok.
Dialogue: 0,0:05:19.62,0:05:23.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, rapatnya sudah selesai.
Dialogue: 0,0:05:23.10,0:05:26.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi membuat Canarre jadi lebih baik,
Dialogue: 0,0:05:26.88,0:05:28.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mohon bantuan kalian.
Dialogue: 0,0:05:28.81,0:05:30.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:05:30.22,0:05:33.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktunya latihan!
Dialogue: 0,0:05:33.22,0:05:36.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sisa anggurnya diapakan, ya...
Dialogue: 0,0:05:36.66,0:05:40.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya, bagaimana kabar dua orang\Nyang baru kurekrut?
Dialogue: 0,0:05:41.10,0:05:44.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eng, soal itu...
Dialogue: 0,0:05:44.20,0:05:47.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, tapi aku mau berhenti.
Dialogue: 0,0:05:48.10,0:05:50.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah jadi bupati Canarre,
Dialogue: 0,0:05:50.18,0:05:54.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku merekrut dan mendapat dua orang baru.
Dialogue: 0,0:05:55.12,0:05:58.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang ini salah satunya, Zat Brozd.
Dialogue: 0,0:05:58.00,0:06:00.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Petarung andal yang malang melintang
Dialogue: 0,0:06:00.11,0:06:01.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di Kekaisaran Summerforth
Dialogue: 0,0:06:01.26,0:06:03.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebagai pemburu hadiah dan tentara bayaran.
Dialogue: 0,0:06:04.02,0:06:04.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keberanian,
Dialogue: 0,0:06:04.97,0:06:06.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kebijaksanaan,
Dialogue: 0,0:06:06.47,0:06:08.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan nilai politiknya cukup tinggi.
Dialogue: 0,0:06:08.97,0:06:10.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:06:10.53,0:06:14.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak puas dijadikan\Nwakil kapten pasukan elite?
Dialogue: 0,0:06:14.48,0:06:18.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru aku senang dengan posisi itu, tapi...
Dialogue: 0,0:06:18.56,0:06:20.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Zat!
Dialogue: 0,0:06:21.44,0:06:25.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sini duel sama kaptenmu!
Dialogue: 0,0:06:26.29,0:06:27.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo!
Dialogue: 0,0:06:28.02,0:06:30.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dua dekade lamanya aku\Ndi medan tempur sejak usia 10.
Dialogue: 0,0:06:30.91,0:06:33.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski mau mengabdi untuk Canarre,
Dialogue: 0,0:06:33.30,0:06:36.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tidak sudi jadi bawahan si bodoh ini!
Dialogue: 0,0:06:36.46,0:06:39.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Mana orang bodohnya?
Dialogue: 0,0:06:40.18,0:06:42.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Intinya, aku mengundurkan diri.
Dialogue: 0,0:06:42.32,0:06:46.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tu-Tunggu!\NTolong pertimbangkan lagi!
Dialogue: 0,0:06:46.48,0:06:49.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami membutuhkanmu!
Dialogue: 0,0:06:49.89,0:06:53.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya sudah, Rietz, jadikan aku bawahanmu.
Dialogue: 0,0:06:53.89,0:06:55.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau atasan yang bisa kompromi.
Dialogue: 0,0:06:55.85,0:06:58.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bukan kapten.
Dialogue: 0,0:07:00.80,0:07:03.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata memang sia-sia.
Dialogue: 0,0:07:03.09,0:07:04.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zat.
Dialogue: 0,0:07:05.07,0:07:08.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini pedang kayumu, ayo bertarung.
Dialogue: 0,0:07:08.53,0:07:10.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak mendengarkan, ya?
Dialogue: 0,0:07:10.80,0:07:11.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu!
Dialogue: 0,0:07:12.54,0:07:15.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cobalah bertarung dengan Braham.
Dialogue: 0,0:07:15.94,0:07:22.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bisa mengalahkan sang kapten,\Nposisimu akan kami evaluasi.
Dialogue: 0,0:07:23.18,0:07:24.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:07:28.89,0:07:32.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil aku kalah dari orang bodoh ini.
Dialogue: 0,0:07:33.65,0:07:35.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kutunjukkan jauhnya
Dialogue: 0,0:07:35.83,0:07:37.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pengalaman kami.
Dialogue: 0,0:07:45.60,0:07:47.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menang.
Dialogue: 0,0:07:47.20,0:07:50.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia kuat sekali!
Dialogue: 0,0:07:50.20,0:07:56.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah belajar dari Rietz, Braham makin kuat\Nhanya dalam beberapa bulan.
Dialogue: 0,0:07:56.37,0:07:59.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sama pentingnya dengan Zat.
Dialogue: 0,0:08:00.35,0:08:03.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski bertolak belakang,
Dialogue: 0,0:08:03.06,0:08:06.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku merasa kalian bisa saling melengkapi.
Dialogue: 0,0:08:07.09,0:08:12.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zat, maukah kamu menopang Braham\Nsebagai wakil kaptennya?
Dialogue: 0,0:08:16.88,0:08:20.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, aku bersedia.
Dialogue: 0,0:08:21.18,0:08:23.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang!\NMohon kerja samanya!
Dialogue: 0,0:08:23.74,0:08:25.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:08:25.98,0:08:28.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa dia dipasangkan dengan Braham?
Dialogue: 0,0:08:28.80,0:08:31.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Potensi kepemimpinan Braham
Dialogue: 0,0:08:31.53,0:08:34.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bahkan bisa melampauimu.
Dialogue: 0,0:08:34.08,0:08:36.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi dia butuh bimbingan.
Dialogue: 0,0:08:36.78,0:08:38.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah tugas Zat.
Dialogue: 0,0:08:38.82,0:08:42.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bersama Zat yang cerdas\Ndan berpengalaman,
Dialogue: 0,0:08:42.66,0:08:46.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia bisa jadi panglima besar!
Dialogue: 0,0:08:46.05,0:08:48.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi Braham harus diakui dulu.
Dialogue: 0,0:08:48.88,0:08:50.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be-Betul.
Dialogue: 0,0:08:55.33,0:08:56.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tu-Tuan Ars!
Dialogue: 0,0:08:56.72,0:08:58.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Musha, kamu baik-baik saja?
Dialogue: 0,0:08:58.77,0:09:01.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku!
Dialogue: 0,0:09:01.71,0:09:06.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia rekrutan baru yang satu lagi,\NMusha Trick.
Dialogue: 0,0:09:06.62,0:09:08.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia gadis desa pinggiran Canarre
Dialogue: 0,0:09:08.82,0:09:11.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang daftar untuk bidang administrasi.
Dialogue: 0,0:09:11.79,0:09:13.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi ternyata,
Dialogue: 0,0:09:13.12,0:09:15.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia punya bakat terpendam.
Dialogue: 0,0:09:15.62,0:09:18.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Musha, sekarang giliranmu.
Dialogue: 0,0:09:18.25,0:09:21.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baik!
Dialogue: 0,0:09:24.05,0:09:25.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu baik-baik saja?
Dialogue: 0,0:09:32.42,0:09:35.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bidik target
Dialogue: 0,0:09:35.14,0:09:38.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu rapalkan mantra.
Dialogue: 0,0:09:38.14,0:09:41.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo? Aku lupa mantranya.
Dialogue: 0,0:09:41.14,0:09:44.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fo-Forma...
Dialogue: 0,0:09:44.82,0:09:46.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa.
Dialogue: 0,0:09:48.40,0:09:50.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, tenanglah.
Dialogue: 0,0:09:50.75,0:09:52.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cha-Charlotte?
Dialogue: 0,0:09:53.70,0:09:57.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ingat, jangan lihat targetnya kalau gugup.
Dialogue: 0,0:09:57.71,0:09:58.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tutup saja matamu.
Dialogue: 0,0:10:00.82,0:10:03.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang penting konsentrasi dulu.
Dialogue: 0,0:10:03.89,0:10:05.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba lakukan.
Dialogue: 0,0:10:10.82,0:10:12.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Forma.
Dialogue: 0,0:10:12.72,0:10:14.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Igni.
Dialogue: 0,0:10:14.55,0:10:15.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Erupt!
Dialogue: 0,0:10:18.31,0:10:19.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dahsyat sekali!
Dialogue: 0,0:10:19.81,0:10:24.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luar biasa!\NPantas saja kamu dipilih ketua kami!
Dialogue: 0,0:10:31.24,0:10:34.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, parah.
Dialogue: 0,0:10:34.20,0:10:39.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat takjub waktu Charlotte\Npertama kali memakai sihir.
Dialogue: 0,0:10:39.87,0:10:41.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama seperti sekarang.
Dialogue: 0,0:10:42.59,0:10:46.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski sifatnya kurang cocok dalam perang,
Dialogue: 0,0:10:46.16,0:10:49.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau dia mulai terbiasa\Ndan dipadukan dengan Charlotte...
Dialogue: 0,0:10:50.30,0:10:54.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemungkinan kita akan punya\Npasukan sihir terbaik di Missian.
Dialogue: 0,0:10:54.69,0:10:57.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami punya banyak orang hebat.
Dialogue: 0,0:10:57.49,0:11:01.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Canarre pasti mengalami perubahan besar.
Dialogue: 0,0:11:04.77,0:11:06.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, Tuan Ars.
Dialogue: 0,0:11:06.77,0:11:09.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sedang bekerja?
Dialogue: 0,0:11:09.15,0:11:11.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, biar kubantu.
Dialogue: 0,0:11:12.46,0:11:15.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma membaca berkas bupati sebelumnya.
Dialogue: 0,0:11:15.89,0:11:21.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Lemaire dan Tuan Menas mencatat\Ninformasi Canarre secara detail.
Dialogue: 0,0:11:21.41,0:11:26.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skala sebesar ini membuat Lamberg\Nserasa sangat kecil.
Dialogue: 0,0:11:26.66,0:11:30.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyusun anggaran akan lebih mudah pakai ini.
Dialogue: 0,0:11:30.10,0:11:36.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya Ayah dan Tuan Klar segera dikabari\Nsoal rencana kebijakan kita.
Dialogue: 0,0:11:36.70,0:11:38.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setuju.
Dialogue: 0,0:11:39.68,0:11:43.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia selalu bisa diandalkan.
Dialogue: 0,0:11:43.18,0:11:44.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya.
Dialogue: 0,0:11:45.52,0:11:49.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada surat untukmu dari Lamberg.
Dialogue: 0,0:11:49.42,0:11:51.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari Ann si kepala maid?
Dialogue: 0,0:11:55.28,0:12:01.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Ars, maaf mengirim surat\Nmeski Anda baru pindah ke Canarre.
Dialogue: 0,0:12:01.58,0:12:06.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi takutnya Krantz si pelayan\Nkepalang tumbang.
Dialogue: 0,0:12:06.66,0:12:12.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini soal Shin Seimaro yang Tuan Ars\Nundang ke Lamberg.
Dialogue: 0,0:12:15.09,0:12:19.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Shin, kali ini apa lagi?
Dialogue: 0,0:12:24.47,0:12:26.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gu-Gudangnya...
Dialogue: 0,0:12:31.84,0:12:33.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi-lagi gagal.
Dialogue: 0,0:12:33.74,0:12:36.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi tenang, selanjutnya pasti berhasil.
Dialogue: 0,0:12:36.42,0:12:37.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:12:37.97,0:12:42.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penelitian Tuan Shin mengacaukan\Nkeuangan Keluarga Louvent.
Dialogue: 0,0:12:42.75,0:12:47.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Krantz sebagai pengurus keuangan, tiap hari\Nmengejar Tuan Shin dengan wajah merah.
Dialogue: 0,0:12:47.89,0:12:51.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku takut pembuluh darahnya pecah.
Dialogue: 0,0:12:53.50,0:12:59.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga melampirkan laporan\Nhasil penelitian Tuan Shin.
Dialogue: 0,0:12:59.79,0:13:02.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski Krantz terus mengeluh,
Dialogue: 0,0:13:02.64,0:13:08.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku merasa terbantu karena sumurnya\Njadi bisa menimba otomatis.
Dialogue: 0,0:13:08.77,0:13:11.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini kapal?
Dialogue: 0,0:13:11.06,0:13:13.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari siapkan anggaran tambahan.
Dialogue: 0,0:13:13.38,0:13:17.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Krantz tumbang,\NKeluarga Louvent bisa gawat.
Dialogue: 0,0:13:17.46,0:13:23.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Ars sangat yakin Shin bisa membuat\Nkapal yang melayang di udara, ya?
Dialogue: 0,0:13:23.46,0:13:26.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gagal itu wajar dalam mencoba.
Dialogue: 0,0:13:26.03,0:13:32.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kalau berhasil,\Nteknologinya akan memudahkan kita.
Dialogue: 0,0:13:32.00,0:13:34.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan Shin itu orang baik.
Dialogue: 0,0:13:35.54,0:13:37.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Ars tidak pernah berubah.
Dialogue: 0,0:13:37.55,0:13:40.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Be-Benarkah?
Dialogue: 0,0:13:40.19,0:13:42.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku tambah tinggi.
Dialogue: 0,0:13:42.70,0:13:44.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu.
Dialogue: 0,0:13:44.43,0:13:46.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok tahu?
Dialogue: 0,0:13:46.83,0:13:49.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapan kamu mengukurnya?
Dialogue: 0,0:13:49.39,0:13:50.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rahasia.
Dialogue: 0,0:13:50.81,0:13:53.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Kok rahasia?
Dialogue: 0,0:14:01.95,0:14:05.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ars, aku membawakan makanan.
Dialogue: 0,0:14:05.95,0:14:09.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkas perbaikan jalan utama sudah kususun!\NMohon ditandatangani!
Dialogue: 0,0:14:09.91,0:14:12.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada berkas dari serikat dagang!
Dialogue: 0,0:14:12.50,0:14:15.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Poin pentingnya sudah kucatat,\Ntolong diperiksa!
Dialogue: 0,0:14:15.33,0:14:17.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baik!
Dialogue: 0,0:14:18.62,0:14:19.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak apa-apa?
Dialogue: 0,0:14:19.81,0:14:21.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Charlotte!
Dialogue: 0,0:14:21.26,0:14:22.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku membawakan makanan.
Dialogue: 0,0:14:22.95,0:14:24.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih!
Dialogue: 0,0:14:44.27,0:14:46.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian terlalu sibuk.
Dialogue: 0,0:14:46.97,0:14:49.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Istirahatlah sebentar.
Dialogue: 0,0:14:49.12,0:14:53.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aman, aku dibantu oleh dua orang cekatan.
Dialogue: 0,0:14:53.62,0:14:57.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku khawatir melihatmu belakangan ini.
Dialogue: 0,0:14:57.74,0:15:00.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu khawatir padaku?
Dialogue: 0,0:15:00.00,0:15:03.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu-Bukan begitu.
Dialogue: 0,0:15:03.74,0:15:07.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rietz, bagaimana kabar rencana yang itu?
Dialogue: 0,0:15:07.14,0:15:09.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lancar jaya.
Dialogue: 0,0:15:09.18,0:15:12.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Material berkasnya sudah terkumpul.
Dialogue: 0,0:15:12.64,0:15:16.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rencana yang itu?\NYang mana?
Dialogue: 0,0:15:16.22,0:15:17.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Charlotte.
Dialogue: 0,0:15:17.97,0:15:19.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita keliling kota, yuk.
Dialogue: 0,0:15:24.85,0:15:27.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ramai seperti biasa, ya.
Dialogue: 0,0:15:27.26,0:15:31.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak orang dan banyak barang,\Nbeginilah pusat kota.
Dialogue: 0,0:15:31.78,0:15:33.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:15:36.59,0:15:41.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesenjangan sosial di Canarre\Nlebih parah dari Lamberg.
Dialogue: 0,0:15:41.46,0:15:44.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makin banyak warga miskin.
Dialogue: 0,0:15:44.30,0:15:45.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok bisa?
Dialogue: 0,0:15:45.30,0:15:49.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bukan karena kebijakan Tuan Lemaire.
Dialogue: 0,0:15:49.62,0:15:51.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini akibat perang.
Dialogue: 0,0:15:51.50,0:15:56.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kita menang,\Nkenapa mereka jadi miskin?
Dialogue: 0,0:15:56.54,0:15:58.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena direkrut untuk perang,
Dialogue: 0,0:15:59.36,0:16:02.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}para petani kekurangan orang.
Dialogue: 0,0:16:03.30,0:16:07.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para petani menjual lahannya\Nkarena tidak sanggup mengelola.
Dialogue: 0,0:16:07.76,0:16:10.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya mereka jadi buruh tani.
Dialogue: 0,0:16:10.87,0:16:14.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang pemasukannya berkurang\Ndan sulit bayar pajak
Dialogue: 0,0:16:14.91,0:16:17.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}merantau ke Canarre demi mencari kerja.
Dialogue: 0,0:16:17.87,0:16:21.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi mereka gagal dan jadi gelandangan.
Dialogue: 0,0:16:21.18,0:16:25.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengetahuinya setelah menelaah\Ncatatan yang ada.
Dialogue: 0,0:16:25.63,0:16:28.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dibiarkan, pajak kita akan berkurang,
Dialogue: 0,0:16:28.27,0:16:31.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kesenjangan sosial meluas,\Ndan makin marak kejahatan.
Dialogue: 0,0:16:31.44,0:16:34.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski menang perang, ini tidak bagus.
Dialogue: 0,0:16:34.64,0:16:38.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya, kita butuh langkah yang berani.
Dialogue: 0,0:16:51.70,0:16:57.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akan memangkas besar-besaran pajak\Nyang membebani kebutuhan hidup rakyat.
Dialogue: 0,0:16:58.00,0:17:00.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rakyat miskin akan diberi lahan
Dialogue: 0,0:17:00.78,0:17:02.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk bertani.
Dialogue: 0,0:17:02.45,0:17:05.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan mereka harus jadi prajurit saat perang.
Dialogue: 0,0:17:06.00,0:17:08.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski pendapatan berkurang,
Dialogue: 0,0:17:08.09,0:17:12.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ke depannya akan meningkat\Nasal daya produksi kita bertambah.
Dialogue: 0,0:17:12.29,0:17:15.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menambah pasokan prajurit pula.
Dialogue: 0,0:17:15.01,0:17:16.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:17:16.72,0:17:20.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buat apa kamu bertempur?
Dialogue: 0,0:17:20.09,0:17:23.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin buat kamu.
Dialogue: 0,0:17:23.11,0:17:27.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan buat anak-anak panti.
Dialogue: 0,0:17:27.10,0:17:32.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, aku dan kamu berjuang\Ndemi melindungi sesuatu.
Dialogue: 0,0:17:33.25,0:17:38.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau punya tanah, hidup dengan layak,\Ndan punya rasa bangga,
Dialogue: 0,0:17:38.46,0:17:42.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}orang-orang yang di sini pun akan berjuang.
Dialogue: 0,0:17:42.62,0:17:45.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu pertama kali ke Canarre,
Dialogue: 0,0:17:45.30,0:17:49.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku berniat memberi tempat bernaung\Nbagi para orang tidak berdaya.
Dialogue: 0,0:17:50.54,0:17:57.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, saat itu aku belum tahu\Nbagaimana caranya.
Dialogue: 0,0:17:57.94,0:18:00.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya aku tahu setelah menjabat.
Dialogue: 0,0:18:01.63,0:18:05.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka akan kubuat mencintai Canarre.
Dialogue: 0,0:18:05.15,0:18:10.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cinta bisa memperkuat rakyat\Ndan memakmurkan wilayah.
Dialogue: 0,0:18:10.64,0:18:14.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kubuat semua orang\Nbisa hidup lebih baik di sini.
Dialogue: 0,0:18:14.11,0:18:18.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gila!\NSungguh hebat kalau semuanya bahagia!
Dialogue: 0,0:18:18.53,0:18:20.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rencanamu keren!
Dialogue: 0,0:18:21.00,0:18:24.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang akan tambah sibuk, sih.
Dialogue: 0,0:18:24.08,0:18:29.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku bersemangat\Nkarena makin dekat dengan mimpiku.
Dialogue: 0,0:18:30.26,0:18:34.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski bikin khawatir, aku ingin berusaha.
Dialogue: 0,0:18:35.55,0:18:39.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar, kamu memang kepala batu\Nkalau punya kemauan.
Dialogue: 0,0:18:39.65,0:18:41.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dukung, tapi...
Dialogue: 0,0:18:42.43,0:18:45.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minimal kita harus kumpul\Nkalau waktunya makan!
Dialogue: 0,0:18:45.71,0:18:47.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, betul.
Dialogue: 0,0:18:51.47,0:18:55.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf lama, Nak.
Dialogue: 0,0:18:55.54,0:18:59.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dipikir-pikir, posisi itu memang vital
Dialogue: 0,0:18:59.78,0:19:02.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan cuma aku yang cocok.
Dialogue: 0,0:19:03.33,0:19:04.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Nak.
Dialogue: 0,0:19:04.66,0:19:08.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutmu seperti apa pemimpin yang ideal?
Dialogue: 0,0:19:08.88,0:19:10.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuat?
Dialogue: 0,0:19:10.17,0:19:14.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menarik? Ahli strategi?
Dialogue: 0,0:19:15.06,0:19:20.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski tidak punya semua itu,\Nmenurutmu kamu cocok jadi pemimpin.
Dialogue: 0,0:19:20.48,0:19:22.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kriteriamu?
Dialogue: 0,0:19:22.06,0:19:25.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang bisa dipercaya.
Dialogue: 0,0:19:25.98,0:19:30.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin siapa pun bisa saja menggantikanku.
Dialogue: 0,0:19:32.06,0:19:37.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan kalau bersamamu, jalanku pasti lancar.
Dialogue: 0,0:19:38.00,0:19:42.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi karena itulah, Lamberg yang berharga\Ningin kupercayakan padamu.
Dialogue: 0,0:19:43.87,0:19:48.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, berarti aku juga harus jadi seperti itu.
Dialogue: 0,0:19:49.34,0:19:52.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rosell, aku tahu kamu di situ.
Dialogue: 0,0:19:53.71,0:19:58.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu penasaran sama jawabanku?
Dialogue: 0,0:19:58.11,0:20:03.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ha-Habisnya, kita akan berpisah\Nkalau Guru ke Lamberg.
Dialogue: 0,0:20:03.95,0:20:07.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal banyak yang belum kupelajari.
Dialogue: 0,0:20:09.17,0:20:11.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Makanya...
Dialogue: 0,0:20:12.50,0:20:13.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memercayaimu.
Dialogue: 0,0:20:14.22,0:20:18.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah waktu itu kamu bisa\Nmelampaui strategiku?
Dialogue: 0,0:20:19.04,0:20:21.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanpa aku pun,
Dialogue: 0,0:20:21.32,0:20:23.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu bisa berkembang.
Dialogue: 0,0:20:24.35,0:20:26.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan jadi ahli strategi hebat
Dialogue: 0,0:20:26.83,0:20:29.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang kecerdikannya mengejutkanmu.
Dialogue: 0,0:20:29.47,0:20:32.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan berusaha membantu Tuan Ars!\NMaka dari itu...
Dialogue: 0,0:20:33.44,0:20:37.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guru juga harus berusaha.
Dialogue: 0,0:20:37.81,0:20:41.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja, di sana akan kubuat sangat maju.
Dialogue: 0,0:20:42.59,0:20:47.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Ars, meninggalkan Lamberg\Nterasa berat, ya?
Dialogue: 0,0:20:47.63,0:20:49.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak juga.
Dialogue: 0,0:20:49.78,0:20:54.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya orang-orang Lamberg\Nselalu terasa dekat di hati.
Dialogue: 0,0:20:55.22,0:20:58.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi Mireille juga,\Naku akan melindungi Anda.
Dialogue: 0,0:20:58.66,0:21:01.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, mohon bantuannya.
Dialogue: 0,0:21:01.53,0:21:06.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bermula dari Rietz,\Naku dianugerahi banyak pengikut.
Dialogue: 0,0:21:06.69,0:21:12.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka ahli di bidang masing-masing\Ndan berkembang tanpa henti.
Dialogue: 0,0:21:12.51,0:21:16.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para pengikut Keluarga Louvent memang hebat.
Dialogue: 0,0:21:16.30,0:21:18.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga harus berusaha.
Dialogue: 0,0:21:18.61,0:21:19.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Ars!
Dialogue: 0,0:21:20.82,0:21:22.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:21:22.42,0:21:24.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini pesan dari tuan kami, Kral.
Dialogue: 0,0:21:27.63,0:21:28.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Ars.
Dialogue: 0,0:21:30.26,0:21:34.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Provinsi Seitz sedang menuju Canarre\Ndengan 80.000 pasukan!
Dialogue: 0,0:21:47.79,0:21:53.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari bicarakan setelah Canarre\Nberhasil kita taklukkan.
Dialogue: 0,0:23:26.09,0:23:28.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rosell, kamu sudah dapat kamar?
Dialogue: 0,0:23:28.76,0:23:31.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, kamarnya luas dan nyaman.
Dialogue: 0,0:23:31.93,0:23:35.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti, itu akan jadi kamarku juga!
Dialogue: 0,0:23:35.60,0:23:37.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ja-Jangan, dong!
Dialogue: 0,0:23:37.48,0:23:40.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya, "Canarre dalam Bahaya".
