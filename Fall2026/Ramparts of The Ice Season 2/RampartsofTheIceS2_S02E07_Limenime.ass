Dialogue: 0,0:00:29.27,0:00:32.69,sign,,0000,0000,0000,,{\an8}‎MOMOKA - HARI INI\N‎LAMA TAK JUMPA
Dialogue: 0,0:02:26.60,0:02:30.94,sign,,0000,0000,0000,,‎EPISODE 21\N‎KESALAHPAHAMAN
Dialogue: 0,0:03:04.55,0:03:05.64,sign,,0000,0000,0000,,‎MATSURI - ONDO NO MASTER
Dialogue: 0,0:04:54.00,0:04:55.25,sign,,0000,0000,0000,,‎TUNJUKKAN SESUATU, APA PUN
Dialogue: 0,0:04:55.25,0:04:56.33,sign,,0000,0000,0000,,‎AKU TAHU KAU TAK SENANG DENGAN INI
Dialogue: 0,0:04:58.75,0:05:00.13,sign,,0000,0000,0000,,‎SOK SUCI\N‎SEOLAH DIRINYA PALING BENAR
Dialogue: 0,0:05:00.13,0:05:01.21,sign,,0000,0000,0000,,‎MEMBUAT BERBAGAI MACAM TEORI
Dialogue: 0,0:05:25.40,0:05:26.49,sign,,0000,0000,0000,,‎AKU CUMA ORANG YANG DIA PACARI
Dialogue: 0,0:05:36.66,0:05:37.83,sign,,0000,0000,0000,,‎YANG MEMBUATKU KHAWATIR...
Dialogue: 0,0:05:45.17,0:05:46.97,sign,,0000,0000,0000,,‎AKU JELAS
Dialogue: 0,0:05:46.97,0:05:48.05,sign,,0000,0000,0000,,‎LEBIH MENYUKAINYA
Dialogue: 0,0:08:42.85,0:08:44.06,sign,,0000,0000,0000,,‎HEH
Dialogue: 0,0:10:59.32,0:11:01.24,sign,,0000,0000,0000,,‎CEMBERUT...
Dialogue: 0,0:11:30.98,0:11:31.98,sign,,0000,0000,0000,,{\an8}‎MEMANG BENAR, TAPI...
Dialogue: 0,0:12:15.35,0:12:16.56,sign,,0000,0000,0000,,‎SILAKAN\N‎TAK APA
Dialogue: 0,0:13:10.03,0:13:12.24,sign,,0000,0000,0000,,{\an8}‎DEJAVU...
Dialogue: 0,0:14:29.99,0:14:31.07,sign,,0000,0000,0000,,‎HA...
Dialogue: 0,0:19:06.81,0:19:08.73,sign,,0000,0000,0000,,{\an8}‎TAK TAHAN DENGAN KEADAAN\N‎JIWA PEMBERONTAK
Dialogue: 0,0:19:40.67,0:19:41.68,sign,,0000,0000,0000,,‎MEMUJI DIRI SENDIRI
Dialogue: 0,0:00:12.01,0:00:15.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kami sudah lama bersiap\N‎dan berlatih untuk festival budaya,{\i0}
Dialogue: 0,0:00:16.26,0:00:18.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎sampai akhirnya selesai begitu saja.{\i0}
Dialogue: 0,0:00:18.76,0:00:20.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau sudah bawa karpetnya pulang?
Dialogue: 0,0:00:20.89,0:00:22.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak bisa kubawa pulang.
Dialogue: 0,0:00:22.73,0:00:24.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- {\i1}‎Dan keesokan harinya...{\i0}\N‎- Sayang sekali.
Dialogue: 0,0:00:34.20,0:00:35.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf tiba-tiba menghubungimu.
Dialogue: 0,0:00:36.36,0:00:38.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku ingin bicara denganmu, Koyun.
Dialogue: 0,0:00:40.95,0:00:42.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya. Aku juga.
Dialogue: 0,0:00:45.17,0:00:46.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau mau bicarakan apa?
Dialogue: 0,0:00:47.54,0:00:49.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku akan terus terang.
Dialogue: 0,0:00:49.54,0:00:52.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku mau kau menjauhi Minato.
Dialogue: 0,0:02:32.61,0:02:36.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku sadar\N‎aku sering menyangkal diriku sendiri.{\i0}
Dialogue: 0,0:02:37.61,0:02:40.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku terus bilang dia bukan ancaman,{\i0}
Dialogue: 0,0:02:40.41,0:02:43.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎tapi aku tak tahan dengan keberadaannya.{\i0}
Dialogue: 0,0:02:44.78,0:02:46.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku membencinya.{\i0}
Dialogue: 0,0:02:47.37,0:02:49.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku sudah tanya berkali-kali.{\i0}
Dialogue: 0,0:02:50.71,0:02:52.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kalau dia benar-benar menyukai Minato,{\i0}
Dialogue: 0,0:02:52.83,0:02:55.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎seharusnya dia mempertahankannya.{\i0}
Dialogue: 0,0:02:56.30,0:02:58.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tidak sopan jika mendekatinya sekarang.{\i0}
Dialogue: 0,0:02:59.30,0:03:00.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎- Itu menjijikkan...{\i0}\N‎- Baik.
Dialogue: 0,0:03:02.30,0:03:04.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Aku akan menjauhi Amamiya.
Dialogue: 0,0:03:05.64,0:03:10.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kau tak suka kami main bersama\N‎meskipun berkelompok, 'kan?{\i0}
Dialogue: 0,0:03:11.23,0:03:14.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Atau kau mau aku putus hubungan dengannya?
Dialogue: 0,0:03:15.69,0:03:17.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Soal itu...
Dialogue: 0,0:03:18.15,0:03:21.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kami masih harus bicara\N‎karena berada di kelas yang sama,
Dialogue: 0,0:03:21.61,0:03:23.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎jadi mungkin akan sulit.
Dialogue: 0,0:03:24.03,0:03:26.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak mau bersikap tak sopan.
Dialogue: 0,0:03:26.33,0:03:31.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi soal tidak sopan atau bukan,\N‎itu tergantung padamu dan Amamiya.
Dialogue: 0,0:03:32.08,0:03:34.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tergantung pada Minato?{\i0}
Dialogue: 0,0:03:34.33,0:03:39.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kau bilang begitu\N‎karena kau yakin dia akan memilihmu?{\i0}
Dialogue: 0,0:03:39.96,0:03:41.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kenapa dengannya?{\i0}
Dialogue: 0,0:03:41.59,0:03:43.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sikapnya seolah ini bukan masalah besar.{\i0}
Dialogue: 0,0:03:45.05,0:03:46.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku pacar Minato.{\i0}
Dialogue: 0,0:03:47.31,0:03:48.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Akulah yang menghalanginya.{\i0}
Dialogue: 0,0:03:50.81,0:03:53.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau benar-benar setuju begitu saja?
Dialogue: 0,0:03:54.94,0:03:57.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tahu kau selalu menyangkalnya,
Dialogue: 0,0:03:58.52,0:04:00.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎tapi kau suka Minato, 'kan?
Dialogue: 0,0:04:01.69,0:04:06.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku menyukainya atau tidak,\N‎tak ada hubungannya dengan kalian.
Dialogue: 0,0:04:07.03,0:04:08.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Amamiya itu pacarmu.
Dialogue: 0,0:04:09.49,0:04:11.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia memilihmu.
Dialogue: 0,0:04:12.87,0:04:16.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf kalau ada tindakanku\N‎yang membuatmu salah paham,
Dialogue: 0,0:04:16.58,0:04:21.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎tapi sejak Amamiya berpacaran denganmu,
Dialogue: 0,0:04:21.05,0:04:24.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎dia hanya memperlakukanku sebagai teman.
Dialogue: 0,0:04:25.47,0:04:28.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kurasa dia serius dalam hubungan kalian.
Dialogue: 0,0:04:29.76,0:04:33.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku dan Amamiya cuma teman.{\i0}
Dialogue: 0,0:04:34.31,0:04:36.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kalau kau masih tak memercayaiku,
Dialogue: 0,0:04:36.73,0:04:40.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎aku akan menjauhinya selama yang kau mau.
Dialogue: 0,0:04:41.61,0:04:44.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Tolong percayalah pada Amamiya.
Dialogue: 0,0:04:47.16,0:04:48.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kenapa?{\i0}
Dialogue: 0,0:04:49.20,0:04:52.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Kutanya apa kau menyukainya,\N‎tapi kau tak menyangkalnya.
Dialogue: 0,0:04:52.54,0:04:54.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Bukankah itu jawabanmu?
Dialogue: 0,0:04:56.33,0:04:58.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kenapa malah aku yang diberi nasihat?{\i0}
Dialogue: 0,0:05:01.21,0:05:04.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Seolah-olah aku yang salah.{\i0}
Dialogue: 0,0:05:06.26,0:05:08.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Padahal aku yang datang\N‎untuk memberinya peringatan.{\i0}
Dialogue: 0,0:05:11.31,0:05:14.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Syukurlah kau bisa berpikir jernih.
Dialogue: 0,0:05:14.31,0:05:17.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau tahu diri untuk mundur\N‎karena dia sudah punya pacar.
Dialogue: 0,0:05:18.15,0:05:20.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kami memang berpacaran,
Dialogue: 0,0:05:20.32,0:05:23.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎tapi bukan berarti\N‎kami akan menikah atau semacamnya.
Dialogue: 0,0:05:23.07,0:05:24.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Cuma kesepakatan lisan, 'kan?
Dialogue: 0,0:05:26.49,0:05:30.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku khawatir saat kalian berdua bersama.{\i0}
Dialogue: 0,0:05:30.91,0:05:32.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kalau aku jadi kau,
Dialogue: 0,0:05:32.99,0:05:36.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎aku akan terus berusaha\N‎meski dia sudah punya pacar.
Dialogue: 0,0:05:37.83,0:05:40.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku tak akan menyerah begitu saja.{\i0}
Dialogue: 0,0:05:41.79,0:05:45.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku tak mau orang seapatis dia...{\i0}
Dialogue: 0,0:05:48.05,0:05:49.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎...merebutnya dariku.{\i0}
Dialogue: 0,0:05:54.89,0:05:56.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎"Terus berusaha" itu maksudnya apa?
Dialogue: 0,0:05:57.98,0:06:01.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku mengakui semua ini terjadi\N‎berkat usaha kerasmu.
Dialogue: 0,0:06:02.07,0:06:06.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi "terus berusaha"\N‎meskipun dia menyukai orang lain,
Dialogue: 0,0:06:06.44,0:06:07.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎itu namanya egois, 'kan?
Dialogue: 0,0:06:08.82,0:06:13.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Setidaknya aku tak akan memaksakan\N‎perasaanku kepadanya.
Dialogue: 0,0:06:13.16,0:06:17.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kalau kau terus mengalah,\N‎kau akan rugi sendiri.{\i0}
Dialogue: 0,0:06:18.00,0:06:19.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi,
Dialogue: 0,0:06:19.58,0:06:22.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎kurasa pendapatku tak penting.
Dialogue: 0,0:06:23.29,0:06:27.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bukan berarti kita perlu saling memahami.
Dialogue: 0,0:06:28.22,0:06:29.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kebencian.{\i0}
Dialogue: 0,0:06:29.55,0:06:34.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Kau bisa bergaul dengan orang lain\N‎tanpa ragu sedikit pun.
Dialogue: 0,0:06:34.56,0:06:38.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Kau memperluas jejaring sosialmu\N‎demi tujuanmu sendiri.
Dialogue: 0,0:06:38.35,0:06:40.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Kau selalu percaya diri.
Dialogue: 0,0:06:40.56,0:06:42.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Ada kebencian di balik kata-katanya.{\i0}
Dialogue: 0,0:06:42.73,0:06:44.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Apa dia sedang menyindirku?{\i0}
Dialogue: 0,0:06:44.19,0:06:45.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dari lubuk hatiku, selama ini,
Dialogue: 0,0:06:46.78,0:06:48.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎aku selalu iri padamu.
Dialogue: 0,0:06:50.15,0:06:51.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Apa?
Dialogue: 0,0:06:51.32,0:06:53.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau bertindak\N‎dan menentukan pilihanmu sendiri.
Dialogue: 0,0:06:53.74,0:06:56.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau pasti sangat percaya diri.
Dialogue: 0,0:06:56.79,0:06:58.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau sangat berbeda denganku.
Dialogue: 0,0:06:59.50,0:07:02.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Aku selalu iri padamu, Momoka.
Dialogue: 0,0:07:02.63,0:07:05.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Kau iri padaku?
Dialogue: 0,0:07:06.00,0:07:08.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku benar-benar iri padamu,
Dialogue: 0,0:07:09.01,0:07:12.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎tapi aku tak bisa bersikap\N‎seperti yang kau lakukan.
Dialogue: 0,0:07:13.05,0:07:14.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kenapa?
Dialogue: 0,0:07:14.60,0:07:17.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kurasa saat berurusan dengan orang lain,
Dialogue: 0,0:07:18.31,0:07:20.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎kau pasti memberi batasan yang jelas
Dialogue: 0,0:07:20.31,0:07:23.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎antara orang yang mau kau kenal\N‎dan yang tak kau pedulikan.
Dialogue: 0,0:07:24.02,0:07:25.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tentu saja.
Dialogue: 0,0:07:26.07,0:07:29.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Melelahkan kalau harus memperlakukan\N‎semua orang dengan sama.
Dialogue: 0,0:07:30.90,0:07:32.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku paham itu.
Dialogue: 0,0:07:33.45,0:07:34.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi...
Dialogue: 0,0:07:35.62,0:07:40.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Akhir-akhir ini,\N‎Momoka sering main bersamamu, 'kan?
Dialogue: 0,0:07:40.79,0:07:42.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Padahal dulu dia sering bersamaku.
Dialogue: 0,0:07:43.71,0:07:46.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau tahu alasannya, 'kan?
Dialogue: 0,0:07:48.00,0:07:50.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Jangan memperlakukan orang\N‎sesuai manfaatnya.
Dialogue: 0,0:07:50.76,0:07:53.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Jangan jadikan orang seperti pion.
Dialogue: 0,0:07:53.97,0:07:55.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Kenapa tiba-tiba bilang begitu?
Dialogue: 0,0:07:56.26,0:08:00.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Memangnya apa yang kulakukan padamu\N‎sampai kau bilang begitu?
Dialogue: 0,0:08:00.98,0:08:02.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Tidak ada.
Dialogue: 0,0:08:02.31,0:08:04.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Kau tak perlu peduli padaku.
Dialogue: 0,0:08:05.61,0:08:10.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tapi orang yang tak kau pedulikan\N‎dan kau jadikan pion,{\i0}
Dialogue: 0,0:08:11.65,0:08:15.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎mereka punya kekhawatiran\N‎dan perasaan mereka bisa terluka.{\i0}
Dialogue: 0,0:08:16.20,0:08:17.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Mereka juga manusia sepertimu.{\i0}
Dialogue: 0,0:08:19.29,0:08:21.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau bisa menyembunyikannya,
Dialogue: 0,0:08:21.66,0:08:24.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎tapi orang bisa tahu saat dimanfaatkan.
Dialogue: 0,0:08:24.75,0:08:26.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mereka bisa terluka.
Dialogue: 0,0:08:26.75,0:08:30.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Tidak peduli itu berbeda\N‎dengan memperlakukan orang sesukamu.
Dialogue: 0,0:08:30.84,0:08:32.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Itu saja
Dialogue: 0,0:08:33.47,0:08:35.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎yang ingin kusampaikan hari ini.
Dialogue: 0,0:08:44.06,0:08:46.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau benar-benar membenciku, ya?
Dialogue: 0,0:08:46.60,0:08:50.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku sudah biasa tak disukai\N‎oleh anak-anak cewek.
Dialogue: 0,0:08:50.11,0:08:51.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak.
Dialogue: 0,0:08:51.86,0:08:54.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak membencimu.
Dialogue: 0,0:08:54.86,0:09:00.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku bahkan hampir tak mengenalmu,\N‎mana mungkin aku membencimu?
Dialogue: 0,0:09:01.12,0:09:02.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Begitu juga kau.
Dialogue: 0,0:09:03.50,0:09:09.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku hanya tak setuju\N‎dengan beberapa tindakanmu.
Dialogue: 0,0:09:10.38,0:09:12.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima kasih sudah mengingatkan.
Dialogue: 0,0:09:13.38,0:09:19.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi sudah pasti kita sendiri\N‎yang harus berusaha agar bahagia, 'kan?
Dialogue: 0,0:09:19.89,0:09:22.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎"Berbuat baiklah ke semua orang.
Dialogue: 0,0:09:22.52,0:09:25.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Pikirkan perasaan orang lain."
Dialogue: 0,0:09:25.27,0:09:27.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kurasa aku tak bisa melakukan itu.
Dialogue: 0,0:09:29.77,0:09:31.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Karena aku egois.
Dialogue: 0,0:09:33.90,0:09:35.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Aku juga tak bisa.
Dialogue: 0,0:09:36.53,0:09:40.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi jika cuma mementingkan diri sendiri,
Dialogue: 0,0:09:41.45,0:09:44.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎kau hanya akan fokus pada kekuranganmu.
Dialogue: 0,0:09:45.00,0:09:47.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Akhirnya, kau tak akan bahagia.
Dialogue: 0,0:09:50.00,0:09:52.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ini tentang dirimu sendiri?
Dialogue: 0,0:09:53.30,0:09:55.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Atau untuk diriku?
Dialogue: 0,0:09:56.30,0:09:57.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Keduanya.
Dialogue: 0,0:09:57.68,0:10:00.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Makanya aku cuma ingin kalian berdua
Dialogue: 0,0:10:00.85,0:10:03.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎bahagia dalam hubungan kalian.
Dialogue: 0,0:10:05.60,0:10:06.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jadi,
Dialogue: 0,0:10:07.27,0:10:08.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎aku akan menjaga jarak.
Dialogue: 0,0:10:09.69,0:10:10.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa itu sudah cukup?
Dialogue: 0,0:10:13.61,0:10:14.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Ya.
Dialogue: 0,0:10:18.24,0:10:19.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku membencinya.{\i0}
Dialogue: 0,0:10:21.24,0:10:25.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku membencinya,\N‎jadi tindakan dan keberadaannya{\i0}
Dialogue: 0,0:10:25.62,0:10:27.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎terus saja membuatku kesal.{\i0}
Dialogue: 0,0:10:29.54,0:10:36.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku lebih suka dia terus terang\N‎dan bilang dia membenciku.{\i0}
Dialogue: 0,0:10:37.01,0:10:41.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kalau dia jadi musuh,\N‎aku bisa melawannya dalam pikiranku.{\i0}
Dialogue: 0,0:10:42.39,0:10:44.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku bisa membela diri.{\i0}
Dialogue: 0,0:10:45.85,0:10:47.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Padahal tadi aku sudah menang,{\i0}
Dialogue: 0,0:10:48.68,0:10:50.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎tapi kenapa rasanya sangat hampa?{\i0}
Dialogue: 0,0:10:53.61,0:10:55.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Padahal aku terus mengatakannya.
Dialogue: 0,0:10:56.48,0:10:58.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kemudian Hayato, kepadaku...
Dialogue: 0,0:11:02.03,0:11:03.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Momoka?
Dialogue: 0,0:11:06.08,0:11:07.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ada apa?
Dialogue: 0,0:11:12.00,0:11:13.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Minato.
Dialogue: 0,0:11:14.04,0:11:15.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa kau menyukaiku?
Dialogue: 0,0:11:18.67,0:11:20.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Ya, aku menyukaimu.
Dialogue: 0,0:11:20.17,0:11:21.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Apa yang kau suka?
Dialogue: 0,0:11:22.34,0:11:25.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Kau positif, kuat, dan pintar.
Dialogue: 0,0:11:25.18,0:11:28.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Bukankah itu lebih mirip sindiran\N‎daripada pujian untuk cewek?
Dialogue: 0,0:11:29.31,0:11:30.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau membuatku terdengar licik.
Dialogue: 0,0:11:33.48,0:11:34.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hati-hati juga ada baiknya.
Dialogue: 0,0:11:36.69,0:11:37.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kalau begitu...
Dialogue: 0,0:11:38.23,0:11:40.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau lebih suka aku atau Koyun?
Dialogue: 0,0:11:41.57,0:11:43.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Kenapa? Koyun itu temanku.
Dialogue: 0,0:11:44.74,0:11:46.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Dia seperti Miki, Yota, dan lainnya.
Dialogue: 0,0:11:46.62,0:11:48.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Rasa sukanya berbeda.
Dialogue: 0,0:11:48.99,0:11:52.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Tapi bagaimana kalau Koyun\N‎tiba-tiba bilang dia menyukaimu?
Dialogue: 0,0:11:53.50,0:11:56.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Kau akan memilihnya, 'kan?
Dialogue: 0,0:11:56.59,0:11:58.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Tidak akan.
Dialogue: 0,0:11:58.17,0:12:00.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Karena aku berpacaran denganmu.
Dialogue: 0,0:12:04.14,0:12:06.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Karena kami berpacaran?{\i0}
Dialogue: 0,0:12:06.93,0:12:09.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Apa yang masih kurang dariku?{\i0}
Dialogue: 0,0:12:09.85,0:12:11.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku sudah melakukan semua yang kubisa,{\i0}
Dialogue: 0,0:12:13.19,0:12:15.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎tapi pada akhirnya,\N‎masih sama seperti biasa.{\i0}
Dialogue: 0,0:12:17.19,0:12:18.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kenapa dia masih khawatir?{\i0}
Dialogue: 0,0:12:20.15,0:12:21.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Maaf sudah membuatmu khawatir.
Dialogue: 0,0:12:22.28,0:12:24.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku bisa apa agar kau tak khawatir?
Dialogue: 0,0:12:24.99,0:12:27.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau mau aku bagaimana?
Dialogue: 0,0:12:29.12,0:12:31.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan terlalu pakai logika soal ini!
Dialogue: 0,0:12:32.29,0:12:33.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ini soal perasaan.
Dialogue: 0,0:12:33.79,0:12:35.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Perasaan siapa yang kau utamakan.
Dialogue: 0,0:12:39.42,0:12:42.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Oke, aku mau kau menjauh dari Koyun.
Dialogue: 0,0:12:42.80,0:12:46.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau bilang kalian cuma teman,\N‎tapi aku tak suka kalian dekat.
Dialogue: 0,0:12:46.22,0:12:48.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku benci melihat kalian begitu akrab!
Dialogue: 0,0:12:52.48,0:12:53.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku mengerti.
Dialogue: 0,0:12:55.06,0:12:57.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi sejauh apa aku harus menjauhinya?
Dialogue: 0,0:12:58.27,0:13:01.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau tak suka kami main bersama\N‎sebagai teman, 'kan?
Dialogue: 0,0:13:01.82,0:13:04.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Atau kau mau aku putus hubungan dengannya?
Dialogue: 0,0:13:04.57,0:13:08.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Kami masih harus bicara\N‎karena berada di kelas yang sama,
Dialogue: 0,0:13:08.28,0:13:10.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎jadi mungkin akan sulit.
Dialogue: 0,0:13:13.29,0:13:15.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Astaga!
Dialogue: 0,0:13:15.25,0:13:17.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Astaga!\N‎- Ada apa?
Dialogue: 0,0:13:23.76,0:13:25.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ayah bilang dia tak perlu makan malam.
Dialogue: 0,0:13:25.72,0:13:27.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Seharusnya bilang dari tadi.
Dialogue: 0,0:13:28.93,0:13:31.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Minato. Kau bisa makan ini?
Dialogue: 0,0:13:38.98,0:13:40.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak bisa makan semuanya.
Dialogue: 0,0:13:41.52,0:13:43.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Padahal biasanya bisa kau habiskan.
Dialogue: 0,0:13:44.82,0:13:47.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kok, rasanya sakit...{\i0}
Dialogue: 0,0:13:53.33,0:13:54.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku tak bisa tidur.{\i0}
Dialogue: 0,0:13:57.46,0:14:00.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Berpacaran dengan benar itu sulit.{\i0}
Dialogue: 0,0:14:02.09,0:14:04.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}‎Perasaan siapa yang kau utamakan.{\i0}
Dialogue: 0,0:14:04.46,0:14:07.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Terima kasih sudah menjadi temanku.{\i0}
Dialogue: 0,0:14:07.22,0:14:09.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}‎Semoga suatu hari nanti,\N‎kau jatuh cinta pada seseorang...{\i0}
Dialogue: 0,0:14:09.89,0:14:13.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tapi suatu saat nanti,\N‎aku ingin melihat Minato jatuh cinta.{\i0}
Dialogue: 0,0:14:13.43,0:14:14.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Bagaimana kemauanmu?{\i0}
Dialogue: 0,0:14:23.82,0:14:26.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Bagaimana aku tidur biasanya?{\i0}
Dialogue: 0,0:14:31.07,0:14:33.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sepertinya aku tak tidur sama sekali.{\i0}
Dialogue: 0,0:14:33.83,0:14:37.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Minato. Akhir-akhir ini,\N‎kau menggemeretakkan gigimu saat tidur.
Dialogue: 0,0:14:38.00,0:14:40.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mungkin kau sedang stres?
Dialogue: 0,0:14:40.67,0:14:41.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku?
Dialogue: 0,0:14:43.29,0:14:46.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sepertinya tidak. Si bungsu yang santai.
Dialogue: 0,0:14:46.01,0:14:47.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya.
Dialogue: 0,0:14:47.92,0:14:51.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Akhir-akhir ini, aku merasa agak aneh.{\i0}
Dialogue: 0,0:14:52.34,0:14:54.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kepalaku juga terasa tak nyaman...{\i0}
Dialogue: 0,0:14:56.27,0:14:58.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Aduh...
Dialogue: 0,0:14:58.23,0:15:00.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎- Ada apa?\N‎- Aku tak bisa...
Dialogue: 0,0:15:00.52,0:15:02.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Minato?
Dialogue: 0,0:15:02.27,0:15:03.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sakit...
Dialogue: 0,0:15:05.77,0:15:07.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau baik-baik saja, Minato?
Dialogue: 0,0:15:07.32,0:15:08.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei!
Dialogue: 0,0:15:09.74,0:15:11.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Kau stres.
Dialogue: 0,0:15:12.03,0:15:13.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Stres?
Dialogue: 0,0:15:13.41,0:15:16.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya. Gejalanya berbeda pada setiap orang.
Dialogue: 0,0:15:17.41,0:15:22.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terkadang bisa menumpuk perlahan\N‎seiring waktu tanpa disadari.
Dialogue: 0,0:15:24.00,0:15:27.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Pokoknya, pikiranmu sedang lelah saat ini.
Dialogue: 0,0:15:27.38,0:15:29.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Akan kuberi obat, lalu kita pantau dulu.
Dialogue: 0,0:15:29.72,0:15:34.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kalau tak membaik,\N‎coba konsultasi ke klinik psikosomatik.
Dialogue: 0,0:15:34.47,0:15:36.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Klinik psikosomatik?{\i0}
Dialogue: 0,0:15:36.76,0:15:39.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Untung kuliahku baru dimulai siang ini.
Dialogue: 0,0:15:39.68,0:15:41.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Ya.
Dialogue: 0,0:15:41.60,0:15:44.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau harus lebih menjaga diri, Minato.
Dialogue: 0,0:15:45.02,0:15:46.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya.
Dialogue: 0,0:15:47.36,0:15:49.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku stres? Karena apa?{\i0}
Dialogue: 0,0:15:50.61,0:15:53.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Astaga, rem tangannya masih aktif.
Dialogue: 0,0:15:59.41,0:16:03.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Sudah sampai, tapi parkirnya sulit.\N‎Apa aku bisa?
Dialogue: 0,0:16:03.67,0:16:05.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Minato. Masuklah dulu.
Dialogue: 0,0:16:06.54,0:16:07.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baik.
Dialogue: 0,0:16:11.01,0:16:13.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}‎Eh? Pintunya tidak dikunci?{\i0}
Dialogue: 0,0:16:13.80,0:16:14.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kenapa?{\i0}
Dialogue: 0,0:16:16.22,0:16:17.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎- Eh?\N‎- Gawat!
Dialogue: 0,0:16:19.97,0:16:21.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ternyata Minato.
Dialogue: 0,0:16:23.06,0:16:24.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Kakak!
Dialogue: 0,0:16:28.52,0:16:29.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf mengagetkan.
Dialogue: 0,0:16:29.61,0:16:33.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tolong jangan menyusup seperti pencuri.
Dialogue: 0,0:16:34.07,0:16:36.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak sopan. Ini juga rumahku.
Dialogue: 0,0:16:36.37,0:16:40.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi kau memang bilang "gawat"\N‎saat melihatku tadi, 'kan?
Dialogue: 0,0:16:40.91,0:16:42.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Ya, soal itu...
Dialogue: 0,0:16:43.41,0:16:45.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Aku kemari mau ambil stempel.
Dialogue: 0,0:16:45.04,0:16:46.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Memang pencuri!
Dialogue: 0,0:16:46.46,0:16:49.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku pakai ini untuk buka rekening\N‎saat masih tinggal di sini.
Dialogue: 0,0:16:50.84,0:16:52.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terserah saja.
Dialogue: 0,0:16:52.26,0:16:55.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku mau ke kampus sekarang.\N‎Lakukan sesukamu saja.
Dialogue: 0,0:16:55.68,0:16:56.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Dah!
Dialogue: 0,0:16:57.80,0:17:01.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Minato sedang kurang sehat,\N‎jangan ganggu dia terlalu lama.
Dialogue: 0,0:17:01.39,0:17:03.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Eh? Kurang sehat?
Dialogue: 0,0:17:03.31,0:17:05.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kami baru pulang dari dokter.
Dialogue: 0,0:17:05.56,0:17:07.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi aku sudah tak apa sekarang.
Dialogue: 0,0:17:07.90,0:17:08.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Dah.
Dialogue: 0,0:17:12.28,0:17:13.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎- Sampai jumpa.\N‎- Ya.
Dialogue: 0,0:17:16.53,0:17:18.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aneh melihat kalian tak bertengkar.
Dialogue: 0,0:17:18.53,0:17:19.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau pikir umurku berapa?
Dialogue: 0,0:17:20.91,0:17:23.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Tapi, Minato, kau sedang kurang sehat?
Dialogue: 0,0:17:23.54,0:17:25.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak, aku baik-baik saja.
Dialogue: 0,0:17:25.83,0:17:28.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sepertinya aku cuma kelelahan.
Dialogue: 0,0:17:29.46,0:17:32.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Dokter bilang jangan membiarkan\N‎stres menumpuk terlalu banyak.
Dialogue: 0,0:17:32.76,0:17:34.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Begitu, ya...
Dialogue: 0,0:17:35.51,0:17:39.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dengan kepribadianmu itu,\N‎wajar saja kau jadi stres.
Dialogue: 0,0:17:40.60,0:17:41.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dengar, Minato.
Dialogue: 0,0:17:42.60,0:17:46.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Kau cenderung memahami situasi\N‎tanpa mau mengutarakan pikiranmu.
Dialogue: 0,0:17:47.48,0:17:51.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Kau menahan apa yang ingin kau katakan\N‎dan memendam semuanya sendiri.
Dialogue: 0,0:17:52.57,0:17:54.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Dari dulu selalu begitu.
Dialogue: 0,0:17:54.03,0:17:55.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Aku tidak...
Dialogue: 0,0:17:55.78,0:17:56.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf.
Dialogue: 0,0:17:57.40,0:18:02.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Gara-gara kau sering melihatku\N‎dimarahi oleh Ayah dan Ibu,
Dialogue: 0,0:18:02.74,0:18:04.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎aku jadi contoh yang tak boleh ditiru.
Dialogue: 0,0:18:05.58,0:18:09.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kau melihatku dijauhi\N‎karena bertindak sesukaku,{\i0}
Dialogue: 0,0:18:09.12,0:18:10.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎pantas saja kau jadi begini.{\i0}
Dialogue: 0,0:18:11.96,0:18:15.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Cuma kau yang berpihak padaku\N‎di rumah ini,{\i0}
Dialogue: 0,0:18:15.67,0:18:17.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎tapi aku malah membuatmu serbasalah.
Dialogue: 0,0:18:18.68,0:18:22.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku yang membuatmu\N‎terus menahan diri, maaf.
Dialogue: 0,0:18:23.81,0:18:25.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Kenapa kau tiba-tiba begini?
Dialogue: 0,0:18:26.81,0:18:30.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Kakak, kau bukan tipe orang\N‎yang suka menganalisis orang.
Dialogue: 0,0:18:30.56,0:18:31.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Apa?
Dialogue: 0,0:18:32.31,0:18:36.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Ada beberapa temanku\N‎yang terpaksa berhenti kerja karena stres.
Dialogue: 0,0:18:36.69,0:18:38.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Karena terus menahan diri.
Dialogue: 0,0:18:39.24,0:18:42.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mereka tiba-tiba tumbang dan hancur.
Dialogue: 0,0:18:42.99,0:18:44.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Aku tak mau itu terjadi padamu.
Dialogue: 0,0:18:45.95,0:18:48.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dunia kerja masih lama untukku.
Dialogue: 0,0:18:49.25,0:18:50.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Memang benar.
Dialogue: 0,0:18:50.83,0:18:55.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi kemampuan memahami situasi\N‎memang dibutuhkan saat bekerja.
Dialogue: 0,0:18:56.21,0:18:58.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi kalau ada banyak orang,
Dialogue: 0,0:18:58.47,0:19:01.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎tidak semua orang bisa memiliki\N‎pendapat yang sama.
Dialogue: 0,0:19:02.89,0:19:03.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau tahu kenapa?
Dialogue: 0,0:19:04.72,0:19:06.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Karena ada orang sepertiku.
Dialogue: 0,0:19:10.31,0:19:12.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kak, kau yakin tak dikucilkan\N‎di tempat kerja?
Dialogue: 0,0:19:12.73,0:19:13.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak sopan.
Dialogue: 0,0:19:14.65,0:19:17.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Suka dan benci, benar dan salah,
Dialogue: 0,0:19:17.48,0:19:21.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎ada banyak macam orang,\N‎jadi pendapat dan jati dirimu harus jelas.
Dialogue: 0,0:19:21.07,0:19:24.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dan kau harus menyadarinya.
Dialogue: 0,0:19:24.32,0:19:27.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Menyadarinya?\N‎- Ya, pahami kenapa kau merasa begitu.
Dialogue: 0,0:19:27.83,0:19:31.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Kalau tak paham diri sendiri,\N‎kau tak bisa menghadapi orang lain.
Dialogue: 0,0:19:34.13,0:19:35.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Kak.
Dialogue: 0,0:19:35.67,0:19:37.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa yang terjadi\N‎setelah kau pergi dari rumah?
Dialogue: 0,0:19:37.92,0:19:40.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Cukup untuk membuatku melunak begini.
Dialogue: 0,0:19:42.22,0:19:43.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jaga kesehatanmu, ya?
Dialogue: 0,0:19:44.26,0:19:46.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mungkin aneh bilang begitu\N‎ke orang yang kurang sehat.
Dialogue: 0,0:19:47.93,0:19:49.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kak.
Dialogue: 0,0:19:49.14,0:19:50.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Datang lagi, ya?
Dialogue: 0,0:19:50.98,0:19:52.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya.
Dialogue: 0,0:19:52.10,0:19:54.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Nanti menyusup lagi\N‎untuk mengembalikan stempel.
Dialogue: 0,0:19:55.06,0:19:57.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bukan begitu maksudku.
Dialogue: 0,0:19:59.94,0:20:02.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Apa aku bertindak seperti ini{\i0}
Dialogue: 0,0:20:02.86,0:20:05.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎karena aku tak mau jadi seperti kakakku?{\i0}
Dialogue: 0,0:20:06.99,0:20:08.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Bukan.{\i0}
Dialogue: 0,0:20:09.04,0:20:13.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku cuma tak tahu\N‎kenapa semua orang begitu membencinya.{\i0}
Dialogue: 0,0:20:13.87,0:20:15.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dan itu membuatku takut.{\i0}
Dialogue: 0,0:20:16.54,0:20:20.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Saat merasa tak nyaman\N‎ketika berusaha memahami situasi,{\i0}
Dialogue: 0,0:20:20.59,0:20:24.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎aku bukan mau memberontak\N‎atau membela orang-orang{\i0}
Dialogue: 0,0:20:24.43,0:20:27.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎saat mereka dicap buruk\N‎atau tertekan oleh lingkungan.{\i0}
Dialogue: 0,0:20:28.01,0:20:31.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku cuma tak tahu\N‎alasan dari kebencian itu.{\i0}
Dialogue: 0,0:20:31.85,0:20:34.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Orang yang ditusuk,\N‎dan orang yang menusuk.{\i0}
Dialogue: 0,0:20:34.77,0:20:36.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Saat ini, bukan aku sasarannya.{\i0}
Dialogue: 0,0:20:37.31,0:20:40.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Perbedaannya begitu samar.{\i0}
Dialogue: 0,0:20:40.40,0:20:45.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku merasa niat buruk semua orang\N‎tak mengarah ke orang itu saja.{\i0}
Dialogue: 0,0:20:46.16,0:20:51.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Karena kalau aku salah langkah,\N‎nanti giliranku yang akan mengalaminya.{\i0}
Dialogue: 0,0:20:51.12,0:20:54.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Minato tidak seperti kakaknya,\N‎kau anak baik.
Dialogue: 0,0:20:55.21,0:20:58.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Bagaimana kalau aku berbeda\N‎dengan aku yang sekarang?{\i0}
Dialogue: 0,0:21:00.05,0:21:01.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kakak.{\i0}
Dialogue: 0,0:21:01.51,0:21:04.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku tak sebaik yang kau kira.{\i0}
Dialogue: 0,0:21:05.30,0:21:07.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku membantu orang lain bukan demi mereka.{\i0}
Dialogue: 0,0:21:07.89,0:21:09.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kebaikan ini bukan demi orang.{\i0}
Dialogue: 0,0:21:10.31,0:21:14.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku menjaga kedamaian\N‎karena tak tahan dengan ketegangan.{\i0}
Dialogue: 0,0:21:15.31,0:21:17.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku membantu orang lain{\i0}
Dialogue: 0,0:21:17.81,0:21:22.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎karena takut tak ada yang bantu\N‎kalau aku dalam kesulitan.{\i0}
Dialogue: 0,0:21:23.69,0:21:25.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku tak tega menolak seseorang{\i0}
Dialogue: 0,0:21:26.32,0:21:30.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎karena membayangkan bagaimana rasanya\N‎kalau berada di posisi mereka.{\i0}
Dialogue: 0,0:21:31.66,0:21:34.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Semua itu bukan karena kebaikan,{\i0}
Dialogue: 0,0:21:35.04,0:21:38.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎tapi murni karena kelemahanku\N‎yang tak ingin kesepian.{\i0}
Dialogue: 0,0:21:40.09,0:21:44.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sejak dulu,\N‎meskipun dengan keluarga atau teman,{\i0}
Dialogue: 0,0:21:45.59,0:21:49.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎aku tak bisa memercayai siapa pun\N‎sampai benar-benar membuka hatiku.{\i0}
Dialogue: 0,0:21:50.64,0:21:53.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau hanya ingin orang-orang melihatmu.
Dialogue: 0,0:21:53.81,0:21:55.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau ingin mereka bergantung padamu.
Dialogue: 0,0:21:57.44,0:21:58.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kenapa ingat itu sekarang?{\i0}
Dialogue: 0,0:21:59.65,0:22:03.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dulu aku memahaminya sebagai kata-kata,\N‎sekarang jadi kenyataan.{\i0}
Dialogue: 0,0:22:04.82,0:22:07.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku tak bisa terus begini.{\i0}
Dialogue: 0,0:22:07.90,0:22:11.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku tak bisa membuka hatiku,\N‎tapi malah pura-pura berjuang.{\i0}
Dialogue: 0,0:22:11.58,0:22:13.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku menyakiti Momoka.{\i0}
Dialogue: 0,0:22:14.41,0:22:17.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku cuma memanfaatkan orang lain\N‎demi diriku sendiri.{\i0}
Dialogue: 0,0:22:18.75,0:22:20.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku tak bisa{\i0}
Dialogue: 0,0:22:21.17,0:22:23.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎terus berpacaran dengannya seperti ini.{\i0}
Dialogue: 0,0:23:50.92,0:23:55.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terjemahan subtitle oleh Shoffanny R
