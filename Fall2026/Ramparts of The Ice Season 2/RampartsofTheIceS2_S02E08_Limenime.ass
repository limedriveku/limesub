Dialogue: 0,0:02:01.32,0:02:02.41,sign,,0000,0000,0000,,‎KELAS 2-2
Dialogue: 0,0:03:39.55,0:03:43.93,sign,,0000,0000,0000,,‎EPISODE 22\N‎TITIK BALIK
Dialogue: 0,0:03:44.59,0:03:47.14,sign,,0000,0000,0000,,‎BEBERAPA HARI SEBELUMNYA
Dialogue: 0,0:03:58.23,0:04:00.40,sign,,0000,0000,0000,,‎MAAF, MOMOKA\N‎KITA PERLU BICARA
Dialogue: 0,0:04:36.90,0:04:39.07,sign,,0000,0000,0000,,{\an8}‎MAAF, MOMOKA\N‎KITA PERLU BICARA - DIBACA
Dialogue: 0,0:04:50.45,0:04:51.66,sign,,0000,0000,0000,,‎AKU YANG DULU...
Dialogue: 0,0:05:32.87,0:05:34.70,sign,,0000,0000,0000,,‎MAAF, MOMOKA\N‎KITA PERLU BICARA
Dialogue: 0,0:08:44.85,0:08:45.94,sign,,0000,0000,0000,,‎BUK
Dialogue: 0,0:10:43.22,0:10:44.64,sign,,0000,0000,0000,,‎KAU PASTI SUKA INI, MOMOKA
Dialogue: 0,0:10:44.64,0:10:45.76,sign,,0000,0000,0000,,‎WAH, AKU SUKA! HORE!
Dialogue: 0,0:11:31.69,0:11:35.11,sign,,0000,0000,0000,,‎PUKUL-PUKUL
Dialogue: 0,0:12:05.22,0:12:06.64,sign,,0000,0000,0000,,‎BAM
Dialogue: 0,0:12:10.10,0:12:11.89,sign,,0000,0000,0000,,‎BAYANGAN\N‎LAMPIASKAN DENGAN MAKAN - TERTAWA
Dialogue: 0,0:12:47.01,0:12:48.09,sign,,0000,0000,0000,,‎YA!
Dialogue: 0,0:12:57.94,0:12:58.94,sign,,0000,0000,0000,,‎GYOSHO CINA PEDAS
Dialogue: 0,0:13:03.44,0:13:04.53,sign,,0000,0000,0000,,‎KELAS 2-2
Dialogue: 0,0:13:40.65,0:13:42.36,sign,,0000,0000,0000,,‎INTIP
Dialogue: 0,0:13:53.79,0:13:55.79,sign,,0000,0000,0000,,‎BENGONG
Dialogue: 0,0:14:15.72,0:14:16.73,sign,,0000,0000,0000,,{\an8}‎TIDAK BISA DIBUAT BERCANDA
Dialogue: 0,0:16:14.76,0:16:15.76,sign,,0000,0000,0000,,‎MIDORIKAWA BERGABUNG!!
Dialogue: 0,0:16:19.85,0:16:21.22,sign,,0000,0000,0000,,‎RENCANA KEJUTAN\N‎ULANG TAHUN AMAMIYA
Dialogue: 0,0:16:31.57,0:16:34.03,sign,,0000,0000,0000,,‎HAHAHA
Dialogue: 0,0:17:12.78,0:17:14.28,sign,,0000,0000,0000,,‎BAM
Dialogue: 0,0:17:16.45,0:17:17.53,sign,,0000,0000,0000,,‎DEG DEG DEG\N‎SERUPUT
Dialogue: 0,0:18:47.29,0:18:49.25,sign,,0000,0000,0000,,‎TATAP...
Dialogue: 0,0:18:51.75,0:18:53.00,sign,,0000,0000,0000,,‎MENGENDAP-ENDAP
Dialogue: 0,0:18:54.25,0:18:55.63,sign,,0000,0000,0000,,‎WUS
Dialogue: 0,0:18:55.63,0:18:58.46,sign,,0000,0000,0000,,‎MELAYANG
Dialogue: 0,0:18:58.47,0:19:00.05,sign,,0000,0000,0000,,‎GULMA GELINDING
Dialogue: 0,0:19:14.52,0:19:15.52,sign,,0000,0000,0000,,‎MELAYANG
Dialogue: 0,0:19:24.16,0:19:25.24,sign,,0000,0000,0000,,‎ELUS-ELUS
Dialogue: 0,0:00:12.42,0:00:14.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dinginnya!
Dialogue: 0,0:00:14.05,0:00:15.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Beginilah rasanya musim gugur.
Dialogue: 0,0:00:17.47,0:00:20.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku suka momen pergantian musim.
Dialogue: 0,0:00:20.06,0:00:22.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau sering mengatakan itu.
Dialogue: 0,0:00:22.02,0:00:25.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Aku suka acara musim panas\N‎dengan suasana musim panasnya,
Dialogue: 0,0:00:25.27,0:00:28.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎aku juga suka angin sejuk\N‎dengan hawa gerah
Dialogue: 0,0:00:28.40,0:00:31.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎saat berjalan-jalan di malam musim panas...
Dialogue: 0,0:00:31.78,0:00:36.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi saat udara mulai sejuk\N‎dan musim berganti seperti ini,
Dialogue: 0,0:00:36.28,0:00:39.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎momen inilah yang membuatku\N‎paling bersemangat.
Dialogue: 0,0:00:39.12,0:00:41.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Sepertinya aku paham maksudmu.
Dialogue: 0,0:00:41.29,0:00:44.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Rasanya seperti habis berlatih keras\N‎sepanjang musim panas,
Dialogue: 0,0:00:44.21,0:00:47.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎lalu berpikir, "Apa aku jadi lebih kuat?"
Dialogue: 0,0:00:47.08,0:00:51.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kalau bisa melewati musim panas,\N‎kita memang jadi lebih kuat, ya.
Dialogue: 0,0:00:51.30,0:00:53.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf, ternyata aku tak paham.
Dialogue: 0,0:00:53.67,0:00:54.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kenapa?
Dialogue: 0,0:01:02.02,0:01:03.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Musim gugur.
Dialogue: 0,0:01:04.23,0:01:05.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Amamiya, kapan ulang tahunmu?
Dialogue: 0,0:01:06.56,0:01:08.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa? Mau melakukan sesuatu untukku?
Dialogue: 0,0:01:08.56,0:01:10.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak, jangan berharap yang spesial...
Dialogue: 0,0:01:11.52,0:01:13.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}‎Tanggal 29 September.{\i0}
Dialogue: 0,0:01:14.19,0:01:15.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}‎Sebentar lagi.{\i0}
Dialogue: 0,0:01:15.78,0:01:18.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Ulang tahunnya sudah dekat.{\i0}
Dialogue: 0,0:01:18.20,0:01:19.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tapi...{\i0}
Dialogue: 0,0:01:19.78,0:01:20.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baik.
Dialogue: 0,0:01:21.79,0:01:23.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Aku akan menjauhi Amamiya.
Dialogue: 0,0:01:24.58,0:01:27.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku sudah menjawab dengan sok tegar.{\i0}
Dialogue: 0,0:01:28.29,0:01:31.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tapi harus sejauh apa?{\i0}
Dialogue: 0,0:01:31.00,0:01:33.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kami belum membahas batasannya.{\i0}
Dialogue: 0,0:01:33.25,0:01:36.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Apa boleh memberinya hadiah?\N‎Tidak, sudah jelas tak boleh.{\i0}
Dialogue: 0,0:01:36.05,0:01:37.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Selamat ulang tahun!{\i0}
Dialogue: 0,0:01:37.88,0:01:40.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Bagaimana kalau kuberikan dengan santai?{\i0}
Dialogue: 0,0:01:40.30,0:01:44.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tapi aku ingin membalas kebaikannya\N‎sebanyak yang pernah dia berikan.{\i0}
Dialogue: 0,0:01:45.85,0:01:50.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dia tak masuk sekolah akhir pekan ini,\N‎aku sedikit mengkhawatirkannya.{\i0}
Dialogue: 0,0:01:51.36,0:01:53.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku ingin menanyakan keadaannya,{\i0}
Dialogue: 0,0:01:54.44,0:01:57.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎tapi aku tak berhak melakukannya.{\i0}
Dialogue: 0,0:02:02.41,0:02:03.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎He? Serius?
Dialogue: 0,0:02:04.58,0:02:07.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau putus dengan Kuriki?
Dialogue: 0,0:03:47.76,0:03:49.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kau baik-baik saja?{\i0}
Dialogue: 0,0:03:51.73,0:03:54.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Terima kasih.\N‎Sekarang sudah baik-baik saja.{\i0}
Dialogue: 0,0:04:00.40,0:04:01.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sampai saat ini...{\i0}
Dialogue: 0,0:04:02.61,0:04:03.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku mau putus.
Dialogue: 0,0:04:04.91,0:04:05.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baiklah.
Dialogue: 0,0:04:07.03,0:04:11.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}‎Aku selalu berpikir,\N‎"Kalau itu maunya, apa boleh buat."{\i0}
Dialogue: 0,0:04:11.87,0:04:15.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Lebih mudah jika orang lain\N‎yang mengambil keputusan.{\i0}
Dialogue: 0,0:04:16.38,0:04:19.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Itu bukan pilihanku,{\i0}
Dialogue: 0,0:04:19.09,0:04:20.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎jadi itu bukan kegagalanku.{\i0}
Dialogue: 0,0:04:21.76,0:04:23.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku yang dicampakkan,{\i0}
Dialogue: 0,0:04:23.84,0:04:25.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎jadi bukan aku yang menyakiti.{\i0}
Dialogue: 0,0:04:26.51,0:04:28.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Selama aku menuruti keinginan orang lain,{\i0}
Dialogue: 0,0:04:29.14,0:04:31.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎aku bukan pelaku maupun orang jahat.{\i0}
Dialogue: 0,0:04:32.35,0:04:35.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku bersikap begini\N‎karena tak mau bertanggung jawab.{\i0}
Dialogue: 0,0:04:39.77,0:04:44.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Ternyata memutuskan hubungan\N‎rasanya seberat ini?{\i0}
Dialogue: 0,0:04:45.61,0:04:47.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau terlihat santai, padahal baru putus.
Dialogue: 0,0:04:48.45,0:04:50.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak sopan. Aku juga merasa terluka.
Dialogue: 0,0:04:54.71,0:04:57.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku terlalu sibuk memahami situasi{\i0}
Dialogue: 0,0:04:57.00,0:05:00.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎dan melakukan apa yang menurutku\N‎orang lain inginkan.{\i0}
Dialogue: 0,0:05:00.63,0:05:03.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku sok perhatian\N‎demi kepuasan diriku sendiri,{\i0}
Dialogue: 0,0:05:03.63,0:05:06.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎lalu menikmatinya\N‎saat orang-orang memperhatikanku.{\i0}
Dialogue: 0,0:05:06.88,0:05:08.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎"Lihat, tak apa.{\i0}
Dialogue: 0,0:05:08.80,0:05:11.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku sudah benar." Begitu pikirku.{\i0}
Dialogue: 0,0:05:12.85,0:05:14.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Padahal kenyataannya...{\i0}
Dialogue: 0,0:05:15.02,0:05:16.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Minato,
Dialogue: 0,0:05:17.06,0:05:19.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎kau benar-benar tak punya jati diri.
Dialogue: 0,0:05:20.86,0:05:22.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku seperti cangkang kosong,{\i0}
Dialogue: 0,0:05:23.40,0:05:25.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎hanya mengisi diriku dengan orang lain.{\i0}
Dialogue: 0,0:05:27.86,0:05:28.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku{\i0}
Dialogue: 0,0:05:29.62,0:05:30.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎kacau sekali.{\i0}
Dialogue: 0,0:05:34.70,0:05:36.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dia ingin bicara.{\i0}
Dialogue: 0,0:05:36.91,0:05:38.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Begitu dia bilang begitu,{\i0}
Dialogue: 0,0:05:39.71,0:05:42.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎aku tahu apa yang ingin dibicarakan.{\i0}
Dialogue: 0,0:05:42.71,0:05:46.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sejak kami berpacaran,\N‎aku makin lama makin gelisah.{\i0}
Dialogue: 0,0:05:50.01,0:05:52.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sudah cukup hari ini.{\i0}
Dialogue: 0,0:05:53.43,0:05:57.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sekeras apa pun usahaku,\N‎dia tak akan menyadarinya.{\i0}
Dialogue: 0,0:05:58.31,0:06:02.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Hal yang dulu bisa kuusahakan demi diriku,\N‎kini tak bisa lagi kuusahakan.{\i0}
Dialogue: 0,0:06:02.86,0:06:05.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku jadi cemas kalau tidak diapresiasi.{\i0}
Dialogue: 0,0:06:06.28,0:06:11.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Padahal aku tetap jadi diriku\N‎agar tak menjadi cewek yang kubenci,{\i0}
Dialogue: 0,0:06:12.62,0:06:17.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎tapi aku malah berubah\N‎menjadi sosok yang tak kuinginkan.{\i0}
Dialogue: 0,0:06:19.42,0:06:22.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Rasanya lelah sekali.{\i0}
Dialogue: 0,0:06:35.72,0:06:36.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kita putus saja.
Dialogue: 0,0:06:38.48,0:06:40.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Ya. Sudah kuduga.{\i0}
Dialogue: 0,0:06:41.73,0:06:44.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau minta putus\N‎karena mau mengejar orang yang kau suka?
Dialogue: 0,0:06:46.28,0:06:47.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak.
Dialogue: 0,0:06:47.90,0:06:49.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bukan itu alasannya.
Dialogue: 0,0:06:50.61,0:06:52.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bukan seperti itu.
Dialogue: 0,0:06:53.45,0:06:55.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ada masalah di diriku.
Dialogue: 0,0:06:57.20,0:07:00.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kalau kita terus berpacaran,\N‎aku tak akan berubah.
Dialogue: 0,0:07:01.71,0:07:04.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak bisa menjadi seperti yang kau mau.
Dialogue: 0,0:07:06.21,0:07:08.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kurasa aku menyukainya.{\i0}
Dialogue: 0,0:07:08.71,0:07:11.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku mau dia bahagia.{\i0}
Dialogue: 0,0:07:12.26,0:07:13.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tapi...{\i0}
Dialogue: 0,0:07:13.89,0:07:17.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Orang yang membahagiakannya tak harus aku.{\i0}
Dialogue: 0,0:07:19.14,0:07:21.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku bukan mau membuatnya bahagia.{\i0}
Dialogue: 0,0:07:21.85,0:07:23.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku hanya mau dia bahagia.{\i0}
Dialogue: 0,0:07:24.77,0:07:25.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Perasaan ini
Dialogue: 0,0:07:27.15,0:07:28.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎bukanlah cinta.
Dialogue: 0,0:07:29.82,0:07:30.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf.
Dialogue: 0,0:07:35.49,0:07:36.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu...
Dialogue: 0,0:07:37.29,0:07:39.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu sih aku sudah tahu sejak awal!
Dialogue: 0,0:07:39.83,0:07:40.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bodoh!
Dialogue: 0,0:07:40.91,0:07:45.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau tak menyukaiku,\N‎kau cuma merasa punya kewajiban.
Dialogue: 0,0:07:45.17,0:07:47.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku sudah tahu dari dulu.
Dialogue: 0,0:07:47.04,0:07:49.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dari dulu rasanya menyakitkan!
Dialogue: 0,0:07:52.59,0:07:53.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf.
Dialogue: 0,0:07:54.22,0:07:55.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Andai kukatakan dari awal...
Dialogue: 0,0:07:55.55,0:07:57.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan bilang\N‎kau menyesal berpacaran denganku.
Dialogue: 0,0:08:00.14,0:08:03.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan menyangkal semuanya seperti itu.
Dialogue: 0,0:08:06.90,0:08:11.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku lebih suka kau bilang\N‎kalau kau menyukai orang lain.
Dialogue: 0,0:08:12.49,0:08:14.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Putus karena ada masalah di dirimu.
Dialogue: 0,0:08:15.62,0:08:18.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau mengambil keputusan sendiri\N‎tanpa bicara dulu denganku,
Dialogue: 0,0:08:18.70,0:08:22.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎itu sama saja kau menganggap\N‎aku tak bisa membantu masalahmu.
Dialogue: 0,0:08:23.33,0:08:26.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Seolah kau bilang\N‎aku bukan orang yang bisa kau percaya.
Dialogue: 0,0:08:28.59,0:08:29.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Terserah saja.
Dialogue: 0,0:08:30.42,0:08:33.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku sudah lelah memikirkannya.{\i0}
Dialogue: 0,0:08:34.38,0:08:35.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Terus saja seperti itu.{\i0}
Dialogue: 0,0:08:36.47,0:08:38.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kunci hatimu selamanya.{\i0}
Dialogue: 0,0:08:47.52,0:08:48.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baik, aku paham.
Dialogue: 0,0:08:49.94,0:08:50.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kita putus.
Dialogue: 0,0:08:52.28,0:08:53.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bodoh.
Dialogue: 0,0:09:03.50,0:09:04.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Selesai.{\i0}
Dialogue: 0,0:09:06.46,0:09:09.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sudah selesai. Akhirnya selesai.{\i0}
Dialogue: 0,0:09:10.29,0:09:12.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Bohong kalau kubilang aku tak sedih.{\i0}
Dialogue: 0,0:09:13.38,0:09:17.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tapi jujur, aku juga lega\N‎karena tak perlu khawatir lagi.{\i0}
Dialogue: 0,0:09:18.84,0:09:20.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Ya. Tak apa.{\i0}
Dialogue: 0,0:09:21.31,0:09:22.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Syukurlah sudah selesai.{\i0}
Dialogue: 0,0:09:23.06,0:09:24.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Anggap saja begitu.{\i0}
Dialogue: 0,0:09:27.77,0:09:29.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hapus semua fotonya.
Dialogue: 0,0:09:36.32,0:09:39.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kami mulai berpacaran\N‎saat liburan musim panas,{\i0}
Dialogue: 0,0:09:39.37,0:09:42.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎jadi sudah sering berkencan\N‎dan foto bersama.{\i0}
Dialogue: 0,0:09:45.50,0:09:47.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dia memang tampan.{\i0}
Dialogue: 0,0:09:47.46,0:09:50.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}‎Tidak. Jangan sampai goyah!{\i0}
Dialogue: 0,0:09:52.92,0:09:57.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}‎Dia ingat aku pernah bilang\N‎kalau aku ingin menonton film ini.{\i0}
Dialogue: 0,0:09:58.55,0:10:00.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}‎Dia juga ingat aku ingin ke tempat ini.{\i0}
Dialogue: 0,0:10:03.47,0:10:07.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dia bahkan rela bergadang menemaniku\N‎saat aku bilang ingin menelepon.{\i0}
Dialogue: 0,0:10:08.77,0:10:11.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Padahal momen menyenangkannya\N‎jauh lebih banyak.{\i0}
Dialogue: 0,0:10:13.36,0:10:14.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Minato.
Dialogue: 0,0:10:15.48,0:10:16.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa kau menyukaiku?
Dialogue: 0,0:10:17.49,0:10:19.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Ya, aku menyukaimu.
Dialogue: 0,0:10:19.03,0:10:20.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Apa yang kau suka?
Dialogue: 0,0:10:20.16,0:10:23.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Kau positif, kuat, dan pintar.
Dialogue: 0,0:10:23.91,0:10:27.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Bukankah itu lebih mirip sindiran\N‎daripada pujian untuk cewek?
Dialogue: 0,0:10:28.83,0:10:30.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hati-hati juga ada baiknya.
Dialogue: 0,0:10:31.96,0:10:35.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dari dulu,\N‎aku benci diperlakukan seperti boneka.{\i0}
Dialogue: 0,0:10:36.88,0:10:38.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku benci dijadikan aksesori{\i0}
Dialogue: 0,0:10:39.43,0:10:43.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎atau dinilai seenaknya\N‎hanya dari penampilanku.{\i0}
Dialogue: 0,0:10:45.77,0:10:46.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dia...{\i0}
Dialogue: 0,0:10:47.81,0:10:49.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dia sungguh memperhatikanku.{\i0}
Dialogue: 0,0:10:49.98,0:10:51.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dia berusaha mengenalku.{\i0}
Dialogue: 0,0:10:52.81,0:10:54.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Setelah semua itu,{\i0}
Dialogue: 0,0:10:55.98,0:10:57.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎pilihannya tetap bukan aku.{\i0}
Dialogue: 0,0:10:59.65,0:11:04.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kenapa aku baru melihat semua kebaikannya\N‎setelah semuanya berakhir?{\i0}
Dialogue: 0,0:11:05.12,0:11:09.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kenapa saat kami berpacaran,\N‎aku tak sadar dia begitu baik?{\i0}
Dialogue: 0,0:11:10.71,0:11:14.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Daripada fokus pada kekurangan\N‎dan merasa kecewa,{\i0}
Dialogue: 0,0:11:15.59,0:11:19.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎seharusnya aku bersyukur\N‎dengan semua perhatian dan kebaikannya.{\i0}
Dialogue: 0,0:11:19.67,0:11:22.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Jika cuma mementingkan diri sendiri,{\i0}
Dialogue: 0,0:11:23.01,0:11:25.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎kau hanya akan fokus pada kekuranganmu.
Dialogue: 0,0:11:26.22,0:11:28.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Akhirnya, kau tak akan bahagia.
Dialogue: 0,0:11:38.73,0:11:39.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mustahil.
Dialogue: 0,0:11:39.86,0:11:42.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bukankah katanya\N‎Amamiya yang selalu dicampakkan?
Dialogue: 0,0:11:42.99,0:11:44.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mungkin dia memang selingkuh?
Dialogue: 0,0:11:44.45,0:11:46.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dengan cewek yang di tangga itu?
Dialogue: 0,0:11:46.45,0:11:47.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dasar bajingan.
Dialogue: 0,0:11:49.37,0:11:50.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Momoka.
Dialogue: 0,0:11:52.25,0:11:54.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bangunlah. Ayo pulang.
Dialogue: 0,0:11:54.00,0:11:55.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei, bersemangatlah.
Dialogue: 0,0:11:55.46,0:11:57.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mau beli makanan enak sebelum pulang?
Dialogue: 0,0:11:57.67,0:11:59.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ayo makan sepuasnya.
Dialogue: 0,0:11:59.21,0:12:01.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Luapkan saja semuanya.
Dialogue: 0,0:12:03.93,0:12:05.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima kasih.
Dialogue: 0,0:12:08.26,0:12:10.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Agak beda dari bayanganku.
Dialogue: 0,0:12:12.89,0:12:13.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Nantinya...
Dialogue: 0,0:12:14.60,0:12:18.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku akan lebih menyukai diriku\N‎dalam hubunganku berikutnya.
Dialogue: 0,0:12:19.53,0:12:21.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku akan jadi orang yang bisa kusukai,
Dialogue: 0,0:12:22.45,0:12:26.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎dan mencari cowok yang begitu menyukaiku\N‎sampai cuma bisa melihatku.
Dialogue: 0,0:12:29.70,0:12:33.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kalau dia mulai menjauh,\N‎akan langsung kucampakkan.
Dialogue: 0,0:12:33.91,0:12:36.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kalau dicampakkan pun, masa bodoh,
Dialogue: 0,0:12:36.00,0:12:38.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎artinya dia bodoh karena seleranya jelek.
Dialogue: 0,0:12:39.42,0:12:42.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku akan menjadi cewek seperti itu.
Dialogue: 0,0:12:45.68,0:12:47.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Keren sekali.
Dialogue: 0,0:12:48.10,0:12:50.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ide bagus! Semangat!
Dialogue: 0,0:12:51.47,0:12:53.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Pedas sekali.
Dialogue: 0,0:12:53.64,0:12:56.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi rasanya sangat enak.
Dialogue: 0,0:12:56.65,0:12:57.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Semangat!
Dialogue: 0,0:13:00.65,0:13:03.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Amamiya dan Momoka putus.{\i0}
Dialogue: 0,0:13:04.53,0:13:05.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Semuanya terjadi tiba-tiba.{\i0}
Dialogue: 0,0:13:06.82,0:13:10.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Mengingat posisiku,\N‎seharusnya aku senang, tapi...{\i0}
Dialogue: 0,0:13:11.16,0:13:15.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Astaga, kondisi Minato kali ini\N‎sulit dibuat bercanda.
Dialogue: 0,0:13:15.71,0:13:18.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia kehilangan semangat hidup\N‎sejak kemarin.
Dialogue: 0,0:13:18.46,0:13:20.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hino! Lakukan sesuatu!
Dialogue: 0,0:13:20.84,0:13:23.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak bisa berbuat apa-apa soal ini.
Dialogue: 0,0:13:24.26,0:13:25.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sebelumnya...{\i0}
Dialogue: 0,0:13:25.93,0:13:31.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Meskipun hanya sebentar,\N‎aku berterima kasih mereka menyukaiku.
Dialogue: 0,0:13:32.18,0:13:35.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dia terlihat biasa saja setelah putus.{\i0}
Dialogue: 0,0:13:36.44,0:13:39.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kupikir memang sifatnya begitu, tapi...{\i0}
Dialogue: 0,0:13:49.53,0:13:52.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Amamiya. Kondisimu sudah tak apa?
Dialogue: 0,0:13:56.96,0:13:58.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Ya, sudah tak apa.
Dialogue: 0,0:13:59.71,0:14:00.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Terima kasih.
Dialogue: 0,0:14:02.04,0:14:04.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Begitu? Syukurlah.
Dialogue: 0,0:14:07.22,0:14:08.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Koyun!
Dialogue: 0,0:14:08.68,0:14:12.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei! Ini sulit sekali!\N‎Dia seperti orang yang berbeda.
Dialogue: 0,0:14:12.97,0:14:13.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kami baru saja putus.{\i0}
Dialogue: 0,0:14:14.56,0:14:15.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Benar kata Midorikawa.
Dialogue: 0,0:14:17.35,0:14:19.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku mau kau menjauhi Minato.
Dialogue: 0,0:14:20.48,0:14:23.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tidak mungkin Momoka yang minta putus.{\i0}
Dialogue: 0,0:14:24.90,0:14:26.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Amamiya yang minta putus?{\i0}
Dialogue: 0,0:14:27.40,0:14:28.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kalau begitu...{\i0}
Dialogue: 0,0:14:29.28,0:14:31.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Koyuki. Ini kesempatanmu.
Dialogue: 0,0:14:31.95,0:14:33.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tsukko!
Dialogue: 0,0:14:33.03,0:14:38.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Selagi dia sedih, kalau kau mendekat\N‎dan mengisi kekosongan hatinya...
Dialogue: 0,0:14:38.33,0:14:40.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Ya! Lakukanlah, Koyun.
Dialogue: 0,0:14:47.01,0:14:51.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Mengisi kekosongan hatinya\N‎mungkin hal yang tepat{\i0}
Dialogue: 0,0:14:51.43,0:14:53.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎kalau dia memang sedih setelah putus.{\i0}
Dialogue: 0,0:14:55.31,0:14:57.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Katanya Igarashi dicampakkan oleh Koyuki.
Dialogue: 0,0:14:57.64,0:15:00.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Masa? Bukannya hubungan mereka baik?
Dialogue: 0,0:15:01.40,0:15:05.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tapi kalau dia merasa bersalah\N‎atau terus menyalahkan diri sendiri,{\i0}
Dialogue: 0,0:15:06.78,0:15:10.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎apa yang bisa kulakukan untuk membantunya?{\i0}
Dialogue: 0,0:15:12.78,0:15:15.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Amamiya, kau benar putus dengan Kuriki?
Dialogue: 0,0:15:15.41,0:15:16.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya.
Dialogue: 0,0:15:16.66,0:15:19.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kalau begitu, boleh aku mendekatinya?
Dialogue: 0,0:15:19.91,0:15:22.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa kau tak nyaman kalau seperti itu?
Dialogue: 0,0:15:22.33,0:15:23.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bukan begitu.
Dialogue: 0,0:15:24.59,0:15:27.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak berhak mengatur hal semacam itu.
Dialogue: 0,0:15:27.55,0:15:31.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi kalau kau orangnya,\N‎sebentar lagi pasti punya pacar baru.
Dialogue: 0,0:15:38.60,0:15:40.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Azumi!
Dialogue: 0,0:15:42.19,0:15:43.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Akahoshi?
Dialogue: 0,0:15:43.60,0:15:45.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bagaimana kabar Amamiya?
Dialogue: 0,0:15:45.02,0:15:48.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yah, dia masih murung aneh begitu.
Dialogue: 0,0:15:48.11,0:15:49.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Murung aneh, ya?
Dialogue: 0,0:15:49.19,0:15:52.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Akhir pekan ini, dia ulang tahun.
Dialogue: 0,0:15:54.45,0:15:55.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Benarkah?
Dialogue: 0,0:15:55.91,0:15:57.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Lupa, ya?
Dialogue: 0,0:15:57.74,0:15:59.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Kasihan Amamiya.
Dialogue: 0,0:15:59.20,0:16:02.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Karena ini ulang tahunnya,\N‎aku ingin melakukan sesuatu,
Dialogue: 0,0:16:02.29,0:16:04.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎tapi aku tak pandai dalam hal begini.
Dialogue: 0,0:16:04.46,0:16:07.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Wah. Ide bagus!
Dialogue: 0,0:16:07.21,0:16:09.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Ini pasti bisa menghiburnya.\N‎- Benar, 'kan?
Dialogue: 0,0:16:10.46,0:16:12.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kalau begitu,\N‎sekalian kita buat lucu saja.
Dialogue: 0,0:16:12.80,0:16:14.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Setuju.\N‎- Ada apa ini?
Dialogue: 0,0:16:17.68,0:16:18.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dan begitulah...
Dialogue: 0,0:16:21.23,0:16:22.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Rencana kejutan ulang tahun!
Dialogue: 0,0:16:23.85,0:16:26.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ayo beli barang-barang\N‎yang bisa digunakan.
Dialogue: 0,0:16:26.81,0:16:28.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya!
Dialogue: 0,0:16:28.11,0:16:30.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mau beli untuk Minato juga?
Dialogue: 0,0:16:30.03,0:16:31.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Kalau ini?\N‎- Tidak perlu.
Dialogue: 0,0:16:35.41,0:16:37.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kalian tak ada kegiatan klub hari ini?
Dialogue: 0,0:16:37.62,0:16:41.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Setelah festival budaya selesai,\N‎ini masanya bersantai.
Dialogue: 0,0:16:41.08,0:16:44.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Klub band juga cuma melakukan\N‎kegiatan masing-masing.
Dialogue: 0,0:16:49.21,0:16:50.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yota bilang klubnya sudah selesai.
Dialogue: 0,0:16:50.92,0:16:51.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Boleh kuajak?
Dialogue: 0,0:16:54.47,0:16:56.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Bikin kaget saja.{\i0}
Dialogue: 0,0:16:56.80,0:17:00.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tapi aku tak perlu gugup terus\N‎saat bersamanya, 'kan?{\i0}
Dialogue: 0,0:17:01.14,0:17:03.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dia juga sudah melupakannya.{\i0}
Dialogue: 0,0:17:03.64,0:17:05.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Itu sudah berlalu.{\i0}
Dialogue: 0,0:17:05.14,0:17:08.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}‎Justru aneh dan tidak sopan\N‎kalau aku terus membesar-besarkannya.{\i0}
Dialogue: 0,0:17:14.28,0:17:16.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kurasa begitu...{\i0}
Dialogue: 0,0:17:17.53,0:17:22.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}‎Yota selama ini hanya memikirkan\N‎cara membuatmu bahagia.{\i0}
Dialogue: 0,0:17:23.45,0:17:26.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dia tak pernah berpikir\N‎untuk dibahagiakan olehmu.{\i0}
Dialogue: 0,0:17:27.21,0:17:30.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Bagiku, kau adalah Miki.
Dialogue: 0,0:17:32.84,0:17:35.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Hentikan! Jangan ingat itu sekarang!{\i0}
Dialogue: 0,0:17:35.42,0:17:37.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yota makan banyak sekali.
Dialogue: 0,0:17:39.85,0:17:41.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kalau begitu, kami lewat sini.
Dialogue: 0,0:17:43.35,0:17:45.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Oh, begitu, ya?
Dialogue: 0,0:17:45.06,0:17:47.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Dah.\N‎- Sampai jumpa besok!
Dialogue: 0,0:17:49.77,0:17:52.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kalau begitu, ayo pulang.\N‎Bareng setengah jalan.
Dialogue: 0,0:17:52.15,0:17:53.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya...
Dialogue: 0,0:18:03.08,0:18:05.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Wah, cuma kami berdua.{\i0}
Dialogue: 0,0:18:05.33,0:18:06.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Wah...{\i0}
Dialogue: 0,0:18:07.37,0:18:09.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Bagaimana ini?{\i0}
Dialogue: 0,0:18:09.92,0:18:13.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku tak suka ini.\N‎Aku tak suka perasaan seperti ini.{\i0}
Dialogue: 0,0:18:13.96,0:18:16.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Seolah-olah cuma aku yang aneh.{\i0}
Dialogue: 0,0:18:17.09,0:18:19.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Rasanya aku tak bisa bersikap biasa.{\i0}
Dialogue: 0,0:18:21.35,0:18:23.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Padahal dulu baik-baik saja.{\i0}
Dialogue: 0,0:18:31.06,0:18:33.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Kucing?\N‎- Di mana?
Dialogue: 0,0:18:33.19,0:18:35.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tadi sepertinya aku melihat hewan.
Dialogue: 0,0:18:36.07,0:18:37.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ayo coba lihat.
Dialogue: 0,0:18:37.53,0:18:40.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tadi apa, ya?\N‎Gawat, aku malah jadi semangat.
Dialogue: 0,0:18:40.41,0:18:42.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bagaimana kalau itu {\i1}‎tsuchinoko?{\i0}
Dialogue: 0,0:18:44.83,0:18:46.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Lihat! Itu dia!
Dialogue: 0,0:18:49.25,0:18:51.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yota, apa minus lensamu perlu ditambah?
Dialogue: 0,0:18:53.00,0:18:54.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Satu, dua...
Dialogue: 0,0:19:03.14,0:19:04.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Apa itu?
Dialogue: 0,0:19:08.98,0:19:10.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Tidak... Eh?
Dialogue: 0,0:19:10.77,0:19:13.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku yakin sekali tadi itu hidup.
Dialogue: 0,0:19:13.31,0:19:14.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ini?
Dialogue: 0,0:19:17.78,0:19:19.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Benda apa ini?
Dialogue: 0,0:19:19.28,0:19:20.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan tanya aku!
Dialogue: 0,0:19:20.65,0:19:23.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kukira ini cuma ada di film koboi.{\i0}
Dialogue: 0,0:19:25.24,0:19:27.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku malah jadi menyukainya. Anak pintar.
Dialogue: 0,0:19:36.04,0:19:37.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sudah kuduga.{\i0}
Dialogue: 0,0:19:39.42,0:19:41.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku suka menghabiskan waktu bersama Yota.{\i0}
Dialogue: 0,0:19:43.55,0:19:45.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku suka diriku saat bersamanya.{\i0}
Dialogue: 0,0:19:47.72,0:19:49.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku suka Yota.{\i0}
Dialogue: 0,0:19:51.35,0:19:53.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Bukan sekadar cinta atau teman.{\i0}
Dialogue: 0,0:19:54.35,0:19:55.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku suka dia sebagai manusia.{\i0}
Dialogue: 0,0:19:57.40,0:19:59.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Padahal ini hal yang sederhana.{\i0}
Dialogue: 0,0:20:00.07,0:20:02.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Memang begini seharusnya dari dulu.{\i0}
Dialogue: 0,0:20:02.99,0:20:06.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kenapa sekarang\N‎aku malah terlalu memikirkannya?{\i0}
Dialogue: 0,0:20:08.45,0:20:10.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Astaga, lucu sekali.
Dialogue: 0,0:20:10.87,0:20:11.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ayo pulang.
Dialogue: 0,0:20:13.58,0:20:15.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dah, Pokojiro.
Dialogue: 0,0:20:15.21,0:20:16.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Adiknya Pokota?
Dialogue: 0,0:20:18.71,0:20:20.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hup, hup...
Dialogue: 0,0:20:20.63,0:20:22.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Naiknya lumayan menguras tenaga.
Dialogue: 0,0:20:22.38,0:20:23.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Benar.
Dialogue: 0,0:20:27.93,0:20:28.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aman.
Dialogue: 0,0:20:30.93,0:20:33.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau baik-baik saja? Hati-hati.
Dialogue: 0,0:20:33.19,0:20:34.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya.
Dialogue: 0,0:20:34.98,0:20:36.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima kasih.
Dialogue: 0,0:20:41.86,0:20:42.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Satu, dua...
Dialogue: 0,0:20:42.95,0:20:44.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hup!
Dialogue: 0,0:20:45.86,0:20:47.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tadi aku lengah.
Dialogue: 0,0:20:47.53,0:20:48.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Coba fokus.
Dialogue: 0,0:20:49.58,0:20:52.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Jangan terlalu dipikirkan.{\i0}
Dialogue: 0,0:20:52.08,0:20:53.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Biasa saja.{\i0}
Dialogue: 0,0:21:00.84,0:21:02.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}‎- Anginnya...{\i0}\N‎- Oh.
Dialogue: 0,0:21:03.17,0:21:04.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku suka angin begini.
Dialogue: 0,0:21:07.22,0:21:08.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sebentar lagi musim gugur.
Dialogue: 0,0:21:09.76,0:21:11.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Rasanya jadi bersemangat, ya?
Dialogue: 0,0:21:11.89,0:21:16.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi saat udara mulai sejuk\N‎dan musim berganti seperti ini,
Dialogue: 0,0:21:16.52,0:21:18.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎momen inilah yang membuatku\N‎paling bersemangat.
Dialogue: 0,0:21:21.61,0:21:22.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tidak bisa.{\i0}
Dialogue: 0,0:21:24.49,0:21:26.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sudah tak bisa lagi.{\i0}
Dialogue: 0,0:21:27.99,0:21:31.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Eh, mustahil. Eh?{\i0}
Dialogue: 0,0:21:31.87,0:21:34.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tidak. Mustahil.{\i0}
Dialogue: 0,0:21:36.42,0:21:38.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sampai jumpa besok.
Dialogue: 0,0:22:00.06,0:22:03.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Senyumku belum hilang sejak keseruan tadi.{\i0}
Dialogue: 0,0:22:04.94,0:22:10.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Langkah kakiku terasa ringan\N‎karena perasaan semangat dan gugup.{\i0}
Dialogue: 0,0:22:11.70,0:22:14.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Meski begitu, hatiku terasa sesak.{\i0}
Dialogue: 0,0:22:14.95,0:22:16.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sampai mau menangis.{\i0}
Dialogue: 0,0:22:16.96,0:22:19.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Bagaimana ini?{\i0}
Dialogue: 0,0:22:20.42,0:22:22.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sederhananya, ini cinta.{\i0}
Dialogue: 0,0:23:50.92,0:23:55.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Terjemahan subtitle oleh Shoffanny R
