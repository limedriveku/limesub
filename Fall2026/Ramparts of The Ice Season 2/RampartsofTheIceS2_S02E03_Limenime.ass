Dialogue: 0,0:06:59.12,0:07:01.00,sign,,0000,0000,0000,,‎PACARAN - JANGAN PACARAN\N‎LUPAKAN - JANGAN LUPAKAN
Dialogue: 0,0:07:22.23,0:07:23.31,sign,,0000,0000,0000,,‎BUKA
Dialogue: 0,0:09:42.58,0:09:43.66,sign,,0000,0000,0000,,{\an8}‎LA-DI-DA
Dialogue: 0,0:10:00.85,0:10:02.35,sign,,0000,0000,0000,,{\an8}‎HA?
Dialogue: 0,0:10:52.27,0:10:53.77,sign,,0000,0000,0000,,‎EH?
Dialogue: 0,0:14:25.48,0:14:27.03,sign,,0000,0000,0000,,{\an8}‎BENAR-BENAR BERPIKIR "YA SUDAHLAH"
Dialogue: 0,0:14:28.99,0:14:30.41,sign,,0000,0000,0000,,‎BENAR-BENAR LAPAR
Dialogue: 0,0:14:33.03,0:14:34.41,sign,,0000,0000,0000,,{\an8}‎BINGUNG\N‎SEMANGAT, AKINE!
Dialogue: 0,0:15:16.54,0:15:18.04,sign,,0000,0000,0000,,‎FESTIVAL
Dialogue: 0,0:15:37.06,0:15:38.89,sign,,0000,0000,0000,,‎RAMAI
Dialogue: 0,0:15:48.19,0:15:50.36,sign,,0000,0000,0000,,{\an8}‎KURIKI MOMOKA\N‎PANGGILAN SUARA - PANGGILAN VIDEO - PESAN
Dialogue: 0,0:16:46.00,0:16:49.00,sign,,0000,0000,0000,,{\an8}‎YAKISOBA - KENTANG GORENG - PERMEN PISANG
Dialogue: 0,0:17:14.15,0:17:15.65,sign,,0000,0000,0000,,{\an8}‎PEGANG ERAT
Dialogue: 0,0:17:24.12,0:17:25.25,sign,,0000,0000,0000,,‎SOSIS - PERMEN APEL
Dialogue: 0,0:17:25.25,0:17:26.58,sign,,0000,0000,0000,,‎KUMPUL SETELAH JAJAN MASING-MASING
Dialogue: 0,0:17:28.75,0:17:31.75,sign,,0000,0000,0000,,‎PERMAINAN MENEMBAK\N‎DOR DOR DOR
Dialogue: 0,0:17:33.26,0:17:35.34,sign,,0000,0000,0000,,{\an8}‎HADIAH YANG SUSAH DIDAPATKAN
Dialogue: 0,0:17:35.34,0:17:36.68,sign,,0000,0000,0000,,{\an8}‎PANTUL PANTUL
Dialogue: 0,0:18:20.34,0:18:21.43,sign,,0000,0000,0000,,{\an8}‎DEG-DEG
Dialogue: 0,0:18:26.60,0:18:27.68,sign,,0000,0000,0000,,{\an8}‎DEG-DEG
Dialogue: 0,0:18:31.36,0:18:32.86,sign,,0000,0000,0000,,‎EH\N‎RAMAI
Dialogue: 0,0:19:31.29,0:19:32.37,sign,,0000,0000,0000,,{\i1}‎RAMUNE{\i0}
Dialogue: 0,0:20:24.38,0:20:25.47,sign,,0000,0000,0000,,{\i1}‎RAMUNE{\i0}
Dialogue: 0,0:20:33.35,0:20:34.65,sign,,0000,0000,0000,,‎TANGANKU LENGKET
Dialogue: 0,0:00:12.84,0:00:14.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Langkahku menuju sekolah,{\i0}
Dialogue: 0,0:00:15.68,0:00:16.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎dan bahkan perasaanku,{\i0}
Dialogue: 0,0:00:17.72,0:00:19.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎terasa kelam, gelap,{\i0}
Dialogue: 0,0:00:20.68,0:00:21.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎dan berat.{\i0}
Dialogue: 0,0:00:22.85,0:00:24.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Meski begitu, sekarang ini...{\i0}
Dialogue: 0,0:00:25.40,0:00:26.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Koyuki!
Dialogue: 0,0:00:26.69,0:00:28.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Tsukiko. Kau datang lebih cepat.
Dialogue: 0,0:00:30.02,0:00:31.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku tak mau sendirian.{\i0}
Dialogue: 0,0:00:32.57,0:00:35.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ada yang bisa kubantu?
Dialogue: 0,0:00:36.20,0:00:37.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kalau begitu...
Dialogue: 0,0:00:37.28,0:00:39.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku ingin bicara dengan orang lain{\i0}
Dialogue: 0,0:00:39.49,0:00:41.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}‎atau menyibukkan diri dengan pekerjaan.{\i0}
Dialogue: 0,0:00:43.96,0:00:45.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Giliranmu, Minato.
Dialogue: 0,0:00:46.04,0:00:47.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Oh, aku?
Dialogue: 0,0:00:49.38,0:00:50.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Mendengar namanya saja,{\i0}
Dialogue: 0,0:00:51.71,0:00:53.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎mendengar suaranya saja...{\i0}
Dialogue: 0,0:00:54.34,0:00:55.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tak ada yang berubah.{\i0}
Dialogue: 0,0:00:55.93,0:00:57.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kami hanya berteman.{\i0}
Dialogue: 0,0:00:58.26,0:01:00.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Ini yang kuinginkan.{\i0}
Dialogue: 0,0:01:01.93,0:01:04.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku takut berubah,\N‎jadi terus memikirkannya.{\i0}
Dialogue: 0,0:01:05.64,0:01:08.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kupikir pilihan ini paling aman dan damai.{\i0}
Dialogue: 0,0:01:10.11,0:01:13.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tapi entah kenapa,\N‎membayangkan Amamiya punya pacar{\i0}
Dialogue: 0,0:01:13.86,0:01:15.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎tak pernah terpikir olehku.{\i0}
Dialogue: 0,0:01:17.20,0:01:18.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku bodoh.{\i0}
Dialogue: 0,0:01:19.32,0:01:21.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Benar-benar bodoh.{\i0}
Dialogue: 0,0:03:02.30,0:03:03.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Dasar berengsek!
Dialogue: 0,0:03:03.55,0:03:05.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa? Kenapa?
Dialogue: 0,0:03:05.85,0:03:08.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kenapa? Katanya kau pacaran dengan Momoka.
Dialogue: 0,0:03:09.52,0:03:11.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak masuk akal.
Dialogue: 0,0:03:12.10,0:03:16.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yah, aku harus menghadapinya\N‎dengan benar, 'kan?
Dialogue: 0,0:03:16.69,0:03:18.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku hanya perlu memahami perasaannya.
Dialogue: 0,0:03:19.82,0:03:20.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Minato.
Dialogue: 0,0:03:21.45,0:03:24.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau selalu bicara\N‎seolah ingin membantu orang lain,
Dialogue: 0,0:03:24.62,0:03:28.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎tapi kau cuma tak mau melepaskan\N‎rasa suka yang ditujukan padamu!
Dialogue: 0,0:03:29.66,0:03:31.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku ingin bilang begitu,{\i0}
Dialogue: 0,0:03:31.58,0:03:35.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}‎tapi itu bukan perkataan\N‎yang diucapkan demi Koyun.{\i0}
Dialogue: 0,0:03:36.09,0:03:39.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku hanya merasa senang karena disukai.
Dialogue: 0,0:03:39.13,0:03:41.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi jika berpacaran\N‎saat belum bisa menyukainya,
Dialogue: 0,0:03:42.55,0:03:46.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎aku hanya akan memberinya\N‎harapan palsu, 'kan?
Dialogue: 0,0:03:47.39,0:03:51.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Itu cuma perkataan\N‎untuk membenarkan pilihanku sendiri.{\i0}
Dialogue: 0,0:03:53.81,0:03:55.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bagaimana dengan kemauanmu?
Dialogue: 0,0:03:55.98,0:03:59.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa kau menyukai Momoka?
Dialogue: 0,0:03:59.36,0:04:00.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak, 'kan?
Dialogue: 0,0:04:00.90,0:04:03.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan memutuskan sepihak begitu.
Dialogue: 0,0:04:03.86,0:04:06.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kalau kau hanya membalas perasaannya,
Dialogue: 0,0:04:06.24,0:04:07.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎akhirnya pasti akan sama saja.
Dialogue: 0,0:04:08.87,0:04:13.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Makanya kami berpacaran, 'kan?\N‎Agar saling kenal.
Dialogue: 0,0:04:15.50,0:04:22.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Memang benar, seperti katamu,\N‎idealnya adalah saling suka sejak awal,
Dialogue: 0,0:04:22.88,0:04:25.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎tapi itu hampir mustahil, 'kan?
Dialogue: 0,0:04:26.34,0:04:30.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Bukannya kebanyakan orang\N‎mulai berpacaran seperti ini?
Dialogue: 0,0:04:30.93,0:04:34.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku tak mau mempertahankan ego\N‎yang tak membahagiakan siapa pun.{\i0}
Dialogue: 0,0:04:35.02,0:04:37.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Lebih mudah membalas perasaan orang lain.
Dialogue: 0,0:04:38.19,0:04:39.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa maksudnya itu?
Dialogue: 0,0:04:40.32,0:04:44.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Seolah-olah siapa pun boleh,\N‎asalkan gadis itu menyukainya.{\i0}
Dialogue: 0,0:04:45.53,0:04:46.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Artinya...{\i0}
Dialogue: 0,0:04:49.03,0:04:50.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tidak.{\i0}
Dialogue: 0,0:04:50.29,0:04:54.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku tak mau dia pacaran dengan Koyun\N‎kalau tak serius seperti itu.{\i0}
Dialogue: 0,0:04:54.71,0:04:57.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku tahu\N‎seharusnya aku tak marah soal ini.{\i0}
Dialogue: 0,0:04:57.96,0:04:59.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku tahu, tapi...{\i0}
Dialogue: 0,0:05:00.63,0:05:03.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}‎Kesal rasanya kalau perasaan ini\N‎tak bisa dilampiaskan!{\i0}
Dialogue: 0,0:05:05.55,0:05:07.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ada orang di sini?
Dialogue: 0,0:05:08.39,0:05:10.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Eh, ada apa ini?
Dialogue: 0,0:05:11.51,0:05:13.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tanpa kusadari,{\i0}
Dialogue: 0,0:05:13.98,0:05:16.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎aku mulai mengisi kekosongan di hatiku{\i0}
Dialogue: 0,0:05:16.98,0:05:20.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎dengan berbagai hal dari orang lain.{\i0}
Dialogue: 0,0:05:20.82,0:05:24.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Hatiku dipenuhi keseimbangan yang ajaib.{\i0}
Dialogue: 0,0:05:25.53,0:05:27.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tidak bisa dianggap remeh.{\i0}
Dialogue: 0,0:05:28.82,0:05:31.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dan aku tak pernah menyadarinya.{\i0}
Dialogue: 0,0:05:31.74,0:05:37.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sekarang hatiku kembali kosong,\N‎dan aku tak tahu harus diisi dengan apa.{\i0}
Dialogue: 0,0:05:38.96,0:05:40.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Wah, ada kemajuan.
Dialogue: 0,0:05:43.30,0:05:46.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Peti harta karun?\N‎- Kelihatan, ya? Syukurlah.
Dialogue: 0,0:05:48.01,0:05:50.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}‎Abaikan saja. Jangan dipikirkan.{\i0}
Dialogue: 0,0:05:50.64,0:05:53.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Di mana kuas yang besar tadi?{\i0}
Dialogue: 0,0:05:53.89,0:05:55.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Di sana.
Dialogue: 0,0:05:58.19,0:06:00.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Koyun. Rambutmu. Catnya!
Dialogue: 0,0:06:04.78,0:06:06.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Mengagetkan!{\i0}
Dialogue: 0,0:06:07.61,0:06:10.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hampir saja. Sebaiknya kumasukkan.
Dialogue: 0,0:06:10.28,0:06:11.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Terima ka...
Dialogue: 0,0:06:15.50,0:06:16.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Bisa-bisanya begini?
Dialogue: 0,0:06:21.13,0:06:22.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei.
Dialogue: 0,0:06:23.54,0:06:24.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tidak bisa.{\i0}
Dialogue: 0,0:06:25.42,0:06:26.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf.
Dialogue: 0,0:06:27.17,0:06:29.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Terima kasih.\N‎- Kau tertawa.
Dialogue: 0,0:06:29.18,0:06:30.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku menyukainya.{\i0}
Dialogue: 0,0:06:35.26,0:06:36.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ada sikat gosok.
Dialogue: 0,0:06:36.56,0:06:37.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hus.
Dialogue: 0,0:06:39.69,0:06:41.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dulu saat masih punya pilihan,{\i0}
Dialogue: 0,0:06:42.11,0:06:44.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎aku terlalu banyak berpikir\N‎dan akhirnya kabur.{\i0}
Dialogue: 0,0:06:45.86,0:06:47.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tapi begitu kesempatanku hilang...{\i0}
Dialogue: 0,0:06:48.15,0:06:50.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Andai aku bisa lebih jujur,{\i0}
Dialogue: 0,0:06:51.49,0:06:52.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎andai aku tak kabur,{\i0}
Dialogue: 0,0:06:53.20,0:06:56.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎andai kukatakan perasaanku,\N‎meski dia menolaknya...{\i0}
Dialogue: 0,0:06:56.33,0:06:59.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sekarang aku hanya menyesali\N‎pilihan yang hilang itu.{\i0}
Dialogue: 0,0:07:02.54,0:07:05.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku terlambat menyadari perasaanku.{\i0}
Dialogue: 0,0:07:14.55,0:07:15.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Ya!
Dialogue: 0,0:07:16.22,0:07:17.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei, Koyun!
Dialogue: 0,0:07:18.89,0:07:19.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ada apa?
Dialogue: 0,0:07:20.56,0:07:22.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ada yang perlu dibicarakan.
Dialogue: 0,0:07:23.31,0:07:24.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ikut aku ke kantor.
Dialogue: 0,0:07:24.94,0:07:26.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu buku pelajarmu...
Dialogue: 0,0:07:26.98,0:07:28.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Minato, maaf.
Dialogue: 0,0:07:28.23,0:07:30.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Koyun kubawa dulu.
Dialogue: 0,0:07:36.16,0:07:37.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mau bicara soal apa?
Dialogue: 0,0:07:37.66,0:07:39.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak bisa saat pulang sekolah?
Dialogue: 0,0:07:39.75,0:07:42.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak, bukan aku yang mau bicara denganmu.
Dialogue: 0,0:07:46.67,0:07:49.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Atagawa yang mau bicara denganmu.
Dialogue: 0,0:07:53.80,0:07:55.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Eh?\N‎- Butuh aku juga?
Dialogue: 0,0:07:56.05,0:07:57.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Tidak.\N‎- Kejamnya.
Dialogue: 0,0:08:02.48,0:08:03.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Sebenarnya...
Dialogue: 0,0:08:05.02,0:08:06.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Hei, diam!
Dialogue: 0,0:08:06.77,0:08:09.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tunggu, apa mereka berdua berpacaran?
Dialogue: 0,0:08:09.03,0:08:10.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sepertinya begitu.
Dialogue: 0,0:08:10.65,0:08:12.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kuriki belum bilang apa pun?
Dialogue: 0,0:08:12.78,0:08:14.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kupikir kalian berdua dekat.
Dialogue: 0,0:08:15.41,0:08:16.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak juga.
Dialogue: 0,0:08:17.33,0:08:19.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kami tak pernah benar-benar dekat.{\i0}
Dialogue: 0,0:08:19.49,0:08:22.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dia hanya menganggapku berguna,{\i0}
Dialogue: 0,0:08:22.41,0:08:25.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎dan sekarang\N‎aku sudah tak dibutuhkan lagi.{\i0}
Dialogue: 0,0:08:25.33,0:08:26.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku tak peduli.{\i0}
Dialogue: 0,0:08:27.21,0:08:29.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Eh, jadi...
Dialogue: 0,0:08:30.42,0:08:31.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Serius?
Dialogue: 0,0:08:34.38,0:08:39.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku benar-benar mengira\N‎Minato dan Koyun itu saling suka.
Dialogue: 0,0:08:41.02,0:08:47.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kupikir mereka terlihat sangat cocok\N‎saat kita main kembang api itu.
Dialogue: 0,0:08:47.19,0:08:48.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sayang sekali.
Dialogue: 0,0:08:48.27,0:08:49.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Eh, tunggu dulu.
Dialogue: 0,0:08:49.77,0:08:52.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bukankah kau menyukai Koyuki?
Dialogue: 0,0:08:54.32,0:08:58.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya, memang suka,\N‎tapi dia sudah seperti keluarga.
Dialogue: 0,0:08:58.20,0:08:59.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sudah seperti adikku.
Dialogue: 0,0:08:59.62,0:09:01.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bukannya kau yang lebih muda?
Dialogue: 0,0:09:01.87,0:09:04.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dulu pernah bilang\N‎kalian mau menikah, 'kan?
Dialogue: 0,0:09:04.29,0:09:06.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Oh, kalau soal itu...
Dialogue: 0,0:09:06.83,0:09:09.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Koyun selalu bilang tak mau menikah,
Dialogue: 0,0:09:09.42,0:09:13.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎jadi kubilang kami menikah saja\N‎kalau masih sama-sama jomlo.
Dialogue: 0,0:09:14.17,0:09:17.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Azumi dan Koyuki bukan saling suka?{\i0}
Dialogue: 0,0:09:18.76,0:09:20.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Begitulah kejadiannya.
Dialogue: 0,0:09:20.68,0:09:22.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Eh?
Dialogue: 0,0:09:22.52,0:09:24.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Eh, tunggu dulu.
Dialogue: 0,0:09:24.68,0:09:27.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}‎Jadi, dia memang salah paham tentangku!{\i0}
Dialogue: 0,0:09:28.31,0:09:31.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tapi yang terpenting, Yuki tahu soal kami?{\i0}
Dialogue: 0,0:09:31.52,0:09:34.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Ini terlalu berlebihan\N‎sampai tak masuk ke otak...{\i0}
Dialogue: 0,0:09:35.32,0:09:37.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku...
Dialogue: 0,0:09:37.03,0:09:42.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku benar-benar mengira\N‎Amamiya menyukaimu secara sepihak.
Dialogue: 0,0:09:43.66,0:09:46.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}‎Lalu aku tahu\N‎kalau Momoka menyukai Amamiya.{\i0}
Dialogue: 0,0:09:47.08,0:09:50.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kupikir jika aku bisa membuat\N‎Amamiya melupakanmu...{\i0}
Dialogue: 0,0:09:50.84,0:09:54.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku benar-benar sudah kelewatan.
Dialogue: 0,0:09:55.09,0:09:57.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku minta maaf.
Dialogue: 0,0:09:57.17,0:09:59.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak, kau tak perlu minta maaf soal ini.
Dialogue: 0,0:10:02.35,0:10:07.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi kenapa kau mau\N‎aku dan Yuki berpacaran?
Dialogue: 0,0:10:09.27,0:10:14.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Aku ingin Azumi bahagia\N‎dengan orang yang dia sukai.
Dialogue: 0,0:10:16.07,0:10:17.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Itu...
Dialogue: 0,0:10:18.40,0:10:19.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau menyukainya, ya?
Dialogue: 0,0:10:21.49,0:10:24.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Tidak. Aku tak akan menyebutnya begitu.
Dialogue: 0,0:10:24.70,0:10:28.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Aku hanya mengaguminya sejak SMP\N‎secara sepihak.
Dialogue: 0,0:10:28.75,0:10:31.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎- Eh, suka?\N‎- Bukan.
Dialogue: 0,0:10:32.59,0:10:36.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku menganggapnya\N‎sebagai orang dari dunia yang berbeda.
Dialogue: 0,0:10:36.63,0:10:40.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Pikiran untuk berpacaran dengannya\N‎tak pernah terlintas di benakku.
Dialogue: 0,0:10:42.26,0:10:44.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Rasanya dia mirip aku.{\i0}
Dialogue: 0,0:10:44.68,0:10:48.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak masalah\N‎kalau dia tak menyadari keberadaanku.
Dialogue: 0,0:10:48.77,0:10:52.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia ada dalam hidupku saja sudah cukup.
Dialogue: 0,0:10:53.77,0:10:59.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Makanya, cinta atau semacamnya,\N‎pemikiran kalau dia menyukaiku
Dialogue: 0,0:10:59.03,0:11:01.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎itu tak sesuai dengan isi kepalaku.
Dialogue: 0,0:11:03.16,0:11:04.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi
Dialogue: 0,0:11:04.41,0:11:07.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎jika Azumi benar menyukaimu,
Dialogue: 0,0:11:08.66,0:11:11.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎aku ingin mendukung idolanya idolaku.
Dialogue: 0,0:11:13.83,0:11:16.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}‎Bagaimana ini?\N‎Aku belum pernah merasa begini.{\i0}
Dialogue: 0,0:11:17.30,0:11:20.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Karena Azumi sering membicarakanmu,
Dialogue: 0,0:11:21.51,0:11:23.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎aku jadi penasaran kau itu seperti apa.
Dialogue: 0,0:11:24.76,0:11:28.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kenapa kau merasa seperti itu pada Yuki?
Dialogue: 0,0:11:29.98,0:11:32.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak akur dengan kakakku.
Dialogue: 0,0:11:35.40,0:11:41.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Kakakku selalu merendahkan orang lain\N‎agar dia terlihat lebih unggul.
Dialogue: 0,0:11:41.95,0:11:45.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Dia tipe orang yang paling kubenci\N‎di dunia ini.
Dialogue: 0,0:11:46.74,0:11:49.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dia hanya memikirkan dirinya sendiri{\i0}
Dialogue: 0,0:11:49.58,0:11:52.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎dan suka berbuat kasar\N‎tergantung suasana hatinya.{\i0}
Dialogue: 0,0:11:53.58,0:11:55.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei, Gendut.
Dialogue: 0,0:11:55.08,0:11:57.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kenapa tadi kau bicara denganku?
Dialogue: 0,0:11:58.67,0:12:00.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sudah kubilang\N‎jangan begitu saat ada orang.
Dialogue: 0,0:12:01.42,0:12:03.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi kau lupa bawa bekal.
Dialogue: 0,0:12:03.84,0:12:07.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Satu hari tanpa bekal\N‎tak akan membuatku mati.
Dialogue: 0,0:12:09.01,0:12:12.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Memalukan kalau harus bicara\N‎dengan orang jelek sepertimu.
Dialogue: 0,0:12:12.14,0:12:14.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Potongan rambutmu juga menjijikkan.
Dialogue: 0,0:12:15.27,0:12:18.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Rasanya seperti ada di neraka terus.{\i0}
Dialogue: 0,0:12:19.19,0:12:20.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei, Atagawa!
Dialogue: 0,0:12:21.24,0:12:22.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau potong rambut?
Dialogue: 0,0:12:23.53,0:12:24.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya...
Dialogue: 0,0:12:24.49,0:12:26.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bagus sekali!
Dialogue: 0,0:12:26.53,0:12:27.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terlihat segar.
Dialogue: 0,0:12:28.99,0:12:31.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku juga sepertinya harus potong rambut.
Dialogue: 0,0:12:32.00,0:12:34.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yuki! Ayo ke kantin sekolah.
Dialogue: 0,0:12:34.04,0:12:35.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Oke!
Dialogue: 0,0:12:35.62,0:12:37.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Nanti kutunjukkan setelah potong rambut.
Dialogue: 0,0:12:40.13,0:12:41.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sampai jumpa.
Dialogue: 0,0:12:42.01,0:12:47.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Makanya, melihat orang seperti Azumi\N‎yang selalu jujur dan ceria
Dialogue: 0,0:12:47.47,0:12:49.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎membuat hatiku terselamatkan.
Dialogue: 0,0:12:49.39,0:12:52.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia tak bermuka dua pada siapa pun.
Dialogue: 0,0:12:53.02,0:12:56.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia juga tak mengejek diriku yang dulu
Dialogue: 0,0:12:56.48,0:12:58.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎dan memperlakukanku seperti biasa.
Dialogue: 0,0:12:58.90,0:12:59.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Makanya,
Dialogue: 0,0:13:00.86,0:13:02.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎aku mengaguminya.
Dialogue: 0,0:13:03.32,0:13:09.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Itu sudah bisa disebut "suka"\N‎dalam arti "romantis", 'kan?{\i0}
Dialogue: 0,0:13:09.53,0:13:11.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Akine.
Dialogue: 0,0:13:11.16,0:13:15.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Pokoknya, di antara Yuki dan aku,\N‎tak ada hubungan romantis sama sekali.
Dialogue: 0,0:13:17.25,0:13:19.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan cuma melihat dan mengaguminya.
Dialogue: 0,0:13:20.79,0:13:23.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mulai sekarang,\N‎tetaplah berteman dengan Yuki, ya?
Dialogue: 0,0:13:24.05,0:13:26.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Anggap ini permintaan kakaknya.
Dialogue: 0,0:13:26.72,0:13:28.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terpikirkan, ya?
Dialogue: 0,0:13:29.89,0:13:31.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Akine.
Dialogue: 0,0:13:31.06,0:13:34.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan biarkan kata-kata jahat orang lain\N‎yang ingin menyakitimu
Dialogue: 0,0:13:35.18,0:13:37.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎membuatmu merasa rendah diri.
Dialogue: 0,0:13:39.44,0:13:42.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan bandingkan dirimu\N‎dengan Yuki atau siapa pun.
Dialogue: 0,0:13:42.48,0:13:45.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan pernah merasa dirimu tak cukup.
Dialogue: 0,0:13:47.45,0:13:48.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau benar.
Dialogue: 0,0:13:53.33,0:13:54.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Sampai jumpa.\N‎- Hei...
Dialogue: 0,0:13:55.33,0:14:01.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku sudah menyita waktumu\N‎hanya untuk meringankan rasa bersalahku.
Dialogue: 0,0:14:02.42,0:14:03.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku minta maaf.
Dialogue: 0,0:14:03.71,0:14:05.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak. Tak apa.
Dialogue: 0,0:14:06.55,0:14:08.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Kalau begitu, sampai jumpa.
Dialogue: 0,0:14:11.97,0:14:13.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sudah selesai?
Dialogue: 0,0:14:14.35,0:14:15.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Eh, kenapa...
Dialogue: 0,0:14:16.10,0:14:18.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kupikir aku akan menunggumu.
Dialogue: 0,0:14:18.94,0:14:21.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau juga tak menyuruhku pulang.
Dialogue: 0,0:14:21.06,0:14:23.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku juga tak bilang mau pulang bersama.
Dialogue: 0,0:14:23.36,0:14:25.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Ya sudahlah. Ayo pulang bersama.
Dialogue: 0,0:14:27.82,0:14:28.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mau makan dulu?
Dialogue: 0,0:14:36.50,0:14:38.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Amamiya.
Dialogue: 0,0:14:39.50,0:14:41.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tanganmu sudah bersih?
Dialogue: 0,0:14:41.75,0:14:43.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Ya. Kinclong.
Dialogue: 0,0:14:45.17,0:14:46.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yuki mau apa tadi?
Dialogue: 0,0:14:54.26,0:14:55.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Rahasia.
Dialogue: 0,0:15:01.02,0:15:03.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Shimojima! Hikawa!
Dialogue: 0,0:15:06.03,0:15:07.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ada apa?
Dialogue: 0,0:15:07.57,0:15:09.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hari ini tak ada latihan pemeran, 'kan?
Dialogue: 0,0:15:09.65,0:15:11.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hari ini jadwal latihan band.
Dialogue: 0,0:15:11.20,0:15:12.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Makanya aku juga di sini.
Dialogue: 0,0:15:12.78,0:15:15.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei, ada festival lusa nanti.
Dialogue: 0,0:15:15.24,0:15:16.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mau pergi bareng?
Dialogue: 0,0:15:18.04,0:15:20.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Wah, tiba-tiba ada acara musim panas!
Dialogue: 0,0:15:21.08,0:15:23.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Pasti mau menikmati musim panas, 'kan?
Dialogue: 0,0:15:23.13,0:15:24.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mau!
Dialogue: 0,0:15:24.21,0:15:26.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sejujurnya, aku jarang memikirkannya.
Dialogue: 0,0:15:26.50,0:15:28.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi sekarang aku bersemangat.
Dialogue: 0,0:15:29.09,0:15:31.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Ayo ajak Hino dan Azumi juga!
Dialogue: 0,0:15:31.68,0:15:33.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Ikut!{\i0}
Dialogue: 0,0:15:33.43,0:15:35.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hino juga bilang ikut.
Dialogue: 0,0:15:35.22,0:15:37.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dua orang ini cepat sekali responsnya.
Dialogue: 0,0:15:38.89,0:15:40.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ada apa?
Dialogue: 0,0:15:41.02,0:15:42.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Minato.
Dialogue: 0,0:15:42.60,0:15:44.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ayo ikut ke festival!
Dialogue: 0,0:15:54.95,0:15:57.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kalau kau hanya membalas perasaannya,
Dialogue: 0,0:15:57.45,0:15:59.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎akhirnya pasti akan sama saja.
Dialogue: 0,0:16:00.12,0:16:04.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Makanya kami berpacaran, 'kan?\N‎Agar saling kenal.
Dialogue: 0,0:16:08.59,0:16:09.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Halo?{\i0}
Dialogue: 0,0:16:11.17,0:16:14.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Momoka. Mau ke festival akhir pekan ini?
Dialogue: 0,0:16:15.22,0:16:18.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Daichi dan yang lain mengajakku pergi.{\i0}
Dialogue: 0,0:16:18.39,0:16:21.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kalau kau mau ke festival,\N‎aku mau menolak mereka.{\i0}
Dialogue: 0,0:16:21.35,0:16:22.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mau!
Dialogue: 0,0:16:22.85,0:16:28.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tapi hari itu\N‎aku sudah ada janji dengan temanku.{\i0}
Dialogue: 0,0:16:28.36,0:16:31.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Maaf. Pergilah main\N‎dengan Midorikawa dan yang lain.{\i0}
Dialogue: 0,0:16:31.82,0:16:33.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Begitu, ya. Baik.
Dialogue: 0,0:16:37.74,0:16:40.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Lain kali kita ke tempat lain saja, ya?
Dialogue: 0,0:16:41.70,0:16:42.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya.
Dialogue: 0,0:16:49.00,0:16:51.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Festivalnya besar juga.
Dialogue: 0,0:16:51.26,0:16:53.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Banyak yang pakai yukata.
Dialogue: 0,0:16:54.09,0:16:55.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau tak pakai yukata?
Dialogue: 0,0:16:55.68,0:16:57.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Eh? Nanti aku tak bisa naik motor.
Dialogue: 0,0:16:58.35,0:16:59.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf.
Dialogue: 0,0:17:00.10,0:17:01.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku juga ingin pakai yukata.
Dialogue: 0,0:17:02.39,0:17:04.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau pernah pakai yukata, Minato?
Dialogue: 0,0:17:04.73,0:17:05.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Misalnya saat kencan?
Dialogue: 0,0:17:06.90,0:17:08.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak berniat memakainya.
Dialogue: 0,0:17:08.77,0:17:09.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku juga tak ada yukata.
Dialogue: 0,0:17:15.65,0:17:17.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku baik-baik saja.
Dialogue: 0,0:17:20.16,0:17:23.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Koyuki! Ayo makan itu.
Dialogue: 0,0:17:23.04,0:17:24.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ayo.
Dialogue: 0,0:17:26.58,0:17:27.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Apa itu?\N{\i1}‎- Tonpeiyaki.{\i0}
Dialogue: 0,0:17:27.67,0:17:28.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tonpei?{\i0}
Dialogue: 0,0:17:31.75,0:17:33.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Sial.\N‎- Hore!
Dialogue: 0,0:17:37.38,0:17:39.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Aku mau beli {\i1}‎ramune{\i0}‎ dulu.
Dialogue: 0,0:17:39.76,0:17:40.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Oke.
Dialogue: 0,0:17:43.85,0:17:44.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku juga ikut.
Dialogue: 0,0:17:46.14,0:17:47.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tunggu.
Dialogue: 0,0:17:48.65,0:17:49.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Astaga.
Dialogue: 0,0:17:50.23,0:17:51.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}‎- Koyun.\N‎- Koyun.{\i0}
Dialogue: 0,0:17:54.82,0:17:57.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kalau cuma ini, tak apa, 'kan?{\i0}
Dialogue: 0,0:17:57.82,0:17:59.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kami cuma mau beli{\i0} ‎ramune.
Dialogue: 0,0:17:59.91,0:18:00.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sebagai teman biasa.{\i0}
Dialogue: 0,0:18:02.95,0:18:07.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Karena dia sudah punya pacar,\N‎perasaanku hanya akan mengganggu.{\i0}
Dialogue: 0,0:18:09.08,0:18:10.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tapi...{\i0}
Dialogue: 0,0:18:10.33,0:18:14.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku memang menyukainya, apa boleh buat.{\i0}
Dialogue: 0,0:18:15.71,0:18:18.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kalau tak bisa menghilangkan perasaanku,{\i0}
Dialogue: 0,0:18:18.01,0:18:20.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎sembunyikan saja agar tak ketahuan.{\i0}
Dialogue: 0,0:18:21.43,0:18:24.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku sudah tahu perasaanku yang sebenarnya,{\i0}
Dialogue: 0,0:18:24.26,0:18:26.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎aku tak bisa lagi membohongi diri sendiri.{\i0}
Dialogue: 0,0:18:27.68,0:18:29.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}‎Asalkan tak melewati batas pertemanan,{\i0}
Dialogue: 0,0:18:29.85,0:18:30.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎tak apa...{\i0}
Dialogue: 0,0:18:32.86,0:18:34.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Amamiya!
Dialogue: 0,0:19:04.43,0:19:05.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau tak apa?
Dialogue: 0,0:19:08.39,0:19:09.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf!
Dialogue: 0,0:19:09.64,0:19:12.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak, aku juga refleks.
Dialogue: 0,0:19:13.36,0:19:16.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Tanganku lengket gara-gara saus, 'kan?
Dialogue: 0,0:19:16.40,0:19:17.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Eh?
Dialogue: 0,0:19:17.57,0:19:18.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf.
Dialogue: 0,0:19:18.65,0:19:21.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Eh, tidak, kok.
Dialogue: 0,0:19:21.41,0:19:23.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Masa? Baguslah.
Dialogue: 0,0:19:25.87,0:19:27.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Yang barusan itu...{\i0}
Dialogue: 0,0:19:27.66,0:19:30.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Apa masih dalam batas teman biasa?{\i0}
Dialogue: 0,0:19:32.37,0:19:37.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tapi karena hanya aku\N‎yang merasa seperti ini dengannya,{\i0}
Dialogue: 0,0:19:38.51,0:19:40.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎semua cuma jadi alasan.{\i0}
Dialogue: 0,0:19:40.80,0:19:44.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Saat kami berduaan, berjalan berdampingan,{\i0}
Dialogue: 0,0:19:44.43,0:19:46.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎dan tangan bersentuhan...{\i0}
Dialogue: 0,0:19:46.05,0:19:47.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ini.
Dialogue: 0,0:19:49.27,0:19:50.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima kasih.
Dialogue: 0,0:19:52.85,0:19:56.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Hanya jantungku yang berdebar kencang.{\i0}
Dialogue: 0,0:19:57.86,0:19:59.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku harus bersikap biasa.{\i0}
Dialogue: 0,0:19:59.53,0:20:01.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Biasa saja.{\i0}
Dialogue: 0,0:20:02.20,0:20:04.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku sudah lama tak minum {\i1}‎ramune.{\i0}
Dialogue: 0,0:20:04.57,0:20:07.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku selalu minum ini\N‎setiap datang ke festival.
Dialogue: 0,0:20:07.37,0:20:10.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dulu aku sering mencungkil kelerengnya\N‎untuk dibawa pulang.
Dialogue: 0,0:20:10.70,0:20:13.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau boleh ambil kelerengku kalau mau.
Dialogue: 0,0:20:13.96,0:20:15.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Sekarang tak perlu.\N{\i1}‎- Hati-hati.{\i0}
Dialogue: 0,0:20:16.71,0:20:20.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kalau tidak, perasaanku bisa meluap.{\i0}
Dialogue: 0,0:20:21.97,0:20:24.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Untung saja aku bawa tisu basah.
Dialogue: 0,0:20:25.47,0:20:27.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau mau pakai juga?
Dialogue: 0,0:20:28.47,0:20:30.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak perlu.
Dialogue: 0,0:20:30.02,0:20:31.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Punyaku tidak tumpah.
Dialogue: 0,0:20:32.27,0:20:33.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Eh?{\i0}
Dialogue: 0,0:20:35.60,0:20:36.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hari ini...
Dialogue: 0,0:20:36.73,0:20:40.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Kau tak apa ke festival bersama kami?
Dialogue: 0,0:20:41.49,0:20:43.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bagaimana dengan Momoka?
Dialogue: 0,0:20:43.32,0:20:44.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Oh, ya.
Dialogue: 0,0:20:45.57,0:20:47.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Momoka bilang dia sudah ada rencana.
Dialogue: 0,0:20:49.37,0:20:50.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Begitu, ya?
Dialogue: 0,0:20:51.75,0:20:53.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎"Momoka."{\i0}
Dialogue: 0,0:20:54.87,0:20:56.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Mereka sudah kembali.
Dialogue: 0,0:20:56.21,0:20:57.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Akhirnya datang juga.
Dialogue: 0,0:20:57.88,0:20:59.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ada sedikit masalah.
Dialogue: 0,0:20:59.29,0:21:00.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kalian masih bisa makan?
Dialogue: 0,0:21:01.71,0:21:03.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Terlalu senang karena hal-hal kecil.{\i0}
Dialogue: 0,0:21:04.72,0:21:07.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Pura-pura peduli pacarnya\N‎untuk menutupi perasaanku,{\i0}
Dialogue: 0,0:21:07.47,0:21:10.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎padahal tak mendukung hubungan mereka.{\i0}
Dialogue: 0,0:21:10.97,0:21:14.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Mengetahui kenyataannya,\N‎lalu tersakiti sendiri.{\i0}
Dialogue: 0,0:21:16.14,0:21:19.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Semuanya begitu menyedihkan.{\i0}
Dialogue: 0,0:21:19.06,0:21:20.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sangat menggelikan.{\i0}
Dialogue: 0,0:21:20.98,0:21:22.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei, Koyuki.
Dialogue: 0,0:21:23.07,0:21:25.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku sudah lama penasaran.
Dialogue: 0,0:21:25.78,0:21:30.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau dan Amamiya lumayan dekat, 'kan?
Dialogue: 0,0:21:30.37,0:21:32.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bagaimana bilangnya, ya?
Dialogue: 0,0:21:32.95,0:21:34.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maksudku...
Dialogue: 0,0:21:39.88,0:21:40.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tsukiko.
Dialogue: 0,0:21:46.22,0:21:47.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mustahil.
Dialogue: 0,0:21:47.51,0:21:48.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tsukiko.
Dialogue: 0,0:21:49.43,0:21:52.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku harus bagaimana?
Dialogue: 0,0:21:54.43,0:21:56.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Rasanya sakit sekali.
Dialogue: 0,0:21:57.02,0:21:58.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Eh?
Dialogue: 0,0:21:59.02,0:22:00.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Malah begitu?{\i0}
Dialogue: 0,0:23:36.24,0:23:38.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Pantas saja hari ini ramai sekali.
Dialogue: 0,0:23:38.95,0:23:40.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ternyata ada festival.
Dialogue: 0,0:23:40.79,0:23:42.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bukankah lebih baik ke sana?
Dialogue: 0,0:23:42.25,0:23:45.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Tidak, di sini saja.\N‎Makanan kedai festival mahal.
Dialogue: 0,0:23:45.63,0:23:47.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Benar juga.
Dialogue: 0,0:23:47.88,0:23:50.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku juga mau ke sana kalau punya pacar.
Dialogue: 0,0:23:51.72,0:23:52.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya, 'kan, Igarashi?
Dialogue: 0,0:23:52.80,0:23:55.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terjemahan subtitle oleh Shoffanny R
