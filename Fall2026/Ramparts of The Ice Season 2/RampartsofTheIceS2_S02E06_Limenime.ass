Dialogue: 0,0:00:27.44,0:00:28.44,sign,,0000,0000,0000,,‎SURAM
Dialogue: 0,0:00:55.34,0:00:57.05,sign,,0000,0000,0000,,‎KELAS 2-2
Dialogue: 0,0:01:04.60,0:01:05.69,sign,,0000,0000,0000,,‎HAHA
Dialogue: 0,0:01:51.15,0:01:52.40,sign,,0000,0000,0000,,‎FESTIVAL BUDAYA MEITEN
Dialogue: 0,0:03:27.54,0:03:31.92,sign,,0000,0000,0000,,‎EPISODE 20\N‎FESTIVAL BUDAYA
Dialogue: 0,0:05:21.27,0:05:22.90,sign,,0000,0000,0000,,‎WIG - EH
Dialogue: 0,0:06:05.28,0:06:06.28,sign,,0000,0000,0000,,‎PARA PEMERAN UTAMA JADI OBJEK FOTO
Dialogue: 0,0:06:09.03,0:06:10.49,sign,,0000,0000,0000,,‎TATAP…
Dialogue: 0,0:07:21.48,0:07:23.52,sign,,0000,0000,0000,,‎WAJAH-WAJAH KESAL
Dialogue: 0,0:08:38.93,0:08:39.93,sign,,0000,0000,0000,,‎HANYA MAINAN
Dialogue: 0,0:10:11.98,0:10:14.90,sign,,0000,0000,0000,,‎KELAS 1-1\N‎PANEKUK
Dialogue: 0,0:10:58.32,0:10:59.32,sign,,0000,0000,0000,,‎CEKIKIK
Dialogue: 0,0:11:45.95,0:11:48.99,sign,,0000,0000,0000,,‎KELAS 3-3\N‎RUMAH HANTU
Dialogue: 0,0:12:19.40,0:12:20.78,sign,,0000,0000,0000,,‎GEDUNG SEKOLAH - GIMNASIUM\N‎WUS
Dialogue: 0,0:13:01.78,0:13:02.82,sign,,0000,0000,0000,,‎MELELEH
Dialogue: 0,0:13:02.90,0:13:04.36,sign,,0000,0000,0000,,‎MENYAKITKAN…!
Dialogue: 0,0:13:08.82,0:13:10.49,sign,,0000,0000,0000,,‎SEBELUMNYA - KAU ORANGNYA\N‎SEKARANG - SENYUM
Dialogue: 0,0:14:28.03,0:14:29.03,sign,,0000,0000,0000,,‎MAAF, YOTA
Dialogue: 0,0:15:01.77,0:15:04.06,sign,,0000,0000,0000,,‎FESTIVAL BUDAYA MEITEN
Dialogue: 0,0:16:31.69,0:16:32.78,sign,,0000,0000,0000,,‎DEBUK
Dialogue: 0,0:19:12.44,0:19:13.44,sign,,0000,0000,0000,,{\an8}‎HE - HA
Dialogue: 0,0:23:34.24,0:23:36.16,sign,,0000,0000,0000,,‎HANYA MELIHATKU\N‎JAUHI CEWEK LAIN
Dialogue: 0,0:00:13.13,0:00:15.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Libur panjang musim panas sudah berakhir.{\i0}
Dialogue: 0,0:00:16.01,0:00:19.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Liburan musim panas\N‎berlalu begitu cepat, ya?
Dialogue: 0,0:00:19.64,0:00:20.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Benar.
Dialogue: 0,0:00:24.44,0:00:27.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Banyak yang terjadi tahun ini,\N‎aku sampai lupa waktu.
Dialogue: 0,0:00:36.11,0:00:37.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya.
Dialogue: 0,0:00:48.84,0:00:51.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baiklah! Saatnya kembali fokus.
Dialogue: 0,0:00:51.55,0:00:53.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ayo terus berjuang untuk festival budaya!
Dialogue: 0,0:00:54.01,0:00:55.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ayo.
Dialogue: 0,0:00:57.14,0:00:58.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Lama tak jumpa.
Dialogue: 0,0:00:58.34,0:01:00.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Gin, padahal hampir menang tanding.
Dialogue: 0,0:01:01.06,0:01:02.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tahun depan, pasti.
Dialogue: 0,0:01:02.97,0:01:04.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kita libur masih tetap jumpa.
Dialogue: 0,0:01:05.77,0:01:06.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Benar sekali.
Dialogue: 0,0:01:13.44,0:01:15.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baiklah. Sudah selesai.
Dialogue: 0,0:01:15.57,0:01:17.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Memang butuh waktu yang lama.
Dialogue: 0,0:01:17.45,0:01:19.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Syukurlah kita selesai tepat waktu.
Dialogue: 0,0:01:19.78,0:01:22.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Wah! Luar biasa!
Dialogue: 0,0:01:22.33,0:01:24.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Rasanya festival sudah dekat.
Dialogue: 0,0:01:24.75,0:01:28.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sepertinya kostum kita juga\N‎akan selesai akhir pekan ini.
Dialogue: 0,0:01:28.12,0:01:29.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Wah, jadi tak sabar.
Dialogue: 0,0:01:30.59,0:01:32.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau sudah hafal dialogmu?
Dialogue: 0,0:01:32.50,0:01:33.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tenang saja.
Dialogue: 0,0:01:34.51,0:01:37.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Tapi aku takut lupa dialognya saat hari-H.
Dialogue: 0,0:01:38.97,0:01:42.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tahun depan\N‎kita mungkin akan berbeda kelas,
Dialogue: 0,0:01:42.26,0:01:45.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎jadi tahun ini kelas kita harus menang!
Dialogue: 0,0:01:46.31,0:01:47.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa ada syarat untuk menang?
Dialogue: 0,0:01:47.77,0:01:49.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau benar-benar tak tahu?
Dialogue: 0,0:01:52.48,0:01:55.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Akhirnya, hari festival budaya pun tiba.{\i0}
Dialogue: 0,0:03:35.54,0:03:37.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Astaga, aku mulai gugup.
Dialogue: 0,0:03:37.88,0:03:40.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Sepertinya pengunjung tahun ini\N‎lebih banyak dari tahun lalu.
Dialogue: 0,0:03:40.97,0:03:42.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Masa?
Dialogue: 0,0:03:42.09,0:03:43.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Miki dan Yota…
Dialogue: 0,0:03:43.89,0:03:46.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Semangat…
Dialogue: 0,0:03:46.76,0:03:48.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Koyun yang paling gugup di antara kita.
Dialogue: 0,0:03:50.98,0:03:52.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Koyun juga, semangat jadi unta, ya.
Dialogue: 0,0:03:54.98,0:03:56.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Pertunjukannya sebentar lagi dimulai.
Dialogue: 0,0:03:57.52,0:03:59.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Minato, apa kau gugup?
Dialogue: 0,0:03:59.53,0:04:01.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku sangat gugup.
Dialogue: 0,0:04:01.53,0:04:03.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Masa? Kau tak terlihat gugup.
Dialogue: 0,0:04:03.53,0:04:05.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mereka cuma kentang.
Dialogue: 0,0:04:05.74,0:04:08.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Hayato kelihatan sekali gugup\N‎kalau mau tampil.
Dialogue: 0,0:04:10.58,0:04:15.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi kita sudah sejauh ini,\N‎jadi tinggal lakukan yang terbaik.
Dialogue: 0,0:04:15.29,0:04:17.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku akan tampil dengan keren.
Dialogue: 0,0:04:17.63,0:04:19.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Wah. Buatlah kami bangga.
Dialogue: 0,0:04:21.13,0:04:26.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kelas 2-2 akan segera menampilkan\N‎drama{\i0}‎ Aladdin dan Lampu Ajaib.
Dialogue: 0,0:04:27.55,0:04:32.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Nah, Tuan,\N‎akan kukabulkan semua keinginanmu!
Dialogue: 0,0:04:39.07,0:04:42.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Ayo kumpul, Semuanya! Pangeran datang!
Dialogue: 0,0:04:43.07,0:04:44.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Berlututlah!
Dialogue: 0,0:04:45.07,0:04:47.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Putri dan kerajaan ini adalah milikku!
Dialogue: 0,0:04:50.54,0:04:52.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku mencintaimu.
Dialogue: 0,0:05:05.72,0:05:07.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ayo senyum!
Dialogue: 0,0:05:12.72,0:05:16.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Miki! Kami melihat penampilanmu tadi.\N‎Keren sekali!
Dialogue: 0,0:05:17.27,0:05:18.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hore!
Dialogue: 0,0:05:18.48,0:05:21.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Aku juga suka penampilanmu\N‎sebagai putri tahun lalu.
Dialogue: 0,0:05:22.98,0:05:24.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Tolong lupakan!
Dialogue: 0,0:05:24.78,0:05:28.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Aku suka saat Jin dan karpet\N‎menari bersama.
Dialogue: 0,0:05:41.50,0:05:43.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Benarkah?
Dialogue: 0,0:05:46.26,0:05:47.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ada yang memanggil?
Dialogue: 0,0:05:49.18,0:05:50.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu karpetnya.
Dialogue: 0,0:05:50.26,0:05:53.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jin! Karpet! Ayo berfoto.
Dialogue: 0,0:05:53.64,0:05:55.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Para pemeran bayangan kecil.
Dialogue: 0,0:05:58.02,0:05:59.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima kasih!
Dialogue: 0,0:05:59.65,0:06:00.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Fotonya bagus.
Dialogue: 0,0:06:01.52,0:06:04.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Foto sekali lagi. Ayo senyum!
Dialogue: 0,0:06:06.36,0:06:07.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima kasih banyak.
Dialogue: 0,0:06:07.90,0:06:08.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sama-sama.
Dialogue: 0,0:06:10.57,0:06:14.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak, aku tak memakai kostum\N‎atau apa pun,
Dialogue: 0,0:06:14.33,0:06:15.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎jadi tak perlu foto…
Dialogue: 0,0:06:16.04,0:06:17.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Minato! Ayo foto!
Dialogue: 0,0:06:20.04,0:06:22.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ayo. Koyun juga.
Dialogue: 0,0:06:22.13,0:06:24.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Pasang pose yang keren.
Dialogue: 0,0:06:24.75,0:06:26.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku juga foto?
Dialogue: 0,0:06:27.22,0:06:28.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ini, Koyuki.
Dialogue: 0,0:06:30.13,0:06:31.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Lampu ajaib?
Dialogue: 0,0:06:31.93,0:06:33.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sudah siap?
Dialogue: 0,0:06:35.68,0:06:37.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ayo lebih dekat.
Dialogue: 0,0:06:51.49,0:06:53.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ayo berpose!
Dialogue: 0,0:06:55.49,0:06:57.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Foto macam apa ini?
Dialogue: 0,0:06:57.91,0:06:58.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bagus!
Dialogue: 0,0:07:00.67,0:07:03.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Pasti berat memindahkan latar dan lainnya.
Dialogue: 0,0:07:03.38,0:07:04.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kerja bagus.
Dialogue: 0,0:07:05.00,0:07:07.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Amamiya, kau yang lebih kerja keras.
Dialogue: 0,0:07:08.55,0:07:10.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku akan tampil dengan keren.
Dialogue: 0,0:07:10.34,0:07:13.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kukira tadi dia cuma bercanda.{\i0}
Dialogue: 0,0:07:14.05,0:07:15.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau tadi keren.
Dialogue: 0,0:07:17.35,0:07:18.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Hore.
Dialogue: 0,0:07:23.60,0:07:25.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kalian berdua terlalu kentara.
Dialogue: 0,0:07:26.02,0:07:27.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Hei!
Dialogue: 0,0:07:27.98,0:07:31.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku menonton dramanya. Kerja bagus!
Dialogue: 0,0:07:31.11,0:07:34.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yuki dan Akine. Kostum kalian keren.
Dialogue: 0,0:07:36.24,0:07:39.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Kami buka kedai panekuk.\N‎Silakan mampir kalau mau.
Dialogue: 0,0:07:39.41,0:07:40.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Konsepnya apa?
Dialogue: 0,0:07:41.75,0:07:44.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku jadi ingin makanan bertepung.
Dialogue: 0,0:07:44.17,0:07:46.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Panekuk termasuk makanan bertepung?
Dialogue: 0,0:07:46.75,0:07:48.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ayo ganti baju, lalu berkeliling.
Dialogue: 0,0:07:48.71,0:07:49.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ide bagus.
Dialogue: 0,0:07:50.01,0:07:51.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dah!
Dialogue: 0,0:07:55.01,0:07:56.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Nanti aku mampir untuk makan panekuk.
Dialogue: 0,0:07:58.39,0:08:00.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Ada seseorang yang sudah mengajakku.
Dialogue: 0,0:08:00.77,0:08:02.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Oh…
Dialogue: 0,0:08:07.57,0:08:10.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei, Minato.
Dialogue: 0,0:08:11.07,0:08:13.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau benar-benar berpacaran dengan Kuriki?
Dialogue: 0,0:08:14.66,0:08:16.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya, benar.
Dialogue: 0,0:08:17.87,0:08:20.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Oh, begitu rupanya.
Dialogue: 0,0:08:25.37,0:08:27.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dor!
Dialogue: 0,0:08:28.59,0:08:29.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bercanda.
Dialogue: 0,0:08:32.38,0:08:34.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yah, asalkan kau bahagia.
Dialogue: 0,0:08:35.22,0:08:37.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sampai nanti.
Dialogue: 0,0:08:37.14,0:08:38.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Azumi. Jangan menodongkan senapanmu.
Dialogue: 0,0:08:40.01,0:08:41.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baik.
Dialogue: 0,0:08:41.64,0:08:43.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baru kali ini ada peringatan seperti itu.
Dialogue: 0,0:08:43.89,0:08:45.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tak kusangka dia mengatakannya.
Dialogue: 0,0:08:45.85,0:08:48.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa? Apa maksudmu?
Dialogue: 0,0:08:48.36,0:08:49.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Seperti katanya tadi.
Dialogue: 0,0:08:50.32,0:08:52.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Katanya, "Asalkan kau bahagia."
Dialogue: 0,0:08:55.24,0:08:57.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Tak ada standar untuk bahagia.
Dialogue: 0,0:08:58.03,0:08:59.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Pasti berbeda bagi semua orang.
Dialogue: 0,0:08:59.95,0:09:04.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kalau begitu, aku pasti bahagia, 'kan?
Dialogue: 0,0:09:05.54,0:09:08.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi kau sendiri tak yakin,
Dialogue: 0,0:09:08.46,0:09:11.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎kau bahkan tak tahu apa artinya bahagia,
Dialogue: 0,0:09:11.55,0:09:13.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎bukankah itu masalah?
Dialogue: 0,0:09:19.47,0:09:22.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Eh? Masih belum ganti baju?
Dialogue: 0,0:09:22.64,0:09:23.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ayo berkeliling.
Dialogue: 0,0:09:23.89,0:09:27.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bukannya kau mau menemui pacarmu nanti?
Dialogue: 0,0:09:27.23,0:09:30.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Oh, ya. Aku ganti baju dulu.
Dialogue: 0,0:09:32.40,0:09:35.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Eh? Ada apa?{\i0}
Dialogue: 0,0:09:35.95,0:09:39.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Rasanya seperti ada serangga\N‎yang merayap di bawah kulitku.{\i0}
Dialogue: 0,0:09:40.45,0:09:42.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Rasanya aku bahkan tak berdiri di sini.{\i0}
Dialogue: 0,0:09:48.87,0:09:50.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Minato? Ada apa?
Dialogue: 0,0:09:50.54,0:09:53.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Rasanya tadi tanahnya seperti goyang.
Dialogue: 0,0:09:53.88,0:09:56.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau pusing? Kelelahan akibat musim panas?
Dialogue: 0,0:09:56.47,0:09:58.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Akhir-akhir ini kau sering melamun.
Dialogue: 0,0:10:00.39,0:10:01.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Aku melamun?
Dialogue: 0,0:10:01.72,0:10:03.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sekarang pun begitu.
Dialogue: 0,0:10:08.81,0:10:10.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ada apa denganku?
Dialogue: 0,0:10:15.61,0:10:17.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Minato. Masih merasa pusing?
Dialogue: 0,0:10:18.28,0:10:21.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sudah tak apa. Tapi entah apa penyebabnya.
Dialogue: 0,0:10:21.87,0:10:24.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Midori! Hayato!
Dialogue: 0,0:10:24.74,0:10:26.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎- Halo.\N‎- Halo.
Dialogue: 0,0:10:26.62,0:10:29.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Kostumnya aneh. Zombi?
Dialogue: 0,0:10:29.25,0:10:31.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ada yang mau rumah hantu,
Dialogue: 0,0:10:31.50,0:10:35.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎ada yang mau kedai panekuk,\N‎dan ada yang mau tema kesintasan.
Dialogue: 0,0:10:35.38,0:10:37.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kami gabungkan semuanya\N‎dan inilah hasilnya.
Dialogue: 0,0:10:38.26,0:10:40.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Paket keserakahan dari neraka.
Dialogue: 0,0:10:41.01,0:10:42.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf menunggu!
Dialogue: 0,0:10:43.10,0:10:44.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima kasih sudah datang.
Dialogue: 0,0:10:46.93,0:10:48.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau yang membuatnya?
Dialogue: 0,0:10:48.77,0:10:51.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bukan, aku cuma mengantarkannya.
Dialogue: 0,0:10:51.60,0:10:55.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yah, padahal aku ingin lihat penampilanmu.
Dialogue: 0,0:10:55.82,0:10:58.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan, aku malu\N‎kalau kau lihat tingkah kelasku.
Dialogue: 0,0:10:59.40,0:11:02.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Padahal aku tak peduli soal itu.
Dialogue: 0,0:11:02.53,0:11:04.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku yang peduli.
Dialogue: 0,0:11:05.99,0:11:08.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei, Minato. Ayo foto bareng.
Dialogue: 0,0:11:08.50,0:11:09.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Ayo.
Dialogue: 0,0:11:13.42,0:11:15.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sampai jumpa nanti.
Dialogue: 0,0:11:15.46,0:11:16.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sampai jumpa.
Dialogue: 0,0:11:16.92,0:11:21.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Bermesraanlah sesuka kalian,\N‎tapi kalian harus menonton band kami!
Dialogue: 0,0:11:21.97,0:11:24.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎- Kami akan datang.\N‎- Tentu saja kami datang.
Dialogue: 0,0:11:25.35,0:11:28.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia semangat karena seniornya\N‎yang sudah lulus akan datang juga.
Dialogue: 0,0:11:28.68,0:11:30.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak perlu bilang begitu!
Dialogue: 0,0:11:37.69,0:11:41.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Entah kenapa, makanannya sulit ditelan…{\i0}
Dialogue: 0,0:11:54.58,0:11:57.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Rasanya kita bisa melihat semuanya\N‎dalam sekejap.
Dialogue: 0,0:11:57.88,0:12:00.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Karena stan makanan dan acaranya sedikit.
Dialogue: 0,0:12:00.59,0:12:03.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei, kalau masih ada waktu,
Dialogue: 0,0:12:03.51,0:12:06.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎apa boleh main gim lagi di klub komputer?
Dialogue: 0,0:12:06.26,0:12:09.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan bertingkah begitu\N‎di saat yang aneh.
Dialogue: 0,0:12:09.10,0:12:12.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi kita harus segera ke panggung.
Dialogue: 0,0:12:12.77,0:12:16.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ada klub menari, band, dan orkes tiup.\N‎Banyak macamnya, ya.
Dialogue: 0,0:12:16.36,0:12:17.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kita harus melihatnya!
Dialogue: 0,0:12:17.86,0:12:19.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ayo!
Dialogue: 0,0:12:22.86,0:12:25.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Syukurlah kita dapat tempat duduk.
Dialogue: 0,0:12:25.57,0:12:28.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Acaranya belum dimulai,\N‎tapi sorakannya sudah meriah.
Dialogue: 0,0:12:28.66,0:12:30.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jadi tak sabar.
Dialogue: 0,0:12:31.75,0:12:33.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa masih ada tempat duduk?
Dialogue: 0,0:12:33.37,0:12:35.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ayo ke sana.
Dialogue: 0,0:12:35.37,0:12:36.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ke mana?
Dialogue: 0,0:12:36.50,0:12:38.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Di depan. Dekat lorong.
Dialogue: 0,0:12:39.00,0:12:40.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Di sana?
Dialogue: 0,0:12:57.35,0:12:58.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Koyun!\N‎- Koyuki.
Dialogue: 0,0:12:58.90,0:13:01.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tak apa… Sungguh tak apa…
Dialogue: 0,0:13:04.45,0:13:05.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak sanggup melihatnya!
Dialogue: 0,0:13:05.91,0:13:08.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sudah jelas kau orangnya, Koyun.{\i0}
Dialogue: 0,0:13:10.58,0:13:11.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Menakutkan!{\i0}
Dialogue: 0,0:13:11.66,0:13:14.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Hei, Koyun. Apakah harus Mina…
Dialogue: 0,0:13:15.00,0:13:18.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Apakah harus si berengsek itu?\N‎Aku sudah tak tahan lagi.
Dialogue: 0,0:13:18.67,0:13:21.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kalau bisa dilupakan,\N‎aku ingin melupakannya.
Dialogue: 0,0:13:21.84,0:13:24.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kurasa itu yang terbaik.
Dialogue: 0,0:13:24.51,0:13:27.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi sejujurnya,\N‎aku masih belum bisa melupakannya.
Dialogue: 0,0:13:27.97,0:13:29.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sungguh konyol, ya?
Dialogue: 0,0:13:29.68,0:13:32.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku bahkan sudah tak paham lagi ucapanmu.
Dialogue: 0,0:13:33.72,0:13:36.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Pasti masih ada cowok lain\N‎yang lebih baik.
Dialogue: 0,0:13:36.56,0:13:38.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Siapa?\N‎- Itu…
Dialogue: 0,0:13:39.77,0:13:40.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Misalnya…
Dialogue: 0,0:13:42.61,0:13:43.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yot…
Dialogue: 0,0:13:44.49,0:13:48.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Miki. Kau hampir mengatakan sesuatu\N‎yang sangat kejam barusan.
Dialogue: 0,0:13:48.41,0:13:49.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak mungkin, 'kan?
Dialogue: 0,0:13:49.78,0:13:51.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak, habisnya…
Dialogue: 0,0:13:52.91,0:13:56.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Saat memikirkan cowok baik,\N‎Yota yang pertama terlintas di pikiranku.{\i0}
Dialogue: 0,0:13:56.87,0:13:59.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Habisnya, dia memang cowok yang baik.{\i0}
Dialogue: 0,0:14:00.63,0:14:05.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kalau diingat lagi,\N‎Yota bersikap seolah tak terjadi apa-apa.{\i0}
Dialogue: 0,0:14:06.01,0:14:07.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Bagaimana perasaannya sekarang?{\i0}
Dialogue: 0,0:14:08.59,0:14:12.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Apa sekarang dia sudah punya gebetan baru?{\i0}
Dialogue: 0,0:14:13.14,0:14:16.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Apa dia akan menyukai orang lain nantinya?{\i0}
Dialogue: 0,0:14:17.43,0:14:20.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tentu saja begitu.
Dialogue: 0,0:14:20.27,0:14:21.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Miki.
Dialogue: 0,0:14:21.44,0:14:23.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf, boleh duduk di sini?
Dialogue: 0,0:14:24.94,0:14:27.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Dah!\N‎- "Dah"?
Dialogue: 0,0:14:29.11,0:14:30.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tak ada tempat duduk lagi di sana.
Dialogue: 0,0:14:32.74,0:14:33.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Boleh.
Dialogue: 0,0:14:35.12,0:14:36.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ayo bersenang-senang…
Dialogue: 0,0:14:36.79,0:14:38.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ayo…
Dialogue: 0,0:14:48.67,0:14:52.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Akahoshi! Midorikawa!
Dialogue: 0,0:14:54.51,0:14:58.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Akahoshi pasti gugup sekali, ya?
Dialogue: 0,0:14:59.89,0:15:01.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Sepertinya begitu.
Dialogue: 0,0:15:04.15,0:15:08.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dengan demikian,\N‎Festival Budaya SMA Meiten kini selesai.{\i0}
Dialogue: 0,0:15:09.28,0:15:13.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Pemenang Festival Budaya\N‎SMA Meiten tahun ini adalah…
Dialogue: 0,0:15:14.12,0:15:16.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kelas 2-2!
Dialogue: 0,0:15:17.04,0:15:19.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Tidak menang, tapi kerja bagus!
Dialogue: 0,0:15:19.66,0:15:20.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hore!
Dialogue: 0,0:15:23.04,0:15:24.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ayo adakan pesta kecil.
Dialogue: 0,0:15:25.17,0:15:28.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Pak Matsumoto beli jus untuk kita semua.
Dialogue: 0,0:15:28.67,0:15:31.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Pak Matsumoto memang terbaik!
Dialogue: 0,0:15:37.85,0:15:39.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Semuanya terlihat senang.{\i0}
Dialogue: 0,0:15:40.48,0:15:41.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Rasanya…
Dialogue: 0,0:15:41.81,0:15:44.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Antusiasme kita berbeda, ya?
Dialogue: 0,0:15:44.19,0:15:48.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yah, memang yang penting\N‎para pemeran dramanya senang di sini.
Dialogue: 0,0:15:48.32,0:15:50.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yang tak berperan, jadi penonton saja.
Dialogue: 0,0:15:50.86,0:15:53.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Yah, saat banyak orang berkumpul,{\i0}
Dialogue: 0,0:15:54.03,0:15:57.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎memang tak semuanya\N‎bisa merasakan hal yang sama.{\i0}
Dialogue: 0,0:15:58.20,0:15:59.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Lebih tepatnya,{\i0}
Dialogue: 0,0:15:59.33,0:16:02.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎mungkin aku lebih bisa\N‎memahami perasaan mereka.{\i0}
Dialogue: 0,0:16:04.92,0:16:05.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Silakan.
Dialogue: 0,0:16:06.50,0:16:08.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Eh, tidak usah.
Dialogue: 0,0:16:08.50,0:16:11.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Oh, maaf. Kalian tak suka soda?
Dialogue: 0,0:16:11.63,0:16:13.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak, bukan begitu.
Dialogue: 0,0:16:13.51,0:16:15.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Astaga, tadi aku gugup sekali.
Dialogue: 0,0:16:16.01,0:16:18.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Masa?\N‎- Kau tak terlihat gugup.
Dialogue: 0,0:16:18.26,0:16:19.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau seperti penjahat sungguhan.
Dialogue: 0,0:16:33.65,0:16:36.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Oh, begitu rupanya…{\i0}
Dialogue: 0,0:17:03.64,0:17:05.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Koyun?
Dialogue: 0,0:17:05.77,0:17:07.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Tuing.\N‎- Benda apa itu?
Dialogue: 0,0:17:11.28,0:17:12.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa kau lelah?
Dialogue: 0,0:17:12.74,0:17:15.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Tidak, aku tak lelah. Tak apa.
Dialogue: 0,0:17:16.07,0:17:17.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Benarkah?
Dialogue: 0,0:17:20.74,0:17:24.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Hei, kau itu…
Dialogue: 0,0:17:25.16,0:17:26.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Misalnya ada sebuah kelompok,
Dialogue: 0,0:17:27.75,0:17:29.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎dan seseorang tak bisa membaur.
Dialogue: 0,0:17:29.46,0:17:31.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa kau tak bisa membiarkannya?
Dialogue: 0,0:17:32.96,0:17:34.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Seperti tadi.
Dialogue: 0,0:17:35.01,0:17:36.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Kau melihatnya?
Dialogue: 0,0:17:36.34,0:17:37.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Ya.
Dialogue: 0,0:17:39.60,0:17:42.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Entah kenapa, aku…
Dialogue: 0,0:17:42.81,0:17:45.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku membayangkan perasaanku\N‎jika aku tersisihkan{\i0}
Dialogue: 0,0:17:45.81,0:17:47.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎saat yang lain bersenang-senang.{\i0}
Dialogue: 0,0:17:48.56,0:17:51.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Pasti rasanya membosankan.{\i0}
Dialogue: 0,0:17:52.36,0:17:55.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Lebih baik semuanya ikut senang.
Dialogue: 0,0:17:57.82,0:18:01.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kenapa ekspresimu begitu?\N‎Apa ucapanku aneh?
Dialogue: 0,0:18:01.20,0:18:03.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Tidak. Tidak aneh.
Dialogue: 0,0:18:04.24,0:18:08.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Aku ingat setiap kali\N‎aku berusaha menjauh dari kelompok,
Dialogue: 0,0:18:08.37,0:18:11.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎kau selalu menarikku kembali.
Dialogue: 0,0:18:13.55,0:18:14.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tidak, saat itu…{\i0}
Dialogue: 0,0:18:14.80,0:18:18.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Sebenarnya aku cukup suka sendirian.
Dialogue: 0,0:18:21.01,0:18:23.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Apa aku mengganggumu? Maaf.
Dialogue: 0,0:18:23.64,0:18:24.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak.
Dialogue: 0,0:18:24.72,0:18:28.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Ada perbedaan antara menikmati kesendirian
Dialogue: 0,0:18:28.44,0:18:31.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎dan merasa sendirian\N‎saat melihat yang lain bersama.
Dialogue: 0,0:18:32.65,0:18:36.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tahu memang tak mungkin\N‎membuat semua orang senang,
Dialogue: 0,0:18:36.24,0:18:38.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎tapi sebagian orang terselamatkan olehmu.
Dialogue: 0,0:18:39.78,0:18:41.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Atau lebih tepatnya,
Dialogue: 0,0:18:43.24,0:18:45.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎kau tidak mengganggu bagiku.
Dialogue: 0,0:18:46.95,0:18:49.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Yang perlu kukatakan sekarang{\i0}
Dialogue: 0,0:18:49.54,0:18:52.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎bukanlah pernyataan cinta atau semacamnya.{\i0}
Dialogue: 0,0:18:53.84,0:18:58.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kalau aku yang dulu,\N‎aku pasti tak akan menyukainya.{\i0}
Dialogue: 0,0:18:58.88,0:19:01.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku sadar harus mengubah cara pandangku.{\i0}
Dialogue: 0,0:19:01.14,0:19:05.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku harus mengubah cara berpikir\N‎dan caraku memperlakukan orang lain.{\i0}
Dialogue: 0,0:19:08.39,0:19:11.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kami menghabiskan waktu bersama\N‎dengan perubahanku itu.{\i0}
Dialogue: 0,0:19:13.52,0:19:15.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Lalu aku menyukainya tanpa kusadari.{\i0}
Dialogue: 0,0:19:17.99,0:19:18.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Makanya…{\i0}
Dialogue: 0,0:19:21.57,0:19:22.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Amamiya.
Dialogue: 0,0:19:24.20,0:19:27.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Terima kasih sudah menjadi temanku.
Dialogue: 0,0:19:28.79,0:19:32.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Terima kasih sudah memberiku\N‎kesempatan untuk berubah.{\i0}
Dialogue: 0,0:19:39.76,0:19:41.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kenapa tiba-tiba sekali?
Dialogue: 0,0:19:41.63,0:19:42.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Wah…
Dialogue: 0,0:19:46.60,0:19:49.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku juga, terima kasih.
Dialogue: 0,0:19:53.73,0:19:56.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Wah, syukurlah.{\i0}
Dialogue: 0,0:19:56.94,0:20:02.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Rasanya jelaga yang mengganjal\N‎di dadaku kini telah hilang.{\i0}
Dialogue: 0,0:20:02.74,0:20:05.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sepertinya aku bisa merelakannya sekarang.{\i0}
Dialogue: 0,0:20:08.45,0:20:09.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mau kembali ke kelas?
Dialogue: 0,0:20:10.58,0:20:11.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Boleh juga.
Dialogue: 0,0:20:18.30,0:20:20.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa itu barusan?
Dialogue: 0,0:20:20.55,0:20:23.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Percakapannya tak terdengar jelas, tapi…
Dialogue: 0,0:20:23.13,0:20:24.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ada suasana yang tak biasa.
Dialogue: 0,0:20:25.01,0:20:28.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Momoka. Kau harus menanyakannya soal ini.
Dialogue: 0,0:22:00.61,0:22:03.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku memang menyukai Amamiya.
Dialogue: 0,0:22:04.03,0:22:06.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Orang yang disukai Amamiya.
Dialogue: 0,0:22:07.32,0:22:09.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sudah jelas kau orangnya, Koyun.
Dialogue: 0,0:22:09.70,0:22:14.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Amamiya menyukaiku?
Dialogue: 0,0:22:15.45,0:22:16.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau pura-pura.
Dialogue: 0,0:22:16.91,0:22:19.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Reaksimu itu jelas pura-pura sekali.
Dialogue: 0,0:22:20.42,0:22:22.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Amamiya.
Dialogue: 0,0:22:23.09,0:22:25.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bukan apa-apa.
Dialogue: 0,0:22:29.93,0:22:30.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Masa bodoh.{\i0}
Dialogue: 0,0:22:31.05,0:22:32.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Masa bodoh.{\i0}
Dialogue: 0,0:22:32.72,0:22:34.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Jadi, jangan salahkan aku nanti.{\i0}
Dialogue: 0,0:22:35.56,0:22:38.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Meski dia membenciku,\N‎aku bukan orang berhati murni.{\i0}
Dialogue: 0,0:22:39.60,0:22:43.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku tak akan minta maaf sama sekali.{\i0}
Dialogue: 0,0:22:43.57,0:22:46.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku menyukaimu, Amamiya.
Dialogue: 0,0:22:46.82,0:22:48.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Maukah kau
Dialogue: 0,0:22:48.70,0:22:50.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎menjadi pacarku?
Dialogue: 0,0:22:51.62,0:22:52.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ayo kita coba.
Dialogue: 0,0:22:55.49,0:22:56.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Eh?
Dialogue: 0,0:22:56.58,0:22:58.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Minato tak memberitahumu?
Dialogue: 0,0:22:59.00,0:23:01.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Kami sekarang berpacaran.
Dialogue: 0,0:23:02.42,0:23:03.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa?
Dialogue: 0,0:23:03.71,0:23:08.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Setiap kali melihatnya,\N‎aku selalu merasa tak nyaman.{\i0}
Dialogue: 0,0:23:09.47,0:23:11.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tapi karena dia bukan lagi penghalang,{\i0}
Dialogue: 0,0:23:11.72,0:23:14.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎sekarang aku tak peduli lagi.{\i0}
Dialogue: 0,0:23:15.81,0:23:19.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kukira aku akan lebih lega\N‎setelah resmi jadi pacarnya,{\i0}
Dialogue: 0,0:23:19.27,0:23:21.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎tapi sejak mulai berpacaran,{\i0}
Dialogue: 0,0:23:21.10,0:23:24.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎selalu saja terpikirkan,\N‎"Kapan dia akan minta putus?"{\i0}
Dialogue: 0,0:23:24.69,0:23:29.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku takut dia akan bilang,\N‎"Ternyata aku tak bisa melupakannya."{\i0}
Dialogue: 0,0:23:30.86,0:23:34.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Semua kecemasan dan kekuranganmu.\N‎Keinginanku terus muncul.{\i0}
Dialogue: 0,0:23:37.24,0:23:39.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak akan minta putus.
Dialogue: 0,0:23:40.00,0:23:41.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau yakin?
Dialogue: 0,0:23:42.83,0:23:43.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya!
Dialogue: 0,0:23:46.84,0:23:50.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku tak akan pernah melepaskanmu.{\i0}
Dialogue: 0,0:23:50.92,0:23:55.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terjemahan subtitle oleh Shoffanny R
