Dialogue: 0,0:00:11.01,0:00:13.93,sign,,0000,0000,0000,,{\an8}‎YAKISOBA - AYAM GORENG - TAKOYAKI
Dialogue: 0,0:04:55.54,0:05:00.04,sign,,0000,0000,0000,,‎EPISODE 18\N‎LEGA
Dialogue: 0,0:05:00.04,0:05:02.88,sign,,0000,0000,0000,,{\an8}‎SMP KIRINOSHIMA
Dialogue: 0,0:05:58.52,0:05:59.52,sign,,0000,0000,0000,,‎IDOLA
Dialogue: 0,0:06:34.81,0:06:35.89,sign,,0000,0000,0000,,‎SMP KIRINOSHIMA
Dialogue: 0,0:08:40.18,0:08:42.60,sign,,0000,0000,0000,,{\an8}‎PERMAINAN BERAKHIR\N‎LANJUTKAN - AKHIRI PERMAINAN
Dialogue: 0,0:08:45.65,0:08:46.73,sign,,0000,0000,0000,,{\an8}‎PASTA MISO
Dialogue: 0,0:10:56.73,0:10:58.15,sign,,0000,0000,0000,,‎HORE
Dialogue: 0,0:13:25.26,0:13:27.09,sign,,0000,0000,0000,,‎KITA PERLU BICARA\N‎TIDAK PERLU
Dialogue: 0,0:14:10.59,0:14:11.72,sign,,0000,0000,0000,,{\an8}‎POPURI - 24 JAM
Dialogue: 0,0:14:17.77,0:14:18.60,sign,,0000,0000,0000,,‎RASA SODA
Dialogue: 0,0:15:01.77,0:15:03.61,sign,,0000,0000,0000,,‎POPURI - DISKON - ONIGIRI - BENTO\N‎WAKTU TERBATAS - ES SERUT
Dialogue: 0,0:15:14.07,0:15:16.20,sign,,0000,0000,0000,,‎IKUT AKU SEBENTAR
Dialogue: 0,0:17:12.90,0:17:13.94,sign,,0000,0000,0000,,‎HA...?
Dialogue: 0,0:18:03.83,0:18:05.83,sign,,0000,0000,0000,,{\an8}‎HUH...
Dialogue: 0,0:18:53.25,0:18:56.92,sign,,0000,0000,0000,,{\an8}‎HUH HUH
Dialogue: 0,0:00:14.93,0:00:17.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Rasanya sakit sekali.
Dialogue: 0,0:00:17.51,0:00:19.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Eh?
Dialogue: 0,0:00:19.26,0:00:21.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Malah begitu?{\i0}
Dialogue: 0,0:00:21.02,0:00:23.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Tapi kenapa?
Dialogue: 0,0:00:23.06,0:00:26.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Dilihat bagaimanapun,\N‎dia itu menyukaimu, Koyuki!
Dialogue: 0,0:00:26.77,0:00:29.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak, itu salah.
Dialogue: 0,0:00:29.61,0:00:32.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia hanya menganggapku sebagai teman.
Dialogue: 0,0:00:32.03,0:00:33.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Itu tak mungkin.
Dialogue: 0,0:00:34.53,0:00:40.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Momoka menyukainya,\N‎tapi dia pun merasa Amamiya menyukaimu.
Dialogue: 0,0:00:40.29,0:00:43.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku juga merasa Amamiya menyukaimu.
Dialogue: 0,0:00:43.91,0:00:46.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bahkan justru sebaliknya,
Dialogue: 0,0:00:47.17,0:00:50.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎aku kaget kau ternyata menyukainya.
Dialogue: 0,0:00:51.63,0:00:53.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau sama sekali tak terlihat begitu.
Dialogue: 0,0:00:54.67,0:00:58.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Kelihatannya malah\N‎seolah-olah Amamiya terlalu agresif.
Dialogue: 0,0:00:58.18,0:01:00.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sampai kau terlihat cukup risih.
Dialogue: 0,0:01:04.35,0:01:06.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku terlihat seperti itu?
Dialogue: 0,0:01:07.52,0:01:10.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku bukan berusaha menghindarinya.
Dialogue: 0,0:01:10.86,0:01:12.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Aku cuma berusaha bersikap biasa.
Dialogue: 0,0:01:12.90,0:01:15.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Aku berusaha menyembunyikan perasaanku.
Dialogue: 0,0:01:15.40,0:01:16.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Itu dia!
Dialogue: 0,0:01:16.95,0:01:21.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau berusaha terlalu keras\N‎sampai dia benar-benar tak tahu.
Dialogue: 0,0:01:24.83,0:01:27.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sampai jumpa, Amamiya.\N‎Kerja bagus hari ini.
Dialogue: 0,0:01:30.92,0:01:32.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Senyum.{\i0}
Dialogue: 0,0:01:33.30,0:01:36.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ayo kita semua pergi main lagi.
Dialogue: 0,0:01:36.67,0:01:38.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Eh?
Dialogue: 0,0:01:39.47,0:01:41.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Jangan-jangan,
Dialogue: 0,0:01:41.85,0:01:44.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎aku sendiri yang merusak kesempatanku?
Dialogue: 0,0:01:44.68,0:01:47.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kalau mau berbuat sesuatu,\N‎sebaiknya cepat.
Dialogue: 0,0:01:49.81,0:01:53.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kalau Amamiya benar-benar menyerah\N‎dengan cinta sejatinya
Dialogue: 0,0:01:53.65,0:01:56.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎dan malah memilih gadis yang menyukainya,
Dialogue: 0,0:01:56.86,0:02:02.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎kau harus bertindak\N‎sebelum dia jatuh cinta pada Momoka.
Dialogue: 0,0:02:02.83,0:02:06.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Kalau nanti mereka mulai saling suka,
Dialogue: 0,0:02:06.54,0:02:09.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎tak akan ada kesempatan lagi.
Dialogue: 0,0:02:10.33,0:02:15.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Itu saja yang bisa kukatakan\N‎untuk menjawab pertanyaanmu.
Dialogue: 0,0:02:16.21,0:02:18.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Tapi...\N‎- Glek.
Dialogue: 0,0:02:18.59,0:02:23.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Dia tipe cowok yang memilih cewek lain\N‎hanya karena cintanya tak ada peluang.
Dialogue: 0,0:02:23.10,0:02:26.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Kurasa ini tergantung\N‎pada keinginanmu memacarinya
Dialogue: 0,0:02:26.22,0:02:28.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎sampai membuatnya putus dengan pacarnya.
Dialogue: 0,0:02:28.77,0:02:29.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Glek...
Dialogue: 0,0:02:29.85,0:02:34.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kalau tak mau begitu,\N‎cobalah jatuh cinta pada orang lain.
Dialogue: 0,0:02:34.19,0:02:37.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Atau jatuh cintalah\N‎pada seseorang yang lebih setia.
Dialogue: 0,0:02:38.78,0:02:39.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Bagaimana menurutmu?
Dialogue: 0,0:02:39.86,0:02:44.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Koyuki, sesulit apa pun itu,
Dialogue: 0,0:02:44.12,0:02:46.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎apakah harus Amamiya?
Dialogue: 0,0:02:49.79,0:02:53.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Pasti menyenangkan\N‎ke festival musim panas bersama pacar.
Dialogue: 0,0:02:53.71,0:02:55.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi kita tak punya pacar.
Dialogue: 0,0:02:55.63,0:02:58.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Standarmu terlalu tinggi, sih.
Dialogue: 0,0:02:59.22,0:03:00.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak juga.
Dialogue: 0,0:03:00.63,0:03:02.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Lalu tipe kesukaanmu seperti apa?
Dialogue: 0,0:03:03.39,0:03:04.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu...
Dialogue: 0,0:03:05.22,0:03:10.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak berisik. Bukan yang kasar juga.\N‎Dan jangan lebih tinggi dariku.
Dialogue: 0,0:03:10.52,0:03:14.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bukankah itu gambaran tentang Koyuki?
Dialogue: 0,0:03:15.73,0:03:18.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maksudmu pacarnya saat SMP?
Dialogue: 0,0:03:18.28,0:03:20.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Benar!\N‎- Hei!
Dialogue: 0,0:03:20.28,0:03:23.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Satu-satunya pacar legendarisnya.
Dialogue: 0,0:05:04.63,0:05:08.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Awalnya aku hanya berpikir\N‎dia cantik juga.{\i0}
Dialogue: 0,0:05:09.26,0:05:10.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dan mungil.{\i0}
Dialogue: 0,0:05:10.76,0:05:14.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tapi auranya membuat dia sulit didekati.{\i0}
Dialogue: 0,0:05:15.23,0:05:16.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Lalu suatu hari...{\i0}
Dialogue: 0,0:05:18.65,0:05:19.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ini.
Dialogue: 0,0:05:20.65,0:05:21.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima kasih.
Dialogue: 0,0:05:24.94,0:05:29.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Ada momen saat aku berpikir,\N‎mungkin tidak sesulit itu.{\i0}
Dialogue: 0,0:05:30.99,0:05:33.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dan saat kucoba mengenalnya...{\i0}
Dialogue: 0,0:05:33.12,0:05:36.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Kalian cepatlah berpacaran.
Dialogue: 0,0:05:36.00,0:05:37.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Benar!\N‎- Diam.
Dialogue: 0,0:05:37.50,0:05:39.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Orang-orang mulai mendukung kami,{\i0}
Dialogue: 0,0:05:40.29,0:05:46.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎dan makin ramai mereka menggoda kami,\N‎aku pun makin menyukainya.{\i0}
Dialogue: 0,0:05:46.63,0:05:48.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tanpa kusadari...{\i0}
Dialogue: 0,0:05:50.39,0:05:51.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kenapa?
Dialogue: 0,0:05:51.47,0:05:54.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dia jadi gadis paling manis di dunia.{\i0}
Dialogue: 0,0:05:54.85,0:05:56.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bukan apa-apa.
Dialogue: 0,0:05:56.27,0:05:58.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dia bukan tipe kesukaanku dari awal.{\i0}
Dialogue: 0,0:05:59.52,0:06:03.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tapi seleraku perlahan berubah\N‎menjadi sepertinya.{\i0}
Dialogue: 0,0:06:03.27,0:06:06.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kalian suka yang mana?
Dialogue: 0,0:06:06.03,0:06:07.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Satu, dua...
Dialogue: 0,0:06:07.53,0:06:08.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Rurupon!
Dialogue: 0,0:06:13.66,0:06:16.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Kau mudah ditebak!\N‎- Mirip Koyuki!
Dialogue: 0,0:06:17.33,0:06:21.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Saat mulai berpacaran,\N‎setiap hari terasa menyenangkan.{\i0}
Dialogue: 0,0:06:21.29,0:06:23.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei. Kau menyukaiku, 'kan?
Dialogue: 0,0:06:26.55,0:06:28.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan bertanya begitu.
Dialogue: 0,0:06:31.80,0:06:34.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dia merasa malu? Manisnya.{\i0}
Dialogue: 0,0:06:35.89,0:06:38.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kami tak pernah bertengkar hebat.{\i0}
Dialogue: 0,0:06:38.31,0:06:39.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tapi sebaliknya...{\i0}
Dialogue: 0,0:06:39.56,0:06:44.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei, bisa berhenti menceritakan semua hal\N‎tentang kita ke teman-temanmu?
Dialogue: 0,0:06:44.82,0:06:47.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dia sering marah karena hal-hal sepele,{\i0}
Dialogue: 0,0:06:48.65,0:06:51.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎dan kadang dia bahkan menangis.{\i0}
Dialogue: 0,0:06:52.20,0:06:54.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sejujurnya, terkadang dia merepotkan.{\i0}
Dialogue: 0,0:06:55.99,0:06:57.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tapi setiap itu terjadi...{\i0}
Dialogue: 0,0:06:57.33,0:07:01.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku menyukaimu lebih dari siapa pun.
Dialogue: 0,0:07:02.21,0:07:04.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kalau kita putus, bagaimana denganmu?
Dialogue: 0,0:07:05.88,0:07:06.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya, 'kan?
Dialogue: 0,0:07:12.01,0:07:14.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kupastikan dia tahu aku menyukainya.{\i0}
Dialogue: 0,0:07:15.26,0:07:17.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tak ada masalah serius di antara kami.{\i0}
Dialogue: 0,0:07:19.23,0:07:22.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Begitulah pikirku,\N‎sampai insiden itu terjadi.{\i0}
Dialogue: 0,0:07:22.23,0:07:25.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Katanya Sasaki dan Takeuchi\N‎sudah melakukannya.
Dialogue: 0,0:07:25.52,0:07:27.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Eh, masa?
Dialogue: 0,0:07:27.07,0:07:28.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Di mana? Di rumah siapa?
Dialogue: 0,0:07:28.61,0:07:30.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu yang mau kalian tahu?
Dialogue: 0,0:07:30.86,0:07:32.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Daripada itu, bagaimana denganmu, Tsubasa?
Dialogue: 0,0:07:34.24,0:07:36.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kalian berpacaran lebih lama\N‎dari Sasaki dan Takeuchi.
Dialogue: 0,0:07:39.33,0:07:42.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yah, mungkin sebentar lagi.
Dialogue: 0,0:07:52.09,0:07:53.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ayo putus.
Dialogue: 0,0:07:53.22,0:07:54.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku sudah minta maaf.
Dialogue: 0,0:07:54.89,0:07:58.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak. Aku tak bisa. Itu menjijikkan.
Dialogue: 0,0:07:58.22,0:08:00.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak, bukan begitu maksudku!
Dialogue: 0,0:08:03.81,0:08:05.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf, Koyuki.
Dialogue: 0,0:08:09.19,0:08:11.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak. Lupakan saja aku.
Dialogue: 0,0:08:12.53,0:08:13.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak menyukaimu lagi.
Dialogue: 0,0:08:13.86,0:08:15.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak...
Dialogue: 0,0:08:15.62,0:08:19.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak pernah menyukaimu sama sekali.
Dialogue: 0,0:08:22.96,0:08:24.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Begitu, ya.
Dialogue: 0,0:08:27.13,0:08:30.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tak ada yang istimewa darinya.{\i0}
Dialogue: 0,0:08:31.17,0:08:33.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tapi yang memulai masalah itu\N‎sudah jelas aku.{\i0}
Dialogue: 0,0:08:35.30,0:08:39.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kalau aku tak bilang begitu,\N‎mungkin kami masih bersama.{\i0}
Dialogue: 0,0:08:43.43,0:08:45.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}‎Andai saja aku tak bersikap begitu{\i0}‎...
Dialogue: 0,0:08:46.73,0:08:49.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kadang aku kepikiran hal-hal seperti itu.{\i0}
Dialogue: 0,0:08:50.19,0:08:51.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Cuma sebatas itu.{\i0}
Dialogue: 0,0:08:52.65,0:08:54.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sebaiknya ke minimarket.
Dialogue: 0,0:08:56.53,0:09:00.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Koyuki, sesulit apa pun itu,{\i0}
Dialogue: 0,0:09:00.24,0:09:02.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎apakah harus Amamiya?{\i0}
Dialogue: 0,0:09:04.29,0:09:07.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kenapa aku harus bersama Amamiya?{\i0}
Dialogue: 0,0:09:07.83,0:09:09.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Akan kubaca.
Dialogue: 0,0:09:09.59,0:09:11.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku senang sekali.
Dialogue: 0,0:09:13.05,0:09:15.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku hanya ingin kau di sini.
Dialogue: 0,0:09:16.13,0:09:23.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sejujurnya, aku benar-benar menyesal\N‎tak berusaha lebih dekat dengannya.{\i0}
Dialogue: 0,0:09:23.02,0:09:24.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tapi tetap saja...{\i0}
Dialogue: 0,0:09:24.85,0:09:31.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku tak bisa membayangkan diriku\N‎bahagia bersama siapa pun.{\i0}
Dialogue: 0,0:09:31.02,0:09:33.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Ayo berkencan, Koyuki.{\i0}
Dialogue: 0,0:09:36.78,0:09:38.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Saat itu...{\i0}
Dialogue: 0,0:09:41.28,0:09:43.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎ada banyak hal yang terjadi.{\i0}
Dialogue: 0,0:09:44.41,0:09:46.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Ya. Baiklah.
Dialogue: 0,0:09:48.17,0:09:51.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku memilih yang terlihat paling mudah.{\i0}
Dialogue: 0,0:09:52.71,0:09:56.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku mencoba menyukai Igarashi\N‎karena ingin menyelamatkan diriku.{\i0}
Dialogue: 0,0:09:57.72,0:10:00.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku meyakinkan diriku\N‎kalau aku menyukainya.{\i0}
Dialogue: 0,0:10:01.76,0:10:03.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Terima kasih sudah mengantarku.
Dialogue: 0,0:10:16.99,0:10:20.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tapi pemahaman kami\N‎soal berkencan itu berbeda.{\i0}
Dialogue: 0,0:10:20.36,0:10:21.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dah.
Dialogue: 0,0:10:23.70,0:10:28.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tidak bisa. Aku tak bisa terus bersamanya\N‎dengan perasaan tak serius.{\i0}
Dialogue: 0,0:10:28.21,0:10:30.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Lebih baik kubatalkan saja.{\i0}
Dialogue: 0,0:10:30.96,0:10:32.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dan harus secepatnya.{\i0}
Dialogue: 0,0:10:33.46,0:10:35.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Koyuki, selamat!\N‎- Cie!
Dialogue: 0,0:10:35.96,0:10:38.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Akhirnya mulai seru!
Dialogue: 0,0:10:38.22,0:10:41.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Sudah cukup.\N‎- Mantap! Kami semua menantikannya!
Dialogue: 0,0:10:41.47,0:10:44.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tsubasa! Istrimu datang.
Dialogue: 0,0:10:44.68,0:10:46.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Eh, mustahil...
Dialogue: 0,0:10:46.10,0:10:49.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kalian berisik sekali.
Dialogue: 0,0:10:49.31,0:10:50.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan malu-malu.
Dialogue: 0,0:10:51.35,0:10:52.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Selamat pagi.
Dialogue: 0,0:10:53.90,0:10:54.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Selamat pagi.
Dialogue: 0,0:10:58.90,0:11:03.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎"Lebih baik kubatalkan saja."\N‎Tapi bagaimana cara mengatakannya?{\i0}
Dialogue: 0,0:11:10.12,0:11:12.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei. Kau menyukaiku, 'kan?
Dialogue: 0,0:11:14.63,0:11:18.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Bagaimana ini?\N‎Aku belum bisa menjawabnya sekarang.{\i0}
Dialogue: 0,0:11:19.22,0:11:21.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Jangan bertanya begitu.
Dialogue: 0,0:11:21.88,0:11:24.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tunggu, "sekarang"?{\i0}
Dialogue: 0,0:11:24.10,0:11:26.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Apa aku bisa menjawabnya suatu hari nanti?{\i0}
Dialogue: 0,0:11:28.89,0:11:32.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ayolah, tak apa. Kita ini berpacaran.
Dialogue: 0,0:11:32.73,0:11:34.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku belum siap.
Dialogue: 0,0:11:35.27,0:11:36.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kan sudah pernah juga.
Dialogue: 0,0:11:39.61,0:11:43.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Lagi pula, kenapa Igarashi\N‎bisa menyukai orang sepertiku?{\i0}
Dialogue: 0,0:11:44.41,0:11:46.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kami tipe orang yang berbeda,{\i0}
Dialogue: 0,0:11:46.28,0:11:49.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎dan dia selalu meremehkan tindakanku\N‎dan hal-hal yang kusukai.{\i0}
Dialogue: 0,0:11:50.54,0:11:54.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei, bisa berhenti menceritakan semua hal\N‎tentang kita ke teman-temanmu?
Dialogue: 0,0:11:54.75,0:11:57.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Kenapa? Itu kan biasa.
Dialogue: 0,0:11:57.88,0:12:03.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Saat berdebat pun,\N‎masalah dianggap remeh seolah tak penting.{\i0}
Dialogue: 0,0:12:04.64,0:12:07.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dia tak pernah minta maaf.{\i0}
Dialogue: 0,0:12:07.68,0:12:12.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dia menganggap dirinya normal\N‎dan aku yang aneh.{\i0}
Dialogue: 0,0:12:17.02,0:12:20.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dia tak pernah berusaha mengerti\N‎atau mencari jalan tengah.{\i0}
Dialogue: 0,0:12:20.90,0:12:23.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Aku tak bisa begini lagi.\N‎- Ha? Kenapa?
Dialogue: 0,0:12:23.90,0:12:28.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Aku menyukaimu lebih dari siapa pun.\N{\i1}‎- Dia terus mengatakan dia menyukaiku.{\i0}
Dialogue: 0,0:12:28.28,0:12:31.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kalau kita putus, bagaimana denganmu?
Dialogue: 0,0:12:31.04,0:12:34.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tapi dia merendahkanku.{\i0}
Dialogue: 0,0:12:34.04,0:12:36.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dan tanpa niat buruk.{\i0}
Dialogue: 0,0:12:37.59,0:12:40.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sebenarnya, "suka" itu apa?{\i0}
Dialogue: 0,0:12:41.55,0:12:46.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dia mungkin hanya suka\N‎memiliki gebetan atau pacar.{\i0}
Dialogue: 0,0:12:47.47,0:12:50.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dan aku hanya kebetulan mengisi peran itu.{\i0}
Dialogue: 0,0:12:51.52,0:12:53.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dia tak melihat diriku apa adanya.{\i0}
Dialogue: 0,0:12:55.52,0:12:59.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kurasa di mana pun aku berada,{\i0}
Dialogue: 0,0:13:00.27,0:13:01.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎aku tak terlihat.{\i0}
Dialogue: 0,0:13:04.07,0:13:08.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sejujurnya, aku tak peduli\N‎dengan perkataannya saat itu.{\i0}
Dialogue: 0,0:13:09.24,0:13:13.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku tahu seperti apa sifatnya,\N‎dan mereka hanya terbawa suasana.{\i0}
Dialogue: 0,0:13:13.41,0:13:17.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yah, mungkin sebentar lagi.
Dialogue: 0,0:13:27.09,0:13:29.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tapi reaksinya soal kejadian itu...{\i0}
Dialogue: 0,0:13:29.26,0:13:31.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku sudah minta maaf.
Dialogue: 0,0:13:31.01,0:13:34.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak. Aku tak bisa. Itu menjijikkan.
Dialogue: 0,0:13:34.48,0:13:36.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak, bukan begitu maksudku!
Dialogue: 0,0:13:39.86,0:13:41.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf, Koyuki.
Dialogue: 0,0:13:43.28,0:13:44.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dia meminta maaf.{\i0}
Dialogue: 0,0:13:45.28,0:13:49.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Itu pertama kalinya Igarashi menyesal\N‎atas perlakuannya kepadaku.{\i0}
Dialogue: 0,0:13:49.82,0:13:53.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kurasa inilah saatnya mengakhiri semuanya.{\i0}
Dialogue: 0,0:13:54.33,0:13:55.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak.
Dialogue: 0,0:13:58.37,0:14:04.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku tak bisa membahagiakan orang lain\N‎karena terlalu larut dalam penderitaanku.{\i0}
Dialogue: 0,0:14:05.30,0:14:06.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku buruk sekali.{\i0}
Dialogue: 0,0:14:09.18,0:14:10.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Ayo ke minimarket.
Dialogue: 0,0:14:12.47,0:14:16.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Panas sekali sampai nafsu makanku hilang.{\i0}
Dialogue: 0,0:14:16.31,0:14:17.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku mau es krim.{\i0}
Dialogue: 0,0:14:33.83,0:14:35.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Lama tak bertemu.
Dialogue: 0,0:14:36.08,0:14:37.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aktingmu buruk.
Dialogue: 0,0:14:37.16,0:14:40.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Jangan pasang wajah canggung\N‎yang terlihat jelas! Menyebalkan!
Dialogue: 0,0:14:43.17,0:14:47.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau, jangan-jangan\N‎kau merasa bersalah kepadaku?
Dialogue: 0,0:14:47.88,0:14:49.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa? Tidak juga.
Dialogue: 0,0:14:49.43,0:14:52.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bohong. Suaramu sumbang.
Dialogue: 0,0:14:59.60,0:15:00.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei, tunggu...
Dialogue: 0,0:15:05.94,0:15:08.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima kasih?
Dialogue: 0,0:15:08.07,0:15:09.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tunggu, apa itu tadi?
Dialogue: 0,0:15:10.70,0:15:13.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ayo, ikut aku sebentar.
Dialogue: 0,0:15:16.20,0:15:18.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baru kali ini\N‎ada yang bilang begitu kepadaku.
Dialogue: 0,0:15:18.91,0:15:20.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Berisik!
Dialogue: 0,0:15:27.46,0:15:29.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Ada apa ini?
Dialogue: 0,0:15:29.21,0:15:33.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Rumahmu cukup jauh dari sini,\N‎es krimmu nanti keburu meleleh.
Dialogue: 0,0:15:33.72,0:15:35.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku memang mau memakannya di jalan.
Dialogue: 0,0:15:37.14,0:15:40.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Cewek jalan kaki pakai baju tidur\N‎sambil makan es krim.
Dialogue: 0,0:15:40.85,0:15:42.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aneh sekali.
Dialogue: 0,0:15:42.48,0:15:45.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Lagi-lagi mengkritik semua yang kulakukan.{\i0}
Dialogue: 0,0:15:45.65,0:15:50.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tak ada yang peduli juga\N‎kalau ada yang lihat.
Dialogue: 0,0:15:50.07,0:15:53.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Ucapannya masih tajam seperti biasanya.{\i0}
Dialogue: 0,0:15:54.24,0:15:56.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tapi entah kenapa,\N‎kata-katanya tak menyakitkan.{\i0}
Dialogue: 0,0:15:56.87,0:15:58.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku juga tak semarah biasanya.{\i0}
Dialogue: 0,0:15:59.41,0:16:02.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi kau juga pakai baju tidur, 'kan?
Dialogue: 0,0:16:03.75,0:16:08.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa? Ini bukan baju tidur.\N‎Aku memakainya untuk kegiatan klub.
Dialogue: 0,0:16:08.09,0:16:10.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Eh? Standarmu aneh sekali.
Dialogue: 0,0:16:10.21,0:16:11.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Berisik.
Dialogue: 0,0:16:11.34,0:16:17.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku bisa membalas ucapannya dengan biasa,\N‎dan obrolan kami mengalir begitu saja.{\i0}
Dialogue: 0,0:16:17.26,0:16:19.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Santai dan mudah.{\i0}
Dialogue: 0,0:16:20.14,0:16:23.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}‎Apa karena komunitas kami sudah berbeda?{\i0}
Dialogue: 0,0:16:23.10,0:16:26.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}‎Apa karena sudah tak ada lagi\N‎tatapan orang-orang sekitar?{\i0}
Dialogue: 0,0:16:26.90,0:16:31.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dulu, setiap ucapannya begitu menyakitkan.{\i0}
Dialogue: 0,0:16:31.90,0:16:36.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tapi mungkin tak akan sesakit itu\N‎jika aku bisa mengabaikannya.{\i0}
Dialogue: 0,0:16:37.66,0:16:42.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Mungkin aku baru menyadarinya sekarang\N‎karena waktu sudah berlalu.{\i0}
Dialogue: 0,0:16:42.91,0:16:45.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Diriku yang dulu\N‎tak akan bisa mengabaikannya.{\i0}
Dialogue: 0,0:16:46.50,0:16:47.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Eh, apa?
Dialogue: 0,0:16:48.42,0:16:50.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak, aku mau buang sampah.
Dialogue: 0,0:16:50.80,0:16:52.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Oh, oke.
Dialogue: 0,0:16:53.97,0:16:55.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima kasih.
Dialogue: 0,0:16:55.59,0:16:57.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau ini jangan-jangan...
Dialogue: 0,0:16:57.80,0:17:00.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau pikir aku masih menyukaimu?
Dialogue: 0,0:17:02.14,0:17:03.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Astaga, pede sekali.
Dialogue: 0,0:17:06.44,0:17:09.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku sudah tahu kau tak menyukaiku.
Dialogue: 0,0:17:10.07,0:17:12.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sekarang ataupun dulu.
Dialogue: 0,0:17:14.53,0:17:18.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Kau tak pernah benar-benar menyukaiku.
Dialogue: 0,0:17:18.66,0:17:24.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau hanya menyukai cewek ideal\N‎yang kau bayangkan dari diriku.
Dialogue: 0,0:17:24.91,0:17:26.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau hanya suka rasanya jatuh cinta.
Dialogue: 0,0:17:28.17,0:17:32.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jika diberi kesempatan, tidak harus aku,\N‎kau pasti akan menyukai siapa pun.
Dialogue: 0,0:17:32.92,0:17:34.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ha? Tunggu dulu.
Dialogue: 0,0:17:34.80,0:17:38.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Maaf karena akhirnya aku menyakitimu.
Dialogue: 0,0:17:38.80,0:17:43.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku memang sudah tak peduli lagi\N‎dengan gadis ini,{\i0}
Dialogue: 0,0:17:43.52,0:17:46.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎tapi ini benar-benar keterlaluan!{\i0}
Dialogue: 0,0:17:47.60,0:17:50.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Beraninya kau berasumsi soal perasaanku?
Dialogue: 0,0:17:50.06,0:17:52.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Seenaknya berasumsi,\N‎lalu minta maaf sepihak!
Dialogue: 0,0:17:52.90,0:17:55.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Jangan merasa lega sendiri, Bodoh!
Dialogue: 0,0:17:55.07,0:17:58.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak menyukaimu lagi\N‎maksudnya sekarang!
Dialogue: 0,0:17:58.20,0:18:03.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Dulu itu aku benar-benar menyukaimu!\N‎Kau seharusnya paham!
Dialogue: 0,0:18:05.83,0:18:09.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Makanya, sikapmu yang begitu...
Dialogue: 0,0:18:09.25,0:18:10.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Cara bicaramu itu.
Dialogue: 0,0:18:11.21,0:18:13.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Kau pikir orang harus langsung mengerti.
Dialogue: 0,0:18:14.46,0:18:18.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}‎Kau selalu menganggap\N‎caramu itu benar dan normal.{\i0}
Dialogue: 0,0:18:19.59,0:18:21.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Hal-hal seperti itu...{\i0}
Dialogue: 0,0:18:21.35,0:18:24.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Aku sangat membencinya!
Dialogue: 0,0:18:25.22,0:18:28.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau hanya melihat\N‎dari sudut pandangmu sendiri.
Dialogue: 0,0:18:28.48,0:18:29.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu sangat tak adil.
Dialogue: 0,0:18:29.77,0:18:33.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau juga sebaliknya!\N‎Kau sangat sulit dipahami.
Dialogue: 0,0:18:33.52,0:18:36.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau pikir semuanya boleh asal niatmu baik.
Dialogue: 0,0:18:36.65,0:18:39.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau mengabaikan perasaan\N‎dan ucapan orang lain.
Dialogue: 0,0:18:39.28,0:18:42.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Sadar dirilah\N‎kalau kemampuan komunikasimu payah.
Dialogue: 0,0:18:42.83,0:18:44.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Jangan tiba-tiba marah padaku!
Dialogue: 0,0:18:44.54,0:18:47.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kemampuan komunikasimu\N‎juga tak sehebat itu!
Dialogue: 0,0:18:47.91,0:18:49.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dan satu lagi.
Dialogue: 0,0:18:49.00,0:18:53.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Aku agak benci caramu memanggilku "kau"!
Dialogue: 0,0:18:57.97,0:19:00.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎"Agak benci" atau "sangat benci"?
Dialogue: 0,0:19:00.43,0:19:02.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Lihat, begitu lagi.
Dialogue: 0,0:19:02.22,0:19:05.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau mengejekku dan mengganti topik.\N‎Berhenti mengkritik ucapanku.
Dialogue: 0,0:19:07.52,0:19:08.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sial...
Dialogue: 0,0:19:17.94,0:19:19.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ayo pulang.
Dialogue: 0,0:19:19.82,0:19:20.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya.
Dialogue: 0,0:19:24.03,0:19:26.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau sepertinya sudah berubah.
Dialogue: 0,0:19:26.95,0:19:28.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak berubah.
Dialogue: 0,0:19:28.79,0:19:32.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku memang mudah marah\N‎dan berpikiran sempit.
Dialogue: 0,0:19:32.58,0:19:34.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Begitulah diriku.
Dialogue: 0,0:19:34.79,0:19:38.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yang kau lihat dulu itu\N‎bukan aku sebenarnya, tapi ilusi.
Dialogue: 0,0:19:38.21,0:19:40.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dia masih membahas itu.{\i0}
Dialogue: 0,0:19:40.17,0:19:42.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya, mungkin kau benar.
Dialogue: 0,0:19:42.13,0:19:46.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku suka gadis yang lembut, anggun,\N‎dan bersikap baik kepadaku.
Dialogue: 0,0:19:48.22,0:19:50.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ternyata memang bukan aku.
Dialogue: 0,0:19:50.93,0:19:52.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Beda jauh sekali.
Dialogue: 0,0:19:53.31,0:19:58.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi kurasa kau lebih cocok\N‎dengan gadis yang kuat dan ceria.
Dialogue: 0,0:19:58.19,0:19:59.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Berisik.
Dialogue: 0,0:20:01.53,0:20:02.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Rasanya...{\i0}
Dialogue: 0,0:20:03.70,0:20:09.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Semua penyesalan yang selama ini\N‎terus mengganjal pikiranku{\i0}
Dialogue: 0,0:20:09.33,0:20:11.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎kini perlahan menghilang.{\i0}
Dialogue: 0,0:20:12.29,0:20:14.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Meskipun tidak berjalan dengan damai,{\i0}
Dialogue: 0,0:20:14.92,0:20:20.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎tapi baru kali ini kami bicara\N‎sebagai dua orang yang setara.{\i0}
Dialogue: 0,0:20:20.76,0:20:26.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Semua "andai saja" yang kubayangkan\N‎dari awal memang tak pernah ada.{\i0}
Dialogue: 0,0:20:26.80,0:20:30.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku menjadikan masa lalu sebagai alasanku,{\i0}
Dialogue: 0,0:20:31.18,0:20:36.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎padahal yang menentukan masa depanku\N‎adalah diriku yang sekarang.{\i0}
Dialogue: 0,0:20:39.19,0:20:43.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Seiring berjalannya waktu,\N‎aku, orang, dan lingkungan pun berubah.{\i0}
Dialogue: 0,0:20:43.90,0:20:46.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Cara roda giginya\N‎saling bertaut pun ikut berubah.{\i0}
Dialogue: 0,0:20:47.66,0:20:49.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Hei, kau.\N‎- "Kau" lagi?
Dialogue: 0,0:20:50.29,0:20:51.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yuishiro.
Dialogue: 0,0:20:51.91,0:20:55.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tiba-tiba sekali.\N‎Kau belum pernah memanggilku begitu.
Dialogue: 0,0:20:55.37,0:20:59.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Lagi pula, sekarang namaku Hikawa.\N‎Orang tuaku bercerai.
Dialogue: 0,0:20:59.38,0:21:00.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Eh?
Dialogue: 0,0:21:03.47,0:21:04.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Koyuki.
Dialogue: 0,0:21:05.22,0:21:07.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau punya pacar sekarang?
Dialogue: 0,0:21:08.35,0:21:09.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ada yang kusukai.
Dialogue: 0,0:21:10.64,0:21:13.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi dia sudah punya pacar,\N‎jadi bertepuk sebelah tangan.
Dialogue: 0,0:21:14.94,0:21:16.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak ada harapan.
Dialogue: 0,0:21:16.52,0:21:18.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya, tapi tak masalah.
Dialogue: 0,0:21:18.98,0:21:22.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kami tak perlu berpacaran\N‎untuk menjaga hubungan kami.
Dialogue: 0,0:21:27.20,0:21:29.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei, sebentar. Kau menyindirku?
Dialogue: 0,0:21:30.58,0:21:31.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau ini...
Dialogue: 0,0:21:33.08,0:21:35.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎- Aku dan Koyuki.\N‎- Aku dan Igarashi.{\i0}
Dialogue: 0,0:21:35.50,0:21:38.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tidak kusangka kami bisa berjalan\N‎berdampingan seperti ini.{\i0}
Dialogue: 0,0:21:49.80,0:21:52.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku mendengar suara kutukan itu terlepas.{\i0}
Dialogue: 0,0:23:25.82,0:23:27.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sastra klasik sudah seperti mantra.
Dialogue: 0,0:23:27.78,0:23:30.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Matematika juga tak ada habisnya.
Dialogue: 0,0:23:30.70,0:23:33.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Liburan musim panas akan berakhir\N‎sebelum PR-ku selesai.
Dialogue: 0,0:23:33.41,0:23:36.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Serius, itu sangat gila.
Dialogue: 0,0:23:36.24,0:23:41.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Lagi pula, ada PR di musim panas saja\N‎sudah tak masuk akal.
Dialogue: 0,0:23:41.16,0:23:44.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Benar sekali!\N‎- Benar-benar gila.
Dialogue: 0,0:23:51.88,0:23:56.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terjemahan subtitle oleh Shoffanny R
