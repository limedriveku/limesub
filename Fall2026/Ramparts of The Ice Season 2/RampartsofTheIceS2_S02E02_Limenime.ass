Dialogue: 0,0:00:12.13,0:00:15.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jadi, tema drama kita\N‎adalah {\i1}‎Aladdin dan Lampu Ajaib.{\i0}
Dialogue: 0,0:00:16.76,0:00:18.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎- Hore!\N‎- Wah!
Dialogue: 0,0:00:18.18,0:00:20.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Baik, siapa yang mau jadi pemerannya?
Dialogue: 0,0:00:22.48,0:00:23.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Di sini!
Dialogue: 0,0:00:24.14,0:00:25.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Lirik.
Dialogue: 0,0:00:25.65,0:00:27.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Lirik… Lirik.
Dialogue: 0,0:00:30.02,0:00:31.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak mau!
Dialogue: 0,0:00:32.53,0:00:33.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yah…
Dialogue: 0,0:00:40.45,0:00:41.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baik.
Dialogue: 0,0:00:43.58,0:00:45.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}‎Wah, aku suka kau.{\i0}
Dialogue: 0,0:00:45.79,0:00:48.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}‎Tidak, maksudku bukan begitu.{\i0}
Dialogue: 0,0:00:50.30,0:00:52.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa bisa selesai jika tak bekerja\N‎saat libur musim panas?
Dialogue: 0,0:00:53.63,0:00:56.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Oke, ayo kita atur jadwal semua orang.
Dialogue: 0,0:00:58.72,0:01:01.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku suka melihat kelas mandiri begini.
Dialogue: 0,0:01:08.31,0:01:10.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Jarak antara Hikawa dan aku…{\i0}
Dialogue: 0,0:01:11.07,0:01:13.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sepertinya kami makin dekat,\N‎lalu menjauh lagi…{\i0}
Dialogue: 0,0:01:14.61,0:01:16.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Apa hanya perasaanku?{\i0}
Dialogue: 0,0:01:16.70,0:01:18.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Kita bisa buat latarnya sebaik mungkin.
Dialogue: 0,0:01:28.25,0:01:29.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kalau aku{\i0}
Dialogue: 0,0:01:30.50,0:01:32.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎benar-benar menyerah,{\i0}
Dialogue: 0,0:01:33.05,0:01:34.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎tak akan terjadi apa-apa{\i0}
Dialogue: 0,0:01:34.96,0:01:37.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎dan tak akan ada yang terluka.{\i0}
Dialogue: 0,0:01:38.38,0:01:41.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tapi aku terus saja\N‎ingin memperpendek jarak ini.{\i0}
Dialogue: 0,0:01:42.39,0:01:44.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Apa aku terlalu egois?{\i0}
Dialogue: 0,0:01:48.23,0:01:50.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}‎Tidak sabar untuk konser besok!{\i0}
Dialogue: 0,0:03:31.41,0:03:32.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baik.
Dialogue: 0,0:03:37.13,0:03:38.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Amamiya…
Dialogue: 0,0:03:39.88,0:03:41.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Senang bertemu denganmu.
Dialogue: 0,0:03:42.51,0:03:44.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku Aoyagi.
Dialogue: 0,0:03:44.72,0:03:46.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Menurutmu siapa dia?
Dialogue: 0,0:03:46.80,0:03:48.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kami satu tim sepak bola.
Dialogue: 0,0:03:48.60,0:03:52.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Katanya mereka mau ke konser band,\N‎makanya aku ikut.
Dialogue: 0,0:03:52.23,0:03:53.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Senang bertemu denganmu.
Dialogue: 0,0:03:54.65,0:03:57.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tempat konsernya ke arah sana.
Dialogue: 0,0:04:00.99,0:04:02.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima kasih banyak!
Dialogue: 0,0:04:04.91,0:04:08.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Maru!\N‎- Apa? Ke mana Amamiya dan Hino pergi?
Dialogue: 0,0:04:09.20,0:04:13.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Oh, Yota bilang akan menonton\N‎dari belakang karena dia tinggi.
Dialogue: 0,0:04:13.16,0:04:15.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Amamiya juga pergi ke sana.
Dialogue: 0,0:04:15.75,0:04:17.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kalau begitu, aku mau ke sana juga.
Dialogue: 0,0:04:18.88,0:04:20.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hai!
Dialogue: 0,0:04:21.17,0:04:22.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa?
Dialogue: 0,0:04:28.26,0:04:29.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau tak apa?
Dialogue: 0,0:04:38.19,0:04:39.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kalau begitu, kami ke arah sana.
Dialogue: 0,0:04:44.57,0:04:46.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Amamiya.
Dialogue: 0,0:04:46.53,0:04:47.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ada apa?
Dialogue: 0,0:04:49.74,0:04:51.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak. Bukan apa-apa.
Dialogue: 0,0:04:59.34,0:05:00.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sampai jumpa.
Dialogue: 0,0:05:07.68,0:05:12.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kenapa kau tak memberinya harapan\N‎atau menjauhinya?
Dialogue: 0,0:05:17.60,0:05:21.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tentu saja aku tahu perasaan Kuriki.{\i0}
Dialogue: 0,0:05:22.53,0:05:25.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tapi aku tak bisa\N‎membalas perasaannya saat ini.{\i0}
Dialogue: 0,0:05:26.74,0:05:27.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tapi tetap saja,{\i0}
Dialogue: 0,0:05:28.45,0:05:31.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎aku tak mengerti kenapa jadi salah{\i0}
Dialogue: 0,0:05:31.95,0:05:33.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎kalau tak menjauhinya.{\i0}
Dialogue: 0,0:05:37.12,0:05:39.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Astaga!{\i0}
Dialogue: 0,0:05:44.38,0:05:45.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Oh, kau sudah bangun.
Dialogue: 0,0:05:49.14,0:05:50.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tunggu, kalian memakan sesuatu.
Dialogue: 0,0:05:52.31,0:05:53.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sedang sedih?
Dialogue: 0,0:05:53.72,0:05:55.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mau roti juga?
Dialogue: 0,0:05:55.14,0:05:57.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Eh, Koyun yang bawa ini?
Dialogue: 0,0:05:59.56,0:06:00.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ini.
Dialogue: 0,0:06:00.86,0:06:01.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima kasih.
Dialogue: 0,0:06:06.86,0:06:08.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tunggu, apa yang terjadi di sini?{\i0}
Dialogue: 0,0:06:29.93,0:06:32.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Apa? Barusan…{\i0}
Dialogue: 0,0:06:33.01,0:06:35.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Apa itu? Imut sekali.{\i0}
Dialogue: 0,0:06:35.31,0:06:36.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sudah kubilang!
Dialogue: 0,0:06:37.52,0:06:38.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Berteman saja cukup.
Dialogue: 0,0:06:39.94,0:06:42.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Justru bagus begitu kalau mau berteman.
Dialogue: 0,0:06:42.94,0:06:44.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kalian harus bisa
Dialogue: 0,0:06:45.02,0:06:46.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎mengobrol biasa saat bersama.
Dialogue: 0,0:06:50.66,0:06:55.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku mulai bingung\N‎harus bersikap bagaimana di dekatnya.{\i0}
Dialogue: 0,0:06:57.12,0:06:58.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi aku sadar kami berteman,
Dialogue: 0,0:06:59.12,0:07:01.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎dan semuanya sama seperti dulu.
Dialogue: 0,0:07:02.42,0:07:05.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sekarang aku merasa lebih lega.
Dialogue: 0,0:07:05.00,0:07:06.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Benarkah?
Dialogue: 0,0:07:06.80,0:07:08.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mau kembali ke kelas?
Dialogue: 0,0:07:08.63,0:07:10.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hentikan dulu wajah anehmu itu.
Dialogue: 0,0:07:22.98,0:07:24.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kenapa wajahnya begitu?{\i0}
Dialogue: 0,0:07:30.24,0:07:31.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sampai nanti.
Dialogue: 0,0:07:36.66,0:07:37.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Apa itu tadi?{\i0}
Dialogue: 0,0:07:37.87,0:07:41.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kukira dia menghindariku akhir-akhir ini.{\i0}
Dialogue: 0,0:07:42.33,0:07:44.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tunggu…{\i0}
Dialogue: 0,0:07:44.00,0:07:45.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku bisa salah paham.{\i0}
Dialogue: 0,0:07:46.13,0:07:49.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tidak. Bukan begitu.{\i0}
Dialogue: 0,0:07:49.96,0:07:53.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku tak akan membencinya\N‎karena tak merasakan hal yang sama.{\i0}
Dialogue: 0,0:07:54.01,0:07:56.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Perasaan ini hanya sepihak.{\i0}
Dialogue: 0,0:07:56.10,0:07:59.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Ini perasaanku sendiri.{\i0}
Dialogue: 0,0:08:01.52,0:08:02.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku penjahatnya?
Dialogue: 0,0:08:04.81,0:08:05.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Makanya…{\i0}
Dialogue: 0,0:08:07.77,0:08:08.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu cocok untukmu.
Dialogue: 0,0:08:09.82,0:08:10.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei…
Dialogue: 0,0:08:11.69,0:08:13.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa maksudnya itu?
Dialogue: 0,0:08:14.53,0:08:16.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Wah…{\i0}
Dialogue: 0,0:08:16.16,0:08:18.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dia terlihat senang.{\i0}
Dialogue: 0,0:08:19.62,0:08:21.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Makanya, sebentar lagi saja…{\i0}
Dialogue: 0,0:08:23.41,0:08:24.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Koyun.
Dialogue: 0,0:08:26.25,0:08:27.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei.
Dialogue: 0,0:08:27.50,0:08:29.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Biar kulihat perasaanmu sebenarnya.{\i0}
Dialogue: 0,0:08:30.00,0:08:33.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mau main saat libur musim panas?
Dialogue: 0,0:08:35.84,0:08:39.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kalau memang tak ada harapan,\N‎aku akan benar-benar mundur.{\i0}
Dialogue: 0,0:08:42.18,0:08:43.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu…
Dialogue: 0,0:08:43.60,0:08:44.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya.
Dialogue: 0,0:08:44.69,0:08:46.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Boleh.
Dialogue: 0,0:08:46.10,0:08:47.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sepertinya seru.
Dialogue: 0,0:08:48.81,0:08:52.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ayo kita semua pergi main lagi.
Dialogue: 0,0:08:56.03,0:08:57.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya.
Dialogue: 0,0:08:57.20,0:08:59.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Nanti kita tentukan harinya.
Dialogue: 0,0:08:59.66,0:09:00.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kita semua.
Dialogue: 0,0:09:02.29,0:09:03.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya.
Dialogue: 0,0:09:03.79,0:09:04.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dah.
Dialogue: 0,0:09:13.09,0:09:15.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Hampir saja…{\i0}
Dialogue: 0,0:09:16.43,0:09:18.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku hampir salah paham lagi.{\i0}
Dialogue: 0,0:09:19.76,0:09:23.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sesaat, kupikir dia hanya mengajakku\N‎main berdua saja.{\i0}
Dialogue: 0,0:09:25.64,0:09:26.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tidak.{\i0}
Dialogue: 0,0:09:26.77,0:09:28.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Jangan terlalu berharap.{\i0}
Dialogue: 0,0:09:28.94,0:09:33.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku tak mau terlalu berharap,\N‎terlalu senang, lalu akhirnya kecewa.{\i0}
Dialogue: 0,0:09:33.69,0:09:35.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Ayo lupakan. Lupakan.{\i0}
Dialogue: 0,0:09:39.82,0:09:41.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Oh, Koyun.
Dialogue: 0,0:09:41.87,0:09:43.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Momoka.
Dialogue: 0,0:09:51.54,0:09:55.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Oh, tempo hari,\N‎aku pergi ke konser dengan Amamiya.
Dialogue: 0,0:09:56.47,0:10:01.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Saat kerumunan tiba-tiba menyerbu,\N‎dia datang menolongku.{\i0}
Dialogue: 0,0:10:01.01,0:10:03.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dia keren sekali.{\i0}
Dialogue: 0,0:10:04.22,0:10:06.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu membuat jantungku berdebar.
Dialogue: 0,0:10:06.89,0:10:07.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Begitu, ya.
Dialogue: 0,0:10:09.73,0:10:14.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku ingin mengajaknya main lagi\N‎saat libur musim panas.
Dialogue: 0,0:10:14.78,0:10:15.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bagaimana menurutmu?
Dialogue: 0,0:10:17.49,0:10:21.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kenapa dia memilihku\N‎untuk bicara soal ini?{\i0}
Dialogue: 0,0:10:21.87,0:10:26.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Lagi pula, kenapa dia tiba-tiba\N‎mulai mendekatiku?{\i0}
Dialogue: 0,0:10:27.12,0:10:28.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Apa untungnya?{\i0}
Dialogue: 0,0:10:28.46,0:10:29.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sebagai pelindung?{\i0}
Dialogue: 0,0:10:30.42,0:10:31.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sebagai perantara?{\i0}
Dialogue: 0,0:10:32.46,0:10:35.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sebagai teman.\N‎Aku benar-benar menyukainya.{\i0}
Dialogue: 0,0:10:35.71,0:10:39.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Bagi Amamiya,\N‎aku bukan orang yang spesial.{\i0}
Dialogue: 0,0:10:40.84,0:10:43.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tapi hal yang sama juga berlaku untuknya.{\i0}
Dialogue: 0,0:10:44.68,0:10:46.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak berhak untuk menentukan itu.
Dialogue: 0,0:10:50.39,0:10:52.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sebaiknya kubiarkan saja.{\i0}
Dialogue: 0,0:10:53.90,0:10:55.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kalau aku terus ikut campur,{\i0}
Dialogue: 0,0:10:56.19,0:10:58.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎aku akan menghadapi lagi\N‎sisi diriku yang kubenci.{\i0}
Dialogue: 0,0:10:59.53,0:11:01.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Merepotkan.{\i0}
Dialogue: 0,0:11:03.53,0:11:05.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kalau begitu, aku lewat sini…
Dialogue: 0,0:11:07.79,0:11:08.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sampai jumpa.
Dialogue: 0,0:11:11.25,0:11:14.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Bagaimana dia bisa begitu positif\N‎dan langsung maju seperti itu?{\i0}
Dialogue: 0,0:11:15.71,0:11:16.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Masa bodoh.{\i0}
Dialogue: 0,0:11:17.30,0:11:18.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Masa bodoh.{\i0}
Dialogue: 0,0:11:18.96,0:11:21.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Hatiku tak sebersih itu.{\i0}
Dialogue: 0,0:11:21.63,0:11:24.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎"Karena kau akan terluka,\N‎sebaiknya menyerah saja."{\i0}
Dialogue: 0,0:11:25.30,0:11:26.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tapi tak akan kukatakan.{\i0}
Dialogue: 0,0:11:28.22,0:11:31.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Momoka, kau benar berpacaran dengannya?{\i0}
Dialogue: 0,0:11:32.23,0:11:36.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kenapa? Kau sudah tahu\N‎aku yang menyukainya duluan, 'kan?{\i0}
Dialogue: 0,0:11:36.61,0:11:39.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Lalu kenapa?\N‎Kau lebih baik karena menyukainya duluan?{\i0}
Dialogue: 0,0:11:39.78,0:11:41.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dia yang mendekatiku lebih dulu.{\i0}
Dialogue: 0,0:11:44.70,0:11:47.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Jangan mengincar cowok orang!{\i0}
Dialogue: 0,0:11:47.58,0:11:51.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kalau kau tak ada, kami pasti saling suka.{\i0}
Dialogue: 0,0:11:52.00,0:11:54.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Licik dan bermuka dua sekali.{\i0}
Dialogue: 0,0:11:55.33,0:11:56.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Berisik.{\i0}
Dialogue: 0,0:11:57.09,0:11:59.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Masa bodoh.{\i0}
Dialogue: 0,0:12:00.34,0:12:03.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku sudah jujur soal perasaanku kali ini.{\i0}
Dialogue: 0,0:12:03.84,0:12:06.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Jadi, jangan salahkan aku nanti.{\i0}
Dialogue: 0,0:12:06.55,0:12:09.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Meski dia membenciku,\N‎aku bukan orang berhati murni.{\i0}
Dialogue: 0,0:12:11.02,0:12:15.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku tak akan minta maaf sama sekali.{\i0}
Dialogue: 0,0:12:19.15,0:12:21.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Soal yang kukatakan kepadamu\N‎saat festival olahraga,
Dialogue: 0,0:12:21.94,0:12:24.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎tolong lupakan semuanya.
Dialogue: 0,0:12:24.24,0:12:26.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Eh? Kenapa?
Dialogue: 0,0:12:27.28,0:12:29.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku ingin kami tetap berteman.
Dialogue: 0,0:12:30.33,0:12:32.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku ingin menghilangkan perasaan ini.
Dialogue: 0,0:12:33.25,0:12:34.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Perasaan ini?
Dialogue: 0,0:12:35.33,0:12:39.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku tak berani mengakhirinya\N‎seperti yang kau lakukan, Yota.{\i0}
Dialogue: 0,0:12:40.71,0:12:45.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak, perasaanku ketahuan,\N‎jadi aku terpaksa mengakhirinya.
Dialogue: 0,0:12:45.63,0:12:48.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku juga memang tak berniat\N‎melakukan apa pun,
Dialogue: 0,0:12:48.80,0:12:50.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎jadi aku tahu perasaanmu, Koyun.
Dialogue: 0,0:12:51.27,0:12:52.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima kasih.
Dialogue: 0,0:12:52.85,0:12:54.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Begitulah.
Dialogue: 0,0:12:54.14,0:12:56.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Oh, benar juga.
Dialogue: 0,0:12:56.19,0:13:01.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Amamiya bilang dia ingin kita main lagi\N‎saat libur musim panas.
Dialogue: 0,0:13:02.61,0:13:03.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa kau…
Dialogue: 0,0:13:03.90,0:13:05.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jadi…
Dialogue: 0,0:13:05.24,0:13:06.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau tak apa ikut?
Dialogue: 0,0:13:06.57,0:13:08.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya. Tak apa.
Dialogue: 0,0:13:09.45,0:13:12.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku sudah mengungkapkan perasaanku,\N‎jadi rasanya sudah lega.
Dialogue: 0,0:13:13.25,0:13:16.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kurasa mungkin Miki yang paling kesulitan.
Dialogue: 0,0:13:16.00,0:13:18.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Seperti katamu sebelumnya.{\i0}
Dialogue: 0,0:13:19.08,0:13:20.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}‎Banyak bentuk dan ukuran cinta.{\i0}
Dialogue: 0,0:13:22.42,0:13:25.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Menerima perasaan orang lain itu sulit.
Dialogue: 0,0:13:25.26,0:13:26.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Pasti.
Dialogue: 0,0:13:30.47,0:13:34.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jadi, dia sampai pergi ke belakang sekolah\N‎hanya untuk mengambil air.
Dialogue: 0,0:13:34.39,0:13:35.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Masa?
Dialogue: 0,0:13:38.60,0:13:39.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Apa bisa bertemu sekarang?{\i0}
Dialogue: 0,0:13:50.16,0:13:51.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ada apa?
Dialogue: 0,0:13:52.58,0:13:55.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf tiba-tiba memintamu bertemu di sini.
Dialogue: 0,0:13:59.92,0:14:06.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tadinya aku mau menunggu\N‎saat yang lebih tepat untukmu.
Dialogue: 0,0:14:06.80,0:14:11.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi rasanya saat itu tak akan datang\N‎kalau aku terus menunggu.
Dialogue: 0,0:14:11.80,0:14:14.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak bisa menunggu lagi.
Dialogue: 0,0:14:17.69,0:14:20.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku menyukaimu, Amamiya.
Dialogue: 0,0:14:20.69,0:14:21.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maukah kau
Dialogue: 0,0:14:22.98,0:14:24.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎menjadi pacarku?
Dialogue: 0,0:14:30.28,0:14:31.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf.
Dialogue: 0,0:14:31.91,0:14:33.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku senang mendengarnya, tapi…
Dialogue: 0,0:14:44.50,0:14:46.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tsukiko.
Dialogue: 0,0:14:46.01,0:14:49.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kami juga menemukan beberapa properti\N‎yang sepertinya berguna.
Dialogue: 0,0:14:49.17,0:14:50.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima kasih.
Dialogue: 0,0:14:50.51,0:14:51.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Akan kutaruh di sini.
Dialogue: 0,0:14:52.51,0:14:54.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima kasih juga, Hino.
Dialogue: 0,0:14:54.35,0:14:55.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf membuatmu ikut membantu.
Dialogue: 0,0:14:56.89,0:14:59.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku jadi karpet, jadi tak ada dialog.
Dialogue: 0,0:14:59.77,0:15:03.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jin! Ubah aku\N‎menjadi penyihir terhebat di dunia!
Dialogue: 0,0:15:05.27,0:15:07.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Oh, jinnya sedang diancam.
Dialogue: 0,0:15:08.15,0:15:09.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Oh, bagus! Keren!
Dialogue: 0,0:15:11.03,0:15:12.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Penjahatnya makin kuat.
Dialogue: 0,0:15:14.91,0:15:16.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei!
Dialogue: 0,0:15:17.04,0:15:19.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Karpet juga harus ikut latihan.
Dialogue: 0,0:15:19.29,0:15:22.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baik, penjahatnya terisap ke dalam lampu.
Dialogue: 0,0:15:25.09,0:15:28.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Lalu Aladdin dan Putri akhirnya bersama.\N‎Akhir yang bahagia!
Dialogue: 0,0:15:29.67,0:15:32.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yota, kenapa posenya begitu?
Dialogue: 0,0:15:32.01,0:15:34.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku membayangkan penampilanku\N‎dalam kostum karpet.
Dialogue: 0,0:15:37.14,0:15:38.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Seram juga kalau begitu!
Dialogue: 0,0:15:38.39,0:15:40.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mungkin aku harus bertepuk tangan.
Dialogue: 0,0:15:44.36,0:15:46.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Eh, Miki, kau ganti warna rambutmu?
Dialogue: 0,0:15:46.86,0:15:48.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau baru sadar?
Dialogue: 0,0:15:48.19,0:15:49.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf.
Dialogue: 0,0:15:50.11,0:15:53.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yah, warna apa pun cocok untukku.
Dialogue: 0,0:15:54.57,0:15:56.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa pun memang cocok untukmu, Miki.
Dialogue: 0,0:16:01.37,0:16:02.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Benar!
Dialogue: 0,0:16:02.54,0:16:04.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku cuma bercanda…{\i0}
Dialogue: 0,0:16:07.59,0:16:08.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Amamiya.
Dialogue: 0,0:16:08.80,0:16:10.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aktingmu benar-benar total.
Dialogue: 0,0:16:10.97,0:16:14.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Soalnya, sulit melihat seseorang\N‎berakting malu-malu begitu.
Dialogue: 0,0:16:15.84,0:16:17.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Semangat.
Dialogue: 0,0:16:18.18,0:16:19.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bagaimana perkembangan setnya?
Dialogue: 0,0:16:19.85,0:16:22.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tsukiko sedang menggambarnya sekarang.
Dialogue: 0,0:16:22.98,0:16:24.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Oh, halo.
Dialogue: 0,0:16:24.10,0:16:27.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Selain itu, kami masih mengumpulkan bahan.
Dialogue: 0,0:16:28.02,0:16:29.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Begitu, ya.
Dialogue: 0,0:16:29.86,0:16:34.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Entah kenapa, Amamiya dan Koyuki\N‎sekarang terlihat biasa saja.{\i0}
Dialogue: 0,0:16:35.28,0:16:37.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Saking biasanya, malah terasa tak biasa.{\i0}
Dialogue: 0,0:16:38.03,0:16:42.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Padahal saat festival olahraga,\N‎mereka berdua sangat canggung.{\i0}
Dialogue: 0,0:16:44.87,0:16:46.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Mereka berdua ini…{\i0}
Dialogue: 0,0:16:46.54,0:16:47.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Apa yang terjadi?{\i0}
Dialogue: 0,0:16:48.96,0:16:50.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Ya. Tak apa.{\i0}
Dialogue: 0,0:16:50.92,0:16:53.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku bisa mengobrol biasa\N‎dengannya sekarang.{\i0}
Dialogue: 0,0:16:53.13,0:16:56.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kurasa hubungan saat ini sudah pas.{\i0}
Dialogue: 0,0:16:57.85,0:17:01.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Selama ini,\N‎aku selalu menghindari orang-orang.{\i0}
Dialogue: 0,0:17:02.68,0:17:05.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tapi perlahan,\N‎duniaku terasa makin terbuka.{\i0}
Dialogue: 0,0:17:06.06,0:17:10.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sekarang aku senang\N‎dengan kelas dan sekolah ini.{\i0}
Dialogue: 0,0:17:11.57,0:17:15.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Makanya situasi saat ini\N‎sudah paling nyaman,{\i0}
Dialogue: 0,0:17:15.86,0:17:16.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎sudah pas.{\i0}
Dialogue: 0,0:17:17.61,0:17:19.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Ya, benar.{\i0}
Dialogue: 0,0:17:19.91,0:17:21.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Pasti begitu.{\i0}
Dialogue: 0,0:17:24.33,0:17:26.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baik, cukup untuk hari ini.
Dialogue: 0,0:17:26.75,0:17:28.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Kerja bagus!\N‎- Bagus!
Dialogue: 0,0:17:28.46,0:17:29.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Oh, Koyun.
Dialogue: 0,0:17:31.50,0:17:32.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Halo.
Dialogue: 0,0:17:33.09,0:17:35.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Momoka, ada apa?
Dialogue: 0,0:17:37.80,0:17:39.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ke mana Minato pergi?
Dialogue: 0,0:17:41.72,0:17:42.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎"Minato"?{\i0}
Dialogue: 0,0:17:44.22,0:17:47.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kami seharusnya pulang bersama.
Dialogue: 0,0:17:47.85,0:17:48.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Eh?
Dialogue: 0,0:17:50.19,0:17:51.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Eh?
Dialogue: 0,0:17:51.27,0:17:52.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Minato tak memberitahumu?
Dialogue: 0,0:17:54.07,0:17:56.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kami sekarang berpacaran.
Dialogue: 0,0:17:57.91,0:17:58.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa?
Dialogue: 0,0:18:01.70,0:18:02.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maukah kau
Dialogue: 0,0:18:03.62,0:18:05.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎menjadi pacarku?
Dialogue: 0,0:18:09.37,0:18:10.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf.
Dialogue: 0,0:18:10.54,0:18:12.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku senang mendengarnya, tapi…
Dialogue: 0,0:18:12.13,0:18:16.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Karena menyukai orang lain,\N‎kau tak bisa berpacaran denganku?
Dialogue: 0,0:18:17.26,0:18:20.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku bisa tahu hanya dengan melihatmu
Dialogue: 0,0:18:20.72,0:18:23.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎kalau ada seseorang yang kau sukai.
Dialogue: 0,0:18:24.14,0:18:27.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau memang bilang senang\N‎mendengar perasaanku,
Dialogue: 0,0:18:28.10,0:18:31.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎tapi aku tahu kau sama sekali\N‎tak menganggapku begitu.
Dialogue: 0,0:18:32.06,0:18:33.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tahu semuanya.
Dialogue: 0,0:18:37.24,0:18:39.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi, apa gadis yang kau sukai
Dialogue: 0,0:18:40.41,0:18:42.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎merasakan hal yang sama denganmu?
Dialogue: 0,0:18:42.91,0:18:44.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Meski kau menyukai orang lain,
Dialogue: 0,0:18:45.54,0:18:47.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎aku tak bisa menyerah.
Dialogue: 0,0:18:48.87,0:18:50.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ucapanmu benar-benar mengena di hati.
Dialogue: 0,0:18:51.71,0:18:53.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa tak terasa menyakitkan?
Dialogue: 0,0:18:54.63,0:18:56.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Memangnya kau pikir tak menyakitkan?
Dialogue: 0,0:18:56.51,0:18:59.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kalau begitu, kenapa tak memilihku saja?
Dialogue: 0,0:19:02.22,0:19:06.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku ini tak sebaik yang kau kira.
Dialogue: 0,0:19:07.02,0:19:10.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Selama ini, aku hanya berpacaran\N‎karena mereka yang memintaku.
Dialogue: 0,0:19:11.35,0:19:13.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dan aku menyakiti banyak orang.
Dialogue: 0,0:19:14.11,0:19:17.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku merasa aku tak boleh begitu lagi.
Dialogue: 0,0:19:18.32,0:19:22.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jadi, itu alasannya\N‎kau tak bisa jadi pacarku?
Dialogue: 0,0:19:23.74,0:19:24.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya.
Dialogue: 0,0:19:35.00,0:19:36.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau bilang
Dialogue: 0,0:19:36.71,0:19:38.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎kau bukan orang yang baik
Dialogue: 0,0:19:38.80,0:19:41.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎dan sudah menyakiti para mantan pacarmu.
Dialogue: 0,0:19:41.43,0:19:43.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi semua itu
Dialogue: 0,0:19:43.80,0:19:47.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎tak ada hubungannya denganku, 'kan?
Dialogue: 0,0:19:47.31,0:19:48.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Eh?
Dialogue: 0,0:19:48.56,0:19:51.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku bahkan tak termasuk di dalamnya.
Dialogue: 0,0:19:51.56,0:19:57.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa yang kau tidak suka dariku,\N‎bagaimana perasaanmu kepadaku…
Dialogue: 0,0:19:58.23,0:20:01.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa pun yang kau pikirkan\N‎atau rasakan tentangku,
Dialogue: 0,0:20:02.36,0:20:04.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎semua itu tak ada hubungannya,
Dialogue: 0,0:20:04.24,0:20:05.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎karena kau bahkan tak melihatku.
Dialogue: 0,0:20:06.70,0:20:08.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu terlalu menyedihkan.
Dialogue: 0,0:20:10.41,0:20:13.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku bahkan belum ada di garis awal.
Dialogue: 0,0:20:13.29,0:20:17.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku belum mau merelakan perasaan ini.
Dialogue: 0,0:20:22.30,0:20:23.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku menyukaimu.
Dialogue: 0,0:20:24.18,0:20:26.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tolong beri aku kesempatan.
Dialogue: 0,0:20:34.39,0:20:37.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan menangis, Kuriki.
Dialogue: 0,0:20:38.44,0:20:39.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ayo kita coba.
Dialogue: 0,0:20:43.90,0:20:45.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa?
Dialogue: 0,0:20:46.87,0:20:48.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Serius?\N‎- Ya.
Dialogue: 0,0:20:48.66,0:20:50.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Wah, hore!
Dialogue: 0,0:20:51.25,0:20:53.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- "Hore"?\N‎- Wah, mustahil!
Dialogue: 0,0:20:54.16,0:20:57.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Amamiya, ternyata kau bawa saputangan, ya?
Dialogue: 0,0:20:57.63,0:20:59.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Berguna di saat seperti ini, 'kan?
Dialogue: 0,0:20:59.38,0:21:01.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Wah, gombal sekali.
Dialogue: 0,0:21:04.51,0:21:08.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Makanya, kami berpacaran sekarang.
Dialogue: 0,0:21:10.18,0:21:16.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Jujur, tidak kusangka akan mengatakannya\N‎dengan kikuk dan putus asa.{\i0}
Dialogue: 0,0:21:17.56,0:21:19.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tapi aku pacarnya sekarang.{\i0}
Dialogue: 0,0:21:20.19,0:21:22.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sejak kapan?
Dialogue: 0,0:21:22.19,0:21:24.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sebelum libur musim panas dimulai.
Dialogue: 0,0:21:25.07,0:21:30.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku memang agak penasaran\N‎apa Minato menyembunyikan hubungan kami.{\i0}
Dialogue: 0,0:21:31.54,0:21:36.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Setiap kali melihatnya,\N‎aku selalu merasa tak nyaman.{\i0}
Dialogue: 0,0:21:37.00,0:21:39.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tapi karena dia bukan lagi penghalang,{\i0}
Dialogue: 0,0:21:39.21,0:21:42.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎sekarang aku tak peduli lagi.{\i0}
Dialogue: 0,0:21:44.21,0:21:47.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kalau begitu, Koyun, aku mau cari Minato.
Dialogue: 0,0:21:48.93,0:21:49.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sampai jumpa.
Dialogue: 0,0:21:56.35,0:21:57.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa?
Dialogue: 0,0:22:00.15,0:22:01.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bukannya itu Minato dan Kuriki?
Dialogue: 0,0:22:05.61,0:22:06.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei, diam!
Dialogue: 0,0:22:07.36,0:22:09.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tunggu, apa mereka berdua berpacaran?
Dialogue: 0,0:22:09.61,0:22:10.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sepertinya begitu.
Dialogue: 0,0:22:15.33,0:22:18.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Koyun, maaf meninggalkanmu\N‎bersih-bersih sendirian.
Dialogue: 0,0:22:18.50,0:22:19.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf.
Dialogue: 0,0:22:21.13,0:22:22.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Koyun?
Dialogue: 0,0:23:50.92,0:23:55.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terjemahan subtitle oleh Shoffanny R
