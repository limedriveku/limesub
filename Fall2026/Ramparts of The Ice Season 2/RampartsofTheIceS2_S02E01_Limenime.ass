Dialogue: 0,0:00:52.59,0:00:56.97,sign,,0000,0000,0000,,‎EPISODE 15\N‎CUACA HUJAN BERAWAN
Dialogue: 0,0:01:21.91,0:01:23.16,sign,,0000,0000,0000,,‎LESU…
Dialogue: 0,0:01:46.94,0:01:48.77,sign,,0000,0000,0000,,{\an8}‎ANGKAT\N{\i1}‎PLANK{\i0}‎ SAMPING
Dialogue: 0,0:01:59.61,0:02:02.03,sign,,0000,0000,0000,,‎SMA MEITEN
Dialogue: 0,0:03:27.54,0:03:28.62,sign,,0000,0000,0000,,‎JUS PISANG
Dialogue: 0,0:03:38.05,0:03:39.05,sign,,0000,0000,0000,,‎SERUPUT HABIS
Dialogue: 0,0:04:36.02,0:04:37.35,sign,,0000,0000,0000,,‎APA AKU SEDANG DISALAHKAN…?
Dialogue: 0,0:04:37.36,0:04:38.77,sign,,0000,0000,0000,,‎MERASA BERSALAH
Dialogue: 0,0:04:48.37,0:04:49.37,sign,,0000,0000,0000,,‎SENYUM…
Dialogue: 0,0:07:13.68,0:07:14.76,sign,,0000,0000,0000,,‎HA, AKU? SIAPA…?
Dialogue: 0,0:07:17.68,0:07:18.77,sign,,0000,0000,0000,,‎SEPERTINYA DIA BAIK
Dialogue: 0,0:07:22.81,0:07:23.90,sign,,0000,0000,0000,,‎PUTUS LAGI~!!!
Dialogue: 0,0:07:34.37,0:07:35.37,sign,,0000,0000,0000,,‎HUH, SUDAHLAH\N‎LUPAKAN…
Dialogue: 0,0:09:08.25,0:09:09.21,sign,,0000,0000,0000,,‎RETAK
Dialogue: 0,0:09:48.50,0:09:49.58,sign,,0000,0000,0000,,‎TIM PEMANDU SORAK YANG MAKIN AKRAB
Dialogue: 0,0:09:59.30,0:10:00.59,sign,,0000,0000,0000,,‎ADA APA INI…?
Dialogue: 0,0:10:11.40,0:10:12.98,sign,,0000,0000,0000,,{\an8}‎HAHA\N‎MENGHINDAR…?
Dialogue: 0,0:10:26.70,0:10:28.37,sign,,0000,0000,0000,,‎KELAS 2-2
Dialogue: 0,0:10:43.64,0:10:45.35,sign,,0000,0000,0000,,‎KAU TAK APA?\N‎MAU BICARAKAN SESUATU?
Dialogue: 0,0:10:46.89,0:10:48.14,sign,,0000,0000,0000,,‎SOAL YOTA\N‎SOAL AMAMIYA
Dialogue: 0,0:10:50.27,0:10:51.35,sign,,0000,0000,0000,,‎MALU SEKALI
Dialogue: 0,0:10:53.73,0:10:54.81,sign,,0000,0000,0000,,‎AKU INGIN JUJUR AGAR LEGA
Dialogue: 0,0:10:56.90,0:10:57.90,sign,,0000,0000,0000,,‎TAPI NANTI MALAH JADI CANGGUNG
Dialogue: 0,0:11:35.15,0:11:36.23,sign,,0000,0000,0000,,‎LEMBEK
Dialogue: 0,0:13:46.07,0:13:47.15,sign,,0000,0000,0000,,‎BERKACA-KACA…
Dialogue: 0,0:14:34.95,0:14:36.04,sign,,0000,0000,0000,,‎DEG DEG
Dialogue: 0,0:15:45.98,0:15:47.07,sign,,0000,0000,0000,,‎TUNGGU\N‎MUSTAHIL
Dialogue: 0,0:15:57.33,0:15:58.41,sign,,0000,0000,0000,,‎KEHILANGAN KOSAKATA
Dialogue: 0,0:16:34.32,0:16:36.07,sign,,0000,0000,0000,,{\an8}‎SEMUA KESALAHPAHAMAN SUDAH TERJAWAB
Dialogue: 0,0:17:45.52,0:17:47.02,sign,,0000,0000,0000,,‎NAFSU BERAHI
Dialogue: 0,0:18:48.37,0:18:50.87,sign,,0000,0000,0000,,‎DERU KERETA
Dialogue: 0,0:18:50.87,0:18:52.83,sign,,0000,0000,0000,,{\an8}‎MATA SEMBAP
Dialogue: 0,0:19:29.08,0:19:30.58,sign,,0000,0000,0000,,‎SULIT UNTUK DIBANTAH
Dialogue: 0,0:21:26.78,0:21:27.86,sign,,0000,0000,0000,,‎KELAS 2-2
Dialogue: 0,0:00:12.01,0:00:14.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}‎Melihat ekspresinya\N‎yang pura-pura tidak tahu,{\i0}
Dialogue: 0,0:00:14.84,0:00:16.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎aku pikir ini adalah kesempatan.{\i0}
Dialogue: 0,0:00:17.22,0:00:20.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Amamiya mungkin menyukainya.{\i0}
Dialogue: 0,0:00:21.56,0:00:22.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}‎Mereka mungkin saling suka.{\i0}
Dialogue: 0,0:00:23.85,0:00:24.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}‎Tapi…{\i0}
Dialogue: 0,0:00:25.94,0:00:28.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}‎Dia tak akan pernah bertindak lebih dulu.{\i0}
Dialogue: 0,0:00:29.61,0:00:33.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}‎Terus membuat alasan\N‎dan pura-pura tidak sadar.{\i0}
Dialogue: 0,0:00:33.74,0:00:37.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}‎Dia orang lemah yang sibuk melindungi diri\N‎agar tak tersakiti.{\i0}
Dialogue: 0,0:00:38.32,0:00:40.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dia tak mau berusaha sendiri.{\i0}
Dialogue: 0,0:00:40.62,0:00:43.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dia tipe orang yang harus dibahagiakan\N‎oleh orang di sekitarnya.{\i0}
Dialogue: 0,0:00:43.87,0:00:46.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}‎Dia gadis pasif yang hanya menunggu.{\i0}
Dialogue: 0,0:00:49.88,0:00:51.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}‎Aku benci itu.{\i0}
Dialogue: 0,0:00:58.18,0:01:00.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Band Meiten akan mengadakan konser.
Dialogue: 0,0:01:00.56,0:01:03.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau sudah dengar\N‎dari Akahoshi atau yang lainnya?
Dialogue: 0,0:01:04.73,0:01:07.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sepertinya mereka pernah bilang begitu.{\i0}
Dialogue: 0,0:01:07.27,0:01:09.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mau pergi bersamaku?
Dialogue: 0,0:01:09.02,0:01:11.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Temanku akan tampil,\N‎jadi aku ingin menontonnya.
Dialogue: 0,0:01:12.23,0:01:14.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi aku tak berani pergi sendirian.
Dialogue: 0,0:01:16.11,0:01:17.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Boleh, ayo ke sana.{\i0}
Dialogue: 0,0:01:18.62,0:01:21.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sekalian saja\N‎ajak anak-anak lain yang tertarik.{\i0}
Dialogue: 0,0:01:24.33,0:01:25.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Makin ramai makin bagus, 'kan?{\i0}
Dialogue: 0,0:01:26.79,0:01:27.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Benar.
Dialogue: 0,0:01:28.83,0:01:30.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf.
Dialogue: 0,0:01:30.21,0:01:32.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku cuma mau bilang soal itu.
Dialogue: 0,0:01:32.30,0:01:35.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kupikir lebih cepat lewat telepon\N‎daripada harus mengetik.
Dialogue: 0,0:01:36.97,0:01:38.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Lebih cepat, ya?{\i0}
Dialogue: 0,0:01:39.09,0:01:42.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kalau begitu, nanti kuhubungi lagi\N‎jika sudah dekat harinya, ya?
Dialogue: 0,0:01:42.35,0:01:44.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Baik. Terima kasih.{\i0}
Dialogue: 0,0:01:55.78,0:01:58.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hujannya tak berhenti.
Dialogue: 0,0:02:04.91,0:02:05.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku menyukaimu.{\i0}
Dialogue: 0,0:02:08.21,0:02:13.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku harus bersikap bagaimana\N‎saat bertemu Yota di kelas?{\i0}
Dialogue: 0,0:02:13.75,0:02:16.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Apa aku kejam kalau menyapa seperti biasa?{\i0}
Dialogue: 0,0:02:16.76,0:02:18.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tapi menyakitkan kalau menghindarinya.{\i0}
Dialogue: 0,0:02:19.63,0:02:22.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku bahkan tak bisa membalas perasaannya.{\i0}
Dialogue: 0,0:02:22.80,0:02:25.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Apa aku tak tahu diri jika memikirkan ini?{\i0}
Dialogue: 0,0:02:25.85,0:02:26.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Bagaimana ini?{\i0}
Dialogue: 0,0:02:28.39,0:02:29.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Miki.
Dialogue: 0,0:02:31.40,0:02:32.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Selamat pagi.
Dialogue: 0,0:02:34.27,0:02:37.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau sudah belajar\N‎untuk kuis bahasa hari ini?
Dialogue: 0,0:02:38.86,0:02:39.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa?
Dialogue: 0,0:02:39.95,0:02:41.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hari ini, ya? Gawat!
Dialogue: 0,0:02:42.95,0:02:45.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Masih ada waktu, tak apa.
Dialogue: 0,0:02:45.33,0:02:46.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Cuma perlu hafalkan lembarannya.
Dialogue: 0,0:02:46.95,0:02:48.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Begitu lagi.
Dialogue: 0,0:02:48.75,0:02:51.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎"Cuma perlu hafalkan."\N‎Jangan bicara semudah itu!
Dialogue: 0,0:02:52.33,0:02:53.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Astaga!
Dialogue: 0,0:02:54.17,0:02:56.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Semangat. Kau pasti bisa.
Dialogue: 0,0:02:56.50,0:02:59.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yota. Duluan, ya?
Dialogue: 0,0:02:59.72,0:03:00.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tunggu.
Dialogue: 0,0:03:02.30,0:03:04.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kalau begitu, sampai nanti.
Dialogue: 0,0:03:18.32,0:03:20.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia terlalu baik.
Dialogue: 0,0:03:28.62,0:03:31.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Miki, ada sesuatu yang terjadi, 'kan?
Dialogue: 0,0:03:32.62,0:03:33.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak ada, kok.
Dialogue: 0,0:03:34.38,0:03:35.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ini, minumlah.
Dialogue: 0,0:03:42.43,0:03:43.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei, Minato.
Dialogue: 0,0:03:45.05,0:03:48.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau tak masalah berpacaran\N‎dengan orang yang tak kau sukai, 'kan?
Dialogue: 0,0:03:48.72,0:03:50.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa? Tiba-tiba mengejekku?
Dialogue: 0,0:03:51.52,0:03:54.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau pernah menolak\N‎saat ada yang bilang suka padamu?
Dialogue: 0,0:03:58.32,0:04:00.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sepertinya tak pernah.
Dialogue: 0,0:04:00.07,0:04:01.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kenapa?
Dialogue: 0,0:04:01.86,0:04:03.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tak ada alasan untuk berpacaran,
Dialogue: 0,0:04:04.41,0:04:06.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎tapi tak ada alasan juga untuk menolak.
Dialogue: 0,0:04:06.74,0:04:07.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak benci mereka.
Dialogue: 0,0:04:09.24,0:04:10.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Lalu setelahnya?
Dialogue: 0,0:04:11.00,0:04:13.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau pernah menyesal\N‎sudah berpacaran dengan mereka?
Dialogue: 0,0:04:14.71,0:04:16.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Kalau soal itu,
Dialogue: 0,0:04:16.88,0:04:18.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎mungkin malah mereka yang menyesal.
Dialogue: 0,0:04:19.42,0:04:21.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku yang selalu diminta putus.
Dialogue: 0,0:04:21.09,0:04:24.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kalau mereka sudah tak membutuhkanku,
Dialogue: 0,0:04:24.51,0:04:27.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎aku tak bisa apa-apa lagi.
Dialogue: 0,0:04:28.47,0:04:31.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mungkin para gadis itu sakit hati
Dialogue: 0,0:04:31.10,0:04:34.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎karena perasaanmu tak sama\N‎dengan perasaan mereka.
Dialogue: 0,0:04:40.61,0:04:43.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Semoga suatu hari nanti,\N‎kau akan jatuh cinta pada seseorang{\i0}
Dialogue: 0,0:04:44.24,0:04:48.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎yang tak peduli padamu sama sekali\N‎dan membuatmu merasa patah hati.{\i0}
Dialogue: 0,0:04:50.79,0:04:52.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya. Benar juga.
Dialogue: 0,0:04:53.50,0:04:55.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Cinta tak berbalas itu menyakitkan.{\i0}
Dialogue: 0,0:04:56.50,0:04:57.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sekarang aku paham.{\i0}
Dialogue: 0,0:04:58.50,0:05:00.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau benar, Miki.
Dialogue: 0,0:05:01.17,0:05:04.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mungkin aku sudah jahat\N‎ke gadis-gadis yang pernah kupacari.
Dialogue: 0,0:05:05.34,0:05:07.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Pasti akhirnya begitu, ya?
Dialogue: 0,0:05:07.93,0:05:09.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak akan berjalan lancar.
Dialogue: 0,0:05:09.47,0:05:11.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Eh, tunggu.
Dialogue: 0,0:05:11.93,0:05:16.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan-jangan\N‎ada yang menyatakan perasaan padamu
Dialogue: 0,0:05:16.23,0:05:18.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎dan kau sedang memikirkan\N‎untuk menolaknya?
Dialogue: 0,0:05:20.48,0:05:22.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Gawat.{\i0}
Dialogue: 0,0:05:22.11,0:05:24.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sepertinya ucapanku tadi tidak tepat.{\i0}
Dialogue: 0,0:05:24.15,0:05:25.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bukan.
Dialogue: 0,0:05:26.65,0:05:27.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku sudah menolaknya.
Dialogue: 0,0:05:31.45,0:05:32.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa?
Dialogue: 0,0:05:33.95,0:05:36.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jadi, sekarang sudah berakhir.
Dialogue: 0,0:05:38.83,0:05:42.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yah, aku memang sudah tahu akan ditolak.
Dialogue: 0,0:05:43.00,0:05:46.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi rasanya lega bisa mengatakan\N‎yang selama ini kutahan.
Dialogue: 0,0:05:47.55,0:05:49.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Benarkah? Sungguh?
Dialogue: 0,0:05:50.30,0:05:51.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya.
Dialogue: 0,0:05:52.72,0:05:56.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi aku juga berpikir,\N‎"Sudah berakhir, ya?"
Dialogue: 0,0:05:57.60,0:06:00.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ada sesuatu yang sangat besar\N‎di dalam diriku selama ini,
Dialogue: 0,0:06:00.35,0:06:02.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎tapi sekarang\N‎cuma ada lubang kosong menganga.
Dialogue: 0,0:06:04.57,0:06:05.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Rasanya
Dialogue: 0,0:06:06.53,0:06:09.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎aku ingin cepat mengisinya lagi.
Dialogue: 0,0:06:10.20,0:06:11.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yota.
Dialogue: 0,0:06:11.74,0:06:12.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}‎Menangislah…{\i0}
Dialogue: 0,0:06:15.12,0:06:17.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Oh, dia tak menangis.{\i0}
Dialogue: 0,0:06:18.37,0:06:22.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak, kupikir kau butuh saputangan.
Dialogue: 0,0:06:23.67,0:06:25.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima kasih. Aku tak apa.
Dialogue: 0,0:06:26.09,0:06:28.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Biasanya orang menangis\N‎di saat begini, ya?
Dialogue: 0,0:06:29.13,0:06:31.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku orang yang sulit menangis.
Dialogue: 0,0:06:31.93,0:06:37.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku memang sedih saat acara kelulusan\N‎dan saat kalah di pertandingan final,{\i0}
Dialogue: 0,0:06:37.93,0:06:42.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎tapi terhadap apa pun itu,\N‎mungkin aku sudah pasrah dari awal.
Dialogue: 0,0:06:43.94,0:06:46.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Emosi yang biasanya\N‎kuluapkan lewat air mata,{\i0}
Dialogue: 0,0:06:48.15,0:06:50.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Yota terus menahannya begitu saja.{\i0}
Dialogue: 0,0:06:51.36,0:06:54.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku menyukai orang ini,
Dialogue: 0,0:06:54.78,0:06:56.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎tapi hanya sebagai teman.
Dialogue: 0,0:06:57.91,0:07:00.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau tak bisa melihatnya\N‎sebagai pasangan romantis?
Dialogue: 0,0:07:02.67,0:07:06.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Waktu SMP, aku memang pernah\N‎berpacaran beberapa kali.
Dialogue: 0,0:07:07.30,0:07:11.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi saat itu,\N‎bahkan sejak bertukar nomor kontak,
Dialogue: 0,0:07:11.26,0:07:13.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎suasananya sudah terasa seperti itu.
Dialogue: 0,0:07:14.76,0:07:17.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku sudah berpikir\N‎dia orang yang bisa kujadikan pacar.{\i0}
Dialogue: 0,0:07:18.77,0:07:22.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku juga mungkin menyukainya,\N‎lalu berpacaran dengan perasaan samar.{\i0}
Dialogue: 0,0:07:23.90,0:07:25.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tapi selalu gagal.{\i0}
Dialogue: 0,0:07:25.48,0:07:28.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Setiap kali itu terjadi,\N‎aku merasa seperti ditolak.{\i0}
Dialogue: 0,0:07:29.19,0:07:34.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tapi meski begitu,\N‎aku memang tak pernah serius dari awal.{\i0}
Dialogue: 0,0:07:36.08,0:07:39.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Makanya aku tak pernah\N‎menjalani hubungan yang benar.
Dialogue: 0,0:07:41.04,0:07:43.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku hanya merasa senang karena disukai.
Dialogue: 0,0:07:43.42,0:07:47.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi jika berpacaran dengan seseorang\N‎saat belum bisa menyukainya,
Dialogue: 0,0:07:48.25,0:07:50.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎aku hanya akan memberinya\N‎harapan palsu, 'kan?
Dialogue: 0,0:07:51.92,0:07:56.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku pasti akan jadi\N‎membenci diriku sendiri.
Dialogue: 0,0:07:57.85,0:08:01.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Makanya, kurasa keputusanku tak salah.
Dialogue: 0,0:08:02.98,0:08:04.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Meskipun begitu,
Dialogue: 0,0:08:04.85,0:08:06.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎rasanya sangat menyakitkan.
Dialogue: 0,0:08:11.44,0:08:15.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Miki, kau berharap selama ini\N‎Yota hanya memperlakukanmu sebagai teman?
Dialogue: 0,0:08:19.20,0:08:22.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Eh? Kok tahu?\N‎- Ini soal Yota, 'kan?
Dialogue: 0,0:08:22.25,0:08:23.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Melihatnya saja langsung tahu.
Dialogue: 0,0:08:25.00,0:08:27.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kalau begitu, aku…
Dialogue: 0,0:08:27.88,0:08:30.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hanya aku yang tak menyadarinya.
Dialogue: 0,0:08:31.21,0:08:35.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Saat bilang "sahabat" atau "suka",\N‎aku benar-benar
Dialogue: 0,0:08:37.35,0:08:38.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎bodoh dan tak peka.
Dialogue: 0,0:08:39.76,0:08:41.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku jadi membenci diriku.
Dialogue: 0,0:08:46.10,0:08:47.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bagaimana ini?
Dialogue: 0,0:08:48.31,0:08:49.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Rasanya menyakitkan.
Dialogue: 0,0:08:51.57,0:08:55.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau tak salah apa-apa, Miki.\N‎Bukan salah Yota atau siapa pun juga.
Dialogue: 0,0:08:56.78,0:09:02.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bayangkan orang yang dianggap teman\N‎ternyata menyukai kita lebih dari itu.
Dialogue: 0,0:09:03.00,0:09:05.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Lalu sadar\N‎dia melihat kita secara berbeda,
Dialogue: 0,0:09:05.96,0:09:08.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎rasanya agak menjijikkan, ya?
Dialogue: 0,0:09:09.79,0:09:11.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Saat kita menyukai seseorang,
Dialogue: 0,0:09:11.63,0:09:13.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎itu terjadi begitu saja tanpa disadari.
Dialogue: 0,0:09:14.59,0:09:18.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Meskipun dia tak membalas perasaan kita.
Dialogue: 0,0:09:18.18,0:09:19.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Selain itu,{\i0}
Dialogue: 0,0:09:19.26,0:09:25.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Koyun bilang orang yang dia anggap teman\N‎sudah tak bisa jadi pasangannya.{\i0}
Dialogue: 0,0:09:27.77,0:09:30.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Pasti tahu ada risiko terluka.
Dialogue: 0,0:09:31.98,0:09:35.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Ucapan ini sebenarnya\N‎untuk meyakinkan siapa?{\i0}
Dialogue: 0,0:09:36.95,0:09:37.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku…{\i0}
Dialogue: 0,0:09:39.20,0:09:40.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Perasaanku ini…{\i0}
Dialogue: 0,0:09:43.79,0:09:46.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Astaga, lapar sekali.
Dialogue: 0,0:09:46.12,0:09:47.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kakak-Kakak!
Dialogue: 0,0:09:47.29,0:09:48.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Selamat siang.
Dialogue: 0,0:09:49.58,0:09:50.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei, Kuriki.
Dialogue: 0,0:09:51.38,0:09:54.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku akan menonton konsernya,\N‎jadi aku sangat menantikannya.
Dialogue: 0,0:09:54.38,0:09:55.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau mau datang?
Dialogue: 0,0:09:56.22,0:09:58.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya! Bersama Amamiya.
Dialogue: 0,0:10:00.60,0:10:02.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hubungan kalian berdua seperti itu?
Dialogue: 0,0:10:03.31,0:10:04.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bukan begitu.
Dialogue: 0,0:10:04.72,0:10:07.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kami juga mau mengajak yang lainnya.
Dialogue: 0,0:10:07.98,0:10:11.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku pasti terlalu agresif,\N‎jadi dia selalu menghindar.
Dialogue: 0,0:10:12.98,0:10:14.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sampai jumpa!
Dialogue: 0,0:10:17.03,0:10:20.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Amamiya menghindar? Atau perasaannya saja?
Dialogue: 0,0:10:20.16,0:10:21.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Pasti begitu.
Dialogue: 0,0:10:21.53,0:10:24.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa pun itu,\N‎aku khawatir dia nantinya menangis.
Dialogue: 0,0:10:28.87,0:10:29.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Miki.
Dialogue: 0,0:10:30.58,0:10:33.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Hari ini ada kerja paruh waktu?\N‎- Tidak ada.
Dialogue: 0,0:10:34.25,0:10:37.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Mau mampir dulu nanti?\N‎- Boleh.
Dialogue: 0,0:10:38.63,0:10:40.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tumben sekali Koyun yang ajak.{\i0}
Dialogue: 0,0:10:41.72,0:10:43.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Banyak yang ingin kutanyakan ke Miki.{\i0}
Dialogue: 0,0:10:45.35,0:10:46.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tapi aku juga belum cerita.{\i0}
Dialogue: 0,0:10:48.68,0:10:50.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Lalu soal Amamiya…{\i0}
Dialogue: 0,0:10:51.35,0:10:53.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Rasanya malu membicarakan ini sekarang.{\i0}
Dialogue: 0,0:10:54.82,0:10:56.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Ini bahkan pertama kalinya\N‎aku mengakuinya.{\i0}
Dialogue: 0,0:10:58.44,0:11:02.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Semua pikiran ini bercampur aduk\N‎dan harus diucapkan nanti,{\i0}
Dialogue: 0,0:11:02.16,0:11:03.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎aku jadi cemas dan gugup.{\i0}
Dialogue: 0,0:11:03.91,0:11:06.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Apa ini pembicaraan yang serius?{\i0}
Dialogue: 0,0:11:06.99,0:11:09.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Curhat? Bagaimana ini?{\i0}
Dialogue: 0,0:11:09.08,0:11:11.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sebenarnya, soal Yota…{\i0}
Dialogue: 0,0:11:11.46,0:11:14.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kalau seperti itu,\N‎berapa banyak yang harus kuceritakan?{\i0}
Dialogue: 0,0:11:17.17,0:11:18.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yota?
Dialogue: 0,0:11:18.88,0:11:21.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mau makan dulu sebelum pulang?
Dialogue: 0,0:11:24.51,0:11:27.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Oke. Aku akan mendengarkanmu soal apa pun.
Dialogue: 0,0:11:28.93,0:11:31.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak, maksudku bukan begitu.
Dialogue: 0,0:11:36.23,0:11:37.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ini bagian yang paling enak.
Dialogue: 0,0:11:37.78,0:11:38.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Miki.
Dialogue: 0,0:11:39.65,0:11:43.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Begini, ada yang ingin kuberi tahu padamu.
Dialogue: 0,0:11:45.95,0:11:47.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku…
Dialogue: 0,0:11:47.79,0:11:49.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Amamiya…\N‎- Sudah lama tak begini, ya?
Dialogue: 0,0:11:50.54,0:11:53.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yota, kau selalu menolak kalau kuajak.
Dialogue: 0,0:11:54.29,0:11:55.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu tak benar.
Dialogue: 0,0:11:56.54,0:11:58.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Eh? Yang di sebelah itu…
Dialogue: 0,0:11:58.84,0:12:00.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya, sudah jelas sekali.
Dialogue: 0,0:12:00.92,0:12:03.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Eh? Ya sudah.
Dialogue: 0,0:12:04.14,0:12:05.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎- Yota!\N‎- Amamiya!{\i0}
Dialogue: 0,0:12:05.30,0:12:07.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei, Minato.
Dialogue: 0,0:12:07.72,0:12:08.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa?
Dialogue: 0,0:12:09.39,0:12:11.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau berpacaran dengan Kurita?
Dialogue: 0,0:12:16.23,0:12:17.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Minato.
Dialogue: 0,0:12:19.32,0:12:21.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau berpacaran dengan Kurita?
Dialogue: 0,0:12:22.32,0:12:23.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kurita?{\i0}
Dialogue: 0,0:12:23.61,0:12:25.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Siapa itu?{\i0}
Dialogue: 0,0:12:25.78,0:12:26.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maksudmu Kuriki?
Dialogue: 0,0:12:27.66,0:12:30.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Eh? Ya, anak kelas satu itu.
Dialogue: 0,0:12:31.45,0:12:34.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kenapa kau menanyakan itu?
Dialogue: 0,0:12:34.12,0:12:36.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kalian mau ke konser berdua, 'kan?
Dialogue: 0,0:12:37.17,0:12:38.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu cuma konser.
Dialogue: 0,0:12:39.42,0:12:41.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku juga mau mengajak yang lainnya.
Dialogue: 0,0:12:41.80,0:12:42.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau mau ikut juga?
Dialogue: 0,0:12:43.76,0:12:47.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dengar, Minato, sejak SMP,
Dialogue: 0,0:12:47.43,0:12:49.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎kau selalu terlalu ramah pada gadis-gadis.
Dialogue: 0,0:12:49.81,0:12:51.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mereka jadi berharap lebih padamu.
Dialogue: 0,0:12:52.39,0:12:55.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa tak masalah mendengarkan ini?
Dialogue: 0,0:12:55.19,0:12:57.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi kita tak bisa keluar sekarang.
Dialogue: 0,0:12:57.81,0:13:01.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sudah berapa kali kau berpacaran\N‎dan putus gara-gara itu?
Dialogue: 0,0:13:03.57,0:13:08.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kupikir tumben Yota mau curhat\N‎tentang masalahnya padaku,{\i0}
Dialogue: 0,0:13:08.12,0:13:11.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎tapi dia malah menyalahkanku\N‎seperti yang dilakukan Miki.{\i0}
Dialogue: 0,0:13:11.74,0:13:17.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jadi, maksudmu, aku harus menolak\N‎semua yang tak benar-benar kusukai?
Dialogue: 0,0:13:18.58,0:13:22.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa menolak orang yang tidak kita benci\N‎adalah jawaban yang benar?
Dialogue: 0,0:13:22.96,0:13:26.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak bilang sampai sejauh itu,
Dialogue: 0,0:13:26.13,0:13:28.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎tapi jangan membuat orang salah paham.
Dialogue: 0,0:13:29.68,0:13:33.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apakah karena kau benci\N‎diperlakukan seperti itu?
Dialogue: 0,0:13:33.27,0:13:34.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ini tak ada hubungannya dengan Miki!
Dialogue: 0,0:13:41.11,0:13:42.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf.
Dialogue: 0,0:13:42.19,0:13:43.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku juga minta maaf.
Dialogue: 0,0:13:44.11,0:13:45.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Ucapanku pasti menohok.{\i0}
Dialogue: 0,0:13:47.15,0:13:48.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Yota…{\i0}
Dialogue: 0,0:13:48.53,0:13:51.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Astaga, padahal aku belum cerita ke Koyun.{\i0}
Dialogue: 0,0:13:52.28,0:13:54.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Omong-omong, Minato, kau tahu sejauh mana?
Dialogue: 0,0:13:55.33,0:13:57.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf, hampir semuanya.
Dialogue: 0,0:13:59.58,0:14:01.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf sudah membuatmu serbasalah.
Dialogue: 0,0:14:01.96,0:14:03.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak, jangan dipikirkan.
Dialogue: 0,0:14:04.46,0:14:05.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Minato.
Dialogue: 0,0:14:07.42,0:14:08.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa kau pernah jatuh cinta?
Dialogue: 0,0:14:09.80,0:14:11.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jatuh cinta?
Dialogue: 0,0:14:12.05,0:14:16.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya, seseorang yang tak bisa digantikan,\N‎rasanya hanya dia orangnya.
Dialogue: 0,0:14:17.81,0:14:18.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kalau itu…
Dialogue: 0,0:14:19.48,0:14:21.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bagiku semuanya seperti itu.
Dialogue: 0,0:14:23.44,0:14:25.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yota dan Miki,
Dialogue: 0,0:14:25.86,0:14:27.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎kalian teman yang tak tergantikan.
Dialogue: 0,0:14:28.65,0:14:29.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Lalu Koyun?
Dialogue: 0,0:14:32.78,0:14:34.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Koyun itu sangat baik, 'kan?
Dialogue: 0,0:14:36.04,0:14:39.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kita pernah main berempat.\N‎Kalian berdua dekat, 'kan?
Dialogue: 0,0:14:40.54,0:14:43.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa kau tak ada perasaan khusus padanya?
Dialogue: 0,0:14:44.67,0:14:45.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Koyun…
Dialogue: 0,0:14:48.01,0:14:49.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku menyukainya.
Dialogue: 0,0:14:50.51,0:14:51.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sebagai teman.
Dialogue: 0,0:14:53.14,0:14:54.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku benar-benar menyukainya.
Dialogue: 0,0:14:57.43,0:14:58.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Begitu, ya.
Dialogue: 0,0:14:59.44,0:15:02.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi suatu saat nanti,\N‎aku ingin melihat Minato jatuh cinta.
Dialogue: 0,0:15:05.19,0:15:06.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bagaimana, ya?
Dialogue: 0,0:15:07.44,0:15:09.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bagaimana cara memperlihatkannya?
Dialogue: 0,0:15:14.70,0:15:16.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku benci musim hujan, udaranya lembap.
Dialogue: 0,0:15:18.29,0:15:19.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Koyun.
Dialogue: 0,0:15:21.50,0:15:24.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Miki, maaf, sebenarnya,
Dialogue: 0,0:15:25.04,0:15:26.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎aku sudah telanjur menyukainya.
Dialogue: 0,0:15:27.63,0:15:29.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yota…
Dialogue: 0,0:15:29.01,0:15:30.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku suka Amamiya.
Dialogue: 0,0:15:33.01,0:15:36.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Eh? Tunggu dulu.
Dialogue: 0,0:15:36.26,0:15:38.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Maaf, aku tak bilang dari awal.
Dialogue: 0,0:15:39.14,0:15:41.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Aku sendiri tak yakin dengan perasaanku.
Dialogue: 0,0:15:42.19,0:15:44.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Aku bahkan belum memikirkan\N‎aku ingin bagaimana nantinya,
Dialogue: 0,0:15:44.90,0:15:45.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎jadi tak bisa cerita.
Dialogue: 0,0:15:47.07,0:15:48.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tunggu, mustahil.{\i0}
Dialogue: 0,0:15:48.28,0:15:51.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Eh? Jadi, aku selama ini…{\i0}
Dialogue: 0,0:15:51.28,0:15:53.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan mendekati Koyun\N‎karena alasan seperti itu.
Dialogue: 0,0:15:54.45,0:15:57.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku sangat setuju.{\i0}
Dialogue: 0,0:15:58.41,0:16:01.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Gawat, mustahil.\N‎Gawat, buruk sekali, sangat gawat!{\i0}
Dialogue: 0,0:16:02.54,0:16:03.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku mau muntah.
Dialogue: 0,0:16:06.09,0:16:07.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Miki…
Dialogue: 0,0:16:08.09,0:16:11.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku benar-benar belum memikirkan\N‎aku ingin bagaimana.
Dialogue: 0,0:16:11.51,0:16:14.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Barusan pun sudah jelas\N‎dia bilang aku cuma teman.
Dialogue: 0,0:16:15.34,0:16:19.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bukan! Maksudku mau muntah itu\N‎karena diriku sendiri.
Dialogue: 0,0:16:20.14,0:16:21.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku selama ini
Dialogue: 0,0:16:22.06,0:16:23.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎selalu berpikir seperti ini!{\i0}
Dialogue: 0,0:16:25.23,0:16:26.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tapi aku…{\i0}
Dialogue: 0,0:16:27.11,0:16:30.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi waktu itu aku… Begini dan begitu…
Dialogue: 0,0:16:30.11,0:16:33.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Eh, tapi aku…
Dialogue: 0,0:16:36.07,0:16:40.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kalau begitu, selama ini\N‎aku menjadi penghalang cinta Yota?
Dialogue: 0,0:16:40.83,0:16:42.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak ada hubungannya!
Dialogue: 0,0:16:42.79,0:16:46.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bagaimanapun juga,\N‎bagiku Yota hanyalah teman.
Dialogue: 0,0:16:47.21,0:16:48.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Miki.{\i0}
Dialogue: 0,0:16:48.38,0:16:53.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Kau ingat pernah bilang\N‎percintaan itu seperti pelengkap manis?
Dialogue: 0,0:16:53.97,0:16:56.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Apa tidak bisa jika orang itu Yota?
Dialogue: 0,0:16:58.39,0:16:59.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Misalnya,
Dialogue: 0,0:17:00.14,0:17:05.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎jika aku menyatakan perasaan padamu\N‎dan menyukaimu secara romantis selama ini,
Dialogue: 0,0:17:05.10,0:17:09.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎apa perasaanmu bisa langsung berubah\N‎dan bilang, "Aku juga menyukaimu"?
Dialogue: 0,0:17:10.32,0:17:11.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu…
Dialogue: 0,0:17:11.98,0:17:15.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kurasa itu tak bisa dilakukan semudah itu.
Dialogue: 0,0:17:16.28,0:17:19.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Saat dia menyatakan perasaan,\N‎rasanya lebih menyakitkan daripada senang.
Dialogue: 0,0:17:19.78,0:17:22.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi ada sisi lain diriku yang berpikir
Dialogue: 0,0:17:22.08,0:17:25.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎betapa mudahnya jika aku bisa\N‎menyukai orang yang menyukaiku.
Dialogue: 0,0:17:26.17,0:17:29.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kupikir aku akan menyakitinya\N‎jika berpacaran dengan setengah hati,
Dialogue: 0,0:17:29.54,0:17:30.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎makanya kutolak.
Dialogue: 0,0:17:30.63,0:17:33.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi akhirnya, sekarang dia tetap terluka.
Dialogue: 0,0:17:33.96,0:17:36.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa yang sebaiknya kulakukan?
Dialogue: 0,0:17:38.34,0:17:39.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Miki, begini.
Dialogue: 0,0:17:40.35,0:17:42.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Perasaan Yota padamu itu
Dialogue: 0,0:17:43.93,0:17:45.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎bukanlah nafsu berahi.
Dialogue: 0,0:17:47.02,0:17:52.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia ingin bersamamu bukan demi tubuhmu\N‎atau bercinta denganmu.
Dialogue: 0,0:17:52.32,0:17:53.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Koyun!
Dialogue: 0,0:17:53.40,0:17:56.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yota juga menyukaimu sebagai teman.
Dialogue: 0,0:17:57.99,0:18:01.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dia benar-benar melihat dirimu apa adanya.{\i0}
Dialogue: 0,0:18:02.12,0:18:07.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dia selama ini hanya memikirkan\N‎cara membuatmu bahagia.{\i0}
Dialogue: 0,0:18:07.75,0:18:10.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia tak pernah berpikir\N‎untuk dibahagiakan olehmu.
Dialogue: 0,0:18:11.04,0:18:12.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia orang yang seperti itu.
Dialogue: 0,0:18:13.17,0:18:14.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Makanya,
Dialogue: 0,0:18:15.01,0:18:18.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎jangan menyalahkan dirimu\N‎atas masalah Yota.
Dialogue: 0,0:18:20.09,0:18:23.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Bagiku, kau adalah Miki.
Dialogue: 0,0:18:28.98,0:18:30.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku, hari ini…
Dialogue: 0,0:18:31.61,0:18:34.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Saat Yota datang mendekati kursiku,
Dialogue: 0,0:18:35.11,0:18:36.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎aku memalingkan mukaku.
Dialogue: 0,0:18:39.07,0:18:41.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mulai besok, aku akan bersikap biasa…
Dialogue: 0,0:18:43.20,0:18:44.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya.
Dialogue: 0,0:18:52.84,0:18:55.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Lalu, bagaimana denganmu?
Dialogue: 0,0:18:55.05,0:18:56.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Eh? Apa maksudmu?
Dialogue: 0,0:18:56.63,0:18:59.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau mau menyatakan perasaan ke Minato?
Dialogue: 0,0:18:59.34,0:19:01.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak! Tidak akan!
Dialogue: 0,0:19:02.39,0:19:07.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kalau dari sisiku, ini pertama kalinya\N‎kau mau cerita hal begini padaku,
Dialogue: 0,0:19:07.52,0:19:09.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎jadi aku sangat ingin mendukungmu.
Dialogue: 0,0:19:10.98,0:19:12.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima kasih.
Dialogue: 0,0:19:12.40,0:19:15.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi sekarang aku tahu\N‎dia cuma menganggapku teman.
Dialogue: 0,0:19:16.02,0:19:18.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Selagi bisa kutarik,\N‎aku ingin merelakan perasaanku.
Dialogue: 0,0:19:19.32,0:19:22.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Lagi pula, Amamiya lebih menyenangkan\N‎kalau cuma berteman, 'kan?
Dialogue: 0,0:19:23.49,0:19:27.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Rintangannya terlalu tinggi\N‎bagi pemula dalam percintaan sepertiku.
Dialogue: 0,0:19:32.37,0:19:34.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ayo kita semua main lagi sebagai teman.
Dialogue: 0,0:19:35.92,0:19:36.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya.
Dialogue: 0,0:19:42.09,0:19:46.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Apa menolak orang yang tidak kita benci\N‎adalah jawaban yang benar?{\i0}
Dialogue: 0,0:19:46.72,0:19:51.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kebaikan dan keramahan Amamiya\N‎kepada semua orang{\i0}
Dialogue: 0,0:19:51.02,0:19:52.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎adalah hal yang wajar.{\i0}
Dialogue: 0,0:19:52.73,0:19:55.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kukira dia begitu hanya padaku{\i0}
Dialogue: 0,0:19:55.65,0:19:57.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎dan aku merasa senang sendiri.{\i0}
Dialogue: 0,0:19:57.40,0:19:58.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Rasanya…{\i0}
Dialogue: 0,0:19:59.94,0:20:02.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku bodoh sekali.{\i0}
Dialogue: 0,0:20:19.92,0:20:20.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tak apa.{\i0}
Dialogue: 0,0:20:27.18,0:20:30.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Ini masih tak apa.{\i0}
Dialogue: 0,0:20:33.10,0:20:34.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Pasti bisa dilupakan.{\i0}
Dialogue: 0,0:20:35.35,0:20:38.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku juga tak pernah berpikir\N‎ingin menjadi pacarnya.{\i0}
Dialogue: 0,0:20:39.61,0:20:43.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Lagi pula, aku sudah bersikap begitu\N‎saat kami baru kenal.{\i0}
Dialogue: 0,0:20:44.53,0:20:47.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Sebagai teman.\N‎Aku benar-benar menyukainya.
Dialogue: 0,0:20:48.74,0:20:52.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Mendengar ucapan seperti itu saja\N‎sudah cukup bagiku.{\i0}
Dialogue: 0,0:20:53.71,0:20:58.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Bahkan, mungkin aku harus meragukan\N‎perasaanku padanya ini.{\i0}
Dialogue: 0,0:20:59.42,0:21:02.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku yang biasanya menolak orang.{\i0}
Dialogue: 0,0:21:02.09,0:21:03.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Jadi, aku…{\i0}
Dialogue: 0,0:21:04.63,0:21:06.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku pasti hanya kesepian.{\i0}
Dialogue: 0,0:21:08.22,0:21:10.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kalau memang begitu,\N‎sekarang sudah tak apa.{\i0}
Dialogue: 0,0:21:11.52,0:21:14.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Jika sudah puas dengan kondisi saat ini,\N‎aku tak akan kesepian.{\i0}
Dialogue: 0,0:21:16.35,0:21:17.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Perasaanku ini{\i0}
Dialogue: 0,0:21:19.11,0:21:20.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎bisa dikembalikan ke awal lagi.{\i0}
Dialogue: 0,0:21:22.57,0:21:23.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Selamat pagi.
Dialogue: 0,0:21:25.57,0:21:26.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Selamat pagi.
Dialogue: 0,0:21:27.86,0:21:30.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Eh? Miki, kau datang cepat hari ini.
Dialogue: 0,0:21:32.12,0:21:33.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Minato! Selamat pagi!
Dialogue: 0,0:21:35.12,0:21:36.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Koyun, selamat pagi!
Dialogue: 0,0:21:36.21,0:21:37.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Selamat pagi.
Dialogue: 0,0:21:41.38,0:21:42.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yota, selamat pagi!
Dialogue: 0,0:21:47.88,0:21:49.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Semangat sekali. Selamat pagi.
Dialogue: 0,0:23:39.29,0:23:40.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kalau begini terus,{\i0}
Dialogue: 0,0:23:40.91,0:23:42.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎perasaanku ini{\i0}
Dialogue: 0,0:23:43.75,0:23:46.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎hanya akan jadi lelucon yang kejam.{\i0}
Dialogue: 0,0:23:48.09,0:23:51.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Nantinya, apakah dia bisa menyukaiku juga?{\i0}
Dialogue: 0,0:23:53.26,0:23:54.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Apakah itu mungkin?{\i0}
Dialogue: 0,0:23:54.72,0:23:56.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terjemahan subtitle oleh Shoffanny R
