Dialogue: 0,0:16:50.25,0:16:51.26,sign,,0000,0000,0000,,‎DEG DEG
Dialogue: 0,0:17:32.42,0:17:33.42,sign,,0000,0000,0000,,{\an8}‎SERVIS MIKI
Dialogue: 0,0:17:56.40,0:17:57.49,sign,,0000,0000,0000,,‎YOTA
Dialogue: 0,0:18:00.91,0:18:02.03,sign,,0000,0000,0000,,‎DEBUK
Dialogue: 0,0:18:25.56,0:18:26.77,sign,,0000,0000,0000,,‎PASANGAN ALADDIN!!
Dialogue: 0,0:18:42.45,0:18:43.53,sign,,0000,0000,0000,,{\an8}‎SULIT BEREAKSI
Dialogue: 0,0:18:48.29,0:18:49.46,sign,,0000,0000,0000,,‎EH
Dialogue: 0,0:18:51.75,0:18:52.92,sign,,0000,0000,0000,,‎MENDEKAT
Dialogue: 0,0:19:06.56,0:19:08.48,sign,,0000,0000,0000,,‎DEG!!
Dialogue: 0,0:19:24.07,0:19:27.49,sign,,0000,0000,0000,,‎TATAP...
Dialogue: 0,0:19:45.85,0:19:47.10,sign,,0000,0000,0000,,{\an8}‎GYOSHO CINA PEDAS
Dialogue: 0,0:19:58.19,0:19:59.44,sign,,0000,0000,0000,,‎MAKAN BERSAMA\N‎NYAM NYAM
Dialogue: 0,0:20:05.95,0:20:07.49,sign,,0000,0000,0000,,‎AKU PASTI BAHAGIA, 'KAN?\N‎AKU MENYUKAIMU - KAMI PUTUS
Dialogue: 0,0:20:15.25,0:20:16.25,sign,,0000,0000,0000,,‎AKU BENAR-BENAR BODOH...
Dialogue: 0,0:20:35.23,0:20:36.31,sign,,0000,0000,0000,,‎YA~
Dialogue: 0,0:20:58.67,0:20:59.75,sign,,0000,0000,0000,,‎MELEDAK!!\N‎FESTIVAL GYOZA
Dialogue: 0,0:21:15.48,0:21:16.69,sign,,0000,0000,0000,,‎NYAM NYAM NYAM
Dialogue: 0,0:22:16.37,0:22:18.16,sign,,0000,0000,0000,,{\an8}‎SANTAI
Dialogue: 0,0:00:12.88,0:00:16.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku sudah menyadari perasaanku sendiri.{\i0}
Dialogue: 0,0:00:16.80,0:00:20.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tapi bagaimana aku bisa\N‎menghadapinya sekarang?{\i0}
Dialogue: 0,0:00:20.18,0:00:22.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Eh? Bagaimana ini? Aku harus apa?{\i0}
Dialogue: 0,0:00:22.77,0:00:25.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Apa coba konsultasi?{\i0}
Dialogue: 0,0:00:26.44,0:00:32.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tidak, kalau ternyata aku keliru,\N‎ini bukan hal yang lucu!{\i0}
Dialogue: 0,0:00:37.62,0:00:39.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Akan kutunggu sedikit lebih lama.{\i0}
Dialogue: 0,0:00:41.91,0:00:44.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Untuk memastikan perasaanku ini.{\i0}
Dialogue: 0,0:00:45.62,0:00:47.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Benarkah?\N‎- Wah!
Dialogue: 0,0:00:51.09,0:00:52.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tunggu...{\i0}
Dialogue: 0,0:00:52.67,0:00:53.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tidak mungkin!{\i0}
Dialogue: 0,0:00:58.55,0:01:01.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tunggu dulu. Bagaimana ini?{\i0}
Dialogue: 0,0:01:02.31,0:01:04.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Semua yang kulihat cuma kebaikannya!{\i0}
Dialogue: 0,0:01:06.52,0:01:08.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kenapa baru sekarang?{\i0}
Dialogue: 0,0:01:13.86,0:01:15.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎"Aku bisa melupakannya sekarang.{\i0}
Dialogue: 0,0:01:15.95,0:01:17.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kami bisa berteman saja."{\i0}
Dialogue: 0,0:01:18.49,0:01:20.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kupikir begitu.{\i0}
Dialogue: 0,0:01:20.99,0:01:24.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Padahal akhirnya\N‎kami bisa mengobrol seperti biasa,{\i0}
Dialogue: 0,0:01:26.08,0:01:28.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎tapi begitu kudengar mereka putus...{\i0}
Dialogue: 0,0:01:29.33,0:01:32.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Begitu kupastikan perasaanku ini...{\i0}
Dialogue: 0,0:01:33.21,0:01:34.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Jadi kepikiran terus.{\i0}
Dialogue: 0,0:01:35.17,0:01:36.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Jadi kepikiran terus.{\i0}
Dialogue: 0,0:01:36.76,0:01:38.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tak bisa kuhentikan!{\i0}
Dialogue: 0,0:03:23.11,0:03:24.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sampai jumpa.
Dialogue: 0,0:03:25.53,0:03:27.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mau makan dulu sebelum pulang?
Dialogue: 0,0:03:27.99,0:03:29.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Minato, mau ikut?
Dialogue: 0,0:03:32.25,0:03:33.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak ikut.
Dialogue: 0,0:03:35.54,0:03:38.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Padahal biasanya\N‎aku suka bersama orang lain,{\i0}
Dialogue: 0,0:03:39.51,0:03:41.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎tapi sekarang,\N‎aku tak mau bersama siapa pun.{\i0}
Dialogue: 0,0:03:42.76,0:03:44.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku sedang tak mau membaca situasi{\i0}
Dialogue: 0,0:03:44.97,0:03:49.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎atau memikirkan\N‎cara menanggapi orang lain.{\i0}
Dialogue: 0,0:03:50.02,0:03:52.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Semuanya terasa merepotkan.{\i0}
Dialogue: 0,0:03:55.19,0:03:57.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku tak mau peduli pandangan orang lain.{\i0}
Dialogue: 0,0:03:58.78,0:04:04.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Karena terlalu peduli pandangan orang,\N‎aku jadi kehilangan pendirianku.{\i0}
Dialogue: 0,0:04:05.28,0:04:08.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Karena tak punya pendirian,\N‎aku jadi tak percaya diri.{\i0}
Dialogue: 0,0:04:09.79,0:04:12.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tapi aku tak menyadarinya selama ini.{\i0}
Dialogue: 0,0:04:14.96,0:04:15.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sebenarnya,{\i0}
Dialogue: 0,0:04:16.54,0:04:19.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎aku cuma orang yang takut kesepian.{\i0}
Dialogue: 0,0:04:20.59,0:04:25.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tapi sekarang,\N‎rasanya menyiksa saat di dekat orang.{\i0}
Dialogue: 0,0:04:26.64,0:04:28.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku tak tahu mana yang benar.{\i0}
Dialogue: 0,0:04:29.72,0:04:36.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Karena tak tahu, aku jadi terbiasa\N‎memikirkan pandangan orang lain.{\i0}
Dialogue: 0,0:04:37.15,0:04:39.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku malah lelah sendiri\N‎dengan kebiasaan itu.{\i0}
Dialogue: 0,0:04:40.73,0:04:42.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau cuma tak membenci siapa pun.
Dialogue: 0,0:04:44.11,0:04:45.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Bukan.{\i0}
Dialogue: 0,0:04:45.91,0:04:47.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sekarang ini,{\i0}
Dialogue: 0,0:04:48.12,0:04:49.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎aku benci diriku sendiri.{\i0}
Dialogue: 0,0:04:51.79,0:04:53.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku tak mau tahu.{\i0}
Dialogue: 0,0:04:53.75,0:04:55.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku tak mau menyadarinya.{\i0}
Dialogue: 0,0:04:56.21,0:04:59.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku cuma ingin berpura-pura\N‎kalau semuanya baik-baik saja.{\i0}
Dialogue: 0,0:05:00.50,0:05:05.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tapi apakah ini akibatnya\N‎berpura-pura tak tahu selama ini?{\i0}
Dialogue: 0,0:05:06.30,0:05:09.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Aku tahu memang tak mungkin\N‎membuat semua orang senang,
Dialogue: 0,0:05:09.80,0:05:12.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎tapi sebagian orang terselamatkan olehmu.
Dialogue: 0,0:05:13.68,0:05:15.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku tak sebaik itu.{\i0}
Dialogue: 0,0:05:15.98,0:05:18.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kebaikanku bukan seperti pahlawan.{\i0}
Dialogue: 0,0:05:19.44,0:05:22.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku tak bisa membiarkan orang sendirian{\i0}
Dialogue: 0,0:05:22.90,0:05:25.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎karena aku tak mau mengalaminya juga.{\i0}
Dialogue: 0,0:05:26.15,0:05:28.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku berpura-pura\N‎menyelamatkan mereka dari kesepian,{\i0}
Dialogue: 0,0:05:28.66,0:05:31.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎dan setiap kali\N‎ada yang membuka hatinya padaku,{\i0}
Dialogue: 0,0:05:31.37,0:05:33.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎aku merasa seolah terampuni.{\i0}
Dialogue: 0,0:05:34.00,0:05:35.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Mereka membutuhkanku.{\i0}
Dialogue: 0,0:05:35.79,0:05:38.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku merasa keberadaanku berarti.{\i0}
Dialogue: 0,0:05:39.21,0:05:42.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Lama-lama tujuannya pun bergeser.{\i0}
Dialogue: 0,0:05:44.51,0:05:46.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Saat mereka membuka hati,{\i0}
Dialogue: 0,0:05:47.01,0:05:49.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎aku mengonfirmasi keberadaan diriku.{\i0}
Dialogue: 0,0:05:49.55,0:05:52.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Minato, kau benar-benar\N‎tak punya jati diri.{\i0}
Dialogue: 0,0:05:52.56,0:05:54.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kau tak pernah menyukaiku, 'kan?{\i0}
Dialogue: 0,0:05:54.85,0:05:58.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Selama ini, aku tak pernah\N‎menghadapinya dengan serius.{\i0}
Dialogue: 0,0:05:59.31,0:06:02.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku mendengar ucapan orang-orang,\N‎tapi tak benar-benar menyimak.{\i0}
Dialogue: 0,0:06:04.07,0:06:07.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sejak menyadari\N‎manusia seperti apa diriku ini,{\i0}
Dialogue: 0,0:06:08.11,0:06:12.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎segala tindakanku selama ini\N‎terasa sangat memalukan.{\i0}
Dialogue: 0,0:06:13.79,0:06:15.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Semua terasa tak ada artinya.{\i0}
Dialogue: 0,0:06:17.29,0:06:19.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tidak ada yang menyakitiku juga.{\i0}
Dialogue: 0,0:06:20.67,0:06:23.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku bahkan tak bisa berpura-pura\N‎menjadi korban.{\i0}
Dialogue: 0,0:06:23.54,0:06:24.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Meski begitu,{\i0}
Dialogue: 0,0:06:25.51,0:06:26.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎aku merasa sengsara,{\i0}
Dialogue: 0,0:06:27.13,0:06:28.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎dadaku terasa sesak,{\i0}
Dialogue: 0,0:06:29.43,0:06:30.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎dan aku gelisah.{\i0}
Dialogue: 0,0:06:31.55,0:06:33.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Rasanya mau hancur.{\i0}
Dialogue: 0,0:06:34.22,0:06:35.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kenapa?{\i0}
Dialogue: 0,0:06:37.02,0:06:38.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Amamiya.
Dialogue: 0,0:06:39.85,0:06:40.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Eh?{\i0}
Dialogue: 0,0:06:41.52,0:06:43.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Syukurlah aku bisa menyusulmu.
Dialogue: 0,0:06:45.86,0:06:46.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kenapa?{\i0}
Dialogue: 0,0:06:47.61,0:06:50.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tadi di perpustakaan\N‎sampai lupa waktu.
Dialogue: 0,0:06:51.53,0:06:55.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sebenarnya, aku berharap\N‎kami pulang di waktu yang sama.{\i0}
Dialogue: 0,0:06:56.45,0:06:58.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Eh, bagaimana ini?{\i0}
Dialogue: 0,0:06:59.83,0:07:02.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Mungkin bicara dengan orang lain\N‎saat ini bisa bahaya.{\i0}
Dialogue: 0,0:07:03.71,0:07:05.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku tak bisa ganti ekspresi.{\i0}
Dialogue: 0,0:07:06.21,0:07:07.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Eh?{\i0}
Dialogue: 0,0:07:07.88,0:07:11.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Di saat seperti ini,\N‎biasanya ekspresiku seperti apa?{\i0}
Dialogue: 0,0:07:14.10,0:07:15.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Amamiya.
Dialogue: 0,0:07:17.43,0:07:19.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Selamat ulang tahun.
Dialogue: 0,0:07:24.98,0:07:30.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Ini memang sehari lebih awal,\N‎tapi karena besok hari Sabtu,
Dialogue: 0,0:07:31.24,0:07:33.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎dan aku mau balas kebaikanmu...
Dialogue: 0,0:07:39.75,0:07:41.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Wah, tunggu!
Dialogue: 0,0:07:41.21,0:07:44.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sebentar, kenapa? Buruk sekali...
Dialogue: 0,0:07:45.50,0:07:48.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bukan hadiahmu yang buruk.\N‎Maksudku diriku sendiri.
Dialogue: 0,0:07:49.42,0:07:50.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Maaf.
Dialogue: 0,0:07:50.97,0:07:51.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima kasih.
Dialogue: 0,0:07:54.30,0:07:55.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Amamiya?
Dialogue: 0,0:07:56.10,0:07:57.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Kau tak apa...\N‎- Coba dengar!
Dialogue: 0,0:07:57.72,0:08:00.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku dapat ucapan "selamat pagi"\N‎dan "selamat malam" setiap hari.
Dialogue: 0,0:08:04.98,0:08:06.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Amamiya!
Dialogue: 0,0:08:15.66,0:08:20.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Bagi Amamiya, apa arti diriku saat ini?{\i0}
Dialogue: 0,0:08:22.37,0:08:25.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kalau dulu kami pernah saling menyukai...{\i0}
Dialogue: 0,0:08:25.63,0:08:29.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Mau main saat liburan musim panas?
Dialogue: 0,0:08:32.13,0:08:36.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Pasti akulah yang menghancurkan\N‎kesempatan kami.{\i0}
Dialogue: 0,0:08:36.09,0:08:37.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Ya.
Dialogue: 0,0:08:37.18,0:08:38.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Boleh.
Dialogue: 0,0:08:38.72,0:08:39.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sepertinya seru.
Dialogue: 0,0:08:41.89,0:08:44.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ayo kita semua pergi main lagi.
Dialogue: 0,0:08:45.23,0:08:50.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau berusaha terlalu keras\N‎sampai dia benar-benar tak tahu.
Dialogue: 0,0:08:51.11,0:08:56.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}‎Kalau sekarang\N‎dia cuma menganggapku teman,{\i0}
Dialogue: 0,0:08:57.41,0:08:58.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎meski begitu...{\i0}
Dialogue: 0,0:09:05.58,0:09:09.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kali ini, aku ingin mendekatinya duluan.{\i0}
Dialogue: 0,0:09:10.25,0:09:11.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Koyun?
Dialogue: 0,0:09:27.81,0:09:30.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ukurannya besar sekali.
Dialogue: 0,0:09:30.40,0:09:33.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kupikir lebih baik sesuatu\N‎yang bisa dimakan.
Dialogue: 0,0:09:33.99,0:09:36.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau juga memberiku hadiah dari arkade,
Dialogue: 0,0:09:37.74,0:09:40.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎jadi kupikir hadiah sejenis pasti cocok.
Dialogue: 0,0:09:41.28,0:09:42.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Hadiah arkade?
Dialogue: 0,0:09:42.95,0:09:45.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Koyun, kau jago bermain mesin capit, ya?
Dialogue: 0,0:09:46.29,0:09:48.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Tidak kusangka.\N‎- Tidak juga.
Dialogue: 0,0:09:48.33,0:09:50.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ini hadiah arkade pertama\N‎yang berhasil kudapatkan.
Dialogue: 0,0:09:51.50,0:09:54.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Berapa banyak uang yang kau habiskan?
Dialogue: 0,0:09:55.30,0:09:58.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei, tunggu. Kenapa reaksimu begitu?
Dialogue: 0,0:09:58.76,0:10:00.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak, cuma...
Dialogue: 0,0:10:01.30,0:10:02.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mungkin 100 yen?
Dialogue: 0,0:10:03.31,0:10:04.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Sudah pasti bohong.
Dialogue: 0,0:10:05.35,0:10:08.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Padahal tak perlu sampai begini\N‎demi orang sepertiku.
Dialogue: 0,0:10:10.48,0:10:11.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima kasih.
Dialogue: 0,0:10:13.11,0:10:14.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Selain itu,
Dialogue: 0,0:10:15.32,0:10:17.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎tolong lupakan kejadian tadi.
Dialogue: 0,0:10:20.28,0:10:21.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Amamiya.
Dialogue: 0,0:10:23.12,0:10:26.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku cuma ingin mengobrol denganmu.
Dialogue: 0,0:10:29.29,0:10:31.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Karena belakangan ini kau tak bersemangat.
Dialogue: 0,0:10:33.13,0:10:36.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Saat sedang sedih,\N‎rasanya tidak ingin di dekat orang.{\i0}
Dialogue: 0,0:10:36.13,0:10:37.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tidak ingin bicara ke siapa pun.{\i0}
Dialogue: 0,0:10:38.72,0:10:42.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku sangat paham perasaan seperti itu.{\i0}
Dialogue: 0,0:10:42.85,0:10:43.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tapi...{\i0}
Dialogue: 0,0:10:44.64,0:10:48.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kalau memikirkan masalah sendirian\N‎saat hati sedang lelah,
Dialogue: 0,0:10:48.85,0:10:52.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎semua perasaan itu\N‎akan makin terseret masuk.{\i0}
Dialogue: 0,0:10:53.31,0:10:56.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Memikirkan hal yang tak ada solusinya\N‎dan menjadi negatif.{\i0}
Dialogue: 0,0:10:57.28,0:10:58.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Berputar di situ saja.{\i0}
Dialogue: 0,0:10:59.07,0:11:02.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Lama-kelamaan, bagian dalam hatimu...
Dialogue: 0,0:11:03.78,0:11:07.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎- Menjadi ruang pengap tanpa ventilasi.\N{\i1}‎- Sut, sut.{\i0}
Dialogue: 0,0:11:07.20,0:11:09.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎- Ruang pengap tanpa ventilasi?\N{\i1}‎- Sut, sut.{\i0}
Dialogue: 0,0:11:09.33,0:11:10.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya.
Dialogue: 0,0:11:11.33,0:11:16.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Makanya aku tak mau memaksamu\N‎menceritakan masalahmu.
Dialogue: 0,0:11:16.96,0:11:20.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jadi, aku...
Dialogue: 0,0:11:21.22,0:11:23.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Padahal aku ingin menyemangatinya.{\i0}
Dialogue: 0,0:11:23.22,0:11:25.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku ingin menghiburnya.{\i0}
Dialogue: 0,0:11:25.18,0:11:26.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tapi tak bisa kuutarakan.{\i0}
Dialogue: 0,0:11:27.97,0:11:30.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku tak menemukan kata-kata yang tepat.{\i0}
Dialogue: 0,0:11:32.85,0:11:35.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Koyun, terima kasih.
Dialogue: 0,0:11:36.07,0:11:37.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Niatmu tersampaikan, kok.
Dialogue: 0,0:11:38.28,0:11:40.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Semua yang ingin kau katakan.
Dialogue: 0,0:11:40.90,0:11:42.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Begitu juga perhatianmu.{\i0}
Dialogue: 0,0:11:42.91,0:11:45.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dan kebaikan yang kau tunjukkan sekarang.{\i0}
Dialogue: 0,0:11:46.45,0:11:47.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Eh?{\i0}
Dialogue: 0,0:11:47.70,0:11:49.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kenapa ingin menangis lagi?{\i0}
Dialogue: 0,0:11:50.37,0:11:51.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Gawat...{\i0}
Dialogue: 0,0:11:52.79,0:11:54.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Ini boleh kumakan sekarang?
Dialogue: 0,0:11:54.58,0:11:56.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Ya, silakan.
Dialogue: 0,0:11:56.25,0:11:58.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Mau makan bersama?
Dialogue: 0,0:11:58.63,0:12:00.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Eh? Nanti bukan hadiah namanya.
Dialogue: 0,0:12:00.92,0:12:02.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Tak apa.
Dialogue: 0,0:12:12.81,0:12:14.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sebenarnya,
Dialogue: 0,0:12:14.06,0:12:17.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎aku tak berniat mencari teman\N‎saat masuk SMA.
Dialogue: 0,0:12:18.86,0:12:21.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Aku punya pengalaman buruk saat SMP,
Dialogue: 0,0:12:21.90,0:12:25.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎dan aku juga tak mau\N‎menyakiti siapa pun lagi.
Dialogue: 0,0:12:26.74,0:12:28.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak mau masa lalu terulang.
Dialogue: 0,0:12:30.04,0:12:32.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Saat berhadapan dengan orang lain,
Dialogue: 0,0:12:32.75,0:12:36.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎lebih mudah bagiku\N‎untuk memberi batasan ke dalam diriku
Dialogue: 0,0:12:36.79,0:12:38.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎daripada menghadapi mereka\N‎secara langsung.
Dialogue: 0,0:12:40.17,0:12:41.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}‎Karena tak ada kegagalan{\i0}
Dialogue: 0,0:12:42.51,0:12:44.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}‎dan aku merasa sudah mengintrospeksi diri.{\i0}
Dialogue: 0,0:12:45.43,0:12:48.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Cara itu lebih mudah\N‎daripada mulai melangkah maju.{\i0}
Dialogue: 0,0:12:50.56,0:12:55.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa yang dipikirkan, dirasakan,\N‎dan dianggap oleh diri sendiri,
Dialogue: 0,0:12:56.90,0:12:59.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎memahami semua itu memang penting.
Dialogue: 0,0:12:59.86,0:13:03.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Tapi kalau terus menyalahkan diri sendiri\N‎dan menutup diri,
Dialogue: 0,0:13:04.32,0:13:06.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎rasanya pasti akan tetap menyesakkan.
Dialogue: 0,0:13:08.03,0:13:11.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kalau kau pernah merasakan\N‎hal-hal seperti itu juga,
Dialogue: 0,0:13:12.62,0:13:14.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎ingatlah aku selalu di pihakmu.
Dialogue: 0,0:13:15.66,0:13:17.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Akan kubantu membuka ventilasinya.
Dialogue: 0,0:13:21.17,0:13:23.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jadi, kalau bisa,
Dialogue: 0,0:13:23.71,0:13:26.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎simpan di sudut ingatanmu saja\N‎sudah cukup.
Dialogue: 0,0:13:26.38,0:13:27.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sut, sut.{\i0}
Dialogue: 0,0:13:29.64,0:13:30.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Terima kasih.
Dialogue: 0,0:13:32.60,0:13:33.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku tak tahan lagi.{\i0}
Dialogue: 0,0:13:35.60,0:13:36.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kenapa?{\i0}
Dialogue: 0,0:13:37.39,0:13:38.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Hal begini...{\i0}
Dialogue: 0,0:13:42.44,0:13:43.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku pulang.
Dialogue: 0,0:13:44.65,0:13:45.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Anak pintar.
Dialogue: 0,0:13:46.57,0:13:48.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Amamiya.{\i0}
Dialogue: 0,0:13:48.24,0:13:49.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Hanya mendengar suaranya...{\i0}
Dialogue: 0,0:13:50.37,0:13:52.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Hanya melihat wajahnya...{\i0}
Dialogue: 0,0:13:52.87,0:13:55.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Emosiku langsung jadi kacau.{\i0}
Dialogue: 0,0:13:56.00,0:13:57.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku...{\i0}
Dialogue: 0,0:13:58.58,0:14:01.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku belum bisa melupakannya sama sekali.{\i0}
Dialogue: 0,0:14:03.63,0:14:04.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Benar-benar buruk.{\i0}
Dialogue: 0,0:14:05.97,0:14:08.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}‎Nanti harus bersikap bagaimana\N‎kalau bertemu di sekolah?{\i0}
Dialogue: 0,0:14:12.51,0:14:14.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Eh, notifikasinya tertekan...{\i0}
Dialogue: 0,0:14:15.31,0:14:16.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Selamat ulang tahun.{\i0}
Dialogue: 0,0:14:23.40,0:14:25.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Minato? Ada apa?
Dialogue: 0,0:14:29.66,0:14:33.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kalau hari ini bertemu dan kusapa,\N‎bagaimana reaksinya, ya?{\i0}
Dialogue: 0,0:14:34.62,0:14:38.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Apa aku sebaiknya bersikap\N‎seolah tak terjadi apa-apa?{\i0}
Dialogue: 0,0:14:40.08,0:14:41.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sulit sekali.{\i0}
Dialogue: 0,0:14:47.17,0:14:49.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Oh, selamat pa...
Dialogue: 0,0:14:58.02,0:14:59.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Gawat...
Dialogue: 0,0:15:00.94,0:15:03.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku malu sekali.
Dialogue: 0,0:15:08.40,0:15:09.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Jantungku!{\i0}
Dialogue: 0,0:15:11.49,0:15:14.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tolong lupakan kejadian kemarin.
Dialogue: 0,0:15:14.28,0:15:15.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Jantungku!{\i0}
Dialogue: 0,0:15:16.83,0:15:20.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apanya? Lupakan apa? Aku tak paham.
Dialogue: 0,0:15:20.21,0:15:22.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Hei! Kau jahat sekali!
Dialogue: 0,0:15:23.54,0:15:24.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf deh.
Dialogue: 0,0:15:24.63,0:15:28.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Astaga, jangan begitu...
Dialogue: 0,0:15:35.22,0:15:37.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sudah siap? Sekarang waktunya.
Dialogue: 0,0:15:37.14,0:15:40.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Selamat ulang tahun...
Dialogue: 0,0:15:46.23,0:15:47.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Amamiya menangis?
Dialogue: 0,0:15:47.48,0:15:50.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ternyata kau bisa menangis juga.
Dialogue: 0,0:15:50.24,0:15:52.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei, foto! Cepat foto!
Dialogue: 0,0:15:52.40,0:15:53.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kalian iblis, ya?
Dialogue: 0,0:15:56.20,0:15:59.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sut...{\i0}
Dialogue: 0,0:16:00.25,0:16:03.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sejak saat itu,\N‎aku sudah menyadari perasaanku.{\i0}
Dialogue: 0,0:16:04.79,0:16:07.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tapi bukan berarti aku ingin ada kemajuan.{\i0}
Dialogue: 0,0:16:08.05,0:16:10.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku bukan ingin hubungan yang lebih jauh.{\i0}
Dialogue: 0,0:16:10.30,0:16:11.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Daripada keinginan seperti itu,{\i0}
Dialogue: 0,0:16:12.72,0:16:13.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎aku hanya...{\i0}
Dialogue: 0,0:16:13.88,0:16:14.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Amamiya.
Dialogue: 0,0:16:19.68,0:16:20.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Selamat pagi.
Dialogue: 0,0:16:22.94,0:16:23.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Selamat pagi.
Dialogue: 0,0:16:24.77,0:16:26.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku hanya...{\i0}
Dialogue: 0,0:16:27.48,0:16:29.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau menonton film itu di TV semalam?
Dialogue: 0,0:16:31.36,0:16:32.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku merasa dia menggemaskan.{\i0}
Dialogue: 0,0:16:34.03,0:16:35.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yang dulu pernah kita bahas...
Dialogue: 0,0:16:38.16,0:16:39.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Bagaimana kabar Pon?
Dialogue: 0,0:16:41.83,0:16:44.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Bulunya pasti halus.
Dialogue: 0,0:16:45.33,0:16:46.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Imutnya.
Dialogue: 0,0:16:46.42,0:16:47.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Rasanya...{\i0}
Dialogue: 0,0:16:48.50,0:16:50.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Apa ini tak terlalu dekat?{\i0}
Dialogue: 0,0:16:54.84,0:16:57.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Eh, apa ini? Cuma perasaanku?{\i0}
Dialogue: 0,0:16:57.80,0:17:01.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}‎Apa karena terlalu kupikirkan,\N‎makanya kuartikan sesuai keinginanku?{\i0}
Dialogue: 0,0:17:06.40,0:17:07.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf, ya.
Dialogue: 0,0:17:13.74,0:17:14.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Semangat.
Dialogue: 0,0:17:20.62,0:17:21.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dia manis sekali.{\i0}
Dialogue: 0,0:17:22.75,0:17:23.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Eh, apa-apaan ini?{\i0}
Dialogue: 0,0:17:24.54,0:17:27.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Memang sejak kejadian itu,\N‎kami jadi lebih dekat...{\i0}
Dialogue: 0,0:17:34.59,0:17:36.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Bukan cuma Koyun yang berubah.{\i0}
Dialogue: 0,0:17:37.59,0:17:40.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Cara pandang dan perasaanku juga berubah.{\i0}
Dialogue: 0,0:17:41.76,0:17:44.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Daripada terus memikirkan\N‎pandangan orang lain,{\i0}
Dialogue: 0,0:17:45.35,0:17:48.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎aku jadi lebih berani\N‎menerima pemikiranku sendiri.{\i0}
Dialogue: 0,0:17:49.77,0:17:51.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Rasanya...{\i0}
Dialogue: 0,0:17:52.27,0:17:54.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei! Jangan biarkan Yota lepas!
Dialogue: 0,0:17:54.74,0:17:56.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yota!
Dialogue: 0,0:17:59.78,0:18:00.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Bagus.{\i0}
Dialogue: 0,0:18:02.03,0:18:03.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Minato! Maaf!
Dialogue: 0,0:18:11.13,0:18:14.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sepertinya belakangan ini,\N‎banyak yang jadi pasangan.
Dialogue: 0,0:18:18.43,0:18:20.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Pertama, keajaiban festival olahraga.
Dialogue: 0,0:18:20.59,0:18:22.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Lalu keajaiban festival budaya.
Dialogue: 0,0:18:22.72,0:18:24.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sekarang ditambah trip sekolah.
Dialogue: 0,0:18:24.47,0:18:25.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Pasangan Aladdin!{\i0}
Dialogue: 0,0:18:26.77,0:18:30.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Benar, pasangan itu mengejutkan.
Dialogue: 0,0:18:30.02,0:18:32.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sial. Aku ingin punya pacar.
Dialogue: 0,0:18:33.52,0:18:35.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau pasti gampang dapat pacar.
Dialogue: 0,0:18:35.40,0:18:38.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Yah, kalau kau yang bilang,\N‎rasanya omong kosong.
Dialogue: 0,0:18:39.57,0:18:42.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Kau tipe orang yang tahu-tahu punya pacar.
Dialogue: 0,0:18:43.53,0:18:45.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Sebentar lagi pasti punya pacar baru...
Dialogue: 0,0:18:45.79,0:18:47.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Aku tak mau pacaran lagi.
Dialogue: 0,0:18:50.08,0:18:51.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎- Benarkah?\N‎- Eh?
Dialogue: 0,0:18:52.92,0:18:56.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Maksudku, bukan pacaran setengah-setengah.
Dialogue: 0,0:18:57.67,0:18:59.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Koyun mulai menyerang!{\i0}
Dialogue: 0,0:19:00.63,0:19:03.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yah, aku tak peduli dengan Minato.
Dialogue: 0,0:19:03.10,0:19:06.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi kalau Yota dapat pacar duluan,\N‎aku akan menangis.
Dialogue: 0,0:19:09.23,0:19:10.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Tidak, aku tak butuh pacar.
Dialogue: 0,0:19:14.06,0:19:16.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Hino benar-benar mandiri.
Dialogue: 0,0:19:16.44,0:19:18.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa aku harus begitu juga?
Dialogue: 0,0:19:18.90,0:19:21.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}‎Berpacaran dan punya pacar{\i0}
Dialogue: 0,0:19:21.78,0:19:23.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}‎memang tak cocok untukku...{\i0}
Dialogue: 0,0:19:28.20,0:19:29.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kenapa?
Dialogue: 0,0:19:29.71,0:19:30.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Cuma lihat.
Dialogue: 0,0:19:32.17,0:19:34.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan menatapku seperti itu!
Dialogue: 0,0:19:47.10,0:19:48.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Sekarang ini,
Dialogue: 0,0:19:48.60,0:19:52.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎aku sedang berusaha\N‎menunjukkan keberanianku.
Dialogue: 0,0:19:52.60,0:19:55.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Koyun, kau agresif juga.
Dialogue: 0,0:19:55.02,0:19:56.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Begitulah.
Dialogue: 0,0:19:57.11,0:19:58.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Meski bukan sifatku.
Dialogue: 0,0:19:59.44,0:20:00.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku mendukungmu sih,
Dialogue: 0,0:20:00.74,0:20:03.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎tapi entah kenapa, rasanya agak rumit.
Dialogue: 0,0:20:04.24,0:20:05.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Karena aku tahu dia seperti apa.
Dialogue: 0,0:20:10.83,0:20:13.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Saat Amamiya punya pacar,{\i0}
Dialogue: 0,0:20:13.00,0:20:15.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎aku menyesal tak bertindak lebih cepat.{\i0}
Dialogue: 0,0:20:17.42,0:20:22.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Saat itu kupikir aku bisa merelakannya\N‎dan mengakhiri semuanya.{\i0}
Dialogue: 0,0:20:23.97,0:20:28.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Pada akhirnya, begitu situasinya berubah,\N‎perasaan itu muncul lagi.
Dialogue: 0,0:20:29.18,0:20:33.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kalau tak bertindak sekarang,\N‎aku pasti akan menyesal nanti.
Dialogue: 0,0:20:36.31,0:20:38.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku sudah pernah menyesal\N‎karena tak bertindak,
Dialogue: 0,0:20:38.61,0:20:41.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎ini saatnya menyesal karena bertindak.
Dialogue: 0,0:20:41.36,0:20:43.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau sudah siap menyesal dari awal?
Dialogue: 0,0:20:44.74,0:20:47.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Tidak, tentu saja aku tak mau menyesal,
Dialogue: 0,0:20:48.08,0:20:51.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎tapi aku merasa tak masalah\N‎kalau akhirnya menyesal.
Dialogue: 0,0:20:52.08,0:20:53.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya, kedengarannya bagus.
Dialogue: 0,0:20:54.75,0:20:58.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku juga merasa lega\N‎karena bisa menyampaikan perasaanku.
Dialogue: 0,0:20:59.75,0:21:01.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku juga bisa mengakhirinya.
Dialogue: 0,0:21:02.05,0:21:03.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Koyun, semangat, ya.
Dialogue: 0,0:21:03.51,0:21:06.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Saranmu seolah semuanya akan berakhir.
Dialogue: 0,0:21:06.01,0:21:07.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Benar juga. Maaf.
Dialogue: 0,0:21:10.60,0:21:15.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi aku tak tahu apa yang terjadi\N‎saat cinta sepihak menjadi berbalas.
Dialogue: 0,0:21:17.35,0:21:20.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Benar juga. Aku juga tak tahu.
Dialogue: 0,0:21:25.49,0:21:26.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kenapa?
Dialogue: 0,0:21:27.07,0:21:28.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kenapa baru sekarang?
Dialogue: 0,0:21:29.37,0:21:30.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kenapa sekarang?
Dialogue: 0,0:21:31.79,0:21:36.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Padahal aku sudah berpikir panjang\N‎sebelum memberi jawaban.{\i0}
Dialogue: 0,0:21:38.42,0:21:42.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Andai waktu itu\N‎kami memiliki perasaan yang sama.{\i0}
Dialogue: 0,0:21:42.84,0:21:46.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku terus memikirkan\N‎berbagai kemungkinan yang terjadi.{\i0}
Dialogue: 0,0:21:48.68,0:21:50.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Menyebalkan!
Dialogue: 0,0:21:52.51,0:21:55.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Saat trip sekolah,\N‎apa kami akan sekelompok?{\i0}
Dialogue: 0,0:21:57.19,0:21:58.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Bagaimana kalau kuajak?{\i0}
Dialogue: 0,0:21:59.06,0:22:01.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tidak, itu berlebihan.{\i0}
Dialogue: 0,0:22:01.94,0:22:02.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Eh?{\i0}
Dialogue: 0,0:22:03.48,0:22:06.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tapi melihat hubungan kami sekarang,\N‎bukannya itu wajar?{\i0}
Dialogue: 0,0:22:06.95,0:22:08.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tidak...{\i0}
Dialogue: 0,0:22:08.95,0:22:10.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tapi...{\i0}
Dialogue: 0,0:22:18.17,0:22:21.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ayo makan bakpau daging lagi\N‎sepulang sekolah.
Dialogue: 0,0:22:21.08,0:22:23.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sudah setahun berlalu, ya?
Dialogue: 0,0:22:24.00,0:22:25.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Cepat sekali.
Dialogue: 0,0:23:50.92,0:23:55.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Terjemahan subtitle oleh Shoffanny R
