Dialogue: 0,0:04:42.28,0:04:43.28,sign,,0000,0000,0000,,‎KAU MEMANG BEGITU
Dialogue: 0,0:09:26.02,0:09:27.81,sign,,0000,0000,0000,,‎UKURAN PESTA
Dialogue: 0,0:09:40.20,0:09:41.28,sign,,0000,0000,0000,,{\an8}‎HASIL BERPIKIR BERLEBIHAN...
Dialogue: 0,0:12:07.26,0:12:08.51,sign,,0000,0000,0000,,{\an8}‎KUNYAH KUNYAH\N‎KRIUK KRIUK
Dialogue: 0,0:12:08.51,0:12:11.18,sign,,0000,0000,0000,,‎SUASANA CANGGUNG DI ANTARA MEREKA
Dialogue: 0,0:14:01.79,0:14:03.63,sign,,0000,0000,0000,,‎KEJADIAN MEMALUKAN HARI INI
Dialogue: 0,0:14:04.88,0:14:05.96,sign,,0000,0000,0000,,{\an8}‎LESU...
Dialogue: 0,0:14:09.34,0:14:10.72,sign,,0000,0000,0000,,‎ADA PESAN BARU
