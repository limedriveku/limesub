Dialogue: 0,0:04:20.55,0:04:22.22,sign,,0000,0000,0000,,{\an8}‎AYO BERMAIN!!
Dialogue: 0,0:04:24.80,0:04:26.30,sign,,0000,0000,0000,,‎BAN BERJALAN SUSYI - SUSYI TARO
Dialogue: 0,0:05:02.01,0:05:03.01,sign,,0000,0000,0000,,‎HA
Dialogue: 0,0:05:35.04,0:05:36.54,sign,,0000,0000,0000,,{\an8}‎TSUKIKO - EH?
Dialogue: 0,0:06:34.93,0:06:36.89,sign,,0000,0000,0000,,{\an8}‎SEDANG MEMPROSES
Dialogue: 0,0:07:14.01,0:07:15.10,sign,,0000,0000,0000,,‎EH
Dialogue: 0,0:07:29.82,0:07:30.90,sign,,0000,0000,0000,,‎RENDAH DIRI, MEMBENCI DIRI, DAN LAINNYA...
Dialogue: 0,0:07:57.14,0:07:58.14,sign,,0000,0000,0000,,{\an8}‎CEKIKIK
Dialogue: 0,0:08:38.51,0:08:39.97,sign,,0000,0000,0000,,‎TIDAK\N‎HUH
Dialogue: 0,0:08:39.97,0:08:41.60,sign,,0000,0000,0000,,‎EPISODE 19 - TRANSISI\N‎VERSI MINATO
Dialogue: 0,0:09:04.66,0:09:05.79,sign,,0000,0000,0000,,‎DIAM
Dialogue: 0,0:09:56.22,0:09:57.88,sign,,0000,0000,0000,,‎KERIPIK KENTANG ADIKTIF
Dialogue: 0,0:12:40.63,0:12:41.80,sign,,0000,0000,0000,,{\an8}‎BOLING MEITEN
Dialogue: 0,0:13:35.52,0:13:36.52,sign,,0000,0000,0000,,‎MASUK
Dialogue: 0,0:14:33.70,0:14:34.78,sign,,0000,0000,0000,,‎TING - PESAN BARU
Dialogue: 0,0:14:34.79,0:14:36.66,sign,,0000,0000,0000,,‎TING - PESAN TERKIRIM\N‎TING - PESAN BARU
Dialogue: 0,0:14:37.96,0:14:39.04,sign,,0000,0000,0000,,‎EH
Dialogue: 0,0:15:21.87,0:15:23.00,sign,,0000,0000,0000,,‎EPISODE 19 - TRANSISI\N‎VERSI MOMOKA
Dialogue: 0,0:16:25.44,0:16:26.52,sign,,0000,0000,0000,,‎HAMBURGER
Dialogue: 0,0:16:59.26,0:17:00.35,sign,,0000,0000,0000,,{\an8}‎MOMOKA
Dialogue: 0,0:17:43.52,0:17:44.43,sign,,0000,0000,0000,,‎RUANG UKS
Dialogue: 0,0:17:48.94,0:17:49.94,sign,,0000,0000,0000,,‎PUSING...
Dialogue: 0,0:18:39.95,0:18:41.87,sign,,0000,0000,0000,,‎PERGI KE FESTIVAL BERSAMA TEMAN-TEMAN
Dialogue: 0,0:19:13.94,0:19:15.02,sign,,0000,0000,0000,,‎SUDAH DIBACA
Dialogue: 0,0:20:25.18,0:20:26.14,sign,,0000,0000,0000,,{\an8}‎EMPAT TEMAN!!\N‎LIBUR MUSIM PANAS
Dialogue: 0,0:21:02.97,0:21:03.97,sign,,0000,0000,0000,,‎HANYA MELIHATKU
Dialogue: 0,0:21:07.47,0:21:09.97,sign,,0000,0000,0000,,‎BUKAN MAUNYA, TAPI MAUKU?\N‎JAUHI CEWEK LAIN
Dialogue: 0,0:01:42.47,0:01:45.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Yota menyukaiku.{\i0}
Dialogue: 0,0:01:46.14,0:01:48.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Koyun menyukai Minato.{\i0}
Dialogue: 0,0:01:49.77,0:01:51.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Minato sudah punya pacar.{\i0}
Dialogue: 0,0:01:52.82,0:01:55.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Banyak hal terjadi\N‎beberapa bulan terakhir ini,{\i0}
Dialogue: 0,0:01:55.32,0:01:57.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎dan hubungan di antara kami pun berubah{\i0}
Dialogue: 0,0:01:59.57,0:02:01.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎atau mungkin tidak.{\i0}
Dialogue: 0,0:02:11.25,0:02:12.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan sombong.
Dialogue: 0,0:02:13.42,0:02:15.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sekarang kami hanya berteman.{\i0}
Dialogue: 0,0:02:18.59,0:02:20.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎{\i1}Selanjutnya, Yota. Mulai!{\i0}
Dialogue: 0,0:02:21.14,0:02:23.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baiklah. Ini dia!
Dialogue: 0,0:02:26.89,0:02:28.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Hebat!\N‎- Suaranya mantap.
Dialogue: 0,0:02:28.94,0:02:30.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Lengan senapan mesin.
Dialogue: 0,0:02:37.24,0:02:39.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Yah, aku jarang pakai kekuatan tangan...
Dialogue: 0,0:02:39.99,0:02:41.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan banyak alasan.
Dialogue: 0,0:02:44.41,0:02:46.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Oke.\N‎- Wah, dia semangat sekali.
Dialogue: 0,0:02:47.58,0:02:49.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Lap...
Dialogue: 0,0:02:49.54,0:02:51.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau serius sekali.
Dialogue: 0,0:02:52.50,0:02:53.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maju!
Dialogue: 0,0:02:53.59,0:02:54.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dua tangan?
Dialogue: 0,0:02:57.34,0:02:59.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Pas di jalurnya. Tepat di tengah.
Dialogue: 0,0:03:06.31,0:03:07.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Kok bisa?
Dialogue: 0,0:03:08.98,0:03:10.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Batu dan kertas!
Dialogue: 0,0:03:13.61,0:03:15.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Ayo!
Dialogue: 0,0:03:15.11,0:03:16.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Kita tak punya peluang, ya?
Dialogue: 0,0:03:17.53,0:03:18.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Maaf jadi membebanimu.
Dialogue: 0,0:03:18.74,0:03:20.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak, kurasa itu...
Dialogue: 0,0:03:21.03,0:03:22.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Memang benar.\N‎- Hei.
Dialogue: 0,0:03:23.57,0:03:28.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Entah apakah Koyun baik-baik saja\N‎ataukah dia sedang sedih,{\i0}
Dialogue: 0,0:03:29.75,0:03:32.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎tapi ternyata dia terlihat baik-baik saja.{\i0}
Dialogue: 0,0:03:33.83,0:03:36.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sekarang aku tahu\N‎dia cuma menganggapku teman.{\i0}
Dialogue: 0,0:03:36.84,0:03:39.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Selagi bisa kutarik,\N‎aku ingin merelakan perasaanku.{\i0}
Dialogue: 0,0:03:40.30,0:03:44.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Apa mungkin memang ini\N‎yang terbaik untuk mereka?{\i0}
Dialogue: 0,0:03:45.39,0:03:46.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Rasakan!
Dialogue: 0,0:03:48.31,0:03:49.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hore!
Dialogue: 0,0:03:52.31,0:03:53.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Miki.
Dialogue: 0,0:03:54.52,0:03:57.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Baik. Selanjutnya. Fokus!\N‎- Memangnya latihan klub?
Dialogue: 0,0:04:03.95,0:04:04.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Kita berhasil.
Dialogue: 0,0:04:10.12,0:04:11.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hore!
Dialogue: 0,0:04:12.41,0:04:13.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tos?{\i0}
Dialogue: 0,0:04:15.25,0:04:17.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Miki. Kau terlihat mengkhawatirkan mereka.
Dialogue: 0,0:04:18.88,0:04:19.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dekat sekali!
Dialogue: 0,0:04:23.47,0:04:24.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Pencapitnya lemah!
Dialogue: 0,0:04:26.30,0:04:28.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau suka yang telur, ya?
Dialogue: 0,0:04:28.18,0:04:29.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Memangnya kenapa?\N‎- Tak apa.
Dialogue: 0,0:04:31.77,0:04:33.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Menyenangkan sekali.
Dialogue: 0,0:04:33.06,0:04:35.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sampai jumpa saat latihan drama.
Dialogue: 0,0:04:38.86,0:04:40.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kapan-kapan main lagi, ya?
Dialogue: 0,0:04:42.19,0:04:43.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya.
Dialogue: 0,0:04:50.49,0:04:52.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau yakin baik-baik saja?
Dialogue: 0,0:04:53.87,0:04:57.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku penasaran,\N‎apa kau sudah melupakan Minato?
Dialogue: 0,0:05:00.46,0:05:01.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Belum sama sekali.
Dialogue: 0,0:05:04.17,0:05:07.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Amamiya berpacaran dengan Momoka.{\i0}
Dialogue: 0,0:05:07.05,0:05:12.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku memang bilang kami cukup berteman\N‎dan aku lari dari perasaanku sendiri,{\i0}
Dialogue: 0,0:05:12.39,0:05:15.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎tapi karena sekarang\N‎pilihannya cuma berteman,{\i0}
Dialogue: 0,0:05:16.02,0:05:20.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎perasaanku padanya malah makin jelas.{\i0}
Dialogue: 0,0:05:21.73,0:05:26.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Menyebalkan. Aku benci.\N‎Menyakitkan. Rasanya begitu.
Dialogue: 0,0:05:27.61,0:05:30.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak sanggup menghadapi\N‎perasaan ini sendiri.
Dialogue: 0,0:05:30.62,0:05:31.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Koyun.
Dialogue: 0,0:05:32.41,0:05:35.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Tapi aku sudah membicarakannya\N‎dengan Tsukiko.
Dialogue: 0,0:05:36.54,0:05:40.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Dia membantuku memikirkan pilihanku,\N‎seperti mengambil langkah lebih dulu.
Dialogue: 0,0:05:41.46,0:05:44.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Aku juga memikirkan\N‎apa yang bisa kulakukan.
Dialogue: 0,0:05:45.01,0:05:46.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Jadi...
Dialogue: 0,0:05:47.30,0:05:48.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kuputuskan untuk diam saja.
Dialogue: 0,0:05:49.47,0:05:50.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa?
Dialogue: 0,0:05:51.35,0:05:53.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kenapa? Kenapa begitu?{\i0}
Dialogue: 0,0:05:54.52,0:05:56.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak mau mengganggu hubungan mereka.
Dialogue: 0,0:05:57.14,0:06:01.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi aku akan menerima\N‎dan memahami perasaanku.
Dialogue: 0,0:06:02.82,0:06:06.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku bisa menyukai seseorang sebagai teman\N‎atau secara romantis.
Dialogue: 0,0:06:07.28,0:06:11.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Memilih salah satunya bukan berarti\N‎harus kehilangan yang lainnya.
Dialogue: 0,0:06:13.62,0:06:17.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kedua rasa suka itu sangat penting bagiku.
Dialogue: 0,0:06:18.08,0:06:20.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Apa Yota juga merasa begitu?{\i0}
Dialogue: 0,0:06:20.92,0:06:23.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bukankah itu sulit?
Dialogue: 0,0:06:25.96,0:06:28.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terkadang aku memang merasa sedih,
Dialogue: 0,0:06:28.22,0:06:30.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎tapi bukan berarti aku tak bahagia.
Dialogue: 0,0:06:31.26,0:06:32.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mungkin itu demi diriku sendiri.
Dialogue: 0,0:06:33.39,0:06:34.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sampai perasaan ini hilang.
Dialogue: 0,0:06:36.89,0:06:40.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}‎Kukira dia bakal curhat padaku\N‎setelah melihat yang terjadi.{\i0}
Dialogue: 0,0:06:40.94,0:06:43.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tapi ternyata dia sudah cerita ke Tsukko?{\i0}
Dialogue: 0,0:06:44.48,0:06:47.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}‎Dan dia sudah mengambil keputusan?{\i0}
Dialogue: 0,0:06:47.69,0:06:52.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dari awal, sepertinya dia\N‎memang jarang curhat kepadaku.{\i0}
Dialogue: 0,0:06:54.49,0:06:56.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku tak berguna.{\i0}
Dialogue: 0,0:06:57.29,0:07:00.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sekarang, aku harus bagaimana?{\i0}
Dialogue: 0,0:07:01.67,0:07:03.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku merasa agak sedih.{\i0}
Dialogue: 0,0:07:03.79,0:07:07.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku agak malu membicarakan\N‎hal seperti ini denganmu.
Dialogue: 0,0:07:08.26,0:07:09.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mungkin karena kita selalu bersama?
Dialogue: 0,0:07:10.72,0:07:13.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku sering ragu untuk cerita padamu,\N‎terutama soal hal serius.
Dialogue: 0,0:07:15.10,0:07:19.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Kenapa? Aku selalu cerita\N‎berbagai macam hal padamu.
Dialogue: 0,0:07:19.14,0:07:21.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Apa-apaan itu? Sedihnya! Kagetnya!
Dialogue: 0,0:07:21.10,0:07:22.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Kau tak memercayaiku?
Dialogue: 0,0:07:22.65,0:07:24.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Tidak, bukan begitu.
Dialogue: 0,0:07:25.65,0:07:29.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku selalu takut\N‎orang tahu terlalu banyak tentangku.
Dialogue: 0,0:07:30.90,0:07:33.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Itu bukan salahmu atau apa pun.
Dialogue: 0,0:07:34.20,0:07:37.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Rasanya kami pernah membicarakan ini...{\i0}
Dialogue: 0,0:07:37.79,0:07:41.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau berkencan dengan Igarashi\N‎karena salahku, 'kan?
Dialogue: 0,0:07:41.71,0:07:43.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Igarashi...{\i0}
Dialogue: 0,0:07:43.71,0:07:45.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Omong-omong,
Dialogue: 0,0:07:45.71,0:07:48.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎aku sempat makan es krim\N‎bersama Igarashi di taman.
Dialogue: 0,0:07:48.42,0:07:51.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tunggu dulu! Informasinya terlalu banyak!\N‎Kenapa bisa begitu?
Dialogue: 0,0:07:51.97,0:07:55.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Jangan asal menghubungkan ceritaku\N‎dengan Igarashi!
Dialogue: 0,0:07:55.55,0:07:57.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Aku tak suka itu!
Dialogue: 0,0:08:00.31,0:08:02.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku tak menyadarinya,{\i0}
Dialogue: 0,0:08:03.19,0:08:06.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎tapi Koyun makin tegar akhir-akhir ini.{\i0}
Dialogue: 0,0:08:08.98,0:08:12.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku bisa menyukai seseorang sebagai teman\N‎atau secara romantis.{\i0}
Dialogue: 0,0:08:12.99,0:08:16.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kedua rasa suka itu sangat penting bagiku.{\i0}
Dialogue: 0,0:08:16.95,0:08:19.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Pertemanan dan cinta...{\i0}
Dialogue: 0,0:08:19.99,0:08:22.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bagiku, kau adalah Miki.
Dialogue: 0,0:08:25.67,0:08:27.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tidak...{\i0}
Dialogue: 0,0:08:27.21,0:08:28.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kenapa sekarang?{\i0}
Dialogue: 0,0:08:28.71,0:08:31.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kenapa aku teringat itu sekarang?{\i0}
Dialogue: 0,0:08:34.18,0:08:36.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak! Kubilang tidak!
Dialogue: 0,0:08:36.18,0:08:38.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Latihan roda perut. Keren!
Dialogue: 0,0:08:41.60,0:08:43.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hentikan! Dasar menyebalkan!
Dialogue: 0,0:08:43.52,0:08:46.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Astaga! Kau sangat jelek dan berisik!
Dialogue: 0,0:08:46.48,0:08:49.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mati saja kau, Kakak. Aku membencimu!
Dialogue: 0,0:08:49.11,0:08:50.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku bahkan tak menganggapmu adik...
Dialogue: 0,0:08:50.78,0:08:54.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dari dulu, sejak aku masih kecil,{\i0}
Dialogue: 0,0:08:54.40,0:08:59.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎aku lebih memikirkan perasaan orang lain\N‎daripada perasaanku sendiri.{\i0}
Dialogue: 0,0:08:59.37,0:09:01.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau pikir menangis bisa membantu?
Dialogue: 0,0:09:01.08,0:09:04.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kalian berdua, berhenti!\N‎Tunggu sampai ayah kalian pulang.
Dialogue: 0,0:09:08.58,0:09:11.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Untunglah, setidaknya Minato anak baik.
Dialogue: 0,0:09:16.38,0:09:18.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa sepadan meninggalkan rumah\N‎demi sekolah ini?
Dialogue: 0,0:09:18.93,0:09:22.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ayah tahu kau hanya akan membuang waktumu\N‎untuk bersenang-senang.
Dialogue: 0,0:09:23.10,0:09:27.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ayah menyuruhku menetapkan tujuan,\N‎tapi Ayah melarangku mengejar mimpiku?
Dialogue: 0,0:09:27.10,0:09:28.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mimpimu itu tak terlihat serius.
Dialogue: 0,0:09:28.77,0:09:32.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau cuma mau keluar dari rumah\N‎dan main seharian.
Dialogue: 0,0:09:32.15,0:09:33.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Berisik sekali.\N‎- Cukup!
Dialogue: 0,0:09:33.61,0:09:37.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Semoga dia cepat pergi,\N‎dasar pembuat onar.
Dialogue: 0,0:09:38.20,0:09:40.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kita terbawa emosi\N‎dan akhirnya bertengkar.{\i0}
Dialogue: 0,0:09:41.24,0:09:44.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎"Perasaan" apa yang membuat seseorang\N‎bertindak sejauh itu?{\i0}
Dialogue: 0,0:09:44.83,0:09:47.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Di mana Kaito?\N‎- Dia bilang tak mau makan lagi.
Dialogue: 0,0:09:47.83,0:09:49.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Astaga.
Dialogue: 0,0:09:49.04,0:09:51.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baguslah kalau dia tak ada, biarkan saja.
Dialogue: 0,0:09:51.50,0:09:54.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei, Nagisa. Jangan bilang begitu.
Dialogue: 0,0:10:01.39,0:10:04.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Minato, kau perhatian sekali.
Dialogue: 0,0:10:05.77,0:10:07.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau pasti populer nanti.
Dialogue: 0,0:10:07.56,0:10:08.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sama sepertiku.
Dialogue: 0,0:10:12.11,0:10:14.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sampai jumpa, Minato. Jaga dirimu.
Dialogue: 0,0:10:15.90,0:10:17.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan pergi.
Dialogue: 0,0:10:17.86,0:10:21.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Meskipun kau adik yang manis,\N‎aku tetap harus pergi.
Dialogue: 0,0:10:21.82,0:10:23.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kamarku boleh untukmu. Maaf, ya?
Dialogue: 0,0:10:27.54,0:10:28.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima kasih.
Dialogue: 0,0:10:29.25,0:10:31.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hanya kau yang selalu membelaku\N‎di rumah itu.
Dialogue: 0,0:10:38.67,0:10:40.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kenapa malah kau yang menangis?
Dialogue: 0,0:10:51.65,0:10:54.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia itu seperti beda sendiri, ya?
Dialogue: 0,0:10:54.77,0:10:56.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku paham.
Dialogue: 0,0:10:56.40,0:10:59.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Seolah-olah beda frekuensi.\N‎Rasanya agak aneh.
Dialogue: 0,0:10:59.57,0:11:00.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Benar, 'kan, Minato?
Dialogue: 0,0:11:01.28,0:11:03.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Begitu, ya? Aku malah tak sadar.
Dialogue: 0,0:11:03.99,0:11:07.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Minato tak akan paham\N‎karena dia memang suka orang aneh.
Dialogue: 0,0:11:07.29,0:11:08.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Tidak sopan.
Dialogue: 0,0:11:08.79,0:11:11.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Saat kelas terakhir bersamanya itu...
Dialogue: 0,0:11:11.29,0:11:15.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Terkadang, orang suka terbawa suasana.{\i0}
Dialogue: 0,0:11:15.80,0:11:17.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎"Kita boleh mengejeknya."{\i0}
Dialogue: 0,0:11:17.92,0:11:19.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Lalu, "Wajar saja membencinya."{\i0}
Dialogue: 0,0:11:20.63,0:11:23.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Ucapan orang saat terbawa suasana...{\i0}
Dialogue: 0,0:11:23.72,0:11:25.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kenapa aku begitu terganggu?{\i0}
Dialogue: 0,0:11:26.72,0:11:28.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Rasanya ada yang salah.{\i0}
Dialogue: 0,0:11:29.48,0:11:30.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi...
Dialogue: 0,0:11:31.64,0:11:34.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia sebenarnya cukup lucu\N‎kalau mengobrol berdua dengannya.
Dialogue: 0,0:11:34.94,0:11:36.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia hanya agak pemalu.
Dialogue: 0,0:11:36.82,0:11:38.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau sudah mengobrol dengannya?
Dialogue: 0,0:11:38.82,0:11:42.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya. Dia jago main gim.
Dialogue: 0,0:11:42.07,0:11:44.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bahkan skornya masuk sepuluh besar.
Dialogue: 0,0:11:44.12,0:11:45.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Wah, keren!
Dialogue: 0,0:11:46.49,0:11:47.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Amamiya.
Dialogue: 0,0:11:48.12,0:11:50.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Kau pacaran dengan Imada?\N‎- Ya.
Dialogue: 0,0:11:50.50,0:11:52.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Serius?\N‎- Memang kenapa?
Dialogue: 0,0:11:52.58,0:11:57.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jujur saja. Kau jauh di atas levelnya.
Dialogue: 0,0:11:59.96,0:12:01.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Soalnya...{\i0}
Dialogue: 0,0:12:01.55,0:12:03.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kenapa kau begitu peduli padanya?{\i0}
Dialogue: 0,0:12:03.97,0:12:06.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kau mau saja bicara dengannya.\N‎Bukannya menjijikkan?{\i0}
Dialogue: 0,0:12:06.76,0:12:09.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Cuma kau yang tak benci cewek itu, 'kan?{\i0}
Dialogue: 0,0:12:10.47,0:12:12.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku tak bisa diam saja.{\i0}
Dialogue: 0,0:12:13.81,0:12:15.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Karena aku merasa ada yang salah.{\i0}
Dialogue: 0,0:12:16.23,0:12:19.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Orang sering bilang aku sulit didekati.{\i0}
Dialogue: 0,0:12:19.23,0:12:22.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku tak pandai memulai pembicaraan.{\i0}
Dialogue: 0,0:12:22.24,0:12:26.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Rasanya membosankan\N‎karena tak ada yang cocok denganku.{\i0}
Dialogue: 0,0:12:30.70,0:12:32.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Terima kasih.\N‎- Makasih.
Dialogue: 0,0:12:32.96,0:12:33.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Syukurlah.
Dialogue: 0,0:12:34.58,0:12:35.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Lihat?
Dialogue: 0,0:12:37.46,0:12:39.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Ini sudah benar.{\i0}
Dialogue: 0,0:12:41.80,0:12:44.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Amamiya. Apa kau jago main boling?
Dialogue: 0,0:12:46.22,0:12:49.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Kemampuanku biasa saja.\N‎Tidak terlalu jago.
Dialogue: 0,0:12:50.39,0:12:53.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dulu dia sering menghindariku.{\i0}
Dialogue: 0,0:12:53.27,0:12:54.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Begitu, ya?
Dialogue: 0,0:12:54.64,0:12:57.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Sepertinya aku jadi yang terakhir.\N‎Aku tidak jago.
Dialogue: 0,0:12:57.40,0:13:01.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Akhir-akhir ini, dia jadi lebih ramah.{\i0}
Dialogue: 0,0:13:02.07,0:13:07.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Apa dia merasa lebih nyaman\N‎karena tahu aku tak menyukainya?{\i0}
Dialogue: 0,0:13:10.91,0:13:13.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yah, aku jarang pakai kekuatan tangan...
Dialogue: 0,0:13:13.41,0:13:15.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan banyak alasan.
Dialogue: 0,0:13:16.04,0:13:18.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dia benar-benar jadi berbeda.{\i0}
Dialogue: 0,0:13:19.17,0:13:23.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kalau saat itu aku terus mendekatinya\N‎dan ditolak mentah-mentah,{\i0}
Dialogue: 0,0:13:24.59,0:13:28.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎mungkin kami tak akan bisa\N‎berkumpul seperti ini.{\i0}
Dialogue: 0,0:13:28.93,0:13:30.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ayo!
Dialogue: 0,0:13:30.35,0:13:32.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kita tak punya peluang, ya?
Dialogue: 0,0:13:32.72,0:13:34.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf jadi membebanimu.
Dialogue: 0,0:13:34.06,0:13:35.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Rasakan!
Dialogue: 0,0:13:36.52,0:13:38.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hore!
Dialogue: 0,0:13:43.86,0:13:44.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hore!
Dialogue: 0,0:13:48.32,0:13:49.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Syukurlah.{\i0}
Dialogue: 0,0:13:52.37,0:13:53.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dia tersenyum.{\i0}
Dialogue: 0,0:13:55.29,0:13:57.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kami bisa kembali berteman.{\i0}
Dialogue: 0,0:14:02.67,0:14:06.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Syukurlah keseimbangan hubungan ini\N‎jadi tidak rusak.{\i0}
Dialogue: 0,0:14:11.60,0:14:13.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa? Kau barusan memotret?
Dialogue: 0,0:14:13.97,0:14:16.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mataku pasti setengah tertutup tadi.
Dialogue: 0,0:14:16.10,0:14:17.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku harus melapor ke Momoka.
Dialogue: 0,0:14:18.39,0:14:19.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Untuk apa?
Dialogue: 0,0:14:20.06,0:14:22.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Agar dia tahu aku bersama siapa\N‎dan semacamnya.
Dialogue: 0,0:14:22.82,0:14:25.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Eh? Dia menyuruhmu begitu?
Dialogue: 0,0:14:25.65,0:14:27.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak, kok.
Dialogue: 0,0:14:27.82,0:14:32.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia memang tak minta foto,\N‎tapi ini bisa membuatnya tenang.
Dialogue: 0,0:14:36.66,0:14:37.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Itu terlalu banyak.
Dialogue: 0,0:14:39.04,0:14:42.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sepertinya kau sering sekali\N‎mendapatkan pacar bucin.
Dialogue: 0,0:14:43.09,0:14:46.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mereka juga makin posesif setiap harinya.
Dialogue: 0,0:14:46.30,0:14:48.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Ingat mantan pacar terakhirmu?\N‎- Tunggu.
Dialogue: 0,0:14:49.26,0:14:53.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan bicara buruk soal mereka.\N‎Mereka bukan orang jahat.
Dialogue: 0,0:14:53.22,0:14:55.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Benarkah?
Dialogue: 0,0:14:55.51,0:14:57.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi kau harus tahu.
Dialogue: 0,0:14:57.81,0:15:00.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Alasan dia begitu posesif\N‎dan mengirimimu banyak pesan
Dialogue: 0,0:15:00.85,0:15:03.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎karena dia tak percaya padamu.
Dialogue: 0,0:15:04.90,0:15:06.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tahu.
Dialogue: 0,0:15:06.94,0:15:11.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sekarang aku tahu kenapa dia begitu cemas.{\i0}
Dialogue: 0,0:15:13.03,0:15:14.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tak apa.{\i0}
Dialogue: 0,0:15:14.49,0:15:16.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Kali ini aku tak akan membuatnya cemas.
Dialogue: 0,0:15:17.75,0:15:19.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku akan jadi pacar yang baik.
Dialogue: 0,0:15:23.00,0:15:25.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau beruntung, Momoka. Kau sangat populer.
Dialogue: 0,0:15:26.96,0:15:29.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Memangnya bagus kalau populer?{\i0}
Dialogue: 0,0:15:30.17,0:15:32.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Mungkin bagus kalau ini dunia fiksi{\i0}
Dialogue: 0,0:15:32.55,0:15:35.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎dan bisa bahagia selamanya\N‎dengan siapa pun.{\i0}
Dialogue: 0,0:15:35.93,0:15:39.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tapi disukai orang-orang tak penting,{\i0}
Dialogue: 0,0:15:39.27,0:15:40.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎jangan anggap itu romantis.{\i0}
Dialogue: 0,0:15:41.52,0:15:43.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Memang benar, aku jadi punya pilihan...{\i0}
Dialogue: 0,0:15:43.90,0:15:45.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf.
Dialogue: 0,0:15:45.81,0:15:47.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Mereka menyukaiku seenaknya.{\i0}
Dialogue: 0,0:15:48.98,0:15:50.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau sombong sekali.
Dialogue: 0,0:15:51.82,0:15:54.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Lalu membenciku seenaknya\N‎seolah-olah aku penipu.{\i0}
Dialogue: 0,0:15:55.91,0:15:58.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Padahal itu tak menyenangkan bagiku.{\i0}
Dialogue: 0,0:15:58.54,0:16:01.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Kau pamer karena populer?\N‎- Kau memang cantik.
Dialogue: 0,0:16:01.16,0:16:03.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tak ada yang mengerti perasaanku.{\i0}
Dialogue: 0,0:16:03.62,0:16:06.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku berhak memilih siapa yang kusukai.{\i0}
Dialogue: 0,0:16:06.29,0:16:10.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kenapa orang yang menerima cinta\N‎harus merendah agar tak dibenci?{\i0}
Dialogue: 0,0:16:11.51,0:16:12.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Konyol sekali.{\i0}
Dialogue: 0,0:16:14.01,0:16:17.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Saat cowok yang jarang bicara denganku\N‎menyatakan cinta padaku,{\i0}
Dialogue: 0,0:16:18.22,0:16:21.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎itu pasti karena cowok-cowok lain\N‎terlalu memujiku.{\i0}
Dialogue: 0,0:16:21.18,0:16:25.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Pacaran denganku bisa jadi bahan pamer\N‎ke teman-teman mereka.{\i0}
Dialogue: 0,0:16:26.52,0:16:28.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Saat aku setuju untuk berpacaran pun...{\i0}
Dialogue: 0,0:16:28.57,0:16:30.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau membawa pacarmu?
Dialogue: 0,0:16:31.57,0:16:33.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Manisnya!\N‎- Mantap!
Dialogue: 0,0:16:33.74,0:16:37.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Mereka hanya menganggapku boneka\N‎yang bisa dipamerkan.{\i0}
Dialogue: 0,0:16:37.62,0:16:39.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Rasanya hampa.{\i0}
Dialogue: 0,0:16:39.08,0:16:41.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku tak mau jadi populer.{\i0}
Dialogue: 0,0:16:41.12,0:16:44.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku ingin cowok yang kusukai\N‎juga menyukaiku.{\i0}
Dialogue: 0,0:16:45.71,0:16:48.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku ingin jatuh cinta.{\i0}
Dialogue: 0,0:16:52.55,0:16:54.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}‎Aku tak mau melewatkan hari pertamaku.{\i0}
Dialogue: 0,0:16:55.72,0:16:59.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}‎Kukira aku cuma sakit tenggorokan.{\i0}
Dialogue: 0,0:17:00.35,0:17:03.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Seharusnya hari ini aku di rumah saja.{\i0}
Dialogue: 0,0:17:03.98,0:17:06.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku menggigil. Apa aku demam?{\i0}
Dialogue: 0,0:17:07.81,0:17:10.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tapi pulang sekarang terlalu melelahkan.{\i0}
Dialogue: 0,0:17:10.36,0:17:12.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Astaga! Bikin kaget saja.
Dialogue: 0,0:17:12.65,0:17:14.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia sedang apa?
Dialogue: 0,0:17:14.95,0:17:17.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Dia menangis? Ini masa-masa sibuk.\N{\i1}‎- Astaga...{\i0}
Dialogue: 0,0:17:17.87,0:17:19.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Berisik sekali...{\i0}
Dialogue: 0,0:17:20.87,0:17:22.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau tak apa?
Dialogue: 0,0:17:24.29,0:17:27.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau anak kelas satu, ya?\N‎Kau tahu ruang UKS di mana?
Dialogue: 0,0:17:28.38,0:17:29.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bisa berdiri?
Dialogue: 0,0:17:33.30,0:17:34.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kenapa?{\i0}
Dialogue: 0,0:17:35.30,0:17:38.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kenapa sekarang\N‎saat aku berantakan begini?{\i0}
Dialogue: 0,0:17:38.84,0:17:43.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kenapa tadi aku tak menata rambutku\N‎dan berdandan lebih baik?{\i0}
Dialogue: 0,0:17:44.43,0:17:45.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Astaga.
Dialogue: 0,0:17:46.02,0:17:48.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Seharusnya jangan ke sekolah\N‎dengan demam setinggi ini.
Dialogue: 0,0:17:50.65,0:17:53.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Apa cowok tadi\N‎anggota klub sepak bola, ya?{\i0}
Dialogue: 0,0:17:54.07,0:17:56.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Apa dia menyukai seseorang?{\i0}
Dialogue: 0,0:17:56.53,0:17:58.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Apa dia sudah ada pacar?{\i0}
Dialogue: 0,0:17:59.28,0:18:02.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kalau tak ada, aku ingin jadi pacarnya.{\i0}
Dialogue: 0,0:18:02.28,0:18:06.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dan bukan sekadar bonekanya.\N‎Aku ingin jadi pacar sungguhan.{\i0}
Dialogue: 0,0:18:06.75,0:18:10.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Pertama, aku harus menyatakan perasaanku\N‎agar hubungan ini bisa dimulai.{\i0}
Dialogue: 0,0:18:12.59,0:18:13.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Maukah kau
Dialogue: 0,0:18:14.55,0:18:16.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎menjadi pacarku?
Dialogue: 0,0:18:20.34,0:18:21.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ayo kita coba.
Dialogue: 0,0:18:23.43,0:18:25.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Wah, hore!
Dialogue: 0,0:18:26.18,0:18:28.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Meski sekarang dia menyukai orang lain,{\i0}
Dialogue: 0,0:18:28.69,0:18:32.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎perasaannya padaku bisa berubah\N‎seiring berjalannya waktu.{\i0}
Dialogue: 0,0:18:32.19,0:18:33.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Mungkin dia akan melupakannya.{\i0}
Dialogue: 0,0:18:36.32,0:18:38.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku pikir begitu...{\i0}
Dialogue: 0,0:18:42.95,0:18:46.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Hei. Putuskan saja hubungan dengannya.{\i0}
Dialogue: 0,0:18:48.16,0:18:51.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kukira aku akan lebih lega\N‎setelah resmi jadi pacarnya,{\i0}
Dialogue: 0,0:18:51.75,0:18:53.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎tapi sejak mulai berpacaran,{\i0}
Dialogue: 0,0:18:53.50,0:18:56.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎selalu saja terpikirkan,\N‎"Kapan dia akan minta putus?"{\i0}
Dialogue: 0,0:18:56.92,0:19:01.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku takut dia akan bilang,\N‎"Ternyata aku tak bisa melupakannya."{\i0}
Dialogue: 0,0:19:03.05,0:19:05.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Mereka satu angkatan dan satu kelas.{\i0}
Dialogue: 0,0:19:05.97,0:19:09.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kesempatan mereka untuk bicara\N‎lebih banyak daripada aku.{\i0}
Dialogue: 0,0:19:09.06,0:19:13.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Bagaimana kalau mereka makin dekat\N‎saat aku tak ada?{\i0}
Dialogue: 0,0:19:15.02,0:19:17.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Bagaimana kalau dia tak membalas pesanku{\i0}
Dialogue: 0,0:19:17.94,0:19:22.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎karena sedang bicara\N‎atau bertemu dengannya?{\i0}
Dialogue: 0,0:19:23.32,0:19:26.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku terus memikirkan hal yang tak berguna.{\i0}
Dialogue: 0,0:19:27.54,0:19:29.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sampai sini saja tak apa?
Dialogue: 0,0:19:29.20,0:19:30.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya. Terima kasih.
Dialogue: 0,0:19:31.50,0:19:32.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sampai jumpa.
Dialogue: 0,0:19:32.71,0:19:37.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kukira pacaran dengan cowok yang kusukai\N‎akan membuatku bahagia.{\i0}
Dialogue: 0,0:19:38.59,0:19:39.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baiklah.
Dialogue: 0,0:19:40.76,0:19:43.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Bukankah ini waktu yang tepat\N‎untuk berciuman?{\i0}
Dialogue: 0,0:19:43.72,0:19:44.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kencan berikutnya...
Dialogue: 0,0:19:44.85,0:19:46.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ayo pergi menonton film.
Dialogue: 0,0:19:46.68,0:19:48.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ada film yang ingin kau tonton itu.
Dialogue: 0,0:19:48.68,0:19:50.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ayo!
Dialogue: 0,0:19:50.73,0:19:53.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Minato memang pacar yang sempurna,{\i0}
Dialogue: 0,0:19:54.69,0:20:00.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎tapi selalu aku yang memulai kontak fisik\N‎atau membicarakan perasaan.{\i0}
Dialogue: 0,0:20:00.90,0:20:01.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Mulai lagi.{\i0}
Dialogue: 0,0:20:02.49,0:20:06.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku tak bisa menebak isi pikirannya\N‎saat ekspresinya begini.{\i0}
Dialogue: 0,0:20:07.62,0:20:10.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku mulai paham seiring berjalannya waktu.{\i0}
Dialogue: 0,0:20:10.95,0:20:15.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dia menutup rapat hatinya.{\i0}
Dialogue: 0,0:20:15.88,0:20:19.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dia membuka dirinya sampai batas tertentu,{\i0}
Dialogue: 0,0:20:19.21,0:20:21.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎tapi aku tak bisa lebih dekat lagi.{\i0}
Dialogue: 0,0:20:23.63,0:20:25.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Eh? Kalian berempat?
Dialogue: 0,0:20:26.14,0:20:29.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya. Bukannya aku sudah bilang?
Dialogue: 0,0:20:29.01,0:20:32.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kukira kau pergi\N‎dengan kelompok yang sama saat festival.
Dialogue: 0,0:20:32.14,0:20:33.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Memang hampir sama.
Dialogue: 0,0:20:33.52,0:20:35.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya, tapi...
Dialogue: 0,0:20:39.27,0:20:40.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ini.
Dialogue: 0,0:20:40.90,0:20:44.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku tak mau terus mencemaskan\N‎hal-hal kecil seperti ini.{\i0}
Dialogue: 0,0:20:44.57,0:20:46.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa menurutmu\N‎aku tipe orang yang selingkuh?
Dialogue: 0,0:20:47.53,0:20:50.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Sekarang kaulah pacarku, Momoka.
Dialogue: 0,0:20:50.91,0:20:53.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Kalau ada yang mengganggumu,\N‎aku ingin memperbaikinya.
Dialogue: 0,0:20:54.04,0:20:55.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau ingin aku melakukan apa untukmu?
Dialogue: 0,0:20:57.50,0:20:59.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dia berusaha menghadapi ini dengan serius.{\i0}
Dialogue: 0,0:21:00.63,0:21:02.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dia berusaha memenuhi keinginanku.{\i0}
Dialogue: 0,0:21:04.55,0:21:07.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Semua kecemasan dan kekuranganmu.\N‎Keinginanku terus muncul.{\i0}
Dialogue: 0,0:21:10.76,0:21:12.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sebesar apa pun perhatiannya padaku,{\i0}
Dialogue: 0,0:21:12.81,0:21:18.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎aku merasa dia baik-baik saja tanpaku,\N‎dan itu menyakitkan.{\i0}
Dialogue: 0,0:21:20.27,0:21:21.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Minato.
Dialogue: 0,0:21:21.69,0:21:24.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bisa beri tahu alasanmu putus\N‎dengan semua mantan pacarmu?
Dialogue: 0,0:21:26.07,0:21:28.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau ingin tahu masa laluku?
Dialogue: 0,0:21:28.03,0:21:29.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Kau tak keberatan?\N‎- Tidak.
Dialogue: 0,0:21:30.20,0:21:34.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku ingin tahu kenapa bisa gagal\N‎agar bisa kuhindari.
Dialogue: 0,0:21:35.00,0:21:39.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mereka semua yang minta putus padaku,\N‎jadi kurasa tak akan membantu.
Dialogue: 0,0:21:39.79,0:21:41.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Benarkah?
Dialogue: 0,0:21:41.09,0:21:43.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya. Makanya...
Dialogue: 0,0:21:43.84,0:21:47.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yang harus berusaha lebih keras\N‎itu bukan kau, tapi aku.
Dialogue: 0,0:21:49.34,0:21:50.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku paham.{\i0}
Dialogue: 0,0:21:51.31,0:21:53.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Bukan cuma karena dia selalu dicampakkan.{\i0}
Dialogue: 0,0:21:54.81,0:21:58.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dia tak sanggup memutuskan hubungan\N‎atau menolak orang lain.{\i0}
Dialogue: 0,0:21:59.44,0:22:01.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dia takut dianggap sebagai orang jahat.{\i0}
Dialogue: 0,0:22:02.98,0:22:05.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Filmnya mau dimulai. Ayo masuk sekarang.
Dialogue: 0,0:22:06.61,0:22:07.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kalau begitu...{\i0}
Dialogue: 0,0:22:09.36,0:22:10.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Minato.
Dialogue: 0,0:22:12.62,0:22:14.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak akan minta putus.
Dialogue: 0,0:22:15.29,0:22:16.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau yakin?
Dialogue: 0,0:22:18.17,0:22:19.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya!
Dialogue: 0,0:22:21.75,0:22:24.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku tak akan pernah melepaskanmu.{\i0}
Dialogue: 0,0:23:50.84,0:23:55.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Terjemahan subtitle oleh Shoffanny R
