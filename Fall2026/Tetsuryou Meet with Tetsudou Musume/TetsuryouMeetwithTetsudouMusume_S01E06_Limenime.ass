Dialogue: 0,0:16:48.24,0:16:50.65,sign,,0000,0000,0000,,STASIUN MISAKIGUCHI\NSTASIUN TUNA MISAKI
Dialogue: 0,0:16:53.07,0:16:53.84,sign,,0000,0000,0000,,KEDAI TUNA UOGASHI
Dialogue: 0,0:16:53.85,0:16:55.46,sign,,0000,0000,0000,,KEDAI TUNA UOGASHI
