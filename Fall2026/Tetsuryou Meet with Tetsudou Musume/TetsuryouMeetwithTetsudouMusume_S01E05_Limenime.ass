Dialogue: 0,0:22:16.98,0:22:19.78,sign,,0000,0000,0000,,(Stasiun Matsuura)
Dialogue: 0,0:22:19.78,0:22:24.70,sign,,0000,0000,0000,,(Pasar Ikan Matsuura)
Dialogue: 0,0:22:28.16,0:22:32.24,sign,,0000,0000,0000,,(Kota Matsuura - Nishiura)
Dialogue: 0,0:00:04.15,0:00:06.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuacanya indah.
Dialogue: 0,0:00:07.28,0:00:11.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kodama sama Ushio\Nhari ini datang enggak, ya?
Dialogue: 0,0:00:12.25,0:00:17.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mereka enggak datang,\Ndi sini sepi banget, ya.
Dialogue: 0,0:00:21.01,0:00:25.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mumpung sudah di sini,\Naku harus melakukan sesuatu.
Dialogue: 0,0:00:25.03,0:00:27.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi ngapain, ya?
Dialogue: 0,0:00:27.01,0:00:29.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pas begini, Kodama pasti...
Dialogue: 0,0:00:30.12,0:00:31.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau berbekal jadwal kereta,
Dialogue: 0,0:00:31.85,0:00:36.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita bisa bepergian dengan mudah dan bebas\Nke jalur mana pun, sejauh apa pun!
Dialogue: 0,0:00:36.43,0:00:38.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misalnya, trem Kota Hakodate ini.
Dialogue: 0,0:00:38.85,0:00:42.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan ke Hokkaido pun,\Nkita bisa langsung melesat ke sana!
Dialogue: 0,0:00:42.06,0:00:46.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan imajinasi, musim pun bisa seketika\Nberubah menjadi hamparan salju putih!
Dialogue: 0,0:00:46.98,0:00:48.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba pejamkan matamu,
Dialogue: 0,0:00:48.65,0:00:54.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bayangkan trem Hakodate nomor 812\Nberwarna hijau mint bergaya klasik
Dialogue: 0,0:00:54.58,0:00:57.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang melaju anggun di jalan...
Dialogue: 0,0:01:05.34,0:01:07.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelan-pelan saja.
Dialogue: 0,0:01:07.80,0:01:10.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, baik, terima kasih, ya.
Dialogue: 0,0:01:19.93,0:01:21.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Ushio bakal...
Dialogue: 0,0:01:22.97,0:01:25.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di Tokorozawa ada pameran\Nkotak bekal kereta!
Dialogue: 0,0:01:25.72,0:01:27.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan begini bisa bikin video!
Dialogue: 0,0:01:27.86,0:01:29.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini, lihat!
Dialogue: 0,0:01:29.69,0:01:34.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bekal Ninja ini bisa dipesan di Stasiun Kusatsu,\NJalur Utama Tokaido!
Dialogue: 0,0:01:34.28,0:01:35.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu dibuka...
Dialogue: 0,0:01:35.33,0:01:38.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah! Ada shuriken! Lucunya!
Dialogue: 0,0:01:38.62,0:01:41.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, ada Bekal Manusia Salju\Ndari Stasiun Niigata!
Dialogue: 0,0:01:41.62,0:01:45.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bekal Kereta Dokter Yellow seri 923\Ndari Stasiun Shin-Osaka!
Dialogue: 0,0:01:45.71,0:01:48.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Edisi khusus bekal kemasan unik!
Dialogue: 0,0:01:49.28,0:01:52.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin bisa menghabiskannya...
Dialogue: 0,0:01:52.35,0:01:56.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak gitu, harusnya\Naku mikir kegiatan klub!
Dialogue: 0,0:03:33.48,0:03:35.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal jarak hubungan sama senior, ya...
Dialogue: 0,0:03:35.90,0:03:39.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini juga enggak tahu harus ngobrol apa...
Dialogue: 0,0:03:48.19,0:03:50.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Anu... Fotonya bagus, ya?
Dialogue: 0,0:03:50.51,0:03:53.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Ah, terima kasih.
Dialogue: 0,0:03:57.72,0:04:01.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya kami menghabiskan\Nwaktu sendiri-sendiri.
Dialogue: 0,0:04:02.64,0:04:07.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau senior yang lain lulus,\Nkamu tinggal berdua dengan dia, 'kan?
Dialogue: 0,0:04:07.33,0:04:09.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti gimana, dong?
Dialogue: 0,0:04:09.01,0:04:11.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya orangnya baik, kok.
Dialogue: 0,0:04:11.43,0:04:16.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama naik kereta bareng,\Ndia sering senyum.
Dialogue: 0,0:04:16.36,0:04:19.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku ingin lebih akrab.
Dialogue: 0,0:04:24.99,0:04:26.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan ini?
Dialogue: 0,0:04:27.50,0:04:31.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enaknya ngobrol apa sama Usa, ya?
Dialogue: 0,0:04:31.42,0:04:34.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin enggak bisa ngobrol karena cuma\Nmereka berdua di ruang klub hari ini?
Dialogue: 0,0:04:34.78,0:04:40.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat banget!\NGimana kalau nanti Misaki keluar klub?
Dialogue: 0,0:04:40.07,0:04:41.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak mungkin.
Dialogue: 0,0:04:41.86,0:04:44.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke! Besok kita juga mampir ke klub...
Dialogue: 0,0:04:44.14,0:04:45.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak boleh!
Dialogue: 0,0:04:45.72,0:04:48.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu cuma mau lari dari tugas saja, 'kan?
Dialogue: 0,0:04:48.14,0:04:51.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Usa itu anaknya penuh tanggung jawab...
Dialogue: 0,0:04:51.89,0:04:56.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dipaksa terus,\Ngimana kalau otaknya meledak?
Dialogue: 0,0:04:58.32,0:05:00.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Me-Meledak?!
Dialogue: 0,0:05:03.20,0:05:05.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Usa itu maniak retro.
Dialogue: 0,0:05:05.45,0:05:08.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ngobrol seputar itu,\Ndia pasti senang.
Dialogue: 0,0:05:09.08,0:05:10.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Retro!
Dialogue: 0,0:05:10.31,0:05:14.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa dia juga pergi ke tempat seperti itu\Nsama teman-temannya?
Dialogue: 0,0:05:14.75,0:05:18.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya, sih, dia biasanya\Npergi memotret sendirian!
Dialogue: 0,0:05:18.42,0:05:20.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Se-Sendirian, ya?
Dialogue: 0,0:05:21.64,0:05:24.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak perlu memaksakan\Npergi bareng, 'kan?
Dialogue: 0,0:05:24.47,0:05:27.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti kehabisan bahan obrolan\Njadi canggung.
Dialogue: 0,0:05:32.02,0:05:35.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai sekarang enggak\Nkepikiran ngobrol apa.
Dialogue: 0,0:05:35.89,0:05:38.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Se-Selamat siang!
Dialogue: 0,0:05:38.29,0:05:39.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat siang.
Dialogue: 0,0:05:40.40,0:05:43.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, kelihatan capek banget.
Dialogue: 0,0:05:43.32,0:05:46.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, apa lagi sibuk sama tugas?
Dialogue: 0,0:05:46.85,0:05:48.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, begitulah.
Dialogue: 0,0:05:48.29,0:05:50.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tahun kedua juga sudah berat, ya?
Dialogue: 0,0:05:50.91,0:05:54.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, bukan! Aku harusnya tanya\Nrencana akhir pekan, 'kan?!
Dialogue: 0,0:05:54.77,0:05:58.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Anu, Usa biasanya kalau akhir pekan...
Dialogue: 0,0:05:58.29,0:05:58.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini.
Dialogue: 0,0:05:58.95,0:05:59.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:05:59.96,0:06:02.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tur menjelajahi pojok Yokohama?
Dialogue: 0,0:06:02.88,0:06:04.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, ini...
Dialogue: 0,0:06:04.93,0:06:11.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kalau akhir pekan enggak ada kerja paruh waktu,\Nmau pergi bareng enggak?
Dialogue: 0,0:06:11.35,0:06:13.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan, kamu bergadang buat ini?
Dialogue: 0,0:06:13.95,0:06:16.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, iya...
Dialogue: 0,0:06:16.73,0:06:22.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin lebih akrab dengan Misaki.
Dialogue: 0,0:06:24.21,0:06:25.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang banget!
Dialogue: 0,0:06:26.82,0:06:30.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau wisata ini sama Usa\Nakhir pekan nanti!
Dialogue: 0,0:06:30.74,0:06:33.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be-Benarkah?
Dialogue: 0,0:06:33.16,0:06:35.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya! Ini di mana?
Dialogue: 0,0:06:35.56,0:06:37.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yokohama Seaside Line.
Dialogue: 0,0:06:37.19,0:06:38.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu monorel, ya?
Dialogue: 0,0:06:39.59,0:06:40.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:06:43.56,0:06:48.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga awalnya mengira begitu,\Nsetelah mencari tahu ternyata agak berbeda.
Dialogue: 0,0:06:48.01,0:06:51.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga sudah menambahkan\Npenjelasannya di sini.
Dialogue: 0,0:06:53.24,0:06:56.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sa-Sampai selengkap ini?\NPasti repot menyiapkannya, ya?
Dialogue: 0,0:06:57.03,0:07:01.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena aku memikirkan mau main sama Misaki,\Njadi terasa ringan.
Dialogue: 0,0:07:06.74,0:07:10.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, kereta dengan ban karet.
Dialogue: 0,0:07:10.37,0:07:14.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemudi otomatis?!\NAda banyak sekali rekomendasinya...
Dialogue: 0,0:07:16.27,0:07:18.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Niat banget cari tahu detailnya.
Dialogue: 0,0:07:18.64,0:07:21.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa balas apa ke Usa, ya?
Dialogue: 0,0:07:21.88,0:07:22.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke!
Dialogue: 0,0:07:32.96,0:07:34.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat pagi!
Dialogue: 0,0:07:34.47,0:07:35.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pagi!
Dialogue: 0,0:07:35.62,0:07:36.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak tersesat, 'kan?
Dialogue: 0,0:07:36.79,0:07:39.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkat buku panduan dari Usa, jadi aman!
Dialogue: 0,0:07:41.47,0:07:42.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, ayo berangkat.
Dialogue: 0,0:07:42.86,0:07:43.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo!
Dialogue: 0,0:07:50.27,0:07:51.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau beli tiket?
Dialogue: 0,0:07:51.47,0:07:56.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, iya. Sekalian di sini, aku ingin\Nmenyimpannya untuk kenang-kenangan.
Dialogue: 0,0:07:56.04,0:07:58.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti tiket terusan waktu itu.
Dialogue: 0,0:07:58.81,0:08:02.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiket biasa nanti diambil\Ndi gerbang tiket, lo!
Dialogue: 0,0:08:02.00,0:08:06.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya? Kodama bilang\Nsuka koleksi tiket...
Dialogue: 0,0:08:06.35,0:08:08.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang bisa saya bantu?
Dialogue: 0,0:08:08.08,0:08:09.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah!
Dialogue: 0,0:08:13.68,0:08:18.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, eng, saya ingin membeli tiket,\Nlalu membawanya pulang setelah digunakan.
Dialogue: 0,0:08:18.21,0:08:20.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tujuan Anda ke mana?
Dialogue: 0,0:08:20.43,0:08:22.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shin-Sugita.
Dialogue: 0,0:08:22.15,0:08:26.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ke Shin-Sugita,\Nada petugas stasiun yang berjaga di sana.
Dialogue: 0,0:08:26.31,0:08:29.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan sampaikan keinginan Anda\Nke petugas loket tanpa melewati gerbang tiket.
Dialogue: 0,0:08:31.32,0:08:32.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak!
Dialogue: 0,0:08:32.74,0:08:34.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga perjalanan Anda menyenangkan!
Dialogue: 0,0:08:34.69,0:08:35.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:08:44.55,0:08:47.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lumayan ramai, ya?
Dialogue: 0,0:08:47.03,0:08:49.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya jalur ini menuju ke akuarium.
Dialogue: 0,0:08:49.40,0:08:52.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, benar juga.\NAku pernah ke sana waktu karyawisata.
Dialogue: 0,0:08:52.53,0:08:54.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Pernah ke sini?
Dialogue: 0,0:08:54.35,0:08:55.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lupa-lupa ingat, sih.
Dialogue: 0,0:08:55.97,0:08:59.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak terlalu ingat soal stasiun ini.
Dialogue: 0,0:08:59.39,0:09:05.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eng, stasiun ini pernah direnovasi dan diganti\Nbangunan stasiun baru sekitar tahun 2019.
Dialogue: 0,0:09:05.36,0:09:07.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin itu sebabnya kamu tidak ingat.
Dialogue: 0,0:09:07.40,0:09:08.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu...
Dialogue: 0,0:09:09.69,0:09:11.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah datang!
Dialogue: 0,0:09:12.24,0:09:14.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo antre, Usa!
Dialogue: 0,0:09:14.69,0:09:17.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu. Bukan yang itu,\Ntapi yang di sana.
Dialogue: 0,0:09:18.15,0:09:20.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tujuan utama kita hari ini.
Dialogue: 0,0:09:23.00,0:09:26.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah! Dapat kursi di pojok!
Dialogue: 0,0:09:26.37,0:09:31.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena ini kereta otonom, barisan paling depan\Ndapat melihat pemandangan dengan leluasa.
Dialogue: 0,0:09:31.91,0:09:35.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misaki bilang suka pojokan, 'kan?
Dialogue: 0,0:09:36.03,0:09:39.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, itu maksudnya tur pojok, ya?
Dialogue: 0,0:09:42.45,0:09:44.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar enggak ada relnya.
Dialogue: 0,0:09:44.92,0:09:48.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di buku panduan juga tertulis\Nkalau kereta ini pakai ban karet, ya?
Dialogue: 0,0:09:48.61,0:09:52.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya. Katanya di Yurikamome juga\Nmenggunakan sistem yang sama.
Dialogue: 0,0:09:52.00,0:09:53.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah!
Dialogue: 0,0:09:53.32,0:09:57.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yurikamome itu yang menuju\NOdaiba dan sekitarnya, 'kan?
Dialogue: 0,0:09:57.27,0:09:59.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belum pernah naik itu.
Dialogue: 0,0:10:03.67,0:10:07.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keren banget!\NSeperti kita yang mengemudikannya!
Dialogue: 0,0:10:07.59,0:10:11.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena enggak ada kabel listrik di atasnya,\Nlangitnya kelihatan jelas, ya.
Dialogue: 0,0:10:11.51,0:10:14.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Usa! Lautnya kelihatan, lo!
Dialogue: 0,0:10:14.79,0:10:18.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu pulau yang ada akuariumnya, ya?
Dialogue: 0,0:10:19.87,0:10:21.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mau, duduk di sini.
Dialogue: 0,0:10:23.19,0:10:24.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih!
Dialogue: 0,0:10:24.77,0:10:26.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, maaf merepotkan.
Dialogue: 0,0:10:26.35,0:10:28.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak apa-apa, aku sudah\Ncukup puas lihat pemandangannya.
Dialogue: 0,0:10:29.31,0:10:31.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemandangan dari sini\Nkeren banget, 'kan?
Dialogue: 0,0:10:31.72,0:10:33.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kereta berangkat!
Dialogue: 0,0:10:33.37,0:10:35.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah jadi kondektur, ya?
Dialogue: 0,0:10:35.16,0:10:37.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, jadi masinisnya.
Dialogue: 0,0:10:37.17,0:10:38.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, masa?
Dialogue: 0,0:10:38.93,0:10:42.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, kalau berkenan,\NIbu juga silakan duduk.
Dialogue: 0,0:10:42.73,0:10:44.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, saya tidak usah...
Dialogue: 0,0:10:44.37,0:10:48.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti lebih menyenangkan jika punya\Nkenangan pemandangan yang sama.
Dialogue: 0,0:10:48.79,0:10:51.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, saya terima tawarannya.
Dialogue: 0,0:10:53.37,0:10:57.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebentar lagi, Namiki-Kita.\NNamiki-Kita!
Dialogue: 0,0:10:57.64,0:11:01.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebentar lagi, kita akan tiba\Ndi Namiki-Lita. Namiki-Kita.
Dialogue: 0,0:11:02.76,0:11:04.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, tahu enggak?
Dialogue: 0,0:11:04.31,0:11:09.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di jalur Seaside Line cuma Stasiun Namiki-Kita\Nyang ada di permukaan tanah, lo!
Dialogue: 0,0:11:09.25,0:11:11.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah! Kamu tahu banyak, ya!
Dialogue: 0,0:11:11.23,0:11:14.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak ini setiap minggu naik kereta ini.
Dialogue: 0,0:11:14.64,0:11:16.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Profesor ahli kereta, dong!
Dialogue: 0,0:11:17.41,0:11:20.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus, kereta ini enggak pakai rel.
Dialogue: 0,0:11:20.85,0:11:24.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana caranya\Nmengubah arah di titik percabangan?
Dialogue: 0,0:11:24.33,0:11:26.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, iya juga.\NKok bisa begitu, ya?
Dialogue: 0,0:11:26.73,0:11:28.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu jawab 3 detik!
Dialogue: 0,0:11:28.36,0:11:30.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, singkat banget!
Dialogue: 0,0:11:30.25,0:11:34.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Dua... Satu... Waktu habis!\N- Eh... Anu... Apa, ya...
Dialogue: 0,0:11:34.12,0:11:35.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jawabannya...
Dialogue: 0,0:11:35.34,0:11:41.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kereta berbelok dengan cara mengaitkan\Nroda kecil pada rel di arah tujuan beloknya!
Dialogue: 0,0:11:41.64,0:11:45.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih telah menggunakan layanan kami.\NKita telah tiba di stasiun terakhir, Shin-Sugita.
Dialogue: 0,0:11:45.93,0:11:48.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai! Cepat sekali, ya!
Dialogue: 0,0:11:49.19,0:11:51.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak-kakak, makasih, ya!
Dialogue: 0,0:11:51.00,0:11:54.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makasih juga sudah menjelaskan\Nbanyak hal, ya, Profesor.
Dialogue: 0,0:11:54.35,0:11:55.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dadah!
Dialogue: 0,0:11:56.45,0:11:59.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dadah!\NSampai jumpa!
Dialogue: 0,0:11:59.80,0:12:01.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misaki keren, ya.
Dialogue: 0,0:12:01.97,0:12:04.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Ini pertama kalinya\Nada yang puji aku begitu!
Dialogue: 0,0:12:05.25,0:12:09.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu cepat akrab\Nsama orang lain. Aku iri.
Dialogue: 0,0:12:09.96,0:12:14.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak begitu.\NAku juga sering cemas, kok.
Dialogue: 0,0:12:14.17,0:12:15.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan hari ini juga...
Dialogue: 0,0:12:15.27,0:12:15.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:12:15.92,0:12:16.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah!
Dialogue: 0,0:12:17.38,0:12:20.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sering buat orang lain\Nmerasa sungkan...
Dialogue: 0,0:12:20.15,0:12:21.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu-Bukan begitu!
Dialogue: 0,0:12:21.99,0:12:26.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku takut Usa merasa bosan bersamaku saja\Ndibanding saat bersama yang lain.
Dialogue: 0,0:12:26.85,0:12:32.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga berpikir cara balas budi\Nke Usa yang selama ini baik.
Dialogue: 0,0:12:32.77,0:12:35.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baik?
Dialogue: 0,0:12:35.48,0:12:38.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, waktu pertama kali juga...
Dialogue: 0,0:12:39.20,0:12:42.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Usa yang menyapaku duluan\Nsaat aku meringkuk sendirian.
Dialogue: 0,0:12:42.87,0:12:47.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bukan karena Usa, aku mungkin\Nenggak mengenal Klub Tetsuryo.
Dialogue: 0,0:12:49.71,0:12:54.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah! Usa, bukankah itu karakter\Nyang ada di buku panduan?
Dialogue: 0,0:12:55.11,0:12:57.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini karakter yang ada di sampulnya, 'kan?
Dialogue: 0,0:12:57.85,0:12:59.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kira-kira☆Shi-tan.
Dialogue: 0,0:12:59.31,0:13:01.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus dapat Shi-tan!
Dialogue: 0,0:13:05.69,0:13:07.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shi-tan kayak mau kabur.
Dialogue: 0,0:13:08.61,0:13:10.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ritsletingnya enggak mau ditutup.
Dialogue: 0,0:13:10.71,0:13:15.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, di buku tertulis kalau\Ntujuan berikutnya ditentukan hari ini, ’kan?
Dialogue: 0,0:13:15.97,0:13:19.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya. Sepertinya kurang baik\Nkalau kuputuskan sendiri semuanya.
Dialogue: 0,0:13:19.90,0:13:23.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mau, boleh pakai rencanaku?
Dialogue: 0,0:13:23.78,0:13:24.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:13:30.03,0:13:32.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Museum Trem Kota Yokohama.
Dialogue: 0,0:13:32.05,0:13:36.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sini kita bisa melihat langsung kereta\Nyang dulu beroperasi di Yokohama!
Dialogue: 0,0:13:36.49,0:13:39.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kupikir Usa pasti suka tempat seperti ini.
Dialogue: 0,0:13:39.57,0:13:41.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kamu cari tahu karena aku?
Dialogue: 0,0:13:41.55,0:13:47.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, aku sendiri enggak tahu ke mana,\Njadi aku minta saran dari senior.
Dialogue: 0,0:13:47.47,0:13:52.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, tadi aku\Nsama Usa juga heboh 'kan?
Dialogue: 0,0:13:54.15,0:13:58.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya! Aku pikir kita bisa\Nbersenang-senang berdua di sini!
Dialogue: 0,0:13:58.47,0:14:00.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, aku senang banget.
Dialogue: 0,0:14:00.99,0:14:02.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo masuk ke dalam!
Dialogue: 0,0:14:02.53,0:14:03.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya...
Dialogue: 0,0:14:05.49,0:14:09.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah! Keren!
Dialogue: 0,0:14:11.33,0:14:12.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Usa!
Dialogue: 0,0:14:12.87,0:14:14.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa masuk ke dalam juga, lo!
Dialogue: 0,0:14:14.67,0:14:15.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke.
Dialogue: 0,0:14:20.01,0:14:21.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalamnya lucu banget!
Dialogue: 0,0:14:21.92,0:14:26.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nuansa klasiknya sangat berlawanan\Nsama kereta otomatis tadi!
Dialogue: 0,0:14:30.64,0:14:34.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Usa, ini juga unik dan lucu!
Dialogue: 0,0:14:34.94,0:14:38.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa wajah dan tangannya\Nmalah digambar, ya?
Dialogue: 0,0:14:40.01,0:14:44.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dulu kursi masinisnya sedekat ini, ya?
Dialogue: 0,0:14:44.17,0:14:45.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba duduk!
Dialogue: 0,0:14:45.92,0:14:46.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:14:46.62,0:14:49.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau memotret Misaki yang mengemudi.
Dialogue: 0,0:14:52.25,0:14:56.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah! Tuasnya sedikit.\NApa cukup tarik ini agar keretanya jalan?
Dialogue: 0,0:14:56.75,0:14:58.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersiap, ya!
Dialogue: 0,0:14:59.07,0:15:01.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kereta berangkat!
Dialogue: 0,0:15:04.67,0:15:06.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, sekarang gilirannya Usa.
Dialogue: 0,0:15:06.61,0:15:07.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:15:08.01,0:15:12.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, dari sudut ini bagian dalamnya\Njuga kelihatan. Hasilnya bagus!
Dialogue: 0,0:15:12.09,0:15:13.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, kok?
Dialogue: 0,0:15:14.61,0:15:16.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku sudah tekan tombolnya.
Dialogue: 0,0:15:17.23,0:15:21.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ditekan setengah, akan mengatur fokus.\NBegitu terdengar bunyi bip, tekan kuat.
Dialogue: 0,0:15:21.90,0:15:23.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:15:23.82,0:15:25.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan segera kuhapus.
Dialogue: 0,0:15:25.71,0:15:26.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu.
Dialogue: 0,0:15:27.53,0:15:29.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu juga bagian dari kenangan kita.
Dialogue: 0,0:15:30.96,0:15:32.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:15:32.95,0:15:35.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, bilang "kereta berangkat"!
Dialogue: 0,0:15:35.80,0:15:36.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:15:36.93,0:15:40.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke-Kereta berangkat!
Dialogue: 0,0:15:42.34,0:15:45.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ulang! Malunya masih kelihatan!
Dialogue: 0,0:15:45.03,0:15:47.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah puas, jadi enggak apa apa.
Dialogue: 0,0:15:49.26,0:15:51.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah! Benaran jalan keretanya!
Dialogue: 0,0:15:51.66,0:15:54.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berhasil mengemudikannya, Usa!
Dialogue: 0,0:15:54.44,0:15:56.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misaki, ingat stasiunnya.
Dialogue: 0,0:15:56.07,0:15:56.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:16:02.36,0:16:04.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mengemudi harus tetap fokus.
Dialogue: 0,0:16:04.91,0:16:09.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini lumayan susah, lo!\NUsa coba dulu, nanti paham!
Dialogue: 0,0:16:10.43,0:16:14.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita sudah dekat stasiun... Sebentar lagi!
Dialogue: 0,0:16:18.72,0:16:19.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah!
Dialogue: 0,0:16:19.84,0:16:22.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak yang ini payah, deh!
Dialogue: 0,0:16:26.80,0:16:31.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah! Ada toko kecil juga!
Dialogue: 0,0:16:31.72,0:16:35.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu gedung yang terlihat\Ndari dalam kereta, ya?
Dialogue: 0,0:16:35.17,0:16:37.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kereta biru yang di sana apa?
Dialogue: 0,0:16:37.71,0:16:39.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Blue Line.
Dialogue: 0,0:16:39.06,0:16:41.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namanya keren!
Dialogue: 0,0:16:41.39,0:16:45.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu kecil, aku pernah ditolong\Nsama petugas kereta itu.
Dialogue: 0,0:16:46.23,0:16:46.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:16:49.40,0:16:53.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang sekali karena bisa pergi jauh\Nsendirian untuk pertama kalinya.
Dialogue: 0,0:16:53.87,0:16:56.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi begitu sampai, ternyata semuanya\Nenggak berjalan sesuai harapan.
Dialogue: 0,0:17:08.41,0:17:10.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kameranya keren sekali, ya!
Dialogue: 0,0:17:11.48,0:17:14.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anda berencana pergi ke mana?
Dialogue: 0,0:17:14.87,0:17:17.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}K-Ke Kishamichi.
Dialogue: 0,0:17:17.40,0:17:18.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:17:18.98,0:17:23.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ki-Kishamichi itu bukan di Stasiun Yokohama,\Nmelainkan di Stasiun Sakuragicho.
Dialogue: 0,0:17:27.31,0:17:30.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah! Tapi karena sudah\Ntelanjur turun di sini...
Dialogue: 0,0:17:31.33,0:17:37.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mau, mau saya rekomendasikan\Nbeberapa tempat foto menarik di sekitar sini?
Dialogue: 0,0:17:40.37,0:17:41.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya...
Dialogue: 0,0:17:41.54,0:17:46.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu itu aku sedih dan kecewa karena gagal.\NTapi petugas itu tetap baik sekali kepadaku.
Dialogue: 0,0:17:46.88,0:17:49.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah! Keren banget!
Dialogue: 0,0:17:49.80,0:17:52.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya. Keren, 'kan?
Dialogue: 0,0:17:52.48,0:17:56.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga berharap suatu hari nanti\Nbisa menjadi orang sepertinya...
Dialogue: 0,0:17:56.37,0:17:58.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Usa juga sudah keren, kok!
Dialogue: 0,0:17:58.79,0:17:59.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:18:01.45,0:18:06.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Usa! Usa! Lihat, pemandangan\Ndi sebelah sini juga bagus, lo!
Dialogue: 0,0:18:08.44,0:18:11.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Graah!
Dialogue: 0,0:18:12.88,0:18:15.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si monster santai Misa-gon.
Dialogue: 0,0:18:15.21,0:18:16.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:18:17.65,0:18:18.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Graah!
Dialogue: 0,0:18:18.83,0:18:19.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:18:21.09,0:18:22.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Graah!
Dialogue: 0,0:18:29.41,0:18:34.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya, pada masa perang, pernah ada masa\Nketika perempuan juga bekerja sebagai masinis.
Dialogue: 0,0:18:34.05,0:18:36.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seragamnya lucu begini?
Dialogue: 0,0:18:36.52,0:18:39.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keretanya jadi ramai\Nkarena banyak penggemarnya.
Dialogue: 0,0:19:14.42,0:19:16.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, ada susu rasa buah!
Dialogue: 0,0:19:16.69,0:19:19.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu susu yang cuma kulihat\Ndi pemandian umum.
Dialogue: 0,0:19:24.09,0:19:26.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seru banget bisa\Nmengunjungi banyak tempat!
Dialogue: 0,0:19:26.64,0:19:28.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senang, deh, kita jadi datang!
Dialogue: 0,0:19:29.07,0:19:31.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, ini.
Dialogue: 0,0:19:31.96,0:19:33.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu foto stiker yang tadi kita ambil, ya?
Dialogue: 0,0:19:33.80,0:19:35.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh aku jadikan gambar latar ponselku?
Dialogue: 0,0:19:35.87,0:19:39.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serius? Padahal biasanya\Nlatarmu foto kucing...
Dialogue: 0,0:19:39.13,0:19:40.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pengin pakai ini.
Dialogue: 0,0:19:40.69,0:19:42.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga mau pakai latar yang sama.
Dialogue: 0,0:19:49.58,0:19:51.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya mau bikin konten apa, ya?
Dialogue: 0,0:19:51.79,0:19:54.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kantongku kering\Nsampai penghasilan masuk.
Dialogue: 0,0:19:54.25,0:19:57.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, bagaimana kalau kali ini\Nbikin panduan cara menikmati jadwal kereta?
Dialogue: 0,0:19:57.92,0:20:00.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi sejauh ini fokusnya konten kuliner.
Dialogue: 0,0:20:00.47,0:20:05.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Museum Kereta Api di Omiya!\NBanyak banget kereta yang berjejer di sana!
Dialogue: 0,0:20:06.19,0:20:09.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ke Museum Kereta Bawah Tanah,\Ntinggal masukkan tiket di gerbang tiket.
Dialogue: 0,0:20:09.91,0:20:13.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari segi pengalaman dan biaya,\Npilihan ini lebih realistis!
Dialogue: 0,0:20:13.07,0:20:17.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi mumpung wisata, lebih seru\Nkalau naik kereta yang belum dicoba, 'kan?
Dialogue: 0,0:20:17.99,0:20:22.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mempelajari kereta yang biasa kita naiki\Njuga bisa jadi pengalaman menarik, lo.
Dialogue: 0,0:20:23.33,0:20:25.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka lagi ngapain?
Dialogue: 0,0:20:25.95,0:20:29.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu pertarungan sengit yang dipicu\Noleh cinta mereka pada kereta.
Dialogue: 0,0:20:29.15,0:20:29.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh...
Dialogue: 0,0:20:30.44,0:20:34.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, sejak kapan\Nmereka berdua jadi akrab banget begitu?
Dialogue: 0,0:20:34.21,0:20:37.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya. Sepertinya mereka\Nmenikmati waktu bersama.
Dialogue: 0,0:20:39.36,0:20:42.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oi, oi! Kalian lagi ngobrol tentang\Nsesuatu yang kelihatannya seru, nih!
Dialogue: 0,0:20:42.89,0:20:44.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami juga gabung, dong!
Dialogue: 0,0:20:44.39,0:20:46.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ushio! Kodama!
Dialogue: 0,0:22:19.78,0:22:23.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah meluangkan\Nwaktu untuk hari ini.
Dialogue: 0,0:22:23.11,0:22:24.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa,\Nsama-sama.
Dialogue: 0,0:22:25.48,0:22:28.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, pakaian apa itu?
Dialogue: 0,0:22:28.16,0:22:32.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya pilih pakaian ini supaya bisa membaur\Ndengan suasana Pasar Ikan Matsuura.
Dialogue: 0,0:22:32.62,0:22:36.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi entah kenapa warnanya\Nmalah terlihat ceria dan imut.
Dialogue: 0,0:22:36.85,0:22:38.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini imut, 'kan?
Dialogue: 0,0:22:39.25,0:22:41.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si-Silau sekali...
Dialogue: 0,0:22:44.05,0:22:48.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ikan kembung goreng yang akan\Ndisajikan di kereta juga dipasok dari sini.
Dialogue: 0,0:22:48.76,0:22:50.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah!
Dialogue: 0,0:22:51.39,0:22:55.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}15, 15, 15, 15, 15!\NOke, 20, 20, 20, 20!
Dialogue: 0,0:22:55.73,0:23:00.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, 30! 30, 30, 30!\NAda lagi? Tidak ada lagi? Oke, nomor 19!
Dialogue: 0,0:23:00.11,0:23:03.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, aku ingin semua orang bisa\Nmelihat pemandangan ini!
Dialogue: 0,0:23:03.79,0:23:06.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Andai saja kereta wisatanya\Nbisa sampai ke sini!
Dialogue: 0,0:23:06.60,0:23:11.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, keretanya\Nharus beroperasi semalaman, dong.
Dialogue: 0,0:23:11.04,0:23:14.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi! Bolehkah saya mendengar\Nlebih banyak cerita dari Anda?
Dialogue: 0,0:23:14.71,0:23:19.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya ingin memahami tempat ini\Nsupaya orang yang belum pernah ke sini
Dialogue: 0,0:23:19.68,0:23:21.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa membayangkannya lewat cerita saya!
Dialogue: 0,0:23:23.13,0:23:25.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon bantuannya!
Dialogue: 0,0:23:26.41,0:23:29.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu suka boneka, ya?\NSoalnya lucu dan empuk.
Dialogue: 0,0:23:29.22,0:23:30.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga suka.
Dialogue: 0,0:23:30.35,0:23:31.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Usa?
Dialogue: 0,0:23:31.47,0:23:33.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenyal dan empuk.
Dialogue: 0,0:23:33.03,0:23:35.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh! Tolong kembali kemari!
Dialogue: 0,0:23:35.02,0:23:37.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya, "Misaki akan Berjuang\NSendiri Sesekali!"
Dialogue: 0,0:23:37.69,0:23:40.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, bagaimana\Nbiasanya mereka menentukan rute?
