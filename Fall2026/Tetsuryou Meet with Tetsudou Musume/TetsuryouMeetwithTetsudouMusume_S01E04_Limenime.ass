Dialogue: 0,0:12:54.68,0:12:57.05,sign,,0000,0000,0000,,(Gantungan Kunci Kereta Wisata Watarase Keikoku)
Dialogue: 0,0:13:31.33,0:13:34.24,sign,,0000,0000,0000,,(Kotak Bekal Kereta Wisata Semiterbuka)
Dialogue: 0,0:13:43.18,0:13:45.43,sign,,0000,0000,0000,,(Kotak Bekal Kereta Wisata Semiterbuka)
Dialogue: 0,0:15:02.88,0:15:05.00,sign,,0000,0000,0000,,(Restoran Kereta Api)
Dialogue: 0,0:16:51.36,0:16:53.28,sign,,0000,0000,0000,,(Ashio - Kota Nikko Prefektur Tochigi)
Dialogue: 0,0:17:18.56,0:17:19.89,sign,,0000,0000,0000,,(Ashio)
Dialogue: 0,0:18:05.23,0:18:06.76,sign,,0000,0000,0000,,(Seiryu - Kereta Bersantai)
Dialogue: 0,0:18:06.77,0:18:10.68,sign,,0000,0000,0000,,(Restoran Kereta Api - Seiryuu)
Dialogue: 0,0:18:25.13,0:18:28.80,sign,,0000,0000,0000,,(Selamat Datang - Buka)
Dialogue: 0,0:18:52.24,0:18:53.64,sign,,0000,0000,0000,,(Tempat Keluar Tiket)
Dialogue: 0,0:19:00.33,0:19:01.57,sign,,0000,0000,0000,,(Kereta Wisata Semiterbuka\NWatarase Keikoku - Handuk Tangan)
Dialogue: 0,0:19:49.08,0:19:53.37,sign,,0000,0000,0000,,(Museum Pelestarian Trem Yokohama)
Dialogue: 0,0:21:54.00,0:21:56.00,sign,,0000,0000,0000,,(Stasiun Emukae-Shikamachi)
Dialogue: 0,0:00:05.32,0:00:08.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hujannya deras banget!
Dialogue: 0,0:00:12.62,0:00:14.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kodama?
Dialogue: 0,0:00:14.76,0:00:16.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bakal ada bencana besar.
Dialogue: 0,0:00:16.79,0:00:17.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:00:18.75,0:00:21.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ushio... Ushio...
Dialogue: 0,0:00:25.21,0:00:30.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa aku kumpul tugas tepat waktu,\Ndianggap bakal ada bencana besar, sih?!
Dialogue: 0,0:00:30.89,0:00:33.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya kelakuanmu sehari-hari...
Dialogue: 0,0:00:33.32,0:00:35.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sifatmu yang kayak gitu menyebalkan, Usa!
Dialogue: 0,0:00:35.64,0:00:39.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa? Apa yang terjadi?
Dialogue: 0,0:00:39.06,0:00:43.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma enggak mau waktu akhir pekanku\Nhabis buat ngerjain tugas. Itu doang!
Dialogue: 0,0:00:49.79,0:00:50.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini...
Dialogue: 0,0:00:50.95,0:00:53.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari Kereta Api Watarase Keikoku.
Dialogue: 0,0:00:53.62,0:00:56.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiket kereta wisata semiterbuka.
Dialogue: 0,0:00:56.88,0:00:59.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}'Kan aku sudah janji.
Dialogue: 0,0:01:00.75,0:01:02.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu juga baca suasana, dong!
Dialogue: 0,0:01:02.96,0:01:06.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Anggap saja hadiah ulang tahun.
Dialogue: 0,0:01:06.27,0:01:08.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi mau ikut atau enggak?
Dialogue: 0,0:01:08.30,0:01:12.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jelas ikut, dong!\NTerima kasih, Ushio!
Dialogue: 0,0:01:12.83,0:01:13.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, berhenti!
Dialogue: 0,0:01:13.72,0:01:16.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rambutku berantakan!
Dialogue: 0,0:01:16.51,0:01:17.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak baik!
Dialogue: 0,0:03:04.97,0:03:05.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi!
Dialogue: 0,0:03:07.37,0:03:09.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duh, dingin banget.
Dialogue: 0,0:03:09.37,0:03:12.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini benar gantungnya di luar?
Dialogue: 0,0:03:25.81,0:03:28.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sip, sudah balik normal.
Dialogue: 0,0:03:30.65,0:03:33.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ushio! Sudah pagi!
Dialogue: 0,0:03:35.77,0:03:38.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Usa kayaknya mau pergi\Nke daerah Yokohama.
Dialogue: 0,0:03:38.44,0:03:42.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Misaki bagaimana, ya?\NHari ini kerja paruh waktu, 'kan?
Dialogue: 0,0:03:42.74,0:03:44.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entahlah...
Dialogue: 0,0:03:45.65,0:03:47.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Kok direkam?
Dialogue: 0,0:03:47.41,0:03:51.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini kami berkumpul sejak pagi\Nuntuk pergi naik kereta Watarase Keikoku.
Dialogue: 0,0:03:51.99,0:03:57.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai balasan hadiah ulang tahun,\Nkupikir sekalian tambah satu perjalanan lagi.
Dialogue: 0,0:03:58.75,0:04:01.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mumpung di sini,\Nwisata kuliner sepuasnya.
Dialogue: 0,0:04:01.76,0:04:04.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibarat sekali dayung\Ndua pulau terlampaui.
Dialogue: 0,0:04:05.48,0:04:08.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harusnya aku bawa jas hujan...
Dialogue: 0,0:04:08.69,0:04:09.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:04:09.77,0:04:13.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya, aku belum pernah\Nlihat Kodama sebaik ini.
Dialogue: 0,0:04:16.11,0:04:17.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Batal, deh.
Dialogue: 0,0:04:17.64,0:04:20.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh! Bercanda, Kodama!
Dialogue: 0,0:04:24.12,0:04:26.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya sampai di Kiryuu.
Dialogue: 0,0:04:26.83,0:04:29.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Habis ini pindah ke kereta...
Dialogue: 0,0:04:29.25,0:04:34.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiket kita 'kan terusan sehari,\Ntinggal ke peron nomor satu di seberang sana!
Dialogue: 0,0:04:35.00,0:04:37.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, praktis, ya!
Dialogue: 0,0:04:37.15,0:04:41.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi tiket reservasi kursinya\Nenggak perlu ditunjukkan di gerbang tiket?
Dialogue: 0,0:04:41.18,0:04:45.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiket reservasi kereta wisatanya ditukar\Nsaat kita turun di Stasiun Omama.
Dialogue: 0,0:04:45.60,0:04:48.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, simpan dulu baik-baik, ya.
Dialogue: 0,0:04:48.60,0:04:49.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:04:50.40,0:04:53.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, hari ini kita bakal\Nketemu kereta yang mana, ya?
Dialogue: 0,0:04:53.75,0:04:57.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadinya kayak aku yang diajak jalan-jalan.
Dialogue: 0,0:04:57.75,0:05:01.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, enggak begitu! Meski aku pernah\Nnaik kereta reguler Watetsu Keikoku,
Dialogue: 0,0:05:01.55,0:05:04.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi baru kali ini aku\Nnaik kereta semiterbuka.
Dialogue: 0,0:05:04.32,0:05:05.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula,
Dialogue: 0,0:05:06.81,0:05:10.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}masih ada kereta yang belum kutemui.
Dialogue: 0,0:05:12.72,0:05:17.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}WKT-501 dengan perpaduan\Nwarna merah tua dan putih gading,
Dialogue: 0,0:05:17.87,0:05:21.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dihiasi garis emas di bawah jendelanya.
Dialogue: 0,0:05:21.09,0:05:23.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh patut disyukuri.
Dialogue: 0,0:05:23.69,0:05:25.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang dulu enggak begini?
Dialogue: 0,0:05:25.76,0:05:29.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beda! Dulu dengan seri W89,
Dialogue: 0,0:05:29.16,0:05:33.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}warnanya merah tua\Ndan matanya yang bulat jadi lucu!
Dialogue: 0,0:05:33.19,0:05:36.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada pegangan di pintunya juga, bagus, lo!
Dialogue: 0,0:05:36.61,0:05:39.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu juga salah satu daya tarik imutnya.
Dialogue: 0,0:05:39.90,0:05:44.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita baru tahu naik kereta seri apa\Ndi hari keberangkatan.
Dialogue: 0,0:05:44.16,0:05:47.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kejutan yang membahagiakan!
Dialogue: 0,0:05:51.99,0:05:54.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu jadi kayak Misaki.
Dialogue: 0,0:05:54.46,0:05:58.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ada kesempatan lihat sedekat ini,\Nya pasti aku lihat, dong.
Dialogue: 0,0:05:58.32,0:06:00.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat juga, Ushio!
Dialogue: 0,0:06:00.76,0:06:04.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya lagi! Rasanya kayak aku\Nyang mengemudikan keretanya!
Dialogue: 0,0:06:04.28,0:06:06.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, 'kan? Iya, 'kan?
Dialogue: 0,0:06:08.34,0:06:12.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bangunan stasiunnya kayu!\NUsa pasti suka, deh!
Dialogue: 0,0:06:14.14,0:06:15.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pasti bilang "suka" sampai 10 kali.
Dialogue: 0,0:06:15.99,0:06:20.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya, Stasiun Omama terdaftar\Ndalam cagar budaya, lo.
Dialogue: 0,0:06:20.19,0:06:24.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya sudah ada sejak Zaman Meiji.
Dialogue: 0,0:06:24.03,0:06:26.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, tempat penukaran tiketnya di sana, ya?
Dialogue: 0,0:06:28.59,0:06:30.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pesan dua tiket, ya.
Dialogue: 0,0:06:31.64,0:06:33.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih telah\Nmenggunakan layanan kami.
Dialogue: 0,0:06:34.45,0:06:36.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:06:36.83,0:06:40.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau lihat-lihat\Ngedung stasiunnya dulu, Ushio.
Dialogue: 0,0:06:40.37,0:06:42.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, boleh.
Dialogue: 0,0:06:43.12,0:06:44.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hati-hati!
Dialogue: 0,0:06:44.56,0:06:47.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak sabar makan bekal keretanya, ya?
Dialogue: 0,0:06:47.07,0:06:49.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, aku sengaja enggak sarapan.
Dialogue: 0,0:06:50.89,0:06:54.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi! Apa di stasiun ini\Nbisa beli bekal kereta?
Dialogue: 0,0:06:54.99,0:07:00.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anda bisa membelinya di kereta wisata,\Napakah Anda sudah melakukan pemesanan?
Dialogue: 0,0:07:00.02,0:07:03.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ha-Harus pesan dulu, ya?
Dialogue: 0,0:07:03.69,0:07:08.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa pesan di hari keberangkatan\Nkalau masih ada stoknya,
Dialogue: 0,0:07:08.32,0:07:11.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi penumpang yang sudah memesan satu hari\Nsebelumnya akan diprioritaskan.
Dialogue: 0,0:07:11.87,0:07:13.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?!
Dialogue: 0,0:07:15.52,0:07:18.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau stoknya masih ada,\NAnda bisa pesan, kok!
Dialogue: 0,0:07:23.04,0:07:26.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemandangan yang menyisakan nuansa\Nzaman Kereta Api Nasional Jepang.
Dialogue: 0,0:07:27.72,0:07:29.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kenapa, Ushio?
Dialogue: 0,0:07:29.95,0:07:35.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cerobohnya aku.\NAku lupa buat pesan bekal kereta.
Dialogue: 0,0:07:35.33,0:07:40.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jumlahnya terbatas\Njadi bisa saja enggak kebagian.
Dialogue: 0,0:07:40.27,0:07:43.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan rekam aku pas lagi sedih begini, dong!
Dialogue: 0,0:07:43.32,0:07:46.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, sudah aku kira akan begitu.
Dialogue: 0,0:07:46.72,0:07:50.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang, aku sudah pesan bekalnya, kok.
Dialogue: 0,0:07:50.27,0:07:51.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:07:51.28,0:07:57.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ingat tahun lalu, waktu kita mengadakan\Ntur wisata kuliner bekal kereta yang kamu atur?
Dialogue: 0,0:07:57.21,0:08:01.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu itu juga, Ushio sibuk menyuruh\Norang untuk mencicipi bekal.
Dialogue: 0,0:08:01.37,0:08:05.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai-sampai kamu lupa\Npesan bekal untuk diri sendiri.
Dialogue: 0,0:08:05.67,0:08:12.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi mikir, "Anak ini kalau sibuk ngurus orang,\Njadi lupa sama dirinya sendiri."
Dialogue: 0,0:08:12.18,0:08:16.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibuku juga bilang kalau kapasitas otakku kecil.
Dialogue: 0,0:08:16.85,0:08:23.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, sifat memprioritaskan\Norang lain itu jadi ciri khasmu, 'kan?
Dialogue: 0,0:08:23.16,0:08:25.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hup.
Dialogue: 0,0:08:28.20,0:08:31.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak paham\Nitu pujian atau hinaan, deh.
Dialogue: 0,0:08:33.24,0:08:35.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setengah-setengah, sih.
Dialogue: 0,0:08:36.83,0:08:38.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?!
Dialogue: 0,0:08:39.41,0:08:44.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, jarang-jarang\Nbisa lihat dari sudut ini, lo!
Dialogue: 0,0:08:44.27,0:08:46.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ushio, coba lihat!
Dialogue: 0,0:08:46.38,0:08:51.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gara-gara ada orang yang terlalu baik hati,\Naku jadi harus ikut turun tangan, tahu!
Dialogue: 0,0:08:51.64,0:08:52.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:08:52.33,0:08:55.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak apa-apa.\NCuma hinaan biasa.
Dialogue: 0,0:08:55.22,0:08:59.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jahat! Hari ini ulang tahunku,\Naku rajanya, tahu!
Dialogue: 0,0:08:59.94,0:09:01.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ciat!
Dialogue: 0,0:09:01.57,0:09:05.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh! Berat!
Dialogue: 0,0:09:05.07,0:09:06.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kodama, kamu berat, tahu!
Dialogue: 0,0:09:06.99,0:09:10.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya! Di sini ada tiran!
Dialogue: 0,0:09:12.00,0:09:14.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurekam, ya!
Dialogue: 0,0:09:14.05,0:09:19.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik! Hari ini, di hari ulang tahun teman\Nyang selalu membantuku sebagai kamerawan,
Dialogue: 0,0:09:19.64,0:09:22.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami akan naik kereta\Nwisata semiterbuka!
Dialogue: 0,0:09:22.09,0:09:26.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di kereta wisata Watarase Keikoku,\Nada bekal kereta, jualan makanan di dalam kereta!
Dialogue: 0,0:09:26.67,0:09:29.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo langsung kita lihat!
Dialogue: 0,0:09:31.95,0:09:34.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih telah menaiki kereta kami.
Dialogue: 0,0:09:34.05,0:09:36.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon berhati-hati saat melangkah.
Dialogue: 0,0:09:36.10,0:09:39.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok ada orang yang mirip\Naktor Teater Takarazuka?
Dialogue: 0,0:09:39.31,0:09:41.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, seragamnya!\NApa dia kondekturnya?
Dialogue: 0,0:09:41.94,0:09:43.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keren banget!
Dialogue: 0,0:09:45.24,0:09:47.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan naik dengan hati-hati.
Dialogue: 0,0:09:47.86,0:09:50.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- I-Iya.\N- I-Iya.
Dialogue: 0,0:09:52.45,0:09:56.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mumpung di sini, aku mau rekam\Nsatu adegan dari tempat duduk.
Dialogue: 0,0:09:56.40,0:09:57.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh.
Dialogue: 0,0:09:57.37,0:10:01.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi usahakan jangan sampai\Npenumpang lain terekam.
Dialogue: 0,0:10:01.29,0:10:03.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untung kita dapat kursi di belakang.
Dialogue: 0,0:10:03.96,0:10:08.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bangku kayu di dalam kereta tuh\Nrasanya agak aneh, ya.
Dialogue: 0,0:10:08.65,0:10:12.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, bagus, tuh. Komentar buat\Norang yang pertama kali naik!
Dialogue: 0,0:10:12.32,0:10:13.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa jadi catatan teks di layar.
Dialogue: 0,0:10:14.39,0:10:17.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita rekam satu adegan.
Dialogue: 0,0:10:18.11,0:10:20.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sentuhan permukaan ini...
Dialogue: 0,0:10:20.55,0:10:22.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, selesai!
Dialogue: 0,0:10:22.02,0:10:23.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gimana?
Dialogue: 0,0:10:23.15,0:10:25.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, bagus.
Dialogue: 0,0:10:25.03,0:10:26.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah!
Dialogue: 0,0:10:26.69,0:10:28.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak T-tuber, ya?
Dialogue: 0,0:10:28.68,0:10:31.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya. Kamu suka T-tube?
Dialogue: 0,0:10:31.31,0:10:33.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sering nonton yang main gim.
Dialogue: 0,0:10:33.86,0:10:36.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus, yang suka gali banyak lubang juga.
Dialogue: 0,0:10:36.32,0:10:38.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang gali banyak lubang?
Dialogue: 0,0:10:38.58,0:10:42.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan yang menjatuhkan kamera\Nke tempat yang panjang banget itu?
Dialogue: 0,0:10:42.62,0:10:45.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya! Kalau Kakak bikin konten\Nyang kayak gimana?
Dialogue: 0,0:10:45.62,0:10:52.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kontenku naik berbagai kereta kayak gini\Nsambil memperkenalkan banyak makanan, lo.
Dialogue: 0,0:10:52.55,0:10:54.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayak Tsuutsu?
Dialogue: 0,0:10:54.60,0:10:58.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, tapi kalau konten makanan, Pikakin, ya.
Dialogue: 0,0:10:59.05,0:11:00.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tahu banget...
Dialogue: 0,0:11:00.85,0:11:05.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak, aku menempuh jalanku sendiri\Ndi T-tube dengan ciri khasku sendiri.
Dialogue: 0,0:11:05.87,0:11:07.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah!
Dialogue: 0,0:11:07.48,0:11:10.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanda tangan! Mumpung masih bisa,\Naku minta tanda tangannya!
Dialogue: 0,0:11:10.36,0:11:13.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke! Jangan lupa langganan kanalku, ya!
Dialogue: 0,0:11:15.65,0:11:19.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, maaf merepotkan.\NTerima kasih sudah meladeni anak saya.
Dialogue: 0,0:11:19.64,0:11:20.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.
Dialogue: 0,0:11:20.66,0:11:22.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dapat tanda tangan!
Dialogue: 0,0:11:22.33,0:11:24.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu dapat penggemar baru, ya.
Dialogue: 0,0:11:24.44,0:11:26.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semangatku jadi berlipat ganda.
Dialogue: 0,0:11:37.47,0:11:43.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih telah menggunakan\NKereta Wisata Watarase Keikoku hari ini.
Dialogue: 0,0:11:43.96,0:11:46.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini adalah kereta wisata semiterbuka...
Dialogue: 0,0:11:46.14,0:11:48.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang tadi, 'kan?
Dialogue: 0,0:11:48.12,0:11:50.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata memang kondektur, ya.
Dialogue: 0,0:11:50.56,0:11:55.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah meninggalkan Stasiun Omama,\Nkereta akan berhenti di Mizunuma, Godo, Sori,
Dialogue: 0,0:11:55.65,0:11:59.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tsudo, dan pemberhentian\Nterakhir di Ashio.
Dialogue: 0,0:12:00.17,0:12:02.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah! Kodama! Kodama!
Dialogue: 0,0:12:02.78,0:12:04.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Langitnya biru banget!
Dialogue: 0,0:12:04.99,0:12:08.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata jimat boneka penangkal hujannya\Nbenar-benar ampuh!
Dialogue: 0,0:12:14.97,0:12:16.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anginnya kencang banget, ya.
Dialogue: 0,0:12:16.87,0:12:20.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin pas masuk terowongan\Nlebih kencang lagi.
Dialogue: 0,0:12:21.03,0:12:22.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Orang yang tadi.
Dialogue: 0,0:12:23.12,0:12:24.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau pergi ke mana, ya?
Dialogue: 0,0:12:31.71,0:12:33.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:12:33.36,0:12:36.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kondektur juga melayani penjualan\Ndi dalam kereta, ya.
Dialogue: 0,0:12:36.84,0:12:39.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Multitugas, ya? Salut banget!
Dialogue: 0,0:12:39.72,0:12:41.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini jadi kesempatan buat ngobrol, lo.
Dialogue: 0,0:12:41.84,0:12:43.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?!
Dialogue: 0,0:12:44.95,0:12:48.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya ingin beli suvenir...
Dialogue: 0,0:12:48.23,0:12:52.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dua gantungan kunci akrilik\Nkereta Watarase Keikoku, ya.
Dialogue: 0,0:12:52.13,0:12:54.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, silakan suvenirnya.
Dialogue: 0,0:12:54.68,0:12:57.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh! Khas banget, ya!
Dialogue: 0,0:13:02.34,0:13:06.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi kita ngobrol kalau Kakak keren banget.
Dialogue: 0,0:13:06.75,0:13:08.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:13:08.43,0:13:13.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, kebetulan hari ini dia ulang tahun.\NApa kami bisa minta foto bareng Kakak?
Dialogue: 0,0:13:13.80,0:13:15.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu dulu, Ushio!
Dialogue: 0,0:13:15.67,0:13:17.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu, dengan senang hati.
Dialogue: 0,0:13:20.07,0:13:22.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Imut banget.
Dialogue: 0,0:13:22.20,0:13:24.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat, telinganya sampai merah.
Dialogue: 0,0:13:24.99,0:13:28.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ampun, deh!\NNanti minta kirim fotonya, ya.
Dialogue: 0,0:13:31.33,0:13:34.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sebagai ucapan terima kasih, ya.
Dialogue: 0,0:13:34.25,0:13:35.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:13:35.67,0:13:39.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau datang sendirian,\Nmungkin aku enggak bisa menyapa dia.
Dialogue: 0,0:13:39.83,0:13:43.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya kayak aku yang ulang tahun, deh.
Dialogue: 0,0:13:47.10,0:13:50.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah! Kelihatannya enak banget!
Dialogue: 0,0:13:50.11,0:13:51.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, langsung saja kita makan...
Dialogue: 0,0:13:51.95,0:13:53.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu dulu.
Dialogue: 0,0:13:54.15,0:13:56.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebelumnya, difoto dulu.
Dialogue: 0,0:13:57.07,0:13:58.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, iya juga.
Dialogue: 0,0:14:01.15,0:14:05.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, begitulah! Bekal kereta semiterbuka\Nsudah habis kusantap.
Dialogue: 0,0:14:05.85,0:14:08.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih atas makanannya.
Dialogue: 0,0:14:08.05,0:14:09.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, selesai.
Dialogue: 0,0:14:09.83,0:14:14.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau enggak diingatkan Kodama,\Naku pasti sudah lupa buat rekam.
Dialogue: 0,0:14:14.88,0:14:19.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar, kamu memang cuma\Nbisa fokus satu hal saja.
Dialogue: 0,0:14:19.25,0:14:21.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hmph!
Dialogue: 0,0:14:21.23,0:14:23.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi terima kasih, ya.
Dialogue: 0,0:14:23.13,0:14:27.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkat kamu, hari ini jadi seru banget.
Dialogue: 0,0:14:27.04,0:14:29.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau soal itu, Kodama juga...
Dialogue: 0,0:14:29.80,0:14:30.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:14:32.17,0:14:36.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya kamu yang kasih saran\Nkonten tentang bekal kereta.
Dialogue: 0,0:14:36.28,0:14:38.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kanalku jadi makin berkembang.
Dialogue: 0,0:14:40.90,0:14:43.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bakal ngerepotin kamu ke depannya.
Dialogue: 0,0:14:43.97,0:14:46.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, dengan senang hati.
Dialogue: 0,0:14:46.95,0:14:49.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asalkan imbalannya istimewa\Nkayak hari ini.
Dialogue: 0,0:15:02.88,0:15:05.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak banget!
Dialogue: 0,0:15:05.80,0:15:08.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jualan bekal langsung\Nselalu ada tiap hari?
Dialogue: 0,0:15:09.79,0:15:12.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kereta akan segera berangkat.
Dialogue: 0,0:15:13.17,0:15:17.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagi penumpang yang akan naik,\Nharap segera naik agar tidak tertinggal!
Dialogue: 0,0:15:17.87,0:15:20.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ushio! Cepat!
Dialogue: 0,0:15:20.48,0:15:22.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Iya!
Dialogue: 0,0:15:23.86,0:15:26.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebentar lagi mau lewat\Nterowongan Kusaki.
Dialogue: 0,0:15:26.78,0:15:28.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempat terkenal, ya?
Dialogue: 0,0:15:28.74,0:15:31.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Panjangnya lebih dari 5 kilometer, lo.
Dialogue: 0,0:15:31.51,0:15:34.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keretanya bakal melaju sekitar\N10 menit tanpa penerangan.
Dialogue: 0,0:15:34.37,0:15:36.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Bukannya seram?
Dialogue: 0,0:15:45.75,0:15:47.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba lihat, Ushio!
Dialogue: 0,0:15:55.10,0:15:59.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Khasnya kereta semiterbuka,\Nada iluminasi pas lewat terowongan.
Dialogue: 0,0:16:00.89,0:16:04.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya kayak lihat bintang benaran, ya!
Dialogue: 0,0:16:04.13,0:16:04.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:16:11.57,0:16:15.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini, kereta akan\Nmelewati tikungan Bando.
Dialogue: 0,0:16:15.79,0:16:20.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tikungan Bando adalah\Ntikungan tertajam nasional,
Dialogue: 0,0:16:20.45,0:16:23.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anda dapat menikmati pemandangan\Naliran air di hulu Sungai Watarase.
Dialogue: 0,0:16:23.71,0:16:28.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pantas saja, di sini laju\Nkeretanya lebih pelan, ya.
Dialogue: 0,0:16:28.31,0:16:32.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayaknya sengaja diperlambat\Npas lewat pemandangan indah.
Dialogue: 0,0:16:32.89,0:16:35.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelayanan terbaik.
Dialogue: 0,0:16:35.14,0:16:39.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau datang pas musim gugur\Npasti cantik banget.
Dialogue: 0,0:16:39.17,0:16:42.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya bakal sulit berebut tiketnya.
Dialogue: 0,0:16:44.33,0:16:45.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suaranya keras banget.
Dialogue: 0,0:16:46.48,0:16:48.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mirip suara di wahana taman bermain!
Dialogue: 0,0:16:48.79,0:16:49.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, ya...
Dialogue: 0,0:16:53.75,0:16:56.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih telah\Nmenggunakan layanan kami.
Dialogue: 0,0:16:56.57,0:16:58.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyenangkan sekali.
Dialogue: 0,0:17:02.67,0:17:06.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, stasiun ini kayak\Npunya sejarah panjang, ya.
Dialogue: 0,0:17:07.35,0:17:09.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul banget!
Dialogue: 0,0:17:09.01,0:17:14.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Stasiun Ashio ini juga terdaftar\Ndalam cagar budaya berwujud, lo.
Dialogue: 0,0:17:14.19,0:17:16.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo foto terus kirim ke Usa!
Dialogue: 0,0:17:29.15,0:17:32.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gimana, nih?\NMasih ada waktu juga.
Dialogue: 0,0:17:32.63,0:17:34.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau jalan-jalan di sekitar sini?
Dialogue: 0,0:17:34.57,0:17:39.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, mumpung punya tiket terusan,\Nada tempat yang ingin kukunjungi.
Dialogue: 0,0:17:47.63,0:17:51.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo? Ini tempat yang tadi kita\Nsinggahi pas naik kereta, 'kan?
Dialogue: 0,0:17:53.00,0:17:55.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tujuannya ada di peron\Nyang sebelah sini.
Dialogue: 0,0:17:57.26,0:18:00.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, mau naik kereta itu?
Dialogue: 0,0:18:00.32,0:18:03.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salah! Coba perhatikan baik-baik.
Dialogue: 0,0:18:06.77,0:18:10.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Ini ternyata restoran?
Dialogue: 0,0:18:10.69,0:18:14.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bekal kereta yang kita makan tadi,\Nkatanya dibuat di sini.
Dialogue: 0,0:18:14.83,0:18:17.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pantas ada yang jualan tadi.
Dialogue: 0,0:18:17.99,0:18:22.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga kamu enggak sadar\Nsoalnya lagi asyik sendiri.
Dialogue: 0,0:18:22.59,0:18:25.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makasih atas pengertiannya.
Dialogue: 0,0:18:25.13,0:18:28.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pintu masuknya kaya kafetaria biasa.
Dialogue: 0,0:18:29.25,0:18:31.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma desainnya yang\Nbentuk gerbong kereta?
Dialogue: 0,0:18:32.27,0:18:34.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu sampai lihat dalamnya.
Dialogue: 0,0:18:38.18,0:18:42.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah! Kelihatannya bisa jalan betulan!
Dialogue: 0,0:18:42.43,0:18:45.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, 'kan? Jadi bikin semangat, 'kan?
Dialogue: 0,0:18:45.31,0:18:51.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini kereta ekspres Tobu,\NDeluxe Romance Car Kegon!
Dialogue: 0,0:18:53.65,0:18:56.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kodama mau makan kari Watarase, 'kan?
Dialogue: 0,0:18:56.39,0:18:58.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ih, dasar!
Dialogue: 0,0:19:01.58,0:19:03.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat makan!
Dialogue: 0,0:19:04.51,0:19:08.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi sudah makan bekal kereta\Ndan sekarang makan lagi...
Dialogue: 0,0:19:08.73,0:19:11.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kodama sudah bisa makan banyak, ya?
Dialogue: 0,0:19:11.27,0:19:14.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sudah lulus nanti, aku sudah\Nenggak bisa nekat kayak gini lagi.
Dialogue: 0,0:19:14.84,0:19:16.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:19:16.68,0:19:21.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selagi ada si tukang makan,\Naku juga ingin menikmatinya.
Dialogue: 0,0:19:21.93,0:19:25.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teori apaan, sih?\NKedengaran manis, tapi menyebalkan.
Dialogue: 0,0:19:25.81,0:19:27.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bagi punyaku,\Ntapi aku minta satu suap, dong!
Dialogue: 0,0:19:28.00,0:19:30.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harusnya sama daging juga, 'kan?
Dialogue: 0,0:19:30.27,0:19:32.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya potongannya lebih gede.
Dialogue: 0,0:19:32.09,0:19:34.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang ulang tahun!
Dialogue: 0,0:19:37.24,0:19:39.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih atas makanannya.
Dialogue: 0,0:19:44.13,0:19:47.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Mereka berdua hari ini barengan, ya?
Dialogue: 0,0:19:47.85,0:19:49.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelihatan seru!
Dialogue: 0,0:19:49.08,0:19:53.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga mereka berdua juga\Nterus akrab kayak gini, ya.
Dialogue: 0,0:19:56.37,0:19:58.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berdua juga? Juga?
Dialogue: 0,0:19:58.67,0:20:01.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ih, jangan main gelitik, dong!
Dialogue: 0,0:20:12.00,0:20:15.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujung-ujungnya malah enggak jelas\Nini hadiah ulang tahun atau bukan.
Dialogue: 0,0:20:17.11,0:20:20.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, kita coba lagi lain kali.
Dialogue: 0,0:20:24.04,0:20:29.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Subtitle provided by:\NYuramedia Link
Dialogue: 0,0:20:29.24,0:20:32.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penerjemah: Rasyid Yudhanto Kurniawan\NTiming: Bayu Surya Perdana\NPemeriksa Akhir: Nail Basalamah
Dialogue: 0,0:21:56.67,0:21:58.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat siang.
Dialogue: 0,0:21:58.92,0:22:02.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah paket nasi karinya masih ada?
Dialogue: 0,0:22:02.22,0:22:06.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, Arisa! Tentu saja masih ada.
Dialogue: 0,0:22:10.52,0:22:14.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka bersarang di mana-mana.
Dialogue: 0,0:22:14.25,0:22:17.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Bagaimana kalau kena pelanggan?
Dialogue: 0,0:22:18.37,0:22:20.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kejadian tiap tahun.
Dialogue: 0,0:22:20.40,0:22:25.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka sudah susah payah bikin sarang,\Nkasihan kalau sampai diganggu.
Dialogue: 0,0:22:25.37,0:22:29.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka juga bikin sarang di sini\Nkarena suka tempat ini, 'kan?
Dialogue: 0,0:22:29.65,0:22:34.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama saja dengan kita.\NAda tetangga yang menggemaskan.
Dialogue: 0,0:22:38.88,0:22:43.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang bisa dipromosikan\Nlewat kereta wisata, ya?
Dialogue: 0,0:22:43.04,0:22:48.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sekitar sini, mungkin bisa\Nke Taman Alam Serangga Tabira.
Dialogue: 0,0:22:48.69,0:22:51.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jauh-jauh ke Nagasaki\Nbuat menangkap serangga?
Dialogue: 0,0:22:51.47,0:22:54.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mending cari ikan buat dimakan, 'kan?
Dialogue: 0,0:22:54.65,0:22:59.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Andai semua orang\Nbisa dengar obrolan ini.
Dialogue: 0,0:22:59.19,0:23:03.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku suka sekali kota ini\Ndan ingin berbagi banyak hal tentangnya.
Dialogue: 0,0:23:03.39,0:23:07.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mereka bisa memahami\Nperasaan itu juga, pasti...
Dialogue: 0,0:23:08.20,0:23:13.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf menyela pas lagi keren-kerennya,\Ntapi ada nasi yang nempel di wajahmu.
Dialogue: 0,0:23:13.04,0:23:14.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:23:18.33,0:23:22.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gimana kalo semuanya juga lihat\Nekspresi Arisa yang barusan?
Dialogue: 0,0:23:22.45,0:23:26.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ja-Jangan, dong!
Dialogue: 0,0:23:26.01,0:23:28.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keren! Ini kereta semiterbuka?
Dialogue: 0,0:23:28.51,0:23:29.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hasilnya bagus, 'kan?
Dialogue: 0,0:23:29.76,0:23:32.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, banyak banget teks di layarnya...
Dialogue: 0,0:23:32.81,0:23:34.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini wajib banget.
Dialogue: 0,0:23:35.52,0:23:38.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya, "Aku Tidak Mau Canggung Terus!"
Dialogue: 0,0:23:38.15,0:23:41.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga ingin bisa seperti ini bersama Usa…
