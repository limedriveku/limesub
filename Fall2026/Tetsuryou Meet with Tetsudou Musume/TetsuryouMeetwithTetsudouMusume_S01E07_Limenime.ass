Dialogue: 0,0:00:00.98,0:00:03.77,sign,,0000,0000,0000,,(Klub Pencinta Wisata Kereta Api)
Dialogue: 0,0:00:56.04,0:01:01.87,sign,,0000,0000,0000,,(Ayo wisata ke Kinugawa naik Spacia X yang populer!)
Dialogue: 0,0:01:01.87,0:01:11.09,sign,,0000,0000,0000,,(Kampanye Ikuti dan Bagikan)
Dialogue: 0,0:01:22.56,0:01:26.24,sign,,0000,0000,0000,,(Klub Pencinta Wisata Kereta Api)
Dialogue: 0,0:01:43.08,0:01:46.59,sign,,0000,0000,0000,,(TETSURYO! Bertemu dengan Gadis Kereta Api)
Dialogue: 0,0:01:55.80,0:01:58.89,sign,,0000,0000,0000,,(Sata Misaki)
Dialogue: 0,0:01:58.89,0:02:02.10,sign,,0000,0000,0000,,(Harutachi Usa)
Dialogue: 0,0:02:02.10,0:02:04.98,sign,,0000,0000,0000,,(Yagami Ushio)
Dialogue: 0,0:02:04.98,0:02:08.19,sign,,0000,0000,0000,,(Orihara Kodama)
Dialogue: 0,0:02:59.45,0:03:02.04,sign,,0000,0000,0000,,(Episode 7 Aku Ingin Membuat Lebih Banyak Kenangan!)
Dialogue: 0,0:03:02.04,0:03:04.71,sign,,0000,0000,0000,,(Aku menang undian Spacia X Wisata ke Kinugawa!!!)
Dialogue: 0,0:03:25.47,0:03:27.14,sign,,0000,0000,0000,,(Aku menang undian)
Dialogue: 0,0:03:56.38,0:03:58.43,sign,,0000,0000,0000,,(Kereta Api Tobu - Stasiun Asakusa)
Dialogue: 0,0:05:56.88,0:05:59.05,sign,,0000,0000,0000,,(Konter kafe di gerbong 1 Spacia X diprioritaskan bagi penumpang\Nyang memiliki tiket reservasi kursi di gerbong 1 dan gerbong 6)
Dialogue: 0,0:06:59.56,0:07:02.00,sign,,0000,0000,0000,,(PT Kereta Api Tobu - Kepala Bagian Depo Awak\NKereta Kasukabe - Kunigawa Miyabi)
Dialogue: 0,0:16:05.44,0:16:08.41,sign,,0000,0000,0000,,(Onsen Kinugawa\NTobu World Square - Taman Kinugawa)
Dialogue: 0,0:17:16.89,0:17:20.37,sign,,0000,0000,0000,,(Masinis)
Dialogue: 0,0:17:27.94,0:17:30.36,sign,,0000,0000,0000,,(Onsen)
Dialogue: 0,0:20:10.56,0:20:13.71,sign,,0000,0000,0000,,(Onsen)
Dialogue: 0,0:20:16.49,0:20:18.91,sign,,0000,0000,0000,,(Stasiun Kinugawa Onsen)
Dialogue: 0,0:22:25.35,0:22:28.12,sign,,0000,0000,0000,,(Kari Arita-yaki)
Dialogue: 0,0:22:28.12,0:22:31.71,sign,,0000,0000,0000,,(Pusat Oleh-oleh Stasiun Arita)
Dialogue: 0,0:22:36.96,0:22:40.38,sign,,0000,0000,0000,,(Kedai Tezuka)
Dialogue: 0,0:00:01.98,0:00:03.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Magang?
Dialogue: 0,0:00:03.77,0:00:07.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, semacam kegiatan yang dilakukan\Nsebelum mulai mencari pekerjaan.
Dialogue: 0,0:00:07.33,0:00:11.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita mencoba bekerja di sebuah perusahaan\Nuntuk mengetahui seperti apa pekerjaan di sana.
Dialogue: 0,0:00:11.41,0:00:14.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ushio pergi magang juga?
Dialogue: 0,0:00:15.20,0:00:17.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belum tahu mau cari kerja atau tidak.
Dialogue: 0,0:00:17.91,0:00:19.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya enggak enak\Nkalau cuma melihat-lihat.
Dialogue: 0,0:00:19.71,0:00:23.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kemungkinan selama liburan musim panas,\Nselain kamp pelatihan di Kyushu,
Dialogue: 0,0:00:23.51,0:00:26.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku belum tahu masih bisa datang\Nke kegiatan klub atau tidak.
Dialogue: 0,0:00:27.41,0:00:30.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Kok begitu...
Dialogue: 0,0:00:30.24,0:00:33.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya, setelah pergi ke Kyushu,\Nkamu juga pensiun dari klub...
Dialogue: 0,0:00:33.88,0:00:35.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang, sih, tapi...
Dialogue: 0,0:00:35.69,0:00:36.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak setuju!
Dialogue: 0,0:00:36.97,0:00:38.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mi-Misaki?
Dialogue: 0,0:00:38.72,0:00:42.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, sampai liburan musim panas nanti,\Naku mau banyak main bareng kalian!
Dialogue: 0,0:00:42.44,0:00:43.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:00:43.77,0:00:48.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang, sih, tapi kamu harus\Nhemat uang sampai kamp pelatihan, 'kan?
Dialogue: 0,0:00:48.71,0:00:51.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku juga ingin ikut.
Dialogue: 0,0:00:51.12,0:00:52.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai Usa juga?
Dialogue: 0,0:00:52.62,0:00:56.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke! Kalau begitu,\Nbagaimana kalau kita coba ini?!
Dialogue: 0,0:00:56.04,0:00:59.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang Kereta Api Tobu\Nsedang mengadakan kampanye.
Dialogue: 0,0:00:59.11,0:01:01.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada undian berhadiah\Nundangan tur mewah sehari!
Dialogue: 0,0:01:01.87,0:01:05.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ke Kinugawa Onsen dengan\NSpacia X dan SL Taiju!
Dialogue: 0,0:01:05.50,0:01:08.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kereta Uap SL?!\NAku ingin mencobanya!
Dialogue: 0,0:01:08.95,0:01:11.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan sudah kutulis\Ndi buku catatan keinginanku!
Dialogue: 0,0:01:11.09,0:01:14.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah! Pulangnya naik\NKereta Ekspres Liberty, ya?
Dialogue: 0,0:01:14.51,0:01:15.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menarik juga.
Dialogue: 0,0:01:15.51,0:01:18.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi ini terbatas untuk\Nlima kelompok pemenang.
Dialogue: 0,0:01:18.19,0:01:20.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Te-Tergantung keberuntungan...
Dialogue: 0,0:01:20.24,0:01:21.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku mau.
Dialogue: 0,0:01:21.96,0:01:22.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:01:22.56,0:01:26.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke! Ayo kita tunjukkan kuatnya\Nikatan persahabatan kita!
Dialogue: 0,0:02:59.45,0:03:02.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata tetap gagal, ya?
Dialogue: 0,0:03:02.04,0:03:04.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak orang yang mengunggah kabar\Nkalau mereka menang.
Dialogue: 0,0:03:04.71,0:03:07.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak mungkin\Nmenang segampang itu, 'kan?
Dialogue: 0,0:03:07.25,0:03:09.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi kenangan bersama senior...
Dialogue: 0,0:03:09.59,0:03:13.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski nanti sudah berhenti dari kegiatan klub,\Nmasih ada waktu sampai mereka lulus, kok.
Dialogue: 0,0:03:13.80,0:03:15.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja, masih ada kesempatan.
Dialogue: 0,0:03:17.43,0:03:21.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misaki beruntung sekali bisa bertemu\Ndengan para senior yang baik, ya.
Dialogue: 0,0:03:22.81,0:03:24.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menang.
Dialogue: 0,0:03:24.02,0:03:25.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menang undiannya.
Dialogue: 0,0:03:25.97,0:03:27.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?!
Dialogue: 0,0:03:28.52,0:03:31.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu hebat banget, Usa!
Dialogue: 0,0:03:32.13,0:03:37.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tur sehari ke Pemandian Air Panas Kinugawa\Ndengan Spacia X dan SL Taiju.
Dialogue: 0,0:03:37.61,0:03:41.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membayangkan saja\Nsudah membuatku berdebar!
Dialogue: 0,0:03:42.89,0:03:46.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu mencari informasi sebelum ikut undian,\Naku sempat mencari tahu banyak hal.
Dialogue: 0,0:03:46.00,0:03:49.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata di dalam keretanya\Nada kafe dan sofa, ya!
Dialogue: 0,0:03:51.54,0:03:53.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak sabar!
Dialogue: 0,0:04:01.22,0:04:04.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eng, harus ke mana?
Dialogue: 0,0:04:07.67,0:04:09.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang bisa saya bantu?
Dialogue: 0,0:04:14.45,0:04:17.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Anu, saya punya reservasi tiket Spacia X.
Dialogue: 0,0:04:17.53,0:04:18.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh!
Dialogue: 0,0:04:18.28,0:04:24.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peron paling ujung di sebelah kiri\Nmerupakan peron khusus Spacia X.
Dialogue: 0,0:04:24.70,0:04:26.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah!
Dialogue: 0,0:04:26.25,0:04:30.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada jam-jam seperti ini, peron tersebut\Nkebetulan tertutup rangkaian kereta ekspres.
Dialogue: 0,0:04:30.95,0:04:33.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, jika berkenan,\Nmasih ada waktu sebelum keberangkatan.
Dialogue: 0,0:04:33.85,0:04:38.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan menikmati pemandangan\Ndesain peron jalur 5 dengan leluasa.
Dialogue: 0,0:04:44.97,0:04:47.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh! Itu dia, datang juga!
Dialogue: 0,0:04:48.32,0:04:53.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Misaki! Seharusnya kita buat janji\Ndi jalur kereta yang biasa kamu gunakan.
Dialogue: 0,0:04:53.21,0:04:56.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa, kok!\NJaraknya dekat, tapi aku malah tersesat.
Dialogue: 0,0:04:56.78,0:05:00.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebentar lagi keretanya datang.\NAyo! Hari ini juga di pojok!
Dialogue: 0,0:05:01.65,0:05:02.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:05:08.00,0:05:09.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah!
Dialogue: 0,0:05:09.91,0:05:13.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keretanya datang! Jendelanya imut!
Dialogue: 0,0:05:17.75,0:05:19.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesannya modern banget!
Dialogue: 0,0:05:20.09,0:05:22.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lampunya punya bentuk yang unik, ya?
Dialogue: 0,0:05:22.87,0:05:24.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, kamu jeli sekali!
Dialogue: 0,0:05:24.99,0:05:30.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lampu depan dan lampu belakang\NSpacia X menggunakan 39 LED.
Dialogue: 0,0:05:30.23,0:05:34.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan mengubah jumlah LED menyala,\Nlampunya bisa ganti antara lampu jauh dan dekat!
Dialogue: 0,0:05:34.94,0:05:39.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada dasarnya, sepanjang hari\Nsemua lampu menyala
Dialogue: 0,0:05:39.92,0:05:42.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}agar kereta yang datang terlihat jelas.
Dialogue: 0,0:05:42.49,0:05:45.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, saat berpapasan\Ndengan kereta dari arah berlawanan,
Dialogue: 0,0:05:45.32,0:05:48.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}terkadang lampunya\Ndiredupkan menjadi lampu dekat
Dialogue: 0,0:05:48.61,0:05:51.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}agar tidak menyilaukan masinis kereta.
Dialogue: 0,0:05:51.16,0:05:55.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beda dengan mengendarai mobil,\Nlampunya tetap dinyalakan seharian, ya.
Dialogue: 0,0:05:55.42,0:05:56.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh!
Dialogue: 0,0:05:59.05,0:06:01.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya, bentuk jendela gerbong 1 dan 6
Dialogue: 0,0:06:01.76,0:06:05.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}terinspirasi dari kerajinan\Nanyaman bambu Zaman Edo.
Dialogue: 0,0:06:06.43,0:06:08.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keren banget! Kayak hotel!
Dialogue: 0,0:06:08.80,0:06:12.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah! Rasanya seperti di alam mimpi!
Dialogue: 0,0:06:12.48,0:06:15.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku ingin melihat-lihat semuanya.
Dialogue: 0,0:06:15.02,0:06:17.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya aku cuma\Npernah naik kelas standar.
Dialogue: 0,0:06:17.49,0:06:21.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya, kita taruh barang bawaan dulu!\NNanti keretanya keburu berangkat!
Dialogue: 0,0:06:28.48,0:06:31.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mewahnya sampai bikin aku\Nkehabisan kata-kata.
Dialogue: 0,0:06:32.19,0:06:34.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ambil sofa besar ini!
Dialogue: 0,0:06:34.01,0:06:35.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah! Curang!
Dialogue: 0,0:06:35.42,0:06:40.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku mau tempat yang bisa\Nmelihat ruang masinis!
Dialogue: 0,0:06:40.00,0:06:41.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ruang masinis! Ruang masinis!\N- Siapa cepat, dia dapat!
Dialogue: 0,0:06:41.84,0:06:43.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Hati-hati, Misaki. Bahaya kalau terburu-buru!\N- Kalau begitu, aku duduk di sebelahmu!
Dialogue: 0,0:06:44.24,0:06:45.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, iya.
Dialogue: 0,0:06:49.88,0:06:51.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi.
Dialogue: 0,0:06:52.01,0:06:57.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini, saya bertugas sebagai kondektur\Nkereta ini, nama saya Kinugawa Miyabi.
Dialogue: 0,0:06:57.65,0:06:59.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ko-Kondektur?!
Dialogue: 0,0:07:02.88,0:07:04.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kartu nama kondektur...
Dialogue: 0,0:07:04.90,0:07:05.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Langka banget!
Dialogue: 0,0:07:05.90,0:07:10.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena keperluan tugas, saya mungkin\Nperlu keluar-masuk gerbong beberapa kali.
Dialogue: 0,0:07:10.21,0:07:12.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon kerja samanya.
Dialogue: 0,0:07:12.41,0:07:15.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini, Anda turun di stasiun mana?
Dialogue: 0,0:07:15.58,0:07:20.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami naik kereta SL Taiju dari Stasiun\NShimo-Imaichi ke Onsen Kinugawa.
Dialogue: 0,0:07:20.91,0:07:23.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Onsen? Enaknya!
Dialogue: 0,0:07:23.13,0:07:27.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ke Kinugawa, saya rekomendasikan\Nke pemandian besar yang ada jendela lebar.
Dialogue: 0,0:07:27.51,0:07:30.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Edo Wonderland juga menyenangkan,\Nwisata arung jeram tidak boleh terlewat!
Dialogue: 0,0:07:30.64,0:07:32.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, terus...
Dialogue: 0,0:07:33.39,0:07:35.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maaf. Saya jadi terlalu bersemangat.
Dialogue: 0,0:07:36.94,0:07:40.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan lupa mampir ke ruang selesa kafe\Ndi gerbong paling depan, ya!
Dialogue: 0,0:07:46.19,0:07:47.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}No-Nona?
Dialogue: 0,0:07:47.70,0:07:52.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan khawatir! Dia cuma kegirangan\Nkarena dapat banyak fanservis dari idolanya.
Dialogue: 0,0:07:52.19,0:07:53.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Idola?
Dialogue: 0,0:07:57.28,0:07:59.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah!
Dialogue: 0,0:07:59.75,0:08:03.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belum pernah ke Tokyo Skytree!
Dialogue: 0,0:08:03.38,0:08:07.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Kalau datang ke Tokyo, tempat pertama\Nyang harus dikunjungi itu Tokyo Skytree!
Dialogue: 0,0:08:07.16,0:08:08.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga belum pernah.
Dialogue: 0,0:08:08.93,0:08:13.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terkadang justru perantau\Nyang lebih mengenal Tokyo, ya.
Dialogue: 0,0:08:13.41,0:08:18.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebelum pindah ke sini, aku kira\Nsemua orang Tokyo makan monjayaki.
Dialogue: 0,0:08:20.95,0:08:25.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sampai lupa kalau tadi bangun pagi-pagi\Ndan belum sempat sarapan.
Dialogue: 0,0:08:27.15,0:08:31.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah menduga bakal begini!\NKarena itulah Ushio si T-Tuber kuliner
Dialogue: 0,0:08:31.32,0:08:34.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan unjuk kebolehan kali ini!
Dialogue: 0,0:08:34.70,0:08:39.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paket sukiyaki premium\Ndan nasi mangkuk sapi dari Asakusa Imahan!
Dialogue: 0,0:08:39.62,0:08:43.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paket sukiyaki premium ini\Nhanya tersedia dengan reservasi, lo!
Dialogue: 0,0:08:43.01,0:08:45.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah lama banget ingin mencobanya.
Dialogue: 0,0:08:45.16,0:08:47.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita makan bareng-bareng!
Dialogue: 0,0:08:47.07,0:08:48.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh?!
Dialogue: 0,0:08:48.40,0:08:50.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau makan daging...
Dialogue: 0,0:08:50.33,0:08:52.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bingung mau pilih yang mana.
Dialogue: 0,0:08:52.81,0:08:56.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tu-Tunggu dulu!\NBiar aku foto makanannya dulu!
Dialogue: 0,0:08:56.01,0:08:58.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah makan ini, bagaimana\Nkalau kita menjelajahi keretanya?
Dialogue: 0,0:08:58.80,0:09:01.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh! Aku mau ke ruang selesa kafe juga!
Dialogue: 0,0:09:05.39,0:09:06.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat ini!
Dialogue: 0,0:09:06.69,0:09:09.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Desain kursinya berbeda-beda\Ndi setiap gerbong.
Dialogue: 0,0:09:09.69,0:09:12.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi ingin mencoba naik semuanya!
Dialogue: 0,0:09:12.03,0:09:15.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sini ada meja di bagian\Nsandaran tangannya, ya!
Dialogue: 0,0:09:15.31,0:09:21.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau pakai dua meja, kita bisa\Nmakan bekal sekaligus edit video juga, ya?
Dialogue: 0,0:09:21.04,0:09:25.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Ushio, mejanya\Nbakal penuh bekal makanan.
Dialogue: 0,0:09:25.21,0:09:26.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:09:26.04,0:09:29.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misaki, sejak kapan\Nkamu jadi berani meledekku?
Dialogue: 0,0:09:33.89,0:09:37.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, ini ruang selesa kokpit impian...
Dialogue: 0,0:09:37.06,0:09:42.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Walaupun begitu, yang tersedia di sini\Ncuma minuman dan sedikit makanan ringan, sih.
Dialogue: 0,0:09:42.35,0:09:45.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sudah lebih dari cukup!\NSuasananya sudah bagus!
Dialogue: 0,0:09:45.39,0:09:47.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih telah menggunakan layanan kami.
Dialogue: 0,0:09:47.48,0:09:50.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anda penumpang Ruang Kokpit, benar?
Dialogue: 0,0:09:50.49,0:09:52.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, benar.
Dialogue: 0,0:09:52.00,0:09:56.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berikut menu yang tersedia.\NSilakan dilihat.
Dialogue: 0,0:09:56.41,0:09:57.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah!
Dialogue: 0,0:09:57.83,0:09:59.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah pasti bir, dong!
Dialogue: 0,0:09:59.41,0:10:03.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku penasaran dengan Nikko Lager,\Ntapi bisa habis sebotol sendirian enggak, ya?
Dialogue: 0,0:10:03.79,0:10:06.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minuman beralkoholnya banyak, ya?
Dialogue: 0,0:10:06.48,0:10:07.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada jus juga.
Dialogue: 0,0:10:07.75,0:10:08.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nikkola...
Dialogue: 0,0:10:08.96,0:10:10.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ni-Nikko...
Dialogue: 0,0:10:10.93,0:10:12.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, nikko!
Dialogue: 0,0:10:12.47,0:10:17.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah! Jadi ingin sekalian mampir ke Nikko\Ndan mencicipi bekal kereta di sana juga.
Dialogue: 0,0:10:17.22,0:10:19.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu lain kali saja, ya?
Dialogue: 0,0:10:23.81,0:10:27.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua kekhawatiran dan lelah yang\Nselama ini kupendam langsung hilang!
Dialogue: 0,0:10:27.29,0:10:29.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayak punya masalah besar saja.
Dialogue: 0,0:10:29.82,0:10:32.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paling-paling cuma karena\Ntugas kuliahmu belum selesai, 'kan?
Dialogue: 0,0:10:32.49,0:10:33.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan, sih?
Dialogue: 0,0:10:33.89,0:10:38.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ushio juga punya hari-hari ketika\Nmengkhawatirkan masa depannya, tahu!
Dialogue: 0,0:10:38.23,0:10:39.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang benar?
Dialogue: 0,0:10:45.96,0:10:47.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Geli!
Dialogue: 0,0:10:49.63,0:10:54.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bisa, aku ingin minum alkohol\Nberempat suatu saat nanti.
Dialogue: 0,0:10:54.38,0:10:55.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuputuskan!
Dialogue: 0,0:10:55.93,0:11:01.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu Misaki berusia 20 tahun,\Nkita semua akan berkumpul dan minum bersama!
Dialogue: 0,0:11:01.06,0:11:05.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kamu baru minum seteguk,\Nkok bisa semabuk itu?
Dialogue: 0,0:11:05.44,0:11:06.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, tapi...
Dialogue: 0,0:11:06.94,0:11:09.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Usa sudah 20 tahun bulan Agustus nanti.
Dialogue: 0,0:11:09.18,0:11:10.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti bisa minum, dong!
Dialogue: 0,0:11:10.95,0:11:11.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:11:11.53,0:11:14.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei! Itu namanya pemaksaan!\NEnggak boleh!
Dialogue: 0,0:11:15.60,0:11:17.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pabrik sake...
Dialogue: 0,0:11:17.20,0:11:18.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:11:18.76,0:11:22.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengalaman pertama minum alkohol nanti,\Ntolong ajak aku ke pabrik sake.
Dialogue: 0,0:11:23.52,0:11:25.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ide yang bagus, Usa!
Dialogue: 0,0:11:25.83,0:11:27.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak boleh! Enggak boleh!
Dialogue: 0,0:11:37.30,0:11:42.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau dilihat berapa kali pun, tetap luar biasa!\NAlkoholnya seperti tersapu bersih oleh uap!
Dialogue: 0,0:11:42.89,0:11:45.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti berada di dunia buku cerita, ya!
Dialogue: 0,0:11:46.53,0:11:49.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Tunggu dulu!
Dialogue: 0,0:11:49.10,0:11:52.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak apa-apa, coba lihat ke sana.
Dialogue: 0,0:11:56.57,0:11:59.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak apa-apa\Nmeninggalkan peron sebentar?
Dialogue: 0,0:11:59.07,0:12:01.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih ada waktu sebelum berangkat,
Dialogue: 0,0:12:01.61,0:12:04.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita harus lihat meja putar\Nlokomotifnya selagi di sini!
Dialogue: 0,0:12:08.92,0:12:09.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kenapa?
Dialogue: 0,0:12:10.58,0:12:11.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}E-Eng...
Dialogue: 0,0:12:11.79,0:12:15.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baru sadar kalau setelah ini,\Nperjalanan hari ini sudah separuh jalan.
Dialogue: 0,0:12:18.20,0:12:20.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu menganggap hari ini\Nsudah hampir berakhir, ya.
Dialogue: 0,0:12:20.89,0:12:24.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih banyak hal yang menanti,\Nseperti naik SL dan onsen.
Dialogue: 0,0:12:28.97,0:12:32.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih banyak destinasi\Nmenyenangkan yang menanti kita.
Dialogue: 0,0:12:35.12,0:12:37.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keretanya datang!
Dialogue: 0,0:12:44.08,0:12:45.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, jadi gitu!
Dialogue: 0,0:12:45.83,0:12:50.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lokomotifnya diputar di sini\Nsupaya bisa berjalan ke arah sebaliknya, ya!
Dialogue: 0,0:12:50.71,0:12:56.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya, meja putar ini dulunya digunakan\Ndi Stasiun Nagatoshi, Prefektur Yamaguchi.
Dialogue: 0,0:12:57.57,0:12:59.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keren!
Dialogue: 0,0:13:04.01,0:13:05.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keretanya kembali ke sini!
Dialogue: 0,0:13:05.97,0:13:07.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang keretanya ke arah sini, lo!
Dialogue: 0,0:13:08.89,0:13:14.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi keretanya berhenti di sebelah sana...\NKita naiknya dari peron ini, 'kan?
Dialogue: 0,0:13:14.35,0:13:16.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana caranya kereta itu\Nsampai ke sini?
Dialogue: 0,0:13:16.40,0:13:21.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keretanya berjalan sampai ke ujung jalur dulu,\Nlalu berbalik arah dan kembali ke peron ini!
Dialogue: 0,0:13:21.86,0:13:23.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu!
Dialogue: 0,0:13:23.56,0:13:24.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Datang!
Dialogue: 0,0:13:31.92,0:13:34.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Uapnya terasa mengepul sampai ke sini, ya!
Dialogue: 0,0:13:34.43,0:13:36.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu musim panas pasti menyiksa banget!
Dialogue: 0,0:13:44.72,0:13:47.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak banget, mejanya besar!
Dialogue: 0,0:13:47.16,0:13:51.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini gerbong observasi seri 12\Nyang baru mulai dioperasikan!
Dialogue: 0,0:13:51.09,0:13:53.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku suka nuansa retro\Ndari kayu-kayunya ini.
Dialogue: 0,0:13:53.93,0:13:56.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti kita harus mampir\Nke dek observasinya!
Dialogue: 0,0:13:56.08,0:13:58.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kira-kira bau asap enggak, ya?
Dialogue: 0,0:14:08.83,0:14:12.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bekal kereta Harta Karun\NTersembunyi Nikko SL Taiju!
Dialogue: 0,0:14:12.79,0:14:13.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh?
Dialogue: 0,0:14:13.46,0:14:18.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga, sampai lupa membeli bekal kereta\Ngara-gara asyik melihat meja putar lokomotif!
Dialogue: 0,0:14:18.08,0:14:20.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak pantas disebut T-Tuber kuliner!
Dialogue: 0,0:14:20.63,0:14:23.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi sudah makan banyak di Spacia X, 'kan?
Dialogue: 0,0:14:23.84,0:14:25.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau jadi maniak kereta,\Nsemuanya harus dicoba!
Dialogue: 0,0:14:25.89,0:14:28.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini soal harga diri seorang profesional!
Dialogue: 0,0:14:33.11,0:14:34.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eng...
Dialogue: 0,0:14:35.02,0:14:37.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau saya fotokan?
Dialogue: 0,0:14:37.40,0:14:38.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh?
Dialogue: 0,0:14:39.51,0:14:43.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Kamu bekerja di Kereta Api Chichibu?!
Dialogue: 0,0:14:43.07,0:14:48.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya. Saya Sakurazawa Minano, bekerja\Nsebagai masinis di Kereta Api Chichibu.
Dialogue: 0,0:14:48.95,0:14:50.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Petugas resmi!
Dialogue: 0,0:14:50.16,0:14:51.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asli!
Dialogue: 0,0:14:51.24,0:14:55.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di hari libur pun masih wisata kereta.\NAnda benar-benar menyukai kereta, ya!
Dialogue: 0,0:14:55.87,0:14:58.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, aku sangat menyukainya!
Dialogue: 0,0:14:58.09,0:15:03.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, bukan hanya itu, aku ingin naik\Nkereta SL yang dikemudikan temanku.
Dialogue: 0,0:15:05.36,0:15:06.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?!
Dialogue: 0,0:15:06.59,0:15:07.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar!
Dialogue: 0,0:15:07.30,0:15:09.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namanya Okuwa Juri.
Dialogue: 0,0:15:09.57,0:15:13.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami berkenalan saat dia datang ke perusahaan\Nkami untuk mengikuti pelatihan SL.
Dialogue: 0,0:15:13.73,0:15:17.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biasanya kami berdua menjelajahi\Nberbagai rute SL bersama-sama,
Dialogue: 0,0:15:17.40,0:15:19.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi hari ini aku datang diam-diam.
Dialogue: 0,0:15:19.49,0:15:24.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rencananya, aku mau mengirim foto\Nyang kuambil di stasiun buat kejutan.
Dialogue: 0,0:15:25.16,0:15:29.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, tadi aku melihat\Nbanyak orang kembali dari dek observasi.
Dialogue: 0,0:15:29.57,0:15:30.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah!
Dialogue: 0,0:15:32.24,0:15:35.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, suasana terbuka ini\Nbikin ingat Kereta Api Watarase!
Dialogue: 0,0:15:35.50,0:15:38.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melihat perjalanan kereta\Ndari luar seperti ini seru, ya!
Dialogue: 0,0:15:39.21,0:15:42.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi karena terlihat tembus pandang,\Njadi agak menakutkan juga...
Dialogue: 0,0:15:42.56,0:15:44.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau pegangan tangan?
Dialogue: 0,0:15:44.59,0:15:45.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:15:45.87,0:15:46.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bercanda.
Dialogue: 0,0:15:49.14,0:15:51.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah! Keretanya bergerak!
Dialogue: 0,0:16:08.41,0:16:10.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat sekali, ya!
Dialogue: 0,0:16:10.89,0:16:13.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya cuma lewat dua stasiun\Nselama 36 menit.
Dialogue: 0,0:16:13.59,0:16:15.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, kita bertemu lagi, ya?
Dialogue: 0,0:16:15.63,0:16:17.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minano!
Dialogue: 0,0:16:17.44,0:16:20.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kalian berkenan,\Nmaukah melihat ruang mesin?
Dialogue: 0,0:16:34.01,0:16:34.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minano?
Dialogue: 0,0:16:34.87,0:16:36.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku datang!
Dialogue: 0,0:16:36.35,0:16:38.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka siapa?
Dialogue: 0,0:16:38.06,0:16:41.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berteman dengan mereka\Ndi perjalanan tadi.
Dialogue: 0,0:16:41.05,0:16:42.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, 'kan?
Dialogue: 0,0:16:42.05,0:16:46.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya! Perjalanannya tadi sangat nyaman!
Dialogue: 0,0:16:46.03,0:16:51.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga jadi ingin suatu hari nanti\Nbisa mengemudikan SL seperti Juri.
Dialogue: 0,0:16:51.70,0:16:54.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Kamu mau mengejarnya juga?
Dialogue: 0,0:16:54.61,0:16:56.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rencanaku begitu.
Dialogue: 0,0:16:56.31,0:16:57.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serius?
Dialogue: 0,0:16:58.56,0:17:02.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, kami malah asyik bicara sendiri.
Dialogue: 0,0:17:02.27,0:17:08.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya! Apa kalian mau melihat\Nbagian ruang mesin?
Dialogue: 0,0:17:08.88,0:17:09.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?!
Dialogue: 0,0:17:21.40,0:17:23.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke! Senyum!
Dialogue: 0,0:17:32.78,0:17:36.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersyukur banget\Nsama keberuntungan Usa!
Dialogue: 0,0:17:36.08,0:17:39.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah pesan kereta lain\Nuntuk perjalanan pulang, 'kan?
Dialogue: 0,0:17:39.93,0:17:43.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eng, kalau tidak salah,\NKereta Ekspres Liberty.
Dialogue: 0,0:17:43.00,0:17:46.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Desain modern yang terinspirasi\Ndari Tokyo Skytree!
Dialogue: 0,0:17:46.33,0:17:49.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa menikmati kereta modern\Ndan kereta retro sekaligus dalam satu hari...
Dialogue: 0,0:17:49.99,0:17:51.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahagianya aku!
Dialogue: 0,0:17:52.36,0:17:55.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, Misaki mana?
Dialogue: 0,0:17:56.11,0:17:59.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, hei! Kalau terus di situ,\Nnanti kamu masuk angin, lo!
Dialogue: 0,0:17:59.29,0:18:00.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:18:00.35,0:18:06.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku baru sadar, ini pertama kalinya\Naku mandi bersama kalian seperti ini...
Dialogue: 0,0:18:06.17,0:18:07.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku agak malu.
Dialogue: 0,0:18:07.90,0:18:09.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu ini ngomong apa, sih!
Dialogue: 0,0:18:09.40,0:18:14.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita masih akan pergi ke berbagai tempat.\NJadi, kita harus terbiasa telanjang bareng.
Dialogue: 0,0:18:14.04,0:18:16.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cara bicaramu bikin salah paham, tahu.
Dialogue: 0,0:18:16.98,0:18:18.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan masuk ke sini.
Dialogue: 0,0:18:18.55,0:18:21.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kalau begitu, permisi...
Dialogue: 0,0:18:24.39,0:18:27.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sudah terbiasa, nyaman juga, ya?
Dialogue: 0,0:18:27.08,0:18:30.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya kamu jarang pergi\Nke onsen sama keluarga?
Dialogue: 0,0:18:30.67,0:18:34.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau liburan, aku lebih sering pergi\Nbersama teman-teman ekskul.
Dialogue: 0,0:18:34.81,0:18:38.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, Misaki dulu ikut ekskul apa?
Dialogue: 0,0:18:38.14,0:18:40.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, Ekskul Masak!
Dialogue: 0,0:18:40.05,0:18:42.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masak?! Misaki, kamu bisa bikin\Nmakanan yang layak dimakan?
Dialogue: 0,0:18:42.92,0:18:44.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke-Keterlaluan!
Dialogue: 0,0:18:44.97,0:18:50.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, teman masa kecilku yang lebih sering\Nmengupas bahan-bahannya, sih...
Dialogue: 0,0:18:50.13,0:18:53.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku jago mengaduk masakan di panci!
Dialogue: 0,0:18:54.16,0:18:55.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keahlianmu cuma mengaduk...
Dialogue: 0,0:18:55.88,0:18:57.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayak anak SD yang membantu ibunya!
Dialogue: 0,0:18:57.91,0:19:00.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku juga bantu menyiapkan\Nmakan malam di rumah.
Dialogue: 0,0:19:00.61,0:19:02.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misalnya, menghangatkan kari buatan Ayah.
Dialogue: 0,0:19:02.62,0:19:04.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu juga masih tugas mengaduk, dong!
Dialogue: 0,0:19:04.71,0:19:08.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku ingin mencoba masakan Misaki.
Dialogue: 0,0:19:08.00,0:19:10.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Usa suka tantangan, ya?
Dialogue: 0,0:19:10.24,0:19:13.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kalian dulu ikut ekskul apa?
Dialogue: 0,0:19:13.35,0:19:15.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku? Ekskul Basket.
Dialogue: 0,0:19:15.40,0:19:17.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih sering duduk\Ndi bangku cadangan, sih.
Dialogue: 0,0:19:17.45,0:19:19.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ekskul Penelitian Kereta Api!
Dialogue: 0,0:19:19.04,0:19:20.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak ikut apa-apa...
Dialogue: 0,0:19:20.35,0:19:22.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesuai dugaan!
Dialogue: 0,0:19:22.27,0:19:27.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal sebentar lagi sudah musim panas,\Nternyata kita jarang ngobrol hal seperti ini, ya?
Dialogue: 0,0:19:27.45,0:19:31.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya, Kodama selalu sibuk\Nngomong soal kereta, sih.
Dialogue: 0,0:19:31.43,0:19:33.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi itu juga bagian\Ndari tujuan utama klub kita!
Dialogue: 0,0:19:37.63,0:19:39.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tahu seseru ini,
Dialogue: 0,0:19:39.24,0:19:44.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku jadi berharap mulai naik kereta\Ndan mengunjungi berbagai tempat sejak dulu!
Dialogue: 0,0:19:44.04,0:19:45.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku paham banget!
Dialogue: 0,0:19:45.77,0:19:49.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita juga jadi bisa mencicipi makanan\Nyang tahu-tahu sudah tidak dijual.
Dialogue: 0,0:19:49.41,0:19:52.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berharap lahir di zaman\NKereta Api Nasional Jepang!
Dialogue: 0,0:19:52.58,0:19:54.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau mencium aromanya langsung!
Dialogue: 0,0:19:54.84,0:20:00.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kalau begitu, kita tidak mungkin bisa\Nberendam di onsen bersama seperti ini, 'kan?
Dialogue: 0,0:20:01.47,0:20:05.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa, sih, Usa? Komentar penutup sebagus itu\Nharusnya diucapkan senior, tahu.
Dialogue: 0,0:20:05.81,0:20:08.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Maafkan aku.
Dialogue: 0,0:20:08.04,0:20:10.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anggap saja aku yang ngomong kalimat itu, ya.
Dialogue: 0,0:20:10.56,0:20:11.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong!
Dialogue: 0,0:20:11.33,0:20:13.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu ngomong apa, sih?!
Dialogue: 0,0:20:21.32,0:20:27.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, warna ungu Edo yang begitu elegan ini!\NMotif inden tradisional khas Jepang!
Dialogue: 0,0:20:27.75,0:20:33.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi ada lapisan cat putih yang mengingatkan\Npada Tokyo Skytree, simbol teknologi modern.
Dialogue: 0,0:20:33.95,0:20:38.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melihat saja membuat jantungku berdebar!\NKereta Ekspres Liberty!
Dialogue: 0,0:20:38.65,0:20:39.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kamu dengar nggak?
Dialogue: 0,0:20:43.32,0:20:44.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo?
Dialogue: 0,0:20:45.69,0:20:48.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya tidur dengan nyenyak.
Dialogue: 0,0:22:25.35,0:22:28.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Wadahnya juga boleh dibawa pulang?
Dialogue: 0,0:22:28.12,0:22:31.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wadah keramik Arita-yaki\Nboleh dibawa pulang juga.
Dialogue: 0,0:22:31.71,0:22:33.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah!
Dialogue: 0,0:22:33.04,0:22:36.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi motifnya macam-macam...\NJadi bingung mau pilih yang mana, ya...
Dialogue: 0,0:22:36.96,0:22:40.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wadah yang cocok untuk minuman\Nberalkohol di kereta wisata, ya?
Dialogue: 0,0:22:40.38,0:22:42.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya, wadahnya bisa berbeda-beda\Ntergantung minumannya.
Dialogue: 0,0:22:44.57,0:22:47.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya, bagaimana\Nkalau kamu coba minum?
Dialogue: 0,0:22:47.09,0:22:49.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Memang boleh?
Dialogue: 0,0:22:56.81,0:22:59.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang ini juga enak banget, ya...
Dialogue: 0,0:22:59.86,0:23:02.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku menyuruhnya\Nminum terlalu banyak?
Dialogue: 0,0:23:02.65,0:23:05.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku akan jadikan ini yang terakhir.
Dialogue: 0,0:23:07.32,0:23:09.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini! Yang ini!
Dialogue: 0,0:23:09.85,0:23:12.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke! Sebagai hadiah\Nkarena kamu berusaha keras,
Dialogue: 0,0:23:12.41,0:23:13.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sekalian aku kasih bonus!
Dialogue: 0,0:23:13.95,0:23:16.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah! Lucu sekali!
Dialogue: 0,0:23:16.33,0:23:18.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini tempat menaruh sumpit\Nyang kubuat dari tanah liat sisa.
Dialogue: 0,0:23:18.89,0:23:23.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekalian saja, tolong bantu promosikan\NArita sampai ke pelosok-pelosok, ya!
Dialogue: 0,0:23:23.70,0:23:24.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja!
Dialogue: 0,0:23:26.01,0:23:28.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Naik SL seru, ya?
Dialogue: 0,0:23:28.01,0:23:31.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau menghabiskan waktu bersama kalian\Ndi liburan musim panas nanti.
Dialogue: 0,0:23:31.20,0:23:32.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, 'kan?\NSelanjutnya mau pergi ke mana, ya?
Dialogue: 0,0:23:32.95,0:23:35.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebelum itu, bagaimana UAS kalian?
Dialogue: 0,0:23:35.31,0:23:35.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:23:35.85,0:23:38.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya, "Libur Musim Panas Dimulai!"
Dialogue: 0,0:23:38.23,0:23:41.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tahun ini mau ngapain\Nsama Yacchan, ya?
