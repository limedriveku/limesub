Dialogue: 0,0:00:00.00,0:00:03.98,sign,,0000,0000,0000,,LIGA UTAMA PIALA TAKAMADO U-18
Dialogue: 0,0:00:36.25,0:00:39.35,sign,,0000,0000,0000,,TOKYO ESPERION 1 - 0
Dialogue: 0,0:03:10.92,0:03:14.47,sign,,0000,0000,0000,,(Aoashi Season2)
Dialogue: 0,0:03:42.68,0:03:46.02,sign,,0000,0000,0000,,(Episode 4: Kunci)
Dialogue: 0,0:11:08.43,0:11:10.96,sign,,0000,0000,0000,,SMK KASHIWA VS ESPERION
Dialogue: 0,0:12:35.13,0:12:36.77,sign,,0000,0000,0000,,TOKYO CITY ESPERION FC
Dialogue: 0,0:12:42.08,0:12:52.29,sign,,0000,0000,0000,,GARIS LURUS ANTARA LAWAN DAN GAWANG SENDIRI
Dialogue: 0,0:18:10.81,0:18:14.83,sign,,0000,0000,0000,,BEK SAYAP, BEK TENGAH
Dialogue: 0,0:18:14.83,0:18:24.12,sign,,0000,0000,0000,,SEGITIGA
Dialogue: 0,0:20:59.15,0:21:03.15,sign,,0000,0000,0000,,SMK KASHIWA VERSUS ESPERION
Dialogue: 0,0:22:03.84,0:22:07.59,sign,,0000,0000,0000,,SMK KASHIWA VERSUS ESPERION
Dialogue: 0,0:24:28.12,0:24:29.98,sign,,0000,0000,0000,,(Episode Berikutnya: Jangan Berhenti Berpikir)\NPROGRAM INI FIKSI, TIDAK TERKAIT DENGAN TOKOH, KELOMPOK, ATAU NAMA DI DUNIA NYATA
Dialogue: 0,0:00:09.71,0:00:12.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang pertama mencetak gol adalah…
Dialogue: 0,0:00:14.43,0:00:15.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Esperion!
Dialogue: 0,0:00:16.73,0:00:18.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luar biasa!
Dialogue: 0,0:00:18.03,0:00:19.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}-Kerja bagus!\N-Bagus!
Dialogue: 0,0:00:36.25,0:00:37.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo semangat!
Dialogue: 0,0:00:37.39,0:00:39.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:00:39.45,0:00:41.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baru satu gol!
Dialogue: 0,0:00:41.26,0:00:42.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan masalah besar!
Dialogue: 0,0:00:42.80,0:00:44.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu masih banyak!
Dialogue: 0,0:00:44.38,0:00:46.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita samakan kedudukan dulu!
Dialogue: 0,0:00:53.34,0:00:54.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inara!
Dialogue: 0,0:00:56.56,0:00:57.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, dari belakang…
Dialogue: 0,0:01:01.84,0:01:02.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sialan!
Dialogue: 0,0:01:06.86,0:01:10.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak babak pertama, aku sudah merasa\Nmakin sulit bermain dengan leluasa.
Dialogue: 0,0:01:11.63,0:01:13.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka sudah membaca strategi kami,
Dialogue: 0,0:01:13.95,0:01:16.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu menghentikannya satu per satu.
Dialogue: 0,0:01:22.35,0:01:24.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami sama sekali tidak berkutik.
Dialogue: 0,0:01:26.48,0:01:27.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inara!
Dialogue: 0,0:01:28.54,0:01:29.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat ke arah pelatih!
Dialogue: 0,0:01:38.60,0:01:41.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si Aoi itu gerakannya lambat sekali.
Dialogue: 0,0:01:43.80,0:01:44.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah!
Dialogue: 0,0:01:50.40,0:01:51.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Matsu, tetap di sana!
Dialogue: 0,0:01:56.99,0:01:57.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Matsu!
Dialogue: 0,0:02:00.78,0:02:02.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama sekali tidak bisa mengejar.
Dialogue: 0,0:02:03.84,0:02:05.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Levelnya terlalu tinggi.
Dialogue: 0,0:02:07.28,0:02:08.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inilah
Dialogue: 0,0:02:09.05,0:02:10.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Liga Utama.
Dialogue: 0,0:03:47.56,0:03:48.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei.
Dialogue: 0,0:03:48.83,0:03:50.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si Aoi itu…
Dialogue: 0,0:03:59.66,0:04:02.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya ada yang aneh dengannya.
Dialogue: 0,0:04:03.00,0:04:06.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si Ashito itu benar-benar sudah panik.
Dialogue: 0,0:04:06.57,0:04:08.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu hal yang wajar.
Dialogue: 0,0:04:08.43,0:04:09.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini adalah Liga Utama.
Dialogue: 0,0:04:10.59,0:04:13.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keunggulan kita di lapangan\Nmemang melampaui selisih skor,
Dialogue: 0,0:04:14.70,0:04:17.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tetapi kemampuan menyerang\Ndan bertahan Kashiwa juga sangat tinggi.
Dialogue: 0,0:04:18.40,0:04:20.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagi Ashito, ini pasti level\Nyang belum pernah dia hadapi sebelumnya.
Dialogue: 0,0:04:21.32,0:04:24.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia baru tiga bulan bergabung\Ndi Tim Remaja.
Dialogue: 0,0:04:24.06,0:04:27.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagi dia yang selalu bermain bola di desa,\Nbisa bertanding saja sudah di luar dugaannya.
Dialogue: 0,0:04:35.36,0:04:37.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}-Lini pertahanan maju ke depan.\N-Ke sisi Ashito lagi.
Dialogue: 0,0:04:37.23,0:04:38.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat sekali.
Dialogue: 0,0:04:38.33,0:04:39.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, bola ini…
Dialogue: 0,0:04:40.75,0:04:42.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa mengambil posisi terlebih dulu,\Nlalu menerima bola.
Dialogue: 0,0:04:47.72,0:04:48.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada pelanggaran!
Dialogue: 0,0:04:54.52,0:04:55.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, Akutsu!
Dialogue: 0,0:04:55.79,0:04:56.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyelamatan hebat!
Dialogue: 0,0:04:59.74,0:05:01.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua orang sudah menyadarinya.
Dialogue: 0,0:05:03.02,0:05:05.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sedang diincar.
Dialogue: 0,0:05:06.01,0:05:06.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:05:16.52,0:05:18.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau ini
Dialogue: 0,0:05:19.50,0:05:23.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisakah pura-pura cedera saja\Ndan minta diganti?
Dialogue: 0,0:05:23.92,0:05:26.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimanapun,\Nkau sama sekali tidak berbakat.
Dialogue: 0,0:05:29.29,0:05:33.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perasaan tidak berdaya seperti ini\Nsudah lama tidak kurasakan sejak saat itu.
Dialogue: 0,0:05:36.08,0:05:36.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Akutsu.
Dialogue: 0,0:05:38.70,0:05:39.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku
Dialogue: 0,0:05:40.67,0:05:42.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sudah berbeda dengan yang dulu.
Dialogue: 0,0:05:47.84,0:05:50.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ashito, tenanglah!
Dialogue: 0,0:05:50.46,0:05:51.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semangat!
Dialogue: 0,0:05:52.70,0:05:54.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Babak kedua sudah berjalan 20 menit…
Dialogue: 0,0:05:57.72,0:05:59.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kanan! Terobos dari sisi kanan!
Dialogue: 0,0:06:00.25,0:06:03.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bek sayap itu sama sekali\Nbelum mencapai level Liga Utama!
Dialogue: 0,0:06:03.77,0:06:05.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:06:05.26,0:06:07.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belum mencapai level Liga Utama.
Dialogue: 0,0:06:07.71,0:06:09.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus mengakui hal itu dulu.
Dialogue: 0,0:06:10.33,0:06:13.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan lari dari kelemahan sendiri.
Dialogue: 0,0:06:13.68,0:06:16.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang terpenting adalah "Kalau begitu,\Napa yang harus dilakukan?".
Dialogue: 0,0:06:17.32,0:06:19.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bek sayap adalah pemain bertahan.
Dialogue: 0,0:06:19.77,0:06:21.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berikan kontribusi dalam pertahanan dulu.
Dialogue: 0,0:06:21.60,0:06:22.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ashito.
Dialogue: 0,0:06:23.42,0:06:24.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Merapat ke tengah!
Dialogue: 0,0:06:30.27,0:06:32.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tutup celah yang ingin\Ndimanfaatkan Kashiwa.
Dialogue: 0,0:06:35.72,0:06:36.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ce-Cepat sekali.
Dialogue: 0,0:06:37.37,0:06:39.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal keputusanku sudah benar!
Dialogue: 0,0:06:47.92,0:06:49.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yamada, awasi nomor 14!
Dialogue: 0,0:06:50.03,0:06:51.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Matsu, maju!
Dialogue: 0,0:07:02.75,0:07:04.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sialan!
Dialogue: 0,0:07:04.24,0:07:05.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bek tengah ini…
Dialogue: 0,0:07:05.72,0:07:08.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal sudah menemukan celah,\Ntetapi tidak bisa ditembus!
Dialogue: 0,0:07:11.39,0:07:13.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kombinasi permainan ini\Nsungguh seperti karya seni.
Dialogue: 0,0:07:14.48,0:07:15.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski berat mengakuinya,
Dialogue: 0,0:07:15.64,0:07:18.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tim yang memiliki hingga enam\N"pemain Tim Nasional" memang berbeda.
Dialogue: 0,0:07:18.64,0:07:20.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami juga bermain dengan baik,
Dialogue: 0,0:07:20.75,0:07:22.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tetapi masih kalah dari mereka\Njika bicara soal kemampuan individu.
Dialogue: 0,0:07:23.12,0:07:26.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimanapun, tidak ada pemain kami\Nyang masuk Tim Nasional tahun ini.
Dialogue: 0,0:07:26.94,0:07:30.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemimpin yang mampu membimbing\Nrekan setimnya dalam berbagai situasi.
Dialogue: 0,0:07:31.76,0:07:34.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika sebuah tim memiliki satu pemain\NTim Nasional saja adalah hal yang langka,
Dialogue: 0,0:07:34.30,0:07:35.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tetapi di susunan pemain inti mereka\Nada lima orang sekaligus.
Dialogue: 0,0:07:36.12,0:07:37.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar sangat kuat.
Dialogue: 0,0:07:38.99,0:07:42.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meskipun masih menyimpan\Nsatu pemain terakhir,
Dialogue: 0,0:07:42.28,0:07:44.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}permainan mereka sudah mendekati sempurna.
Dialogue: 0,0:07:46.00,0:07:47.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di antara semuanya, yang paling menonjol
Dialogue: 0,0:07:48.54,0:07:49.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah dia.
Dialogue: 0,0:07:57.42,0:07:58.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Bukan pelanggaran?
Dialogue: 0,0:08:00.84,0:08:01.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serangan balik!
Dialogue: 0,0:08:02.80,0:08:04.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyerang ke sisi Ashito lagi!
Dialogue: 0,0:08:04.68,0:08:05.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yuma!
Dialogue: 0,0:08:09.05,0:08:09.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus!
Dialogue: 0,0:08:12.60,0:08:13.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}O-Orang ini…
Dialogue: 0,0:08:14.17,0:08:15.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bahkan mengejar sampai\Nke posisi sejauh ini?
Dialogue: 0,0:08:16.46,0:08:17.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sialan!
Dialogue: 0,0:08:25.53,0:08:26.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat sekali.
Dialogue: 0,0:08:27.52,0:08:28.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bek tengah itu
Dialogue: 0,0:08:29.56,0:08:31.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}selalu muncul di situasi apa pun…
Dialogue: 0,0:08:34.09,0:08:36.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kashiwa akan melakukan pergantian pemain.
Dialogue: 0,0:08:37.31,0:08:38.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat sekali mereka bergerak.
Dialogue: 0,0:08:39.82,0:08:40.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akutsu.
Dialogue: 0,0:08:43.74,0:08:44.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:08:46.68,0:08:48.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa sebenarnya yang kau lakukan?
Dialogue: 0,0:08:51.33,0:08:52.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau meremehkan sepak bola?
Dialogue: 0,0:08:53.68,0:08:55.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau main seperti anak kecil saja.
Dialogue: 0,0:09:14.27,0:09:15.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau meremehkan sepak bola?
Dialogue: 0,0:09:16.40,0:09:18.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau main seperti anak kecil saja.
Dialogue: 0,0:09:18.88,0:09:19.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:09:20.57,0:09:22.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau tidak memberi\Ninstruksi kepada Aoi?
Dialogue: 0,0:09:24.67,0:09:27.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal serangan itu bisa dengan mudah\Ndihentikan hanya dengan memberi instruksi.
Dialogue: 0,0:09:27.77,0:09:29.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau harus lari ke sana sendiri?
Dialogue: 0,0:09:30.40,0:09:32.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapan aku pernah mengajarimu\Nbermain seperti itu?
Dialogue: 0,0:09:36.84,0:09:37.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah.
Dialogue: 0,0:09:37.60,0:09:39.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakinya kram.
Dialogue: 0,0:09:39.00,0:09:40.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertandingan akan dihentikan sebentar.
Dialogue: 0,0:09:43.24,0:09:45.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyuruhku memberi instruksi\Npada orang seperti dia?
Dialogue: 0,0:09:46.91,0:09:50.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih baik kulakukan semuanya sendiri.
Dialogue: 0,0:09:57.29,0:09:58.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhentilah berbohong.
Dialogue: 0,0:09:59.68,0:10:01.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau benar-benar berpikir begitu,
Dialogue: 0,0:10:01.40,0:10:05.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bukankah terus menyuruhnya maju\Nagar dia merasakan sendiri
Dialogue: 0,0:10:05.10,0:10:06.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kemampuannya masih kurang adalah gayamu?
Dialogue: 0,0:10:07.40,0:10:08.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku salah bicara?
Dialogue: 0,0:10:11.00,0:10:14.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aoi yang sekarang mungkin bisa\Nmemenuhi tuntutanmu.
Dialogue: 0,0:10:15.04,0:10:18.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sengaja tidak memberi instruksi\Nkarena tahu persis hal itu, 'kan?
Dialogue: 0,0:10:19.87,0:10:21.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah ini agak lama?
Dialogue: 0,0:10:21.68,0:10:24.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah Akutsu sedang dimarahi?
Dialogue: 0,0:10:27.32,0:10:28.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini adalah pertandingan resmi.
Dialogue: 0,0:10:29.18,0:10:30.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bermainlah dengan benar.
Dialogue: 0,0:10:30.78,0:10:33.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak, akan kutarik kau keluar\Ndan kulempar kembali ke Tim B.
Dialogue: 0,0:10:36.54,0:10:38.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maafkan aku.
Dialogue: 0,0:10:40.97,0:10:43.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Me-Menakutkan sekali…
Dialogue: 0,0:10:48.20,0:10:50.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa pemain yang cedera sudah diganti?
Dialogue: 0,0:10:51.44,0:10:53.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peranmu di sisi sayap\Nsangat penting, Mochizuki.
Dialogue: 0,0:10:53.69,0:10:54.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:11:05.80,0:11:06.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mochizuki!
Dialogue: 0,0:11:07.07,0:11:08.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu dapat bola,
Dialogue: 0,0:11:08.43,0:11:09.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}langsung maju ke depan!
Dialogue: 0,0:11:09.07,0:11:10.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sisi kanan!
Dialogue: 0,0:11:10.96,0:11:13.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}0-1\NSisi kanan sudah kita kendalikan total!
Dialogue: 0,0:11:13.40,0:11:14.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}0-1\NTekan terus!
Dialogue: 0,0:11:14.67,0:11:17.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sisi Ashito masih terus diincar.
Dialogue: 0,0:11:18.22,0:11:20.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meskipun Senior Akutsu sangat hebat,
Dialogue: 0,0:11:20.52,0:11:22.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}secara keseluruhan, sepertinya dia hanya\Nmampu membendung serangan lawan seadanya.
Dialogue: 0,0:11:23.44,0:11:25.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika tidak segera menyesuaikan taktik,\Nkeadaan bisa jadi gawat.
Dialogue: 0,0:11:27.98,0:11:30.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Haruskah memperkuat\Npertahanan di sisi Aoi?
Dialogue: 0,0:11:39.68,0:11:42.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akutsu sama sekali\Ntidak memberiku instruksi.
Dialogue: 0,0:11:42.86,0:11:45.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sama sekali tidak menyadari hal itu.
Dialogue: 0,0:11:46.44,0:11:47.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, Paman…
Dialogue: 0,0:11:47.98,0:11:51.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gagal bertahan jelas karena\Nkemampuanku sendiri yang masih kurang.
Dialogue: 0,0:11:51.64,0:11:53.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meskipun Akutsu menyebalkan,
Dialogue: 0,0:11:53.53,0:11:55.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku rasa instruksi di lapangan saja\Ntidak akan membawa banyak perubahan.
Dialogue: 0,0:11:56.64,0:11:59.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus menyesuaikan diri\Ndengan ritme pertandingan terlebih dulu.
Dialogue: 0,0:11:59.44,0:12:00.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bergerak!
Dialogue: 0,0:12:03.71,0:12:04.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bergerak!
Dialogue: 0,0:12:05.18,0:12:06.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu di sana!
Dialogue: 0,0:12:07.47,0:12:10.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau terlalu membelakangi gawang.
Dialogue: 0,0:12:10.28,0:12:14.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arahkan punggung ke garis tepi dan siapkan diri\Ndengan posisi menyamping ke tengah lapangan.
Dialogue: 0,0:12:19.13,0:12:21.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tu-Tunggu di sini?
Dialogue: 0,0:12:21.02,0:12:22.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sini?
Dialogue: 0,0:12:22.08,0:12:23.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bercanda!
Dialogue: 0,0:12:23.13,0:12:25.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika aku hanya berdiri diam di sini,
Dialogue: 0,0:12:25.21,0:12:27.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}memang aku bisa menutup\Njalur umpan ke sayap,
Dialogue: 0,0:12:27.72,0:12:29.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tetapi bukankah lawan jadi bebas mengoper\Nke tengah sesuka hati?
Dialogue: 0,0:12:30.78,0:12:33.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, dia malah bilang\Njangan membelakangi gawang…
Dialogue: 0,0:12:35.13,0:12:36.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aturan dasar pertahanan adalah
Dialogue: 0,0:12:37.10,0:12:41.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}membayangkan dirimu berada di garis lurus\Nantara lawan dan gawang sendiri.
Dialogue: 0,0:12:42.08,0:12:42.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Singkatnya,
Dialogue: 0,0:12:42.92,0:12:45.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}selalu posisikan punggungmu menghadap ke gawang sendiri.
Dialogue: 0,0:12:45.39,0:12:46.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan begitu,
Dialogue: 0,0:12:46.54,0:12:48.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dari arah mana pun lawan menyerang,
Dialogue: 0,0:12:48.08,0:12:49.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita bisa bertahan dengan kokoh.
Dialogue: 0,0:12:49.63,0:12:52.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang semuanya tetap tergantung situasi,
Dialogue: 0,0:12:52.59,0:12:55.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tetapi sekarang pemain Kashiwa\Njustru berkumpul di tengah lapangan.
Dialogue: 0,0:12:55.63,0:12:58.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana bisa dia masih menyuruhku\Ntetap di posisi seperti ini?
Dialogue: 0,0:12:58.03,0:13:00.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya aku merapat ke tengah.
Dialogue: 0,0:13:23.04,0:13:24.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus sekali!
Dialogue: 0,0:13:24.33,0:13:25.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia berhenti.
Dialogue: 0,0:13:26.20,0:13:27.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhasil ditahan.
Dialogue: 0,0:13:28.01,0:13:30.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah ini\Nformasi bertahan idealmu, Akutsu?
Dialogue: 0,0:13:34.86,0:13:37.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Bukankah dia barusan sempat ragu?
Dialogue: 0,0:13:37.32,0:13:38.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang saatnya! Tekan dia!
Dialogue: 0,0:13:38.81,0:13:40.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Giring dia ke tengah!
Dialogue: 0,0:13:48.96,0:13:50.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sono, apa yang kau lakukan?
Dialogue: 0,0:13:51.31,0:13:53.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sampai kehilangan bola\Ndi tempat seperti itu!
Dialogue: 0,0:13:54.65,0:13:56.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}-Gunakan jumlah pemain untuk serangan balik!\N-Esperion maju sekaligus!
Dialogue: 0,0:14:00.73,0:14:01.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah!
Dialogue: 0,0:14:04.54,0:14:05.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayang sekali!
Dialogue: 0,0:14:06.11,0:14:07.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aksi penyelamatan mati-matian!
Dialogue: 0,0:14:10.25,0:14:11.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tangkisan yang bagus, Towada!
Dialogue: 0,0:14:11.96,0:14:14.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tahan tendangan sudutnya juga!
Dialogue: 0,0:14:14.06,0:14:15.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Towada, hebat sekali!
Dialogue: 0,0:14:17.44,0:14:19.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perasaan apa yang barusan kurasakan tadi?
Dialogue: 0,0:14:20.83,0:14:21.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Formasi".
Dialogue: 0,0:14:22.56,0:14:24.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada saat yang sangat genting,
Dialogue: 0,0:14:24.09,0:14:25.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}persis seperti yang dikatakan Akutsu,
Dialogue: 0,0:14:25.37,0:14:28.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku merasa menunggu di sana menghadap\Nke tengah adalah tindakan yang tepat.
Dialogue: 0,0:14:29.16,0:14:31.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal cara bertahanku\Nbiasanya sama sekali tidak seperti itu.
Dialogue: 0,0:14:32.24,0:14:33.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:14:33.95,0:14:35.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Giring dia ke tengah.
Dialogue: 0,0:14:39.44,0:14:40.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Giring ke tengah…
Dialogue: 0,0:14:42.30,0:14:43.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tengah…
Dialogue: 0,0:14:48.09,0:14:49.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus, Akutsu.
Dialogue: 0,0:14:50.59,0:14:52.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau yang harus mengajarinya baik-baik.
Dialogue: 0,0:14:54.52,0:14:58.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aoi kalah dalam hal teknik\Nmaupun pengalaman.
Dialogue: 0,0:14:58.67,0:14:59.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin bisa\Nmenguasainya dalam sekejap.
Dialogue: 0,0:15:00.81,0:15:02.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, hal terpenting di saat seperti ini
Dialogue: 0,0:15:03.24,0:15:04.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah "Kalau begitu,\Napa yang harus dilakukan?".
Dialogue: 0,0:15:06.11,0:15:09.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam bertahan,\Nmeskipun kemampuan masih kurang,
Dialogue: 0,0:15:09.84,0:15:12.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}melakukan hal-hal kecil saja\Nsudah bisa membantu tim.
Dialogue: 0,0:15:13.24,0:15:15.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taktik menggiring ke tengah tadi\Nadalah contoh klasiknya.
Dialogue: 0,0:15:16.68,0:15:17.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kala itu,
Dialogue: 0,0:15:18.28,0:15:21.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}semua lini pertahanan selain Aoi\Nsudah bersiap di tengah.
Dialogue: 0,0:15:21.85,0:15:22.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan kata lain,
Dialogue: 0,0:15:22.91,0:15:25.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}satu-satunya opsi menggiring bola\Nbagi Kashiwa hanyalah lewat sisi sayap.
Dialogue: 0,0:15:26.32,0:15:30.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, Akutsu menyuruh Aoi\Nuntuk memutus jalur operan ke sayap.
Dialogue: 0,0:15:30.68,0:15:33.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski prinsip dasar bertahan\Nadalah membelakangi gawang,
Dialogue: 0,0:15:34.22,0:15:35.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hal itu tidak berlaku di situasi ini.
Dialogue: 0,0:15:36.04,0:15:39.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alhasil, Kashiwa tidak punya pilihan\Nselain mengoper ke tengah.
Dialogue: 0,0:15:40.00,0:15:42.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, dia menyuruh Aoi menekan ke tengah
Dialogue: 0,0:15:42.19,0:15:43.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk mengepung dari dua sisi\Ndan merebut bolanya.
Dialogue: 0,0:15:44.56,0:15:47.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meskipun tekniknya belum cukup bagus,\Ndia tetap bisa melakukannya.
Dialogue: 0,0:15:47.60,0:15:49.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akutsu memanfaatkannya\Ndengan sangat cerdik.
Dialogue: 0,0:15:50.60,0:15:51.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:15:51.58,0:15:54.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Kemampuan kurang,\Nlalu apa yang harus dilakukan?"
Dialogue: 0,0:15:55.31,0:15:57.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aoi yang sekarang\Nsudah bisa memikirkan jalan keluarnya.
Dialogue: 0,0:15:58.22,0:16:03.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menyaksikan sendiri bagaimana Aoi\Nberkembang begitu pesat saat di Tim B.
Dialogue: 0,0:16:04.44,0:16:06.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski kurasa ini masih terlalu dini,
Dialogue: 0,0:16:07.05,0:16:09.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku bisa memahami alasan\NPelatih Fukuda menurunkannya ke lapangan.
Dialogue: 0,0:16:10.81,0:16:13.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah alasan kau dipasangkan\Ndengan Akutsu, Aoi.
Dialogue: 0,0:16:14.70,0:16:16.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belajarlah dari Akutsu.
Dialogue: 0,0:16:21.34,0:16:22.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat berikan bolanya!
Dialogue: 0,0:16:26.54,0:16:27.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini dia!
Dialogue: 0,0:16:27.74,0:16:30.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peralihan antara menyerang\Ndan bertahan Akutsu sangat cepat.
Dialogue: 0,0:16:30.86,0:16:32.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, aku harus mengimbanginya!
Dialogue: 0,0:16:33.52,0:16:36.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Otakku terus mengatakan hal itu padaku.
Dialogue: 0,0:16:36.78,0:16:37.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat bergerak.
Dialogue: 0,0:16:38.03,0:16:41.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Esperion masih belum menyesuaikan\Npertahanan di sisi pemain nomor 33.
Dialogue: 0,0:16:41.84,0:16:43.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tembus pertahanan mereka dari sana!
Dialogue: 0,0:16:48.79,0:16:49.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sini, 'kan?
Dialogue: 0,0:16:50.12,0:16:53.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus memperpendek jarak\Ndengan pemain yang membawa bola di sini.
Dialogue: 0,0:16:53.68,0:16:54.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salah!
Dialogue: 0,0:16:55.45,0:16:56.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan terpancing keluar!
Dialogue: 0,0:16:56.91,0:16:58.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu di sana!
Dialogue: 0,0:16:58.54,0:17:00.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, sama seperti tadi.
Dialogue: 0,0:17:01.26,0:17:02.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti yang dikatakan Akutsu,
Dialogue: 0,0:17:02.73,0:17:04.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tetap berada di posisi ini
Dialogue: 0,0:17:04.60,0:17:06.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}membuat "tekanan" itu terasa makin kuat.
Dialogue: 0,0:17:07.48,0:17:09.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memberikan "tekanan" yang lebih nyata\Nkepada Kashiwa.
Dialogue: 0,0:17:11.42,0:17:13.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kashiwa ragu-ragu lagi.
Dialogue: 0,0:17:14.04,0:17:16.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya ada apa\Ndengan pertahanan orang-orang ini?
Dialogue: 0,0:17:16.96,0:17:20.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setiap kali bersiap melancarkan serangan,\Nrasanya benar-benar seperti
Dialogue: 0,0:17:22.09,0:17:24.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebuah pilar raksasa mendadak berdiri\Ntepat di depan mata.
Dialogue: 0,0:17:25.47,0:17:27.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sialan.
Dialogue: 0,0:17:27.03,0:17:29.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nomor 33 yang tadinya merupakan\Nsatu-satunya celah,
Dialogue: 0,0:17:30.11,0:17:32.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}gerakannya malah makin gesit.
Dialogue: 0,0:17:33.52,0:17:35.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang jaga nomor 10, Bodoh!
Dialogue: 0,0:17:35.85,0:17:36.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat bergerak!
Dialogue: 0,0:17:36.75,0:17:37.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, baik!
Dialogue: 0,0:17:41.43,0:17:43.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Da-Datang lagi.
Dialogue: 0,0:17:44.19,0:17:45.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Formasi saat ini
Dialogue: 0,0:17:46.52,0:17:48.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}memberikan kesan yang sangat kokoh.
Dialogue: 0,0:17:57.26,0:17:58.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bentuk L.
Dialogue: 0,0:17:59.81,0:18:02.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salah satu perbedaan mendasar\Nantara pemain kelas dunia dan Liga J
Dialogue: 0,0:18:03.21,0:18:07.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah kemampuan mereka menerapkan\Npola berbentuk L ini dengan sempurna.
Dialogue: 0,0:18:08.06,0:18:09.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membentuk segitiga juga boleh.
Dialogue: 0,0:18:10.81,0:18:14.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini terjadi saat bek sayap atau tengah berebut bola.
Dialogue: 0,0:18:14.83,0:18:15.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sisa pemain di lini pertahanan
Dialogue: 0,0:18:15.80,0:18:19.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}seketika merapat ke tengah.
Dialogue: 0,0:18:19.00,0:18:22.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemain Jepang sering remehkan formasi ini
Dialogue: 0,0:18:22.24,0:18:24.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan mudah membiarkan formasi berantakan.
Dialogue: 0,0:18:25.45,0:18:27.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertahanan selalu bergantung pada formasi.
Dialogue: 0,0:18:28.09,0:18:29.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harus bergerak secara terkoordinasi.
Dialogue: 0,0:18:29.74,0:18:30.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ashito.
Dialogue: 0,0:18:35.36,0:18:37.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa boleh buat,\NPelatih Fukuda sudah bicara.
Dialogue: 0,0:18:38.46,0:18:41.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, kurasa kau tidak paham\Narti dari semua instruksi ini.
Dialogue: 0,0:18:41.72,0:18:43.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku akan memanfaatkanmu\Nsebagai pion saja.
Dialogue: 0,0:18:44.72,0:18:46.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bergeraklah sesuai instruksiku.
Dialogue: 0,0:18:49.00,0:18:50.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ga-Gawat!
Dialogue: 0,0:18:50.75,0:18:51.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku gagal menghalau bolanya!
Dialogue: 0,0:18:57.56,0:19:00.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bertahan berarti membangun formasi.
Dialogue: 0,0:19:00.43,0:19:02.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus! Ini kesempatan emas!
Dialogue: 0,0:19:02.94,0:19:05.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saling mengisi posisi dan membantu\Npertahanan dengan pemain bertahan lainnya,
Dialogue: 0,0:19:05.23,0:19:08.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}serta selalu menjaga kesadaran\Nakan formasi tim.
Dialogue: 0,0:19:08.64,0:19:11.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, di mana aku harus berdiri sekarang
Dialogue: 0,0:19:11.90,0:19:14.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}agar bisa menjadi bagian dari formasi itu?
Dialogue: 0,0:19:17.37,0:19:19.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya perlu berpikir matang\Nsebelum bertindak.
Dialogue: 0,0:19:21.53,0:19:22.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika aku adalah Akutsu,
Dialogue: 0,0:19:23.52,0:19:25.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}saat formasi hampir ditembus,
Dialogue: 0,0:19:26.54,0:19:27.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di mana aku
Dialogue: 0,0:19:28.64,0:19:30.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ingin menempatkan diriku?
Dialogue: 0,0:19:37.80,0:19:38.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh!
Dialogue: 0,0:19:39.24,0:19:41.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyelamatan yang bagus!
Dialogue: 0,0:19:50.54,0:19:51.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat sekali.
Dialogue: 0,0:19:51.69,0:19:53.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gerakannya makin lama makin gesit.
Dialogue: 0,0:19:53.55,0:19:55.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berikutnya, giliran menyerang.
Dialogue: 0,0:19:55.04,0:19:57.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cetak satu gol lagi untuk memberi\NKashiwa pukulan telak!
Dialogue: 0,0:19:58.32,0:19:59.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah!
Dialogue: 0,0:20:00.54,0:20:01.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh!
Dialogue: 0,0:20:02.40,0:20:03.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu…
Dialogue: 0,0:20:17.69,0:20:18.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu adalah
Dialogue: 0,0:20:19.13,0:20:20.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuribayashi.
Dialogue: 0,0:20:22.88,0:20:23.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus.
Dialogue: 0,0:20:25.37,0:20:26.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita maju.
Dialogue: 0,0:20:30.73,0:20:33.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika tidak tahu harus berbuat apa,\Noper saja bolanya kepada Kuribayashi.
Dialogue: 0,0:20:33.26,0:20:34.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Hah?
Dialogue: 0,0:20:34.80,0:20:37.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang kau sudah kewalahan, 'kan?
Dialogue: 0,0:20:37.15,0:20:37.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah…
Dialogue: 0,0:20:38.28,0:20:40.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika tidak tahu harus berbuat apa,\Ncari Kuribayashi dan oper bola kepadanya.
Dialogue: 0,0:20:41.37,0:20:42.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu saja sudah cukup.
Dialogue: 0,0:20:45.60,0:20:47.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fokus saja pada pertandingan!
Dialogue: 0,0:20:47.56,0:20:48.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh.
Dialogue: 0,0:20:49.05,0:20:52.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuribayashi sudah lama tidak mendapat\Nkesempatan bermain di Tim Utama.
Dialogue: 0,0:20:52.88,0:20:54.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Insting bertandingnya sudah lama\Ntidak terasah.
Dialogue: 0,0:20:54.65,0:20:57.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang seperti dia turun ke lapangan pun\Ntidak akan mengubah apa pun.
Dialogue: 0,0:20:57.50,0:20:58.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita maju!
Dialogue: 0,0:20:58.43,0:20:59.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:20:59.15,0:21:03.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}0 - 1
Dialogue: 0,0:21:05.66,0:21:06.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kembali bertahan!
Dialogue: 0,0:21:06.76,0:21:08.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sampai mereka mencetak gol!
Dialogue: 0,0:21:11.34,0:21:12.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tendangannya terlalu keras.
Dialogue: 0,0:21:12.38,0:21:14.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka terlalu terburu-buru\Nmengoper bola ke Kuribayashi.
Dialogue: 0,0:21:56.00,0:21:59.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang paling kompak\Nkalau bermain bola bersama kalian.
Dialogue: 0,0:22:03.84,0:22:07.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}0 - 2
Dialogue: 0,0:24:00.06,0:24:02.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia memberikan kejutan sebesar ini\Ndi akhir pertandingan.
Dialogue: 0,0:24:03.32,0:24:04.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar sosok pemain impian.
Dialogue: 0,0:24:05.71,0:24:08.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Kalau begitu, apa\Nyang harus dilakukan," Ashito?
Dialogue: 0,0:24:09.31,0:24:11.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah hanya akan terpaku menonton\Nseperti ini sampai pertandingan berakhir?
Dialogue: 0,0:24:13.00,0:24:14.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa mungkin…
Dialogue: 0,0:24:15.53,0:24:16.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa ini?
Dialogue: 0,0:24:16.68,0:24:17.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maju!
Dialogue: 0,0:24:17.74,0:24:20.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}-Kenapa kau mengintip begitu?\N-Sebenarnya ada apa dengan orang ini?
Dialogue: 0,0:24:20.52,0:24:21.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya ada satu pemain yang bertahan.
Dialogue: 0,0:24:21.56,0:24:24.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}-Asalkan ada satu orang menyusup ke sana,\N-Kau tidak semenarik yang kukira, Togashi.
Dialogue: 0,0:24:24.48,0:24:26.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}-itu bisa jadi titik awal serangan balik.\N-Ini pertama kalinya
Dialogue: 0,0:24:26.88,0:24:28.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku merasakan hal seperti ini.
