Dialogue: 0,0:00:18.35,0:00:21.89,sign,,0000,0000,0000,,KLUB SEPAK BOLA ESPERION - 1983
Dialogue: 0,0:00:21.89,0:00:22.93,sign,,0000,0000,0000,,B KE A: OTOMO, AOI…
Dialogue: 0,0:00:22.93,0:00:23.85,sign,,0000,0000,0000,,A KE B: NAGANO…
Dialogue: 0,0:00:23.85,0:00:24.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktunya tiba.
Dialogue: 0,0:00:25.77,0:00:27.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai hari ini kau Tim A.
Dialogue: 0,0:00:27.86,0:00:29.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalahkan mereka, Ashito.
Dialogue: 0,0:00:30.23,0:00:31.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:00:31.61,0:00:32.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau juga, Tachibana.
Dialogue: 0,0:00:32.86,0:00:33.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menunggumu.
Dialogue: 0,0:00:35.49,0:00:37.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami mengandalkanmu, Yuma!\NHanya kau harapan kami!
Dialogue: 0,0:00:37.99,0:00:41.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bantu kami menjembatani jarak\Ndengan para senior Tim A!
Dialogue: 0,0:00:42.79,0:00:45.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tak butuh jembatan.
Dialogue: 0,0:00:45.62,0:00:47.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, apa maksudmu, Togashi?
Dialogue: 0,0:00:48.46,0:00:52.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak ada gunanya berteman dengan\Norang-orang yang akan kita cadangkan.
Dialogue: 0,0:00:54.88,0:00:57.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku takkan pernah kembali ke Tim B!
Dialogue: 0,0:00:59.43,0:01:00.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga.
Dialogue: 0,0:01:09.98,0:01:12.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku takkan kembali ke Tim B!
Dialogue: 0,0:03:00.59,0:03:03.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agak ramai, ya?
Dialogue: 0,0:03:03.80,0:03:06.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa latihan Tim A selalu begini?
Dialogue: 0,0:03:06.68,0:03:08.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:03:08.89,0:03:12.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuribayashi kembali,\Njadi mereka datang untuk melihatnya.
Dialogue: 0,0:03:13.61,0:03:17.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia bahkan tak berlatih hari ini,\Nrasakan itu.{\i0}
Dialogue: 0,0:03:20.45,0:03:24.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Di sini, di Vietnam, pada babak\Npenyisihan grup Liga Champions Asia,{\i0}
Dialogue: 0,0:03:25.49,0:03:29.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tokyo City Esperion\Nmengalahkan Hanoi SC 3-0.{\i0}
Dialogue: 0,0:03:30.20,0:03:32.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pemain 16 tahun\Nyang dinantikan, Kuribayashi,{\i0}
Dialogue: 0,0:03:32.92,0:03:35.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}masuk di menit ke-25 babak kedua.{\i0}
Dialogue: 0,0:03:36.04,0:03:40.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ini menjadi penampilan keenam Kuribayashi\Nsejak debut di J1.{\i0}
Dialogue: 0,0:03:40.51,0:03:44.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Penggemar berharap dia jadi\Npencetak gol termuda ACL, tapi…{\i0}
Dialogue: 0,0:03:44.97,0:03:45.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuribayashi.
Dialogue: 0,0:03:47.26,0:03:50.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana ACL pertamamu?
Dialogue: 0,0:03:50.73,0:03:55.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa Pelatih Kepala Garulla\Nberkomentar soal penampilanku?
Dialogue: 0,0:03:56.81,0:03:59.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti biasa, dia memujimu.
Dialogue: 0,0:03:59.94,0:04:01.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penampilanmu bagus.
Dialogue: 0,0:04:03.57,0:04:05.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu, Kuribayashi.
Dialogue: 0,0:04:06.82,0:04:08.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktumu di tim utama sudah usai.
Dialogue: 0,0:04:11.20,0:04:13.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kembalilah ke tim Youth di Jepang nanti.
Dialogue: 0,0:04:14.00,0:04:17.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, kaubilang permainanku bagus,\Napa Garulla yang…
Dialogue: 0,0:04:18.00,0:04:20.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, ini arahan Fukuda.
Dialogue: 0,0:04:21.59,0:04:23.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia meminta agar kau\Ndipindahkan sementara.
Dialogue: 0,0:04:29.22,0:04:33.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lapangan latihan berisik sekali!
Dialogue: 0,0:04:33.81,0:04:36.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benar-benar melek sekarang!
Dialogue: 0,0:04:36.90,0:04:39.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku ingin tidur\Nsampai detik terakhir.
Dialogue: 0,0:04:39.86,0:04:40.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yoshitsune.
Dialogue: 0,0:04:40.94,0:04:41.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:04:41.99,0:04:44.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuribayashi kembali.
Dialogue: 0,0:04:47.12,0:04:50.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Coba kita lihat, apa tulisannya?
Dialogue: 0,0:04:51.37,0:04:58.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}"Pemain berbakat Kuribayashi gagal raih\Nkepercayaan Garulla. Debut ACL hambar."
Dialogue: 0,0:04:58.46,0:05:03.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Reporter itu selalu tulis artikel pedas,\Ntak peduli bagaimana Kuribayashi main.
Dialogue: 0,0:05:05.22,0:05:06.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Begitu rupanya.
Dialogue: 0,0:05:08.51,0:05:10.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuribayashi!
Dialogue: 0,0:05:10.39,0:05:13.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapan kau masuk ke dalam gedung?
Dialogue: 0,0:05:14.18,0:05:17.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada banyak orang menunggumu di luar.
Dialogue: 0,0:05:17.94,0:05:22.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mibu dari Humas membantuku\Ndan membawa van bento keluarganya.
Dialogue: 0,0:05:22.23,0:05:23.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuribayashi si Landak!
Dialogue: 0,0:05:24.19,0:05:27.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak ada yang akan menyangka\Nada pemain di dalam mobil itu.
Dialogue: 0,0:05:27.66,0:05:30.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau baik-baik saja?
Dialogue: 0,0:05:30.49,0:05:31.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelatih Fukuda mana?
Dialogue: 0,0:05:33.16,0:05:34.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi di lobi bersama Akutsu…
Dialogue: 0,0:05:42.80,0:05:44.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Akkun.
Dialogue: 0,0:05:49.93,0:05:53.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari jangan ganggu mereka.
Dialogue: 0,0:05:53.06,0:05:53.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak apa-apa.
Dialogue: 0,0:05:55.02,0:05:57.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak masalah kalian mendengarnya.
Dialogue: 0,0:05:58.73,0:06:01.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa beri tahu alasannya, Pelatih Fukuda?
Dialogue: 0,0:06:09.49,0:06:10.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anggap saja
Dialogue: 0,0:06:10.95,0:06:11.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}itu firasat.
Dialogue: 0,0:06:13.87,0:06:16.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, itu jawaban yang membosankan.
Dialogue: 0,0:06:16.50,0:06:17.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama,
Dialogue: 0,0:06:17.96,0:06:21.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Liga Premier sangat menarik saat ini!
Dialogue: 0,0:06:21.92,0:06:24.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duduk di cadangan J. League\Ncuma buang waktu.
Dialogue: 0,0:06:25.21,0:06:26.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekolah-sekolah ini bagus.
Dialogue: 0,0:06:26.76,0:06:29.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tim mereka hebat tahun ini.\NMereka semua kuat!
Dialogue: 0,0:06:30.13,0:06:31.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Posisi pertama SMA Akademi Funabashi.
Dialogue: 0,0:06:32.47,0:06:35.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita kedua,\NSMA Aomori Seiran di posisi ketiga.
Dialogue: 0,0:06:36.10,0:06:39.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti kata Pelatih,\Nmereka sangat kuat tahun ini.
Dialogue: 0,0:06:40.10,0:06:41.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak keuntungan melawan mereka.
Dialogue: 0,0:06:42.61,0:06:46.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada serangkaian pertandingan\Nmelawan SMA sebentar lagi.
Dialogue: 0,0:06:47.74,0:06:48.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu…
Dialogue: 0,0:06:49.65,0:06:51.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa lebih berkembang di tim senior.
Dialogue: 0,0:06:52.62,0:06:55.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada alasan lain yang lebih besar.
Dialogue: 0,0:06:57.25,0:06:58.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tahu…
Dialogue: 0,0:06:58.96,0:07:00.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenanglah sedikit.
Dialogue: 0,0:07:01.87,0:07:06.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau selalu terlalu maju\Ndi tiap laga tim utama.
Dialogue: 0,0:07:06.30,0:07:07.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tak seperti dirimu.
Dialogue: 0,0:07:08.88,0:07:12.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau cuma berusaha mencari perhatian.
Dialogue: 0,0:07:12.84,0:07:14.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan di laga ACL terakhir,
Dialogue: 0,0:07:15.05,0:07:19.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}kau sengaja menahan bola dua kali,\Nalih-alih melepas satu umpan mulus.{\i0}
Dialogue: 0,0:07:20.02,0:07:22.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kau ingin memamerkan teknikmu{\i0}
Dialogue: 0,0:07:22.35,0:07:25.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}ke pelatih kepala dan penggemar\Nsebelum mengoper.{\i0}
Dialogue: 0,0:07:26.40,0:07:27.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku tahu niatmu.{\i0}
Dialogue: 0,0:07:27.86,0:07:30.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kau ingin pengakuan sebagai pemain inti.{\i0}
Dialogue: 0,0:07:31.03,0:07:33.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku mengerti perasaanmu, Kuribayashi.{\i0}
Dialogue: 0,0:07:36.74,0:07:42.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, bagiku, kau kehilangan kendali.
Dialogue: 0,0:07:42.00,0:07:46.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu mungkin karena penonton di luar sana.
Dialogue: 0,0:07:47.17,0:07:51.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau kehilangan jati dirimu\Ndemi memenuhi harapan mereka.
Dialogue: 0,0:07:51.97,0:07:55.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin menghentikan itu untukmu.
Dialogue: 0,0:08:03.48,0:08:07.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelatih Fukuda,\Napa yang paling kau cemaskan
Dialogue: 0,0:08:07.11,0:08:11.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau aku hilang kendali?
Dialogue: 0,0:08:11.19,0:08:14.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa…
Dialogue: 0,0:08:14.03,0:08:16.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kemungkinan kau akan cedera.
Dialogue: 0,0:08:18.37,0:08:19.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berlaku untuk kalian semua.
Dialogue: 0,0:08:20.87,0:08:22.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sampai terluka, ya.
Dialogue: 0,0:08:23.04,0:08:24.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jaga ketajaman instingmu.
Dialogue: 0,0:08:25.37,0:08:28.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat merasakan bahaya,\Nmundur juga butuh keberanian.
Dialogue: 0,0:08:29.30,0:08:32.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf kalau kurang jelas,\Ntapi cuma itu yang bisa kukatakan.
Dialogue: 0,0:08:34.63,0:08:35.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:08:36.18,0:08:37.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan ikuti instruksi pelatih.
Dialogue: 0,0:08:40.14,0:08:41.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu menyeramkan.
Dialogue: 0,0:08:41.93,0:08:43.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau aku bagaimana?
Dialogue: 0,0:08:46.10,0:08:48.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, sebenarnya itu…
Dialogue: 0,0:08:51.19,0:08:52.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}membuatku cukup lega.
Dialogue: 0,0:08:53.95,0:08:56.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Garulla ingin kau tetap\Ndalam pengawasannya.
Dialogue: 0,0:08:57.16,0:08:59.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mewanti-wantiku\Nbahwa ini hanya dua bulan.
Dialogue: 0,0:08:59.78,0:09:02.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya?\NPokoknya, aku akan tidur hari ini.
Dialogue: 0,0:09:02.91,0:09:05.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baru pulang dari Vietnam tadi pagi.
Dialogue: 0,0:09:05.50,0:09:07.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, istirahatlah.
Dialogue: 0,0:09:09.04,0:09:10.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong,
Dialogue: 0,0:09:11.71,0:09:14.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}siapa bek sayapnya?
Dialogue: 0,0:09:15.17,0:09:16.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum diputuskan.
Dialogue: 0,0:09:17.22,0:09:18.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:09:20.47,0:09:24.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik. Aku pergi dulu.\NJangan terlambat latihan.
Dialogue: 0,0:09:24.64,0:09:25.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:09:33.44,0:09:37.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Obrolan mereka memang beda level. Sial!
Dialogue: 0,0:09:37.70,0:09:42.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sengaja memamerkan tekniknya di ACL?
Dialogue: 0,0:09:43.04,0:09:45.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu dia ditarik mundur karena itu bahaya?
Dialogue: 0,0:09:46.54,0:09:49.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Obrolan mereka\Nmelampaui level profesional.
Dialogue: 0,0:09:49.71,0:09:53.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, inilah awalnya, Kuribayashi.
Dialogue: 0,0:09:53.09,0:09:57.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku tidak berniat puas\Nhanya menjadi nomor duamu.
Dialogue: 0,0:09:57.05,0:09:58.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku akan melampauimu!
Dialogue: 0,0:09:59.05,0:10:00.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bersumpah!
Dialogue: 0,0:10:01.39,0:10:05.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti tim akan lebih bersemangat\Ndengan kembalinya Kuribayashi.
Dialogue: 0,0:10:05.52,0:10:07.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, aku menantikannya.
Dialogue: 0,0:10:08.14,0:10:10.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Esperion terkuat akan makin solid.
Dialogue: 0,0:10:10.77,0:10:14.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bicara soal itu,\Nentah apa mereka bisa memperkokoh tim,
Dialogue: 0,0:10:14.40,0:10:16.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi ada talenta baru hari ini.
Dialogue: 0,0:10:16.99,0:10:19.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Promosi dari Tim B. Empat anak kelas satu.
Dialogue: 0,0:10:19.82,0:10:22.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau hebat selalu memantau\Nhal seperti itu, Taira.
Dialogue: 0,0:10:22.74,0:10:23.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada Kuroda dan…
Dialogue: 0,0:10:23.95,0:10:26.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tak perlu tahu nama mereka.
Dialogue: 0,0:10:27.54,0:10:29.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Toh mereka akan kewalahan di awal.
Dialogue: 0,0:10:34.96,0:10:36.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menegangkan, bukan?
Dialogue: 0,0:10:36.55,0:10:37.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:10:59.65,0:11:01.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Rumput alami yang lembut.{\i0}
Dialogue: 0,0:11:02.87,0:11:05.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tim A selalu berlatih di sini.{\i0}
Dialogue: 0,0:11:07.91,0:11:09.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dua kali juara Liga Premier.{\i0}
Dialogue: 0,0:11:09.96,0:11:11.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tim Youth terkuat.{\i0}
Dialogue: 0,0:11:12.96,0:11:13.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku…{\i0}
Dialogue: 0,0:11:15.29,0:11:17.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}akhirnya mencapai garis start!{\i0}
Dialogue: 0,0:11:37.02,0:11:39.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakaknya Tachibana.
Dialogue: 0,0:11:41.95,0:11:43.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau…
Dialogue: 0,0:11:43.11,0:11:45.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau datang untuk mengamati tim Youth kami?
Dialogue: 0,0:11:45.74,0:11:48.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku libur latihan hari ini,
Dialogue: 0,0:11:48.83,0:11:50.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi aku datang menonton.
Dialogue: 0,0:11:50.50,0:11:54.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini Tim A. Tachibana tak di sini.
Dialogue: 0,0:11:55.63,0:11:57.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga pemain,
Dialogue: 0,0:11:57.96,0:11:58.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi aku penasaran.
Dialogue: 0,0:11:59.55,0:12:00.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentangnya.
Dialogue: 0,0:12:04.43,0:12:05.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bertanding kemarin.
Dialogue: 0,0:12:06.39,0:12:07.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada anak baru juga.
Dialogue: 0,0:12:08.14,0:12:10.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akan latihan ringan.
Dialogue: 0,0:12:10.56,0:12:11.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Latihan oper gaya Osim.
Dialogue: 0,0:12:12.52,0:12:16.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita juga sering latihan ini di Tim B.\NApa dia menyesuaikan level kita?
Dialogue: 0,0:12:16.90,0:12:18.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama,
Dialogue: 0,0:12:19.48,0:12:20.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jangan dikontrol.
Dialogue: 0,0:12:20.78,0:12:22.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alirkan bola pakai umpan langsung saja.
Dialogue: 0,0:12:22.86,0:12:27.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu bek. Tingkat kesulitan\Nakan dinaikkan bertahap. Itu saja.
Dialogue: 0,0:12:27.66,0:12:28.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, Pelatih.
Dialogue: 0,0:12:33.62,0:12:35.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, Ashito?
Dialogue: 0,0:12:40.17,0:12:42.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tim utama.
Dialogue: 0,0:12:42.26,0:12:43.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taira.
Dialogue: 0,0:12:43.17,0:12:47.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taira! Melihat wajahmu sangat melegakan.
Dialogue: 0,0:12:47.18,0:12:51.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pendatang baru akan bermain dengan kami\Ndi tim pelapis Tim A.
Dialogue: 0,0:12:52.93,0:12:54.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di mana Yuma?
Dialogue: 0,0:12:56.15,0:13:00.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita memang kekurangan penyerang,\Ntetapi dia sungguh hebat.
Dialogue: 0,0:13:00.02,0:13:03.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yuma, katanya mau menjembatani?
Dialogue: 0,0:13:03.82,0:13:06.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?\NKau ingin bergabung dengan mereka?
Dialogue: 0,0:13:07.07,0:13:08.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ya.\N- Apa?
Dialogue: 0,0:13:08.87,0:13:13.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika harus merasakan jurang kemampuan\Nsebesar ini, lebih cepat lebih baik.
Dialogue: 0,0:13:13.25,0:13:15.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bicara apa dia?
Dialogue: 0,0:13:15.96,0:13:19.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudahlah. Dia hanya\Nsedang bersemangat, Matsunaga.
Dialogue: 0,0:13:19.00,0:13:22.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tampak terburu-buru\Nsejak hari pertama,
Dialogue: 0,0:13:23.05,0:13:26.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}padahal di tim pelapis Tim A pun,\Nkau akan kewalahan di awal.
Dialogue: 0,0:13:27.76,0:13:28.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat saja nanti.
Dialogue: 0,0:13:35.89,0:13:37.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kuroda!\N- Ashito!
Dialogue: 0,0:13:37.02,0:13:37.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taira!
Dialogue: 0,0:13:37.98,0:13:39.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Matsunaga!\N- Baba!
Dialogue: 0,0:13:39.94,0:13:41.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Latihan oper gaya Osim.
Dialogue: 0,0:13:42.65,0:13:45.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pemegang bola memanggil nama pemain lain{\i0}
Dialogue: 0,0:13:45.36,0:13:48.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}untuk menentukan target berikutnya.{\i0}
Dialogue: 0,0:13:49.32,0:13:53.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Penerima harus mengoper\Nke pemain tersebut.{\i0}
Dialogue: 0,0:13:54.12,0:13:56.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bahkan sebelum bola tiba,{\i0}
Dialogue: 0,0:13:56.29,0:13:59.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}penerima harus sudah tahu\Nposisi targetnya,{\i0}
Dialogue: 0,0:13:59.29,0:14:00.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dan pilih pemain{\i0}
Dialogue: 0,0:14:00.46,0:14:04.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}agar operan berikutnya\Nsulit untuk dicuri pemain belakang.{\i0}
Dialogue: 0,0:14:04.88,0:14:08.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Lalu tentukan pemain berikutnya dan oper.\NBegitu terus tanpa putus.{\i0}
Dialogue: 0,0:14:09.05,0:14:14.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gagal total jika hanya terpaku pada bola\Natau mengandalkan olah kaki.
Dialogue: 0,0:14:15.39,0:14:17.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat sekeliling dan berpikirlah.
Dialogue: 0,0:14:17.89,0:14:20.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Latihan ini menguji kemampuan itu\Nhingga batasnya.
Dialogue: 0,0:14:20.56,0:14:21.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuroda!
Dialogue: 0,0:14:22.82,0:14:23.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlalu lambat!
Dialogue: 0,0:14:26.32,0:14:27.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ganti.
Dialogue: 0,0:14:29.03,0:14:31.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kecepatan operannya terlalu cepat!{\i0}
Dialogue: 0,0:14:31.70,0:14:32.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuroda!
Dialogue: 0,0:14:32.83,0:14:34.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Osieck!\N- Aoi!
Dialogue: 0,0:14:34.49,0:14:35.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Otomo!
Dialogue: 0,0:14:35.83,0:14:39.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Otakku tak bisa mengikuti kakiku.{\i0}
Dialogue: 0,0:14:39.08,0:14:43.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bola sudah datang\Nsaat aku masih mencari pemain berikutnya!{\i0}
Dialogue: 0,0:14:43.34,0:14:46.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dan kesulitannya masih akan dinaikkan?{\i0}
Dialogue: 0,0:14:46.76,0:14:48.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Yang benar saja…{\i0}
Dialogue: 0,0:14:48.59,0:14:49.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aoi!
Dialogue: 0,0:14:49.80,0:14:51.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kau, anak kelas satu.{\i0}
Dialogue: 0,0:14:51.84,0:14:56.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sebelum omong besar,\Nbuktikan dulu kau bisa teknik dasarnya.{\i0}
Dialogue: 0,0:14:56.10,0:14:57.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ozzie!
Dialogue: 0,0:14:58.98,0:15:01.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jika kubuktikan diriku di sini,{\i0}
Dialogue: 0,0:15:01.23,0:15:04.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}aku bisa masuk J. League\Nbahkan sebagai anak SMA.{\i0}
Dialogue: 0,0:15:04.94,0:15:07.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itulah inti dari tim utama J-Youth.{\i0}
Dialogue: 0,0:15:07.48,0:15:09.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Jika kulakukan itu,\Nimpianku akan terwujud.{\i0}
Dialogue: 0,0:15:09.70,0:15:12.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku bisa mengirim uang ke Ibu!{\i0}
Dialogue: 0,0:15:13.32,0:15:16.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau akan kewalahan di awal.\NLihat saja nanti.
Dialogue: 0,0:15:16.83,0:15:20.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Meski harus merangkak,\Naku tak akan turun ke Tim B!{\i0}
Dialogue: 0,0:15:20.71,0:15:23.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku akan membuktikan diriku di sini!{\i0}
Dialogue: 0,0:15:28.34,0:15:29.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuroda!
Dialogue: 0,0:15:29.30,0:15:30.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Aoi!\N- Matsunaga!
Dialogue: 0,0:15:30.26,0:15:31.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Otomo!
Dialogue: 0,0:15:32.76,0:15:34.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Orang ini…{\i0}
Dialogue: 0,0:15:35.89,0:15:38.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ashito ternyata bisa mengikuti!
Dialogue: 0,0:15:41.64,0:15:42.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:15:42.85,0:15:45.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tambahkan satu bola lagi!
Dialogue: 0,0:15:45.15,0:15:46.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:15:46.82,0:15:50.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian anak baru terlihat lelah.
Dialogue: 0,0:15:50.15,0:15:52.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asal tahu saja,\Nsejauh ini semua baru dasar.
Dialogue: 0,0:15:52.78,0:15:55.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai sekarang,\Nmenerapkannya yang penting.
Dialogue: 0,0:15:55.66,0:15:57.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menerapkannya?
Dialogue: 0,0:15:58.41,0:16:00.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kau pasti bercanda.{\i0}
Dialogue: 0,0:16:00.79,0:16:05.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku tak bisa mengikuti kecepatan ini,\Ndan sekarang ada dua bola?{\i0}
Dialogue: 0,0:16:16.89,0:16:19.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keputusanmu terlalu lambat!
Dialogue: 0,0:16:19.14,0:16:22.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan terpaku pada bola!\NAmati pemain! Amati ruang!
Dialogue: 0,0:16:23.81,0:16:26.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku tak bisa melakukan ini.{\i0}
Dialogue: 0,0:16:26.48,0:16:30.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kini ada dua bola,\Nwaktuku lebih sedikit untuk berpikir.{\i0}
Dialogue: 0,0:16:30.94,0:16:34.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Otomo dan aku terus membuat kesalahan,{\i0}
Dialogue: 0,0:16:34.03,0:16:35.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}jadi kami terjebak terus bertahan.{\i0}
Dialogue: 0,0:16:37.45,0:16:39.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa hanya kami berdua?{\i0}
Dialogue: 0,0:16:42.37,0:16:44.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, jangan malas, anak kelas satu!
Dialogue: 0,0:16:44.46,0:16:45.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini dia, Kuroda!
Dialogue: 0,0:16:47.92,0:16:49.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kuroda!\N- Baba!
Dialogue: 0,0:16:49.04,0:16:50.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Togashi!\N- Aoi!
Dialogue: 0,0:16:50.13,0:16:51.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Matsunaga!\N- Ozzie!
Dialogue: 0,0:16:51.17,0:16:52.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Baba!\N- Matsunaga!
Dialogue: 0,0:16:52.17,0:16:53.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Aoi!\N- Togashi!
Dialogue: 0,0:16:53.09,0:16:54.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baba!
Dialogue: 0,0:16:54.88,0:16:57.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kuroda wajar saja\Nkarena dia dulu di tim A,{\i0}
Dialogue: 0,0:16:57.72,0:16:59.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}tapi si keriting juga bisa mengikuti.{\i0}
Dialogue: 0,0:17:00.39,0:17:03.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia bisa bertahan bahkan dengan dua bola.{\i0}
Dialogue: 0,0:17:03.89,0:17:04.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuroda!
Dialogue: 0,0:17:04.85,0:17:05.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Taira!\N- Matsunaga!
Dialogue: 0,0:17:05.77,0:17:06.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Togashi!\N- Kuroda!
Dialogue: 0,0:17:06.73,0:17:07.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Baba!\N- Matsunaga!
Dialogue: 0,0:17:07.69,0:17:08.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ashito!\N- Baba!
Dialogue: 0,0:17:09.27,0:17:12.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kecepatannya luar biasa!\NJauh lebih cepat dari Tim B.{\i0}
Dialogue: 0,0:17:12.32,0:17:13.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun…{\i0}
Dialogue: 0,0:17:13.32,0:17:16.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kaupikir semuanya akan mudah\Nbegitu tiba di sini, 'kan?
Dialogue: 0,0:17:16.86,0:17:20.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kaupikir lama-lama\Nkau akan bisa juga, 'kan?
Dialogue: 0,0:17:20.70,0:17:22.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku sudah tidak sama seperti dulu!{\i0}
Dialogue: 0,0:17:23.00,0:17:27.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Harus sekarang!\NAku harus bisa melakukan ini sekarang!{\i0}
Dialogue: 0,0:17:27.46,0:17:29.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Karena aku sudah naik ke Tim A!{\i0}
Dialogue: 0,0:17:29.50,0:17:30.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Togashi!
Dialogue: 0,0:17:31.21,0:17:33.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Operan melayang. Ini…{\i0}
Dialogue: 0,0:17:33.71,0:17:38.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku mengujimu, anak kelas satu.\NMari kita lihat responsmu.{\i0}
Dialogue: 0,0:17:42.35,0:17:43.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Siapakah?{\i0}
Dialogue: 0,0:17:44.27,0:17:45.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dari posisi Togashi,{\i0}
Dialogue: 0,0:17:46.85,0:17:47.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}siapakah?{\i0}
Dialogue: 0,0:17:49.86,0:17:51.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Matsunaga!
Dialogue: 0,0:17:59.03,0:18:01.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial! Padahal aku tahu persis\Nharus mengoper ke mana!
Dialogue: 0,0:18:02.33,0:18:06.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, olah kaki\Ndan langkah pertamaku tak bisa mengikuti!
Dialogue: 0,0:18:06.29,0:18:07.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial!
Dialogue: 0,0:18:08.46,0:18:12.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau bagaimana lagi.\NGiliranku mengejar. Oper terus!
Dialogue: 0,0:18:13.88,0:18:17.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa? Ayo lanjut!\NCepatlah, ayo bergerak, Semuanya!
Dialogue: 0,0:18:19.68,0:18:21.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ashito! Kuroda juga.
Dialogue: 0,0:18:22.26,0:18:23.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bergabunglah dengan mereka.
Dialogue: 0,0:18:27.23,0:18:30.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelas satu berambut keriting itu\Npunya gerakan bagus.
Dialogue: 0,0:18:32.69,0:18:34.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuribayashi?
Dialogue: 0,0:18:34.27,0:18:36.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namanya Ashito Aoi, ya?
Dialogue: 0,0:18:36.94,0:18:38.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau di sini?
Dialogue: 0,0:18:38.90,0:18:43.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hampir semua pengunjung hari ini\Ningin melihatmu.
Dialogue: 0,0:18:43.12,0:18:45.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian para sponsor\Nsangat suka berceramah.
Dialogue: 0,0:18:45.95,0:18:49.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau baru kembali dari Vietnam.\NApa kau sempat tidur?
Dialogue: 0,0:18:50.17,0:18:52.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, aku tidur selama 30 menit.
Dialogue: 0,0:18:53.63,0:18:56.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya si Aoi itu\Nbergabung ke tim inti.
Dialogue: 0,0:18:57.46,0:18:58.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menarik ditonton.
Dialogue: 0,0:18:59.22,0:19:02.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biarkan mereka bermain tanpa penalti.
Dialogue: 0,0:19:03.43,0:19:05.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Walau mengacau,\Nmereka takkan disuruh bertahan.
Dialogue: 0,0:19:14.73,0:19:16.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelatih Fukuda tak bisa ditebak.
Dialogue: 0,0:19:17.23,0:19:19.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mungkin hanya menguji kita.
Dialogue: 0,0:19:19.99,0:19:22.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, Aoi, ini kesempatan kita.
Dialogue: 0,0:19:23.12,0:19:26.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, Kuroda. Mari tunjukkan kemampuan kita.
Dialogue: 0,0:19:36.80,0:19:39.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa ini?{\i0}
Dialogue: 0,0:19:39.17,0:19:40.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Shimura!\N- Yuma!
Dialogue: 0,0:19:40.17,0:19:41.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akutsu.
Dialogue: 0,0:19:41.34,0:19:42.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kecepatan ini…{\i0}
Dialogue: 0,0:19:42.38,0:19:47.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Semua pemain langsung beralih\Nantara olah kaki, umpan lambat,{\i0}
Dialogue: 0,0:19:47.01,0:19:50.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dan umpan cepat untuk mengalirkan bola.{\i0}
Dialogue: 0,0:19:50.52,0:19:53.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Selain itu, ide operan\Nmereka sangat berbeda.{\i0}
Dialogue: 0,0:19:53.77,0:19:57.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku tak bisa mengikuti.\NAku tak bisa membaca alirannya!{\i0}
Dialogue: 0,0:19:57.27,0:19:58.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shimu…
Dialogue: 0,0:20:03.49,0:20:04.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bola.
Dialogue: 0,0:20:05.53,0:20:07.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong bolanya.
Dialogue: 0,0:20:17.25,0:20:20.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akutsu, permainanmu buruk hari ini.
Dialogue: 0,0:20:21.17,0:20:24.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ganti ke posisi bertahan.\NKau benar-benar tidak fokus.
Dialogue: 0,0:20:25.09,0:20:26.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada masalah?
Dialogue: 0,0:20:39.40,0:20:40.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jangan kalah.{\i0}
Dialogue: 0,0:20:41.07,0:20:41.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jangan kalah.{\i0}
Dialogue: 0,0:20:42.74,0:20:43.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}- Jangan!{\i0}\N- Shimura.
Dialogue: 0,0:20:43.70,0:20:45.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kiriki.\N- Takasugi.
Dialogue: 0,0:20:45.28,0:20:46.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Yoshitsune.\N- Yuma.
Dialogue: 0,0:20:46.24,0:20:47.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Yamada.\N{\i1}- Jangan kalah.{\i0}
Dialogue: 0,0:20:47.62,0:20:48.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jangan kalah!{\i0}
Dialogue: 0,0:20:48.99,0:20:49.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Yoshitsune.\N- Takasugi.
Dialogue: 0,0:20:49.99,0:20:51.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sekarang waktunya!{\i0}
Dialogue: 0,0:20:51.37,0:20:52.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Aoi!\N- Shimura!
Dialogue: 0,0:20:52.79,0:20:54.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Siapakah?{\i0}
Dialogue: 0,0:20:54.04,0:20:56.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Siapa pilihan terbaik di sini?{\i0}
Dialogue: 0,0:20:57.63,0:20:58.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yuma!
Dialogue: 0,0:21:07.64,0:21:08.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial!
Dialogue: 0,0:21:09.51,0:21:10.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelatih,
Dialogue: 0,0:21:11.01,0:21:14.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan dua anak kelas satu ini,\Nini tak seperti latihan.
Dialogue: 0,0:21:15.77,0:21:17.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kembalikanlah mereka.
Dialogue: 0,0:21:25.36,0:21:26.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, Semua!
Dialogue: 0,0:21:26.91,0:21:29.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tak bisa dihindari.
Dialogue: 0,0:21:29.37,0:21:32.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak mungkin akan sempurna sejak awal.
Dialogue: 0,0:21:32.58,0:21:35.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian berdua boleh pergi cuci muka.
Dialogue: 0,0:21:41.04,0:21:42.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ashito…
Dialogue: 0,0:21:43.80,0:21:45.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka tak melihatku.
Dialogue: 0,0:21:46.59,0:21:51.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak satu pun dari mereka melihatku!
Dialogue: 0,0:22:11.58,0:22:12.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lu…
Dialogue: 0,0:22:14.29,0:22:16.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luar biasa!
Dialogue: 0,0:22:17.50,0:22:19.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ini Tim A!{\i0}
Dialogue: 0,0:22:20.50,0:22:21.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Luar biasa…{\i0}
Dialogue: 0,0:22:22.50,0:22:24.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luar biasa!
Dialogue: 0,0:24:15.99,0:24:17.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sesuatu sedang diuji.{\i0}
Dialogue: 0,0:24:17.24,0:24:19.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}- Kuribayashi.\N- Aoi,{\i0}
Dialogue: 0,0:24:19.24,0:24:22.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}- kau sungguh memahaminya?\N- Dia pria yang luar biasa.{\i0}
Dialogue: 0,0:24:22.75,0:24:24.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aoi, soal bek sayap…{\i0}
Dialogue: 0,0:24:24.67,0:24:26.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}- Menakutkan.\N- Sempurna itu langka…{\i0}
Dialogue: 0,0:24:26.46,0:24:29.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Kecepatan mereka…{\i0}
Dialogue: 0,0:24:31.01,0:24:32.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terjemahan subtitle oleh Latifa F
