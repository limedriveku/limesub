Dialogue: 0,0:00:01.12,0:00:05.12,sign,,0000,0000,0000,,KLUB SEPAK BOLA ESPERION - 1983
Dialogue: 0,0:04:52.50,0:04:54.79,sign,,0000,0000,0000,,RESTORAN HINOMARU
Dialogue: 0,0:07:34.74,0:07:36.95,sign,,0000,0000,0000,,JULI: SARAPAN, MAKAN SIANG, MAKAN MALAM
Dialogue: 0,0:24:07.90,0:24:10.03,sign,,0000,0000,0000,,TIM INTI MELAWAN SMK KASHIWA
Dialogue: 0,0:24:10.03,0:24:11.99,sign,,0000,0000,0000,,CADANGAN\NNIKAIDO, KURIBAYASHI, OSIECK…
Dialogue: 0,0:24:11.99,0:24:15.99,sign,,0000,0000,0000,,AOI
Dialogue: 0,0:24:28.92,0:24:29.92,sign,,0000,0000,0000,,{\an8}INI KISAH FIKSI DAN TAK BERHUBUNGAN\NDENGAN TOKOH ATAU ORGANISASI MANA PUN
Dialogue: 0,0:00:05.13,0:00:06.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sial!{\i0}
Dialogue: 0,0:00:09.00,0:00:11.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Diperlakukan seperti anak kecil…{\i0}
Dialogue: 0,0:00:12.05,0:00:13.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Padaku?{\i0}
Dialogue: 0,0:00:20.81,0:00:22.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tim A luar biasa.
Dialogue: 0,0:00:25.52,0:00:27.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Mereka luar biasa…
Dialogue: 0,0:00:28.02,0:00:29.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Luar biasa…
Dialogue: 0,0:00:33.03,0:00:35.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau tersenyum, Ashito?
Dialogue: 0,0:00:36.57,0:00:37.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tersenyum?
Dialogue: 0,0:00:38.49,0:00:40.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak…
Dialogue: 0,0:00:41.58,0:00:44.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa aku memang tersenyum.
Dialogue: 0,0:00:46.42,0:00:50.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak pernah melihat pemula tersenyum\Ndi hari pertamanya di Tim A.
Dialogue: 0,0:00:50.63,0:00:51.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat juga.
Dialogue: 0,0:00:55.38,0:00:56.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini…
Dialogue: 0,0:00:57.18,0:00:58.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau senggang hari ini?
Dialogue: 0,0:00:59.93,0:01:01.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga bertanya ke kalian.
Dialogue: 0,0:01:02.85,0:01:04.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami akan traktir makan malam.
Dialogue: 0,0:01:05.48,0:01:06.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo.
Dialogue: 0,0:02:43.45,0:02:46.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak sekali makanannya!
Dialogue: 0,0:02:47.20,0:02:50.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katsu ayam panas penuh sari\Nbertepung pedas berempah,
Dialogue: 0,0:02:50.29,0:02:53.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ditambah katsu daging renyah dan lembut…
Dialogue: 0,0:02:56.46,0:02:57.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diam dan makan saja!
Dialogue: 0,0:02:59.05,0:03:01.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa-bisanya kau makan banyak\Nsetelah latihan seperti itu?
Dialogue: 0,0:03:01.93,0:03:04.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada makanan gratis sebanyak ini.
Dialogue: 0,0:03:04.10,0:03:06.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu akan kulahap.
Dialogue: 0,0:03:06.18,0:03:07.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:03:07.85,0:03:11.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senioritas di akademi Youth luwes,\Njadi senior jarang mentraktir.
Dialogue: 0,0:03:11.73,0:03:15.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau yang bayar. Aku tak mengundangmu,\Ntetapi kau tetap datang.
Dialogue: 0,0:03:15.44,0:03:16.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:03:19.28,0:03:21.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Togashi tak datang meski diundang.
Dialogue: 0,0:03:21.36,0:03:23.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aoi makan seperti orang bodoh.
Dialogue: 0,0:03:23.03,0:03:25.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Otomo makan meskipun dia khawatir.
Dialogue: 0,0:03:25.24,0:03:27.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuroda bahkan tak bisa makan.
Dialogue: 0,0:03:27.70,0:03:30.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu ada Yuma yang tak tahu malu.
Dialogue: 0,0:03:30.00,0:03:33.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak kelas satu tahun ini\Npunya kepribadian yang khas.
Dialogue: 0,0:03:34.96,0:03:38.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bukan orang yang mudah murung.
Dialogue: 0,0:03:38.34,0:03:41.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, aku seperti dilempar\Nke tim nasional.
Dialogue: 0,0:03:41.38,0:03:44.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tim nasional? Tidak juga, tetapi miriplah.
Dialogue: 0,0:03:46.26,0:03:49.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dari anak kelas tiga,\Nada Yoshitsune dan Yamada.{\i0}
Dialogue: 0,0:03:49.18,0:03:52.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Lalu Kiriki dan Takasugi,\Nsesama kelas dua seperti kami.{\i0}
Dialogue: 0,0:03:52.64,0:03:54.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Empat pemain Esperion{\i0}
Dialogue: 0,0:03:54.10,0:03:57.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}telah dipanggil ke timnas U-18.{\i0}
Dialogue: 0,0:03:57.11,0:03:59.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}- Serius?\N- Bagaimana bisa kau tak tahu?
Dialogue: 0,0:04:00.19,0:04:01.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Mereka berempat…
Dialogue: 0,0:04:01.36,0:04:03.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Mereka berempat anggota timnas Jepang.
Dialogue: 0,0:04:04.70,0:04:07.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau tampak senang?
Dialogue: 0,0:04:07.66,0:04:10.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sukses di Tim A akan sangat sulit
Dialogue: 0,0:04:10.95,0:04:13.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau para pemainnya kelas nasional!
Dialogue: 0,0:04:13.00,0:04:14.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudmu, Otomo?
Dialogue: 0,0:04:15.46,0:04:18.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bisa main bola\Nsambil menonton mereka dari dekat!
Dialogue: 0,0:04:19.05,0:04:21.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat bersemangat!
Dialogue: 0,0:04:22.88,0:04:23.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menyukaimu.
Dialogue: 0,0:04:24.88,0:04:27.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masuk akal karena kau masuk\Nlewat jalur seleksi.
Dialogue: 0,0:04:27.51,0:04:31.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga direkrut dari luar,\Njadi aku merasa bisa memahamimu.
Dialogue: 0,0:04:31.35,0:04:34.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Matsunaga, kau direkrut?
Dialogue: 0,0:04:34.77,0:04:38.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal seleksi, kudengar Akutsu juga\Nkandidat tim nasional.
Dialogue: 0,0:04:39.07,0:04:42.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di angkatan kami\Ncuma dia yang berhasil lolos seleksi,
Dialogue: 0,0:04:42.15,0:04:43.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia memang hebat.
Dialogue: 0,0:04:44.95,0:04:47.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kuribayashi tak masuk tim nasional?
Dialogue: 0,0:04:47.99,0:04:51.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua bilang dia luar biasa,\Njadi kupikir dia masuk.
Dialogue: 0,0:04:54.79,0:04:57.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak ini lucu sekali.
Dialogue: 0,0:04:57.50,0:04:59.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ashito.
Dialogue: 0,0:04:59.09,0:05:01.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuribayashi lompat kelas.
Dialogue: 0,0:05:01.09,0:05:04.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bukan U-18, dia anggota timnas U-20.
Dialogue: 0,0:05:05.80,0:05:06.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh?
Dialogue: 0,0:05:08.76,0:05:11.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taira, Matsunaga, Ozzie.
Dialogue: 0,0:05:11.51,0:05:13.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian makan di sini?
Dialogue: 0,0:05:15.94,0:05:16.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuribayashi!
Dialogue: 0,0:05:17.81,0:05:20.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sponsor ini terus mengikutiku\Nsambil menceramahiku.
Dialogue: 0,0:05:20.86,0:05:24.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kubilang mau pulang biar dia pergi,\Ndia malah tanya soal makanku.
Dialogue: 0,0:05:24.03,0:05:27.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pola makannya yang berantakan\Nmemang sudah terkenal.
Dialogue: 0,0:05:27.61,0:05:31.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak bisa tenang sampai melihatnya\Nmakan dengan mataku sendiri.
Dialogue: 0,0:05:31.53,0:05:35.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa aku tidak usah ikut.\NAku pulang saja.
Dialogue: 0,0:05:35.25,0:05:38.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.\NLagi pula, kau keluarga Tachibana.
Dialogue: 0,0:05:39.42,0:05:41.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duduklah di sebelahku, Nona.
Dialogue: 0,0:05:42.71,0:05:45.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah tadi kau sedang murung?
Dialogue: 0,0:05:46.09,0:05:47.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuribayashi…
Dialogue: 0,0:05:51.89,0:05:54.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada kenalan yang minta\Nsekitar sepuluh biji.
Dialogue: 0,0:05:54.77,0:05:55.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong tanda tangani.
Dialogue: 0,0:05:56.89,0:06:00.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuribayashi! Aku senang kau datang.
Dialogue: 0,0:06:00.31,0:06:02.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lama tak bertemu, Bu.
Dialogue: 0,0:06:02.15,0:06:06.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempat ini terbaik. Kau selalu paham\Nsifat pilih-pilih makananku.
Dialogue: 0,0:06:06.82,0:06:08.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang mendengarnya.
Dialogue: 0,0:06:08.49,0:06:09.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tahu,
Dialogue: 0,0:06:10.36,0:06:14.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}semua orang terus memujinya,\Naku jadi penasaran bagaimana sosoknya.
Dialogue: 0,0:06:14.99,0:06:16.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tampak amat normal.
Dialogue: 0,0:06:17.21,0:06:19.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia terlihat sangat ramah.
Dialogue: 0,0:06:19.42,0:06:21.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, dia orang baik.
Dialogue: 0,0:06:21.50,0:06:25.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua mengetahui kehebatannya,\Ntapi dia tak pernah sombong.
Dialogue: 0,0:06:25.59,0:06:26.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun,
Dialogue: 0,0:06:26.76,0:06:28.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}bicaralah dengannya, kau akan tahu.
Dialogue: 0,0:06:29.97,0:06:30.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Dia menakutkan.
Dialogue: 0,0:06:31.55,0:06:32.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Menakutkan?{\i0}
Dialogue: 0,0:06:32.60,0:06:33.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aoi.
Dialogue: 0,0:06:34.56,0:06:35.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tahu namaku?
Dialogue: 0,0:06:35.81,0:06:38.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku melihatmu di latihan oper gaya Osim.
Dialogue: 0,0:06:39.60,0:06:40.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya kau.
Dialogue: 0,0:06:42.36,0:06:46.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kuroda dan dua lainnya\Ntampak mengakhirinya dalam kebingungan.{\i0}
Dialogue: 0,0:06:46.69,0:06:50.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, hanya kau yang tahu\Nke mana harus mengoper bola.
Dialogue: 0,0:06:51.03,0:06:53.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi sepertinya teknikmu\Nbelum bisa mengimbangi.
Dialogue: 0,0:06:58.25,0:06:59.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh duduk di sini?
Dialogue: 0,0:07:00.46,0:07:01.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu.
Dialogue: 0,0:07:05.92,0:07:07.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aoi, tentang posisi bek sayap…
Dialogue: 0,0:07:09.80,0:07:13.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di level dunia sekalipun,\Ntak ada pemain sempurna.
Dialogue: 0,0:07:13.72,0:07:15.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bisa melakukannya, 'kan?
Dialogue: 0,0:07:19.23,0:07:20.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa…
Dialogue: 0,0:07:22.27,0:07:24.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudmu, "sempurna"?
Dialogue: 0,0:07:29.44,0:07:31.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku diabaikan?{\i0}
Dialogue: 0,0:07:31.36,0:07:33.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kau yang mengajakku bicara!{\i0}
Dialogue: 0,0:07:39.25,0:07:42.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Apa itu? Jadwal makan ditulis tangan?
Dialogue: 0,0:07:42.42,0:07:44.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku hanya perlu membuat ini?
Dialogue: 0,0:07:44.21,0:07:46.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Jangan bilang itu dari pacarmu?
Dialogue: 0,0:07:47.46,0:07:50.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, dia hanya mengatur nutrisiku.
Dialogue: 0,0:07:50.67,0:07:54.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mampir hanya untuk memberi ini,\Njadi dia tak suka basa-basi.
Dialogue: 0,0:07:54.14,0:07:57.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, dia bukan pacarmu.
Dialogue: 0,0:07:57.72,0:07:58.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Orang ini…{\i0}
Dialogue: 0,0:07:58.64,0:08:00.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentang Liga Premier, Taira…
Dialogue: 0,0:08:01.39,0:08:03.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}…ritme mengobrolnya tak keruan.{\i0}
Dialogue: 0,0:08:07.27,0:08:10.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tim SMA dan J-Youth sering dibandingkan.
Dialogue: 0,0:08:11.15,0:08:14.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jujur, J-Youth unggul jauh\Nsoal materi pemain.
Dialogue: 0,0:08:15.41,0:08:19.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari sepuluh tim di Liga Premier\Ntahun ini, hanya tiga SMA yang tersisa.
Dialogue: 0,0:08:20.41,0:08:24.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu, tim SMA yang sangat kuat\Nlevelnya berbeda.
Dialogue: 0,0:08:25.25,0:08:27.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peringkat satu, Funabashi,\Nbelum terkalahkan.
Dialogue: 0,0:08:27.59,0:08:30.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}SMK Kashiwa, lawan kita berikutnya,
Dialogue: 0,0:08:30.25,0:08:31.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di peringkat lima.
Dialogue: 0,0:08:31.42,0:08:35.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, Aomori…\NSMA Aomori Seiran sangat hebat.
Dialogue: 0,0:08:36.59,0:08:39.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada akhirnya, kita mengalahkan Seiran.
Dialogue: 0,0:08:39.10,0:08:42.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, hanya karena kiper mereka\Ndiganjar kartu merah.
Dialogue: 0,0:08:42.68,0:08:45.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, bahaya bagi kita\Njika itu tidak terjadi.
Dialogue: 0,0:08:45.48,0:08:46.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kiper kena kartu merah?
Dialogue: 0,0:08:46.69,0:08:49.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makimura, kiper Seiran.
Dialogue: 0,0:08:52.44,0:08:53.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:08:54.57,0:08:56.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa itu?{\i0}
Dialogue: 0,0:08:56.95,0:09:02.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}"Sempurna…" Apa artinya itu?{\i0}
Dialogue: 0,0:09:02.08,0:09:05.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku tak bisa berhenti memikirkannya!{\i0}
Dialogue: 0,0:09:05.21,0:09:07.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah kau harus tanya dia sesuatu?
Dialogue: 0,0:09:07.83,0:09:10.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau duduk di sebelahnya. Ini saatnya!
Dialogue: 0,0:09:10.13,0:09:13.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Apa? Obrolannya sangat rumit.
Dialogue: 0,0:09:13.46,0:09:15.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku tak tahu harus bilang apa…
Dialogue: 0,0:09:15.47,0:09:17.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Paksa dirimu untuk bertanya!
Dialogue: 0,0:09:26.48,0:09:29.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana cara agar aku bisa lebih baik?
Dialogue: 0,0:09:39.16,0:09:40.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat kau kecil,
Dialogue: 0,0:09:41.24,0:09:42.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau paling suka melakukan apa?
Dialogue: 0,0:09:45.75,0:09:49.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Gaya main favoritmu.\NYang membuatmu terobsesi.
Dialogue: 0,0:09:51.29,0:09:52.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Gaya main?
Dialogue: 0,0:09:52.46,0:09:54.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Itu…
Dialogue: 0,0:09:55.13,0:09:56.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mencetak gol untukku.
Dialogue: 0,0:10:06.23,0:10:07.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus. Aku suka itu.
Dialogue: 0,0:10:09.40,0:10:12.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Fokuskan pikiranmu pada kemampuan itu.{\i0}
Dialogue: 0,0:10:13.73,0:10:17.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua tindakanmu harus demi\Njadi bek sayap yang sempurna.
Dialogue: 0,0:10:22.78,0:10:27.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah kau masih ingin bermain\Ndi J1, Kuribayashi?
Dialogue: 0,0:10:28.54,0:10:32.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika Esperion punya tim U-23\Natau tim satelit,
Dialogue: 0,0:10:32.88,0:10:35.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau mungkin bisa bermain di J3.
Dialogue: 0,0:10:35.96,0:10:38.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jepang tak punya banyak opsi\Nuntuk pemain sepertimu.
Dialogue: 0,0:10:39.30,0:10:44.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, klub luar negeri yang punya\Ntim satelit memang jauh lebih umum.
Dialogue: 0,0:10:44.68,0:10:47.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tepat. Pasti kau berharap\Nlahir di luar negeri,
Dialogue: 0,0:10:47.52,0:10:50.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}agar tak perlu kembali ke akademi Youth…
Dialogue: 0,0:10:56.28,0:10:58.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Andai aku lahir di luar negeri…
Dialogue: 0,0:11:00.03,0:11:03.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau ingin aku mengucapkan itu, 'kan, Yuma?
Dialogue: 0,0:11:04.20,0:11:05.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak…
Dialogue: 0,0:11:05.41,0:11:06.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu…
Dialogue: 0,0:11:07.75,0:11:08.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:11:08.83,0:11:10.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan segala hormat, Yuma,
Dialogue: 0,0:11:11.12,0:11:13.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sistem akademi Youth Jepang\Nsecara global itu…
Dialogue: 0,0:11:13.71,0:11:15.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuribayashi, biar kutuangkan…
Dialogue: 0,0:11:32.65,0:11:33.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, aku…
Dialogue: 0,0:11:33.90,0:11:35.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika aku lahir di luar negeri,
Dialogue: 0,0:11:35.90,0:11:37.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}makanannya takkan cocok untukku,
Dialogue: 0,0:11:38.69,0:11:41.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi mungkin aku tak bisa fokus\Npada sepak bola.
Dialogue: 0,0:11:46.12,0:11:47.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia…{\i0}
Dialogue: 0,0:11:48.91,0:11:50.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}menakutkan.{\i0}
Dialogue: 0,0:12:10.27,0:12:12.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Visi, bukan?
Dialogue: 0,0:12:14.44,0:12:15.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Visi…
Dialogue: 0,0:12:16.19,0:12:18.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu yang kau bicarakan tadi.
Dialogue: 0,0:12:19.90,0:12:20.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti.
Dialogue: 0,0:12:21.86,0:12:23.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti maksudmu!
Dialogue: 0,0:12:24.82,0:12:26.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa aku mengerti!
Dialogue: 0,0:12:45.93,0:12:47.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, tadi…
Dialogue: 0,0:12:47.76,0:12:51.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuribayashi bergerak sebelum air tumpah.
Dialogue: 0,0:12:51.31,0:12:52.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:12:52.27,0:12:56.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu mustahil!\NApa dia bisa meramal masa depan?
Dialogue: 0,0:12:56.44,0:12:57.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aoi.
Dialogue: 0,0:12:57.98,0:13:01.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sungguh mengerti yang dia katakan?
Dialogue: 0,0:13:01.28,0:13:05.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bilang sesuatu soal menjadi sempurna.\NKau paham maksudnya?
Dialogue: 0,0:13:07.03,0:13:09.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, mungkin maksudnya…
Dialogue: 0,0:13:09.66,0:13:14.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan di level dunia, tak ada bek sayap
Dialogue: 0,0:13:14.50,0:13:15.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang bisa semuanya…
Dialogue: 0,0:13:16.75,0:13:18.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menguasai seluruh lapangan…
Dialogue: 0,0:13:18.88,0:13:20.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}baik menyerang…
Dialogue: 0,0:13:21.05,0:13:22.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}maupun bertahan…
Dialogue: 0,0:13:23.26,0:13:25.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku tahu maksudnya.{\i0}
Dialogue: 0,0:13:25.63,0:13:29.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku paham di benakku,\Ntetapi tak tahu cara mengatakannya.{\i0}
Dialogue: 0,0:13:29.76,0:13:35.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudnya, pemain yang ahli menyerang\Nsekaligus bertahan itu belum pernah ada.
Dialogue: 0,0:13:36.64,0:13:39.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di dunia, ada bek sayap\Nyang gila menyerang,
Dialogue: 0,0:13:39.65,0:13:42.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ada juga yang fokus bertahan.
Dialogue: 0,0:13:42.19,0:13:43.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun,
Dialogue: 0,0:13:43.82,0:13:46.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}belum ada pemain\Nyang menguasai keduanya sekaligus.
Dialogue: 0,0:13:47.28,0:13:50.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuribayashi mencari itu.
Dialogue: 0,0:13:50.28,0:13:53.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu dia! Kau hebat, Yuma!
Dialogue: 0,0:13:53.29,0:13:54.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kau bisa tahu?
Dialogue: 0,0:13:56.33,0:13:58.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Panggil saja aku Yuma Telepati.
Dialogue: 0,0:13:58.29,0:14:02.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yuma selalu memahami maksud Kuribayashi.
Dialogue: 0,0:14:03.05,0:14:06.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuribayashi mencari itu darimu, Ashito.
Dialogue: 0,0:14:07.55,0:14:09.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Maksudnya kau bisa melakukannya\Ndengan visimu itu.
Dialogue: 0,0:14:10.84,0:14:13.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejauh ini kau paham, 'kan?
Dialogue: 0,0:14:15.35,0:14:20.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai mahakarya tim Youth Esperion,\Ndia payah dalam berbicara.
Dialogue: 0,0:14:21.02,0:14:23.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah verbalisasi itu penting di sini?
Dialogue: 0,0:14:25.15,0:14:29.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ucapan Kuribayashi tak secepat otaknya.\NDia memang selalu begitu.
Dialogue: 0,0:14:31.20,0:14:32.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau terlalu menahan diri.
Dialogue: 0,0:14:33.58,0:14:36.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf. Hanya saja, bagaimana mengatakannya…
Dialogue: 0,0:14:37.29,0:14:40.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia pemain hebat, tapi aku tak bisa\Nmembaca isi kepalanya.{\i0}
Dialogue: 0,0:14:41.21,0:14:44.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bahkan saat kami mengobrol,\Ndia terasa sangat jauh.{\i0}
Dialogue: 0,0:14:45.75,0:14:47.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bukan orang jahat.
Dialogue: 0,0:14:47.59,0:14:52.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya saja, dia mengerahkan\Nseluruh jiwanya di lapangan.
Dialogue: 0,0:14:53.43,0:14:56.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Singkatnya, dia hanya tertarik\Npada sepak bola.
Dialogue: 0,0:14:57.39,0:14:59.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebesar itulah cintanya pada sepak bola.
Dialogue: 0,0:15:01.56,0:15:02.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pria yang luar biasa.
Dialogue: 0,0:15:03.81,0:15:06.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hal itu tak berubah sejak kami kecil.
Dialogue: 0,0:15:14.58,0:15:18.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Ada apa ini, Garulla?
Dialogue: 0,0:15:19.12,0:15:21.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah sepuluh hari\Nsejak Kuribayashi kembali,
Dialogue: 0,0:15:21.96,0:15:24.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan dia masih belum boleh ikut latihan.
Dialogue: 0,0:15:24.59,0:15:27.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula,\Ndia boleh main di laga tim Youth
Dialogue: 0,0:15:27.21,0:15:30.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}asal ikut latihan tim utama.
Dialogue: 0,0:15:30.59,0:15:34.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Liga Premier juga kembali bergulir\Nakhir pekan ini.
Dialogue: 0,0:15:34.26,0:15:35.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lawan peringkat lima…
Dialogue: 0,0:15:35.55,0:15:38.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelatih tim Youth\Ntak punya banyak pengaruh.
Dialogue: 0,0:15:38.77,0:15:41.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Garulla sialan.\NYa sudah, mau bagaimana lagi.
Dialogue: 0,0:15:43.15,0:15:45.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus siapkan pengganti
Dialogue: 0,0:15:45.23,0:15:47.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jika nanti Kuribayashi tak bisa main.
Dialogue: 0,0:15:47.61,0:15:49.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, Fukuda…
Dialogue: 0,0:15:54.99,0:15:57.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia berusaha keras sepuluh hari ini,
Dialogue: 0,0:15:57.45,0:16:00.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi dia belum menemukan cara\Nmengimbangi mereka.
Dialogue: 0,0:16:01.16,0:16:04.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di format laga kecil,\Naku tak tega melihatnya.
Dialogue: 0,0:16:07.59,0:16:10.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapan kau akan dipulangkan, Berengsek?\NKau menyebalkan.
Dialogue: 0,0:16:12.68,0:16:16.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, hanya kau yang tahu\Nke mana harus mengoper bola.
Dialogue: 0,0:16:16.64,0:16:20.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi sepertinya teknikmu\Nbelum bisa mengimbangi.
Dialogue: 0,0:16:20.77,0:16:23.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kau benar sekali, Kuribayashi.{\i0}
Dialogue: 0,0:16:26.69,0:16:27.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku bisa melihatnya.{\i0}
Dialogue: 0,0:16:29.02,0:16:31.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Selama sepuluh hari\Naku ikut latihan Tim A,{\i0}
Dialogue: 0,0:16:31.36,0:16:33.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}aku bisa melihatnya!{\i0}
Dialogue: 0,0:16:33.95,0:16:35.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun…{\i0}
Dialogue: 0,0:16:36.53,0:16:38.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Terlalu cepat!{\i0}
Dialogue: 0,0:16:38.99,0:16:40.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fokus pada visimu.
Dialogue: 0,0:16:40.37,0:16:41.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sedang kulakukan.{\i0}
Dialogue: 0,0:16:42.12,0:16:43.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu sedang kulakukan!{\i0}
Dialogue: 0,0:16:44.25,0:16:45.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu kulakukan, tetapi tetap saja…{\i0}
Dialogue: 0,0:16:54.13,0:16:57.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kukira sepak bola Esperion\Nhanya soal berpikir…{\i0}
Dialogue: 0,0:16:58.22,0:17:01.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah verbalisasi itu penting di sini?
Dialogue: 0,0:17:02.06,0:17:05.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ucapan Kuribayashi tak secepat otaknya.
Dialogue: 0,0:17:07.06,0:17:09.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mereka cepat.{\i0}
Dialogue: 0,0:17:09.06,0:17:12.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mereka bahkan tak berpikir, ya?{\i0}
Dialogue: 0,0:17:15.49,0:17:17.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, berhenti.
Dialogue: 0,0:17:18.32,0:17:20.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Operanmu agak kaku.
Dialogue: 0,0:17:21.04,0:17:23.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akhiri\Ndengan latihan oper Osim ringan.
Dialogue: 0,0:17:24.00,0:17:25.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah itu latihan selesai.
Dialogue: 0,0:17:25.75,0:17:28.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biarkan empat anak kelas satu\Nlatihan dengan grup Taira lagi.
Dialogue: 0,0:17:28.79,0:17:29.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paman…
Dialogue: 0,0:17:29.84,0:17:30.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelatih.
Dialogue: 0,0:17:31.63,0:17:33.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu ini merepotkan,
Dialogue: 0,0:17:34.13,0:17:36.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi bolehkah aku latihan gaya Osim
Dialogue: 0,0:17:36.26,0:17:38.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan tim inti sekali lagi?
Dialogue: 0,0:17:39.01,0:17:41.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan bertahan sepanjang latihan.
Dialogue: 0,0:17:41.01,0:17:42.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi…
Dialogue: 0,0:17:43.06,0:17:43.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}kumohon.
Dialogue: 0,0:17:45.98,0:17:48.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak bisa memberimu perlakuan khusus.
Dialogue: 0,0:17:52.82,0:17:56.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau menghambat mereka,\Nkau bersedia turun ke Tim B?
Dialogue: 0,0:17:57.65,0:17:58.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:18:04.37,0:18:05.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:18:05.87,0:18:08.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa si pemula itu…
Dialogue: 0,0:18:08.12,0:18:12.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudahlah. Bukannya kita untung\Nkalau dia cuma terus mengejar bola?
Dialogue: 0,0:18:12.34,0:18:16.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika gerakan pemain bertahan buruk,\Nlatihan ini tak ada gunanya.
Dialogue: 0,0:18:24.26,0:18:26.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, mari kita mulai.
Dialogue: 0,0:18:29.35,0:18:30.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Yuma.\N- Kiriki.
Dialogue: 0,0:18:30.35,0:18:31.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Yamada.\N- Akutsu.
Dialogue: 0,0:18:31.36,0:18:32.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Shimura.\N- Takasugi.
Dialogue: 0,0:18:32.61,0:18:34.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Yoshitsune.\N- Yuma.
Dialogue: 0,0:18:42.78,0:18:44.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cegatan bagus, Ashito!
Dialogue: 0,0:18:44.08,0:18:46.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau kenapa, Kiriki?\NLihat anak kelas satu itu!
Dialogue: 0,0:18:47.79,0:18:49.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekali lagi!
Dialogue: 0,0:18:49.50,0:18:51.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jika yang kupikirkan benar…{\i0}
Dialogue: 0,0:18:52.42,0:18:53.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shimura!
Dialogue: 0,0:18:53.59,0:18:54.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yamada!
Dialogue: 0,0:18:55.59,0:18:56.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akutsu!
Dialogue: 0,0:19:00.09,0:19:01.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aoi Rambut Pel!
Dialogue: 0,0:19:02.47,0:19:07.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pencegatan pertamamu bagus,\Ntetapi setelah itu kau payah.
Dialogue: 0,0:19:07.27,0:19:09.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa tadi itu hanya kebetulan?
Dialogue: 0,0:19:11.27,0:19:12.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhenti istirahat!
Dialogue: 0,0:19:12.90,0:19:14.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita sedang latihan, Bodoh!
Dialogue: 0,0:19:16.98,0:19:17.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shimura!
Dialogue: 0,0:19:18.53,0:19:19.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yoshitsune!
Dialogue: 0,0:19:23.28,0:19:24.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia menguji sesuatu.
Dialogue: 0,0:19:25.99,0:19:28.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dia cuma mengandalkan tekad semata,
Dialogue: 0,0:19:28.62,0:19:30.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku siap menurunkannya ke Tim B.
Dialogue: 0,0:19:31.71,0:19:35.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, karena tujuannya jelas,\Naku harus melihatnya sampai akhir.
Dialogue: 0,0:19:35.75,0:19:36.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Verbalisasi.{\i0}
Dialogue: 0,0:19:37.17,0:19:38.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Verbalisasi.{\i0}
Dialogue: 0,0:19:38.26,0:19:39.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Verbalisasi skema permainan.{\i0}
Dialogue: 0,0:19:40.59,0:19:42.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sejak aku gabung Esperion,{\i0}
Dialogue: 0,0:19:42.47,0:19:45.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}membahasakan pikiranku\Ndan menguasai permainan,{\i0}
Dialogue: 0,0:19:46.39,0:19:48.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}itulah yang diajarkan kepadaku.{\i0}
Dialogue: 0,0:19:50.35,0:19:52.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biarkan visimu memandu pikiranmu.
Dialogue: 0,0:19:53.48,0:19:55.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Meskipun masih "berpikir",{\i0}
Dialogue: 0,0:19:55.69,0:19:58.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}verbalisasi Tim A ada di level berbeda.{\i0}
Dialogue: 0,0:19:58.69,0:20:00.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mereka berpikir, tetapi tak berpikir.{\i0}
Dialogue: 0,0:20:01.28,0:20:05.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jika berpikir dengan kecepatan ini,\Ntak mungkin kau bisa mengikuti.{\i0}
Dialogue: 0,0:20:05.03,0:20:06.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu lebih utama daripada teknik!{\i0}
Dialogue: 0,0:20:07.62,0:20:10.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sial, aku tak bisa\Nmembahasakannya dengan baik.{\i0}
Dialogue: 0,0:20:10.70,0:20:12.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dengan kata lain…{\i0}
Dialogue: 0,0:20:13.67,0:20:15.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Teruslah berpikir,{\i0}
Dialogue: 0,0:20:15.92,0:20:16.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dan berpikir…{\i0}
Dialogue: 0,0:20:18.50,0:20:19.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jika melakukannya,{\i0}
Dialogue: 0,0:20:19.55,0:20:22.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}kau akhirnya akan bergerak tanpa berpikir.{\i0}
Dialogue: 0,0:20:23.72,0:20:27.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Saat itulah kau menguasai keahlianmu.{\i0}
Dialogue: 0,0:20:28.43,0:20:29.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku mengerti.{\i0}
Dialogue: 0,0:20:29.93,0:20:32.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tim A sudah memikirkan segalanya\Ndengan saksama{\i0}
Dialogue: 0,0:20:32.98,0:20:35.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}hingga sudah menguasainya di luar kepala.{\i0}
Dialogue: 0,0:20:35.85,0:20:39.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sebelum kepala mereka bisa berpikir,\Ntubuh mereka{\i0}
Dialogue: 0,0:20:39.02,0:20:40.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}bergerak sendiri.{\i0}
Dialogue: 0,0:20:41.19,0:20:43.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dorongan itu…{\i0}
Dialogue: 0,0:20:43.03,0:20:44.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku harus percaya!{\i0}
Dialogue: 0,0:20:44.20,0:20:45.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Yamada!
Dialogue: 0,0:21:01.88,0:21:02.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Semoga berhasil.{\i0}
Dialogue: 0,0:21:05.18,0:21:06.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Manusia hanyalah{\i0}
Dialogue: 0,0:21:06.72,0:21:08.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}ilalang yang mampu berpikir.{\i0}
Dialogue: 0,0:21:09.43,0:21:10.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus.
Dialogue: 0,0:21:12.02,0:21:13.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tahapmu berikutnya,
Dialogue: 0,0:21:14.81,0:21:15.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ashito.
Dialogue: 0,0:21:39.67,0:21:42.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Intuisiku sering sekali meleset.{\i0}
Dialogue: 0,0:21:43.01,0:21:46.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa ini sungguh akan berhasil di Tim A?{\i0}
Dialogue: 0,0:21:46.68,0:21:48.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ini akan benar-benar sulit.{\i0}
Dialogue: 0,0:21:49.43,0:21:50.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ashito.
Dialogue: 0,0:21:52.60,0:21:55.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namamu Ashito Aoi, bukan?
Dialogue: 0,0:21:58.48,0:22:00.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:22:02.36,0:22:03.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nama yang tak biasa.
Dialogue: 0,0:23:55.97,0:23:57.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ashito!
Dialogue: 0,0:23:59.64,0:24:02.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai kapan kau akan mencuci wajahmu?
Dialogue: 0,0:24:02.73,0:24:04.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat!
Dialogue: 0,0:24:15.99,0:24:17.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Permainannya sangat cepat!{\i0}
Dialogue: 0,0:24:17.62,0:24:20.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}- Giliranmu, Ashito.\N- Ini level yang luar biasa.{\i0}
Dialogue: 0,0:24:20.12,0:24:22.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}- Setengah langkah…\N- Sebelum bola, jadilah kuat.{\i0}
Dialogue: 0,0:24:22.75,0:24:23.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tidak juga.{\i0}
Dialogue: 0,0:24:23.71,0:24:25.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Akademi Youth harus fokus membina{\i0}
Dialogue: 0,0:24:25.50,0:24:27.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}- bukan menang.\N- Nafsu menghabisi, ya?{\i0}
Dialogue: 0,0:24:27.46,0:24:28.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Aku mengerti. Ini…{\i0}
Dialogue: 0,0:24:29.92,0:24:30.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Terjemahan subtitle oleh Latifa F
