Dialogue: 0,0:03:09.10,0:03:09.46,sign,,0000,0000,0000,,(Episode 8: Menuju Tingkat yang Lebih Tinggi)
Dialogue: 0,0:10:06.28,0:10:10.25,sign,,0000,0000,0000,,LIGA UTAMA PIALA TAKAMADO U-18
Dialogue: 0,0:10:16.62,0:10:18.62,sign,,0000,0000,0000,,AOMORI SEIRAN 33, ESPERION 31
Dialogue: 0,0:10:18.62,0:10:22.26,sign,,0000,0000,0000,,AKADEMI FUNABASHI 28
Dialogue: 0,0:11:02.80,0:11:06.97,sign,,0000,0000,0000,,JUMLAH GOL: AKADEMI FUNABASHI 30
Dialogue: 0,0:11:12.51,0:11:14.06,sign,,0000,0000,0000,,PERTANDINGAN PEKAN KE-8 YANG DITUNDA
Dialogue: 0,0:11:14.06,0:11:15.56,sign,,0000,0000,0000,,ESPERION VS AKADEMI FUNABASHI
Dialogue: 0,0:11:15.56,0:11:18.49,sign,,0000,0000,0000,,BERHADAPAN LANGSUNG
Dialogue: 0,0:11:42.47,0:11:43.53,sign,,0000,0000,0000,,DAFTAR PEMAIN UNTUK TUR KE CEKO
Dialogue: 0,0:11:43.53,0:11:46.97,sign,,0000,0000,0000,,EMPAT PEMAIN TIM REMAJA TOKYO CITY ESPERION
Dialogue: 0,0:11:57.68,0:11:59.84,sign,,0000,0000,0000,,TUR CEKO, PULANG 4 HARI SEBELUM LAWAN FUNABASHI
Dialogue: 0,0:11:59.84,0:12:01.61,sign,,0000,0000,0000,,PEKAN KE-1: TOKYO VANS
Dialogue: 0,0:12:01.61,0:12:03.95,sign,,0000,0000,0000,,PEKAN KE-2: OMIYA
Dialogue: 0,0:12:10.50,0:12:13.25,sign,,0000,0000,0000,,RUANG LATIHAN
Dialogue: 0,0:18:05.48,0:18:08.98,sign,,0000,0000,0000,,SUGAWARA, TACHIBANA, TAKESHIMA, ASARI\NNAIK KE TIM A
Dialogue: 0,0:21:50.95,0:21:54.20,sign,,0000,0000,0000,,AOI, TOGASHI, TAKESHIMA, ASARI
Dialogue: 0,0:24:07.92,0:24:10.17,sign,,0000,0000,0000,,AOI
Dialogue: 0,0:24:28.04,0:24:29.01,sign,,0000,0000,0000,,PROGRAM INI FIKSI, TIDAK TERKAIT DENGAN TOKOH,\NKELOMPOK, ATAU NAMA DI DUNIA NYATA
Dialogue: 0,0:24:29.01,0:24:29.98,sign,,0000,0000,0000,,(Episode Berikutnya: Liga Utama Pekan ke-13,\NMelawan Tim Remaja Tokyo VANS)
Dialogue: 0,0:00:08.01,0:00:08.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cih.
Dialogue: 0,0:00:09.07,0:00:11.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jarang ada kesempatan berlatih\Nmelalui pertarungan sungguhan.
Dialogue: 0,0:00:11.82,0:00:14.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak kelas satu di tim cadangan\Nterlalu banyak, 'kan?
Dialogue: 0,0:00:15.18,0:00:17.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya mereka semua berlatih keras\Nsecara intensif pada malam hari.
Dialogue: 0,0:00:17.84,0:00:18.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:00:31.63,0:00:32.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei.
Dialogue: 0,0:00:32.57,0:00:36.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian kelelahan\Nsampai mukanya pucat semua, ya.
Dialogue: 0,0:00:36.43,0:00:39.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan kondisi seperti itu,\Napa kalian bisa melawan kami?
Dialogue: 0,0:00:39.79,0:00:40.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang kami
Dialogue: 0,0:00:42.24,0:00:43.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak ada waktu untuk mengeluh lelah.
Dialogue: 0,0:00:45.46,0:00:48.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang kelihatannya paling lelah\Nsedang berbicara apa?
Dialogue: 0,0:00:54.64,0:00:56.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menghancurkanmu\Nsampai tidak berkutik, bocah.
Dialogue: 0,0:00:58.80,0:00:59.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita maju.
Dialogue: 0,0:01:00.43,0:01:01.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ashito benar.
Dialogue: 0,0:01:01.93,0:01:03.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang kita tidak ada waktu\Nuntuk mengeluh capek.
Dialogue: 0,0:01:04.38,0:01:07.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau pemain cadangan tidak cukup kuat,\Npemain inti juga akan makin melemah.
Dialogue: 0,0:01:07.98,0:01:09.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, aku sudah dengar dari Kuroda.
Dialogue: 0,0:01:10.49,0:01:12.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ucapan Pelatih Fukuda itu
Dialogue: 0,0:01:13.24,0:01:15.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}membuat kita bisa bertahan\Nsampai sekarang.
Dialogue: 0,0:01:16.51,0:01:18.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tidak boleh mengecewakan dia.
Dialogue: 0,0:01:20.78,0:01:23.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini juga, aku berharap
Dialogue: 0,0:01:24.73,0:01:26.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akulah pemain terhebat di dunia.
Dialogue: 0,0:01:27.71,0:01:28.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya.
Dialogue: 0,0:01:29.08,0:01:29.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:01:30.51,0:01:32.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisakah mendengarkanku sebentar?
Dialogue: 0,0:03:09.10,0:03:10.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sana kosong.
Dialogue: 0,0:03:10.20,0:03:11.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlalu lambat.
Dialogue: 0,0:03:11.48,0:03:12.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat, lari!
Dialogue: 0,0:03:15.00,0:03:15.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Togashi!
Dialogue: 0,0:03:22.44,0:03:23.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku melihatnya.
Dialogue: 0,0:03:23.80,0:03:24.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei.
Dialogue: 0,0:03:24.92,0:03:27.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan menoleh ke sana kemari\Ndi tempat seperti ini, anak nakal.
Dialogue: 0,0:03:34.76,0:03:35.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh.
Dialogue: 0,0:03:36.62,0:03:38.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, lumayan cepat juga.
Dialogue: 0,0:03:39.10,0:03:40.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan memaksakan diri, back pass saja.
Dialogue: 0,0:03:40.48,0:03:41.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang saatnya!
Dialogue: 0,0:03:41.55,0:03:42.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat aku!
Dialogue: 0,0:03:46.48,0:03:47.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan hanya latihan sepak bola.
Dialogue: 0,0:03:48.89,0:03:50.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika ingin memperluas pandangan,
Dialogue: 0,0:03:50.70,0:03:52.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}harus dilatih mulai\Ndari kehidupan sehari-hari.
Dialogue: 0,0:03:53.24,0:03:55.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan saat berjalan di jalanan pun,\Njuga bisa berlatih.
Dialogue: 0,0:03:56.80,0:04:01.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang penting itu "mengingat dengan benar\Nyang dilihat dan mengambil keputusan".
Dialogue: 0,0:04:01.95,0:04:04.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misalnya, menganggap papan nama\Napotek berwarna merah.
Dialogue: 0,0:04:04.60,0:04:07.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu artinya kau hanya menafsirkan sesuatu\Nsesuai pemikiranmu sendiri.
Dialogue: 0,0:04:08.36,0:04:09.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Togashi.
Dialogue: 0,0:04:10.80,0:04:12.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Dia seharusnya tidak akan\Nmemberi umpan panjang sekarang, kan?"
Dialogue: 0,0:04:13.37,0:04:15.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Rekan setimku seharusnya\Nmenungguku di sini, 'kan?"
Dialogue: 0,0:04:16.35,0:04:18.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau mudah kehilangan bola\Nkarena terlalu terpaku
Dialogue: 0,0:04:18.03,0:04:20.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pada semua asumsi itu?
Dialogue: 0,0:04:21.63,0:04:23.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Amati dengan baik.
Dialogue: 0,0:04:23.87,0:04:25.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arah pandangan pemain,
Dialogue: 0,0:04:25.76,0:04:28.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}arah tubuh, dan arah kaki tumpunya.
Dialogue: 0,0:04:28.57,0:04:29.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya harus diamati dengan baik.
Dialogue: 0,0:04:33.18,0:04:35.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengamatannya tepat sekali, Togashi.
Dialogue: 0,0:04:35.40,0:04:36.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akutsu, jaga di sana! Biar aku yang…
Dialogue: 0,0:04:39.12,0:04:40.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Osieck.
Dialogue: 0,0:04:40.62,0:04:41.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Koba.
Dialogue: 0,0:04:45.10,0:04:45.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Otomo.
Dialogue: 0,0:04:48.33,0:04:48.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah!
Dialogue: 0,0:04:49.29,0:04:50.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Offside.
Dialogue: 0,0:04:50.62,0:04:51.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski agak disayangkan,
Dialogue: 0,0:04:51.92,0:04:54.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuroda dan Otomo bermain\Ncukup bersemangat hari ini.
Dialogue: 0,0:04:55.72,0:04:56.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, ayo kita mulai.
Dialogue: 0,0:04:57.98,0:04:58.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus.
Dialogue: 0,0:05:00.22,0:05:02.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan tidak sempat menyesali kesalahan,\Ndia sudah kembali bertahan.
Dialogue: 0,0:05:03.60,0:05:04.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Transisinya sangat bagus.
Dialogue: 0,0:05:05.53,0:05:07.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Otomo, Kuroda.
Dialogue: 0,0:05:21.76,0:05:22.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sini tempatnya!
Dialogue: 0,0:05:24.51,0:05:26.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gerakan yang bagus, anak kelas satu.
Dialogue: 0,0:05:26.59,0:05:28.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daripada teknik,\Nlebih tepat disebut konsentrasi.
Dialogue: 0,0:05:29.10,0:05:31.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penilaian situasi\Ndan kerja samanya sangat baik.
Dialogue: 0,0:05:31.85,0:05:32.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Uhm.
Dialogue: 0,0:05:33.08,0:05:36.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata ucapan Pelatih Fukuda\Nefeknya sebesar itu.
Dialogue: 0,0:05:45.20,0:05:46.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sapuan yang bagus.
Dialogue: 0,0:05:47.55,0:05:48.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya.
Dialogue: 0,0:05:48.80,0:05:49.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:05:50.06,0:05:51.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisakah mendengarkanku sebentar?
Dialogue: 0,0:05:52.32,0:05:54.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Agar sebuah tim menjadi kuat,"
Dialogue: 0,0:05:54.65,0:05:56.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"kita para pemain cadangannya\Njuga harus kuat."
Dialogue: 0,0:05:57.39,0:05:58.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kita
Dialogue: 0,0:05:58.73,0:05:59.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}cukup puas hanya menjadi cadangan?
Dialogue: 0,0:06:01.28,0:06:02.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ucapan Paman Fukuda itu
Dialogue: 0,0:06:02.80,0:06:04.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}benar-benar sangat bagus.
Dialogue: 0,0:06:05.13,0:06:08.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, jika kita hanya terharu\Nsetelah mendengarnya,
Dialogue: 0,0:06:09.02,0:06:10.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tetap saja tidak bisa.
Dialogue: 0,0:06:11.29,0:06:13.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita sudah dianggap hanya pantas\Nmenjadi pemain cadangan.
Dialogue: 0,0:06:13.80,0:06:15.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana bisa kita tidak merasa kesal?
Dialogue: 0,0:06:15.82,0:06:17.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk hal ini, kita tidak boleh mengalah.
Dialogue: 0,0:06:18.00,0:06:20.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo naikkan lagi target kita.
Dialogue: 0,0:06:21.26,0:06:22.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meskipun hanya laga internal,
Dialogue: 0,0:06:23.13,0:06:25.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita tetap harus main\Ndengan tekad mengalahkan Tim A.
Dialogue: 0,0:06:27.23,0:06:28.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Angkat kepala dan lihat ke atas.
Dialogue: 0,0:06:28.78,0:06:29.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat ke atas…
Dialogue: 0,0:06:32.40,0:06:33.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat ke atas!
Dialogue: 0,0:06:36.97,0:06:39.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di antara para pemain cadangan,\Nanak kelas satu justru paling fokus.
Dialogue: 0,0:06:40.19,0:06:42.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agar tidak terkena serangan balik,\Nkita juga harus memperkuat pertahanan.
Dialogue: 0,0:06:42.09,0:06:46.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fokus mereka hanya begitu. Begitu kita\Nmencetak gol, mereka pasti langsung goyah.
Dialogue: 0,0:06:47.48,0:06:48.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan padaku.
Dialogue: 0,0:06:54.64,0:06:56.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hal terpenting yang kupelajari\Ndari latihan tali
Dialogue: 0,0:06:57.10,0:06:58.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah bertindak atas inisiatif sendiri\Ntanpa harus diingatkan orang lain.
Dialogue: 0,0:06:59.42,0:07:02.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu salah mengambil posisi,\Nmaka bisa tertarik hingga terjatuh.
Dialogue: 0,0:07:03.15,0:07:04.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah terus berlatih seperti ini,
Dialogue: 0,0:07:05.50,0:07:07.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dasar pertahanan,
Dialogue: 0,0:07:07.04,0:07:09.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}juga kebiasaan Togashi,\NTakeshima, dan Asari,
Dialogue: 0,0:07:10.78,0:07:12.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mau tidak mau akan hafal sendiri.
Dialogue: 0,0:07:14.86,0:07:18.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tatapan anak-anak kelas satu\Nterlihat berbeda hari ini.
Dialogue: 0,0:07:21.74,0:07:24.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama sekali tidak ada waktu\Nuntuk memperingatkan rekan satu tim.
Dialogue: 0,0:07:30.60,0:07:33.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, aku tahu\N"dia ingin aku di posisi mana."
Dialogue: 0,0:07:34.36,0:07:37.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang menghubungkan kami berempat\Nhanya seutas tali.
Dialogue: 0,0:07:38.09,0:07:41.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, melalui "benda yang terlihat ini",\Naku jadi mengerti.
Dialogue: 0,0:07:41.80,0:07:45.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Hubungan saling mengisi posisi\Ntanpa harus bicara" yang menyatukan kami.
Dialogue: 0,0:07:45.48,0:07:48.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami semua berada di kapal yang sama,\Nterikat oleh tali bernama "ikatan".
Dialogue: 0,0:07:49.24,0:07:51.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti, perlahan aku mengerti.
Dialogue: 0,0:07:52.30,0:07:53.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang disebut lini pertahanan
Dialogue: 0,0:07:54.22,0:07:55.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah kepercayaan.
Dialogue: 0,0:08:00.32,0:08:03.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayangnya, dengan kemampuan kalian\Nyang payah seperti ini…
Dialogue: 0,0:08:06.46,0:08:07.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei kau, lepaskan!
Dialogue: 0,0:08:11.15,0:08:14.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau bermain bola\Nuntuk menjadi pemain profesional?
Dialogue: 0,0:08:14.72,0:08:15.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:08:16.51,0:08:18.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku selalu bermain\Nuntuk menjadi pemain profesional.
Dialogue: 0,0:08:19.24,0:08:20.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu tandatangan kontrak,
Dialogue: 0,0:08:20.88,0:08:23.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku bisa langsung mengirim uang untuk Ibu.
Dialogue: 0,0:08:24.49,0:08:25.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun,
Dialogue: 0,0:08:25.50,0:08:27.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apakah itu tujuan akhirku?
Dialogue: 0,0:08:28.25,0:08:30.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lepaskan, brengsek!
Dialogue: 0,0:08:32.19,0:08:33.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, ayo maju.
Dialogue: 0,0:08:33.56,0:08:34.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akutsu.
Dialogue: 0,0:08:39.92,0:08:41.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sapuan yang bag…
Dialogue: 0,0:08:43.69,0:08:44.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masuklah.
Dialogue: 0,0:08:47.88,0:08:50.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial!
Dialogue: 0,0:08:53.04,0:08:54.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo lanjut ke bola berikutnya.
Dialogue: 0,0:08:54.33,0:08:55.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bola berikutnya pasti kutahan.
Dialogue: 0,0:08:56.12,0:08:57.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh!
Dialogue: 0,0:08:57.56,0:08:59.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}-Baiklah.\N-Serahkan padaku.
Dialogue: 0,0:08:59.16,0:09:01.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat saja bagaimana aku mengejar\Ndan melewati kalian, berengsek!
Dialogue: 0,0:09:01.55,0:09:03.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian jangan harap bisa\Nmencetak gol lagi.
Dialogue: 0,0:09:03.36,0:09:04.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian semua tunggu saja.
Dialogue: 0,0:09:05.66,0:09:06.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Ingin menjadi pemain profesional."
Dialogue: 0,0:09:07.42,0:09:09.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang hanya punya mimpi sebatas itu
Dialogue: 0,0:09:09.76,0:09:11.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak akan pernah bisa\Nmenjadi pemain profesional.
Dialogue: 0,0:09:12.54,0:09:14.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tekadku masih belum cukup kuat.
Dialogue: 0,0:09:15.37,0:09:18.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku masih memikirkan hal-hal sepele,\Nitu bukti terbaiknya.
Dialogue: 0,0:09:19.95,0:09:21.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasang target tinggi.
Dialogue: 0,0:09:22.76,0:09:23.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih tinggi lagi.
Dialogue: 0,0:09:29.80,0:09:31.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, sekarang baru dimulai.
Dialogue: 0,0:09:32.72,0:09:33.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya adalah\Nmeningkatkan porsi latihan.
Dialogue: 0,0:09:35.29,0:09:36.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian semua,
Dialogue: 0,0:09:37.26,0:09:38.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ikuti dengan baik.
Dialogue: 0,0:09:53.58,0:09:58.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demikian hasil pertandingan\Nliga luar negeri dan Liga J pekan ini.
Dialogue: 0,0:09:58.88,0:10:01.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, pertandingan di kedua kompetisi\Nmakin seru saja!
Dialogue: 0,0:10:01.88,0:10:03.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:10:03.60,0:10:05.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong soal seru…
Dialogue: 0,0:10:06.28,0:10:07.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak bisa lepas dari U-18,
Dialogue: 0,0:10:07.69,0:10:10.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Liga Utama Piala Takamado.
Dialogue: 0,0:10:10.86,0:10:12.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, pertandingan kategori remaja, ya.
Dialogue: 0,0:10:13.39,0:10:15.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan lihat tabel klasemen ini.
Dialogue: 0,0:10:18.62,0:10:22.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hampir dipastikan ketiganya bersaing.
Dialogue: 0,0:10:22.80,0:10:24.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aomori Seiran yang berada\Ndi puncak klasemen sekarang
Dialogue: 0,0:10:24.67,0:10:27.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berhasil menjadi juara kompetisi olahraga\Nterpadu tingkat nasional bulan lalu.
Dialogue: 0,0:10:27.44,0:10:31.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya, mereka juga mengincar\NKejuaraan Sepak Bola SMA Nasional
Dialogue: 0,0:10:31.64,0:10:34.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}musim dingin dan Liga Utama\Nuntuk meraih treble sekaligus.
Dialogue: 0,0:10:34.84,0:10:36.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bicara soal treble,
Dialogue: 0,0:10:36.24,0:10:38.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}itu adalah impian terbesar\Ndalam sepak bola SMA.
Dialogue: 0,0:10:38.33,0:10:40.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, yang berdiri mengadang mereka
Dialogue: 0,0:10:41.20,0:10:44.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah tim juara yang dua tahun beruntun\Nmenguasai Liga Utama Wilayah Timur,
Dialogue: 0,0:10:44.81,0:10:47.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tokyo City Esperion.
Dialogue: 0,0:10:47.40,0:10:49.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka juga berhasil menjuarai Kejuaraan\NSepak Bola Klub Remaja Musim Panas.
Dialogue: 0,0:10:50.09,0:10:52.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuribayashi bahkan terpilih sebagai MVP.
Dialogue: 0,0:10:52.99,0:10:55.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Posisi mereka sebagai tim terkuat\Ndi kelompok remaja masih kokoh.
Dialogue: 0,0:10:56.43,0:10:59.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, Akademi Funabashi\Ndi peringkat ketiga.
Dialogue: 0,0:10:59.50,0:11:02.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keunggulan utama tim ini terletak\Npada kekuatan serangannya.
Dialogue: 0,0:11:02.80,0:11:06.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Total gol jauh melampaui dua sekolah lainnya.
Dialogue: 0,0:11:07.44,0:11:09.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemampuan kedua penyerang mereka jauh\Ndi atas standar pemain SMA.
Dialogue: 0,0:11:09.98,0:11:12.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kombinasi serangan mereka berdua\Nsangat mematikan.
Dialogue: 0,0:11:12.51,0:11:14.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, bulan ini
Dialogue: 0,0:11:14.06,0:11:15.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Esperion di peringkat dua
Dialogue: 0,0:11:15.56,0:11:18.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan melawan Akademi Funabashi peringkat tiga.
Dialogue: 0,0:11:19.04,0:11:21.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, aku jadi tidak sabar menantikannya.
Dialogue: 0,0:11:21.60,0:11:23.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang persaingan didominasi\Noleh tiga tim terkuat.
Dialogue: 0,0:11:23.60,0:11:25.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perkembangan selanjutnya\Nbenar-benar sangat dinantikan.
Dialogue: 0,0:11:26.12,0:11:27.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, ketiga tim ini
Dialogue: 0,0:11:27.84,0:11:30.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebenarnya menghadapi\Nsatu masalah yang sama.
Dialogue: 0,0:11:30.81,0:11:32.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya?
Dialogue: 0,0:11:33.32,0:11:34.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu adalah pertandingan Tim Nasional.
Dialogue: 0,0:11:35.82,0:11:37.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, begitu rupanya.
Dialogue: 0,0:11:37.36,0:11:39.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertandingan Tim Nasional U-18.
Dialogue: 0,0:11:39.63,0:11:40.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:11:40.59,0:11:42.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tur ke Ceko
Dialogue: 0,0:11:42.47,0:11:43.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sekitar dua minggu.
Dialogue: 0,0:11:43.53,0:11:44.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru di waktu seperti ini
Dialogue: 0,0:11:44.49,0:11:46.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}U-18 berangkat ke Ceko.
Dialogue: 0,0:11:47.52,0:11:49.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemain yang bisa terpilih\Ntentu saja merupakan hal yang baik.
Dialogue: 0,0:11:49.37,0:11:53.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, jumlah pemain Tim Remaja kita\Ntidak sebanyak Tim SMA.
Dialogue: 0,0:11:53.31,0:11:54.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sulit sekali mencari pemain\Nuntuk mengisi posisi yang kosong.
Dialogue: 0,0:11:57.68,0:11:59.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Babak selanjutnya melawan Tokyo VANS
Dialogue: 0,0:11:59.84,0:12:01.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan setelahnya melawan Omiya.
Dialogue: 0,0:12:01.61,0:12:03.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keempat pemain pasti absen.
Dialogue: 0,0:12:03.95,0:12:07.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begini, bukankah tim kita\Nyang paling dirugikan?
Dialogue: 0,0:12:14.80,0:12:17.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada keributan di ruang pelatih.
Dialogue: 0,0:12:17.37,0:12:18.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sudah pasti.
Dialogue: 0,0:12:19.02,0:12:20.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Empat pemain inti pergi ke Ceko.
Dialogue: 0,0:12:21.76,0:12:23.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang bagus bisa menjuarai\NKejuaraan Sepak Bola Klub Remaja,
Dialogue: 0,0:12:24.20,0:12:26.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tetapi sepanjang musim panas mereka harus\Nbermain penuh di setiap pertandingan.
Dialogue: 0,0:12:26.38,0:12:28.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemain starter juga kelelahan.
Dialogue: 0,0:12:28.64,0:12:31.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keempatnya adalah\NSenior Yoshitsune, Senior Yamada,
Dialogue: 0,0:12:31.87,0:12:34.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takasugi, Kiriki, langganan tur itu, ya?
Dialogue: 0,0:12:35.34,0:12:36.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya iya.
Dialogue: 0,0:12:36.92,0:12:39.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti Senior Shimura, kudengar\Nkondisi kakinya sudah cukup parah.
Dialogue: 0,0:12:40.72,0:12:42.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taira juga belum…
Dialogue: 0,0:12:43.08,0:12:44.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana dengan Kuribayashi?
Dialogue: 0,0:12:44.59,0:12:47.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia U-20, jadi tur Ceko kali ini seharusnya\Ntidak berhubungan dengan dia, 'kan?
Dialogue: 0,0:12:47.60,0:12:48.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa dia bisa bermain\Ndi tiga pertandingan ke depan?
Dialogue: 0,0:12:49.48,0:12:50.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entahlah.
Dialogue: 0,0:12:50.73,0:12:52.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, jika melihat waktunya,
Dialogue: 0,0:12:52.01,0:12:54.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak heran kalau sewaktu-waktu dia\Ndipanggil kembali ke Tim Utama.
Dialogue: 0,0:12:54.81,0:12:57.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perbedaan antara starter\Ndan pemain cadangan, ya.
Dialogue: 0,0:12:58.59,0:13:01.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak disangka itu terlihat\Ndi saat begini.
Dialogue: 0,0:13:09.39,0:13:10.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akutsu, Kiriki.
Dialogue: 0,0:13:11.82,0:13:13.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian berdua jangan cuek begitu.
Dialogue: 0,0:13:14.19,0:13:16.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan tim secara keseluruhan\Ntidak meningkat.
Dialogue: 0,0:13:16.48,0:13:19.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita juga bertanggung jawab\Nkarena para junior belum berkembang.
Dialogue: 0,0:13:20.32,0:13:21.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, apa sikap kalian itu?
Dialogue: 0,0:13:26.84,0:13:28.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan tidak peduli,
Dialogue: 0,0:13:29.48,0:13:31.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tetapi aku tidak paham\Nkenapa itu tanggung jawab kita.
Dialogue: 0,0:13:32.44,0:13:35.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mereka tidak berkembang,\Nitu tetap tanggung jawab mereka, 'kan?
Dialogue: 0,0:13:38.41,0:13:40.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku peduli.
Dialogue: 0,0:13:41.26,0:13:43.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Esperion seharusnya adalah yang terkuat.
Dialogue: 0,0:13:43.90,0:13:46.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seluruh tim harus menjadi lebih kuat.
Dialogue: 0,0:13:46.16,0:13:46.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu…
Dialogue: 0,0:13:47.12,0:13:49.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, tadi aku kurang fokus.
Dialogue: 0,0:13:49.60,0:13:52.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sedang memikirkan hal lain.
Dialogue: 0,0:13:52.48,0:13:53.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hal lain?
Dialogue: 0,0:13:53.95,0:13:54.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akutsu.
Dialogue: 0,0:13:54.91,0:13:57.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami mengandalkanmu selama kami ke Ceko.
Dialogue: 0,0:13:58.91,0:14:01.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika Kuribayashi sampai tidak ada,\Nsituasinya akan lebih parah.
Dialogue: 0,0:14:01.82,0:14:04.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, kau terlalu keras\Npada para junior.
Dialogue: 0,0:14:05.42,0:14:06.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kiriki, kau juga.
Dialogue: 0,0:14:07.39,0:14:09.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebelum ke Ceko, beri mereka saran juga.
Dialogue: 0,0:14:10.76,0:14:12.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Percuma saja, Takasugi.
Dialogue: 0,0:14:13.58,0:14:17.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang pikiran Kiriki pasti\Nhanya tertuju pada urusan Ceko.
Dialogue: 0,0:14:19.95,0:14:22.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimanapun, saat Kuribayashi tidak ada,
Dialogue: 0,0:14:22.20,0:14:25.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}baik di Tim Nasional maupun Esperion,\Nkau yang memimpin permainan di lapangan.
Dialogue: 0,0:14:25.26,0:14:28.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bermain sebagai gelandang bertahan\Nsekaligus mengatur seluruh tim.
Dialogue: 0,0:14:29.53,0:14:32.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Asalkan Kuribayashi tidak ada."
Dialogue: 0,0:14:34.09,0:14:38.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, sekarang kau pasti sangat menantikan\Npertandingan di sana, 'kan?
Dialogue: 0,0:14:38.81,0:14:40.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar bukan, Kiriki?
Dialogue: 0,0:14:41.77,0:14:42.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membosankan sekali.
Dialogue: 0,0:14:47.40,0:14:48.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelatih Fukuda.
Dialogue: 0,0:14:48.72,0:14:49.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski agak terlambat,
Dialogue: 0,0:14:49.88,0:14:52.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}daftar Tim Nasional untuk tur\Nke Ceko sudah diumumkan.
Dialogue: 0,0:14:53.12,0:14:54.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang kuumumkan kepada semuanya.
Dialogue: 0,0:14:54.78,0:14:56.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau sengaja datang ke sini\Nuntuk memberi tahu kami?
Dialogue: 0,0:14:57.63,0:14:58.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada empat orang yang terpilih,
Dialogue: 0,0:14:59.16,0:15:01.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yaitu Yoshitsune, Yamada, Takasugi,
Dialogue: 0,0:15:02.27,0:15:03.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan…
Dialogue: 0,0:15:04.33,0:15:05.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akutsu.
Dialogue: 0,0:15:07.76,0:15:08.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata Kiriki…
Dialogue: 0,0:15:09.80,0:15:13.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia yang selalu terpilih\Nsejak masih di Tim Remaja,
Dialogue: 0,0:15:13.96,0:15:15.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ternyata tidak terpilih\Nmasuk Tim Nasional.
Dialogue: 0,0:15:18.56,0:15:19.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akutsu.
Dialogue: 0,0:15:21.26,0:15:22.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat, ya.
Dialogue: 0,0:15:23.66,0:15:25.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akkun!
Dialogue: 0,0:15:25.90,0:15:28.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat.
Dialogue: 0,0:15:33.42,0:15:34.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kiriki.
Dialogue: 0,0:15:34.56,0:15:39.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelatih Ichimura dari U-18 memberi tahu\Nkami alasan kau tidak terpilih.
Dialogue: 0,0:15:39.82,0:15:43.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Aku sudah menonton semua rekaman\Npertandingan resmi klub musim panas."
Dialogue: 0,0:15:44.08,0:15:48.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Mungkin kelelahan karena terus bermain,\Nterkadang fokus dan semangat menurun."
Dialogue: 0,0:15:49.39,0:15:51.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya karena mempertimbangkan\Nkondisi kelelahanmu.
Dialogue: 0,0:15:52.00,0:15:53.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kali ini fokus saja\Npada pertandingan klub.
Dialogue: 0,0:15:56.72,0:15:58.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tidak benar, Pelatih Benzen.
Dialogue: 0,0:15:58.60,0:16:01.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akutsu yang terpilih menggantikannya\Njuga bermain di setiap pertandingan.
Dialogue: 0,0:16:01.68,0:16:03.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tidak masuk akal, 'kan?
Dialogue: 0,0:16:03.44,0:16:05.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Itu… Bagaimana dengan Kuribayashi?
Dialogue: 0,0:16:06.52,0:16:09.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena sudah sepakat dengan Garuja\Nhanya dua bulan, jadi harus mengembalikannya.
Dialogue: 0,0:16:09.76,0:16:12.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, bukankah pertandingan melawan\NFunabashi sudah ditunda?
Dialogue: 0,0:16:13.07,0:16:14.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya pertandingan itu\Nyang bisa dia ikuti.
Dialogue: 0,0:16:15.16,0:16:17.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah pertandingan melawan Funabashi selesai,\NKuribayashi akan kembali ke Tim Utama.
Dialogue: 0,0:16:18.48,0:16:20.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keempat pemain yang terpilih masuk Tim Nasional\Njuga sempat ikut pertandingan di Funabashi ini.
Dialogue: 0,0:16:21.77,0:16:22.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu ini akan sangat berat,
Dialogue: 0,0:16:22.94,0:16:24.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tetapi aku tetap harus meminta kalian\Nuntuk turun bertanding.
Dialogue: 0,0:16:25.13,0:16:25.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:16:26.27,0:16:29.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, pertandingan melawan VANS dan Omiya ini,\Nkalian berempat dipastikan tidak bisa bermain.
Dialogue: 0,0:16:30.08,0:16:32.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, bertahanlah melewati\Ndua pertandingan ini dulu.
Dialogue: 0,0:16:33.56,0:16:34.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Susunan pemain sudah ditentukan.
Dialogue: 0,0:16:35.56,0:16:37.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lini pertahanan ternyata…
Dialogue: 0,0:16:38.27,0:16:40.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti kalian merasa cemas.
Dialogue: 0,0:16:40.54,0:16:43.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemain berpengalaman seperti Kiriki\Ndan Kobayakawa akan menjadi kunci.
Dialogue: 0,0:16:44.46,0:16:45.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kiriki.
Dialogue: 0,0:16:45.84,0:16:48.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau menjadi komandan di lapangan\Ndan memimpin para pemain ini.
Dialogue: 0,0:16:51.24,0:16:52.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kiriki, apa kau mendengarku?
Dialogue: 0,0:16:54.44,0:16:56.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang kau sedang tidak berminat\Nmendengar semua ini, ya?
Dialogue: 0,0:16:58.14,0:17:01.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah kelemahanmu, Kiriki.
Dialogue: 0,0:17:02.04,0:17:03.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takasugi, kau juga.
Dialogue: 0,0:17:04.89,0:17:10.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian berdua tadi terlihat yakin\Npasti akan terpilih, 'kan?
Dialogue: 0,0:17:11.16,0:17:14.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan berkata, "Saat kami tidak ada,\Nkami mengandalkanmu."
Dialogue: 0,0:17:16.65,0:17:19.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru pola pikir seperti itu\Nyang tidak benar.
Dialogue: 0,0:17:20.01,0:17:24.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, kalian didahului\Noleh orang yang kalian remehkan.
Dialogue: 0,0:17:24.38,0:17:26.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kiriki.
Dialogue: 0,0:17:30.41,0:17:31.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah cukup, belum?
Dialogue: 0,0:17:31.66,0:17:34.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekali tidak terpilih masuk Tim Nasional\Nbukan berarti lebih rendah.
Dialogue: 0,0:17:37.07,0:17:38.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Intinya, pertandingan melawan VANS\Nsudah dekat.
Dialogue: 0,0:17:38.99,0:17:40.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kiriki, kuserahkan padamu.
Dialogue: 0,0:17:40.52,0:17:42.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski hanya mendapat satu poin pun\Ntidak masalah, lalu…
Dialogue: 0,0:17:42.73,0:17:44.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beri aku 3 poin.
Dialogue: 0,0:17:47.53,0:17:48.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kiriki.
Dialogue: 0,0:17:48.52,0:17:50.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini adalah perintah pelatih.
Dialogue: 0,0:17:50.60,0:17:54.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sebagai komandan di lapangan harus menyatukan\Ntim belum berpengalaman ini dan menang.
Dialogue: 0,0:17:55.21,0:17:56.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika tidak menang,
Dialogue: 0,0:17:56.96,0:17:58.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk sementara waktu aku tidak akan\Nmenurunkanmu bertanding.
Dialogue: 0,0:18:09.48,0:18:10.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah!
Dialogue: 0,0:18:10.70,0:18:12.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus!
Dialogue: 0,0:18:12.83,0:18:13.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat sekali!
Dialogue: 0,0:18:14.11,0:18:17.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tachibana, Asari, bahkan Takeshima\Njuga naik ke Tim A.
Dialogue: 0,0:18:17.47,0:18:20.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku selalu cemas dan takut akan\Nditurunkan kembali ke Tim B nantinya.
Dialogue: 0,0:18:20.19,0:18:22.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak disangka, jumlah siswa kelas satu\Njustru bertambah.
Dialogue: 0,0:18:22.91,0:18:25.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tachibana, sayang sekali kau malah terus\Nmembuntuti Kaneda dari Musashino,
Dialogue: 0,0:18:25.53,0:18:28.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pencetak gol terbanyak Liga Metropolitan.
Dialogue: 0,0:18:28.35,0:18:29.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:18:29.74,0:18:31.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa lebih baik menolak tawaran\Nuntuk naik ke Tim A?
Dialogue: 0,0:18:31.56,0:18:32.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:18:33.34,0:18:34.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian harus semangat, ya.
Dialogue: 0,0:18:34.75,0:18:36.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunjukkan kepada Pelatih Fukuda
Dialogue: 0,0:18:36.83,0:18:38.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bahwa siswa kelas satu\Njuga bisa diandalkan.
Dialogue: 0,0:18:39.95,0:18:40.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:18:45.34,0:18:46.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei.
Dialogue: 0,0:18:46.64,0:18:47.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus pulang dulu.
Dialogue: 0,0:18:48.33,0:18:49.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masuko.
Dialogue: 0,0:18:50.04,0:18:53.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang semua pemain hasil tahap seleksi\Ndan rekrutan sudah naik ke Tim A.
Dialogue: 0,0:18:53.85,0:18:56.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makin terlihat betapa payahnya kami\Nyang naik langsung.
Dialogue: 0,0:18:57.05,0:18:58.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa sekarang waktunya untuk senang?
Dialogue: 0,0:18:58.84,0:19:00.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, itu…
Dialogue: 0,0:19:01.02,0:19:05.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian mengajakku latihan malam\Nseperti ini beberapa kali,
Dialogue: 0,0:19:05.13,0:19:06.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tetapi apakah ini ada artinya?
Dialogue: 0,0:19:07.18,0:19:11.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selesai latihan musim panas sudah lelah total,\Ntetapi masih harus ke lapangan tanah begini.
Dialogue: 0,0:19:12.19,0:19:14.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apalagi ini malam hari,\Nsejujurnya sangat berbahaya, bukan?
Dialogue: 0,0:19:14.97,0:19:17.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya merasa kelelahan ini\Nterus menumpuk.
Dialogue: 0,0:19:17.23,0:19:19.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau memang benar soal itu.
Dialogue: 0,0:19:19.48,0:19:20.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei.
Dialogue: 0,0:19:20.70,0:19:21.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun,
Dialogue: 0,0:19:21.71,0:19:24.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelatih Fukuda akan datang melatih kita\Npada hari Kamis.
Dialogue: 0,0:19:24.94,0:19:25.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:19:25.84,0:19:27.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, lebih baik\Naku datang hari Kamis saja.
Dialogue: 0,0:19:29.32,0:19:31.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga susah payah\Nsampai akhirnya bisa bermain di Tim B.
Dialogue: 0,0:19:31.92,0:19:34.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak boleh cedera\Ndi tempat seperti ini.
Dialogue: 0,0:19:38.14,0:19:40.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cara setiap orang menjaga kondisi\Nmemang berbeda-beda.
Dialogue: 0,0:19:40.75,0:19:42.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia juga bukan orang jahat, 'kan?
Dialogue: 0,0:19:43.93,0:19:46.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa boleh buat, tingkat kesungguhan\Nsetiap orang memang berbeda.
Dialogue: 0,0:19:47.48,0:19:48.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Musim kompetisi juga\Nsudah memasuki pertengahan.
Dialogue: 0,0:19:49.29,0:19:51.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Situasi semua orang juga makin berbeda.
Dialogue: 0,0:19:52.09,0:19:55.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar Aoi dan yang lainnya\Nmelakukan latihan mandiri khusus.
Dialogue: 0,0:19:55.07,0:19:57.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah mengamati beberapa minggu ini,\Nmenurutku itu cukup menarik.
Dialogue: 0,0:19:57.74,0:19:59.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, kau tidak ikut\Nberlatih bersama mereka?
Dialogue: 0,0:19:59.37,0:20:00.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baru saja latihan.
Dialogue: 0,0:20:00.72,0:20:02.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, setelah Rohan dan yang lain datang,\Ngiliran mereka yang bermain.
Dialogue: 0,0:20:03.39,0:20:06.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar masa muda.\NPemandangan yang menarik untuk dilihat.
Dialogue: 0,0:20:06.41,0:20:07.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku merasa puas.
Dialogue: 0,0:20:09.31,0:20:13.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di antara para siswa kelas satu, sepertinya\Nhanya dia yang selalu begitu tenang.
Dialogue: 0,0:20:14.00,0:20:15.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hal itu yang selalu membuatnya\Ntampak berbeda.
Dialogue: 0,0:20:15.92,0:20:18.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, orang itu benar-benar ekstrem.
Dialogue: 0,0:20:19.34,0:20:20.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ashito.
Dialogue: 0,0:20:20.94,0:20:24.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama dua bulan terakhir,\Ndia yang paling berusaha keras
Dialogue: 0,0:20:24.24,0:20:26.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan pastinya juga yang paling kelelahan.
Dialogue: 0,0:20:27.31,0:20:31.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, tidak diragukan lagi, dia juga\Nyang paling banyak mendapat pelajaran.
Dialogue: 0,0:20:34.52,0:20:36.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu menghadapi kesulitan,
Dialogue: 0,0:20:36.30,0:20:39.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia akan berusaha keras tanpa kenal lelah.
Dialogue: 0,0:20:39.15,0:20:43.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika itu aku, aku akan merasa\Nbisa bersikap sedikit lebih santai.
Dialogue: 0,0:20:43.98,0:20:45.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, aku sangat menantikannya.
Dialogue: 0,0:20:45.79,0:20:49.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menantikan untuk melihat dia menunjukkan\Nhasil latihan khususnya di Liga Utama.
Dialogue: 0,0:20:50.51,0:20:51.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus.
Dialogue: 0,0:20:52.00,0:20:54.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah siap sepenuhnya\Nuntuk bertanding.
Dialogue: 0,0:20:55.24,0:20:57.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saatnya unjuk kemampuan!
Dialogue: 0,0:21:09.79,0:21:10.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kiriki.
Dialogue: 0,0:21:15.52,0:21:16.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh…
Dialogue: 0,0:21:17.55,0:21:19.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata kau juga bisa menunjukkan\Nekspresi seperti itu.
Dialogue: 0,0:21:44.78,0:21:47.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Susunan pemain ini akan digunakan\Nuntuk melawan Tokyo VANS akhir pekan ini.
Dialogue: 0,0:21:54.81,0:21:55.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemain inti tidak ada.
Dialogue: 0,0:21:56.67,0:21:58.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan kira hanya perlu bertahan\Ndalam pertandingan ini.
Dialogue: 0,0:21:59.26,0:22:00.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bermain dengan tujuan\Nsekadar mengincar hasil imbang.
Dialogue: 0,0:22:01.96,0:22:04.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus meraih tiga poin penuh.
Dialogue: 0,0:23:36.33,0:23:37.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten Kiriki.
Dialogue: 0,0:23:38.38,0:23:39.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Intinya,
Dialogue: 0,0:23:39.37,0:23:42.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}setelah pemanasan hari ini, tim inti\Ndan cadangan akan langsung laga internal.
Dialogue: 0,0:23:47.47,0:23:48.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus.
Dialogue: 0,0:23:50.65,0:23:51.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sakit sekali.
Dialogue: 0,0:24:00.91,0:24:01.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah kau starter?
Dialogue: 0,0:24:02.22,0:24:03.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak memerlukan ini.
Dialogue: 0,0:24:03.88,0:24:04.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semangat.
Dialogue: 0,0:24:15.48,0:24:16.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan biarkan Tokyo VANS\Nmencetak satu gol pun.
Dialogue: 0,0:24:16.84,0:24:18.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suaramu terlalu keras.
Dialogue: 0,0:24:18.30,0:24:19.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}-Aku pasti bisa melakukannya.\N-Memang punya kemampuan.
Dialogue: 0,0:24:19.98,0:24:21.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar seperti anak kecil\Nyang asyik bermain.
Dialogue: 0,0:24:21.61,0:24:23.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anggap aja belajar dari lawan yang kuat,\Njadi bertarunglah tanpa ragu.
Dialogue: 0,0:24:23.72,0:24:24.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}-Kumohon padamu.\N-Harus menang.
Dialogue: 0,0:24:25.61,0:24:26.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harus menang.
Dialogue: 0,0:24:27.31,0:24:28.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus menang!
