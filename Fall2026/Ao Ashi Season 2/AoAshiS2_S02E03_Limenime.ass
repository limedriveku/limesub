Dialogue: 0,0:00:00.99,0:00:03.15,sign,,0000,0000,0000,,ESPERION B VERSUS SMA TOKUZENIN
Dialogue: 0,0:02:07.81,0:02:10.02,sign,,0000,0000,0000,,(Aoashi Season2)
Dialogue: 0,0:02:40.47,0:02:44.76,sign,,0000,0000,0000,,(Episode 3: Liga Utama Babak ke-7,\NMelawan SMK Kashiwa)
Dialogue: 0,0:02:44.76,0:02:47.75,sign,,0000,0000,0000,,LIGA UTAMA PIALA TAKAMADO U-18
Dialogue: 0,0:02:56.25,0:03:00.03,sign,,0000,0000,0000,,SATU TENDANGAN MENEMBUS JIWA, KASHIWA
Dialogue: 0,0:03:24.49,0:03:26.40,sign,,0000,0000,0000,,PEMBUKAAN KEJUARAAN SEPAK BOLA SMA NASIONAL
Dialogue: 0,0:03:26.40,0:03:28.43,sign,,0000,0000,0000,,BERJUANG MERAIH PANGGUNG SEBAGAI SISWA SMA
Dialogue: 0,0:03:38.16,0:03:41.15,sign,,0000,0000,0000,,LIGA UTAMA PIALA TAKAMADO U-18
Dialogue: 0,0:04:44.30,0:04:47.30,sign,,0000,0000,0000,,SMK KASHIWA VERSUS ESPERION
Dialogue: 0,0:11:58.44,0:12:02.20,sign,,0000,0000,0000,,SMK KASHIWA VERSUS ESPERION
Dialogue: 0,0:13:36.79,0:13:39.13,sign,,0000,0000,0000,,HUH…
Dialogue: 0,0:14:05.24,0:14:08.91,sign,,0000,0000,0000,,FORMULIR PERMOHONAN PERGANTIAN PEMAIN
Dialogue: 0,0:16:20.75,0:16:23.25,sign,,0000,0000,0000,,RUANG GANTI
Dialogue: 0,0:23:56.67,0:24:03.92,sign,,0000,0000,0000,,TOKYO CITY ESPERION FC
Dialogue: 0,0:24:26.62,0:24:29.01,sign,,0000,0000,0000,,(Episode Berikutnya: Kunci)
Dialogue: 0,0:24:29.01,0:24:29.78,sign,,0000,0000,0000,,PROGRAM INI FIKSI, TIDAK TERKAIT DENGAN TOKOH,\NKELOMPOK, ATAU NAMA DI DUNIA NYATA
Dialogue: 0,0:00:00.99,0:00:02.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kembali bertahan!
Dialogue: 0,0:00:02.27,0:00:03.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semangat!
Dialogue: 0,0:00:03.80,0:00:05.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ikuti dia!
Dialogue: 0,0:00:05.05,0:00:05.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maju!
Dialogue: 0,0:00:05.96,0:00:07.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Singkirkan dia!
Dialogue: 0,0:00:11.71,0:00:13.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}-Wah!\N-Bagus!
Dialogue: 0,0:00:14.16,0:00:17.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}4 - 0
Dialogue: 0,0:00:18.25,0:00:20.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tachibana hebat sekali!
Dialogue: 0,0:00:20.49,0:00:22.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tendangan yang bagus!
Dialogue: 0,0:00:22.25,0:00:24.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ashito, Otomo.
Dialogue: 0,0:00:24.68,0:00:27.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau orang lain berkata tim jadi lemah\Nhanya karena kalian berdua tidak ada.
Dialogue: 0,0:00:28.35,0:00:29.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua orang sudah berusaha keras.
Dialogue: 0,0:00:30.00,0:00:32.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kondisi Tim B sedang sangat bagus.
Dialogue: 0,0:00:32.88,0:00:33.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:00:35.15,0:00:36.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:00:39.07,0:00:40.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian juga harus semangat.
Dialogue: 0,0:00:40.70,0:00:41.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terutama kau, Ashito.
Dialogue: 0,0:00:42.16,0:00:44.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah kau masuk daftar pemain cadangan\Nuntuk Liga Utama besok?
Dialogue: 0,0:00:45.29,0:00:45.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:00:46.36,0:00:48.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Walaupun kemungkinan besar\Nkau tidak akan turun bermain.
Dialogue: 0,0:00:48.76,0:00:50.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Liga tidak semudah itu.
Dialogue: 0,0:00:50.96,0:00:54.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Liga Utama adalah\Nkompetisi tingkat tertinggi untuk SMA.
Dialogue: 0,0:00:54.80,0:00:56.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski hanya menonton dari bangku cadangan,
Dialogue: 0,0:00:56.48,0:00:58.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}seharusnya kau tetap bisa\Nbelajar banyak hal.
Dialogue: 0,0:00:58.33,0:01:03.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Na-Namun, asalkan ada di bangku cadangan,\Nbukan berarti tidak mungkin turun bermain.
Dialogue: 0,0:01:04.40,0:01:06.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Persiapkan dirimu baik-baik, Ashito.
Dialogue: 0,0:01:07.45,0:01:08.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:02:47.86,0:02:48.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh…
Dialogue: 0,0:02:50.56,0:02:53.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awalnya kupikir karena ini Liga Utama,
Dialogue: 0,0:02:53.05,0:02:55.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}suasananya di sini seharusnya\Nakan lebih meriah.
Dialogue: 0,0:02:56.25,0:02:58.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain pemandu sorak dan para orang tua,
Dialogue: 0,0:02:58.64,0:03:00.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hampir tidak ada penonton sama sekali.
Dialogue: 0,0:03:00.62,0:03:02.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Reporternya justru lumayan banyak.
Dialogue: 0,0:03:02.14,0:03:05.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, sepertinya semuanya datang\Ndemi Kuribayashi.
Dialogue: 0,0:03:08.36,0:03:09.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Heh.
Dialogue: 0,0:03:11.37,0:03:14.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bicara soal kompetisi\Ntingkat tertinggi di level SMA,
Dialogue: 0,0:03:14.14,0:03:16.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kebanyakan orang pasti pertama-tama\Nakan memikirkan
Dialogue: 0,0:03:17.44,0:03:20.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Kejuaraan Sepak Bola SMA Nasional", 'kan?
Dialogue: 0,0:03:20.62,0:03:22.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimanapun, itu acara\Nyang sangat ikonik saat Tahun Baru.
Dialogue: 0,0:03:23.28,0:03:23.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun,
Dialogue: 0,0:03:24.49,0:03:26.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pada akhirnya, itu hanya kompetisi
Dialogue: 0,0:03:26.40,0:03:28.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk menentukan tim SMA terbaik di Jepang.
Dialogue: 0,0:03:28.43,0:03:30.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja tidak ada Tim Remaja\Nyang ikut serta.
Dialogue: 0,0:03:31.36,0:03:33.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tim sekolah SMA dan Tim Remaja\Nsaling beradu sepanjang tahun
Dialogue: 0,0:03:33.77,0:03:36.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk menentukan siapa yang benar-benar\Nterbaik di Jepang pada tingkat SMA.
Dialogue: 0,0:03:36.62,0:03:37.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, itu adalah
Dialogue: 0,0:03:38.16,0:03:41.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Piala Takamado Liga Utama".
Dialogue: 0,0:03:45.18,0:03:46.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}SMK Kashiwa.
Dialogue: 0,0:03:47.08,0:03:48.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan aku pun tahu.
Dialogue: 0,0:03:49.28,0:03:51.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimanapun, mereka adalah\Nsekolah ternama.
Dialogue: 0,0:03:51.55,0:03:53.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pernah sekali meraih\Njuara Kejuaraan Nasional
Dialogue: 0,0:03:53.77,0:03:55.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan tiga kali kompetisi olahraga terpadu\NSMA tingkat nasional.
Dialogue: 0,0:03:56.01,0:03:57.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Klub sepak bolanya memiliki 200 orang
Dialogue: 0,0:03:58.33,0:04:00.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan merupakan salah satu\Ntim terkuat di Jepang.
Dialogue: 0,0:04:01.07,0:04:02.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejujurnya,
Dialogue: 0,0:04:03.20,0:04:07.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}saat bertanding di Tim B, aku sudah sering\Nmelihat tim SMA dengan anggota banyak.
Dialogue: 0,0:04:07.44,0:04:09.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, hal itu belum bisa membuatku takut.
Dialogue: 0,0:04:10.57,0:04:12.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, hal yang pertama kali\Nkurasakan adalah
Dialogue: 0,0:04:12.64,0:04:15.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aura kuat para pemain starter Kashiwa.
Dialogue: 0,0:04:15.85,0:04:18.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada sesuatu yang tidak biasa…\NApa bisa disebut "tekanan"?
Dialogue: 0,0:04:21.66,0:04:23.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yuma, kau mau air?
Dialogue: 0,0:04:23.32,0:04:24.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh, berikan aku minuman isotonik.
Dialogue: 0,0:04:44.30,0:04:47.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}0 - 0
Dialogue: 0,0:05:04.35,0:05:06.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}-Hentikan dia!\N-Hentikan dia!
Dialogue: 0,0:05:06.60,0:05:07.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan biarkan dia lewat!
Dialogue: 0,0:05:08.41,0:05:09.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh.
Dialogue: 0,0:05:09.96,0:05:10.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Intersep yang bagus!
Dialogue: 0,0:05:14.28,0:05:15.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oper kemari!
Dialogue: 0,0:05:21.95,0:05:23.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ih!
Dialogue: 0,0:05:25.47,0:05:26.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat sekali.
Dialogue: 0,0:05:27.98,0:05:29.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ganas sekali!
Dialogue: 0,0:05:31.18,0:05:33.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melihat dari sedekat ini benar-benar\Nmembuatku bisa merasakan semuanya.
Dialogue: 0,0:05:33.48,0:05:35.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempo pertandingannya cepat sekali.
Dialogue: 0,0:05:35.64,0:05:37.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Levelnya tinggi sekali.
Dialogue: 0,0:05:37.92,0:05:41.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimanapun, Liga Utama seperti bertanding\Ndi kejuaraan nasional setiap minggu.
Dialogue: 0,0:05:41.08,0:05:43.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, yang paling hebat adalah
Dialogue: 0,0:05:43.40,0:05:46.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ternyata mereka bisa mengimbangi\Npara monster di tim kita.
Dialogue: 0,0:05:52.94,0:05:53.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Datang lagi.
Dialogue: 0,0:05:53.95,0:05:56.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aura tekanan yang luar biasa\Ndari SMK Kashiwa ini.
Dialogue: 0,0:05:57.79,0:05:58.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maju!
Dialogue: 0,0:06:00.91,0:06:02.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, begitu rupanya.
Dialogue: 0,0:06:02.51,0:06:03.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini adalah…
Dialogue: 0,0:06:04.06,0:06:05.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Aura membunuh", 'kan?
Dialogue: 0,0:06:06.52,0:06:10.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari 200 pemain, hanya 11 orang\Nyang bisa turun bertanding.
Dialogue: 0,0:06:10.19,0:06:12.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tingkat persaingannya benar-benar\Nberbeda dengan Tim Remaja.
Dialogue: 0,0:06:12.76,0:06:16.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beban yang dipikul 11 pemain terpilih itu\Nbenar-benar berbeda.
Dialogue: 0,0:06:17.39,0:06:18.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong,
Dialogue: 0,0:06:19.26,0:06:21.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku datang ke sini karena ini\Npertama kalinya Aoi masuk Liga Utama!
Dialogue: 0,0:06:21.16,0:06:21.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, dia malah duduk di bangku cadangan!
Dialogue: 0,0:06:21.98,0:06:23.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan Kuribayashi juga!
Dialogue: 0,0:06:23.32,0:06:24.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya kenapa?
Dialogue: 0,0:06:25.95,0:06:28.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa dia tidak menjadi starter?
Dialogue: 0,0:06:29.20,0:06:32.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika Kuribayashi tidak main,\Npercuma saja kita datang untuk meliput.
Dialogue: 0,0:06:32.91,0:06:35.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah kondisinya memang sedang buruk?
Dialogue: 0,0:06:35.42,0:06:36.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa dia cedera?
Dialogue: 0,0:06:36.81,0:06:39.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Intinya, mereka meremehkan kita, 'kan?
Dialogue: 0,0:06:39.53,0:06:40.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan begitu.
Dialogue: 0,0:06:40.43,0:06:42.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika hanya meremehkan kita,\Nitu tidak masalah.
Dialogue: 0,0:06:42.08,0:06:44.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, kalau mereka juga\Nmeremehkan Pelatih Utama Sugiura…
Dialogue: 0,0:06:44.91,0:06:45.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mochizuki.
Dialogue: 0,0:06:46.76,0:06:48.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biasanya aku selalu mengatakan
Dialogue: 0,0:06:48.99,0:06:51.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk menghormati lawan.
Dialogue: 0,0:06:51.58,0:06:54.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebelum bermain sepak bola,\Njadilah orang yang kuat dulu.
Dialogue: 0,0:06:55.96,0:06:57.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan marah hanya karena hal sepele.
Dialogue: 0,0:06:58.19,0:06:58.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:07:05.48,0:07:06.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun,
Dialogue: 0,0:07:06.68,0:07:09.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tetap berharap Kuribayashi bisa main.
Dialogue: 0,0:07:10.09,0:07:14.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin kalian melawan\N"karya terbaik Tim Remaja" itu.
Dialogue: 0,0:07:15.56,0:07:20.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hal ini hanya bisa terwujud\Ndi panggung Liga Utama.
Dialogue: 0,0:07:21.53,0:07:25.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepak bola SMA benar-benar\Npunya atmosfer yang unik.
Dialogue: 0,0:07:26.14,0:07:30.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu banyak orang dipimpin\Noleh seorang pelatih yang karismatik
Dialogue: 0,0:07:30.19,0:07:32.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan disatukan dengan begitu terorganisasi.
Dialogue: 0,0:07:32.78,0:07:33.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu,
Dialogue: 0,0:07:33.94,0:07:36.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}semuanya dibangun dari fondasi\Nsepak bola yang paling mendasar.
Dialogue: 0,0:07:37.42,0:07:39.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski tidak sampai seperti militer,
Dialogue: 0,0:07:39.45,0:07:40.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}memang ada beberapa kemiripan.
Dialogue: 0,0:07:41.53,0:07:43.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini adalah pemandangan yang hanya bisa\Ndilihat dalam sepak bola SMA.
Dialogue: 0,0:07:43.37,0:07:45.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu melewati tahap ini, pemandangan\Nseperti ini tidak akan terlihat lagi.
Dialogue: 0,0:07:47.10,0:07:49.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa hal ini seunik itu?
Dialogue: 0,0:07:50.08,0:07:51.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimanapun juga, hanya di Jepang\Nyang seperti ini.
Dialogue: 0,0:07:51.96,0:07:54.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu tim sampai memiliki 200 orang.
Dialogue: 0,0:07:54.68,0:07:56.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, pelatih yang mampu menyatukan\Norang sebanyak itu benar-benar luar biasa.
Dialogue: 0,0:07:56.81,0:07:58.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelatih Utama Sugiura
Dialogue: 0,0:07:58.97,0:08:01.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah salah satu pelatih terkemuka\Ndi dunia sepak bola SMA.
Dialogue: 0,0:08:02.01,0:08:03.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ditambah lagi, sebelum bergabung\Ndengan Kashiwa,
Dialogue: 0,0:08:04.01,0:08:05.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}rekornya mencakup dua gelar\Njuara Kejuaraan Nasional
Dialogue: 0,0:08:05.66,0:08:07.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan dua gelar juara kompetisi\Nolahraga terpadu SMA tingkat nasional.
Dialogue: 0,0:08:07.76,0:08:10.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia juga terkenal sebagai "pelatih iblis".
Dialogue: 0,0:08:10.40,0:08:12.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar para pemain\Nsangat takut di hadapannya.
Dialogue: 0,0:08:13.18,0:08:15.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, justru karena kemampuannya itu,
Dialogue: 0,0:08:15.13,0:08:17.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}semua orang baru bersedia mengikutinya.
Dialogue: 0,0:08:17.82,0:08:19.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia memang pelatih ternama.
Dialogue: 0,0:08:20.97,0:08:22.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat sekali.
Dialogue: 0,0:08:23.98,0:08:26.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka semua mengerahkan segenap tenaga\Nuntuk merebut bola dengan ketat.
Dialogue: 0,0:08:27.74,0:08:28.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seburuk apa pun, tetap harus maju.
Dialogue: 0,0:08:29.56,0:08:31.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sepak bola yang paling kusukai.
Dialogue: 0,0:08:32.75,0:08:34.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Babak pertama sudah berjalan\Nlebih dari 30 menit.
Dialogue: 0,0:08:34.46,0:08:36.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka masih bisa mengimbangi\NTim A kita sampai sekarang.
Dialogue: 0,0:08:36.48,0:08:37.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan mengimbangi, 'kan?
Dialogue: 0,0:08:37.88,0:08:38.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Uhm.
Dialogue: 0,0:08:44.94,0:08:46.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tutup sisi kiri.
Dialogue: 0,0:08:48.80,0:08:50.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yamada, tahan!
Dialogue: 0,0:08:50.01,0:08:51.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berjaga di sana!
Dialogue: 0,0:08:51.48,0:08:54.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial, apa mereka ini\Nmanusia bionik sepak bola?
Dialogue: 0,0:08:54.83,0:08:57.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan tidak ada kesalahan sedikit pun.
Dialogue: 0,0:08:57.98,0:09:00.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akurasinya terpaut beberapa sentimeter\Ntanpa gerakan yang sia-sia.
Dialogue: 0,0:09:01.36,0:09:03.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penguasaan bola kita\Nmemang selalu lebih tinggi,
Dialogue: 0,0:09:04.12,0:09:07.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tetapi mungkin lawan sengaja\N"membiarkan kita menguasai bola".
Dialogue: 0,0:09:12.65,0:09:13.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus!
Dialogue: 0,0:09:15.36,0:09:17.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, dapat posisi bagus.
Dialogue: 0,0:09:17.10,0:09:18.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maju, Yuma!
Dialogue: 0,0:09:18.59,0:09:20.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seluruh lini pertahanan maju!
Dialogue: 0,0:09:24.36,0:09:26.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sialan, ternyata semuanya dalam sekejap…
Dialogue: 0,0:09:26.94,0:09:27.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:09:27.76,0:09:28.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, ini juga sebuah kesempatan.
Dialogue: 0,0:09:29.05,0:09:31.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bek tengahnya sampai maju sejauh itu.
Dialogue: 0,0:09:32.96,0:09:33.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:09:33.79,0:09:35.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang saatnya, oper bolanya kemari!
Dialogue: 0,0:09:39.28,0:09:40.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inara!
Dialogue: 0,0:09:43.52,0:09:45.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, datanglah.
Dialogue: 0,0:09:45.68,0:09:48.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan memanfaatkan celah\Nsaat kau maju, lalu menerobos dari kanan.
Dialogue: 0,0:09:48.86,0:09:50.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan kecepatanku, aku pasti berhasil.
Dialogue: 0,0:09:50.88,0:09:51.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:09:52.00,0:09:52.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Majulah!
Dialogue: 0,0:09:59.02,0:10:01.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski harus mundur, ulurlah waktu untukku.
Dialogue: 0,0:10:01.37,0:10:02.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shimura.
Dialogue: 0,0:10:04.00,0:10:05.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tidak bergerak.
Dialogue: 0,0:10:06.33,0:10:08.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa berhenti, Inara?
Dialogue: 0,0:10:08.06,0:10:10.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentukan hasilnya di sini!
Dialogue: 0,0:10:10.49,0:10:11.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inara!
Dialogue: 0,0:10:11.37,0:10:13.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sialan, terpaksa bolanya…
Dialogue: 0,0:10:19.77,0:10:21.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akutsu, sapuan yang bagus!
Dialogue: 0,0:10:21.80,0:10:23.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus! Hebat!
Dialogue: 0,0:10:24.14,0:10:25.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal dia sudah maju sejauh itu,
Dialogue: 0,0:10:26.35,0:10:28.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tetapi bisa secepat ini kembali bertahan?
Dialogue: 0,0:10:31.23,0:10:32.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para pemain lini kedua dan seterusnya,
Dialogue: 0,0:10:32.65,0:10:33.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}semuanya sudah kembali.
Dialogue: 0,0:10:34.48,0:10:35.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luar biasa.
Dialogue: 0,0:10:35.90,0:10:38.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski lawannya adalah\Ntim kuat SMK Kashiwa,
Dialogue: 0,0:10:38.25,0:10:41.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang mengendalikan\Npertandingan tetap Esperion.
Dialogue: 0,0:10:42.65,0:10:43.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah.
Dialogue: 0,0:10:43.66,0:10:44.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah.
Dialogue: 0,0:10:47.20,0:10:49.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemain bek kiri, Taira…
Dialogue: 0,0:10:50.22,0:10:50.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa dia cedera?
Dialogue: 0,0:10:51.66,0:10:52.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga saja dia baik-baik saja.
Dialogue: 0,0:10:53.12,0:10:55.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa cedera lamanya kambuh?
Dialogue: 0,0:10:56.72,0:11:00.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian anak SMA masih sama saja.\NBegitu berhadapan dengan Tim Remaja
Dialogue: 0,0:11:01.04,0:11:02.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}langsung penuh aura membunuh.
Dialogue: 0,0:11:04.25,0:11:05.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu semangat kalian?
Dialogue: 0,0:11:06.62,0:11:10.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa dengan terus berjuang sekuat tenaga,\Nkalian bisa jadi hebat tanpa disadari?
Dialogue: 0,0:11:11.18,0:11:13.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benar-benar tidak paham.
Dialogue: 0,0:11:18.57,0:11:20.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebelum bermain sepak bola,
Dialogue: 0,0:11:20.54,0:11:22.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadilah orang yang kuat terlebih dulu.
Dialogue: 0,0:11:26.16,0:11:27.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian sangat kuat.
Dialogue: 0,0:11:27.79,0:11:28.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuat sekali.
Dialogue: 0,0:11:29.53,0:11:32.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski sekarang masih 0-0, rasanya kalian\Nlebih berpeluang mencetak gol.
Dialogue: 0,0:11:33.53,0:11:34.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, biasanya
Dialogue: 0,0:11:34.92,0:11:36.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}suasana di Tim Remaja lebih santai.
Dialogue: 0,0:11:37.37,0:11:38.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, kalian berbeda.
Dialogue: 0,0:11:39.64,0:11:41.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tatapan mata kalian
Dialogue: 0,0:11:42.08,0:11:43.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}malah agak mirip dengan kami.
Dialogue: 0,0:11:46.97,0:11:50.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika sudah mencapai level seperti ini,\Napa mereka tidak mudah terpancing lagi?
Dialogue: 0,0:11:58.44,0:12:02.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}0 - 0
Dialogue: 0,0:12:18.04,0:12:18.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taira…
Dialogue: 0,0:12:20.12,0:12:22.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya tidak bisa lanjut lagi.
Dialogue: 0,0:12:22.76,0:12:24.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa mereka akan melakukan\Npergantian pemain di awal babak kedua?
Dialogue: 0,0:12:25.20,0:12:27.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa Kuribayashi akan main?
Dialogue: 0,0:12:29.52,0:12:32.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan kau sedang berpikir\N"bisa saja aku yang turun bermain"?
Dialogue: 0,0:12:33.60,0:12:34.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah.
Dialogue: 0,0:12:39.24,0:12:41.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika bisa bermain, tentu saja aku mau.
Dialogue: 0,0:12:43.77,0:12:45.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar tidak tahu diri.
Dialogue: 0,0:12:45.79,0:12:48.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jelas-jelas kau bahkan tidak tahu\Nalasan duduk di bangku cadangan.
Dialogue: 0,0:12:49.12,0:12:50.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akutsu.
Dialogue: 0,0:12:52.11,0:12:53.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana caramu melakukannya?
Dialogue: 0,0:12:53.92,0:12:55.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bertahan dan juga menyerang.
Dialogue: 0,0:12:56.08,0:12:57.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:12:57.60,0:13:01.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duet bek tengahmu dengan Shimura membuat\Nlawan merasa tidak mungkin ditembus.
Dialogue: 0,0:13:01.98,0:13:04.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua orang bisa maju menyerang\Ndengan tenang.
Dialogue: 0,0:13:04.30,0:13:07.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, kau juga sering\Nmembantu menyerang.
Dialogue: 0,0:13:07.80,0:13:09.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal kau terus menyerang berkali-kali,
Dialogue: 0,0:13:09.93,0:13:12.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tetapi sama sekali tidak membuat orang\Nmerasa "ada celah di gawang belakang".
Dialogue: 0,0:13:12.36,0:13:14.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu ada masalah,\Nkau pasti langsung kembali.
Dialogue: 0,0:13:16.19,0:13:18.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat sekali. Bagaimana caranya\Nbaru bisa melakukan…
Dialogue: 0,0:13:19.07,0:13:20.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah!
Dialogue: 0,0:13:20.89,0:13:21.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menjijikkan sekali.
Dialogue: 0,0:13:22.35,0:13:24.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bicara denganmu\Nsama sekali tidak ada gunanya.
Dialogue: 0,0:13:30.46,0:13:31.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aoi.
Dialogue: 0,0:13:31.55,0:13:32.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kau lakukan?
Dialogue: 0,0:13:32.97,0:13:33.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat jalan.
Dialogue: 0,0:13:39.69,0:13:43.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya ini pertama kalinya\Naku mengobrol sebanyak ini dengan Akutsu.
Dialogue: 0,0:13:43.76,0:13:46.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melelahkan sekali.
Dialogue: 0,0:14:05.24,0:14:07.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang seharusnya Kuribayashi yang masuk, 'kan?
Dialogue: 0,0:14:07.52,0:14:08.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga berpikir begitu.
Dialogue: 0,0:14:11.64,0:14:14.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagi Aoi, sekarang masih terlalu dini.
Dialogue: 0,0:14:14.51,0:14:16.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pilihan berikutnya adalah\NShimizu atau Nagano.
Dialogue: 0,0:14:17.52,0:14:21.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alur pertandingan hari ini tidak sesuai\Nbagi bek sayap seperti Shimizu dan Nagano.
Dialogue: 0,0:14:22.91,0:14:25.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biarkan lawan kontrol bola dulu,\Nlalu serang setelah merebut kembali bola.
Dialogue: 0,0:14:26.25,0:14:28.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hal ini membutuhkan kemampuan menyerang\Ndan stamina berlari yang tinggi.
Dialogue: 0,0:14:29.82,0:14:32.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, mereka berdua jelas adalah\Npemain bertipe bertahan.
Dialogue: 0,0:14:33.93,0:14:36.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,\Npilihannya hanya Kuribayashi.
Dialogue: 0,0:14:36.22,0:14:37.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelatih Fukuda.
Dialogue: 0,0:14:37.79,0:14:41.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ubah lini pertahanan empat pemain saat ini\Nmenjadi tiga pemain,
Dialogue: 0,0:14:41.48,0:14:43.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu tempatkan Kuribayashi\Nsebagai gelandang serang.
Dialogue: 0,0:14:47.45,0:14:48.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:14:48.92,0:14:49.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, Kuribayashi saja.
Dialogue: 0,0:14:51.84,0:14:53.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memang berniat\Nmenurunkannya ke lapangan.
Dialogue: 0,0:14:53.48,0:14:57.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, ternyata jauh lebih cepat\Ndari yang kukira.
Dialogue: 0,0:14:57.36,0:14:59.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, apa boleh buat.
Dialogue: 0,0:14:59.08,0:15:00.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya kau sangat enggan.
Dialogue: 0,0:15:00.44,0:15:02.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, untuk apa kau\Nmemanggilnya kembali dulu?
Dialogue: 0,0:15:02.52,0:15:04.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau hanya demi menang,
Dialogue: 0,0:15:04.84,0:15:06.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku sudah lama menyuruhnya main\Nsebagai starter.
Dialogue: 0,0:15:07.69,0:15:10.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meskipun Kuribayashi meninggalkan tim\Nselama empat bulan,
Dialogue: 0,0:15:10.81,0:15:12.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}itu sama sekali bukan masalah\Nbagi anak itu.
Dialogue: 0,0:15:12.52,0:15:13.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asalkan dia turun bermain,\Nkita pasti menang.
Dialogue: 0,0:15:14.73,0:15:15.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun,
Dialogue: 0,0:15:16.14,0:15:16.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}siapa yang tahu?
Dialogue: 0,0:15:17.76,0:15:21.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menempatkan Kuribayashi yang tidak ikut\Nlatihan sebagai pemain inti sejak awal,
Dialogue: 0,0:15:21.79,0:15:25.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apakah itu benar-benar demi tim…\NDan demi anak itu?
Dialogue: 0,0:15:26.65,0:15:30.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tim Remaja harus mengutamakan\Npembinaan daripada kemenangan.
Dialogue: 0,0:15:32.83,0:15:34.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi,
Dialogue: 0,0:15:34.03,0:15:35.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuribayashi paling banyak hanya akan\Nmain pada 15 menit terakhir.
Dialogue: 0,0:15:36.46,0:15:39.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awalnya aku berniat menurunkannya bermain\Nagar dia tidak kaku dengan pertandingan.
Dialogue: 0,0:15:40.51,0:15:44.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, aku benar-benar tidak menyangka\Ndia bahkan tidak ikut latihan sekali pun.
Dialogue: 0,0:15:45.26,0:15:47.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tim Remaja di Jepang posisinya\Nmemang kurang dihargai.
Dialogue: 0,0:15:48.54,0:15:50.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, yang paling disayangkan adalah
Dialogue: 0,0:15:50.92,0:15:52.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}selain Kuribayashi,
Dialogue: 0,0:15:52.65,0:15:55.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita tidak punya pemain cadangan\Nyang bisa diandalkan.
Dialogue: 0,0:15:55.32,0:15:57.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesenjangan antara starter\Ndan cadangan masih terlalu besar.
Dialogue: 0,0:15:57.58,0:16:00.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Esperion saat ini belum mampu meningkatkan\Nkualitas para pemain lapisan bawah,
Dialogue: 0,0:16:00.12,0:16:02.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sehingga belum bisa\Nmengatasi situasi mendadak.
Dialogue: 0,0:16:04.08,0:16:05.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terutama performa anak kelas satu\Nyang sangat mengecewakan.
Dialogue: 0,0:16:06.27,0:16:08.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Togashi, Kuroda, Otomo.
Dialogue: 0,0:16:09.40,0:16:11.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awalnya kukira mereka bisa\Ntampil lebih baik.
Dialogue: 0,0:16:13.24,0:16:15.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa? Tidak ke ruang ganti?
Dialogue: 0,0:16:25.48,0:16:29.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan suasana di ruang ganti pun\Nberbeda total dengan Tim B.
Dialogue: 0,0:16:30.59,0:16:32.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya sangat tenang.
Dialogue: 0,0:16:33.08,0:16:33.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun,
Dialogue: 0,0:16:34.41,0:16:38.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mereka memancarkan aura menekan\Nyang menegangkan.
Dialogue: 0,0:16:42.52,0:16:43.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat ingin bermain.
Dialogue: 0,0:16:44.51,0:16:48.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin merasakan langsung\Ntekanan ini di lapangan.
Dialogue: 0,0:16:56.06,0:16:58.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau masih ragu, Pelatih Fukuda?
Dialogue: 0,0:16:58.51,0:16:59.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti.
Dialogue: 0,0:17:00.12,0:17:01.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mainkan Kuribayashi saja.
Dialogue: 0,0:17:02.64,0:17:05.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf sudah lama menunggu.\NAwal babak kedua akan digantikan oleh…
Dialogue: 0,0:17:23.76,0:17:24.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelatih Fukuda?
Dialogue: 0,0:17:26.97,0:17:28.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau yang main,
Dialogue: 0,0:17:28.89,0:17:29.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ashito.
Dialogue: 0,0:17:31.05,0:17:31.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:17:33.68,0:17:34.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh!
Dialogue: 0,0:17:43.55,0:17:45.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aoi!
Dialogue: 0,0:17:45.88,0:17:48.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}-Ashito itu hebat juga, ya.\N-Biarkan aku menulis laporan yang bagus.
Dialogue: 0,0:17:48.30,0:17:52.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia adalah orang kedua setelah Yuma\Nyang tampil di panggung Liga Utama.
Dialogue: 0,0:18:06.52,0:18:10.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jan-Jantungku berdegup terlalu kencang.
Dialogue: 0,0:18:11.39,0:18:12.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak disangka,
Dialogue: 0,0:18:12.60,0:18:15.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku benar-benar bisa turun bermain.
Dialogue: 0,0:18:24.84,0:18:27.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}-Sakit sekali!\N-Jangan terlalu tegang begitu, Ashito.
Dialogue: 0,0:18:28.76,0:18:31.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si Rambut Kribo bermain\Nsebagai bek sayap, ya?
Dialogue: 0,0:18:31.26,0:18:34.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Intinya, sebelum benar-benar masuk ke permainan,\Nsebaiknya kau jangan maju menyerang dulu.
Dialogue: 0,0:18:35.08,0:18:36.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baik…
Dialogue: 0,0:18:37.66,0:18:38.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akutsu.
Dialogue: 0,0:18:38.68,0:18:40.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya dia akan bermain di posisimu?
Dialogue: 0,0:18:40.72,0:18:42.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau tidak perlu mengatakan\Nsesuatu kepadanya?
Dialogue: 0,0:18:49.24,0:18:50.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau bisa melakukan\Npergerakan masuk ke tengah?
Dialogue: 0,0:18:51.16,0:18:51.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Ah…
Dialogue: 0,0:18:52.41,0:18:53.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa.
Dialogue: 0,0:18:53.31,0:18:55.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku tidak akan meminta\Nhal khusus apa pun.
Dialogue: 0,0:18:55.21,0:18:57.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, setidaknya jangan biarkan lawan\Nmelakukan umpan silang.
Dialogue: 0,0:18:58.16,0:18:59.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa kalau tidak menyerang?
Dialogue: 0,0:18:59.93,0:19:00.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hmm?
Dialogue: 0,0:19:01.21,0:19:03.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}0 - 0\NBagaimanapun juga, sekarang masih imbang.
Dialogue: 0,0:19:04.44,0:19:05.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu…
Dialogue: 0,0:19:05.74,0:19:07.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh… Ashito.
Dialogue: 0,0:19:07.47,0:19:08.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, ya.
Dialogue: 0,0:19:08.92,0:19:10.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan melakukan hal yang tidak perlu.
Dialogue: 0,0:19:11.20,0:19:13.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di babak pertama, kita sudah tahu\Napa yang ingin dilakukan lawan.
Dialogue: 0,0:19:13.80,0:19:16.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, kita juga sudah membahasnya\Ndi ruang ganti.
Dialogue: 0,0:19:17.02,0:19:19.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan urusan mencetak gol kepada kami.
Dialogue: 0,0:19:30.28,0:19:32.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meskipun disuruh jangan melakukan hal\Nyang tidak perlu,
Dialogue: 0,0:19:32.49,0:19:34.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku juga tidak tahu\Nkapan bisa bermain lagi.
Dialogue: 0,0:19:35.60,0:19:38.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama ini, aku melangkah\Ndengan merebut peluang kecil yang ada.
Dialogue: 0,0:19:39.40,0:19:41.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meskipun bermain di Liga Utama,\Naku tidak boleh menjadi gentar karenanya.
Dialogue: 0,0:19:42.70,0:19:44.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama-tama, beradaptasi\Ndengan tempo pertandingan.
Dialogue: 0,0:19:44.67,0:19:45.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu…
Dialogue: 0,0:19:57.15,0:20:01.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu pembawa bola melewati lini tengah,\NKashiwa langsung maju merebut bola.
Dialogue: 0,0:20:02.44,0:20:03.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena sekarang sudah paham\Npola pergerakan mereka,
Dialogue: 0,0:20:04.43,0:20:05.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku bisa maju!
Dialogue: 0,0:20:17.58,0:20:19.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sapuan yang bagus!
Dialogue: 0,0:20:20.04,0:20:20.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sialan.
Dialogue: 0,0:20:21.71,0:20:23.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Operannya terlambat setengah langkah.
Dialogue: 0,0:20:24.03,0:20:24.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setengah langkah…
Dialogue: 0,0:20:25.45,0:20:26.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setengah langkah…
Dialogue: 0,0:20:29.42,0:20:30.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ashito!
Dialogue: 0,0:20:30.57,0:20:32.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tembus!
Dialogue: 0,0:20:34.92,0:20:36.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tangani dengan tenang…
Dialogue: 0,0:20:37.50,0:20:38.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ce-Cepat sekali!
Dialogue: 0,0:20:47.13,0:20:50.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gerakan mereka benar-benar berbeda\Ndari babak pertama.
Dialogue: 0,0:20:50.11,0:20:52.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa mereka tiba-tiba jadi seperti ini?
Dialogue: 0,0:20:52.25,0:20:54.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat, lini pertahanan mulai kacau!
Dialogue: 0,0:20:57.80,0:20:58.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setengah langkah…
Dialogue: 0,0:20:59.08,0:20:59.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setengah langkah…
Dialogue: 0,0:21:00.20,0:21:02.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang ini menyelinap ke sana kemari lagi.
Dialogue: 0,0:21:24.14,0:21:26.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang pertama mencetak gol adalah…
Dialogue: 0,0:21:28.78,0:21:29.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Esperion!
Dialogue: 0,0:21:30.81,0:21:32.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luar biasa!
Dialogue: 0,0:21:32.09,0:21:33.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}-Kerja bagus!\N-Bagus!
Dialogue: 0,0:23:27.21,0:23:28.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuat sekali…
Dialogue: 0,0:23:30.22,0:23:32.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari segi teknik dasar saja,
Dialogue: 0,0:23:32.40,0:23:35.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mereka semua jauh mengungguli kami.
Dialogue: 0,0:23:36.19,0:23:38.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu ditambah "taktik individu".
Dialogue: 0,0:23:40.20,0:23:43.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat jeda pertandingan, Pelatih Utama Fukuda\Nseharusnya sudah memberi instruksi, 'kan?
Dialogue: 0,0:23:44.88,0:23:46.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun,
Dialogue: 0,0:23:46.76,0:23:50.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}para pemain berpikir sendiri\Ndan berinisiatif mengubah gaya bermainnya.
Dialogue: 0,0:23:50.80,0:23:52.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemampuan adaptasi\Nyang luar biasa seperti ini
Dialogue: 0,0:23:53.23,0:23:55.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah hal yang tidak bisa\Ndiarahkan pelatih satu per satu.
Dialogue: 0,0:23:56.67,0:24:00.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taktik dan teknik individu yang terasah.
Dialogue: 0,0:24:00.36,0:24:03.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Esperion benar-benar tim yang luar biasa.
Dialogue: 0,0:24:05.13,0:24:06.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun,
Dialogue: 0,0:24:07.10,0:24:10.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sepertinya masih ada celah\Nyang bisa dimanfaatkan.
Dialogue: 0,0:24:15.41,0:24:16.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu adalah kombinasi permainan\Nyang begitu indah bagaikan karya seni.
Dialogue: 0,0:24:16.65,0:24:17.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sialan.
Dialogue: 0,0:24:17.71,0:24:19.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}-Jangan bercanda!\N-Bek tengah ini…
Dialogue: 0,0:24:19.20,0:24:20.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah alasan mengapa harus Akutsu, Aoi.
Dialogue: 0,0:24:20.28,0:24:22.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Kemampuanku kurang,\Njadi apa yang harus kulakukan?"
Dialogue: 0,0:24:22.57,0:24:25.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}-Kau sudah diincar.\N-Akutsu!
Dialogue: 0,0:24:25.13,0:24:25.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah
Dialogue: 0,0:24:26.62,0:24:28.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berbeda dari diriku yang dulu.
