Dialogue: 0,0:04:13.64,0:04:16.11,sign,,0000,0000,0000,,DEPAN KOMPLEKS ESPERION\NTEMPAT NAIK BUS ANTAR-JEMPUT
Dialogue: 0,0:06:53.43,0:06:55.15,sign,,0000,0000,0000,,TOKYO CITY ESPERION FC
Dialogue: 0,0:10:24.68,0:10:26.46,sign,,0000,0000,0000,,SMA SWASTA TOKYO MEISEN
Dialogue: 0,0:10:41.20,0:10:43.45,sign,,0000,0000,0000,,BAHASA NASIONAL KOMPREHENSIF
Dialogue: 0,0:10:51.18,0:10:52.04,sign,,0000,0000,0000,,(Aoashi Season2)
Dialogue: 0,0:10:59.05,0:11:02.80,sign,,0000,0000,0000,,TOKYO CITY ESPERION FC
Dialogue: 0,0:11:28.20,0:11:29.71,sign,,0000,0000,0000,,SOICHIRO
Dialogue: 0,0:14:05.56,0:14:07.02,sign,,0000,0000,0000,,KAFE MANGA
Dialogue: 0,0:14:07.52,0:14:09.36,sign,,0000,0000,0000,,YAKINIKU KUROO
Dialogue: 0,0:14:09.85,0:14:14.08,sign,,0000,0000,0000,,APOTEK MEISEN
Dialogue: 0,0:18:39.84,0:18:41.85,sign,,0000,0000,0000,,BUKU CATATAN
Dialogue: 0,0:20:16.02,0:20:17.02,sign,,0000,0000,0000,,MEMILIKI BEK SAYAP IDEAL, BISA BERALIH MENYERANG\NANDAL DALAM MENYERANG DAN BERTAHAN
Dialogue: 0,0:20:17.02,0:20:18.02,sign,,0000,0000,0000,,TIDAK MEMENUHI SYARAT\NPEMAIN INI BUTUH REKAN MENJAGA DI KIRI AGAR EFEKTIF
Dialogue: 0,0:24:28.08,0:24:29.36,sign,,0000,0000,0000,,PROGRAM INI FIKSI, TIDAK TERKAIT DENGAN TOKOH,\NKELOMPOK, ATAU NAMA DI DUNIA NYATA
Dialogue: 0,0:24:29.36,0:24:29.98,sign,,0000,0000,0000,,(Episode Berikutnya:\NMenuju Tingkat yang Lebih Tinggi)
Dialogue: 0,0:00:14.46,0:00:15.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, Nona.
Dialogue: 0,0:00:15.66,0:00:16.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan.
Dialogue: 0,0:02:08.30,0:02:09.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si-Sialan.
Dialogue: 0,0:02:12.03,0:02:13.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini kenapa?
Dialogue: 0,0:02:13.16,0:02:15.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya apa yang terjadi?
Dialogue: 0,0:02:15.71,0:02:18.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di antara para bek,\Nasalkan ada satu orang yang bergerak,
Dialogue: 0,0:02:18.22,0:02:20.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku harus mati-matian mengikuti.
Dialogue: 0,0:02:20.25,0:02:21.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak…
Dialogue: 0,0:02:27.36,0:02:28.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ga-Gawat.
Dialogue: 0,0:02:46.92,0:02:48.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei.
Dialogue: 0,0:02:48.01,0:02:49.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika jalur menembakku tidak dihalangi,
Dialogue: 0,0:02:49.58,0:02:51.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan terus menembak dari jarak jauh.
Dialogue: 0,0:02:53.87,0:02:55.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ku-Kuat sekali.
Dialogue: 0,0:02:56.11,0:02:58.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah pensiun pun masih sehebat ini.
Dialogue: 0,0:02:58.56,0:03:00.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski hanya pernah\Nmelihatnya sekali di Futami,
Dialogue: 0,0:03:00.86,0:03:03.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}teknik mengontrol bolanya\Nbenar-benar luar biasa.
Dialogue: 0,0:03:04.16,0:03:06.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, sekarang bukan waktunya\Nmemikirkan hal itu.
Dialogue: 0,0:03:06.16,0:03:07.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelatih.
Dialogue: 0,0:03:07.56,0:03:10.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimanapun juga, latihan seperti\Npermainan kereta api ini terlalu…
Dialogue: 0,0:03:10.01,0:03:10.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takeshima.
Dialogue: 0,0:03:11.85,0:03:15.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat kau bergerak, pinggangmu terlihat\Njelas berputar ke arah tujuanmu.
Dialogue: 0,0:03:16.72,0:03:18.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arah pandangan matamu juga mudah ditebak.
Dialogue: 0,0:03:19.07,0:03:20.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau harus lebih aktif menggunakan\Ngerakan tipuan untuk mengecoh lawan.
Dialogue: 0,0:03:21.07,0:03:21.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Togashi.
Dialogue: 0,0:03:22.33,0:03:25.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keinginanmu mengasah pandangan untuk melihat\Nseluruh lapangan, arahmu sudah tepat.
Dialogue: 0,0:03:25.93,0:03:28.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}-Itu…\N-Kau bisa mengamati Ashito dan meniru caranya.
Dialogue: 0,0:03:28.81,0:03:31.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}-Tunggu.\N-Begitu juga dengan Asari dan Takeshima.
Dialogue: 0,0:03:32.14,0:03:34.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebelum kalian bisa jelaskan cara bertahan\Ndengan bahasa yang dimengerti semua orang,
Dialogue: 0,0:03:35.07,0:03:37.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bukankah lebih baik kalian berlatih\Nbersama Ashito?
Dialogue: 0,0:03:38.41,0:03:41.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu kalian untuk bertukar pandang\Ndengan Tachibana selalu tidak pas, 'kan?
Dialogue: 0,0:03:42.19,0:03:43.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harus lebih sigap lagi.
Dialogue: 0,0:03:43.12,0:03:44.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, aku mengerti.
Dialogue: 0,0:03:45.05,0:03:46.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Yuma…
Dialogue: 0,0:03:47.47,0:03:48.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pertahankan saja\Nyang seperti sekarang.
Dialogue: 0,0:03:48.68,0:03:49.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:03:49.93,0:03:50.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paman.
Dialogue: 0,0:03:50.97,0:03:52.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}-Ashito.\N-Dengarkan aku dulu…
Dialogue: 0,0:03:52.56,0:03:55.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang melepaskan talinya hanya kau.
Dialogue: 0,0:03:58.08,0:04:01.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sering jalan-jalan di sekitar sini\Nsetiap Kamis malam.
Dialogue: 0,0:04:02.27,0:04:04.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menemani kalian berlatih\Npada jam ini sekali seminggu.
Dialogue: 0,0:04:05.37,0:04:08.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teruslah berlatih\Nsampai kalian benar-benar bisa.
Dialogue: 0,0:04:16.11,0:04:18.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuroda, menurut pandanganku,
Dialogue: 0,0:04:19.15,0:04:21.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kaulah "pemain yang paling mencerminkan\Nkarakter Tim Remaja".
Dialogue: 0,0:04:22.32,0:04:23.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu adalah ciri khas terbesarmu.
Dialogue: 0,0:04:25.40,0:04:28.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paling mencerminkan karakter\NTim Remaja itu maksudnya bagus
Dialogue: 0,0:04:28.27,0:04:29.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau buruk?
Dialogue: 0,0:04:30.16,0:04:31.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa pun itu, tolong katakan terus terang.
Dialogue: 0,0:04:31.80,0:04:33.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku datang memang untuk ini.
Dialogue: 0,0:04:34.83,0:04:37.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah mengenalmu\Nsejak kau di Tim Junior.
Dialogue: 0,0:04:38.44,0:04:41.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, baru kali ini kau mengakui\Nkekuranganmu secara terbuka begini.
Dialogue: 0,0:04:42.64,0:04:43.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus sekali.
Dialogue: 0,0:04:44.00,0:04:45.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kau punya tekad sebesar itu,\Naku akan menjawabmu dengan serius.
Dialogue: 0,0:04:47.42,0:04:48.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar aku tanya balik dulu.
Dialogue: 0,0:04:49.24,0:04:53.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutmu, siapa "pemain Esperion saat ini\Nyang paling tidak mirip pemain Tim Remaja?"
Dialogue: 0,0:04:53.69,0:04:54.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aoi.
Dialogue: 0,0:04:55.26,0:04:55.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:04:56.32,0:04:57.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, masih ada satu orang lagi.
Dialogue: 0,0:04:57.80,0:04:58.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:04:58.57,0:05:00.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dulu saat Aoi diterima\Ndalam tahap seleksi,
Dialogue: 0,0:05:00.72,0:05:03.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jujur saja dia tidak memenuhi standar.
Dialogue: 0,0:05:03.55,0:05:06.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, Fukuda punya standar lain.
Dialogue: 0,0:05:07.23,0:05:10.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memakai standar yang sama seperti\Nsaat menerima Akutsu di tahap seleksi dulu.
Dialogue: 0,0:05:10.80,0:05:11.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akutsu?
Dialogue: 0,0:05:12.33,0:05:17.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di Tim Remaja, kebanyakan pemainnya\Nanak teladan yang merasa mereka elite.
Dialogue: 0,0:05:17.79,0:05:19.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa dibilang mereka pandai menempatkan\Nsegalanya ke dalam teori yang sudah ada.
Dialogue: 0,0:05:20.24,0:05:21.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:05:21.20,0:05:23.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagi kita yang berasal\Ndari tim sepak bola SMA,
Dialogue: 0,0:05:23.92,0:05:25.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hal seperti itu yang kurang kita miliki.
Dialogue: 0,0:05:26.59,0:05:29.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesadaran elite itu\Nsama sekali tidak berguna.
Dialogue: 0,0:05:29.44,0:05:31.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat menghadapi pertandingan hidup mati,
Dialogue: 0,0:05:31.92,0:05:34.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}itu hanya akan membuat orang\Nlebih cepat kehilangan semangat juang.
Dialogue: 0,0:05:35.74,0:05:37.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perlu ada sedikit guncangan.
Dialogue: 0,0:05:38.06,0:05:42.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di Tim Remaja yang terlalu teratur ini\Ndibutuhkan sosok yang berani tampil beda.
Dialogue: 0,0:05:44.12,0:05:45.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ashito dan Akutsu itu sangat mirip.
Dialogue: 0,0:05:46.27,0:05:50.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dinamika yang mereka ciptakan akan membawa\Ndampak positif bagi Tim Remaja Esperion.
Dialogue: 0,0:05:54.08,0:05:55.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin tanpa sadar,
Dialogue: 0,0:05:55.85,0:05:59.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami yang naik dari bawah sudah terbiasa\Nbermain berdasarkan teori.
Dialogue: 0,0:06:00.54,0:06:04.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau belum terikat teori, sepertinya aku\Nbisa banyak belajar darimu.
Dialogue: 0,0:06:05.64,0:06:10.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, aku sudah lama menyadari\Napa yang dikatakan Pelatih Fukuda.
Dialogue: 0,0:06:11.45,0:06:16.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, aku tidak pernah berpikir\Nuntuk meninjau kembali diriku karena itu.
Dialogue: 0,0:06:17.79,0:06:20.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memang selalu meremehkan Aoi.
Dialogue: 0,0:06:21.53,0:06:23.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata yang menghambatku
Dialogue: 0,0:06:23.60,0:06:25.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah kesadaran elite\Nyang membosankan itu, ya?
Dialogue: 0,0:06:28.97,0:06:29.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Otomo.
Dialogue: 0,0:06:30.27,0:06:33.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mentalmu paling kuat\Ndi antara semua siswa tahun pertama.
Dialogue: 0,0:06:34.04,0:06:35.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jauh melampaui yang lain.
Dialogue: 0,0:06:37.37,0:06:38.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:06:39.21,0:06:40.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh!
Dialogue: 0,0:06:41.34,0:06:44.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, setiap mau bertanding,\Naku selalu gugup sampai tubuhku kaku.
Dialogue: 0,0:06:45.56,0:06:47.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bisa lebih percaya diri lagi\Nsaat bermain.
Dialogue: 0,0:06:48.22,0:06:51.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutku, kau punya kualitas\Nuntuk menjadi seorang kapten.
Dialogue: 0,0:06:52.03,0:06:53.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:06:55.15,0:06:58.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelatih Fukuda menemani kalian latihan?
Dialogue: 0,0:06:59.29,0:07:01.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh masa yang membahagiakan.
Dialogue: 0,0:07:01.98,0:07:06.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia juga bilang setiap kamis malam akan\Nmenemani kita latihan seperti hari ini.
Dialogue: 0,0:07:07.37,0:07:11.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira harus jadi pemain tetap Tim A dulu\Nagar bisa mendapat bimbingan seperti itu.
Dialogue: 0,0:07:12.03,0:07:14.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alhasil, hanya aku yang tidak mendapat\Nbimbingan berguna.
Dialogue: 0,0:07:15.53,0:07:17.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang membuat iri,
Dialogue: 0,0:07:17.69,0:07:20.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tetapi bukankah ini akan\Njadi latihan berlebihan?
Dialogue: 0,0:07:20.22,0:07:22.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian masih ada pertandingan Tim B.
Dialogue: 0,0:07:30.19,0:07:31.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Kuroda.
Dialogue: 0,0:07:31.66,0:07:33.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai besok, kami akan\Nlatihan tambahan pada malam hari.
Dialogue: 0,0:07:34.41,0:07:37.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tim penyerang kekurangan pemain.\NKalian juga ikut masuk.
Dialogue: 0,0:07:40.30,0:07:43.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya latihan rutin saja tidak cukup.\NAyo latihan bersama sekarang.
Dialogue: 0,0:07:43.87,0:07:44.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuroda!
Dialogue: 0,0:07:45.40,0:07:46.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti malah terlalu banyak latihan.
Dialogue: 0,0:07:48.38,0:07:49.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti.
Dialogue: 0,0:07:54.32,0:07:55.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa pun akan kulakukan.
Dialogue: 0,0:07:57.10,0:07:58.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuroda.
Dialogue: 0,0:07:58.89,0:07:59.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:08:02.14,0:08:04.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, aku menyadarinya.
Dialogue: 0,0:08:04.03,0:08:06.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dibanding jendela ini, pintu darurat\Nlebih sepi penjagaan.
Dialogue: 0,0:08:06.65,0:08:07.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih mudah kabur lewat sana.
Dialogue: 0,0:08:08.29,0:08:10.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Denah yang digambar tangan.
Dialogue: 0,0:08:10.46,0:08:13.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika terlalu banyak yang melanggar\Njam malam, kita akan mudah ketahuan.
Dialogue: 0,0:08:14.33,0:08:17.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kita yang di sini mencoba\Nlatihan selama seminggu dulu.
Dialogue: 0,0:08:18.00,0:08:18.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:08:19.07,0:08:22.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika berhasil, baru ajak\Npemain Tim B lainnya.
Dialogue: 0,0:08:34.38,0:08:36.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tu-Tunggu, Togashi.
Dialogue: 0,0:08:36.76,0:08:38.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau jatuh!
Dialogue: 0,0:08:38.22,0:08:40.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang kau terlalu lambat!
Dialogue: 0,0:08:42.62,0:08:44.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial.
Dialogue: 0,0:08:44.36,0:08:47.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kalian semua bisa\Nbereaksi secepat itu?
Dialogue: 0,0:08:48.00,0:08:49.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat sekali.
Dialogue: 0,0:08:49.31,0:08:51.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian benar-benar hebat.
Dialogue: 0,0:08:51.52,0:08:55.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanpa bicara pun kalian sudah paham\Ndan langsung saling menutupi celah.
Dialogue: 0,0:08:56.46,0:08:59.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski aku bilang permainan kereta api,\Nlatihan dengan tali ini dapat langsung
Dialogue: 0,0:08:59.95,0:09:03.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}memperlihatkan siapa\Nyang dasar bertahannya masih lemah.
Dialogue: 0,0:09:03.48,0:09:05.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang tidak bisa mengikutinya\Nakan langsung tertinggal.
Dialogue: 0,0:09:05.71,0:09:07.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar latihan yang revolusioner.
Dialogue: 0,0:09:14.08,0:09:15.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bodoh, Togashi!\NKenapa kau malah melihat ke sana kemari?
Dialogue: 0,0:09:18.86,0:09:20.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial!
Dialogue: 0,0:09:20.30,0:09:21.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Togashi.
Dialogue: 0,0:09:21.10,0:09:21.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau apa?
Dialogue: 0,0:09:22.14,0:09:23.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Uh, itu… Bagaimana mengatakannya, ya?
Dialogue: 0,0:09:24.27,0:09:26.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi seharusnya kau tidak perlu\Nmenoleh untuk melihat ke sana.
Dialogue: 0,0:09:27.21,0:09:29.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari posisimu sekarang,
Dialogue: 0,0:09:29.63,0:09:34.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bukankah kau sudah bisa lihat pembawa bola\Ndan lawan yang harus kau awasi sekaligus?
Dialogue: 0,0:09:34.88,0:09:37.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, tidak perlu memaksakan diri menoleh,
Dialogue: 0,0:09:37.47,0:09:38.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}nanti justru salah satunya bisa terlewat.
Dialogue: 0,0:09:43.84,0:09:44.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke.
Dialogue: 0,0:10:02.57,0:10:07.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meskipun aku belum jelas\Napa efeknya latihan tali seperti ini,
Dialogue: 0,0:10:07.64,0:10:09.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku hanya bisa\Nterus berlatih sekuat tenaga.
Dialogue: 0,0:10:10.73,0:10:11.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak boleh kalah.
Dialogue: 0,0:10:14.11,0:10:15.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, ayo latihan.
Dialogue: 0,0:10:16.67,0:10:17.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekali lagi.
Dialogue: 0,0:10:18.16,0:10:18.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:10:26.46,0:10:28.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan kata lain,
Dialogue: 0,0:10:28.56,0:10:34.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa diketahui Sanshiro pertama kali\Nmemperhatikan Mineko Satomi di adegan ini.
Dialogue: 0,0:10:34.83,0:10:38.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagi Sanshiro yang merantau ke Tokyo,\NMineko adalah sosok yang paling berbeda.
Dialogue: 0,0:10:38.92,0:10:40.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam bagian yang menggambarkan\Nkemunculan Mineko,
Dialogue: 0,0:10:40.54,0:10:41.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}baik pilihan kata
Dialogue: 0,0:10:41.20,0:10:42.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}maupun tata bahasanya
Dialogue: 0,0:10:42.12,0:10:43.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menggunakan ungkapan
Dialogue: 0,0:10:43.45,0:10:45.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang jauh lebih hidup dan ekspresif.
Dialogue: 0,0:10:46.14,0:10:48.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Kalau begitu, selanjutnya.
Dialogue: 0,0:10:48.59,0:10:49.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Motoki, kau yang baca.
Dialogue: 0,0:10:50.60,0:10:51.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:11:03.37,0:11:05.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini Paman akan\Nlatihan bersama kita, 'kan?
Dialogue: 0,0:11:06.56,0:11:08.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, hari ini adalah Kamis.
Dialogue: 0,0:11:08.84,0:11:10.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mulai gugup.
Dialogue: 0,0:11:13.61,0:11:15.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}-Oh?\N-Miyako, ada apa?
Dialogue: 0,0:11:16.72,0:11:18.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau datang lagi?
Dialogue: 0,0:11:18.56,0:11:20.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana? Apa tidak boleh?
Dialogue: 0,0:11:20.09,0:11:22.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Latihan Musashino selesai lebih awal.
Dialogue: 0,0:11:22.70,0:11:24.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ce-Celana dalamnya\Ntidak perlu dibawakan lagi.
Dialogue: 0,0:11:24.64,0:11:26.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini aku tidak bawa.
Dialogue: 0,0:11:26.49,0:11:28.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}-Ternyata…\N-Kalau begitu, sampai nanti.
Dialogue: 0,0:11:30.16,0:11:31.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hai, Anri.
Dialogue: 0,0:11:31.56,0:11:33.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau benar-benar datang.
Dialogue: 0,0:11:33.44,0:11:34.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja.
Dialogue: 0,0:11:35.04,0:11:37.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini adalah hari Pelatih Fukuda\Ndatang memberi arahan.
Dialogue: 0,0:11:38.48,0:11:42.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada akhirnya, aku juga\Nhanya ikut di hari pertama.
Dialogue: 0,0:11:42.54,0:11:46.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, kudengar Otomo dan lainnya juga ikut.\NMinggu ini semuanya berusaha keras.
Dialogue: 0,0:11:46.52,0:11:50.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku penasaran apa yang akan\Ndiajarkan Pelatih Fukuda.
Dialogue: 0,0:11:50.65,0:11:54.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin aku juga bisa\Nmendapat satu atau dua petunjuk.
Dialogue: 0,0:11:54.43,0:11:56.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu membahas Nona Miyako dulu,
Dialogue: 0,0:11:56.01,0:11:58.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}seharusnya hari ini aku hanya akan\Nmenonton dari samping.
Dialogue: 0,0:12:00.70,0:12:02.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong kosong apa yang kau katakan?
Dialogue: 0,0:12:02.68,0:12:05.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah kau sudah sengaja memakai\Npakaian yang nyaman untuk bergerak?
Dialogue: 0,0:12:10.86,0:12:11.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:12:20.25,0:12:22.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, bola ke arahmu, Otomo.
Dialogue: 0,0:12:22.54,0:12:23.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:12:32.30,0:12:33.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Otomo.
Dialogue: 0,0:12:42.22,0:12:43.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuroda.
Dialogue: 0,0:12:48.80,0:12:50.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Talimu mengencang, Ashito.
Dialogue: 0,0:12:56.48,0:12:57.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial!
Dialogue: 0,0:12:57.48,0:13:00.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ashito, bagaimana bisa kau\Nsampai dilewati nona itu?
Dialogue: 0,0:13:02.70,0:13:04.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anri, kau hebat sekali.
Dialogue: 0,0:13:04.08,0:13:07.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terakhir kali melihatmu mencetak gol\Nadalah waktu kita masih kecil.
Dialogue: 0,0:13:07.13,0:13:08.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi talinya mengencang, 'kan?
Dialogue: 0,0:13:08.52,0:13:10.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau terpancing keluar oleh Pelatih Fukuda.
Dialogue: 0,0:13:11.08,0:13:13.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, kau benar-benar\Nsudah berkembang pesat, Ashito.
Dialogue: 0,0:13:13.66,0:13:14.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:13:14.48,0:13:18.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Koordinasi bertahan kalian berempat\Nmeningkat pesat, benar-benar berbeda.
Dialogue: 0,0:13:19.18,0:13:20.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pe-Pelatih Fukuda.
Dialogue: 0,0:13:21.13,0:13:23.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Latihan tali ini benar-benar bagus.
Dialogue: 0,0:13:23.68,0:13:25.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meskipun dulu aku bilang\Nini seperti permainan kereta api,
Dialogue: 0,0:13:25.66,0:13:27.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ini benar-benar sangat cocok untukku.
Dialogue: 0,0:13:27.40,0:13:31.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika empat pemain tidak bergerak selaras,\Nmereka akan langsung terseret.
Dialogue: 0,0:13:31.21,0:13:33.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya seperti memaksa tubuh\Nuntuk mengingat gerakan-gerakan itu.
Dialogue: 0,0:13:34.41,0:13:35.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Paman…
Dialogue: 0,0:13:35.50,0:13:37.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Togashi, aku tanya padamu.
Dialogue: 0,0:13:37.66,0:13:39.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat berjalan dari asrama ke sekolah\Nlewat jalan yang di bawah itu,
Dialogue: 0,0:13:40.48,0:13:42.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ada banyak toko dengan papan nama\Nberwarna merah di sepanjang jalan, 'kan?
Dialogue: 0,0:13:43.21,0:13:44.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada berapa?
Dialogue: 0,0:13:44.35,0:13:45.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:13:45.24,0:13:46.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Merah?
Dialogue: 0,0:13:46.84,0:13:48.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti kedai ramen di pojokan itu?
Dialogue: 0,0:13:48.88,0:13:49.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:13:50.11,0:13:50.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba kupikir dulu.
Dialogue: 0,0:13:51.85,0:13:54.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, apotek di tepi sungai itu juga.
Dialogue: 0,0:13:54.30,0:13:55.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu…
Dialogue: 0,0:13:56.33,0:13:57.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiga toko.
Dialogue: 0,0:13:58.33,0:13:59.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}-Ashito.\N-Oh.
Dialogue: 0,0:13:59.74,0:14:01.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Uh.
Dialogue: 0,0:14:01.16,0:14:02.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba kupikir dulu.
Dialogue: 0,0:14:03.40,0:14:05.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Toko rental DVD.
Dialogue: 0,0:14:05.56,0:14:07.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Papan nama warnet.
Dialogue: 0,0:14:07.52,0:14:09.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Papan nama restoran yakiniku.
Dialogue: 0,0:14:09.85,0:14:14.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Togashi, papan apotek itu putih dan huruf merah.
Dialogue: 0,0:14:16.81,0:14:17.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, toko yang itu,
Dialogue: 0,0:14:18.19,0:14:19.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan yang itu.
Dialogue: 0,0:14:20.44,0:14:21.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tujuh toko.
Dialogue: 0,0:14:23.28,0:14:24.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tepat sekali.
Dialogue: 0,0:14:31.71,0:14:36.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sampai berprasangka melihat putih\Nsebagai merah. Kau masih jauh, Togashi.
Dialogue: 0,0:14:36.08,0:14:38.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan begitu, Pelatih Fukuda. Ini terlalu…
Dialogue: 0,0:14:38.94,0:14:42.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Amati semua dengan saksama selama\N24 jam sehari, mulai dari kehidupan sehari-hari.
Dialogue: 0,0:14:43.55,0:14:45.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minggu depan aku akan mengujimu\Ndengan pertanyaan lain.
Dialogue: 0,0:14:47.82,0:14:50.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuroda, ini saran untukmu.
Dialogue: 0,0:14:50.46,0:14:51.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kutulis di kertas.
Dialogue: 0,0:14:51.48,0:14:52.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baik.
Dialogue: 0,0:14:53.04,0:14:53.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tachibana, kau juga ada.
Dialogue: 0,0:14:53.85,0:14:54.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:14:54.76,0:14:56.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, anggota tim putri juga ada.
Dialogue: 0,0:14:56.56,0:14:58.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga sudah menuliskan\Npoin-poin pengamatanku.
Dialogue: 0,0:14:58.51,0:15:00.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Te-Terima kasih, Pelatih.
Dialogue: 0,0:15:01.64,0:15:02.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takeshima, Asari.
Dialogue: 0,0:15:04.14,0:15:05.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meskipun aku belum bisa\Nmempromosikan kalian ke Tim A,
Dialogue: 0,0:15:06.00,0:15:09.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bagaimana kalau besok kalian ikut bermain\Nbersama tim cadangan di laga internal?
Dialogue: 0,0:15:09.58,0:15:10.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:15:10.91,0:15:13.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, apa kami berempat bisa\Nbermain bersama?
Dialogue: 0,0:15:14.03,0:15:15.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,\Nhari ini sampai di sini saja.
Dialogue: 0,0:15:16.43,0:15:17.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:15:17.82,0:15:18.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:15:18.86,0:15:21.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tu-Tunggu sebentar, Pelatih Fukuda.
Dialogue: 0,0:15:21.71,0:15:23.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana denganku?\NTidak ada saran untukku?
Dialogue: 0,0:15:28.48,0:15:30.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, tidak ada hal khusus\Nyang perlu disampaikan.
Dialogue: 0,0:15:33.59,0:15:34.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial!
Dialogue: 0,0:15:35.02,0:15:36.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aoi.
Dialogue: 0,0:15:36.68,0:15:39.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya kau jangan minum\Nminuman itu lagi.
Dialogue: 0,0:15:39.56,0:15:42.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana aku bisa tidak minum?
Dialogue: 0,0:15:42.35,0:15:46.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah berlatih keras seminggu penuh\Nkarena sangat menantikan arahan darinya.
Dialogue: 0,0:15:46.78,0:15:48.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial!
Dialogue: 0,0:15:48.46,0:15:49.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga.
Dialogue: 0,0:15:49.82,0:15:53.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau memang berlatih\Ndengan sangat serius, Aoi.
Dialogue: 0,0:15:53.48,0:15:56.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai-sampai kau kelihatannya\Njadi agak kurus.
Dialogue: 0,0:15:56.59,0:15:58.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, begitu, ya?
Dialogue: 0,0:16:02.40,0:16:03.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu…
Dialogue: 0,0:16:03.34,0:16:05.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tetap makan.
Dialogue: 0,0:16:05.58,0:16:07.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, waktu tidurku jadi jauh berkurang.
Dialogue: 0,0:16:10.73,0:16:11.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau tidak keberatan,
Dialogue: 0,0:16:12.51,0:16:16.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mau kubuatkan bekal mulai sekarang?
Dialogue: 0,0:16:19.10,0:16:19.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:16:22.99,0:16:24.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana bisa aku merepotkanmu?
Dialogue: 0,0:16:24.76,0:16:28.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putri sponsor sampai harus mengkhawatirkan\Nhal seperti ini untuk kami juga?
Dialogue: 0,0:16:29.05,0:16:32.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, aku sudah punya daftar menu\Nyang disusun Hana.
Dialogue: 0,0:16:32.76,0:16:35.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daftar menu itu bahkan sudah disusun\Nsampai bulan Juli.
Dialogue: 0,0:16:36.96,0:16:38.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hana, ya.
Dialogue: 0,0:16:38.65,0:16:41.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, aku belum pernah\Nbertemu lagi dengannya sejak saat itu.
Dialogue: 0,0:16:42.28,0:16:44.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, kalian sedang membicarakan\Ngadis bernama Hana?
Dialogue: 0,0:16:45.26,0:16:49.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dia, tadi aku melihatnya di stasiun\Nsebelum kemari.
Dialogue: 0,0:16:49.47,0:16:51.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat itu, dia sedang bersama\NTuan Kuribayashi.
Dialogue: 0,0:16:51.98,0:16:53.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Miyako.
Dialogue: 0,0:16:53.53,0:16:55.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anri, kau juga melihatnya, 'kan?
Dialogue: 0,0:16:56.48,0:16:58.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka bahkan sengaja bertemu berdua saja.
Dialogue: 0,0:16:58.76,0:17:01.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah mereka berpacaran?
Dialogue: 0,0:17:05.55,0:17:07.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, aku menemukanmu.
Dialogue: 0,0:17:07.18,0:17:07.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:17:07.69,0:17:08.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah!
Dialogue: 0,0:17:08.83,0:17:10.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Kuribayashi.
Dialogue: 0,0:17:10.88,0:17:12.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aoi, bisa minta waktumu sebentar?
Dialogue: 0,0:17:13.26,0:17:14.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Ada apa?
Dialogue: 0,0:17:14.84,0:17:16.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dimintai tolong oleh Nona Hana.
Dialogue: 0,0:17:18.20,0:17:20.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kuberi kau beberapa saran.
Dialogue: 0,0:17:32.12,0:17:36.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi aku melihat Hana di stasiun.\NDia sedang bersama Tuan Kuribayashi.
Dialogue: 0,0:17:36.92,0:17:38.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah mereka berpacaran?
Dialogue: 0,0:17:39.63,0:17:40.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hmm…
Dialogue: 0,0:17:41.72,0:17:43.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saran, ya.
Dialogue: 0,0:17:51.21,0:17:52.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tu-Tuan Kuribayashi.
Dialogue: 0,0:17:53.39,0:17:57.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiba-tiba bilang ingin memberiku saran,\Naku jadi agak bingung dengan situasi ini.
Dialogue: 0,0:17:57.53,0:17:59.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, kenapa bisa sampai\Nmengaitkannya ke Hana?
Dialogue: 0,0:18:00.78,0:18:03.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah dia ada datang ke sekitar sini?
Dialogue: 0,0:18:04.49,0:18:06.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudmu, kau mengenal Hana?
Dialogue: 0,0:18:07.68,0:18:10.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pernah dirawat olehnya waktu kecil.
Dialogue: 0,0:18:12.56,0:18:15.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang, dia yang mengatur\Nasupan nutrisiku.
Dialogue: 0,0:18:16.48,0:18:17.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun,
Dialogue: 0,0:18:17.96,0:18:20.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}saat aku meminta bantuannya dulu,\Ndia bilang padaku
Dialogue: 0,0:18:21.20,0:18:23.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau dia berharap aku bisa\Nmemberimu beberapa saran.
Dialogue: 0,0:18:23.50,0:18:25.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata dia sampai bicara seperti itu.
Dialogue: 0,0:18:27.05,0:18:28.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini?
Dialogue: 0,0:18:29.26,0:18:31.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Catatan sepak bolaku.
Dialogue: 0,0:18:33.13,0:18:35.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau soal mengajari orang lain,\Nsepertinya aku memang tidak bisa.
Dialogue: 0,0:18:36.30,0:18:38.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, buku itu kuberikan saja padamu.
Dialogue: 0,0:18:41.95,0:18:42.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm?
Dialogue: 0,0:18:44.46,0:18:46.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang benar saja.
Dialogue: 0,0:18:46.64,0:18:49.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini buku yang kau tulis di ruang ganti\Nsaat pertandingan melawan Kashiwa, 'kan?
Dialogue: 0,0:18:50.33,0:18:51.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah ini barang yang sangat penting?
Dialogue: 0,0:18:52.73,0:18:53.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.
Dialogue: 0,0:18:54.24,0:18:55.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena aku sudah mengingat semuanya.
Dialogue: 0,0:18:56.48,0:18:58.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya tidak bisa mengajari orang?
Dialogue: 0,0:18:58.80,0:19:01.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang sehebat Tuan Kuribayashi,\Nsebenarnya sedang bicara omong kosong apa?
Dialogue: 0,0:19:01.36,0:19:05.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal Pelatih Fukuda pernah bilang\Nharus bisa mengajari orang lain.
Dialogue: 0,0:19:05.82,0:19:07.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, itu karena dia
Dialogue: 0,0:19:08.03,0:19:11.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sudah sangat hebat sampai tidak ada\Npemain lain yang bisa memahami levelnya.
Dialogue: 0,0:19:12.00,0:19:13.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu,
Dialogue: 0,0:19:14.00,0:19:17.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku makin ingin tahu\Napa sebenarnya isi buku catatan itu.
Dialogue: 0,0:19:21.87,0:19:23.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini juga terlalu aneh.
Dialogue: 0,0:19:23.60,0:19:25.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa-bisanya memberikan\Nbarang sepenting ini kepada orang lain.
Dialogue: 0,0:19:26.28,0:19:28.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal dia kelihatannya bukan tipe orang\Nyang mau mengikuti perintah begitu saja.
Dialogue: 0,0:19:30.14,0:19:31.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:19:31.32,0:19:32.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa dia menuruti perkataan Hana?
Dialogue: 0,0:19:33.56,0:19:34.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya apa hubungan mereka berdua?
Dialogue: 0,0:19:35.76,0:19:37.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, aku…
Dialogue: 0,0:19:37.29,0:19:39.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk apa sebenarnya\Naku memikirkan hal-hal seperti ini?
Dialogue: 0,0:19:39.36,0:19:41.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal masih banyak masalah\Ndi depan mata yang harus kuselesaikan.
Dialogue: 0,0:19:42.22,0:19:44.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tujuanku adalah menjadi\Npemain profesional.
Dialogue: 0,0:19:46.25,0:19:47.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar tidak berguna.
Dialogue: 0,0:19:49.60,0:19:51.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku pulang dulu.
Dialogue: 0,0:19:51.60,0:19:52.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, kukatakan dulu padamu.
Dialogue: 0,0:19:54.89,0:19:58.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buku catatan itu kutulis dengan cara\Nyang hanya bisa kumengerti sendiri.
Dialogue: 0,0:19:59.50,0:20:00.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terutama bagian taktiknya.
Dialogue: 0,0:20:01.40,0:20:04.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski diperlihatkan kepada orang lain,\Ntetap hanya sedikit yang bisa memahaminya.
Dialogue: 0,0:20:42.03,0:20:42.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Kuribayashi.
Dialogue: 0,0:20:43.74,0:20:45.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa hal seperti ini\Nbenar-benar bisa dilakukan?
Dialogue: 0,0:20:46.94,0:20:49.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena jarang sekali ada kesempatan\Nbisa mengobrol dengan Tuan Kuribayashi,
Dialogue: 0,0:20:50.04,0:20:51.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi ada hal yang ingin kutanyakan padamu.
Dialogue: 0,0:20:52.73,0:20:55.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa pun yang terjadi,\Naku ingin menjadi pemain profesional.
Dialogue: 0,0:20:56.33,0:20:58.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi mencapai tujuan itu,\Naku terus berjuang dan berusaha keras.
Dialogue: 0,0:20:58.88,0:21:00.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setiap hari aku mengerahkan\Nseluruh kemampuanku.
Dialogue: 0,0:21:00.92,0:21:01.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun,
Dialogue: 0,0:21:02.88,0:21:05.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bagi Tuan Kuribayashi menjadi\Npemain profesional adalah hal yang wajar.
Dialogue: 0,0:21:06.67,0:21:08.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah melampaui level itu.
Dialogue: 0,0:21:08.83,0:21:13.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang seperti Tuan Kuribayashi\Nbermain sepak bola demi tujuan apa?
Dialogue: 0,0:21:14.49,0:21:17.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemandangan seperti apa\Nyang terlihat di matamu?
Dialogue: 0,0:21:25.45,0:21:28.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau bermain sepak bola\Nhanya demi menjadi pemain profesional?
Dialogue: 0,0:21:28.60,0:21:29.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja.
Dialogue: 0,0:21:29.80,0:21:31.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau tanya padamu,
Dialogue: 0,0:21:33.53,0:21:36.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}siapa pemain terhebat\Ndi dunia saat ini, Aoi?
Dialogue: 0,0:21:37.39,0:21:38.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:21:39.37,0:21:43.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setiap zaman selalu begitu.\NSiapa pun yang kau tanyai soal ini,
Dialogue: 0,0:21:44.41,0:21:46.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pasti ada satu pemain\Nyang langsung terlintas di pikiran, 'kan?
Dialogue: 0,0:21:49.58,0:21:50.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berharap
Dialogue: 0,0:21:51.71,0:21:52.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}orang itu
Dialogue: 0,0:21:53.80,0:21:54.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah aku.
Dialogue: 0,0:22:03.85,0:22:06.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena sudah memutuskan mendedikasikan\Nhidup yang hanya sekali untuk sepak bola,
Dialogue: 0,0:22:07.66,0:22:11.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tidak paham alasan\Nuntuk tidak menjadikannya sebagai tujuan.
Dialogue: 0,0:22:12.92,0:22:13.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun,
Dialogue: 0,0:22:14.20,0:22:16.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ternyata kau bisa\Nmembaca buku catatan itu.
Dialogue: 0,0:22:19.92,0:22:20.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh menyenangkan.
Dialogue: 0,0:24:15.29,0:24:16.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kuhancurkan kau, bocah!
Dialogue: 0,0:24:16.89,0:24:17.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlihat.
Dialogue: 0,0:24:17.58,0:24:19.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu hanya penafsiran\Nyang menguntungkan diri sendiri.
Dialogue: 0,0:24:19.48,0:24:21.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gelar sebagai pemain terkuat di Tim Remaja\Nmasih tetap tidak tergoyahkan.
Dialogue: 0,0:24:21.04,0:24:22.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian terlalu cuek!
Dialogue: 0,0:24:22.65,0:24:24.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}-Kalian semua, ikuti aku.\N-Semangat, ya.
Dialogue: 0,0:24:24.17,0:24:25.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}-Kalian semua, ikuti aku.\N-Lihatlah ke atas.
Dialogue: 0,0:24:25.68,0:24:26.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke atas!
Dialogue: 0,0:24:27.21,0:24:28.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih tinggi lagi.
