Dialogue: 0,0:06:40.35,0:06:43.02,sign,,0000,0000,0000,,SMK KASHIWA: 0\NESPERION: 2
Dialogue: 0,0:09:32.94,0:09:34.44,sign,,0000,0000,0000,,KLUB SEPAK BOLA ESPERION
Dialogue: 0,0:13:17.75,0:13:18.58,sign,,0000,0000,0000,,LIGA PREMIER U-18
Dialogue: 0,0:24:29.21,0:24:30.05,sign,,0000,0000,0000,,{\an8}INI KISAH FIKSI DAN TAK BERHUBUNGAN\NDENGAN TOKOH ATAU ORGANISASI MANA PUN.
Dialogue: 0,0:00:03.83,0:00:04.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa ini?{\i0}
Dialogue: 0,0:00:10.92,0:00:13.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Orang macam apa dia?{\i0}
Dialogue: 0,0:00:14.59,0:00:15.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Sial!
Dialogue: 0,0:00:15.64,0:00:16.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Orang ini!
Dialogue: 0,0:00:21.14,0:00:22.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuribayashi!
Dialogue: 0,0:00:34.65,0:00:35.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil dia nyata.
Dialogue: 0,0:00:36.53,0:00:40.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua yang terjadi sejauh ini\Ntak ada artinya lagi sekarang.
Dialogue: 0,0:00:41.20,0:00:43.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya karena satu pemain masuk.
Dialogue: 0,0:00:51.76,0:00:55.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Saat kecil, menonton pemain hebat di TV,{\i0}
Dialogue: 0,0:00:56.55,0:00:59.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}atau pertama kali\Nmelihat Yoshitsune main di Tim B…{\i0}
Dialogue: 0,0:01:02.14,0:01:03.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mereka panutanku.{\i0}
Dialogue: 0,0:01:03.14,0:01:05.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kupikir kelak aku akan seperti mereka.{\i0}
Dialogue: 0,0:01:06.23,0:01:09.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tapi tak pernah kurasakan hal seperti ini…{\i0}
Dialogue: 0,0:01:12.40,0:01:13.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku takkan pernah{\i0}
Dialogue: 0,0:01:14.24,0:01:15.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}sehebat itu…{\i0}
Dialogue: 0,0:02:52.96,0:02:54.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku tak mengerti…{\i0}
Dialogue: 0,0:03:04.68,0:03:05.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa yang terjadi?{\i0}
Dialogue: 0,0:03:06.60,0:03:07.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bagaimana dia melakukannya?{\i0}
Dialogue: 0,0:03:08.81,0:03:09.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku tak paham.{\i0}
Dialogue: 0,0:03:12.98,0:03:13.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Begitu saja?{\i0}
Dialogue: 0,0:03:14.73,0:03:17.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kau hanya akan diam terpana\Ndi sana, Ashito?{\i0}
Dialogue: 0,0:03:19.94,0:03:21.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan menyerah, Teman-Teman!
Dialogue: 0,0:03:22.99,0:03:26.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan berhenti berpikir\Nsaat berada di lapangan!
Dialogue: 0,0:03:27.04,0:03:29.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuatlah sebagai manusia!
Dialogue: 0,0:03:29.25,0:03:31.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah ajaran Pelatih Sugiura!
Dialogue: 0,0:03:33.71,0:03:35.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ya!\N- Benar!
Dialogue: 0,0:03:36.21,0:03:38.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jaga Kuribayashi!
Dialogue: 0,0:03:39.17,0:03:41.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yariike, atur waktu gerakmu!
Dialogue: 0,0:03:41.72,0:03:44.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kami yang tutup ruang kosongmu!
Dialogue: 0,0:03:47.10,0:03:50.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Benar. Bahkan meski aku tak berpengalaman,{\i0}
Dialogue: 0,0:03:51.27,0:03:52.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}aku masih harus berpikir.{\i0}
Dialogue: 0,0:03:53.60,0:03:55.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa yang bisa kulakukan?{\i0}
Dialogue: 0,0:03:56.19,0:03:57.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pikirkan.{\i0}
Dialogue: 0,0:03:57.69,0:03:58.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Berpikirlah.{\i0}
Dialogue: 0,0:03:58.98,0:04:00.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Berpikirlah!{\i0}
Dialogue: 0,0:04:01.15,0:04:02.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jika tak paham, terus amati.{\i0}
Dialogue: 0,0:04:03.28,0:04:04.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku harus belajar.{\i0}
Dialogue: 0,0:04:05.16,0:04:06.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa yang bisa kulakukan?{\i0}
Dialogue: 0,0:04:07.53,0:04:09.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa yang bisa kulakukan?{\i0}
Dialogue: 0,0:04:09.16,0:04:11.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau malah berkeliaran?
Dialogue: 0,0:04:11.54,0:04:15.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Toh kau belum mampu menopang Kuribayashi!
Dialogue: 0,0:04:16.13,0:04:20.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ikuti saja perintahku\Ndan tuntaskan pertandingan ini, Bodoh!
Dialogue: 0,0:04:42.19,0:04:43.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Matsu!
Dialogue: 0,0:04:47.74,0:04:49.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku mengerti gerakan itu.{\i0}
Dialogue: 0,0:04:50.41,0:04:54.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia kehilangan pemain yang dijaganya\Nbegitu matanya terpaku pada bola.{\i0}
Dialogue: 0,0:04:54.29,0:04:55.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial!
Dialogue: 0,0:04:55.83,0:04:58.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Satu gol saja. Satu gol.{\i0}
Dialogue: 0,0:05:00.21,0:05:01.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau!
Dialogue: 0,0:05:06.55,0:05:08.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu! Bagaimana kau melakukan itu?{\i0}
Dialogue: 0,0:05:08.93,0:05:11.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa gravitasi tak berlaku padamu?{\i0}
Dialogue: 0,0:05:15.10,0:05:17.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Oper balik\Nsatu sentuhan, 'kan, Kuribayashi?{\i0}
Dialogue: 0,0:05:17.94,0:05:18.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takkan kubiarkan!
Dialogue: 0,0:05:23.65,0:05:26.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Esperion mengganti pemain\Nuntuk mengulur waktu!
Dialogue: 0,0:05:26.99,0:05:27.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mundur, bertahan!
Dialogue: 0,0:05:27.91,0:05:29.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial…
Dialogue: 0,0:05:32.24,0:05:33.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kami{\i0}
Dialogue: 0,0:05:33.95,0:05:35.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}belum seirama.{\i0}
Dialogue: 0,0:05:37.21,0:05:38.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tadi pun begitu.{\i0}
Dialogue: 0,0:05:38.58,0:05:42.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku berniat lari untuk memancing\Npemain yang menjagaku.{\i0}
Dialogue: 0,0:05:43.00,0:05:47.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kuingin kau bawa bolanya ke depan, Yuma,\Nbukan mengopernya balik.{\i0}
Dialogue: 0,0:05:48.34,0:05:50.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mau bagaimana lagi?{\i0}
Dialogue: 0,0:05:50.93,0:05:51.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bagaimana lagi…{\i0}
Dialogue: 0,0:05:52.56,0:05:53.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuribayashi.
Dialogue: 0,0:05:56.23,0:05:57.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf,
Dialogue: 0,0:05:58.02,0:06:00.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa mungkin kau sedang menahan diri?
Dialogue: 0,0:06:04.65,0:06:06.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku mengatakannya tanpa sadar…{\i0}
Dialogue: 0,0:06:07.86,0:06:12.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun, dia memang terlihat\Nagak menahan diri.{\i0}
Dialogue: 0,0:06:15.08,0:06:17.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Seandainya aku Kuribayashi,{\i0}
Dialogue: 0,0:06:18.71,0:06:19.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}di mana aku…{\i0}
Dialogue: 0,0:06:24.55,0:06:26.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}ingin rekanku berada?{\i0}
Dialogue: 0,0:06:33.35,0:06:36.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, kita dapat tendangan bebas!\NUmpan ke tengah!
Dialogue: 0,0:06:36.60,0:06:38.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maju!
Dialogue: 0,0:06:38.14,0:06:38.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini peluang kita!
Dialogue: 0,0:06:39.06,0:06:40.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo!
Dialogue: 0,0:06:43.61,0:06:46.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Hanya ada waktu\Nuntuk satu serangan terakhir.{\i0}
Dialogue: 0,0:06:46.48,0:06:48.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Satu gol saja.{\i0}
Dialogue: 0,0:06:48.65,0:06:49.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Cetak satu gol saja!{\i0}
Dialogue: 0,0:06:49.99,0:06:50.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oper ke depan!
Dialogue: 0,0:06:52.91,0:06:54.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Di sana juga.{\i0}
Dialogue: 0,0:06:55.33,0:06:56.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ada celah.{\i0}
Dialogue: 0,0:06:57.91,0:06:59.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pemain nomor 3 mereka ada di sana.{\i0}
Dialogue: 0,0:07:01.17,0:07:04.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa cuma aku yang resah\Nmelihat dia dibiarkan bebas?{\i0}
Dialogue: 0,0:07:06.09,0:07:07.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Belum lagi…{\i0}
Dialogue: 0,0:07:08.84,0:07:09.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ya sudahlah.{\i0}
Dialogue: 0,0:07:10.38,0:07:14.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku berniat mencetak gol lagi,\Ntapi aku lebih benci kalau kebobolan.{\i0}
Dialogue: 0,0:07:15.39,0:07:16.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku bertahan saja.{\i0}
Dialogue: 0,0:07:28.90,0:07:30.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, bola kembali ke kita!
Dialogue: 0,0:07:30.53,0:07:32.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Buang bolanya!\N- Ke arah gawang!
Dialogue: 0,0:07:37.37,0:07:39.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Arahkan kaki tumpu ke target,{\i0}
Dialogue: 0,0:07:40.04,0:07:42.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}hantam tengah bola,{\i0}
Dialogue: 0,0:07:43.25,0:07:44.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}lalu tendang!{\i0}
Dialogue: 0,0:07:47.92,0:07:49.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Cukup satu pemain masuk ke ruang itu{\i0}
Dialogue: 0,0:07:50.55,0:07:52.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}untuk melancarkan serangan balik!{\i0}
Dialogue: 0,0:07:59.27,0:08:00.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial!
Dialogue: 0,0:08:01.10,0:08:03.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuribayashi menyerang balik sendirian…
Dialogue: 0,0:08:03.48,0:08:05.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo!
Dialogue: 0,0:08:05.48,0:08:06.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan dia!
Dialogue: 0,0:08:06.81,0:08:07.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan dia!
Dialogue: 0,0:08:12.11,0:08:13.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya satu bek!
Dialogue: 0,0:08:15.11,0:08:17.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jangan panik. Berpikirlah dengan tenang.{\i0}
Dialogue: 0,0:08:18.16,0:08:21.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Hal terburuk adalah gegabah menerjang,\Nlalu membiarkannya lewat.{\i0}
Dialogue: 0,0:08:25.83,0:08:28.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bagus! Kau berhasil menahannya, Kawajiri!{\i0}
Dialogue: 0,0:08:29.34,0:08:32.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tahan posisimu\Ndan tunggu rekan setimmu kembali!{\i0}
Dialogue: 0,0:08:34.34,0:08:36.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bukannya ada satu pemain lagi?{\i0}
Dialogue: 0,0:08:37.39,0:08:39.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Seseorang yang bergerak\Nseperti bayanganku.{\i0}
Dialogue: 0,0:08:41.85,0:08:44.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mungkin aku terlalu berharap.{\i0}
Dialogue: 0,0:08:46.02,0:08:49.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuri!
Dialogue: 0,0:09:13.17,0:09:15.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu serangan balik cepat, dan gol ketiga!
Dialogue: 0,0:09:15.84,0:09:16.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Dan sekarang…
Dialogue: 0,0:09:19.14,0:09:21.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Peluit akhir berbunyi! Tiga-nol!
Dialogue: 0,0:09:22.06,0:09:24.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Esperion menggilas mereka!
Dialogue: 0,0:09:30.48,0:09:31.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ya.{\i0}
Dialogue: 0,0:09:34.53,0:09:35.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aoi!
Dialogue: 0,0:09:35.90,0:09:39.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus!\NUmpan lambung yang luar biasa!
Dialogue: 0,0:09:40.41,0:09:44.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mendengar betapa kerasnya\Nkau berlatih di Tim B.
Dialogue: 0,0:09:44.91,0:09:47.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuhan pasti berpihak padamu.
Dialogue: 0,0:09:47.62,0:09:50.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekalipun kebetulan,\Nposisimu tadi sangat bagus.
Dialogue: 0,0:09:50.17,0:09:52.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shimura, larimu tadi hebat!
Dialogue: 0,0:09:56.47,0:09:57.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:09:57.97,0:09:59.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tak terlihat senang.
Dialogue: 0,0:09:59.84,0:10:01.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan…
Dialogue: 0,0:10:01.18,0:10:04.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku bisa bayangkan serangan dalam sekejap,\Nmurni lewat insting.{\i0}
Dialogue: 0,0:10:05.06,0:10:06.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tadi pun sama.{\i0}
Dialogue: 0,0:10:06.52,0:10:08.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jaga nomor 10 sekarang, Bodoh!
Dialogue: 0,0:10:08.77,0:10:10.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang! Serang!
Dialogue: 0,0:10:10.19,0:10:12.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paksa ke tengah!
Dialogue: 0,0:10:12.19,0:10:14.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tak seperti saat bertahan…{\i0}
Dialogue: 0,0:10:18.03,0:10:18.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Resapi baik-baik,{\i0}
Dialogue: 0,0:10:19.61,0:10:20.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ashito.{\i0}
Dialogue: 0,0:10:21.66,0:10:23.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sama seperti saat menyerang,{\i0}
Dialogue: 0,0:10:23.62,0:10:26.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}bertahan pun harus mengandalkan insting.{\i0}
Dialogue: 0,0:10:28.21,0:10:29.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:10:30.37,0:10:32.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus!
Dialogue: 0,0:10:42.97,0:10:45.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pertandingan Liga Premier pertamaku{\i0}
Dialogue: 0,0:10:46.64,0:10:47.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}telah selesai.{\i0}
Dialogue: 0,0:10:53.52,0:10:56.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, mereka menang. Itu bagus, 'kan?
Dialogue: 0,0:10:58.40,0:11:01.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau bersembunyi sambil menonton?
Dialogue: 0,0:11:25.39,0:11:26.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang kami bisa melawanmu.
Dialogue: 0,0:11:27.97,0:11:31.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak ini masih kelas satu.\NDia belum pernah melihatmu bermain.
Dialogue: 0,0:11:32.31,0:11:34.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senang bisa melihatmu main dari dekat.
Dialogue: 0,0:11:34.98,0:11:38.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang kami bisa jadi makin kuat.
Dialogue: 0,0:11:42.32,0:11:45.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan berhenti berpikir\Nsaat berada di lapangan.
Dialogue: 0,0:11:46.99,0:11:50.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kashiwa tak pernah menyerah untuk menang,\Nhingga akhir.
Dialogue: 0,0:11:52.54,0:11:53.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang.
Dialogue: 0,0:11:59.88,0:12:02.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih telah menyemangati kami!
Dialogue: 0,0:12:05.39,0:12:07.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kebanyakan tim yang kita lawan
Dialogue: 0,0:12:07.89,0:12:11.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}patah arang begitu Kuribayashi\Nturun ke lapangan.
Dialogue: 0,0:12:11.35,0:12:13.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau malah bermain serampangan.
Dialogue: 0,0:12:13.39,0:12:15.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biasanya seperti itu.
Dialogue: 0,0:12:15.90,0:12:16.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi,
Dialogue: 0,0:12:17.48,0:12:19.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tim seperti Kashiwa hari ini
Dialogue: 0,0:12:19.57,0:12:22.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang berani main terbuka\Ndengan cara yang semestinya
Dialogue: 0,0:12:22.90,0:12:25.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pasti menyegarkan bagi Kuribayashi.
Dialogue: 0,0:12:25.82,0:12:29.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagi tim SMA, Inter-High dan\NKejuaraan Nasional adalah hal terpenting.
Dialogue: 0,0:12:30.24,0:12:33.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak tim menganggap liga\Nsebatas persiapan turnamen,
Dialogue: 0,0:12:34.67,0:12:37.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi mereka tak menunjukkan\Nsikap seperti itu.
Dialogue: 0,0:12:38.71,0:12:42.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Mereka berjuang mati-matian\Nsampai detik terakhir.
Dialogue: 0,0:12:53.98,0:12:55.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku tak bisa terus begini.{\i0}
Dialogue: 0,0:12:56.23,0:12:57.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku masih tertinggal jauh.{\i0}
Dialogue: 0,0:12:58.31,0:13:01.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Hari ini, sepuluh pemain\NEsperion lainnya luar biasa.{\i0}
Dialogue: 0,0:13:02.53,0:13:04.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mereka terus membantuku,\Ntitik terlemah tim.{\i0}
Dialogue: 0,0:13:05.74,0:13:06.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku menyedihkan.{\i0}
Dialogue: 0,0:13:07.66,0:13:10.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku tak pantas\Nmerayakannya bersama mereka.{\i0}
Dialogue: 0,0:13:11.79,0:13:12.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pertahananku.{\i0}
Dialogue: 0,0:13:13.45,0:13:14.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jika tak mengasah pertahananku,{\i0}
Dialogue: 0,0:13:15.87,0:13:17.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}aku tak akan berhasil.{\i0}
Dialogue: 0,0:13:18.67,0:13:22.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kalau bisa bermain\Ndi level ini lagi di Liga Premier,{\i0}
Dialogue: 0,0:13:22.42,0:13:24.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}lain kali pasti akan kutemukan.{\i0}
Dialogue: 0,0:13:24.88,0:13:27.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kunci menguasai pertahanan!{\i0}
Dialogue: 0,0:13:28.18,0:13:29.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aoi.
Dialogue: 0,0:13:31.01,0:13:32.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelatih Fukuda ingin menemuimu.
Dialogue: 0,0:13:34.10,0:13:35.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:13:36.85,0:13:37.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aoi.
Dialogue: 0,0:13:39.27,0:13:41.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini hanya awal bagimu.
Dialogue: 0,0:13:43.98,0:13:45.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika tak paham sesuatu, tanyalah.
Dialogue: 0,0:13:47.78,0:13:50.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, Ashito!
Dialogue: 0,0:13:50.49,0:13:53.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awalnya aku mencemaskanmu,
Dialogue: 0,0:13:53.16,0:13:56.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kita tak kebobolan, dan kau mengawali\Nserangan untuk gol terakhir!
Dialogue: 0,0:13:56.91,0:14:00.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu debut yang lumayan bagus!
Dialogue: 0,0:14:00.17,0:14:04.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pasti masuk daftar cadangan lagi.\NKau punya sesuatu yang istimewa.
Dialogue: 0,0:14:09.30,0:14:11.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa wajahmu begitu?
Dialogue: 0,0:14:14.22,0:14:18.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau lebih picik dari yang kukira, Togashi.
Dialogue: 0,0:14:21.65,0:14:23.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya kau belum bisa menerima
Dialogue: 0,0:14:24.53,0:14:27.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bahwa Aoi mendahuluimu.
Dialogue: 0,0:14:27.95,0:14:30.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kenapa tiba-tiba bersikap begitu?
Dialogue: 0,0:14:30.95,0:14:33.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Menurutku dia tidak mendahuluiku.
Dialogue: 0,0:14:36.62,0:14:41.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pernah coba belajar sesuatu dari Aoi?
Dialogue: 0,0:14:44.59,0:14:46.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak paham maksudmu.
Dialogue: 0,0:14:47.42,0:14:50.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang harus kupelajari darinya?
Dialogue: 0,0:14:50.22,0:14:52.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jawaban itu sudah menjelaskan semuanya.
Dialogue: 0,0:14:53.18,0:14:54.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mungkin meremehkan Aoi
Dialogue: 0,0:14:55.56,0:14:57.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tanpa menyadarinya.
Dialogue: 0,0:15:07.44,0:15:08.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putri,
Dialogue: 0,0:15:09.90,0:15:12.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau mau melatih tim pria,
Dialogue: 0,0:15:13.07,0:15:16.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jangan sampai kakimu gemetar\Nhanya karena bicara seringan itu.
Dialogue: 0,0:15:18.91,0:15:20.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Jangan ikut campur.
Dialogue: 0,0:15:26.05,0:15:27.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Anri!
Dialogue: 0,0:15:28.38,0:15:29.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anri, kau tak apa-apa?
Dialogue: 0,0:15:30.88,0:15:32.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perlu kubereskan dia?
Dialogue: 0,0:15:41.10,0:15:44.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau ini kenapa?
Dialogue: 0,0:15:46.32,0:15:51.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sembunyi di pojok tribun,\Npadahal kau adik Pelatih Fukuda?
Dialogue: 0,0:15:52.49,0:15:55.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak bisakah kau minta\Nkursi yang lebih baik?
Dialogue: 0,0:15:56.28,0:16:00.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak tahu banyak soal sepak bola.\NAku tak mau mengganggu.
Dialogue: 0,0:16:00.83,0:16:02.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengganggu bagaimana?
Dialogue: 0,0:16:02.71,0:16:04.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada pemain yang sedang kau hindari?
Dialogue: 0,0:16:23.39,0:16:24.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ashito.
Dialogue: 0,0:16:27.52,0:16:28.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelatih Fukuda.
Dialogue: 0,0:16:35.61,0:16:38.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau ingin bicara, Om… Pelatih Fukuda?
Dialogue: 0,0:16:38.91,0:16:40.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal permainanku hari ini, ya?
Dialogue: 0,0:16:41.33,0:16:42.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, dengarkan aku dulu.
Dialogue: 0,0:16:43.62,0:16:45.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku… mulai mengerti.
Dialogue: 0,0:16:46.92,0:16:47.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Laga berikutnya…
Dialogue: 0,0:16:47.84,0:16:49.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Langsung saja, ya.
Dialogue: 0,0:16:49.67,0:16:51.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari performamu, kau tak bisa kumainkan.
Dialogue: 0,0:16:53.97,0:16:55.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cadangan pun tidak.
Dialogue: 0,0:16:57.09,0:16:59.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedikit banyak, kau pasti menyadarinya.
Dialogue: 0,0:16:59.85,0:17:03.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan caramu bertahan tadi,\Nkau tak berhak protes, Aoi.
Dialogue: 0,0:17:07.86,0:17:09.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan caraku bertahan…
Dialogue: 0,0:17:10.48,0:17:12.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak bisa menyalahkanmu mengatakan itu…
Dialogue: 0,0:17:13.90,0:17:15.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti.
Dialogue: 0,0:17:17.20,0:17:18.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun,
Dialogue: 0,0:17:18.82,0:17:19.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tak bisa main?
Dialogue: 0,0:17:20.33,0:17:21.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di Liga Premier?
Dialogue: 0,0:17:22.41,0:17:24.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sensasi mendebarkan itu…{\i0}
Dialogue: 0,0:17:25.16,0:17:26.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tekanan itu…{\i0}
Dialogue: 0,0:17:26.58,0:17:29.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Setelah merasakannya,\Naku tak bisa mundur lagi.{\i0}
Dialogue: 0,0:17:30.38,0:17:32.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolonglah. Aku mohon padamu, Om!
Dialogue: 0,0:17:33.17,0:17:34.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu laga lagi saja.
Dialogue: 0,0:17:35.47,0:17:37.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa aku mulai paham.
Dialogue: 0,0:17:37.84,0:17:38.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku serius!
Dialogue: 0,0:17:38.93,0:17:40.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Manfaatkan aku!
Dialogue: 0,0:17:41.22,0:17:42.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}- Setidaknya cadangan…\N- Tidak.
Dialogue: 0,0:17:44.64,0:17:46.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Amati Tim A dari pinggir dulu.
Dialogue: 0,0:17:48.44,0:17:50.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada hal lain, Aoi.
Dialogue: 0,0:17:51.32,0:17:54.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kobayakawa, anak kelas tiga,\Nkembali dari cedera besok.
Dialogue: 0,0:17:55.11,0:17:57.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemain bertahan yang bisa jadi gelandang.
Dialogue: 0,0:17:57.74,0:18:00.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bermain sebagai bek kiri\Nsejak awal musim semi.
Dialogue: 0,0:18:01.78,0:18:08.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuribayashi dan Kobayakawa kembali,\NEsperion akan berkekuatan penuh.
Dialogue: 0,0:18:08.46,0:18:13.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tonton latihan skuad terbaik kita besok.\NBaru kau boleh cemas setelahnya.
Dialogue: 0,0:18:14.09,0:18:16.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus untuk hari ini. Istirahatlah.
Dialogue: 0,0:18:27.23,0:18:28.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tak mau bicara dengannya?
Dialogue: 0,0:18:30.23,0:18:31.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk apa?
Dialogue: 0,0:18:31.61,0:18:33.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aoi tampak kesulitan.
Dialogue: 0,0:18:36.07,0:18:40.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat dia melawan tim kami pun,\Nkau sangat paham cara bermain Aoi.
Dialogue: 0,0:18:41.41,0:18:43.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu saat dia mau masuk lapangan…
Dialogue: 0,0:18:50.29,0:18:51.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau menyemangatinya sekuat tenaga.
Dialogue: 0,0:18:52.96,0:18:54.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudmu?
Dialogue: 0,0:18:54.67,0:18:58.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menyemangati semua orang\Ndi tim kakakku.
Dialogue: 0,0:18:59.55,0:19:03.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai sesama pemain,\Naku tahu dia pasti sangat ingin bermain
Dialogue: 0,0:19:03.64,0:19:05.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sampai memohon seperti itu.
Dialogue: 0,0:19:05.93,0:19:08.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pasti yakin sudah mulai memahaminya.
Dialogue: 0,0:19:09.14,0:19:10.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, pelatihlah yang memutuskan.
Dialogue: 0,0:19:11.85,0:19:15.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak ada hal lain yang membuatmu\Nmerasa lebih tak berdaya.
Dialogue: 0,0:19:16.23,0:19:18.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya katakan sesuatu kepadanya.
Dialogue: 0,0:19:19.90,0:19:21.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kau juga pemain,
Dialogue: 0,0:19:21.16,0:19:23.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau paham perasaan sesama pemain.
Dialogue: 0,0:19:26.12,0:19:27.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senangnya.
Dialogue: 0,0:19:30.12,0:19:33.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang bisa kukatakan hanya,\N"Lakukanlah yang terbaik."
Dialogue: 0,0:19:34.67,0:19:37.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak tahu apa yang menahanmu,
Dialogue: 0,0:19:37.88,0:19:41.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tetapi kata-kata yang tulus\Nselalu bisa menguatkan seorang pemain.
Dialogue: 0,0:19:42.84,0:19:43.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selalu.
Dialogue: 0,0:19:45.26,0:19:48.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sorakanmu berpengaruh.\NItu memberiku kekuatan.{\i0}
Dialogue: 0,0:19:51.98,0:19:54.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Ashito! Ini aku!
Dialogue: 0,0:19:54.23,0:19:57.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, Ashito! Ayo! Kau pasti bisa!
Dialogue: 0,0:19:57.73,0:20:01.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kau menciumku!
Dialogue: 0,0:20:02.99,0:20:06.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak! Aku tak bisa melakukannya!
Dialogue: 0,0:20:11.41,0:20:12.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aoi.
Dialogue: 0,0:20:15.75,0:20:18.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua sudah ganti baju di ruang ganti.
Dialogue: 0,0:20:18.88,0:20:19.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kaido…
Dialogue: 0,0:20:20.55,0:20:21.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei…
Dialogue: 0,0:20:23.01,0:20:24.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tampak pucat. Kau tak apa?
Dialogue: 0,0:20:27.26,0:20:29.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya merasa sedikit…
Dialogue: 0,0:20:29.89,0:20:31.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau pulang sekarang.
Dialogue: 0,0:20:32.60,0:20:33.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu.
Dialogue: 0,0:20:33.98,0:20:36.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tampak lelah, Aoi.
Dialogue: 0,0:20:36.98,0:20:38.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin memberimu ini.
Dialogue: 0,0:20:39.15,0:20:41.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentang pergerakanmu di laga hari ini.
Dialogue: 0,0:20:41.74,0:20:43.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kucatat apa yang kuamati tadi.
Dialogue: 0,0:20:44.57,0:20:46.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kebanyakan soal pertahananmu.
Dialogue: 0,0:20:47.37,0:20:52.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertahanan itu soal formasi,\Njadi kerja sama untuk membentuknya…
Dialogue: 0,0:20:53.96,0:20:54.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau serius?
Dialogue: 0,0:20:55.42,0:20:57.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu akan sangat membantu!
Dialogue: 0,0:20:58.04,0:21:01.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saranmu saat aku buntu dulu\Njuga sangat membantu.
Dialogue: 0,0:21:02.26,0:21:03.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal menoleh itu.
Dialogue: 0,0:21:04.84,0:21:06.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Oh, ya!
Dialogue: 0,0:21:08.14,0:21:09.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kalau dipikir-pikir, Kaido,
Dialogue: 0,0:21:09.93,0:21:12.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau selalu menonton pertandingan kami.
Dialogue: 0,0:21:15.60,0:21:18.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang kau malah memberiku saran.\NTerima kasih banyak.
Dialogue: 0,0:21:20.77,0:21:21.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja!
Dialogue: 0,0:21:27.99,0:21:31.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa kau bisa jadi\Npemain profesional, Aoi.
Dialogue: 0,0:21:31.16,0:21:32.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau selalu bekerja keras!
Dialogue: 0,0:21:33.12,0:21:35.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu betul itu!
Dialogue: 0,0:21:37.50,0:21:38.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:21:42.34,0:21:45.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Anri, tunggu!
Dialogue: 0,0:22:03.44,0:22:04.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga.
Dialogue: 0,0:22:05.86,0:22:08.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial, aku ingin menemuinya.
Dialogue: 0,0:23:42.96,0:23:44.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si Aoi itu…
Dialogue: 0,0:23:44.96,0:23:49.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak banyak pemain zaman sekarang\Nyang punya nyali bilang, "Manfaatkan aku."
Dialogue: 0,0:23:50.34,0:23:51.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku suka hal itu darinya.
Dialogue: 0,0:23:53.18,0:23:56.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kau bahkan mengajaknya bicara langsung.{\i0}
Dialogue: 0,0:23:56.47,0:23:59.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kau jelas menaruh harapan tinggi pada Aoi.{\i0}
Dialogue: 0,0:24:01.10,0:24:05.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, mulai besok, kita akan pasang\Nskuad terkuat, tanpa titik lemah.
Dialogue: 0,0:24:05.69,0:24:08.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu makin menyulitkan\Npara pemain cadangan.
Dialogue: 0,0:24:09.48,0:24:14.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tak akan ada banyak peluang\Nbagi mereka sekarang.{\i0}
Dialogue: 0,0:24:15.99,0:24:20.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}- Apa yang membuat tim benar-benar kuat?\N- Aku malu pada diriku sendiri.{\i0}
Dialogue: 0,0:24:20.45,0:24:22.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}- Yang tersisih malah bertengkar.\N- Ya…{\i0}
Dialogue: 0,0:24:22.79,0:24:24.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Takeshima, tangani ini.{\i0}
Dialogue: 0,0:24:24.21,0:24:26.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}- Ashito, ajari aku soal sepak bola.\N- Tak apa-apa!{\i0}
Dialogue: 0,0:24:26.96,0:24:29.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Pertahanan macam apa sebenarnya itu?{\i0}
Dialogue: 0,0:24:30.13,0:24:30.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Terjemahan subtitle oleh Latifa F
