Dialogue: 0,0:00:12.42,0:00:14.43,sign,,0000,0000,0000,,‎TANTANGAN
Dialogue: 0,0:00:40.37,0:00:41.95,sign,,0000,0000,0000,,‎CEWEK JELEK
Dialogue: 0,0:00:44.00,0:00:47.96,sign,,0000,0000,0000,,‎RANMA1/2
Dialogue: 0,0:02:12.88,0:02:17.09,sign,,0000,0000,0000,,{\an8}‎SERANG! TSUBASA KURENAI
Dialogue: 0,0:02:58.67,0:03:00.17,sign,,0000,0000,0000,,{\an8}‎POS
Dialogue: 0,0:04:31.85,0:04:33.14,sign,,0000,0000,0000,,‎SURAT TANTANGAN
Dialogue: 0,0:05:34.91,0:05:36.16,sign,,0000,0000,0000,,‎INI TUNANGANKU YANG MANIS
Dialogue: 0,0:07:06.59,0:07:07.67,sign,,0000,0000,0000,,‎MASALAH SELESAI
Dialogue: 0,0:07:30.99,0:07:32.07,sign,,0000,0000,0000,,‎MASALAH BELUM SELESAI
Dialogue: 0,0:08:33.05,0:08:34.13,sign,,0000,0000,0000,,‎KEDAI SEMENTARA OKONOMIYAKI UCCHAN
Dialogue: 0,0:08:56.61,0:08:57.70,sign,,0000,0000,0000,,‎KEDAI SEMENTARA UCCHAN\N‎TSUBASA - RANMA
Dialogue: 0,0:11:43.20,0:11:45.49,sign,,0000,0000,0000,,{\an8}‎TERJUAL HABIS
Dialogue: 0,0:12:05.34,0:12:06.93,sign,,0000,0000,0000,,‎RANMA
Dialogue: 0,0:13:25.84,0:13:28.76,sign,,0000,0000,0000,,{\an8}‎TAMAN
Dialogue: 0,0:19:25.03,0:19:27.33,sign,,0000,0000,0000,,‎PERGURUAN TENDO
Dialogue: 0,0:00:18.22,0:00:21.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Ranma dari Aliran Silat\N‎Segala Jurus Saotome.{\i0}
Dialogue: 0,0:00:21.68,0:00:23.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dan Akane dari Perguruan Tendo.{\i0}
Dialogue: 0,0:00:24.56,0:00:27.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kini mereka bertunangan\N‎atas keputusan orang tua mereka.{\i0}
Dialogue: 0,0:00:27.69,0:00:29.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Jangan jodohkan aku.{\i0}
Dialogue: 0,0:00:29.65,0:00:31.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Ini menyebalkan.{\i0}
Dialogue: 0,0:00:31.15,0:00:34.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dan Ranma punya sebuah masalah.{\i0}
Dialogue: 0,0:00:35.36,0:00:36.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Apa yang kau lakukan?{\i0}
Dialogue: 0,0:00:37.12,0:00:40.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dia berubah menjadi perempuan\N‎saat terkena air.{\i0}
Dialogue: 0,0:02:21.01,0:02:24.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎"Aku akan segera datang mencabut nyawamu."
Dialogue: 0,0:02:24.60,0:02:26.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tsubasa Kurenai?
Dialogue: 0,0:02:27.06,0:02:28.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dapat surat tantangan lagi?
Dialogue: 0,0:02:32.52,0:02:35.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa aku kenal\N‎orang bernama Tsubasa Kurenai?
Dialogue: 0,0:02:35.69,0:02:38.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau lakukan apa? Mencuri?\N‎Makan tak bayar? Penipuan pernikahan?
Dialogue: 0,0:02:38.49,0:02:39.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei.
Dialogue: 0,0:02:39.57,0:02:42.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bersiaplah, Ranma Saotome!
Dialogue: 0,0:02:54.79,0:02:57.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Kotak...\N‎- Pos?
Dialogue: 0,0:03:02.76,0:03:05.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Serang!
Dialogue: 0,0:03:09.98,0:03:12.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Apa-apaan ini?\N‎- Ranma.
Dialogue: 0,0:03:12.31,0:03:14.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa yang kau lakukan pada kotak pos itu?
Dialogue: 0,0:03:14.77,0:03:17.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tidak merasa punya musuh\N‎dengan benda itu!
Dialogue: 0,0:03:17.90,0:03:20.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Serang!
Dialogue: 0,0:03:50.93,0:03:52.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Seorang perempuan?
Dialogue: 0,0:03:53.65,0:03:55.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ranma...
Dialogue: 0,0:03:59.57,0:04:02.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ser... ang...
Dialogue: 0,0:04:07.58,0:04:08.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Siapa dia?
Dialogue: 0,0:04:12.41,0:04:17.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Entah.\N‎- Bukan tunanganmu yang lain lagi, 'kan?
Dialogue: 0,0:04:17.42,0:04:19.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sedang apa kau di tengah jalan begini?
Dialogue: 0,0:04:19.92,0:04:21.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ukyo.
Dialogue: 0,0:04:23.51,0:04:25.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ukyo... ku...
Dialogue: 0,0:04:27.30,0:04:29.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tsubasa... Kurenai...
Dialogue: 0,0:04:33.14,0:04:35.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Orang yang mengirim surat tantangan itu.{\i0}
Dialogue: 0,0:04:35.23,0:04:37.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa dia kenalanmu?
Dialogue: 0,0:04:37.31,0:04:40.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Buang saja dia. Masukkan ke tempat sampah.\N‎Selamat tinggal!
Dialogue: 0,0:04:43.44,0:04:46.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sialan. Aku tak menyangka\N‎Tsubasa mengejarku sampai ke sini.
Dialogue: 0,0:04:46.82,0:04:48.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jadi, siapa orang tadi?
Dialogue: 0,0:04:50.24,0:04:53.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tsubasa adalah teman sekelas\N‎di sekolah lamaku.
Dialogue: 0,0:04:53.66,0:04:54.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Lalu kenapa orang itu...
Dialogue: 0,0:04:54.83,0:04:57.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mencari masalah denganku?
Dialogue: 0,0:04:57.00,0:04:59.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ingat, aku pura-pura jadi lelaki\N‎sampai pindah ke sini.
Dialogue: 0,0:05:00.30,0:05:01.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Jadi...{\i0}
Dialogue: 0,0:05:01.67,0:05:02.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ukyo-ku.
Dialogue: 0,0:05:03.67,0:05:04.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku mencintaimu.
Dialogue: 0,0:05:04.76,0:05:08.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tsubasa. Berat bagiku\N‎untuk mengatakan ini, tapi...
Dialogue: 0,0:05:08.68,0:05:12.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎aku sudah punya tunangan.
Dialogue: 0,0:05:12.85,0:05:16.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku sudah punya tunangan.{\i0}
Dialogue: 0,0:05:16.35,0:05:19.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tunangan...{\i0}
Dialogue: 0,0:05:22.61,0:05:25.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Namun, Tsubasa tak pernah menyerah\N‎mengejar cintanya.
Dialogue: 0,0:05:25.49,0:05:27.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bahkan setelah Ukyo-ku pindah sekolah,
Dialogue: 0,0:05:28.45,0:05:31.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎aku terus-menerus\N‎menulis surat cinta untuk Ukyo-ku.
Dialogue: 0,0:05:31.95,0:05:34.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau gigih sekali.
Dialogue: 0,0:05:36.16,0:05:38.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jadi, aku mengirimkan\N‎surat putus dengan foto Ranma.
Dialogue: 0,0:05:38.92,0:05:41.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hu, hu, hu...
Dialogue: 0,0:05:41.92,0:05:44.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Foto Ranma yang mana yang kau pakai?
Dialogue: 0,0:05:44.17,0:05:47.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Tentu saja yang wujud perempuan.\N‎- Kenapa?
Dialogue: 0,0:05:47.01,0:05:51.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tsubasa kira aku lelaki. Akan bingung\N‎jika aku bertunangan dengan lelaki.
Dialogue: 0,0:05:57.60,0:05:59.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa?
Dialogue: 0,0:05:59.35,0:06:00.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Cewek jelek.
Dialogue: 0,0:06:00.44,0:06:03.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Cewek... Jelek...{\i0}
Dialogue: 0,0:06:03.94,0:06:05.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei, Ranma?
Dialogue: 0,0:06:06.65,0:06:08.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa perasaanmu terluka?
Dialogue: 0,0:06:09.16,0:06:11.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ukyo-ku!
Dialogue: 0,0:06:13.16,0:06:16.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dan siapa yang kalah dari cewek jelek ini?
Dialogue: 0,0:06:18.33,0:06:20.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Begitulah kenyataannya.
Dialogue: 0,0:06:20.21,0:06:22.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jadi, menyerahlah dan pulang saja.
Dialogue: 0,0:06:22.21,0:06:23.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Lihat saja nanti!
Dialogue: 0,0:06:26.46,0:06:27.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa kau tak berlebihan?
Dialogue: 0,0:06:27.92,0:06:30.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sebegitu saja tak apa-apa.\N‎Bisa jadi peringatan yang bagus.
Dialogue: 0,0:06:31.59,0:06:34.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Serang!
Dialogue: 0,0:06:42.90,0:06:44.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sial. Aku gagal.
Dialogue: 0,0:06:44.65,0:06:48.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tsu... ba... sa...
Dialogue: 0,0:06:48.36,0:06:51.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Akan kupanggang kau!
Dialogue: 0,0:06:51.82,0:06:55.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tunggu dulu. Tsubasa, lihat ini.
Dialogue: 0,0:06:56.99,0:06:58.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa yang kau lakukan?
Dialogue: 0,0:06:59.12,0:07:02.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau paham? Ukyo adalah perempuan.
Dialogue: 0,0:07:02.46,0:07:04.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Perempuan.
Dialogue: 0,0:07:07.67,0:07:10.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bukankah seharusnya\N‎kau melakukan itu sejak awal?
Dialogue: 0,0:07:10.01,0:07:11.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau benar.
Dialogue: 0,0:07:12.09,0:07:14.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Fakta bahwa Ukyo-ku seorang perempuan
Dialogue: 0,0:07:14.60,0:07:16.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎sudah kuketahui sejak dulu.
Dialogue: 0,0:07:17.97,0:07:22.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Paham? Aku cuma tertarik pada wanita.
Dialogue: 0,0:07:23.52,0:07:26.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku pasti akan merebut Ukyo-ku darimu.
Dialogue: 0,0:07:29.78,0:07:30.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Cewek jelek.
Dialogue: 0,0:07:32.07,0:07:34.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tsubasa suka perempuan?
Dialogue: 0,0:07:34.78,0:07:36.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hebat sekali.
Dialogue: 0,0:07:36.49,0:07:40.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Berani-beraninya kau...
Dialogue: 0,0:07:42.58,0:07:44.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Selamat pagi.\N‎- Selamat pagi.
Dialogue: 0,0:07:45.38,0:07:48.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Serang!
Dialogue: 0,0:07:50.09,0:07:52.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jahat sekali, Ukyo-ku.
Dialogue: 0,0:07:54.09,0:07:55.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Manis sekali!
Dialogue: 0,0:07:55.80,0:07:59.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sudah kubilang\N‎berhenti mengikutiku, Tsubasa.
Dialogue: 0,0:08:00.93,0:08:02.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu Tsubasa Kurenai.
Dialogue: 0,0:08:02.27,0:08:06.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa kau tidak paham?\N‎Aku punya tunangan bernama Ranma.
Dialogue: 0,0:08:06.02,0:08:09.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Cewek jelek itu, 'kan?\N‎Mana mungkin dia jadi tunanganmu.
Dialogue: 0,0:08:09.86,0:08:12.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei, Ranma itu lela...
Dialogue: 0,0:08:12.45,0:08:14.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Selamat pagi, Tsubasa.
Dialogue: 0,0:08:14.74,0:08:16.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Nah, si cewek jelek.
Dialogue: 0,0:08:16.49,0:08:18.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mau apa kau, si bodoh biang onar?
Dialogue: 0,0:08:20.91,0:08:23.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mari kita bersaing dengan ini\N‎untuk melihat
Dialogue: 0,0:08:23.71,0:08:25.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎siapa yang lebih cocok untuk Ukyo-ku.
Dialogue: 0,0:08:26.29,0:08:27.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa ini?
Dialogue: 0,0:08:27.54,0:08:29.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa? Kedai sementara...
Dialogue: 0,0:08:29.38,0:08:30.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎okonomiyaki di jam makan?
Dialogue: 0,0:08:30.76,0:08:33.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Kedai sementara?\N‎- Apa ini?
Dialogue: 0,0:08:34.13,0:08:36.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yang laku terbanyak yang menang.\N‎Kau mau ikut, 'kan?
Dialogue: 0,0:08:36.64,0:08:37.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kelihatannya seru.
Dialogue: 0,0:08:38.76,0:08:41.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kenapa kau membuat brosur\N‎tanpa bertanya padaku?
Dialogue: 0,0:08:41.56,0:08:43.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ini akan menghasilkan banyak uang.
Dialogue: 0,0:08:43.23,0:08:45.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku sangat bahagia bisa berguna untukmu.
Dialogue: 0,0:08:46.52,0:08:49.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Asyik! Sudah waktunya makan siang!
Dialogue: 0,0:08:49.98,0:08:52.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Lama tak jumpa, Semuanya.
Dialogue: 0,0:08:52.15,0:08:56.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kami dari Klub Siaran SMA Furinkan.\N‎Semuanya, mari lihat!
Dialogue: 0,0:08:57.70,0:09:01.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Acara mendadak di SMA Furinkan ini\N‎adalah pertarungan demi perut dan hati.
Dialogue: 0,0:09:01.45,0:09:04.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ini persaingan penjualan okonomiyaki\N‎di kedai sementara Ucchan.
Dialogue: 0,0:09:04.58,0:09:08.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ichiro kesayangan kalian dari Klub Siaran\N‎Furinkan akan menjadi komentator kalian.
Dialogue: 0,0:09:08.58,0:09:13.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yang bersaing demi cinta Ukyo Kuonji\N‎adalah dua orang ini.
Dialogue: 0,0:09:13.67,0:09:17.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Biang onar di SMA Furinkan, Ranma Saotome.
Dialogue: 0,0:09:17.59,0:09:19.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan menangis meski kau kalah.
Dialogue: 0,0:09:19.68,0:09:22.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dan monster cinta penyerang\N‎yang penuh gairah dan obsesi,
Dialogue: 0,0:09:22.47,0:09:24.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tsubasa Kurenai!
Dialogue: 0,0:09:24.48,0:09:26.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Siapa yang akan kalah darimu, Cewek Jelek?
Dialogue: 0,0:09:27.60,0:09:29.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Cuma ada satu aturan sederhana.
Dialogue: 0,0:09:29.11,0:09:32.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yang menjual okonomiyaki\N‎paling banyak yang menang.
Dialogue: 0,0:09:32.57,0:09:36.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ujian cinta dan gairah. Jangan menunggu.\N‎Jualan kami cepat ludes.
Dialogue: 0,0:09:36.03,0:09:39.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sekarang inilah sang Master Wajan,\N‎sumber percikan yang menyulut kontes ini.
Dialogue: 0,0:09:39.70,0:09:43.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ukyo Kuonji akan beri aba-aba\N‎dimulainya pertandingan sengit ini.
Dialogue: 0,0:09:43.54,0:09:46.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kedai Sementara Okonomiyaki Ucchan\N‎di SMA Furinkan
Dialogue: 0,0:09:46.46,0:09:47.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎resmi dibuka!
Dialogue: 0,0:09:47.87,0:09:49.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tidak akan pernah kalah darinya.
Dialogue: 0,0:09:49.63,0:09:51.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Serang!
Dialogue: 0,0:09:51.34,0:09:53.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Hasilkan banyak uang, ya?
Dialogue: 0,0:09:53.80,0:09:57.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kudengar gadis bernama Tsubasa itu\N‎cuma tertarik pada wanita.
Dialogue: 0,0:09:57.13,0:09:59.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa itu alasannya dia menyukai Ukyo?
Dialogue: 0,0:09:59.05,0:10:01.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kenapa Ranma jadi begitu serius soal ini?{\i0}
Dialogue: 0,0:10:02.76,0:10:06.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Akan kupakai kecantikanku untuk jual habis\N‎dan membuatnya berhenti memanggilku jelek.{\i0}
Dialogue: 0,0:10:06.81,0:10:08.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jam makan siang\N‎adalah medan tempur mereka.
Dialogue: 0,0:10:08.98,0:10:10.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terpikat oleh aroma sausnya,
Dialogue: 0,0:10:10.73,0:10:14.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎para lelaki berhamburan demi dapatkan\N‎makan siang dan cinta mereka!
Dialogue: 0,0:10:14.07,0:10:16.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Aku mau okonomiyaki.\N‎- Aku juga mau.
Dialogue: 0,0:10:16.44,0:10:17.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Selamat datang!
Dialogue: 0,0:10:17.82,0:10:19.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Belilah dari gadis yang lebih manis, ya?
Dialogue: 0,0:10:19.91,0:10:23.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kobaran cinta! Pertarungan harga diri!
Dialogue: 0,0:10:23.41,0:10:26.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Siapakah yang akan tersenyum di akhir?
Dialogue: 0,0:10:36.30,0:10:39.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kita punya pemenangnya!\N‎Tsubasa Kurenai menang telak!
Dialogue: 0,0:10:39.97,0:10:41.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tak bersisa. Cintanya tak tertandingi.
Dialogue: 0,0:10:41.84,0:10:46.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sebaliknya, Ranma Saotome secara\N‎mengejutkan menjual nol okonomiyaki!
Dialogue: 0,0:10:46.22,0:10:47.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mustahil...
Dialogue: 0,0:10:47.77,0:10:50.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Masalah selesai. Dasar cewek jelek.
Dialogue: 0,0:10:50.44,0:10:52.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sekarang Ukyo-ku sepenuhnya milikku.
Dialogue: 0,0:10:52.77,0:10:54.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Rasakan itu.
Dialogue: 0,0:10:54.52,0:10:57.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tsubasa Kurenai,\N‎tolong biarkan kami mewawancaraimu!
Dialogue: 0,0:10:57.65,0:10:59.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tadi aku amat percaya diri akan menang...
Dialogue: 0,0:11:00.32,0:11:02.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa aku benar-benar jelek?
Dialogue: 0,0:11:02.41,0:11:04.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bicara apa kau ini? Kau sangat manis.
Dialogue: 0,0:11:04.83,0:11:07.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Gadis Berkepang. Kau sangat manis!
Dialogue: 0,0:11:07.33,0:11:08.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Rasakan itu!
Dialogue: 0,0:11:10.71,0:11:14.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Satu-satunya orang yang tak tahu\N‎wujud asli Ranma adalah...
Dialogue: 0,0:11:14.04,0:11:16.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Cuma Tatewaki-senpai, 'kan?
Dialogue: 0,0:11:16.42,0:11:17.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Begitukah?
Dialogue: 0,0:11:17.51,0:11:21.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Benar. Mana mungkin kau menang\N‎melawan gadis sungguhan di sekolah ini.
Dialogue: 0,0:11:23.51,0:11:25.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku akan bersaing secara serius sekarang.
Dialogue: 0,0:11:26.01,0:11:27.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tunggu saja kau!
Dialogue: 0,0:11:32.06,0:11:36.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Okonomiyaki lezat. Siapa cepat dia dapat.
Dialogue: 0,0:11:36.11,0:11:39.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Cantik sekali.\N‎- Gadis kelinci?
Dialogue: 0,0:11:39.03,0:11:40.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Aku beli satu.\N‎- Aku juga.
Dialogue: 0,0:11:41.70,0:11:43.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Terima kasih!
Dialogue: 0,0:11:45.49,0:11:49.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Penyamaranku sempurna.\N‎Tidak ada yang sadar ini aku.{\i0}
Dialogue: 0,0:11:50.41,0:11:52.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Beri aku dua.\N‎- Aku tiga.
Dialogue: 0,0:11:53.29,0:11:55.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Aku beli sepuluh, kencanlah denganku.\N‎- Aku juga!
Dialogue: 0,0:11:55.46,0:11:56.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku senang sekali!
Dialogue: 0,0:11:59.34,0:12:02.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa yang kau lakukan? Punyaku sisa satu\N‎dan akan langsung habis terjual.
Dialogue: 0,0:12:02.72,0:12:04.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ikut saja denganku.
Dialogue: 0,0:12:08.60,0:12:11.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa bagusnya disukai para lelaki?
Dialogue: 0,0:12:11.81,0:12:14.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Diam. Ini pertandingan.
Dialogue: 0,0:12:14.35,0:12:17.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ada yang mau beli okonomiyaki terakhirku?
Dialogue: 0,0:12:17.48,0:12:18.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hentikan itu!
Dialogue: 0,0:12:19.73,0:12:21.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sudah kuduga. Akulah pemenangnya.
Dialogue: 0,0:12:22.61,0:12:25.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dan sekarang Ukyo-ku sungguh jadi milikku...
Dialogue: 0,0:12:25.03,0:12:26.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Berhenti.
Dialogue: 0,0:12:32.91,0:12:35.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Okonomiyaki terakhir itu. Akan kubeli.
Dialogue: 0,0:12:37.33,0:12:39.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Ucchan.\N‎- Ukyo-ku.
Dialogue: 0,0:12:40.88,0:12:42.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sekarang pertandingan ini gugur.
Dialogue: 0,0:12:42.80,0:12:46.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tega sekali. Padahal aku akan menang.
Dialogue: 0,0:12:48.14,0:12:51.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jika kau sebegitu tak mau kencan denganku,
Dialogue: 0,0:12:51.97,0:12:55.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎seharusnya bilang saja dari awal!
Dialogue: 0,0:12:55.19,0:12:57.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku sudah bilang kepadamu dari awal!
Dialogue: 0,0:12:58.61,0:13:01.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku paham. Aku akan mengakhirinya di sini.
Dialogue: 0,0:13:02.28,0:13:05.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku akan sepenuhnya melepaskan\N‎cintaku untuk Ukyo tersayang.
Dialogue: 0,0:13:10.12,0:13:11.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Selamat tinggal!
Dialogue: 0,0:13:12.24,0:13:13.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tsubasa...{\i0}
Dialogue: 0,0:13:16.33,0:13:18.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Ranma?\N‎- Ranma?
Dialogue: 0,0:13:30.80,0:13:31.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tsubasa.
Dialogue: 0,0:13:33.31,0:13:36.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku benci mengakuinya,\N‎tapi kau menang pertandingan itu.
Dialogue: 0,0:13:37.27,0:13:39.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau tidak benar-benar jelek.
Dialogue: 0,0:13:41.32,0:13:44.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau sangat cantik sampai membuatku\N‎ingin menindasmu.
Dialogue: 0,0:13:45.78,0:13:48.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf. Aku jahat sekali.
Dialogue: 0,0:13:49.87,0:13:52.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tentu saja Ukyo-ku membenciku.
Dialogue: 0,0:13:53.33,0:13:55.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kurasa bukan itu masalahnya.{\i0}
Dialogue: 0,0:13:57.21,0:13:59.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bagaimanapun, kau cukup manis.
Dialogue: 0,0:13:59.67,0:14:01.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau akan segera menemukan yang lebih baik.
Dialogue: 0,0:14:04.88,0:14:07.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa yang sedang kau pikirkan sekarang?
Dialogue: 0,0:14:07.09,0:14:09.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Cinta baruku, kurasa aku akan...
Dialogue: 0,0:14:09.59,0:14:11.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Serang!
Dialogue: 0,0:14:11.85,0:14:15.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Tidak, bukan ini!\N‎- Serang, serang, serang!
Dialogue: 0,0:14:15.10,0:14:18.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Cepat sekali Tsubasa bangkit lagi.
Dialogue: 0,0:14:18.02,0:14:20.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa artinya Tsubasa\N‎akan menyukai gadis mana pun?
Dialogue: 0,0:14:20.35,0:14:25.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi Tsubasa akan patah hati\N‎jika kebenaran tentang Ranma terungkap.
Dialogue: 0,0:14:25.36,0:14:28.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sepertinya ini akan menyakitkan\N‎bagaimanapun juga.
Dialogue: 0,0:14:35.66,0:14:37.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa yang terjadi?
Dialogue: 0,0:14:37.12,0:14:41.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kenapa? Kenapa bisa? Apa-apaan ini?
Dialogue: 0,0:14:41.79,0:14:46.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Serang!
Dialogue: 0,0:14:46.13,0:14:49.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Menjauh dariku!
Dialogue: 0,0:15:00.02,0:15:02.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia kabur lagi.
Dialogue: 0,0:15:04.15,0:15:06.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Walaupun aku sangat mencintai Ranma-ku.
Dialogue: 0,0:15:07.86,0:15:11.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa yang tak kau suka dariku?
Dialogue: 0,0:15:11.28,0:15:14.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku yakin ada banyak hal.
Dialogue: 0,0:15:14.91,0:15:16.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tsubasa.
Dialogue: 0,0:15:19.37,0:15:21.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ada apa dengan dia sebenarnya?
Dialogue: 0,0:15:21.42,0:15:24.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tsubasa menjadi sangat obsesif\N‎saat jatuh cinta.
Dialogue: 0,0:15:24.08,0:15:25.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ucchan.
Dialogue: 0,0:15:25.59,0:15:28.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan menahan diri, beri Tsubasa\N‎satu atau dua pukulan keras.
Dialogue: 0,0:15:28.55,0:15:31.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Mana mungkin aku bisa memukul perempuan.{\i0}
Dialogue: 0,0:15:31.93,0:15:33.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku harus pikirkan cara\N‎untuk kabur darinya.{\i0}
Dialogue: 0,0:15:34.80,0:15:38.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei, bukankah lebih baik melupakan\N‎orang yang tidak jelas seperti Ranma
Dialogue: 0,0:15:38.43,0:15:40.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎dan mencari orang lain untuk dicintai?
Dialogue: 0,0:15:40.73,0:15:45.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Padahal ada banyak lelaki\N‎yang bilang kalau kau manis.
Dialogue: 0,0:15:45.36,0:15:47.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak, aku benci laki-laki.
Dialogue: 0,0:15:47.61,0:15:49.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bagaimanapun, kau harus melepaskan Ranma.
Dialogue: 0,0:15:50.32,0:15:53.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kenapa? Yah...
Dialogue: 0,0:15:54.41,0:15:56.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan bilang...
Dialogue: 0,0:15:56.78,0:15:59.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎kau cinta Ranma-ku?
Dialogue: 0,0:15:59.87,0:16:02.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Siapa juga yang sudi?
Dialogue: 0,0:16:02.33,0:16:04.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Begitu, ya? Itu mengejutkanku.
Dialogue: 0,0:16:04.75,0:16:07.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku cuma mengkhawatirkanmu.
Dialogue: 0,0:16:08.17,0:16:09.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa?
Dialogue: 0,0:16:18.26,0:16:20.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Akane, kau baik sekali.
Dialogue: 0,0:16:21.43,0:16:23.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Lepaskan.\N‎- Tidak mau.
Dialogue: 0,0:16:23.52,0:16:24.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ayolah.
Dialogue: 0,0:16:25.60,0:16:26.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Surat di anak panah?
Dialogue: 0,0:16:27.90,0:16:32.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Untuk Tsubasa tersayang. Aku akan menunggu\N‎di taman pada hari Minggu. Dari Ranma.{\i0}
Dialogue: 0,0:16:46.79,0:16:48.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu dari Ranma?
Dialogue: 0,0:16:48.50,0:16:52.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya. Dia mengajak Tsubasa berkencan.
Dialogue: 0,0:16:52.51,0:16:56.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bukankah itu artinya\N‎Ranma menyukai Tsubasa?
Dialogue: 0,0:16:56.43,0:16:57.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak mungkin.
Dialogue: 0,0:16:57.51,0:16:59.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tsubasa.
Dialogue: 0,0:17:00.39,0:17:01.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ranma-ku.
Dialogue: 0,0:17:04.81,0:17:07.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Akulah yang akan jadi\N‎pasangan kencanmu hari ini.
Dialogue: 0,0:17:11.40,0:17:15.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sekarang mari kita meluncur\N‎ke dalam cincin cinta sejati bersama.
Dialogue: 0,0:17:18.91,0:17:21.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apakah Ranma sedang demam?
Dialogue: 0,0:17:21.62,0:17:23.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau siapa?
Dialogue: 0,0:17:23.83,0:17:27.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Rekan berlatih untuk cintamu.\N‎Pendatang baru pengganti gadis itu.
Dialogue: 0,0:17:28.21,0:17:30.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Keharmonisan kita\N‎akan merangkai melodi cinta.
Dialogue: 0,0:17:30.67,0:17:32.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sekarang, mari bunyikan gong jiwamu...
Dialogue: 0,0:17:32.63,0:17:35.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Gong...\N‎- Dari mana kau dapat kalimat aneh itu?
Dialogue: 0,0:17:35.63,0:17:37.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa-apaan, Akane?
Dialogue: 0,0:17:37.43,0:17:39.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bukankah ini kencan antarperempuan?
Dialogue: 0,0:17:39.89,0:17:43.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku melakukan ini agar Tsubasa\N‎bisa melihat betapa hebatnya laki-laki.
Dialogue: 0,0:17:43.22,0:17:45.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Lalu setelah dia melihatnya?
Dialogue: 0,0:17:45.10,0:17:46.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bukankah dia akan mendekatimu juga?
Dialogue: 0,0:17:46.98,0:17:48.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei, tunggu.
Dialogue: 0,0:17:48.23,0:17:50.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dengar, kau jangan ikut campur.
Dialogue: 0,0:17:50.52,0:17:52.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yang benar saja.
Dialogue: 0,0:17:52.02,0:17:55.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ayo kita kaitkan jari kelingking kita.
Dialogue: 0,0:17:55.11,0:17:56.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Omong kosong apa yang kau katakan?
Dialogue: 0,0:17:56.86,0:18:00.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Perjalanan pelarian cinta kita\N‎baru saja dimulai.
Dialogue: 0,0:18:00.24,0:18:02.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau menyebalkan. Berhenti mengikutiku.
Dialogue: 0,0:18:02.16,0:18:06.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Detak jantung yang cepat adalah tanda\N‎ketertarikan. Sekarang, mari kita...
Dialogue: 0,0:18:06.00,0:18:08.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Diam. Jangan bernapas. Jangan bicara.
Dialogue: 0,0:18:08.75,0:18:10.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Berhenti, kalian para pencuri.
Dialogue: 0,0:18:11.38,0:18:14.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Berani-beraninya kalian, dasar kucing!
Dialogue: 0,0:18:18.13,0:18:19.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Meong?
Dialogue: 0,0:18:20.68,0:18:23.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kucing!
Dialogue: 0,0:18:30.73,0:18:32.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Hei.\N‎- Tunggu.
Dialogue: 0,0:18:32.98,0:18:37.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sejak lahir, aku tidak pernah...
Dialogue: 0,0:18:37.99,0:18:42.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎sekali pun tertarik
Dialogue: 0,0:18:43.24,0:18:46.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎untuk memeluk laki-laki! Dasar bodoh!
Dialogue: 0,0:18:46.95,0:18:49.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Semuanya jadi jungkir balik...
Dialogue: 0,0:18:49.16,0:18:51.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Halo... Selamat tinggal.
Dialogue: 0,0:18:55.88,0:18:58.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu kebencian pada lelaki yang amat kuat.
Dialogue: 0,0:18:58.09,0:19:02.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Rasakan itu.\N‎Berani-beraninya lelaki menyentuhku‎...
Dialogue: 0,0:19:04.89,0:19:06.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ranma-ku?
Dialogue: 0,0:19:06.47,0:19:07.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya...
Dialogue: 0,0:19:08.77,0:19:10.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Siapa yang melakukan ini padamu?
Dialogue: 0,0:19:10.94,0:19:12.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa harus kuberi tahu Tsubasa?
Dialogue: 0,0:19:13.36,0:19:14.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau harus diobati.
Dialogue: 0,0:19:14.90,0:19:16.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Habislah aku.
Dialogue: 0,0:19:16.07,0:19:18.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ranma-ku, jangan lemah begitu.
Dialogue: 0,0:19:18.99,0:19:23.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku ingin mandi terakhir kali\N‎sebelum ajal menjemputku.
Dialogue: 0,0:19:23.03,0:19:25.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mandi? Baiklah.
Dialogue: 0,0:19:30.87,0:19:33.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mandi di tengah hari begini\N‎terasa menyenangkan sekali.
Dialogue: 0,0:19:37.30,0:19:38.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hup.
Dialogue: 0,0:19:47.89,0:19:49.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ranma-ku. Apa terasa nyaman?
Dialogue: 0,0:19:50.81,0:19:51.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Halo?
Dialogue: 0,0:19:54.81,0:19:57.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau lelaki yang tadi?
Dialogue: 0,0:19:57.15,0:19:59.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Beginilah adanya.
Dialogue: 0,0:20:01.07,0:20:02.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mustahil...
Dialogue: 0,0:20:02.74,0:20:05.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ranma-ku sebenarnya seorang lelaki.
Dialogue: 0,0:20:08.91,0:20:11.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sudah kuduga cuma Akane yang kupunya.
Dialogue: 0,0:20:12.46,0:20:14.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Serang!
Dialogue: 0,0:20:14.88,0:20:18.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tunggu. Berhentilah mengejar wanita\N‎satu demi satu.
Dialogue: 0,0:20:18.84,0:20:21.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Kenapa kau sangat membenci laki-laki?\N‎- Lepaskan.
Dialogue: 0,0:20:21.47,0:20:22.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Diamlah!
Dialogue: 0,0:20:25.76,0:20:28.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kenapa aku harus membuang waktuku\N‎untuk lelaki?
Dialogue: 0,0:20:28.26,0:20:31.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku ingin berkencan dengan gadis manis!
Dialogue: 0,0:20:31.48,0:20:32.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa?
Dialogue: 0,0:20:34.52,0:20:36.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kenapa? Kau belum pernah melihat\N‎pria telanjang?
Dialogue: 0,0:20:37.48,0:20:39.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ternyata begitu, ya?
Dialogue: 0,0:20:39.27,0:20:41.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku melakukan semua itu
Dialogue: 0,0:20:41.74,0:20:44.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎demi bajingan sepertimu...
Dialogue: 0,0:20:46.99,0:20:48.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Sekolah khusus lelaki?\N‎- Ya.
Dialogue: 0,0:20:49.45,0:20:53.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak pernah bilang bahwa sekolah lamaku\N‎sekolah khusus lelaki?
Dialogue: 0,0:20:53.04,0:20:54.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu kabar baru bagiku.
Dialogue: 0,0:20:54.54,0:20:56.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku benar-benar tertipu.
Dialogue: 0,0:20:57.00,0:20:59.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tertipu? Menyebalkan sekali.
Dialogue: 0,0:20:59.21,0:21:01.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku cuma lelaki biasa yang suka menyamar.
Dialogue: 0,0:21:01.96,0:21:05.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tak ada yang bertanya,\N‎jadi kukira kalian semua sudah tahu.
Dialogue: 0,0:21:05.47,0:21:07.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tahu dari mana?
Dialogue: 0,0:21:07.47,0:21:09.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau bisa saja bilang sendiri.
Dialogue: 0,0:21:09.43,0:21:10.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan marah kepadaku.
Dialogue: 0,0:21:10.93,0:21:13.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bukankah kita punya hobi yang sama?
Dialogue: 0,0:21:13.43,0:21:16.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Bukankah kita punya hobi yang sama?{\i0}
Dialogue: 0,0:21:16.73,0:21:20.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak! Ini bukan hobi bagiku!
Dialogue: 0,0:21:28.66,0:21:31.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Serang, serang, serang!
Dialogue: 0,0:22:57.00,0:23:02.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Terjemahan subtitle oleh Rio Wibowo\N‎Pengawas Produksi: Ranma1/2 Project
