Dialogue: 0,0:00:47.00,0:00:50.96,sign,,0000,0000,0000,,‎RANMA1/2
Dialogue: 0,0:02:15.67,0:02:20.43,sign,,0000,0000,0000,,{\an8}‎HAPPY DAN KE LUN
Dialogue: 0,0:02:46.41,0:02:47.49,sign,,0000,0000,0000,,‎PANAS SEKALI...
Dialogue: 0,0:03:47.64,0:03:48.72,sign,,0000,0000,0000,,‎SUDAH DATANG!
Dialogue: 0,0:03:50.27,0:03:51.39,sign,,0000,0000,0000,,‎RESTORAN NEKOHAN
Dialogue: 0,0:04:25.93,0:04:27.01,sign,,0000,0000,0000,,‎PENGINAPAN
Dialogue: 0,0:04:37.31,0:04:38.48,sign,,0000,0000,0000,,{\an8}‎HARTAKU - JANGAN SENTUH
Dialogue: 0,0:05:30.28,0:05:31.37,sign,,0000,0000,0000,,‎RESTORAN NEKOHAN
Dialogue: 0,0:07:10.26,0:07:11.34,sign,,0000,0000,0000,,‎HAPPOSAI USIA 18 TAHUN
Dialogue: 0,0:08:50.57,0:08:51.65,sign,,0000,0000,0000,,{\an8}‎KE LUN
Dialogue: 0,0:11:29.02,0:11:31.56,sign,,0000,0000,0000,,‎APA ADA KEJADIAN MENARIK?
Dialogue: 0,0:11:32.10,0:11:33.98,sign,,0000,0000,0000,,‎ADA APA?
Dialogue: 0,0:13:33.02,0:13:34.27,sign,,0000,0000,0000,,‎ES SERUT - PERMEN KAPAS
Dialogue: 0,0:14:04.55,0:14:06.71,sign,,0000,0000,0000,,‎PENGINAPAN
Dialogue: 0,0:15:35.51,0:15:36.85,sign,,0000,0000,0000,,‎DUK
Dialogue: 0,0:16:00.04,0:16:01.12,sign,,0000,0000,0000,,‎TERLARANG
Dialogue: 0,0:16:33.07,0:16:35.49,sign,,0000,0000,0000,,{\an8}‎TERLARANG
Dialogue: 0,0:00:23.35,0:00:26.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dia adalah Ranma\N‎dari Aliran Silat Segala Jurus Saotome.{\i0}
Dialogue: 0,0:00:26.81,0:00:29.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dia adalah Akane dari Perguruan Tendo.{\i0}
Dialogue: 0,0:00:29.82,0:00:32.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kini mereka bertunangan\N‎atas keputusan orang tua mereka.{\i0}
Dialogue: 0,0:00:32.94,0:00:34.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan jodohkan aku.
Dialogue: 0,0:00:34.70,0:00:36.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ini menyebalkan.
Dialogue: 0,0:00:36.07,0:00:38.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dan Ranma punya sebuah masalah.{\i0}
Dialogue: 0,0:00:40.33,0:00:41.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa yang kau lakukan?
Dialogue: 0,0:00:41.66,0:00:44.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dia berubah menjadi perempuan\N‎saat terkena air.{\i0}
Dialogue: 0,0:02:24.39,0:02:26.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kakak makan lagi?
Dialogue: 0,0:02:26.35,0:02:29.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ini lezat karena dimakan di sini.
Dialogue: 0,0:02:29.19,0:02:32.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Benar. Makan es serut di pantai\N‎memang yang terbaik!
Dialogue: 0,0:02:32.65,0:02:33.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya, kau benar.
Dialogue: 0,0:02:34.48,0:02:35.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ini sungguh damai.
Dialogue: 0,0:02:36.23,0:02:37.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Di mana Ayah?
Dialogue: 0,0:02:37.94,0:02:40.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia pasti sedang keluyuran\N‎di suatu tempat.
Dialogue: 0,0:02:41.28,0:02:44.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mungkin melihat laut yang luas\N‎membakar semangat bela dirinya?
Dialogue: 0,0:02:44.53,0:02:46.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi ayahku diam saja?
Dialogue: 0,0:02:47.50,0:02:48.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maka kembalilah jadi manusia.
Dialogue: 0,0:02:54.42,0:02:57.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Kakak!\N‎- Tidak!
Dialogue: 0,0:03:01.01,0:03:03.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mari makan semangka bersama!
Dialogue: 0,0:03:05.72,0:03:08.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Energimu banyak sekali.
Dialogue: 0,0:03:09.18,0:03:11.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kenapa kau datang jauh-jauh ke sini?
Dialogue: 0,0:03:11.77,0:03:13.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa kau tak bisa melihatnya?
Dialogue: 0,0:03:13.73,0:03:14.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak.
Dialogue: 0,0:03:14.81,0:03:16.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dasar bocah ingusan. Lihatlah.
Dialogue: 0,0:03:17.36,0:03:19.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Langit biru yang indah.\N‎Awan putih yang lembut.
Dialogue: 0,0:03:19.99,0:03:21.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Matahari yang bersinar cerah.
Dialogue: 0,0:03:21.61,0:03:25.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Pantainya luar biasa.\N‎Ini membakar semangat seorang pesilat.
Dialogue: 0,0:03:25.95,0:03:29.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yang mana langit biru, awan putih,\N‎dan matahari yang cerah?
Dialogue: 0,0:03:30.83,0:03:33.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak bisa menahan dorongan ini.
Dialogue: 0,0:03:33.67,0:03:36.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Raba saja gurita atau apalah lainnya!
Dialogue: 0,0:03:37.71,0:03:42.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kira-kira apakah ada cara\N‎untuk menenangkan Kakek Happosai?
Dialogue: 0,0:03:43.09,0:03:45.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Siapa yang memesan mi dingin Tionghoa?
Dialogue: 0,0:03:45.93,0:03:47.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku. Di sini.
Dialogue: 0,0:03:48.72,0:03:50.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mi dingin Tionghoa!
Dialogue: 0,0:03:51.39,0:03:52.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aiyaa!{\i0}
Dialogue: 0,0:03:52.64,0:03:53.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Shan Pu?
Dialogue: 0,0:03:53.85,0:03:55.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Ni hao{\i0}‎, Ranma.
Dialogue: 0,0:03:55.40,0:03:59.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Alangkah bahagianya.\N‎Kau mengikutiku ke pantai.
Dialogue: 0,0:03:59.03,0:04:00.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ini cuma kebetulan! Kebetulan!
Dialogue: 0,0:04:00.86,0:04:02.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei! Kau sedang apa?
Dialogue: 0,0:04:03.74,0:04:08.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Benar sekali, Kafe Kucing buka lagi\N‎di tepi pantai musim panas ini.
Dialogue: 0,0:04:08.74,0:04:10.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Karena ini musim panen uang.
Dialogue: 0,0:04:10.66,0:04:14.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ranma, ayo kencan setelah restoran tutup.
Dialogue: 0,0:04:14.00,0:04:16.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bukankah restoranmu sibuk?
Dialogue: 0,0:04:16.38,0:04:18.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tak ada yang datang setelah makan siang.
Dialogue: 0,0:04:21.71,0:04:23.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kencan, ya?{\i0}
Dialogue: 0,0:04:27.01,0:04:29.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa? Kau akan mengenalkan pacar kepadaku?
Dialogue: 0,0:04:30.56,0:04:32.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Benarkah, Ranma?
Dialogue: 0,0:04:32.14,0:04:36.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya.
Dialogue: 0,0:04:36.10,0:04:37.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Angkat.
Dialogue: 0,0:04:39.15,0:04:41.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Untungnya aku membawa kotak hartaku.
Dialogue: 0,0:04:42.11,0:04:45.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau diam-diam ikut\N‎dengan bersembunyi di kotak itu?
Dialogue: 0,0:04:45.11,0:04:46.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku penasaran kotak apa itu.
Dialogue: 0,0:04:46.95,0:04:48.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ini dia.
Dialogue: 0,0:04:48.03,0:04:50.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku akan beri dia gelang ini.
Dialogue: 0,0:04:52.00,0:04:53.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Cantik sekali.
Dialogue: 0,0:04:53.87,0:04:57.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu ide bagus. Aku yakin dia pasti suka.
Dialogue: 0,0:04:58.00,0:05:02.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Paham? Aku suka gadis dengan mata besar\N‎berbinar, dan berambut panjang...
Dialogue: 0,0:05:02.26,0:05:03.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu persis menggambarkan dirinya.
Dialogue: 0,0:05:15.89,0:05:19.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ranma, jangan bilang kau berniat\N‎mengenalkan Shan Pu padanya?
Dialogue: 0,0:05:20.44,0:05:21.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sudah kuduga.
Dialogue: 0,0:05:21.82,0:05:24.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau tahu dia pasti akan menolak.
Dialogue: 0,0:05:24.61,0:05:28.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau yakin? Bisa saja mereka malah cocok.
Dialogue: 0,0:05:28.36,0:05:30.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa kau serius mengatakan itu?
Dialogue: 0,0:05:31.37,0:05:33.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Shan Pu, aku datang sesuai permintaanmu.
Dialogue: 0,0:05:33.75,0:05:35.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ranma.
Dialogue: 0,0:05:36.08,0:05:37.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Halo.
Dialogue: 0,0:05:37.17,0:05:38.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku sudah menunggu.
Dialogue: 0,0:05:42.67,0:05:45.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sulit kupercaya\N‎aku akan menikahi gadis secantik ini.
Dialogue: 0,0:05:45.67,0:05:47.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Siapa yang akan menikah? Siapa?
Dialogue: 0,0:05:48.76,0:05:51.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baiklah, ayo sapa dia.
Dialogue: 0,0:05:52.72,0:05:55.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kakek ini bilang dia ingin\N‎berkencan denganmu, Nenek Buyut.
Dialogue: 0,0:05:57.98,0:05:59.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia sangat sesuai dengan tipemu.
Dialogue: 0,0:06:00.15,0:06:02.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Mata besar dan berbinar.{\i0}
Dialogue: 0,0:06:02.11,0:06:04.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dan rambut panjang...{\i0}
Dialogue: 0,0:06:07.57,0:06:09.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ada apa dengan kakek-kakek ini?
Dialogue: 0,0:06:09.74,0:06:11.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu air mata bahagia.
Dialogue: 0,0:06:11.45,0:06:15.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Begitu, ya. Dia teman yang sempurna\N‎untuk diajak minum teh.
Dialogue: 0,0:06:15.79,0:06:19.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Lagi pula mereka seangkatan.\N‎- Mereka pasangan yang serasi.
Dialogue: 0,0:06:19.92,0:06:22.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baiklah, mari kita tinggalkan\N‎para orang tua ini...
Dialogue: 0,0:06:22.67,0:06:25.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dan yang muda-muda akan pamit.
Dialogue: 0,0:06:25.00,0:06:26.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tunggu.
Dialogue: 0,0:06:26.96,0:06:30.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jika kau mau berkencan denganku,\N‎aku akan memberikan ini padamu.
Dialogue: 0,0:06:30.34,0:06:32.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aiyaa{\i0}‎. Indah sekali gelang ini.
Dialogue: 0,0:06:35.31,0:06:38.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Yang kau punya itu\N‎barang yang cukup langka.
Dialogue: 0,0:06:38.89,0:06:42.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya. Itu terlihat sangat mahal.
Dialogue: 0,0:06:42.98,0:06:46.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau mencurinya dari suatu tempat, ya?
Dialogue: 0,0:06:46.57,0:06:51.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Beraninya kau bilang begitu.\N‎Ini kenangan cinta dan masa mudaku.
Dialogue: 0,0:06:51.07,0:06:52.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Benarkah?
Dialogue: 0,0:06:52.82,0:06:55.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya, ini kisah saat aku berusia 18 tahun.
Dialogue: 0,0:06:56.83,0:07:01.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Semua terjadi saat aku berkelana\N‎ke Tiongkok untuk berlatih.
Dialogue: 0,0:07:04.46,0:07:08.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku bertemu seorang gadis cantik\N‎di sebuah desa,{\i0}
Dialogue: 0,0:07:09.13,0:07:10.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎lalu jatuh cinta.{\i0}
Dialogue: 0,0:07:11.34,0:07:12.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei, siapa orang itu?
Dialogue: 0,0:07:13.39,0:07:16.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tapi, wanita dilarang\N‎selama perjalanan latihan.{\i0}
Dialogue: 0,0:07:17.31,0:07:18.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Selamat tinggal.
Dialogue: 0,0:07:18.93,0:07:20.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Alangkah tragisnya takdir kami.
Dialogue: 0,0:07:20.69,0:07:23.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Setidaknya, bawalah pusaka ini,
Dialogue: 0,0:07:23.86,0:07:26.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎gelang ini, sebagai pengganti diriku.
Dialogue: 0,0:07:33.53,0:07:35.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itulah kali terakhir aku melihatnya.
Dialogue: 0,0:07:37.16,0:07:39.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Itu kisah cinta yang cukup tragis.
Dialogue: 0,0:07:39.70,0:07:43.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Desa Pendekar Wanita Tiongkok\N‎tempat tinggalku juga ada tragedi serupa.
Dialogue: 0,0:07:44.42,0:07:46.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Tapi dalam kasus ini...
Dialogue: 0,0:07:46.71,0:07:48.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Nona, nikahilah aku.
Dialogue: 0,0:07:48.71,0:07:50.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Menikahlah denganku.
Dialogue: 0,0:07:50.01,0:07:53.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎- Dia merayu semua gadis dan ditolak.{\i0}\N‎- Nona, ayo kita menikah.
Dialogue: 0,0:07:53.55,0:07:58.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sebagai balas dendam, dia jarah perhiasan\N‎dan uang warga desa lalu kabur.{\i0}
Dialogue: 0,0:07:58.56,0:07:59.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aiyaa!{\i0}
Dialogue: 0,0:08:00.93,0:08:03.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jahat sekali orang itu.
Dialogue: 0,0:08:05.65,0:08:07.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Masih pura-pura bodoh?
Dialogue: 0,0:08:07.90,0:08:10.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Dasar bajingan jahat!
Dialogue: 0,0:08:18.45,0:08:20.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak pernah menduga\N‎akan bertemu dirimu di sini.
Dialogue: 0,0:08:20.91,0:08:24.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apakah mengenalkan mereka berdua\N‎adalah sebuah kesalahan?
Dialogue: 0,0:08:24.25,0:08:27.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Siapa yang menyangka\N‎mereka ternyata saling kenal?
Dialogue: 0,0:08:29.09,0:08:31.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kembalikan pusaka keluarga kami.
Dialogue: 0,0:08:31.96,0:08:32.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa?
Dialogue: 0,0:08:33.55,0:08:35.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Maksudmu pemilik gelang ini adalah...
Dialogue: 0,0:08:35.93,0:08:38.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Mustahil, apakah kau...
Dialogue: 0,0:08:39.89,0:08:41.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Ke Lun?
Dialogue: 0,0:08:42.98,0:08:45.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Lama tak jumpa, Happy.
Dialogue: 0,0:08:45.69,0:08:47.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Happy?
Dialogue: 0,0:08:47.44,0:08:50.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎- Ke Lun adalah...\N‎- Ke Lun adalah nama nenek buyutku.
Dialogue: 0,0:08:51.65,0:08:55.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bisa tahu nama panggilanku saat muda,
Dialogue: 0,0:08:55.99,0:08:57.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎jadi kau memang benar Ke Lun.
Dialogue: 0,0:08:57.70,0:09:00.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kurasa tak ada yang bisa luput\N‎dari jalannya waktu.
Dialogue: 0,0:09:00.20,0:09:01.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Omong kosong!
Dialogue: 0,0:09:01.83,0:09:03.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Selamat tinggal, masa mudaku!
Dialogue: 0,0:09:03.41,0:09:05.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bom asap?
Dialogue: 0,0:09:06.29,0:09:09.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Karena kini aku tahu ini barang pusaka,\N‎tak akan kukembalikan padamu.
Dialogue: 0,0:09:09.96,0:09:11.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dasar iblis jahat!
Dialogue: 0,0:09:12.21,0:09:15.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Shan Pu. Kita harus merebut kembali\N‎gelang itu
Dialogue: 0,0:09:15.42,0:09:17.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎sebelum dia mengetahui rahasianya.
Dialogue: 0,0:09:17.39,0:09:18.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Rahasia?
Dialogue: 0,0:09:18.59,0:09:22.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jika tidak, dunia ini\N‎akan berubah menjadi neraka.
Dialogue: 0,0:09:22.18,0:09:23.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa?
Dialogue: 0,0:09:23.52,0:09:24.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa maksudnya?
Dialogue: 0,0:09:32.65,0:09:35.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Gelang itu berisi ramuan cinta?
Dialogue: 0,0:09:35.32,0:09:38.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Ya. Ramuannya berupa bola-bola\N‎yang tertanam di gelang itu.
Dialogue: 0,0:09:39.70,0:09:44.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ramuan itu membuatmu jatuh cinta\N‎pada lawan jenis pertama yang kau lihat.
Dialogue: 0,0:09:46.04,0:09:48.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ramuan itu mengerikan...
Dialogue: 0,0:09:48.04,0:09:51.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jika Happy sampai tahu rahasia ini...
Dialogue: 0,0:09:51.25,0:09:52.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Semua akan berantakan.
Dialogue: 0,0:09:55.72,0:09:58.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku mendengarnya. Aku mendengar semuanya.
Dialogue: 0,0:09:58.30,0:09:59.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Happy, bajingan kau.
Dialogue: 0,0:10:02.01,0:10:04.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sudah waktunya\N‎menyalakan api cinta bersamaku,
Dialogue: 0,0:10:04.81,0:10:07.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Shan Pu.
Dialogue: 0,0:10:07.48,0:10:08.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Ni hao.{\i0}
Dialogue: 0,0:10:08.60,0:10:10.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ini.
Dialogue: 0,0:10:13.36,0:10:15.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Tertangkap.\N‎- Sialan. Ini jebakan.
Dialogue: 0,0:10:15.94,0:10:17.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Menyerahlah.
Dialogue: 0,0:10:17.82,0:10:20.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Rasakan itu, dasar tua... bangka?
Dialogue: 0,0:10:23.45,0:10:26.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Berani-beraninya kau tidak sopan\N‎pada mastermu sendiri?
Dialogue: 0,0:10:26.79,0:10:27.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ups.
Dialogue: 0,0:10:29.37,0:10:30.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia lolos, ya?
Dialogue: 0,0:10:30.58,0:10:33.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi dia menjatuhkan satu.
Dialogue: 0,0:10:33.21,0:10:35.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apakah itu ramuan cintanya?
Dialogue: 0,0:10:37.30,0:10:38.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apakah ini akan berhasil?
Dialogue: 0,0:10:41.80,0:10:43.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau akan menghalangiku?
Dialogue: 0,0:10:43.43,0:10:45.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya ampun, apakah memang begitu?
Dialogue: 0,0:10:48.60,0:10:50.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei, jangan bergerak tiba-tiba.
Dialogue: 0,0:10:53.06,0:10:54.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa?
Dialogue: 0,0:10:56.57,0:10:58.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Cantiknya...
Dialogue: 0,0:10:58.03,0:10:59.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa?
Dialogue: 0,0:10:59.49,0:11:03.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Ramuan itu membuatmu jatuh cinta\N‎pada lawan jenis pertama yang kau lihat.{\i0}
Dialogue: 0,0:11:05.49,0:11:06.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mustahil, Ranma?
Dialogue: 0,0:11:06.95,0:11:11.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau... cantik... sekali.
Dialogue: 0,0:11:11.08,0:11:12.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak, hentikan itu.
Dialogue: 0,0:11:13.04,0:11:14.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau luar biasa cantik.
Dialogue: 0,0:11:14.13,0:11:17.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Aku tak menginginkan ini. Ini seharusnya\N‎terjadi tanpa pengaruh ramuan cinta...
Dialogue: 0,0:11:17.71,0:11:19.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi bohong.
Dialogue: 0,0:11:20.47,0:11:22.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ranma bodoh!
Dialogue: 0,0:11:23.22,0:11:26.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bodoh!
Dialogue: 0,0:11:26.56,0:11:29.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mustahil aku menelannya semudah itu...
Dialogue: 0,0:11:33.98,0:11:35.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku...
Dialogue: 0,0:11:35.31,0:11:36.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎menelannya...
Dialogue: 0,0:11:36.86,0:11:39.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ranma, lihatlah aku!
Dialogue: 0,0:11:39.32,0:11:40.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tak akan kubiarkan!
Dialogue: 0,0:11:40.57,0:11:44.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei, Nenek Tua!\N‎Apakah ada obat... penawarnya?
Dialogue: 0,0:11:50.45,0:11:52.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kenapa...{\i0}
Dialogue: 0,0:11:53.71,0:11:55.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎aku tak pernah...{\i0}
Dialogue: 0,0:11:55.92,0:11:59.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Menyadari betapa menawannya orang ini?
Dialogue: 0,0:12:01.09,0:12:02.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku merasa agak malu.
Dialogue: 0,0:12:02.88,0:12:06.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Nenek Buyut, itu tidak adil.\N‎Menjauhlah darinya.
Dialogue: 0,0:12:08.01,0:12:10.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak ada lagi yang bisa\N‎memisahkan kami dan cinta kami.
Dialogue: 0,0:12:11.43,0:12:14.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baiklah, Ke Lun.\N‎Ayo kita langsung menggelar pernikahan.
Dialogue: 0,0:12:15.60,0:12:17.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ranma serius soal ini.
Dialogue: 0,0:12:17.61,0:12:21.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak boleh! Jangan pergi. Ranma!
Dialogue: 0,0:12:23.28,0:12:24.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ranma!
Dialogue: 0,0:12:24.70,0:12:27.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak!
Dialogue: 0,0:12:28.45,0:12:30.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Beraninya kau!
Dialogue: 0,0:12:32.87,0:12:34.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aduh...
Dialogue: 0,0:12:34.21,0:12:37.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak akan merestui. Aku tak akan pernah\N‎merestui pernikahan ini.
Dialogue: 0,0:12:39.21,0:12:40.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau bicara apa?
Dialogue: 0,0:12:40.75,0:12:44.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jika kau harus menikahi wanita itu,\N‎kau harus mengalahkanku dulu...
Dialogue: 0,0:12:44.47,0:12:46.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Memang aku mau menikah dengan siapa?
Dialogue: 0,0:12:49.43,0:12:50.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Aku.
Dialogue: 0,0:12:52.68,0:12:55.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mungkin efeknya memudar?
Dialogue: 0,0:12:55.77,0:12:57.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sepertinya begitu.
Dialogue: 0,0:12:57.65,0:12:59.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Syukurlah.
Dialogue: 0,0:12:59.02,0:13:02.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Menantuku menelan Pil Sesaat.
Dialogue: 0,0:13:02.15,0:13:04.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Pil Sesaat?\N‎- Ya.
Dialogue: 0,0:13:04.07,0:13:08.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ada tiga ramuan cinta, masing-masing\N‎bertahan dalam jangka waktu berbeda.
Dialogue: 0,0:13:09.07,0:13:12.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Yang tersisa adalah Pil Sehari\N‎dan Pil Seumur Hidup.{\i0}
Dialogue: 0,0:13:12.24,0:13:14.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Pil Sehari bertahan selama sehari penuh.{\i0}
Dialogue: 0,0:13:15.46,0:13:18.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Lalu Pil Seumur Hidup?
Dialogue: 0,0:13:19.29,0:13:22.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jika menantuku menelan Pil Seumur Hidup,
Dialogue: 0,0:13:23.46,0:13:25.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎aku pasti jadi istrinya\N‎yang jauh lebih tua.
Dialogue: 0,0:13:26.63,0:13:28.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Nyaris sekali.
Dialogue: 0,0:13:29.68,0:13:30.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ranma?
Dialogue: 0,0:13:34.27,0:13:35.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia pingsan.
Dialogue: 0,0:13:38.15,0:13:39.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku mulai.
Dialogue: 0,0:13:41.57,0:13:42.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dapat.
Dialogue: 0,0:13:44.53,0:13:45.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei.
Dialogue: 0,0:13:49.62,0:13:50.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Pantai ini bagus sekali.
Dialogue: 0,0:13:51.62,0:13:54.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Aku akan beri ini untuk gadis yang mana?
Dialogue: 0,0:13:55.33,0:13:56.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Happy.
Dialogue: 0,0:13:56.46,0:13:57.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Shan Pu.
Dialogue: 0,0:13:58.54,0:14:00.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kencanlah bersamaku.
Dialogue: 0,0:14:00.71,0:14:03.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa?
Dialogue: 0,0:14:06.72,0:14:08.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei, Ranma.
Dialogue: 0,0:14:09.13,0:14:11.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Berapa lama kau akan pingsan?
Dialogue: 0,0:14:11.97,0:14:13.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Situasi ini amat menguntungkanku.
Dialogue: 0,0:14:14.14,0:14:15.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Shan Pu.
Dialogue: 0,0:14:17.60,0:14:18.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Gelang itu?
Dialogue: 0,0:14:22.52,0:14:24.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Shan Pu, kau pembohong.
Dialogue: 0,0:14:26.44,0:14:29.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku akan membuatnya menelan ini\N‎selagi dia tidur.
Dialogue: 0,0:14:29.45,0:14:30.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau gigih sekali.
Dialogue: 0,0:14:35.79,0:14:39.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baiklah, Ranma. Jatuh cintalah padaku.
Dialogue: 0,0:14:39.58,0:14:41.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tak akan kubiarkan!
Dialogue: 0,0:14:46.92,0:14:48.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Apa? Ada apa ini?
Dialogue: 0,0:14:48.42,0:14:50.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ini hanya bekerja pada lawan jenis,
Dialogue: 0,0:14:50.30,0:14:53.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎jadi tak ada gunanya bagi sesama wanita.
Dialogue: 0,0:14:55.22,0:14:58.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tinggal mengubahnya kembali\N‎jadi lelaki setelah mencekokinya ini.
Dialogue: 0,0:15:01.15,0:15:02.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau meleset...
Dialogue: 0,0:15:09.95,0:15:13.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa? Akane menelan ramuan cinta?
Dialogue: 0,0:15:13.91,0:15:17.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yang berarti dia akan jatuh cinta\N‎dengan pria pertama
Dialogue: 0,0:15:17.87,0:15:19.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎yang dia lihat.
Dialogue: 0,0:15:20.33,0:15:22.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Panas.\N‎- Baiklah, Akane.
Dialogue: 0,0:15:22.29,0:15:24.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Lihatlah Ranma!
Dialogue: 0,0:15:24.25,0:15:25.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tak akan kubiarkan.
Dialogue: 0,0:15:26.55,0:15:29.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ayah, jangan lakukan hal yang tak berguna.
Dialogue: 0,0:15:29.55,0:15:31.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Akane...
Dialogue: 0,0:15:31.05,0:15:33.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku akan putuskan siapa yang akan kulihat...
Dialogue: 0,0:15:33.55,0:15:35.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Akane!
Dialogue: 0,0:15:38.06,0:15:42.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Pil yang tersisa adalah Pil Sehari\N‎dan Pil Seumur Hidup, 'kan?
Dialogue: 0,0:15:42.06,0:15:43.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau telan yang mana?
Dialogue: 0,0:15:44.48,0:15:46.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mana aku tahu...
Dialogue: 0,0:15:47.40,0:15:50.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa yang akan terjadi\N‎jika itu Pil Seumur Hidup?
Dialogue: 0,0:15:50.24,0:15:53.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Efek ramuan cintanya\N‎akan bertahan seumur hidup...
Dialogue: 0,0:15:53.24,0:15:54.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Duar!
Dialogue: 0,0:15:56.08,0:16:00.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tak sudi aku memberimu kesempatan\N‎sekecil apa pun, dasar tua bangka.
Dialogue: 0,0:16:07.84,0:16:10.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jadi, ini yang terakhir?
Dialogue: 0,0:16:10.55,0:16:12.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya, jadi yang mana itu?
Dialogue: 0,0:16:13.38,0:16:14.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tenang saja.
Dialogue: 0,0:16:14.64,0:16:18.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau menelan Pil Sehari.
Dialogue: 0,0:16:18.43,0:16:19.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Benarkah?\N‎- Ya.
Dialogue: 0,0:16:20.85,0:16:22.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Begitu saja?
Dialogue: 0,0:16:22.73,0:16:24.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sikap macam apa itu?
Dialogue: 0,0:16:24.73,0:16:27.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tak perlu terlalu pusing\N‎karena Pil Sehari.
Dialogue: 0,0:16:29.78,0:16:32.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Bersikap seolah itu bukan urusanmu...\N‎- Hei.
Dialogue: 0,0:16:35.99,0:16:37.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Sebelum kau melihat yang aneh-aneh,
Dialogue: 0,0:16:39.45,0:16:41.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎mau memanfaatkan aku agar selesai?
Dialogue: 0,0:16:41.20,0:16:42.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Apa?
Dialogue: 0,0:16:42.91,0:16:44.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Kau yakin?
Dialogue: 0,0:16:45.21,0:16:47.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tentu saja aku bercanda.
Dialogue: 0,0:16:55.01,0:16:56.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau baik-baik saja, Ranma?
Dialogue: 0,0:16:58.55,0:17:01.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku cuma perlu tak lihat lelaki\N‎seharian ini, bukan?
Dialogue: 0,0:17:01.93,0:17:03.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Akane.
Dialogue: 0,0:17:03.14,0:17:04.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan ganggu aku.
Dialogue: 0,0:17:05.10,0:17:06.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ada tembok.
Dialogue: 0,0:17:06.73,0:17:08.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sepertinya aku telat mengatakannya.
Dialogue: 0,0:17:12.19,0:17:13.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Semoga berhasil!
Dialogue: 0,0:17:13.82,0:17:15.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Diam!
Dialogue: 0,0:17:17.28,0:17:18.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku salah.
Dialogue: 0,0:17:19.07,0:17:21.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yang Akane telan adalah Pil Seumur Hidup.
Dialogue: 0,0:17:23.37,0:17:25.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa? Sungguh?
Dialogue: 0,0:17:25.83,0:17:26.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sungguh.
Dialogue: 0,0:17:27.62,0:17:29.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Akane! Tunggu! Hei!
Dialogue: 0,0:17:29.75,0:17:31.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Begitukah?
Dialogue: 0,0:17:41.22,0:17:43.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Di... mana...
Dialogue: 0,0:17:43.72,0:17:46.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎aku sebenarnya?
Dialogue: 0,0:17:49.06,0:17:50.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ini adalah akhir riwayatku...
Dialogue: 0,0:17:52.90,0:17:56.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Akane, aku ingin bertemu denganmu...
Dialogue: 0,0:18:04.37,0:18:05.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Akane.
Dialogue: 0,0:18:15.63,0:18:19.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ranma bodoh.\N‎Dia seharusnya bisa sedikit lebih peka...
Dialogue: 0,0:18:21.18,0:18:22.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ini sungguh menyebalkan.
Dialogue: 0,0:18:23.35,0:18:25.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak butuh ini...
Dialogue: 0,0:18:25.06,0:18:26.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Akane!
Dialogue: 0,0:18:32.27,0:18:33.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Apa yang sedang kau lakukan?
Dialogue: 0,0:18:33.65,0:18:35.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ada babi yang tenggelam.
Dialogue: 0,0:18:36.53,0:18:39.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎P-chan, kenapa kau di sini?
Dialogue: 0,0:18:41.45,0:18:43.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yang lebih penting, Akane, dengarkan...
Dialogue: 0,0:18:43.99,0:18:46.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Seratus ayunan!
Dialogue: 0,0:18:46.41,0:18:48.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Tatewaki.\N‎- Satu-dua.
Dialogue: 0,0:18:48.75,0:18:52.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Satu-dua.
Dialogue: 0,0:18:58.92,0:19:02.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Lihat dia. Dia cemburu\N‎padahal sudah bicara begitu.{\i0}
Dialogue: 0,0:19:04.35,0:19:07.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dengar, Akane. Ramuan yang kau telan itu...
Dialogue: 0,0:19:08.85,0:19:12.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei. Dengarkan aku!
Dialogue: 0,0:19:12.15,0:19:15.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak mau. Kau tak perlu mencemaskan aku.
Dialogue: 0,0:19:15.44,0:19:18.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tutup matamu.\N‎Bagaimana jika kau melihat pria aneh?
Dialogue: 0,0:19:18.94,0:19:22.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Biar saja. Siapa tahu\N‎aku bertemu pangeran berkuda putih.
Dialogue: 0,0:19:22.61,0:19:23.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei!
Dialogue: 0,0:19:27.37,0:19:31.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ini kakek bagai pangeran berkuda putih.\N‎Kau akan jatuh cinta seumur hidupmu.
Dialogue: 0,0:19:32.12,0:19:33.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Akane.
Dialogue: 0,0:19:34.38,0:19:35.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan lihat!
Dialogue: 0,0:19:42.55,0:19:45.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Akane, aku akan menyelamatkanmu sekarang.
Dialogue: 0,0:19:46.64,0:19:47.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa?
Dialogue: 0,0:19:52.56,0:19:53.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ranma.
Dialogue: 0,0:19:54.61,0:19:59.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak keberatan walau cuma sehari,\N‎jadilah lelaki dan jatuh cintalah padaku.
Dialogue: 0,0:19:59.32,0:20:00.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ayolah.
Dialogue: 0,0:20:02.99,0:20:04.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aiyaa{\i0}‎, Ranma.
Dialogue: 0,0:20:04.95,0:20:07.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Akane, kau harus bersyukur.
Dialogue: 0,0:20:08.79,0:20:10.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Seluruh hidupmu akan kacau
Dialogue: 0,0:20:11.04,0:20:13.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎jika kau jatuh cinta pada kakek tua itu.
Dialogue: 0,0:20:14.00,0:20:16.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku kembali jadi lelaki\N‎karena tidak ada pilihan lain.
Dialogue: 0,0:20:28.56,0:20:29.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Jadi...
Dialogue: 0,0:20:30.85,0:20:33.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎apa kau... jatuh cinta?
Dialogue: 0,0:20:37.77,0:20:38.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku jatuh cinta...
Dialogue: 0,0:20:41.40,0:20:43.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mana mungkin! Dasar bajingan kasar!
Dialogue: 0,0:20:44.32,0:20:45.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa?
Dialogue: 0,0:20:45.41,0:20:48.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kenapa tidak? Bukankah kau menelan\N‎ramuan cintanya?
Dialogue: 0,0:20:48.33,0:20:51.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Karena kau hampir membuatku\N‎tenggelam, ini terjadi.
Dialogue: 0,0:20:52.04,0:20:53.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau muntahkan lagi?
Dialogue: 0,0:20:54.83,0:20:56.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Pil bodoh!
Dialogue: 0,0:20:56.46,0:20:58.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan dibuang!
Dialogue: 0,0:21:08.85,0:21:10.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Seperti kataku,
Dialogue: 0,0:21:10.72,0:21:13.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎yang kau telan adalah Pil Seumur Hidup.
Dialogue: 0,0:21:13.56,0:21:15.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu Pil Sehari.
Dialogue: 0,0:21:15.10,0:21:17.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ranma, telanlah Pil Sehari.
Dialogue: 0,0:21:17.98,0:21:19.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hentikan, Shan Pu.
Dialogue: 0,0:21:20.23,0:21:22.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bagus sekali kau sudah mendapat pacar.
Dialogue: 0,0:21:22.82,0:21:24.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kalian berdua mirip sekali.
Dialogue: 0,0:21:24.82,0:21:26.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kalian berdua tampak serasi, Master.
Dialogue: 0,0:21:26.95,0:21:28.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku bukan gurita.
Dialogue: 0,0:21:29.57,0:21:30.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau gurita.
Dialogue: 0,0:22:56.87,0:23:01.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Terjemahan subtitle oleh Rio Wibowo\N‎Pengawas Produksi: Ranma1/2 Project
