Dialogue: 0,0:00:13.68,0:00:16.85,sign,,0000,0000,0000,,‎PENGENALAN TATA CARA SAUNA
Dialogue: 0,0:00:41.04,0:00:42.95,sign,,0000,0000,0000,,‎TELER SAUNA
Dialogue: 0,0:00:45.00,0:00:48.96,sign,,0000,0000,0000,,‎RANMA1/2
Dialogue: 0,0:02:13.00,0:02:14.25,sign,,0000,0000,0000,,{\an8}‎PUSAT PERBELANJAAN
Dialogue: 0,0:02:14.25,0:02:17.59,sign,,0000,0000,0000,,{\an8}‎JURUS UPACARA TEH
Dialogue: 0,0:03:30.50,0:03:31.58,sign,,0000,0000,0000,,‎OBAT LUMPUH
Dialogue: 0,0:03:56.48,0:03:58.02,sign,,0000,0000,0000,,‎TEH
Dialogue: 0,0:05:36.58,0:05:37.67,sign,,0000,0000,0000,,‎ORANG INI
Dialogue: 0,0:05:48.72,0:05:50.39,sign,,0000,0000,0000,,‎JURUS RAHASIA ALIRAN DAIMONJI\N‎SABETAN SERBET
Dialogue: 0,0:07:31.99,0:07:33.11,sign,,0000,0000,0000,,{\an8}‎DITERIMA
Dialogue: 0,0:07:33.11,0:07:35.41,sign,,0000,0000,0000,,‎SELAMAT
Dialogue: 0,0:08:46.52,0:08:47.52,sign,,0000,0000,0000,,‎TERIMA KASIH
Dialogue: 0,0:10:40.93,0:10:43.85,sign,,0000,0000,0000,,‎JURUS RAHASIA DAIMONJI TUTUP KETEL
Dialogue: 0,0:12:27.16,0:12:28.99,sign,,0000,0000,0000,,‎ARENA PERTANDINGAN
Dialogue: 0,0:13:04.74,0:13:07.24,sign,,0000,0000,0000,,{\an8}‎GURU BESAR ALIRAN MIYAKOJI\N‎SATSUKI MIYAKOJI
Dialogue: 0,0:21:18.02,0:21:20.69,sign,,0000,0000,0000,,‎POSE SEBELUM BERANGKAT BULAN MADU
Dialogue: 0,0:00:17.55,0:00:20.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Ranma dari Aliran Silat\N‎Segala Jurus Saotome.{\i0}
Dialogue: 0,0:00:21.22,0:00:23.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dan Akane dari Perguruan Tendo.{\i0}
Dialogue: 0,0:00:24.06,0:00:27.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kini mereka bertunangan\N‎atas keputusan orang tua mereka.{\i0}
Dialogue: 0,0:00:27.23,0:00:28.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Jangan jodohkan aku.{\i0}
Dialogue: 0,0:00:28.82,0:00:30.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Ini menyebalkan.{\i0}
Dialogue: 0,0:00:32.78,0:00:35.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa yang kau lakukan?
Dialogue: 0,0:00:35.57,0:00:38.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dia berubah menjadi perempuan\N‎saat terkena air.{\i0}
Dialogue: 0,0:02:26.93,0:02:28.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kuda lepas?
Dialogue: 0,0:02:28.39,0:02:29.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ada yang menungganginya!
Dialogue: 0,0:02:29.85,0:02:31.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu seorang pria. Dan...
Dialogue: 0,0:02:31.65,0:02:33.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia tidak sadarkan diri!
Dialogue: 0,0:02:40.45,0:02:41.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Jangan ikuti aku, Shan Pu!
Dialogue: 0,0:02:41.99,0:02:45.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sudah kubilang\N‎aku tidak tahan dengan kucing!
Dialogue: 0,0:02:48.04,0:02:49.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Awas!
Dialogue: 0,0:02:49.33,0:02:50.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mereka akan bertabrakan!
Dialogue: 0,0:03:09.81,0:03:11.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei, kau tidak apa-apa?
Dialogue: 0,0:03:21.28,0:03:23.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima kasih telah menolongku\N‎dalam situasi berbahaya.
Dialogue: 0,0:03:26.08,0:03:28.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sebagai terima kasih,\N‎kuberikan waktu istirahat.
Dialogue: 0,0:03:28.58,0:03:30.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau tidak perlu berterima kasih padaku.
Dialogue: 0,0:03:31.58,0:03:35.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak. Kau adalah penyelamat hidupku.
Dialogue: 0,0:03:35.59,0:03:39.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Sekarang silakan cicipi\N‎tanda terima kasihku.
Dialogue: 0,0:03:39.63,0:03:41.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Begitukah?
Dialogue: 0,0:03:46.43,0:03:49.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa itu sebenarnya? Tenagaku...
Dialogue: 0,0:03:49.43,0:03:51.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu obat pelumpuh.
Dialogue: 0,0:03:52.73,0:03:55.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Setimpal dengan berlari tanpa henti\N‎selama tiga hari tiga malam.
Dialogue: 0,0:03:58.02,0:04:01.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Akhirnya, aku akhirnya bertemu\N‎dengan wanita kuat.
Dialogue: 0,0:04:02.90,0:04:05.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Siapa kau sebenarnya?
Dialogue: 0,0:04:16.67,0:04:17.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ranma?
Dialogue: 0,0:04:19.17,0:04:22.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Berhenti!
Dialogue: 0,0:04:39.52,0:04:41.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Siapa pria itu?{\i0}
Dialogue: 0,0:04:41.78,0:04:43.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Ini sendok teh?{\i0}
Dialogue: 0,0:05:01.67,0:05:03.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kimono pengantin?
Dialogue: 0,0:05:04.80,0:05:07.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau sudah sadar?
Dialogue: 0,0:05:07.64,0:05:11.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Maafkan atas berbagai ketidaksopananku\N‎yang tidak sepantasnya.
Dialogue: 0,0:05:11.89,0:05:13.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ada yang mau kukatakan!
Dialogue: 0,0:05:13.35,0:05:16.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Kau mau katakan apa pada orang\N‎yang kau culik? Aku mau pulang!
Dialogue: 0,0:05:16.77,0:05:19.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mohon tunggu. Jangan setega itu.
Dialogue: 0,0:05:19.06,0:05:22.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mohon dengarkan aku dulu.
Dialogue: 0,0:05:22.03,0:05:23.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sentaro.
Dialogue: 0,0:05:23.11,0:05:25.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa?
Dialogue: 0,0:05:25.36,0:05:26.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Nenek.
Dialogue: 0,0:05:26.61,0:05:29.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau bawa gadis lain lagi entah dari mana,
Dialogue: 0,0:05:29.53,0:05:31.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎dan memakaikannya kimono pengantin.
Dialogue: 0,0:05:31.24,0:05:33.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Cukup, hentikan kebodohan ini.
Dialogue: 0,0:05:33.33,0:05:36.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak akan. Aku akan menikahi orang ini.
Dialogue: 0,0:05:38.37,0:05:41.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Omong kosong konyol macam apa\N‎yang kau ocehkan?
Dialogue: 0,0:05:44.71,0:05:46.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Berani-beraninya kau memperlakukan...
Dialogue: 0,0:05:51.18,0:05:53.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎...penerusku yang berharga dengan kasar.
Dialogue: 0,0:05:56.02,0:05:57.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau...
Dialogue: 0,0:05:59.06,0:06:00.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dasar nenek tua.
Dialogue: 0,0:06:00.73,0:06:02.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Menggunakan teknik aneh...
Dialogue: 0,0:06:03.07,0:06:05.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Upacara Minum Teh Bela Diri\N‎Aliran Daimonji,
Dialogue: 0,0:06:05.40,0:06:07.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jurus Rahasia Sabetan Serbet.
Dialogue: 0,0:06:08.45,0:06:10.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Upacara Minum Teh Bela Diri?
Dialogue: 0,0:06:10.20,0:06:11.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Benar.
Dialogue: 0,0:06:14.20,0:06:16.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku putra tunggal Guru Besar
Dialogue: 0,0:06:16.12,0:06:19.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎dari Upacara Minum Teh Bela Diri.
Dialogue: 0,0:06:19.58,0:06:23.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Belakangan ini aku menerima lamaran nikah\N‎demi melanjutkan garis keturunan kami.
Dialogue: 0,0:06:24.46,0:06:26.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Akan tetapi,
Dialogue: 0,0:06:27.17,0:06:28.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎aku sama sekali tidak bisa...
Dialogue: 0,0:06:29.84,0:06:32.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎benar-benar tidak bisa...
Dialogue: 0,0:06:34.22,0:06:35.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎mencintainya.
Dialogue: 0,0:06:35.97,0:06:37.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei, ayolah.
Dialogue: 0,0:06:37.06,0:06:38.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kupikir jika wanita pilihanku
Dialogue: 0,0:06:38.81,0:06:42.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎bisa mengalahkan calon tunanganku\N‎dengan Upacara Minum Teh Bela Diri,
Dialogue: 0,0:06:42.94,0:06:44.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎entah bagaimana aku bisa
Dialogue: 0,0:06:44.61,0:06:47.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎meminta pertunangan ini dibatalkan.
Dialogue: 0,0:06:47.11,0:06:48.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Walau kau bilang begitu padaku,
Dialogue: 0,0:06:48.74,0:06:50.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎aku tak tahu Upacara Minum Teh Bela Diri.
Dialogue: 0,0:06:50.91,0:06:52.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mustahil.
Dialogue: 0,0:06:52.32,0:06:55.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sentaro, pernikahan ini sudah disetujui.
Dialogue: 0,0:06:55.95,0:06:58.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku sudah mengirimkan jawaban kita\N‎ke pihak sebelah.
Dialogue: 0,0:06:59.33,0:07:00.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Lagi pula...
Dialogue: 0,0:07:03.92,0:07:05.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apanya yang lucu?
Dialogue: 0,0:07:05.13,0:07:07.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Upacara Minum Teh Bela Diri,\N‎yang terkuat di Jepang,
Dialogue: 0,0:07:08.13,0:07:10.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎mustahil gadis sembarangan\N‎yang dibawa kuda ini bisa.
Dialogue: 0,0:07:11.09,0:07:13.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Benar-benar mustahil.
Dialogue: 0,0:07:13.59,0:07:16.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei, Nenek Tua, aku tak bisa\N‎membiarkanmu bicara begitu.
Dialogue: 0,0:07:16.43,0:07:20.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku, Ranma Saotome, tak pernah kalah\N‎dari aliran bela diri mana pun!
Dialogue: 0,0:07:20.89,0:07:24.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baiklah! Aku terima pertarungan ini!
Dialogue: 0,0:07:24.44,0:07:26.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Aku paham.
Dialogue: 0,0:07:26.19,0:07:29.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Jika kau begitu bersikeras, silakan saja.
Dialogue: 0,0:07:29.32,0:07:31.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Jika kau menang, kau kuakui\N‎sebagai tunangan Sentaro.
Dialogue: 0,0:07:35.41,0:07:38.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima kasih banyak.
Dialogue: 0,0:07:39.33,0:07:40.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa?
Dialogue: 0,0:07:40.87,0:07:43.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ranma, silakan duduk.
Dialogue: 0,0:07:43.58,0:07:46.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku akan mengajarimu\N‎tata krama Upacara Minum Teh Bela Diri.
Dialogue: 0,0:07:47.34,0:07:49.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kurasa airnya sudah cukup panas sekarang.
Dialogue: 0,0:07:51.13,0:07:54.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Setelah kau menang pertarungan,\N‎kita adakan pernikahan mewah.
Dialogue: 0,0:07:54.14,0:07:57.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku yakin kau akan terlihat cantik\N‎mengenakan kimono pengantin...
Dialogue: 0,0:07:57.93,0:08:00.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau masih ingin menjadikanku pengantinmu?
Dialogue: 0,0:08:10.57,0:08:13.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei, hentikan tangismu!
Dialogue: 0,0:08:14.11,0:08:18.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kukira aku akhirnya bertemu\N‎dengan wanita idamanku.
Dialogue: 0,0:08:18.95,0:08:21.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kenapa tak nikahi calon tunanganmu itu\N‎dengan senang hati?
Dialogue: 0,0:08:22.62,0:08:27.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau bisa bicara sejahat itu\N‎karena tak kenal Satsuki.
Dialogue: 0,0:08:27.34,0:08:28.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Satsuki?
Dialogue: 0,0:08:28.63,0:08:30.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Siapa kau sebenarnya?
Dialogue: 0,0:08:31.84,0:08:33.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Biarkan aku lewat!
Dialogue: 0,0:08:37.18,0:08:40.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tahu kau yang menyeret Ranma ke sini.
Dialogue: 0,0:08:40.68,0:08:41.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Akane.
Dialogue: 0,0:08:44.35,0:08:46.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ini sendok teh yang hilang entah di mana.
Dialogue: 0,0:08:48.40,0:08:50.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hilang entah di mana?
Dialogue: 0,0:08:50.98,0:08:52.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Begitu, ya?
Dialogue: 0,0:08:52.57,0:08:56.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima kasih banyak telah jauh-jauh datang\N‎untuk mengembalikannya.
Dialogue: 0,0:09:01.08,0:09:03.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku bertarung\N‎di Upacara Minum Teh Bela Diri
Dialogue: 0,0:09:03.16,0:09:05.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎menggantikan Ranma?
Dialogue: 0,0:09:05.08,0:09:08.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yah, aku memang paham\N‎soal upacara minum teh.
Dialogue: 0,0:09:08.17,0:09:09.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Pembohong.
Dialogue: 0,0:09:09.29,0:09:13.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa? Tidak sopan sekali.\N‎Aku belajar dari Kasumi, tahu.
Dialogue: 0,0:09:13.01,0:09:14.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terdengar menarik. Tunjukkan padaku.
Dialogue: 0,0:09:14.84,0:09:18.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dewa masih belum meninggalkanku.
Dialogue: 0,0:09:28.19,0:09:29.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Lihat? Dia pilihan terburuk.
Dialogue: 0,0:09:30.44,0:09:32.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi dia sangat manis, sangat manis, tapi...
Dialogue: 0,0:09:34.28,0:09:37.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Pokoknya, kau menonton saja dengan tenang.
Dialogue: 0,0:09:37.15,0:09:39.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Aku yang akan bertarung.\N‎- Apa?
Dialogue: 0,0:09:39.87,0:09:42.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bukankah aku satu-satunya pilihanmu?\N‎Atau bagaimana?
Dialogue: 0,0:09:42.83,0:09:47.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau yakin punya keberanian untuk melatih\N‎si ceroboh nomor satu di Jepang?
Dialogue: 0,0:09:47.83,0:09:50.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Siapa yang kau sebut\N‎si ceroboh nomor satu di Jepang?
Dialogue: 0,0:09:52.13,0:09:53.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau benar.
Dialogue: 0,0:09:53.34,0:09:56.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mau tidak mau,\N‎Ranma-lah yang akan bertanding.
Dialogue: 0,0:09:56.97,0:09:59.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi, aku menolak menikah denganmu!
Dialogue: 0,0:09:59.68,0:10:02.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kapan aku pernah bilang\N‎ingin jadi istrimu?
Dialogue: 0,0:10:06.35,0:10:09.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dasar Upacara Minum Teh Bela Diri\N‎adalah posisi duduk {\i1}‎seiza{\i0}‎.
Dialogue: 0,0:10:09.35,0:10:11.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Seiza{\i0}‎, ya.
Dialogue: 0,0:10:11.23,0:10:14.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Semua gerakan dimulai\N‎dari {\i1}‎seiza{\i0} ‎yang benar.
Dialogue: 0,0:10:15.86,0:10:17.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ruangan ini anehnya panjang dan sempit.
Dialogue: 0,0:10:17.82,0:10:19.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ikuti aku.
Dialogue: 0,0:10:21.53,0:10:23.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Cepat sekali. Dia gerak dalam {\i1}‎seiza{\i0}‎.
Dialogue: 0,0:10:25.95,0:10:27.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tanganmu sedang apa?
Dialogue: 0,0:10:27.79,0:10:29.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Diam. Aku cuma perlu\N‎ikuti kecepatanmu, 'kan?
Dialogue: 0,0:10:29.92,0:10:32.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu benar, akan tetapi...
Dialogue: 0,0:10:32.17,0:10:34.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎jika tanganmu sibuk,
Dialogue: 0,0:10:34.92,0:10:36.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎itu akan sulit bagimu.
Dialogue: 0,0:10:36.30,0:10:38.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bajingan! Apa yang kau lakukan?
Dialogue: 0,0:10:39.09,0:10:40.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Duduklah dalam posisi {\i1}‎seiza{\i0}‎.
Dialogue: 0,0:10:44.85,0:10:48.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bisakah orang yang tak tersentuh ini\N‎duduk {\i1}‎seiza{\i0}‎ dengan benar?
Dialogue: 0,0:10:49.48,0:10:50.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Nenek!
Dialogue: 0,0:10:53.15,0:10:55.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia duduk {\i1}‎seiza{\i0} ‎di langit-langit?
Dialogue: 0,0:10:55.23,0:11:00.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bisakah orang sepertimu kalahkan Satsuki\N‎di pertandingan besok?
Dialogue: 0,0:11:00.11,0:11:01.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Besok?
Dialogue: 0,0:11:01.95,0:11:03.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu terlalu cepat.
Dialogue: 0,0:11:03.66,0:11:07.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mereka memberi kabar\N‎pertandingannya besok.
Dialogue: 0,0:11:07.58,0:11:08.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Besok...
Dialogue: 0,0:11:08.75,0:11:12.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kudengar Satsuki sangat mahir\N‎dalam Upacara Minum Teh Bela Diri.
Dialogue: 0,0:11:12.46,0:11:15.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku penasaran berapa lama gadis\N‎yang dibawa kuda itu bisa bertahan?
Dialogue: 0,0:11:15.84,0:11:18.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku akan menantikan untuk melihatnya\N‎dengan mataku sendiri.
Dialogue: 0,0:11:18.84,0:11:20.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Besok...
Dialogue: 0,0:11:24.30,0:11:25.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dia menggunakan jari kakinya.{\i0}
Dialogue: 0,0:11:26.35,0:11:30.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku paham.\N‎Itu berarti bergerak dalam posisi{\i0} ‎seiza
Dialogue: 0,0:11:30.68,0:11:32.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎sebenarnya menggunakan jari kaki.{\i0}
Dialogue: 0,0:11:32.69,0:11:33.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Seperti ini?
Dialogue: 0,0:11:36.90,0:11:39.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Ya! Aku berhasil!\N‎- Besok...
Dialogue: 0,0:11:40.40,0:11:44.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Waktunya latihan khusus! Latihan neraka!\N‎- Ini mudah sekali!
Dialogue: 0,0:11:44.41,0:11:47.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau! Berapa kali\N‎harus kuulangi perkataanku?
Dialogue: 0,0:11:47.28,0:11:49.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dasar dungu!
Dialogue: 0,0:11:49.29,0:11:52.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa yang kau lakukan, dasar bodoh?
Dialogue: 0,0:11:52.29,0:11:55.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau berani menyebut dirimu pesilat\N‎saat tak mampu menahan beban sebegini?
Dialogue: 0,0:11:55.75,0:11:56.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dasar dungu!
Dialogue: 0,0:11:56.88,0:11:58.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan sok hebat kau!
Dialogue: 0,0:11:58.50,0:12:00.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Menendang dengan kaki melanggar aturan.
Dialogue: 0,0:12:00.55,0:12:03.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Diamlah! Sikapmu berubah total\N‎setelah tahu aku lelaki.
Dialogue: 0,0:12:03.93,0:12:07.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tidak segan-segan pada laki-laki!
Dialogue: 0,0:12:07.01,0:12:09.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak tahan lagi!
Dialogue: 0,0:12:09.01,0:12:11.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ini pertama kalinya\N‎aku melihat kuda betina segila ini!
Dialogue: 0,0:12:11.93,0:12:14.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku bukan kuda betina gila!
Dialogue: 0,0:12:14.56,0:12:17.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Lalu kau mau apa dengan itu?
Dialogue: 0,0:12:17.86,0:12:20.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau membuatku sangat kesal!
Dialogue: 0,0:12:20.19,0:12:23.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau sudah menguasai semuanya.
Dialogue: 0,0:12:24.74,0:12:27.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sudah kubilang.
Dialogue: 0,0:12:28.99,0:12:34.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jadi, calon tunanganmu, Satsuki,\N‎seperti apa orangnya?
Dialogue: 0,0:12:34.12,0:12:35.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia adalah putri
Dialogue: 0,0:12:35.21,0:12:37.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎dari master Upacara Minum Teh Bela Diri\N‎Aliran Miyakoji.
Dialogue: 0,0:12:38.59,0:12:40.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia berasal dari keluarga terpandang,
Dialogue: 0,0:12:40.50,0:12:43.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎dan kudengar dia terpilih\N‎sebagai Nona Upacara Teh tahun ini.
Dialogue: 0,0:12:43.80,0:12:46.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Bukankah itu artinya dia cantik? Atau dia...{\i0}
Dialogue: 0,0:12:46.47,0:12:48.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎punya kepribadian yang buruk?{\i0}
Dialogue: 0,0:12:48.35,0:12:52.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sebenarnya dia sangat ramah\N‎dan punya kepribadian yang ceria.
Dialogue: 0,0:12:52.31,0:12:55.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Lalu apa sebenarnya yang tak kau suka...
Dialogue: 0,0:12:57.31,0:12:59.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ini Satsuki Miyakoji.
Dialogue: 0,0:13:01.61,0:13:03.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Seekor... monyet...
Dialogue: 0,0:13:03.07,0:13:04.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau bercanda, ya.
Dialogue: 0,0:13:07.24,0:13:10.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Aku sama sekali tak bisa mencintainya!
Dialogue: 0,0:13:10.78,0:13:11.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Benar.
Dialogue: 0,0:13:12.75,0:13:14.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku mau pulang.
Dialogue: 0,0:13:14.16,0:13:16.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan tega begitu setelah sejauh ini.
Dialogue: 0,0:13:16.17,0:13:17.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Diam.
Dialogue: 0,0:13:17.42,0:13:20.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yang menyedihkan adalah aku\N‎harus bertanding melawan monyet.
Dialogue: 0,0:13:20.79,0:13:23.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Monyet? Yang benar saja.
Dialogue: 0,0:13:23.42,0:13:25.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yang benar saja? Hei.
Dialogue: 0,0:13:25.84,0:13:28.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dilihat dari sudut mana pun, itu monyet!
Dialogue: 0,0:13:28.76,0:13:30.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu bohong. Itu sungguh bohong.
Dialogue: 0,0:13:30.60,0:13:33.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa pun situasinya, mana mungkin\N‎calon tunanganku seekor monyet?
Dialogue: 0,0:13:33.81,0:13:36.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kalau itu bukan monyet, lalu apa?
Dialogue: 0,0:13:37.81,0:13:39.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Diam.
Dialogue: 0,0:13:39.77,0:13:42.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Berani-beraninya kau bicara begitu\N‎soal tunangan seseorang.
Dialogue: 0,0:13:42.69,0:13:45.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tidak bisa membiarkan\N‎ada kelancangan lagi.
Dialogue: 0,0:13:45.28,0:13:47.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bukankah dia gadis kecil menggemaskan?
Dialogue: 0,0:13:47.86,0:13:51.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dengan sedikit sentuhan jiwa liar.
Dialogue: 0,0:13:52.37,0:13:53.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kalian berdua sangat serasi.
Dialogue: 0,0:13:53.87,0:13:56.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Menikahlah. Ya? Bagus.
Dialogue: 0,0:13:56.87,0:13:58.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ranma.
Dialogue: 0,0:13:58.67,0:14:00.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kalau begitu sudah beres...
Dialogue: 0,0:14:01.46,0:14:03.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa yang kau lakukan?
Dialogue: 0,0:14:16.89,0:14:19.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ranma, kau tak apa-apa?
Dialogue: 0,0:14:19.77,0:14:22.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baiklah, maju kau.
Dialogue: 0,0:14:23.77,0:14:26.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dasar monyet!
Dialogue: 0,0:14:26.61,0:14:29.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maukah kau bertarung\N‎di pertandingan ini, Ranma?
Dialogue: 0,0:14:29.91,0:14:32.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maka, sesuai tata cara\N‎Upacara Minum Teh Bela Diri,
Dialogue: 0,0:14:34.45,0:14:36.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎kau harus duduk {\i1}‎seiza{\i0}‎.
Dialogue: 0,0:14:36.87,0:14:38.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tunjukkan keahlian upacara tehmu.
Dialogue: 0,0:14:38.87,0:14:40.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bertarunglah secara adil.
Dialogue: 0,0:14:41.29,0:14:43.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Shuriken{\i0} ‎Sendok Teh!
Dialogue: 0,0:14:51.97,0:14:54.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jurus Kabut Bubuk Teh rahasia.
Dialogue: 0,0:14:55.35,0:14:57.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Langsung disambung Serangan Ketel.
Dialogue: 0,0:14:57.93,0:15:00.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia menghubungkan kedua teknik itu\N‎dengan sangat mulus.
Dialogue: 0,0:15:00.56,0:15:03.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Serangan Balasan Ketel!
Dialogue: 0,0:15:03.11,0:15:05.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Lanjut ke Serangan Gayung!
Dialogue: 0,0:15:06.61,0:15:08.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hentikan! Berhenti! Hei!
Dialogue: 0,0:15:09.19,0:15:12.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Gadis yang liar itu bertarung cukup baik.
Dialogue: 0,0:15:12.87,0:15:16.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia bertarung seimbang\N‎dengan Satsuki yang sangat mahir.
Dialogue: 0,0:15:16.16,0:15:21.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dengan kemampuan seperti itu, dia tak akan\N‎mempermalukanmu sebagai istrimu.
Dialogue: 0,0:15:21.17,0:15:23.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bukankah begitu, Sentaro?
Dialogue: 0,0:15:23.79,0:15:24.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sentaro?
Dialogue: 0,0:15:30.76,0:15:33.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Monyet sialan ini. Hebat juga dia.{\i0}
Dialogue: 0,0:15:37.06,0:15:38.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Shuriken{\i0} ‎Sendok Teh.
Dialogue: 0,0:15:42.19,0:15:44.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sabetan {\i1}‎Kakejiku{\i0}‎!
Dialogue: 0,0:15:51.15,0:15:52.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Serangan Kue Teh.
Dialogue: 0,0:15:58.83,0:16:00.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kena kau!
Dialogue: 0,0:16:00.58,0:16:04.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tendangan {\i1}‎Seiza{\i0}‎ Batang Teh!
Dialogue: 0,0:16:08.55,0:16:09.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu adalah...
Dialogue: 0,0:16:09.96,0:16:11.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Formula Rahasia Sembunyikan Ketel.
Dialogue: 0,0:16:19.39,0:16:21.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Pertandingan selesai.
Dialogue: 0,0:16:21.39,0:16:25.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Belum... Aku belum selesai.
Dialogue: 0,0:16:32.70,0:16:36.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Dia punya semangat yang luar biasa.\N‎Aku jadi makin menyukainya.
Dialogue: 0,0:16:39.74,0:16:43.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kenapa calon tunanganmu seekor monyet?
Dialogue: 0,0:16:43.33,0:16:44.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tidak tahu.
Dialogue: 0,0:16:44.46,0:16:46.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bagaimana bisa kau tidak tahu?
Dialogue: 0,0:16:46.38,0:16:48.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terlepas dari itu, Akane.
Dialogue: 0,0:16:48.34,0:16:49.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa?
Dialogue: 0,0:16:49.42,0:16:52.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa ada seseorang di dalam hatimu?
Dialogue: 0,0:16:53.47,0:16:54.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dalam hatiku?
Dialogue: 0,0:16:54.84,0:16:57.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Misalnya, Ranma.
Dialogue: 0,0:16:57.26,0:17:00.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kenapa kau malah menyebut Ranma?
Dialogue: 0,0:17:00.01,0:17:02.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia bukan siapa-siapa bagiku.
Dialogue: 0,0:17:03.06,0:17:05.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku punya ide yang sangat cerdik.
Dialogue: 0,0:17:05.98,0:17:07.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ide cerdik?
Dialogue: 0,0:17:08.73,0:17:12.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Pertandingan ini akan berakhir seri\N‎antara Satsuki dan Ranma.{\i0}
Dialogue: 0,0:17:12.48,0:17:14.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dan saat mereka berdua sudah disingkirkan,
Dialogue: 0,0:17:14.70,0:17:17.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎tak akan ada lagi penghalang\N‎di antara kita.
Dialogue: 0,0:17:17.74,0:17:18.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei, kau!
Dialogue: 0,0:17:19.49,0:17:21.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Rupanya itu rencanamu sejak awal?
Dialogue: 0,0:17:21.99,0:17:24.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa maksudmu?
Dialogue: 0,0:17:28.42,0:17:30.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tunggu!
Dialogue: 0,0:17:30.13,0:17:33.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Sekarang ini Pertarungan Upacara Teh.
Dialogue: 0,0:17:33.01,0:17:35.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Ini berubah menjadi pertarungan tepi ring.
Dialogue: 0,0:17:39.34,0:17:42.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jika ini tidak menghalangiku,\N‎kau pasti sudah...
Dialogue: 0,0:17:44.02,0:17:47.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Berhenti! Dasar monyet!
Dialogue: 0,0:17:56.61,0:18:00.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Rasakan ini! Serangan Ganda Ketel!
Dialogue: 0,0:18:08.83,0:18:10.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan halangi aku.
Dialogue: 0,0:18:11.09,0:18:13.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa kau ingin istirahat sejenak?
Dialogue: 0,0:18:13.05,0:18:15.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dasar bodoh, ini bukan saatnya...
Dialogue: 0,0:18:21.18,0:18:22.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ini obat pelumpuh.
Dialogue: 0,0:18:24.56,0:18:29.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku akan menghabisi kalian berdua, dan...
Dialogue: 0,0:18:30.56,0:18:32.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎menikahi Akane!
Dialogue: 0,0:18:32.27,0:18:34.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku menolak!
Dialogue: 0,0:18:40.28,0:18:44.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Berhenti! Tolong, berhenti!
Dialogue: 0,0:18:47.91,0:18:49.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kuda lepas?
Dialogue: 0,0:18:49.37,0:18:50.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Lagi?
Dialogue: 0,0:18:51.29,0:18:55.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak! Selamatkan aku!
Dialogue: 0,0:19:20.07,0:19:22.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau baik-baik saja?
Dialogue: 0,0:19:36.59,0:19:39.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sanae, maafkan aku.
Dialogue: 0,0:19:39.59,0:19:40.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sanae?
Dialogue: 0,0:19:40.88,0:19:43.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku sudah sangat menyusahkanmu
Dialogue: 0,0:19:43.55,0:19:45.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎dengan memintamu menggantikanku.
Dialogue: 0,0:19:45.39,0:19:46.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Pengganti?
Dialogue: 0,0:19:46.89,0:19:49.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Berarti kau Satsuki yang asli?
Dialogue: 0,0:19:49.89,0:19:51.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya.
Dialogue: 0,0:19:52.85,0:19:56.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kenapa kau melakukan\N‎hal semembingungkan ini?
Dialogue: 0,0:19:57.19,0:19:58.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya, jadi...
Dialogue: 0,0:19:58.53,0:20:01.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎aku sangat menantikan\N‎hari saat bertemu calon tunanganku,
Dialogue: 0,0:20:02.36,0:20:06.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎tapi saat harinya tiba, aku sangat malu.
Dialogue: 0,0:20:06.37,0:20:08.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sungguh wanita yang sangat pemalu.
Dialogue: 0,0:20:08.62,0:20:12.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Lebih memalukan lagi\N‎pakai monyet sebagai pengganti!
Dialogue: 0,0:20:12.00,0:20:13.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya.
Dialogue: 0,0:20:13.08,0:20:16.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Keanggunan halusnya adalah jiwa sejati\N‎dari Upacara Minum Teh Bela Diri.
Dialogue: 0,0:20:16.71,0:20:19.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dengan rendah hati kuserahkan cucuku\N‎ke dalam tanganmu.
Dialogue: 0,0:20:19.76,0:20:21.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sebuah kehormatan bagiku.
Dialogue: 0,0:20:24.22,0:20:29.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Satsuki.\N‎- Sentaro.
Dialogue: 0,0:20:29.81,0:20:31.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ayo kita pulang.
Dialogue: 0,0:20:31.02,0:20:33.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku lapar sekarang.
Dialogue: 0,0:20:33.48,0:20:34.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sentaro.
Dialogue: 0,0:20:35.94,0:20:40.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Satsuki.\N‎- Sentaro...
Dialogue: 0,0:20:40.94,0:20:41.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Satsuki...
Dialogue: 0,0:20:44.61,0:20:46.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Untukmu, Ranma.
Dialogue: 0,0:20:46.53,0:20:47.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima kasih.
Dialogue: 0,0:20:49.45,0:20:52.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kulewati salam pembukanya.\N‎Terima kasih atas semua bantuanmu.{\i0}
Dialogue: 0,0:20:52.87,0:20:55.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}‎Dengan bahagia kami umumkan\N‎kami resmi bertunangan.{\i0}
Dialogue: 0,0:20:55.46,0:20:59.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎"Ucapan terima kasihku kepadamu\N‎dan Akane tak akan pernah cukup."
Dialogue: 0,0:20:59.84,0:21:01.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bukankah itu kabar yang luar biasa?
Dialogue: 0,0:21:01.67,0:21:05.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kuharap urusan kita\N‎juga bisa berjalan lancar seperti itu.
Dialogue: 0,0:21:05.84,0:21:08.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎"Mungkin kita tidak akan pernah\N‎bertemu lagi..."
Dialogue: 0,0:21:09.51,0:21:11.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Langka sekali ada kuda lepas.
Dialogue: 0,0:21:12.31,0:21:14.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ranma, kita bertemu lagi.
Dialogue: 0,0:21:21.40,0:21:27.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sialan kalian!
Dialogue: 0,0:22:56.95,0:23:01.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Terjemahan subtitle oleh Rio Wibowo\N‎Pengawas Produksi: Ranma1/2 Project
