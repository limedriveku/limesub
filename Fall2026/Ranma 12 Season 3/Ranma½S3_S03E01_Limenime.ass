Dialogue: 0,0:00:13.97,0:00:17.93,sign,,0000,0000,0000,,{\c&Hffffff&}RANMA1/2
Dialogue: 0,0:01:42.60,0:01:46.06,sign,,0000,0000,0000,,{\an8}MAKAN MALAM DI TENGAH LATIHAN
Dialogue: 0,0:01:47.85,0:01:49.65,sign,,0000,0000,0000,,{\c&Hffffff&}KAMI AKAN KE GUNUNG
Dialogue: 0,0:02:20.64,0:02:21.64,sign,,0000,0000,0000,,{\c&Hffffff&}JADWAL KENCAN
Dialogue: 0,0:03:52.73,0:03:53.73,sign,,0000,0000,0000,,{\an8}PERGURUAN TENDO
Dialogue: 0,0:04:15.79,0:04:16.79,sign,,0000,0000,0000,,{\an8}SEPEKAN KEMUDIAN
Dialogue: 0,0:10:27.54,0:10:29.33,sign,,0000,0000,0000,,{\c&Hffffff&}SOUN YANG MEMINTA
Dialogue: 0,0:10:46.81,0:10:48.48,sign,,0000,0000,0000,,{\c&Hffffff&}TENTU
Dialogue: 0,0:12:02.63,0:12:04.18,sign,,0000,0000,0000,,{\an8}JANGAN JELALATAN!\N{\c&Hffffff&}KAU SEDANG LATIHAN
Dialogue: 0,0:12:06.22,0:12:07.22,sign,,0000,0000,0000,,{\an8}MASAKANMU TIDAK ENAK
Dialogue: 0,0:12:36.71,0:12:37.59,sign,,0000,0000,0000,,{\an8}ITU MENGGIDIKKAN
Dialogue: 0,0:14:02.38,0:14:03.38,sign,,0000,0000,0000,,{\an8}KARI PANDA
Dialogue: 0,0:14:03.46,0:14:04.96,sign,,0000,0000,0000,,{\c&Hffffff&}GARAM
Dialogue: 0,0:15:37.06,0:15:38.52,sign,,0000,0000,0000,,{\c&Hffffff&}REMPAH
Dialogue: 0,0:01:46.14,0:01:47.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kau pergi latihan musim panas ini?
Dialogue: 0,0:01:49.73,0:01:52.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Ke pantai saat libur musim panas\N{\c&Hffffff&}memang asyik,
Dialogue: 0,0:01:52.11,0:01:54.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}tapi ke gunung jauh lebih seru.\N{\c&Hffffff&}Benar, Akane?
Dialogue: 0,0:01:54.82,0:01:57.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}- Masa?\N{\c&Hffffff&}- Hei, itu telur gulungku!
Dialogue: 0,0:01:57.57,0:01:59.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Ayo, Ranma. Kita bisa terlambat.
Dialogue: 0,0:02:02.91,0:02:05.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}- Aku mau ke Hawaii liburan nanti.\N{\c&Hffffff&}- Enaknya.
Dialogue: 0,0:02:05.83,0:02:06.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Kau bagaimana, Akane?
Dialogue: 0,0:02:07.54,0:02:09.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Saat ini aku belum punya rencana.
Dialogue: 0,0:02:10.04,0:02:11.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Akane Tendo.
Dialogue: 0,0:02:11.63,0:02:13.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Tatewaki-senpai?
Dialogue: 0,0:02:13.29,0:02:15.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Ini jadwal pribadiku\N{\c&Hffffff&}untuk liburan musim panas ini.
Dialogue: 0,0:02:16.71,0:02:18.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Kita kencan tiap Senin, Rabu, Jumat,
Dialogue: 0,0:02:18.47,0:02:20.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}dan gadis berkepang\N{\c&Hffffff&}di hari lain, kecuali Minggu.
Dialogue: 0,0:02:22.26,0:02:24.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Aku sangat sibuk musim panas ini.
Dialogue: 0,0:02:24.43,0:02:28.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Omong-omong, Minggu kujadikan\N{\c&Hffffff&}hari cadangan andai cuaca buruk.
Dialogue: 0,0:02:28.52,0:02:31.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Bisakah kau sampaikan itu\N{\c&Hffffff&}kepada Gadis Berkepang?
Dialogue: 0,0:02:31.48,0:02:33.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}- Ranma.\N{\c&Hffffff&}- Pemenang musim panas ini memenangkanku.
Dialogue: 0,0:02:33.86,0:02:36.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}- Apa?\N{\c&Hffffff&}- Dan menjadi pacarku!
Dialogue: 0,0:02:36.90,0:02:38.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Apa-apaan ini?
Dialogue: 0,0:02:38.15,0:02:40.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Dia bilang mau kencan\N{\c&Hffffff&}dengan Gadis Berkepang.
Dialogue: 0,0:02:40.95,0:02:43.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}- Aku tak sudi.\N{\c&Hffffff&}- Ranma Saotome!
Dialogue: 0,0:02:44.95,0:02:49.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Kau tak berhak merobek\N{\c&Hffffff&}kenangan manis getir musim panasku!
Dialogue: 0,0:02:49.37,0:02:52.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}- Sudah lama juga. Mau bertarung?\N{\c&Hffffff&}- Ayo!
Dialogue: 0,0:02:52.46,0:02:56.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Tusuk!
Dialogue: 0,0:02:57.38,0:02:59.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Apa? Kemampuanmu tampaknya menurun.
Dialogue: 0,0:02:59.80,0:03:01.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Apa katamu?
Dialogue: 0,0:03:01.34,0:03:03.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Tusukanmu tak setajam dulu.
Dialogue: 0,0:03:03.47,0:03:04.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Bajingan!
Dialogue: 0,0:03:08.85,0:03:10.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Apa kau tak terlalu berlebihan?
Dialogue: 0,0:03:10.48,0:03:12.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Tapi aku sudah menahan diri.
Dialogue: 0,0:03:13.40,0:03:15.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Hei! Kau baik saja?
Dialogue: 0,0:03:16.57,0:03:20.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Jurus Kastanya Manis Tenshin Membara.\N{\c&Hffffff&}Tampaknya dia benar-benar menguasainya.
Dialogue: 0,0:03:21.86,0:03:26.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Sekarang, demi kelancaran calon menantuku\N{\c&Hffffff&}menikahi Shan Pu,
Dialogue: 0,0:03:26.74,0:03:29.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Aku harus singkirkan gadis itu.
Dialogue: 0,0:03:33.29,0:03:35.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Permisi, aku mau tanya.
Dialogue: 0,0:03:37.38,0:03:40.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Di mana bis surat terdekat?
Dialogue: 0,0:03:40.47,0:03:41.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Bis surat?
Dialogue: 0,0:03:41.88,0:03:45.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Lihat. Bis suratnya bisa terlihat\N{\c&Hffffff&}di sebelah sana.
Dialogue: 0,0:03:46.22,0:03:48.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Terima kasih. Kau sangat membantu.
Dialogue: 0,0:03:49.22,0:03:52.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Lalu, kenapa kau pergi ke sana?
Dialogue: 0,0:03:53.81,0:03:55.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}- Tn. Tendo.\N{\c&Hffffff&}- Ya?
Dialogue: 0,0:03:55.52,0:03:58.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}- Surat untukmu. Ini.\N{\c&Hffffff&}- Terima kasih.
Dialogue: 0,0:03:58.52,0:03:59.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Tantangan?
Dialogue: 0,0:04:00.82,0:04:02.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Ini dari Ryoga.
Dialogue: 0,0:04:03.49,0:04:05.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}{\i1}Lama tak jumpa, Ranma.{\i0}
Dialogue: 0,0:04:05.57,0:04:07.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}{\i1}Saat ini aku sedang jalani{\i0}\N{\c&Hffffff&}{\i1}latihan khusus di gunung.{\i0}
Dialogue: 0,0:04:08.66,0:04:11.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}{\i1}Tapi aku akan datang berkunjung{\i0}\N{\c&Hffffff&}{\i1}ke Perguruan Tendo besok.{\i0}
Dialogue: 0,0:04:11.37,0:04:13.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}{\i1}Bersiaplah untuk menerima kekalahanmu!{\i0}
Dialogue: 0,0:04:16.88,0:04:18.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Ini. Pangsit rebus\N{\c&Hffffff&}dan nasi omelet kepiting.
Dialogue: 0,0:04:20.42,0:04:21.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Selamat datang!
Dialogue: 0,0:04:22.84,0:04:24.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Selamat datang kembali, Nenek Buyut.
Dialogue: 0,0:04:24.93,0:04:28.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Ini hari yang baik.\N{\c&Hffffff&}Aku menangkap babi yang terlihat lezat.
Dialogue: 0,0:04:28.51,0:04:30.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Itu bagus sekali.
Dialogue: 0,0:04:34.19,0:04:37.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Aku akan merebusmu\N{\c&Hffffff&}menjadi masakan babi lezat.
Dialogue: 0,0:04:38.48,0:04:40.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Sepertinya aku pernah lihat babi itu.
Dialogue: 0,0:04:43.49,0:04:46.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Tunggu, jangan makan babi itu dulu…
Dialogue: 0,0:04:46.16,0:04:47.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Panas!
Dialogue: 0,0:04:47.24,0:04:49.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Panas!
Dialogue: 0,0:04:49.16,0:04:51.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Dasar nenek tua!
Dialogue: 0,0:04:57.21,0:04:59.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Ternyata kau teman calon suami Shan Pu.
Dialogue: 0,0:04:59.79,0:05:02.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}- Aku bukan temannya!\N{\c&Hffffff&}- Masa?
Dialogue: 0,0:05:02.84,0:05:06.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Semua itu salanya,\N{\c&Hffffff&}termasuk tubuhku yang aneh ini!
Dialogue: 0,0:05:10.93,0:05:12.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Hei, kembalikan itu!
Dialogue: 0,0:05:12.56,0:05:15.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Jangan asal ambil barang orang.
Dialogue: 0,0:05:16.81,0:05:17.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Bagaimana menurutmu?
Dialogue: 0,0:05:17.81,0:05:19.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Mau bekerja sama denganku?
Dialogue: 0,0:05:21.65,0:05:23.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Apa maksudmu?
Dialogue: 0,0:05:23.69,0:05:26.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Aku bilang, aku akan melatihmu.
Dialogue: 0,0:05:28.57,0:05:29.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Konyol sekali.
Dialogue: 0,0:05:30.99,0:05:32.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Hei, kau mau ke mana?
Dialogue: 0,0:05:32.66,0:05:36.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Aku tak tahu apa rencanamu,\N{\c&Hffffff&}tapi aku tak berniat membantumu.
Dialogue: 0,0:05:37.58,0:05:41.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Sayang sekali, tapi aku tak selemah itu\N{\c&Hffffff&}sampai butuh latihan darimu.
Dialogue: 0,0:05:42.38,0:05:43.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Begitu, ya?
Dialogue: 0,0:05:43.80,0:05:46.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Baiklah, aku ada di sini\N{\c&Hffffff&}andai kau berubah pikiran.
Dialogue: 0,0:05:47.68,0:05:49.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Kita tak akan berjumpa lagi.
Dialogue: 0,0:05:50.76,0:05:51.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Ya ampun…
Dialogue: 0,0:05:52.01,0:05:55.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Aku bahkan membuatkan es serut\N{\c&Hffffff&}sebagai permintaan maaf.
Dialogue: 0,0:05:55.68,0:05:58.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}{\i1}Nona, ayo. Ikutlah bersamaku.{\i0}
Dialogue: 0,0:05:58.69,0:06:00.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}{\i1}Kita tak bisa, Sadakichi.{\i0}
Dialogue: 0,0:06:00.19,0:06:03.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}{\i1}Kumohon, terimalah perasaanku untukmu.{\i0}
Dialogue: 0,0:06:03.32,0:06:04.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}{\i1}Ya ampun!{\i0}
Dialogue: 0,0:06:11.37,0:06:13.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Apa? Kau masih di sini?
Dialogue: 0,0:06:13.99,0:06:15.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Di mana pintunya?
Dialogue: 0,0:06:15.95,0:06:17.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Indra arahnya sangat buruk.
Dialogue: 0,0:06:19.54,0:06:21.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Hore, belut!
Dialogue: 0,0:06:21.42,0:06:24.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kuberi satu untuk Tn. Tendo.\N{\c&Hffffff&}Pastikan dia menerimanya.
Dialogue: 0,0:06:29.84,0:06:31.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Ranma!
Dialogue: 0,0:06:32.80,0:06:35.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}- Persiapkan dirimu!\N{\c&Hffffff&}- Hei, Ryoga.
Dialogue: 0,0:06:35.26,0:06:37.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Kau telat satu pekan.
Dialogue: 0,0:06:37.68,0:06:39.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Tapi kurasa bagimu itu cepat.
Dialogue: 0,0:06:41.02,0:06:43.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Kau dapat ekstra satu pekan\N{\c&Hffffff&}sebelum kau mati.
Dialogue: 0,0:06:43.27,0:06:45.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Bersyukurlah, Ranma!
Dialogue: 0,0:06:50.91,0:06:53.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Hei, bisa hentikan untuk hari ini?
Dialogue: 0,0:06:53.57,0:06:55.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Kenapa? Sekarang kau memohon ampun?
Dialogue: 0,0:06:56.08,0:06:58.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Bukan begitu. Sebenarnya, aku…
Dialogue: 0,0:06:59.71,0:07:01.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}harus mengantarkan ini.
Dialogue: 0,0:07:01.54,0:07:03.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Begitu, ya?
Dialogue: 0,0:07:03.50,0:07:08.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Artinya kau bisa bertarung tanpa\N{\c&Hffffff&}menahan diri jika kusingkirkan benda itu!
Dialogue: 0,0:07:10.34,0:07:14.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Berhenti mengelak dan hadapi aku!
Dialogue: 0,0:07:20.85,0:07:23.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Ryoga, kau jadi lebih lambat.
Dialogue: 0,0:07:27.36,0:07:28.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Jangan main-main denganku!
Dialogue: 0,0:07:29.99,0:07:31.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Dasar bajingan!
Dialogue: 0,0:07:33.91,0:07:35.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Kau memang makin lambat.
Dialogue: 0,0:07:41.08,0:07:43.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}{\i1}Aku… tak bisa…{\i0}
Dialogue: 0,0:07:43.92,0:07:45.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}{\i1}memercayainya…{\i0}
Dialogue: 0,0:07:45.46,0:07:46.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Oh, Ryoga.
Dialogue: 0,0:07:47.55,0:07:48.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}{\i1}Akane.{\i0}
Dialogue: 0,0:07:52.76,0:07:56.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Berkelahi lagi?\N{\c&Hffffff&}Kalian tidak pernah bosan, ya?
Dialogue: 0,0:07:56.22,0:07:58.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Bukan salahku.\N{\c&Hffffff&}Dia yang menyerangku lebih dulu.
Dialogue: 0,0:07:59.02,0:08:01.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Di depan Akane{\i0}\N{\c&Hffffff&}{\i1}terlihat menyedihkan begini…{\i0}
Dialogue: 0,0:08:01.73,0:08:03.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Dasar bajingan!
Dialogue: 0,0:08:04.23,0:08:07.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Apa-apaan?\N{\c&Hffffff&}Dasar bajingan tak tahu terima kasih!
Dialogue: 0,0:08:08.82,0:08:11.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Oh, ya, Akane. Kau sudah menemukan P-chan?
Dialogue: 0,0:08:11.44,0:08:12.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Apa? P-chan?
Dialogue: 0,0:08:13.20,0:08:16.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Aku sudah mencarinya,\N{\c&Hffffff&}tapi tidak ketemu. Kenapa?
Dialogue: 0,0:08:18.66,0:08:20.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Perlu kuberi lihat P-chan kepadanya?
Dialogue: 0,0:08:22.12,0:08:24.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Bercanda.
Dialogue: 0,0:08:29.46,0:08:32.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Jangan menindas yang lemah!
Dialogue: 0,0:08:32.67,0:08:35.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Siapa bilang dia lemah?
Dialogue: 0,0:08:35.13,0:08:36.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Ya ampun.
Dialogue: 0,0:08:41.10,0:08:43.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Dasar wanita kasar.
Dialogue: 0,0:08:44.19,0:08:46.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Tapi ini aneh sekali…
Dialogue: 0,0:08:51.90,0:08:53.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Jangan-jangan,
Dialogue: 0,0:08:53.95,0:08:56.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}bukan Ryoga yang makin lemah,
Dialogue: 0,0:08:57.53,0:08:59.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}tapi aku yang jadi makin kuat…
Dialogue: 0,0:09:00.41,0:09:01.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Aduh…
Dialogue: 0,0:09:01.87,0:09:04.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Yang benar saja.\N{\c&Hffffff&}Dia seharusnya bisa menahan diri.
Dialogue: 0,0:09:04.96,0:09:05.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Mari lihat…
Dialogue: 0,0:09:06.04,0:09:10.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Sendi ini arahnya ke sini… Aku tidak tahu.
Dialogue: 0,0:09:11.30,0:09:12.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Hei, Ryoga.
Dialogue: 0,0:09:13.88,0:09:16.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Kau sebaiknya berhenti menantang Ranma.
Dialogue: 0,0:09:17.59,0:09:21.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Dia menjadi makin kuat\N{\c&Hffffff&}karena terus-menerus diganggu
Dialogue: 0,0:09:21.43,0:09:23.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}oleh nenek buyutnya Shan Pu.
Dialogue: 0,0:09:25.35,0:09:27.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Jadi, jangan…
Dialogue: 0,0:09:37.57,0:09:39.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Sialan!
Dialogue: 0,0:09:40.07,0:09:41.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Ryoga…
Dialogue: 0,0:09:43.12,0:09:46.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Sialan!
Dialogue: 0,0:09:46.08,0:09:48.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Sialan!
Dialogue: 0,0:09:48.58,0:09:50.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Sialan!
Dialogue: 0,0:09:50.59,0:09:53.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Sialan!
Dialogue: 0,0:09:59.93,0:10:01.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Ranma, bajingan kau!
Dialogue: 0,0:10:01.68,0:10:05.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Sepertinya kau dihajar habis-habisan.
Dialogue: 0,0:10:08.27,0:10:11.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Aku ingin bicara lagi denganmu.
Dialogue: 0,0:10:13.57,0:10:17.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Aku juga ingin bertemu lagi denganmu.
Dialogue: 0,0:10:25.12,0:10:27.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Kenapa Akane datang juga?
Dialogue: 0,0:10:29.42,0:10:30.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Katakan padanya tidak bisa.
Dialogue: 0,0:10:30.88,0:10:34.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Agar lebih jelas,\N{\c&Hffffff&}aku ke sana juga untuk berlatih.
Dialogue: 0,0:10:34.30,0:10:37.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Lalu untuk apa ransel raksasa itu?
Dialogue: 0,0:10:38.26,0:10:39.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Memangnya kenapa?
Dialogue: 0,0:10:39.72,0:10:41.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Kita ke sana bukan untuk bermain.
Dialogue: 0,0:10:41.76,0:10:43.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Aku tahu.
Dialogue: 0,0:10:43.26,0:10:46.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Baiklah. Genma, jagalah Akane.
Dialogue: 0,0:10:48.56,0:10:50.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Akane.
Dialogue: 0,0:10:50.31,0:10:51.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Ada apa, Kak?
Dialogue: 0,0:10:51.90,0:10:53.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}- Bawalah ini.\N{\c&Hffffff&}- Kamera?
Dialogue: 0,0:10:53.69,0:10:55.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Pastikan kau mengambil foto yang banyak
Dialogue: 0,0:10:55.94,0:10:58.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}saat Ranma menjadi perempuan, ya!\N{\c&Hffffff&}Fotonya akan laku keras.
Dialogue: 0,0:10:58.74,0:10:59.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Jangan dijual!
Dialogue: 0,0:11:00.61,0:11:02.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}- Baik, kami berangkat.\N{\c&Hffffff&}- Aku mengandalkanmu.
Dialogue: 0,0:11:04.37,0:11:06.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}- Tunggu sebentar.\N{\c&Hffffff&}- Ada apa, Kasumi?
Dialogue: 0,0:11:06.74,0:11:08.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Bawalah ini.
Dialogue: 0,0:11:09.91,0:11:11.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Obat sakit perut?
Dialogue: 0,0:11:11.12,0:11:14.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Akane tak sabar ingin memasak\N{\c&Hffffff&}untuk semua orang di gunung.
Dialogue: 0,0:11:16.25,0:11:17.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Kau bisa tertinggal.
Dialogue: 0,0:11:18.01,0:11:19.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Aku datang.
Dialogue: 0,0:11:20.09,0:11:24.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Beginikah rasanya seorang ayah\N{\c&Hffffff&}saat melepas putrinya?
Dialogue: 0,0:11:24.30,0:11:26.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Dia cuma pergi latihan.
Dialogue: 0,0:11:26.18,0:11:30.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Benar. Lagi pula,\N{\c&Hffffff&}aku lebih mengkhawatirkan Ranma.
Dialogue: 0,0:11:31.73,0:11:33.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Semoga keberuntungan menyertainya.
Dialogue: 0,0:11:33.90,0:11:35.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Sekarang, mari minum teh.
Dialogue: 0,0:11:42.41,0:11:45.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Baik, sebanyak ini seharusnya cukup, 'kan?
Dialogue: 0,0:11:46.37,0:11:48.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Karena keduanya pergi entah ke mana,
Dialogue: 0,0:11:48.70,0:11:51.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}ini saat yang tepat\N{\c&Hffffff&}untuk siapkan makan malam.
Dialogue: 0,0:11:51.83,0:11:56.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Sial, seharusnya dia tak usah ikut.\N{\c&Hffffff&}Aku jadi terus mengkhawatirkannya.
Dialogue: 0,0:11:57.04,0:12:00.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Ya, ini akan jadi pertama kalinya\N{\c&Hffffff&}aku memakan masakan dia…
Dialogue: 0,0:12:01.30,0:12:02.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Apa-apaan?
Dialogue: 0,0:12:04.26,0:12:06.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Dasar! Kenapa Ayah membiarkannya ikut?
Dialogue: 0,0:12:08.01,0:12:10.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Masakanmu juga tak enak, Botak…
Dialogue: 0,0:12:12.56,0:12:15.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Apakah calon menantuku juga di sini\N{\c&Hffffff&}untuk berlatih? Kebetulan sekali.
Dialogue: 0,0:12:17.19,0:12:18.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Kau lagi? Dasar nenek tua!
Dialogue: 0,0:12:19.02,0:12:22.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Jangan salah paham.\N{\c&Hffffff&}Aku kemari bukan untuk mengganggumu.
Dialogue: 0,0:12:22.86,0:12:24.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Lalu kenapa kau kemari?
Dialogue: 0,0:12:24.36,0:12:26.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku ada urusan.
Dialogue: 0,0:12:26.32,0:12:28.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Lalu kebetulan aku melihatmu.
Dialogue: 0,0:12:29.03,0:12:32.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kau harus latihan dengan maksimal.
Dialogue: 0,0:12:32.08,0:12:35.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Waktu untuk menguji hasil kerja kerasmu\N{\c&Hffffff&}akan segera tiba.
Dialogue: 0,0:12:35.62,0:12:36.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Bicara apa dia?
Dialogue: 0,0:12:38.21,0:12:41.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Sungguh kebetulan\N{\c&Hffffff&}gadis itu juga ada bersama mereka.
Dialogue: 0,0:12:43.34,0:12:46.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Kau pergi ke mana, Nenek Tua?
Dialogue: 0,0:12:46.64,0:12:48.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Ayo kita mulai latihanku sekarang.
Dialogue: 0,0:12:49.35,0:12:51.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Jangan tidak sabar begitu.
Dialogue: 0,0:12:51.27,0:12:53.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Aku akan memeras tenagamu\N{\c&Hffffff&}mulai dari sekarang.
Dialogue: 0,0:12:56.69,0:13:00.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Mari kita mulai\N{\c&Hffffff&}dengan menghancurkan batu besar ini.
Dialogue: 0,0:13:00.15,0:13:01.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Apa?
Dialogue: 0,0:13:01.28,0:13:02.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Konyol sekali.
Dialogue: 0,0:13:03.03,0:13:05.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Kupikir latihan luar biasa\N{\c&Hffffff&}seperti apa ini.
Dialogue: 0,0:13:05.74,0:13:07.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Senang mendengarnya.
Dialogue: 0,0:13:16.75,0:13:17.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Mudah sekali.
Dialogue: 0,0:13:18.58,0:13:19.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Kenapa memukulku?
Dialogue: 0,0:13:20.04,0:13:22.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Kubilang hancurkan batunya.
Dialogue: 0,0:13:23.51,0:13:24.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Lihat.
Dialogue: 0,0:13:45.32,0:13:47.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Inilah jurus rahasia yang mengerikan,
Dialogue: 0,0:13:48.16,0:13:50.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Totokan Ledakan!
Dialogue: 0,0:13:51.53,0:13:54.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Bagaimana? Kau ingin mempelajarinya?
Dialogue: 0,0:13:55.79,0:13:56.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Ter…
Dialogue: 0,0:13:57.37,0:14:00.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Ternyata bukan wajahmu saja\N{\c&Hffffff&}yang mengerikan, Nenek Tua.
Dialogue: 0,0:14:06.34,0:14:08.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Sepertinya tak ada yang terlupa olehku.
Dialogue: 0,0:14:10.05,0:14:12.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}{\i1}Aku mau makan apa setelah latihan?{\i0}
Dialogue: 0,0:14:12.93,0:14:14.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Kenapa bertanya begitu?
Dialogue: 0,0:14:15.02,0:14:17.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Tidak apa-apa. Aku cuma penasaran.
Dialogue: 0,0:14:17.94,0:14:19.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Begitu, ya?
Dialogue: 0,0:14:19.23,0:14:22.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Aku akan lapar sekali,\N{\c&Hffffff&}jadi aku ingin makan apa saja.
Dialogue: 0,0:14:22.86,0:14:24.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Apa yang biasanya kau makan?
Dialogue: 0,0:14:25.23,0:14:27.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Pak Tua selalu mengeluh\N{\c&Hffffff&}betapa tidak enak makanannya
Dialogue: 0,0:14:27.70,0:14:30.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}walaupun aku yang selalu disuruh memasak.
Dialogue: 0,0:14:30.41,0:14:32.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Jadi, hanya mi instan atau…
Dialogue: 0,0:14:32.74,0:14:36.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Oh, ikan kering fermentasi yang dipanggang\N{\c&Hffffff&}warga desa sekitar untuk kami.
Dialogue: 0,0:14:36.62,0:14:38.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}- Itu enak sekali.\N{\c&Hffffff&}- Ikan kering fermentasi?
Dialogue: 0,0:14:38.79,0:14:42.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Ikan isi nasi fermentasi\N{\c&Hffffff&}dan durian juga enak.
Dialogue: 0,0:14:42.17,0:14:43.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Durian…
Dialogue: 0,0:14:43.63,0:14:47.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Oh, benar. Kari yang dibuat pekemah itu.
Dialogue: 0,0:14:47.63,0:14:52.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Rasanya sangat lezat, penuh daging\N{\c&Hffffff&}dan sayuran dengan kepedasan yang pas.
Dialogue: 0,0:14:52.89,0:14:56.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Aku ingin makan kari\N{\c&Hffffff&}setelah selesai latihan.
Dialogue: 0,0:14:57.31,0:14:59.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Kari, ya?
Dialogue: 0,0:15:02.90,0:15:06.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Baiklah. Ayo kita mulai membuat karinya.
Dialogue: 0,0:15:07.07,0:15:08.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Tapi aku belum pernah membuatnya.
Dialogue: 0,0:15:15.12,0:15:17.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Kudengar apel biasanya jadi bahan rahasia.
Dialogue: 0,0:15:18.00,0:15:20.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Lalu bubuk karinya.
Dialogue: 0,0:15:21.46,0:15:23.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Tutupnya tidak bisa dibuka.
Dialogue: 0,0:15:27.92,0:15:31.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Ya sudahlah. Kutambahkan saja garam\N{\c&Hffffff&}dan merica untuk menyeimbangkan rasanya.
Dialogue: 0,0:15:34.39,0:15:36.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Baiklah. Tambahkan rempah-rempah asli dan…
Dialogue: 0,0:15:43.90,0:15:46.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Untuk bahan rahasianya,\N{\c&Hffffff&}aku akan pakai yang disukai Ranma.
Dialogue: 0,0:15:47.19,0:15:48.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Ikan kering fermentasi.
Dialogue: 0,0:15:49.15,0:15:51.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Dan sekarang…
Dialogue: 0,0:15:52.07,0:15:54.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Sedikit anggur putih, maka selesai.
Dialogue: 0,0:15:54.99,0:15:58.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Ya, sudah siap.\N{\c&Hffffff&}Aku tinggal menunggu dia kembali.
Dialogue: 0,0:16:08.17,0:16:10.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Aku lapar sekali.
Dialogue: 0,0:16:10.09,0:16:12.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Makan malam kita kari?
Dialogue: 0,0:16:12.84,0:16:14.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Kelihatannya memang kurang menarik,
Dialogue: 0,0:16:14.89,0:16:17.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}tapi aku membuat banyak,\N{\c&Hffffff&}jadi porsinya melimpah.
Dialogue: 0,0:16:18.47,0:16:19.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Ini.
Dialogue: 0,0:16:20.56,0:16:22.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}- Ini untuk Paman.\N{\c&Hffffff&}- Terima kasih.
Dialogue: 0,0:16:22.81,0:16:25.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Ini unik sekali. Aroma yang tidak biasa.
Dialogue: 0,0:16:25.69,0:16:28.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Kau bisa tahu?\N{\c&Hffffff&}Aku pakai sedikit anggur putih.
Dialogue: 0,0:16:28.23,0:16:31.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Kau senang Akane ikut dengan kita, 'kan?
Dialogue: 0,0:16:32.19,0:16:34.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Tapi aku tidak yakin dengan rasanya.
Dialogue: 0,0:16:34.15,0:16:38.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Tenang. Aku sudah kelaparan setengah mati,\N{\c&Hffffff&}pakan babi pun akan kumakan.
Dialogue: 0,0:16:38.12,0:16:39.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Ya ampun…
Dialogue: 0,0:16:39.41,0:16:41.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}- Kau bilang apa?\N{\c&Hffffff&}- Apa?
Dialogue: 0,0:16:41.33,0:16:44.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Sudahlah, pertengkaran sejoli\N{\c&Hffffff&}disimpan untuk nanti.
Dialogue: 0,0:16:44.16,0:16:45.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Kami bukan sejoli!
Dialogue: 0,0:16:45.46,0:16:47.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Mari makan dulu.
Dialogue: 0,0:16:47.25,0:16:48.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}- Selamat makan!\N{\c&Hffffff&}- Selamat makan!
Dialogue: 0,0:17:09.77,0:17:10.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Bagaimana rasanya?
Dialogue: 0,0:17:13.36,0:17:15.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Ranma, kita lanjutkan latihannya.
Dialogue: 0,0:17:15.78,0:17:16.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Baik.
Dialogue: 0,0:17:16.86,0:17:19.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}- Terima kasih makanannya!\N{\c&Hffffff&}- Hei, tunggu.
Dialogue: 0,0:17:19.32,0:17:21.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Ada apa dengan mereka?
Dialogue: 0,0:17:28.17,0:17:31.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Aneh. Apa anggur putih itu\N{\c&Hffffff&}yang merusak rasanya?
Dialogue: 0,0:17:32.46,0:17:33.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Cuka…
Dialogue: 0,0:17:33.84,0:17:37.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Sudah kubilang jangan ajak dia!
Dialogue: 0,0:17:37.22,0:17:40.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Tidak ada yang menyangka\N{\c&Hffffff&}masakannya akan seburuk itu!
Dialogue: 0,0:17:44.18,0:17:47.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Tapi kenapa reaksinya harus seperti itu?
Dialogue: 0,0:17:47.10,0:17:49.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Aku cuma melakukan kesalahan kecil\N{\c&Hffffff&}pada bumbunya.
Dialogue: 0,0:17:51.48,0:17:54.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Aku ingin makan kari\N{\c&Hffffff&}setelah selesai latihan.
Dialogue: 0,0:17:55.99,0:17:58.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Aku sudah susah payah membuatnya.
Dialogue: 0,0:18:02.53,0:18:05.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Aku sudah susah payah membuatnya!
Dialogue: 0,0:18:05.79,0:18:08.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Ranma bodoh!
Dialogue: 0,0:18:12.71,0:18:14.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Suara apa itu?
Dialogue: 0,0:18:17.63,0:18:18.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Ryoga?
Dialogue: 0,0:18:22.01,0:18:25.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Ayah akan turun gunung\N{\c&Hffffff&}dan membeli beberapa nasi kotak.
Dialogue: 0,0:18:25.64,0:18:27.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Kau urus sisanya.
Dialogue: 0,0:18:27.35,0:18:30.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}{\i1}Pak Tua sialan. Dia kabur dengan liciknya.{\i0}
Dialogue: 0,0:18:31.36,0:18:35.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}{\i1}Satu-satunya yang mau makan sesuatu{\i0}\N{\c&Hffffff&}{\i1}amat menjijikkan sampai membuat bungkam…{\i0}
Dialogue: 0,0:18:37.36,0:18:39.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Adalah aku, siapa lagi?
Dialogue: 0,0:18:43.53,0:18:44.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Ryoga?
Dialogue: 0,0:18:45.41,0:18:47.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Kau juga kemari untuk latihan?
Dialogue: 0,0:18:47.87,0:18:50.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Beberapa hari lalu,\N{\c&Hffffff&}kutunjukkan sisi menyedihkanku padamu.
Dialogue: 0,0:18:51.00,0:18:54.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Kau lapar? Makanlah ini.
Dialogue: 0,0:18:54.25,0:18:55.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Tentu.
Dialogue: 0,0:18:55.55,0:18:57.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Kira-kira, apakah sekarang lebih lezat?
Dialogue: 0,0:18:58.55,0:19:00.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Ini. Aku tak janji rasanya lezat.
Dialogue: 0,0:19:00.68,0:19:01.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Tentu pasti lezat.
Dialogue: 0,0:19:05.10,0:19:07.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}{\i1}Aku bersyukur masih hidup.{\i0}
Dialogue: 0,0:19:07.14,0:19:09.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}{\i1}Aku tak percaya{\i0}\N{\c&Hffffff&}{\i1}aku bisa memakan masakan Akane.{\i0}
Dialogue: 0,0:19:09.60,0:19:12.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}{\i1}Sekarang akulah{\i0}\N{\c&Hffffff&}{\i1}pria paling bahagia di dunia.{\i0}
Dialogue: 0,0:19:13.27,0:19:14.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Selamat makan!
Dialogue: 0,0:19:26.16,0:19:27.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Jadi, rasanya memang tidak enak?
Dialogue: 0,0:19:29.16,0:19:32.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Ini pertama kalinya\N{\c&Hffffff&}aku makan makanan seenak ini.
Dialogue: 0,0:19:33.00,0:19:34.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Benarkah?
Dialogue: 0,0:19:34.75,0:19:37.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Menambahkan durian\N{\c&Hffffff&}dan ikan fermentasi memang tepat.
Dialogue: 0,0:19:41.51,0:19:43.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Kau mau apa? Jangan makan tanpa izin.
Dialogue: 0,0:19:43.55,0:19:46.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Apa kau tidak mencicipi makananmu sendiri?
Dialogue: 0,0:19:46.26,0:19:47.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Tidak.
Dialogue: 0,0:19:47.35,0:19:49.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Cicipilah saat memasak. Aku mohon padamu.
Dialogue: 0,0:19:49.77,0:19:51.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Apa? Kau mau bilang rasanya menjijikkan?
Dialogue: 0,0:19:51.73,0:19:54.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Makanya sudah kubilang cicipi dulu…
Dialogue: 0,0:19:54.73,0:19:58.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Cukup. Aku tidak akan tinggal diam\N{\c&Hffffff&}jika kau terus bicara.
Dialogue: 0,0:19:58.73,0:20:00.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Mau bertarung, Ryoga?
Dialogue: 0,0:20:00.99,0:20:02.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Stop, Ranma.
Dialogue: 0,0:20:02.49,0:20:05.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Ryoga sangat menikmati kariku.
Dialogue: 0,0:20:05.20,0:20:06.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Perasaanku tidak terluka.
Dialogue: 0,0:20:07.70,0:20:11.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Aku pun tak mau menindas orang lemah.
Dialogue: 0,0:20:11.66,0:20:13.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Orang lemah?
Dialogue: 0,0:20:14.08,0:20:18.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Kurang ajar kau. Berani-beraninya\N{\c&Hffffff&}kau bicara begitu di depan Akane.
Dialogue: 0,0:20:18.71,0:20:19.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}{\i1}Ryoga{\i0}{\c&Hffffff&}…
Dialogue: 0,0:20:22.09,0:20:23.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Ranma!
Dialogue: 0,0:20:25.05,0:20:26.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}- Nenek Tua!\N{\c&Hffffff&}- Ryoga.
Dialogue: 0,0:20:27.60,0:20:29.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Jadi, karena itu kau di sini.
Dialogue: 0,0:20:31.10,0:20:34.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Aku sangat tersentuh\N{\c&Hffffff&}oleh perasaannya yang kuat.
Dialogue: 0,0:20:34.81,0:20:37.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Bagaimana? Mau bertarung sepekan lagi?
Dialogue: 0,0:20:37.98,0:20:38.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Apa?
Dialogue: 0,0:20:39.07,0:20:41.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Dia akan menjadi lebih kuat.
Dialogue: 0,0:20:42.36,0:20:44.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Menarik. Baiklah.
Dialogue: 0,0:20:44.61,0:20:47.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Akan kunantikan hari itu dengan sabar,\N{\c&Hffffff&}calon menantuku.
Dialogue: 0,0:20:53.54,0:20:55.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Aku akan pergi mengurus Ryoga.
Dialogue: 0,0:20:56.38,0:20:57.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Akane.
Dialogue: 0,0:20:57.67,0:21:00.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Bukankah masakanku tak enak\N{\c&Hffffff&}sampai tak bisa kau makan?
Dialogue: 0,0:21:01.55,0:21:03.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Hei, tunggu dulu, Akane!
Dialogue: 0,0:21:09.39,0:21:12.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Hei. Ayah sudah beli.
Dialogue: 0,0:21:14.60,0:21:15.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Ada apa, Ranma?
Dialogue: 0,0:21:18.02,0:21:20.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Akane bodoh…
Dialogue: 0,0:21:21.57,0:21:25.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Aku juga bisa makan\N{\c&Hffffff&}jika kupaksakan diriku sampai batasnya…
Dialogue: 0,0:21:25.86,0:21:28.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\c&Hffffff&}Ranma, hentikanlah. Ayah bisa melihat\N{\c&Hffffff&}malaikat maut menunggumu.
Dialogue: 0,0:22:56.95,0:23:01.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Terjemahan subtitle oleh Rio Wibowo\N{\c&Hffffff&}Pengawas Produksi: Ranma1/2 Project
