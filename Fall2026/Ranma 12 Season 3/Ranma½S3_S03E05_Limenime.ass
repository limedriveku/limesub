Dialogue: 0,0:00:19.85,0:00:20.81,sign,,0000,0000,0000,,{\an8}‎CAIRAN CUCI FOTO
Dialogue: 0,0:01:14.11,0:01:17.99,sign,,0000,0000,0000,,‎RANMA1/2
Dialogue: 0,0:02:42.03,0:02:44.49,sign,,0000,0000,0000,,{\an8}‎RUANG KELAS MEMASAK
Dialogue: 0,0:02:44.49,0:02:48.62,sign,,0000,0000,0000,,{\an8}‎KUE MAWAR HITAM
Dialogue: 0,0:03:34.75,0:03:36.46,sign,,0000,0000,0000,,‎KODACHI KUNO\N‎HADIR - PULANG LEBIH AWAL
Dialogue: 0,0:09:38.20,0:09:40.12,sign,,0000,0000,0000,,‎UKS
Dialogue: 0,0:10:21.53,0:10:23.87,sign,,0000,0000,0000,,‎SEMUA ORANG BISA MENJADI KOKI
Dialogue: 0,0:10:25.24,0:10:27.54,sign,,0000,0000,0000,,‎PERGURUAN MEMASAK
Dialogue: 0,0:10:30.63,0:10:33.13,sign,,0000,0000,0000,,{\an8}‎ALIRAN SILAT SEGALA JURUS\N‎TENDO
Dialogue: 0,0:11:09.16,0:11:10.33,sign,,0000,0000,0000,,‎SUSU - GULA - MENTEGA - TEPUNG TERIGU
Dialogue: 0,0:11:19.55,0:11:20.72,sign,,0000,0000,0000,,‎BERGULING DALAM PENDERITAAN
Dialogue: 0,0:11:48.33,0:11:50.20,sign,,0000,0000,0000,,‎PEWAKTU DAPUR
Dialogue: 0,0:11:58.25,0:11:59.63,sign,,0000,0000,0000,,‎KEGAGALAN ADALAH AWAL KEBERHASILAN
Dialogue: 0,0:13:41.32,0:13:43.07,sign,,0000,0000,0000,,{\an8}‎KENANGAN YANG MAKIN INDAH SEIRING WAKTU
Dialogue: 0,0:14:40.96,0:14:41.88,sign,,0000,0000,0000,,‎ANDAI KLISE FILMNYA TAK ADA
Dialogue: 0,0:14:42.71,0:14:43.67,sign,,0000,0000,0000,,‎SUMBER MASALAH
Dialogue: 0,0:16:06.54,0:16:10.51,sign,,0000,0000,0000,,‎KERJA SAMPINGAN - MENGANGGUR
Dialogue: 0,0:17:29.92,0:17:33.17,sign,,0000,0000,0000,,‎KU
Dialogue: 0,0:17:34.59,0:17:35.84,sign,,0000,0000,0000,,‎AKU MENYIAPKAN KURSI KHUSUS UNTUKMU
Dialogue: 0,0:18:07.75,0:18:09.25,sign,,0000,0000,0000,,{\an8}‎SELAMAT DATANG
Dialogue: 0,0:18:34.82,0:18:35.98,sign,,0000,0000,0000,,‎MIDORIGAME
Dialogue: 0,0:18:57.84,0:18:59.76,sign,,0000,0000,0000,,‎MIDORIGAME
Dialogue: 0,0:00:26.19,0:00:28.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baiklah, mari kita mulai.
Dialogue: 0,0:00:32.53,0:00:36.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Rendam dengan perlahan\N‎ke dalam cairan cuci foto...
Dialogue: 0,0:00:42.41,0:00:44.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya, bagus.
Dialogue: 0,0:00:47.79,0:00:50.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hasilnya lebih baik dari bayanganku.
Dialogue: 0,0:00:59.35,0:01:03.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ini adalah klise film\N‎dari semua foto Akane yang kuambil.
Dialogue: 0,0:01:04.52,0:01:06.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Selama aku memiliki ini,
Dialogue: 0,0:01:06.39,0:01:10.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎aku bisa cetak ulang sebanyak-banyaknya\N‎kapan pun aku mau.
Dialogue: 0,0:02:48.62,0:02:49.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ini tak akan kemanisan?
Dialogue: 0,0:02:56.34,0:02:58.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Walau aku sudah membuat semua kukis ini,
Dialogue: 0,0:02:58.46,0:03:00.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎aku tidak punya pacar untuk kuberikan.
Dialogue: 0,0:03:03.47,0:03:06.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Walau aku sudah memanggangnya,\N‎Ranma-ku tidak...{\i0}
Dialogue: 0,0:03:10.77,0:03:12.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bu Guru.
Dialogue: 0,0:03:12.15,0:03:14.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya, Kodachi?
Dialogue: 0,0:03:14.11,0:03:17.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku baru ingat ada urusan mendadak\N‎yang harus kuurus.
Dialogue: 0,0:03:19.99,0:03:22.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jadi, aku akan pulang lebih awal.
Dialogue: 0,0:03:24.12,0:03:25.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ini badai mawar hitam.
Dialogue: 0,0:03:32.08,0:03:34.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kodachi Kuno. Pulang lebih awal.
Dialogue: 0,0:03:47.47,0:03:50.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tunggulah aku, Ranma-ku!
Dialogue: 0,0:04:00.61,0:04:05.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Akane. Dia juga terlihat luar biasa\N‎saat membuat kue.
Dialogue: 0,0:04:06.49,0:04:08.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa yang kau foto, Hikaru?
Dialogue: 0,0:04:08.91,0:04:12.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hai, Ranma. Kau sedang apa?
Dialogue: 0,0:04:18.67,0:04:21.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau masih belum kapok juga, ya?
Dialogue: 0,0:04:21.46,0:04:24.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa kau tidak bosan\N‎memotret Akane terus-menerus?
Dialogue: 0,0:04:24.76,0:04:28.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bosan? Tidak mungkin. Akane adalah...
Dialogue: 0,0:04:28.72,0:04:31.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Aku sita ini.\N‎- Apa yang kau lakukan...
Dialogue: 0,0:04:32.35,0:04:35.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Berhentilah berpikiran aneh-aneh, ya?
Dialogue: 0,0:04:37.52,0:04:40.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan remehkan aku, Ranma.
Dialogue: 0,0:04:40.32,0:04:43.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku punya banyak cadangan rol film, tahu.
Dialogue: 0,0:04:47.49,0:04:49.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hasilnya bagus sekali.
Dialogue: 0,0:04:50.08,0:04:51.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kukis.
Dialogue: 0,0:04:51.16,0:04:53.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Mau kucicipi dulu?\N‎- Aku tidak akan memberimu.
Dialogue: 0,0:04:55.08,0:04:56.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kebahagiaan seorang wanita...
Dialogue: 0,0:04:59.59,0:05:04.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎adalah memasak\N‎untuk Tatewaki Kuno tercinta.
Dialogue: 0,0:05:05.93,0:05:07.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Akane Tendo.
Dialogue: 0,0:05:07.89,0:05:09.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku akan membuatmu bahagia.
Dialogue: 0,0:05:09.93,0:05:12.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kenapa kau tak jujur saja\N‎bilang kalau kau mau?
Dialogue: 0,0:05:14.23,0:05:16.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu ide yang buruk, Tatewaki.
Dialogue: 0,0:05:16.81,0:05:18.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Rasanya bisa membuatmu pingsan.
Dialogue: 0,0:05:19.77,0:05:21.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Katakan enak atau tidak
Dialogue: 0,0:05:21.90,0:05:24.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎setelah kau mencobanya!
Dialogue: 0,0:05:32.12,0:05:33.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa itu?
Dialogue: 0,0:05:33.20,0:05:35.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Menggemaskan, bukan? Ini kukis hewan.
Dialogue: 0,0:05:36.71,0:05:39.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hewan? Apa itu gurita?
Dialogue: 0,0:05:40.96,0:05:42.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau tidak sopan sekali. Ini penguin.
Dialogue: 0,0:05:44.30,0:05:46.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kepiting?
Dialogue: 0,0:05:46.01,0:05:47.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ini singa.
Dialogue: 0,0:05:48.68,0:05:51.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Aku tahu yang ini. Ini kutu air.\N‎- Ini kelinci!
Dialogue: 0,0:05:51.39,0:05:54.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Berhentilah mengagumi bentuknya
Dialogue: 0,0:05:54.10,0:05:57.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎dan makan saja langsung!
Dialogue: 0,0:05:57.31,0:05:59.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tunggu dulu.
Dialogue: 0,0:06:01.61,0:06:02.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku belum siap.
Dialogue: 0,0:06:19.50,0:06:22.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sungguh kukis yang mencurigakan.
Dialogue: 0,0:06:22.42,0:06:23.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau...
Dialogue: 0,0:06:25.76,0:06:28.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Lama tak jumpa, Ranma-ku.
Dialogue: 0,0:06:30.01,0:06:31.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kodachi, si Mawar Hitam.
Dialogue: 0,0:06:33.05,0:06:34.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu adik perempuanku yang mesum.
Dialogue: 0,0:06:36.39,0:06:38.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ranma-ku.
Dialogue: 0,0:06:38.89,0:06:40.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ini.
Dialogue: 0,0:06:49.07,0:06:51.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Aku tahu yang ini. Ini bintang.\N‎- Ini bintang laut.
Dialogue: 0,0:06:51.70,0:06:53.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kembalikan kukisku.
Dialogue: 0,0:06:54.83,0:06:59.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Benda ini tidak layak\N‎untuk lidah Ranma-ku.
Dialogue: 0,0:07:00.58,0:07:01.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei.
Dialogue: 0,0:07:05.21,0:07:06.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ini salahmu!
Dialogue: 0,0:07:06.96,0:07:08.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Karena tak langsung kau makan.
Dialogue: 0,0:07:10.63,0:07:13.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei, kenapa jadi aku...
Dialogue: 0,0:07:16.14,0:07:18.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku sudah mati-matian memanggangnya.
Dialogue: 0,0:07:19.85,0:07:21.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dasar bodoh!
Dialogue: 0,0:07:22.94,0:07:25.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ini bukan salahku, tahu.
Dialogue: 0,0:07:26.27,0:07:27.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu dia.
Dialogue: 0,0:07:29.19,0:07:33.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ranma-ku, aku tahu kau akan menyusulku.
Dialogue: 0,0:07:33.07,0:07:36.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku datang untuk kukisnya,\N‎bukan untuk kau.
Dialogue: 0,0:07:38.16,0:07:39.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan bohong.
Dialogue: 0,0:07:39.58,0:07:41.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tidak bohong.
Dialogue: 0,0:07:42.87,0:07:43.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei, Ranma.
Dialogue: 0,0:07:44.92,0:07:46.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Berhenti!
Dialogue: 0,0:07:46.21,0:07:47.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan lari!
Dialogue: 0,0:07:47.59,0:07:50.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Nona-Nona, ayo kita main lagi besok.
Dialogue: 0,0:07:50.80,0:07:52.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan berani-berani kembali ke sini!
Dialogue: 0,0:07:57.60,0:07:58.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sialan.
Dialogue: 0,0:08:01.56,0:08:05.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku sangat bahagia, Ranma-ku.
Dialogue: 0,0:08:09.11,0:08:10.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ranma!
Dialogue: 0,0:08:12.61,0:08:13.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ranma-ku,
Dialogue: 0,0:08:14.91,0:08:17.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎mari kita lanjutkan ini lain kali.
Dialogue: 0,0:08:21.33,0:08:22.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Itu seram sekali.{\i0}
Dialogue: 0,0:08:24.04,0:08:25.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu dia.
Dialogue: 0,0:08:25.96,0:08:27.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kukisku.
Dialogue: 0,0:08:29.63,0:08:32.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ranma, aku ambil kukis Kodachi.
Dialogue: 0,0:08:32.42,0:08:33.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mari kita cicipi.
Dialogue: 0,0:08:35.13,0:08:36.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Rasanya enak.
Dialogue: 0,0:08:36.22,0:08:39.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baik, cobalah punyaku.
Dialogue: 0,0:08:39.22,0:08:41.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Tidak, terima kasih.\N‎- Kenapa?
Dialogue: 0,0:08:42.18,0:08:44.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tidak selera makan.
Dialogue: 0,0:08:45.06,0:08:47.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Karena guncangan yang baru saja kualami.{\i0}
Dialogue: 0,0:08:51.19,0:08:53.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Coba kulihat. Aku akan...
Dialogue: 0,0:09:01.33,0:09:04.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Rasanya tidak enak... sangat tidak enak.
Dialogue: 0,0:09:04.75,0:09:07.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa? Jahat sekali.
Dialogue: 0,0:09:11.38,0:09:14.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sudah kuduga. Dia mencampurkan\N‎obat tidur ke dalamnya.
Dialogue: 0,0:09:42.87,0:09:46.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Astaga. Adikmu selalu saja\N‎membuat masalah bagi orang lain.
Dialogue: 0,0:09:46.91,0:09:50.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya, aku tidak bisa membantahnya.
Dialogue: 0,0:09:50.08,0:09:51.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tidak ada...{\i0}
Dialogue: 0,0:09:52.38,0:09:54.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎yang melihat kejadiannya, 'kan?{\i0}
Dialogue: 0,0:09:58.59,0:10:02.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku diam-diam memotret Ranma\N‎yang sedang berselingkuh.
Dialogue: 0,0:10:02.51,0:10:04.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa yang harus kulakukan?
Dialogue: 0,0:10:04.18,0:10:06.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mohon berikan rol film itu kepadaku.
Dialogue: 0,0:10:13.48,0:10:15.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dasar Ranma bodoh.
Dialogue: 0,0:10:15.15,0:10:18.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia sudah memutuskan kukisnya menjijikkan\N‎dan bahkan tidak mencoba mencicipinya.
Dialogue: 0,0:10:19.78,0:10:21.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dasar Ranma bodoh.
Dialogue: 0,0:10:33.13,0:10:35.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bagaimana cara memanggang kukis\N‎yang lezat?
Dialogue: 0,0:10:36.09,0:10:40.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya. Apa Kak Kasumi mau mengajariku?
Dialogue: 0,0:10:40.34,0:10:43.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya ampun,\N‎ternyata kau tertarik belajar memasak.
Dialogue: 0,0:10:44.35,0:10:46.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya, begitulah.
Dialogue: 0,0:10:46.56,0:10:49.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi kenapa mendadak sekali?
Dialogue: 0,0:10:50.06,0:10:51.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apakah untuk Ranma?
Dialogue: 0,0:10:53.06,0:10:54.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bukan.
Dialogue: 0,0:10:56.32,0:10:57.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku cuma
Dialogue: 0,0:10:57.99,0:11:01.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎ingin mendengar dia bilang\N‎bahwa rasanya enak.
Dialogue: 0,0:11:02.03,0:11:05.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bagaimanapun, aku tak mau kalah\N‎dari Ranma.
Dialogue: 0,0:11:07.04,0:11:08.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baiklah.
Dialogue: 0,0:11:11.67,0:11:15.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku akan mengajarimu\N‎cara membuat kukis yang super lezat.
Dialogue: 0,0:11:15.84,0:11:16.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya.
Dialogue: 0,0:11:17.59,0:11:19.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dua ratus gram gula.
Dialogue: 0,0:11:20.72,0:11:22.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Akane, itu garam.
Dialogue: 0,0:11:23.34,0:11:25.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sedikit esens vanila.
Dialogue: 0,0:11:25.72,0:11:27.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Akane, itu minyak cabai.
Dialogue: 0,0:11:53.79,0:11:55.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sudah matang!
Dialogue: 0,0:11:55.92,0:11:58.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya, warnanya terlihat bagus.
Dialogue: 0,0:11:59.63,0:12:00.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau sudah bekerja keras.
Dialogue: 0,0:12:04.89,0:12:06.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ranma, ayo kita selesaikan ini!
Dialogue: 0,0:12:06.68,0:12:09.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Makanlah dengan penuh rasa syukur, Ranma.
Dialogue: 0,0:12:10.47,0:12:11.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Lalu kau, Pak Tua?
Dialogue: 0,0:12:11.98,0:12:14.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku sedang kenyang sekali sekarang.
Dialogue: 0,0:12:16.86,0:12:18.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Simbol mawar hitam?
Dialogue: 0,0:12:18.32,0:12:19.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kodachi?
Dialogue: 0,0:12:20.48,0:12:23.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku menunggumu dengan masakan rumahan.{\i0}
Dialogue: 0,0:12:23.74,0:12:25.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Mohon segeralah datang.{\i0}
Dialogue: 0,0:12:25.82,0:12:27.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Masakan rumahan?
Dialogue: 0,0:12:28.08,0:12:30.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Gigih sekali wanita ini.
Dialogue: 0,0:12:30.74,0:12:32.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Memangnya kau tidak?
Dialogue: 0,0:12:37.38,0:12:42.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎NB: Kulampirkan foto kita berdua\N‎dari waktu itu.{\i0}
Dialogue: 0,0:12:46.59,0:12:50.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku sangat bahagia sampai ingin\N‎menyebarkannya ke seluruh kota.{\i0}
Dialogue: 0,0:12:54.94,0:12:56.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei!
Dialogue: 0,0:12:59.44,0:13:01.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dasar pengecut.\N‎Kau akan kabur tanpa memakannya?
Dialogue: 0,0:13:02.44,0:13:04.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sekarang bukan waktunya untuk itu!
Dialogue: 0,0:13:08.70,0:13:13.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sialan. Mana mungkin kubiarkan\N‎kau menyebarkan foto itu ke seluruh kota.
Dialogue: 0,0:13:13.12,0:13:16.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tunggu aku, Kodachi!
Dialogue: 0,0:13:24.13,0:13:27.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ranma-ku, cepatlah datang.
Dialogue: 0,0:13:28.55,0:13:30.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Menunggumu seorang diri seperti ini, aku...
Dialogue: 0,0:13:35.56,0:13:36.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kodachi.
Dialogue: 0,0:13:37.35,0:13:38.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ranma-ku.
Dialogue: 0,0:13:45.32,0:13:47.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku mengenang lagi kebahagiaan\N‎yang kurasakan saat itu.
Dialogue: 0,0:13:48.45,0:13:52.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku akan membagikan kebahagiaan ini\N‎kepada semua orang!
Dialogue: 0,0:13:59.75,0:14:01.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ini!
Dialogue: 0,0:14:11.89,0:14:15.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ranma-ku. Kau datang.
Dialogue: 0,0:14:15.18,0:14:17.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu karena kau mengancamku.
Dialogue: 0,0:14:17.23,0:14:20.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Berani-beraninya kau perbanyak foto ini?\N‎Aku akan memusnahkan buktinya.
Dialogue: 0,0:14:24.78,0:14:27.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Astaga. Sepertinya kau suka fotonya.
Dialogue: 0,0:14:28.99,0:14:32.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku masih punya banyak sekali.\N‎Makanlah sampai kenyang.
Dialogue: 0,0:14:32.45,0:14:33.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sialan.{\i0}
Dialogue: 0,0:14:34.33,0:14:37.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku tak bisa makan sebanyak itu.{\i0}
Dialogue: 0,0:14:37.20,0:14:39.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku harus hancurkan sumbernya.{\i0}
Dialogue: 0,0:14:39.87,0:14:40.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Oh, ya.
Dialogue: 0,0:14:45.25,0:14:47.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku ingin memakan klise dari foto ini.
Dialogue: 0,0:14:48.72,0:14:52.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bisa kau buatkan untukku?\N‎Hidangan yang berisi klise foto ini.
Dialogue: 0,0:14:58.98,0:15:03.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tentu. Dengan senang hati\N‎akan kubuatkan demi Ranma-ku.
Dialogue: 0,0:15:12.57,0:15:15.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Lewat sini, Ranma-ku.
Dialogue: 0,0:15:16.62,0:15:18.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku masuk.
Dialogue: 0,0:15:22.04,0:15:24.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei, Tatewaki.
Dialogue: 0,0:15:24.42,0:15:26.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kenapa kau ada di rumahku?
Dialogue: 0,0:15:26.55,0:15:28.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku yang mengundangnya.
Dialogue: 0,0:15:30.47,0:15:31.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jadi, dengan kata lain...
Dialogue: 0,0:15:31.84,0:15:35.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎kau sudah melepaskan cintamu\N‎pada Akane Tendo-ku.
Dialogue: 0,0:15:35.76,0:15:37.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Siapa yang bilang\N‎aku mau merebutnya darimu?
Dialogue: 0,0:15:40.27,0:15:41.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Akhirnya,
Dialogue: 0,0:15:42.06,0:15:44.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎penghalangnya sudah tak ada!
Dialogue: 0,0:15:47.23,0:15:49.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tatewaki-senpai!
Dialogue: 0,0:15:49.07,0:15:50.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Akane!
Dialogue: 0,0:15:51.65,0:15:53.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau nakal.
Dialogue: 0,0:15:53.03,0:15:56.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya ampun, kau ini nakal sekali.
Dialogue: 0,0:15:56.24,0:15:57.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau nakal.
Dialogue: 0,0:15:59.54,0:16:00.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau nakal.
Dialogue: 0,0:16:02.58,0:16:04.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kalian juga harus berusaha keras
Dialogue: 0,0:16:04.12,0:16:06.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎membangun keluarga\N‎yang tidak bahagia bersama.
Dialogue: 0,0:16:11.01,0:16:12.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima kasih, Kakak.
Dialogue: 0,0:16:14.55,0:16:16.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei, kau!
Dialogue: 0,0:16:17.10,0:16:20.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku datang cuma untuk makan\N‎masakan rumahan Kodachi.
Dialogue: 0,0:16:20.10,0:16:22.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Makan masakan rumahan Kodachi, katamu?
Dialogue: 0,0:16:24.10,0:16:27.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ranma, apa dia mengancammu\N‎atau semacamnya?
Dialogue: 0,0:16:27.90,0:16:29.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Akane. Kapan kau tiba di sini?
Dialogue: 0,0:16:30.73,0:16:32.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Akane Tendo.
Dialogue: 0,0:16:32.32,0:16:35.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa kau langsung datang\N‎untuk meminta jadi pacarku?
Dialogue: 0,0:16:35.03,0:16:37.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Siapa yang minta jadi pacarmu?
Dialogue: 0,0:16:40.54,0:16:43.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sudah terlambat untuk muncul sekarang.
Dialogue: 0,0:16:43.91,0:16:45.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa?
Dialogue: 0,0:16:45.12,0:16:48.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ranma-ku sudah terpikat\N‎oleh masakan rumahanku.
Dialogue: 0,0:16:50.59,0:16:52.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Ini!\N‎- Tidak!
Dialogue: 0,0:16:57.51,0:16:58.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apakah lezat?
Dialogue: 0,0:17:01.14,0:17:04.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Ranma pasti sedang diancam.{\i0}
Dialogue: 0,0:17:05.48,0:17:07.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau pulang saja, Akane.
Dialogue: 0,0:17:07.73,0:17:09.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Mana mungkin aku pulang begitu saja.{\i0}
Dialogue: 0,0:17:10.61,0:17:13.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku ingin melihat kamar Tatewaki-senpai.
Dialogue: 0,0:17:13.24,0:17:16.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kamarku? Baiklah,\N‎akan kuperlihatkan padamu.
Dialogue: 0,0:17:18.12,0:17:19.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei!
Dialogue: 0,0:17:19.91,0:17:23.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ranma-ku, hidangan utamanya\N‎belum disajikan.
Dialogue: 0,0:17:24.16,0:17:27.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku akan menunggu di dapur,
Dialogue: 0,0:17:27.33,0:17:29.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎karena itu tolong ambilkan\N‎bahannya untukku.
Dialogue: 0,0:17:33.17,0:17:34.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Silakan duduk di sini.
Dialogue: 0,0:17:37.47,0:17:38.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima kasih.
Dialogue: 0,0:17:48.10,0:17:51.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa mungkin itu untukku?
Dialogue: 0,0:17:51.69,0:17:53.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bukan. Sama sekali bukan.
Dialogue: 0,0:17:54.23,0:17:57.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan malu-malu begitu. Ayo.
Dialogue: 0,0:17:58.20,0:17:59.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kubilang bukan.
Dialogue: 0,0:18:00.87,0:18:03.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kalau begitu, aku akan ambilkan teh.
Dialogue: 0,0:18:04.79,0:18:07.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Kau tunggu saja di sini, Akane.
Dialogue: 0,0:18:10.08,0:18:11.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya ampun.
Dialogue: 0,0:18:11.96,0:18:16.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi apa rahasia Ranma\N‎yang dipegang olehnya?
Dialogue: 0,0:18:17.84,0:18:21.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Untuk saat ini, kurasa aku akan melihat\N‎apakah bisa menemukan petunjuk.
Dialogue: 0,0:18:26.43,0:18:27.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Bahan?{\i0}
Dialogue: 0,0:18:27.52,0:18:31.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Ya. Klise foto yang kau inginkan...{\i0}
Dialogue: 0,0:18:31.06,0:18:34.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎ada di dalam kalung Midorigame\N‎yang tinggal di kolam.{\i0}
Dialogue: 0,0:18:35.98,0:18:37.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Beruntungnya aku.{\i0}
Dialogue: 0,0:18:39.32,0:18:41.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Selama aku memegang klise foto itu...
Dialogue: 0,0:18:42.20,0:18:45.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎aku bisa mengucapkan selamat tinggal\N‎pada Kodachi!
Dialogue: 0,0:18:56.38,0:18:57.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Buaya?
Dialogue: 0,0:19:03.55,0:19:06.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Midorigame si buaya sedang mengamuk.
Dialogue: 0,0:19:07.89,0:19:09.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ranma-ku pasti bisa mengalahkannya.
Dialogue: 0,0:19:14.06,0:19:18.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sialan. Kenapa namanya Midorigame?
Dialogue: 0,0:19:42.51,0:19:44.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Klise fotonya ada di dalam kalung ini.
Dialogue: 0,0:19:48.93,0:19:50.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dapat!
Dialogue: 0,0:19:56.15,0:19:57.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku lupa.
Dialogue: 0,0:19:57.73,0:20:02.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kalung itu akan alirkan sengatan listrik\N‎tegangan tinggi jika dilepas paksa.
Dialogue: 0,0:20:04.74,0:20:05.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ranma-ku.
Dialogue: 0,0:20:09.75,0:20:11.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu si Gadis Berkepang.
Dialogue: 0,0:20:13.79,0:20:15.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa kau datang untuk menemuiku?
Dialogue: 0,0:20:15.79,0:20:16.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak...
Dialogue: 0,0:20:17.54,0:20:19.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Di mana Ranma-ku?
Dialogue: 0,0:20:19.46,0:20:21.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ranma-ku!
Dialogue: 0,0:20:32.35,0:20:33.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Klise fotonya!
Dialogue: 0,0:20:35.27,0:20:38.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau sudah sadar, Gadis Berkepang?
Dialogue: 0,0:20:39.52,0:20:42.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dengan senang hati kuterima hadiahmu.
Dialogue: 0,0:20:46.16,0:20:47.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Ini tampak cukup bergaya.
Dialogue: 0,0:20:50.16,0:20:52.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dasar bajingan...
Dialogue: 0,0:20:52.83,0:20:54.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Kembalikan itu!
Dialogue: 0,0:21:10.56,0:21:12.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sungguh cinta yang menyengat.
Dialogue: 0,0:21:12.68,0:21:13.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei...
Dialogue: 0,0:21:15.31,0:21:17.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sialan!
Dialogue: 0,0:21:20.19,0:21:23.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak akan menyerah!
Dialogue: 0,0:21:30.28,0:21:31.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hore.
Dialogue: 0,0:22:57.04,0:23:02.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Terjemahan subtitle oleh Rio Wibowo\N‎Pengawas Produksi: Ranma1/2 Project
