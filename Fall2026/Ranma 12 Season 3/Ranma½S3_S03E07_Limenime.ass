Dialogue: 0,0:01:29.96,0:01:33.92,sign,,0000,0000,0000,,‎RANMA1/2
Dialogue: 0,0:03:02.01,0:03:04.64,sign,,0000,0000,0000,,{\an8}‎CARI MATA AIR LAKI-LAKI JEPANG
Dialogue: 0,0:06:06.40,0:06:07.45,sign,,0000,0000,0000,,‎MATA AIR LELAKI TENGGELAM
Dialogue: 0,0:00:13.26,0:00:15.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Akane, aku sudah kembali.{\i0}
Dialogue: 0,0:00:16.09,0:00:18.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Adalah hal yang ingin kukatakan...
Dialogue: 0,0:00:19.93,0:00:22.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎tapi aku harus segera berangkat.
Dialogue: 0,0:00:24.02,0:00:26.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mohon jangan tanya.\N‎Aku tak bisa beri tahu alasannya.
Dialogue: 0,0:00:27.19,0:00:30.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Namun, aku bisa memberitahumu\N‎satu hal ini.
Dialogue: 0,0:00:31.78,0:00:35.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku akan kembali sebagai pria sejati\N‎saat berikutnya kita bertemu.
Dialogue: 0,0:00:36.07,0:00:37.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jadi, kumohon.
Dialogue: 0,0:00:37.37,0:00:41.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ber... Ber... Ber...
Dialogue: 0,0:00:44.12,0:00:46.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak bisa katakan! Aku malu mengatakan,
Dialogue: 0,0:00:46.33,0:00:49.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎"Berkencanlah denganku!"
Dialogue: 0,0:00:49.00,0:00:52.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei! Berhenti kau, Kakek Mesum!
Dialogue: 0,0:00:52.84,0:00:54.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mataku berpesta pora, sangat puas!
Dialogue: 0,0:00:55.59,0:00:56.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Siapa pun, tangkap dia!
Dialogue: 0,0:01:04.06,0:01:07.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sial. Dia lincah sekali\N‎untuk ukuran kakek-kakek.
Dialogue: 0,0:01:07.40,0:01:09.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia selalu datang ke sekolah\N‎setiap hari tanpa absen.
Dialogue: 0,0:01:09.98,0:01:12.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kita tak bisa terus mengejarnya\N‎setelah dia melecehkan kita.
Dialogue: 0,0:01:12.98,0:01:14.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa kau punya rencana, Akane?
Dialogue: 0,0:01:14.82,0:01:15.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Benar.
Dialogue: 0,0:01:16.49,0:01:17.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bagaimana jika begini?
Dialogue: 0,0:01:17.70,0:01:20.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bukankah besok kita ada kelas olahraga?
Dialogue: 0,0:01:20.62,0:01:21.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jadi, kita akan...
Dialogue: 0,0:01:23.20,0:01:26.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ryoga. Sedang apa kau di bawah sana?
Dialogue: 0,0:01:26.92,0:01:27.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei.
Dialogue: 0,0:02:59.05,0:03:02.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jadi, kau mau bepergian lagi, Ryoga?
Dialogue: 0,0:03:04.64,0:03:06.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Ya. Aku tak tahu\N‎kapan bertemu kau lagi.
Dialogue: 0,0:03:07.06,0:03:10.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kenapa kau tidak menemui Ranma saja?\N‎Bukankah sudah cukup lama?
Dialogue: 0,0:03:10.35,0:03:12.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tidak mau melihat wajahnya.
Dialogue: 0,0:03:12.15,0:03:13.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Begitu, ya?
Dialogue: 0,0:03:15.57,0:03:19.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi kalian berdua\N‎sebenarnya cukup akrab, 'kan?
Dialogue: 0,0:03:19.74,0:03:22.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Seperti kata pepatah,\N‎makin sering bertengkar...
Dialogue: 0,0:03:24.20,0:03:25.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yang lebih penting lagi, Akane...
Dialogue: 0,0:03:34.29,0:03:36.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Jadi, itu...\N‎- Ya?
Dialogue: 0,0:03:37.42,0:03:39.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Saat aku kembali, mohon...
Dialogue: 0,0:03:40.59,0:03:41.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa?
Dialogue: 0,0:03:41.88,0:03:44.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ber... Ber... Ber...
Dialogue: 0,0:03:44.89,0:03:46.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bersedialah menerima ini.
Dialogue: 0,0:03:48.31,0:03:50.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima kasih selalu belikan suvenir.
Dialogue: 0,0:03:50.10,0:03:52.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau benar-benar orang yang baik.
Dialogue: 0,0:03:54.85,0:03:57.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baiklah, sampai jumpa lagi.
Dialogue: 0,0:04:00.40,0:04:02.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sialan!
Dialogue: 0,0:04:02.78,0:04:03.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ryoga.
Dialogue: 0,0:04:04.99,0:04:06.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Akane?\N‎- Akan kuberikan
Dialogue: 0,0:04:06.28,0:04:07.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎ciuman perpisahan.
Dialogue: 0,0:04:10.29,0:04:12.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi, Akane,
Dialogue: 0,0:04:12.62,0:04:16.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎kita bahkan belum bergandengan tangan...
Dialogue: 0,0:04:16.42,0:04:19.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku belum mempersiapkan diri untuk ini...
Dialogue: 0,0:04:19.46,0:04:20.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kalau begitu lupakan saja.
Dialogue: 0,0:04:25.18,0:04:27.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dasar lelaki kasar.
Dialogue: 0,0:04:27.01,0:04:29.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Padahal sudah lama sekali\N‎kita tak bertemu.
Dialogue: 0,0:04:29.39,0:04:33.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Diam kau. Berani-beraninya\N‎kau mempermainkan hati pria muda.
Dialogue: 0,0:04:33.64,0:04:35.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau marah kenapa, P-chan?
Dialogue: 0,0:04:39.98,0:04:42.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sayang sekali, Ranma.
Dialogue: 0,0:04:42.11,0:04:45.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sebentar lagi kau akan ucapkan\N‎selamat tinggal kepada P-chan.
Dialogue: 0,0:04:47.03,0:04:49.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dan inilah alasannya.
Dialogue: 0,0:04:50.24,0:04:51.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Peta macam apa ini?
Dialogue: 0,0:04:52.45,0:04:53.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Peta harta karun?
Dialogue: 0,0:04:54.33,0:04:56.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dasar bodoh. Kembalikan!
Dialogue: 0,0:04:57.04,0:04:58.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau...
Dialogue: 0,0:05:03.80,0:05:04.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Celaka.
Dialogue: 0,0:05:06.47,0:05:10.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mata Air Laki-Laki Jepang!
Dialogue: 0,0:05:16.98,0:05:18.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ini Mata Air Laki-Laki Jepang?
Dialogue: 0,0:05:22.28,0:05:23.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dahulu kala,{\i0}
Dialogue: 0,0:05:23.86,0:05:29.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎di Provinsi Musashi, para rubah membuat\N‎orang jadi gila dengan kejahilannya.{\i0}
Dialogue: 0,0:05:29.74,0:05:33.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Suatu hari, seorang biksu tinggi\N‎yang berkunjung dari Tiongkok{\i0}
Dialogue: 0,0:05:33.54,0:05:38.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎mengetukkan tongkatnya ke tanah\N‎dan memancarlah sebuah mata air.{\i0}
Dialogue: 0,0:05:39.25,0:05:42.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Semua rubah yang mandi di mata air ini{\i0}
Dialogue: 0,0:05:42.17,0:05:46.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎tiba-tiba berubah menjadi manusia pria.{\i0}
Dialogue: 0,0:05:48.05,0:05:52.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dan berkat itu, tak ada lagi\N‎rubah jahil yang tersisa.{\i0}
Dialogue: 0,0:05:52.89,0:05:56.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Namun, orang-orang malah makin menderita.{\i0}
Dialogue: 0,0:05:57.94,0:06:02.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu pasti Mata Air Lelaki Tenggelam.
Dialogue: 0,0:06:03.36,0:06:06.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Jika aku berendam di mata air itu,\N‎aku terbebas dari kutukan ini.{\i0}
Dialogue: 0,0:06:08.03,0:06:09.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dan tetap menjadi pria selamanya.{\i0}
Dialogue: 0,0:06:12.62,0:06:14.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Jadi, itu alasannya.{\i0}
Dialogue: 0,0:06:14.87,0:06:16.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku akan pergi ke sana.
Dialogue: 0,0:06:17.87,0:06:20.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tunggu dulu, Ryoga.
Dialogue: 0,0:06:20.92,0:06:23.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bekerja sama? Jangan bercanda.
Dialogue: 0,0:06:23.29,0:06:26.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sudah kubilang,\N‎aku akan mengantarmu ke sana.
Dialogue: 0,0:06:26.01,0:06:28.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak butuh bantuanmu.
Dialogue: 0,0:06:28.17,0:06:30.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku punya petanya.
Dialogue: 0,0:06:30.38,0:06:33.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Untuk babi buta arah sepertimu,\N‎peta itu tak ada gunanya.
Dialogue: 0,0:06:34.31,0:06:38.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Membayangkan aku tak akan lagi\N‎dipanggil babi
Dialogue: 0,0:06:38.06,0:06:39.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎membuatku sedih.
Dialogue: 0,0:06:43.40,0:06:46.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei, itu jalan buntu.
Dialogue: 0,0:06:48.36,0:06:51.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jika aku terus berjalan,\N‎pada akhirnya aku akan tiba di sana.
Dialogue: 0,0:06:51.36,0:06:54.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mata Air Laki-Laki Jepang\N‎sudah menungguku.
Dialogue: 0,0:06:55.83,0:06:58.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ayolah. Biarkan aku melihatnya.
Dialogue: 0,0:06:59.33,0:07:01.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jadi, hanya aku\N‎yang akan hapus kutukan ini...
Dialogue: 0,0:07:01.67,0:07:02.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ke sebelah sini.
Dialogue: 0,0:07:03.46,0:07:06.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Si bodoh itu\N‎benar-benar ke arah yang salah.
Dialogue: 0,0:07:06.75,0:07:08.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dasar bajingan! Kembalikan itu!
Dialogue: 0,0:07:10.34,0:07:12.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Berdiri. Beri hormat.
Dialogue: 0,0:07:12.72,0:07:15.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Akhirnya, kelas kita berikutnya\N‎adalah olahraga.
Dialogue: 0,0:07:15.05,0:07:17.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kakek mesum itu pasti akan datang\N‎dan melecehkan kita lagi.
Dialogue: 0,0:07:17.97,0:07:19.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ih.
Dialogue: 0,0:07:20.56,0:07:23.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tenang saja. Dia tak akan bisa lagi.
Dialogue: 0,0:07:23.73,0:07:26.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Akane, apa kau melakukan sesuatu?
Dialogue: 0,0:07:26.32,0:07:27.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Begitulah.
Dialogue: 0,0:07:33.36,0:07:36.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei, Ranma.\N‎Apa benar-benar di sini tempatnya?
Dialogue: 0,0:07:36.53,0:07:38.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bukankah ini kebun belakang sekolah?
Dialogue: 0,0:07:38.58,0:07:39.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku yakin di sini tempatnya.
Dialogue: 0,0:07:40.58,0:07:44.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Menurut peta, patung rubah ini\N‎menjadi petunjuk penting...
Dialogue: 0,0:07:44.75,0:07:47.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima kasih sudah menunjukkan\N‎jalannya kepadaku.
Dialogue: 0,0:07:49.05,0:07:52.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maju 100 langkah\N‎ke arah yang ditunjuk rubah ini.
Dialogue: 0,0:07:52.43,0:07:55.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Di sanalah lokasi\N‎Mata Air Lelaki Tenggelam!
Dialogue: 0,0:07:57.01,0:07:58.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dasar berengsek. Tunggu aku.
Dialogue: 0,0:07:59.56,0:08:00.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan ikuti aku.
Dialogue: 0,0:08:01.56,0:08:03.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dasar pengecut.
Dialogue: 0,0:08:03.10,0:08:05.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa kau sengaja ingin mendahuluiku?
Dialogue: 0,0:08:05.86,0:08:08.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Diam! Kau cuma mengekor.
Dialogue: 0,0:08:08.69,0:08:10.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku yang menuntunmu ke sini!
Dialogue: 0,0:08:10.61,0:08:14.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Delapan puluh empat, 85, 86.\N‎Apa ada di bawah bangunan itu?
Dialogue: 0,0:08:14.57,0:08:17.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sembilan puluh dua, 93, 94.
Dialogue: 0,0:08:39.51,0:08:41.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa? Kakek itu tidak ada di sini.
Dialogue: 0,0:08:41.81,0:08:42.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia berhasil lolos!
Dialogue: 0,0:08:43.43,0:08:44.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yang artinya...
Dialogue: 0,0:08:45.48,0:08:47.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia pasti akan kembali.
Dialogue: 0,0:08:47.10,0:08:49.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maka, kita lawan dia sampai penghabisan.
Dialogue: 0,0:08:49.19,0:08:50.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Akane, aku akan bantu.
Dialogue: 0,0:08:50.86,0:08:53.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Aku juga.\N‎- Sembilan puluh delapan, 99, 100.
Dialogue: 0,0:08:53.57,0:08:56.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Lokasinya ada di bawah\N‎ruang ganti perempuan.
Dialogue: 0,0:08:56.82,0:08:58.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Di situ lokasi Mata Air Lelaki Tenggelam?
Dialogue: 0,0:08:59.20,0:09:00.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya, tidak diragukan lagi.
Dialogue: 0,0:09:00.95,0:09:03.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sial. Tak peduli siapa pun\N‎yang menghalangiku...{\i0}
Dialogue: 0,0:09:04.71,0:09:07.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mustahil aku mundur sekarang.
Dialogue: 0,0:09:07.29,0:09:08.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kita perlu bekerja sama.
Dialogue: 0,0:09:11.25,0:09:13.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Semuanya, kalian sudah siap, 'kan?
Dialogue: 0,0:09:13.13,0:09:16.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kita akan menjaga\N‎dan melindungi ruang ganti perempuan.
Dialogue: 0,0:09:16.34,0:09:17.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Ya!\N‎- Ya!
Dialogue: 0,0:09:18.14,0:09:20.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Satu, dua. Satu, dua.\N{\i1}‎- Satu, dua. Satu, dua.{\i0}
Dialogue: 0,0:09:20.81,0:09:25.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Satu, dua.\N‎- Master. Kau tidak mengunjungi sekolah?
Dialogue: 0,0:09:25.35,0:09:27.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Ya, aku akan ke sana nanti.\N{\i1}‎- Satu, dua.{\i0}
Dialogue: 0,0:09:29.06,0:09:30.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Semua persiapan sudah selesai.
Dialogue: 0,0:09:30.52,0:09:33.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak punya pilihan\N‎selain menyamar jadi perempuan.
Dialogue: 0,0:09:33.07,0:09:37.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ranma, jangan bilang kau berencana\N‎masuk dari pintu depan?
Dialogue: 0,0:09:37.70,0:09:39.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tentu saja.
Dialogue: 0,0:09:39.03,0:09:42.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak bisa!\N‎Akane sedang berganti pakaian di dalam.
Dialogue: 0,0:09:42.58,0:09:46.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dengar, jangan mendadak lupa\N‎tujuan kita ke sini.
Dialogue: 0,0:09:46.75,0:09:50.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mata Air Lelaki Tenggelam\N‎ada di bawah ruang ganti perempuan.
Dialogue: 0,0:09:53.13,0:09:56.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei, apa menurutmu Kakek itu\N‎benar-benar akan datang?
Dialogue: 0,0:09:56.09,0:09:57.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia pasti datang.
Dialogue: 0,0:09:58.01,0:10:01.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hari ini\N‎kita akan benar-benar menghancurkannya.
Dialogue: 0,0:10:02.14,0:10:04.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Atau tak akan bisa ganti baju\N‎dengan tenang.
Dialogue: 0,0:10:04.27,0:10:07.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Aduh. Ada barangku yang tertinggal.\N‎- Ya.
Dialogue: 0,0:10:10.73,0:10:14.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dasar bodoh. Kita berjanji untuk ucapkan\N‎kata sandi sebelum masuk, bukan?
Dialogue: 0,0:10:15.57,0:10:18.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf. Aku benar-benar lupa.
Dialogue: 0,0:10:18.65,0:10:22.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sekarang, Mata Air Lelaki Tenggelam.\N‎Di mana Mata Air Lelaki Tenggelam?
Dialogue: 0,0:10:22.12,0:10:24.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ranma. Kau sedang apa?
Dialogue: 0,0:10:25.49,0:10:28.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Arahnya ke sini. Jaraknya...
Dialogue: 0,0:10:29.46,0:10:32.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Mungkin di sekitar sini...\N‎- Apa yang sedang kau lakukan?
Dialogue: 0,0:10:33.38,0:10:36.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Dasar tak tahu malu!\N‎- Tidak!
Dialogue: 0,0:10:36.13,0:10:39.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Akane! Tenanglah.\N‎- Tenang dulu, tenang.
Dialogue: 0,0:10:39.09,0:10:40.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau tidak apa-apa?
Dialogue: 0,0:10:40.30,0:10:42.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau jahat sekali, Akane.
Dialogue: 0,0:10:42.60,0:10:44.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau!
Dialogue: 0,0:10:44.68,0:10:46.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tak ada yang menyadari ini aku.{\i0}
Dialogue: 0,0:10:47.48,0:10:49.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Menyamar adalah ide yang bagus.{\i0}
Dialogue: 0,0:10:49.31,0:10:51.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Keluar dari sini.
Dialogue: 0,0:10:51.06,0:10:53.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa salahnya seorang perempuan\N‎masuk ke ruang ganti...
Dialogue: 0,0:10:55.32,0:10:57.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jika kau tidak mau berubah wujud\N‎di sini sekarang juga...
Dialogue: 0,0:10:59.78,0:11:01.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎keluar sekarang juga!
Dialogue: 0,0:11:01.78,0:11:03.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dasar wanita kasar!
Dialogue: 0,0:11:03.74,0:11:05.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Memang kenapa? Dasar tukang mengintip!
Dialogue: 0,0:11:09.91,0:11:13.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak cukup bodoh untuk teperdaya\N‎dan berubah kembali jadi laki-laki.
Dialogue: 0,0:11:16.09,0:11:19.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu Ranma dari kelas sebelah.
Dialogue: 0,0:11:19.63,0:11:22.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Dia memakai celana {\i1}‎bloomer{\i0}‎.\N‎- Apa? Coba kulihat.
Dialogue: 0,0:11:24.72,0:11:26.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sialan!
Dialogue: 0,0:11:28.93,0:11:30.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau tuai apa yang kau tabur.
Dialogue: 0,0:11:30.35,0:11:34.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kenapa kau malah duduk santai begitu?
Dialogue: 0,0:11:37.32,0:11:39.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Cukup. Aku akan melakukan\N‎apa pun yang diperlukan
Dialogue: 0,0:11:39.74,0:11:41.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎agar bisa tetap jadi lelaki selamanya.
Dialogue: 0,0:11:42.41,0:11:43.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dengar, Ryoga.
Dialogue: 0,0:11:44.62,0:11:46.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Curi pakaian mereka\N‎dan larilah sejauh mungkin.
Dialogue: 0,0:11:47.66,0:11:50.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Selagi Akane dan para gadis mengejarmu,
Dialogue: 0,0:11:50.16,0:11:52.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎aku akan menggali\N‎Mata Air Lelaki Tenggelam.
Dialogue: 0,0:11:52.58,0:11:53.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Paham?
Dialogue: 0,0:11:54.63,0:11:56.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan merengek, lakukan saja.
Dialogue: 0,0:11:59.59,0:12:01.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bukankah itu P-chan?
Dialogue: 0,0:12:01.13,0:12:03.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Manis sekali!\N‎- P-chan?
Dialogue: 0,0:12:07.26,0:12:09.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dari mana kau, P-chan?
Dialogue: 0,0:12:20.28,0:12:22.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Tunggu, dia mimisan.\N‎- P-chan?
Dialogue: 0,0:12:33.71,0:12:35.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dasar berengsek. Bangun!
Dialogue: 0,0:12:40.21,0:12:42.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf mengganggu.
Dialogue: 0,0:12:48.26,0:12:50.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku sangat bahagia bisa hidup.
Dialogue: 0,0:12:51.27,0:12:54.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bahkan menjadi babi pun ada gunanya.
Dialogue: 0,0:12:54.19,0:12:56.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bicara omong kosong apa kau ini?
Dialogue: 0,0:12:56.90,0:13:00.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mana lebih penting? Kenikmatan sesaat\N‎atau Mata Air Lelaki Tenggelam?
Dialogue: 0,0:13:00.69,0:13:02.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kenikmatan sesaat.
Dialogue: 0,0:13:02.69,0:13:05.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Ranma selalu cepat sekali melarikan diri.{\i0}
Dialogue: 0,0:13:07.03,0:13:09.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ryoga, bukankah kau tadi sudah pergi?
Dialogue: 0,0:13:10.58,0:13:14.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Akane. Terima kasih soal yang tadi.
Dialogue: 0,0:13:16.17,0:13:18.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa? Ranma mengintip?
Dialogue: 0,0:13:18.92,0:13:22.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya! Aku tak menyangka\N‎dia akan melakukan hal itu.
Dialogue: 0,0:13:22.63,0:13:24.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Serahkan padaku.
Dialogue: 0,0:13:24.76,0:13:27.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sebagai sesama lelaki,\N‎aku tak bisa membiarkan ini.
Dialogue: 0,0:13:27.43,0:13:31.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima kasih. Aku merasa sangat tenang\N‎jika ada kau di sini.
Dialogue: 0,0:13:31.47,0:13:35.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tak masalah,\N‎selama aku bisa membantumu, Akane.
Dialogue: 0,0:13:35.18,0:13:36.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima kasih.
Dialogue: 0,0:13:37.27,0:13:39.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Mana mungkin aku akan menyerah.{\i0}
Dialogue: 0,0:13:39.65,0:13:40.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Berhasil.{\i0}
Dialogue: 0,0:13:41.65,0:13:43.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak ada siapa-siapa di sini.
Dialogue: 0,0:13:49.28,0:13:51.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa-apaan ini?
Dialogue: 0,0:13:53.70,0:13:56.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kena kau, dasar pencuri pakaian dalam.
Dialogue: 0,0:13:57.00,0:13:59.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ryoga, dasar kau berengsek.
Dialogue: 0,0:13:59.29,0:14:01.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bagaimana dengan\N‎Mata Air Lelaki Tenggelam?
Dialogue: 0,0:14:01.67,0:14:03.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ini demi Akane!
Dialogue: 0,0:14:03.38,0:14:06.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Akan kuhabisi kau,\N‎dasar musuh semua wanita!
Dialogue: 0,0:14:06.38,0:14:08.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dasar pengkhianat!
Dialogue: 0,0:14:13.64,0:14:16.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Dia tak akan bisa bergerak sementara.\N‎- Kakek Tua.
Dialogue: 0,0:14:16.31,0:14:19.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ini gunung, gunung harta karun!
Dialogue: 0,0:14:19.73,0:14:21.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ayo, sebelum terlambat.
Dialogue: 0,0:14:21.77,0:14:23.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tunggu, Kakek Tua.
Dialogue: 0,0:14:23.32,0:14:25.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa memang ini rencanamu?
Dialogue: 0,0:14:27.36,0:14:30.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jadi, kau bersekongkol\N‎dengan Kakek, Ranma.
Dialogue: 0,0:14:39.37,0:14:41.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dengar, Ranma.
Dialogue: 0,0:14:41.17,0:14:43.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ayo kita bekerja sama\N‎untuk dapatkan harta karun itu.
Dialogue: 0,0:14:43.71,0:14:46.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan samakan aku denganmu!
Dialogue: 0,0:14:49.26,0:14:52.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ranma. Serang kami\N‎dari sisi mana pun kau mau.
Dialogue: 0,0:14:53.97,0:14:56.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau sebaiknya bersiap-siap, Akane.
Dialogue: 0,0:14:56.06,0:14:58.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku akan mengerahkan segala kemampuanku
Dialogue: 0,0:14:58.56,0:15:01.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎untuk masuk ke ruang ganti perempuan!
Dialogue: 0,0:15:01.48,0:15:05.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hebat, Ranma. Kau sampai sejauh itu\N‎cuma demi pakaian dalam...
Dialogue: 0,0:15:05.23,0:15:07.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ini demi Mata Air Lelaki Tenggelam.
Dialogue: 0,0:15:07.19,0:15:09.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Lagi pula.
Dialogue: 0,0:15:09.15,0:15:11.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Pertengkaran dengan wanita membutuhkan...
Dialogue: 0,0:15:12.03,0:15:13.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bagus. Kau menjijikkan.
Dialogue: 0,0:15:13.91,0:15:14.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kuak.
Dialogue: 0,0:15:16.29,0:15:17.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Cara ini tak terkalahkan!
Dialogue: 0,0:15:20.41,0:15:23.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tetap tenang, Teman-Teman.\N‎Ini semua cuma mainan.
Dialogue: 0,0:15:23.67,0:15:27.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak! Ada ular! Dan katak!
Dialogue: 0,0:15:27.30,0:15:30.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ini asli, bukan mainan!
Dialogue: 0,0:15:30.09,0:15:31.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ranma!
Dialogue: 0,0:15:33.30,0:15:34.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kuak.
Dialogue: 0,0:15:36.43,0:15:37.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kuak!
Dialogue: 0,0:15:40.39,0:15:41.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ranma.
Dialogue: 0,0:15:48.44,0:15:49.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Pencuri!
Dialogue: 0,0:15:58.04,0:16:00.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sialan. Apa dia mengetahui penyamaranku?{\i0}
Dialogue: 0,0:16:00.87,0:16:03.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kukira ini sempurna.{\i0}
Dialogue: 0,0:16:03.50,0:16:05.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sungguh maafkan aku!
Dialogue: 0,0:16:05.00,0:16:06.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kukira kau Ranma.
Dialogue: 0,0:16:07.71,0:16:10.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau jahat sekali.
Dialogue: 0,0:16:10.01,0:16:12.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tidak melakukan apa-apa.
Dialogue: 0,0:16:13.22,0:16:14.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maafkan aku!
Dialogue: 0,0:16:14.55,0:16:16.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku sungguh meminta maaf!
Dialogue: 0,0:16:17.60,0:16:18.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi...
Dialogue: 0,0:16:23.10,0:16:24.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎aku menyukaimu.
Dialogue: 0,0:16:24.31,0:16:26.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa? Tunggu.
Dialogue: 0,0:16:26.15,0:16:28.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kita barus saja berjumpa, kenapa bisa...
Dialogue: 0,0:16:28.52,0:16:31.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa kau benci gadis berkacamata?
Dialogue: 0,0:16:31.44,0:16:33.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak... tapi...
Dialogue: 0,0:16:33.65,0:16:35.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ada orang yang kusuka...
Dialogue: 0,0:16:35.66,0:16:37.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak keberatan.
Dialogue: 0,0:16:37.20,0:16:38.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi...
Dialogue: 0,0:16:38.49,0:16:39.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Benarkah?
Dialogue: 0,0:16:40.95,0:16:42.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Matilah kau!
Dialogue: 0,0:16:42.37,0:16:44.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa yang kau lakukan?
Dialogue: 0,0:16:44.87,0:16:48.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Akane. Kau salah paham.
Dialogue: 0,0:16:48.21,0:16:49.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tidak melakukan apa-apa...
Dialogue: 0,0:16:49.84,0:16:52.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Hei, Akane!\N‎Kenapa kau terus menghalangiku?
Dialogue: 0,0:16:52.76,0:16:57.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ranma. Kau melakukan hal sememalukan ini\N‎cuma demi mendapatkan pakaian dalam?
Dialogue: 0,0:16:57.30,0:17:00.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Dasar bodoh.\N‎Aku tak peduli dengan pakaian dalam.
Dialogue: 0,0:17:00.68,0:17:01.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Kau menginginkannya, 'kan?
Dialogue: 0,0:17:02.73,0:17:04.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Akan kuberikan semuanya kepadamu.
Dialogue: 0,0:17:05.56,0:17:09.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Lagi pula ini semua yang kami kumpulkan\N‎untuk dipakai di jebakan.
Dialogue: 0,0:17:09.27,0:17:10.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dengarkan aku dulu...
Dialogue: 0,0:17:10.73,0:17:13.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jadi, kumohon.
Dialogue: 0,0:17:14.45,0:17:16.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Berhentilah melanggar hukum.
Dialogue: 0,0:17:17.20,0:17:20.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku sungguh percaya\N‎kau tak akan melakukan hal seperti ini.
Dialogue: 0,0:17:20.95,0:17:22.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Selamat tinggal!
Dialogue: 0,0:17:22.04,0:17:26.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tunggu! Aku datang ke sini untuk menggali\N‎Mata Air Lelaki Tenggelam.
Dialogue: 0,0:17:27.67,0:17:29.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mata Air Lelaki Tenggelam?
Dialogue: 0,0:17:30.09,0:17:33.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Lokasinya ada di bawah\N‎ruang ganti perempuan?
Dialogue: 0,0:17:34.26,0:17:36.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa karena itu alasannya, Ranma?
Dialogue: 0,0:17:36.43,0:17:38.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa mata ini seperti mata pembohong?
Dialogue: 0,0:17:38.51,0:17:41.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Setidaknya buatlah kebohonganmu\N‎masuk akal.
Dialogue: 0,0:17:42.56,0:17:46.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Penyamaranmu tadi lumayan hebat, Ranma.
Dialogue: 0,0:17:47.44,0:17:48.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Benar sekali.
Dialogue: 0,0:17:48.60,0:17:52.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tidak pernah berkencan\N‎dengan seorang wanita pun seumur hidupku.
Dialogue: 0,0:17:53.82,0:17:56.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa lagi mendapat pernyataan cinta.
Dialogue: 0,0:17:56.82,0:18:00.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sekali pun tak pernah seumur hidupku...
Dialogue: 0,0:18:00.62,0:18:02.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa kau dengar itu?
Dialogue: 0,0:18:02.28,0:18:03.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Lelaki malang.
Dialogue: 0,0:18:05.29,0:18:06.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Memangnya kenapa?
Dialogue: 0,0:18:07.62,0:18:10.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jujurlah dan beri tahu aku, Ranma.
Dialogue: 0,0:18:10.54,0:18:14.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kenapa kau melakukan hal selancang itu?
Dialogue: 0,0:18:14.17,0:18:17.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sudah jelas\N‎itu demi Mata Air Lelaki Tenggelam...
Dialogue: 0,0:18:17.30,0:18:19.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maksudmu...
Dialogue: 0,0:18:21.47,0:18:23.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎karena itulah kau menginjak-injak
Dialogue: 0,0:18:23.68,0:18:27.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎kepolosan seorang pria berulang kali?
Dialogue: 0,0:18:27.89,0:18:29.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Diam.
Dialogue: 0,0:18:29.39,0:18:32.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau yang memperlihatkan kepadaku
Dialogue: 0,0:18:32.23,0:18:34.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎peta menuju Mata Air Lelaki Tenggelam!
Dialogue: 0,0:18:38.49,0:18:41.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ryoga, apa itu benar?
Dialogue: 0,0:18:41.57,0:18:44.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kenapa kau punya peta menuju\N‎Mata Air Lelaki Tenggelam?
Dialogue: 0,0:18:48.50,0:18:50.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ryoga, jangan bilang...
Dialogue: 0,0:19:09.06,0:19:10.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Rahasiaku terbongkar.{\i0}
Dialogue: 0,0:19:11.48,0:19:13.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎...kau berusaha menghilangkan kutukan Ranma.
Dialogue: 0,0:19:14.65,0:19:16.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau benar-benar orang yang baik.
Dialogue: 0,0:19:17.32,0:19:20.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Untunglah Akane agak lamban, ya, P-chan?
Dialogue: 0,0:19:26.24,0:19:27.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Siapa...
Dialogue: 0,0:19:28.00,0:19:30.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎yang kau panggil P-chan?
Dialogue: 0,0:19:32.67,0:19:34.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Totokan...
Dialogue: 0,0:19:34.46,0:19:37.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau salah sasaran.
Dialogue: 0,0:19:37.00,0:19:39.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎...Ledakan!
Dialogue: 0,0:19:55.69,0:19:58.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sensasi ini...
Dialogue: 0,0:20:03.57,0:20:05.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kita berhasil.
Dialogue: 0,0:20:16.75,0:20:18.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Mata Air Lelaki Tenggelam.{\i0}
Dialogue: 0,0:20:19.05,0:20:20.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Lokasinya benar-benar di sini.{\i0}
Dialogue: 0,0:20:22.51,0:20:23.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei.
Dialogue: 0,0:20:24.64,0:20:28.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Peta Mata Air Lelaki Tenggelam itu\N‎memang asli, bukan?
Dialogue: 0,0:20:30.27,0:20:32.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Lalu, kenapa aku tak bisa kembali\N‎menjadi pria?
Dialogue: 0,0:20:32.98,0:20:35.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Katakan sesuatu, dasar babi!
Dialogue: 0,0:20:43.07,0:20:45.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Mata Air Lelaki Tenggelam Jepang{\i0}
Dialogue: 0,0:20:45.53,0:20:48.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎yang telah menjadi langganan Anda\N‎selama bertahun-tahun kini telah tutup.{\i0}
Dialogue: 0,0:20:48.95,0:20:51.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Silakan kunjungi\N‎Mata Air Lelaki Tenggelam asli{\i0}
Dialogue: 0,0:20:51.50,0:20:54.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎di Jusenkyo, Tiongkok,\N‎untuk kebutuhan Anda.{\i0}
Dialogue: 0,0:20:55.33,0:20:58.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jadi, itu cuma pemandian umum biasa?
Dialogue: 0,0:20:58.88,0:21:02.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei! Siapa pelakunya?\N‎Siapa yang merusak pipa air?
Dialogue: 0,0:21:02.76,0:21:04.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ranma.
Dialogue: 0,0:21:08.60,0:21:10.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau dapat pakaian dalam itu dari mana?
Dialogue: 0,0:21:10.85,0:21:12.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku memungutnya.
Dialogue: 0,0:21:15.48,0:21:19.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ada apa, P-chan?\N‎Kau sungguh tidak bersemangat.
Dialogue: 0,0:21:19.06,0:21:23.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Lagi pula, kau pasti jauh lebih bahagia\N‎jika tetap seperti ini.
Dialogue: 0,0:22:57.04,0:23:02.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Terjemahan subtitle oleh Rio Wibowo\N‎Pengawas Produksi: Ranma1/2 Project
