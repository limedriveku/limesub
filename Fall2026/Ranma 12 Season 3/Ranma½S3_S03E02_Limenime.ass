Dialogue: 0,0:00:53.01,0:00:56.97,sign,,0000,0000,0000,,‎RANMA1/2
Dialogue: 0,0:02:21.01,0:02:23.93,sign,,0000,0000,0000,,{\an8}‎TOTOKAN LEDAKAN
Dialogue: 0,0:08:32.92,0:08:35.30,sign,,0000,0000,0000,,{\an8}‎AKANE
Dialogue: 0,0:16:24.19,0:16:25.56,sign,,0000,0000,0000,,‎MASA DIA AKAN PAKAI JURUS ITU?
Dialogue: 0,0:17:09.86,0:17:10.94,sign,,0000,0000,0000,,‎YA
Dialogue: 0,0:17:12.61,0:17:13.61,sign,,0000,0000,0000,,‎ITU SANGAT SULIT DILAKUKAN
Dialogue: 0,0:00:12.59,0:00:13.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ranma!
Dialogue: 0,0:00:14.97,0:00:17.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Persiapkan dirimu!\N‎- Hei, Ryoga.
Dialogue: 0,0:00:19.89,0:00:22.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kau harus berhenti menantang Ranma.{\i0}
Dialogue: 0,0:00:26.31,0:00:29.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku ingin bicara lagi denganmu.
Dialogue: 0,0:00:30.65,0:00:33.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku juga ingin bertemu lagi denganmu.
Dialogue: 0,0:00:37.32,0:00:39.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia akan menjadi lebih kuat.
Dialogue: 0,0:00:40.70,0:00:42.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Menarik. Baiklah.
Dialogue: 0,0:00:45.58,0:00:48.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku akan pergi mengurus Ryoga.
Dialogue: 0,0:00:48.21,0:00:49.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei, Akane!
Dialogue: 0,0:02:37.86,0:02:38.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baiklah.
Dialogue: 0,0:02:57.80,0:03:00.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aduh, buruk sekali.
Dialogue: 0,0:03:01.34,0:03:04.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Kau…\N‎- Berapa kali harus kukatakan padamu?
Dialogue: 0,0:03:04.47,0:03:07.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tusuk titik tekannya. Titik tekannya.
Dialogue: 0,0:03:07.27,0:03:08.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Titik tekannya.
Dialogue: 0,0:03:16.65,0:03:20.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kini kau harus ulang semuanya dari awal,\N‎termasuk mencari batu besar baru.
Dialogue: 0,0:03:20.57,0:03:21.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sialan.
Dialogue: 0,0:03:22.32,0:03:24.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Jurus yang sungguh mengerikan…{\i0}
Dialogue: 0,0:03:24.12,0:03:27.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Jika Ryoga berhasil menguasainya,{\i0}
Dialogue: 0,0:03:27.12,0:03:28.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Ranma akan…{\i0}
Dialogue: 0,0:03:36.17,0:03:38.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei. Untuk apa kau datang ke sini?
Dialogue: 0,0:03:38.71,0:03:42.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Menjijikkan…\N‎- Jangan dimakan jika pikirmu menjijikkan!
Dialogue: 0,0:03:42.30,0:03:43.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu benar.
Dialogue: 0,0:03:43.43,0:03:46.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dasar bodoh!
Dialogue: 0,0:03:46.97,0:03:49.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Calon menantuku,\N‎apa kau datang untuk mengintai?
Dialogue: 0,0:03:49.77,0:03:51.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mana mungkin.
Dialogue: 0,0:03:55.77,0:03:57.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ryoga.
Dialogue: 0,0:03:59.15,0:04:01.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau tak apa-apa? Kasihan sekali.
Dialogue: 0,0:04:07.49,0:04:10.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau dicampakkan! Dia mencampakkanmu!
Dialogue: 0,0:04:12.16,0:04:13.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku mau pulang.
Dialogue: 0,0:04:13.92,0:04:17.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Kau yakin? Bukankah kau ke sini\N‎sebenarnya untuk menjemput tunanganmu?
Dialogue: 0,0:04:17.84,0:04:19.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Aku cuma agak khawatir.
Dialogue: 0,0:04:23.80,0:04:24.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Akane…
Dialogue: 0,0:04:26.26,0:04:27.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa?
Dialogue: 0,0:04:28.26,0:04:30.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan racuni dia lagi dengan makananmu.
Dialogue: 0,0:04:30.72,0:04:33.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hari pertarungan kami\N‎sudah tidak lama lagi.
Dialogue: 0,0:04:33.02,0:04:36.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Siapa yang kau khawatirkan?
Dialogue: 0,0:04:37.86,0:04:40.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Pergi juga dia.
Dialogue: 0,0:04:40.15,0:04:42.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sungguh mempelai pria yang tidak peka.
Dialogue: 0,0:04:42.36,0:04:46.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Bagaimana? Kenapa tak manfaatkan\N‎kesempatan ini untuk beralih ke Ryoga?
Dialogue: 0,0:04:46.11,0:04:49.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Jangan bicara yang tidak-tidak, Nenek.
Dialogue: 0,0:04:50.12,0:04:52.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ryoga, kau sudah sadar?
Dialogue: 0,0:04:52.54,0:04:54.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dengar, Nenek, satu-satunya hal yang ada
Dialogue: 0,0:04:55.67,0:04:59.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎di pikiranku adalah mengalahkan Ranma.
Dialogue: 0,0:05:02.96,0:05:05.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Ryoga benar-benar serius soal ini.{\i0}
Dialogue: 0,0:05:05.26,0:05:06.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kau akan baik-baik saja, Ranma?{\i0}
Dialogue: 0,0:05:08.76,0:05:12.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa? Menghancurkan batu besar\N‎dengan satu jari?
Dialogue: 0,0:05:12.43,0:05:15.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya. Dia berusaha melakukannya\N‎sambil digantung di pohon.
Dialogue: 0,0:05:17.35,0:05:18.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Memangnya kenapa?
Dialogue: 0,0:05:19.81,0:05:22.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kurasa teknik itu
Dialogue: 0,0:05:23.07,0:05:26.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎adalah jurus rahasia yang mengerikan,\N‎"Totokan Ledakan".
Dialogue: 0,0:05:26.86,0:05:28.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Totokan Ledakan?
Dialogue: 0,0:05:28.95,0:05:30.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya. Segala hal di alam,
Dialogue: 0,0:05:30.95,0:05:33.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎baik itu langit, bumi, tumbuhan,\N‎maupun pepohonan,
Dialogue: 0,0:05:33.91,0:05:35.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎semuanya memiliki titik hancur.
Dialogue: 0,0:05:35.62,0:05:39.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bahkan katak, anjing tanah,\N‎dan juga anggang-anggang.
Dialogue: 0,0:05:41.00,0:05:43.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dan tentu saja, manusia.
Dialogue: 0,0:05:45.51,0:05:49.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yang artinya aku akan menang selama dia\N‎tidak menyentuh titik tekanku.
Dialogue: 0,0:05:49.76,0:05:51.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu mudah.
Dialogue: 0,0:05:51.26,0:05:53.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yah, memang begitulah.
Dialogue: 0,0:06:06.57,0:06:10.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kalahkan semua lebah tanpa tersengat!
Dialogue: 0,0:06:10.07,0:06:13.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Lakukan itu, dan Totokan Ledakan\N‎bukan lagi hal yang menakutkan!
Dialogue: 0,0:06:14.54,0:06:16.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mudah.
Dialogue: 0,0:06:38.14,0:06:39.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan memaksakan diri terlalu keras.
Dialogue: 0,0:06:39.98,0:06:42.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Diam.
Dialogue: 0,0:06:57.20,0:06:59.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Lihat saja nanti, Akane bodoh.{\i0}
Dialogue: 0,0:07:00.00,0:07:02.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku tak akan kalah dalam pertarungan ini.{\i0}
Dialogue: 0,0:07:30.15,0:07:31.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ayo!
Dialogue: 0,0:07:43.08,0:07:46.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ryoga, hentikan! Kau bisa mati.
Dialogue: 0,0:07:48.88,0:07:52.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Ryoga…\N‎- Aku pasti akan mengalahkannya.
Dialogue: 0,0:07:53.76,0:07:56.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu sebabnya aku melakukan ini di sini.
Dialogue: 0,0:07:57.56,0:08:01.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku akan mengalahkan Ranma. Aku bersumpah.
Dialogue: 0,0:08:01.31,0:08:04.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bicara itu sangat mudah.
Dialogue: 0,0:08:04.15,0:08:06.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Katakan itu setelah kau\N‎menguasai jurusnya.
Dialogue: 0,0:08:06.48,0:08:07.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maju kau!
Dialogue: 0,0:08:13.49,0:08:15.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau belum selesai.
Dialogue: 0,0:08:15.24,0:08:16.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kemarilah!
Dialogue: 0,0:08:24.79,0:08:26.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Masih belum bisa.
Dialogue: 0,0:08:26.46,0:08:29.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau tidak bisa menemukan titik tekan\N‎karena fokusmu teralihkan.
Dialogue: 0,0:08:29.55,0:08:32.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Apa katamu? Apa maksudmu…
Dialogue: 0,0:08:40.93,0:08:43.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎- Baiklah, mari kita lanjutkan.\N‎- Ya, serang aku!
Dialogue: 0,0:09:11.88,0:09:13.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Luar biasa.
Dialogue: 0,0:09:13.59,0:09:17.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau benar-benar telah menyempurnakan\N‎kemampuan untuk menangkal Totokan Ledakan.
Dialogue: 0,0:09:18.89,0:09:21.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mempelajari hal seperti itu sangat mudah.
Dialogue: 0,0:09:21.97,0:09:26.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi yang lebih penting lagi,\N‎apakah dia menguasai teknik itu?
Dialogue: 0,0:09:31.98,0:09:34.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sepertinya aku tidak perlu khawatir.
Dialogue: 0,0:09:38.86,0:09:43.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tampaknya kau akhirnya telah menguasai\N‎jurus rahasia Totokan Ledakan.
Dialogue: 0,0:09:48.62,0:09:51.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu sungguh mudah…
Dialogue: 0,0:09:51.13,0:09:54.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya ampun. Dia sombong sekali.
Dialogue: 0,0:09:54.80,0:09:58.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi aku memujimu karena bisa menguasainya\N‎dalam sepekan.
Dialogue: 0,0:10:02.51,0:10:04.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ini sudah waktunya.
Dialogue: 0,0:10:05.10,0:10:07.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Jika dia terkena jurus itu…{\i0}
Dialogue: 0,0:10:07.89,0:10:09.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tidak, Ranma!{\i0}
Dialogue: 0,0:10:09.69,0:10:10.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kau akan mati!{\i0}
Dialogue: 0,0:10:12.86,0:10:13.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Nenek.
Dialogue: 0,0:10:47.89,0:10:50.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau datang juga, Menantuku.
Dialogue: 0,0:10:50.35,0:10:53.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku sempat khawatir kau akan kabur.
Dialogue: 0,0:10:53.94,0:10:55.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bukankah seharusnya
Dialogue: 0,0:10:55.61,0:10:58.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎kau mengkhawatirkan Ryoga\N‎alih-alih mengkhawatirkanku?
Dialogue: 0,0:10:58.65,0:11:00.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Di mana dia?
Dialogue: 0,0:11:00.32,0:11:01.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tak perlu berteriak.
Dialogue: 0,0:11:02.20,0:11:05.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku amat tak sabar menunggu hari ini\N‎sampai tak bisa tidur.
Dialogue: 0,0:11:05.58,0:11:07.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bukankah karena kau takut?
Dialogue: 0,0:11:07.91,0:11:09.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku sudah menunggu…
Dialogue: 0,0:11:10.16,0:11:11.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku menunggu hari ini tiba, Ranma!
Dialogue: 0,0:11:14.42,0:11:18.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apakah menantuku\N‎sudah menyiapkan penangkal?
Dialogue: 0,0:11:18.80,0:11:20.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei!
Dialogue: 0,0:11:21.43,0:11:23.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kenapa kau lakukan ini kepadaku?
Dialogue: 0,0:11:23.84,0:11:27.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan khawatir. Aku hanya berpikir\N‎akan lebih seru jika ada hadiahnya.
Dialogue: 0,0:11:27.68,0:11:28.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hadiah?
Dialogue: 0,0:11:28.77,0:11:33.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yang menang pertarungan ini\N‎bisa berkencan dengan Akane Tendo.
Dialogue: 0,0:11:33.27,0:11:36.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jika Ryoga menang,\N‎dia bisa menjadi pacarmu,
Dialogue: 0,0:11:36.40,0:11:40.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎dan menantuku bisa menikahi Shan Pu.
Dialogue: 0,0:11:41.82,0:11:44.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan memanfaatkan aku\N‎demi tujuan pribadimu!
Dialogue: 0,0:11:44.99,0:11:48.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ranma. Kau juga, Ryoga, katakan sesuatu.
Dialogue: 0,0:11:54.00,0:11:55.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bersiaplah untuk kalah!
Dialogue: 0,0:11:57.67,0:11:58.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei, kalian…
Dialogue: 0,0:12:21.99,0:12:24.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Meskipun kau sudah menjalani\N‎latihan khusus nenek itu,
Dialogue: 0,0:12:24.57,0:12:26.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎pertahananmu masih penuh celah.
Dialogue: 0,0:12:35.79,0:12:37.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sok tahu sekali.
Dialogue: 0,0:12:39.50,0:12:42.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku akan menjatuhkanmu sekarang juga!
Dialogue: 0,0:12:50.14,0:12:51.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Totokan Ledakan.
Dialogue: 0,0:12:52.22,0:12:53.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Omong kosong!
Dialogue: 0,0:13:02.19,0:13:03.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Seranganmu meleset.
Dialogue: 0,0:13:03.65,0:13:04.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sialan.
Dialogue: 0,0:13:05.74,0:13:07.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Pertarungan ini{\i0}
Dialogue: 0,0:13:07.66,0:13:09.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎sepenuhnya menguntungkan Ranma.{\i0}
Dialogue: 0,0:13:10.58,0:13:12.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Karena Ryoga selalu berada di tengah,{\i0}
Dialogue: 0,0:13:12.87,0:13:15.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎dia yang akan terkena serpihan.{\i0}
Dialogue: 0,0:13:15.12,0:13:18.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sebaliknya, Ranma sama sekali\N‎tidak terluka.{\i0}
Dialogue: 0,0:13:19.54,0:13:22.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tapi kenapa dia mengajari Ryoga\N‎Totokan Ledakan?{\i0}
Dialogue: 0,0:13:23.71,0:13:26.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Si Nenek pasti ingin Ryoga menang.{\i0}
Dialogue: 0,0:13:30.35,0:13:32.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Secara bertahap kau akan menyadari{\i0}
Dialogue: 0,0:13:32.97,0:13:36.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎betapa mengerikannya latihan khusus itu.{\i0}
Dialogue: 0,0:13:46.36,0:13:49.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau tak akan bertahan\N‎jika terus-menerus dihujani batu.
Dialogue: 0,0:13:49.87,0:13:51.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Diam!
Dialogue: 0,0:13:51.03,0:13:54.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku akan membuatmu jatuh\N‎dengan sekali pukulan.
Dialogue: 0,0:14:03.25,0:14:04.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Berakhirlah sudah.
Dialogue: 0,0:14:13.51,0:14:16.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei… Apa dia tidak apa-apa?
Dialogue: 0,0:14:18.44,0:14:19.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu sungguh mudah.
Dialogue: 0,0:14:31.32,0:14:32.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Hei!\N‎- Maaf.
Dialogue: 0,0:14:37.33,0:14:40.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau makin lemah, Ranma!
Dialogue: 0,0:14:40.29,0:14:42.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Apa?\N‎- Dia masih penuh tenaga.
Dialogue: 0,0:14:42.75,0:14:47.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tendanganmu rasanya\N‎seperti tendangan bayi.
Dialogue: 0,0:14:47.17,0:14:48.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa kau bilang?
Dialogue: 0,0:14:48.67,0:14:50.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Ternyata begitu.{\i0}
Dialogue: 0,0:14:50.26,0:14:53.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Terkena serangan saat latihan khusus\N‎membuat Ryoga makin tangguh.{\i0}
Dialogue: 0,0:14:56.22,0:14:57.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa rencanamu, Menantu?
Dialogue: 0,0:14:59.60,0:15:02.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tampaknya kau sudah berusaha keras\N‎menyusun rencana,
Dialogue: 0,0:15:02.23,0:15:04.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎tapi apakah kau punya cara\N‎untuk kalahkan Ryoga?
Dialogue: 0,0:15:04.61,0:15:06.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Diam, Nenek Tua!
Dialogue: 0,0:15:06.78,0:15:09.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku juga menjalani latihan khusus.
Dialogue: 0,0:15:09.57,0:15:12.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Latihanmu cuma fokus\N‎pada menghindar, 'kan?
Dialogue: 0,0:15:14.28,0:15:15.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kalau dipikir-pikir…{\i0}
Dialogue: 0,0:15:15.99,0:15:18.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Cuma itu yang kulakukan.{\i0}
Dialogue: 0,0:15:18.25,0:15:20.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Bisakah kau menang?
Dialogue: 0,0:15:20.12,0:15:22.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Kenapa kau bertanya begitu?
Dialogue: 0,0:15:22.00,0:15:23.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan lupa.
Dialogue: 0,0:15:23.75,0:15:27.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku yang jadi hadiah\N‎untuk pemenang pertarungan ini…
Dialogue: 0,0:15:27.96,0:15:31.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku bertarung bukan demi dirimu.
Dialogue: 0,0:15:33.30,0:15:35.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ryoga mulai bosan menunggumu turun.
Dialogue: 0,0:15:37.60,0:15:39.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa-apaan kau, Nenek Tua?
Dialogue: 0,0:15:39.10,0:15:40.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan sentuh aku.
Dialogue: 0,0:15:40.64,0:15:42.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku membencimu!
Dialogue: 0,0:15:46.82,0:15:48.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bersiaplah!
Dialogue: 0,0:15:50.40,0:15:51.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Peredam Totokan Ledakan!
Dialogue: 0,0:15:54.37,0:15:56.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jika aku menangkis kedua tanganmu,
Dialogue: 0,0:15:56.20,0:15:58.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎kemenangan akan jadi milikku!
Dialogue: 0,0:15:59.24,0:16:03.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa kau tak tahu\N‎tendanganmu tak akan mempan padaku?
Dialogue: 0,0:16:05.67,0:16:10.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kekuatanmu saat ini\N‎tidak cukup untuk mengalahkanku!
Dialogue: 0,0:16:13.43,0:16:16.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku sebenarnya tidak ingin\N‎menggunakan jurus ini.{\i0}
Dialogue: 0,0:16:22.56,0:16:24.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ranma?
Dialogue: 0,0:16:26.65,0:16:28.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jurus Rahasia Saotome.
Dialogue: 0,0:16:29.27,0:16:30.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jurus Rahasia?
Dialogue: 0,0:16:32.40,0:16:36.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mana mungkin aku tertipu\N‎gertakan seperti itu!
Dialogue: 0,0:16:39.24,0:16:41.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jurus Rahasia Saotome. Bersedia, Siap…
Dialogue: 0,0:16:41.95,0:16:44.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Melarikan Diri!
Dialogue: 0,0:16:50.80,0:16:52.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Dia… melarikan diri?
Dialogue: 0,0:16:55.09,0:16:56.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei…
Dialogue: 0,0:16:56.22,0:16:59.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kembalilah kau, dasar pengecut!
Dialogue: 0,0:16:59.76,0:17:01.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dengar baik-baik, Ranma.{\i0}
Dialogue: 0,0:17:01.06,0:17:02.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}‎Jurus Rahasia Saotome{\i0}
Dialogue: 0,0:17:02.81,0:17:06.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}‎adalah soal kecepatan, strategi,\N‎dan serangan.{\i0}
Dialogue: 0,0:17:06.52,0:17:09.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dengan kata lain, kabur dulu\N‎sambil memikirkan cara membalas?
Dialogue: 0,0:17:10.94,0:17:12.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Serangan konyol macam apa itu?
Dialogue: 0,0:17:16.70,0:17:20.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bodoh sekali,\N‎memancingku ke tempat seperti ini.
Dialogue: 0,0:17:22.66,0:17:25.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tak peduli seberapa tangguh kau sekarang,
Dialogue: 0,0:17:25.25,0:17:28.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎pasti ada batas\N‎untuk daya tahan ketangguhanmu!
Dialogue: 0,0:17:28.63,0:17:30.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia pakai pantulan lompatan.
Dialogue: 0,0:17:37.68,0:17:39.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sama sekali tidak terasa!
Dialogue: 0,0:17:45.73,0:17:47.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Pasti terasa sedikit, 'kan.
Dialogue: 0,0:17:48.15,0:17:49.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yah.
Dialogue: 0,0:17:49.35,0:17:52.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apakah hanya memantul dari pohon\N‎bisa membuat pukulannya makin kuat?
Dialogue: 0,0:17:52.82,0:17:54.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan merasa puas dulu!
Dialogue: 0,0:17:57.20,0:18:00.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kali ini dia tidak menggunakan pantulan.\N‎Jangan-jangan…
Dialogue: 0,0:18:01.33,0:18:03.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Itu Jurus Kastanya Manis Tenshin Membara?{\i0}
Dialogue: 0,0:18:03.54,0:18:05.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kelihatannya dia hanya melontarkan\N‎satu pukulan,{\i0}
Dialogue: 0,0:18:05.83,0:18:08.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎tapi dia memukul\N‎titik yang sama ratusan kali.{\i0}
Dialogue: 0,0:18:08.92,0:18:10.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Seharusnya bisa menyakitinya.{\i0}
Dialogue: 0,0:18:10.46,0:18:12.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Begitu, ya, Menantuku.
Dialogue: 0,0:18:12.92,0:18:16.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau memanfaatkan jurus yang kuajari\N‎dengan baik.
Dialogue: 0,0:18:23.81,0:18:25.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bajingan!
Dialogue: 0,0:18:25.77,0:18:27.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Rasakan tinjuku!
Dialogue: 0,0:18:39.28,0:18:43.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Menantuku akan kalah jika pertarungan ini\N‎berlangsung lebih lama.
Dialogue: 0,0:18:43.87,0:18:46.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi bukankah pertarungannya akan…
Dialogue: 0,0:18:49.08,0:18:51.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak akan seru\N‎jika perlawananmu tak sejauh ini.
Dialogue: 0,0:18:51.96,0:18:52.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}‎Bajingan ini…{\i0}
Dialogue: 0,0:18:54.21,0:18:55.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}‎adalah seorang monster!{\i0}
Dialogue: 0,0:18:57.21,0:18:58.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ayo pukul aku, Ranma!
Dialogue: 0,0:19:02.26,0:19:05.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kenapa? Kau kehabisan tenaga.
Dialogue: 0,0:19:06.43,0:19:11.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tentu saja stamina akan habis\N‎jika lontarkan ratusan pukulan sekaligus.
Dialogue: 0,0:19:14.98,0:19:18.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dia benar. Aku cuma mampu\N‎memakai jurus ini satu kali lagi.{\i0}
Dialogue: 0,0:19:19.15,0:19:20.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Ini penentu segalanya!{\i0}
Dialogue: 0,0:19:22.49,0:19:24.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dasar bodoh! Kenapa kau jatuh sendiri?
Dialogue: 0,0:19:24.91,0:19:27.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Rasakan ini!
Dialogue: 0,0:19:35.17,0:19:39.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Rasakan ini.\N‎Jurus Kastanya Manis Tenshin Membara!
Dialogue: 0,0:19:42.93,0:19:44.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bagaimana…
Dialogue: 0,0:19:46.14,0:19:48.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎rasanya?
Dialogue: 0,0:19:57.57,0:19:58.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎aku menang…
Dialogue: 0,0:20:03.57,0:20:05.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ranma!
Dialogue: 0,0:20:10.25,0:20:13.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya ampun. Menantuku teledor sekali.
Dialogue: 0,0:20:13.75,0:20:16.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ranma!
Dialogue: 0,0:20:22.05,0:20:25.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sialan… Si bodoh ini\N‎membuat semuanya makin kacau…
Dialogue: 0,0:20:26.14,0:20:28.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Sayang sekali.\N‎- Nenek Tua.
Dialogue: 0,0:20:28.14,0:20:32.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku ingin Ryoga menang\N‎agar dia bisa jadi pacar Akane.
Dialogue: 0,0:20:33.23,0:20:35.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan ajari orang polos seperti Ryoga
Dialogue: 0,0:20:35.81,0:20:37.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎jurus berbahaya seperti itu…
Dialogue: 0,0:20:38.73,0:20:41.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa kau bilang itu berbahaya?
Dialogue: 0,0:20:42.32,0:20:47.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maksudmu Totokan Ledakan yang kupakai ini?
Dialogue: 0,0:20:51.41,0:20:52.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Tenang saja.{\i0}
Dialogue: 0,0:20:53.50,0:20:55.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Totokan Ledakan adalah jurus{\i0}
Dialogue: 0,0:20:55.08,0:20:59.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎yang dikembangkan khusus\N‎untuk memecah batu saat konstruksi.{\i0}
Dialogue: 0,0:20:59.59,0:21:02.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dengan kata lain,\N‎jurus ini tidak mempan pada manusia.
Dialogue: 0,0:21:03.63,0:21:05.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei.
Dialogue: 0,0:21:05.13,0:21:07.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa kau mendengarkan? Menantuku?
Dialogue: 0,0:21:09.85,0:21:13.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Aku akan mengakui kekalahanku kali ini\N‎dengan lapang dada.{\i0}
Dialogue: 0,0:21:14.18,0:21:15.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sampaikan pamitku kepada Akane.{\i0}
Dialogue: 0,0:21:16.81,0:21:20.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bukankah seharusnya kau mundur?
Dialogue: 0,0:21:20.11,0:21:21.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei, Babi.
Dialogue: 0,0:21:21.48,0:21:25.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kenapa sikapmu begitu\N‎saat P-chan akhirnya kembali?
Dialogue: 0,0:21:26.49,0:21:28.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dasar si bajingan ini.
Dialogue: 0,0:22:56.91,0:23:01.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Terjemahan subtitle oleh Rio Wibowo\N‎Pengawas Produksi: Ranma1/2 Project
