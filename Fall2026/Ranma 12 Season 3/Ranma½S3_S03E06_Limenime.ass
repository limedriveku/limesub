Dialogue: 0,0:00:19.85,0:00:23.02,sign,,0000,0000,0000,,{\an8}‎ACARA SORE FURINKAN OLEH KLUB SIARAN
Dialogue: 0,0:00:23.02,0:00:24.10,sign,,0000,0000,0000,,{\an8}‎PEMBAWA ACARA ANDA\N‎ICHIRO
Dialogue: 0,0:00:29.98,0:00:31.07,sign,,0000,0000,0000,,{\an8}‎TAMU KITA
Dialogue: 0,0:00:31.07,0:00:32.15,sign,,0000,0000,0000,,{\an8}‎HALO, SENANG BERJUMPA
Dialogue: 0,0:00:34.82,0:00:36.11,sign,,0000,0000,0000,,‎BERITA EKSKLUSIF!\N‎FOTO MENGHEBOHKAN DAN RAHASIA
Dialogue: 0,0:01:03.60,0:01:05.23,sign,,0000,0000,0000,,‎APA ACARA INI AKAN BERI MAKAN?
Dialogue: 0,0:01:21.20,0:01:22.20,sign,,0000,0000,0000,,‎DAPATKAN KLISE FOTO
Dialogue: 0,0:01:27.12,0:01:28.00,sign,,0000,0000,0000,,‎BAGAIMANA TAKDIR MEREKA?
Dialogue: 0,0:01:39.22,0:01:41.93,sign,,0000,0000,0000,,‎SUDAH DIMULAI!
Dialogue: 0,0:01:44.60,0:01:47.94,sign,,0000,0000,0000,,‎RANMA1/2
Dialogue: 0,0:03:12.65,0:03:18.78,sign,,0000,0000,0000,,{\an8}‎KUMAKAN SEMUANYA
Dialogue: 0,0:04:17.88,0:04:19.29,sign,,0000,0000,0000,,{\an8}‎KENANGAN MANIS BERSAMA RANMA-KU
Dialogue: 0,0:05:04.92,0:05:07.18,sign,,0000,0000,0000,,‎MIDORIGAME
Dialogue: 0,0:05:37.79,0:05:39.63,sign,,0000,0000,0000,,{\an8}‎MANDI... BERSAMA
Dialogue: 0,0:06:01.77,0:06:02.77,sign,,0000,0000,0000,,‎RUANG MANDI
Dialogue: 0,0:10:58.19,0:10:59.36,sign,,0000,0000,0000,,‎TOILET
Dialogue: 0,0:15:46.23,0:15:47.23,sign,,0000,0000,0000,,‎SENJATA TUMPUL
Dialogue: 0,0:00:24.10,0:00:26.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Lama tak jumpa, Semuanya.
Dialogue: 0,0:00:26.56,0:00:29.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Aku Ichiro kesayangan kalian\N‎dari Klub Siaran Furinkan.
Dialogue: 0,0:00:32.15,0:00:34.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Kami menyapa kalian\N‎dari set siaran khusus hari ini.
Dialogue: 0,0:00:36.11,0:00:39.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Foto kandid ini menyebabkan\N‎kegemparan cukup besar kemarin.
Dialogue: 0,0:00:40.20,0:00:44.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Karena ketakutan, Ranma Saotome berjuang\N‎mati-matian untuk memusnahkan buktinya.
Dialogue: 0,0:00:44.96,0:00:46.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Namun, alangkah sia-sianya.
Dialogue: 0,0:00:46.75,0:00:51.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Klise fotonya ada di dalam kalung\N‎yang mengeluarkan sengatan listrik.
Dialogue: 0,0:00:52.38,0:00:57.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sementara itu, Akane Tendo bekerja keras\N‎memanggang kukis untuk Ranma.
Dialogue: 0,0:00:57.34,0:01:01.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sayangnya, Ranma amat terdistraksi\N‎sampai tak mencicipinya satu pun.
Dialogue: 0,0:01:05.23,0:01:08.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Namun seperti yang diharapkan\N‎dari Akane Tendo,
Dialogue: 0,0:01:08.90,0:01:11.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎dia menyadari siasat Kodachi Kuno
Dialogue: 0,0:01:11.23,0:01:15.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎dan mulai mencari petunjuk\N‎seperti detektif berpengalaman.
Dialogue: 0,0:01:16.53,0:01:21.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apakah Ranma Saotome akan berhasil\N‎mendapatkan klise foto itu?
Dialogue: 0,0:01:22.20,0:01:27.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apakah Akane Tendo bisa\N‎membuat Ranma memakan kukisnya?
Dialogue: 0,0:01:29.00,0:01:31.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mari kita buka mata lebar-lebar
Dialogue: 0,0:01:31.17,0:01:35.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎dan saksikan apa yang ditakdirkan\N‎untuk mereka berdua!
Dialogue: 0,0:03:18.78,0:03:20.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Dasar Ranma bodoh.{\i0}
Dialogue: 0,0:03:20.15,0:03:23.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Rahasia apa yang dipegang Kodachi darimu?{\i0}
Dialogue: 0,0:03:24.78,0:03:27.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Pasti ada petunjuk di suatu tempat.{\i0}
Dialogue: 0,0:03:51.89,0:03:55.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Masuk ke kamarku tanpa izin...
Dialogue: 0,0:03:55.02,0:03:58.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sungguh wanita tak berpendidikan\N‎yang tak punya akal sehat!
Dialogue: 0,0:04:02.36,0:04:06.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tak pernah kusangka kau yang akan\N‎menceramahiku soal akal sehat.
Dialogue: 0,0:04:06.70,0:04:08.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mengakulah.
Dialogue: 0,0:04:08.03,0:04:10.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa yang kau pakai untuk mengancam Ranma?
Dialogue: 0,0:04:14.33,0:04:16.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Aneh sekali, membuat tuduhan palsu itu.
Dialogue: 0,0:04:16.29,0:04:17.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Ranma dan aku sudah berpacaran.
Dialogue: 0,0:04:19.30,0:04:20.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Omong kosong macam apa itu?
Dialogue: 0,0:04:21.80,0:04:23.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jika kau pikir aku berbohong,
Dialogue: 0,0:04:23.51,0:04:25.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎coba lihat ke belakangmu.
Dialogue: 0,0:04:32.14,0:04:35.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ranma-ku, rupanya kau sudah kembali.
Dialogue: 0,0:04:35.73,0:04:38.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kapan kau membuat hal seperti ini?
Dialogue: 0,0:04:38.82,0:04:41.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Foto apa itu tadi?\N‎- Diamlah.
Dialogue: 0,0:04:45.78,0:04:47.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎- Hei, Kodachi.\N‎- Ya?
Dialogue: 0,0:04:47.74,0:04:50.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku juga mau salinan foto ini\N‎sebagai kenang-kenangan.
Dialogue: 0,0:04:50.91,0:04:54.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa Ranma-ku juga mau satu\N‎untuk dipajang di kamarmu?
Dialogue: 0,0:04:54.79,0:04:57.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya, tentu. Boleh juga.
Dialogue: 0,0:04:57.75,0:04:59.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Benarkah?
Dialogue: 0,0:05:00.09,0:05:02.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi, ya ampun.
Dialogue: 0,0:05:02.26,0:05:04.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Kalung tempat disembunyikannya\N‎klise foto itu...{\i0}
Dialogue: 0,0:05:13.64,0:05:14.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tak bisa dilepas.
Dialogue: 0,0:05:15.52,0:05:18.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sabuk itu terbuat\N‎dari paduan logam konfigurasi memori.{\i0}
Dialogue: 0,0:05:18.81,0:05:21.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hanya ada satu cara untuk melepasnya\N‎tanpa tersengat listrik.
Dialogue: 0,0:05:21.73,0:05:23.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yaitu merendamnya di air panas.
Dialogue: 0,0:05:28.49,0:05:30.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tatewaki-senpai!
Dialogue: 0,0:05:31.70,0:05:34.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ayo kita mandi bersama.
Dialogue: 0,0:05:35.33,0:05:36.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Bersama...{\i0}
Dialogue: 0,0:05:42.25,0:05:43.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa...
Dialogue: 0,0:05:43.80,0:05:47.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa kau bilang mandi bersama?
Dialogue: 0,0:05:50.34,0:05:52.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau tak boleh begitu, Gadis Berkepang.
Dialogue: 0,0:05:52.26,0:05:54.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau harus lebih menghargai dirimu sendiri!
Dialogue: 0,0:05:54.97,0:05:57.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Seharusnya kita menjalani
Dialogue: 0,0:05:57.23,0:05:59.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎kisah cinta anak SMA
Dialogue: 0,0:05:59.40,0:06:01.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎yang murni, jujur, dan pantas!
Dialogue: 0,0:06:07.90,0:06:11.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tidak bisa melepas kimonoku\N‎karena sabuk ini!
Dialogue: 0,0:06:11.12,0:06:12.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan menangis!
Dialogue: 0,0:06:14.33,0:06:15.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Omong-omong,
Dialogue: 0,0:06:16.62,0:06:19.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎apa kau pernah berciuman
Dialogue: 0,0:06:20.58,0:06:21.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎dengan Ranma-ku?
Dialogue: 0,0:06:30.22,0:06:32.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Belum, 'kan? Tidak pernah, 'kan?
Dialogue: 0,0:06:33.26,0:06:34.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tentu saja belum.
Dialogue: 0,0:06:35.01,0:06:36.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jelas tidak pernah!
Dialogue: 0,0:06:38.10,0:06:40.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Lalu apa kau pernah?
Dialogue: 0,0:06:44.98,0:06:46.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Coba lihat itu.
Dialogue: 0,0:06:56.37,0:06:58.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tatewaki-senpai!
Dialogue: 0,0:06:59.25,0:07:02.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Cepatlah!
Dialogue: 0,0:07:03.42,0:07:05.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Masuk ke bak mandi berpakaian lengkap...
Dialogue: 0,0:07:06.13,0:07:10.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak bisa melakukan hal\N‎yang tak masuk akal sehat.
Dialogue: 0,0:07:11.18,0:07:13.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Memangnya kau pernah punya akal sehat?
Dialogue: 0,0:07:22.23,0:07:24.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baiklah, akan kulepas semuanya.
Dialogue: 0,0:07:27.32,0:07:29.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sungguh godaan yang polos.
Dialogue: 0,0:07:29.65,0:07:31.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Gadis yang manis sekali.
Dialogue: 0,0:07:31.49,0:07:33.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku datang sekarang, Gadis Berkepang!
Dialogue: 0,0:07:43.46,0:07:44.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya! Itu klise fotonya!
Dialogue: 0,0:07:46.13,0:07:47.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dapat.
Dialogue: 0,0:07:48.25,0:07:50.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sekarang kemarilah, Gadis Berkepang.
Dialogue: 0,0:07:50.92,0:07:53.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dengan begini,\N‎tidak ada lagi yang perlu kutakutkan.
Dialogue: 0,0:08:00.39,0:08:01.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa?
Dialogue: 0,0:08:02.60,0:08:05.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dasar pria hidung belang menjijikkan!
Dialogue: 0,0:08:07.15,0:08:09.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei! Kau bicara omong kosong apa?
Dialogue: 0,0:08:15.87,0:08:18.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maafkan aku, Ranma-ku.
Dialogue: 0,0:08:18.37,0:08:20.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu rahasia di antara kita berdua,
Dialogue: 0,0:08:20.79,0:08:22.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎tapi aku tak sengaja memamerkannya.
Dialogue: 0,0:08:23.62,0:08:24.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Itu foto palsu.
Dialogue: 0,0:08:26.38,0:08:28.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Alasan yang buruk sekali.
Dialogue: 0,0:08:28.92,0:08:31.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bukan begitu maksudku. Lihat ini.
Dialogue: 0,0:08:32.76,0:08:34.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Lihat, ini...
Dialogue: 0,0:08:34.05,0:08:36.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Foto momen sebelum kami berciuman.
Dialogue: 0,0:08:36.72,0:08:39.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa urusannya klise foto itu?
Dialogue: 0,0:08:39.85,0:08:43.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Karena rahasia kita sudah terungkap,\N‎tak perlunya lagi bersembunyi-sembunyi.
Dialogue: 0,0:08:47.61,0:08:51.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Mari kita berciuman secara terang-terangan\N‎dan terbuka.
Dialogue: 0,0:08:51.86,0:08:54.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak!
Dialogue: 0,0:08:55.20,0:08:56.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dingin sekali!
Dialogue: 0,0:08:57.24,0:08:58.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Di mana Ranma-ku?
Dialogue: 0,0:08:58.57,0:09:00.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Silakan lakukan sebanyak apa pun\N‎yang kalian mau.
Dialogue: 0,0:09:02.33,0:09:04.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Gadis Berkepang!
Dialogue: 0,0:09:04.58,0:09:08.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau! Di mana kau sembunyikan Ranma-ku?
Dialogue: 0,0:09:08.08,0:09:09.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dasar hidung belang!
Dialogue: 0,0:09:09.71,0:09:12.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Akane! Hei! Mari kita bicara dulu...
Dialogue: 0,0:09:14.59,0:09:15.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bawa aku, kita kabur!
Dialogue: 0,0:09:16.51,0:09:18.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tatewaki-senpai, apa kau membelanya?
Dialogue: 0,0:09:20.68,0:09:23.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Siapa yang akan kau pilih? Aku atau Akane?
Dialogue: 0,0:09:32.48,0:09:36.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Akane Tendo.\N‎Hatiku akan mencintaimu selamanya!
Dialogue: 0,0:09:36.70,0:09:37.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Berhenti!
Dialogue: 0,0:09:37.78,0:09:40.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ayo tangkap aku!
Dialogue: 0,0:09:40.66,0:09:42.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dasar pengecut!
Dialogue: 0,0:09:50.25,0:09:51.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia berhasil kabur.
Dialogue: 0,0:09:52.55,0:09:54.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Saat aku menemukanmu,
Dialogue: 0,0:09:54.30,0:09:56.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎habislah kau!
Dialogue: 0,0:09:58.47,0:10:01.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Maafkan aku, Akane Tendo.{\i0}
Dialogue: 0,0:10:01.22,0:10:04.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Akane bodoh.\N‎Kenapa dia tidak mau mendengarkanku?{\i0}
Dialogue: 0,0:10:21.57,0:10:22.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baiklah.
Dialogue: 0,0:10:25.54,0:10:27.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf, Tatewaki-senpai.
Dialogue: 0,0:10:31.04,0:10:34.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Di mana si bodoh Ranma itu bersembunyi?
Dialogue: 0,0:10:34.42,0:10:35.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Di sini?
Dialogue: 0,0:10:39.01,0:10:40.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Di sini?
Dialogue: 0,0:10:41.72,0:10:43.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terimalah nasibmu dan keluarlah.
Dialogue: 0,0:10:47.10,0:10:49.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Sudah kubilang foto itu palsu.{\i0}
Dialogue: 0,0:10:50.52,0:10:52.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Akane benar-benar kepala batu.
Dialogue: 0,0:10:54.07,0:10:57.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa kau di sini? Di sini? Di sini?
Dialogue: 0,0:11:04.95,0:11:06.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dasar Ranma...
Dialogue: 0,0:11:07.04,0:11:09.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau tak akan bisa kabur dariku.
Dialogue: 0,0:11:14.96,0:11:18.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ini makin menyebalkan. Pulang saja sana.
Dialogue: 0,0:11:30.48,0:11:32.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ranma!
Dialogue: 0,0:11:35.52,0:11:37.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kena kau!
Dialogue: 0,0:11:48.74,0:11:50.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya ampun.
Dialogue: 0,0:12:01.22,0:12:03.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau sedang apa?
Dialogue: 0,0:12:04.59,0:12:05.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Entahlah.
Dialogue: 0,0:12:06.35,0:12:08.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Akane Tendo!
Dialogue: 0,0:12:08.89,0:12:10.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maafkan soal yang tadi.
Dialogue: 0,0:12:10.85,0:12:13.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bagaimanapun juga,\N‎cuma kau seorang bagiku.
Dialogue: 0,0:12:17.36,0:12:18.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Butuh bantuan?
Dialogue: 0,0:12:20.65,0:12:21.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Siapa yang butuh?
Dialogue: 0,0:12:22.99,0:12:26.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Akane Tendo...
Dialogue: 0,0:12:30.20,0:12:34.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎"Maaf karena meragukanmu.\N‎Tolong bantu aku." Benar?
Dialogue: 0,0:12:36.17,0:12:39.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa? Kau mau memanfaatkan situasi ini?
Dialogue: 0,0:12:40.63,0:12:41.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baiklah.
Dialogue: 0,0:12:42.76,0:12:44.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Lakukan saja sendiri,
Dialogue: 0,0:12:44.93,0:12:46.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎dasar wanita berotot.
Dialogue: 0,0:12:46.68,0:12:49.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Wanita berotot...{\i0}
Dialogue: 0,0:12:50.22,0:12:52.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Siapa juga yang ingin bantuanmu...
Dialogue: 0,0:12:58.81,0:13:00.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei, Akane.
Dialogue: 0,0:13:00.82,0:13:02.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bangun.
Dialogue: 0,0:13:03.74,0:13:05.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jangan lakukan itu, Ranma-ku.
Dialogue: 0,0:13:07.07,0:13:10.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Jika kau buka paksa perangkap tikus itu,\N‎kau akan tersengat listrik.
Dialogue: 0,0:13:11.83,0:13:14.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku punya kuncinya.
Dialogue: 0,0:13:14.50,0:13:15.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kunci?
Dialogue: 0,0:13:16.62,0:13:17.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Benar.
Dialogue: 0,0:13:20.21,0:13:25.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak sengaja menjatuhkan kuncinya\N‎ke salah satu hidangan yang kubuat ini.
Dialogue: 0,0:13:33.60,0:13:34.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baiklah.
Dialogue: 0,0:13:41.61,0:13:43.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ini tidak beracun.
Dialogue: 0,0:13:52.95,0:13:54.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Lezatkah?
Dialogue: 0,0:13:57.00,0:14:01.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei, Ranma. Kenapa kau malah duduk\N‎dan makan seolah tak ada apa-apa?
Dialogue: 0,0:14:01.17,0:14:03.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Diamlah. Tunggu saja.
Dialogue: 0,0:14:04.92,0:14:07.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Nafsu makanmu besar sekali.
Dialogue: 0,0:14:07.84,0:14:12.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tak menyangka kau amat menikmati\N‎masakan rumahanku.
Dialogue: 0,0:14:12.01,0:14:15.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku sangat bahagia.
Dialogue: 0,0:14:20.35,0:14:22.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Padahal kau tidak{\i0}
Dialogue: 0,0:14:23.07,0:14:27.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎mencicipi kukisku sedikit pun!{\i0}
Dialogue: 0,0:14:33.24,0:14:34.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Ketemu. Kuncinya.{\i0}
Dialogue: 0,0:14:38.96,0:14:41.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Akane, aku akan mengeluarkanmu\N‎dari sana sekarang.{\i0}
Dialogue: 0,0:14:42.92,0:14:45.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Maaf kalau masakanku
Dialogue: 0,0:14:45.67,0:14:49.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎sangat tidak enak!
Dialogue: 0,0:14:54.64,0:14:56.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei!
Dialogue: 0,0:14:56.77,0:14:58.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa?
Dialogue: 0,0:15:05.07,0:15:09.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terlalu cemburu itu sama sekali\N‎tidak manis, tahu?
Dialogue: 0,0:15:10.24,0:15:12.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Omong kosong macam apa itu?
Dialogue: 0,0:15:12.36,0:15:14.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Untuk apa aku cemburu?
Dialogue: 0,0:15:15.24,0:15:17.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Lalu kenapa kau marah sekali?
Dialogue: 0,0:15:17.62,0:15:20.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Bukan urusanmu aku mau makan\N‎masakan rumahannya siapa.
Dialogue: 0,0:15:20.62,0:15:22.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa kau ada masalah dengan itu?
Dialogue: 0,0:15:26.92,0:15:28.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Cukup. Aku mau pulang.
Dialogue: 0,0:15:32.76,0:15:34.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Apa? Dia mengalah semudah itu.{\i0}
Dialogue: 0,0:15:43.35,0:15:46.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Asal tahu saja,\N‎aku sama sekali tidak cemburu.
Dialogue: 0,0:15:47.82,0:15:49.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dasar bodoh!
Dialogue: 0,0:15:49.23,0:15:54.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tidak akan menolong\N‎wanita kasar sepertimu lagi...
Dialogue: 0,0:16:00.54,0:16:03.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Obat pelumpuh yang kucampur\N‎ke dalam makanan
Dialogue: 0,0:16:03.83,0:16:05.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎akhirnya mulai bereaksi.
Dialogue: 0,0:16:05.92,0:16:07.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sialan.
Dialogue: 0,0:16:07.75,0:16:12.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Kini penghalangnya\N‎sudah tak ada, Ranma-ku,
Dialogue: 0,0:16:12.26,0:16:16.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎mari kita nikmati\N‎waktu privat kita bersama.
Dialogue: 0,0:16:41.33,0:16:44.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}‎Bukan urusanmu aku mau makan\N‎masakan rumahannya siapa.{\i0}
Dialogue: 0,0:16:57.18,0:16:58.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Akane.
Dialogue: 0,0:17:02.43,0:17:04.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kenapa kau tampak murung sekali?
Dialogue: 0,0:17:13.82,0:17:14.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Benarkah?
Dialogue: 0,0:17:15.65,0:17:18.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ranma benar-benar bajingan.
Dialogue: 0,0:17:20.41,0:17:22.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi itu sudah tidak penting lagi.
Dialogue: 0,0:17:26.08,0:17:29.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kalau begitu, boleh kujual ini ke Kuno?
Dialogue: 0,0:17:31.88,0:17:33.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Silakan saja.
Dialogue: 0,0:17:33.26,0:17:34.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Akane.
Dialogue: 0,0:17:37.09,0:17:41.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi bukankah Ranma sedang diancam?
Dialogue: 0,0:17:42.35,0:17:45.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Pasti itu alasan dia memakan masakannya.
Dialogue: 0,0:17:46.31,0:17:48.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Yang kita bicarakan adalah adik dari Kuno.
Dialogue: 0,0:17:48.56,0:17:50.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dia pasti akan lakukan itu.
Dialogue: 0,0:17:57.74,0:17:58.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tidak apa-apa.
Dialogue: 0,0:18:00.20,0:18:03.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau sudah kerja keras memanggangnya.
Dialogue: 0,0:18:03.74,0:18:06.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ayo kita buat Ranma bilang\N‎bahwa kukis ini lezat.
Dialogue: 0,0:18:19.97,0:18:21.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei. Lepaskan...
Dialogue: 0,0:18:22.81,0:18:24.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau. Apa yang kau rencanakan?
Dialogue: 0,0:18:24.68,0:18:26.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Baiklah, Ranma-ku.
Dialogue: 0,0:18:27.31,0:18:30.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Mari kita ubah foto palsu itu\N‎menjadi nyata.
Dialogue: 0,0:18:32.06,0:18:34.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Sekarang bukan waktunya bercanda. Hei!
Dialogue: 0,0:18:36.03,0:18:37.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Palsu?
Dialogue: 0,0:18:37.74,0:18:41.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Begitu, ya? Jadi, Ranma berkata jujur.
Dialogue: 0,0:18:46.45,0:18:47.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku bisa dengan mudah...
Dialogue: 0,0:18:50.71,0:18:53.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Terima nasibmu dan kita berciuman.
Dialogue: 0,0:18:56.88,0:18:57.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Apa?
Dialogue: 0,0:19:01.76,0:19:05.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau harus tahu kapan waktunya menyerah.
Dialogue: 0,0:19:15.27,0:19:16.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau...
Dialogue: 0,0:19:19.28,0:19:22.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ciuman? Coba saja kalau kau bisa.
Dialogue: 0,0:19:26.16,0:19:29.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ranma-ku. Lampu gantung itu...
Dialogue: 0,0:19:33.75,0:19:35.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎berbahaya.
Dialogue: 0,0:19:40.84,0:19:42.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau...
Dialogue: 0,0:19:44.97,0:19:46.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tampan sekali.
Dialogue: 0,0:19:47.89,0:19:50.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ranma-ku.
Dialogue: 0,0:19:53.10,0:19:54.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Panas!
Dialogue: 0,0:20:02.82,0:20:04.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Dasar iblis jahat.
Dialogue: 0,0:20:10.04,0:20:11.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ranma-ku?
Dialogue: 0,0:20:23.30,0:20:24.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kukis.
Dialogue: 0,0:20:31.73,0:20:32.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Hei.
Dialogue: 0,0:20:39.27,0:20:40.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau meninggalkan ini.
Dialogue: 0,0:20:43.24,0:20:44.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aku tidak butuh.
Dialogue: 0,0:20:45.66,0:20:46.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Benarkah?
Dialogue: 0,0:20:47.57,0:20:49.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kalau begitu, akan kuhabiskan semuanya.
Dialogue: 0,0:20:55.29,0:20:56.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Boleh, 'kan?
Dialogue: 0,0:21:02.05,0:21:03.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ya.
Dialogue: 0,0:21:10.10,0:21:12.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Ranma bilang dia sedang kurang enak badan.
Dialogue: 0,0:21:12.60,0:21:14.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kira-kira kenapa, ya?
Dialogue: 0,0:21:14.48,0:21:15.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Kau tahu ini akan terjadi.
Dialogue: 0,0:21:17.19,0:21:18.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Tapi kau tetap memakannya.
Dialogue: 0,0:21:23.69,0:21:26.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}‎Aneh sekali. Padahal aku\N‎sudah bekerja keras memanggangnya.
Dialogue: 0,0:22:57.00,0:23:02.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}‎Terjemahan subtitle oleh Rio Wibowo\N‎Pengawas Produksi: Ranma1/2 Project
