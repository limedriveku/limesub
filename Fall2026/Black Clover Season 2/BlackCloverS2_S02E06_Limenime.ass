Dialogue: 0,0:03:24.18,0:03:27.90,sign,,0000,0000,0000,,EPISODE 176\NVALKYRIE YANG SUCI
Dialogue: 0,0:00:02.43,0:00:04.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senior Magna!
Dialogue: 0,0:00:05.13,0:00:06.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asta, Luck.
Dialogue: 0,0:00:11.86,0:00:13.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dan Komandan Yami saja
Dialogue: 0,0:00:13.48,0:00:16.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}harus maju berdua untuk mengalahkannya.
Dialogue: 0,0:00:16.82,0:00:19.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senior Magna keren banget!
Dialogue: 0,0:00:21.44,0:00:22.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah jelas, lah.
Dialogue: 0,0:00:22.82,0:00:24.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan remehkan seniormu ini, ya.
Dialogue: 0,0:00:24.75,0:00:27.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Keren! Jantan banget!\N- Ya, dong.
Dialogue: 0,0:00:27.32,0:00:29.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kau kelihatan jantan banget!\N- Magna.
Dialogue: 0,0:00:30.14,0:00:33.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak sabar ingin bertarung melawanmu.
Dialogue: 0,0:00:35.03,0:00:37.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang akan jadi pemenangnya, Luck.
Dialogue: 0,0:00:40.51,0:00:42.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya orang biasa.
Dialogue: 0,0:00:42.78,0:00:45.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu, aku cukup kuat\Nuntuk menjabat sebagai komandan.
Dialogue: 0,0:00:46.09,0:00:48.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak kalah kuat\Ndari keluarga bangsawan atau wangsa.
Dialogue: 0,0:00:49.35,0:00:52.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga memasukkan orang biasa\Nke dalam pasukanku.
Dialogue: 0,0:00:52.64,0:00:56.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, saat Yami memasukkan rakyat jelata\Nke dalam pasukannya,
Dialogue: 0,0:00:56.26,0:00:58.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kupikir itu keputusan yang konyol.
Dialogue: 0,0:00:59.37,0:01:00.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sialan!
Dialogue: 0,0:01:01.87,0:01:04.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah memberikan tontonan menarik.
Dialogue: 0,0:01:05.51,0:01:08.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan anggota Dark Triad\Ndengan kekuatan iblis 100 persen
Dialogue: 0,0:01:08.66,0:01:11.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}harusnya setara dengan kekuatan\Niblis tingkat tertinggi.
Dialogue: 0,0:01:12.55,0:01:14.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi dia bisa mengalahkannya...?
Dialogue: 0,0:01:14.96,0:01:16.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak tahu dia pakai teknik apa,
Dialogue: 0,0:01:17.07,0:01:18.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi ini kejutan yang menggembirakan.
Dialogue: 0,0:01:20.19,0:01:21.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa pun itu, sekarang...
Dialogue: 0,0:01:29.36,0:01:31.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makin banyak iblis yang bermunculan.
Dialogue: 0,0:01:32.76,0:01:34.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh pemandangan yang indah.
Dialogue: 0,0:01:48.08,0:01:49.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dante telah dikalahkan?
Dialogue: 0,0:01:50.78,0:01:53.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku penasaran, sihir apa yang mengalahkannya.
Dialogue: 0,0:01:55.01,0:01:57.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengalahkan satu orang anggota Dark Triad
Dialogue: 0,0:01:57.00,0:01:58.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pasti menurunkan efisiensi kekuatan Qliphoth.
Dialogue: 0,0:01:59.72,0:02:01.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kita perlu mengalahkan\Ndua anggota lainnya
Dialogue: 0,0:02:01.90,0:02:04.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk menghentikan Qliphoth.
Dialogue: 0,0:02:05.84,0:02:08.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Persediaanku tinggal sedikit\Ndan tak bisa memulihkan sepenuhnya...
Dialogue: 0,0:02:09.15,0:02:11.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini, aku bawa camilan pemulih, makanlah.
Dialogue: 0,0:02:11.98,0:02:15.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mantap! Aku pasti akan menolong Yami!
Dialogue: 0,0:02:15.51,0:02:16.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, aku yang menolongnya!
Dialogue: 0,0:02:16.58,0:02:18.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan. Aku yang menolongnya.
Dialogue: 0,0:02:18.40,0:02:20.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Efek sihir anggota lain terlalu kuat
Dialogue: 0,0:02:20.00,0:02:22.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sehingga aku tidak bisa\Nmembawa kalian pergi lewat bayangan.
Dialogue: 0,0:02:22.68,0:02:24.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ayo bergegas.\N- Berangkat!
Dialogue: 0,0:02:43.47,0:02:46.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana mungkin aku\Ndikalahkan orang sepertinya?!
Dialogue: 0,0:02:46.97,0:02:49.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini tidak mungkin terjadi!
Dialogue: 0,0:02:49.53,0:02:52.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anggota Dark Triad memang beda, ya.
Dialogue: 0,0:02:53.73,0:02:57.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Regenerasi daya sihirnya pun\Nluar biasa cepat.
Dialogue: 0,0:02:59.03,0:03:04.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayangnya sihir tubuh kebanggaanmu\Nsudah lepas kendali.
Dialogue: 0,0:03:04.19,0:03:05.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berisik!
Dialogue: 0,0:03:05.78,0:03:07.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ini abadi!
Dialogue: 0,0:03:07.37,0:03:10.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kubunuh...\NAku akan menghancurkan kalian semua!
Dialogue: 0,0:03:10.56,0:03:12.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mungkin kalah!
Dialogue: 0,0:03:12.47,0:03:14.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau itu terlalu banyak bicara.
Dialogue: 0,0:03:15.63,0:03:18.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, aku tidak benci orang\Nyang tidak mudah menyerah.
Dialogue: 0,0:03:18.88,0:03:21.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cacing sepertimu tidak berhak\Nmerusak kemenangannya!
Dialogue: 0,0:03:38.67,0:03:40.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah menahan sihir segel kutukannya\Ndengan mawar biru,
Dialogue: 0,0:03:40.91,0:03:42.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi sihir darahnya sendiri pun\Nsudah sangat kuat.
Dialogue: 0,0:03:43.43,0:03:44.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu...
Dialogue: 0,0:03:44.75,0:03:48.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya "kerja sama tim" kami\Nyang lebih kuat.
Dialogue: 0,0:03:49.14,0:03:51.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, 'kan? Lolopechka sayang!
Dialogue: 0,0:03:52.05,0:03:53.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah menduga kau sangat kuat
Dialogue: 0,0:03:53.40,0:03:57.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jika menyerang dengan sekuat tenaga,\NLolopechka sayang.
Dialogue: 0,0:03:57.77,0:04:01.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengamuk dengan sekuat tenaga itu seru, 'kan?
Dialogue: 0,0:04:01.62,0:04:02.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lolopechka!
Dialogue: 0,0:04:02.75,0:04:05.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Lukisan: Souterrain Raksasa!
Dialogue: 0,0:04:06.74,0:04:09.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serang dia, Lolopechka sayang!
Dialogue: 0,0:04:23.18,0:04:25.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daya sihirnya memang sudah sangat kuat,
Dialogue: 0,0:04:25.63,0:04:27.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kutukan itu membuatnya makin kuat.
Dialogue: 0,0:04:30.91,0:04:32.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ratu Lolopechka.
Dialogue: 0,0:04:32.81,0:04:36.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu betapa menyakitkan dan frustrasinya\Nsaat tubuhmu dirampas orang lain.
Dialogue: 0,0:04:37.51,0:04:40.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bersumpah akan melepaskan kutukan itu!
Dialogue: 0,0:04:46.36,0:04:49.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kalian tidak menikmati pertarungannya?
Dialogue: 0,0:04:49.78,0:04:52.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu yang membuat kalian kalah, tahu.
Dialogue: 0,0:04:53.52,0:04:54.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Charlotte!
Dialogue: 0,0:05:03.75,0:05:06.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku datang menepati janji kita, Vanica!
Dialogue: 0,0:05:07.99,0:05:09.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Lolopechka!
Dialogue: 0,0:05:09.57,0:05:13.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Noelle, apa kau sudah bertambah kuat?
Dialogue: 0,0:05:13.29,0:05:16.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah bertambah kuat sekarang.
Dialogue: 0,0:05:16.25,0:05:17.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau masih bisa bermain denganku?
Dialogue: 0,0:05:19.90,0:05:21.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beraninya kau melakukan itu pada Lolopechka.
Dialogue: 0,0:05:22.46,0:05:24.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja, Vanica.
Dialogue: 0,0:05:24.91,0:05:26.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku...
Dialogue: 0,0:05:27.69,0:05:30.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami pasti akan mengalahkanmu!
Dialogue: 0,0:05:32.19,0:05:33.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga.
Dialogue: 0,0:05:35.68,0:05:38.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah Undine melayani Ratu Lolopechka?\NKenapa dia...?
Dialogue: 0,0:05:39.82,0:05:40.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Noelle.
Dialogue: 0,0:05:42.60,0:05:45.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebelum Sihir Pemungkas dan sejenisnya,
Dialogue: 0,0:05:45.67,0:05:48.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ada kekuatan yang harus kau kuasai\Nterlebih dahulu.
Dialogue: 0,0:05:48.63,0:05:49.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan apa?
Dialogue: 0,0:05:51.68,0:05:53.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, 'kan?
Dialogue: 0,0:05:57.47,0:06:00.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Undine?! Ternyata kau baik-baik saja.
Dialogue: 0,0:06:00.36,0:06:01.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kenapa...?
Dialogue: 0,0:06:04.12,0:06:06.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir segel kutukan melemahkan kekuatanku
Dialogue: 0,0:06:06.98,0:06:10.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan memutus kontrakku dengan Lolopechka\Nuntuk sementara waktu.
Dialogue: 0,0:06:11.17,0:06:15.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi mendapatkan kembali kekuatanku\Ndan mengumpulkan mana,
Dialogue: 0,0:06:15.31,0:06:18.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku pindah ke dalam Grimoire\Nmilik penyihir berbakat lain.
Dialogue: 0,0:06:18.88,0:06:20.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Noelle, kaulah orangnya.
Dialogue: 0,0:06:21.92,0:06:25.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau memiliki bakat\Nuntuk menjadi Pengguna Roh Air.
Dialogue: 0,0:06:25.52,0:06:27.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Vanica menggunakan setengah tubuhnya
Dialogue: 0,0:06:27.93,0:06:30.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk memunculkan\Niblis tingkat tertinggi, Megicula.
Dialogue: 0,0:06:31.17,0:06:33.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain penyihir Ranah Kelam,
Dialogue: 0,0:06:33.56,0:06:35.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ada orang lain yang mampu menghabisinya.
Dialogue: 0,0:06:35.98,0:06:39.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya Pengguna Roh yang bisa\Nmencapai ranah itu.
Dialogue: 0,0:06:39.37,0:06:42.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ranah yang mampu memurnikan\Nkejahatan dan menghancurkan iblis.
Dialogue: 0,0:06:42.81,0:06:43.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ranah Suci.
Dialogue: 0,0:06:44.70,0:06:46.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, 'kan, Undine?
Dialogue: 0,0:06:48.45,0:06:52.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kalau begitu, daripada mengandalkan\NAsta dan penyihir Ranah Kelam lain,
Dialogue: 0,0:06:52.08,0:06:56.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau bisa melatih Komandan Fuegoleon\Ndan Yuno yang sama-sama Pengguna Roh, 'kan?
Dialogue: 0,0:06:56.89,0:06:57.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlebih,
Dialogue: 0,0:06:57.70,0:06:59.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}daya sihir Lolopechka sangat besar.
Dialogue: 0,0:06:59.80,0:07:02.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau tidak mengajarinya\NRanah Suci ini?
Dialogue: 0,0:07:04.23,0:07:06.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dulu, aku...
Dialogue: 0,0:07:07.09,0:07:10.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kebetulan dekat\Ndengan ratu Kerajaan Heart
Dialogue: 0,0:07:10.49,0:07:11.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan memutuskan untuk melayaninya.
Dialogue: 0,0:07:12.87,0:07:15.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak itu,\Naku menyukai manusia Kerajaan Heart
Dialogue: 0,0:07:16.26,0:07:18.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan bersama-sama dengan Ratu\Nmelindungi kerajaan itu.
Dialogue: 0,0:07:19.26,0:07:21.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah sekian waktu berlalu,
Dialogue: 0,0:07:22.05,0:07:23.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku kemudian bertemu Lolopechka.
Dialogue: 0,0:07:25.65,0:07:29.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak kecil,\Ndia memiliki daya sihir yang besar
Dialogue: 0,0:07:29.43,0:07:33.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan dipercaya memiliki kemampuan\Nmenjadi ratu selanjutnya.
Dialogue: 0,0:07:34.09,0:07:38.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi dia berbeda dengan putri pada umumnya.
Dialogue: 0,0:07:38.93,0:07:43.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lolopechka tidak pernah bisa\Nmenguasai sihir ofensif mana pun.
Dialogue: 0,0:07:44.24,0:07:47.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia hanya bisa menciptakan boneka kesatria,
Dialogue: 0,0:07:47.17,0:07:49.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sihir yang wujudnya saja terlihat ofensif.
Dialogue: 0,0:07:49.30,0:07:50.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena hal itu pula,
Dialogue: 0,0:07:50.35,0:07:53.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia tidak bisa mencapai Ranah Suci\Ndan menghancurkan iblis.
Dialogue: 0,0:07:54.25,0:07:56.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis itu terlalu baik hati.
Dialogue: 0,0:08:01.11,0:08:06.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ratu gagal karena\Ntidak menguasai sihir ofensif, ya?
Dialogue: 0,0:08:08.39,0:08:10.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tidak benar, Lolopechka.
Dialogue: 0,0:08:12.01,0:08:15.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bangga pada kebaikan hatimu.
Dialogue: 0,0:08:16.21,0:08:18.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah, Undine?
Dialogue: 0,0:08:19.82,0:08:22.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak akan bilang siapa-siapa\Nsoal Ranah Suci.
Dialogue: 0,0:08:23.23,0:08:25.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini adalah bentuk keegoisanku.
Dialogue: 0,0:08:27.18,0:08:30.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa bodoh dengan pengguna iblis\Nyang lahir di Kerajaan Spade.
Dialogue: 0,0:08:30.35,0:08:32.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa bodoh dengan Vanica\Nyang mengincar Lolopechka.
Dialogue: 0,0:08:33.78,0:08:37.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku terus berusaha menjauhkan\NLolopechka dari pertempuran.
Dialogue: 0,0:08:39.55,0:08:42.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin dia terus menjadi\Ngadis yang baik hati.
Dialogue: 0,0:08:45.09,0:08:46.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Undine...
Dialogue: 0,0:08:48.41,0:08:49.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi pada akhirnya...
Dialogue: 0,0:08:49.57,0:08:52.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lolopechka dikutuk dan diculik.
Dialogue: 0,0:08:54.47,0:08:57.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata keputusanku ini salah.
Dialogue: 0,0:08:58.87,0:08:59.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau benar.
Dialogue: 0,0:09:00.72,0:09:03.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak memberi tahu soal Ranah Suci.
Dialogue: 0,0:09:03.60,0:09:05.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin itu keputusan yang salah.
Dialogue: 0,0:09:06.38,0:09:08.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi itu bentuk kebaikanmu, 'kan?
Dialogue: 0,0:09:10.35,0:09:11.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kebaikan
Dialogue: 0,0:09:11.57,0:09:13.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan menyayangi orang lain
Dialogue: 0,0:09:13.49,0:09:16.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak bisa disebut sebagai kesalahan!
Dialogue: 0,0:09:16.80,0:09:17.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Noelle.
Dialogue: 0,0:09:18.41,0:09:23.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita memang tidak akrab,\Ntapi tujuan kita sama.
Dialogue: 0,0:09:25.82,0:09:28.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi mengalahkan Vanica\Ndan menyelamatkan Lolopechka,
Dialogue: 0,0:09:28.76,0:09:30.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bekerja samalah denganku!
Dialogue: 0,0:09:34.95,0:09:39.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku hanya mengajarkannya\Nsesuatu yang bisa dinikmati.
Dialogue: 0,0:09:39.03,0:09:41.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Habisnya, aku yakin Lolopechka
Dialogue: 0,0:09:41.19,0:09:43.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sedang bersenang-senang!
Dialogue: 0,0:09:43.98,0:09:46.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, 'kan? Lolopechka sayang!
Dialogue: 0,0:09:47.29,0:09:50.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, ayo!\NKau yang di sana balas serangannya, dong!
Dialogue: 0,0:09:50.93,0:09:53.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian berdua bisa ikut bersenang-senang, lo!
Dialogue: 0,0:09:54.14,0:09:55.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, 'kan?!
Dialogue: 0,0:09:59.23,0:10:00.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan perbuatanmu itu.
Dialogue: 0,0:10:01.82,0:10:05.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, Noelle sayang.\NAyo kita bersenang-senang juga!
Dialogue: 0,0:10:06.16,0:10:07.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlebih,
Dialogue: 0,0:10:08.20,0:10:09.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}semua ini
Dialogue: 0,0:10:11.89,0:10:13.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}salahmu.
Dialogue: 0,0:10:15.80,0:10:18.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan memaafkanmu\Nkalau pertarungan kita hanya sebentar.
Dialogue: 0,0:10:19.26,0:10:23.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau harus menghiburku!
Dialogue: 0,0:10:23.34,0:10:25.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudahlah. Tutup mulutmu.
Dialogue: 0,0:10:27.38,0:10:31.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang sepertimu selalu berbuat seenaknya\Ndan tertawa seperti orang bodoh.
Dialogue: 0,0:10:31.40,0:10:34.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beraninya kau membuat orang\Nyang baik hati terluka dan menangis.
Dialogue: 0,0:10:37.64,0:10:39.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan menahan diri lagi!
Dialogue: 0,0:10:52.09,0:10:53.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Spirit Dive...
Dialogue: 0,0:11:00.70,0:11:02.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saint Valkyrie Dress!
Dialogue: 0,0:11:04.03,0:11:05.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan
Dialogue: 0,0:11:05.51,0:11:06.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kubinasakan kau!
Dialogue: 0,0:11:12.95,0:11:14.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sensasi dingin ini...
Dialogue: 0,0:11:14.91,0:11:18.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Darah: Gerombolan Binatang Merah!
Dialogue: 0,0:11:26.00,0:11:28.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Binatang merahnya dihancurkan.
Dialogue: 0,0:11:29.24,0:11:30.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penampilan dan kekuatannya berbeda jauh
Dialogue: 0,0:11:30.81,0:11:33.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan saat di Kerajaan Heart.
Dialogue: 0,0:11:36.93,0:11:38.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luar biasa!
Dialogue: 0,0:11:38.49,0:11:40.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah menunggu momen ini!
Dialogue: 0,0:11:42.02,0:11:46.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski mawar biru Charlotte melemahkan\Nsihir segel kutukannya,
Dialogue: 0,0:11:46.34,0:11:47.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Noelle hebat sekali!
Dialogue: 0,0:11:47.97,0:11:49.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi waktu kita terbatas.
Dialogue: 0,0:11:49.94,0:11:52.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Noelle, tolong kalahkan dia\Ndalam waktu satu menit.
Dialogue: 0,0:11:52.47,0:11:55.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu.\NAkan kuselesaikan dalam 30 detik!
Dialogue: 0,0:12:10.91,0:12:16.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat. Luar biasa.\NKau memang yang terbaik, Noelle sayang!
Dialogue: 0,0:12:18.79,0:12:21.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mirip dengan perasaan merinding\Nyang kurasakan waktu itu.
Dialogue: 0,0:12:22.11,0:12:25.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak salah,\NMegicula baru saja masuk ke dalam tubuhku.
Dialogue: 0,0:12:25.56,0:12:29.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin mencoba\Nkekuatan iblis dan mengamuk...
Dialogue: 0,0:12:29.57,0:12:32.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat itu, aku mendengar kabar\Nada wanita terkuat
Dialogue: 0,0:12:32.39,0:12:34.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang beristirahat secara diam-diam.
Dialogue: 0,0:12:34.78,0:12:38.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku pergi dari Kerajaan Spade\Nuntuk bermain dengannya.
Dialogue: 0,0:12:38.93,0:12:42.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau dan kekuatan iblis sama hebatnya!
Dialogue: 0,0:12:42.43,0:12:44.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hiburlah aku lagi!
Dialogue: 0,0:12:44.86,0:12:46.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Acier sayang!
Dialogue: 0,0:12:48.08,0:12:49.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita mulai!
Dialogue: 0,0:12:55.30,0:12:56.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Noelle, Nozel!
Dialogue: 0,0:12:57.15,0:13:00.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau ini berisik sekali. Jangan ganggu, ya.
Dialogue: 0,0:13:00.85,0:13:03.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kubunuh saja sekarang, ya?
Dialogue: 0,0:13:04.00,0:13:09.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini anakmu, Acier?\NKenapa kau melahirkan seorang anak?
Dialogue: 0,0:13:09.22,0:13:10.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bikin capek dan mengganggu.
Dialogue: 0,0:13:10.95,0:13:14.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perempuan kuat sepertimu tak butuh mereka!
Dialogue: 0,0:13:16.69,0:13:19.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kuberi tahu hal\Nyang paling kuat di dunia ini.
Dialogue: 0,0:13:20.48,0:13:21.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu adalah seorang ibu
Dialogue: 0,0:13:22.13,0:13:23.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang melindungi anaknya!
Dialogue: 0,0:13:31.58,0:13:32.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Segel Kutukan.
Dialogue: 0,0:13:39.53,0:13:42.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemudian, aku yang terluka parah saat itu
Dialogue: 0,0:13:42.91,0:13:45.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}memutuskan untuk kabur\Nmengikuti perintah Megicula.
Dialogue: 0,0:13:46.78,0:13:48.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingat sekarang!
Dialogue: 0,0:13:48.92,0:13:51.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi... Serang aku lagi!
Dialogue: 0,0:13:51.42,0:13:54.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Darah: Binatang Merah.
Dialogue: 0,0:13:55.27,0:13:57.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita lanjutkan pertarungan waktu itu!
Dialogue: 0,0:13:58.10,0:13:59.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Raungan Naga Laut!
Dialogue: 0,0:14:07.81,0:14:10.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terimalah pembalasan
Dialogue: 0,0:14:11.47,0:14:12.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atas semua perbuatanmu!
Dialogue: 0,0:14:22.22,0:14:24.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau memang yang terbaik,
Dialogue: 0,0:14:24.52,0:14:26.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Noelle sayang!
Dialogue: 0,0:16:05.13,0:16:07.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Noelle sayang!
Dialogue: 0,0:16:12.31,0:16:15.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, bagus. Teruskan, Noelle sayang!
Dialogue: 0,0:16:15.80,0:16:18.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi... Lagi...!
Dialogue: 0,0:16:27.21,0:16:31.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kaulah yang terbaik, Noelle sayang!
Dialogue: 0,0:16:59.99,0:17:02.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau kalah, Vanica.
Dialogue: 0,0:17:07.30,0:17:10.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi... terangsang!
Dialogue: 0,0:17:11.34,0:17:13.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perasaan macam apa ini?
Dialogue: 0,0:17:13.76,0:17:15.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan ini...
Dialogue: 0,0:17:16.26,0:17:18.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang disebut pertemanan?!
Dialogue: 0,0:17:18.40,0:17:21.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang giliranku\Nyang mengejar Noelle sayang, ya?
Dialogue: 0,0:17:21.59,0:17:23.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan ini\Nyang orang sebut persaingan?
Dialogue: 0,0:17:23.71,0:17:26.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo bertanding\Nsiapa yang bisa jadi lebih kuat...
Dialogue: 0,0:17:26.10,0:17:27.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan mimpi.
Dialogue: 0,0:17:29.44,0:17:31.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin kubiarkan semua berakhir
Dialogue: 0,0:17:31.46,0:17:33.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hanya karena kau merasa puas?
Dialogue: 0,0:17:35.30,0:17:37.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hidupmu berakhir di sini, Vanica.
Dialogue: 0,0:17:38.07,0:17:39.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga.
Dialogue: 0,0:17:40.01,0:17:43.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau memang menarik, Vanica.
Dialogue: 0,0:17:43.84,0:17:46.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi tidak boleh berakhir seperti ini.
Dialogue: 0,0:17:50.19,0:17:51.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daya sihir ini...!
Dialogue: 0,0:17:52.53,0:17:55.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lucifero dan yang lain belum sadar.
Dialogue: 0,0:17:56.03,0:18:00.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, tiga penyihir wanita\Ndengan daya sihir yang sangat besar.
Dialogue: 0,0:18:00.53,0:18:02.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jiwa mereka...
Dialogue: 0,0:18:03.34,0:18:06.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Persiapanku untuk bangkit di dunia ini\Nsudah rampung.
Dialogue: 0,0:18:09.66,0:18:11.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan kutukan ini...
Dialogue: 0,0:18:12.46,0:18:16.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin...\NTapi tidak salah lagi, dia adalah
Dialogue: 0,0:18:20.95,0:18:22.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Megicula sungguhan!
Dialogue: 0,0:18:24.86,0:18:28.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kasihan pada Vanica\Nyang sudah lama mendampingiku.
Dialogue: 0,0:18:29.45,0:18:32.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi jika Vanica dan Lolopechka mati...
Dialogue: 0,0:18:32.83,0:18:35.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan benar-benar muncul di dunia ini.
Dialogue: 0,0:18:35.59,0:18:36.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Lolopechka!
Dialogue: 0,0:18:41.20,0:18:43.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebelum itu,\Nkuizinkan kau mengamuk sekali lagi.
Dialogue: 0,0:18:45.41,0:18:47.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak akan kesepian\Njika mereka mati bersamamu.
Dialogue: 0,0:18:48.33,0:18:49.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan begitu?
Dialogue: 0,0:18:50.11,0:18:51.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wahai manusia.
Dialogue: 0,0:18:51.26,0:18:54.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Megicula...?\NKenapa kau ada di sini?
Dialogue: 0,0:18:55.04,0:18:58.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal baru satu gerbang dunia bawah\Nyang terbuka.
Dialogue: 0,0:18:58.33,0:18:59.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gerbang itu hanya jaminan.
Dialogue: 0,0:19:00.01,0:19:02.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tujuan utamaku adalah muncul menggunakan\NSihir Segel Kutukan,
Dialogue: 0,0:19:02.89,0:19:05.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malevolent Femcantation.
Dialogue: 0,0:19:05.86,0:19:09.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir ini membutuhkan tumbal\Nyang lumayan merepotkan.
Dialogue: 0,0:19:09.52,0:19:11.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Persiapannya sungguh memakan waktu.
Dialogue: 0,0:19:12.35,0:19:15.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wangsa dari Kerajaan Clover, Acier Silva.
Dialogue: 0,0:19:15.57,0:19:17.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat membunuhnya menggunakan kutukan,
Dialogue: 0,0:19:17.33,0:19:20.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}setengah dariku bisa muncul\Nmenggunakan tubuh Vanica.
Dialogue: 0,0:19:21.90,0:19:23.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibunda...!
Dialogue: 0,0:19:23.92,0:19:28.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu ada Vanica, pengguna iblis berbakat\Nyang menjalin kontrak denganku.
Dialogue: 0,0:19:28.24,0:19:30.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena dia sedang sekarat,
Dialogue: 0,0:19:30.34,0:19:33.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku bisa muncul meski tidak sepenuhnya.
Dialogue: 0,0:19:34.08,0:19:37.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, ratu Kerajaan Heart, Lolopechka.
Dialogue: 0,0:19:37.28,0:19:39.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika Vanica dan Lolopechka mati,
Dialogue: 0,0:19:40.17,0:19:43.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku bisa menampakkan\Nwujud seutuhnya di dunia ini.
Dialogue: 0,0:19:45.99,0:19:49.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Air Iblis: Darkneros Hydra.
Dialogue: 0,0:19:50.01,0:19:51.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daya sihir yang mengerikan ini...
Dialogue: 0,0:19:52.18,0:19:53.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau apakan Lolopechka?!
Dialogue: 0,0:19:54.04,0:19:55.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya memainkan kutukannya sedikit,
Dialogue: 0,0:19:56.03,0:19:58.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu mengubahnya menjadi iblis.
Dialogue: 0,0:19:58.84,0:20:02.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kupikir aku bisa memberikan\Nkenangan indah sebelum dia mati.
Dialogue: 0,0:20:03.01,0:20:04.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bercanda!
Dialogue: 0,0:20:05.14,0:20:07.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan mengalahkanmu sekarang juga...
Dialogue: 0,0:20:11.82,0:20:13.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihirnya menghilang...?
Dialogue: 0,0:20:13.33,0:20:16.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Segel Kutukan: Pembusukan Dunia.
Dialogue: 0,0:20:16.53,0:20:18.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini, efek, kecepatan,\Nserta kekuatan sihir ini
Dialogue: 0,0:20:18.65,0:20:21.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berbeda jauh dengan yang sebelumnya.
Dialogue: 0,0:20:25.90,0:20:28.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak akan kubiarkan kau berbuat seenaknya!
Dialogue: 0,0:20:29.15,0:20:32.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau manusia pertama\Nyang bisa menghalau kutukanku.
Dialogue: 0,0:20:33.28,0:20:36.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau hebat, Ratu Duri.
Dialogue: 0,0:20:37.79,0:20:40.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus melindungi Charlotte.
Dialogue: 0,0:20:40.56,0:20:43.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Segel Kutukan:\NBudak yang Tidak Terikat.
Dialogue: 0,0:20:44.84,0:20:48.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dapat inspirasi dari sihir indah Noelle.
Dialogue: 0,0:20:50.51,0:20:51.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Lukisan...
Dialogue: 0,0:20:53.54,0:20:55.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senja Valhalla.
Dialogue: 0,0:21:04.87,0:21:08.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Petir Sejati: Nadaras do Astrauza.
Dialogue: 0,0:21:16.90,0:21:22.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ratu gagal\Nkarena tidak menguasai sihir ofensif, ya?
Dialogue: 0,0:21:26.53,0:21:27.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku telah memutuskan
Dialogue: 0,0:21:28.51,0:21:32.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk menjadi penyihir ofensif terkuat\Ndi Kerajaan Heart.
Dialogue: 0,0:21:33.13,0:21:35.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi mengalahkan semua musuh di depan mata.
Dialogue: 0,0:21:36.66,0:21:40.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menggantikan dirimu.
Dialogue: 0,0:21:45.44,0:21:47.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi...
Dialogue: 0,0:22:00.06,0:22:01.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teman-teman!
Dialogue: 0,0:22:08.77,0:22:11.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Spirit Dive-nya terlepas...
Dialogue: 0,0:22:13.19,0:22:14.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian...
Dialogue: 0,0:22:17.81,0:22:19.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalah.
