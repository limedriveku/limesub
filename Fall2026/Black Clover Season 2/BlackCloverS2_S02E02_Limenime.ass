Dialogue: 0,0:04:18.70,0:04:24.10,sign,,0000,0000,0000,,EPISODE 172\NPINTU MENUJU NERAKA
Dialogue: 0,0:00:11.23,0:00:12.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mempan?!
Dialogue: 0,0:00:12.38,0:00:15.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil makhluk itu dikalahkan!
Dialogue: 0,0:00:18.03,0:00:22.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat itu, aku menyadari ada\Nyang kebal terhadap sihirku.
Dialogue: 0,0:00:30.58,0:00:32.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau terlihat asing.
Dialogue: 0,0:00:36.25,0:00:37.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada perlu apa?
Dialogue: 0,0:00:38.84,0:00:41.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau memang mengejutkan sesuai rumornya,
Dialogue: 0,0:00:41.80,0:00:43.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi tolong pakai baju dulu.
Dialogue: 0,0:00:45.51,0:00:49.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau menarik juga, mau coba bertarung?
Dialogue: 0,0:00:49.67,0:00:51.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mau.
Dialogue: 0,0:00:52.27,0:00:54.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, Yami dan Vangeance?
Dialogue: 0,0:00:55.27,0:00:58.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski aku tak peduli\Ndua pengecut itu diculik,
Dialogue: 0,0:00:58.79,0:01:01.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tertarik pada penculiknya.
Dialogue: 0,0:01:02.82,0:01:07.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kusiapkan lawan terbaik\Nuntuk menguji hasil latihanmu.
Dialogue: 0,0:01:12.87,0:01:14.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar
Dialogue: 0,0:01:15.13,0:01:16.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menarik!
Dialogue: 0,0:01:20.80,0:01:23.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata aku masih bisa bertambah kuat.
Dialogue: 0,0:01:25.46,0:01:26.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Api:
Dialogue: 0,0:01:34.43,0:01:36.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perwujudan Api Neraka!
Dialogue: 0,0:01:37.89,0:01:41.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Da-Daya sihir yang luar biasa!
Dialogue: 0,0:01:41.60,0:01:45.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seolah tubuhnya adalah mana itu sendiri!
Dialogue: 0,0:02:00.50,0:02:03.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk membakar habis semuanya,
Dialogue: 0,0:02:03.67,0:02:06.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan kukalahkan sang legenda!
Dialogue: 0,0:02:27.44,0:02:30.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana Zone: Pelepasan Penuh!
Dialogue: 0,0:02:33.78,0:02:38.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Api Penyucian Calidus Brachium: Neraka!
Dialogue: 0,0:02:47.71,0:02:49.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidurlah lagi.
Dialogue: 0,0:02:50.01,0:02:53.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kali ini, untuk selamanya!
Dialogue: 0,0:04:28.47,0:04:33.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata tikus yang menyelinap\Nbukan anggota Resistance?
Dialogue: 0,0:04:33.43,0:04:36.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau masih hidup?
Dialogue: 0,0:04:37.02,0:04:39.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkat sihir Komandan Vangeance.
Dialogue: 0,0:04:40.14,0:04:42.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Komandan akan kurebut kembali
Dialogue: 0,0:04:42.85,0:04:44.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}setelah mengalahkanmu!
Dialogue: 0,0:04:46.65,0:04:48.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu kekuatannya.
Dialogue: 0,0:04:48.94,0:04:51.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertahanan mutlak dari sihir tulang.
Dialogue: 0,0:04:51.57,0:04:54.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kepadatan dan regenerasi super.
Dialogue: 0,0:04:54.20,0:04:57.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Umumnya serangan fisik tidak akan mempan!
Dialogue: 0,0:04:57.62,0:05:00.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, mau bertindak bodoh?
Dialogue: 0,0:05:01.29,0:05:05.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal umurmu akan lebih panjang\Nkalau tetap di kerajaanmu.
Dialogue: 0,0:05:06.29,0:05:11.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau berbuat seenaknya selagi aku tidak ada.
Dialogue: 0,0:05:11.68,0:05:16.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa kubiarkan begitu saja!
Dialogue: 0,0:05:16.55,0:05:18.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tembakan Malaikat Jatuh!
Dialogue: 0,0:05:19.14,0:05:21.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyihir ruang, ya.
Dialogue: 0,0:05:23.35,0:05:24.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cih!
Dialogue: 0,0:05:24.60,0:05:28.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan dia punya Ruang Absolut\Ndari kekuatan iblis.
Dialogue: 0,0:05:28.65,0:05:32.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia menguasai mana di sekitar\Ndan bahkan bisa meniadakan
Dialogue: 0,0:05:32.70,0:05:34.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mana milik musuh.
Dialogue: 0,0:05:34.95,0:05:40.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku tidak ada,\Npasti kaulah penyihir ruang terkuat.
Dialogue: 0,0:05:40.16,0:05:44.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah lama aku tidak bertemu\Norang jemawa sepertimu!
Dialogue: 0,0:05:45.31,0:05:48.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Ruang: Penghancuran Malaikat Jatuh!
Dialogue: 0,0:05:49.75,0:05:52.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu kau dikirim
Dialogue: 0,0:05:52.92,0:05:55.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk menangkal sihir ruangku.
Dialogue: 0,0:05:56.30,0:05:57.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Ruang:
Dialogue: 0,0:05:58.14,0:06:00.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dominasi Mana Ruang.
Dialogue: 0,0:06:03.29,0:06:06.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyihir yang masuk ke ruang ini
Dialogue: 0,0:06:06.44,0:06:08.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan sulit mempertahankan sihir!
Dialogue: 0,0:06:09.69,0:06:12.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanpa bergerak saja,\Ntekanannya sudah sebesar ini?
Dialogue: 0,0:06:12.86,0:06:14.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian lupa diri?
Dialogue: 0,0:06:14.86,0:06:18.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bodoh sekali membawa orang\Nyang pernah kalah.
Dialogue: 0,0:06:19.21,0:06:21.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama seperti komandan kalian
Dialogue: 0,0:06:21.79,0:06:23.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang membuat pilihan bodoh.
Dialogue: 0,0:06:24.50,0:06:26.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kebanggaan dan mimpi yang sia-sia.
Dialogue: 0,0:06:26.83,0:06:29.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah sebabnya kalian
Dialogue: 0,0:06:29.84,0:06:34.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan mati tanpa bisa membuatku\Nmelangkah sedikit pun.
Dialogue: 0,0:06:36.30,0:06:37.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo.
Dialogue: 0,0:06:37.64,0:06:38.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bell!
Dialogue: 0,0:06:40.64,0:06:41.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:06:42.18,0:06:44.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketemu kau, tulang sialan!
Dialogue: 0,0:06:50.11,0:06:52.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu itu kau sudah keterlaluan!
Dialogue: 0,0:06:54.15,0:06:56.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dan Yuno akan mengalahkanmu!
Dialogue: 0,0:06:59.01,0:07:01.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyelaman Roh:
Dialogue: 0,0:07:08.04,0:07:10.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Roh Boreas!
Dialogue: 0,0:07:11.25,0:07:14.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tekanan dan wujud sihir apa itu?
Dialogue: 0,0:07:15.55,0:07:19.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, mereka tidak berdaya di ruang ini.
Dialogue: 0,0:07:20.10,0:07:22.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku adalah calon Kaisar Sihir.
Dialogue: 0,0:07:23.01,0:07:26.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak boleh kalah darimu!
Dialogue: 0,0:07:27.73,0:07:31.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku gagal mengendalikan mana\Ndi dalam Ruang Absolut?
Dialogue: 0,0:07:31.09,0:07:34.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia punya kekuatan yang lebih tinggi?
Dialogue: 0,0:07:34.82,0:07:36.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, dia...
Dialogue: 0,0:07:38.77,0:07:41.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia dicintai mana!
Dialogue: 0,0:07:45.12,0:07:48.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mati tanpa bisa membuatmu\Nbergerak selangkah pun?
Dialogue: 0,0:07:48.91,0:07:50.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu katamu?
Dialogue: 0,0:07:58.05,0:07:59.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong kosong.
Dialogue: 0,0:07:59.68,0:08:04.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mati dan sesalilah\Nkarena telah mengusik Pasukan Fajar Emas!
Dialogue: 0,0:08:05.56,0:08:09.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau memang benci kalah, ya.
Dialogue: 0,0:08:10.52,0:08:11.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhasil.
Dialogue: 0,0:08:11.90,0:08:14.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akan mengalahkannya,\Nmenghentikan Ritual Penurunan Qliphoth,
Dialogue: 0,0:08:15.23,0:08:17.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan menolong Komandan Vangeance!
Dialogue: 0,0:08:21.76,0:08:23.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah.
Dialogue: 0,0:08:23.89,0:08:28.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dengar ada penyusup,\Ntapi bukan Noelle, ya?
Dialogue: 0,0:08:28.77,0:08:33.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buktikanlah bahwa melawan kalian itu seru.
Dialogue: 0,0:08:34.30,0:08:38.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama, kalahkan dulu mereka.
Dialogue: 0,0:08:40.15,0:08:41.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Penciptaan Mawar Liar:
Dialogue: 0,0:08:42.32,0:08:43.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pohon Mawar Pemburu Mayat!
Dialogue: 0,0:08:44.57,0:08:49.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya mereka cukup kuat berkat\Nmodifikasi Moris dan kutukan dariku.
Dialogue: 0,0:08:54.71,0:08:56.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Lukisan:
Dialogue: 0,0:08:57.08,0:08:58.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gelombang Souterrain.
Dialogue: 0,0:08:59.88,0:09:01.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permainan Sirene.
Dialogue: 0,0:09:11.02,0:09:15.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir lukisan yang bisa mengeluarkan\Nbanyak atribut, cukup menarik.
Dialogue: 0,0:09:15.27,0:09:17.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi masa cuma itu?
Dialogue: 0,0:09:17.81,0:09:21.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir mawar liar tidak berguna.
Dialogue: 0,0:09:21.11,0:09:24.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin kurang cocok dan cuma jadi beban.
Dialogue: 0,0:09:24.91,0:09:30.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duh, aku ingin melawan cebol anti-sihir\Ndan om-om sihir kegelapan
Dialogue: 0,0:09:30.58,0:09:33.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang mengalahkan Dante.
Dialogue: 0,0:09:34.41,0:09:37.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin menjadikan mereka mainanku.
Dialogue: 0,0:09:37.75,0:09:41.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi gerbang dunia bawah tidak akan terbuka\Nkalau om-om itu mati, sih.
Dialogue: 0,0:09:41.75,0:09:43.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harus sabar.
Dialogue: 0,0:09:43.51,0:09:47.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, kalau dia bisa diculik Zenon,
Dialogue: 0,0:09:47.39,0:09:50.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin dia tidak sehebat itu.
Dialogue: 0,0:09:53.02,0:09:56.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama bertugas sebagai komandan\Ndalam setengah tahun ini,
Dialogue: 0,0:09:56.89,0:09:59.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku mempelajari Mana Method\Nkhas Kerajaan Heart.
Dialogue: 0,0:10:00.30,0:10:03.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, Charlotte memang genius.
Dialogue: 0,0:10:04.53,0:10:08.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Komandan sampai mempelajari teknik itu juga.
Dialogue: 0,0:10:08.45,0:10:11.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang serajin dia tidak akan berhenti.
Dialogue: 0,0:10:11.70,0:10:15.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengira telah mengontrol\Ndan memanfaatkan
Dialogue: 0,0:10:15.87,0:10:19.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kutukan besar\Nyang menimpa sihirku selama ini.
Dialogue: 0,0:10:20.25,0:10:22.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi ternyata salah besar.
Dialogue: 0,0:10:23.13,0:10:26.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru kutukan itu membatasi sihirku.
Dialogue: 0,0:10:27.05,0:10:29.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan mendalami Mana Method,
Dialogue: 0,0:10:29.30,0:10:32.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku menemukan cara yang sebenarnya\Nuntuk menggunakan kutukan ini!
Dialogue: 0,0:10:33.35,0:10:34.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dorothy pernah bilang...
Dialogue: 0,0:10:35.48,0:10:39.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir kutukan di dunia ini\Nberasal dari Megicula.
Dialogue: 0,0:10:39.37,0:10:42.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dialah sumber segala kutukan.
Dialogue: 0,0:10:43.61,0:10:46.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena ulahmu, aku...
Dialogue: 0,0:10:49.28,0:10:50.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menjadi kuat!
Dialogue: 0,0:10:52.24,0:10:56.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia memakai Mana Method di dalam sihirku.
Dialogue: 0,0:10:57.94,0:11:01.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana, air, dan tanah yang bagus\Nmungkin membuatnya mekar.
Dialogue: 0,0:11:02.04,0:11:05.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana Method, Sihir Mawar Liar Modifikasi:
Dialogue: 0,0:11:07.13,0:11:08.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Surga Mawar Biru!
Dialogue: 0,0:11:11.39,0:11:15.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makin kuat kutukan musuh,\Nmakin banyak kutukan yang terisap,
Dialogue: 0,0:11:15.47,0:11:17.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan membuat bunganya mekar.
Dialogue: 0,0:11:17.68,0:11:21.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kutukan mereka berdua melemah?!
Dialogue: 0,0:11:22.48,0:11:26.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manusia itu memodifikasi kutukan miliknya
Dialogue: 0,0:11:26.73,0:11:29.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menjadi sihir khusus anti-kutukan?
Dialogue: 0,0:11:30.53,0:11:33.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak kusangka ada yang bisa begitu.
Dialogue: 0,0:11:33.74,0:11:35.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menarik!
Dialogue: 0,0:11:37.87,0:11:41.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misi dan persaingan antara kesatria sihir.
Dialogue: 0,0:11:42.13,0:11:43.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Reinkarnasi elf.
Dialogue: 0,0:11:44.59,0:11:47.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana Method dari Kerajaan Heart.
Dialogue: 0,0:11:48.21,0:11:51.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya telah membentuk sihirku.
Dialogue: 0,0:11:53.34,0:11:56.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inilah mawar biruku yang sekarang.
Dialogue: 0,0:11:56.39,0:11:58.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan inilah...
Dialogue: 0,0:12:01.89,0:12:04.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mawar merahku yang sebenarnya!
Dialogue: 0,0:12:05.40,0:12:06.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang sekarang
Dialogue: 0,0:12:07.53,0:12:10.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa memakai mawar merah maupun biru!
Dialogue: 0,0:12:11.40,0:12:14.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Mawar Liar Sejati: Ratu Mawar Liar!
Dialogue: 0,0:12:15.95,0:12:20.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menolongmu\Ndan menunjukkan kekuatan baruku,
Dialogue: 0,0:12:20.61,0:12:21.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yami!
Dialogue: 0,0:12:22.42,0:12:27.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti Charlotte jadi komandan\Ntanpa kekuatan aslinya?
Dialogue: 0,0:12:33.76,0:12:36.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menemukan musuh yang pas!
Dialogue: 0,0:12:38.75,0:12:42.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayang sekali, aku tidak akan meladenimu.
Dialogue: 0,0:12:42.44,0:12:44.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudmu?
Dialogue: 0,0:12:44.19,0:12:46.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini, sih, tinggal diputus... Eh?
Dialogue: 0,0:12:47.19,0:12:50.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan fisik tidak berguna\Nterhadap semak itu.
Dialogue: 0,0:12:50.74,0:12:54.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makin kuat kutukan seseorang,\Nmakin kuat lilitannya.
Dialogue: 0,0:12:54.91,0:12:58.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan, untuk mengakali kekuatanku...
Dialogue: 0,0:12:58.53,0:13:01.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, main denganku!
Dialogue: 0,0:13:01.83,0:13:03.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayolah!
Dialogue: 0,0:13:03.54,0:13:08.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini buah kelengahan, kesombongan,\Ndan kecerobohanmu.
Dialogue: 0,0:13:08.21,0:13:10.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan begitu, dong!
Dialogue: 0,0:13:10.58,0:13:15.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertarungan kita pasti sangat nikmat.
Dialogue: 0,0:13:15.45,0:13:18.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benci gadis sembrono sepertimu!
Dialogue: 0,0:13:19.68,0:13:22.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Matilah tanpa hasrat yang terpenuhi.
Dialogue: 0,0:13:22.56,0:13:24.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah hukumanku
Dialogue: 0,0:13:25.56,0:13:26.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untukmu!
Dialogue: 0,0:13:30.88,0:13:33.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Death Scythe: Tebasan Gila!
Dialogue: 0,0:13:37.74,0:13:39.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkat ilmu Moris,
Dialogue: 0,0:13:39.67,0:13:43.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kemampuan regenerasiku makin hebat.
Dialogue: 0,0:13:44.50,0:13:48.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu-satunya yang mungkin melukaiku
Dialogue: 0,0:13:50.25,0:13:52.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hanyalah anti-sihir.
Dialogue: 0,0:13:53.63,0:13:54.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga.
Dialogue: 0,0:13:54.97,0:13:56.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi agar bisa menang...
Dialogue: 0,0:13:56.97,0:13:59.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini baru permulaan.
Dialogue: 0,0:13:59.97,0:14:02.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami harus bertaruh pada sihir Jack
Dialogue: 0,0:14:02.69,0:14:04.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang bisa menebas hal yang tak bisa ditebas.
Dialogue: 0,0:14:05.14,0:14:06.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:14:06.35,0:14:08.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Intinya,
Dialogue: 0,0:14:10.31,0:14:12.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tidak ada urusan dengan kalian.
Dialogue: 0,0:14:12.82,0:14:16.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Gravitasi: Kehadiran Raja Iblis.
Dialogue: 0,0:14:17.07,0:14:21.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisakah Jack menyerang\Ndalam pengaruh sihir gravitasi?
Dialogue: 0,0:14:21.87,0:14:22.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Slotos.
Dialogue: 0,0:14:29.27,0:14:33.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Unite. Mode: Equus. Spesialis Kokoh.
Dialogue: 0,0:14:35.26,0:14:39.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain bocah anti-sihir itu,\Nternyata masih ada pengguna iblis, ya?
Dialogue: 0,0:14:41.05,0:14:42.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo?
Dialogue: 0,0:14:43.10,0:14:47.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal tadi semangat, kok jadi lesu?
Dialogue: 0,0:14:47.18,0:14:51.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah yang besar cuma badan dan gayamu saja,\NKomandan Belalang?
Dialogue: 0,0:14:52.44,0:14:54.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bermulut besar boleh saja,
Dialogue: 0,0:14:55.03,0:14:57.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}asal diimbangi dengan kemampuan.
Dialogue: 0,0:14:57.95,0:14:59.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sialan!
Dialogue: 0,0:15:00.20,0:15:02.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan mengabaikanku!
Dialogue: 0,0:15:03.41,0:15:07.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sedang bicara pada komandan ini.
Dialogue: 0,0:15:16.21,0:15:17.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus.
Dialogue: 0,0:15:17.52,0:15:19.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunjukkanlah niat jahatmu.
Dialogue: 0,0:15:20.30,0:15:23.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisakah kau menghiburku\Nsampai gerbangnya terbuka?
Dialogue: 0,0:15:24.14,0:15:26.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski bisa adu pukul,\Naku tak punya serangan telak.
Dialogue: 0,0:15:26.90,0:15:28.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa mengalahkannya.
Dialogue: 0,0:15:29.24,0:15:32.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus membuat Jack bisa menyerang.
Dialogue: 0,0:15:32.65,0:15:37.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa orang yang katanya komandan\Nmalah berbaring?
Dialogue: 0,0:15:37.32,0:15:39.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau membosankan.
Dialogue: 0,0:15:39.61,0:15:40.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enyahlah!
Dialogue: 0,0:15:49.16,0:15:54.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayahku rakyat biasa,\Npemburu burung dan hewan kecil.
Dialogue: 0,0:15:55.00,0:15:59.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nasihatnya,\N"Jangan mengusik yang lebih kuat darimu."
Dialogue: 0,0:15:59.67,0:16:02.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia hati-hati dan konservatif.
Dialogue: 0,0:16:04.60,0:16:08.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu tahu sihirku bisa menciptakan bilah,
Dialogue: 0,0:16:09.18,0:16:12.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia senang karena itu cocok untuk berburu.
Dialogue: 0,0:16:12.89,0:16:14.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama seperti Ayah,
Dialogue: 0,0:16:14.98,0:16:18.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku terus menebas dan memburu makhluk lemah.
Dialogue: 0,0:16:26.11,0:16:29.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa hidupku akan terus begini?
Dialogue: 0,0:16:36.25,0:16:41.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat usiaku 13 tahun,\NAyah tewas saat di gunung.
Dialogue: 0,0:16:42.01,0:16:44.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutku itu wajar.
Dialogue: 0,0:16:45.43,0:16:49.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah diduga bertemu Penguasa Gunung\Nsaat berburu.
Dialogue: 0,0:16:50.25,0:16:54.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena di punggungnya ada bekas cakar besar.
Dialogue: 0,0:17:08.16,0:17:10.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang, aku pasti menang.
Dialogue: 0,0:17:20.85,0:17:21.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh.
Dialogue: 0,0:17:23.18,0:17:26.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bergabung jadi kesatria sihir, ah.
Dialogue: 0,0:17:33.95,0:17:35.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang ini...
Dialogue: 0,0:17:35.64,0:17:38.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia cuma mengasah bilah di atas tubuhnya.
Dialogue: 0,0:17:39.89,0:17:41.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma...
Dialogue: 0,0:17:42.11,0:17:45.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berbaring dan dilindungi, menyedihkan.
Dialogue: 0,0:17:46.03,0:17:49.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harus menebas musuh...
Dialogue: 0,0:17:49.07,0:17:53.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yami Sukehiro, sesama komandanmu,\Nbisa menghiburku, lo.
Dialogue: 0,0:17:56.04,0:17:57.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang dianggap kuat!
Dialogue: 0,0:18:00.88,0:18:02.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia menebas gravitasi?
Dialogue: 0,0:18:02.76,0:18:06.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasakanlah dengan tubuhmu!
Dialogue: 0,0:18:08.93,0:18:13.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serangan seekor serangga sia-sia terhadapku.
Dialogue: 0,0:18:17.14,0:18:19.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serangga?
Dialogue: 0,0:18:19.52,0:18:22.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sok jago!
Dialogue: 0,0:18:25.49,0:18:28.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diunggulkan bukan berarti kuat!
Dialogue: 0,0:18:28.24,0:18:31.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang selamat dari pertarungan hidup dan mati,\Nbarulah disebut kuat!
Dialogue: 0,0:18:31.99,0:18:34.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Regenerasiku tidak aktif?!
Dialogue: 0,0:18:35.53,0:18:38.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku salah sudah meremehkanmu.
Dialogue: 0,0:18:45.88,0:18:47.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa cuma sebegini?
Dialogue: 0,0:18:47.93,0:18:50.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyihir yang luar biasa.
Dialogue: 0,0:18:50.17,0:18:52.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia melawan Dewa Iblis sendirian.
Dialogue: 0,0:18:53.35,0:18:54.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya!
Dialogue: 0,0:18:55.47,0:18:56.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ralph?
Dialogue: 0,0:18:56.56,0:18:58.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Komandan Albert!
Dialogue: 0,0:18:58.64,0:19:00.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah kau selamat.
Dialogue: 0,0:19:00.35,0:19:02.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bertemu Tuan Nacht juga?
Dialogue: 0,0:19:02.69,0:19:03.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:19:03.98,0:19:08.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pangeran Yuno telah menjadi ahli sihir angin!
Dialogue: 0,0:19:09.41,0:19:11.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penampilannya mirip Ratu Ciel.
Dialogue: 0,0:19:12.03,0:19:15.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan keteguhannya mirip Raja Loyce.
Dialogue: 0,0:19:16.49,0:19:17.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:19:18.91,0:19:20.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir angin.
Dialogue: 0,0:19:20.75,0:19:24.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, Pangeran Yuno dan orang-orang itu...
Dialogue: 0,0:19:39.35,0:19:40.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu.
Dialogue: 0,0:19:40.77,0:19:46.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para penyihir terkuat kerajaan kita\Nternyata lebih kuat dari dugaanku.
Dialogue: 0,0:19:47.48,0:19:51.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih banyak waktu\Nsebelum gerbangnya terbuka.
Dialogue: 0,0:19:53.78,0:19:56.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau menghiburku juga?
Dialogue: 0,0:19:56.99,0:20:00.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cerewet, mati sana!
Dialogue: 0,0:20:02.92,0:20:04.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sensasi ini...
Dialogue: 0,0:20:09.37,0:20:10.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini...
Dialogue: 0,0:20:14.47,0:20:17.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akar raksasa Qliphoth?
Dialogue: 0,0:20:18.27,0:20:19.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Plumede!
Dialogue: 0,0:20:20.94,0:20:21.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Unite.
Dialogue: 0,0:20:26.94,0:20:28.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mode: Felis.
Dialogue: 0,0:20:29.36,0:20:32.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Bayang: Mata Bayang Langit!
Dialogue: 0,0:20:36.53,0:20:38.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di tempat munculnya Qliphoth,
Dialogue: 0,0:20:38.91,0:20:41.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ada sosok lain selain Yami dan Vangeance?
Dialogue: 0,0:20:42.00,0:20:47.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah dia Moris, ilmuwan sihir\Nyang diasingkan Kerajaan Diamond?
Dialogue: 0,0:20:51.39,0:20:56.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aksi sembrono Vanica ternyata ada gunanya.
Dialogue: 0,0:20:56.79,0:20:58.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkat ilmu Kerajaan Heart,
Dialogue: 0,0:20:58.61,0:21:02.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku menemukan cara mempercepat\Npertumbuhan Qliphoth.
Dialogue: 0,0:21:03.52,0:21:05.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai ganti karena terlahir buta,
Dialogue: 0,0:21:06.02,0:21:09.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ternyata aku diberkahi bakat ini.
Dialogue: 0,0:21:11.78,0:21:14.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bakat dirasuki iblis.
Dialogue: 0,0:21:15.91,0:21:17.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan kekuatan iblis,
Dialogue: 0,0:21:17.88,0:21:23.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku bisa mengekstrak\Ndan mengambil pengetahuan Lolopechka.
Dialogue: 0,0:21:24.42,0:21:26.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah bagaimana caranya,
Dialogue: 0,0:21:26.41,0:21:29.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi Moris menjadi katalis\Nuntuk membuka gerbangnya!
Dialogue: 0,0:21:31.21,0:21:33.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gerbang dunia bawahnya...
Dialogue: 0,0:21:33.18,0:21:35.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat! Moris harus disingkirkan!
Dialogue: 0,0:21:51.15,0:21:52.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Felis. Spesialis Lincah.
Dialogue: 0,0:21:53.28,0:21:54.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka...
Dialogue: 0,0:21:55.28,0:21:57.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku meleset.
Dialogue: 0,0:21:57.24,0:21:58.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berhasil mengenainya.
Dialogue: 0,0:21:58.99,0:22:01.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya terasa menyenangkan.
Dialogue: 0,0:22:01.58,0:22:03.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, menyenangkan.
Dialogue: 0,0:22:04.33,0:22:06.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iblis tingkat tertinggi!
