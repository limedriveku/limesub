Dialogue: 0,0:01:13.44,0:01:16.80,sign,,0000,0000,0000,,KERAJAAN SPADE
Dialogue: 0,0:02:55.15,0:02:57.40,sign,,0000,0000,0000,,KASTEL CLOVER
Dialogue: 0,0:05:38.54,0:05:44.01,sign,,0000,0000,0000,,EPISODE 171: PERTEMPURAN DIMULAI
Dialogue: 0,0:15:41.79,0:15:42.24,sign,,0000,0000,0000,,KOMANDAN PASUKAN SINGA MERAH TUA\NFUEGOLEON VERMILLION
Dialogue: 0,0:15:43.71,0:15:44.12,sign,,0000,0000,0000,,KOMANDAN PASUKAN RUSA BIRU MUDA,\NRILL BOISMORTIER
Dialogue: 0,0:15:46.30,0:15:50.01,sign,,0000,0000,0000,,"SEKKE BRONZAZZA JACK THE RIPPER"
Dialogue: 0,0:15:50.09,0:15:52.84,sign,,0000,0000,0000,,"CHARLOTTE ROSELEI"
Dialogue: 0,0:15:52.84,0:15:54.39,sign,,0000,0000,0000,,"VALTOS, SALLY, RADES SPIRITO"
Dialogue: 0,0:15:57.93,0:16:00.96,sign,,0000,0000,0000,,"DOROTHY UNSWORTH"
Dialogue: 0,0:16:00.96,0:16:03.10,sign,,0000,0000,0000,,"PASUKAN FAJAR EMAS, LANGRIS VAUDE"
Dialogue: 0,0:16:03.27,0:16:07.56,sign,,0000,0000,0000,,"KOMANDAN PASUKAN ELANG PERAK, NOZEL SILVA"
Dialogue: 0,0:16:07.57,0:16:07.97,sign,,0000,0000,0000,,MAKUSA NORTH
Dialogue: 0,0:16:13.03,0:16:14.49,sign,,0000,0000,0000,,"RALPH NIAFLEM"
Dialogue: 0,0:17:14.01,0:17:14.80,sign,,0000,0000,0000,,"WAKIL KOMANDAN PASUKAN FAJAR EMAS"
Dialogue: 0,0:17:14.80,0:17:17.58,sign,,0000,0000,0000,,"YUNO"
Dialogue: 0,0:00:02.36,0:00:06.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di dalam daun semanggi berhelai empat,\Nbersemayam keberuntungan.
Dialogue: 0,0:00:07.80,0:00:11.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, di helai daun kelima,\Nbersemayam iblis.
Dialogue: 0,0:00:13.56,0:00:15.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerajaan Clover.
Dialogue: 0,0:00:15.44,0:00:17.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di kerajaan yang mengagungkan sihir ini,
Dialogue: 0,0:00:17.46,0:00:20.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tinggal seorang pemuda bernama Asta\Nyang tak mampu menggunakan sihir.
Dialogue: 0,0:00:20.65,0:00:22.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi menjadi Kaisar Sihir,
Dialogue: 0,0:00:22.88,0:00:25.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ia terus bekerja keras\Nsampai titik darah penghabisan.
Dialogue: 0,0:00:25.82,0:00:27.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, yang didapat Asta
Dialogue: 0,0:00:27.83,0:00:31.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ternyata adalah anti-sihir\Nyang mampu menetralkan semua sihir.
Dialogue: 0,0:00:32.33,0:00:36.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di lain pihak,\NDark Triad yang menguasai Kerajaan Spade,
Dialogue: 0,0:00:36.33,0:00:39.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menyimpan kekuatan iblis dari dunia bawah\Ndi dalam tubuh mereka
Dialogue: 0,0:00:39.25,0:00:42.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan memulai invasi ke negara-negara lain.
Dialogue: 0,0:00:42.55,0:00:44.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asta dan kawan-kawan,\Nsetelah pertarungan sengit,
Dialogue: 0,0:00:44.69,0:00:47.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berhasil mengalahkan\Nsalah satu anggota Dark Triad, Dante,
Dialogue: 0,0:00:47.64,0:00:50.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tetapi dua Komandan Kesatria Sihir,\NYami dan Vangeance,
Dialogue: 0,0:00:50.95,0:00:53.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}serta Ratu Lolopechka diculik.
Dialogue: 0,0:00:54.02,0:00:55.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk menyelamatkan Yami dan yang lainnya,
Dialogue: 0,0:00:55.74,0:00:59.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asta berusaha menguasai\Nkekuatan sejati iblis.
Dialogue: 0,0:00:59.72,0:01:03.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serangan balasan Kerajaan Clover pun\Nkini dimulai.
Dialogue: 0,0:01:53.25,0:01:56.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakakku baik-baik saja, kan,
Dialogue: 0,0:01:57.97,0:01:59.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Moris?
Dialogue: 0,0:02:00.61,0:02:05.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku adalah orang yang dulu menangani\Nseluruh ilmu sihir di Kerajaan Diamond.
Dialogue: 0,0:02:06.56,0:02:09.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beliau akan pulih tanpa ada masalah.
Dialogue: 0,0:02:09.93,0:02:12.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malah bisa menjadi lebih kuat.
Dialogue: 0,0:02:13.32,0:02:18.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daya sihir dari Ritual Penurunan juga\Ndikumpulkan dari Candelo yang aku buat.
Dialogue: 0,0:02:18.19,0:02:20.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau boleh lebih percaya padaku.
Dialogue: 0,0:02:20.94,0:02:24.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memang diburu oleh kerajaan\Ngara-gara Mars si pengkhianat itu,
Dialogue: 0,0:02:24.74,0:02:27.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku malah tiba di tempat\Nyang lebih menarik!
Dialogue: 0,0:02:27.17,0:02:29.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat berterima kasih pada kalian.
Dialogue: 0,0:02:34.43,0:02:39.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, aku sudah tidak sabar\Nbertarung melawan bocah itu!
Dialogue: 0,0:02:40.21,0:02:42.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah ada persiapan lain\Nyang belum dikerjakan?
Dialogue: 0,0:02:42.67,0:02:44.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya sudah siap, sih.
Dialogue: 0,0:02:44.57,0:02:46.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, kan, Lotus?
Dialogue: 0,0:02:46.84,0:02:47.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:02:48.49,0:02:53.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya ini akan berbahaya dan gila.
Dialogue: 0,0:03:00.19,0:03:02.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dunia bawah tempat iblis tinggal
Dialogue: 0,0:03:02.48,0:03:05.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan Pohon Qliphoth yang menghubungkannya\Ndengan dunia ini.
Dialogue: 0,0:03:05.98,0:03:09.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang diperlukan untuk membentuk dua hal itu\Nadalah Yami dan Vangeance.
Dialogue: 0,0:03:10.16,0:03:13.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam tiga hari,\Ngerbang dunia bawah akan terbuka.
Dialogue: 0,0:03:14.66,0:03:17.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebelum itu, kita harus merebut kembali\NYami dan Vangeance,
Dialogue: 0,0:03:17.45,0:03:19.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}serta menghancurkan Pohon Qliphoth.
Dialogue: 0,0:03:20.33,0:03:22.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kali ini giliran kita yang menyerang.
Dialogue: 0,0:03:23.65,0:03:27.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat seperti ini, aku, sang Kaisar Sihir,\Ntidak bisa melakukan apa-apa.
Dialogue: 0,0:03:33.65,0:03:35.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pilihanmu tepat,
Dialogue: 0,0:03:35.81,0:03:39.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi orang yang memilih dengan tepat\Ntidak selalu mendapat ganjaran baik.
Dialogue: 0,0:03:40.98,0:03:42.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Giliranku, nih!
Dialogue: 0,0:03:43.23,0:03:44.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, jadilah lebih kuat.
Dialogue: 0,0:03:46.52,0:03:50.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agar tidak kalah dari kejahatan\Nyang semena-mena.
Dialogue: 0,0:03:59.10,0:04:01.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Unite. Mode: Canis.
Dialogue: 0,0:04:03.35,0:04:07.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai sekarang,\Nlatihanmu yang sesungguhnya dimulai.
Dialogue: 0,0:04:07.88,0:04:13.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian berdua, cobalah kalahkan aku.
Dialogue: 0,0:05:49.09,0:05:53.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asta, agar bisa bertambah kuat,\Nkau harus bersatu dengan iblis itu
Dialogue: 0,0:05:53.55,0:05:56.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan mengeluarkan kekuatan anti-sihir\Nsampai kemampuan maksimalnya.
Dialogue: 0,0:06:00.11,0:06:01.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ekor?
Dialogue: 0,0:06:10.43,0:06:12.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo? Eh?
Dialogue: 0,0:06:12.28,0:06:13.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa Liebe hilang?
Dialogue: 0,0:06:14.07,0:06:15.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku di sini!
Dialogue: 0,0:06:16.31,0:06:18.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi kecil!
Dialogue: 0,0:06:18.08,0:06:21.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya kalau memberikan\Nkekuatanku padamu, aku akan menyusut begini.
Dialogue: 0,0:06:22.04,0:06:23.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada kontrak dengan iblis panggilan,
Dialogue: 0,0:06:23.93,0:06:27.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kendali sepenuhnya berada\Ndi pihak yang menguasai.
Dialogue: 0,0:06:27.11,0:06:29.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan kata lain, ada pada manusia.
Dialogue: 0,0:06:29.67,0:06:32.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu,\Naku bisa dengan mudah menguasai Unite.
Dialogue: 0,0:06:33.35,0:06:35.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang kau lakukan bukan Unite.
Dialogue: 0,0:06:35.85,0:06:38.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu hanya iblismu\Nyang mengalirkan sedikit kekuatannya padamu.
Dialogue: 0,0:06:39.23,0:06:41.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya tadi Liebe juga\Nmenyebutkan hal yang sama.
Dialogue: 0,0:06:41.78,0:06:44.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana caranya aku bisa\Nbenar-benar menggunakan kekuatanmu?
Dialogue: 0,0:06:44.82,0:06:45.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak tahu.
Dialogue: 0,0:06:45.76,0:06:46.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lah?
Dialogue: 0,0:06:47.17,0:06:51.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena aku bermaksud merebut tubuhmu\Ndan bertarung.
Dialogue: 0,0:06:51.45,0:06:53.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga baru pertama kali keluar\Ndan bertempur langsung.
Dialogue: 0,0:06:54.00,0:06:56.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maka dari itu,\Nkau yang lemah pun bisa mengalahkanku.
Dialogue: 0,0:06:56.91,0:06:59.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti kau tidak paham apa-apa?
Dialogue: 0,0:06:59.62,0:07:00.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal sudah sok pintar begitu!
Dialogue: 0,0:07:01.04,0:07:03.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari awal,\Nkau yang bikin kontrak aneh begini!
Dialogue: 0,0:07:03.79,0:07:05.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi kau yang mikir!
Dialogue: 0,0:07:05.03,0:07:07.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga tidak paham!
Dialogue: 0,0:07:07.48,0:07:08.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga.
Dialogue: 0,0:07:08.84,0:07:11.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau harus menemukan cara sendiri\Ndi dalam pertempuran.
Dialogue: 0,0:07:13.48,0:07:18.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan Unite, aku bisa menambahkan\Nciri khas tiap iblis ke sihir bayangku.
Dialogue: 0,0:07:19.39,0:07:21.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salah satu ciri dari Gimodelo adalah
Dialogue: 0,0:07:22.95,0:07:23.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kawanan.
Dialogue: 0,0:07:33.78,0:07:37.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masing-masing dari mereka punya Ki\Nyang sama dengan Wakil Komandan Nacht!
Dialogue: 0,0:07:39.33,0:07:42.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama tubuh asliku belum dikalahkan,\Nbayanganku tidak akan hilang.
Dialogue: 0,0:07:44.79,0:07:46.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia berbaur dengan kawanan
Dialogue: 0,0:07:46.42,0:07:48.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan membuatku susah mengincar tubuh aslinya!
Dialogue: 0,0:07:49.23,0:07:53.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan Wakil Komandan Nacht sudah berkontrak\Ndengan empat iblis sekaligus?!
Dialogue: 0,0:07:54.05,0:07:56.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti dia menghadapi ambang kematian\Nsesering itu?!
Dialogue: 0,0:07:57.05,0:08:01.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ikatanku dengan Liebe sudah lebih kuat\Ndibanding sebelum membuat kontrak.
Dialogue: 0,0:08:01.68,0:08:04.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harusnya aku bisa meminjam\Nlebih banyak kekuatannya!
Dialogue: 0,0:08:04.65,0:08:07.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau membuat kontrak setara dengan iblis.
Dialogue: 0,0:08:07.98,0:08:09.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja tidak akan mudah bagimu
Dialogue: 0,0:08:09.70,0:08:13.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mengeluarkan seluruh kemampuan iblis\Nyang bukan bawahanmu.
Dialogue: 0,0:08:14.42,0:08:16.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah memilih jalan itu.
Dialogue: 0,0:08:18.70,0:08:21.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perlihatkan kau bisa menang dariku\Ndengan kekuatan itu!
Dialogue: 0,0:08:25.93,0:08:26.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:08:31.03,0:08:34.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang, di sini.\NAku akan melampaui batasku!
Dialogue: 0,0:08:42.28,0:08:43.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penebas Iblis.
Dialogue: 0,0:08:44.36,0:08:47.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namamu adalah Katana Penebas Iblis!
Dialogue: 0,0:08:48.63,0:08:51.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo jemput Komandan Yami bersama-sama!
Dialogue: 0,0:08:51.10,0:08:53.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang, di sini. Ayo lampaui batas kita!
Dialogue: 0,0:08:55.06,0:08:57.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat benci kata-kata itu.
Dialogue: 0,0:09:03.22,0:09:07.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah menemani\Nlatihan khusus saya,
Dialogue: 0,0:09:07.59,0:09:09.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mantan Wakil Komandan Langris.
Dialogue: 0,0:09:09.54,0:09:11.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perlu banget bilang mantan?
Dialogue: 0,0:09:11.84,0:09:14.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau ini masih saja suka sarkas.
Dialogue: 0,0:09:15.14,0:09:16.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya tidak akan kalah dari Anda soal sarkas.
Dialogue: 0,0:09:16.88,0:09:20.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong,\Nperi bawel yang biasa bersamamu kenapa?
Dialogue: 0,0:09:21.18,0:09:24.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang Bell tidak mau keluar\Ndari Grimoire-ku.
Dialogue: 0,0:09:25.07,0:09:27.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar, keterlaluan.
Dialogue: 0,0:09:31.23,0:09:35.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa sangka bisa sehebat ini\Ntanpa kekuatan peri.
Dialogue: 0,0:09:44.29,0:09:46.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian kalah lagi.
Dialogue: 0,0:09:46.89,0:09:50.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wakil Komandan Nacht, kuatnya bukan main!
Dialogue: 0,0:09:50.37,0:09:52.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berapa kali pun kucoba,\Naku tidak melihat cara untuk menang.
Dialogue: 0,0:09:53.34,0:09:56.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu, rasanya dia belum serius.
Dialogue: 0,0:09:56.29,0:09:59.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi ini kekuatan Unite?
Dialogue: 0,0:09:59.86,0:10:03.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa aku dan Liebe tidak bisa melakukannya?
Dialogue: 0,0:10:03.36,0:10:07.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apalagi saat terluka dalam mode Black,\NLiebe juga terkena dampak lukaku.
Dialogue: 0,0:10:14.26,0:10:15.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak banget!
Dialogue: 0,0:10:15.94,0:10:18.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, staminaku langsung pulih\Ndan lukaku sembuh!
Dialogue: 0,0:10:18.98,0:10:22.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini dibuat dengan sihir anggota Resistance\NKerajaan Spade, ya?
Dialogue: 0,0:10:22.53,0:10:25.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harus bilang terima kasih\Nsaat bertemu dengannya!
Dialogue: 0,0:10:26.10,0:10:27.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah makan manis, aku jadi ada ide!
Dialogue: 0,0:10:27.76,0:10:29.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Temani aku sebentar, Liebe!
Dialogue: 0,0:10:29.93,0:10:35.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sudah begini, ada kemungkinan 10 persen\Ndia memunculkan ide luar biasa!
Dialogue: 0,0:10:38.72,0:10:40.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bergabung!
Dialogue: 0,0:10:41.30,0:10:43.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata yang keluar 90% ampas,\Nseperti biasa.
Dialogue: 0,0:10:44.30,0:10:47.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bukan waktunya main-main!\NDasar 90% ampas!
Dialogue: 0,0:10:47.44,0:10:49.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana ada!
Dialogue: 0,0:10:49.23,0:10:53.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan bertempur begini,\Njiwa dan raga kita bisa lebih bersatu!
Dialogue: 0,0:10:53.65,0:10:56.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak lelah jadi anak baik begitu?
Dialogue: 0,0:10:57.66,0:11:00.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak sendiri apa tidak lelah sebebas itu?
Dialogue: 0,0:11:00.95,0:11:04.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bodoh! Mana bisa lelah dengan kebebasan.
Dialogue: 0,0:11:05.12,0:11:07.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dengan begini saja bisa berhasil,\Nkita tidak akan kesusahan!
Dialogue: 0,0:11:07.88,0:11:08.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar 90% ampas!
Dialogue: 0,0:11:08.63,0:11:11.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa, sih?\NKau kan di atas, jangan banyak ngomel!
Dialogue: 0,0:11:11.41,0:11:13.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah saatnya bergabung dengan kesatria lain.
Dialogue: 0,0:11:14.31,0:11:15.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah dua hari berlalu?
Dialogue: 0,0:11:15.86,0:11:18.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat, aku tidak sadar!
Dialogue: 0,0:11:18.66,0:11:20.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa boleh buat.
Dialogue: 0,0:11:23.33,0:11:25.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau memang gagal,
Dialogue: 0,0:11:25.22,0:11:26.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}matilah di sini!
Dialogue: 0,0:11:28.67,0:11:29.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Liebe!
Dialogue: 0,0:11:29.96,0:11:32.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana Zone: Medan Berburu Kegelapan.
Dialogue: 0,0:11:37.92,0:11:39.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gelap gulita...
Dialogue: 0,0:11:42.32,0:11:43.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini...
Dialogue: 0,0:11:46.11,0:11:47.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ki mereka...
Dialogue: 0,0:11:47.13,0:11:49.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak merasakan\Nhawa keberadaan mereka sama sekali!
Dialogue: 0,0:11:49.51,0:11:51.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada cara menghindari serangan mereka!
Dialogue: 0,0:11:52.27,0:11:55.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal punya potensi,\Ntapi sayang seribu sayang.
Dialogue: 0,0:11:55.57,0:11:58.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ajal yang diam-diam mendekat dalam gelap.
Dialogue: 0,0:11:58.92,0:12:02.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini adalah teror sejati!
Dialogue: 0,0:12:08.02,0:12:09.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sialan!
Dialogue: 0,0:12:09.54,0:12:12.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal sudah dipojokkan sampai begini...
Dialogue: 0,0:12:12.60,0:12:14.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin mendapat lebih banyak kekuatan.
Dialogue: 0,0:12:14.68,0:12:17.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal harusnya\Nperasaanku dan Asta sudah menyatu!
Dialogue: 0,0:12:17.81,0:12:20.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya begitu, tapi kenapa...
Dialogue: 0,0:12:20.40,0:12:22.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kami tidak bisa Unite?
Dialogue: 0,0:12:23.28,0:12:26.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi menyelamatkan Komandan Yami...
Dialogue: 0,0:12:26.66,0:12:29.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi membalaskan dendam Licita...
Dialogue: 0,0:12:31.12,0:12:33.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tidak boleh mati di sini!
Dialogue: 0,0:12:33.79,0:12:35.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlebih,
Dialogue: 0,0:12:35.04,0:12:37.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tidak akan membiarkan dia mati!
Dialogue: 0,0:13:11.06,0:13:14.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sengaja tidak mengincarku langsung.
Dialogue: 0,0:13:14.68,0:13:18.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal tidak disentuh,\Ntapi Unite di tangan kananku dibatalkan.
Dialogue: 0,0:13:18.83,0:13:23.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia juga menghapus sihirku yang tak punya\Nbentuk fisik beserta Mana Zone.
Dialogue: 0,0:13:24.01,0:13:25.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anti-sihir...
Dialogue: 0,0:13:25.51,0:13:28.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika dia menggunakannya\Ndalam kekuatan penuh, pasti...
Dialogue: 0,0:13:30.53,0:13:31.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia akan jadi yang terkuat.
Dialogue: 0,0:13:32.20,0:13:33.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang kalah.
Dialogue: 0,0:13:33.87,0:13:35.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mantap!
Dialogue: 0,0:13:35.28,0:13:36.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, ayo pergi!
Dialogue: 0,0:13:37.03,0:13:37.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa.
Dialogue: 0,0:13:37.87,0:13:39.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke-Kenapa?!
Dialogue: 0,0:13:39.52,0:13:41.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah aku dan Liebe sudah bisa Unite?
Dialogue: 0,0:13:41.82,0:13:43.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya sekejap saja.
Dialogue: 0,0:13:43.66,0:13:46.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian belum bisa menguasai Unite sepenuhnya.
Dialogue: 0,0:13:47.70,0:13:49.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan harusnya kau paham betul tentang itu.
Dialogue: 0,0:13:50.06,0:13:50.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku salah?
Dialogue: 0,0:13:52.43,0:13:53.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang benar begitu.
Dialogue: 0,0:13:53.90,0:13:55.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kalau sudah sampai di sini...
Dialogue: 0,0:13:56.19,0:13:58.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pergi ke markas musuh dalam keadaan begini
Dialogue: 0,0:13:58.68,0:14:01.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sama saja dengan bunuh diri.
Dialogue: 0,0:14:01.10,0:14:02.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku...!
Dialogue: 0,0:14:02.14,0:14:06.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan sihir bayang, aku melihatmu\Ndan anggota Pasukan Banteng Hitam.
Dialogue: 0,0:14:07.98,0:14:12.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau lahir tanpa daya sihir,\Nkerasukan iblis karena kebetulan,
Dialogue: 0,0:14:12.74,0:14:15.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan dipermainkan oleh takdir yang keji.
Dialogue: 0,0:14:15.61,0:14:16.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:14:18.93,0:14:21.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pilihanmu selalu tepat.
Dialogue: 0,0:14:22.62,0:14:25.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bilang orang yang memilih dengan tepat
Dialogue: 0,0:14:25.10,0:14:27.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak selalu mendapat ganjaran baik,
Dialogue: 0,0:14:27.17,0:14:28.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi...
Dialogue: 0,0:14:28.77,0:14:32.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku ingin orang yang memilih dengan tepat\Nmendapat ganjaran yang baik.
Dialogue: 0,0:14:33.09,0:14:34.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wakil Komandan Nacht...
Dialogue: 0,0:14:38.01,0:14:39.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan meninggalkan Gimodelo di sini.
Dialogue: 0,0:14:41.60,0:14:44.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami akan berusaha sebaik mungkin\Nsampai kau menyusul.
Dialogue: 0,0:14:45.64,0:14:47.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu,\Npoleslah kemampuanmu sampai sempurna
Dialogue: 0,0:14:49.08,0:14:50.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan pastikan kau menyusul!
Dialogue: 0,0:14:51.93,0:14:52.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:14:53.56,0:14:56.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau menerima itu, aku pasti mati!
Dialogue: 0,0:14:56.83,0:14:58.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Juragan Nacht persis setan!
Dialogue: 0,0:15:00.98,0:15:03.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon bantuannya, ya, Gimodelo!
Dialogue: 0,0:15:04.30,0:15:08.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Me-Mereka niat banget!
Dialogue: 0,0:15:35.06,0:15:35.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:15:36.58,0:15:37.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo maju!
Dialogue: 0,0:15:38.99,0:15:41.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah berkumpul, ya.\NTekad kalian sudah bulat?
Dialogue: 0,0:15:42.25,0:15:43.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asta kenapa?
Dialogue: 0,0:15:44.13,0:15:46.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya dia butuh lebih banyak waktu.
Dialogue: 0,0:15:46.30,0:15:50.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jiah! Lagi pula, dari awal dia tidak dihitung!
Dialogue: 0,0:15:50.09,0:15:52.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Asta tidak ikutan?
Dialogue: 0,0:15:52.84,0:15:54.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya sudahlah.
Dialogue: 0,0:15:54.42,0:15:57.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, aku bisa melihat sesuatu\Nyang sangat menarik.
Dialogue: 0,0:15:57.93,0:16:00.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya aku bisa eksperimen dengan alat sihir buatanku
Dialogue: 0,0:16:00.96,0:16:03.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hasil meneliti tubuh Asta!
Dialogue: 0,0:16:03.27,0:16:07.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jubah yang dibuatnya ini akan aman, kan?
Dialogue: 0,0:16:07.98,0:16:10.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sally memang agak nyentrik,
Dialogue: 0,0:16:10.43,0:16:13.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi penelitian alat sihirnya jelas\Nkelas kakap.
Dialogue: 0,0:16:13.03,0:16:14.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa dipakai dengan tenang.
Dialogue: 0,0:16:14.59,0:16:18.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makusa! Jangan main-main\Nhanya karena ini alat sihir!
Dialogue: 0,0:16:18.39,0:16:20.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, coba lihat ini, Rades!
Dialogue: 0,0:16:20.50,0:16:24.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jubah ini punya efek\Nmenyembunyikan daya sihir!
Dialogue: 0,0:16:24.29,0:16:28.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti yang dikatakan Sally,\Nsebagai hasil dari meneliti anti-sihir Asta,
Dialogue: 0,0:16:28.25,0:16:30.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- sesuatu yang luar biasa ditemukan...\N- Ah, berisik!
Dialogue: 0,0:16:30.02,0:16:31.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar.
Dialogue: 0,0:16:31.13,0:16:37.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke-Kenapa aku harus ikutan\Nmisi bahaya tingkat jagat raya
Dialogue: 0,0:16:37.07,0:16:39.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan orang-orang gila tingkat dewa ini?!
Dialogue: 0,0:16:40.48,0:16:43.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku memang sudah hidup mewah\Nselama enam bulan ini, sih...
Dialogue: 0,0:16:44.92,0:16:46.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wahai Sekke,
Dialogue: 0,0:16:46.28,0:16:51.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tunjukkan kekuatan terpendammu\Nkepada para komandan itu!
Dialogue: 0,0:16:51.36,0:16:52.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waduh!
Dialogue: 0,0:16:52.65,0:16:56.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak tahu kalau tujuannya\Nadalah neraka begini!
Dialogue: 0,0:16:56.96,0:16:59.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak tahu kenapa kau bisa di sini,
Dialogue: 0,0:16:59.99,0:17:03.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi karena sudah telanjur di sini,\Ntunjukkan keseriusanmu!
Dialogue: 0,0:17:04.90,0:17:07.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadilah tumbal untuk orang-orang yang tepat.
Dialogue: 0,0:17:09.55,0:17:11.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah benar Asta bisa datang tepat waktu?
Dialogue: 0,0:17:11.76,0:17:12.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pasti sempat.
Dialogue: 0,0:17:14.01,0:17:14.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi,
Dialogue: 0,0:17:14.80,0:17:17.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebelum dia tiba, aku akan membereskan semuanya.
Dialogue: 0,0:17:18.72,0:17:20.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan kau yang membereskan, tapi aku!
Dialogue: 0,0:17:20.81,0:17:22.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan kau juga.
Dialogue: 0,0:17:22.52,0:17:25.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Bayang: Lorong Bayang.
Dialogue: 0,0:17:30.26,0:17:31.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kita.
Dialogue: 0,0:17:37.88,0:17:43.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, mereka sudah menampakkan diri,\Npara anggota Resistance.
Dialogue: 0,0:17:44.79,0:17:48.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengar baik-baik, Dark Triad!
Dialogue: 0,0:17:48.34,0:17:53.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tujuh belas tahun lalu kalian mengeksekusi\NRaja Loyce dan banyak kawan kami!
Dialogue: 0,0:17:54.09,0:17:58.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, perbuatan keji dan bengis kalian\Nterhadap rakyat...
Dialogue: 0,0:17:58.45,0:18:01.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak akan bisa dimaafkan!
Dialogue: 0,0:18:01.93,0:18:03.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami paham
Dialogue: 0,0:18:03.35,0:18:06.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bahwa kami tak akan mampu mengalahkan kalian\Nmeski bertempur sampai mati.
Dialogue: 0,0:18:06.99,0:18:08.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu...
Dialogue: 0,0:18:09.67,0:18:12.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami, rakyat Kerajaan Spade,
Dialogue: 0,0:18:12.85,0:18:18.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menolak keras kalian sebagai\Nkeluarga kerajaan yang berkuasa!
Dialogue: 0,0:18:20.74,0:18:23.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, mari laksanakan\Ntugas masing-masing sesuai rencana.
Dialogue: 0,0:18:25.64,0:18:28.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti, Anda memata-matai Kerajaan Spade
Dialogue: 0,0:18:29.11,0:18:30.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan sudah berkontak dengan anggota Resistance
Dialogue: 0,0:18:30.80,0:18:32.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sejak saya keluar dari Kerajaan Spade?
Dialogue: 0,0:18:33.21,0:18:37.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Sebenarnya aku tak ingin terlalu terlibat\Ndalam pemberontakan kalian.
Dialogue: 0,0:18:37.88,0:18:40.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi melihat kemampuan\Ndan gerak-gerik kalian,
Dialogue: 0,0:18:40.56,0:18:42.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan lebih baik jika aku bekerja sama.
Dialogue: 0,0:18:43.35,0:18:46.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah melihat tekad kalian di rapat itu.
Dialogue: 0,0:18:46.61,0:18:48.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf aku pura-pura tidak tahu.
Dialogue: 0,0:18:48.72,0:18:50.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak masuk akal.
Dialogue: 0,0:18:51.11,0:18:53.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong bantu kami, Tuan Nacht,
Dialogue: 0,0:18:53.48,0:18:57.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}para penyihir terkuat Kerajaan Clover,\Ndan tentunya Pangeran Yuno!
Dialogue: 0,0:18:58.11,0:19:00.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski nyawa taruhannya,
Dialogue: 0,0:19:00.21,0:19:02.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami akan melaksanakan\Ntugas pengalihan perhatian!
Dialogue: 0,0:19:07.51,0:19:09.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guncangan apa ini?!
Dialogue: 0,0:19:19.32,0:19:21.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, ini kan...
Dialogue: 0,0:19:21.55,0:19:24.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dewa Iblis kuno yang melegenda?!
Dialogue: 0,0:19:25.13,0:19:27.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di depan kuasa yang sangat mendominasi,
Dialogue: 0,0:19:27.85,0:19:31.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mau tekad, dendam, atau apa pun itu\Ntidak ada artinya.
Dialogue: 0,0:19:32.00,0:19:35.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak ada tikus yang menyelinap\Nke dalam kastel,
Dialogue: 0,0:19:35.30,0:19:36.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku sudah mengira anggota Resistance
Dialogue: 0,0:19:37.04,0:19:40.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sedang merencanakan sesuatu\Nsaat Ritual Penurunan Qliphoth.
Dialogue: 0,0:19:41.39,0:19:44.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, siapa sangka\Nmereka menerjang dari depan.
Dialogue: 0,0:19:45.24,0:19:47.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari awal kami memang berencana\Nmenggunakan Dewa Iblis
Dialogue: 0,0:19:47.98,0:19:51.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk menghabisi seluruh rakyat kota kastel.
Dialogue: 0,0:19:52.57,0:19:55.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian bukanlah rakyat Kerajaan Spade.
Dialogue: 0,0:19:56.20,0:20:00.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rakyat Kerajaan Spade adalah\Norang-orang kuat seperti kami.
Dialogue: 0,0:20:00.56,0:20:03.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan memulai Ritual Penurunan Qliphoth.
Dialogue: 0,0:20:07.72,0:20:10.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suara ini... Daya sihir yang sungguh besar.
Dialogue: 0,0:20:11.01,0:20:13.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa orang-orang di luar akan baik-baik saja?
Dialogue: 0,0:20:13.19,0:20:14.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja.
Dialogue: 0,0:20:33.97,0:20:36.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian sudah berteriak dengan lantang.
Dialogue: 0,0:20:37.03,0:20:39.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku, bangsawan Kerajaan Clover,
Dialogue: 0,0:20:39.19,0:20:42.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereoleona Vermillion,\Nakan meminjamkan kekuatan pada kalian!
Dialogue: 0,0:20:45.44,0:20:48.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ritual Penurunan menggunakan\Nlingkaran sihir raksasa
Dialogue: 0,0:20:48.47,0:20:50.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang ditenagai oleh empat titik.
Dialogue: 0,0:20:51.07,0:20:52.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama, lokasi Ritual Penurunan Qliphoth
Dialogue: 0,0:20:52.77,0:20:54.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang berada di pusat lingkaran.
Dialogue: 0,0:20:55.01,0:20:57.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiga titik lain adalah anggota Dark Triad
Dialogue: 0,0:20:57.65,0:20:59.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang bertugas mengaktifkan ritual.
Dialogue: 0,0:21:00.41,0:21:02.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akan mengalahkan semua Triad\Nyang menjadi petugas pengaktifan
Dialogue: 0,0:21:03.02,0:21:05.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan mencegah pengaktifan ritual.
Dialogue: 0,0:21:05.52,0:21:08.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan begitu,\NRitual Penurunan Qliphoth akan terhenti
Dialogue: 0,0:21:08.33,0:21:09.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sehingga gerbang tidak akan terbuka.
Dialogue: 0,0:21:10.56,0:21:14.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada juga rencana memakai anti-sihir\Nuntuk langsung menghancurkan Qliphoth.
Dialogue: 0,0:21:14.53,0:21:16.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, hal itu tidaklah pasti.
Dialogue: 0,0:21:17.55,0:21:19.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dihancurkan paksa,
Dialogue: 0,0:21:19.25,0:21:21.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu Yami dan Vangeance\Ntewas dalam prosesnya,
Dialogue: 0,0:21:21.47,0:21:23.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalian tak akan memaafkanku, kan?
Dialogue: 0,0:21:23.98,0:21:27.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Petugas pengaktifan ada di tiga titik berbeda\Npada lingkaran sihir.
Dialogue: 0,0:21:27.63,0:21:29.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akan berpencar menjadi tiga kelompok,
Dialogue: 0,0:21:29.27,0:21:31.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menyerang mereka bersamaan\Ndan mengalahkan mereka.
Dialogue: 0,0:21:32.32,0:21:34.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski ada pengalihan perhatian\Ndi luar kastel,
Dialogue: 0,0:21:34.69,0:21:37.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita pasti akan tetap bertemu\Ndengan Dark Disciple.
Dialogue: 0,0:21:37.69,0:21:39.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada penyusup!
Dialogue: 0,0:21:39.19,0:21:40.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat itu terjadi,
Dialogue: 0,0:21:40.27,0:21:43.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}harus ada yang jadi umpan\Ndan mengamuk dengan heboh.
Dialogue: 0,0:21:47.98,0:21:49.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Supaya bisa dengan pasti mengalahkan Triad,
Dialogue: 0,0:21:49.87,0:21:53.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebisa mungkin serang mereka\Ndengan jumlah besar.
Dialogue: 0,0:22:08.13,0:22:11.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai di situ saja, Dark Triad!
