Dialogue: 0,0:03:49.27,0:03:53.02,sign,,0000,0000,0000,,EPISODE 175\NTERTINGGI VS TERENDAH
Dialogue: 0,0:09:48.78,0:09:51.65,sign,,0000,0000,0000,,"ENAM BULAN YANG LALU"
Dialogue: 0,0:00:32.71,0:00:34.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dua menit lagi.
Dialogue: 0,0:00:34.39,0:00:35.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang kedua,
Dialogue: 0,0:00:37.35,0:00:38.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penghuni Iblis!
Dialogue: 0,0:00:53.22,0:00:54.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penghancur Iblis!
Dialogue: 0,0:00:57.28,0:00:59.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa sebenarnya dia?
Dialogue: 0,0:01:01.62,0:01:05.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku iblis terlemah\Ndi lapisan pertama dunia bawah.
Dialogue: 0,0:01:05.41,0:01:09.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iblis tingkat tertinggi\Nsama sekali bukan tandinganku.
Dialogue: 0,0:01:09.90,0:01:13.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hiduplah, Liebe...
Dialogue: 0,0:01:14.26,0:01:17.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wahai putraku tersayang.
Dialogue: 0,0:01:17.14,0:01:20.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa bertarung sampai hari ini\Nberkat bantuanmu!
Dialogue: 0,0:01:20.89,0:01:23.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu,\Naku sangat berterima kasih padamu!
Dialogue: 0,0:01:24.68,0:01:27.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harusnya aku yang mengatakan itu,\Ndasar bodoh.
Dialogue: 0,0:01:27.02,0:01:29.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkatmu, aku bisa bertarung melawannya!
Dialogue: 0,0:01:30.77,0:01:33.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan dia?
Dialogue: 0,0:01:33.14,0:01:35.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya tidak ada orang\Nyang bisa menyerangku,
Dialogue: 0,0:01:35.90,0:01:39.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sementara seranganku\Ntidak mempan pada mereka!
Dialogue: 0,0:01:39.91,0:01:45.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya semua makhluk hidup\Nada untuk menghiburku.
Dialogue: 0,0:01:45.90,0:01:46.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku...
Dialogue: 0,0:01:48.96,0:01:51.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak bersenang-senang lagi.
Dialogue: 0,0:01:51.98,0:01:54.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa sebenarnya kau?!
Dialogue: 0,0:01:57.43,0:02:00.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Emosi apa ini?
Dialogue: 0,0:02:00.43,0:02:04.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak akan paham, dan tidak perlu paham.
Dialogue: 0,0:02:04.43,0:02:08.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iblis tingkat tertinggi\Ndi lapisan pertama dunia bawah...
Dialogue: 0,0:02:08.75,0:02:14.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajar kau tak tahu karena tak ada makhluk\Nyang kau anggap sebagai ancaman!
Dialogue: 0,0:02:14.19,0:02:16.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu namanya "ketakutan"!
Dialogue: 0,0:02:22.83,0:02:24.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan kabur kau, iblis sialan!
Dialogue: 0,0:02:25.29,0:02:30.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelihatannya dia akan terlepas\Ndari wujud itu sebentar lagi.
Dialogue: 0,0:02:30.04,0:02:32.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika aku menjauh sampai waktunya habis,\Naku akan menang.
Dialogue: 0,0:02:32.54,0:02:34.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial! Dia cepat.
Dialogue: 0,0:02:34.83,0:02:36.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Celaka! Tidak akan terkejar.
Dialogue: 0,0:02:38.97,0:02:42.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bersumpah akan mencabik-cabik\Ndan membunuhmu!
Dialogue: 0,0:02:42.68,0:02:44.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu pula dengan teman-temanmu,
Dialogue: 0,0:02:44.64,0:02:46.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan seluruh manusia yang ada di dunia ini!
Dialogue: 0,0:02:47.60,0:02:49.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan membiarkannya.
Dialogue: 0,0:02:50.20,0:02:52.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya aku bisa merebut sedikit waktumu.
Dialogue: 0,0:02:54.23,0:02:57.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ironis sekali, ya, iblis tingkat tertinggi.
Dialogue: 0,0:02:57.56,0:03:00.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau, dengan daya sihir yang begitu besar,\Nmerasa takut...
Dialogue: 0,0:03:06.61,0:03:10.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sentuh dunia ini!
Dialogue: 0,0:03:23.56,0:03:26.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pada manusia dan iblis\Nyang tak memiliki daya sihir.
Dialogue: 0,0:03:55.60,0:03:57.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Unite...
Dialogue: 0,0:03:57.34,0:04:00.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelihatannya belum kalian sempurnakan, ya.
Dialogue: 0,0:04:01.35,0:04:03.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kerja bagus, anak bodoh.
Dialogue: 0,0:04:05.50,0:04:07.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga, Wakil Komandan Nacht
Dialogue: 0,0:04:07.85,0:04:09.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mirip dengan Komandan Yami!
Dialogue: 0,0:04:11.02,0:04:14.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mirip siapa, katamu?
Dialogue: 0,0:04:14.02,0:04:16.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kau lakukan?!
Dialogue: 0,0:04:18.85,0:04:20.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setiap melihatnya,
Dialogue: 0,0:04:20.64,0:04:23.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku jadi teringat pada diriku di masa lalu.
Dialogue: 0,0:04:24.34,0:04:27.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, duh, duh! Muncul lagi!
Dialogue: 0,0:04:27.03,0:04:29.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyeri luar biasa di seluruh tubuh\Nakibat Unite.
Dialogue: 0,0:04:29.91,0:04:32.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa Unite lagi\Nuntuk 30 menit ke depan.
Dialogue: 0,0:04:32.55,0:04:33.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mode Black-ku juga!
Dialogue: 0,0:04:35.20,0:04:37.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Sakit banget!\N- Tiga puluh menit, ya.
Dialogue: 0,0:04:37.39,0:04:42.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini, Dark Triad memiliki kekuatan\Nsetara iblis tingkat tertinggi.
Dialogue: 0,0:04:42.20,0:04:45.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak yakin yang lain bisa bertahan\Nselama 30 menit.
Dialogue: 0,0:04:45.47,0:04:49.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Moris yang mempercepat terbukanya\Ngerbang dunia bawah juga sama merepotkannya.
Dialogue: 0,0:04:49.41,0:04:51.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kita harus mengalahkan Dark Triad
Dialogue: 0,0:04:51.65,0:04:55.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebelum gerbang berikutnya terbuka.
Dialogue: 0,0:04:55.10,0:04:57.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Aduh, duh!\N- Tanpa Unite pun,
Dialogue: 0,0:04:57.56,0:04:59.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku yakin anti-sihir masih berguna.
Dialogue: 0,0:05:00.96,0:05:04.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini, kondisi terburuknya ada pada...
Dialogue: 0,0:05:18.30,0:05:23.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelihatannya sihirmu dapat beradaptasi\Ndengan sihir lawan.
Dialogue: 0,0:05:24.24,0:05:29.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi sihir tubuhku saat ini\Nmampu mengungguli hal tersebut.
Dialogue: 0,0:05:29.52,0:05:33.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau hebat bisa bertahan sampai sejauh ini,
Dialogue: 0,0:05:33.16,0:05:34.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kau sudah mencapai batasmu.
Dialogue: 0,0:05:34.98,0:05:37.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau ini cerewet sekali.
Dialogue: 0,0:05:37.31,0:05:40.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menebasmu!
Dialogue: 0,0:05:41.20,0:05:43.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini ucapan terima kasih\Nkarena sudah menghiburku.
Dialogue: 0,0:05:44.20,0:05:46.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kuhabisi kau dengan cara yang mencolok.
Dialogue: 0,0:05:50.16,0:05:52.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ledakan Bola Api!
Dialogue: 0,0:06:11.80,0:06:14.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo, Bos Besar.
Dialogue: 0,0:06:15.56,0:06:16.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:06:16.64,0:06:19.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka berdua siapa?
Dialogue: 0,0:06:21.60,0:06:22.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lemah sekali.
Dialogue: 0,0:06:23.57,0:06:27.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bukan tempat yang pantas\Ndidatangi keroco seperti kalian.
Dialogue: 0,0:06:27.24,0:06:30.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka orang biasa dari pasukan Yami.
Dialogue: 0,0:06:30.62,0:06:32.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kalian berdua di sini?
Dialogue: 0,0:06:32.98,0:06:34.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat pergi!
Dialogue: 0,0:06:34.37,0:06:35.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia benar.
Dialogue: 0,0:06:35.85,0:06:37.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian tidak bisa apa-apa di tempat ini...
Dialogue: 0,0:06:37.65,0:06:41.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami datang untuk mengalahkan kalian\Ndan menolong Komandan Yami.
Dialogue: 0,0:06:41.76,0:06:46.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada orang yang masih bisa menghiburku\Nmeski daya sihirnya lebih rendah.
Dialogue: 0,0:06:46.51,0:06:48.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Contohnya pemuda yang ada di sana.
Dialogue: 0,0:06:48.63,0:06:52.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, daya sihir kalian berdua\Nterlalu rendah.
Dialogue: 0,0:06:52.81,0:06:55.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejauh yang kulihat,\Nkalian tak menguasai anti-sihir,
Dialogue: 0,0:06:55.68,0:06:58.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ataupun sihir unik yang misterius.
Dialogue: 0,0:06:58.25,0:06:59.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski kalian berdua menyerangku...
Dialogue: 0,0:06:59.65,0:07:01.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan salah paham dulu, Bos.
Dialogue: 0,0:07:02.52,0:07:05.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sendiri saja cukup untuk mengalahkanmu.
Dialogue: 0,0:07:14.12,0:07:16.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan coba-coba meremehkanku!
Dialogue: 0,0:07:18.26,0:07:19.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu itu.
Dialogue: 0,0:07:19.38,0:07:23.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bilang,\Nkalian sama sekali bukan tandinganku!
Dialogue: 0,0:07:24.36,0:07:26.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku paham betul soal itu!
Dialogue: 0,0:07:26.40,0:07:28.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu kau lawan yang kuat.
Dialogue: 0,0:07:30.76,0:07:33.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Komandan Yami!
Dialogue: 0,0:07:34.18,0:07:35.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir itu belum sempurna!
Dialogue: 0,0:07:36.23,0:07:39.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau keluar sekarang pun,\Ntidak akan membantu apa-apa.
Dialogue: 0,0:07:39.14,0:07:41.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau akan mati, atau jadi beban!
Dialogue: 0,0:07:51.66,0:07:53.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku paham betul
Dialogue: 0,0:07:53.91,0:07:56.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}fakta bahwa aku lemah!
Dialogue: 0,0:08:00.80,0:08:01.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu...
Dialogue: 0,0:08:01.98,0:08:06.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau seperti ini terus, mana mungkin aku\Nbisa kembali seolah tak terjadi apa-apa!
Dialogue: 0,0:08:08.00,0:08:13.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak sudi menggunakan sihirku\Ndi hadapan cecunguk sepertimu.
Dialogue: 0,0:08:13.22,0:08:16.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seranglah aku sepuasmu.
Dialogue: 0,0:08:16.22,0:08:20.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, saat kau sudah puas nanti,\Npergilah dari tempat ini!
Dialogue: 0,0:08:20.18,0:08:21.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya sudah.
Dialogue: 0,0:08:21.94,0:08:24.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku tidak akan menahan diri!
Dialogue: 0,0:08:26.90,0:08:28.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kau...?
Dialogue: 0,0:08:29.86,0:08:30.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu?
Dialogue: 0,0:08:31.11,0:08:32.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu apa?
Dialogue: 0,0:08:39.90,0:08:41.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rantai?
Dialogue: 0,0:08:42.12,0:08:43.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini?
Dialogue: 0,0:08:54.30,0:08:56.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?!\NAku tidak dalam kondisi 100 persen lagi?
Dialogue: 0,0:08:56.80,0:08:59.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setengahnya saja sudah sebesar ini?
Dialogue: 0,0:08:59.05,0:09:01.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau benar-benar kuat, ya.
Dialogue: 0,0:09:01.44,0:09:04.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang biasa sepertiku tak mungkin bisa\Nmengeluarkan daya sihir sebesar ini.
Dialogue: 0,0:09:04.81,0:09:08.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya aku bisa menciptakan sihir ini!
Dialogue: 0,0:09:10.94,0:09:12.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Api Rahasia:
Dialogue: 0,0:09:13.57,0:09:16.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soul Chain Deathmatch!
Dialogue: 0,0:09:16.58,0:09:19.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal tadi aku tak merasakan serangannya,\Ntapi sekarang...
Dialogue: 0,0:09:22.12,0:09:26.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menggabungkan daya sihir kita,\Ndan membagi rata keduanya.
Dialogue: 0,0:09:26.04,0:09:27.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inilah metode yang kudapatkan
Dialogue: 0,0:09:27.54,0:09:31.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk melawan orang terkuat!
Dialogue: 0,0:09:31.75,0:09:34.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau orang biasa atau bukan...
Dialogue: 0,0:09:34.76,0:09:36.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau akan dikalahkan olehku,
Dialogue: 0,0:09:36.85,0:09:42.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Magna Swing dari Pasukan Banteng Hitam!
Dialogue: 0,0:09:44.80,0:09:48.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon.\NTolong ajarkan aku caramu bertarung!
Dialogue: 0,0:09:48.78,0:09:51.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di Kerajaan Heart, daya sihirku terlalu rendah
Dialogue: 0,0:09:51.65,0:09:54.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sehingga tidak bisa bertarung\Nmenggunakan Mana Method.
Dialogue: 0,0:09:54.91,0:10:00.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kau yang sama-sama\Norang biasa sepertiku bisa melakukannya.
Dialogue: 0,0:10:00.23,0:10:03.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serangan balik berlipat ganda itu juga keren.
Dialogue: 0,0:10:03.50,0:10:05.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tetap bisa bertarung\Ndengan daya sihir yang rendah.
Dialogue: 0,0:10:05.87,0:10:09.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon!\NSi Luck sialan itu pasti makin kuat!
Dialogue: 0,0:10:09.71,0:10:13.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak bisa membiarkannya melampauiku!
Dialogue: 0,0:10:14.86,0:10:19.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlebih, aku tidak mau menjadi beban\Ndi Pasukan Banteng Hitam!
Dialogue: 0,0:10:21.43,0:10:23.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penguasa Sihir Api,
Dialogue: 0,0:10:23.30,0:10:25.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sekaligus orang biasa di Kesatria Sihir, ya.
Dialogue: 0,0:10:25.85,0:10:28.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau melihatmu bersujud seperti itu.
Dialogue: 0,0:10:28.61,0:10:30.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan mengajarimu, jadi cepat berdiri.
Dialogue: 0,0:10:30.89,0:10:31.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau?!
Dialogue: 0,0:10:33.00,0:10:34.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sini, ikut denganku.
Dialogue: 0,0:10:34.60,0:10:35.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke!
Dialogue: 0,0:10:36.20,0:10:39.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa tahu ada penemuan baru\Nkalau ada dua otak yang berpikir.
Dialogue: 0,0:10:47.83,0:10:49.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempat apa ini?
Dialogue: 0,0:10:51.15,0:10:53.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Markas rahasiaku.
Dialogue: 0,0:10:53.86,0:10:56.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga sudah lama mencari jawabannya.
Dialogue: 0,0:10:56.43,0:10:58.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cara terkuat untuk orang sepertiku.
Dialogue: 0,0:10:59.16,0:11:00.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti dugaanmu tadi,
Dialogue: 0,0:11:00.51,0:11:03.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku memang menggunakan Mana Method,
Dialogue: 0,0:11:04.49,0:11:05.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi berbeda dengan
Dialogue: 0,0:11:05.61,0:11:08.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}orang-orang Kerajaan Heart\Nyang menciptakan Mana Method dalam sekejap
Dialogue: 0,0:11:08.56,0:11:10.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan langsung bertarung dengannya.
Dialogue: 0,0:11:11.03,0:11:12.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teknik itu butuh daya sihir
Dialogue: 0,0:11:12.51,0:11:16.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dalam jumlah besar, insting,\Ndan refleks yang cepat.
Dialogue: 0,0:11:16.40,0:11:19.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku, orang biasa, yang tak punya semua itu
Dialogue: 0,0:11:19.01,0:11:22.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}harus menciptakan formulanya\Nperlahan-lahan sejak jauh-jauh hari.
Dialogue: 0,0:11:22.41,0:11:26.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terutama untuk sihir kuat\Nseperti sihir jebakan pembalas.
Dialogue: 0,0:11:26.80,0:11:29.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, ada juga keuntungannya bagi kita.
Dialogue: 0,0:11:30.13,0:11:32.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana Method yang diciptakan\Noleh daya sihir yang kecil
Dialogue: 0,0:11:32.85,0:11:36.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan tetap menempel\Njustru karena dayanya begitu kecil.
Dialogue: 0,0:11:37.10,0:11:38.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu,
Dialogue: 0,0:11:38.13,0:11:42.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita bisa menyiapkan formula\Nyang rumit dalam waktu yang lama.
Dialogue: 0,0:11:42.68,0:11:47.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi untuk melakukan itu, kita perlu mengenal\Ndaya sihir dan diri kita sendiri.
Dialogue: 0,0:11:48.63,0:11:52.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang diperlukan adalah pembelajaran,\Ndan kerja keras panjang nan merepotkan.
Dialogue: 0,0:11:55.19,0:11:58.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau kelihatannya orang bodoh\Nyang bersumbu pendek. Bisa, tidak, ya?
Dialogue: 0,0:11:59.07,0:12:02.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku selalu menggunakan sihir\Nberdasarkan insting.
Dialogue: 0,0:12:02.43,0:12:04.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi makin aku mempelajarinya,
Dialogue: 0,0:12:04.18,0:12:07.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}makin aku tahu\Nbahwa daya sihir itu cukup rumit!
Dialogue: 0,0:12:08.36,0:12:10.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang namanya kecocokan\Ndengan atribut, ya.
Dialogue: 0,0:12:11.15,0:12:13.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa membalikkan\Nserangan berkali lipat, dong.
Dialogue: 0,0:12:13.93,0:12:17.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Supaya menang melawan orang\Ndengan daya sihir super besar...
Dialogue: 0,0:12:19.95,0:12:24.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Andai saja jumlah daya sihirku sama besar,\Naku bakal menang karena kegigihanku!
Dialogue: 0,0:12:25.69,0:12:26.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bang Zora!
Dialogue: 0,0:12:27.85,0:12:29.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa yang kau panggil "Bang", hah?
Dialogue: 0,0:12:29.31,0:12:32.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada pendapat soal Mana Method ini?
Dialogue: 0,0:12:34.56,0:12:36.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak pernah terpikir olehku...
Dialogue: 0,0:12:36.91,0:12:38.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin ini masih bisa dilakukan.
Dialogue: 0,0:12:38.90,0:12:40.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kedengarannya menarik.
Dialogue: 0,0:12:42.61,0:12:46.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kau butuh banyak waktu\Ndan kesabaran untuk membangunnya.
Dialogue: 0,0:12:59.76,0:13:02.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa menciptakan ini\Nkarena bersiap selama enam bulan.
Dialogue: 0,0:13:02.88,0:13:05.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir milikku seorang,\Ndan hanya bisa digunakan satu kali!
Dialogue: 0,0:13:06.51,0:13:08.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Api Rahasia:
Dialogue: 0,0:13:08.41,0:13:10.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soul Chain Deathmatch!
Dialogue: 0,0:13:10.76,0:13:13.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak serumit kelihatannya, kok.
Dialogue: 0,0:13:14.36,0:13:16.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya menghubungkan tubuh kita
Dialogue: 0,0:13:16.31,0:13:19.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan membagi rata daya sihir kita.
Dialogue: 0,0:13:19.69,0:13:21.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kuperingatkan satu hal!
Dialogue: 0,0:13:21.78,0:13:23.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rantai ini
Dialogue: 0,0:13:23.11,0:13:25.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah "jiwa" kita berdua.
Dialogue: 0,0:13:25.86,0:13:28.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kau cabut paksa atau merusaknya,
Dialogue: 0,0:13:28.37,0:13:31.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau akan kehilangan kewarasanmu.\NJadi hati-hati, ya.
Dialogue: 0,0:13:31.92,0:13:33.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sulit kupercaya.
Dialogue: 0,0:13:33.50,0:13:35.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada orang biasa yang mampu\Nmenggunakan sihir seperti itu.
Dialogue: 0,0:13:35.86,0:13:38.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, dia berhasil melakukannya.
Dialogue: 0,0:13:38.38,0:13:42.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serangan dari pihak luar\Nakan mengganggu efek sihirnya,
Dialogue: 0,0:13:42.18,0:13:44.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi tolong diam\Ndan menonton saja dari sini.
Dialogue: 0,0:13:44.63,0:13:46.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sudah menjadi
Dialogue: 0,0:13:46.38,0:13:48.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pertarungannya.
Dialogue: 0,0:13:52.39,0:13:55.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Gravitasi: Heavy Infighting!
Dialogue: 0,0:13:59.96,0:14:04.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah tadi kau bilang\Naku boleh menyerang sepuasnya?
Dialogue: 0,0:14:04.40,0:14:05.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bos Besar?
Dialogue: 0,0:14:05.94,0:14:09.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tutup mulutmu, dasar pencuri sialan!
Dialogue: 0,0:14:10.83,0:14:14.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Gravitasi: Kehadiran Raja Iblis!
Dialogue: 0,0:14:15.26,0:14:17.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jumlah daya sihir kita sama.
Dialogue: 0,0:14:18.08,0:14:21.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa tahan! Terima ini!
Dialogue: 0,0:14:31.33,0:14:32.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa pun
Dialogue: 0,0:14:34.79,0:14:36.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang kau lakukan,
Dialogue: 0,0:14:36.85,0:14:41.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}selama aku punya\Nsihir regenerasi tubuh ini...
Dialogue: 0,0:14:42.25,0:14:46.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak akan pernah bisa mengalahkanku.
Dialogue: 0,0:14:47.53,0:14:51.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya kau sadar diri,
Dialogue: 0,0:14:51.92,0:14:53.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berlutut, dan menyesal
Dialogue: 0,0:14:53.87,0:14:56.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena telah menantangku!
Dialogue: 0,0:14:58.21,0:14:59.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski harus merangkak atau meronta-ronta,
Dialogue: 0,0:14:59.96,0:15:03.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau tetap berjuang dan terus berusaha
Dialogue: 0,0:15:03.21,0:15:06.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menjaga nyala api tetap terang\Ndan mempersiapkan diri hingga hari ini.
Dialogue: 0,0:15:07.97,0:15:11.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak peduli jika lawanmu bos pasukan musuh,
Dialogue: 0,0:15:11.14,0:15:12.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dirasuki iblis,
Dialogue: 0,0:15:13.14,0:15:14.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau bahkan makhluk abadi...
Dialogue: 0,0:15:15.85,0:15:16.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menangkan ini,
Dialogue: 0,0:15:19.48,0:15:20.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Magna!
Dialogue: 0,0:15:26.86,0:15:28.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daya sihir ini...
Dialogue: 0,0:15:32.28,0:15:35.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keparat, beraninya kau...
Dialogue: 0,0:15:35.03,0:15:37.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beraninya kau meninju wajahku,
Dialogue: 0,0:15:37.35,0:15:40.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan membuatku berbaring!
Dialogue: 0,0:16:00.52,0:16:04.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski kau mencuri setengah daya sihirku\Ndengan sihir yang licik,
Dialogue: 0,0:16:04.48,0:16:07.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan menyerang secara bertubi-tubi\Ndengan kekuatan yang sama...
Dialogue: 0,0:16:07.61,0:16:12.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya kau yang terluka,\Nsementara tubuhku kembali pulih!
Dialogue: 0,0:16:12.88,0:16:16.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada akhirnya,\Nkemampuan kita memang berbeda!
Dialogue: 0,0:16:16.28,0:16:17.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan kau orangnya!
Dialogue: 0,0:16:18.43,0:16:21.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makhluk rendahan sepertimu
Dialogue: 0,0:16:21.19,0:16:24.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak akan pernah bisa\Nmemberiku hiburan sejati!
Dialogue: 0,0:16:26.79,0:16:29.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, kau benar.
Dialogue: 0,0:16:30.20,0:16:32.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya orang biasa.
Dialogue: 0,0:16:33.35,0:16:36.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak lahir, aku bukan dari\Nkeluarga bangsawan atau wangsa terpandang.
Dialogue: 0,0:16:37.72,0:16:42.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga bukan Luck,\Norang biasa dengan naluri yang sangat tajam,
Dialogue: 0,0:16:42.23,0:16:47.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bukan juga Asta yang orang biasa\Ntapi punya anti-sihir yang luar biasa kuat.
Dialogue: 0,0:16:49.80,0:16:51.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu, aku...
Dialogue: 0,0:16:52.46,0:16:55.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerajaan Heart seru, tidak?
Dialogue: 0,0:16:56.46,0:16:59.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ha-Halo. Begini...
Dialogue: 0,0:16:59.21,0:17:01.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yami, kenapa kau...
Dialogue: 0,0:17:01.36,0:17:02.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:17:02.60,0:17:06.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau memasukkanku ke pasukanmu?
Dialogue: 0,0:17:06.20,0:17:08.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Hm...
Dialogue: 0,0:17:08.66,0:17:11.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin karena selera kita mirip?
Dialogue: 0,0:17:11.83,0:17:14.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:17:14.63,0:17:16.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu...
Dialogue: 0,0:17:18.66,0:17:22.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelihatannya kau orang\Nyang mentalnya paling kuat.
Dialogue: 0,0:17:26.46,0:17:27.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku...
Dialogue: 0,0:17:29.92,0:17:32.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku...!
Dialogue: 0,0:17:33.57,0:17:36.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak akan kalah kalau soal kekuatan mental!
Dialogue: 0,0:18:03.30,0:18:05.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memutar otak untuk menciptakan sihir ini,
Dialogue: 0,0:18:05.75,0:18:08.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan berlatih dengan sekuat tenaga!
Dialogue: 0,0:18:08.15,0:18:10.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sama sekali tidak berhak
Dialogue: 0,0:18:11.36,0:18:15.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berkomentar macam-macam soal aku!
Dialogue: 0,0:18:54.02,0:18:59.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kuledakkan kau sampai hancur lebur,\Ndasar pecundang!
Dialogue: 0,0:19:07.00,0:19:08.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus.
Dialogue: 0,0:19:09.26,0:19:11.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau paham sekarang?
Dialogue: 0,0:19:11.29,0:19:14.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inilah kenyataan yang tak adil\Ndan tak mengenal kesetaraan.
Dialogue: 0,0:19:14.83,0:19:18.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keroco sepertimu berusaha sekuat apa pun...
Dialogue: 0,0:19:18.72,0:19:20.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya akan
Dialogue: 0,0:19:20.68,0:19:22.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berakhir sia-sia!
Dialogue: 0,0:19:29.30,0:19:30.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:19:30.65,0:19:33.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan iblis menghilang seutuhnya?
Dialogue: 0,0:19:33.45,0:19:35.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, ini...
Dialogue: 0,0:19:36.03,0:19:39.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keparat! Apa yang kau lakukan kali ini?!
Dialogue: 0,0:19:41.24,0:19:43.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak melakukan apa-apa, dasar bodoh.
Dialogue: 0,0:19:43.66,0:19:47.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau dan aku sama-sama kehabisan daya sihir.
Dialogue: 0,0:19:49.25,0:19:51.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Monster sepertimu mungkin tidak pernah
Dialogue: 0,0:19:51.68,0:19:54.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}merasakan sensasi kehabisan daya sihir.
Dialogue: 0,0:19:55.12,0:19:59.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau juga tak pernah bertarung\Ndengan orang yang setara denganmu.
Dialogue: 0,0:19:59.23,0:20:04.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pasti tidak sadar sudah menghabiskan\Nbegitu banyak daya sihir, bukan?!
Dialogue: 0,0:20:04.96,0:20:09.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika aku kehabisan daya sihir,\Nkoneksiku dengan Lucifero juga akan terputus?
Dialogue: 0,0:20:10.35,0:20:14.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir gravitasi, dan sihir regenerasi tubuh\Nsuper cepat juga?
Dialogue: 0,0:20:14.73,0:20:18.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang kau tak bisa\Nmenggunakan sihir apa pun lagi.
Dialogue: 0,0:20:18.48,0:20:21.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah kau juga sama...?
Dialogue: 0,0:20:34.62,0:20:36.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mungkin kalah!
Dialogue: 0,0:20:36.59,0:20:40.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang sepertiku, melawan orang sepertimu...
Dialogue: 0,0:20:41.51,0:20:44.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di hadapan orang sepertimu...!
Dialogue: 0,0:20:47.39,0:20:49.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Habisi dia!
Dialogue: 0,0:21:00.05,0:21:02.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang sepertiku tidak mungkin...!
Dialogue: 0,0:21:02.91,0:21:04.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berisik!
Dialogue: 0,0:21:04.82,0:21:07.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar kau orang gila!
Dialogue: 0,0:22:07.19,0:22:10.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kaulah pemenangnya, Magna.
Dialogue: 0,0:22:11.16,0:22:14.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Bang Zora.
Dialogue: 0,0:22:14.25,0:22:16.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang, aku bukan abangmu.
