Dialogue: 0,0:01:59.57,0:02:04.99,sign,,0000,0000,0000,,EPISODE 178: JANTUNG IBLIS
Dialogue: 0,0:07:41.91,0:07:44.21,sign,,0000,0000,0000,,"BEBERAPA SAAT SEBELUM MEGICULA DIKALAHKAN"
Dialogue: 0,0:00:00.58,0:00:02.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamilah yang menang
Dialogue: 0,0:00:02.87,0:00:06.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena tidak menyerah, Megicula!
Dialogue: 0,0:00:07.84,0:00:09.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya aku salah menilai
Dialogue: 0,0:00:10.34,0:00:14.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}wujud asli kekuatan kalian.
Dialogue: 0,0:00:20.52,0:00:24.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian berdua benar-benar\Nsudah bertambah kuat.
Dialogue: 0,0:02:26.06,0:02:28.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Noelle! Kau berhasil!
Dialogue: 0,0:02:28.73,0:02:30.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asta, Lolopechka!
Dialogue: 0,0:02:31.15,0:02:32.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena Megicula sudah dikalahkan,
Dialogue: 0,0:02:32.52,0:02:34.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kutukan pada Lolopechka juga pasti sudah...
Dialogue: 0,0:02:40.28,0:02:42.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ratu Lolopechka, kau sudah siuman?
Dialogue: 0,0:02:46.24,0:02:47.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku, maafkan aku!
Dialogue: 0,0:02:47.41,0:02:49.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku yang telanjang ini!
Dialogue: 0,0:02:49.12,0:02:52.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Te-Tenang saja!\NAku tidak melihat apa-apa, kok!
Dialogue: 0,0:02:52.42,0:02:54.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kau lakukan, Asta bodoh?!
Dialogue: 0,0:02:54.50,0:02:56.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku diam saja, kok!
Dialogue: 0,0:02:57.67,0:02:58.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lolopechka.
Dialogue: 0,0:03:00.34,0:03:01.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah kau masih hidup.
Dialogue: 0,0:03:02.39,0:03:04.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lolopechka!
Dialogue: 0,0:03:04.85,0:03:06.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Noelle...
Dialogue: 0,0:03:06.47,0:03:07.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Undine.
Dialogue: 0,0:03:08.14,0:03:10.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Noelle, kenapa tiba-tiba meninjuku, sih?!
Dialogue: 0,0:03:10.64,0:03:12.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tutup mulut, Asta bodoh!
Dialogue: 0,0:03:12.35,0:03:13.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sendiri yang...
Dialogue: 0,0:03:16.19,0:03:17.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duh, bagaimana ini?
Dialogue: 0,0:03:17.28,0:03:19.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku senang karena\Nakhirnya bertemu lagi.
Dialogue: 0,0:03:19.74,0:03:20.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, Noelle?
Dialogue: 0,0:03:20.78,0:03:23.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi saking malunya,\Naku tidak bisa melihat mukanya langsung!
Dialogue: 0,0:03:23.20,0:03:24.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau kenapa, Noelle?
Dialogue: 0,0:03:25.07,0:03:27.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak kenapa-kenapa, Asta bodoh!
Dialogue: 0,0:03:31.96,0:03:34.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal kutukannya sudah menghilang,
Dialogue: 0,0:03:34.29,0:03:37.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku bingung\Nharus bicara apa pada Noelle.
Dialogue: 0,0:03:37.92,0:03:39.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakanda Nozel?
Dialogue: 0,0:03:39.67,0:03:41.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku, Charlotte.
Dialogue: 0,0:03:42.09,0:03:45.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Efek sihirnya akan menghilang sebentar lagi.
Dialogue: 0,0:03:45.76,0:03:49.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku masih belum bisa\Nmencapai karya terbaikku.
Dialogue: 0,0:03:49.56,0:03:52.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga, karya terbaikku adalah...
Dialogue: 0,0:03:52.14,0:03:53.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa minta maaf, Rill?
Dialogue: 0,0:03:54.73,0:03:57.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkat bantuanmu, aku bisa ikut bertarung.
Dialogue: 0,0:03:58.23,0:03:59.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk itu, terima kasih.
Dialogue: 0,0:04:01.15,0:04:05.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlebih, kita belum boleh mati di sini.
Dialogue: 0,0:04:05.78,0:04:07.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau juga setuju, 'kan?
Dialogue: 0,0:04:09.20,0:04:10.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei!
Dialogue: 0,0:04:11.08,0:04:12.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luck!
Dialogue: 0,0:04:12.16,0:04:13.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Noelle keren banget, deh.
Dialogue: 0,0:04:13.92,0:04:16.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bisa mengalahkan iblis tingkat tertinggi.
Dialogue: 0,0:04:22.26,0:04:24.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak boleh santai-santai saja, nih.
Dialogue: 0,0:04:25.72,0:04:26.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadjah!
Dialogue: 0,0:04:27.05,0:04:30.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Lolopechka, syukurlah kau baik-baik...
Dialogue: 0,0:04:37.31,0:04:38.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadjah!
Dialogue: 0,0:04:40.23,0:04:41.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Komandan Charlotte!
Dialogue: 0,0:04:41.44,0:04:42.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Komandan Rill!
Dialogue: 0,0:04:46.36,0:04:49.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Air Penyembuh: Aquenelle Lore.
Dialogue: 0,0:04:53.71,0:04:58.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihirku tidak bisa\Nmenyembuhkan luka separah ini.
Dialogue: 0,0:04:58.84,0:05:01.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak... Mereka sudah menolongku...
Dialogue: 0,0:05:01.92,0:05:04.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku malah... Aku...
Dialogue: 0,0:05:05.05,0:05:08.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang Penghancur Iblis-ku\Ntidak bisa membantu.
Dialogue: 0,0:05:08.34,0:05:11.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial! Apa kita tidak bisa membantu mereka?!
Dialogue: 0,0:05:12.06,0:05:13.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin...
Dialogue: 0,0:05:13.89,0:05:17.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang sudah berjuang demi hal baik
Dialogue: 0,0:05:17.02,0:05:19.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak boleh dibiarkan mati begitu saja!
Dialogue: 0,0:05:19.98,0:05:22.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu buang-buang tenaga untuk mereka.
Dialogue: 0,0:05:22.98,0:05:24.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wakil Komandan Nacht.
Dialogue: 0,0:05:24.94,0:05:27.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian sudah mengalahkan\Niblis tingkat tertinggi.
Dialogue: 0,0:05:27.53,0:05:29.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu saja sudah bisa disebut prestasi.
Dialogue: 0,0:05:30.20,0:05:33.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak semua orang baik bisa diselamatkan.
Dialogue: 0,0:05:33.83,0:05:35.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah kenyataan.
Dialogue: 0,0:05:36.25,0:05:38.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski aku juga ingin mereka selamat.
Dialogue: 0,0:05:38.88,0:05:40.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, sudah ajak dia?
Dialogue: 0,0:05:41.00,0:05:42.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah.
Dialogue: 0,0:05:42.75,0:05:44.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi mereka sudah...
Dialogue: 0,0:05:49.68,0:05:50.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tidak benar.
Dialogue: 0,0:05:54.06,0:05:55.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mimosa pasti bisa!
Dialogue: 0,0:05:57.60,0:06:00.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan membiarkan siapa pun mati!
Dialogue: 0,0:06:03.23,0:06:05.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Pemungkas Tumbuhan:
Dialogue: 0,0:06:06.49,0:06:08.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taman Impian Putri Bunga!
Dialogue: 0,0:06:13.45,0:06:15.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir penyembuh ini...
Dialogue: 0,0:06:15.83,0:06:18.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa salahnya kita memutarbalikkan kenyataan?
Dialogue: 0,0:06:18.79,0:06:20.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah itu
Dialogue: 0,0:06:21.50,0:06:22.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}esensi sihir?
Dialogue: 0,0:06:23.96,0:06:25.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadjah!
Dialogue: 0,0:06:25.76,0:06:27.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rill!
Dialogue: 0,0:06:27.01,0:06:28.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Komandan Charlotte!
Dialogue: 0,0:06:28.42,0:06:30.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah!
Dialogue: 0,0:06:31.01,0:06:34.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mimosa keren banget!
Dialogue: 0,0:06:35.60,0:06:37.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sampai bertaruh nyawa demi aku...
Dialogue: 0,0:06:37.73,0:06:39.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku, maafkan aku!
Dialogue: 0,0:06:39.89,0:06:43.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa,\Nini kewajibanku sebagai Penjaga Roh.
Dialogue: 0,0:06:44.07,0:06:45.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian ini, ya.
Dialogue: 0,0:06:45.48,0:06:48.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah ada yang lebih perlu dikatakan?
Dialogue: 0,0:06:52.99,0:06:54.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cinta padamu.
Dialogue: 0,0:06:58.33,0:07:00.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan sebagai ratu,
Dialogue: 0,0:07:00.42,0:07:02.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi sebagai seorang wanita.
Dialogue: 0,0:07:02.21,0:07:03.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perasaanku padamu...
Dialogue: 0,0:07:08.42,0:07:10.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga. Tunggu... Kau...!
Dialogue: 0,0:07:10.47,0:07:11.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku salah bicara, ya?
Dialogue: 0,0:07:12.05,0:07:15.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lolopechka itu punyaku!
Dialogue: 0,0:07:15.14,0:07:16.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kalau orangnya Gadjah...
Dialogue: 0,0:07:20.06,0:07:24.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Walau menyebalkan,\NNoelle bisa bertambah kuat berkat dia.
Dialogue: 0,0:07:25.06,0:07:28.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus selamatkan Yami.
Dialogue: 0,0:07:31.70,0:07:37.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya mereka bertambah kuat\Njauh di luar perkiraanku.
Dialogue: 0,0:07:38.87,0:07:41.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang, anggota Dark Triad\Ntinggal seorang lagi.
Dialogue: 0,0:07:41.91,0:07:44.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang tersisa adalah...
Dialogue: 0,0:07:49.59,0:07:52.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita hanya membuang-buang waktu.
Dialogue: 0,0:07:52.68,0:07:54.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktunya mengakhiri semua.
Dialogue: 0,0:07:57.51,0:08:00.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sialan. Kita harus bagaimana?
Dialogue: 0,0:08:00.22,0:08:01.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Langris.
Dialogue: 0,0:08:02.35,0:08:03.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ulur waktu tiga menit.
Dialogue: 0,0:08:04.06,0:08:06.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menghabisinya\Ndengan serangan berikutnya.
Dialogue: 0,0:08:07.77,0:08:10.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku punya sihir yang bisa membunuhnya.
Dialogue: 0,0:08:10.40,0:08:12.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku perlu waktu\Nuntuk mengumpulkan daya sihir.
Dialogue: 0,0:08:13.82,0:08:17.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak bisa menyerang\Nsambil menepis serangannya.
Dialogue: 0,0:08:18.20,0:08:20.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk mengalahkannya...
Dialogue: 0,0:08:20.75,0:08:24.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus jadi umpan dan melindungi Yuno!
Dialogue: 0,0:08:24.87,0:08:26.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu...
Dialogue: 0,0:08:26.29,0:08:29.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baru bisa menghindar dengan bantuan Yuno,
Dialogue: 0,0:08:29.96,0:08:33.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}orang sepertiku tidak mungkin bisa\Nmengulur waktu sampai tiga menit.
Dialogue: 0,0:08:33.97,0:08:36.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi tetap harus dilakukan!
Dialogue: 0,0:08:38.67,0:08:42.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau kan penyihir ruang terbaik\Ndi Kerajaan Clover,
Dialogue: 0,0:08:42.77,0:08:45.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku yakin kau sudah bisa melihat celahnya.
Dialogue: 0,0:08:45.60,0:08:49.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bilang kau mau dihajar\Nsecara sepihak olehnya?
Dialogue: 0,0:08:52.24,0:08:56.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah paham betul kekuatan kalian!
Dialogue: 0,0:08:57.41,0:09:00.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam Ruang Absolut Zenon,\N"Dominasi Mana Ruang",
Dialogue: 0,0:09:00.99,0:09:04.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mayoritas orang bahkan\Ntidak bisa menggunakan sihir.
Dialogue: 0,0:09:04.58,0:09:07.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang bisa menggunakan sihir hanyalah
Dialogue: 0,0:09:07.00,0:09:09.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}seseorang dengan daya sihir\Nyang setara dengannya,
Dialogue: 0,0:09:09.75,0:09:14.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}orang yang dicintai mana, seperti Yuno,\Ndan mampu terbebas dari belenggunya,
Dialogue: 0,0:09:16.72,0:09:17.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu...
Dialogue: 0,0:09:19.05,0:09:22.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}penyihir ruang yang sudah\Nmenguasai Mana Zone!
Dialogue: 0,0:09:27.81,0:09:30.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski kecil,\Ndia mampu menciptakan ruangnya sendiri
Dialogue: 0,0:09:30.44,0:09:33.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di dalam Ruang Absolutku.
Dialogue: 0,0:09:33.69,0:09:35.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuh, kan. Selama mau mencoba, kau pasti bisa.
Dialogue: 0,0:09:35.90,0:09:37.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau memang hebat.
Dialogue: 0,0:09:37.78,0:09:38.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar.
Dialogue: 0,0:09:38.95,0:09:42.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau ini memang junior yang jago sarkas.
Dialogue: 0,0:09:43.20,0:09:44.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak awal bergabung,
Dialogue: 0,0:09:44.70,0:09:46.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}junior satu ini sudah sombong\Ndan kurang ajar,
Dialogue: 0,0:09:46.62,0:09:49.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi dia punya kemampuan yang sepadan.
Dialogue: 0,0:09:50.17,0:09:53.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau diingat lagi,\Naku benci dia karena kami mirip.
Dialogue: 0,0:09:54.59,0:09:58.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, aku tak pernah merasa akan kalah.
Dialogue: 0,0:09:58.63,0:10:02.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kupikir orang sepertimu\Nmustahil bisa melampauiku.
Dialogue: 0,0:10:04.18,0:10:07.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi pada akhirnya,\Nkau tidak bisa menyerangku.
Dialogue: 0,0:10:08.31,0:10:11.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian tak punya sihir\Nyang mampu mengalahkanku.
Dialogue: 0,0:10:13.32,0:10:16.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daya sihir orang ini sudah beda level!
Dialogue: 0,0:10:16.36,0:10:18.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga, aku tak bisa bertahan lama.
Dialogue: 0,0:10:20.11,0:10:22.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan lama-lama, ya.
Dialogue: 0,0:10:22.74,0:10:24.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedang kuusahakan!
Dialogue: 0,0:10:25.79,0:10:26.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:10:26.91,0:10:29.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dulu, sihir ruangkulah yang terbaik.
Dialogue: 0,0:10:30.54,0:10:33.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama aku berusaha sedikit, semua akan aman.
Dialogue: 0,0:10:33.59,0:10:37.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama ada aku, pasukankulah yang terkuat.
Dialogue: 0,0:10:37.76,0:10:40.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, kekuatanmu berbeda.
Dialogue: 0,0:10:41.97,0:10:45.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mendorong kami bagaikan embusan angin.
Dialogue: 0,0:10:45.18,0:10:47.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seolah kami ikut terbang bersamamu.
Dialogue: 0,0:10:47.22,0:10:50.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatanmu tidak egois sama sekali.
Dialogue: 0,0:10:52.86,0:10:55.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semangat tidak mau kalahmu\Nmenginspirasi kami,
Dialogue: 0,0:10:56.23,0:10:57.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan membuat kami makin kuat.
Dialogue: 0,0:11:00.53,0:11:04.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang menyebalkan, tapi harus kuakui.
Dialogue: 0,0:11:05.12,0:11:09.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kaulah... Wakil Komandan Pasukan Fajar Emas!
Dialogue: 0,0:11:10.83,0:11:13.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di hadapan kekuatan yang mendominasi,
Dialogue: 0,0:11:13.75,0:11:17.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tekad dan kegigihan,\Nsemuanya tak berarti apa-apa.
Dialogue: 0,0:11:20.80,0:11:22.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang ada hanyalah
Dialogue: 0,0:11:22.76,0:11:27.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}fakta bahwa aku lebih kuat dari kalian.
Dialogue: 0,0:11:28.06,0:11:33.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetap saja, aku tidak bisa mengamini\Nkata-katamu dan mundur begitu saja!
Dialogue: 0,0:11:39.07,0:11:40.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami adalah
Dialogue: 0,0:11:40.95,0:11:43.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pasukan Kesatria Sihir terkuat,
Dialogue: 0,0:11:43.36,0:11:45.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fajar Emas!
Dialogue: 0,0:11:46.37,0:11:47.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau juga
Dialogue: 0,0:11:49.25,0:11:52.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sama-sama benci kalau sampai kalah!
Dialogue: 0,0:11:53.08,0:11:55.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Penciptaan Roh Angin:
Dialogue: 0,0:11:55.38,0:11:57.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Spirit of Euros.
Dialogue: 0,0:12:12.35,0:12:14.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat sekali.
Dialogue: 0,0:12:14.73,0:12:19.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak kusangka dia bisa\Nmenembus tubuh ini sepenuhnya.
Dialogue: 0,0:12:20.99,0:12:24.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kegigihan kamilah yang menang.
Dialogue: 0,0:12:29.58,0:12:30.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Allen...
Dialogue: 0,0:12:39.67,0:12:41.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau kenapa lagi?
Dialogue: 0,0:12:42.38,0:12:46.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luka lagi, ya? Dasar pecundang.
Dialogue: 0,0:12:46.26,0:12:47.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar, deh.
Dialogue: 0,0:12:47.68,0:12:50.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau itu adikku, apa tidak malu?
Dialogue: 0,0:12:56.69,0:12:59.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan khawatir, Zenon.
Dialogue: 0,0:13:01.48,0:13:02.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakanda.
Dialogue: 0,0:13:03.15,0:13:06.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kaulah yang paling mirip denganku.
Dialogue: 0,0:13:08.82,0:13:11.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau jauh lebih cocok menjadi pengguna iblis
Dialogue: 0,0:13:11.66,0:13:14.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dibandingkan Dante dan Vanica.
Dialogue: 0,0:13:18.38,0:13:19.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Woi!
Dialogue: 0,0:13:20.46,0:13:21.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima ini!
Dialogue: 0,0:13:23.42,0:13:25.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}John kuat banget!
Dialogue: 0,0:13:25.51,0:13:29.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar anak aneh yang bisa\Nmengeluarkan tulang dari tubuh!
Dialogue: 0,0:13:29.89,0:13:33.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayahku bekerja di Pasukan Pertahanan Sihir.
Dialogue: 0,0:13:33.81,0:13:36.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja aku akan menghabisimu!
Dialogue: 0,0:13:39.02,0:13:40.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Panas, panas!
Dialogue: 0,0:13:40.23,0:13:41.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bicara apa kau?
Dialogue: 0,0:13:42.48,0:13:45.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin saja sihirnya agak unik.
Dialogue: 0,0:13:45.95,0:13:47.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waduh, Allen datang!
Dialogue: 0,0:13:47.49,0:13:49.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kabur!
Dialogue: 0,0:13:49.32,0:13:51.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal ayahnya orang\NPasukan Pertahanan Sihir.
Dialogue: 0,0:13:51.87,0:13:53.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malu-maluin.
Dialogue: 0,0:13:55.33,0:13:56.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namaku Allen!
Dialogue: 0,0:13:56.75,0:13:59.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihirmu kelihatan kuat banget, ya.
Dialogue: 0,0:14:03.00,0:14:05.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua orang takut dan cemas.
Dialogue: 0,0:14:06.22,0:14:09.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerajaan Spade selalu diselimuti salju.
Dialogue: 0,0:14:09.55,0:14:11.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gerakan pemberontakan juga banyak.
Dialogue: 0,0:14:11.72,0:14:14.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah begitu ada invasi\Ndari Kerajaan Diamond.
Dialogue: 0,0:14:15.35,0:14:17.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin bertambah kuat
Dialogue: 0,0:14:17.02,0:14:20.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan melindungi rakyat\Nyang dirundung rasa takut.
Dialogue: 0,0:14:21.52,0:14:23.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin menjadi percikan api harapan
Dialogue: 0,0:14:23.23,0:14:26.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang mampu menyinari tanah tundra ini!
Dialogue: 0,0:14:28.95,0:14:29.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu...
Dialogue: 0,0:14:30.78,0:14:34.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan jadi panglima tertinggi\NPasukan Pertahanan Sihir!
Dialogue: 0,0:14:35.70,0:14:36.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga...
Dialogue: 0,0:14:39.04,0:14:41.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga mau jadi panglima tertinggi.
Dialogue: 0,0:14:41.50,0:14:44.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti kita ini rival, ya.
Dialogue: 0,0:14:44.71,0:14:48.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo bertanding siapa yang lebih dulu\Njadi panglima tertinggi!
Dialogue: 0,0:15:01.19,0:15:03.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakanda, maafkan aku.
Dialogue: 0,0:15:05.11,0:15:06.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku...
Dialogue: 0,0:15:06.86,0:15:09.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak tertarik menjadi pengguna iblis.
Dialogue: 0,0:15:13.28,0:15:17.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat bergabung ke Divisi Keempat\NPasukan Pertahanan Sihir!
Dialogue: 0,0:15:18.00,0:15:20.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dua anggota baru tahun ini sudah siap tempur.
Dialogue: 0,0:15:20.87,0:15:23.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terutama Zenon dan sihir tulangnya,\Ndia sangat berbakat!
Dialogue: 0,0:15:24.75,0:15:27.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada dungeon yang muncul\Ndi wilayah utara Kota Lawton!
Dialogue: 0,0:15:27.76,0:15:30.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Divisi Keempat diperintahkan\Nmelakukan investigasi ke lokasi!
Dialogue: 0,0:15:30.63,0:15:33.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan kalah lagi, Zenon!
Dialogue: 0,0:15:35.05,0:15:37.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada menang-kalah\Nsaat menjalankan misi, Allen.
Dialogue: 0,0:15:37.85,0:15:40.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau masih saja serius seperti dulu.
Dialogue: 0,0:15:52.66,0:15:55.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa sangka ada iblis\Nyang disegel di sini...
Dialogue: 0,0:15:55.74,0:15:57.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatannya di luar nalar.
Dialogue: 0,0:15:57.33,0:15:59.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dibiarkan saja, kita semua bisa mati!
Dialogue: 0,0:16:01.00,0:16:03.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk mengalahkannya,
Dialogue: 0,0:16:03.29,0:16:05.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku harus mengerahkan seluruh daya sihirku
Dialogue: 0,0:16:05.13,0:16:07.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan menembakkan sihir terkuatku!
Dialogue: 0,0:16:07.75,0:16:11.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi tak ada celah untukku menembak!
Dialogue: 0,0:16:11.72,0:16:12.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menjadi
Dialogue: 0,0:16:12.72,0:16:15.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}panglima tertinggi Pasukan Pertahanan Sihir!
Dialogue: 0,0:16:18.43,0:16:21.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan kalah di tempat seperti ini!
Dialogue: 0,0:16:21.31,0:16:22.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Allen!
Dialogue: 0,0:16:23.06,0:16:25.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, kau hanya bisa mengulur waktu!
Dialogue: 0,0:16:28.40,0:16:29.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya ini kesempatanku...
Dialogue: 0,0:16:30.86,0:16:33.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kutembak sekarang,\Naku bisa mengalahkan iblis itu.
Dialogue: 0,0:16:33.45,0:16:35.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu juga dengan Allen.
Dialogue: 0,0:16:36.20,0:16:37.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika tidak kuhabisi sekarang juga,
Dialogue: 0,0:16:38.20,0:16:41.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}semua orang, termasuk aku, yang ada di sini
Dialogue: 0,0:16:41.37,0:16:42.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan mati.
Dialogue: 0,0:16:43.96,0:16:46.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, kerusakan akan merembet\Nsampai ke kota...
Dialogue: 0,0:16:46.75,0:16:50.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya, penduduk di kota terdekat\Nakan mati.
Dialogue: 0,0:17:01.52,0:17:04.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih belum!
Dialogue: 0,0:17:10.90,0:17:12.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanpa kekuatan,
Dialogue: 0,0:17:12.99,0:17:15.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tekad dan kegigihan tak memiliki arti.
Dialogue: 0,0:17:18.36,0:17:21.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang lemah harus dibuang.
Dialogue: 0,0:17:24.32,0:17:27.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan absolut adalah segalanya!
Dialogue: 0,0:17:29.59,0:17:32.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika iblis biasa saja sudah sekuat itu...
Dialogue: 0,0:17:32.09,0:17:33.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:17:34.17,0:17:35.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakanda.
Dialogue: 0,0:17:37.18,0:17:40.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong jadikan aku pengguna iblis.
Dialogue: 0,0:17:44.48,0:17:47.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beelzebub, ini pertukaran.
Dialogue: 0,0:17:48.19,0:17:50.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berikan aku jantung iblis.
Dialogue: 0,0:17:52.73,0:17:54.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jantung, katamu?
Dialogue: 0,0:17:59.74,0:18:03.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya kau akan menukar itu dengan apa?
Dialogue: 0,0:18:03.91,0:18:05.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua yang menjadi milikku.
Dialogue: 0,0:18:07.37,0:18:09.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesuai kontrak kita,
Dialogue: 0,0:18:09.54,0:18:12.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}selama Kerajaan Spade tetap ada,
Dialogue: 0,0:18:12.42,0:18:15.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku bahkan rela memberikan jiwaku.
Dialogue: 0,0:18:18.47,0:18:19.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh.
Dialogue: 0,0:18:20.72,0:18:22.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kuberikan itu.
Dialogue: 0,0:18:34.07,0:18:35.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa...?
Dialogue: 0,0:18:44.16,0:18:45.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sensasi ini...
Dialogue: 0,0:18:46.54,0:18:48.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sama seperti iblis itu!
Dialogue: 0,0:18:48.50,0:18:52.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah mendapatkan jantung iblis,
Dialogue: 0,0:18:52.17,0:18:55.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kekuatanku akan lebih besar dari sebelumnya.
Dialogue: 0,0:18:56.17,0:18:58.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa menggunakan kekuatan iblis,
Dialogue: 0,0:18:58.38,0:19:00.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan memiliki jantung iblis.
Dialogue: 0,0:19:00.63,0:19:02.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manusia seperti itu...
Dialogue: 0,0:19:03.30,0:19:04.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih pantas disebut iblis!
Dialogue: 0,0:19:22.24,0:19:25.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serangan panahmu tadi...
Dialogue: 0,0:19:25.91,0:19:30.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau arahkan sedikit ke samping\Nagar tidak mengenai temanmu.
Dialogue: 0,0:19:30.29,0:19:32.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kau juga tidak mengenai\Njantungku sepenuhnya.
Dialogue: 0,0:19:35.21,0:19:39.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau mengorbankan temanmu\Ndan menembak jantungku,
Dialogue: 0,0:19:40.26,0:19:42.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau pasti sudah menang sekarang.
Dialogue: 0,0:20:11.87,0:20:13.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang sekarat sepertimu ini
Dialogue: 0,0:20:14.12,0:20:16.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}masih mau bangkit dan melawan?
Dialogue: 0,0:20:17.21,0:20:19.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kubantu kau "istirahat".
Dialogue: 0,0:20:28.56,0:20:30.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo, Langris.
Dialogue: 0,0:20:30.64,0:20:31.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak?!
Dialogue: 0,0:20:31.93,0:20:33.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia...
Dialogue: 0,0:20:34.65,0:20:37.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak tahu kenapa kau ada di sini...
Dialogue: 0,0:20:37.36,0:20:39.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bilang kau datang\Nuntuk menyelamatkanku lagi?!
Dialogue: 0,0:20:40.11,0:20:41.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat melihatmu dan dia,
Dialogue: 0,0:20:41.86,0:20:43.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tanpa sadar aku sudah melompat masuk.
Dialogue: 0,0:20:44.32,0:20:45.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan.
Dialogue: 0,0:20:45.95,0:20:48.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia orang yang menculik komandan kami.
Dialogue: 0,0:20:49.08,0:20:51.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menggunakan sihir ruangnya.
Dialogue: 0,0:20:51.50,0:20:54.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin aku membiarkan dia pergi!
Dialogue: 0,0:20:55.79,0:20:56.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:20:57.13,0:21:00.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yami, aku ambil jalan memutar sedikit!
Dialogue: 0,0:21:00.96,0:21:04.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menempelkan "Kepakan Malaikat\NJatuh" pada Langris secara langsung.
Dialogue: 0,0:21:05.09,0:21:06.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perpindahan ruang secara instan!
Dialogue: 0,0:21:08.26,0:21:09.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski berada di dalam Ruang Absolut Zenon,
Dialogue: 0,0:21:09.97,0:21:13.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana Zone Langris membantuku\Nmenggunakan sihir.
Dialogue: 0,0:21:14.02,0:21:16.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Perpindahan Ruang Kakak
Dialogue: 0,0:21:16.40,0:21:18.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dikenal dengan kecepatan\Ndan akurasi yang tinggi.
Dialogue: 0,0:21:18.86,0:21:22.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama kita berdua, pasti bisa melawannya!
Dialogue: 0,0:21:22.57,0:21:23.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, 'kan? Langris!
Dialogue: 0,0:21:25.40,0:21:26.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar, deh.
Dialogue: 0,0:21:27.07,0:21:29.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar kakak yang sok jago!
Dialogue: 0,0:21:34.37,0:21:37.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tubuh Langris tidak kuat dalam\Npertempuran jangka panjang.
Dialogue: 0,0:21:37.25,0:21:38.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harus diselesaikan dengan cepat!
Dialogue: 0,0:21:39.79,0:21:44.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah tahu kecepatan dan\Ntempo perpindahan ruangnya.
Dialogue: 0,0:21:44.05,0:21:46.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu pula dengan tujuan mereka.
Dialogue: 0,0:21:46.43,0:21:49.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kuhabisi saat mereka\Ningin mengakhiri semuanya.
Dialogue: 0,0:21:49.59,0:21:50.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami harus mendekati dia...
Dialogue: 0,0:21:50.89,0:21:53.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Supaya bisa dimasukkan ke dalam Mana Zone!
Dialogue: 0,0:21:57.35,0:21:58.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah berakhir.
Dialogue: 0,0:22:01.15,0:22:02.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa...?
Dialogue: 0,0:22:04.07,0:22:07.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meningkatkan kecepatan dengan Mana Method!
Dialogue: 0,0:22:07.40,0:22:09.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Langris bisa\Nmengoyak ruang itu sendiri.
Dialogue: 0,0:22:09.95,0:22:13.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak peduli sekuat apa pun\Npertahanan yang kau punya,
Dialogue: 0,0:22:13.87,0:22:15.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}itu tidak berarti apa-apa!
