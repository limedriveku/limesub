Dialogue: 0,0:04:55.53,0:05:00.95,sign,,0000,0000,0000,,EPISODE 173: PELINDUNG HITAM
Dialogue: 0,0:00:01.39,0:00:03.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gerbang dunia bawahnya...
Dialogue: 0,0:00:03.48,0:00:05.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat! Moris harus disingkirkan!
Dialogue: 0,0:00:18.79,0:00:21.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Felis. Spesialis Lincah.
Dialogue: 0,0:00:21.15,0:00:22.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka...
Dialogue: 0,0:00:23.18,0:00:25.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iblis tingkat tertinggi!
Dialogue: 0,0:00:32.18,0:00:34.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Plumede gemetar.
Dialogue: 0,0:00:34.56,0:00:39.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dua iblis tingkat tertinggi\Ndari lapisan pertama dunia bawah.
Dialogue: 0,0:00:39.70,0:00:42.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira kekuatan mereka setara\Ndengan Dark Triad, tapi...
Dialogue: 0,0:00:47.57,0:00:50.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau kita serang dia\Nsedikit lebih serius?
Dialogue: 0,0:00:51.07,0:00:54.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, ayo.
Dialogue: 0,0:01:22.93,0:01:25.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Levelnya berbeda. Mereka...
Dialogue: 0,0:01:25.39,0:01:28.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mananya lezat, ya, Lilith?
Dialogue: 0,0:01:28.35,0:01:30.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau benar, Naamah.
Dialogue: 0,0:01:30.24,0:01:32.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya bermain-main!
Dialogue: 0,0:01:40.34,0:01:41.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akar-akar itu...
Dialogue: 0,0:01:42.22,0:01:46.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyerap mana dari udara...\NBukan, dari dunia itu sendiri?
Dialogue: 0,0:01:50.63,0:01:55.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan daya sihir raksasa\Nyang mengerikan ini?
Dialogue: 0,0:02:04.48,0:02:06.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu...
Dialogue: 0,0:02:06.44,0:02:07.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iblis!
Dialogue: 0,0:02:11.84,0:02:14.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daya sihir itu terasa mirip\Ndengan yang waktu itu.
Dialogue: 0,0:02:28.66,0:02:31.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, pertarungan sesungguhnya\Nbaru dimulai sekarang, ya?
Dialogue: 0,0:02:38.45,0:02:43.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak bisa menang\Ndengan kekuatan 80 persen.
Dialogue: 0,0:02:43.14,0:02:45.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sudah berakhir, Zenon!
Dialogue: 0,0:02:45.54,0:02:46.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi
Dialogue: 0,0:02:46.56,0:02:48.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sayang sekali.
Dialogue: 0,0:02:50.44,0:02:51.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini?
Dialogue: 0,0:02:51.87,0:02:53.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah menyegel kekuatan kutukannya,
Dialogue: 0,0:02:53.95,0:02:56.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi daya sihirnya malah bertambah?
Dialogue: 0,0:02:58.56,0:03:00.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gerbang pertama.
Dialogue: 0,0:03:01.26,0:03:05.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu adalah penghalang yang membuat\Nkontrak kami dengan iblis tidak sempurna.
Dialogue: 0,0:03:05.02,0:03:07.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan sekarang
Dialogue: 0,0:03:07.02,0:03:08.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}gerbang itu terbuka!
Dialogue: 0,0:03:08.96,0:03:11.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan iblis
Dialogue: 0,0:03:11.21,0:03:12.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}100 persen!
Dialogue: 0,0:03:26.30,0:03:29.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, mau kita lanjutkan?
Dialogue: 0,0:05:05.98,0:05:08.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf mengganggu selagi kau berbaring,
Dialogue: 0,0:05:09.55,0:05:13.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi temani aku sedikit lebih lama lagi, ya!
Dialogue: 0,0:05:26.05,0:05:28.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau jahat sekali padaku!
Dialogue: 0,0:05:28.78,0:05:32.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku suka sekali padamu.
Dialogue: 0,0:05:32.81,0:05:35.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, kita bertarung!
Dialogue: 0,0:05:45.06,0:05:49.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Regenerasi tulang dan daya serangnya\Nterus meningkat!
Dialogue: 0,0:05:49.41,0:05:52.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan luka yang dideritanya ikut pulih!
Dialogue: 0,0:05:52.88,0:05:57.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemenanganmu hanyalah mimpi sesaat.
Dialogue: 0,0:06:00.78,0:06:03.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sialan! Mereka ada di mana-mana!
Dialogue: 0,0:06:04.21,0:06:08.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Moris dibiarkan,\Nkeadaan akan makin parah.
Dialogue: 0,0:06:08.56,0:06:11.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus keluar dari sini\Ndan segera mengalahkannya.
Dialogue: 0,0:06:12.56,0:06:16.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi tak ada yang tahu apa yang akan\Ndilakukan para iblis tingkat tertinggi itu.
Dialogue: 0,0:06:16.69,0:06:19.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harus ada yang menghadapi mereka juga.
Dialogue: 0,0:06:19.98,0:06:23.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengalahkan Moris dan menahan para iblis.
Dialogue: 0,0:06:23.28,0:06:25.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cara terbaik bagi kami untuk menang adalah...
Dialogue: 0,0:06:28.66,0:06:29.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Plumede.
Dialogue: 0,0:06:31.28,0:06:33.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Matilah bersamaku.
Dialogue: 0,0:06:34.27,0:06:37.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalianlah yang akan mati.
Dialogue: 0,0:06:38.00,0:06:40.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi tenang saja.
Dialogue: 0,0:06:40.28,0:06:43.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, kalian sudah tidak punya tempat\Nuntuk pulang.
Dialogue: 0,0:06:43.38,0:06:44.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:06:50.06,0:06:52.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, lihat.
Dialogue: 0,0:07:13.58,0:07:16.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dewa Iblis!
Dialogue: 0,0:07:18.51,0:07:20.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dewa Iblis adalah manifestasi yang lahir
Dialogue: 0,0:07:20.89,0:07:24.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dari kebencian manusia\Ndan kekuatan dunia bawah.
Dialogue: 0,0:07:24.65,0:07:29.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dahulu kala, di Kerajaan Spade\Nada dua pemuda bangsawan kerajaan
Dialogue: 0,0:07:29.20,0:07:32.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang memiliki daya sihir luar biasa.
Dialogue: 0,0:07:32.13,0:07:34.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka bersahabat karib.
Dialogue: 0,0:07:34.82,0:07:39.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, seiring waktu,\Nmereka mulai saling membenci,
Dialogue: 0,0:07:39.79,0:07:44.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu berubah menjadi Dewa Iblis.\NMereka bertarung dan akhirnya disegel.
Dialogue: 0,0:07:44.88,0:07:50.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami membangkitkan dua Dewa Iblis yang\Nselama ini dijaga keluarga Grinberryall.
Dialogue: 0,0:07:50.02,0:07:53.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami melepaskan mereka\Nuntuk mengalihkan perhatian kalian.
Dialogue: 0,0:07:53.74,0:07:58.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan begitu banyak penyihir kalian di sini,
Dialogue: 0,0:07:58.00,0:08:01.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa tanah air kalian akan baik-baik saja?
Dialogue: 0,0:08:04.26,0:08:06.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia menyerap mana melalui sayapnya.
Dialogue: 0,0:08:10.59,0:08:13.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang daya sihirnya makin melonjak.
Dialogue: 0,0:08:19.27,0:08:22.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa melawannya dengan tubuh ini.
Dialogue: 0,0:08:22.86,0:08:25.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus bersiap\Nmelepaskan seluruh kekuatanku.
Dialogue: 0,0:08:25.66,0:08:28.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya, tolong bertahan sampai saat itu.
Dialogue: 0,0:08:28.78,0:08:32.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, tapi aku butuh bantuanmu.
Dialogue: 0,0:08:32.88,0:08:34.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengandalkanmu.
Dialogue: 0,0:08:39.87,0:08:41.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lari!
Dialogue: 0,0:08:41.46,0:08:44.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlalu besar! Kita tak bisa\Nberbuat apa-apa melawan makhluk itu!
Dialogue: 0,0:08:48.05,0:08:49.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Pusaran:
Dialogue: 0,0:08:49.80,0:08:51.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Area Heliks!
Dialogue: 0,0:08:56.78,0:08:59.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan biarkan dia maju lebih jauh!
Dialogue: 0,0:08:59.39,0:09:03.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selagi Komandan Kaiser\Ndan Pasukan Paus Ungu memperlambatnya,
Dialogue: 0,0:09:03.36,0:09:05.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}evakuasi warga!
Dialogue: 0,0:09:12.53,0:09:14.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Bunga Sakura:
Dialogue: 0,0:09:14.07,0:09:14.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Kabut:
Dialogue: 0,0:09:14.91,0:09:16.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Badai Kelopak Sakura!
Dialogue: 0,0:09:16.74,0:09:17.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ilusi Fana!
Dialogue: 0,0:09:22.54,0:09:23.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Solid!
Dialogue: 0,0:09:24.71,0:09:29.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Penciptaan Air: Raungan Ular Laut!
Dialogue: 0,0:09:34.16,0:09:35.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sialan!
Dialogue: 0,0:09:35.50,0:09:38.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku sudah berlatih selama enam bulan,
Dialogue: 0,0:09:38.42,0:09:41.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sihirku hanya bisa sedikit\Nmembelokkan arahnya!
Dialogue: 0,0:09:50.77,0:09:52.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daya sihirnya...
Dialogue: 0,0:09:52.24,0:09:54.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar berbeda level!
Dialogue: 0,0:09:54.24,0:09:57.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, sama sekali tidak indah!
Dialogue: 0,0:10:07.20,0:10:08.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Timbangan:
Dialogue: 0,0:10:08.71,0:10:10.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyeimbang!
Dialogue: 0,0:10:13.62,0:10:16.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daya sihir ini terlalu besar.
Dialogue: 0,0:10:16.10,0:10:19.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu-satunya cara\Nmelawan daya sihir sebesar itu
Dialogue: 0,0:10:19.18,0:10:22.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah dengan daya sihir yang sama besarnya.
Dialogue: 0,0:10:24.82,0:10:26.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir barusan...
Dialogue: 0,0:10:28.02,0:10:29.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat!
Dialogue: 0,0:10:34.74,0:10:36.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kaisar Sihir!
Dialogue: 0,0:10:36.00,0:10:37.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu Kaisar Sihir!
Dialogue: 0,0:10:38.05,0:10:41.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memajukan waktu tubuhku 10 tahun.
Dialogue: 0,0:10:41.55,0:10:44.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu dan kemampuanku terbatas,
Dialogue: 0,0:10:44.59,0:10:47.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kalau kugabungkan kekuatanku\Ndengan Damnatio...
Dialogue: 0,0:10:49.34,0:10:50.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang!
Dialogue: 0,0:10:58.91,0:11:01.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berikan aku kekuatan sekali lagi.
Dialogue: 0,0:11:05.10,0:11:08.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktuku sudah habis? Kenapa?\NTerlalu cepat!
Dialogue: 0,0:11:08.90,0:11:09.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:11:09.94,0:11:11.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kaisar Sihir?
Dialogue: 0,0:11:12.93,0:11:16.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak bisa menahannya lagi!
Dialogue: 0,0:11:32.96,0:11:34.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di dunia ini
Dialogue: 0,0:11:34.76,0:11:37.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sihir adalah segalanya.
Dialogue: 0,0:11:37.89,0:11:39.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tamatlah sudah.
Dialogue: 0,0:11:44.86,0:11:46.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayang sekali.
Dialogue: 0,0:11:47.15,0:11:50.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerajaan Clover masih punya orang itu!
Dialogue: 0,0:12:06.21,0:12:07.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asta?
Dialogue: 0,0:12:14.00,0:12:15.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, Liebe!
Dialogue: 0,0:12:15.76,0:12:17.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:12:17.01,0:12:18.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Unite!
Dialogue: 0,0:12:24.01,0:12:25.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, Liebe!
Dialogue: 0,0:12:25.42,0:12:26.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:12:26.39,0:12:27.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Unite!
Dialogue: 0,0:12:39.66,0:12:43.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia menghapus daya sihir sebesar itu?
Dialogue: 0,0:12:56.22,0:12:59.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Unite kami hanya bertahan lima menit.
Dialogue: 0,0:12:59.76,0:13:00.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami akan menumbangkannya
Dialogue: 0,0:13:00.93,0:13:02.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dalam sekejap!
Dialogue: 0,0:13:05.22,0:13:06.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kau yang dari Dewan Sihir!
Dialogue: 0,0:13:07.35,0:13:10.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat saja. Aku akan
Dialogue: 0,0:13:10.85,0:13:14.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}melindungi kerajaan ini bersama iblis!
Dialogue: 0,0:13:15.61,0:13:18.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu iblis!
Dialogue: 0,0:13:18.11,0:13:19.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iblis!
Dialogue: 0,0:13:21.92,0:13:26.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iblis datang bersama Dewa Iblis\Nuntuk menghancurkan kerajaan kita!
Dialogue: 0,0:13:26.62,0:13:27.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan.
Dialogue: 0,0:13:28.25,0:13:31.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu Asta! Asta, tahu!
Dialogue: 0,0:13:31.89,0:13:35.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asta sedang melindungi kerajaan ini!
Dialogue: 0,0:13:36.00,0:13:39.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sialan!\NBisa-bisanya rakyat jelata seperti dia...!
Dialogue: 0,0:13:39.63,0:13:44.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengerikan dan jelas bukan seleraku.
Dialogue: 0,0:13:44.02,0:13:46.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi mungkin ini juga semacam keindahan.
Dialogue: 0,0:13:46.89,0:13:49.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa sangka si cebol itu
Dialogue: 0,0:13:49.60,0:13:52.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa jadi sehebat ini?
Dialogue: 0,0:13:53.30,0:13:55.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pasti bisa!
Dialogue: 0,0:13:55.71,0:13:58.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan karena kau dirasuki iblis,
Dialogue: 0,0:13:58.77,0:14:02.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi karena kau lebih pantas disebut\Nkesatria sihir daripada siapa pun!
Dialogue: 0,0:14:02.50,0:14:06.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pasti bisa, Asta!
Dialogue: 0,0:14:47.66,0:14:50.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dewa Iblis itu adalah\Ngumpalan daya sihir raksasa.
Dialogue: 0,0:14:50.94,0:14:55.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia menangkis semua sihir,\Nmenyerang dengan cara primitif dan lugas,
Dialogue: 0,0:14:55.41,0:14:58.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu menghancurkan semuanya!
Dialogue: 0,0:14:58.70,0:15:02.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru karena itu, dia tak bisa bertahan\Ndari serangan anti-sihir!
Dialogue: 0,0:15:40.00,0:15:42.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mantap!
Dialogue: 0,0:15:42.05,0:15:45.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat! Gawat banget!\NKalau begini terus, Tuan Nacht...
Dialogue: 0,0:15:45.97,0:15:48.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Nacht akan...!
Dialogue: 0,0:15:49.41,0:15:52.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, ayo ke Kerajaan Spade!
Dialogue: 0,0:15:53.07,0:15:57.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, meski pakai Unite,\Nakan memakan waktu lama.
Dialogue: 0,0:15:57.35,0:16:02.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teleportasi jarak yang sangat jauh\Ntidak bisa dilakukan tanpa Tuan Nacht.
Dialogue: 0,0:16:02.10,0:16:06.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kondisinya sekarang tidak memungkinkan.
Dialogue: 0,0:16:06.98,0:16:08.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana ini?
Dialogue: 0,0:16:12.35,0:16:14.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Habisnya cepat sekali!
Dialogue: 0,0:16:14.05,0:16:16.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bodoh! Terbanglah pakai Katana Penebas Iblis!
Dialogue: 0,0:16:21.36,0:16:22.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh.
Dialogue: 0,0:16:22.61,0:16:25.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau jadi kuat gila-gilaan lagi.
Dialogue: 0,0:16:26.05,0:16:30.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi tega banget kau mau pergi sendirian.
Dialogue: 0,0:16:31.20,0:16:32.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:16:43.57,0:16:46.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lindungi warga!
Dialogue: 0,0:16:46.24,0:16:50.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi kehormatan Pasukan Pertahanan Sihir!
Dialogue: 0,0:17:02.29,0:17:04.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke sini!
Dialogue: 0,0:17:06.33,0:17:07.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita di mana?
Dialogue: 0,0:17:07.63,0:17:09.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Penciptaan Salju:
Dialogue: 0,0:17:09.63,0:17:11.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rumah Aman Manusia Salju.
Dialogue: 0,0:17:12.64,0:17:16.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah tidak apa-apa. Kalian aman di sini.
Dialogue: 0,0:17:16.14,0:17:17.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lewat sini.
Dialogue: 0,0:17:17.81,0:17:19.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak!
Dialogue: 0,0:17:22.98,0:17:26.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menyembunyikan warga\Ndari para iblis dengan sihir saljuku,
Dialogue: 0,0:17:26.85,0:17:29.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu mengeluarkan mereka dari sini\Ndengan Sihir Ruang Valtos.
Dialogue: 0,0:17:29.49,0:17:34.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fuhha! Kalau mereka menemukan kita,\Naku terpaksa bertarung!
Dialogue: 0,0:17:34.53,0:17:38.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan ketahuan, kumohon! Fuhha!
Dialogue: 0,0:17:42.33,0:17:43.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sialan.
Dialogue: 0,0:17:43.83,0:17:46.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka kuat, dan jumlahnya terlalu banyak!
Dialogue: 0,0:18:00.94,0:18:05.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski berasal dari kerajaan berbeda,\Nkeinginan kita untuk melindungi rakyat sama.
Dialogue: 0,0:18:05.73,0:18:07.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Roh Api!
Dialogue: 0,0:18:07.23,0:18:08.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh agung!
Dialogue: 0,0:18:21.25,0:18:23.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat! Kita ketahuan!
Dialogue: 0,0:18:36.30,0:18:37.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sialan!
Dialogue: 0,0:18:47.15,0:18:47.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ap...
Dialogue: 0,0:18:47.84,0:18:48.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fuhha?!
Dialogue: 0,0:18:49.20,0:18:52.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir dahsyat apa barusan?
Dialogue: 0,0:18:52.07,0:18:56.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir itu hanya menyerang para iblis\Ntanpa melukai manusia.
Dialogue: 0,0:18:56.86,0:18:58.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya kalian datang.
Dialogue: 0,0:18:59.54,0:19:03.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami tak akan membiarkan para iblis\Nberbuat seenaknya di dunia ini!
Dialogue: 0,0:19:07.96,0:19:12.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo! Selamat datang, aku Dryad!
Dialogue: 0,0:19:12.23,0:19:13.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah tahu kalian akan datang!
Dialogue: 0,0:19:13.97,0:19:16.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dibiarkan begini,\Niblis yang muncul akan makin banyak,
Dialogue: 0,0:19:16.66,0:19:19.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan Elysia juga akan kena masalah besar.
Dialogue: 0,0:19:19.85,0:19:21.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku akan membantu kalian!
Dialogue: 0,0:19:21.81,0:19:24.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia berbeda dari yang kubayangkan.
Dialogue: 0,0:19:24.35,0:19:27.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang akan kami ajarkan pada kalian\Nadalah Sihir Pemungkas.
Dialogue: 0,0:19:27.71,0:19:31.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir yang mewujudkan seluruh aspek\Nsihir seseorang.
Dialogue: 0,0:19:31.02,0:19:34.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itulah, sihir ini adalah puncak sihir\Nyang unik bagi tiap individu.
Dialogue: 0,0:19:35.42,0:19:40.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biasanya, hanya elf terpilih dengan\Ndaya sihir sangat besar yang bisa memakainya.
Dialogue: 0,0:19:40.02,0:19:42.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana yang dimiliki manusia\Nmemang tidak cukup.
Dialogue: 0,0:19:42.87,0:19:45.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, dengar baik-baik!
Dialogue: 0,0:19:45.08,0:19:49.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan menguasai Mana Method\Ndi Kerajaan Heart,
Dialogue: 0,0:19:49.56,0:19:52.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalian telah mempelajari Sihir Sejati
Dialogue: 0,0:19:52.12,0:19:54.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang bisa memanfaatkan mana alam\Ndalam jumlah besar!
Dialogue: 0,0:19:55.46,0:19:59.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Latihan enam bulan kami\Ndi Kerajaan Heart tidak sia-sia.
Dialogue: 0,0:19:59.59,0:20:03.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di Elysia, kami mempelajari asal-usul jiwa
Dialogue: 0,0:20:03.47,0:20:05.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan menyelaraskan tubuh kami dengan mana.
Dialogue: 0,0:20:05.98,0:20:08.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan kekuatan Sihir Sejati\Nyang melampaui batas manusia,
Dialogue: 0,0:20:08.85,0:20:11.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami menguasai Sihir Pemungkas!
Dialogue: 0,0:20:11.36,0:20:12.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Air.
Dialogue: 0,0:20:12.61,0:20:13.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Petir.
Dialogue: 0,0:20:13.86,0:20:14.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Tanah.
Dialogue: 0,0:20:14.78,0:20:15.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Kapas.
Dialogue: 0,0:20:15.86,0:20:17.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Tumbuhan.
Dialogue: 0,0:20:17.36,0:20:18.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Angin.
Dialogue: 0,0:20:18.61,0:20:19.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Api...
Dialogue: 0,0:20:19.87,0:20:21.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejati!
Dialogue: 0,0:20:37.13,0:20:39.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat!
Dialogue: 0,0:20:39.31,0:20:43.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka memakai lingkaran sihir itu\Nsupaya serangannya tidak mengenai kawan!
Dialogue: 0,0:20:43.76,0:20:47.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang terjadi, ya?\NBagaimana cara kerjanya?!
Dialogue: 0,0:20:47.02,0:20:50.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga nanti aku boleh menelitinya!
Dialogue: 0,0:20:50.52,0:20:52.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu saja, Vanica!
Dialogue: 0,0:20:57.81,0:21:02.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iblis-iblis tingkat rendah tak berguna itu\Nberebut keluar duluan.
Dialogue: 0,0:21:02.26,0:21:05.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang mereka takutkan, ya?
Dialogue: 0,0:21:07.65,0:21:11.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo main lempar tangkap!\NKau jadi bolanya!
Dialogue: 0,0:21:11.04,0:21:12.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka...
Dialogue: 0,0:21:12.73,0:21:13.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:21:13.67,0:21:15.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka iblis tingkat menengah.
Dialogue: 0,0:21:15.25,0:21:20.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Main lempar tangkap sambil menyerap\Nmana lezat di luar memang paling asyik!
Dialogue: 0,0:21:20.55,0:21:25.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi main dengan manusia pasti lebih seru.
Dialogue: 0,0:21:27.52,0:21:33.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, manusia!\NPerdengarkan jeritan merdu kalian.
Dialogue: 0,0:21:38.64,0:21:41.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya aku dapat teman main.
Dialogue: 0,0:21:41.95,0:21:45.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita lihat sehebat apa\NSihir Pemungkasku.
Dialogue: 0,0:21:46.49,0:21:49.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kucoba pada mereka!
Dialogue: 0,0:22:01.76,0:22:05.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa orang ini?\NSejak kapan dia...
Dialogue: 0,0:22:05.01,0:22:07.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Pemungkas Petir:
Dialogue: 0,0:22:07.87,0:22:10.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maniak Tempur Petir!
Dialogue: 0,0:22:13.63,0:22:19.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya ampun, kalau kalian tidak bisa melihatku,\Nini bahkan tidak bisa disebut permainan.
