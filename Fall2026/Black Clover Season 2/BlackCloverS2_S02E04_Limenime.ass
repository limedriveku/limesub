Dialogue: 0,0:23:44.84,0:23:51.88,sign,,0000,0000,0000,,EPISODE 174\NHARI PENEBUSAN
Dialogue: 0,0:00:02.80,0:00:05.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada akhirnya, dia pergi duluan.
Dialogue: 0,0:00:05.86,0:00:07.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar, deh.
Dialogue: 0,0:00:07.61,0:00:11.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia selalu jadi orang yang paling buru-buru.
Dialogue: 0,0:00:12.80,0:00:14.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Prioritas utama kita sekarang adalah
Dialogue: 0,0:00:14.78,0:00:16.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mengalahkan Dark Triad
Dialogue: 0,0:00:16.01,0:00:18.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan menutup gerbang dunia bawah
Dialogue: 0,0:00:18.31,0:00:21.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}agar situasi tidak makin memburuk.
Dialogue: 0,0:00:21.46,0:00:23.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk itu,
Dialogue: 0,0:00:23.05,0:00:26.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita perlu memisahkan Dante\Ndan iblis tingkat tertinggi.
Dialogue: 0,0:00:27.36,0:00:31.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelan-pelan... Nikmati dengan perlahan.
Dialogue: 0,0:00:31.53,0:00:32.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, kau benar.
Dialogue: 0,0:00:32.97,0:00:34.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siksa.
Dialogue: 0,0:00:34.50,0:00:36.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permainkan.
Dialogue: 0,0:00:36.01,0:00:37.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bunuh.
Dialogue: 0,0:00:37.83,0:00:39.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hancurkan.
Dialogue: 0,0:00:39.51,0:00:41.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau benar.
Dialogue: 0,0:00:41.10,0:00:42.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, kau benar.
Dialogue: 0,0:00:46.50,0:00:48.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini! Ini dia!
Dialogue: 0,0:00:48.70,0:00:50.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luar biasa!
Dialogue: 0,0:00:50.23,0:00:53.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inilah dunia yang kudambakan!
Dialogue: 0,0:00:53.95,0:00:55.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei.
Dialogue: 0,0:00:55.03,0:00:57.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lawanmu itu aku!
Dialogue: 0,0:00:58.46,0:01:00.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kucabik-cabik tubuhmu!
Dialogue: 0,0:01:02.00,0:01:03.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menarik!
Dialogue: 0,0:01:03.92,0:01:06.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jack akan kesulitan\Nmenghadapinya seorang diri,
Dialogue: 0,0:01:06.23,0:01:08.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku harus bertaruh pada kemampuannya.
Dialogue: 0,0:01:08.63,0:01:11.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Walgner, kau sudah tuntaskan misimu?
Dialogue: 0,0:01:12.97,0:01:14.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus.
Dialogue: 0,0:01:15.76,0:01:17.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Unite.
Dialogue: 0,0:01:21.06,0:01:23.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mode: Gallus.
Dialogue: 0,0:01:24.10,0:01:25.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Spesialis:
Dialogue: 0,0:01:25.48,0:01:27.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kokokan!
Dialogue: 0,0:01:47.71,0:01:50.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sempat menghentikan gerakan kita.
Dialogue: 0,0:01:50.85,0:01:52.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia memindahkan kita.
Dialogue: 0,0:01:52.23,0:01:53.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seru.
Dialogue: 0,0:01:53.84,0:01:56.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akulah lawan kalian, para iblis.
Dialogue: 0,0:01:58.80,0:01:59.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana Zone:
Dialogue: 0,0:02:02.26,0:02:04.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Medan Berburu Kegelapan.
Dialogue: 0,0:02:04.72,0:02:09.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, mari kita mulai\Nkejar-kejaran bagai di neraka ini.
Dialogue: 0,0:02:10.53,0:02:12.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak kelihatan.
Dialogue: 0,0:02:12.23,0:02:14.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, tidak kelihatan.
Dialogue: 0,0:02:14.03,0:02:16.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo main dengan kekuatan ini.
Dialogue: 0,0:02:16.32,0:02:18.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, ayo main.
Dialogue: 0,0:02:18.03,0:02:21.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo lomba siapa yang bisa bunuh lebih dulu.
Dialogue: 0,0:02:21.15,0:02:23.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan kerahkan seluruh kekuatanmu, ya.
Dialogue: 0,0:02:23.41,0:02:24.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau benar.
Dialogue: 0,0:02:24.70,0:02:30.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perlahan-lahan.
Dialogue: 0,0:02:48.60,0:02:50.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mode: Equus.
Dialogue: 0,0:02:55.10,0:02:55.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga.
Dialogue: 0,0:02:56.11,0:02:58.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketemu.
Dialogue: 0,0:02:58.11,0:03:00.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seranganku tidak mempan pada mereka.
Dialogue: 0,0:03:00.86,0:03:02.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daya sihir mereka juga tak terbatas.
Dialogue: 0,0:03:03.71,0:03:06.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa melindungi diri dengan Equus.
Dialogue: 0,0:03:06.12,0:03:08.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti, yang bisa kulakukan hanyalah
Dialogue: 0,0:03:10.62,0:03:13.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}terus menghindar sampai aku mati
Dialogue: 0,0:03:13.54,0:03:15.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan menahan mereka di sini.
Dialogue: 0,0:03:15.67,0:03:17.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat sekali.
Dialogue: 0,0:03:17.48,0:03:18.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong...
Dialogue: 0,0:03:18.94,0:03:20.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu...
Dialogue: 0,0:03:20.57,0:03:21.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:03:21.56,0:03:24.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa dia tidak kabur, ya?
Dialogue: 0,0:03:27.22,0:03:29.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena aku hidup untuk tidak memaafkan
Dialogue: 0,0:03:29.35,0:03:31.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalian, para iblis yang semena-mena.
Dialogue: 0,0:03:31.48,0:03:34.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlebih, aku sama sekali tidak keberatan
Dialogue: 0,0:03:34.98,0:03:37.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk mati di sini.
Dialogue: 0,0:03:41.35,0:03:45.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keluarga bangsawan Faust yang ternama\Nmemiliki anak kembar.
Dialogue: 0,0:03:45.74,0:03:48.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sang adik adalah perwujudan kebajikan,
Dialogue: 0,0:03:48.71,0:03:50.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}disukai oleh banyak orang,
Dialogue: 0,0:03:50.73,0:03:53.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bergabung dengan Kesatria Sihir,
Dialogue: 0,0:03:53.15,0:03:55.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan menyelamatkan orang-orang\Nseolah itu hal yang wajar.
Dialogue: 0,0:03:56.26,0:03:59.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sang kakak adalah anak yang badung,
Dialogue: 0,0:03:59.05,0:04:01.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kebanyakan orang mengernyit\Nmelihat perangainya,
Dialogue: 0,0:04:01.86,0:04:05.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan menggunakan sihir\Nhanya untuk kepentingan pribadi.
Dialogue: 0,0:04:07.36,0:04:10.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak, kau tak ingin bergabung\Ndengan Kesatria Sihir?
Dialogue: 0,0:04:11.25,0:04:14.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal sihirmu\Nbisa menyelamatkan banyak orang.
Dialogue: 0,0:04:14.83,0:04:15.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ogah.
Dialogue: 0,0:04:16.13,0:04:19.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa serunya melakukan itu, sih?
Dialogue: 0,0:04:19.29,0:04:20.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Morgen!
Dialogue: 0,0:04:23.23,0:04:24.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada misi.
Dialogue: 0,0:04:25.24,0:04:27.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengerti, Yami.
Dialogue: 0,0:04:27.45,0:04:29.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang anehnya bertambah, deh.
Dialogue: 0,0:04:29.96,0:04:33.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa-bisanya orang sepertimu\Nmasuk Kesatria Sihir.
Dialogue: 0,0:04:33.94,0:04:36.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tak cocok pakai jubah itu.
Dialogue: 0,0:04:36.73,0:04:38.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo? Rupanya kau ada di sini.
Dialogue: 0,0:04:38.60,0:04:41.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau masih saja bertingkah\Nseperti anak nakal, ya?
Dialogue: 0,0:04:41.15,0:04:42.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak malu?
Dialogue: 0,0:04:42.31,0:04:44.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau juga sama saja.
Dialogue: 0,0:04:45.60,0:04:47.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian berdua akrab sekali, ya.
Dialogue: 0,0:04:47.72,0:04:49.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau lihat apa, sih, Morgen?
Dialogue: 0,0:04:49.65,0:04:51.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan terlalu nakal
Dialogue: 0,0:04:51.58,0:04:54.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sampai kami harus menangkapmu, ya.
Dialogue: 0,0:04:54.64,0:04:56.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nacht.
Dialogue: 0,0:04:56.43,0:04:59.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bercermin dulu, sana. Pria dungu.
Dialogue: 0,0:05:01.40,0:05:05.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya ingin melakukan hal\Nyang kuanggap menyenangkan.
Dialogue: 0,0:05:05.99,0:05:09.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepanjang ingatanku,\Naku selalu berbuat nakal.
Dialogue: 0,0:05:09.66,0:05:13.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Adikku berbanding terbalik denganku.
Dialogue: 0,0:05:13.16,0:05:16.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dicintai semua orang,\Ndan mencintai semua orang.
Dialogue: 0,0:05:16.67,0:05:19.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mampu mengorbankan diri sendiri\Ndemi orang lain.
Dialogue: 0,0:05:19.61,0:05:23.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kepribadian dan elemen sihirnya\Nsama-sama "cahaya".
Dialogue: 0,0:05:25.26,0:05:27.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat mendapatkan Grimoire,
Dialogue: 0,0:05:28.00,0:05:31.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku mendengar rumor orang asing\Nyang menggunakan sihir mengerikan
Dialogue: 0,0:05:31.03,0:05:34.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan pergi menemuinya karena penasaran.
Dialogue: 0,0:05:38.15,0:05:39.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa kau, bocah tengik?
Dialogue: 0,0:05:40.96,0:05:42.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ngajak berkelahi?
Dialogue: 0,0:05:43.43,0:05:46.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pria itu benar-benar liar.
Dialogue: 0,0:05:46.26,0:05:51.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin kami akrab\Nkarena warna sihir kami mirip.
Dialogue: 0,0:05:51.23,0:05:55.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami sering membuat kekacauan\Nyang tidak sampai membuat kami
Dialogue: 0,0:05:55.82,0:05:57.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ditangkap oleh Kesatria Sihir.
Dialogue: 0,0:05:58.10,0:05:58.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enam bulan kemudian,
Dialogue: 0,0:05:59.42,0:06:02.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}entah kebetulan apa yang terjadi,\Ntapi dia dan adikku
Dialogue: 0,0:06:02.25,0:06:06.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bergabung dengan Pasukan Rusa Abu-abu\Nmenjadi Kesatria Sihir.
Dialogue: 0,0:06:07.26,0:06:12.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kupikir orang seperti Yami\Ntidak mungkin betah menjadi Kesatria Sihir,
Dialogue: 0,0:06:12.10,0:06:15.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi adikku yang berteman dengan semua orang\Nkini akrab dengan Yami,
Dialogue: 0,0:06:16.33,0:06:20.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan mungkin berkat dia pula\NYami bisa berbaur dengan anggota lain.
Dialogue: 0,0:06:22.65,0:06:25.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak lebih berbakat\Ndalam sihir daripada aku.
Dialogue: 0,0:06:25.98,0:06:27.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pun jengkel
Dialogue: 0,0:06:27.65,0:06:31.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena dia selalu mengatakan itu saat\Nmembujukku bergabung ke Kesatria Sihir.
Dialogue: 0,0:06:33.36,0:06:36.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat berusia 18 tahun,\Naku dipanggil orang tuaku.
Dialogue: 0,0:06:37.17,0:06:40.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bilang\Nkalian baru mau memarahiku sekarang.
Dialogue: 0,0:06:40.25,0:06:42.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Abaikan saja putra sulung sepertiku,
Dialogue: 0,0:06:42.40,0:06:44.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}biar Morgen saja yang mewarisi...
Dialogue: 0,0:06:44.21,0:06:44.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:06:45.52,0:06:48.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kaulah yang akan mewarisi keluarga Faust.
Dialogue: 0,0:06:48.22,0:06:49.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nacht.
Dialogue: 0,0:06:49.80,0:06:50.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:06:50.80,0:06:52.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Bayang:
Dialogue: 0,0:06:53.02,0:06:55.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taman Pengundang Kegelapan.
Dialogue: 0,0:07:01.90,0:07:03.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di mana ini?
Dialogue: 0,0:07:03.30,0:07:05.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari generasi ke generasi,
Dialogue: 0,0:07:05.42,0:07:08.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}keluarga Faust mengabdikan diri\Nuntuk meneliti iblis.
Dialogue: 0,0:07:08.81,0:07:12.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau telah mewarisi sihir dan jiwa itu.
Dialogue: 0,0:07:13.25,0:07:15.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tubuhku gemetar di hadapan godaan misterius
Dialogue: 0,0:07:15.65,0:07:17.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang mengerikan, tapi juga indah.
Dialogue: 0,0:07:17.87,0:07:19.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jantungku berdegup kencang,
Dialogue: 0,0:07:19.54,0:07:22.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan aku merasakan gairah yang begitu besar.
Dialogue: 0,0:07:23.60,0:07:26.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Niat jahat dalam diriku bersuka cita.
Dialogue: 0,0:07:27.13,0:07:30.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam keluarga Faust, akulah yang normal,
Dialogue: 0,0:07:30.68,0:07:33.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan Morgen-lah yang tidak normal.
Dialogue: 0,0:07:37.60,0:07:40.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam Kesatria Sihir, Morgen dan Yami
Dialogue: 0,0:07:40.21,0:07:43.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mencetak prestasi\Nsebagai duo cahaya dan kegelapan.
Dialogue: 0,0:07:43.44,0:07:45.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sementara aku mempelajari iblis,
Dialogue: 0,0:07:45.75,0:07:47.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan menunjukkan bakat di bidang tersebut.
Dialogue: 0,0:07:48.70,0:07:50.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak menyangka kau bisa
Dialogue: 0,0:07:50.31,0:07:52.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menjalin kontrak dengan empat iblis
Dialogue: 0,0:07:52.55,0:07:55.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan menguasai kekuatan mereka\Nhingga ke tahap ini.
Dialogue: 0,0:07:55.66,0:07:59.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sangat berbakat, Nacht.
Dialogue: 0,0:08:00.33,0:08:05.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mungkin bisa menjalin kontrak\Ndengan iblis ini juga.
Dialogue: 0,0:08:05.67,0:08:07.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penguasa dunia bawah.
Dialogue: 0,0:08:07.75,0:08:11.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iblis gravitasi, waktu, dan ruang.
Dialogue: 0,0:08:11.05,0:08:14.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iblis ini adalah pengikut salah satunya.
Dialogue: 0,0:08:14.68,0:08:18.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iblis tingkat tertinggi, Lucifugus.
Dialogue: 0,0:08:18.10,0:08:20.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iblis tingkat tertinggi.
Dialogue: 0,0:08:20.85,0:08:23.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh? Kedengarannya menarik.
Dialogue: 0,0:08:23.73,0:08:25.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan, Kak!
Dialogue: 0,0:08:25.82,0:08:27.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Morgen?!
Dialogue: 0,0:08:27.48,0:08:30.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayahanda, Ibunda,\Nsihir terlarang itu melanggar hukum.
Dialogue: 0,0:08:30.65,0:08:32.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai Kesatria Sihir,\Naku tidak akan tinggal diam.
Dialogue: 0,0:08:32.74,0:08:36.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlebih, itu berbahaya.\NJangan diteruskan...!
Dialogue: 0,0:08:36.12,0:08:38.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, dong, kalau memang bahaya.
Dialogue: 0,0:08:39.58,0:08:42.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iblis tingkat tertinggi, ya... Menarik.
Dialogue: 0,0:08:42.58,0:08:45.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hidup itu baru seru\Nkalau ada tantangan sebesar ini.
Dialogue: 0,0:08:45.88,0:08:47.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak...
Dialogue: 0,0:08:47.63,0:08:51.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Morgen, kita berbeda.
Dialogue: 0,0:08:53.26,0:08:57.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang, di sini.\NAku akan melampaui batasku!
Dialogue: 0,0:09:02.73,0:09:03.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Summon.
Dialogue: 0,0:09:13.49,0:09:17.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya ritual ini\Nmampu menahan kekuatannya.
Dialogue: 0,0:09:17.49,0:09:19.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daya sihir macam apa ini?!
Dialogue: 0,0:09:28.66,0:09:32.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ia menyerang manusia\Nselain yang memanggilnya?
Dialogue: 0,0:09:32.83,0:09:34.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tubuhku tak bisa digerakkan...
Dialogue: 0,0:09:34.51,0:09:36.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ia adalah
Dialogue: 0,0:09:37.40,0:09:40.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hal yang tidak seharusnya kami usik!
Dialogue: 0,0:09:45.18,0:09:46.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Morgen?
Dialogue: 0,0:09:46.60,0:09:49.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia berniat menghancurkan relik\Nyang berhubungan dengan iblis itu
Dialogue: 0,0:09:49.86,0:09:52.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk membatalkan ritual ini, ya?
Dialogue: 0,0:09:53.61,0:09:55.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan.
Dialogue: 0,0:09:55.80,0:09:59.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada yang tahu\Nrisiko intervensi orang ketiga...!
Dialogue: 0,0:10:13.36,0:10:15.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Morgen? Morgen!
Dialogue: 0,0:10:19.01,0:10:23.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini hukumanku karena tidak melaporkan
Dialogue: 0,0:10:23.40,0:10:26.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}anggota keluarga\Nyang menggunakan sihir terlarang
Dialogue: 0,0:10:26.73,0:10:28.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kepada Kesatria Sihir...
Dialogue: 0,0:10:28.80,0:10:30.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar bodoh!
Dialogue: 0,0:10:30.26,0:10:32.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau melakukan...?!
Dialogue: 0,0:10:32.73,0:10:35.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mimpiku...
Dialogue: 0,0:10:47.37,0:10:49.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berdiri di sampingmu,
Dialogue: 0,0:10:49.66,0:10:52.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bersama-sama melindungi negara ini
Dialogue: 0,0:10:52.48,0:10:58.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebagai Kesatria Sihir Bayangan dan Cahaya.
Dialogue: 0,0:11:01.26,0:11:03.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Morgen...
Dialogue: 0,0:11:04.56,0:11:07.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Morgen!
Dialogue: 0,0:11:07.95,0:11:10.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Contoh hidup dari kata kebajikan.
Dialogue: 0,0:11:10.18,0:11:13.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu menyilaukan\Nhingga tak bisa kulihat secara langsung.
Dialogue: 0,0:11:13.56,0:11:15.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kau orang yang seperti itu...
Dialogue: 0,0:11:16.18,0:11:19.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya aku sangat sayang padamu.
Dialogue: 0,0:11:22.99,0:11:25.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya, aku ingin kau terus bersinar\Ndengan terang.
Dialogue: 0,0:11:25.43,0:11:30.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika aku ada di sampingmu,\Naku takut cahayamu akan ternodai.
Dialogue: 0,0:11:31.29,0:11:33.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akulah yang seharusnya mati!
Dialogue: 0,0:11:33.56,0:11:37.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon! Selamatkan adikku!
Dialogue: 0,0:11:37.03,0:11:39.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Adikku tidak salah apa-apa!
Dialogue: 0,0:11:39.56,0:11:42.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, Dewa. Aku memohon kepadamu!
Dialogue: 0,0:11:42.18,0:11:45.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan mengharapkan yang tidak-tidak.
Dialogue: 0,0:11:45.70,0:11:48.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama ini kau sudah berbuat seenaknya,
Dialogue: 0,0:11:48.26,0:11:51.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi langsung berdoa pada Dewa\Nsaat kena masalah?
Dialogue: 0,0:11:51.44,0:11:54.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak saja, dasar pria bodoh.
Dialogue: 0,0:11:54.44,0:11:56.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya siapa yang akan menolong?
Dialogue: 0,0:11:56.80,0:11:58.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai aku mati nanti,
Dialogue: 0,0:11:58.94,0:12:01.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tidak akan pernah\Nmemaafkan diriku sendiri.
Dialogue: 0,0:12:17.52,0:12:21.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suatu hari nanti,\Naku akan membentuk pasukanku sendiri.
Dialogue: 0,0:12:21.47,0:12:23.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang sepertiku menjadi komandan...
Dialogue: 0,0:12:23.98,0:12:26.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kedengaran seperti lawakan, bukan?
Dialogue: 0,0:12:26.68,0:12:28.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika hal itu jadi kenyataan...
Dialogue: 0,0:12:31.43,0:12:35.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kaulah wakil komandannya.\NAyo jadi bahan tertawaan bersama.
Dialogue: 0,0:12:38.69,0:12:41.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak peduli seberapa banyak\Naku menebus dosaku,
Dialogue: 0,0:12:41.55,0:12:43.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tetap tidak bisa\Nmemaafkan diriku sendiri.
Dialogue: 0,0:12:44.00,0:12:47.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak sudi menerima pujian\Natau bahkan sorotan cahaya.
Dialogue: 0,0:12:48.56,0:12:52.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak bisa menjadi Morgen,\Ndan tak boleh menjadi Morgen.
Dialogue: 0,0:12:53.25,0:12:54.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai aku mati nanti,
Dialogue: 0,0:12:54.85,0:12:58.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan menghancurkan kejahatan\Ndengan kejahatan dari balik bayangan.
Dialogue: 0,0:13:07.30,0:13:10.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak berpikir\Ningin membenarkan kejahatan kalian.
Dialogue: 0,0:13:11.72,0:13:14.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebelum kalian melukai orang-orang baik,
Dialogue: 0,0:13:15.02,0:13:16.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan kubunuh kalian!
Dialogue: 0,0:13:16.73,0:13:21.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sialan.\NKupikir aku tidak akan mengatakan ini lagi.
Dialogue: 0,0:13:23.20,0:13:27.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang, di sini.\NAku akan melampaui batasku!
Dialogue: 0,0:13:31.96,0:13:35.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua iblis yang menjalin kontrak denganku\Nadalah iblis tingkat menengah.
Dialogue: 0,0:13:36.50,0:13:40.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka bahkan tidak bisa\Nmenyentuh iblis tingkat tertinggi.
Dialogue: 0,0:13:40.80,0:13:44.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku paham betul batasku.
Dialogue: 0,0:13:44.03,0:13:44.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itulah...!
Dialogue: 0,0:13:45.70,0:13:47.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Temani aku bertaruh.
Dialogue: 0,0:13:47.59,0:13:50.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Plumede, Walgner.
Dialogue: 0,0:13:50.35,0:13:53.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik. Kau telah memperlihatkan kami
Dialogue: 0,0:13:53.31,0:13:56.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hal-hal yang tidak ada di dunia bawah.
Dialogue: 0,0:13:56.35,0:13:58.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nacht, kau pasti bisa.
Dialogue: 0,0:14:01.77,0:14:04.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang, di sini,
Dialogue: 0,0:14:05.94,0:14:07.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan melampaui
Dialogue: 0,0:14:07.70,0:14:09.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}batasku!
Dialogue: 0,0:14:11.34,0:14:12.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Unite.
Dialogue: 0,0:14:23.13,0:14:26.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mode: Gallus x Felis.
Dialogue: 0,0:14:26.92,0:14:27.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh?
Dialogue: 0,0:14:27.81,0:14:30.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daya sihirnya meningkat?
Dialogue: 0,0:14:30.64,0:14:33.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Walau hanya sebentar saja,
Dialogue: 0,0:14:33.64,0:14:37.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku telah meningkatkannya hingga setara\Ndengan iblis tingkat tertinggi!
Dialogue: 0,0:14:46.32,0:14:49.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Bayang: Monumen Penebusan.
Dialogue: 0,0:14:50.45,0:14:53.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan mengorbankan diriku sendiri,
Dialogue: 0,0:14:53.71,0:14:56.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan mengunci kalian dalam dunia bayangan
Dialogue: 0,0:14:56.05,0:14:58.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang tanpa cahaya,\Ntanpa kehidupan, dan tanpa kematian!
Dialogue: 0,0:14:59.21,0:15:03.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari terus bermain kejar-kejaran\Nbagai di neraka bersamaku untuk selamanya.
Dialogue: 0,0:15:39.66,0:15:40.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin!
Dialogue: 0,0:15:41.44,0:15:44.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka menghancurkan sihirku
Dialogue: 0,0:15:44.67,0:15:46.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}seolah ia tak pernah ada.
Dialogue: 0,0:15:47.42,0:15:49.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir mereka...
Dialogue: 0,0:15:50.42,0:15:52.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membakar segalanya,
Dialogue: 0,0:15:54.00,0:15:55.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Api Iblis.
Dialogue: 0,0:15:55.98,0:15:58.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan membekukan segalanya.
Dialogue: 0,0:15:58.15,0:16:00.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Es Iblis.
Dialogue: 0,0:16:00.48,0:16:04.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bayangan, cahaya,\Nbahkan sesuatu yang tak kasatmata...
Dialogue: 0,0:16:30.57,0:16:33.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, bagus...
Dialogue: 0,0:16:37.63,0:16:39.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hingga detik-detik terakhir.
Dialogue: 0,0:16:40.01,0:16:41.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peras semuanya.
Dialogue: 0,0:16:41.52,0:16:43.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peras hingga habis.
Dialogue: 0,0:16:43.02,0:16:44.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hingga kosong melompong.
Dialogue: 0,0:16:44.39,0:16:46.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hal yang keluar dari manusia!
Dialogue: 0,0:16:46.06,0:16:47.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kepedihan!
Dialogue: 0,0:16:47.60,0:16:49.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keputusasaan!
Dialogue: 0,0:16:49.15,0:16:50.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jeritan itu!
Dialogue: 0,0:16:51.40,0:16:53.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak awal, mereka berdua hanya
Dialogue: 0,0:16:53.86,0:16:55.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Aku sudah tidak\N- main-main saja.
Dialogue: 0,0:16:56.65,0:16:58.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- sanggup lagi.\N- Ya.
Dialogue: 0,0:16:58.28,0:16:59.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa.
Dialogue: 0,0:16:59.95,0:17:03.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kubunuh, ya.\N- Ya. Kita bunuh.
Dialogue: 0,0:17:05.46,0:17:09.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk terakhir kalinya,
Dialogue: 0,0:17:09.16,0:17:11.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}perdengarkan jeritan terbaikmu...
Dialogue: 0,0:17:12.64,0:17:14.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada manusia
Dialogue: 0,0:17:15.20,0:17:17.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang bisa menang
Dialogue: 0,0:17:18.83,0:17:19.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}melawan iblis tingkat tertinggi.
Dialogue: 0,0:17:32.40,0:17:33.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ada...
Dialogue: 0,0:17:39.58,0:17:41.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo? Terpotong.
Dialogue: 0,0:17:41.96,0:17:44.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kalian.
Dialogue: 0,0:17:44.00,0:17:47.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kalian perbuat\Npada wakil komandan kami?!
Dialogue: 0,0:17:47.83,0:17:50.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma anti-sihir.
Dialogue: 0,0:17:50.13,0:17:51.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Nacht!
Dialogue: 0,0:17:52.00,0:17:57.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayolah! Kalau kau sampai mati,\Nkami yang akan kena akibatnya!
Dialogue: 0,0:17:57.23,0:17:58.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gimodelo.
Dialogue: 0,0:18:00.15,0:18:04.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau terlambat,\Ntapi sekarang semua kartu sudah terkumpul.
Dialogue: 0,0:18:04.45,0:18:06.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi abaikan saja aku.
Dialogue: 0,0:18:06.77,0:18:09.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat pergi dan kalahkan Dark Triad.
Dialogue: 0,0:18:11.82,0:18:14.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana bisa seperti itu.
Dialogue: 0,0:18:14.45,0:18:17.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kaulah yang membantuku bertambah kuat.
Dialogue: 0,0:18:17.86,0:18:19.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetaplah hidup
Dialogue: 0,0:18:19.66,0:18:21.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan lihat kekuatan ini.
Dialogue: 0,0:18:23.46,0:18:25.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku
Dialogue: 0,0:18:25.03,0:18:29.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mengharapkan fajar yang baru datang?
Dialogue: 0,0:18:29.83,0:18:31.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski sama-sama orang baik,
Dialogue: 0,0:18:31.91,0:18:34.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalian sama sekali tidak mirip.
Dialogue: 0,0:18:34.88,0:18:37.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama ratusan tahun di dunia bawah...
Dialogue: 0,0:18:37.92,0:18:41.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiada yang semenyenangkan ini!
Dialogue: 0,0:18:42.93,0:18:46.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak kusangka bisa bertemu kalian di sini.
Dialogue: 0,0:18:46.10,0:18:48.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iblis tingkat tertinggi,
Dialogue: 0,0:18:48.46,0:18:50.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lilith dan Naamah.
Dialogue: 0,0:18:50.85,0:18:52.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo hibur kami
Dialogue: 0,0:18:52.40,0:18:54.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lebih dari sekarang!
Dialogue: 0,0:19:25.53,0:19:27.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kena, tidak, ya?
Dialogue: 0,0:19:27.18,0:19:29.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayunkan pedangmu, ayunkan.
Dialogue: 0,0:19:29.59,0:19:31.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kena, tidak, ya?
Dialogue: 0,0:19:31.56,0:19:33.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kena, tidak, ya?
Dialogue: 0,0:19:41.99,0:19:44.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa yang lebih dulu...
Dialogue: 0,0:19:44.03,0:19:45.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengenainya?
Dialogue: 0,0:19:45.53,0:19:47.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membunuhnya?
Dialogue: 0,0:19:48.91,0:19:50.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang ketiga,
Dialogue: 0,0:19:51.21,0:19:52.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang Penghancur Iblis.
Dialogue: 0,0:20:20.50,0:20:24.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayang sekali.\NNaamah yang pertama kali kalah.
Dialogue: 0,0:20:26.64,0:20:30.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi sekarang kita\Nbenar-benar bisa main berdua.
Dialogue: 0,0:20:38.98,0:20:40.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan itu...?
Dialogue: 0,0:20:48.26,0:20:50.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kaulah buruan terbaik.
Dialogue: 0,0:20:50.95,0:20:54.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak sabar ingin mendengar jeritanmu.
Dialogue: 0,0:20:54.27,0:20:57.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial. Kekuatannya bukan sekadar\Nsatu tambah satu.
Dialogue: 0,0:20:57.65,0:21:01.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daya sihirnya terlalu besar\Nsampai aku pusing sendiri.
Dialogue: 0,0:21:02.90,0:21:05.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayaknya, sih, keren banget!
Dialogue: 0,0:21:05.35,0:21:08.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku tidak bisa merasakan daya sihir,\Njadi tidak paham!
Dialogue: 0,0:21:21.59,0:21:26.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.\NBiar kuperlihatkan supaya kau mudah paham.
Dialogue: 0,0:21:29.70,0:21:31.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sialan!
Dialogue: 0,0:21:34.85,0:21:36.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski kau baik-baik saja,
Dialogue: 0,0:21:36.52,0:21:39.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}orang-orang selain kau akan mati.
Dialogue: 0,0:21:39.49,0:21:43.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hal seperti itu pasti menyakitkan, bukan?
Dialogue: 0,0:21:43.82,0:21:44.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah...
Dialogue: 0,0:21:48.05,0:21:49.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berdukalah.
Dialogue: 0,0:21:52.08,0:21:54.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau hanya bertambah besar.
Dialogue: 0,0:21:54.38,0:21:57.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga bertambah besar!
Dialogue: 0,0:22:00.46,0:22:03.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang pertama,
Dialogue: 0,0:22:03.46,0:22:06.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang Pembasmi Iblis!
Dialogue: 0,0:22:10.06,0:22:11.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga, lihat itu.
Dialogue: 0,0:22:11.89,0:22:15.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau diperbesar sampai sebesar apa, sih?
Dialogue: 0,0:22:15.23,0:22:16.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bocah sialan itu.
