Dialogue: 0,0:01:48.51,0:01:53.90,sign,,0000,0000,0000,,EPISODE 177: MELAMPAUI KETEGUHAN HATI
Dialogue: 0,0:00:15.13,0:00:18.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibunda!
Dialogue: 0,0:01:57.73,0:02:00.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat Ranah Suci-mu terlepas,
Dialogue: 0,0:02:00.49,0:02:03.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau tidak akan bisa mengalahkanku lagi.
Dialogue: 0,0:02:03.36,0:02:06.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski masih bisa menyerang,
Dialogue: 0,0:02:06.80,0:02:09.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}serangan itu tak akan menggapaiku lagi.
Dialogue: 0,0:02:10.00,0:02:14.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang, seluruh wilayah ini telah\Ndiselimuti "Pembusukan Dunia".
Dialogue: 0,0:02:15.30,0:02:17.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiada seorang pun yang akan datang menolong,
Dialogue: 0,0:02:17.72,0:02:19.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalaupun ada yang datang,\Nmereka tak akan berdaya.
Dialogue: 0,0:02:20.90,0:02:23.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu yang tepat untuk menyerah, bukan?
Dialogue: 0,0:02:23.59,0:02:26.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi itu menyenangkan, manusia.
Dialogue: 0,0:02:32.46,0:02:33.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadjah?!
Dialogue: 0,0:02:36.62,0:02:37.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadjah.
Dialogue: 0,0:02:40.97,0:02:42.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini tidak akan sakit.
Dialogue: 0,0:02:43.00,0:02:45.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon maafkan aku, Nona Lolopechka.
Dialogue: 0,0:02:46.37,0:02:48.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Petir: Pulsaranta.
Dialogue: 0,0:02:54.79,0:02:56.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa menghentikan gerakannya\Nselama beberapa detik.
Dialogue: 0,0:03:01.62,0:03:03.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak hari itu,
Dialogue: 0,0:03:03.80,0:03:06.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku memutuskan untuk menggantikan Ratu
Dialogue: 0,0:03:06.51,0:03:08.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}memusnahkan musuh dan melindungi kerajaan.
Dialogue: 0,0:03:09.29,0:03:10.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, enam bulan yang lalu...
Dialogue: 0,0:03:11.70,0:03:14.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku gagal menghentikan\Nserangan Megicula dan Vanica,
Dialogue: 0,0:03:14.81,0:03:16.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan membuatmu terkena kutukan.
Dialogue: 0,0:03:17.78,0:03:19.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku.
Dialogue: 0,0:03:19.52,0:03:21.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku gagal sebagai Penjaga Roh!
Dialogue: 0,0:03:22.01,0:03:24.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa. Aku masih hidup, kok.
Dialogue: 0,0:03:25.61,0:03:28.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bukan karena kau,\NGadjah, aku pasti sudah mati.
Dialogue: 0,0:03:28.50,0:03:29.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu,
Dialogue: 0,0:03:29.50,0:03:33.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku senang tidak ada\Nrakyat kita yang terluka.
Dialogue: 0,0:03:34.14,0:03:35.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya berkatmu, Gadjah!
Dialogue: 0,0:03:38.21,0:03:43.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, demi melindungi semuanya,\Nrakyat, kerajaan...
Dialogue: 0,0:03:43.91,0:03:45.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wujudmu menjadi seperti ini.
Dialogue: 0,0:03:46.85,0:03:49.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau terpaksa melakukan hal\Nyang paling kau benci.
Dialogue: 0,0:03:50.70,0:03:54.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata aku memang gagal\Nsebagai Penjaga Roh.
Dialogue: 0,0:03:55.30,0:03:58.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin melindungimu\Nlebih dari kerajaan kita.
Dialogue: 0,0:03:59.82,0:04:01.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan membiarkanmu mati.
Dialogue: 0,0:04:02.01,0:04:03.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak akan membiarkanmu membunuhku.
Dialogue: 0,0:04:04.48,0:04:08.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan mati karena luka\Nyang kau berikan padaku!
Dialogue: 0,0:04:09.06,0:04:12.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kuubah segenap nyawa ini\Nmenjadi daya sihir
Dialogue: 0,0:04:12.21,0:04:13.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan melenyapkan dia!
Dialogue: 0,0:04:14.16,0:04:15.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sini, sekarang juga.
Dialogue: 0,0:04:15.94,0:04:18.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kali ini, aku akan menyelamatkanmu!
Dialogue: 0,0:04:19.23,0:04:21.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Pemungkas Petir:
Dialogue: 0,0:04:21.36,0:04:22.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apocalypra
Dialogue: 0,0:04:23.88,0:04:25.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astrauza!
Dialogue: 0,0:04:29.59,0:04:32.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pembusukan Dunia\Ntidak bisa melenyapkan itu...!
Dialogue: 0,0:04:47.45,0:04:48.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu serangan lagi!
Dialogue: 0,0:04:49.16,0:04:50.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lemah juga tidak apa-apa!
Dialogue: 0,0:04:50.87,0:04:53.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya butuh sedikit kekuatan Ranah Suci
Dialogue: 0,0:04:53.57,0:04:55.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk menembus jantungnya\Nyang berada di luar!
Dialogue: 0,0:04:58.35,0:05:01.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rupanya itu sihir yang membakar jiwa, ya?
Dialogue: 0,0:05:04.40,0:05:06.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatannya lebih besar dari perkiraanku.
Dialogue: 0,0:05:07.86,0:05:11.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luar biasa, manusia.
Dialogue: 0,0:05:11.90,0:05:13.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi sungguh disayangkan.
Dialogue: 0,0:05:13.29,0:05:14.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tubuhku dilindungi
Dialogue: 0,0:05:14.69,0:05:18.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}segel kutukan dengan regenerasi super cepat.
Dialogue: 0,0:05:18.83,0:05:19.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadjah!
Dialogue: 0,0:05:23.38,0:05:24.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Undine!
Dialogue: 0,0:05:25.46,0:05:27.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama seperti pertarungan kita sebelumnya.
Dialogue: 0,0:05:28.89,0:05:32.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak bisa menggunakan\Nkekuatan Ranah Suci lagi.
Dialogue: 0,0:05:32.83,0:05:35.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang, ini benar-benar berakhir.
Dialogue: 0,0:05:42.57,0:05:43.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih belum!
Dialogue: 0,0:05:50.88,0:05:51.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum apa?
Dialogue: 0,0:05:52.70,0:05:55.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dilihat dari segi apa pun,\Nkau tidak akan bisa menang.
Dialogue: 0,0:05:56.09,0:05:58.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kenapa masih berusaha melawan?
Dialogue: 0,0:05:58.16,0:06:01.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah ini momen manusia\Nmelewati seluruh batasannya
Dialogue: 0,0:06:01.72,0:06:03.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan menciptakan sebuah sihir?
Dialogue: 0,0:06:04.25,0:06:07.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu,\Nsaat berada di dalam Pembusukan Dunia,
Dialogue: 0,0:06:07.02,0:06:10.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tiada sihir ciptaan manusia\Ndapat mengalahkanku.
Dialogue: 0,0:06:11.57,0:06:15.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iblis tidak pernah menentang sosok\Ndengan kedudukan lebih tinggi.
Dialogue: 0,0:06:15.53,0:06:17.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu usaha yang sia-sia.
Dialogue: 0,0:06:17.22,0:06:19.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kalian, para manusia,
Dialogue: 0,0:06:19.04,0:06:21.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menjunjung tinggi hal absurd
Dialogue: 0,0:06:21.20,0:06:23.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan mempertaruhkan nyawa\Nuntuk hal yang sia-sia.
Dialogue: 0,0:06:24.72,0:06:28.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Acier Silva melawan atas nama "cinta"\Npada anak-anaknya.
Dialogue: 0,0:06:28.57,0:06:33.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pria di sana melawan atas nama "kesetiaan"\Nyang ia ikrarkan kepada ratunya.
Dialogue: 0,0:06:34.08,0:06:38.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, ada kau yang bertarung\Natas nama "harapan" yang tak pernah ada.
Dialogue: 0,0:06:38.62,0:06:42.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kalian, para manusia, berpegang teguh
Dialogue: 0,0:06:42.30,0:06:44.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pada hal semacam itu\Ndan menolak untuk menyerah?
Dialogue: 0,0:06:47.92,0:06:49.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa menang?
Dialogue: 0,0:06:50.27,0:06:52.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu itu, kok.
Dialogue: 0,0:06:55.66,0:06:59.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau benar. Itu semua milik kami.
Dialogue: 0,0:06:59.47,0:07:01.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bahkan tidak ingin kau memahami soal itu!
Dialogue: 0,0:07:03.34,0:07:05.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan iblis ini?
Dialogue: 0,0:07:05.39,0:07:06.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia terlalu kuat!
Dialogue: 0,0:07:09.33,0:07:10.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manusia itu...
Dialogue: 0,0:07:11.58,0:07:13.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski kesempatan menangnya kecil,
Dialogue: 0,0:07:13.64,0:07:15.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mereka akan tetap maju\Njika itu harus dilakukan!
Dialogue: 0,0:07:16.80,0:07:20.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jujur saja,\Naku juga ingin berlutut dan menangis.
Dialogue: 0,0:07:21.49,0:07:23.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bukan soal kami akan menang\Nselama tidak menyerah...
Dialogue: 0,0:07:24.39,0:07:27.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kami pasti akan kalah kalau menyerah!
Dialogue: 0,0:07:27.88,0:07:30.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi... Meski begitu...
Dialogue: 0,0:07:30.78,0:07:34.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kegigihan ini adalah kekuatan kami!
Dialogue: 0,0:07:37.44,0:07:41.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga, aku tidak memahami kalian.\NKalian memang menarik...
Dialogue: 0,0:07:41.42,0:07:44.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku tidak punya waktu\Nuntuk main-main lagi.
Dialogue: 0,0:07:47.92,0:07:49.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Segel Kutukan:
Dialogue: 0,0:07:50.45,0:07:52.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ledakan Kehidupan.
Dialogue: 0,0:07:54.24,0:07:56.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan meledakkan Lolopechka,
Dialogue: 0,0:07:56.11,0:07:59.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan membunuh seluruh manusia\Nyang ada di kastel ini.
Dialogue: 0,0:08:00.13,0:08:02.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah itu,
Dialogue: 0,0:08:02.39,0:08:05.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan sepenuhnya muncul di dunia ini.
Dialogue: 0,0:08:13.55,0:08:17.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lolopechka!
Dialogue: 0,0:08:31.29,0:08:32.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hampir saja!
Dialogue: 0,0:08:34.30,0:08:35.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mepet banget!
Dialogue: 0,0:08:36.41,0:08:37.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga...
Dialogue: 0,0:08:37.90,0:08:40.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya kita ketemu lagi\Ndalam keadaan sehat walafiat, Noelle!
Dialogue: 0,0:08:41.24,0:08:42.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kaulah yang mengajarkanku...
Dialogue: 0,0:08:45.05,0:08:48.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sehat walafiat dari mana?\NDasar Asta bodoh.
Dialogue: 0,0:08:53.60,0:08:55.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manusia itu...
Dialogue: 0,0:08:56.01,0:08:59.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berhasil mencegah\NRatu Lolopechka meledak,
Dialogue: 0,0:08:59.78,0:09:01.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi masih banyak kutukan lain di tubuhnya.
Dialogue: 0,0:09:02.31,0:09:05.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal baru satu gerbang dunia bawah\Nyang terbuka...
Dialogue: 0,0:09:05.81,0:09:08.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kenapa ada iblis tingkat tertinggi\Ndi sini?!
Dialogue: 0,0:09:08.86,0:09:10.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jujur saja, nih...
Dialogue: 0,0:09:10.27,0:09:13.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tidak akan bisa menang tanpa Unite.
Dialogue: 0,0:09:14.94,0:09:18.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa dia bisa melakukan itu\Ndi dalam Pembusukan Dunia?
Dialogue: 0,0:09:18.92,0:09:19.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, benar juga.
Dialogue: 0,0:09:20.13,0:09:24.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia manusia pengguna anti-sihir\Nyang diceritakan Vanica dan yang lain.
Dialogue: 0,0:09:25.39,0:09:26.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelihatannya menarik,
Dialogue: 0,0:09:26.97,0:09:30.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi dia pemicu situasi\Nyang berada di luar dugaan.
Dialogue: 0,0:09:31.61,0:09:33.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu main-main kita habis.
Dialogue: 0,0:09:35.72,0:09:37.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama-tama, aku akan membunuh
Dialogue: 0,0:09:37.85,0:09:40.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Vanica dan Lolopechka...
Dialogue: 0,0:09:40.72,0:09:43.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, muncul sepenuhnya di dunia ini.
Dialogue: 0,0:09:45.28,0:09:47.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Formula kutukannya menghilang?
Dialogue: 0,0:09:56.58,0:10:00.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku masih berdiri di sini!
Dialogue: 0,0:10:01.47,0:10:05.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa perempuan itu masih...?\NSeharusnya dia tidak bisa bangkit lagi.
Dialogue: 0,0:10:06.15,0:10:08.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, daya sihirnya terus menguat...!
Dialogue: 0,0:10:10.64,0:10:12.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir ini berbeda dengan yang biasanya,
Dialogue: 0,0:10:12.90,0:10:14.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi ia butuh waktu sampai efeknya aktif.
Dialogue: 0,0:10:22.19,0:10:24.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama Senja Valhalla aktif,
Dialogue: 0,0:10:24.66,0:10:27.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}daya sihir milik teman-temanku\Nakan meningkat.
Dialogue: 0,0:10:27.02,0:10:28.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu,
Dialogue: 0,0:10:28.03,0:10:31.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}separah apa pun lukanya,\Nmereka tidak akan mati!
Dialogue: 0,0:10:31.43,0:10:33.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka tidak terkalahkan\Nselama beberapa menit!
Dialogue: 0,0:10:33.82,0:10:36.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat efeknya berakhir,\Nluka mereka akan kembali, sih,
Dialogue: 0,0:10:36.50,0:10:38.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi siapa peduli soal itu sekarang!
Dialogue: 0,0:10:40.32,0:10:41.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rill keren banget!
Dialogue: 0,0:10:41.90,0:10:44.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah kau masih hidup!
Dialogue: 0,0:10:44.49,0:10:46.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Asta tidak datang ke sini,
Dialogue: 0,0:10:46.60,0:10:48.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ledakan itu akan terjadi\Nsebelum sihirku aktif.
Dialogue: 0,0:10:49.52,0:10:52.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkatnya, aku berhasil mencapai\Nkarya terbaikku!
Dialogue: 0,0:10:53.00,0:10:56.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu per satu,\Nmereka memang sama sekali bukan tandinganku,
Dialogue: 0,0:10:56.84,0:10:59.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi saat menyatukan kekuatan\Nmereka bisa sejauh ini...
Dialogue: 0,0:11:00.32,0:11:03.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian memang benar-benar menarik.
Dialogue: 0,0:11:08.83,0:11:14.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para Dark Disciple yang terlelap di bawah\Nmenara ini telah menghiburku dan juga Vanica.
Dialogue: 0,0:11:14.95,0:11:16.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kumasukkan kekuatan iblis,
Dialogue: 0,0:11:16.96,0:11:22.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bersama dengan jiwa Acier Silva\Ndalam genggamanku, juga kekuatan Vanica.
Dialogue: 0,0:11:24.80,0:11:27.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mayat hidup dari darah dan logam.
Dialogue: 0,0:11:32.18,0:11:34.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jumlahnya ada seratus.
Dialogue: 0,0:11:53.74,0:11:56.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tubuhku sakit banget!
Dialogue: 0,0:11:56.34,0:11:58.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa terinjak-injak mereka!
Dialogue: 0,0:12:04.85,0:12:07.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah menolong Lolopechka.
Dialogue: 0,0:12:07.27,0:12:10.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama-sama!\NTerima kasih juga sudah menolongku!
Dialogue: 0,0:12:10.23,0:12:11.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf!
Dialogue: 0,0:12:11.15,0:12:14.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku sama sekali tidak berguna sekarang!
Dialogue: 0,0:12:14.45,0:12:16.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuserahkan sisanya pada kalian!
Dialogue: 0,0:12:16.01,0:12:17.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?!
Dialogue: 0,0:12:17.14,0:12:19.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bicara apa kau?! Padahal baru datang!
Dialogue: 0,0:12:19.53,0:12:22.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Noelle, kau pasti bisa!
Dialogue: 0,0:12:22.65,0:12:24.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu itu.
Dialogue: 0,0:12:24.61,0:12:27.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pasti sudah memaksakan diri dalam\Nperjalanan ke sini, seperti biasanya.
Dialogue: 0,0:12:28.71,0:12:30.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah cukup berjuang.
Dialogue: 0,0:12:30.84,0:12:32.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kau datang ke sini...
Dialogue: 0,0:12:34.05,0:12:35.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya karena aku memikirkanmu,
Dialogue: 0,0:12:37.59,0:12:39.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kekuatan kembali mengalir dalam tubuhku.
Dialogue: 0,0:12:40.84,0:12:43.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, ternyata memang benar.
Dialogue: 0,0:12:44.27,0:12:46.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama ini aku sudah berusaha mengabaikannya,
Dialogue: 0,0:12:46.51,0:12:48.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi malah sadar di saat-saat seperti ini.
Dialogue: 0,0:12:50.43,0:12:53.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata aku... menyukai Asta.
Dialogue: 0,0:12:54.38,0:12:56.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, ini medan perang.
Dialogue: 0,0:12:56.94,0:12:59.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang, aku harus mengalahkannya!
Dialogue: 0,0:12:59.87,0:13:01.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita mulai, Undine!
Dialogue: 0,0:13:02.15,0:13:03.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ranah Suci terakhir!
Dialogue: 0,0:13:11.35,0:13:13.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keren!
Dialogue: 0,0:13:14.27,0:13:16.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku titip Lolopechka padamu, Asta!
Dialogue: 0,0:13:16.79,0:13:18.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, duh. Oke!
Dialogue: 0,0:13:21.99,0:13:26.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan Ranah Suci kita\Ntidak cukup untuk menghadapi mereka!
Dialogue: 0,0:13:27.38,0:13:30.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Lukisan: Pemimpin Valhalla!
Dialogue: 0,0:13:32.19,0:13:34.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Noelle dengan Ranah Suci,
Dialogue: 0,0:13:34.10,0:13:37.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan Charlotte dengan sihir anti-kutukannya,\Nitulah kuncinya!
Dialogue: 0,0:13:39.21,0:13:41.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti, aku harus mendukung mereka!
Dialogue: 0,0:13:42.02,0:13:45.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Mawar Liar Sejati:\NTombak Penempur Penjalin Keindahan Merah Tua!
Dialogue: 0,0:13:48.30,0:13:52.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian terus berevolusi\Nsepanjang pertarungan.
Dialogue: 0,0:13:54.85,0:13:55.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga.
Dialogue: 0,0:14:03.72,0:14:06.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian memang mainan terbaik.
Dialogue: 0,0:14:12.72,0:14:13.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Noelle!
Dialogue: 0,0:14:24.36,0:14:25.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luck!
Dialogue: 0,0:14:25.58,0:14:28.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan membukakan jalan, kau ikuti aku!
Dialogue: 0,0:14:28.04,0:14:29.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, kerja bagus, teman-teman!
Dialogue: 0,0:14:29.97,0:14:33.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dapat banyak inspirasi!
Dialogue: 0,0:14:33.30,0:14:37.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti lebih bagus kalau ditambah\Nsatu sentuhan petir lagi.
Dialogue: 0,0:14:47.48,0:14:49.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa dibilang aku sudah mati.
Dialogue: 0,0:14:53.28,0:14:54.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku tetap bersyukur.
Dialogue: 0,0:14:55.43,0:14:59.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang bisa bertarung\Ndemi Nona Lolopechka!
Dialogue: 0,0:15:00.68,0:15:02.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadjah!
Dialogue: 0,0:15:06.60,0:15:07.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo lakukan.
Dialogue: 0,0:15:08.09,0:15:09.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:15:23.93,0:15:24.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang!
Dialogue: 0,0:15:32.28,0:15:34.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski bukan muncul sepenuhnya...
Dialogue: 0,0:15:34.93,0:15:37.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian hebat bisa bertarung\Ndenganku selama ini.
Dialogue: 0,0:15:38.22,0:15:40.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar mengejutkan,
Dialogue: 0,0:15:41.70,0:15:43.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi tetap saja...
Dialogue: 0,0:15:46.05,0:15:47.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua berakhir di sini.
Dialogue: 0,0:15:58.63,0:16:00.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beraninya kau
Dialogue: 0,0:16:00.86,0:16:03.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}muncul di hadapan keluargaku!
Dialogue: 0,0:16:07.28,0:16:11.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tak tahu berapa lama\Naku menantikan hari ini tiba.
Dialogue: 0,0:16:17.78,0:16:23.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibunda yang terkena kutukan\Nterus melemah setiap harinya.
Dialogue: 0,0:16:23.45,0:16:25.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerabat kami yang tidak tahu apa-apa
Dialogue: 0,0:16:25.95,0:16:28.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menduga itu efek samping persalinan.
Dialogue: 0,0:16:29.61,0:16:32.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat Ibunda terkena sihir segel kutukan,
Dialogue: 0,0:16:32.95,0:16:35.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku juga menerima sedikit kutukan.
Dialogue: 0,0:16:36.15,0:16:41.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan mati jika mengatakan Megicula\Nterlibat dalam kematian Acier Silva.
Dialogue: 0,0:16:41.77,0:16:43.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika aku menceritakan hal itu,
Dialogue: 0,0:16:43.80,0:16:46.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}orang-orang yang mendengar kesaksianku\Nakan terkena kutukan serupa,
Dialogue: 0,0:16:46.91,0:16:50.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan sihir itu pun\Nakan menyebar bagaikan wabah.
Dialogue: 0,0:16:51.11,0:16:53.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak bisa cerita pada siapa pun.
Dialogue: 0,0:16:53.77,0:16:55.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa apa-apa...
Dialogue: 0,0:16:56.43,0:16:58.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku... Ibunda...
Dialogue: 0,0:16:58.45,0:17:00.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus mencari cara melepas kutukan itu!
Dialogue: 0,0:17:01.24,0:17:03.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nozel. Sudah, cukup.
Dialogue: 0,0:17:07.81,0:17:11.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dibiarkan saja,\Nnyawamu juga akan terancam.
Dialogue: 0,0:17:11.95,0:17:13.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:17:13.93,0:17:16.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manusia tidak bisa\Nbertambah kuat semudah itu.
Dialogue: 0,0:17:19.82,0:17:21.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi tenang saja...
Dialogue: 0,0:17:22.95,0:17:25.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau... Kalian semua...
Dialogue: 0,0:17:26.41,0:17:28.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti bisa tumbuh lebih kuat dari aku.
Dialogue: 0,0:17:30.35,0:17:31.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, hiduplah.
Dialogue: 0,0:17:33.26,0:17:34.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nozel.
Dialogue: 0,0:17:44.21,0:17:48.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibunda meninggal satu tahun\Nsetelah terkena kutukan itu.
Dialogue: 0,0:17:48.71,0:17:49.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama satu tahun itu,
Dialogue: 0,0:17:50.16,0:17:54.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku hanya bisa menonton,\Ndan tidak bisa berbuat apa-apa...
Dialogue: 0,0:17:58.90,0:17:59.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih kuat...
Dialogue: 0,0:18:04.14,0:18:06.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus bertambah kuat.
Dialogue: 0,0:18:07.79,0:18:10.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agar aku bisa membalas dendam Ibunda
Dialogue: 0,0:18:11.70,0:18:13.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan melindungi adik-adikku!
Dialogue: 0,0:18:15.15,0:18:18.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nebra dan Solid memang bertambah kuat,
Dialogue: 0,0:18:18.68,0:18:21.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi mereka bukan tandingan makhluk itu.
Dialogue: 0,0:18:21.99,0:18:23.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sementara Noelle...
Dialogue: 0,0:18:23.30,0:18:27.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakanda Nozel, bisakah kau mengajariku sihir?
Dialogue: 0,0:18:27.62,0:18:29.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika dia tidak bisa bertambah kuat,
Dialogue: 0,0:18:30.09,0:18:32.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebaiknya aku kurung saja.
Dialogue: 0,0:18:33.90,0:18:37.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manusia gagal sepertimu\Ntidak dibutuhkan di medan perang.
Dialogue: 0,0:18:38.51,0:18:40.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika pada akhirnya dia akan\Nmengalami hal yang sama sepertiku,
Dialogue: 0,0:18:41.20,0:18:42.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebaiknya aku jauhkan dia dari pertempuran.
Dialogue: 0,0:18:44.22,0:18:49.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa Ibunda harus meninggal\Ndemi melahirkan orang seperti kau?
Dialogue: 0,0:18:51.47,0:18:53.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah membunuh Ibunda.
Dialogue: 0,0:18:55.84,0:18:56.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan!
Dialogue: 0,0:18:57.79,0:18:59.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akulah yang membunuh Ibunda!
Dialogue: 0,0:19:00.92,0:19:03.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang tidak berguna, tidak berdaya...
Dialogue: 0,0:19:04.24,0:19:06.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku takut kehilangan lagi,\Ndan melarikan diri.
Dialogue: 0,0:19:07.34,0:19:10.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengecut yang tak memiliki tekad\Nuntuk melindungi.
Dialogue: 0,0:19:12.11,0:19:15.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang sekarang\Ntidak berhak berhubungan denganmu.
Dialogue: 0,0:19:17.10,0:19:18.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih kuat...
Dialogue: 0,0:19:20.20,0:19:21.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih kuat lagi...!
Dialogue: 0,0:19:25.31,0:19:28.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi mencapai tujuanku menjadi Kaisar Sihir!
Dialogue: 0,0:19:29.58,0:19:33.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak boleh mati di tempat ini!
Dialogue: 0,0:19:34.46,0:19:37.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa melawan orang\Ndengan daya sihir mengerikan seperti dia...
Dialogue: 0,0:19:38.07,0:19:41.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...\NDemi hari yang akan datang di masa depan...!
Dialogue: 0,0:19:47.50,0:19:52.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuucapkan terima kasih pada semua orang\Nyang ada di sini hari ini.
Dialogue: 0,0:19:58.76,0:20:02.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya kita bertemu!
Dialogue: 0,0:20:03.12,0:20:05.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan mengerahkan segala yang kupunya!
Dialogue: 0,0:20:10.63,0:20:14.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini yang disebut...\Nreuni yang mengharukan?
Dialogue: 0,0:20:20.73,0:20:24.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, tapi aku tak punya emosi itu.
Dialogue: 0,0:20:27.08,0:20:29.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau punya kekuatan bagai logam,
Dialogue: 0,0:20:29.29,0:20:31.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan fleksibilitas bagaikan air.
Dialogue: 0,0:20:31.79,0:20:33.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan harap bisa menangkis itu!
Dialogue: 0,0:20:35.56,0:20:36.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Darahku bergejolak,
Dialogue: 0,0:20:37.60,0:20:39.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}besi telah masuk ke dalam tubuhku.
Dialogue: 0,0:20:40.37,0:20:43.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu,\Naku tetap tak bisa menghancurkan jantungnya.
Dialogue: 0,0:20:45.17,0:20:47.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya aku sudah salah paham.
Dialogue: 0,0:20:47.90,0:20:50.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak seharusnya aku\Nmengurung dan menjauhkan dia.
Dialogue: 0,0:20:53.17,0:20:55.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus bertambah kuat bersama.
Dialogue: 0,0:21:01.32,0:21:02.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamilah yang menang
Dialogue: 0,0:21:03.52,0:21:06.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena tidak menyerah, Megicula!
Dialogue: 0,0:21:14.17,0:21:15.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memang waspada,
Dialogue: 0,0:21:16.16,0:21:19.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku selalu berpikir bahwa manusia\Ntidak mungkin menang melawanku.
Dialogue: 0,0:21:22.52,0:21:24.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya aku salah menilai
Dialogue: 0,0:21:25.05,0:21:29.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}wujud asli kekuatan kalian.
Dialogue: 0,0:21:30.29,0:21:32.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin itu pula yang membuatku\Ntertarik pada kalian.
Dialogue: 0,0:21:33.54,0:21:37.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tertarik pada kekuatan emosi milik manusia.
Dialogue: 0,0:21:51.98,0:21:55.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian berdua benar-benar\Nsudah bertambah kuat.
