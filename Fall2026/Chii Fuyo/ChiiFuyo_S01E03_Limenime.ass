Dialogue: 0,0:02:12.96,0:02:15.42,sign,,0000,0000,0000,,EP. 03 KALAU MENGAJAK REKAN YANG\NMENGURUNG DIRI DUA TAHUN UNTUK MINTA MAAF
Dialogue: 0,0:02:15.51,0:02:17.97,sign,,0000,0000,0000,,LALU MENYAJIKAN DUA APEL KELINCI,\NAPA AKU BAKAL DIMAAFKAN?
Dialogue: 0,0:05:29.03,0:05:30.74,sign,,0000,0000,0000,,DUA TAHUN LALU
Dialogue: 0,0:21:07.55,0:21:08.85,sign,,0000,0000,0000,,DIA SADAR!
Dialogue: 0,0:21:26.78,0:21:29.37,sign,,0000,0000,0000,,"RAHASIA UMUM"
Dialogue: 0,0:21:51.81,0:21:53.35,sign,,0000,0000,0000,,YANG PALING PARAH CORNELIUS\NDARI TARING RAJA BINATANG
Dialogue: 0,0:00:03.33,0:00:06.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertemuan!
Dialogue: 0,0:00:07.67,0:00:09.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sana! Hei, Lily!
Dialogue: 0,0:00:10.05,0:00:12.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily! Hei!
Dialogue: 0,0:00:13.13,0:00:14.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:00:14.30,0:00:16.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan dia. Dia murid SD.
Dialogue: 0,0:00:17.51,0:00:18.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku.
Dialogue: 0,0:00:18.51,0:00:19.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang mau kutemui
Dialogue: 0,0:00:19.93,0:00:22.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}penampilannya mirip anak SD.
Dialogue: 0,0:00:22.52,0:00:24.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyebalkan sekali!
Dialogue: 0,0:00:24.31,0:00:26.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rein, rupanya kau di sini.
Dialogue: 0,0:00:26.98,0:00:29.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau seharusnya menunggu di tempat pertemuan.
Dialogue: 0,0:00:29.82,0:00:31.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah lama mencarimu.
Dialogue: 0,0:00:32.57,0:00:33.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, bukan dia.
Dialogue: 0,0:00:33.99,0:00:35.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini hanya tumpukan tanah.
Dialogue: 0,0:00:35.61,0:00:39.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, warnanya sama dengan Rein.
Dialogue: 0,0:00:39.45,0:00:42.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku salah. Maafkan aku!
Dialogue: 0,0:00:56.93,0:00:59.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}The Laid-Off Cheat-Granting Mage\NEnjoys a Second Lease on Life
Dialogue: 0,0:02:18.84,0:02:20.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lama tidak bertemu.
Dialogue: 0,0:02:20.84,0:02:23.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku lega melihatmu bersenang-senang.
Dialogue: 0,0:02:23.60,0:02:26.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Margaret...
Dialogue: 0,0:02:26.14,0:02:30.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau benar-benar lupa apa\Nyang terjadi di Gadressa?
Dialogue: 0,0:02:31.61,0:02:33.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Insiden itu...
Dialogue: 0,0:02:35.90,0:02:37.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily, ada apa?
Dialogue: 0,0:02:37.24,0:02:38.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mengenalnya?
Dialogue: 0,0:02:38.70,0:02:41.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia adalah...
Dialogue: 0,0:02:41.95,0:02:43.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kau Rein?
Dialogue: 0,0:02:44.16,0:02:45.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kau tahu namaku?
Dialogue: 0,0:02:45.99,0:02:50.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taring Raja Binatang\Nsedang heboh mencari Rein dan Lily.
Dialogue: 0,0:02:50.29,0:02:51.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seluruh kota sudah tahu sekarang.
Dialogue: 0,0:02:52.67,0:02:54.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taring Raja Binatang?
Dialogue: 0,0:02:54.75,0:02:57.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau memberi tahu kami?
Dialogue: 0,0:02:57.59,0:03:01.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daripada mencemaskanku,\Nlebih baik kau perhatikan Lily.
Dialogue: 0,0:03:01.13,0:03:03.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat, dia gemetar.
Dialogue: 0,0:03:03.10,0:03:04.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian rekan, 'kan?
Dialogue: 0,0:03:05.10,0:03:06.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily, kau baik-baik saja?
Dialogue: 0,0:03:06.89,0:03:08.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang terjadi?
Dialogue: 0,0:03:08.77,0:03:10.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan apa-apa.
Dialogue: 0,0:03:10.60,0:03:13.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kau harus berhati-hati.
Dialogue: 0,0:03:14.31,0:03:17.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bisa dikhianati\Ndi saat yang paling penting,
Dialogue: 0,0:03:17.44,0:03:20.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan kehilangan nyawamu karena itu.
Dialogue: 0,0:03:21.91,0:03:24.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai jumpa.
Dialogue: 0,0:03:25.20,0:03:26.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily.
Dialogue: 0,0:03:26.91,0:03:32.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak sabar melihatmu lebih menderita\Nsaat kita bertemu lagi.
Dialogue: 0,0:03:32.46,0:03:34.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan dia?
Dialogue: 0,0:03:34.79,0:03:37.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily, ayo kembali ke guild dulu.
Dialogue: 0,0:03:39.46,0:03:41.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aneh.
Dialogue: 0,0:03:41.55,0:03:46.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira Taring Raja Binatang\Nakan menyisir jalanan mencari kita,
Dialogue: 0,0:03:46.18,0:03:48.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi sepertinya tidak.
Dialogue: 0,0:03:48.81,0:03:52.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si Margaret itu membohongi kita.
Dialogue: 0,0:03:52.90,0:03:56.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau benar-benar mengalahkan naga itu!
Dialogue: 0,0:03:57.94,0:03:59.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily?
Dialogue: 0,0:03:59.74,0:04:00.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nina!
Dialogue: 0,0:04:00.69,0:04:03.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah dengar kabar\Ntentang Taring Raja Binatang?
Dialogue: 0,0:04:04.66,0:04:07.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa kita tidak perlu mengkhawatirkan itu.
Dialogue: 0,0:04:08.29,0:04:12.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar Taring Raja Binatang\Nberusaha mencari dan menculik kalian.
Dialogue: 0,0:04:12.87,0:04:14.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menculik kami?
Dialogue: 0,0:04:14.75,0:04:17.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kudengar guild itu sedang gempar.
Dialogue: 0,0:04:18.25,0:04:20.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya, senjata\Ndan pelindung mereka melemah.
Dialogue: 0,0:04:20.58,0:04:23.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, petualang sekuat Cornelius
Dialogue: 0,0:04:23.09,0:04:26.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dikalahkan oleh petualang peringkat D\Nseperti Rein.
Dialogue: 0,0:04:27.18,0:04:29.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rupanya Rein memang sekuat itu.
Dialogue: 0,0:04:29.81,0:04:31.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir pengimbuhnya yang kuat.
Dialogue: 0,0:04:32.02,0:04:34.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Insiden ini tampaknya berdampak besar.
Dialogue: 0,0:04:34.44,0:04:38.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak yang meninggalkan Taring Raja Binatang\Nuntuk bergabung dengan guild lain.
Dialogue: 0,0:04:39.44,0:04:40.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan kata lain,
Dialogue: 0,0:04:40.36,0:04:44.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taring Raja Binatang tidak punya waktu\Nuntuk mencari Rein dan Lily sekarang.
Dialogue: 0,0:04:44.74,0:04:47.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,\Ntidak ada yang perlu dikhawatirkan.
Dialogue: 0,0:04:48.24,0:04:50.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan kembali ke kamarku\Nuntuk beristirahat.
Dialogue: 0,0:04:50.66,0:04:54.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu,\Nkau harus tetap waspada untuk sementara.
Dialogue: 0,0:04:54.08,0:04:55.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:04:57.71,0:05:00.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang ingin kutanyakan kepadamu.
Dialogue: 0,0:05:00.09,0:05:01.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:05:01.09,0:05:04.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tahu apa yang terjadi di Gadressa?
Dialogue: 0,0:05:06.68,0:05:08.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari mana kau mendengar nama itu?
Dialogue: 0,0:05:08.60,0:05:11.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari seorang gadis bernama Margaret.
Dialogue: 0,0:05:11.77,0:05:13.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis itu...
Dialogue: 0,0:05:13.60,0:05:15.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, benar.
Dialogue: 0,0:05:16.85,0:05:18.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia keluarga salah satu\Nrekan Lily yang gugur.
Dialogue: 0,0:05:18.90,0:05:19.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keluarga rekannya?
Dialogue: 0,0:05:20.36,0:05:23.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadressa adalah tempat Lily bertarung\Nuntuk terakhir kalinya.
Dialogue: 0,0:05:24.49,0:05:26.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu juga alasan dia\Ntidak bisa bertarung lagi.
Dialogue: 0,0:05:32.58,0:05:35.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya, quest baru telah tiba.
Dialogue: 0,0:05:35.25,0:05:36.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Quest baru?
Dialogue: 0,0:05:37.42,0:05:39.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga, mereka tak pernah\Nmembiarkan kita beristirahat.
Dialogue: 0,0:05:40.54,0:05:42.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagian, kau juga tidak mau istirahat, 'kan?
Dialogue: 0,0:05:42.88,0:05:46.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, apa quest-nya cukup sulit?
Dialogue: 0,0:05:46.59,0:05:49.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya aku pernah pilih quest\Nyang membosankan?
Dialogue: 0,0:05:54.77,0:05:56.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Artinya,
Dialogue: 0,0:05:57.10,0:05:58.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tingkat kesulitannya paling tinggi.
Dialogue: 0,0:05:59.48,0:06:00.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja.
Dialogue: 0,0:06:01.32,0:06:05.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Reruntuhan Naga Bercahaya di Gadressa,\Ndi Kerajaan Naga Timur?
Dialogue: 0,0:06:05.74,0:06:09.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu artinya targetnya adalah "itu"\Nyang tertidur di bagian terdalam.
Dialogue: 0,0:06:09.87,0:06:13.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak ada petualang yang pernah\Nberhasil mencapainya, 'kan?
Dialogue: 0,0:06:14.04,0:06:17.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar ada naga yang sangat kuat di sana.
Dialogue: 0,0:06:17.21,0:06:18.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily, bagaimana menurutmu?
Dialogue: 0,0:06:19.42,0:06:20.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga perjalananmu lancar!
Dialogue: 0,0:06:20.46,0:06:21.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa tidak?
Dialogue: 0,0:06:23.17,0:06:26.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bersama kita, pasti gampang!
Dialogue: 0,0:06:57.25,0:07:00.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak kuat sekali, 'kan?
Dialogue: 0,0:07:05.13,0:07:06.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily.
Dialogue: 0,0:07:06.30,0:07:07.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di mana kakakku?
Dialogue: 0,0:07:08.34,0:07:10.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kakakku belum kembali?
Dialogue: 0,0:07:11.80,0:07:14.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku, Margaret.
Dialogue: 0,0:07:15.31,0:07:16.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku.
Dialogue: 0,0:07:18.18,0:07:21.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua orang tewas.
Dialogue: 0,0:07:24.44,0:07:26.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakakmu juga.
Dialogue: 0,0:07:27.61,0:07:28.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku.
Dialogue: 0,0:07:30.11,0:07:31.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:07:31.45,0:07:34.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa hanya kau yang kembali?
Dialogue: 0,0:07:34.16,0:07:35.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Andai saja...
Dialogue: 0,0:07:35.78,0:07:39.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Andai saja kau yang mati, bukan kakakku!
Dialogue: 0,0:07:44.21,0:07:45.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku.
Dialogue: 0,0:07:47.30,0:07:48.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku.
Dialogue: 0,0:07:50.51,0:07:52.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku.
Dialogue: 0,0:07:53.51,0:07:57.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang sebenarnya dicari Lily\Ndan yang lainnya di Gadressa?
Dialogue: 0,0:07:57.89,0:07:59.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang legendaris.
Dialogue: 0,0:07:59.39,0:08:01.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang Bercahaya Kaisar Naga.
Dialogue: 0,0:08:01.19,0:08:02.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Konon itu pedang yang memancarkan cahaya
Dialogue: 0,0:08:02.48,0:08:05.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan memiliki kekuatan naga.
Dialogue: 0,0:08:06.32,0:08:07.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:08:09.36,0:08:11.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu satu tempat.
Dialogue: 0,0:08:11.86,0:08:15.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempat yang menyimpan pedang\Nyang mampu menahan sihir pengimbuhmu.
Dialogue: 0,0:08:15.91,0:08:19.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi selain itu,\Ndia tidak mau memberitahuku apa pun.
Dialogue: 0,0:08:20.25,0:08:22.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya dia masih belum bisa\Nmenghadapi masa lalu itu.
Dialogue: 0,0:08:25.75,0:08:26.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily.
Dialogue: 0,0:08:26.92,0:08:29.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa aku akan keluar sebentar.
Dialogue: 0,0:08:29.59,0:08:30.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku akan ikut denganmu.
Dialogue: 0,0:08:31.34,0:08:32.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu.
Dialogue: 0,0:08:32.84,0:08:34.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan pergi sendirian.
Dialogue: 0,0:08:34.38,0:08:38.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taring Raja Binatang mungkin belum menyerah.
Dialogue: 0,0:08:40.10,0:08:41.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau ke mana?
Dialogue: 0,0:08:42.27,0:08:47.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayolah, katakan di mana...
Dialogue: 0,0:08:47.56,0:08:49.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ayolah...\N- Menyebalkan sekali!
Dialogue: 0,0:08:49.23,0:08:52.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily, beri tahu aku! Lily!
Dialogue: 0,0:08:53.70,0:08:55.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau ke rumah Margaret, 'kan?
Dialogue: 0,0:08:58.28,0:08:59.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:08:59.49,0:09:01.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah kau ada urusan dengannya?
Dialogue: 0,0:09:02.16,0:09:03.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rein.
Dialogue: 0,0:09:03.46,0:09:06.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka berdua memberitahumu\Ntentang Gadressa, 'kan?
Dialogue: 0,0:09:06.71,0:09:08.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kau tahu?
Dialogue: 0,0:09:08.21,0:09:10.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena dinding di sana sangat tipis.
Dialogue: 0,0:09:11.71,0:09:16.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, aku tidak ingat apa pun\Nsoal kejadian dua tahun lalu.
Dialogue: 0,0:09:16.09,0:09:17.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama sekali tidak ingat?
Dialogue: 0,0:09:17.59,0:09:21.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain ketakutan dan ketidakberdayaan\Nyang belum pernah kurasakan,
Dialogue: 0,0:09:21.85,0:09:23.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tidak ingat apa pun.
Dialogue: 0,0:09:24.18,0:09:27.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat sadar,\Naku sudah terbaring di ranjang perawatan.
Dialogue: 0,0:09:27.73,0:09:31.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat itulah aku mendengar\Nsemua rekanku tewas.
Dialogue: 0,0:09:32.44,0:09:37.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pasti meninggalkan rekan-rekanku\Ndan melarikan diri sendirian.
Dialogue: 0,0:09:37.49,0:09:39.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu hanya asumsimu.
Dialogue: 0,0:09:40.03,0:09:42.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin bukan itu yang terjadi.
Dialogue: 0,0:09:46.92,0:09:53.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku selalu merasa suatu hari harus kembali\Nke Gadressa untuk mencari tahu kebenarannya.
Dialogue: 0,0:09:54.46,0:09:57.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf sudah menyeretmu\Nke dalam urusan pribadiku.
Dialogue: 0,0:09:58.18,0:09:59.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rein.
Dialogue: 0,0:09:59.76,0:10:03.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya aku tidak mau melibatkanmu.
Dialogue: 0,0:10:03.10,0:10:09.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku tidak tahu pedang lain\Nyang bisa menahan sihir pengimbuhmu.
Dialogue: 0,0:10:09.23,0:10:10.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sebabnya...
Dialogue: 0,0:10:10.56,0:10:11.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan mengkhawatirkan itu.
Dialogue: 0,0:10:12.32,0:10:14.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pergi dan cari tahu kebenarannya.
Dialogue: 0,0:10:14.44,0:10:16.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan mengambil pedang itu.
Dialogue: 0,0:10:16.82,0:10:19.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan sihir pengimbuhku,
Dialogue: 0,0:10:19.24,0:10:21.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita berdua tidak akan mati.
Dialogue: 0,0:10:22.49,0:10:23.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau benar.
Dialogue: 0,0:10:24.41,0:10:26.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebelum aku mencari tahu kebenarannya,
Dialogue: 0,0:10:26.46,0:10:29.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku ingin menyampaikan duka kepadanya,\Nkeluarga rekanku yang gugur.
Dialogue: 0,0:10:29.83,0:10:33.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, kumpulkan keberanianmu\Ndan ambil langkah pertama.
Dialogue: 0,0:10:51.81,0:10:54.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Dia tidak ada di sini?
Dialogue: 0,0:10:56.61,0:10:59.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar kau pendatang baru\Nyang menjanjikan dari Perisai Kaisar.
Dialogue: 0,0:11:00.20,0:11:03.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Barrius,\NGuild Master Taring Raja Binatang.
Dialogue: 0,0:11:03.53,0:11:07.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kau di sini untuk menemuiku,\Nkau mau gabung dengan guild kami, 'kan?
Dialogue: 0,0:11:07.16,0:11:09.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menyambutmu dengan tangan terbuka.
Dialogue: 0,0:11:09.37,0:11:11.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bahkan akan memberimu perlakuan khusus.
Dialogue: 0,0:11:11.96,0:11:14.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan itu alasanku kemari.
Dialogue: 0,0:11:16.34,0:11:21.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak akan membunuh Lily dan Rein?
Dialogue: 0,0:11:23.39,0:11:24.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:11:25.60,0:11:28.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak berencana bertindak?
Dialogue: 0,0:11:28.89,0:11:29.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau guild-mu
Dialogue: 0,0:11:29.89,0:11:31.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}terlalu payah
Dialogue: 0,0:11:31.85,0:11:34.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sampai menemukan mereka saja tidak becus?
Dialogue: 0,0:11:34.61,0:11:36.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu?
Dialogue: 0,0:11:38.24,0:11:41.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lupakan saja.\NSepertinya kau kekurangan orang.
Dialogue: 0,0:11:42.36,0:11:44.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berharap terlalu banyak.
Dialogue: 0,0:11:45.28,0:11:51.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira aku bisa membantu\Njika kau berencana membuat Lily menderita.
Dialogue: 0,0:11:53.21,0:11:56.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak percaya Lily masih bisa tersenyum.
Dialogue: 0,0:11:56.25,0:11:59.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seolah-olah dia sudah melupakan semuanya.
Dialogue: 0,0:11:59.84,0:12:02.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan pernah memaafkannya.
Dialogue: 0,0:12:03.39,0:12:09.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jasad kakakku masih ada di reruntuhan itu,\Nterpapar angin dingin.
Dialogue: 0,0:12:09.60,0:12:12.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah meninggalkan rekan-rekannya\Ndan membiarkan mereka mati,
Dialogue: 0,0:12:12.31,0:12:14.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia masih berani jadi\Npetualang sambil tersenyum.
Dialogue: 0,0:12:15.40,0:12:17.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setebal apa mukanya?
Dialogue: 0,0:12:18.65,0:12:22.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily Flambert tak boleh\Ndibiarkan menjadi petualang lagi.
Dialogue: 0,0:12:23.07,0:12:28.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dibiarkan,\Naku tidak punya muka di hadapan kakakku.
Dialogue: 0,0:12:30.83,0:12:33.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini... Aku juga tidak menyukainya.
Dialogue: 0,0:12:33.46,0:12:36.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi Taring Raja Binatang\Nsedang sibuk sekarang.
Dialogue: 0,0:12:36.42,0:12:37.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong,
Dialogue: 0,0:12:37.42,0:12:42.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau kenal penyihir pengimbuh\Nyang bisa menggantikan Rein?
Dialogue: 0,0:12:42.22,0:12:43.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi.
Dialogue: 0,0:12:52.94,0:12:55.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo, Lily.
Dialogue: 0,0:12:56.06,0:12:59.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beraninya kau menunjukkan wajahmu\Ndi hadapanku lagi.
Dialogue: 0,0:12:59.48,0:13:00.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak perlu sekasar itu.
Dialogue: 0,0:13:00.82,0:13:02.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bicara denganmu.
Dialogue: 0,0:13:02.95,0:13:04.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rein, tidak apa-apa.
Dialogue: 0,0:13:05.16,0:13:07.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin bicara denganmu, Margaret.
Dialogue: 0,0:13:09.87,0:13:10.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masuklah.
Dialogue: 0,0:13:10.87,0:13:13.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan memberimu sambutan hangat,
Dialogue: 0,0:13:13.83,0:13:16.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi setidaknya aku bisa menuangkan teh.
Dialogue: 0,0:13:17.71,0:13:19.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily, kau baik-baik saja?
Dialogue: 0,0:13:20.25,0:13:22.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengingat perasaan Margaret,
Dialogue: 0,0:13:22.59,0:13:24.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ini wajar.
Dialogue: 0,0:13:37.40,0:13:40.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minumlah. Ini tidak beracun.
Dialogue: 0,0:13:42.36,0:13:46.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Margaret, terima kasih\Nsudah mengizinkan kami masuk.
Dialogue: 0,0:13:46.28,0:13:48.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maumu?
Dialogue: 0,0:13:48.20,0:13:50.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selesaikan saja urusanmu dan pergilah.
Dialogue: 0,0:13:51.33,0:13:54.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan pergi ke Gadressa bersama Rein.
Dialogue: 0,0:13:54.75,0:13:57.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin tahu\Napa yang terjadi di masa laluku.
Dialogue: 0,0:13:57.88,0:14:00.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau ingin tahu apa yang terjadi?
Dialogue: 0,0:14:00.38,0:14:03.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau meninggalkan kakakku dan melarikan diri.
Dialogue: 0,0:14:03.96,0:14:05.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin itu benar.
Dialogue: 0,0:14:05.97,0:14:09.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi meski begitu,\Naku tetap ingin tahu kebenarannya.
Dialogue: 0,0:14:10.64,0:14:13.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belum bisa memberimu penjelasan\Nyang layak selama ini.
Dialogue: 0,0:14:13.77,0:14:16.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat malu. Aku sungguh minta maaf.
Dialogue: 0,0:14:19.86,0:14:24.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk memenuhi tugasku\Nsebagai pemimpin saat itu,
Dialogue: 0,0:14:24.94,0:14:27.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan kembali ke Gadressa.
Dialogue: 0,0:14:29.16,0:14:30.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:14:30.78,0:14:33.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, itu yang kau pikirkan sekarang.
Dialogue: 0,0:14:34.58,0:14:39.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku telah melakukan banyak\Nhal buruk kepadamu, Lily.
Dialogue: 0,0:14:39.79,0:14:43.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.\NAku pantas menerima kebencianmu.
Dialogue: 0,0:14:47.26,0:14:49.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, Lily, Rein...
Dialogue: 0,0:14:50.14,0:14:53.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisakah kalian mengizinkanku ikut?
Dialogue: 0,0:14:53.85,0:14:55.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu ini berbahaya,
Dialogue: 0,0:14:56.43,0:15:00.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku juga punya tanggung jawab.
Dialogue: 0,0:15:00.19,0:15:01.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal kakakku...
Dialogue: 0,0:15:02.15,0:15:04.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku masih membenci Lily,
Dialogue: 0,0:15:05.36,0:15:06.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi...
Dialogue: 0,0:15:06.61,0:15:09.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku ingin melihat dengan mataku\Nsendiri bagaimana kakakku mati.
Dialogue: 0,0:15:10.28,0:15:11.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja, kau boleh bergabung dengan kami.
Dialogue: 0,0:15:13.95,0:15:15.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti.
Dialogue: 0,0:15:15.66,0:15:18.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau petualang peringkat B sekarang, 'kan?
Dialogue: 0,0:15:19.33,0:15:21.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan jauh lebih menenangkan jika kau ikut.
Dialogue: 0,0:15:22.42,0:15:24.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:15:28.01,0:15:30.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tehnya sudah dingin.
Dialogue: 0,0:15:30.13,0:15:31.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kuhangatkan.
Dialogue: 0,0:15:40.81,0:15:42.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari lakukan yang terbaik, Lily.
Dialogue: 0,0:15:42.48,0:15:43.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:15:43.61,0:15:45.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan memastikan Margaret\Nkembali dengan selamat.
Dialogue: 0,0:15:46.28,0:15:47.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau ini bicara apa?
Dialogue: 0,0:15:47.90,0:15:50.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akan memastikan semua orang\Nkembali dengan selamat.
Dialogue: 0,0:15:54.20,0:15:55.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily.
Dialogue: 0,0:15:56.12,0:16:00.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari kematianmu di Gadressa akhirnya tiba.
Dialogue: 0,0:16:01.96,0:16:06.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah berusaha keras\Nmenjadi kuat demi membunuhmu.
Dialogue: 0,0:16:08.13,0:16:09.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bekerja keras sendirian...
Dialogue: 0,0:16:11.22,0:16:13.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akan tiba besok.
Dialogue: 0,0:16:13.43,0:16:15.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari istirahat lebih awal hari ini.
Dialogue: 0,0:16:15.43,0:16:17.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, ayo minum anggur.
Dialogue: 0,0:16:17.76,0:16:19.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau teler besok?
Dialogue: 0,0:16:19.89,0:16:21.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mungkin akan terlalu goyah untuk berdiri.
Dialogue: 0,0:16:22.85,0:16:24.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kuat minum!
Dialogue: 0,0:16:24.19,0:16:26.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kau selalu tertidur usai minum segelas.\N- Margaret.
Dialogue: 0,0:16:26.19,0:16:28.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kau selalu tertidur usai minum segelas.\N- Kau mau makan hot pot bersama kami?
Dialogue: 0,0:16:28.65,0:16:31.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, tapi aku tidak mau.
Dialogue: 0,0:16:31.49,0:16:32.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan begitu, dong.
Dialogue: 0,0:16:32.91,0:16:35.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita jarang bertualang bersama, 'kan?
Dialogue: 0,0:16:35.12,0:16:36.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak ikut, rasanya sepi.
Dialogue: 0,0:16:36.49,0:16:39.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Makan sepanci bersama itu tanda kekompakan."
Dialogue: 0,0:16:39.54,0:16:40.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu?
Dialogue: 0,0:16:40.66,0:16:42.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:16:44.00,0:16:47.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ada yang jorok di pancinya?
Dialogue: 0,0:16:47.42,0:16:50.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus ikut sakit perut juga?
Dialogue: 0,0:16:51.26,0:16:52.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan dia?
Dialogue: 0,0:16:52.88,0:16:54.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku sudah berbaik hati mengajaknya.
Dialogue: 0,0:16:54.64,0:16:56.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melissa, tenanglah.
Dialogue: 0,0:16:56.35,0:17:00.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang. Dia penyendiri.
Dialogue: 0,0:17:00.14,0:17:03.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Biarkan saja dia.\N- Sulit dipercaya.
Dialogue: 0,0:17:03.56,0:17:05.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Margaret.
Dialogue: 0,0:17:05.15,0:17:08.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hati-hati, nanti tidak ada yang akan\Nmembantumu saat waktunya tiba.
Dialogue: 0,0:17:12.65,0:17:15.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily, ini ironis.
Dialogue: 0,0:17:15.49,0:17:19.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menjalani hidup hanya dengan\Nmemikirkan cara membunuhmu.
Dialogue: 0,0:17:19.24,0:17:23.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi sekarang, aku orang tak berperasaan\Nyang meninggalkan temannya, sama sepertimu.
Dialogue: 0,0:17:36.64,0:17:37.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:17:37.85,0:17:39.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meskipun aku bersenjata lengkap...
Dialogue: 0,0:17:42.85,0:17:43.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily.
Dialogue: 0,0:17:44.31,0:17:46.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Margaret!
Dialogue: 0,0:18:04.58,0:18:06.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin.
Dialogue: 0,0:18:22.64,0:18:27.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lawan yang bahkan tak bisa dikalahkan Lily,\Npetualang peringkat S...
Dialogue: 0,0:18:28.02,0:18:31.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seseorang yang cukup kuat\Nuntuk membunuh semua rekannya.
Dialogue: 0,0:18:33.11,0:18:35.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lawan macam apa itu?
Dialogue: 0,0:18:35.65,0:18:38.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seberbahaya apa pun itu,\NLily akan tetap ke sana.
Dialogue: 0,0:18:38.99,0:18:40.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika Lily pergi,
Dialogue: 0,0:18:40.49,0:18:42.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Margaret akan mengikutinya, 'kan?
Dialogue: 0,0:18:43.12,0:18:44.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,
Dialogue: 0,0:18:44.66,0:18:46.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}skenario terburuknya adalah...
Dialogue: 0,0:18:51.46,0:18:54.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang bisa kulakukan agar\Nsemua kembali dengan selamat?
Dialogue: 0,0:18:57.51,0:18:59.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada orang di dekat sini?
Dialogue: 0,0:19:13.44,0:19:14.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu Rein?
Dialogue: 0,0:19:15.65,0:19:19.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, dan ada orang lain.
Dialogue: 0,0:19:25.83,0:19:28.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat pagi, Lily.
Dialogue: 0,0:19:28.66,0:19:30.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat pagi, Margaret.
Dialogue: 0,0:19:30.75,0:19:34.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rein ingin rapat sebelum kita pergi.
Dialogue: 0,0:19:34.25,0:19:35.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:19:35.21,0:19:38.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuharap kau tidak menjadikan\Nrumahku tempat rapat.
Dialogue: 0,0:19:38.88,0:19:40.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi silakan masuk.
Dialogue: 0,0:19:41.30,0:19:42.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf mengganggu.
Dialogue: 0,0:19:44.81,0:19:47.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan duduk dan tunggu di sana.
Dialogue: 0,0:19:51.98,0:19:53.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kepalanya...
Dialogue: 0,0:19:55.57,0:19:57.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat ingin memenggal kepalanya.
Dialogue: 0,0:19:58.65,0:20:01.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin menggorok lehernya sekarang.
Dialogue: 0,0:20:02.74,0:20:04.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:20:06.74,0:20:07.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum.
Dialogue: 0,0:20:09.12,0:20:10.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini belum waktunya.
Dialogue: 0,0:20:16.46,0:20:18.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini, silakan ambil sendiri.
Dialogue: 0,0:20:19.51,0:20:21.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Margaret.
Dialogue: 0,0:20:22.01,0:20:23.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama-sama.
Dialogue: 0,0:20:24.14,0:20:25.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu kita tiba di sana,
Dialogue: 0,0:20:25.55,0:20:29.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan kubongkar kebusukannya yang kabur\Nmeninggalkan kakakku, lalu kubunuh dia.
Dialogue: 0,0:20:31.02,0:20:33.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily! Margaret!
Dialogue: 0,0:20:33.60,0:20:34.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cool...
Dialogue: 0,0:20:34.81,0:20:35.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dragon!
Dialogue: 0,0:20:36.36,0:20:37.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cool Dragon!
Dialogue: 0,0:20:40.15,0:20:41.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf membuat kalian menunggu.
Dialogue: 0,0:20:46.53,0:20:50.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dulu aku menjalani hari dengan main-main\Ndan hidup tanpa tujuan.
Dialogue: 0,0:20:50.37,0:20:53.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku selalu lari dari kenyataan hidupku.
Dialogue: 0,0:20:53.25,0:20:54.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi sekarang aku sudah sadar.
Dialogue: 0,0:20:55.00,0:20:57.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai hari ini, aku akan hidup dengan serius.
Dialogue: 0,0:20:57.50,0:21:00.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kau serius sekarang?
Dialogue: 0,0:21:00.17,0:21:01.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rein.
Dialogue: 0,0:21:01.30,0:21:03.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kapan tepatnya kau menyadari ini?
Dialogue: 0,0:21:04.30,0:21:05.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semalam.
Dialogue: 0,0:21:05.47,0:21:07.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa dia agak bodoh?
Dialogue: 0,0:21:09.10,0:21:11.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rein, baju zirah itu...
Dialogue: 0,0:21:11.77,0:21:13.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian sadar, ya?
Dialogue: 0,0:21:13.35,0:21:14.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa juga yang tidak sadar?
Dialogue: 0,0:21:14.60,0:21:17.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku masih punya sisa imbalan\Ndari pembasmian naga kemarin,
Dialogue: 0,0:21:17.94,0:21:19.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi aku membeli baju zirah ini.
Dialogue: 0,0:21:20.07,0:21:23.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa terus memakai pakaian biasa.
Dialogue: 0,0:21:23.28,0:21:25.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang aku bisa merasa aman\Nke mana pun kita pergi.
Dialogue: 0,0:21:25.78,0:21:26.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu...
Dialogue: 0,0:21:26.78,0:21:29.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penipuan oleh pedagang mencurigakan
Dialogue: 0,0:21:29.45,0:21:31.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang mengincar petualang pemula.
Dialogue: 0,0:21:31.95,0:21:33.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bilang terang-terangan.
Dialogue: 0,0:21:34.96,0:21:36.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma keren di tampilan.
Dialogue: 0,0:21:36.50,0:21:38.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fungsinya nyaris nol.
Dialogue: 0,0:21:38.34,0:21:41.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bahkan lebih buruk karena\Nmenghalangi gerakanmu. Itu sampah.
Dialogue: 0,0:21:42.01,0:21:42.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum lagi,
Dialogue: 0,0:21:42.92,0:21:45.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tulisan Cool Dragon yang paling parah.
Dialogue: 0,0:21:46.26,0:21:48.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau harus lebih berhati-hati.
Dialogue: 0,0:21:48.60,0:21:51.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak orang jahat di dunia petualang.
Dialogue: 0,0:21:54.27,0:21:56.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu kau ingin serius, tapi...
Dialogue: 0,0:21:57.44,0:21:59.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata kau hanya orang bodoh.
Dialogue: 0,0:22:08.95,0:22:10.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cool...
