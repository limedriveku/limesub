Dialogue: 0,0:00:00.00,0:00:02.46,sign,,0000,0000,0000,,PACHINKO
Dialogue: 0,0:00:25.69,0:00:28.19,sign,,0000,0000,0000,,DESA PEMBUNUH\NJASA PEMBUNUHAN PROFESIONAL
Dialogue: 0,0:00:57.93,0:01:00.56,sign,,0000,0000,0000,,THE LAID-OFF CHEAT-GRANTING MAGE\NENJOYS A SECOND LEASE ON LIFE
Dialogue: 0,0:02:41.66,0:02:43.83,sign,,0000,0000,0000,,"LARI"
Dialogue: 0,0:02:46.83,0:02:48.71,sign,,0000,0000,0000,,"LARI"
Dialogue: 0,0:02:59.63,0:03:01.22,sign,,0000,0000,0000,,EP. 07 AKU BELUM PERNAH KE TOKO ROTI ITU,
Dialogue: 0,0:03:01.30,0:03:02.93,sign,,0000,0000,0000,,JADI KUMANFAATKAN KESEMPATAN INI\NUNTUK MAKAN ROTI MELON
Dialogue: 0,0:03:03.01,0:03:04.60,sign,,0000,0000,0000,,SAMBIL SEKALIAN MENGAJAK\NANJING JALAN-JALAN, GUK!
Dialogue: 0,0:03:04.68,0:03:08.02,sign,,0000,0000,0000,,PUYO PET LIFE
Dialogue: 0,0:03:41.55,0:03:43.64,sign,,0000,0000,0000,,"TARING RAJA BINATANG"
Dialogue: 0,0:04:34.14,0:04:36.65,sign,,0000,0000,0000,,"PERISAI KAISAR"
Dialogue: 0,0:04:54.25,0:04:55.08,sign,,0000,0000,0000,,CEO!
Dialogue: 0,0:05:02.80,0:05:03.97,sign,,0000,0000,0000,,KOMAT-KAMIT...
Dialogue: 0,0:05:06.26,0:05:07.43,sign,,0000,0000,0000,,"MARGARET"
Dialogue: 0,0:05:10.85,0:05:12.14,sign,,0000,0000,0000,,"KOMAT-KAMIT..."
Dialogue: 0,0:05:13.52,0:05:15.10,sign,,0000,0000,0000,,"KOMAT-KAMIT..."
Dialogue: 0,0:05:25.24,0:05:26.28,sign,,0000,0000,0000,,RUANG GUILD MASTER
Dialogue: 0,0:08:30.21,0:08:32.41,sign,,0000,0000,0000,,PEGANG, PUKUL
Dialogue: 0,0:08:42.85,0:08:44.73,sign,,0000,0000,0000,,TERENGAH-ENGAH...
Dialogue: 0,0:08:44.81,0:08:47.06,sign,,0000,0000,0000,,"BARRI..."
Dialogue: 0,0:15:32.97,0:15:34.14,sign,,0000,0000,0000,,TERSEDU-SEDU
Dialogue: 0,0:15:42.52,0:15:44.48,sign,,0000,0000,0000,,KOBEYA KITCHEN
Dialogue: 0,0:16:05.59,0:16:06.63,sign,,0000,0000,0000,,BUSUR ELF
Dialogue: 0,0:16:09.59,0:16:11.38,sign,,0000,0000,0000,,BAR BUSUR ELF
Dialogue: 0,0:16:13.76,0:16:14.97,sign,,0000,0000,0000,,"BANYAK PILIHAN, KESERUAN TANPA BATAS"
Dialogue: 0,0:16:15.05,0:16:15.93,sign,,0000,0000,0000,,"BAR BUSUR ELF"
Dialogue: 0,0:16:16.01,0:16:18.93,sign,,0000,0000,0000,,"BAR BUSUR ELF"
Dialogue: 0,0:16:30.11,0:16:30.94,sign,,0000,0000,0000,,TERENGAH-ENGAH, LARI
Dialogue: 0,0:16:38.28,0:16:39.79,sign,,0000,0000,0000,,"AHHH..."
Dialogue: 0,0:19:09.94,0:19:13.23,sign,,0000,0000,0000,,IZAKAYA ODEN, LEZAT!
Dialogue: 0,0:00:02.79,0:00:04.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisakah kita bertemu di tempat lain saja?
Dialogue: 0,0:00:04.71,0:00:05.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berisik sekali.
Dialogue: 0,0:00:06.50,0:00:08.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan aku benci pachinko.
Dialogue: 0,0:00:09.05,0:00:11.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu karena kau melarangku pergi\Nke Kristal Biru.
Dialogue: 0,0:00:11.80,0:00:13.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sebabnya kita bertemu di sini.
Dialogue: 0,0:00:13.55,0:00:15.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar. Maafkan aku.
Dialogue: 0,0:00:16.80,0:00:19.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau belum melupakan janji kita, 'kan?
Dialogue: 0,0:00:32.63,0:00:35.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau kembali! Aku sudah menunggu!
Dialogue: 0,0:00:35.66,0:00:38.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Mirabelle...\N- Selamat datang kembali...
Dialogue: 0,0:02:15.71,0:02:19.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang kita semua berhasil kembali\Nke kota dengan selamat.
Dialogue: 0,0:02:19.59,0:02:21.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Margaret, apa rencanamu sekarang?
Dialogue: 0,0:02:21.68,0:02:25.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menjemput anjingku\Ndari tempat penitipan hewan, lalu pulang.
Dialogue: 0,0:02:25.52,0:02:28.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau harus mampir\Nke Kristal Biru kapan-kapan.
Dialogue: 0,0:02:28.69,0:02:30.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau tak bergabung saja dengan kami?
Dialogue: 0,0:02:30.60,0:02:33.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik... Aku akan mempertimbangkannya.
Dialogue: 0,0:02:33.86,0:02:35.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, ayo pergi ke sana sekarang...
Dialogue: 0,0:02:35.48,0:02:38.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku harus\Nke tempat penitipan hewan dulu.
Dialogue: 0,0:02:38.86,0:02:39.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi!
Dialogue: 0,0:02:39.78,0:02:41.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bisa berkunjung sebentar saja!
Dialogue: 0,0:02:41.66,0:02:43.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anjingku... Anjingku menungguku!
Dialogue: 0,0:02:43.91,0:02:45.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Datanglah segera setelah kau mengambilnya!
Dialogue: 0,0:02:45.91,0:02:46.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau penguntit?
Dialogue: 0,0:02:46.83,0:02:48.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guild-mu nanti dikotori anjingku!
Dialogue: 0,0:02:48.79,0:02:51.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak ada yang akan keberatan jika kotor!
Dialogue: 0,0:02:51.21,0:02:52.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, tempat itu sangat berantakan!
Dialogue: 0,0:02:52.33,0:02:53.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, dasar berengsek!
Dialogue: 0,0:02:53.25,0:02:55.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku perlu mengambil anjingku!
Dialogue: 0,0:02:55.25,0:02:56.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anjingku!
Dialogue: 0,0:02:57.05,0:02:59.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Margaret!
Dialogue: 0,0:03:08.81,0:03:12.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak ingin terlalu dekat\Ndengan siapa pun,
Dialogue: 0,0:03:12.35,0:03:14.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi mereka mengundangku.
Dialogue: 0,0:03:15.94,0:03:17.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dipikir-pikir,
Dialogue: 0,0:03:17.65,0:03:21.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kurasa aku belum pernah memanggil namamu.
Dialogue: 0,0:03:22.32,0:03:25.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo pulang, Biji Ek.
Dialogue: 0,0:03:27.70,0:03:29.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan, Biji Ek.
Dialogue: 0,0:03:29.70,0:03:31.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bukan kakakmu!
Dialogue: 0,0:03:32.92,0:03:35.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bicara terlalu sopan\Nmembuat kita terasa jauh.
Dialogue: 0,0:03:38.26,0:03:39.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo lari, Biji Ek!
Dialogue: 0,0:03:41.55,0:03:43.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku punya pengumuman penting.
Dialogue: 0,0:03:44.30,0:03:47.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rencana yang dipimpin oleh Glenda\Ndibatalkan.
Dialogue: 0,0:03:47.14,0:03:49.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akan minta maaf kepada Rein\Ndan memintanya kembali...
Dialogue: 0,0:03:50.52,0:03:51.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Barrius, dasar berengsek!
Dialogue: 0,0:03:51.94,0:03:55.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sendiri yang menyuruh anak buahku\Nmenjalankan rencana itu!
Dialogue: 0,0:03:55.31,0:03:58.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beraninya kau meremehkan kami,\Ndasar botak berengsek!
Dialogue: 0,0:03:58.90,0:03:59.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:03:59.82,0:04:01.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Jangan bilang "apa", Bodoh!\N- Aduh!
Dialogue: 0,0:04:01.53,0:04:04.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kepalamu benar-benar kosong,\NBotak Berengsek?
Dialogue: 0,0:04:04.95,0:04:08.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pikir tidak ada yang akan membunuhmu\Nhanya karena kau Guild Master?
Dialogue: 0,0:04:08.74,0:04:10.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau cari tahu?
Dialogue: 0,0:04:12.25,0:04:16.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar pengecut!\NKau bahkan tidak bisa membantah?
Dialogue: 0,0:04:16.29,0:04:16.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar pengecut!\NKau bahkan tidak bisa membantah?\NSelamat tinggal, Barrius.
Dialogue: 0,0:04:16.70,0:04:18.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat tinggal, Barrius.
Dialogue: 0,0:04:18.50,0:04:21.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan tinggalkan rambutmu di lantai.
Dialogue: 0,0:04:21.38,0:04:23.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bukan salon!
Dialogue: 0,0:04:26.51,0:04:28.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial... Aku tak pernah mengira...
Dialogue: 0,0:04:28.14,0:04:30.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak pernah mengira\Nhanya dengan memecat si bodoh itu...
Dialogue: 0,0:04:30.81,0:04:32.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}keadaan akan menjadi seperti ini.
Dialogue: 0,0:04:32.56,0:04:33.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:04:34.14,0:04:36.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jayalah Guild Perisai Kaisar!
Dialogue: 0,0:04:36.73,0:04:38.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita...
Dialogue: 0,0:04:38.15,0:04:41.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hidup setiap hari demi petualangan!
Dialogue: 0,0:04:41.28,0:04:43.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa bertualang setiap hari adalah berkah!
Dialogue: 0,0:04:44.24,0:04:45.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersyukurlah atas petualangan!
Dialogue: 0,0:04:46.07,0:04:49.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membuka jalan untuk petualangan\Nadalah petualangan itu sendiri!
Dialogue: 0,0:04:49.99,0:04:52.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Margaret, berteriaklah lebih keras!
Dialogue: 0,0:04:52.29,0:04:54.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak bisa mendengar satu suara pun!
Dialogue: 0,0:04:55.17,0:04:57.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku membacakan peraturan guild\Nlebih serius daripada siapa pun.
Dialogue: 0,0:04:58.00,0:04:59.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Panggil aku Guild Master.
Dialogue: 0,0:04:59.96,0:05:02.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu baca bagian selanjutnya sendiri.
Dialogue: 0,0:05:04.05,0:05:06.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga cuma bibirmu yang bergerak.
Dialogue: 0,0:05:06.26,0:05:07.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Margaret.
Dialogue: 0,0:05:07.51,0:05:10.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang sepertimu yang merusak organisasi.
Dialogue: 0,0:05:10.85,0:05:12.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku.
Dialogue: 0,0:05:12.22,0:05:13.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau meremehkanku?
Dialogue: 0,0:05:13.52,0:05:15.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:05:15.19,0:05:16.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, aku meremehkanmu.
Dialogue: 0,0:05:16.60,0:05:18.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu kau meremehkanku.
Dialogue: 0,0:05:18.23,0:05:19.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau mau melakukan itu,
Dialogue: 0,0:05:19.19,0:05:21.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau harus bilang "Aku tak meremehkanmu"\Nsecara langsung!
Dialogue: 0,0:05:21.44,0:05:23.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masuk akal. Aku jadi belajar sesuatu.
Dialogue: 0,0:05:23.44,0:05:25.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tak perlu belajar itu!
Dialogue: 0,0:05:26.36,0:05:27.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar kau mengambil cuti.
Dialogue: 0,0:05:27.61,0:05:30.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pergi ke mana\Ndengan orang-orang Kristal Biru itu?
Dialogue: 0,0:05:30.45,0:05:32.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guam enak. Dekat pula.
Dialogue: 0,0:05:33.20,0:05:36.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bilang kau ingin bergabung\Ndengan Kristal Biru?
Dialogue: 0,0:05:37.00,0:05:40.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi sayangnya, Margaret Els...
Dialogue: 0,0:05:40.79,0:05:42.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang disayangkan?
Dialogue: 0,0:05:43.00,0:05:44.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guild itu...
Dialogue: 0,0:05:45.17,0:05:47.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sudah tamat.
Dialogue: 0,0:05:49.89,0:05:52.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak ada siapa pun di sini.\NApa yang terjadi?
Dialogue: 0,0:05:53.06,0:05:56.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elsie! Nina!
Dialogue: 0,0:05:57.23,0:05:58.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Margaret!
Dialogue: 0,0:05:58.44,0:06:00.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau datang untuk menemui kami?
Dialogue: 0,0:06:00.48,0:06:02.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya mengajak anjingku\Njalan-jalan di dekat sini.
Dialogue: 0,0:06:03.02,0:06:04.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia manis sekali!
Dialogue: 0,0:06:04.36,0:06:07.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah dia makin manis\Nsejak kali terakhir kau melihatnya?
Dialogue: 0,0:06:07.24,0:06:09.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia anjing kesayangan kakakku.
Dialogue: 0,0:06:09.74,0:06:11.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang aku sudah tidak bicara sopan\Nlagi padanya.
Dialogue: 0,0:06:12.70,0:06:14.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kalian berdua akhirnya akrab juga.
Dialogue: 0,0:06:14.37,0:06:15.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luar biasa.
Dialogue: 0,0:06:20.75,0:06:22.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau... Kau...
Dialogue: 0,0:06:22.46,0:06:23.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Barrius.
Dialogue: 0,0:06:24.05,0:06:24.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rein.
Dialogue: 0,0:06:25.21,0:06:27.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku di sini hari ini\Nkarena ada urusan denganmu.
Dialogue: 0,0:06:27.34,0:06:29.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada urusan apa lagi sekarang?
Dialogue: 0,0:06:29.34,0:06:30.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya aku akan mengganggu\Njika tetap di sini.
Dialogue: 0,0:06:31.01,0:06:32.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan pergi.
Dialogue: 0,0:06:32.68,0:06:33.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:06:33.85,0:06:35.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tak perlu pergi, Margaret.
Dialogue: 0,0:06:37.48,0:06:38.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:06:39.85,0:06:40.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon.
Dialogue: 0,0:06:40.98,0:06:42.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kembalilah ke Taring Raja Binatang!
Dialogue: 0,0:06:44.44,0:06:45.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika terus begini,
Dialogue: 0,0:06:45.48,0:06:48.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taring Raja Binatang pasti akan runtuh.
Dialogue: 0,0:06:48.24,0:06:49.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk membangun kembali guild,
Dialogue: 0,0:06:49.78,0:06:51.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}penyihir pengimbuh yang hebat\Nsangat dibutuhkan.
Dialogue: 0,0:06:51.74,0:06:54.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami butuh kekuatanmu!
Dialogue: 0,0:06:54.70,0:06:57.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guild itu segalanya bagiku.
Dialogue: 0,0:06:58.00,0:06:59.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi Taring Raja Binatang,
Dialogue: 0,0:06:59.71,0:07:01.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku bersedia mengorbankan hidupku.
Dialogue: 0,0:07:02.04,0:07:03.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kumohon!
Dialogue: 0,0:07:03.46,0:07:04.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kembalilah!
Dialogue: 0,0:07:04.96,0:07:06.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu kenapa kau memecatku?
Dialogue: 0,0:07:09.72,0:07:13.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku curhat ke teman di kedai,
Dialogue: 0,0:07:14.14,0:07:15.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu terbawa suasana...
Dialogue: 0,0:07:16.85,0:07:19.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau memecatku begitu saja?
Dialogue: 0,0:07:19.98,0:07:21.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudmu "terbawa suasana"?
Dialogue: 0,0:07:22.06,0:07:24.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu alasan yang konyol!
Dialogue: 0,0:07:24.15,0:07:26.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bukan sepenuhnya salahku.
Dialogue: 0,0:07:27.11,0:07:28.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily, Margaret.
Dialogue: 0,0:07:28.65,0:07:31.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian juga pernah ingin mengusirnya, 'kan?
Dialogue: 0,0:07:31.86,0:07:34.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian pasti sudah sadar\Nbetapa menyebalkannya orang ini.
Dialogue: 0,0:07:34.74,0:07:38.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudmu? Tidak mungkin!
Dialogue: 0,0:07:45.38,0:07:49.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku tidak mengerti maksud Barrius.
Dialogue: 0,0:07:49.59,0:07:52.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga tidak mengerti. Maaf.
Dialogue: 0,0:07:54.47,0:07:55.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian serius?
Dialogue: 0,0:07:55.76,0:07:57.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian tidak kesal melihat wajah ini?
Dialogue: 0,0:07:57.51,0:07:59.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian tidak mau memukulnya?
Dialogue: 0,0:07:59.27,0:08:02.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belum pernah marah sekali pun\Ndalam hidupku.
Dialogue: 0,0:08:02.60,0:08:06.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin memukul semua manusia\Nyang kulihat, tapi Rein pengecualian.
Dialogue: 0,0:08:06.98,0:08:11.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awalnya, Rein memang serius,\Njadi tidak menyebalkan.
Dialogue: 0,0:08:11.11,0:08:13.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi seiring berjalannya waktu,
Dialogue: 0,0:08:13.15,0:08:15.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalian sudah muak dengannya, 'kan?
Dialogue: 0,0:08:17.70,0:08:20.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku tidak mengerti pertanyaanmu.
Dialogue: 0,0:08:20.79,0:08:24.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memikirkan hal lain. Maafkan aku.
Dialogue: 0,0:08:24.17,0:08:25.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayolah, kalian berdua.
Dialogue: 0,0:08:26.00,0:08:27.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita sedang membicarakan hal penting!
Dialogue: 0,0:08:27.67,0:08:30.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisakah kalian memperhatikan?
Dialogue: 0,0:08:32.58,0:08:34.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku begini justru karena mendengarkanmu!
Dialogue: 0,0:08:34.58,0:08:35.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jelas sekali!
Dialogue: 0,0:08:35.89,0:08:38.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanpa perlu disimak baik-baik pun,\Nbanyak yang bikin kesal!
Dialogue: 0,0:08:44.81,0:08:47.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Barri... Barrius...
Dialogue: 0,0:08:47.15,0:08:48.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Barri... Barrius...
Dialogue: 0,0:08:48.69,0:08:51.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan kembali\Nke Taring Raja Binatang.
Dialogue: 0,0:08:51.19,0:08:54.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan bersama Kristal Biru selamanya.
Dialogue: 0,0:08:54.78,0:08:56.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyenangkan bersama semua orang.
Dialogue: 0,0:08:56.70,0:08:58.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka semua rekan yang luar biasa.
Dialogue: 0,0:08:58.70,0:09:01.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami saling mendukung\Nsaat seseorang dalam masalah.
Dialogue: 0,0:09:01.66,0:09:04.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin menjadi petualang\Nseperti itu di sini.
Dialogue: 0,0:09:04.87,0:09:06.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, Rein.
Dialogue: 0,0:09:06.17,0:09:07.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana dengan Taring Raja Binatang?
Dialogue: 0,0:09:07.08,0:09:09.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyerah saja, Barrius.
Dialogue: 0,0:09:09.71,0:09:14.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyihir pemberi cheat yang dipecat\Nmenikmati kehidupan keduanya yang bebas.
Dialogue: 0,0:09:14.84,0:09:16.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu saja.
Dialogue: 0,0:09:17.05,0:09:18.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Bukan hanya senjata,
Dialogue: 0,0:09:18.60,0:09:21.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku bisa mengimbuhkan poin cheat ke apa pun,
Dialogue: 0,0:09:21.31,0:09:23.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu mencabutnya sesukaku.
Dialogue: 0,0:09:23.81,0:09:25.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian yang lain baik-baik saja?"
Dialogue: 0,0:09:25.81,0:09:27.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu yang dikatakan Rein.
Dialogue: 0,0:09:28.90,0:09:30.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan ini?\NAku tidak pernah bilang begitu!
Dialogue: 0,0:09:36.95,0:09:37.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:09:39.20,0:09:41.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya Rein bukan hanya menemukan\Ntempat yang cocok,
Dialogue: 0,0:09:41.28,0:09:43.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi juga rekan yang sehati.
Dialogue: 0,0:09:44.79,0:09:46.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah memutuskan.
Dialogue: 0,0:09:46.66,0:09:48.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan membubarkan Taring Raja Binatang.
Dialogue: 0,0:09:49.00,0:09:51.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rein, maaf sudah mengusirmu saat itu.
Dialogue: 0,0:09:52.80,0:09:55.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti.\NAku tidak akan dendam kepadamu.
Dialogue: 0,0:09:57.38,0:09:58.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku pergi, Rein.
Dialogue: 0,0:09:59.59,0:10:01.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hargai rekan-rekanmu.
Dialogue: 0,0:10:04.10,0:10:07.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guild itu sudah tamat.
Dialogue: 0,0:10:07.77,0:10:10.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka terlilit utang dan hampir bangkrut.
Dialogue: 0,0:10:11.90,0:10:13.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau juga senang?
Dialogue: 0,0:10:13.73,0:10:15.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa Biji Ek ikut senang?
Dialogue: 0,0:10:15.90,0:10:18.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini... Aku ingin menanyakan sesuatu.
Dialogue: 0,0:10:19.03,0:10:23.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar Kristal Biru\Npunya utang besar dan akan bangkrut.
Dialogue: 0,0:10:25.04,0:10:26.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tahu soal itu?
Dialogue: 0,0:10:26.16,0:10:27.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana aku tahu?
Dialogue: 0,0:10:28.21,0:10:29.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:10:29.75,0:10:31.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Utang apa itu?\N- Kau tidak mau memberitahuku?
Dialogue: 0,0:10:31.38,0:10:32.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entahlah.
Dialogue: 0,0:10:32.29,0:10:33.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Berapa jumlahnya?\N- Kurasa begitu.
Dialogue: 0,0:10:33.96,0:10:34.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Entahlah.\N- Kurasa begitu.
Dialogue: 0,0:10:34.88,0:10:36.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa mereka berutang?
Dialogue: 0,0:10:36.09,0:10:37.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Entahlah.\N- Lagi pula...
Dialogue: 0,0:10:37.51,0:10:38.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Utang apa?\N- aku bukan salah satu anggotamu.
Dialogue: 0,0:10:39.01,0:10:39.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Entahlah.\N- aku bukan salah satu anggotamu.
Dialogue: 0,0:10:39.93,0:10:40.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berapa utang mereka?
Dialogue: 0,0:10:41.01,0:10:42.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Entahlah.\N- Biji Ek.
Dialogue: 0,0:10:42.39,0:10:43.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo pulang.
Dialogue: 0,0:10:43.35,0:10:44.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah mau pergi?
Dialogue: 0,0:10:45.35,0:10:46.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau tidak menjaga sikap,
Dialogue: 0,0:10:46.89,0:10:48.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan bicara sopan lagi padamu.
Dialogue: 0,0:10:53.94,0:10:54.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Datanglah lagi.
Dialogue: 0,0:10:54.98,0:10:56.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau selalu diterima.
Dialogue: 0,0:10:57.28,0:10:58.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, sampai nanti.
Dialogue: 0,0:11:09.79,0:11:11.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Utang?
Dialogue: 0,0:11:11.29,0:11:12.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Utang apa?
Dialogue: 0,0:11:12.71,0:11:14.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudmu?
Dialogue: 0,0:11:14.71,0:11:16.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga tidak ada hal seperti itu.
Dialogue: 0,0:11:16.84,0:11:20.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga, rupanya itu yang kau cemaskan.
Dialogue: 0,0:11:20.26,0:11:21.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong,
Dialogue: 0,0:11:21.18,0:11:23.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau mengalahkan Naga Bercahaya, 'kan?
Dialogue: 0,0:11:23.14,0:11:26.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peringkat petualangmu pasti naik.
Dialogue: 0,0:11:26.68,0:11:29.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh! Sakit!
Dialogue: 0,0:11:30.60,0:11:31.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu Naga Bercahaya.
Dialogue: 0,0:11:32.10,0:11:33.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa dia menirunya?
Dialogue: 0,0:11:35.77,0:11:37.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya... terima kasih.
Dialogue: 0,0:11:38.36,0:11:39.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa berterima kasih kepada kami?
Dialogue: 0,0:11:40.36,0:11:45.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebelum datang ke sini,\Nupah per jamku 980 yen.
Dialogue: 0,0:11:45.33,0:11:47.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meskipun pekerjaannya memuaskan, aku diusir.
Dialogue: 0,0:11:49.75,0:11:51.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku sudah sampai di sini.
Dialogue: 0,0:11:52.08,0:11:53.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika tidak bergabung dengan guild ini,
Dialogue: 0,0:11:53.79,0:11:56.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tidak akan bertemu kalian semua.
Dialogue: 0,0:11:56.34,0:11:59.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan aku tidak akan pernah bertualang\Nmelawan Naga Bercahaya.
Dialogue: 0,0:11:59.88,0:12:02.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat senang mendengarnya.
Dialogue: 0,0:12:02.30,0:12:04.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau ingin aku bicara lagi?
Dialogue: 0,0:12:04.34,0:12:06.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, silakan!
Dialogue: 0,0:12:06.18,0:12:10.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama-tama... Begini...
Dialogue: 0,0:12:10.89,0:12:12.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak terpikir apa-apa lagi!
Dialogue: 0,0:12:17.36,0:12:19.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elsie, Nina.
Dialogue: 0,0:12:21.61,0:12:23.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga ingin berterima kasih.
Dialogue: 0,0:12:24.70,0:12:29.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika bukan karena kalian, aku mungkin\Nsudah menyerah menjadi petualang.
Dialogue: 0,0:12:30.75,0:12:34.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah mendukungku\Nsampai aku bisa berdiri sendiri lagi.
Dialogue: 0,0:12:35.29,0:12:37.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah kau bisa bertahan.
Dialogue: 0,0:12:37.34,0:12:40.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami senang melihatmu\Nmemulai awal yang baru.
Dialogue: 0,0:12:40.88,0:12:42.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily...
Dialogue: 0,0:12:42.67,0:12:44.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana denganku?
Dialogue: 0,0:12:44.13,0:12:45.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu dia!
Dialogue: 0,0:12:45.34,0:12:47.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah yang salah denganmu!
Dialogue: 0,0:12:47.51,0:12:48.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:12:49.14,0:12:51.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kurasa aku muak dengan ini.
Dialogue: 0,0:12:51.14,0:12:53.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Muak? Muak dengan apa?
Dialogue: 0,0:12:53.69,0:12:55.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Merepotkan sekali.
Dialogue: 0,0:12:55.65,0:12:59.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejujurnya, aku tidak terlalu peduli\Ndengan petualangan orang lain.
Dialogue: 0,0:13:00.15,0:13:01.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Semuanya.
Dialogue: 0,0:13:02.03,0:13:06.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu mengatakan ini membuatku\Ntidak pantas menjadi Guild Master.
Dialogue: 0,0:13:08.20,0:13:11.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guild ini sudah tamat. Kububarkan.
Dialogue: 0,0:13:11.70,0:13:12.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dib...
Dialogue: 0,0:13:12.62,0:13:15.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dibubarkan? Apa maksudmu?
Dialogue: 0,0:13:15.16,0:13:18.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Artinya, guild petualang Kristal Biru\Ntidak akan ada lagi.
Dialogue: 0,0:13:19.13,0:13:22.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, Master, bagaimana dengan kami?
Dialogue: 0,0:13:22.30,0:13:24.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bergabung saja dengan guild lain.
Dialogue: 0,0:13:24.84,0:13:28.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada banyak guild yang lebih baik\Ndaripada tempat sampah ini.
Dialogue: 0,0:13:28.26,0:13:30.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pergilah ke salah satunya.
Dialogue: 0,0:13:30.47,0:13:32.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa?
Dialogue: 0,0:13:32.31,0:13:34.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksud "muak" dan "tempat sampah" ini?
Dialogue: 0,0:13:34.48,0:13:35.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kau katakan?
Dialogue: 0,0:13:35.81,0:13:38.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sebabnya aku minta maaf duluan.
Dialogue: 0,0:13:40.69,0:13:41.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily!
Dialogue: 0,0:13:41.65,0:13:43.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau ke mana?
Dialogue: 0,0:13:50.03,0:13:53.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedang apa kau di tempat seperti ini?
Dialogue: 0,0:13:53.16,0:13:54.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Margaret.
Dialogue: 0,0:13:55.58,0:13:57.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau akan bergabung dengan Kristal Biru?
Dialogue: 0,0:13:57.83,0:13:59.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin.
Dialogue: 0,0:13:59.58,0:14:02.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka bahkan tidak menganggapku\Nsebagai salah satu dari mereka.
Dialogue: 0,0:14:02.63,0:14:05.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka tidak mau menjawab pertanyaanku.
Dialogue: 0,0:14:05.13,0:14:09.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya karena orang akur,\Nbukan berarti mereka bisa menjadi rekan.
Dialogue: 0,0:14:09.64,0:14:11.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak tahu apa yang terjadi,
Dialogue: 0,0:14:11.47,0:14:13.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi mungkin tidak seperti\Nyang kau pikirkan.
Dialogue: 0,0:14:15.27,0:14:19.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jarak antarmanusia
Dialogue: 0,0:14:19.15,0:14:21.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sering kali muncul karena salah paham kecil\Natau kurang komunikasi.
Dialogue: 0,0:14:23.61,0:14:26.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, kau hanya takut, 'kan?
Dialogue: 0,0:14:26.99,0:14:30.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takut akan ditolak jika meminta bergabung.
Dialogue: 0,0:14:30.28,0:14:32.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takut mereka tidak akan menerimamu.
Dialogue: 0,0:14:33.12,0:14:37.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memilih kabur dan menjalani hidup stagnan\Nselalu menjadi jalan yang lebih mudah.
Dialogue: 0,0:14:37.46,0:14:40.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kau tetap harus berani dan mencoba.
Dialogue: 0,0:14:41.75,0:14:42.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sendiri juga begitu.
Dialogue: 0,0:14:42.88,0:14:45.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya berpegang\Npada Taring Raja Binatang.
Dialogue: 0,0:14:47.30,0:14:51.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau harus bergabung dengan Kristal Biru.
Dialogue: 0,0:14:53.10,0:14:56.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga berhasil. Aku akan mendukungmu.
Dialogue: 0,0:15:06.61,0:15:08.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menemukanmu, Lily.
Dialogue: 0,0:15:10.24,0:15:11.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily...
Dialogue: 0,0:15:19.04,0:15:19.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei,
Dialogue: 0,0:15:20.04,0:15:21.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mau sampai kapan kita begini?
Dialogue: 0,0:15:21.79,0:15:24.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau bosan, kenapa tidak pulang saja?
Dialogue: 0,0:15:38.39,0:15:41.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily, aku membeli roti.
Dialogue: 0,0:15:49.49,0:15:50.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia benar-benar memakannya.
Dialogue: 0,0:15:50.40,0:15:51.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maumu?
Dialogue: 0,0:15:51.32,0:15:54.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi, apa kalian petualang?
Dialogue: 0,0:15:54.95,0:15:59.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Guild Master Busur Elf.
Dialogue: 0,0:15:59.29,0:16:00.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namaku Mia.
Dialogue: 0,0:16:01.21,0:16:04.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian mau bergabung dengan Busur Elf?
Dialogue: 0,0:16:06.71,0:16:09.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini Busur Elf.
Dialogue: 0,0:16:11.80,0:16:13.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus sekali. Tidak buruk sama sekali.
Dialogue: 0,0:16:13.76,0:16:14.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily?
Dialogue: 0,0:16:15.05,0:16:15.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami yakin
Dialogue: 0,0:16:16.01,0:16:18.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}layanan kami tak ada duanya.
Dialogue: 0,0:16:19.02,0:16:19.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily!
Dialogue: 0,0:16:22.02,0:16:25.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain ruang santai dan bar khusus anggota,
Dialogue: 0,0:16:25.61,0:16:26.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily!
Dialogue: 0,0:16:26.61,0:16:29.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami juga punya pusat kebugaran\Nyang lengkap.
Dialogue: 0,0:16:29.19,0:16:30.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily!
Dialogue: 0,0:16:31.03,0:16:32.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily!
Dialogue: 0,0:16:32.49,0:16:33.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily!
Dialogue: 0,0:16:33.40,0:16:34.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami bahkan punya kamar mandi\Ndan banyak lagi.
Dialogue: 0,0:16:34.66,0:16:38.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kami beri dukungan penuh bagi petualang.\N- Lily!
Dialogue: 0,0:16:38.28,0:16:39.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily!
Dialogue: 0,0:16:42.46,0:16:43.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily.
Dialogue: 0,0:16:44.50,0:16:48.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rein, aku ingin menjernihkan pikiranku,
Dialogue: 0,0:16:49.00,0:16:50.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi sepertinya tidak bisa.
Dialogue: 0,0:16:53.30,0:16:57.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku hanya beban bagi Elsie?
Dialogue: 0,0:16:57.85,0:17:01.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang dia pikirkan tentangku?
Dialogue: 0,0:17:01.68,0:17:03.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini semua salahku?
Dialogue: 0,0:17:06.16,0:17:12.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa berhenti memikirkannya.
Dialogue: 0,0:17:16.16,0:17:19.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus bicara dengan Elsie.
Dialogue: 0,0:17:22.83,0:17:26.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa pendapatmu tentang fasilitas\Ndan layanan di Busur Elf?
Dialogue: 0,0:17:26.79,0:17:29.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja sempurna.
Dialogue: 0,0:17:29.34,0:17:30.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang mendengarnya.
Dialogue: 0,0:17:30.80,0:17:33.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk memuaskan petualang sepertimu,\NNona Lily...
Dialogue: 0,0:17:33.67,0:17:37.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- adalah yang terbaik...\N- Elsie memintamu bawa kami ke sini, 'kan?
Dialogue: 0,0:17:37.84,0:17:38.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elsie?
Dialogue: 0,0:17:38.84,0:17:41.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa membahas Elsie sekarang?
Dialogue: 0,0:17:41.64,0:17:44.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga sejak awal.
Dialogue: 0,0:17:44.27,0:17:46.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong jangan salahkan Nona Elsie.
Dialogue: 0,0:17:46.60,0:17:50.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pernah membantuku.
Dialogue: 0,0:17:51.19,0:17:55.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia memohon kepadaku\Nuntuk menjaga kalian berdua.
Dialogue: 0,0:18:00.41,0:18:01.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rupanya dia memberitahumu.
Dialogue: 0,0:18:02.49,0:18:03.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elsie.
Dialogue: 0,0:18:06.08,0:18:09.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau tahu guild ini bangkrut\Nkarena utang,
Dialogue: 0,0:18:09.54,0:18:11.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau akan menyalahkan dirimu, 'kan?
Dialogue: 0,0:18:12.80,0:18:15.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bersedia terlihat\Nseperti orang berengsek
Dialogue: 0,0:18:15.92,0:18:18.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hanya agar kau tidak menanggung beban itu.
Dialogue: 0,0:18:18.68,0:18:21.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru itu yang membuatku makin khawatir.
Dialogue: 0,0:18:21.85,0:18:23.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:18:23.31,0:18:25.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku. Aku salah.
Dialogue: 0,0:18:28.69,0:18:30.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kuberi tahu semuanya.
Dialogue: 0,0:18:33.44,0:18:38.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dilatih petualang veteran\Nselama tiga tahun.
Dialogue: 0,0:18:38.74,0:18:40.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enam tahun setelah mandiri,
Dialogue: 0,0:18:40.49,0:18:41.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku menjadi terkenal.
Dialogue: 0,0:18:41.78,0:18:44.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menikmati hidup\Nsebagai petualang peringkat S.
Dialogue: 0,0:18:45.16,0:18:46.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat itulah...
Dialogue: 0,0:18:47.87,0:18:52.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar guruku terluka parah diserang naga.
Dialogue: 0,0:18:53.21,0:18:56.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengambil cuti\Ndan bergegas menemuinya, tapi...
Dialogue: 0,0:18:58.01,0:18:59.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata Elsie.
Dialogue: 0,0:19:01.89,0:19:04.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi teringat masa lalu.
Dialogue: 0,0:19:06.14,0:19:08.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gu-Guru!
Dialogue: 0,0:19:16.40,0:19:20.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat naga itu menggigitku,\Naku terkena semacam penyakit.
Dialogue: 0,0:19:21.20,0:19:22.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guru!
Dialogue: 0,0:19:22.99,0:19:26.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beberapa sakit secara fisik,\Nyang lain terluka secara mental.
Dialogue: 0,0:19:26.49,0:19:31.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagi masyarakat, petualang seperti kita\Nhanya barang yang bisa dibuang begitu saja.
Dialogue: 0,0:19:34.00,0:19:36.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan hanya aku yang sial.
Dialogue: 0,0:19:37.00,0:19:38.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beginilah keadaannya.
Dialogue: 0,0:19:39.34,0:19:40.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tak benar!
Dialogue: 0,0:19:40.88,0:19:43.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sama sekali tak benar!
Dialogue: 0,0:19:45.60,0:19:48.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Petualang diperlakukan\Nseperti alat sekali pakai.
Dialogue: 0,0:19:48.27,0:19:50.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin mengubah itu.
Dialogue: 0,0:19:51.52,0:19:55.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sebabnya aku mendirikan Kristal Biru.
Dialogue: 0,0:19:55.77,0:19:58.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Petualang yang terluka akan datang ke sini,
Dialogue: 0,0:19:58.40,0:20:01.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan aku akan membantu\Nmereka bangkit kembali.
Dialogue: 0,0:20:02.61,0:20:06.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kristal Biru adalah\Ntempat aku mewujudkan impianku.
Dialogue: 0,0:20:07.03,0:20:08.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya, itu rencananya.
Dialogue: 0,0:20:11.66,0:20:14.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah merugi selama dua tahun terakhir.
Dialogue: 0,0:20:14.79,0:20:17.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua tabunganku habis.
Dialogue: 0,0:20:19.09,0:20:21.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kristal Biru sudah tamat.
Dialogue: 0,0:20:21.51,0:20:24.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi lebih dari 20 orang\Nmenemukan pijakan di sini.
Dialogue: 0,0:20:25.09,0:20:26.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Usahaku tidak sia-sia.
Dialogue: 0,0:20:26.80,0:20:28.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bertahanlah sebentar lagi.
Dialogue: 0,0:20:28.93,0:20:31.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa. Tidak ada uang lagi.
Dialogue: 0,0:20:31.31,0:20:32.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kupinjamkan 500 juta.
Dialogue: 0,0:20:32.94,0:20:35.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bisa melunasinya dalam empat tahun.
Dialogue: 0,0:20:36.31,0:20:37.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika aku tidak bisa?
Dialogue: 0,0:20:37.90,0:20:39.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika tidak bisa melunasinya saat itu,
Dialogue: 0,0:20:39.69,0:20:41.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau akan bergabung dengan guild-ku\Nsebagai petualang.
Dialogue: 0,0:20:42.07,0:20:43.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami anggap uangnya bonus pendaftaran.
Dialogue: 0,0:20:43.70,0:20:46.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau yakin? 500 juta untuk itu?
Dialogue: 0,0:20:46.57,0:20:47.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja.
Dialogue: 0,0:20:47.74,0:20:50.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mendapatkan petualang sekelas Elsie\Nseharga 500 juta...
Dialogue: 0,0:20:50.54,0:20:52.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}itu tawaran yang murah.
Dialogue: 0,0:20:53.21,0:20:57.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam tiga bulan, aku harus bergabung\Ndengan Perisai Kaisar.
Dialogue: 0,0:20:57.54,0:21:00.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, Kristal Biru berakhir di sini.
Dialogue: 0,0:21:00.38,0:21:03.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin mengubah dunia petualang,
Dialogue: 0,0:21:03.22,0:21:05.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi pada akhirnya,\Naku tak mengubah apa pun.
Dialogue: 0,0:21:05.09,0:21:08.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini semua salahku.\NYang lain tidak bersalah.
Dialogue: 0,0:21:08.72,0:21:10.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan memutuskan semuanya sendiri!
Dialogue: 0,0:21:10.89,0:21:14.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau membantuku bangkit kembali\Nsaat aku terpuruk.
Dialogue: 0,0:21:14.19,0:21:15.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan hanya aku.
Dialogue: 0,0:21:15.48,0:21:18.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau menyelamatkan banyak petualang lain!
Dialogue: 0,0:21:18.98,0:21:22.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan hanya kau yang bisa membantu mereka\Nyang sedang terpuruk.
Dialogue: 0,0:21:23.78,0:21:27.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga bisa membantumu.
Dialogue: 0,0:21:29.87,0:21:30.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily...
Dialogue: 0,0:21:32.24,0:21:34.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku malah dibantu\Noleh petualangku sendiri...
Dialogue: 0,0:21:34.71,0:21:36.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku gagal sebagai Guild Master.
Dialogue: 0,0:21:36.92,0:21:37.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tidak benar.
Dialogue: 0,0:21:38.79,0:21:41.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah mendirikan guild baru\Nuntuk semua orang
Dialogue: 0,0:21:41.71,0:21:43.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau berbohong demi Lily,
Dialogue: 0,0:21:44.30,0:21:46.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau selalu memikirkan petualangmu.
Dialogue: 0,0:21:46.76,0:21:49.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau Guild Master yang luar biasa.
Dialogue: 0,0:21:49.97,0:21:53.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku suka Kristal Biru.
Dialogue: 0,0:21:53.35,0:21:56.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga akan tetap di sini sampai akhir.
Dialogue: 0,0:21:57.27,0:21:58.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan...
Dialogue: 0,0:21:58.56,0:22:00.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para petualang Kristal Biru...
Dialogue: 0,0:22:01.73,0:22:04.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan mendapatkan 500 juta\Ndalam tiga bulan ke depan!
Dialogue: 0,0:22:09.11,0:22:09.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hi-hi!
