Dialogue: 0,0:05:52.40,0:05:54.87,sign,,0000,0000,0000,,"PEDANG TEMBAGA (BARANG MURAH)"
Dialogue: 0,0:07:00.82,0:07:03.31,sign,,0000,0000,0000,,EP. 01 KAYAKNYA, SIH, SEMUA ORANG JUGA PERNAH\NMERASAKAN SELURUH USAHANYA GAGAL TOTAL.
Dialogue: 0,0:07:03.31,0:07:05.81,sign,,0000,0000,0000,,KALAU AKU BEGITU BAKAL NGAPAIN?\NJELASLAH. BAKAL LARI SAMBIL TERIAK "AAA!"
Dialogue: 0,0:07:07.50,0:07:10.81,sign,,0000,0000,0000,,KERAJAAN ZELUGE
Dialogue: 0,0:09:18.54,0:09:21.80,sign,,0000,0000,0000,,UWAAAAA!
Dialogue: 0,0:10:30.17,0:10:32.05,sign,,0000,0000,0000,,BOBROK
Dialogue: 0,0:20:04.70,0:20:07.89,sign,,0000,0000,0000,,BEBERAPA JAM KEMUDIAN
Dialogue: 0,0:00:03.60,0:00:04.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemecatan?
Dialogue: 0,0:00:05.44,0:00:06.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:00:06.35,0:00:08.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guild kami baru memecat beberapa orang.
Dialogue: 0,0:00:09.25,0:00:12.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belakangan ini sedang tren, ya?
Dialogue: 0,0:00:12.20,0:00:14.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga mau ikutan, ah.
Dialogue: 0,0:00:14.05,0:00:15.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba saja,
Dialogue: 0,0:00:15.40,0:00:18.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pak Guild Master Taring Raja Binatang.
Dialogue: 0,0:00:18.90,0:00:22.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memecat orang itu bawa banyak keuntungan, lo.
Dialogue: 0,0:00:22.20,0:00:24.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengeluaran untuk upah berkurang,
Dialogue: 0,0:00:24.25,0:00:29.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau juga tidak perlu melihat\Nwajah suram pecundang yang kau pecat.
Dialogue: 0,0:00:32.45,0:00:34.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, deh!
Dialogue: 0,0:00:34.70,0:00:39.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga bakal pecat\Nsatu orang dari tempatku!
Dialogue: 0,0:00:54.34,0:00:56.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Capek banget hari ini.
Dialogue: 0,0:00:56.50,0:00:59.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pembasmian hari ini juga lancar, ya.
Dialogue: 0,0:00:59.69,0:01:02.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apaan, nih?\NKok, kalian sudah pulang lagi?
Dialogue: 0,0:01:02.85,0:01:05.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lawannya lemah-lemah, tahu.
Dialogue: 0,0:01:05.70,0:01:09.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Petualang yang bisa bertarung itu seru, ya.
Dialogue: 0,0:01:09.89,0:01:12.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belum pernah bertarung.
Dialogue: 0,0:01:13.19,0:01:14.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena selama ini, di guild ini,
Dialogue: 0,0:01:14.95,0:01:16.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku adalah penyihir pengimbuh
Dialogue: 0,0:01:16.79,0:01:20.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang juga spesialis penguat senjata\Ndan pelindung.
Dialogue: 0,0:01:21.69,0:01:23.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Rein!
Dialogue: 0,0:01:23.15,0:01:26.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan banyak meleng dan cepat selesaikan!
Dialogue: 0,0:01:26.60,0:01:27.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, maaf.
Dialogue: 0,0:01:31.55,0:01:33.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus juga hasil kerjamu.
Dialogue: 0,0:01:33.60,0:01:35.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kau yang perkuat,
Dialogue: 0,0:01:35.50,0:01:38.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pedang biasa pun bisa jadi pedang terkenal.
Dialogue: 0,0:01:38.29,0:01:39.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jelaslah.
Dialogue: 0,0:01:40.75,0:01:42.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, hampir saja lupa.
Dialogue: 0,0:01:42.55,0:01:46.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rein, Paman Barrius memanggilmu, lo.
Dialogue: 0,0:01:46.25,0:01:46.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yuk, berangkat.
Dialogue: 0,0:01:47.70,0:01:49.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guild Master panggil aku?
Dialogue: 0,0:01:53.30,0:01:55.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perisai itu, pedang itu,
Dialogue: 0,0:01:57.10,0:01:59.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}zirah dan kapak itu juga.
Dialogue: 0,0:01:59.80,0:02:02.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya diperkuat olehku.
Dialogue: 0,0:02:02.94,0:02:04.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski tidak ikut bertarung,
Dialogue: 0,0:02:04.50,0:02:07.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tetap ikut berkontribusi\Npada prestasi mereka.
Dialogue: 0,0:02:08.35,0:02:10.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Panggilan dari Guild Master...
Dialogue: 0,0:02:10.85,0:02:12.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dipanggil untuk apa, ya?
Dialogue: 0,0:02:12.95,0:02:14.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenaikan gaji?
Dialogue: 0,0:02:14.74,0:02:16.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau jangan-jangan...
Dialogue: 0,0:02:16.50,0:02:22.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada petualang yang datang jauh-jauh\Ndari negara lain untuk sihir pengimbuhku?!
Dialogue: 0,0:02:22.43,0:02:23.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau dipecat.
Dialogue: 0,0:02:24.60,0:02:27.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kami sudah punya senjata\Ndan perlengkapan yang kuat,
Dialogue: 0,0:02:27.19,0:02:29.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami tidak butuh jasamu lagi.
Dialogue: 0,0:02:29.20,0:02:32.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau cuma bisa pakai sihir pengimbuh\Ndan tidak ikut bertarung.
Dialogue: 0,0:02:32.30,0:02:34.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja kau dipecat.
Dialogue: 0,0:02:34.60,0:02:37.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan itu?!\NLogikanya tidak nyambung!
Dialogue: 0,0:02:39.25,0:02:40.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau dipecat.
Dialogue: 0,0:02:40.60,0:02:42.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kau dengar itu, 'kan?
Dialogue: 0,0:02:42.35,0:02:44.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat pergi dari sini, dasar tidak berguna.
Dialogue: 0,0:02:44.65,0:02:46.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku masih belum bisa terima, ya!
Dialogue: 0,0:02:46.99,0:02:48.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa bodoh.
Dialogue: 0,0:02:48.70,0:02:50.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Ngajak berantem?!
Dialogue: 0,0:02:52.69,0:02:53.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh...
Dialogue: 0,0:02:54.18,0:02:58.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski tidak berpengalaman,\Naku juga bisa saja jadi petualang, tahu.
Dialogue: 0,0:02:58.50,0:02:59.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berisik kau, Rein!
Dialogue: 0,0:02:59.85,0:03:02.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang sepertimu mana mungkin bisa!
Dialogue: 0,0:03:02.34,0:03:05.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada seorang pun\Nyang mau bertualang denganmu!
Dialogue: 0,0:03:05.79,0:03:09.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya kau orang bodoh yang keahliannya\Ncuma satu, sihir pengimbuh!
Dialogue: 0,0:03:09.89,0:03:12.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perlengkapan kami sudah diperkuat, tahu.
Dialogue: 0,0:03:12.86,0:03:15.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak aneh kalau habis manis sepah dibuang.
Dialogue: 0,0:03:15.15,0:03:16.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan lihat-lihat kau, dasar botak!
Dialogue: 0,0:03:16.75,0:03:18.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat pergi sana,\Ndasar sampah tidak berguna!
Dialogue: 0,0:03:18.86,0:03:20.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pergi, pergi!
Dialogue: 0,0:03:20.84,0:03:23.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar payah!
Dialogue: 0,0:03:23.30,0:03:24.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mati kelaparan saja sana!
Dialogue: 0,0:03:25.64,0:03:26.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pergi kau!
Dialogue: 0,0:03:27.19,0:03:29.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kupikir mereka semua teman,
Dialogue: 0,0:03:29.54,0:03:31.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi tak seorang pun maju untuk menolong.
Dialogue: 0,0:03:33.80,0:03:38.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga tidak sudi\Nada di guild jahanam seperti ini!
Dialogue: 0,0:03:47.54,0:03:56.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}The Laid-Off Cheat-Granting Mage\NEnjoys a Second Lease on Life
Dialogue: 0,0:04:04.35,0:04:05.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini di mana, sih?!
Dialogue: 0,0:04:07.40,0:04:08.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertanyaan macam apa itu?
Dialogue: 0,0:04:13.50,0:04:16.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Percuma saja sedih berlarut-larut.
Dialogue: 0,0:04:19.25,0:04:22.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mereka inginnya begitu, ya sudah.\NAku juga sama.
Dialogue: 0,0:04:23.50,0:04:25.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir pengimbuh yang kukuasai
Dialogue: 0,0:04:25.80,0:04:28.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}memakai mana khusus\Nyang meningkatkan kemampuan
Dialogue: 0,0:04:28.20,0:04:31.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}senjata dan pelindung\Ndengan mengimbuhkan "Poin Penguat".
Dialogue: 0,0:04:33.60,0:04:34.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu...
Dialogue: 0,0:04:38.64,0:04:41.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cabut semua sihir pengimbuh\Ndari senjata dan pelindung
Dialogue: 0,0:04:41.80,0:04:45.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}seluruh 512 anggota Taring Raja Binatang!
Dialogue: 0,0:05:30.95,0:05:33.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa menarik kembali\Npoin yang kuimbuhkan!
Dialogue: 0,0:05:42.09,0:05:46.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini semua Poin Penguat\Nyang kuberikan pada anggota lain!
Dialogue: 0,0:05:47.34,0:05:49.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan dibiarkan seperti ini saja, deh,
Dialogue: 0,0:05:49.50,0:05:51.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}harus dimasukkan ke dalam sesuatu.
Dialogue: 0,0:05:52.40,0:05:54.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya punya satu pedang ini, ya.
Dialogue: 0,0:05:55.20,0:05:57.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya sudah. Aku coba masukkan saja.
Dialogue: 0,0:06:03.99,0:06:06.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sisa 3033.
Dialogue: 0,0:06:06.50,0:06:08.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti, pedang tembaga ini sekarang
Dialogue: 0,0:06:08.95,0:06:11.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dapat tambahan 10 ribu poin!
Dialogue: 0,0:06:11.14,0:06:13.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya dimasukkan ke mana, ya?
Dialogue: 0,0:06:13.65,0:06:16.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zirah dan perisai, aku tak punya.
Dialogue: 0,0:06:20.75,0:06:22.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sip.
Dialogue: 0,0:06:24.50,0:06:27.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pakaian dengan tambahan 3033 Poin Penguat!
Dialogue: 0,0:06:27.75,0:06:31.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan daya tahannya\Nsudah melebihi zirah biasa?
Dialogue: 0,0:06:32.00,0:06:33.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang dan pakaian sudah diperkuat.
Dialogue: 0,0:06:33.65,0:06:34.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengalaman boleh nol,
Dialogue: 0,0:06:34.65,0:06:37.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi perlengkapan seadanya begini\Npasti bisa membantuku bertarung.
Dialogue: 0,0:06:41.00,0:06:44.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama ini aku selalu kerja keras bagai kuda.
Dialogue: 0,0:06:44.89,0:06:47.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sempat berpikir ingin hidup santai,
Dialogue: 0,0:06:47.40,0:06:49.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi juga ingin coba menjadi petualang.
Dialogue: 0,0:06:52.45,0:06:54.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sekarang,\Naku bisa lakukan keduanya, dong?!
Dialogue: 0,0:06:54.54,0:06:57.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gabung guild,\Nkumpulkan duit sebagai petualang,
Dialogue: 0,0:06:57.69,0:07:00.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}baru setelah itu\Nmenikmati hidup dengan bebas!
Dialogue: 0,0:07:12.54,0:07:13.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi!
Dialogue: 0,0:07:13.89,0:07:17.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sedang mencari guild\Nselain Taring Raja Binatang.
Dialogue: 0,0:07:18.45,0:07:20.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini toko roti.
Dialogue: 0,0:07:20.45,0:07:22.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya, beli sesuatu dari tokoku dulu.
Dialogue: 0,0:07:22.64,0:07:24.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, deh. Aku mau beli kroisan.
Dialogue: 0,0:07:26.45,0:07:28.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, guild-nya di mana?
Dialogue: 0,0:07:28.25,0:07:30.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entahlah. Aku tidak tahu.
Dialogue: 0,0:07:31.20,0:07:32.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau tanya?
Dialogue: 0,0:07:32.25,0:07:33.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belanja dululah.
Dialogue: 0,0:07:33.80,0:07:35.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baru kujawab kalau sudah belanja.
Dialogue: 0,0:07:35.89,0:07:37.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beli topengku, dong.
Dialogue: 0,0:07:39.15,0:07:42.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ketemu juga, ya.
Dialogue: 0,0:07:42.25,0:07:42.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei.
Dialogue: 0,0:07:45.45,0:07:46.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku?
Dialogue: 0,0:07:46.80,0:07:48.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, benar. Kau.
Dialogue: 0,0:07:48.39,0:07:50.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya ada siapa lagi?
Dialogue: 0,0:07:51.10,0:07:52.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Uang.
Dialogue: 0,0:07:52.30,0:07:53.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keluarkan uangmu.
Dialogue: 0,0:07:53.80,0:07:56.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perlengkapan dan badannya biasa saja.
Dialogue: 0,0:07:56.85,0:08:00.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak mau ditonjok di perut, 'kan?\NCepat keluarkan.
Dialogue: 0,0:08:02.25,0:08:04.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sedang pakai baju yang sudah diperkuat.
Dialogue: 0,0:08:04.60,0:08:08.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ditonjok di perut pun\Ntidak akan sakit sama sekali.
Dialogue: 0,0:08:08.10,0:08:09.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau menguji
Dialogue: 0,0:08:09.80,0:08:13.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}daya tahan "Pakaian +3033"!
Dialogue: 0,0:08:13.35,0:08:14.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian yang di sana!
Dialogue: 0,0:08:15.05,0:08:17.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian sedang apa?!
Dialogue: 0,0:08:19.35,0:08:20.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa kau?
Dialogue: 0,0:08:21.80,0:08:23.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Identitasku sama sekali tidak penting,
Dialogue: 0,0:08:23.40,0:08:25.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi perbuatan kalian ini tidak baik!
Dialogue: 0,0:08:26.65,0:08:28.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami hanya mengobrol dengan teman.
Dialogue: 0,0:08:29.65,0:08:32.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Po-Pokoknya, aku akan panggil orang.
Dialogue: 0,0:08:33.65,0:08:35.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan kau, wanita jalang?
Dialogue: 0,0:08:35.75,0:08:37.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau saja yang kuhajar duluan, hah?
Dialogue: 0,0:08:39.15,0:08:40.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu.
Dialogue: 0,0:08:41.03,0:08:42.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lawan kalian itu aku, 'kan?
Dialogue: 0,0:08:42.90,0:08:44.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah menolongku,
Dialogue: 0,0:08:44.70,0:08:46.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi tolong mundur dulu.
Dialogue: 0,0:08:47.89,0:08:49.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya sekarang
Dialogue: 0,0:08:49.45,0:08:51.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku ingin ditonjok di perut!
Dialogue: 0,0:08:52.25,0:08:55.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang ini ngomong apa, sih?
Dialogue: 0,0:08:56.44,0:08:59.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei. Itu pasti sakit, jadi jangan coba-coba!
Dialogue: 0,0:08:59.15,0:09:00.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berisik!
Dialogue: 0,0:09:00.45,0:09:03.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudahlah, biarkan aku ci-coba-bi-ba du-dulu!
Dialogue: 0,0:09:03.04,0:09:04.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba-ba-bi-ba di...?
Dialogue: 0,0:09:04.50,0:09:05.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau ngomong apa, sih?!
Dialogue: 0,0:09:05.55,0:09:06.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Apa?\N- Sudahlah!
Dialogue: 0,0:09:06.85,0:09:10.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keparat kau!\NApa maksudmu ingin coba ditonjok di perut?!
Dialogue: 0,0:09:13.76,0:09:14.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak sakit.
Dialogue: 0,0:09:14.96,0:09:18.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sakit! Keras banget!
Dialogue: 0,0:09:21.80,0:09:24.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau malah ikut-ikutan syok?!
Dialogue: 0,0:09:24.50,0:09:27.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat saja nanti, dasar bocah sialan!
Dialogue: 0,0:09:28.35,0:09:31.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pasti akan membalasmu!
Dialogue: 0,0:09:33.35,0:09:35.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau menyelipkan pelat besi, ya?
Dialogue: 0,0:09:35.85,0:09:39.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menambahkan 3033 Poin Penguat ke bajuku.
Dialogue: 0,0:09:39.49,0:09:43.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, ya. Kau hanya asal bicara, ya.
Dialogue: 0,0:09:43.30,0:09:45.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau petualang?
Dialogue: 0,0:09:45.10,0:09:47.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitulah. Namaku Rein!
Dialogue: 0,0:09:47.60,0:09:49.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Nina.
Dialogue: 0,0:09:49.85,0:09:51.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, Nina,
Dialogue: 0,0:09:51.14,0:09:54.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di sekitar sini ada guild petualang, tidak?
Dialogue: 0,0:09:54.36,0:09:56.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedang mencari guild, ya?
Dialogue: 0,0:09:57.10,0:10:00.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, mau gabung ke...\NKristal Biru?
Dialogue: 0,0:10:00.85,0:10:02.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum pernah dengar, sih.
Dialogue: 0,0:10:02.55,0:10:03.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guild itu ada di sekitar sini, ya?
Dialogue: 0,0:10:03.94,0:10:04.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada!
Dialogue: 0,0:10:04.80,0:10:08.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku resepsionis di Guild Kristal Biru!
Dialogue: 0,0:10:10.00,0:10:12.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kau mau, aku bisa antarkan.
Dialogue: 0,0:10:13.20,0:10:16.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kebetulan aku juga mau ke sana.
Dialogue: 0,0:10:16.70,0:10:18.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah. Minta tolong, ya!
Dialogue: 0,0:10:20.30,0:10:21.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi jangan kaget, ya.
Dialogue: 0,0:10:22.00,0:10:22.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kaget apa?
Dialogue: 0,0:10:22.85,0:10:25.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, kau bisa lihat sendiri nanti.
Dialogue: 0,0:10:35.75,0:10:37.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kecewa, ya?
Dialogue: 0,0:10:37.55,0:10:39.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak jadi gabung dengan kami?
Dialogue: 0,0:10:39.96,0:10:41.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, kok, Nina.
Dialogue: 0,0:10:42.30,0:10:44.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan daftar jadi petualang di sini.
Dialogue: 0,0:10:45.29,0:10:46.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang benar?!
Dialogue: 0,0:10:46.29,0:10:46.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:10:46.90,0:10:49.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau daftar di tempat kami?\NSebagai petualang?!
Dialogue: 0,0:10:49.15,0:10:51.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rewel banget, dah. Kubilang mau!
Dialogue: 0,0:10:51.35,0:10:53.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master! Ada kabar besar!
Dialogue: 0,0:10:53.24,0:10:56.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada anggota yang mau mendaftar\Nke tempat kita!
Dialogue: 0,0:10:58.35,0:11:00.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bohong, ah!
Dialogue: 0,0:11:01.50,0:11:03.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, tapi, pasti ujung-ujungnya,
Dialogue: 0,0:11:03.65,0:11:05.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Ini bukan Taring Raja Binatang, ya?"
Dialogue: 0,0:11:05.45,0:11:10.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Beda guild, ya? Tidak jadi, deh."\NTerus mereka pergi kayak biasanya.
Dialogue: 0,0:11:14.20,0:11:16.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baru saja keluar\Ndari Taring Raja Binatang,
Dialogue: 0,0:11:16.75,0:11:18.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}makanya ingin gabung ke sini.
Dialogue: 0,0:11:20.05,0:11:23.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhasil. Kerja bagus, Nina!
Dialogue: 0,0:11:25.20,0:11:29.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Elsie, Guild Master Kristal Biru.
Dialogue: 0,0:11:29.04,0:11:30.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salam kenal, ya.
Dialogue: 0,0:11:30.69,0:11:32.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yey!
Dialogue: 0,0:11:35.70,0:11:38.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, aku akan balik kerja di dalam.
Dialogue: 0,0:11:38.75,0:11:41.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ada perlu,\Njangan sungkan untuk panggil namaku.
Dialogue: 0,0:11:41.40,0:11:45.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Elsie siap mendengarkan\Nsemua curhatanmu.
Dialogue: 0,0:11:45.45,0:11:47.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nina, kuserahkan sisanya padamu.
Dialogue: 0,0:11:47.94,0:11:49.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:11:50.10,0:11:53.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, penjelasan biaya perantara\Ndan imbalannya selesai.
Dialogue: 0,0:11:54.05,0:11:57.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tinggal tanda tangan,\Npendaftaranmu sebagai petualang pun selesai.
Dialogue: 0,0:11:57.15,0:11:58.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke!
Dialogue: 0,0:11:59.75,0:12:02.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, ini bukan Taring Raja Binatang, ya?
Dialogue: 0,0:12:02.60,0:12:05.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkinlah.\NBangunannya saja macam gubuk begini.
Dialogue: 0,0:12:05.79,0:12:06.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei!
Dialogue: 0,0:12:08.05,0:12:09.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba pilih satu.
Dialogue: 0,0:12:09.75,0:12:12.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kasih kami uang,\Natau kami hancurkan perabotan kalian.
Dialogue: 0,0:12:12.39,0:12:13.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si-Siapa kalian?
Dialogue: 0,0:12:13.90,0:12:17.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu itu,\Npekerjaan dari tempat ini benar-benar jelek.
Dialogue: 0,0:12:17.60,0:12:20.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kau kasih uang, kami akan maafkan.
Dialogue: 0,0:12:20.44,0:12:24.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau, serahkan saja pria itu pada kami.
Dialogue: 0,0:12:24.29,0:12:25.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang itu saja!
Dialogue: 0,0:12:25.85,0:12:28.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sip. Keluar.
Dialogue: 0,0:12:28.67,0:12:29.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke!
Dialogue: 0,0:12:31.19,0:12:32.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, Rein!
Dialogue: 0,0:12:33.00,0:12:34.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau apa?
Dialogue: 0,0:12:34.50,0:12:36.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka sepertinya ada perlu denganku.
Dialogue: 0,0:12:36.45,0:12:38.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan aneh-aneh, deh!
Dialogue: 0,0:12:38.29,0:12:40.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rein hanya kuat\Nkalau ditonjok di perut, 'kan?
Dialogue: 0,0:12:40.55,0:12:43.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja.\NTadi juga lawannya berdua, 'kan?
Dialogue: 0,0:12:43.60,0:12:45.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang kali ini pasti bakal aman...
Dialogue: 0,0:12:50.78,0:12:53.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami datang\Nuntuk membalas perbuatanmu, sialan!
Dialogue: 0,0:12:53.53,0:12:55.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah hajar temanku, ya?!
Dialogue: 0,0:12:55.70,0:12:57.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan remehkan kami, bocah dungu!
Dialogue: 0,0:12:57.80,0:12:59.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kuhajar!
Dialogue: 0,0:12:59.15,0:13:00.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maju sini, cecunguk!
Dialogue: 0,0:13:00.84,0:13:02.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rein, kau kabur saja.
Dialogue: 0,0:13:02.04,0:13:04.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka tidak mungkin\Nhanya menonjok perutmu, lo.
Dialogue: 0,0:13:04.35,0:13:06.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja, Nina.
Dialogue: 0,0:13:06.20,0:13:08.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah menduga akan seperti ini
Dialogue: 0,0:13:08.64,0:13:10.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan menyiapkan senjata berkualitas tinggi.
Dialogue: 0,0:13:13.10,0:13:14.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kecil amat!
Dialogue: 0,0:13:14.30,0:13:16.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, tidak, tidak!\NTidak mungkin bisa!
Dialogue: 0,0:13:16.59,0:13:19.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedangnya kecil banget itu!\NItu apa, coba?!
Dialogue: 0,0:13:19.44,0:13:22.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini punya 10 ribu Poin Penguat.
Dialogue: 0,0:13:22.85,0:13:25.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ukuran boleh kecil, tapi belum tentu lemah.
Dialogue: 0,0:13:25.14,0:13:26.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, 'kan, Nina?
Dialogue: 0,0:13:26.85,0:13:30.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa apa kau pakai pedang sekecil itu?!
Dialogue: 0,0:13:31.25,0:13:35.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei! Jangan tarik-tarik, Nina!
Dialogue: 0,0:13:58.00,0:13:59.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:13:59.25,0:14:01.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan orang itu...?
Dialogue: 0,0:14:01.00,0:14:02.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gila...
Dialogue: 0,0:14:03.00,0:14:05.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia monster. Kabur!
Dialogue: 0,0:14:10.05,0:14:11.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rein.
Dialogue: 0,0:14:11.55,0:14:13.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau lakukan apa tadi?
Dialogue: 0,0:14:13.65,0:14:15.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya ayunkan pedangku sedikit.
Dialogue: 0,0:14:16.25,0:14:17.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudnya?
Dialogue: 0,0:14:27.25,0:14:29.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada orang yang celaka\Nkarena ayunanmu tadi.
Dialogue: 0,0:14:30.25,0:14:32.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya. Syukurlah.
Dialogue: 0,0:14:32.56,0:14:33.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setuju banget!
Dialogue: 0,0:14:33.80,0:14:36.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rein, lain kali harus hati-hati, ya.
Dialogue: 0,0:14:36.70,0:14:38.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master!
Dialogue: 0,0:14:38.50,0:14:39.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan hati-hati.
Dialogue: 0,0:14:40.25,0:14:43.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah jadi anggota Kristal Biru,
Dialogue: 0,0:14:43.75,0:14:47.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tentu akan ada teman yang membantu\Ndan mengajarimu macam-macam.
Dialogue: 0,0:14:47.29,0:14:50.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, ada juga yang sudah lama\Nbekerja sebagai petualang.
Dialogue: 0,0:14:50.10,0:14:51.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia benar.
Dialogue: 0,0:14:51.50,0:14:54.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pasti bisa mempelajari teknik\Nuntuk memanfaatkan kekuatan ini.
Dialogue: 0,0:14:55.75,0:14:56.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masuk akal!
Dialogue: 0,0:14:56.96,0:14:57.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rein.
Dialogue: 0,0:14:59.45,0:15:02.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pasti bisa jadi petualang hebat.
Dialogue: 0,0:15:03.75,0:15:06.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang di Kristal Biru.
Dialogue: 0,0:15:08.65,0:15:11.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kristal Biru sudah membayar biaya perbaikan
Dialogue: 0,0:15:11.85,0:15:15.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bangunan dan jalan yang Rein rusak,\Nsebesar seribu koin emas.
Dialogue: 0,0:15:15.20,0:15:18.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Se-Seribu?!
Dialogue: 0,0:15:18.25,0:15:20.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu gajiku untuk berapa tahun, ya?
Dialogue: 0,0:15:22.45,0:15:23.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Santai, santai.
Dialogue: 0,0:15:23.95,0:15:27.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bisa mencicil utangmu ke Kak Elsie\Nsambil bekerja di sini.
Dialogue: 0,0:15:28.24,0:15:30.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa seperti itu, ya!
Dialogue: 0,0:15:30.10,0:15:30.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nina.
Dialogue: 0,0:15:30.90,0:15:33.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada kerjaan yang dibayar\Nseribu koin emas, tidak?
Dialogue: 0,0:15:34.05,0:15:35.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rein,
Dialogue: 0,0:15:35.00,0:15:38.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pengalamanmu masih nol,\Nmana bisa selesaikan quest seperti itu.
Dialogue: 0,0:15:38.70,0:15:39.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nina,
Dialogue: 0,0:15:39.50,0:15:40.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bukankah ada "itu"?
Dialogue: 0,0:15:40.90,0:15:42.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Quest yang kita biarkan terbengkalai.
Dialogue: 0,0:15:42.49,0:15:44.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master, kalau itu...
Dialogue: 0,0:15:44.50,0:15:47.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau dilihat dari mana pun,\Nitu masih terlalu dini untuk Rein.
Dialogue: 0,0:15:47.60,0:15:49.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Itu" yang mana?
Dialogue: 0,0:15:52.95,0:15:54.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pembasmian naga.
Dialogue: 0,0:15:55.08,0:15:55.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Na...!
Dialogue: 0,0:15:59.20,0:16:01.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permintaannya sudah ada\Nsejak dua minggu lalu.
Dialogue: 0,0:16:01.75,0:16:04.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kabarnya klien meminta bantuan\Nke guild lain juga,
Dialogue: 0,0:16:04.74,0:16:07.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi tidak ada yang cukup senggang\Nuntuk selesaikan quest itu.
Dialogue: 0,0:16:07.85,0:16:09.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Naga!
Dialogue: 0,0:16:09.16,0:16:11.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi ini terlalu dini untuk Rein.
Dialogue: 0,0:16:11.20,0:16:14.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya sedikit petualang\Nyang bisa kalahkan naga.
Dialogue: 0,0:16:14.55,0:16:19.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Normalnya, kau harus beberapa tahun\Njadi petualang untuk bisa hadapi...
Dialogue: 0,0:16:19.65,0:16:20.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlebih...
Dialogue: 0,0:16:20.35,0:16:23.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya kenapa?\NCoba saja kalahkan naga.
Dialogue: 0,0:16:23.05,0:16:25.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan lanjut kerja di dalam, ya.
Dialogue: 0,0:16:25.35,0:16:27.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga, Master ini, ya...
Dialogue: 0,0:16:27.39,0:16:29.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Klien kita sudah menunggu, 'kan?
Dialogue: 0,0:16:29.90,0:16:31.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harus ada yang selesaikan, dong!
Dialogue: 0,0:16:34.40,0:16:37.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau membasmi naga pakai baju santai\Nseperti orang mau ajak anjing jalan-jalan?
Dialogue: 0,0:16:37.69,0:16:39.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pasti bercanda.
Dialogue: 0,0:16:39.20,0:16:40.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nina,
Dialogue: 0,0:16:40.35,0:16:42.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}perlengkapanku saja sudah kuat, kok.
Dialogue: 0,0:16:43.75,0:16:46.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada 10 ribu Poin Penguat di pedang ini.
Dialogue: 0,0:16:46.35,0:16:48.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baju ini punya 3033 Poin Penguat.
Dialogue: 0,0:16:48.80,0:16:51.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti lebih kuat dari zirah logam.
Dialogue: 0,0:16:51.35,0:16:53.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau masih cemas,\Ntikam saja aku pakai pisau!
Dialogue: 0,0:16:53.35,0:16:55.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana berani aku menikam orang lain?!
Dialogue: 0,0:17:01.54,0:17:03.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tidak bohong.
Dialogue: 0,0:17:04.05,0:17:06.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih keras dari zirah logam.
Dialogue: 0,0:17:08.19,0:17:09.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, 'kan?
Dialogue: 0,0:17:09.45,0:17:10.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, ya!
Dialogue: 0,0:17:11.39,0:17:13.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau lihat itu, Nina?!
Dialogue: 0,0:17:13.15,0:17:16.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harusnya kau marah\Nkarena dipukul pakai pedang.
Dialogue: 0,0:17:16.05,0:17:17.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, kau siapa?
Dialogue: 0,0:17:18.84,0:17:20.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily.
Dialogue: 0,0:17:20.44,0:17:21.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily Flambert.
Dialogue: 0,0:17:22.45,0:17:25.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily Flambert...?
Dialogue: 0,0:17:25.49,0:17:26.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nina,
Dialogue: 0,0:17:26.55,0:17:28.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau kau berat hati\Nmembiarkan dia pergi sendiri,
Dialogue: 0,0:17:28.65,0:17:30.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku bisa pergi menemaninya.
Dialogue: 0,0:17:30.54,0:17:32.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily, kau...
Dialogue: 0,0:17:32.30,0:17:35.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baik-baik saja, Nina.
Dialogue: 0,0:17:35.05,0:17:38.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah lupa, ya,\Nkalau aku petualang peringkat S?
Dialogue: 0,0:17:38.40,0:17:39.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku peringkat D!
Dialogue: 0,0:17:39.50,0:17:42.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peringkat ampas kayak begitu\Ntidak usah disebut.
Dialogue: 0,0:17:42.65,0:17:44.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo berangkat.
Dialogue: 0,0:17:44.16,0:17:45.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namamu Rein, 'kan, ya?
Dialogue: 0,0:17:45.30,0:17:45.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul!
Dialogue: 0,0:17:47.50,0:17:49.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, tunggu.\NDiskusi dulu dengan Master...!
Dialogue: 0,0:17:50.90,0:17:52.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei!
Dialogue: 0,0:18:07.79,0:18:10.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kota ini sudah banyak berubah, ya.
Dialogue: 0,0:18:10.95,0:18:12.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily Flambert.
Dialogue: 0,0:18:12.74,0:18:17.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pendekar pedang yang diakui sebagai petualang\Nperingkat S termuda sepanjang sejarah.
Dialogue: 0,0:18:18.05,0:18:21.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namanya tersohor di seantero benua.
Dialogue: 0,0:18:21.89,0:18:25.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di usia tujuh tahun, dia mengalahkan\Nlima ekor naga peringkat rendah.
Dialogue: 0,0:18:25.64,0:18:29.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di usia 12 tahun, dia menaklukkan\Ndan menunggangi naga peringkat menengah.
Dialogue: 0,0:18:30.55,0:18:33.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, pada akhirnya,
Dialogue: 0,0:18:33.29,0:18:37.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia mampu mengalahkan naga\Nperingkat tinggi seorang diri...
Dialogue: 0,0:18:38.25,0:18:42.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi beberapa tahun belakangan,\Nkabar prestasinya tak terdengar lagi.
Dialogue: 0,0:18:42.70,0:18:46.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dengar berbagai rumor seperti\Ndia sakit atau meninggal,
Dialogue: 0,0:18:46.40,0:18:49.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi ternyata dia ada di sini...
Dialogue: 0,0:18:49.00,0:18:52.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau ini berisik sekali ngoceh ini-itu\Ndi depan orangnya langsung.
Dialogue: 0,0:18:52.95,0:18:56.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa petualang sepertimu\Nada di Kristal Biru?
Dialogue: 0,0:19:01.30,0:19:03.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu guild yang bagus.
Dialogue: 0,0:19:04.30,0:19:06.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau ada benarnya!
Dialogue: 0,0:19:06.65,0:19:09.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily, terima kasih sudah mau menemaniku!
Dialogue: 0,0:19:12.20,0:19:14.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak perlu berterima kasih padaku.
Dialogue: 0,0:19:14.65,0:19:16.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kau pergi sendiri dan meninggal,
Dialogue: 0,0:19:16.60,0:19:18.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kristal Biru yang bakal dapat masalah.
Dialogue: 0,0:19:20.55,0:19:24.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang-orang bakal mengkritik mereka\Nkarena mengirim seorang amatir
Dialogue: 0,0:19:24.25,0:19:26.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk membasmi naga sendirian, 'kan?
Dialogue: 0,0:19:26.90,0:19:28.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya aku ikut denganmu.
Dialogue: 0,0:19:29.65,0:19:32.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dulu, aku hanya fokus\Nsebagai penyihir pengimbuh,
Dialogue: 0,0:19:32.75,0:19:35.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi tidak punya pengalaman bertarung\Nsama sekali.
Dialogue: 0,0:19:36.09,0:19:37.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily,
Dialogue: 0,0:19:37.00,0:19:39.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau butuh sihir pengimbuh,\Nbilang saja padaku, ya.
Dialogue: 0,0:19:46.84,0:19:48.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu pedang sihir, ya?
Dialogue: 0,0:19:48.70,0:19:51.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar. Bukan pedang terkenal,
Dialogue: 0,0:19:51.00,0:19:54.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi pedang kuat yang ditempa\Nmenggunakan teknologi sihir.
Dialogue: 0,0:19:54.04,0:19:55.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:19:56.55,0:19:57.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily?
Dialogue: 0,0:19:57.50,0:20:00.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak butuh sihir pengimbuh milikmu.
Dialogue: 0,0:20:00.25,0:20:02.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo bergegas.
Dialogue: 0,0:20:07.89,0:20:10.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Naga peringkat menengah, ya.
Dialogue: 0,0:20:10.30,0:20:12.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Naga?! Di mana?
Dialogue: 0,0:20:12.20,0:20:13.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ia tidak ada di sini.
Dialogue: 0,0:20:13.80,0:20:16.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya tahu dari jejak kerusakannya.
Dialogue: 0,0:20:16.05,0:20:17.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily hebat banget!
Dialogue: 0,0:20:17.80,0:20:20.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau memang petualang tulen!
Dialogue: 0,0:20:20.15,0:20:22.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini namanya pengalaman.
Dialogue: 0,0:20:22.90,0:20:26.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sudah lama jadi petualang,\Nmau tak mau bakal paham yang seperti ini.
Dialogue: 0,0:20:26.25,0:20:28.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo berangkat!
Dialogue: 0,0:20:28.25,0:20:29.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau ke mana?
Dialogue: 0,0:20:29.45,0:20:31.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke tempat naganya! Naga-ga-ga!
Dialogue: 0,0:20:31.60,0:20:34.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan lewat situ, tapi lewat sini.
Dialogue: 0,0:20:35.70,0:20:36.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu juga dari pengalaman?!
Dialogue: 0,0:20:36.85,0:20:38.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bawel banget, dah!
Dialogue: 0,0:20:39.20,0:20:40.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily!
Dialogue: 0,0:20:40.19,0:20:41.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa, sih?
Dialogue: 0,0:20:55.85,0:20:57.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebentar lagi...
Dialogue: 0,0:21:00.15,0:21:02.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ia bisa muncul kapan saja.
Dialogue: 0,0:21:14.00,0:21:15.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily, ada apa?
Dialogue: 0,0:21:16.85,0:21:19.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Abaikan saja aku.
Dialogue: 0,0:21:19.85,0:21:23.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pergi saja membasmi naga\Natau apa pun itu sesukamu.
Dialogue: 0,0:21:24.15,0:21:26.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana bisa seperti itu.
Dialogue: 0,0:21:26.69,0:21:27.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak enak badan,
Dialogue: 0,0:21:27.94,0:21:29.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita bisa pergi dari sini untuk istirahat.
Dialogue: 0,0:21:30.35,0:21:31.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rein.
Dialogue: 0,0:21:32.10,0:21:33.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama dua tahun terakhir...
Dialogue: 0,0:21:34.70,0:21:37.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak tahu sepak terjangku, 'kan?
Dialogue: 0,0:21:37.62,0:21:39.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar. Aku tidak tahu.
Dialogue: 0,0:21:41.44,0:21:44.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa saja yang kulakukan...
Dialogue: 0,0:21:46.40,0:21:49.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak melakukan apa-apa, tahu!
Dialogue: 0,0:21:50.14,0:21:52.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bi-Bicara apa kau?
Dialogue: 0,0:21:53.25,0:21:55.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak melakukan apa-apa, katamu?
Dialogue: 0,0:21:55.65,0:21:57.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily mengalahkan naga peringkat rendah\Ndi usia tujuh tahun,
Dialogue: 0,0:21:57.90,0:22:00.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menaklukkan naga peringkat menengah\Ndi usia 12 tahun,
Dialogue: 0,0:22:00.20,0:22:03.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu menjadi petualang peringkat S termuda\Nsepanjang sejarah, 'kan?
Dialogue: 0,0:22:03.95,0:22:05.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bodoh, bodoh, bodoh!
Dialogue: 0,0:22:05.40,0:22:09.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berisik, berisik, berisik, berisik!
