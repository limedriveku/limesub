Dialogue: 0,0:04:11.25,0:04:11.98,sign,,0000,0000,0000,,TUSUK
Dialogue: 0,0:04:34.81,0:04:37.11,sign,,0000,0000,0000,,EP. 06 GADIS KECIL YANG GIGIH,\NGADIS KECIL YANG TAK PERNAH DEWASA,
Dialogue: 0,0:04:37.11,0:04:39.82,sign,,0000,0000,0000,,KALI INI PUN TAK BERDAYA,\NTAPI AKU TETAP LILY FLAMBERT
Dialogue: 0,0:06:28.22,0:06:30.30,sign,,0000,0000,0000,,AAAAH!
Dialogue: 0,0:06:31.18,0:06:33.00,sign,,0000,0000,0000,,"BUNUH"
Dialogue: 0,0:10:20.72,0:10:25.50,sign,,0000,0000,0000,,TERTAWA
Dialogue: 0,0:11:22.89,0:11:25.72,sign,,0000,0000,0000,,"BEBAS PAJAK"
Dialogue: 0,0:11:26.72,0:11:27.90,sign,,0000,0000,0000,,KELUARGA
Dialogue: 0,0:16:24.30,0:16:25.38,sign,,0000,0000,0000,,BERTERIAK
Dialogue: 0,0:17:07.69,0:17:09.85,sign,,0000,0000,0000,,"SIAL, MESKI AKU MATI,"
Dialogue: 0,0:17:09.94,0:17:12.49,sign,,0000,0000,0000,,"AKU AKAN TINGGALKAN LUKA DI HATIMU, DAH!"
Dialogue: 0,0:23:00.12,0:23:02.56,sign,,0000,0000,0000,,PENGINAPAN
Dialogue: 0,0:00:13.93,0:00:16.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}The Laid-Off Cheat-Granting Mage\NEnjoys a Second Lease on Life
Dialogue: 0,0:01:32.05,0:01:35.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia cuma orang rendahan\Nyang bisanya cuma bicara.
Dialogue: 0,0:01:38.59,0:01:40.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bunuh sisanya.
Dialogue: 0,0:01:40.60,0:01:42.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau benar.
Dialogue: 0,0:01:43.39,0:01:45.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu...
Dialogue: 0,0:01:47.89,0:01:50.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar berandal gigih.
Dialogue: 0,0:01:50.86,0:01:51.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo bunuh dia.
Dialogue: 0,0:01:56.61,0:01:57.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu.
Dialogue: 0,0:01:58.53,0:02:02.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi... membunuhku tidak akan semudah itu.
Dialogue: 0,0:02:03.70,0:02:05.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:02:07.91,0:02:10.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku punya ide yang lebih baik.
Dialogue: 0,0:02:10.78,0:02:13.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pulanglah dengan membawa rasa takut.
Dialogue: 0,0:02:13.09,0:02:18.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Habiskan sisa hidupmu\Ndihantui ketakutan akan masa lalu.
Dialogue: 0,0:02:19.89,0:02:25.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan membuatmu melupakan\Nsemua yang terjadi di sini.
Dialogue: 0,0:02:33.61,0:02:36.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada yang perlu ditakutkan.
Dialogue: 0,0:02:37.15,0:02:41.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis kecil ini belum berubah\Nsedikit pun sejak saat itu.
Dialogue: 0,0:02:42.03,0:02:46.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau bocah itu menusuk tanda di dadaku?
Dialogue: 0,0:02:47.00,0:02:48.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bodoh!
Dialogue: 0,0:02:57.30,0:03:01.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekuat apa pun itu,\Ntidak ada gunanya jika tidak kena.
Dialogue: 0,0:03:01.80,0:03:06.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat, bocah itu sudah jauh di sana.
Dialogue: 0,0:03:18.28,0:03:19.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis kecil.
Dialogue: 0,0:03:19.86,0:03:23.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kali ini pun kau tetap tak berdaya!
Dialogue: 0,0:03:23.57,0:03:25.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bukan gadis kecil.
Dialogue: 0,0:03:26.37,0:03:29.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pria yang staminanya payah itu namanya Rein.
Dialogue: 0,0:03:31.08,0:03:32.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan aku...
Dialogue: 0,0:03:33.71,0:03:35.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily Flambert!
Dialogue: 0,0:03:38.84,0:03:41.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sisikmu memang zirah terbaik.
Dialogue: 0,0:03:41.17,0:03:44.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi saat kau bergerak,\Ncelah muncul di antara sisik itu.
Dialogue: 0,0:03:44.59,0:03:46.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar berandal!
Dialogue: 0,0:03:52.69,0:03:55.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pisaunya pasti mengenai saraf.
Dialogue: 0,0:03:55.56,0:03:57.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah kau terbang atau berjalan,
Dialogue: 0,0:03:57.11,0:04:00.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}getarannya akan mencapai lehermu\Ndan menyebabkan rasa sakit yang hebat.
Dialogue: 0,0:04:00.19,0:04:02.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak bisa kabur sekarang.
Dialogue: 0,0:04:03.24,0:04:06.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis kecil ini...
Dialogue: 0,0:04:07.16,0:04:09.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, sadarlah, Kanan!
Dialogue: 0,0:04:09.54,0:04:11.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau baik-baik saja?
Dialogue: 0,0:04:13.50,0:04:15.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rein, tusuk tandanya dengan pedangmu!
Dialogue: 0,0:04:15.67,0:04:17.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau memusatkan dampaknya\Npada satu titik,
Dialogue: 0,0:04:17.67,0:04:19.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau bisa menusuk jantungnya!
Dialogue: 0,0:04:19.30,0:04:20.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti!
Dialogue: 0,0:04:20.80,0:04:23.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu aku!
Dialogue: 0,0:04:26.89,0:04:29.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zirah semua orang sudah mencapai batasnya.
Dialogue: 0,0:04:29.85,0:04:31.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika aku meleset,
Dialogue: 0,0:04:32.48,0:04:34.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}semua orang akan mati!
Dialogue: 0,0:04:40.19,0:04:43.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sakit! Sakit sekali!
Dialogue: 0,0:04:43.70,0:04:46.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katakan sesuatu, Kanan!
Dialogue: 0,0:04:46.45,0:04:50.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau sudah menyerah?
Dialogue: 0,0:04:50.12,0:04:54.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bocah itu pasti akan mendekat\Nuntuk menyerang jantungku.
Dialogue: 0,0:04:55.04,0:04:57.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika aku menunggu saat yang tepat,
Dialogue: 0,0:04:57.13,0:05:01.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku bisa membunuhnya tepat\Ndi depan gadis kecil itu.
Dialogue: 0,0:05:02.80,0:05:03.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rein!
Dialogue: 0,0:05:03.72,0:05:04.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia akan menyerangmu dengan ekornya.
Dialogue: 0,0:05:05.01,0:05:06.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayunkan pedangmu dari tempatmu!
Dialogue: 0,0:05:06.64,0:05:09.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari jarak sebegitu pun,\Nseranganmu tetap bisa melukainya!
Dialogue: 0,0:05:12.77,0:05:14.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rein, kau dengar?
Dialogue: 0,0:05:15.44,0:05:17.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak... Tidak masalah.
Dialogue: 0,0:05:17.15,0:05:18.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ekornya.
Dialogue: 0,0:05:19.02,0:05:21.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa... melompat untuk menghindarinya.
Dialogue: 0,0:05:21.40,0:05:23.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak punya stamina untuk itu!
Dialogue: 0,0:05:23.65,0:05:26.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bocah itu hanya amatir.
Dialogue: 0,0:05:27.86,0:05:29.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan...
Dialogue: 0,0:05:29.20,0:05:31.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pasti akan menusuk jantungnya!
Dialogue: 0,0:05:31.74,0:05:33.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tak bisa menghindari ekornya!
Dialogue: 0,0:05:34.00,0:05:37.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Dasar bodoh!\N- Jangan sok keren, Botak!
Dialogue: 0,0:05:37.29,0:05:38.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi jika kuayunkan pedangku di sini,
Dialogue: 0,0:05:39.00,0:05:41.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily dan Margaret akan kena.
Dialogue: 0,0:05:41.55,0:05:44.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tak akan bisa menahan hantaman pedangku!
Dialogue: 0,0:05:44.88,0:05:46.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia...
Dialogue: 0,0:05:46.09,0:05:48.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu gara-gara kita.
Dialogue: 0,0:05:48.39,0:05:49.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rein!
Dialogue: 0,0:05:49.30,0:05:52.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami akan bertahan sendiri,\Njadi ayunkan saja pedangmu!
Dialogue: 0,0:05:52.35,0:05:53.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau mengkhawatirkan itu,
Dialogue: 0,0:05:53.60,0:05:55.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita semua akan kalah!
Dialogue: 0,0:06:08.53,0:06:11.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayunkan saja!
Dialogue: 0,0:06:11.74,0:06:13.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau selalu menjijikkan!
Dialogue: 0,0:06:13.37,0:06:15.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan baju santaimu itu norak.
Dialogue: 0,0:06:15.16,0:06:17.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nenekmu yang membelikannya?
Dialogue: 0,0:06:17.16,0:06:20.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengorbanan dan risiko tak bisa dihindari\Njika kau ingin menang.
Dialogue: 0,0:06:20.46,0:06:23.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya kau tidak mengerti itu, Nak.
Dialogue: 0,0:06:24.13,0:06:25.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rein!
Dialogue: 0,0:06:31.18,0:06:33.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan itu?
Dialogue: 0,0:06:33.01,0:06:35.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah sudah kubilang, Berandal?
Dialogue: 0,0:06:38.10,0:06:40.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau terlalu naif karena kurang pengalaman.
Dialogue: 0,0:06:40.85,0:06:42.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah yang membuatmu kalah.
Dialogue: 0,0:06:43.52,0:06:46.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau yang naif.
Dialogue: 0,0:06:47.74,0:06:52.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pasti akan mendekat untuk membunuhku.
Dialogue: 0,0:06:52.20,0:06:55.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari jarak sedekat ini,\Namatir sepertiku pun bisa melakukannya.
Dialogue: 0,0:06:56.24,0:06:57.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melempar pedang ke target
Dialogue: 0,0:06:57.62,0:07:00.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan mengenainya dengan akurat!
Dialogue: 0,0:07:04.04,0:07:05.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mu-Mustahil.
Dialogue: 0,0:07:06.30,0:07:07.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatanmu...
Dialogue: 0,0:07:08.01,0:07:12.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sudah melampaui batas manusia.
Dialogue: 0,0:07:12.51,0:07:15.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah mencapai ranah dewa atau iblis.
Dialogue: 0,0:07:31.40,0:07:32.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mati.
Dialogue: 0,0:07:34.20,0:07:35.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sakit.
Dialogue: 0,0:07:36.08,0:07:37.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sakit sekali.
Dialogue: 0,0:07:40.33,0:07:45.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, aku hanya ingin\Nhidup lebih damai dan bahagia.
Dialogue: 0,0:07:45.84,0:07:50.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kepala yang di sebelah kanan\Nlebih kuat.
Dialogue: 0,0:07:50.09,0:07:51.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia selalu memukul bahuku dan mengancamku.
Dialogue: 0,0:07:51.80,0:07:53.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia memaksaku mematuhinya.
Dialogue: 0,0:07:53.68,0:07:55.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia selalu menyuruhku melakukan sesuatu.
Dialogue: 0,0:07:55.10,0:07:58.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membersihkan kotoran anjing juga tugasku.
Dialogue: 0,0:07:58.77,0:08:01.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meskipun itu anjingnya!
Dialogue: 0,0:08:01.39,0:08:03.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah muak dengan kehidupan ini.
Dialogue: 0,0:08:03.65,0:08:05.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini terlalu menyedihkan.
Dialogue: 0,0:08:05.98,0:08:08.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, sangat menyakitkan.
Dialogue: 0,0:08:11.44,0:08:13.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini? Submachine Gun?
Dialogue: 0,0:08:13.70,0:08:15.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah ini Uzi?
Dialogue: 0,0:08:15.28,0:08:16.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial.
Dialogue: 0,0:08:16.78,0:08:20.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku mau memancing simpati mereka\Nlalu menembak saat mereka lengah.
Dialogue: 0,0:08:20.79,0:08:22.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku membuat kesalahan fatal!
Dialogue: 0,0:08:22.71,0:08:24.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak kusangka kau punya benda seperti ini.
Dialogue: 0,0:08:24.92,0:08:27.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu senjata yang cukup kuat.
Dialogue: 0,0:08:27.29,0:08:29.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, tolong hentikan.
Dialogue: 0,0:08:29.30,0:08:31.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah itu terlalu kejam?
Dialogue: 0,0:08:36.29,0:08:37.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon, ampuni aku...
Dialogue: 0,0:08:48.15,0:08:52.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hampir saja... tapi aku selamat.
Dialogue: 0,0:08:52.28,0:08:55.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jantungku rusak,\Ntapi aku bisa memperbaikinya.
Dialogue: 0,0:08:55.99,0:08:59.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jalang ini terlalu takut untuk menebas naga!
Dialogue: 0,0:08:59.16,0:09:02.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sebabnya semua rekanmu terbunuh!
Dialogue: 0,0:09:03.00,0:09:07.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar bodoh! Dasar dungu! Matilah!
Dialogue: 0,0:09:15.13,0:09:18.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya, jangan pernah lengah\Nmenghadapi monster.
Dialogue: 0,0:09:20.64,0:09:22.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tidak penting. Di mana Rein?
Dialogue: 0,0:09:24.85,0:09:25.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rein!
Dialogue: 0,0:09:27.56,0:09:29.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lengan dan kaki kiriku...
Dialogue: 0,0:09:30.48,0:09:31.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana situasinya?
Dialogue: 0,0:09:32.11,0:09:34.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.
Dialogue: 0,0:09:34.65,0:09:37.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sakit. Sakit sekali.
Dialogue: 0,0:09:37.45,0:09:38.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama seperti Naga Bercahaya.
Dialogue: 0,0:09:38.45,0:09:39.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lucu sekali.
Dialogue: 0,0:09:43.45,0:09:46.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Lily, Margaret.
Dialogue: 0,0:09:46.08,0:09:46.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beri aku satu juta.
Dialogue: 0,0:09:47.00,0:09:48.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beri aku satu juta.
Dialogue: 0,0:09:49.42,0:09:50.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rein.
Dialogue: 0,0:09:50.67,0:09:53.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita berhasil mengalahkan Naga Bercahaya.
Dialogue: 0,0:09:53.30,0:09:54.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesuai rencana.
Dialogue: 0,0:09:54.38,0:09:57.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita berhasil memusatkan\Nsemua dampaknya pada satu titik.
Dialogue: 0,0:09:57.30,0:09:58.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini semua berkat kau.
Dialogue: 0,0:09:59.59,0:10:00.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak juga.
Dialogue: 0,0:10:02.64,0:10:05.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan pernah bisa\Nmengalahkannya sendirian.
Dialogue: 0,0:10:05.89,0:10:07.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini berkat kalian berdua.
Dialogue: 0,0:10:09.60,0:10:10.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sakit...
Dialogue: 0,0:10:10.69,0:10:11.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bisa berdiri?
Dialogue: 0,0:10:11.61,0:10:12.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awas!
Dialogue: 0,0:10:12.52,0:10:14.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia akan mencoba meraba dada dan bokongmu!
Dialogue: 0,0:10:14.98,0:10:16.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak akan!
Dialogue: 0,0:10:18.20,0:10:19.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sungguh menyentuhnya?
Dialogue: 0,0:10:19.41,0:10:20.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak!
Dialogue: 0,0:10:25.95,0:10:27.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rein, biar kubantu.
Dialogue: 0,0:10:27.29,0:10:28.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau yakin?
Dialogue: 0,0:10:29.83,0:10:31.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau hanya ingin merabanya.
Dialogue: 0,0:10:34.21,0:10:36.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika bukan karena zirah pemberian Margaret,
Dialogue: 0,0:10:37.01,0:10:38.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku pasti sudah mati.
Dialogue: 0,0:10:38.63,0:10:39.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga.
Dialogue: 0,0:10:39.84,0:10:41.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau tak memperkuat perlengkapanku,
Dialogue: 0,0:10:41.85,0:10:43.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tak akan selamat.
Dialogue: 0,0:10:43.30,0:10:46.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rein juga menyelamatkanku.
Dialogue: 0,0:10:46.47,0:10:49.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika bukan karena zirah pemberian Margaret,
Dialogue: 0,0:10:49.44,0:10:50.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku pasti sudah mati.
Dialogue: 0,0:10:50.35,0:10:52.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diam! Kenapa kau mengulang lagi?
Dialogue: 0,0:10:57.49,0:10:59.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyawa semua orang berharga!
Dialogue: 0,0:10:59.36,0:11:02.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mirabelle, kau tak terkecuali!
Dialogue: 0,0:11:17.80,0:11:20.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang terjadi?
Dialogue: 0,0:11:21.34,0:11:22.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mirabelle.
Dialogue: 0,0:11:22.89,0:11:25.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini orang yang memerintahkan pembunuhan...
Dialogue: 0,0:11:25.81,0:11:26.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu!
Dialogue: 0,0:11:27.93,0:11:31.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku.\NAku akan membunuh mereka lain kali.
Dialogue: 0,0:11:31.69,0:11:32.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ada apa dengan gadis ini?\N- Maafkan aku, Ibu!
Dialogue: 0,0:11:33.06,0:11:35.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia berusaha keras.
Dialogue: 0,0:11:35.44,0:11:38.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sangat menginginkan kasih sayang.
Dialogue: 0,0:11:38.36,0:11:41.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sangat menjijikkan.
Dialogue: 0,0:11:41.65,0:11:42.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mirabelle.
Dialogue: 0,0:11:42.95,0:11:47.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah kau atau orang lain,\Nkalian semua tidak berharga.
Dialogue: 0,0:11:48.08,0:11:49.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, tidak masalah jika kau dibunuh.
Dialogue: 0,0:11:49.58,0:11:50.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun...
Dialogue: 0,0:11:50.87,0:11:57.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu menyayangi Mirabelle yang patuh\Nmembunuh targetnya dan kembali.
Dialogue: 0,0:11:59.21,0:12:00.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:12:01.09,0:12:03.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sama sekali tidak berharga.
Dialogue: 0,0:12:04.93,0:12:06.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Rein.
Dialogue: 0,0:12:06.76,0:12:08.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesuai dugaanku...
Dialogue: 0,0:12:08.68,0:12:10.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tetap harus membunuhmu.
Dialogue: 0,0:12:12.10,0:12:13.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Naga Bercahaya memang hebat.
Dialogue: 0,0:12:13.85,0:12:15.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Poin Penguat naik 5 ribu.
Dialogue: 0,0:12:16.56,0:12:19.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa bertarung.
Dialogue: 0,0:12:19.90,0:12:21.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa bertarung sekarang.
Dialogue: 0,0:12:22.15,0:12:23.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei...
Dialogue: 0,0:12:23.74,0:12:25.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa berpose keren begitu?
Dialogue: 0,0:12:25.87,0:12:27.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bukan anak SMP lagi!
Dialogue: 0,0:12:27.66,0:12:29.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah berapa tahun\Nsejak musim panas waktu kelas 2 SMP?
Dialogue: 0,0:12:29.79,0:12:31.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memikirkannya saja membuatku kepanasan.
Dialogue: 0,0:12:31.33,0:12:32.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemanasan global memang tak ada habisnya.
Dialogue: 0,0:12:33.00,0:12:34.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang kau mau apa?
Dialogue: 0,0:12:34.92,0:12:37.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunjukkan pose keren itu lagi.
Dialogue: 0,0:12:37.29,0:12:38.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diam.
Dialogue: 0,0:12:43.68,0:12:45.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan berani-berani menyentuh mereka.
Dialogue: 0,0:12:46.01,0:12:47.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mirabelle si pembunuh...
Dialogue: 0,0:12:48.47,0:12:51.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bahkan lebih lambat\Ndaripada kali pertama kita bertemu.
Dialogue: 0,0:12:51.39,0:12:53.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bahkan\Ntidak menyembunyikan hawa keberadaanmu.
Dialogue: 0,0:12:53.89,0:12:54.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mirabelle.
Dialogue: 0,0:12:55.48,0:12:56.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan mendekat!
Dialogue: 0,0:13:03.36,0:13:04.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rein.
Dialogue: 0,0:13:04.78,0:13:06.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sangat baik kepadaku.
Dialogue: 0,0:13:07.12,0:13:09.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bahkan bilang aku berharga.
Dialogue: 0,0:13:09.53,0:13:12.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu membuatku sedikit bahagia.
Dialogue: 0,0:13:13.54,0:13:15.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi karena itu,
Dialogue: 0,0:13:15.08,0:13:17.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku mulai merasa orang lain juga berharga.
Dialogue: 0,0:13:17.38,0:13:19.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bahkan ingin menghargai mereka.
Dialogue: 0,0:13:21.67,0:13:23.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perasaan apa ini?
Dialogue: 0,0:13:23.72,0:13:25.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang terjadi kepadaku?
Dialogue: 0,0:13:26.30,0:13:30.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dulu kupikir manusia sama saja\Ndengan serangga atau binatang buas.
Dialogue: 0,0:13:31.10,0:13:33.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya gumpalan daging.
Dialogue: 0,0:13:34.43,0:13:35.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi jika aku merasa seperti ini...
Dialogue: 0,0:13:36.31,0:13:38.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tidak akan bisa membunuh siapa pun lagi!
Dialogue: 0,0:13:39.61,0:13:43.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika terus begini, kau akan membuatku...
Dialogue: 0,0:13:44.86,0:13:47.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dibuang Ibu.
Dialogue: 0,0:13:48.99,0:13:49.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku.
Dialogue: 0,0:13:49.91,0:13:50.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia meminta maaf...
Dialogue: 0,0:13:51.20,0:13:52.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu...
Dialogue: 0,0:13:52.95,0:13:56.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mirabelle, aku akan membantumu\Nmemikirkan sesuatu.
Dialogue: 0,0:13:56.41,0:13:59.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bisa memikirkannya sambil jalan.
Dialogue: 0,0:13:59.58,0:14:01.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mirabelle, ikutlah dengan kami.
Dialogue: 0,0:14:03.55,0:14:06.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau lupa alasanmu datang ke sini?
Dialogue: 0,0:14:10.30,0:14:11.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini kotoran!
Dialogue: 0,0:14:11.22,0:14:14.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sombong! Cepat selamatkan aku!
Dialogue: 0,0:14:14.60,0:14:18.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seksi...
Dialogue: 0,0:14:18.19,0:14:19.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei!
Dialogue: 0,0:14:19.10,0:14:19.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mirabelle!
Dialogue: 0,0:14:20.02,0:14:21.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar bocah ingusan!
Dialogue: 0,0:14:21.40,0:14:23.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat bunuh mereka!
Dialogue: 0,0:14:24.03,0:14:26.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerjaku sudah sepadan dengan bayaranku.
Dialogue: 0,0:14:26.78,0:14:28.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika aku tidak melawan Naga Bercahaya,
Dialogue: 0,0:14:28.40,0:14:29.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}semua orang pasti sudah mati.
Dialogue: 0,0:14:29.78,0:14:31.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa peduli? Bunuh saja mereka!
Dialogue: 0,0:14:31.62,0:14:33.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bunuh mereka sekarang!
Dialogue: 0,0:14:33.24,0:14:34.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau tak membunuh mereka,
Dialogue: 0,0:14:34.20,0:14:37.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ibumu tak akan menyayangimu lagi!
Dialogue: 0,0:14:37.16,0:14:40.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rein mungkin memberitahumu\Nbahwa manusia berharga,
Dialogue: 0,0:14:40.92,0:14:43.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi semua itu bohong!
Dialogue: 0,0:14:43.46,0:14:44.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bohong?
Dialogue: 0,0:14:44.38,0:14:45.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja!
Dialogue: 0,0:14:45.67,0:14:48.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia terpaksa berbohong\Nsupaya tidak kau bunuh!
Dialogue: 0,0:14:48.63,0:14:50.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja Rein akan berbohong!
Dialogue: 0,0:14:50.89,0:14:53.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kurasa dia tidak berbohong.
Dialogue: 0,0:14:53.43,0:14:59.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, menurutmu Rein ingin berteman\Ndan main boling denganmu tiap akhir pekan?
Dialogue: 0,0:14:59.60,0:15:01.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mirabelle.
Dialogue: 0,0:15:01.19,0:15:03.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan lupa\Nkau sudah membunuh puluhan orang.
Dialogue: 0,0:15:03.23,0:15:06.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang normal mana mau\Nberurusan dengan orang sepertimu.
Dialogue: 0,0:15:06.44,0:15:08.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kau akan dianggap berbahaya.
Dialogue: 0,0:15:08.57,0:15:10.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang sepertimu\Nbukan hanya tidak berharga, kau ancaman.
Dialogue: 0,0:15:10.70,0:15:12.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa yang bisa menyayangimu?
Dialogue: 0,0:15:13.03,0:15:14.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya ibumu!
Dialogue: 0,0:15:14.66,0:15:18.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, tetaplah di sisi ibumu\Ndan terus membunuh, seperti biasa.
Dialogue: 0,0:15:19.41,0:15:20.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah cukup bicaranya?
Dialogue: 0,0:15:20.92,0:15:23.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mirabelle berusaha keras untuk berubah.
Dialogue: 0,0:15:23.50,0:15:25.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kau bisa\Nmengatakan hal sekejam itu?
Dialogue: 0,0:15:26.00,0:15:27.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Semuanya, kalian dengar itu?
Dialogue: 0,0:15:27.76,0:15:29.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omongan sok suci barusan.
Dialogue: 0,0:15:29.30,0:15:31.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kedengarannya seperti\Norang yang nonton drama
Dialogue: 0,0:15:31.43,0:15:33.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sambil memeluk anjing\Ndi ruang tamu yang hangat.
Dialogue: 0,0:15:35.43,0:15:38.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bukan bohong! Itu bukan bohong!
Dialogue: 0,0:15:39.06,0:15:41.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sakit sekali!
Dialogue: 0,0:15:41.23,0:15:42.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Percayalah kepadaku, Mirabelle.
Dialogue: 0,0:15:43.06,0:15:45.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manusia tidak berharga.\NKau hanya punya ibumu.
Dialogue: 0,0:15:45.61,0:15:47.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membunuh adalah yang terbaik!\NHidup pembunuhan!
Dialogue: 0,0:15:47.69,0:15:49.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bohong, Mirabelle!
Dialogue: 0,0:15:49.53,0:15:52.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan percaya orang\Nyang bilang manusia tidak berharga!
Dialogue: 0,0:15:54.24,0:15:56.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mengerti!
Dialogue: 0,0:15:56.37,0:15:58.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, akan kuperjelas!
Dialogue: 0,0:15:58.95,0:16:01.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mirabelle, kau pembunuh massal.
Dialogue: 0,0:16:01.58,0:16:02.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kau tidak berharga.
Dialogue: 0,0:16:03.00,0:16:03.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedangkan orang lain,
Dialogue: 0,0:16:04.04,0:16:06.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}misalnya, orang asing di jalanan...
Dialogue: 0,0:16:06.29,0:16:09.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hidup itu punya nilai!
Dialogue: 0,0:16:09.59,0:16:13.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Punya nilai...\N- Astaga, Rein! Kenapa kau berteriak?
Dialogue: 0,0:16:13.38,0:16:18.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Punya nilai...
Dialogue: 0,0:16:19.02,0:16:20.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mirabelle.
Dialogue: 0,0:16:20.86,0:16:24.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rein berusaha memberitahumu\Nbahwa manusia berharga.
Dialogue: 0,0:16:25.98,0:16:29.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mirabelle, ada seseorang di sini\Nyang berusaha keras untukmu.
Dialogue: 0,0:16:29.90,0:16:34.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah itu saja sudah membuktikan\Nbetapa berharganya dirimu?
Dialogue: 0,0:16:39.79,0:16:43.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rein juga pernah mengatakan\Nhal serupa padaku.
Dialogue: 0,0:16:44.29,0:16:45.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat itu, aku...
Dialogue: 0,0:16:45.71,0:16:46.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei!
Dialogue: 0,0:16:47.04,0:16:48.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mengagetkanku!
Dialogue: 0,0:16:54.51,0:16:55.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu goblin!
Dialogue: 0,0:16:56.18,0:16:59.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf! Ini salahku\Nkarena berteriak begitu keras.
Dialogue: 0,0:16:59.81,0:17:00.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi...
Dialogue: 0,0:17:00.72,0:17:02.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang baru diam, sudah telat!
Dialogue: 0,0:17:02.23,0:17:03.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mirabelle!
Dialogue: 0,0:17:03.98,0:17:05.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamatkan aku!
Dialogue: 0,0:17:05.14,0:17:05.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:17:06.06,0:17:07.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sungguh akan membiarkanku mati?
Dialogue: 0,0:17:07.69,0:17:09.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti kau memang mau membunuhku!
Dialogue: 0,0:17:09.94,0:17:12.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada akhirnya, kau tetap pembunuh!
Dialogue: 0,0:17:12.56,0:17:14.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ayo lari.\N- Ternyata kau sama tidak berharganya!
Dialogue: 0,0:17:14.70,0:17:15.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Abaikan saja omong kosong itu.\N- Mulai sekarang, kau akan tetap...
Dialogue: 0,0:17:15.99,0:17:17.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Abaikan saja omong kosong itu.\N- Dengarkan saja Ibu dan jadilah pembunuh.
Dialogue: 0,0:17:17.24,0:17:18.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- "Sial."\N- Dengarkan Ibu dan jadilah pembunuh.
Dialogue: 0,0:17:18.16,0:17:21.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Aku akan tinggalkan luka di hatimu\Nmeski aku mati. Dah."
Dialogue: 0,0:17:21.36,0:17:23.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mungkin berpikir begitu.
Dialogue: 0,0:17:25.79,0:17:26.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat sekali!
Dialogue: 0,0:17:26.71,0:17:27.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mirabelle, apa yang kau lakukan?
Dialogue: 0,0:17:27.96,0:17:30.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cornelius, aku akan memberi tahu Ibu\Ndengan jelas.
Dialogue: 0,0:17:31.96,0:17:33.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berharga.
Dialogue: 0,0:17:34.30,0:17:36.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku tidak akan membunuh\Nsiapa pun lagi.
Dialogue: 0,0:17:37.34,0:17:38.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekalipun...
Dialogue: 0,0:17:39.05,0:17:42.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu meninggalkanku, aku tidak apa-apa.
Dialogue: 0,0:17:42.93,0:17:46.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena aku akan menemukan rekan\Nyang bisa kupercaya,
Dialogue: 0,0:17:46.56,0:17:49.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang mau berjuang demi satu sama lain.
Dialogue: 0,0:17:51.69,0:17:52.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mirabelle!
Dialogue: 0,0:17:52.61,0:17:53.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Goblin...
Dialogue: 0,0:17:54.15,0:17:55.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi,
Dialogue: 0,0:17:55.61,0:18:00.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tak akan menggunakan\Nkekuatan ini untuk membunuh!
Dialogue: 0,0:18:02.70,0:18:04.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menggunakannya\Nuntuk menyelamatkan nyawa!
Dialogue: 0,0:18:15.88,0:18:17.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luar biasa!
Dialogue: 0,0:18:18.63,0:18:20.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mengalahkan mereka dalam satu serangan!
Dialogue: 0,0:18:22.56,0:18:24.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal Cornelius, jangan khawatir.
Dialogue: 0,0:18:25.93,0:18:27.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kuat.
Dialogue: 0,0:18:30.73,0:18:33.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan membiarkan\NCornelius menyakiti kalian lagi.
Dialogue: 0,0:18:33.94,0:18:35.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berjanji.
Dialogue: 0,0:18:36.57,0:18:37.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu akan sangat membantu.
Dialogue: 0,0:18:39.03,0:18:39.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mirabelle.
Dialogue: 0,0:18:40.74,0:18:42.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutmu seperti apa\NPedang Bercahaya Kaisar Naga?
Dialogue: 0,0:18:44.33,0:18:45.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entahlah.
Dialogue: 0,0:18:45.70,0:18:46.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau melihatnya?
Dialogue: 0,0:18:49.04,0:18:50.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:18:50.17,0:18:52.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh? Kalau begitu,\Ntidak akan kutunjukkan.
Dialogue: 0,0:18:52.63,0:18:54.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pulanglah dengan Cornelius hari ini.
Dialogue: 0,0:18:55.21,0:18:56.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:18:56.26,0:18:57.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diam, Mata Putih.
Dialogue: 0,0:18:57.72,0:19:02.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mungkin takut, dan butuh keberanian\Nuntuk menyatakan perasaanmu kepada ibumu.
Dialogue: 0,0:19:02.60,0:19:05.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku yakin kau bisa melakukannya.
Dialogue: 0,0:19:05.60,0:19:08.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, cari aku setelah kau memberitahunya.
Dialogue: 0,0:19:08.10,0:19:09.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti akan kutunjukkan pedangnya.
Dialogue: 0,0:19:13.48,0:19:15.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan datang setelah memberi tahu Ibu!
Dialogue: 0,0:19:15.61,0:19:16.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja.
Dialogue: 0,0:19:17.78,0:19:19.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, janji, ya. Semoga berhasil.
Dialogue: 0,0:19:25.45,0:19:28.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rupanya Rein terkadang bisa serius.
Dialogue: 0,0:19:28.16,0:19:29.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:19:29.37,0:19:30.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudmu?
Dialogue: 0,0:19:30.79,0:19:32.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku selalu serius.
Dialogue: 0,0:19:33.17,0:19:34.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat wajah serius itu.
Dialogue: 0,0:19:34.09,0:19:35.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia benar-benar mengatakannya\Ndengan wajah datar.
Dialogue: 0,0:19:35.71,0:19:37.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa dia marah?
Dialogue: 0,0:19:37.46,0:19:41.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku selalu berhasil di saat penting, 'kan?
Dialogue: 0,0:19:41.09,0:19:43.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal kau berteriak\Nsampai memancing para goblin?
Dialogue: 0,0:19:43.14,0:19:46.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau juga bertingkah konyol\Ndi saat yang tidak tepat!
Dialogue: 0,0:19:48.06,0:19:49.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hi-hi!
Dialogue: 0,0:19:49.56,0:19:50.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menjijikkan.
Dialogue: 0,0:19:50.60,0:19:52.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhentilah tersenyum seperti itu.
Dialogue: 0,0:19:58.15,0:20:01.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang legendaris memang hebat.
Dialogue: 0,0:20:01.61,0:20:05.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat bersemangat dan gugup\Nsampai hampir tidak bisa bernapas...
Dialogue: 0,0:20:05.57,0:20:06.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Napasmu memang sudah habis dari tadi.
Dialogue: 0,0:20:11.79,0:20:13.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak salah lagi.
Dialogue: 0,0:20:15.63,0:20:16.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu Lefaid.
Dialogue: 0,0:20:19.59,0:20:22.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, Rein. Itu pedangmu.
Dialogue: 0,0:20:22.38,0:20:23.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:20:40.61,0:20:42.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, ini...
Dialogue: 0,0:20:43.45,0:20:44.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lefaid.
Dialogue: 0,0:20:50.62,0:20:55.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku penasaran seberapa besar aku tumbuh\Nselama petualangan ini.
Dialogue: 0,0:21:00.55,0:21:03.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kurasa pemandangan yang Rein lihat\Ndari atas sana
Dialogue: 0,0:21:03.63,0:21:06.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pasti berbeda dari sebelumnya, 'kan?
Dialogue: 0,0:21:06.76,0:21:07.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau benar.
Dialogue: 0,0:21:08.05,0:21:10.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin begitu.
Dialogue: 0,0:21:10.60,0:21:12.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian juga berpikir begitu, 'kan?
Dialogue: 0,0:21:12.89,0:21:14.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:21:28.78,0:21:29.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terang sekali.
Dialogue: 0,0:23:03.50,0:23:04.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat pagi.
Dialogue: 0,0:23:06.26,0:23:08.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuacanya juga bagus hari ini.
Dialogue: 0,0:23:14.64,0:23:15.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hampir lupa.
Dialogue: 0,0:23:28.07,0:23:29.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tidak bermain "Tebak aku di mana."
Dialogue: 0,0:23:31.20,0:23:32.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hi-hi!
