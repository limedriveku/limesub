Dialogue: 0,0:00:51.96,0:00:54.57,sign,,0000,0000,0000,,THE LAID-OFF CHEAT-GRANTING MAGE\NENJOYS A SECOND LEASE ON LIFE
Dialogue: 0,0:04:38.15,0:04:40.57,sign,,0000,0000,0000,,EP. 04 KARENA SUDAH DUA KALI DIGIGIT\NSAAT TELANJANG BULAT,
Dialogue: 0,0:04:40.65,0:04:43.15,sign,,0000,0000,0000,,AKU JADI PAHAM PERASAAN ORANG\NYANG DIGIGIT SAAT TELANJANG
Dialogue: 0,0:07:11.22,0:07:12.72,sign,,0000,0000,0000,,"FOTO SEKSI PERTAMA"
Dialogue: 0,0:12:41.17,0:12:42.72,sign,,0000,0000,0000,,"PEDANG BERCAHAYA KAISAR NAGA"
Dialogue: 0,0:00:05.88,0:00:08.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu kau ingin serius, tapi...
Dialogue: 0,0:00:08.75,0:00:10.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata kau hanya orang bodoh.
Dialogue: 0,0:00:10.88,0:00:15.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tak penasaran kenapa tak ada\Nyang memakai baju zirah seperti itu?
Dialogue: 0,0:00:15.84,0:00:19.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada seorang pun di Taring Raja Binatang\Nyang memakai baju zirah begitu, 'kan?
Dialogue: 0,0:00:19.56,0:00:20.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira mereka,
Dialogue: 0,0:00:20.85,0:00:23.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau Lily dan Margaret,
Dialogue: 0,0:00:23.19,0:00:27.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hanya belum mendapatkannya.
Dialogue: 0,0:00:27.19,0:00:30.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kupikir kalau aku pakai ini,
Dialogue: 0,0:00:30.19,0:00:32.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalian bakal iri setengah mati.
Dialogue: 0,0:00:32.61,0:00:33.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyebalkan sekali.
Dialogue: 0,0:00:33.70,0:00:35.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira aku bisa meremehkanmu\Ndan menertawakanmu!
Dialogue: 0,0:00:35.95,0:00:37.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kepribadianmu juga buruk!
Dialogue: 0,0:02:09.21,0:02:10.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya,
Dialogue: 0,0:02:10.78,0:02:14.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku memilih jadi penyihir pengimbuh,\Nbukan petualang,
Dialogue: 0,0:02:14.80,0:02:16.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bukan karena alasan khusus.
Dialogue: 0,0:02:16.26,0:02:17.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sadarlah.
Dialogue: 0,0:02:17.55,0:02:19.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kurasa
Dialogue: 0,0:02:19.13,0:02:20.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku pasti tanpa sadar
Dialogue: 0,0:02:20.51,0:02:23.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}memilih jalan yang tidak menuntut\Ntanggung jawab berat.
Dialogue: 0,0:02:24.35,0:02:26.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau petualang,
Dialogue: 0,0:02:26.64,0:02:29.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}setiap tindakanmu\Nbisa membuat orang lain terluka.
Dialogue: 0,0:02:31.48,0:02:34.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rupanya dia punya sisi serius.
Dialogue: 0,0:02:34.23,0:02:35.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa begitu.
Dialogue: 0,0:02:35.90,0:02:37.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku takut sekarang.
Dialogue: 0,0:02:38.11,0:02:39.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku takut kehilangan kalian berdua.
Dialogue: 0,0:02:40.41,0:02:41.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Reruntuhan Naga Bercahaya
Dialogue: 0,0:02:41.99,0:02:44.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di dekat Gadressa,\Nibu kota Kerajaan Naga Timur,
Dialogue: 0,0:02:44.91,0:02:46.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tempat itu pasti sangat berbahaya.
Dialogue: 0,0:02:48.04,0:02:50.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika aku mengkhawatirkan bahaya,
Dialogue: 0,0:02:50.50,0:02:54.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}orang sepertiku tidak boleh bertualang lagi.
Dialogue: 0,0:02:54.34,0:02:57.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu, aku akan pergi\Nke Reruntuhan Naga Bercahaya.
Dialogue: 0,0:02:58.30,0:03:00.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus pergi.
Dialogue: 0,0:03:02.55,0:03:05.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika Lily pergi, aku juga ikut.
Dialogue: 0,0:03:05.31,0:03:07.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus mencari tahu kenapa kakakku mati.
Dialogue: 0,0:03:07.10,0:03:07.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:03:08.81,0:03:12.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kalau mati di tengah jalan,\Ntujuanmu tidak akan tercapai, 'kan?
Dialogue: 0,0:03:13.19,0:03:14.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu benar...
Dialogue: 0,0:03:14.36,0:03:17.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu kau di reruntuhan,\Nkau bisa lengah terhadap keadaan sekitar.
Dialogue: 0,0:03:17.44,0:03:20.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum tentu kau bisa mundur\Ntepat waktu saat ada bahaya.
Dialogue: 0,0:03:20.99,0:03:24.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku punya permintaan.
Dialogue: 0,0:03:25.53,0:03:28.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin kau mengizinkanku\Nmenjadi pemimpin dalam petualangan ini.
Dialogue: 0,0:03:29.71,0:03:32.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau, yang paling tidak berpengalaman?
Dialogue: 0,0:03:32.96,0:03:35.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau masih tidak bisa berhenti bercanda.
Dialogue: 0,0:03:35.79,0:03:39.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja, aku masih butuh\Npengalaman dan nasihat kalian.
Dialogue: 0,0:03:39.21,0:03:42.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kurasa aku bisa tetap lebih tenang\Ndaripada kalian berdua.
Dialogue: 0,0:03:42.59,0:03:45.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, biar aku yang memutuskan\Nkapan kita mundur.
Dialogue: 0,0:03:46.26,0:03:48.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau memutuskan mundur,\Nkami harus mendengarkanmu.
Dialogue: 0,0:03:48.89,0:03:50.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu maksudmu?
Dialogue: 0,0:03:50.93,0:03:53.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalaupun mundur,\Nkita pasti akan kembali untuk mencoba lagi.
Dialogue: 0,0:03:53.85,0:03:54.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa, 'kan?
Dialogue: 0,0:03:58.65,0:03:59.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini...
Dialogue: 0,0:03:59.86,0:04:02.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuserahkan keputusannya\Nkepada kalian berdua.
Dialogue: 0,0:04:02.61,0:04:04.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti, Rein.
Dialogue: 0,0:04:04.36,0:04:05.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau akan menjadi pemimpin kami.
Dialogue: 0,0:04:05.78,0:04:06.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus.
Dialogue: 0,0:04:07.58,0:04:09.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang, letakkan perlengkapan kalian\Ndi meja.
Dialogue: 0,0:04:10.04,0:04:11.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kuperkuat dengan sihir pengimbuh.
Dialogue: 0,0:04:12.00,0:04:13.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tidak perlu.
Dialogue: 0,0:04:13.50,0:04:14.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berapa kali harus kukatakan?
Dialogue: 0,0:04:14.58,0:04:16.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang aku tidak butuh.
Dialogue: 0,0:04:16.33,0:04:17.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa!
Dialogue: 0,0:04:17.29,0:04:18.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senjatamu boleh tidak diperkuat,
Dialogue: 0,0:04:19.05,0:04:21.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi zirahmu harus diperkuat.
Dialogue: 0,0:04:21.80,0:04:23.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus memastikan\Nsemua orang kembali dengan selamat.
Dialogue: 0,0:04:23.93,0:04:25.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu keputusanku sebagai pemimpin.
Dialogue: 0,0:04:27.05,0:04:29.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, ini tujuanmu\Nsaat mengajukan diri menjadi pemimpin?
Dialogue: 0,0:04:30.06,0:04:30.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:04:33.85,0:04:35.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, kuserahkan kepadamu,
Dialogue: 0,0:04:35.85,0:04:36.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemimpin.
Dialogue: 0,0:04:47.99,0:04:48.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily.
Dialogue: 0,0:04:48.91,0:04:52.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menambahkan 300 Poin Penguat\Nke zirah ini.
Dialogue: 0,0:04:52.20,0:04:55.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan kemampuanku saat ini, hanya sebegini\Nyang bisa kuberikan ke zirah orang lain.
Dialogue: 0,0:04:55.58,0:04:57.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tiga ratus?
Dialogue: 0,0:04:57.79,0:05:02.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyihir pengimbuh kelas atas saja\Ncuma bisa menambahkan tiga sampai lima poin.
Dialogue: 0,0:05:03.05,0:05:04.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Angka sebesar itu...
Dialogue: 0,0:05:04.59,0:05:05.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tidak masuk akal.
Dialogue: 0,0:05:05.88,0:05:07.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Margaret.
Dialogue: 0,0:05:07.30,0:05:09.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kulihat zirahmu.
Dialogue: 0,0:05:10.06,0:05:14.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku selalu bisa sendiri\Ntanpa berutang budi kepada siapa pun,
Dialogue: 0,0:05:14.48,0:05:16.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan aku tidak berniat berutang budi padamu.
Dialogue: 0,0:05:16.94,0:05:18.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini tidak ada hubungannya\Ndengan berutang budi.
Dialogue: 0,0:05:19.44,0:05:21.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akan bertualang bersama.
Dialogue: 0,0:05:21.11,0:05:23.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya melakukan apa yang kubisa.
Dialogue: 0,0:05:23.57,0:05:24.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kita rekan.
Dialogue: 0,0:05:25.82,0:05:27.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rekan?
Dialogue: 0,0:05:30.58,0:05:31.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakakku...
Dialogue: 0,0:05:32.66,0:05:35.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia selalu memercayai rekan-rekannya,
Dialogue: 0,0:05:36.25,0:05:38.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi dia kehilangan nyawanya\Ndalam petualangan.
Dialogue: 0,0:05:38.67,0:05:40.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu artinya bahkan rekan yang kau percaya\Nsepenuh hati
Dialogue: 0,0:05:40.71,0:05:43.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin akan meninggalkanmu pada akhirnya.
Dialogue: 0,0:05:44.09,0:05:47.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, aku tidak butuh rekan.
Dialogue: 0,0:05:49.18,0:05:51.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tapi...\N- Cukup.
Dialogue: 0,0:05:51.81,0:05:52.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan pergi.
Dialogue: 0,0:05:52.89,0:05:55.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai jumpa saat waktunya berangkat.
Dialogue: 0,0:05:59.40,0:06:00.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pergi saja!
Dialogue: 0,0:06:11.74,0:06:13.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Margaret.
Dialogue: 0,0:06:13.16,0:06:15.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau makan hot pot bersama kami?
Dialogue: 0,0:06:17.46,0:06:21.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Separuh petualang yang ikut ke sana tewas.
Dialogue: 0,0:06:22.38,0:06:25.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar wanita itu membuat kesalahan bodoh.
Dialogue: 0,0:06:25.26,0:06:28.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan "rekan"-nya mati karena dia.
Dialogue: 0,0:06:32.10,0:06:36.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin lebih menyenangkan\Nbertualang dengan rekan.
Dialogue: 0,0:06:36.64,0:06:39.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita mungkin bisa saling menjaga.
Dialogue: 0,0:06:39.81,0:06:40.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:06:41.06,0:06:44.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}rekan itu ibarat madu yang bercampur racun.
Dialogue: 0,0:06:44.86,0:06:46.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa pun situasinya,
Dialogue: 0,0:06:46.49,0:06:48.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku selalu mengatasi bahaya\Ndengan kemampuanku sendiri.
Dialogue: 0,0:06:50.11,0:06:51.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, ayo jalan-jalan...
Dialogue: 0,0:06:56.29,0:06:58.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kau lakukan, Rein?
Dialogue: 0,0:06:58.96,0:07:00.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menunggumu.
Dialogue: 0,0:07:00.87,0:07:03.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sambil telanjang dan digigit anjing?
Dialogue: 0,0:07:03.09,0:07:05.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pakaianku sudah diperkuat.
Dialogue: 0,0:07:05.55,0:07:08.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru tangan orang yang memukulku\Nyang bakal remuk.
Dialogue: 0,0:07:08.55,0:07:11.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agar gigi anjing tidak patah\Nsaat menggigitku,
Dialogue: 0,0:07:11.22,0:07:12.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku harus telanjang demi anjing itu.
Dialogue: 0,0:07:12.80,0:07:14.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau telanjang demi anjing?
Dialogue: 0,0:07:14.81,0:07:16.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau baik-baik saja?
Dialogue: 0,0:07:17.10,0:07:18.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Aku baik-baik saja.\N- Sungguh.
Dialogue: 0,0:07:18.39,0:07:22.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah berapa kali kubilang\Njangan makan makanan aneh?
Dialogue: 0,0:07:22.10,0:07:24.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Dia bicara dengan anjingnya, bukan aku.\N- Tolong hati-hati.
Dialogue: 0,0:07:24.98,0:07:27.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Dan dia sangat sopan padanya.\N- Itu penuh kuman dan parasit.
Dialogue: 0,0:07:27.48,0:07:29.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Dia bahkan bicara sopan ke anjingnya.\N- Jadi, harus dimasak sebelum dimakan.
Dialogue: 0,0:07:29.90,0:07:33.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Dia tidak membuka diri kepada siapa pun.\N- Paling aman dimasak sampai matang.
Dialogue: 0,0:07:35.87,0:07:37.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika aku tidak memperkuat zirahnya,
Dialogue: 0,0:07:37.74,0:07:40.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tidak bisa membiarkan tuanmu\Nikut dengan kami.
Dialogue: 0,0:07:40.33,0:07:42.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, sampai dia setuju zirahnya kuperkuat,
Dialogue: 0,0:07:42.08,0:07:43.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan menunggu di sini.
Dialogue: 0,0:07:49.63,0:07:52.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selesai. Sudah kutambahkan 300 Poin Penguat.
Dialogue: 0,0:07:55.55,0:07:57.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan tidak ada goresan sedikit pun.
Dialogue: 0,0:07:57.31,0:07:58.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana menurutmu, Margaret?
Dialogue: 0,0:07:58.77,0:07:59.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luar biasa, 'kan?
Dialogue: 0,0:07:59.89,0:08:03.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga. Dia mungkin\Nbenar-benar menambahkan 300.
Dialogue: 0,0:08:03.40,0:08:06.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika zirah Lily juga sekuat itu,
Dialogue: 0,0:08:06.82,0:08:09.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku takkan bisa membunuhnya\Ndengan pedang ini.
Dialogue: 0,0:08:10.19,0:08:11.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rein.
Dialogue: 0,0:08:11.11,0:08:13.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisakah kau memperkuat pedang ini juga?
Dialogue: 0,0:08:15.95,0:08:17.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rein, ambil ini juga.
Dialogue: 0,0:08:18.54,0:08:20.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini zirah cadanganku.
Dialogue: 0,0:08:20.50,0:08:22.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuberikan sebagai ucapan terima kasih.
Dialogue: 0,0:08:22.50,0:08:25.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bukan rekan siapa pun.
Dialogue: 0,0:08:25.38,0:08:27.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang kita impas.
Dialogue: 0,0:08:30.05,0:08:31.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pergi, Margaret.
Dialogue: 0,0:08:34.97,0:08:35.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan ini,
Dialogue: 0,0:08:36.01,0:08:39.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku bisa membunuhnya\Nbegitu staminanya terkuras.
Dialogue: 0,0:08:41.35,0:08:42.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rein, ada apa?
Dialogue: 0,0:08:42.73,0:08:44.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau lupa...
Dialogue: 0,0:08:45.85,0:08:48.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cornelius dari Taring Raja Binatang.
Dialogue: 0,0:08:48.65,0:08:49.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan...
Dialogue: 0,0:08:49.61,0:08:51.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa kau?
Dialogue: 0,0:08:51.19,0:08:54.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bergabunglah dengan kami\Nuntuk menculik Rein.
Dialogue: 0,0:08:54.70,0:08:58.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian lupa sudah dipukul mundur waktu itu?
Dialogue: 0,0:08:58.20,0:08:59.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, buat apa aku bekerja sama\Ndengan orang lemah...
Dialogue: 0,0:08:59.74,0:09:00.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami akan masuk.
Dialogue: 0,0:09:00.79,0:09:02.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, tunggu!
Dialogue: 0,0:09:02.87,0:09:04.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong jangan masuk begitu saja...
Dialogue: 0,0:09:06.50,0:09:07.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:09:07.88,0:09:11.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bersamamu,\Nkami pasti bisa menculiknya.
Dialogue: 0,0:09:12.13,0:09:15.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asisten Guild Master Taring Raja Binatang,
Dialogue: 0,0:09:15.47,0:09:16.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Glenda.
Dialogue: 0,0:09:18.14,0:09:21.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taring Raja Binatang punya kebijakan baru.
Dialogue: 0,0:09:21.39,0:09:22.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami culik dan penjarakan Rein,
Dialogue: 0,0:09:22.90,0:09:25.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu memaksanya memakai\Nsihir pengimbuh setiap hari.
Dialogue: 0,0:09:25.64,0:09:27.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan sihir pengimbuh sekuat itu,
Dialogue: 0,0:09:27.60,0:09:30.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami bisa segera menutup kekurangan anggota.
Dialogue: 0,0:09:30.61,0:09:33.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kalian yang mencari Rein...
Dialogue: 0,0:09:33.61,0:09:35.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cornelius.
Dialogue: 0,0:09:35.24,0:09:37.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menyuruhmu mencari pembunuh.
Dialogue: 0,0:09:38.78,0:09:41.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa berandal ini orangnya?
Dialogue: 0,0:09:42.04,0:09:43.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pembunuh?
Dialogue: 0,0:09:43.66,0:09:47.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya bocah begini\Nbisa mengalahkan Lily?
Dialogue: 0,0:09:47.33,0:09:49.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar tak berguna.
Dialogue: 0,0:09:51.25,0:09:52.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diam kau, Tante.
Dialogue: 0,0:09:53.55,0:09:54.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan membunuhmu.
Dialogue: 0,0:10:09.19,0:10:11.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Co-Cornelius!
Dialogue: 0,0:10:11.48,0:10:13.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kau lakukan?
Dialogue: 0,0:10:13.36,0:10:17.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak peduli dengan Taring Raja Binatang.
Dialogue: 0,0:10:17.11,0:10:20.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang penting adalah membunuh Rein dan Lily.
Dialogue: 0,0:10:20.20,0:10:21.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika tidak, aku akan diremehkan
Dialogue: 0,0:10:21.83,0:10:25.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di dunia petualang selamanya.
Dialogue: 0,0:10:32.50,0:10:33.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mirabelle.
Dialogue: 0,0:10:34.00,0:10:36.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kini aku sudah melihat kemampuanmu.
Dialogue: 0,0:10:36.84,0:10:40.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku secara resmi mempekerjakanmu\Nuntuk membunuh Rein dan Lily.
Dialogue: 0,0:10:40.59,0:10:42.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bayaranmu.
Dialogue: 0,0:10:43.68,0:10:45.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Margaret.
Dialogue: 0,0:10:46.56,0:10:48.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan mayatnya kepada kami.
Dialogue: 0,0:10:48.73,0:10:52.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong kosong.\NAku sendiri yang akan membunuh Lily.
Dialogue: 0,0:10:52.65,0:10:55.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asalkan kau janji tidak menghalangiku.
Dialogue: 0,0:10:55.65,0:10:59.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanggal keberangkatan, tujuan,\Ndan perlengkapan Rein dan Lily...
Dialogue: 0,0:10:59.91,0:11:01.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa memberitahumu semuanya.
Dialogue: 0,0:11:02.45,0:11:05.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah dengar\Nsoal dendam antara kau dan Lily.
Dialogue: 0,0:11:05.20,0:11:06.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku takkan ikut campur.
Dialogue: 0,0:11:07.00,0:11:10.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski kau menyuruhku berhenti,
Dialogue: 0,0:11:10.21,0:11:13.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tetap akan membunuh Rein.
Dialogue: 0,0:11:54.46,0:11:56.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu Kota Kerajaan, Gadressa.
Dialogue: 0,0:12:07.35,0:12:11.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jaraknya sekitar dua jam naik kereta kuda\Ndari ibu kota.
Dialogue: 0,0:12:21.86,0:12:23.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya kita sampai.
Dialogue: 0,0:12:24.62,0:12:27.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dungeon yang paling sulit ditaklukkan...
Dialogue: 0,0:12:27.99,0:12:29.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Reruntuhan Naga Bercahaya.
Dialogue: 0,0:12:30.66,0:12:32.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Reruntuhan Naga Bercahaya...
Dialogue: 0,0:12:33.46,0:12:37.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Konon, di dalam reruntuhan ini\Ntersimpan sebuah pedang.
Dialogue: 0,0:12:37.24,0:12:40.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang yang memancarkan cahaya\Ndan memiliki kekuatan naga.
Dialogue: 0,0:12:41.17,0:12:42.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang Bercahaya Kaisar Naga.
Dialogue: 0,0:12:42.80,0:12:46.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di reruntuhan di pinggiran Gadressa,\NKerajaan Naga Timur,
Dialogue: 0,0:12:46.30,0:12:49.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pedang itu dijaga naga peringkat tinggi.
Dialogue: 0,0:12:59.82,0:13:02.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuil yang sangat besar.
Dialogue: 0,0:13:04.45,0:13:05.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily.
Dialogue: 0,0:13:05.74,0:13:09.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisakah kau memberi tahu kami ciri-ciri\Ntempat ini dan apa yang harus kami waspadai?
Dialogue: 0,0:13:10.45,0:13:12.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Margaret.
Dialogue: 0,0:13:12.70,0:13:15.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak ingat apa pun soal reruntuhan ini.
Dialogue: 0,0:13:15.92,0:13:21.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya ingat perasaan tidak berdaya\Ndan putus asa saat itu.
Dialogue: 0,0:13:21.71,0:13:24.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya. Kalau begitu, ayo masuk.
Dialogue: 0,0:13:27.80,0:13:29.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini konyol.
Dialogue: 0,0:13:30.85,0:13:33.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengaku tidak ingat apa pun...
Dialogue: 0,0:13:33.68,0:13:35.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana mungkin?
Dialogue: 0,0:13:37.69,0:13:39.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luar biasa.
Dialogue: 0,0:13:39.65,0:13:41.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, ini dungeon-nya?
Dialogue: 0,0:13:41.44,0:13:43.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melihat-lihat tanpa tujuan itu berbahaya.
Dialogue: 0,0:13:44.49,0:13:45.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku...
Dialogue: 0,0:13:45.99,0:13:49.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku masih percaya Lily meninggalkan\Nsemua orang dan melarikan diri.
Dialogue: 0,0:13:49.78,0:13:51.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana menurutmu, Rein?
Dialogue: 0,0:13:52.04,0:13:54.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa tidak.
Dialogue: 0,0:13:54.83,0:13:55.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sebabnya aku
Dialogue: 0,0:13:55.83,0:13:57.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ingin memanfaatkan kesempatan ini\Nuntuk mencari tahu kebenarannya,
Dialogue: 0,0:13:57.54,0:14:00.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}agar kalian berdua bisa berbaikan.
Dialogue: 0,0:14:00.21,0:14:01.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:14:01.38,0:14:04.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakakmu dan Lily pernah menjadi rekan, 'kan?
Dialogue: 0,0:14:04.80,0:14:08.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin dia ingin kalian berdua berbaikan.
Dialogue: 0,0:14:10.35,0:14:13.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah menyelidiki Lily.
Dialogue: 0,0:14:14.18,0:14:16.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga dengar\Nkau tidak bisa bertarung lagi.
Dialogue: 0,0:14:17.06,0:14:18.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi karena kau di sini,
Dialogue: 0,0:14:18.94,0:14:20.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}rumor itu pasti bohong juga.
Dialogue: 0,0:14:21.82,0:14:23.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau masih bisa bertarung, 'kan?
Dialogue: 0,0:14:24.53,0:14:28.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily masih gemetar setiap kali harus\Nbertarung dan tidak bisa memegang pedang.
Dialogue: 0,0:14:28.57,0:14:30.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tak bisa melakukan apa pun.
Dialogue: 0,0:14:30.16,0:14:34.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi dia bersedia berbagi pengetahuan\Ndan pengalamannya dengan pemula sepertiku.
Dialogue: 0,0:14:34.58,0:14:37.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sebabnya aku bersamanya sekarang.
Dialogue: 0,0:14:37.75,0:14:39.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah muak.
Dialogue: 0,0:14:40.08,0:14:41.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Margaret.
Dialogue: 0,0:14:42.00,0:14:44.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kau kemari meski tak bisa bertarung?
Dialogue: 0,0:14:45.88,0:14:47.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bercanda?
Dialogue: 0,0:14:48.26,0:14:50.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kalian berdua bodoh?
Dialogue: 0,0:14:51.39,0:14:56.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada akhirnya,\Nhanya aku yang menganggap ini serius.
Dialogue: 0,0:15:13.28,0:15:15.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka bilang ini sulit ditaklukkan,
Dialogue: 0,0:15:15.29,0:15:18.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi ada goblin juga di sini.
Dialogue: 0,0:15:19.58,0:15:21.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, dasar sampah!
Dialogue: 0,0:15:32.30,0:15:35.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily, alasanku di sini sekarang
Dialogue: 0,0:15:35.68,0:15:38.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah karena aku khawatir\Nkau akan menyembunyikan bukti masa lalu.
Dialogue: 0,0:15:39.52,0:15:42.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata kau cuma pengecut.
Dialogue: 0,0:15:42.40,0:15:44.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena sudah sejauh ini,
Dialogue: 0,0:15:44.19,0:15:46.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku harus terus maju, meski sendirian!
Dialogue: 0,0:15:50.82,0:15:53.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini gawat. Mereka semua\Nmenerjang kita secara bersamaan.
Dialogue: 0,0:15:53.66,0:15:56.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal mereka bisa saja\Ntak sengaja saling tusuk!
Dialogue: 0,0:15:56.79,0:15:59.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pantas saja disebut sulit ditaklukkan!
Dialogue: 0,0:16:03.67,0:16:04.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily?
Dialogue: 0,0:16:04.59,0:16:05.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bergerak. Jangan bangun!
Dialogue: 0,0:16:17.26,0:16:18.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Margaret,
Dialogue: 0,0:16:20.56,0:16:24.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku khawatir zirahku\Ntidak akan kuat menahan serangan mereka.
Dialogue: 0,0:16:24.69,0:16:25.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat ketakutan.
Dialogue: 0,0:16:29.07,0:16:31.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bisa bergerak dengan baik, 'kan?
Dialogue: 0,0:16:32.49,0:16:37.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah kau bilang akan gemetar\Nsaat memikirkan pertarungan?
Dialogue: 0,0:16:41.33,0:16:45.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lain kali,\Nkuharap kau mau menghunus pedangmu.
Dialogue: 0,0:16:47.59,0:16:48.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar sekali.
Dialogue: 0,0:16:57.51,0:17:01.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan tetap bersama kalian\Nmulai sekarang.
Dialogue: 0,0:17:01.52,0:17:02.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah.
Dialogue: 0,0:17:07.85,0:17:08.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rein?
Dialogue: 0,0:17:09.60,0:17:11.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa aku mendengar sesuatu.
Dialogue: 0,0:17:11.19,0:17:15.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku lebih penasaran dengan kekuatan\Npedang Rein yang tidak wajar...
Dialogue: 0,0:17:24.21,0:17:26.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Runtuh! Lari!
Dialogue: 0,0:17:26.07,0:17:29.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seranganmu selalu berlebihan!
Dialogue: 0,0:17:29.80,0:17:32.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berapa Poin Penguat yang kau tambahkan?
Dialogue: 0,0:17:32.76,0:17:33.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, ini...
Dialogue: 0,0:17:34.51,0:17:35.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang terjadi?
Dialogue: 0,0:17:35.55,0:17:36.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rein, di belakangmu!
Dialogue: 0,0:17:43.81,0:17:44.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan kemari!
Dialogue: 0,0:18:01.08,0:18:02.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak peduli dia hidup atau mati!
Dialogue: 0,0:18:02.87,0:18:04.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak perlu melihat begitu dekat!
Dialogue: 0,0:18:08.38,0:18:10.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku selamat.
Dialogue: 0,0:18:10.46,0:18:13.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kita benar-benar tersesat.
Dialogue: 0,0:18:13.26,0:18:14.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rein.
Dialogue: 0,0:18:14.76,0:18:17.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa pedangmu patah lagi?
Dialogue: 0,0:18:17.22,0:18:19.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berapa pedang yang kau bawa?
Dialogue: 0,0:18:20.72,0:18:22.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku masih punya lebih dari 20.
Dialogue: 0,0:18:23.31,0:18:25.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu pedang murahan\Nyang sudah diperkuat patah,
Dialogue: 0,0:18:25.35,0:18:27.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku bisa menarik kembali poinnya
Dialogue: 0,0:18:27.19,0:18:29.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan memindahkannya ke pedang baru.
Dialogue: 0,0:18:29.61,0:18:32.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biasanya aku membawa\Ndua pedang yang sudah diperkuat.
Dialogue: 0,0:18:32.98,0:18:35.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk saat ini, ini pendekatan terbaik.
Dialogue: 0,0:18:35.61,0:18:38.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata kau pakai otak juga.
Dialogue: 0,0:18:38.57,0:18:40.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan memindahkan poinnya sekarang.
Dialogue: 0,0:18:40.20,0:18:41.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu aku sebentar.
Dialogue: 0,0:18:43.83,0:18:46.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian bisa mengobrol sambil menunggu.
Dialogue: 0,0:18:52.17,0:18:53.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuacanya bagus hari ini.
Dialogue: 0,0:18:53.59,0:18:55.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, benar.
Dialogue: 0,0:18:58.38,0:18:59.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak masuk ke reruntuhan ini,
Dialogue: 0,0:19:00.05,0:19:02.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa kau sudah ingat sesuatu?
Dialogue: 0,0:19:03.93,0:19:06.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama sekali tidak.
Dialogue: 0,0:19:15.44,0:19:16.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempat ini...
Dialogue: 0,0:19:18.45,0:19:22.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami lewat sini saat aku di sini sebelumnya.
Dialogue: 0,0:19:23.91,0:19:27.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersama semua orang...
Dialogue: 0,0:19:29.08,0:19:30.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kita terus melangkah maju,
Dialogue: 0,0:19:30.96,0:19:33.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku yakin akan ingat lebih banyak.
Dialogue: 0,0:19:38.34,0:19:40.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Monster terakhir itu...
Dialogue: 0,0:19:41.09,0:19:44.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika dia masih berdiri\Nsetelah terkena serangan telak seperti itu,
Dialogue: 0,0:19:45.76,0:19:48.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}maka pedang ini tak cukup.
Dialogue: 0,0:19:48.10,0:19:50.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak bisa melindungi mereka seperti ini.
Dialogue: 0,0:19:51.10,0:19:54.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus mendapatkan\NPedang Bercahaya Kaisar Naga.
Dialogue: 0,0:19:59.95,0:20:01.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini koin emas kuno!
Dialogue: 0,0:20:02.99,0:20:06.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini harta karun pertama\Nyang kutemukan dalam petualangan.
Dialogue: 0,0:20:06.70,0:20:08.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku petualang sungguhan sekarang.
Dialogue: 0,0:20:08.83,0:20:10.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rein.
Dialogue: 0,0:20:10.21,0:20:11.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang baru saja kau ambil?
Dialogue: 0,0:20:11.79,0:20:14.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu harta karun? Serahkan.
Dialogue: 0,0:20:14.54,0:20:17.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesuai tradisi, jarahan dibagi rata\Nke semua anggota.
Dialogue: 0,0:20:17.67,0:20:21.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau disimpan sendiri,\Nbisa memicu pertengkaran.
Dialogue: 0,0:20:21.47,0:20:22.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Tidak mungkin.
Dialogue: 0,0:20:23.09,0:20:24.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong jangan bertengkar!
Dialogue: 0,0:20:24.64,0:20:25.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan.
Dialogue: 0,0:20:25.55,0:20:27.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang ini kenapa? Dia menyebalkan.
Dialogue: 0,0:20:28.93,0:20:30.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini koin emas yang bagus.
Dialogue: 0,0:20:30.10,0:20:31.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:20:34.98,0:20:36.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh, Margaret?
Dialogue: 0,0:20:37.07,0:20:40.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu. Kau menyelamatkan nyawaku tadi.
Dialogue: 0,0:20:40.40,0:20:41.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rein.
Dialogue: 0,0:20:42.70,0:20:45.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bisa menyimpan koin ini sebagai suvenir.
Dialogue: 0,0:20:45.24,0:20:46.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi sekali ini saja.
Dialogue: 0,0:20:50.04,0:20:52.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily, Margaret...
Dialogue: 0,0:20:52.71,0:20:54.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih!
Dialogue: 0,0:20:54.75,0:20:56.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah selesai memindahkan poinnya?
Dialogue: 0,0:20:56.71,0:20:58.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo terus bergerak.
Dialogue: 0,0:20:58.88,0:20:59.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo.
Dialogue: 0,0:21:07.26,0:21:08.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang lain lagi.
Dialogue: 0,0:21:09.26,0:21:10.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa lagi kali ini?
Dialogue: 0,0:21:10.35,0:21:12.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akan membagi\Napa pun itu mulai sekarang.
Dialogue: 0,0:21:13.64,0:21:16.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang ini buatku saja, boleh?
Dialogue: 0,0:21:16.10,0:21:18.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu kertas? Apa yang tertulis di sana?
Dialogue: 0,0:21:18.27,0:21:21.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bikin penasaran.\NBeri tahu kami.
Dialogue: 0,0:21:23.90,0:21:28.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Kami dibunuh oleh Lily Flambert."
Dialogue: 0,0:21:29.83,0:21:31.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa tulisannya?
Dialogue: 0,0:21:31.95,0:21:33.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba kulihat, Rein.
Dialogue: 0,0:21:33.46,0:21:35.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini...
Dialogue: 0,0:21:35.96,0:21:37.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong biarkan aku melihatnya.
Dialogue: 0,0:21:37.38,0:21:39.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau menyembunyikannya, Rein?
Dialogue: 0,0:21:42.55,0:21:44.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah, tenanglah.
Dialogue: 0,0:21:44.30,0:21:47.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan memasukkan ini ke bajuku.
Dialogue: 0,0:21:48.14,0:21:50.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bajuku sudah diperkuat habis-habisan.
Dialogue: 0,0:21:50.76,0:21:52.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak akan sobek sekeras apa pun\Nkalian menariknya.
Dialogue: 0,0:21:53.77,0:21:54.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berikan!
Dialogue: 0,0:21:54.85,0:21:57.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pakaianku tidak ditingkatkan!
Dialogue: 0,0:21:57.19,0:21:58.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jaga sikapmu dan biarkan aku melihatnya!
Dialogue: 0,0:21:58.31,0:21:59.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keluarkan sekarang!
Dialogue: 0,0:21:59.65,0:22:01.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan!
Dialogue: 0,0:22:01.11,0:22:03.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kalian tarik sekeras itu...
