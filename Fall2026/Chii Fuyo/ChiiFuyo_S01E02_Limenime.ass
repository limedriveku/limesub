Dialogue: 0,0:03:01.20,0:03:03.35,sign,,0000,0000,0000,,"DRAP DRAP DRAP"
Dialogue: 0,0:11:45.98,0:11:48.47,sign,,0000,0000,0000,,EP. 02 SETELAH BAJU YANG DIPERKUAT\NHANCUR OLEH SERANGAN TELAK,
Dialogue: 0,0:11:48.47,0:11:50.97,sign,,0000,0000,0000,,AKU JUGA TERKENA SERANGAN PEMUNGKAS\NDARI BAJU SANTAI SANG GADIS TRAUMA.
Dialogue: 0,0:17:14.89,0:17:16.51,sign,,0000,0000,0000,,BRUK BRUK BRUK
Dialogue: 0,0:00:01.20,0:00:03.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama dua tahun terakhir,
Dialogue: 0,0:00:03.65,0:00:06.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku hanya berdiam diri\Ndi suatu ruangan di Kristal Biru.
Dialogue: 0,0:00:07.20,0:00:10.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini pertama kalinya aku keluar\Ndari bangunan itu setelah dua tahun lamanya.
Dialogue: 0,0:00:10.50,0:00:12.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak pernah keluar\Nselama dua tahun penuh?
Dialogue: 0,0:00:12.70,0:00:14.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Y-Ya!
Dialogue: 0,0:00:14.95,0:00:18.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa... bertarung lagi.
Dialogue: 0,0:00:19.05,0:00:20.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku selalu seperti ini,
Dialogue: 0,0:00:20.85,0:00:25.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sejak gagal menyelesaikan quest\Ndan nyaris terbunuh dua tahun yang lalu.
Dialogue: 0,0:00:26.04,0:00:28.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setiap kali tahu pertarungan akan dimulai,
Dialogue: 0,0:00:28.90,0:00:31.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}napasku akan tersendat-sendat,\Ndan tanganku gemetar hebat.
Dialogue: 0,0:00:31.79,0:00:34.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bahkan tak bisa menggenggam pedang lagi.
Dialogue: 0,0:00:34.70,0:00:37.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tak akan bisa paham, Rein!
Dialogue: 0,0:00:38.10,0:00:40.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus, kenapa Lily ikut pergi denganku?
Dialogue: 0,0:00:40.35,0:00:41.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be-Berisik kau!
Dialogue: 0,0:00:41.99,0:00:43.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bicara sekali lagi, dan kau akan kubunuh!
Dialogue: 0,0:00:43.60,0:00:45.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita di sini untuk membunuh naga, 'kan?
Dialogue: 0,0:00:45.64,0:00:47.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau ini cerewet banget, ya!
Dialogue: 0,0:00:49.70,0:00:51.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada burung yang cantik.
Dialogue: 0,0:00:51.35,0:00:52.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:00:56.24,0:00:58.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu, sih, naga!
Dialogue: 0,0:01:12.95,0:01:15.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}The Laid-Off Cheat-Granting Mage\NEnjoys a Second Lease on Life
Dialogue: 0,0:02:40.80,0:02:43.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Naganya datang, Rein.
Dialogue: 0,0:02:43.05,0:02:44.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat pergi dari sini...
Dialogue: 0,0:02:45.80,0:02:47.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa yang kau lakukan?!
Dialogue: 0,0:02:47.40,0:02:49.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily sudah pastikan sendiri, 'kan?
Dialogue: 0,0:02:49.52,0:02:51.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baju ini sudah diperkuat.
Dialogue: 0,0:02:51.69,0:02:53.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bajumu mungkin sudah diperkuat sedikit,
Dialogue: 0,0:02:53.30,0:02:55.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- tapi mustahil kau bisa...\N- Tidak apa-apa.
Dialogue: 0,0:02:55.85,0:02:58.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau hanya perlu berdiri di belakangku.
Dialogue: 0,0:03:01.20,0:03:03.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo berangkat sekarang juga!
Dialogue: 0,0:03:05.29,0:03:07.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat. Ada burung yang cantik.
Dialogue: 0,0:03:07.55,0:03:09.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin aku bisa percaya padamu?!
Dialogue: 0,0:03:09.55,0:03:11.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenangkan dirimu, Lily.
Dialogue: 0,0:03:11.15,0:03:13.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Naga itu tidak seram, tidak seram.
Dialogue: 0,0:03:13.25,0:03:15.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru kau yang lebih menyeramkan, tahu!
Dialogue: 0,0:03:15.05,0:03:17.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau itu orang gila! Tidak waras!
Dialogue: 0,0:04:05.20,0:04:06.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Naganya pergi, deh.
Dialogue: 0,0:04:06.75,0:04:08.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Naganya akan segera kembali.
Dialogue: 0,0:04:08.80,0:04:11.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daripada itu, apa yang barusan kau lakukan?
Dialogue: 0,0:04:11.20,0:04:13.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang,\Nmenahan serangannya pakai baju ini.
Dialogue: 0,0:04:13.35,0:04:15.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemampuan defensif baju ini\Ntinggi sekali, lo.
Dialogue: 0,0:04:17.39,0:04:19.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan urusan menyerang naga padaku juga.
Dialogue: 0,0:04:19.50,0:04:22.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku janji seranganku akan kena.
Dialogue: 0,0:04:22.59,0:04:23.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pakai pedang ini.
Dialogue: 0,0:04:24.25,0:04:25.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jelek amat.
Dialogue: 0,0:04:27.50,0:04:28.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu takut.
Dialogue: 0,0:04:29.64,0:04:32.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang akan kalahkan naganya!
Dialogue: 0,0:04:36.19,0:04:37.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo?
Dialogue: 0,0:04:41.85,0:04:46.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku masih tidak sanggup menghunus pedang\Ndalam situasi seperti ini...
Dialogue: 0,0:04:47.25,0:04:48.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Andai saja aku tidak ketakutan,
Dialogue: 0,0:04:49.29,0:04:51.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}melawan makhluk itu pasti perkara mudah.
Dialogue: 0,0:04:52.05,0:04:54.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily, maaf sudah membuatmu khawatir.
Dialogue: 0,0:04:55.55,0:04:57.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan tahan apinya pakai baju pelindung,
Dialogue: 0,0:04:57.45,0:04:59.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan terus menyerang sampai kena.
Dialogue: 0,0:05:00.10,0:05:01.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan dia ini?
Dialogue: 0,0:05:01.90,0:05:04.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia cuma amatir yang tidak tahu apa-apa,
Dialogue: 0,0:05:04.35,0:05:05.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi berani sesumbar...
Dialogue: 0,0:05:06.40,0:05:07.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku...
Dialogue: 0,0:05:08.25,0:05:10.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku, pasti bisa lebih...!
Dialogue: 0,0:05:12.39,0:05:14.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti bisa melakukannya dengan lebih baik!
Dialogue: 0,0:05:14.91,0:05:16.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily?
Dialogue: 0,0:05:16.24,0:05:18.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Naganya pasti bisa menghindar\Nkalau kau serang dari sini!
Dialogue: 0,0:05:18.55,0:05:19.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pancing lebih dekat!
Dialogue: 0,0:05:19.79,0:05:21.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan panik. Tunggu dengan sabar.
Dialogue: 0,0:05:21.99,0:05:23.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}O-Oke!
Dialogue: 0,0:05:23.55,0:05:25.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak kita habisi sekarang,\Nkita yang akan mati!
Dialogue: 0,0:05:25.64,0:05:29.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pastikan ini serangan terakhir\Nyang kau terima pakai baju itu!
Dialogue: 0,0:05:30.30,0:05:33.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak, kita yang akan kalah!
Dialogue: 0,0:05:33.25,0:05:34.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengerti.
Dialogue: 0,0:05:34.85,0:05:37.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kurang paham, sih,\Ntapi kalau Lily yang bilang, aku percaya.
Dialogue: 0,0:05:43.05,0:05:43.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang!
Dialogue: 0,0:06:07.05,0:06:08.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Absurd banget.
Dialogue: 0,0:06:09.25,0:06:11.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya berkat arahan Lily.
Dialogue: 0,0:06:11.40,0:06:12.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, ya!
Dialogue: 0,0:06:13.10,0:06:15.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Sama-sama.
Dialogue: 0,0:06:16.05,0:06:18.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang ini juga bisa mengalahkan naga.
Dialogue: 0,0:06:19.05,0:06:21.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata aku benar-benar bisa bertarung.
Dialogue: 0,0:06:23.60,0:06:25.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang sudah uzur, sih.
Dialogue: 0,0:06:25.00,0:06:27.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya karena daya serangannya meningkat,
Dialogue: 0,0:06:27.15,0:06:29.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bukan berarti daya tahannya juga ikut naik.
Dialogue: 0,0:06:31.09,0:06:33.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keren! Bajunya juga hancur!
Dialogue: 0,0:06:33.39,0:06:37.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata kau benar, Lily, waktu bilang\Nitu serangan api yang terakhir...
Dialogue: 0,0:06:37.25,0:06:38.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan mendekat!
Dialogue: 0,0:06:49.65,0:06:50.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa malah tidur lagi?!
Dialogue: 0,0:06:52.30,0:06:53.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily.
Dialogue: 0,0:06:55.40,0:06:57.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sedang tidur.
Dialogue: 0,0:06:57.05,0:07:01.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anggap saja semua perkataanku ini\Nhanya ocehan orang yang sedang mengigau.
Dialogue: 0,0:07:02.44,0:07:05.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku pergi dan gugur\Nkarena melawan naga seorang diri,
Dialogue: 0,0:07:05.80,0:07:09.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau bilang Kristal Biru\Nakan dikritik banyak orang, 'kan?
Dialogue: 0,0:07:09.25,0:07:12.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entahlah. Mungkin aku pernah bilang begitu.
Dialogue: 0,0:07:12.60,0:07:17.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika saat itu petualang peringkat S\Nseperti Lily pergi bersamaku
Dialogue: 0,0:07:17.20,0:07:19.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan kita berdua gugur\Nsaat mengerjakan quest,
Dialogue: 0,0:07:19.35,0:07:22.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}maka orang-orang akan berpikir\Nbahwa naganya yang kuat.
Dialogue: 0,0:07:24.05,0:07:28.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan begitu,\Ntidak ada yang akan mengkritik Kristal Biru
Dialogue: 0,0:07:28.59,0:07:31.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan reputasi mereka tetap terjaga.
Dialogue: 0,0:07:32.10,0:07:34.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk seseorang yang belum bisa bertarung,
Dialogue: 0,0:07:34.30,0:07:38.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}membuang nyawa adalah satu-satunya\Ncara untuk bisa berguna.
Dialogue: 0,0:07:38.30,0:07:41.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutku, itulah yang Lily pikirkan tadi.
Dialogue: 0,0:07:42.79,0:07:47.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi metode itu tidak akan membuat\Nanggota Kristal Biru senang.
Dialogue: 0,0:07:48.35,0:07:51.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika Lily tidak menjaga diri dan meninggal,
Dialogue: 0,0:07:51.50,0:07:55.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mereka akan jauh lebih sedih\Ndibandingkan saat dikritik orang lain.
Dialogue: 0,0:07:57.75,0:07:59.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kupikir kau mau katakan hal penting,
Dialogue: 0,0:07:59.90,0:08:02.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ternyata memang sedang mengigau.
Dialogue: 0,0:08:02.55,0:08:03.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, ya?
Dialogue: 0,0:08:06.55,0:08:09.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kri-Kristal Biru-lah yang tetap memungut
Dialogue: 0,0:08:09.50,0:08:14.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sampah sepertiku yang sudah\Ntidak bisa bertarung lagi.
Dialogue: 0,0:08:14.90,0:08:17.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, hari ini, aku...
Dialogue: 0,0:08:18.24,0:08:19.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini, aku...
Dialogue: 0,0:08:21.80,0:08:24.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ingin melakukan sesuatu untuk mereka.
Dialogue: 0,0:08:25.90,0:08:27.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku.
Dialogue: 0,0:08:29.25,0:08:30.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:08:31.65,0:08:35.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku janji akan bisa bertarung lagi.
Dialogue: 0,0:08:35.65,0:08:41.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, jangan ceritakan\Nkejadian hari ini pada siapa pun.
Dialogue: 0,0:08:41.59,0:08:43.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Aku mengerti.
Dialogue: 0,0:08:51.45,0:08:54.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dada dan pahanya empuk banget, top markotop!
Dialogue: 0,0:08:55.60,0:08:57.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dadaku tidak pernah mengenaimu!
Dialogue: 0,0:08:57.60,0:08:59.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Aduh! Tinjunya keras banget.\N- Berisik, berisik!
Dialogue: 0,0:08:59.72,0:09:01.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bodoh, bodoh, bodoh, bodoh!
Dialogue: 0,0:09:04.45,0:09:05.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily.
Dialogue: 0,0:09:05.60,0:09:08.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa pakai sihir pengimbuh\Nke atas pedang dan baju pelindung.
Dialogue: 0,0:09:09.29,0:09:11.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku tak punya pengalaman bertarung.
Dialogue: 0,0:09:14.39,0:09:15.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, Lily...
Dialogue: 0,0:09:15.90,0:09:18.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau mau bertualang bersamaku?
Dialogue: 0,0:09:18.85,0:09:22.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang sekarang membutuhkanmu, Lily.
Dialogue: 0,0:09:27.35,0:09:30.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Mohon bantuannya, Rein.
Dialogue: 0,0:09:33.95,0:09:35.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba lihat mereka berdua.
Dialogue: 0,0:09:36.26,0:09:39.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rupanya aku tidak perlu\Npergi menengok mereka.
Dialogue: 0,0:09:39.80,0:09:40.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pulang, ah.
Dialogue: 0,0:09:43.40,0:09:45.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Naga peringkat menengah memang keren!
Dialogue: 0,0:09:45.39,0:09:47.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa dapat sampai 700 poin!
Dialogue: 0,0:09:47.89,0:09:51.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus, terus, kita apakan bangkai naganya?
Dialogue: 0,0:09:51.59,0:09:53.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bisa serahkan ke regu pembongkaran.
Dialogue: 0,0:09:53.85,0:09:55.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Regu pembongkaran!
Dialogue: 0,0:09:55.50,0:09:56.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, deh. Kita pulang...
Dialogue: 0,0:09:56.59,0:09:57.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:09:57.70,0:10:00.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kenapa?!\N- Keburu malam kalau pulang sekarang.
Dialogue: 0,0:10:00.04,0:10:01.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Lily, Lily, Lily!\N- Aku bawa persediaan.
Dialogue: 0,0:10:01.55,0:10:03.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Eh, Lily! Lily!\N- Kita berkemah saja di dekat sini.
Dialogue: 0,0:10:06.84,0:10:09.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat, apinya besar sekali!
Dialogue: 0,0:10:09.70,0:10:13.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa, sih, yang membuatnya segirang ini\Nsejak tadi?
Dialogue: 0,0:10:13.75,0:10:17.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily, aku senang banget bisa jadi petualang.
Dialogue: 0,0:10:17.00,0:10:18.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata seseru ini, ya!
Dialogue: 0,0:10:19.40,0:10:22.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oalah. Rupanya karena itu.
Dialogue: 0,0:10:22.10,0:10:23.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apanya?
Dialogue: 0,0:10:23.70,0:10:25.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada.
Dialogue: 0,0:10:27.95,0:10:28.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily?
Dialogue: 0,0:10:32.45,0:10:33.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waspada.
Dialogue: 0,0:10:34.35,0:10:37.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Empat... Ada enam orang yang datang.
Dialogue: 0,0:10:37.65,0:10:38.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat.
Dialogue: 0,0:10:39.30,0:10:40.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teropongnya bagus banget!
Dialogue: 0,0:10:40.70,0:10:43.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kau lihat ke mana, sih?\NCepat pakai itu!
Dialogue: 0,0:10:46.15,0:10:47.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka...
Dialogue: 0,0:10:48.50,0:10:50.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Petualang dari Taring Raja Binatang.
Dialogue: 0,0:10:51.96,0:10:54.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelihatannya bakal ribet banget.
Dialogue: 0,0:10:54.55,0:10:59.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi mereka semua tidak ada\Ndi guild saat aku dipecat.
Dialogue: 0,0:11:00.70,0:11:05.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin mereka masih mengira\Naku anggota guild mereka.
Dialogue: 0,0:11:05.20,0:11:06.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gampang kalau begitu.
Dialogue: 0,0:11:06.60,0:11:09.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pura-pura masih jadi teman mereka saja.
Dialogue: 0,0:11:09.60,0:11:11.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mau!
Dialogue: 0,0:11:11.10,0:11:14.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kan sudah jadi anggota Kristal Biru!
Dialogue: 0,0:11:14.15,0:11:16.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kalau Rein bilang,
Dialogue: 0,0:11:16.36,0:11:19.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Aku sudah dipecat dan melepas Poin Penguat\Ndari perlengkapan kalian,"
Dialogue: 0,0:11:19.75,0:11:21.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}nanti kita malah bertengkar, lo.
Dialogue: 0,0:11:21.90,0:11:23.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau itu, sih...
Dialogue: 0,0:11:26.10,0:11:27.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Li-Lily?!
Dialogue: 0,0:11:27.60,0:11:29.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa buka baju?!
Dialogue: 0,0:11:29.65,0:11:32.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau pakai ini,\Nmereka akan sadar kalau aku petualang.
Dialogue: 0,0:11:32.49,0:11:34.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan pura-pura jadi gadis kota.
Dialogue: 0,0:11:35.85,0:11:38.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti, kau bawa kostum untuk menyamar?
Dialogue: 0,0:11:42.85,0:11:44.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini baju santaiku.
Dialogue: 0,0:11:44.00,0:11:45.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baju santaimu norak banget, ya!
Dialogue: 0,0:11:52.04,0:11:55.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo, Rein. Lama tidak ketemu.
Dialogue: 0,0:11:55.60,0:11:57.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedang apa di sini?
Dialogue: 0,0:11:57.70,0:11:59.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peringatan tiga tahun meninggalnya ayahku!
Dialogue: 0,0:11:59.90,0:12:03.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibuku bawel sekali menyuruhku\Nsering-sering pulang ke rumah.
Dialogue: 0,0:12:03.35,0:12:07.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi waktu pulang,\Nmalah berisik suruh menikah,
Dialogue: 0,0:12:07.15,0:12:08.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kasih cucu, suruh cepat-cepat
Dialogue: 0,0:12:08.89,0:12:10.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- bawa calon ke rumah, pokoknya berisik.\N- Kau bicara apa, sih?
Dialogue: 0,0:12:11.09,0:12:12.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kau yang di sana...
Dialogue: 0,0:12:12.89,0:12:14.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan Lily Flambert...
Dialogue: 0,0:12:14.53,0:12:15.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak saja.
Dialogue: 0,0:12:15.90,0:12:18.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak yang bilang aku mirip dengannya.
Dialogue: 0,0:12:18.35,0:12:20.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saking seringnya, aku sampai jengkel sendiri!
Dialogue: 0,0:12:20.79,0:12:24.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asli. Lily Flambert sialan itu\Nbikin aku mual saja!
Dialogue: 0,0:12:24.20,0:12:25.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:12:25.45,0:12:28.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dan Lily satu SMP,\Nkami pergi ziarah bersama!
Dialogue: 0,0:12:30.00,0:12:31.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namanya juga sama-sama Lily, ya?
Dialogue: 0,0:12:32.00,0:12:33.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Y-Ya, benar.
Dialogue: 0,0:12:33.89,0:12:35.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya aku kesal sekali!
Dialogue: 0,0:12:35.90,0:12:38.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily yang itu mungkin seorang petualang,
Dialogue: 0,0:12:38.10,0:12:40.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku hanya gadis kota biasa!
Dialogue: 0,0:12:40.45,0:12:41.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:12:41.39,0:12:44.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin Lily Flambert\Nada di tempat seperti ini.
Dialogue: 0,0:12:44.75,0:12:46.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setuju.
Dialogue: 0,0:12:46.10,0:12:49.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya, sekarang dia tiap hari\Nhanya gemetar dan ngompol di kasur.
Dialogue: 0,0:12:49.45,0:12:50.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}He-Hei!
Dialogue: 0,0:12:50.50,0:12:52.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan pedulikan aku.
Dialogue: 0,0:12:52.20,0:12:53.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:12:53.25,0:12:54.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rein.
Dialogue: 0,0:12:56.50,0:12:58.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau kenal mereka?
Dialogue: 0,0:12:58.39,0:12:59.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:13:00.00,0:13:04.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka anggota guild lain yang berpapasan\Ndengan kami saat mengerjakan quest.
Dialogue: 0,0:13:04.79,0:13:06.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya ada tiga orang lagi,
Dialogue: 0,0:13:06.79,0:13:08.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi mereka semua banyak tingkah,
Dialogue: 0,0:13:08.60,0:13:11.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan mati saat sedang kuberi pelajaran.
Dialogue: 0,0:13:13.40,0:13:14.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:13:14.34,0:13:17.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa maksudmu mereka mati?
Dialogue: 0,0:13:17.30,0:13:19.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka kelihatan ketakutan,
Dialogue: 0,0:13:19.09,0:13:21.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebaiknya kau bebaskan mereka berdua.
Dialogue: 0,0:13:21.15,0:13:23.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih terlalu dini untuk itu. Ya, 'kan?
Dialogue: 0,0:13:24.95,0:13:29.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku tidak sanggup lagi!
Dialogue: 0,0:13:35.80,0:13:37.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga.
Dialogue: 0,0:13:38.49,0:13:41.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daya serang busurnya menurun.
Dialogue: 0,0:13:41.16,0:13:43.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurun dengan drastis pula.
Dialogue: 0,0:13:43.75,0:13:45.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan senjataku saja.
Dialogue: 0,0:13:45.30,0:13:47.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perlengkapan mereka juga sama.
Dialogue: 0,0:13:47.95,0:13:51.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu pula yang membuat kami gagal\Nmenyelesaikan quest kali ini.
Dialogue: 0,0:13:53.75,0:13:55.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang benar saja!
Dialogue: 0,0:14:02.95,0:14:05.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rein, kebetulan sekali aku bertemu denganmu.
Dialogue: 0,0:14:05.95,0:14:09.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perkuat lagi senjata kami\Ndengan sihir pengimbuhmu.
Dialogue: 0,0:14:09.59,0:14:12.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku tidak sudi...
Dialogue: 0,0:14:12.40,0:14:16.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah kenapa, Rein sedang tidak bisa\Npakai sihir pengimbuhnya.
Dialogue: 0,0:14:16.10,0:14:17.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa katamu?
Dialogue: 0,0:14:18.35,0:14:20.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar tidak berguna.
Dialogue: 0,0:14:20.40,0:14:23.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pikir kenapa kau masih hidup\Nhari ini, Rein?!
Dialogue: 0,0:14:23.20,0:14:25.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan! Aku...
Dialogue: 0,0:14:25.20,0:14:26.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rein.
Dialogue: 0,0:14:26.85,0:14:28.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kubur mayatnya.
Dialogue: 0,0:14:28.69,0:14:30.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mungkin tak bisa pakai sihir pengimbuh,
Dialogue: 0,0:14:30.55,0:14:32.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kau bisa mengisi peranmu\Ndengan cara ini.
Dialogue: 0,0:14:32.75,0:14:33.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dibiarkan saja,
Dialogue: 0,0:14:33.90,0:14:36.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}nanti ada hewan buas yang datang\Nkarena mencium bau darah.
Dialogue: 0,0:14:36.85,0:14:38.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perempuan yang pintar.
Dialogue: 0,0:14:38.95,0:14:41.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau aku sekalian "isi" kau juga?
Dialogue: 0,0:14:41.60,0:14:42.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu, terima kasih.
Dialogue: 0,0:14:44.85,0:14:46.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku suka dia.
Dialogue: 0,0:14:47.05,0:14:50.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau harus mencontoh Lily si Gadis Kota itu.
Dialogue: 0,0:14:53.50,0:14:55.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily, maaf, ya.
Dialogue: 0,0:14:55.90,0:14:57.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk apa?
Dialogue: 0,0:14:57.00,0:15:00.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pernah bekerja di Taring Raja Binatang,
Dialogue: 0,0:15:00.30,0:15:03.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku baru tahu\Nmereka melakukan ini di luar guild.
Dialogue: 0,0:15:03.55,0:15:05.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga sudah melibatkan Lily.
Dialogue: 0,0:15:06.36,0:15:07.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ini payah sekali.
Dialogue: 0,0:15:07.60,0:15:09.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bukan salahmu, Rein.
Dialogue: 0,0:15:10.05,0:15:11.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:15:11.43,0:15:14.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar. Kau yang tidak tahu kelakuan mereka
Dialogue: 0,0:15:14.25,0:15:17.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}masih lebih baik daripada aku\Nyang mengurung diri selama dua tahun.
Dialogue: 0,0:15:18.85,0:15:20.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya juga, sih.
Dialogue: 0,0:15:21.30,0:15:22.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, maaf!
Dialogue: 0,0:15:22.89,0:15:25.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kan mengurung diri tiga...\NRalat, lima tahun!
Dialogue: 0,0:15:25.90,0:15:28.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak usah bohong segala.\NBikin orang makin emosi saja.
Dialogue: 0,0:15:31.80,0:15:34.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari yang kulihat tadi,\Npria itu lumayan kuat.
Dialogue: 0,0:15:34.79,0:15:35.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:15:35.90,0:15:37.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tim Cornelius adalah
Dialogue: 0,0:15:37.65,0:15:40.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}salah satu dari tiga tim terkuat\Ndi Taring Raja Binatang.
Dialogue: 0,0:15:40.90,0:15:43.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski kita melawannya dan menang hari ini,
Dialogue: 0,0:15:43.15,0:15:44.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}semua tidak akan berakhir.
Dialogue: 0,0:15:44.64,0:15:46.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak akan berakhir?
Dialogue: 0,0:15:46.05,0:15:48.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taring Raja Binatang melawan Kristal Biru.
Dialogue: 0,0:15:48.95,0:15:49.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau itu sampai terjadi,
Dialogue: 0,0:15:49.99,0:15:52.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita tidak akan bisa menang.
Dialogue: 0,0:15:55.10,0:15:58.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus menahan diri di sini.\NDemi teman-teman kita.
Dialogue: 0,0:16:01.05,0:16:02.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily.
Dialogue: 0,0:16:02.55,0:16:05.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata petualang itu\Nbukan seru-seruan saja, ya.
Dialogue: 0,0:16:06.24,0:16:08.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus berbohong dan menahan diri,
Dialogue: 0,0:16:08.50,0:16:10.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ternyata lumayan repot juga.
Dialogue: 0,0:16:12.00,0:16:14.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu barang bawaanku, tahu!
Dialogue: 0,0:16:14.20,0:16:15.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa tidak izin dulu?!
Dialogue: 0,0:16:15.55,0:16:18.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok masih tanya?\NSoalnya ada di sana.
Dialogue: 0,0:16:20.90,0:16:22.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Sini, minum lagi yang banyak.\N- Rein.
Dialogue: 0,0:16:23.50,0:16:26.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gabung Kristal Biru itu enak banget, 'kan?
Dialogue: 0,0:16:28.10,0:16:29.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau benar.
Dialogue: 0,0:16:31.45,0:16:33.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sakit, tahu! Apa, sih?
Dialogue: 0,0:16:33.70,0:16:34.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rein.
Dialogue: 0,0:16:34.55,0:16:37.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perempuan yang pergi bersamamu\Nuntuk kami saja, ya.
Dialogue: 0,0:16:39.19,0:16:42.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak bisa pakai sihir pengimbuh.
Dialogue: 0,0:16:42.25,0:16:46.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kau akan kuampuni asalkan\Nkau serahkan perempuan itu.
Dialogue: 0,0:16:47.06,0:16:49.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan tawaran buruk, 'kan?
Dialogue: 0,0:16:49.20,0:16:52.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pilihlah dengan bijak,\Ndemi guild dan teman-temanmu.
Dialogue: 0,0:16:52.85,0:16:54.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teman...
Dialogue: 0,0:16:55.15,0:16:57.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,\Naku tidak perlu pertimbangkan lagi.
Dialogue: 0,0:16:59.25,0:17:01.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan menyerahkan Lily!
Dialogue: 0,0:17:11.34,0:17:12.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, Rein?!
Dialogue: 0,0:17:17.40,0:17:19.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sakit, tahu!\NKenapa kau jatuhkan aku?!
Dialogue: 0,0:17:19.50,0:17:23.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf. Lenganku tidak kuat... Lemas...
Dialogue: 0,0:17:23.50,0:17:25.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata lebih berat daripada bayanganku...
Dialogue: 0,0:17:25.25,0:17:27.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu, sih, lenganmu saja yang terlalu kurus!
Dialogue: 0,0:17:30.10,0:17:31.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily.
Dialogue: 0,0:17:31.20,0:17:34.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan menyerahkanmu\Nhanya karena mereka yang minta.
Dialogue: 0,0:17:35.25,0:17:40.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama kau mengurung diri, teman-teman guild\Nselalu memperhatikanmu, 'kan?
Dialogue: 0,0:17:41.15,0:17:42.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau terjadi sesuatu padamu,
Dialogue: 0,0:17:42.45,0:17:46.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mereka pasti akan menolong tanpa pamrih.
Dialogue: 0,0:17:47.95,0:17:50.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cornelius itu tidak akan mundur\Nkalau sudah menginginkan sesuatu.
Dialogue: 0,0:17:50.69,0:17:54.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlebih, mimpiku menjadi petualang\Nakhirnya terwujud.
Dialogue: 0,0:17:55.70,0:17:58.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau menjalaninya dengan jujur,\Ntanpa bohong-bohongan.
Dialogue: 0,0:17:58.70,0:18:00.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau masih saja...
Dialogue: 0,0:18:00.85,0:18:03.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rein!
Dialogue: 0,0:18:03.35,0:18:06.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Percuma saja lari, panahku bisa mencapaimu.
Dialogue: 0,0:18:08.95,0:18:11.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin katakan sesuatu pada kalian!
Dialogue: 0,0:18:11.10,0:18:14.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah bukan anggota\NTaring Raja Binatang lagi!
Dialogue: 0,0:18:14.29,0:18:17.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, aku sudah melepaskan\Nefek sihir pengimbuh
Dialogue: 0,0:18:17.44,0:18:19.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dari perlengkapan kalian semua!
Dialogue: 0,0:18:19.80,0:18:21.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa katamu?
Dialogue: 0,0:18:21.85,0:18:25.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, quest kita gagal karena dia...
Dialogue: 0,0:18:25.20,0:18:26.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beraninya dia meremehkan kita.
Dialogue: 0,0:18:26.50,0:18:28.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo beri dia pelajaran!
Dialogue: 0,0:18:28.45,0:18:29.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rein.
Dialogue: 0,0:18:29.41,0:18:30.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.
Dialogue: 0,0:18:30.85,0:18:33.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku punya senjata pemungkas.
Dialogue: 0,0:18:33.95,0:18:34.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini.
Dialogue: 0,0:18:36.35,0:18:38.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Batu kerikil?
Dialogue: 0,0:18:38.35,0:18:39.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang benar saja!
Dialogue: 0,0:18:39.45,0:18:41.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin itu mempan...
Dialogue: 0,0:18:44.25,0:18:45.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Batu kerikil yang dia lempar...
Dialogue: 0,0:18:45.95,0:18:47.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa meledak?!
Dialogue: 0,0:18:47.99,0:18:49.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan meledak!
Dialogue: 0,0:18:50.05,0:18:52.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku perkuat batu kerikilnya\Npakai sihir pengimbuh.
Dialogue: 0,0:18:52.15,0:18:53.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak kurang, tidak lebih!
Dialogue: 0,0:18:55.05,0:18:56.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Konyol!
Dialogue: 0,0:18:57.65,0:18:59.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya perlu menghindari batumu.
Dialogue: 0,0:19:04.64,0:19:06.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau menginjak batu kerikil\Nyang tadi kulempar, ya?
Dialogue: 0,0:19:07.60,0:19:09.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan saat dilempar saja.
Dialogue: 0,0:19:09.59,0:19:11.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau diinjak,\Nitu lebih sakit daripada ranjau paku.
Dialogue: 0,0:19:11.65,0:19:13.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sudah bukan batu kerikil biasa lagi.
Dialogue: 0,0:19:14.45,0:19:15.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Batu cadas.
Dialogue: 0,0:19:16.44,0:19:18.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti halnya batu lempar biasa,
Dialogue: 0,0:19:18.80,0:19:24.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}itu adalah senjata universal\Nyang paling murah dan paling mematikan.
Dialogue: 0,0:19:24.15,0:19:26.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biasanya, diperlukan ukuran\Nyang lumayan besar
Dialogue: 0,0:19:26.05,0:19:28.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}agar bisa menyakiti lawan,
Dialogue: 0,0:19:28.40,0:19:31.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi Rein dapat menggunakan sihir pengimbuh
Dialogue: 0,0:19:31.30,0:19:35.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk mengubah kerikil\Nyang tidak berguna menjadi senjata.
Dialogue: 0,0:19:35.60,0:19:37.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sulit dipercaya.
Dialogue: 0,0:19:37.60,0:19:42.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata sihir pengimbuh Rein\Nsekuat ini, ya?!
Dialogue: 0,0:19:42.55,0:19:44.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku masih punya beberapa
Dialogue: 0,0:19:44.45,0:19:47.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}batu kerikil yang sudah diperkuat, lo.
Dialogue: 0,0:19:47.05,0:19:49.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kalian menyerang,\Naku akan lemparkan semuanya!
Dialogue: 0,0:19:49.75,0:19:52.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu,\Nsebaiknya kalian pergi baik-baik dari sini!
Dialogue: 0,0:19:54.55,0:19:56.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka langsung pulang, ya.
Dialogue: 0,0:19:56.70,0:19:59.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus ambil kembali Poin Penguat\Ndari kerikilnya.
Dialogue: 0,0:20:01.75,0:20:03.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hancur lebur.
Dialogue: 0,0:20:04.05,0:20:07.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga, kau butuh senjata\Ndengan daya tahan yang tinggi.
Dialogue: 0,0:20:07.65,0:20:09.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daya tahan, ya.
Dialogue: 0,0:20:09.80,0:20:13.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin itu senjata yang sulit ditemukan.
Dialogue: 0,0:20:13.75,0:20:16.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi ini masalah yang menyenangkan.
Dialogue: 0,0:20:17.45,0:20:20.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pusing memikirkan senjata itu\Nkhas petualang banget, 'kan?
Dialogue: 0,0:20:21.35,0:20:24.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus cepat-cepat\Ntemukan senjata yang cocok.
Dialogue: 0,0:20:25.29,0:20:28.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu satu tempat.
Dialogue: 0,0:20:28.74,0:20:33.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempat yang menyimpan pedang\Nyang mampu menahan sihir pengimbuh Rein.
Dialogue: 0,0:20:36.70,0:20:39.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang sebenarnya kalian bicarakan?
Dialogue: 0,0:20:39.14,0:20:41.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Percayalah, Guild Master!
Dialogue: 0,0:20:41.80,0:20:43.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini gara-gara Rein.
Dialogue: 0,0:20:43.40,0:20:47.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rein yang membuat kami\Ngagal menyelesaikan quest.
Dialogue: 0,0:20:47.05,0:20:50.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena dia?\NAku masih sulit percaya.
Dialogue: 0,0:20:50.95,0:20:52.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master.
Dialogue: 0,0:20:52.50,0:20:55.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah diperiksa, ternyata benar.
Dialogue: 0,0:20:56.40,0:21:00.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua senjata dan baju pelindung\Ntelah kehilangan seluruh Poin Penguatnya.
Dialogue: 0,0:21:03.15,0:21:07.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak menyangka\Ndia bisa mencabut Poin Penguatnya.
Dialogue: 0,0:21:08.19,0:21:10.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kalian bengong saja di sana?!
Dialogue: 0,0:21:10.80,0:21:12.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat temukan Rein!
Dialogue: 0,0:21:13.00,0:21:14.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika dia bergabung dengan sebuah guild,
Dialogue: 0,0:21:14.85,0:21:16.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}temukan guild itu juga.
Dialogue: 0,0:21:16.30,0:21:17.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:21:19.90,0:21:21.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master.
Dialogue: 0,0:21:21.20,0:21:22.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, Glenda?
Dialogue: 0,0:21:23.30,0:21:24.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di dunia petualang,
Dialogue: 0,0:21:24.80,0:21:26.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}semua akan berakhir saat kita diremehkan.
Dialogue: 0,0:21:27.50,0:21:30.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus memberinya pelajaran.
Dialogue: 0,0:21:30.24,0:21:34.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelajaran tentang nasib petualang\Nyang berani melawan Taring Raja Binatang.
Dialogue: 0,0:21:35.10,0:21:36.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily, bagaimana pendapatmu
Dialogue: 0,0:21:36.74,0:21:38.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tentang quest setelah dua tahun vakum?
Dialogue: 0,0:21:41.15,0:21:42.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lumayan.
Dialogue: 0,0:21:43.50,0:21:45.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu. Seru banget, ya.
Dialogue: 0,0:21:45.96,0:21:46.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bilang itu!
Dialogue: 0,0:21:46.90,0:21:48.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kupingmu masih sehat, tidak, sih?!
Dialogue: 0,0:21:48.70,0:21:51.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dengar suara hatimu, tahu.
Dialogue: 0,0:21:51.09,0:21:53.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suara hatiku juga tidak bilang begitu!
Dialogue: 0,0:21:53.46,0:21:56.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Terlebih, kenapa kau menyebalkan sekali...\N- Lily.
Dialogue: 0,0:21:56.50,0:21:58.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lama tidak bertemu.
Dialogue: 0,0:22:00.49,0:22:03.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku lega melihatmu bersenang-senang.
Dialogue: 0,0:22:03.60,0:22:06.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Margaret...
