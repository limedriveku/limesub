Dialogue: 0,0:00:29.23,0:00:30.98,sign,,0000,0000,0000,,"MENANGIS"
Dialogue: 0,0:00:44.92,0:00:47.58,sign,,0000,0000,0000,,THE LAID-OFF CHEAT-GRANTING MAGE\NENJOYS A SECOND LEASE ON LIFE
Dialogue: 0,0:02:42.99,0:02:44.41,sign,,0000,0000,0000,,"LARI"
Dialogue: 0,0:02:47.20,0:02:49.37,sign,,0000,0000,0000,,TERENGAH-ENGAH...
Dialogue: 0,0:02:53.00,0:02:54.34,sign,,0000,0000,0000,,KAMI DIBUNUH OLEH LILY FLAMBERT
Dialogue: 0,0:03:20.53,0:03:22.91,sign,,0000,0000,0000,,EP. 05 "MESKIPUN TIDAK ADA ADEGAN MEMASAK,\NAKU JAGO MASAK, LO,"
Dialogue: 0,0:03:22.99,0:03:25.49,sign,,0000,0000,0000,,BUAL SANG GADIS SAMBIL MENGHUNUS\NPEDANG YANG DISELIMUTI API
Dialogue: 0,0:05:01.46,0:05:02.46,sign,,0000,0000,0000,,KESAL
Dialogue: 0,0:06:38.98,0:06:42.31,sign,,0000,0000,0000,,"GONGGONGAN TERTAHAN"
Dialogue: 0,0:06:46.94,0:06:47.90,sign,,0000,0000,0000,,MENGGERUTU
Dialogue: 0,0:06:48.45,0:06:50.24,sign,,0000,0000,0000,,MERENGEK
Dialogue: 0,0:08:17.24,0:08:20.04,sign,,0000,0000,0000,,"GEMETAR KETAKUTAN, DIA KETERLALUAN"
Dialogue: 0,0:09:07.71,0:09:08.79,sign,,0000,0000,0000,,PERUT BERBUNYI
Dialogue: 0,0:09:20.01,0:09:21.60,sign,,0000,0000,0000,,PENUH
Dialogue: 0,0:09:21.89,0:09:23.68,sign,,0000,0000,0000,,"PRODUK LOKAL, DISKON"
Dialogue: 0,0:09:26.10,0:09:27.60,sign,,0000,0000,0000,,"BUBUK KALDU"
Dialogue: 0,0:10:23.24,0:10:25.41,sign,,0000,0000,0000,,TERENGAH-ENGAH BERSEMANGAT
Dialogue: 0,0:10:53.69,0:10:55.44,sign,,0000,0000,0000,,"BERSEMANGAT KARENA PENASARAN"
Dialogue: 0,0:11:11.46,0:11:12.46,sign,,0000,0000,0000,,MELAHAP MAKANAN
Dialogue: 0,0:20:53.29,0:20:55.29,sign,,0000,0000,0000,,"HEI..."
Dialogue: 0,0:00:13.13,0:00:13.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily?
Dialogue: 0,0:00:14.05,0:00:16.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya berlatih.
Dialogue: 0,0:00:16.09,0:00:18.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin punya lebih banyak\Nvariasi gaya menangis.
Dialogue: 0,0:00:18.64,0:00:20.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang normal mana yang kepikiran begitu?
Dialogue: 0,0:00:20.52,0:00:23.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan latihan bodoh itu.
Dialogue: 0,0:00:23.44,0:00:26.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak ingin kau\Npunya alasan untuk menangis.
Dialogue: 0,0:00:27.73,0:00:29.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily...
Dialogue: 0,0:00:29.23,0:00:30.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Langsung menjadi variasi baru.
Dialogue: 0,0:02:02.37,0:02:04.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa tulisannya?
Dialogue: 0,0:02:04.45,0:02:05.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba kulihat, Rein.
Dialogue: 0,0:02:06.33,0:02:08.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini...
Dialogue: 0,0:02:08.58,0:02:09.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong biarkan aku melihatnya.
Dialogue: 0,0:02:09.96,0:02:12.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau menyembunyikannya, Rein?
Dialogue: 0,0:02:14.76,0:02:16.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah, tenanglah.
Dialogue: 0,0:02:16.47,0:02:19.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan memasukkan ini ke bajuku!
Dialogue: 0,0:02:20.30,0:02:22.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zirah ini sudah diperkuat\Ndengan sihir pengimbuhku.
Dialogue: 0,0:02:22.89,0:02:25.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekeras apa pun kalian tarik, percuma!
Dialogue: 0,0:02:25.93,0:02:26.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kembalikan!
Dialogue: 0,0:02:26.93,0:02:29.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baju biasaku tidak kuperkuat!
Dialogue: 0,0:02:29.39,0:02:30.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jaga sikapmu dan biarkan aku melihatnya!
Dialogue: 0,0:02:30.44,0:02:31.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keluarkan sekarang!
Dialogue: 0,0:02:31.81,0:02:33.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan!
Dialogue: 0,0:02:33.23,0:02:35.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kalian menarik sekeras itu...
Dialogue: 0,0:02:41.11,0:02:42.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya kau menyembunyikannya\Ndi tempat yang salah.
Dialogue: 0,0:02:42.99,0:02:44.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu! Kembalikan!
Dialogue: 0,0:02:44.49,0:02:45.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tidak!\N- Kembalikan! Kembalikan!
Dialogue: 0,0:02:45.49,0:02:47.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tutupi dirimu!\N- Kembalikan! Kembalikan!
Dialogue: 0,0:02:49.46,0:02:51.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Staminamu payah sekali!
Dialogue: 0,0:02:51.83,0:02:52.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba kita lihat...
Dialogue: 0,0:02:56.38,0:02:59.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, ternyata\Nkau memang membunuh rekan-rekanmu.
Dialogue: 0,0:03:00.05,0:03:01.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu sebentar, ini...
Dialogue: 0,0:03:01.72,0:03:03.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan membunuhmu!
Dialogue: 0,0:03:04.51,0:03:06.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, Margaret!
Dialogue: 0,0:03:06.18,0:03:09.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau cuma penyihir pengimbuh,\Njangan ikut campur!
Dialogue: 0,0:03:09.18,0:03:11.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenanglah dulu. Lily itu...
Dialogue: 0,0:03:28.45,0:03:31.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang terjadi? Di mana aku?
Dialogue: 0,0:03:32.58,0:03:34.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus segera kembali.
Dialogue: 0,0:03:34.92,0:03:38.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi apa yang bisa kulakukan\Njika aku kembali?
Dialogue: 0,0:03:39.09,0:03:41.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily membunuh rekan-rekannya sendiri?
Dialogue: 0,0:03:41.51,0:03:43.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu mustahil.
Dialogue: 0,0:03:43.51,0:03:45.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus melakukan sesuatu!
Dialogue: 0,0:03:52.35,0:03:54.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang hebat, si Lily Flambert.
Dialogue: 0,0:03:54.40,0:03:56.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seterpuruk apa pun dia,\Ndia tetap petualang peringkat S.
Dialogue: 0,0:03:57.11,0:04:01.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah menantikan momen ini.
Dialogue: 0,0:04:06.95,0:04:11.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah katamu kau tak bisa memegang pedang\Nsetiap kali terpikir soal bertarung?
Dialogue: 0,0:04:11.41,0:04:14.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak menghunus pedangku\Nuntuk bertarung.
Dialogue: 0,0:04:15.00,0:04:17.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kemari untuk mencari tahu kebenarannya.
Dialogue: 0,0:04:18.33,0:04:20.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belum boleh mati di sini.
Dialogue: 0,0:04:20.26,0:04:21.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kebenarannya?
Dialogue: 0,0:04:21.63,0:04:23.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini kebenarannya, 'kan?
Dialogue: 0,0:04:23.63,0:04:26.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu rekan-rekanku saat itu\Norang seperti apa.
Dialogue: 0,0:04:26.76,0:04:30.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, aku tahu ada yang janggal.
Dialogue: 0,0:04:31.39,0:04:34.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diam!
Dialogue: 0,0:04:38.61,0:04:40.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua berjalan sesuai rencana.
Dialogue: 0,0:04:40.98,0:04:44.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka tidak tahu pesan terakhir itu palsu\Ndan mulai saling membunuh.
Dialogue: 0,0:04:44.78,0:04:46.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapan kita membunuh mereka?
Dialogue: 0,0:04:46.20,0:04:47.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum saatnya.
Dialogue: 0,0:04:48.03,0:04:51.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan membuat mereka menderita\Ndan mempermainkan mereka.
Dialogue: 0,0:04:51.16,0:04:55.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan membunuh mereka\Nsetelah tubuh dan jiwa mereka hancur.
Dialogue: 0,0:04:57.42,0:05:01.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan merusak suasana\Ndengan menghela napas, Bodoh.
Dialogue: 0,0:05:02.76,0:05:04.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Panggil aku saat waktunya bekerja.
Dialogue: 0,0:05:20.94,0:05:22.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cornelius?
Dialogue: 0,0:05:22.90,0:05:23.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rein.
Dialogue: 0,0:05:24.32,0:05:27.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menemukan ini padanya.
Dialogue: 0,0:05:27.24,0:05:29.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini identik dengan pesan terakhir\Nyang baru saja kita temukan.
Dialogue: 0,0:05:30.12,0:05:33.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia menaruh ini di seluruh dungeon.
Dialogue: 0,0:05:34.00,0:05:36.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah tenang dan kuperhatikan baik-baik,
Dialogue: 0,0:05:36.50,0:05:37.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tulisan tangan ini...
Dialogue: 0,0:05:37.71,0:05:39.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bukan tulisan rekan-rekanku.
Dialogue: 0,0:05:44.30,0:05:47.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akulah yang membawa Cornelius kemari.
Dialogue: 0,0:05:48.39,0:05:51.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memberitahunya\Nrencana perjalanan dan tujuan kami.
Dialogue: 0,0:05:52.10,0:05:54.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan dia menyewa seorang pembunuh.
Dialogue: 0,0:05:54.81,0:05:57.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka mungkin bersembunyi di suatu tempat\Ndan mengawasi kita sekarang.
Dialogue: 0,0:05:57.48,0:05:58.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Margaret.
Dialogue: 0,0:05:59.06,0:06:01.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang seperti apa pembunuh ini?
Dialogue: 0,0:06:01.86,0:06:05.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seorang anak kecil berambut biru.
Dialogue: 0,0:06:06.90,0:06:09.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita sedang diincar\Noleh lawan yang merepotkan.
Dialogue: 0,0:06:10.28,0:06:12.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pembunuh itu, Mirabelle.
Dialogue: 0,0:06:12.20,0:06:16.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pembunuh kelas atas\Nyang mahir menyembunyikan hawa keberadaannya.
Dialogue: 0,0:06:16.91,0:06:20.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekeras apa pun kita mencari,\Nkita mungkin tidak akan menemukannya.
Dialogue: 0,0:06:20.42,0:06:23.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pasti mengawasi kita sekarang.
Dialogue: 0,0:06:24.00,0:06:24.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:06:25.71,0:06:28.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah sudah kubilang\Nmustahil menemukannya?
Dialogue: 0,0:06:29.01,0:06:30.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku tidak bisa menahan diri\Nuntuk mencari...
Dialogue: 0,0:06:30.59,0:06:32.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti perasaanmu.
Dialogue: 0,0:06:32.85,0:06:35.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi untungnya, kliennya ada di tangan kita.
Dialogue: 0,0:06:35.39,0:06:36.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akan menggunakannya sebagai perisai
Dialogue: 0,0:06:37.02,0:06:38.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk melindungi diri.
Dialogue: 0,0:06:38.98,0:06:42.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biasanya, pembunuh takkan berani bergerak.
Dialogue: 0,0:06:42.40,0:06:43.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kecuali dia rela mengorbankan kliennya
Dialogue: 0,0:06:43.61,0:06:46.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hanya untuk membunuh kita.
Dialogue: 0,0:06:50.91,0:06:52.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:06:53.70,0:06:55.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengkhianatimu
Dialogue: 0,0:06:55.79,0:06:58.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan menyebabkan banyak masalah.
Dialogue: 0,0:06:58.54,0:07:01.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau tidak memarahiku?
Dialogue: 0,0:07:01.21,0:07:03.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau mengaku sekarang,
Dialogue: 0,0:07:03.59,0:07:05.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berarti kau sudah berubah pikiran.
Dialogue: 0,0:07:05.42,0:07:07.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak perlu menyalahkan dirimu lagi.
Dialogue: 0,0:07:08.72,0:07:10.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa kuserahkan Cornelius kepadamu?
Dialogue: 0,0:07:10.63,0:07:12.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini tugas penting.
Dialogue: 0,0:07:15.31,0:07:16.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:07:17.97,0:07:19.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wanita bodoh itu.
Dialogue: 0,0:07:19.68,0:07:23.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia membeberkan semuanya\Nhanya karena terbawa emosi.
Dialogue: 0,0:07:23.40,0:07:26.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya aku juga membunuhnya.
Dialogue: 0,0:07:26.48,0:07:30.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Emosinya kacau\Ndan pertahanannya terbuka lebar!
Dialogue: 0,0:07:30.53,0:07:32.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa membunuhnya sendiri sekarang.
Dialogue: 0,0:07:32.78,0:07:37.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mirabelle akan membunuh dua orang lainnya.
Dialogue: 0,0:07:45.46,0:07:47.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedangnya patah!
Dialogue: 0,0:07:47.17,0:07:49.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rein memperkuat pedangnya?
Dialogue: 0,0:07:51.05,0:07:53.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mirabelle si pembunuh, tamatlah riwayatmu!
Dialogue: 0,0:07:55.14,0:07:57.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak kusangka kau akan menampakkan diri.
Dialogue: 0,0:07:58.85,0:08:01.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak sia-sia berpura-pura menangis.
Dialogue: 0,0:08:01.85,0:08:04.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis ini... menangis sungguhan.
Dialogue: 0,0:08:04.81,0:08:06.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata dia ahli strategi!
Dialogue: 0,0:08:06.36,0:08:09.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Margaret memang hebat.
Dialogue: 0,0:08:09.11,0:08:12.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan membunuh kalian semua!
Dialogue: 0,0:08:12.15,0:08:14.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu aku akan menyerang
Dialogue: 0,0:08:14.16,0:08:16.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}semua peliharaan kalian!
Dialogue: 0,0:08:17.24,0:08:20.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fetis yang menjijikkan.
Dialogue: 0,0:08:20.12,0:08:21.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily, Rein.
Dialogue: 0,0:08:21.83,0:08:23.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku.
Dialogue: 0,0:08:24.29,0:08:26.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini semua salahku.
Dialogue: 0,0:08:27.13,0:08:28.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih baik aku mati
Dialogue: 0,0:08:28.20,0:08:31.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}daripada membiarkan Mirabelle\Nmembunuh kalian.
Dialogue: 0,0:08:33.63,0:08:34.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan membiarkanmu mati.
Dialogue: 0,0:08:35.01,0:08:36.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena sekarang kita rekan.
Dialogue: 0,0:08:37.79,0:08:40.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong jangan terlalu baik kepadaku.
Dialogue: 0,0:08:41.14,0:08:45.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika begitu, aku benar-benar\Nakan membuat kesalahan kali ini.
Dialogue: 0,0:08:45.31,0:08:48.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru sekarang saatnya\Nmengandalkan orang lain, 'kan?
Dialogue: 0,0:08:48.15,0:08:49.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, Margaret.
Dialogue: 0,0:08:49.73,0:08:51.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita hanya perlu saling menjaga.
Dialogue: 0,0:09:02.29,0:09:04.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sudah pergi.
Dialogue: 0,0:09:04.21,0:09:06.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sebabnya kubilang dia merepotkan.
Dialogue: 0,0:09:06.29,0:09:07.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menakutkan sekali.
Dialogue: 0,0:09:10.00,0:09:12.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bukan salahku!
Dialogue: 0,0:09:12.59,0:09:14.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo makan dulu.
Dialogue: 0,0:09:14.72,0:09:16.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana dengan Mirabelle?
Dialogue: 0,0:09:16.38,0:09:19.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru lebih bahaya\Nkalau diserang saat kelaparan.
Dialogue: 0,0:09:21.89,0:09:23.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Persiapanmu lengkap sekali.
Dialogue: 0,0:09:23.77,0:09:26.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau masak sungguhan\Ndi tempat seperti ini?
Dialogue: 0,0:09:26.10,0:09:27.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru karena di tempat seperti ini,
Dialogue: 0,0:09:27.69,0:09:29.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita butuh makanan yang layak.
Dialogue: 0,0:09:29.81,0:09:32.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kau tidak membawa apa pun sebelumnya.
Dialogue: 0,0:09:32.86,0:09:36.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat itu, aku tidak peduli jika aku mati.
Dialogue: 0,0:09:36.11,0:09:38.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sebabnya aku tidak siap.
Dialogue: 0,0:09:38.28,0:09:39.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kali ini persiapanmu matang sekali.
Dialogue: 0,0:09:42.74,0:09:45.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kubantu.
Dialogue: 0,0:09:45.29,0:09:46.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong nyalakan apinya.
Dialogue: 0,0:09:56.38,0:09:58.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelihatannya lezat.
Dialogue: 0,0:09:58.43,0:09:59.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampang girangmu itu bikin mual.
Dialogue: 0,0:10:01.60,0:10:05.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sup ini terkenal di kalangan petualang\Nyang pernah mencicipinya.
Dialogue: 0,0:10:06.27,0:10:08.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Margaret, kau juga mau, 'kan?
Dialogue: 0,0:10:08.44,0:10:10.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus tetap waspada...
Dialogue: 0,0:10:12.19,0:10:13.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aroma ini...
Dialogue: 0,0:10:13.73,0:10:15.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau kenal aroma ini, Margaret?
Dialogue: 0,0:10:18.74,0:10:21.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat kakakku kembali dari petualangan,
Dialogue: 0,0:10:21.45,0:10:23.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia sesekali membuatkannya untukku.
Dialogue: 0,0:10:26.33,0:10:27.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:10:27.41,0:10:30.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dulu dia selalu membantuku\Nmembuat hidangan ini.
Dialogue: 0,0:10:31.13,0:10:32.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Margaret, cobalah.
Dialogue: 0,0:10:32.96,0:10:34.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan berjaga.
Dialogue: 0,0:10:41.55,0:10:42.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat makan.
Dialogue: 0,0:10:53.69,0:10:55.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana, Margaret? Enak?
Dialogue: 0,0:10:55.53,0:10:56.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana? Bagaimana rasanya?
Dialogue: 0,0:10:56.78,0:10:59.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Dia lebih menyebalkan daripada sebelumnya!\N- Katakan! Enak? Bagaimana?
Dialogue: 0,0:11:02.12,0:11:04.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, enak sekali.
Dialogue: 0,0:11:08.75,0:11:11.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily, Margaret, kemarilah sebentar.
Dialogue: 0,0:11:12.54,0:11:16.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Lily! Margaret! Hei!
Dialogue: 0,0:11:16.42,0:11:17.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat kusuruh kemari, kemarilah!
Dialogue: 0,0:11:18.05,0:11:18.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seram sekali.
Dialogue: 0,0:11:18.97,0:11:20.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat di sana.
Dialogue: 0,0:11:20.59,0:11:23.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pembunuh itu kembali.
Dialogue: 0,0:11:23.93,0:11:24.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aneh.
Dialogue: 0,0:11:24.97,0:11:26.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudmu aku?
Dialogue: 0,0:11:26.31,0:11:28.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, tapi kau juga aneh.
Dialogue: 0,0:11:28.60,0:11:32.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia biasanya menyembunyikan kehadirannya\Nsebelum mendekati target.
Dialogue: 0,0:11:32.19,0:11:34.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa dia datang untuk makan sup juga?
Dialogue: 0,0:11:34.15,0:11:34.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diam.
Dialogue: 0,0:11:37.40,0:11:38.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cornelius.
Dialogue: 0,0:11:38.48,0:11:40.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengubah syarat pekerjaannya.
Dialogue: 0,0:11:41.74,0:11:44.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika manusia mulai saling membunuh di sini,
Dialogue: 0,0:11:44.16,0:11:45.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}semua orang akan mati.
Dialogue: 0,0:11:46.45,0:11:47.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudmu?
Dialogue: 0,0:11:53.83,0:11:55.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bahkan belum minum seteguk pun!
Dialogue: 0,0:11:55.50,0:11:56.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa orang ini sudah gila?
Dialogue: 0,0:11:56.84,0:11:57.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada waktu untuk sup sekarang!
Dialogue: 0,0:11:58.05,0:12:00.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari dulu dia memang tidak waras.
Dialogue: 0,0:12:04.09,0:12:05.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang terjadi?
Dialogue: 0,0:12:07.47,0:12:08.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini...
Dialogue: 0,0:12:08.85,0:12:10.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin.
Dialogue: 0,0:12:11.10,0:12:13.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa dia datang mencari kita?
Dialogue: 0,0:12:13.48,0:12:14.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:12:14.44,0:12:16.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudmu, "datang mencari"?
Dialogue: 0,0:12:17.11,0:12:19.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ambil senjata kalian, Bodoh.
Dialogue: 0,0:12:19.82,0:12:20.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau...
Dialogue: 0,0:12:26.12,0:12:27.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin...
Dialogue: 0,0:12:28.53,0:12:32.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, ini... Naga Bercahaya.
Dialogue: 0,0:12:33.58,0:12:34.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penjaga Lefaid,\NPedang Bercahaya Kaisar Naga.
Dialogue: 0,0:12:35.00,0:12:37.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makhluk terkuat di dungeon ini.
Dialogue: 0,0:12:45.13,0:12:46.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily!
Dialogue: 0,0:12:46.18,0:12:47.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sadarlah, Lily!
Dialogue: 0,0:12:49.31,0:12:50.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:12:51.77,0:12:56.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua orang dibunuh oleh Naga Bercahaya ini.
Dialogue: 0,0:13:01.15,0:13:04.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat itu... aku...
Dialogue: 0,0:13:47.24,0:13:48.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily!
Dialogue: 0,0:13:50.78,0:13:51.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah.
Dialogue: 0,0:13:51.74,0:13:53.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian baik-baik saja?
Dialogue: 0,0:13:54.83,0:13:57.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak juga.\NZirahku rusak kena serangan tadi...
Dialogue: 0,0:13:59.50,0:14:02.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inikah... Naga Bercahaya?
Dialogue: 0,0:14:03.76,0:14:06.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rein, aku akan mengalihkan perhatiannya.
Dialogue: 0,0:14:06.13,0:14:07.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bawa Lily dan pergi dari sini.
Dialogue: 0,0:14:07.59,0:14:08.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:14:10.34,0:14:11.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan lagi...
Dialogue: 0,0:14:16.64,0:14:17.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mirabelle!
Dialogue: 0,0:14:19.65,0:14:20.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Margaret!
Dialogue: 0,0:14:21.23,0:14:24.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini salahku karena nekat kemari\Npadahal belum siap.
Dialogue: 0,0:14:25.53,0:14:28.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku membahayakan semua orang.
Dialogue: 0,0:14:36.04,0:14:38.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sungguh...
Dialogue: 0,0:14:39.58,0:14:42.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak pantas bertarung.
Dialogue: 0,0:14:42.75,0:14:43.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily!
Dialogue: 0,0:14:44.50,0:14:45.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada gunanya.
Dialogue: 0,0:14:45.67,0:14:47.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus mundur!
Dialogue: 0,0:14:51.84,0:14:55.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika terus begini,\Nkita semua akan mati di sini.
Dialogue: 0,0:14:59.89,0:15:01.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian kaburlah duluan!
Dialogue: 0,0:15:01.73,0:15:03.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan tetap di sini untuk mengulur waktu!
Dialogue: 0,0:15:06.15,0:15:06.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu terlalu gegabah.
Dialogue: 0,0:15:07.07,0:15:07.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat!
Dialogue: 0,0:15:07.99,0:15:09.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tapi...\N- Ayo!
Dialogue: 0,0:15:10.78,0:15:12.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily, kau juga harus pergi dari sini!
Dialogue: 0,0:15:12.62,0:15:14.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Baiklah.\N- Maafkan aku.
Dialogue: 0,0:15:29.47,0:15:31.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Percuma melarikan diri.
Dialogue: 0,0:15:32.55,0:15:35.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat itu, naga itu\Nmenumbangkanku lebih dulu.
Dialogue: 0,0:15:36.10,0:15:38.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu ia mengejar rekan-rekanku\Nyang melarikan diri
Dialogue: 0,0:15:39.52,0:15:40.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan membunuh mereka semua.
Dialogue: 0,0:15:46.23,0:15:47.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Margaret!
Dialogue: 0,0:15:50.24,0:15:52.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily, lari!
Dialogue: 0,0:15:53.11,0:15:55.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingat semuanya sekarang.
Dialogue: 0,0:15:56.49,0:15:58.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makhluk itu terlalu kuat.
Dialogue: 0,0:15:59.70,0:16:00.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat itu...
Dialogue: 0,0:16:01.21,0:16:03.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku bahkan tak bisa melukainya sedikit pun.
Dialogue: 0,0:16:07.55,0:16:10.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku...
Dialogue: 0,0:16:12.18,0:16:14.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, Naga Bercahaya!
Dialogue: 0,0:16:15.60,0:16:19.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku, Lily Flambert, petualang peringkat S,\Nakan menjadi lawanmu!
Dialogue: 0,0:16:22.23,0:16:24.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat itu,
Dialogue: 0,0:16:25.56,0:16:26.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tak melarikan diri.
Dialogue: 0,0:16:29.32,0:16:34.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga masih bisa bertarung.
Dialogue: 0,0:16:36.74,0:16:37.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:16:42.75,0:16:43.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku...
Dialogue: 0,0:16:45.46,0:16:47.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus bertarung!
Dialogue: 0,0:16:51.88,0:16:54.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rein, perkuat pedangku!
Dialogue: 0,0:16:54.97,0:16:57.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik. Serahkan kepadaku, Lily!
Dialogue: 0,0:17:02.27,0:17:03.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon, cepatlah.
Dialogue: 0,0:17:04.06,0:17:07.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mirabelle mengalihkan perhatian naga\Nuntuk saat ini,
Dialogue: 0,0:17:07.44,0:17:09.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi entah berapa lama dia bisa bertahan.
Dialogue: 0,0:17:11.15,0:17:12.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Margaret.
Dialogue: 0,0:17:12.35,0:17:13.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya?
Dialogue: 0,0:17:13.60,0:17:17.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak meninggalkan semua orang\Ndan kabur sendirian.
Dialogue: 0,0:17:18.11,0:17:19.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily...
Dialogue: 0,0:17:19.78,0:17:22.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah tahu sejak lama.
Dialogue: 0,0:17:25.67,0:17:26.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mirabelle!
Dialogue: 0,0:17:28.75,0:17:31.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lumayan juga dia.
Dialogue: 0,0:17:31.88,0:17:35.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi hanya sebatas itu.
Dialogue: 0,0:17:36.18,0:17:37.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kau bisa bicara?
Dialogue: 0,0:17:39.35,0:17:40.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah selesai bicara.
Dialogue: 0,0:17:41.06,0:17:43.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wanita pirang...
Dialogue: 0,0:17:43.10,0:17:45.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pernah melihatmu.
Dialogue: 0,0:17:46.31,0:17:48.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku tidak ingat
Dialogue: 0,0:17:48.98,0:17:52.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}wanita ini pernah datang ke sini.
Dialogue: 0,0:17:52.57,0:17:55.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia berlagak tangguh,
Dialogue: 0,0:17:55.95,0:17:59.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi dia tidak istimewa.
Dialogue: 0,0:17:59.37,0:18:01.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya kenapa?
Dialogue: 0,0:18:02.16,0:18:05.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berlagak tangguh agar semua orang\Nbisa kabur dengan selamat!
Dialogue: 0,0:18:05.79,0:18:06.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika aku tidak melakukan itu,
Dialogue: 0,0:18:06.96,0:18:09.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mereka tidak akan bisa lari tanpa ragu!
Dialogue: 0,0:18:09.88,0:18:13.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi pada akhirnya, mereka semua terbunuh.
Dialogue: 0,0:18:13.09,0:18:16.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sebabnya aku di sini hari ini\Nuntuk membalas dendam!
Dialogue: 0,0:18:16.88,0:18:18.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lily, ini pedangmu.
Dialogue: 0,0:18:19.09,0:18:21.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rein, tunggu di sini sebentar.
Dialogue: 0,0:18:24.35,0:18:27.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Margaret, kita akan mengalahkan makhluk ini
Dialogue: 0,0:18:27.39,0:18:30.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan melangkah ke masa depan.
Dialogue: 0,0:18:32.06,0:18:32.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:18:34.94,0:18:37.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan membidik kepala besar di kiri.
Dialogue: 0,0:18:37.49,0:18:39.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau incar kepala di kanan.
Dialogue: 0,0:18:39.70,0:18:40.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:18:58.01,0:18:58.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita berhasil?
Dialogue: 0,0:19:03.30,0:19:04.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti itu...
Dialogue: 0,0:19:04.76,0:19:06.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tancapkan pedangnya lebih dalam!
Dialogue: 0,0:19:07.77,0:19:08.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keras sekali!
Dialogue: 0,0:19:09.81,0:19:12.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuakui kau berhasil\Nmembuatku berdarah setetes.
Dialogue: 0,0:19:12.86,0:19:14.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi hanya sampai di situ kemampuanmu.
Dialogue: 0,0:19:15.07,0:19:17.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya pedang itu sudah diperkuat.
Dialogue: 0,0:19:17.90,0:19:20.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi tampaknya sia-sia.
Dialogue: 0,0:19:20.20,0:19:24.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian berdua hanya orang bodoh\Nyang ingin bunuh diri.
Dialogue: 0,0:19:24.74,0:19:26.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tidak benar!
Dialogue: 0,0:19:26.33,0:19:28.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami masih punya dia!
Dialogue: 0,0:19:28.54,0:19:29.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pria itu?
Dialogue: 0,0:19:31.75,0:19:33.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sadarlah, Mirabelle.
Dialogue: 0,0:19:36.63,0:19:38.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu...
Dialogue: 0,0:19:38.71,0:19:39.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:19:39.97,0:19:42.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ceritakan tentang ibumu, Mirabelle.
Dialogue: 0,0:19:50.48,0:19:52.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah kau atau orang lain,
Dialogue: 0,0:19:52.48,0:19:54.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalian semua tidak berharga!
Dialogue: 0,0:20:01.74,0:20:05.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada manusia yang berharga!
Dialogue: 0,0:20:05.66,0:20:07.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, tidak masalah\Njika kau membunuh mereka.
Dialogue: 0,0:20:07.58,0:20:10.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau ingin diperlakukan lebih baik,
Dialogue: 0,0:20:10.66,0:20:12.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bunuhlah orang-orang!
Dialogue: 0,0:20:16.34,0:20:18.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Itu kejam sekali.
Dialogue: 0,0:20:18.84,0:20:21.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mirabelle, ibumu salah.
Dialogue: 0,0:20:21.42,0:20:23.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada orang di dunia ini\Nyang tidak berharga.
Dialogue: 0,0:20:23.51,0:20:25.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua orang punya alasan untuk hidup.
Dialogue: 0,0:20:25.55,0:20:28.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mirabelle, termasuk kau, tentu saja.
Dialogue: 0,0:20:33.10,0:20:34.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bajingan itu.
Dialogue: 0,0:20:34.35,0:20:39.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia malah sok jadi konselor sambil\Nmemunggungi kita di tengah pertempuran.
Dialogue: 0,0:20:39.61,0:20:41.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan meremehkan kami!
Dialogue: 0,0:20:43.11,0:20:43.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar bocah ingusan!
Dialogue: 0,0:20:44.03,0:20:45.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beraninya kau melawan kami\Npakai barang murahan itu...
Dialogue: 0,0:20:47.41,0:20:48.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kecil sekali.
Dialogue: 0,0:20:48.66,0:20:51.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benda itu tidak lebih besar\Ndaripada tusuk gigi!
Dialogue: 0,0:20:51.20,0:20:53.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa dengan pedang itu?
Dialogue: 0,0:20:53.29,0:20:55.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Bodoh!
Dialogue: 0,0:20:55.37,0:20:57.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang menakutkan dari benda itu?
Dialogue: 0,0:20:57.59,0:20:59.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei...
Dialogue: 0,0:20:59.67,0:21:01.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau yang bodoh!
Dialogue: 0,0:21:01.63,0:21:05.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan pedang itu\Nbenar-benar tidak masuk akal.
Dialogue: 0,0:21:05.38,0:21:06.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana mungkin?
Dialogue: 0,0:21:06.84,0:21:08.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kau menyadarinya.
Dialogue: 0,0:21:08.26,0:21:10.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kepala di sebelah kiri\Ntidak terlalu pintar, 'kan?
Dialogue: 0,0:21:10.60,0:21:13.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Sepertinya kau belum menyadarinya.\N- Manusia, apa katamu?
Dialogue: 0,0:21:13.77,0:21:17.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada batas Poin Penguat yang bisa Rein berikan\Npada perlengkapan orang lain.
Dialogue: 0,0:21:18.31,0:21:21.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi saat memperkuat senjatanya sendiri,\Nbatasan itu tidak berlaku.
Dialogue: 0,0:21:21.90,0:21:23.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Apa?\N- Kau benar-benar lamban, ya?
Dialogue: 0,0:21:23.94,0:21:26.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sederhananya, pedang kami\Nhanya punya 300 Poin Penguat.
Dialogue: 0,0:21:26.66,0:21:30.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi pedang Rein punya 10 ribu Poin Penguat.
Dialogue: 0,0:21:30.45,0:21:32.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepuluh ribu?
Dialogue: 0,0:21:35.25,0:21:36.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf membuatmu menunggu, Rein!
Dialogue: 0,0:21:38.50,0:21:41.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Titik yang ditandai darah adalah jantungnya.
Dialogue: 0,0:21:41.34,0:21:43.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rein, bidik titik itu!
Dialogue: 0,0:21:43.55,0:21:45.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik. Serahkan kepadaku!
Dialogue: 0,0:21:46.09,0:21:47.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat.
Dialogue: 0,0:21:47.43,0:21:51.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melawan serangan sekuat itu,\Nsekeras apa pun sisik kita,
Dialogue: 0,0:21:51.47,0:21:54.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak ada jaminan\Nkita tidak akan terbelah dua.
Dialogue: 0,0:21:55.14,0:21:57.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei... Aku menghindar ke kiri.
Dialogue: 0,0:21:57.85,0:22:00.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau lari ke kanan. Dengan begitu,\Nhanya satu kepala yang kena.
Dialogue: 0,0:22:00.36,0:22:03.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berusaha menghindar dengan tepat\Nagar itu tidak terjadi!
Dialogue: 0,0:22:03.57,0:22:05.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bunuh saja yang kanan!
Dialogue: 0,0:22:05.61,0:22:07.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong ampuni aku, yang kiri!
Dialogue: 0,0:22:07.28,0:22:09.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Berengsek, berhenti bermain-main!\N- Jangan bunuh aku!
