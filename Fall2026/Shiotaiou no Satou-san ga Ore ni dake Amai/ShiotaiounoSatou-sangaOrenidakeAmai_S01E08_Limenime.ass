Dialogue: 0,0:00:27.34,0:00:27.98,sign,,0000,0000,0000,,OSHIO SOTA MENGIRIMIMU HATI
Dialogue: 0,0:00:42.76,0:00:43.60,sign,,0000,0000,0000,,NOMOR PRIBADI
Dialogue: 0,0:02:51.16,0:02:53.38,sign,,0000,0000,0000,,BIDIKAN 8\NTAK BISA BERHENTI MENYUKAINYA
Dialogue: 0,0:07:23.06,0:07:23.81,sign,,0000,0000,0000,,MADOKA - REN
Dialogue: 0,0:08:13.64,0:08:14.41,sign,,0000,0000,0000,,1 UNGGAHAN - 1 PENGIKUT - 0 MENGIKUTI
Dialogue: 0,0:22:02.02,0:22:04.96,sign,,0000,0000,0000,,BERSAMBUNG
Dialogue: 0,0:23:38.17,0:23:39.44,sign,,0000,0000,0000,,"SELANJUTNYA: KARENA AKU PACARMU"
Dialogue: 0,0:00:12.34,0:00:13.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah.
Dialogue: 0,0:00:13.53,0:00:16.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, padahal tinggal sedikit lagi.
Dialogue: 0,0:00:16.86,0:00:18.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, sekali lagi.
Dialogue: 0,0:00:18.92,0:00:19.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:00:20.07,0:00:21.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nol?
Dialogue: 0,0:00:21.27,0:00:24.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa main kalau hatinya habis.
Dialogue: 0,0:00:24.13,0:00:25.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh.
Dialogue: 0,0:00:28.02,0:00:29.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:00:29.00,0:00:30.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya.
Dialogue: 0,0:00:30.29,0:00:33.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau berteman,\Nkita bisa saling mengirim hati.
Dialogue: 0,0:00:36.74,0:00:37.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini...
Dialogue: 0,0:00:37.83,0:00:40.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi ini hati dari Oshio.
Dialogue: 0,0:00:41.31,0:00:42.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kusimpan saja.
Dialogue: 0,0:00:43.64,0:00:44.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:00:49.05,0:00:50.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}O-Oshio?
Dialogue: 0,0:00:51.63,0:00:52.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:00:53.05,0:00:54.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayang sekali, bukan dia.
Dialogue: 0,0:00:54.96,0:00:55.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?!
Dialogue: 0,0:00:55.74,0:00:58.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah lewat dari jam\Nyang kau bilang mau menelepon.
Dialogue: 0,0:00:58.26,0:01:00.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau sampai kapan kau membuatku menunggu?
Dialogue: 0,0:01:00.01,0:01:01.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Madoka!
Dialogue: 0,0:01:01.81,0:01:05.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}O-Oh, iya! Aku keasyikan main gim...
Dialogue: 0,0:01:05.48,0:01:07.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, sebentar lagi aku keluar!
Dialogue: 0,0:01:08.27,0:01:09.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}He-Hei!
Dialogue: 0,0:01:09.16,0:01:10.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau ini kenapa?
Dialogue: 0,0:01:10.97,0:01:11.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:01:16.72,0:01:18.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Madoka, kau mesum!
Dialogue: 0,0:01:18.79,0:01:21.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa yang mesum, coba?!
Dialogue: 0,0:01:30.55,0:01:32.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}The Cold Sato-san Is Only Sweet to Me
Dialogue: 0,0:02:53.42,0:02:55.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf lama, Madoka.
Dialogue: 0,0:02:55.42,0:02:57.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya keringkan rambutmu.
Dialogue: 0,0:02:57.92,0:03:00.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski musim panas,\Nkau tetap bisa masuk angin.
Dialogue: 0,0:03:00.78,0:03:02.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak apa-apa!
Dialogue: 0,0:03:02.40,0:03:06.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku main Kumukumu\Nwaktu berendam sampai hatinya habis.
Dialogue: 0,0:03:06.12,0:03:07.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hati?
Dialogue: 0,0:03:07.07,0:03:10.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya. Gimnya bisa dimainkan\Nselama masih ada hati,
Dialogue: 0,0:03:10.54,0:03:12.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan hatiku habis semua.
Dialogue: 0,0:03:12.36,0:03:14.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi ada yang mengirimiku satu.
Dialogue: 0,0:03:14.49,0:03:15.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tebak siapa yang mengirimkannya.
Dialogue: 0,0:03:15.85,0:03:17.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya, selamat malam.
Dialogue: 0,0:03:17.56,0:03:19.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tu-Tunggu! Kenapa?!
Dialogue: 0,0:03:19.32,0:03:21.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bahkan belum mulai mengobrol!
Dialogue: 0,0:03:21.18,0:03:22.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti si itu.
Dialogue: 0,0:03:22.48,0:03:24.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan "si itu"! Oshio!
Dialogue: 0,0:03:24.69,0:03:27.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuh, 'kan? Tidak perlu ditebak.
Dialogue: 0,0:03:27.34,0:03:28.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayolah...
Dialogue: 0,0:03:30.70,0:03:31.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang lucu?
Dialogue: 0,0:03:32.45,0:03:34.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memikirkannya saja sudah seru.
Dialogue: 0,0:03:34.55,0:03:38.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belum pernah mengobrol begini\Ndengan teman perempuan.
Dialogue: 0,0:03:38.06,0:03:39.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm.
Dialogue: 0,0:03:39.46,0:03:43.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang sekali\Nkau jadi yang pertama bagiku.
Dialogue: 0,0:03:44.18,0:03:46.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}K-Kau harus pikir dulu sebelum bicara!
Dialogue: 0,0:03:46.78,0:03:51.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bilang begitu\Nke sembarang orang. Apalagi ke cowok!
Dialogue: 0,0:03:51.27,0:03:52.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Kenapa?
Dialogue: 0,0:03:52.84,0:03:57.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau ingat waktu dikerubungi\Nanak-anak kuliahan sok itu?
Dialogue: 0,0:03:57.67,0:04:01.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak mau cowok seperti itu\Nmengejarmu lagi, 'kan?
Dialogue: 0,0:04:01.01,0:04:03.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh iya, itu pernah terjadi.
Dialogue: 0,0:04:03.26,0:04:05.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan? Waktu itu kau sampai\Ntakut tidak bisa bicara.
Dialogue: 0,0:04:05.52,0:04:09.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, Oshio menyelamatkanku!
Dialogue: 0,0:04:09.02,0:04:09.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:04:09.93,0:04:14.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oshio keren sekali waktu itu.
Dialogue: 0,0:04:14.88,0:04:17.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ugh. Aku sudah tidak peduli.
Dialogue: 0,0:04:17.87,0:04:22.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi sepertinya tidak ada\Nyang menyentuhmu setelah itu.
Dialogue: 0,0:04:22.22,0:04:24.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, ada yang menyentuhku.
Dialogue: 0,0:04:24.79,0:04:25.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?!
Dialogue: 0,0:04:25.41,0:04:30.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa berenang,\Njadi Oshio mengajariku...
Dialogue: 0,0:04:31.00,0:04:32.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hap!
Dialogue: 0,0:04:40.99,0:04:43.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be-Begini, Oshio?
Dialogue: 0,0:04:43.38,0:04:45.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, bagus. Begitu.
Dialogue: 0,0:04:45.50,0:04:47.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, aku lepas sekarang.
Dialogue: 0,0:04:47.01,0:04:47.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:04:57.09,0:04:58.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Hah?!
Dialogue: 0,0:05:02.03,0:05:03.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oshio?
Dialogue: 0,0:05:03.34,0:05:05.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tu-Tunggu...
Dialogue: 0,0:05:09.21,0:05:12.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}O-Oshio!\NKau tidak boleh begitu!
Dialogue: 0,0:05:12.30,0:05:14.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Ah!
Dialogue: 0,0:05:14.45,0:05:17.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, bukan, anu...\NItu tidak sengaja, aku cuma...
Dialogue: 0,0:05:17.45,0:05:20.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bermaksud mengintip...
Dialogue: 0,0:05:22.76,0:05:24.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}O-O-O-Oshio!
Dialogue: 0,0:05:24.32,0:05:27.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}K-Kau tidak boleh begitu!\NJangan di tempat umum begini!
Dialogue: 0,0:05:27.36,0:05:27.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:05:30.46,0:05:35.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak boleh! Lihat waktu dan tempat!\NAda waktu dan tempatnya!
Dialogue: 0,0:05:35.23,0:05:37.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak paham maksudmu!
Dialogue: 0,0:05:37.49,0:05:41.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kau menyentuh kaki dan bokongku!
Dialogue: 0,0:05:41.70,0:05:43.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak boleh begitu!
Dialogue: 0,0:05:43.75,0:05:45.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa?!
Dialogue: 0,0:05:49.43,0:05:50.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh. Apa ini...
Dialogue: 0,0:05:50.89,0:05:52.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ubur-ubur...
Dialogue: 0,0:05:52.46,0:05:55.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kalau begitu,\Nbenda licin yang menyentuhku itu...
Dialogue: 0,0:05:55.37,0:05:56.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin ubur-ubur.
Dialogue: 0,0:05:58.99,0:06:02.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maaf! Sepertinya aku salah paham...
Dialogue: 0,0:06:02.62,0:06:06.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak apa-apa. Kau sendiri tidak apa-apa?\NTidak tersengat?
Dialogue: 0,0:06:06.61,0:06:08.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Y-Ya, aku tidak apa-apa.
Dialogue: 0,0:06:08.62,0:06:10.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, syukurlah.
Dialogue: 0,0:06:10.42,0:06:13.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beberapa tahun lalu,\Nayahku disengat ubur-ubur.
Dialogue: 0,0:06:13.99,0:06:15.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya cuka bisa membantu\Nmengatasi sengatannya,
Dialogue: 0,0:06:15.80,0:06:18.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi orang-orang menyiramnya\Ndengan banyak cuka.
Dialogue: 0,0:06:18.22,0:06:21.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya, sakit sekali...
Dialogue: 0,0:06:21.01,0:06:22.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu...
Dialogue: 0,0:06:22.89,0:06:25.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini kita terus ketemu masalah aneh, ya?
Dialogue: 0,0:06:26.80,0:06:28.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Y-Ya, benar.
Dialogue: 0,0:06:30.19,0:06:34.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Tunggu, kalau aku tersengat,\Naku bakal disiram cuka?!
Dialogue: 0,0:06:39.02,0:06:39.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ubur-ubur!
Dialogue: 0,0:06:39.91,0:06:40.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:06:41.23,0:06:43.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku bakal tersengat!\NAku bakal disiram cuka!
Dialogue: 0,0:06:43.73,0:06:44.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sato! Tunggu!
Dialogue: 0,0:06:44.73,0:06:46.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka menyerangku!
Dialogue: 0,0:06:46.59,0:06:47.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuka!
Dialogue: 0,0:06:48.16,0:06:51.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sa-Sato!
Dialogue: 0,0:06:52.77,0:06:54.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ugh. Konyol.
Dialogue: 0,0:06:54.76,0:06:56.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan jahat!
Dialogue: 0,0:06:56.11,0:06:59.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mendengarmu pamer soal pacar\Nbenar-benar membosankan.
Dialogue: 0,0:06:59.41,0:07:01.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak pamer!
Dialogue: 0,0:07:01.53,0:07:04.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bukan pamer, terus apa?
Dialogue: 0,0:07:04.17,0:07:05.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, 'kan, Leo?
Dialogue: 0,0:07:06.67,0:07:09.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Bagaimana denganmu, Madoka?
Dialogue: 0,0:07:09.62,0:07:11.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Bagaimana dengan apa?
Dialogue: 0,0:07:11.06,0:07:15.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu kami pulang,\NRen tidak ikut bersama kami.
Dialogue: 0,0:07:15.56,0:07:19.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku penasaran kenapa dia tidak ikut pulang.
Dialogue: 0,0:07:19.10,0:07:19.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ugh...
Dialogue: 0,0:07:25.77,0:07:29.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh? Dia tersipu! Kenapa dia tersipu, Leo?
Dialogue: 0,0:07:29.79,0:07:32.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak terjadi apa-apa!
Dialogue: 0,0:07:32.61,0:07:35.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bohong! Wajahmu bilang\Npasti ada sesuatu!
Dialogue: 0,0:07:35.67,0:07:37.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak adil! Cuma aku yang cerita!
Dialogue: 0,0:07:37.21,0:07:39.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga mau dengar kisah cintamu!
Dialogue: 0,0:07:39.98,0:07:43.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makin akrab, kau makin tidak sungkan, ya.
Dialogue: 0,0:07:43.62,0:07:45.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Huuu! Huuu! Huuu!
Dialogue: 0,0:07:45.62,0:07:46.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa berhenti, tidak?!
Dialogue: 0,0:07:46.98,0:07:50.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak sepertimu! Aku cuma tidak mau\Npunya alasan untuk pamer!
Dialogue: 0,0:07:50.40,0:07:54.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya kenapa? Oshio itu pacar\Npaling keren dan luar biasa di dunia!
Dialogue: 0,0:07:54.75,0:07:58.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ugh. Pamer soal pacarmu sih\Nbukan masalah, tapi...
Dialogue: 0,0:07:58.08,0:08:02.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya. Kau tidak punya apa-apa\Nyang bisa dipamerkan soal dirimu, ya?
Dialogue: 0,0:08:02.10,0:08:03.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jahat sekali!
Dialogue: 0,0:08:04.04,0:08:07.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga punya hal yang bisa dibanggakan!
Dialogue: 0,0:08:07.26,0:08:10.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh? Coba sebutkan apa saja.
Dialogue: 0,0:08:11.76,0:08:13.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Uh... Uhh...
Dialogue: 0,0:08:14.54,0:08:15.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku punya akun Minsta!
Dialogue: 0,0:08:15.64,0:08:16.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlalu remeh.
Dialogue: 0,0:08:17.23,0:08:19.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Se-Senyumku manis.
Dialogue: 0,0:08:19.27,0:08:20.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau berkelahi?
Dialogue: 0,0:08:20.65,0:08:21.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh!
Dialogue: 0,0:08:21.72,0:08:24.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kalau begitu...\NOshio itu pacarku!
Dialogue: 0,0:08:24.15,0:08:25.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia lagi?!
Dialogue: 0,0:08:25.65,0:08:28.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kutampar kau begitu kita ketemu lagi!
Dialogue: 0,0:08:28.37,0:08:30.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan jahat padaku!
Dialogue: 0,0:08:30.15,0:08:32.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi yang kau bicarakan cuma Sota.
Dialogue: 0,0:08:32.79,0:08:34.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, apa bagusnya dia?
Dialogue: 0,0:08:34.78,0:08:36.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia jago memotret untuk Minsta.
Dialogue: 0,0:08:36.65,0:08:38.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alasannya lemah.
Dialogue: 0,0:08:38.42,0:08:39.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senyumnya tampan!
Dialogue: 0,0:08:39.69,0:08:42.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua ekspresinya juga bagus sekali!
Dialogue: 0,0:08:42.09,0:08:42.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau...
Dialogue: 0,0:08:42.91,0:08:45.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetap saja harus kuhajar!
Dialogue: 0,0:08:45.18,0:08:45.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh!
Dialogue: 0,0:08:45.82,0:08:47.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu... Anu... Dia...
Dialogue: 0,0:08:47.96,0:08:50.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia selalu menyelamatkanku!
Dialogue: 0,0:08:51.17,0:08:52.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti hari itu...
Dialogue: 0,0:08:58.55,0:09:00.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Musim dingin waktu kelas 1 SMA,
Dialogue: 0,0:09:00.70,0:09:04.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}suatu hari, salju turun deras sekali\Nsampai kupikir aku bakal terjebak.
Dialogue: 0,0:09:05.20,0:09:06.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang aku harus bagaimana?
Dialogue: 0,0:09:12.89,0:09:14.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sato?
Dialogue: 0,0:09:19.27,0:09:21.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sedang menunggu bus?
Dialogue: 0,0:09:22.20,0:09:24.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak, aku tidak menunggu bus.
Dialogue: 0,0:09:24.24,0:09:26.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...\Nmenunggu orang tuamu menjemputmu?
Dialogue: 0,0:09:26.69,0:09:27.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka tidak akan datang.
Dialogue: 0,0:09:30.15,0:09:33.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, baterai ponselmu habis?
Dialogue: 0,0:09:34.13,0:09:37.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Layarnya tiba-tiba mati.
Dialogue: 0,0:09:37.04,0:09:39.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, hari ini memang dingin.
Dialogue: 0,0:09:39.80,0:09:41.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau punya power bank?
Dialogue: 0,0:09:41.27,0:09:42.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak punya.
Dialogue: 0,0:09:42.65,0:09:45.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau menelepon\Norang tuamu dari telepon umum?
Dialogue: 0,0:09:45.05,0:09:47.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku lupa bawa dompet.
Dialogue: 0,0:09:47.30,0:09:48.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, bus...
Dialogue: 0,0:09:48.94,0:09:51.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, kau lupa bawa dompet.
Dialogue: 0,0:09:52.25,0:09:53.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu sebentar.
Dialogue: 0,0:09:53.98,0:09:54.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:09:56.26,0:09:58.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau boleh pakai ini.
Dialogue: 0,0:09:58.06,0:09:59.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:09:59.23,0:10:00.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Power bank-ku.
Dialogue: 0,0:10:00.83,0:10:02.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa kau yakin?
Dialogue: 0,0:10:03.00,0:10:08.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa. Aku sedang menunggu bus.\NKau boleh pakai sampai busnya datang.
Dialogue: 0,0:10:08.26,0:10:11.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Te-Terima kasih banyak.
Dialogue: 0,0:10:23.15,0:10:25.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka akan datang menjemputku.
Dialogue: 0,0:10:25.73,0:10:27.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah.
Dialogue: 0,0:10:36.34,0:10:38.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:10:38.34,0:10:39.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Sampai jumpa.
Dialogue: 0,0:10:55.04,0:10:57.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menunggu sampai mereka datang...
Dialogue: 0,0:10:57.42,0:10:59.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan naik.
Dialogue: 0,0:11:31.72,0:11:36.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami tidak pernah bicara sejak ujian masuk,\Ntapi dia tetap baik sekali!
Dialogue: 0,0:11:36.46,0:11:39.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia juga ingat namaku!
Dialogue: 0,0:11:39.22,0:11:40.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang sekali!
Dialogue: 0,0:11:41.14,0:11:43.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan sekarang, Oshio itu pacarku!
Dialogue: 0,0:11:43.51,0:11:44.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku ingin memamerkannya!
Dialogue: 0,0:11:44.91,0:11:46.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin membicarakan\Nsemua hal terbaik tentang dia!
Dialogue: 0,0:11:47.38,0:11:48.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ugh, serius...
Dialogue: 0,0:11:48.92,0:11:51.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih atas suguhannya.\NAku sudah enek.
Dialogue: 0,0:11:51.49,0:11:53.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa berhenti jahat padaku?! Dasar!
Dialogue: 0,0:11:54.99,0:11:58.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, iya. Aku akan menahan diri\Ndan mendengarkanmu.
Dialogue: 0,0:11:58.14,0:11:59.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?!
Dialogue: 0,0:11:59.42,0:12:01.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, beberapa hari lalu...
Dialogue: 0,0:12:02.67,0:12:05.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oshio keren sekali!
Dialogue: 0,0:12:05.13,0:12:05.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia...
Dialogue: 0,0:12:06.69,0:12:09.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang, keringkan rambutmu!
Dialogue: 0,0:12:09.09,0:12:11.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak apa-apa! Pokoknya...
Dialogue: 0,0:12:15.46,0:12:16.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau selalu begini?
Dialogue: 0,0:12:17.38,0:12:20.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mengeringkan rambut,\Nlalu menelepon semalaman.
Dialogue: 0,0:12:20.84,0:12:24.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma orang bodoh\Nyang masuk angin di musim panas.
Dialogue: 0,0:12:24.13,0:12:27.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bodoh. Itu seru.
Dialogue: 0,0:12:27.50,0:12:30.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, iya. Tidur saja\Ndan istirahat yang cukup.
Dialogue: 0,0:12:34.38,0:12:35.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamar ini...
Dialogue: 0,0:12:36.58,0:12:40.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa langit-langit dan dindingnya\Nselalu seputih ini?
Dialogue: 0,0:12:41.44,0:12:44.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dingin. Salju bahkan turun.
Dialogue: 0,0:12:46.23,0:12:51.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, itu kelihatan seperti...
Dialogue: 0,0:12:58.75,0:13:01.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah! Lihat! Cantik sekali!
Dialogue: 0,0:13:02.29,0:13:05.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kau membuka mata selebar itu,\Nmatamu bisa copot.
Dialogue: 0,0:13:05.82,0:13:06.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?!
Dialogue: 0,0:13:08.51,0:13:10.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma bercanda! Bercanda!
Dialogue: 0,0:13:10.94,0:13:11.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo jalan?
Dialogue: 0,0:13:12.16,0:13:12.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:13:26.11,0:13:26.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini.
Dialogue: 0,0:13:29.20,0:13:30.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jaga baik-baik, ya.
Dialogue: 0,0:13:30.50,0:13:30.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:13:30.98,0:13:31.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, 'kan?
Dialogue: 0,0:13:31.95,0:13:33.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah...
Dialogue: 0,0:13:44.23,0:13:44.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:13:50.05,0:13:51.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau itu!
Dialogue: 0,0:13:51.61,0:13:53.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lucunya. Mau Ibu belikan?
Dialogue: 0,0:13:53.88,0:13:54.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:13:54.83,0:13:57.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita sudah janji\Nkau cuma boleh dapat satu hadiah,
Dialogue: 0,0:13:57.99,0:13:59.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan kau sudah memilih boneka itu.
Dialogue: 0,0:14:01.31,0:14:06.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi bonekanya tidak mahal.\NSedikit permen tidak masalah.
Dialogue: 0,0:14:06.58,0:14:08.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masalahnya bukan soal uang.
Dialogue: 0,0:14:08.48,0:14:10.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu, aku mengerti.
Dialogue: 0,0:14:10.40,0:14:12.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kiyomi, jangan manjakan Koharu.
Dialogue: 0,0:14:13.34,0:14:14.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:14:14.38,0:14:19.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau putriku tumbuh jadi orang\Nyang tidak bisa menepati janji.
Dialogue: 0,0:14:19.82,0:14:22.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Janji? Usianya masih tujuh tahun.
Dialogue: 0,0:14:22.71,0:14:25.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru itu aku harus mengajarinya sekarang.
Dialogue: 0,0:14:25.53,0:14:27.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tugas orang tua.
Dialogue: 0,0:14:27.90,0:14:32.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau jadi ayah\Nyang melalaikan tugasnya.
Dialogue: 0,0:14:32.68,0:14:34.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya itu?
Dialogue: 0,0:14:34.75,0:14:37.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudmu, aku melalaikan tugasku?
Dialogue: 0,0:14:37.25,0:14:38.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan itu maksudku.
Dialogue: 0,0:14:39.50,0:14:41.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bicara soal peran kita.
Dialogue: 0,0:14:41.58,0:14:42.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya itu?!
Dialogue: 0,0:14:42.81,0:14:45.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku punya caraku sendiri\Ndalam membesarkan anak.
Dialogue: 0,0:14:45.55,0:14:48.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu cuma pendapatmu, bukan pendapatku!
Dialogue: 0,0:14:49.02,0:14:52.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah... Ibu...
Dialogue: 0,0:15:15.02,0:15:19.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah? Ibu? Kalian di mana?
Dialogue: 0,0:15:19.25,0:15:21.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah? Ibu?
Dialogue: 0,0:15:22.21,0:15:24.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah! Ibu!
Dialogue: 0,0:15:24.86,0:15:25.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:15:25.70,0:15:26.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:15:26.72,0:15:27.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada masalah?
Dialogue: 0,0:15:39.67,0:15:42.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah... Ibu...
Dialogue: 0,0:15:42.48,0:15:46.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf... Aku tidak akan\Nminta apa-apa lagi...
Dialogue: 0,0:15:46.62,0:15:47.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong...
Dialogue: 0,0:15:47.74,0:15:49.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, hei! Kau!
Dialogue: 0,0:15:49.95,0:15:50.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:15:51.42,0:15:52.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat, lihat!
Dialogue: 0,0:15:52.54,0:15:54.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini aku buat sendiri!
Dialogue: 0,0:15:55.35,0:15:57.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan berubah wujud sekarang!
Dialogue: 0,0:15:57.49,0:15:58.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hap...
Dialogue: 0,0:15:58.36,0:16:00.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berubah!
Dialogue: 0,0:16:00.21,0:16:01.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cring!
Dialogue: 0,0:16:01.88,0:16:02.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keren, 'kan?
Dialogue: 0,0:16:05.14,0:16:08.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sendirian?\NIbu dan ayahmu di mana?
Dialogue: 0,0:16:10.74,0:16:12.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, kau tersesat, ya?
Dialogue: 0,0:16:13.91,0:16:15.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga tersesat!
Dialogue: 0,0:16:15.64,0:16:16.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:16:16.38,0:16:19.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pura-pura tidak tahu,
Dialogue: 0,0:16:19.21,0:16:20.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi Ibu dan Ayah\Ndatang ke sini setiap tahun
Dialogue: 0,0:16:20.80,0:16:24.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk membelikan hadiah Natal untukku,\Ngantinya Sinterklas.
Dialogue: 0,0:16:24.25,0:16:25.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Apa?
Dialogue: 0,0:16:25.66,0:16:27.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sinterklas itu tidak ada?!
Dialogue: 0,0:16:27.93,0:16:31.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bilang aku tidak butuh hadiah\Nkarena sudah punya sabuk ini,
Dialogue: 0,0:16:31.43,0:16:34.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi mereka tetap melihat-lihat\Nlalu pergi entah ke mana.
Dialogue: 0,0:16:34.05,0:16:36.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak apa-apa begitu?
Dialogue: 0,0:16:36.27,0:16:37.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya kenapa?
Dialogue: 0,0:16:37.36,0:16:42.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi bagaimana kalau ibu dan ayahmu\Ntidak bisa menemukanmu?
Dialogue: 0,0:16:42.30,0:16:43.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka akan menemukanku.
Dialogue: 0,0:16:44.40,0:16:46.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pohon ini yang paling besar di sini.
Dialogue: 0,0:16:46.95,0:16:49.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami sudah janji akan bertemu di sini\Nkalau aku tersesat.
Dialogue: 0,0:16:50.30,0:16:52.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau cukup tunggu di sini.\NMereka pasti datang.
Dialogue: 0,0:16:53.83,0:16:55.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin juga tidak.
Dialogue: 0,0:16:55.10,0:16:55.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:16:56.03,0:17:00.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu dan Ayah... mungkin tidak akan datang.
Dialogue: 0,0:17:00.98,0:17:06.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku melanggar janji, jadi mungkin\NIbu dan Ayah sudah tidak sayang padaku.
Dialogue: 0,0:17:10.61,0:17:11.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu sebentar.
Dialogue: 0,0:17:14.74,0:17:15.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat.
Dialogue: 0,0:17:17.22,0:17:18.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu...
Dialogue: 0,0:17:18.26,0:17:20.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hadiah dari ibuku!
Dialogue: 0,0:17:24.02,0:17:25.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini, ambillah.
Dialogue: 0,0:17:25.64,0:17:26.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh.
Dialogue: 0,0:17:27.17,0:17:28.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh buatku?
Dialogue: 0,0:17:28.23,0:17:28.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:17:28.98,0:17:33.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kata ibuku, cokelat itu suguhan istimewa.
Dialogue: 0,0:17:33.33,0:17:36.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kita memakannya di hari istimewa\Nbersama orang yang istimewa.
Dialogue: 0,0:17:37.08,0:17:39.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku istimewa?
Dialogue: 0,0:17:39.06,0:17:41.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tersesat, 'kan?\NBerarti kau istimewa!
Dialogue: 0,0:17:44.59,0:17:48.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin ayah dan ibumu juga menganggap\Nkau istimewa.
Dialogue: 0,0:17:48.51,0:17:49.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:17:49.78,0:17:51.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau kita buktikan?
Dialogue: 0,0:17:51.14,0:17:51.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:17:51.90,0:17:53.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa namamu?
Dialogue: 0,0:17:54.35,0:17:57.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sa-Sato Koharu.
Dialogue: 0,0:18:01.13,0:18:08.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu dan Ayah Sato Koharu!
Dialogue: 0,0:18:09.01,0:18:11.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian ada di sini?
Dialogue: 0,0:18:12.03,0:18:19.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu dan Ayah Sato Koharu!
Dialogue: 0,0:18:24.38,0:18:25.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Koharu!
Dialogue: 0,0:18:25.39,0:18:26.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Koharu!
Dialogue: 0,0:18:27.59,0:18:29.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah! Ibu!
Dialogue: 0,0:18:30.34,0:18:33.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Koharu! Kau terluka?\NAda yang sakit?!
Dialogue: 0,0:18:33.26,0:18:35.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak, aku tidak apa-apa.
Dialogue: 0,0:18:35.47,0:18:36.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah.
Dialogue: 0,0:18:36.74,0:18:38.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah...
Dialogue: 0,0:18:38.49,0:18:39.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan Ibu.
Dialogue: 0,0:18:40.59,0:18:41.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh!
Dialogue: 0,0:19:05.91,0:19:07.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku bisa bertemu dengannya lagi?
Dialogue: 0,0:19:08.51,0:19:10.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga...
Dialogue: 0,0:19:13.35,0:19:16.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menemukan... bintangku...
Dialogue: 0,0:19:18.60,0:19:24.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu... Sato, kalau kau memegangku\Nseerat itu, rasanya... agak...
Dialogue: 0,0:19:24.79,0:19:27.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}memalukan.
Dialogue: 0,0:19:27.67,0:19:28.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:19:29.50,0:19:30.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:19:32.46,0:19:34.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat pagi.
Dialogue: 0,0:19:34.60,0:19:36.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oshio...
Dialogue: 0,0:19:36.71,0:19:37.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah!
Dialogue: 0,0:19:40.53,0:19:42.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maaf! Aku membuatmu kaget, ya?
Dialogue: 0,0:19:42.78,0:19:45.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, aku senang!
Dialogue: 0,0:19:45.55,0:19:49.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harusnya kau telepon dulu sebelum datang...
Dialogue: 0,0:19:49.10,0:19:50.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:19:50.31,0:19:54.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku tahu kau mau datang,\Naku pasti sudah membereskan kamarku!
Dialogue: 0,0:19:54.12,0:19:57.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga mau menata rambut\Ndan ganti baju karena berkeringat...
Dialogue: 0,0:19:57.87,0:20:01.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu malah tidak boleh. Kau harus istirahat.
Dialogue: 0,0:20:01.08,0:20:01.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ugh...
Dialogue: 0,0:20:02.23,0:20:05.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, menurutku,\Nkamarmu sudah rapi sekali.
Dialogue: 0,0:20:05.80,0:20:08.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, mungkin sebaiknya\Naku tidak melihat-lihat terlalu dekat?
Dialogue: 0,0:20:08.82,0:20:11.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya, aku senang bisa bertemu denganmu.
Dialogue: 0,0:20:13.28,0:20:15.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga senang!\NKau baik sekali! Aku suka padamu!
Dialogue: 0,0:20:16.38,0:20:17.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini untukmu.
Dialogue: 0,0:20:19.03,0:20:21.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memikirkan makanan apa\Nyang enak untuk kau makan,
Dialogue: 0,0:20:21.40,0:20:23.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu aku membuatkanmu puding.
Dialogue: 0,0:20:23.22,0:20:26.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau yang membuatnya, Oshio?
Dialogue: 0,0:20:26.13,0:20:28.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku minta diajari ayahku.
Dialogue: 0,0:20:28.21,0:20:31.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini pertama kalinya aku membuatnya,\Njadi mungkin tidak terlalu enak.
Dialogue: 0,0:20:35.68,0:20:37.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin memakannya sekarang.
Dialogue: 0,0:20:37.78,0:20:40.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah? Akan kutaruh di sini, ya.
Dialogue: 0,0:20:40.35,0:20:42.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oshio, suapi aku.
Dialogue: 0,0:20:43.77,0:20:45.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku masih merasa tidak enak badan,
Dialogue: 0,0:20:45.61,0:20:49.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi bisa tolong pegang sendoknya\Ndan suapi aku?
Dialogue: 0,0:20:51.44,0:20:52.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baiklah.
Dialogue: 0,0:20:53.47,0:20:55.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu aku masih kecil, ibuku bilang...
Dialogue: 0,0:20:56.75,0:20:57.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bintang!
Dialogue: 0,0:20:57.72,0:21:02.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena kita makan cokelat\Ndi hari istimewa bersama orang istimewa,
Dialogue: 0,0:21:02.28,0:21:03.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}cokelat adalah suguhan istimewa.
Dialogue: 0,0:21:04.51,0:21:08.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kata ibuku, cokelat itu suguhan istimewa.
Dialogue: 0,0:21:11.73,0:21:13.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, anak itu kau, Oshio?
Dialogue: 0,0:21:15.25,0:21:20.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jatuh cinta pada cinta pertamaku\Nuntuk ketiga kalinya...
Dialogue: 0,0:21:22.23,0:21:24.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak boleh makan\Nterlalu banyak cokelat saat sakit,
Dialogue: 0,0:21:24.41,0:21:25.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi ini cuma sedikit untuk rasanya saja.
Dialogue: 0,0:21:26.70,0:21:27.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:21:29.85,0:21:31.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?! Ada apa?!
Dialogue: 0,0:21:32.25,0:21:34.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku membuat demammu makin parah?!
Dialogue: 0,0:21:34.54,0:21:37.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf! Tante! Tante!
Dialogue: 0,0:21:37.91,0:21:39.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Koharu... Koharu...
Dialogue: 0,0:21:40.83,0:21:42.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau lihat, Madoka?
Dialogue: 0,0:21:43.28,0:21:45.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oshio selalu menyelamatkanku.
Dialogue: 0,0:21:47.35,0:21:52.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga suatu hari nanti\Naku bisa melakukan sesuatu untuk Oshio.
Dialogue: 0,0:23:34.99,0:23:38.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya, "Karena Aku Pacarmu".
Dialogue: 0,0:23:38.17,0:23:39.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena aku pacarmu!
