Dialogue: 0,0:00:07.59,0:00:09.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Boneka Kepala Goyang.
Dialogue: 0,0:00:10.80,0:00:13.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bergadang semalam?
Dialogue: 0,0:00:13.28,0:00:14.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ren.
Dialogue: 0,0:00:15.51,0:00:18.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti semalaman cari video porno, ya?
Dialogue: 0,0:00:18.48,0:00:20.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan urusanmu, 'kan?
Dialogue: 0,0:00:21.39,0:00:23.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin kubilang!
Dialogue: 0,0:00:23.83,0:00:28.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa tidur karena terlalu senang\Nbisa bicara dengan gadis yang kusuka,
Dialogue: 0,0:00:28.54,0:00:30.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi juga cemas kalau-kalau aku\Nsudah bersikap kasar padanya!
Dialogue: 0,0:00:32.68,0:00:34.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, bangun.
Dialogue: 0,0:00:34.61,0:00:38.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak suka makan sambil\Nmelihat temanku tidur.
Dialogue: 0,0:00:43.00,0:00:45.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Apa...
Dialogue: 0,0:00:50.97,0:00:52.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau apakan dia?
Dialogue: 0,0:00:52.74,0:00:55.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kapan?! Sejak kapan dia seperti itu?!
Dialogue: 0,0:00:55.56,0:00:56.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak pagi.
Dialogue: 0,0:00:56.99,0:00:57.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak pagi?!
Dialogue: 0,0:00:57.99,0:01:02.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya semua orang heboh.
Dialogue: 0,0:01:05.68,0:01:08.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sa-Sato...
Dialogue: 0,0:01:18.50,0:01:20.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}The Cold Sato-san Is Only Sweet to Me
Dialogue: 0,0:02:42.20,0:02:43.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa gara-gara itu?
Dialogue: 0,0:02:44.06,0:02:45.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kubawa ke kamarku?
Dialogue: 0,0:02:45.62,0:02:47.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kubilang fotonya jelek?
Dialogue: 0,0:02:47.46,0:02:48.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kupegang tangannya?!
Dialogue: 0,0:02:51.01,0:02:52.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oshio.
Dialogue: 0,0:02:53.48,0:02:55.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Y-Ya?
Dialogue: 0,0:03:03.76,0:03:06.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nomor! Boleh aku minta nomormu?
Dialogue: 0,0:03:06.63,0:03:07.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:03:07.43,0:03:10.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?!
Dialogue: 0,0:03:13.56,0:03:18.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak, bukan begitu! Aku bukannya\Nmau menelepon atau mengirim pesan!
Dialogue: 0,0:03:18.13,0:03:19.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, bukan, maaf, itu bohong.
Dialogue: 0,0:03:19.74,0:03:20.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya aku ingin sekali meneleponmu...
Dialogue: 0,0:03:20.79,0:03:22.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi bukan sekarang!
Dialogue: 0,0:03:22.56,0:03:24.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh... begini...
Dialogue: 0,0:03:24.07,0:03:27.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kupikir aku harus mengirimkan fotonya...
Dialogue: 0,0:03:28.37,0:03:29.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sato...
Dialogue: 0,0:03:29.30,0:03:33.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Swafoto kita di rumahmu kemarin!
Dialogue: 0,0:03:35.12,0:03:35.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah!
Dialogue: 0,0:03:41.83,0:03:42.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sato!
Dialogue: 0,0:03:43.10,0:03:44.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau haus, 'kan?!
Dialogue: 0,0:03:44.66,0:03:45.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Aku tidak haus...
Dialogue: 0,0:03:45.89,0:03:47.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, aku yang traktir! Ayo!
Dialogue: 0,0:03:50.67,0:03:53.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Swafoto di rumahnya?!\N- Sato yang itu? Minta nomor?!
Dialogue: 0,0:03:53.07,0:03:55.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus, kenapa harus Oshio?!
Dialogue: 0,0:03:55.73,0:03:56.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus.
Dialogue: 0,0:03:59.68,0:04:02.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sudah... cukup jauh...
Dialogue: 0,0:04:02.87,0:04:04.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oshio...
Dialogue: 0,0:04:04.40,0:04:05.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:04:05.35,0:04:07.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu... Tangan...
Dialogue: 0,0:04:08.73,0:04:09.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tangan?
Dialogue: 0,0:04:10.82,0:04:11.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah!
Dialogue: 0,0:04:12.24,0:04:13.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maaf!
Dialogue: 0,0:04:17.26,0:04:18.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ekspresi macam apa itu?!
Dialogue: 0,0:04:21.99,0:04:24.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ekspresi macam apa itu?!
Dialogue: 0,0:04:24.02,0:04:26.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa dia jijik karena kupegang tangannya?!
Dialogue: 0,0:04:26.85,0:04:28.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa tanganku berkeringat sekali?!
Dialogue: 0,0:04:29.89,0:04:31.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:04:32.80,0:04:36.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiba-tiba minta nomormu...\NAku cuma merepotkanmu.
Dialogue: 0,0:04:36.46,0:04:37.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:04:37.13,0:04:42.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau membawaku ke sini karena aku sudah\Nmempermalukanmu di depan semua orang.
Dialogue: 0,0:04:42.11,0:04:43.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak...
Dialogue: 0,0:04:44.39,0:04:45.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, tidak sama sekali.
Dialogue: 0,0:04:46.70,0:04:49.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malah, aku senang.
Dialogue: 0,0:04:50.13,0:04:50.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:04:52.11,0:04:54.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo tukar nomor.
Dialogue: 0,0:04:56.59,0:04:57.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:04:59.60,0:05:01.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya!
Dialogue: 0,0:05:01.02,0:05:02.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada kontak selain keluargaku!
Dialogue: 0,0:05:03.72,0:05:05.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekali lagi, terima kasih, Sato.
Dialogue: 0,0:05:07.13,0:05:08.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan salah paham.
Dialogue: 0,0:05:08.86,0:05:12.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sato sedang berusaha lepas\Ndari julukan "Sato si Dingin".
Dialogue: 0,0:05:12.36,0:05:15.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau cuma teman pertama yang dia pilih untuk itu.
Dialogue: 0,0:05:28.73,0:05:33.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai kapan aku bisa bertahan\Nmenjadi "cuma teman"
Dialogue: 0,0:05:33.01,0:05:35.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan gadis semanis ini?
Dialogue: 0,0:05:42.02,0:05:43.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}O-Oshio!
Dialogue: 0,0:05:44.34,0:05:47.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini kedai teh susu boba itu!
Dialogue: 0,0:05:47.34,0:05:49.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya minumannya kelihatan estetik\Nkalau difoto!
Dialogue: 0,0:05:49.02,0:05:51.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sato, tenang dulu.
Dialogue: 0,0:05:51.23,0:05:54.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Antreannya panjang sekali. Kau yakin?
Dialogue: 0,0:05:54.77,0:05:58.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya! Kita sudah datang jauh-jauh ke sini.\NMana bisa pulang begitu saja!
Dialogue: 0,0:05:58.37,0:05:59.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh.
Dialogue: 0,0:05:59.21,0:06:03.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf... Aku tidak enak membuatmu\Nmenunggu selama itu.
Dialogue: 0,0:06:03.95,0:06:07.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo antre. Aku haus.
Dialogue: 0,0:06:07.10,0:06:08.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:06:08.15,0:06:09.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin mencobanya juga.
Dialogue: 0,0:06:10.18,0:06:12.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini juga demi dirimu, Sato.
Dialogue: 0,0:06:13.24,0:06:16.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Demi... aku?
Dialogue: 0,0:06:16.97,0:06:19.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maksudmu... seperti...
Dialogue: 0,0:06:20.56,0:06:25.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau mengunggah boba yang lagi tren\Nke Minsta biar dapat teman, 'kan?
Dialogue: 0,0:06:27.48,0:06:29.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Benar.
Dialogue: 0,0:06:29.86,0:06:36.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hampir saja aku kegeeran\Nmengira dia mengajakku kencan!
Dialogue: 0,0:06:39.02,0:06:40.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh!
Dialogue: 0,0:06:41.29,0:06:43.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}O-Oshio! Ini!
Dialogue: 0,0:06:43.55,0:06:45.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana cara memotret ini supaya bagus?
Dialogue: 0,0:06:46.97,0:06:50.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paling gampang, foto di depan papan nama itu.
Dialogue: 0,0:06:50.30,0:06:52.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat? Seperti mereka.
Dialogue: 0,0:06:52.33,0:06:55.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masukkan papan nama toko\Ndan gelasnya dalam satu frame.
Dialogue: 0,0:06:55.92,0:06:59.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang penting,\Norang jadi tahu ini dari toko mana.
Dialogue: 0,0:07:01.07,0:07:03.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oshio memang\Npengguna Minstagram profesional...
Dialogue: 0,0:07:04.91,0:07:08.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi hati-hati,\Njangan sampai orang lain ikut terfoto.
Dialogue: 0,0:07:08.41,0:07:10.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya! Aku mengerti!
Dialogue: 0,0:07:14.73,0:07:16.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini enak.
Dialogue: 0,0:07:16.05,0:07:17.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kafe kami juga bisa bikin ini...
Dialogue: 0,0:07:17.59,0:07:18.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah memotretnya!
Dialogue: 0,0:07:18.76,0:07:19.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:07:19.35,0:07:21.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat, Oshio!
Dialogue: 0,0:07:21.09,0:07:22.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ce-Cepat sekali!
Dialogue: 0,0:07:24.72,0:07:26.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Uh...
Dialogue: 0,0:07:26.42,0:07:28.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanganmu... cantik?
Dialogue: 0,0:07:28.73,0:07:32.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi malu!
Dialogue: 0,0:07:32.69,0:07:36.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi ini kurang layak diunggah ke Minsta...
Dialogue: 0,0:07:36.34,0:07:37.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?!
Dialogue: 0,0:07:37.44,0:07:40.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa...
Dialogue: 0,0:07:40.20,0:07:42.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, kenapa kau pikir foto itu\Nlayak diunggah?
Dialogue: 0,0:07:42.78,0:07:44.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah! Miko, itu luar biasa!
Dialogue: 0,0:07:44.67,0:07:46.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, aku foto dulu!
Dialogue: 0,0:07:46.20,0:07:48.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat! Aku tidak kuat lama-lama!
Dialogue: 0,0:07:48.70,0:07:51.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dadaku kedinginan!
Dialogue: 0,0:07:52.19,0:07:56.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus! Pengikut Minsta-mu\Npasti nambah gara-gara ini!
Dialogue: 0,0:08:02.70,0:08:05.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sa-Sato, jadi...
Dialogue: 0,0:08:05.84,0:08:06.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:08:08.50,0:08:10.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sa-Sato?
Dialogue: 0,0:08:11.32,0:08:14.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oshio, kau suka dada besar?
Dialogue: 0,0:08:14.98,0:08:20.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maaf. Ta-Tapi aku tidak memikirkan\Nhal mesum apa pun...
Dialogue: 0,0:08:20.65,0:08:22.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga bisa, kok.
Dialogue: 0,0:08:22.48,0:08:24.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Kau bisa...
Dialogue: 0,0:08:24.06,0:08:25.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak perlu memaksakan...
Dialogue: 0,0:08:25.28,0:08:27.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa! Akan kulakukan!
Dialogue: 0,0:08:27.05,0:08:28.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berhasil!
Dialogue: 0,0:08:28.28,0:08:30.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa?!
Dialogue: 0,0:08:33.53,0:08:35.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awas! Jangan sampai jatuh...
Dialogue: 0,0:08:39.41,0:08:40.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh!
Dialogue: 0,0:08:41.45,0:08:43.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Bagaimana, Oshio?
Dialogue: 0,0:08:43.52,0:08:45.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah! Hebat!
Dialogue: 0,0:08:45.85,0:08:48.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah! Sato, seragammu!
Dialogue: 0,0:08:48.55,0:08:49.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:08:56.09,0:08:57.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sato!
Dialogue: 0,0:09:06.51,0:09:08.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maaf...
Dialogue: 0,0:09:09.30,0:09:10.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, aku yang minta maaf...
Dialogue: 0,0:09:19.61,0:09:21.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suasananya canggung...
Dialogue: 0,0:09:21.47,0:09:22.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benar-benar minta maaf.
Dialogue: 0,0:09:22.63,0:09:23.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:09:24.32,0:09:29.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memang tidak berguna.\NSemuanya kukacaukan.
Dialogue: 0,0:09:32.13,0:09:34.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal sudah kau bantu,\Naku tetap tidak bisa melakukan
Dialogue: 0,0:09:34.31,0:09:36.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hal yang bisa dilakukan orang lain.
Dialogue: 0,0:09:36.58,0:09:41.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minumannya keburu habis, tapi aku\Ntidak dapat satu pun foto yang bagus.
Dialogue: 0,0:09:46.06,0:09:47.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ikut aku sebentar.
Dialogue: 0,0:09:48.95,0:09:49.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:09:53.90,0:09:55.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}O-Oshio?
Dialogue: 0,0:09:55.72,0:09:58.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah bilang tadi, yang penting,
Dialogue: 0,0:09:58.94,0:10:01.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}orang jadi tahu ini dari toko mana.
Dialogue: 0,0:10:05.97,0:10:07.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cantik sekali.
Dialogue: 0,0:10:08.93,0:10:12.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sebut dirimu tidak berguna.
Dialogue: 0,0:10:12.46,0:10:16.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti ada orang di luar sana\Nyang akan menyukaimu.
Dialogue: 0,0:10:17.88,0:10:20.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin. Pasti banyak.
Dialogue: 0,0:10:24.16,0:10:26.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak butuh banyak orang.
Dialogue: 0,0:10:26.70,0:10:29.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya ingin...
Dialogue: 0,0:10:30.98,0:10:32.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sa-Sabtu depan!
Dialogue: 0,0:10:33.34,0:10:36.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin pergi beli es krim gulung!
Dialogue: 0,0:10:36.00,0:10:39.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kau tidak keberatan,\Nmaukah kau ikut denganku?
Dialogue: 0,0:10:44.18,0:10:46.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, hari itu aku sibuk.
Dialogue: 0,0:10:48.33,0:10:51.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kalau begitu,\Nbagaimana kalau Sabtu depannya lagi?
Dialogue: 0,0:10:51.98,0:10:53.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bisa?
Dialogue: 0,0:10:56.79,0:10:59.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, hari itu juga aku sibuk.
Dialogue: 0,0:11:02.47,0:11:07.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ja-Jangan khawatir!\NKau tidak butuh bantuanku. Kau pasti bisa...
Dialogue: 0,0:11:07.62,0:11:12.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, aku yang minta maaf.\NAku terlalu terburu-buru.
Dialogue: 0,0:11:12.75,0:11:15.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah! Sato!
Dialogue: 0,0:11:16.07,0:11:20.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih untuk hari ini, Oshio.
Dialogue: 0,0:11:27.51,0:11:29.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buat apa aku pergi denganmu?
Dialogue: 0,0:11:29.28,0:11:31.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Uh...
Dialogue: 0,0:11:32.15,0:11:34.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tetap dingin seperti es.
Dialogue: 0,0:11:34.21,0:11:36.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus, yang kemarin itu apa?
Dialogue: 0,0:11:36.90,0:11:39.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Playboy!
Dialogue: 0,0:11:40.39,0:11:42.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa-apaan, Ren?
Dialogue: 0,0:11:42.54,0:11:45.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kemarin? Ceritakan semuanya.
Dialogue: 0,0:11:46.10,0:11:50.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak ada yang perlu diceritakan.
Dialogue: 0,0:11:50.54,0:11:54.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Kau sampai kabur berdua dengannya,\Ntapi tidak ada apa...
Dialogue: 0,0:11:54.30,0:11:56.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak terjadi apa-apa.
Dialogue: 0,0:11:57.77,0:11:58.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:11:59.94,0:12:01.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu.
Dialogue: 0,0:12:01.31,0:12:06.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah itu, aku tidak bicara\Nsepatah kata pun dengan Sato.
Dialogue: 0,0:12:06.44,0:12:09.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, tibalah hari Sabtu.
Dialogue: 0,0:12:14.13,0:12:16.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fiuh... Akhirnya jam sibuk lewat juga.
Dialogue: 0,0:12:18.03,0:12:19.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke!
Dialogue: 0,0:12:22.55,0:12:27.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pasti bisa tanpaku.\NAku tidak bohong waktu bilang begitu.
Dialogue: 0,0:12:35.76,0:12:38.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bohong, tapi...
Dialogue: 0,0:12:44.07,0:12:46.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa aku malah lega?!
Dialogue: 0,0:12:46.66,0:12:50.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ototmu menangis.
Dialogue: 0,0:12:53.73,0:12:54.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:13:04.97,0:13:07.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Unggahan pertamaku...
Dialogue: 0,0:13:08.18,0:13:11.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memang tak berharap bakal banyak yang lihat.
Dialogue: 0,0:13:12.11,0:13:16.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedangkan Oshio, dia luar biasa sekali...
Dialogue: 0,0:13:19.29,0:13:21.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku terus memikirkan Oshio...
Dialogue: 0,0:13:22.85,0:13:24.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Es krimnya harus segera kumakan.
Dialogue: 0,0:13:25.53,0:13:32.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mengorbankan gadis yang kau suka\Ndemi kafe kita.
Dialogue: 0,0:13:32.21,0:13:33.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana Ayah bisa tahu?
Dialogue: 0,0:13:33.28,0:13:35.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelihatan jelas dari wajahmu.
Dialogue: 0,0:13:35.55,0:13:39.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah memperhatikanmu sama telitinya\Nseperti memperhatikan panekuk.
Dialogue: 0,0:13:39.03,0:13:41.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harusnya anakmu lebih diperhatikan\Ndaripada panekuk.
Dialogue: 0,0:13:43.00,0:13:46.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pegawai paruh waktu yang biasanya\Ntidak bisa masuk sif akhir pekan.
Dialogue: 0,0:13:46.42,0:13:48.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku yang harus menggantikannya.
Dialogue: 0,0:13:48.85,0:13:50.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sota...
Dialogue: 0,0:13:51.15,0:13:56.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketika kuliah, Ayah dan tiga pria lain\Nmembentuk Klub Pencinta Hidangan Manis.
Dialogue: 0,0:13:57.36,0:13:59.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Apa hubungannya?
Dialogue: 0,0:13:59.59,0:14:02.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu itu musim panas\Ntahun ketiga Ayah kuliah...
Dialogue: 0,0:14:04.89,0:14:07.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya jawab dulu pertanyaanku\Nsebelum masuk kilas balik!
Dialogue: 0,0:14:14.40,0:14:17.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di tengah musim panas\Nyang gerahnya bukan main,
Dialogue: 0,0:14:18.43,0:14:24.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}seorang ahli otot berjubah hitam\Ndatang ke klub dan meminta bergabung.
Dialogue: 0,0:14:24.83,0:14:26.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ahli otot?!
Dialogue: 0,0:14:27.84,0:14:32.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terpikat kekuatan otot,\Nahli otot itu telah jatuh ke sisi gelap otot,
Dialogue: 0,0:14:32.67,0:14:37.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sementara kami adalah hamba gula dan kalori.\NKami bagai minyak dan air,
Dialogue: 0,0:14:37.14,0:14:40.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kami menjalin ikatan\Nyang dalam lewat panekuk.
Dialogue: 0,0:14:40.94,0:14:43.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini ceritanya mau mengharukan?
Dialogue: 0,0:14:43.73,0:14:48.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi ahli otot licik itu mencampurkan\Nbubuk protein ke adonan panekuk!
Dialogue: 0,0:14:48.25,0:14:49.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teror protein?!
Dialogue: 0,0:14:58.99,0:15:00.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah mengetahui pengkhianatannya,
Dialogue: 0,0:15:01.23,0:15:06.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah bertarung melawan ahli otot itu,\Notot lawan otot,
Dialogue: 0,0:15:09.76,0:15:11.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu, di antara kami berdua,
Dialogue: 0,0:15:11.89,0:15:14.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lahirlah seorang anak laki-laki bernama Sota.
Dialogue: 0,0:15:15.78,0:15:17.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Apa?
Dialogue: 0,0:15:17.98,0:15:21.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, ibuku... si ahli otot itu?
Dialogue: 0,0:15:24.04,0:15:29.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sota, dengar.\NOtot tumbuh dengan cara terluka,
Dialogue: 0,0:15:29.55,0:15:32.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}begitu pula Ayah dan ibumu.
Dialogue: 0,0:15:32.03,0:15:32.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:15:32.80,0:15:35.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketika dua orang bersatu,\Nmereka pasti saling melukai.
Dialogue: 0,0:15:35.73,0:15:41.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sakit dan menyiksa,\Ntapi otot bergembira karena bisa tumbuh.
Dialogue: 0,0:15:41.48,0:15:47.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, ototmu menangis karena\Nkehilangan kesempatan untuk terluka.
Dialogue: 0,0:15:49.63,0:15:54.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Merampas kesempatan untuk terluka\Ndari anakku yang ingin terluka
Dialogue: 0,0:15:54.19,0:15:55.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berarti Ayah gagal sebagai seorang ayah!
Dialogue: 0,0:15:56.32,0:15:58.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami sudah mendengar keluh kesahmu!
Dialogue: 0,0:15:58.82,0:16:01.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wahai keturunan ahli otot!
Dialogue: 0,0:16:01.67,0:16:04.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan sif akhir pekanmu kepada kami!
Dialogue: 0,0:16:04.67,0:16:06.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami adalah Klub Pencinta Hidangan Manis!
Dialogue: 0,0:16:06.99,0:16:10.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, cerita konyol tadi ujungnya ke sini?!
Dialogue: 0,0:16:11.28,0:16:14.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih untuk semuanya selama ini, Sota.
Dialogue: 0,0:16:15.83,0:16:16.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai sekarang,
Dialogue: 0,0:16:18.08,0:16:21.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau boleh melakukan apa\Nyang ingin kau lakukan.
Dialogue: 0,0:16:21.67,0:16:22.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah...
Dialogue: 0,0:16:24.03,0:16:24.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:16:28.13,0:16:31.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang ingin kulakukan...
Dialogue: 0,0:16:34.43,0:16:35.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini enak sekali, 'kan?
Dialogue: 0,0:16:35.52,0:16:38.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya! Manis sekali dan enak!
Dialogue: 0,0:16:41.29,0:16:45.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa? Menurutku, ini tidak terlalu enak.
Dialogue: 0,0:16:46.20,0:16:48.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama sekali tidak manis,
Dialogue: 0,0:16:48.72,0:16:50.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oshio.
Dialogue: 0,0:16:51.97,0:16:55.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada hari itu, aku sangat cemas
Dialogue: 0,0:16:55.78,0:17:00.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sampai merasa seolah aku\Nsendirian di dunia ini.
Dialogue: 0,0:17:01.83,0:17:03.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei...
Dialogue: 0,0:17:05.04,0:17:06.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini, makanlah sedikit.
Dialogue: 0,0:17:06.73,0:17:10.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awalnya, kupikir kau anak yang tidak peka.
Dialogue: 0,0:17:11.80,0:17:15.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira kau sedang mengejekku.
Dialogue: 0,0:17:15.76,0:17:16.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kemudian...
Dialogue: 0,0:17:16.61,0:17:17.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena
Dialogue: 0,0:17:17.74,0:17:20.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}siapa tahu nanti kita jadi teman sekelas.
Dialogue: 0,0:17:22.21,0:17:26.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau membuatku merasa tidak sendirian.
Dialogue: 0,0:17:27.31,0:17:33.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bahkan telah melabuhkan\Nsatu-satunya cinta pertama di hidupku.
Dialogue: 0,0:17:34.13,0:17:36.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hai, Sato. K-Kau...
Dialogue: 0,0:17:37.18,0:17:38.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia anak yang waktu ujian masuk itu!
Dialogue: 0,0:17:38.44,0:17:41.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh iya, aku belum sempat menanyakan namanya.
Dialogue: 0,0:17:41.70,0:17:44.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa dia mau memberitahuku?
Dialogue: 0,0:17:44.17,0:17:45.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya, aku ingin tahu!
Dialogue: 0,0:17:46.51,0:17:48.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa kau?
Dialogue: 0,0:17:48.35,0:17:53.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitulah, saat akhirnya bertemu Oshio lagi,\Naku langsung mengacaukannya.
Dialogue: 0,0:17:55.47,0:17:57.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, setelah itu...
Dialogue: 0,0:18:10.84,0:18:16.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya, setahun penuh berlalu\Ntanpa kami bicara sekali pun.
Dialogue: 0,0:18:17.38,0:18:18.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi meski begitu,
Dialogue: 0,0:18:18.92,0:18:20.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oshio tetap baik hati
Dialogue: 0,0:18:20.98,0:18:22.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan menolongku lagi.
Dialogue: 0,0:18:23.16,0:18:25.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bahkan akhirnya bisa mengobrol dengannya!
Dialogue: 0,0:18:26.28,0:18:27.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah sebabnya
Dialogue: 0,0:18:27.42,0:18:31.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku terlalu terburu-buru sampai\Nakhirnya ditolak olehnya.
Dialogue: 0,0:18:33.19,0:18:36.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin menjadi pengguna aktif Minstagram\Nsupaya punya teman.
Dialogue: 0,0:18:37.52,0:18:39.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bohong waktu bilang begitu.
Dialogue: 0,0:18:39.83,0:18:44.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi sebenarnya aku ingin\Nlebih dekat lagi dengan Oshio.
Dialogue: 0,0:18:45.05,0:18:48.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang suram dan murung ini,\Nkalau saja bisa sedikit bersinar,
Dialogue: 0,0:18:48.63,0:18:51.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin aku bisa lebih dekat dengannya.
Dialogue: 0,0:18:53.74,0:18:58.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, begitu rupanya.\NItu sebabnya rasanya tidak enak.
Dialogue: 0,0:18:58.75,0:19:02.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya aku tidak terlalu\Ningin makan es krim gulung.
Dialogue: 0,0:19:03.24,0:19:07.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya ingin berada\Ndalam satu frame dengan Oshio.
Dialogue: 0,0:19:07.78,0:19:09.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu saja.
Dialogue: 0,0:19:14.44,0:19:15.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oshio...
Dialogue: 0,0:19:16.61,0:19:17.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya?
Dialogue: 0,0:19:21.91,0:19:23.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oshio?
Dialogue: 0,0:19:23.94,0:19:27.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari sudah mulai gelap.\NNanti kau masuk angin.
Dialogue: 0,0:19:29.26,0:19:31.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Bagaimana kau tahu aku di sini...
Dialogue: 0,0:19:33.01,0:19:33.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:19:34.07,0:19:37.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini unggahan yang baru saja kau buat...
Dialogue: 0,0:19:37.04,0:19:40.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sekitar sini,\Ncuma tempat ini yang menjual es krim gulung.
Dialogue: 0,0:19:40.15,0:19:41.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanpa tagar pun, aku tahu kau ada di sini.
Dialogue: 0,0:19:43.03,0:19:44.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah...
Dialogue: 0,0:19:44.20,0:19:45.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benar-benar tidak berguna.
Dialogue: 0,0:19:45.98,0:19:47.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana bisa aku jadi pengguna aktif Minstagram
Dialogue: 0,0:19:47.85,0:19:50.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau fotoku seburuk ini?
Dialogue: 0,0:19:50.00,0:19:51.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, kau memang payah dalam hal ini.
Dialogue: 0,0:19:51.74,0:19:52.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah...
Dialogue: 0,0:19:53.15,0:19:54.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan memotret tegak lurus dari atas.
Dialogue: 0,0:19:54.86,0:19:57.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Logo di gelasnya jadi tidak kelihatan.
Dialogue: 0,0:19:57.24,0:19:58.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Filternya juga aneh.
Dialogue: 0,0:19:59.35,0:20:02.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kau masih jauh lebih baik daripada aku.
Dialogue: 0,0:20:02.79,0:20:03.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:20:04.23,0:20:05.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini apa?
Dialogue: 0,0:20:05.31,0:20:07.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Foto pertama yang kuambil. Panekuk kafe kami.
Dialogue: 0,0:20:08.27,0:20:12.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin sudah seribu foto kuambil\Nsebelum aku membuat unggahan pertama.
Dialogue: 0,0:20:12.03,0:20:13.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seribu?!
Dialogue: 0,0:20:13.00,0:20:16.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya ingin membantu ayahku semampuku.
Dialogue: 0,0:20:16.86,0:20:21.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira kau memang sudah jago dari awal.
Dialogue: 0,0:20:21.96,0:20:24.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja tidak! Mana mungkin!
Dialogue: 0,0:20:24.19,0:20:27.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belajar dan berlatih sekeras mungkin.
Dialogue: 0,0:20:27.69,0:20:29.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu, aku tetap cemas sekali.
Dialogue: 0,0:20:29.87,0:20:30.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:20:31.39,0:20:33.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau dan aku sama-sama sudah mengunggah foto.
Dialogue: 0,0:20:33.98,0:20:36.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu artinya, kita berdua sudah jadi\Npengguna aktif Minstagram.
Dialogue: 0,0:20:38.75,0:20:40.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku...
Dialogue: 0,0:20:41.46,0:20:45.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku benar-benar bisa menjadi\Npengguna aktif Minstagram?
Dialogue: 0,0:20:45.85,0:20:47.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja bisa.
Dialogue: 0,0:20:47.55,0:20:50.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kalau kau mau memberiku\Nkesempatan lagi,
Dialogue: 0,0:20:50.80,0:20:54.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku ingin pergi ke tempat yang fotogenik\Nuntuk Minsta bersamamu.
Dialogue: 0,0:20:54.59,0:20:55.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau?
Dialogue: 0,0:20:58.43,0:21:01.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku payah sekali dalam memotret.
Dialogue: 0,0:21:02.02,0:21:03.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan mengajarimu.
Dialogue: 0,0:21:03.72,0:21:05.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku orangnya membosankan.
Dialogue: 0,0:21:06.30,0:21:08.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga bukan orang yang asyik, kok.
Dialogue: 0,0:21:08.96,0:21:11.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga tidak punya teman.
Dialogue: 0,0:21:12.55,0:21:16.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau masih mau pergi denganku?
Dialogue: 0,0:21:18.94,0:21:22.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin pergi bersamamu.
Dialogue: 0,0:21:23.47,0:21:26.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senyum itu curang.
Dialogue: 0,0:21:27.96,0:21:29.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bodoh.
Dialogue: 0,0:21:29.60,0:21:32.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat bodoh.
Dialogue: 0,0:21:32.87,0:21:38.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jatuh cinta pada cinta pertamaku\Nuntuk kedua kalinya.
Dialogue: 0,0:23:16.72,0:23:19.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Koharu, kau punya pacar?
Dialogue: 0,0:23:20.30,0:23:23.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hmph. Kau? Mana mungkin.
Dialogue: 0,0:23:24.21,0:23:26.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Belum jadian?
Dialogue: 0,0:23:26.90,0:23:27.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berisik!
Dialogue: 0,0:23:28.74,0:23:32.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, pacarmu itu berotot atau tidak?
Dialogue: 0,0:23:35.03,0:23:37.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya, "Berakhirnya Cinta\NBertepuk Sebelah Tangan".
Dialogue: 0,0:23:37.99,0:23:39.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be-Berakhir?
