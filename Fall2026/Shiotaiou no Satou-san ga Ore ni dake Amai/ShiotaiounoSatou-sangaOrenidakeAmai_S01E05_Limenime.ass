Dialogue: 0,0:00:00.95,0:00:04.85,sign,,0000,0000,0000,,STASIUN AOMI
Dialogue: 0,0:02:15.13,0:02:18.50,sign,,0000,0000,0000,,BIDIKAN 5: CINTA BERBALAS DIMULAI
Dialogue: 0,0:04:47.55,0:04:48.80,sign,,0000,0000,0000,,A...
Dialogue: 0,0:04:49.27,0:04:50.30,sign,,0000,0000,0000,,A...
Dialogue: 0,0:07:45.59,0:07:46.69,sign,,0000,0000,0000,,PANGGILAN BERAKHIR
Dialogue: 0,0:08:32.41,0:08:35.49,sign,,0000,0000,0000,,DARI SEMUANYA, NAMA PACAR KOHARU...
Dialogue: 0,0:09:06.31,0:09:07.39,sign,,0000,0000,0000,,OSHIO SOTA - ADA PESAN BARU
Dialogue: 0,0:09:09.60,0:09:11.65,sign,,0000,0000,0000,,"TEMUI AKU BESOK!"
Dialogue: 0,0:09:19.16,0:09:20.65,sign,,0000,0000,0000,,"OSHIO SOTA"\NA...
Dialogue: 0,0:09:27.79,0:09:28.41,sign,,0000,0000,0000,,TEMUI AKU BESOK!
Dialogue: 0,0:13:52.38,0:13:53.44,sign,,0000,0000,0000,,AKU TIDAK MUNGKIN BISA MENANG.
Dialogue: 0,0:18:02.46,0:18:03.51,sign,,0000,0000,0000,,OSHIO SOTA\NPANGGILAN MASUK
Dialogue: 0,0:22:01.90,0:22:05.01,sign,,0000,0000,0000,,BERSAMBUNG
Dialogue: 0,0:23:39.35,0:23:40.40,sign,,0000,0000,0000,,SELANJUTNYA: PANTAI, KUCING, DAN KISAH CINTA
Dialogue: 0,0:00:11.07,0:00:11.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah!
Dialogue: 0,0:00:12.63,0:00:15.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sampai dia menunggu\Ndi cuaca sepanas ini!
Dialogue: 0,0:00:15.58,0:00:16.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh!
Dialogue: 0,0:00:16.10,0:00:17.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Maaf!\N- Aku benar-benar minta maaf!
Dialogue: 0,0:00:17.20,0:00:18.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sa-Sato?
Dialogue: 0,0:00:18.79,0:00:19.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oshio?
Dialogue: 0,0:00:20.07,0:00:23.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa? Masih 30 menit lagi\Nsebelum waktu janjian...
Dialogue: 0,0:00:23.31,0:00:26.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini panas sekali.\NAku tidak mau kau menungguku...
Dialogue: 0,0:00:27.68,0:00:29.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata kami berpikiran sama.
Dialogue: 0,0:00:29.74,0:00:32.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita datang lebih awal,\Ntapi bagaimana kalau langsung berangkat?
Dialogue: 0,0:00:34.95,0:00:36.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Anu...
Dialogue: 0,0:00:36.60,0:00:39.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah mau pergi\Nbersamaku hari ini.
Dialogue: 0,0:00:39.89,0:00:42.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}O-Oh, iya. Sama-sama.
Dialogue: 0,0:00:54.57,0:00:56.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}The Cold Sato-san Is Only Sweet to Me
Dialogue: 0,0:02:18.51,0:02:20.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini pesanan kalian.
Dialogue: 0,0:02:20.18,0:02:22.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakigori hortensia.
Dialogue: 0,0:02:22.13,0:02:23.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh!
Dialogue: 0,0:02:23.81,0:02:26.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}O-Oshio! Oshio! Ini luar biasa!
Dialogue: 0,0:02:26.72,0:02:28.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa ini yang namanya imut dan ajaib?!
Dialogue: 0,0:02:28.81,0:02:31.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pantas saja ini viral di Minsta!
Dialogue: 0,0:02:31.81,0:02:35.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Warnanya berasal dari tanaman herbal\Nyang disebut "bunga telang".
Dialogue: 0,0:02:35.30,0:02:38.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Warnanya berubah kalau disemprot\Nsaus lemon dari botol.
Dialogue: 0,0:02:38.62,0:02:40.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Warnanya berubah?
Dialogue: 0,0:02:40.07,0:02:44.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Bunga telang bereaksi\Ndengan asam lemon.
Dialogue: 0,0:02:44.20,0:02:46.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, menarik sekali.
Dialogue: 0,0:02:48.88,0:02:51.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya pacarmu sudah tidak sabar.
Dialogue: 0,0:02:51.29,0:02:53.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan saya bawakan siropnya.
Dialogue: 0,0:02:55.39,0:02:57.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Y-Ya.
Dialogue: 0,0:02:57.00,0:02:57.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?!
Dialogue: 0,0:02:57.82,0:02:59.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pa-Pacar?!
Dialogue: 0,0:02:59.43,0:03:01.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Barusan dia bilang "pacar"?!
Dialogue: 0,0:03:01.54,0:03:03.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku... juga suka padamu, Oshio.
Dialogue: 0,0:03:04.16,0:03:07.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak... lama sekali.
Dialogue: 0,0:03:10.89,0:03:13.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia... pacarku, 'kan?
Dialogue: 0,0:03:13.59,0:03:14.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:03:14.39,0:03:16.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}O-Oh, bukan apa-apa, anu...
Dialogue: 0,0:03:16.34,0:03:19.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sato, kalau tidak cepat,\Nesnya keburu mencair.
Dialogue: 0,0:03:19.26,0:03:19.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh!
Dialogue: 0,0:03:19.97,0:03:22.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be-Benar. Kau benar.
Dialogue: 0,0:03:23.55,0:03:24.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:03:24.86,0:03:25.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat makan...
Dialogue: 0,0:03:25.90,0:03:26.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah! Tunggu, Sato!
Dialogue: 0,0:03:31.03,0:03:33.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fiuh. Hampir saja.
Dialogue: 0,0:03:33.34,0:03:36.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau belum memotretnya. Untuk Minsta.
Dialogue: 0,0:03:36.70,0:03:37.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:03:38.84,0:03:40.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sato?
Dialogue: 0,0:03:40.92,0:03:41.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tangan...
Dialogue: 0,0:03:41.83,0:03:42.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:03:43.17,0:03:44.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanganmu...
Dialogue: 0,0:03:46.90,0:03:48.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah!
Dialogue: 0,0:03:48.92,0:03:49.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ahh!
Dialogue: 0,0:03:49.50,0:03:50.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maaf!
Dialogue: 0,0:03:50.50,0:03:54.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-A-Aku akan menyemprotkan lemonnya!\NSeperti ke ayam goreng! Seru!
Dialogue: 0,0:03:54.26,0:03:56.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku akan merekam videonya!
Dialogue: 0,0:03:56.88,0:03:59.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Re-Rekam yang bagus, Oshio!
Dialogue: 0,0:03:59.30,0:04:01.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Se-Semprot sekarang!
Dialogue: 0,0:04:04.12,0:04:05.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh!
Dialogue: 0,0:04:05.99,0:04:07.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luar biasa!
Dialogue: 0,0:04:07.02,0:04:08.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}O-Oh, ya!
Dialogue: 0,0:04:13.65,0:04:14.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah!
Dialogue: 0,0:04:17.49,0:04:19.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Se-Selamat!
Dialogue: 0,0:04:19.10,0:04:20.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah.
Dialogue: 0,0:04:21.02,0:04:23.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, apa aku kelihatan\Nseperti mau menyuapinya?
Dialogue: 0,0:04:23.87,0:04:27.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku harus menarik sendoknya?\NAtau kumakan sendiri?
Dialogue: 0,0:04:27.17,0:04:28.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau pakai gaya pesawat?
Dialogue: 0,0:04:28.26,0:04:29.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, itu menyeramkan sekali!
Dialogue: 0,0:04:29.50,0:04:31.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan ragu! Waktumu tidak banyak!
Dialogue: 0,0:04:31.06,0:04:33.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo! Lakukan! Tidak ada pilihan lain!
Dialogue: 0,0:04:33.83,0:04:37.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sa-Sato, bu-buka mulutmu.
Dialogue: 0,0:04:37.28,0:04:39.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhasil!
Dialogue: 0,0:04:39.42,0:04:41.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aaa...
Dialogue: 0,0:04:41.91,0:04:42.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:04:50.70,0:04:53.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asam, Oshio!
Dialogue: 0,0:04:54.10,0:04:55.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah menunggu.
Dialogue: 0,0:04:55.92,0:04:59.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan tambahkan sirop ini\Natau susu kental manis sebelum dimakan.
Dialogue: 0,0:05:00.60,0:05:01.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, itu sebabnya...
Dialogue: 0,0:05:01.39,0:05:03.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya asam sekali.
Dialogue: 0,0:05:08.99,0:05:09.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu?
Dialogue: 0,0:05:09.95,0:05:12.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke-Kenapa reaksimu begitu?
Dialogue: 0,0:05:12.58,0:05:15.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tanya,\Napa yang kalian lakukan setelah itu.
Dialogue: 0,0:05:15.26,0:05:20.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang, kami naik kereta\Nke Stasiun Sakuraba, lalu pulang.
Dialogue: 0,0:05:20.79,0:05:22.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma itu?!
Dialogue: 0,0:05:22.19,0:05:24.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar berakhir begitu saja?!
Dialogue: 0,0:05:25.03,0:05:27.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bohong, 'kan?\NSebenarnya ada yang terjadi, 'kan?!
Dialogue: 0,0:05:27.71,0:05:32.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku janji akan merahasiakannya!\NCeritakan! Aku tidak akan marah!
Dialogue: 0,0:05:32.77,0:05:36.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, wah! Panekuk di sini\Nmemang selalu enak, Mayo!
Dialogue: 0,0:05:36.97,0:05:40.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, benar, Shizuku. Enak sekali!
Dialogue: 0,0:05:40.82,0:05:43.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh, kami cuma pergi makan kakigori!
Dialogue: 0,0:05:43.57,0:05:46.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, tidak, tidak.\NItu sama sekali tidak masuk akal.
Dialogue: 0,0:05:46.43,0:05:49.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buat apa aku bohong padamu?
Dialogue: 0,0:05:49.25,0:05:50.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau tahu pendapatku?
Dialogue: 0,0:05:50.78,0:05:52.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak, diam.
Dialogue: 0,0:05:52.30,0:05:55.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?! Aku juga mau kasih nasihat\Nsoal asmara!
Dialogue: 0,0:05:55.45,0:05:56.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh?
Dialogue: 0,0:05:56.44,0:06:00.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shizuku, kau sudah lupa\Napa yang kau lakukan terakhir kali?
Dialogue: 0,0:06:00.95,0:06:04.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benar-benar minta maaf atas perbuatanku.
Dialogue: 0,0:06:05.08,0:06:07.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, Sota!
Dialogue: 0,0:06:07.08,0:06:10.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau harus sadar kalau kau sudah mengacau!
Dialogue: 0,0:06:10.86,0:06:13.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Me-Mengacau? Kenapa?
Dialogue: 0,0:06:13.08,0:06:16.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau pulang?! Lanjutkan kencannya!
Dialogue: 0,0:06:16.94,0:06:21.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak harus ciuman di kencan pertama,\Ntapi setidaknya gandengan tangan!
Dialogue: 0,0:06:21.51,0:06:23.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak bisa!
Dialogue: 0,0:06:23.24,0:06:26.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sato manis sekali, sampai aku bahkan\Ntidak sanggup menatap matanya!
Dialogue: 0,0:06:26.70,0:06:30.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah! Dia malah balik pamer!
Dialogue: 0,0:06:30.41,0:06:32.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan itu intinya!
Dialogue: 0,0:06:32.32,0:06:34.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini usaha terbaikku untuk sekarang!
Dialogue: 0,0:06:34.74,0:06:35.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?!
Dialogue: 0,0:06:35.64,0:06:38.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Persis seperti cinta pertama.
Dialogue: 0,0:06:39.02,0:06:41.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kau, bagaimana?
Dialogue: 0,0:06:41.15,0:06:43.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cinta... pertamamu?
Dialogue: 0,0:06:44.37,0:06:47.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entahlah. Cinta pertamaku sudah\Nlama sekali, aku sudah lupa.
Dialogue: 0,0:06:47.97,0:06:52.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama ini, aku belum pernah pacaran,
Dialogue: 0,0:06:52.09,0:06:54.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi aku tidak tahu apa artinya pacaran.
Dialogue: 0,0:06:54.70,0:06:56.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi tetap saja...
Dialogue: 0,0:06:56.53,0:07:00.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau kelihatan bodoh di depan Sato.
Dialogue: 0,0:07:00.08,0:07:01.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:07:01.91,0:07:04.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bagaimana kalau kau minta bantuan Rinka?
Dialogue: 0,0:07:04.58,0:07:06.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Ri-Rinka?
Dialogue: 0,0:07:07.23,0:07:10.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, aku sudah boleh berdiri?
Dialogue: 0,0:07:12.10,0:07:14.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, putus saja dengannya.
Dialogue: 0,0:07:14.42,0:07:15.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Ta-Tapi...
Dialogue: 0,0:07:15.74,0:07:18.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jujur, Sako, aku tidak tahu apa maunya dia,
Dialogue: 0,0:07:18.52,0:07:21.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan kurasa kau juga tidak tahu.
Dialogue: 0,0:07:21.30,0:07:24.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa tidak lupakan saja dia\Ndan lakukan apa yang kau mau?
Dialogue: 0,0:07:24.36,0:07:25.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin, saat kau memikirkannya,
Dialogue: 0,0:07:25.88,0:07:29.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa yang ingin kau lakukan\Nitulah jawaban yang tepat.
Dialogue: 0,0:07:29.49,0:07:31.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bisa bicarakan lagi setelah itu.
Dialogue: 0,0:07:31.34,0:07:33.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rin, kau dewasa sekali!
Dialogue: 0,0:07:33.24,0:07:35.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sangat membantu! Makasih!
Dialogue: 0,0:07:35.46,0:07:37.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Sampai jumpa di sekolah.
Dialogue: 0,0:07:39.26,0:07:41.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku selalu saja mengurusi\Nmasalah orang lain...
Dialogue: 0,0:07:41.93,0:07:44.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma mengatakan\Nhal yang terdengar bagus,
Dialogue: 0,0:07:44.46,0:07:45.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi tidak menyelesaikan apa pun.
Dialogue: 0,0:07:47.18,0:07:48.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:07:50.96,0:07:53.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktunya nonton episode berikutnya!
Dialogue: 0,0:07:54.46,0:08:00.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak hari kau menyelamatkanku,\Nkau selalu ada di pikiranku.
Dialogue: 0,0:08:00.37,0:08:02.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau istimewa bagiku.
Dialogue: 0,0:08:02.46,0:08:07.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ahh! Jantungku berdebar!\NAku juga mau kisah cinta seperti ini!
Dialogue: 0,0:08:07.74,0:08:13.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, aku kasih nasihat soal asmara\Npadahal belum pernah pacaran...
Dialogue: 0,0:08:13.43,0:08:16.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah! Kak Oshio!
Dialogue: 0,0:08:16.24,0:08:17.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku senang sekali.
Dialogue: 0,0:08:18.42,0:08:19.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tunggu...\N- Aku juga suka padamu.
Dialogue: 0,0:08:19.48,0:08:21.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tidak, tidak, tidak!\N- Aku juga suka padamu.
Dialogue: 0,0:08:21.00,0:08:23.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tidak, tidak, tidak, tidak, tidak!\N- Akhirnya aku tahu
Dialogue: 0,0:08:23.98,0:08:26.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bagaimana perasaanku padamu.
Dialogue: 0,0:08:27.74,0:08:29.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, tidak, tidak, tidak, tidak!
Dialogue: 0,0:08:29.90,0:08:32.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang barusan kupikirkan?!
Dialogue: 0,0:08:35.89,0:08:38.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak! Tidak!
Dialogue: 0,0:08:38.02,0:08:41.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kisah cinta luar biasa cuma ada di cerita!
Dialogue: 0,0:08:44.19,0:08:46.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, jangan-jangan...
Dialogue: 0,0:08:47.25,0:08:51.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rinka! Maaf kirim pesan malam-malam!\NBoleh aku minta nasihat soal asmara?
Dialogue: 0,0:08:54.13,0:08:55.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan ini?
Dialogue: 0,0:08:55.44,0:08:59.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa aku harus mendengar Koharu\Npamer soal pacarnya?
Dialogue: 0,0:08:59.54,0:09:02.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Besok akan langsung kugoda dia.
Dialogue: 0,0:09:02.02,0:09:03.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mencintaimu sepenuh hati.
Dialogue: 0,0:09:03.74,0:09:05.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh! Mereka akhirnya menyatakan perasaan!
Dialogue: 0,0:09:09.60,0:09:11.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu saja harusnya cukup.
Dialogue: 0,0:09:12.57,0:09:13.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:09:13.65,0:09:17.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf mengirim pesan malam-malam.\NAda yang mau kutanyakan.
Dialogue: 0,0:09:17.51,0:09:19.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh kutelepon sekarang?
Dialogue: 0,0:09:20.65,0:09:24.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Argh!
Dialogue: 0,0:09:28.42,0:09:29.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:09:31.23,0:09:32.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebentar!
Dialogue: 0,0:09:33.12,0:09:36.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, anu, mungkin sudah telat\Nbertanya karena aku sudah di sini,
Dialogue: 0,0:09:36.38,0:09:38.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi benar tidak apa-apa aku di sini?
Dialogue: 0,0:09:38.40,0:09:40.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Su-Sungguh tidak apa-apa!
Dialogue: 0,0:09:40.72,0:09:42.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kebetulan aku sedang senggang.
Dialogue: 0,0:09:42.28,0:09:43.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu.
Dialogue: 0,0:09:44.03,0:09:48.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi laki-laki masuk\Nke kamar perempuan itu agak...
Dialogue: 0,0:09:48.43,0:09:49.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh?
Dialogue: 0,0:09:49.77,0:09:53.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Oshio, kau tipe orang\Nyang memikirkan hal begitu?
Dialogue: 0,0:09:53.06,0:09:55.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak keberatan sama sekali.
Dialogue: 0,0:09:55.79,0:09:58.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baiklah. Kalau begitu, permisi.
Dialogue: 0,0:10:06.17,0:10:08.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, ini luar biasa.
Dialogue: 0,0:10:08.24,0:10:08.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya?
Dialogue: 0,0:10:08.91,0:10:10.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa dia mendengarnya?!
Dialogue: 0,0:10:10.73,0:10:13.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hampir tidak pernah\Nmembaca komik romantis sebelumnya,
Dialogue: 0,0:10:13.74,0:10:15.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi ini bagus sekali.
Dialogue: 0,0:10:15.86,0:10:18.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa anak perempuan sudah membaca ini\Nsejak kecil?
Dialogue: 0,0:10:18.70,0:10:20.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Y-Ya, benar.
Dialogue: 0,0:10:20.73,0:10:25.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah... Pantas saja perempuan\Njauh lebih dewasa daripada laki-laki!
Dialogue: 0,0:10:27.10,0:10:31.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kenapa tiba-tiba\Nkau mau membaca komik romantis?
Dialogue: 0,0:10:31.94,0:10:32.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, sebenarnya,
Dialogue: 0,0:10:33.12,0:10:36.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku mulai pacaran dengan Sato.
Dialogue: 0,0:10:38.50,0:10:42.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana pacarannya?\NKoharu memang agak lamban.
Dialogue: 0,0:10:42.99,0:10:47.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Argh... Sedih sekali\Naku menanyakan ini.
Dialogue: 0,0:10:47.19,0:10:50.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, menurutku justru dia\Nterlalu baik untukku.
Dialogue: 0,0:10:50.10,0:10:52.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, ada kemajuan?
Dialogue: 0,0:10:52.69,0:10:55.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu... belum ada apa-apa sejauh ini.
Dialogue: 0,0:10:56.15,0:10:59.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Kak Oshio, kau\Nsudah menyatakan perasaan ke Koharu?
Dialogue: 0,0:10:59.48,0:11:00.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah.
Dialogue: 0,0:11:00.73,0:11:02.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, diterima?
Dialogue: 0,0:11:02.92,0:11:03.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:11:03.70,0:11:06.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian sudah pacaran,\Ntapi belum terjadi apa-apa?
Dialogue: 0,0:11:06.22,0:11:07.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami bahkan belum bergandengan tangan.
Dialogue: 0,0:11:07.62,0:11:08.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?!
Dialogue: 0,0:11:09.23,0:11:10.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu, anu...
Dialogue: 0,0:11:10.61,0:11:14.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benar-benar malu\Nmenceritakan ini padamu, Rinka...
Dialogue: 0,0:11:15.03,0:11:18.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Oshio menggemaskan sekali\Nkalau sedang malu!
Dialogue: 0,0:11:18.22,0:11:19.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, fokus!
Dialogue: 0,0:11:19.60,0:11:20.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:11:20.67,0:11:25.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku datang untuk belajar\Napa artinya pacaran. Lewat komik.
Dialogue: 0,0:11:25.68,0:11:27.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Argh! Dia menggemaskan sekali!
Dialogue: 0,0:11:27.43,0:11:29.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, soal ini...
Dialogue: 0,0:11:29.50,0:11:32.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa orang benar-benar\Nmemojokkan ke dinding begini di dunia nyata?
Dialogue: 0,0:11:32.43,0:11:36.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin. Kalau ada yang melakukannya,\Npasti langsung ditolak.
Dialogue: 0,0:11:36.04,0:11:36.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu norak.
Dialogue: 0,0:11:36.94,0:11:40.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh. Kak Oshio,\Njangan sampai kau melakukannya.
Dialogue: 0,0:11:40.70,0:11:42.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Koharu bisa kena serangan jantung.
Dialogue: 0,0:11:43.96,0:11:45.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jantungku juga mungkin tidak akan kuat.
Dialogue: 0,0:11:49.22,0:11:52.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa teman masa kecil ini akhirnya pacaran?
Dialogue: 0,0:11:52.01,0:11:53.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, tidak pernah.
Dialogue: 0,0:11:53.51,0:11:56.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?! Lalu bagaimana\Ndengan kenangan masa kecil mereka?!
Dialogue: 0,0:11:56.70,0:11:59.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang pacaran bukan karena kenangan!
Dialogue: 0,0:11:59.08,0:12:01.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perempuan itu realistis!
Dialogue: 0,0:12:01.66,0:12:03.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Benarkah?
Dialogue: 0,0:12:03.67,0:12:08.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Andai momen ini\Nbisa berlangsung selamanya...
Dialogue: 0,0:12:09.14,0:12:10.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Rinka.
Dialogue: 0,0:12:10.97,0:12:13.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? U-Untuk apa?
Dialogue: 0,0:12:13.29,0:12:16.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mendengar pendapatmu benar-benar membantu.
Dialogue: 0,0:12:16.01,0:12:20.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meskipun aku tidak bisa sekeren\Ncowok di komik.
Dialogue: 0,0:12:20.44,0:12:22.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Oshio,
Dialogue: 0,0:12:22.10,0:12:25.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ka-kau sudah keren, kok.
Dialogue: 0,0:12:27.37,0:12:29.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makasih! Kau pengertian sekali.
Dialogue: 0,0:12:29.51,0:12:31.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau baik sekali.
Dialogue: 0,0:12:32.88,0:12:37.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Intinya, dia cuma menganggapku\Nsepupu yang masih SMP.
Dialogue: 0,0:12:37.88,0:12:41.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Oshio, apa yang membuatmu\Ntertarik pada Koharu?
Dialogue: 0,0:12:41.34,0:12:42.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:12:42.31,0:12:46.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Koharu memang manis,\Ntapi banyak gadis manis lain.
Dialogue: 0,0:12:46.91,0:12:50.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia lamban dan tidak peka,\Njuga gampang panik. Dia norak.
Dialogue: 0,0:12:51.56,0:12:54.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau merasa harus melindunginya?
Dialogue: 0,0:12:54.42,0:12:56.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau karena dia kebetulan ada di dekatmu?
Dialogue: 0,0:12:58.21,0:12:59.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jawab aku.
Dialogue: 0,0:13:00.17,0:13:01.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm...
Dialogue: 0,0:13:02.16,0:13:07.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin aku melakukan banyak hal sekarang\Nkarena aku sendiri ingin mencari tahu.
Dialogue: 0,0:13:11.36,0:13:12.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:13:13.61,0:13:17.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Oshio, aku akan memberimu\Nsatu nasihat terakhir.
Dialogue: 0,0:13:17.10,0:13:19.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong lupakan\Nsemua yang kau lihat hari ini.
Dialogue: 0,0:13:19.45,0:13:21.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Apa maksudmu...
Dialogue: 0,0:13:21.40,0:13:22.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya akan lebih baik untukmu
Dialogue: 0,0:13:22.46,0:13:25.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau kau tidak berusaha menjadi orang lain.
Dialogue: 0,0:13:25.43,0:13:27.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jamin.
Dialogue: 0,0:13:27.91,0:13:31.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan betapa seriusnya\Nkau memikirkan Koharu,
Dialogue: 0,0:13:31.00,0:13:32.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}meski menempuh jalan panjang dan berliku,
Dialogue: 0,0:13:32.51,0:13:34.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pada akhirnya kau akan sampai\Npada jawaban yang tepat.
Dialogue: 0,0:13:35.23,0:13:37.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kau sudah begitu dan tetap gagal,
Dialogue: 0,0:13:37.84,0:13:40.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku sendiri yang akan bertanggung jawab!
Dialogue: 0,0:13:40.12,0:13:42.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Tanggung jawab apa?
Dialogue: 0,0:13:42.12,0:13:46.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh? Kau sedang membayangkan apa?
Dialogue: 0,0:13:46.21,0:13:49.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudku, kalau dia mencampakkanmu,\Nkita adakan pesta patah hati.
Dialogue: 0,0:13:53.45,0:13:56.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saatnya mengakhiri kisah cinta\Nyang bahkan tidak pernah dimulai ini.
Dialogue: 0,0:13:57.27,0:13:59.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau boleh datang membaca lagi kapan saja.
Dialogue: 0,0:13:59.51,0:14:00.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:14:01.18,0:14:04.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah! Kakiku kesemutan!
Dialogue: 0,0:14:11.75,0:14:13.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maaf!
Dialogue: 0,0:14:14.48,0:14:16.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak apa-apa.
Dialogue: 0,0:14:18.24,0:14:19.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:14:19.44,0:14:21.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, anu, aku pulang dulu.
Dialogue: 0,0:14:22.43,0:14:25.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Te-Terima kasih sudah datang...
Dialogue: 0,0:14:33.52,0:14:34.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku sudah siap!
Dialogue: 0,0:14:34.96,0:14:36.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktunya pas sekali!
Dialogue: 0,0:14:36.20,0:14:38.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah siap merelakannya!
Dialogue: 0,0:14:38.69,0:14:39.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah memutuskan!
Dialogue: 0,0:14:39.70,0:14:42.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan membantu saingan lagi!
Dialogue: 0,0:14:42.23,0:14:43.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan pernah menyerah!
Dialogue: 0,0:14:44.63,0:14:48.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oshio Sota! Suatu hari nanti\Naku akan membuatmu menoleh padaku!
Dialogue: 0,0:14:50.14,0:14:50.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hore!
Dialogue: 0,0:14:50.93,0:14:52.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Liburan musim panas!
Dialogue: 0,0:14:52.07,0:14:53.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau ngapain?
Dialogue: 0,0:14:54.15,0:14:55.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Sota.
Dialogue: 0,0:14:55.36,0:14:57.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah memutuskan mau pergi ke mana\Nsaat liburan musim panas?
Dialogue: 0,0:14:57.57,0:14:58.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Untuk apa?
Dialogue: 0,0:14:58.82,0:15:01.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tahu. Kencan. Kencan kedua kalian.
Dialogue: 0,0:15:01.98,0:15:04.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, tidak, kami belum...
Dialogue: 0,0:15:04.44,0:15:07.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, ayolah. Ini liburan musim panas.
Dialogue: 0,0:15:07.04,0:15:09.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau harus membuat setidaknya 10\Natau 20 rencana kencan penuh kenangan
Dialogue: 0,0:15:09.73,0:15:11.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk pacarmu.
Dialogue: 0,0:15:11.70,0:15:13.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baiklah...
Dialogue: 0,0:15:13.27,0:15:16.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu, tapi di mana\Nkami bisa membuat kenangan?
Dialogue: 0,0:15:16.70,0:15:18.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sota!
Dialogue: 0,0:15:19.16,0:15:21.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pergilah ke pantai!
Dialogue: 0,0:15:21.53,0:15:23.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa ini?
Dialogue: 0,0:15:23.42,0:15:26.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau ingat Nenek Kanami?
Dialogue: 0,0:15:26.45,0:15:29.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu, yang mengelola penginapan\Ndi Midorikawa.
Dialogue: 0,0:15:29.70,0:15:31.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, aku ingat dia!
Dialogue: 0,0:15:31.54,0:15:34.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dulu kita sering mengunjunginya\Nwaktu aku masih kecil.
Dialogue: 0,0:15:34.42,0:15:38.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini, dia berencana menutup\Npenginapannya sebentar lagi.
Dialogue: 0,0:15:38.64,0:15:42.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia ingin bertemu lagi denganmu\Nsebelum hari itu tiba.
Dialogue: 0,0:15:46.23,0:15:48.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ide bagus. Pantai.
Dialogue: 0,0:15:49.21,0:15:51.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Ibu...
Dialogue: 0,0:15:51.99,0:15:54.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh aku minta nasihat soal asmara?
Dialogue: 0,0:15:54.27,0:15:55.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:15:55.18,0:15:56.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?!
Dialogue: 0,0:15:56.57,0:16:00.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertanyaanmu pasti merepotkan.\NTanya teman-temanmu saja.
Dialogue: 0,0:16:00.85,0:16:03.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin tanya Rinka,
Dialogue: 0,0:16:03.81,0:16:06.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi sepertinya dia marah entah kenapa.
Dialogue: 0,0:16:07.31,0:16:09.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rinka sudah benar.\NDia paham.
Dialogue: 0,0:16:12.16,0:16:17.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayolah! Aku ingin\Nminta nasihat soal asmara!
Dialogue: 0,0:16:17.92,0:16:20.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ugh, baiklah! Ibu dengarkan!\NBerhenti merengek!
Dialogue: 0,0:16:20.75,0:16:23.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:16:23.30,0:16:25.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Singkat saja. Garis besarnya saja.
Dialogue: 0,0:16:25.51,0:16:27.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Anu...
Dialogue: 0,0:16:27.41,0:16:30.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku pacaran dengan anak laki-laki\Nyang kusukai,
Dialogue: 0,0:16:30.38,0:16:32.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku tidak tahu apa artinya pacaran!
Dialogue: 0,0:16:33.38,0:16:35.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ajak saja dia ke ranjang.
Dialogue: 0,0:16:35.27,0:16:36.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ra-Ranjang...
Dialogue: 0,0:16:36.86,0:16:38.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-A-Aku tidak bisa melakukan itu!
Dialogue: 0,0:16:38.58,0:16:43.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Intinya, pacaran itu mencari tahu\Nsejauh mana kalian bisa saling menerima.
Dialogue: 0,0:16:43.34,0:16:46.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua tergantung padamu.\NSemua soal perasaan.
Dialogue: 0,0:16:46.88,0:16:51.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kau mengikuti perasaanmu,\Nsemuanya akan berjalan sebagaimana mestinya.
Dialogue: 0,0:16:51.65,0:16:53.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ta-Tapi...
Dialogue: 0,0:16:54.90,0:16:57.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jujur saja. Ini... Oshio, 'kan?
Dialogue: 0,0:16:57.18,0:16:58.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau ingin mengajaknya ke ranjang, 'kan?
Dialogue: 0,0:16:59.04,0:17:00.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ranjang...
Dialogue: 0,0:17:00.91,0:17:02.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak! Tidak bisa!
Dialogue: 0,0:17:03.63,0:17:07.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aneh sekali.\NIbu tidak begini waktu muda dulu.
Dialogue: 0,0:17:07.79,0:17:11.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, waktu Ibu masih 17 tahun,
Dialogue: 0,0:17:11.41,0:17:14.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu tidak bisa menerima masyarakat\Ndan memilih jalan sendiri.
Dialogue: 0,0:17:14.32,0:17:16.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu jatuh cinta\Npada pandangan pertama dengan Papa
Dialogue: 0,0:17:16.15,0:17:17.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang bernyanyi penuh semangat di panggung
Dialogue: 0,0:17:17.92,0:17:19.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pada festival budaya kampus.
Dialogue: 0,0:17:19.92,0:17:22.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, setelah konser,\Nkami langsung pergi ke hotel, dan...
Dialogue: 0,0:17:22.72,0:17:24.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tu-Tu-Tu-Tunggu, Ibu?!
Dialogue: 0,0:17:24.59,0:17:27.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Ibu pikir itu bisa membantu.
Dialogue: 0,0:17:27.22,0:17:28.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak!
Dialogue: 0,0:17:28.09,0:17:29.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dan Oshio tidak akan pergi ke hotel...
Dialogue: 0,0:17:29.67,0:17:30.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami tidak melakukannya.
Dialogue: 0,0:17:31.11,0:17:32.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah?
Dialogue: 0,0:17:32.86,0:17:34.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, kau di situ?
Dialogue: 0,0:17:34.97,0:17:37.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah dan ibumu baru pergi ke hotel
Dialogue: 0,0:17:37.66,0:17:41.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}setelah cukup lama pacaran dan sudah dewasa.
Dialogue: 0,0:17:41.43,0:17:43.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh? Benarkah?
Dialogue: 0,0:17:43.12,0:17:47.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setiap orang punya kecepatan sendiri.\NKau punya caramu sendiri, Koharu.
Dialogue: 0,0:17:48.60,0:17:50.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah...
Dialogue: 0,0:17:51.51,0:17:55.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau mendengar kata "hotel"\Nkeluar dari mulut Ayah.
Dialogue: 0,0:17:55.13,0:17:56.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agak menjijikkan.
Dialogue: 0,0:17:56.89,0:17:57.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu.
Dialogue: 0,0:18:00.47,0:18:02.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, maaf. Ponselmu.
Dialogue: 0,0:18:03.51,0:18:05.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}O-Oshio?!
Dialogue: 0,0:18:05.33,0:18:07.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-A-A-A-Aku harus bagaimana?!
Dialogue: 0,0:18:07.74,0:18:10.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa harus tanya?!\NAngkat sekarang juga!
Dialogue: 0,0:18:10.66,0:18:11.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tapi hatiku belum siap...\N- Sekarang!
Dialogue: 0,0:18:11.99,0:18:15.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimanapun, menurut Ayah,\Ntidak sopan membuatnya menunggu.
Dialogue: 0,0:18:17.65,0:18:19.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}H-Halo?!
Dialogue: 0,0:18:19.10,0:18:21.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah! Suaraku pecah...
Dialogue: 0,0:18:21.36,0:18:23.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Sato? Ini kau?
Dialogue: 0,0:18:23.61,0:18:26.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Ini Sato! Sato Koharu!
Dialogue: 0,0:18:26.61,0:18:28.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf meneleponmu malam-malam begini.
Dialogue: 0,0:18:28.90,0:18:30.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bisa bicara sekarang?
Dialogue: 0,0:18:30.36,0:18:33.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Y-Ya! Aku tidak ada acara apa-apa!
Dialogue: 0,0:18:33.25,0:18:34.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ajak dia ke ranjang!
Dialogue: 0,0:18:35.70,0:18:37.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?! Apa?! Ada apa?!
Dialogue: 0,0:18:37.04,0:18:38.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maaf, ra...
Dialogue: 0,0:18:38.54,0:18:39.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bukan, maksudku, Oshio!
Dialogue: 0,0:18:39.97,0:18:41.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:18:41.62,0:18:43.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya.
Dialogue: 0,0:18:43.25,0:18:46.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau pergi ke pantai bersama\Nakhir pekan depan?
Dialogue: 0,0:18:48.63,0:18:49.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pantai?!
Dialogue: 0,0:18:49.75,0:18:51.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya! Aku mau!
Dialogue: 0,0:18:51.80,0:18:53.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah? Bagus!
Dialogue: 0,0:18:53.39,0:18:54.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak sabar!
Dialogue: 0,0:18:54.98,0:18:59.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami sudah memesan kamar, jadi tidak perlu\Nmemikirkan tempat menaruh barang.
Dialogue: 0,0:18:59.91,0:19:03.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami sudah memesan kamar...
Dialogue: 0,0:19:03.14,0:19:09.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamar...
Dialogue: 0,0:19:09.31,0:19:10.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu...
Dialogue: 0,0:19:10.14,0:19:10.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm?
Dialogue: 0,0:19:11.19,0:19:15.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini... pertama... kalinya bagiku...
Dialogue: 0,0:19:15.19,0:19:18.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja. Kak Mayo bilang\Ndia juga sudah lama tidak ke pantai.
Dialogue: 0,0:19:20.63,0:19:22.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Ka-Ka-Kak Mayo?!
Dialogue: 0,0:19:23.05,0:19:24.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dan kau...
Dialogue: 0,0:19:24.64,0:19:26.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu, Ren dan Rinka...
Dialogue: 0,0:19:26.24,0:19:27.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}juga Kak Shizuku akan ikut.
Dialogue: 0,0:19:27.82,0:19:30.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}E-Enam orang?!
Dialogue: 0,0:19:30.70,0:19:34.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-I-I-Ini benar-benar\Npe-pe-pe-pengalaman pertamaku...
Dialogue: 0,0:19:34.12,0:19:38.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, Rinka bilang dia sudah terbiasa,\Njadi dia bisa mengajarimu.
Dialogue: 0,0:19:38.94,0:19:42.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?! Rinka sudah terbiasa?!
Dialogue: 0,0:19:42.46,0:19:47.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini cuma pantai. Tetap bisa\Nbersenang-senang meski tidak bisa berenang.
Dialogue: 0,0:19:47.98,0:19:48.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:19:49.22,0:19:53.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Kupikir ini pertama kalinya kau\Nke pantai, jadi kau tidak bisa berenang.
Dialogue: 0,0:19:53.72,0:19:54.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku salah?
Dialogue: 0,0:19:54.59,0:19:57.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? O-Oh, begitu...
Dialogue: 0,0:19:57.23,0:19:59.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, soal memesan kamar tadi?
Dialogue: 0,0:19:59.45,0:20:03.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, itu penginapan yang dikelola\Nsalah satu kerabatku.
Dialogue: 0,0:20:03.05,0:20:04.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayahku yang menyarankan kita ke sana.
Dialogue: 0,0:20:05.26,0:20:07.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh. Kalau begitu, bagus.
Dialogue: 0,0:20:07.80,0:20:09.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti kukirimkan detailnya.
Dialogue: 0,0:20:09.78,0:20:11.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, selamat malam!
Dialogue: 0,0:20:11.79,0:20:13.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat malam.
Dialogue: 0,0:20:13.99,0:20:16.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak! Aku mau mati!\NAku mau mati saja sekarang!
Dialogue: 0,0:20:16.64,0:20:18.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ini kenapa?! Aku ini kenapa?!
Dialogue: 0,0:20:18.74,0:20:20.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa! Aku tidak sanggup hidup!
Dialogue: 0,0:20:20.64,0:20:22.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa!
Dialogue: 0,0:20:23.50,0:20:26.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Urgh! Aku gugup sekali...
Dialogue: 0,0:20:26.67,0:20:32.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sota, kenapa pacarmu\Nkau ajak paling terakhir?
Dialogue: 0,0:20:32.17,0:20:35.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus menyiapkan mental\Nuntuk mengajaknya ke pantai!
Dialogue: 0,0:20:35.18,0:20:39.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, bisa saja\Nkalian cuma pergi berdua.
Dialogue: 0,0:20:39.06,0:20:40.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah benar sekali...
Dialogue: 0,0:20:40.68,0:20:43.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, menurutmu\Nkau bisa selamat di pantai?
Dialogue: 0,0:20:43.61,0:20:44.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:20:44.26,0:20:46.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pakaian renang. Kalian akan memakainya.
Dialogue: 0,0:20:46.66,0:20:50.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja. Ini pantai.\NSemua orang pasti pakai...
Dialogue: 0,0:20:51.44,0:20:53.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah! Pakaian renang!
Dialogue: 0,0:20:53.95,0:20:55.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pakaian... renang?
Dialogue: 0,0:20:55.39,0:20:56.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, pakaian renang.
Dialogue: 0,0:20:56.39,0:20:58.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau butuh itu untuk perjalanan ke pantai.
Dialogue: 0,0:20:58.49,0:21:01.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu! Bantu aku\Npilih pakaian renang yang lucu!
Dialogue: 0,0:21:01.63,0:21:04.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak! Aku tidak mau membantumu soal itu.
Dialogue: 0,0:21:04.23,0:21:04.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:21:04.95,0:21:08.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Koharu, bukankah kau punya kenalan\Nyang bekerja di toko pakaian?
Dialogue: 0,0:21:09.10,0:21:10.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, benar! Kak Mayo!
Dialogue: 0,0:21:10.31,0:21:12.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar! Terima kasih, Ayah!
Dialogue: 0,0:21:13.03,0:21:16.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi Ayah yang lebih dulu kepikiran\Nsoal pakaian renang daripada aku.
Dialogue: 0,0:21:16.26,0:21:18.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu agak menyeramkan.
Dialogue: 0,0:21:19.84,0:21:21.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya...
Dialogue: 0,0:21:22.68,0:21:26.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Papa! Airnya tumpah!\NAirnya tumpah ke mana-mana!
Dialogue: 0,0:21:26.11,0:21:27.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Papa? Papa!
Dialogue: 0,0:21:31.15,0:21:34.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perasaan orang selalu berubah.
Dialogue: 0,0:21:34.72,0:21:38.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pasti akan membuatnya\Nmempertimbangkan aku!
Dialogue: 0,0:21:39.57,0:21:42.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pantai bersama Sato...
Dialogue: 0,0:21:42.29,0:21:45.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sato memakai... pakaian renang?!
Dialogue: 0,0:21:45.23,0:21:48.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku harus bagaimana?!\NAku tidak bisa tidur!
Dialogue: 0,0:21:52.07,0:21:54.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pantai bersama Oshio...
Dialogue: 0,0:23:35.03,0:23:37.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya, "Pantai, Kucing,\Ndan Kisah Cinta".
Dialogue: 0,0:23:37.59,0:23:39.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teritip raksasa?!
