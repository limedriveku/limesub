Dialogue: 0,0:04:34.08,0:04:36.70,sign,,0000,0000,0000,,BIDIKAN 1: SATO SI DINGIN
Dialogue: 0,0:12:16.26,0:12:19.26,sign,,0000,0000,0000,,"PENGIKUT"
Dialogue: 0,0:18:15.35,0:18:17.60,sign,,0000,0000,0000,,UJIAN MASUK SMA SAKURABA
Dialogue: 0,0:22:01.54,0:22:04.96,sign,,0000,0000,0000,,BERSAMBUNG
Dialogue: 0,0:23:37.62,0:23:40.00,sign,,0000,0000,0000,,"SELANJUTNYA: CINTA PERTAMA KEDUA"
Dialogue: 0,0:00:15.70,0:00:17.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah menunggu.
Dialogue: 0,0:00:18.37,0:00:20.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini panekuk madu.
Dialogue: 0,0:00:20.98,0:00:22.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelihatannya enak sekali!
Dialogue: 0,0:00:22.40,0:00:24.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa pesanannya sudah lengkap semua?
Dialogue: 0,0:00:24.42,0:00:25.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:00:25.16,0:00:27.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat menikmati.
Dialogue: 0,0:00:27.98,0:00:30.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap!
Dialogue: 0,0:00:33.97,0:00:38.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Oshio Sota.\NAku bekerja di Cafe Tutuji,
Dialogue: 0,0:00:38.03,0:00:40.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kafe taman tersembunyi di sekitar sini.
Dialogue: 0,0:00:41.18,0:00:44.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengunjungnya kebanyakan rombongan perempuan\Ndan pasangan kekasih.
Dialogue: 0,0:00:44.40,0:00:46.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jarang ada tamu sendirian.
Dialogue: 0,0:00:50.83,0:00:52.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kurang mundur, ya?
Dialogue: 0,0:00:53.06,0:00:56.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin itu sebabnya dia menarik perhatianku.
Dialogue: 0,0:00:57.27,0:01:00.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa sebaiknya kufoto dari jauh?
Dialogue: 0,0:01:00.55,0:01:02.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, lebih dekat?
Dialogue: 0,0:01:02.90,0:01:03.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu...
Dialogue: 0,0:01:04.41,0:01:07.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk menonjolkan kesan menggugah selera...
Dialogue: 0,0:01:07.44,0:01:08.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti ini?
Dialogue: 0,0:01:14.15,0:01:15.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sato Koharu.
Dialogue: 0,0:01:15.98,0:01:18.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siswi kelas 2 SMA Sakuraba, sama sepertiku.
Dialogue: 0,0:01:21.27,0:01:25.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak awal masuk sekolah tahun lalu,\Ndia langsung jadi semacam selebritas.
Dialogue: 0,0:01:27.05,0:01:30.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penampilannya yang anggun dan sikapnya\Nyang kalem memikat banyak orang,
Dialogue: 0,0:01:30.95,0:01:33.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}baik laki-laki maupun perempuan.
Dialogue: 0,0:01:33.32,0:01:34.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun...
Dialogue: 0,0:01:35.34,0:01:36.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sato,
Dialogue: 0,0:01:37.38,0:01:40.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}maukah kau pergi denganku Sabtu depan?
Dialogue: 0,0:01:40.96,0:01:41.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buat apa?
Dialogue: 0,0:01:41.98,0:01:42.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:01:43.15,0:01:46.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bahkan tidak saling kenal.
Dialogue: 0,0:01:50.75,0:01:53.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sato, mau main boling sepulang sekolah?
Dialogue: 0,0:01:53.94,0:01:55.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, terima kasih.
Dialogue: 0,0:01:56.33,0:02:00.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sato, aku dari klub pemandu sorak!\NMau bergabung?
Dialogue: 0,0:02:00.60,0:02:01.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak tertarik.
Dialogue: 0,0:02:02.83,0:02:04.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sato, mau...
Dialogue: 0,0:02:04.57,0:02:06.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sibuk.
Dialogue: 0,0:02:07.74,0:02:11.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua orang langsung mati kutu\Nmenghadapi sikapnya yang ketus dan dingin.
Dialogue: 0,0:02:12.72,0:02:16.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga begitu.\NAku pernah sekali mencoba menyapanya, dan...
Dialogue: 0,0:02:17.33,0:02:20.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hai, Sato. K-Kau...
Dialogue: 0,0:02:20.88,0:02:22.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa kau?
Dialogue: 0,0:02:23.89,0:02:24.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:02:38.09,0:02:40.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitulah cara dia memperlakukan semua orang.
Dialogue: 0,0:02:45.78,0:02:47.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mendapat julukan...
Dialogue: 0,0:02:59.72,0:03:02.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sato si Dingin.
Dialogue: 0,0:03:13.52,0:03:15.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}The Cold Sato-san Is Only Sweet to Me
Dialogue: 0,0:04:36.70,0:04:40.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Seperti ini? Dari sini?\N- Jadi, Sato si Dingin
Dialogue: 0,0:04:40.52,0:04:45.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}datang ke kafe sendirian\Ndan tampak serius melakukan sesuatu.
Dialogue: 0,0:04:46.01,0:04:49.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu dia sedang berusaha\Nmemotret panekuk,
Dialogue: 0,0:04:50.67,0:04:52.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi, bagaimana, ya?
Dialogue: 0,0:04:52.72,0:04:55.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Sudut mana yang paling cocok?\N- Tingkahnya cukup menggemaskan.
Dialogue: 0,0:04:59.03,0:05:00.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Nona.
Dialogue: 0,0:05:02.16,0:05:04.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedang apa kau dari tadi?
Dialogue: 0,0:05:06.41,0:05:08.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan urusanmu.
Dialogue: 0,0:05:09.16,0:05:09.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah.
Dialogue: 0,0:05:11.11,0:05:12.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lucunya!
Dialogue: 0,0:05:12.66,0:05:14.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan galak-galak begitu, dong!
Dialogue: 0,0:05:14.98,0:05:17.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fotonya tidak bagus, 'kan?\NSini, berikan.
Dialogue: 0,0:05:17.63,0:05:18.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan memotretnya untukmu.
Dialogue: 0,0:05:18.81,0:05:19.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah.
Dialogue: 0,0:05:19.42,0:05:22.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai gantinya,\Nkasih kami nomormu juga, ya.
Dialogue: 0,0:05:22.70,0:05:24.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namanya juga saling bantu, 'kan?
Dialogue: 0,0:05:25.83,0:05:28.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Se-Sebentar...
Dialogue: 0,0:05:31.60,0:05:32.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi, Tuan.
Dialogue: 0,0:05:33.02,0:05:33.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:05:33.86,0:05:36.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin kalian salah masuk kafe.
Dialogue: 0,0:05:36.98,0:05:37.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah.
Dialogue: 0,0:05:42.27,0:05:46.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya dia tidak mau mengobrol\Ndengan kalian. Silakan pergi.
Dialogue: 0,0:05:51.80,0:05:55.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayolah, Pelayan. Kami cuma mengobrol.
Dialogue: 0,0:05:55.22,0:05:59.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah, sudah. Sana kerja lagi biar digaji.
Dialogue: 0,0:06:04.55,0:06:09.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manajer!\NMereka mau memuji panekuknya langsung!
Dialogue: 0,0:06:09.67,0:06:10.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:06:15.26,0:06:17.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa yang terjadi?
Dialogue: 0,0:06:46.25,0:06:47.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat! Gawat darurat!
Dialogue: 0,0:06:47.86,0:06:49.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia akan membunuh kita!
Dialogue: 0,0:06:50.43,0:06:51.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tagihannya, Tuan.
Dialogue: 0,0:06:55.43,0:06:57.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih! Silakan datang kembali!
Dialogue: 0,0:06:59.25,0:07:01.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka kabur lagi!
Dialogue: 0,0:07:01.54,0:07:04.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira kali ini aku bakal dipuji!
Dialogue: 0,0:07:05.55,0:07:09.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika ingin pelanggan memberi pujian\Nsecara langsung,
Dialogue: 0,0:07:09.24,0:07:12.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}urus dulu otot-otot itu, Ayah.
Dialogue: 0,0:07:12.92,0:07:15.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Otot-otot ini tidak salah apa-apa!
Dialogue: 0,0:07:15.01,0:07:16.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga.
Dialogue: 0,0:07:16.54,0:07:17.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh!
Dialogue: 0,0:07:17.25,0:07:18.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daripada itu...
Dialogue: 0,0:07:18.18,0:07:19.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sa-Sato!
Dialogue: 0,0:07:19.46,0:07:20.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau baik-baik saja?
Dialogue: 0,0:07:21.19,0:07:23.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}O-Oshio...
Dialogue: 0,0:07:23.46,0:07:25.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh. Kau tahu namaku?
Dialogue: 0,0:07:26.48,0:07:28.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa Oshio ada di sini?
Dialogue: 0,0:07:28.69,0:07:30.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelayan? Ayah?
Dialogue: 0,0:07:31.01,0:07:32.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:07:32.00,0:07:33.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu, itu...
Dialogue: 0,0:07:34.09,0:07:34.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:07:42.22,0:07:43.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sa-Sato?
Dialogue: 0,0:07:46.16,0:07:50.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku sangat takut!
Dialogue: 0,0:07:52.33,0:07:54.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sato si Dingin...
Dialogue: 0,0:08:00.87,0:08:01.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah!
Dialogue: 0,0:08:02.09,0:08:04.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, aku akan membawanya ke dalam.
Dialogue: 0,0:08:05.93,0:08:07.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke!
Dialogue: 0,0:08:13.26,0:08:14.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak.
Dialogue: 0,0:08:14.54,0:08:17.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu Earl Grey yang biasa kuminum.
Dialogue: 0,0:08:18.03,0:08:19.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga bisa membuatmu lebih tenang.
Dialogue: 0,0:08:19.74,0:08:20.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:08:20.92,0:08:24.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oshio, kau tahu siapa aku?
Dialogue: 0,0:08:24.10,0:08:26.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita satu kelas selama dua tahun.
Dialogue: 0,0:08:27.06,0:08:29.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah tahu tentang dia sejak lama,
Dialogue: 0,0:08:29.19,0:08:33.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi apa ini benar-benar Sato si Dingin?
Dialogue: 0,0:08:33.90,0:08:37.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak tahu keluargamu mengelola kafe ini.
Dialogue: 0,0:08:37.96,0:08:41.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, bukan hal penting\Nuntuk diceritakan juga, sih.
Dialogue: 0,0:08:41.42,0:08:43.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, Sato,
Dialogue: 0,0:08:43.13,0:08:45.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau kelihatan serius sekali tadi.\NSebenarnya sedang apa?
Dialogue: 0,0:08:45.49,0:08:46.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh...
Dialogue: 0,0:08:46.93,0:08:48.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, ah...
Dialogue: 0,0:08:49.04,0:08:52.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah! Kalau kau tidak mau mengatakannya,\Ntidak apa-apa!
Dialogue: 0,0:08:53.86,0:08:54.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu...
Dialogue: 0,0:08:55.38,0:08:57.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Ini!
Dialogue: 0,0:08:57.79,0:09:00.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong lihat ini.
Dialogue: 0,0:09:00.72,0:09:04.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudku, foto-foto di ponselku...
Dialogue: 0,0:09:05.10,0:09:06.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku boleh melihatnya?
Dialogue: 0,0:09:16.31,0:09:17.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini?
Dialogue: 0,0:09:21.83,0:09:22.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:09:23.58,0:09:25.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa semua ini hidangan manis?
Dialogue: 0,0:09:26.20,0:09:28.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan medan perang atau tabrakan mobil?
Dialogue: 0,0:09:28.83,0:09:32.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, foto yang paling baru ini...\Nmakanan dari kafe kami?
Dialogue: 0,0:09:34.22,0:09:36.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sangat payah dalam hal ini.
Dialogue: 0,0:09:39.00,0:09:41.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh! Maaf.
Dialogue: 0,0:09:41.01,0:09:45.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, aku tidak punya teman.
Dialogue: 0,0:09:45.61,0:09:46.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:09:46.29,0:09:50.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak pandai berbicara,\Njadi semua orang menjaga jarak.
Dialogue: 0,0:09:50.59,0:09:54.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku selalu gugup saat berbicara\Ndengan orang lain,
Dialogue: 0,0:09:54.45,0:09:56.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi tidak bisa banyak bicara.
Dialogue: 0,0:09:56.92,0:09:59.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau main boling sepulang sekolah?
Dialogue: 0,0:09:59.40,0:10:02.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa mengangkat bola seberat itu!
Dialogue: 0,0:10:02.47,0:10:03.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, terima kasih.
Dialogue: 0,0:10:04.66,0:10:08.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dari klub pemandu sorak!\NMau bergabung?
Dialogue: 0,0:10:08.01,0:10:08.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak tertarik.
Dialogue: 0,0:10:09.23,0:10:10.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya tidak tertarik,
Dialogue: 0,0:10:10.69,0:10:13.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku bisa mati malu\Nkalau harus mengangkat kaki setinggi itu!
Dialogue: 0,0:10:13.59,0:10:14.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau...
Dialogue: 0,0:10:14.94,0:10:16.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sibuk.
Dialogue: 0,0:10:16.68,0:10:19.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus membantu ibuku di rumah.
Dialogue: 0,0:10:20.25,0:10:21.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh.
Dialogue: 0,0:10:21.75,0:10:26.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, Sato, sikap dinginmu selama ini...
Dialogue: 0,0:10:26.51,0:10:27.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dingin?
Dialogue: 0,0:10:27.28,0:10:32.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, tidak, maksudku,\Napakah sebenarnya kau pemalu?
Dialogue: 0,0:10:33.05,0:10:36.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku tidak begitu pandai\Nberbicara dengan orang lain,
Dialogue: 0,0:10:36.75,0:10:41.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ta-tapi kalau dengan ibuku,\Naku bisa bicara lancar!
Dialogue: 0,0:10:41.94,0:10:44.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kalau aku menjadi\Npengguna aktif Minstagram,
Dialogue: 0,0:10:46.46,0:10:49.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin aku bisa mendapat teman!
Dialogue: 0,0:10:49.97,0:10:51.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minsta?
Dialogue: 0,0:10:51.73,0:10:56.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minstagram, media sosial\Nberbasis unggahan foto.
Dialogue: 0,0:10:57.20,0:10:58.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aplikasinya sangat populer
Dialogue: 0,0:10:58.98,0:11:02.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebagai wadah berbagi foto-foto estetik.
Dialogue: 0,0:11:02.82,0:11:06.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku suka makanan manis,\Njadi aku sering jajan sendirian.
Dialogue: 0,0:11:06.65,0:11:08.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku mengunggahnya ke Minsta,
Dialogue: 0,0:11:09.14,0:11:11.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kupikir mungkin aku bisa belajar mengobrol\Ndengan orang lain secara normal.
Dialogue: 0,0:11:12.41,0:11:14.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Ide bagus!
Dialogue: 0,0:11:14.89,0:11:16.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kau melakukan itu,
Dialogue: 0,0:11:16.67,0:11:21.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku yakin pandangan orang-orang terhadapmu\Nakan berubah... mungkin?
Dialogue: 0,0:11:22.29,0:11:23.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih!
Dialogue: 0,0:11:23.90,0:11:27.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku kurang pandai mengambil foto.
Dialogue: 0,0:11:27.21,0:11:28.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurang pandai?
Dialogue: 0,0:11:28.19,0:11:30.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku mengunggah ini ke Minsta,
Dialogue: 0,0:11:30.48,0:11:34.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mereka akan menyembunyikan sepatuku\Natau menaruh paku payung di dalamnya!
Dialogue: 0,0:11:34.85,0:11:38.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin sekali\Naku bakal dirundung habis-habisan!
Dialogue: 0,0:11:38.05,0:11:39.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa melakukannya!
Dialogue: 0,0:11:44.66,0:11:46.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pinjam ini sebentar, ya.
Dialogue: 0,0:11:47.40,0:11:50.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh aku memotret?
Dialogue: 0,0:11:50.07,0:11:50.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh, sih.
Dialogue: 0,0:11:54.12,0:11:55.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, ini.
Dialogue: 0,0:11:56.18,0:11:57.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:11:57.70,0:11:58.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:11:59.13,0:12:00.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Indah sekali!
Dialogue: 0,0:12:01.83,0:12:04.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau jauh lebih pandai daripada aku.
Dialogue: 0,0:12:04.13,0:12:06.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga menggunakan Minsta.
Dialogue: 0,0:12:06.94,0:12:09.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tepatnya, aku mengelola akun Cafe Tutuji.
Dialogue: 0,0:12:10.57,0:12:11.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah!
Dialogue: 0,0:12:12.14,0:12:14.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, wah, wah!
Dialogue: 0,0:12:16.26,0:12:19.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengikut... 5.000?!
Dialogue: 0,0:12:20.70,0:12:22.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengguna Minstagram sejati...
Dialogue: 0,0:12:29.27,0:12:31.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}O-Oshio!
Dialogue: 0,0:12:31.79,0:12:33.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana dengan yang ini?
Dialogue: 0,0:12:34.33,0:12:35.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah... Ya.
Dialogue: 0,0:12:36.75,0:12:38.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu...
Dialogue: 0,0:12:39.03,0:12:42.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku tidak mengerti\Nkenapa hasilnya bisa begini.
Dialogue: 0,0:12:43.06,0:12:43.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?!
Dialogue: 0,0:12:43.78,0:12:46.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selera seninya yang minim
Dialogue: 0,0:12:46.73,0:12:49.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan kecanggungan yang bahkan\Ntak bisa ditutupi
Dialogue: 0,0:12:49.26,0:12:51.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}oleh teknologi ponsel tercanggih sekalipun...
Dialogue: 0,0:12:52.08,0:12:55.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa memotret seburuk ini
Dialogue: 0,0:12:55.04,0:12:57.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}justru bakat tersendiri.
Dialogue: 0,0:12:59.82,0:13:04.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}K-Kau tidak perlu bilang sampai sebegitunya.
Dialogue: 0,0:13:04.69,0:13:06.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ga-Gawat.
Dialogue: 0,0:13:06.18,0:13:08.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, tapi... ya!
Dialogue: 0,0:13:08.12,0:13:11.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi ini lebih bagus daripada foto\Nyang kau ambil tadi! Sungguh!
Dialogue: 0,0:13:14.09,0:13:15.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?!
Dialogue: 0,0:13:16.44,0:13:19.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa menurutmu aku bisa menjadi\Npengguna Minstagram terkenal
Dialogue: 0,0:13:19.40,0:13:21.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan sedikit latihan lagi?
Dialogue: 0,0:13:21.31,0:13:26.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, ya. Tapi menurutku akan lebih bagus\Nkalau kau melakukannya seperti ini.
Dialogue: 0,0:13:27.65,0:13:29.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:13:29.80,0:13:30.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah!
Dialogue: 0,0:13:30.82,0:13:32.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}K-Kau mengagetkanku!
Dialogue: 0,0:13:32.61,0:13:35.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Malah kau yang mengagetkanku!
Dialogue: 0,0:13:35.26,0:13:37.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sangat dekat!
Dialogue: 0,0:13:37.26,0:13:40.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih mudah kalau aku\Nmenunjukkannya di layar.
Dialogue: 0,0:13:40.80,0:13:43.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama, cara mengatur fokus...
Dialogue: 0,0:13:44.49,0:13:47.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}O-Oshio...
Dialogue: 0,0:13:48.54,0:13:49.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:13:49.34,0:13:51.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, ini agak terlambat, tapi...
Dialogue: 0,0:13:52.19,0:13:57.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah menyelamatkanku tadi.\NKau benar-benar keren.
Dialogue: 0,0:13:58.83,0:14:00.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sato...
Dialogue: 0,0:14:15.86,0:14:16.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sota!
Dialogue: 0,0:14:18.15,0:14:21.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku lupa ada reservasi besar malam ini!
Dialogue: 0,0:14:21.10,0:14:23.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bantu aku bersiap-siap!
Dialogue: 0,0:14:38.38,0:14:40.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Anu, terima kasih untuk tehnya.
Dialogue: 0,0:14:40.74,0:14:44.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama-sama. Maaf membuatmu\Nterburu-buru pulang seperti ini.
Dialogue: 0,0:14:44.24,0:14:48.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, aku yang minta maaf\Nkarena lama di sini.
Dialogue: 0,0:14:48.06,0:14:49.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sungkan.
Dialogue: 0,0:14:50.07,0:14:52.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, sampai jumpa di sekolah.
Dialogue: 0,0:14:52.16,0:14:53.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Y-Ya.
Dialogue: 0,0:15:05.58,0:15:07.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Anu...
Dialogue: 0,0:15:07.05,0:15:07.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm?
Dialogue: 0,0:15:08.23,0:15:09.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang ketinggalan?
Dialogue: 0,0:15:09.53,0:15:12.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}O-Oshio...
Dialogue: 0,0:15:13.03,0:15:14.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fo-Foto...
Dialogue: 0,0:15:14.78,0:15:15.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku?
Dialogue: 0,0:15:15.37,0:15:17.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu-Bukan!
Dialogue: 0,0:15:17.04,0:15:18.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taman! Foto taman!
Dialogue: 0,0:15:18.82,0:15:20.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh aku memotretnya?
Dialogue: 0,0:15:20.44,0:15:21.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Foto taman?
Dialogue: 0,0:15:21.74,0:15:22.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:15:23.27,0:15:25.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bunga-bunga di taman kafe sangat cantik!
Dialogue: 0,0:15:25.67,0:15:27.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutku, itu akan terlihat bagus!
Dialogue: 0,0:15:27.92,0:15:32.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku ingin menjadi\Npengguna aktif Minstagram, jadi...
Dialogue: 0,0:15:34.02,0:15:38.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Kalau kau menyukai taman kami, silakan.
Dialogue: 0,0:15:38.05,0:15:40.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah! Asyik!
Dialogue: 0,0:15:40.50,0:15:41.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hore!
Dialogue: 0,0:15:50.94,0:15:54.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maaf! Kau ada pekerjaan setelah ini...
Dialogue: 0,0:15:54.42,0:15:58.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan pedulikan aku.\NTidak apa-apa. Tidak usah buru-buru.
Dialogue: 0,0:15:58.44,0:16:03.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau menyelamatkanku juga tadi.\NAku memang merepotkan...
Dialogue: 0,0:16:11.50,0:16:12.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:16:14.01,0:16:15.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kubantu.
Dialogue: 0,0:16:17.40,0:16:18.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:16:18.54,0:16:19.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah!
Dialogue: 0,0:16:22.10,0:16:22.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah?
Dialogue: 0,0:16:23.95,0:16:26.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf! Kameranya malah jadi kamera depan!
Dialogue: 0,0:16:27.04,0:16:28.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kucoba lagi?
Dialogue: 0,0:16:28.62,0:16:30.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak usah.
Dialogue: 0,0:16:31.26,0:16:32.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa!
Dialogue: 0,0:16:32.91,0:16:35.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fotonya bagus! Terima kasih!
Dialogue: 0,0:16:35.68,0:16:38.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baiklah, sampai jumpa di sekolah!
Dialogue: 0,0:16:39.15,0:16:40.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah.
Dialogue: 0,0:16:40.34,0:16:42.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hati-hati di jalan!
Dialogue: 0,0:16:54.06,0:16:56.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah boleh lega sekarang?
Dialogue: 0,0:17:02.66,0:17:03.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak tahan lagi!
Dialogue: 0,0:17:03.93,0:17:05.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, Sota?!
Dialogue: 0,0:17:05.54,0:17:07.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau baik-baik saja?!
Dialogue: 0,0:17:08.51,0:17:10.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau pegang otot dadaku?!
Dialogue: 0,0:17:10.96,0:17:13.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku mengatakan sesuatu yang aneh?
Dialogue: 0,0:17:13.76,0:17:15.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak salah bicara?!
Dialogue: 0,0:17:15.05,0:17:18.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa!\NKau sudah bersikap jantan!
Dialogue: 0,0:17:18.30,0:17:20.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bertindak seperti pria sejati!
Dialogue: 0,0:17:20.90,0:17:22.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah yakin?!
Dialogue: 0,0:17:22.58,0:17:27.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku panik sekali sampai bahkan\Nmembawanya ke kamarku!
Dialogue: 0,0:17:28.87,0:17:30.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manajer! Bisa ke sini sebentar?
Dialogue: 0,0:17:30.73,0:17:32.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya! Sebentar!
Dialogue: 0,0:17:33.32,0:17:35.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah.
Dialogue: 0,0:17:35.49,0:17:39.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku membawa gadis\Nyang belum pernah kuajak bicara ke kamarku!
Dialogue: 0,0:17:39.19,0:17:41.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bilang foto-fotonya jelek!
Dialogue: 0,0:17:41.59,0:17:45.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bahkan mengajarinya memotret!\NAku ini kenapa, sih?!
Dialogue: 0,0:17:45.64,0:17:47.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bukan salahku!
Dialogue: 0,0:17:47.72,0:17:49.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak ingin membuatnya takut
Dialogue: 0,0:17:49.68,0:17:52.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau membuatnya berpikir\Naku punya motif tersembunyi!
Dialogue: 0,0:17:52.71,0:17:54.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah melakukan yang terbaik!
Dialogue: 0,0:17:54.83,0:17:56.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah berusaha sebisaku!
Dialogue: 0,0:18:01.63,0:18:02.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:18:04.44,0:18:09.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sato tetaplah Sato yang sama.
Dialogue: 0,0:18:27.07,0:18:30.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah. Aku tidak lapar sama sekali.
Dialogue: 0,0:18:30.51,0:18:32.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seandainya aku percaya diri seperti Ren.
Dialogue: 0,0:18:36.94,0:18:40.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tidak makan sama sekali.
Dialogue: 0,0:18:41.11,0:18:42.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah dia gugup?
Dialogue: 0,0:18:48.17,0:18:48.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:18:52.05,0:18:53.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei...
Dialogue: 0,0:18:57.17,0:19:00.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Anu, kau tidak makan?
Dialogue: 0,0:19:00.85,0:19:03.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah sebaiknya kau makan sedikit?
Dialogue: 0,0:19:03.76,0:19:05.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biarkan aku sendiri.
Dialogue: 0,0:19:05.18,0:19:05.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Uh.
Dialogue: 0,0:19:05.95,0:19:07.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dingin seperti es.
Dialogue: 0,0:19:07.64,0:19:08.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah!
Dialogue: 0,0:19:10.40,0:19:11.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini, makanlah sedikit.
Dialogue: 0,0:19:13.51,0:19:15.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:19:15.01,0:19:16.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permen gula.
Dialogue: 0,0:19:16.42,0:19:17.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga tahu.
Dialogue: 0,0:19:18.39,0:19:19.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau?
Dialogue: 0,0:19:19.12,0:19:22.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mengejekku, ya?\NAku ini serius.
Dialogue: 0,0:19:22.78,0:19:25.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi tanganmu gemetar.
Dialogue: 0,0:19:26.55,0:19:28.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayahku memberikannya padaku.
Dialogue: 0,0:19:28.90,0:19:31.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya makanan manis membantu\Nketika otak kita lelah.
Dialogue: 0,0:19:31.68,0:19:34.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti lumayan untuk mengganjal perutmu.
Dialogue: 0,0:19:34.34,0:19:37.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa itu urusanmu?
Dialogue: 0,0:19:39.83,0:19:40.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:19:41.83,0:19:42.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:19:43.58,0:19:44.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena
Dialogue: 0,0:19:44.72,0:19:47.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}siapa tahu nanti kita jadi teman sekelas.
Dialogue: 0,0:19:58.17,0:19:59.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu...
Dialogue: 0,0:19:59.23,0:20:00.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm?
Dialogue: 0,0:20:00.67,0:20:03.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh aku makan satu?
Dialogue: 0,0:20:03.30,0:20:04.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja.
Dialogue: 0,0:20:13.41,0:20:15.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini cuma permen gula.
Dialogue: 0,0:20:15.94,0:20:17.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, memang cuma gula, sih.
Dialogue: 0,0:20:17.59,0:20:18.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:20:22.72,0:20:23.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:20:24.47,0:20:26.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sangat enak dan manis.
Dialogue: 0,0:20:27.41,0:20:29.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:20:30.77,0:20:32.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Y-Ya.
Dialogue: 0,0:20:33.83,0:20:38.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketika bertemu lagi di SMA,\Nkau tidak mengingatku sama sekali.
Dialogue: 0,0:20:40.08,0:20:44.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku ingin melihat senyum itu lagi.
Dialogue: 0,0:20:45.54,0:20:46.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena...
Dialogue: 0,0:20:47.65,0:20:50.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena pada hari itu, aku...
Dialogue: 0,0:20:57.49,0:20:58.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oshio.
Dialogue: 0,0:21:02.38,0:21:03.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oshio.
Dialogue: 0,0:21:07.93,0:21:09.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oshio.
Dialogue: 0,0:21:13.25,0:21:16.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oshio Sota!
Dialogue: 0,0:21:22.55,0:21:25.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana ini?\NAku harus bagaimana?
Dialogue: 0,0:21:31.36,0:21:34.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena pada hari itu, aku telah
Dialogue: 0,0:21:34.05,0:21:36.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}melabuhkan satu-satunya\Ncinta pertama di hidupku.
Dialogue: 0,0:21:51.13,0:21:57.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku banyak bicara dengan cinta pertamaku!
Dialogue: 0,0:23:34.99,0:23:37.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya, "Cinta Pertama Kedua".
Dialogue: 0,0:23:37.62,0:23:40.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berapa kali pun, aku...
