Dialogue: 0,0:02:01.00,0:02:02.44,sign,,0000,0000,0000,,BIDIKAN 7: KUNCI KEKASIH
Dialogue: 0,0:02:02.44,0:02:04.12,sign,,0000,0000,0000,,SATO, KAU TIDAK APA-APA? KAU DI MANA?\NKAU TIDAK APA-APA?
Dialogue: 0,0:11:11.83,0:11:12.70,sign,,0000,0000,0000,,O...
Dialogue: 0,0:14:19.77,0:14:20.96,sign,,0000,0000,0000,,- O...
Dialogue: 0,0:14:31.93,0:14:33.89,sign,,0000,0000,0000,,PENGINAPAN KANAMI
Dialogue: 0,0:15:13.53,0:15:16.84,sign,,0000,0000,0000,,"MENU HARI INI! REKOMENDASI: KEONG MACAN"
Dialogue: 0,0:18:01.51,0:18:03.51,sign,,0000,0000,0000,,"KOHARU - SOTA"\NS...
Dialogue: 0,0:19:15.94,0:19:18.97,sign,,0000,0000,0000,,BERSAMBUNG
Dialogue: 0,0:22:17.72,0:22:20.01,sign,,0000,0000,0000,,"MADOKA - REN"
Dialogue: 0,0:22:36.61,0:22:40.61,sign,,0000,0000,0000,,MADOKA - REN
Dialogue: 0,0:23:26.86,0:23:30.15,sign,,0000,0000,0000,,MADOKA - REN
Dialogue: 0,0:23:30.15,0:23:34.62,sign,,0000,0000,0000,,KOHARU - SOTA
Dialogue: 0,0:23:37.90,0:23:39.65,sign,,0000,0000,0000,,"SELANJUTNYA: TAK BISA BERHENTI MENYUKAINYA"
Dialogue: 0,0:00:00.68,0:00:04.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau cantik sekali dengan pakaian renangmu.
Dialogue: 0,0:00:21.20,0:00:22.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:00:23.10,0:00:25.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hantu kain?
Dialogue: 0,0:00:25.00,0:00:25.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:00:26.23,0:00:27.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Koharu?!
Dialogue: 0,0:00:27.36,0:00:29.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sedang apa?
Dialogue: 0,0:00:40.51,0:00:42.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}The Cold Sato-san Is Only Sweet to Me
Dialogue: 0,0:02:07.43,0:02:08.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau kenapa, sih?
Dialogue: 0,0:02:08.97,0:02:12.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau sampai kapan kau murung?
Dialogue: 0,0:02:13.47,0:02:17.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kebahagiaan tidak akan datang\Nkalau kau meringkuk begitu!
Dialogue: 0,0:02:17.06,0:02:19.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu itu...
Dialogue: 0,0:02:19.48,0:02:21.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shizuku, kau terlalu banyak minum.
Dialogue: 0,0:02:21.85,0:02:25.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bilang padanya dia tidak perlu\Nmemaksakan diri memakai pakaian renang,
Dialogue: 0,0:02:26.27,0:02:28.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan baru saja kata-kata itu kuucapkan,
Dialogue: 0,0:02:29.18,0:02:33.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku malah melihat kulitnya\Ndengan mata kepalaku sendiri.
Dialogue: 0,0:02:34.49,0:02:35.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar ratu drama!
Dialogue: 0,0:02:35.79,0:02:38.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shizuku, sudahlah.
Dialogue: 0,0:02:39.44,0:02:40.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau mencarinya.
Dialogue: 0,0:02:40.86,0:02:45.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Biarkan saja. Kau terlalu memanjakannya.
Dialogue: 0,0:02:45.75,0:02:46.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:02:46.61,0:02:49.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba pikir. Kau sudah meyakinkan\Nayahnya yang terlalu protektif
Dialogue: 0,0:02:49.49,0:02:50.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}supaya mengizinkannya pergi.
Dialogue: 0,0:02:51.17,0:02:55.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kau mulai memanjakannya,\Nkau cuma akan jadi ayah kedua.
Dialogue: 0,0:02:55.95,0:02:58.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan biarkan dia bergantung padamu.
Dialogue: 0,0:02:59.24,0:03:02.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja.\NDia akan kembali setelah tenang.
Dialogue: 0,0:03:02.70,0:03:05.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, kalaupun kau\Nmenemukannya sekarang,
Dialogue: 0,0:03:05.13,0:03:07.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Koharu pasti kabur lagi.
Dialogue: 0,0:03:08.74,0:03:11.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau biarkan dia sendiri dulu?
Dialogue: 0,0:03:11.57,0:03:12.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau benar.
Dialogue: 0,0:03:13.51,0:03:14.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, benar!
Dialogue: 0,0:03:15.63,0:03:18.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa Kak Mayo benar.
Dialogue: 0,0:03:18.97,0:03:20.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya canggung bertemu dengannya sekarang.
Dialogue: 0,0:03:21.95,0:03:26.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasa kulit Sato\Nmasih tertinggal di tanganku...
Dialogue: 0,0:03:27.21,0:03:29.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku cuma punya niat terselubung?!
Dialogue: 0,0:03:36.12,0:03:40.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bilang kau jauh-jauh ke pantai\Ncuma untuk menatap tanganmu.
Dialogue: 0,0:03:40.63,0:03:43.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayang sekali kalau begitu, Kak Oshio.
Dialogue: 0,0:03:43.69,0:03:44.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rinka...
Dialogue: 0,0:03:44.96,0:03:45.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah!
Dialogue: 0,0:03:45.71,0:03:46.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, tunggu, tunggu!
Dialogue: 0,0:03:47.11,0:03:48.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rinka?!
Dialogue: 0,0:03:53.72,0:03:56.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau kau ajari aku juga?
Dialogue: 0,0:03:56.19,0:03:59.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cara bersenang-senang di pantai.
Dialogue: 0,0:04:00.87,0:04:02.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rinka...
Dialogue: 0,0:04:09.96,0:04:13.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei. Sedang apa kau di sini?
Dialogue: 0,0:04:13.29,0:04:14.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Madoka?
Dialogue: 0,0:04:14.69,0:04:15.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pekerjaanmu bagaimana?
Dialogue: 0,0:04:15.92,0:04:17.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi istirahat.
Dialogue: 0,0:04:17.33,0:04:23.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi aku di dek observasi.\NDari atas sana, seluruh pantai kelihatan.
Dialogue: 0,0:04:23.09,0:04:24.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau lihat kejadiannya?
Dialogue: 0,0:04:24.91,0:04:28.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku lihat semuanya.\NKau kabur.
Dialogue: 0,0:04:30.69,0:04:32.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini, makanlah.
Dialogue: 0,0:04:32.26,0:04:33.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Apa?
Dialogue: 0,0:04:34.08,0:04:36.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Es krim lembut hijau?
Dialogue: 0,0:04:36.35,0:04:38.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namanya Es Krim Lembut Midorikawa.
Dialogue: 0,0:04:38.77,0:04:42.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namanya membosankan.\NIni menu spesial kafe kami.
Dialogue: 0,0:04:42.51,0:04:43.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cantik sekali.
Dialogue: 0,0:04:45.48,0:04:46.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asin-manis?
Dialogue: 0,0:04:47.10,0:04:49.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya aneh, tapi enak.
Dialogue: 0,0:04:49.69,0:04:53.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada garamnya.\NGaram dari laut sekitar Midorikawa.
Dialogue: 0,0:04:53.54,0:04:54.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah...
Dialogue: 0,0:04:54.58,0:04:58.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini es krim yang biasa dimakan Oshio?
Dialogue: 0,0:04:59.36,0:05:02.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pasti barusan memikirkan Sota.
Dialogue: 0,0:05:02.50,0:05:03.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ap...
Dialogue: 0,0:05:03.63,0:05:06.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kau bisa tahu?!\NKau cenayang, ya?!
Dialogue: 0,0:05:06.89,0:05:08.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu jadi cenayang untuk tahu itu.
Dialogue: 0,0:05:08.69,0:05:10.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, ada apa dengannya?
Dialogue: 0,0:05:12.91,0:05:16.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku beli pakaian renang ini...
Dialogue: 0,0:05:16.67,0:05:18.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk kutunjukkan ke Oshio...
Dialogue: 0,0:05:18.65,0:05:19.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan dia melihatnya...
Dialogue: 0,0:05:20.50,0:05:24.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, waktu dia melihatnya,\Naku malu sekali, jadi aku kabur.
Dialogue: 0,0:05:24.42,0:05:26.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak masuk akal.
Dialogue: 0,0:05:26.81,0:05:28.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, memang tidak masuk akal.
Dialogue: 0,0:05:28.42,0:05:33.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang sekali\Nwaktu Oshio mengajakku ke pantai.
Dialogue: 0,0:05:33.85,0:05:37.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin melihat hal yang sama dengannya,\Nmakan makanan yang sama dengannya,
Dialogue: 0,0:05:37.69,0:05:41.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}melakukan hal yang sama dengannya,\Ndan berbagi segala hal bersama.
Dialogue: 0,0:05:41.57,0:05:45.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kupikir kami bisa melakukan\Nhal-hal layaknya sepasang kekasih di pantai.
Dialogue: 0,0:05:47.19,0:05:51.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku malah menyia-nyiakan kesempatanku.
Dialogue: 0,0:05:51.30,0:05:53.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benar-benar payah...
Dialogue: 0,0:05:53.75,0:05:55.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, kau payah sekali.
Dialogue: 0,0:05:55.26,0:05:57.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Parah. Sulit dipercaya.
Dialogue: 0,0:05:57.63,0:05:58.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau memalukan.
Dialogue: 0,0:05:59.96,0:06:04.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Kau pikir\Naku bakal menghiburmu?
Dialogue: 0,0:06:04.06,0:06:07.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jujur, kupikir kau mungkin akan begitu.
Dialogue: 0,0:06:07.93,0:06:11.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak menyangka kau malah menghabisiku...
Dialogue: 0,0:06:11.50,0:06:12.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ha!
Dialogue: 0,0:06:12.12,0:06:13.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayang sekali.
Dialogue: 0,0:06:13.27,0:06:17.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benci cewek-cewek\Nyang saling menjilati luka.
Dialogue: 0,0:06:17.92,0:06:19.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malah, akan kutaburi garam di lukamu.
Dialogue: 0,0:06:19.80,0:06:22.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Payah!\NKau benar-benar payah!
Dialogue: 0,0:06:22.16,0:06:24.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau 100 persen salah!
Dialogue: 0,0:06:24.44,0:06:25.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada ruang untuk simpati!
Dialogue: 0,0:06:26.40,0:06:27.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengar.
Dialogue: 0,0:06:28.18,0:06:33.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan cuma kau yang ingin\Nberbagi sesuatu dengan orang yang disukai.
Dialogue: 0,0:06:33.34,0:06:34.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:06:34.18,0:06:36.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sota ingin berbagi juga.
Dialogue: 0,0:06:36.86,0:06:39.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah artinya saling suka.
Dialogue: 0,0:06:39.53,0:06:41.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oshio juga menginginkannya?
Dialogue: 0,0:06:43.09,0:06:44.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, jangan kabur!
Dialogue: 0,0:06:44.94,0:06:48.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kau terlalu malu memperlihatkan\Npakaian renangmu, pakai handuk!
Dialogue: 0,0:06:48.27,0:06:50.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kau tidak bisa menatapnya,\Nlihat saja ke tanah!
Dialogue: 0,0:06:50.45,0:06:52.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kau tidak bisa berkata-kata,\Ndiam saja!
Dialogue: 0,0:06:52.95,0:06:55.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu-satunya yang tidak boleh\Nkau lakukan adalah kabur!
Dialogue: 0,0:06:55.83,0:06:58.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetaplah di sampingnya,\Ndan perasaanmu pasti akan tersampaikan.
Dialogue: 0,0:06:59.54,0:07:01.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Madoka...
Dialogue: 0,0:07:02.33,0:07:05.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hmph. Aku bukan tipe orang\Nyang suka bicara begini.
Dialogue: 0,0:07:05.86,0:07:07.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Madoka...
Dialogue: 0,0:07:07.30,0:07:08.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya.
Dialogue: 0,0:07:09.17,0:07:11.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini, kuberikan ini juga.
Dialogue: 0,0:07:11.86,0:07:12.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kunci?
Dialogue: 0,0:07:12.83,0:07:14.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gembok.
Dialogue: 0,0:07:14.64,0:07:16.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya, kalau kau menulis nama kalian berdua\Ndi baliknya
Dialogue: 0,0:07:16.79,0:07:20.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu memasangnya di pagar dek observasi,\Nkalian akan bersama selamanya.
Dialogue: 0,0:07:20.72,0:07:22.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu kebiasaan turis.
Dialogue: 0,0:07:22.73,0:07:25.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau suka hal-hal\Nberbau takhayul begini, 'kan?
Dialogue: 0,0:07:25.70,0:07:26.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:07:27.52,0:07:30.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau sampai sebegitunya demi aku?
Dialogue: 0,0:07:30.01,0:07:32.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita baru bertemu hari ini.
Dialogue: 0,0:07:33.30,0:07:35.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak ada alasan.
Dialogue: 0,0:07:35.92,0:07:39.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita sudah saling cerita soal cinta,\Njadi kita teman, 'kan?
Dialogue: 0,0:07:43.74,0:07:45.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei! Apa yang kau...
Dialogue: 0,0:07:45.74,0:07:47.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dingin! Es krimnya kena aku...
Dialogue: 0,0:07:47.68,0:07:51.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Hentikan! Lepas! Panas!\N- Madoka! Terima kasih banyak!
Dialogue: 0,0:07:51.40,0:07:55.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayolah! Lepas! Dengar, tidak?
Dialogue: 0,0:07:56.17,0:07:58.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa aku bisa lupa?
Dialogue: 0,0:07:58.95,0:08:01.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku malu, Oshio juga.
Dialogue: 0,0:08:02.26,0:08:05.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku senang, Oshio juga.
Dialogue: 0,0:08:07.28,0:08:09.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus menemui Oshio!
Dialogue: 0,0:08:10.47,0:08:12.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin melihat laut bersamanya.
Dialogue: 0,0:08:12.78,0:08:15.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin makan es krim hijau bersamanya.
Dialogue: 0,0:08:15.29,0:08:18.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga ingin berpelukan dengannya!
Dialogue: 0,0:08:18.22,0:08:22.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, aku akan memamerkan\Nbetapa hebatnya teman baruku!
Dialogue: 0,0:08:22.98,0:08:23.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah!
Dialogue: 0,0:08:28.62,0:08:30.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu terlalu memalukan...
Dialogue: 0,0:08:30.84,0:08:31.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Nona!
Dialogue: 0,0:08:31.99,0:08:32.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh...
Dialogue: 0,0:08:32.65,0:08:33.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak apa-apa?
Dialogue: 0,0:08:34.70,0:08:40.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tersandung tepat di depan kami.\NKami khawatir, jadi kami tanya.
Dialogue: 0,0:08:40.85,0:08:43.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa? Buru-buru mau ke mana?
Dialogue: 0,0:08:43.58,0:08:45.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka bau bir...
Dialogue: 0,0:08:46.59,0:08:49.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Te-Terima kasih banyak...
Dialogue: 0,0:08:49.82,0:08:52.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi. Aku pergi dulu.
Dialogue: 0,0:08:52.03,0:08:53.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:08:53.20,0:08:54.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu sebentar...
Dialogue: 0,0:08:54.60,0:08:56.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau gadis yang waktu itu di kafe panekuk!\NLama tidak bertemu!
Dialogue: 0,0:08:56.75,0:08:58.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Hah?\N- Serius? Gila!
Dialogue: 0,0:09:02.93,0:09:04.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kebetulan sekali.
Dialogue: 0,0:09:04.89,0:09:07.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa, kau sendirian?\NOh, menunggu cowok mendekatimu?
Dialogue: 0,0:09:08.31,0:09:09.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak...
Dialogue: 0,0:09:09.35,0:09:13.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin bilang tidak,\Ntapi kata-katanya tidak mau keluar...
Dialogue: 0,0:09:13.19,0:09:16.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Bagus. Kita bisa minum di sana.\N- Aku takut... Aku takut...
Dialogue: 0,0:09:16.52,0:09:17.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ayo!\N- Tidak... Tidak...
Dialogue: 0,0:09:17.71,0:09:19.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku takut... Tidak...
Dialogue: 0,0:09:19.62,0:09:22.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku takut... Aku takut...
Dialogue: 0,0:09:22.91,0:09:24.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong aku!
Dialogue: 0,0:09:24.52,0:09:26.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa tolong hentikan?
Dialogue: 0,0:09:31.02,0:09:33.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oshio?
Dialogue: 0,0:09:43.88,0:09:44.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rinka?
Dialogue: 0,0:09:45.72,0:09:47.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau yakin begini sudah benar?
Dialogue: 0,0:09:48.95,0:09:52.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia jelas-jelas menolakku.\NMana mungkin aku tidak menyerah?
Dialogue: 0,0:09:53.03,0:09:55.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau pergi mencari Sato.
Dialogue: 0,0:09:57.13,0:10:01.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan saat Koharu tidak ada,\NKak Oshio cuma memikirkannya.
Dialogue: 0,0:10:01.88,0:10:05.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Argh! Kesal sekali aku!
Dialogue: 0,0:10:05.52,0:10:10.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita di pantai! Mungkin aku bisa\Ncoba menggoda beberapa cowok!
Dialogue: 0,0:10:12.14,0:10:14.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hati-hati jangan sampai\Nkulitmu terbakar matahari, Rinka.
Dialogue: 0,0:10:15.28,0:10:17.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kulitmu indah.
Dialogue: 0,0:10:19.98,0:10:22.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau memang paling mengerti aku, Kak Mayo.
Dialogue: 0,0:10:23.10,0:10:25.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku suka sekali pada Kak Oshio.
Dialogue: 0,0:10:26.12,0:10:30.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi aku bohong.\NAku masih suka pada Kak Oshio.
Dialogue: 0,0:10:31.18,0:10:34.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski dia tidak mau melihatku...
Dialogue: 0,0:10:34.01,0:10:37.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rinka, kau tidak menangis.
Dialogue: 0,0:10:37.39,0:10:39.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menangis? Tidak akan.
Dialogue: 0,0:10:39.54,0:10:43.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku menangis,\Nberarti aku mengaku kalah.
Dialogue: 0,0:10:44.16,0:10:46.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belum menyerah. Malah...
Dialogue: 0,0:10:46.78,0:10:49.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menyatakan perasaanku\Npada Kak Oshio!
Dialogue: 0,0:10:51.35,0:10:53.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah! Kau!
Dialogue: 0,0:10:53.23,0:10:55.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pelayan kafe itu!
Dialogue: 0,0:10:55.38,0:10:56.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah!
Dialogue: 0,0:10:56.23,0:10:57.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, benar!
Dialogue: 0,0:10:57.66,0:11:00.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, tidak ada aturan\Nyang melarang menggoda cewek di sini.
Dialogue: 0,0:11:00.15,0:11:03.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak berhak mengatur kami, Pelayan!
Dialogue: 0,0:11:04.33,0:11:06.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berhak.
Dialogue: 0,0:11:06.99,0:11:07.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:11:08.67,0:11:09.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pacarnya.
Dialogue: 0,0:11:14.63,0:11:16.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oshio...
Dialogue: 0,0:11:20.02,0:11:21.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, gaya si pelayan ini keren sekali!
Dialogue: 0,0:11:24.92,0:11:27.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bikin aku kesal.
Dialogue: 0,0:11:31.14,0:11:33.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo?
Dialogue: 0,0:11:33.27,0:11:37.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei! Hei! Hei! Hei! Hei!
Dialogue: 0,0:11:37.90,0:11:40.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata Sota!
Dialogue: 0,0:11:40.65,0:11:42.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:11:44.00,0:11:46.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga, lama sekali tidak ketemu!
Dialogue: 0,0:11:47.55,0:11:50.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bicara. Ikuti saja aku.
Dialogue: 0,0:11:52.07,0:11:53.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga, luar biasa!
Dialogue: 0,0:11:53.99,0:11:56.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini aku datang bersama teman-temanku!
Dialogue: 0,0:11:56.32,0:11:58.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau kau gabung dengan kami?
Dialogue: 0,0:11:58.37,0:12:00.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, kau akan ikut.
Dialogue: 0,0:12:00.87,0:12:01.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm?
Dialogue: 0,0:12:02.75,0:12:05.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian lihat apa, hm?
Dialogue: 0,0:12:05.46,0:12:09.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Heh. Kenapa kau?
Dialogue: 0,0:12:09.61,0:12:10.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ren...
Dialogue: 0,0:12:15.40,0:12:16.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh!
Dialogue: 0,0:12:18.92,0:12:20.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Leo?
Dialogue: 0,0:12:22.51,0:12:22.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Leo!
Dialogue: 0,0:12:22.95,0:12:23.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh...
Dialogue: 0,0:12:23.93,0:12:25.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak apa-apa?
Dialogue: 0,0:12:25.01,0:12:26.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial...
Dialogue: 0,0:12:26.38,0:12:27.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:12:28.35,0:12:29.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan ini?
Dialogue: 0,0:12:30.27,0:12:31.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian!
Dialogue: 0,0:12:31.80,0:12:34.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian apakan Leo-ku?!
Dialogue: 0,0:12:34.88,0:12:37.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menjauh darinya!
Dialogue: 0,0:12:48.06,0:12:50.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau cuma mau kabur,\Njangan datang sama sekali!
Dialogue: 0,0:12:51.66,0:12:53.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Koharu, kau tidak apa-apa?
Dialogue: 0,0:12:54.28,0:12:55.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Madoka...
Dialogue: 0,0:12:55.67,0:12:59.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?! Kau terluka?
Dialogue: 0,0:13:00.35,0:13:01.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Madoka...
Dialogue: 0,0:13:01.93,0:13:05.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau lebih menakutkan\Ndaripada cowok-cowok itu...
Dialogue: 0,0:13:05.57,0:13:06.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh.
Dialogue: 0,0:13:06.63,0:13:09.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyalimu ternyata lebih besar\Ndari yang kukira, Sota.
Dialogue: 0,0:13:09.85,0:13:11.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Murasaki...
Dialogue: 0,0:13:13.24,0:13:16.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak!\NKukira kami bakal tamat!
Dialogue: 0,0:13:16.62,0:13:19.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Kukira kau santai saja.
Dialogue: 0,0:13:20.08,0:13:23.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya. Oshio sebenarnya juga takut.
Dialogue: 0,0:13:24.36,0:13:26.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi dia tetap melakukannya demi aku...
Dialogue: 0,0:13:27.11,0:13:28.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oshio...
Dialogue: 0,0:13:30.53,0:13:33.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana? Kau lihat, Sota?
Dialogue: 0,0:13:33.13,0:13:37.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak-anak kuliahan itu sok hebat,\Ntapi malah kabur! Payah!
Dialogue: 0,0:13:37.74,0:13:39.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suasana hatimu sudah membaik?
Dialogue: 0,0:13:39.78,0:13:41.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ada yang lebih seru dari itu?
Dialogue: 0,0:13:41.73,0:13:45.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Madoka memang preman sejati!
Dialogue: 0,0:13:46.41,0:13:47.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:13:47.41,0:13:50.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ren, kau kenal Murasaki?
Dialogue: 0,0:13:50.36,0:13:51.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah.
Dialogue: 0,0:13:51.80,0:13:53.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kembali dulu.
Dialogue: 0,0:13:55.95,0:13:58.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak lupa padaku?
Dialogue: 0,0:13:59.89,0:14:01.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin aku...
Dialogue: 0,0:14:03.10,0:14:04.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}melupakanmu?
Dialogue: 0,0:14:10.56,0:14:12.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, 'kan, Madoka?
Dialogue: 0,0:14:12.50,0:14:13.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diam, Bodoh!
Dialogue: 0,0:14:13.57,0:14:14.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh.
Dialogue: 0,0:14:14.59,0:14:16.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus kerja.
Dialogue: 0,0:14:19.77,0:14:20.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Oh, S...
Dialogue: 0,0:14:21.87,0:14:23.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Oshio!\N- Sato!
Dialogue: 0,0:14:23.63,0:14:24.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh.
Dialogue: 0,0:14:27.37,0:14:29.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita kembali ke yang lain?
Dialogue: 0,0:14:30.24,0:14:31.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:14:35.12,0:14:38.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bir setelah berenang memang terbaik!
Dialogue: 0,0:14:38.12,0:14:42.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buatmu, bir setelah apa pun\Nselalu yang terbaik.
Dialogue: 0,0:14:42.49,0:14:44.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pun sama saja.
Dialogue: 0,0:14:44.87,0:14:47.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini tahun terakhir tempat ini.
Dialogue: 0,0:14:47.89,0:14:48.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:14:48.80,0:14:51.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nenek Kanami akan menutup tempat ini.
Dialogue: 0,0:14:51.62,0:14:52.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Benarkah?
Dialogue: 0,0:14:52.89,0:14:56.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?! Padahal aku masih mau makan\Nkeong macan lagi!
Dialogue: 0,0:14:56.34,0:14:58.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm? Kalian bicara apa?
Dialogue: 0,0:15:01.03,0:15:03.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa bilang aku akan tutup?
Dialogue: 0,0:15:03.52,0:15:05.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma mau merenovasinya.
Dialogue: 0,0:15:05.69,0:15:06.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Renovasi?
Dialogue: 0,0:15:07.43,0:15:09.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar otak otot!
Dialogue: 0,0:15:10.26,0:15:13.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sedang viral di media sosial. Lihat.
Dialogue: 0,0:15:13.53,0:15:16.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, ini akun Minsta Nenek?
Dialogue: 0,0:15:16.84,0:15:18.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelihatannya mewah.
Dialogue: 0,0:15:18.16,0:15:24.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Jadi, aku akan mengubah tempat ini\Njadi kafe bertema pop.
Dialogue: 0,0:15:24.64,0:15:25.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah...
Dialogue: 0,0:15:25.73,0:15:26.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus juga.
Dialogue: 0,0:15:26.79,0:15:28.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau unggah apa lagi?
Dialogue: 0,0:15:29.63,0:15:30.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oshio.
Dialogue: 0,0:15:30.90,0:15:31.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm?
Dialogue: 0,0:15:31.68,0:15:33.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Anu...
Dialogue: 0,0:15:33.18,0:15:37.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti aku ingin kau\Nmengantarku ke suatu tempat.
Dialogue: 0,0:15:37.14,0:15:37.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:15:40.18,0:15:42.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini menyenangkan sekali.
Dialogue: 0,0:15:42.31,0:15:44.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, benar.
Dialogue: 0,0:15:44.06,0:15:46.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belum pernah\Nmain pukul semangka sebelumnya.
Dialogue: 0,0:15:46.34,0:15:47.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga.
Dialogue: 0,0:15:47.43,0:15:51.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku panik waktu Kak Shizuku mencuri semangka\Nkarena iseng saat mabuk.
Dialogue: 0,0:15:52.87,0:15:56.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rinka bikin aku kaget.\NRenangnya seperti atlet profesional.
Dialogue: 0,0:15:56.93,0:15:57.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, benar!
Dialogue: 0,0:15:57.99,0:16:00.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Mayo juga luar biasa.
Dialogue: 0,0:16:00.50,0:16:03.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa sangka dia bisa membuat\Nistana pasir sebesar itu?
Dialogue: 0,0:16:03.31,0:16:05.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memotret banyak sekali!
Dialogue: 0,0:16:05.74,0:16:08.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga dapat teman pertamaku.
Dialogue: 0,0:16:09.17,0:16:11.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia manis sekali dan keren.
Dialogue: 0,0:16:12.03,0:16:13.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Murasaki, ya?
Dialogue: 0,0:16:13.49,0:16:15.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awalnya dia agak galak, sih.
Dialogue: 0,0:16:15.81,0:16:16.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, 'kan?
Dialogue: 0,0:16:17.47,0:16:20.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga jadi lebih mengenal semua orang.
Dialogue: 0,0:16:20.14,0:16:21.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oshio,
Dialogue: 0,0:16:22.11,0:16:25.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}terima kasih sudah mengajakku ke pantai.
Dialogue: 0,0:16:38.35,0:16:39.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luar biasa.
Dialogue: 0,0:16:42.98,0:16:45.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belum pernah melihat yang seperti ini.
Dialogue: 0,0:16:45.29,0:16:48.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Matahari terbenam dari sini\Nmemang agak istimewa.
Dialogue: 0,0:16:49.59,0:16:51.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau pulang.
Dialogue: 0,0:16:51.21,0:16:57.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang dulu pasti berharap matahari\Nberhenti terbenam dan tetap di sana.
Dialogue: 0,0:16:58.74,0:17:00.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang tidak lagi?
Dialogue: 0,0:17:01.08,0:17:04.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bohong kalau kubilang tidak,
Dialogue: 0,0:17:04.66,0:17:08.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku ingin melihat banyak hal bersamamu.
Dialogue: 0,0:17:08.67,0:17:10.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin makan berbagai makanan.
Dialogue: 0,0:17:10.46,0:17:12.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin melakukan banyak hal.
Dialogue: 0,0:17:12.46,0:17:16.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga ingin kau menikmati\Nsemuanya bersamaku!
Dialogue: 0,0:17:16.72,0:17:18.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu yang kuinginkan.
Dialogue: 0,0:17:18.40,0:17:19.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sato...
Dialogue: 0,0:17:19.86,0:17:24.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, rasanya aku tidak sabar\Nmenunggu hari esok.
Dialogue: 0,0:17:26.88,0:17:29.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini. Madoka yang memberikannya padaku.
Dialogue: 0,0:17:29.23,0:17:32.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Tunggu, ini...
Dialogue: 0,0:17:32.19,0:17:34.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jimat supaya cinta bertahan selamanya?
Dialogue: 0,0:17:34.94,0:17:35.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:17:36.26,0:17:41.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin membuat banyak kenangan\Nbersamamu selamanya.
Dialogue: 0,0:17:41.91,0:17:44.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh aku menguncinya di sini?
Dialogue: 0,0:17:44.10,0:17:45.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Te-Tentu saja!
Dialogue: 0,0:17:45.83,0:17:48.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga menginginkan hal yang sama!
Dialogue: 0,0:17:48.21,0:17:49.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah!
Dialogue: 0,0:17:52.87,0:17:53.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah.
Dialogue: 0,0:17:55.48,0:17:57.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga kita bisa melakukan semuanya\Nbersama, Sato.
Dialogue: 0,0:17:57.84,0:17:59.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga, Oshi...
Dialogue: 0,0:18:03.51,0:18:05.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sota.
Dialogue: 0,0:18:13.02,0:18:16.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, apa aku terlalu cepat\Nmemanggil nama depannya?
Dialogue: 0,0:18:16.83,0:18:18.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa dia marah?
Dialogue: 0,0:18:18.93,0:18:20.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}O-Oshio!
Dialogue: 0,0:18:20.60,0:18:22.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku bilang sesuatu yang aneh?
Dialogue: 0,0:18:23.78,0:18:25.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Kenapa kau mau lari?!
Dialogue: 0,0:18:25.74,0:18:26.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oshio...
Dialogue: 0,0:18:26.88,0:18:27.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah!
Dialogue: 0,0:18:43.73,0:18:49.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah "Oshio Sota" dan\N"oh, dia menjatuhkannya" terdengar mirip?
Dialogue: 0,0:18:49.67,0:18:50.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Shizuku?!
Dialogue: 0,0:18:50.72,0:18:52.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Mayo?! Rinka?!
Dialogue: 0,0:18:52.21,0:18:53.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat bersenang-senang!
Dialogue: 0,0:18:54.51,0:18:56.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, kalian berdua!
Dialogue: 0,0:18:56.13,0:18:58.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan kalah darimu!
Dialogue: 0,0:19:09.46,0:19:11.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kembali, berdua saja.
Dialogue: 0,0:19:11.35,0:19:12.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:20:59.49,0:21:01.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau harus melakukannya! Harus!
Dialogue: 0,0:21:01.16,0:21:03.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian harus datang lagi! Ya?!
Dialogue: 0,0:21:03.49,0:21:06.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ugh. Capek.
Dialogue: 0,0:21:07.10,0:21:09.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi lumayan seru.
Dialogue: 0,0:21:10.49,0:21:13.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau juga pasti capek, Leo.
Dialogue: 0,0:21:14.92,0:21:15.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:21:15.36,0:21:17.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei! Kau mau ke mana?!
Dialogue: 0,0:21:17.58,0:21:18.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo pulang!
Dialogue: 0,0:21:18.93,0:21:20.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei!
Dialogue: 0,0:21:25.18,0:21:27.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang benar saja!
Dialogue: 0,0:21:27.18,0:21:29.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku capek sekali...
Dialogue: 0,0:21:38.02,0:21:38.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:21:39.43,0:21:40.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ren?
Dialogue: 0,0:21:45.42,0:21:46.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ren...
Dialogue: 0,0:21:47.30,0:21:51.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, itu sudah selesai.\NSudah berakhir bertahun-tahun lalu.
Dialogue: 0,0:21:51.70,0:21:52.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu belum berakhir!
Dialogue: 0,0:21:55.17,0:21:57.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sendiri yang bilang, kalau kau diam saja,
Dialogue: 0,0:21:57.40,0:22:00.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}keadaan akan berubah\Nke arah yang bakal kau sesali.
Dialogue: 0,0:22:05.69,0:22:06.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ren!
Dialogue: 0,0:22:08.31,0:22:11.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedang apa kau di sini?
Dialogue: 0,0:22:13.63,0:22:16.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keretanya sudah mau datang.\NKau tidak akan sempat.
Dialogue: 0,0:22:17.72,0:22:20.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini memalukan sekali.
Dialogue: 0,0:22:20.54,0:22:25.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau membiarkannya tergantung,\Njadi aku datang untuk melepasnya.
Dialogue: 0,0:22:26.43,0:22:27.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini!
Dialogue: 0,0:22:32.36,0:22:33.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini...
Dialogue: 0,0:22:47.66,0:22:51.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah karatan parah,\Njadi kuncinya tidak bisa masuk.
Dialogue: 0,0:22:56.58,0:22:58.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Udaranya asin, sih.
Dialogue: 0,0:23:00.39,0:23:02.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti tidak enak tinggal di tepi laut.
Dialogue: 0,0:23:02.54,0:23:04.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, benar.
Dialogue: 0,0:23:04.43,0:23:07.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih satu setengah jam lagi\Nsampai kereta berikutnya.
Dialogue: 0,0:23:07.38,0:23:10.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serius? Desa memang menyebalkan.
Dialogue: 0,0:23:10.95,0:23:12.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kau mau ngapain?
Dialogue: 0,0:23:12.70,0:23:14.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entahlah.
Dialogue: 0,0:23:14.81,0:23:19.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak banyak yang bisa dilakukan.\NAyo kita mengobrol soal masa lalu.
Dialogue: 0,0:23:19.88,0:23:21.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, boleh.
Dialogue: 0,0:23:22.29,0:23:23.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku temani.
Dialogue: 0,0:23:25.21,0:23:26.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:23:35.03,0:23:37.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya, "Tak Bisa Berhenti Menyukainya".
Dialogue: 0,0:23:37.90,0:23:39.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan! Ini memalukan!
