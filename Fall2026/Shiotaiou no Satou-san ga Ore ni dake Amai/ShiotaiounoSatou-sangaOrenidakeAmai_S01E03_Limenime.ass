Dialogue: 0,0:02:12.17,0:02:13.65,sign,,0000,0000,0000,,"BIDIKAN 3: BERAKHIRNYA"
Dialogue: 0,0:02:13.65,0:02:15.09,sign,,0000,0000,0000,,"CINTA BERTEPUK SEBELAH TANGAN"
Dialogue: 0,0:14:07.27,0:14:09.10,sign,,0000,0000,0000,,REKAMAN EKSKLUSIF!\NSOPAN SANTUN DI RESTORAN KELUARGA?
Dialogue: 0,0:14:16.87,0:14:19.99,sign,,0000,0000,0000,,"REPUTASI JARINGAN RESTORAN TERCORENG"
Dialogue: 0,0:16:37.06,0:16:39.06,sign,,0000,0000,0000,,SATO KOHARU: MAU PERGI MINUM TEH SUSU BOBA\NSEPULANG SEKOLAH?
Dialogue: 0,0:16:51.63,0:16:53.07,sign,,0000,0000,0000,,"OSHIO SOTA: SATO"
Dialogue: 0,0:16:56.70,0:16:58.20,sign,,0000,0000,0000,,BEBERAPA MENIT SEBELUMNYA...
Dialogue: 0,0:17:35.44,0:17:37.44,sign,,0000,0000,0000,,OSHIO SOTA: AKU SUKA PADAMU, SATO
Dialogue: 0,0:18:20.91,0:18:23.38,sign,,0000,0000,0000,,"OSHIO SOTA: AKU SUKA PADAMU, SATO"
Dialogue: 0,0:18:23.38,0:18:25.36,sign,,0000,0000,0000,,OSHIO SOTA: AKU SUKA PADAMU, SATO
Dialogue: 0,0:21:28.01,0:21:30.01,sign,,0000,0000,0000,,PANGGILAN BERAKHIR
Dialogue: 0,0:22:02.00,0:22:05.04,sign,,0000,0000,0000,,BERSAMBUNG
Dialogue: 0,0:23:37.33,0:23:39.41,sign,,0000,0000,0000,,"SELANJUTNYA: SIHIR"
Dialogue: 0,0:00:04.60,0:00:05.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oshio! Oshio!
Dialogue: 0,0:00:06.83,0:00:09.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Ada apa, Sato?
Dialogue: 0,0:00:09.04,0:00:09.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat! Lihat!
Dialogue: 0,0:00:10.31,0:00:11.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat ini!
Dialogue: 0,0:00:11.15,0:00:12.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Indah sekali, 'kan?
Dialogue: 0,0:00:13.02,0:00:15.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, itu di Aomi.\NNaik kereta tidak jauh, kok.
Dialogue: 0,0:00:16.54,0:00:19.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, kau mau pergi hari Sabtu?
Dialogue: 0,0:00:19.65,0:00:20.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau ikut?
Dialogue: 0,0:00:21.14,0:00:23.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah berjanji tempo hari.
Dialogue: 0,0:00:23.95,0:00:27.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin pergi bersamamu.
Dialogue: 0,0:00:27.34,0:00:29.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hore!
Dialogue: 0,0:00:29.84,0:00:33.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, apa barusan aku\Nmembuat janji kencan dengan Oshio?
Dialogue: 0,0:00:51.52,0:00:53.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}The Cold Sato-san Is Only Sweet to Me
Dialogue: 0,0:02:12.17,0:02:13.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harga diri laki-laki
Dialogue: 0,0:02:13.65,0:02:15.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}memang tidak ada gunanya,
Dialogue: 0,0:02:15.09,0:02:16.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi bukan sesuatu\Nyang boleh dibuang begitu saja.
Dialogue: 0,0:02:16.94,0:02:22.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buang tanpa ragu\Nhanya demi wanita yang kau cintai.
Dialogue: 0,0:02:22.26,0:02:25.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bukan petuah orang bijak,
Dialogue: 0,0:02:25.41,0:02:28.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}melainkan kata-kata sahabatku, Misono Ren.
Dialogue: 0,0:02:28.44,0:02:31.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, sehari setelah mengucapkan itu,
Dialogue: 0,0:02:31.46,0:02:34.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia bersujud di depan mantan pacarnya\Nmemohon untuk balikan
Dialogue: 0,0:02:34.19,0:02:36.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan ditolak mentah-mentah\Ndengan cara paling kejam.
Dialogue: 0,0:02:36.36,0:02:40.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa pun itu, sekaranglah\Nsaatnya aku melakukannya.
Dialogue: 0,0:02:40.11,0:02:43.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi serius, incaranmu tinggi juga.
Dialogue: 0,0:02:43.62,0:02:45.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, memangnya semua orang tahu?
Dialogue: 0,0:02:45.93,0:02:49.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku mengincar Sato?
Dialogue: 0,0:02:49.86,0:02:50.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan itu.
Dialogue: 0,0:02:51.04,0:02:54.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua orang di kelas mengira\Nkau dan Sato sudah pacaran.
Dialogue: 0,0:02:54.77,0:02:55.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Argh!
Dialogue: 0,0:02:55.92,0:02:58.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan! Bagaimana kalau orang mengira
Dialogue: 0,0:02:58.53,0:03:01.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sato pacaran dengan cowok\Nyang tidak dia sukai?
Dialogue: 0,0:03:01.90,0:03:02.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:03:02.88,0:03:04.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bercanda, 'kan?
Dialogue: 0,0:03:04.71,0:03:06.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudmu?
Dialogue: 0,0:03:06.44,0:03:08.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, sudahlah.
Dialogue: 0,0:03:08.80,0:03:10.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, sudah sampai.
Dialogue: 0,0:03:11.34,0:03:13.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku biasa beli baju di sini.
Dialogue: 0,0:03:17.77,0:03:19.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luar biasa.
Dialogue: 0,0:03:20.04,0:03:20.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:03:21.67,0:03:22.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah.
Dialogue: 0,0:03:22.87,0:03:26.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepatu Tyrolean.\NKau belum pantas pakai ini.
Dialogue: 0,0:03:26.72,0:03:27.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:03:28.55,0:03:30.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang!
Dialogue: 0,0:03:30.53,0:03:32.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak, aku bawa pelanggan.
Dialogue: 0,0:03:32.80,0:03:34.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Ka-Kak?
Dialogue: 0,0:03:35.05,0:03:37.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar! Aku sudah\Ndengar semuanya dari Ren.
Dialogue: 0,0:03:37.95,0:03:40.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini, aku, Misono Shizuku,
Dialogue: 0,0:03:40.29,0:03:44.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan menyulapmu\Njadi pria paling keren seangkatanmu!
Dialogue: 0,0:03:44.12,0:03:45.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yappy!
Dialogue: 0,0:03:46.00,0:03:48.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Y-Yappy...
Dialogue: 0,0:03:49.07,0:03:50.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harga diri seorang wanita\Nsangatlah berharga.
Dialogue: 0,0:03:50.95,0:03:53.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bukan sesuatu\Nyang boleh dibuang begitu saja.
Dialogue: 0,0:03:53.38,0:03:57.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harus dibawa seumur hidup,\Ntak boleh lepas sedikit pun.
Dialogue: 0,0:03:57.66,0:04:00.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bukan petuah orang bijak,
Dialogue: 0,0:04:00.89,0:04:03.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}melainkan kata-kata ibuku, Sato Kiyomi.
Dialogue: 0,0:04:03.81,0:04:08.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketika aku menjawab,\N"Berarti Ibu memang suka pamer, ya,"
Dialogue: 0,0:04:08.38,0:04:10.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia menjitak kepalaku keras-keras.
Dialogue: 0,0:04:10.27,0:04:11.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolak kekerasan!
Dialogue: 0,0:04:11.50,0:04:15.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku meminta sepupuku, Rinka,\Nyang dua tahun lebih muda dariku,
Dialogue: 0,0:04:15.26,0:04:18.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk membantu memilihkan baju kencan...
Dialogue: 0,0:04:18.00,0:04:20.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunjukkan fotonya.
Dialogue: 0,0:04:20.17,0:04:20.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hmph.
Dialogue: 0,0:04:21.92,0:04:24.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh? Kalau begitu, kau tidak begitu yakin.
Dialogue: 0,0:04:24.32,0:04:26.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oshio benar-benar tampan!
Dialogue: 0,0:04:27.25,0:04:29.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh? Jadi, namanya Oshio?
Dialogue: 0,0:04:29.30,0:04:30.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah!
Dialogue: 0,0:04:32.22,0:04:34.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, jadi tipemu yang begini?
Dialogue: 0,0:04:34.45,0:04:36.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, kau suka dia.
Dialogue: 0,0:04:36.57,0:04:40.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lumayan ganteng. Tapi bukan tipeku.
Dialogue: 0,0:04:40.17,0:04:40.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini.
Dialogue: 0,0:04:42.78,0:04:45.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau kelihatan agak senang\Nwaktu kubilang dia ganteng.
Dialogue: 0,0:04:45.69,0:04:46.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah!
Dialogue: 0,0:04:46.31,0:04:48.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga saja dia\Ntidak cuma mengincar tubuhmu.
Dialogue: 0,0:04:48.89,0:04:51.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oshio bukan laki-laki seperti itu!
Dialogue: 0,0:04:51.10,0:04:52.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berisik.
Dialogue: 0,0:04:53.31,0:04:55.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah! Kak Mayo!
Dialogue: 0,0:04:56.40,0:04:59.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, Rinka. Selamat datang.
Dialogue: 0,0:04:59.30,0:05:00.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya kita belum pernah bertemu.
Dialogue: 0,0:05:00.74,0:05:02.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepupuku, Sato Koharu.
Dialogue: 0,0:05:02.43,0:05:05.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Langsung saja, bisa tolong\Npilihkan baju untuk hari pentingnya?
Dialogue: 0,0:05:05.92,0:05:07.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kencannya kali ini tidak boleh gagal.
Dialogue: 0,0:05:07.75,0:05:09.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, ya! Benar!
Dialogue: 0,0:05:10.06,0:05:13.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, ini penting sekali.
Dialogue: 0,0:05:15.54,0:05:18.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Nezu Mayo dari hidamari.
Dialogue: 0,0:05:18.11,0:05:20.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kupadupadankan bajumu.\NAyo kita cari!
Dialogue: 0,0:05:20.58,0:05:21.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yappy!
Dialogue: 0,0:05:22.27,0:05:24.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Y-Yappy...
Dialogue: 0,0:05:25.47,0:05:26.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana?
Dialogue: 0,0:05:26.42,0:05:27.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan yang ini.
Dialogue: 0,0:05:28.72,0:05:29.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana?
Dialogue: 0,0:05:29.94,0:05:31.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlalu maksa.
Dialogue: 0,0:05:32.46,0:05:33.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana?
Dialogue: 0,0:05:33.36,0:05:34.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bzzt!
Dialogue: 0,0:05:35.19,0:05:36.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana?!
Dialogue: 0,0:05:36.07,0:05:37.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bzzt!
Dialogue: 0,0:05:38.33,0:05:39.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana?!
Dialogue: 0,0:05:39.02,0:05:40.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bzzt! Bzzt!
Dialogue: 0,0:05:40.78,0:05:42.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian mempermainkanku, ya?
Dialogue: 0,0:05:42.85,0:05:45.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, kau mau pakai apa, Sota?!
Dialogue: 0,0:05:46.08,0:05:49.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kali ini saja, aku ingin tampil gaya!
Dialogue: 0,0:05:50.09,0:05:53.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin tampil pantas\Nagar tidak mempermalukan gadis yang kusukai
Dialogue: 0,0:05:53.83,0:05:55.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}saat aku di sampingnya.
Dialogue: 0,0:05:58.33,0:06:00.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak, kemeja yang itu masih ada?\NYang krem.
Dialogue: 0,0:06:00.71,0:06:04.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada. Kaus tanpa lengan putih juga.
Dialogue: 0,0:06:04.12,0:06:05.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bawahannya jins?
Dialogue: 0,0:06:05.64,0:06:07.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, kita padukan.
Dialogue: 0,0:06:08.35,0:06:11.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi... dari tadi aku memang dikerjai?
Dialogue: 0,0:06:14.98,0:06:16.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ambil yang ini!
Dialogue: 0,0:06:16.90,0:06:17.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:06:17.68,0:06:18.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membosankan.
Dialogue: 0,0:06:19.51,0:06:23.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Warna-warna nuansa alam lagi tren sekarang.\NKesannya juga dewasa.
Dialogue: 0,0:06:23.67,0:06:26.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Blusnya dari linen, jadi tetap sejuk.
Dialogue: 0,0:06:26.50,0:06:29.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kubuat siluet atas dan bawahnya\Nkontras. Bagaimana?
Dialogue: 0,0:06:30.06,0:06:31.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ambil yang ini!
Dialogue: 0,0:06:31.22,0:06:33.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku beli dan langsung kupakai pulang!
Dialogue: 0,0:06:39.90,0:06:43.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak untuk hari ini.\NSampai dikasih diskon segala...
Dialogue: 0,0:06:43.40,0:06:47.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah datang!\NSemoga sukses kencannya!
Dialogue: 0,0:06:48.87,0:06:49.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai jumpa, Sota.
Dialogue: 0,0:06:49.95,0:06:51.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Kau tidak pulang, Ren?
Dialogue: 0,0:06:52.32,0:06:55.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, ini toko ayahku,
Dialogue: 0,0:06:55.20,0:06:57.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan lantai atasnya rumahku.
Dialogue: 0,0:06:57.55,0:07:01.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak, aku mau main gim semalaman,\Njadi jangan ganggu aku.
Dialogue: 0,0:07:01.49,0:07:05.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ha! Siapa juga yang mau mengganggu\Nbocah menyebalkan sepertimu?
Dialogue: 0,0:07:09.47,0:07:11.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak untuk hari ini.
Dialogue: 0,0:07:11.80,0:07:13.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga semuanya lancar.
Dialogue: 0,0:07:13.53,0:07:15.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku masih mau di sini\Nmengobrol sebentar dengan Kak Mayo.
Dialogue: 0,0:07:15.93,0:07:18.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah. Lain kali\Naku akan berterima kasih lagi.
Dialogue: 0,0:07:18.43,0:07:19.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai jumpa.
Dialogue: 0,0:07:23.07,0:07:23.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?!
Dialogue: 0,0:07:24.56,0:07:26.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sato?
Dialogue: 0,0:07:26.22,0:07:27.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}O-Oshio?
Dialogue: 0,0:07:28.11,0:07:30.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pakaian kasual Oshio!
Dialogue: 0,0:07:30.38,0:07:33.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pilihan pakaian kasualnya juga...
Dialogue: 0,0:07:33.63,0:07:35.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Manis...\N- Keren...
Dialogue: 0,0:07:35.82,0:07:37.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa aku barusan mengucapkannya?!
Dialogue: 0,0:07:37.68,0:07:39.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke-Kenapa aku bilang begitu?!
Dialogue: 0,0:07:39.72,0:07:41.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya Oshio barusan bilang sesuatu...
Dialogue: 0,0:07:43.27,0:07:47.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke-Kebetulan sekali.\NA-Ada urusan apa ke sini?
Dialogue: 0,0:07:47.04,0:07:50.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau beli baju,\Njadi datang ke toko barang bekas ini...
Dialogue: 0,0:07:51.77,0:07:53.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}O-Oh, begitu...
Dialogue: 0,0:07:56.83,0:08:00.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sato manis sekali. Kesan dewasanya\Nbenar-benar cocok untuknya.
Dialogue: 0,0:08:01.53,0:08:05.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ragu apakah aku bisa\Njadi pasangan yang serasi untuknya.
Dialogue: 0,0:08:05.04,0:08:08.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku harus bilang padanya!
Dialogue: 0,0:08:09.10,0:08:10.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sa-Sato!
Dialogue: 0,0:08:11.24,0:08:13.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-A-A-Ada apa, Oshio?
Dialogue: 0,0:08:14.12,0:08:18.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baju itu cocok untukmu.\NKau manis sekali.
Dialogue: 0,0:08:19.69,0:08:20.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Doh!
Dialogue: 0,0:08:20.40,0:08:21.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Doh"?
Dialogue: 0,0:08:21.05,0:08:22.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?! Sato!
Dialogue: 0,0:08:27.33,0:08:29.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Aku senang sekali!\N- Tunggu... Sato?!
Dialogue: 0,0:08:29.54,0:08:33.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira kau bakal menganggap\Naku aneh dengan baju baru ini!
Dialogue: 0,0:08:33.45,0:08:37.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau juga ganteng sekali.\NKelihatan keren...
Dialogue: 0,0:08:37.53,0:08:38.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:08:40.03,0:08:41.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat senang.
Dialogue: 0,0:08:41.66,0:08:43.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu cowoknya Koharu?
Dialogue: 0,0:08:44.12,0:08:46.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Koharu ngapain, sih?
Dialogue: 0,0:08:48.54,0:08:50.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah! Topi Kak Mayo!
Dialogue: 0,0:08:52.95,0:08:54.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rinka!
Dialogue: 0,0:08:54.67,0:08:55.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:08:56.27,0:08:57.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil!
Dialogue: 0,0:09:05.39,0:09:06.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak apa-apa?
Dialogue: 0,0:09:07.63,0:09:10.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku baik-baik saja...
Dialogue: 0,0:09:11.14,0:09:13.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah. Bisa berdiri?
Dialogue: 0,0:09:18.33,0:09:21.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Anu, lenganmu...
Dialogue: 0,0:09:21.36,0:09:21.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah!
Dialogue: 0,0:09:21.88,0:09:23.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rinka!
Dialogue: 0,0:09:23.66,0:09:26.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf!\NAku sampai tidak bisa bergerak karena takut!
Dialogue: 0,0:09:26.90,0:09:29.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah! Syukurlah!
Dialogue: 0,0:09:29.31,0:09:31.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tu-Tunggu, Koharu, dia terluka...
Dialogue: 0,0:09:31.36,0:09:33.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku lega sekali...
Dialogue: 0,0:09:33.99,0:09:35.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau tidak apa-apa.
Dialogue: 0,0:09:36.30,0:09:38.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian berdua tidak apa-apa?
Dialogue: 0,0:09:40.04,0:09:42.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Mayo... Ini.
Dialogue: 0,0:09:42.41,0:09:44.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih. Kau tidak terluka?
Dialogue: 0,0:09:44.75,0:09:45.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak...
Dialogue: 0,0:09:46.72,0:09:47.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau...
Dialogue: 0,0:09:48.39,0:09:53.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau masuk dulu?\NBiar kujahit bajumu.
Dialogue: 0,0:09:54.44,0:09:56.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:09:56.13,0:09:58.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Koharu, kau juga perlu membersihkan diri.
Dialogue: 0,0:10:04.63,0:10:06.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku minta maaf!
Dialogue: 0,0:10:06.31,0:10:08.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku malah lari sembarangan...
Dialogue: 0,0:10:08.87,0:10:10.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rinka, 'kan?
Dialogue: 0,0:10:11.01,0:10:13.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah tidak bilang\Nkalau aku berdarah.
Dialogue: 0,0:10:14.38,0:10:17.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak ingin Sato mengkhawatirkanku.
Dialogue: 0,0:10:18.11,0:10:19.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, tapi...
Dialogue: 0,0:10:20.11,0:10:22.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah kau tak apa-apa.
Dialogue: 0,0:10:25.49,0:10:26.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:10:27.34,0:10:28.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin! Tidak mungkin! Tidak mungkin!
Dialogue: 0,0:10:28.91,0:10:30.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak! Tidak! Tidak!
Dialogue: 0,0:10:30.63,0:10:32.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jelas tidak!
Dialogue: 0,0:10:32.67,0:10:37.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia cinta pertama Koharu...
Dialogue: 0,0:10:40.63,0:10:42.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh aku tunggu di sini?
Dialogue: 0,0:10:43.14,0:10:47.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Butuh waktu untuk menjahit robekannya.
Dialogue: 0,0:10:47.11,0:10:48.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:10:48.51,0:10:51.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kau memang ingin melihatnya\Ncuma pakai pakaian dalam,
Dialogue: 0,0:10:51.02,0:10:52.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau boleh ikut masuk bersamaku.
Dialogue: 0,0:10:52.98,0:10:54.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?! Pakaian dalam...
Dialogue: 0,0:10:54.73,0:10:56.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku pulang sekarang!
Dialogue: 0,0:10:56.22,0:10:57.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, Rinka!
Dialogue: 0,0:10:57.78,0:10:58.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah...
Dialogue: 0,0:11:02.83,0:11:03.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka sudah pergi.
Dialogue: 0,0:11:04.83,0:11:06.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:11:06.24,0:11:07.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.
Dialogue: 0,0:11:07.87,0:11:10.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malah, aku yang berterima kasih padamu.
Dialogue: 0,0:11:10.61,0:11:12.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah menyelamatkan Rinka.
Dialogue: 0,0:11:13.37,0:11:16.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oshio, kau jatuh cinta pada Koharu, ya?
Dialogue: 0,0:11:16.15,0:11:17.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Bagaimana kau bisa tahu...
Dialogue: 0,0:11:17.76,0:11:19.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh!
Dialogue: 0,0:11:19.28,0:11:23.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa pun bisa langsung tahu.\NCuma Koharu yang tidak sadar.
Dialogue: 0,0:11:23.76,0:11:26.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be-Begitu, ya...
Dialogue: 0,0:11:26.04,0:11:27.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh!
Dialogue: 0,0:11:27.57,0:11:29.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya agak menyedihkan.
Dialogue: 0,0:11:30.59,0:11:31.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyedihkan?
Dialogue: 0,0:11:32.06,0:11:35.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Artinya, aku sebegitu tidak pentingnya\Nbaginya, 'kan?
Dialogue: 0,0:11:35.64,0:11:38.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai dia tidak sadar\Nbetapa aku menyukainya,
Dialogue: 0,0:11:38.77,0:11:40.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}padahal orang lain bisa.
Dialogue: 0,0:11:43.78,0:11:45.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, sudah beres.
Dialogue: 0,0:11:45.71,0:11:47.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:11:48.79,0:11:52.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yappy, Mayo! Malam ini\Nkita pesta anggur merah!
Dialogue: 0,0:11:52.41,0:11:53.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Kak Shizuku?
Dialogue: 0,0:11:53.81,0:11:56.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm? Sota? Sedang apa kau di sini?
Dialogue: 0,0:11:57.50,0:12:00.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga kalian saling kenal.
Dialogue: 0,0:12:00.20,0:12:01.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tahu?
Dialogue: 0,0:12:01.45,0:12:06.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Habis, semua bajunya dibeli di MOON.
Dialogue: 0,0:12:06.01,0:12:09.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sota ini temannya Ren!
Dialogue: 0,0:12:09.42,0:12:13.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, aku dan Mayo\Nsudah berteman baik sejak SD...
Dialogue: 0,0:12:13.14,0:12:15.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan ikut klub yang sama waktu kuliah.
Dialogue: 0,0:12:15.29,0:12:16.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yappy!
Dialogue: 0,0:12:16.68,0:12:18.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Y-Yappy...
Dialogue: 0,0:12:18.46,0:12:22.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sota, kau ikut pesta minum\Nbersama dua wanita cantik! Hore!
Dialogue: 0,0:12:22.45,0:12:24.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Aku masih di bawah umur...
Dialogue: 0,0:12:24.58,0:12:27.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak masalah!\NMinum soda atau apa saja!
Dialogue: 0,0:12:27.67,0:12:30.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, berangkat! Ke sisi gelap bulan!
Dialogue: 0,0:12:30.12,0:12:31.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo berangkat, Sota!
Dialogue: 0,0:12:31.34,0:12:32.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa?!
Dialogue: 0,0:12:33.25,0:12:36.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus tutup toko dulu.\NKalian mulai duluan saja.
Dialogue: 0,0:12:37.37,0:12:39.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rinka, kau ikut ke pesta juga?
Dialogue: 0,0:12:43.19,0:12:45.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak.
Dialogue: 0,0:12:45.19,0:12:48.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kembali\Ncuma untuk berterima kasih padanya.
Dialogue: 0,0:12:48.93,0:12:50.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan pulang sekarang.
Dialogue: 0,0:12:51.28,0:12:53.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayang sekali.\NPadahal Oshio ikut, lo.
Dialogue: 0,0:12:53.85,0:12:56.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu-Bukan urusanku!
Dialogue: 0,0:12:56.46,0:12:58.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh?
Dialogue: 0,0:12:58.22,0:12:59.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bisa minta nomornya.
Dialogue: 0,0:12:59.96,0:13:01.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke-Kenapa?!
Dialogue: 0,0:13:01.96,0:13:04.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau ingin tahu lebih banyak\Ntentang dia, 'kan?
Dialogue: 0,0:13:06.19,0:13:09.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-A-Aku tidak akan pernah jatuh cinta\Npada Kak Oshio seumur hidupku!
Dialogue: 0,0:13:10.42,0:13:13.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rinka, kau jatuh cinta pada Oshio, ya?
Dialogue: 0,0:13:15.08,0:13:15.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:13:17.56,0:13:19.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pulang dulu!
Dialogue: 0,0:13:23.01,0:13:24.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pulang!
Dialogue: 0,0:13:26.46,0:13:29.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktunya benar-benar tidak tepat...
Dialogue: 0,0:13:29.42,0:13:30.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:13:33.33,0:13:36.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang, Koharu.\NKau pulang larut malam ini.
Dialogue: 0,0:13:36.37,0:13:40.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Ayah. Hari ini, Ayah pulang cepat.
Dialogue: 0,0:13:40.17,0:13:41.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah tidak lembur?
Dialogue: 0,0:13:42.79,0:13:46.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah tanya kenapa kau pulang selarut ini.
Dialogue: 0,0:13:46.81,0:13:52.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Se-Sepulang sekolah, aku pergi dengan\NRinka untuk beli baju, jadi...
Dialogue: 0,0:13:52.78,0:13:57.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rinka lebih muda darimu.\NKau mengajaknya keluar sampai selarut ini?
Dialogue: 0,0:13:58.48,0:13:59.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duduk.
Dialogue: 0,0:13:59.86,0:14:01.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Berita selanjutnya:\N- Ya...
Dialogue: 0,0:14:01.78,0:14:07.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}unggahan viral di media sosial\Nmenuai kritik keras.
Dialogue: 0,0:14:09.11,0:14:12.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tahu kenapa anak-anak perlu dididik?
Dialogue: 0,0:14:13.23,0:14:15.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Supaya bisa masuk universitas yang bagus?
Dialogue: 0,0:14:15.13,0:14:16.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan.
Dialogue: 0,0:14:16.87,0:14:19.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Supaya mereka tidak berakhir seperti ini.
Dialogue: 0,0:14:21.19,0:14:23.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manusia adalah binatang.
Dialogue: 0,0:14:23.58,0:14:25.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka budak hawa nafsunya sendiri.
Dialogue: 0,0:14:25.30,0:14:27.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, mereka perlu dididik.
Dialogue: 0,0:14:27.45,0:14:30.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak dididik dengan benar,\Nmereka akan berbuat seperti itu.
Dialogue: 0,0:14:30.33,0:14:34.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bocah ini terlalu asyik\Nmengunggah foto di internet
Dialogue: 0,0:14:34.85,0:14:36.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sampai merugikan orang lain.
Dialogue: 0,0:14:36.52,0:14:39.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia dan keluarganya akan menanggung malu\Nselama bertahun-tahun.
Dialogue: 0,0:14:42.51,0:14:46.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Koharu, kau masih anak-anak\Nyang belum bisa bertanggung jawab.
Dialogue: 0,0:14:47.36,0:14:49.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bertindak\Nsembarangan sampai merugikan
Dialogue: 0,0:14:49.65,0:14:52.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}orang-orang di sekitarmu\Natau dirimu sendiri.
Dialogue: 0,0:14:54.67,0:14:57.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, Sota,
Dialogue: 0,0:14:57.08,0:15:00.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ada foto? Foto pacarmu?
Dialogue: 0,0:15:00.00,0:15:01.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunjukkan wajahnya! Ayo!
Dialogue: 0,0:15:01.85,0:15:06.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa aku harus punya foto?\NLagi pula, kami belum pacaran!
Dialogue: 0,0:15:06.16,0:15:08.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku punya fotonya.
Dialogue: 0,0:15:08.88,0:15:11.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu salah satu karya terbaikku,\Njadi aku minta izin memotretnya.
Dialogue: 0,0:15:12.28,0:15:15.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, dia manis sekali!
Dialogue: 0,0:15:15.40,0:15:17.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tipe cantik yang keren?
Dialogue: 0,0:15:18.24,0:15:19.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia manis sekali.
Dialogue: 0,0:15:19.91,0:15:22.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah ciuman belum? Cium!
Dialogue: 0,0:15:22.81,0:15:24.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be-Belum!
Dialogue: 0,0:15:24.84,0:15:26.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan yang tanpa lidah?
Dialogue: 0,0:15:27.50,0:15:28.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum!
Dialogue: 0,0:15:28.76,0:15:29.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?!
Dialogue: 0,0:15:29.59,0:15:33.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shizuku, pengalamanmu sendiri\Nbelum banyak untuk bicara begitu.
Dialogue: 0,0:15:33.84,0:15:38.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengar, aku cuma mau menyemangati Sota\Nsupaya semuanya lancar!
Dialogue: 0,0:15:39.10,0:15:41.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau harus maju! Serang! Serang!
Dialogue: 0,0:15:41.54,0:15:44.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setiap orang punya\Nkecepatannya masing-masing.
Dialogue: 0,0:15:44.61,0:15:45.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh?
Dialogue: 0,0:15:45.54,0:15:50.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau masih saja sok polos!\NKau pasti tidak serius padanya!
Dialogue: 0,0:15:51.11,0:15:53.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya tidak boleh\Nseseorang sangat berhati-hati
Dialogue: 0,0:15:53.57,0:15:56.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}supaya tidak merepotkan\Natau menyakiti orang lain
Dialogue: 0,0:15:56.35,0:15:58.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}justru karena sangat memikirkannya?
Dialogue: 0,0:15:58.81,0:16:02.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa yang memintamu\Nuntuk tidak menyakitinya?
Dialogue: 0,0:16:02.98,0:16:04.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa yang meminta?
Dialogue: 0,0:16:04.41,0:16:06.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Repotkan saja dia!
Dialogue: 0,0:16:06.39,0:16:08.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dua orang menjalin hubungan,
Dialogue: 0,0:16:08.19,0:16:11.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pasti saling merepotkan, ikut campur,\Ndan saling menyakiti!
Dialogue: 0,0:16:11.62,0:16:14.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi itulah yang diinginkan semua orang!
Dialogue: 0,0:16:15.35,0:16:19.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau yakin bukan kau sendiri\Nyang tidak mau terluka?
Dialogue: 0,0:16:22.40,0:16:25.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duh, capek sekali.
Dialogue: 0,0:16:25.32,0:16:28.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memang salah karena pulang terlambat,
Dialogue: 0,0:16:28.63,0:16:31.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi Ayah bisa sedikit lebih lembut...
Dialogue: 0,0:16:32.27,0:16:35.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin dihibur Oshio.
Dialogue: 0,0:16:39.39,0:16:42.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Selamat malam"... Tidak...
Dialogue: 0,0:16:42.73,0:16:44.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Halo"...
Dialogue: 0,0:16:44.59,0:16:48.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau mungkin,\N"Aku tidak sabar menunggu kencan kita"?
Dialogue: 0,0:16:48.25,0:16:49.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kencan?!
Dialogue: 0,0:16:49.42,0:16:50.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Argh...
Dialogue: 0,0:16:50.35,0:16:51.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:16:51.63,0:16:53.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oshio?
Dialogue: 0,0:16:58.67,0:17:00.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sota!
Dialogue: 0,0:17:00.21,0:17:02.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ayolah, Sota!\N- Shizuku,
Dialogue: 0,0:17:02.58,0:17:04.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau terlalu memaksa.
Dialogue: 0,0:17:04.21,0:17:06.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi ini terlalu menyenangkan!
Dialogue: 0,0:17:06.95,0:17:10.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak usah didengarkan.\NDia sedang mabuk.
Dialogue: 0,0:17:10.96,0:17:13.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma tidak ingin menyakitinya...
Dialogue: 0,0:17:13.86,0:17:15.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, kau benar.
Dialogue: 0,0:17:16.50,0:17:18.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga tidak ingin menimbulkan masalah.
Dialogue: 0,0:17:23.34,0:17:25.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ponselku! Sejak kapan?!
Dialogue: 0,0:17:29.62,0:17:30.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:17:31.94,0:17:33.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, tunggu, tunggu!
Dialogue: 0,0:17:33.47,0:17:34.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya ini?
Dialogue: 0,0:17:37.44,0:17:39.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa ini yang namanya pernyataan cinta...
Dialogue: 0,0:17:44.07,0:17:45.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fokus! Fokus, Sato Koharu!
Dialogue: 0,0:17:45.99,0:17:48.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudnya pasti bukan "suka" sebagai\Nlawan jenis, tapi "like"!
Dialogue: 0,0:17:49.39,0:17:53.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku suka kalian semua!
Dialogue: 0,0:17:54.17,0:17:55.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa jadi!
Dialogue: 0,0:17:55.26,0:17:57.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau mungkin salah ketik?\NAtau koreksi otomatis?
Dialogue: 0,0:17:57.13,0:17:59.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sukar, suku, sukses, sukarela...
Dialogue: 0,0:17:59.96,0:18:01.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa jadi!
Dialogue: 0,0:18:01.12,0:18:02.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau dia salah kirim!
Dialogue: 0,0:18:02.39,0:18:04.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misalnya, terkirim ke Sato yang lain...
Dialogue: 0,0:18:05.92,0:18:07.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga saja bukan salah kirim!
Dialogue: 0,0:18:09.09,0:18:10.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi... kalau ini...
Dialogue: 0,0:18:11.65,0:18:13.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}benar-benar pernyataan cinta...
Dialogue: 0,0:18:14.68,0:18:16.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang sekali!
Dialogue: 0,0:18:17.41,0:18:18.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cintaku berbalas...
Dialogue: 0,0:18:18.74,0:18:20.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kami bakal mulai pacaran?
Dialogue: 0,0:18:20.91,0:18:23.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dan Oshio?
Dialogue: 0,0:18:27.11,0:18:29.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shizuku, apa yang kau lakukan?
Dialogue: 0,0:18:30.67,0:18:34.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kirim pesan ke Sato,\Nbilang "Aku suka padamu"! Cuma itu...
Dialogue: 0,0:18:35.79,0:18:37.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan "cuma itu"!
Dialogue: 0,0:18:39.83,0:18:40.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial! Sial! Sial!
Dialogue: 0,0:18:44.08,0:18:45.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harus kubalas!
Dialogue: 0,0:18:45.49,0:18:46.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi balas apa?
Dialogue: 0,0:18:47.19,0:18:49.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Aku juga suka padamu, Oshio"?
Dialogue: 0,0:18:49.26,0:18:52.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ta-Tapi bagaimana kalau semua itu\Ncuma khayalanku?
Dialogue: 0,0:18:52.21,0:18:52.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah!
Dialogue: 0,0:18:56.43,0:18:57.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sato!
Dialogue: 0,0:18:57.29,0:18:59.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}O-Oshio?
Dialogue: 0,0:19:02.83,0:19:04.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oshio?
Dialogue: 0,0:19:05.79,0:19:08.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau dibenci.\NApalagi oleh Sato!
Dialogue: 0,0:19:10.10,0:19:13.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf meneleponmu tiba-tiba.\NKau sedang sibuk?
Dialogue: 0,0:19:14.46,0:19:15.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:19:15.17,0:19:17.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, tidak, tidak apa-apa.
Dialogue: 0,0:19:17.49,0:19:19.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak sibuk sama sekali.
Dialogue: 0,0:19:19.26,0:19:23.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertemuan tadi benar-benar kebetulan, ya.
Dialogue: 0,0:19:23.44,0:19:26.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Y-Ya! Aku kaget sekali.
Dialogue: 0,0:19:26.40,0:19:29.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata kebetulan seperti itu...\Nbenar-benar bisa terjadi!
Dialogue: 0,0:19:31.49,0:19:34.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku tidak sabar menunggu hari Sabtu.
Dialogue: 0,0:19:34.59,0:19:38.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya! Sudah lama sekali\Naku tidak makan kakigori.
Dialogue: 0,0:19:38.78,0:19:41.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku suka Sato,\Ndan aku sedang bicara langsung dengannya.
Dialogue: 0,0:19:41.87,0:19:44.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kenapa rasanya sesakit ini?
Dialogue: 0,0:19:44.34,0:19:47.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Po-Pokoknya, aku tidak sabar.
Dialogue: 0,0:19:49.57,0:19:51.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oshio...
Dialogue: 0,0:19:51.67,0:19:52.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sato...
Dialogue: 0,0:19:52.81,0:19:53.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku minta maaf.
Dialogue: 0,0:19:54.59,0:19:56.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pesan tadi...
Dialogue: 0,0:19:56.82,0:19:59.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin pasti ada alasannya.
Dialogue: 0,0:19:59.99,0:20:03.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kau... kau tidak ingin menyakitiku,
Dialogue: 0,0:20:03.85,0:20:06.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi kau bingung\Nbagaimana menjelaskannya padaku.
Dialogue: 0,0:20:06.81,0:20:08.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak apa-apa!
Dialogue: 0,0:20:08.82,0:20:11.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak keberatan... sama sekali...
Dialogue: 0,0:20:12.63,0:20:13.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:20:13.94,0:20:16.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi mungkin aku\Ntidak bisa pergi makan kakigori...
Dialogue: 0,0:20:16.50,0:20:17.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak dalam keadaan begini...
Dialogue: 0,0:20:17.65,0:20:19.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benar-benar minta maaf...
Dialogue: 0,0:20:19.34,0:20:22.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau terus begini,\Nsemuanya akan benar-benar berakhir...
Dialogue: 0,0:20:22.07,0:20:24.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf. Sudah dulu, ya.
Dialogue: 0,0:20:24.08,0:20:25.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau ini berakhir!
Dialogue: 0,0:20:26.22,0:20:32.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sota, dengar.\NOtot tumbuh dengan cara terluka.
Dialogue: 0,0:20:32.88,0:20:35.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar! Kalau aku takut menyakitinya,
Dialogue: 0,0:20:35.79,0:20:38.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tidak akan pernah punya kesempatan\Nuntuk dekat dengannya!
Dialogue: 0,0:20:38.74,0:20:40.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat malam.
Dialogue: 0,0:20:40.01,0:20:41.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sato!
Dialogue: 0,0:20:41.63,0:20:42.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya?
Dialogue: 0,0:20:43.06,0:20:45.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin minta maaf soal sesuatu.
Dialogue: 0,0:20:45.62,0:20:49.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan, Oshio, aku tidak mau mendengarnya!
Dialogue: 0,0:20:49.40,0:20:53.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf aku menyatakan perasaan lewat pesan!\NItu tindakan pengecut!
Dialogue: 0,0:20:53.05,0:20:54.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menyatakannya lagi dengan benar.
Dialogue: 0,0:20:54.77,0:20:55.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?!
Dialogue: 0,0:20:56.23,0:20:59.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku suka padamu, Sato.
Dialogue: 0,0:20:59.91,0:21:01.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bukan lelucon atau salah kirim.
Dialogue: 0,0:21:01.93,0:21:03.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku suka padamu, Sato.
Dialogue: 0,0:21:03.78,0:21:05.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai lawan jenis.
Dialogue: 0,0:21:05.44,0:21:06.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:21:06.63,0:21:09.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah menyukaimu\Nsejak pertama kali kita bertemu.
Dialogue: 0,0:21:10.21,0:21:13.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat kau tersenyum,\Nsaat kau marah, saat kau menangis,
Dialogue: 0,0:21:13.96,0:21:16.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bahkan saat kau terlalu bersemangat...
Dialogue: 0,0:21:16.75,0:21:18.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku suka semuanya.
Dialogue: 0,0:21:19.39,0:21:22.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sato Koharu, aku suka padamu.
Dialogue: 0,0:21:26.69,0:21:27.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suara air?
Dialogue: 0,0:21:33.15,0:21:35.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Bagaimana, Sota?
Dialogue: 0,0:21:35.04,0:21:37.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jawabannya! Apa jawabannya?!
Dialogue: 0,0:21:37.62,0:21:38.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Panggilan berakhir?
Dialogue: 0,0:21:38.66,0:21:40.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Apa yang terjadi?
Dialogue: 0,0:21:40.76,0:21:41.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oshio?!
Dialogue: 0,0:21:42.52,0:21:45.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Koharu, mau sampai kapan kau di kamar mandi?
Dialogue: 0,0:21:46.09,0:21:48.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak keluar, kau bisa matang...
Dialogue: 0,0:21:48.61,0:21:50.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hidup-hidup!
Dialogue: 0,0:21:50.78,0:21:53.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya ampun, putriku ini bodoh sekali, sih.
Dialogue: 0,0:21:53.99,0:21:58.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku... juga suka padamu... Oshio...
Dialogue: 0,0:23:35.47,0:23:37.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya, "Sihir".
Dialogue: 0,0:23:37.33,0:23:39.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga harus berani!
