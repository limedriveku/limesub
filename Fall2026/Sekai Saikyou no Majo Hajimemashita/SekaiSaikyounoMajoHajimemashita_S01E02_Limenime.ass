Dialogue: 0,0:00:09.33,0:00:09.66,sign,,0000,0000,0000,,MENGHUBUNGKAN
Dialogue: 0,0:00:29.51,0:00:30.37,sign,,0000,0000,0000,,SEPATU BABI PENERJANG, RANK B
Dialogue: 0,0:00:35.33,0:00:37.67,sign,,0000,0000,0000,,"SEPATU BABI PENERJANG, RANK B"
Dialogue: 0,0:00:37.67,0:00:38.08,sign,,0000,0000,0000,,PERTAHANAN +80, KECEPATAN +300
Dialogue: 0,0:00:38.09,0:00:40.92,sign,,0000,0000,0000,,"SKILL PERLENGKAPAN: TERJANG MEMBABI, RANK B"
Dialogue: 0,0:00:40.92,0:00:43.02,sign,,0000,0000,0000,,"DESKRIPSI: DIJATUHKAN OLEH PENGUASA HUTAN"
Dialogue: 0,0:00:58.70,0:00:59.26,sign,,0000,0000,0000,,SAAT SKILLNYA DIGUNAKAN,\NKECEPATAN GERAK JADI DUA KALI LIPAT
Dialogue: 0,0:01:04.73,0:01:05.50,sign,,0000,0000,0000,,TAPI PENGGUNA TIDAK BISA BERHENTI\NSAMPAI SKILLNYA DIBATALKAN
Dialogue: 0,0:01:12.43,0:01:12.86,sign,,0000,0000,0000,,TAK SABAR...
Dialogue: 0,0:01:19.35,0:01:20.98,sign,,0000,0000,0000,,"SKILL: TERJANG MEMBABI"
Dialogue: 0,0:01:24.14,0:01:24.75,sign,,0000,0000,0000,,KECEPATAN: 692
Dialogue: 0,0:01:24.76,0:01:26.62,sign,,0000,0000,0000,,"LORNA LENGAH"
Dialogue: 0,0:01:26.62,0:01:28.16,sign,,0000,0000,0000,,"BERKAT KENAIKAN LEVEL DAN EFEK PERLENGKAPANNYA"
Dialogue: 0,0:01:28.16,0:01:28.78,sign,,0000,0000,0000,,KECEPATANNYA NAIK DARI 6 KE 346,\NLALU BERLIPAT GANDA KARENA EFEK SKILL
Dialogue: 0,0:03:09.63,0:03:10.08,sign,,0000,0000,0000,,EPISODE 2:\NAKU MENCOBA JADI PETUALANG!
Dialogue: 0,0:05:12.29,0:05:14.08,sign,,0000,0000,0000,,"DEG"
Dialogue: 0,0:10:52.42,0:10:54.42,sign,,0000,0000,0000,,KOTA IFONE
Dialogue: 0,0:11:03.56,0:11:03.90,sign,,0000,0000,0000,,QUEST SAMPINGAN: PENJAGA GERBANG\NYANG LUTUTNYA TERKENA PANAH
Dialogue: 0,0:11:16.45,0:11:17.15,sign,,0000,0000,0000,,DESKRIPSI: MAKANAN KHAS KOTA IFONE\NMEMULIHKAN 10 HP DAN 10 MP
Dialogue: 0,0:11:30.17,0:11:32.17,sign,,0000,0000,0000,,LORNA MEMILIH BERPURA-PURA\NTIDAK MELIHAT APA PUN
Dialogue: 0,0:12:21.43,0:12:21.99,sign,,0000,0000,0000,,PUNYA UANG 300 SHIL, DIKURANGI 200 SHIL
Dialogue: 0,0:12:26.70,0:12:27.25,sign,,0000,0000,0000,,SISA 100 SHIL
Dialogue: 0,0:13:08.27,0:13:10.27,sign,,0000,0000,0000,,SERIKAT PETUALANG IFONE
Dialogue: 0,0:13:35.09,0:13:37.36,sign,,0000,0000,0000,,"LORNA MENABRAK ORANG"
Dialogue: 0,0:13:37.36,0:13:39.42,sign,,0000,0000,0000,,"SAAT BERJALAN AGAK CEPAT"
Dialogue: 0,0:15:32.83,0:15:34.08,sign,,0000,0000,0000,,PESERTA UJIAN: LORNA HERMIT
Dialogue: 0,0:17:44.17,0:17:45.10,sign,,0000,0000,0000,,INI CUMA JUS IPPLE, KOK
Dialogue: 0,0:21:32.47,0:21:32.88,sign,,0000,0000,0000,,KEHIDUPAN ELITE
Dialogue: 0,0:00:00.47,0:00:03.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan pernah mengaku\Nsebagai anggota keluarga Gugglekars.
Dialogue: 0,0:00:03.93,0:00:06.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Matilah telantar di hutan ini.
Dialogue: 0,0:00:06.16,0:00:08.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?!
Dialogue: 0,0:00:10.91,0:00:13.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski aku diusir karena terlalu lemah,
Dialogue: 0,0:00:13.83,0:00:16.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sekarang, aku menguasai\Nskill bernama Internet,
Dialogue: 0,0:00:17.98,0:00:20.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan aku tiba-tiba jadi kuat?!
Dialogue: 0,0:00:22.80,0:00:25.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ambil batu sihirnya dulu, ah.
Dialogue: 0,0:00:25.93,0:00:26.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu.
Dialogue: 0,0:00:27.89,0:00:29.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Muncul sesuatu.
Dialogue: 0,0:00:30.38,0:00:31.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:00:31.26,0:00:33.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok bisa, sih?
Dialogue: 0,0:00:33.38,0:00:35.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa sudah berwujud barang jadi?
Dialogue: 0,0:00:35.33,0:00:37.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, cukup kuat pula.
Dialogue: 0,0:00:38.09,0:00:40.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, kebetulan sepatuku rusak,
Dialogue: 0,0:00:40.92,0:00:43.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi aku syukuri saja rezeki ini.
Dialogue: 0,0:00:44.00,0:00:46.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sip, dapat barang bagus, nih.
Dialogue: 0,0:00:47.36,0:00:51.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika dapat barang bagus,\Nhati pun jadi riang gembira.
Dialogue: 0,0:00:51.51,0:00:53.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, mulai dari tongkat sihir SSS ini,
Dialogue: 0,0:00:53.51,0:00:57.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku dapat semuanya dengan mudah,\Nsampai-sampai rasanya agak hambar.
Dialogue: 0,0:00:57.73,0:00:58.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baca dulu, ah.
Dialogue: 0,0:00:59.26,0:01:02.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepatu ini punya skill\Nbernama "Terjang Membabi".
Dialogue: 0,0:01:02.78,0:01:04.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Efeknya bisa menggandakan\Nkecepatan gerak pemakainya.
Dialogue: 0,0:01:05.50,0:01:08.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi tidak bisa berhenti\Nsampai skillnya dibatalkan.
Dialogue: 0,0:01:08.84,0:01:11.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, di Internet tertulis "bermanfaat".
Dialogue: 0,0:01:12.87,0:01:16.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mumpung punya, aku coba pakai sebentar, ah.
Dialogue: 0,0:01:17.96,0:01:18.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah!
Dialogue: 0,0:01:19.35,0:01:20.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terjang Membabi!
Dialogue: 0,0:01:24.76,0:01:26.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini terlalu cepat!
Dialogue: 0,0:01:26.62,0:01:28.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?!
Dialogue: 0,0:01:28.78,0:01:30.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhenti!
Dialogue: 0,0:01:30.80,0:01:31.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Batalkan skill!
Dialogue: 0,0:01:35.71,0:01:37.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, aku sampai di kota!
Dialogue: 0,0:02:08.36,0:02:14.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Memulai Hidup\NSebagai Penyihir Terkuat di Dunia
Dialogue: 0,0:03:10.09,0:03:11.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:03:12.02,0:03:14.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang terjadi di Hutan Ipple?
Dialogue: 0,0:03:15.44,0:03:19.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, penjaga gerbang seperti kita\Ntidak bisa berbuat apa-apa soal itu.
Dialogue: 0,0:03:19.09,0:03:20.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Percuma saja memikirkannya.
Dialogue: 0,0:03:21.09,0:03:24.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau jadi petualang,\Nmungkin kita bisa memeriksanya.
Dialogue: 0,0:03:26.20,0:03:27.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Nak Rei.
Dialogue: 0,0:03:28.71,0:03:30.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.
Dialogue: 0,0:03:31.64,0:03:35.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, aku ingin berhenti\Njadi penjaga gerbang hari ini.
Dialogue: 0,0:03:36.13,0:03:40.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awalnya, aku memilih pekerjaan ini\Nkarena aku suka melihat dunia luar.
Dialogue: 0,0:03:41.13,0:03:45.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, begitu mendengar\Nkisah perjalanan dari pelancong,
Dialogue: 0,0:03:45.66,0:03:47.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku merasa tersiksa.
Dialogue: 0,0:03:48.53,0:03:53.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan mantan dokter istana pun\Ntidak bisa menyembuhkan lututku.
Dialogue: 0,0:03:54.07,0:03:58.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pernah dipanggil\NReinharte Highwind si Angin Kilat,
Dialogue: 0,0:03:59.82,0:04:02.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku tidak bisa jadi petualang lagi.
Dialogue: 0,0:04:02.84,0:04:04.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nak Rei.
Dialogue: 0,0:04:04.64,0:04:06.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah waktunya istirahat siang, kan?
Dialogue: 0,0:04:07.78,0:04:09.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan istirahat duluan, Pak Wol.
Dialogue: 0,0:04:10.71,0:04:11.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:04:18.01,0:04:20.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga sudah terlalu dewasa\Nuntuk dipanggil "Nak Rei".
Dialogue: 0,0:04:20.82,0:04:24.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan segera berkeluarga\Ndan jauh dari dunia petualang...
Dialogue: 0,0:04:24.58,0:04:26.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alamak!
Dialogue: 0,0:04:26.96,0:04:28.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, duh.
Dialogue: 0,0:04:31.13,0:04:33.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa kamu baik-baik saja?
Dialogue: 0,0:04:34.04,0:04:36.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya aku baik-baik saja.
Dialogue: 0,0:04:36.87,0:04:39.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan, kamu dari Hutan Ipple?
Dialogue: 0,0:04:39.59,0:04:41.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Be-Benar.
Dialogue: 0,0:04:41.84,0:04:44.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kagum kamu selamat sampai sini.
Dialogue: 0,0:04:44.89,0:04:46.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya ada apa?
Dialogue: 0,0:04:46.73,0:04:48.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat saja sendiri!
Dialogue: 0,0:04:48.82,0:04:52.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah terjadi bencana alam\Nsejak kemarin di hutan itu?
Dialogue: 0,0:04:54.02,0:04:58.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Itu bukan aku!\NAku tidak bersalah!
Dialogue: 0,0:04:58.07,0:04:58.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:04:58.87,0:05:00.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, tidak.
Dialogue: 0,0:05:00.49,0:05:03.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}O-Oh? Begitu, ya.
Dialogue: 0,0:05:03.96,0:05:06.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak menyadarinya.\NSeram sekali.
Dialogue: 0,0:05:07.38,0:05:09.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa dia akan baik-baik saja?
Dialogue: 0,0:05:09.91,0:05:12.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu punya tanda pengenal?
Dialogue: 0,0:05:12.29,0:05:14.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, tanda pengenal?
Dialogue: 0,0:05:14.38,0:05:17.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku tidak bisa masuk kota tanpa itu?
Dialogue: 0,0:05:17.00,0:05:21.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, prosedurnya cuma\Njadi sedikit lebih merepotkan.
Dialogue: 0,0:05:21.11,0:05:24.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama, apa kamu bersedia\Nmenyentuh tablet status ini?
Dialogue: 0,0:05:24.53,0:05:27.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk memastikan kamu bersih\Ndari catatan kriminal.
Dialogue: 0,0:05:27.40,0:05:28.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, iya.
Dialogue: 0,0:05:32.00,0:05:34.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, Lorna Hermit.
Dialogue: 0,0:05:35.58,0:05:37.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Level 22?
Dialogue: 0,0:05:37.42,0:05:40.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah ini level petualang veteran?
Dialogue: 0,0:05:40.53,0:05:42.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}He-Hebat sekali untuk usia segitu.
Dialogue: 0,0:05:44.47,0:05:46.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?! MP-mu mencapai 90000?
Dialogue: 0,0:05:47.96,0:05:49.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa sebenarnya gadis ini?
Dialogue: 0,0:05:49.87,0:05:53.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mu-Mungkin tablet statusnya rusak.
Dialogue: 0,0:05:53.11,0:05:55.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma pelancong biasa, kok.
Dialogue: 0,0:05:55.98,0:05:58.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}O-Oh, benar juga.
Dialogue: 0,0:05:58.47,0:06:01.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika statusmu seperti ini,\Nkamu pasti bukan manusia.
Dialogue: 0,0:06:02.90,0:06:04.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul.
Dialogue: 0,0:06:05.00,0:06:07.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya aku bukan manusia.
Dialogue: 0,0:06:07.10,0:06:09.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya kamu bersih\Ndari catatan kriminal.
Dialogue: 0,0:06:09.29,0:06:12.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu boleh masuk\Nsetelah membayar tarif gerbang 200 shil.
Dialogue: 0,0:06:12.42,0:06:13.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:06:14.82,0:06:18.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu akan terus bepergian?
Dialogue: 0,0:06:19.53,0:06:22.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, begitulah rencanaku.
Dialogue: 0,0:06:22.00,0:06:26.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, sebaiknya kamu\Nmendaftar ke Serikat Petualang.
Dialogue: 0,0:06:26.20,0:06:27.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Petualang?
Dialogue: 0,0:06:28.38,0:06:32.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah itu tempatnya\Norang-orang berotot kekar?
Dialogue: 0,0:06:33.73,0:06:36.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belakangan ini ada banyak\Nanggota perempuan sepertimu.
Dialogue: 0,0:06:36.96,0:06:40.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kartu petualang bisa menjadi tanda pengenal,
Dialogue: 0,0:06:40.07,0:06:42.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi tidak ada ruginya mendaftar.
Dialogue: 0,0:06:42.98,0:06:46.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kesulitan uang,\Nkamu juga bisa cari kerja di sana.
Dialogue: 0,0:06:46.29,0:06:47.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh.
Dialogue: 0,0:06:47.51,0:06:50.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan yang paling penting,\Nurusan pajak jadi lebih mudah.
Dialogue: 0,0:06:50.56,0:06:53.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pajak itu masalah paling\Nmerepotkan saat bepergian,
Dialogue: 0,0:06:53.71,0:06:55.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kalau jadi anggota serikat,
Dialogue: 0,0:06:55.53,0:06:58.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu bisa bayar pajak\Nlewat pemotongan imbalan.
Dialogue: 0,0:06:58.49,0:07:01.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak perlu repot-repot\Nmemeriksa sistem pajak tiap kota,
Dialogue: 0,0:07:01.09,0:07:03.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan bebas dari rasa takut\Nditangkap karena lupa bayar.
Dialogue: 0,0:07:03.47,0:07:05.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu saja sudah cukup bermanfaat.
Dialogue: 0,0:07:05.89,0:07:07.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be-Begitu, ya.
Dialogue: 0,0:07:08.29,0:07:11.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku akan\Nke Serikat Petualang dulu.
Dialogue: 0,0:07:11.98,0:07:14.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, itu keputusan yang tepat.
Dialogue: 0,0:07:15.73,0:07:17.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi iri padanya.
Dialogue: 0,0:07:18.56,0:07:20.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai sekarang, dia akan jadi petualang,
Dialogue: 0,0:07:20.73,0:07:23.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan mengalami banyak hal menakjubkan.
Dialogue: 0,0:07:26.04,0:07:27.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong.
Dialogue: 0,0:07:27.59,0:07:30.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sangat paham soal petualang, ya?
Dialogue: 0,0:07:31.56,0:07:32.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitulah.
Dialogue: 0,0:07:32.72,0:07:36.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga pernah jadi petualang,
Dialogue: 0,0:07:36.84,0:07:39.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi lututku kena panah.
Dialogue: 0,0:07:41.11,0:07:42.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lutut?
Dialogue: 0,0:07:43.78,0:07:45.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:07:45.03,0:07:47.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, tidak. Bukan apa-apa.
Dialogue: 0,0:07:50.69,0:07:51.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Petit Heal!
Dialogue: 0,0:07:58.60,0:07:59.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa yang kamu lakukan?
Dialogue: 0,0:08:00.75,0:08:01.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:08:01.87,0:08:06.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, tidak. Ini cuma sihir penyembuh kecil\Nsebagai balas budi atas informasimu.
Dialogue: 0,0:08:06.33,0:08:08.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}E-Ehem!
Dialogue: 0,0:08:08.49,0:08:12.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga lututmu lekas sembuh, Reinharte.
Dialogue: 0,0:08:12.98,0:08:14.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:08:16.02,0:08:17.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa dia tahu namaku?
Dialogue: 0,0:08:18.00,0:08:20.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku masuk kota dulu.
Dialogue: 0,0:08:20.76,0:08:22.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, silakan.
Dialogue: 0,0:08:23.38,0:08:24.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang
Dialogue: 0,0:08:25.56,0:08:27.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di Kota Ifone.
Dialogue: 0,0:08:27.38,0:08:29.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kota ini menyambutmu.
Dialogue: 0,0:08:30.38,0:08:31.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih!
Dialogue: 0,0:08:34.00,0:08:37.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa ini terakhir kalinya\Naku melepas kepergian petualang.
Dialogue: 0,0:08:38.17,0:08:40.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Nak Rei!
Dialogue: 0,0:08:40.82,0:08:43.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau juga istirahatlah.
Dialogue: 0,0:08:43.03,0:08:44.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:08:44.93,0:08:50.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya.\NSepertinya tablet statusnya rusak.
Dialogue: 0,0:08:50.13,0:08:52.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hmm? Apa sudah waktunya diganti?
Dialogue: 0,0:08:52.80,0:08:55.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, benda beginian sih\Nbisa normal lagi kalau dipukul.
Dialogue: 0,0:08:56.40,0:08:57.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuharap lututku juga.
Dialogue: 0,0:08:59.22,0:09:02.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudahlah. Aku tak perlu berpikir\Nmacam-macam.
Dialogue: 0,0:09:03.93,0:09:04.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Loh?
Dialogue: 0,0:09:05.53,0:09:07.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tablet ini tidak rusak, kok.
Dialogue: 0,0:09:10.02,0:09:11.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:09:11.62,0:09:15.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga lututmu lekas sembuh, Reinharte.
Dialogue: 0,0:09:19.96,0:09:21.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nak Rei?
Dialogue: 0,0:09:24.82,0:09:26.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakiku...
Dialogue: 0,0:09:27.07,0:09:28.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak sakit...
Dialogue: 0,0:09:29.26,0:09:31.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakiku bisa bergerak normal.
Dialogue: 0,0:09:41.87,0:09:44.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, begitu rupanya.
Dialogue: 0,0:09:45.29,0:09:48.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata duniaku seluas ini
Dialogue: 0,0:09:48.64,0:09:51.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan anginnya terasa sesejuk ini.
Dialogue: 0,0:09:54.24,0:09:58.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa pergi ke mana saja di dunia ini.
Dialogue: 0,0:09:59.84,0:10:01.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih jauh lagi.
Dialogue: 0,0:10:04.16,0:10:06.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan sampai melewati cakrawala.
Dialogue: 0,0:10:08.27,0:10:10.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kenapa?
Dialogue: 0,0:10:10.42,0:10:11.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa lututmu sakit?
Dialogue: 0,0:10:12.04,0:10:14.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, bukan.
Dialogue: 0,0:10:15.38,0:10:16.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat senang.
Dialogue: 0,0:10:17.60,0:10:19.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau benar-benar sudah bisa berjalan, ya.
Dialogue: 0,0:10:20.53,0:10:22.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, apa yang terjadi?
Dialogue: 0,0:10:22.53,0:10:23.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak tahu.
Dialogue: 0,0:10:24.69,0:10:28.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma ada gadis misterius\Nyang memberiku sihir penyembuh.
Dialogue: 0,0:10:29.53,0:10:30.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pak Wol.
Dialogue: 0,0:10:31.40,0:10:34.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku bisa jadi petualang lagi?
Dialogue: 0,0:10:35.91,0:10:39.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, tentu saja bisa!\NIni adalah mukjizat!
Dialogue: 0,0:10:40.44,0:10:42.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dewa telah menyembuhkanmu!
Dialogue: 0,0:10:45.69,0:10:48.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin itu benar.
Dialogue: 0,0:10:50.31,0:10:51.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:10:54.84,0:10:57.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, aku tadi panik.
Dialogue: 0,0:10:57.16,0:10:59.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya bermaksud\Nmenggunakan sihir penyembuh,
Dialogue: 0,0:10:59.87,0:11:03.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi siapa sangka sihirnya\Nkelihatan semenyilaukan itu.
Dialogue: 0,0:11:03.91,0:11:07.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan masalah pribadi\Norang pun bisa diketahui.
Dialogue: 0,0:11:07.33,0:11:09.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Internet memang seram.
Dialogue: 0,0:11:09.67,0:11:13.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, untung saja aku sudah\Nmengumpulkan informasi dulu.
Dialogue: 0,0:11:13.76,0:11:15.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saatnya cari jajanan yang sudah kutandai.
Dialogue: 0,0:11:17.16,0:11:20.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pai ipple khas kota ini.\NSeperti apa rasanya, ya?
Dialogue: 0,0:11:24.33,0:11:26.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kota ini sudah tidak aman!\NAyo lari!
Dialogue: 0,0:11:26.92,0:11:29.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada bencana alam di Hutan Ipple!
Dialogue: 0,0:11:32.18,0:11:33.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, itu dia!
Dialogue: 0,0:11:34.07,0:11:35.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pai ipple khas kota ini!
Dialogue: 0,0:11:36.00,0:11:37.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beli satu!
Dialogue: 0,0:11:37.09,0:11:39.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Ah, iya.
Dialogue: 0,0:11:39.02,0:11:42.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tenang sekali\Ndi situasi kacau begini, Nona.
Dialogue: 0,0:11:42.36,0:11:44.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, aku sudah terbiasa.
Dialogue: 0,0:11:45.89,0:11:48.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini pertama kalinya aku jajan.
Dialogue: 0,0:11:49.00,0:11:50.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat makan!
Dialogue: 0,0:11:51.33,0:11:53.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Panas! Panas!
Dialogue: 0,0:11:54.38,0:11:57.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sari buahnya menyebar di mulut.
Dialogue: 0,0:11:57.49,0:12:01.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Disertai rasa manis yang lembut\Ndan rasa asam yang menyegarkan.
Dialogue: 0,0:12:01.51,0:12:03.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kulit luarnya begitu renyah.
Dialogue: 0,0:12:04.42,0:12:08.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aroma mentega dan kayu manisnya\Nmenggelitik hidung.
Dialogue: 0,0:12:10.13,0:12:11.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak!
Dialogue: 0,0:12:13.07,0:12:16.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di rumah, aku tidak pernah\Nmendapatkan makanan enak.
Dialogue: 0,0:12:16.00,0:12:18.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pun tidak bisa jajan begini.
Dialogue: 0,0:12:19.24,0:12:21.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bepergian itu asyik banget.
Dialogue: 0,0:12:22.00,0:12:23.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah jajan,
Dialogue: 0,0:12:23.62,0:12:26.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}uangku tinggal 100 shil,\Ntapi aku tidak menyesal...
Dialogue: 0,0:12:27.58,0:12:30.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ga-Gawat!\NTidak cukup buat sewa penginapan!
Dialogue: 0,0:12:31.02,0:12:33.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ada jalan pintas buat dapat uang, ya?
Dialogue: 0,0:12:33.73,0:12:38.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Trading forex? Mata uang kripto?\NJudi online?
Dialogue: 0,0:12:38.93,0:12:43.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Aku bisa dapat uang\Njika menekan ini sekarang?!
Dialogue: 0,0:12:43.33,0:12:47.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja sampingan yang menghasilkan\Nsejuta sebulan tanpa keahlian, ya?
Dialogue: 0,0:12:47.04,0:12:51.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika modalnya hanya buku murah,\Nsepertinya ini menguntungkan.
Dialogue: 0,0:12:53.80,0:12:57.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Internet itu bisa bikin lupa waktu.
Dialogue: 0,0:12:57.84,0:13:01.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama, aku harus menjual\Nmaterial yang kubawa seperlunya
Dialogue: 0,0:13:01.00,0:13:03.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan mengumpulkan uang sewa penginapan.
Dialogue: 0,0:13:03.49,0:13:07.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, mungkin daftar jadi petualang juga.
Dialogue: 0,0:13:10.80,0:13:13.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang terjadi?!\NHutannya sampai berubah!
Dialogue: 0,0:13:14.07,0:13:16.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Reaksi mana dari Penguasa Hutan\Njuga tidak terdeteksi.
Dialogue: 0,0:13:16.49,0:13:18.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Monster di sana sudah diberantas.
Dialogue: 0,0:13:18.19,0:13:20.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Jangan-jangan, Raja Iblis bangkit?!\N- A-Aku jadi enggan masuk.
Dialogue: 0,0:13:20.69,0:13:22.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya, aku tidak boleh mencolok.
Dialogue: 0,0:13:23.29,0:13:25.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat tongkat sihir itu.\NKelihatannya cukup bagus.
Dialogue: 0,0:13:27.41,0:13:30.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sampai mencolok!\NJangan sampai mencolok!
Dialogue: 0,0:13:30.69,0:13:33.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Nona Kecil,\Nkami tidak akan menyingkir dari...
Dialogue: 0,0:13:33.04,0:13:35.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Woahhhh!
Dialogue: 0,0:13:35.09,0:13:37.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf! Kalian baik-baik saja?
Dialogue: 0,0:13:37.36,0:13:39.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang bahaya terdeteksi.
Dialogue: 0,0:13:39.82,0:13:42.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian sampai jatuh begitu.
Dialogue: 0,0:13:42.69,0:13:44.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak, kami baik-baik saja.
Dialogue: 0,0:13:44.91,0:13:46.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Loketnya di belakang kami.
Dialogue: 0,0:13:48.67,0:13:50.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:13:50.81,0:13:54.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak terlalu paham,\Ntapi mereka kelihatan ramah.
Dialogue: 0,0:13:57.67,0:13:58.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi.
Dialogue: 0,0:13:58.93,0:14:01.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin menukar material dengan uang.
Dialogue: 0,0:14:01.16,0:14:02.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:14:03.16,0:14:05.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang bahaya terdeteksi.
Dialogue: 0,0:14:05.09,0:14:08.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, aku juga ingin\Nmendaftar jadi petualang.
Dialogue: 0,0:14:08.84,0:14:11.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Kamu belum daftar?
Dialogue: 0,0:14:11.29,0:14:12.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang kenapa?
Dialogue: 0,0:14:13.31,0:14:16.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski belum jadi petualang,\Nkamu punya material sebanyak ini?
Dialogue: 0,0:14:16.96,0:14:18.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Ah, tidak.
Dialogue: 0,0:14:18.49,0:14:21.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya hoki karena kebetulan\Nmenemukan banyak batu sihir.
Dialogue: 0,0:14:21.76,0:14:23.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh.
Dialogue: 0,0:14:23.20,0:14:27.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk mendaftar, kamu harus mengikuti ujian.
Dialogue: 0,0:14:27.62,0:14:28.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?!
Dialogue: 0,0:14:28.51,0:14:30.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujiannya mudah, jadi tenang saja.
Dialogue: 0,0:14:30.73,0:14:31.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu.
Dialogue: 0,0:14:32.73,0:14:34.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh tahu namamu?
Dialogue: 0,0:14:34.80,0:14:36.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lorna Hermit.
Dialogue: 0,0:14:37.33,0:14:41.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kali ini, aku akan turun tangan\Nuntuk menjadi pengawas ujian.
Dialogue: 0,0:14:42.11,0:14:45.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika Anda jadi pengawas,\Npeserta selalu dinyatakan gagal
Dialogue: 0,0:14:45.24,0:14:47.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan bahkan ada yang terluka.
Dialogue: 0,0:14:47.04,0:14:48.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:14:48.53,0:14:50.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau komplain?
Dialogue: 0,0:14:50.31,0:14:52.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maafkan saya.
Dialogue: 0,0:14:52.82,0:14:54.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi...
Dialogue: 0,0:14:54.67,0:14:58.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada gadis bernama "Lorna Hermit"\Nyang mengikuti ujian kali ini, kan?
Dialogue: 0,0:14:58.87,0:15:01.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya ada peserta\Nyang punya nama seperti itu.
Dialogue: 0,0:15:02.58,0:15:03.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:15:05.76,0:15:07.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon tenang!
Dialogue: 0,0:15:07.58,0:15:11.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Elmina Manaflame\Nsang Penyihir Api Pemusnah!
Dialogue: 0,0:15:12.38,0:15:15.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika ada gadis bernama "Lorna Hermit"\Nyang mendaftar ke serikat,
Dialogue: 0,0:15:15.60,0:15:18.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}siksa dia dalam ujian dan gagalkan dia.
Dialogue: 0,0:15:18.96,0:15:20.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku nantikan kabar baik darimu.
Dialogue: 0,0:15:20.87,0:15:22.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan pada saya.
Dialogue: 0,0:15:22.36,0:15:26.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya bersumpah atas nama\Nahli sihir pribadi Gugglekars.
Dialogue: 0,0:15:26.93,0:15:30.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya akan menyiksanya begitu keras
Dialogue: 0,0:15:30.26,0:15:32.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sampai dia tidak ingin\Nmenjadi petualang lagi.
Dialogue: 0,0:15:34.36,0:15:37.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak tahu masalahnya.
Dialogue: 0,0:15:37.21,0:15:42.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin dia diusir\Nkarena skill-nya terlalu lemah.
Dialogue: 0,0:15:43.76,0:15:46.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kasihan padanya\Nkarena bukan orang elite.
Dialogue: 0,0:15:47.78,0:15:51.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal kekuatan itu mutlak di dunia ini.
Dialogue: 0,0:15:52.98,0:15:57.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika punya kekuatan,\Nkita bisa mendapatkan apa pun.
Dialogue: 0,0:15:57.73,0:15:59.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu hebat, Elmina!
Dialogue: 0,0:15:59.71,0:16:03.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu membangkitkan skill rank A,\Nyang paling hebat di antara rank lain!
Dialogue: 0,0:16:04.36,0:16:08.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia adalah Elmina Manaflame,\Norang yang memiliki skill rank A.
Dialogue: 0,0:16:08.49,0:16:11.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada orang yang bisa\Nmenandingi Nona Elmina!
Dialogue: 0,0:16:13.67,0:16:19.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menunjukmu, Elmina Manaflame,\Nsebagai ahli sihir pribadi Gugglekars.
Dialogue: 0,0:16:21.13,0:16:24.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga, dunia ini terlalu mudah.
Dialogue: 0,0:16:24.80,0:16:29.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya dengan skill rank A,\Naku bisa menempuh jalur elite.
Dialogue: 0,0:16:32.11,0:16:33.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu,
Dialogue: 0,0:16:33.67,0:16:38.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku belum puas dengan jabatan\Nketua serikat di tempat terpencil ini.
Dialogue: 0,0:16:38.02,0:16:40.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan mendekati keluarga Gugglekars,
Dialogue: 0,0:16:40.02,0:16:43.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan naik tingkat pelan-pelan\Nsampai jadi bangsawan besar.
Dialogue: 0,0:16:43.62,0:16:44.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:16:45.29,0:16:49.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kehidupan superelite Elmina Manaflame
Dialogue: 0,0:16:49.04,0:16:50.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan dimulai dari sini!
Dialogue: 0,0:16:53.82,0:16:54.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke.
Dialogue: 0,0:16:56.09,0:16:58.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat suruh para pesertanya ke sini.
Dialogue: 0,0:16:58.73,0:17:01.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu mau membuang waktu elite-ku ini?
Dialogue: 0,0:17:01.76,0:17:03.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baik! Segera!
Dialogue: 0,0:17:06.22,0:17:08.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tumben banyak orang.
Dialogue: 0,0:17:08.57,0:17:13.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin karena sedang ada tren\N"pengin kaya, dungeon solusinya".
Dialogue: 0,0:17:14.38,0:17:15.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duh, merepotkan.
Dialogue: 0,0:17:17.47,0:17:19.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana Search!
Dialogue: 0,0:17:19.64,0:17:23.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak lulus. Tidak lulus.\NDia juga tidak lulus.
Dialogue: 0,0:17:24.16,0:17:27.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka semua bukan orang elite.
Dialogue: 0,0:17:27.51,0:17:30.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak tahu siapa Lorna Hermit,
Dialogue: 0,0:17:30.27,0:17:33.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi sepertinya tidak ada\Npemilik skill dengan rank tinggi.
Dialogue: 0,0:17:34.00,0:17:37.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau repot,\Njadi semuanya kugagalkan saja.
Dialogue: 0,0:17:39.58,0:17:41.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku gugup banget.
Dialogue: 0,0:17:45.11,0:17:48.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, apa itu? Raja Iblis?
Dialogue: 0,0:17:48.02,0:17:51.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak.\NMana Search-ku pasti bermasalah.
Dialogue: 0,0:17:51.47,0:17:54.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin ada manusia\Nyang punya mana sebanyak itu.
Dialogue: 0,0:17:55.80,0:17:58.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, rusak?
Dialogue: 0,0:17:58.09,0:18:02.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal itu bola kristal pengukur MP\Nyang berkualitas tinggi.
Dialogue: 0,0:18:02.98,0:18:04.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Elmina?
Dialogue: 0,0:18:04.60,0:18:06.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:18:09.56,0:18:11.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, tunggu, tunggu!
Dialogue: 0,0:18:11.02,0:18:12.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak tahu soal ini!\NAneh banget!
Dialogue: 0,0:18:13.18,0:18:19.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Secara teori, bola kristalnya bisa\Nmengukur MP orang hingga 999!
Dialogue: 0,0:18:19.04,0:18:21.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan itu hancur tanpa disentuh?!
Dialogue: 0,0:18:21.91,0:18:25.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan, dia Lorna Hermit?
Dialogue: 0,0:18:26.42,0:18:27.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuharap bukan.
Dialogue: 0,0:18:28.25,0:18:30.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa mereka mengusir orang sehebat itu?
Dialogue: 0,0:18:30.30,0:18:32.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tidak masuk akal.
Dialogue: 0,0:18:33.11,0:18:35.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon!\NKuharap bukan dia!
Dialogue: 0,0:18:36.78,0:18:39.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku Lorna Hermichu!
Dialogue: 0,0:18:39.78,0:18:43.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, sialan!
Dialogue: 0,0:18:43.51,0:18:45.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, tidak, tidak! Ini aneh banget!
Dialogue: 0,0:18:45.98,0:18:48.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa monster sekuat ini malah diusir?!
Dialogue: 0,0:18:48.13,0:18:49.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Elmina?
Dialogue: 0,0:18:49.07,0:18:51.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka menganggapnya sampah\Nyang punya skill lemah?!
Dialogue: 0,0:18:51.87,0:18:54.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa mereka bodoh?!\NApa mereka rabun?!
Dialogue: 0,0:18:54.40,0:18:57.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku disuruh menggagalkan orang\Nyang mirip raja iblis ini?
Dialogue: 0,0:18:57.60,0:19:02.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan menyiksanya sampai\Ndia tidak ingin jadi petualang lagi?
Dialogue: 0,0:19:02.22,0:19:05.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana caranya?\NHei, bagaimana caranya?!
Dialogue: 0,0:19:05.71,0:19:09.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang dulu, Elmina.\NPasti masih ada cara.
Dialogue: 0,0:19:09.20,0:19:14.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar. Aku harus cari alasan\Nuntuk membuatnya pergi dulu.
Dialogue: 0,0:19:14.58,0:19:18.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namamu Lorna, kan?\NKamu dinyatakan gagal.
Dialogue: 0,0:19:18.04,0:19:19.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Eh?\N- Eh?
Dialogue: 0,0:19:19.13,0:19:21.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beliau adalah Elmina Manaflame,
Dialogue: 0,0:19:21.64,0:19:24.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyihir Api Pemusnah\Nyang memiliki skill rank A.
Dialogue: 0,0:19:25.02,0:19:27.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika ada orang bodoh\Nyang merusak suasana hatinya,
Dialogue: 0,0:19:27.13,0:19:29.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}maka orang itu tidak dibutuhkan.
Dialogue: 0,0:19:29.29,0:19:32.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah yang selalu dikatakan Nona Elmina.
Dialogue: 0,0:19:32.42,0:19:33.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak mungkin.
Dialogue: 0,0:19:34.27,0:19:35.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan! Hentikan! Hentikan!
Dialogue: 0,0:19:35.96,0:19:38.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bikin dia marah padaku!
Dialogue: 0,0:19:38.60,0:19:42.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari awal, level kita sudah berbeda.
Dialogue: 0,0:19:42.82,0:19:46.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagian, kenapa dia ingin jadi petualang?
Dialogue: 0,0:19:46.66,0:19:49.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Eh? Mereka semua terlalu lemah\N- Yah, kalau dia gemetaran begitu,
Dialogue: 0,0:19:49.62,0:19:52.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- dan tidak menyadari kekuatannya?\N- wajar saja kalau dia gagal.
Dialogue: 0,0:19:53.51,0:19:56.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia marah?!\NKalau begini terus,
Dialogue: 0,0:19:56.80,0:19:58.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami semua bisa dibunuh.
Dialogue: 0,0:19:59.04,0:20:02.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kalian!\NMinta maaf pada Lorna!
Dialogue: 0,0:20:02.22,0:20:03.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?!
Dialogue: 0,0:20:03.42,0:20:06.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Na-Namun, bukankah Anda selalu\Nmenggagalkan orang yang tidak sopan?
Dialogue: 0,0:20:06.52,0:20:10.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujian harus dilakukan dengan adil!
Dialogue: 0,0:20:10.18,0:20:11.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?!
Dialogue: 0,0:20:11.31,0:20:15.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan kami, Lorna.\NSilakan duduk di sini.
Dialogue: 0,0:20:15.24,0:20:17.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, terima kasih.
Dialogue: 0,0:20:18.78,0:20:20.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lambang itu...
Dialogue: 0,0:20:22.64,0:20:25.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu lambang kehormatan\Nkeluarga Gugglekars, kan?
Dialogue: 0,0:20:25.76,0:20:28.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah dengar kabarnya,\Ntapi dia berhasil di usia segitu?
Dialogue: 0,0:20:28.60,0:20:31.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika keluarga itu marah,\Nnyawa pun bisa melayang.
Dialogue: 0,0:20:33.44,0:20:34.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Elmina?!
Dialogue: 0,0:20:34.75,0:20:36.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa yang Anda lakukan?!
Dialogue: 0,0:20:36.56,0:20:39.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya ada kotoran di bajuku.
Dialogue: 0,0:20:40.53,0:20:42.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lorna Hermit sudah diusir.
Dialogue: 0,0:20:42.64,0:20:46.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Artinya, dia memusuhi\Nkeluarga Gugglekars, kan?
Dialogue: 0,0:20:46.09,0:20:50.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bisa saja memusuhiku juga\Nkarena aku ahli sihir mereka.
Dialogue: 0,0:20:50.67,0:20:56.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu lambang Gugglekars\Nyang selalu Anda banggakan.
Dialogue: 0,0:20:56.40,0:20:57.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, ternyata benar.
Dialogue: 0,0:20:59.22,0:21:02.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh? Kamu musuhku, ya?
Dialogue: 0,0:21:02.47,0:21:04.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Matilah!
Dialogue: 0,0:21:04.28,0:21:07.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hancurlah, Gugglekars!
Dialogue: 0,0:21:09.91,0:21:13.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa itu tidak masalah?
Dialogue: 0,0:21:13.89,0:21:15.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa jadi begini?
Dialogue: 0,0:21:15.96,0:21:18.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya aku sedang\Nmenjalani hidup di jalur elite.
Dialogue: 0,0:21:19.29,0:21:21.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika aku sembarangan\Nmenggagalkan Lorna Hermit,
Dialogue: 0,0:21:21.78,0:21:23.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan dibunuh olehnya.
Dialogue: 0,0:21:23.76,0:21:27.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi jika aku meloloskannya,\Nberarti aku mengkhianati Gugglekars,
Dialogue: 0,0:21:27.71,0:21:29.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan aku akan disingkirkan.
Dialogue: 0,0:21:31.02,0:21:32.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin!
Dialogue: 0,0:21:32.89,0:21:35.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menjalani kehidupan elite!
Dialogue: 0,0:21:35.53,0:21:37.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak boleh berakhir di sini!
Dialogue: 0,0:21:37.96,0:21:41.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus bisa menggagalkan Lorna Hermit
Dialogue: 0,0:21:41.04,0:21:43.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan membuatnya tidak berani ikut ujian lagi.
Dialogue: 0,0:21:44.36,0:21:45.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk itu...
Dialogue: 0,0:21:47.13,0:21:49.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus menggunakan cara itu.
Dialogue: 0,0:21:51.69,0:21:55.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujiannya akan diadakan\Ndi Kuil Bawah Tanah Senjakala.
Dialogue: 0,0:21:55.96,0:21:58.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, dungeon!
Dialogue: 0,0:21:58.73,0:22:02.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gembiralah selagi bisa, Lorna Hermit.
Dialogue: 0,0:22:03.64,0:22:08.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai sekarang,\Nkamu akan masuk ke perangkapku.
