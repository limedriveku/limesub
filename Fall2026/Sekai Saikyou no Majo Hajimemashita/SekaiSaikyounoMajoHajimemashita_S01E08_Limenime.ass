Dialogue: 0,0:01:38.18,0:01:40.28,sign,,0000,0000,0000,,"EPISODE 8: AKU MENCOBA BERTELEPORTASI!"
Dialogue: 0,0:08:57.52,0:08:59.72,sign,,0000,0000,0000,,GELOMBANG API MAHADAHSYAT
Dialogue: 0,0:09:09.16,0:09:10.70,sign,,0000,0000,0000,,LORNA LUPA MEMBATALKAN\NSKILL REFLECTION MILIKNYA!
Dialogue: 0,0:09:16.85,0:09:19.16,sign,,0000,0000,0000,,"PARA PETUALANG TAK MENYADARI TELEPORTASI LORNA!"
Dialogue: 0,0:11:21.62,0:11:23.26,sign,,0000,0000,0000,,"DEG"
Dialogue: 0,0:12:00.20,0:12:03.45,sign,,0000,0000,0000,,"DESA ELF"
Dialogue: 0,0:12:40.73,0:12:41.98,sign,,0000,0000,0000,,LORNA MELUPAKAN KATA-KATA\NYANG DIA AJARKAN!
Dialogue: 0,0:15:13.22,0:15:14.27,sign,,0000,0000,0000,,"JLEB"
Dialogue: 0,0:16:28.38,0:16:30.77,sign,,0000,0000,0000,,"PETIT THUNDER"
Dialogue: 0,0:16:30.78,0:16:31.51,sign,,0000,0000,0000,,PETIT WALL
Dialogue: 0,0:16:34.92,0:16:35.66,sign,,0000,0000,0000,,TITIK KEMUNCULAN YANG TELAH DIPINDAHKAN
Dialogue: 0,0:16:35.66,0:16:36.27,sign,,0000,0000,0000,,AREA KEMUNCULAN
Dialogue: 0,0:17:11.23,0:17:12.68,sign,,0000,0000,0000,,ARIES BERHENTI MEMIKIRKANNYA!
Dialogue: 0,0:17:37.20,0:17:38.48,sign,,0000,0000,0000,,RESET SILUET IKAN
Dialogue: 0,0:20:19.01,0:20:19.85,sign,,0000,0000,0000,,HADIAH JUARA
Dialogue: 0,0:20:23.45,0:20:25.72,sign,,0000,0000,0000,,"JORAN SUPER"
Dialogue: 0,0:20:25.73,0:20:26.29,sign,,0000,0000,0000,,UMPAN MARBLING
Dialogue: 0,0:20:33.33,0:20:35.84,sign,,0000,0000,0000,,"2 TIKET PEMANGGILAN"
Dialogue: 0,0:00:37.34,0:00:43.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Memulai Hidup\NSebagai Penyihir Terkuat di Dunia
Dialogue: 0,0:01:38.18,0:01:40.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo lari!
Dialogue: 0,0:01:40.29,0:01:42.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan kepada kami dan larilah!
Dialogue: 0,0:01:42.93,0:01:45.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa ini terjadi pada Kota Ifone?
Dialogue: 0,0:01:45.27,0:01:46.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepatlah!
Dialogue: 0,0:01:58.13,0:01:59.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu baik-baik saja?
Dialogue: 0,0:01:59.56,0:02:02.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Re-Reinharte si Angin Kilat?
Dialogue: 0,0:02:02.44,0:02:04.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gerakan apa itu tadi?
Dialogue: 0,0:02:04.04,0:02:07.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal sudah lama tidak aktif,\Ntapi kecepatannya masih luar biasa.
Dialogue: 0,0:02:09.49,0:02:10.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka datang lagi!
Dialogue: 0,0:02:25.13,0:02:28.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sialan! Mereka terlalu banyak!
Dialogue: 0,0:02:33.67,0:02:36.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Petualang sebanyak apa pun\Ntidak mungkin menang melawan mereka!
Dialogue: 0,0:02:36.87,0:02:39.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kota ini sudah tamat!
Dialogue: 0,0:02:39.73,0:02:42.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belum kembali ke masa jayaku.
Dialogue: 0,0:02:42.47,0:02:43.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun...
Dialogue: 0,0:02:46.91,0:02:48.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seni Tombak Petir!
Dialogue: 0,0:02:48.87,0:02:50.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tusukan Halilintar!
Dialogue: 0,0:02:59.40,0:03:02.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Elmina!\NMusuh di depan bos sudah kalah!
Dialogue: 0,0:03:02.03,0:03:03.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gunakan sihirmu sekarang!
Dialogue: 0,0:03:04.29,0:03:07.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak punya hak\Ndan kuasa untuk menyuruhku,
Dialogue: 0,0:03:07.21,0:03:08.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penjaga Gerbang.
Dialogue: 0,0:03:09.56,0:03:10.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun,
Dialogue: 0,0:03:11.47,0:03:15.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku memujimu karena berhasil\Nmenyiapkan momen elite untukku.
Dialogue: 0,0:03:16.07,0:03:17.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terbakar dan hancurlah!
Dialogue: 0,0:03:18.80,0:03:20.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir Api Neraka!
Dialogue: 0,0:03:21.31,0:03:22.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eliminate Flame!
Dialogue: 0,0:03:28.58,0:03:29.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa berhasil?
Dialogue: 0,0:03:29.64,0:03:30.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita menang!
Dialogue: 0,0:03:31.33,0:03:34.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasukan kita kuat sekali!
Dialogue: 0,0:03:34.82,0:03:37.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Reinharte di depan dan Elmina di belakang!
Dialogue: 0,0:03:37.91,0:03:41.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peluang kalah di situasi seperti ini\Nadalah nol!
Dialogue: 0,0:03:41.91,0:03:43.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau mandi dulu.
Dialogue: 0,0:03:44.36,0:03:49.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama ada orang elite sepertiku,\Nkota ini sudah dipastikan aman.
Dialogue: 0,0:03:49.02,0:03:52.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Puji aku banyak-banyak\Ndan sebarkan prestasi besarku!
Dialogue: 0,0:03:55.98,0:03:57.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lemah.
Dialogue: 0,0:04:05.20,0:04:08.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku adalah Lava Demon sang iblis lava.
Dialogue: 0,0:04:08.38,0:04:10.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iblis tingkat tinggi.
Dialogue: 0,0:04:11.08,0:04:16.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Api kecil tiruan lava itu\Ntidak akan bisa melukaiku.
Dialogue: 0,0:04:17.32,0:04:21.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iblis?\NBukankah mereka sudah hancur?
Dialogue: 0,0:04:21.39,0:04:24.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iblis adalah manusia kuno\Nyang menantang para dewa
Dialogue: 0,0:04:24.98,0:04:27.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena mabuk kekuatan.
Dialogue: 0,0:04:28.38,0:04:31.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika mereka sampai bangkit,
Dialogue: 0,0:04:31.73,0:04:34.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dunia ini akan berakhir.
Dialogue: 0,0:04:34.85,0:04:38.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar ada manusia\Nyang bisa menundukkan elf,
Dialogue: 0,0:04:38.60,0:04:41.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi kupikir kalian\Nbisa sedikit menghiburku.
Dialogue: 0,0:04:41.05,0:04:43.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata kalian tetaplah serangga.
Dialogue: 0,0:04:45.50,0:04:48.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah tidak peduli\Ndengan tempat ini lagi.
Dialogue: 0,0:04:52.03,0:04:53.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak mungkin!
Dialogue: 0,0:04:54.70,0:04:56.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada habisnya!
Dialogue: 0,0:04:56.43,0:05:00.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa mereka akan terus bermunculan\Nselama iblis itu belum dikalahkan?!
Dialogue: 0,0:05:02.25,0:05:07.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat. Pertarungan intens ini\Ntelah menguras stamina dan MP-ku.
Dialogue: 0,0:05:08.58,0:05:11.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata kota ini akan hancur.
Dialogue: 0,0:05:11.25,0:05:13.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang harus kita lakukan?
Dialogue: 0,0:05:13.05,0:05:15.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan mengulur waktu sebanyak mungkin!
Dialogue: 0,0:05:15.29,0:05:18.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manfaatkan kesempatan itu\Nuntuk menyelamatkan diri!
Dialogue: 0,0:05:18.43,0:05:19.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baiklah!
Dialogue: 0,0:05:21.80,0:05:23.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat pergi dari kota!
Dialogue: 0,0:05:25.84,0:05:29.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu-Bukankah Nona Elmina\Nbisa mengupayakan sesuatu?
Dialogue: 0,0:05:31.77,0:05:33.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?!
Dialogue: 0,0:05:33.70,0:05:37.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa saat aku jadi ketua,\Naku selalu dapat masalah begini?!
Dialogue: 0,0:05:37.38,0:05:38.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aneh banget!
Dialogue: 0,0:05:38.88,0:05:40.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku kena kutukan?
Dialogue: 0,0:05:40.53,0:05:42.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, sialan!
Dialogue: 0,0:05:42.02,0:05:44.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya aku mengundurkan diri waktu itu!
Dialogue: 0,0:05:44.98,0:05:47.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pengin pulang!
Dialogue: 0,0:05:47.50,0:05:49.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}No-Nona Elmina?
Dialogue: 0,0:05:51.98,0:05:55.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Iblis!\NAku punya satu permintaan.
Dialogue: 0,0:05:56.30,0:05:58.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katakanlah, manusia!
Dialogue: 0,0:05:58.40,0:06:01.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak peduli dengan kota ini.
Dialogue: 0,0:06:01.38,0:06:02.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi...
Dialogue: 0,0:06:02.83,0:06:06.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tolong ampuni aku...\N- Habislah kau, dasar iblis!
Dialogue: 0,0:06:06.55,0:06:10.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami punya Nona Elmina\Nyang bermartabat tinggi,
Dialogue: 0,0:06:10.18,0:06:12.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}satu-satunya orang yang berani\Nmenentang keluarga Gugglekars!
Dialogue: 0,0:06:12.78,0:06:17.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Elmina yang bermartabat tinggi\Nmustahil kalah dari iblis rendahan!
Dialogue: 0,0:06:17.10,0:06:19.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, Nona Elmina bermartabat tinggi!
Dialogue: 0,0:06:19.45,0:06:20.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hancurkan dia!
Dialogue: 0,0:06:20.82,0:06:25.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan!\NDia bisa makin mengincarku!
Dialogue: 0,0:06:25.58,0:06:30.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elmina Manaflame, ya?\NAku sudah dengar tentangmu.
Dialogue: 0,0:06:30.28,0:06:30.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:06:31.58,0:06:35.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak tergoda keserakahan sesaat\Ndan mengkhianati keluarga Gugglekars.
Dialogue: 0,0:06:35.90,0:06:38.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya kau manusia bermartabat tinggi.
Dialogue: 0,0:06:41.58,0:06:42.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh?
Dialogue: 0,0:06:42.58,0:06:48.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya-Yah, tentu saja!\NAku menjauhi hal yang tidak elite.
Dialogue: 0,0:06:48.83,0:06:52.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu. Sangat disayangkan.
Dialogue: 0,0:06:53.35,0:06:58.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadinya aku ingin mengampunimu\Ndan memberimu semacam kekuatan.
Dialogue: 0,0:06:59.83,0:07:04.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami menghargai manusia\Nyang menyandang gelar penyihir.
Dialogue: 0,0:07:04.50,0:07:11.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau memiliki skill rank A,\Nkau pasti bisa segera jadi petinggi iblis.
Dialogue: 0,0:07:11.20,0:07:13.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu! Ceritakan lebih detail!
Dialogue: 0,0:07:13.80,0:07:17.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayang sekali,\Nwahai penyihir bermartabat tinggi.
Dialogue: 0,0:07:17.73,0:07:22.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, hancurlah bersama kota ini!
Dialogue: 0,0:07:22.46,0:07:25.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tu-Tunggu!\NMari bicara lagi!
Dialogue: 0,0:07:25.58,0:07:26.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayolah!
Dialogue: 0,0:07:26.58,0:07:31.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, saksikanlah keputusasaan sejati!
Dialogue: 0,0:07:31.08,0:07:32.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu dulu!
Dialogue: 0,0:07:33.03,0:07:35.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin membahas\Ntunjangan kesejahteraannya!
Dialogue: 0,0:07:40.18,0:07:41.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jumlah mana yang luar biasa!
Dialogue: 0,0:07:41.95,0:07:43.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa melihat ke depan!
Dialogue: 0,0:07:45.68,0:07:47.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Elmina!
Dialogue: 0,0:07:49.10,0:07:50.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,
Dialogue: 0,0:07:50.85,0:07:55.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan kukerahkan MP terakhirku\Nuntuk menetralkan serangannya!
Dialogue: 0,0:07:59.08,0:08:00.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang lemah!
Dialogue: 0,0:08:03.13,0:08:05.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin.
Dialogue: 0,0:08:05.83,0:08:09.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak percaya\Nhidupku akan berakhir di sini.
Dialogue: 0,0:08:11.80,0:08:16.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan di momen terakhirku,\Naku melihat halusinasi mengerikan.
Dialogue: 0,0:08:22.65,0:08:25.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, Fast Travel berhasil!
Dialogue: 0,0:08:25.80,0:08:27.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benar-benar sampai di Kota Ifone!
Dialogue: 0,0:08:28.98,0:08:30.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asli?
Dialogue: 0,0:08:31.05,0:08:32.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Loh? Nona Elmina?
Dialogue: 0,0:08:32.75,0:08:35.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, ternyata Nona Elmina!
Dialogue: 0,0:08:35.00,0:08:37.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, ada Reinharte juga!
Dialogue: 0,0:08:37.00,0:08:38.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo!
Dialogue: 0,0:08:38.88,0:08:41.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke-Kenapa?!
Dialogue: 0,0:08:44.38,0:08:47.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mendatangkan makhluk panggilan, ya?
Dialogue: 0,0:08:47.67,0:08:51.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, hancurlah bersama!
Dialogue: 0,0:08:53.23,0:08:54.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Matilah!
Dialogue: 0,0:08:54.68,0:08:57.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gelombang Api Mahadahsyat!
Dialogue: 0,0:09:07.30,0:09:08.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Apa?
Dialogue: 0,0:09:11.75,0:09:12.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Wah.\N- Hei, iblis itu sudah sekarat!
Dialogue: 0,0:09:12.80,0:09:15.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Monster itu tampak kuat.\N- Hei, iblis itu sudah sekarat!
Dialogue: 0,0:09:15.00,0:09:16.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Monster itu tampak kuat.\N- Apa yang terjadi?
Dialogue: 0,0:09:16.20,0:09:16.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seram!
Dialogue: 0,0:09:16.85,0:09:19.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa Nona Elmina melakukan sesuatu?
Dialogue: 0,0:09:20.00,0:09:23.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin!\NDia mengalahkan iblis itu dalam sekali gerakan?
Dialogue: 0,0:09:23.50,0:09:26.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan tanpa melihatnya?
Dialogue: 0,0:09:26.48,0:09:30.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Inikah kekuatan Lorna Hermit?
Dialogue: 0,0:09:32.35,0:09:35.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keparat! Keparat!
Dialogue: 0,0:09:35.72,0:09:38.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elmina Manaflame!
Dialogue: 0,0:09:38.68,0:09:40.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok aku?!
Dialogue: 0,0:09:42.70,0:09:46.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku puji kau karena bisa\Nmemberiku luka separah ini.
Dialogue: 0,0:09:46.90,0:09:49.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengakui kekuatanmu.
Dialogue: 0,0:09:50.30,0:09:51.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:09:51.30,0:09:54.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya aku tidak bisa mengalahkanmu.
Dialogue: 0,0:09:55.15,0:09:55.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:09:56.48,0:09:59.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan mundur dulu.
Dialogue: 0,0:09:59.70,0:10:00.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:10:01.10,0:10:07.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi jangan pernah lupa.\NAku bukan satu-satunya iblis.
Dialogue: 0,0:10:07.95,0:10:12.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan meski aku dikalahkan,\Nmasih ada iblis kedua atau ketiga
Dialogue: 0,0:10:12.85,0:10:17.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang akan muncul untuk membunuh\Npahlawan bernama Elmina Manaflame!
Dialogue: 0,0:10:18.15,0:10:19.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu!\NJangan bawa-bawa aku!
Dialogue: 0,0:10:21.68,0:10:23.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai jumpa!
Dialogue: 0,0:10:23.38,0:10:25.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak!\NJangan pergi dulu!
Dialogue: 0,0:10:29.27,0:10:31.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak!
Dialogue: 0,0:10:31.61,0:10:34.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Elmina mengalahkan iblis!
Dialogue: 0,0:10:34.90,0:10:35.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat!
Dialogue: 0,0:10:36.28,0:10:37.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?!
Dialogue: 0,0:10:37.12,0:10:40.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita menyaksikan sebuah sejarah!
Dialogue: 0,0:10:40.35,0:10:43.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini adalah kelahiran\Npahlawan Elmina Manaflame!
Dialogue: 0,0:10:43.68,0:10:46.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu! Hentikan!\NAku tidak mengalahkannya!
Dialogue: 0,0:10:46.20,0:10:48.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau jadi target iblis!
Dialogue: 0,0:10:48.95,0:10:53.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya. Ternyata Nona Elmina\Nyang mengalahkan monster kuat itu.
Dialogue: 0,0:10:54.33,0:10:56.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Dia bermartabat, welas asih,\N- Tunggu, tidak! Bukan begitu!
Dialogue: 0,0:10:56.90,0:10:58.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- dan rendah hati.\N- Aku bukan pahlawan!
Dialogue: 0,0:10:58.93,0:11:01.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Nona Elmina memang hebat.\N- Tunggu!
Dialogue: 0,0:11:01.14,0:11:04.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Dengarkan aku!\N- Aku tidak sempat melihat aksinya,
Dialogue: 0,0:11:04.88,0:11:07.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi untung saja aku datang\Ndi saat yang tepat.
Dialogue: 0,0:11:08.25,0:11:09.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Reinharte!
Dialogue: 0,0:11:10.38,0:11:14.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini adalah Hyper Sazae,\Noleh-oleh dari Kota Aquas.
Dialogue: 0,0:11:14.15,0:11:16.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan dimakan bersama\Nsemua orang di serikat.
Dialogue: 0,0:11:16.33,0:11:17.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}O-Oke.
Dialogue: 0,0:11:17.91,0:11:21.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kapan kamu kembali?
Dialogue: 0,0:11:21.62,0:11:23.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, begini...
Dialogue: 0,0:11:23.26,0:11:26.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku kembali karena lupa beli oleh-oleh.
Dialogue: 0,0:11:27.33,0:11:29.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:11:29.45,0:11:31.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku langsung pindah lokasi\Ntanpa berpikir panjang,
Dialogue: 0,0:11:31.94,0:11:35.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi sebaiknya aku lihat-lihat\Nwaktunya lain kali.
Dialogue: 0,0:11:35.13,0:11:38.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau jajan dulu di Ifone, ah.
Dialogue: 0,0:11:38.53,0:11:39.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti.
Dialogue: 0,0:11:39.80,0:11:45.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mendeteksi bahaya di kota ini\Ndan menyelamatkan kami dengan sigap.
Dialogue: 0,0:11:45.70,0:11:49.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin dia yang mengalahkan iblis tadi,
Dialogue: 0,0:11:49.02,0:11:52.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi dia pergi begitu saja\Ntanpa membanggakan prestasinya.
Dialogue: 0,0:11:53.08,0:11:55.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lorna memang hebat!
Dialogue: 0,0:11:55.70,0:11:57.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pahlawan! Pahlawan!
Dialogue: 0,0:11:57.95,0:11:59.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Pahlawan! Pahlawan!\N- Tidak!
Dialogue: 0,0:12:00.20,0:12:03.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo! Ratu, Elnachan!
Dialogue: 0,0:12:03.45,0:12:05.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, Nona Penyelamat!
Dialogue: 0,0:12:05.44,0:12:08.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, halo, Lorna!
Dialogue: 0,0:12:09.94,0:12:12.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum genap dua minggu\Nsejak kepergianmu dari sini.
Dialogue: 0,0:12:12.62,0:12:14.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat sekali kembalimu.
Dialogue: 0,0:12:14.72,0:12:16.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Sebenarnya,
Dialogue: 0,0:12:16.96,0:12:20.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku sudah bisa berpindah ke lokasi\Nyang pernah kukunjungi secara instan.
Dialogue: 0,0:12:23.32,0:12:24.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:12:24.60,0:12:27.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi tenang karena kamu\Ntidak masuk akal seperti biasa.
Dialogue: 0,0:12:28.40,0:12:31.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana keadaan desa elf\Nsetelah kepergianku?
Dialogue: 0,0:12:31.44,0:12:34.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya betulan hepi palupi!
Dialogue: 0,0:12:34.60,0:12:38.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya! Berkat bantuanmu,\Nsemuanya jadi uhuy-uhuy!
Dialogue: 0,0:12:38.60,0:12:40.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka bicara apa, sih?
Dialogue: 0,0:12:42.18,0:12:43.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, benar juga!
Dialogue: 0,0:12:43.78,0:12:46.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba makanlah kerang kipas ini!
Dialogue: 0,0:12:46.12,0:12:47.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa bikin melayang!
Dialogue: 0,0:12:47.58,0:12:51.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh? Sudah ratusan tahun\Naku tidak makan hasil laut.
Dialogue: 0,0:12:55.62,0:12:56.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini...
Dialogue: 0,0:12:57.20,0:12:58.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bikin melayang!
Dialogue: 0,0:12:58.60,0:13:02.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, kerang ini sangat manis\Ndan bikin melayang-layang!
Dialogue: 0,0:13:03.18,0:13:06.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita bersulang merayakan\Nkembalinya Nona Penyelamat!
Dialogue: 0,0:13:06.39,0:13:07.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tos!
Dialogue: 0,0:13:09.60,0:13:12.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baginda, ada sesuatu\Nyang ingin saya pastikan.
Dialogue: 0,0:13:14.26,0:13:16.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu Zariché?
Dialogue: 0,0:13:19.92,0:13:22.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menurutimu!\NTolong jangan sakiti aku!
Dialogue: 0,0:13:24.42,0:13:26.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa dia ketakutan?
Dialogue: 0,0:13:30.00,0:13:35.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zariché sedang melakukan riset\Nmetode panen herba tanpa batas, ya?
Dialogue: 0,0:13:35.00,0:13:39.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Dia memang peneliti\Nyang berbakat.
Dialogue: 0,0:13:39.60,0:13:42.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daripada menjatuhinya hukuman kerja paksa,
Dialogue: 0,0:13:42.68,0:13:47.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lebih baik memanfaatkan\Npengetahuan dan skill-nya.
Dialogue: 0,0:13:48.12,0:13:49.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga ingin menyiapkan
Dialogue: 0,0:13:49.93,0:13:53.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}cara membudidayakan Maboroleaf\Nagar kejadian kemarin tidak terulang.
Dialogue: 0,0:13:54.20,0:13:55.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:13:55.25,0:13:57.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menempatkan orang\Ndi posisi paling tepat, ya?
Dialogue: 0,0:13:57.88,0:14:02.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belum memaafkannya karena\Ndia menyakiti Ibu dan semua orang!
Dialogue: 0,0:14:02.66,0:14:05.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, apa tidak masalah?
Dialogue: 0,0:14:08.60,0:14:12.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka semua begitu bodoh\Nsampai membuatku gemas sendiri.
Dialogue: 0,0:14:14.92,0:14:17.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skill pengendali tumbuhan Zariché itu...
Dialogue: 0,0:14:17.63,0:14:20.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin berbahaya.
Dialogue: 0,0:14:20.92,0:14:23.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu khawatir.
Dialogue: 0,0:14:23.52,0:14:27.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang aku seperti mawar\Nyang dicabut durinya.
Dialogue: 0,0:14:27.68,0:14:31.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa melawan\Nkarena dikenai sihir kontrak penjahat.
Dialogue: 0,0:14:31.72,0:14:36.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga tidak bisa berbuat banyak\Ntanpa mana dari keluarga Gugglekars.
Dialogue: 0,0:14:37.20,0:14:38.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu,
Dialogue: 0,0:14:38.11,0:14:43.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku lebih suka meneliti\Nmetode budidaya ala Lorna.
Dialogue: 0,0:14:43.84,0:14:45.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya dalam 100 tahun,
Dialogue: 0,0:14:45.70,0:14:48.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tidak punya waktu\Nuntuk menaklukkan dunia.
Dialogue: 0,0:14:49.52,0:14:51.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Metode budidaya ala Lorna?
Dialogue: 0,0:14:51.32,0:14:52.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ja-Jadi,
Dialogue: 0,0:14:53.22,0:14:57.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku ingin diajari lebih banyak hal berguna.
Dialogue: 0,0:15:00.34,0:15:03.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dunia ini masih dipenuhi\Nherba obat dan resep alkimia
Dialogue: 0,0:15:03.23,0:15:05.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang belum kuketahui!
Dialogue: 0,0:15:05.76,0:15:10.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya ampun, seharusnya Baginda\Ntidak terobsesi pada bahasa gaul dewa
Dialogue: 0,0:15:10.05,0:15:13.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan menanyakan pengetahuan bermanfaat ini.
Dialogue: 0,0:15:13.22,0:15:14.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jleb!
Dialogue: 0,0:15:14.76,0:15:15.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:15:15.65,0:15:18.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu butuh herba obat\Nyang tidak tumbuh di sekitar sini?
Dialogue: 0,0:15:19.14,0:15:23.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misalnya Kamina Leaf dari Rawa Petir\Natau ranting Sango Tree dari Pantai Urs.
Dialogue: 0,0:15:23.70,0:15:25.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh, boleh.
Dialogue: 0,0:15:28.28,0:15:33.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kondisi herbanya mantap sekali!\NIni benar-benar herba berkualitas!
Dialogue: 0,0:15:33.04,0:15:35.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zariché juga melayang-layang!
Dialogue: 0,0:15:36.02,0:15:39.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, aku akan kembali ke Aquas\Ndengan Fast Travel.
Dialogue: 0,0:15:42.32,0:15:44.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu, ayo lakukan itu!
Dialogue: 0,0:15:44.52,0:15:45.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:15:45.98,0:15:48.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Istilah itu memang cocok\Nuntuk orang yang bepergian.
Dialogue: 0,0:15:50.66,0:15:52.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu, dua!
Dialogue: 0,0:15:52.35,0:15:54.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wkwk!
Dialogue: 0,0:15:55.66,0:15:58.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai jumpa, Bu Aries!
Dialogue: 0,0:15:58.68,0:16:00.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, sampai jumpa!
Dialogue: 0,0:16:00.54,0:16:03.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan lupa ulangi\Npelajaran hari ini di rumah!
Dialogue: 0,0:16:03.12,0:16:04.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:16:13.08,0:16:16.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapan terakhir kali aku merasa seringan ini?
Dialogue: 0,0:16:18.06,0:16:20.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya berkat Lornachan.
Dialogue: 0,0:16:20.54,0:16:22.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa dia sebenarnya?
Dialogue: 0,0:16:24.18,0:16:27.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awalnya, kukira dia hanya gadis biasa,
Dialogue: 0,0:16:27.46,0:16:28.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi dia mencapai
Dialogue: 0,0:16:28.38,0:16:30.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}banyak prestasi yang bisa dicatat dalam sejarah.
Dialogue: 0,0:16:31.52,0:16:34.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski kurang paham hal umum,\Npengetahuannya cukup luas.
Dialogue: 0,0:16:36.28,0:16:39.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan katanya dia bisa dengar\Nsuara dewa dengan skill-nya.
Dialogue: 0,0:16:40.18,0:16:43.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan, dia malaikat\Ndari surga betulan.
Dialogue: 0,0:16:45.82,0:16:47.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa?!
Dialogue: 0,0:16:49.46,0:16:51.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Aries, halo!
Dialogue: 0,0:16:52.76,0:16:53.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:16:54.34,0:16:55.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa dia betulan malaikat?
Dialogue: 0,0:16:56.34,0:16:59.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sedang ikut lomba mancing,\Njadi aku permisi dulu, ya.
Dialogue: 0,0:16:59.91,0:17:00.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:17:01.94,0:17:03.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:17:03.34,0:17:05.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa itu tadi?
Dialogue: 0,0:17:07.07,0:17:10.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimanapun juga, Lornachan\Nkesayanganku masih imut hari ini.
Dialogue: 0,0:17:14.34,0:17:15.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo!
Dialogue: 0,0:17:15.96,0:17:17.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Ah, iya.
Dialogue: 0,0:17:17.98,0:17:18.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai jumpa!
Dialogue: 0,0:17:22.80,0:17:23.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo!
Dialogue: 0,0:17:24.88,0:17:27.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kamu sedang apa?
Dialogue: 0,0:17:28.76,0:17:33.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya kamu ikut lomba mancing.\NKenapa kamu kembali ke kuil ini?
Dialogue: 0,0:17:33.06,0:17:34.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, sebenarnya
Dialogue: 0,0:17:35.24,0:17:37.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku sedang reset siluet ikan!
Dialogue: 0,0:17:38.52,0:17:39.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:17:40.10,0:17:40.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini.
Dialogue: 0,0:17:40.98,0:17:44.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kita lihat waktu,\Ntempat, dan siluet ikan,
Dialogue: 0,0:17:44.00,0:17:47.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita bisa tahu ikan macam apa\Nyang akan didapat tanpa mancing,
Dialogue: 0,0:17:47.06,0:17:49.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi teleportasi bisa\Nmemicu reset siluet ikan,
Dialogue: 0,0:17:49.18,0:17:52.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi jika aku terus berteleportasi\Nhingga muncul siluet ikan langka,
Dialogue: 0,0:17:52.38,0:17:54.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita bisa memancing\Ndan mendapatkan ikan langka.
Dialogue: 0,0:17:55.70,0:17:59.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Percuma.\NAku tidak paham maksudnya.
Dialogue: 0,0:17:59.54,0:18:00.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dadah!
Dialogue: 0,0:18:02.90,0:18:04.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku penasaran!
Dialogue: 0,0:18:08.70,0:18:12.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku langsung mengikutinya,\Ntapi di mana Lornachan sekarang?
Dialogue: 0,0:18:16.10,0:18:17.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Strike!
Dialogue: 0,0:18:19.40,0:18:22.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kali ini, ikan legenda Myuunagi\Nberhasil diangkat!
Dialogue: 0,0:18:22.50,0:18:25.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lorna mengungguli peringkat dua\Ndengan skor lebih dari sepuluh kali lipat
Dialogue: 0,0:18:25.28,0:18:29.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan memantapkan peringkat pertama\Ndengan skor tertinggi sepanjang sejarah!
Dialogue: 0,0:18:29.50,0:18:33.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di-Dia melakukan hal luar biasa lagi.
Dialogue: 0,0:18:33.01,0:18:36.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Lorna! Lorna! Lorna!\N- Hore! Hore! Hore!
Dialogue: 0,0:18:37.88,0:18:42.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin sebaiknya aku juga\Nhidup lebih jujur pada diri sendiri
Dialogue: 0,0:18:42.38,0:18:45.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan lebih bebas seperti Lornachan.
Dialogue: 0,0:18:47.10,0:18:52.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belakangan ini, aku terus bekerja\Ndan mengekang diri sendiri demi kota.
Dialogue: 0,0:18:52.90,0:18:55.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk melindungi kota tercinta ini,
Dialogue: 0,0:18:55.48,0:18:59.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku jadi ketua, jabatan yang dihindari,\Nsetelah ketua serikat sebelumnya kabur,
Dialogue: 0,0:18:59.68,0:19:04.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan aku selalu bekerja sampai larut\Nkarena masih merangkap tugas pendeta.
Dialogue: 0,0:19:04.48,0:19:06.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, sekarang sudah berbeda.
Dialogue: 0,0:19:07.74,0:19:11.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku telah terbebas dari beban Misi Hari Rabu
Dialogue: 0,0:19:11.00,0:19:12.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan mendapatkan banyak waktu.
Dialogue: 0,0:19:14.20,0:19:18.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai sekarang, mungkin aku\Nbisa memikirkan diriku sendiri.
Dialogue: 0,0:19:19.74,0:19:20.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu...
Dialogue: 0,0:19:26.78,0:19:28.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bagus, Lornachan!
Dialogue: 0,0:19:28.64,0:19:29.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu imut!
Dialogue: 0,0:19:29.98,0:19:31.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duh, enggak tahan!
Dialogue: 0,0:19:32.22,0:19:32.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Imut banget!
Dialogue: 0,0:19:33.78,0:19:34.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku suka!
Dialogue: 0,0:19:35.20,0:19:36.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luar biasa!
Dialogue: 0,0:19:36.46,0:19:37.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cantik!
Dialogue: 0,0:19:37.78,0:19:41.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lornachan, kamu adalah\Nmakhluk terimut di dunia!
Dialogue: 0,0:19:42.24,0:19:43.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, apa ini?!
Dialogue: 0,0:19:44.50,0:19:45.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Petugas?!
Dialogue: 0,0:19:45.91,0:19:47.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sedang apa?! Hentikan!
Dialogue: 0,0:19:47.85,0:19:49.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bukan orang aneh!
Dialogue: 0,0:19:50.00,0:19:55.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku adalah Aries Téa Bluemoon,\NKetua Serikat Petualang Aquas!
Dialogue: 0,0:19:59.38,0:20:01.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asyik banget!
Dialogue: 0,0:20:02.22,0:20:06.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lomba mancingnya sangat meriah.
Dialogue: 0,0:20:06.10,0:20:11.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ikut demi hadiah juaranya,\Ntapi aku dapat banyak ikan langka lezat
Dialogue: 0,0:20:11.53,0:20:13.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan aku menikmati acaranya.
Dialogue: 0,0:20:14.88,0:20:18.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, ini momen ternikmat,\Nwaktunya memeriksa hadiah.
Dialogue: 0,0:20:19.88,0:20:23.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hadiah juaranya\Nsesuai informasi di Internet,
Dialogue: 0,0:20:23.45,0:20:25.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yaitu Joran Super dari kategori joran premium,
Dialogue: 0,0:20:26.30,0:20:29.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}serta umpan pancing premium,\NUmpan Marbling, untuk satu tahun.
Dialogue: 0,0:20:29.90,0:20:32.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan hadiah paling utama adalah
Dialogue: 0,0:20:33.33,0:20:35.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dua tiket makhluk panggilan!
Dialogue: 0,0:20:36.35,0:20:38.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makhluk panggilan, ya?
Dialogue: 0,0:20:38.90,0:20:40.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu yang kuat-kuat.
Dialogue: 0,0:20:40.58,0:20:44.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuharap bisa dapat makhluk\Nyang mirip maskot menggemaskan.
Dialogue: 0,0:20:44.60,0:20:49.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika ada makhluk panggilan imut,\Nrasa sepi perjalanan pasti terobati.
Dialogue: 0,0:20:50.33,0:20:51.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:20:51.23,0:20:54.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus mengangkat tiket\Nuntuk melakukan pemanggilan.
Dialogue: 0,0:20:55.65,0:20:57.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gacha dua kali.
Dialogue: 0,0:21:02.80,0:21:04.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa itu?!
Dialogue: 0,0:21:04.30,0:21:05.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lingkaran sihir di langit?
Dialogue: 0,0:21:05.95,0:21:08.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dunia ini akan tamat!
Dialogue: 0,0:21:08.29,0:21:12.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke-Kelihatan heboh banget.
Dialogue: 0,0:21:19.68,0:21:22.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu yang memanggil Lulu?
Dialogue: 0,0:21:22.53,0:21:23.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:21:24.13,0:21:26.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lulu adalah Lulu Le Rilyeh.
Dialogue: 0,0:21:26.58,0:21:31.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putri ras naga air\Nyang kelak menguasai lautan.
Dialogue: 0,0:21:31.30,0:21:35.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bergembiralah!\NKamu akan Lulu jadikan pelayan.
Dialogue: 0,0:21:35.23,0:21:37.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, manusia?
Dialogue: 0,0:21:37.24,0:21:39.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa manusia bisa terpanggil?
Dialogue: 0,0:21:39.56,0:21:41.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, putri ras naga air?
Dialogue: 0,0:21:41.63,0:21:43.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, kok bisa?
Dialogue: 0,0:21:45.33,0:21:46.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang kedua!
Dialogue: 0,0:21:49.38,0:21:52.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu yang memanggil Lulu?
Dialogue: 0,0:21:52.75,0:21:55.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lulu adalah Lulu Le Rilyeh.
Dialogue: 0,0:21:55.20,0:21:59.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putri ras naga air\Nyang kelak menguasai lautan.
Dialogue: 0,0:22:00.05,0:22:03.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bergembiralah!\NKamu akan Lulu jadikan pelaya...
Dialogue: 0,0:22:04.48,0:22:05.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:22:06.08,0:22:06.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:22:08.20,0:22:09.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
