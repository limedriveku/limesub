Dialogue: 0,0:01:54.29,0:01:56.39,sign,,0000,0000,0000,,EPISODE 5:\NAKU MENCOBA BERHENTI JADI PENYELAMAT!
Dialogue: 0,0:06:04.29,0:06:04.62,sign,,0000,0000,0000,,PADANG WKWK
Dialogue: 0,0:09:20.78,0:09:25.25,sign,,0000,0000,0000,,"TIDAK BISA KABUR DARI LORNA HERMIT!"
Dialogue: 0,0:11:11.24,0:11:13.44,sign,,0000,0000,0000,,SIMPATI LORNA TERHADAP ELMINA\NSUDAH MAKSIMAL!
Dialogue: 0,0:12:16.17,0:12:16.57,sign,,0000,0000,0000,,ELMINA AKAN TERUS TERLIBAT\NDENGAN LORNA DI MASA DEPAN
Dialogue: 0,0:17:49.76,0:17:51.81,sign,,0000,0000,0000,,"MELEYOT"
Dialogue: 0,0:17:51.81,0:17:53.01,sign,,0000,0000,0000,,"SINGA PETIR TELAH DIKALAHKAN LORNA!"
Dialogue: 0,0:17:56.00,0:17:56.44,sign,,0000,0000,0000,,LALU, LORNA TIDAK PAHAM\NKONSEP KURSI KEHORMATAN!
Dialogue: 0,0:00:02.43,0:00:03.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitulah ceritanya.
Dialogue: 0,0:00:03.99,0:00:08.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan memanfaatkan serbuk sari pesona\Nmonster bernama Queen's Heart Rose,
Dialogue: 0,0:00:09.10,0:00:12.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zariché ingin memperbudak\Nsemua orang di seluruh dunia.
Dialogue: 0,0:00:14.03,0:00:18.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sudah kalah dan kutangkap,\Njadi anggap saja semuanya selesai.
Dialogue: 0,0:00:18.15,0:00:20.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bunuh aku.
Dialogue: 0,0:00:20.00,0:00:22.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya terjadi begitu cepat,\Nsampai membuatku gagal paham.
Dialogue: 0,0:00:53.34,0:00:59.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Memulai Hidup\NSebagai Penyihir Terkuat di Dunia
Dialogue: 0,0:01:56.95,0:01:59.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak kapan kita berpesta seperti ini, ya?
Dialogue: 0,0:01:59.40,0:02:01.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pesta dalam rangka apa ini?
Dialogue: 0,0:02:02.43,0:02:04.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka sampai larut dalam kegembiraan.
Dialogue: 0,0:02:05.60,0:02:08.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua ini berkat bantuanmu.
Dialogue: 0,0:02:08.53,0:02:10.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Masa, sih?
Dialogue: 0,0:02:10.75,0:02:11.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:02:11.86,0:02:15.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anda memang sang Penyelamat!
Dialogue: 0,0:02:16.05,0:02:19.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya ingin mendengar kisah petualangan Anda!
Dialogue: 0,0:02:20.05,0:02:22.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Konon seseorang harus\Nmenyelesaikan banyak ujian
Dialogue: 0,0:02:22.03,0:02:25.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk mendapatkan Tongkat Sihir Pohon Dunia.
Dialogue: 0,0:02:25.88,0:02:28.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana cara Anda melakukannya?
Dialogue: 0,0:02:29.70,0:02:30.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:02:31.60,0:02:33.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mendapatkannya dengan cara curang.
Dialogue: 0,0:02:35.43,0:02:39.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal tongkat sihir itu\Nsangat penting bagi para elf.
Dialogue: 0,0:02:40.98,0:02:43.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ratu, Elnachan.
Dialogue: 0,0:02:43.78,0:02:45.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku.
Dialogue: 0,0:02:45.75,0:02:48.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku adalah anggota keluarga Gugglekars.
Dialogue: 0,0:02:48.48,0:02:50.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menceritakan semua
Dialogue: 0,0:02:50.75,0:02:52.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang terjadi selama ini.
Dialogue: 0,0:02:55.03,0:02:56.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitulah ceritanya.
Dialogue: 0,0:03:01.30,0:03:02.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jahat!
Dialogue: 0,0:03:04.38,0:03:06.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memang pantas dimarahi.
Dialogue: 0,0:03:06.80,0:03:11.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka mengusir Nona Penyelamat\Nyang begitu baik, kuat, dan keren?
Dialogue: 0,0:03:11.58,0:03:12.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:03:12.59,0:03:15.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skill untuk mendengar kata-kata dewa?
Dialogue: 0,0:03:15.68,0:03:18.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lengkap dengan gudang informasi\Nyang memuat cara kerja dunia?
Dialogue: 0,0:03:19.50,0:03:20.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sulit dipercaya.
Dialogue: 0,0:03:22.00,0:03:24.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Kalian tidak marah?
Dialogue: 0,0:03:24.80,0:03:26.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Marah?
Dialogue: 0,0:03:26.25,0:03:28.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berasal dari keluarga Gugglekars.
Dialogue: 0,0:03:28.95,0:03:31.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga berbuat curang untuk\Nmendapatkan tongkat sihirnya.
Dialogue: 0,0:03:32.38,0:03:33.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu,
Dialogue: 0,0:03:34.25,0:03:36.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku kembalikan tongkat sihir ini
Dialogue: 0,0:03:36.28,0:03:37.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kepada kalian.
Dialogue: 0,0:03:38.95,0:03:42.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanpa tongkat sihir ini,\Naku tidak bisa memakai sihir hebat.
Dialogue: 0,0:03:42.05,0:03:45.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika masih nekat bertualang,\Naku pasti tidak akan hidup lama.
Dialogue: 0,0:03:45.68,0:03:46.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu,
Dialogue: 0,0:03:46.79,0:03:49.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ini adalah akhir dari petualanganku.
Dialogue: 0,0:03:51.05,0:03:53.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata masalah kecil itu\Nmembuat Anda terganggu, ya.
Dialogue: 0,0:03:53.60,0:03:54.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:03:55.73,0:03:58.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dibandingkan betapa besarnya kekuatan Anda,
Dialogue: 0,0:03:58.25,0:04:00.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}masalah itu terlalu sepele.
Dialogue: 0,0:04:00.25,0:04:01.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Se-Sepele?
Dialogue: 0,0:04:01.80,0:04:03.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul.
Dialogue: 0,0:04:03.40,0:04:05.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang terpenting bukanlah ujiannya.
Dialogue: 0,0:04:05.60,0:04:07.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perbuatanmulah yang terpenting.
Dialogue: 0,0:04:09.78,0:04:12.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami adalah saksinya.
Dialogue: 0,0:04:12.00,0:04:14.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu telah menyelamatkan desa ini
Dialogue: 0,0:04:14.98,0:04:17.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}beserta seluruh dunia.
Dialogue: 0,0:04:20.25,0:04:24.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Lorna adalah Penyelamat\Nyang hebat di mata semua orang!
Dialogue: 0,0:04:24.15,0:04:26.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa malah Elna yang bangga?
Dialogue: 0,0:04:27.68,0:04:29.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih!
Dialogue: 0,0:04:30.33,0:04:34.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya aku sudah dapat pujian\Nuntuk jatah seumur hidup.
Dialogue: 0,0:04:35.83,0:04:39.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi keluarga Gugglekars juga terlibat, ya?
Dialogue: 0,0:04:40.30,0:04:44.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka sering mengacaukan\Ngaris ley utama di hutan ini sejak dulu.
Dialogue: 0,0:04:44.43,0:04:49.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira mereka berhenti berulah\Nsetelah kuberi sedikit peringatan.
Dialogue: 0,0:04:49.06,0:04:51.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maafkan aku.
Dialogue: 0,0:04:51.60,0:04:53.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak bersalah.
Dialogue: 0,0:04:54.05,0:04:56.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka membuang peluang besar.
Dialogue: 0,0:04:56.43,0:04:59.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika mereka tidak menyia-nyiakanmu,
Dialogue: 0,0:04:59.53,0:05:03.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin mereka sudah\Nmencapai puncak kejayaan.
Dialogue: 0,0:05:03.70,0:05:05.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Se-Seram.
Dialogue: 0,0:05:05.58,0:05:07.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Ibu!
Dialogue: 0,0:05:07.16,0:05:09.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Penyelamat jadi takut!
Dialogue: 0,0:05:10.40,0:05:12.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, maaf.
Dialogue: 0,0:05:12.68,0:05:13.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga!
Dialogue: 0,0:05:13.73,0:05:17.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sudah hampir malam,\Njadi menginaplah di istana!
Dialogue: 0,0:05:17.68,0:05:18.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa boleh?
Dialogue: 0,0:05:18.55,0:05:20.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja!
Dialogue: 0,0:05:20.25,0:05:23.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan jika tidak keberatan,\Napa saya boleh melihat itu?
Dialogue: 0,0:05:25.80,0:05:29.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengalihkan Mode Pribadi menjadi Mode Biasa.
Dialogue: 0,0:05:30.40,0:05:32.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, tiba-tiba muncul.
Dialogue: 0,0:05:32.95,0:05:36.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, apa papan cahaya itu\Nmenampilkan kata-kata dewa?
Dialogue: 0,0:05:38.43,0:05:40.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak terjadi apa-apa.
Dialogue: 0,0:05:40.45,0:05:42.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini tulisan para dewa?
Dialogue: 0,0:05:43.08,0:05:45.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa membacanya.
Dialogue: 0,0:05:46.68,0:05:50.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal kata-kata dewa sudah\Ndi depan mata! Aku jadi gemas!
Dialogue: 0,0:05:51.98,0:05:54.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya tulisan ini?
Dialogue: 0,0:05:54.85,0:05:57.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu adalah "rumput wkwk".
Dialogue: 0,0:05:57.55,0:05:59.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ru-Rumput?!
Dialogue: 0,0:05:59.48,0:06:04.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam bahasa para dewa,\N"rumput wkwk" artinya "tawa".
Dialogue: 0,0:06:04.63,0:06:09.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai turunannya ada istilah\N"wkwk parah" dan "banyak wkwk".
Dialogue: 0,0:06:10.10,0:06:11.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:06:11.55,0:06:17.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senyuman dan tawa orang-orang\Ndiibaratkan sebagai rumput bergoyang.
Dialogue: 0,0:06:17.05,0:06:19.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para dewa memang hebat.
Dialogue: 0,0:06:20.53,0:06:23.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu adalah kata yang indah dan puitis.
Dialogue: 0,0:06:25.05,0:06:29.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu cocok dengan keadaan sekarang!\NBanyak wkwk!
Dialogue: 0,0:06:29.28,0:06:32.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu melihat Penyelamat, ada banyak wkwk!
Dialogue: 0,0:06:32.78,0:06:35.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian langsung jago, wkwk parah!
Dialogue: 0,0:06:41.03,0:06:42.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Penyelamat.
Dialogue: 0,0:06:42.55,0:06:45.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Padahal Anda bisa di sini saja.\N- Kamu benar-benar mau pergi?
Dialogue: 0,0:06:45.93,0:06:48.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya. Terima kasih untuk semuanya.
Dialogue: 0,0:06:49.03,0:06:52.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para elf sangat menyayangimu.
Dialogue: 0,0:06:52.75,0:06:56.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah kamu bisa hidup damai\Ntanpa kekurangan apa pun di sini?
Dialogue: 0,0:06:57.95,0:07:02.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika saja aku masih seperti dulu,\Nsaat aku baru keluar dari rumah,
Dialogue: 0,0:07:02.60,0:07:07.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}saat aku belum tahu Internet,\Nmungkin aku akan memilih itu.
Dialogue: 0,0:07:08.25,0:07:10.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, aku menyadarinya.
Dialogue: 0,0:07:10.93,0:07:13.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat ingin bepergian.
Dialogue: 0,0:07:15.78,0:07:19.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menikmati makanan enak,\Nmelihat pemandangan indah,
Dialogue: 0,0:07:20.73,0:07:22.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bertemu berbagai macam orang,
Dialogue: 0,0:07:23.10,0:07:26.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menolong seseorang\Ndan dapat ucapan terima kasih.
Dialogue: 0,0:07:26.45,0:07:29.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata semua itu benar-benar menyenangkan.
Dialogue: 0,0:07:29.50,0:07:32.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menyadarinya berkat kalian.
Dialogue: 0,0:07:32.78,0:07:36.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti.\NAku tidak akan menghentikanmu lagi.
Dialogue: 0,0:07:37.58,0:07:40.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku serahkan ini kepadamu.
Dialogue: 0,0:07:42.13,0:07:44.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu adalah tanda persahabatan\Ndengan bangsa elf.
Dialogue: 0,0:07:45.40,0:07:48.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kamu membawanya,\Nraja dan bangsawan manusia
Dialogue: 0,0:07:48.35,0:07:51.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan memberimu kemudahan.
Dialogue: 0,0:07:51.00,0:07:54.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa Anda yakin memberikan\Nbenda sepenting ini?
Dialogue: 0,0:07:54.58,0:07:57.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu masih tidak cukup untuk membalas budimu.
Dialogue: 0,0:07:57.25,0:08:00.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jasamu terlalu besar.
Dialogue: 0,0:08:02.65,0:08:05.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kembalilah ke sini kapan saja.
Dialogue: 0,0:08:05.35,0:08:07.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elf tidak akan melupakan budimu.
Dialogue: 0,0:08:07.80,0:08:10.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami akan selalu menjadi sahabatmu,
Dialogue: 0,0:08:10.50,0:08:13.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan tanah ini akan terus menjadi rumahmu.
Dialogue: 0,0:08:15.00,0:08:18.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Aku akan kembali suatu hari nanti.
Dialogue: 0,0:08:18.48,0:08:21.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menantikan hari saat kita bertemu lagi.
Dialogue: 0,0:08:21.43,0:08:25.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga perjalananmu dipenuhi rumput wkwk.
Dialogue: 0,0:08:25.75,0:08:26.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu, dua!
Dialogue: 0,0:08:27.73,0:08:29.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Wkwk!\N- Wkwk!
Dialogue: 0,0:08:31.38,0:08:32.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:08:33.08,0:08:36.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata aku bisa terpuruk seperti ini.
Dialogue: 0,0:08:36.79,0:08:39.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat tinggal, kehidupan elite-ku.
Dialogue: 0,0:08:40.85,0:08:42.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang...
Dialogue: 0,0:08:43.10,0:08:44.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana Search.
Dialogue: 0,0:08:46.05,0:08:49.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lorna Hermit tidak perlu ditakuti.
Dialogue: 0,0:08:49.53,0:08:52.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah menyiapkan beberapa pola pelarian.
Dialogue: 0,0:08:52.33,0:08:55.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini adalah pelarian malam\Nyang elite tanpa celah.
Dialogue: 0,0:08:55.33,0:09:00.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata orang elite itu\Nmasih tampak elite saat kabur!
Dialogue: 0,0:09:01.83,0:09:02.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Loh?
Dialogue: 0,0:09:02.73,0:09:04.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok auranya
Dialogue: 0,0:09:04.11,0:09:06.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}malah ke arah sini?!
Dialogue: 0,0:09:06.85,0:09:08.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Elmina!
Dialogue: 0,0:09:12.90,0:09:13.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:09:13.93,0:09:15.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok bisa pas banget, sih?
Dialogue: 0,0:09:16.20,0:09:18.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu mau pergi ke suatu tempat?
Dialogue: 0,0:09:18.50,0:09:20.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak.
Dialogue: 0,0:09:20.78,0:09:25.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ja-Jadi, ada keperluan apa?
Dialogue: 0,0:09:25.55,0:09:29.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku habis dari Desa Tersembunyi Elf,\Njadi aku ingin memberimu oleh-oleh.
Dialogue: 0,0:09:29.65,0:09:31.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}De-Desa Tersembunyi Elf?
Dialogue: 0,0:09:31.60,0:09:33.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oleh-oleh untukmu...
Dialogue: 0,0:09:34.38,0:09:35.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kejutan!
Dialogue: 0,0:09:36.05,0:09:38.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Mahkota? Punya siapa ini?
Dialogue: 0,0:09:38.63,0:09:40.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, seram!
Dialogue: 0,0:09:40.15,0:09:43.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Ini dapat dari mana?
Dialogue: 0,0:09:44.55,0:09:47.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mendapatkan itu di Desa Tersembunyi Elf.
Dialogue: 0,0:09:47.88,0:09:48.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mahkota ini?
Dialogue: 0,0:09:48.95,0:09:49.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:09:50.15,0:09:53.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mahkota itu jatuh di depanku\Nsetelah aku mengalahkan musuh!
Dialogue: 0,0:09:53.56,0:09:56.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mahkotanya jatuh setelah mengalahkan musuh?
Dialogue: 0,0:09:56.47,0:09:57.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan,
Dialogue: 0,0:09:59.25,0:10:00.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia merampas takhta?!
Dialogue: 0,0:10:01.75,0:10:03.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:10:03.88,0:10:07.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bencana alam di Hutan Ipple tempo hari.
Dialogue: 0,0:10:07.18,0:10:11.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerusakannya hanya terpusat\Ndi dekat penghalang Kabut Sesat.
Dialogue: 0,0:10:12.72,0:10:14.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Artinya,
Dialogue: 0,0:10:16.00,0:10:18.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia sengaja menciptakan bencana alam itu
Dialogue: 0,0:10:18.75,0:10:22.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk memusnahkan\Ndesa elf dari luar penghalang?
Dialogue: 0,0:10:23.38,0:10:25.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada banyak musuh di dalam desa.
Dialogue: 0,0:10:25.60,0:10:28.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi repot membereskan mereka.
Dialogue: 0,0:10:28.33,0:10:29.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bangsa elf?
Dialogue: 0,0:10:29.80,0:10:32.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi mereka menjatuhkan\Nbermacam-macam barang,
Dialogue: 0,0:10:32.95,0:10:34.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi aku sedikit cuan.
Dialogue: 0,0:10:34.68,0:10:35.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hehe.
Dialogue: 0,0:10:35.91,0:10:38.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bisa tersenyum seperti itu\Nsetelah melakukan penjarahan?!
Dialogue: 0,0:10:39.30,0:10:42.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti inikah nasib orang-orang\Nyang melawan Lorna Hermit?
Dialogue: 0,0:10:44.15,0:10:45.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika dia cerita kepadaku...
Dialogue: 0,0:10:46.70,0:10:49.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya adalah giliranmu!
Dialogue: 0,0:10:52.58,0:10:53.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Elmina?
Dialogue: 0,0:10:53.59,0:10:55.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu menangis?
Dialogue: 0,0:10:56.10,0:10:58.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ja-Jangan dibunuh...
Dialogue: 0,0:10:58.35,0:10:59.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Musuhnya?
Dialogue: 0,0:11:00.68,0:11:01.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:11:01.83,0:11:04.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia kasihan sama monster yang kukalahkan
Dialogue: 0,0:11:04.02,0:11:05.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan meneteskan air mata.
Dialogue: 0,0:11:06.68,0:11:10.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Elmina itu seperti gadis suci saja.
Dialogue: 0,0:11:15.08,0:11:19.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk seratus Maboroleaf,\Nkamu mendapatkan lima juta shil.
Dialogue: 0,0:11:19.12,0:11:20.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asyik!
Dialogue: 0,0:11:20.71,0:11:23.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang aku punya modal buat jalan-jalan.
Dialogue: 0,0:11:24.50,0:11:25.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Elmina.
Dialogue: 0,0:11:26.37,0:11:29.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memutuskan untuk pergi dari kota ini.
Dialogue: 0,0:11:29.30,0:11:31.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Benarkah?
Dialogue: 0,0:11:31.28,0:11:35.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya. Jadi aku ingin berpamitan.
Dialogue: 0,0:11:36.00,0:11:39.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Elmina.\NTerima kasih untuk semuanya.
Dialogue: 0,0:11:40.47,0:11:43.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan melupakanmu.
Dialogue: 0,0:11:43.50,0:11:48.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa artinya...\Naku tidak dibutuhkan lagi?
Dialogue: 0,0:11:48.44,0:11:49.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:11:49.98,0:11:52.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya "tidak dibutuhkan lagi"?
Dialogue: 0,0:11:52.45,0:11:54.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku harus bertanya balik?
Dialogue: 0,0:11:54.95,0:11:57.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, antreannya cukup panjang.
Dialogue: 0,0:11:58.60,0:12:01.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika aku tidak menjawab,\Njadinya malah tidak sopan.
Dialogue: 0,0:12:03.00,0:12:04.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin saja.
Dialogue: 0,0:12:08.58,0:12:10.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi.
Dialogue: 0,0:12:10.65,0:12:13.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata aku akan disingkirkan.
Dialogue: 0,0:12:14.88,0:12:16.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Elmina!
Dialogue: 0,0:12:16.58,0:12:20.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Nona Elmina!\N- Nona Elmina!
Dialogue: 0,0:12:23.83,0:12:26.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah, ini buruk!\NKita diserang Kesatria Kerajaan!
Dialogue: 0,0:12:26.98,0:12:28.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa katamu?!
Dialogue: 0,0:12:28.43,0:12:30.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mansion kita tidak akan bisa bertahan!
Dialogue: 0,0:12:31.78,0:12:35.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus mengumpankan prajurit\Ndan kabur lewat jalan rahasia!
Dialogue: 0,0:12:35.73,0:12:40.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa mereka tahu rencana kita\Ndi Desa Tersembunyi Elf?
Dialogue: 0,0:12:40.45,0:12:43.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau mereka datang\Nkarena garis ley utama lenyap?
Dialogue: 0,0:12:45.83,0:12:47.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rowser!
Dialogue: 0,0:12:47.88,0:12:49.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:12:49.58,0:12:53.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi ini adalah jalan rahasia\Nyang disebutkan sang Penyelamat.
Dialogue: 0,0:12:53.73,0:12:55.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kau...
Dialogue: 0,0:12:55.88,0:12:58.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ratu Elf, Ellhar!
Dialogue: 0,0:12:59.65,0:13:03.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lama tak berjumpa, bocah Gugglekars.
Dialogue: 0,0:13:03.14,0:13:05.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau di sini?!
Dialogue: 0,0:13:05.88,0:13:08.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah dia sedang sekarat\Nkarena serbuk sari racun Zariché?
Dialogue: 0,0:13:12.53,0:13:14.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke-Kenapa kau melakukan ini?!
Dialogue: 0,0:13:14.77,0:13:17.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu masih bertanya kenapa?
Dialogue: 0,0:13:18.28,0:13:21.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu melukai rakyatku yang berharga.
Dialogue: 0,0:13:22.25,0:13:23.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini aku sedang
Dialogue: 0,0:13:24.38,0:13:26.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ngamuk sekebon dan geram pol-polan!
Dialogue: 0,0:13:26.99,0:13:29.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu bahasa kuno?
Dialogue: 0,0:13:30.00,0:13:35.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agar Penyelamat kami, Lorna,\Nbisa kembali ke tanah ini tanpa sungkan,
Dialogue: 0,0:13:35.95,0:13:37.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami akan menyingkirkan kalian!
Dialogue: 0,0:13:37.83,0:13:40.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau menyebutkan nama itu?
Dialogue: 0,0:13:40.45,0:13:42.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ironis sekali.
Dialogue: 0,0:13:42.45,0:13:46.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski paling terobsesi pada kekuatan,
Dialogue: 0,0:13:46.63,0:13:48.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau malah mengusir\Npenyihir terkuat di dunia,
Dialogue: 0,0:13:48.63,0:13:52.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yaitu putrimu sendiri.
Dialogue: 0,0:13:52.02,0:13:55.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lorna adalah penyihir terkuat di dunia?
Dialogue: 0,0:13:55.05,0:13:57.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa maksudmu?!
Dialogue: 0,0:13:57.52,0:14:00.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar manusia dungu.
Dialogue: 0,0:14:00.50,0:14:02.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah waktunya mengakhiri ini.
Dialogue: 0,0:14:03.75,0:14:06.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rencanaku selalu berjalan lancar!
Dialogue: 0,0:14:06.93,0:14:08.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, kenapa?!
Dialogue: 0,0:14:09.80,0:14:11.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa dengan Lorna?!
Dialogue: 0,0:14:11.90,0:14:14.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mungkin berakhir begitu saja!
Dialogue: 0,0:14:14.67,0:14:16.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih belum paham?
Dialogue: 0,0:14:16.48,0:14:19.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu kata-kata\Nyang sangat cocok untukmu.
Dialogue: 0,0:14:22.08,0:14:24.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guggle-lah, Karung Sampah!
Dialogue: 0,0:14:25.65,0:14:26.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah berakhir.
Dialogue: 0,0:14:26.98,0:14:28.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih atas kerja samanya!
Dialogue: 0,0:14:30.10,0:14:35.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, ini semua masih terasa janggal,\Ntermasuk asal benih Queen's Heart Rose.
Dialogue: 0,0:14:36.45,0:14:40.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan gelap makin menguat belakangan ini.
Dialogue: 0,0:14:41.83,0:14:43.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, yah...
Dialogue: 0,0:14:44.10,0:14:47.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama ada Lorna,\Ndunia pasti baik-baik saja.
Dialogue: 0,0:14:57.13,0:15:00.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengusulkan rapat\Ndi tempat terbengkalai seperti ini?
Dialogue: 0,0:15:00.35,0:15:03.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kalian tidak khawatir\Ntentang kebocoran informasi?
Dialogue: 0,0:15:03.38,0:15:07.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak. Kita berada di dalam Benteng Petir.
Dialogue: 0,0:15:08.15,0:15:11.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain memiliki sistem\Npertahanan petir dari artefak,
Dialogue: 0,0:15:11.98,0:15:16.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tempat ini juga dilindungi oleh\Npenjaga terkuat, Singa Petir Eleon.
Dialogue: 0,0:15:18.43,0:15:21.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, masih ada "anomali" itu.
Dialogue: 0,0:15:21.93,0:15:26.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudmu seorang manusia\Nyang menghancurkan Gugglekars?
Dialogue: 0,0:15:26.00,0:15:30.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Dia berhasil menundukkan elf.
Dialogue: 0,0:15:30.75,0:15:35.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan di bawah Kultus Naga Jahat\Nseperti keluarga Gugglekars, Elmina,
Dialogue: 0,0:15:35.03,0:15:37.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bahkan Zariché pun sampai bertekuk lutut.
Dialogue: 0,0:15:39.63,0:15:42.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka saja yang terlalu lemah.
Dialogue: 0,0:15:42.70,0:15:45.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, masih ada keanehan\Ndi Kuil Bawah Tanah Senjakala.
Dialogue: 0,0:15:46.23,0:15:52.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlalu banyak kebetulan.\NSeakan-akan informasi kita bocor.
Dialogue: 0,0:15:55.33,0:15:59.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenanglah.\NRencana kita tidak berubah.
Dialogue: 0,0:16:00.35,0:16:05.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tujuh Dewi terkutuk dan Dua Belas\NJenderal Bintang telah melemah drastis,
Dialogue: 0,0:16:05.00,0:16:08.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan ingatan perang besar kuno pun\Ntelah terkikis zaman.
Dialogue: 0,0:16:09.18,0:16:14.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manusia penikmat damai di era ini\Nsudah tidak bisa menjadi penghalang.
Dialogue: 0,0:16:15.08,0:16:19.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mantra pembuka segel beliau\Npasti bisa segera kita dapatkan.
Dialogue: 0,0:16:20.35,0:16:23.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah saatnya kita melakukan pergerakan.
Dialogue: 0,0:16:23.55,0:16:28.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus membebaskan dewa kita,\NRagnadrake sang Naga Kiamat,
Dialogue: 0,0:16:28.13,0:16:31.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan menyucikan planet kotor ini.
Dialogue: 0,0:16:32.40,0:16:36.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah itu, era kegelapan akan kembali
Dialogue: 0,0:16:36.05,0:16:38.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan kerajaan kuno akan bangkit lagi.
Dialogue: 0,0:16:39.60,0:16:45.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, mari kita mulai.\NProyek Eternal Historia kita.
Dialogue: 0,0:16:58.65,0:17:00.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu mana yang luar biasa.
Dialogue: 0,0:17:00.50,0:17:05.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski Enam Uskup seperti kita bersatu,\Nkita tidak mungkin menang melawannya.
Dialogue: 0,0:17:05.17,0:17:08.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inikah perbedaan level?
Dialogue: 0,0:17:09.55,0:17:11.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lah, sebentar.
Dialogue: 0,0:17:11.05,0:17:13.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa dia?
Dialogue: 0,0:17:14.88,0:17:16.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma berteduh di sini,
Dialogue: 0,0:17:16.48,0:17:19.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi ternyata bersantai\Ndan minum teh begini syahdu juga.
Dialogue: 0,0:17:20.28,0:17:23.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin mereka juga berteduh di sini.
Dialogue: 0,0:17:23.82,0:17:26.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya mereka pakai jas hujan.
Dialogue: 0,0:17:28.60,0:17:31.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gereja Kuno Senjakala, ya.
Dialogue: 0,0:17:31.80,0:17:35.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong,\Ntempat ini benar-benar kosong, ya.
Dialogue: 0,0:17:38.65,0:17:42.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, apa tidak ada yang mengenal gadis itu?
Dialogue: 0,0:17:42.40,0:17:45.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, dia masuk begitu saja.
Dialogue: 0,0:17:45.29,0:17:47.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira ada yang kenal.
Dialogue: 0,0:17:47.40,0:17:49.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain punya kekuatan sebesar itu,
Dialogue: 0,0:17:49.76,0:17:51.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia mengetahui tempat
Dialogue: 0,0:17:51.81,0:17:53.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang dijaga Singa Petir ini,
Dialogue: 0,0:17:53.01,0:17:55.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan duduk di kursi kehormatan,\Nseolah-olah itu kursinya sendiri.
Dialogue: 0,0:17:56.45,0:17:59.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin dia adalah petinggi kultus.
Dialogue: 0,0:17:59.43,0:18:03.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku belum pernah dengar\Napa-apa tentang gadis seperti itu!
Dialogue: 0,0:18:03.65,0:18:07.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika ada sosok sekuat itu,\Nharusnya ada rumor tentangnya!
Dialogue: 0,0:18:07.49,0:18:10.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kalian belum mengerti,\Nsaudara-saudaraku?
Dialogue: 0,0:18:10.80,0:18:13.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihatlah jubah yang dia pakai!
Dialogue: 0,0:18:13.98,0:18:17.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lambang dan kekuatan\Nyang terpancar dari jubah itu...
Dialogue: 0,0:18:17.03,0:18:18.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan...
Dialogue: 0,0:18:18.18,0:18:20.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jubah Ragnarobe Naga Kiamat!
Dialogue: 0,0:18:20.58,0:18:26.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Itu adalah jubah yang dipakai\Noleh "beliau" saat masih jadi manusia.
Dialogue: 0,0:18:27.40,0:18:31.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, seharusnya jubah itu tersegel\Ndi kuil bawah tanah bersama beliau.
Dialogue: 0,0:18:32.45,0:18:33.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan...
Dialogue: 0,0:18:33.84,0:18:36.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis itu adalah...
Dialogue: 0,0:18:37.48,0:18:40.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka melihatku terus dari tadi.
Dialogue: 0,0:18:40.85,0:18:42.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan, mereka semua...
Dialogue: 0,0:18:43.69,0:18:45.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat tuh, udaranya diobok-obok!
Dialogue: 0,0:18:45.83,0:18:47.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang dia lakukan?!
Dialogue: 0,0:18:47.08,0:18:50.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku tidak tahu! Tapi...
Dialogue: 0,0:18:50.73,0:18:56.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita sedang menyaksikan\Nsebagian kecil kekuatan beliau!
Dialogue: 0,0:18:56.73,0:18:58.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku paham sekarang.
Dialogue: 0,0:18:58.60,0:19:03.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka tidak bawa barang-barang.\NMungkin sudah tersambar petir.
Dialogue: 0,0:19:04.35,0:19:08.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka selalu berbisik-bisik\Ndan melirik ke sini terus.
Dialogue: 0,0:19:08.95,0:19:11.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, mereka menangkupkan tangan\Nseperti sedang memohon sesuatu.
Dialogue: 0,0:19:12.29,0:19:14.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin mereka
Dialogue: 0,0:19:14.98,0:19:17.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sedang kehausan!
Dialogue: 0,0:19:18.90,0:19:21.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini adalah ujian.
Dialogue: 0,0:19:21.68,0:19:25.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beliau membuang tubuh naga yang tersegel
Dialogue: 0,0:19:25.00,0:19:28.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan memilih tubuh lain sebagai titisan.
Dialogue: 0,0:19:29.23,0:19:31.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beliau ke sini secara diam-diam
Dialogue: 0,0:19:31.50,0:19:34.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk menguji apa kita\Nmasih bisa mengenali beliau
Dialogue: 0,0:19:35.18,0:19:39.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan apa kita tetap beriman kepadanya.
Dialogue: 0,0:19:39.80,0:19:43.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dipikir begitu,\Nsemuanya jadi masuk akal.
Dialogue: 0,0:19:43.93,0:19:47.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maaf, apa kalian mau minum?
Dialogue: 0,0:19:47.58,0:19:51.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa kita lulus ujian?
Dialogue: 0,0:19:51.75,0:19:54.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, sungguh Maha Pengasih.
Dialogue: 0,0:19:54.75,0:19:58.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami akan mengikuti Anda selamanya!
Dialogue: 0,0:19:59.35,0:20:01.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa mereka haus banget?
Dialogue: 0,0:20:02.90,0:20:06.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku senang karena\Nmereka tidak menyeramkan.
Dialogue: 0,0:20:06.93,0:20:10.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Interaksi seperti inilah\Nyang seru saat bepergian.
Dialogue: 0,0:20:11.73,0:20:14.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat melakukan perjalanan,\Naku tidak mengharapkan bencana,
Dialogue: 0,0:20:14.85,0:20:17.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}memergoki konspirasi penaklukan dunia,
Dialogue: 0,0:20:17.99,0:20:20.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau dipuja sebagai penyelamat.
Dialogue: 0,0:20:20.91,0:20:23.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hal-hal biasa seperti ini sudah cukup.
Dialogue: 0,0:20:23.55,0:20:26.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka pasti lapar karena\Nbarang-barang mereka lenyap.
Dialogue: 0,0:20:27.15,0:20:28.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya.
Dialogue: 0,0:20:29.29,0:20:31.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?!
Dialogue: 0,0:20:33.75,0:20:36.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama, campur telur dan cuka.
Dialogue: 0,0:20:36.60,0:20:40.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, minyak zaitunnya\Nharus ditambahkan dikit-dikit.
Dialogue: 0,0:20:40.51,0:20:43.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buktikan... buktikan iman kita...
Dialogue: 0,0:20:43.73,0:20:46.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minuman yang dicintai para dewa!
Dialogue: 0,0:20:46.13,0:20:48.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akan membuat "mayones"!
Dialogue: 0,0:20:48.53,0:20:52.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya "mayones" adalah minuman\Nyang selalu dinikmati para dewa
Dialogue: 0,0:20:52.75,0:20:56.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena sangat enak dan kaya gizi!
Dialogue: 0,0:20:56.75,0:20:59.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sangat unggul sebagai\Nmakanan darurat dan bekal,
Dialogue: 0,0:20:59.70,0:21:01.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi saat para dewa pergi ke dunia lain,
Dialogue: 0,0:21:01.93,0:21:05.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mereka menganggap bahwa\Nbikin "mayones" adalah kewajiban.
Dialogue: 0,0:21:05.16,0:21:10.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.\NMirip makanan tipis elf terkutuk itu, ya?
Dialogue: 0,0:21:10.48,0:21:11.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:21:11.65,0:21:14.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kita bisa menciptakan\Nmakanan praktis para dewa,
Dialogue: 0,0:21:14.85,0:21:18.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jangankan konsep logistik,\Nbahkan perang pun bisa berubah.
Dialogue: 0,0:21:19.05,0:21:21.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemikiran yang begitu mendalam.
Dialogue: 0,0:21:23.15,0:21:26.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bikin sesuatu bareng-bareng begini\Nternyata asyik banget, ya.
Dialogue: 0,0:21:26.43,0:21:27.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:21:30.48,0:21:33.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini susah mengental.
Dialogue: 0,0:21:33.73,0:21:37.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya! Aku dapat ide bagus!
Dialogue: 0,0:21:37.11,0:21:39.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya, coba lihat ini!
Dialogue: 0,0:21:39.55,0:21:40.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:21:40.50,0:21:42.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini namanya "video tutorial masak".
Dialogue: 0,0:21:42.85,0:21:44.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sulit dijelaskan,
Dialogue: 0,0:21:44.90,0:21:48.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi ini bisa mengajarkan\Ncara membuat berbagai hal.
Dialogue: 0,0:21:48.37,0:21:50.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan...
Dialogue: 0,0:21:50.03,0:21:51.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu Kitab Penciptaan?!
Dialogue: 0,0:21:52.65,0:21:54.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika dilihat, kalian pasti paham.
Dialogue: 0,0:21:55.67,0:21:58.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ihh, kamu pegang apaan?
Dialogue: 0,0:22:01.49,0:22:06.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ja-Jangan "mengembangkan" bagian itu,\NKakak Sayang.
Dialogue: 0,0:22:06.70,0:22:08.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak Sayang.
Dialogue: 0,0:22:08.88,0:22:10.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak Sayang.
