Dialogue: 0,0:23:39.03,0:23:42.98,sign,,0000,0000,0000,,ANIME FOREX YANG SANTAI, IMUT,\NDAN ADA NUANSA {\i1}SLICE OF LIFE{\i0}-NYA...
Dialogue: 0,0:23:42.99,0:23:45.05,sign,,0000,0000,0000,,TERIMA KASIH SUDAH MENONTON!\NTANSAN DAISUKI
Dialogue: 0,0:00:12.11,0:00:14.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon sekali, Tuhan!
Dialogue: 0,0:00:14.87,0:00:16.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Uang ini enggak boleh habis!
Dialogue: 0,0:00:22.75,0:00:24.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Uang ini...
Dialogue: 0,0:00:25.00,0:00:27.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}benar-benar enggak boleh habis!
Dialogue: 0,0:00:28.38,0:00:33.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bisa... tolong putar balik waktunya!
Dialogue: 0,0:00:34.75,0:00:37.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mengapa manusia tak pernah sadar{\i0}
Dialogue: 0,0:00:37.80,0:00:41.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}kalau mereka berdiri di tepi keputusasaan\Nsebelum momen itu tiba?{\i0}
Dialogue: 0,0:00:41.90,0:00:43.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong.
Dialogue: 0,0:00:45.02,0:00:48.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidaaaakkk!
Dialogue: 0,0:02:23.04,0:02:23.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Waktu itu,{\i0}
Dialogue: 0,0:02:25.22,0:02:28.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}berita ramai soal krisis ekonomi\Nsekali dalam 100 tahun{\i0}
Dialogue: 0,0:02:29.04,0:02:31.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}atau krisis keuangan global.{\i0}
Dialogue: 0,0:02:31.67,0:02:33.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Topiknya itu-itu saja.{\i0}
Dialogue: 0,0:02:34.93,0:02:36.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bagiku yang saat itu masih SMP,{\i0}
Dialogue: 0,0:02:37.40,0:02:41.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}aku enggak paham dan enggak tertarik.{\i0}
Dialogue: 0,0:02:43.31,0:02:46.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, apa ini sudah benar?
Dialogue: 0,0:02:47.27,0:02:48.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, bagian ini...
Dialogue: 0,0:02:49.00,0:02:51.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu masukkan jawaban ini,\Njadinya begini.
Dialogue: 0,0:02:52.53,0:02:54.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurumi pintar sekali!
Dialogue: 0,0:02:56.32,0:02:57.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya makan siang!
Dialogue: 0,0:02:57.66,0:02:59.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Matematika bikin capek!
Dialogue: 0,0:02:59.78,0:03:01.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Lapar banget, ya?\N- Loh?
Dialogue: 0,0:03:01.70,0:03:04.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya kamu biasanya bawa bekal?
Dialogue: 0,0:03:04.58,0:03:06.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibuku sepertinya sedang sibuk.
Dialogue: 0,0:03:06.89,0:03:09.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hitung-hitung berbakti pada orang tua.
Dialogue: 0,0:03:10.36,0:03:12.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, kamu hebat!
Dialogue: 0,0:03:12.96,0:03:14.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biasa aja, sih.
Dialogue: 0,0:03:19.01,0:03:20.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, hujan!
Dialogue: 0,0:03:21.36,0:03:23.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo beli payung dulu!
Dialogue: 0,0:03:23.02,0:03:25.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rumahku dekat. Enggak apa-apa!
Dialogue: 0,0:03:25.27,0:03:27.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Sampai ketemu minggu depan!\N- Eh, Kurumi!
Dialogue: 0,0:03:32.27,0:03:35.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harusnya aku beli payung tadi.
Dialogue: 0,0:03:39.49,0:03:41.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pulang.
Dialogue: 0,0:03:41.51,0:03:42.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gelap banget!
Dialogue: 0,0:03:44.11,0:03:46.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampah juga belum dibuang.
Dialogue: 0,0:03:48.84,0:03:52.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu belakangan ini malas\Nmengurus pekerjaan rumah.
Dialogue: 0,0:03:52.60,0:03:54.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu? Ada di rumah?
Dialogue: 0,0:03:54.91,0:03:57.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti Ayah marah kalau pulang, lho.
Dialogue: 0,0:03:58.13,0:03:59.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa, sih?!
Dialogue: 0,0:04:01.93,0:04:03.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan coba?!
Dialogue: 0,0:04:05.10,0:04:07.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Ibu?
Dialogue: 0,0:04:08.44,0:04:09.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mohon!
Dialogue: 0,0:04:09.71,0:04:11.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ini tembus, semuanya hancur!
Dialogue: 0,0:04:12.27,0:04:15.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biarkan aku menang sekali saja!
Dialogue: 0,0:04:16.58,0:04:17.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Naiklah!
Dialogue: 0,0:04:20.22,0:04:21.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus!
Dialogue: 0,0:04:21.36,0:04:22.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, terus!
Dialogue: 0,0:04:23.37,0:04:26.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo! Ayo! Ayo!
Dialogue: 0,0:04:28.83,0:04:30.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bercanda!
Dialogue: 0,0:04:30.54,0:04:32.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bercanda!
Dialogue: 0,0:04:32.50,0:04:34.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa yang suruh naik?!
Dialogue: 0,0:04:35.64,0:04:38.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu?
Dialogue: 0,0:04:40.64,0:04:41.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa ribut-ribut?
Dialogue: 0,0:04:45.18,0:04:46.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu...
Dialogue: 0,0:04:47.93,0:04:49.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedang apa?
Dialogue: 0,0:04:50.09,0:04:51.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurumi...
Dialogue: 0,0:04:53.87,0:04:56.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang di komputer itu...
Dialogue: 0,0:04:56.69,0:04:58.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, Forex.
Dialogue: 0,0:05:00.11,0:05:01.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Forex itu
Dialogue: 0,0:05:01.98,0:05:05.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang ada hubungannya\Nsama uang, kan?
Dialogue: 0,0:05:05.38,0:05:06.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, benar.
Dialogue: 0,0:05:06.98,0:05:09.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berapa banyak yang Ibu pakai?
Dialogue: 0,0:05:10.21,0:05:11.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}20 juta.
Dialogue: 0,0:05:11.37,0:05:12.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:05:12.33,0:05:14.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Kenapa?!
Dialogue: 0,0:05:14.82,0:05:16.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan salahku!
Dialogue: 0,0:05:17.07,0:05:19.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan! Ini bukan salahku!
Dialogue: 0,0:05:19.53,0:05:23.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bakal naik!\NSoalnya katanya pasti naik!
Dialogue: 0,0:05:25.30,0:05:26.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya...
Dialogue: 0,0:05:32.67,0:05:35.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu mohon, Kurumi.
Dialogue: 0,0:05:35.44,0:05:38.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan beri tahu Ayah, ya?
Dialogue: 0,0:05:39.71,0:05:40.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong...
Dialogue: 0,0:05:43.29,0:05:44.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu...
Dialogue: 0,0:05:48.20,0:05:49.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak mau!
Dialogue: 0,0:05:49.70,0:05:52.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak mau keluargaku cerai!
Dialogue: 0,0:05:53.49,0:05:56.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku... harus melakukan sesuatu!{\i0}
Dialogue: 0,0:05:57.27,0:06:01.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kalau enggak salah, anak SMP\Nbisa bekerja kalau dapat izin.{\i0}
Dialogue: 0,0:06:02.96,0:06:06.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Benar, Ayah sedang dinas di luar kota.{\i0}
Dialogue: 0,0:06:07.40,0:06:10.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kalau bisa dapatkan 20 juta kembali\Nsebelum ketahuan,{\i0}
Dialogue: 0,0:06:10.31,0:06:12.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}mereka enggak akan cerai!{\i0}
Dialogue: 0,0:06:13.53,0:06:14.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:06:14.73,0:06:18.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kita berdua bekerja,\Nuangnya akan terkumpul lebih cepat!
Dialogue: 0,0:06:18.44,0:06:21.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu juga baru pulang, kan?
Dialogue: 0,0:06:22.03,0:06:24.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak kecil enggak perlu memikirkan itu.
Dialogue: 0,0:06:25.03,0:06:27.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini tanggung jawab Ibu.
Dialogue: 0,0:06:27.20,0:06:30.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu aku pikirkan!\NAku enggak mau kalian cerai!
Dialogue: 0,0:06:30.20,0:06:32.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu itu pintar, Kurumi.
Dialogue: 0,0:06:32.91,0:06:35.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belajarlah yang rajin seperti biasa.
Dialogue: 0,0:06:35.71,0:06:36.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:06:36.96,0:06:39.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan begitu, pasti akan ada hal baik.
Dialogue: 0,0:06:43.09,0:06:45.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kebiasaan, deh! Nganggap aku anak kecil!
Dialogue: 0,0:06:45.38,0:06:47.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang dewasa selalu aja begitu!
Dialogue: 0,0:06:48.51,0:06:51.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sejak hari itu, Ibu mulai bekerja.{\i0}
Dialogue: 0,0:06:51.64,0:06:53.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mungkin karena punya banyak kerjaan,{\i0}
Dialogue: 0,0:06:53.56,0:06:55.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ibu pulang makin larut malam.{\i0}
Dialogue: 0,0:06:56.67,0:06:58.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku mengambil ini dari kamar Ibu...{\i0}
Dialogue: 0,0:06:58.21,0:06:59.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku mengambil ini dari kamar Ibu...{\i0}
Dialogue: 0,0:07:00.19,0:07:03.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ibu mencoba dapat untung\Ndari ini, tapi gagal.{\i0}
Dialogue: 0,0:07:04.60,0:07:07.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Lagian, Forex itu...{\i0}
Dialogue: 0,0:07:07.71,0:07:09.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Forex itu apaan?{\i0}
Dialogue: 0,0:07:13.04,0:07:14.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Valuta asing?{\i0}
Dialogue: 0,0:07:14.50,0:07:16.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dolar atau yen?{\i0}
Dialogue: 0,0:07:16.37,0:07:18.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku kurang paham, tapi...{\i0}
Dialogue: 0,0:07:24.01,0:07:27.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sesuatu yang bisa melenyapkan\N20 juta dengan mudah.{\i0}
Dialogue: 0,0:07:28.16,0:07:31.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tapi kalau bisa melenyapkan uang...{\i0}
Dialogue: 0,0:07:34.27,0:07:35.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}sebaliknya,{\i0}
Dialogue: 0,0:07:35.62,0:07:39.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}bisa dibilang ini juga cara\Nmenghasilkan 20 juta dengan mudah!{\i0}
Dialogue: 0,0:07:41.18,0:07:44.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Artinya, kalau aku mempelajarinya\Ndengan sungguh-sungguh,{\i0}
Dialogue: 0,0:07:44.19,0:07:46.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}aku juga bisa menghasilkan uang...{\i0}
Dialogue: 0,0:07:50.89,0:07:53.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Minimal berusia 18 tahun.{\i0}
Dialogue: 0,0:07:53.58,0:07:56.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Surat izin orang tua\Njelas enggak mungkin.{\i0}
Dialogue: 0,0:07:58.80,0:08:02.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ya sudah. Aku akan terus belajar.{\i0}
Dialogue: 0,0:08:02.80,0:08:04.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sampai umurku 20 tahun,{\i0}
Dialogue: 0,0:08:05.27,0:08:09.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}lalu kudapatkan kembali 20 juta\Ndengan mudah!{\i0}
Dialogue: 0,0:08:14.16,0:08:16.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurumi, kamu sedang baca apa?
Dialogue: 0,0:08:16.64,0:08:18.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, ini...
Dialogue: 0,0:08:18.64,0:08:20.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, aku tahu itu!
Dialogue: 0,0:08:20.98,0:08:23.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, anak SMP memangnya bisa?
Dialogue: 0,0:08:23.27,0:08:26.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, aku mau coba kalau sudah dewasa.
Dialogue: 0,0:08:26.44,0:08:29.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Menurutku sebaiknya jangan.
Dialogue: 0,0:08:32.41,0:08:36.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rumornya banyak orang\Nbunuh diri karena gagal.
Dialogue: 0,0:09:01.33,0:09:04.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ibu bekerja terlalu keras.{\i0}
Dialogue: 0,0:09:04.90,0:09:07.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Baru dua bulan, tapi sudah seperti itu...{\i0}
Dialogue: 0,0:09:07.58,0:09:10.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku enggak bisa tinggal diam lagi.{\i0}
Dialogue: 0,0:09:11.33,0:09:13.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu...
Dialogue: 0,0:09:15.42,0:09:18.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pekerjaan Ibu enggak berat?
Dialogue: 0,0:09:18.96,0:09:20.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak apa-apa, kok.
Dialogue: 0,0:09:20.41,0:09:22.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu berusaha agar Ayah enggak tahu.
Dialogue: 0,0:09:23.04,0:09:25.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan itu yang aku tanyakan!
Dialogue: 0,0:09:26.67,0:09:28.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untung saja, ya.
Dialogue: 0,0:09:28.53,0:09:33.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya Ayah enggak bisa pulang\Nsaat libur akhir tahun.
Dialogue: 0,0:09:36.04,0:09:39.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Padahal aku ingin Ayah cepat pulang.{\i0}
Dialogue: 0,0:09:51.11,0:09:55.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu, hari ini Ayah pulang, kan?
Dialogue: 0,0:09:56.53,0:09:59.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jujur saja, yuk.
Dialogue: 0,0:09:59.04,0:10:01.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak akan\Nbiarkan kalian bercerai.
Dialogue: 0,0:10:01.46,0:10:04.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga akan ikut minta maaf.
Dialogue: 0,0:10:04.02,0:10:04.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke?
Dialogue: 0,0:10:05.13,0:10:06.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Uangnya juga...
Dialogue: 0,0:10:07.07,0:10:08.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang memang belum bisa,
Dialogue: 0,0:10:08.69,0:10:11.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku pasti akan\Nmendapatkannya kembali!
Dialogue: 0,0:10:11.30,0:10:12.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil.
Dialogue: 0,0:10:13.72,0:10:14.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurumi...
Dialogue: 0,0:10:15.30,0:10:16.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu meremehkannya, kan?
Dialogue: 0,0:10:18.89,0:10:21.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gara-gara siapa semua ini terjadi?!
Dialogue: 0,0:10:23.38,0:10:24.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu benar, maafkan Ibu.
Dialogue: 0,0:10:25.60,0:10:26.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu belanja dulu, ya.
Dialogue: 0,0:10:26.86,0:10:28.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak usah! Aku saja yang pergi!
Dialogue: 0,0:10:29.87,0:10:33.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu siapkan saja\Npermintaan maaf untuk ayah!
Dialogue: 0,0:10:49.29,0:10:50.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:10:51.16,0:10:52.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa Ibu enggak ada?
Dialogue: 0,0:10:56.05,0:10:58.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh! Ibu pergi ke mana, sih?!
Dialogue: 0,0:11:00.51,0:11:01.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah pulang.
Dialogue: 0,0:11:02.42,0:11:03.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah!
Dialogue: 0,0:11:04.40,0:11:07.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana ini? Ibu belum pulang!
Dialogue: 0,0:11:07.42,0:11:09.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu berlebihan sekali.
Dialogue: 0,0:11:09.91,0:11:11.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin ke minimarket?
Dialogue: 0,0:11:11.49,0:11:14.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan! Sebenarnya...
Dialogue: 0,0:11:16.36,0:11:18.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuh, palingan juga ibumu.
Dialogue: 0,0:11:19.53,0:11:20.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, sebentar.
Dialogue: 0,0:11:23.79,0:11:25.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo, dengan Fukuga.
Dialogue: 0,0:11:26.08,0:11:27.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, baik.
Dialogue: 0,0:11:28.33,0:11:29.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:11:30.54,0:11:31.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:11:35.67,0:11:36.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:11:36.47,0:11:37.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bunuh diri.
Dialogue: 0,0:11:37.34,0:11:38.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya melompat.
Dialogue: 0,0:11:38.69,0:11:39.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serius?
Dialogue: 0,0:11:39.43,0:11:41.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya seorang wanita paruh baya.
Dialogue: 0,0:11:58.49,0:12:00.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Parah sekali. Kenapa?
Dialogue: 0,0:12:00.41,0:12:01.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa bisa?
Dialogue: 0,0:12:10.63,0:12:11.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurumi.
Dialogue: 0,0:12:14.46,0:12:15.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya jangan lihat.
Dialogue: 0,0:12:20.04,0:12:21.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Akulah...{\i0}
Dialogue: 0,0:12:22.51,0:12:23.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}yang membunuhnya.{\i0}
Dialogue: 0,0:12:32.48,0:12:33.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan!
Dialogue: 0,0:12:33.80,0:12:35.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan aku yang membunuhnya!
Dialogue: 0,0:12:36.13,0:12:39.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mengandalkanku sejak awal,\Nibu enggak akan mati!
Dialogue: 0,0:12:40.11,0:12:42.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu bodoh! Bodoh!
Dialogue: 0,0:12:42.71,0:12:44.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal enggak bisa belajar\Ndengan benar!
Dialogue: 0,0:12:44.84,0:12:46.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malah ikut-ikutan main Forex!
Dialogue: 0,0:12:47.00,0:12:50.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal ibu itu orang dungu\Nyang enggak bisa matematika SMP!
Dialogue: 0,0:12:50.96,0:12:52.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku...
Dialogue: 0,0:12:53.04,0:12:55.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seandainya aku bukan anak-anak...
Dialogue: 0,0:12:56.44,0:12:59.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Andaikan aku sudah dewasa...
Dialogue: 0,0:13:00.91,0:13:04.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurumi, terima kasih sudah dibantu.
Dialogue: 0,0:13:05.36,0:13:09.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu enggak jago matematika,\Njadi ajari Ibu, ya, Kurumi.
Dialogue: 0,0:13:17.36,0:13:19.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurumi, coba lihat ini.
Dialogue: 0,0:13:20.00,0:13:21.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Indah sekali, kan?
Dialogue: 0,0:13:24.11,0:13:24.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, kan?
Dialogue: 0,0:13:50.09,0:13:51.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sebanyak apa pun kuberharap,{\i0}
Dialogue: 0,0:13:52.48,0:13:54.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}waktu enggak bisa diputar kembali.{\i0}
Dialogue: 0,0:13:55.67,0:13:57.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, selesai.
Dialogue: 0,0:13:57.76,0:14:01.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, untunglah Ayah\Nbisa pindah lokasi kerja.
Dialogue: 0,0:14:02.24,0:14:04.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang Ayah bisa berangkat dari rumah.
Dialogue: 0,0:14:05.12,0:14:06.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:14:06.62,0:14:08.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengemasi barang ternyata cepat selesai.
Dialogue: 0,0:14:08.24,0:14:10.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengemasi barang ternyata cepat selesai.
Dialogue: 0,0:14:12.56,0:14:14.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu menemukan sesuatu?
Dialogue: 0,0:14:14.17,0:14:15.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak, bukan apa-apa.
Dialogue: 0,0:14:18.93,0:14:20.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengar, Kurumi.
Dialogue: 0,0:14:21.04,0:14:23.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sekali-kali kamu main Forex.
Dialogue: 0,0:14:25.16,0:14:27.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah enggak bilang investasi itu buruk.
Dialogue: 0,0:14:27.30,0:14:29.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi tanpa terjun begitu pun,
Dialogue: 0,0:14:29.98,0:14:32.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu tetap bisa bahagia.
Dialogue: 0,0:14:33.73,0:14:34.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:14:35.09,0:14:36.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku paham, kok.
Dialogue: 0,0:14:42.24,0:14:44.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mungkin ini adalah...{\i0}
Dialogue: 0,0:14:45.41,0:14:47.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}pertarungan demi kepuasan diri.{\i0}
Dialogue: 0,0:14:48.62,0:14:51.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ibu enggak akan pernah kembali lagi.{\i0}
Dialogue: 0,0:14:52.24,0:14:53.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tapi,{\i0}
Dialogue: 0,0:14:53.76,0:14:55.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}kalau aku berusaha keras...{\i0}
Dialogue: 0,0:14:55.80,0:14:58.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}seharusnya Ibu enggak perlu mati.{\i0}
Dialogue: 0,0:14:59.22,0:15:01.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku ingin membuktikannya.{\i0}
Dialogue: 0,0:15:14.64,0:15:16.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sembari memikirkan itu,{\i0}
Dialogue: 0,0:15:18.27,0:15:19.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}lima tahun pun berlalu.{\i0}
Dialogue: 0,0:15:38.56,0:15:40.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Persiapan pertarunganku sudah matang.{\i0}
Dialogue: 0,0:15:41.25,0:15:43.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Demi membuat Ayah tenang,{\i0}
Dialogue: 0,0:15:43.80,0:15:46.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}aku memilih kuliah dari rumah.{\i0}
Dialogue: 0,0:15:46.88,0:15:49.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku mendapat beasiswa potongan 50% biaya.{\i0}
Dialogue: 0,0:15:50.11,0:15:52.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku enggak mau membebani keluarga,{\i0}
Dialogue: 0,0:15:52.26,0:15:55.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}jadi separuh sisanya\Nkucari lewat kerja patuh waktu.{\i0}
Dialogue: 0,0:15:56.23,0:15:57.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sambil membayar kuliah,{\i0}
Dialogue: 0,0:15:57.85,0:16:00.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}aku berhasil mengumpulkan modal awal{\i0}
Dialogue: 0,0:16:00.48,0:16:01.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}sebesar 300 ribu yen.{\i0}
Dialogue: 0,0:16:02.87,0:16:04.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Inilah garis startku.{\i0}
Dialogue: 0,0:16:06.13,0:16:09.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Lalu, ini medan perangku.{\i0}
Dialogue: 0,0:16:12.64,0:16:14.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Forex adalah{\i0}
Dialogue: 0,0:16:14.33,0:16:17.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}perdagangan valuta asing fluktuatif{\i0}
Dialogue: 0,0:16:17.51,0:16:19.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}untuk meraih untung dari selisih nilai.{\i0}
Dialogue: 0,0:16:20.53,0:16:23.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Berikutnya, krisis keuangan meluas.{\i0}
Dialogue: 0,0:16:23.02,0:16:24.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Karena pergerakan pasar{\i0}
Dialogue: 0,0:16:24.92,0:16:27.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dipengaruhi kondisi dunia dan ekonomi,{\i0}
Dialogue: 0,0:16:28.43,0:16:30.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}prediksi akurat itu mustahil.{\i0}
Dialogue: 0,0:16:31.09,0:16:32.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Selain itu,{\i0}
Dialogue: 0,0:16:32.47,0:16:35.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Forex sangat sulit dimenangkan\Ndalam jangka panjang.{\i0}
Dialogue: 0,0:16:36.43,0:16:38.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Makin lama kita melakukannya,{\i0}
Dialogue: 0,0:16:38.10,0:16:41.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}makin tinggi risiko\Nmenghadapi situasi tak terduga.{\i0}
Dialogue: 0,0:16:42.19,0:16:44.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jika hanya mengincar jumlah kecil,{\i0}
Dialogue: 0,0:16:44.36,0:16:47.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}ada cara yang mendekati\Nkemenangan mutlak.{\i0}
Dialogue: 0,0:16:52.11,0:16:54.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jadi, buang harapan naif sejak awal{\i0}
Dialogue: 0,0:16:54.87,0:16:58.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dan sadari bahwa enggak mungkin\Nmenang jangka panjang.{\i0}
Dialogue: 0,0:16:59.04,0:17:01.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ditambah lagi, target uangku adalah...{\i0}
Dialogue: 0,0:17:02.20,0:17:03.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}20 juta yen.{\i0}
Dialogue: 0,0:17:04.04,0:17:05.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Menanggung risiko itu sudah pasti.{\i0}
Dialogue: 0,0:17:07.16,0:17:09.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Artinya, aku harus siap\Nmengambil risiko tinggi{\i0}
Dialogue: 0,0:17:10.00,0:17:11.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dan bertarung dalam jangka pendek!{\i0}
Dialogue: 0,0:17:19.29,0:17:20.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Risiko besar diambil di awal,{\i0}
Dialogue: 0,0:17:21.24,0:17:23.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}saat dampaknya masih terhitung kecil.{\i0}
Dialogue: 0,0:17:24.13,0:17:24.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hati-hati, pintu ditutup.
Dialogue: 0,0:17:24.90,0:17:25.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Benar.{\i0}
Dialogue: 0,0:17:26.42,0:17:28.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku enggak pakai pialang Forex lokal,{\i0}
Dialogue: 0,0:17:29.91,0:17:30.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}tapi...{\i0}
Dialogue: 0,0:17:32.84,0:17:37.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}pialang luar negeri dengan risiko\Ndan keuntungan tinggi.{\i0}
Dialogue: 0,0:17:41.33,0:17:45.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Lalu, syarat utama untuk menang\Ndi Forex adalah...{\i0}
Dialogue: 0,0:17:49.11,0:17:51.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}...berhenti bermain Forex.{\i0}
Dialogue: 0,0:17:51.64,0:17:54.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Singkatnya... kabur saat untung!{\i0}
Dialogue: 0,0:17:55.56,0:17:59.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Metode pesanan baru dan penyelesaian,
Dialogue: 0,0:17:59.47,0:18:00.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}semua sudah siap.
Dialogue: 0,0:18:01.96,0:18:03.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Medan perang pilihanku\Nadalah USD-JPY.{\i0}
Dialogue: 0,0:18:04.06,0:18:07.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pasangan mata uang populer ini\Npas untuk awal pertarungan.{\i0}
Dialogue: 0,0:18:09.07,0:18:11.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Karena menargetkan\Nperdagangan singkat,{\i0}
Dialogue: 0,0:18:12.32,0:18:14.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}grafik lilin kuatur ke 5 menit.{\i0}
Dialogue: 0,0:18:16.07,0:18:18.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tenang, lakukan sesuai latihan.{\i0}
Dialogue: 0,0:18:20.33,0:18:22.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Berdasarkan analisisku,{\i0}
Dialogue: 0,0:18:22.33,0:18:25.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}USD-JPY masih punya ruang untuk naik.{\i0}
Dialogue: 0,0:18:28.59,0:18:29.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang!
Dialogue: 0,0:18:30.07,0:18:32.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beli USD-JPY sebanyak 30 lot!
Dialogue: 0,0:18:47.19,0:18:48.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus!
Dialogue: 0,0:18:48.13,0:18:49.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harga belinya tepat!
Dialogue: 0,0:18:49.60,0:18:50.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teruslah naik!
Dialogue: 0,0:18:56.87,0:18:58.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat!
Dialogue: 0,0:18:59.47,0:19:02.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah dapat setara gaji seharian!
Dialogue: 0,0:19:03.42,0:19:05.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak, ini wajar.
Dialogue: 0,0:19:06.08,0:19:08.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku memegang 30 lot.{\i0}
Dialogue: 0,0:19:09.11,0:19:12.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Secara sederhana,\Npergerakan 1 yen saja{\i0}
Dialogue: 0,0:19:12.38,0:19:14.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}bisa membuat untung rugi 300 ribu yen!{\i0}
Dialogue: 0,0:19:15.67,0:19:17.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Artinya kalau momennya tepat,{\i0}
Dialogue: 0,0:19:17.68,0:19:19.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}gaji per jam... enggak, per menit...{\i0}
Dialogue: 0,0:19:20.01,0:19:22.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}bahkan per detik bisa dapat 1.000 yen!{\i0}
Dialogue: 0,0:19:28.00,0:19:29.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berbalik?! Ini batasnya?!
Dialogue: 0,0:19:33.60,0:19:34.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak...
Dialogue: 0,0:19:37.31,0:19:38.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}masih bisa naik!
Dialogue: 0,0:19:42.78,0:19:44.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}24.000 yen?
Dialogue: 0,0:19:44.87,0:19:47.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Cu-Cuma dalam lima menit...{\i0}
Dialogue: 0,0:19:49.04,0:19:51.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku dapat lebih banyak\Ndari Yamaguchi di tempat kerja...{\i0}
Dialogue: 0,0:19:52.25,0:19:54.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}bahkan Ayah yang budak korporat!{\i0}
Dialogue: 0,0:19:57.67,0:20:00.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berhasil cuan.
Dialogue: 0,0:20:01.30,0:20:05.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bukan lagi anak kecil\Nyang enggak bisa apa-apa.
Dialogue: 0,0:20:05.91,0:20:07.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu...
Dialogue: 0,0:20:23.78,0:20:25.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku pasti bisa!{\i0}
Dialogue: 0,0:20:28.44,0:20:29.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}20 juta yen...{\i0}
Dialogue: 0,0:20:30.62,0:20:33.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}pasti akan ku... dapatkan lagi...?{\i0}
Dialogue: 0,0:20:33.71,0:20:34.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:20:38.42,0:20:39.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lho? Kok...?
Dialogue: 0,0:20:40.18,0:20:43.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}T-Tunggu sebentar...
Dialogue: 0,0:20:43.29,0:20:44.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:20:44.47,0:20:47.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}K-Kenapa mendadak begini?
Dialogue: 0,0:20:47.80,0:20:49.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tutup posisi?
Dialogue: 0,0:20:51.07,0:20:53.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Andaikan tadi aku tutup posisi...
Dialogue: 0,0:20:59.42,0:21:02.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Hal itu tidak hanya terjadi pada Kurumi.{\i0}
Dialogue: 0,0:21:03.44,0:21:06.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Setiap orang mengalami hal serupa.{\i0}
Dialogue: 0,0:21:09.18,0:21:10.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia...{\i0}
Dialogue: 0,0:21:13.62,0:21:14.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dia...{\i0}
Dialogue: 0,0:21:17.87,0:21:18.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}juga dia.{\i0}
Dialogue: 0,0:21:20.04,0:21:22.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sebelum momen itu terjadi,{\i0}
Dialogue: 0,0:21:23.16,0:21:24.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}mereka tidak sadar.{\i0}
Dialogue: 0,0:21:25.67,0:21:26.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Uangku...
Dialogue: 0,0:21:27.52,0:21:29.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Uang yang susah payah kutabung...
Dialogue: 0,0:21:30.02,0:21:31.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Uangku...
Dialogue: 0,0:21:34.04,0:21:35.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mohon...
Dialogue: 0,0:21:36.40,0:21:38.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong, aku mohon!
Dialogue: 0,0:21:39.78,0:21:45.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhentilah!
Dialogue: 0,0:21:45.60,0:21:48.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bahwa mereka berdiri\Ndi tepi jurang keputusasaan.{\i0}
Dialogue: 0,0:21:49.75,0:21:50.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Subtitle provided by: Yuramedia Link
Dialogue: 0,0:21:50.89,0:21:54.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Translator: Daffa Irsyad / Timing: Irvan F\NQuality Check: Davy Julian Ibrahim
Dialogue: 0,0:23:20.63,0:23:23.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Hei, hei, Forex itu\Nperdagangan mata uang asing.{\i0}
Dialogue: 0,0:23:23.51,0:23:25.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Singkatan dari Foreign Exchange.{\i0}
Dialogue: 0,0:23:25.91,0:23:29.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku benaran jatuh cinta sama Forex!{\i0}
Dialogue: 0,0:23:30.14,0:23:30.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tapi,{\i0}
Dialogue: 0,0:23:31.03,0:23:33.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}kayaknya jatuhku bukan ke asmara,\Ntapi ke neraka.{\i0}
