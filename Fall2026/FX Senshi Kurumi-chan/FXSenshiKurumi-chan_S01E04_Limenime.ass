Dialogue: 0,0:00:00.00,0:00:00.95,sign,,0000,0000,0000,,TAYANGAN INI HANYA KARYA FIKSI.
Dialogue: 0,0:00:00.95,0:00:02.81,sign,,0000,0000,0000,,FOREX BERISIKO TINGGI DAN KERUGIAN\NDAPAT MELEBIHI MODAL AWAL.
Dialogue: 0,0:00:02.81,0:00:04.98,sign,,0000,0000,0000,,TAYANGAN INI BUKAN ANJURAN INVESTASI.\NBIJAKLAH BERTRANSAKSI ATAS RISIKO PRIBADI.
Dialogue: 0,0:00:11.45,0:00:12.69,sign,,0000,0000,0000,,CATATAN HARIAN INVESTASI AFI\NRUGI BESAR ~ EDISI AUD ~
Dialogue: 0,0:00:16.83,0:00:17.50,sign,,0000,0000,0000,,AKU PENSIUN SAJA DARI FOREX
Dialogue: 0,0:00:27.38,0:00:29.38,sign,,0000,0000,0000,,MEBUKI YAMASHI (20 TAHUN)\NMAHASISWI TAHUN KETIGA
Dialogue: 0,0:01:01.08,0:01:02.66,sign,,0000,0000,0000,,JENIS, MATA UANG, LEVERAGE
Dialogue: 0,0:01:14.05,0:01:15.30,sign,,0000,0000,0000,,TIPE AKUN: AKUN FOREX RIIL\NMATA UANG: JPY, LEVERAGE: 1:500\NSELANJUTNYA
Dialogue: 0,0:01:15.30,0:01:16.81,sign,,0000,0000,0000,,AKUN ANDA 1112093 TELAH BERHASIL DIBUAT.\NRINCIAN AKUN DIKIRIM KE EMAIL TERDAFTAR.
Dialogue: 0,0:01:58.26,0:02:01.60,sign,,0000,0000,0000,,PADAHAL KUCING, TAPI MOUSE!\NMENGGEMPARKAN! DIJUAL OLEH: DOG
Dialogue: 0,0:02:49.07,0:02:50.38,sign,,0000,0000,0000,,NICKNAME: TOMOKO\NKOMENTAR: AKU PAHAM PERASAANMU!
Dialogue: 0,0:02:50.64,0:02:51.98,sign,,0000,0000,0000,,AKU JUGA KEMARIN RUGI BESAR DI AUD.\NTAPI KITA TIDAK BOLEH MENYERAH KAN.
Dialogue: 0,0:03:22.68,0:03:25.43,sign,,0000,0000,0000,,KURUMI SI PEJUANG FOREX
Dialogue: 0,0:05:00.99,0:05:01.95,sign,,0000,0000,0000,,GAJI BULAN MEI
Dialogue: 0,0:05:01.95,0:05:03.45,sign,,0000,0000,0000,,GAJI BERSIH DITERIMA: 52.487
Dialogue: 0,0:05:30.39,0:05:32.48,sign,,0000,0000,0000,,KAMAR KURUMI
Dialogue: 0,0:06:09.93,0:06:10.85,sign,,0000,0000,0000,,BADAN PAJAK NASIONAL\NPENGGELAPAN PAJAK ADALAH KEJAHATAN
Dialogue: 0,0:06:52.03,0:06:53.27,sign,,0000,0000,0000,,PENGGELAPAN PAJAK SAMA SEKALI\NTIDAK DIPERBOLEHKAN!
Dialogue: 0,0:11:48.65,0:11:50.98,sign,,0000,0000,0000,,KURUMI SI PEJUANG FOREX
Dialogue: 0,0:11:52.73,0:11:53.98,sign,,0000,0000,0000,,KURUMI SI PEJUANG FOREX
Dialogue: 0,0:11:54.53,0:11:55.52,sign,,0000,0000,0000,,UNIVERSITAS SHINTO
Dialogue: 0,0:17:37.91,0:17:40.14,sign,,0000,0000,0000,,SALDO: 200.000 JPY
Dialogue: 0,0:19:07.67,0:19:08.91,sign,,0000,0000,0000,,RISIKO DITANGGUNG SENDIRI
Dialogue: 0,0:19:35.99,0:19:37.16,sign,,0000,0000,0000,,GBP/JPY?
Dialogue: 0,0:20:24.45,0:20:25.06,sign,,0000,0000,0000,,PASANGAN MATA UANG: GBP/JPY\NJUMLAH LOT: 1.00
Dialogue: 0,0:20:28.79,0:20:29.29,sign,,0000,0000,0000,,JENIS PESANAN: MARKET ORDER
Dialogue: 0,0:20:29.29,0:20:30.29,sign,,0000,0000,0000,,GBP/JPY SELL 170.897\NSELESAI
Dialogue: 0,0:23:33.58,0:23:34.93,sign,,0000,0000,0000,,EPISODE 5\NLONG ATAU SHORT, PILIH MANA?
Dialogue: 0,0:00:12.69,0:00:16.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata ada yang hancur\Ngara-gara AUD/JPY kemarin.
Dialogue: 0,0:00:25.58,0:00:27.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi!
Dialogue: 0,0:00:31.43,0:00:33.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, keren!
Dialogue: 0,0:00:35.01,0:00:37.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar kerasa investornya!
Dialogue: 0,0:00:40.44,0:00:42.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, ada kucing juga!
Dialogue: 0,0:00:43.62,0:00:45.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pelihara?
Dialogue: 0,0:00:45.02,0:00:47.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia ikut sendiri, jadi aku beri makan.
Dialogue: 0,0:00:48.53,0:00:50.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudahlah, ayo cepat mulai.
Dialogue: 0,0:00:50.45,0:00:51.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mau buat akun, kan?
Dialogue: 0,0:00:52.13,0:00:53.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:00:54.98,0:00:57.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pilih berbasis yen atau dolar?
Dialogue: 0,0:00:57.22,0:00:58.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berbasis yen saja.
Dialogue: 0,0:01:01.08,0:01:02.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus...
Dialogue: 0,0:01:03.81,0:01:06.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Leverage maksimal akun?
Dialogue: 0,0:01:06.51,0:01:07.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya bisa dipilih.
Dialogue: 0,0:01:07.79,0:01:10.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena ini akun luar negeri,
Dialogue: 0,0:01:10.05,0:01:11.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pilih 500 kali saja.
Dialogue: 0,0:01:11.73,0:01:12.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:01:17.01,0:01:20.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa akun Forex\Nsudah selesai dibuat?
Dialogue: 0,0:01:20.48,0:01:22.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya. Mudah, kan?
Dialogue: 0,0:01:23.36,0:01:26.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan begini, kamu juga\Nresmi menjadi investor.
Dialogue: 0,0:01:27.25,0:01:28.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Investor!
Dialogue: 0,0:01:28.91,0:01:29.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:01:29.73,0:01:31.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bakal berusaha jadi orang kaya!
Dialogue: 0,0:01:32.69,0:01:34.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, Kak,
Dialogue: 0,0:01:34.02,0:01:36.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hari ini Kakak untung berapa?
Dialogue: 0,0:01:36.11,0:01:38.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini aku enggak trading.
Dialogue: 0,0:01:38.21,0:01:40.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma membaca blog investor.
Dialogue: 0,0:01:43.04,0:01:45.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Catatan Harian Investasi Afi".
Dialogue: 0,0:01:45.67,0:01:47.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia cewek, ya?
Dialogue: 0,0:01:47.34,0:01:49.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Palingan om-om\Nyang pura-pura jadi wanita.
Dialogue: 0,0:01:50.14,0:01:51.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau itu sih parah.
Dialogue: 0,0:01:52.99,0:01:54.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Afiliator?
Dialogue: 0,0:02:09.79,0:02:12.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak ada yang klik link-nya.
Dialogue: 0,0:02:13.30,0:02:14.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rugi di Forex,
Dialogue: 0,0:02:14.91,0:02:17.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi affiliator pun enggak ada hasil...
Dialogue: 0,0:02:18.86,0:02:20.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Udahlah, setop aja!
Dialogue: 0,0:02:20.21,0:02:22.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pensiun dari semuanya!
Dialogue: 0,0:02:22.75,0:02:25.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bos, tambah satu lagi!
Dialogue: 0,0:02:27.17,0:02:29.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang ini saking payahnya jadi lucu.
Dialogue: 0,0:02:30.64,0:02:33.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harusnya ganti nama jadi\N"Pelawak Forex Afi".
Dialogue: 0,0:02:34.74,0:02:38.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi orang seperti ini\Njustru bisa jadi pelajaran.
Dialogue: 0,0:02:40.19,0:02:43.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, bagaimana Kakak\Nbisa mulai menang?
Dialogue: 0,0:02:43.86,0:02:45.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entahlah, keberuntungan?
Dialogue: 0,0:02:45.55,0:02:48.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa? Pasti ada trik khususnya, kan?
Dialogue: 0,0:02:49.07,0:02:50.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Merepotkan.
Dialogue: 0,0:02:50.64,0:02:51.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal itu...
Dialogue: 0,0:02:52.11,0:02:54.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kenalanku di kampus lebih tahu.
Dialogue: 0,0:02:54.58,0:02:56.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, teman sesama investor!
Dialogue: 0,0:02:56.96,0:02:58.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapan-kapan kenalin, dong!
Dialogue: 0,0:02:58.96,0:02:59.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh saja.
Dialogue: 0,0:02:59.99,0:03:02.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, dia orangnya seperti apa?
Dialogue: 0,0:03:03.98,0:03:06.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti apa, ya? Singkatnya...
Dialogue: 0,0:03:07.46,0:03:09.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}seorang pejuang, mungkin?
Dialogue: 0,0:03:10.90,0:03:12.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orangnya menyeramkan?
Dialogue: 0,0:04:44.62,0:04:46.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih atas kerja kerasnya.
Dialogue: 0,0:04:47.54,0:04:49.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus! Hari ini enggak ada kesalahan!
Dialogue: 0,0:04:51.44,0:04:54.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak ada rugi sementara itu terbaik!
Dialogue: 0,0:04:55.34,0:04:56.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gaji juga...
Dialogue: 0,0:04:57.11,0:04:59.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena bulan ini ambil banyak sif,
Dialogue: 0,0:04:59.40,0:05:00.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku agak berharap lebih.
Dialogue: 0,0:05:04.86,0:05:07.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, cuma segini, ya.
Dialogue: 0,0:05:09.86,0:05:13.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya, aku harus mengembalikan\N3 juta yen uang rumah!
Dialogue: 0,0:05:15.28,0:05:17.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga belum ketahuan!
Dialogue: 0,0:05:20.84,0:05:21.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pulang.
Dialogue: 0,0:05:25.12,0:05:27.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang. Sudah makan?
Dialogue: 0,0:05:27.26,0:05:28.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah!
Dialogue: 0,0:05:35.73,0:05:38.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus. Kayaknya belum ketahuan.
Dialogue: 0,0:05:39.50,0:05:42.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dikembalikan pelan-pelan\Nsetelah ayah tidur pasti aman.
Dialogue: 0,0:05:43.36,0:05:45.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi mencapai target 20 juta yen,
Dialogue: 0,0:05:45.49,0:05:47.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku harus lanjut ke tahap berikutnya.
Dialogue: 0,0:05:47.93,0:05:50.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama ini aku bertransaksi\Nrisiko tinggi dan hasil tinggi
Dialogue: 0,0:05:50.70,0:05:52.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di broker luar negeri,
Dialogue: 0,0:05:53.33,0:05:55.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi mulai sekarang aku akan bertransaksi
Dialogue: 0,0:05:55.44,0:05:57.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di broker lokal\Nyang risiko matinya lebih kecil!
Dialogue: 0,0:05:58.45,0:06:00.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asalkan punya modal 2,1 juta yen,
Dialogue: 0,0:06:00.66,0:06:03.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}leverage lokal pun sudah cukup.
Dialogue: 0,0:06:04.09,0:06:05.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, kalau memikirkan pajak,
Dialogue: 0,0:06:05.84,0:06:07.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akun luar negeri itu merugikan.
Dialogue: 0,0:06:08.72,0:06:09.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh iya...
Dialogue: 0,0:06:10.85,0:06:13.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bagaimana dengan pelaporan SPT?
Dialogue: 0,0:06:13.23,0:06:15.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja, aku akan melapor.
Dialogue: 0,0:06:15.10,0:06:16.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga akan bayar pajak!
Dialogue: 0,0:06:16.86,0:06:18.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan diterima.
Dialogue: 0,0:06:18.01,0:06:20.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau lapor, aku keluar dari tanggungan
Dialogue: 0,0:06:20.48,0:06:24.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan ayah tahu aku punya penghasilan\Nselain kerja paruh waktu.
Dialogue: 0,0:06:25.28,0:06:29.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa sebaiknya aku jujur\Nsoal Forex sekarang?
Dialogue: 0,0:06:30.24,0:06:32.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, aku juga berhasil cuan.
Dialogue: 0,0:06:32.75,0:06:34.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ayah tahu aku ini putri
Dialogue: 0,0:06:34.19,0:06:36.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang bisa menghasilkan\Ndan berbeda dari Ibu...
Dialogue: 0,0:06:37.31,0:06:39.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak, apa aku terlalu berharap?
Dialogue: 0,0:06:40.03,0:06:43.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau sekalian kerja paruh waktu\Nsampai keluar dari tanggungan?
Dialogue: 0,0:06:44.51,0:06:47.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Andaikan sejak awal enggak ada pajak...
Dialogue: 0,0:06:49.74,0:06:52.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin gelapkan pajak.
Dialogue: 0,0:06:57.31,0:06:58.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurumi.
Dialogue: 0,0:06:58.02,0:06:59.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Ada apa?
Dialogue: 0,0:06:59.98,0:07:01.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keadaan darurat.
Dialogue: 0,0:07:02.45,0:07:03.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:07:03.76,0:07:05.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Uang rumah dicuri!
Dialogue: 0,0:07:05.61,0:07:07.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah akan segera lapor polisi!
Dialogue: 0,0:07:08.64,0:07:10.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak mungkin, ah!
Dialogue: 0,0:07:11.58,0:07:14.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}L-Lapor polisi itu berlebihan.
Dialogue: 0,0:07:15.12,0:07:17.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malu kalau ternyata salah.
Dialogue: 0,0:07:22.59,0:07:25.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong,\Nuangnya disimpan di mana?
Dialogue: 0,0:07:26.16,0:07:28.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lemari. Di dekat telepon.
Dialogue: 0,0:07:28.54,0:07:31.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, rasanya aku pernah lihat!
Dialogue: 0,0:07:32.37,0:07:34.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cari dulu, ya!
Dialogue: 0,0:07:34.27,0:07:36.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begini, terobos saja!
Dialogue: 0,0:07:36.11,0:07:36.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu.
Dialogue: 0,0:07:45.52,0:07:47.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tamat... sudah...
Dialogue: 0,0:07:51.28,0:07:53.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah pelakunya Kurumi.
Dialogue: 0,0:07:56.40,0:07:58.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi bukan berarti\Nmasalahnya selesai, kan?
Dialogue: 0,0:08:00.74,0:08:02.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu melakukan ini?
Dialogue: 0,0:08:02.56,0:08:03.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katakan alasannya.
Dialogue: 0,0:08:05.89,0:08:07.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Itu...
Dialogue: 0,0:08:09.44,0:08:10.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eng...
Dialogue: 0,0:08:14.11,0:08:15.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah tahu ini sulit dikatakan.
Dialogue: 0,0:08:16.08,0:08:18.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apalagi kalau alasannya tidak benar.
Dialogue: 0,0:08:21.40,0:08:24.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurumi! Andalkan orang tuamu!
Dialogue: 0,0:08:25.33,0:08:28.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu terlibat masalah,\NAyah akan bantu!
Dialogue: 0,0:08:28.51,0:08:30.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah akan selalu ada di pihakmu!
Dialogue: 0,0:08:32.86,0:08:35.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di pihakku...?
Dialogue: 0,0:08:49.84,0:08:51.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku butuh uang itu...
Dialogue: 0,0:08:52.37,0:08:54.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk menang di Forex!
Dialogue: 0,0:08:56.83,0:08:57.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku...
Dialogue: 0,0:08:57.86,0:09:02.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}main Forex untuk merebut kembali\N20 juta yen yang dihabiskan ibu!
Dialogue: 0,0:09:02.52,0:09:04.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf karena pinjam tanpa izin,
Dialogue: 0,0:09:04.69,0:09:06.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi berkat itu aku bisa menang!
Dialogue: 0,0:09:06.53,0:09:10.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang untung total 1,8 juta yen,
Dialogue: 0,0:09:10.42,0:09:12.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi sepertinya aku bisa\Nkeluar dari tanggungan!
Dialogue: 0,0:09:12.85,0:09:15.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang kalau\NAyah mau urus berkasnya!
Dialogue: 0,0:09:15.70,0:09:18.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kedepannya aku\Ntidak akan pinjam lagi,
Dialogue: 0,0:09:18.58,0:09:21.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan kalau gagal,\Naku tanggung jawab sendiri!
Dialogue: 0,0:09:21.95,0:09:25.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biarkan saja aku, ya!
Dialogue: 0,0:09:25.04,0:09:26.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena aku sudah dewasa!
Dialogue: 0,0:09:30.59,0:09:33.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bicara apa kamu ini?!
Dialogue: 0,0:09:39.07,0:09:40.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenangkan dirimu.
Dialogue: 0,0:09:40.85,0:09:42.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu harus mengembalikan
Dialogue: 0,0:09:42.93,0:09:45.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}uang yang dihilangkan ibumu?
Dialogue: 0,0:09:46.91,0:09:49.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemikiran begitu\Nbelum bisa disebut dewasa.
Dialogue: 0,0:09:51.36,0:09:54.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu kamu bangga bilang "menang",
Dialogue: 0,0:09:55.09,0:09:57.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi harus pinjam uang dulu itu\Nsudah salah.
Dialogue: 0,0:09:59.12,0:10:01.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mustahil begitu, Kurumi.
Dialogue: 0,0:10:01.92,0:10:02.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksud Ayah,
Dialogue: 0,0:10:03.39,0:10:05.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sudahlah... berhenti...
Dialogue: 0,0:10:08.27,0:10:11.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah mohon, jangan main Forex lagi.
Dialogue: 0,0:10:13.70,0:10:14.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah mohon.
Dialogue: 0,0:10:21.84,0:10:24.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah mulai sinting.
Dialogue: 0,0:10:25.52,0:10:27.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal hampir kehilangan semuanya,
Dialogue: 0,0:10:27.40,0:10:29.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi ingin mencobanya lagi.
Dialogue: 0,0:10:29.82,0:10:30.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh gila.
Dialogue: 0,0:10:32.67,0:10:34.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus...
Dialogue: 0,0:10:34.77,0:10:36.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berhenti dari Forex sekarang juga.
Dialogue: 0,0:10:38.48,0:10:39.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar,
Dialogue: 0,0:10:40.00,0:10:41.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hidup normal di masyarakat,
Dialogue: 0,0:10:41.98,0:10:43.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bekerja secara normal,
Dialogue: 0,0:10:43.95,0:10:46.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan tekun, jujur,
Dialogue: 0,0:10:46.29,0:10:48.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan perlahan-lahan menghasilkan uang.
Dialogue: 0,0:10:50.67,0:10:53.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mencari uang dengan tekun itu malas, kan?
Dialogue: 0,0:11:00.47,0:11:02.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dapat uang dalam sekejap...
Dialogue: 0,0:11:03.60,0:11:05.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}rasanya menyenangkan, kan?
Dialogue: 0,0:11:08.77,0:11:09.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurumi.
Dialogue: 0,0:11:11.97,0:11:13.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah paham, kan?
Dialogue: 0,0:11:23.73,0:11:24.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus berhenti.
Dialogue: 0,0:11:25.66,0:11:27.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus berhenti dari Forex!
Dialogue: 0,0:11:55.52,0:11:58.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Kamu pensiun dari Forex?
Dialogue: 0,0:11:58.66,0:11:59.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:11:59.70,0:12:02.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya, aku enggak berbakat.
Dialogue: 0,0:12:02.24,0:12:05.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutku justru ada bakat, loh.
Dialogue: 0,0:12:05.41,0:12:06.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayang sekali.
Dialogue: 0,0:12:07.52,0:12:10.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal kamu berbakat jadi miliarder.
Dialogue: 0,0:12:11.23,0:12:13.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak, ah.
Dialogue: 0,0:12:13.38,0:12:15.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Targetmu berapa, ya?
Dialogue: 0,0:12:15.63,0:12:17.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}20 juta yen.
Dialogue: 0,0:12:17.30,0:12:18.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, kan?
Dialogue: 0,0:12:18.43,0:12:20.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah bilang sejak kita bertemu.
Dialogue: 0,0:12:20.72,0:12:22.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku mau berhenti saja.
Dialogue: 0,0:12:22.85,0:12:25.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemenanganku selama ini\Ncuma karena beruntung.
Dialogue: 0,0:12:26.24,0:12:28.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berikutnya pasti enggak selamat.
Dialogue: 0,0:12:28.60,0:12:31.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak paham\Nkenapa kamu ketakutan.
Dialogue: 0,0:12:32.82,0:12:35.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal Forex itu medan perang\Ndengan risiko rendah.
Dialogue: 0,0:12:37.60,0:12:40.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Uang memang akan habis kalau gagal,
Dialogue: 0,0:12:40.45,0:12:41.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi sebatas itu.
Dialogue: 0,0:12:42.21,0:12:44.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang tertekan saat uang habis
Dialogue: 0,0:12:44.15,0:12:47.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}cuma orang yang punya hal\Nuntuk dijaga, kan?
Dialogue: 0,0:12:47.16,0:12:50.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Contohnya ibu rumah tangga\Natau orang yang punya keluarga.
Dialogue: 0,0:12:51.54,0:12:54.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku paham kamu sudah susah payah\Ncari uang dari kerja paruh waktu.
Dialogue: 0,0:12:54.83,0:12:58.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi untuk apa menjaga ratusan ribu yen?
Dialogue: 0,0:12:58.67,0:13:01.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu buat tabungan masa depan...
Dialogue: 0,0:13:02.01,0:13:05.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mahasiswa yang menabung itu bodoh, kan?
Dialogue: 0,0:13:05.18,0:13:07.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}T-Tapi, menabung itu penting!
Dialogue: 0,0:13:08.08,0:13:10.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Forex juga cuma judi.
Dialogue: 0,0:13:12.35,0:13:14.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, dong! Judi itu keren!
Dialogue: 0,0:13:15.01,0:13:17.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kan punya bakat!
Dialogue: 0,0:13:17.92,0:13:20.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Insting bertarungmu kuat,
Dialogue: 0,0:13:20.57,0:13:23.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa menyerang di situasi menakutkan.
Dialogue: 0,0:13:23.68,0:13:25.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal kamu bisa jadi pemenang,
Dialogue: 0,0:13:25.78,0:13:28.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kenapa malah mau berhenti Forex?
Dialogue: 0,0:13:30.21,0:13:34.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku enggak begitu butuh uang...
Dialogue: 0,0:13:34.96,0:13:35.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:13:35.66,0:13:38.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, kenapa mau cari 20 juta yen?
Dialogue: 0,0:13:40.22,0:13:42.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak ada hubungannya denganmu.
Dialogue: 0,0:13:44.19,0:13:45.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya juga, sih.
Dialogue: 0,0:13:48.45,0:13:49.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi begitu, ya.
Dialogue: 0,0:13:50.19,0:13:53.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sedih kamu pensiun,\Ntapi ya sudahlah.
Dialogue: 0,0:13:54.56,0:13:57.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku ingin minta\Nsatu bantuan,
Dialogue: 0,0:13:57.47,0:13:58.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa bisa?
Dialogue: 0,0:14:01.89,0:14:04.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salam kenal!\NTolong panggil aku Mebuki!
Dialogue: 0,0:14:05.95,0:14:07.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo, aku...
Dialogue: 0,0:14:08.16,0:14:09.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah dengar ceritanya!
Dialogue: 0,0:14:09.79,0:14:11.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Kurumi, kan?
Dialogue: 0,0:14:11.14,0:14:12.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak?
Dialogue: 0,0:14:12.41,0:14:15.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya Kakak si Genius Forex
Dialogue: 0,0:14:15.02,0:14:18.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang bisa sulap 300 ribu yen\Njadi 2,1 juta yen dalam tiga bulan!
Dialogue: 0,0:14:21.60,0:14:22.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mochiko.
Dialogue: 0,0:14:22.83,0:14:24.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, maaf.
Dialogue: 0,0:14:24.27,0:14:26.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma ingin pamer kamu.
Dialogue: 0,0:14:29.09,0:14:30.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar!
Dialogue: 0,0:14:30.50,0:14:32.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu? Bantuan apa?
Dialogue: 0,0:14:34.18,0:14:38.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin kamu\Nmenjadi guru Forex untuk Mebuki.
Dialogue: 0,0:14:38.59,0:14:39.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:14:40.22,0:14:41.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Mana bisa!
Dialogue: 0,0:14:41.66,0:14:43.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ini payah!
Dialogue: 0,0:14:43.36,0:14:45.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu lebih jago, kan!
Dialogue: 0,0:14:45.02,0:14:47.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga mengajarinya, tapi aku sibuk.
Dialogue: 0,0:14:48.37,0:14:50.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya kamu sedang luang\Nkarena habis pensiun?
Dialogue: 0,0:14:50.83,0:14:52.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak bisa!
Dialogue: 0,0:14:52.24,0:14:54.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak ada yang bisa kuajarkan!
Dialogue: 0,0:14:54.93,0:14:56.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa, sih?
Dialogue: 0,0:14:56.22,0:15:00.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seenggaknya, wawasanmu luas banget.
Dialogue: 0,0:15:00.05,0:15:02.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutku sih begitu.
Dialogue: 0,0:15:04.67,0:15:06.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tatapan matanya beda.
Dialogue: 0,0:15:06.03,0:15:09.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selevel veteran yang bertahan\Nsejak Krisis Lehman.
Dialogue: 0,0:15:09.41,0:15:11.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Krisis Lehman itu?
Dialogue: 0,0:15:12.13,0:15:14.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak paham maksudnya, sih.
Dialogue: 0,0:15:17.55,0:15:19.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat, dia berbahaya, kan?
Dialogue: 0,0:15:19.57,0:15:20.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ajari dia, lah.
Dialogue: 0,0:15:20.99,0:15:22.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anggap saja menolong orang.
Dialogue: 0,0:15:24.57,0:15:25.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menolong orang...
Dialogue: 0,0:15:26.27,0:15:29.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan berarti aku yang main Forex.
Dialogue: 0,0:15:29.66,0:15:31.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Wah, ada kupu-kupu!\N- Kasian, kan?
Dialogue: 0,0:15:31.26,0:15:34.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Turun ke pasar tanpa tahu apa-apa.
Dialogue: 0,0:15:38.91,0:15:42.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau cuma mengajarkan\Nyang kuketahui...
Dialogue: 0,0:15:42.46,0:15:43.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hore!
Dialogue: 0,0:15:43.57,0:15:45.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak!
Dialogue: 0,0:15:45.26,0:15:47.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah, Mebuki.
Dialogue: 0,0:15:47.52,0:15:49.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ada kuliah dulu.
Dialogue: 0,0:15:49.47,0:15:50.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah ini tolong, ya.
Dialogue: 0,0:15:50.83,0:15:52.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, tunggu dulu!
Dialogue: 0,0:15:52.48,0:15:54.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat jalan!
Dialogue: 0,0:15:54.69,0:15:57.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Kurumi, mohon bimbingannya!
Dialogue: 0,0:16:04.02,0:16:07.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu terpikir ingin main Forex?
Dialogue: 0,0:16:07.78,0:16:09.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertanyaanmu bagus sekali!
Dialogue: 0,0:16:09.57,0:16:10.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Singkatnya...
Dialogue: 0,0:16:11.17,0:16:13.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena aku malas bekerja!
Dialogue: 0,0:16:15.47,0:16:19.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ogah jadi roda gigi masyarakat!
Dialogue: 0,0:16:19.38,0:16:24.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutmu, dapat uang tanpa bekerja\Njuga paling asyik, kan?
Dialogue: 0,0:16:25.60,0:16:27.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa begitu,
Dialogue: 0,0:16:27.47,0:16:30.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi tetap butuh usaha.
Dialogue: 0,0:16:30.39,0:16:31.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:16:31.22,0:16:35.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya Kakak dapat cuan kilat\Ndari Forex?
Dialogue: 0,0:16:35.50,0:16:38.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia kalau nanya enggak ada rem!
Dialogue: 0,0:16:38.27,0:16:40.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Mochiko bilang padaku!
Dialogue: 0,0:16:40.48,0:16:41.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau punya 100 juta yen,
Dialogue: 0,0:16:41.95,0:16:45.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa dapat 3 juta yen per tahun\Ntanpa bekerja!
Dialogue: 0,0:16:46.00,0:16:49.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudnya dividen saham?
Dialogue: 0,0:16:49.74,0:16:51.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin itu!
Dialogue: 0,0:16:51.09,0:16:52.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Kurumi memang hebat!
Dialogue: 0,0:16:56.10,0:16:57.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus, ya...
Dialogue: 0,0:16:58.54,0:17:01.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat kubilang enggak punya\N100 juta yen,
Dialogue: 0,0:17:01.06,0:17:04.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia bilang jalan pintasnya\Nya lewat Forex!
Dialogue: 0,0:17:06.09,0:17:08.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mochiko, apa-apaan nasihatmu itu?
Dialogue: 0,0:17:09.46,0:17:12.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, aku juga melakukan\Nhal yang sama.
Dialogue: 0,0:17:13.30,0:17:16.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketemu Kak Mochiko mengubah hidupku!
Dialogue: 0,0:17:17.33,0:17:19.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata ada orang\Nsehebat itu di dekatku!
Dialogue: 0,0:17:20.73,0:17:21.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:17:22.27,0:17:25.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong,\Nmodal awalmu berapa?
Dialogue: 0,0:17:25.17,0:17:27.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mulai dengan 200 ribu yen!
Dialogue: 0,0:17:27.02,0:17:28.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu.
Dialogue: 0,0:17:29.78,0:17:31.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hasil tabungan kerja paruh waktu?
Dialogue: 0,0:17:32.77,0:17:35.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bicara apa kamu?\NIni uang beasiswa.
Dialogue: 0,0:17:37.91,0:17:40.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiap bulan dapat uang,
Dialogue: 0,0:17:40.14,0:17:42.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}buat apa kerja paruh waktu?
Dialogue: 0,0:17:42.42,0:17:45.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keluarga juga kadang kirim makanan,
Dialogue: 0,0:17:45.39,0:17:47.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi aku bisa hidup nyaman!
Dialogue: 0,0:17:48.71,0:17:51.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksud Mochiko sebenarnya?
Dialogue: 0,0:17:52.06,0:17:55.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mebuki ini memang agak terlalu naif,
Dialogue: 0,0:17:55.39,0:17:57.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Eh? Kenapa?\N- tapi kalau memang ingin menolong,
Dialogue: 0,0:17:57.51,0:18:00.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Terbalik?\N- harusnya jangan mengajarinya Forex.
Dialogue: 0,0:18:00.69,0:18:01.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selesai!
Dialogue: 0,0:18:03.20,0:18:04.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong,
Dialogue: 0,0:18:04.18,0:18:07.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sekarang saldo di akun Kakak ada berapa?
Dialogue: 0,0:18:07.23,0:18:08.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya-Yah...
Dialogue: 0,0:18:08.57,0:18:10.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kan sudah pensiun,
Dialogue: 0,0:18:10.98,0:18:12.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi sudah kosong.
Dialogue: 0,0:18:12.40,0:18:13.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Artinya,
Dialogue: 0,0:18:13.84,0:18:16.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau deposit lagi,\Nbisa lanjut kapan saja!
Dialogue: 0,0:18:17.99,0:18:20.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}K-Kan kubilang sudah pensiun!
Dialogue: 0,0:18:21.87,0:18:24.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di dunia game, yang bilang "mau pensiun"
Dialogue: 0,0:18:24.74,0:18:27.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}enggak pernah ada\Nyang benaran pensiun.
Dialogue: 0,0:18:28.02,0:18:30.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagian, kalau benaran pensiun,
Dialogue: 0,0:18:30.26,0:18:31.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pasti tutup akun, kan?
Dialogue: 0,0:18:33.14,0:18:36.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong cepat ajari aku...
Dialogue: 0,0:18:38.39,0:18:40.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini... akan bergerak ke mana?
Dialogue: 0,0:18:41.90,0:18:43.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Langsung tanya begitu?!
Dialogue: 0,0:18:44.02,0:18:46.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak paham hal rumit,
Dialogue: 0,0:18:46.53,0:18:49.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi aku bakal senang\Nkalau dapat cara menangnya.
Dialogue: 0,0:18:50.37,0:18:51.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pede banget, ya.
Dialogue: 0,0:18:52.36,0:18:55.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bocah ini enggak ngerti apa-apa!
Dialogue: 0,0:18:57.47,0:18:59.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah! Akan kuajari!
Dialogue: 0,0:19:00.06,0:19:02.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Kurumi, yang mana?
Dialogue: 0,0:19:02.54,0:19:04.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebelum itu, satu hal.
Dialogue: 0,0:19:05.33,0:19:07.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Investasi itu tanggung jawab sendiri.
Dialogue: 0,0:19:08.91,0:19:11.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu rugi\Nkarena mengikuti perkataanku,
Dialogue: 0,0:19:11.98,0:19:14.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu enggak boleh salahkan aku!
Dialogue: 0,0:19:15.10,0:19:16.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}USD/JPY mungkin akan naik?
Dialogue: 0,0:19:16.86,0:19:18.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti beli!
Dialogue: 0,0:19:18.38,0:19:19.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hore!
Dialogue: 0,0:19:22.02,0:19:23.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pembohong!
Dialogue: 0,0:19:23.65,0:19:24.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa bodoh!
Dialogue: 0,0:19:24.69,0:19:28.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang ambil keputusan akhir kan kamu!
Dialogue: 0,0:19:28.30,0:19:30.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja!
Dialogue: 0,0:19:30.08,0:19:32.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau itu sih aku paham!
Dialogue: 0,0:19:32.99,0:19:34.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baguslah kalau begitu.
Dialogue: 0,0:19:37.32,0:19:38.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa pilih mata uang ini?
Dialogue: 0,0:19:38.99,0:19:41.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diajari sama Mochiko?
Dialogue: 0,0:19:54.93,0:19:56.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana, ya?
Dialogue: 0,0:19:56.96,0:19:58.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Firasat pertamaku...
Dialogue: 0,0:19:59.81,0:20:02.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan turun, mungkin.
Dialogue: 0,0:20:03.31,0:20:04.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau turun...
Dialogue: 0,0:20:05.20,0:20:07.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berarti untung kalau jual, kan?
Dialogue: 0,0:20:08.11,0:20:09.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah... begitulah.
Dialogue: 0,0:20:11.11,0:20:12.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku jual!
Dialogue: 0,0:20:12.44,0:20:13.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh!
Dialogue: 0,0:20:13.27,0:20:15.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku percaya padamu\Ndi pertandingan pertama!
Dialogue: 0,0:20:16.45,0:20:17.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, tunggu, tunggu!
Dialogue: 0,0:20:17.63,0:20:19.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baru lihat grafik jangka pendek,
Dialogue: 0,0:20:19.73,0:20:21.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pikirkan sebentar lagi...
Dialogue: 0,0:20:21.57,0:20:23.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Mebuki!\N- Sip, ayo mulai!
Dialogue: 0,0:20:23.17,0:20:24.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengar, dong!
Dialogue: 0,0:20:25.06,0:20:26.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin Pound?
Dialogue: 0,0:20:26.16,0:20:27.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jual sekarang!
Dialogue: 0,0:20:31.54,0:20:33.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mendebarkan, ya!
Dialogue: 0,0:20:34.61,0:20:37.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menjual itu sebutannya short, kan?
Dialogue: 0,0:20:37.30,0:20:39.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah belajar!
Dialogue: 0,0:20:39.47,0:20:42.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di-Dia sebut ini belajar?
Dialogue: 0,0:20:42.72,0:20:45.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Turunlah, turunlah, turunlah...
Dialogue: 0,0:20:45.39,0:20:49.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Turunlah, turunlah, turunlah,\Nturunlah, turunlah...
Dialogue: 0,0:20:49.90,0:20:51.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Turunlah...
Dialogue: 0,0:20:51.56,0:20:52.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Turunlah...
Dialogue: 0,0:20:53.17,0:20:54.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Turunlah...
Dialogue: 0,0:21:00.70,0:21:01.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serius?
Dialogue: 0,0:21:02.49,0:21:05.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benaran turun, ya!
Dialogue: 0,0:21:07.20,0:21:08.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat sekali!
Dialogue: 0,0:21:08.82,0:21:11.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak memang hebat!
Dialogue: 0,0:21:19.09,0:21:21.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}K-Kenapa...
Dialogue: 0,0:21:23.54,0:21:26.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, kalau aku ikut jual pasti untung.
Dialogue: 0,0:21:26.93,0:21:29.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah! Turun lagi!
Dialogue: 0,0:21:30.03,0:21:32.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Uangnya bertambah!
Dialogue: 0,0:21:33.81,0:21:38.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mau berhenti Forex\Nbegitu saja? Kamu yakin...?
Dialogue: 0,0:23:20.91,0:23:21.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?!
Dialogue: 0,0:23:21.74,0:23:23.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya Krisis Lehman itu
Dialogue: 0,0:23:23.10,0:23:26.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}saat para pekerja kantoran\Npada jantungan?!
Dialogue: 0,0:23:27.15,0:23:30.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, enggak ada hubungannya\Ndenganku, sih.
Dialogue: 0,0:23:30.14,0:23:33.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya, aku tahu jurus jitu\Nmenang Forex!
Dialogue: 0,0:23:34.93,0:23:44.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ILUSTRASI: Namakura_noelle
