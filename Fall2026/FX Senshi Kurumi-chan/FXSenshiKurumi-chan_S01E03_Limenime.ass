Dialogue: 0,0:04:06.37,0:04:07.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih hidup?
Dialogue: 0,0:04:07.69,0:04:08.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:04:08.51,0:04:11.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena memasukkan uang rumah,\Nmasih sangat aman!
Dialogue: 0,0:04:11.07,0:04:12.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yay!
Dialogue: 0,0:04:12.94,0:04:15.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana bisa aku bilang begitu.
Dialogue: 0,0:04:15.48,0:04:16.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, iya.
Dialogue: 0,0:04:16.78,0:04:19.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cut loss sebagian\Nbiar bisa bertahan.
Dialogue: 0,0:04:19.98,0:04:21.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:04:21.16,0:04:23.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Y-Yang penting pertempuran ini!
Dialogue: 0,0:04:23.47,0:04:24.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana menurutmu, Mochiko?
Dialogue: 0,0:04:25.81,0:04:27.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jujur, aku enggak tahu.
Dialogue: 0,0:04:28.05,0:04:29.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya benaran 50:50.
Dialogue: 0,0:04:30.75,0:04:32.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma, kalau aku...
Dialogue: 0,0:04:33.63,0:04:37.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}inginnya ini terus turun\Ndan menembus 94 yen.
Dialogue: 0,0:04:37.76,0:04:38.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:04:39.23,0:04:42.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau mendukung posisi beli milikmu,
Dialogue: 0,0:04:42.70,0:04:45.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku ingin pasar\Nyang ampas ini berakhir.
Dialogue: 0,0:04:45.98,0:04:47.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya,
Dialogue: 0,0:04:47.98,0:04:51.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pasar yang stabil itu musuh trader, kan?
Dialogue: 0,0:04:52.32,0:04:54.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Walau memantul di 94 yen,
Dialogue: 0,0:04:54.29,0:04:57.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan kembali ke pasar\Nmembosankan lagi, kan?
Dialogue: 0,0:04:57.60,0:05:00.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaliknya, kalau menembus ini,\Npasar pasti akan ramai!
Dialogue: 0,0:05:00.49,0:05:02.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak butuh pasar seperti itu!
Dialogue: 0,0:05:03.15,0:05:04.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, kalau begini terus...
Dialogue: 0,0:05:05.39,0:05:07.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kamu dengar?
Dialogue: 0,0:05:07.08,0:05:08.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya, aku dengar.
Dialogue: 0,0:05:12.37,0:05:14.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat, tuh! Harganya mulai naik!
Dialogue: 0,0:05:14.75,0:05:17.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata harganya memantul di sini, ya.
Dialogue: 0,0:05:17.25,0:05:18.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, selamat.
Dialogue: 0,0:05:19.30,0:05:21.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}K-Kalau begitu, aku mau fokus ke pasar,
Dialogue: 0,0:05:21.86,0:05:22.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sampai nanti!
Dialogue: 0,0:05:22.72,0:05:23.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke.
Dialogue: 0,0:05:28.81,0:05:32.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh, aku ingin pasar\Nkembali tenang secepat mungkin.
Dialogue: 0,0:05:36.93,0:05:37.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus!
Dialogue: 0,0:05:38.07,0:05:38.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mantap!
Dialogue: 0,0:05:39.57,0:05:42.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Garis pertahanan di 94 yen\Nmemang kuat!
Dialogue: 0,0:05:43.36,0:05:44.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayak mau jatuh, tapi enggak.
Dialogue: 0,0:05:45.03,0:05:47.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Firasatku ini akan memantul naik.
Dialogue: 0,0:05:50.00,0:05:51.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, terus naik!
Dialogue: 0,0:05:51.82,0:05:52.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Naik!
Dialogue: 0,0:05:56.32,0:05:57.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhasil, ya?!
Dialogue: 0,0:06:00.09,0:06:02.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak, sekarang baru sekadar bertahan.
Dialogue: 0,0:06:03.65,0:06:06.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerugian sementara ini harus hilang\Nsebelum akhir bulan,
Dialogue: 0,0:06:06.30,0:06:08.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}baru bisa dibilang\Nbenar-benar selamat.
Dialogue: 0,0:06:09.10,0:06:10.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru saat sedang rugi begini,
Dialogue: 0,0:06:10.98,0:06:12.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}harus menyerang demi menang!
Dialogue: 0,0:06:12.68,0:06:13.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tambah posisi beli!
Dialogue: 0,0:06:14.77,0:06:16.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eksekusi 100 lot!
Dialogue: 0,0:06:19.36,0:06:22.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan ini, kemungkinan selesai\Nsebelum simpanan tunai disetor
Dialogue: 0,0:06:22.29,0:06:24.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menjadi lebih tinggi.
Dialogue: 0,0:06:25.36,0:06:27.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Walau memantul dan harganya naik,
Dialogue: 0,0:06:28.22,0:06:31.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menunggu sampai 95,6 yen\Nbutuh waktu terlalu lama.
Dialogue: 0,0:06:32.29,0:06:34.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, jauh amat!
Dialogue: 0,0:06:35.22,0:06:38.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kalau beli lagi di sini,\Nharga rata-rata beli bakal turun,
Dialogue: 0,0:06:38.79,0:06:41.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan kalau kembali ke 94,75 yen,
Dialogue: 0,0:06:41.23,0:06:42.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sudah bisa mendapat untung.
Dialogue: 0,0:06:43.26,0:06:45.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hore, jadi makin dekat!
Dialogue: 0,0:06:46.06,0:06:47.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah memastikan titik terendahnya,
Dialogue: 0,0:06:48.53,0:06:50.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}harga pasti naik dalam jangka pendek.
Dialogue: 0,0:06:52.45,0:06:53.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi,
Dialogue: 0,0:06:53.84,0:06:56.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau ada pergerakan aneh,\Nlangsung mundur!
Dialogue: 0,0:06:56.13,0:06:58.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini syarat mutlak!
Dialogue: 0,0:06:58.06,0:06:59.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, tunggu!
Dialogue: 0,0:07:02.61,0:07:04.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harus mundur secepat ini?!
Dialogue: 0,0:07:04.77,0:07:06.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak, ini beda!
Dialogue: 0,0:07:07.10,0:07:09.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Turun sedikit begini... wajar saja!
Dialogue: 0,0:07:10.13,0:07:11.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bukan pergerakan aneh!
Dialogue: 0,0:07:18.93,0:07:22.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seandainya turun tajam,\Naku pasti mundur!
Dialogue: 0,0:07:26.94,0:07:28.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waduh, kalau begini...
Dialogue: 0,0:07:37.35,0:07:40.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tambah 150 lot.
Dialogue: 0,0:07:45.70,0:07:47.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurumi saat itu...
Dialogue: 0,0:07:47.68,0:07:48.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah tentu saja,
Dialogue: 0,0:07:55.74,0:07:57.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia tidak berpikir waras.
Dialogue: 0,0:08:00.08,0:08:02.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak, ini belum terlalu buruk.
Dialogue: 0,0:08:02.59,0:08:04.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harga rata-rata beli juga turun...
Dialogue: 0,0:08:04.98,0:08:06.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau enggak beli di posisi ini,
Dialogue: 0,0:08:06.96,0:08:08.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku pasti bakal menyesal.
Dialogue: 0,0:08:08.72,0:08:10.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tindakan yang cuma\Npembelian impulsif itu,
Dialogue: 0,0:08:11.26,0:08:13.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dibenarkannya dengan santai,
Dialogue: 0,0:08:13.81,0:08:15.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi apakah dia benar-benar paham
Dialogue: 0,0:08:16.86,0:08:19.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa yang baru saja dia lakukan?
Dialogue: 0,0:08:32.85,0:08:34.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat.
Dialogue: 0,0:08:38.40,0:08:40.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini gawat!
Dialogue: 0,0:08:41.18,0:08:43.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baru merasa untung 20 ribu yen,
Dialogue: 0,0:08:44.53,0:08:47.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}5 detik kemudian berkurang 60 ribu,
Dialogue: 0,0:08:48.56,0:08:50.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu dua detik kemudian
Dialogue: 0,0:08:51.22,0:08:53.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bertambah 40 ribu yen.
Dialogue: 0,0:08:54.43,0:08:58.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang begini mana bisa\Ndikuasai oleh manusia!
Dialogue: 0,0:09:00.14,0:09:01.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cut loss!
Dialogue: 0,0:09:05.28,0:09:06.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak bisa gerak!
Dialogue: 0,0:09:07.15,0:09:09.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak bisa cut loss!
Dialogue: 0,0:09:10.85,0:09:13.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya uang rumah...
Dialogue: 0,0:09:14.41,0:09:17.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}3 juta yen sudah mulai habis!
Dialogue: 0,0:09:22.17,0:09:23.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesak sekali...
Dialogue: 0,0:09:26.72,0:09:30.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya seperti organ dalamku\Ndiaduk-aduk dengan tongkat.
Dialogue: 0,0:09:31.17,0:09:32.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi pasti...
Dialogue: 0,0:09:32.54,0:09:34.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}saat ini adalah masa tersulitnya.
Dialogue: 0,0:09:35.55,0:09:37.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang pasti sudah di titik terendah.
Dialogue: 0,0:09:38.81,0:09:40.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asalkan bisa bertahan di sini...
Dialogue: 0,0:09:51.82,0:09:52.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti...
Dialogue: 0,0:09:56.91,0:09:57.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti...!
Dialogue: 0,0:10:05.50,0:10:07.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenaikan... palsu?
Dialogue: 0,0:10:26.02,0:10:28.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pukul 21:26,
Dialogue: 0,0:10:28.82,0:10:30.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}AUD/JPY menembus harga terendah.
Dialogue: 0,0:10:32.16,0:10:33.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam kondisi begini,
Dialogue: 0,0:10:33.30,0:10:35.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sudah mustahil bagi Kurumi
Dialogue: 0,0:10:35.86,0:10:37.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk memutuskan cut loss.
Dialogue: 0,0:10:39.92,0:10:43.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika masih ada yang bisa dilakukan...
Dialogue: 0,0:10:47.34,0:10:49.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ku-Kumohon!
Dialogue: 0,0:10:49.38,0:10:50.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon!
Dialogue: 0,0:10:50.63,0:10:51.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolonglah!
Dialogue: 0,0:10:52.54,0:10:53.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuhan...
Dialogue: 0,0:10:54.05,0:10:55.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuhan...
Dialogue: 0,0:10:56.34,0:10:59.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- ...itu hanyalah berdoa kepada Tuhan.\N- Tolonglah.
Dialogue: 0,0:10:59.81,0:11:00.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuhan.
Dialogue: 0,0:11:24.24,0:11:25.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat.
Dialogue: 0,0:11:26.27,0:11:27.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benaran gawat!
Dialogue: 0,0:11:27.90,0:11:29.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harus bagaimana ini?
Dialogue: 0,0:11:29.18,0:11:30.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus bagaimana?!
Dialogue: 0,0:11:31.54,0:11:33.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penurunannya enggak berhenti.
Dialogue: 0,0:11:34.43,0:11:36.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Turun 0,2 yen lagi saja...
Dialogue: 0,0:11:37.06,0:11:38.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kena cut loss otomatis!
Dialogue: 0,0:11:42.35,0:11:43.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak sanggup lagi!
Dialogue: 0,0:11:43.73,0:11:45.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku seperti sudah mati!
Dialogue: 0,0:11:51.23,0:11:52.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan!
Dialogue: 0,0:11:52.77,0:11:53.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan.
Dialogue: 0,0:11:54.83,0:11:56.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong hentikan!
Dialogue: 0,0:11:58.51,0:12:01.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak!
Dialogue: 0,0:12:03.63,0:12:05.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak sanggup!
Dialogue: 0,0:12:05.50,0:12:08.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku... enggak sanggup lihat lagi!
Dialogue: 0,0:12:20.14,0:12:23.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pergerakan tadi... pasti mati...
Dialogue: 0,0:12:25.10,0:12:26.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tamat sudah.
Dialogue: 0,0:12:26.56,0:12:27.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana ini?
Dialogue: 0,0:12:29.33,0:12:31.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Uang yang perlahan-lahan\Ndikumpulkan ayah...
Dialogue: 0,0:12:32.59,0:12:34.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan susah payah...
Dialogue: 0,0:12:36.21,0:12:37.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}semuanya habis tak tersisa.
Dialogue: 0,0:12:43.01,0:12:44.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di hari yang biasa ini...
Dialogue: 0,0:12:45.09,0:12:46.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hari tanpa ada kejadian apa pun,
Dialogue: 0,0:12:48.88,0:12:51.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang kehilangan seluruh harta,
Dialogue: 0,0:12:52.00,0:12:53.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin hanya aku seorang.
Dialogue: 0,0:13:16.53,0:13:20.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tindakan Kurumi yang berpaling\Ndari pasar di situasi ini,
Dialogue: 0,0:13:20.77,0:13:23.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa dibilang pemberani\Ndalam artian lain.
Dialogue: 0,0:13:25.10,0:13:27.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kembali ke beberapa waktu lalu.
Dialogue: 0,0:13:28.59,0:13:29.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sini juga ada...
Dialogue: 0,0:13:30.58,0:13:33.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}seorang investor\Nyang bertransaksi AUD/JPY.
Dialogue: 0,0:13:42.88,0:13:45.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Woi! Yang bener aja!
Dialogue: 0,0:13:45.94,0:13:49.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa malah turun di hari\Nyang enggak ada apa-apa ini?!
Dialogue: 0,0:13:53.06,0:13:55.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti halnya Kurumi,
Dialogue: 0,0:13:55.27,0:13:57.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia membeli AUD/JPY di harga tinggi...
Dialogue: 0,0:13:58.38,0:14:01.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}...dan terus menunda melakukan cut loss.
Dialogue: 0,0:14:08.62,0:14:10.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Udahlah! Enggak sanggup!
Dialogue: 0,0:14:10.99,0:14:12.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cut loss!
Dialogue: 0,0:14:21.14,0:14:22.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perbedaannya dengan Kurumi
Dialogue: 0,0:14:22.72,0:14:25.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah dia memilih cut loss di sini.
Dialogue: 0,0:14:26.48,0:14:30.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengapa dia menunda cut loss\Nhingga kerugian membengkak seperti ini?
Dialogue: 0,0:14:32.02,0:14:34.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengenai prinsip perilaku yang aneh ini,
Dialogue: 0,0:14:34.59,0:14:38.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dijelaskan oleh teori ekonomi perilaku.
Dialogue: 0,0:14:39.34,0:14:40.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teori Prospek.
Dialogue: 0,0:14:41.60,0:14:43.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari dua contoh skenario ini,
Dialogue: 0,0:14:43.47,0:14:46.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kira-kira mana yang akan Anda pilih?
Dialogue: 0,0:14:49.36,0:14:51.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ogah bayar denda...
Dialogue: 0,0:14:53.50,0:14:54.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menariknya,
Dialogue: 0,0:14:54.85,0:14:57.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}meskipun nilai harapannya sama,
Dialogue: 0,0:14:57.67,0:15:01.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}terbukti ada kecenderungan\Njawaban yang berbeda.
Dialogue: 0,0:15:02.32,0:15:03.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Artinya, manusia...
Dialogue: 0,0:15:04.38,0:15:05.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jika bisa mendapat keuntungan,
Dialogue: 0,0:15:05.98,0:15:08.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan menghindari risiko kehilangannya,...
Dialogue: 0,0:15:08.72,0:15:09.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang ini!
Dialogue: 0,0:15:10.64,0:15:12.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}...lalu jika mengalami kerugian,
Dialogue: 0,0:15:12.56,0:15:15.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}cenderung ingin menghindari kerugian itu.
Dialogue: 0,0:15:16.03,0:15:17.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang ini, kan?
Dialogue: 0,0:15:18.54,0:15:19.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kecenderungan ini,
Dialogue: 0,0:15:19.95,0:15:22.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}saat mengalami kerugian sementara\Ndi dunia pasar,
Dialogue: 0,0:15:22.94,0:15:26.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}muncul dalam bentuk menunda cut loss.
Dialogue: 0,0:15:28.41,0:15:31.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, saat kerugian sementara\Nmencapai batas,
Dialogue: 0,0:15:31.63,0:15:34.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}keraguan di lubuk hati langsung muncul.
Dialogue: 0,0:15:36.03,0:15:39.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Jangan-jangan,\Naku sudah tidak bisa selamat?"
Dialogue: 0,0:15:39.50,0:15:40.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat berpikir begitu,
Dialogue: 0,0:15:40.75,0:15:43.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dunia yang terlihat berubah 180 derajat.
Dialogue: 0,0:15:44.46,0:15:46.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya seperti dunia berakhir,
Dialogue: 0,0:15:47.34,0:15:49.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}seperti pertanda bencana nan dahsyat.
Dialogue: 0,0:15:49.59,0:15:50.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak!
Dialogue: 0,0:15:50.86,0:15:53.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Kalau tidak kabur sekarang, bisa mati!"
Dialogue: 0,0:15:53.28,0:15:54.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berpikir demikian,
Dialogue: 0,0:15:55.06,0:15:57.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia akhirnya memutuskan untuk cut loss.
Dialogue: 0,0:15:59.69,0:16:01.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Haduh, rugi besar!
Dialogue: 0,0:16:02.02,0:16:04.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Artikel begini mana bisa masuk blog-ku!
Dialogue: 0,0:16:06.16,0:16:08.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak! Masih belum!
Dialogue: 0,0:16:09.81,0:16:12.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai ganti dari cut loss ini,
Dialogue: 0,0:16:13.79,0:16:15.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku sudah melihat masa depan.
Dialogue: 0,0:16:19.98,0:16:23.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penurunan AUD/JPY sampai hari ini\Nbaru langkah awal.
Dialogue: 0,0:16:23.76,0:16:25.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penurunan besar baru akan dimulai.
Dialogue: 0,0:16:26.16,0:16:28.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}AUD/JPY menuju 92 yen,
Dialogue: 0,0:16:28.08,0:16:31.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bukan... menembus ke bawah 90 yen!
Dialogue: 0,0:16:31.43,0:16:34.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Artinya, ini kesempatan\Nmerebut kembali semua kerugian!
Dialogue: 0,0:16:35.02,0:16:38.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banting balik jual AUD/JPY!\NAll-in!
Dialogue: 0,0:16:40.98,0:16:44.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ini gagal, aku pensiun dari Forex!
Dialogue: 0,0:16:44.57,0:16:45.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cacing-cacing, naga-naga!
Dialogue: 0,0:16:46.23,0:16:49.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, turunlah dengan patuh!
Dialogue: 0,0:16:49.28,0:16:51.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, pasar terkadang
Dialogue: 0,0:16:51.42,0:16:54.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}seolah menertawakan doa orang-orang,
Dialogue: 0,0:16:55.87,0:16:57.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}langsung berbalik arah.
Dialogue: 0,0:17:01.92,0:17:03.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, bentar.
Dialogue: 0,0:17:03.20,0:17:04.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya harusnya turun?!
Dialogue: 0,0:17:08.21,0:17:09.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apaan ini?!
Dialogue: 0,0:17:12.47,0:17:14.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mau naik, jangan turun dulu!
Dialogue: 0,0:17:14.76,0:17:18.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bangsat...!
Dialogue: 0,0:17:41.46,0:17:42.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa aku...
Dialogue: 0,0:17:44.27,0:17:47.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa berpikir bisa menang di Forex?
Dialogue: 0,0:17:53.84,0:17:56.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rupanya, kemenangan selama ini
Dialogue: 0,0:17:57.15,0:17:58.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sekadar keberuntungan.
Dialogue: 0,0:17:59.42,0:18:02.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sama sekali enggak punya bakat...
Dialogue: 0,0:18:03.65,0:18:04.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di Forex ini.
Dialogue: 0,0:18:12.40,0:18:14.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begini, aku juga...
Dialogue: 0,0:18:17.23,0:18:19.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sama saja seperti ibu.
Dialogue: 0,0:18:27.14,0:18:28.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu...
Dialogue: 0,0:18:38.39,0:18:39.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Selamat pagi.\N- Pagi.
Dialogue: 0,0:18:58.19,0:18:59.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurumi, selamat pagi.
Dialogue: 0,0:19:00.35,0:19:01.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat pagi.
Dialogue: 0,0:19:02.74,0:19:04.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajahmu pucat amat.
Dialogue: 0,0:19:04.87,0:19:06.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti modar dia.
Dialogue: 0,0:19:09.55,0:19:11.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemarin bagaimana kelanjutannya?
Dialogue: 0,0:19:11.71,0:19:14.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena mau mati, aku tidur.
Dialogue: 0,0:19:14.05,0:19:15.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Walau sebenarnya enggak.
Dialogue: 0,0:19:16.18,0:19:17.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu?
Dialogue: 0,0:19:17.39,0:19:18.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan kamu enggak tahu?
Dialogue: 0,0:19:19.90,0:19:21.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi pagi kulihat, AUD/JPY...
Dialogue: 0,0:19:21.89,0:19:23.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}naik sangat tajam, lo.
Dialogue: 0,0:19:24.46,0:19:28.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru... itu enggak ingin kudengar...
Dialogue: 0,0:19:28.45,0:19:32.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena sebelum naik pasti sudah mati\Nterkena cut loss otomatis...
Dialogue: 0,0:19:33.20,0:19:34.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pastinya.
Dialogue: 0,0:19:35.01,0:19:37.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, belum tahu\Nkalau belum dilihat, kan?
Dialogue: 0,0:19:38.08,0:19:39.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa tahu masih selamat.
Dialogue: 0,0:19:40.72,0:19:44.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, kamu sedang\Nmelewatkan kesempatan emas!
Dialogue: 0,0:19:46.99,0:19:49.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, aku lihat dulu.
Dialogue: 0,0:19:52.10,0:19:55.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah mengamati Kurumi 3 bulan,\Naku paham.
Dialogue: 0,0:19:55.78,0:19:57.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sifat asli anak ini adalah...
Dialogue: 0,0:19:58.59,0:20:00.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}babi betina yang serakah.
Dialogue: 0,0:20:03.47,0:20:04.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu ada sedikit umpan,
Dialogue: 0,0:20:04.77,0:20:06.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia enggak bisa menunggu.
Dialogue: 0,0:20:06.24,0:20:09.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bertransaksi leverage tinggi\Ndemi dapat cuan.
Dialogue: 0,0:20:10.34,0:20:11.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuhan...
Dialogue: 0,0:20:11.87,0:20:13.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolonglah...
Dialogue: 0,0:20:13.36,0:20:14.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolonglah...
Dialogue: 0,0:20:14.69,0:20:15.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolonglah...
Dialogue: 0,0:20:16.34,0:20:19.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tipe seperti ini enggak punya\Nakhir yang tanggung.
Dialogue: 0,0:20:20.53,0:20:23.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Antara beruntung lalu jadi miliarder...
Dialogue: 0,0:20:24.46,0:20:26.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau kehilangan segalanya dan hancur.
Dialogue: 0,0:20:27.71,0:20:30.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, biasanya berakhir hancur, sih.
Dialogue: 0,0:20:31.10,0:20:32.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurumi juga jadi sampel yang bagus
Dialogue: 0,0:20:33.67,0:20:35.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan jadi referensi untukku.
Dialogue: 0,0:20:36.17,0:20:37.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuan juga!
Dialogue: 0,0:20:38.82,0:20:39.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:20:46.82,0:20:48.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}1,3 juta yen...
Dialogue: 0,0:20:48.80,0:20:50.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuan terealisasi!
Dialogue: 0,0:20:50.26,0:20:52.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah? Untung besar, tuh.
Dialogue: 0,0:20:53.30,0:20:54.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang benar saja?
Dialogue: 0,0:20:54.56,0:20:56.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seandainya masih selamat pun,\Nenggak mungkin...
Dialogue: 0,0:21:00.72,0:21:03.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa dia dapat tambahan dana\Ndari tempat lain?
Dialogue: 0,0:21:06.59,0:21:07.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak menarik sama sekali.
Dialogue: 0,0:21:08.67,0:21:11.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan hasilin untung\Npakai cara beginian, dong.
Dialogue: 0,0:21:12.17,0:21:14.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mochiko...!
Dialogue: 0,0:21:22.18,0:21:24.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, syukurlah.
Dialogue: 0,0:21:25.20,0:21:27.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kali ini, Kurumi berhasil untung...
Dialogue: 0,0:21:28.37,0:21:30.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa dibilang hanya karena beruntung.
Dialogue: 0,0:21:33.04,0:21:36.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, jika dilihat dari sisi lain,
Dialogue: 0,0:21:36.83,0:21:38.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia tanpa diragukan lagi...
Dialogue: 0,0:21:42.20,0:21:44.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sedang bernasib buruk.
Dialogue: 0,0:21:50.83,0:21:54.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dolar, dolar, dolar, yen
Dialogue: 0,0:21:56.63,0:22:00.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yen, yen, yen, dolar
Dialogue: 0,0:22:01.22,0:22:02.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Euro!
Dialogue: 0,0:22:02.01,0:22:04.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Krona, pound, rubel, rupee
Dialogue: 0,0:22:04.84,0:22:07.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ringgit, rial, dinar, won (Won!)
Dialogue: 0,0:22:07.85,0:22:10.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lira, dirham, baht, franc
Dialogue: 0,0:22:10.68,0:22:12.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tugrik, zloty, lilangeni
Dialogue: 0,0:22:13.60,0:22:16.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Koruna, forint, rufiyaa\NNgultrum, manat, rand
Dialogue: 0,0:22:16.48,0:22:19.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taka, peso, lev, sol\NKyat, mark konvertibel (Mark!)
Dialogue: 0,0:22:19.44,0:22:21.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Afghani, escudo, rupiah, hryvnia
Dialogue: 0,0:22:21.94,0:22:25.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yuan Tiongkok\NQuetzal Guatemala, boliviano
Dialogue: 0,0:22:25.66,0:22:27.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dolar Kanada
Dialogue: 0,0:22:27.58,0:22:31.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dolar Australia
Dialogue: 0,0:22:31.09,0:22:33.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dolar Singapura
Dialogue: 0,0:22:33.44,0:22:36.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dolar Selandia Baru
Dialogue: 0,0:22:36.54,0:22:39.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dolar Amerika
Dialogue: 0,0:22:39.30,0:22:44.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dolar, yen, euro
Dialogue: 0,0:22:45.05,0:22:50.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dolar, yen, euro
Dialogue: 0,0:22:50.85,0:22:56.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yen, dolar, euro
Dialogue: 0,0:22:56.56,0:23:02.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yen, dolar, euro
Dialogue: 0,0:23:02.44,0:23:08.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yen, dolar, euro
Dialogue: 0,0:23:08.78,0:23:12.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dolar, dolar, dolar, yen
Dialogue: 0,0:23:14.58,0:23:18.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yen, yen, yen, dolar
Dialogue: 0,0:23:20.69,0:23:23.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menjadi trader itu melelahkan, ya.
Dialogue: 0,0:23:23.55,0:23:25.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bikin stres dan kesepian.
Dialogue: 0,0:23:26.40,0:23:29.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kemalangan orang lain\Nbisa menjadi hiburan tersendiri, kan?
Dialogue: 0,0:23:30.47,0:23:33.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, di sana juga ada\Nbabi betina serakah.
