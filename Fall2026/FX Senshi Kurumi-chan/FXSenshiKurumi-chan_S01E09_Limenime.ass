Dialogue: 0,0:00:00.00,0:00:00.88,sign,,0000,0000,0000,,TAYANGAN INI HANYA KARYA FIKSI.
Dialogue: 0,0:00:00.96,0:00:02.75,sign,,0000,0000,0000,,FOREX BERISIKO TINGGI DAN KERUGIAN\NDAPAT MELEBIHI MODAL AWAL.
Dialogue: 0,0:00:02.83,0:00:04.96,sign,,0000,0000,0000,,TAYANGAN INI BUKAN ANJURAN INVESTASI.\NBIJAKLAH BERTRANSAKSI ATAS RISIKO PRIBADI.
Dialogue: 0,0:03:28.96,0:03:32.96,sign,,0000,0000,0000,,JANGAN LEWATKAN PELUANG INVESTASI 30 JUTA YEN\NDALAM 6 BULAN SEKARANG ADALAH WAKTU TERBAIK!
Dialogue: 0,0:03:50.00,0:03:51.58,sign,,0000,0000,0000,,SUDAH LAMA NIH, MAIN KE GAME CENTER, YUK!\NNANTI AKU YANG TRAKTIR
Dialogue: 0,0:04:53.17,0:04:54.25,sign,,0000,0000,0000,,MEBUKI\NAPA ADA KABAR DARI MEBUKI? TOLONG INFONYA
Dialogue: 0,0:05:31.54,0:05:32.50,sign,,0000,0000,0000,,SUKU BUNGA MAKSIMAL
Dialogue: 0,0:05:39.50,0:05:40.42,sign,,0000,0000,0000,,PELANGGARAN UU PENANAMAN MODAL (DIKENAKAN SANKSI\NPIDANA) PINJAMAN DI BAWAH 100.000 YEN (MAKSIMAL 20%)
Dialogue: 0,0:05:40.50,0:05:41.38,sign,,0000,0000,0000,,PELANGGARAN UU PEMBATASAN SUKU BUNGA\N(DIKENAKAN SANKSI ADMINISTRATIF) 100.000
Dialogue: 0,0:07:54.21,0:07:55.54,sign,,0000,0000,0000,,BOLEH COBA KERJA DULU GAJI PER JAM 5.000 YEN SHIFT\NFLEKSIBEL + BONUS UANG TUNAI BESAR ADA JAMINAN GAJI
Dialogue: 0,0:07:55.63,0:07:56.92,sign,,0000,0000,0000,,DIBAYAR TUNAI DI HARI YANG SAMA!\NTANPA PENGALAMAN BOLEH!
Dialogue: 0,0:08:10.17,0:08:11.25,sign,,0000,0000,0000,,OHAYOU WORK SPESIAL LOWONGAN\NPARUH WAKTU BISA DILAMAR TANPA PENGALAMAN
Dialogue: 0,0:09:40.29,0:09:41.17,sign,,0000,0000,0000,,KONDISI KETENAGAKERJAAN\NMEMBURUK DENGAN CEPAT
Dialogue: 0,0:10:55.71,0:10:58.75,sign,,0000,0000,0000,,LABA / RUGI BELUM TEREALISASI
Dialogue: 0,0:10:58.83,0:11:01.88,sign,,0000,0000,0000,,SALDO: 3.611.715 YEN
Dialogue: 0,0:11:12.04,0:11:13.13,sign,,0000,0000,0000,,KURUMI
Dialogue: 0,0:12:12.83,0:12:15.50,sign,,0000,0000,0000,,PURE PURE (PURE*2) INFORMASI REKRUTMEN
Dialogue: 0,0:12:15.92,0:12:18.79,sign,,0000,0000,0000,,8 JAMINAN "PURE"
Dialogue: 0,0:12:37.88,0:12:38.75,sign,,0000,0000,0000,,JEPANG
Dialogue: 0,0:12:54.58,0:12:55.42,sign,,0000,0000,0000,,SURAT PENGAKUAN UTANG
Dialogue: 0,0:12:55.50,0:12:57.67,sign,,0000,0000,0000,,KEPADA MOCHIKO KOGANE
Dialogue: 0,0:14:36.29,0:14:38.96,sign,,0000,0000,0000,,KURUMI SI PEJUANG FOREX
Dialogue: 0,0:14:40.58,0:14:41.96,sign,,0000,0000,0000,,KURUMI SI PEJUANG FOREX
Dialogue: 0,0:15:29.46,0:15:32.04,sign,,0000,0000,0000,,PINTU KELUAR PUSAT
Dialogue: 0,0:15:37.25,0:15:38.67,sign,,0000,0000,0000,,PILIH KESUKAAN ANDA
Dialogue: 0,0:18:47.79,0:18:50.08,sign,,0000,0000,0000,,KERETA LOKAL\NJALUR SAITO
Dialogue: 0,0:18:56.08,0:18:56.96,sign,,0000,0000,0000,,BEASISWA 200.000 YEN\NMULAI
Dialogue: 0,0:18:57.04,0:18:58.21,sign,,0000,0000,0000,,TRADING BARENG KAK KURUMI\N+495.100 YEN
Dialogue: 0,0:18:58.29,0:18:58.63,sign,,0000,0000,0000,,BELI GBP, CUT LOSS\N-200.000 YEN
Dialogue: 0,0:18:58.71,0:18:59.21,sign,,0000,0000,0000,,TAMBAHAN TABUNGAN UANG KULIAH 600.000 YEN\NSEKARAT GARA-GARA POSISI JUAL USD/JPY
Dialogue: 0,0:18:59.29,0:19:00.50,sign,,0000,0000,0000,,BEASISWA\NTAMBAH LAGI 200.000 YEN
Dialogue: 0,0:19:00.58,0:19:01.92,sign,,0000,0000,0000,,SEMPAT UNTUNG SESAAT
Dialogue: 0,0:19:03.13,0:19:04.29,sign,,0000,0000,0000,,KARTU KREDIT & PINJAMAN MAHASISWA 200.000 YEN\NDEPOSIT TAMBAHAN
Dialogue: 0,0:20:18.25,0:20:21.21,sign,,0000,0000,0000,,BEBERAPA HARI KEMUDIAN
Dialogue: 0,0:20:21.29,0:20:23.46,sign,,0000,0000,0000,,FOREX NZD/USD MELEMAH SELAMA SESI ASIA
Dialogue: 0,0:20:23.54,0:20:25.50,sign,,0000,0000,0000,,SALDO\NLABA / RUGI BELUM TEREALISASI
Dialogue: 0,0:20:32.50,0:20:34.54,sign,,0000,0000,0000,,YASUKO
Dialogue: 0,0:21:29.75,0:21:31.04,sign,,0000,0000,0000,,SALON ESTETIKA PURE*2
Dialogue: 0,0:21:31.13,0:21:32.96,sign,,0000,0000,0000,,CEK SEMUA WANITA YANG BISA\NMENEMANI BERMAIN SEKARANG JUGA
Dialogue: 0,0:21:45.42,0:21:47.17,sign,,0000,0000,0000,,BELUM BERPENGALAMAN
Dialogue: 0,0:23:34.17,0:23:35.00,sign,,0000,0000,0000,,EPISODE 10\NJANGAN-JANGAN, INI PUNCAKNYA?
Dialogue: 0,0:23:35.08,0:23:42.04,sign,,0000,0000,0000,,ILUSTRASI: RYO UEDA
Dialogue: 0,0:00:08.42,0:00:10.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi? Apa hal penting\Nyang ingin kamu bicarakan?
Dialogue: 0,0:00:15.29,0:00:17.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu ini permintaan berat,\Ntapi kumohon...
Dialogue: 0,0:00:18.67,0:00:21.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong... pinjami aku uang.
Dialogue: 0,0:00:22.25,0:00:23.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon!
Dialogue: 0,0:00:23.75,0:00:25.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Yasuko salah.\N- Kumohon!
Dialogue: 0,0:00:25.88,0:00:27.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak ada yang bisa\Nkulakukan untuknya.
Dialogue: 0,0:00:27.96,0:00:29.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon!
Dialogue: 0,0:00:29.17,0:00:30.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kalaupun ada...\N- Kumohon!
Dialogue: 0,0:00:31.25,0:00:32.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon!
Dialogue: 0,0:00:32.29,0:00:34.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Mendadak sekali bilangnya.\N- Kumohon!
Dialogue: 0,0:00:35.08,0:00:37.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi tergantung jumlahnya juga, sih.
Dialogue: 0,0:00:37.58,0:00:39.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu ingin pinjam berapa?
Dialogue: 0,0:00:39.33,0:00:42.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekitar 1 juta yen...
Dialogue: 0,0:00:42.46,0:00:43.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya...
Dialogue: 0,0:00:44.46,0:00:46.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ku-Kumohon!
Dialogue: 0,0:00:47.38,0:00:49.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mebuki, angkat kepalamu.
Dialogue: 0,0:00:54.33,0:00:56.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, akan kupinjami.
Dialogue: 0,0:00:57.63,0:01:00.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benaran... boleh?
Dialogue: 0,0:01:00.50,0:01:02.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sedang kesulitan, kan?
Dialogue: 0,0:01:08.13,0:01:10.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak!
Dialogue: 0,0:01:11.67,0:01:14.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf sudah merepotkan.
Dialogue: 0,0:01:14.25,0:01:17.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal kamu juga sedang rugi\Ndan kesulitan...
Dialogue: 0,0:01:17.50,0:01:19.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang benar, sih.
Dialogue: 0,0:01:22.96,0:01:26.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya, ada dua syarat\Nkalau mau kupinjami.
Dialogue: 0,0:01:29.00,0:01:30.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama adalah bunga.
Dialogue: 0,0:01:32.00,0:01:33.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal itu enggak masalah!
Dialogue: 0,0:01:33.67,0:01:36.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari awal aku memang berniat\Nmelebihkan sebagai tanda terima kasih!
Dialogue: 0,0:01:37.42,0:01:41.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, ini murni dianggap sebagai\N"pinjaman antarpribadi", ya.
Dialogue: 0,0:01:44.88,0:01:48.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bunganya 109,5% per tahun, ya?
Dialogue: 0,0:01:51.54,0:01:53.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau pinjamannya 1 juta yen,
Dialogue: 0,0:01:55.04,0:01:57.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bunganya sekitar\N90 ribu yen per bulan.
Dialogue: 0,0:03:33.50,0:03:36.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si Mebuki itu pergi ke mana?!
Dialogue: 0,0:03:36.79,0:03:38.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pikirkan baik-baik.
Dialogue: 0,0:03:38.13,0:03:41.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mebuki itu anak rumahan,\Njadi tempat tujuannya pasti terbatas!
Dialogue: 0,0:03:43.71,0:03:44.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misalnya...
Dialogue: 0,0:03:47.79,0:03:49.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Game center langganannya?
Dialogue: 0,0:03:51.67,0:03:53.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pesanku juga sudah dibaca.
Dialogue: 0,0:03:53.54,0:03:56.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan dia terpancing\Nchat-ku terus pergi main.
Dialogue: 0,0:04:01.21,0:04:02.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak ada.
Dialogue: 0,0:04:04.33,0:04:05.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak ada...
Dialogue: 0,0:04:07.75,0:04:09.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak ada di mana pun.
Dialogue: 0,0:04:09.75,0:04:12.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, wajar saja.
Dialogue: 0,0:04:12.13,0:04:14.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang sibuk mencari dana Forex
Dialogue: 0,0:04:14.54,0:04:16.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}enggak mungkin main santai.
Dialogue: 0,0:04:25.42,0:04:26.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mebuki!
Dialogue: 0,0:04:27.46,0:04:29.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Siapa?
Dialogue: 0,0:04:29.42,0:04:31.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mi-Mirip, tapi bukan dia!
Dialogue: 0,0:04:32.17,0:04:33.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Ada perlu?
Dialogue: 0,0:04:34.25,0:04:35.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak, begini...
Dialogue: 0,0:04:37.67,0:04:40.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Las Vegas Cola itu enak, ya.
Dialogue: 0,0:04:40.79,0:04:43.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Aku salah pencet tombolnya.
Dialogue: 0,0:04:43.42,0:04:45.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wa-Walah...
Dialogue: 0,0:04:48.92,0:04:51.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah mencoba\Nmenghubungi Mochiko,
Dialogue: 0,0:04:51.50,0:04:53.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi belum dibaca.
Dialogue: 0,0:04:54.63,0:04:57.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemungkinan besar dia\Npinjam uang padanya,
Dialogue: 0,0:04:57.79,0:04:59.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku enggak tahu tempatnya.
Dialogue: 0,0:05:00.08,0:05:02.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mochiko pasti juga\Nenggak akan meminjaminya.
Dialogue: 0,0:05:06.33,0:05:07.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon,
Dialogue: 0,0:05:07.75,0:05:11.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jangan sampai kamu pergi\Nke rentenir jalanan.
Dialogue: 0,0:05:20.54,0:05:23.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu-Bunga 109,5% per tahun...
Dialogue: 0,0:05:23.75,0:05:25.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Angka yang belum pernah kudengar.
Dialogue: 0,0:05:26.21,0:05:28.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Angkanya tanggung sekali,
Dialogue: 0,0:05:28.67,0:05:31.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi bukannya itu terlalu tinggi?
Dialogue: 0,0:05:32.58,0:05:33.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bunga maksimal.
Dialogue: 0,0:05:34.25,0:05:35.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam UU Pembatasan Bunga,
Dialogue: 0,0:05:35.92,0:05:39.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bunga tahunan diatur sesuai\Njumlah pinjaman
Dialogue: 0,0:05:41.46,0:05:43.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan kontrak pinjaman dengan bunga\Ndi atas 20% per tahun
Dialogue: 0,0:05:43.88,0:05:45.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan dikenai sanksi pidana.
Dialogue: 0,0:05:45.83,0:05:47.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ditangkap!
Dialogue: 0,0:05:47.08,0:05:51.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, batas ini hanya berlaku\Nuntuk lembaga peminjaman resmi
Dialogue: 0,0:05:51.17,0:05:54.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan tidak berlaku bagi\Npinjaman antarpribadi.
Dialogue: 0,0:05:55.63,0:05:57.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bunga 109,5% per tahun.
Dialogue: 0,0:05:58.38,0:06:01.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inilah batas bunga tertinggi\Npinjaman antarpribadi
Dialogue: 0,0:06:01.54,0:06:03.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang tidak dikenai sanksi pidana.
Dialogue: 0,0:06:07.04,0:06:10.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, sekarang aku bahas syarat kedua.
Dialogue: 0,0:06:10.54,0:06:14.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya ini hal yang wajar sih.
Dialogue: 0,0:06:14.54,0:06:16.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak bisa\Nmeminjami pengangguran.
Dialogue: 0,0:06:16.79,0:06:18.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu harus bekerja dengan benar.
Dialogue: 0,0:06:18.92,0:06:21.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu... benar juga.
Dialogue: 0,0:06:21.88,0:06:25.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, kamu sudah meminjam\Ndari pinjaman mahasiswa, ya?
Dialogue: 0,0:06:25.50,0:06:28.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti kamu sudah mulai bekerja\Nuntuk melunasinya?
Dialogue: 0,0:06:29.13,0:06:30.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Ah...
Dialogue: 0,0:06:31.00,0:06:32.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih belum.
Dialogue: 0,0:06:32.88,0:06:34.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa enggak?
Dialogue: 0,0:06:36.00,0:06:37.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, tenang saja.
Dialogue: 0,0:06:38.00,0:06:40.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu kamu dapat tempat kerja,\Nakan langsung kupinjami.
Dialogue: 0,0:06:42.88,0:06:45.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, sudah kepikiran\Nmau bekerja di mana?
Dialogue: 0,0:06:46.21,0:06:48.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, rencananya...
Dialogue: 0,0:06:48.54,0:06:50.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja sif malam di minimarket?
Dialogue: 0,0:06:50.71,0:06:52.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Upah per jamnya juga lumayan.
Dialogue: 0,0:06:52.58,0:06:54.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu enggak realistis.
Dialogue: 0,0:06:55.58,0:06:58.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku pemilik minimarketnya,
Dialogue: 0,0:06:58.25,0:07:02.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku enggak akan menaruh anak lemah\Nsepertimu di sif malam.
Dialogue: 0,0:07:02.33,0:07:03.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti langsung ditolak.
Dialogue: 0,0:07:04.67,0:07:06.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalaupun diterima,
Dialogue: 0,0:07:06.13,0:07:08.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebagai mahasiswi, agar tetap\Ndalam tanggungan orang tua,
Dialogue: 0,0:07:08.67,0:07:11.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}gajimu pasti dibatasi sekitar\N80 ribu yen per bulan.
Dialogue: 0,0:07:11.88,0:07:13.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana sanggup kamu bayar cicilannya?
Dialogue: 0,0:07:14.29,0:07:16.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:07:16.38,0:07:18.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti yang sudah kusebut,
Dialogue: 0,0:07:18.08,0:07:19.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk pinjaman 1 juta yen,
Dialogue: 0,0:07:19.96,0:07:22.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bunganya saja sekitar\N90 ribu yen per bulan, lho.
Dialogue: 0,0:07:23.79,0:07:27.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, apa bunganya\Nenggak bisa diturunkan saja?
Dialogue: 0,0:07:28.25,0:07:29.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengar ya, Mebuki.
Dialogue: 0,0:07:30.13,0:07:32.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada dasarnya, peminjam uang
Dialogue: 0,0:07:32.67,0:07:36.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}harus punya pendapatan tahunan\Nminimal 3 kali lipat pinjaman.
Dialogue: 0,0:07:37.08,0:07:39.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tiga kali lipat berarti...
Dialogue: 0,0:07:39.63,0:07:42.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Kamu harus bekerja di tempat
Dialogue: 0,0:07:42.42,0:07:44.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang minimal bisa menghasilkan\N3 juta yen per tahun.
Dialogue: 0,0:07:45.13,0:07:46.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana ada kerja paruh waktu\Nupah segitu!
Dialogue: 0,0:07:47.04,0:07:48.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak, ada banyak, kok.
Dialogue: 0,0:07:50.83,0:07:52.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misalnya...
Dialogue: 0,0:07:52.96,0:07:54.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pekerjaan seperti ini.
Dialogue: 0,0:07:57.00,0:07:59.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, kamu... bercanda...?
Dialogue: 0,0:08:00.00,0:08:02.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku serius, kok.
Dialogue: 0,0:08:02.08,0:08:05.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Mana mungkin aku melakukan ini!
Dialogue: 0,0:08:05.42,0:08:07.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bicara seenaknya, dong.
Dialogue: 0,0:08:14.29,0:08:16.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku ada di posisimu,
Dialogue: 0,0:08:16.33,0:08:17.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku pasti melakukannya.
Dialogue: 0,0:08:19.75,0:08:20.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula,
Dialogue: 0,0:08:20.79,0:08:23.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pinjam 1 juta yen saja\Nkurasa sama sekali enggak cukup.
Dialogue: 0,0:08:24.33,0:08:26.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu hanya akan memperparah lukamu.
Dialogue: 0,0:08:26.88,0:08:28.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ja-Jadi...
Dialogue: 0,0:08:28.46,0:08:31.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebaiknya aku enggak usah\Nmeminjam, kan?!
Dialogue: 0,0:08:31.08,0:08:35.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudmu aku harus berhenti Forex\Nsebelum terluka lebih dalam, kan?!
Dialogue: 0,0:08:35.42,0:08:37.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, bukan begitu.
Dialogue: 0,0:08:39.67,0:08:41.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kupinjami 2 juta yen saja.
Dialogue: 0,0:08:45.25,0:08:46.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Du-Dua ju...
Dialogue: 0,0:08:47.71,0:08:50.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan begitu, bukan cuma\Nmengembalikan kerugianmu selama ini,
Dialogue: 0,0:08:50.92,0:08:53.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu juga bisa untung besar.
Dialogue: 0,0:08:53.50,0:08:55.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong,
Dialogue: 0,0:08:55.29,0:08:57.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau segitu bunganya berapa?
Dialogue: 0,0:08:57.54,0:09:00.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekitar 180 ribu yen per bulan.
Dialogue: 0,0:09:00.17,0:09:01.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, di tempat seperti ini
Dialogue: 0,0:09:01.96,0:09:04.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu bisa dapat 6 juta yen setahun,
Dialogue: 0,0:09:05.17,0:09:06.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pasti sanggup, kan?
Dialogue: 0,0:09:06.71,0:09:08.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maaf,
Dialogue: 0,0:09:08.13,0:09:11.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa memang enggak ada pilihan\Nuntuk enggak meminjam?
Dialogue: 0,0:09:11.83,0:09:14.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh-boleh saja, kok.
Dialogue: 0,0:09:14.17,0:09:16.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga enggak memaksamu meminjam.
Dialogue: 0,0:09:17.92,0:09:19.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi itu rasanya...
Dialogue: 0,0:09:19.71,0:09:21.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mubazir banget, kan?
Dialogue: 0,0:09:25.50,0:09:27.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kamu sudah berjuang sejauh ini.\N- Kalau mundur sekarang,
Dialogue: 0,0:09:27.96,0:09:30.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- semua usahamu akan sia-sia, loh.\N- Lagian, kamu itu hoki, Mebuki.
Dialogue: 0,0:09:30.29,0:09:32.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Menyedihkan, kan?\N- Siapa yang kasih uang sebanyak ini, kan?
Dialogue: 0,0:09:32.67,0:09:34.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peluang membalikkan keadaan\Nmasih ada, loh.
Dialogue: 0,0:09:34.33,0:09:36.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ibumu tahu uang kuliahmu\Nhabis di Forex,
Dialogue: 0,0:09:37.25,0:09:39.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia pasti sedih, kan?
Dialogue: 0,0:09:41.25,0:09:44.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu, Ayah, Kento...
Dialogue: 0,0:09:45.04,0:09:47.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini, bukan begitu...
Dialogue: 0,0:09:47.92,0:09:50.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya aku ingin berhenti.
Dialogue: 0,0:09:50.75,0:09:53.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski meminjam uang ini,\Npasti enggak akan berhasil.
Dialogue: 0,0:09:54.29,0:09:56.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu itu.
Dialogue: 0,0:09:56.79,0:09:57.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:10:01.46,0:10:02.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Mochiko,
Dialogue: 0,0:10:04.42,0:10:05.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku...
Dialogue: 0,0:10:07.29,0:10:08.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa menang?
Dialogue: 0,0:10:10.04,0:10:12.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau meminjam 2 juta yen,
Dialogue: 0,0:10:12.63,0:10:15.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa semua kerugianku bisa kembali?
Dialogue: 0,0:10:27.50,0:10:30.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, pasti bisa kembali.
Dialogue: 0,0:10:30.75,0:10:32.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya, sekarang kamu
Dialogue: 0,0:10:33.08,0:10:35.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sudah jadi pejuang Forex sejati.
Dialogue: 0,0:10:44.21,0:10:46.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}USD/JPY enggak menembus 115 yen.
Dialogue: 0,0:10:47.08,0:10:49.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenaikan hari ini sampai di sini, ya.
Dialogue: 0,0:10:50.17,0:10:52.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kilau posisiku ini
Dialogue: 0,0:10:53.29,0:10:54.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sama sekali enggak meredup!
Dialogue: 0,0:10:55.71,0:10:58.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini, untung 7,8 juta yen!
Dialogue: 0,0:10:58.83,0:11:01.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Digabung saldo akun, tembus 8 digit!
Dialogue: 0,0:11:02.29,0:11:04.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi sejak pelonggaran tambahan,
Dialogue: 0,0:11:04.63,0:11:07.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}naiknya terlalu lurus hingga seram.
Dialogue: 0,0:11:07.75,0:11:09.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah saatnya waspada.
Dialogue: 0,0:11:09.75,0:11:11.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemungkinan setelah ini
Dialogue: 0,0:11:13.21,0:11:15.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah adu nyali dalam gelap
Dialogue: 0,0:11:15.42,0:11:17.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tanpa tahu kapan harga jatuh!
Dialogue: 0,0:11:18.42,0:11:21.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau nekat tambah posisi beli penuh\Nkarena merasa masih bisa naik...
Dialogue: 0,0:11:23.67,0:11:26.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa-bisa langsung tamat\Ndi langkah pertama.
Dialogue: 0,0:11:27.96,0:11:29.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salah sedikit, sekali harga jatuh,
Dialogue: 0,0:11:29.96,0:11:31.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}semua keuntunganku bisa lenyap.
Dialogue: 0,0:11:33.54,0:11:34.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:11:34.50,0:11:37.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau ingin mengincar 20 juta yen\Ndari beli USD/JPY ini,
Dialogue: 0,0:11:39.17,0:11:41.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lepaskan semua akal sehat
Dialogue: 0,0:11:41.75,0:11:44.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan terus membeli penuh\Nmungkin adalah jawaban yang tepat!
Dialogue: 0,0:11:47.21,0:11:49.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lakukan?! Tambah posisi beli!
Dialogue: 0,0:11:54.17,0:11:55.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak, urungkan saja.
Dialogue: 0,0:11:55.96,0:11:59.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk menambah posisi beli pun,\Nalasannya terlalu lemah.
Dialogue: 0,0:12:00.83,0:12:03.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keputusan yang tenang... kurasa...
Dialogue: 0,0:12:05.42,0:12:07.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Mochiko,
Dialogue: 0,0:12:07.54,0:12:09.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bagaimana kalau tempat ini?
Dialogue: 0,0:12:11.17,0:12:12.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lumayan layak, ya.
Dialogue: 0,0:12:12.83,0:12:15.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang bayarannya lebih besar, mau?
Dialogue: 0,0:12:15.92,0:12:18.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}DEMI KETENANGAN PARA TERAPIS Maaf, ini batas kemampuanku.
Dialogue: 0,0:12:19.21,0:12:21.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya butuh keahlian. Sanggup?
Dialogue: 0,0:12:22.00,0:12:23.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan berusaha.
Dialogue: 0,0:12:23.58,0:12:25.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, telepon\Ndan buat janji wawancara.
Dialogue: 0,0:12:26.04,0:12:28.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, sekarang juga?
Dialogue: 0,0:12:28.75,0:12:30.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belum siap mental...
Dialogue: 0,0:12:30.92,0:12:31.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sini.
Dialogue: 0,0:12:35.21,0:12:36.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, silakan bicara.
Dialogue: 0,0:12:37.88,0:12:38.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}03-1779-7940
Dialogue: 0,0:12:38.83,0:12:41.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo, terima kasih sudah menelepon.
Dialogue: 0,0:12:41.75,0:12:42.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pe-Permisi...
Dialogue: 0,0:12:42.75,0:12:43.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya?
Dialogue: 0,0:12:43.50,0:12:46.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya Mebuki Yamashi.
Dialogue: 0,0:12:46.79,0:12:49.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya melihat situs lowongan kerja...
Dialogue: 0,0:12:49.38,0:12:50.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, mau wawancara?
Dialogue: 0,0:12:50.79,0:12:52.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang juga bisa, kok.
Dialogue: 0,0:12:52.67,0:12:53.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}O-Oh, baik.
Dialogue: 0,0:12:53.71,0:12:54.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, sampai jumpa nanti.
Dialogue: 0,0:12:54.58,0:12:55.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, sampai jumpa nanti.
Dialogue: 0,0:12:55.50,0:12:57.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, mohon bantuannya.
Dialogue: 0,0:12:59.50,0:13:02.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Katanya aku bisa wawancara sekarang.
Dialogue: 0,0:13:02.58,0:13:03.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, dong.
Dialogue: 0,0:13:03.88,0:13:05.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuberi ongkos kereta. Sana berangkat.
Dialogue: 0,0:13:05.96,0:13:06.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik...
Dialogue: 0,0:13:07.50,0:13:08.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya.
Dialogue: 0,0:13:08.67,0:13:11.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beri tahu alamat dan nomor telepon\Nrumah orang tuamu.
Dialogue: 0,0:13:12.63,0:13:14.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ja-Jangan!
Dialogue: 0,0:13:14.08,0:13:15.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong jangan beri tahu orang tuaku!
Dialogue: 0,0:13:16.13,0:13:18.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak akan kuberi tahu\Nasal kamu membayar cicilannya,
Dialogue: 0,0:13:19.42,0:13:23.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kalau kamu sakit atau cedera\Nsampai gagal bayar, aku yang repot, kan?
Dialogue: 0,0:13:24.21,0:13:26.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu benar, sih...
Dialogue: 0,0:13:26.71,0:13:29.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Uang yang kupinjami enggak sedikit, loh.
Dialogue: 0,0:13:32.88,0:13:33.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mebuki,
Dialogue: 0,0:13:34.21,0:13:37.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jangan sampai kamu membuat\Norang tuamu yang baik bersedih.
Dialogue: 0,0:13:40.46,0:13:41.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:13:43.21,0:13:45.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau diterima, kabari aku, ya.
Dialogue: 0,0:13:45.58,0:13:47.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan langsung kutransfer uangnya.
Dialogue: 0,0:13:48.29,0:13:50.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu enggak lupa bawa jaket, kan?
Dialogue: 0,0:13:51.13,0:13:52.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pakai ini.
Dialogue: 0,0:13:53.96,0:13:55.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:13:57.46,0:13:58.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berangkat.
Dialogue: 0,0:14:05.13,0:14:08.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa aku bisa sampai seperti ini?
Dialogue: 0,0:14:14.96,0:14:16.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kebesaran...
Dialogue: 0,0:14:21.79,0:14:23.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bakal berusaha jadi kaya!
Dialogue: 0,0:14:30.58,0:14:34.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harusnya aku enggak usah\Nmengenal dunia seperti ini.
Dialogue: 0,0:14:50.71,0:14:53.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedang apa kamu jam segini?
Dialogue: 0,0:14:53.13,0:14:53.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh...
Dialogue: 0,0:14:53.88,0:14:55.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahaya loh sendirian malam-malam.
Dialogue: 0,0:14:55.88,0:14:56.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}E-Enggak...
Dialogue: 0,0:14:56.67,0:14:59.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ayah dan ibumu di mana?\N- Tu-Tunggu...
Dialogue: 0,0:14:59.17,0:15:00.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siswi SD diamankan!
Dialogue: 0,0:15:00.58,0:15:02.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, aku sudah dewasa!
Dialogue: 0,0:15:02.92,0:15:04.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:15:04.50,0:15:05.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa tunjukkan kartu identitas?
Dialogue: 0,0:15:06.33,0:15:08.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sa-Saat ini aku enggak bawa.
Dialogue: 0,0:15:08.96,0:15:11.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma sedang mencari temanku.
Dialogue: 0,0:15:16.04,0:15:17.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mebuki!
Dialogue: 0,0:15:17.88,0:15:19.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Te-Temanku sudah ketemu!
Dialogue: 0,0:15:20.25,0:15:21.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhenti dulu.
Dialogue: 0,0:15:22.38,0:15:25.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa jelaskan dulu detailnya?
Dialogue: 0,0:15:25.92,0:15:28.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Me-Mebuki!
Dialogue: 0,0:15:32.13,0:15:35.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau cicilanku macet,\Norang tuaku bakal ikut repot.
Dialogue: 0,0:15:35.54,0:15:37.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya itu harus kuhindari.
Dialogue: 0,0:15:39.13,0:15:41.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak, orang tuaku saja\Nyang enggak tahu,
Dialogue: 0,0:15:41.75,0:15:44.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi selama ini aku sudah\Nmerepotkan mereka.
Dialogue: 0,0:15:44.54,0:15:47.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga sudah berkata kasar\Npada Yasuko.
Dialogue: 0,0:15:48.46,0:15:50.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan kebohongan seperti itu!
Dialogue: 0,0:15:50.38,0:15:52.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal kamu belum pernah\Nuntung sekali pun!
Dialogue: 0,0:15:54.21,0:15:55.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Parah sekali.
Dialogue: 0,0:15:55.92,0:15:58.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mungkin sudah kehilangan\Nteman berhargaku.
Dialogue: 0,0:16:07.50,0:16:08.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yasuko?
Dialogue: 0,0:16:12.33,0:16:13.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok kamu di sini?
Dialogue: 0,0:16:13.83,0:16:15.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah dengar semuanya\Ndari Kurumi.
Dialogue: 0,0:16:16.00,0:16:17.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mencarimu ke mana-mana, tahu!
Dialogue: 0,0:16:19.58,0:16:21.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya kamu mau berutang, ya?
Dialogue: 0,0:16:22.29,0:16:24.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ini bodoh banget, ya?
Dialogue: 0,0:16:24.42,0:16:26.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya! Super bodoh!
Dialogue: 0,0:16:26.63,0:16:30.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mebuki adalah... si super ultra\Ngreat delicious wonderful
Dialogue: 0,0:16:30.42,0:16:32.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ultra bomber bodoh!
Dialogue: 0,0:16:33.63,0:16:35.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu jauh-jauh ke sini\Ncuma untuk bilang itu?
Dialogue: 0,0:16:40.08,0:16:41.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mebuki.
Dialogue: 0,0:16:42.58,0:16:44.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana ada orang yang diam saja
Dialogue: 0,0:16:44.58,0:16:46.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}saat temannya berbuat bodoh?
Dialogue: 0,0:16:52.67,0:16:53.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih...
Dialogue: 0,0:17:06.58,0:17:09.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}K-Kamu enggak naik keretanya?
Dialogue: 0,0:17:09.50,0:17:11.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya.
Dialogue: 0,0:17:14.25,0:17:18.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dulu, kukira Forex itu dunia\Nyang lebih gemerlap
Dialogue: 0,0:17:18.50,0:17:21.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan menyenangkan.
Dialogue: 0,0:17:30.08,0:17:31.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kita semua
Dialogue: 0,0:17:32.54,0:17:34.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa mencari uang dengan senang,
Dialogue: 0,0:17:35.04,0:17:36.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pasti indah sekali.
Dialogue: 0,0:17:37.46,0:17:38.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu cuma khayalan.
Dialogue: 0,0:17:39.46,0:17:41.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang menang di dunia ini
Dialogue: 0,0:17:41.75,0:17:44.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pasti berada di tempat paling jauh\Ndari hal-hal gemerlap.
Dialogue: 0,0:17:45.42,0:17:46.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yasuko,
Dialogue: 0,0:17:46.92,0:17:49.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}maaf sudah mengajakmu main Forex
Dialogue: 0,0:17:49.46,0:17:52.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hingga menghabiskan\Nuang berhargamu.
Dialogue: 0,0:17:52.54,0:17:54.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan salahmu.
Dialogue: 0,0:17:54.38,0:17:56.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memang sudah main Forex sejak dulu.
Dialogue: 0,0:17:57.04,0:18:00.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu keputusanku dan tanggung jawabku.
Dialogue: 0,0:18:02.75,0:18:06.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi akhirnya kamu wawancara\Nkerja paruh waktu juga, ya.
Dialogue: 0,0:18:06.42,0:18:08.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sempat khawatir\Nkamu pergi ke mana,
Dialogue: 0,0:18:08.63,0:18:10.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sekarang aku sedikit lega.
Dialogue: 0,0:18:10.33,0:18:12.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa orang sepertiku bisa bekerja?
Dialogue: 0,0:18:12.75,0:18:15.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak percaya diri dan takut.
Dialogue: 0,0:18:15.54,0:18:18.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awalnya semua orang merasa begitu.
Dialogue: 0,0:18:18.25,0:18:19.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}coba saja dulu.
Dialogue: 0,0:18:21.25,0:18:23.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi? Kamu bekerja di mana?
Dialogue: 0,0:18:23.42,0:18:24.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti aku main ke sana.
Dialogue: 0,0:18:24.83,0:18:26.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rahasia, soalnya memalukan.
Dialogue: 0,0:18:26.83,0:18:27.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:18:28.04,0:18:31.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, dengan ini kamu sudah lulus\Ndari dunia Forex, ya!
Dialogue: 0,0:18:32.46,0:18:33.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan begitu.
Dialogue: 0,0:18:34.67,0:18:38.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, pertarunganku\Nbelum selesai.
Dialogue: 0,0:18:38.38,0:18:41.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Posisi jual USD/JPY-ku\Nmasih berlanjut.
Dialogue: 0,0:18:42.33,0:18:43.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:18:43.96,0:18:47.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuceritakan saja semuanya\Nyang terjadi selama ini.
Dialogue: 0,0:18:53.54,0:18:55.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, maksudmu...
Dialogue: 0,0:19:05.83,0:19:07.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}...seperti ini?
Dialogue: 0,0:19:07.63,0:19:10.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu memborong semua hal tabu!
Dialogue: 0,0:19:13.08,0:19:16.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mungkin melakukan hal\Nyang jauh lebih tabu.
Dialogue: 0,0:19:16.17,0:19:17.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa lagi?
Dialogue: 0,0:19:17.33,0:19:19.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bilang apa pun lagi,\Naku enggak bakal kaget.
Dialogue: 0,0:19:20.71,0:19:23.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena ini pertarungan terakhir,
Dialogue: 0,0:19:23.63,0:19:26.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku meminjam 2 juta yen\Ndari Kak Mochiko.
Dialogue: 0,0:19:38.04,0:19:40.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- De-Dengar, ya!\N- Pintu akan dibuka.
Dialogue: 0,0:19:40.33,0:19:43.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Sepertinya sudah sampai.\N- Periksa kembali bawaan sebelum turun.
Dialogue: 0,0:19:46.83,0:19:48.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pergi dulu, ya.
Dialogue: 0,0:19:48.79,0:19:51.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Toh aku memang harus bekerja.
Dialogue: 0,0:19:51.63,0:19:53.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be-Benar juga.
Dialogue: 0,0:19:53.46,0:19:54.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semangat wawancaranya.
Dialogue: 0,0:19:55.17,0:19:57.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih untuk hari ini.\NSampai jumpa.
Dialogue: 0,0:20:09.96,0:20:11.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mebuki memang bodoh karena meminjam,
Dialogue: 0,0:20:12.46,0:20:14.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi meminjaminya juga salah.
Dialogue: 0,0:20:14.71,0:20:17.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harusnya kamu menghentikannya, Mochiko!
Dialogue: 0,0:20:26.08,0:20:28.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Naik hampir tanpa tekanan jual, ya.
Dialogue: 0,0:20:29.25,0:20:31.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini di luar dugaanku.
Dialogue: 0,0:20:35.58,0:20:36.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Mochiko!
Dialogue: 0,0:20:37.75,0:20:38.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:20:38.96,0:20:42.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minggu depan, aku butuh bantuanmu\Njaga stan di Comitia.
Dialogue: 0,0:20:42.79,0:20:43.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bisa, kan?
Dialogue: 0,0:20:44.04,0:20:45.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jaga stan?
Dialogue: 0,0:20:45.33,0:20:46.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa harus aku?
Dialogue: 0,0:20:46.83,0:20:48.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bisa jadi pengalaman sosial!
Dialogue: 0,0:20:48.75,0:20:51.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagian, aksesoris terbatas Comitia\Nitu keren banget!
Dialogue: 0,0:20:58.46,0:21:00.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang terdengar bermanfaat, sih.
Dialogue: 0,0:21:00.88,0:21:03.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus, ada yang mau\Nkubicarakan langsung denganmu.
Dialogue: 0,0:21:05.25,0:21:07.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh saja, hari itu aku luang.
Dialogue: 0,0:21:07.79,0:21:09.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, nanti kuhubungi lagi.
Dialogue: 0,0:21:14.13,0:21:17.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tujuan sebenarnya soal Mebuki, ya.
Dialogue: 0,0:21:18.33,0:21:21.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Merepotkan sekali, ya,\Nhubungan antarmanusia itu.
Dialogue: 0,0:21:23.88,0:21:26.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah sampai mana USD/JPY\Nakan terus naik.
Dialogue: 0,0:21:36.71,0:21:40.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu harus semangat mencari uang, Mebuki.
Dialogue: 0,0:21:42.67,0:21:43.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, tapi...
Dialogue: 0,0:21:44.13,0:21:45.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wakaba.
Dialogue: 0,0:23:20.46,0:23:23.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu dan Mochiko itu\Ntipe yang beda jauh, kan?
Dialogue: 0,0:23:23.83,0:23:25.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kalian bisa akrab?
Dialogue: 0,0:23:25.50,0:23:26.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hmm...
Dialogue: 0,0:23:26.46,0:23:28.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin karena kesukaan kami sama.
Dialogue: 0,0:23:28.92,0:23:31.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesukaan? Memangnya apa itu?
Dialogue: 0,0:23:32.13,0:23:34.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu jelas...
