Dialogue: 0,0:16:48.99,0:16:50.61,sign,,0000,0000,0000,,SALDO
Dialogue: 0,0:18:01.23,0:18:02.81,sign,,0000,0000,0000,,PESAN BARU: AKU COBA BELI USD/JPY!\NLANGSUNG PASANG 60 LOT!
Dialogue: 0,0:18:10.32,0:18:11.78,sign,,0000,0000,0000,,PESAN BARU: USD/JPY, YA...\NMEMANG KELIHATAN BAKAL NAIK, SIH...
Dialogue: 0,0:18:16.75,0:18:19.55,sign,,0000,0000,0000,,PANDUAN DASAR!\NCARA MENGAMBAR KOMIK YANG VIRAL
Dialogue: 0,0:18:19.55,0:18:20.08,sign,,0000,0000,0000,,OLEH YOSHIKO, KELAS 2 SMP\N10.000 RETWEET
Dialogue: 0,0:20:58.65,0:21:00.70,sign,,0000,0000,0000,,YASUKO, STATUS POSISI: TIDAK ADA POSISI\NAPA MEBUKI BAKAL AMAN, YA...
Dialogue: 0,0:21:00.95,0:21:02.80,sign,,0000,0000,0000,,MEBUKI, STATUS POSISI: USD/JPY JUAL 20 LOT\NHARGA RATA-RATA 106.632\NPASTI BAKAL TURUN!
Dialogue: 0,0:21:02.80,0:21:05.18,sign,,0000,0000,0000,,KURUMI, STATUS POSISI: USD/JPY BELI 60 LOT\NHARGA RATA-RATA 106.789, NAIKLAH~
Dialogue: 0,0:21:05.18,0:21:06.10,sign,,0000,0000,0000,,MOCHIKO STATUS POSISI USD/JPY BELI 50 LOT\NHARGA RATA-RATA 106.832\NKAYAKNYA SUDAH ENGGAK BAKAL TURUN LAGI...
Dialogue: 0,0:21:10.67,0:21:11.83,sign,,0000,0000,0000,,KURUMI, LABA / RUGI\NBELUM TEREALISASI: +456.600 YEN
Dialogue: 0,0:21:16.10,0:21:17.46,sign,,0000,0000,0000,,MOCHIKO, LABA / RUGI\NBELUM TEREALISASI: +359.000 YEN
Dialogue: 0,0:21:20.24,0:21:22.39,sign,,0000,0000,0000,,YASUKO\NLABA / RUGI BELUM TEREALISASI: 0 YEN
Dialogue: 0,0:21:22.97,0:21:23.76,sign,,0000,0000,0000,,UNIVERSITAS SHINTO
Dialogue: 0,0:21:34.82,0:21:36.91,sign,,0000,0000,0000,,MEBUKI, LABA / RUGI\NBELUM TEREALISASI: -258.100 YEN
Dialogue: 0,0:21:37.28,0:21:40.65,sign,,0000,0000,0000,,MEBUKI, LABA / RUGI\NBELUM TEREALISASI: -258.100 YEN
Dialogue: 0,0:23:33.89,0:23:34.98,sign,,0000,0000,0000,,EPISODE 8\NPELONGGARAN MONETER ADALAH PESTA PORA
Dialogue: 0,0:23:34.98,0:23:46.45,sign,,0000,0000,0000,,ILUSTRASI: MASAKUNI IGARASHI
Dialogue: 0,0:00:07.24,0:00:09.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya adalah segmen berikut.
Dialogue: 0,0:00:09.74,0:00:11.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peringkat ramalan zodiak pagi!
Dialogue: 0,0:00:11.57,0:00:13.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zodiak paling beruntung hari ini
Dialogue: 0,0:00:13.83,0:00:15.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah Anda yang Pisces!
Dialogue: 0,0:00:15.83,0:00:17.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku?
Dialogue: 0,0:00:17.29,0:00:20.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesempatan besar akan segera tiba!
Dialogue: 0,0:00:20.25,0:00:23.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Barang keberuntunganmu adalah gelang!
Dialogue: 0,0:00:23.60,0:00:26.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gelang apanya...
Dialogue: 0,0:00:28.18,0:00:30.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam kondisi ini,\Naku bergantung pada apa pun.
Dialogue: 0,0:00:31.10,0:00:32.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai sekarang,
Dialogue: 0,0:00:32.09,0:00:35.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}operasi deposit\Nseluruh biaya hidup dimulai!
Dialogue: 0,0:00:36.27,0:00:40.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Deposit uang beasiswa bulanan\Nke akun Forex hingga batas maksimal!
Dialogue: 0,0:00:40.45,0:00:43.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan begitu, batas kerugian naik\Ndan aku bisa bertahan hidup!
Dialogue: 0,0:00:43.98,0:00:45.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makan sekali sehari sudah cukup!
Dialogue: 0,0:00:45.84,0:00:48.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asal ada air keran dan pinggiran roti,\Naku udah aman!
Dialogue: 0,0:00:48.86,0:00:51.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ditambah makanan yang dikirim\Norang tuaku sesekali,
Dialogue: 0,0:00:51.65,0:00:53.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}asupan nutrisiku akan sempurna!
Dialogue: 0,0:00:53.49,0:00:55.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar pertahanan sempurna!
Dialogue: 0,0:00:59.44,0:01:00.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yey!
Dialogue: 0,0:01:00.53,0:01:02.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama enggak kena cut loss paksa,
Dialogue: 0,0:01:02.45,0:01:04.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ini adalah taktik yang pasti menang!
Dialogue: 0,0:01:05.06,0:01:07.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inilah strategi tak terkalahkan!
Dialogue: 0,0:02:41.93,0:02:44.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harusnya taktik ini berhasil...
Dialogue: 0,0:02:44.60,0:02:46.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harusnya berhasil...
Dialogue: 0,0:02:46.62,0:02:48.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harusnya ini strategi yang sempurna...
Dialogue: 0,0:02:49.19,0:02:51.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak bisa, ini enggak mungkin...
Dialogue: 0,0:02:52.11,0:02:54.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski deposit 100 ribu yen sebulan,
Dialogue: 0,0:02:54.46,0:02:56.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}nyawa yang bertambah cuma 0,5 yen.
Dialogue: 0,0:02:56.83,0:03:00.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kenyataannya, harganya naik\Nhampir 4 yen dalam dua minggu!
Dialogue: 0,0:03:00.78,0:03:03.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kecepatan segini,\Ndepositku enggak akan sempat ngejar!
Dialogue: 0,0:03:03.45,0:03:05.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Uangku sama sekali enggak cukup!
Dialogue: 0,0:03:06.24,0:03:07.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku buntu!
Dialogue: 0,0:03:16.68,0:03:17.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepuluh yen...
Dialogue: 0,0:03:17.82,0:03:19.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak, satu yen aja sudah cukup.
Dialogue: 0,0:03:20.18,0:03:23.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau seluruh warga Jepang\Nmenyumbang untukku, aku akan selamat.
Dialogue: 0,0:03:24.98,0:03:27.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa negara ini\Nenggak bisa bikin begitu?!
Dialogue: 0,0:03:38.48,0:03:39.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, yang ini?
Dialogue: 0,0:03:39.86,0:03:41.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sendiri yang bikin.
Dialogue: 0,0:03:41.68,0:03:44.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, jepit rambut itu juga\Nkamu buat sendiri?
Dialogue: 0,0:03:44.99,0:03:46.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:03:46.05,0:03:48.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sempat jual di internet,
Dialogue: 0,0:03:48.54,0:03:50.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi enggak laku sama sekali.
Dialogue: 0,0:03:50.50,0:03:54.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau enggak ada merek terkenal,\Nmemang sulit jual barang, kan?
Dialogue: 0,0:03:54.30,0:03:55.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga...
Dialogue: 0,0:03:55.68,0:03:58.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya kali ini aku memutuskan\Nuntuk mencoba menggambar manga.
Dialogue: 0,0:03:58.80,0:04:02.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau naikin pamor\Ndi sosmed terus ikut Comitia.
Dialogue: 0,0:04:02.72,0:04:05.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, enggak ada salahnya dicoba.
Dialogue: 0,0:04:05.31,0:04:06.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Biasanya dalam situasi seperti ini,\N- Iya, kamu pasti bisa!
Dialogue: 0,0:04:06.93,0:04:09.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- aku harus menyajikan camilan.\N- Iya, kamu pasti bisa!
Dialogue: 0,0:04:09.21,0:04:10.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tapi, jangan harap!\N- Wah, terima kasih!
Dialogue: 0,0:04:10.29,0:04:13.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Maaf, tapi semua ini makanan daruratku!\N- Aku bakal coba, deh!
Dialogue: 0,0:04:15.90,0:04:17.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini tehnya.
Dialogue: 0,0:04:17.44,0:04:18.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:04:18.70,0:04:20.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, ini dia!
Dialogue: 0,0:04:25.92,0:04:27.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan salah, Yasuko!
Dialogue: 0,0:04:27.58,0:04:31.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salah besar kalau kamu ngira bakal ada\Ncamilan tiap main ke rumahku!
Dialogue: 0,0:04:31.79,0:04:33.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo masuk ke topik utama!
Dialogue: 0,0:04:34.04,0:04:34.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jreng!
Dialogue: 0,0:04:34.88,0:04:37.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah membuat aturan\NPertarungan Investasi Super!
Dialogue: 0,0:04:37.88,0:04:38.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana?
Dialogue: 0,0:04:38.86,0:04:41.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baru sadar, kita memang\Nbelum memutuskannya.
Dialogue: 0,0:04:41.31,0:04:44.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mebuki, kamu juga harus dengar!
Dialogue: 0,0:04:44.18,0:04:46.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak ada waktu buat itu...
Dialogue: 0,0:04:46.22,0:04:48.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma kesepakatan sederhana!
Dialogue: 0,0:04:48.31,0:04:51.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama, durasi! Sampai Natal tahun ini!
Dialogue: 0,0:04:51.82,0:04:53.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kedua, penentuan pemenang!
Dialogue: 0,0:04:53.65,0:04:58.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemenang ditentukan dari berapa persen\Nkenaikan saldo akun Forex dari awal!
Dialogue: 0,0:04:58.28,0:05:01.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang menang paling banyak\Nharus traktirin makan!
Dialogue: 0,0:05:01.81,0:05:02.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asyik, kan?
Dialogue: 0,0:05:02.78,0:05:04.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bebas makan apa saja?
Dialogue: 0,0:05:04.27,0:05:06.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tambah chashu di ramen juga boleh?
Dialogue: 0,0:05:06.06,0:05:07.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seafood mewah juga boleh?
Dialogue: 0,0:05:07.79,0:05:09.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, bebas apa aja.
Dialogue: 0,0:05:09.34,0:05:10.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asyik, nih, Mebuki!
Dialogue: 0,0:05:11.31,0:05:13.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bisa makan pakai uang orang lain!
Dialogue: 0,0:05:13.49,0:05:15.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, benar juga...
Dialogue: 0,0:05:15.87,0:05:18.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minus 550 ribu yen...
Dialogue: 0,0:05:18.35,0:05:22.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau naik 1 yen lagi,\Naku akan rugi 700 ribu yen!
Dialogue: 0,0:05:22.38,0:05:24.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin balik modal\Ncuma dari traktiran!
Dialogue: 0,0:05:25.02,0:05:27.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kalian semua\Nmalah kelihatan senang?!
Dialogue: 0,0:05:27.52,0:05:30.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan yang rugi cuma aku?
Dialogue: 0,0:05:30.06,0:05:32.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, aturannya sudah fix, ya.
Dialogue: 0,0:05:32.19,0:05:34.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang menang harus traktir semua orang!
Dialogue: 0,0:05:34.75,0:05:37.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang aja! Aku lagi rugi!
Dialogue: 0,0:05:37.38,0:05:38.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu juga, Yasuko?
Dialogue: 0,0:05:39.30,0:05:42.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saldo berkurang 7% sejak mulai!
Dialogue: 0,0:05:42.74,0:05:44.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rugi 5.000 yen!
Dialogue: 0,0:05:44.77,0:05:46.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Forex itu benaran susah, ya.
Dialogue: 0,0:05:46.99,0:05:49.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jumlah ruginya dikit amat!
Dialogue: 0,0:05:49.17,0:05:51.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Segitu sih harusnya menang!
Dialogue: 0,0:05:51.58,0:05:53.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, kerugianku lebih besar.
Dialogue: 0,0:05:54.17,0:05:55.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Mochiko rugi?
Dialogue: 0,0:05:56.32,0:05:58.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saldo berkurang 10% sejak mulai.
Dialogue: 0,0:05:58.77,0:06:00.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rugi 1,2 juta yen.
Dialogue: 0,0:06:02.16,0:06:04.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hal seperti ini benar-benar\Nenggak perlu dibanggakan.
Dialogue: 0,0:06:04.93,0:06:07.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya kemarin-kemarin kamu menang?
Dialogue: 0,0:06:07.97,0:06:10.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pas aku beli Euro, harganya malah anjlok.
Dialogue: 0,0:06:10.35,0:06:12.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok kamu bisa sekalem itu?!
Dialogue: 0,0:06:12.46,0:06:14.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sih pasti udah terbaring sakit\Nsampai setahun!
Dialogue: 0,0:06:14.88,0:06:16.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah terbiasa melakukan cut loss.
Dialogue: 0,0:06:16.77,0:06:19.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata Kak Mochiko bisa rugi juga.
Dialogue: 0,0:06:19.76,0:06:21.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku agak lega.
Dialogue: 0,0:06:21.19,0:06:22.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pasti sedang untung kan, Kurumi?
Dialogue: 0,0:06:23.12,0:06:27.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh... Aku belum menutup posisinya, sih.
Dialogue: 0,0:06:27.10,0:06:29.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, aku tutup saja posisinya sekarang.
Dialogue: 0,0:06:29.70,0:06:31.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan...
Dialogue: 0,0:06:37.63,0:06:40.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Posisi USD/JPY waktu itu\Nmasih kamu pegang?
Dialogue: 0,0:06:40.59,0:06:43.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, kali ini aku agak serakah.
Dialogue: 0,0:06:43.50,0:06:47.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti Kurumi untung sekitar\N1,5 juta yen dari transaksi ini.
Dialogue: 0,0:06:50.14,0:06:51.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan itu?
Dialogue: 0,0:06:52.22,0:06:54.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Kurumi justru\Nbertolak belakang dari aku.
Dialogue: 0,0:06:54.60,0:06:56.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia ambil posisi beli?
Dialogue: 0,0:06:56.77,0:06:59.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keuntungan bertambah 70% lebih!
Dialogue: 0,0:06:59.66,0:07:01.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuanku kali ini benaran besar!
Dialogue: 0,0:07:02.19,0:07:05.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti kalau aku meniru\NKak Kurumi seperti biasanya,
Dialogue: 0,0:07:05.76,0:07:07.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}harusnya aku bisa menang?
Dialogue: 0,0:07:07.58,0:07:09.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesal banget!
Dialogue: 0,0:07:11.52,0:07:14.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begini, pemenangnya Kurumi saja.
Dialogue: 0,0:07:14.03,0:07:15.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau langsung mengundurkan diri.
Dialogue: 0,0:07:16.00,0:07:17.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya juga, ya.
Dialogue: 0,0:07:18.88,0:07:20.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, Mebuki...
Dialogue: 0,0:07:23.01,0:07:24.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, begitulah.
Dialogue: 0,0:07:25.10,0:07:28.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita minta ditraktir makan bareng, yuk?
Dialogue: 0,0:07:28.83,0:07:31.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak, aku akan tetap bertarung!
Dialogue: 0,0:07:31.18,0:07:34.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini aku memegang posisi terkuat!
Dialogue: 0,0:07:35.18,0:07:36.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang akan menang di akhir
Dialogue: 0,0:07:36.94,0:07:37.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah aku!
Dialogue: 0,0:07:41.65,0:07:43.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudahlah, Bodoh.
Dialogue: 0,0:07:46.96,0:07:48.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai jumpa.
Dialogue: 0,0:07:48.45,0:07:51.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai ketemu hari Senin di kampus!
Dialogue: 0,0:07:51.28,0:07:53.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau pergi\Nkerja paruh waktu sekarang.
Dialogue: 0,0:07:53.84,0:07:55.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, semangat, ya.
Dialogue: 0,0:08:11.46,0:08:12.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halah,
Dialogue: 0,0:08:12.76,0:08:15.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ternyata dia punya\Norang tua yang baik.
Dialogue: 0,0:08:16.05,0:08:18.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf sudah menyita waktumu.
Dialogue: 0,0:08:18.73,0:08:21.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya saat ini aku sedang rugi besar.
Dialogue: 0,0:08:21.90,0:08:24.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kasihan sekali,\Npadahal kamu punya posisi terkuat.
Dialogue: 0,0:08:24.80,0:08:26.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berapa kerugianmu?
Dialogue: 0,0:08:31.28,0:08:33.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekitar 500 ribu yen.
Dialogue: 0,0:08:33.56,0:08:36.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu hangus terbakar\Nkarena kenaikan USD/JPY, ya?
Dialogue: 0,0:08:36.64,0:08:38.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, gosong total.
Dialogue: 0,0:08:39.12,0:08:41.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Posisi jual USD/JPY saat ini...
Dialogue: 0,0:08:41.14,0:08:43.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jangankan terkuat, malah terlemah, 'kan?
Dialogue: 0,0:08:43.82,0:08:45.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi dari modal awal 200 ribu yen,
Dialogue: 0,0:08:45.89,0:08:48.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bukannya sempat bertambah\Nsampai hampir 700 ribu yen?
Dialogue: 0,0:08:48.67,0:08:52.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Uang 700 ribu yen ini\Nadalah biaya kuliahku tahun depan!
Dialogue: 0,0:08:52.40,0:08:54.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena modal pertamaku\Nsudah ludes di Pound,
Dialogue: 0,0:08:54.43,0:08:55.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ini adalah deposit kedua...
Dialogue: 0,0:08:56.22,0:08:57.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}O-Oh, begitu...
Dialogue: 0,0:08:58.14,0:08:59.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan itu?
Dialogue: 0,0:08:59.47,0:09:01.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sudah jadi chasiu siap santap.
Dialogue: 0,0:09:02.32,0:09:03.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku...
Dialogue: 0,0:09:03.55,0:09:05.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus bagaimana?
Dialogue: 0,0:09:07.18,0:09:08.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenangkan dirimu dulu.
Dialogue: 0,0:09:08.74,0:09:10.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau sampaikan dua hal.
Dialogue: 0,0:09:11.86,0:09:15.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama, keputusanmu deposit\Ndengan uang kuliah itu sudah benar.
Dialogue: 0,0:09:15.24,0:09:18.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanpa deposit, enggak akan ada\Nkesempatan membalikkan keadaan.
Dialogue: 0,0:09:19.55,0:09:22.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apalagi kalau gagal,\Norang tuamu yang akan membayarnya.
Dialogue: 0,0:09:22.70,0:09:26.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ta-Tapi keluargaku bukan orang kaya.
Dialogue: 0,0:09:26.30,0:09:29.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kan putri kesayangan mereka.\NMereka pasti punya cara.
Dialogue: 0,0:09:30.29,0:09:31.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagi orang tua normal.
Dialogue: 0,0:09:32.51,0:09:33.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, yang kedua.
Dialogue: 0,0:09:34.14,0:09:35.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}USD/JPY kelak pasti akan turun.
Dialogue: 0,0:09:36.38,0:09:37.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga!
Dialogue: 0,0:09:37.51,0:09:39.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kira-kira turunnya seberapa banyak?
Dialogue: 0,0:09:39.98,0:09:41.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai ke kisaran 100 yen?
Dialogue: 0,0:09:41.48,0:09:42.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serius?!
Dialogue: 0,0:09:43.44,0:09:45.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku enggak tahu\Nkapan itu akan terjadi.
Dialogue: 0,0:09:46.43,0:09:49.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti analisisku enggak salah!
Dialogue: 0,0:09:49.17,0:09:50.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu mau kuberi
Dialogue: 0,0:09:50.57,0:09:52.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}satu informasi bonus lagi?
Dialogue: 0,0:09:52.53,0:09:53.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau dengar!
Dialogue: 0,0:09:54.16,0:09:55.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini khusus untukmu, ya.
Dialogue: 0,0:09:55.70,0:09:57.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini rahasia bagaimana Kurumi
Dialogue: 0,0:09:57.66,0:10:01.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa dapat cuan gila-gilaan\Nsebelum bertemu denganmu...
Dialogue: 0,0:10:02.40,0:10:04.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat transaksi AUD/JPY,
Dialogue: 0,0:10:05.44,0:10:07.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurumi berutang untuk menang taruhan!
Dialogue: 0,0:10:08.38,0:10:09.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berutang?!
Dialogue: 0,0:10:10.19,0:10:12.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia benaran sampai begitu?
Dialogue: 0,0:10:12.17,0:10:15.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemungkinan besar dia\Nmeminjam lebih dari 1 juta yen.
Dialogue: 0,0:10:15.33,0:10:18.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski wajahnya imut,\Ndia penjudi yang cukup nekat.
Dialogue: 0,0:10:18.43,0:10:19.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penjudi?!
Dialogue: 0,0:10:19.46,0:10:22.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti dia cuma menang\Nkarena murni keberuntungan, kan?
Dialogue: 0,0:10:36.70,0:10:37.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Abaikan!
Dialogue: 0,0:10:37.87,0:10:39.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan waktunya memikirkan kuliah!
Dialogue: 0,0:10:39.87,0:10:41.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar cewek cuma modal hoki!
Dialogue: 0,0:10:42.19,0:10:44.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku sudah rajin membaca buku!
Dialogue: 0,0:10:45.17,0:10:47.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keberuntunganku saja yang kurang...
Dialogue: 0,0:10:48.46,0:10:51.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah! Bikin kesal aja!
Dialogue: 0,0:10:56.76,0:10:59.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin aku bisa pergi ke salon!
Dialogue: 0,0:10:59.06,0:11:00.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kan enggak punya uang!
Dialogue: 0,0:11:01.50,0:11:02.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh iya...
Dialogue: 0,0:11:03.81,0:11:07.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pernah dengar kalau\Nmemotong rambut bisa buang sial.
Dialogue: 0,0:11:10.66,0:11:11.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke!
Dialogue: 0,0:11:11.98,0:11:13.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, kali ini...
Dialogue: 0,0:11:20.86,0:11:22.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan menyucikan diri,
Dialogue: 0,0:11:23.83,0:11:25.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan mendatangkan keberuntungan!
Dialogue: 0,0:11:27.44,0:11:28.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya USD/JPY...
Dialogue: 0,0:11:29.42,0:11:31.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}juga harusnya sudah mulai turun!
Dialogue: 0,0:11:33.18,0:11:34.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}110 yen?!
Dialogue: 0,0:11:36.72,0:11:38.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benar-benar lengah!
Dialogue: 0,0:11:38.58,0:11:40.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sisa nyawaku tinggal 30 ribu yen.
Dialogue: 0,0:11:40.53,0:11:43.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau naik 0,1 yen lagi,\Nlangsung kena cut loss paksa?!
Dialogue: 0,0:11:44.64,0:11:48.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apalagi kalau gagal,\Norang tuamu yang akan membayarnya.
Dialogue: 0,0:11:49.73,0:11:50.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang...
Dialogue: 0,0:11:51.18,0:11:55.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama, aku harus menganalisis\Ndengan tenang kenapa harganya bisa naik.
Dialogue: 0,0:11:55.68,0:11:57.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama aku menang, enggak masalah.
Dialogue: 0,0:11:57.31,0:11:59.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena aku belum kalah!
Dialogue: 0,0:12:02.78,0:12:06.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya! Harganya naik karena aku\Nterus memperhatikannya?!
Dialogue: 0,0:12:06.06,0:12:08.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku akan berpaling!
Dialogue: 0,0:12:09.04,0:12:10.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini mungkin trik rahasianya.
Dialogue: 0,0:12:11.02,0:12:12.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harusnya harganya bisa turun!
Dialogue: 0,0:12:15.67,0:12:16.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, kan!
Dialogue: 0,0:12:16.78,0:12:19.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taktik cemerlang\Nmemanfaatkan nasib buruk!
Dialogue: 0,0:12:21.60,0:12:23.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahaya! Kalau kulihat,\Nharganya bakal naik lagi!
Dialogue: 0,0:12:24.22,0:12:25.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan berpaling sekali lagi!
Dialogue: 0,0:12:27.44,0:12:28.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekali lagi!
Dialogue: 0,0:12:28.98,0:12:30.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekali lagi!
Dialogue: 0,0:12:30.35,0:12:31.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekali lagi!
Dialogue: 0,0:12:42.46,0:12:45.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berpaling segala...\NSama sekali enggak ada gunanya.
Dialogue: 0,0:12:45.66,0:12:47.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma bikin capek.
Dialogue: 0,0:12:48.08,0:12:49.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada akhirnya, USD/JPY...
Dialogue: 0,0:12:50.38,0:12:53.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penurunan yang memakan waktu 7 jam\Nkembali naik hanya dalam 2 jam.
Dialogue: 0,0:12:56.19,0:12:57.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duh...
Dialogue: 0,0:13:00.51,0:13:02.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah, dong...
Dialogue: 0,0:13:05.17,0:13:07.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kedua kalinya menembus 110 yen!
Dialogue: 0,0:13:15.14,0:13:15.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Loh?
Dialogue: 0,0:13:23.78,0:13:25.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}USD/JPY kelak pasti akan turun.
Dialogue: 0,0:13:42.69,0:13:44.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Turun...
Dialogue: 0,0:13:44.08,0:13:45.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Turun lagi!
Dialogue: 0,0:13:45.89,0:13:49.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bisa melewati ini,\Nbukan cuma sekadar selamat!
Dialogue: 0,0:13:49.20,0:13:51.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya keberuntungan memihak padaku!
Dialogue: 0,0:13:51.87,0:13:54.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penurunan drastis ajaib pemberian Tuhan!
Dialogue: 0,0:13:55.10,0:13:59.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak akan pernah\Nmelepaskan posisi jual ini lagi!
Dialogue: 0,0:14:00.24,0:14:03.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demikianlah, kenaikan pasar USD/JPY
Dialogue: 0,0:14:04.10,0:14:07.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di angka 110 yen per Dolar hari itu
Dialogue: 0,0:14:07.98,0:14:10.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menjadi "puncak sementara".
Dialogue: 0,0:14:19.92,0:14:22.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belakangan ini, kamu jarang ke kampus.
Dialogue: 0,0:14:22.21,0:14:23.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nilai SKS-mu aman?
Dialogue: 0,0:14:24.01,0:14:24.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya...
Dialogue: 0,0:14:25.62,0:14:28.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal SKS sih gampang\Nkalau boleh menyalin catatan.
Dialogue: 0,0:14:29.17,0:14:30.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, enak!
Dialogue: 0,0:14:30.93,0:14:33.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, syukurlah kamu kelihatan sehat!
Dialogue: 0,0:14:37.65,0:14:39.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh iya, Mochiko.
Dialogue: 0,0:14:39.48,0:14:42.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sempat menarik 1 juta yen\Nuntuk persiapan pajak,
Dialogue: 0,0:14:42.99,0:14:45.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kurasa USD/JPY tetap akan naik.
Dialogue: 0,0:14:48.37,0:14:51.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Risiko geopolitik kurasa sudah mereda.
Dialogue: 0,0:14:51.22,0:14:54.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyesuaian pelemahan Dolar\Nakibat QE3 juga sudah selesai,
Dialogue: 0,0:14:54.62,0:14:56.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bukannya akhirnya akan mulai naik?
Dialogue: 0,0:14:57.34,0:14:59.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sama sekali\Nenggak paham omongannya.
Dialogue: 0,0:14:59.89,0:15:01.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paling dia cuma asal bunyi!
Dialogue: 0,0:15:01.88,0:15:04.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu menganggap penurunan USD/JPY\Nbaru-baru ini cuma penyesuaian, ya?
Dialogue: 0,0:15:05.25,0:15:08.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi bukannya ini penguatan Yen,\Nbukan pelemahan Dolar?
Dialogue: 0,0:15:08.39,0:15:11.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelonggaran moneter BOJ\Njuga sepertinya sudah mentok.
Dialogue: 0,0:15:11.64,0:15:14.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski belum jelas akan mengarah ke mana.
Dialogue: 0,0:15:15.04,0:15:17.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Mochiko memang hebat!
Dialogue: 0,0:15:17.15,0:15:19.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak paham,\Ntapi sepertinya dia menyanggah!
Dialogue: 0,0:15:20.96,0:15:24.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kurasa sebentar lagi akan naik...
Dialogue: 0,0:15:25.14,0:15:26.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelas mau dimulai.
Dialogue: 0,0:15:27.92,0:15:29.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku duluan, ya.
Dialogue: 0,0:15:30.49,0:15:32.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai nanti.
Dialogue: 0,0:15:35.76,0:15:38.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Kurumi mau beli USD/JPY,
Dialogue: 0,0:15:38.50,0:15:39.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia pasti akan kalah.
Dialogue: 0,0:15:39.67,0:15:41.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm, kenapa begitu?
Dialogue: 0,0:15:41.54,0:15:43.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena keberuntungannya sudah habis!
Dialogue: 0,0:15:44.21,0:15:47.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama ini Kak Kurumi terlalu sering\Nmenang cuma modal hoki!
Dialogue: 0,0:15:47.76,0:15:49.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Secara probabilitas,
Dialogue: 0,0:15:49.50,0:15:52.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kemungkinan dia kalah berikutnya\Njadi lebih tinggi.
Dialogue: 0,0:15:52.38,0:15:55.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaliknya, bagiku yang selama ini\Nselalu bernasib buruk,
Dialogue: 0,0:15:55.66,0:15:58.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kemungkinan untuk menang besar\Ndi posisi jual itu sangat tinggi!
Dialogue: 0,0:15:59.06,0:16:02.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau melempar koin 10 kali\Ndan keluar angka 10 kali berturut-turut,
Dialogue: 0,0:16:02.75,0:16:06.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kemungkinan keluar gambar terus-menerus\Nakan jadi lebih tinggi, kan?
Dialogue: 0,0:16:06.64,0:16:08.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Prinsipnya sama!
Dialogue: 0,0:16:17.21,0:16:19.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elu tuh sebodoh ini, kah?!
Dialogue: 0,0:16:19.50,0:16:21.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Level obrolannya serendah itu!
Dialogue: 0,0:16:21.68,0:16:24.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teori probabilitasnya salah total.
Dialogue: 0,0:16:24.13,0:16:26.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bocah begini bisa lulus SMA?!
Dialogue: 0,0:16:26.92,0:16:30.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akui keberuntungan Kurumi kuat,\Ntapi menganggapnya cuma hoki?
Dialogue: 0,0:16:30.54,0:16:32.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia terlalu meremehkan Kurumi.
Dialogue: 0,0:16:33.97,0:16:35.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, untuk kali ini...
Dialogue: 0,0:16:36.62,0:16:38.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, aku sependapat.
Dialogue: 0,0:16:46.82,0:16:48.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya jatuh!
Dialogue: 0,0:16:50.83,0:16:52.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berbalik jadi untung!
Dialogue: 0,0:16:52.35,0:16:54.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku selamat!
Dialogue: 0,0:16:55.55,0:16:58.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat? Omong kosong macam apa itu?!
Dialogue: 0,0:16:59.76,0:17:02.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah bertahan melewati\Nhari-hari neraka itu,
Dialogue: 0,0:17:02.25,0:17:04.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}keuntungan yang kudapat\Ncuma beberapa ribu yen?!
Dialogue: 0,0:17:06.40,0:17:08.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak sebanding banget!
Dialogue: 0,0:17:08.16,0:17:10.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana sudi aku menutup posisi\Ndemi untung sekacang ini!
Dialogue: 0,0:17:10.84,0:17:12.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Posisi jual ini akan terus kupegang!
Dialogue: 0,0:17:13.92,0:17:16.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan genggaman sekuat gorila!
Dialogue: 0,0:17:17.68,0:17:19.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pasti akan untung besar!
Dialogue: 0,0:17:20.40,0:17:24.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam pikiran Mebuki,\Ntidak ada pilihan untuk mundur.
Dialogue: 0,0:17:25.55,0:17:29.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keberhasilannya bertahan\Ndari kondisi ekstrem
Dialogue: 0,0:17:29.01,0:17:32.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dianggapnya sebagai keajaiban ilahi.
Dialogue: 0,0:17:33.33,0:17:34.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oleh karena itu,
Dialogue: 0,0:17:34.32,0:17:37.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}penurunan USD/JPY ini\Nadalah kehendak Tuhan.
Dialogue: 0,0:17:38.35,0:17:39.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asalkan percaya,
Dialogue: 0,0:17:39.86,0:17:44.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia yakin pasti akan meraih\Nkemenangan besar.
Dialogue: 0,0:17:46.34,0:17:48.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenaikan ini wajar saja.
Dialogue: 0,0:17:48.77,0:17:51.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau turun terlalu cepat,\Ntentu saja akan naik lagi.
Dialogue: 0,0:17:52.09,0:17:54.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak boleh tertipu\Noleh kenaikan sementara.
Dialogue: 0,0:17:54.80,0:17:57.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak akan pernah\Nmenutup posisiku!
Dialogue: 0,0:18:03.02,0:18:04.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:18:05.25,0:18:08.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Kurumi, posisi belimu itu jebakan!
Dialogue: 0,0:18:11.90,0:18:13.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu! Sampai Yasuko juga?!
Dialogue: 0,0:18:15.30,0:18:16.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:18:16.75,0:18:19.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira ada apa, ternyata cuma soal itu.
Dialogue: 0,0:18:20.56,0:18:23.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}USD/JPY tampaknya akan naik,\Ntapi aku enggak beli.
Dialogue: 0,0:18:23.16,0:18:26.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beda dengan mahasiswa menganggur,\Naku ini sibuk!
Dialogue: 0,0:18:26.80,0:18:28.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah kalau begitu.
Dialogue: 0,0:18:28.11,0:18:31.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku khawatir kamu bakal rugi lagi, Yasuko.
Dialogue: 0,0:18:31.41,0:18:32.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan urusanmu.
Dialogue: 0,0:18:32.99,0:18:36.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagian, apa kamu pikir\NUSD/JPY bakal turun?
Dialogue: 0,0:18:36.01,0:18:37.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti turun!
Dialogue: 0,0:18:37.14,0:18:39.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin percaya pada posisi jual ini!
Dialogue: 0,0:18:39.46,0:18:42.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini posisi yang sudah\Nmelewati krisis bersamaku!
Dialogue: 0,0:18:42.53,0:18:45.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, hei, kamu sudah pegang posisi jual?!
Dialogue: 0,0:18:45.10,0:18:46.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak kapan?!
Dialogue: 0,0:18:46.35,0:18:48.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak awal bulan lalu.
Dialogue: 0,0:18:48.35,0:18:50.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu kan... sebelum harganya naik?!
Dialogue: 0,0:18:50.98,0:18:52.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekuat apa genggamanmu?!
Dialogue: 0,0:18:53.20,0:18:55.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mebuki, dengarkan saranku.
Dialogue: 0,0:18:55.42,0:18:57.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Segera tutup posisimu sekarang juga!
Dialogue: 0,0:18:57.49,0:18:59.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke-Kenapa kamu bicara begitu?!
Dialogue: 0,0:19:01.60,0:19:04.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau harganya terus naik,\Nkamu akan kehilangan semuanya!
Dialogue: 0,0:19:04.15,0:19:05.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tahu apa, Yasuko?!
Dialogue: 0,0:19:05.96,0:19:09.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kan pemula Forex\Nyang baru mulai setelah aku!
Dialogue: 0,0:19:10.63,0:19:14.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh... sebenarnya\Naku sudah lama main Forex...
Dialogue: 0,0:19:14.88,0:19:16.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak usah bohong begitu!
Dialogue: 0,0:19:16.77,0:19:18.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal belum pernah untung sekali pun!
Dialogue: 0,0:19:18.78,0:19:20.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang benar, sih.
Dialogue: 0,0:19:20.81,0:19:24.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku enggak ingin kamu mengalami\Nkegagalan yang sama denganku!
Dialogue: 0,0:19:25.14,0:19:27.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sarannya.
Dialogue: 0,0:19:27.54,0:19:29.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semangat gambar komiknya, ya.
Dialogue: 0,0:19:34.48,0:19:35.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Payah.
Dialogue: 0,0:19:39.78,0:19:42.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mebuki? Ada apa?
Dialogue: 0,0:19:42.34,0:19:44.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau bertanya langsung.
Dialogue: 0,0:19:44.22,0:19:46.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutmu USD/JPY\Nbakal bergerak ke mana?
Dialogue: 0,0:19:46.75,0:19:48.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bikin repot ini bocah.
Dialogue: 0,0:19:48.42,0:19:50.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kulihat sebentar.
Dialogue: 0,0:19:51.81,0:19:54.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penurunan drastis ini\Nkarena panic selling?
Dialogue: 0,0:19:54.55,0:19:57.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemulihan drastis ini terjadi karena\Npara pembeli di harga tinggi lenyap?
Dialogue: 0,0:19:58.32,0:20:01.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tekanan jual tampaknya reda,\Npergerakan ke atas jadi lebih ringan.
Dialogue: 0,0:20:01.55,0:20:03.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau disuruh memilih, cenderung beli...
Dialogue: 0,0:20:04.06,0:20:06.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hmm, ini agak sulit.
Dialogue: 0,0:20:06.78,0:20:08.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana menurutmu, Mebuki?
Dialogue: 0,0:20:08.52,0:20:10.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutku harganya masih bakal turun,
Dialogue: 0,0:20:11.19,0:20:15.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi Kurumi dan Yasuko bilang\Nharganya akan naik.
Dialogue: 0,0:20:15.68,0:20:18.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutmu, apa harganya akan naik?
Dialogue: 0,0:20:18.82,0:20:22.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm, posisi sampah itu\Nternyata masih dia pegang.
Dialogue: 0,0:20:22.99,0:20:24.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak. Bakal turun.
Dialogue: 0,0:20:26.12,0:20:27.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kalau begitu...
Dialogue: 0,0:20:28.88,0:20:30.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ikut pendapatmu.
Dialogue: 0,0:20:31.02,0:20:33.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga akan pasang\Nposisi jual untuk USD/JPY.
Dialogue: 0,0:20:35.31,0:20:36.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kupasang.
Dialogue: 0,0:20:36.42,0:20:38.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti kita teman seperjuangan!
Dialogue: 0,0:20:38.46,0:20:40.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, benar sekali.
Dialogue: 0,0:20:43.10,0:20:44.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hore!
Dialogue: 0,0:20:44.43,0:20:46.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hore! Hore!
Dialogue: 0,0:20:46.43,0:20:48.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jual USD/JPY adalah keputusan tepat!
Dialogue: 0,0:20:48.90,0:20:50.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di pihakku ada seorang profesional pasar,
Dialogue: 0,0:20:51.02,0:20:53.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Mochiko, yang mendukungku!
Dialogue: 0,0:20:54.18,0:20:57.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Kurumi, kali ini\Ngiliranku untuk menang!
Dialogue: 0,0:21:00.95,0:21:02.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasar USD/JPY
Dialogue: 0,0:21:02.80,0:21:06.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kembali bergerak ke arah pelemahan Yen.
Dialogue: 0,0:21:08.54,0:21:10.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurumi memegang posisi beli.
Dialogue: 0,0:21:12.72,0:21:16.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perasaan Mochiko dengan posisi serupa\Njuga tetap tenang.
Dialogue: 0,0:21:17.82,0:21:20.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yasuko tidak memegang posisi apa pun
Dialogue: 0,0:21:20.24,0:21:22.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan memilih menjaga jarak dari pasar.
Dialogue: 0,0:21:23.76,0:21:28.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sementara Mebuki yang bertahan\Npada posisi jual seorang diri...
Dialogue: 0,0:21:28.75,0:21:31.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin karena merasa tenang\Nkarena didukung oleh Mochiko,
Dialogue: 0,0:21:32.03,0:21:34.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia terlihat tenang.
Dialogue: 0,0:21:34.82,0:21:36.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada suatu sore yang damai,
Dialogue: 0,0:21:37.28,0:21:40.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berita mengejutkan yang mengguncang\Npasar beredar luas.
Dialogue: 0,0:21:44.59,0:21:48.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pilar api raksasa mendadak muncul\Ndi pasar USD/JPY.
Dialogue: 0,0:23:24.62,0:23:27.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat pasar anjlok lalu panik
Dialogue: 0,0:23:27.33,0:23:29.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan terburu-buru menjual posisi.
Dialogue: 0,0:23:29.55,0:23:31.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti dirimu sekarang ini.
Dialogue: 0,0:23:31.04,0:23:33.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku setenang gorila, kok!
