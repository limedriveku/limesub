Dialogue: 0,0:00:10.26,0:00:12.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Uangku...!
Dialogue: 0,0:00:17.17,0:00:18.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Naiklah.
Dialogue: 0,0:00:19.60,0:00:20.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Naiklah!
Dialogue: 0,0:00:25.63,0:00:26.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah pulang.
Dialogue: 0,0:00:39.12,0:00:40.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurumi?
Dialogue: 0,0:00:45.42,0:00:46.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, selamat datang.
Dialogue: 0,0:00:47.11,0:00:48.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu masih bangun?
Dialogue: 0,0:00:49.06,0:00:51.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, besok ada ujian.
Dialogue: 0,0:00:51.61,0:00:52.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:00:53.06,0:00:54.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan terlalu dipaksa.
Dialogue: 0,0:00:54.83,0:00:56.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, selamat tidur.
Dialogue: 0,0:00:56.80,0:00:58.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, selamat tidur.
Dialogue: 0,0:01:17.38,0:01:18.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah naik.
Dialogue: 0,0:01:19.71,0:01:21.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku selamat.
Dialogue: 0,0:01:26.02,0:01:27.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu...
Dialogue: 0,0:01:30.46,0:01:31.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}20 juta yen...
Dialogue: 0,0:01:32.38,0:01:33.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku...
Dialogue: 0,0:01:34.75,0:01:36.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pasti akan...
Dialogue: 0,0:03:13.42,0:03:17.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Forex adalah jual beli mata uang dunia,
Dialogue: 0,0:03:17.23,0:03:21.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sejenis investasi untuk mendapat\Nkeuntungan dari selisihnya.
Dialogue: 0,0:03:25.42,0:03:28.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah sekitar tiga bulan\Naku ikut permainan uang ini.
Dialogue: 0,0:03:29.78,0:03:31.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awalnya memang sempat rugi,
Dialogue: 0,0:03:32.69,0:03:34.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi sekarang aku terus melaju pesat!
Dialogue: 0,0:03:35.53,0:03:38.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Total keuntunganku sudah mencapai\Nlebih dari 500 ribu yen!
Dialogue: 0,0:03:42.05,0:03:43.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Caranya sangat simpel!
Dialogue: 0,0:03:43.79,0:03:47.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama, prediksi pergerakan\Nnilai mata uang target!
Dialogue: 0,0:03:48.30,0:03:51.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Analisis grafik yang menampilkan\Nharga secara real-time di atas!
Dialogue: 0,0:03:52.56,0:03:54.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau diperkirakan naik, beli!
Dialogue: 0,0:03:55.74,0:03:57.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau diperkirakan turun, jual!
Dialogue: 0,0:03:59.23,0:04:01.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, setelah mengambil\Nsalah satu posisi,
Dialogue: 0,0:04:05.02,0:04:06.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sisanya tinggal tutup posisi.
Dialogue: 0,0:04:10.46,0:04:12.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan mengulang proses ini,
Dialogue: 0,0:04:13.22,0:04:15.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku terus menguras uang dari pasar.
Dialogue: 0,0:04:27.76,0:04:30.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini sepertinya\Ntidak ada peluang juga.
Dialogue: 0,0:04:34.64,0:04:35.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Selamat pagi.\N- Selamat pagi.
Dialogue: 0,0:04:37.60,0:04:38.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lucunya.
Dialogue: 0,0:04:39.30,0:04:42.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oleh karena itu, hal ini terjadi,
Dialogue: 0,0:04:42.76,0:04:45.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita tidak bisa menilai hasilnya\Nbegitu saja,
Dialogue: 0,0:04:46.05,0:04:47.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bagaimana hasilnya nanti
Dialogue: 0,0:04:47.43,0:04:50.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}perlu dinilai dalam jangka panjang.
Dialogue: 0,0:04:51.10,0:04:51.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo!
Dialogue: 0,0:04:54.02,0:04:55.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mochiko.
Dialogue: 0,0:04:55.44,0:04:56.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini kamu kesiangan?
Dialogue: 0,0:04:56.77,0:04:58.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, aku sedang pantau pasar.
Dialogue: 0,0:05:00.03,0:05:02.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu? Dapat untung?
Dialogue: 0,0:05:03.07,0:05:05.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bulan ini sama sekali tidak ada.
Dialogue: 0,0:05:05.28,0:05:07.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada pergerakan harga,\Njadi aku cuma pantau.
Dialogue: 0,0:05:07.79,0:05:09.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasarnya ampas banget, ya.
Dialogue: 0,0:05:10.29,0:05:12.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga merasa begitu.
Dialogue: 0,0:05:12.58,0:05:15.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau pasarnya begini\Nsepanjang tahun?
Dialogue: 0,0:05:15.78,0:05:18.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayangnya, itu sangat mungkin terjadinya.
Dialogue: 0,0:05:18.88,0:05:22.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku ingin menghasilkan\N20 juta yen tahun ini.
Dialogue: 0,0:05:22.82,0:05:23.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jujur saja,
Dialogue: 0,0:05:23.89,0:05:27.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pasar yang stabil\Nadalah musuh para trader.
Dialogue: 0,0:05:27.81,0:05:28.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu,
Dialogue: 0,0:05:29.02,0:05:31.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tetap ada cara menghasilkan uang\Nsaat pasar stagnan.
Dialogue: 0,0:05:32.95,0:05:35.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang berisiko tinggi,\Ntapi dengan tambah lot transaksi
Dialogue: 0,0:05:35.44,0:05:36.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}serta jumlah taruhannya,
Dialogue: 0,0:05:36.90,0:05:38.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita bisa atur
Dialogue: 0,0:05:38.30,0:05:40.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}agar tetap untung dari pergerakan kecil.
Dialogue: 0,0:05:44.07,0:05:46.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, aku ketemu\Nmata uang yang bagus, lo.
Dialogue: 0,0:05:46.95,0:05:48.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, masa?
Dialogue: 0,0:05:49.84,0:05:51.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini, AUD/JPY.
Dialogue: 0,0:05:54.17,0:05:55.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dolar Australia.
Dialogue: 0,0:05:56.03,0:05:58.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mata uang utama yang dulu\Nditransaksikan oleh ibuku.
Dialogue: 0,0:06:02.21,0:06:03.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dulu pada zaman Ibu,
Dialogue: 0,0:06:04.08,0:06:08.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dolar Australia melemah\Ndari kisaran 90-an ke 50-an yen,
Dialogue: 0,0:06:09.81,0:06:13.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi sekarang harganya pulih\Nseolah tidak terjadi apa-apa.
Dialogue: 0,0:06:20.94,0:06:24.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam jangka pendek,\Ngrafiknya terlihat ingin dibeli.
Dialogue: 0,0:06:24.83,0:06:25.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, kan?
Dialogue: 0,0:06:25.91,0:06:28.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pergerakan harganya lumayan besar,
Dialogue: 0,0:06:28.03,0:06:29.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ayo beli dalam jumlah besar!
Dialogue: 0,0:06:29.84,0:06:32.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, kalau mau masuk besar,
Dialogue: 0,0:06:32.58,0:06:34.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sepertinya kita sudah terlambat.
Dialogue: 0,0:06:34.99,0:06:37.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi ada peluang menuju 100 yen, lo?
Dialogue: 0,0:06:38.32,0:06:40.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang ada di kisaran 95 yen,
Dialogue: 0,0:06:40.55,0:06:43.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau beli 100 lot di sini\Ndan mengambil untung 5 yen,
Dialogue: 0,0:06:44.94,0:06:46.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita bisa dapat 5 juta yen!
Dialogue: 0,0:06:48.55,0:06:50.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}E-Enggak, enggak...
Dialogue: 0,0:06:50.39,0:06:52.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sih terlalu berlebihan.
Dialogue: 0,0:06:54.00,0:06:57.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kalau pakai pialang luar negeri,\Nharusnya bisa beli, kan?
Dialogue: 0,0:06:57.71,0:06:59.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang bisa beli,
Dialogue: 0,0:06:59.40,0:07:01.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi risiko ke modalnya sangat besar.
Dialogue: 0,0:07:01.32,0:07:02.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa, sih?
Dialogue: 0,0:07:04.15,0:07:04.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba lihat.
Dialogue: 0,0:07:05.95,0:07:08.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Blogger ini juga beli, lo!
Dialogue: 0,0:07:11.06,0:07:14.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu kan bisa aja cuma demi konten...
Dialogue: 0,0:07:15.49,0:07:17.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, bagaimana dengan ini?
Dialogue: 0,0:07:18.46,0:07:21.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pinjam 3 juta yen dariku,
Dialogue: 0,0:07:21.74,0:07:23.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu beli menggunakan uang itu.
Dialogue: 0,0:07:28.34,0:07:29.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bicara apa, sih?
Dialogue: 0,0:07:30.21,0:07:31.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin aku pinjam.
Dialogue: 0,0:07:32.37,0:07:33.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga, ya.
Dialogue: 0,0:07:33.73,0:07:37.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus, bagaimana kalau gagal\Ndan semuanya habis?
Dialogue: 0,0:07:37.62,0:07:39.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang susah kan kamu sendiri?
Dialogue: 0,0:07:40.23,0:07:41.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa, sih?
Dialogue: 0,0:07:41.81,0:07:43.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, kamu bisa kembalikan pelan-pelan.
Dialogue: 0,0:07:44.34,0:07:46.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bicara seenaknya begitu, dong.
Dialogue: 0,0:07:46.77,0:07:47.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ih...
Dialogue: 0,0:07:49.20,0:07:50.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, maaf, ada telepon.
Dialogue: 0,0:07:51.99,0:07:53.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo, Mebuki?
Dialogue: 0,0:07:54.53,0:07:55.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:07:56.43,0:07:57.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mochiko.
Dialogue: 0,0:07:57.65,0:08:01.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teman investasi yang kutemui\Nwaktu tahun pertama kuliah.
Dialogue: 0,0:08:01.94,0:08:04.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya dia sudah main saham\Nsejak SMA,
Dialogue: 0,0:08:04.58,0:08:06.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pengalaman investasinya di atasku,
Dialogue: 0,0:08:07.22,0:08:09.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}total asetnya setidaknya...
Dialogue: 0,0:08:09.04,0:08:10.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lebih dari 10 juta yen.
Dialogue: 0,0:08:11.72,0:08:13.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin keluarganya kaya.
Dialogue: 0,0:08:14.21,0:08:15.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dunia ini luas juga, ya.
Dialogue: 0,0:08:15.93,0:08:16.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:08:16.85,0:08:19.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak tahu cara buka akun?
Dialogue: 0,0:08:19.54,0:08:20.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa bisa begitu?
Dialogue: 0,0:08:22.43,0:08:24.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mochiko berkata begitu,
Dialogue: 0,0:08:24.35,0:08:27.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi rasanya untuk mencapai 100 yen\Nmasih terlalu jauh.
Dialogue: 0,0:08:27.87,0:08:29.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalaupun naik,
Dialogue: 0,0:08:29.15,0:08:31.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin batasnya 96 yen.
Dialogue: 0,0:08:31.66,0:08:35.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu, tidak ada faktor\Nyang membuatnya langsung turun...
Dialogue: 0,0:08:35.95,0:08:37.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, coba beli saja?
Dialogue: 0,0:08:37.96,0:08:41.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan kata lain,\Nseharusnya bisa mencapai 96 yen.
Dialogue: 0,0:08:41.87,0:08:43.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau beli 50 lot,
Dialogue: 0,0:08:43.14,0:08:45.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}potensi untungnya 200 ribu yen.
Dialogue: 0,0:08:46.08,0:08:47.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang berisiko tinggi,
Dialogue: 0,0:08:47.18,0:08:48.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kalau mau mencapai target,
Dialogue: 0,0:08:48.90,0:08:50.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku harus berani bertaruh!
Dialogue: 0,0:08:51.20,0:08:52.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Momennya juga tidak buruk.
Dialogue: 0,0:08:53.35,0:08:55.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, eksekusi posisi beli 50 lot!
Dialogue: 0,0:09:00.99,0:09:04.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau naik ke 100 yen,\Nuntungnya 2,5 juta yen, tapi...
Dialogue: 0,0:09:05.52,0:09:08.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin, kan? Mana mungkin, ah?
Dialogue: 0,0:09:08.03,0:09:09.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Canda, deh.
Dialogue: 0,0:09:09.34,0:09:09.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:09:10.32,0:09:12.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serius kamu beli?
Dialogue: 0,0:09:14.43,0:09:16.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh! Menurutku bagus, kok!
Dialogue: 0,0:09:16.24,0:09:17.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya bakal naik!
Dialogue: 0,0:09:19.36,0:09:21.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mochiko, sampai jumpa.
Dialogue: 0,0:09:25.78,0:09:26.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jujur saja,
Dialogue: 0,0:09:27.36,0:09:29.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku sendiri pilih memantau dulu.
Dialogue: 0,0:09:30.13,0:09:32.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama sekali bukan kondisi\Nuntuk terburu-buru transaksi.
Dialogue: 0,0:09:33.47,0:09:36.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak paham kenapa dia\Nbeli banyak di situasi begini.
Dialogue: 0,0:09:37.17,0:09:39.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, yang tadi menghasut juga aku, sih.
Dialogue: 0,0:09:41.35,0:09:43.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:09:44.10,0:09:45.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ke ruang pendingin dulu!
Dialogue: 0,0:09:45.82,0:09:47.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, tolong, ya.
Dialogue: 0,0:09:52.74,0:09:54.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aaaaah!
Dialogue: 0,0:09:54.38,0:09:56.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin mengecek pasar!
Dialogue: 0,0:09:59.68,0:10:01.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau di sini enggak ada orang...
Dialogue: 0,0:10:02.29,0:10:03.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebentar saja...
Dialogue: 0,0:10:11.44,0:10:12.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai naik...!
Dialogue: 0,0:10:12.67,0:10:14.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kututup posisi dan ambil untung,
Dialogue: 0,0:10:14.34,0:10:15.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebentar lagi genap 1 juta yen!
Dialogue: 0,0:10:16.37,0:10:19.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Angka 7 digit sudah di depan mata!
Dialogue: 0,0:10:21.52,0:10:23.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wih, serem...
Dialogue: 0,0:10:23.39,0:10:25.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, cepat amat...
Dialogue: 0,0:10:25.27,0:10:27.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang kalau ada\Npelanggan aneh mengganggu,
Dialogue: 0,0:10:27.70,0:10:30.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku bisa menepisnya\Ndengan kekuatan jutawan!
Dialogue: 0,0:10:34.69,0:10:37.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}50 lot = 500.000 unit mata uang.
Dialogue: 0,0:10:38.37,0:10:42.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah jumlah posisi beli AUD/JPY\Nyang dipegang Kurumi.
Dialogue: 0,0:10:42.77,0:10:45.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika dihitung dari harga beli,...
Dialogue: 0,0:10:48.02,0:10:50.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}...nilainya sekitar 47,8 juta yen.
Dialogue: 0,0:10:51.57,0:10:55.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekitar 59 kali lipat modal saat ini\Nyang sebesar 810 ribu yen.
Dialogue: 0,0:10:56.90,0:10:59.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengapa transaksi ini bisa terjadi?
Dialogue: 0,0:10:59.79,0:11:00.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jawabannya...
Dialogue: 0,0:11:02.51,0:11:03.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah Leverage.
Dialogue: 0,0:11:06.42,0:11:07.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam Forex,
Dialogue: 0,0:11:08.98,0:11:13.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jumlah dana melebihi modal\Nyang dimiliki bisa dikelola
Dialogue: 0,0:11:14.19,0:11:17.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sehingga mungkin untuk meraih untung\Nyang sangat besar.
Dialogue: 0,0:11:18.91,0:11:20.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di pialang Forex Jepang,
Dialogue: 0,0:11:21.08,0:11:25.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}leverage maksimal dibatasi\Ndemi melindungi investor,
Dialogue: 0,0:11:25.71,0:11:29.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi pialang luar negeri\Ntempat Kurumi bertransaksi
Dialogue: 0,0:11:29.49,0:11:32.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa mengelola dana kelipatan\Nyang sangat tinggi.
Dialogue: 0,0:11:34.92,0:11:36.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi, aku pulang duluan!
Dialogue: 0,0:11:36.93,0:11:38.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:11:40.67,0:11:41.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan tetapi,
Dialogue: 0,0:11:41.85,0:11:43.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}angka 59 kali lipat itu
Dialogue: 0,0:11:43.92,0:11:47.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}secara umum termasuk leverage\Nyang sangat tinggi.
Dialogue: 0,0:11:48.19,0:11:49.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus terang saja,
Dialogue: 0,0:11:50.53,0:11:53.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hakikat dari apa yang dia lakukan...
Dialogue: 0,0:11:56.24,0:11:58.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hanyalah perjudian semata.
Dialogue: 0,0:12:12.66,0:12:15.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sementara cuanku sudah 100 ribu yen,
Dialogue: 0,0:12:16.29,0:12:19.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku sih inginnya\Nlebih dari 200 ribu yen...
Dialogue: 0,0:12:23.89,0:12:25.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}L-Lo...?
Dialogue: 0,0:12:31.01,0:12:32.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuanku ludes ke mana?!
Dialogue: 0,0:12:38.50,0:12:39.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Posisiku...
Dialogue: 0,0:12:44.00,0:12:45.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}turun...?!
Dialogue: 0,0:12:46.38,0:12:49.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? 95,4 yen?!
Dialogue: 0,0:12:50.13,0:12:52.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal baru kutinggal sebentar...
Dialogue: 0,0:12:55.81,0:12:57.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}B-Bahaya...
Dialogue: 0,0:12:58.10,0:12:58.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini...
Dialogue: 0,0:13:05.62,0:13:06.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku gagal.
Dialogue: 0,0:13:07.52,0:13:09.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kelewat serakah!
Dialogue: 0,0:13:13.90,0:13:15.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku terlalu terbuai.
Dialogue: 0,0:13:25.37,0:13:27.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sialan.
Dialogue: 0,0:13:27.76,0:13:28.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat itu...
Dialogue: 0,0:13:29.06,0:13:31.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat itulah titik puncaknya!
Dialogue: 0,0:13:32.98,0:13:35.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang kubeli sebanyak 50 lot.
Dialogue: 0,0:13:38.19,0:13:40.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setiap turun 0,1 yen,
Dialogue: 0,0:13:41.18,0:13:43.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}rugi membengkak 50 ribu yen.
Dialogue: 0,0:13:46.64,0:13:47.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berat sekali...
Dialogue: 0,0:13:49.14,0:13:51.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penurunan ini... sungguhan, ya?
Dialogue: 0,0:13:53.18,0:13:55.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa trennya sudah berubah...?
Dialogue: 0,0:13:56.61,0:13:59.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, sesuai teori dasar,
Dialogue: 0,0:14:01.74,0:14:05.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa baiknya aku cut loss, ya?
Dialogue: 0,0:14:06.45,0:14:10.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cut loss adalah menutup posisi\Nyang dipegang
Dialogue: 0,0:14:10.18,0:14:12.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk menetapkan kerugian.
Dialogue: 0,0:14:13.30,0:14:15.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manfaat terbesar cut loss adalah
Dialogue: 0,0:14:15.25,0:14:18.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mencegah bertambah besarnya kerugian.
Dialogue: 0,0:14:19.84,0:14:23.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tindakan ini tidak hanya berlaku\Ndi dunia pasar.
Dialogue: 0,0:14:23.79,0:14:24.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misalnya,
Dialogue: 0,0:14:25.02,0:14:27.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ketika penerbit menghentikan\Nkarya yang tidak populer
Dialogue: 0,0:14:28.26,0:14:30.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di majalah manga.
Dialogue: 0,0:14:30.85,0:14:33.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini juga termasuk jenis cut loss.
Dialogue: 0,0:14:33.86,0:14:37.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cut loss sangat penting\Nuntuk bertahan di pasar.
Dialogue: 0,0:14:37.73,0:14:39.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keputusannya harus cepat...
Dialogue: 0,0:14:40.62,0:14:42.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harus diputuskan dengan cepat...
Dialogue: 0,0:14:43.36,0:14:44.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya...
Dialogue: 0,0:14:53.20,0:14:56.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}...serta dilakukan dengan tenang.
Dialogue: 0,0:14:57.76,0:14:58.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan tenang...
Dialogue: 0,0:14:59.34,0:15:00.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan tenang...
Dialogue: 0,0:15:02.21,0:15:02.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun...
Dialogue: 0,0:15:04.27,0:15:05.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bisa melakukannya,
Dialogue: 0,0:15:06.05,0:15:08.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}betapa mudahnya transaksi di pasar?
Dialogue: 0,0:15:09.12,0:15:11.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu! Batal cut loss, deh...!
Dialogue: 0,0:15:12.67,0:15:13.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya...
Dialogue: 0,0:15:14.05,0:15:15.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}posisiku...
Dialogue: 0,0:15:15.98,0:15:17.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}AUD/JPY ini...
Dialogue: 0,0:15:18.61,0:15:20.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bakal menarik dari sekarang!
Dialogue: 0,0:15:20.94,0:15:22.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perasaanku berkata begitu!
Dialogue: 0,0:15:23.07,0:15:24.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang sekarang sedang turun,
