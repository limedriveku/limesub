Dialogue: 0,0:07:56.33,0:07:57.45,sign,,0000,0000,0000,,ASTROLOGI CINTA\NRAMALAN TAROT YANG MUDAH DIMENGERTI
Dialogue: 0,0:07:57.45,0:07:58.75,sign,,0000,0000,0000,,PANDUAN BERGAMBAR ASTROLOGI TENSEI\NTAKDIR TERAMAL SECARA AKURAT!\NPAHAMI BINTANG ANDA!
Dialogue: 0,0:07:58.75,0:08:00.25,sign,,0000,0000,0000,,PANDUAN BERGAMBAR ASTROLOGI TENSEI
Dialogue: 0,0:08:02.21,0:08:03.50,sign,,0000,0000,0000,,CUKUP BAWA 1 RANSEL, PERSIAPAN BERES!\NSOLO CAMPING UNTUK PEMULA
Dialogue: 0,0:08:05.51,0:08:06.51,sign,,0000,0000,0000,,MEMULAI JADI GADIS BONSAI\NMEMPERKENALKAN 50 JENIS POHON POPULER
