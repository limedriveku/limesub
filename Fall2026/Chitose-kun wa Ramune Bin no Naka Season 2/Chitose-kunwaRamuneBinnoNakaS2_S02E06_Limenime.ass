Dialogue: 0,0:01:13.74,0:01:22.64,sign,,0000,0000,0000,,CHITOSE IS IN THE RAMUNE BOTTLE
Dialogue: 0,0:01:40.72,0:01:41.17,sign,,0000,0000,0000,,FUJI
Dialogue: 0,0:11:20.05,0:11:22.53,sign,,0000,0000,0000,,TAKOHACHI: BUKA
Dialogue: 0,0:11:22.53,0:11:23.04,sign,,0000,0000,0000,,YAKISOBA JUMBO ANAK SEKOLAH
Dialogue: 0,0:16:02.90,0:16:05.40,sign,,0000,0000,0000,,FUJI
Dialogue: 0,0:16:47.50,0:16:48.71,sign,,0000,0000,0000,,SMA E.
Dialogue: 0,0:19:27.16,0:19:30.66,sign,,0000,0000,0000,,KUIL KEYA KUROTATSU
Dialogue: 0,0:23:35.70,0:23:36.78,sign,,0000,0000,0000,,EPISODE SELANJUTNYA:\NORIHIME CEMBERUT DAN HIKOBOSHI CENGENG
Dialogue: 0,0:01:33.26,0:01:37.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak apa-apa membiarkan mereka bermain?\NHasilnya sudah jelas.
Dialogue: 0,0:01:37.26,0:01:40.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya kau meremehkan andalan kami.
Dialogue: 0,0:01:41.18,0:01:43.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}SMA Fuji adalah tim kuat.
Dialogue: 0,0:01:43.35,0:01:47.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kombinasinya dengan point guard kalian\Nadalah ancaman bagi kami.
Dialogue: 0,0:01:47.31,0:01:50.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berlatih melawan SMA Fuji\Nsaat Nana ada di sana masuk akal.
Dialogue: 0,0:01:51.02,0:01:54.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, kalau hanya Umi, apa ada gunanya?
Dialogue: 0,0:01:56.36,0:02:00.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudku mereka hanya ancaman saat bersama.
Dialogue: 0,0:02:00.66,0:02:03.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkinkah kau melihat\Ndirimu yang dulu dalam dirinya?
Dialogue: 0,0:02:07.08,0:02:08.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja tidak.
Dialogue: 0,0:02:08.66,0:02:13.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rintangan yang dia hadapi berada\Ndalam skala yang sangat berbeda.
Dialogue: 0,0:02:14.13,0:02:15.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kuperjelas satu hal.
Dialogue: 0,0:02:15.88,0:02:18.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Andalan kami tidak semudah itu terpengaruh.
Dialogue: 0,0:02:21.18,0:02:24.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}SMA Ashi memang hebat.
Dialogue: 0,0:02:32.77,0:02:34.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,
Dialogue: 0,0:02:34.73,0:02:35.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mari mulai.
Dialogue: 0,0:02:36.86,0:02:38.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa peraturannya?
Dialogue: 0,0:02:38.36,0:02:40.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setiap tembakan masuk dihitung satu poin.
Dialogue: 0,0:02:40.32,0:02:41.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang pertama mencetak sepuluh poin menang.
Dialogue: 0,0:02:41.74,0:02:43.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika bolanya dicuri, kepemilikan berubah.
Dialogue: 0,0:02:44.20,0:02:45.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau lebih dulu.
Dialogue: 0,0:02:47.08,0:02:49.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau baik sekali.
Dialogue: 0,0:02:50.25,0:02:51.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudmu?
Dialogue: 0,0:02:53.25,0:02:56.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Umi adalah tipe orang\Nyang bermain di dekat keranjang.
Dialogue: 0,0:02:56.76,0:02:59.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sementara itu, Toudo bisa\Nmencetak tiga angka dari perimeter.
Dialogue: 0,0:03:00.34,0:03:02.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, karena setiap tembakan\Nhanya bernilai satu poin,
Dialogue: 0,0:03:03.01,0:03:06.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Toudo mungkin sengaja memberinya keringanan\Nuntuk menutupi perbedaan tinggi mereka.
Dialogue: 0,0:03:06.22,0:03:08.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bahkan merelakan bola pertama.
Dialogue: 0,0:03:08.85,0:03:10.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita diremehkan.
Dialogue: 0,0:03:12.60,0:03:14.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tampak tidak puas.
Dialogue: 0,0:03:14.73,0:03:15.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:03:15.86,0:03:18.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya bersyukur kau bersedia melawanku.
Dialogue: 0,0:03:19.61,0:03:23.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai gantinya, jika aku menang,\Nkita akan bermain lagi dengan adil.
Dialogue: 0,0:03:24.45,0:03:26.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku suka sikap itu.
Dialogue: 0,0:03:35.79,0:03:38.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau sedikit bersemangat sekarang?
Dialogue: 0,0:03:38.09,0:03:41.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita hampir tak pernah sempat\Nbermain melawan satu sama lain.
Dialogue: 0,0:03:41.59,0:03:44.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tiga kali lebih cepat daripada dugaanku.
Dialogue: 0,0:03:44.72,0:03:48.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dribel Umi sangat cepat,\Nbaik untuk drive maupun crossover.
Dialogue: 0,0:03:48.89,0:03:51.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak akan mudah mencuri bolanya.
Dialogue: 0,0:03:53.69,0:03:55.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, sekali lagi.
Dialogue: 0,0:03:55.69,0:03:57.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan melewatimu!
Dialogue: 0,0:04:09.08,0:04:11.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau Aomi, bukan?
Dialogue: 0,0:04:11.62,0:04:13.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bisa memanggilku Haru.
Dialogue: 0,0:04:13.33,0:04:14.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau cukup hebat, Haru.
Dialogue: 0,0:04:14.79,0:04:16.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bisa memanggilku Mai.
Dialogue: 0,0:04:16.70,0:04:19.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, Mai. Ayo habis-habisan.
Dialogue: 0,0:04:19.63,0:04:22.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, aku sudah mengakuimu.\NJadi, kita sudahi saja.
Dialogue: 0,0:04:22.92,0:04:25.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudmu?
Dialogue: 0,0:04:40.03,0:04:41.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mencoba sok hebat, ya?
Dialogue: 0,0:04:41.57,0:04:45.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gerakan itu tak akan mempan\Nkalau lompatanmu cuma segitu.
Dialogue: 0,0:04:45.41,0:04:46.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial.
Dialogue: 0,0:04:46.82,0:04:48.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga akhirnya akan begini.
Dialogue: 0,0:04:48.53,0:04:50.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, ada perbedaan tinggi.
Dialogue: 0,0:04:50.99,0:04:53.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misalnya, saat Toudo melakukan yang terbaik,
Dialogue: 0,0:04:53.79,0:04:56.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}meski aku melompat setinggi mungkin,
Dialogue: 0,0:04:56.96,0:04:59.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tak yakin bisa menangkisnya.
Dialogue: 0,0:04:59.50,0:05:01.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, melawan Haru,
Dialogue: 0,0:05:01.21,0:05:03.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia bisa mengadangnya dengan lompatan kecil.
Dialogue: 0,0:05:03.88,0:05:06.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, dia masih bisa berhasil\Nmeski terlambat satu ketukan?
Dialogue: 0,0:05:07.05,0:05:10.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hang time Umi bagus,
Dialogue: 0,0:05:10.22,0:05:11.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi Toudo juga.
Dialogue: 0,0:05:11.85,0:05:14.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika dia tak bisa unggul di udara,
Dialogue: 0,0:05:14.14,0:05:16.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pemain yang lebih tinggi menang.
Dialogue: 0,0:05:18.19,0:05:21.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan mengasihaninya, Chitose.
Dialogue: 0,0:05:22.57,0:05:25.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mencoba memberi contoh.
Dialogue: 0,0:05:28.99,0:05:31.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga ini akan terjadi.
Dialogue: 0,0:05:32.95,0:05:34.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayang sekali.
Dialogue: 0,0:05:41.55,0:05:45.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau 20 cm lebih tinggi,\Nhasilnya mungkin berbeda.
Dialogue: 0,0:05:45.13,0:05:49.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, dalam basket,\N20 cm itulah yang membuat perbedaan.
Dialogue: 0,0:05:51.01,0:05:54.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau bermain melawan Haru\Nyang tingginya 170 cm.
Dialogue: 0,0:05:55.56,0:05:58.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisakah kau berhenti bicara\Nseolah ini sudah berakhir?
Dialogue: 0,0:05:58.85,0:06:00.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau masih mau melanjutkannya?
Dialogue: 0,0:06:00.39,0:06:02.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu. Aku akan mengalahkanmu.
Dialogue: 0,0:06:05.40,0:06:07.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Toudo Mai terlalu kuat.
Dialogue: 0,0:06:07.57,0:06:10.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak menduga Umi akan kalah separah itu.
Dialogue: 0,0:06:10.49,0:06:12.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada perbedaan 20 cm.
Dialogue: 0,0:06:12.33,0:06:14.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tinggi badan adalah bakat tersendiri.
Dialogue: 0,0:06:14.58,0:06:16.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, ini agak mengecewakan.
Dialogue: 0,0:06:16.33,0:06:19.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Umi selalu bersikap angkuh, memerintah kita.
Dialogue: 0,0:06:19.29,0:06:22.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika Nana menjadi kapten kita...
Dialogue: 0,0:06:23.59,0:06:25.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, fokus!
Dialogue: 0,0:06:28.97,0:06:31.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai kapan kau akan tetap seperti itu?
Dialogue: 0,0:06:32.39,0:06:35.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat bawa si bodoh itu kembali.
Dialogue: 0,0:06:49.86,0:06:51.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Udang.
Dialogue: 0,0:06:53.37,0:06:57.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau agak terlambat menghibur, Saku.
Dialogue: 0,0:06:57.62,0:07:00.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Haruskah aku mencium dahimu saja?
Dialogue: 0,0:07:00.21,0:07:03.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak memintamu mempermalukanku.
Dialogue: 0,0:07:06.71,0:07:09.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sainganmu tampak tangguh.
Dialogue: 0,0:07:10.76,0:07:12.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saingan, ya?
Dialogue: 0,0:07:13.05,0:07:15.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bahkan tak bisa membuatnya\Nmengingat namaku.
Dialogue: 0,0:07:15.85,0:07:16.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sakit sekali...
Dialogue: 0,0:07:17.06,0:07:18.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh!
Dialogue: 0,0:07:18.35,0:07:19.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau bodoh?
Dialogue: 0,0:07:19.35,0:07:22.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga tidak ingat\Nnama atau wajah lawanku.
Dialogue: 0,0:07:24.31,0:07:26.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu,\Ngaya bermain mereka terukir di benakku.
Dialogue: 0,0:07:27.82,0:07:29.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah Toudo Mai mengatakannya sendiri?
Dialogue: 0,0:07:30.40,0:07:33.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tiga kali lebih cepat daripada dugaanku.
Dialogue: 0,0:07:34.03,0:07:35.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bilang "dugaan".
Dialogue: 0,0:07:36.08,0:07:39.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang tak akan bilang begitu\Ntentang lawan yang tidak dia ingat.
Dialogue: 0,0:07:41.87,0:07:43.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:07:51.72,0:07:54.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingat Yuuko pernah bilang\Ndia tidak peduli soal menang atau kalah.
Dialogue: 0,0:07:55.05,0:07:58.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia hanya menikmati kegiatan klubnya\Ndengan santai dan tanpa beban.
Dialogue: 0,0:07:58.43,0:08:03.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak meremehkan pendekatan itu\Ndalam olahraga.
Dialogue: 0,0:08:05.48,0:08:08.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melempar bola lebih jauh daripada kemarin.
Dialogue: 0,0:08:09.03,0:08:11.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mencetak hit pertama.
Dialogue: 0,0:08:11.19,0:08:13.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menangkap bola terbang dengan baik.
Dialogue: 0,0:08:14.45,0:08:18.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu saja sudah cukup untuk merasa puas.
Dialogue: 0,0:08:20.45,0:08:23.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saku! Haru!
Dialogue: 0,0:08:28.59,0:08:32.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan menyenangkan jika kita bisa\Nmenikmati olahraga seperti itu.
Dialogue: 0,0:08:33.01,0:08:35.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu mustahil bagi kita.
Dialogue: 0,0:08:36.39,0:08:38.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena bahkan jiwa kita terjebak.
Dialogue: 0,0:08:40.30,0:08:44.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak kecil, kami mendorong tubuh kami\Nke batasnya setiap hari,
Dialogue: 0,0:08:44.64,0:08:46.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}melalui kemunduran demi kemunduran
Dialogue: 0,0:08:46.86,0:08:49.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan menghabiskan banyak malam\Ntanpa tidur karena frustrasi.
Dialogue: 0,0:08:50.48,0:08:52.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu,\Nkami masih mau menjadi lebih kuat.
Dialogue: 0,0:08:52.90,0:08:54.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami mau menjadi nomor satu.
Dialogue: 0,0:08:55.16,0:09:00.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, meski sudah menyerah,\Njiwaku masih belum terlepas.
Dialogue: 0,0:09:00.29,0:09:03.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih terperangkap di sana.\NHanya itu cara menggambarkannya.
Dialogue: 0,0:09:04.96,0:09:07.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa pendapatmu tentang perkataan Mai?
Dialogue: 0,0:09:07.83,0:09:11.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentang 20 cm?\NItu fakta yang tidak terbantahkan.
Dialogue: 0,0:09:12.01,0:09:15.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar sekali. Aku juga berpikir begitu.
Dialogue: 0,0:09:15.84,0:09:21.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, orang tinggi\Nmungkin juga punya kesulitan sendiri.
Dialogue: 0,0:09:21.77,0:09:26.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berlari dan melompat di ketinggian itu\Nberarti kau bisa terluka kapan saja.
Dialogue: 0,0:09:26.56,0:09:28.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia berada di puncak permainannya\Ndalam basket,
Dialogue: 0,0:09:28.44,0:09:29.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi sebagai seorang gadis,
Dialogue: 0,0:09:30.06,0:09:33.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin ada hal buruk\Nyang dikatakan kepadanya.
Dialogue: 0,0:09:34.03,0:09:39.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak mau cuma melihat\Napa yang dimiliki orang lain lalu iri.
Dialogue: 0,0:09:42.45,0:09:45.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh aku bertanya?
Dialogue: 0,0:09:46.62,0:09:49.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pikir kerja keras selalu terbayar?
Dialogue: 0,0:09:49.38,0:09:52.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pikir jika aku terus berlari\Ndengan segenap kemampuanku,
Dialogue: 0,0:09:52.67,0:09:56.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}suatu hari, aku bisa mengalahkan Mai\Natau orang yang lebih baik darinya?
Dialogue: 0,0:09:57.13,0:10:03.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hal yang Haru genggam sekarang\Npasti semacam keinginan murni dan abstrak.
Dialogue: 0,0:10:03.89,0:10:06.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Cara hidupku benar, bukan?"
Dialogue: 0,0:10:06.68,0:10:09.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku merasa itu yang dia tanyakan kepadaku.
Dialogue: 0,0:10:10.52,0:10:12.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak tahu jawabannya.
Dialogue: 0,0:10:12.48,0:10:13.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun,
Dialogue: 0,0:10:13.90,0:10:17.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}seperti tak ada yang bisa membuktikan\Nkerja keras akan selalu terbayar,
Dialogue: 0,0:10:17.99,0:10:22.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tak ada bukti juga itu tak akan terbayar.
Dialogue: 0,0:10:23.24,0:10:25.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika aku melempar 100 lemparan lagi sehari,
Dialogue: 0,0:10:25.83,0:10:28.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akankah aku menjadi lebih kuat?
Dialogue: 0,0:10:28.21,0:10:30.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku akan menjadi yang terbaik?
Dialogue: 0,0:10:30.83,0:10:34.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana jika 200? Atau 300?
Dialogue: 0,0:10:35.26,0:10:38.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya kau yang bisa menyaksikan\Nbagaimana akhirnya.
Dialogue: 0,0:10:38.51,0:10:42.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau mau tahu jawabannya,\Ncari tahu sendiri.
Dialogue: 0,0:10:44.35,0:10:46.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang sudah bertanya.
Dialogue: 0,0:10:46.64,0:10:48.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah yang mau kudengar!
Dialogue: 0,0:10:48.52,0:10:49.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mencintaimu.
Dialogue: 0,0:10:53.57,0:10:56.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga akan berjuang,\Njadi, kau juga jangan kabur!
Dialogue: 0,0:11:23.05,0:11:25.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu! Pesan empat porsi yakisoba saus jumbo.
Dialogue: 0,0:11:25.89,0:11:27.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian lagi?
Dialogue: 0,0:11:27.22,0:11:29.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian akan membuatku bangkrut.
Dialogue: 0,0:11:30.14,0:11:32.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah kalian berlima?\NBagaimana dengan gadis itu?
Dialogue: 0,0:11:32.60,0:11:34.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pesan yang jumbo!
Dialogue: 0,0:11:34.48,0:11:36.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, pasti\Nsi kurus berkacamata di sebelahmu.
Dialogue: 0,0:11:36.69,0:11:39.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pesan yakisoba saus biasa saja.
Dialogue: 0,0:11:39.78,0:11:41.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Jangan lemah!
Dialogue: 0,0:11:41.45,0:11:43.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pesan yang jumbo! Jumbo!
Dialogue: 0,0:11:43.28,0:11:44.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kau mau dari kami?
Dialogue: 0,0:11:47.66,0:11:51.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa mengerti Ucchi dan Yuzuki,\Nkarena mereka menjaga kalori mereka.
Dialogue: 0,0:11:51.87,0:11:53.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, bukankah kau mengundang Yuuko?
Dialogue: 0,0:11:56.13,0:11:58.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bilang rumput laut tersangkut\Ndi giginya, jadi, dia menolak.
Dialogue: 0,0:11:59.92,0:12:01.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa ekspresimu begitu?
Dialogue: 0,0:12:03.84,0:12:06.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, Kenta,\Napa ada seseorang yang kau sukai?
Dialogue: 0,0:12:08.22,0:12:10.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa tiba-tiba, Asano?
Dialogue: 0,0:12:10.48,0:12:13.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Musim panas\Nmemang musimnya percintaan. Asmara!
Dialogue: 0,0:12:13.94,0:12:14.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama seperti tahun lalu.
Dialogue: 0,0:12:15.02,0:12:18.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasangan tiba-tiba makin banyak\Ndi musim panas.
Dialogue: 0,0:12:18.27,0:12:19.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu menyebalkan!
Dialogue: 0,0:12:19.90,0:12:24.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, banyak orang putus\Nsetelah musim panas berakhir.
Dialogue: 0,0:12:24.11,0:12:25.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bagian terbaiknya.
Dialogue: 0,0:12:26.28,0:12:28.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, bagaimana, Kenta?
Dialogue: 0,0:12:29.41,0:12:32.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah apa aku harus menanyakan ini.
Dialogue: 0,0:12:32.33,0:12:35.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, secara hipotesis,\Nhanya secara hipotesis,
Dialogue: 0,0:12:35.42,0:12:38.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jika orang yang kau sukai menyukai temanmu
Dialogue: 0,0:12:38.92,0:12:42.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau jika kau dan temanmu\Nmenyukai orang yang sama,
Dialogue: 0,0:12:42.67,0:12:44.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa yang akan kalian lakukan?
Dialogue: 0,0:12:55.60,0:12:57.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan, Kenta?
Dialogue: 0,0:12:57.23,0:13:00.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Apa kau saingan kami dalam cinta?\N- Bukan!
Dialogue: 0,0:13:00.36,0:13:02.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu Ucchi? Atau Yuzuki?
Dialogue: 0,0:13:02.28,0:13:05.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, mustahil Haru, 'kan?
Dialogue: 0,0:13:05.66,0:13:08.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudmu "mustahil"?
Dialogue: 0,0:13:10.03,0:13:13.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yamazaki, itukah\Nyang kau pikirkan tentang aku?
Dialogue: 0,0:13:13.75,0:13:16.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, bukan begitu!
Dialogue: 0,0:13:16.75,0:13:18.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan khawatir, Aomi.
Dialogue: 0,0:13:18.84,0:13:20.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Yamazaki.
Dialogue: 0,0:13:20.21,0:13:22.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Reaksi spontanmu itu cukup menyakitkan.
Dialogue: 0,0:13:23.67,0:13:26.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang Kaito yang pertama bicara.
Dialogue: 0,0:13:26.76,0:13:30.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, aku tak mau membiarkan dia\Nmemikul peran itu sendirian.
Dialogue: 0,0:13:31.56,0:13:34.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin nama yang tanpa sadar dihilangkan
Dialogue: 0,0:13:34.56,0:13:38.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}seperti jungkat-jungkit kesepian\Nyang bermandikan senja,
Dialogue: 0,0:13:38.15,0:13:40.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berdiri di sana dengan tenang\Ntanpa tempat tujuan.
Dialogue: 0,0:13:42.28,0:13:44.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku orang yang sederhana.
Dialogue: 0,0:13:44.36,0:13:46.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu, aku mau orang yang kusukai\Nmelihat ke arahku.
Dialogue: 0,0:13:46.53,0:13:49.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan ideal jika kami bisa berkencan.
Dialogue: 0,0:13:49.41,0:13:52.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, jika orang yang bisa\Nmembuatnya paling bahagia
Dialogue: 0,0:13:52.66,0:13:54.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah temanku yang paling berharga,
Dialogue: 0,0:13:54.70,0:13:57.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}maka aku tak mau memaksa masuk.
Dialogue: 0,0:13:58.96,0:14:04.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena yang kusuka adalah\Ncara mereka tersenyum saat bersama.
Dialogue: 0,0:14:04.46,0:14:05.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sebabnya,
Dialogue: 0,0:14:05.47,0:14:08.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku hanya mau mengubah hubungan kami
Dialogue: 0,0:14:08.38,0:14:13.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jika aku merasa bisa membuatnya\Nlebih sering tersenyum.
Dialogue: 0,0:14:13.10,0:14:16.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat waktunya tiba,\Naku akan merebutnya, meski harus berkelahi.
Dialogue: 0,0:14:16.93,0:14:19.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak mengerti semua itu.
Dialogue: 0,0:14:20.35,0:14:23.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau menjadi orang\Nyang membuat orang yang kusukai tersenyum.
Dialogue: 0,0:14:23.32,0:14:25.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau melindunginya agar tidak terluka.
Dialogue: 0,0:14:25.65,0:14:28.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau berada di sisinya saat dia menangis.
Dialogue: 0,0:14:28.28,0:14:31.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak mau orang lain melakukan hal itu.
Dialogue: 0,0:14:31.28,0:14:32.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah yang kurasakan.
Dialogue: 0,0:14:33.08,0:14:34.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau kuat sekali.
Dialogue: 0,0:14:34.87,0:14:38.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, musim panas selalu terasa\Nseperti akan ada sesuatu. Ini menyenangkan.
Dialogue: 0,0:14:38.79,0:14:41.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa aku mengerti.
Dialogue: 0,0:14:41.17,0:14:43.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tahu ungkapan "musim panas itu"?
Dialogue: 0,0:14:44.09,0:14:48.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya musim panas yang memiliki\Nawal dan akhir yang jelas.
Dialogue: 0,0:14:48.13,0:14:50.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, setelah musim panas berlalu,
Dialogue: 0,0:14:50.34,0:14:53.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita merasa harus berubah juga.
Dialogue: 0,0:14:55.93,0:14:59.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,\Napa yang akan berubah hari ini?
Dialogue: 0,0:15:02.52,0:15:03.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang!
Dialogue: 0,0:15:07.11,0:15:09.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata Chitose.
Dialogue: 0,0:15:09.78,0:15:10.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo.
Dialogue: 0,0:15:10.78,0:15:13.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pasti berpikir\Nmereka pantas mendapatkannya.
Dialogue: 0,0:15:13.66,0:15:15.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya?
Dialogue: 0,0:15:17.25,0:15:19.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau belum dengar, lupakan saja.
Dialogue: 0,0:15:23.29,0:15:24.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saku-go,
Dialogue: 0,0:15:25.17,0:15:28.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pria itu murung selama ini,
Dialogue: 0,0:15:28.42,0:15:31.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bilang dia sudah menyia-nyiakan bakat hebat.
Dialogue: 0,0:15:31.47,0:15:34.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak merasa dia yang merusaknya.
Dialogue: 0,0:15:34.18,0:15:37.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa pun alasannya,\Naku yang memutuskan untuk berhenti.
Dialogue: 0,0:15:37.77,0:15:41.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang dewasa tak bisa selalu benar.
Dialogue: 0,0:15:41.94,0:15:44.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya itu yang mau kukatakan.
Dialogue: 0,0:15:46.52,0:15:49.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini, bahkan kata-kata seperti itu
Dialogue: 0,0:15:49.82,0:15:52.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak bisa mengeluarkanku\Ndari musim panas itu.
Dialogue: 0,0:15:57.41,0:15:58.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chitose,
Dialogue: 0,0:15:59.66,0:16:00.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ada yang memanggilmu.
Dialogue: 0,0:16:08.59,0:16:11.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yusuke cedera?\NDia butuh dua pekan untuk pulih?
Dialogue: 0,0:16:12.13,0:16:15.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pergelangan kakinya terkilir\Nsaat meluncur ke home plate.
Dialogue: 0,0:16:15.85,0:16:18.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertandingan pertama musim panas\Npekan depan.
Dialogue: 0,0:16:18.56,0:16:19.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tak akan siap tepat waktu.
Dialogue: 0,0:16:20.06,0:16:22.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Latih tanding tepat sebelum turnamen.
Dialogue: 0,0:16:22.52,0:16:24.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tak perlu memaksakan diri.
Dialogue: 0,0:16:25.06,0:16:27.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, setidaknya dalam bisbol,
Dialogue: 0,0:16:27.69,0:16:30.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia selalu tulus dan bersemangat.
Dialogue: 0,0:16:30.28,0:16:33.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika aku pelarinya,\Naku juga akan maju tanpa ragu.
Dialogue: 0,0:16:34.95,0:16:38.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagi Yusuke,\Nyang tak bisa bermain tahun lalu,
Dialogue: 0,0:16:38.33,0:16:41.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ini akhirnya kesempatannya\Nuntuk bersaing di Koshien Musim Panas.
Dialogue: 0,0:16:45.88,0:16:47.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa lawan pertamanya?
Dialogue: 0,0:16:48.79,0:16:51.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa keberuntungannya dengan undian\Njuga seburuk itu?
Dialogue: 0,0:16:51.71,0:16:53.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu?
Dialogue: 0,0:16:53.17,0:16:55.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Haruskah aku membawakannya bunga\Nsaat berkunjung?
Dialogue: 0,0:16:55.89,0:16:58.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu ini tak tahu malu,\Ntapi kumohon, Saku.
Dialogue: 0,0:17:00.93,0:17:02.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kembalilah ke tim.
Dialogue: 0,0:17:03.27,0:17:05.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tahu apa yang kau katakan?
Dialogue: 0,0:17:06.15,0:17:09.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melawan SMA E, itu pasti duel pelempar.
Dialogue: 0,0:17:09.44,0:17:11.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami butuh bantuanmu.
Dialogue: 0,0:17:11.65,0:17:15.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu, kita tak akan menang\Nhanya karena aku kembali.
Dialogue: 0,0:17:16.03,0:17:18.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan meremehkan bisbol.
Dialogue: 0,0:17:18.56,0:17:20.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kau peduli dengan bisbol\Nlebih dari siapa pun,
Dialogue: 0,0:17:20.61,0:17:22.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku meminta bantuanmu.
Dialogue: 0,0:17:22.75,0:17:25.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa Yusuke menyuruhmu mencariku?
Dialogue: 0,0:17:25.75,0:17:29.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak. Dia bilang\Naku tak boleh memberitahumu.
Dialogue: 0,0:17:30.13,0:17:31.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena dia bilang
Dialogue: 0,0:17:31.30,0:17:33.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau akan bingung\Napa harus bermain bisbol lagi
Dialogue: 0,0:17:33.80,0:17:35.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk alasan yang sangat berbeda.
Dialogue: 0,0:17:37.80,0:17:41.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan minta maaf atas kejadian saat itu\Nsebanyak yang dibutuhkan.
Dialogue: 0,0:17:41.39,0:17:44.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya mau memberi Yusuke,\Nyang setahun ini berjuang bersama kami,
Dialogue: 0,0:17:44.68,0:17:46.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kesempatan untuk turun ke lapangan\Ndan bersaing!
Dialogue: 0,0:17:54.78,0:17:58.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bicara seenaknya!
Dialogue: 0,0:17:58.28,0:18:01.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau tak melakukan itu\Nsaat Chitose berhenti?
Dialogue: 0,0:18:01.49,0:18:04.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau mendampinginya saat itu,
Dialogue: 0,0:18:04.08,0:18:08.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chitose pasti masih mengejar bola bersamamu.
Dialogue: 0,0:18:08.21,0:18:11.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau sangat membencinya\Nhingga tak mau menghentikannya,
Dialogue: 0,0:18:11.38,0:18:13.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}setidaknya aku bisa memahaminya.
Dialogue: 0,0:18:13.09,0:18:14.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,
Dialogue: 0,0:18:14.26,0:18:16.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menjauhlah dari Chitose mulai sekarang!
Dialogue: 0,0:18:17.30,0:18:19.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tahu apa soal itu?
Dialogue: 0,0:18:19.14,0:18:21.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak mau memahami
Dialogue: 0,0:18:21.39,0:18:25.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}perasaan pengecut\Ndengan mentalitas pecundang!
Dialogue: 0,0:18:25.85,0:18:27.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama turnamen musim panas tahun lalu,
Dialogue: 0,0:18:27.73,0:18:31.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau kehilangan semangat juang\Ndi tengah jalan, bukan?
Dialogue: 0,0:18:31.11,0:18:32.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bersikap seolah bisa menghadapi\Nlawan kuat dengan tim seperti ini,
Dialogue: 0,0:18:33.07,0:18:35.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kau sudah membuat alasan, berkata,
Dialogue: 0,0:18:35.69,0:18:38.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Kami sudah melakukan yang terbaik."
Dialogue: 0,0:18:38.36,0:18:43.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu-satunya yang sungguh mau menang\Nsampai akhir adalah Chitose.
Dialogue: 0,0:18:44.91,0:18:47.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melihat seseorang yang lebih hebat daripadamu\Njatuh dari kejayaan,
Dialogue: 0,0:18:48.04,0:18:51.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa itu memuaskan ego kecilmu?
Dialogue: 0,0:18:55.05,0:18:57.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, tapi aku tak akan berubah pikiran.
Dialogue: 0,0:19:00.51,0:19:02.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih atas waktumu.
Dialogue: 0,0:19:08.10,0:19:11.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chitose, tunggu aku\Nsampai latihanku selesai.
Dialogue: 0,0:19:11.94,0:19:15.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tak boleh pulang sendirian hari ini.
Dialogue: 0,0:19:19.15,0:19:21.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sakit, Bodoh.
Dialogue: 0,0:19:37.59,0:19:42.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sering datang ke sini,\Nsaat kesulitan dengan klub,
Dialogue: 0,0:19:42.26,0:19:46.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}saat aku merasa frustrasi,\Nsaat aku hampir kalah dari diriku sendiri,
Dialogue: 0,0:19:47.60,0:19:51.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan saat aku tak bisa melihat hari esok.
Dialogue: 0,0:19:52.19,0:19:54.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kau juga mengalami hari-hari itu?
Dialogue: 0,0:19:55.40,0:19:57.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bermain basket dengan tinggiku,
Dialogue: 0,0:19:57.73,0:19:59.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}situasi seperti itu selalu muncul.
Dialogue: 0,0:20:00.03,0:20:03.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sebabnya aku kemari untuk berteriak.
Dialogue: 0,0:20:03.16,0:20:05.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku melampiaskan semua perasaanku\Npada Sungai Asuwa.
Dialogue: 0,0:20:05.24,0:20:06.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berteriak sekeras mungkin.
Dialogue: 0,0:20:06.74,0:20:09.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Laut bodoh!"
Dialogue: 0,0:20:09.16,0:20:10.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti itu.
Dialogue: 0,0:20:10.29,0:20:12.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan melampiaskannya di sungai.
Dialogue: 0,0:20:12.46,0:20:13.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katakan itu pada laut.
Dialogue: 0,0:20:15.21,0:20:17.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sulit untuk mengincar puncak.
Dialogue: 0,0:20:18.05,0:20:22.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, untungnya,\Naku selalu punya banyak rekan satu tim.
Dialogue: 0,0:20:22.47,0:20:23.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan sekarang.
Dialogue: 0,0:20:23.68,0:20:25.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nana, Sen, dan Yo.
Dialogue: 0,0:20:25.97,0:20:30.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka mengeluh, tapi tetap mengikutiku.
Dialogue: 0,0:20:31.18,0:20:33.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mai benar.
Dialogue: 0,0:20:33.10,0:20:36.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bukan pemain yang sempurna.
Dialogue: 0,0:20:36.40,0:20:38.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, selama bersama mereka,
Dialogue: 0,0:20:38.32,0:20:40.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tidak akan kalah lain kali.
Dialogue: 0,0:20:44.78,0:20:46.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau ingat taruhan kita?
Dialogue: 0,0:20:46.91,0:20:49.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketika kita di ayunan\Nsaat matahari terbenam?
Dialogue: 0,0:20:49.45,0:20:51.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang kalah...
Dialogue: 0,0:20:51.20,0:20:52.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari lihat.
Dialogue: 0,0:20:52.91,0:20:57.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana jika yang kalah harus menyatakan\Nperasaannya kepada pemenang suatu hari nanti?
Dialogue: 0,0:20:57.71,0:20:58.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setuju!
Dialogue: 0,0:20:59.46,0:21:02.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai pemenang hari itu,\Naku memerintahkanmu.
Dialogue: 0,0:21:02.76,0:21:04.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katakan itu di sini, sekarang.
Dialogue: 0,0:21:05.68,0:21:09.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan dentingan,\Nkelereng kaca di dalam hatiku terlepas.
Dialogue: 0,0:21:10.26,0:21:13.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu suara yang sangat samar,
Dialogue: 0,0:21:13.31,0:21:15.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}terjebak lama di dalam botol kaca.
Dialogue: 0,0:21:16.56,0:21:17.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak apa-apa.
Dialogue: 0,0:21:18.40,0:21:20.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski kau terluka,
Dialogue: 0,0:21:21.03,0:21:23.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku pasti akan membuatmu tersenyum.
Dialogue: 0,0:21:23.57,0:21:25.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat kau mau menangis,\Naku akan berada di sisimu.
Dialogue: 0,0:21:26.03,0:21:29.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat kau marah, aku akan marah bersamamu.
Dialogue: 0,0:21:29.16,0:21:31.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat kau sedih, aku akan menghiburmu.
Dialogue: 0,0:21:31.29,0:21:34.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat kau tak bisa bangkit,\Naku akan memberimu keberanian.
Dialogue: 0,0:21:35.50,0:21:38.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, beri tahu aku.
Dialogue: 0,0:21:41.46,0:21:43.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sungguh memesona.
Dialogue: 0,0:21:44.17,0:21:47.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beban yang kupikul sendirian...
Dialogue: 0,0:21:47.34,0:21:50.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin aku bisa memercayakannya kepadanya.
Dialogue: 0,0:21:50.55,0:21:53.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kegelapan yang menghantuiku selama ini...
Dialogue: 0,0:21:53.97,0:21:57.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin dia bisa melenyapkan semuanya.
Dialogue: 0,0:21:58.19,0:22:00.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terang dan kuat seperti matahari.
Dialogue: 0,0:22:01.61,0:22:03.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika senyuman ini...
Dialogue: 0,0:23:36.79,0:23:40.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Orihime Cemberut dan Hikoboshi Cengeng."
