Dialogue: 0,0:01:48.73,0:01:57.65,sign,,0000,0000,0000,,CHITOSE IS IN THE RAMUNE BOTTLE
Dialogue: 0,0:03:50.68,0:03:52.23,sign,,0000,0000,0000,,PEMBINA KLUB: IIJIMA NAOHIRO\NPELATIH: WATAYA IWAO
Dialogue: 0,0:03:55.02,0:03:57.90,sign,,0000,0000,0000,,"CHITOSE SAKU"
Dialogue: 0,0:11:58.42,0:12:00.05,sign,,0000,0000,0000,,CITA-CITA:\NPEMAIN BISBOL PROFESIONAL
Dialogue: 0,0:12:53.35,0:12:55.31,sign,,0000,0000,0000,,"FINAL: YOUKOU VS. SEIKA"
Dialogue: 0,0:13:24.80,0:13:25.80,sign,,0000,0000,0000,,SMA FUJI PREFEKTUR FUKUI
Dialogue: 0,0:14:14.56,0:14:16.23,sign,,0000,0000,0000,,SMA FUJI VERSUS SMA SHIMAMIZU
Dialogue: 0,0:15:05.82,0:15:07.28,sign,,0000,0000,0000,,PANGGILAN MASUK, HIIRAGI YUUKO
Dialogue: 0,0:00:01.25,0:00:04.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitulah langkah-langkah\Nmembersihkan kolam renang.
Dialogue: 0,0:00:04.17,0:00:05.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada pertanyaan?
Dialogue: 0,0:00:09.55,0:00:12.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar kalian membersihkan kolam bersama.
Dialogue: 0,0:00:12.34,0:00:15.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan selesai secepat mungkin\Ndan pergi ke klub.
Dialogue: 0,0:00:15.47,0:00:18.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, kau bisa libur saja.
Dialogue: 0,0:00:18.14,0:00:20.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika selesai lebih awal,\Nkau bisa berkencan dengan Chitose.
Dialogue: 0,0:00:20.72,0:00:22.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa jadi bawa-bawa dia?
Dialogue: 0,0:00:22.27,0:00:23.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, bukan begitu.
Dialogue: 0,0:00:23.64,0:00:26.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana bisa seorang kapten libur\Nkarena alasan seperti itu?
Dialogue: 0,0:00:26.40,0:00:28.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru karena kau kaptennya,\Nkau harus melakukannya.
Dialogue: 0,0:00:29.19,0:00:32.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu juga cara untuk memberi contoh.
Dialogue: 0,0:02:10.71,0:02:11.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saku.
Dialogue: 0,0:02:12.88,0:02:14.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa kita bicara?
Dialogue: 0,0:02:15.71,0:02:17.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada hal penting yang mau kukatakan.
Dialogue: 0,0:02:18.97,0:02:20.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Haru. Maaf, tapi bisakah kau...
Dialogue: 0,0:02:20.47,0:02:21.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:02:21.80,0:02:24.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini soal klub bisbol lagi, 'kan?
Dialogue: 0,0:02:24.43,0:02:26.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku juga akan mendengarkan.
Dialogue: 0,0:02:26.93,0:02:30.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itulah aku mau orang luar pergi.
Dialogue: 0,0:02:30.27,0:02:32.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tak mendengarnya tempo hari?
Dialogue: 0,0:02:32.31,0:02:34.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang main lempar-tangkap\Ndengannya sekarang.
Dialogue: 0,0:02:34.94,0:02:36.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan samakan itu\Ndengan main lempar-tangkap begitu...
Dialogue: 0,0:02:37.07,0:02:38.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf soal itu.
Dialogue: 0,0:02:38.86,0:02:41.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau rekanku sudah begini,\Ndia tak akan mundur.
Dialogue: 0,0:02:44.08,0:02:45.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Rekan."
Dialogue: 0,0:02:45.29,0:02:49.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dulu aku memanggilnya begitu.
Dialogue: 0,0:02:52.96,0:02:54.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan langsung ke intinya.
Dialogue: 0,0:02:55.25,0:02:58.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari bermain bisbol bersama lagi.
Dialogue: 0,0:03:01.43,0:03:03.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengar, bukankah sudah kubilang tempo hari?
Dialogue: 0,0:03:03.89,0:03:06.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemampuanku sudah tumpul.\NAku tidak berguna lagi.
Dialogue: 0,0:03:07.52,0:03:10.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, kenapa tanganmu\Nmasih seperti tangan pemukul?
Dialogue: 0,0:03:14.48,0:03:17.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini tangan yang kapalan dan keras
Dialogue: 0,0:03:17.48,0:03:19.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena mengayunkan pemukul\Nratusan kali sehari,
Dialogue: 0,0:03:19.44,0:03:23.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}saat kulit melepuh, pecah,\Nlalu mengeras lagi.
Dialogue: 0,0:03:24.12,0:03:25.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau...
Dialogue: 0,0:03:27.24,0:03:30.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya terus mengayun karena kebiasaan.
Dialogue: 0,0:03:30.16,0:03:31.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu,
Dialogue: 0,0:03:31.71,0:03:34.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}itu artinya kau belum lupa\Nrasanya mengayunkan pemukul.
Dialogue: 0,0:03:34.21,0:03:36.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yusuke, sudahlah.
Dialogue: 0,0:03:36.67,0:03:39.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Turnamen musim panas yang penting\Nsudah di depan mata.
Dialogue: 0,0:03:39.38,0:03:40.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itulah aku di sini.
Dialogue: 0,0:03:42.84,0:03:45.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daftar pemain resmi?
Dialogue: 0,0:03:45.68,0:03:47.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat bagian akhirnya.
Dialogue: 0,0:03:48.35,0:03:50.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, ini apa?
Dialogue: 0,0:03:55.02,0:03:57.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini?
Dialogue: 0,0:03:58.11,0:03:59.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mengerti sekarang?
Dialogue: 0,0:03:59.40,0:04:02.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelatih mempertahankan namamu\Ndi daftar pemain selama ini.
Dialogue: 0,0:04:04.41,0:04:06.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pasti juga menyesali apa yang terjadi.
Dialogue: 0,0:04:07.37,0:04:08.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau bersedia,
Dialogue: 0,0:04:08.99,0:04:10.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita bisa berjuang bersama musim panas ini.
Dialogue: 0,0:04:10.95,0:04:13.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon, kembalilah!
Dialogue: 0,0:04:13.62,0:04:16.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beri kami kesempatan untuk menepati janji
Dialogue: 0,0:04:16.38,0:04:17.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang tak bisa kami tepati tahun lalu
Dialogue: 0,0:04:18.04,0:04:20.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan menebus kesalahan kami!
Dialogue: 0,0:04:23.55,0:04:26.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak ini sama sekali belum berubah.
Dialogue: 0,0:04:26.18,0:04:28.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia selalu seperti ini.
Dialogue: 0,0:04:28.39,0:04:29.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sangat bersungguh-sungguh.
Dialogue: 0,0:04:30.06,0:04:32.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sangat bersemangat.
Dialogue: 0,0:04:38.48,0:04:39.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pasti...
Dialogue: 0,0:04:40.78,0:04:43.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pasti bercanda, Berengsek!
Dialogue: 0,0:04:46.36,0:04:48.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tekun dan bersemangat,
Dialogue: 0,0:04:48.91,0:04:51.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi sungguh bajingan hina.
Dialogue: 0,0:04:51.87,0:04:54.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menepati janji?
Dialogue: 0,0:04:54.08,0:04:58.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau, yang memilih untuk tetap diam\Nbersama yang lain saat itu!
Dialogue: 0,0:04:59.59,0:05:01.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat menyesalinya.
Dialogue: 0,0:05:01.96,0:05:03.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau tulus,
Dialogue: 0,0:05:04.01,0:05:05.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kenapa baru muncul sekarang?
Dialogue: 0,0:05:06.05,0:05:08.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pikir aku akan kembali\Nsambil mengibaskan ekor
Dialogue: 0,0:05:08.60,0:05:11.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hanya karena kau memberiku\Ndaftar ini sebagai hadiah?
Dialogue: 0,0:05:11.14,0:05:12.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pikir aku akan berpura-pura\Ntidak terjadi apa-apa
Dialogue: 0,0:05:12.89,0:05:15.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan kembali berteman dengan kalian?
Dialogue: 0,0:05:17.48,0:05:18.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keputusan itu...
Dialogue: 0,0:05:20.02,0:05:23.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keputusan itu tidak dibuat semudah itu!
Dialogue: 0,0:05:23.15,0:05:24.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chitose!
Dialogue: 0,0:05:26.45,0:05:28.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan gunakan tangan dominanmu!
Dialogue: 0,0:05:29.41,0:05:31.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Lepaskan aku!\N- Tidak!
Dialogue: 0,0:05:31.45,0:05:34.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan lakukan hal menyedihkan!
Dialogue: 0,0:05:41.88,0:05:44.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia menyelamatkanku lagi.
Dialogue: 0,0:05:44.84,0:05:47.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan saat menghadapi Yanashita,
Dialogue: 0,0:05:47.72,0:05:50.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku hanya menggunakan tangan kiriku.
Dialogue: 0,0:05:52.93,0:05:56.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Haru.\NAku sudah tenang sekarang.
Dialogue: 0,0:05:57.64,0:05:58.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau yakin?
Dialogue: 0,0:05:59.65,0:06:01.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, dari tadi
Dialogue: 0,0:06:01.57,0:06:04.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ada sesuatu seperti panekuk kecil\Nyang menempel padaku.
Dialogue: 0,0:06:04.11,0:06:05.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, akan kupatahkan!
Dialogue: 0,0:06:05.82,0:06:08.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan tangan dominanku!
Dialogue: 0,0:06:10.66,0:06:13.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baik-baik saja sekarang.\NAku kembali seperti biasanya.
Dialogue: 0,0:06:14.49,0:06:16.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, aku sempat kehilangan ketenanganku.
Dialogue: 0,0:06:16.58,0:06:19.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku melakukannya demi estetikaku sendiri.
Dialogue: 0,0:06:19.42,0:06:22.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak pernah dendam kepadamu\Natau yang lain.
Dialogue: 0,0:06:22.34,0:06:24.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, lupakan rekan tim lamamu.
Dialogue: 0,0:06:25.01,0:06:28.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadilah pemain bisbol SMA\Ndan incar Koshien dengan semangat!
Dialogue: 0,0:06:29.26,0:06:30.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saku...
Dialogue: 0,0:06:30.47,0:06:32.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Urusan ini selesai sampai di sini.
Dialogue: 0,0:06:32.47,0:06:38.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak akan pernah mengayunkan pemukul\Nuntuk klub bisbol SMA Fuji lagi.
Dialogue: 0,0:06:59.08,0:07:00.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chitose,
Dialogue: 0,0:07:00.62,0:07:03.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ayo gosok kolam ini sampai berkilau.
Dialogue: 0,0:07:03.59,0:07:06.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti musim panas.
Dialogue: 0,0:07:42.58,0:07:44.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih untuk tadi.
Dialogue: 0,0:07:44.46,0:07:47.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata kau juga bisa lepas kendali.
Dialogue: 0,0:07:47.42,0:07:50.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf kau harus melihat sisi payahku itu.
Dialogue: 0,0:07:50.59,0:07:54.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu lebih baik daripada menyeringai\Nseperti orang bodoh dalam situasi itu.
Dialogue: 0,0:07:55.18,0:07:58.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau akan mengabaikannya\Njika aku menanyakannya, 'kan?
Dialogue: 0,0:08:02.69,0:08:05.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga, kau memang lelaki yang merepotkan.
Dialogue: 0,0:08:06.15,0:08:08.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Dingin! Sakit!\N- Kepalamu sudah lumayan adem?
Dialogue: 0,0:08:08.98,0:08:11.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan semprot kencang!\NSetidaknya siram saja!
Dialogue: 0,0:08:12.36,0:08:14.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengarkan aku!
Dialogue: 0,0:08:15.70,0:08:18.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, kau bakal kena out\Nmeski mencuri base!
Dialogue: 0,0:08:23.25,0:08:27.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, kau yang memintanya. Tetap di sana!
Dialogue: 0,0:08:27.29,0:08:28.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu sebentar!
Dialogue: 0,0:08:28.88,0:08:32.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bocah, bakal kubuat kau basah kuyup.\NBersiaplah!
Dialogue: 0,0:08:32.76,0:08:35.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku serius! Jangan sekarang!
Dialogue: 0,0:08:35.17,0:08:36.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diam!
Dialogue: 0,0:08:46.86,0:08:49.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan lihat aku, Bodoh.
Dialogue: 0,0:08:50.48,0:08:52.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau tidak memakai kamisolmu?
Dialogue: 0,0:08:52.65,0:08:55.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kupikir akan terlalu panas,
Dialogue: 0,0:08:55.86,0:08:58.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi, aku melepasnya sebelum kita mulai.
Dialogue: 0,0:09:00.95,0:09:02.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun...
Dialogue: 0,0:09:04.00,0:09:07.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jika itu kau, aku tidak keberatan.
Dialogue: 0,0:09:16.26,0:09:19.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak tertarik padaku?
Dialogue: 0,0:09:19.55,0:09:21.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan begitu.
Dialogue: 0,0:09:22.02,0:09:25.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, lihat aku baik-baik.
Dialogue: 0,0:09:27.06,0:09:28.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu...
Dialogue: 0,0:09:29.02,0:09:30.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kena kau!
Dialogue: 0,0:09:34.15,0:09:36.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu curang, menyerangku saat aku lengah!
Dialogue: 0,0:09:36.57,0:09:37.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:09:38.07,0:09:45.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bilang aku membuatmu terpesona\Ndengan penampilan seksiku.
Dialogue: 0,0:10:01.39,0:10:04.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Haru. Aku agak bersemangat.
Dialogue: 0,0:10:06.18,0:10:09.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika ini terus berlanjut,\Nkurasa aku tak akan bisa tenang.
Dialogue: 0,0:10:10.27,0:10:12.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudmu?
Dialogue: 0,0:10:12.11,0:10:14.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau serius?
Dialogue: 0,0:10:14.19,0:10:16.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau membawa pakaian ganti, bukan?
Dialogue: 0,0:10:16.24,0:10:18.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak keberatan jika berantakan?
Dialogue: 0,0:10:18.32,0:10:20.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku membawanya. Tak apa-apa.
Dialogue: 0,0:10:20.95,0:10:23.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu! Chitose!
Dialogue: 0,0:10:29.71,0:10:33.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja aku tak bisa membiarkanmu\Nsetelah kau terus memojokkanku!
Dialogue: 0,0:10:34.63,0:10:37.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Yang benar saja, apa yang kau lakukan?\N- Aku tak mau menunggu!
Dialogue: 0,0:10:37.09,0:10:38.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan!
Dialogue: 0,0:10:48.81,0:10:52.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ada di sana\Nmenonton turnamen musim panas tahun lalu.
Dialogue: 0,0:10:52.31,0:10:53.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa begitu.
Dialogue: 0,0:10:53.69,0:10:55.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau satu-satunya.
Dialogue: 0,0:10:56.48,0:10:57.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya kau
Dialogue: 0,0:10:58.07,0:11:02.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang sungguh percaya bahwa tim lemah\Ndari sekolah unggulan akademik kita
Dialogue: 0,0:11:02.20,0:11:04.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa masuk Koshien.
Dialogue: 0,0:11:04.83,0:11:06.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:11:06.95,0:11:08.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutku itu sangat keren.
Dialogue: 0,0:11:14.34,0:11:16.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah bermimpi sangat panjang.
Dialogue: 0,0:11:17.38,0:11:19.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu dimulai saat SD.
Dialogue: 0,0:11:19.42,0:11:20.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seorang teman mengundangku
Dialogue: 0,0:11:20.68,0:11:24.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan entah bagaimana aku akhirnya\Nikut latihan tim bisbol anak-anak.
Dialogue: 0,0:11:25.05,0:11:28.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat benci kalah dalam olahraga
Dialogue: 0,0:11:28.47,0:11:30.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hingga selama masa percobaan satu bulan,
Dialogue: 0,0:11:30.31,0:11:33.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku berlatih setiap hari.
Dialogue: 0,0:11:33.44,0:11:35.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya, aku benar-benar keranjingan.
Dialogue: 0,0:11:46.16,0:11:47.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, suatu hari,
Dialogue: 0,0:11:47.70,0:11:50.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku memukul bola\Nyang tampak menembus langit.
Dialogue: 0,0:11:50.37,0:11:52.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat bola itu menghantam gedung sekolah,
Dialogue: 0,0:11:54.83,0:11:58.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku menyerahkan formulir pendaftaranku.
Dialogue: 0,0:12:00.34,0:12:02.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, aku masuk SMP.
Dialogue: 0,0:12:14.19,0:12:17.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menjadi pemain inti sejak kelas 7,
Dialogue: 0,0:12:17.52,0:12:20.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan para senior\Nyang tidak menganggap serius bisbol
Dialogue: 0,0:12:20.19,0:12:21.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menganggapku sebagai duri dalam daging.
Dialogue: 0,0:12:39.71,0:12:44.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untungnya, anak kelas 7 lainnya membelaku.
Dialogue: 0,0:12:44.34,0:12:48.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami menahan perlakuan tidak adil mereka\Ndan terus berlatih dalam diam.
Dialogue: 0,0:12:49.76,0:12:52.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tim yang bersatu seperti itu kuat.
Dialogue: 0,0:12:53.35,0:12:55.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekolah kami biasanya kalah
Dialogue: 0,0:12:55.40,0:12:56.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di babak kedua,
Dialogue: 0,0:12:57.23,0:13:01.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi di musim panas terakhir kami,\Nakhirnya kami menang turnamen prefektur.
Dialogue: 0,0:13:02.78,0:13:06.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat itu, aku sudah terkenal\Nsebagai pemukul.
Dialogue: 0,0:13:06.78,0:13:11.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mendapat tawaran dari sekolah kuat\Ndi dalam dan luar prefektur.
Dialogue: 0,0:13:11.33,0:13:14.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, aku tidak tertarik\Nbergabung dengan tim
Dialogue: 0,0:13:14.08,0:13:15.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang pasti menang.
Dialogue: 0,0:13:16.50,0:13:17.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mumpung ada kesempatan,
Dialogue: 0,0:13:17.96,0:13:20.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku mau mulai dari awal dengan rekan tim\Nyang kebetulan kutemui
Dialogue: 0,0:13:20.13,0:13:22.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan berusaha mencapai puncak,\Nseperti di manga.
Dialogue: 0,0:13:23.46,0:13:24.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah yang kupikirkan.
Dialogue: 0,0:13:26.34,0:13:28.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya, SMA.
Dialogue: 0,0:13:28.39,0:13:29.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat kudengar klub bisbolnya
Dialogue: 0,0:13:29.51,0:13:31.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}punya sepuluh anak kelas 3,
Dialogue: 0,0:13:31.31,0:13:33.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi tak ada anak kelas 2,
Dialogue: 0,0:13:33.31,0:13:35.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku sangat panik.
Dialogue: 0,0:13:38.52,0:13:43.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mulai bicara dengan pemain\Nyang berpengalaman di angkatanku.
Dialogue: 0,0:13:43.15,0:13:46.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat itulah aku bertemu\Npemukul urutan keempat
Dialogue: 0,0:13:46.61,0:13:49.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dari tim kuat yang kuhadapi saat SMP,
Dialogue: 0,0:13:49.12,0:13:50.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ezaki Yusuke.
Dialogue: 0,0:13:51.24,0:13:54.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga menemukan\Nbeberapa pemain terkenal lainnya.
Dialogue: 0,0:13:56.87,0:13:59.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya sudah siap\Nuntuk perjalanan kami ke Koshien.
Dialogue: 0,0:14:00.04,0:14:02.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah itu berarti berlatih\Nsampai aku pingsan,
Dialogue: 0,0:14:02.38,0:14:05.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menyadari batasku sendiri,
Dialogue: 0,0:14:05.13,0:14:08.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau dihancurkan oleh lawan yang luar biasa,
Dialogue: 0,0:14:08.18,0:14:10.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tidak takut apa pun.
Dialogue: 0,0:14:10.97,0:14:13.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena aku sangat menyukai bisbol.
Dialogue: 0,0:14:31.66,0:14:35.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan mengabdikan\Nseluruh hidupku untuk itu.
Dialogue: 0,0:14:36.04,0:14:39.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan memberikan seluruh masa mudaku.
Dialogue: 0,0:14:43.34,0:14:45.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, saat jalan di depan menjadi jelas,
Dialogue: 0,0:14:46.26,0:14:49.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku ditinggalkan sendirian di lapangan luas.
Dialogue: 0,0:14:50.05,0:14:51.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanpa pemukul, sarung tangan,
Dialogue: 0,0:14:52.05,0:14:53.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan nomor seragam.
Dialogue: 0,0:14:54.06,0:14:58.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya penyendiri biasa.
Dialogue: 0,0:15:08.24,0:15:09.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo?
Dialogue: 0,0:15:09.36,0:15:11.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga, akhirnya kau menjawab.
Dialogue: 0,0:15:11.20,0:15:12.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di mana kau sekarang?
Dialogue: 0,0:15:12.82,0:15:14.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di mana?
Dialogue: 0,0:15:14.33,0:15:16.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baru bangun, jadi, aku di rumah.
Dialogue: 0,0:15:16.41,0:15:18.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar bodoh!
Dialogue: 0,0:15:18.20,0:15:21.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah kita sepakat bertemu\Ndi depan stasiun untuk kencan kita?
Dialogue: 0,0:15:25.34,0:15:29.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf! Aku akan tiba 20 menit lagi!\NCari tempat teduh dan tunggu aku!
Dialogue: 0,0:15:43.56,0:15:46.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga!
Dialogue: 0,0:16:05.04,0:16:07.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saku, apa terjadi sesuatu?
Dialogue: 0,0:16:07.30,0:16:08.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau bertanya?
Dialogue: 0,0:16:08.67,0:16:13.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kau biasanya datang lebih awal,\Nsebelum kita seharusnya bertemu.
Dialogue: 0,0:16:16.22,0:16:19.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada sedikit masalah dengan klub bisbol.
Dialogue: 0,0:16:19.93,0:16:21.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin itu sebabnya aku merasa lelah.
Dialogue: 0,0:16:25.10,0:16:27.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau yang tampak sedih?
Dialogue: 0,0:16:27.77,0:16:32.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena bisbol istimewa bagimu, 'kan?
Dialogue: 0,0:16:32.90,0:16:36.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau merasa\Ntak ada hal lain dalam hidup tanpanya.
Dialogue: 0,0:16:36.16,0:16:38.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa begitu.
Dialogue: 0,0:16:40.12,0:16:42.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat hal seistimewa itu hilang,
Dialogue: 0,0:16:42.62,0:16:44.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}itu menakutkan dan menyedihkan.
Dialogue: 0,0:16:48.17,0:16:49.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Saku.
Dialogue: 0,0:16:49.63,0:16:52.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Ternyata Chitose dan Hiiragi.
Dialogue: 0,0:16:52.55,0:16:53.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayase.
Dialogue: 0,0:16:53.93,0:16:55.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo minum teh bersama.
Dialogue: 0,0:16:55.59,0:16:57.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:16:59.93,0:17:02.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga, kenapa wajahmu murung?
Dialogue: 0,0:17:08.90,0:17:10.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Saku.
Dialogue: 0,0:17:10.78,0:17:12.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau melihat ke mana?
Dialogue: 0,0:17:12.78,0:17:16.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak apa-apa. Aku sengaja memamerkannya.
Dialogue: 0,0:17:18.61,0:17:22.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong,\Ndia pernah digosipkan mengencani Nanase.
Dialogue: 0,0:17:22.16,0:17:24.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, apa kalian sungguh tak berpacaran?
Dialogue: 0,0:17:24.82,0:17:26.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami tak berpacaran.
Dialogue: 0,0:17:26.42,0:17:29.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya aku yang menyukai Saku.
Dialogue: 0,0:17:30.29,0:17:32.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah itu menyakitkan?
Dialogue: 0,0:17:32.46,0:17:36.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, tapi menurutku, yang terang-terangan\Ndikatai begitu juga pasti berat.
Dialogue: 0,0:17:36.63,0:17:38.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang meminta kepadanya.
Dialogue: 0,0:17:38.72,0:17:42.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memintanya tidak memberiku jawaban\Nsampai aku resmi menyatakan perasaanku.
Dialogue: 0,0:17:42.68,0:17:46.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang benar aku merepotkan Saku.
Dialogue: 0,0:17:46.44,0:17:49.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, keadaan tak bisa terus begini.
Dialogue: 0,0:17:52.40,0:17:54.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu itu.
Dialogue: 0,0:17:54.86,0:17:56.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelihatannya tidak begitu.
Dialogue: 0,0:17:56.82,0:17:58.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kau bilang "tahu",
Dialogue: 0,0:17:58.53,0:18:02.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berarti seandainya besok Chitose jadian\Ndengan orang yang kau kenal,
Dialogue: 0,0:18:02.58,0:18:04.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau tak akan menyesal, 'kan?
Dialogue: 0,0:18:06.04,0:18:10.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, siapa pun bisa melihat\Nkau dapat perlakuan khusus.
Dialogue: 0,0:18:10.54,0:18:12.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan begitu!
Dialogue: 0,0:18:13.63,0:18:18.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saku memperlakukanku lebih santai\Ndaripada orang lain.
Dialogue: 0,0:18:18.26,0:18:20.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tak memberiku perlakuan khusus.
Dialogue: 0,0:18:21.01,0:18:23.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sebabnya aku mau menjadi\Nseseorang yang istimewa baginya.
Dialogue: 0,0:18:23.97,0:18:25.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah yang kurasakan.
Dialogue: 0,0:18:29.23,0:18:30.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyebalkan sekali.
Dialogue: 0,0:18:32.48,0:18:33.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei.
Dialogue: 0,0:18:34.61,0:18:37.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hiiragi dan aku akan membeli minuman.
Dialogue: 0,0:18:37.28,0:18:38.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu.
Dialogue: 0,0:18:39.28,0:18:41.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu...
Dialogue: 0,0:18:43.33,0:18:45.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya itu tadi?
Dialogue: 0,0:18:47.25,0:18:48.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudmu?
Dialogue: 0,0:18:48.96,0:18:51.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah kau baru membicarakan klub bisbol?
Dialogue: 0,0:18:52.67,0:18:54.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau dengar itu?
Dialogue: 0,0:18:56.67,0:18:59.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau tidak bergabung\Ndengan klub bisbol?
Dialogue: 0,0:19:00.93,0:19:04.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat kau bilang kita pernah berhadapan\Ndi final prefektur, akhirnya aku ingat.
Dialogue: 0,0:19:04.39,0:19:05.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal masih anak SMP,
Dialogue: 0,0:19:05.89,0:19:08.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kau melempar bola cepat\Nseperti monster.
Dialogue: 0,0:19:09.48,0:19:11.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melawan monster itu,
Dialogue: 0,0:19:11.52,0:19:13.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau mencatat tiga hit, satu walk,
Dialogue: 0,0:19:14.07,0:19:16.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dua home run, dan lima RBI.
Dialogue: 0,0:19:16.15,0:19:19.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kedengarannya kau genius.
Dialogue: 0,0:19:19.15,0:19:20.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama sekali tidak.
Dialogue: 0,0:19:21.53,0:19:25.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lemparan pertama,\Nbola cepat rendah ke sisi dalam.
Dialogue: 0,0:19:25.28,0:19:27.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah siap mengayun,
Dialogue: 0,0:19:27.24,0:19:29.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi itu kali pertama aku menahan diri\Nmengayun di lemparan yang kusukai.
Dialogue: 0,0:19:30.00,0:19:31.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan konyol.
Dialogue: 0,0:19:31.75,0:19:33.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau terlihat sangat santai di kotak pemukul,
Dialogue: 0,0:19:33.71,0:19:35.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menyeringai kepadaku\Nseolah itu bukan apa-apa.
Dialogue: 0,0:19:35.80,0:19:37.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu kebiasaan buruk.
Dialogue: 0,0:19:37.92,0:19:41.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setiap kali menghadapi\Nrintangan yang tak bisa kuatasi,
Dialogue: 0,0:19:41.13,0:19:43.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menurutku itu menarik\Ndan aku tak bisa menahan senyum.
Dialogue: 0,0:19:44.97,0:19:47.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau juga merasa seperti itu, bukan?
Dialogue: 0,0:19:49.18,0:19:51.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan salahmu aku berhenti bermain bisbol.
Dialogue: 0,0:19:51.85,0:19:53.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini salahku sendiri.
Dialogue: 0,0:19:53.69,0:19:57.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya memastikan\Nbahwa keputusanku ini tidak salah.
Dialogue: 0,0:19:58.40,0:19:59.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun...
Dialogue: 0,0:20:00.24,0:20:05.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira kau akan naik ke tingkat\Nyang tak bisa dicapai orang lain.
Dialogue: 0,0:20:07.66,0:20:11.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua orang berpikir begitu.\NIni hal yang kuputuskan sendiri.
Dialogue: 0,0:20:11.50,0:20:13.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sudah berakhir.
Dialogue: 0,0:20:13.54,0:20:17.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, jangan terus mengingatkanku\Nseperti itu.
Dialogue: 0,0:20:17.21,0:20:22.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Kau meninggalkan\Nhal penting di lapangan itu, 'kan?"
Dialogue: 0,0:20:32.23,0:20:35.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Toudo Mai dari SMA Ashiba datang!
Dialogue: 0,0:20:53.21,0:20:56.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kau di sini,\Nayo satu lawan satu, Toudo.
Dialogue: 0,0:20:56.63,0:20:59.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh, Bu Misaki? Bu Tominaga?
Dialogue: 0,0:21:00.30,0:21:01.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Antar-SMA sudah dekat.
Dialogue: 0,0:21:02.05,0:21:05.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku di sini hanya untuk mengatur\Njadwal latih tanding.
Dialogue: 0,0:21:05.26,0:21:08.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak mau melakukan apa pun yang bisa\Nmemengaruhi kondisi pemain andalan kami.
Dialogue: 0,0:21:09.89,0:21:11.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudnya, dia tak mau\NMai bermain dengan bocah sepertimu
Dialogue: 0,0:21:11.93,0:21:14.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu meniru kebiasaan anehmu.
Dialogue: 0,0:21:15.44,0:21:17.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Misaki, aku tak bilang sampai segitunya.
Dialogue: 0,0:21:17.86,0:21:19.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai pelatihnya,
Dialogue: 0,0:21:19.98,0:21:22.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kurasa lebih baik mengatakan\Nyang sebenarnya.
Dialogue: 0,0:21:26.57,0:21:27.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu.
Dialogue: 0,0:21:28.78,0:21:30.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo bertarung satu lawan satu.
Dialogue: 0,0:21:30.87,0:21:31.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:21:32.75,0:21:34.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus berganti pakaian.\NBoleh aku memakai ruang klub?
Dialogue: 0,0:21:35.21,0:21:36.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mai.
Dialogue: 0,0:21:36.12,0:21:39.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak selemah itu\Nhingga ini akan memengaruhiku.
Dialogue: 0,0:21:39.88,0:21:41.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga.
Dialogue: 0,0:21:41.17,0:21:42.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, ayo, Toudo!
Dialogue: 0,0:21:42.80,0:21:44.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ikuti aku.
Dialogue: 0,0:21:44.09,0:21:45.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa namamu?
Dialogue: 0,0:21:51.26,0:21:54.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Small forward SMA Fuji, Aomi Haru.
Dialogue: 0,0:21:54.39,0:21:55.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senang bertemu denganmu.
Dialogue: 0,0:23:35.83,0:23:39.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Tempat Dekat Langit Berbintang,\NAyunan Janji Kita Berdua."
