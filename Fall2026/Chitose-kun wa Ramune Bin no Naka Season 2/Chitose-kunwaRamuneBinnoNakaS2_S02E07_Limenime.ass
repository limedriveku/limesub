Dialogue: 0,0:01:13.74,0:01:22.66,sign,,0000,0000,0000,,CHITOSE IS IN THE RAMUNE BOTTLE
Dialogue: 0,0:01:44.79,0:01:45.45,sign,,0000,0000,0000,,KELAS 11
Dialogue: 0,0:02:49.48,0:02:53.63,sign,,0000,0000,0000,,"PEMUKUL KETIGA, CHITOSE"
Dialogue: 0,0:04:08.06,0:04:09.58,sign,,0000,0000,0000,,"HOKURIKU VS. FUJI"
Dialogue: 0,0:15:01.81,0:15:04.17,sign,,0000,0000,0000,,RUANG UKS
Dialogue: 0,0:23:35.62,0:23:37.46,sign,,0000,0000,0000,,EPISODE SELANJUTNYA: NYALAKAN API DI HATIMU
Dialogue: 0,0:01:33.17,0:01:34.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}April tahun lalu.
Dialogue: 0,0:01:35.59,0:01:39.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagian besar anggota baru\Nadalah pemain inti di SMP.
Dialogue: 0,0:01:39.14,0:01:41.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski kami sedikit tertinggal\Ndari tim-tim kuat,
Dialogue: 0,0:01:41.81,0:01:44.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku sungguh merasa kami cukup kuat\Nuntuk menantang tim papan atas.
Dialogue: 0,0:01:45.48,0:01:46.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku terkejut saat mendengar
Dialogue: 0,0:01:46.52,0:01:48.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}semua anggota kelas 11 berhenti dari klub.
Dialogue: 0,0:01:48.73,0:01:51.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, aku segera mengerti alasannya.
Dialogue: 0,0:01:51.52,0:01:56.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelatihnya tipe kolot,\Nyang sudah jarang ada zaman sekarang.
Dialogue: 0,0:01:56.53,0:01:59.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia yakin filosofi bisbolnya benar.
Dialogue: 0,0:01:59.53,0:02:01.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika ada yang membantah sedikit saja,
Dialogue: 0,0:02:01.49,0:02:03.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia akan marah dan mengamuk.
Dialogue: 0,0:02:04.08,0:02:07.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia biasa mencoret pemain dari daftar\Nsebagai bentuk hukuman.
Dialogue: 0,0:02:11.13,0:02:15.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saku, kau memang hebat.
Dialogue: 0,0:02:15.42,0:02:18.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa tiba-tiba bilang begitu?\NGeli, tahu.
Dialogue: 0,0:02:18.38,0:02:19.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asalkan kau menjadi pemukul urutan ketiga,
Dialogue: 0,0:02:19.80,0:02:21.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bahkan melawan pelempar andalan\Ntingkat Koshien,
Dialogue: 0,0:02:21.72,0:02:23.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau pasti akan menemukan terobosan.
Dialogue: 0,0:02:24.06,0:02:26.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang akan menuntaskannya\Nsebagai pemukul urutan keempat.
Dialogue: 0,0:02:27.18,0:02:29.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, aku akan menahan lawan.
Dialogue: 0,0:02:29.60,0:02:30.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana menurutmu, Saku?
Dialogue: 0,0:02:32.65,0:02:36.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu strategi terbodoh.
Dialogue: 0,0:02:36.11,0:02:37.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari lakukan itu.
Dialogue: 0,0:02:41.87,0:02:45.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelatih awalnya mau\Naku menjadi pemukul urutan keempat.
Dialogue: 0,0:02:45.66,0:02:47.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat aku mengusulkan\N"Teori Pemukul Ketiga Terkuat",
Dialogue: 0,0:02:47.83,0:02:49.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia sangat marah.
Dialogue: 0,0:02:49.48,0:02:53.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, akhirnya dia tampak menerimanya.
Dialogue: 0,0:02:54.17,0:02:58.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di mataku, Yusuke juga pemukul kuat\Nyang bisa diandalkan.
Dialogue: 0,0:02:58.63,0:03:03.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lemparan Hirano cukup bagus\Nuntuk bersaing dengan sekolah papan atas.
Dialogue: 0,0:03:03.55,0:03:05.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kami bertiga memimpin tim,
Dialogue: 0,0:03:05.76,0:03:07.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami punya peluang ke Koshien.
Dialogue: 0,0:03:07.93,0:03:10.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sungguh percaya itu.
Dialogue: 0,0:03:11.35,0:03:14.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masalah dimulai\Npada suatu hari di bulan Juni.
Dialogue: 0,0:03:15.61,0:03:19.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelatih tiba-tiba memutuskan agar Hirano\Nmempelajari jenis lemparan variasi baru.
Dialogue: 0,0:03:20.78,0:03:22.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, Pelatih.
Dialogue: 0,0:03:22.53,0:03:24.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dilihat dari mana pun,
Dialogue: 0,0:03:24.12,0:03:27.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}senjata terbesar Hirano adalah\Nbola cepat dari postur tingginya,
Dialogue: 0,0:03:27.66,0:03:30.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bersama dengan bola melengkung tajam\Ndan slider-nya.
Dialogue: 0,0:03:30.16,0:03:32.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah kita harus mengasah itu dulu?
Dialogue: 0,0:03:33.33,0:03:37.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika tidak patuh,\Nkau bisa meninggalkan klub sekarang.
Dialogue: 0,0:03:38.96,0:03:41.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian ini terlalu besar kepala, ya?
Dialogue: 0,0:03:41.26,0:03:43.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak butuh pemain\Nyang mengganggu keharmonisan tim.
Dialogue: 0,0:03:43.64,0:03:45.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ezaki dilarang bermain untuk saat ini.
Dialogue: 0,0:03:46.68,0:03:49.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, kenapa hanya Yusuke?
Dialogue: 0,0:03:49.56,0:03:55.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski sedikit bermasalah,\NChitose punya nilai besar bagi tim.
Dialogue: 0,0:03:55.36,0:03:59.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, Ezaki yang sekarang\Ntidak punya nilai sebesar itu.
Dialogue: 0,0:04:00.61,0:04:03.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kami mencapai laga pertama\Nbabak penyisihan musim panas.
Dialogue: 0,0:04:04.07,0:04:07.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yusuke tidak masuk daftar pemain inti.
Dialogue: 0,0:04:08.06,0:04:09.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}SMA Hokuriku
Dialogue: 0,0:04:09.66,0:04:12.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}punya tim bisbol yang kuat.
Dialogue: 0,0:04:12.58,0:04:14.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paruh kedua inning pertama.
Dialogue: 0,0:04:15.92,0:04:17.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkat home run soloku,
Dialogue: 0,0:04:17.67,0:04:19.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}SMA Fuji memimpin lebih awal.
Dialogue: 0,0:04:20.33,0:04:23.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permainan mulai berubah\Ndi paruh pertama inning keenam.
Dialogue: 0,0:04:23.72,0:04:26.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu lawan mulai membaca lemparan Hirano,
Dialogue: 0,0:04:26.14,0:04:27.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}permainan berubah dalam sekejap.
Dialogue: 0,0:04:33.31,0:04:35.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami dihajar tanpa bisa melawan,
Dialogue: 0,0:04:35.65,0:04:37.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kebobolan 12 run sekaligus.
Dialogue: 0,0:04:37.86,0:04:39.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan tekad terakhirku,
Dialogue: 0,0:04:41.53,0:04:44.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku mencetak home run solo kedua,
Dialogue: 0,0:04:44.78,0:04:46.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi permainan tetap berakhir lebih awal\Ndi inning keenam.
Dialogue: 0,0:04:46.99,0:04:48.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekalahan telak.
Dialogue: 0,0:04:50.58,0:04:54.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami hanya salah satu tim lemah\Nyang ada di mana-mana.
Dialogue: 0,0:04:55.71,0:05:00.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan, di situlah impianku berakhir.
Dialogue: 0,0:05:02.96,0:05:06.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai kapan Bapak akan meneruskan\Nhukuman sia-sia ini?
Dialogue: 0,0:05:06.51,0:05:08.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika Yusuke menjadi pemukul keempat...
Dialogue: 0,0:05:08.35,0:05:09.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan naif!
Dialogue: 0,0:05:09.97,0:05:14.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kalian tidak membantahku,\Nhasil hari ini akan berbeda.
Dialogue: 0,0:05:15.39,0:05:17.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus memberimu pelajaran
Dialogue: 0,0:05:17.94,0:05:20.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tentang hal yang terjadi saat kau\Nmengganggu keharmonisan tim.
Dialogue: 0,0:05:20.65,0:05:22.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bilang begitu!
Dialogue: 0,0:05:22.19,0:05:25.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bapak yang mengganggu keharmonisan!
Dialogue: 0,0:05:26.45,0:05:28.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melawan pelempar andalan Hokuriku,
Dialogue: 0,0:05:28.41,0:05:31.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau mencatat empat hit dari empat kesempatan\Ndan bahkan mencetak dua home run.
Dialogue: 0,0:05:31.45,0:05:33.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pantas saja kau sangat sombong.
Dialogue: 0,0:05:33.29,0:05:34.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak sombong.
Dialogue: 0,0:05:35.04,0:05:38.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya mau Bapak membiarkan kami\Nbermain bisbol.
Dialogue: 0,0:05:38.42,0:05:42.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesempatan ke Koshien Musim Panas\Ncuma ada tiga kali!
Dialogue: 0,0:05:42.67,0:05:45.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa salah Yusuke?
Dialogue: 0,0:05:45.22,0:05:48.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya biarkan dia berusaha maksimal\Ndi lapangan bisbol!
Dialogue: 0,0:05:49.47,0:05:52.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik. Ezaki bisa kembali.
Dialogue: 0,0:05:52.68,0:05:54.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun...
Dialogue: 0,0:05:55.48,0:05:58.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak butuh jagoan yang sombong.
Dialogue: 0,0:05:59.85,0:06:03.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama satu setengah bulan setelahnya\Nsampai akhir liburan musim panas,
Dialogue: 0,0:06:03.57,0:06:08.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku merasa seperti berkeliaran di labirin\Ntanpa jalan keluar.
Dialogue: 0,0:06:09.41,0:06:14.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di lapangan, aku tak boleh\Nmenyentuh bola atau pemukul.
Dialogue: 0,0:06:14.16,0:06:16.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari demi hari,
Dialogue: 0,0:06:16.20,0:06:18.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hanya berlari dan latihan beban.
Dialogue: 0,0:06:19.58,0:06:23.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejujurnya, aku hampir gila.
Dialogue: 0,0:06:24.00,0:06:27.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu, aku tak bisa berhenti di sana.
Dialogue: 0,0:06:27.92,0:06:29.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rekan-rekan setimku menungguku.
Dialogue: 0,0:06:29.76,0:06:33.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka yang bersumpah denganku\Nbahwa kami akan ke Koshien.
Dialogue: 0,0:06:33.68,0:06:35.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, untuk saat ini,\Naku hanya bisa menahannya.
Dialogue: 0,0:06:35.52,0:06:37.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menggertakkan gigi dan terus maju.
Dialogue: 0,0:06:38.73,0:06:40.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awalnya,
Dialogue: 0,0:06:40.60,0:06:44.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}rekan-rekan setimku, terutama Yusuke,\Nmenyemangatiku.
Dialogue: 0,0:06:45.28,0:06:46.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemain berbakat sepertimu,
Dialogue: 0,0:06:46.90,0:06:49.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pelatih tak bisa menahanmu selamanya.
Dialogue: 0,0:06:49.70,0:06:52.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kembali ke lapangan bersama, Rekan.
Dialogue: 0,0:06:57.29,0:07:02.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, tidak seorang pun memprotes pelatih.
Dialogue: 0,0:07:02.13,0:07:06.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, tak ada yang mau\Nmenjadi target berikutnya.
Dialogue: 0,0:07:06.09,0:07:08.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya, sedikit demi sedikit,
Dialogue: 0,0:07:08.17,0:07:10.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}semua orang mulai memperlakukanku\Nseperti sampah
Dialogue: 0,0:07:10.63,0:07:12.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan menjauhkan diri dariku.
Dialogue: 0,0:07:15.81,0:07:17.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari terakhir bulan Agustus.
Dialogue: 0,0:07:20.27,0:07:22.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial, aku lupa sarung tanganku.
Dialogue: 0,0:07:26.07,0:07:28.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelatih sedang menjadikan Saku contoh, ya.
Dialogue: 0,0:07:28.32,0:07:30.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berapa lama ini akan bertahan?
Dialogue: 0,0:07:30.28,0:07:32.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau bagaimanapun, ini sudah terlalu lama.
Dialogue: 0,0:07:32.53,0:07:34.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Liburan musim panas berakhir hari ini.
Dialogue: 0,0:07:34.87,0:07:37.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar sekali. Bagaimana\Ndengan pertandingannya?
Dialogue: 0,0:07:38.04,0:07:41.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, mungkin kita lebih kuat seperti ini.
Dialogue: 0,0:07:43.88,0:07:46.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar. Tim ini sebenarnya\Nmenjadi lebih kompak.
Dialogue: 0,0:07:46.21,0:07:48.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tingkat kemampuannya sangat berbeda.
Dialogue: 0,0:07:48.38,0:07:50.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pria yang baik, tapi...
Dialogue: 0,0:07:50.26,0:07:53.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar sekolah-sekolah kuat merekrutnya,\Ntapi dia menolaknya.
Dialogue: 0,0:07:53.39,0:07:55.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sengaja memilih tim yang lebih lemah\Nhanya untuk mengincar Koshien?
Dialogue: 0,0:07:56.01,0:07:57.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya ini manga?
Dialogue: 0,0:07:58.39,0:08:00.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang berbakat alami
Dialogue: 0,0:08:00.77,0:08:03.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mustahil mengerti perjuangan orang biasa.
Dialogue: 0,0:08:05.94,0:08:07.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:08:14.99,0:08:16.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saku?
Dialogue: 0,0:08:18.79,0:08:23.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa tak pernah ada tempat untukku\Ndi sini sejak awal?
Dialogue: 0,0:08:31.63,0:08:35.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak berharap merasa lebih baik\Nhanya dengan membicarakannya.
Dialogue: 0,0:08:36.67,0:08:40.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, aku sungguh tidak merasa lebih baik.
Dialogue: 0,0:08:42.17,0:08:43.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau bercanda?
Dialogue: 0,0:08:44.56,0:08:47.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau bercanda, Chitose?
Dialogue: 0,0:08:48.11,0:08:50.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelatih sungguh jahat.
Dialogue: 0,0:08:50.19,0:08:52.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rekan setim yang diam saja juga salah.
Dialogue: 0,0:08:52.78,0:08:57.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, orang yang paling membuatku marah\Nadalah kau!
Dialogue: 0,0:08:58.78,0:09:01.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah kau mempertaruhkan\Nseluruh hidupmu untuk ini?
Dialogue: 0,0:09:01.95,0:09:03.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa pun kata orang,
Dialogue: 0,0:09:03.83,0:09:05.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sekeras apa pun usahamu,
Dialogue: 0,0:09:05.46,0:09:07.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hanya kau yang tahu itu, 'kan?
Dialogue: 0,0:09:08.04,0:09:10.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hal sepenting itu...
Dialogue: 0,0:09:10.21,0:09:11.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa...
Dialogue: 0,0:09:11.88,0:09:14.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau menyerah semudah itu?
Dialogue: 0,0:09:17.22,0:09:21.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tidak mudah.
Dialogue: 0,0:09:27.02,0:09:29.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Musim panas lalu,
Dialogue: 0,0:09:29.11,0:09:32.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku dikalahkan oleh sekolah Mai, SMA Ashi.
Dialogue: 0,0:09:32.19,0:09:34.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku terpuruk.
Dialogue: 0,0:09:34.28,0:09:36.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira sekeras apa pun aku berjuang,
Dialogue: 0,0:09:36.15,0:09:39.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan tinggi badanku,\Naku tak akan pernah berhasil seumur hidupku.
Dialogue: 0,0:09:40.03,0:09:44.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat itulah aku menonton pertandinganmu.
Dialogue: 0,0:09:44.25,0:09:45.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inning keenam itu.
Dialogue: 0,0:09:45.66,0:09:47.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagi orang awam sepertiku,
Dialogue: 0,0:09:47.79,0:09:50.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}semuanya tampak sia-sia.
Dialogue: 0,0:09:50.59,0:09:53.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, kau terus tersenyum.
Dialogue: 0,0:09:55.26,0:09:58.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bukan seringai bodoh seseorang\Nyang menyerah dan berhenti peduli.
Dialogue: 0,0:09:59.01,0:10:03.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tatapan seseorang yang sungguh percaya\Ndia masih bisa mengubah keadaan.
Dialogue: 0,0:10:06.85,0:10:08.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di akhir inning itu,
Dialogue: 0,0:10:08.65,0:10:11.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau mencetak home run.
Dialogue: 0,0:10:11.11,0:10:15.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bolanya terbang sangat tinggi,\Nseolah akan mencapai bulan.
Dialogue: 0,0:10:15.36,0:10:18.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Home run yang bersih dan indah.
Dialogue: 0,0:10:19.66,0:10:23.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seolah kau bilang\Ntidak menyerah itu tak apa-apa.
Dialogue: 0,0:10:23.95,0:10:25.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersemangat itu tak apa-apa.
Dialogue: 0,0:10:25.54,0:10:27.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlihat menyedihkan itu tak apa-apa.
Dialogue: 0,0:10:27.21,0:10:29.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berjuanglah sekuat tenaga.
Dialogue: 0,0:10:29.71,0:10:32.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika ada yang kau inginkan,\Nraih dan ambillah.
Dialogue: 0,0:10:33.59,0:10:35.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitulah caraku bangkit kembali.
Dialogue: 0,0:10:36.01,0:10:37.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitulah aku bisa sampai sejauh ini.
Dialogue: 0,0:10:37.63,0:10:39.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitulah aku masih berdiri.
Dialogue: 0,0:10:39.93,0:10:45.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pahlawan sejati pertama\Nyang pernah kutemui!
Dialogue: 0,0:10:45.39,0:10:49.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan berhenti\Nseperti pecundang menyedihkan!
Dialogue: 0,0:10:49.27,0:10:51.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diusir oleh pelatih?
Dialogue: 0,0:10:51.23,0:10:54.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, bersujudlah\Ndan minta maaf 100 kali!
Dialogue: 0,0:10:54.11,0:10:56.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika itu tidak berhasil, pindah saja!
Dialogue: 0,0:10:56.61,0:10:58.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rekan-rekan setimmu tidak serius?
Dialogue: 0,0:10:59.07,0:11:01.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,\Ngunakan semangat dan permainanmu
Dialogue: 0,0:11:01.36,0:11:03.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk membuat mereka menganggapnya serius!
Dialogue: 0,0:11:03.53,0:11:06.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunjukkan impian mereka bisa terwujud\Ndengan kau di sisi mereka.
Dialogue: 0,0:11:07.41,0:11:11.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beri tahu mereka perasaanmu!
Dialogue: 0,0:11:11.25,0:11:14.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua itu... Semua itu...
Dialogue: 0,0:11:14.54,0:11:20.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bukan alasan\Nkau harus berhenti bermain bisbol!
Dialogue: 0,0:11:22.39,0:11:24.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:11:24.93,0:11:27.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak mau seseorang menghiburku.
Dialogue: 0,0:11:27.22,0:11:29.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak mau dikasihani siapa pun.
Dialogue: 0,0:11:29.77,0:11:32.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak mau menyalahkan pelatih.
Dialogue: 0,0:11:32.56,0:11:35.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga tak mau marah kepada timku.
Dialogue: 0,0:11:36.07,0:11:39.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya... Aku hanya
Dialogue: 0,0:11:39.99,0:11:45.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mau seseorang memarahi diriku yang lemah\Nkarena melarikan diri hari itu.
Dialogue: 0,0:11:45.62,0:11:51.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan, aku selalu...
Dialogue: 0,0:11:56.88,0:11:59.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak apa-apa, Chitose.
Dialogue: 0,0:11:59.46,0:12:01.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku di sini bersamamu.
Dialogue: 0,0:12:14.94,0:12:18.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau menangis tersedu-sedu seperti ini.
Dialogue: 0,0:12:26.45,0:12:29.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa rencanamu soal klub bisbol?
Dialogue: 0,0:12:29.66,0:12:31.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau aku melakukan apa?
Dialogue: 0,0:12:32.04,0:12:34.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benci saat kau seperti ini.
Dialogue: 0,0:12:34.29,0:12:37.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejujurnya, aku masih ragu.
Dialogue: 0,0:12:37.25,0:12:40.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yusuke juga diperlakukan\Ntidak adil tahun lalu.
Dialogue: 0,0:12:40.46,0:12:42.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bahkan sama sekali tak diturunkan.
Dialogue: 0,0:12:42.59,0:12:45.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, jika kubilang\Ntidak berniat membantunya,
Dialogue: 0,0:12:45.47,0:12:46.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}itu bohong.
Dialogue: 0,0:12:47.14,0:12:49.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku paling suka sisi dirimu yang ini.
Dialogue: 0,0:12:50.06,0:12:52.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak penasaran apa aku masih berguna
Dialogue: 0,0:12:52.48,0:12:54.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jika kembali sekarang?
Dialogue: 0,0:12:54.73,0:12:56.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang kau kembali bersikap menyebalkan.
Dialogue: 0,0:12:57.61,0:12:59.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika aku ikut campur dan membantu,
Dialogue: 0,0:12:59.44,0:13:02.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}peluang memenangkan pertandingan pertama\Nmungkin akan meroket.
Dialogue: 0,0:13:03.24,0:13:05.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku paling suka dirimu yang ini.
Dialogue: 0,0:13:05.57,0:13:07.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, jika kau bertanya
Dialogue: 0,0:13:07.12,0:13:10.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa sekarang aku bisa\Nmemberikan segalanya untuk mereka,
Dialogue: 0,0:13:10.74,0:13:11.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jawabannya tidak.
Dialogue: 0,0:13:12.37,0:13:16.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bermain bisbol dengan perasaan seperti ini\Nsama saja menghina bisbol.
Dialogue: 0,0:13:16.83,0:13:18.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku suka sekali padamu.
Dialogue: 0,0:13:18.88,0:13:22.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beri aku sedikit waktu untuk berpikir.
Dialogue: 0,0:13:23.01,0:13:26.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, akhirnya aku bisa\Nmengakhiri musim panas lalu.
Dialogue: 0,0:13:27.93,0:13:30.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari membuat permohonan.
Dialogue: 0,0:13:30.89,0:13:32.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok tiba-tiba?
Dialogue: 0,0:13:32.93,0:13:34.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini Tanabata.
Dialogue: 0,0:13:36.56,0:13:39.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, kuharap\Nkau tetap menjadi dirimu sendiri
Dialogue: 0,0:13:39.31,0:13:40.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}saat melangkah maju.
Dialogue: 0,0:13:42.07,0:13:45.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah menangis seperti itu, kau berusaha\Nterlalu keras untuk bersikap keren.
Dialogue: 0,0:13:45.99,0:13:52.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,\Nkuharap kau mencetak home run lagi.
Dialogue: 0,0:13:55.00,0:13:58.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tidak cocok menjadi\NOrihime dan Hikoboshi.
Dialogue: 0,0:14:07.30,0:14:10.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chitose, ayo berciuman.
Dialogue: 0,0:14:11.89,0:14:13.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benci sisi dirimu yang ini.
Dialogue: 0,0:14:15.81,0:14:20.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku suka sisi dirimu yang ini.
Dialogue: 0,0:14:26.11,0:14:27.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sen!
Dialogue: 0,0:14:27.28,0:14:28.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau terlalu cepat menyerah.
Dialogue: 0,0:14:28.99,0:14:30.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus berusaha!
Dialogue: 0,0:14:30.78,0:14:32.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yo, kau terlalu ceroboh tadi.
Dialogue: 0,0:14:32.66,0:14:34.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih perhatikan posisimu.
Dialogue: 0,0:14:34.87,0:14:38.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nana, kenapa kau tak menembak sendiri?
Dialogue: 0,0:14:38.41,0:14:41.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya mengikuti permainan\Ndengan peluang terbaik untuk sukses.
Dialogue: 0,0:14:41.25,0:14:43.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau akan terus melakukan itu?
Dialogue: 0,0:14:43.54,0:14:46.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau tak bisa mencetak tiga angka\Nsaat pertandingan dipertaruhkan,
Dialogue: 0,0:14:46.21,0:14:47.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}semuanya berakhir.
Dialogue: 0,0:14:47.72,0:14:49.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau terlalu memaksa, Umi.
Dialogue: 0,0:14:49.88,0:14:51.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita masih punya waktu.
Dialogue: 0,0:14:51.64,0:14:54.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa salahnya sedikit memaksa...
Dialogue: 0,0:14:57.77,0:14:58.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Umi!
Dialogue: 0,0:14:58.68,0:14:59.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Haru!
Dialogue: 0,0:15:06.53,0:15:07.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:15:08.44,0:15:11.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, semuanya.
Dialogue: 0,0:15:13.53,0:15:16.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kau pikirkan, bodoh?
Dialogue: 0,0:15:22.21,0:15:24.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau baik-baik saja, Haru?
Dialogue: 0,0:15:28.01,0:15:32.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya... Jadi, selama latihan...
Dialogue: 0,0:15:32.89,0:15:36.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mungkin pingsan karena dehidrasi.
Dialogue: 0,0:15:36.39,0:15:41.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dipikir-pikir,\Nkurasa aku tidak minum air.
Dialogue: 0,0:15:46.11,0:15:47.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bisa minum ini?
Dialogue: 0,0:15:51.20,0:15:55.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, rasanya aku tak punya tenaga.
Dialogue: 0,0:15:55.20,0:15:57.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jujur, kau sangat merepotkan.
Dialogue: 0,0:16:01.08,0:16:02.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini.
Dialogue: 0,0:16:12.01,0:16:14.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Chitose.
Dialogue: 0,0:16:21.14,0:16:23.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sama sekali tidak berjalan lancar.
Dialogue: 0,0:16:26.90,0:16:29.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nana, kami tidak tahan lagi.
Dialogue: 0,0:16:29.48,0:16:33.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah Umi agak berlebihan belakangan ini?
Dialogue: 0,0:16:33.20,0:16:34.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bilang
Dialogue: 0,0:16:34.95,0:16:39.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalian tidak serius mengincar Antar-SMA?
Dialogue: 0,0:16:39.83,0:16:41.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Antar-SMA adalah impian kami.
Dialogue: 0,0:16:41.91,0:16:44.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belum melupakan janji kita hari itu.
Dialogue: 0,0:16:44.62,0:16:51.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, kurasa ini bukan hanya\Nmasalah berlatih lebih lama.
Dialogue: 0,0:16:51.09,0:16:53.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya. Bagaimana denganmu, Yo?
Dialogue: 0,0:16:53.38,0:16:55.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja, aku juga mau pergi.
Dialogue: 0,0:16:55.38,0:17:00.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, tidak semua orang bisa\Nsegera memperbaiki kekurangan mereka.
Dialogue: 0,0:17:00.26,0:17:04.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, Haru tidak meminta mereka\Nsegera memperbaikinya.
Dialogue: 0,0:17:04.77,0:17:08.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia cuma berulang kali mengingatkan mereka\Nagar lebih fokus saat latihan.
Dialogue: 0,0:17:08.69,0:17:11.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik. Ada lagi?
Dialogue: 0,0:17:14.28,0:17:17.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa kita bisa berlatih produktif dengan\Ncukup memanfaatkan waktu setelah sekolah.
Dialogue: 0,0:17:17.91,0:17:21.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, berlatih bahkan saat makan siang\Nagak berlebihan.
Dialogue: 0,0:17:21.57,0:17:23.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak ada gunanya terburu-buru.
Dialogue: 0,0:17:23.75,0:17:26.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua orang punya kecepatan sendiri.
Dialogue: 0,0:17:28.75,0:17:32.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagiku, semua yang mereka katakan\Nterdengar seperti,
Dialogue: 0,0:17:32.26,0:17:34.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Aku mau mengikuti Antar-SMA,
Dialogue: 0,0:17:34.09,0:17:36.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku tak mau berusaha terlalu keras."
Dialogue: 0,0:17:48.60,0:17:49.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapan itu dimulai?
Dialogue: 0,0:17:51.23,0:17:52.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chitose.
Dialogue: 0,0:17:52.86,0:17:54.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapan Haru mulai ditinggalkan?
Dialogue: 0,0:17:56.61,0:17:59.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak dia menjadi kapten.
Dialogue: 0,0:17:59.20,0:18:00.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keadaannya sudah begini selama ini.
Dialogue: 0,0:18:07.71,0:18:11.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejauh mana kau menyadarinya?
Dialogue: 0,0:18:11.75,0:18:16.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, rekan setimnya\Ntak bisa mengimbangi ritme Haru.
Dialogue: 0,0:18:18.22,0:18:20.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama babak penyisihan Antar-SMA\Nbulan lalu,
Dialogue: 0,0:18:20.76,0:18:24.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami kalah dari SMA Ashi\Ndan para senior resmi pensiun.
Dialogue: 0,0:18:24.60,0:18:28.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sen dan Yo juga bergantian bermain\Ndi pertandingan itu.
Dialogue: 0,0:18:28.73,0:18:32.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka berdua bilang itu karena mereka\Ntak cukup baik sebagai pengganti.
Dialogue: 0,0:18:32.86,0:18:34.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada rapat evaluasi hari itu,
Dialogue: 0,0:18:34.73,0:18:37.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Haru terpilih sebagai kapten baru.
Dialogue: 0,0:18:37.45,0:18:39.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua orang setuju.
Dialogue: 0,0:18:39.74,0:18:42.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, di hari kami melanjutkan latihan,
Dialogue: 0,0:18:42.28,0:18:46.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami mendiskusikan\Napa yang harus diincar tim baru.
Dialogue: 0,0:18:46.12,0:18:47.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua orang juga menyetujuinya.
Dialogue: 0,0:18:48.83,0:18:53.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, Haru merasa itu tak cukup.
Dialogue: 0,0:18:56.21,0:18:57.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nana.
Dialogue: 0,0:18:57.80,0:18:59.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa menurutmu, dengan keadaan kita sekarang,
Dialogue: 0,0:18:59.93,0:19:04.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita bisa bersaing dengan SMA Ashi\Ndan sekolah kuat lainnya tahun depan?
Dialogue: 0,0:19:04.56,0:19:06.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa kita punya potensi.
Dialogue: 0,0:19:06.81,0:19:07.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya saja...
Dialogue: 0,0:19:08.27,0:19:11.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita terlalu lemah, 'kan?
Dialogue: 0,0:19:11.27,0:19:16.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Singkatnya, semua orang\Nterlalu mudah kehilangan kepercayaan diri.
Dialogue: 0,0:19:16.48,0:19:18.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika mereka mendorong diri sedikit lagi,
Dialogue: 0,0:19:18.19,0:19:20.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berlari satu langkah lagi,\Nmelompat sekali lagi,
Dialogue: 0,0:19:20.20,0:19:22.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hasilnya mungkin akan berbeda.
Dialogue: 0,0:19:22.37,0:19:24.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, mereka selalu menyerah sebelum itu.
Dialogue: 0,0:19:24.95,0:19:27.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutmu kenapa?
Dialogue: 0,0:19:27.95,0:19:30.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena mereka takut menganggapnya serius.
Dialogue: 0,0:19:30.58,0:19:32.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa mungkin begitu.
Dialogue: 0,0:19:32.83,0:19:35.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, jika tak menganggapnya serius,
Dialogue: 0,0:19:36.00,0:19:38.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita tak akan pernah tahu batas kita,
Dialogue: 0,0:19:38.38,0:19:42.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apalagi apa yang ada di luar itu,\Ntitik yang mungkin bisa kita terobos.
Dialogue: 0,0:19:42.72,0:19:44.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kita membuat batasan dari awal
Dialogue: 0,0:19:44.60,0:19:46.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan meyakinkan diri, "Mungkin ini batasku,"
Dialogue: 0,0:19:46.60,0:19:50.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita tak akan terluka\Njika usaha terbaik kita gagal.
Dialogue: 0,0:19:50.73,0:19:51.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti begitu.
Dialogue: 0,0:19:52.23,0:19:53.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:19:55.31,0:19:56.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,
Dialogue: 0,0:19:56.86,0:19:59.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan memberi contoh. Akan kutunjukkan
Dialogue: 0,0:20:00.07,0:20:02.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bahwa bersemangat, terlihat menyedihkan,
Dialogue: 0,0:20:02.95,0:20:04.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau menolak menyerah
Dialogue: 0,0:20:04.74,0:20:07.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bukanlah hal yang memalukan.
Dialogue: 0,0:20:11.04,0:20:13.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menyalakan api di hati semua orang.
Dialogue: 0,0:20:13.29,0:20:14.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama seperti dia.
Dialogue: 0,0:20:14.75,0:20:15.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar?
Dialogue: 0,0:20:18.75,0:20:20.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama latihan,\Naku akan mendorong semua orang.
Dialogue: 0,0:20:20.55,0:20:23.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika ada yang malas,\Naku akan memarahi mereka tanpa ampun.
Dialogue: 0,0:20:24.84,0:20:30.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai balasannya, aku akan berusaha\Nlebih keras daripada siapa pun,
Dialogue: 0,0:20:30.27,0:20:31.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menggertakkan gigi, dan terus maju.
Dialogue: 0,0:20:35.90,0:20:39.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, apa kau bisa mendukung semua orang\Ndi balik layar?
Dialogue: 0,0:20:39.94,0:20:43.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengarkan mereka saat mereka berkecil hati\Natau mengeluh tentang aku.
Dialogue: 0,0:20:43.36,0:20:44.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudmu...
Dialogue: 0,0:20:44.78,0:20:48.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti Umi yang galak dan Nana yang baik.
Dialogue: 0,0:20:49.03,0:20:53.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai balasannya, tahun depan,\Nkita akan mencapai puncak.
Dialogue: 0,0:20:53.62,0:20:55.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, kita semua akan tersenyum bersama.
Dialogue: 0,0:20:59.50,0:21:01.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa dia sudah mencapai batasnya.
Dialogue: 0,0:21:02.05,0:21:04.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semangat Umi mulai menjadi bumerang.
Dialogue: 0,0:21:05.59,0:21:11.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial, gadis keras kepala itu.\NKenapa aku tidak menyadarinya lebih awal?
Dialogue: 0,0:21:13.31,0:21:15.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa tidak mengatakan yang sebenarnya?
Dialogue: 0,0:21:15.73,0:21:18.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja aku sudah membahasnya dengan Umi.
Dialogue: 0,0:21:18.31,0:21:22.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, ujung-ujungnya\Nkami selalu terbawa arus.
Dialogue: 0,0:21:22.36,0:21:25.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau kami menjadi rekan tim\Nyang bisa mengutarakan pikiran
Dialogue: 0,0:21:25.40,0:21:28.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan mencapai ketinggian baru bersama.
Dialogue: 0,0:21:31.54,0:21:34.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya kami memujinya suatu hari nanti.
Dialogue: 0,0:21:34.37,0:21:37.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Umi tak pernah mengeluh kepadamu, bukan?
Dialogue: 0,0:21:38.25,0:21:40.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangankan mengeluh...
Dialogue: 0,0:21:40.59,0:21:43.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan saat mengalami itu,
Dialogue: 0,0:21:43.59,0:21:47.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia masih mau mendengar rengekanku?
Dialogue: 0,0:21:48.01,0:21:52.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika terus begini, tim bisa hancur besok.
Dialogue: 0,0:21:52.31,0:21:56.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, aku punya peran\Nyang dia percayakan kepadaku.
Dialogue: 0,0:21:56.89,0:21:58.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, saat waktunya tiba,
Dialogue: 0,0:21:59.81,0:22:02.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku mengandalkanmu untuk menjaga Umi.
Dialogue: 0,0:23:37.49,0:23:39.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Nyalakan Api di Hatimu".
