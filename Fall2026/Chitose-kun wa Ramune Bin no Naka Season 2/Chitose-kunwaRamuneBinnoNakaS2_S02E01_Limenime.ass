Dialogue: 0,0:00:05.79,0:00:08.30,sign,,0000,0000,0000,,"TIKET SHINKANSEN, MAIBARA KE TOKYO"
Dialogue: 0,0:01:36.26,0:01:45.14,sign,,0000,0000,0000,,CHITOSE IS IN THE RAMUNE BOTTLE
Dialogue: 0,0:02:42.53,0:02:44.45,sign,,0000,0000,0000,,JALUR SHINKANSEN
Dialogue: 0,0:03:54.27,0:03:56.82,sign,,0000,0000,0000,,"UNIVERSITAS WASEDA, KARTU UJIAN MASUK"
Dialogue: 0,0:05:24.95,0:05:27.11,sign,,0000,0000,0000,,STASIUN TAKADANOBABA
Dialogue: 0,0:05:32.16,0:05:34.50,sign,,0000,0000,0000,,KEDAI YAKINIKU RYORYO ARANG\NKEDAI PACHINKO KOPI SORANO
Dialogue: 0,0:05:38.88,0:05:40.79,sign,,0000,0000,0000,,"TOKO PAKAIAN BEKAS MARUMI"
Dialogue: 0,0:09:29.11,0:09:32.90,sign,,0000,0000,0000,,"LOTRE"
Dialogue: 0,0:09:33.53,0:09:35.28,sign,,0000,0000,0000,,"SHOGAKUKAN"
Dialogue: 0,0:09:35.36,0:09:36.53,sign,,0000,0000,0000,,"TOKO BUKU BEKAS KANDA"
Dialogue: 0,0:09:36.61,0:09:37.45,sign,,0000,0000,0000,,TOKO BUKU BEKAS BONDY, LANTAI DUA
Dialogue: 0,0:15:26.05,0:15:28.22,sign,,0000,0000,0000,,STASIUN SHINJUKU
Dialogue: 0,0:15:28.30,0:15:30.80,sign,,0000,0000,0000,,GEDUNG KUNIYA
Dialogue: 0,0:16:38.74,0:16:40.20,sign,,0000,0000,0000,,PANGGILAN MASUK, KURA
Dialogue: 0,0:19:39.76,0:19:41.05,sign,,0000,0000,0000,,"KARAOKE"
Dialogue: 0,0:19:44.64,0:19:46.47,sign,,0000,0000,0000,,KABUKICHO ICHIBANGAI
Dialogue: 0,0:23:39.67,0:23:40.18,sign,,0000,0000,0000,,SELANJUTNYA: MENGENANG MALAM MASA MUDA\NDI BAWAH LANGIT YANG JAUH
Dialogue: 0,0:00:01.00,0:00:03.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fukui. Fukui.
Dialogue: 0,0:00:03.29,0:00:05.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah bepergian bersama kami.
Dialogue: 0,0:00:05.79,0:00:08.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan transit di sini untuk Jalur Kuzuryu.
Dialogue: 0,0:00:08.38,0:00:10.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perhatian.
Dialogue: 0,0:00:10.71,0:00:13.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penumpang tanpa reservasi dimohon\Ntidak naik melalui gerbong kursi reservasi
Dialogue: 0,0:00:13.30,0:00:15.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu pindah ke gerbong bebas,
Dialogue: 0,0:00:15.51,0:00:19.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena dapat mengganggu penumpang\Nyang sedang antre.
Dialogue: 0,0:02:07.58,0:02:09.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat warnanya akhirnya memudar,
Dialogue: 0,0:02:09.78,0:02:13.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akankah aku mengenang momen ini\Ndengan kerinduan?
Dialogue: 0,0:02:14.21,0:02:17.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak-tuk, tak-tuk.\NKereta bergoyang-goyang,
Dialogue: 0,0:02:18.59,0:02:22.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}membawa dua orang dan impian mereka\Nke kota yang jauh.
Dialogue: 0,0:02:24.60,0:02:26.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maibara. Maibara.
Dialogue: 0,0:02:26.31,0:02:29.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pastikan tidak ada barang bawaan Anda\Nyang tertinggal.
Dialogue: 0,0:02:29.19,0:02:32.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perhatikan langkah Anda\Nsaat naik dan turun kereta.
Dialogue: 0,0:02:32.31,0:02:34.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penumpang kereta\Nwajib memiliki tiket penumpang
Dialogue: 0,0:02:34.73,0:02:36.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan tiket ekspres.
Dialogue: 0,0:02:36.19,0:02:38.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Asu, cepat bangun.
Dialogue: 0,0:02:39.07,0:02:40.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satsukigase?
Dialogue: 0,0:02:40.53,0:02:42.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan kue khas Fukui.
Dialogue: 0,0:02:54.00,0:02:57.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tu-Tunggu!
Dialogue: 0,0:02:58.55,0:03:01.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Asu, kau sudah memberi tahu orang tuamu?
Dialogue: 0,0:03:02.39,0:03:06.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku meninggalkan pesan\Nbahwa aku akan pergi ke Tokyo.
Dialogue: 0,0:03:06.35,0:03:08.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Juga bahwa aku baru pulang besok.
Dialogue: 0,0:03:08.52,0:03:11.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awalnya aku berencana melakukan\Nperjalanan sehari, tapi...
Dialogue: 0,0:03:12.77,0:03:14.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf karena aku sangat ceroboh.
Dialogue: 0,0:03:16.15,0:03:19.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau hanya menangkap sinyal SOS-ku.
Dialogue: 0,0:03:20.24,0:03:21.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, 'kan?
Dialogue: 0,0:03:21.57,0:03:23.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya itu yang bisa kulakukan.
Dialogue: 0,0:03:26.20,0:03:27.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:03:27.91,0:03:30.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Jati diri" yang kau ajarkan kepadaku,
Dialogue: 0,0:03:30.58,0:03:32.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kali ini akan kucari sendiri.
Dialogue: 0,0:03:34.38,0:03:36.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Udara di sini terasa agak tipis.
Dialogue: 0,0:03:36.88,0:03:40.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Segala macam aroma terjalin dan bercampur.
Dialogue: 0,0:03:42.89,0:03:46.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mulai mengerti\Nkenapa ayahmu sangat khawatir.
Dialogue: 0,0:03:49.93,0:03:52.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, selanjutnya apa?
Dialogue: 0,0:03:52.60,0:03:53.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu...
Dialogue: 0,0:03:54.27,0:03:56.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau mendaftar ke sini.
Dialogue: 0,0:03:58.07,0:04:00.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pintu akan ditutup. Harap berhati-hati.
Dialogue: 0,0:04:05.82,0:04:10.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Asu mungkin akan tinggal\Ndi kota seperti ini.
Dialogue: 0,0:04:15.83,0:04:19.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seolah aku menggenggam\Nsesuatu yang berharga,
Dialogue: 0,0:04:20.01,0:04:22.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berdoa dia tak akan pergi jauh.
Dialogue: 0,0:04:23.01,0:04:25.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan erat, aku menariknya lebih dekat.
Dialogue: 0,0:04:27.35,0:04:29.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf. Haruskah kulepaskan?
Dialogue: 0,0:04:29.77,0:04:31.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari tetap seperti ini.
Dialogue: 0,0:04:31.85,0:04:33.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:04:34.48,0:04:36.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin tetap seperti ini.
Dialogue: 0,0:04:37.94,0:04:41.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang kalau kau terus mendekapku begini.
Dialogue: 0,0:04:43.32,0:04:45.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat ke luar.
Dialogue: 0,0:04:48.24,0:04:50.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tokyo membentang tanpa ujung di luar jendela.
Dialogue: 0,0:04:50.66,0:04:53.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimanapun aku melihatnya,\Nrasanya tidak nyata.
Dialogue: 0,0:04:53.66,0:04:57.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya tidak lebih\Ndari kota miniatur yang indah.
Dialogue: 0,0:04:57.88,0:05:01.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa aku agak bersemangat.
Dialogue: 0,0:05:07.30,0:05:09.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa aku mengerti.
Dialogue: 0,0:05:10.47,0:05:11.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di kota ini,
Dialogue: 0,0:05:11.85,0:05:15.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pasti ada banyak hal\Nyang tak bisa dialami di Fukui.
Dialogue: 0,0:05:16.77,0:05:19.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat perjalanan singkat ini berakhir,
Dialogue: 0,0:05:20.07,0:05:24.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia pasti akan memutuskan\Nuntuk tinggal di kota ini.
Dialogue: 0,0:05:28.41,0:05:32.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari sini, kita tinggal lurus saja\Nmenyusuri jalan utama ini.
Dialogue: 0,0:05:34.75,0:05:36.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita makan siang apa?
Dialogue: 0,0:05:38.88,0:05:40.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada toko unik di sana.
Dialogue: 0,0:05:41.38,0:05:42.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau melihatnya?
Dialogue: 0,0:05:53.89,0:05:55.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana penampilanku?
Dialogue: 0,0:05:58.60,0:06:01.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti Ingrid Bergman di Casablanca.
Dialogue: 0,0:06:02.36,0:06:04.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu artinya aku terlihat tua?
Dialogue: 0,0:06:04.19,0:06:07.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudku, berpakaian begitu,\Nkau bahkan bisa tampil di film hitam putih.
Dialogue: 0,0:06:08.45,0:06:09.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pakailah itu lain kali.
Dialogue: 0,0:06:09.95,0:06:12.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita berkencan dengan lebih elegan, ya.
Dialogue: 0,0:06:14.37,0:06:15.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan senang hati.
Dialogue: 0,0:06:16.66,0:06:20.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,\Ngiliranku memilih pakaian untukmu.
Dialogue: 0,0:06:20.50,0:06:22.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau kita\Nsaling membelikan hadiah?
Dialogue: 0,0:06:23.09,0:06:26.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak mau.\NPakaian modis tidak cocok untukku.
Dialogue: 0,0:06:26.34,0:06:28.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan kepada Kakak.
Dialogue: 0,0:06:28.59,0:06:31.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan mengubahmu menjadi Humphrey Bogart.
Dialogue: 0,0:06:31.26,0:06:32.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudmu?
Dialogue: 0,0:06:33.06,0:06:36.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiruan pria sok keren yang ketinggalan zaman.
Dialogue: 0,0:06:36.23,0:06:38.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan itu?
Dialogue: 0,0:06:45.65,0:06:48.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suasananya lebih santai daripada dugaanku.
Dialogue: 0,0:06:48.82,0:06:53.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kini aku bisa membayangkan diriku\Nkuliah di sini.
Dialogue: 0,0:07:05.84,0:07:07.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bayangkan saja.
Dialogue: 0,0:07:07.63,0:07:09.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita berdua mahasiswa.
Dialogue: 0,0:07:09.47,0:07:12.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan memakai gaun\Nyang kau belikan untukku
Dialogue: 0,0:07:13.26,0:07:16.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan kau akan memakai kemeja\Nyang kubelikan untukmu.
Dialogue: 0,0:07:17.56,0:07:19.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Haruskah aku mengecat rambutku?
Dialogue: 0,0:07:20.19,0:07:21.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu agak sulit dibayangkan.
Dialogue: 0,0:07:22.52,0:07:25.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutku kau tampak cantik apa adanya.
Dialogue: 0,0:07:34.45,0:07:36.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin kau juga akan\Nmasuk Fakultas Sastra.
Dialogue: 0,0:07:37.29,0:07:40.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akan memilih mata kuliah bersama.
Dialogue: 0,0:07:41.83,0:07:43.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, kita harus memilih circle.
Dialogue: 0,0:07:44.38,0:07:47.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak bisa membiarkanmu sendirian,
Dialogue: 0,0:07:47.55,0:07:49.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi, kau akan bergabung\Ndengan circle yang sama denganku.
Dialogue: 0,0:07:49.80,0:07:52.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Supaya tidak ada yang gampang merayumu\Ndi acara minum-minum.
Dialogue: 0,0:07:53.01,0:07:55.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak senaif itu!
Dialogue: 0,0:07:59.39,0:08:02.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Andai aku bisa bekerja paruh waktu\Ndi perusahaan penerbitan.
Dialogue: 0,0:08:02.94,0:08:05.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang harus kita lakukan saat libur?
Dialogue: 0,0:08:05.77,0:08:08.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari berjalan-jalan seperti tadi.
Dialogue: 0,0:08:08.98,0:08:13.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau kita bisa mencoba\Nmemasak resep baru di dapur kecil.
Dialogue: 0,0:08:13.28,0:08:16.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal itu, aku sudah biasa masak.
Dialogue: 0,0:08:16.20,0:08:18.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin aku akan mulai dengan nikujaga.
Dialogue: 0,0:08:18.37,0:08:20.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan pura-pura tak mendengarku.
Dialogue: 0,0:08:20.91,0:08:21.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun,
Dialogue: 0,0:08:23.12,0:08:25.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}masa depan seperti itu tak akan datang.
Dialogue: 0,0:08:26.21,0:08:28.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kau seniorku dan aku adik kelasmu.
Dialogue: 0,0:08:35.29,0:08:38.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekalipun aku memilih universitas yang sama,
Dialogue: 0,0:08:38.67,0:08:41.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}saat itu, Kak Asu,\Nkau pasti sudah bekerja keras,
Dialogue: 0,0:08:41.73,0:08:44.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}belajar sastra\Ndan bekerja paruh waktu di penerbitan.
Dialogue: 0,0:08:44.14,0:08:47.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau akan punya teman baru dari circle-mu
Dialogue: 0,0:08:47.94,0:08:50.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan menjadi ahli membuat nikujaga.
Dialogue: 0,0:08:51.78,0:08:55.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bahkan mungkin punya pacar.
Dialogue: 0,0:08:56.70,0:08:59.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita sungguh terpisah jauh.
Dialogue: 0,0:08:59.66,0:09:02.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jarak kita sangat jauh.
Dialogue: 0,0:09:03.66,0:09:05.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski kita sangat dekat sekarang.
Dialogue: 0,0:09:07.17,0:09:11.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagi anak SMA seperti kita,\Nsatu tahun itu terlalu lama.
Dialogue: 0,0:09:12.09,0:09:16.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam waktu itu,\Nbanyak hal yang akan berubah.
Dialogue: 0,0:09:16.34,0:09:18.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya akan berubah\Nhingga tak dikenali lagi.
Dialogue: 0,0:09:19.85,0:09:23.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, kita tetap harus terus berlari maju.
Dialogue: 0,0:09:23.77,0:09:25.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika tidak,\Naku tak akan pernah bisa menyusulnya.
Dialogue: 0,0:09:29.11,0:09:32.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Asu bilang dia mau ke Jinbocho.
Dialogue: 0,0:09:33.53,0:09:35.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar ada banyak penerbit
Dialogue: 0,0:09:35.36,0:09:36.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan toko buku di sana.
Dialogue: 0,0:09:46.92,0:09:48.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa kita boleh memakannya sesuka kita.
Dialogue: 0,0:09:52.80,0:09:54.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lezat!
Dialogue: 0,0:09:57.84,0:09:59.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk apa itu?
Dialogue: 0,0:10:00.05,0:10:04.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini yang namanya disuapi.
Dialogue: 0,0:10:04.31,0:10:07.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau terdengar\Nseperti bicara dengan bangsawan?
Dialogue: 0,0:10:16.07,0:10:19.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu enak sekali. Ayamnya sangat renyah.
Dialogue: 0,0:10:20.32,0:10:21.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan begitu caranya.
Dialogue: 0,0:10:22.08,0:10:23.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat, kau harus melakukannya seperti ini.
Dialogue: 0,0:10:31.17,0:10:33.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat berikan kepadaku.
Dialogue: 0,0:10:47.31,0:10:48.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu enak sekali!
Dialogue: 0,0:10:53.36,0:10:55.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah berapa kali ini ditolak?
Dialogue: 0,0:10:55.90,0:10:59.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk karya ini, aku juga mempelajari\Nmahakarya masa lalu dan tren saat ini.
Dialogue: 0,0:11:00.70,0:11:04.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, ada banyak novel anak muda\Nyang mirip di luar sana.
Dialogue: 0,0:11:06.25,0:11:10.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beberapa penulis memanfaatkan tren pasar\Ndan terus menghasilkan buku terlaris.
Dialogue: 0,0:11:10.75,0:11:14.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, kau bukan tipe yang fleksibel, bukan?
Dialogue: 0,0:11:20.26,0:11:22.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak bisa menulis apa pun.
Dialogue: 0,0:11:23.89,0:11:27.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karya perdanaku kebetulan tentang\Npekerjaan unik yang kumiliki saat itu.
Dialogue: 0,0:11:27.47,0:11:29.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu menjadi populer karena subjeknya langka.
Dialogue: 0,0:11:30.52,0:11:33.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, hidupku cukup membosankan.
Dialogue: 0,0:11:34.36,0:11:38.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak cocok menjadi penulis.
Dialogue: 0,0:11:39.99,0:11:43.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong jangan memutuskan batasanmu\Ntanpa bicara dengan editormu dahulu.
Dialogue: 0,0:11:45.08,0:11:46.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaliknya, kurasa bakatmu adalah
Dialogue: 0,0:11:46.99,0:11:50.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menggunakan sensibilitas unikmu\Nuntuk membedah kehidupan sehari-hari
Dialogue: 0,0:11:50.25,0:11:53.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan mengubahnya menjadi prosa yang menggugah.
Dialogue: 0,0:11:54.13,0:11:56.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sebabnya proposal ini tak akan berhasil.
Dialogue: 0,0:11:56.50,0:11:58.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, tulis saja sendiri...
Dialogue: 0,0:12:03.01,0:12:07.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau kau ceritakan\Nkehidupanmu yang membosankan itu?
Dialogue: 0,0:12:17.32,0:12:20.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini pemandangan yang luar biasa.
Dialogue: 0,0:12:20.99,0:12:23.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengalaman yang dia bagi sangat biasa.
Dialogue: 0,0:12:24.03,0:12:29.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, seiring editornya\Nyang terus mengangguk dan bertanya,
Dialogue: 0,0:12:29.77,0:12:32.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sang penulis makin larut dalam percakapan.
Dialogue: 0,0:12:33.12,0:12:36.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasa sakit, kesulitan, kesedihan.
Dialogue: 0,0:12:37.46,0:12:40.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, tanpa kusadari,
Dialogue: 0,0:12:40.55,0:12:44.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}itu menjadi cerita yang unik.
Dialogue: 0,0:12:49.43,0:12:53.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu cerita yang seharusnya kau tulis.
Dialogue: 0,0:12:56.02,0:12:58.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak percaya diri.
Dialogue: 0,0:12:59.44,0:13:01.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisakah kata-kata orang\Ntak penting sepertiku,
Dialogue: 0,0:13:01.69,0:13:04.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kisah biasa seperti itu,
Dialogue: 0,0:13:04.11,0:13:06.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sungguh sampai ke seseorang di luar sana
Dialogue: 0,0:13:06.62,0:13:09.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang menderita sepertiku?
Dialogue: 0,0:13:10.29,0:13:15.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisakah itu membawa hidup seperti itu\Nsedikit lebih dekat dengan cahaya?
Dialogue: 0,0:13:18.25,0:13:21.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau mencurahkan seluruh hatimu\Nuntuk menulisnya, itu pasti bisa.
Dialogue: 0,0:13:22.09,0:13:26.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak bisa menulis cerita brilian sendiri,
Dialogue: 0,0:13:26.64,0:13:29.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku bisa menemukannya\Ndan menyampaikannya.
Dialogue: 0,0:13:30.01,0:13:31.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena aku editor.
Dialogue: 0,0:13:37.27,0:13:38.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan mencoba menulisnya.
Dialogue: 0,0:13:38.98,0:13:41.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan khawatir. Aku percaya kata-katamu.
Dialogue: 0,0:13:41.94,0:13:44.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kumohon, percayalah kepadaku.
Dialogue: 0,0:13:46.24,0:13:48.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi itu luar biasa.
Dialogue: 0,0:13:49.37,0:13:50.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu hampir terlalu sempurna.
Dialogue: 0,0:13:50.98,0:13:52.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana menurutmu?
Dialogue: 0,0:13:52.37,0:13:55.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dulu aku berpikir tugas editor\Nlebih kepada melindungi penulis
Dialogue: 0,0:13:55.46,0:13:57.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan mendukung mereka di balik layar.
Dialogue: 0,0:13:58.54,0:14:01.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, untuk mengungkap kisah\Nyang belum diceritakan
Dialogue: 0,0:14:01.75,0:14:03.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan menyerahkannya kepada seseorang,
Dialogue: 0,0:14:03.88,0:14:06.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mereka berdua sungguh-sungguh dan tulus.
Dialogue: 0,0:14:06.84,0:14:09.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penuh semangat dan sangat tulus.
Dialogue: 0,0:14:09.80,0:14:13.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak tahu mereka berdedikasi sedalam itu.
Dialogue: 0,0:14:17.35,0:14:21.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, bukan hanya aku\Nyang sangat mencintai semua ini.
Dialogue: 0,0:14:24.32,0:14:27.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pasti sangat gelisah.
Dialogue: 0,0:14:27.74,0:14:29.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tinggal di pedesaan seperti Fukui,
Dialogue: 0,0:14:29.95,0:14:32.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bermimpi menjadi editor,
Dialogue: 0,0:14:33.08,0:14:36.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi tak bisa menemukan orang\Nyang bisa terhubung dengannya.
Dialogue: 0,0:14:37.37,0:14:40.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang, untuk kali pertama,\Ndia menemukan teman yang sepaham.
Dialogue: 0,0:14:41.17,0:14:43.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Impian yang dahulu samar dan buram
Dialogue: 0,0:14:43.63,0:14:45.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akhirnya terhubung dengan kenyataan.
Dialogue: 0,0:14:48.88,0:14:50.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata aku
Dialogue: 0,0:14:51.35,0:14:53.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}masih mau menjadi editor.
Dialogue: 0,0:14:53.76,0:14:58.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah kenapa, saat itu aku bisa\Nmelihat Kak Asu di kota ini,
Dialogue: 0,0:14:58.56,0:15:01.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bertengkar hebat dengan penulis\Nyang keras kepala.
Dialogue: 0,0:15:02.36,0:15:04.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rambutnya sedikit lebih panjang\Ndaripada sekarang
Dialogue: 0,0:15:05.07,0:15:07.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan dia memakai celana\Nagar lebih mudah bergerak.
Dialogue: 0,0:15:08.11,0:15:09.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti di kedai kari tadi,
Dialogue: 0,0:15:09.55,0:15:12.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi dia jauh lebih bersemangat\Ndaripada editor itu
Dialogue: 0,0:15:12.53,0:15:15.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dalam menyuarakan pendapatnya.
Dialogue: 0,0:15:16.79,0:15:20.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, diam-diam di hatiku,
Dialogue: 0,0:15:21.12,0:15:24.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku mulai bersiap untuk berpamitan dengannya.
Dialogue: 0,0:15:31.47,0:15:35.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berikutnya, aku mau melihat Kabukicho\Nyang sering kudengar.
Dialogue: 0,0:15:36.06,0:15:39.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, sudah hampir waktunya pergi\Nke Stasiun Tokyo.
Dialogue: 0,0:15:39.23,0:15:41.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika tidak,\Nkita akan ketinggalan Shinkansen terakhir.
Dialogue: 0,0:15:41.48,0:15:42.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah sudah kubilang?
Dialogue: 0,0:15:43.52,0:15:46.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku meninggalkan pesan\Nbahwa aku akan kembali besok.
Dialogue: 0,0:15:46.57,0:15:48.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang tuamu sudah menghubungimu?
Dialogue: 0,0:15:48.50,0:15:49.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum.
Dialogue: 0,0:15:49.86,0:15:51.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu...
Dialogue: 0,0:15:51.86,0:15:54.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita sudah datang jauh-jauh ke Tokyo.
Dialogue: 0,0:15:54.95,0:15:56.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula,
Dialogue: 0,0:15:56.58,0:16:00.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ini mungkin perjalanan kita bersama\Nyang pertama dan terakhir.
Dialogue: 0,0:16:01.33,0:16:05.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bilang begitu dengan ekspresi itu.\NAku tak akan tega menolak.
Dialogue: 0,0:16:06.09,0:16:08.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau tetap di mimpi ini\Nsedikit lebih lama,
Dialogue: 0,0:16:09.17,0:16:11.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bepergian bersamamu seperti ini,
Dialogue: 0,0:16:11.38,0:16:14.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hal yang tak pernah bisa terjadi\Nsaat karyawisata atau darmawisata.
Dialogue: 0,0:16:15.68,0:16:17.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:16:17.35,0:16:19.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, aku yang mengajakmu kabur.
Dialogue: 0,0:16:20.64,0:16:22.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu baru semangat!
Dialogue: 0,0:16:53.68,0:16:54.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo?
Dialogue: 0,0:16:54.93,0:16:57.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chitose, permainan berakhir.
Dialogue: 0,0:16:57.93,0:17:00.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa berpura-pura bodoh\Ndan menanyakan maksudmu.
Dialogue: 0,0:17:01.02,0:17:03.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutmu itu akan berhasil?
Dialogue: 0,0:17:03.69,0:17:04.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat, Nishi.
Dialogue: 0,0:17:04.90,0:17:06.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya aku berhasil meneleponnya.
Dialogue: 0,0:17:06.90,0:17:08.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudmu "akhirnya"?
Dialogue: 0,0:17:08.44,0:17:12.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini kali pertama Kura meneleponku hari ini.
Dialogue: 0,0:17:12.60,0:17:15.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mungkin menghabiskan waktu seharian\Nuntuk menahan diri,
Dialogue: 0,0:17:15.81,0:17:17.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mengulur waktu sampai selarut ini.
Dialogue: 0,0:17:17.78,0:17:20.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo, ini ayah Asuka.
Dialogue: 0,0:17:21.11,0:17:23.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa tolong berikan teleponnya pada putriku?
Dialogue: 0,0:17:30.46,0:17:34.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika tak bisa hidup dengan indah,\Nsama saja dengan mati.
Dialogue: 0,0:17:35.72,0:17:37.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, 'kan?
Dialogue: 0,0:17:37.39,0:17:40.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar tiruan pria sok keren\Nyang ketinggalan zaman.
Dialogue: 0,0:17:41.18,0:17:44.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya sedang berkencan\Ndengan gadis manis di Tokyo.
Dialogue: 0,0:17:44.89,0:17:47.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar aku bicara dengan teman kencanmu.
Dialogue: 0,0:17:47.48,0:17:50.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu mendengar "gadis manis",\NAnda berasumsi itu putri Anda.
Dialogue: 0,0:17:50.77,0:17:52.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pak Nishino, apa Anda termasuk\Nayah yang terlalu protektif?
Dialogue: 0,0:17:53.78,0:17:56.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sungguh orang yang menarik.
Dialogue: 0,0:17:57.41,0:17:59.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mengingatkanku pada Kura dahulu.
Dialogue: 0,0:18:00.28,0:18:04.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lantas?\NKau berencana terus berdebat denganku?
Dialogue: 0,0:18:08.00,0:18:12.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shirasagi tiba di Fukui besok siang.
Dialogue: 0,0:18:12.21,0:18:13.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu saja di gerbang tiket
Dialogue: 0,0:18:14.05,0:18:16.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan Anda akan tahu jawabannya.
Dialogue: 0,0:18:16.30,0:18:18.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika Asuka tak ada di sana,
Dialogue: 0,0:18:18.43,0:18:21.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan melaporkan kehilangannya\Nkepada polisi.
Dialogue: 0,0:18:23.68,0:18:26.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seandainya pun saya bersama Asuka,
Dialogue: 0,0:18:26.85,0:18:30.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan sulit untuk menemukan kami\Ndalam semalam, bukan?
Dialogue: 0,0:18:30.98,0:18:33.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah kami kembali ke Fukui,
Dialogue: 0,0:18:33.28,0:18:37.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}saya yakin Asuka akan bilang ke polisi\Nbahwa dia kabur sendiri.
Dialogue: 0,0:18:41.33,0:18:45.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shirasagi tiba besok siang, bukan?
Dialogue: 0,0:18:45.12,0:18:46.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:18:46.16,0:18:50.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya aku harus bicara panjang denganmu.
Dialogue: 0,0:18:50.75,0:18:53.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisakah saya meminta maaf\Ndengan membawakan Tokyo Banana?
Dialogue: 0,0:18:54.17,0:18:56.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benci pisang.
Dialogue: 0,0:19:04.56,0:19:08.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf. Sepertinya menikahimu akan sulit.
Dialogue: 0,0:19:10.15,0:19:13.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa ayahmu sungguh membenciku.
Dialogue: 0,0:19:13.23,0:19:14.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi...
Dialogue: 0,0:19:14.34,0:19:16.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu kita hanya sampai besok pagi.
Dialogue: 0,0:19:17.65,0:19:20.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan lupa menyalakan ponselmu.
Dialogue: 0,0:19:27.29,0:19:30.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jalanan Shinjuku yang biasanya ramai
Dialogue: 0,0:19:31.17,0:19:34.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berkilau di bawah lampu neon warna-warni.
Dialogue: 0,0:19:34.59,0:19:38.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seolah aku melangkah masuk ke dalam mimpi.
Dialogue: 0,0:19:39.76,0:19:41.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini kali pertama
Dialogue: 0,0:19:41.13,0:19:43.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku menganggap Tokyo indah.
Dialogue: 0,0:19:48.93,0:19:50.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luar biasa.
Dialogue: 0,0:19:50.69,0:19:52.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jalanannya terasa hidup.
Dialogue: 0,0:19:52.94,0:19:56.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hampir bisa mendengar detak jantungnya.
Dialogue: 0,0:19:57.94,0:20:00.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin ini terasa kurang berkesan\Nuntuk akhir perjalanan,
Dialogue: 0,0:20:00.70,0:20:02.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi haruskah kita membeli makan malam\Nuntuk dimakan di hotel?
Dialogue: 0,0:20:03.03,0:20:04.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa titip kepadamu?
Dialogue: 0,0:20:04.95,0:20:07.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau menikmati suasananya\Nsedikit lebih lama.
Dialogue: 0,0:20:07.91,0:20:09.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:20:17.71,0:20:18.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa salahnya?
Dialogue: 0,0:20:19.30,0:20:21.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pasti akan laris manis.
Dialogue: 0,0:20:21.13,0:20:23.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak mau pergi. Lepaskan aku!
Dialogue: 0,0:20:28.72,0:20:29.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat.
Dialogue: 0,0:20:30.39,0:20:31.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Asu!
Dialogue: 0,0:20:31.77,0:20:33.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh!
Dialogue: 0,0:20:33.23,0:20:35.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurang ajar, Bocah!
Dialogue: 0,0:20:50.12,0:20:52.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu! Ke sini!
Dialogue: 0,0:20:59.00,0:21:00.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku.
Dialogue: 0,0:21:00.63,0:21:04.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bilang, "Permisi,"\Njadi kupikir dia mau tanya jalan.
Dialogue: 0,0:21:05.55,0:21:09.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata dia menawariku masuk\Nke industri hiburan dewasa.
Dialogue: 0,0:21:09.52,0:21:12.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akulah yang harus meminta maaf.\NAku kehilangan kesabaran.
Dialogue: 0,0:21:13.81,0:21:18.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak menyangka kau bisa semarah itu\Nuntuk membelaku.
Dialogue: 0,0:21:19.07,0:21:20.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja.
Dialogue: 0,0:21:20.98,0:21:22.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong...
Dialogue: 0,0:21:22.74,0:21:25.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Asu, apa ini cinta...
Dialogue: 0,0:21:25.11,0:21:26.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan katakan itu.
Dialogue: 0,0:21:26.95,0:21:28.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau mengatakannya,\Naku tak akan bisa tetap di sini.
Dialogue: 0,0:21:30.45,0:21:33.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pria itu mungkin masih berkeliaran.
Dialogue: 0,0:21:34.16,0:21:36.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetap di sini adalah pilihan yang tepat.
Dialogue: 0,0:21:37.79,0:21:38.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun...
Dialogue: 0,0:21:39.84,0:21:42.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa terus menyusahkanmu\Nkarena sifat naifku,
Dialogue: 0,0:21:43.05,0:21:46.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau menempatkanmu dalam bahaya.
Dialogue: 0,0:21:48.43,0:21:51.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Asu, aku tak akan menyakitimu.
Dialogue: 0,0:21:52.68,0:21:53.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga.
Dialogue: 0,0:21:59.06,0:22:00.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu.
Dialogue: 0,0:22:00.57,0:22:03.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bersamamu,\Naku tak keberatan meski itu sebuah kesalahan.
Dialogue: 0,0:23:35.95,0:23:39.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Mengenang Malam Masa Muda\Ndi Bawah Langit yang Jauh."
