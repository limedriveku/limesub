Dialogue: 0,0:00:02.96,0:00:05.71,sign,,0000,0000,0000,,ISTIRAHAT 5.200, 6.200, 6.300 YEN,\NMENGINAP 8.800, 8.800, 8.900 YEN
Dialogue: 0,0:02:05.29,0:02:14.17,sign,,0000,0000,0000,,CHITOSE IS IN THE RAMUNE BOTTLE
Dialogue: 0,0:03:20.99,0:03:22.66,sign,,0000,0000,0000,,KURA: JANGAN LUPA PAKAI KONDOM
Dialogue: 0,0:20:11.50,0:20:13.33,sign,,0000,0000,0000,,KERAJAAN DINOSAURUS SELAMAT DATANG DI FUKUI
Dialogue: 0,0:20:13.42,0:20:15.42,sign,,0000,0000,0000,,KERAJAAN DINOSAURUS, FUKUI
Dialogue: 0,0:23:37.79,0:23:40.00,sign,,0000,0000,0000,,"EPISODE SELANJUTNYA, ANGIN HARI ESOK"
Dialogue: 0,0:00:29.07,0:00:33.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat! Kamar mandinya berkilau! Ayo...
Dialogue: 0,0:00:33.20,0:00:35.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bisa masuk bersama, 'kan?
Dialogue: 0,0:00:35.24,0:00:39.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau saling menggosok punggung?\NMau membuat ubur-ubur dengan handuk?
Dialogue: 0,0:00:41.12,0:00:45.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari tekan tombol air panasnya bersama.
Dialogue: 0,0:00:47.21,0:00:51.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mengerti, tapi aku akan ikut saja.
Dialogue: 0,0:02:27.64,0:02:29.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Asu, kau boleh mandi lebih dulu.
Dialogue: 0,0:02:29.77,0:02:31.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau yakin?
Dialogue: 0,0:02:31.15,0:02:33.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, kuterima tawaranmu.
Dialogue: 0,0:02:42.49,0:02:46.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya, hari ini banyak sekali\Nhal yang tidak biasa.
Dialogue: 0,0:02:46.37,0:02:49.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak tetap waspada,\Nrasanya aku bisa kebablasan.
Dialogue: 0,0:02:51.29,0:02:54.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini hari yang singkat, tapi melelahkan.
Dialogue: 0,0:02:54.09,0:02:56.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah cukup sadar memandang\NKak Asu sebagai seorang wanita,
Dialogue: 0,0:02:56.76,0:03:02.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebagai seseorang yang bisa\Nmembangkitkan hasratku.
Dialogue: 0,0:03:24.07,0:03:26.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kubunuh kau, Berengsek!
Dialogue: 0,0:03:42.55,0:03:43.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Giliranmu mandi.
Dialogue: 0,0:03:44.51,0:03:48.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Asu, jangan bergerak.\NBajumu bisa terbuka.
Dialogue: 0,0:03:50.48,0:03:51.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:03:54.40,0:03:57.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Asu, tolong. Ganti pakaianmu di sini.
Dialogue: 0,0:03:57.57,0:04:00.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah itu juga memalukan?
Dialogue: 0,0:04:02.36,0:04:03.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:04:07.66,0:04:10.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sungguh tidak masalah?
Dialogue: 0,0:04:28.72,0:04:31.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini agak memalukan.
Dialogue: 0,0:04:31.56,0:04:33.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita hampir seperti tinggal bersama.
Dialogue: 0,0:04:34.02,0:04:38.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku orang pertama\Nyang memakai piama serasi denganmu.
Dialogue: 0,0:04:38.61,0:04:42.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meskipun suatu hari nanti kita berjauhan.
Dialogue: 0,0:04:43.90,0:04:47.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin tak akan pernah melupakan ini.
Dialogue: 0,0:04:51.12,0:04:53.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik! Mari jelajahi kamarnya.
Dialogue: 0,0:04:53.66,0:04:55.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, kurasa itu bukan ide bagus.
Dialogue: 0,0:04:56.00,0:04:59.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat, ada kulkas yang tampak aneh.
Dialogue: 0,0:05:03.51,0:05:06.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah sudah kubilang?\NIni hotel semacam itu.
Dialogue: 0,0:05:08.51,0:05:11.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pasti menganggapku polos\Nsoal dunia, 'kan?
Dialogue: 0,0:05:11.35,0:05:13.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah merasa seperti itu sejak pagi ini.
Dialogue: 0,0:05:13.77,0:05:16.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah kelas 12.
Dialogue: 0,0:05:16.98,0:05:21.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu persis apa isinya\Ndan cara menggunakannya.
Dialogue: 0,0:05:21.73,0:05:26.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, seandainya pun sampai sejauh itu,
Dialogue: 0,0:05:26.91,0:05:29.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tak sepolos itu\Nsampai menangis ketakutan.
Dialogue: 0,0:05:29.99,0:05:31.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya, itu menurutku.
Dialogue: 0,0:05:31.87,0:05:33.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku serius.
Dialogue: 0,0:05:35.16,0:05:38.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, setidaknya selama perjalanan ini,
Dialogue: 0,0:05:38.96,0:05:43.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku mau menjadi seperti dahulu,\Nsepolos anak kecil.
Dialogue: 0,0:05:43.76,0:05:47.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu yang kupikirkan.
Dialogue: 0,0:05:50.39,0:05:53.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam situasi ini? Yang benar saja.
Dialogue: 0,0:06:09.11,0:06:10.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudku, sungguh...
Dialogue: 0,0:06:10.82,0:06:13.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa membahas topik seperti itu sekarang?
Dialogue: 0,0:06:14.04,0:06:16.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena... Karena...
Dialogue: 0,0:06:16.25,0:06:18.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau juga pria.
Dialogue: 0,0:06:18.37,0:06:21.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kupikir setidaknya aku harus bersiap.
Dialogue: 0,0:06:21.92,0:06:25.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau mau menjadi editor,\Npikirkan struktur narasinya.
Dialogue: 0,0:06:25.46,0:06:26.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lakukan selangkah demi selangkah.
Dialogue: 0,0:06:26.92,0:06:29.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah kau akan tinggal di Tokyo,\Ndi kota ini?
Dialogue: 0,0:06:30.18,0:06:33.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kendalikan dirimu.\NJangan biarkan situasi memengaruhimu.
Dialogue: 0,0:06:34.06,0:06:35.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertahankan keyakinanmu.
Dialogue: 0,0:06:35.97,0:06:38.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tatap matanya dan kejar impianmu.
Dialogue: 0,0:06:38.52,0:06:40.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau harus menjadi dirimu sendiri!
Dialogue: 0,0:06:40.65,0:06:44.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika ada masa depan untuk kita berdua
Dialogue: 0,0:06:45.73,0:06:49.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan jika kita berdua mau\Nmenjadi satu suatu hari nanti,
Dialogue: 0,0:06:49.20,0:06:53.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}maka kita bisa memiliki hubungan semacam itu.
Dialogue: 0,0:06:53.70,0:06:56.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, aku pria yang kuno.
Dialogue: 0,0:06:57.45,0:07:01.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh aku mengatakan sesuatu?
Dialogue: 0,0:07:03.42,0:07:07.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga punya struktur narasi\Ndan perkembangan emosiku sendiri!
Dialogue: 0,0:07:07.84,0:07:10.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak terpengaruh oleh situasi.
Dialogue: 0,0:07:10.18,0:07:12.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengatakannya sambil menatap matamu.
Dialogue: 0,0:07:12.77,0:07:15.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhenti bicara sesukamu,\Ndasar tiruan pria sok keren!
Dialogue: 0,0:07:15.26,0:07:16.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah itu hanya satu hal?
Dialogue: 0,0:07:17.14,0:07:19.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo maju!\NKau pengecut yang tak mau menerima
Dialogue: 0,0:07:19.64,0:07:21.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa yang ditawarkan padamu dan gagal\Ndi saat yang paling penting.
Dialogue: 0,0:07:21.73,0:07:24.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa takut, dasar tuan putri payah.
Dialogue: 0,0:07:24.44,0:07:27.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kutunjukkan betapa kejamnya dunia!\NRasakan ini!
Dialogue: 0,0:07:27.82,0:07:29.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau punya nyali!
Dialogue: 0,0:07:29.70,0:07:31.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan melempar dua sekaligus!
Dialogue: 0,0:07:31.91,0:07:36.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski pada akhirnya kami harus tumbuh dewasa,
Dialogue: 0,0:07:37.04,0:07:38.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sampai saat itu,
Dialogue: 0,0:07:38.41,0:07:41.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku mau menikmati jadi anak polos\Nsepuas mungkin.
Dialogue: 0,0:07:42.25,0:07:44.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika tidak menjadi anak-anak dengan benar,
Dialogue: 0,0:07:44.42,0:07:46.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita tak bisa sungguh menjadi orang dewasa.
Dialogue: 0,0:07:47.05,0:07:49.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misalnya, di malam seperti ini,
Dialogue: 0,0:07:49.13,0:07:51.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan cara yang polos dan kekanak-kanakan.
Dialogue: 0,0:07:56.05,0:07:58.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari bicarakan sesuatu.
Dialogue: 0,0:07:59.06,0:08:01.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perjalanan sekali seumur hidup.
Dialogue: 0,0:08:01.81,0:08:04.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari ceritakan kisah yang pas\Nuntuk penutupnya.
Dialogue: 0,0:08:05.36,0:08:06.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia benar.
Dialogue: 0,0:08:06.36,0:08:08.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak akan ada perjalanan lain seperti ini.
Dialogue: 0,0:08:09.32,0:08:12.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, ceritakan kisahmu kepadaku.
Dialogue: 0,0:08:13.61,0:08:16.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tidak harus dramatis atau romantis.
Dialogue: 0,0:08:16.83,0:08:21.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ceritakan bagaimana kau menjadi dirimu\Nyang sekarang.
Dialogue: 0,0:08:21.79,0:08:23.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika aku memberitahumu,
Dialogue: 0,0:08:23.75,0:08:25.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisakah itu menyalakan
Dialogue: 0,0:08:25.21,0:08:27.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}setidaknya satu lilin di masa depan Kak Asu?
Dialogue: 0,0:08:30.21,0:08:32.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kepadaku, saat ini,
Dialogue: 0,0:08:32.16,0:08:33.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di akhir perjalanan ini,
Dialogue: 0,0:08:34.01,0:08:35.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pada malam ini,
Dialogue: 0,0:08:36.04,0:08:37.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ceritakan tentang dirimu.
Dialogue: 0,0:08:38.47,0:08:41.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu masa lalu yang biasa dan payah.
Dialogue: 0,0:08:42.05,0:08:46.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski itu cerita yang biasa dan payah,
Dialogue: 0,0:08:46.98,0:08:48.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan mengeditnya
Dialogue: 0,0:08:48.73,0:08:52.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan menjadikannya cerita yang unik.
Dialogue: 0,0:08:55.49,0:08:57.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku lega.
Dialogue: 0,0:08:58.12,0:09:00.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di malam sekali seumur hidup ini,
Dialogue: 0,0:09:00.45,0:09:04.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mari bicarakan topik sekali seumur hidup.
Dialogue: 0,0:09:05.04,0:09:08.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski tidak penting, membosankan,
Dialogue: 0,0:09:08.59,0:09:10.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan tidak berharga,
Dialogue: 0,0:09:10.75,0:09:12.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mari bicarakan kisah Chitose Saku.
Dialogue: 0,0:09:15.38,0:09:18.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku selalu menonjol sejak kecil.
Dialogue: 0,0:09:19.43,0:09:23.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak pernah kalah satu kali pun\Ndi hari olahraga.
Dialogue: 0,0:09:23.10,0:09:27.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak TK, banyak gadis menyukaiku.
Dialogue: 0,0:09:28.02,0:09:32.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tak berubah bahkan di sekolah dasar.\NAku selalu menjadi yang terbaik di kelas.
Dialogue: 0,0:09:33.82,0:09:35.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mulai menyadari
Dialogue: 0,0:09:35.15,0:09:38.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak semua orang bisa\Nmelakukan sesuatu sebaik aku.
Dialogue: 0,0:09:38.57,0:09:42.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sekitar kelas empat.
Dialogue: 0,0:09:42.79,0:09:46.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, aku tidak meremehkan orang lain.
Dialogue: 0,0:09:48.50,0:09:50.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agak aneh bagiku mengatakan ini,
Dialogue: 0,0:09:50.92,0:09:54.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi dibandingkan sekarang,\Nkurasa aku orang yang cukup baik saat itu.
Dialogue: 0,0:09:55.63,0:09:59.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada seorang gadis yang selalu\Nmenggambar sendirian saat istirahat.
Dialogue: 0,0:09:59.76,0:10:01.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak ada yang mau menemaninya.
Dialogue: 0,0:10:02.31,0:10:05.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, aku benci hal semacam itu.
Dialogue: 0,0:10:05.64,0:10:08.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku bicara dengannya\Ndan menurutku dia sangat menarik.
Dialogue: 0,0:10:09.31,0:10:10.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bahkan menggambar\Nkarakter manga favoritku
Dialogue: 0,0:10:11.02,0:10:13.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan memberikannya kepadaku.
Dialogue: 0,0:10:13.23,0:10:15.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat bahagia saat itu.
Dialogue: 0,0:10:16.11,0:10:19.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, setelah dia menyatakan\Ncinta dan aku menolaknya,
Dialogue: 0,0:10:19.20,0:10:21.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia memarahiku habis-habisan.
Dialogue: 0,0:10:22.28,0:10:25.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya dia tak mau dikasihani.
Dialogue: 0,0:10:27.46,0:10:30.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, aku tidak melakukannya karena kasihan.
Dialogue: 0,0:10:33.59,0:10:36.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang-orang juga sering meminta bantuanku.
Dialogue: 0,0:10:36.17,0:10:38.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada dasarnya aku tak pernah menolak.
Dialogue: 0,0:10:38.26,0:10:41.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awalnya, semua orang bahagia.
Dialogue: 0,0:10:41.18,0:10:42.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, seiring waktu,
Dialogue: 0,0:10:42.89,0:10:47.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}semua tugas merepotkan jadi otomatis\Ndiserahkan kepada Chitose.
Dialogue: 0,0:10:47.52,0:10:48.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika aku menolak,
Dialogue: 0,0:10:48.98,0:10:51.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau jika hasilnya\Ntidak sesuai harapan mereka,
Dialogue: 0,0:10:51.77,0:10:54.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mereka bahkan akan menyalahkanku.
Dialogue: 0,0:10:56.15,0:10:57.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika aku menyimpang sedikit saja
Dialogue: 0,0:10:57.99,0:11:01.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dari citra Chitose yang serbabisa\Ndan baik kepada semua orang,
Dialogue: 0,0:11:01.11,0:11:04.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan diserang lebih dari yang diperlukan.
Dialogue: 0,0:11:04.95,0:11:08.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, kita tak bisa selamanya\Nmenjadi nomor satu
Dialogue: 0,0:11:08.46,0:11:11.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hanya dengan mengandalkan bakat alami.
Dialogue: 0,0:11:13.17,0:11:14.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu semacam ketakutan.
Dialogue: 0,0:11:14.88,0:11:17.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takut ada yang menyusul dari belakang,
Dialogue: 0,0:11:17.17,0:11:20.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan sekali saja tersalip,\Naku akan ditinggalkan.
Dialogue: 0,0:11:20.84,0:11:22.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku bekerja sangat keras.
Dialogue: 0,0:11:22.85,0:11:25.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan saat kali pertama memulai bisbol,
Dialogue: 0,0:11:25.10,0:11:27.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tak ada senior di tim
Dialogue: 0,0:11:27.68,0:11:29.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang tangannya babak belur seperti tanganku.
Dialogue: 0,0:11:30.14,0:11:31.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat aku kelas lima,
Dialogue: 0,0:11:31.90,0:11:35.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pencapaianku mulai bikin orang iri.
Dialogue: 0,0:11:35.73,0:11:40.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, orang-orang mulai berusaha\Nmembuatku gagal.
Dialogue: 0,0:11:40.40,0:11:43.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}PR-ku yang sudah selesai\Nmenghilang dari mejaku.
Dialogue: 0,0:11:43.87,0:11:47.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baju olahragaku disemprot\Nsemprotan bau busuk untuk iseng.
Dialogue: 0,0:11:47.87,0:11:50.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, semua orang tertawa bahagia.
Dialogue: 0,0:11:50.96,0:11:54.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, tak ada yang menganggapnya\Nsebagai perundungan.
Dialogue: 0,0:11:54.33,0:11:57.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga tidak berpikir begitu.
Dialogue: 0,0:11:57.13,0:12:00.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku masih bermain dengan mereka\Nsepulang sekolah seperti biasa.
Dialogue: 0,0:12:01.76,0:12:07.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa mereka hanya mau memperkecil jarak.
Dialogue: 0,0:12:09.52,0:12:13.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat itulah seorang guru berkata kepadaku,
Dialogue: 0,0:12:13.35,0:12:17.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Orang yang terlahir dengan\Nbanyak karunia dari Tuhan
Dialogue: 0,0:12:17.65,0:12:21.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bertugas memimpin semua orang dari depan.
Dialogue: 0,0:12:22.03,0:12:26.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, melompatlah lebih tinggi\Ndan berlarilah lebih cepat.
Dialogue: 0,0:12:26.49,0:12:32.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadilah pahlawan yang dikagumi\Nsemua orang dan pasti diikuti."
Dialogue: 0,0:12:32.66,0:12:34.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengubah kata-kata itu
Dialogue: 0,0:12:34.67,0:12:39.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menjadi sesuatu yang sangat\Nberbeda dari niat baik guru itu.
Dialogue: 0,0:12:39.59,0:12:43.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sederhananya,\Naku akan menjadi sangat sempurna
Dialogue: 0,0:12:43.63,0:12:46.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hingga tak ada yang mencoba menyabotaseku.
Dialogue: 0,0:12:47.55,0:12:49.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bukan untuk menyelamatkan siapa pun.
Dialogue: 0,0:12:49.97,0:12:52.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu untuk menjauhkan semua orang.
Dialogue: 0,0:12:52.48,0:12:55.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bersumpah untuk menjadi\Npahlawan yang sempurna.
Dialogue: 0,0:12:56.40,0:12:59.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Contohnya, aku menyelamatkan anak lelaki\Ndari perundungan di SMP,
Dialogue: 0,0:13:00.07,0:13:01.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan dia mulai mengikutiku setiap hari.
Dialogue: 0,0:13:01.86,0:13:05.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bahkan mengintai rumahku di hari libur.
Dialogue: 0,0:13:05.66,0:13:08.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat kubilang itu menggangguku,
Dialogue: 0,0:13:08.20,0:13:12.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia mulai menjelek-jelekkanku\Ndi depan semua orang.
Dialogue: 0,0:13:12.29,0:13:15.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika akhirnya begitu, seharusnya\Nkubilang dari awal, "Itu bukan kebaikan,
Dialogue: 0,0:13:15.92,0:13:19.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku bertindak demi diriku sendiri.
Dialogue: 0,0:13:19.25,0:13:24.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan jika aku membantumu,\Naku tidak berniat bergaul denganmu."
Dialogue: 0,0:13:24.34,0:13:28.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan begitu, tak akan ada\Nharapan atau kekecewaan berlebihan.
Dialogue: 0,0:13:28.35,0:13:31.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika para gadis jatuh cinta kepadaku\Natas kemauan sendiri, lalu kutolak,
Dialogue: 0,0:13:31.89,0:13:34.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mereka akan mengeluh bahwa aku perayu\Nyang mempermainkan perasaan mereka.
Dialogue: 0,0:13:34.81,0:13:39.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, lebih baik sejak awal aku jadi\Npria sembrono yang tak bisa diandalkan.
Dialogue: 0,0:13:39.27,0:13:44.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika aku rendah hati,\Norang-orang akan bergosip di belakangku.
Dialogue: 0,0:13:44.11,0:13:48.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, lebih baik aku menjadi\Nbedebah menjengkelkan sejak awal.
Dialogue: 0,0:13:48.16,0:13:52.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, jika terlalu sempurna\Njuga membuat orang kesal,
Dialogue: 0,0:13:52.24,0:13:56.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan mengatakan lelucon payah\Nsesekali untuk menceriakan suasana.
Dialogue: 0,0:13:56.62,0:13:59.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak trauma
Dialogue: 0,0:13:59.50,0:14:01.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan satu insiden.
Dialogue: 0,0:14:02.21,0:14:03.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya menghindari
Dialogue: 0,0:14:03.46,0:14:06.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kerikil kecil yang dilempar orang kepadaku,\Nsatu per satu.
Dialogue: 0,0:14:06.97,0:14:10.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanpa kusadari,\Naku menjadi orang seperti ini.
Dialogue: 0,0:14:10.76,0:14:12.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat?
Dialogue: 0,0:14:12.26,0:14:16.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang itu kisah yang tidak penting,\Nmembosankan,
Dialogue: 0,0:14:16.35,0:14:18.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan tidak berharga.
Dialogue: 0,0:14:19.40,0:14:21.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ceritaku berakhir di sini.
Dialogue: 0,0:14:23.48,0:14:27.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari itu,\Naku berniat menggapai dan menyentuh bulan.
Dialogue: 0,0:14:27.65,0:14:31.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau menjadi kelereng\Ndi dalam botol Ramune.
Dialogue: 0,0:14:32.03,0:14:34.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau menjadi keberadaan mulia
Dialogue: 0,0:14:34.70,0:14:39.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang dikagumi dan didambakan semua orang,\Ntapi tak seorang pun bisa menggapainya.
Dialogue: 0,0:14:39.46,0:14:42.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, kelereng di botol Ramune
Dialogue: 0,0:14:42.25,0:14:44.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bukan bulan yang menggantung di langit malam.
Dialogue: 0,0:14:45.21,0:14:49.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya membangun dinding tinggi\Ndi sekelilingku, takut pada semuanya.
Dialogue: 0,0:14:49.76,0:14:51.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari dasar botol,
Dialogue: 0,0:14:51.97,0:14:54.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku hanya menatap bulan\Nyang bersinar di kejauhan.
Dialogue: 0,0:14:54.97,0:14:57.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menatap bulan yang menerangi kegelapan.
Dialogue: 0,0:14:58.64,0:15:03.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada akhirnya,\Naku bukan bulan, tapi kelereng.
Dialogue: 0,0:15:03.82,0:15:06.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti itulah ceritanya.
Dialogue: 0,0:15:08.86,0:15:10.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya aku mengerti
Dialogue: 0,0:15:11.03,0:15:15.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kenapa kau, pahlawan dari manga shonen,
Dialogue: 0,0:15:15.20,0:15:17.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menjalani hidupmu seperti ini.
Dialogue: 0,0:15:18.66,0:15:22.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan karena kau tak punya cerita.
Dialogue: 0,0:15:23.04,0:15:25.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu karena kau punya terlalu banyak.
Dialogue: 0,0:15:26.38,0:15:27.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mayoritas orang,
Dialogue: 0,0:15:27.84,0:15:30.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jika mereka mengalami salah satu hal\Nyang kau sebutkan,
Dialogue: 0,0:15:30.51,0:15:32.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan mengubahnya menjadi cerita.
Dialogue: 0,0:15:32.76,0:15:36.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan begitu,\Nsaat keadaan tidak berjalan lancar,
Dialogue: 0,0:15:36.31,0:15:37.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mereka bisa merasa sedikit lebih baik.
Dialogue: 0,0:15:38.48,0:15:39.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun,
Dialogue: 0,0:15:39.89,0:15:44.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau tidak membiarkan apa pun menjadi cerita.
Dialogue: 0,0:15:45.02,0:15:47.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pikir itu rasa sakit sepele,
Dialogue: 0,0:15:47.57,0:15:49.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bekas luka tidak berharga,
Dialogue: 0,0:15:49.28,0:15:51.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan hal-hal yang harus kau atasi sendiri.
Dialogue: 0,0:15:52.95,0:15:57.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena tak ada pahlawan sepertimu\Nyang datang menyelamatkanmu.
Dialogue: 0,0:15:57.16,0:15:59.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sebabnya kau seperti ini,
Dialogue: 0,0:15:59.25,0:16:03.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}melindungi sendiri cara hidup\Ndan cita-citamu, bukan?
Dialogue: 0,0:16:04.67,0:16:07.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agar kau bisa terus hidup dengan indah.
Dialogue: 0,0:16:09.01,0:16:10.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat masih kecil...
Dialogue: 0,0:16:11.05,0:16:16.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat masih kecil, aku juga mau\Nmenjadi pahlawan di manga shonen.
Dialogue: 0,0:16:16.10,0:16:19.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau menjadi orang\Nyang menghadapi semuanya,
Dialogue: 0,0:16:19.10,0:16:22.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bekerja keras, dan menghargai teman-temannya.
Dialogue: 0,0:16:22.48,0:16:27.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seseorang yang melihat orang dalam masalah\Ndan membantu mereka tanpa syarat.
Dialogue: 0,0:16:27.77,0:16:30.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun...
Dialogue: 0,0:16:30.90,0:16:34.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, tak ada yang menginginkan\Nversi diriku yang itu!
Dialogue: 0,0:16:37.78,0:16:41.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah orang itu adalah dirimu?
Dialogue: 0,0:16:41.62,0:16:45.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau membantu Yamazaki\Ndan Nanase tanpa syarat.
Dialogue: 0,0:16:45.33,0:16:49.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau menghadapi masalah mereka dengan\Ntulus dan berusaha menyelesaikannya
Dialogue: 0,0:16:49.13,0:16:52.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena kau sangat menyayangi mereka.
Dialogue: 0,0:16:52.80,0:16:54.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan begitu.
Dialogue: 0,0:16:54.80,0:16:58.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu yang mau kau percayai.
Dialogue: 0,0:16:58.18,0:17:03.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sebabnya kau selalu mengambil peran\Npenjahat dan memilih solusi pengorbanan diri.
Dialogue: 0,0:17:03.94,0:17:06.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak semulia itu.
Dialogue: 0,0:17:06.65,0:17:08.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chitose Saku yang sebenarnya
Dialogue: 0,0:17:08.85,0:17:13.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah orang yang menyerah,\Ntapi tak bisa merelakan sepenuhnya.
Dialogue: 0,0:17:13.28,0:17:16.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya anak biasa yang terus\Nberjuang hingga akhir.
Dialogue: 0,0:17:17.81,0:17:22.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang seperti itulah\Nyang kita sebut pahlawan.
Dialogue: 0,0:17:24.82,0:17:28.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak semua orang bisa\Nterus berjuang sepertimu
Dialogue: 0,0:17:28.21,0:17:32.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau menggapai bulan bahkan\Nsaat tahu itu di luar jangkauan.
Dialogue: 0,0:17:32.42,0:17:34.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, saat orang melihat orang seperti itu,
Dialogue: 0,0:17:34.51,0:17:39.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mereka mencoba meyakinkan diri,\N"Aku normal dan dia yang aneh."
Dialogue: 0,0:17:39.51,0:17:44.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika tidak, mereka tak bisa menerima\Nkurangnya gairah mereka sendiri.
Dialogue: 0,0:17:44.69,0:17:48.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang kau dambakan mungkin bulan purnama.
Dialogue: 0,0:17:49.52,0:17:53.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, bulan separuh,\Nbulan sabit, bahkan bulan mati di antaranya,
Dialogue: 0,0:17:53.57,0:17:56.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}juga kelereng kaca yang mengambang\Ndi botol Ramune,
Dialogue: 0,0:17:56.99,0:18:00.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah harta karun bagi seseorang.
Dialogue: 0,0:18:02.79,0:18:05.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sentuh aku.
Dialogue: 0,0:18:05.71,0:18:06.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sentuh dahiku,
Dialogue: 0,0:18:06.87,0:18:08.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pipiku,
Dialogue: 0,0:18:08.29,0:18:09.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan bibirku.
Dialogue: 0,0:18:10.34,0:18:13.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini agak memalukan, tapi pahaku juga.
Dialogue: 0,0:18:13.13,0:18:14.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, lututku.
Dialogue: 0,0:18:18.39,0:18:21.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku di sini.
Dialogue: 0,0:18:21.22,0:18:25.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sungguh cahaya bagi seseorang.
Dialogue: 0,0:18:26.14,0:18:28.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kubuktikan itu kepadamu.
Dialogue: 0,0:18:32.11,0:18:36.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senyum yang melayang di langit malam biru itu
Dialogue: 0,0:18:37.24,0:18:42.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}terlihat seperti bulan\Nyang terus kucoba raih.
Dialogue: 0,0:18:43.37,0:18:46.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami membicarakan banyak hal.
Dialogue: 0,0:18:46.41,0:18:49.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Legenda urban yang kami percayai saat kecil.
Dialogue: 0,0:18:49.33,0:18:51.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Markas rahasia kami sendiri.
Dialogue: 0,0:18:51.42,0:18:53.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mainan favorit kami.
Dialogue: 0,0:18:53.75,0:18:58.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seolah menghentikan percakapan\Nakan membangunkan kami dari mimpi ini.
Dialogue: 0,0:19:03.51,0:19:08.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepuluh tahun lagi,\Nsaat tiba-tiba aku merindukan malam ini,
Dialogue: 0,0:19:09.06,0:19:14.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kira-kira kami sudah menjadi\Norang dewasa seperti apa?
Dialogue: 0,0:19:14.27,0:19:18.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, siapa yang akan berada di sisi kami?
Dialogue: 0,0:19:33.96,0:19:36.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misiku sudah selesai.
Dialogue: 0,0:19:36.80,0:19:41.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai sekarang, Kak Asu pasti akan\Nmengubahnya menjadi kisah yang unik.
Dialogue: 0,0:19:42.68,0:19:44.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setengah tertidur, setengah terjaga,
Dialogue: 0,0:19:44.85,0:19:46.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}anak lelaki dan perempuan
Dialogue: 0,0:19:46.35,0:19:49.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berlari menyusuri jalan setapak\Ndi ladang musim panas.
Dialogue: 0,0:19:58.44,0:20:00.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh aku memegang tanganmu?
Dialogue: 0,0:20:33.90,0:20:37.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah, maaf sudah membuat Ayah khawatir.
Dialogue: 0,0:20:37.57,0:20:40.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa pun yang kau lakukan, ikuti aturannya.
Dialogue: 0,0:20:42.70,0:20:45.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf sudah membuatmu khawatir juga, Kura-sen.
Dialogue: 0,0:20:45.99,0:20:49.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya punya satu kekhawatiran.
Dialogue: 0,0:20:51.79,0:20:54.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku punya permintaan untuk kalian berdua.
Dialogue: 0,0:20:54.08,0:20:55.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepulang sekolah lusa,
Dialogue: 0,0:20:55.75,0:20:58.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisakah kita mengadakan lagi\Npertemuan orang tua, guru, dan murid?
Dialogue: 0,0:21:00.96,0:21:04.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu. Lagi pula, aku senggang.
Dialogue: 0,0:21:04.47,0:21:05.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:21:09.56,0:21:12.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini akan menjadi yang terakhir.
Dialogue: 0,0:21:12.60,0:21:13.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:21:15.19,0:21:18.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari berkencan lagi besok
Dialogue: 0,0:21:18.19,0:21:20.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sepulang sekolah.
Dialogue: 0,0:21:20.32,0:21:21.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:21:21.32,0:21:23.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, beres!
Dialogue: 0,0:21:28.58,0:21:29.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pak Nishino.
Dialogue: 0,0:21:31.12,0:21:32.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini.
Dialogue: 0,0:21:32.58,0:21:34.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah sudah kubilang aku benci pisang?
Dialogue: 0,0:21:34.75,0:21:36.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sebabnya saya memberikannya.
Dialogue: 0,0:21:43.17,0:21:47.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari liburku sungguh hancur.\NSebaiknya kau mentraktirku makan yakiniku.
Dialogue: 0,0:21:47.47,0:21:49.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisakah kita ke Hachiban saja?
Dialogue: 0,0:21:49.93,0:21:52.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku mau tambahan gyoza dan bir.
Dialogue: 0,0:21:52.22,0:21:55.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan membuat muridmu membelikanmu miras!
Dialogue: 0,0:21:58.31,0:22:00.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan ini,
Dialogue: 0,0:22:00.57,0:22:03.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pelarian singkat kami sungguh berakhir.
Dialogue: 0,0:23:37.79,0:23:40.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Angin Hari Esok.
