Dialogue: 0,0:01:56.76,0:02:01.45,sign,,0000,0000,0000,,"TOKO BUKU MIYAWAKI"
Dialogue: 0,0:06:13.47,0:06:14.87,sign,,0000,0000,0000,,MAAF, AKU PERGI KE FESTIVAL BERSAMA KAK SAKU.\NAKU AKAN BERUSAHA PULANG CEPAT.
Dialogue: 0,0:23:35.62,0:23:37.89,sign,,0000,0000,0000,,EPISODE SELANJUTNYA: PINTU MENUJU MUSIM PANAS
Dialogue: 0,0:00:02.71,0:00:04.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kita lewat Jalur Echizen?
Dialogue: 0,0:00:04.29,0:00:07.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau akan tahu saat tiba di sana.
Dialogue: 0,0:00:17.72,0:00:19.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita turun di sini.
Dialogue: 0,0:00:37.74,0:00:38.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei.
Dialogue: 0,0:00:40.87,0:00:47.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisakah aku berhenti menjadi senior\Natau kakakmu untuk sementara?
Dialogue: 0,0:00:53.47,0:00:56.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lama tidak bertemu, Kak Saku.
Dialogue: 0,0:00:57.68,0:00:59.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau...
Dialogue: 0,0:01:02.68,0:01:04.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, Kak Saku?
Dialogue: 0,0:01:07.48,0:01:09.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu sebentar.
Dialogue: 0,0:01:09.77,0:01:13.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kita pernah bertemu waktu kecil?
Dialogue: 0,0:01:13.94,0:01:15.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:01:15.11,0:01:17.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rambutmu yang panjang sepunggung?
Dialogue: 0,0:01:17.78,0:01:21.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana menjelaskannya, ya?\NMungkin lebih introver?
Dialogue: 0,0:01:21.66,0:01:22.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:01:22.70,0:01:25.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bermain bersama\Nsaat liburan musim panas?
Dialogue: 0,0:01:25.66,0:01:28.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya! Itu benar!
Dialogue: 0,0:01:32.13,0:01:34.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau tak memberitahuku lebih awal?
Dialogue: 0,0:01:36.38,0:01:37.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau ingat sekarang?
Dialogue: 0,0:01:38.47,0:01:40.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Kau dan Kak Asu" saat itu
Dialogue: 0,0:01:40.89,0:01:42.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebenarnya "Kak Saku dan aku".
Dialogue: 0,0:01:43.22,0:01:45.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana mungkin?
Dialogue: 0,0:01:46.77,0:01:47.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang, bukan?
Dialogue: 0,0:01:48.48,0:01:51.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenyataan seperti dongeng juga ada.
Dialogue: 0,0:01:51.69,0:01:53.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, itu tepat di sampingmu.
Dialogue: 0,0:01:55.90,0:01:56.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini dulu
Dialogue: 0,0:01:56.76,0:02:01.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kota yang kutinggali sampai kelas enam.
Dialogue: 0,0:02:01.53,0:02:05.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat introver saat kecil.
Dialogue: 0,0:02:05.45,0:02:07.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dulu juga\Nbukan gadis yang menarik sama sekali.
Dialogue: 0,0:02:08.50,0:02:10.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama musim panas kelas empat,
Dialogue: 0,0:02:10.63,0:02:16.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kudengar seorang anak mengunjungi neneknya\Nyang tinggal sendirian di dekat sini.
Dialogue: 0,0:02:16.88,0:02:21.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku diminta berteman dengannya.
Dialogue: 0,0:02:21.93,0:02:25.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tinggal di sekitar sini?\NBisakah kau mengajakku berkeliling?
Dialogue: 0,0:02:26.60,0:02:28.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa, tapi di sini tak ada apa-apa.
Dialogue: 0,0:02:29.02,0:02:31.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana bisa tak ada apa-apa?
Dialogue: 0,0:02:34.98,0:02:37.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Chitose Saku.
Dialogue: 0,0:02:39.32,0:02:41.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Saku.
Dialogue: 0,0:02:42.74,0:02:44.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama tiga hari berikutnya,
Dialogue: 0,0:02:44.87,0:02:48.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia genius yang bisa menemukan kebahagiaan\Ndalam apa pun yang dia lakukan.
Dialogue: 0,0:02:50.46,0:02:52.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kota yang kupikir tak punya apa-apa
Dialogue: 0,0:02:52.79,0:02:55.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mulai berkilau seperti kotak perhiasan.
Dialogue: 0,0:02:57.01,0:02:59.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada hari ketiga, saat Kak Saku pergi...
Dialogue: 0,0:03:00.68,0:03:03.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku merasa akan kembali\Nke rutinitas yang sama.
Dialogue: 0,0:03:03.47,0:03:04.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rutinitas yang sama?
Dialogue: 0,0:03:04.68,0:03:06.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rutinitas yang sama.
Dialogue: 0,0:03:09.43,0:03:11.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, ayo bertualang.
Dialogue: 0,0:03:12.27,0:03:14.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke tempat yang belum pernah kau lihat.
Dialogue: 0,0:03:20.86,0:03:22.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei.
Dialogue: 0,0:03:22.82,0:03:24.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutmu apa itu?
Dialogue: 0,0:03:24.83,0:03:27.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bangunan pengatur aliran sungai?
Dialogue: 0,0:03:27.41,0:03:29.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu terlalu membosankan.
Dialogue: 0,0:03:29.25,0:03:31.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu rumah kappa.
Dialogue: 0,0:03:31.54,0:03:32.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kappa?
Dialogue: 0,0:03:33.50,0:03:35.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akan dapat masalah jika ketahuan.
Dialogue: 0,0:03:35.25,0:03:38.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akan merangkak lewat pipa itu\Ndan menyelinap ke sungai.
Dialogue: 0,0:03:40.22,0:03:42.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudmu? Itu aneh sekali.
Dialogue: 0,0:03:45.47,0:03:47.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau menemukan\Nhal yang belum pernah kau lihat?
Dialogue: 0,0:03:48.31,0:03:50.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa semuanya mulai terlihat berbeda?
Dialogue: 0,0:03:53.31,0:03:54.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hal seperti itu mudah, bukan?
Dialogue: 0,0:03:56.61,0:04:02.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagiku,\NKak Saku seperti kebebasan itu sendiri.
Dialogue: 0,0:04:07.62,0:04:10.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak sabar\Nmenunggu musim panas berikutnya.
Dialogue: 0,0:04:11.37,0:04:12.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku terus memikirkannya.
Dialogue: 0,0:04:14.88,0:04:15.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu,
Dialogue: 0,0:04:17.50,0:04:19.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}selama musim panas kelas lima,
Dialogue: 0,0:04:20.42,0:04:25.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku sangat bersemangat\Nmenunjukkan gaun baruku kepada Kak Saku
Dialogue: 0,0:04:25.47,0:04:27.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hingga agak terbawa suasana.
Dialogue: 0,0:04:32.77,0:04:33.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat...
Dialogue: 0,0:04:34.60,0:04:36.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menangis di depan Kak Saku.
Dialogue: 0,0:04:36.94,0:04:39.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal ini liburan musim panas kami\Nyang berharga.
Dialogue: 0,0:04:47.57,0:04:50.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau melakukan\Nsemua hal menyenangkan sendirian?
Dialogue: 0,0:04:51.95,0:04:56.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tahun depan, siapkan celana pendek,\Nkaus, dan sandal jepit.
Dialogue: 0,0:05:00.25,0:05:02.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sulit kupercaya.
Dialogue: 0,0:05:03.22,0:05:04.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bodoh!
Dialogue: 0,0:05:06.30,0:05:08.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Musim panas kelas enam.
Dialogue: 0,0:05:08.55,0:05:12.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kita bisa pergi ke festival bersama,\Nitu akan menjadi kenangan berharga.
Dialogue: 0,0:05:13.43,0:05:15.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, Ayah melarang.
Dialogue: 0,0:05:17.31,0:05:18.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, begini saja.
Dialogue: 0,0:05:19.69,0:05:22.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cobalah membujuk ayahmu sekali lagi.
Dialogue: 0,0:05:22.57,0:05:24.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menjemputmu nanti malam.
Dialogue: 0,0:05:24.99,0:05:27.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana jika dia tetap menolak?
Dialogue: 0,0:05:27.16,0:05:29.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau tetap mau pergi,
Dialogue: 0,0:05:29.91,0:05:32.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sentuh telinga kirimu\Nsebagai isyarat rahasia.
Dialogue: 0,0:05:32.95,0:05:34.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu?
Dialogue: 0,0:05:34.58,0:05:36.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, aku akan membawamu pergi.
Dialogue: 0,0:05:42.00,0:05:44.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Kak Saku.
Dialogue: 0,0:05:45.05,0:05:48.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya. Kalau begitu,\Nsampai jumpa tahun depan.
Dialogue: 0,0:05:50.18,0:05:52.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, bagaimana dengan janji kita?
Dialogue: 0,0:06:09.74,0:06:12.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau tidur?\NBukankah kita akan pergi?
Dialogue: 0,0:06:14.91,0:06:18.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini? Kau sungguh cengeng.
Dialogue: 0,0:06:21.13,0:06:22.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malam festival.
Dialogue: 0,0:06:23.17,0:06:25.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jantungku tidak berhenti berdebar.
Dialogue: 0,0:06:25.71,0:06:30.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagian karena aku melakukan hal buruk\Ntanpa sepengetahuan ayahku,
Dialogue: 0,0:06:30.68,0:06:32.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi terutama
Dialogue: 0,0:06:32.43,0:06:35.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena Kak Saku membawaku pergi,
Dialogue: 0,0:06:35.47,0:06:37.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sesuai janjinya.
Dialogue: 0,0:06:40.56,0:06:45.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelereng yang tersangkut di dasar\Nbotol Ramune tampak sangat menyedihkan.
Dialogue: 0,0:06:46.28,0:06:47.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sendirian.
Dialogue: 0,0:06:49.40,0:06:52.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagiku, kelereng itu\Ntampak melayang dengan bebas.
Dialogue: 0,0:06:53.49,0:06:55.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu seindah bulan.
Dialogue: 0,0:06:55.74,0:06:57.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama sepertimu, Kak Saku.
Dialogue: 0,0:06:59.75,0:07:01.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bulan...
Dialogue: 0,0:07:01.46,0:07:02.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:07:11.01,0:07:13.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah kenapa, aku merasa agak sedih.
Dialogue: 0,0:07:13.18,0:07:15.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dadaku terasa berat.
Dialogue: 0,0:07:15.64,0:07:18.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak bisa merengek\Nmemintamu jangan pergi jauh.
Dialogue: 0,0:07:18.18,0:07:19.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku malah mengatakan ini.
Dialogue: 0,0:07:20.77,0:07:24.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika suatu hari\Nkau merasa kesepian sendirian,
Dialogue: 0,0:07:25.36,0:07:27.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan menjadi pengantinmu.
Dialogue: 0,0:07:31.03,0:07:33.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu sampai kau berhenti bersikap cengeng.
Dialogue: 0,0:07:33.28,0:07:34.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak cengeng!
Dialogue: 0,0:07:35.08,0:07:36.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:07:38.33,0:07:40.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah cinta pertama yang jauh,\Nyang hanya bertahan tujuh hari
Dialogue: 0,0:07:40.74,0:07:42.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di musim panas itu.
Dialogue: 0,0:07:43.33,0:07:45.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah tahun itu,
Dialogue: 0,0:07:45.84,0:07:48.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita tak bisa bertemu lagi\Nkarena aku pindah.
Dialogue: 0,0:07:49.38,0:07:53.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula,\Nkupikir Kak Saku suka gadis yang ceria.
Dialogue: 0,0:07:53.59,0:07:56.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sia-sia saja aku memotong pendek rambutku.
Dialogue: 0,0:07:59.02,0:08:02.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Jadi, perasaan kita sama.
Dialogue: 0,0:08:02.69,0:08:03.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil.
Dialogue: 0,0:08:03.90,0:08:05.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Asu.
Dialogue: 0,0:08:06.32,0:08:08.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapan kau menyadarinya?
Dialogue: 0,0:08:10.03,0:08:11.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}September lalu.
Dialogue: 0,0:08:11.61,0:08:14.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat kita bertemu di tepi sungai.
Dialogue: 0,0:08:16.07,0:08:19.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku selalu gelisah\Nsoal kapan aku harus jujur kepadamu.
Dialogue: 0,0:08:19.70,0:08:22.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, kau jadi sangat sinis dan ketus.
Dialogue: 0,0:08:23.46,0:08:26.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bahkan bertanya,\N"Kenapa kau melakukan hal begitu?"
Dialogue: 0,0:08:27.09,0:08:28.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kupikir
Dialogue: 0,0:08:28.84,0:08:31.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku harus memberitahumu\Nsiapa Kak Saku yang asli.
Dialogue: 0,0:08:32.97,0:08:35.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memutuskan mengesampingkan perasaanku\Nuntuk saat ini
Dialogue: 0,0:08:36.26,0:08:39.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan mempertahankan\Ncitra seniorku yang keren.
Dialogue: 0,0:08:40.05,0:08:43.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memutuskan\Nkita hanya akan menjadi "kau dan Kak Asu".
Dialogue: 0,0:08:47.15,0:08:49.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Asu yang kau kagumi
Dialogue: 0,0:08:50.65,0:08:53.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebenarnya adalah Kak Saku yang kukagumi.
Dialogue: 0,0:09:02.54,0:09:06.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang kau lihat hanyalah ilusi.
Dialogue: 0,0:09:06.58,0:09:09.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang sungguh keren adalah kau.
Dialogue: 0,0:09:10.80,0:09:14.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, ini hanya memastikan titik awal kita.
Dialogue: 0,0:09:15.97,0:09:18.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa dia akan kecewa?
Dialogue: 0,0:09:18.22,0:09:20.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa dia akan bertanya-tanya\Nkenapa aku menunggu sampai sekarang?
Dialogue: 0,0:09:21.27,0:09:24.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, bagaimanapun dia melihatku,
Dialogue: 0,0:09:24.31,0:09:25.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}itu tidak masalah untuk saat ini.
Dialogue: 0,0:09:26.85,0:09:29.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya perlu melangkah maju dari sini.
Dialogue: 0,0:09:29.86,0:09:33.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pasti akan menyusul\Nsosokmu yang jauh itu.
Dialogue: 0,0:09:34.49,0:09:35.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial.
Dialogue: 0,0:09:35.78,0:09:37.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Lebih bebas daripada siapa pun,\Ntapi lebih terkekang daripada siapa pun."
Dialogue: 0,0:09:37.78,0:09:39.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, begitu maksudnya.
Dialogue: 0,0:09:40.53,0:09:43.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tak bisa menjadi orang seperti itu\Nhanya karena mengagumi
Dialogue: 0,0:09:43.62,0:09:45.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}anak yang bermain denganmu\Nselama liburan musim panas.
Dialogue: 0,0:09:45.96,0:09:46.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun...
Dialogue: 0,0:09:46.87,0:09:48.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau yang mengatakannya.
Dialogue: 0,0:09:49.04,0:09:54.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Kau tidak membiarkan apa pun\Nhanya berakhir sebagai cerita."
Dialogue: 0,0:09:54.21,0:09:55.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,
Dialogue: 0,0:09:55.51,0:10:00.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tak perlu mengaitkan dirimu\Nyang sekarang dengan cerita.
Dialogue: 0,0:10:00.39,0:10:03.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah bertemu denganku atau tidak,
Dialogue: 0,0:10:03.18,0:10:05.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau akan menjadi dirimu yang sekarang.
Dialogue: 0,0:10:07.35,0:10:10.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau rela kotor-kotoran\Nhanya untuk membuat anak-anak tersenyum.
Dialogue: 0,0:10:11.02,0:10:13.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau menyelamatkan diriku yang lama.
Dialogue: 0,0:10:13.65,0:10:16.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau menerima diriku yang sekarang.
Dialogue: 0,0:10:16.95,0:10:19.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dirimu yang sekarang
Dialogue: 0,0:10:19.45,0:10:21.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sudah memikatku lagi,
Dialogue: 0,0:10:21.66,0:10:22.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}membuatku mengagumimu.
Dialogue: 0,0:10:23.74,0:10:25.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sederhana, bukan?
Dialogue: 0,0:10:32.13,0:10:33.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini?
Dialogue: 0,0:10:33.92,0:10:37.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Saku lebih tergila-gila kepadaku\Ndaripada dugaanku.
Dialogue: 0,0:10:38.38,0:10:40.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tak tahu?
Dialogue: 0,0:10:40.34,0:10:45.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah lama menyukaimu.
Dialogue: 0,0:10:50.90,0:10:54.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cinta pertama yang selalu kuhargai
Dialogue: 0,0:10:54.48,0:10:56.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berakhir di sini.
Dialogue: 0,0:10:56.28,0:10:59.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa lalu yang hanya mengagumi\Ndan mengejarmu
Dialogue: 0,0:10:59.15,0:11:00.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}juga berakhir di sini.
Dialogue: 0,0:11:04.58,0:11:07.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, mulai sekarang, ini
Dialogue: 0,0:11:07.58,0:11:09.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kisah nyata Nishino Asuka.
Dialogue: 0,0:11:17.55,0:11:20.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau pergi ke Tokyo
Dialogue: 0,0:11:20.38,0:11:22.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk menjadi editor novel.
Dialogue: 0,0:11:25.47,0:11:27.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau sangat terobsesi\Ndengan penyuntingan?
Dialogue: 0,0:11:28.35,0:11:30.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di dunia ini, mungkin ada kisah
Dialogue: 0,0:11:30.52,0:11:33.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang akan tetap terkubur\Njika aku tidak menemukannya.
Dialogue: 0,0:11:33.94,0:11:36.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau kata-kata yang tak akan didengar.
Dialogue: 0,0:11:36.36,0:11:39.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau membantu menyampaikannya\Nkepada dunia.
Dialogue: 0,0:11:39.32,0:11:40.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alasan yang klise.
Dialogue: 0,0:11:42.24,0:11:46.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak murid Ayah membicarakan mimpi,
Dialogue: 0,0:11:46.87,0:11:50.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi mayoritas berakhir\Nsebagai pekerja biasa.
Dialogue: 0,0:11:50.29,0:11:52.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika hanya itu, tak apa-apa.
Dialogue: 0,0:11:52.42,0:11:56.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayangnya, dengan komitmen setengah hati,
Dialogue: 0,0:11:56.21,0:12:00.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mereka berpegang pada gagasan\Nbahwa mengejar mimpi itu keren.
Dialogue: 0,0:12:00.17,0:12:05.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat sadar tidak terpilih,\Nmereka melihat sekeliling dengan panik.
Dialogue: 0,0:12:07.26,0:12:10.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teman sekelas yang mereka ejek\Nkarena biasa dan payah,
Dialogue: 0,0:12:10.89,0:12:14.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ternyata sudah punya\Npekerjaan tetap, menikah,
Dialogue: 0,0:12:14.52,0:12:17.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan membangun keluarga biasa yang bahagia.
Dialogue: 0,0:12:18.07,0:12:23.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seolah hanya mereka yang ditinggalkan dunia.
Dialogue: 0,0:12:23.86,0:12:27.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah rasa kau tak akan menjadi\Nsalah satu yang istimewa.
Dialogue: 0,0:12:27.83,0:12:30.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hadapi kenyataan.
Dialogue: 0,0:12:34.04,0:12:38.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu, aku tak mau menyerah.
Dialogue: 0,0:12:39.21,0:12:43.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena ini kisah Nishino Asuka!
Dialogue: 0,0:12:45.30,0:12:47.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,\Nkau akan memutuskan hubungan dengan Ayah?
Dialogue: 0,0:12:50.77,0:12:52.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah akan memberikan dukungan finansial,
Dialogue: 0,0:12:52.94,0:12:56.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kau tak boleh pulang.
Dialogue: 0,0:12:56.90,0:12:58.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana bisa?
Dialogue: 0,0:13:09.37,0:13:12.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beginilah rasanya\Nsaat kita merelakan sesuatu.
Dialogue: 0,0:13:19.00,0:13:20.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu sebentar!
Dialogue: 0,0:13:23.47,0:13:24.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Saku.
Dialogue: 0,0:13:25.01,0:13:27.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan lancang.
Dialogue: 0,0:13:28.22,0:13:32.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pikir kau siapa\Nsampai ikut campur pembicaraan ini?
Dialogue: 0,0:13:33.14,0:13:34.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja,
Dialogue: 0,0:13:34.39,0:13:38.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebagai adik kelas yang menghormatinya.
Dialogue: 0,0:13:39.82,0:13:41.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitukah? Kalau begitu,\Naku tak punya pilihan.
Dialogue: 0,0:13:41.94,0:13:44.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cukup. Duduklah.
Dialogue: 0,0:13:52.74,0:13:53.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya mohon.
Dialogue: 0,0:13:54.50,0:13:56.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong biarkan Asuka
Dialogue: 0,0:13:56.75,0:13:58.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pergi ke Tokyo!
Dialogue: 0,0:13:59.75,0:14:02.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya rasa alasan Anda benar.
Dialogue: 0,0:14:02.71,0:14:04.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, ini permintaan yang tidak masuk akal.
Dialogue: 0,0:14:04.59,0:14:06.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini hanya keegoisan saya sendiri.
Dialogue: 0,0:14:06.63,0:14:10.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya mau Kak Asu mengejar impiannya.
Dialogue: 0,0:14:10.93,0:14:13.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa mencintai sesuatu saja\Ntidak cukup untuk mengejarnya?
Dialogue: 0,0:14:13.68,0:14:16.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa dia tak boleh mencoba\Nkecuali ada bukti itu akan terwujud?
Dialogue: 0,0:14:17.14,0:14:20.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya mengerti\Nbahwa seiring bertambahnya usia,
Dialogue: 0,0:14:20.15,0:14:23.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita harus menyerah atau berkompromi.
Dialogue: 0,0:14:23.61,0:14:27.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, hanya kita yang bisa memutuskan\Nbagaimana impian kita berakhir.
Dialogue: 0,0:14:27.91,0:14:31.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika tidak, saat kita melihat orang\Nyang hidup dengan penuh semangat,
Dialogue: 0,0:14:31.20,0:14:34.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}orang yang berjuang mati-matian\Ndan bekerja keras...
Dialogue: 0,0:14:34.45,0:14:40.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita mungkin mulai merasa\Nhanya kita yang ditinggalkan dunia.
Dialogue: 0,0:14:40.25,0:14:41.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama seperti saya!
Dialogue: 0,0:14:42.13,0:14:45.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami masih mau percaya\Njika terus mengejarnya,
Dialogue: 0,0:14:47.01,0:14:50.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}suatu hari, kami akan bisa menyentuh bulan!
Dialogue: 0,0:14:52.72,0:14:55.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, saat impian Asuka hancur,
Dialogue: 0,0:14:55.97,0:14:58.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau mau bertanggung jawab?
Dialogue: 0,0:14:58.73,0:14:59.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:15:01.31,0:15:04.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena Anda\Ntidak memercayai putri Anda sendiri,
Dialogue: 0,0:15:04.98,0:15:05.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}biarkan saya...
Dialogue: 0,0:15:06.40,0:15:07.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan konyol!
Dialogue: 0,0:15:10.24,0:15:13.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih baik aku mati\Ndaripada menerima lamaran seperti itu.
Dialogue: 0,0:15:13.87,0:15:14.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau mau melakukannya,
Dialogue: 0,0:15:14.95,0:15:17.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lamar aku dengan benar sepuluh tahun lagi.
Dialogue: 0,0:15:20.25,0:15:21.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah memutuskan.
Dialogue: 0,0:15:21.92,0:15:24.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menjadi editor.
Dialogue: 0,0:15:25.84,0:15:27.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang mewujudkan impian
Dialogue: 0,0:15:27.97,0:15:31.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah mereka yang mengejarnya sampai akhir.
Dialogue: 0,0:15:31.89,0:15:34.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu fakta yang tak bisa disangkal siapa pun.
Dialogue: 0,0:15:35.43,0:15:36.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asuka...
Dialogue: 0,0:15:36.89,0:15:39.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, aku Asuka.
Dialogue: 0,0:15:39.64,0:15:42.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu nama berharga\Nyang Ayah berikan kepadaku.
Dialogue: 0,0:15:43.48,0:15:45.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agar layak menyandang nama itu,
Dialogue: 0,0:15:45.77,0:15:48.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan menjadi angin\Nyang menyambut hari esok.
Dialogue: 0,0:15:50.49,0:15:52.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika Ayah masih menolak,
Dialogue: 0,0:15:52.95,0:15:54.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sampai Ayah setuju,
Dialogue: 0,0:15:54.20,0:15:57.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tak akan bicara dengan Ayah\Nseumur hidupku.
Dialogue: 0,0:16:01.17,0:16:03.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau benar-benar kalah telak, Nishi.
Dialogue: 0,0:16:04.79,0:16:07.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak pernah mengira mendengar\Nkata-kata itu dari putriku sendiri
Dialogue: 0,0:16:07.75,0:16:09.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan sangat menyakitkan.
Dialogue: 0,0:16:09.51,0:16:11.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kalian keterlaluan.
Dialogue: 0,0:16:11.93,0:16:14.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah kalah, Asuka.
Dialogue: 0,0:16:14.89,0:16:17.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah pikir jika kau menyerah,\Nsemua akan berakhir.
Dialogue: 0,0:16:17.39,0:16:20.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sebabnya Ayah sengaja tetap tegas.
Dialogue: 0,0:16:20.85,0:16:21.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah...
Dialogue: 0,0:16:21.94,0:16:26.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dunia tak baik kepada pemimpi.
Dialogue: 0,0:16:27.40,0:16:28.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu,
Dialogue: 0,0:16:29.07,0:16:31.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mengancam tak mengakuimu
Dialogue: 0,0:16:31.65,0:16:34.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}itu cuma karena Ayah terbawa emosi.
Dialogue: 0,0:16:34.95,0:16:39.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah hanya orang dewasa membosankan\Nyang memilih masa depan praktis.
Dialogue: 0,0:16:40.33,0:16:42.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, Ayah
Dialogue: 0,0:16:42.92,0:16:46.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pernah mau menjadi musisi rock.
Dialogue: 0,0:16:50.34,0:16:53.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil! Benarkah?
Dialogue: 0,0:16:53.22,0:16:57.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, Ayah menyerah hanya karena\Nsatu kalimat, "Hadapi kenyataan."
Dialogue: 0,0:16:58.06,0:16:59.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti kata Chitose.
Dialogue: 0,0:16:59.72,0:17:03.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mencintai sesuatu saja sudah cukup\Nuntuk mengejarnya.
Dialogue: 0,0:17:03.44,0:17:06.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang kita butuhkan adalah tekad
Dialogue: 0,0:17:06.48,0:17:11.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk memercayai potensi kita,\Napa pun kata orang.
Dialogue: 0,0:17:11.35,0:17:12.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan begitu, Kura?
Dialogue: 0,0:17:15.49,0:17:17.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jalani hidupmu sesuai keinginanmu,
Dialogue: 0,0:17:17.86,0:17:19.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asuka.
Dialogue: 0,0:17:22.20,0:17:23.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:17:23.61,0:17:25.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong,
Dialogue: 0,0:17:25.42,0:17:28.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau belum berubah sedikit pun\Nsejak saat itu.
Dialogue: 0,0:17:29.38,0:17:31.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anda masih ingat?
Dialogue: 0,0:17:31.63,0:17:34.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana bisa seorang ayah melupakan
Dialogue: 0,0:17:34.42,0:17:36.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pria yang dua kali membawa kabur putrinya?
Dialogue: 0,0:17:36.89,0:17:39.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu...
Dialogue: 0,0:17:40.56,0:17:46.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah memercayai\Ndan mendukungnya.
Dialogue: 0,0:17:52.15,0:17:53.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau mau,
Dialogue: 0,0:17:53.94,0:17:55.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mampirlah ke rumah kami.
Dialogue: 0,0:17:57.49,0:18:00.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, terima kasih. Anda menakutkan, Pak.
Dialogue: 0,0:18:01.08,0:18:03.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sarkasme itu dapat nilai sempurna dariku.
Dialogue: 0,0:18:04.91,0:18:06.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang, pergilah.
Dialogue: 0,0:18:10.17,0:18:12.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat, Kak Asu.
Dialogue: 0,0:18:12.71,0:18:14.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wujudkan impianmu di Tokyo.
Dialogue: 0,0:18:16.09,0:18:18.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah kenapa,\Nitu terdengar seperti perpisahan.
Dialogue: 0,0:18:20.80,0:18:22.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti saat itu.
Dialogue: 0,0:18:23.35,0:18:27.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perasaan ini hanya kesepian biasa.
Dialogue: 0,0:18:28.31,0:18:30.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin tak akan pernah lagi
Dialogue: 0,0:18:30.23,0:18:33.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}diam-diam menunggumu\Ndi tempat biasa di tepi sungai,
Dialogue: 0,0:18:33.65,0:18:35.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}saat kau kelas 12.
Dialogue: 0,0:18:35.65,0:18:38.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak akan pernah berani\Nmengajakmu berkencan lagi.
Dialogue: 0,0:18:41.12,0:18:44.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Juga, aku tak akan pernah\Nmenjadi pengantinmu.
Dialogue: 0,0:18:44.62,0:18:47.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin itu.
Dialogue: 0,0:18:59.34,0:19:03.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Asu, kenapa wajahmu seperti itu?
Dialogue: 0,0:19:05.18,0:19:07.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau belum berubah sama sekali, Cengeng.
Dialogue: 0,0:19:08.64,0:19:12.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gerakan dan kata-kata nostalgia ini
Dialogue: 0,0:19:12.31,0:19:15.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tak berbeda dari musim panas yang jauh itu.
Dialogue: 0,0:19:16.11,0:19:18.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berjalan pulang bergandengan tangan\Nmelewati ladang.
Dialogue: 0,0:19:18.78,0:19:21.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gaun putihku menjadi kotor.
Dialogue: 0,0:19:21.66,0:19:25.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menatap kelereng di botol Ramune\Nbersama di festival.
Dialogue: 0,0:19:25.29,0:19:28.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidur berdampingan pada malam di Tokyo.
Dialogue: 0,0:19:28.21,0:19:31.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan saat ini.
Dialogue: 0,0:19:31.67,0:19:34.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia selalu mengawasiku,
Dialogue: 0,0:19:34.21,0:19:36.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menerangi jalan di depanku.
Dialogue: 0,0:19:36.96,0:19:42.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu besar, indah, cerah, dan baik.
Dialogue: 0,0:19:43.26,0:19:44.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau...
Dialogue: 0,0:19:45.14,0:19:46.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau adalah...
Dialogue: 0,0:19:47.39,0:19:49.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau adalah...
Dialogue: 0,0:19:49.89,0:19:51.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bulanku.
Dialogue: 0,0:19:54.06,0:19:55.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tidak benar.
Dialogue: 0,0:19:56.32,0:19:59.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat aku terjebak di dasar botol\Nyang tak bisa kubuka,
Dialogue: 0,0:19:59.99,0:20:03.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bulan yang bersinar begitu terang
Dialogue: 0,0:20:03.91,0:20:05.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah kau.
Dialogue: 0,0:20:11.92,0:20:14.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan bekerja keras
Dialogue: 0,0:20:15.25,0:20:17.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mewujudkan impianku di Tokyo.
Dialogue: 0,0:20:18.05,0:20:25.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kubuktikan bahwa cahayamu\Nsungguh menerangiku.
Dialogue: 0,0:20:28.22,0:20:30.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga berhasil, Kak Asu.
Dialogue: 0,0:20:31.02,0:20:33.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pasti bisa.
Dialogue: 0,0:20:33.94,0:20:35.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan menyerah.
Dialogue: 0,0:20:41.28,0:20:43.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agar aku tak berbalik lari kembali kepadamu,
Dialogue: 0,0:20:43.45,0:20:46.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tak akan menangis karena kesepian lagi.
Dialogue: 0,0:20:47.03,0:20:48.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agar tidak tersesat
Dialogue: 0,0:20:49.59,0:20:54.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan hanya mengandalkanmu,\Naku akan meninggalkan semua perasaan
Dialogue: 0,0:20:54.75,0:20:57.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang kubawa seumur hidupku
Dialogue: 0,0:20:57.25,0:20:59.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di sini.
Dialogue: 0,0:21:09.56,0:21:11.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai sekarang,
Dialogue: 0,0:21:11.48,0:21:14.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin akan ada lebih banyak sisi Asuka\Nyang tidak kuketahui.
Dialogue: 0,0:21:16.15,0:21:17.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di kota yang jauh,
Dialogue: 0,0:21:18.07,0:21:20.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di bawah langit yang jauh,
Dialogue: 0,0:21:20.65,0:21:23.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}diliputi malam yang jauh.
Dialogue: 0,0:21:30.62,0:21:32.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sembilan bulan lagi, ya...
Dialogue: 0,0:21:33.21,0:21:34.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku...
Dialogue: 0,0:21:35.62,0:21:38.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari semua hal yang sangat ingin\Nkulakukan sebelum lulus...
Dialogue: 0,0:21:38.79,0:21:40.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku sudah menyelesaikan satu.
Dialogue: 0,0:21:40.92,0:21:42.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kali ini...
Dialogue: 0,0:21:44.30,0:21:45.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kali ini, pasti...
Dialogue: 0,0:21:45.84,0:21:50.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan menjadi satu-satunya cahaya\Nyang tak bisa dihindari orang-orang,
Dialogue: 0,0:21:50.14,0:21:53.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bahkan dari jauh.
Dialogue: 0,0:21:53.64,0:21:57.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersama seluruh bagian diriku\Nyang mengagumi Kak Saku,
Dialogue: 0,0:21:57.35,0:22:02.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan seluruh bagian dari diriku\Nyang kau kagumi.
Dialogue: 0,0:22:10.08,0:22:12.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat bunga sakura mekar berikutnya...
Dialogue: 0,0:22:22.71,0:22:27.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}seperti apa ekspresi kami saat berpisah?
Dialogue: 0,0:22:34.35,0:22:38.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam perjalanan pulang, aku menatap bulan.
Dialogue: 0,0:22:39.35,0:22:42.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bulan yang pernah kusentuh
Dialogue: 0,0:22:42.15,0:22:45.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak hanya tersenyum lembut.
Dialogue: 0,0:22:46.28,0:22:51.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ia memikul semua harapan\Ndan keinginan seseorang.
Dialogue: 0,0:22:51.95,0:22:55.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ia masih berjuang sekuat tenaga\Nuntuk menunjukkan jati dirinya.
Dialogue: 0,0:22:57.46,0:23:00.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setiap orang pasti menjadi bulan\Nbagi seseorang.
Dialogue: 0,0:23:01.71,0:23:06.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, jika kau tersesat lagi,\Nseperti hari itu,
Dialogue: 0,0:23:06.63,0:23:08.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}panggil namaku.
Dialogue: 0,0:23:08.72,0:23:11.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Panggil "Kak Asu".
Dialogue: 0,0:23:11.60,0:23:15.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesakit atau sesedih apa pun ceritanya,
Dialogue: 0,0:23:15.60,0:23:19.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan mengubahnya\Nmenjadi akhir yang bahagia.
Dialogue: 0,0:23:19.69,0:23:25.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan mengusir kegelapan\Nsaat kau mencoba berani sendirian.
Dialogue: 0,0:23:26.53,0:23:32.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bolehkah aku menjadi bulanmu?
Dialogue: 0,0:23:37.96,0:23:39.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Pintu Menuju Musim Panas."
