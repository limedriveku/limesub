Dialogue: 0,0:01:32.05,0:01:33.46,sign,,0000,0000,0000,,{\an8}KISAH INI FIKSI, SEMUA NAMA TOKOH\NDAN ORGANISASINYA JUGA FIKTIF.
Dialogue: 0,0:01:33.46,0:01:34.92,sign,,0000,0000,0000,,{\an8}SELAIN ITU, KISAH INI TAK ADA HUBUNGANNYA\NDENGAN INSIDEN ATAU PERISTIWA NYATA.
Dialogue: 0,0:23:46.09,0:23:49.05,sign,,0000,0000,0000,,CUPLIKAN EPISODE SELANJUTNYA
Dialogue: 0,0:01:42.93,0:01:45.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti yang kuduga, Luomen.
Dialogue: 0,0:01:45.64,0:01:49.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bisa membuat\Nobat apa pun dengan mahir.
Dialogue: 0,0:01:50.06,0:01:52.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua berkat bantuanmu, Guen.
Dialogue: 0,0:01:52.86,0:01:55.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh? Astaga...
Dialogue: 0,0:01:55.49,0:01:58.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang kau datang, Luomen.
Dialogue: 0,0:01:58.36,0:02:02.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terutama karena Nona dan temannya\Ntelah selesai...
Dialogue: 0,0:02:04.62,0:02:05.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi.
Dialogue: 0,0:02:06.16,0:02:07.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ditujukan kepada Tuan Guen.
Dialogue: 0,0:02:08.67,0:02:11.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga, kira-kira apa isinya, ya?
Dialogue: 0,0:02:20.93,0:02:23.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Baiklah, bagaimana ini?{\i0}
Dialogue: 0,0:02:23.22,0:02:28.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kenapa Tuan Jinshi\Nselalu ingin menggangguku?{\i0}
Dialogue: 0,0:02:28.02,0:02:30.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku tak bisa menolak meski ingin.{\i0}
Dialogue: 0,0:02:35.53,0:02:38.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bagaimana aku bisa membujuk Nenek?{\i0}
Dialogue: 0,0:02:46.74,0:02:51.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Moci herbal...
Dialogue: 0,0:02:52.67,0:02:54.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Moci herbal...\N- Berhenti.
Dialogue: 0,0:02:55.46,0:02:56.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa denganmu?
Dialogue: 0,0:02:59.26,0:03:01.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pasti pergi terlalu jauh
Dialogue: 0,0:03:01.59,0:03:04.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hingga bisa menemukan upas puan di sini.
Dialogue: 0,0:03:04.60,0:03:06.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Ini bukan hia?
Dialogue: 0,0:03:06.97,0:03:08.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mirip, tetapi berbeda.
Dialogue: 0,0:03:08.68,0:03:10.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menambahkan ini ke moci bisa mematikan.
Dialogue: 0,0:03:10.81,0:03:12.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:03:12.19,0:03:13.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu moci herbalnya?
Dialogue: 0,0:03:13.81,0:03:14.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyerahlah.
Dialogue: 0,0:03:16.65,0:03:19.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berikan kami hia, Bintik.
Dialogue: 0,0:03:19.28,0:03:21.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah kau petik kemarin?
Dialogue: 0,0:03:22.03,0:03:24.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menggunakannya untuk moksibusi.
Dialogue: 0,0:03:24.07,0:03:25.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelit.
Dialogue: 0,0:03:27.74,0:03:28.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau jahat!
Dialogue: 0,0:03:28.70,0:03:30.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa aku jahat?
Dialogue: 0,0:03:30.66,0:03:33.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah sudah kubilang\Njangan berkeliaran di luar?
Dialogue: 0,0:03:34.83,0:03:37.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Sazen juga ada di sana.
Dialogue: 0,0:03:38.50,0:03:40.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong jangan lari meninggalkanku!
Dialogue: 0,0:03:41.55,0:03:43.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak muda lagi.
Dialogue: 0,0:03:43.89,0:03:46.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jika aku tak bisa menyadarkan\Nanak-anak ini,{\i0}
Dialogue: 0,0:03:46.39,0:03:49.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}aku harus beri pelajaran\Nkepada orang dewasa yang mengawasi mereka.{\i0}
Dialogue: 0,0:03:51.06,0:03:52.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu sebentar.
Dialogue: 0,0:03:57.90,0:03:58.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat.
Dialogue: 0,0:03:59.32,0:04:00.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tahu ini apa?
Dialogue: 0,0:04:03.53,0:04:06.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hia dan upas puan, bukan?
Dialogue: 0,0:04:07.33,0:04:10.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berniat menggantinya diam-diam,
Dialogue: 0,0:04:10.87,0:04:12.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tetapi mereka kabur dariku.
Dialogue: 0,0:04:12.75,0:04:14.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini.
Dialogue: 0,0:04:14.83,0:04:16.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini hia!
Dialogue: 0,0:04:17.96,0:04:18.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo!
Dialogue: 0,0:04:20.80,0:04:22.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini untukmu.
Dialogue: 0,0:04:23.17,0:04:25.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akar upas puan.
Dialogue: 0,0:04:25.51,0:04:27.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini berbahaya, jadi, aku mencabutnya.
Dialogue: 0,0:04:27.76,0:04:30.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bisa keringkan ini\Ndan gunakan sebagai obat mentah, bukan?
Dialogue: 0,0:04:30.89,0:04:32.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akar umbi upas puan.
Dialogue: 0,0:04:32.64,0:04:34.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayang sekali jika dibiarkan mati.
Dialogue: 0,0:04:34.81,0:04:37.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa katanya?{\i0}
Dialogue: 0,0:04:37.40,0:04:41.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kenapa dia tahu nama obat mentah\Ndari akar upas puan kering?{\i0}
Dialogue: 0,0:04:41.78,0:04:44.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti ada yang suka bunga indah
Dialogue: 0,0:04:44.61,0:04:47.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan membawanya dari gunung\Nuntuk ditanam di sini...
Dialogue: 0,0:04:53.58,0:04:54.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini?
Dialogue: 0,0:04:56.08,0:04:57.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daun biwa, bukan?
Dialogue: 0,0:04:57.54,0:04:58.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa gunanya?
Dialogue: 0,0:04:58.46,0:05:01.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin digunakan\Nuntuk mengobati batuk dan diare.
Dialogue: 0,0:05:01.75,0:05:03.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hal lain juga.
Dialogue: 0,0:05:03.01,0:05:04.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu yang ini?
Dialogue: 0,0:05:04.09,0:05:06.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benang emas. Bagus untuk perut dan usus.
Dialogue: 0,0:05:06.63,0:05:08.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Obat penenang juga, bukan?
Dialogue: 0,0:05:08.85,0:05:10.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana dengan ini?
Dialogue: 0,0:05:10.01,0:05:11.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu daun sendok.
Dialogue: 0,0:05:12.02,0:05:14.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, kenapa kita melakukan ini?
Dialogue: 0,0:05:14.31,0:05:15.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teruskan saja.
Dialogue: 0,0:05:19.15,0:05:22.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tahu sekitar setengah dari ini, ya?
Dialogue: 0,0:05:23.36,0:05:25.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh, ada apa ini?
Dialogue: 0,0:05:25.57,0:05:27.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah belajar membaca?
Dialogue: 0,0:05:27.82,0:05:29.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Ya.
Dialogue: 0,0:05:29.49,0:05:31.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari pria tua di benteng.
Dialogue: 0,0:05:31.33,0:05:34.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa dia juga mengajarimu\Ntentang tanaman obat ini?
Dialogue: 0,0:05:34.83,0:05:35.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:05:36.33,0:05:37.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, aku paham.
Dialogue: 0,0:05:38.33,0:05:40.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Salah perhitungan yang berguna.{\i0}
Dialogue: 0,0:05:40.21,0:05:42.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kursus kilat mungkin berhasil.{\i0}
Dialogue: 0,0:05:42.34,0:05:44.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, hafalkan ini.
Dialogue: 0,0:05:45.47,0:05:48.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya mulai datang ke sini\Ndi siang hari.
Dialogue: 0,0:05:48.22,0:05:50.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Namun, aku ada pekerjaan!
Dialogue: 0,0:05:50.30,0:05:53.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kujelaskan kepada Nenek dan Ukyou.
Dialogue: 0,0:05:53.26,0:05:57.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tugas pelayan bukan keahlianmu, bukan?
Dialogue: 0,0:05:58.14,0:06:00.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa bukan...
Dialogue: 0,0:06:00.94,0:06:04.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah kau lebih cocok\Nuntuk pekerjaan apoteker?
Dialogue: 0,0:06:05.23,0:06:07.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Karena koneksiku dengan Tuan Jinshi,{\i0}
Dialogue: 0,0:06:07.57,0:06:09.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}aku sering bepergian.{\i0}
Dialogue: 0,0:06:09.95,0:06:12.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Akan membantu jika Sazen menjadi apoteker.{\i0}
Dialogue: 0,0:06:14.41,0:06:16.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya petani.
Dialogue: 0,0:06:17.41,0:06:20.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pergi ke benteng itu karena putus asa.
Dialogue: 0,0:06:28.67,0:06:30.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya tahu tanaman obat
Dialogue: 0,0:06:30.76,0:06:33.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena pria tua itu\Nmenyuruhku mengumpulkannya.
Dialogue: 0,0:06:33.22,0:06:34.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Apa maksudmu?\N- Apa?
Dialogue: 0,0:06:35.35,0:06:38.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang mencari nafkah\Ndengan mantra aneh untuk mengobati flu.
Dialogue: 0,0:06:38.98,0:06:40.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dibandingkan dengan mereka,
Dialogue: 0,0:06:40.60,0:06:42.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}setidaknya kau bisa\Nmembuat antipiretik, bukan?
Dialogue: 0,0:06:43.52,0:06:45.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa begitu.
Dialogue: 0,0:06:45.27,0:06:46.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, bukan penyakit parah...
Dialogue: 0,0:06:46.82,0:06:50.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika tak bisa berbuat sesuatu, jujur saja.
Dialogue: 0,0:06:51.78,0:06:54.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minum obat atau tidak,
Dialogue: 0,0:06:54.16,0:06:55.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang ditakdirkan mati akan mati.
Dialogue: 0,0:06:55.99,0:06:57.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika tak bisa mendiagnosis,
Dialogue: 0,0:06:57.41,0:06:58.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}biar orang lain menanganinya.
Dialogue: 0,0:06:59.50,0:07:03.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau lebih mahir membuat obat\Ndaripada banyak tabib asli di luar sana.
Dialogue: 0,0:07:03.38,0:07:05.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tabib gadungan, misalnya.{\i0}
Dialogue: 0,0:07:05.88,0:07:07.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, beres.
Dialogue: 0,0:07:11.13,0:07:12.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hafalkan semua ini.
Dialogue: 0,0:07:12.93,0:07:14.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kuberi tahu Nenek.
Dialogue: 0,0:07:15.47,0:07:17.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah ini terlalu mendadak?
Dialogue: 0,0:07:17.85,0:07:20.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan buang waktu.
Dialogue: 0,0:07:24.27,0:07:25.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Seperti dugaan,{\i0}
Dialogue: 0,0:07:25.73,0:07:28.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sazen cepat belajar.{\i0}
Dialogue: 0,0:07:28.78,0:07:31.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia bisa dengan mudah menghapal\Nperacikan sederhana{\i0}
Dialogue: 0,0:07:31.36,0:07:34.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dan mengikuti gambar, meski ceroboh.{\i0}
Dialogue: 0,0:07:35.74,0:07:38.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku juga mengajarkan ini kepada Chou-u,{\i0}
Dialogue: 0,0:07:38.45,0:07:40.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}tetapi bocah itu sama sekali tak tertarik.{\i0}
Dialogue: 0,0:07:50.88,0:07:53.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kubawa obat ini ke toko sebelah.
Dialogue: 0,0:07:53.30,0:07:54.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:07:56.39,0:07:58.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini mungkin berhasil.
Dialogue: 0,0:08:04.40,0:08:06.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau ada di sini?
Dialogue: 0,0:08:09.11,0:08:12.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maomao sayang! Tunggu aku!
Dialogue: 0,0:08:16.99,0:08:20.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona! Lama tak jumpa.
Dialogue: 0,0:08:28.04,0:08:29.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya aku bisa mengatur napas.
Dialogue: 0,0:08:29.92,0:08:32.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau datang ke sini?
Dialogue: 0,0:08:32.63,0:08:34.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pekerjaanmu di istana harem...
Dialogue: 0,0:08:35.09,0:08:37.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa mereka akhirnya memecatnya?{\i0}
Dialogue: 0,0:08:37.43,0:08:41.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia baik,\Ntetapi gajinya tak layak dibayarkan.{\i0}
Dialogue: 0,0:08:41.18,0:08:42.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lupakan.
Dialogue: 0,0:08:43.10,0:08:46.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau salah paham, Nona?
Dialogue: 0,0:08:46.56,0:08:48.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku diberi waktu liburan
Dialogue: 0,0:08:48.65,0:08:51.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan izin untuk pulang yang kunantikan.
Dialogue: 0,0:08:52.94,0:08:54.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka mengirimmu pulang, ya?
Dialogue: 0,0:08:54.90,0:08:56.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ucapanmu seolah aku diusir.
Dialogue: 0,0:08:57.24,0:09:00.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memang harus menyetujui\Nsyarat aneh untuk pulang.
Dialogue: 0,0:09:00.91,0:09:03.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau dengar sesuatu, Nona?
Dialogue: 0,0:09:04.41,0:09:06.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syarat apa?
Dialogue: 0,0:09:06.08,0:09:10.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar ada seseorang\Nyang ingin ikut perjalananku
Dialogue: 0,0:09:10.29,0:09:12.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atas permintaan kepala kasim.
Dialogue: 0,0:09:12.55,0:09:14.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya, dia orang penting.
Dialogue: 0,0:09:14.51,0:09:17.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami akan bertemu di toko ini.
Dialogue: 0,0:09:17.59,0:09:18.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh?
Dialogue: 0,0:09:19.89,0:09:23.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kukira aku punya waktu lebih lama.{\i0}
Dialogue: 0,0:09:25.31,0:09:28.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}"Aku akan pergi sebentar. Temani aku."{\i0}
Dialogue: 0,0:09:29.44,0:09:31.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Surat Tuan Jinshi agak berat sebelah.{\i0}
Dialogue: 0,0:09:31.90,0:09:33.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tak ada waktu atau tempat.{\i0}
Dialogue: 0,0:09:33.40,0:09:35.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia bahkan tak menulis\Ntanggal keberangkatan.{\i0}
Dialogue: 0,0:09:36.70,0:09:41.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu sebabnya aku mengajari Sazen\Ntentang obat dengan sangat cepat.{\i0}
Dialogue: 0,0:09:41.33,0:09:44.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku juga menyiapkan obat\Nuntuk ditinggalkan.{\i0}
Dialogue: 0,0:09:44.33,0:09:45.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun, tetap saja,{\i0}
Dialogue: 0,0:09:45.37,0:09:47.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}kenapa dia bepergian\Ndengan tabib gadungan?{\i0}
Dialogue: 0,0:09:47.71,0:09:48.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Juga...{\i0}
Dialogue: 0,0:09:51.50,0:09:52.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada kucing!
Dialogue: 0,0:09:54.38,0:09:55.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh!
Dialogue: 0,0:09:56.09,0:09:57.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu!
Dialogue: 0,0:09:58.97,0:10:00.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari makan!
Dialogue: 0,0:10:05.68,0:10:07.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa ini?
Dialogue: 0,0:10:10.23,0:10:11.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei!
Dialogue: 0,0:10:11.73,0:10:14.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa dengan kucing ini?
Dialogue: 0,0:10:14.28,0:10:15.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ruang makan.
Dialogue: 0,0:10:21.78,0:10:23.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa kau, Pak Tua?
Dialogue: 0,0:10:23.87,0:10:25.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga, maafkan aku.
Dialogue: 0,0:10:25.95,0:10:28.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kucing nakal! Jangan begitu, Maomao.
Dialogue: 0,0:10:30.00,0:10:32.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Maomao"? Nama macam apa itu?
Dialogue: 0,0:10:32.42,0:10:33.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diam.
Dialogue: 0,0:10:34.84,0:10:36.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jaga makhluk ini.
Dialogue: 0,0:10:38.13,0:10:39.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sampai dia kabur.
Dialogue: 0,0:10:39.51,0:10:40.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu!
Dialogue: 0,0:10:41.72,0:10:44.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuputuskan agar keluarga di rumah\Nmengurus Maomao.
Dialogue: 0,0:10:45.68,0:10:50.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak ada orang lain di istana harem\Nyang bisa mengurus hewan peliharaan.
Dialogue: 0,0:10:50.31,0:10:54.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putri Lingli meninggalkan istana harem\Ndengan Permaisuri Gyokuyou juga, bukan?
Dialogue: 0,0:10:54.36,0:10:57.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya mereka tak bisa membawa Maomao.
Dialogue: 0,0:10:57.65,0:11:00.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tak seperti istana harem,\Nkurasa tak ada yang mengizinkannya.{\i0}
Dialogue: 0,0:11:00.99,0:11:03.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aturannya tampak sangat ketat.{\i0}
Dialogue: 0,0:11:03.12,0:11:05.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, adik perempuanku mau.
Dialogue: 0,0:11:05.37,0:11:08.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia berharap kucing\Nakan menyelesaikan masalah tikusnya.
Dialogue: 0,0:11:09.83,0:11:14.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Adik yang mengirim surat itu\Nsaat kita membicarakan pembuatan kertas?{\i0}
Dialogue: 0,0:11:14.84,0:11:16.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:11:16.21,0:11:19.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku agak cemas\Ndengan surat lain yang dia kirim.
Dialogue: 0,0:11:19.76,0:11:20.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa katanya?
Dialogue: 0,0:11:21.22,0:11:25.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak bisa membahasnya di sini,\Nakan kujelaskan di desa.
Dialogue: 0,0:11:31.23,0:11:32.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap berangkat?
Dialogue: 0,0:11:38.65,0:11:41.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Basen, kau berpakaian seperti...
Dialogue: 0,0:11:43.16,0:11:45.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudmu, "siap"?
Dialogue: 0,0:11:45.24,0:11:46.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah ini terlalu mendadak?
Dialogue: 0,0:11:46.95,0:11:49.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami punya alasan.
Dialogue: 0,0:11:49.91,0:11:53.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Alasan yang membutuhkan penyamaran matang.{\i0}
Dialogue: 0,0:11:58.34,0:11:59.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bagus.{\i0}
Dialogue: 0,0:11:59.96,0:12:02.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia bersikap seperti ajudan Tuan Basen.{\i0}
Dialogue: 0,0:12:02.72,0:12:05.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tabib gadungan tak menyadari apa pun.{\i0}
Dialogue: 0,0:12:05.76,0:12:08.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Seperti dugaan,\NTuan Basen tampak canggung.{\i0}
Dialogue: 0,0:12:08.76,0:12:10.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Naiklah ke kereta juga.
Dialogue: 0,0:12:10.22,0:12:12.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami sudah siapkan barangmu.
Dialogue: 0,0:12:13.64,0:12:14.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:12:14.90,0:12:16.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jika menyamar,{\i0}
Dialogue: 0,0:12:16.48,0:12:18.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}mungkin perjalanan ini akan panjang.{\i0}
Dialogue: 0,0:12:23.53,0:12:26.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kasihan. Dia sudah cukup sibuk.{\i0}
Dialogue: 0,0:12:26.20,0:12:27.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kaisar sungguh tak ragu{\i0}
Dialogue: 0,0:12:27.99,0:12:30.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}untuk memerintah adiknya.{\i0}
Dialogue: 0,0:12:31.20,0:12:34.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Seolah dia membesarkan pewarisnya sendiri...{\i0}
Dialogue: 0,0:12:36.54,0:12:37.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku akan berhenti...{\i0}
Dialogue: 0,0:12:38.71,0:12:40.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sudah ada putra mahkota.{\i0}
Dialogue: 0,0:12:40.92,0:12:43.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Selir Lihua juga punya putra.{\i0}
Dialogue: 0,0:12:43.63,0:12:45.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kaisar juga masih muda.{\i0}
Dialogue: 0,0:12:55.77,0:12:58.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jangan pikirkan hal-hal yang mengganggu.{\i0}
Dialogue: 0,0:13:03.44,0:13:05.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Setelah dua hari di kereta yang bergoyang,{\i0}
Dialogue: 0,0:13:06.28,0:13:10.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}kami tiba di desa tabib\Ndi barat daya ibu kota.{\i0}
Dialogue: 0,0:13:15.08,0:13:16.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu barli.
Dialogue: 0,0:13:18.21,0:13:21.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sistem irigasi kalian sangat teratur.
Dialogue: 0,0:13:21.30,0:13:23.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu untuk tumbuhan musim panas.
Dialogue: 0,0:13:23.76,0:13:24.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padi dan barli.
Dialogue: 0,0:13:24.97,0:13:27.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami dua kali panen dalam setahun.
Dialogue: 0,0:13:27.26,0:13:28.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan sawah,
Dialogue: 0,0:13:28.39,0:13:31.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami bisa menanam di lahan yang sama\Ntanpa menguras tanah.
Dialogue: 0,0:13:31.68,0:13:33.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lahan yang melimpah.
Dialogue: 0,0:13:34.27,0:13:37.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan sungai di dekat sini,\Ntransportasi juga tampak mudah.
Dialogue: 0,0:13:39.73,0:13:42.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia tak terbiasa dengan kucing?{\i0}
Dialogue: 0,0:13:42.53,0:13:44.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Satu hal lagi yang tak dia kuasai.{\i0}
Dialogue: 0,0:13:52.79,0:13:54.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa itu?{\i0}
Dialogue: 0,0:14:05.88,0:14:08.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata kakakku. Selamat datang di rumah.
Dialogue: 0,0:14:10.43,0:14:12.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pulang.
Dialogue: 0,0:14:12.97,0:14:15.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini kucing yang kau maksud?
Dialogue: 0,0:14:17.98,0:14:20.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga, manis sekali.
Dialogue: 0,0:14:21.19,0:14:24.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang lebih penting, apa mereka ini tamumu?
Dialogue: 0,0:14:24.53,0:14:26.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya...
Dialogue: 0,0:14:26.28,0:14:28.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:14:28.74,0:14:31.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengawas kerja dan pembantumu?
Dialogue: 0,0:14:31.37,0:14:32.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}"Pembantu," ya?{\i0}
Dialogue: 0,0:14:34.66,0:14:36.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih telah menerima kami.
Dialogue: 0,0:14:36.87,0:14:40.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan senang hati. Anggap rumah sendiri.
Dialogue: 0,0:14:44.13,0:14:45.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Menggiurkan...{\i0}
Dialogue: 0,0:14:45.25,0:14:47.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh.
Dialogue: 0,0:14:47.05,0:14:49.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kakakku seorang kasim,
Dialogue: 0,0:14:49.59,0:14:53.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku terkejut dia membawa pulang\Nistri yang masih muda.
Dialogue: 0,0:14:54.64,0:14:56.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu bukan.
Dialogue: 0,0:14:56.31,0:14:57.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah pasti bukan.
Dialogue: 0,0:15:05.90,0:15:08.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga. Kau baik-baik saja?
Dialogue: 0,0:15:15.62,0:15:20.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jika dia pura-pura jadi ajudan, seharusnya\Ndia menyiapkan makanan untuk di kereta.{\i0}
Dialogue: 0,0:15:20.62,0:15:23.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tuan Basen tak akan biarkan, ya?{\i0}
Dialogue: 0,0:15:23.63,0:15:25.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Penyamarannya sempurna.{\i0}
Dialogue: 0,0:15:25.71,0:15:28.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Semoga dia tidak ketahuan.{\i0}
Dialogue: 0,0:15:29.76,0:15:31.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kembali.
Dialogue: 0,0:15:31.22,0:15:33.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kelaparan.
Dialogue: 0,0:15:33.34,0:15:35.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak Ipar! Lama tak jumpa.
Dialogue: 0,0:15:36.14,0:15:37.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh lama.
Dialogue: 0,0:15:37.72,0:15:39.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senang bertemu, Paman.
Dialogue: 0,0:15:39.93,0:15:43.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Astaga, kau sudah besar sekali.
Dialogue: 0,0:15:53.45,0:15:56.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nak! Kau bahkan tidak memberi salam?
Dialogue: 0,0:15:57.24,0:15:58.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak...
Dialogue: 0,0:15:59.24,0:16:01.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Keponakan tabib, ya?{\i0}
Dialogue: 0,0:16:01.83,0:16:04.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Yang lebih tua bersikap buruk.{\i0}
Dialogue: 0,0:16:04.88,0:16:08.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paman seorang kasim\Nyang sudah lama tak pulang.
Dialogue: 0,0:16:09.00,0:16:11.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa mengundangnya ke sini sekarang?
Dialogue: 0,0:16:11.63,0:16:15.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apalagi dia membawa banyak tamu.
Dialogue: 0,0:16:15.22,0:16:16.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak sopan!
Dialogue: 0,0:16:26.94,0:16:29.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kumakan ini sebelum dingin.
Dialogue: 0,0:16:36.12,0:16:37.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di mana supku?
Dialogue: 0,0:16:37.28,0:16:39.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang harus kau katakan dahulu.
Dialogue: 0,0:16:45.50,0:16:51.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf. Anak itu tak sadar betapa banyak\Nyang kau lakukan untuk desa ini.
Dialogue: 0,0:16:52.05,0:16:53.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak apa-apa.
Dialogue: 0,0:16:53.22,0:16:55.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku terbiasa diperlakukan seperti ini.
Dialogue: 0,0:16:57.97,0:17:00.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Seingatku,{\i0}
Dialogue: 0,0:17:00.01,0:17:03.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}tabib gadungan masuk istana harem\Nuntuk menggantikannya.{\i0}
Dialogue: 0,0:17:03.85,0:17:05.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tak heran dia merasa buruk.{\i0}
Dialogue: 0,0:17:06.60,0:17:07.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun...
Dialogue: 0,0:17:11.73,0:17:14.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami minta maaf karena tiba-tiba datang.
Dialogue: 0,0:17:16.11,0:17:17.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong,
Dialogue: 0,0:17:17.36,0:17:20.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ada alasan kalian mengundangku, bukan?
Dialogue: 0,0:17:20.49,0:17:23.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang ingin kalian bicarakan?
Dialogue: 0,0:17:24.91,0:17:28.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, kami ingin\Nmeminta bantuan kepada Kaisar.
Dialogue: 0,0:17:28.88,0:17:29.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:17:30.67,0:17:34.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tabib terkenal yang membantu\Nmelahirkan anak Kaisar, bukan?
Dialogue: 0,0:17:43.56,0:17:45.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu sebenarnya ayahku.{\i0}
Dialogue: 0,0:17:45.89,0:17:49.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kurasa dia mengakuinya\Ndan membesar-besarkannya di keluarganya.{\i0}
Dialogue: 0,0:17:49.19,0:17:51.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku akan tutup mulut.{\i0}
Dialogue: 0,0:17:51.82,0:17:53.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun, ada yang bingung...{\i0}
Dialogue: 0,0:17:54.15,0:17:58.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian mau aku membuat permintaan?\NAku tak mampu melakukan itu!
Dialogue: 0,0:17:59.57,0:18:00.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama sekali tak bisa?
Dialogue: 0,0:18:03.49,0:18:05.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak bisa bicara dengan Kaisar,
Dialogue: 0,0:18:05.62,0:18:08.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tetapi mungkin aku bisa minta orang lain.
Dialogue: 0,0:18:08.25,0:18:09.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa permintaan kalian?
Dialogue: 0,0:18:17.72,0:18:19.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beri tahu kami.
Dialogue: 0,0:18:19.76,0:18:22.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, entah apakah kami bisa membantu.
Dialogue: 0,0:18:22.14,0:18:23.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak apa-apa.
Dialogue: 0,0:18:23.60,0:18:26.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka orang tepercaya.
Dialogue: 0,0:18:28.06,0:18:29.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:18:33.15,0:18:37.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami ingin membahas\Nkepemilikan tanah di desa ini.
Dialogue: 0,0:18:37.99,0:18:40.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Desa ini awalnya merupakan tanah pinjaman.
Dialogue: 0,0:18:41.57,0:18:43.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Menurut sang suami,{\i0}
Dialogue: 0,0:18:43.20,0:18:45.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}tuan tanah sebelumnya cukup murah hati.{\i0}
Dialogue: 0,0:18:45.83,0:18:47.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sewa tanah ini murah{\i0}
Dialogue: 0,0:18:47.29,0:18:49.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}karena tak ada yang menggunakannya.{\i0}
Dialogue: 0,0:18:49.83,0:18:52.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Lalu, setelah bertahun-tahun\Ntinggal di sini,{\i0}
Dialogue: 0,0:18:52.71,0:18:55.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}mereka melanjutkan\Ndengan membeli tanah ini.{\i0}
Dialogue: 0,0:18:57.34,0:18:58.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mereka menandatangani dokumen{\i0}
Dialogue: 0,0:18:58.84,0:19:01.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}pemindahan tanah dan hutan desa\Ndalam 20 tahun.{\i0}
Dialogue: 0,0:19:01.84,0:19:04.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pembayaran juga dilakukan tanpa menunda.{\i0}
Dialogue: 0,0:19:06.52,0:19:07.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun, beberapa tahun lalu,{\i0}
Dialogue: 0,0:19:08.39,0:19:10.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}tuan tanah sebelumnya meninggal.{\i0}
Dialogue: 0,0:19:10.60,0:19:14.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Keadaan berubah\Nsaat putranya mengambil alih warisan.{\i0}
Dialogue: 0,0:19:14.61,0:19:17.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tuan tanah baru membenci orang luar{\i0}
Dialogue: 0,0:19:17.65,0:19:20.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dan tampaknya bahkan mengejek pedagang.{\i0}
Dialogue: 0,0:19:21.11,0:19:25.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mungkin dia tidak suka\Nkertas buatan mereka dipasok ke istana.{\i0}
Dialogue: 0,0:19:25.62,0:19:28.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Saat kualitas kertas mereka menurun,{\i0}
Dialogue: 0,0:19:28.37,0:19:31.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dia datang berulang kali\Nuntuk meminta pembayaran utang.{\i0}
Dialogue: 0,0:19:33.21,0:19:36.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah kenapa, dia selalu mengkritik kami.
Dialogue: 0,0:19:36.92,0:19:41.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia menyalahkan kami atas panen padi\Nyang buruk karena kami "mencemari air"
Dialogue: 0,0:19:41.18,0:19:44.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan berkata tak ada air lagi\Nuntuk menanam padi.
Dialogue: 0,0:19:45.22,0:19:48.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, kali ini,\Nlebih buruk dari biasanya.
Dialogue: 0,0:19:48.52,0:19:49.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia ingin uang cepat.
Dialogue: 0,0:19:49.85,0:19:52.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia menyuruh kami pergi\Njika tak bisa bayar.
Dialogue: 0,0:19:53.40,0:19:55.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berapa tahun lagi pembayarannya?
Dialogue: 0,0:19:56.19,0:19:57.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lima tahun.
Dialogue: 0,0:19:57.40,0:19:59.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami tak bisa\Nmembayar semua itu sekaligus.
Dialogue: 0,0:20:00.24,0:20:03.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan tanah saat ini\Ningin membuat kertas sendiri.
Dialogue: 0,0:20:03.86,0:20:07.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa begitu?\NItu pekerjaan untuk profesional.
Dialogue: 0,0:20:07.91,0:20:12.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena pajak atas biji-bijian\Ntiba-tiba melonjak tahun ini.
Dialogue: 0,0:20:13.71,0:20:17.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaliknya, pajak pembuatan kertas\Nlebih murah daripada dua tahun sebelumnya.
Dialogue: 0,0:20:17.59,0:20:19.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sangat menyebalkan.
Dialogue: 0,0:20:20.88,0:20:24.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kutebak pajak kertas diturunkan\Nuntuk meningkatkan literasi.{\i0}
Dialogue: 0,0:20:25.26,0:20:29.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mungkin pajak biji-bijian dinaikkan\Nuntuk melawan wabah belalang kembara.{\i0}
Dialogue: 0,0:20:29.97,0:20:33.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dengan hasil panen ganda di sini,{\i0}
Dialogue: 0,0:20:33.23,0:20:35.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}kenaikan pajak\Nseharusnya tak menyebabkan kemiskinan.{\i0}
Dialogue: 0,0:20:36.86,0:20:38.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Terdengar masuk akal secara teori,{\i0}
Dialogue: 0,0:20:38.82,0:20:41.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}tetapi tak tertahankan\Nbagi yang terlibat langsung.{\i0}
Dialogue: 0,0:20:41.99,0:20:45.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih parah lagi,\Nputra kami membuat kami gila.
Dialogue: 0,0:20:45.82,0:20:48.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Demi alasan sendiri,\Nputra sulungku memihak petani.{\i0}
Dialogue: 0,0:20:48.45,0:20:52.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Selain itu, dia pikir\Nsemua pejabat pemerintah sama.{\i0}
Dialogue: 0,0:20:52.83,0:20:57.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sebabnya aku ingin\Nkau meminta penurunan pajak biji-bijian.
Dialogue: 0,0:20:59.71,0:21:03.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya seorang kasim...
Dialogue: 0,0:21:04.68,0:21:05.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti.
Dialogue: 0,0:21:07.93,0:21:11.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, setidaknya, ada pertemuan besok.
Dialogue: 0,0:21:11.14,0:21:12.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bisa ikut kami?
Dialogue: 0,0:21:12.31,0:21:14.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa ikut.
Dialogue: 0,0:21:14.60,0:21:16.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh aku ikut juga?
Dialogue: 0,0:21:18.56,0:21:21.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak yakin\Nbagaimana perasaan mereka tentang itu.
Dialogue: 0,0:21:21.90,0:21:25.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa kehadiran pihak ketiga\Nterkadang bisa membantu.
Dialogue: 0,0:21:26.20,0:21:27.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak akan mengganggu.
Dialogue: 0,0:21:27.66,0:21:30.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, jika mereka kasar, aku akan bicara.
Dialogue: 0,0:21:30.58,0:21:33.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kurasa dia penasaran\Nkarena ini melibatkannya.{\i0}
Dialogue: 0,0:21:33.95,0:21:35.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, kurasa...
Dialogue: 0,0:21:36.58,0:21:39.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menemani kalian juga!
Dialogue: 0,0:21:39.71,0:21:42.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku ragu kau akan berguna.{\i0}
Dialogue: 0,0:21:53.14,0:21:55.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong jangan menangis.
Dialogue: 0,0:21:57.19,0:21:59.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, jika keadaan tetap begini...
Dialogue: 0,0:22:02.86,0:22:03.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan khawatir.
Dialogue: 0,0:22:04.94,0:22:06.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bersumpah akan lakukan sesuatu.
Dialogue: 0,0:23:56.30,0:23:58.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Episode selanjutnya, "Taruhan".{\i0}
Dialogue: 0,0:23:58.60,0:24:00.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Terjemahan subtitle oleh Amalia Puspita
