Dialogue: 0,0:23:46.09,0:23:48.80,sign,,0000,0000,0000,,CUPLIKAN EPISODE SELANJUTNYA
Dialogue: 0,0:01:31.71,0:01:35.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Lagi pula, ini juga soal memilih istri.
Dialogue: 0,0:01:35.63,0:01:37.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Istri?
Dialogue: 0,0:01:37.51,0:01:38.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:01:38.97,0:01:40.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk adik Kaisar.
Dialogue: 0,0:01:42.06,0:01:43.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Adik Kaisar...{\i0}
Dialogue: 0,0:01:43.81,0:01:47.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Intinya, mereka mencari istri\Nuntuk Tuan Jinshi.{\i0}
Dialogue: 0,0:01:47.94,0:01:49.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu akan sulit.{\i0}
Dialogue: 0,0:01:50.69,0:01:53.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kurasa itu berarti\NNyonya Lishu juga kandidat.{\i0}
Dialogue: 0,0:01:54.03,0:01:57.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Selir Lishu tak cocok\Ndi antara empat wanita Kaisar.{\i0}
Dialogue: 0,0:01:57.86,0:01:59.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jika Kaisar menyerahkannya,{\i0}
Dialogue: 0,0:01:59.82,0:02:02.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dia mungkin\Nakan lebih bahagia seperti itu.{\i0}
Dialogue: 0,0:02:03.24,0:02:05.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun, masalahnya adalah pasangannya.{\i0}
Dialogue: 0,0:02:06.00,0:02:07.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Terlalu kuat.{\i0}
Dialogue: 0,0:02:07.83,0:02:11.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jika dia seorang wanita, kecantikannya\Nakan menghancurkan seluruh negeri.{\i0}
Dialogue: 0,0:02:12.00,0:02:14.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bahkan dengan bekas luka lama di wajahnya,{\i0}
Dialogue: 0,0:02:14.67,0:02:17.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}aku khawatir bagaimana respons mereka.{\i0}
Dialogue: 0,0:02:17.01,0:02:20.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mungkin itu juga alasan\Ndi balik serangan ini?{\i0}
Dialogue: 0,0:02:21.34,0:02:23.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tidak mungkin.{\i0}
Dialogue: 0,0:02:29.73,0:02:31.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, di sini.
Dialogue: 0,0:02:39.61,0:02:42.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tali aneh seperti ular\Ndi pergelangan tangan itu...{\i0}
Dialogue: 0,0:02:53.88,0:02:55.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh aku masuk?
Dialogue: 0,0:02:59.38,0:03:00.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan.
Dialogue: 0,0:03:01.18,0:03:03.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kepala dayangmu yang biasa\Ntak ikut denganmu?
Dialogue: 0,0:03:04.43,0:03:07.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya aku yang diizinkan\Nmeninggalkan istana harem.
Dialogue: 0,0:03:08.14,0:03:10.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dayangku untuk perjalanan ini
Dialogue: 0,0:03:10.14,0:03:11.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ditunjuk oleh ayahku.
Dialogue: 0,0:03:12.44,0:03:15.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia dahulu selalu gemetar,\Nyang membuatku agak terganggu.{\i0}
Dialogue: 0,0:03:15.98,0:03:17.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa dia sudah jadi lebih berani?{\i0}
Dialogue: 0,0:03:17.65,0:03:19.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah. Kenapa kau kemari?
Dialogue: 0,0:03:20.53,0:03:21.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:03:23.53,0:03:24.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Menyebalkan sekali.{\i0}
Dialogue: 0,0:03:24.99,0:03:26.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia bukan selir jahat, tapi tetap saja.{\i0}
Dialogue: 0,0:03:26.99,0:03:29.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa dia butuh pertanyaan pemicu?{\i0}
Dialogue: 0,0:03:29.91,0:03:32.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Yang bisa mencairkan suasana...{\i0}
Dialogue: 0,0:03:32.83,0:03:35.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau akan bertunangan dengan adik Kaisar?
Dialogue: 0,0:03:35.21,0:03:36.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:03:36.46,0:03:38.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum...
Dialogue: 0,0:03:38.71,0:03:41.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sepertinya dia tahu.{\i0}
Dialogue: 0,0:03:41.26,0:03:44.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun, dia tak tampak senang.{\i0}
Dialogue: 0,0:03:45.68,0:03:49.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, apa kau tahu\Nkenapa pencuri menyerangmu?
Dialogue: 0,0:03:50.43,0:03:52.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan itu yang ingin kubicarakan...
Dialogue: 0,0:03:53.56,0:03:55.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia punya firasat, ya?{\i0}
Dialogue: 0,0:03:55.36,0:03:57.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kurasa dia tak pandai berbohong.{\i0}
Dialogue: 0,0:03:57.48,0:03:59.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, kau mau apa?
Dialogue: 0,0:04:00.24,0:04:03.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisakah kau menentukan\Napakah orang tua dan anak
Dialogue: 0,0:04:04.32,0:04:06.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}benar-benar memiliki hubungan darah?
Dialogue: 0,0:04:07.49,0:04:09.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menentukan?
Dialogue: 0,0:04:09.04,0:04:10.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:04:10.25,0:04:11.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dan ayahku...
Dialogue: 0,0:04:11.87,0:04:17.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kupikir mungkin kau bisa menilai\Napakah Uryuu adalah ayah kandungku.
Dialogue: 0,0:04:17.79,0:04:19.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau bertanya?
Dialogue: 0,0:04:19.80,0:04:21.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya...
Dialogue: 0,0:04:34.31,0:04:35.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baunya enak.
Dialogue: 0,0:04:36.15,0:04:37.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membuat tenang, bukan?
Dialogue: 0,0:04:38.90,0:04:43.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, aku tak seharusnya\Nkembali ke istana harem.
Dialogue: 0,0:04:45.20,0:04:47.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Setelah Kaisar sebelumnya meninggal,
Dialogue: 0,0:04:47.24,0:04:49.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}aku seharusnya tinggal di biara.
Dialogue: 0,0:04:49.58,0:04:53.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Namun, ayahku memintaku\Nmenikahi gubernur yang berkuasa.
Dialogue: 0,0:04:54.66,0:04:59.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gubernur itu sudah tua\Ndan punya banyak gundik,
Dialogue: 0,0:04:59.92,0:05:04.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tetapi keluargaku di Klan U\Nmakin lemah, jadi...
Dialogue: 0,0:05:04.59,0:05:07.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Setelah Kaisar sebelumnya,\Nmuncul orang tua cabul, ya?{\i0}
Dialogue: 0,0:05:07.89,0:05:10.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Janda Permaisuri menghargai kemampuan.{\i0}
Dialogue: 0,0:05:10.43,0:05:13.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sepertinya klan sekarat itu\Nmemperalat gadis ini.{\i0}
Dialogue: 0,0:05:14.10,0:05:18.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, Nyonya Ah-Duo dan Kaisar\Nmenghentikan pertunangan itu untukku.
Dialogue: 0,0:05:19.65,0:05:22.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dengan memasuki istana harem,\Naku tak perlu menikahi gubernur.{\i0}
Dialogue: 0,0:05:23.82,0:05:27.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku mendengar rumor\Nbahwa Nyonya Ah-Duo yang meminta itu.{\i0}
Dialogue: 0,0:05:28.24,0:05:32.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Yang Mulia dan aku dekat.\NAku sering duduk di pangkuannya.
Dialogue: 0,0:05:32.24,0:05:33.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Mungkin itu sebabnya.
Dialogue: 0,0:05:33.83,0:05:35.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga...
Dialogue: 0,0:05:35.71,0:05:38.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu sekarang akan memicu serangan jantung.{\i0}
Dialogue: 0,0:05:38.83,0:05:42.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kisah itu membuatmu\Ningin melakukan tes paternitas?
Dialogue: 0,0:05:43.46,0:05:47.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar ibuku\Nadalah teman dekat Nyonya Ah-Duo.
Dialogue: 0,0:05:47.84,0:05:51.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia juga sering minum teh\Ndengan Yang Mulia.
Dialogue: 0,0:05:51.22,0:05:52.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:05:53.51,0:05:55.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jadi, itu sebabnya\NNyonya Ah-Duo memanjakannya.{\i0}
Dialogue: 0,0:05:56.98,0:06:00.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Selain itu, ibuku adalah kandidat\Nuntuk menjadi selir Pangeran.
Dialogue: 0,0:06:02.27,0:06:04.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa? Tunggu, itu berarti...{\i0}
Dialogue: 0,0:06:05.40,0:06:07.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Saat Kaisar masih Putra Mahkota,{\i0}
Dialogue: 0,0:06:07.20,0:06:11.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}selirnya hanya Nyonya Ah-Duo,\Nyang tak bisa punya anak lagi.{\i0}
Dialogue: 0,0:06:11.66,0:06:14.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kaisar sebelumnya sudah tua dan sakit.{\i0}
Dialogue: 0,0:06:15.33,0:06:18.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Menghasilkan keturunan\Nadalah tugas keluarga kekaisaran.{\i0}
Dialogue: 0,0:06:18.16,0:06:22.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika ada kandidat lain\Nuntuk menjadi selir Pangeran saat itu...
Dialogue: 0,0:06:23.71,0:06:27.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat itu, ayahku sudah menikah\Ndengan ibuku.
Dialogue: 0,0:06:28.51,0:06:31.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sebabnya ayahku melihatku sebagai...
Dialogue: 0,0:06:33.05,0:06:36.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia bertele-tele,\Ntetapi aku mengerti maksudnya.{\i0}
Dialogue: 0,0:06:36.89,0:06:40.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Nyonya Lishu mencurigai\NKaisar mungkin adalah ayah kandungnya.{\i0}
Dialogue: 0,0:06:41.81,0:06:44.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Adik Kaisar adalah orang yang baik,
Dialogue: 0,0:06:44.90,0:06:48.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tetapi jika dia memilih istri, aku...
Dialogue: 0,0:06:49.03,0:06:52.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia tak senang diberikan kepadanya.{\i0}
Dialogue: 0,0:06:52.78,0:06:57.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jika putri Kaisar menikahi\Nadik Kaisar, Tuan Jinshi,{\i0}
Dialogue: 0,0:06:57.08,0:06:58.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}itu inses.{\i0}
Dialogue: 0,0:07:03.42,0:07:05.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sejujurnya, aku tak ingin menyelidiki.{\i0}
Dialogue: 0,0:07:06.34,0:07:08.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun, aku terlalu keras kepala\Nuntuk menolak.{\i0}
Dialogue: 0,0:07:08.84,0:07:11.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Setelah mendengarnya, kini aku penasaran.{\i0}
Dialogue: 0,0:07:11.30,0:07:16.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Untuk memastikan, hitung mundur saja\Ndari lahir hingga pembuahan. Sederhana.{\i0}
Dialogue: 0,0:07:16.81,0:07:21.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun, tak mungkin menanyakan detail itu\Nkepada ayahnya, pria Uryuu itu.{\i0}
Dialogue: 0,0:07:21.14,0:07:23.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jika aku bertanya kepada Kaisar...{\i0}
Dialogue: 0,0:07:25.40,0:07:26.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin.
Dialogue: 0,0:07:27.44,0:07:32.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jika rambutnya merah dan matanya hijau\Nseperti Permaisuri Gyokuyou, akan mudah.{\i0}
Dialogue: 0,0:07:33.03,0:07:34.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Soal penampilan,{\i0}
Dialogue: 0,0:07:34.57,0:07:37.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Nyonya Lishu tampak\Nseperti warga Li biasa.{\i0}
Dialogue: 0,0:07:37.66,0:07:39.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun, aku belum pernah melihat ayahnya.{\i0}
Dialogue: 0,0:07:41.58,0:07:42.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi.
Dialogue: 0,0:07:46.46,0:07:47.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau apa?
Dialogue: 0,0:07:50.34,0:07:52.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aroma ini menenangkan jiwaku.{\i0}
Dialogue: 0,0:07:52.97,0:07:54.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh, kenapa kau kemari?
Dialogue: 0,0:07:54.80,0:07:57.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku datang untuk melihat\Npasien yang kujahit.
Dialogue: 0,0:08:00.73,0:08:01.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi.
Dialogue: 0,0:08:03.69,0:08:05.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bagus, jahitannya terlihat bersih.{\i0}
Dialogue: 0,0:08:05.90,0:08:07.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Berkat daya tahannya.{\i0}
Dialogue: 0,0:08:07.57,0:08:09.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau punya antipiretik, beri aku.
Dialogue: 0,0:08:09.73,0:08:11.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami kekurangan.
Dialogue: 0,0:08:11.15,0:08:12.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan ambil bahannya.
Dialogue: 0,0:08:16.87,0:08:18.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo. Selamat siang.
Dialogue: 0,0:08:18.78,0:08:20.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada masalah?
Dialogue: 0,0:08:20.41,0:08:23.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, hanya ingin memeriksa yang cedera.
Dialogue: 0,0:08:23.87,0:08:26.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga punya obat bagus,\Njadi, mau kuberikan.
Dialogue: 0,0:08:26.92,0:08:28.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja gratis.
Dialogue: 0,0:08:28.63,0:08:30.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cedera ini sudah cukup sakit.
Dialogue: 0,0:08:31.05,0:08:33.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa dia mau cari muka?{\i0}
Dialogue: 0,0:08:33.30,0:08:37.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia dari desa yang sama\Ndengan pemandu Nyonya Ah-Duo, bukan?{\i0}
Dialogue: 0,0:08:39.43,0:08:43.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kami sewa untuk melindungi dari pencuri,\Ntetapi jelas tak membantu.{\i0}
Dialogue: 0,0:08:43.60,0:08:47.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jika terus begini, tak ada yang akan\Nmemercayai pemandu di desa mereka lagi.{\i0}
Dialogue: 0,0:08:47.52,0:08:49.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Obat apa?
Dialogue: 0,0:08:49.11,0:08:51.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, obat ini.
Dialogue: 0,0:08:54.74,0:08:55.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa ini...{\i0}
Dialogue: 0,0:09:01.29,0:09:03.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kenapa ini ada di sini?
Dialogue: 0,0:09:03.12,0:09:04.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:09:04.41,0:09:05.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pernah gunakan ini?
Dialogue: 0,0:09:05.79,0:09:10.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, aku tak tahu\Ncara menggunakannya.
Dialogue: 0,0:09:13.26,0:09:14.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untunglah.
Dialogue: 0,0:09:15.42,0:09:17.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, ini tetap obat yang efektif.
Dialogue: 0,0:09:17.80,0:09:19.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita gunakan.
Dialogue: 0,0:09:19.14,0:09:20.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:09:20.64,0:09:21.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi...
Dialogue: 0,0:09:21.97,0:09:25.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau gunakan ini,\Nkariermu bisa terancam.
Dialogue: 0,0:09:25.98,0:09:28.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau punya lagi, akan kubeli semuanya.
Dialogue: 0,0:09:28.73,0:09:32.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan bayar lebih\Njika kau beri kami informasi.
Dialogue: 0,0:09:32.98,0:09:37.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bagaimana tepatnya\Ndia mendapatkan opium ini?{\i0}
Dialogue: 0,0:09:40.24,0:09:45.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seorang wanita penghibur keliling\Nmemberikannya sekitar setahun lalu.
Dialogue: 0,0:09:45.12,0:09:50.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Katanya obat itu dapat menenangkan hati\Ndan menghapus penderitaan duniawi.{\i0}
Dialogue: 0,0:09:51.25,0:09:53.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu promosi pengedar narkoba.{\i0}
Dialogue: 0,0:09:54.30,0:09:57.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Orang-orang mengisap ganja\Ndi dekat penginapan.{\i0}
Dialogue: 0,0:09:57.09,0:10:00.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia pasti tak pernah menjelaskan\Ncara yang tepat.{\i0}
Dialogue: 0,0:10:00.22,0:10:01.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu wanita itu...
Dialogue: 0,0:10:01.93,0:10:06.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sebut "wanita", tetapi dia mungkin\Nsedikit di atas 15 tahun.
Dialogue: 0,0:10:06.23,0:10:08.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum pernah kulihat\Nrambut putih seperti dia.
Dialogue: 0,0:10:08.64,0:10:09.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:10:10.06,0:10:12.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku tak akan melupakannya.{\i0}
Dialogue: 0,0:10:12.15,0:10:15.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu inkarnasi dewa ular.
Dialogue: 0,0:10:15.69,0:10:18.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti dia turun untuk menjelajahi\Ndunia kita secara rahasia!
Dialogue: 0,0:10:28.16,0:10:31.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sehari berlalu, dan perjalanan berlanjut.{\i0}
Dialogue: 0,0:10:32.46,0:10:34.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Masalah menumpuk.{\i0}
Dialogue: 0,0:10:34.67,0:10:37.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Koneksi muncul di tempat tak terduga.{\i0}
Dialogue: 0,0:10:37.67,0:10:40.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rambut putih, dan dewa ular...
Dialogue: 0,0:10:41.68,0:10:45.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kemudian, kudengar\Ntali yang dipakai para pencuri itu{\i0}
Dialogue: 0,0:10:45.56,0:10:49.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}adalah tali putih yang dipelintir\Nagar mirip ular kawin.{\i0}
Dialogue: 0,0:10:51.52,0:10:56.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Walau aku ingin menginterogasi,\Nentah apa mereka bisa bicara jelas.{\i0}
Dialogue: 0,0:10:58.40,0:11:02.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Semua pencuri itu pecandu opium.{\i0}
Dialogue: 0,0:11:23.43,0:11:26.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Perbedaan suhu\Nantara siang dan malam mengejutkanku.{\i0}
Dialogue: 0,0:11:33.77,0:11:36.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Selama sisa perjalanan,\Nkuhabiskan banyak waktu bersama Suirei.{\i0}
Dialogue: 0,0:11:37.61,0:11:40.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia membakar banyak dupa{\i0}
Dialogue: 0,0:11:40.24,0:11:43.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}untuk mengusir kalajengking\Ndan serangga berbisa saat malam.{\i0}
Dialogue: 0,0:11:44.28,0:11:46.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun, aku sebenarnya ingin melihatnya...{\i0}
Dialogue: 0,0:12:00.21,0:12:04.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Akhirnya, kami tiba dengan selamat\Ndi tujuan kami, Ibu Kota Barat.{\i0}
Dialogue: 0,0:12:22.28,0:12:24.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, inilah Ibu Kota Barat.
Dialogue: 0,0:12:24.07,0:12:26.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar kota itu seperti labirin.
Dialogue: 0,0:12:26.37,0:12:27.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mungkin tersesat.
Dialogue: 0,0:12:28.24,0:12:30.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah tidak menyamar?
Dialogue: 0,0:12:30.24,0:12:32.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Setelah tiba di sini, tak perlu lagi.
Dialogue: 0,0:12:33.58,0:12:36.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, semoga noda catnya hilang.
Dialogue: 0,0:12:36.25,0:12:38.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah digunakan hampir sebulan.
Dialogue: 0,0:12:52.10,0:12:53.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kenapa keluarga kekaisaran...
Dialogue: 0,0:12:55.27,0:12:59.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mereka benar-benar tidak sadar\NTuan Jinshi ikut?{\i0}
Dialogue: 0,0:12:59.48,0:13:00.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Nyonya Lishu juga?{\i0}
Dialogue: 0,0:13:01.98,0:13:05.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah perjalanan panjang,\Nkami menyambut dengan rendah hati.
Dialogue: 0,0:13:05.49,0:13:08.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bertugas sebagai kepala.\NNamaku You Gyokuen.
Dialogue: 0,0:13:08.91,0:13:10.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian telah merawat putriku.
Dialogue: 0,0:13:14.37,0:13:17.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ini ayah Permaisuri Gyokuyou?{\i0}
Dialogue: 0,0:13:17.67,0:13:19.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku melihat kemiripannya.{\i0}
Dialogue: 0,0:13:20.00,0:13:21.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:13:21.25,0:13:22.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu.
Dialogue: 0,0:13:22.34,0:13:25.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah perjalanan panjang,\Nkalian pasti lelah.
Dialogue: 0,0:13:25.22,0:13:28.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami telah menjadwalkan perjamuan\Nuntuk besok,
Dialogue: 0,0:13:28.05,0:13:30.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}silakan beristirahat malam ini.
Dialogue: 0,0:13:31.64,0:13:33.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan, anggap saja rumah sendiri.
Dialogue: 0,0:13:38.19,0:13:39.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ini sungguh tak apa-apa?{\i0}
Dialogue: 0,0:13:39.61,0:13:43.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Terlalu mewah,\Nbahkan untuk pelayan adik Kaisar.{\i0}
Dialogue: 0,0:13:46.74,0:13:47.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manis.
Dialogue: 0,0:13:54.87,0:13:57.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Meskipun air berharga di sini,{\i0}
Dialogue: 0,0:13:57.33,0:14:02.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}ayah Permaisuri Gyokuyou\Nsangat mengerti rasa lelah kami.{\i0}
Dialogue: 0,0:14:08.84,0:14:11.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak akan disuruh bayar nanti, bukan?
Dialogue: 0,0:14:11.47,0:14:13.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau di sini?
Dialogue: 0,0:14:14.43,0:14:16.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa yang berselisih\Ndengan pintu terbuka?
Dialogue: 0,0:14:18.31,0:14:19.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak terlihat...
Dialogue: 0,0:14:19.35,0:14:21.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah memanggilku ke Ibu Kota Barat...
Dialogue: 0,0:14:21.65,0:14:23.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu kenapa?
Dialogue: 0,0:14:23.15,0:14:26.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau menghalangiku. Seperti biasa!
Dialogue: 0,0:14:26.32,0:14:30.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya menyegarkan saat orang\Nterang-terangan bermusuhan begini.
Dialogue: 0,0:14:30.32,0:14:33.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, kamar sebelah...
Dialogue: 0,0:14:46.59,0:14:49.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jadi, yang lain sengaja diusir, ya?{\i0}
Dialogue: 0,0:15:00.27,0:15:02.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh aku masuk?
Dialogue: 0,0:15:05.40,0:15:06.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan masuk.
Dialogue: 0,0:15:15.33,0:15:17.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Menangis di bawah selimut?{\i0}
Dialogue: 0,0:15:18.58,0:15:20.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kulihat.
Dialogue: 0,0:15:20.04,0:15:20.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:15:25.67,0:15:28.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa ambilkan air dingin?
Dialogue: 0,0:15:28.17,0:15:31.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak boleh meninggalkan Nyonya Lishu.
Dialogue: 0,0:15:31.30,0:15:34.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tak masalah keluar tadi.
Dialogue: 0,0:15:40.18,0:15:42.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasa dingin akan mengurangi\Nrasa sakit dan bengkak.
Dialogue: 0,0:15:43.10,0:15:46.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk jaga-jaga, bisa buka mulutmu?
Dialogue: 0,0:15:46.82,0:15:47.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:15:52.11,0:15:54.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pemandangan langka.{\i0}
Dialogue: 0,0:15:55.87,0:15:58.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Gawat, aku menatap terlalu lama.{\i0}
Dialogue: 0,0:15:58.29,0:15:59.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak ada masalah juga.
Dialogue: 0,0:16:00.91,0:16:02.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duduklah, jika kau mau.
Dialogue: 0,0:16:02.79,0:16:04.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:16:07.46,0:16:10.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tampak agak kasar, ya?
Dialogue: 0,0:16:10.88,0:16:12.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak tiriku.
Dialogue: 0,0:16:12.26,0:16:15.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu tiriku saat ini\Nadalah gundik Ayah dahulu.
Dialogue: 0,0:16:15.72,0:16:20.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Saat Ibu meninggal dan Ayah menikah lagi,\Nibu tiri baruku sudah punya anak.{\i0}
Dialogue: 0,0:16:20.98,0:16:25.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dari yang kulihat,\Ntampaknya kakaknya agak manja.{\i0}
Dialogue: 0,0:16:25.77,0:16:28.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kakak tirimu mengatakan sesuatu
Dialogue: 0,0:16:28.19,0:16:30.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang membuatmu meragukan ayahmu?
Dialogue: 0,0:16:31.49,0:16:34.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kau juga tidak jelas\Nsoal insiden pencurian itu.
Dialogue: 0,0:16:34.86,0:16:36.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Apa karena kau tahu sesuatu?
Dialogue: 0,0:16:37.28,0:16:38.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu...
Dialogue: 0,0:16:38.37,0:16:40.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak tahu.
Dialogue: 0,0:16:41.16,0:16:44.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kakak yang cemburu\Nmungkin mengirim orang untuk membunuhnya.{\i0}
Dialogue: 0,0:16:44.21,0:16:47.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku tak ingin memikirkannya,\Ntetapi ada kemungkinan.{\i0}
Dialogue: 0,0:16:47.79,0:16:50.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Setidaknya, kekerasannya tampak parah.{\i0}
Dialogue: 0,0:16:51.92,0:16:55.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bolehkah aku\Nmakan malam denganmu malam ini?
Dialogue: 0,0:16:56.43,0:17:00.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita ajak Nyonya Ah-Duo bergabung juga?
Dialogue: 0,0:17:01.85,0:17:03.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:17:15.86,0:17:18.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku tak tahu siapa ayah kandungnya,{\i0}
Dialogue: 0,0:17:18.28,0:17:20.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}tetapi ini bukan salahnya.{\i0}
Dialogue: 0,0:17:20.53,0:17:22.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku kasihan kepadanya.{\i0}
Dialogue: 0,0:17:23.29,0:17:27.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Nyonya Ah-Duo menerima\Nundangan kami dengan ramah.{\i0}
Dialogue: 0,0:17:27.33,0:17:29.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kini aku bisa diam-diam memeriksa racun.{\i0}
Dialogue: 0,0:17:30.75,0:17:34.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jika mereka mampu menyewa pencuri\Nuntuk menyerangnya,{\i0}
Dialogue: 0,0:17:34.05,0:17:35.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}mereka tak akan ragu meracuninya.{\i0}
Dialogue: 0,0:17:36.30,0:17:38.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ruangan ini mengesankan.
Dialogue: 0,0:17:42.72,0:17:47.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bangunan pindahan yang sebelumnya\Ndikhususkan untuk dewa asing.
Dialogue: 0,0:17:47.60,0:17:52.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dahulu, Nyonya Muda\Nsering makan di sini dengan semua orang.
Dialogue: 0,0:17:52.94,0:17:56.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Nyonya Muda"?\NApa maksudmu Permaisuri Gyokuyou?
Dialogue: 0,0:17:56.20,0:17:57.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:17:59.36,0:18:00.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini indah.
Dialogue: 0,0:18:05.75,0:18:07.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan minta pelayan membersihkan.
Dialogue: 0,0:18:08.37,0:18:09.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, terima kasih.
Dialogue: 0,0:18:16.47,0:18:18.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tempat ini sangat besar.{\i0}
Dialogue: 0,0:18:25.56,0:18:27.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Basen?
Dialogue: 0,0:18:27.06,0:18:29.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau di sini?
Dialogue: 0,0:18:29.02,0:18:32.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak ada alasan khusus...
Dialogue: 0,0:18:32.65,0:18:35.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ya ampun. Pasti dia tersesat.{\i0}
Dialogue: 0,0:18:36.15,0:18:39.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Astaga. Aku akan membantunya\Ndan pura-pura tak sadar.{\i0}
Dialogue: 0,0:18:39.70,0:18:42.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa temani aku ke aneks?
Dialogue: 0,0:18:42.91,0:18:45.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau juga tidur di sana, bukan?
Dialogue: 0,0:18:45.95,0:18:47.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu, jika kau memaksa.
Dialogue: 0,0:18:49.75,0:18:51.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Merepotkan.{\i0}
Dialogue: 0,0:19:04.60,0:19:07.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal Selir Lishu,\Napa kau mengenal baik karakternya?
Dialogue: 0,0:19:08.39,0:19:10.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau tak tanya Tuan Jinshi?
Dialogue: 0,0:19:10.77,0:19:12.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak bisa. Itu masalahnya.
Dialogue: 0,0:19:15.98,0:19:17.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku paham.{\i0}
Dialogue: 0,0:19:18.03,0:19:22.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bisa jadi kekanak-kanakan,\Natau kurasa bisa disebut lugu.
Dialogue: 0,0:19:22.82,0:19:25.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Secara keseluruhan,\Ndia orang yang menyenangkan.
Dialogue: 0,0:19:27.08,0:19:28.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sungguh berpikir begitu?
Dialogue: 0,0:19:28.70,0:19:31.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau tidak percaya?
Dialogue: 0,0:19:41.68,0:19:45.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Jinshi dan ayahku ragu\Nsaat mendengar nama itu.
Dialogue: 0,0:19:47.97,0:19:49.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bilang-bilang, ya?
Dialogue: 0,0:19:49.81,0:19:52.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika ini rahasia, aku tak mau tahu.
Dialogue: 0,0:19:52.69,0:19:55.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah cukup memberi petunjuk,\Njadi, kuberi tahu. Dengar.
Dialogue: 0,0:19:56.44,0:19:58.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka ingin menyerahkan Selir Lishu.
Dialogue: 0,0:19:58.82,0:20:00.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kepada Tuan Jinshi.
Dialogue: 0,0:20:00.57,0:20:01.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga.
Dialogue: 0,0:20:02.24,0:20:04.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa reaksimu begitu?
Dialogue: 0,0:20:04.32,0:20:06.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutmu ini tidak serius?
Dialogue: 0,0:20:06.45,0:20:10.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, aku sudah di atas usia menikah.\NTak ada waktu mencemaskan orang lain.
Dialogue: 0,0:20:11.50,0:20:13.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau benar.
Dialogue: 0,0:20:13.67,0:20:16.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia setuju begitu saja.\NItu sebabnya wanita tak menyukainya.{\i0}
Dialogue: 0,0:20:17.46,0:20:20.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang jadi masalah?
Dialogue: 0,0:20:20.17,0:20:24.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal garis keturunan dan usia,\Nbukankah dia kandidat utama?
Dialogue: 0,0:20:25.47,0:20:27.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tuan Jinshi dengan Nyonya Lishu.{\i0}
Dialogue: 0,0:20:27.55,0:20:31.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bahkan dengan Putra Mahkota,\Nposisinya tinggi dalam garis suksesi.{\i0}
Dialogue: 0,0:20:31.27,0:20:34.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Meski tak jadi Permaisuri,\Ndia bisa jadi istri perdana menteri.{\i0}
Dialogue: 0,0:20:35.69,0:20:37.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Walau mereka mungkin\Nmemiliki hubungan darah,{\i0}
Dialogue: 0,0:20:39.23,0:20:41.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}aku ragu mereka tahu.{\i0}
Dialogue: 0,0:20:41.65,0:20:44.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Meski itu bukan pilihan tersehat,{\i0}
Dialogue: 0,0:20:44.40,0:20:46.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}tak apa-apa jika mereka saudara tiri.{\i0}
Dialogue: 0,0:20:47.20,0:20:50.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Di antara tokoh pemerintahan,\Nhal seperti ini tak jarang terjadi.{\i0}
Dialogue: 0,0:20:51.41,0:20:54.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, kita bicara\Ntentang calon istri Tuan Jinshi.
Dialogue: 0,0:20:55.37,0:20:57.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasangannya harus pantas...
Dialogue: 0,0:20:58.09,0:20:59.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jadi cerewet, ya?{\i0}
Dialogue: 0,0:20:59.71,0:21:01.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku tak sanggup.{\i0}
Dialogue: 0,0:21:01.05,0:21:06.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa tak bicara langsung dengannya\Ndan buat penilaian sendiri?
Dialogue: 0,0:21:06.76,0:21:08.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bicara langsung, ya?
Dialogue: 0,0:21:09.01,0:21:10.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun...
Dialogue: 0,0:21:11.27,0:21:15.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutmu wanita akan takut\Norang sepertiku?
Dialogue: 0,0:21:15.31,0:21:16.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:21:16.94,0:21:19.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kata pria yang kesuciannya\Nhampir dirampas.{\i0}
Dialogue: 0,0:21:19.86,0:21:21.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Siapa yang...
Dialogue: 0,0:21:21.11,0:21:22.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada orang di sana?
Dialogue: 0,0:21:26.11,0:21:28.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau panik?
Dialogue: 0,0:21:28.16,0:21:30.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kau yang panik.{\i0}
Dialogue: 0,0:21:30.62,0:21:34.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tunggu, orang ini sangat kuat...{\i0}
Dialogue: 0,0:21:39.42,0:21:41.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau hanya berkhayal?
Dialogue: 0,0:21:41.80,0:21:43.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga saja.
Dialogue: 0,0:21:43.96,0:21:46.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, ke mana Basen?
Dialogue: 0,0:21:48.64,0:21:49.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bagus...{\i0}
Dialogue: 0,0:23:54.18,0:23:56.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Episode selanjutnya, "Ibu Kota Barat".{\i0}
Dialogue: 0,0:23:56.93,0:24:00.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Terjemahan subtitle oleh Amalia Puspita
