Dialogue: 0,0:01:31.00,0:01:32.71,sign,,0000,0000,0000,,{\an8}KISAH INI FIKSI, SEMUA NAMA TOKOH\NDAN ORGANISASINYA JUGA FIKTIF.
Dialogue: 0,0:01:32.71,0:01:34.30,sign,,0000,0000,0000,,{\an8}SELAIN ITU, KISAH INI TAK ADA HUBUNGANNYA\NDENGAN INSIDEN ATAU PERISTIWA NYATA.
Dialogue: 0,0:23:46.00,0:23:52.22,sign,,0000,0000,0000,,CUPLIKAN EPISODE SELANJUTNYA
Dialogue: 0,0:01:38.89,0:01:41.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apoteker! Ikut aku, cepat!
Dialogue: 0,0:01:42.68,0:01:43.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo!
Dialogue: 0,0:01:44.72,0:01:47.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}- Buka!\N- Kenapa pagi-pagi sekali?
Dialogue: 0,0:01:47.98,0:01:49.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku tahu kau di dalam!
Dialogue: 0,0:01:49.69,0:01:50.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apoteker!
Dialogue: 0,0:01:52.57,0:01:53.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang sakit.
Dialogue: 0,0:01:53.86,0:01:55.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Datang ke rumahku sekarang!
Dialogue: 0,0:01:58.74,0:01:59.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei!
Dialogue: 0,0:02:02.28,0:02:03.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Punya uang untuk bayar?
Dialogue: 0,0:02:03.99,0:02:07.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Kau akan abaikan aku jika tidak?
Dialogue: 0,0:02:07.16,0:02:09.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau apoteker, bukan?
Dialogue: 0,0:02:09.00,0:02:11.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memang apoteker. Ada biayanya.
Dialogue: 0,0:02:11.58,0:02:14.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau ambil uang dari orang miskin?
Dialogue: 0,0:02:14.25,0:02:16.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di mana pria tua yang biasanya di sini?
Dialogue: 0,0:02:16.46,0:02:17.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sudah kuduga.{\i0}
Dialogue: 0,0:02:17.67,0:02:20.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tampaknya ayahku menunjukkan\Nsimpati setengah hati.{\i0}
Dialogue: 0,0:02:21.14,0:02:23.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pria tua itu pergi bekerja.
Dialogue: 0,0:02:23.76,0:02:25.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika tak ada uang, pulanglah.
Dialogue: 0,0:02:29.19,0:02:33.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kalian muncul,\Naku tinggal di rumah kumuh ini.
Dialogue: 0,0:02:35.02,0:02:37.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Beraninya mengharapkan sedekah...{\i0}
Dialogue: 0,0:02:41.95,0:02:43.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon.
Dialogue: 0,0:02:43.12,0:02:45.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan membayarmu.
Dialogue: 0,0:02:45.12,0:02:46.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bersumpah akan bayar.
Dialogue: 0,0:02:46.41,0:02:48.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anakku sakit.
Dialogue: 0,0:02:55.21,0:02:58.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chou-u. Ambilkan tinta,\Nkuas, dan tablet kayu.
Dialogue: 0,0:03:06.56,0:03:07.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini kontrak.
Dialogue: 0,0:03:08.10,0:03:09.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa setidaknya tulis namamu?
Dialogue: 0,0:03:09.98,0:03:11.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, aku tak bisa menulisnya.
Dialogue: 0,0:03:11.73,0:03:13.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa tulisannya?
Dialogue: 0,0:03:13.35,0:03:16.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Aku pasti akan membayar biaya obat."
Dialogue: 0,0:03:16.57,0:03:18.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, gunakan jempolmu.
Dialogue: 0,0:03:18.23,0:03:19.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cap di sini.
Dialogue: 0,0:03:22.95,0:03:24.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti ini boleh?
Dialogue: 0,0:03:26.28,0:03:27.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu cukup, kurasa.
Dialogue: 0,0:03:27.87,0:03:29.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu mencurigakan.
Dialogue: 0,0:03:31.12,0:03:31.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh!
Dialogue: 0,0:03:36.96,0:03:37.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sini.
Dialogue: 0,0:03:41.26,0:03:43.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa datang ke tempat seperti ini lagi?
Dialogue: 0,0:03:43.47,0:03:45.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf sudah menyeretmu, Ukyou.
Dialogue: 0,0:03:46.43,0:03:48.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini menyebalkan, tapi ya sudahlah.
Dialogue: 0,0:03:48.64,0:03:51.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sungguh mirip ayahmu.
Dialogue: 0,0:03:53.35,0:03:54.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah sampai.
Dialogue: 0,0:03:55.86,0:03:56.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masuklah.
Dialogue: 0,0:03:58.44,0:04:00.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bawa apoteker.
Dialogue: 0,0:04:01.03,0:04:01.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah.
Dialogue: 0,0:04:03.11,0:04:04.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bau busuk ini...{\i0}
Dialogue: 0,0:04:15.38,0:04:17.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejaka kapan dia begini?
Dialogue: 0,0:04:17.21,0:04:18.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beberapa hari lalu.
Dialogue: 0,0:04:18.84,0:04:21.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, sebelumnya,\Ntangannya sudah mengkhawatirkan.
Dialogue: 0,0:04:23.05,0:04:25.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayolah, tolong. Obati dia.
Dialogue: 0,0:04:27.85,0:04:29.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk apa itu?
Dialogue: 0,0:04:29.22,0:04:31.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika aku terinfeksi,\Nkita semua dalam masalah.
Dialogue: 0,0:04:32.39,0:04:33.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau aku pergi?
Dialogue: 0,0:04:41.82,0:04:43.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bicara soal terlalu protektif.{\i0}
Dialogue: 0,0:04:43.78,0:04:45.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Baiklah, gejalanya.{\i0}
Dialogue: 0,0:04:46.57,0:04:48.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sepertinya radang dingin,{\i0}
Dialogue: 0,0:04:48.16,0:04:50.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}tetapi tak cukup dingin\Nuntuk jadi separah ini.{\i0}
Dialogue: 0,0:04:52.16,0:04:54.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pupil juga melebar. Lalu...{\i0}
Dialogue: 0,0:04:57.29,0:04:59.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keadaannya memburuk sejak pagi.
Dialogue: 0,0:04:59.59,0:05:01.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus bagaimana, Ayah?
Dialogue: 0,0:05:01.34,0:05:03.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia akan berakhir seperti Ibu!
Dialogue: 0,0:05:03.21,0:05:05.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak...
Dialogue: 0,0:05:09.30,0:05:11.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong, selamatkan dia!
Dialogue: 0,0:05:11.39,0:05:14.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak sanggup kehilangan\Nanggota keluarga lagi!
Dialogue: 0,0:05:14.81,0:05:17.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}"Tak sanggup kehilangan." Begitu rupanya.{\i0}
Dialogue: 0,0:05:18.60,0:05:20.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ibunya meninggal\Ndengan cara yang sama?
Dialogue: 0,0:05:21.40,0:05:24.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, dia meninggal karena keguguran.
Dialogue: 0,0:05:25.61,0:05:26.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keguguran?
Dialogue: 0,0:05:30.87,0:05:32.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa dia makan sesuatu?
Dialogue: 0,0:05:33.62,0:05:34.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedikit bubur nasi.
Dialogue: 0,0:05:36.62,0:05:38.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hampir tak melihat nasi.
Dialogue: 0,0:05:38.58,0:05:39.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa isinya?
Dialogue: 0,0:05:41.46,0:05:42.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agar banyak, aku memakai...
Dialogue: 0,0:05:50.01,0:05:52.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini tak berbahaya. Ada yang lain?
Dialogue: 0,0:05:53.18,0:05:54.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang lain...
Dialogue: 0,0:05:55.02,0:05:56.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak ada yang lain?
Dialogue: 0,0:06:22.00,0:06:25.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, apa itu?
Dialogue: 0,0:06:26.51,0:06:28.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari mana kau dapat itu?
Dialogue: 0,0:06:28.80,0:06:29.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami diberi ini.
Dialogue: 0,0:06:29.84,0:06:33.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu menyuruh kami makan ini\Nsedikit demi sedikit saat makanan langka.
Dialogue: 0,0:06:34.43,0:06:36.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Juga merahasiakannya dari Ayah.{\i0}
Dialogue: 0,0:06:38.73,0:06:40.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kepala keluarga ini!
Dialogue: 0,0:06:40.94,0:06:44.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, Ayah bahkan tak bekerja!\NAyah hanya berjudi!
Dialogue: 0,0:06:44.27,0:06:46.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah menyuruh kami mengemis di jalanan,
Dialogue: 0,0:06:46.40,0:06:48.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu menghabiskannya untuk berjudi!
Dialogue: 0,0:06:51.07,0:06:53.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ini sering terjadi.{\i0}
Dialogue: 0,0:06:53.16,0:06:54.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunjukkan kepadaku.
Dialogue: 0,0:07:01.67,0:07:03.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bau manis?{\i0}
Dialogue: 0,0:07:05.59,0:07:06.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Gula?{\i0}
Dialogue: 0,0:07:06.88,0:07:09.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu terlalu mewah\Nuntuk diberikan kepada pengemis.{\i0}
Dialogue: 0,0:07:10.09,0:07:11.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa yang memberi?
Dialogue: 0,0:07:11.13,0:07:12.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak tahu.
Dialogue: 0,0:07:12.59,0:07:16.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang memberikannya pada adikku,\Ntetapi adikku bisu.
Dialogue: 0,0:07:16.51,0:07:17.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapan dia dapat ini?
Dialogue: 0,0:07:17.97,0:07:19.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebelum Ibu meninggal.
Dialogue: 0,0:07:20.27,0:07:22.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa sekitar sebulan yang lalu.
Dialogue: 0,0:07:22.48,0:07:24.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada lagi yang dapat kue ini?
Dialogue: 0,0:07:25.15,0:07:27.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang punya gejala serupa?
Dialogue: 0,0:07:27.98,0:07:30.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pria tua di belakang...
Dialogue: 0,0:07:32.32,0:07:33.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:07:37.91,0:07:40.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, apa yang kau lakukan pada putriku?
Dialogue: 0,0:07:40.87,0:07:42.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan membawanya.
Dialogue: 0,0:07:42.12,0:07:44.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika tetap di sini,\Ndia tak akan pernah membaik.
Dialogue: 0,0:07:46.92,0:07:49.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buang kue itu.
Dialogue: 0,0:07:49.38,0:07:50.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu penyebab penyakitnya.
Dialogue: 0,0:07:54.64,0:07:55.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Keguguran juga.{\i0}
Dialogue: 0,0:08:01.35,0:08:02.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kugendong.
Dialogue: 0,0:08:05.90,0:08:08.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jari-jari pria tua\Ndi belakang itu membusuk.
Dialogue: 0,0:08:09.23,0:08:10.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:08:10.44,0:08:12.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awalnya dia pura-pura bodoh,
Dialogue: 0,0:08:12.28,0:08:14.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tetapi saat kuberi uang, dia bicara.
Dialogue: 0,0:08:14.57,0:08:16.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Saat mengemis di jalanan,{\i0}
Dialogue: 0,0:08:16.66,0:08:18.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dia dapat dari seorang wanita.{\i0}
Dialogue: 0,0:08:19.54,0:08:21.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tak melihat wajahnya.
Dialogue: 0,0:08:22.58,0:08:23.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wanita, ya?
Dialogue: 0,0:08:24.67,0:08:27.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa ini? Dia kotor sekali...
Dialogue: 0,0:08:27.50,0:08:29.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya, panaskan air.
Dialogue: 0,0:08:31.26,0:08:32.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Upahmu.
Dialogue: 0,0:08:32.92,0:08:34.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, tak banyak.
Dialogue: 0,0:08:34.26,0:08:35.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak usah.
Dialogue: 0,0:08:36.34,0:08:37.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku terbiasa mengasuh.
Dialogue: 0,0:08:40.68,0:08:41.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai jumpa.
Dialogue: 0,0:08:44.73,0:08:46.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Andai dia tinggal lebih lama.
Dialogue: 0,0:08:47.73,0:08:51.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kenapa jarinya berwarna aneh?
Dialogue: 0,0:08:51.82,0:08:53.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kue.
Dialogue: 0,0:08:53.95,0:08:56.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau lebih tepatnya,\Nkarena mengandung ergot.
Dialogue: 0,0:08:57.53,0:08:58.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita juga punya.
Dialogue: 0,0:08:58.66,0:08:59.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:09:03.00,0:09:05.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu juga digunakan\Ndalam penggugur kandungan.
Dialogue: 0,0:09:05.96,0:09:08.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ditemukan dalam gandum berkualitas rendah.{\i0}
Dialogue: 0,0:09:08.21,0:09:10.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Beracun bahkan dalam jumlah kecil.{\i0}
Dialogue: 0,0:09:10.92,0:09:14.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memperburuk peredaran darah di tubuh\Ndan bisa menyebabkan nekrosis.
Dialogue: 0,0:09:14.67,0:09:17.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kadang menyebabkan\Nkelumpuhan dan halusinasi juga.
Dialogue: 0,0:09:17.84,0:09:19.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa akan sembuh?
Dialogue: 0,0:09:19.35,0:09:21.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, jika dia berhenti makan ergot.
Dialogue: 0,0:09:21.89,0:09:24.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa dia juga butuh olahraga sedang.
Dialogue: 0,0:09:24.43,0:09:25.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu saja?
Dialogue: 0,0:09:25.81,0:09:27.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu saja.
Dialogue: 0,0:09:27.06,0:09:30.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baginya, kekurangan gizi\Nlebih parah dari racun.
Dialogue: 0,0:09:32.02,0:09:33.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di mana air panasnya?
Dialogue: 0,0:09:36.32,0:09:39.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ambil nasi putih dari Nenek juga.
Dialogue: 0,0:09:39.41,0:09:41.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nasi putih? Baik!
Dialogue: 0,0:09:45.16,0:09:47.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tak memanaskan air...
Dialogue: 0,0:09:54.71,0:09:57.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kakaknya tak punya gejala{\i0}
Dialogue: 0,0:09:57.30,0:09:59.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}karena dia tak pernah makan kue itu.{\i0}
Dialogue: 0,0:09:59.34,0:10:01.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia hanya memberikannya pada adiknya.{\i0}
Dialogue: 0,0:10:02.10,0:10:05.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kurasa ibu mereka yang hamil\Ntak bisa menahan untuk makan.{\i0}
Dialogue: 0,0:10:06.23,0:10:08.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Seorang wanita memberi kue ke pengemis{\i0}
Dialogue: 0,0:10:08.19,0:10:11.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dengan bahan mewah seperti gula...{\i0}
Dialogue: 0,0:10:13.69,0:10:15.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sangat mencurigakan.
Dialogue: 0,0:10:24.20,0:10:28.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu... Dua... Bagus.
Dialogue: 0,0:10:30.29,0:10:31.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luar biasa, kau bisa jalan!
Dialogue: 0,0:10:35.21,0:10:36.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia sudah seperti kakak.{\i0}
Dialogue: 0,0:10:41.47,0:10:42.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi...
Dialogue: 0,0:10:46.27,0:10:48.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu bukan memar jatuh biasa.{\i0}
Dialogue: 0,0:10:48.85,0:10:49.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di mana adikku?
Dialogue: 0,0:10:50.48,0:10:51.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat.
Dialogue: 0,0:10:53.86,0:10:54.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo...
Dialogue: 0,0:10:57.44,0:10:58.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bayarlah.
Dialogue: 0,0:10:58.78,0:11:02.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayahmu tak datang,\Nkurasa kalian masih tak punya uang.
Dialogue: 0,0:11:05.41,0:11:06.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terserah.
Dialogue: 0,0:11:06.45,0:11:08.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kujual saja adikmu.
Dialogue: 0,0:11:10.21,0:11:12.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika berlatih sekarang, masih ada waktu.
Dialogue: 0,0:11:17.67,0:11:19.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Adikku tak bisa bicara.
Dialogue: 0,0:11:19.13,0:11:21.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bisa jual aku lebih mahal.
Dialogue: 0,0:11:21.84,0:11:23.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa?{\i0}
Dialogue: 0,0:11:23.01,0:11:25.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku mengharapkan kisah sedih.{\i0}
Dialogue: 0,0:11:25.76,0:11:27.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau paham ucapanmu?
Dialogue: 0,0:11:27.72,0:11:29.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:11:29.06,0:11:31.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak mau jadi pengemis selamanya.
Dialogue: 0,0:11:31.06,0:11:33.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada akhirnya,\Naku akan dipaksa menjadi pelacur.
Dialogue: 0,0:11:33.85,0:11:36.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah akan mengambil semua uangku.
Dialogue: 0,0:11:36.57,0:11:39.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu berarti\Nlebih baik kau jadi pelacur sendiri?
Dialogue: 0,0:11:39.99,0:11:41.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tepat sekali!
Dialogue: 0,0:11:41.07,0:11:42.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau dari Verdigris, bukan?
Dialogue: 0,0:11:43.74,0:11:45.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau ingin aku mencarikanmu pekerjaan, ya?
Dialogue: 0,0:11:45.95,0:11:46.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:11:48.70,0:11:51.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutmu kau seberharga itu?
Dialogue: 0,0:11:52.58,0:11:54.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama seperti adikku, bukan?
Dialogue: 0,0:11:54.67,0:11:56.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia masih muda.
Dialogue: 0,0:11:56.29,0:11:58.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia akan cepat belajar dengan latihan.
Dialogue: 0,0:11:58.25,0:11:59.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bahkan tak bisa bicara!
Dialogue: 0,0:11:59.88,0:12:02.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagian pelanggan\Nlebih suka yang pendiam.
Dialogue: 0,0:12:02.55,0:12:03.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetap saja!
Dialogue: 0,0:12:03.80,0:12:07.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika tak kabur,\Naku akan terjebak di lumpur selamanya!
Dialogue: 0,0:12:07.85,0:12:09.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak mau.
Dialogue: 0,0:12:09.10,0:12:11.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sama sekali tak mau!
Dialogue: 0,0:12:15.65,0:12:17.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ini juga sering terjadi.{\i0}
Dialogue: 0,0:12:17.61,0:12:18.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun,{\i0}
Dialogue: 0,0:12:18.69,0:12:22.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}daripada orang naif yang mengharapkan\Norang lain menyelamatkannya,{\i0}
Dialogue: 0,0:12:22.70,0:12:25.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}aku lebih suka\Nyang berjuang untuk diri sendiri.{\i0}
Dialogue: 0,0:12:25.61,0:12:27.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana dengan adikmu?
Dialogue: 0,0:12:27.70,0:12:29.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan bekerja untuk kami.
Dialogue: 0,0:12:29.20,0:12:32.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu mereka tahu aku bisa bekerja,\Nkami akan diterima, bukan?
Dialogue: 0,0:12:34.58,0:12:35.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau gagal?
Dialogue: 0,0:12:35.71,0:12:37.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tak apa-apa?\N- Kalian akan jadi tikus got.
Dialogue: 0,0:12:38.38,0:12:39.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu itu.
Dialogue: 0,0:12:52.43,0:12:53.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini?
Dialogue: 0,0:12:53.93,0:12:55.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gunakan sumur.
Dialogue: 0,0:12:55.44,0:12:57.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dingin, tetapi cuci rambutmu juga.
Dialogue: 0,0:12:57.27,0:13:00.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau punya kutu, mereka\Nakan memukulmu dengan sapu dan mengusirmu.
Dialogue: 0,0:13:10.37,0:13:11.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ke depannya,{\i0}
Dialogue: 0,0:13:12.41,0:13:15.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}aku tak tahu\Napa yang akan terjadi padanya.{\i0}
Dialogue: 0,0:13:16.21,0:13:17.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia telah memilih.{\i0}
Dialogue: 0,0:13:21.75,0:13:23.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia memilih jalan untuk dirinya.{\i0}
Dialogue: 0,0:13:28.72,0:13:30.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jika akhirnya menyesalinya,{\i0}
Dialogue: 0,0:13:31.81,0:13:35.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dia bisa menyalahkan diri sendiri.{\i0}
Dialogue: 0,0:13:42.32,0:13:43.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada masalah?
Dialogue: 0,0:13:44.53,0:13:46.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dapat kabar dari Klan Mi.
Dialogue: 0,0:13:47.15,0:13:48.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari seseorang rahasia?
Dialogue: 0,0:13:48.70,0:13:50.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, lihatlah.
Dialogue: 0,0:13:57.37,0:13:59.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada obat mencurigakan yang beredar?
Dialogue: 0,0:14:00.29,0:14:02.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah harus mengungkapnya?
Dialogue: 0,0:14:02.17,0:14:04.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa diserang\Njika membuat keributan tanpa bukti.
Dialogue: 0,0:14:05.30,0:14:06.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus tangkap saat beraksi.
Dialogue: 0,0:14:07.55,0:14:10.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya asalnya masih belum diketahui,
Dialogue: 0,0:14:10.01,0:14:12.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tetapi laporan ini menyebutkan\Nkesamaan di antara pemakai.
Dialogue: 0,0:14:13.81,0:14:14.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Wanita Putih.
Dialogue: 0,0:14:15.39,0:14:16.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Wanita Putih?
Dialogue: 0,0:14:16.98,0:14:19.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Belakangan aku sering mendengar\Nnama itu di jalanan.
Dialogue: 0,0:14:20.31,0:14:23.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, kita sudah cukup sibuk\Nberurusan dengan wabah belalang...
Dialogue: 0,0:14:25.28,0:14:27.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buku gambar itu akhirnya tiba.
Dialogue: 0,0:14:28.07,0:14:30.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus segera membawanya ke Maomao.
Dialogue: 0,0:14:30.16,0:14:32.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau akan pergi sendiri, Tuan Jinshi?
Dialogue: 0,0:14:32.37,0:14:33.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:14:33.45,0:14:35.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga ingin tahu pendapatnya soal ini.
Dialogue: 0,0:14:35.91,0:14:38.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal dayang yang membantu tugas medis?
Dialogue: 0,0:14:40.25,0:14:41.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun...
Dialogue: 0,0:14:52.51,0:14:54.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Jinshi sibuk.
Dialogue: 0,0:14:55.14,0:14:56.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:14:56.06,0:14:57.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ada apa ini?{\i0}
Dialogue: 0,0:14:58.39,0:15:01.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Juga, sepertinya mereka\Nmasih menggunakan nama kasimnya.{\i0}
Dialogue: 0,0:15:02.06,0:15:05.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kurasa nama aslinya\Nsulit diucapkan dengan santai.{\i0}
Dialogue: 0,0:15:05.07,0:15:09.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia menghindari ruang tertutup denganku\Nagar tak ada yang salah paham.{\i0}
Dialogue: 0,0:15:09.28,0:15:12.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kurasa dia bersikap bijak\Nsebagai asisten Tuan Jinshi.{\i0}
Dialogue: 0,0:15:15.91,0:15:17.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tukang menguping menyebalkan.{\i0}
Dialogue: 0,0:15:19.33,0:15:21.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buku yang tersisa di benteng.
Dialogue: 0,0:15:22.75,0:15:23.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika boleh...
Dialogue: 0,0:15:26.05,0:15:26.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Burung.{\i0}
Dialogue: 0,0:15:27.46,0:15:28.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ikan.{\i0}
Dialogue: 0,0:15:29.51,0:15:30.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tanaman.{\i0}
Dialogue: 0,0:15:30.88,0:15:34.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku hanya membaca buku "Tanaman"\Ndi benteng... Ini dia.{\i0}
Dialogue: 0,0:15:36.85,0:15:38.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Buku serangga.{\i0}
Dialogue: 0,0:15:39.35,0:15:41.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada gambar belalang kembara\Ndi situ, bukan?
Dialogue: 0,0:15:42.44,0:15:43.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya.
Dialogue: 0,0:15:48.19,0:15:49.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak ada?
Dialogue: 0,0:15:49.82,0:15:50.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak ada.
Dialogue: 0,0:15:50.95,0:15:54.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin ada yang ambil buku dari gudang?
Dialogue: 0,0:15:54.91,0:15:57.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa yang tertarik dengan benda ini?
Dialogue: 0,0:15:57.66,0:15:59.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagian orang suka ini.
Dialogue: 0,0:16:00.25,0:16:01.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa Sazen membohongiku?{\i0}
Dialogue: 0,0:16:01.91,0:16:04.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tidak, itu tak akan menguntungkannya.{\i0}
Dialogue: 0,0:16:09.51,0:16:11.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Sayang.
Dialogue: 0,0:16:11.55,0:16:13.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Punggungmu berdebu.
Dialogue: 0,0:16:13.01,0:16:15.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Apa-apaan?
Dialogue: 0,0:16:15.39,0:16:17.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih ada.
Dialogue: 0,0:16:17.01,0:16:19.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kubersihkan. Diamlah.
Dialogue: 0,0:16:19.77,0:16:21.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu...
Dialogue: 0,0:16:22.98,0:16:25.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kak Pairin mulai gelisah.{\i0}
Dialogue: 0,0:16:26.06,0:16:29.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sebagai pelacur kelas atas,\Ndia tak bisa menerima pelanggan tiap hari.{\i0}
Dialogue: 0,0:16:30.73,0:16:34.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}- Akan lucu jika Tuan Lihaku ada di sini.{\i0}\N- Jangan khawatir. Serahkan padaku...
Dialogue: 0,0:16:36.82,0:16:40.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pergi!\NSudah kuberi bukunya, tugasku selesai!
Dialogue: 0,0:16:41.54,0:16:44.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keperawanan juga masih utuh...
Dialogue: 0,0:16:44.42,0:16:47.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia melewatkan surga.
Dialogue: 0,0:16:47.13,0:16:49.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Maksudmu "neraka"?{\i0}
Dialogue: 0,0:16:49.63,0:16:52.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, sungguh. Bagaimana sekarang?
Dialogue: 0,0:16:56.55,0:16:58.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ukyou. Kau melihat Sazen?
Dialogue: 0,0:16:58.72,0:17:00.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia menyapu di luar.
Dialogue: 0,0:17:01.56,0:17:03.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mengerjakan tugas pelayan wanita?
Dialogue: 0,0:17:03.52,0:17:04.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:17:04.48,0:17:06.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika dia senang bersih-bersih,
Dialogue: 0,0:17:06.48,0:17:09.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tak bisa membuatnya\Nbekerja sebagai pelayan pria...
Dialogue: 0,0:17:16.95,0:17:18.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau menatapku?
Dialogue: 0,0:17:18.99,0:17:19.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:17:20.41,0:17:22.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ceritamu tidak cocok.
Dialogue: 0,0:17:22.75,0:17:24.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak ada tentang belalang kembara di sini.
Dialogue: 0,0:17:25.41,0:17:27.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tidak mungkin.
Dialogue: 0,0:17:27.46,0:17:29.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, di mana volume satunya?
Dialogue: 0,0:17:29.29,0:17:30.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:17:30.29,0:17:33.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seri buku gambar serangga\Nmemiliki tiga volume.
Dialogue: 0,0:17:34.01,0:17:35.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, apa itu berarti
Dialogue: 0,0:17:35.42,0:17:39.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tak ada gambar belalang kembara\Ndi benteng itu sejak awal?
Dialogue: 0,0:17:39.55,0:17:43.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin ada\Nsaat apoteker tua itu ada di sana.
Dialogue: 0,0:17:44.14,0:17:46.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa mungkin buku itu\Nditaruh di peti matinya?
Dialogue: 0,0:17:46.39,0:17:49.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu tradisi di kampung halamanku.{\i0}
Dialogue: 0,0:17:51.48,0:17:56.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, mengerikan dia meninggal\Nkarena eksperimen yang gagal itu.
Dialogue: 0,0:17:56.36,0:17:58.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eksperimen kehidupan abadi.
Dialogue: 0,0:17:59.11,0:18:01.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ada tikus percobaan di benteng itu,{\i0}
Dialogue: 0,0:18:01.74,0:18:04.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}tetapi obatnya untuk manusia.{\i0}
Dialogue: 0,0:18:04.83,0:18:08.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Menguji pada manusia adalah satu-satunya\Ncara memaksimalkan kesuksesan...{\i0}
Dialogue: 0,0:18:10.21,0:18:11.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, ada apa?
Dialogue: 0,0:18:16.17,0:18:18.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mayatnya dibuang di mana?
Dialogue: 0,0:18:18.51,0:18:20.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak tahu.
Dialogue: 0,0:18:20.47,0:18:22.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seseorang biasanya mengurus hal itu.
Dialogue: 0,0:18:23.76,0:18:25.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seseorang?
Dialogue: 0,0:18:25.10,0:18:27.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang tanpa ekspresi.
Dialogue: 0,0:18:27.60,0:18:29.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asisten pria tua itu.
Dialogue: 0,0:18:31.36,0:18:32.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh!
Dialogue: 0,0:18:32.27,0:18:33.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Benar.{\i0}
Dialogue: 0,0:18:33.77,0:18:35.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kenapa aku tak sadar?{\i0}
Dialogue: 0,0:18:35.98,0:18:38.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Wanita itu pasti melihatnya dari dekat.{\i0}
Dialogue: 0,0:18:39.28,0:18:40.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku ingin tahu pendapatnya.{\i0}
Dialogue: 0,0:18:40.99,0:18:42.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jika kutulis surat pada Tuan Jinshi...{\i0}
Dialogue: 0,0:18:43.33,0:18:45.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayolah! Kembalikan putriku!
Dialogue: 0,0:18:45.87,0:18:47.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, aku ingat kau.
Dialogue: 0,0:18:48.54,0:18:50.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apoteker, apanya!
Dialogue: 0,0:18:50.42,0:18:53.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau menjual mereka, bukan?
Dialogue: 0,0:18:53.34,0:18:57.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Aku tak menjual mereka.\NItu tak ada hubungannya.
Dialogue: 0,0:18:57.05,0:19:00.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak ada yang membayarku.\NAku bahkan tak dapat biaya obat.
Dialogue: 0,0:19:01.55,0:19:04.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cukup baik\Nmembiarkan mereka membayar nanti.
Dialogue: 0,0:19:04.05,0:19:06.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mungkin pantas\Ndapat bayaran tambahan untuk ini.
Dialogue: 0,0:19:07.85,0:19:09.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tutup mulutmu!\N- Tunggu sebentar...
Dialogue: 0,0:19:09.77,0:19:13.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Putri"? Maksudmu dua saudari\Ndalam masa percobaan itu?
Dialogue: 0,0:19:13.19,0:19:14.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:19:14.11,0:19:15.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial, minggir!
Dialogue: 0,0:19:16.86,0:19:18.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tak pernah belajar, ya?
Dialogue: 0,0:19:19.74,0:19:22.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah berapa kali\Nkau buat keributan di sini?
Dialogue: 0,0:19:23.24,0:19:24.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau salah tempat.
Dialogue: 0,0:19:25.95,0:19:27.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diam!
Dialogue: 0,0:19:27.12,0:19:29.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka putriku.
Dialogue: 0,0:19:29.20,0:19:30.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka milikku!
Dialogue: 0,0:19:30.33,0:19:31.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyerahlah.
Dialogue: 0,0:19:41.22,0:19:43.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei! Ayah datang!
Dialogue: 0,0:19:43.76,0:19:47.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau menjemput kalian. Ayo pulang.
Dialogue: 0,0:19:47.35,0:19:48.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya?
Dialogue: 0,0:19:55.94,0:19:58.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, tunggu! Ayolah!
Dialogue: 0,0:19:59.44,0:20:00.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka tak bisa kembali.
Dialogue: 0,0:20:01.57,0:20:05.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putrimu mendatangiku\Ningin menjadi pelacur.
Dialogue: 0,0:20:12.29,0:20:15.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka berdua tak mau berurusan denganmu.
Dialogue: 0,0:20:21.59,0:20:25.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana aku bisa hidup sekarang?
Dialogue: 0,0:20:35.06,0:20:36.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah semuanya?
Dialogue: 0,0:20:36.73,0:20:37.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:20:45.70,0:20:46.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai jumpa!
Dialogue: 0,0:20:56.50,0:20:58.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau pergi? Ajak aku.
Dialogue: 0,0:21:01.42,0:21:03.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak. Ini urusan pekerjaan.
Dialogue: 0,0:21:03.59,0:21:04.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelit!
Dialogue: 0,0:21:08.05,0:21:11.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Di tempat tujuanku,\Nada anak-anak dari Klan Shi.{\i0}
Dialogue: 0,0:21:11.35,0:21:13.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tak kubiarkan kau bertemu mereka.{\i0}
Dialogue: 0,0:21:15.27,0:21:16.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tetap saja.{\i0}
Dialogue: 0,0:21:16.60,0:21:20.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mereka pasti bekerja cepat.\NLangsung datang sehari setelah aku minta.{\i0}
Dialogue: 0,0:21:21.36,0:21:22.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo!
Dialogue: 0,0:21:25.49,0:21:27.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dasar bodoh.{\i0}
Dialogue: 0,0:21:27.91,0:21:32.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun, aku masih tak tahu\Nharus bagaimana dengan masa depan Chou-u.{\i0}
Dialogue: 0,0:21:33.04,0:21:36.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jika bukan karena kelumpuhan itu,\Ndia bisa jadi pelayan pria.{\i0}
Dialogue: 0,0:21:38.79,0:21:40.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Haruskah kujadikan dia apoteker?{\i0}
Dialogue: 0,0:21:41.50,0:21:43.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu akan bagus,{\i0}
Dialogue: 0,0:21:43.01,0:21:45.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}tetapi dia bahkan belum tampak tertarik.{\i0}
Dialogue: 0,0:21:54.14,0:21:55.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun, sangat menyenangkan...{\i0}
Dialogue: 0,0:22:06.82,0:22:08.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis itu akan berkunjung.
Dialogue: 0,0:22:09.49,0:22:11.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku penasaran yang dia butuhkan darimu,
Dialogue: 0,0:22:11.45,0:22:12.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rei.
Dialogue: 0,0:22:14.08,0:22:15.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:23:53.84,0:23:57.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Episode selanjutnya, "Volume Terakhir".{\i0}
Dialogue: 0,0:23:58.81,0:24:00.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Terjemahan subtitle oleh Amalia Puspita
