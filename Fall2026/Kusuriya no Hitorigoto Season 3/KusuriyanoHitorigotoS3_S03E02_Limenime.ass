Dialogue: 0,0:01:31.59,0:01:32.67,sign,,0000,0000,0000,,{\an8}KISAH INI FIKSI, SEMUA NAMA TOKOH\NDAN ORGANISASINYA JUGA FIKTIF.
Dialogue: 0,0:01:32.67,0:01:33.88,sign,,0000,0000,0000,,{\an8}SELAIN ITU, KISAH INI TAK ADA HUBUNGANNYA\NDENGAN INSIDEN ATAU PERISTIWA NYATA.
Dialogue: 0,0:15:37.35,0:15:38.43,sign,,0000,0000,0000,,SERANGGA BAGIAN I
Dialogue: 0,0:23:46.00,0:23:52.80,sign,,0000,0000,0000,,CUPLIKAN EPISODE SELANJUTNYA
Dialogue: 0,0:01:33.88,0:01:36.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Hei, sudah dengar rumornya?
Dialogue: 0,0:01:36.22,0:01:39.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tentang wanita jahat\Nyang memicu pemberontakan?{\i0}
Dialogue: 0,0:01:39.51,0:01:42.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Adik Kaisar memerintahkan\NTentara Terlarang{\i0}
Dialogue: 0,0:01:42.22,0:01:43.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}menghukum penjahat, ya?{\i0}
Dialogue: 0,0:01:44.14,0:01:46.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun, penjahat bernama Loulan itu{\i0}
Dialogue: 0,0:01:46.10,0:01:48.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}tampaknya melukai wajah adik Kaisar.{\i0}
Dialogue: 0,0:01:50.11,0:01:51.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kejam sekali.{\i0}
Dialogue: 0,0:01:54.57,0:01:55.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Jinshi.
Dialogue: 0,0:01:56.40,0:01:57.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Apa?
Dialogue: 0,0:01:57.90,0:02:00.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Ini beredar di seluruh kota.
Dialogue: 0,0:02:00.87,0:02:04.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka menulis tentangmu\Ndan pemberontakan Klan Shi
Dialogue: 0,0:02:04.20,0:02:05.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan tidak terkendali.
Dialogue: 0,0:02:07.83,0:02:09.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biarkan saja.
Dialogue: 0,0:02:09.29,0:02:10.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:02:10.33,0:02:12.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu ini dari gadis itu.
Dialogue: 0,0:02:13.34,0:02:14.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari Maomao?
Dialogue: 0,0:02:18.84,0:02:22.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apotekku tutup saat Rumah Verdigris buka.{\i0}
Dialogue: 0,0:02:23.51,0:02:25.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pelanggan baik tak datang malam hari.{\i0}
Dialogue: 0,0:02:25.89,0:02:28.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Menyalakan lampu itu buang-buang minyak.{\i0}
Dialogue: 0,0:02:32.61,0:02:33.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nenek.
Dialogue: 0,0:02:33.73,0:02:34.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:02:34.65,0:02:37.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penjualan hari ini. Silakan kau urus.
Dialogue: 0,0:02:37.15,0:02:38.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:02:38.44,0:02:40.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chou-u, saatnya pulang.
Dialogue: 0,0:02:41.36,0:02:43.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah saatnya pulang?
Dialogue: 0,0:02:47.29,0:02:48.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dingin sekali…
Dialogue: 0,0:02:50.08,0:02:52.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kau tak mau makan?
Dialogue: 0,0:02:52.00,0:02:53.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku akan makan…
Dialogue: 0,0:02:56.21,0:02:57.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Bangun dari ranjang.
Dialogue: 0,0:02:58.55,0:02:59.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jahat!
Dialogue: 0,0:02:59.88,0:03:01.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diam dan pakai ini.
Dialogue: 0,0:03:05.35,0:03:07.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau daging lagi.
Dialogue: 0,0:03:07.35,0:03:09.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulailah cari uang.
Dialogue: 0,0:03:09.93,0:03:13.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku dapat cukup dana\Nuntuk menghidupi Chou-u,{\i0}
Dialogue: 0,0:03:13.15,0:03:14.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}tetapi aku tak mau boros.{\i0}
Dialogue: 0,0:03:15.57,0:03:18.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayolah, Bintik. Kau dapat banyak uang.
Dialogue: 0,0:03:18.94,0:03:20.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kita tak makan yang lebih enak?
Dialogue: 0,0:03:20.86,0:03:24.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengar, Bodoh.\NAku sewa tempat untuk tokoku dari Nenek.
Dialogue: 0,0:03:24.74,0:03:26.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sewa lebih mahal dari yang kau kira.
Dialogue: 0,0:03:29.45,0:03:30.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kedinginan…
Dialogue: 0,0:03:30.71,0:03:33.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pakaian itu memang tampak dingin.{\i0}
Dialogue: 0,0:03:34.58,0:03:36.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan belanja baju besok. Ikutlah.
Dialogue: 0,0:03:36.92,0:03:38.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:03:38.17,0:03:39.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hore!
Dialogue: 0,0:03:40.63,0:03:42.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh!
Dialogue: 0,0:03:47.10,0:03:48.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan berkeliaran.
Dialogue: 0,0:03:51.73,0:03:54.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jalan utama ini membagi ibu kota\Nmenjadi Timur dan Barat.{\i0}
Dialogue: 0,0:03:54.73,0:03:57.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Makin ke utara,\Ntoko-toko jadi lebih bagus.{\i0}
Dialogue: 0,0:03:57.86,0:04:00.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Makin jauh ke selatan,\Nmakin rendah kualitasnya.{\i0}
Dialogue: 0,0:04:02.03,0:04:05.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jalan kecil juga penuh\Ndengan pedagang yang mencurigakan.{\i0}
Dialogue: 0,0:04:06.20,0:04:07.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kubilang jangan berkeliaran.
Dialogue: 0,0:04:12.04,0:04:13.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini dia.
Dialogue: 0,0:04:13.33,0:04:15.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayolah, baju bekas?
Dialogue: 0,0:04:15.71,0:04:17.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan serakah.
Dialogue: 0,0:04:17.42,0:04:19.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pakaian musim dingin untuk anak-anak…
Dialogue: 0,0:04:21.55,0:04:22.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:04:27.26,0:04:29.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Seperti pakaian suku barbar.{\i0}
Dialogue: 0,0:04:30.06,0:04:32.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agak lusuh, ya?
Dialogue: 0,0:04:32.85,0:04:33.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh!
Dialogue: 0,0:04:36.23,0:04:38.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampak lusuh, ya?
Dialogue: 0,0:04:38.06,0:04:39.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Bukankah begitu?
Dialogue: 0,0:04:39.73,0:04:43.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Pakaian gadis muda\Nharus berwarna lebih cerah, bukan?
Dialogue: 0,0:04:43.49,0:04:45.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biasanya, ya, kurasa.
Dialogue: 0,0:04:46.32,0:04:49.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini jubah yang dipakai\Noleh seorang gadis langit.
Dialogue: 0,0:04:49.66,0:04:51.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis langit?
Dialogue: 0,0:04:51.66,0:04:55.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis cantik dari langit\Nyang menghilang di danau.
Dialogue: 0,0:04:55.16,0:04:56.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau dengar legendanya?
Dialogue: 0,0:04:57.58,0:04:58.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu mau!
Dialogue: 0,0:04:58.50,0:05:01.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pemilik toko ini suka mengoceh.{\i0}
Dialogue: 0,0:05:02.05,0:05:04.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pasti ayahku juga jatuh ke perangkapnya.{\i0}
Dialogue: 0,0:05:08.01,0:05:11.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kisah ini terjadi di sebuah desa barat.
Dialogue: 0,0:05:13.31,0:05:16.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Suatu hari, seorang pemuda desa\Nmenyelamatkan seorang gadis yang tersesat.{\i0}
Dialogue: 0,0:05:17.98,0:05:22.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia sangat cantik\Ndengan rambut keemasan dan kulit cerah.{\i0}
Dialogue: 0,0:05:23.57,0:05:26.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu cinta pada pandangan pertama\Nbagi pemuda itu.{\i0}
Dialogue: 0,0:05:28.07,0:05:32.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sebagai ucapan terima kasih,\Ngadis itu menenun jubah untuk pemuda itu.{\i0}
Dialogue: 0,0:05:34.16,0:05:37.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jubah itu,\Nyang disulam dengan desain aneh,{\i0}
Dialogue: 0,0:05:37.33,0:05:41.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}ternyata terjual beberapa kali lipat\Ndari harga kain lain.{\i0}
Dialogue: 0,0:05:41.42,0:05:46.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Seiring waktu, gadis itu menangis\Ndan sangat ingin pulang,{\i0}
Dialogue: 0,0:05:46.92,0:05:49.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}tetapi pemuda yang jatuh cinta itu\Nberulang kali melamarnya{\i0}
Dialogue: 0,0:05:49.93,0:05:53.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}sampai akhirnya\Ngadis itu setuju menikahinya.{\i0}
Dialogue: 0,0:05:54.56,0:05:55.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tak lama kemudian,{\i0}
Dialogue: 0,0:05:55.89,0:05:58.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}keluarga gadis itu\Ndatang ke desa mencarinya.{\i0}
Dialogue: 0,0:05:59.60,0:06:02.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pemuda itu tak mau melepasnya.{\i0}
Dialogue: 0,0:06:02.61,0:06:04.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia menyembunyikan gadis itu,{\i0}
Dialogue: 0,0:06:04.11,0:06:07.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dan semua warga desa pura-pura tak tahu.{\i0}
Dialogue: 0,0:06:08.32,0:06:11.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Keluarga gadis itu pergi saat itu,{\i0}
Dialogue: 0,0:06:11.32,0:06:13.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}tetapi menyimpan kecurigaan.{\i0}
Dialogue: 0,0:06:13.99,0:06:18.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Maka, pemuda itu memutuskan\Nuntuk segera melakukan upacara pernikahan.{\i0}
Dialogue: 0,0:06:19.12,0:06:23.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Gadis itu merasakan keluarganya\Ndan menolak, tetapi pemuda itu kejam.{\i0}
Dialogue: 0,0:06:23.88,0:06:26.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia menyuruhnya\Nmembersihkan diri di mata air{\i0}
Dialogue: 0,0:06:26.17,0:06:30.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dan memakai gaun pengantin yang ditenun\Ndengan gaya kampung halamannya.{\i0}
Dialogue: 0,0:06:31.89,0:06:34.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Air matanya tak menunjukkan\Ntanda-tanda mengering.{\i0}
Dialogue: 0,0:06:34.60,0:06:36.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Seluruh tubuhnya basah kuyup.{\i0}
Dialogue: 0,0:06:38.89,0:06:44.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Terakhir kali, gadis itu memohon\Nuntuk dikembalikan ke keluarganya.{\i0}
Dialogue: 0,0:06:44.40,0:06:46.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun, saat pemuda itu menolak…{\i0}
Dialogue: 0,0:06:57.62,0:07:00.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Yang tersisa hanya sehelai kain,{\i0}
Dialogue: 0,0:07:00.50,0:07:03.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}tudung yang dia pakai di kepalanya.{\i0}
Dialogue: 0,0:07:03.96,0:07:06.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia kembali ke langit.{\i0}
Dialogue: 0,0:07:06.42,0:07:09.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu yang dipercaya warga desa.{\i0}
Dialogue: 0,0:07:10.01,0:07:14.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inilah jubah yang ditenun\Noleh gadis langit itu sendiri.
Dialogue: 0,0:07:16.93,0:07:21.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Bintik. Ini luar biasa!\NKenapa kau tak membelinya?
Dialogue: 0,0:07:22.27,0:07:26.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona, karena kau mungkin\Nseusia gadis langit itu,
Dialogue: 0,0:07:26.07,0:07:27.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kuberi diskon.
Dialogue: 0,0:07:27.23,0:07:28.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mahal!
Dialogue: 0,0:07:28.65,0:07:30.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Beda satu digit…{\i0}
Dialogue: 0,0:07:30.32,0:07:33.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tak percaya legenda gadis langit itu?
Dialogue: 0,0:07:33.78,0:07:35.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di mana imajinasimu?
Dialogue: 0,0:07:35.37,0:07:37.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kata orang yang mau menipu.{\i0}
Dialogue: 0,0:07:37.99,0:07:41.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku sudah melihat\Ngadis langit menghilang di air.{\i0}
Dialogue: 0,0:07:44.33,0:07:46.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh kusentuh itu?
Dialogue: 0,0:07:46.25,0:07:49.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, tetapi jangan kena kotoran.
Dialogue: 0,0:07:49.71,0:07:53.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ada banyak keanehan di dunia ini,{\i0}
Dialogue: 0,0:07:53.51,0:07:56.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}tetapi selalu ada asalnya.{\i0}
Dialogue: 0,0:07:56.22,0:07:58.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Karena tak ada yang tahu asalnya,{\i0}
Dialogue: 0,0:07:58.60,0:08:00.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}orang mencoba meyakinkan diri{\i0}
Dialogue: 0,0:08:00.56,0:08:03.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dengan menyalahkan kutukan,\Nsihir, atau kadang bahkan hantu.{\i0}
Dialogue: 0,0:08:05.10,0:08:06.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Desain ini…
Dialogue: 0,0:08:07.86,0:08:11.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana jika kujual ini\Ndengan harga sepuluh kali lipat?
Dialogue: 0,0:08:11.24,0:08:12.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepuluh kali lipat?
Dialogue: 0,0:08:13.28,0:08:16.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau bisa,\Nakan kuberikan semua baju gratis.
Dialogue: 0,0:08:18.53,0:08:20.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengar itu, Chou-u?
Dialogue: 0,0:08:20.04,0:08:21.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepuluh kali lipat?
Dialogue: 0,0:08:21.91,0:08:24.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak ada yang akan bayar sebanyak itu.
Dialogue: 0,0:08:24.00,0:08:26.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa bicara gila, Bintik?
Dialogue: 0,0:08:27.00,0:08:29.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pak, aku mau pinjam jubah ini dan arang.
Dialogue: 0,0:08:29.92,0:08:31.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei! Apa yang kau lakukan?
Dialogue: 0,0:08:39.89,0:08:42.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan! Kau mau membakar\Nbarang berhargaku?
Dialogue: 0,0:08:45.02,0:08:47.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak terbakar…
Dialogue: 0,0:08:47.98,0:08:49.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu arang, bukan?
Dialogue: 0,0:08:49.86,0:08:51.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana mungkin?
Dialogue: 0,0:08:51.03,0:08:53.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona, apa yang…
Dialogue: 0,0:08:54.03,0:08:55.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sendiri yang bilang, bukan?
Dialogue: 0,0:08:56.36,0:08:59.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jubah ini ditenun oleh gadis langit!
Dialogue: 0,0:08:59.95,0:09:01.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis langit?
Dialogue: 0,0:09:01.37,0:09:03.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti yang kalian lihat,
Dialogue: 0,0:09:03.25,0:09:06.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}arang tak bisa membakar\Natau meninggalkan bekas pada jubah ini.
Dialogue: 0,0:09:06.46,0:09:08.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jubah ajaib aneh ini…
Dialogue: 0,0:09:10.25,0:09:11.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:09:13.55,0:09:14.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar!
Dialogue: 0,0:09:14.67,0:09:19.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini "jubah tikus api" legendaris\Nyang ditenun oleh gadis langit!
Dialogue: 0,0:09:20.47,0:09:22.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba kulihat!
Dialogue: 0,0:09:22.18,0:09:23.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berapa harganya?
Dialogue: 0,0:09:23.18,0:09:24.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepuluh! Akan kuberi sepuluh!
Dialogue: 0,0:09:24.73,0:09:26.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, 20.
Dialogue: 0,0:09:26.27,0:09:27.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan bayar 50!
Dialogue: 0,0:09:28.56,0:09:31.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bintik, panas sekali…
Dialogue: 0,0:09:31.07,0:09:32.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, lepaskan.
Dialogue: 0,0:09:32.44,0:09:35.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sendiri yang memilih memakainya,\Nbukan membawanya.
Dialogue: 0,0:09:35.78,0:09:39.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku lebih suka warna yang lebih lembut,{\i0}
Dialogue: 0,0:09:39.49,0:09:42.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}tetapi ini gratis,\Njadi, aku tak bisa mengeluh.{\i0}
Dialogue: 0,0:09:42.70,0:09:45.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kenapa jubah itu tak terbakar?
Dialogue: 0,0:09:46.12,0:09:48.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tahu pakaian terbuat dari apa?
Dialogue: 0,0:09:48.62,0:09:50.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapas, serat henep, dan lainnya?
Dialogue: 0,0:09:50.92,0:09:52.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serangga juga.
Dialogue: 0,0:09:52.38,0:09:55.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, tetapi jubah itu terbuat dari batu.
Dialogue: 0,0:09:55.59,0:09:57.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Batu?
Dialogue: 0,0:09:57.17,0:09:58.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Batu seperti ini?
Dialogue: 0,0:09:59.55,0:10:01.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Batu juga punya berbagai bentuk.
Dialogue: 0,0:10:02.47,0:10:05.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pakaian dari batu berserat\Ntak akan mudah terbakar.
Dialogue: 0,0:10:06.27,0:10:09.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kain yang tak mudah terbakar dari asbes\Ndisebut "huohuanbu",{\i0}
Dialogue: 0,0:10:09.81,0:10:12.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}juga dikenal sebagai "jubah tikus api".{\i0}
Dialogue: 0,0:10:13.73,0:10:18.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mereka mungkin tahu keberadaannya,\Ntetapi kebanyakan orang tak pernah lihat.{\i0}
Dialogue: 0,0:10:19.28,0:10:22.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik… Lalu bagaimana\Ndengan kisah gadis langit itu?
Dialogue: 0,0:10:22.53,0:10:26.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa itu separuh benar\Ndan separuh bohong.
Dialogue: 0,0:10:26.41,0:10:27.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan?
Dialogue: 0,0:10:28.66,0:10:31.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku mengenali sulaman di manset jubah itu.{\i0}
Dialogue: 0,0:10:32.46,0:10:35.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu karakter asing\Nyang sering digambar ayahku.{\i0}
Dialogue: 0,0:10:35.76,0:10:38.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Saat ditulis dengan gaya,\Ndesainnya seperti tumbuhan anggur.{\i0}
Dialogue: 0,0:10:39.38,0:10:43.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Yang disebut gadis langit\Nmungkin berasal dari negeri asing.{\i0}
Dialogue: 0,0:10:44.31,0:10:48.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Entah apakah dia\Nbenar-benar tersesat atau diculik,{\i0}
Dialogue: 0,0:10:48.31,0:10:51.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}tetapi dia menenun jubah itu\Ndengan keinginan mendalam untuk pulang.{\i0}
Dialogue: 0,0:10:52.36,0:10:56.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia menyulam desain dengan karakter\Nyang tak bisa dibaca oleh pemuda itu,{\i0}
Dialogue: 0,0:10:56.23,0:10:58.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}diam-diam meminta bantuan\Nkepada teman sebangsanya.{\i0}
Dialogue: 0,0:11:00.66,0:11:04.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, itu sebabnya\Nkeluarganya menjemputnya.
Dialogue: 0,0:11:04.58,0:11:06.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, pada hari pernikahannya,
Dialogue: 0,0:11:06.79,0:11:10.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}saat "membersihkan diri" di mata air,\Ndia merendam pakaian dalamnya{\i0}
Dialogue: 0,0:11:10.46,0:11:13.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dan mengenakan jubah asbes.{\i0}
Dialogue: 0,0:11:14.25,0:11:15.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa kau tahu?{\i0}
Dialogue: 0,0:11:15.34,0:11:19.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mangkuk kayu yang berisi air\Ntak akan terbakar sampai airnya menguap.{\i0}
Dialogue: 0,0:11:19.30,0:11:21.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Gagasan yang sama.{\i0}
Dialogue: 0,0:11:21.09,0:11:25.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Selain itu, jika melapisi pakaian yang\Nmudah terbakar dengan jubah putih itu,{\i0}
Dialogue: 0,0:11:25.89,0:11:28.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}api besar pun\Ntak akan langsung mengenai tubuh.{\i0}
Dialogue: 0,0:11:29.48,0:11:33.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia hanya perlu melompat ke mata air\Nsebelum terbakar.{\i0}
Dialogue: 0,0:11:33.60,0:11:36.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa tak beri tahu pria di toko itu?
Dialogue: 0,0:11:36.19,0:11:38.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia menghargai imajinasi, bukan?
Dialogue: 0,0:11:39.44,0:11:40.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak mengerti…
Dialogue: 0,0:11:43.11,0:11:44.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Gadis asing.{\i0}
Dialogue: 0,0:11:44.95,0:11:48.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apakah mungkin seorang gadis biasa{\i0}
Dialogue: 0,0:11:48.41,0:11:52.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}mengirim pesan melalui sulaman\Ndan membakar dirinya?{\i0}
Dialogue: 0,0:11:53.08,0:11:56.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia bisa membaca dan menulis.\NDia juga tahu tentang asbes.{\i0}
Dialogue: 0,0:11:57.04,0:12:00.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kenapa gadis seperti itu\Nberkeliaran di negeri asing?{\i0}
Dialogue: 0,0:12:02.59,0:12:05.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Negara Barat sering saling berkelahi.{\i0}
Dialogue: 0,0:12:06.35,0:12:09.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jika dipikir-pikir,\Ndua utusan yang mengunjungi Negara Li{\i0}
Dialogue: 0,0:12:09.89,0:12:11.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}juga berperilaku mencurigakan.{\i0}
Dialogue: 0,0:12:12.77,0:12:16.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Salah satunya\Nsepertinya punya hubungan dengan Klan Shi.{\i0}
Dialogue: 0,0:12:18.07,0:12:22.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Gadis langit itu mungkin mata-mata\Natau semacamnya.{\i0}
Dialogue: 0,0:12:23.03,0:12:24.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Atau mungkin bukan.{\i0}
Dialogue: 0,0:12:25.36,0:12:27.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Bintik?
Dialogue: 0,0:12:37.54,0:12:39.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang!
Dialogue: 0,0:12:40.17,0:12:41.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:12:41.46,0:12:44.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Xiaomao, kau kira\Npria di sebelahku ini orang lain?
Dialogue: 0,0:12:44.84,0:12:46.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini Tuan Jinshi.
Dialogue: 0,0:12:51.22,0:12:52.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan masuk.
Dialogue: 0,0:12:54.39,0:12:57.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sudah menipis sejak jahitannya lepas,{\i0}
Dialogue: 0,0:12:57.44,0:12:59.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}tetapi ternyata ada bekas luka.{\i0}
Dialogue: 0,0:12:59.86,0:13:02.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah ada yang ingin kau katakan?
Dialogue: 0,0:13:02.07,0:13:02.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Benar.{\i0}
Dialogue: 0,0:13:03.53,0:13:04.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong lihat ini.
Dialogue: 0,0:13:05.53,0:13:06.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini?
Dialogue: 0,0:13:06.57,0:13:08.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada penjarah oportunis
Dialogue: 0,0:13:08.41,0:13:12.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang mencuri ini\Ndari benteng Klan Shi dan menjualnya.
Dialogue: 0,0:13:12.04,0:13:13.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kau menemukannya?
Dialogue: 0,0:13:13.83,0:13:16.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kebetulan kutemukan di toko buku.
Dialogue: 0,0:13:16.33,0:13:20.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ukyou membantuku mengumpulkan\Nsemua yang dijual di kota lain.{\i0}
Dialogue: 0,0:13:21.59,0:13:24.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ukyou, bisa kau urus pria ini?
Dialogue: 0,0:13:24.59,0:13:27.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu, aku butuh\Nbantuan tambahan sekarang.
Dialogue: 0,0:13:27.89,0:13:30.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, Chou-u mengenalnya, bukan?
Dialogue: 0,0:13:30.85,0:13:32.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, itu masalah.
Dialogue: 0,0:13:33.02,0:13:34.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku akan ganti nama.
Dialogue: 0,0:13:35.39,0:13:37.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak akan merindukan nama lamaku.
Dialogue: 0,0:13:37.73,0:13:38.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebentar.
Dialogue: 0,0:13:39.56,0:13:40.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana dengan "Sazen"?
Dialogue: 0,0:13:41.52,0:13:45.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa istimewanya buku yang dijual "Sazen"?
Dialogue: 0,0:13:45.24,0:13:48.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buku lain seri ini ada di benteng, kurasa.
Dialogue: 0,0:13:48.57,0:13:50.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin kau mengumpulkannya.
Dialogue: 0,0:13:50.70,0:13:52.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau menginginkannya?
Dialogue: 0,0:13:52.66,0:13:53.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu…
Dialogue: 0,0:13:55.41,0:13:56.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena ini.
Dialogue: 0,0:13:56.79,0:13:58.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:13:58.08,0:13:59.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belalang kembara rebus.
Dialogue: 0,0:13:59.75,0:14:02.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, kebanyakan belalang daun.
Dialogue: 0,0:14:02.17,0:14:04.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak… aku tak mau makan itu!
Dialogue: 0,0:14:04.92,0:14:06.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak menyuruhmu.
Dialogue: 0,0:14:07.51,0:14:10.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada wabah belalang daun tahun lalu.
Dialogue: 0,0:14:11.01,0:14:14.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Petani tak memberi tahu\Nsoal wabah belalang kembara?
Dialogue: 0,0:14:16.10,0:14:18.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menerima laporan itu.
Dialogue: 0,0:14:18.19,0:14:20.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada kerusakan parah di lahan utara.
Dialogue: 0,0:14:20.94,0:14:24.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun, tak cukup buruk untuk menyebabkan\Nkematian karena kelaparan.{\i0}
Dialogue: 0,0:14:24.94,0:14:27.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk menutupi panen buruk,\Nkami mengambil cadangan
Dialogue: 0,0:14:27.78,0:14:30.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dari Binan-shu di selatan.
Dialogue: 0,0:14:30.20,0:14:31.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Binan-shu?
Dialogue: 0,0:14:31.91,0:14:32.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:14:33.33,0:14:38.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kami meminta bantuan Klan Bi,\Ndan mereka sangat membantu.{\i0}
Dialogue: 0,0:14:38.83,0:14:40.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:14:40.08,0:14:44.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, kerusakan akibat belalang sembara\Nbisa berlanjut selama beberapa tahun.
Dialogue: 0,0:14:44.13,0:14:47.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika terjadi lagi tahun ini,\Nkeadaan akan berat.
Dialogue: 0,0:14:48.17,0:14:49.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau benar.
Dialogue: 0,0:14:50.68,0:14:52.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Saat wabah belalang terjadi,{\i0}
Dialogue: 0,0:14:52.26,0:14:56.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}rakyat menyalahkan Kaisar\Nkarena tak memerintah negara dengan benar.{\i0}
Dialogue: 0,0:14:57.27,0:14:59.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Orang-orang sangat percaya takhayul.{\i0}
Dialogue: 0,0:14:59.39,0:15:02.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jika ini terjadi\Nsetahun setelah menghancurkan Klan Shi,{\i0}
Dialogue: 0,0:15:02.27,0:15:04.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}apa yang akan orang pikirkan?{\i0}
Dialogue: 0,0:15:05.27,0:15:10.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mungkin benar-benar membalikkan\Nisi buku yang beredar itu.{\i0}
Dialogue: 0,0:15:11.07,0:15:14.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tuan Jinshi mungkin menyadari itu juga.{\i0}
Dialogue: 0,0:15:14.07,0:15:16.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wabah belalang kembara adalah hal alami.
Dialogue: 0,0:15:17.12,0:15:19.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang harus kita lakukan?
Dialogue: 0,0:15:19.12,0:15:21.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membuat api untuk memancing serangga?
Dialogue: 0,0:15:21.67,0:15:24.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau hancurkan semuanya satu per satu?
Dialogue: 0,0:15:24.38,0:15:27.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sebabnya aku mencari ini.
Dialogue: 0,0:15:27.71,0:15:31.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gambar ini ditinggalkan\Noleh apoteker sebelumnya di benteng itu.
Dialogue: 0,0:15:32.38,0:15:35.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya, dia meneliti\Ncara mencegah wabah belalang kembara.
Dialogue: 0,0:15:36.35,0:15:37.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh?
Dialogue: 0,0:15:38.43,0:15:40.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak ada belalang kembara di sini.
Dialogue: 0,0:15:40.27,0:15:43.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya ada volume lain\Ntentang serangga.
Dialogue: 0,0:15:43.27,0:15:45.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa masih ada di benteng.
Dialogue: 0,0:15:47.52,0:15:51.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Walau aku tak tahu\Nsejauh apa penelitiannya,
Dialogue: 0,0:15:51.03,0:15:52.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}itu layak diselidiki.
Dialogue: 0,0:15:54.16,0:15:55.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gaoshun.
Dialogue: 0,0:15:55.07,0:15:58.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Akan kuatur untuk diperoleh\Ndalam beberapa hari ke depan.
Dialogue: 0,0:15:59.54,0:16:02.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Untuk saat ini, aku sudah beri tahu\Nsemua yang dia perlu tahu.{\i0}
Dialogue: 0,0:16:05.42,0:16:06.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau lelah, Tuan?
Dialogue: 0,0:16:08.63,0:16:10.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa begitu.
Dialogue: 0,0:16:10.88,0:16:12.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, aku baik-baik saja.
Dialogue: 0,0:16:14.80,0:16:17.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kalau begini, dia akan tumbang.{\i0}
Dialogue: 0,0:16:18.43,0:16:19.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:16:20.06,0:16:21.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia seharusnya tidur saja.{\i0}
Dialogue: 0,0:16:22.31,0:16:24.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jika dia selelah itu,{\i0}
Dialogue: 0,0:16:24.48,0:16:28.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dia harus istirahat\Ndan biarkan suruhannya bekerja.{\i0}
Dialogue: 0,0:16:29.02,0:16:31.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau ingin beristirahat, Tuan Jinshi?
Dialogue: 0,0:16:32.40,0:16:34.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertanyaan macam apa itu?
Dialogue: 0,0:16:34.03,0:16:36.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan segera siapkan ranjang.
Dialogue: 0,0:16:36.03,0:16:37.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidurlah.
Dialogue: 0,0:16:37.28,0:16:38.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sini?
Dialogue: 0,0:16:38.70,0:16:40.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takut tidur sendirian?
Dialogue: 0,0:16:42.29,0:16:44.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu lelucon. Tunggu sebentar…
Dialogue: 0,0:16:44.75,0:16:46.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, aku tak bisa tidur sendirian.
Dialogue: 0,0:16:49.96,0:16:52.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Begitu rupanya. Sepertinya dia kesepian.{\i0}
Dialogue: 0,0:16:54.97,0:16:58.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengerti, Tuan. Tunggu sebentar.
Dialogue: 0,0:17:02.27,0:17:04.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Butuh waktu untuk menyiapkan.
Dialogue: 0,0:17:04.39,0:17:05.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu.
Dialogue: 0,0:17:06.35,0:17:08.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu 30 menit.
Dialogue: 0,0:17:08.56,0:17:10.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu cukup untuk menyiapkannya?{\i0}
Dialogue: 0,0:17:12.53,0:17:13.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lewat sini.
Dialogue: 0,0:17:13.82,0:17:16.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Istirahatlah di sini, Tuan.
Dialogue: 0,0:17:16.86,0:17:19.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pekerjaan itu penting,\Ntetapi istirahat juga penting.
Dialogue: 0,0:17:20.62,0:17:21.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika mau mandi air hangat,
Dialogue: 0,0:17:21.95,0:17:24.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami siapkan mandi pengobatan di sebelah.
Dialogue: 0,0:17:25.29,0:17:27.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan pakai baju tidur ini.
Dialogue: 0,0:17:27.79,0:17:28.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:17:29.50,0:17:31.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Senyum surgawinya sudah hilang,{\i0}
Dialogue: 0,0:17:32.00,0:17:34.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}tetapi ketampanan surgawinya tetap ada.{\i0}
Dialogue: 0,0:17:37.72,0:17:39.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan dapat teman tidur, bukan?
Dialogue: 0,0:17:40.22,0:17:41.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:17:41.22,0:17:42.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan mandi sekarang.
Dialogue: 0,0:17:44.14,0:17:44.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan.
Dialogue: 0,0:17:54.65,0:17:57.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa ada gadis berpakaian seksi di sana?
Dialogue: 0,0:17:57.20,0:17:59.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka ahli pijat. Kau tidak suka?
Dialogue: 0,0:18:01.45,0:18:03.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya pijat, bukan?
Dialogue: 0,0:18:03.70,0:18:05.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biasanya lebih dari itu.
Dialogue: 0,0:18:05.87,0:18:07.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak mau mandi.
Dialogue: 0,0:18:07.58,0:18:09.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau kubantu berpakaian?
Dialogue: 0,0:18:09.75,0:18:11.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kupakai sendiri.
Dialogue: 0,0:18:17.63,0:18:19.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tubuhnya masih berotot.{\i0}
Dialogue: 0,0:18:19.89,0:18:23.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Meski sibuk,\Nkurasa dia masih sempat berlatih.{\i0}
Dialogue: 0,0:18:25.93,0:18:27.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan.
Dialogue: 0,0:18:28.14,0:18:30.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini? Obat tidur?
Dialogue: 0,0:18:30.85,0:18:32.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suplemen penguat.
Dialogue: 0,0:18:36.03,0:18:38.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk apa aku butuh suplemen penguat?
Dialogue: 0,0:18:38.49,0:18:42.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kudengar\Nini yang terbaik bagi pria yang lelah.
Dialogue: 0,0:18:43.66,0:18:45.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mengerti seperti apa kedengarannya?
Dialogue: 0,0:18:46.41,0:18:48.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutmu apa maksudku?
Dialogue: 0,0:18:51.54,0:18:56.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Meski dia laki-laki,\Nmungkin ucapanku harus hati-hati.{\i0}
Dialogue: 0,0:18:56.71,0:18:58.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang, Tuan Jinshi…
Dialogue: 0,0:19:00.72,0:19:01.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika boleh kutanya…
Dialogue: 0,0:19:01.97,0:19:03.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan.
Dialogue: 0,0:19:05.85,0:19:08.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau suka gadis seperti apa?
Dialogue: 0,0:19:17.36,0:19:18.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini?
Dialogue: 0,0:19:19.40,0:19:22.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Suiren bilang\Nkau lebih suka gadis seusiamu.
Dialogue: 0,0:19:23.37,0:19:25.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan khawatir. Mereka semua perawan.
Dialogue: 0,0:19:27.41,0:19:29.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka bukan tipemu?
Dialogue: 0,0:19:29.71,0:19:32.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih baik aku tidur sekarang.
Dialogue: 0,0:19:32.88,0:19:34.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biarkan aku tidur.
Dialogue: 0,0:19:34.13,0:19:35.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, gadis mana…
Dialogue: 0,0:19:35.34,0:19:36.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudku sungguh "tidur"!
Dialogue: 0,0:19:39.21,0:19:41.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau mau satu?
Dialogue: 0,0:19:41.13,0:19:43.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku suami yang takut istri.
Dialogue: 0,0:19:43.05,0:19:44.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putriku juga gila kebersihan.
Dialogue: 0,0:19:44.85,0:19:46.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Begitu rupanya.{\i0}
Dialogue: 0,0:19:46.26,0:19:49.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mungkin seharusnya aku tak menawarkan\Npelacur kepada pria beristri.{\i0}
Dialogue: 0,0:19:49.85,0:19:53.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bilang, "Ayah kotor.\NMandilah yang terakhir."
Dialogue: 0,0:19:53.15,0:19:55.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tahu seperti apa rasanya?
Dialogue: 0,0:19:55.02,0:19:56.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti…
Dialogue: 0,0:19:57.23,0:19:58.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}…perasaan putrinya.{\i0}
Dialogue: 0,0:20:07.91,0:20:10.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, permisi.
Dialogue: 0,0:20:17.50,0:20:19.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya nyanyikan lagu pengantar tidur.
Dialogue: 0,0:20:31.98,0:20:33.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak bisa bernyanyi.
Dialogue: 0,0:20:33.89,0:20:35.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak apa-apa.
Dialogue: 0,0:20:42.90,0:20:45.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kucing kecil, kucing kecil{\i0}
Dialogue: 0,0:20:46.28,0:20:49.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kucing kecil, kucing kecil{\i0}
Dialogue: 0,0:20:49.83,0:20:56.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia menangis dan menangis\NMemikirkan di mana anak itu{\i0}
Dialogue: 0,0:20:57.13,0:21:03.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Burung-burung kecil yang tak tahu apa pun{\i0}
Dialogue: 0,0:21:04.55,0:21:08.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Terbang semakin tinggi{\i0}
Dialogue: 0,0:21:08.55,0:21:11.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Di langit tinggi{\i0}
Dialogue: 0,0:21:11.89,0:21:14.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kucing kecil, kucing kecil{\i0}
Dialogue: 0,0:21:15.39,0:21:18.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kucing kecil, kucing kecil{\i0}
Dialogue: 0,0:21:18.81,0:21:22.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mimpi indah saat ini{\i0}
Dialogue: 0,0:21:22.99,0:21:26.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sampai jumpa besok{\i0}
Dialogue: 0,0:21:33.66,0:21:35.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Wajahnya kembali berwarna,{\i0}
Dialogue: 0,0:21:35.66,0:21:38.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dan dia habiskan tiga mangkuk bubur,\Naku yakin dia baik-baik saja.{\i0}
Dialogue: 0,0:21:39.46,0:21:40.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maomao.
Dialogue: 0,0:21:42.25,0:21:43.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Pairin.
Dialogue: 0,0:21:43.96,0:21:46.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau tak menerimanya saja?
Dialogue: 0,0:21:48.22,0:21:49.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah apa maksudmu.
Dialogue: 0,0:22:07.28,0:22:08.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan.
Dialogue: 0,0:23:54.51,0:23:57.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Episode selanjutnya,\N"Biarkan Mereka Makan Kue".{\i0}
Dialogue: 0,0:23:58.01,0:24:00.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Terjemahan subtitle oleh Amalia Puspita
