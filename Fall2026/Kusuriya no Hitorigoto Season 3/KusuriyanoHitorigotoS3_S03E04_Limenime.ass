Dialogue: 0,0:01:32.00,0:01:33.50,sign,,0000,0000,0000,,{\an8}KISAH INI FIKSI, SEMUA NAMA TOKOH\NDAN ORGANISASINYA JUGA FIKTIF.
Dialogue: 0,0:01:33.51,0:01:34.92,sign,,0000,0000,0000,,{\an8}SELAIN ITU, KISAH INI TAK ADA HUBUNGANNYA\NDENGAN INSIDEN ATAU PERISTIWA NYATA.
Dialogue: 0,0:23:46.09,0:23:48.76,sign,,0000,0000,0000,,CUPLIKAN EPISODE SELANJUTNYA
Dialogue: 0,0:01:52.65,0:01:54.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami sudah menunggu.
Dialogue: 0,0:02:10.00,0:02:11.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kau sudah selesai ganti baju?
Dialogue: 0,0:02:11.96,0:02:12.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:02:16.21,0:02:17.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ikuti aku.
Dialogue: 0,0:02:22.60,0:02:25.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Memang seperti ini vila Kaisar.{\i0}
Dialogue: 0,0:02:25.60,0:02:28.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kini menjadi kediaman\Nbagi empat mantan selirnya.{\i0}
Dialogue: 0,0:02:30.98,0:02:32.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku membawa tamumu.
Dialogue: 0,0:02:33.73,0:02:34.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang.
Dialogue: 0,0:02:34.65,0:02:37.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senang bertemu lagi, Nyonya Ah-Duo.
Dialogue: 0,0:02:37.82,0:02:39.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau ada urusan dengannya hari ini?
Dialogue: 0,0:02:39.99,0:02:40.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:02:41.41,0:02:43.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Cucu Kaisar sebelumnya{\i0}
Dialogue: 0,0:02:43.62,0:02:45.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dan keturunan Klan Shi.{\i0}
Dialogue: 0,0:02:46.33,0:02:49.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Suirei tak bisa kembali\Nke masyarakat lagi,{\i0}
Dialogue: 0,0:02:49.33,0:02:52.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}tinggal di sini\Nmungkin satu-satunya pilihannya.{\i0}
Dialogue: 0,0:02:53.00,0:02:55.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Entah apa rencana mereka{\i0}
Dialogue: 0,0:02:55.09,0:02:58.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}atau apa yang dipikirkan Kaisar.{\i0}
Dialogue: 0,0:02:58.76,0:03:00.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun, dia apoteker terampil.{\i0}
Dialogue: 0,0:03:00.76,0:03:03.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sayang jika bakatnya dikubur begitu saja.{\i0}
Dialogue: 0,0:03:03.55,0:03:07.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan pedulikan aku.\NBicaralah, anggap saja aku tak ada.
Dialogue: 0,0:03:07.52,0:03:09.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku akan duduk.
Dialogue: 0,0:03:13.56,0:03:16.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Katanya, "Jangan pedulikan aku,"\Ntetapi aku tak bisa...{\i0}
Dialogue: 0,0:03:20.61,0:03:22.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pernah lihat ini?
Dialogue: 0,0:03:25.87,0:03:27.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mentorku menggunakannya.
Dialogue: 0,0:03:28.37,0:03:29.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Apakah ini semuanya?
Dialogue: 0,0:03:30.41,0:03:31.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurang satu.
Dialogue: 0,0:03:32.37,0:03:35.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya ada 15 volume.
Dialogue: 0,0:03:35.71,0:03:38.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tahu di mana buku yang tak ada itu?
Dialogue: 0,0:03:39.92,0:03:40.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak tahu.
Dialogue: 0,0:03:41.63,0:03:43.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kurasa dia tak berbohong.{\i0}
Dialogue: 0,0:03:43.84,0:03:46.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia tak punya alasan untuk berbohong.{\i0}
Dialogue: 0,0:03:46.14,0:03:50.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, di mana\Nmentormu itu sekarang?
Dialogue: 0,0:03:52.35,0:03:54.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Sudah kuduga. Dia masih hidup, bukan?
Dialogue: 0,0:03:56.52,0:03:59.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentang obat kebangkitan yang kau gunakan.
Dialogue: 0,0:03:59.28,0:04:02.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa mentormu mengujinya\Npada dirinya sendiri, ya?
Dialogue: 0,0:04:04.70,0:04:05.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Benar.
Dialogue: 0,0:04:06.57,0:04:07.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu adalah{\i0}
Dialogue: 0,0:04:07.74,0:04:10.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}satu-satunya cara melarikan diri\Ndari benteng itu.{\i0}
Dialogue: 0,0:04:11.33,0:04:15.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, kurasa dia tak bisa diinterogasi.
Dialogue: 0,0:04:15.96,0:04:17.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa artinya?
Dialogue: 0,0:04:18.17,0:04:22.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat saja Kyou-u.\NKini kau memanggilnya "Chou-u", bukan?
Dialogue: 0,0:04:22.59,0:04:24.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia mengalami amnesia{\i0}
Dialogue: 0,0:04:24.09,0:04:26.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dan separuh tubuhnya lumpuh.{\i0}
Dialogue: 0,0:04:26.97,0:04:28.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu memberimu petunjuk?{\i0}
Dialogue: 0,0:04:29.01,0:04:31.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa dia kehilangan ingatan lamanya?{\i0}
Dialogue: 0,0:04:32.27,0:04:34.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak juga, tetapi semacam itu.
Dialogue: 0,0:04:35.69,0:04:39.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan, kau mungkin pernah bertemu dia\Ntanpa menyadarinya.
Dialogue: 0,0:04:39.69,0:04:41.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudmu?
Dialogue: 0,0:04:42.24,0:04:44.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau ingat desa mata air panas itu?
Dialogue: 0,0:04:45.28,0:04:46.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:04:46.82,0:04:49.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Desa tersembunyi\Ntempat mereka memuja rubah itu.{\i0}
Dialogue: 0,0:04:50.66,0:04:54.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mentorku adalah salah satu tetua\Nyang terbaring di sana.
Dialogue: 0,0:04:56.04,0:04:58.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mata air panas itu digunakan\Nuntuk perawatan medis.{\i0}
Dialogue: 0,0:04:59.29,0:05:01.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa dia bersembunyi di antara yang sakit{\i0}
Dialogue: 0,0:05:01.46,0:05:03.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}agar tak diketahui oleh Shenmei?{\i0}
Dialogue: 0,0:05:04.42,0:05:07.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bahkan tak tahu lagi siapa dirinya.
Dialogue: 0,0:05:08.22,0:05:10.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Jika mentorku masih sehat,
Dialogue: 0,0:05:11.22,0:05:16.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"gadis itu" tak akan berpikir\Nuntuk menyeretmu ke dalam kekacauan ini.
Dialogue: 0,0:05:17.23,0:05:19.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku yakin Suirei tahu apa yang terjadi.{\i0}
Dialogue: 0,0:05:19.98,0:05:22.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Shisui merencanakan insiden itu{\i0}
Dialogue: 0,0:05:22.36,0:05:25.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}untuk menyingkirkan ayahnya\Ndan korupsi di negara ini.{\i0}
Dialogue: 0,0:05:25.36,0:05:29.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Juga untuk membebaskan kakaknya\Ndari cengkeraman ibunya.{\i0}
Dialogue: 0,0:05:30.58,0:05:33.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Benar, jika mentor Suirei sehat,{\i0}
Dialogue: 0,0:05:33.12,0:05:37.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}menyeretku ke benteng itu\Ntidak akan diperlukan.{\i0}
Dialogue: 0,0:05:37.87,0:05:40.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Hilanglah petunjukku.{\i0}
Dialogue: 0,0:05:40.63,0:05:43.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kukira akhirnya\Nkutemukan beberapa petunjuk...{\i0}
Dialogue: 0,0:05:44.26,0:05:47.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Baik, mari bicarakan\Npenelitian belalang kembara mentor itu.
Dialogue: 0,0:05:47.30,0:05:48.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau tahu sesuatu?
Dialogue: 0,0:05:49.55,0:05:52.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak terlibat dalam penelitian itu.
Dialogue: 0,0:05:52.93,0:05:54.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak suka serangga.
Dialogue: 0,0:05:54.72,0:05:57.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serangga adalah keahlian gadis itu,\Nbukan aku.
Dialogue: 0,0:05:59.73,0:06:01.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, aku mengerti.
Dialogue: 0,0:06:01.69,0:06:02.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apalagi,{\i0}
Dialogue: 0,0:06:02.82,0:06:04.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}"gadis itu" tak ada lagi...{\i0}
Dialogue: 0,0:06:06.61,0:06:09.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah menerima perintah\Nmembuat obat kehidupan abadi,
Dialogue: 0,0:06:09.41,0:06:12.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebagian besar\Nbahan penelitian itu dibuang.
Dialogue: 0,0:06:13.49,0:06:16.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang tersisa hanya berkas di ruangan itu.
Dialogue: 0,0:06:16.91,0:06:19.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun, mentornya masih berusaha\Nmengembangkan penelitiannya.{\i0}
Dialogue: 0,0:06:19.87,0:06:22.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia mempelajari apa pun yang dia bisa{\i0}
Dialogue: 0,0:06:22.13,0:06:23.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}melalui pelayannya, Sazen.{\i0}
Dialogue: 0,0:06:24.46,0:06:25.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Masuk akal sekarang.{\i0}
Dialogue: 0,0:06:26.38,0:06:27.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal "gadis itu",
Dialogue: 0,0:06:27.42,0:06:30.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia pasti gadis yang pintar.
Dialogue: 0,0:06:31.09,0:06:34.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Meski begitu, kepintaran itu\Ntak akan membuatnya kembali.
Dialogue: 0,0:06:38.35,0:06:43.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudmu gadis pintar itu menghilang\Ntanpa meninggalkan apa pun?
Dialogue: 0,0:06:49.28,0:06:50.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:06:50.24,0:06:52.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak apa-apa, tenang saja.
Dialogue: 0,0:06:52.99,0:06:55.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak mau suasana kaku.
Dialogue: 0,0:06:55.03,0:06:55.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat.
Dialogue: 0,0:06:56.74,0:07:00.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tenggelam dalam pikirannya,\Ntak memedulikan kita.
Dialogue: 0,0:07:00.71,0:07:04.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tidak, aku tahu\Naku harus minta maaf di sini.{\i0}
Dialogue: 0,0:07:04.67,0:07:06.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun, jika Shisui meninggalkan sesuatu,{\i0}
Dialogue: 0,0:07:07.30,0:07:08.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}di mana itu?{\i0}
Dialogue: 0,0:07:13.09,0:07:14.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Benteng?{\i0}
Dialogue: 0,0:07:14.76,0:07:15.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Istana harem?{\i0}
Dialogue: 0,0:07:16.81,0:07:17.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kantor medis?{\i0}
Dialogue: 0,0:07:19.10,0:07:20.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kurasa tidak.{\i0}
Dialogue: 0,0:07:21.94,0:07:22.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pasti di...{\i0}
Dialogue: 0,0:07:29.19,0:07:30.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Klinik.
Dialogue: 0,0:07:30.45,0:07:31.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di klinik!
Dialogue: 0,0:07:33.66,0:07:35.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sebelum aku diculik dari istana harem,{\i0}
Dialogue: 0,0:07:35.95,0:07:38.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}aku yakin melihat gambar serangga di sana.{\i0}
Dialogue: 0,0:07:38.62,0:07:41.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sungguh, Shisui itu...{\i0}
Dialogue: 0,0:07:44.79,0:07:46.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Anak nakal yang cerdas.{\i0}
Dialogue: 0,0:07:50.17,0:07:51.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah ini?
Dialogue: 0,0:07:52.01,0:07:53.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, terima kasih.
Dialogue: 0,0:07:53.89,0:07:55.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah penculikanmu,
Dialogue: 0,0:07:55.55,0:07:58.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}semua yang ada di klinik disita.
Dialogue: 0,0:07:59.27,0:08:00.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini ada di sana.
Dialogue: 0,0:08:00.81,0:08:01.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:08:02.60,0:08:05.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tampaknya, klinik tutup sementara.{\i0}
Dialogue: 0,0:08:05.81,0:08:09.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Shenlü, wanita istana yang membantu\Npenculikanku dari istana harem,{\i0}
Dialogue: 0,0:08:09.23,0:08:10.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}mencoba bunuh diri.{\i0}
Dialogue: 0,0:08:10.74,0:08:13.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia selamat, tetapi kejahatannya serius.{\i0}
Dialogue: 0,0:08:13.74,0:08:15.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia ditangkap sebagai penjahat.{\i0}
Dialogue: 0,0:08:23.08,0:08:24.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini dia.
Dialogue: 0,0:08:26.46,0:08:28.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua gambar belalang?
Dialogue: 0,0:08:28.54,0:08:30.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, tampaknya begitu.
Dialogue: 0,0:08:30.76,0:08:32.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurut catatan yang tertulis di sini,
Dialogue: 0,0:08:32.80,0:08:36.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ada dua klasifikasi luas\Ndan tiga yang spesifik.
Dialogue: 0,0:08:37.01,0:08:40.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini belalang daun yang sering kita lihat.
Dialogue: 0,0:08:40.18,0:08:41.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melihat pembedahan ini,
Dialogue: 0,0:08:41.77,0:08:44.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sayapnya lebih pendek\Ndari dua jenis lainnya.
Dialogue: 0,0:08:44.98,0:08:48.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini yang diperkirakan\Nbertambah banyak tahun ini.
Dialogue: 0,0:08:48.90,0:08:51.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya jenis yang menyebabkan\Nwabah belalang kembara.
Dialogue: 0,0:08:53.82,0:08:56.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Warnanya cokelat, bukan hijau.
Dialogue: 0,0:08:57.07,0:08:58.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayapnya juga lebih panjang.
Dialogue: 0,0:09:00.03,0:09:03.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyebab wabah belalang kembara\Nskala kecil tahun lalu
Dialogue: 0,0:09:03.79,0:09:05.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin ini.
Dialogue: 0,0:09:05.71,0:09:10.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada dasarnya, mereka melalui fase\Ndan akhirnya menjadi berwarna cokelat?
Dialogue: 0,0:09:10.80,0:09:11.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya begitu.
Dialogue: 0,0:09:14.13,0:09:16.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dalam kondisi tertentu,{\i0}
Dialogue: 0,0:09:16.30,0:09:19.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}belalang mengubah warna dan bentuk sayap.{\i0}
Dialogue: 0,0:09:19.10,0:09:21.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Perubahan terjadi selama beberapa generasi{\i0}
Dialogue: 0,0:09:21.39,0:09:23.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dan tampaknya\Nbertambah banyak setiap kali.{\i0}
Dialogue: 0,0:09:24.02,0:09:26.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apakah wabah menyebabkan perubahan ini?{\i0}
Dialogue: 0,0:09:26.56,0:09:28.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Atau apakah perubahan ini memicu wabah?{\i0}
Dialogue: 0,0:09:29.61,0:09:31.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mungkin kelebihan populasi.{\i0}
Dialogue: 0,0:09:31.98,0:09:33.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Begitu menurut gambar.{\i0}
Dialogue: 0,0:09:33.61,0:09:34.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesimpulannya,
Dialogue: 0,0:09:35.32,0:09:36.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}wabah kecil belalang kembara
Dialogue: 0,0:09:36.90,0:09:39.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}merupakan tanda\Ndari kerusakan besar yang akan datang.
Dialogue: 0,0:09:41.20,0:09:45.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, wabah belalang kembara tahun ini\Nakan lebih menghancurkan?
Dialogue: 0,0:09:46.00,0:09:46.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:09:46.96,0:09:49.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, aku tak tahu seberapa parah.
Dialogue: 0,0:09:49.83,0:09:53.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah ada informasi\Ntentang cara mencegah kerusakan?
Dialogue: 0,0:09:56.34,0:09:58.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada.
Dialogue: 0,0:09:58.09,0:10:00.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya begitu kehancuran dimulai,
Dialogue: 0,0:10:00.26,0:10:02.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mereka harus dibasmi pada fase nimfa.
Dialogue: 0,0:10:02.68,0:10:04.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa serangan gelombang manusia.
Dialogue: 0,0:10:04.85,0:10:09.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Catatan ini juga menyarankan\Nmenyalakan api unggun setelah dewasa.
Dialogue: 0,0:10:09.77,0:10:11.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu yang selalu dilakukan.
Dialogue: 0,0:10:12.61,0:10:16.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada formula insektisida juga,\Ntetapi itu saja.
Dialogue: 0,0:10:18.45,0:10:19.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf soal itu.
Dialogue: 0,0:10:20.11,0:10:22.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Data ini agak mengecewakan.
Dialogue: 0,0:10:22.49,0:10:26.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak juga.\NFormula insektisida mungkin berguna.
Dialogue: 0,0:10:27.16,0:10:29.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kumpulkan bahannya dahulu.
Dialogue: 0,0:10:31.00,0:10:31.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peta ini
Dialogue: 0,0:10:32.46,0:10:35.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menunjukkan area\Ndengan wabah yang sedang terjadi.
Dialogue: 0,0:10:36.30,0:10:37.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ada yang kau ingat?
Dialogue: 0,0:10:38.59,0:10:40.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika harus kukatakan,
Dialogue: 0,0:10:41.18,0:10:45.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kurasa lebih buruk di dataran\Nkarena belalang daun tumbuh subur di sana.
Dialogue: 0,0:10:45.35,0:10:46.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin.
Dialogue: 0,0:10:46.97,0:10:50.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, wilayah ini baik-baik saja\Nselama puluhan tahun.
Dialogue: 0,0:10:50.31,0:10:52.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak ada wabah\Nbelalang kembara parah, tetapi...
Dialogue: 0,0:10:55.07,0:10:56.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hutan?
Dialogue: 0,0:10:56.36,0:11:00.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Di dekat hutan,\Nkurasa burung akan memakan belalang.
Dialogue: 0,0:11:00.95,0:11:04.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wilayah Shihoku-shu\Nmemiliki vegetasi subur di masa lalu,
Dialogue: 0,0:11:05.08,0:11:07.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tetapi pegunungan di sekitar sini\Ntelah digunduli.
Dialogue: 0,0:11:09.00,0:11:12.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kaisar sebelumnya\Nmelarang penggundulan hutan sembarangan.{\i0}
Dialogue: 0,0:11:13.08,0:11:17.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Setelah kematiannya,\NKlan Shi mulai menebang pohon seenaknya.{\i0}
Dialogue: 0,0:11:17.96,0:11:20.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Selama pemerintahan Kaisar sebelumnya?{\i0}
Dialogue: 0,0:11:20.17,0:11:23.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kurasa Janda Permaisuri\Nmemutuskan melarangnya.{\i0}
Dialogue: 0,0:11:23.51,0:11:26.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menebang pohon mungkin memicu\Nwabah belalang kembara
Dialogue: 0,0:11:26.43,0:11:27.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan menjauhkan burung.
Dialogue: 0,0:11:28.64,0:11:30.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu kemungkinan besar.
Dialogue: 0,0:11:31.52,0:11:35.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hilanglah harapan tinggiku\Nuntuk sumber daya hutan Shihoku-shu...
Dialogue: 0,0:11:35.73,0:11:37.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Begitu rupanya.{\i0}
Dialogue: 0,0:11:37.02,0:11:39.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Karena kekurangan makanan pokok,{\i0}
Dialogue: 0,0:11:39.11,0:11:42.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}kurasa mereka ingin menjual kayu\Ndan membeli makanan.{\i0}
Dialogue: 0,0:11:42.49,0:11:47.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin tak ada cukup bahan\Nuntuk insektisida di buku ini.
Dialogue: 0,0:11:47.20,0:11:49.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kusiapkan formula lain\Nuntuk berjaga-jaga.
Dialogue: 0,0:11:50.00,0:11:51.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, silakan.
Dialogue: 0,0:11:51.91,0:11:56.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa tak bakar saja\Narea tempat nimfa muncul?
Dialogue: 0,0:11:56.96,0:11:58.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tergantung tempatnya.
Dialogue: 0,0:11:58.96,0:12:03.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa satu-satunya kemungkinan\Nadalah melarang perburuan burung pipit.
Dialogue: 0,0:12:03.01,0:12:05.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Burung pipit biasanya dimakan di sini.
Dialogue: 0,0:12:06.10,0:12:08.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin akan ada protes karena itu.
Dialogue: 0,0:12:08.72,0:12:10.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika ada pengganti...
Dialogue: 0,0:12:11.23,0:12:15.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana jika memasak belalang daun\Ndan menyajikannya di istana?
Dialogue: 0,0:12:18.23,0:12:20.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika itu dijadikan makanan di istana,
Dialogue: 0,0:12:20.40,0:12:22.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}banyak orang akan menangkapnya.
Dialogue: 0,0:12:22.19,0:12:24.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan warga di luar istana kekaisaran...
Dialogue: 0,0:12:26.32,0:12:29.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Astaga, aku harus memberinya\Nsisa belalang bumbu itu...{\i0}
Dialogue: 0,0:12:32.71,0:12:35.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisakah itu jadi pilihan terakhir?
Dialogue: 0,0:12:35.71,0:12:38.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tak masalah\Nselama mereka tak bertambah banyak.
Dialogue: 0,0:12:40.42,0:12:41.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:12:42.26,0:12:44.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu sedikit menenangkannya.{\i0}
Dialogue: 0,0:12:44.68,0:12:47.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun, apa dia sungguh benci memakannya?{\i0}
Dialogue: 0,0:12:50.26,0:12:51.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Jinshi.
Dialogue: 0,0:12:52.64,0:12:53.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:12:54.10,0:12:58.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika tak keberatan,\Nboleh kusajikan makanan sebelum pergi?
Dialogue: 0,0:13:12.62,0:13:14.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat menikmati, Tuan Jinshi.
Dialogue: 0,0:13:29.72,0:13:31.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku harus berhenti.{\i0}
Dialogue: 0,0:13:37.27,0:13:40.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku akan membersihkan piring ini\Nsaat dia terlihat tak senang, tetapi...{\i0}
Dialogue: 0,0:13:41.65,0:13:42.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Orang ini...{\i0}
Dialogue: 0,0:13:45.40,0:13:47.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Bubur.\N- Ya, Tuan.
Dialogue: 0,0:13:51.37,0:13:52.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan.
Dialogue: 0,0:13:54.33,0:13:55.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kenapa dia tak mau ambil?{\i0}
Dialogue: 0,0:13:56.79,0:13:58.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia tak suka isinya?{\i0}
Dialogue: 0,0:14:16.14,0:14:16.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ini.{\i0}
Dialogue: 0,0:14:25.99,0:14:28.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Terlalu mengejutkan\Nuntuk dilihat anak kecil?{\i0}
Dialogue: 0,0:14:30.20,0:14:33.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Bintik, aku akan bawa Zulin\Npergi dari sini.
Dialogue: 0,0:14:33.41,0:14:36.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu kau, Tuan,\Ntanggung jawab atas tindakanmu.
Dialogue: 0,0:14:40.42,0:14:42.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku merasa tak enak sekarang.{\i0}
Dialogue: 0,0:14:52.47,0:14:53.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini.
Dialogue: 0,0:14:55.06,0:14:56.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia bersikap seperti bayi.{\i0}
Dialogue: 0,0:15:04.90,0:15:06.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Bintik.
Dialogue: 0,0:15:07.90,0:15:09.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari mana dapat kertas itu?
Dialogue: 0,0:15:10.24,0:15:12.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nenek memberikannya kepadaku.
Dialogue: 0,0:15:12.07,0:15:14.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nenek pelit itu memberikannya kepadamu?
Dialogue: 0,0:15:14.45,0:15:16.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang dia rencanakan?
Dialogue: 0,0:15:16.91,0:15:19.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak penting. Duduklah di sana.
Dialogue: 0,0:15:19.41,0:15:20.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk apa?
Dialogue: 0,0:15:20.41,0:15:23.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maomao, dengarkan ucapan Chou-u.
Dialogue: 0,0:15:23.25,0:15:25.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidurlah di sini malam ini.
Dialogue: 0,0:15:25.50,0:15:28.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah pasang seprai\Ndi kamar yang kau pakai tadi.
Dialogue: 0,0:15:28.26,0:15:29.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, Nenek?
Dialogue: 0,0:15:29.92,0:15:32.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah gila setelah tontonan aneh itu?
Dialogue: 0,0:15:33.64,0:15:35.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lakukan saja perintahku.
Dialogue: 0,0:15:36.18,0:15:37.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mencurigakan...{\i0}
Dialogue: 0,0:15:48.03,0:15:49.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sangat mencurigakan...{\i0}
Dialogue: 0,0:15:50.78,0:15:53.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bintik, katakan seleramu terhadap pria.
Dialogue: 0,0:15:53.45,0:15:55.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau suka pria tinggi, berotot, atau apa?
Dialogue: 0,0:15:56.62,0:15:57.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sungguh merepotkan.{\i0}
Dialogue: 0,0:16:00.75,0:16:02.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak terlalu besar.
Dialogue: 0,0:16:05.21,0:16:07.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku lebih suka montok daripada kurus.
Dialogue: 0,0:16:07.96,0:16:10.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ada bulu wajah?\N- Aku tak keberatan.
Dialogue: 0,0:16:10.88,0:16:11.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu wajahnya?
Dialogue: 0,0:16:12.34,0:16:14.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku lebih suka wajah bulat\Ndaripada yang runcing.
Dialogue: 0,0:16:15.55,0:16:17.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku benci mata rubah dan sebagainya...{\i0}
Dialogue: 0,0:16:17.68,0:16:19.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maomao...
Dialogue: 0,0:16:19.68,0:16:20.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Matilah saja.{\i0}
Dialogue: 0,0:16:20.60,0:16:23.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau alis yang mengendur juga?
Dialogue: 0,0:16:23.31,0:16:24.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terserah kau.
Dialogue: 0,0:16:26.98,0:16:28.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti ini?
Dialogue: 0,0:16:30.94,0:16:33.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga, biasa sekali wajahnya.
Dialogue: 0,0:16:33.53,0:16:35.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlihat sangat naif.
Dialogue: 0,0:16:35.74,0:16:36.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menolaknya.
Dialogue: 0,0:16:38.58,0:16:40.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa reaksimu begitu?
Dialogue: 0,0:16:40.37,0:16:43.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku melihat kemiripan yang luar biasa...
Dialogue: 0,0:16:43.08,0:16:44.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan siapa?
Dialogue: 0,0:16:44.79,0:16:46.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tabib istana harem.
Dialogue: 0,0:16:48.21,0:16:50.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membosankan sekali.
Dialogue: 0,0:16:50.71,0:16:51.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo pergi.
Dialogue: 0,0:16:51.88,0:16:53.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saatnya mandi.
Dialogue: 0,0:17:10.69,0:17:13.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti perasaanmu.
Dialogue: 0,0:17:14.40,0:17:15.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Joka?
Dialogue: 0,0:17:17.11,0:17:20.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tak pernah tahu\Nkapan pria akan berubah pikiran.
Dialogue: 0,0:17:22.04,0:17:24.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terutama pria dengan kekuasaan.
Dialogue: 0,0:17:30.09,0:17:33.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kepribadianmu seperti Pairin,\Naku tak akan menghentikanmu.
Dialogue: 0,0:17:33.63,0:17:35.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia memang penggoda.
Dialogue: 0,0:17:36.47,0:17:39.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, kau berbeda, Maomao.
Dialogue: 0,0:17:39.64,0:17:42.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau lebih mirip denganku.
Dialogue: 0,0:17:44.77,0:17:47.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak ada pria dengan hati yang tak berubah.
Dialogue: 0,0:17:47.69,0:17:50.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu itu dari bekerja di sini.\NSangat memuakkan.
Dialogue: 0,0:17:50.81,0:17:52.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memercayai mereka\Ntak akan menguntungkanmu.
Dialogue: 0,0:17:58.24,0:18:02.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada akhirnya, aku pelacur,\Ndan kau putri seorang pelacur.
Dialogue: 0,0:18:04.95,0:18:06.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau terlalu banyak merokok.
Dialogue: 0,0:18:06.58,0:18:08.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pantas dapat ini sesekali.
Dialogue: 0,0:18:08.62,0:18:13.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para pegawai negeri itu benci\Nsaat wanita merokok.
Dialogue: 0,0:18:22.85,0:18:25.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dengar sesuatu dari pelanggan kemarin.
Dialogue: 0,0:18:26.14,0:18:29.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada seorang gadis abadi langka\Nyang mirip peri.
Dialogue: 0,0:18:29.14,0:18:31.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih langka\Ndari Tiga Putri Rumah Verdigris.
Dialogue: 0,0:18:31.69,0:18:35.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para menteri berpangkat tinggi itu\Nlebih suka barang langka temuan mereka.
Dialogue: 0,0:18:35.73,0:18:39.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita telah mencapai usia\Nyang bisa membuat orang kesal.
Dialogue: 0,0:18:39.32,0:18:43.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka dahulu menghargai kita\Nseperti permata berharga.
Dialogue: 0,0:18:43.08,0:18:44.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:18:44.87,0:18:47.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salah langkah. Batumu akan mati.
Dialogue: 0,0:18:54.55,0:18:58.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Setahuku, mereka masih punya\Nbanyak daya tarik.{\i0}
Dialogue: 0,0:18:58.84,0:19:02.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar gadis abadi itu\Nberambut putih salju.
Dialogue: 0,0:19:02.97,0:19:04.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mata merah juga.
Dialogue: 0,0:19:04.85,0:19:06.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu tak biasa.{\i0}
Dialogue: 0,0:19:06.47,0:19:08.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa dia albino?
Dialogue: 0,0:19:08.93,0:19:10.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa begitu.
Dialogue: 0,0:19:15.65,0:19:19.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam kasus yang sangat langka,\Nmanusia terlahir tanpa warna.
Dialogue: 0,0:19:19.65,0:19:22.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mata mereka merah karena darah terlihat.
Dialogue: 0,0:19:22.20,0:19:24.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu disebut albinisme.
Dialogue: 0,0:19:24.74,0:19:26.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rambut dan kulit mereka putih.
Dialogue: 0,0:19:26.58,0:19:29.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka terlahir seperti itu.\NTak mengubah jati diri mereka.
Dialogue: 0,0:19:30.16,0:19:32.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu yang dikatakan ayahku.{\i0}
Dialogue: 0,0:19:32.96,0:19:34.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis abadi seputih salju, ya?
Dialogue: 0,0:19:34.88,0:19:35.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, sebenarnya,
Dialogue: 0,0:19:35.92,0:19:38.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kudengar dia memakai sihir sungguhan.
Dialogue: 0,0:19:40.51,0:19:43.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mulai dengan tampil\Ndi acara sampingan,
Dialogue: 0,0:19:43.09,0:19:45.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tetapi kini dia muncul\Ndi teater di ibu kota.
Dialogue: 0,0:19:46.76,0:19:47.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku jadi ingat.{\i0}
Dialogue: 0,0:19:48.22,0:19:52.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku dengar Nenek mengeluh\Npenjualan turun 20 persen.{\i0}
Dialogue: 0,0:19:52.06,0:19:54.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa pelanggan Distrik Kesenangan\Npindah ke sana?{\i0}
Dialogue: 0,0:19:55.69,0:19:58.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika hanya acara sampingan,\Nmelihatnya sekali sudah cukup.
Dialogue: 0,0:19:59.03,0:20:00.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum tentu.
Dialogue: 0,0:20:03.36,0:20:04.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:20:08.37,0:20:10.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tahu liandan-shu, bukan?
Dialogue: 0,0:20:10.16,0:20:11.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:20:12.75,0:20:16.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Seni membuat eliksir\Nuntuk meraih kehidupan abadi.{\i0}
Dialogue: 0,0:20:16.13,0:20:20.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu mencurigakan,\Njadi, ayahku menyuruhku menjauhinya.{\i0}
Dialogue: 0,0:20:20.55,0:20:24.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis abadi itu menunjukkan\Nlebih dari sekadar penampilan unik.
Dialogue: 0,0:20:24.55,0:20:27.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia juga bisa membaca pikiran\Ndan memunculkan uang.
Dialogue: 0,0:20:27.47,0:20:28.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitukah?
Dialogue: 0,0:20:29.31,0:20:34.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bayangkan perasaan para pejabat skeptis\Nsetelah pikiran mereka dibaca.
Dialogue: 0,0:20:34.31,0:20:35.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya?
Dialogue: 0,0:20:36.27,0:20:38.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Setelah semua keraguan dan cemoohan itu,{\i0}
Dialogue: 0,0:20:38.27,0:20:41.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}mereka benar-benar berubah\Ndan mulai memercayai gadis abadi.{\i0}
Dialogue: 0,0:20:42.40,0:20:47.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Keyakinan mereka dengan mudah meyakinkan\Nbahwa eliksir kehidupan abadi sungguh ada.{\i0}
Dialogue: 0,0:20:47.62,0:20:50.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Betapa bodohnya mereka.{\i0}
Dialogue: 0,0:20:50.62,0:20:52.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada dasarnya, gadis abadi ini
Dialogue: 0,0:20:52.62,0:20:56.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}memamerkan eliksir kehidupan abadi\Nuntuk menarik pelanggan?
Dialogue: 0,0:20:56.21,0:20:58.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak tahu sampai sejauh itu.
Dialogue: 0,0:20:58.50,0:21:02.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya dengar obrolan\Npara pelayan pejabat.
Dialogue: 0,0:21:02.67,0:21:07.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sementara Tuan Jinshi dan yang lain\Nsibuk melawan wabah belalang kembara,{\i0}
Dialogue: 0,0:21:07.39,0:21:10.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}sepertinya orang penting lainnya\Nterlalu bersenang-senang.{\i0}
Dialogue: 0,0:21:11.64,0:21:14.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau penasaran,\Nkenapa tak melihatnya langsung?
Dialogue: 0,0:21:14.94,0:21:17.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak mampu bayar pertunjukan mahal itu.
Dialogue: 0,0:21:17.56,0:21:20.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa tak minta bantuan orang?
Dialogue: 0,0:21:20.86,0:21:22.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Minta kepada siapa?{\i0}
Dialogue: 0,0:21:22.61,0:21:24.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tak ada waktu untuk itu.{\i0}
Dialogue: 0,0:23:54.55,0:23:57.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Episode selanjutnya, "Ular Putih Abadi".{\i0}
Dialogue: 0,0:23:58.93,0:24:00.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Terjemahan subtitle oleh Amalia Puspita
