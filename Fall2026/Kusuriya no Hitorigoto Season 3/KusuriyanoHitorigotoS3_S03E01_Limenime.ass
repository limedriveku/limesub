Dialogue: 0,0:03:15.52,0:03:17.19,sign,,0000,0000,0000,,KLAN SHI (X)\NKLAN YI (X)
Dialogue: 0,0:03:34.92,0:03:35.83,sign,,0000,0000,0000,,LA
Dialogue: 0,0:03:51.02,0:03:52.02,sign,,0000,0000,0000,,GYOKU
Dialogue: 0,0:04:13.58,0:04:14.50,sign,,0000,0000,0000,,GYOKUEN
Dialogue: 0,0:15:39.06,0:15:39.97,sign,,0000,0000,0000,,TANAMAN BAGIAN II
Dialogue: 0,0:15:39.98,0:15:41.73,sign,,0000,0000,0000,,BURUNG BAGIAN I
Dialogue: 0,0:16:11.01,0:16:12.42,sign,,0000,0000,0000,,RUMAH VERDIGRIS
Dialogue: 0,0:23:46.09,0:23:52.38,sign,,0000,0000,0000,,CUPLIKAN EPISODE SELANJUTNYA
Dialogue: 0,0:00:48.54,0:00:49.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Obat ini
Dialogue: 0,0:00:49.79,0:00:53.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dapat menenangkan hati\Ndan menghapus penderitaan duniawi.
Dialogue: 0,0:02:39.82,0:02:41.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wabah belalang kembara?
Dialogue: 0,0:02:41.70,0:02:42.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:02:43.32,0:02:46.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah pesan di surat\Nyang diberikan Loulan.
Dialogue: 0,0:02:46.70,0:02:48.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika terjadi wabah belalang kembara…
Dialogue: 0,0:02:48.83,0:02:50.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu hal yang pasti.
Dialogue: 0,0:02:50.71,0:02:54.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rakyat akan membenci Kaisar\Nyang memerintah Negara Li.
Dialogue: 0,0:02:57.67,0:02:59.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Klan Shi telah jatuh.{\i0}
Dialogue: 0,0:03:00.68,0:03:01.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Akibatnya,{\i0}
Dialogue: 0,0:03:01.93,0:03:06.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}perebutan kekuasaan di dalam istana\Nkemungkinan akan meningkat.{\i0}
Dialogue: 0,0:03:07.64,0:03:09.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Klan yang diberi nama.{\i0}
Dialogue: 0,0:03:09.60,0:03:14.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mereka diberi karakter khusus oleh Kaisar\Nuntuk nama klan mereka.{\i0}
Dialogue: 0,0:03:17.19,0:03:20.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Saat negara ini didirikan,\Nnama ketiga wilayah taklukan{\i0}
Dialogue: 0,0:03:20.03,0:03:22.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}berisi karakter dari 12 zodiak.{\i0}
Dialogue: 0,0:03:22.41,0:03:25.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Maka, klan yang diakui oleh Kaisar{\i0}
Dialogue: 0,0:03:25.28,0:03:28.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}kemudian diberi karakter-karakter ini.{\i0}
Dialogue: 0,0:03:28.20,0:03:31.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Karena karakter lain\Njuga digunakan kemudian,{\i0}
Dialogue: 0,0:03:31.62,0:03:34.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}mereka sering dibagi\Nmenjadi klan "lama" dan klan "baru".{\i0}
Dialogue: 0,0:03:35.84,0:03:39.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}"La" adalah perwakilan\Ndi antara klan baru.{\i0}
Dialogue: 0,0:03:40.55,0:03:44.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Selir Gyokuyou yang berpangkat tinggi\Nakan menjadi Permaisuri.{\i0}
Dialogue: 0,0:03:45.22,0:03:47.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Keluarga asalnya akan naik pangkat{\i0}
Dialogue: 0,0:03:48.51,0:03:51.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dan menjadi klan bernama, seperti La.{\i0}
Dialogue: 0,0:03:52.02,0:03:55.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika perang meletus,\NBarat akan sangat penting.
Dialogue: 0,0:03:57.02,0:04:01.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itukah sebabnya putri Gyokuen,\NSelir Gyokuyou, harus menjadi Permaisuri?
Dialogue: 0,0:04:01.11,0:04:04.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pernikahan adalah alat politik.
Dialogue: 0,0:04:04.91,0:04:09.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Klan Yi, yang memerintah di Barat,\Nsudah mati puluhan tahun lalu.{\i0}
Dialogue: 0,0:04:09.66,0:04:11.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kini, yang mengambil kendali{\i0}
Dialogue: 0,0:04:11.33,0:04:13.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}adalah ayah Selir Gyokuyou, You Gyokuen.{\i0}
Dialogue: 0,0:04:15.08,0:04:18.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sementara itu,\Nkeluarga asal Ibu Suri Anshi,{\i0}
Dialogue: 0,0:04:18.13,0:04:21.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}atas perintah Permaisuri,\Nbelum diberi nama klan.{\i0}
Dialogue: 0,0:04:24.84,0:04:29.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita hanya bisa berharap\Nini tak memicu konflik.
Dialogue: 0,0:04:49.45,0:04:51.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak kusangka Tuan Jinshi…
Dialogue: 0,0:04:51.45,0:04:53.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}…adalah adik Kaisar.
Dialogue: 0,0:04:53.45,0:04:56.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Gyokuen! Selamat!
Dialogue: 0,0:04:57.42,0:04:58.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:04:58.79,0:05:00.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan, Tuan.
Dialogue: 0,0:05:00.71,0:05:01.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:05:01.96,0:05:03.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Acara yang menggembirakan.
Dialogue: 0,0:05:04.01,0:05:05.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Debut yang luar biasa.
Dialogue: 0,0:05:12.14,0:05:14.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah belum tiba.
Dialogue: 0,0:05:14.23,0:05:16.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, ini cukup buruk.
Dialogue: 0,0:05:16.89,0:05:19.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Onsou pergi menjemputnya, tetapi…
Dialogue: 0,0:05:19.48,0:05:22.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah mulai… Lupakan saja!
Dialogue: 0,0:05:22.69,0:05:26.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Rikuson,\Nmaukah kau duduk di kursi Ayah?
Dialogue: 0,0:05:26.15,0:05:27.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu tidak mau.
Dialogue: 0,0:05:29.74,0:05:31.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar Tuan Onsou yang tangani.
Dialogue: 0,0:05:31.78,0:05:33.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, baiklah.
Dialogue: 0,0:05:33.29,0:05:35.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Lakan!
Dialogue: 0,0:05:36.83,0:05:38.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan La…
Dialogue: 0,0:05:38.71,0:05:40.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong diam, Tuan Onsou.
Dialogue: 0,0:05:40.75,0:05:42.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diam?
Dialogue: 0,0:05:42.30,0:05:45.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pesta taman hari ini\Njuga merupakan debut Permaisuri…
Dialogue: 0,0:05:53.72,0:05:56.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, itu langkahmu! Mari kita lihat…
Dialogue: 0,0:05:56.60,0:05:58.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah berminggu-minggu,
Dialogue: 0,0:05:58.39,0:06:00.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya Fengxian\Nkini merasa jauh lebih baik.
Dialogue: 0,0:06:00.86,0:06:03.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, mari kita lihat bagaimana reaksimu…
Dialogue: 0,0:06:13.33,0:06:15.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan dimarahi.
Dialogue: 0,0:06:28.38,0:06:29.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah!
Dialogue: 0,0:06:30.97,0:06:32.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini dia, Tuan Uryuu.
Dialogue: 0,0:06:37.35,0:06:38.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Nyonya Lishu…{\i0}
Dialogue: 0,0:06:40.27,0:06:44.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Andai anak Selir Lihua\Nlahir sedikit lebih awal…
Dialogue: 0,0:06:44.19,0:06:46.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Andai pangeran pertama masih hidup…
Dialogue: 0,0:06:46.86,0:06:49.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat wajah sombong Gyokuen itu.
Dialogue: 0,0:06:49.99,0:06:53.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permaisuri berdarah asing, tak kusangka.
Dialogue: 0,0:07:16.76,0:07:17.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dingin sekali.
Dialogue: 0,0:07:17.93,0:07:20.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ya, Nenek mencariku.{\i0}
Dialogue: 0,0:07:22.90,0:07:25.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Akan kubiarkan Chou-u tidur lebih lama.{\i0}
Dialogue: 0,0:07:25.65,0:07:28.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Selagi keluar, aku akan mandi air panas\Ndi Rumah Verdigris.{\i0}
Dialogue: 0,0:07:33.78,0:07:35.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sudah sebulan kutinggalkan istana harem.{\i0}
Dialogue: 0,0:07:35.78,0:07:38.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}- Keramaian Tahun Baru telah mereda.{\i0}\N- Selamat pagi.
Dialogue: 0,0:07:38.37,0:07:39.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat pagi.
Dialogue: 0,0:07:42.04,0:07:44.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat pagi, Kak Meimei.
Dialogue: 0,0:07:44.13,0:07:45.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau datang lebih awal hari ini.
Dialogue: 0,0:07:45.75,0:07:47.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di mana Nenek?
Dialogue: 0,0:07:47.00,0:07:49.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bicara dengan penjaga bordil di sana.
Dialogue: 0,0:07:49.30,0:07:52.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bodoh! Apa yang kau lakukan?
Dialogue: 0,0:07:54.18,0:07:57.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Nenek mengurus Rumah Verdigris,{\i0}
Dialogue: 0,0:07:57.35,0:08:00.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}tetapi Tuan Pemilik, penjaga bordil,\Nmenangani manajemennya.{\i0}
Dialogue: 0,0:08:00.81,0:08:03.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia juga punya bisnis lain.{\i0}
Dialogue: 0,0:08:03.14,0:08:05.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dengan sifat baiknya,{\i0}
Dialogue: 0,0:08:05.19,0:08:08.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}aku khawatir\Ntempat ini akan bangkrut tanpa Nenek.{\i0}
Dialogue: 0,0:08:09.53,0:08:11.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sepertinya Nenek memukulnya dengan keras.{\i0}
Dialogue: 0,0:08:12.36,0:08:14.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maomao. Kenapa kau kemari?
Dialogue: 0,0:08:14.78,0:08:16.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah kau yang memanggilku?
Dialogue: 0,0:08:16.66,0:08:18.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:08:18.03,0:08:19.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah pikun?
Dialogue: 0,0:08:19.45,0:08:20.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dengar itu!
Dialogue: 0,0:08:22.58,0:08:24.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mengingatkanku pada tabib gadungan.{\i0}
Dialogue: 0,0:08:24.33,0:08:27.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa kau ke sini untuk mandi.
Dialogue: 0,0:08:27.25,0:08:29.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau sarapan selagi kau di sini?
Dialogue: 0,0:08:29.71,0:08:31.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bawa anak itu juga.
Dialogue: 0,0:08:31.67,0:08:32.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh?
Dialogue: 0,0:08:32.59,0:08:34.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terkadang aku juga baik.
Dialogue: 0,0:08:34.97,0:08:36.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku akan pergi.
Dialogue: 0,0:08:38.68,0:08:42.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa? Dia tak biasa pergi sebelum sarapan.{\i0}
Dialogue: 0,0:08:43.14,0:08:45.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo! Makanlah!
Dialogue: 0,0:08:47.61,0:08:50.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengerikan. Bukankah ini belalang kembara?
Dialogue: 0,0:08:50.78,0:08:53.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini hadiah dari Tuan Pemilik.
Dialogue: 0,0:08:53.32,0:08:56.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua orang tersiksa\Nkarena panen buruk tahun ini.
Dialogue: 0,0:08:56.70,0:09:00.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tuan Pemilik\Njuga punya bisnis makanan pokok.{\i0}
Dialogue: 0,0:09:00.66,0:09:01.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Di negara ini,{\i0}
Dialogue: 0,0:09:01.83,0:09:05.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}pemerintah mengambil pajak dari petani\Ndengan mengumpulkan hasil panen.{\i0}
Dialogue: 0,0:09:05.62,0:09:08.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mereka juga membeli dengan jumlah tetap.{\i0}
Dialogue: 0,0:09:09.00,0:09:12.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tuan Pemilik menjalankan bisnis\Nyang mendistribusikan kelebihannya.{\i0}
Dialogue: 0,0:09:12.88,0:09:15.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bahkan tak menawar ini.
Dialogue: 0,0:09:15.09,0:09:18.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia merebusnya dengan gula mahal\Nuntuk diawetkan.
Dialogue: 0,0:09:18.76,0:09:21.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa berbuat sejauh itu?\NDia seharusnya membuangnya.
Dialogue: 0,0:09:22.68,0:09:24.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak masalah bagimu, Chou-u?
Dialogue: 0,0:09:24.27,0:09:26.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini tak terlalu enak.
Dialogue: 0,0:09:26.23,0:09:28.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak kusangka ini bisa dimakan.
Dialogue: 0,0:09:28.35,0:09:31.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak berdaging, tetapi masih bisa dimakan.
Dialogue: 0,0:09:31.40,0:09:32.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak berdaging?
Dialogue: 0,0:09:32.69,0:09:34.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diam dan makanlah!
Dialogue: 0,0:09:34.03,0:09:37.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, mau kumakan semuanya?
Dialogue: 0,0:09:37.11,0:09:38.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beri aku kue bulan, maka aku setuju.
Dialogue: 0,0:09:39.49,0:09:41.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh. Sakit, Bintik!
Dialogue: 0,0:09:41.41,0:09:42.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga.
Dialogue: 0,0:09:45.20,0:09:48.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sebelum memasak belalang kembara,\Nisi perut harus dibuang.{\i0}
Dialogue: 0,0:09:48.12,0:09:50.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jadi, ya, tentu tak berdaging. Namun…{\i0}
Dialogue: 0,0:09:51.04,0:09:52.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maomao.
Dialogue: 0,0:09:52.34,0:09:53.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:09:53.42,0:09:54.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingat sekarang.
Dialogue: 0,0:09:54.51,0:09:56.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belilah dupa di pasar.
Dialogue: 0,0:09:56.92,0:09:58.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik. Mana upahku?
Dialogue: 0,0:09:59.30,0:10:02.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mandi pagi dan sarapan untuk dua orang.
Dialogue: 0,0:10:02.31,0:10:03.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah itu cukup?
Dialogue: 0,0:10:03.31,0:10:04.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelit.
Dialogue: 0,0:10:04.93,0:10:06.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau bilang?
Dialogue: 0,0:10:06.98,0:10:09.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, Bintik!
Dialogue: 0,0:10:09.15,0:10:11.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Belikan aku itu!\N- Tidak.
Dialogue: 0,0:10:13.19,0:10:14.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Lihat aku sekarang.{\i0}
Dialogue: 0,0:10:14.94,0:10:18.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku pernah bekerja di sana\Nterasa seperti mimpi.{\i0}
Dialogue: 0,0:10:20.57,0:10:21.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jijik!
Dialogue: 0,0:10:21.82,0:10:22.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sialan!
Dialogue: 0,0:10:22.99,0:10:24.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa katamu, Nak?
Dialogue: 0,0:10:24.74,0:10:26.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini tak enak dan tak berdaging.
Dialogue: 0,0:10:26.41,0:10:27.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar kau…
Dialogue: 0,0:10:27.50,0:10:30.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chou-u! Hei, kau sedang apa?
Dialogue: 0,0:10:30.33,0:10:31.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Pak.
Dialogue: 0,0:10:31.33,0:10:33.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa? Aku berkata jujur!
Dialogue: 0,0:10:33.50,0:10:35.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diamlah.
Dialogue: 0,0:10:37.05,0:10:38.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sangat tak enak.
Dialogue: 0,0:10:39.80,0:10:42.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kurasa itu berarti\Nhasil panen sungguh payah tahun ini.
Dialogue: 0,0:10:43.64,0:10:44.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Apa katamu?
Dialogue: 0,0:10:44.85,0:10:46.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kubilang tak enak.
Dialogue: 0,0:10:46.56,0:10:47.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, setelah itu.
Dialogue: 0,0:10:49.44,0:10:51.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal hasil panen payah?
Dialogue: 0,0:10:51.65,0:10:53.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, itu. Bagaimana kau tahu?
Dialogue: 0,0:10:53.44,0:10:55.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entahlah, aku pernah dengar.
Dialogue: 0,0:10:55.36,0:10:58.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika serangga tak berdaging,\Nartinya hasil panennya buruk.
Dialogue: 0,0:10:59.53,0:11:02.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Chou-u pernah mati, lalu hidup kembali,{\i0}
Dialogue: 0,0:11:02.87,0:11:05.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}yang membuat sebagian tubuhnya mati rasa.{\i0}
Dialogue: 0,0:11:05.45,0:11:07.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia juga kehilangan banyak ingatan.{\i0}
Dialogue: 0,0:11:09.25,0:11:12.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ayo, ingatlah.\N- Hentikan!
Dialogue: 0,0:11:13.83,0:11:16.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mungkin bisa ingat.
Dialogue: 0,0:11:16.13,0:11:17.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh?
Dialogue: 0,0:11:17.05,0:11:18.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, jika kau belikan sesuatu.
Dialogue: 0,0:11:19.84,0:11:21.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh! Sakit!
Dialogue: 0,0:11:22.76,0:11:25.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Mungkin bisa ingat"? Usaha yang bagus.
Dialogue: 0,0:11:28.56,0:11:32.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tetap saja, aku tak mengira\Ndia meminta kertas dan kuas.{\i0}
Dialogue: 0,0:11:32.56,0:11:37.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chou-u, jangan buat masalah\Nselagi kuantar dupa ini ke Nenek.
Dialogue: 0,0:11:37.40,0:11:38.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu!
Dialogue: 0,0:11:43.70,0:11:45.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luar biasa!
Dialogue: 0,0:11:47.33,0:11:48.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ada apa?{\i0}
Dialogue: 0,0:11:49.41,0:11:51.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, tunggu giliranmu.
Dialogue: 0,0:11:51.91,0:11:54.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, selesai.
Dialogue: 0,0:11:55.13,0:11:56.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini.
Dialogue: 0,0:11:56.04,0:11:59.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya ampun. Nak, kau sangat berbakat.
Dialogue: 0,0:11:59.42,0:12:00.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini upahmu.
Dialogue: 0,0:12:00.63,0:12:02.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senang berbisnis!
Dialogue: 0,0:12:02.05,0:12:03.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei.
Dialogue: 0,0:12:04.18,0:12:06.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}- Ayolah, Bintik!\N- Kau sedang apa?
Dialogue: 0,0:12:06.22,0:12:08.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Menggambar. Apa masalahnya?
Dialogue: 0,0:12:08.47,0:12:10.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bahkan mengenakan biaya…
Dialogue: 0,0:12:10.39,0:12:12.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei! Apa yang kalian lakukan\Ndi depan tokoku?
Dialogue: 0,0:12:12.81,0:12:14.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian merusak bisnisku!
Dialogue: 0,0:12:18.94,0:12:20.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhenti.
Dialogue: 0,0:12:20.23,0:12:23.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beri tahu anak itu\Nbahwa dia boleh gunakan tempatku
Dialogue: 0,0:12:23.28,0:12:25.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jika aku dapat bagian 10 persen.
Dialogue: 0,0:12:25.16,0:12:26.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wanita tua serakah.
Dialogue: 0,0:12:34.37,0:12:37.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika mau terus menggambar di sana,\Nsebaiknya bayar sewa tempat ke Nenek.
Dialogue: 0,0:12:37.92,0:12:40.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelit sekali.
Dialogue: 0,0:12:40.21,0:12:42.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lupakan. Aku akan menggambar\Ndi tempat lain.
Dialogue: 0,0:12:46.09,0:12:49.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bayar jika perlu.\NTetaplah di dekat Rumah Verdigris.
Dialogue: 0,0:12:49.68,0:12:52.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetap di tempat pelayan bisa melihatmu.
Dialogue: 0,0:12:52.48,0:12:54.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan beli kertas sendirian juga.
Dialogue: 0,0:12:54.77,0:12:56.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bukan bosku!
Dialogue: 0,0:12:59.94,0:13:01.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:13:01.65,0:13:03.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika mau mati, silakan.
Dialogue: 0,0:13:03.94,0:13:05.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mati?
Dialogue: 0,0:13:06.61,0:13:08.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau akan diganggu di luar sana.
Dialogue: 0,0:13:15.83,0:13:18.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu gundik yang sakit.
Dialogue: 0,0:13:18.21,0:13:19.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tak akan bertahan lama,
Dialogue: 0,0:13:19.84,0:13:22.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tetapi masih butuh pelanggan\Nuntuk bertahan hidup.
Dialogue: 0,0:13:22.92,0:13:25.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Distrik kesenangan ini tidak hanya indah.
Dialogue: 0,0:13:25.30,0:13:28.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, ada hal yang sangat buruk juga.
Dialogue: 0,0:13:29.51,0:13:31.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rumah Verdigris\Nmelindungimu dari semua itu.
Dialogue: 0,0:13:31.93,0:13:33.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak orang di luar sana
Dialogue: 0,0:13:33.43,0:13:36.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tak akan ragu membunuh\Nanak kaya demi uang.
Dialogue: 0,0:13:36.89,0:13:38.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:13:46.40,0:13:49.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku tak menyangka\Ndia punya bakat seperti ini.{\i0}
Dialogue: 0,0:13:50.12,0:13:51.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sama seperti…{\i0}
Dialogue: 0,0:13:54.16,0:13:55.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, lihat.
Dialogue: 0,0:13:55.66,0:13:57.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baru ingat sesuatu.
Dialogue: 0,0:13:57.62,0:13:59.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini belalang kembara?
Dialogue: 0,0:13:59.88,0:14:02.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang atas adalah\Nbelalang kembara normal, bukan?
Dialogue: 0,0:14:02.75,0:14:06.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin yang bawah\Nadalah belalang kembara dari panen buruk.
Dialogue: 0,0:14:07.42,0:14:08.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wabah belalang…
Dialogue: 0,0:14:10.14,0:14:13.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bencana alam\Nyang mampu menghancurkan negara.{\i0}
Dialogue: 0,0:14:20.52,0:14:24.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kawanan besar belalang kembara\Nakan melahap semua yang terlihat.{\i0}
Dialogue: 0,0:14:24.40,0:14:26.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mereka makan tanaman panen.{\i0}
Dialogue: 0,0:14:26.03,0:14:28.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bahkan tali jerami dan sandal jerami.{\i0}
Dialogue: 0,0:14:28.86,0:14:31.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Untungnya, di bawah\Npemerintahan Kaisar saat ini,{\i0}
Dialogue: 0,0:14:32.24,0:14:34.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}belum terlihat wabah belalang kembara.{\i0}
Dialogue: 0,0:14:34.20,0:14:37.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Setelah pemberontakan Klan Shi,\Nbanyak orang dieksekusi.{\i0}
Dialogue: 0,0:14:41.83,0:14:43.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jika sekarang terjadi wabah,{\i0}
Dialogue: 0,0:14:43.67,0:14:47.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}akan dianggap sebagai hukuman ilahi\Nkarena menghancurkan Klan Shi.{\i0}
Dialogue: 0,0:14:47.67,0:14:51.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Lalu, semua orang akan menyalahkan\NKaisar yang memerintah negara ini…{\i0}
Dialogue: 0,0:14:54.22,0:14:56.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bukan urusanku.{\i0}
Dialogue: 0,0:14:57.85,0:14:59.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu bukan urusanku, tetapi…{\i0}
Dialogue: 0,0:15:02.52,0:15:04.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Gambar Chou-u mengingatkanku{\i0}
Dialogue: 0,0:15:05.90,0:15:08.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}akan gambar serupa yang pernah kulihat.{\i0}
Dialogue: 0,0:15:09.11,0:15:11.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tak akan ada di sini, bukan?{\i0}
Dialogue: 0,0:15:16.16,0:15:17.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi, Pak.
Dialogue: 0,0:15:19.25,0:15:20.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari mana kau dapat buku ini?
Dialogue: 0,0:15:22.17,0:15:24.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang menjualnya beberapa hari lalu.
Dialogue: 0,0:15:24.38,0:15:26.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa dia menjual barang lain?
Dialogue: 0,0:15:26.71,0:15:28.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, hanya satu buku.
Dialogue: 0,0:15:28.46,0:15:30.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, dia bilang akan kembali nanti.
Dialogue: 0,0:15:33.68,0:15:37.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Salah satu referensi bergambar\Nditinggalkan untuk membuat{\i0}
Dialogue: 0,0:15:37.06,0:15:39.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}eliksir kehidupan abadi.{\i0}
Dialogue: 0,0:15:44.69,0:15:47.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Buku ini salah satunya, aku yakin.{\i0}
Dialogue: 0,0:15:47.57,0:15:49.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senang berbisnis.
Dialogue: 0,0:15:49.07,0:15:50.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kenapa ada di sini?{\i0}
Dialogue: 0,0:15:52.70,0:15:56.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tentara Terlarang\Nseharusnya menutup benteng.{\i0}
Dialogue: 0,0:15:56.16,0:15:59.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kenapa buku dari benteng beredar di kota?{\i0}
Dialogue: 0,0:16:00.58,0:16:03.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apakah ada yang menjual barang rampasan\Nsecara ilegal?{\i0}
Dialogue: 0,0:16:04.25,0:16:05.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jika begitu…{\i0}
Dialogue: 0,0:16:05.75,0:16:07.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pasukan Terlarang…{\i0}
Dialogue: 0,0:16:07.96,0:16:10.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mungkin aku akan minta tolong orang itu.{\i0}
Dialogue: 0,0:16:13.01,0:16:14.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengar, Nona.
Dialogue: 0,0:16:14.26,0:16:16.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat sibuk.
Dialogue: 0,0:16:16.35,0:16:18.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, aku memburu pencuri kecil…
Dialogue: 0,0:16:18.47,0:16:21.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Tuan Lihaku.
Dialogue: 0,0:16:21.06,0:16:25.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengawasi sejak matahari terbit\Ndan menangkap orang yang coba menjual ini.
Dialogue: 0,0:16:25.10,0:16:26.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersyukurlah.
Dialogue: 0,0:16:26.31,0:16:28.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tak menyuruh bawahan, bukan?
Dialogue: 0,0:16:28.73,0:16:31.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, karena itu permintaan darimu.
Dialogue: 0,0:16:32.95,0:16:35.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Puji aku di depan Pairin, ya?
Dialogue: 0,0:16:35.11,0:16:36.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Ya, tentu.
Dialogue: 0,0:16:37.32,0:16:39.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Namun, di mana penjahatnya?
Dialogue: 0,0:16:39.16,0:16:41.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelayan Verdigris mengawasinya di depan.
Dialogue: 0,0:16:42.20,0:16:43.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:16:48.04,0:16:49.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona!
Dialogue: 0,0:16:50.80,0:16:52.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peringatan bahaya.
Dialogue: 0,0:16:52.05,0:16:53.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan terlalu dekat.
Dialogue: 0,0:16:57.47,0:16:58.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis ular!
Dialogue: 0,0:17:00.22,0:17:03.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia penjaga saat itu.{\i0}
Dialogue: 0,0:17:03.10,0:17:04.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, Nona?
Dialogue: 0,0:17:04.56,0:17:06.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Lihaku, aku harus minta maaf.
Dialogue: 0,0:17:07.52,0:17:09.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kenal orang ini.
Dialogue: 0,0:17:09.82,0:17:12.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudmu?
Dialogue: 0,0:17:12.15,0:17:16.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, Kak Pairin akan segera pulang…
Dialogue: 0,0:17:16.74,0:17:19.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah? Baik, kurasa tugasku selesai!\NSampai jumpa!
Dialogue: 0,0:17:20.66,0:17:23.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau juga tak perlu mengawasi, Ukyou.
Dialogue: 0,0:17:23.29,0:17:25.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak bisa meninggalkanmu.
Dialogue: 0,0:17:25.08,0:17:27.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika terjadi sesuatu padamu,
Dialogue: 0,0:17:27.08,0:17:29.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Rubah dan Tuan Topeng\Nakan marah kepadaku.
Dialogue: 0,0:17:29.84,0:17:32.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak masalah, bukan? Aku akan diam di sini.
Dialogue: 0,0:17:32.96,0:17:34.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak akan menguping.
Dialogue: 0,0:17:36.18,0:17:39.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ukyou sudah di sini sebelum aku lahir.{\i0}
Dialogue: 0,0:17:39.55,0:17:44.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia bekerja apa pun dengan sempurna,\Nbahkan Nenek sangat memercayainya.{\i0}
Dialogue: 0,0:17:44.27,0:17:46.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun, dia mungkin akan mengadukanku.{\i0}
Dialogue: 0,0:17:47.39,0:17:49.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kurasa bukan masalah jika Nenek tahu.{\i0}
Dialogue: 0,0:17:50.73,0:17:52.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tahu ini apa, bukan?
Dialogue: 0,0:17:52.86,0:17:54.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di mana buku lainnya?
Dialogue: 0,0:17:56.61,0:18:00.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pejabat militer itu\Nmembantu menyergap benteng.{\i0}
Dialogue: 0,0:18:00.87,0:18:03.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Perlu kubilang kau juga di sana?
Dialogue: 0,0:18:05.00,0:18:07.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti maksudmu.
Dialogue: 0,0:18:07.00,0:18:09.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kujual dua lagi di kota lain,
Dialogue: 0,0:18:09.00,0:18:11.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tetapi masih ada tiga.
Dialogue: 0,0:18:11.04,0:18:12.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kutinggalkan sisanya.
Dialogue: 0,0:18:13.09,0:18:16.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Yang tersisa di benteng\Nmungkin masih bisa didapatkan.{\i0}
Dialogue: 0,0:18:17.09,0:18:19.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Soal dua yang dia jual, itu masalah.{\i0}
Dialogue: 0,0:18:19.18,0:18:23.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Buku yang aku punya sejauh ini\Nadalah tentang burung dan ikan.{\i0}
Dialogue: 0,0:18:23.72,0:18:25.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau jual buku tentang serangganya?
Dialogue: 0,0:18:25.64,0:18:27.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku punya salah satunya.
Dialogue: 0,0:18:27.94,0:18:29.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Salah satunya"?
Dialogue: 0,0:18:29.85,0:18:32.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}"Bagian I" berarti pasti ada "Bagian II".{\i0}
Dialogue: 0,0:18:32.56,0:18:35.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa bawakan buku itu sekarang?
Dialogue: 0,0:18:35.78,0:18:38.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa janji tak melaporkanku?
Dialogue: 0,0:18:38.90,0:18:40.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Itu tergantung sikapmu.
Dialogue: 0,0:18:41.45,0:18:42.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Maomao.
Dialogue: 0,0:18:42.95,0:18:44.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan ancam dia.
Dialogue: 0,0:18:45.24,0:18:47.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei. Kau lapar?
Dialogue: 0,0:18:47.66,0:18:49.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin kau punya alasan.
Dialogue: 0,0:18:49.46,0:18:50.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu sebentar, ya?
Dialogue: 0,0:18:56.84,0:18:58.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku boleh makan ini?
Dialogue: 0,0:18:58.84,0:19:00.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, tetapi ini sisa dari kami.
Dialogue: 0,0:19:04.60,0:19:05.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak sekali!
Dialogue: 0,0:19:06.35,0:19:10.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya kau melalui banyak hal\Nsebelum mencapai ibu kota.
Dialogue: 0,0:19:10.23,0:19:12.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, bukunya dalam kondisi baik.
Dialogue: 0,0:19:12.44,0:19:14.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak ada pilihan selain menjualnya, ya?
Dialogue: 0,0:19:15.15,0:19:17.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa dia bukan orang jahat.
Dialogue: 0,0:19:17.28,0:19:18.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, tetap saja.
Dialogue: 0,0:19:19.11,0:19:21.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beri hadiah dan hukuman\Ndengan bijak, Maomao.
Dialogue: 0,0:19:26.03,0:19:27.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:19:27.12,0:19:28.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak enak.
Dialogue: 0,0:19:28.33,0:19:29.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak suka belalang kembara?
Dialogue: 0,0:19:30.79,0:19:33.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bukan belalang kembara,\Nmelainkan belalang daun.
Dialogue: 0,0:19:37.00,0:19:40.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini belalang kembara,\Nlalu ini belalang daun.
Dialogue: 0,0:19:40.34,0:19:42.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Petani tahu perbedaannya.
Dialogue: 0,0:19:42.47,0:19:43.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kembara bisa dimakan,
Dialogue: 0,0:19:43.72,0:19:45.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}belalang daun tak berdaging dan tak enak.
Dialogue: 0,0:19:46.72,0:19:50.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyebalkan.\NAda belalang daun yang tercampur.
Dialogue: 0,0:19:50.14,0:19:52.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Shisui mengatakan hal yang sama.{\i0}
Dialogue: 0,0:19:52.56,0:19:54.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, ini berarti…
Dialogue: 0,0:19:55.27,0:19:56.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:19:56.19,0:19:58.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin ada kelaparan tahun ini.
Dialogue: 0,0:19:58.82,0:20:00.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau juga berpikir begitu?
Dialogue: 0,0:20:00.28,0:20:02.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada bukti.
Dialogue: 0,0:20:02.45,0:20:06.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, lebih banyak belalang daun\Ndaripada belalang kembara itu masalah.
Dialogue: 0,0:20:06.12,0:20:08.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serangga ini bisa menimbulkan bencana.
Dialogue: 0,0:20:09.16,0:20:11.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chou-u mengatakan hal yang sama.
Dialogue: 0,0:20:11.62,0:20:15.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai penjaga rendahan,\Nkau cukup mengerti soal serangga.
Dialogue: 0,0:20:15.83,0:20:17.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa begitu.
Dialogue: 0,0:20:17.46,0:20:20.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau ambil buku dari benteng?
Dialogue: 0,0:20:20.92,0:20:23.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bisa menemukan barang berharga lain.
Dialogue: 0,0:20:24.38,0:20:27.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, aku tak ingin menjualnya.
Dialogue: 0,0:20:27.22,0:20:29.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berniat membelinya kembali.
Dialogue: 0,0:20:29.60,0:20:32.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak ada yang mau membeli\Nbuku bergambar ini, bukan?
Dialogue: 0,0:20:32.81,0:20:34.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang mau beli di sini.
Dialogue: 0,0:20:37.44,0:20:40.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seorang pria tua tinggal di sana\Nsebelum kau datang.
Dialogue: 0,0:20:40.69,0:20:42.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku biasa membawakannya makanan.
Dialogue: 0,0:20:43.40,0:20:45.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apoteker yang meneliti kehidupan abadi?
Dialogue: 0,0:20:45.95,0:20:46.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:20:46.91,0:20:49.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, dia juga melakukan hal lain.
Dialogue: 0,0:20:49.16,0:20:51.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini salah satu topik penelitiannya.
Dialogue: 0,0:20:51.70,0:20:54.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cara mencegah wabah belalang kembara.
Dialogue: 0,0:20:54.79,0:20:56.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu…
Dialogue: 0,0:20:58.09,0:21:01.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bintik! Boleh aku makan dango milikmu?
Dialogue: 0,0:21:01.09,0:21:02.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Tuan Muda!
Dialogue: 0,0:21:04.97,0:21:07.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku lupa! Dia kenal Chou-u!{\i0}
Dialogue: 0,0:21:07.43,0:21:10.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Semua orang mengira\NKlan Shi benar-benar musnah.{\i0}
Dialogue: 0,0:21:10.22,0:21:11.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kami tak boleh ketahuan!{\i0}
Dialogue: 0,0:21:12.22,0:21:14.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, makan saja dango milikku. Pergilah.
Dialogue: 0,0:21:14.31,0:21:15.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:21:15.27,0:21:18.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chou-u, mau kugendong di bahu?
Dialogue: 0,0:21:18.02,0:21:20.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh? Baiklah!
Dialogue: 0,0:21:23.57,0:21:25.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bahkan tanpa bukti kuat,{\i0}
Dialogue: 0,0:21:25.74,0:21:29.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}sebaiknya beri tahu Tuan Jinshi\Nuntuk berjaga-jaga.{\i0}
Dialogue: 0,0:21:50.55,0:21:53.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya sudah waktunya memenuhi janji.
Dialogue: 0,0:21:54.06,0:21:55.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudnya?
Dialogue: 0,0:21:55.52,0:21:59.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa sudah hampir waktunya\NYue memilih bunga.
Dialogue: 0,0:22:04.69,0:22:06.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Jinshi, sudah waktunya.
Dialogue: 0,0:22:07.57,0:22:08.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:23:54.72,0:23:57.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Episode selanjutnya, "Jubah Tikus Api".{\i0}
Dialogue: 0,0:23:58.85,0:24:00.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Terjemahan subtitle oleh Amalia Puspita
