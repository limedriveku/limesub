Dialogue: 0,0:01:31.00,0:01:32.00,sign,,0000,0000,0000,,{\an8}RUMAH VERDIGRIS
Dialogue: 0,0:01:32.00,0:01:34.00,sign,,0000,0000,0000,,{\an8}KISAH INI FIKSI, SEMUA NAMA TOKOH\NDAN ORGANISASINYA JUGA FIKTIF.
Dialogue: 0,0:01:34.01,0:01:34.92,sign,,0000,0000,0000,,{\an8}SELAIN ITU, KISAH INI TAK ADA HUBUNGANNYA\NDENGAN INSIDEN ATAU PERISTIWA NYATA.
Dialogue: 0,0:08:39.68,0:08:40.68,sign,,0000,0000,0000,,TUJUH
Dialogue: 0,0:23:46.13,0:23:48.76,sign,,0000,0000,0000,,CUPLIKAN EPISODE SELANJUTNYA
Dialogue: 0,0:01:40.01,0:01:41.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Selamat datang.
Dialogue: 0,0:01:42.72,0:01:45.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak kusangka dia datang.
Dialogue: 0,0:01:45.14,0:01:47.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari sekian banyak orang, kau yang datang?
Dialogue: 0,0:01:47.64,0:01:49.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kasarnya ucapanmu.
Dialogue: 0,0:01:55.69,0:01:57.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia adalah Lahan.{\i0}
Dialogue: 0,0:01:57.15,0:02:00.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia dari Klan La, jelas dari namanya.{\i0}
Dialogue: 0,0:02:00.87,0:02:04.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia keponakan dan putra angkat\Ndari ahli strategi aneh itu.{\i0}
Dialogue: 0,0:02:04.70,0:02:07.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak kusangka kau suka penampil jalanan.
Dialogue: 0,0:02:08.04,0:02:13.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga penasaran\Nsaat semua orang membicarakan sesuatu.
Dialogue: 0,0:02:15.42,0:02:19.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar gadis albino ini sangat cantik.
Dialogue: 0,0:02:19.93,0:02:23.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku lupa pria ini lemah\Ndengan objek kecantikan.{\i0}
Dialogue: 0,0:02:23.76,0:02:27.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun, tak seperti kebanyakan orang,\Ndia melihat kecantikan sebagai angka.{\i0}
Dialogue: 0,0:02:28.39,0:02:30.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Anak angkat orang aneh itu sendiri\Njuga aneh.{\i0}
Dialogue: 0,0:02:31.35,0:02:34.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kau datang untuk mengajakku?
Dialogue: 0,0:02:34.11,0:02:35.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau juga penasaran, bukan?
Dialogue: 0,0:02:36.48,0:02:37.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak akan kusangkal.
Dialogue: 0,0:02:37.74,0:02:41.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun, apa untungnya bagi dia\Ndengan mengajakku?{\i0}
Dialogue: 0,0:02:41.91,0:02:45.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa dia mencoba merayu\Nahli strategi aneh itu?{\i0}
Dialogue: 0,0:02:45.41,0:02:47.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah tidak ikut.
Dialogue: 0,0:02:47.16,0:02:48.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh?
Dialogue: 0,0:02:48.16,0:02:49.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, bawahannya ikut.
Dialogue: 0,0:02:51.92,0:02:54.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan menatapku begitu. Tuan Laka...
Dialogue: 0,0:02:57.55,0:03:00.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menyebutnya "Ahli Strategi".\NTak masalah, bukan?
Dialogue: 0,0:03:02.68,0:03:05.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Rikuson, bawahan Ahli Strategi.
Dialogue: 0,0:03:06.43,0:03:07.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Maomao.
Dialogue: 0,0:03:08.14,0:03:09.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu.
Dialogue: 0,0:03:10.23,0:03:12.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa dia malah mengutus bawahan?
Dialogue: 0,0:03:13.61,0:03:17.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ayah mungkin tak akan meninggalkan rumah\Nuntuk sementara.{\i0}
Dialogue: 0,0:03:17.82,0:03:21.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, kenapa kau mengajakku?
Dialogue: 0,0:03:22.41,0:03:26.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Lahan tak akan mengajakku\Ntanpa mempertimbangkan pro dan kontra.{\i0}
Dialogue: 0,0:03:26.08,0:03:28.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jika ingatanku benar,{\i0}
Dialogue: 0,0:03:28.04,0:03:30.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dia hampir sepelit Nenek.{\i0}
Dialogue: 0,0:03:30.62,0:03:33.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kali ini, aku ada urusan di Barat.
Dialogue: 0,0:03:33.92,0:03:38.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin kuminta penghibur keliling itu\Ntampil di perjamuan.
Dialogue: 0,0:03:38.67,0:03:39.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu?
Dialogue: 0,0:03:39.59,0:03:42.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagian tamu mereka wanita.
Dialogue: 0,0:03:42.76,0:03:45.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin pendapatmu\Ndari sudut pandang itu.
Dialogue: 0,0:03:45.39,0:03:46.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bohong.
Dialogue: 0,0:03:48.31,0:03:50.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pose yang menyebalkan.{\i0}
Dialogue: 0,0:03:50.23,0:03:55.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bosku, Ahli Strategi,\Nbahkan berkomentar soal ini.
Dialogue: 0,0:03:57.40,0:03:58.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Memang mencurigakan...
Dialogue: 0,0:04:00.86,0:04:02.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya itu yang dia katakan.
Dialogue: 0,0:04:02.28,0:04:05.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tak ada dasar\Natas ucapan ahli strategi aneh itu.{\i0}
Dialogue: 0,0:04:05.45,0:04:08.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu hanya intuisi supernatural.{\i0}
Dialogue: 0,0:04:08.79,0:04:12.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk berjaga-jaga, aku menyelidiki\Npara penghibur keliling itu.
Dialogue: 0,0:04:12.16,0:04:14.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, aku mendengar suatu rumor.
Dialogue: 0,0:04:14.96,0:04:15.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rumor?
Dialogue: 0,0:04:16.46,0:04:17.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:04:24.18,0:04:26.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga ini tak menyusahkanku.
Dialogue: 0,0:04:30.72,0:04:32.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita berangkat.
Dialogue: 0,0:04:37.90,0:04:42.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Teater gadis abadi itu terletak\Ndi distrik paling makmur di ibu kota.{\i0}
Dialogue: 0,0:04:42.99,0:04:45.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dengan kediaman kelas atas di dekatnya,{\i0}
Dialogue: 0,0:04:45.49,0:04:49.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}aneh jika pertunjukan solo\Ndiadakan di sana.{\i0}
Dialogue: 0,0:04:49.66,0:04:53.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Selain itu, penampilan gadis itu\Nmembuatnya dijuluki "Wanita Putih".{\i0}
Dialogue: 0,0:04:54.12,0:04:55.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Juga, "Dewi Putih."{\i0}
Dialogue: 0,0:04:55.67,0:04:58.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu nama yang ambisius\Nbagi penghibur keliling.{\i0}
Dialogue: 0,0:04:59.25,0:05:01.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis abadi yang terdengar fana.
Dialogue: 0,0:05:02.92,0:05:04.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah sampai.
Dialogue: 0,0:05:09.51,0:05:10.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:05:10.89,0:05:12.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk apa ini?
Dialogue: 0,0:05:12.39,0:05:15.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Acara seperti ini dianggap cukup rendahan.
Dialogue: 0,0:05:15.23,0:05:18.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sentuhan kecil ini\Nmembuat kita pura-pura tak saling kenal.
Dialogue: 0,0:05:18.48,0:05:20.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu membuat semuanya lebih lancar.
Dialogue: 0,0:05:25.78,0:05:29.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Penghibur keliling tampil\Ndi teater mewah seperti ini?{\i0}
Dialogue: 0,0:05:29.70,0:05:31.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia jelas punya sponsor.{\i0}
Dialogue: 0,0:05:31.95,0:05:33.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kursi kita di sana.
Dialogue: 0,0:05:37.71,0:05:41.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Jinshi, kau tak perlu\Ndatang ke sini secara langsung.
Dialogue: 0,0:05:41.50,0:05:44.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin harus. Ini kesempatan langka.
Dialogue: 0,0:05:44.05,0:05:44.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun...
Dialogue: 0,0:05:45.51,0:05:48.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin melihat sendiri\NWanita Putih ini.
Dialogue: 0,0:05:49.51,0:05:51.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini meja kita.
Dialogue: 0,0:05:51.18,0:05:53.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meja tengah sangat diminati
Dialogue: 0,0:05:53.43,0:05:55.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan sangat mahal...
Dialogue: 0,0:05:57.35,0:05:59.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:05:59.73,0:06:01.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan.
Dialogue: 0,0:06:02.65,0:06:05.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Manisan panggang disajikan dengan alkohol?{\i0}
Dialogue: 0,0:06:05.36,0:06:07.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kombinasi yang aneh.{\i0}
Dialogue: 0,0:06:11.53,0:06:13.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak minum alkohol?
Dialogue: 0,0:06:13.87,0:06:15.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku suka alkohol, tetapi...{\i0}
Dialogue: 0,0:06:16.08,0:06:17.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kuminum nanti.
Dialogue: 0,0:06:17.83,0:06:20.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau kau mau aku periksa apakah beracun?
Dialogue: 0,0:06:20.29,0:06:21.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, tak apa-apa.
Dialogue: 0,0:06:21.92,0:06:23.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak minum?
Dialogue: 0,0:06:23.25,0:06:26.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak mungkin hanya aku yang bersikap bodoh.
Dialogue: 0,0:06:26.63,0:06:28.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, ini cocok sekali.
Dialogue: 0,0:06:28.80,0:06:30.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasa yang tak biasa.
Dialogue: 0,0:06:57.58,0:06:59.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jadi, itulah Wanita Putih.{\i0}
Dialogue: 0,0:06:59.83,0:07:05.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Selain warna kulit, sikapnya itu...\NMungkinkah dia dari Barat?{\i0}
Dialogue: 0,0:07:19.56,0:07:22.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa yang menempati meja ini?
Dialogue: 0,0:07:23.27,0:07:24.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu kita.
Dialogue: 0,0:07:24.48,0:07:25.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu memang kita.
Dialogue: 0,0:07:26.02,0:07:27.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus bagaimana?
Dialogue: 0,0:07:27.32,0:07:29.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan aku yang memutuskan.
Dialogue: 0,0:07:29.49,0:07:31.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa tidak kau saja yang maju?
Dialogue: 0,0:07:31.95,0:07:34.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini kesempatan melihat dari dekat.
Dialogue: 0,0:07:36.20,0:07:37.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, aku akan maju.
Dialogue: 0,0:07:40.83,0:07:41.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apakah itu...{\i0}
Dialogue: 0,0:07:46.59,0:07:48.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tidak, tak mungkin.{\i0}
Dialogue: 0,0:07:53.30,0:07:56.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kulit transparan\Ndengan pembuluh darah yang terlihat.{\i0}
Dialogue: 0,0:07:56.05,0:07:58.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Berbeda dengan bedak wajah putih.{\i0}
Dialogue: 0,0:07:59.18,0:08:02.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong tulis nomor yang kau mau.
Dialogue: 0,0:08:02.77,0:08:05.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Tolong tulis nomor yang kau mau."
Dialogue: 0,0:08:08.48,0:08:11.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pastikan aku tak bisa melihatnya,
Dialogue: 0,0:08:11.15,0:08:15.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan lipat sampai kecil\Nagar tak ada yang bisa melihatnya juga.
Dialogue: 0,0:08:22.66,0:08:24.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tulis di kertas ini, ya?{\i0}
Dialogue: 0,0:08:24.96,0:08:28.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bahkan ada alas di bawahnya\Nagar tak mengotori meja.{\i0}
Dialogue: 0,0:08:31.05,0:08:35.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sulit menulis\Ndengan tinta berlebih seperti ini...{\i0}
Dialogue: 0,0:08:36.14,0:08:39.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ini juga agak kasar.\NSeharusnya dicampur dengan lebih baik.{\i0}
Dialogue: 0,0:08:43.43,0:08:44.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah.
Dialogue: 0,0:08:52.03,0:08:55.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa masukkan kertas itu\Nke salah satu tabung ini?
Dialogue: 0,0:08:56.36,0:08:59.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah selesai, tolong tarik kainnya.
Dialogue: 0,0:09:07.83,0:09:08.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah.
Dialogue: 0,0:09:40.78,0:09:43.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Penglihatannya tidak bagus.{\i0}
Dialogue: 0,0:09:43.54,0:09:46.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau menulis nomor 7, bukan?
Dialogue: 0,0:09:50.63,0:09:51.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:09:56.26,0:09:57.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia mengingatkanku{\i0}
Dialogue: 0,0:09:57.51,0:09:59.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}pada ular putih.{\i0}
Dialogue: 0,0:10:01.60,0:10:04.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu utusan Tuhan, jangan dibunuh.
Dialogue: 0,0:10:05.18,0:10:07.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tak ada hubungannya dengan Tuhan.{\i0}
Dialogue: 0,0:10:07.98,0:10:12.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku benci\Nsaat ayahku mencoba bersikap etis.{\i0}
Dialogue: 0,0:10:13.15,0:10:15.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Panas sekali.{\i0}
Dialogue: 0,0:10:15.19,0:10:16.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kepalaku juga sakit.{\i0}
Dialogue: 0,0:10:17.45,0:10:20.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Rasanya seperti\Nnyamuk berdengung di telingaku.{\i0}
Dialogue: 0,0:10:23.78,0:10:25.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tabung yang kau pilih
Dialogue: 0,0:10:26.00,0:10:29.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ketiga dari atas, kedua dari kiri.
Dialogue: 0,0:10:33.21,0:10:34.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Benar?
Dialogue: 0,0:10:38.76,0:10:43.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketiga dari atas,\Nkedua dari kiri. Yang ini!
Dialogue: 0,0:10:49.06,0:10:50.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia menulis "tujuh".
Dialogue: 0,0:10:50.81,0:10:52.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar tujuh!
Dialogue: 0,0:10:52.44,0:10:54.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bahkan memilih tabung yang tepat!
Dialogue: 0,0:10:55.19,0:10:56.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana dia melakukannya?
Dialogue: 0,0:10:58.32,0:11:02.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pasti Maomao juga bisa tahu trik ini.{\i0}
Dialogue: 0,0:11:02.95,0:11:05.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang terjadi?
Dialogue: 0,0:11:05.41,0:11:07.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudmu, "Apa yang terjadi?"
Dialogue: 0,0:11:07.24,0:11:11.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ada yang menyuapmu\Nuntuk melakukan itu?
Dialogue: 0,0:11:11.21,0:11:12.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak begitu, tak sepertimu.
Dialogue: 0,0:11:12.79,0:11:16.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga tidak. Betapa mengerikannya itu...
Dialogue: 0,0:11:16.88,0:11:18.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ada yang mengintipmu?
Dialogue: 0,0:11:18.80,0:11:20.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa tak ada yang mengintipku.
Dialogue: 0,0:11:21.80,0:11:25.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Yang ada di panggung\Nhanya Wanita Putih dan pembantunya.{\i0}
Dialogue: 0,0:11:25.97,0:11:27.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mereka tak bisa melihat nomorku.{\i0}
Dialogue: 0,0:11:27.97,0:11:32.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kain yang kutarik\Njuga seharusnya menutupi tabung pilihanku.{\i0}
Dialogue: 0,0:11:33.02,0:11:35.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mungkin ada cermin?{\i0}
Dialogue: 0,0:11:36.11,0:11:40.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tidak, pasti terlalu buram\Nuntuk melihat dalam cahaya redup.{\i0}
Dialogue: 0,0:11:40.53,0:11:42.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu akan mengaburkan cermin.{\i0}
Dialogue: 0,0:11:42.28,0:11:45.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Lagi pula, tampaknya\Npenglihatan Wanita Putih itu buruk.{\i0}
Dialogue: 0,0:11:45.83,0:11:48.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bahkan dari dekat, semuanya pasti buram.{\i0}
Dialogue: 0,0:11:48.79,0:11:50.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Lalu, bagaimana...{\i0}
Dialogue: 0,0:11:57.25,0:11:59.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya sepotong tembaga, bukan?
Dialogue: 0,0:11:59.13,0:12:00.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, jelas.
Dialogue: 0,0:12:28.28,0:12:29.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Berubah warna.{\i0}
Dialogue: 0,0:12:29.66,0:12:31.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tembaga berubah jadi perak!
Dialogue: 0,0:12:31.50,0:12:32.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kulihat!
Dialogue: 0,0:12:32.96,0:12:34.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu jelas perak.
Dialogue: 0,0:12:45.63,0:12:47.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perak berubah jadi emas!
Dialogue: 0,0:12:47.26,0:12:49.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil!
Dialogue: 0,0:12:49.05,0:12:49.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Basen.
Dialogue: 0,0:12:50.72,0:12:51.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku.
Dialogue: 0,0:12:55.60,0:12:57.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa kau jelaskan ini?
Dialogue: 0,0:12:57.31,0:12:58.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti.
Dialogue: 0,0:12:58.44,0:13:00.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Saat ini, biar kunikmati pertunjukannya.
Dialogue: 0,0:13:27.01,0:13:29.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cairan berwarna perak?
Dialogue: 0,0:13:29.09,0:13:30.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:13:33.27,0:13:34.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Itu... Tak mungkin...
Dialogue: 0,0:13:41.65,0:13:43.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah malam ini juga menyenangkan?
Dialogue: 0,0:13:44.90,0:13:46.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga kita bertemu lagi.
Dialogue: 0,0:13:46.99,0:13:48.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir yang menakjubkan.
Dialogue: 0,0:13:48.82,0:13:50.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu asli!
Dialogue: 0,0:13:51.66,0:13:53.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wanita Putih tersayang...
Dialogue: 0,0:13:53.12,0:13:55.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu sungguh sihir?
Dialogue: 0,0:13:55.83,0:13:57.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti ada triknya.
Dialogue: 0,0:13:58.46,0:13:59.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari pergi.
Dialogue: 0,0:13:59.50,0:14:00.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, Tuan.
Dialogue: 0,0:14:01.09,0:14:04.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Juga, selidiki pejabat tinggi\Nyang sering ke tempat ini.
Dialogue: 0,0:14:04.63,0:14:05.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:14:06.26,0:14:09.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Wanita Putih itu adalah ancaman.{\i0}
Dialogue: 0,0:14:14.72,0:14:16.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang aneh dari ini...
Dialogue: 0,0:14:18.64,0:14:19.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada masalah?
Dialogue: 0,0:14:20.23,0:14:21.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:14:27.65,0:14:29.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya ada sesuatu yang dicampurkan.
Dialogue: 0,0:14:32.16,0:14:34.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tak banyak alkohol.{\i0}
Dialogue: 0,0:14:34.03,0:14:35.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Seperti jus, mudah diminum.{\i0}
Dialogue: 0,0:14:35.91,0:14:37.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun, rasanya agak rumit.{\i0}
Dialogue: 0,0:14:38.54,0:14:41.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ada sedikit garam di dalamnya.{\i0}
Dialogue: 0,0:14:41.00,0:14:45.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan racun, tetapi diubah\Nuntuk meningkatkan efek alkohol.
Dialogue: 0,0:14:46.17,0:14:47.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Selain itu,{\i0}
Dialogue: 0,0:14:47.63,0:14:51.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}ruang redup dengan lampion\Nyang bergoyang pelan.{\i0}
Dialogue: 0,0:14:52.22,0:14:55.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kabut misterius dan seorang gadis surgawi.{\i0}
Dialogue: 0,0:14:55.93,0:14:58.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Fenomena tak terjelaskan\Nyang terjadi di depan mata.{\i0}
Dialogue: 0,0:14:58.73,0:15:02.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bukankah itu cukup\Nuntuk memercayainya begitu saja?{\i0}
Dialogue: 0,0:15:03.73,0:15:05.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Seperti yang kukira. Sedikit asin.{\i0}
Dialogue: 0,0:15:05.73,0:15:07.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Akan lebih enak tanpa garam.{\i0}
Dialogue: 0,0:15:12.24,0:15:13.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sedang apa?
Dialogue: 0,0:15:13.82,0:15:15.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini cara dia melakukannya.
Dialogue: 0,0:15:16.12,0:15:19.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jika dia berhasil dengan ini,\Nitu pasti ada triknya juga.{\i0}
Dialogue: 0,0:15:20.25,0:15:24.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kabutnya cukup tebal dan cukup panas\Nuntuk membuat sakit kepala,{\i0}
Dialogue: 0,0:15:25.00,0:15:27.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}yang merusak konsentrasiku.{\i0}
Dialogue: 0,0:15:28.05,0:15:29.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kabutnya...{\i0}
Dialogue: 0,0:15:29.63,0:15:31.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mungkinkah itu uap?{\i0}
Dialogue: 0,0:15:31.88,0:15:34.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mungkin memompa uap\Ndari belakang panggung?{\i0}
Dialogue: 0,0:15:34.93,0:15:36.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu menjelaskan panasnya.{\i0}
Dialogue: 0,0:15:37.51,0:15:39.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Lalu, kenapa kepalaku sakit?{\i0}
Dialogue: 0,0:15:39.89,0:15:42.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Rasanya seperti nyamuk berdengung.{\i0}
Dialogue: 0,0:15:42.90,0:15:44.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mungkinkah itu...{\i0}
Dialogue: 0,0:15:49.74,0:15:54.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk apa kau bersiul?\NMengejek seperti itu tidak sopan.
Dialogue: 0,0:15:59.70,0:16:02.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Baik, aku tahu apa yang terjadi.{\i0}
Dialogue: 0,0:16:09.76,0:16:12.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minuman mewah ini memang berbeda.
Dialogue: 0,0:16:12.30,0:16:14.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau tak bisa menahan diri?
Dialogue: 0,0:16:14.72,0:16:16.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau dibayar mahal. Apa masalahnya?
Dialogue: 0,0:16:16.85,0:16:20.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami melakukan pembelian mahal\Ndi Rumah Verdigris tahun lalu.
Dialogue: 0,0:16:20.60,0:16:21.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bangkrut.
Dialogue: 0,0:16:21.89,0:16:24.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau siap memberi tahu kami sekarang?
Dialogue: 0,0:16:25.27,0:16:28.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama, kuberi tahu cara dia\Nmengubah tembaga jadi perak dan emas.
Dialogue: 0,0:16:28.86,0:16:31.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mirip dengan yang disebut "transmutasi".
Dialogue: 0,0:16:31.90,0:16:33.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Transmutasi?
Dialogue: 0,0:16:33.11,0:16:36.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin lebih mudah\Nmenganggapnya sebagai {\i1}liandan-shu.{\i0}
Dialogue: 0,0:16:37.32,0:16:42.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Semacam itu, transmutasi melibatkan\Nmengubah nonlogam menjadi logam.{\i0}
Dialogue: 0,0:16:42.08,0:16:43.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mirip dengan itu?
Dialogue: 0,0:16:43.96,0:16:46.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, tetapi jika harus kubandingkan,
Dialogue: 0,0:16:46.75,0:16:50.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kurasa lebih mirip\Ndengan yang disebut "alkimia" di Barat.
Dialogue: 0,0:16:50.75,0:16:52.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di Barat?
Dialogue: 0,0:16:52.05,0:16:55.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, tetapi aku\Nhanya dengar cerita dari ayahku.
Dialogue: 0,0:16:55.72,0:16:59.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bukan soal mengubah jadi perak atau emas.{\i0}
Dialogue: 0,0:17:00.06,0:17:01.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tampaknya, itu pelapisan.{\i0}
Dialogue: 0,0:17:01.81,0:17:05.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mereka hanya memanaskannya dengan api\Nuntuk mengubah penampilannya.{\i0}
Dialogue: 0,0:17:06.23,0:17:09.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, apa maksudmu, "pelapisan"?
Dialogue: 0,0:17:09.06,0:17:12.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melapisi logam\Ndengan jenis logam yang berbeda.
Dialogue: 0,0:17:12.94,0:17:15.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika ingin tahu lebih banyak,\Ntanya ayahku.
Dialogue: 0,0:17:15.45,0:17:18.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan berterima kasih\Njika kau bisa melapor lagi kepadaku.
Dialogue: 0,0:17:18.70,0:17:19.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh, tanyakan.
Dialogue: 0,0:17:19.74,0:17:20.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Baiklah...
Dialogue: 0,0:17:22.04,0:17:24.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Juga, kertas yang langsung terbakar,{\i0}
Dialogue: 0,0:17:24.58,0:17:27.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}itu mungkin dengan produk sampingan\Nyang dihasilkan selama proses ini.{\i0}
Dialogue: 0,0:17:28.54,0:17:33.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu juga menjelaskan kupu-kupunya,\Njika dibuat dengan cerdas dari kertas.{\i0}
Dialogue: 0,0:17:33.55,0:17:37.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Penglihatan semua penonton\Nkabur karena kabut.{\i0}
Dialogue: 0,0:17:37.05,0:17:39.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Penonton juga mabuk karena alkohol.{\i0}
Dialogue: 0,0:17:40.35,0:17:43.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kalian bahkan tak minum,\Ntetapi masih tertipu.{\i0}
Dialogue: 0,0:17:43.64,0:17:45.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku ragu ada yang sadar.
Dialogue: 0,0:17:45.89,0:17:48.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, bagaimana\Ndia bisa membaca pikiranmu?
Dialogue: 0,0:17:49.56,0:17:50.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kuberi tahu.
Dialogue: 0,0:17:53.40,0:17:54.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kertas.
Dialogue: 0,0:17:54.65,0:17:56.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang mulai sombong.
Dialogue: 0,0:18:04.16,0:18:05.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Area yang basah menyusut.
Dialogue: 0,0:18:06.41,0:18:08.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan itu intinya.
Dialogue: 0,0:18:08.37,0:18:10.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunjukkan sedikit rasa hormat\Nkepada kakakmu.
Dialogue: 0,0:18:10.88,0:18:12.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tidak akan.{\i0}
Dialogue: 0,0:18:13.05,0:18:16.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, apa hubungannya dengan ini?
Dialogue: 0,0:18:17.17,0:18:18.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat ke sini.
Dialogue: 0,0:18:22.85,0:18:26.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tulisan yang terlihat dengan panas.\NAku pernah melakukan ini.{\i0}
Dialogue: 0,0:18:26.10,0:18:29.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tuan Jinshi akan tahu tanpa kujelaskan.{\i0}
Dialogue: 0,0:18:29.65,0:18:30.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu membantu?
Dialogue: 0,0:18:30.56,0:18:32.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak menjawab pertanyaanku.
Dialogue: 0,0:18:32.48,0:18:35.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa hubungannya dengan membaca pikiran?
Dialogue: 0,0:18:36.53,0:18:37.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana rasanya?
Dialogue: 0,0:18:38.28,0:18:41.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya seperti kaldu boga bahari,\Ntetapi sedikit asin.
Dialogue: 0,0:18:41.66,0:18:43.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu berarti mengandung garam.
Dialogue: 0,0:18:43.37,0:18:44.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, lalu?
Dialogue: 0,0:18:44.58,0:18:47.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tinta di kuas itu juga mengandung garam.
Dialogue: 0,0:18:48.12,0:18:51.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak heran tinta itu kasar\Ndan sulit digunakan untuk menulis.
Dialogue: 0,0:18:51.58,0:18:53.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, pakai panas untuk melihat nomormu?
Dialogue: 0,0:18:53.79,0:18:56.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, ada cara lain untuk melihatnya.
Dialogue: 0,0:18:56.84,0:18:59.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ada alas hitam di bawah kertas itu.{\i0}
Dialogue: 0,0:18:59.72,0:19:03.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tinta dengan garam\Npasti membekas di alasnya.{\i0}
Dialogue: 0,0:19:03.35,0:19:05.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu cara dia melakukannya?
Dialogue: 0,0:19:05.01,0:19:06.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masuk akal.
Dialogue: 0,0:19:06.27,0:19:10.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, bagaimana dia tahu\Nkau masukkan kertas di tabung mana?
Dialogue: 0,0:19:12.48,0:19:14.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tahu cara kerja seruling, bukan?
Dialogue: 0,0:19:15.57,0:19:17.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ditiup untuk menghasilkan suara...
Dialogue: 0,0:19:21.07,0:19:22.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk mengubah suara?
Dialogue: 0,0:19:22.36,0:19:25.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ubah jumlah lubang yang dilewati napas.
Dialogue: 0,0:19:25.53,0:19:27.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pun tahu itu.
Dialogue: 0,0:19:27.79,0:19:32.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bagaimana jika tabung berisi kertas itu\Nseperti lubang seruling?{\i0}
Dialogue: 0,0:19:32.92,0:19:35.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Seruling? Aku tak mendengar\Nsuara seperti itu...{\i0}
Dialogue: 0,0:19:36.63,0:19:40.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tersembunyi di antara lonceng\Ndan gong di teater itu,{\i0}
Dialogue: 0,0:19:40.34,0:19:42.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}ada suara penting lain.{\i0}
Dialogue: 0,0:19:43.39,0:19:47.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa itu suara bernada tinggi\Nyang tak disadari.
Dialogue: 0,0:19:47.68,0:19:48.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bernada tinggi?
Dialogue: 0,0:19:48.93,0:19:52.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, suara bernada tinggi\Nmenyebabkan sakit kepala.
Dialogue: 0,0:19:52.64,0:19:54.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mungkin tak mengenali suaranya,
Dialogue: 0,0:19:54.69,0:19:57.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tetapi tanpa sadar aku merasa tak nyaman.
Dialogue: 0,0:19:59.44,0:20:00.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa mendengarnya.
Dialogue: 0,0:20:00.99,0:20:01.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu ini?
Dialogue: 0,0:20:03.82,0:20:04.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih bisa kudengar.
Dialogue: 0,0:20:05.57,0:20:07.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terdengar sedikit.
Dialogue: 0,0:20:08.29,0:20:09.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak bisa dengar.
Dialogue: 0,0:20:09.70,0:20:11.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus.
Dialogue: 0,0:20:11.21,0:20:14.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suara seperti ini\Njadi kurang terdengar seiring usia.
Dialogue: 0,0:20:15.63,0:20:19.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Telinga gadis abadi itu sangat sensitif.{\i0}
Dialogue: 0,0:20:19.88,0:20:23.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, suara seruling\Nmemberitahunya tabung yang tepat?
Dialogue: 0,0:20:24.34,0:20:28.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, suara seruling mengikuti\Nirama gong dan lonceng.
Dialogue: 0,0:20:28.60,0:20:31.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika dia bisa membedakan sepuluh nada,\Nitu sudah cukup.
Dialogue: 0,0:20:31.81,0:20:33.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, bagaimana meniupnya?
Dialogue: 0,0:20:33.85,0:20:36.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu bisa dijelaskan oleh kabut.{\i0}
Dialogue: 0,0:20:37.56,0:20:41.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kurasa kabutnya adalah uap.\NMereka memberi uap di bawah meja.{\i0}
Dialogue: 0,0:20:43.86,0:20:45.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian percaya sekarang?
Dialogue: 0,0:20:48.62,0:20:53.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terakhir, tentang cairan perak\Nyang diminum Wanita Putih.
Dialogue: 0,0:20:53.62,0:20:55.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu merkuri.
Dialogue: 0,0:20:55.21,0:20:56.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Racun mematikan.
Dialogue: 0,0:20:57.13,0:21:00.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah apa dia benar-benar meminumnya,\Ntetapi jangan coba itu.
Dialogue: 0,0:21:01.13,0:21:04.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau harus menjelaskan ini\Nkepada pejabat tinggi.
Dialogue: 0,0:21:09.97,0:21:11.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pertunjukan Wanita Putih dan krunya{\i0}
Dialogue: 0,0:21:11.81,0:21:15.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}menghilang tanpa jejak\Nbeberapa hari kemudian.{\i0}
Dialogue: 0,0:21:16.10,0:21:17.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun, yang tersisa{\i0}
Dialogue: 0,0:21:17.81,0:21:21.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}adalah kasus misterius keracunan makanan\Ndi antara pedagang ibu kota.{\i0}
Dialogue: 0,0:21:22.90,0:21:26.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Seorang gadis abadi seperti ular putih.\NApa tujuannya?{\i0}
Dialogue: 0,0:21:27.82,0:21:30.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Menghirup merkuri melalui uap{\i0}
Dialogue: 0,0:21:30.12,0:21:33.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}atau menempelkannya pada benda lain\Nuntuk mengubah bentuk sangatlah beracun.{\i0}
Dialogue: 0,0:21:36.25,0:21:40.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun, terkadang juga digunakan\Nsebagai obat.{\i0}
Dialogue: 0,0:21:48.72,0:21:50.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Soal racun dan obat,{\i0}
Dialogue: 0,0:21:51.68,0:21:53.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}intinya cara menggunakannya.{\i0}
Dialogue: 0,0:23:54.76,0:23:56.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Episode selanjutnya, "Desa Kertas".{\i0}
Dialogue: 0,0:23:57.85,0:24:00.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Terjemahan subtitle oleh Amalia Puspita
