Dialogue: 0,0:01:31.88,0:01:32.84,sign,,0000,0000,0000,,{\an8}KISAH INI FIKSI, SEMUA NAMA TOKOH\NDAN ORGANISASINYA JUGA FIKTIF.
Dialogue: 0,0:01:32.84,0:01:33.80,sign,,0000,0000,0000,,{\an8}SELAIN ITU, KISAH INI TAK ADA HUBUNGANNYA\NDENGAN INSIDEN ATAU PERISTIWA NYATA.
Dialogue: 0,0:04:12.71,0:04:13.62,sign,,0000,0000,0000,,KLAN YI
Dialogue: 0,0:23:46.09,0:23:48.88,sign,,0000,0000,0000,,CUPLIKAN EPISODE SELANJUTNYA
Dialogue: 0,0:01:33.80,0:01:37.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Apa ada kemajuan\Ndalam perjalanan Yue ke Barat?
Dialogue: 0,0:01:37.01,0:01:40.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia berhenti untuk memeriksa\Ndesa pembuat kertas,
Dialogue: 0,0:01:40.18,0:01:42.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi, kurasa sudah setengah jalan.
Dialogue: 0,0:01:42.47,0:01:44.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu. Baru setengah jalan, ya.
Dialogue: 0,0:01:49.10,0:01:51.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tanpa Jinshi si kasim,{\i0}
Dialogue: 0,0:01:51.90,0:01:54.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}aku kembali melayani Kaisar lagi.{\i0}
Dialogue: 0,0:01:56.69,0:01:58.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Selama bergenerasi, Klan Ma{\i0}
Dialogue: 0,0:01:58.66,0:02:01.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}telah memikul tugas\Nuntuk melindungi bunga negara.{\i0}
Dialogue: 0,0:02:01.99,0:02:05.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Karena itu, aku mengenal Yang Mulia\Nsejak kecil.{\i0}
Dialogue: 0,0:02:08.16,0:02:11.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kaisar, putri ibu susunya, Ah-Duo,{\i0}
Dialogue: 0,0:02:12.46,0:02:14.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dan satu lagi...{\i0}
Dialogue: 0,0:02:36.15,0:02:37.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dalam perjalanan ke Barat,{\i0}
Dialogue: 0,0:02:38.44,0:02:41.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Basen mengawal bunga\Nyang dikenal sebagai "Bulan".{\i0}
Dialogue: 0,0:02:41.91,0:02:43.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun, Basen pernah gagal{\i0}
Dialogue: 0,0:02:43.83,0:02:48.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dan menyebabkan Bulan terluka\Nsaat pertempuran melawan Klan Shi.{\i0}
Dialogue: 0,0:02:49.25,0:02:51.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Walau tak bisa menyangkal kecemasanku,{\i0}
Dialogue: 0,0:02:51.29,0:02:54.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}kehadiran gadis apoteker itu\Npasti menjaga semua tetap teratur.{\i0}
Dialogue: 0,0:02:54.46,0:02:57.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku sangat percaya ketangguhan mentalnya.{\i0}
Dialogue: 0,0:02:57.92,0:02:58.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Masalahnya,{\i0}
Dialogue: 0,0:02:59.67,0:03:04.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}mereka mengunjungi Ibu Kota Barat\Nsetelah meninggalkan desa pembuat kertas.{\i0}
Dialogue: 0,0:03:04.51,0:03:09.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku membujuk putraku untuk mengajak\Ngadis itu sebagai pencicip makanan.{\i0}
Dialogue: 0,0:03:10.39,0:03:13.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sang Pangeran Bulan\Nlangsung menyetujuinya.{\i0}
Dialogue: 0,0:03:13.27,0:03:15.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jalan yang berat juga menantinya.
Dialogue: 0,0:03:15.48,0:03:17.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bunga macam apa yang akan mendekatinya?
Dialogue: 0,0:03:17.94,0:03:21.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bunga yang mendekat?\NPilihan kata-kata yang cukup lucu.
Dialogue: 0,0:03:21.15,0:03:24.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyamakan mereka dengan serangga\Nakan menyinggung.
Dialogue: 0,0:03:24.32,0:03:27.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau akan paham\Nsetelah melihat kebun bungaku.
Dialogue: 0,0:03:27.04,0:03:29.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Atmosfer kesepian menyelimuti Yang Mulia.{\i0}
Dialogue: 0,0:03:30.20,0:03:34.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mungkin karena Ah-Duo,\Nkepala vila ini, tidak ada.{\i0}
Dialogue: 0,0:03:34.58,0:03:36.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia juga menuju ke Ibu Kota Barat.{\i0}
Dialogue: 0,0:03:37.55,0:03:39.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bersama seseorang...{\i0}
Dialogue: 0,0:03:41.72,0:03:43.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wabah belalang kembara, ya?
Dialogue: 0,0:03:43.89,0:03:45.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Wabah belalang kembara.{\i0}
Dialogue: 0,0:03:45.30,0:03:48.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dalam banyak kasus,\Nmereka menyerbu dari Barat.{\i0}
Dialogue: 0,0:03:48.64,0:03:52.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pangeran Bulan ditugaskan\Nuntuk merancang tindakan pencegahan.{\i0}
Dialogue: 0,0:03:52.73,0:03:55.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dengan belalang daun datang dari Barat,{\i0}
Dialogue: 0,0:03:55.23,0:03:57.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}itu mungkin juga\Nmenyebabkan kerusakan di sana.{\i0}
Dialogue: 0,0:03:58.48,0:04:00.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kelaparan membuat sulit diatur.{\i0}
Dialogue: 0,0:04:00.32,0:04:04.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ini sering memicu perang di masa lalu.{\i0}
Dialogue: 0,0:04:04.95,0:04:07.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Semoga ini kecemasan yang tak perlu.
Dialogue: 0,0:04:07.53,0:04:08.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:04:08.70,0:04:12.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Klan Yi,\Npenguasa Isei-shu sebelumnya di Barat...{\i0}
Dialogue: 0,0:04:13.62,0:04:15.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}...mati lebih dari satu dekade lalu.{\i0}
Dialogue: 0,0:04:15.96,0:04:19.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Di masa Janda Permaisuri, mereka hancur\Nsetelah merencanakan kejahatan.{\i0}
Dialogue: 0,0:04:20.30,0:04:25.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Yang memimpin wilayah itu sekarang\Nadalah ayah Permaisuri Gyokuyou, Gyokuen.{\i0}
Dialogue: 0,0:04:25.97,0:04:30.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kini mereka tidak bernama,\Ntetapi Yang Mulia akan menamainya.{\i0}
Dialogue: 0,0:04:31.06,0:04:34.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jika perang meletus,\NBarat akan menjadi sangat penting.{\i0}
Dialogue: 0,0:04:35.48,0:04:38.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu sebabnya Permaisuri Gyokuyou\Ndiangkat sebagai istri resmi.{\i0}
Dialogue: 0,0:04:38.82,0:04:41.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pernikahan memang alat politik.{\i0}
Dialogue: 0,0:04:41.94,0:04:44.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan dari takhta suatu negara,
Dialogue: 0,0:04:44.07,0:04:47.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kadang harus menyanjung ayah mertua, ya?
Dialogue: 0,0:04:47.91,0:04:51.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kadang, aku juga harus menunjukkan\Nkesulitanku sendiri.
Dialogue: 0,0:05:05.05,0:05:08.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Negara bagian federal Hokuaren\Nterletak di barat laut Negara Li.{\i0}
Dialogue: 0,0:05:09.97,0:05:14.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Wilayah luas penghasil biji-bijian ini\Nkaya akan sumber daya hutan,{\i0}
Dialogue: 0,0:05:14.10,0:05:16.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}juga riwayat konflik yang sering\Ndengan Li.{\i0}
Dialogue: 0,0:05:17.06,0:05:20.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal suku barbar\Nyang saat ini mengganggu Negara Li,
Dialogue: 0,0:05:20.65,0:05:23.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}penyebabnya ada di dalam Hokuaren.
Dialogue: 0,0:05:24.03,0:05:27.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanpa hubungan diplomatik,\Ntak bisa berkomunikasi langsung.
Dialogue: 0,0:05:27.78,0:05:30.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, mediasi negara lain...
Dialogue: 0,0:05:30.03,0:05:31.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, apa kau mendengarkan?
Dialogue: 0,0:05:32.62,0:05:33.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mendengarkan.
Dialogue: 0,0:05:34.08,0:05:38.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pejabat luar negeri berkumpul\Ndi Ibu Kota Barat yang akan kita datangi.
Dialogue: 0,0:05:38.08,0:05:41.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang terkait dengan Hokuaren\Njuga datang.
Dialogue: 0,0:05:41.79,0:05:44.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ibu Kota Barat menjadi kejutan.{\i0}
Dialogue: 0,0:05:44.13,0:05:47.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bahkan dengan kereta dan kapal,\Nini butuh lebih dari setengah bulan.{\i0}
Dialogue: 0,0:05:47.80,0:05:51.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa Chou-u dan Sazen\Nbaik-baik saja tanpaku?{\i0}
Dialogue: 0,0:05:51.55,0:05:53.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kurasa mereka bisa mengatasinya.{\i0}
Dialogue: 0,0:05:54.39,0:05:57.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jadi, itu sebabnya Tuan Basen mengomeliku\Ndengan kursus kilat{\i0}
Dialogue: 0,0:05:57.69,0:06:00.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}tentang urusan politik yang menyebalkan.{\i0}
Dialogue: 0,0:06:03.69,0:06:04.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita hampir sampai.
Dialogue: 0,0:06:07.95,0:06:08.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh.
Dialogue: 0,0:06:08.91,0:06:11.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akan bermalam di desa ini.
Dialogue: 0,0:06:11.07,0:06:12.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan berkeliaran.
Dialogue: 0,0:06:14.87,0:06:16.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan beli makanan.
Dialogue: 0,0:06:16.37,0:06:18.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau dengar saat aku bicara?
Dialogue: 0,0:06:19.96,0:06:21.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Ji...
Dialogue: 0,0:06:21.46,0:06:22.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ikut denganmu.
Dialogue: 0,0:06:23.29,0:06:24.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Orang ini...{\i0}
Dialogue: 0,0:06:28.67,0:06:30.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ada yang menarik yang mereka jual?
Dialogue: 0,0:06:31.26,0:06:32.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang menarik...
Dialogue: 0,0:06:32.85,0:06:36.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Henep tampaknya\Ntumbuhan yang berkembang di sini.
Dialogue: 0,0:06:36.31,0:06:38.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pakaian mereka kebanyakan henep.
Dialogue: 0,0:06:38.10,0:06:42.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu mungkin tak cukup hangat,\Nmereka memadukannya dengan bulu hewan.
Dialogue: 0,0:06:43.86,0:06:49.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Roti pun ditaburi dengan biji henep,\Ndan sepertinya mereka menggunakan minyak.
Dialogue: 0,0:06:49.24,0:06:50.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Digoreng dengan minyak?
Dialogue: 0,0:06:50.91,0:06:52.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu ada...
Dialogue: 0,0:06:52.57,0:06:53.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:06:54.83,0:06:55.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lupakan.
Dialogue: 0,0:06:55.87,0:06:58.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa mereka terlalu banyak merokok.
Dialogue: 0,0:06:58.79,0:06:59.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak merokok?
Dialogue: 0,0:06:59.96,0:07:03.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam porsi kecil,\Nhenep digunakan untuk obat.
Dialogue: 0,0:07:03.58,0:07:06.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, merokok rutin bisa menjadi adiktif.
Dialogue: 0,0:07:06.38,0:07:08.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam jumlah besar, juga beracun.
Dialogue: 0,0:07:09.47,0:07:12.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira kau terobsesi\Ndengan apa pun yang beracun.
Dialogue: 0,0:07:12.43,0:07:15.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zat adiktif itu menakutkan.
Dialogue: 0,0:07:15.56,0:07:18.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak bisa menghilangkan racun begitu saja.
Dialogue: 0,0:07:18.39,0:07:19.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski mencoba berhenti,
Dialogue: 0,0:07:19.98,0:07:23.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}godaannya lebih besar\Ndari ranjang hangat di pagi musim dingin.
Dialogue: 0,0:07:24.27,0:07:25.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh?
Dialogue: 0,0:07:25.31,0:07:28.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kamar hangat,\Nbangun dari ranjang itu mudah.
Dialogue: 0,0:07:28.40,0:07:32.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sial, orang ini tak bisa memahami\Nkehidupan rakyat jelata.{\i0}
Dialogue: 0,0:07:32.82,0:07:34.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sebelum Tuan Jinshi bangun,{\i0}
Dialogue: 0,0:07:34.82,0:07:38.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}aku yakin wanita tua itu menyalakan\Npemanas arang untuk hangatkan kamar.{\i0}
Dialogue: 0,0:07:39.08,0:07:43.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Membuat Nyonya Suiren yang tua\Nbekerja keras? Majikan yang kejam.{\i0}
Dialogue: 0,0:07:43.17,0:07:46.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia bahkan tak sadar betapa beratnya itu.{\i0}
Dialogue: 0,0:07:47.63,0:07:50.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Sudah lama aku tak melihat mata itu.
Dialogue: 0,0:07:50.30,0:07:52.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa orang ini waras?{\i0}
Dialogue: 0,0:07:53.18,0:07:55.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang lebih penting, ayo beli makanan.
Dialogue: 0,0:07:55.97,0:07:57.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini?
Dialogue: 0,0:07:57.43,0:07:58.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Camilan bernama {\i1}mahua.{\i0}
Dialogue: 0,0:07:58.97,0:08:01.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Adonan dipelintir, lalu digoreng.
Dialogue: 0,0:08:02.39,0:08:05.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa bangsawan akan suka ini?{\i0}
Dialogue: 0,0:08:05.06,0:08:06.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau satu.
Dialogue: 0,0:08:06.77,0:08:07.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap.
Dialogue: 0,0:08:08.40,0:08:11.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu tak cukup.\NBagaimana jika tambah lagi?
Dialogue: 0,0:08:11.07,0:08:12.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu, jika enak.
Dialogue: 0,0:08:14.53,0:08:15.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayolah, kau makan sendiri?
Dialogue: 0,0:08:17.24,0:08:18.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memeriksa racun.
Dialogue: 0,0:08:20.16,0:08:22.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Baru digoreng, itu bagus.{\i0}
Dialogue: 0,0:08:22.21,0:08:24.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kurasa semua mau makan ini.{\i0}
Dialogue: 0,0:08:24.75,0:08:26.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau banyak.
Dialogue: 0,0:08:26.25,0:08:27.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Segera.
Dialogue: 0,0:08:31.38,0:08:32.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lumayan.
Dialogue: 0,0:08:32.59,0:08:35.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jika rasa ini mengalahkan\Nhidangan istana yang biasa kau makan,{\i0}
Dialogue: 0,0:08:35.93,0:08:38.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}kokimu mungkin sebaiknya berhenti.{\i0}
Dialogue: 0,0:08:38.30,0:08:41.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Jinshi, kau yakin boleh bermain-main?
Dialogue: 0,0:08:41.39,0:08:45.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Basen tampak lelah\Ndari desa pembuat kertas itu.
Dialogue: 0,0:08:45.02,0:08:48.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bermalas-malasan sedikit\Njuga akan membantunya.
Dialogue: 0,0:08:48.61,0:08:50.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:08:50.36,0:08:53.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tuan Basen jelas tak pandai\Ndalam berbohong.{\i0}
Dialogue: 0,0:08:53.69,0:08:57.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Berperan sebagai bos Tuan Jinshi\Npasti sangat berat baginya.{\i0}
Dialogue: 0,0:08:57.16,0:09:01.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia mirip Tuan Gaoshun,\Nsakit perut karena hal-hal seperti itu.{\i0}
Dialogue: 0,0:09:01.62,0:09:04.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, mari kembali\Nmengumpulkan makanan.
Dialogue: 0,0:09:04.91,0:09:06.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setuju.
Dialogue: 0,0:09:10.42,0:09:11.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini...
Dialogue: 0,0:09:12.63,0:09:14.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi.
Dialogue: 0,0:09:14.17,0:09:15.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa kubantu?
Dialogue: 0,0:09:15.22,0:09:17.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh kami minta?
Dialogue: 0,0:09:17.43,0:09:19.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami akan bayar.
Dialogue: 0,0:09:23.18,0:09:24.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau yang mana?
Dialogue: 0,0:09:25.23,0:09:27.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini, ini, dan itu. Sekitar sepuluh porsi.
Dialogue: 0,0:09:27.85,0:09:30.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Juga yang menarik, kalau ada.
Dialogue: 0,0:09:30.48,0:09:32.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu sebentar.
Dialogue: 0,0:09:33.40,0:09:34.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa?{\i0}
Dialogue: 0,0:09:34.32,0:09:37.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia berikan produk bagus.{\i0}
Dialogue: 0,0:09:37.15,0:09:38.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harganya,
Dialogue: 0,0:09:39.28,0:09:40.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bagaimana kalau sebanyak ini?
Dialogue: 0,0:09:40.99,0:09:42.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Lebih murah dari dugaanku.{\i0}
Dialogue: 0,0:09:43.58,0:09:45.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf telah meminta semua ini.
Dialogue: 0,0:09:48.37,0:09:51.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak pernah tahu kapan para dewa mengawasi.
Dialogue: 0,0:09:51.50,0:09:54.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat? Ada satu di sini.
Dialogue: 0,0:09:57.01,0:09:59.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku lihat kalian menyembah ular di sini.
Dialogue: 0,0:09:59.64,0:10:01.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, benar.
Dialogue: 0,0:10:01.14,0:10:04.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ular putih membawa\Npanen yang melimpah tahun ini.
Dialogue: 0,0:10:06.31,0:10:10.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku yakin Tuan Jinshi sudah mendengar\Ntentang Wanita Putih sekarang.{\i0}
Dialogue: 0,0:10:10.86,0:10:14.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia mungkin memimpin tindakan pencegahan.{\i0}
Dialogue: 0,0:10:15.15,0:10:19.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ke mana dia pergi?\NGadis abadi yang mencurigakan itu...{\i0}
Dialogue: 0,0:10:19.45,0:10:23.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kalian menuju Barat,\Nsebaiknya hati-hati.
Dialogue: 0,0:10:23.53,0:10:24.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa begitu?
Dialogue: 0,0:10:24.91,0:10:29.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jalan utama di Barat\Npenuh pencuri belakangan ini.
Dialogue: 0,0:10:29.25,0:10:31.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedagang pun menghindarinya.
Dialogue: 0,0:10:31.42,0:10:32.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sekarang aku paham.{\i0}
Dialogue: 0,0:10:32.84,0:10:36.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mungkin dia biasa menjual makanan\Ndi rak ini kepada para pedagang itu.{\i0}
Dialogue: 0,0:10:36.67,0:10:38.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Makanya harganya murah.{\i0}
Dialogue: 0,0:10:38.67,0:10:40.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih. Kami akan hati-hati.
Dialogue: 0,0:10:40.93,0:10:43.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan. Hati-hati.
Dialogue: 0,0:10:49.60,0:10:51.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari segera kembali.
Dialogue: 0,0:10:51.40,0:10:53.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, ayo.
Dialogue: 0,0:11:02.32,0:11:04.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi. Kami kembali.
Dialogue: 0,0:11:06.20,0:11:07.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau siapkan kudanya?
Dialogue: 0,0:11:07.79,0:11:10.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Kuda akan siap besok pagi.
Dialogue: 0,0:11:10.54,0:11:13.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi harus dengan pengangkut juga\Nsebagai pemandu.
Dialogue: 0,0:11:13.29,0:11:16.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemandu? Jadi, pengangkut kargo\Nyang memakai kuda?
Dialogue: 0,0:11:18.76,0:11:20.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teh, cepat!
Dialogue: 0,0:11:22.09,0:11:24.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan ambil air panas.
Dialogue: 0,0:11:24.01,0:11:25.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, tidak usah.
Dialogue: 0,0:11:25.60,0:11:26.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku suka suam-suam.
Dialogue: 0,0:11:30.68,0:11:32.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dengar soal pencuri.
Dialogue: 0,0:11:32.56,0:11:34.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, aku juga diberi tahu.
Dialogue: 0,0:11:35.06,0:11:37.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pencuri yang meminta semacam "biaya tol".
Dialogue: 0,0:11:37.65,0:11:41.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat bertemu mereka,\Njika pemandu kita bisa berunding,
Dialogue: 0,0:11:41.82,0:11:44.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita boleh pergi\Nsetelah memberikan sebagian kargo.
Dialogue: 0,0:11:44.53,0:11:49.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya mereka tak mau meminjamkan kuda\Nkecuali kita menyewa pemandu?
Dialogue: 0,0:11:49.08,0:11:49.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:11:51.08,0:11:53.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mereka berdua prajurit terlatih.{\i0}
Dialogue: 0,0:11:53.71,0:11:56.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Meski jabatan mereka\Nbiasanya tak menoleransi pencuri,{\i0}
Dialogue: 0,0:11:56.88,0:11:58.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}tak ada waktu bertarung.{\i0}
Dialogue: 0,0:12:02.38,0:12:05.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Semoga tak bertemu pencuri.{\i0}
Dialogue: 0,0:12:14.52,0:12:16.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sungguh terjadi?
Dialogue: 0,0:12:17.27,0:12:18.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ceritakan lagi, Nyonya Ah-Duo.
Dialogue: 0,0:12:18.90,0:12:21.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cerita tentang masa lalumu\Nyang tak kuketahui.
Dialogue: 0,0:12:21.69,0:12:23.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, tentu.
Dialogue: 0,0:12:23.57,0:12:25.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, kita istirahat dahulu.
Dialogue: 0,0:12:25.87,0:12:28.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tak lelah banyak mengobrol?
Dialogue: 0,0:12:28.37,0:12:30.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baik-baik saja.
Dialogue: 0,0:12:30.33,0:12:33.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak pernah menghabiskan waktu\Nsebanyak ini denganmu.
Dialogue: 0,0:12:33.75,0:12:36.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa bicara sepanjang hari.
Dialogue: 0,0:12:36.33,0:12:40.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu kita banyak. Jalan masih panjang.
Dialogue: 0,0:12:40.09,0:12:41.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun...
Dialogue: 0,0:12:41.21,0:12:44.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, bepergian akan selalu\Nmembuat lelah.
Dialogue: 0,0:12:45.30,0:12:47.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penting untuk beristirahat\Nkapan pun kita bisa.
Dialogue: 0,0:12:47.89,0:12:49.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:12:50.01,0:12:53.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, Nyonya Ah-Duo,\Nbisa kita lakukan seperti dahulu?
Dialogue: 0,0:13:07.87,0:13:10.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Seperti dahulu, ya?{\i0}
Dialogue: 0,0:13:10.45,0:13:12.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu sudah berapa lama?{\i0}
Dialogue: 0,0:13:20.67,0:13:22.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayolah.
Dialogue: 0,0:13:22.00,0:13:24.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau sudah lelah?
Dialogue: 0,0:13:26.63,0:13:28.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diam. Aku tahu yang kulakukan.
Dialogue: 0,0:13:28.64,0:13:30.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, kembali ke dayangmu.
Dialogue: 0,0:13:30.93,0:13:32.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka menangis.
Dialogue: 0,0:13:33.06,0:13:35.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau punya tugas penting. Selesaikan.
Dialogue: 0,0:13:37.69,0:13:40.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jarak kita hanya setahun.\NJangan perlakukan seperti bocah!
Dialogue: 0,0:13:42.07,0:13:43.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:13:44.90,0:13:46.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah sudah kau makan?
Dialogue: 0,0:13:47.07,0:13:48.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak perlu kau makan.
Dialogue: 0,0:14:00.58,0:14:03.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya, aku ingin\Nmemilih teman sendiri.
Dialogue: 0,0:14:03.80,0:14:05.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan konyol.
Dialogue: 0,0:14:05.21,0:14:08.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau diberi segalanya\Ndengan kualitas terbaik.
Dialogue: 0,0:14:08.93,0:14:11.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak boleh dapat yang rendahan.
Dialogue: 0,0:14:12.43,0:14:15.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika begitu, banyak orang akan menderita.
Dialogue: 0,0:14:16.39,0:14:18.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka lebih tua dari Ibu.
Dialogue: 0,0:14:18.89,0:14:22.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayolah, jangan katakan\Nhal yang sulit ditanggapi.
Dialogue: 0,0:14:22.65,0:14:24.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu, tetapi...
Dialogue: 0,0:14:25.28,0:14:26.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadilah dewasa.
Dialogue: 0,0:14:26.57,0:14:28.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mudah bagimu bicara.
Dialogue: 0,0:14:28.15,0:14:31.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika jadi aku, apa kau bisa\Nmenerima ini dengan tenang?
Dialogue: 0,0:14:31.82,0:14:32.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:14:38.50,0:14:39.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Sudah kuputuskan.
Dialogue: 0,0:14:39.92,0:14:40.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putuskan apa?
Dialogue: 0,0:14:45.21,0:14:46.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Temanku untuk malam ini.
Dialogue: 0,0:14:47.34,0:14:48.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:14:56.72,0:15:01.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Setelah itu, aku tak menyangka\Ndia akan menjadikanku selir Istana Timur.{\i0}
Dialogue: 0,0:15:16.12,0:15:21.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku sesekali bertemu anak itu\Ndan melihatnya tumbuh dewasa.{\i0}
Dialogue: 0,0:15:21.71,0:15:22.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Selain itu...{\i0}
Dialogue: 0,0:15:27.67,0:15:32.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}aku juga melindungi Selir Lishu\Nyang masih kecil dari kaisar pendahulu.{\i0}
Dialogue: 0,0:15:37.43,0:15:38.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang terjadi?
Dialogue: 0,0:15:38.35,0:15:40.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Nyonya Ah-Duo...\N- Para pencuri!
Dialogue: 0,0:15:40.73,0:15:42.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:15:46.32,0:15:48.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa akan segera tiba di pegunungan?{\i0}
Dialogue: 0,0:15:50.11,0:15:53.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika pencuri muncul,\Nakan ada di sekitar sini.
Dialogue: 0,0:15:53.49,0:15:56.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jalan antara dua gunung.
Dialogue: 0,0:15:56.58,0:15:58.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sempurna menyerang dari kedua sisi.
Dialogue: 0,0:15:58.49,0:16:02.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka juga tak bodoh,\Njadi, sebaiknya tak ada yang mati.
Dialogue: 0,0:16:02.46,0:16:05.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akan dibebaskan\Njika meninggalkan separuh kargo.
Dialogue: 0,0:16:07.25,0:16:10.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemungkinan bertemu mereka\Nhanya sekitar satu pertiga, jadi...
Dialogue: 0,0:16:10.97,0:16:12.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku paham.{\i0}
Dialogue: 0,0:16:12.59,0:16:16.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu frekuensi\Nyang dipertimbangkan pedagang.{\i0}
Dialogue: 0,0:16:16.10,0:16:18.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mereka tak diserang setiap kali,{\i0}
Dialogue: 0,0:16:18.26,0:16:20.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dan mengambil jalan memutar\Nmenambah biaya.{\i0}
Dialogue: 0,0:16:20.47,0:16:23.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anggap saja itu biaya tol yang agak mahal.
Dialogue: 0,0:16:23.77,0:16:26.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka menyebut diri mereka\N"pencuri keadilan".
Dialogue: 0,0:16:26.73,0:16:27.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pencuri keadilan?
Dialogue: 0,0:16:28.65,0:16:33.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jika pencuri benar-benar menyerang,\Nbisakah dia "tetap" seperti anjing baik?{\i0}
Dialogue: 0,0:16:37.74,0:16:41.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tuan Jinshi tampaknya menyukai kuda gurun.{\i0}
Dialogue: 0,0:16:41.45,0:16:43.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia meninggalkan kereta untuk naik kuda.{\i0}
Dialogue: 0,0:16:44.25,0:16:46.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Karena itu, Tuan Basen juga naik kuda.{\i0}
Dialogue: 0,0:16:47.42,0:16:51.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Berarti aku bisa menguasai\Nkereta yang luas ini.{\i0}
Dialogue: 0,0:16:51.51,0:16:54.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Duduk terlalu lama membuat bokongku sakit.{\i0}
Dialogue: 0,0:16:54.47,0:16:56.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kurasa aku akan berbaring.{\i0}
Dialogue: 0,0:16:57.47,0:17:01.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pencuri mungkin tak akan muncul,\Njadi, tak perlu cemas.
Dialogue: 0,0:17:02.06,0:17:03.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saatnya tidur siang.
Dialogue: 0,0:17:15.45,0:17:17.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:17:17.07,0:17:19.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya pencuri muncul
Dialogue: 0,0:17:19.70,0:17:22.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan menyerang kereta lain\Nyang lewat di depan kita.
Dialogue: 0,0:17:23.33,0:17:25.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya kita menunggu.
Dialogue: 0,0:17:25.41,0:17:27.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Intinya, jika menunggu di sini,{\i0}
Dialogue: 0,0:17:27.25,0:17:29.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}akan bisa lewat tanpa terluka?{\i0}
Dialogue: 0,0:17:32.84,0:17:34.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Apa itu?
Dialogue: 0,0:17:35.80,0:17:36.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jalan!
Dialogue: 0,0:17:36.93,0:17:37.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:17:42.56,0:17:43.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidur siang.
Dialogue: 0,0:17:43.85,0:17:45.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudmu?
Dialogue: 0,0:17:45.27,0:17:47.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada tanda aneh di pipimu.
Dialogue: 0,0:17:49.98,0:17:52.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang terjadi di sini?
Dialogue: 0,0:17:54.69,0:17:56.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Desain ini...
Dialogue: 0,0:17:56.03,0:17:56.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:17:57.53,0:18:00.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kereta Ah-Duo diserang.
Dialogue: 0,0:18:00.53,0:18:03.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedang apa Nyonya Ah-Duo di sini?
Dialogue: 0,0:18:03.20,0:18:08.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun, aku yakin Nyonya Ah-Duo bisa\Nmembujuk mereka mengambil barang berharga.{\i0}
Dialogue: 0,0:18:08.21,0:18:10.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selir Lishu bersamanya.
Dialogue: 0,0:18:10.67,0:18:11.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:18:11.59,0:18:14.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Entah kenapa, kecemasanku meningkat.{\i0}
Dialogue: 0,0:18:14.21,0:18:16.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Selir itu anehnya\Nrentan mengalami bencana.{\i0}
Dialogue: 0,0:18:16.63,0:18:20.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa mereka akan baik-baik saja\Ndengan sedikit pengawal?
Dialogue: 0,0:18:20.18,0:18:23.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika ada apa-apa, Basen saja sudah cukup.
Dialogue: 0,0:18:41.91,0:18:45.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Seberapa banyak perlawanan mereka\Nsampai banyak tulang patah?{\i0}
Dialogue: 0,0:18:48.46,0:18:49.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa itu?{\i0}
Dialogue: 0,0:18:50.46,0:18:51.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan...
Dialogue: 0,0:18:52.92,0:18:55.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bilang uang akan cukup bagi mereka!
Dialogue: 0,0:18:56.51,0:18:59.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku siap menawarkan kargo kami,
Dialogue: 0,0:18:59.34,0:19:01.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tetapi mereka ingin menjual gadis ini.
Dialogue: 0,0:19:01.84,0:19:04.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia di bawah pengawasanku,\Njadi, itu tak bisa kubiarkan.
Dialogue: 0,0:19:04.89,0:19:08.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak. Ini pasti salah paham.
Dialogue: 0,0:19:08.23,0:19:10.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah bagaimana jadi begini...
Dialogue: 0,0:19:18.78,0:19:20.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi.
Dialogue: 0,0:19:21.16,0:19:23.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ujung yang putus hancur.{\i0}
Dialogue: 0,0:19:23.91,0:19:28.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jika putus dengan lebih bersih,\Nayahku bisa memasangnya lagi.{\i0}
Dialogue: 0,0:19:28.54,0:19:30.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun, aku tak punya keahlian itu.{\i0}
Dialogue: 0,0:19:30.54,0:19:33.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jika dipaksakan,\Nlengannya akan membusuk dan terlepas.{\i0}
Dialogue: 0,0:19:34.04,0:19:35.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kulakukan sebisaku saat ini.{\i0}
Dialogue: 0,0:19:41.55,0:19:43.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gunakan ini.
Dialogue: 0,0:19:43.80,0:19:46.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Butuh waktu lama\Nmengobati korban cedera di sana.
Dialogue: 0,0:19:47.22,0:19:48.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau juga ikut dengan mereka?
Dialogue: 0,0:19:49.52,0:19:53.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, aku ragu\Ndiizinkan meninggalkan istana itu.
Dialogue: 0,0:19:54.23,0:19:56.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia juga di sini.{\i0}
Dialogue: 0,0:19:56.23,0:19:58.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa yang terjadi di Ibu Kota Barat?{\i0}
Dialogue: 0,0:20:01.32,0:20:02.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pandai menjahit?
Dialogue: 0,0:20:02.78,0:20:04.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya dasarnya.
Dialogue: 0,0:20:04.70,0:20:07.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, maaf, tak ada obat bius.
Dialogue: 0,0:20:10.00,0:20:11.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tahanlah rasa sakitnya.
Dialogue: 0,0:20:25.39,0:20:28.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tampaknya, perampokan itu\Nsalah perhitungan.{\i0}
Dialogue: 0,0:20:29.39,0:20:34.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mereka berpura-pura jadi rombongan\Nanak kaya dikirim ke jabatan di provinsi,{\i0}
Dialogue: 0,0:20:34.77,0:20:37.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}tetapi rupanya para pencuri sadar\Nbetapa pentingnya mereka.{\i0}
Dialogue: 0,0:20:37.77,0:20:40.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dengan kelompok ini,\Napa yang bisa diharapkan?{\i0}
Dialogue: 0,0:20:44.40,0:20:45.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi.
Dialogue: 0,0:20:45.82,0:20:47.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, masuklah.
Dialogue: 0,0:20:49.83,0:20:52.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku diminta berbicara langsung denganmu.
Dialogue: 0,0:20:54.92,0:20:57.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kenapa Nyonya Lishu ada di sini?{\i0}
Dialogue: 0,0:20:57.88,0:21:00.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Selir tak boleh meninggalkan istana harem.{\i0}
Dialogue: 0,0:21:01.63,0:21:04.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Belum lagi Suirei.{\i0}
Dialogue: 0,0:21:04.34,0:21:06.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Melihat bakatnya,{\i0}
Dialogue: 0,0:21:06.01,0:21:09.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}aku paham kenapa dia dibawa\Nsebagai dokter sementara.{\i0}
Dialogue: 0,0:21:09.89,0:21:13.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Meski begitu, ini jelas agak bermasalah.{\i0}
Dialogue: 0,0:21:13.93,0:21:16.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Kenapa selir ada di sini?"
Dialogue: 0,0:21:16.73,0:21:18.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu pertanyaanmu, bukan?
Dialogue: 0,0:21:18.27,0:21:19.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:21:19.69,0:21:22.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau sudah dengar\Nalasan Basen menuju ke Barat?
Dialogue: 0,0:21:23.78,0:21:28.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Karena Tuan Jinshi sedang menyamar,\Ndia menggunakan nama Basen.{\i0}
Dialogue: 0,0:21:28.70,0:21:31.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Nyonya Ah-Duo, selalu bijaksana.{\i0}
Dialogue: 0,0:21:31.08,0:21:33.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dengar ada pertemuan di Barat.
Dialogue: 0,0:21:33.66,0:21:37.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Basen menghadirinya\Nbersama pejabat pemerintah lain.
Dialogue: 0,0:21:37.54,0:21:39.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami juga akan hadir.
Dialogue: 0,0:21:40.04,0:21:42.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan selir yang ikut,
Dialogue: 0,0:21:42.09,0:21:44.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami menghindari bepergian\Ndalam kelompok besar.
Dialogue: 0,0:21:44.51,0:21:48.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau lebih tepatnya,\Nkami dianggap mengganggu.
Dialogue: 0,0:21:49.51,0:21:51.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia memberi petunjuk akan sesuatu.{\i0}
Dialogue: 0,0:21:51.93,0:21:56.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Entah kenapa mereka butuh Nyonya Lishu\Ndi pertemuan di Barat.{\i0}
Dialogue: 0,0:21:57.31,0:21:59.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jika Permaisuri Gyokuyou, yang dari Barat,{\i0}
Dialogue: 0,0:21:59.52,0:22:02.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}atau Selir Lihua, kerabat Kaisar,\Naku akan paham.{\i0}
Dialogue: 0,0:22:05.61,0:22:09.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, ini juga soal memilih istri.
Dialogue: 0,0:22:09.91,0:22:11.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Istri?
Dialogue: 0,0:22:11.70,0:22:12.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:22:12.91,0:22:15.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk adik Kaisar.
Dialogue: 0,0:23:54.55,0:23:58.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Episode selanjutnya, "Masalah Menumpuk".{\i0}
Dialogue: 0,0:23:58.14,0:24:00.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Terjemahan subtitle oleh Amalia Puspita
