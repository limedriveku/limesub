Dialogue: 0,0:01:32.00,0:01:33.50,sign,,0000,0000,0000,,{\an8}KISAH INI FIKSI, SEMUA NAMA TOKOH\NDAN ORGANISASINYA JUGA FIKTIF.
Dialogue: 0,0:01:33.51,0:01:34.42,sign,,0000,0000,0000,,{\an8}SELAIN ITU, KISAH INI TAK ADA HUBUNGANNYA\NDENGAN INSIDEN ATAU PERISTIWA NYATA.
Dialogue: 0,0:08:41.68,0:08:42.60,sign,,0000,0000,0000,,ISTRI
Dialogue: 0,0:08:45.65,0:08:46.56,sign,,0000,0000,0000,,SUAMI
Dialogue: 0,0:23:46.09,0:23:48.63,sign,,0000,0000,0000,,CUPLIKAN EPISODE SELANJUTNYA
Dialogue: 0,0:01:34.42,0:01:36.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Sesuai perintah Tuan Jinshi,{\i0}
Dialogue: 0,0:01:36.22,0:01:39.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}aku menemani tabib pulang ke rumahnya.{\i0}
Dialogue: 0,0:01:40.22,0:01:42.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun, Tuan Jinshi menyamar.{\i0}
Dialogue: 0,0:01:42.35,0:01:44.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa ada sesuatu di desa ini?{\i0}
Dialogue: 0,0:01:46.18,0:01:47.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebentar.
Dialogue: 0,0:01:57.49,0:01:59.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa kau bisa bicara di sini.
Dialogue: 0,0:01:59.66,0:02:01.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamar lain jauh.
Dialogue: 0,0:02:02.20,0:02:03.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau baru mandi?
Dialogue: 0,0:02:03.87,0:02:05.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya mencuci rambut.
Dialogue: 0,0:02:05.58,0:02:08.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf jika penampilanku tidak menyenangkan.
Dialogue: 0,0:02:09.21,0:02:10.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kenapa dia kemari?{\i0}
Dialogue: 0,0:02:11.67,0:02:14.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bisa menata ulang riasan ini?
Dialogue: 0,0:02:14.96,0:02:16.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin bisa.
Dialogue: 0,0:02:16.55,0:02:18.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika ada alatnya.
Dialogue: 0,0:02:18.13,0:02:19.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, tolong.
Dialogue: 0,0:02:25.43,0:02:27.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kusiapkan air panas yang baru.
Dialogue: 0,0:02:27.93,0:02:30.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu terlalu merepotkan. Ini saja.
Dialogue: 0,0:02:31.94,0:02:35.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Setelah mencuci rambut,\Nkurendam kakiku di air...{\i0}
Dialogue: 0,0:02:35.44,0:02:36.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:02:36.86,0:02:38.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.
Dialogue: 0,0:02:38.74,0:02:40.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jika dia sungguh tak keberatan,{\i0}
Dialogue: 0,0:02:40.66,0:02:42.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}aku akan tutup mulut.{\i0}
Dialogue: 0,0:02:53.04,0:02:55.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bekas luka akan memudar seiring waktu,{\i0}
Dialogue: 0,0:02:56.59,0:02:58.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}tetapi tak akan hilang sepenuhnya.{\i0}
Dialogue: 0,0:02:59.55,0:03:01.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, Tuan Jinshi...
Dialogue: 0,0:03:01.55,0:03:02.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:03:02.80,0:03:06.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau kemari\Nmengunjungi keluarga tabib kerajaan?
Dialogue: 0,0:03:07.10,0:03:08.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya lewat.
Dialogue: 0,0:03:08.93,0:03:10.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, ada yang menarik perhatianku.
Dialogue: 0,0:03:10.81,0:03:12.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Hanya lewat?{\i0}
Dialogue: 0,0:03:12.65,0:03:15.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang menarik perhatianmu?
Dialogue: 0,0:03:15.61,0:03:19.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepupumu itu menyuarakan kekhawatirannya\Ndan telah menghitung.
Dialogue: 0,0:03:20.74,0:03:22.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Lahan khawatir?{\i0}
Dialogue: 0,0:03:22.70,0:03:27.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Pengiriman beras dari wilayah ini\Ntidak biasa selama beberapa tahun.
Dialogue: 0,0:03:27.33,0:03:31.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mengingat obsesi besar Lahan\Nterhadap angka,{\i0}
Dialogue: 0,0:03:31.12,0:03:33.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}ini memang perlu diselidiki.{\i0}
Dialogue: 0,0:03:34.50,0:03:38.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, aku tak menyangka\Nmendengar kisah seperti itu...
Dialogue: 0,0:03:39.09,0:03:43.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tuan tanah saat ini\Ningin mengusir para perajin{\i0}
Dialogue: 0,0:03:43.43,0:03:46.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dan menyuruh anak buahnya\Nmengambil alih pembuatan kertas.{\i0}
Dialogue: 0,0:03:49.22,0:03:53.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pembuatan kertas adalah industri penting\Nyang layak mendapat investasi masa depan.
Dialogue: 0,0:03:54.15,0:03:56.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak bisa membiarkan\Nperajin digantikan oleh amatir.
Dialogue: 0,0:03:57.36,0:03:59.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sungguh menyebalkan.{\i0}
Dialogue: 0,0:03:59.57,0:04:01.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau pakai riasan luka bakar sekarang?
Dialogue: 0,0:04:01.74,0:04:03.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau besok pagi?
Dialogue: 0,0:04:03.91,0:04:05.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang saja.
Dialogue: 0,0:04:05.62,0:04:09.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jika kubiarkan dia keluar seperti ini,\Nsemua akan kacau.{\i0}
Dialogue: 0,0:04:11.70,0:04:14.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Basen tak mau melakukannya untukmu?
Dialogue: 0,0:04:14.29,0:04:16.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tak bisa melakukannya.
Dialogue: 0,0:04:17.13,0:04:20.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sebabnya kau mengajakku?
Dialogue: 0,0:04:20.00,0:04:21.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bukan satu-satunya alasan.
Dialogue: 0,0:04:30.18,0:04:32.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong jangan tidur.
Dialogue: 0,0:04:32.02,0:04:34.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan panggil Tuan Basen\Nsebelum kau tidur.
Dialogue: 0,0:04:34.52,0:04:37.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau panggil, apa dia akan membantu?
Dialogue: 0,0:04:37.90,0:04:39.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mungkin tidak.{\i0}
Dialogue: 0,0:04:39.52,0:04:43.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tidak seperti ayahnya, Tuan Gaoshun,\Ndia masih harus banyak belajar.{\i0}
Dialogue: 0,0:04:43.78,0:04:45.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau jadikan Tuan Basen ajudanmu?
Dialogue: 0,0:04:47.74,0:04:51.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin tak terlihat, tetapi...
Dialogue: 0,0:04:51.12,0:04:54.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di saat penting, dia bisa... kau tahu.
Dialogue: 0,0:04:54.25,0:04:55.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sangat tidak jelas.
Dialogue: 0,0:04:57.50,0:05:01.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jika dia bisa menemani Tuan Jinshi\Ntanpa menyebabkan masalah,{\i0}
Dialogue: 0,0:05:01.55,0:05:03.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}mungkin dia punya potensi.{\i0}
Dialogue: 0,0:05:05.63,0:05:07.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Baik, sudah selesai.{\i0}
Dialogue: 0,0:05:21.86,0:05:23.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selesai?
Dialogue: 0,0:05:26.61,0:05:27.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jelek sekali.
Dialogue: 0,0:05:32.91,0:05:34.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan...
Dialogue: 0,0:05:34.37,0:05:38.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Menyuruhku berhenti\Nmembuatku makin ingin melakukannya.{\i0}
Dialogue: 0,0:05:39.79,0:05:41.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku masuk.
Dialogue: 0,0:05:41.17,0:05:42.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cukup...
Dialogue: 0,0:05:57.85,0:06:00.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kami tak pernah sekompak ini...{\i0}
Dialogue: 0,0:06:13.53,0:06:16.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pertemuan ini...{\i0}
Dialogue: 0,0:06:16.87,0:06:19.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu tuan tanah di tengah?{\i0}
Dialogue: 0,0:06:23.67,0:06:25.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau juga harus ikut?
Dialogue: 0,0:06:25.92,0:06:28.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tabib kerajaan mengajakku.
Dialogue: 0,0:06:28.26,0:06:30.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak bisa membiarkannya sendiri.
Dialogue: 0,0:06:31.14,0:06:33.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, jangan bicara seperti itu...
Dialogue: 0,0:06:36.18,0:06:39.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetap saja, ada banyak alkohol\Ndi kedai sebesar ini.
Dialogue: 0,0:06:40.23,0:06:44.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Produk utama mereka\Nadalah arak keruh di rak itu.{\i0}
Dialogue: 0,0:06:44.27,0:06:47.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Guci besar di belakang berisi arak bening.{\i0}
Dialogue: 0,0:06:47.82,0:06:51.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Di ibu kota, orang lebih suka\Narak bening dan miras sulingan.{\i0}
Dialogue: 0,0:06:51.86,0:06:55.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kurasa pelanggan lokal meminum arak keruh.{\i0}
Dialogue: 0,0:06:55.79,0:06:58.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau bawa uangnya?
Dialogue: 0,0:06:58.29,0:07:00.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kami jelas kalah jumlah.{\i0}
Dialogue: 0,0:07:00.87,0:07:03.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jika ada perkelahian, kami lari ke mana?{\i0}
Dialogue: 0,0:07:03.00,0:07:05.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenggat waktu belum lewat.
Dialogue: 0,0:07:05.09,0:07:08.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika tak bisa bayar,\Naku akan mengusir kalian dari sini.
Dialogue: 0,0:07:08.30,0:07:10.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa kau pertimbangkan lagi?
Dialogue: 0,0:07:10.97,0:07:13.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu kontraknya?{\i0}
Dialogue: 0,0:07:13.47,0:07:16.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti kataku,\Nakan kutunggu sampai tahun depan.
Dialogue: 0,0:07:17.27,0:07:20.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sementara itu, kau bisa mengajari kami.
Dialogue: 0,0:07:21.23,0:07:22.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ini kacau.{\i0}
Dialogue: 0,0:07:22.90,0:07:25.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jika keluarga tabib\Ndapat kelonggaran waktu{\i0}
Dialogue: 0,0:07:25.11,0:07:27.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dan mengajarkan pembuatan kertas,{\i0}
Dialogue: 0,0:07:27.48,0:07:29.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}pengetahuan mereka akan dicuri.{\i0}
Dialogue: 0,0:07:30.53,0:07:33.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tuan tanah ingin mengambil alih\Nstatus sebagai pemasok istana,{\i0}
Dialogue: 0,0:07:33.87,0:07:35.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}mengusir para perajin,{\i0}
Dialogue: 0,0:07:35.66,0:07:37.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dan menggantikannya dengan anak buahnya.{\i0}
Dialogue: 0,0:07:38.41,0:07:41.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun, kenapa repot-repot begitu?{\i0}
Dialogue: 0,0:07:41.41,0:07:44.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia bisa jadikan utang alasan\Nagar mereka bekerja sebagai buruh.{\i0}
Dialogue: 0,0:07:44.50,0:07:46.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa dia begitu membenci orang luar?{\i0}
Dialogue: 0,0:07:54.80,0:07:56.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei!
Dialogue: 0,0:07:59.18,0:08:03.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Seharusnya lebih dari sepuluh tahun,\Ntetapi kualitas kertas ini bagus.{\i0}
Dialogue: 0,0:08:04.31,0:08:07.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kertas berkualitas buruk\Npasti sudah lama hancur.{\i0}
Dialogue: 0,0:08:07.94,0:08:10.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tampaknya menentukan\Nmasa pembayaran 20 tahun{\i0}
Dialogue: 0,0:08:10.28,0:08:13.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dan jumlah angsuran tiap bulan.{\i0}
Dialogue: 0,0:08:13.95,0:08:16.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dengan kontrak kuat seperti ini,{\i0}
Dialogue: 0,0:08:16.41,0:08:17.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}kenapa mereka memperebutkannya?{\i0}
Dialogue: 0,0:08:18.49,0:08:21.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rupanya, kontraknya tidak sah.
Dialogue: 0,0:08:21.20,0:08:22.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski sudah ditandatangani?
Dialogue: 0,0:08:23.16,0:08:25.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Huaya{\i0} itu berarti tanda tangan, bukan?
Dialogue: 0,0:08:26.25,0:08:27.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar,
Dialogue: 0,0:08:27.96,0:08:31.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tetapi tuan tanah sebelumnya\Ntak bisa membaca.
Dialogue: 0,0:08:31.09,0:08:34.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tuan tanah biasanya\Npunya banyak dokumen untuk dibaca.{\i0}
Dialogue: 0,0:08:34.47,0:08:37.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Setidaknya pasti bisa membaca dan menulis.{\i0}
Dialogue: 0,0:08:37.51,0:08:39.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena dia menantu keluarga itu...
Dialogue: 0,0:08:39.68,0:08:41.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu sebabnya.{\i0}
Dialogue: 0,0:08:42.60,0:08:45.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jika petani penyewa pekerja keras\Nmerupakan menantu...{\i0}
Dialogue: 0,0:08:46.56,0:08:48.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}...dia mungkin tak sempat belajar.{\i0}
Dialogue: 0,0:08:48.27,0:08:50.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Istrinya biasa menangani hal-hal ini.
Dialogue: 0,0:08:50.65,0:08:52.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, setelah istrinya meninggal,
Dialogue: 0,0:08:52.57,0:08:56.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia meminta juru tulis\Nuntuk menyusun kontrak.
Dialogue: 0,0:08:58.03,0:09:01.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ada yang menyaksikan\Npenandatanganan kontraknya?
Dialogue: 0,0:09:01.16,0:09:02.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana dengan juru tulis itu?
Dialogue: 0,0:09:02.79,0:09:06.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Juru tulis dan saksi telah meninggal.{\i0}
Dialogue: 0,0:09:06.58,0:09:09.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mereka sudah tua\Nsaat penandatanganan 15 tahun lalu.{\i0}
Dialogue: 0,0:09:09.84,0:09:12.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ini benar-benar kacau.{\i0}
Dialogue: 0,0:09:12.80,0:09:16.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika tak mau pergi sekarang,\Nkurasa aku tak punya pilihan.
Dialogue: 0,0:09:16.68,0:09:18.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kukirim anak buahku.
Dialogue: 0,0:09:18.59,0:09:21.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ajari mereka keahlianmu\Nsebelum akhir tahun.
Dialogue: 0,0:09:22.68,0:09:26.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah! Sudah beres,\Nsekarang keluarkan miras!
Dialogue: 0,0:09:26.35,0:09:27.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arak untuk semuanya!
Dialogue: 0,0:09:33.40,0:09:34.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa?{\i0}
Dialogue: 0,0:09:36.90,0:09:39.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ini bukan arak keruh. Ini arak bening.{\i0}
Dialogue: 0,0:09:45.96,0:09:48.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Miras sulingan untuk tuan tanah, ya?{\i0}
Dialogue: 0,0:09:48.46,0:09:50.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tampaknya dia sangat kuat minum.{\i0}
Dialogue: 0,0:09:51.46,0:09:52.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tetap saja,{\i0}
Dialogue: 0,0:09:52.84,0:09:55.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}memesan arak bening\Nuntuk semua orang di sini?{\i0}
Dialogue: 0,0:09:55.67,0:09:57.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu cukup murah hati.{\i0}
Dialogue: 0,0:09:57.59,0:10:00.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Meskipun ada pilihan yang lebih murah.{\i0}
Dialogue: 0,0:10:01.30,0:10:02.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi, Bu.
Dialogue: 0,0:10:02.47,0:10:03.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya?
Dialogue: 0,0:10:03.39,0:10:06.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau arak yang sama.
Dialogue: 0,0:10:07.85,0:10:10.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kurasa Tuan Jinshi juga sadar.{\i0}
Dialogue: 0,0:10:16.49,0:10:19.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ada rasa manis yang menyenangkan.{\i0}
Dialogue: 0,0:10:19.07,0:10:22.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tak seenak minuman di ibu kota,\Ntetapi tak buruk.{\i0}
Dialogue: 0,0:10:22.53,0:10:26.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun, alkoholnya kuat\Nmeski rasanya lembut.{\i0}
Dialogue: 0,0:10:26.95,0:10:28.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi.
Dialogue: 0,0:10:28.08,0:10:30.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ada pabrik bir di dekat sini?
Dialogue: 0,0:10:30.83,0:10:34.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, kurasa tak ada\Nyang seperti itu di sekitar sini.
Dialogue: 0,0:10:34.55,0:10:35.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga.
Dialogue: 0,0:10:37.09,0:10:41.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pengiriman beras dari wilayah ini\Ntidak biasa selama beberapa tahun.{\i0}
Dialogue: 0,0:10:49.77,0:10:52.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang bisa kubantu, Nona?
Dialogue: 0,0:10:52.27,0:10:54.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau menuangkan minuman untukku?
Dialogue: 0,0:10:55.19,0:10:57.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona! Apa yang kau lakukan?
Dialogue: 0,0:11:03.16,0:11:05.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau mau lomba minum?
Dialogue: 0,0:11:10.04,0:11:13.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lomba minum?\NKau punya nyali, itu sudah pasti.
Dialogue: 0,0:11:19.17,0:11:21.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Berapa sisa utangmu?
Dialogue: 0,0:11:22.97,0:11:25.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Seribu perak per tahun,
Dialogue: 0,0:11:25.14,0:11:27.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}dan sudah kubayar setengah tahun ini.
Dialogue: 0,0:11:27.26,0:11:30.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Dengan sisa empat tahun,\Nberarti totalnya 4.500.
Dialogue: 0,0:11:30.10,0:11:30.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Begitukah?
Dialogue: 0,0:11:34.48,0:11:37.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, sekalian saja bertaruh.
Dialogue: 0,0:11:37.02,0:11:38.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kedengarannya seru.
Dialogue: 0,0:11:38.44,0:11:40.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang dipertaruhkan?
Dialogue: 0,0:11:40.24,0:11:41.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini, lihatlah.
Dialogue: 0,0:11:43.53,0:11:46.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jual aku ke muncikari,\Ndan aku mau 300 perak.
Dialogue: 0,0:11:50.91,0:11:54.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Muda, apa kau tahu\Nberapa harga pasar?
Dialogue: 0,0:11:54.63,0:11:55.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tentu aku tahu.{\i0}
Dialogue: 0,0:11:55.84,0:11:59.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Menurutmu berapa gadis\Nyang kulihat terjual?{\i0}
Dialogue: 0,0:11:59.59,0:12:02.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis tercantik pun tak akan dapat 100.
Dialogue: 0,0:12:02.51,0:12:04.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pikir hargamu 300?
Dialogue: 0,0:12:09.64,0:12:13.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Jika kau beri lobak\Nyang masih berlumuran tanah,
Dialogue: 0,0:12:13.31,0:12:16.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}jelas tak akan dapat 50 perak.
Dialogue: 0,0:12:16.36,0:12:18.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kau bahkan tak tahu itu?
Dialogue: 0,0:12:18.94,0:12:20.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:12:24.61,0:12:29.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tampaknya dia paham.\NLobak adalah metafora untuk gadis desa.{\i0}
Dialogue: 0,0:12:29.79,0:12:31.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katakan lagi, kutantang kau!
Dialogue: 0,0:12:31.75,0:12:36.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Jika tak bisa membaca atau menulis,\Nkau tak akan pernah menggunakan kertas.
Dialogue: 0,0:12:36.38,0:12:39.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Meski diajari,\Naku ragu kau bisa membuat kertas bagus.
Dialogue: 0,0:12:40.59,0:12:42.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar kau...
Dialogue: 0,0:12:50.26,0:12:54.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis ini seharga 300 perak?\NItu murah sekali.
Dialogue: 0,0:12:54.64,0:12:58.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Meski aku berharap\Ndia tak memamerkan semua uang itu,{\i0}
Dialogue: 0,0:12:58.44,0:12:59.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}saat ini, harus kuikuti.{\i0}
Dialogue: 0,0:13:02.78,0:13:05.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat? Siapa pun yang paham bisa tahu.
Dialogue: 0,0:13:06.95,0:13:10.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo! Kita buat mereka sadar diri!
Dialogue: 0,0:13:11.70,0:13:13.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa yang menyuruhmu?
Dialogue: 0,0:13:14.66,0:13:16.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, biarkan saja.
Dialogue: 0,0:13:16.33,0:13:18.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama kau punya uang untuk dipertaruhkan.
Dialogue: 0,0:13:19.75,0:13:21.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia memakan umpannya.{\i0}
Dialogue: 0,0:13:25.22,0:13:28.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, siapa yang mau lebih dahulu?
Dialogue: 0,0:13:33.06,0:13:35.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan melawanmu lebih dahulu.
Dialogue: 0,0:13:36.02,0:13:38.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Baiklah. Mari kita mulai.
Dialogue: 0,0:13:51.49,0:13:52.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin.
Dialogue: 0,0:13:53.66,0:13:55.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah selesai?
Dialogue: 0,0:13:56.66,0:13:58.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sungguh miras sulingan, bukan?
Dialogue: 0,0:14:01.09,0:14:06.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mengeluarkan alkohol yang lebih kuat\Nuntuk menghabisiku adalah kesalahan.{\i0}
Dialogue: 0,0:14:06.05,0:14:07.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku sudah terbiasa dengan ini.{\i0}
Dialogue: 0,0:14:09.09,0:14:12.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharga 300? Tidak buruk.
Dialogue: 0,0:14:12.30,0:14:16.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Membayangkan dia membeliku lagi\Nhanya membuatku haus akan kemenangan.{\i0}
Dialogue: 0,0:14:17.85,0:14:19.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Empat orang tumbang.{\i0}
Dialogue: 0,0:14:19.73,0:14:23.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jika 300 untuk satu orang,\Nbisa digandakan menjadi 600.{\i0}
Dialogue: 0,0:14:23.52,0:14:26.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Digandakan lagi menjadi 1.200, lalu 2.400.{\i0}
Dialogue: 0,0:14:26.65,0:14:31.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sisa utangnya 4.500.\NJadi, aku harus menang sekali lagi.{\i0}
Dialogue: 0,0:14:31.74,0:14:35.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Untuk berjaga-jaga, kuminta mereka membuat\Nperjanjian dan surat sanggup bayar.{\i0}
Dialogue: 0,0:14:38.37,0:14:39.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan melawanmu.
Dialogue: 0,0:14:40.54,0:14:42.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bisakah kulawan?{\i0}
Dialogue: 0,0:14:42.25,0:14:45.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Setelah empat lawan berturut-turut,\Nbahkan aku mulai merasakannya.{\i0}
Dialogue: 0,0:14:46.55,0:14:48.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan anggap aku akan tumbang\Nseperti mereka.
Dialogue: 0,0:14:51.01,0:14:53.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan pelit, Anak Muda.
Dialogue: 0,0:14:58.27,0:15:00.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei! Apa yang kau lakukan?
Dialogue: 0,0:15:00.39,0:15:02.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya ingin mengubah rasanya.
Dialogue: 0,0:15:06.40,0:15:09.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu. Berikan itu padaku juga.
Dialogue: 0,0:15:13.70,0:15:14.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan.
Dialogue: 0,0:15:16.58,0:15:20.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bukan obat\Nuntuk mencegah mabuk, bukan?
Dialogue: 0,0:15:43.10,0:15:43.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan!
Dialogue: 0,0:15:45.23,0:15:47.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei! Kau beri apa ke minumannya?
Dialogue: 0,0:15:47.69,0:15:51.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak kuberi apa-apa. Aku juga minum itu.
Dialogue: 0,0:15:51.95,0:15:53.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau juga lihat, bukan?
Dialogue: 0,0:15:54.24,0:15:55.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun...
Dialogue: 0,0:15:55.41,0:15:57.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya aku menang taruhan.
Dialogue: 0,0:16:02.46,0:16:04.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di mana toiletnya?
Dialogue: 0,0:16:04.83,0:16:06.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di luar sana, sebelah kanan.
Dialogue: 0,0:16:06.59,0:16:07.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:16:20.85,0:16:23.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kau lakukan?
Dialogue: 0,0:16:23.31,0:16:24.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan apa-apa.
Dialogue: 0,0:16:24.52,0:16:26.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin mengubah rasanya,
Dialogue: 0,0:16:26.73,0:16:28.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi, kutambahkan alkohol.
Dialogue: 0,0:16:29.65,0:16:31.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Untuk berjaga-jaga,{\i0}
Dialogue: 0,0:16:31.32,0:16:34.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}aku selalu membawa alkohol disinfektan.{\i0}
Dialogue: 0,0:16:34.07,0:16:36.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Karena lebih kuat dari alkohol biasa,{\i0}
Dialogue: 0,0:16:36.57,0:16:38.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}itu membuat orang normal pingsan.{\i0}
Dialogue: 0,0:16:39.20,0:16:40.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh aku bertanya?
Dialogue: 0,0:16:41.00,0:16:42.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu, apa?
Dialogue: 0,0:16:42.20,0:16:46.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tambahkan juga campuran alkohol\Nyang sama ke minumanmu, bukan?
Dialogue: 0,0:16:46.79,0:16:49.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bukan masalah bagiku.
Dialogue: 0,0:16:49.09,0:16:51.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya ingin mempercepat semuanya.
Dialogue: 0,0:16:54.55,0:16:56.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang bisa ke toilet.
Dialogue: 0,0:16:58.05,0:16:59.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seyakin apa pun dirimu,
Dialogue: 0,0:16:59.85,0:17:03.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kurasa tidak bagus\Nbertaruh dengan tubuhmu.
Dialogue: 0,0:17:03.52,0:17:05.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terutama demi kami.
Dialogue: 0,0:17:07.27,0:17:09.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Apa kau salah paham?
Dialogue: 0,0:17:10.77,0:17:12.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Ini bagianku.
Dialogue: 0,0:17:13.69,0:17:17.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Astaga, Nona!\NJangan bicara dengan begitu tega...
Dialogue: 0,0:17:17.78,0:17:20.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Tunggu!
Dialogue: 0,0:17:20.03,0:17:22.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kau harus istirahat lebih lama.
Dialogue: 0,0:17:22.24,0:17:23.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Taruhan itu tak berlaku!
Dialogue: 0,0:17:24.46,0:17:26.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Ini kontraknya.
Dialogue: 0,0:17:26.42,0:17:28.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Surat sanggup bayar, tulis tangan.
Dialogue: 0,0:17:28.21,0:17:30.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bilang kau tak bisa membaca.
Dialogue: 0,0:17:30.21,0:17:32.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak peduli soal itu!
Dialogue: 0,0:17:32.30,0:17:34.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini hanya permainan minum!
Dialogue: 0,0:17:34.47,0:17:35.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taruhan batal!
Dialogue: 0,0:17:35.67,0:17:37.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku tak punya pilihan.
Dialogue: 0,0:17:38.39,0:17:43.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus laporkan ke pejabat pemerintah\Nbahwa kau menggelapkan pajak.
Dialogue: 0,0:17:51.19,0:17:53.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menggelapkan pajak?
Dialogue: 0,0:17:53.40,0:17:55.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudmu?
Dialogue: 0,0:17:55.07,0:17:58.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Butuh izin pemerintah\Nuntuk memproduksi alkohol.
Dialogue: 0,0:17:58.28,0:18:00.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Membuat alkohol itu lain cerita,
Dialogue: 0,0:18:00.07,0:18:04.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}tetapi menjualnya secara grosir ke kedai\Njelas terkena pajak alkohol.
Dialogue: 0,0:18:04.79,0:18:06.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kenapa kedai ini{\i0}
Dialogue: 0,0:18:06.21,0:18:08.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}menyediakan tempat\Nuntuk pertemuan tuan tanah?{\i0}
Dialogue: 0,0:18:08.79,0:18:10.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu keraguanku.{\i0}
Dialogue: 0,0:18:10.75,0:18:15.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kedai mana pun akan dapat untung\Ndari pasokan besar alkohol murah dan enak.{\i0}
Dialogue: 0,0:18:15.80,0:18:17.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jika diminta pemasok,{\i0}
Dialogue: 0,0:18:17.84,0:18:20.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}mereka akan meminjamkan kedai,\Nmeski itu merepotkan.{\i0}
Dialogue: 0,0:18:21.51,0:18:25.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jika tuan tanah memanfaatkan petaninya\Nuntuk membuat arak keruh,{\i0}
Dialogue: 0,0:18:25.68,0:18:28.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}itu menjelaskan\Nkenapa dia memberikan arak bening.{\i0}
Dialogue: 0,0:18:28.35,0:18:31.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia tak akan memesan\Nbanyak minuman yang membuat mereka muak.{\i0}
Dialogue: 0,0:18:32.44,0:18:36.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti kau diam-diam mengantongi\Nbiaya untuk bahan itu juga.
Dialogue: 0,0:18:37.11,0:18:40.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Produksi alkohol menggunakan\Nbanyak beras dan barli.
Dialogue: 0,0:18:40.70,0:18:43.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Rupanya, kau memberi tahu perajin kertas
Dialogue: 0,0:18:43.45,0:18:48.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bahwa mereka mencemari air\Ndan mengurangi panen padi.
Dialogue: 0,0:18:48.21,0:18:50.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bohong, bukan?
Dialogue: 0,0:18:50.54,0:18:53.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malah, aku yakin\Npadinya lebih bagus sekarang.
Dialogue: 0,0:18:54.46,0:18:58.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dedak dan serutan kayu\Nadalah bahan mentah untuk membuat kertas.{\i0}
Dialogue: 0,0:18:58.42,0:19:02.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Air yang mengandung bahan itu\Nmerupakan pupuk yang sangat bagus.{\i0}
Dialogue: 0,0:19:03.30,0:19:06.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku yakin tuan tanah sebelumnya tahu itu.{\i0}
Dialogue: 0,0:19:06.31,0:19:10.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Namun, tuan tanah saat ini\Ningin menyembunyikan peningkatan panen{\i0}
Dialogue: 0,0:19:10.35,0:19:11.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dengan menjadikannya alkohol.{\i0}
Dialogue: 0,0:19:12.56,0:19:15.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dua penggelapan pajak\Nmenjadikan ini kejahatan serius.
Dialogue: 0,0:19:16.86,0:19:18.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Berdasarkan reaksinya,{\i0}
Dialogue: 0,0:19:18.49,0:19:20.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}kurasa aku benar.{\i0}
Dialogue: 0,0:19:20.32,0:19:22.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau punya bukti?
Dialogue: 0,0:19:22.78,0:19:24.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan khawatir.
Dialogue: 0,0:19:24.53,0:19:28.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau tak bersalah, pejabat\Ntak akan menemukan apa pun di rumahmu.
Dialogue: 0,0:19:30.37,0:19:32.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau cukup sombong, Nona Kecil.
Dialogue: 0,0:19:32.96,0:19:36.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutmu aksi kecil ini tak akan dihukum?
Dialogue: 0,0:19:36.21,0:19:39.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa menanyakan hal yang sama.
Dialogue: 0,0:19:39.51,0:19:41.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pahami suasana sebelum kau bicara.
Dialogue: 0,0:19:48.47,0:19:51.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bisa mulai memanggil bantuan sekarang.
Dialogue: 0,0:19:51.48,0:19:54.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sementara itu,\Naku akan memanggil pihak berwenang.
Dialogue: 0,0:19:55.23,0:19:59.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sebenarnya, ada orang di sini yang lebih\Nmenakutkan daripada pejabat pemerintah.{\i0}
Dialogue: 0,0:20:01.36,0:20:05.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona, kau tidak bersikap seperti biasa...
Dialogue: 0,0:20:06.74,0:20:10.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Jika mau bermain,\Nsetidaknya bersiaplah untuk dipermainkan.
Dialogue: 0,0:20:14.29,0:20:17.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa alasanmu melecehkan orang-orang ini?
Dialogue: 0,0:20:22.59,0:20:24.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong, jangan jahat kepadanya!
Dialogue: 0,0:20:26.76,0:20:28.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, bukan kami yang...
Dialogue: 0,0:20:28.60,0:20:30.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku.
Dialogue: 0,0:20:30.10,0:20:33.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu, ayahku membuat\Ntuntutan tak masuk akal lagi.
Dialogue: 0,0:20:33.14,0:20:35.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong maafkan ayahku yang bodoh!
Dialogue: 0,0:20:37.31,0:20:38.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak akan terjadi apa-apa!
Dialogue: 0,0:20:39.27,0:20:40.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak kepada ayahmu.
Dialogue: 0,0:20:42.32,0:20:45.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau! Jangan sentuh putriku!
Dialogue: 0,0:20:45.24,0:20:46.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ayah!\N- Ayah...
Dialogue: 0,0:20:46.82,0:20:49.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak pernah setuju menjadi ayahmu!
Dialogue: 0,0:20:49.62,0:20:51.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ada apa ini?{\i0}
Dialogue: 0,0:20:52.20,0:20:53.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, selama ini...
Dialogue: 0,0:20:54.04,0:20:56.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, persis seperti kelihatannya.
Dialogue: 0,0:20:57.13,0:21:00.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu menjelaskan\Nkenapa si putra sulung memihak petani.{\i0}
Dialogue: 0,0:21:00.21,0:21:04.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu juga alasan tuan tanah membenci\Norang luar dan ingin mereka pergi.{\i0}
Dialogue: 0,0:21:06.68,0:21:07.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bodoh sekali.
Dialogue: 0,0:21:08.39,0:21:10.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kakakku sangat mencintainya.
Dialogue: 0,0:21:11.85,0:21:15.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Itu alasan konyol\Nmembiarkan seluruh desa hancur.
Dialogue: 0,0:21:16.48,0:21:20.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jika dipikir,\Nputra sulung itu kerabat tabib.{\i0}
Dialogue: 0,0:21:22.90,0:21:26.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jika dia kerabat tabib,\Nmau bagaimana lagi...{\i0}
Dialogue: 0,0:21:26.99,0:21:28.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tentu tidak!{\i0}
Dialogue: 0,0:21:28.82,0:21:29.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi.
Dialogue: 0,0:21:29.95,0:21:31.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau arak.
Dialogue: 0,0:21:31.66,0:21:33.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minum lagi?
Dialogue: 0,0:21:33.29,0:21:35.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baru mulai.
Dialogue: 0,0:21:46.26,0:21:47.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Akhirnya, desa perajin kertas{\i0}
Dialogue: 0,0:21:47.93,0:21:50.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}setuju untuk melunasi utang\Nselama lima tahun.{\i0}
Dialogue: 0,0:21:51.68,0:21:53.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Soal taruhanku dengan tuan tanah,{\i0}
Dialogue: 0,0:21:53.89,0:21:55.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}kami menegosiasikan rencana{\i0}
Dialogue: 0,0:21:55.31,0:21:58.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}untuk memasok beras ke Rumah Verdigris\Nselama sepuluh tahun ke depan.{\i0}
Dialogue: 0,0:22:00.31,0:22:01.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Terakhir,{\i0}
Dialogue: 0,0:22:01.77,0:22:05.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}soal si putra sulung dan putri tuan tanah...{\i0}
Dialogue: 0,0:22:07.20,0:22:08.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku tak peduli.
Dialogue: 0,0:23:54.55,0:23:58.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Episode selanjutnya,\N"Henep dan Agama Rakyat".{\i0}
Dialogue: 0,0:23:58.93,0:24:00.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Terjemahan subtitle oleh Amalia Puspita
