Dialogue: 0,0:03:04.78,0:03:06.94,sign,,0000,0000,0000,,AKADEMI ALTOIRE, SD
Dialogue: 0,0:07:36.48,0:07:38.98,sign,,0000,0000,0000,,AREA KUNJUNGAN KLUB
Dialogue: 0,0:08:23.51,0:08:27.39,sign,,0000,0000,0000,,DOJO ALIRAN TENHA, AKADEMI ALTOIRE
Dialogue: 0,0:12:07.71,0:12:11.66,sign,,0000,0000,0000,,SELAMAT DATANG DI AKADEMI ALTOIRE
Dialogue: 0,0:13:11.51,0:13:16.94,sign,,0000,0000,0000,,EPISODE 5:\NRAPAT PENYEBARAN MAGIC VISION
Dialogue: 0,0:16:27.47,0:16:29.29,sign,,0000,0000,0000,,KISAH PETUALANGAN LISTON
Dialogue: 0,0:16:39.30,0:16:42.16,sign,,0000,0000,0000,,KUNJUNGAN PROFESI NIA LISTON
Dialogue: 0,0:23:59.21,0:24:00.00,sign,,0000,0000,0000,,SELANJUTNYA\NTURNAMEN BELA DIRI AKADEMI DIMULAI!
Dialogue: 0,0:00:23.42,0:00:26.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nia Liston: The Merciless Maiden
Dialogue: 0,0:01:38.82,0:01:41.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sini, di Akademi Altoire,
Dialogue: 0,0:01:41.37,0:01:46.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kehidupan asrama Nona dan pelayannya,\Nsaya, Rinokis, telah dimulai.
Dialogue: 0,0:01:47.51,0:01:50.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di akademi ada putri ketiga\NKerajaan Altoire,
Dialogue: 0,0:01:50.87,0:01:52.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Hildetaura,
Dialogue: 0,0:01:52.53,0:01:55.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan putri penguasa wilayah Silver,
Dialogue: 0,0:01:55.32,0:01:58.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Reliared yang sangat sombong.
Dialogue: 0,0:01:58.65,0:02:01.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka sosok populer di Magic Vision.
Dialogue: 0,0:02:02.00,0:02:03.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atas ajakan Nona Hilde,
Dialogue: 0,0:02:03.84,0:02:07.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ketiganya bekerja sama\Nuntuk menyebarkan Magic Vision.
Dialogue: 0,0:02:08.02,0:02:09.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, melalui proses syuting,
Dialogue: 0,0:02:09.88,0:02:12.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Reliared yang sombong itu...
Dialogue: 0,0:02:12.37,0:02:13.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kau mau,
Dialogue: 0,0:02:14.49,0:02:18.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku bersedia, kok,\Nikut menyebarkan Magic Vision bersamamu.
Dialogue: 0,0:02:19.06,0:02:22.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akhirnya mengakui kemampuan Nona Nia.
Dialogue: 0,0:02:27.78,0:02:30.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan kalah\Ndi pemeriksaan fisik, Nia.
Dialogue: 0,0:02:31.09,0:02:32.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, iya.
Dialogue: 0,0:02:32.80,0:02:33.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kau dengar, tidak?!
Dialogue: 0,0:02:33.74,0:02:36.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tinggi badanku pasti menang!\N- Itu Nia dan Relia!
Dialogue: 0,0:02:36.30,0:02:38.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tinggiku baru saja bertambah!\N- Nona bangsawan memang beda,
Dialogue: 0,0:02:38.18,0:02:40.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}selalu bersama pelayannya, ya.
Dialogue: 0,0:02:40.06,0:02:40.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm.
Dialogue: 0,0:02:41.00,0:02:44.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski sistem kasta mulai memudar,
Dialogue: 0,0:02:45.00,0:02:47.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ternyata bangsawan tetap disegani, ya.
Dialogue: 0,0:02:47.91,0:02:49.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, masalahnya...
Dialogue: 0,0:02:50.28,0:02:51.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Siapa, siapa?
Dialogue: 0,0:02:51.65,0:02:54.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu anak-anak di Magic Vision.
Dialogue: 0,0:02:54.50,0:02:56.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak pernah lihat.
Dialogue: 0,0:02:56.28,0:02:58.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di rumahku tidak ada Magic Vision.
Dialogue: 0,0:02:59.38,0:03:01.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei! Kenapa melamun begitu?
Dialogue: 0,0:03:03.21,0:03:04.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat, kita sudah sampai!
Dialogue: 0,0:03:06.96,0:03:08.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, sudahlah.
Dialogue: 0,0:03:08.21,0:03:10.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang penting, tujuan hari ini...
Dialogue: 0,0:03:11.18,0:03:13.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}guru dari Aliran Tenha!
Dialogue: 0,0:03:13.37,0:03:15.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seberapa kuat dia?
Dialogue: 0,0:03:17.46,0:03:19.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke-Kenapa kau tertawa?
Dialogue: 0,0:03:20.34,0:03:22.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Murid baru harap berbaris di sini!
Dialogue: 0,0:03:29.28,0:03:30.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya, silakan.
Dialogue: 0,0:03:32.47,0:03:34.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama, pengukuran mana, ya.
Dialogue: 0,0:03:41.37,0:03:43.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Warna identifikasimu "merah".
Dialogue: 0,0:03:43.53,0:03:46.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jumlahnya jauh di atas rata-rata.
Dialogue: 0,0:03:47.86,0:03:50.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua ayundaku juga "merah".
Dialogue: 0,0:03:51.03,0:03:52.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya, silakan.
Dialogue: 0,0:03:59.06,0:04:00.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, lo?
Dialogue: 0,0:04:00.30,0:04:03.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Warna identifikasinya tidak muncul.
Dialogue: 0,0:04:03.31,0:04:04.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga.
Dialogue: 0,0:04:05.59,0:04:07.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak hampir mati setahun lalu,
Dialogue: 0,0:04:07.97,0:04:10.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}warna rambutku tidak kunjung kembali.
Dialogue: 0,0:04:10.25,0:04:11.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:04:11.16,0:04:15.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rambut penyihir yang kehabisan mana\Nakan memutih.
Dialogue: 0,0:04:15.62,0:04:16.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu itu,
Dialogue: 0,0:04:16.63,0:04:20.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pasti saluran manaku sudah rusak.
Dialogue: 0,0:04:22.00,0:04:22.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nia...
Dialogue: 0,0:04:22.98,0:04:24.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak masalah.
Dialogue: 0,0:04:24.19,0:04:26.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daripada serangan sihir,
Dialogue: 0,0:04:26.26,0:04:28.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}meninju atau menendang lebih cepat.
Dialogue: 0,0:04:29.19,0:04:31.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke-Kenapa kau tersenyum?
Dialogue: 0,0:04:38.30,0:04:40.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nia lebih berat, ya.
Dialogue: 0,0:04:40.30,0:04:42.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, itu karena perbedaan otot.
Dialogue: 0,0:04:42.88,0:04:44.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Otot memang lebih berat daripada lemak.
Dialogue: 0,0:04:45.13,0:04:47.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah kenapa, agak menyebalkan.
Dialogue: 0,0:04:51.56,0:04:52.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana?
Dialogue: 0,0:04:52.37,0:04:53.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh!
Dialogue: 0,0:04:53.50,0:04:54.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat sekali!
Dialogue: 0,0:04:54.85,0:04:56.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah!
Dialogue: 0,0:04:58.11,0:05:00.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona, jangan pakai tenaga penuh.
Dialogue: 0,0:05:01.11,0:05:02.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu.
Dialogue: 0,0:05:05.31,0:05:06.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keren!
Dialogue: 0,0:05:06.24,0:05:07.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat sekali!
Dialogue: 0,0:05:07.50,0:05:09.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyebalkan!
Dialogue: 0,0:06:01.31,0:06:04.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa semua nilaimu sedikit di atasku?!
Dialogue: 0,0:06:04.38,0:06:05.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf,
Dialogue: 0,0:06:05.68,0:06:08.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}walau lawannya anak-anak,\Naku tidak mau kalah.
Dialogue: 0,0:06:08.69,0:06:09.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daripada itu...
Dialogue: 0,0:06:10.37,0:06:11.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita pergi.
Dialogue: 0,0:06:11.50,0:06:12.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Ke mana?
Dialogue: 0,0:06:13.18,0:06:15.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke tempat ayundamu menunggu.
Dialogue: 0,0:06:16.11,0:06:19.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nia, datanglah berkunjung\Nke Klub Aliran Tenha, ya.
Dialogue: 0,0:06:21.92,0:06:24.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga, kita sudah berjanji.
Dialogue: 0,0:06:25.13,0:06:28.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jujur saja, aku sudah lama menantikannya!
Dialogue: 0,0:06:28.13,0:06:30.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Cepat, cepat ajak aku!\N- De-Dekat sekali!
Dialogue: 0,0:06:34.62,0:06:37.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau mau masuk Klub Aliran Tenha?
Dialogue: 0,0:06:37.77,0:06:40.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika lebih kuat dariku,\Nbisa kupertimbangkan.
Dialogue: 0,0:06:41.30,0:06:42.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau lebih kuat, sih.
Dialogue: 0,0:06:43.74,0:06:45.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi menyebarkan Magic Vision,
Dialogue: 0,0:06:45.77,0:06:48.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pasti tidak ada waktu untuk klub.
Dialogue: 0,0:06:49.98,0:06:51.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, benar juga.
Dialogue: 0,0:06:51.68,0:06:53.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku ingin masuk.
Dialogue: 0,0:06:56.05,0:06:57.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Relia, kau ingin jadi kuat?
Dialogue: 0,0:06:57.98,0:07:00.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja!\NAku ingin lebih kuat darimu!
Dialogue: 0,0:07:00.61,0:07:02.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Lebih kuat dariku?
Dialogue: 0,0:07:03.36,0:07:05.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin menang soal wajah dan sifat,
Dialogue: 0,0:07:06.25,0:07:07.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kekuatanku kalah darimu.
Dialogue: 0,0:07:08.30,0:07:10.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai putri keluarga Silver,
Dialogue: 0,0:07:10.19,0:07:12.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tidak mau kalah darimu\Ndalam aspek apa pun!
Dialogue: 0,0:07:16.72,0:07:17.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau tertawa?!
Dialogue: 0,0:07:19.17,0:07:20.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, bukan apa-apa.
Dialogue: 0,0:07:22.25,0:07:25.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau lebih kuat dariku? Sungguh?
Dialogue: 0,0:07:29.30,0:07:30.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang...
Dialogue: 0,0:07:30.85,0:07:33.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa tertawa, sih?!
Dialogue: 0,0:07:40.98,0:07:43.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya Altoire terlalu damai,
Dialogue: 0,0:07:44.22,0:07:46.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi klub bela diri ternyata lumayan banyak.
Dialogue: 0,0:07:46.95,0:07:48.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena ada monster juga
Dialogue: 0,0:07:48.30,0:07:52.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan ada pekerjaan menjelajahi labirin.
Dialogue: 0,0:07:52.24,0:07:55.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada juga klub seni dan hobi,
Dialogue: 0,0:07:55.66,0:07:57.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi di aula olahraga saat ini,
Dialogue: 0,0:07:57.32,0:08:00.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hanya klub bertarung yang berkumpul.
Dialogue: 0,0:08:02.50,0:08:04.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah Tenha di sana?
Dialogue: 0,0:08:09.25,0:08:10.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ke sana dulu!
Dialogue: 0,0:08:10.44,0:08:12.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, aku juga ikut!
Dialogue: 0,0:08:13.60,0:08:15.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah! Nia! Relia!
Dialogue: 0,0:08:15.68,0:08:17.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayunda Lilimi!
Dialogue: 0,0:08:17.04,0:08:18.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo.
Dialogue: 0,0:08:18.13,0:08:20.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian berdua datang, ya!
Dialogue: 0,0:08:20.24,0:08:22.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuantar ke tempat latihan, ya.
Dialogue: 0,0:08:30.75,0:08:32.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak ini! Murid baru berbakat!
Dialogue: 0,0:08:33.27,0:08:35.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi dia guru dari Aliran Tenha!
Dialogue: 0,0:08:36.40,0:08:38.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, anak ini?
Dialogue: 0,0:08:43.86,0:08:46.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak kuat yang diceritakan Lilimi, ya!
Dialogue: 0,0:08:47.41,0:08:49.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, anak ini!
Dialogue: 0,0:08:51.17,0:08:53.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salam kenal. Aku Nia Liston.
Dialogue: 0,0:08:54.77,0:08:55.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:08:55.95,0:08:57.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah mendengarnya,
Dialogue: 0,0:08:57.75,0:09:00.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tertarik pada bela diri di usia sedini itu\Nsungguh mengagumkan!
Dialogue: 0,0:09:01.34,0:09:02.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ah...\N- Tempat latihan kami
Dialogue: 0,0:09:02.30,0:09:04.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kalau bisa, aku mau menghajar orang\N- adalah lingkungan yang tepat
Dialogue: 0,0:09:05.13,0:09:07.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- sebagai pelampiasan rasa kecewaku!\N- untuk berlatih bela diri!
Dialogue: 0,0:09:11.29,0:09:12.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya orang ini
Dialogue: 0,0:09:12.70,0:09:14.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lebih mengandalkan otot daripada teknik.
Dialogue: 0,0:09:15.08,0:09:17.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma pria kasar berotot saja.
Dialogue: 0,0:09:17.70,0:09:20.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, satu-satunya kelebihannya...
Dialogue: 0,0:09:22.45,0:09:25.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dihajar sekuat tenaga pun,\Ndia tidak akan mati.
Dialogue: 0,0:09:25.49,0:09:26.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma itu.
Dialogue: 0,0:09:30.02,0:09:32.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku permisi dulu.
Dialogue: 0,0:09:33.12,0:09:34.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu dulu.
Dialogue: 0,0:09:35.22,0:09:37.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau tertarik dengan Aliran Tenha?
Dialogue: 0,0:09:37.91,0:09:40.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang jika kau mau bergabung.
Dialogue: 0,0:09:41.36,0:09:44.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah bersikap lumayan sopan,
Dialogue: 0,0:09:44.31,0:09:46.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kau mau dipermalukan di depan muridmu?
Dialogue: 0,0:09:46.69,0:09:48.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, kalau begitu...
Dialogue: 0,0:09:48.26,0:09:48.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayang sekali.
Dialogue: 0,0:09:48.99,0:09:52.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona sudah saya latih,
Dialogue: 0,0:09:52.99,0:09:54.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi tidak bisa masuk ke aliran lain.
Dialogue: 0,0:09:55.46,0:09:56.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitulah.
Dialogue: 0,0:09:56.74,0:09:58.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah punya guru.
Dialogue: 0,0:10:00.34,0:10:01.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga, Rinokis.
Dialogue: 0,0:10:02.00,0:10:04.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bertandinglah dan tunjukkan\Nkemampuanmu padanya.
Dialogue: 0,0:10:05.97,0:10:08.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau bisa membuktikan\Ndirimu lebih kuat darinya,
Dialogue: 0,0:10:08.74,0:10:10.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan kupertimbangkan untuk pindah.
Dialogue: 0,0:10:11.34,0:10:13.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih baik berguru pada orang kuat.
Dialogue: 0,0:10:14.25,0:10:16.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, Nona. Itu, sih...
Dialogue: 0,0:10:16.94,0:10:18.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak keberatan.
Dialogue: 0,0:10:18.41,0:10:22.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam bela diri,\Nwajar jika yang kuat yang membimbing.
Dialogue: 0,0:10:25.69,0:10:27.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau lihat penggunaan "Ki"-mu.
Dialogue: 0,0:10:27.47,0:10:30.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunjukkan ilmu yang kau asah\Nselama setahun ini.
Dialogue: 0,0:10:31.88,0:10:35.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau menang, aku traktir makan\Napa saja yang kau mau.
Dialogue: 0,0:10:35.82,0:10:37.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kalah bagaimana?
Dialogue: 0,0:10:37.84,0:10:39.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Latihan berat seharian penuh.
Dialogue: 0,0:10:40.11,0:10:42.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sangat menyukainya, 'kan?
Dialogue: 0,0:10:43.49,0:10:45.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anda mau memasukkan saya ke neraka itu lagi?
Dialogue: 0,0:10:45.98,0:10:48.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membuka jalan adalah tugas murid.
Dialogue: 0,0:10:48.75,0:10:49.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa ini?
Dialogue: 0,0:10:50.02,0:10:51.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya pertandingan antaraliran.
Dialogue: 0,0:10:51.87,0:10:53.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memperebutkan murid wanita baru,
Dialogue: 0,0:10:53.84,0:10:56.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pelayan dan wakil guru besar\Nakan bertanding.
Dialogue: 0,0:10:56.72,0:10:59.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, apa pelayanmu tidak apa-apa?
Dialogue: 0,0:10:59.67,0:11:00.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.
Dialogue: 0,0:11:02.19,0:11:03.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia itu kuat.
Dialogue: 0,0:11:03.89,0:11:05.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be-Begitu, ya.
Dialogue: 0,0:11:19.58,0:11:20.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai!
Dialogue: 0,0:11:23.73,0:11:24.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luar biasa.
Dialogue: 0,0:11:26.01,0:11:27.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wakil Guru Besar?
Dialogue: 0,0:11:27.89,0:11:28.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:11:30.04,0:11:31.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah selesai.
Dialogue: 0,0:11:31.17,0:11:33.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, barusan bagus sekali.
Dialogue: 0,0:11:35.53,0:11:37.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kaki kanan terayun bagai cambuk,
Dialogue: 0,0:11:37.62,0:11:40.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mendaratkan tendangan keras di paha.
Dialogue: 0,0:11:40.39,0:11:41.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari suaranya tadi,
Dialogue: 0,0:11:41.80,0:11:45.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pria itu mengendurkan ototnya.
Dialogue: 0,0:11:51.30,0:11:53.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesuai janji, mari makan siang.
Dialogue: 0,0:11:54.02,0:11:55.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rinokis, mau makan apa?
Dialogue: 0,0:11:55.87,0:11:57.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masakan buatan Nona saja.
Dialogue: 0,0:11:57.95,0:11:59.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, restoran, ya.
Dialogue: 0,0:11:59.46,0:12:01.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan! Masakan buatan Nona...
Dialogue: 0,0:12:01.75,0:12:03.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, restoran, ya.
Dialogue: 0,0:12:12.22,0:12:13.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para siswa baru,
Dialogue: 0,0:12:13.89,0:12:15.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}selamat karena telah diterima.
Dialogue: 0,0:12:16.09,0:12:19.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sini, Akademi Kerajaan Altoire,
Dialogue: 0,0:12:19.34,0:12:21.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}semua anak di seluruh kerajaan
Dialogue: 0,0:12:21.88,0:12:25.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa belajar bersama tanpa memandang kasta.
Dialogue: 0,0:12:28.34,0:12:31.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini gedung SD kami!
Dialogue: 0,0:12:32.65,0:12:36.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di bagian atas ada gedung SMP dan SMA,
Dialogue: 0,0:12:36.48,0:12:39.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan jauh di sana ada gedung akademi.
Dialogue: 0,0:12:40.17,0:12:42.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kuantar ke dalam.
Dialogue: 0,0:12:42.29,0:12:46.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini ruang untuk kelas satu.
Dialogue: 0,0:12:46.25,0:12:47.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, sedang apa?
Dialogue: 0,0:12:48.02,0:12:50.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya syuting Magic Vision.
Dialogue: 0,0:12:50.59,0:12:51.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yey!
Dialogue: 0,0:12:51.58,0:12:53.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, aku juga!
Dialogue: 0,0:12:53.59,0:12:55.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tu-Tunggu! Ini sedang syuting!
Dialogue: 0,0:12:55.62,0:12:58.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.\NMakin ramai makin bagus.
Dialogue: 0,0:12:58.13,0:12:59.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Yey!\N- Yey!
Dialogue: 0,0:13:03.01,0:13:04.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:13:07.13,0:13:11.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari mulai Rapat Penyebaran\NMagic Vision Pertama!
Dialogue: 0,0:13:16.94,0:13:18.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nia Liston: The Merciless Maiden
Dialogue: 0,0:13:18.99,0:13:20.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama, Nia dan Relia,
Dialogue: 0,0:13:20.61,0:13:23.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}panggillah aku Hilde.
Dialogue: 0,0:13:23.40,0:13:25.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahasa formal juga tak perlu.
Dialogue: 0,0:13:25.20,0:13:28.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin memanggil nama saja...
Dialogue: 0,0:13:28.42,0:13:31.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksud Hilde, itu buang-buang waktu, 'kan?
Dialogue: 0,0:13:31.50,0:13:32.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, 'kan, Hilde?
Dialogue: 0,0:13:33.16,0:13:34.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitulah.
Dialogue: 0,0:13:34.55,0:13:36.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baiklah.
Dialogue: 0,0:13:36.87,0:13:39.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengenai Magic Vision,
Dialogue: 0,0:13:40.00,0:13:43.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tidak bisa ikut campur dalam hal teknis.
Dialogue: 0,0:13:44.00,0:13:46.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu pula soal keuangan berskala besar.
Dialogue: 0,0:13:47.41,0:13:50.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kristal sihir penayang gambar ini
Dialogue: 0,0:13:50.50,0:13:53.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}awalnya memakai kristal langka,
Dialogue: 0,0:13:53.71,0:13:55.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi setelah diteliti,
Dialogue: 0,0:13:55.16,0:13:57.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sekarang bisa dibuat dengan sihir.
Dialogue: 0,0:13:58.74,0:14:00.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya saja, biayanya tetap tinggi,
Dialogue: 0,0:14:00.96,0:14:02.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi harga kristalnya sangat mahal.
Dialogue: 0,0:14:03.23,0:14:04.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi,
Dialogue: 0,0:14:04.22,0:14:06.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}negara yang yakin kelak ini akan populer
Dialogue: 0,0:14:06.63,0:14:09.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menginvestasikan dana sangat besar
Dialogue: 0,0:14:09.80,0:14:11.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}guna mendukung riset serta pengembangannya.
Dialogue: 0,0:14:12.37,0:14:14.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dana dari negara saja tidak cukup,
Dialogue: 0,0:14:14.89,0:14:16.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi dicarilah investor lain.
Dialogue: 0,0:14:16.86,0:14:19.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi setelah keluarga Liston,\Ntak ada lagi yang ikut,
Dialogue: 0,0:14:19.64,0:14:23.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sampai baru-baru ini\Nkeluarga Silver bergabung.
Dialogue: 0,0:14:23.37,0:14:25.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah kondisi saat ini.
Dialogue: 0,0:14:25.29,0:14:27.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa menekan biayanya?
Dialogue: 0,0:14:27.10,0:14:31.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal kita ingin menyebarkannya,\Ntapi rakyat biasa tidak sanggup membeli.
Dialogue: 0,0:14:31.44,0:14:33.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang benar begitu, tapi...
Dialogue: 0,0:14:33.35,0:14:36.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana cara membuatnya dengan sihir?
Dialogue: 0,0:14:36.26,0:14:40.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu rahasia tertinggi negara.
Dialogue: 0,0:14:40.61,0:14:42.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga tidak diberi tahu.
Dialogue: 0,0:14:43.01,0:14:44.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:14:47.75,0:14:48.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong...
Dialogue: 0,0:14:49.12,0:14:53.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saluran Silver punya banyak acara petualang.
Dialogue: 0,0:14:53.57,0:14:55.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, kudengar begitu.
Dialogue: 0,0:14:55.24,0:14:57.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin menontonnya.\NIngin cepat-cepat lihat darah!
Dialogue: 0,0:14:58.02,0:15:01.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penghasilan mereka berasal\Ndari menjual bahan temuan.
Dialogue: 0,0:15:01.97,0:15:03.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau beruntung,
Dialogue: 0,0:15:03.07,0:15:05.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kaya mendadak bukan cuma mimpi.
Dialogue: 0,0:15:05.75,0:15:07.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penghasilan, ya.
Dialogue: 0,0:15:07.51,0:15:09.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kita yang cari uang
Dialogue: 0,0:15:09.36,0:15:12.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu uangnya dipakai membeli kristal sihir,\Npasti lebih cepat, sih.
Dialogue: 0,0:15:13.07,0:15:14.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah!
Dialogue: 0,0:15:14.17,0:15:15.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:15:15.73,0:15:17.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari hasilkan uang dengan berburu monster!
Dialogue: 0,0:15:19.60,0:15:20.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nia ini...
Dialogue: 0,0:15:21.14,0:15:22.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bicara apa, sih?
Dialogue: 0,0:15:22.98,0:15:25.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bercanda, pikirkan baik-baik!
Dialogue: 0,0:15:26.13,0:15:27.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku serius, lo.
Dialogue: 0,0:15:28.66,0:15:29.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi
Dialogue: 0,0:15:29.51,0:15:33.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}petualang tidak dapat bayaran rutin,
Dialogue: 0,0:15:33.50,0:15:36.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi sulit dijadikan sumber dana tetap.
Dialogue: 0,0:15:38.94,0:15:40.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh saya bicara?
Dialogue: 0,0:15:41.05,0:15:42.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, silakan.
Dialogue: 0,0:15:42.85,0:15:45.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini tentang seorang petualang...
Dialogue: 0,0:15:45.16,0:15:46.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Prestasinya diakui
Dialogue: 0,0:15:46.98,0:15:50.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan mendapat dana dari bangsawan,
Dialogue: 0,0:15:50.69,0:15:51.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}saya dengar begitu.
Dialogue: 0,0:15:52.17,0:15:53.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudnya?
Dialogue: 0,0:15:53.13,0:15:54.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudnya berburu monster!
Dialogue: 0,0:15:54.76,0:15:56.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pikirkan dengan serius!
Dialogue: 0,0:15:57.01,0:15:57.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudnya
Dialogue: 0,0:15:57.95,0:16:01.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan memaksimalkan keunggulan kita,
Dialogue: 0,0:16:01.23,0:16:04.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita bisa dapat dana dari mana saja.
Dialogue: 0,0:16:04.10,0:16:05.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurut saya begitu.
Dialogue: 0,0:16:05.78,0:16:07.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:16:07.03,0:16:11.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan menayangkan acara yang disukai\Nbanyak orang,
Dialogue: 0,0:16:11.58,0:16:13.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita bisa dapat dukungan\Nberupa sumbangan dan dana.
Dialogue: 0,0:16:13.73,0:16:15.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudnya begitu, 'kan?
Dialogue: 0,0:16:16.96,0:16:20.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti buat acara yang lebih seru.
Dialogue: 0,0:16:21.00,0:16:24.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau acara yang sudah ada\Ndibuat makin seru saja?
Dialogue: 0,0:16:24.50,0:16:25.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Contohnya...
Dialogue: 0,0:16:29.34,0:16:30.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak boleh!
Dialogue: 0,0:16:30.89,0:16:33.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bukan lagi jalan-jalan!
Dialogue: 0,0:16:33.62,0:16:34.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu.
Dialogue: 0,0:16:34.69,0:16:35.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:16:42.23,0:16:43.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu juga tidak boleh!
Dialogue: 0,0:16:43.89,0:16:46.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nia, mari menjauh dari topik monster dulu.
Dialogue: 0,0:16:47.00,0:16:50.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau nonton pertarungan\Nberdarah melawan monster!
Dialogue: 0,0:16:50.65,0:16:52.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pikirkan acara yang disukai banyak orang
Dialogue: 0,0:16:52.66,0:16:55.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan bakal mereka tonton!
Dialogue: 0,0:16:58.66,0:17:00.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh saya bicara?
Dialogue: 0,0:17:01.62,0:17:03.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuncinya adalah cinta!
Dialogue: 0,0:17:03.62,0:17:04.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Cinta?\N- Cinta?!
Dialogue: 0,0:17:04.96,0:17:07.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang menarik semua orang adalah lawan jenis.
Dialogue: 0,0:17:07.65,0:17:08.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Singkatnya, asmara.
Dialogue: 0,0:17:09.25,0:17:10.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak dulu,
Dialogue: 0,0:17:10.19,0:17:13.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}cerita asmara banyak dibuat
Dialogue: 0,0:17:13.51,0:17:16.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena manusia mencari cinta.
Dialogue: 0,0:17:17.31,0:17:18.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah!
Dialogue: 0,0:17:18.33,0:17:20.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, membosankan.
Dialogue: 0,0:17:20.16,0:17:22.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tema asmara populer sekali, lo.
Dialogue: 0,0:17:22.57,0:17:24.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang dewasa yang plinplan
Dialogue: 0,0:17:24.14,0:17:26.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bukankah sangat merepotkan?
Dialogue: 0,0:17:29.86,0:17:32.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasa gemas itulah cinta dewasa!
Dialogue: 0,0:17:33.00,0:17:35.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berawal dari percikan api kecil,
Dialogue: 0,0:17:35.25,0:17:37.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}begitu terbakar langsung membara!
Dialogue: 0,0:17:37.57,0:17:39.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak delapan tahun\Nngomongnya kayak pakar cinta saja.
Dialogue: 0,0:17:39.73,0:17:41.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal belum pernah jatuh cinta.
Dialogue: 0,0:17:41.53,0:17:42.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kalian berdua begitu?!
Dialogue: 0,0:17:43.35,0:17:45.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi memang menarik perhatian, sih.
Dialogue: 0,0:17:45.78,0:17:47.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mau dimaksimalkan,
Dialogue: 0,0:17:48.07,0:17:49.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang agak mesum pasti oke.
Dialogue: 0,0:17:50.43,0:17:52.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang agak mesum?!
Dialogue: 0,0:17:52.33,0:17:54.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tu-Tunggu sebentar!
Dialogue: 0,0:17:54.22,0:17:56.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seberapa mesum yang dibayangkan?!
Dialogue: 0,0:17:57.00,0:17:58.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, telanjang begitu.
Dialogue: 0,0:17:58.93,0:17:59.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Telanjang?!\N- Telanjang?!
Dialogue: 0,0:18:00.02,0:18:02.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pria dan wanita telanjang di kasur.
Dialogue: 0,0:18:02.48,0:18:04.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di kasur?!
Dialogue: 0,0:18:04.13,0:18:06.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau menayangkan hal seperti itu\Ndi Magic Vision,
Dialogue: 0,0:18:06.38,0:18:09.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita bakal dihancurkan dari segala arah!
Dialogue: 0,0:18:09.94,0:18:12.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari tadi menolak terus.
Dialogue: 0,0:18:12.26,0:18:14.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hilde, kasih ide juga, dong.
Dialogue: 0,0:18:14.50,0:18:15.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu...
Dialogue: 0,0:18:15.95,0:18:16.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:18:17.95,0:18:19.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebelum bertemu kalian,
Dialogue: 0,0:18:20.11,0:18:23.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku sudah memikirkan banyak hal.
Dialogue: 0,0:18:24.45,0:18:25.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi,
Dialogue: 0,0:18:25.74,0:18:28.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak ada ide bagus yang terpikirkan.
Dialogue: 0,0:18:29.38,0:18:32.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masalah ini bahkan sulit\Nditangani orang dewasa.
Dialogue: 0,0:18:35.05,0:18:35.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi,
Dialogue: 0,0:18:36.55,0:18:39.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku berharap kalau kita bertiga
Dialogue: 0,0:18:39.25,0:18:40.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin saja bisa.
Dialogue: 0,0:18:44.00,0:18:45.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi faktanya
Dialogue: 0,0:18:46.01,0:18:48.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak semudah itu, ya.
Dialogue: 0,0:18:49.97,0:18:51.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Hilde...
Dialogue: 0,0:18:56.31,0:18:58.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau cuma mengeluh, kita tidak akan maju.
Dialogue: 0,0:18:59.99,0:19:01.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal berguna atau tidaknya,
Dialogue: 0,0:19:01.97,0:19:04.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mari kita kesampingkan dulu hal semacam itu.
Dialogue: 0,0:19:04.32,0:19:06.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama-tama\Nmari kita keluarkan saja dulu ide-idenya.
Dialogue: 0,0:19:09.81,0:19:10.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga!
Dialogue: 0,0:19:11.00,0:19:11.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita pikirkan!
Dialogue: 0,0:19:13.46,0:19:14.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:19:23.46,0:19:24.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa saja boleh.
Dialogue: 0,0:19:25.01,0:19:27.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama, yang ada di akademi...
Dialogue: 0,0:19:38.53,0:19:39.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:19:39.90,0:19:41.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita saat ini
Dialogue: 0,0:19:41.41,0:19:44.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berdiskusi dari sisi pembuat.
Dialogue: 0,0:19:44.34,0:19:47.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, bagaimana kalau dibalik?
Dialogue: 0,0:19:47.77,0:19:48.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misalnya...
Dialogue: 0,0:19:50.04,0:19:52.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Acara apa yang ingin diikuti?
Dialogue: 0,0:19:54.17,0:19:55.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ingin... diikuti?
Dialogue: 0,0:19:56.38,0:19:57.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:19:57.17,0:19:58.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat upacara masuk,
Dialogue: 0,0:19:58.66,0:20:00.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}banyak anak ingin masuk kamera.
Dialogue: 0,0:20:00.79,0:20:03.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada anak yang maju ke depan kita,
Dialogue: 0,0:20:03.18,0:20:04.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ada juga yang terus mengikuti kita.
Dialogue: 0,0:20:05.32,0:20:07.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti, anak-anak saat itu
Dialogue: 0,0:20:07.73,0:20:09.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pasti berpikir
Dialogue: 0,0:20:09.68,0:20:11.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bahwa mereka ingin tampil\Ndi Magic Vision, 'kan?
Dialogue: 0,0:20:13.03,0:20:14.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini dia!
Dialogue: 0,0:20:14.74,0:20:18.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika rakyat berpikir, "Aku bisa ikut",
Dialogue: 0,0:20:18.91,0:20:21.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pasti ada yang bakal tertarik!
Dialogue: 0,0:20:21.91,0:20:24.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan sekadar menonton,
Dialogue: 0,0:20:24.49,0:20:26.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi bisa ikut serta dalam acaranya!
Dialogue: 0,0:20:27.44,0:20:29.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nia, Relia! Terima kasih!
Dialogue: 0,0:20:29.71,0:20:32.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini pasti berhasil!
Dialogue: 0,0:20:34.67,0:20:36.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, Nona Hilde sangat mengejutkan, ya.
Dialogue: 0,0:20:37.25,0:20:38.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiba-tiba pergi begitu saja.
Dialogue: 0,0:20:39.23,0:20:40.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Relia.
Dialogue: 0,0:20:41.39,0:20:42.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terkait ucapan Hilde,
Dialogue: 0,0:20:42.99,0:20:45.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku memikirkan acara partisipasi.
Dialogue: 0,0:20:46.18,0:20:47.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti apa?
Dialogue: 0,0:20:47.23,0:20:49.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Petualang kuat bertarung melawan monster
Dialogue: 0,0:20:49.80,0:20:52.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau pertarungan antar sesama orang kuat.
Dialogue: 0,0:20:52.22,0:20:55.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, penonton bertaruh\Nsiapa yang lebih kuat.
Dialogue: 0,0:20:56.40,0:20:58.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pikiranmu cuma itu saja...
Dialogue: 0,0:20:58.76,0:20:59.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau ingin lihat, 'kan?
Dialogue: 0,0:21:01.00,0:21:05.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, akhir-akhir ini banyak\Nyang tidak suka darah.
Dialogue: 0,0:21:06.38,0:21:09.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya penonton sering mengeluh.
Dialogue: 0,0:21:10.18,0:21:12.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanpa darah mana bisa seru!
Dialogue: 0,0:21:12.77,0:21:14.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertarungan kan wajar berdarah!
Dialogue: 0,0:21:14.85,0:21:16.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paling parah, mati pun wajar!
Dialogue: 0,0:21:16.66,0:21:17.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, kenapa?!
Dialogue: 0,0:21:17.50,0:21:19.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemikiran itu menyeramkan!
Dialogue: 0,0:21:29.98,0:21:31.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tendangan waktu itu...
Dialogue: 0,0:21:31.25,0:21:32.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasarnya masih kurang,
Dialogue: 0,0:21:32.79,0:21:34.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kau sudah bisa memakai "Ki".
Dialogue: 0,0:21:35.25,0:21:37.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Te-Terima kasih banyak.
Dialogue: 0,0:21:37.60,0:21:39.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang masih jauh dari sempurna,
Dialogue: 0,0:21:39.73,0:21:41.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi teruslah berusaha.
Dialogue: 0,0:21:41.25,0:21:41.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:21:42.34,0:21:43.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya pasti
Dialogue: 0,0:21:43.30,0:21:47.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan bisa melindungi Anda...
Dialogue: 0,0:21:51.47,0:21:52.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya ampun.
Dialogue: 0,0:21:52.76,0:21:54.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapan hari itu akan tiba?
Dialogue: 0,0:21:58.31,0:21:59.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Nia.
Dialogue: 0,0:21:59.50,0:22:01.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada kabar dari Nona Hilde?
Dialogue: 0,0:22:02.00,0:22:03.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, tidak ada.
Dialogue: 0,0:22:03.54,0:22:06.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin sedang menyusun rencana.
Dialogue: 0,0:22:07.97,0:22:09.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nia! Relia!
Dialogue: 0,0:22:09.57,0:22:11.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang memakan waktu,
Dialogue: 0,0:22:11.11,0:22:13.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi akhirnya aku dapat ide bagus!
Dialogue: 0,0:22:17.32,0:22:20.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari adakan turnamen bela diri\Nyang bisa diikuti penonton!
Dialogue: 0,0:22:22.07,0:22:23.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Turnamen bela diri!
Dialogue: 0,0:23:55.83,0:23:59.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya,\N"Turnamen Bela Diri Akademi Dimulai!"
