Dialogue: 0,0:01:38.23,0:01:39.17,sign,,0000,0000,0000,,DOJO ALIRAN TENHA AKADEMI ALTOIRE
Dialogue: 0,0:05:25.89,0:05:30.48,sign,,0000,0000,0000,,EPISODE 7:\NMENYUSUP KE ARENA TARUNG GELAP
Dialogue: 0,0:07:14.70,0:07:16.93,sign,,0000,0000,0000,,TURNAMEN BELA DIRI AKADEMI ALTOIRE
Dialogue: 0,0:09:12.32,0:09:14.84,sign,,0000,0000,0000,,BAR TIKUS BAYANGAN TEMARAM
Dialogue: 0,0:09:14.84,0:09:17.33,sign,,0000,0000,0000,,TUTUP
Dialogue: 0,0:11:01.80,0:11:03.43,sign,,0000,0000,0000,,UNDANGAN
Dialogue: 0,0:23:58.64,0:23:59.95,sign,,0000,0000,0000,,SELANJUTNYA: PEDANG SIHIR SANG IBLIS PEDANG
Dialogue: 0,0:00:23.42,0:00:26.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nia Liston: The Merciless Maiden
Dialogue: 0,0:01:39.20,0:01:42.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah datang kemari, Nona Nia!
Dialogue: 0,0:01:43.09,0:01:44.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan panggilan itu.
Dialogue: 0,0:01:44.53,0:01:45.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:01:45.78,0:01:46.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:01:47.00,0:01:49.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam bela diri, tidak ada tua atau muda.
Dialogue: 0,0:01:50.01,0:01:50.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula...
Dialogue: 0,0:01:51.23,0:01:53.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kekuatan adalah segalanya!
Dialogue: 0,0:01:53.54,0:01:56.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau diizinkan,\Nsaya ingin memanggil Anda Guru.
Dialogue: 0,0:01:57.46,0:01:59.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh saja kalau mau.
Dialogue: 0,0:01:59.56,0:02:01.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah, Guru Nia?
Dialogue: 0,0:02:02.21,0:02:04.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aliranmu Aliran Tenha, 'kan?
Dialogue: 0,0:02:05.17,0:02:06.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bukan dari aliran itu,
Dialogue: 0,0:02:06.68,0:02:08.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa tidak masalah kalau\Nkau memanggilku guru?
Dialogue: 0,0:02:10.63,0:02:12.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu yang membuat saya ragu.
Dialogue: 0,0:02:14.34,0:02:15.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti permintaanku sebelumnya,
Dialogue: 0,0:02:16.15,0:02:18.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita pergi ke Arena Tarung Gelap\Nsebagai ayah dan anak.
Dialogue: 0,0:02:19.38,0:02:21.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kau berperan sebagai ayahku,
Dialogue: 0,0:02:21.94,0:02:24.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bicara saja seperti biasanya.
Dialogue: 0,0:02:24.24,0:02:25.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:02:25.21,0:02:27.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, akan saya lakukan.
Dialogue: 0,0:02:28.46,0:02:29.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bicara biasa saja.
Dialogue: 0,0:02:31.31,0:02:33.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal Arena Tarung Gelap itu,
Dialogue: 0,0:02:33.19,0:02:35.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ada hal baru yang kuketahui.
Dialogue: 0,0:02:35.30,0:02:37.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa Anda pernah mendengar nama Iblis Pedang?
Dialogue: 0,0:02:38.03,0:02:38.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak pernah.
Dialogue: 0,0:02:39.15,0:02:41.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kutebak, itu julukan ahli pedang?
Dialogue: 0,0:02:42.02,0:02:42.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya,
Dialogue: 0,0:02:42.86,0:02:46.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}julukan pendekar pedang\Nyang juga seorang petualang.
Dialogue: 0,0:02:47.81,0:02:50.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paling namanya saja yang hebat.
Dialogue: 0,0:02:50.61,0:02:52.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia juga petualang terkenal,
Dialogue: 0,0:02:52.59,0:02:55.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi kemampuannya tidak diragukan.
Dialogue: 0,0:02:55.31,0:02:56.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, tuh!
Dialogue: 0,0:02:57.46,0:02:59.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, Iblis Pedang itu,
Dialogue: 0,0:02:59.65,0:03:01.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}katanya akan datang ke Arena Tarung Gelap!
Dialogue: 0,0:03:02.19,0:03:05.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, bagus!\NBegitu baru mantap!
Dialogue: 0,0:03:05.41,0:03:07.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, patut dinantikan.
Dialogue: 0,0:03:07.91,0:03:10.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku tidak bisa langsung senang begitu.
Dialogue: 0,0:03:11.28,0:03:14.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku masih ragu membawa anak kecil...
Dialogue: 0,0:03:15.21,0:03:17.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi janji tetaplah janji.
Dialogue: 0,0:03:17.90,0:03:20.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan tetap membawamu.
Dialogue: 0,0:03:20.50,0:03:21.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus!
Dialogue: 0,0:03:22.06,0:03:23.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengandalkanmu.
Dialogue: 0,0:03:23.09,0:03:24.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuserahkan padamu, Gandolf.
Dialogue: 0,0:03:26.61,0:03:28.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}La-Lalu...
Dialogue: 0,0:03:28.74,0:03:30.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau ada waktu, bisakah kita berlatih?
Dialogue: 0,0:03:31.49,0:03:34.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang, suasana hatiku sedang sangat baik.
Dialogue: 0,0:03:34.68,0:03:36.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersiaplah. Akan kulihat.
Dialogue: 0,0:03:37.22,0:03:39.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik! Terima kasih banyak!
Dialogue: 0,0:03:43.41,0:03:46.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya kau lebih banyak\Nberlatih cara jatuh.
Dialogue: 0,0:03:47.71,0:03:50.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baik...
Dialogue: 0,0:03:51.19,0:03:55.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak-anak, hari ini kita bahas\Ntentang "Pulau Terapung".
Dialogue: 0,0:03:55.62,0:03:57.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dahulu kala, daratan di dunia...
Dialogue: 0,0:03:57.94,0:04:00.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}terhubung hingga ke dasar laut,
Dialogue: 0,0:04:00.90,0:04:05.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}konon merupakan satu daratan\Nyang sangat luas.
Dialogue: 0,0:04:05.72,0:04:08.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, ratusan tahun
Dialogue: 0,0:04:08.25,0:04:10.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Apa ada yang terjadi?\N- sebelum kalian lahir...
Dialogue: 0,0:04:10.21,0:04:12.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurut legenda, pembelah daratan,
Dialogue: 0,0:04:12.66,0:04:14.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Bukan apa-apa.\N- yakni Vikeranda...
Dialogue: 0,0:04:19.45,0:04:21.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pulang, Rinokis.
Dialogue: 0,0:04:21.81,0:04:24.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang kembali, Nona.
Dialogue: 0,0:04:25.22,0:04:27.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bunga itu cantik sekali, ya.
Dialogue: 0,0:04:30.87,0:04:34.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona, mau saya buatkan teh?
Dialogue: 0,0:04:34.16,0:04:36.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, nanti saja.
Dialogue: 0,0:04:41.72,0:04:45.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak ikut bertarung\Ndi Arena Tarung Gelap.
Dialogue: 0,0:04:50.73,0:04:53.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memang datang sebagai penonton,
Dialogue: 0,0:04:54.05,0:04:55.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi di hadapan petarung sungguhan,
Dialogue: 0,0:04:55.93,0:04:58.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tidak boleh lengah sedikit pun.
Dialogue: 0,0:04:58.61,0:05:01.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu etika dasar ahli bela diri.
Dialogue: 0,0:05:07.82,0:05:08.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu!
Dialogue: 0,0:05:08.54,0:05:09.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hyat!
Dialogue: 0,0:05:09.33,0:05:09.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dua!
Dialogue: 0,0:05:10.01,0:05:10.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hyat!
Dialogue: 0,0:05:10.72,0:05:11.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu!
Dialogue: 0,0:05:11.32,0:05:12.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hyat!
Dialogue: 0,0:05:12.13,0:05:12.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dua!
Dialogue: 0,0:05:12.87,0:05:13.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hyat!
Dialogue: 0,0:05:13.62,0:05:14.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu!
Dialogue: 0,0:05:14.42,0:05:15.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hyat!
Dialogue: 0,0:05:15.14,0:05:15.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dua!
Dialogue: 0,0:05:15.93,0:05:16.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Persiapannya bagaimana?\N- Hyat!
Dialogue: 0,0:05:16.69,0:05:17.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Persiapannya bagaimana?\N- Satu!
Dialogue: 0,0:05:17.45,0:05:18.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hyat!
Dialogue: 0,0:05:18.17,0:05:18.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dua!
Dialogue: 0,0:05:18.83,0:05:19.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hyat!
Dialogue: 0,0:05:19.38,0:05:20.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Sudah selesai semua.\N- Satu!
Dialogue: 0,0:05:20.33,0:05:21.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Sudah selesai semua.\N- Hyat!
Dialogue: 0,0:05:21.30,0:05:21.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dua!
Dialogue: 0,0:05:22.00,0:05:22.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ah...\N- Hyat!
Dialogue: 0,0:05:22.75,0:05:23.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terakhir!
Dialogue: 0,0:05:23.62,0:05:25.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Akhirnya tiba saatnya.\N- Hyat!
Dialogue: 0,0:05:33.32,0:05:34.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya...
Dialogue: 0,0:05:34.44,0:05:35.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya nanti malam, ya!
Dialogue: 0,0:05:37.31,0:05:40.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, Nia, kau lupa?
Dialogue: 0,0:05:40.18,0:05:43.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini siaran turnamen akademi!
Dialogue: 0,0:05:43.32,0:05:46.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua orang pasti terpaku pada Magic Vision!
Dialogue: 0,0:05:49.36,0:05:51.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengenai siaran hari ini,
Dialogue: 0,0:05:51.18,0:05:52.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}istana juga
Dialogue: 0,0:05:52.48,0:05:56.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mengundang para bangsawan\Nyang anaknya bersekolah di sini
Dialogue: 0,0:05:56.87,0:05:58.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan menggelar acara nonton bersama.
Dialogue: 0,0:05:59.00,0:06:00.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, di asrama juga...
Dialogue: 0,0:06:03.83,0:06:05.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bakal masuk siaran atau tidak, ya?
Dialogue: 0,0:06:05.60,0:06:07.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak sabar lihat Tuan Neil!
Dialogue: 0,0:06:07.38,0:06:08.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat, nanti keburu mulai!
Dialogue: 0,0:06:08.43,0:06:10.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Agar keburu menonton siaran,\N- Cepat, nanti keburu mulai!
Dialogue: 0,0:06:10.07,0:06:11.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Agar keburu menonton siaran,\N- Sedikit lagi!
Dialogue: 0,0:06:11.32,0:06:12.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami memasangkan kristal sihir.
Dialogue: 0,0:06:12.23,0:06:13.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- kami memasangkan kristal sihir.\N- Selesai!
Dialogue: 0,0:06:14.06,0:06:16.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya, panekuknya sudah jadi!
Dialogue: 0,0:06:18.31,0:06:19.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asyik, aku mau makan!
Dialogue: 0,0:06:20.01,0:06:21.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Aku juga!\N- Hei, tunggu!
Dialogue: 0,0:06:21.86,0:06:23.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan dorong-dorongan.
Dialogue: 0,0:06:23.13,0:06:25.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya dapat bagian, kok.
Dialogue: 0,0:06:25.62,0:06:28.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari nikmati sambil makan bersama.
Dialogue: 0,0:06:28.56,0:06:29.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:06:29.74,0:06:33.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ingin heboh bersama semua orang\Ndi setiap pertandingan, ya.
Dialogue: 0,0:06:34.33,0:06:36.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perasaan itu bisa kupahami, tapi...
Dialogue: 0,0:06:36.92,0:06:38.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Turnamen Bela Diri Akademi Altoire
Dialogue: 0,0:06:39.00,0:06:40.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan disiarkan sebentar lagi!
Dialogue: 0,0:06:43.18,0:06:44.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona.
Dialogue: 0,0:06:44.95,0:06:46.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa Anda tidak kerepotan?
Dialogue: 0,0:06:46.72,0:06:48.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siarannya sudah mau dimulai.
Dialogue: 0,0:06:48.93,0:06:49.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.
Dialogue: 0,0:06:49.97,0:06:51.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti juga ada siaran ulangnya.
Dialogue: 0,0:06:52.61,0:06:54.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi ini dibagikan di kantin,\Njadi kubawakan sekalian.
Dialogue: 0,0:06:54.93,0:06:55.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oleh-oleh untukmu.
Dialogue: 0,0:06:57.51,0:06:59.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duh! Sampai repot-repot demi saya...
Dialogue: 0,0:06:59.81,0:07:02.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak, Nona!
Dialogue: 0,0:07:02.26,0:07:03.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malam ini, aku mau tidur lebih awal.
Dialogue: 0,0:07:05.89,0:07:07.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Panekuk itu,
Dialogue: 0,0:07:07.13,0:07:10.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}makin lezat kalau dimakan\Npakai krim tambahan.
Dialogue: 0,0:07:10.37,0:07:11.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:07:16.95,0:07:19.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya, terima kasih telah menunggu!
Dialogue: 0,0:07:19.64,0:07:22.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Turnamen Bela Diri Akademi Altoire
Dialogue: 0,0:07:22.24,0:07:24.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akhirnya resmi dimulai!
Dialogue: 0,0:07:26.37,0:07:28.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sini tempat peserta menunggu.
Dialogue: 0,0:07:29.17,0:07:31.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya tampak sangat bersemangat!
Dialogue: 0,0:07:31.64,0:07:34.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama, kategori senjata,\Npertandingan pertama!
Dialogue: 0,0:07:55.49,0:07:56.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai!
Dialogue: 0,0:07:56.77,0:07:59.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, anakku nampang!
Dialogue: 0,0:08:04.95,0:08:07.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku ingin nonton bareng Nia.
Dialogue: 0,0:08:08.06,0:08:10.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Relia, lihat! Wajahku nampang, tuh!
Dialogue: 0,0:08:32.08,0:08:34.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia benar-benar pergi.
Dialogue: 0,0:08:42.50,0:08:45.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh orang yang merepotkan.
Dialogue: 0,0:09:05.16,0:09:06.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Nia!
Dialogue: 0,0:09:06.42,0:09:07.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo cepat.
Dialogue: 0,0:09:18.12,0:09:21.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memang tidak ikut bertarung,
Dialogue: 0,0:09:24.61,0:09:26.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kita tidak tahu\Napa yang nantinya terjadi.
Dialogue: 0,0:09:28.82,0:09:29.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketat sekali, ya.
Dialogue: 0,0:09:30.25,0:09:32.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, karena terlalu banyak latihan.
Dialogue: 0,0:09:32.75,0:09:33.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf menunggu lama.
Dialogue: 0,0:09:34.94,0:09:36.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kubawa barang yang dicari.
Dialogue: 0,0:09:36.98,0:09:38.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat malam, Lily.
Dialogue: 0,0:09:39.62,0:09:41.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bajumu ketat banget.
Dialogue: 0,0:09:41.78,0:09:43.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa lenganmu bisa diangkat?
Dialogue: 0,0:09:43.26,0:09:45.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Aneh, ya?
Dialogue: 0,0:09:45.77,0:09:47.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih bisa dimaklumi, sih.
Dialogue: 0,0:09:47.77,0:09:49.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian berdua saling kenal?
Dialogue: 0,0:09:50.28,0:09:52.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya kalian bisa akrab.
Dialogue: 0,0:09:52.61,0:09:54.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, ayo mulai.
Dialogue: 0,0:10:06.59,0:10:10.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Obat yang dikembangkan demi\Ntujuan penyamaran bangsawan.
Dialogue: 0,0:10:10.59,0:10:12.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedikit saja sudah mahal.
Dialogue: 0,0:10:14.76,0:10:16.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, selesai.
Dialogue: 0,0:10:19.05,0:10:19.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana?
Dialogue: 0,0:10:20.01,0:10:21.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, imut sekali!
Dialogue: 0,0:10:21.73,0:10:23.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sangat cocok untuk Anda, Nona Nia!
Dialogue: 0,0:10:23.58,0:10:26.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak ada rambut putihmu,\Nkau terlihat biasa saja.
Dialogue: 0,0:10:26.26,0:10:29.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harusnya ada yang bilang\N"seperti orang lain", dong.
Dialogue: 0,0:10:29.74,0:10:31.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku sudah susah payah menyamar.
Dialogue: 0,0:10:34.65,0:10:36.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, hasilnya lumayan.
Dialogue: 0,0:10:37.40,0:10:39.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biaya obatnya kuanggap utang, ya.
Dialogue: 0,0:10:40.10,0:10:43.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kubayar saat sudah bisa\Ntampil di Arena Tarung Gelap.
Dialogue: 0,0:10:47.27,0:10:48.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berapa tahun lagi itu?
Dialogue: 0,0:11:05.55,0:11:07.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, siapa kau?
Dialogue: 0,0:11:08.01,0:11:08.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putrinya.
Dialogue: 0,0:11:10.55,0:11:13.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pu-Putriku.
Dialogue: 0,0:11:14.59,0:11:15.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia putriku!
Dialogue: 0,0:11:35.59,0:11:37.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Cepat mulai!\N- Aku bertaruh pakai utang!
Dialogue: 0,0:11:37.59,0:11:38.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kekerasan di mana-mana.\N- Aku bertaruh pakai utang!
Dialogue: 0,0:11:38.86,0:11:40.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kekerasan di mana-mana.\N- Tunjukkan darah!
Dialogue: 0,0:11:40.74,0:11:44.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aroma dendam, rasa penyesalan,\Ndan semangat bertarung.
Dialogue: 0,0:11:49.03,0:11:50.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luar biasa nikmatnya!
Dialogue: 0,0:11:50.75,0:11:55.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nia Liston: The Merciless Maiden
Dialogue: 0,0:12:06.00,0:12:07.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semangat yang luar biasa.
Dialogue: 0,0:12:13.25,0:12:15.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau anggur, Tuan?
Dialogue: 0,0:12:17.13,0:12:18.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, iya!
Dialogue: 0,0:12:18.90,0:12:22.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona mau jus saja?
Dialogue: 0,0:12:22.85,0:12:23.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:12:25.57,0:12:28.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang, semuanya!
Dialogue: 0,0:12:28.69,0:12:33.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malam ini, darah menetes,\Ndaging terkoyak, dan nyawa melayang!
Dialogue: 0,0:12:33.43,0:12:36.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu pertarungan sengit telah tiba!
Dialogue: 0,0:12:36.24,0:12:39.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan nikmati sepuasnya!
Dialogue: 0,0:12:42.04,0:12:44.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita mulai segera!
Dialogue: 0,0:12:44.46,0:12:46.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama, inilah mereka!
Dialogue: 0,0:12:49.00,0:12:53.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Tinju Merah", Dryjan!
Dialogue: 0,0:12:53.40,0:12:55.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Dryjan!\N- Bantai dia!
Dialogue: 0,0:12:55.34,0:12:57.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melawan "Kaki Tercepat",
Dialogue: 0,0:12:58.61,0:12:59.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Woobie!
Dialogue: 0,0:13:00.02,0:13:00.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Woobie!
Dialogue: 0,0:13:00.82,0:13:02.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Woobie!\N- Hancurkan dia!
Dialogue: 0,0:13:02.58,0:13:03.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bantai!
Dialogue: 0,0:13:04.86,0:13:06.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau bertaruh untuk siapa?
Dialogue: 0,0:13:08.08,0:13:08.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm.
Dialogue: 0,0:13:09.41,0:13:10.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari mereka berdua...
Dialogue: 0,0:13:12.13,0:13:13.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pilih yang bertato.
Dialogue: 0,0:13:13.61,0:13:16.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perkiraanku, dia yang lebih kuat.
Dialogue: 0,0:13:16.26,0:13:18.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi bertaruh itu agak...
Dialogue: 0,0:13:18.61,0:13:21.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah jauh-jauh ke sini, kenapa ragu-ragu?
Dialogue: 0,0:13:21.75,0:13:24.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mumpung sudah datang,\Nnikmati saja sepenuh hati.
Dialogue: 0,0:13:24.85,0:13:25.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:13:26.03,0:13:28.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Uangku tidak banyak.
Dialogue: 0,0:13:28.59,0:13:31.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kalah, aku cuma bisa makan roti nanti.
Dialogue: 0,0:13:32.08,0:13:32.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh?
Dialogue: 0,0:13:33.12,0:13:36.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudnya kau tidak mau mematuhi ucapanku?
Dialogue: 0,0:13:36.74,0:13:38.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pertaruhkan seluruh hartaku!
Dialogue: 0,0:13:38.19,0:13:39.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, Tuan.
Dialogue: 0,0:13:40.04,0:13:43.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertandingan dimulai!
Dialogue: 0,0:14:12.11,0:14:15.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Nia, keringatku terus mengucur.
Dialogue: 0,0:14:15.64,0:14:17.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersikaplah dengan tenang.
Dialogue: 0,0:14:17.91,0:14:19.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ta-Tapi...
Dialogue: 0,0:14:20.17,0:14:22.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belum pernah lihat uang sebanyak ini.
Dialogue: 0,0:14:22.86,0:14:24.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau lebih dari ini, rasanya...
Dialogue: 0,0:14:25.04,0:14:26.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu.
Dialogue: 0,0:14:26.29,0:14:28.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal ini bisa jadi uang jajanmu.
Dialogue: 0,0:14:29.27,0:14:30.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anda yakin mau berhenti?
Dialogue: 0,0:14:30.77,0:14:32.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertandingan utama masih lama.
Dialogue: 0,0:14:32.96,0:14:35.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak. Aku tidak bertaruh lagi.
Dialogue: 0,0:14:40.83,0:14:42.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah!
Dialogue: 0,0:14:42.39,0:14:44.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu untuk bayar minuman.
Dialogue: 0,0:14:44.25,0:14:46.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong diterima tanpa sungkan.
Dialogue: 0,0:14:46.20,0:14:48.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, terima kasih!
Dialogue: 0,0:14:50.61,0:14:52.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Nia, barusan itu...
Dialogue: 0,0:14:52.26,0:14:54.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau terus-terusan menang,
Dialogue: 0,0:14:54.15,0:14:57.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}harus dikembalikan sedikit\Nagar tidak dibenci bandar.
Dialogue: 0,0:14:57.27,0:15:00.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apalagi kita ini pendatang baru.
Dialogue: 0,0:15:01.86,0:15:04.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, dia juga bisa dapat tip.
Dialogue: 0,0:15:05.22,0:15:06.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:15:07.09,0:15:10.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, sekarang ayo fokus pada pertarungan.
Dialogue: 0,0:15:10.25,0:15:11.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:15:11.63,0:15:14.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suasana panggung makin panas!
Dialogue: 0,0:15:14.80,0:15:16.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berikutnya, giliran mereka!
Dialogue: 0,0:15:30.52,0:15:31.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu...
Dialogue: 0,0:15:31.95,0:15:33.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Petarung wanita misterius,
Dialogue: 0,0:15:33.73,0:15:36.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang baru debut, Miss Servant!
Dialogue: 0,0:15:36.77,0:15:40.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seberapa hebat kemampuannya\Ndi panggung besar ini?!
Dialogue: 0,0:15:40.85,0:15:43.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wanita itu memancarkan "Ki".
Dialogue: 0,0:15:44.01,0:15:46.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski masih lemah seperti anak ayam.
Dialogue: 0,0:15:47.37,0:15:49.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lumayan juga wanita itu.
Dialogue: 0,0:15:50.25,0:15:51.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Nia?
Dialogue: 0,0:15:51.63,0:15:53.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lawannya juga kuat atau tidak, ya?
Dialogue: 0,0:15:53.73,0:15:54.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan lawannya adalah...
Dialogue: 0,0:15:55.30,0:15:58.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Kupu-Kupu Malam", Scarlet!
Dialogue: 0,0:15:58.60,0:16:02.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cambuk andalannya kembali\Nmenyebarkan darah segar!
Dialogue: 0,0:16:02.61,0:16:03.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cambuk aku juga!
Dialogue: 0,0:16:03.97,0:16:04.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:16:04.64,0:16:07.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang ini tidak perlu kuingat.
Dialogue: 0,0:16:07.45,0:16:08.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma menang penampilan.
Dialogue: 0,0:16:09.53,0:16:11.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wanita bertopeng yang bakal menang.
Dialogue: 0,0:16:11.37,0:16:12.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Nia.
Dialogue: 0,0:16:12.96,0:16:14.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau serius?
Dialogue: 0,0:16:15.30,0:16:18.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Perhatikan baik-baik.
Dialogue: 0,0:16:18.42,0:16:20.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paling cuma satu serangan.
Dialogue: 0,0:16:20.65,0:16:23.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, itu...
Dialogue: 0,0:16:23.71,0:16:24.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Nia.
Dialogue: 0,0:16:25.29,0:16:28.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin aku cuma salah tebak...
Dialogue: 0,0:16:28.55,0:16:30.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat katakan.
Dialogue: 0,0:16:30.21,0:16:32.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana bilangnya, ya?
Dialogue: 0,0:16:32.50,0:16:35.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, pertandingan dimulai!
Dialogue: 0,0:16:36.88,0:16:39.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah itu pelayanmu?
Dialogue: 0,0:16:39.94,0:16:40.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:16:44.89,0:16:49.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}S-Scarlet langsung terempas!
Dialogue: 0,0:16:50.02,0:16:51.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil.
Dialogue: 0,0:16:52.07,0:16:53.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu...
Dialogue: 0,0:16:53.65,0:16:57.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemenangan untuk Miss Servant!
Dialogue: 0,0:16:58.37,0:17:00.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, Rinokis.
Dialogue: 0,0:17:12.83,0:17:15.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak kusangka dia benaran datang ke sini.
Dialogue: 0,0:17:15.95,0:17:17.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal sudah kularang...
Dialogue: 0,0:17:19.06,0:17:21.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat juga, pendatang baru.
Dialogue: 0,0:17:22.44,0:17:24.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, dengar tida...
Dialogue: 0,0:17:24.46,0:17:26.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan ganggu. Enyah sana.
Dialogue: 0,0:17:41.21,0:17:43.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kenapa Rinokis ada di sini?
Dialogue: 0,0:17:43.75,0:17:46.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa alasannya cuma satu.
Dialogue: 0,0:17:49.03,0:17:52.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau bertarung dengan orang kuat?
Dialogue: 0,0:17:52.14,0:17:53.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan.
Dialogue: 0,0:17:53.56,0:17:55.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia ingin melindungimu.
Dialogue: 0,0:17:55.59,0:17:56.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:17:56.52,0:17:58.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku lebih kuat?
Dialogue: 0,0:17:58.48,0:18:00.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu-Bukan begitu...
Dialogue: 0,0:18:02.67,0:18:04.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:18:05.20,0:18:08.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rinokis selalu mencemaskanku\Ndan keluarga Liston.
Dialogue: 0,0:18:09.31,0:18:11.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia menyembunyikan identitasnya
Dialogue: 0,0:18:11.19,0:18:13.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}agar bisa melindungiku selaku pelayan.
Dialogue: 0,0:18:15.56,0:18:16.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luar biasa.
Dialogue: 0,0:18:16.74,0:18:19.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak kusangka dia akan\Nbertindak sejauh ini.
Dialogue: 0,0:18:19.33,0:18:21.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kalau begini terus...
Dialogue: 0,0:18:21.80,0:18:23.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia bakal melawan Iblis Pedang.
Dialogue: 0,0:18:28.55,0:18:30.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jujur, aku iri.
Dialogue: 0,0:18:31.47,0:18:35.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inilah acara utama malam ini!
Dialogue: 0,0:18:35.41,0:18:37.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemburu imbalan di labirin,
Dialogue: 0,0:18:38.16,0:18:41.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pendekar yang menebas Golem!
Dialogue: 0,0:18:41.29,0:18:43.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Petualang berjuluk Iblis Pedang,
Dialogue: 0,0:18:43.89,0:18:47.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asuma Hinoki!
Dialogue: 0,0:18:47.39,0:18:49.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Itu Iblis Pedang, ya?\N- Maju, Asuma Hinoki!
Dialogue: 0,0:18:52.10,0:18:54.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tipe yang paling kubenci.
Dialogue: 0,0:18:56.19,0:18:57.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu pedang sihir.
Dialogue: 0,0:18:58.00,0:18:58.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang sihir?
Dialogue: 0,0:18:58.98,0:19:01.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang berdaya magis jahat
Dialogue: 0,0:19:01.17,0:19:03.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang mengambil alih kehendak penggunanya.
Dialogue: 0,0:19:04.07,0:19:05.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bisa mengabaikan alasan\Nuntuk tidak menebas,
Dialogue: 0,0:19:06.02,0:19:08.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}seperti akal sehat dan moral.
Dialogue: 0,0:19:08.64,0:19:10.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Singkatnya, kalau memegang pedang itu...
Dialogue: 0,0:19:11.01,0:19:12.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bisa
Dialogue: 0,0:19:12.57,0:19:14.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menebas manusia tanpa ragu.
Dialogue: 0,0:19:15.54,0:19:18.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana bisa bela diri dijadikan kekerasan
Dialogue: 0,0:19:18.66,0:19:21.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan teknik untuk membunuh semata.
Dialogue: 0,0:19:22.58,0:19:25.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akal, kendali diri, keyakinan, ambisi.
Dialogue: 0,0:19:25.90,0:19:27.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah semua itu membaur,
Dialogue: 0,0:19:27.48,0:19:29.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}barulah menjadi bela diri sejati.
Dialogue: 0,0:19:31.05,0:19:34.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beda dari sekadar kekerasan.
Dialogue: 0,0:19:34.82,0:19:38.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Batas antara pedang sihir\Ndan pedang pusaka sangat tipis.
Dialogue: 0,0:19:38.36,0:19:41.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau pedang itu bagus,\Nwajar saja dia ingin memakainya.
Dialogue: 0,0:19:41.86,0:19:46.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asal dia bisa mengendalikannya\Ndengan tekadnya.
Dialogue: 0,0:19:48.81,0:19:51.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asuma melibas enam orang sekaligus!
Dialogue: 0,0:19:51.17,0:19:53.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enam orang langsung tumbang!
Dialogue: 0,0:19:56.97,0:19:58.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mantap!
Dialogue: 0,0:19:58.25,0:19:59.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bantai lagi!
Dialogue: 0,0:20:00.19,0:20:02.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam sekejap mata lagi!
Dialogue: 0,0:20:03.06,0:20:04.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Payah sekali!
Dialogue: 0,0:20:04.47,0:20:06.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kembalikan uangku!
Dialogue: 0,0:20:06.13,0:20:06.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cih!
Dialogue: 0,0:20:07.05,0:20:09.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lawannya terlalu lemah.
Dialogue: 0,0:20:09.38,0:20:12.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau lawannya tidak seimbang,
Dialogue: 0,0:20:12.13,0:20:14.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iblis Pedang juga tidak bisa\Nmengerahkan seluruh kemampuannya.
Dialogue: 0,0:20:16.82,0:20:18.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, aku ingin bertarung.
Dialogue: 0,0:20:18.77,0:20:20.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seberapa hebat dirinya,
Dialogue: 0,0:20:20.40,0:20:24.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ingin kudesak sambil\Nmemeriksa pedang sihir itu.
Dialogue: 0,0:20:24.75,0:20:26.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunjukkan lagi!
Dialogue: 0,0:20:26.20,0:20:27.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa berikutnya?!
Dialogue: 0,0:20:28.02,0:20:29.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harap tenang!
Dialogue: 0,0:20:29.54,0:20:30.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harap tenang!
Dialogue: 0,0:20:31.77,0:20:35.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin melawan Miss Servant!
Dialogue: 0,0:20:36.42,0:20:37.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rinokis!
Dialogue: 0,0:20:47.26,0:20:48.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Servant!
Dialogue: 0,0:20:49.09,0:20:50.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Servant!
Dialogue: 0,0:20:50.94,0:20:52.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Enaknya...\N- Servant!
Dialogue: 0,0:20:52.21,0:20:54.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Aku juga ingin ditantang.\N- Servant!
Dialogue: 0,0:20:54.29,0:20:55.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Servant!
Dialogue: 0,0:20:55.29,0:20:58.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Miss Servant, masuk arena!
Dialogue: 0,0:21:01.74,0:21:04.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa pelayanmu tidak apa-apa?
Dialogue: 0,0:21:05.95,0:21:09.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa dengan kemampuannya sekarang,\Ndia punya peluang menang.
Dialogue: 0,0:21:10.21,0:21:11.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita lihat.
Dialogue: 0,0:21:14.58,0:21:16.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nasibmu buruk.
Dialogue: 0,0:21:27.30,0:21:29.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, pertarungan...
Dialogue: 0,0:21:30.10,0:21:31.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dimulai!
Dialogue: 0,0:22:00.42,0:22:01.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maju!
Dialogue: 0,0:22:01.33,0:22:02.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bunuh dia!
Dialogue: 0,0:22:12.84,0:22:13.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu dulu.
Dialogue: 0,0:22:21.33,0:22:22.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luar biasa.
Dialogue: 0,0:23:55.85,0:23:58.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya,\N"Pedang Sihir sang Iblis Pedang".
