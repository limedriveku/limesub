Dialogue: 0,0:00:12.99,0:00:16.50,sign,,0000,0000,0000,,IBU KOTA KERAJAAN ALTOIRE
Dialogue: 0,0:00:54.53,0:00:56.82,sign,,0000,0000,0000,,PINTU PANGGUNG:\NYANG TIDAK BERKEPENTINGAN DILARANG MASUK
Dialogue: 0,0:01:29.48,0:01:32.98,sign,,0000,0000,0000,,WANITA YANG JATUH CINTA
Dialogue: 0,0:04:47.38,0:04:52.76,sign,,0000,0000,0000,,EPISODE 2: BEKERJA DI IBU KOTA
Dialogue: 0,0:07:54.32,0:07:57.32,sign,,0000,0000,0000,,GRUP TEATER ICE ROSE,\NWANITA YANG JATUH CINTA
Dialogue: 0,0:09:11.91,0:09:14.69,sign,,0000,0000,0000,,GRUP TEATER ICE ROSE,\NWANITA YANG JATUH CINTA
Dialogue: 0,0:14:07.03,0:14:08.35,sign,,0000,0000,0000,,ALUN-ALUN ISTANA KERAJAAN
Dialogue: 0,0:21:23.85,0:21:24.78,sign,,0000,0000,0000,,PERTUNJUKAN PERDANA
Dialogue: 0,0:21:47.86,0:21:50.36,sign,,0000,0000,0000,,GRUP TEATER ICE ROSE,\NWANITA YANG JATUH CINTA
Dialogue: 0,0:23:59.25,0:24:00.13,sign,,0000,0000,0000,,SELANJUTNYA\NSETELAH TIRAI PANGGUNG DITURUNKAN
Dialogue: 0,0:00:22.64,0:00:23.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona!
Dialogue: 0,0:00:23.80,0:00:26.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ikuti saya terus supaya tidak terpisah, ya.
Dialogue: 0,0:00:26.51,0:00:28.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu kota memang luar biasa.
Dialogue: 0,0:00:28.23,0:00:29.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kota yang sangat besar.
Dialogue: 0,0:00:30.59,0:00:31.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agar tidak tersesat,
Dialogue: 0,0:00:32.02,0:00:34.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anda boleh memegang tangan saya.
Dialogue: 0,0:00:34.43,0:00:37.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kedua tanganmu penuh barang, 'kan?
Dialogue: 0,0:00:38.06,0:00:39.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, pegang lengan baju saya saja.
Dialogue: 0,0:00:39.74,0:00:41.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak usah, terima kasih.
Dialogue: 0,0:00:41.74,0:00:42.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, cepat jalan.
Dialogue: 0,0:00:42.93,0:00:44.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona...!
Dialogue: 0,0:00:44.93,0:00:47.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya merasa kesepian!
Dialogue: 0,0:00:57.00,0:00:58.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sini tempatnya.
Dialogue: 0,0:00:59.02,0:01:01.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona, akhirnya kita sampai.
Dialogue: 0,0:01:11.06,0:01:12.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak apa-apa?
Dialogue: 0,0:01:23.04,0:01:25.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar, langsung pergi begitu saja.
Dialogue: 0,0:01:27.98,0:01:29.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang tadi itu...
Dialogue: 0,0:01:51.42,0:01:54.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nia Liston: The Merciless Maiden
Dialogue: 0,0:03:12.97,0:03:14.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salam kenal, Nona Nia.
Dialogue: 0,0:03:16.09,0:03:19.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya Julian Lordheart,\Npemimpin Grup Teater Ice Rose.
Dialogue: 0,0:03:20.15,0:03:22.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya adiknya, Lucida Lordheart.
Dialogue: 0,0:03:24.59,0:03:26.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senang bertemu dengan kalian.
Dialogue: 0,0:03:26.74,0:03:27.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Nia Liston.
Dialogue: 0,0:03:35.12,0:03:35.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,
Dialogue: 0,0:03:36.20,0:03:38.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku bergabung sementara
Dialogue: 0,0:03:38.58,0:03:41.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan grup teatermu, benar begitu, 'kan?
Dialogue: 0,0:03:42.28,0:03:43.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:03:43.49,0:03:45.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya melihat Anda di Magic Vision
Dialogue: 0,0:03:46.00,0:03:48.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan sangat ingin Anda ikut\Npementasan kami kali ini.
Dialogue: 0,0:03:49.72,0:03:50.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:03:52.97,0:03:54.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama-tama,
Dialogue: 0,0:03:57.49,0:04:00.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jangan bicara terlalu formal padaku.
Dialogue: 0,0:04:02.46,0:04:03.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:04:05.53,0:04:09.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ke sini hanya sebagai aktris yang disewa.
Dialogue: 0,0:04:10.02,0:04:12.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama di sini,\Naku bukan putri keluarga Liston,
Dialogue: 0,0:04:13.33,0:04:17.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}anggap aku cuma Nia yang bekerja\Ndi bawah pimpinanmu.
Dialogue: 0,0:04:19.43,0:04:20.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:04:21.26,0:04:23.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon kerja samanya, Nia.
Dialogue: 0,0:04:23.57,0:04:25.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon bantuannya juga.
Dialogue: 0,0:04:30.20,0:04:32.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau memang seperti yang kuduga.
Dialogue: 0,0:04:33.42,0:04:34.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, ada yang ingin kukatakan.
Dialogue: 0,0:04:35.23,0:04:36.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:04:36.80,0:04:39.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata ada alasan khusus kau memanggilku.
Dialogue: 0,0:04:41.37,0:04:42.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya...
Dialogue: 0,0:04:53.61,0:04:55.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau terlambat, anak baru!
Dialogue: 0,0:04:58.18,0:04:59.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}K-Kau...
Dialogue: 0,0:05:02.13,0:05:03.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak yang waktu itu...
Dialogue: 0,0:05:04.48,0:05:05.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Nia Liston.
Dialogue: 0,0:05:06.18,0:05:07.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon kerja samanya.
Dialogue: 0,0:05:08.26,0:05:09.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak ini yang berikutnya?
Dialogue: 0,0:05:09.73,0:05:11.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kali ini akan baik-baik saja?
Dialogue: 0,0:05:13.18,0:05:16.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku tidak peduli\Nkau putri bangsawan atau bukan,
Dialogue: 0,0:05:16.42,0:05:18.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}saat ini kau cuma anak baru!
Dialogue: 0,0:05:19.74,0:05:23.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak baru harusnya datang lebih awal\Ndan membersihkan ruangan!
Dialogue: 0,0:05:23.08,0:05:25.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersihkan seluruh ruang latihan ini!
Dialogue: 0,0:05:27.68,0:05:28.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kuusahakan.
Dialogue: 0,0:05:29.81,0:05:30.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ampun, deh.
Dialogue: 0,0:05:30.95,0:05:32.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya aku benci amatir!
Dialogue: 0,0:05:40.74,0:05:41.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya
Dialogue: 0,0:05:41.79,0:05:43.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk pementasan "Wanita yang Jatuh Cinta",
Dialogue: 0,0:05:44.50,0:05:46.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami menunjuk anak baru\Nsebagai pemeran utama.
Dialogue: 0,0:05:47.12,0:05:48.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemeran utama?
Dialogue: 0,0:05:48.93,0:05:51.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peran janda yang membuang anaknya, 'kan?
Dialogue: 0,0:05:51.57,0:05:52.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:05:52.50,0:05:53.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang dia memang belum terkenal,
Dialogue: 0,0:05:54.04,0:05:56.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi dia akan jadi aktris utama kami.
Dialogue: 0,0:05:57.42,0:05:59.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia berbakat dan berani.
Dialogue: 0,0:06:00.20,0:06:02.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semangatnya juga meluap-luap.
Dialogue: 0,0:06:02.37,0:06:03.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya saja, ada masalah.
Dialogue: 0,0:06:04.42,0:06:06.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semangatnya yang berlebihan
Dialogue: 0,0:06:06.42,0:06:08.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}membuatnya terlalu menekan lawan mainnya, ya?
Dialogue: 0,0:06:08.47,0:06:09.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:06:09.60,0:06:12.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, banyak pemeran tokoh anak\Nyang beradu akting dengannya
Dialogue: 0,0:06:13.10,0:06:15.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sudah mengundurkan diri.
Dialogue: 0,0:06:15.68,0:06:19.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kalian mencari anak\Nbermental kuat dari luar.
Dialogue: 0,0:06:20.80,0:06:21.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:06:21.62,0:06:24.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat memikirkan itu, aku teringat padamu.
Dialogue: 0,0:06:24.66,0:06:28.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau selalu tenang di Magic Vision,
Dialogue: 0,0:06:28.30,0:06:30.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi kupikir kau akan sanggup\Nberadu akting dengannya.
Dialogue: 0,0:06:31.06,0:06:31.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula,
Dialogue: 0,0:06:32.07,0:06:34.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}popularitasmu di ibu kota sedang naik pesat.
Dialogue: 0,0:06:35.62,0:06:39.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudmu, sebagai lawan main aktris\Nyang terlalu bersemangat ini,
Dialogue: 0,0:06:39.77,0:06:43.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau mau memanfaatkanku\Ndemi menaikkan popularitasnya?
Dialogue: 0,0:06:44.68,0:06:45.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nia,
Dialogue: 0,0:06:45.92,0:06:49.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa kau mau membantu siasat licik\Norang dewasa ini?
Dialogue: 0,0:06:52.62,0:06:54.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terserah kalian saja.
Dialogue: 0,0:06:54.98,0:06:57.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma akan melakukan pekerjaanku.
Dialogue: 0,0:07:00.18,0:07:01.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ini berhasil,
Dialogue: 0,0:07:01.31,0:07:04.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}popularitasku di ibu kota\Nakan makin meningkat.
Dialogue: 0,0:07:04.95,0:07:08.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan begitu,\Naku bisa membantu penyebaran Magic Vision.
Dialogue: 0,0:07:10.35,0:07:11.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti dugaanku...
Dialogue: 0,0:07:11.74,0:07:12.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:07:12.93,0:07:14.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau anak yang sesuai harapanku.
Dialogue: 0,0:07:32.56,0:07:35.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pagi-pagi begini, kau sedang apa?
Dialogue: 0,0:07:36.42,0:07:37.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baru saja membersihkan ruangan.
Dialogue: 0,0:07:42.93,0:07:44.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau melakukan ini sendirian?
Dialogue: 0,0:07:45.10,0:07:47.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, ini kan tugas anak baru.
Dialogue: 0,0:07:50.01,0:07:51.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sih, memang sudah seharusnya!
Dialogue: 0,0:08:01.17,0:08:02.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namaku Sharro White.
Dialogue: 0,0:08:04.54,0:08:06.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon kerja samanya, Sharro.
Dialogue: 0,0:08:10.47,0:08:11.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Selamat pagi!\N- Selamat pagi!
Dialogue: 0,0:08:12.02,0:08:13.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat pagi!
Dialogue: 0,0:08:13.22,0:08:14.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita mulai!
Dialogue: 0,0:08:18.13,0:08:20.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita latihan baca naskah, amatir!
Dialogue: 0,0:08:21.06,0:08:22.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon bantuannya.
Dialogue: 0,0:08:22.74,0:08:24.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah membacanya?
Dialogue: 0,0:08:24.10,0:08:25.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, sudah berkali-kali.
Dialogue: 0,0:08:26.24,0:08:27.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski aku masih amatir,
Dialogue: 0,0:08:27.99,0:08:30.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan berusaha sepenuh hati.
Dialogue: 0,0:08:31.45,0:08:32.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuingatkan, ya.
Dialogue: 0,0:08:32.82,0:08:36.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akting bukan sekadar menghafal\Nlalu mengucapkan dialog!
Dialogue: 0,0:08:36.45,0:08:39.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akting lahir dari interaksi\Ndengan lawan main!
Dialogue: 0,0:08:39.66,0:08:40.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti.
Dialogue: 0,0:08:41.79,0:08:42.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ampun, deh.
Dialogue: 0,0:08:42.96,0:08:44.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar amatir.
Dialogue: 0,0:09:14.74,0:09:15.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei.
Dialogue: 0,0:09:16.26,0:09:17.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan yang tadi itu?
Dialogue: 0,0:09:18.03,0:09:21.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kan tidak salah mengucapkan dialog.
Dialogue: 0,0:09:23.01,0:09:27.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa aku harus mengajari\Namatir seperti ini?
Dialogue: 0,0:09:28.59,0:09:30.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bukan cuma soal salah dialog!
Dialogue: 0,0:09:31.17,0:09:34.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ini ibu yang membuangmu!
Dialogue: 0,0:09:34.66,0:09:39.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aneh kalau kau bisa bicara selancar itu\Ndi depan ibu yang telah membuangmu!
Dialogue: 0,0:09:39.51,0:09:40.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:09:42.79,0:09:44.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beraktinglah dengan perasaan!
Dialogue: 0,0:09:45.44,0:09:47.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berakting dengan perasaan...
Dialogue: 0,0:09:49.46,0:09:52.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua orang di sini serius.
Dialogue: 0,0:09:52.35,0:09:54.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau ada amatir\Nyang menghambat kami!
Dialogue: 0,0:09:57.25,0:09:59.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi, bisa minggir sebentar?
Dialogue: 0,0:10:10.17,0:10:11.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya nostalgia sekali.
Dialogue: 0,0:10:12.34,0:10:14.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membersihkan tempat latihan
Dialogue: 0,0:10:14.35,0:10:16.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah bentuk hormat dalam bela diri.
Dialogue: 0,0:10:16.72,0:10:18.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teater pun sama saja.
Dialogue: 0,0:10:24.64,0:10:25.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona.
Dialogue: 0,0:10:26.29,0:10:27.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:10:27.12,0:10:30.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau kita bunuh dia?
Dialogue: 0,0:10:31.77,0:10:32.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan.
Dialogue: 0,0:10:33.38,0:10:36.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan kembalikan properti itu.
Dialogue: 0,0:10:36.65,0:10:41.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wanita itu seenaknya mengomeli Anda.
Dialogue: 0,0:10:41.70,0:10:43.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah!
Dialogue: 0,0:10:43.58,0:10:46.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesal sekali!
Dialogue: 0,0:10:46.83,0:10:48.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan dihiraukan.
Dialogue: 0,0:10:48.26,0:10:50.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya, biar saya bantu bersih-bersih.
Dialogue: 0,0:10:51.25,0:10:52.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini tugasku.
Dialogue: 0,0:10:53.97,0:10:56.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona!
Dialogue: 0,0:10:56.59,0:10:59.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya kesepian!
Dialogue: 0,0:10:59.22,0:11:00.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau ekspresif banget.
Dialogue: 0,0:11:00.97,0:11:03.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malah kau yang lebih cocok jadi aktris.
Dialogue: 0,0:11:04.66,0:11:08.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu saya, Nona!
Dialogue: 0,0:11:16.65,0:11:18.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Tunggu, Ibu!"
Dialogue: 0,0:11:18.85,0:11:21.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Tunggu, Ibu! Kenapa bicara begitu?"
Dialogue: 0,0:11:28.29,0:11:29.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat pagi, semuanya!
Dialogue: 0,0:11:29.17,0:11:30.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Selamat pagi!\N- Pagi!
Dialogue: 0,0:11:30.21,0:11:31.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, kita mulai latihan hari ini!
Dialogue: 0,0:11:32.24,0:11:33.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai dari peregangan dulu!
Dialogue: 0,0:11:33.67,0:11:34.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:11:38.32,0:11:39.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau kubantu dorong?
Dialogue: 0,0:11:39.73,0:11:41.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu!
Dialogue: 0,0:11:41.80,0:11:45.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagian, kenapa kau bisa selentur itu?
Dialogue: 0,0:11:46.10,0:11:48.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelenturan penting untuk bela diri.
Dialogue: 0,0:11:48.94,0:11:50.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sini, jangan malu-malu.
Dialogue: 0,0:11:50.42,0:11:52.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu... jangan sentuh aku!
Dialogue: 0,0:11:52.29,0:11:53.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aduh, sakit!
Dialogue: 0,0:11:53.44,0:11:54.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sakit! Sakit!
Dialogue: 0,0:11:54.10,0:11:56.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kaku sekali, ya.\N- Sakit! Sakit! Jangan! Sakit!
Dialogue: 0,0:11:56.32,0:11:58.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kaku banget.\N- Kubilang sakit, tahu!
Dialogue: 0,0:12:01.53,0:12:02.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar...
Dialogue: 0,0:12:02.63,0:12:04.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita baca dialog lagi.
Dialogue: 0,0:12:05.15,0:12:06.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini, kau tidak mengucapkannya?
Dialogue: 0,0:12:06.55,0:12:07.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Mengucapkan apa?
Dialogue: 0,0:12:09.12,0:12:12.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Kenapa aku harus mengajari amatir?"
Dialogue: 0,0:12:13.92,0:12:16.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar... kau tidak ada manis-manisnya.
Dialogue: 0,0:12:16.08,0:12:18.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, kau sudah mulai santai, ya.
Dialogue: 0,0:12:19.30,0:12:21.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita mulai, Nia.
Dialogue: 0,0:12:22.17,0:12:22.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:12:24.10,0:12:25.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, Ibu!
Dialogue: 0,0:12:25.95,0:12:27.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lepaskan, Sachute.
Dialogue: 0,0:12:27.84,0:12:30.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bukan ibumu lagi.
Dialogue: 0,0:13:08.34,0:13:09.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah lumayan bagus,
Dialogue: 0,0:13:10.16,0:13:12.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi dialog ini berisi kesedihan mendalam...
Dialogue: 0,0:13:12.62,0:13:13.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona.
Dialogue: 0,0:13:14.29,0:13:15.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah waktunya.
Dialogue: 0,0:13:16.24,0:13:17.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau pergi?
Dialogue: 0,0:13:17.27,0:13:18.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syuting, 'kan?
Dialogue: 0,0:13:18.49,0:13:21.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, "Kunjungan Profesi" seperti biasa,
Dialogue: 0,0:13:21.32,0:13:23.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan ada satu hal lagi.
Dialogue: 0,0:13:23.75,0:13:24.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:13:24.75,0:13:26.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sebentar, tidak masalah.
Dialogue: 0,0:13:27.22,0:13:28.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pimpinan!
Dialogue: 0,0:13:28.65,0:13:32.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Promosi pementasan kita\Nbisa masuk ke Magic Vision!
Dialogue: 0,0:13:33.01,0:13:33.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:13:35.53,0:13:36.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sharro, pergilah!
Dialogue: 0,0:13:37.92,0:13:38.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, tunggu dulu!
Dialogue: 0,0:13:38.93,0:13:40.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapkan kostum dan riasannya!
Dialogue: 0,0:13:41.00,0:13:41.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:13:42.25,0:13:45.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau syuting acaraku,\Njadi aku berangkat dulu.
Dialogue: 0,0:13:46.31,0:13:47.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti kau menyusul, ya.
Dialogue: 0,0:13:47.85,0:13:49.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}E-Eh?
Dialogue: 0,0:13:49.78,0:13:53.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belum pernah tampil di Magic Vision.
Dialogue: 0,0:13:53.30,0:13:55.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa ragu?
Dialogue: 0,0:13:55.53,0:13:57.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini pementasan pertamamu\Nsebagai pemeran utama.
Dialogue: 0,0:13:58.32,0:14:00.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pasti ingin ini sukses, 'kan?
Dialogue: 0,0:14:02.00,0:14:05.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, tidak ada alasan menolak.
Dialogue: 0,0:14:05.20,0:14:06.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nia Liston: The Merciless Maiden
Dialogue: 0,0:14:08.39,0:14:09.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, sekian dulu.
Dialogue: 0,0:14:10.03,0:14:13.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai jumpa\Ndi "Kunjungan Profesi Nia Liston" berikutnya!
Dialogue: 0,0:14:14.12,0:14:15.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cut!
Dialogue: 0,0:14:16.21,0:14:18.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus sekali, Nia! Hebat!
Dialogue: 0,0:14:18.96,0:14:20.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah ini kita akan pindah lokasi,
Dialogue: 0,0:14:20.82,0:14:22.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi tunggu sebentar, ya.
Dialogue: 0,0:14:22.29,0:14:23.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:14:23.34,0:14:24.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan, Nia.
Dialogue: 0,0:14:25.62,0:14:28.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona, bisa bicara sebentar?
Dialogue: 0,0:14:29.00,0:14:29.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:14:31.91,0:14:34.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sharro White diganggu preman.
Dialogue: 0,0:14:35.56,0:14:37.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Saat kucari karena dia lama,\N- Lebih bagus di depan teater, 'kan?
Dialogue: 0,0:14:37.62,0:14:38.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- dia di gang belakang teater.\N- Lebih bagus di depan teater, 'kan?
Dialogue: 0,0:14:38.59,0:14:39.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- dia di gang belakang teater.\N- Dimengerti.
Dialogue: 0,0:14:39.62,0:14:41.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak menolongnya?
Dialogue: 0,0:14:42.42,0:14:45.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya ini pelayan sekaligus pengawal Anda.
Dialogue: 0,0:14:46.26,0:14:47.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutku itu sudah benar.
Dialogue: 0,0:14:48.03,0:14:50.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau cuma setia pada tugasmu
Dialogue: 0,0:14:50.52,0:14:52.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan lebih mengutamakanku daripada Sharro.
Dialogue: 0,0:14:53.23,0:14:56.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kalau ada perintah...
Dialogue: 0,0:14:56.33,0:14:57.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau disuruh menolong, saya akan...
Dialogue: 0,0:14:58.01,0:15:00.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat panggil penjaga atau milisi!
Dialogue: 0,0:15:00.50,0:15:01.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya menger...
Dialogue: 0,0:15:01.77,0:15:02.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:15:03.80,0:15:04.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Panggil bantuan?
Dialogue: 0,0:15:04.84,0:15:07.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Calon aktris utama sedang dalam bahaya!
Dialogue: 0,0:15:07.27,0:15:08.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat!
Dialogue: 0,0:15:12.42,0:15:13.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona.
Dialogue: 0,0:15:14.04,0:15:15.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anda tidak akan pergi, 'kan?
Dialogue: 0,0:15:15.95,0:15:17.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudmu apa?
Dialogue: 0,0:15:17.54,0:15:20.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anda tidak akan pergi\Nmenolong wanita itu, 'kan?
Dialogue: 0,0:15:20.90,0:15:21.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bilang,
Dialogue: 0,0:15:21.92,0:15:25.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Ada orang yang bisa dipukuli, asyik banget!"
Dialogue: 0,0:15:25.61,0:15:27.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anda tidak berpikir begitu, 'kan?
Dialogue: 0,0:15:28.87,0:15:30.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin aku berpikir begitu!
Dialogue: 0,0:15:30.34,0:15:31.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat pergi sana!
Dialogue: 0,0:15:32.01,0:15:33.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat, buruan!
Dialogue: 0,0:15:36.45,0:15:37.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, dia sudah pergi.
Dialogue: 0,0:15:40.10,0:15:41.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat!
Dialogue: 0,0:15:44.41,0:15:46.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kali ini dia benaran pergi, 'kan?
Dialogue: 0,0:15:50.61,0:15:52.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, hebat sekali!
Dialogue: 0,0:15:52.86,0:15:54.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak jadi Nia,
Dialogue: 0,0:15:54.13,0:15:57.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ini pertama kalinya aku sangat bersemangat!
Dialogue: 0,0:15:58.24,0:16:00.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo? Nia ke mana?
Dialogue: 0,0:16:00.69,0:16:01.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entahlah.
Dialogue: 0,0:16:03.22,0:16:05.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan, sih? Lepaskan!
Dialogue: 0,0:16:13.38,0:16:16.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau menggoda kami dengan baju itu, 'kan?
Dialogue: 0,0:16:16.41,0:16:19.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kami temani bermain, Nona Manis.
Dialogue: 0,0:16:21.36,0:16:22.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pe-Permisi...
Dialogue: 0,0:16:22.66,0:16:23.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:16:24.99,0:16:27.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku... boleh ikut gabung?
Dialogue: 0,0:16:27.88,0:16:29.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa bocah ini?
Dialogue: 0,0:16:29.95,0:16:30.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nia?
Dialogue: 0,0:16:31.01,0:16:33.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan mendekat! Cepat panggil bantuan!
Dialogue: 0,0:16:33.55,0:16:34.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waduh.
Dialogue: 0,0:16:36.62,0:16:38.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkat bocah bodoh ini,
Dialogue: 0,0:16:38.30,0:16:39.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}urusan kita jadi makin mudah.
Dialogue: 0,0:16:39.95,0:16:41.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paham, 'kan?
Dialogue: 0,0:16:41.40,0:16:42.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kau melawan,
Dialogue: 0,0:16:42.94,0:16:44.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kupatahkan tangan bocah ini!
Dialogue: 0,0:16:44.98,0:16:46.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}He-Hentikan!
Dialogue: 0,0:16:47.13,0:16:47.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei.
Dialogue: 0,0:16:48.07,0:16:48.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:16:49.17,0:16:52.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini berarti kalian sudah melibatkanku, 'kan?
Dialogue: 0,0:16:53.62,0:16:55.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti ini pembelaan diri, 'kan?
Dialogue: 0,0:16:55.70,0:16:56.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:16:56.58,0:16:57.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yakin, nih?
Dialogue: 0,0:16:57.90,0:17:00.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak menggenggamku lebih kuat,
Dialogue: 0,0:17:00.33,0:17:01.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa kupatahkan tanganmu, lo.
Dialogue: 0,0:17:11.47,0:17:14.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku lebih suka lawan yang lebih kuat.
Dialogue: 0,0:17:15.78,0:17:18.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, jumlah kalian lumayanlah.
Dialogue: 0,0:17:18.74,0:17:21.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian boleh pakai pisau, kok.
Dialogue: 0,0:17:21.28,0:17:22.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keluarkan saja.
Dialogue: 0,0:17:22.84,0:17:25.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa bocah ini?!
Dialogue: 0,0:17:25.71,0:17:27.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beraninya meremehkan kami!
Dialogue: 0,0:17:27.42,0:17:28.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Majulah!
Dialogue: 0,0:17:29.38,0:17:30.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mampus kau!
Dialogue: 0,0:17:33.27,0:17:35.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasakan ini!
Dialogue: 0,0:17:51.14,0:17:52.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bo-Bocah ini!
Dialogue: 0,0:17:52.70,0:17:54.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau kubunuh, ya?!
Dialogue: 0,0:17:54.05,0:17:55.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nia, lari!
Dialogue: 0,0:17:56.78,0:17:58.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, akhirnya pakai pisau?
Dialogue: 0,0:17:58.28,0:17:59.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mantap, nih.
Dialogue: 0,0:17:59.74,0:18:00.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sialan kau!
Dialogue: 0,0:18:00.84,0:18:02.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nia!
Dialogue: 0,0:18:03.30,0:18:04.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mati kau!
Dialogue: 0,0:18:15.61,0:18:17.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Sudah selesai?
Dialogue: 0,0:18:18.43,0:18:19.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan...?
Dialogue: 0,0:18:20.45,0:18:23.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa sebenarnya bocah ini?!
Dialogue: 0,0:18:25.10,0:18:26.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membosankan sekali.
Dialogue: 0,0:18:26.29,0:18:29.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pikir kami ini siapa?!
Dialogue: 0,0:18:29.08,0:18:30.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau tidak lihat lambang ini?!
Dialogue: 0,0:18:31.63,0:18:32.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lambang?
Dialogue: 0,0:18:33.54,0:18:36.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan, kalian mafia?
Dialogue: 0,0:18:36.51,0:18:38.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, kalian punya kawanan, 'kan?
Dialogue: 0,0:18:38.18,0:18:39.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka pasti kuat, 'kan?
Dialogue: 0,0:18:39.65,0:18:41.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengandalkan jumlah juga boleh.\NAda seratus orang?
Dialogue: 0,0:18:41.63,0:18:42.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau lebih banyak daripada itu?
Dialogue: 0,0:18:43.73,0:18:45.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, aku tidak berniat menghancurkan kalian,
Dialogue: 0,0:18:45.35,0:18:46.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tenang saja.
Dialogue: 0,0:18:47.25,0:18:48.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi
Dialogue: 0,0:18:48.57,0:18:51.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kumpulkan orang-orang yang lebih kuat, ya?
Dialogue: 0,0:18:51.54,0:18:53.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa kau sebenarnya?!
Dialogue: 0,0:18:53.56,0:18:54.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:18:54.88,0:18:57.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malam hari, dua minggu lagi,\Naku akan mendatangi kalian.
Dialogue: 0,0:18:57.68,0:18:59.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersiaplah dengan baik, ya.
Dialogue: 0,0:18:59.74,0:19:01.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengerti? Janji, ya?
Dialogue: 0,0:19:02.14,0:19:03.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kalian melanggar...
Dialogue: 0,0:19:04.85,0:19:05.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan marah.
Dialogue: 0,0:19:13.44,0:19:15.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sharro, ayo pergi.
Dialogue: 0,0:19:16.10,0:19:17.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sharro?
Dialogue: 0,0:19:17.43,0:19:18.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya.
Dialogue: 0,0:19:29.81,0:19:32.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pementasan Grup Teater Ice Rose\N"Wanita yang Jatuh Cinta".
Dialogue: 0,0:19:32.91,0:19:35.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami tunggu kedatangan Anda di teater!
Dialogue: 0,0:19:35.54,0:19:37.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cut! Oke!
Dialogue: 0,0:19:37.86,0:19:39.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sempurna, Nia!
Dialogue: 0,0:19:39.99,0:19:42.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Tuan Bendelio.
Dialogue: 0,0:19:42.96,0:19:44.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sharro juga.
Dialogue: 0,0:19:44.34,0:19:46.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pasti akan menonton pementasannya.
Dialogue: 0,0:19:46.99,0:19:48.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baik!
Dialogue: 0,0:19:51.94,0:19:54.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, yang tadi itu apa-apaan?
Dialogue: 0,0:19:55.75,0:19:56.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudmu?
Dialogue: 0,0:19:57.14,0:19:59.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma datang menolongmu.
Dialogue: 0,0:19:59.11,0:20:00.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bohong banget.
Dialogue: 0,0:20:00.61,0:20:03.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau terlihat senang sekali menyiksa mereka!
Dialogue: 0,0:20:03.35,0:20:05.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau cuma ingin menghajar orang, 'kan?
Dialogue: 0,0:20:05.81,0:20:07.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jahat sekali tuduhanmu.
Dialogue: 0,0:20:07.28,0:20:11.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku langsung bergegas\Nke sana demi menolongmu.
Dialogue: 0,0:20:11.34,0:20:12.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dilihat dari mana pun,
Dialogue: 0,0:20:12.70,0:20:15.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}keselamatanku itu urusan belakangan.
Dialogue: 0,0:20:18.25,0:20:20.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudahlah, ayo kembali ke tempat latihan.
Dialogue: 0,0:20:21.38,0:20:23.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu kita sampai hari pementasan\Ntinggal sedikit.
Dialogue: 0,0:20:24.45,0:20:25.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}He-Hei...
Dialogue: 0,0:20:28.42,0:20:31.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimanapun juga, aku harus berterima kasih.
Dialogue: 0,0:20:34.31,0:20:35.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:20:42.75,0:20:46.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keinginan memukuli preman\Ndan menolong Sharro,
Dialogue: 0,0:20:46.60,0:20:49.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sejujurnya sama besarnya, sih.
Dialogue: 0,0:21:24.83,0:21:26.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi tidak sabar!
Dialogue: 0,0:21:26.26,0:21:27.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, nih!
Dialogue: 0,0:21:27.49,0:21:29.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini pementasan anak baru itu, 'kan?
Dialogue: 0,0:21:29.15,0:21:31.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Pementasan "Wanita yang Jatuh Cinta"!\N- Ya, benar.
Dialogue: 0,0:21:32.21,0:21:34.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami tunggu kedatangan Anda di teater!
Dialogue: 0,0:21:37.09,0:21:37.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya!
Dialogue: 0,0:21:38.46,0:21:40.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiket untuk area berdiri pun sudah habis\Nsejak hari pertama!
Dialogue: 0,0:21:40.88,0:21:43.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Efek Magic Vision luar biasa!
Dialogue: 0,0:21:43.50,0:21:45.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, saatnya pementasan!
Dialogue: 0,0:21:45.53,0:21:46.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo tunjukkan semangat kalian!
Dialogue: 0,0:21:46.82,0:21:47.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:21:51.20,0:21:52.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luar biasa...
Dialogue: 0,0:21:52.53,0:21:53.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kursinya penuh!
Dialogue: 0,0:21:54.07,0:21:55.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau gugup?
Dialogue: 0,0:21:56.09,0:21:57.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak apa-apa.
Dialogue: 0,0:21:57.42,0:21:58.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama bersamamu...
Dialogue: 0,0:22:00.58,0:22:01.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita berikan yang terbaik!
Dialogue: 0,0:22:01.95,0:22:03.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski aku masih amatir,
Dialogue: 0,0:22:03.81,0:22:06.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan berusaha sepenuh hati.
Dialogue: 0,0:22:06.36,0:22:07.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan padaku.
Dialogue: 0,0:22:11.25,0:22:14.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan membimbing si amatir ini\Nsampai akhir.
Dialogue: 0,0:22:15.38,0:22:16.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo!
Dialogue: 0,0:23:56.11,0:23:59.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya,\N"Setelah Tirai Panggung Diturunkan".
