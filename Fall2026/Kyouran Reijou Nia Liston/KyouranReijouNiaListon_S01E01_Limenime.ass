Dialogue: 0,0:00:04.98,0:00:06.99,sign,,0000,0000,0000,,STASIUN PENYIARAN WILAYAH LISTON,\NSIARAN KHUSUS
Dialogue: 0,0:05:29.26,0:05:33.98,sign,,0000,0000,0000,,EPISODE 1: MUNCUL DARI KEGELAPAN
Dialogue: 0,0:08:59.19,0:09:00.10,sign,,0000,0000,0000,,RAJA, BANGSAWAN, RAKYAT BIASA
Dialogue: 0,0:14:45.32,0:14:47.74,sign,,0000,0000,0000,,SETAHUN YANG LALU
Dialogue: 0,0:15:02.04,0:15:03.29,sign,,0000,0000,0000,,STASIUN PENYIARAN WILAYAH LISTON,\NSIARAN KHUSUS
Dialogue: 0,0:23:58.96,0:24:00.00,sign,,0000,0000,0000,,SELANJUTNYA: PEKERJAAN DI IBU KOTA
Dialogue: 0,0:00:09.63,0:00:12.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salam kenal, rakyat Kerajaan Altoire.
Dialogue: 0,0:00:13.15,0:00:15.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya Nia Liston.
Dialogue: 0,0:00:17.76,0:00:19.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekacauan besar di dunia...
Dialogue: 0,0:00:20.01,0:00:21.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik atau buruk,
Dialogue: 0,0:00:21.98,0:00:23.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dari sudut pandang yang berbeda,
Dialogue: 0,0:00:24.39,0:00:25.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mereka yang memicu revolusi
Dialogue: 0,0:00:25.85,0:00:27.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pasti menjadi pahlawan bagi seseorang.
Dialogue: 0,0:00:29.46,0:00:33.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nama pahlawan terbaru di era ini,
Dialogue: 0,0:00:33.06,0:00:35.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan mulai dicatat.
Dialogue: 0,0:00:45.70,0:00:47.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Hujan Merah",\Npembantai monster dengan tangan kosong.
Dialogue: 0,0:00:49.32,0:00:50.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Tarian Kehancuran".
Dialogue: 0,0:00:59.90,0:01:01.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Malaikat Mengamuk".
Dialogue: 0,0:01:02.75,0:01:05.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia punya banyak julukan,
Dialogue: 0,0:01:05.57,0:01:07.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi yang paling terkenal adalah...
Dialogue: 0,0:01:22.56,0:01:24.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nia Liston si Gadis Liar.
Dialogue: 0,0:01:25.73,0:01:28.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini kisah tentang pertarungannya yang megah
Dialogue: 0,0:01:28.81,0:01:30.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hingga pantas disebut pahlawan.
Dialogue: 0,0:01:39.70,0:01:43.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin mati saat bertarung.
Dialogue: 0,0:01:46.37,0:01:49.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak pernah menginginkan\Nkematian yang tenang.
Dialogue: 0,0:01:49.50,0:01:50.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin dagingku tercabik,
Dialogue: 0,0:01:50.59,0:01:51.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tulangku patah,
Dialogue: 0,0:01:51.67,0:01:52.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}darahku mengucur,
Dialogue: 0,0:01:53.48,0:01:56.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu aku jatuh tersungkur\Nsaat kehabisan tenaga.
Dialogue: 0,0:01:58.75,0:02:00.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya
Dialogue: 0,0:02:00.62,0:02:05.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ingin bertemu dengan orang\Nyang lebih kuat dariku.
Dialogue: 0,0:02:06.51,0:02:07.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi kali ini...
Dialogue: 0,0:02:07.87,0:02:09.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kali ini pasti...
Dialogue: 0,0:02:10.81,0:02:14.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pasti akan menemukan sosok\Nyang bisa membunuhku.
Dialogue: 0,0:02:14.65,0:02:19.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nia Liston: The Merciless Maiden
Dialogue: 0,0:02:22.96,0:02:23.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nia!
Dialogue: 0,0:02:23.56,0:02:24.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Nia!\N- Nona Nia!
Dialogue: 0,0:02:24.61,0:02:25.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Nia!\N- Nona Nia!
Dialogue: 0,0:02:25.40,0:02:25.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Nia!
Dialogue: 0,0:02:26.03,0:02:26.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nia!
Dialogue: 0,0:02:26.80,0:02:27.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Nona Nia!\N- Nona!
Dialogue: 0,0:02:27.87,0:02:28.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nia!
Dialogue: 0,0:02:32.50,0:02:33.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini?
Dialogue: 0,0:02:33.62,0:02:35.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang terjadi?
Dialogue: 0,0:02:35.63,0:02:37.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tubuh ini... akan mati!
Dialogue: 0,0:02:44.56,0:02:46.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di mana ini?
Dialogue: 0,0:02:49.18,0:02:50.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah.
Dialogue: 0,0:02:50.46,0:02:53.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berapa kali pun dialami,\Nkematian tetap menakutkan.
Dialogue: 0,0:02:54.12,0:02:56.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berapa kali pun dialami?
Dialogue: 0,0:02:57.18,0:02:58.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah tenang?
Dialogue: 0,0:03:00.63,0:03:01.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku punya satu permintaan.
Dialogue: 0,0:03:01.81,0:03:03.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hiduplah sehari saja.
Dialogue: 0,0:03:04.46,0:03:06.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jelaskan alasannya.
Dialogue: 0,0:03:06.99,0:03:09.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memakai sihir terlarang demi uang.
Dialogue: 0,0:03:09.78,0:03:12.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jiwa dari tubuh ini sudah tiada,
Dialogue: 0,0:03:12.68,0:03:14.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi aku memasukkan penggantinya.
Dialogue: 0,0:03:14.34,0:03:15.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kaulah orangnya.
Dialogue: 0,0:03:15.52,0:03:18.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jiwa pengganti?
Dialogue: 0,0:03:18.58,0:03:22.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tubuh itu milik putri bangsawan kelas atas.
Dialogue: 0,0:03:23.21,0:03:26.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang tuanya tak ingin dia mati,\Njadi mereka menyewaku.
Dialogue: 0,0:03:27.59,0:03:29.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak tahu siapa kau.
Dialogue: 0,0:03:29.90,0:03:30.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku mohon.
Dialogue: 0,0:03:30.86,0:03:32.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai aku menerima uangnya
Dialogue: 0,0:03:32.40,0:03:34.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan pergi dari pulau ini, tetaplah hidup.
Dialogue: 0,0:03:34.99,0:03:36.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak saja bicara begitu...
Dialogue: 0,0:03:36.81,0:03:38.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benar-benar minta maaf.
Dialogue: 0,0:03:38.21,0:03:40.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kita bertemu di neraka,\Nkau boleh membunuhku.
Dialogue: 0,0:03:45.78,0:03:46.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi
Dialogue: 0,0:03:46.96,0:03:49.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau membangkitkan aku yang sudah mati,
Dialogue: 0,0:03:50.11,0:03:53.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu memasukkanku ke tubuh penyakitan
Dialogue: 0,0:03:53.62,0:03:55.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang sebentar lagi akan mati ini?
Dialogue: 0,0:03:56.12,0:03:58.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya untuk membuatku bertahan hidup sehari?
Dialogue: 0,0:04:06.09,0:04:09.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bukan aku, orang lain pasti sudah mati.
Dialogue: 0,0:04:10.15,0:04:12.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Nia!\N- Tunggu, aku bisa mati!
Dialogue: 0,0:04:12.28,0:04:13.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mati karena diguncang!
Dialogue: 0,0:04:13.62,0:04:15.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Syukurlah! Ini nyata!\N- Nia masih hidup!
Dialogue: 0,0:04:15.74,0:04:17.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang, aku masih hidup!
Dialogue: 0,0:04:17.76,0:04:19.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nia!
Dialogue: 0,0:04:19.06,0:04:20.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan mengguncangku.
Dialogue: 0,0:04:22.37,0:04:24.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cukup, kalian berdua.
Dialogue: 0,0:04:24.94,0:04:27.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biarkan dia beristirahat dengan tenang dulu.
Dialogue: 0,0:04:31.50,0:04:32.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi begitu.
Dialogue: 0,0:04:32.95,0:04:35.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nama tubuh ini Nia, ya?
Dialogue: 0,0:04:35.86,0:04:37.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, apa pun itu,
Dialogue: 0,0:04:38.08,0:04:40.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pertama-tama aku harus mengalahkan\Npenyakit ini.
Dialogue: 0,0:04:41.13,0:04:43.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pusat penyakitnya... di paru-paru?
Dialogue: 0,0:04:48.75,0:04:50.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, begini cukup.
Dialogue: 0,0:04:50.99,0:04:52.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama bisa mengendalikan "Ki",
Dialogue: 0,0:04:52.22,0:04:54.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}penyakit begini bukan masalah.
Dialogue: 0,0:04:59.00,0:05:00.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi sebenarnya,
Dialogue: 0,0:05:00.69,0:05:02.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}siapa aku ini?
Dialogue: 0,0:05:02.91,0:05:05.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa menggunakan "Ki" secara alami,
Dialogue: 0,0:05:06.22,0:05:09.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apakah ini ingatan yang terukir di jiwaku?
Dialogue: 0,0:05:11.77,0:05:12.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak ingat.
Dialogue: 0,0:05:13.12,0:05:16.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi seiring berjalannya waktu,
Dialogue: 0,0:05:16.06,0:05:18.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}setelah menebas daging dan bersimbah darah,
Dialogue: 0,0:05:18.50,0:05:20.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku pasti akan mengingat\Nhal-hal yang penting.
Dialogue: 0,0:05:21.87,0:05:23.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu terburu-buru.
Dialogue: 0,0:05:24.00,0:05:24.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nia.
Dialogue: 0,0:05:25.32,0:05:27.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari esok yang telah hilang darimu,
Dialogue: 0,0:05:27.31,0:05:28.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan kujalani untukmu.
Dialogue: 0,0:05:37.23,0:05:39.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona, permisi.
Dialogue: 0,0:05:40.82,0:05:42.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana keadaan Anda?
Dialogue: 0,0:05:44.63,0:05:46.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wanita ini kuat.
Dialogue: 0,0:05:47.25,0:05:49.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gerakan dan langkahnya tanpa celah,
Dialogue: 0,0:05:49.50,0:05:51.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}postur tubuhnya juga kokoh.
Dialogue: 0,0:05:51.74,0:05:54.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutku dia terlalu kurus,
Dialogue: 0,0:05:54.62,0:05:57.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi perbedaan fisik bisa diimbangi\Ndengan senjata.
Dialogue: 0,0:05:58.25,0:06:01.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, tampaknya dia\Nmemang menyembunyikan senjata.
Dialogue: 0,0:06:01.56,0:06:03.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona, biar saya sisir rambut Anda.
Dialogue: 0,0:06:08.35,0:06:09.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rambut ini sangat putih.
Dialogue: 0,0:06:10.50,0:06:14.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Vitalitasnya pasti terkuras\Nsaat bangkit dari kematian.
Dialogue: 0,0:06:15.12,0:06:17.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona, waktunya makan.
Dialogue: 0,0:06:17.76,0:06:20.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sumber vitalitas adalah makanan.
Dialogue: 0,0:06:20.93,0:06:22.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya, aku harus makan.
Dialogue: 0,0:06:23.91,0:06:25.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah! Hebat sekali,
Dialogue: 0,0:06:26.02,0:06:27.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}makanan Anda habis semua!
Dialogue: 0,0:06:28.30,0:06:30.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang, waktunya minum obat.
Dialogue: 0,0:06:30.79,0:06:31.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, Nona?
Dialogue: 0,0:06:32.19,0:06:35.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Anda tidak apa-apa, Nona?!\N- Apakah hidupku akan begini terus?
Dialogue: 0,0:06:38.93,0:06:40.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Porsi makan yang perlahan bertambah,
Dialogue: 0,0:06:41.25,0:06:42.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}obat herbal sihir untuk paru-paru,
Dialogue: 0,0:06:43.42,0:06:44.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}serta sirkulasi "Ki".
Dialogue: 0,0:06:45.56,0:06:47.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya semua itu mulai membuahkan hasil.
Dialogue: 0,0:06:47.93,0:06:49.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona,
Dialogue: 0,0:06:49.13,0:06:51.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}wajah Anda kelihatan lebih segar\Nbelakangan ini.
Dialogue: 0,0:06:52.52,0:06:54.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau coba jalan-jalan ke luar?
Dialogue: 0,0:06:54.58,0:06:55.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke luar?
Dialogue: 0,0:06:55.98,0:06:58.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah masih sempat mengantar Ayah dan Ibu?
Dialogue: 0,0:06:59.05,0:07:03.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, Tuan dan Nyonya sudah pergi bekerja.
Dialogue: 0,0:07:04.16,0:07:05.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:07:05.83,0:07:09.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pantas mereka selalu datang saat sarapan.
Dialogue: 0,0:07:10.63,0:07:13.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rupanya mereka meluangkan waktu\Nhanya untuk menemuiku.
Dialogue: 0,0:07:14.00,0:07:17.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keputusanku meminta mereka\Nberhenti datang sudah tepat.
Dialogue: 0,0:07:17.37,0:07:18.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi menyusahkan mereka.
Dialogue: 0,0:07:18.95,0:07:20.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama sekali tidak menyusahkan!
Dialogue: 0,0:07:21.17,0:07:22.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagi mereka, Anda jauh lebih penting
Dialogue: 0,0:07:22.62,0:07:24.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}daripada pekerjaan mereka!
Dialogue: 0,0:07:24.97,0:07:28.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah merepotkan mereka\Nkarena sakit-sakitan,
Dialogue: 0,0:07:28.63,0:07:30.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tidak ingin menambah beban mereka.
Dialogue: 0,0:07:31.41,0:07:32.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya
Dialogue: 0,0:07:32.47,0:07:35.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anda jauh lebih peka daripada saya.
Dialogue: 0,0:07:35.19,0:07:36.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja.
Dialogue: 0,0:07:36.37,0:07:39.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wanita yang tidak peka\Ntidak akan populer, tahu.
Dialogue: 0,0:07:39.54,0:07:40.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona...
Dialogue: 0,0:07:44.13,0:07:46.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zazen... sebenarnya apa itu?
Dialogue: 0,0:07:47.04,0:07:49.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ingatanku masih belum kembali, ya?
Dialogue: 0,0:07:51.57,0:07:52.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesuai dugaanku,
Dialogue: 0,0:07:52.62,0:07:55.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}saat melakukan zazen,\N"Ki" mengalir sangat lancar.
Dialogue: 0,0:08:00.63,0:08:01.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona?
Dialogue: 0,0:08:03.31,0:08:05.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namaku Nia Liston.
Dialogue: 0,0:08:05.70,0:08:08.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hobiku minum obat dan beristirahat,
Dialogue: 0,0:08:08.93,0:08:12.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku anak perempuan berusia empat tahun\Nyang sedang melawan penyakit.
Dialogue: 0,0:08:13.41,0:08:14.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bumbu favoritku adalah garam.
Dialogue: 0,0:08:15.31,0:08:17.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasa favoritku bukanlah hal konyol
Dialogue: 0,0:08:17.79,0:08:19.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}seperti "menonjolkan rasa asli bahan",
Dialogue: 0,0:08:19.17,0:08:20.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi makanan yang bumbunya pas.
Dialogue: 0,0:08:20.95,0:08:22.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cita-citaku di masa depan adalah
Dialogue: 0,0:08:22.25,0:08:24.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}makan bistik sebesar sepatu pria
Dialogue: 0,0:08:24.35,0:08:26.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan bumbu selain garam.
Dialogue: 0,0:08:27.36,0:08:30.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, aku sudah menjadi Nia Liston\Nyang sempurna.
Dialogue: 0,0:08:30.31,0:08:31.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa tiba-tiba begini?
Dialogue: 0,0:08:31.97,0:08:35.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa perlu kutambahkan kalimat manis\Nseperti "Kalau besar nanti,
Dialogue: 0,0:08:35.22,0:08:37.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku mau jadi istri Ayah" supaya dia senang?
Dialogue: 0,0:08:38.13,0:08:39.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona...
Dialogue: 0,0:08:39.16,0:08:40.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:08:40.12,0:08:41.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu...
Dialogue: 0,0:08:42.26,0:08:43.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anda sudah berubah, ya.
Dialogue: 0,0:08:43.84,0:08:44.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:08:45.09,0:08:47.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dibanding sebelum sakit, bagaimana, ya?
Dialogue: 0,0:08:49.29,0:08:51.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anda kelihatan jauh lebih ceria.
Dialogue: 0,0:08:53.89,0:08:55.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kediaman ini luas sekali, ya.
Dialogue: 0,0:08:55.75,0:08:58.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, karena ini kediaman bangsawan\Ntingkat keempat.
Dialogue: 0,0:09:00.13,0:09:02.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di Kerajaan Altoire,\NRaja menempati tingkat pertama,
Dialogue: 0,0:09:02.51,0:09:04.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan ada 15 tingkat di bawahnya.
Dialogue: 0,0:09:05.27,0:09:07.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tingkat 12 sampai 15 adalah rakyat biasa
Dialogue: 0,0:09:07.78,0:09:10.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan tingkat 11 ke atas\Ndianggap sebagai bangsawan.
Dialogue: 0,0:09:10.90,0:09:13.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keluarga Liston yang berada\Ndi tingkat keempat
Dialogue: 0,0:09:13.46,0:09:15.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}merupakan salah satu dari sepuluh\Nkeluarga bangsawan di tingkat tersebut.
Dialogue: 0,0:09:16.34,0:09:17.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, secara turun-temurun,
Dialogue: 0,0:09:17.62,0:09:20.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pulau terapung ini dan 17 pulau di sekitarnya
Dialogue: 0,0:09:20.79,0:09:23.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dipercayakan sebagai wilayah\Nkekuasaan mereka.
Dialogue: 0,0:09:26.42,0:09:28.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, Tuan Neil sudah pulang.
Dialogue: 0,0:09:30.25,0:09:31.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa?
Dialogue: 0,0:09:31.14,0:09:34.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak Anda, Tuan Neil Liston.
Dialogue: 0,0:09:35.36,0:09:36.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nia!
Dialogue: 0,0:09:38.86,0:09:40.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang kembali, Kakanda.
Dialogue: 0,0:09:40.65,0:09:41.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nia,
Dialogue: 0,0:09:41.73,0:09:43.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kudengar kau sudah mendingan.
Dialogue: 0,0:09:43.77,0:09:45.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana keadaanmu sekarang?
Dialogue: 0,0:09:45.98,0:09:47.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lumayan baik.
Dialogue: 0,0:09:49.17,0:09:50.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku terkejut!
Dialogue: 0,0:09:51.25,0:09:53.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nia, nanti kita mengobrol lagi, ya!
Dialogue: 0,0:09:54.05,0:09:55.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah.
Dialogue: 0,0:09:55.20,0:09:58.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak ini kelak pasti akan membuat\Nbanyak wanita patah hati.
Dialogue: 0,0:09:59.33,0:10:00.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi
Dialogue: 0,0:10:00.74,0:10:02.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia lumayan kuat juga.
Dialogue: 0,0:10:02.87,0:10:05.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedikit lebih mahir daripada Rinokis.
Dialogue: 0,0:10:05.82,0:10:06.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu
Dialogue: 0,0:10:06.99,0:10:09.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pelayan pria ini juga cukup kuat.
Dialogue: 0,0:10:10.28,0:10:12.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi dengan keadaanku sekarang...
Dialogue: 0,0:10:17.53,0:10:19.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sambil duduk di kursi roda pun,
Dialogue: 0,0:10:19.16,0:10:21.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku bisa menang hanya dengan tangan kiri.
Dialogue: 0,0:10:22.24,0:10:25.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, aku mendambakan lawan yang cukup kuat.
Dialogue: 0,0:10:26.96,0:10:27.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nia!
Dialogue: 0,0:10:28.49,0:10:31.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berbaring di kasur seharian\Npasti membosankan, bukan?
Dialogue: 0,0:10:31.54,0:10:33.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini memang perlu.
Dialogue: 0,0:10:33.24,0:10:34.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Rinokis.
Dialogue: 0,0:10:34.70,0:10:37.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau kau tunjukkan "itu"\Nseperti dulu?
Dialogue: 0,0:10:37.49,0:10:38.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu?
Dialogue: 0,0:10:38.22,0:10:39.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dulu kau sangat menyukainya, 'kan?
Dialogue: 0,0:10:39.91,0:10:40.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar,
Dialogue: 0,0:10:40.76,0:10:42.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dulu Anda menontonnya seharian.
Dialogue: 0,0:10:43.03,0:10:45.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, karena kadang ada adegan yang intens,
Dialogue: 0,0:10:45.71,0:10:47.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ayah Anda jadi melarangnya.
Dialogue: 0,0:10:57.95,0:10:59.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini yang dinamakan Magic Vision!
Dialogue: 0,0:10:59.84,0:11:01.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak paham prinsip kerjanya,
Dialogue: 0,0:11:01.64,0:11:02.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi ini sangat menarik!
Dialogue: 0,0:11:04.76,0:11:06.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus, Kakanda!
Dialogue: 0,0:11:06.98,0:11:09.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini, kuberi permen sebagai hadiah.
Dialogue: 0,0:11:09.36,0:11:11.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa mendadak sok angkuh begitu?
Dialogue: 0,0:11:11.82,0:11:13.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat Tuan pulang nanti,
Dialogue: 0,0:11:13.53,0:11:15.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mari kita minta izin padanya.
Dialogue: 0,0:11:27.03,0:11:29.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan hanya di ibu kota,
Dialogue: 0,0:11:29.46,0:11:31.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mereka terkenal di seluruh kerajaan,
Dialogue: 0,0:11:31.87,0:11:33.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}grup teater yang sedang naik daun!
Dialogue: 0,0:11:36.50,0:11:37.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona,
Dialogue: 0,0:11:37.88,0:11:40.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tayangan pada jam sekarang\Ntidak boleh Anda tonton.
Dialogue: 0,0:11:41.10,0:11:43.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya waktu pertarungan tiba!
Dialogue: 0,0:11:45.87,0:11:49.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona, Anda tidak diizinkan\Nmenonton tayangan ekstrem.
Dialogue: 0,0:11:50.10,0:11:51.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona, tidak boleh.
Dialogue: 0,0:11:51.73,0:11:52.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak boleh!
Dialogue: 0,0:11:52.86,0:11:53.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak boleh!
Dialogue: 0,0:11:57.40,0:11:59.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak sekali batasannya.
Dialogue: 0,0:11:59.27,0:12:02.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Rinokis,\Napa ada acara yang ingin kau tonton?
Dialogue: 0,0:12:02.55,0:12:03.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya?
Dialogue: 0,0:12:03.98,0:12:05.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa, ya?
Dialogue: 0,0:12:05.37,0:12:07.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin cerita romantis.
Dialogue: 0,0:12:07.87,0:12:10.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dua orang saling mencintai,\Ntapi tak bisa bersatu!
Dialogue: 0,0:12:10.41,0:12:12.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melihatnya membuat hati saya berdebar!
Dialogue: 0,0:12:13.00,0:12:15.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu cuma bikin gemas dan merepotkan.
Dialogue: 0,0:12:17.05,0:12:18.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedewasa apa pun anak usia empat tahun,
Dialogue: 0,0:12:18.75,0:12:20.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tetap saja anak empat tahun.
Dialogue: 0,0:12:20.90,0:12:23.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana paham perasaan orang dewasa.
Dialogue: 0,0:12:24.22,0:12:26.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Usiamu juga baru 16 tahun, 'kan?
Dialogue: 0,0:12:27.86,0:12:29.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Catatan Perjalanan Wilayah Liston.
Dialogue: 0,0:12:30.05,0:12:32.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempat yang kita kunjungi hari ini\Nadalah kilang anggur ini.
Dialogue: 0,0:12:33.14,0:12:35.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak disangka, ruang penyimpanan ini
Dialogue: 0,0:12:35.13,0:12:36.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- sudah berusia lebih dari 50 tahun.\N- Ah, benar.
Dialogue: 0,0:12:36.41,0:12:39.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau berterima kasih pada Kakanda\Nuntuk Magic Vision itu.
Dialogue: 0,0:12:52.84,0:12:54.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, satu tebasan lagi!
Dialogue: 0,0:12:56.45,0:12:57.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh minta waktunya sebentar?
Dialogue: 0,0:12:58.41,0:12:59.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nia!
Dialogue: 0,0:12:59.44,0:13:00.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakanda,
Dialogue: 0,0:13:00.75,0:13:02.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pedang itu digunakan\Ndengan cara didorong dan ditarik,
Dialogue: 0,0:13:02.54,0:13:03.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu ditebaskan dengan bilahnya.
Dialogue: 0,0:13:04.98,0:13:06.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}No-Nona?
Dialogue: 0,0:13:08.70,0:13:11.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lynette, tolong pasang kuda-kuda siaga.
Dialogue: 0,0:13:12.96,0:13:14.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Ah, baik.
Dialogue: 0,0:13:15.25,0:13:17.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengar, Kakanda.
Dialogue: 0,0:13:18.82,0:13:20.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan dipukulkan,
Dialogue: 0,0:13:22.32,0:13:23.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi ditebas!
Dialogue: 0,0:13:35.58,0:13:36.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona!
Dialogue: 0,0:13:37.46,0:13:40.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski dibantu "Ki",\Naku bahkan tak bisa mengayunkannya.
Dialogue: 0,0:13:40.74,0:13:43.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, untuk keadaanku yang sekarang,\Nini sudah lumayan.
Dialogue: 0,0:13:44.50,0:13:48.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senjata itu dirancang\Ndengan sangat masuk akal.
Dialogue: 0,0:13:48.58,0:13:52.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau cuma ingin memukul seperti Kakanda,
Dialogue: 0,0:13:52.38,0:13:55.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lebih baik pakai pemukul kayu\Nyang berat dan kokoh.
Dialogue: 0,0:13:56.61,0:13:57.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf mengganggu.
Dialogue: 0,0:13:58.46,0:13:59.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo jalan.
Dialogue: 0,0:14:01.07,0:14:02.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Nia
Dialogue: 0,0:14:03.02,0:14:04.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sepertinya agak berubah, ya?
Dialogue: 0,0:14:05.01,0:14:07.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, baguslah kalau dia sudah sehat.
Dialogue: 0,0:14:13.41,0:14:15.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyakitku sudah sembuh total.
Dialogue: 0,0:14:16.16,0:14:18.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah waktunya aku kembali\Nke kehidupan normal.
Dialogue: 0,0:14:20.34,0:14:22.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau itu keputusanmu, lakukanlah.
Dialogue: 0,0:14:22.41,0:14:24.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami menghormati pilihanmu.
Dialogue: 0,0:14:24.99,0:14:26.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rinokis juga.
Dialogue: 0,0:14:26.10,0:14:27.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tak perlu menemaniku lagi tiap malam.
Dialogue: 0,0:14:29.38,0:14:30.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa melihatku begitu?
Dialogue: 0,0:14:31.73,0:14:32.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, Nia...
Dialogue: 0,0:14:33.34,0:14:35.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau sudah memikirkan hal\Nyang kita bicarakan kemarin?
Dialogue: 0,0:14:36.26,0:14:39.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal aku tampil di Magic Vision?
Dialogue: 0,0:14:39.54,0:14:40.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau itu, aku tidak keberatan.
Dialogue: 0,0:14:42.34,0:14:44.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebelum aku masuk ke tubuh Nia...
Dialogue: 0,0:14:48.15,0:14:49.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nia!
Dialogue: 0,0:14:49.91,0:14:51.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bertahanlah, Nia!
Dialogue: 0,0:14:53.29,0:14:54.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nia...!
Dialogue: 0,0:14:55.41,0:14:56.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak ada cara lain lagi.
Dialogue: 0,0:14:57.40,0:14:59.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita memohon bantuan ke publik
Dialogue: 0,0:14:59.50,0:15:01.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lewat Magic Vision untuk mengobati Nia.
Dialogue: 0,0:15:03.75,0:15:06.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salam kenal, rakyat Kerajaan Altoire.
Dialogue: 0,0:15:07.63,0:15:09.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang tua Nia adalah
Dialogue: 0,0:15:09.09,0:15:12.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pengelola stasiun penyiaran\NMagic Vision Wilayah Liston.
Dialogue: 0,0:15:12.74,0:15:14.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena sudah meminta bantuan masyarakat\Nuntuk pengobatan putri mereka,
Dialogue: 0,0:15:14.98,0:15:18.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mereka harus menyiarkan hasilnya\Nlewat Magic Vision.
Dialogue: 0,0:15:19.57,0:15:20.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan hal itu,
Dialogue: 0,0:15:20.45,0:15:23.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mereka minta agar disampaikan langsung\Ndari mulutku.
Dialogue: 0,0:15:27.25,0:15:30.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan tampil di Magic Vision\Nuntuk mengabarkan kondisiku.
Dialogue: 0,0:15:37.75,0:15:38.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah!
Dialogue: 0,0:15:38.77,0:15:41.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona, itu Bendelio! Bendelio!
Dialogue: 0,0:15:41.75,0:15:45.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Dari "Catatan Perjalanan Wilayah Liston"!\N- Ambil gambar dari posisi asisten.
Dialogue: 0,0:15:45.97,0:15:47.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo.
Dialogue: 0,0:15:47.25,0:15:48.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau yang bernama Nia, ya?
Dialogue: 0,0:15:48.92,0:15:50.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salam kenal.
Dialogue: 0,0:15:50.42,0:15:53.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku melihat wajahmu setiap hari\Ndi Papan Kristal Sihir.
Dialogue: 0,0:15:53.70,0:15:56.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh ya? Bagaimana kesanmu?
Dialogue: 0,0:15:56.04,0:15:57.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Acaranya santai, aku suka.
Dialogue: 0,0:15:58.19,0:16:01.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi belakangan ini,\Nbukankah adegan minumnya terlalu banyak?
Dialogue: 0,0:16:03.23,0:16:04.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga berpikir begitu!
Dialogue: 0,0:16:04.90,0:16:07.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, minuman keras dan produk lokal
Dialogue: 0,0:16:07.41,0:16:09.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sangat disukai penonton.
Dialogue: 0,0:16:09.49,0:16:11.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah tayang, laris manis.
Dialogue: 0,0:16:12.05,0:16:12.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sutradara!
Dialogue: 0,0:16:13.34,0:16:15.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengenai riasan Nona Nia...
Dialogue: 0,0:16:15.94,0:16:18.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana dengan warna rambutnya?
Dialogue: 0,0:16:19.22,0:16:20.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biarkan begini saja.
Dialogue: 0,0:16:21.82,0:16:24.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rambut ini adalah bukti bahwa\Naku berjuang melawan penyakit.
Dialogue: 0,0:16:27.16,0:16:28.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan juga
Dialogue: 0,0:16:28.58,0:16:30.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bukti bahwa "Nia Liston"\Ntelah berjuang untuk hidup.
Dialogue: 0,0:16:32.75,0:16:34.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu merasa malu.
Dialogue: 0,0:16:36.01,0:16:38.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhubung aku sudah mendapatkan tubuh ini,
Dialogue: 0,0:16:38.46,0:16:40.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku harus hidup sebagai Nia.
Dialogue: 0,0:16:41.03,0:16:43.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, tanggung jawab dan kewajibannya
Dialogue: 0,0:16:43.25,0:16:45.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang seharusnya dia pikul akan kutuntaskan.
Dialogue: 0,0:16:46.32,0:16:47.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai rekam!
Dialogue: 0,0:16:52.01,0:16:53.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salam kenal.
Dialogue: 0,0:16:53.86,0:16:55.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya Nia Liston.
Dialogue: 0,0:16:57.08,0:16:58.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rakyat Kerajaan Altoire,
Dialogue: 0,0:16:59.37,0:17:01.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}maaf sudah membuat Anda sekalian khawatir.
Dialogue: 0,0:17:04.32,0:17:06.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, saya, Nia Liston...
Dialogue: 0,0:17:07.41,0:17:09.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hari ini pun hidup dengan gembira!
Dialogue: 0,0:17:19.98,0:17:23.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nia Liston: The Merciless Maiden
Dialogue: 0,0:17:23.98,0:17:26.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nia Liston: The Merciless Maiden
Dialogue: 0,0:17:26.94,0:17:28.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini?
Dialogue: 0,0:17:28.29,0:17:29.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Surat dari penggemar!
Dialogue: 0,0:17:30.21,0:17:33.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siaran kemarin mendapat sambutan baik!
Dialogue: 0,0:17:33.75,0:17:34.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah!
Dialogue: 0,0:17:35.08,0:17:37.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, aku ingin kalian berdua
Dialogue: 0,0:17:37.05,0:17:39.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tampil di acara itu sekali lagi.
Dialogue: 0,0:17:43.03,0:17:46.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Magic Vision belum meluas\Ndi kalangan masyarakat umum.
Dialogue: 0,0:17:47.09,0:17:49.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kami sangat butuh promosi.
Dialogue: 0,0:17:49.58,0:17:52.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm, aku diminta jadi promotor?
Dialogue: 0,0:17:52.68,0:17:54.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana menurutmu, Nia?
Dialogue: 0,0:17:54.48,0:17:56.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak begitu berminat.
Dialogue: 0,0:17:56.94,0:17:59.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kalau Ayah dan Ibu mengharapkan itu,
Dialogue: 0,0:18:00.01,0:18:01.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan melakukannya.
Dialogue: 0,0:18:05.63,0:18:08.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka menghabiskan uang dalam jumlah besar
Dialogue: 0,0:18:08.19,0:18:10.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sampai menguras harta demi Nia...
Dialogue: 0,0:18:11.89,0:18:14.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Utang budi yang harus kulunasi ini
Dialogue: 0,0:18:14.10,0:18:15.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidaklah sedikit.
Dialogue: 0,0:18:18.45,0:18:19.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Acaranya dimulai,
Dialogue: 0,0:18:19.78,0:18:21.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Kunjungan Profesi Nia Liston"!
Dialogue: 0,0:18:22.07,0:18:25.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini, kita berkunjung ke bengkel\Npembuatan dan perbaikan pedang!
Dialogue: 0,0:18:26.48,0:18:27.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cut!
Dialogue: 0,0:18:27.65,0:18:28.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus sekali!
Dialogue: 0,0:18:31.01,0:18:32.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perbaikan pedang terdiri atas beberapa tahap.
Dialogue: 0,0:18:33.29,0:18:35.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sebelah sana ada yang sedang\Nmemperbaiki goresan permukaan,
Dialogue: 0,0:18:36.21,0:18:38.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan di dalam,\Nkepala bengkel menggunakan kikir
Dialogue: 0,0:18:38.00,0:18:40.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk memperbaiki bagian\Nyang tak bisa diasah.
Dialogue: 0,0:18:41.30,0:18:43.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pria itu lumayan hebat.
Dialogue: 0,0:18:44.16,0:18:47.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia perajin sekaligus pendekar pedang.
Dialogue: 0,0:18:47.51,0:18:50.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai sesama petarung,\Naku ingin menguji kemampuannya.
Dialogue: 0,0:18:50.90,0:18:51.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah,
Dialogue: 0,0:18:51.69,0:18:55.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ini barang yang akan Nia perbaiki kali ini.
Dialogue: 0,0:18:56.45,0:18:58.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, pedang pendek!
Dialogue: 0,0:18:58.72,0:19:01.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya aku lebih cocok mematahkannya\Ndaripada memperbaikinya.
Dialogue: 0,0:19:02.48,0:19:04.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku bisa melakukannya?
Dialogue: 0,0:19:04.25,0:19:06.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, Nia cukup memperbaiki sarungnya saja.
Dialogue: 0,0:19:10.13,0:19:11.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, cut!
Dialogue: 0,0:19:11.74,0:19:13.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, sisanya
Dialogue: 0,0:19:13.29,0:19:16.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}boleh kami rekam adegan uji tebas?
Dialogue: 0,0:19:36.09,0:19:37.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cut!
Dialogue: 0,0:19:37.31,0:19:39.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, sungguh luar biasa!
Dialogue: 0,0:19:39.59,0:19:41.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak!
Dialogue: 0,0:19:42.53,0:19:45.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hasil gambarnya bakal lebih bagus\Ndaripada dugaan!
Dialogue: 0,0:19:47.15,0:19:48.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa tidak menebasnya sampai tuntas?
Dialogue: 0,0:19:49.88,0:19:51.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski bukan pedang tempur,
Dialogue: 0,0:19:52.08,0:19:55.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan keahlianmu,\Nkau bisa memotong perisai itu, 'kan?
Dialogue: 0,0:19:57.39,0:19:59.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku saja bisa, kok.
Dialogue: 0,0:20:00.29,0:20:01.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa katamu?
Dialogue: 0,0:20:02.34,0:20:03.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, coba tunjukkan!
Dialogue: 0,0:20:05.08,0:20:06.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona, jangan!
Dialogue: 0,0:20:07.64,0:20:08.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pinjam dulu.
Dialogue: 0,0:20:36.42,0:20:39.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata ini bukan pedang bagus.
Dialogue: 0,0:20:39.70,0:20:41.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keseimbangannya sedikit timpang,
Dialogue: 0,0:20:41.84,0:20:43.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan terasa agak tersendat.
Dialogue: 0,0:20:51.29,0:20:53.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, asyik banget!
Dialogue: 0,0:20:55.47,0:20:56.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona.
Dialogue: 0,0:20:56.49,0:20:57.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:20:57.74,0:20:59.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu bersama Tuan Neil juga begitu.
Dialogue: 0,0:20:59.77,0:21:01.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di mana Anda mempelajari hal seperti itu?
Dialogue: 0,0:21:02.28,0:21:03.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tahu-tahu aku sudah bisa.
Dialogue: 0,0:21:04.50,0:21:06.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin aku pernah membacanya di buku.
Dialogue: 0,0:21:06.45,0:21:08.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, Anda belum bisa\Nmembaca tulisan rumit, 'kan?
Dialogue: 0,0:21:09.20,0:21:10.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kan ada buku bergambar.
Dialogue: 0,0:21:10.71,0:21:12.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di buku bergambar tidak ada hal seperti itu!
Dialogue: 0,0:21:14.10,0:21:15.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan banyak tanya.
Dialogue: 0,0:21:15.49,0:21:16.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini rahasia wanita.
Dialogue: 0,0:21:17.06,0:21:19.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di usia sebegitu sudah punya rahasia wanita!
Dialogue: 0,0:21:27.25,0:21:29.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Reputasi Nia cukup bagus, lo.
Dialogue: 0,0:21:29.80,0:21:32.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penjualan Papan Kristal Sihir\Njuga sangat bagus.
Dialogue: 0,0:21:32.23,0:21:35.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Toko dan teater yang diliput\Ndi "Kunjungan Profesi"
Dialogue: 0,0:21:35.09,0:21:37.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mulai memasangnya.
Dialogue: 0,0:21:37.77,0:21:40.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang bisa membantu.
Dialogue: 0,0:21:40.84,0:21:44.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski pemakaian di rumah warga\Nmasih butuh waktu.
Dialogue: 0,0:21:44.24,0:21:45.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, Nia,
Dialogue: 0,0:21:45.74,0:21:49.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebenarnya ada tawaran pekerjaan untukmu\Ndari ibu kota.
Dialogue: 0,0:21:50.22,0:21:52.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau coba tampil di pementasan drama?
Dialogue: 0,0:21:53.53,0:21:55.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Grup Teater Ice Rose!
Dialogue: 0,0:21:55.25,0:21:58.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa melihat "Dua Pangeran Es"\Nsecara langsung...!
Dialogue: 0,0:21:58.58,0:22:01.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona! Anda bakal debut jadi aktris!
Dialogue: 0,0:22:01.68,0:22:03.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, kita pergi ke ibu kota!
Dialogue: 0,0:22:13.40,0:22:14.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimanapun juga,
Dialogue: 0,0:22:14.85,0:22:16.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia ternyata masih anak-anak.
Dialogue: 0,0:22:17.42,0:22:18.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, apakah di sana...
Dialogue: 0,0:22:19.56,0:22:22.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ada orang yang bisa membunuhku?
Dialogue: 0,0:22:43.38,0:22:46.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nia Liston: The Merciless Maiden
Dialogue: 0,0:23:56.50,0:23:58.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya, "Pekerjaan di Ibu Kota".
