Dialogue: 0,0:00:09.19,0:00:12.99,sign,,0000,0000,0000,,AKADEMI ALTOIRE
Dialogue: 0,0:01:50.17,0:01:55.01,sign,,0000,0000,0000,,EPISODE 4: PERTEMUAN PARA GADIS
Dialogue: 0,0:03:50.91,0:03:53.50,sign,,0000,0000,0000,,AKADEMI ALTOIRE,\NWISMA TAMU KHUSUS BANGSAWAN
Dialogue: 0,0:05:20.59,0:05:21.09,sign,,0000,0000,0000,,KEMAH SEHARI RELIARED
Dialogue: 0,0:11:01.92,0:11:02.97,sign,,0000,0000,0000,,AKADEMI ALTOIRE,\NASRAMA BANGSAWAN TINGKAT SD
Dialogue: 0,0:13:48.92,0:13:51.44,sign,,0000,0000,0000,,PERSIAPAN SEKOLAH: SERAGAM PERTAMAKU
Dialogue: 0,0:13:54.44,0:13:56.44,sign,,0000,0000,0000,,RELIARED SILVER
Dialogue: 0,0:13:59.94,0:14:01.95,sign,,0000,0000,0000,,NIA LISTON
Dialogue: 0,0:23:58.88,0:23:59.96,sign,,0000,0000,0000,,SELANJUTNYA: RAPAT PENYEBARAN MAGIC VISION
Dialogue: 0,0:00:20.59,0:00:24.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Pernah lihat di Magic Vision!\N- Apa mereka murid baru sepertiku?
Dialogue: 0,0:00:24.67,0:00:26.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, sepertinya.
Dialogue: 0,0:00:26.87,0:00:28.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerajaan Altoire
Dialogue: 0,0:00:28.51,0:00:31.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mewajibkan anak usia 6-12 tahun
Dialogue: 0,0:00:31.26,0:00:34.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk bersekolah di sekolah dasar kerajaan.
Dialogue: 0,0:00:35.00,0:00:36.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah lulus sekolah dasar?
Dialogue: 0,0:00:37.39,0:00:39.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada SMP dan SMA juga,
Dialogue: 0,0:00:39.60,0:00:41.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi lanjut atau tidak itu bebas.
Dialogue: 0,0:00:41.97,0:00:43.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, kalau nilainya bagus,
Dialogue: 0,0:00:44.04,0:00:47.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa diundang ke Akademi Kerajaan,\Njenjang tertinggi.
Dialogue: 0,0:00:52.07,0:00:54.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagiku, lulus sekolah dasar saja sudah cukup.
Dialogue: 0,0:00:54.85,0:00:58.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jujur, aku tidak pandai berpikir.
Dialogue: 0,0:00:58.60,0:01:00.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau menerjang, aku jagonya.
Dialogue: 0,0:01:01.21,0:01:02.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nia!
Dialogue: 0,0:01:06.48,0:01:08.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakanda, lama tidak jumpa.
Dialogue: 0,0:01:08.96,0:01:11.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, syukurlah kau sehat.
Dialogue: 0,0:01:11.93,0:01:13.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lama tidak bertemu, Nona.
Dialogue: 0,0:01:14.71,0:01:16.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengawalan yang sigap.
Dialogue: 0,0:01:16.56,0:01:18.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya akan makin banyak gadis\Nyang patah hati karenanya.
Dialogue: 0,0:01:23.45,0:01:25.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakanda, siapa dia?
Dialogue: 0,0:01:25.81,0:01:26.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pacarmu?
Dialogue: 0,0:01:26.95,0:01:28.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}He-Hei!
Dialogue: 0,0:01:28.34,0:01:30.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bicara sembarangan!
Dialogue: 0,0:01:31.09,0:01:32.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salam kenal.
Dialogue: 0,0:01:34.34,0:01:36.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya kita bisa bertemu,
Dialogue: 0,0:01:36.62,0:01:37.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nia Liston.
Dialogue: 0,0:01:40.75,0:01:41.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah!
Dialogue: 0,0:01:42.37,0:01:43.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nia Liston!
Dialogue: 0,0:02:13.44,0:02:16.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nia Liston: The Merciless Maiden
Dialogue: 0,0:03:26.61,0:03:28.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah! Nia Liston!
Dialogue: 0,0:03:29.59,0:03:30.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nia Liston?
Dialogue: 0,0:03:31.22,0:03:31.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa?
Dialogue: 0,0:03:31.94,0:03:33.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pernah lihat di suatu tempat.
Dialogue: 0,0:03:33.99,0:03:36.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak yang di Magic Vision, 'kan?
Dialogue: 0,0:03:37.58,0:03:38.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo pergi.
Dialogue: 0,0:03:40.24,0:03:41.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu sebentar!
Dialogue: 0,0:03:41.74,0:03:43.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk sementara, kita ke wisma tamu dulu.
Dialogue: 0,0:03:44.02,0:03:44.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:03:55.46,0:03:57.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asyik, ya.
Dialogue: 0,0:03:57.34,0:04:00.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan kau ini?!\NTiba-tiba lari begitu saja!
Dialogue: 0,0:04:00.62,0:04:02.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ada urusan dengan Nia Liston...
Dialogue: 0,0:04:05.71,0:04:07.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekali lagi...
Dialogue: 0,0:04:08.58,0:04:12.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namaku Hildetaura Altoire.
Dialogue: 0,0:04:13.09,0:04:14.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hildetaura?
Dialogue: 0,0:04:15.18,0:04:17.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia putri ketiga Kerajaan Altoire.
Dialogue: 0,0:04:18.24,0:04:20.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya dia ingin bertemu Nia\Nsecara langsung.
Dialogue: 0,0:04:22.19,0:04:23.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi begitu.
Dialogue: 0,0:04:23.30,0:04:25.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia yang pernah diceritakan orang tuaku.
Dialogue: 0,0:04:26.29,0:04:28.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Hilde terkenal
Dialogue: 0,0:04:28.50,0:04:30.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena sering muncul\Ndi Magic Vision stasiun ibu kota.
Dialogue: 0,0:04:32.06,0:04:33.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Slogannya adalah...
Dialogue: 0,0:04:33.92,0:04:35.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Putri yang Mudah Ditemui".
Dialogue: 0,0:04:38.95,0:04:40.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nia Liston.
Dialogue: 0,0:04:40.37,0:04:42.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf atas kunjungan mendadak ini.
Dialogue: 0,0:04:42.89,0:04:45.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salam kenal, Nona Hildetaura.
Dialogue: 0,0:04:45.60,0:04:46.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Nia Liston.
Dialogue: 0,0:04:48.82,0:04:51.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, Reliared Silver.
Dialogue: 0,0:04:51.31,0:04:52.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Y-Ya!
Dialogue: 0,0:04:52.82,0:04:56.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga ingin bicara denganmu.
Dialogue: 0,0:04:56.42,0:04:58.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah mengikutiku.
Dialogue: 0,0:04:58.98,0:05:01.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak, bukan masalah!
Dialogue: 0,0:05:01.51,0:05:04.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia dari keluarga Silver, ya?
Dialogue: 0,0:05:04.89,0:05:07.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat wilayah Silver\Nmembuka stasiun penyiaran,
Dialogue: 0,0:05:07.66,0:05:10.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku pernah berkunjung bersama\Norang tuaku dan kru kamera.
Dialogue: 0,0:05:12.16,0:05:13.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang benar,
Dialogue: 0,0:05:13.25,0:05:16.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia agak mirip dengan putri sulung\Nkeluarga Silver waktu itu.
Dialogue: 0,0:05:17.49,0:05:18.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:05:18.50,0:05:20.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak menonton saluran kami?
Dialogue: 0,0:05:21.10,0:05:22.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga tampil di sana.
Dialogue: 0,0:05:25.69,0:05:26.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi begitu.
Dialogue: 0,0:05:26.97,0:05:30.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Artinya, kita bertiga seprofesi.
Dialogue: 0,0:05:30.76,0:05:32.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari bicara sambil duduk.
Dialogue: 0,0:05:32.69,0:05:34.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan menyita banyak waktu.
Dialogue: 0,0:05:42.44,0:05:44.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari langsung ke intinya.
Dialogue: 0,0:05:44.93,0:05:49.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berusaha sekuat tenaga\Nmenyebarkan Magic Vision,
Dialogue: 0,0:05:49.10,0:05:51.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang merupakan kebijakan negara.
Dialogue: 0,0:05:56.82,0:05:57.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dahulu
Dialogue: 0,0:05:58.39,0:06:02.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ada kekaisaran langit\Nyang hampir menguasai dunia,
Dialogue: 0,0:06:02.81,0:06:04.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misgaris.
Dialogue: 0,0:06:04.69,0:06:06.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekaisaran besar itu
Dialogue: 0,0:06:06.18,0:06:10.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lenyap akibat pelarian massal warga\Nmenggunakan kapal terbang.
Dialogue: 0,0:06:10.68,0:06:12.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hal itu mengejutkan dunia.
Dialogue: 0,0:06:14.85,0:06:16.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rakyat adalah darah suatu negeri.
Dialogue: 0,0:06:17.06,0:06:19.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kehilangan rakyat berarti kematian negeri.
Dialogue: 0,0:06:19.56,0:06:20.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun,
Dialogue: 0,0:06:20.68,0:06:23.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena rakyat tahu cara melarikan diri,
Dialogue: 0,0:06:23.36,0:06:27.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}wibawa bangsawan merosot drastis\Ndan kelak bangsawan
Dialogue: 0,0:06:27.87,0:06:30.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa jadi tak dibutuhkan lagi.
Dialogue: 0,0:06:31.68,0:06:33.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tujuanku adalah
Dialogue: 0,0:06:33.45,0:06:37.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mengembalikan kejayaan bangsawan\Nseperti dulu.
Dialogue: 0,0:06:38.81,0:06:39.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk itu,
Dialogue: 0,0:06:39.98,0:06:42.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan menyebarkan Magic Vision\Ndi negeri ini.
Dialogue: 0,0:06:43.70,0:06:46.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, aku berniat\Nmelibatkan negara lain juga.
Dialogue: 0,0:06:46.07,0:06:47.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Negara lain...
Dialogue: 0,0:06:47.63,0:06:48.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan begitu,
Dialogue: 0,0:06:49.04,0:06:53.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerajaan Altoire\Nyang menguasai sistem Magic Vision
Dialogue: 0,0:06:54.10,0:06:56.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan memegang kekuasaan dunia.
Dialogue: 0,0:07:02.07,0:07:05.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku punya impian sebesar itu.
Dialogue: 0,0:07:06.33,0:07:08.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Impiannya memang besar.
Dialogue: 0,0:07:09.19,0:07:11.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau ingin mengajak kami juga?
Dialogue: 0,0:07:11.69,0:07:14.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemampuan satu orang ada batasnya.
Dialogue: 0,0:07:14.76,0:07:18.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, jika ada dua atau tiga orang,
Dialogue: 0,0:07:18.18,0:07:19.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hal yang bisa dilakukan bertambah
Dialogue: 0,0:07:19.89,0:07:21.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan hasilnya bisa lebih besar.
Dialogue: 0,0:07:23.49,0:07:25.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika bekerja sama,
Dialogue: 0,0:07:25.42,0:07:28.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita bisa menjadi pionir.
Dialogue: 0,0:07:29.00,0:07:30.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ambisinya lumayan.
Dialogue: 0,0:07:30.99,0:07:32.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak benci itu.
Dialogue: 0,0:07:32.50,0:07:33.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu...
Dialogue: 0,0:07:34.06,0:07:37.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak paham hal rumit,
Dialogue: 0,0:07:37.68,0:07:40.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kalau mau menyebarkan Magic Vision,
Dialogue: 0,0:07:40.61,0:07:42.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku bersedia membantu.
Dialogue: 0,0:07:45.83,0:07:47.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga tidak keberatan.
Dialogue: 0,0:07:48.39,0:07:49.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula,
Dialogue: 0,0:07:49.62,0:07:51.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}agar keluarga Liston tak bangkrut,
Dialogue: 0,0:07:51.64,0:07:54.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku harus menghasilkan uang,
Dialogue: 0,0:07:54.20,0:07:56.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi tak ada pilihan lain.
Dialogue: 0,0:07:56.69,0:07:59.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, kalau makin populer,
Dialogue: 0,0:07:59.45,0:08:00.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}salurannya akan bertambah.
Dialogue: 0,0:08:00.89,0:08:01.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan begitu,
Dialogue: 0,0:08:02.26,0:08:04.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa saja ada acara seru
Dialogue: 0,0:08:04.10,0:08:06.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}seperti pertarungan manusia melawan monster!
Dialogue: 0,0:08:06.58,0:08:07.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu,
Dialogue: 0,0:08:07.47,0:08:08.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku yang akan bertarung!
Dialogue: 0,0:08:12.82,0:08:14.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja.
Dialogue: 0,0:08:14.38,0:08:17.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian tidak punya alasan\Nuntuk menolak, 'kan?
Dialogue: 0,0:08:17.68,0:08:18.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu,
Dialogue: 0,0:08:18.93,0:08:22.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau mau menyebarkan Magic Vision\Ndengan cara apa?
Dialogue: 0,0:08:22.75,0:08:24.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Caranya adalah...
Dialogue: 0,0:08:25.06,0:08:26.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Yaitu...?\N- Yaitu?
Dialogue: 0,0:08:30.18,0:08:32.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, sampai jumpa.
Dialogue: 0,0:08:32.21,0:08:34.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai jumpa, Nona Hildetaura.
Dialogue: 0,0:08:41.73,0:08:42.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengejutkan, ya.
Dialogue: 0,0:08:43.23,0:08:45.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak disangka,\Ncara menyebarkan Magic Vision adalah...
Dialogue: 0,0:08:46.50,0:08:48.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita pikirkan bersama!
Dialogue: 0,0:08:49.77,0:08:50.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:08:52.04,0:08:54.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata belum ada rencana sama sekali.
Dialogue: 0,0:08:54.45,0:08:55.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:08:56.21,0:08:58.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, mau bagaimana lagi.
Dialogue: 0,0:08:58.69,0:09:02.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ide bagus tidak akan muncul begitu saja.
Dialogue: 0,0:09:02.79,0:09:05.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita butuh strategi bisnis yang bagus.
Dialogue: 0,0:09:06.01,0:09:08.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, apa keuangan keluargamu aman?
Dialogue: 0,0:09:08.86,0:09:10.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Maksudmu?
Dialogue: 0,0:09:11.00,0:09:12.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biaya pembangunan stasiun penyiaran.
Dialogue: 0,0:09:13.25,0:09:16.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti menghabiskan dana yang sangat besar.
Dialogue: 0,0:09:16.99,0:09:18.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:09:18.32,0:09:22.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau meremehkan kekayaan keluarga Silver\Ndi tingkat kelima?
Dialogue: 0,0:09:22.50,0:09:24.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak butuh dikhawatirkan olehmu!
Dialogue: 0,0:09:29.38,0:09:30.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa mendadak batuk-batuk?
Dialogue: 0,0:09:31.30,0:09:32.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:09:32.50,0:09:33.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga penasaran.
Dialogue: 0,0:09:33.91,0:09:34.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:09:34.96,0:09:36.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba pikir,
Dialogue: 0,0:09:36.94,0:09:40.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}keluarga Liston di tingkat keempat saja\Nsempat kesulitan keuangan.
Dialogue: 0,0:09:40.90,0:09:42.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian pasti kesulitan juga, 'kan?
Dialogue: 0,0:09:42.89,0:09:45.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Anu... iya...
Dialogue: 0,0:09:46.21,0:09:47.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kasihan sekali.
Dialogue: 0,0:09:47.64,0:09:49.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata kepincut ketampanan kakakku.
Dialogue: 0,0:09:49.97,0:09:52.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Essera, kau tahu sesuatu?
Dialogue: 0,0:09:52.77,0:09:55.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka meminjam uang\Ndengan jaminan pulau terapung,
Dialogue: 0,0:09:55.29,0:09:57.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan juga menerima investasi besar\Ndari pihak lain.
Dialogue: 0,0:09:58.22,0:10:02.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian juga harus segera\Nmembuat Magic Vision sukses, ya.
Dialogue: 0,0:10:02.96,0:10:04.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, begitulah.
Dialogue: 0,0:10:05.82,0:10:08.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi menghormati Nona Hildetaura,
Dialogue: 0,0:10:08.41,0:10:10.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku juga akan bekerja sama.
Dialogue: 0,0:10:10.58,0:10:13.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku tidak akan kalah darimu!
Dialogue: 0,0:10:19.09,0:10:20.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon maaf.
Dialogue: 0,0:10:21.40,0:10:25.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Reliared melihat sosok Anda\Ndi Magic Vision
Dialogue: 0,0:10:25.51,0:10:27.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan merasa sangat termotivasi.
Dialogue: 0,0:10:28.77,0:10:30.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena Anda berdua seumuran,
Dialogue: 0,0:10:30.96,0:10:33.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia menganggap Anda sebagai saingan.
Dialogue: 0,0:10:35.15,0:10:37.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon maklumi dia.
Dialogue: 0,0:10:39.53,0:10:41.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Nona...\N- Hentikan.
Dialogue: 0,0:10:41.33,0:10:42.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Reliared
Dialogue: 0,0:10:43.03,0:10:44.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sepertinya cocok jadi teman Nia.
Dialogue: 0,0:10:44.98,0:10:46.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Santai sekali.
Dialogue: 0,0:10:46.34,0:10:48.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin berteman dengannya?
Dialogue: 0,0:10:48.75,0:10:50.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mending kita habisi saja dia.
Dialogue: 0,0:10:50.35,0:10:52.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kubilang hentikan.
Dialogue: 0,0:10:53.07,0:10:55.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Neil, sudah waktunya.
Dialogue: 0,0:10:55.27,0:10:55.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:10:56.09,0:10:58.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pergi dulu, Nia.
Dialogue: 0,0:10:58.98,0:11:01.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami juga hendak ke asrama.
Dialogue: 0,0:11:02.98,0:11:05.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai hari ini, kami akan tinggal di sini.
Dialogue: 0,0:11:05.19,0:11:06.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, Nia!
Dialogue: 0,0:11:07.25,0:11:08.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah sehat, ya.
Dialogue: 0,0:11:09.27,0:11:13.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menonton siaran beritamu!
Dialogue: 0,0:11:13.37,0:11:14.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:11:14.99,0:11:16.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, Nia?
Dialogue: 0,0:11:16.65,0:11:17.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asli?
Dialogue: 0,0:11:17.71,0:11:19.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa? Aku tidak kenal.
Dialogue: 0,0:11:22.32,0:11:23.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai hari ini, mohon bimbingannya.
Dialogue: 0,0:11:24.15,0:11:25.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sa-Salam kenal!
Dialogue: 0,0:11:26.01,0:11:29.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pernah menonton acaramu!
Dialogue: 0,0:11:29.25,0:11:30.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:11:31.23,0:11:34.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana dengan acara\N"Catatan Perjalanan Wilayah Liston"-nya Bendelio?
Dialogue: 0,0:11:34.34,0:11:35.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah...
Dialogue: 0,0:11:35.54,0:11:38.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Acara itu isinya cuma minum alkohol.
Dialogue: 0,0:11:39.60,0:11:40.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selera kita sama.
Dialogue: 0,0:11:41.13,0:11:42.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kau?
Dialogue: 0,0:11:43.51,0:11:46.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak punya Magic Vision di rumah.
Dialogue: 0,0:11:47.62,0:11:48.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:11:49.91,0:11:52.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata lebih banyak yang tidak kenal aku.
Dialogue: 0,0:11:53.60,0:11:54.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengawas Karme.
Dialogue: 0,0:11:55.29,0:11:58.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa di akademi tidak ada Magic Vision?
Dialogue: 0,0:11:58.24,0:11:59.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitulah.
Dialogue: 0,0:11:59.70,0:12:01.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang-orang menganggap itu\Nbarang khusus bangsawan.
Dialogue: 0,0:12:01.89,0:12:04.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, jarang ada yang menontonnya.
Dialogue: 0,0:12:05.94,0:12:07.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti kata Hildetaura,
Dialogue: 0,0:12:08.08,0:12:10.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menyebarkan Magic Vision
Dialogue: 0,0:12:10.21,0:12:13.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}memang impian yang terlampau besar.
Dialogue: 0,0:12:14.25,0:12:17.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, kamarmu di sini.
Dialogue: 0,0:12:20.04,0:12:21.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona,
Dialogue: 0,0:12:21.25,0:12:24.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kehidupan kita berdua akhirnya dimulai!
Dialogue: 0,0:12:25.30,0:12:28.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sederhananya, kita akan mulai\Ntinggal bersama!
Dialogue: 0,0:12:28.62,0:12:30.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa diubah bahasanya?
Dialogue: 0,0:12:32.35,0:12:33.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini kamar tidurnya, ya.
Dialogue: 0,0:12:36.77,0:12:39.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau tidur bersama sekarang?
Dialogue: 0,0:12:41.44,0:12:43.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamarmu di sebelah sana, 'kan?
Dialogue: 0,0:12:43.44,0:12:46.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah kau bilang mau belanja?
Dialogue: 0,0:12:46.74,0:12:48.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona!
Dialogue: 0,0:12:48.53,0:12:51.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita kan baru sampai,\Njadi santai dulu, dong.
Dialogue: 0,0:12:51.49,0:12:54.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersantai itu setelah tugas selesai.
Dialogue: 0,0:12:54.63,0:12:55.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo pergi.
Dialogue: 0,0:12:55.87,0:12:57.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:13:02.00,0:13:03.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bertemu lagi, Nia.
Dialogue: 0,0:13:04.17,0:13:05.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau belanja juga?
Dialogue: 0,0:13:05.65,0:13:06.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:13:06.76,0:13:08.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau mengambil seragam.
Dialogue: 0,0:13:08.86,0:13:11.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kru kamera dari Silver ada di sini.
Dialogue: 0,0:13:11.50,0:13:12.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kru kamera?
Dialogue: 0,0:13:13.01,0:13:14.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:13:14.39,0:13:18.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka ingin menayangkan diriku\Nsaat memakai seragam.
Dialogue: 0,0:13:19.36,0:13:20.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kecolongan.
Dialogue: 0,0:13:21.17,0:13:22.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona, ini...
Dialogue: 0,0:13:23.05,0:13:24.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti.
Dialogue: 0,0:13:26.29,0:13:27.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku boleh ikut tampil?
Dialogue: 0,0:13:27.91,0:13:30.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Kau? Kenapa?
Dialogue: 0,0:13:31.74,0:13:34.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tampak akrab dari sekarang,
Dialogue: 0,0:13:34.39,0:13:36.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ke depannya akan lebih mudah.
Dialogue: 0,0:13:36.21,0:13:38.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ki-Kita kan tidak seakrab itu!
Dialogue: 0,0:13:39.64,0:13:41.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa pegang tanganku?
Dialogue: 0,0:13:41.92,0:13:43.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ayo, kita pergi!\N- Hei! Aduh, sakit!
Dialogue: 0,0:13:43.88,0:13:47.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ayo, bergandengan tangan!\N- Tu-Tunggu sebentar!
Dialogue: 0,0:13:47.10,0:13:48.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nia Liston: The Merciless Maiden
Dialogue: 0,0:14:37.50,0:14:38.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dimulai.
Dialogue: 0,0:14:42.19,0:14:44.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kehidupan akademi yang baru.
Dialogue: 0,0:15:00.28,0:15:02.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cut!
Dialogue: 0,0:15:02.69,0:15:04.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, bagus!
Dialogue: 0,0:15:04.37,0:15:06.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini, cukup sampai di sini.
Dialogue: 0,0:15:09.29,0:15:10.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sutradara,
Dialogue: 0,0:15:10.60,0:15:11.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}terima kasih banyak.
Dialogue: 0,0:15:12.53,0:15:14.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Prosesnya jadi sangat lancar.
Dialogue: 0,0:15:16.44,0:15:17.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak!
Dialogue: 0,0:15:18.14,0:15:20.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih juga!
Dialogue: 0,0:15:20.19,0:15:22.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Persiapan masuk putri penguasa wilayah
Dialogue: 0,0:15:22.58,0:15:24.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan momen keakraban keluarga.
Dialogue: 0,0:15:24.89,0:15:27.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkat kalian bertiga, hasilnya bagus!
Dialogue: 0,0:15:33.10,0:15:35.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf mendadak memanggilmu, Kakanda.
Dialogue: 0,0:15:36.46,0:15:38.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:15:38.21,0:15:39.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sungkan.
Dialogue: 0,0:15:39.91,0:15:42.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku pulang dulu.
Dialogue: 0,0:15:45.54,0:15:48.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia takut dapat surat penggemar lagi.
Dialogue: 0,0:15:48.74,0:15:49.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nia!
Dialogue: 0,0:15:50.86,0:15:53.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makan siang bareng, yuk.
Dialogue: 0,0:15:53.49,0:15:54.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:15:54.76,0:15:56.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para ayundaku juga datang.
Dialogue: 0,0:15:56.87,0:15:58.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lama tidak bertemu, Nia.
Dialogue: 0,0:15:59.30,0:16:01.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Lilimi Silver.
Dialogue: 0,0:16:01.36,0:16:02.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salam kenal, ya.
Dialogue: 0,0:16:02.32,0:16:05.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salam kenal juga. Aku Nia Liston.
Dialogue: 0,0:16:05.75,0:16:09.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku terakhir bertemu Nona Raffine\Nsaat peresmian stasiun penyiaran.
Dialogue: 0,0:16:10.66,0:16:12.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, kita pergi!
Dialogue: 0,0:16:23.44,0:16:24.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syuting hari ini,
Dialogue: 0,0:16:24.71,0:16:27.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berkat dandanan dari Ayunda Raffine,
Dialogue: 0,0:16:27.37,0:16:28.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku jadi kelihatan imut!
Dialogue: 0,0:16:28.85,0:16:31.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja. Itu kan pekerjaanku.
Dialogue: 0,0:16:34.47,0:16:38.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai tahun ini, aku kelas 3 SMP.
Dialogue: 0,0:16:38.58,0:16:39.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:16:39.89,0:16:41.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayunda Lilimi itu kuat sekali.
Dialogue: 0,0:16:42.13,0:16:45.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tahun lalu, dia juara dua\Ndi turnamen bela diri SMP.
Dialogue: 0,0:16:48.55,0:16:51.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tubuhnya dilatih untuk bertarung\Ndengan tangan kosong.
Dialogue: 0,0:17:17.60,0:17:19.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebegini saja juara dua?
Dialogue: 0,0:17:20.05,0:17:22.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Turnamen bela dirinya serius atau tidak, sih?
Dialogue: 0,0:17:23.95,0:17:25.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau terkejut?
Dialogue: 0,0:17:25.17,0:17:27.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, dalam arti tertentu, ya.
Dialogue: 0,0:17:27.59,0:17:29.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayundaku murid Aliran Tenha
Dialogue: 0,0:17:30.15,0:17:32.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan aku juga belajar sejak tahun lalu.
Dialogue: 0,0:17:32.58,0:17:33.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenha?
Dialogue: 0,0:17:33.83,0:17:37.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aliran yang tidak pernah kudengar\Nsemasa hidupku dulu.
Dialogue: 0,0:17:37.53,0:17:38.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau coba juga?
Dialogue: 0,0:17:39.14,0:17:40.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelihatannya kau cukup kuat.
Dialogue: 0,0:17:40.88,0:17:42.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak usah.
Dialogue: 0,0:17:42.84,0:17:44.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak berminat.
Dialogue: 0,0:17:45.42,0:17:47.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aliran yang mengklaim\Nbisa membelah langit,
Dialogue: 0,0:17:47.98,0:17:49.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kesannya sangat arogan.
Dialogue: 0,0:17:49.75,0:17:50.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tertarik.
Dialogue: 0,0:17:52.70,0:17:53.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong,
Dialogue: 0,0:17:54.57,0:17:58.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}besok guruku ikut kunjungan klub.
Dialogue: 0,0:17:58.70,0:17:59.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guru?
Dialogue: 0,0:17:59.89,0:18:02.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk mencari murid baru?
Dialogue: 0,0:18:02.04,0:18:02.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:18:03.09,0:18:06.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Klub Aliran Tenha ada di SD, SMP, hingga SMA.
Dialogue: 0,0:18:07.27,0:18:10.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dia gurumu... berarti dia kuat?
Dialogue: 0,0:18:10.50,0:18:11.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja.
Dialogue: 0,0:18:11.86,0:18:14.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski masih muda,\Ndia sudah jadi wakil guru besar,
Dialogue: 0,0:18:14.27,0:18:18.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan katanya kemampuannya sudah melampaui\Nsang guru besar.
Dialogue: 0,0:18:18.41,0:18:19.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh?
Dialogue: 0,0:18:21.47,0:18:22.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}L-Lo?
Dialogue: 0,0:18:22.96,0:18:24.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Barusan... ada sesuatu...
Dialogue: 0,0:18:25.22,0:18:26.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perasaanku saja?
Dialogue: 0,0:18:27.08,0:18:28.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mendadak merinding...
Dialogue: 0,0:18:30.31,0:18:31.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi begitu.
Dialogue: 0,0:18:31.89,0:18:35.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata ada orang kuat\Nyang berada di dekat sini, ya.
Dialogue: 0,0:18:43.03,0:18:45.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Nia itu orang seperti apa?
Dialogue: 0,0:18:45.77,0:18:47.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudmu?
Dialogue: 0,0:18:47.71,0:18:50.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sangat kuat, ya.
Dialogue: 0,0:18:50.45,0:18:52.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuatnya sampai tidak masuk akal.
Dialogue: 0,0:18:55.14,0:18:56.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau yang mengajarinya?
Dialogue: 0,0:18:56.95,0:18:57.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah...
Dialogue: 0,0:18:58.82,0:19:00.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa dibilang begitu.
Dialogue: 0,0:19:02.48,0:19:05.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga penasaran dengan Nona Reliared.
Dialogue: 0,0:19:06.28,0:19:09.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya dia menganggap Nona Nia\Nsebagai saingannya.
Dialogue: 0,0:19:09.98,0:19:11.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:19:11.03,0:19:14.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiap kali melihat Nona Nia di Magic Vision,\Ndia bilang begini.
Dialogue: 0,0:19:14.93,0:19:15.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bilang apa?
Dialogue: 0,0:19:16.04,0:19:18.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Aku jauh lebih imut!" atau...
Dialogue: 0,0:19:18.40,0:19:21.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Aku pasti bisa tampil lebih memukau!"
Dialogue: 0,0:19:21.97,0:19:22.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:19:22.64,0:19:26.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Nia seratus kali lebih imut\Ndaripada kerdil sialan itu.
Dialogue: 0,0:19:26.73,0:19:28.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagimu mungkin begitu,
Dialogue: 0,0:19:28.85,0:19:31.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi bagaimana dengan orang lain?
Dialogue: 0,0:19:31.06,0:19:34.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudut pandangmu aneh sekali, ya.
Dialogue: 0,0:19:34.93,0:19:37.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Nia masih berumur enam tahun,
Dialogue: 0,0:19:38.01,0:19:41.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi ketenangannya agak aneh.
Dialogue: 0,0:19:41.04,0:19:44.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesannya bukan anak kecil, tapi orang dewasa.
Dialogue: 0,0:19:50.42,0:19:53.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelak, akan kuberi dia pelajaran!
Dialogue: 0,0:19:53.38,0:19:57.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kutunjukkan betapa imutnya Nonaku\Ndengan tinjuku ini!
Dialogue: 0,0:20:02.84,0:20:05.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kue ini enak sekali!
Dialogue: 0,0:20:05.25,0:20:06.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga suka kue ini.
Dialogue: 0,0:20:07.14,0:20:08.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, omong-omong,
Dialogue: 0,0:20:08.69,0:20:10.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kemarin di aula latihan sekolah,
Dialogue: 0,0:20:10.52,0:20:12.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- ada kejadian lucu sekali!\N- Hei, Nia.
Dialogue: 0,0:20:12.22,0:20:13.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Ceritakan, dong!
Dialogue: 0,0:20:13.38,0:20:15.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Jadi begini...\N- Kucing liar masuk ke sana.
Dialogue: 0,0:20:15.95,0:20:19.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Meski aku menganggapmu saingan,\N- Kucing liar? Lucu banget!
Dialogue: 0,0:20:19.92,0:20:22.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}setelah syuting seharian bersamamu,\Naku jadi berpikir begini.
Dialogue: 0,0:20:24.16,0:20:25.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sutradara,
Dialogue: 0,0:20:25.42,0:20:27.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}terima kasih banyak.
Dialogue: 0,0:20:27.39,0:20:29.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkatmu, semuanya jadi lancar.
Dialogue: 0,0:20:33.97,0:20:34.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau
Dialogue: 0,0:20:35.49,0:20:36.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lebih hebat daripada dugaanku.
Dialogue: 0,0:20:40.60,0:20:42.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, jangan salah paham.
Dialogue: 0,0:20:43.25,0:20:45.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja, aku tidak akan kalah darimu.
Dialogue: 0,0:20:45.78,0:20:46.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi,
Dialogue: 0,0:20:47.70,0:20:49.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau kau mau...
Dialogue: 0,0:20:49.98,0:20:53.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku bersedia, kok,\Nikut menyebarkan Magic Vision bersamamu.
Dialogue: 0,0:20:57.80,0:21:00.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Katakan sesuatu, dong!
Dialogue: 0,0:21:02.25,0:21:03.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aliran Tenha...!
Dialogue: 0,0:21:03.89,0:21:06.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benar-benar ingin adu tanding!
Dialogue: 0,0:21:06.50,0:21:07.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:21:07.51,0:21:11.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei! Kau dengar ucapanku, tidak?!
Dialogue: 0,0:21:34.14,0:21:35.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}No-Nona.
Dialogue: 0,0:21:36.48,0:21:37.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:21:37.59,0:21:39.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suasana hati Anda sepertinya sedang baik, ya.
Dialogue: 0,0:21:40.93,0:21:43.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaliknya, suasana hatimu\Nmalah sangat buruk.
Dialogue: 0,0:21:44.05,0:21:45.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:21:45.14,0:21:48.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada lawan yang harus saya kalahkan.
Dialogue: 0,0:21:49.11,0:21:51.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, aku iri.
Dialogue: 0,0:21:51.85,0:21:52.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga.
Dialogue: 0,0:21:53.00,0:21:53.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh!
Dialogue: 0,0:21:53.71,0:21:56.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa orangnya?!\NSiapa orang kurang ajar itu?!
Dialogue: 0,0:21:58.13,0:21:59.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Besok,
Dialogue: 0,0:21:59.39,0:22:02.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ada pemeriksaan fisik dan kunjungan klub.
Dialogue: 0,0:22:02.33,0:22:03.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya bakal sibuk.
Dialogue: 0,0:22:04.14,0:22:06.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beri tahu saya, dong!
Dialogue: 0,0:22:06.34,0:22:07.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak mau,
Dialogue: 0,0:22:07.68,0:22:10.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mari tidur bersama, Nona!
Dialogue: 0,0:22:10.21,0:22:11.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo habiskan malam berdua
Dialogue: 0,0:22:11.30,0:22:13.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kunjungan klub...\N- di ranjang sekarang juga!
Dialogue: 0,0:22:13.59,0:22:17.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Besok, guruku ikut kunjungan klub.
Dialogue: 0,0:22:20.61,0:22:23.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggulah, Aliran Tenha!
Dialogue: 0,0:23:55.77,0:23:58.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya, "Rapat Penyebaran Magic Vision".
