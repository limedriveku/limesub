Dialogue: 0,0:02:15.59,0:02:19.09,sign,,0000,0000,0000,,NATSUNO
Dialogue: 0,0:02:21.72,0:02:22.55,sign,,0000,0000,0000,,DOKTER DOMON
Dialogue: 0,0:02:24.22,0:02:25.97,sign,,0000,0000,0000,,YAE
Dialogue: 0,0:02:27.10,0:02:29.10,sign,,0000,0000,0000,,KIBA NANOKA, OTOYA
Dialogue: 0,0:02:44.16,0:02:45.79,sign,,0000,0000,0000,,"MAO"
Dialogue: 0,0:05:15.85,0:05:18.48,sign,,0000,0000,0000,,NATSUNO
Dialogue: 0,0:08:07.57,0:08:09.40,sign,,0000,0000,0000,,"DAIGO"
Dialogue: 0,0:10:45.85,0:10:46.77,sign,,0000,0000,0000,,GURU KLAN GOKO
Dialogue: 0,0:11:59.17,0:12:02.30,sign,,0000,0000,0000,,"SANA"
Dialogue: 0,0:13:51.37,0:13:53.45,sign,,0000,0000,0000,,KAMON, MASAGO
Dialogue: 0,0:13:53.66,0:13:55.96,sign,,0000,0000,0000,,HAKUBI
Dialogue: 0,0:13:59.67,0:14:00.95,sign,,0000,0000,0000,,HYAKKA
Dialogue: 0,0:17:43.89,0:17:46.69,sign,,0000,0000,0000,,"BENIKO"
Dialogue: 0,0:23:04.13,0:23:05.26,sign,,0000,0000,0000,,SHIRANUI
Dialogue: 0,0:24:49.07,0:24:51.24,sign,,0000,0000,0000,,"SELANJUTNYA"
Dialogue: 0,0:00:20.97,0:00:22.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau Dokter Domon, 'kan?
Dialogue: 0,0:00:27.36,0:00:28.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengobatanmu menggunakan tanah.
Dialogue: 0,0:00:29.86,0:00:33.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah itu awalnya diajarkan\Nkepadamu oleh orang lain?
Dialogue: 0,0:00:33.78,0:00:36.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tahu sesuatu tentang ini?
Dialogue: 0,0:00:37.53,0:00:38.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentang orang itu?
Dialogue: 0,0:00:39.08,0:00:40.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang itu?
Dialogue: 0,0:00:41.54,0:00:43.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kau tahu?
Dialogue: 0,0:02:19.93,0:02:21.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayangku...
Dialogue: 0,0:02:22.64,0:02:23.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yae!
Dialogue: 0,0:02:29.73,0:02:30.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau harus berbaring.
Dialogue: 0,0:02:31.23,0:02:32.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya baik-baik saja.
Dialogue: 0,0:02:33.86,0:02:34.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wanita itu...
Dialogue: 0,0:02:35.98,0:02:37.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia istriku.
Dialogue: 0,0:02:37.49,0:02:39.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sudah lama sakit.
Dialogue: 0,0:02:40.57,0:02:43.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Istrinya? Dia masih sangat muda.
Dialogue: 0,0:02:44.16,0:02:45.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kuperiksa dia.
Dialogue: 0,0:02:45.87,0:02:47.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku seorang onmyoji.
Dialogue: 0,0:02:52.50,0:02:54.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sekitar 30 tahun lalu.
Dialogue: 0,0:02:57.01,0:02:58.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat itu
Dialogue: 0,0:02:59.72,0:03:02.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku belajar untuk menjadi dokter.
Dialogue: 0,0:03:03.18,0:03:04.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Istriku, Yae,
Dialogue: 0,0:03:05.31,0:03:10.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bekerja untuk membantu\Nmembayar uang kuliahku.
Dialogue: 0,0:03:11.19,0:03:15.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada pelanggan yang sangat merepotkan\Ndi bar tempat dia bekerja.
Dialogue: 0,0:03:15.32,0:03:17.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia menjadi sangat terobsesi dengan Yae.
Dialogue: 0,0:03:18.99,0:03:20.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti penguntit?
Dialogue: 0,0:03:21.28,0:03:23.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Domon... Sesuatu terjadi pada Yae!
Dialogue: 0,0:03:25.70,0:03:27.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yae... Yae!
Dialogue: 0,0:03:28.70,0:03:31.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia disergap oleh seorang pelanggan.
Dialogue: 0,0:03:32.96,0:03:35.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada yang bisa kulakukan.
Dialogue: 0,0:03:36.75,0:03:38.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu orang itu muncul.
Dialogue: 0,0:03:42.72,0:03:44.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku turut berduka cita.
Dialogue: 0,0:03:45.85,0:03:50.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang itu menutupi luka Yae\Ndengan semacam tanah yang diuleni.
Dialogue: 0,0:03:51.23,0:03:52.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beberapa hari kemudian,
Dialogue: 0,0:03:52.81,0:03:56.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yae pulih seolah-olah tidak terjadi apa-apa.
Dialogue: 0,0:03:57.27,0:03:59.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang itu bilang itu Onmyojutsu.
Dialogue: 0,0:04:00.82,0:04:03.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu dia meninggalkan obat Tanah,
Dialogue: 0,0:04:03.66,0:04:06.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menyuruhku memakainya jika dia jatuh sakit.
Dialogue: 0,0:04:07.78,0:04:09.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia juga mengajariku
Dialogue: 0,0:04:09.45,0:04:11.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}cara memilih tanah yang tepat\Ndan cara menyiapkannya,
Dialogue: 0,0:04:11.83,0:04:14.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku tidak pernah bisa\Nmelakukannya dengan benar.
Dialogue: 0,0:04:15.08,0:04:17.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kau menguji efek tanah
Dialogue: 0,0:04:17.33,0:04:19.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang kau siapkan sendiri pada pasienmu?
Dialogue: 0,0:04:20.33,0:04:21.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:04:21.33,0:04:25.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beberapa tahun terakhir ini,\NYae tidak sehat.
Dialogue: 0,0:04:32.06,0:04:36.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awalnya, tanah yang kugunakan pada\Npasienku akan memulihkan kesehatan mereka.
Dialogue: 0,0:04:36.40,0:04:38.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi setelah beberapa hari,\Nkeadaan akan mulai kacau.
Dialogue: 0,0:04:39.78,0:04:41.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pria ini...
Dialogue: 0,0:04:41.86,0:04:44.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar banyak pasien yang kau rawat
Dialogue: 0,0:04:44.70,0:04:47.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan obat Tanah-mu menghilang.
Dialogue: 0,0:04:48.49,0:04:51.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemungkinan mereka ditelan oleh tanah
Dialogue: 0,0:04:51.66,0:04:53.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan menghilang tanpa jejak.
Dialogue: 0,0:04:54.08,0:04:55.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perbuatanmu tidak termaafkan.
Dialogue: 0,0:04:56.38,0:04:58.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa yang mengajarimu mantra seperti itu?
Dialogue: 0,0:04:59.55,0:05:01.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan terlalu kaku.
Dialogue: 0,0:05:01.71,0:05:03.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia berusaha menyelamatkan\Nwanita yang dia cintai,
Dialogue: 0,0:05:03.63,0:05:05.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi dia tidak punya pilihan, bukan?
Dialogue: 0,0:05:06.68,0:05:10.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mao, kau selalu kaku.
Dialogue: 0,0:05:12.43,0:05:13.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seorang wanita?
Dialogue: 0,0:05:20.15,0:05:23.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau yang menyebarkan jimat kupu-kupu ini,\Nbukan, Mao?
Dialogue: 0,0:05:24.36,0:05:25.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka saling mengenal?
Dialogue: 0,0:05:25.86,0:05:26.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu...
Dialogue: 0,0:05:27.16,0:05:28.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau.
Dialogue: 0,0:05:30.58,0:05:33.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau yang memberiku obat Tanah saat itu.
Dialogue: 0,0:05:34.71,0:05:37.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon. Aku butuh lebih banyak obat.
Dialogue: 0,0:05:37.79,0:05:39.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Istriku tidak sehat.
Dialogue: 0,0:05:40.09,0:05:41.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon!
Dialogue: 0,0:05:41.84,0:05:43.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah. Biar kuperiksa dia.
Dialogue: 0,0:05:53.72,0:05:54.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah...
Dialogue: 0,0:05:54.98,0:05:56.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:05:56.77,0:05:57.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sudah meninggal.
Dialogue: 0,0:05:58.52,0:05:59.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yae!
Dialogue: 0,0:06:00.15,0:06:01.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah meninggal selama beberapa tahun.
Dialogue: 0,0:06:02.52,0:06:03.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:06:03.98,0:06:05.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga.
Dialogue: 0,0:06:06.45,0:06:08.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yae... Ini tidak mungkin...
Dialogue: 0,0:06:09.53,0:06:10.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yae!
Dialogue: 0,0:06:13.24,0:06:15.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia terus bertahan demi kau.
Dialogue: 0,0:06:17.16,0:06:18.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setia sekali.
Dialogue: 0,0:06:29.72,0:06:30.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yae...
Dialogue: 0,0:06:31.60,0:06:32.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yae...
Dialogue: 0,0:06:32.89,0:06:33.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yae...
Dialogue: 0,0:06:34.14,0:06:36.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yae! Yae!
Dialogue: 0,0:06:37.48,0:06:39.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yae!
Dialogue: 0,0:06:44.69,0:06:46.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita pergi sekarang, Mao?
Dialogue: 0,0:06:47.24,0:06:49.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada lagi\Nyang bisa kita lakukan di sini.
Dialogue: 0,0:06:55.33,0:06:56.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Natsuno.
Dialogue: 0,0:07:03.54,0:07:06.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, dia juga dari Klan Goko?
Dialogue: 0,0:07:08.97,0:07:10.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau melakukan itu?
Dialogue: 0,0:07:12.55,0:07:14.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudmu kepalanya?
Dialogue: 0,0:07:14.97,0:07:17.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau memberinya obat Tanah?
Dialogue: 0,0:07:18.43,0:07:19.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang, bukan?
Dialogue: 0,0:07:19.89,0:07:23.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tersentuh oleh cintanya yang abadi\Nuntuk istrinya.
Dialogue: 0,0:07:24.48,0:07:25.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi karena itu,
Dialogue: 0,0:07:25.77,0:07:28.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia memakai obat\Nyang tidak sempurna untuk pasiennya
Dialogue: 0,0:07:28.65,0:07:30.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan melakukan lebih banyak kejahatan.
Dialogue: 0,0:07:35.74,0:07:39.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang akan terjadi\Npada Dokter Domon sekarang?
Dialogue: 0,0:07:40.66,0:07:43.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia menyentuh tanah yang digunakan\Npada leher istrinya.
Dialogue: 0,0:07:44.25,0:07:45.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, dia mungkin akan bergabung dengannya.
Dialogue: 0,0:07:47.42,0:07:48.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dokter Domon.
Dialogue: 0,0:07:49.46,0:07:51.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sakit perut.
Dialogue: 0,0:07:53.14,0:07:54.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dokter Domon?
Dialogue: 0,0:07:55.55,0:07:57.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak ada orang di rumah?
Dialogue: 0,0:08:04.98,0:08:06.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mao, kemarilah.
Dialogue: 0,0:08:07.57,0:08:09.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau akan melihat mantra yang luar biasa.
Dialogue: 0,0:08:10.15,0:08:11.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daigo.
Dialogue: 0,0:08:11.95,0:08:13.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakimu patah, bukan?
Dialogue: 0,0:08:14.87,0:08:16.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kasihan.
Dialogue: 0,0:08:17.53,0:08:19.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kuoleskan obat.
Dialogue: 0,0:08:32.38,0:08:33.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah. Cobalah berdiri.
Dialogue: 0,0:08:43.23,0:08:44.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luar biasa.
Dialogue: 0,0:08:46.02,0:08:49.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Obat Tanah Natsuno\Nbisa menyembuhkan luka apa pun.
Dialogue: 0,0:08:49.90,0:08:51.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Natsuno...
Dialogue: 0,0:08:52.44,0:08:53.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kau Mao?
Dialogue: 0,0:08:54.03,0:08:55.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa dibilang, adik Daigo.
Dialogue: 0,0:08:58.41,0:09:00.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mantramu sungguh luar biasa.
Dialogue: 0,0:09:01.41,0:09:03.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi Guru selalu menggangguku.
Dialogue: 0,0:09:04.62,0:09:08.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia terus menegurku karena membuat\Nbukan hanya obat, tapi juga racun.
Dialogue: 0,0:09:09.00,0:09:10.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku tidak peduli ucapannya.
Dialogue: 0,0:09:11.42,0:09:14.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau terus bicara seperti itu,\Ndia akan memarahimu lagi.
Dialogue: 0,0:09:15.68,0:09:20.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyihir Tanah adalah salah satu\Nyang paling berbakat di Klan Goko.
Dialogue: 0,0:09:21.64,0:09:24.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di antara mereka, Daigo dan Natsuno...
Dialogue: 0,0:09:26.44,0:09:27.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Natsuno.
Dialogue: 0,0:09:28.77,0:09:30.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau dipanggil ke Goshikido, bukan?
Dialogue: 0,0:09:32.40,0:09:34.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, aku dipanggil.
Dialogue: 0,0:09:37.36,0:09:39.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pikir Daigo terpilih?
Dialogue: 0,0:09:40.70,0:09:43.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika dia fokus pada latihannya,
Dialogue: 0,0:09:44.45,0:09:46.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia akan melampauiku.
Dialogue: 0,0:09:49.92,0:09:52.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kau juga tahu, Natsuno?
Dialogue: 0,0:09:55.59,0:09:56.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu.
Dialogue: 0,0:09:57.93,0:09:59.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan pergi dulu.
Dialogue: 0,0:10:01.26,0:10:02.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Sana.
Dialogue: 0,0:10:17.32,0:10:20.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daigo, matamu memiliki\Nwarna paling misterius.
Dialogue: 0,0:10:21.74,0:10:22.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Matamu indah.
Dialogue: 0,0:10:24.79,0:10:25.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Sana.
Dialogue: 0,0:10:28.71,0:10:31.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Sana jatuh cinta dengan...
Dialogue: 0,0:10:32.25,0:10:34.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka berdua bertemu diam-diam,
Dialogue: 0,0:10:35.21,0:10:38.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi beberapa orang di kompleks tahu.
Dialogue: 0,0:10:40.14,0:10:43.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika ada murid yang iri\Ndengan kemampuan Daigo tahu
Dialogue: 0,0:10:43.22,0:10:45.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan itu sampai ke telinga Guru...
Dialogue: 0,0:10:47.02,0:10:48.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mao, saat itu,
Dialogue: 0,0:10:49.27,0:10:51.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bukankah kau juga mencintai Nona Sana?
Dialogue: 0,0:10:54.15,0:10:57.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bilang kau yang memberi tahu Guru?
Dialogue: 0,0:10:57.61,0:10:59.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tidak akan pernah melakukan itu!
Dialogue: 0,0:10:59.24,0:11:02.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daigo adalah orang penting dalam hidupku.
Dialogue: 0,0:11:04.54,0:11:06.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika tidak terjadi apa-apa
Dialogue: 0,0:11:07.20,0:11:09.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan Daigo dan Nona Sana bisa bersama,
Dialogue: 0,0:11:10.46,0:11:13.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tak ada yang akan membuatku lebih bahagia.
Dialogue: 0,0:11:15.42,0:11:17.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, itu terdengar sepertimu.
Dialogue: 0,0:11:18.26,0:11:19.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan memercayaimu.
Dialogue: 0,0:11:20.09,0:11:21.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan pergi sekarang.
Dialogue: 0,0:11:24.39,0:11:25.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi...
Dialogue: 0,0:11:25.51,0:11:28.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika Natsuno dipanggil ke Goshikido,
Dialogue: 0,0:11:28.98,0:11:30.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu apa yang terjadi pada Daigo?
Dialogue: 0,0:11:31.73,0:11:34.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang setelah dipanggil\Nke Goshikido,
Dialogue: 0,0:11:35.02,0:11:37.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}murid-murid senior paling berbakat
Dialogue: 0,0:11:37.61,0:11:40.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mulai mati secara misterius, bukan?
Dialogue: 0,0:11:41.32,0:11:42.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:11:42.78,0:11:45.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Korban pertama
Dialogue: 0,0:11:46.83,0:11:48.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah Daigo.
Dialogue: 0,0:11:48.62,0:11:49.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:11:50.96,0:11:54.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau mewarisi semua gulungan rahasia...
Dialogue: 0,0:11:54.79,0:11:57.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mao, itu artinya kau akan menjadi suamiku.
Dialogue: 0,0:11:59.17,0:12:02.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan mematuhi keinginan ayahku.
Dialogue: 0,0:12:03.59,0:12:05.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi Nona Sana jatuh cinta dengan...
Dialogue: 0,0:12:07.18,0:12:08.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daigo.
Dialogue: 0,0:12:10.73,0:12:12.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa Mao?
Dialogue: 0,0:12:12.23,0:12:14.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya yatim piatu dari rumah anak telantar.
Dialogue: 0,0:12:14.48,0:12:15.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tidak layak.
Dialogue: 0,0:12:16.40,0:12:18.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa pun ucapan\Nmurid senior lainnya kepadaku,
Dialogue: 0,0:12:18.65,0:12:19.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku bisa menahannya.
Dialogue: 0,0:12:20.78,0:12:24.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi apa pendapat Daigo tentangku?
Dialogue: 0,0:12:26.24,0:12:29.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami tumbuh bersama di rumah anak telantar.
Dialogue: 0,0:12:30.54,0:12:34.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu dia mewujudkan impiannya\Nbergabung dengan Klan Goko.
Dialogue: 0,0:12:35.17,0:12:37.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan melalui rekomendasinya,
Dialogue: 0,0:12:37.34,0:12:39.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku dibawa ke Klan Goko.
Dialogue: 0,0:12:40.76,0:12:43.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku terpilih, bukannya Daigo.
Dialogue: 0,0:12:45.30,0:12:46.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mao.
Dialogue: 0,0:12:47.72,0:12:49.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya aku tidak membawamu ke sini.
Dialogue: 0,0:12:50.31,0:12:51.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menyesalinya.
Dialogue: 0,0:12:53.31,0:12:54.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga.
Dialogue: 0,0:12:55.73,0:12:56.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daigo,
Dialogue: 0,0:12:57.40,0:13:00.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku ingin meninggalkan Klan Goko.
Dialogue: 0,0:13:03.40,0:13:04.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku.
Dialogue: 0,0:13:04.95,0:13:05.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:13:06.57,0:13:07.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pernah bilang
Dialogue: 0,0:13:07.87,0:13:12.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Klan Goko seperti surga.
Dialogue: 0,0:13:15.04,0:13:16.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru kebalikannya.
Dialogue: 0,0:13:16.71,0:13:17.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempat ini...
Dialogue: 0,0:13:20.00,0:13:22.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keesokan paginya, Daigo...
Dialogue: 0,0:13:23.42,0:13:25.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ditemukan tewas di halaman kompleks.
Dialogue: 0,0:13:27.34,0:13:29.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada tanda-tanda tanah\Ndigali di bawah kakinya.
Dialogue: 0,0:13:30.06,0:13:31.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa benda terkutuk dikubur di sini?
Dialogue: 0,0:13:32.60,0:13:34.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tidak sengaja menginjaknya.
Dialogue: 0,0:13:34.73,0:13:35.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan dikutuk sampai mati.
Dialogue: 0,0:13:40.02,0:13:41.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daigo!
Dialogue: 0,0:13:43.40,0:13:44.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daigo!
Dialogue: 0,0:13:48.53,0:13:49.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:13:58.75,0:13:59.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hyakka?
Dialogue: 0,0:14:00.96,0:14:02.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak pernah tahu
Dialogue: 0,0:14:03.38,0:14:05.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bahwa setelah aku terpilih sebagai penerus,
Dialogue: 0,0:14:05.84,0:14:09.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}beberapa murid senior\Ntelah dipanggil ke Goshikido.
Dialogue: 0,0:14:11.01,0:14:13.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kutuk Mao, sang tumbal, sampai mati.
Dialogue: 0,0:14:14.02,0:14:18.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa pun yang selamat pada akhirnya\Nakan menjadi penerus sejati.
Dialogue: 0,0:14:30.03,0:14:31.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Sana...
Dialogue: 0,0:14:32.99,0:14:34.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belum pernah melihat\Nekspresi itu di wajahnya.
Dialogue: 0,0:14:35.79,0:14:39.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dimulai dengan kematian Daigo,
Dialogue: 0,0:14:41.13,0:14:46.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}murid-murid senior terbaik\Ndari tiap Lima Elemen
Dialogue: 0,0:14:46.59,0:14:49.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mulai mati satu per satu\Ndalam keadaan misterius.
Dialogue: 0,0:14:51.39,0:14:56.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, jika Natsuno dipanggil\Nke Goshikido, itu berarti...
Dialogue: 0,0:14:56.52,0:14:59.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Jika diingat lagi,
Dialogue: 0,0:14:59.81,0:15:02.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daigo mungkin dibunuh oleh kutukan\Nyang ditujukan untuk orang lain.
Dialogue: 0,0:15:04.40,0:15:06.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oleh seseorang yang dipanggil ke Goshikido.
Dialogue: 0,0:15:07.69,0:15:08.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:15:09.40,0:15:11.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sangat tidak adil.
Dialogue: 0,0:15:12.99,0:15:15.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau mencoba menghibur Nona Sana
Dialogue: 0,0:15:17.37,0:15:20.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau menangis bersamanya?
Dialogue: 0,0:15:21.38,0:15:22.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa
Dialogue: 0,0:15:23.54,0:15:24.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}melakukan apa pun untuknya.
Dialogue: 0,0:15:27.42,0:15:28.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu menyedihkan.
Dialogue: 0,0:15:29.76,0:15:31.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sudah lama sekali.
Dialogue: 0,0:15:32.26,0:15:36.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kau masih menyukai Nona Sana, bukan?
Dialogue: 0,0:15:37.93,0:15:41.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sebabnya kau begitu terpaku\Npada wanita itu, Yurako, bukan?
Dialogue: 0,0:15:46.61,0:15:48.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak tahu harus berpikir apa lagi.
Dialogue: 0,0:15:49.40,0:15:51.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana bisa seseorang\Nyang begitu baik dan polos
Dialogue: 0,0:15:52.53,0:15:54.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}memuntahkan kutukan hitam dari mulutnya?
Dialogue: 0,0:15:55.45,0:15:57.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan pria yang dia cintai,\Nbahkan dikutuk sampai mati.
Dialogue: 0,0:15:58.95,0:16:00.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sana sudah mati.
Dialogue: 0,0:16:01.25,0:16:03.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jantungnya dicabut dari dadanya.
Dialogue: 0,0:16:04.13,0:16:07.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi dia muncul di hadapan Mao\Ndengan penampilan yang sama.
Dialogue: 0,0:16:08.51,0:16:10.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan halangi aku!
Dialogue: 0,0:16:11.09,0:16:13.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awalnya, aku tidak bisa\Nmenghubungkan keduanya.
Dialogue: 0,0:16:14.39,0:16:15.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanoka.
Dialogue: 0,0:16:16.64,0:16:18.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya ingin tahu
Dialogue: 0,0:16:19.22,0:16:20.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kenapa Nona Sana masih hidup
Dialogue: 0,0:16:21.73,0:16:23.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan bagaimana dia menjadi pion\Nuntuk Shiranui?
Dialogue: 0,0:16:25.02,0:16:26.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu saja?
Dialogue: 0,0:16:27.36,0:16:29.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika ada cara untuk menyelamatkannya,\Naku mau.
Dialogue: 0,0:16:31.32,0:16:32.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu apa?
Dialogue: 0,0:16:34.53,0:16:37.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau ingin bersamanya?
Dialogue: 0,0:16:37.78,0:16:38.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:16:38.83,0:16:41.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kau bicarakan?
Dialogue: 0,0:16:50.84,0:16:52.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arusnya berubah?
Dialogue: 0,0:16:53.30,0:16:56.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Tiba-tiba,\Nkita tidak bisa menangkap ikan.
Dialogue: 0,0:16:56.93,0:16:58.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang kita dapatkan hanyalah...
Dialogue: 0,0:16:58.43,0:17:00.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial! Terjadi lagi!
Dialogue: 0,0:17:00.81,0:17:03.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tersangkut di jala!
Dialogue: 0,0:17:18.20,0:17:20.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia di dasar laut sekarang?
Dialogue: 0,0:17:21.36,0:17:22.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pasti bercanda.
Dialogue: 0,0:17:25.07,0:17:28.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah menemukan kuil Shiranui,\NTuan Kamon?
Dialogue: 0,0:17:29.04,0:17:32.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Tapi karena ada di bawah sana,\Ntidak banyak yang bisa kita lakukan.
Dialogue: 0,0:17:33.67,0:17:37.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Sana juga belum datang ke salon\Nsejak saat itu.
Dialogue: 0,0:17:38.89,0:17:42.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya Shiranui kembali bersembunyi\Ndi kuilnya.
Dialogue: 0,0:17:43.89,0:17:46.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu, Tuan Kamon?
Dialogue: 0,0:17:46.77,0:17:47.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini?
Dialogue: 0,0:17:47.94,0:17:50.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini tersangkut di jala.
Dialogue: 0,0:17:51.28,0:17:54.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini rambut yang mengambang dari kuil itu.
Dialogue: 0,0:17:55.74,0:17:59.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang direncanakan\NShiranui berengsek itu sekarang?
Dialogue: 0,0:18:00.16,0:18:03.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau berniat membunuh Shiranui, Tuan Kamon?
Dialogue: 0,0:18:05.00,0:18:06.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tergantung.
Dialogue: 0,0:18:08.33,0:18:12.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi pertama, ada banyak hal\Nyang ingin kutanyakan kepadanya.
Dialogue: 0,0:18:17.76,0:18:19.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia menunggumu di sini.
Dialogue: 0,0:18:20.47,0:18:22.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rumah yang luar biasa.
Dialogue: 0,0:18:25.64,0:18:27.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku membawamu sampai sini.
Dialogue: 0,0:18:31.23,0:18:33.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga! Kau pasti tamu Tuan Kuchinawa!
Dialogue: 0,0:18:34.78,0:18:36.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Temannya juga sangat tampan!
Dialogue: 0,0:18:37.07,0:18:38.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau di sini, Mao.
Dialogue: 0,0:18:38.86,0:18:41.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh... Kau membawa Nanoka bersamamu.
Dialogue: 0,0:18:42.74,0:18:44.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namanya Tuan Mao?
Dialogue: 0,0:18:44.58,0:18:46.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tuan Kamon...\N- Apa dia lebih muda dari Tuan Kuchinawa?
Dialogue: 0,0:18:46.66,0:18:48.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kau menumpang di rumah ini sekarang?
Dialogue: 0,0:18:49.29,0:18:50.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau membuatnya terdengar sangat buruk.
Dialogue: 0,0:18:51.46,0:18:54.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menyingkirkan roh\Nyang merasuki nona muda rumah ini,
Dialogue: 0,0:18:54.51,0:18:55.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan mereka bersikeras aku tinggal.
Dialogue: 0,0:18:56.13,0:18:58.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kenapa kau berpakaian seperti itu?
Dialogue: 0,0:18:59.47,0:19:04.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamon, kudengar dari Beniko\Nkau menemukan kuil Shiranui.
Dialogue: 0,0:19:05.10,0:19:07.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Di dasar laut.
Dialogue: 0,0:19:07.85,0:19:09.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar laut...
Dialogue: 0,0:19:09.81,0:19:12.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pergi ke sana terlalu berbahaya.
Dialogue: 0,0:19:13.11,0:19:14.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku menemukan ini.
Dialogue: 0,0:19:17.69,0:19:19.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu rambut, bukan?
Dialogue: 0,0:19:19.40,0:19:20.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menjijikkan...
Dialogue: 0,0:19:21.03,0:19:22.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mao, bersiaplah.
Dialogue: 0,0:19:22.49,0:19:23.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:19:25.95,0:19:27.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akan melakukan ritual pemanggilan roh?
Dialogue: 0,0:19:28.12,0:19:28.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:19:29.83,0:19:32.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awalnya, kupikir itu rambut Shiranui.
Dialogue: 0,0:19:33.67,0:19:36.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi tidak ada aura jahatnya.
Dialogue: 0,0:19:41.84,0:19:45.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami memanggil jiwa\Nyang tinggal di dalam rambut ini.
Dialogue: 0,0:19:46.14,0:19:47.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Datanglah, dengan titah suci!
Dialogue: 0,0:19:48.60,0:19:49.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Otoya.
Dialogue: 0,0:19:49.89,0:19:52.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ritual pemanggilan roh\Nseperti pemanggilan arwah?
Dialogue: 0,0:19:53.15,0:19:56.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Karena rambutnya sendiri\Nberfungsi sebagai katashiro,
Dialogue: 0,0:19:56.90,0:19:59.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}seharusnya memanggil arwah pemiliknya mudah.
Dialogue: 0,0:20:33.02,0:20:34.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masago!
Dialogue: 0,0:20:54.50,0:20:56.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu
Dialogue: 0,0:20:57.04,0:20:58.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hantu?
Dialogue: 0,0:20:58.75,0:21:01.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya itu bukan roh orang hidup.
Dialogue: 0,0:21:01.97,0:21:02.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:21:04.34,0:21:05.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mao.
Dialogue: 0,0:21:05.51,0:21:07.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang aku tidak ada di sana
Dialogue: 0,0:21:08.06,0:21:11.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pada malam saat rumah itu terbakar, bukan?
Dialogue: 0,0:21:12.10,0:21:13.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:21:13.77,0:21:15.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak tahu apa-apa.
Dialogue: 0,0:21:15.94,0:21:18.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berada di luar kompleks\Nuntuk bertemu seorang wanita.
Dialogue: 0,0:21:19.32,0:21:21.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, jangan bilang...
Dialogue: 0,0:21:22.11,0:21:23.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang kau temui
Dialogue: 0,0:21:24.24,0:21:25.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah Masago?
Dialogue: 0,0:21:25.66,0:21:27.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:21:29.20,0:21:31.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malam itu, Masago memintaku keluar
Dialogue: 0,0:21:31.91,0:21:33.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan menunggunya di gubuk di Pantai Utara.
Dialogue: 0,0:21:34.79,0:21:37.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi Masago tidak pernah datang.
Dialogue: 0,0:21:39.00,0:21:41.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menunggu sampai pagi\Ndan saat kembali ke kompleks,
Dialogue: 0,0:21:42.13,0:21:43.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}itu sudah terbakar habis
Dialogue: 0,0:21:44.47,0:21:47.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan Guru serta Nona Sana telah dibunuh.
Dialogue: 0,0:21:48.39,0:21:51.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah kabur saat itu, Mao.
Dialogue: 0,0:21:53.64,0:21:55.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak hari itu,
Dialogue: 0,0:21:55.69,0:21:57.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masago menghilang tanpa jejak.
Dialogue: 0,0:21:58.06,0:21:59.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:21:59.94,0:22:03.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masago ingin menjauh dari Klan Goko.
Dialogue: 0,0:22:03.99,0:22:04.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:22:05.90,0:22:07.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pergilah selagi bisa.
Dialogue: 0,0:22:08.07,0:22:10.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini tempat yang kejam.
Dialogue: 0,0:22:11.33,0:22:12.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah kehancuran Klan Goko,
Dialogue: 0,0:22:13.16,0:22:15.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kupikir mungkin Masago\Nberhasil kabur ke suatu tempat.
Dialogue: 0,0:22:16.75,0:22:20.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi jika dia dipanggil ke Goshikido,
Dialogue: 0,0:22:20.79,0:22:22.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kupikir aku akan bertemu dengannya lagi\Nsuatu hari nanti.
Dialogue: 0,0:22:24.09,0:22:26.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika tidak,
Dialogue: 0,0:22:26.76,0:22:28.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}maka aku hanya berharap dia kabur
Dialogue: 0,0:22:29.47,0:22:32.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk menjalani kehidupan biasa\Ndan menjalani masa hidup alaminya.
Dialogue: 0,0:22:32.81,0:22:33.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya itu yang kuharapkan.
Dialogue: 0,0:22:34.64,0:22:36.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga!
Dialogue: 0,0:22:36.56,0:22:39.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamon tak terlihat begitu,\Ntapi dia sangat romantis.
Dialogue: 0,0:22:40.19,0:22:43.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika rambut Masago\Nberasal dari kuil Shiranui,
Dialogue: 0,0:22:43.86,0:22:45.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}itu berarti...
Dialogue: 0,0:22:46.61,0:22:47.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:22:48.20,0:22:52.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus mendapatkan kebenaran\Ndari Shiranui.
Dialogue: 0,0:22:53.66,0:22:57.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Shiranui,\Nrambutnya telah menembus penghalang.
Dialogue: 0,0:22:58.58,0:23:00.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin saja memindahkan kuil dari Kyoto
Dialogue: 0,0:23:01.25,0:23:03.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}telah membahayakan penghalangnya.
Dialogue: 0,0:23:05.34,0:23:06.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh
Dialogue: 0,0:23:07.76,0:23:09.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tak ada yang lebih menakutkan
Dialogue: 0,0:23:10.22,0:23:12.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}daripada kegigihan seorang wanita.
Dialogue: 0,0:23:13.68,0:23:16.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan begitu, Masago?
Dialogue: 0,0:24:49.07,0:24:51.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Natsuno?
Dialogue: 0,0:24:51.32,0:24:52.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau di sini?
Dialogue: 0,0:24:52.65,0:24:53.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mao,
Dialogue: 0,0:24:53.74,0:24:56.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tidak pernah menduga\Nkau akan mendatangiku.
Dialogue: 0,0:24:56.99,0:24:58.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau ikut dengan Kamon hari ini?
Dialogue: 0,0:24:59.12,0:25:02.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kau tahu alasan kami datang, Shiranui.
Dialogue: 0,0:25:02.54,0:25:05.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kau lakukan kepada Masago?
Dialogue: 0,0:25:05.33,0:25:09.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini saatnya kau mati.
Dialogue: 0,0:25:09.42,0:25:11.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka yang dipanggil ke Goshikido
Dialogue: 0,0:25:11.88,0:25:13.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa saling melukai dan membunuh.
Dialogue: 0,0:25:14.55,0:25:17.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya, "Kuil Bawah Laut".
