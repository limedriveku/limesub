Dialogue: 0,0:00:23.56,0:00:27.40,sign,,0000,0000,0000,,"OTOYA, KIBA NANOKA"
Dialogue: 0,0:00:39.24,0:00:41.16,sign,,0000,0000,0000,,"HYAKKA"
Dialogue: 0,0:00:55.55,0:00:57.76,sign,,0000,0000,0000,,"KAYU, API, TANAH, LOGAM, AIR"
