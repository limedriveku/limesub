Dialogue: 0,0:02:43.83,0:02:47.08,sign,,0000,0000,0000,,MAOGUI
Dialogue: 0,0:02:47.45,0:02:50.79,sign,,0000,0000,0000,,MAO
Dialogue: 0,0:03:45.30,0:03:47.22,sign,,0000,0000,0000,,"EFISIEN"
Dialogue: 0,0:04:01.95,0:04:03.41,sign,,0000,0000,0000,,"EFISIEN"
Dialogue: 0,0:06:54.20,0:06:56.12,sign,,0000,0000,0000,,SHIRAHA
Dialogue: 0,0:07:05.50,0:07:08.42,sign,,0000,0000,0000,,"YUI NAKAGAWA"
Dialogue: 0,0:07:09.01,0:07:09.84,sign,,0000,0000,0000,,"MENATAP"
Dialogue: 0,0:07:10.43,0:07:12.97,sign,,0000,0000,0000,,"KAU BISA MENGANDALKANKU"
