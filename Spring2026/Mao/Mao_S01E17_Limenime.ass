Dialogue: 0,0:07:30.53,0:07:32.87,sign,,0000,0000,0000,,"KAYU, API, TANAH, LOGAM, AIR"
Dialogue: 0,0:10:24.29,0:10:25.12,sign,,0000,0000,0000,,HAIMARU
Dialogue: 0,0:10:27.12,0:10:31.54,sign,,0000,0000,0000,,"GURU KLAN GOKO - SANA"
Dialogue: 0,0:10:37.22,0:10:40.30,sign,,0000,0000,0000,,"HAKUBI"
