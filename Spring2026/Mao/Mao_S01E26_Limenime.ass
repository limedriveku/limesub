Dialogue: 0,0:03:19.70,0:03:22.99,sign,,0000,0000,0000,,DUNIA YURAKO
Dialogue: 0,0:03:30.66,0:03:31.54,sign,,0000,0000,0000,,KIBA NANOKA
Dialogue: 0,0:03:35.04,0:03:37.30,sign,,0000,0000,0000,,YURAKO
Dialogue: 0,0:05:46.22,0:05:48.26,sign,,0000,0000,0000,,GURU KLAN GOKO
Dialogue: 0,0:09:30.57,0:09:33.19,sign,,0000,0000,0000,,MAO
Dialogue: 0,0:10:32.92,0:10:34.96,sign,,0000,0000,0000,,SENGOKU-DAYU
Dialogue: 0,0:12:38.42,0:12:40.84,sign,,0000,0000,0000,,"BEBERAPA TAHUN KEMUDIAN"
Dialogue: 0,0:13:06.57,0:13:08.45,sign,,0000,0000,0000,,HAIMARU, SANA
Dialogue: 0,0:15:47.82,0:15:49.95,sign,,0000,0000,0000,,"OTOYA"
Dialogue: 0,0:17:55.40,0:17:57.36,sign,,0000,0000,0000,,"KAMON"
Dialogue: 0,0:22:57.37,0:22:59.79,sign,,0000,0000,0000,,KEDAI PENGANAN
Dialogue: 0,0:25:14.13,0:25:18.76,sign,,0000,0000,0000,,TERIMA KASIH SUDAH MENONTON!
Dialogue: 0,0:00:26.65,0:00:27.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di mana aku?
Dialogue: 0,0:00:32.82,0:00:33.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh…
Dialogue: 0,0:00:33.90,0:00:35.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak diragukan lagi.
Dialogue: 0,0:00:35.95,0:00:38.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau yang bersama Mao, bukan?
Dialogue: 0,0:00:39.87,0:00:41.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yurako?
Dialogue: 0,0:00:42.75,0:00:45.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah lama aku ingin bertemu dengannya.
Dialogue: 0,0:00:45.92,0:00:48.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak Mao menghilang dari Klan Goko.
Dialogue: 0,0:00:49.96,0:00:50.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Klan Goko?
Dialogue: 0,0:00:51.92,0:00:54.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu 900 tahun itu sangat lama.
Dialogue: 0,0:00:55.80,0:00:57.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi akhirnya aku bisa\Nbertemu dengannya lagi.
Dialogue: 0,0:00:59.30,0:01:02.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, itu artinya Yurako sudah hidup\Nsejak era Heian?
Dialogue: 0,0:01:04.51,0:01:06.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa kau?
Dialogue: 0,0:01:10.32,0:01:13.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mao hanya menyukai Sana.
Dialogue: 0,0:01:14.40,0:01:16.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa Mao mengkhawatirkanku
Dialogue: 0,0:01:17.61,0:01:18.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena wajah ini?
Dialogue: 0,0:01:19.49,0:01:22.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa begitu.
Dialogue: 0,0:01:23.04,0:01:25.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa wajahmu sama dengan Nona Sana?
Dialogue: 0,0:01:25.08,0:01:26.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini adalah
Dialogue: 0,0:01:26.96,0:01:28.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}wajahku!
Dialogue: 0,0:01:31.30,0:01:32.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bukan Sana.
Dialogue: 0,0:01:33.76,0:01:35.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Yurako.
Dialogue: 0,0:03:31.62,0:03:34.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang akan kau lakukan kepadaku?
Dialogue: 0,0:03:35.04,0:03:37.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katakan, Nanoka.
Dialogue: 0,0:03:38.21,0:03:40.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana penampilanku bagimu?
Dialogue: 0,0:03:43.72,0:03:47.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua ayakashi ini adalah kutukan\Nuntuk Klan Goko.
Dialogue: 0,0:03:49.35,0:03:52.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Klan Goko adalah keluarga praktisi kutukan\Nyang diturunkan
Dialogue: 0,0:03:52.64,0:03:53.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dari tradisi Jugondo.
Dialogue: 0,0:03:55.27,0:03:57.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para bangsawan akan menyewa Klan Goko,
Dialogue: 0,0:03:57.86,0:04:00.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan onmyoji akan memberikan kutukan\Natas nama mereka.
Dialogue: 0,0:04:01.36,0:04:02.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi
Dialogue: 0,0:04:02.65,0:04:05.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jika target mereka dilindungi\Noleh onmyoji yang ahli,
Dialogue: 0,0:04:06.41,0:04:08.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mereka akan membalas dengan mantra balasan.
Dialogue: 0,0:04:08.58,0:04:11.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan kutukan juga akan datang\Ndari onmyoji lain
Dialogue: 0,0:04:11.54,0:04:14.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang membenci keberadaan Klan Goko.
Dialogue: 0,0:04:15.54,0:04:16.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:04:16.95,0:04:18.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pernah mendengar cerita ini\Ndi suatu tempat.
Dialogue: 0,0:04:19.88,0:04:20.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:04:21.92,0:04:24.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Byoki itu mendengarnya dari Nona Sana.
Dialogue: 0,0:04:25.97,0:04:29.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, semua kutukan itu menghilang
Dialogue: 0,0:04:29.81,0:04:32.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di atas kediaman.
Dialogue: 0,0:04:33.35,0:04:35.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak. Itu tidak benar.
Dialogue: 0,0:04:35.94,0:04:37.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka hanya menjadi tidak terlihat.
Dialogue: 0,0:04:39.69,0:04:42.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana Yurako bisa tahu soal itu?
Dialogue: 0,0:04:44.70,0:04:46.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tinggal
Dialogue: 0,0:04:48.24,0:04:51.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dalam kegelapan total,\Ndikelilingi batu besar dan jimat terkutuk.
Dialogue: 0,0:04:53.58,0:04:56.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kutukan terhadap Klan Goko
Dialogue: 0,0:04:57.08,0:05:00.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tertangkap di udara oleh kekuatan jimat itu,
Dialogue: 0,0:05:02.46,0:05:04.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu mendatangiku.
Dialogue: 0,0:05:09.05,0:05:12.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peranku adalah menjadi wadah
Dialogue: 0,0:05:12.56,0:05:15.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk menyerap semua kutukan itu\Nke dalam tubuhku.
Dialogue: 0,0:05:18.86,0:05:20.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wadah kutukan.
Dialogue: 0,0:05:21.69,0:05:23.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak pernah mempertanyakannya.
Dialogue: 0,0:05:25.20,0:05:27.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak pernah merasa kekurangan
Dialogue: 0,0:05:28.32,0:05:30.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena itu satu-satunya\Nkehidupan yang kukenal.
Dialogue: 0,0:05:32.62,0:05:35.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu-satunya orang yang datang menemuiku\Nadalah kepala Klan Goko.
Dialogue: 0,0:05:36.71,0:05:38.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang menamai Yurako,
Dialogue: 0,0:05:39.25,0:05:40.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guru Mao.
Dialogue: 0,0:05:50.10,0:05:51.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengar, Yurako.
Dialogue: 0,0:05:52.68,0:05:55.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini mantra untuk mengikat kutukan\Ndari musuh kita
Dialogue: 0,0:05:55.89,0:06:00.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan mengubahnya menjadi roh pelayan\Ndi bawah perintah kita.
Dialogue: 0,0:06:01.73,0:06:04.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu hal yang agak menyakitkan
Dialogue: 0,0:06:05.19,0:06:08.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah ini ditulis di tubuhku\Nsedikit demi sedikit saat aku tumbuh.
Dialogue: 0,0:06:15.54,0:06:16.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tato?
Dialogue: 0,0:06:17.96,0:06:20.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bukan hanya di tanganku.
Dialogue: 0,0:06:21.63,0:06:23.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada di kaki dan punggungku juga.
Dialogue: 0,0:06:24.46,0:06:25.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sangat kejam.
Dialogue: 0,0:06:27.26,0:06:29.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu berlangsung bertahun-tahun.
Dialogue: 0,0:06:34.52,0:06:37.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu suatu hari, aku terbangun dari tidurku
Dialogue: 0,0:06:40.02,0:06:42.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan entah kenapa, pintunya terbuka.
Dialogue: 0,0:06:44.53,0:06:48.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku merasa ayakashi di dalam diriku\Nmulai bergerak.
Dialogue: 0,0:06:50.82,0:06:54.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seolah-olah mereka mendorongku maju.
Dialogue: 0,0:07:15.51,0:07:17.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk kali pertama dalam hidupku,
Dialogue: 0,0:07:19.06,0:07:22.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tahu ada dunia di luar sana.
Dialogue: 0,0:07:30.90,0:07:33.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para ayakashi berusaha lolos.
Dialogue: 0,0:07:36.91,0:07:38.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah kenapa
Dialogue: 0,0:07:39.20,0:07:41.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tidak bisa menolak mereka.
Dialogue: 0,0:07:42.58,0:07:44.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anginnya terasa sangat sejuk.
Dialogue: 0,0:07:46.09,0:07:49.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bulan dan bintang-bintang sangat indah.
Dialogue: 0,0:08:05.61,0:08:06.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu…
Dialogue: 0,0:08:19.45,0:08:21.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak tahu ke mana aku terbang\Natau bagaimana aku bisa sampai di sana.
Dialogue: 0,0:08:26.96,0:08:29.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hal berikutnya yang kutahu…
Dialogue: 0,0:08:52.65,0:08:54.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat itulah aku melihat
Dialogue: 0,0:08:56.11,0:08:58.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}wajahku sendiri untuk kali pertama.
Dialogue: 0,0:08:59.83,0:09:02.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajahku dirusak oleh ayakashi,
Dialogue: 0,0:09:03.16,0:09:06.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku bahkan tidak tahu apakah aku\Ntampak buruk rupa atau tidak.
Dialogue: 0,0:09:09.55,0:09:11.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dirusak oleh ayakashi?
Dialogue: 0,0:09:12.59,0:09:14.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu berarti wajahnya berbeda\Ndari sekarang?
Dialogue: 0,0:09:16.43,0:09:18.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat itulah
Dialogue: 0,0:09:19.10,0:09:20.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku bertemu Mao.
Dialogue: 0,0:09:26.85,0:09:28.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau baik-baik saja?
Dialogue: 0,0:09:38.32,0:09:39.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat itulah
Dialogue: 0,0:09:40.91,0:09:43.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kesedihanku yang sebenarnya dimulai.
Dialogue: 0,0:09:51.67,0:09:54.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mao adalah orang pertama dari dunia luar\Nyang pernah kulihat,
Dialogue: 0,0:09:55.05,0:09:57.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}selain kepala Klan Goko.
Dialogue: 0,0:09:58.68,0:10:01.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku diberi tahu bahwa sekelompok ayakashi\Nkabur ke arah sini
Dialogue: 0,0:10:02.47,0:10:04.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan aku diperintahkan untuk menyelidiki.
Dialogue: 0,0:10:05.73,0:10:08.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau diculik oleh ayakashi\Ndan dibawa ke sini?
Dialogue: 0,0:10:11.36,0:10:14.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak tahu harus bagaimana, tapi…
Dialogue: 0,0:10:16.40,0:10:18.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau terluka?
Dialogue: 0,0:10:22.33,0:10:24.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kau mendapatkan ini?
Dialogue: 0,0:10:27.92,0:10:28.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau baik-baik saja?
Dialogue: 0,0:10:36.38,0:10:38.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Sengoku-Dayu!
Dialogue: 0,0:10:40.05,0:10:41.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hmm…
Dialogue: 0,0:10:41.30,0:10:44.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini monster yang hebat.
Dialogue: 0,0:10:45.43,0:10:47.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Dayu, tentu kau bisa melihat
Dialogue: 0,0:10:47.48,0:10:48.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}gadis ini manusia.
Dialogue: 0,0:10:48.94,0:10:49.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diam!
Dialogue: 0,0:10:50.52,0:10:51.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengarkan aku, Mao.
Dialogue: 0,0:10:51.94,0:10:54.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lupakan semua yang kau lihat di sini.
Dialogue: 0,0:11:00.91,0:11:02.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah itu,
Dialogue: 0,0:11:03.20,0:11:06.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku dibawa ke bawah tanah\Nke tempatku sebelumnya.
Dialogue: 0,0:11:07.58,0:11:09.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bencana.
Dialogue: 0,0:11:10.21,0:11:13.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua roh pelayan melarikan diri.
Dialogue: 0,0:11:17.30,0:11:19.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, seperti yang selalu kulakukan,
Dialogue: 0,0:11:21.39,0:11:24.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku kembali menyerap kutukan setiap hari.
Dialogue: 0,0:11:33.11,0:11:34.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi…
Dialogue: 0,0:11:37.99,0:11:39.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau baik-baik saja?
Dialogue: 0,0:11:40.61,0:11:42.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mao…
Dialogue: 0,0:11:43.87,0:11:45.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mao…
Dialogue: 0,0:11:47.54,0:11:51.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa melupakan wajah\Ndan suara itu.
Dialogue: 0,0:11:56.09,0:11:57.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada akhirnya,
Dialogue: 0,0:11:57.84,0:12:00.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku belajar memerintahkan kutukan\Nyang kuserap
Dialogue: 0,0:12:00.97,0:12:03.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk melihat ke luar.
Dialogue: 0,0:12:07.31,0:12:10.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada orang lain sepertiku\Ndi dunia luar.
Dialogue: 0,0:12:12.64,0:12:14.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berbeda dari orang lain.
Dialogue: 0,0:12:17.44,0:12:18.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau baik-baik saja?
Dialogue: 0,0:12:19.57,0:12:22.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mulai memahami arti kata-katanya.
Dialogue: 0,0:12:23.78,0:12:26.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu kata-kata kebaikan
Dialogue: 0,0:12:27.78,0:12:29.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan suaranya sangat lembut.
Dialogue: 0,0:12:30.87,0:12:32.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mao…
Dialogue: 0,0:12:33.08,0:12:35.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat ingin bertemu dengannya lagi.
Dialogue: 0,0:12:38.42,0:12:40.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seolah-olah doaku didengar,
Dialogue: 0,0:12:40.92,0:12:42.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}beberapa tahun kemudian,
Dialogue: 0,0:12:42.67,0:12:44.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mao datang ke Klan Goko.
Dialogue: 0,0:12:46.80,0:12:50.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku tidak bisa memberitahunya\Ntentang keberadaanku.
Dialogue: 0,0:12:51.77,0:12:53.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, aku sadar.
Dialogue: 0,0:12:55.19,0:12:57.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke mana pun tatapan Mao tertuju…
Dialogue: 0,0:12:58.77,0:13:00.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Haimaru, tunggu.
Dialogue: 0,0:13:05.36,0:13:06.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sana selalu ada di sana.
Dialogue: 0,0:13:17.79,0:13:18.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mao.
Dialogue: 0,0:13:21.38,0:13:23.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku di sini.
Dialogue: 0,0:13:27.80,0:13:28.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu,
Dialogue: 0,0:13:30.39,0:13:32.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena Mao ada di sana,
Dialogue: 0,0:13:33.31,0:13:34.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku bisa terus hidup.
Dialogue: 0,0:13:36.40,0:13:38.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia akhirnya bisa bertemu Mao lagi,
Dialogue: 0,0:13:38.52,0:13:40.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi Mao jatuh cinta dengan Nona Sana.
Dialogue: 0,0:13:41.57,0:13:42.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu terlalu memilukan.
Dialogue: 0,0:13:44.36,0:13:45.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini…
Dialogue: 0,0:13:46.20,0:13:48.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau memberitahuku semua ini?
Dialogue: 0,0:13:53.00,0:13:54.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini.
Dialogue: 0,0:13:54.83,0:13:58.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bersama Shiranui sekarang, tapi…
Dialogue: 0,0:13:59.50,0:14:02.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak punya alasan untuk menyakiti Mao.
Dialogue: 0,0:14:02.96,0:14:05.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin kau tahu itu.
Dialogue: 0,0:14:06.38,0:14:07.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku…
Dialogue: 0,0:14:10.10,0:14:10.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanoka!
Dialogue: 0,0:14:14.68,0:14:15.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mao?
Dialogue: 0,0:14:21.69,0:14:22.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penghalang?
Dialogue: 0,0:14:26.49,0:14:27.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mao di sini, bukan?
Dialogue: 0,0:14:28.70,0:14:30.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia datang mencarimu.
Dialogue: 0,0:14:33.49,0:14:34.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pergilah.
Dialogue: 0,0:14:42.04,0:14:43.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mao.
Dialogue: 0,0:14:43.71,0:14:45.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanoka. Kau baik-baik saja?
Dialogue: 0,0:14:50.55,0:14:51.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yurako?
Dialogue: 0,0:14:52.51,0:14:53.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia hilang.
Dialogue: 0,0:14:54.39,0:14:55.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Energi jahat ini…
Dialogue: 0,0:14:55.89,0:14:56.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanoka!
Dialogue: 0,0:14:57.35,0:14:58.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bersama Yurako.
Dialogue: 0,0:14:59.98,0:15:01.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia melakukan sesuatu kepadamu?
Dialogue: 0,0:15:01.73,0:15:02.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:15:03.27,0:15:05.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia hanya bicara padaku.
Dialogue: 0,0:15:06.19,0:15:07.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo pulang.
Dialogue: 0,0:15:18.62,0:15:19.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kagari?
Dialogue: 0,0:15:20.87,0:15:22.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus mencabut jarumnya.
Dialogue: 0,0:15:28.17,0:15:29.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah membawaku ke sini.
Dialogue: 0,0:15:30.13,0:15:31.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bisa bergerak sekarang.
Dialogue: 0,0:15:32.76,0:15:33.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau akan membayar untuk ini!
Dialogue: 0,0:15:34.18,0:15:35.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lain kali kita bertemu, aku akan…
Dialogue: 0,0:15:35.68,0:15:36.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:15:36.89,0:15:39.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi lain kali kau menggunakan jarum boneka,
Dialogue: 0,0:15:39.94,0:15:40.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lebih berhati-hatilah.
Dialogue: 0,0:15:47.82,0:15:49.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang kau selamat, Nona Nanoka.
Dialogue: 0,0:15:53.37,0:15:55.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mao datang menyelamatkanku.
Dialogue: 0,0:15:56.49,0:15:58.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat bahagia\Nhingga bisa menangis, tapi…
Dialogue: 0,0:16:00.33,0:16:04.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena Mao ada di sana,\Naku bisa terus hidup.
Dialogue: 0,0:16:05.71,0:16:07.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dibandingkan perasaan Yurako terhadap Mao,
Dialogue: 0,0:16:08.26,0:16:09.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}perasaanku bukan apa-apa.
Dialogue: 0,0:16:11.01,0:16:14.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah apa aku boleh tetap di sisi Mao.
Dialogue: 0,0:16:16.60,0:16:18.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa dengan Nanoka?
Dialogue: 0,0:16:26.19,0:16:27.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yurako menghabiskan bertahun-tahun
Dialogue: 0,0:16:29.15,0:16:32.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan menjadi wadah kutukan\Nyang dikirim ke Klan Goko.
Dialogue: 0,0:16:33.53,0:16:35.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mao adalah orang pertama dalam hidupnya
Dialogue: 0,0:16:36.03,0:16:37.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang bicara dengan baik kepadanya.
Dialogue: 0,0:16:38.70,0:16:39.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau baik-baik saja?
Dialogue: 0,0:16:41.12,0:16:44.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sudah mencintai Mao selama 900 tahun.
Dialogue: 0,0:16:46.00,0:16:47.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerinduan berabad-abad
Dialogue: 0,0:16:48.17,0:16:50.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan kedalaman serta beban perasaannya…
Dialogue: 0,0:16:51.84,0:16:53.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa menyaingi itu.
Dialogue: 0,0:16:54.30,0:16:55.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mao dan aku
Dialogue: 0,0:16:56.35,0:16:58.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin dikutuk oleh Byoki itu, tapi…
Dialogue: 0,0:17:01.77,0:17:03.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin aku tidak boleh\Njatuh cinta kepadanya
Dialogue: 0,0:17:04.52,0:17:06.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lebih dari ini.
Dialogue: 0,0:17:14.10,0:17:16.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang kembali, Nona Nanoka.
Dialogue: 0,0:17:17.16,0:17:18.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah. Kita pergi sekarang?
Dialogue: 0,0:17:18.99,0:17:20.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Ke mana?
Dialogue: 0,0:17:24.32,0:17:26.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga?
Dialogue: 0,0:17:26.82,0:17:28.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak yang terjadi
Dialogue: 0,0:17:28.33,0:17:30.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hingga kami belum merayakan aku masuk SMA.
Dialogue: 0,0:17:32.09,0:17:34.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkinkah maksudnya kami pergi sekarang?
Dialogue: 0,0:17:35.09,0:17:36.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:17:36.68,0:17:39.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sedang tidak ingin merayakan sekarang.
Dialogue: 0,0:17:44.10,0:17:45.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keadaan menjadi aneh.
Dialogue: 0,0:17:46.81,0:17:48.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yurako, yang seharusnya menjadi musuh,
Dialogue: 0,0:17:48.56,0:17:50.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tergila-gila kepada Mao.
Dialogue: 0,0:17:51.69,0:17:54.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah… Jadi, itu hanya pertemuan.
Dialogue: 0,0:17:55.40,0:17:57.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana perasaanmu, Mao?
Dialogue: 0,0:17:58.74,0:18:00.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak tahu harus berkata apa.
Dialogue: 0,0:18:01.87,0:18:03.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejujurnya,
Dialogue: 0,0:18:03.50,0:18:05.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku sudah melupakannya\Nsampai Nanoka memberitahuku.
Dialogue: 0,0:18:07.25,0:18:11.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Separuh wajahnya rusak karena energi jahat
Dialogue: 0,0:18:11.55,0:18:15.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan tubuhnya dipenuhi tato mistis.
Dialogue: 0,0:18:15.84,0:18:19.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu dia dipaksa melakukan\Ntugas yang mengerikan.
Dialogue: 0,0:18:21.18,0:18:22.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi
Dialogue: 0,0:18:22.43,0:18:24.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tidak pernah melihatnya lagi\Nsetelah hari itu.
Dialogue: 0,0:18:25.93,0:18:29.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan tak pernah terpikir olehku\Nbahwa dia mungkin Yurako.
Dialogue: 0,0:18:31.15,0:18:32.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sudah melupakannya.
Dialogue: 0,0:18:33.73,0:18:37.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak kasihan kepadanya?
Dialogue: 0,0:18:37.65,0:18:39.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah mendengar yang dia alami,
Dialogue: 0,0:18:39.45,0:18:41.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tentu saja, aku kasihan kepadanya.
Dialogue: 0,0:18:42.62,0:18:43.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, bukan?
Dialogue: 0,0:18:44.79,0:18:46.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu membawa kami kepadamu, Nanoka.
Dialogue: 0,0:18:47.21,0:18:48.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Ya?
Dialogue: 0,0:18:49.46,0:18:51.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang kita sampai ke bagian yang penting.
Dialogue: 0,0:18:52.75,0:18:56.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa wajah Yurako sama dengan Nona Sana?
Dialogue: 0,0:18:58.55,0:18:59.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tidak memberitahuku.
Dialogue: 0,0:18:59.93,0:19:02.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu kenapa dia bersama Shiranui?
Dialogue: 0,0:19:02.60,0:19:03.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:19:03.93,0:19:06.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia juga tidak memberitahuku.
Dialogue: 0,0:19:08.52,0:19:11.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa Yurako repot-repot membawamu ke sana?
Dialogue: 0,0:19:11.15,0:19:13.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa motifnya?
Dialogue: 0,0:19:14.15,0:19:15.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin
Dialogue: 0,0:19:16.03,0:19:19.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia ingin bilang bahwa dia bukan musuh Mao?
Dialogue: 0,0:19:20.28,0:19:23.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanoka, kau yakin hanya bicara?
Dialogue: 0,0:19:24.99,0:19:25.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:19:26.54,0:19:28.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Mao mencemaskanmu.
Dialogue: 0,0:19:29.33,0:19:32.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bilang kau tidak seperti biasanya\Nsejak dibebaskan.
Dialogue: 0,0:19:34.29,0:19:35.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudku…
Dialogue: 0,0:19:36.05,0:19:37.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah mendengar cerita seperti itu,
Dialogue: 0,0:19:38.63,0:19:39.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku hanya…
Dialogue: 0,0:19:41.34,0:19:42.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, Nanoka.
Dialogue: 0,0:19:43.18,0:19:44.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana jika kita berjalan-jalan di taman?
Dialogue: 0,0:19:44.97,0:19:46.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:19:46.35,0:19:47.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamon.
Dialogue: 0,0:19:48.60,0:19:51.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tetap di sini, Mao.\NKau hanya akan menghalangi.
Dialogue: 0,0:19:56.73,0:19:57.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini…
Dialogue: 0,0:20:00.07,0:20:01.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya untuk memastikan.
Dialogue: 0,0:20:02.99,0:20:03.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanoka,
Dialogue: 0,0:20:04.78,0:20:06.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau mencintai Mao, kan?
Dialogue: 0,0:20:07.91,0:20:08.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:20:09.50,0:20:11.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menjijikkan! Ada apa denganmu?
Dialogue: 0,0:20:11.50,0:20:12.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau benar-benar aneh!
Dialogue: 0,0:20:12.88,0:20:15.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan memberi tahu Mao!
Dialogue: 0,0:20:15.96,0:20:17.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, sakit!
Dialogue: 0,0:20:17.21,0:20:18.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan!
Dialogue: 0,0:20:18.80,0:20:20.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudku, Nanoka,
Dialogue: 0,0:20:21.09,0:20:23.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yurako yang mengutukmu.
Dialogue: 0,0:20:23.76,0:20:24.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:20:26.05,0:20:28.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa kisah Yurako tentang masa lalunya\Nbukan kebohongan.
Dialogue: 0,0:20:29.52,0:20:31.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Klan Goko adalah tempat
Dialogue: 0,0:20:31.73,0:20:33.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di mana hal seperti itu\Nbisa terjadi dengan mudah.
Dialogue: 0,0:20:34.98,0:20:38.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kisah itu menggambarkan wanita tragis
Dialogue: 0,0:20:39.07,0:20:41.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang terlepas dari keadaannya yang sulit,
Dialogue: 0,0:20:41.28,0:20:45.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menghabiskan bertahun-tahun\Nmerindukan Mao dan bukan orang lain.
Dialogue: 0,0:20:46.91,0:20:51.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu benar-benar memengaruhimu, bukan?
Dialogue: 0,0:20:53.17,0:20:55.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Tapi
Dialogue: 0,0:20:56.54,0:20:58.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kenapa itu kutukan?
Dialogue: 0,0:20:58.38,0:21:01.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau menghalanginya,\Nkarena kau yang ada di sisi Mao.
Dialogue: 0,0:21:02.17,0:21:05.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi jika dia menyakiti atau membunuhmu,
Dialogue: 0,0:21:05.97,0:21:07.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mao tidak akan pernah memaafkannya.
Dialogue: 0,0:21:08.43,0:21:10.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:21:10.81,0:21:15.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yurako bisa saja membunuhku jika dia mau.
Dialogue: 0,0:21:16.10,0:21:17.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan menceritakan kisahnya,
Dialogue: 0,0:21:17.98,0:21:20.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia menusuk hatimu.
Dialogue: 0,0:21:21.61,0:21:25.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kata-kata itu sendiri\Natau roh di dalam kata-kata
Dialogue: 0,0:21:26.32,0:21:28.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa menjadi kutukan.
Dialogue: 0,0:21:30.58,0:21:32.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kata-kata adalah kutukan?
Dialogue: 0,0:21:34.41,0:21:35.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar sekali.
Dialogue: 0,0:21:35.62,0:21:38.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan mencurahkan perasaanmu ke kata-kata\Ndan menyampaikannya kepada seseorang,
Dialogue: 0,0:21:38.46,0:21:39.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau bisa mengikat hati mereka.
Dialogue: 0,0:21:41.21,0:21:43.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia benar.
Dialogue: 0,0:21:44.34,0:21:45.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini…
Dialogue: 0,0:21:46.09,0:21:48.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, apa yang harus kulakukan?
Dialogue: 0,0:21:49.93,0:21:51.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena sekarang kau tahu cara kerja triknya,
Dialogue: 0,0:21:51.72,0:21:53.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jangan biarkan itu mengganggumu.
Dialogue: 0,0:21:53.31,0:21:54.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Itu saja?
Dialogue: 0,0:21:55.56,0:21:57.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini hanya masalah perspektif, Nanoka.
Dialogue: 0,0:22:06.03,0:22:08.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mencabut kutukannya untuk berjaga-jaga.
Dialogue: 0,0:22:11.58,0:22:12.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanoka.
Dialogue: 0,0:22:14.50,0:22:16.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kau dan Kamon bicarakan?
Dialogue: 0,0:22:18.04,0:22:18.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan apa-apa.
Dialogue: 0,0:22:19.29,0:22:20.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesuatu yang tidak bisa kau katakan?
Dialogue: 0,0:22:22.88,0:22:23.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanoka,
Dialogue: 0,0:22:24.01,0:22:26.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau mencintai Mao, bukan?
Dialogue: 0,0:22:27.22,0:22:28.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin aku bisa memberitahunya!
Dialogue: 0,0:22:29.09,0:22:30.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan ganggu aku!
Dialogue: 0,0:22:30.55,0:22:32.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sesuatu yang harus kuselesaikan sendiri.
Dialogue: 0,0:22:34.02,0:22:37.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak bisa berharap\Naku tidak mencemaskanmu.
Dialogue: 0,0:22:38.10,0:22:38.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:22:39.86,0:22:43.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama kau merasa lebih baik,
Dialogue: 0,0:22:43.15,0:22:44.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hanya itu yang penting bagiku.
Dialogue: 0,0:22:48.20,0:22:49.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa menahannya!\NItu membuatku bahagia.
Dialogue: 0,0:22:50.07,0:22:51.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh…
Dialogue: 0,0:22:51.58,0:22:54.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanoka, aku benar-benar lupa.
Dialogue: 0,0:23:02.29,0:23:05.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kau benar-benar\Nmelupakan perayaan SMA-ku.
Dialogue: 0,0:23:06.13,0:23:07.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku senang kau ingat.
Dialogue: 0,0:23:07.55,0:23:10.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Jadi, bersemangatlah.
Dialogue: 0,0:23:11.43,0:23:12.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari makan!
Dialogue: 0,0:23:15.68,0:23:17.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lezat!
Dialogue: 0,0:23:20.85,0:23:21.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah.
Dialogue: 0,0:23:24.15,0:23:26.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa melupakan perkataan Yurako.
Dialogue: 0,0:23:31.16,0:23:33.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi meski begitu, aku…
Dialogue: 0,0:23:38.16,0:23:41.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Mao, mungkin seharusnya\Nkau memesan mitsumame.
