Dialogue: 0,0:00:20.56,0:00:21.77,sign,,0000,0000,0000,,"KATSURAGI"
Dialogue: 0,0:00:29.02,0:00:31.86,sign,,0000,0000,0000,,"IBU SHOKO"
Dialogue: 0,0:00:34.03,0:00:37.24,sign,,0000,0000,0000,,"KATSURAGI SHOKO"
Dialogue: 0,0:00:38.58,0:00:40.62,sign,,0000,0000,0000,,"MAO, KIBA NANOKA"
Dialogue: 0,0:00:48.09,0:00:50.92,sign,,0000,0000,0000,,DENGAN CEPAT, DENGAN CEPAT,\NSESUAI PERINTAH HUKUM
Dialogue: 0,0:03:02.55,0:03:06.10,sign,,0000,0000,0000,,ROH PENASARAN DAN RAKSHASA
Dialogue: 0,0:04:09.41,0:04:10.75,sign,,0000,0000,0000,,"ERIKO"
Dialogue: 0,0:04:11.08,0:04:12.16,sign,,0000,0000,0000,,HOSHO KAGARI
Dialogue: 0,0:05:48.51,0:05:50.55,sign,,0000,0000,0000,,"OTOYA"
Dialogue: 0,0:06:21.46,0:06:23.80,sign,,0000,0000,0000,,"HAKUBI"
Dialogue: 0,0:15:03.27,0:15:04.32,sign,,0000,0000,0000,,UDON
Dialogue: 0,0:15:12.62,0:15:13.83,sign,,0000,0000,0000,,"HYAKKA"
Dialogue: 0,0:17:16.49,0:17:17.61,sign,,0000,0000,0000,,YURAKO
Dialogue: 0,0:22:43.40,0:22:44.78,sign,,0000,0000,0000,,"YURAKO"
Dialogue: 0,0:22:46.11,0:22:49.18,sign,,0000,0000,0000,,"ROH PENASARAN, RAKSHASA"
Dialogue: 0,0:00:20.56,0:00:21.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekitar lima hari lalu,
Dialogue: 0,0:00:21.98,0:00:24.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}putriku, Shoko, pingsan di sekolah.
Dialogue: 0,0:00:25.19,0:00:28.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dokter bilang\Ntidak ada yang salah dengannya.
Dialogue: 0,0:00:29.02,0:00:31.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi dia belum bangun sama sekali, dan
Dialogue: 0,0:00:31.94,0:00:33.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia menderita seperti ini sejak saat itu.
Dialogue: 0,0:00:34.03,0:00:37.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak! Tolong aku.
Dialogue: 0,0:00:38.58,0:00:40.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya dia kesakitan.
Dialogue: 0,0:00:40.87,0:00:41.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shoko…
Dialogue: 0,0:00:42.70,0:00:45.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tidak kerasukan roh.
Dialogue: 0,0:00:46.33,0:00:47.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini semacam kutukan.
Dialogue: 0,0:01:00.10,0:01:00.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shoko!
Dialogue: 0,0:01:01.81,0:01:02.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bangun?
Dialogue: 0,0:01:02.93,0:01:05.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sakit! Panas!
Dialogue: 0,0:01:05.89,0:01:06.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajahku!
Dialogue: 0,0:01:07.02,0:01:08.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kau…
Dialogue: 0,0:01:08.73,0:01:10.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menunjukkan lokasi
Dialogue: 0,0:01:11.23,0:01:13.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}abu jimat itu berkumpul.
Dialogue: 0,0:01:21.24,0:01:22.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada sesuatu di dahinya.
Dialogue: 0,0:01:29.13,0:01:30.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jarum?
Dialogue: 0,0:03:10.06,0:03:12.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bermimpi buruk selama ini, bukan?
Dialogue: 0,0:03:13.52,0:03:15.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:03:15.65,0:03:18.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam mimpiku, aku dibunuh berulang kali.
Dialogue: 0,0:03:19.49,0:03:22.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tahu bagaimana ini bisa terjadi?
Dialogue: 0,0:03:23.66,0:03:26.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada seorang adik kelas yang aneh.
Dialogue: 0,0:03:27.87,0:03:29.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mengaku bisa mengutuk orang.
Dialogue: 0,0:03:30.50,0:03:33.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika ada seseorang yang kau benci,\Ndia bilang akan mengutuk mereka untukmu.
Dialogue: 0,0:03:35.79,0:03:40.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beberapa adik kelas tertarik\Ndengan hal semacam itu.
Dialogue: 0,0:03:41.01,0:03:44.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka akan berkumpul\Nuntuk melakukan ritual kutukan.
Dialogue: 0,0:03:46.01,0:03:48.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku memperingatkan mereka.
Dialogue: 0,0:03:49.18,0:03:51.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kubilang kutukan itu tidak nyata
Dialogue: 0,0:03:51.60,0:03:54.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan mereka tidak boleh\Nmelakukan hal seperti itu.
Dialogue: 0,0:03:54.94,0:03:56.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia dikutuk\Nhanya karena memperingatkan mereka?
Dialogue: 0,0:03:57.86,0:03:59.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu agak menakutkan.
Dialogue: 0,0:04:00.44,0:04:03.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis ini benar-benar dikutuk.
Dialogue: 0,0:04:04.07,0:04:05.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami tak bisa mengabaikan ini.
Dialogue: 0,0:04:07.87,0:04:08.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hosho.
Dialogue: 0,0:04:09.41,0:04:10.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau punya waktu sebentar?
Dialogue: 0,0:04:12.25,0:04:14.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu. Ada apa?
Dialogue: 0,0:04:19.67,0:04:23.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hosho, apa yang kau lakukan pada Katsuragi?
Dialogue: 0,0:04:23.97,0:04:26.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sudah absen dari sekolah\Nselama lima hari.
Dialogue: 0,0:04:27.18,0:04:30.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katsuragi? Siapa itu?
Dialogue: 0,0:04:30.93,0:04:34.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katsuragi Shoko memperingatkanmu, kan?
Dialogue: 0,0:04:34.94,0:04:37.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia menyuruhmu berhenti\Nmemainkan permainan konyol itu.
Dialogue: 0,0:04:38.44,0:04:39.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:04:40.15,0:04:42.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada yang namanya kutukan.
Dialogue: 0,0:04:43.45,0:04:46.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya, dia tidak mau memercayaiku.
Dialogue: 0,0:04:47.78,0:04:49.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kau mengaku\Ntelah melakukan sesuatu padanya?
Dialogue: 0,0:04:50.37,0:04:51.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis yang menyeramkan.
Dialogue: 0,0:04:54.62,0:04:56.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diam di sini sebentar\Ndan renungkan perbuatanmu.
Dialogue: 0,0:05:03.84,0:05:04.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sulit dipercaya.
Dialogue: 0,0:05:05.43,0:05:07.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka mengunci pintu dari luar.
Dialogue: 0,0:05:08.85,0:05:10.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betapa kekanak-kanakan
Dialogue: 0,0:05:10.43,0:05:11.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan bodohnya mereka.
Dialogue: 0,0:05:16.69,0:05:17.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian berdua…
Dialogue: 0,0:05:18.81,0:05:20.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah mengingat wajah kalian.
Dialogue: 0,0:05:25.28,0:05:28.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya, dua kakak kelas telah dikutuk.
Dialogue: 0,0:05:29.12,0:05:31.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah Hosho mengutuk mereka?
Dialogue: 0,0:05:31.79,0:05:32.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:05:32.79,0:05:37.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seseorang mendengar mereka berkata\Nakan memberi Hochi pelajaran.
Dialogue: 0,0:05:41.42,0:05:42.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga.
Dialogue: 0,0:05:43.67,0:05:44.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanoka.
Dialogue: 0,0:05:45.01,0:05:47.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cara tercepat adalah kau menyelidikinya.
Dialogue: 0,0:05:48.51,0:05:50.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putri Nyonya Katsuragi terlalu takut
Dialogue: 0,0:05:50.76,0:05:52.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk kembali ke sekolah setelah dikutuk.
Dialogue: 0,0:05:53.39,0:05:55.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami bisa meminjam seragam untukmu.
Dialogue: 0,0:05:56.39,0:05:58.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah selesai,\Naku akan mentraktirmu mitsumame.
Dialogue: 0,0:05:59.44,0:06:00.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei!
Dialogue: 0,0:06:00.40,0:06:03.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tak berencana menggabungkan itu\Ndengan perayaan SMA-ku, kan?
Dialogue: 0,0:06:04.40,0:06:06.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku langsung kemari\Nsepulang sekolah hari ini.
Dialogue: 0,0:06:09.24,0:06:10.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka semua terlihat
Dialogue: 0,0:06:11.33,0:06:13.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}agak gelisah.
Dialogue: 0,0:06:18.79,0:06:20.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Gadis itu…
Dialogue: 0,0:06:21.46,0:06:23.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin dia yang bersama Hakubi.
Dialogue: 0,0:06:25.46,0:06:28.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Mao, apa Nona Nanoka\Nakan baik-baik saja sendirian?
Dialogue: 0,0:06:29.47,0:06:32.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang dia hanya mengamati\Ndan jangan terlalu terlibat.
Dialogue: 0,0:06:34.47,0:06:35.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis itu…
Dialogue: 0,0:06:37.14,0:06:39.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia menggunakan jarum untuk mengubah Mao\Nmenjadi Byoki dan mengendalikannya.
Dialogue: 0,0:06:40.40,0:06:42.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia melakukannya atas perintah Hakubi.
Dialogue: 0,0:06:44.61,0:06:48.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kini, dia menggunakan jarum itu\Nuntuk mengutuk murid di sekolah ini.
Dialogue: 0,0:06:49.91,0:06:50.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kenapa?
Dialogue: 0,0:06:52.07,0:06:53.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kasihan kepada Eriko.
Dialogue: 0,0:06:54.37,0:06:57.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hosho Kagari benar-benar mengincarnya.
Dialogue: 0,0:06:59.00,0:07:00.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kagari?
Dialogue: 0,0:07:00.87,0:07:03.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya kedua kakak kelas itu\Nmeminta Eriko
Dialogue: 0,0:07:03.79,0:07:06.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk membawa Kagari.
Dialogue: 0,0:07:07.59,0:07:12.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi Kagari membalas dan mengutuk mereka.
Dialogue: 0,0:07:12.97,0:07:17.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang dia memaksa Eriko\Nmenjadi temannya, kan?
Dialogue: 0,0:07:19.14,0:07:20.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eriko.
Dialogue: 0,0:07:21.19,0:07:23.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu gadis berkepang\Nyang berjalan bersamanya?
Dialogue: 0,0:07:24.73,0:07:27.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kenapa Eriko setuju\Nmembawa Hosho ke mereka?
Dialogue: 0,0:07:28.15,0:07:29.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini.
Dialogue: 0,0:07:29.61,0:07:32.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ingat Katsuragi Shoko\Nyang dikutuk belum lama ini?
Dialogue: 0,0:07:33.37,0:07:34.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katsuragi Shoko.
Dialogue: 0,0:07:36.29,0:07:38.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia gadis yang dibebaskan Mao dari kutukan.
Dialogue: 0,0:07:39.58,0:07:42.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eriko ingin membalas dendam untuk Shoko.
Dialogue: 0,0:07:43.67,0:07:45.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, mereka berdua adalah "S".
Dialogue: 0,0:07:46.75,0:07:48.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi. Apa itu "S"?
Dialogue: 0,0:07:48.96,0:07:51.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf. Aku mendengar obrolan kalian.
Dialogue: 0,0:07:53.39,0:07:54.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tak tahu apa itu "S"?
Dialogue: 0,0:07:55.22,0:07:56.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua orang tahu itu.
Dialogue: 0,0:07:56.22,0:07:57.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya aku agak tertinggal.
Dialogue: 0,0:07:58.22,0:08:00.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu artinya persahabatan\Nyang sangat istimewa dan sakral.
Dialogue: 0,0:08:01.31,0:08:04.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dua gadis diam-diam berjanji\Nsebagai saudari.
Dialogue: 0,0:08:05.23,0:08:06.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka bertukar surat,
Dialogue: 0,0:08:07.11,0:08:09.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}diam-diam membawa\Nkenang-kenangan kecil yang sama,
Dialogue: 0,0:08:09.65,0:08:11.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan memperdalam persahabatan mereka.
Dialogue: 0,0:08:12.86,0:08:13.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh…
Dialogue: 0,0:08:15.41,0:08:16.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi,
Dialogue: 0,0:08:16.53,0:08:19.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}teman Eriko, Shoko, dikutuk,
Dialogue: 0,0:08:20.25,0:08:22.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi usahanya untuk membalas dendam gagal,
Dialogue: 0,0:08:23.37,0:08:26.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan Kagari malah mulai mengikutinya.
Dialogue: 0,0:08:26.38,0:08:27.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sebabnya dia sangat ketakutan.
Dialogue: 0,0:08:28.88,0:08:30.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eriko, aku selalu
Dialogue: 0,0:08:31.34,0:08:35.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menganggapmu sangat manis.
Dialogue: 0,0:08:36.35,0:08:39.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, bagaimana jika kita\Nmenjadi teman sungguhan?
Dialogue: 0,0:08:44.77,0:08:46.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau hanya bisa menangis.\NMembosankan sekali.
Dialogue: 0,0:08:48.15,0:08:49.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lupakan saja.
Dialogue: 0,0:08:50.98,0:08:53.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi aku ingin menyelamatkanmu dari kutukan.
Dialogue: 0,0:08:57.41,0:08:58.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan!
Dialogue: 0,0:09:01.87,0:09:02.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau…
Dialogue: 0,0:09:03.62,0:09:04.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanoka…
Dialogue: 0,0:09:05.58,0:09:06.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau Nanoka, kan?
Dialogue: 0,0:09:07.17,0:09:09.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mengingatku.
Dialogue: 0,0:09:10.13,0:09:11.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau di sekolah ini?
Dialogue: 0,0:09:12.51,0:09:14.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah kau ayakashi?
Dialogue: 0,0:09:16.13,0:09:17.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau
Dialogue: 0,0:09:18.43,0:09:20.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}melakukan hal ini?
Dialogue: 0,0:09:21.60,0:09:24.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena Hakubi yang menyuruhmu?
Dialogue: 0,0:09:26.69,0:09:27.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau menghalangi.
Dialogue: 0,0:09:28.19,0:09:29.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pergilah.
Dialogue: 0,0:09:37.28,0:09:38.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kau lakukan?
Dialogue: 0,0:09:40.12,0:09:41.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakiku tak bisa bergerak!
Dialogue: 0,0:09:42.83,0:09:44.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah menjepit bayanganmu.
Dialogue: 0,0:09:44.87,0:09:46.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak bisa bergerak sekarang.
Dialogue: 0,0:09:50.46,0:09:51.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asal kau tahu saja.
Dialogue: 0,0:09:52.05,0:09:54.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Hakubi tak tahu\Napa yang kulakukan di sekolah.
Dialogue: 0,0:09:55.42,0:09:56.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu kenapa?
Dialogue: 0,0:09:57.26,0:10:00.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika aku harus memberi alasan,\Nini latihan untuk bisnis keluarga.
Dialogue: 0,0:10:01.26,0:10:02.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Latihan?
Dialogue: 0,0:10:03.02,0:10:06.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keluargaku, keluarga Hosho,\Nadalah ahli kutukan.
Dialogue: 0,0:10:07.19,0:10:11.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Leluhur kami menggunakan\Npusaka keluarga kami, jarum boneka,
Dialogue: 0,0:10:11.98,0:10:15.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk mengembangkan\Nsegala macam kutukan berbasis jarum.
Dialogue: 0,0:10:16.95,0:10:20.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suatu hari, ayahku dipanggil oleh militer
Dialogue: 0,0:10:20.24,0:10:21.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan pulang dengan wajah pucat.
Dialogue: 0,0:10:23.24,0:10:26.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus mengembalikan jarum bonekanya.
Dialogue: 0,0:10:27.54,0:10:31.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jarum boneka itu awalnya\Nmilik keluarga bernama Klan Goko.
Dialogue: 0,0:10:31.75,0:10:35.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Leluhur kami "meminjamnya" dari mereka.
Dialogue: 0,0:10:36.51,0:10:39.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, itu sebabnya\Nkau bersama Hakubi saat itu,
Dialogue: 0,0:10:40.01,0:10:42.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena dia tidak bisa\Nmenggunakan jarum boneka tanpamu.
Dialogue: 0,0:10:43.81,0:10:45.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya! Benar sekali!
Dialogue: 0,0:10:46.10,0:10:47.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang kau mengerti!
Dialogue: 0,0:10:47.94,0:10:50.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini alat kutukan yang diwariskan\Ndi keluarga Hosho,
Dialogue: 0,0:10:50.77,0:10:52.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi banyak yang harus kuajarkan kepadanya.
Dialogue: 0,0:10:53.86,0:10:57.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku membantu Tuan Hakubi\Nsebagai perwakilan keluargaku.
Dialogue: 0,0:11:00.61,0:11:01.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seseorang, tolong…
Dialogue: 0,0:11:02.32,0:11:03.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Mao.
Dialogue: 0,0:11:04.12,0:11:04.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis itu.
Dialogue: 0,0:11:12.13,0:11:13.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada jarum di dalam tubuhmu.
Dialogue: 0,0:11:13.75,0:11:14.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:11:21.72,0:11:22.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah keluar.
Dialogue: 0,0:11:23.60,0:11:24.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau akan baik-baik saja sekarang.
Dialogue: 0,0:11:25.60,0:11:30.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini… Gadis yang menolongku… Nanoka…
Dialogue: 0,0:11:31.10,0:11:32.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia masih bersama Kagari!
Dialogue: 0,0:11:33.36,0:11:34.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanoka?
Dialogue: 0,0:11:36.19,0:11:37.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanpa bantuan gadis ini,
Dialogue: 0,0:11:39.03,0:11:41.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hakubi tidak bisa menggunakan jarum boneka.
Dialogue: 0,0:11:42.74,0:11:43.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengar, Nanoka.
Dialogue: 0,0:11:44.41,0:11:45.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau di sana hanya untuk mengamati.
Dialogue: 0,0:11:46.37,0:11:47.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan terlalu terlibat.
Dialogue: 0,0:11:48.29,0:11:49.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bawa ini bersamamu.
Dialogue: 0,0:11:52.67,0:11:54.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Liontin?
Dialogue: 0,0:11:54.88,0:11:55.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini jimat pelindung.
Dialogue: 0,0:11:56.38,0:11:58.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di dalamnya\Nada abu dari jimat pembalik kutukan.
Dialogue: 0,0:12:02.76,0:12:03.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pembalik kutukan.
Dialogue: 0,0:12:11.44,0:12:12.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa bergerak!
Dialogue: 0,0:12:14.15,0:12:15.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau nakal, ya?
Dialogue: 0,0:12:21.95,0:12:23.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buku yang dipegang Kagari…
Dialogue: 0,0:12:25.82,0:12:27.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sanalah dia menyembunyikan jarumnya.
Dialogue: 0,0:12:35.75,0:12:36.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kuambil jarum itu!
Dialogue: 0,0:12:37.29,0:12:38.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia menghindarinya?
Dialogue: 0,0:12:43.09,0:12:43.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia melepaskannya!
Dialogue: 0,0:12:53.27,0:12:54.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanoka!
Dialogue: 0,0:12:55.31,0:12:56.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanoka!
Dialogue: 0,0:12:59.73,0:13:00.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jarum.
Dialogue: 0,0:13:01.40,0:13:02.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanoka!
Dialogue: 0,0:13:03.40,0:13:04.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini
Dialogue: 0,0:13:05.32,0:13:06.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jarum jahit?
Dialogue: 0,0:13:11.70,0:13:12.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau baik-baik saja?
Dialogue: 0,0:13:12.91,0:13:14.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak bisa bernapas…
Dialogue: 0,0:13:15.79,0:13:16.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di mana Kagari?
Dialogue: 0,0:13:18.46,0:13:19.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia kabur?
Dialogue: 0,0:13:19.96,0:13:20.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kagari?
Dialogue: 0,0:13:21.42,0:13:23.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jarum boneka yang digunakan\Nuntuk mengendalikanmu…
Dialogue: 0,0:13:25.01,0:13:28.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang membantu Hakubi menggunakannya
Dialogue: 0,0:13:28.89,0:13:30.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah Kagari.
Dialogue: 0,0:13:32.18,0:13:34.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak menyangka dia sangat berbahaya.
Dialogue: 0,0:13:35.44,0:13:37.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku, Nanoka.
Dialogue: 0,0:13:38.06,0:13:40.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah terbiasa, jadi…
Dialogue: 0,0:13:41.73,0:13:44.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi dia tampak sangat mengkhawatirkanku,
Dialogue: 0,0:13:44.90,0:13:45.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi aku akan memaafkannya.
Dialogue: 0,0:13:50.03,0:13:51.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tahan saja.
Dialogue: 0,0:13:51.37,0:13:53.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu abu dari jimat pembalik kutukan.
Dialogue: 0,0:13:54.12,0:13:56.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tidak bisa mengambil risiko ada jarum\Nyang tersisa di dalam tubuhmu.
Dialogue: 0,0:13:56.79,0:13:59.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini terasa seperti hukuman!
Dialogue: 0,0:14:01.09,0:14:02.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa di sini sakit?
Dialogue: 0,0:14:02.67,0:14:04.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Oh…
Dialogue: 0,0:14:04.80,0:14:06.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempat jarum jahitnya?
Dialogue: 0,0:14:06.76,0:14:08.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa tidak sakit.
Dialogue: 0,0:14:09.64,0:14:10.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah.
Dialogue: 0,0:14:11.68,0:14:14.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau harus kembali ke waktumu\Ndan beristirahat beberapa hari.
Dialogue: 0,0:14:21.48,0:14:26.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi bukankah buruk\Nmeninggalkan Kagari seperti ini?
Dialogue: 0,0:14:28.45,0:14:30.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama jarum boneka itu ada,
Dialogue: 0,0:14:30.99,0:14:33.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}entah kapan Mao akan diincar lagi.
Dialogue: 0,0:14:37.62,0:14:38.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hosho Kagari?
Dialogue: 0,0:14:39.67,0:14:42.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Bisakah kau memanggilnya?
Dialogue: 0,0:14:42.96,0:14:46.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga, anak yang manis!\NKau sedang mengantar?
Dialogue: 0,0:14:46.67,0:14:47.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:14:47.59,0:14:49.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi itu aneh.
Dialogue: 0,0:14:49.76,0:14:52.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hosho berhenti dari sekolah ini.
Dialogue: 0,0:14:53.56,0:14:56.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin karena permainan kutukannya.
Dialogue: 0,0:14:57.06,0:14:59.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia agak menakutkan.
Dialogue: 0,0:14:59.85,0:15:02.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar sekali!\NSejujurnya, aku lega dia sudah pergi.
Dialogue: 0,0:15:04.40,0:15:07.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, gadis yang bersama Hakubi…
Dialogue: 0,0:15:07.95,0:15:09.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi dari yang kudengar,
Dialogue: 0,0:15:09.95,0:15:11.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}insiden ini tidak ada hubungannya\Ndengan Hakubi.
Dialogue: 0,0:15:12.62,0:15:13.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hmm…
Dialogue: 0,0:15:14.37,0:15:16.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hyakka, bagaimana lenganmu?
Dialogue: 0,0:15:17.75,0:15:19.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah sembuh!
Dialogue: 0,0:15:20.17,0:15:21.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat?
Dialogue: 0,0:15:23.67,0:15:24.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah.
Dialogue: 0,0:15:24.67,0:15:26.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beri tahu aku jika terjadi sesuatu, ya?
Dialogue: 0,0:15:28.97,0:15:31.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya. Jadi, dia bersembunyi?
Dialogue: 0,0:15:32.64,0:15:33.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Mao.
Dialogue: 0,0:15:33.80,0:15:35.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurut Nona Nanoka,
Dialogue: 0,0:15:35.56,0:15:38.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kagari adalah putri ahli kutukan.
Dialogue: 0,0:15:39.48,0:15:40.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:15:43.02,0:15:44.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu meresahkanku.
Dialogue: 0,0:15:45.19,0:15:46.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa cahaya berkilau
Dialogue: 0,0:15:46.65,0:15:48.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang kulihat di langit sejak hari itu?
Dialogue: 0,0:15:52.91,0:15:53.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang mereka berkumpul?
Dialogue: 0,0:15:56.29,0:15:57.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka menuju…
Dialogue: 0,0:16:01.25,0:16:02.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang terjadi?
Dialogue: 0,0:16:02.92,0:16:06.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak aku datang ke sini,\Nleherku terasa panas.
Dialogue: 0,0:16:07.55,0:16:10.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sinilah jarum Kagari menusukku.
Dialogue: 0,0:16:18.93,0:16:20.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya aku menemukanmu.
Dialogue: 0,0:16:22.48,0:16:23.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanoka.
Dialogue: 0,0:16:25.06,0:16:25.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kagari!
Dialogue: 0,0:16:26.82,0:16:28.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari mana saja kau?
Dialogue: 0,0:16:28.94,0:16:31.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengirim jarum ke seluruh langit\Nuntuk mencarimu.
Dialogue: 0,0:16:32.65,0:16:35.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tubuhku… Aku tak bisa mengendalikannya.
Dialogue: 0,0:16:36.03,0:16:38.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanoka, karenamu,
Dialogue: 0,0:16:38.33,0:16:41.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku harus meninggalkan sekolah itu.
Dialogue: 0,0:16:42.71,0:16:45.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya aku akan merindukan tempat itu.
Dialogue: 0,0:16:46.79,0:16:50.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi saat berkonsultasi dengan seseorang\Ntentang yang harus kulakukan selanjutnya,
Dialogue: 0,0:16:51.05,0:16:53.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mereka bilang mereka harus bertemu denganmu.
Dialogue: 0,0:16:56.55,0:16:57.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seseorang?
Dialogue: 0,0:17:05.69,0:17:06.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di mana aku?
Dialogue: 0,0:17:10.44,0:17:12.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku membawa Nanoka.
Dialogue: 0,0:17:12.56,0:17:14.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Kagari.
Dialogue: 0,0:17:17.70,0:17:20.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, tidak salah lagi.
Dialogue: 0,0:17:20.70,0:17:23.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau yang bersama Mao, kan?
Dialogue: 0,0:17:25.17,0:17:26.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yurako?
Dialogue: 0,0:17:31.80,0:17:33.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin berbicara dengan Nanoka.
Dialogue: 0,0:17:34.55,0:17:36.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cabut jarumnya, Kagari.
Dialogue: 0,0:17:37.80,0:17:39.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, Nona Yurako.
Dialogue: 0,0:17:43.60,0:17:44.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa bergerak sekarang.
Dialogue: 0,0:17:45.31,0:17:46.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:17:46.85,0:17:49.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bisa pergi sekarang, Kagari.
Dialogue: 0,0:17:49.82,0:17:52.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, permisi.
Dialogue: 0,0:18:01.74,0:18:03.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi… Nanoka…
Dialogue: 0,0:18:07.17,0:18:10.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau selalu bersama Mao, kan?
Dialogue: 0,0:18:12.71,0:18:14.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak selalu.
Dialogue: 0,0:18:16.43,0:18:20.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa Mao pernah membicarakanku?
Dialogue: 0,0:18:22.31,0:18:24.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa dia menganggapku sebagai musuhnya?
Dialogue: 0,0:18:25.64,0:18:28.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah kau memang musuhnya?
Dialogue: 0,0:18:29.73,0:18:32.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa lagi kau bersama Shiranui,\Nsaat dia mengincar Mao?
Dialogue: 0,0:18:33.40,0:18:34.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:18:35.15,0:18:37.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shiranui memang membenci Mao.
Dialogue: 0,0:18:38.03,0:18:40.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin, pada akhirnya,\Ndia berniat membunuhnya.
Dialogue: 0,0:18:42.08,0:18:44.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku berbeda.
Dialogue: 0,0:18:48.83,0:18:50.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah lama aku ingin bertemu dengannya.
Dialogue: 0,0:18:52.04,0:18:54.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak dia menghilang dari Klan Goko.
Dialogue: 0,0:18:56.09,0:18:57.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Klan Goko?
Dialogue: 0,0:18:58.30,0:19:01.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sembilan ratus tahun itu sangat lama.
Dialogue: 0,0:19:02.18,0:19:03.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi akhirnya aku bisa\Nbertemu dengannya lagi.
Dialogue: 0,0:19:05.60,0:19:06.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, apa itu berarti
Dialogue: 0,0:19:07.06,0:19:09.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yurako sudah hidup sejak era Heian?
Dialogue: 0,0:19:11.19,0:19:13.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa kau?
Dialogue: 0,0:19:17.99,0:19:20.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bukan Nona Sana, bukan?
Dialogue: 0,0:19:22.32,0:19:25.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar Nona Sana tewas saat energi jahat
Dialogue: 0,0:19:25.66,0:19:27.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mencabut jantungnya.
Dialogue: 0,0:19:28.04,0:19:29.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mao penasaran siapa kau sebenarnya
Dialogue: 0,0:19:29.96,0:19:35.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan kenapa wajahmu sama dengan Nona Sana.
Dialogue: 0,0:19:36.71,0:19:37.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia penasaran tentangku.
Dialogue: 0,0:19:39.26,0:19:40.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:19:40.80,0:19:42.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rupanya dia tak membenciku.
Dialogue: 0,0:19:44.22,0:19:46.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tidak mau menjawab pertanyaanku.
Dialogue: 0,0:19:47.93,0:19:49.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi wanita ini…
Dialogue: 0,0:19:50.27,0:19:51.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mencintai Mao
Dialogue: 0,0:19:52.48,0:19:53.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}selama ini.
Dialogue: 0,0:19:59.44,0:20:01.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hampir tidak bisa bernapas di sana.
Dialogue: 0,0:20:03.12,0:20:04.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Yurako memang aneh.
Dialogue: 0,0:20:05.99,0:20:08.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tinggal di basemen tanpa satu jendela pun.
Dialogue: 0,0:20:14.25,0:20:15.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mao?
Dialogue: 0,0:20:16.80,0:20:18.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanoka di sini, bukan?
Dialogue: 0,0:20:19.63,0:20:20.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kau tahu?
Dialogue: 0,0:20:21.22,0:20:23.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jarum jahit yang kau tancapkan\Nke leher Nanoka.
Dialogue: 0,0:20:24.51,0:20:26.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jarum itu sendiri tidak berbahaya.
Dialogue: 0,0:20:28.10,0:20:33.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi setelah itu,\Nbanyak cahaya mulai terbang di langit
Dialogue: 0,0:20:34.65,0:20:36.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}seolah-olah mencari sesuatu.
Dialogue: 0,0:20:37.98,0:20:38.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu hari ini,
Dialogue: 0,0:20:39.44,0:20:42.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mereka bergabung\Ndan turun menuju lokasi tertentu.
Dialogue: 0,0:20:43.95,0:20:47.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cahaya yang tidak bergabung\Nmalah terbang ke sini.
Dialogue: 0,0:20:48.58,0:20:50.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu jarum yang kau lepaskan
Dialogue: 0,0:20:50.70,0:20:52.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk menemukan Nanoka\Ndan membawanya pergi, bukan?
Dialogue: 0,0:20:54.00,0:20:56.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga. Kau bisa melihatnya?
Dialogue: 0,0:20:56.79,0:21:00.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau menandainya lebih dahulu,\Nlalu mengendalikan jarumnya setelah itu.
Dialogue: 0,0:21:01.34,0:21:03.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar kau putri keluarga ahli kutukan.
Dialogue: 0,0:21:04.01,0:21:05.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu pertunjukan keterampilan\Nyang mengesankan.
Dialogue: 0,0:21:08.47,0:21:12.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi meninggalkan jejak sejelas itu
Dialogue: 0,0:21:12.73,0:21:14.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}agak ceroboh.
Dialogue: 0,0:21:15.23,0:21:18.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan memujimu\Nkarena menemukanku di sini.
Dialogue: 0,0:21:19.61,0:21:21.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi apa kau sudah lupa?
Dialogue: 0,0:21:22.15,0:21:26.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana jarumku mengendalikanmu\Ndan mengekspos bentuk buasmu itu?
Dialogue: 0,0:21:27.66,0:21:29.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Haruskah aku mengubahmu menjadi\Nbinatang buas sekali lagi?
Dialogue: 0,0:21:35.58,0:21:36.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia memantulkannya kembali kepadaku?
Dialogue: 0,0:21:38.00,0:21:40.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang.\NKau meninggalkan terlalu banyak jejak.
Dialogue: 0,0:21:42.42,0:21:45.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga memeriksa jarum\Nyang kau tinggalkan.
Dialogue: 0,0:21:47.01,0:21:47.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak bisa bergerak…
Dialogue: 0,0:21:48.93,0:21:52.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dibandingkan alat kutukan Klan Goko,\Njarum boneka…
Dialogue: 0,0:21:53.27,0:21:56.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kutukanmu sangat mentah\Nhingga aku pun bisa membalikkannya.
Dialogue: 0,0:21:57.02,0:21:59.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mentah? Beraninya kau!
Dialogue: 0,0:22:00.11,0:22:03.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang, bagaimana jika kau\Nmembawaku ke Nanoka?
Dialogue: 0,0:22:04.95,0:22:06.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan pernah…
Dialogue: 0,0:22:10.37,0:22:12.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tubuhku bergerak sendiri!
Dialogue: 0,0:22:18.17,0:22:20.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tahu, Nanoka…
Dialogue: 0,0:22:21.17,0:22:24.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menatap Mao\Nselama kami berada di Klan Goko.
Dialogue: 0,0:22:25.42,0:22:26.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kau mencintainya?
Dialogue: 0,0:22:28.09,0:22:30.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Sangat.
Dialogue: 0,0:22:31.72,0:22:34.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga. Wanita ini bukan Nona Sana.
Dialogue: 0,0:22:35.39,0:22:39.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, Nona Sana jatuh cinta\Ndengan murid senior Mao, Daigo.
Dialogue: 0,0:22:41.32,0:22:42.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namaku
Dialogue: 0,0:22:43.40,0:22:44.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yurako,
Dialogue: 0,0:22:46.11,0:22:49.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah kombinasi "roh penasaran" dan "Rakshasa".
Dialogue: 0,0:22:49.99,0:22:51.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa semacam itu.
Dialogue: 0,0:22:52.62,0:22:53.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Yurako".
Dialogue: 0,0:22:54.33,0:22:55.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namaku seperti kutukan.
Dialogue: 0,0:22:56.75,0:23:00.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guru Klan Goko yang menamaiku.
Dialogue: 0,0:23:01.71,0:23:04.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gurunya Mao yang memberikannya kepadamu?
Dialogue: 0,0:23:05.30,0:23:08.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mao hanya menyukai Sana.
Dialogue: 0,0:23:09.64,0:23:11.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa Mao mengkhawatirkanku
Dialogue: 0,0:23:12.85,0:23:14.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena wajah ini?
Dialogue: 0,0:23:15.02,0:23:17.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa begitu.
Dialogue: 0,0:23:18.52,0:23:20.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa wajahmu sama dengan Nona Sana?
Dialogue: 0,0:23:20.44,0:23:21.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini
Dialogue: 0,0:23:22.61,0:23:23.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}wajahku!
Dialogue: 0,0:23:26.82,0:23:28.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bukan Sana.
Dialogue: 0,0:23:29.11,0:23:31.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Yurako.
Dialogue: 0,0:25:14.51,0:25:17.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya, "Dunia Yurako".
