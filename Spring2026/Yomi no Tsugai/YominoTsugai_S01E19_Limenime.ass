Dialogue: 0,0:23:27.61,0:23:28.98,sign,,0000,0000,0000,,EPISODE SELANJUTNYA
Dialogue: 0,0:01:32.50,0:01:37.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Untuk Yuru, kami menyandera\Nadik palsumu dan anak dari desa.{\i0}
Dialogue: 0,0:01:37.38,0:01:40.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Datanglah ke gudang\NFujimurayama nomor satu{\i0}
Dialogue: 0,0:01:40.30,0:01:43.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}di purnama\Nselanjutnya pada jam babi hutan.{\i0}
Dialogue: 0,0:01:50.40,0:01:53.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia datang dari mana?{\i0}
Dialogue: 0,0:01:54.53,0:01:57.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dera! Tembak dia!
Dialogue: 0,0:02:09.54,0:02:10.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yuru!
Dialogue: 0,0:02:18.55,0:02:22.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal tidak perlu ada yang mati\Nkalau Yuru datang sendirian.
Dialogue: 0,0:02:25.52,0:02:30.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah pelakunya kamu\Natau pemilik terdahulu Tsugai itu.
Dialogue: 0,0:02:31.40,0:02:35.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Intinya darah Mine dan Nagisa\Ntercium dari situ.
Dialogue: 0,0:02:43.83,0:02:46.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dera, carilah Yuru.{\i0}
Dialogue: 0,0:02:46.29,0:02:49.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mereka akan kami tangkap hidup-hidup.{\i0}
Dialogue: 0,0:02:49.91,0:02:51.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sebagai hadiah buat Yuru.{\i0}
Dialogue: 0,0:03:06.68,0:03:07.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:03:11.52,0:03:12.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sinyal asap.
Dialogue: 0,0:03:14.81,0:03:16.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Danji butuh bantuan.
Dialogue: 0,0:03:18.36,0:03:20.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja, Azami.
Dialogue: 0,0:03:22.11,0:03:24.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita pasti diselamatkan.
Dialogue: 0,0:03:24.16,0:03:26.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}- Sama siapa?\N- Kakakku.
Dialogue: 0,0:03:32.17,0:03:34.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kakak!\N- Kak Yuru!
Dialogue: 0,0:03:35.79,0:03:38.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kira Kakak yang mengirimnya.
Dialogue: 0,0:03:49.18,0:03:51.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Itu Asa!\N- Tangkap dia!
Dialogue: 0,0:04:04.70,0:04:05.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ambil, ya.
Dialogue: 0,0:04:06.95,0:04:11.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Bukannya Asa lemah kalau malam hari?
Dialogue: 0,0:04:11.25,0:04:12.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lemah apanya coba?
Dialogue: 0,0:04:13.16,0:04:15.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inilah kekuatan Kai!
Dialogue: 0,0:04:18.38,0:04:19.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yin-Yang.
Dialogue: 0,0:04:20.67,0:04:21.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tangkap mereka.
Dialogue: 0,0:04:37.06,0:04:38.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei.
Dialogue: 0,0:04:40.86,0:04:42.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Ini di mana?
Dialogue: 0,0:04:42.28,0:04:45.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sanderanya cuma anak itu? Cuma satu?
Dialogue: 0,0:04:46.41,0:04:48.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang disandera cuma Azami.
Dialogue: 0,0:04:49.37,0:04:51.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Azami tidak tahu apa-apa!
Dialogue: 0,0:04:51.41,0:04:53.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tidak berdosa!
Dialogue: 0,0:04:53.16,0:04:55.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan menyakitinya!
Dialogue: 0,0:04:58.71,0:05:03.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak sekali yang ingin aku bahas!\NSangat banyak! Tapi…
Dialogue: 0,0:05:04.17,0:05:06.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu dulu di sini.
Dialogue: 0,0:05:06.47,0:05:08.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian akan kulepaskan\Nkalau misinya selesai.
Dialogue: 0,0:05:10.05,0:05:13.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jelaskan kebenarannya pada kakakku nanti!
Dialogue: 0,0:05:13.68,0:05:16.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan ada yang ditutup-tutupi!
Dialogue: 0,0:05:19.27,0:05:21.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yin-Yang, keluarkan aku.
Dialogue: 0,0:05:24.11,0:05:27.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mohon, jangan berbohong pada Kakak.
Dialogue: 0,0:05:39.67,0:05:42.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lari!
Dialogue: 0,0:05:42.42,0:05:44.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil kita menang!
Dialogue: 0,0:05:59.94,0:06:01.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada gadis itu!
Dialogue: 0,0:06:01.40,0:06:02.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tsugai-ku!
Dialogue: 0,0:06:02.82,0:06:05.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma orang biasa!
Dialogue: 0,0:06:08.61,0:06:13.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oedo Transport.\NSesuai dengan infonya Gagak Mini.
Dialogue: 0,0:06:13.70,0:06:16.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti sanderanya di sini.
Dialogue: 0,0:06:16.45,0:06:18.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok gaduh sekali?
Dialogue: 0,0:06:18.00,0:06:20.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Iya, Asa yang asli datang kemari.
Dialogue: 0,0:06:31.34,0:06:33.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata kamu datang!
Dialogue: 0,0:06:33.81,0:06:35.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}He-Hentikan!
Dialogue: 0,0:06:35.31,0:06:39.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku tidak datang buat menolongmu!
Dialogue: 0,0:06:40.10,0:06:41.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Hei, sudahlah!\N- Lo?
Dialogue: 0,0:06:41.90,0:06:45.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Dua orang berjas dan seekor anjing.\N- Ada kamu berarti ada Asa palsu!
Dialogue: 0,0:06:45.40,0:06:48.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Oh, kalian alien yang diceritakan Ken?\N- Ada Asa palsu berarti ada anak dari desa!
Dialogue: 0,0:06:48.61,0:06:49.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kami Tsugai.\N- Aku cuma mau menolong anak itu!
Dialogue: 0,0:06:49.65,0:06:51.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Salam kenal.\N- Aku cuma mau menolong anak itu!
Dialogue: 0,0:06:51.07,0:06:54.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti dia Danji, ya.
Dialogue: 0,0:06:54.08,0:06:56.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata ini wujud aslinya.
Dialogue: 0,0:06:56.08,0:07:00.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Petunjuk Ibu dan Ayah sedang diurus\NPenjaga Ilahi Sayuu!
Dialogue: 0,0:07:00.37,0:07:03.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma kemari\Nkarena percaya pada mereka!
Dialogue: 0,0:07:03.50,0:07:06.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak punya pilihan lain!
Dialogue: 0,0:07:06.09,0:07:07.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan mau menolongmu!
Dialogue: 0,0:07:07.84,0:07:09.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan tertawa, Dera!
Dialogue: 0,0:07:11.34,0:07:13.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ampun!
Dialogue: 0,0:07:14.05,0:07:15.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya ampun.
Dialogue: 0,0:07:15.30,0:07:18.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sia-sia aku datang kalau sudah ada Asa.
Dialogue: 0,0:07:24.15,0:07:26.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang di wisma aman?
Dialogue: 0,0:07:26.69,0:07:29.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya aman.
Dialogue: 0,0:07:29.15,0:07:32.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial, aku baru tahu Kai juga datang.
Dialogue: 0,0:07:33.32,0:07:36.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tipuan kita berhasil.
Dialogue: 0,0:07:36.70,0:07:41.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sulit sekali bertingkah konyol\Nmeski cuma akting.
Dialogue: 0,0:07:41.79,0:07:44.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lah? Bukannya itu tingkah alamimu?
Dialogue: 0,0:07:44.71,0:07:48.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kangen Kakak!
Dialogue: 0,0:07:48.63,0:07:52.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu akting! Ai terlalu lebai!
Dialogue: 0,0:07:52.55,0:07:56.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru dia cuma menirumu yang biasanya.
Dialogue: 0,0:07:56.85,0:08:00.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bahkan tidak sadar\Nkapan kalian bertukar posisi.
Dialogue: 0,0:08:02.85,0:08:04.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada suara Kakak!
Dialogue: 0,0:08:05.65,0:08:07.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang malah halu.
Dialogue: 0,0:08:07.94,0:08:09.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang bukan akting.
Dialogue: 0,0:08:11.78,0:08:13.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak ketemu!
Dialogue: 0,0:08:14.49,0:08:15.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia menemukanku!
Dialogue: 0,0:08:15.91,0:08:18.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak sehat? Masih hidup, kan?
Dialogue: 0,0:08:18.33,0:08:21.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saking sibuknya hidup,\Naku tidak sempat mati.
Dialogue: 0,0:08:22.29,0:08:23.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ternyata benaran ada.{\i0}
Dialogue: 0,0:08:24.33,0:08:26.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sanderanya di gedung ini, kan?
Dialogue: 0,0:08:26.46,0:08:28.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak dari desa dan… Dirimu yang palsu.
Dialogue: 0,0:08:28.71,0:08:32.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada, mereka sudah kuamankan.
Dialogue: 0,0:08:32.59,0:08:34.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Puji aku! Peluk aku!
Dialogue: 0,0:08:34.63,0:08:36.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minta ke Migi sana.
Dialogue: 0,0:08:37.43,0:08:38.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peluk.
Dialogue: 0,0:08:38.85,0:08:41.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya pasanganmu dan anak desa aman.
Dialogue: 0,0:08:41.68,0:08:44.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah, ya, Danji.
Dialogue: 0,0:08:45.73,0:08:47.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yuru. Hah?
Dialogue: 0,0:08:47.81,0:08:49.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah datang.
Dialogue: 0,0:08:49.94,0:08:53.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak berbuat apa-apa.\NBerterimakasihlah ke Asa.
Dialogue: 0,0:08:53.49,0:08:55.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, sih.
Dialogue: 0,0:08:56.99,0:08:59.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku senang kamu datang.
Dialogue: 0,0:09:01.41,0:09:03.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Yuru. Dan maaf.
Dialogue: 0,0:09:04.08,0:09:06.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan bohong lagi.
Dialogue: 0,0:09:18.59,0:09:21.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asa, terima kasih!
Dialogue: 0,0:09:21.72,0:09:25.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku bukan melakukan ini untukmu!
Dialogue: 0,0:09:25.02,0:09:26.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini untuk Kakak!
Dialogue: 0,0:09:26.60,0:09:29.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan untuk\NKlan Kagemori yang berjasa bagiku.
Dialogue: 0,0:09:29.11,0:09:33.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Desa Higashi, sih, hancur juga biar saja!
Dialogue: 0,0:09:33.03,0:09:35.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian mirip sekali.
Dialogue: 0,0:09:35.07,0:09:36.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Apanya?
Dialogue: 0,0:09:36.90,0:09:38.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin sisi ganasnya.
Dialogue: 0,0:09:38.99,0:09:44.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kepala Klan Kagemori,\NShingo ada di kantor TT Logistik.
Dialogue: 0,0:09:44.04,0:09:47.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pergilah dan beri dia pelajaran.
Dialogue: 0,0:09:47.29,0:09:48.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu!
Dialogue: 0,0:09:49.75,0:09:52.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita ke sana.
Dialogue: 0,0:09:52.09,0:09:53.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:09:53.30,0:09:55.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak, sampai jumpa!
Dialogue: 0,0:09:58.55,0:09:59.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:10:02.93,0:10:05.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak menjawabku dengan santai!
Dialogue: 0,0:10:05.81,0:10:09.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia berjanji menemuiku lagi\Ndengan bilang, "Ya."
Dialogue: 0,0:10:09.19,0:10:10.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo jalan.
Dialogue: 0,0:10:10.31,0:10:13.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bersyukur masih hidup.
Dialogue: 0,0:10:13.77,0:10:19.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yuru, tadi kamu menyebut soal ortumu\Ndan Penjaga Ilahi Sayuu, kan?
Dialogue: 0,0:10:19.07,0:10:23.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.\NIbu dan ayahku hilang di dataran rendah.
Dialogue: 0,0:10:23.87,0:10:28.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penjaga Ilahi Sayuu sedang bertarung\Ndengan pria yang tahu soal itu.
Dialogue: 0,0:10:28.58,0:10:31.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Aku mau ke sana.\N- Bodoh!
Dialogue: 0,0:10:31.00,0:10:33.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu tidak ke sana lebih dulu?
Dialogue: 0,0:10:33.42,0:10:35.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudmu bodoh?
Dialogue: 0,0:10:35.42,0:10:38.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang tuamu hilang, lo! Dahulukan mereka!
Dialogue: 0,0:10:38.34,0:10:40.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar anak durhaka!
Dialogue: 0,0:10:40.18,0:10:42.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bukan anak durhaka!
Dialogue: 0,0:10:42.51,0:10:45.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu dan Asa hobi sekali mengataiku bodoh!
Dialogue: 0,0:10:45.77,0:10:51.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Asa yang dikurung itu palsu!\NAku juga telah menipumu!
Dialogue: 0,0:10:51.10,0:10:55.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kenapa malah mendahulukan kami? Bodoh!
Dialogue: 0,0:10:55.82,0:10:59.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu jadi mengingatkanku\Nsaat ditipu Asa palsu, sialan!
Dialogue: 0,0:10:59.70,0:11:00.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar bodoh!
Dialogue: 0,0:11:00.74,0:11:02.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kamu yang bodoh!\N- Tampaknya mereka sudah baikan.
Dialogue: 0,0:11:02.32,0:11:03.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Iya.\N- Bodoh, ya, bodoh!
Dialogue: 0,0:11:03.49,0:11:05.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bodoh kok teriak bodoh? Dasar bodoh!
Dialogue: 0,0:11:07.37,0:11:08.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya ampun.
Dialogue: 0,0:11:10.75,0:11:15.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayaknya aku memang kelelahan.\NBagaimana, ya…
Dialogue: 0,0:11:26.10,0:11:26.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Lo?
Dialogue: 0,0:11:27.72,0:11:31.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baterainya habis. Kantor makin pelit saja.
Dialogue: 0,0:11:33.44,0:11:37.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, apa-apaan ini?
Dialogue: 0,0:11:37.02,0:11:40.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa dibobol maling?
Dialogue: 0,0:11:45.74,0:11:47.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Merepotkan.
Dialogue: 0,0:12:01.72,0:12:04.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Panggil ambulans? Atau polisi?
Dialogue: 0,0:12:05.22,0:12:06.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kantor pusat!
Dialogue: 0,0:12:06.76,0:12:08.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini gawat!
Dialogue: 0,0:12:18.98,0:12:24.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini senapan, kamu pernah melihatnya\Nwaktu lawan Tenaga dan Ashinaga, kan?
Dialogue: 0,0:12:24.66,0:12:27.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senjata ini sangat mematikan.
Dialogue: 0,0:12:27.95,0:12:32.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manusia biasa bisa mati\Nmeski tidak kena titik vitalnya.
Dialogue: 0,0:12:33.41,0:12:38.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ingatlah bahwa satu tembakan ini\Nbisa bikin musuh mati.
Dialogue: 0,0:12:40.09,0:12:45.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi info soal orang tuamu, bagusnya\Nsi Cabul dan Tsugai-nya ditangkap saja.
Dialogue: 0,0:12:45.59,0:12:48.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi lengan Hidari saja dibikin putus.
Dialogue: 0,0:12:48.72,0:12:51.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan sulit menangkapnya hidup-hidup.
Dialogue: 0,0:12:51.14,0:12:52.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lengan Hidari putus?
Dialogue: 0,0:12:52.77,0:12:55.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hidari tetap santai, sih.
Dialogue: 0,0:12:55.85,0:12:59.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Intinya, pengguna\NTsugai katana itu berbahaya.
Dialogue: 0,0:12:59.27,0:13:02.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hindari pertarungan jarak dekat.
Dialogue: 0,0:13:02.74,0:13:05.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pun ragu kalau melawannya langsung.
Dialogue: 0,0:13:05.99,0:13:07.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makannya pakai senapan ini.
Dialogue: 0,0:13:08.41,0:13:09.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:13:10.74,0:13:11.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yuru.
Dialogue: 0,0:13:13.58,0:13:15.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penjaga Ilahi Sayuu ada di sana.
Dialogue: 0,0:13:21.13,0:13:23.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Itu, ya?\N- Mereka masih bertarung.
Dialogue: 0,0:13:23.96,0:13:26.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf kalau si Cabul kepalang mati olehku.
Dialogue: 0,0:13:26.55,0:13:31.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya kalau nyawamu terancam,\Naku tidak akan ragu menembak.
Dialogue: 0,0:13:31.76,0:13:35.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau aku juga bisa menembak\Nkalau kamu izinkan.
Dialogue: 0,0:13:35.98,0:13:37.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepakat?
Dialogue: 0,0:13:53.74,0:13:57.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya mau menangkapku hidup-hidup?
Dialogue: 0,0:13:57.71,0:13:59.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bohong, ya?
Dialogue: 0,0:13:59.42,0:14:03.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja, lemparanku sengaja\Ntidak mengenaimu.
Dialogue: 0,0:14:07.26,0:14:09.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Hidari, entahlah.
Dialogue: 0,0:14:27.11,0:14:28.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yuru, ya?
Dialogue: 0,0:14:31.62,0:14:33.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membelakangi cahaya?
Dialogue: 0,0:14:34.62,0:14:36.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial, dia sulit dipandang!
Dialogue: 0,0:14:43.84,0:14:44.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eits.
Dialogue: 0,0:14:49.26,0:14:51.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penjaga Ilahi Sayuu,\Nmaaf kalau kena kalian!
Dialogue: 0,0:14:52.80,0:14:55.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sungkan! Tembak sesukamu!
Dialogue: 0,0:14:58.10,0:15:00.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kena juga bukan masalah!
Dialogue: 0,0:15:15.28,0:15:16.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kamu!
Dialogue: 0,0:15:16.83,0:15:19.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eng… Cabul!
Dialogue: 0,0:15:19.04,0:15:21.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Julukan itu dari siapa, sih?
Dialogue: 0,0:15:21.33,0:15:26.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengguna Tsugai katana!\NKamu tahu soal orang tuaku, ya?
Dialogue: 0,0:15:26.96,0:15:31.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau mubazir anak panah,\Nmenyerahlah dan katakan semuanya!
Dialogue: 0,0:15:31.76,0:15:37.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin kalau kamu turun,\Naku akan ingat soal orang tuamu.
Dialogue: 0,0:15:37.35,0:15:39.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak akan.
Dialogue: 0,0:15:40.27,0:15:41.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga.
Dialogue: 0,0:15:44.52,0:15:49.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain dominasi dari atas,\Ndi bawah juga ada Penjaga Ilahi Sayuu.
Dialogue: 0,0:15:50.11,0:15:56.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka maju tanpa takut tubuhnya rusak.\NMerepotkan sekali.
Dialogue: 0,0:15:56.41,0:15:59.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu menyerang Desa Higashi\Ndan mengambil sandera, kan?
Dialogue: 0,0:15:59.91,0:16:01.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sanderanya sudah bebas.
Dialogue: 0,0:16:01.87,0:16:05.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya Shingo juga\Nsudah dibantai Klan Kagemori.
Dialogue: 0,0:16:05.21,0:16:09.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Dia masih kalah\Ndengan pasukan sebanyak itu?
Dialogue: 0,0:16:09.63,0:16:13.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada lagi alasan bernegosiasi\Ndengan kalian.
Dialogue: 0,0:16:13.59,0:16:16.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tahu sesuatu soal orang tuaku, kan?
Dialogue: 0,0:16:17.60,0:16:19.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ceritakan semuanya!
Dialogue: 0,0:16:20.27,0:16:24.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, kayaknya Shingo sudah kalah.
Dialogue: 0,0:16:24.06,0:16:30.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, akan kuceritakan mumpung sudah\Ntidak kerja sama om-om itu lagi.
Dialogue: 0,0:16:32.28,0:16:37.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau soal orang tuamu,\NShingo tidak ada hubungannya.
Dialogue: 0,0:16:38.91,0:16:41.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akulah yang menebas Mine dan Nagisa.
Dialogue: 0,0:16:45.42,0:16:46.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka aku penggal.
Dialogue: 0,0:16:49.63,0:16:52.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku butuh hadiah buat klien berikutnya.
Dialogue: 0,0:17:00.31,0:17:04.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agar Fuu didapatkan Yuru secepatnya,
Dialogue: 0,0:17:04.69,0:17:06.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}cepatlah mati, Hidari.
Dialogue: 0,0:17:30.92,0:17:34.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lengan mana yang kamu pakai\Nmenebas Ayah dan Ibu?
Dialogue: 0,0:17:34.84,0:17:38.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sini biar aku lubangi!
Dialogue: 0,0:17:40.35,0:17:41.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:17:41.76,0:17:43.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, kerja bagus.
Dialogue: 0,0:17:44.02,0:17:47.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tahan dia sampai aku pulang.
Dialogue: 0,0:17:50.36,0:17:53.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata pengkhianatnya memang Akio.
Dialogue: 0,0:17:57.40,0:17:59.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo selesaikan dan segera pulang.
Dialogue: 0,0:18:06.66,0:18:10.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Memenggal orang tuanya? Benarkah?{\i0}
Dialogue: 0,0:18:10.33,0:18:14.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Padahal lebih berguna\Nkalau dijadikan sandera.{\i0}
Dialogue: 0,0:18:14.00,0:18:15.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kenapa dibunuh?{\i0}
Dialogue: 0,0:18:17.17,0:18:18.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tidak.{\i0}
Dialogue: 0,0:18:18.76,0:18:21.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia bohong buat memancing Yuru!{\i0}
Dialogue: 0,0:18:23.31,0:18:28.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waduh, orang tuamu kutebas\Npakai lengan yang mana, ya?
Dialogue: 0,0:18:41.49,0:18:45.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tarik napas dalam-dalam, buang perlahan.{\i0}
Dialogue: 0,0:18:45.91,0:18:51.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ya, buang gejolak batinmu\Nbersama embusan napas.{\i0}
Dialogue: 0,0:18:51.58,0:18:54.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tenanglah dan amati situasinya.{\i0}
Dialogue: 0,0:18:54.55,0:18:56.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Selalu pikirkan harus apa{\i0}
Dialogue: 0,0:18:56.71,0:19:01.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dan bagaimana cara bertahan hidup\Ndengan apa yang ada.{\i0}
Dialogue: 0,0:19:03.47,0:19:07.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mine pakai lengan kanan,\NNagisa pakai lengan kiri.
Dialogue: 0,0:19:08.02,0:19:10.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau terbalik, ya?
Dialogue: 0,0:19:10.94,0:19:13.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Terpancinglah, Yuru.{\i0}
Dialogue: 0,0:19:19.03,0:19:23.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kematian bisa datang saat hatimu goyah.
Dialogue: 0,0:19:29.37,0:19:31.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Buang anak panahmu.{\i0}
Dialogue: 0,0:19:31.67,0:19:35.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok diam?\NPembunuh orang tuamu di sini, lo.
Dialogue: 0,0:19:35.75,0:19:37.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak diserang?
Dialogue: 0,0:19:38.21,0:19:39.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Beri aku celah.{\i0}
Dialogue: 0,0:19:43.64,0:19:45.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Percuma, Ayah.{\i0}
Dialogue: 0,0:19:48.68,0:19:50.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tenanglah, Yuru! Tenanglah!{\i0}
Dialogue: 0,0:19:57.44,0:19:59.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Batinku tetap bergejolak!{\i0}
Dialogue: 0,0:20:03.24,0:20:06.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka pasti baik-baik saja.
Dialogue: 0,0:20:26.09,0:20:28.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak percaya\Nsebelum melihatnya sendiri.
Dialogue: 0,0:20:29.97,0:20:32.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat taruh Tsugai katanamu.
Dialogue: 0,0:20:33.35,0:20:35.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cih, enggak asyik.
Dialogue: 0,0:20:36.56,0:20:38.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang ini buatku saja?
Dialogue: 0,0:20:38.86,0:20:41.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan itu juga tidak mempan?
Dialogue: 0,0:20:41.99,0:20:44.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada orang juga di sana.
Dialogue: 0,0:20:44.78,0:20:47.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kabur dengan luka ini pun sia-sia.
Dialogue: 0,0:20:48.33,0:20:54.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kacau, aku yang awalnya memburu\Nmalah jadi diburu.
Dialogue: 0,0:20:54.83,0:20:56.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa boleh buat.
Dialogue: 0,0:20:56.58,0:20:59.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya aku ogah memakainya, sih.
Dialogue: 0,0:21:00.55,0:21:01.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daikyo.
Dialogue: 0,0:21:13.68,0:21:15.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hidari, buang katananya!
Dialogue: 0,0:21:38.75,0:21:40.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Migi…\N- Hidari!
Dialogue: 0,0:21:41.59,0:21:43.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ini gawat.\N- Eh?
Dialogue: 0,0:21:43.71,0:21:45.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awas, Migi!
Dialogue: 0,0:21:45.47,0:21:48.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hidari adalah mangsaku!
Dialogue: 0,0:23:28.99,0:23:31.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kejam sekali.{\i0}
Dialogue: 0,0:23:31.49,0:23:32.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Yuru!{\i0}
Dialogue: 0,0:23:32.61,0:23:34.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kakak.{\i0}
Dialogue: 0,0:23:34.07,0:23:35.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tsugai yang mengendalikan orang?{\i0}
Dialogue: 0,0:23:35.78,0:23:37.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ngeri juga kalau kena.{\i0}
