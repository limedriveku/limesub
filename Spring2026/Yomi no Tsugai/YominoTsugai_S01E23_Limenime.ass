Dialogue: 0,0:08:05.10,0:08:07.19,sign,,0000,0000,0000,,AKIO KABUR
Dialogue: 0,0:08:07.19,0:08:12.53,sign,,0000,0000,0000,,MAAF, AKU TELAH MEMBIARKAN PRIA\NYANG MENGINCARMU KABUR, ASA
Dialogue: 0,0:08:15.62,0:08:18.28,sign,,0000,0000,0000,,AKU SUDAH TERBIASA DIINCAR
Dialogue: 0,0:08:26.13,0:08:27.63,sign,,0000,0000,0000,,{\an8}KAMU SUDAH BEKERJA KERAS
Dialogue: 0,0:08:27.63,0:08:28.92,sign,,0000,0000,0000,,{\an8}KERJA BAGUS
Dialogue: 0,0:08:28.92,0:08:30.50,sign,,0000,0000,0000,,{\an8}ISTIRAHATLAH
Dialogue: 0,0:08:30.51,0:08:36.47,sign,,0000,0000,0000,,{\an8}TERIMA KASIH
Dialogue: 0,0:08:36.47,0:08:38.30,sign,,0000,0000,0000,,{\an8}MASIH ADA PEKERJAAN TERSISA,\NTAKUT DIMARAHI BOS
Dialogue: 0,0:10:31.00,0:10:32.00,sign,,0000,0000,0000,,{\an8}DANNO
Dialogue: 0,0:12:52.85,0:12:53.68,sign,,0000,0000,0000,,ASAKUSA, KAMINARIMON
Dialogue: 0,0:19:04.51,0:19:06.06,sign,,0000,0000,0000,,HANA
Dialogue: 0,0:23:27.57,0:23:28.98,sign,,0000,0000,0000,,EPISODE SELANJUTNYA
Dialogue: 0,0:01:35.17,0:01:36.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanikaze?
Dialogue: 0,0:01:37.51,0:01:40.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam bentuk relik? Mau apa kemari?
Dialogue: 0,0:01:55.03,0:01:59.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya! Tiarap!
Dialogue: 0,0:02:12.34,0:02:14.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa? Kali ini dari mana lagi?
Dialogue: 0,0:02:16.80,0:02:18.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jin…
Dialogue: 0,0:02:30.23,0:02:33.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kantung pel**mu kuat juga.
Dialogue: 0,0:02:35.19,0:02:36.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang terjadi?
Dialogue: 0,0:02:36.44,0:02:38.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanikaze meledak.
Dialogue: 0,0:02:44.53,0:02:46.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akio! Usa!
Dialogue: 0,0:02:48.87,0:02:50.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akio tidak ada di sini.
Dialogue: 0,0:02:50.62,0:02:51.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada?
Dialogue: 0,0:02:51.96,0:02:55.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau terlempar, potongan tubuhnya\Npasti tersebar di mana-mana.
Dialogue: 0,0:02:56.34,0:02:57.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia kabur!
Dialogue: 0,0:02:58.13,0:03:02.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, ruang medisnya hancur.
Dialogue: 0,0:03:02.09,0:03:03.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Naluri Tsugai adalah
Dialogue: 0,0:03:03.64,0:03:07.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}selalu memprioritaskan\Nkeselamatan tuannya.
Dialogue: 0,0:03:07.02,0:03:08.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia berhasil memanfaatkannya.
Dialogue: 0,0:03:09.81,0:03:12.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena anak ini melepas kuncian Akio…
Dialogue: 0,0:03:13.56,0:03:15.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Midori tidak bersalah.
Dialogue: 0,0:03:15.86,0:03:18.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia hanya melindungi tuannya.
Dialogue: 0,0:03:18.19,0:03:20.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya kamu puji dia.
Dialogue: 0,0:03:23.03,0:03:25.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanikaze yang tadi meledak
Dialogue: 0,0:03:25.53,0:03:27.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dikendalikan makhluk mirip jamur lendir.
Dialogue: 0,0:03:28.62,0:03:32.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yamakaze kena persis seperti itu\Ndi gerbang utama tadi.
Dialogue: 0,0:03:33.33,0:03:37.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin tipe parasit yang menjadikan inang\Nsebagai bom bunuh diri.
Dialogue: 0,0:03:37.75,0:03:40.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ditambah,\Nhawa Tsugai aslinya tidak terdeteksi.
Dialogue: 0,0:03:41.26,0:03:44.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya mereka tipe yang bisa\Nmemisahkan bagian tubuhnya.
Dialogue: 0,0:03:45.43,0:03:49.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mirip Matahari dan Bulan?
Dialogue: 0,0:03:50.02,0:03:52.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak kapan terkena parasit itu?
Dialogue: 0,0:03:52.27,0:03:53.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak tahu.
Dialogue: 0,0:03:53.94,0:03:56.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial, sebenarnya siapa?
Dialogue: 0,0:03:56.77,0:04:01.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak rela mereka dimanfaatkan\Nsebagai bom bunuh diri.
Dialogue: 0,0:04:02.28,0:04:06.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jijimaru, Babamaru. Kalian cari Akio.
Dialogue: 0,0:04:07.12,0:04:07.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:04:10.29,0:04:13.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia berhasil memanfaatkan naluri Tsugai{\i0}
Dialogue: 0,0:04:13.87,0:04:15.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}yang selalu\Nmemprioritaskan keselamatan tuannya.{\i0}
Dialogue: 0,0:04:18.13,0:04:19.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Memang masuk akal…{\i0}
Dialogue: 0,0:04:22.34,0:04:25.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tapi, bagaimana kalau tujuan sebenarnya{\i0}
Dialogue: 0,0:04:25.64,0:04:28.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}membunuh Akio yang tertangkap?{\i0}
Dialogue: 0,0:04:48.45,0:04:52.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih suka Kakak yang ini\Natau Kakak yang itu?
Dialogue: 0,0:04:52.70,0:04:55.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}- Kalau aku suka dua-duanya…\N- Kami sudah memeriksanya.
Dialogue: 0,0:04:59.25,0:05:00.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada anjing…
Dialogue: 0,0:05:00.75,0:05:04.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada beberapa mobil polisi di gudang sana.
Dialogue: 0,0:05:04.67,0:05:07.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi situasinya terlihat biasa-biasa saja.
Dialogue: 0,0:05:07.55,0:05:08.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah.
Dialogue: 0,0:05:08.89,0:05:13.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tidak ada keributan padahal si cabul\Ntelah membunuh banyak orang.{\i0}
Dialogue: 0,0:05:13.56,0:05:16.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu berarti di pihak dia juga\Npunya pembersih mayat.{\i0}
Dialogue: 0,0:05:17.40,0:05:22.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seingatku, Tsugai Kagemori Jin juga\Ntipe pembersih, ya?
Dialogue: 0,0:05:22.23,0:05:23.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jin?
Dialogue: 0,0:05:23.44,0:05:26.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, jadi dia pembersih mayat\Ndi Klan Kagemori.
Dialogue: 0,0:05:27.57,0:05:31.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belum pernah lihat Tsugai-nya, sih.
Dialogue: 0,0:05:31.33,0:05:33.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi harus hati-hati.
Dialogue: 0,0:05:33.37,0:05:34.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:05:34.75,0:05:37.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kubu mana pun pasti punya pembersih mayat,
Dialogue: 0,0:05:38.58,0:05:41.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}seperti halnya "Penggali Kubur"\Ndari Desa Higashi.
Dialogue: 0,0:05:42.05,0:05:46.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Dasar pak tua sialan.\NEntah sejauh mana dia tahu soal Hana.{\i0}
Dialogue: 0,0:05:47.80,0:05:50.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah menghapus rekaman\Nkamera pengintai.
Dialogue: 0,0:05:51.39,0:05:54.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bisa menyetir, Tadera?
Dialogue: 0,0:05:54.43,0:05:55.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa.
Dialogue: 0,0:05:55.73,0:05:57.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mobilku ada di sana.
Dialogue: 0,0:05:58.02,0:05:59.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gunakanlah untuk perjalanan pulang.
Dialogue: 0,0:06:00.31,0:06:02.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, makasih.
Dialogue: 0,0:06:02.98,0:06:06.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada GPS-nya tidak?\NTidak akan membuntutiku, kan?
Dialogue: 0,0:06:06.03,0:06:10.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak akan, aku sudah kapok.
Dialogue: 0,0:06:10.87,0:06:12.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jin juga sampai memarahiku.
Dialogue: 0,0:06:14.12,0:06:16.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak akan lagi, kok.
Dialogue: 0,0:06:16.29,0:06:17.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mencurigakan banget!
Dialogue: 0,0:06:18.83,0:06:22.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kamu bisa menggali informasi\NKlan Tadera dari Tsugai-nya?
Dialogue: 0,0:06:22.79,0:06:27.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Mustahil, karena dia tidak membawa Tsugai.
Dialogue: 0,0:06:32.10,0:06:36.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jin? Maaf, tadinya mau langsung pulang.
Dialogue: 0,0:06:38.43,0:06:39.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ruang medis juga?
Dialogue: 0,0:06:39.98,0:06:41.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dokter Sakurazawa selamat?
Dialogue: 0,0:06:42.65,0:06:44.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya. Cari!
Dialogue: 0,0:06:45.94,0:06:49.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asuma, Asa, kita harus pulang.
Dialogue: 0,0:06:49.15,0:06:51.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akio kabur.
Dialogue: 0,0:06:55.08,0:06:57.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia kabur?
Dialogue: 0,0:06:58.79,0:06:59.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini lagi!
Dialogue: 0,0:06:59.75,0:07:03.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Petunjuk Ayah dan Ibu hilang.
Dialogue: 0,0:07:04.75,0:07:06.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak!
Dialogue: 0,0:07:06.92,0:07:07.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yuru!
Dialogue: 0,0:07:09.22,0:07:11.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yuru! Kamu tidak apa-apa?
Dialogue: 0,0:07:12.30,0:07:14.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia demam.
Dialogue: 0,0:07:14.22,0:07:17.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hal biasa bagi orang Desa Higashi\Nsaat turun gunung.
Dialogue: 0,0:07:17.93,0:07:21.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia terserang bakteri dan virus\Ndataran rendah.
Dialogue: 0,0:07:22.23,0:07:25.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum lagi, sejak turun gunung
Dialogue: 0,0:07:25.31,0:07:29.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia terus bertarung dan tegang\Ndi tempat asing.
Dialogue: 0,0:07:29.69,0:07:32.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajar tubuhnya tumbang.
Dialogue: 0,0:07:33.11,0:07:34.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ruang medis Kagemori!
Dialogue: 0,0:07:34.66,0:07:36.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedang tidak bisa digunakan.
Dialogue: 0,0:07:37.54,0:07:39.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak, Kakak!
Dialogue: 0,0:07:39.54,0:07:40.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja.
Dialogue: 0,0:07:41.08,0:07:44.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sudah biasa. Serahkan padaku.
Dialogue: 0,0:07:44.96,0:07:47.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami mau langsung kembali\Nke tempat persembunyian.
Dialogue: 0,0:07:47.63,0:07:50.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menghubungi kalian\Nlewat barnya Jin lagi.
Dialogue: 0,0:08:21.12,0:08:26.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dikhianati orang terdekat itu menyakitkan.{\i0}
Dialogue: 0,0:09:02.12,0:09:05.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita perluas area pencarian
Dialogue: 0,0:09:05.67,0:09:08.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di area sekitar ruang medis juga.
Dialogue: 0,0:09:08.00,0:09:09.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jin.
Dialogue: 0,0:09:09.84,0:09:11.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana dengan kalian?
Dialogue: 0,0:09:11.63,0:09:14.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami tidak menemukan apa pun\Ndi kamarnya Akio.
Dialogue: 0,0:09:14.09,0:09:17.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya.\NKalau ketemu Akio, jangan menangkapnya,
Dialogue: 0,0:09:17.97,0:09:20.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi berteriaklah supaya yang lain tahu.
Dialogue: 0,0:09:20.01,0:09:21.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:09:21.18,0:09:24.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tidak bisa diatasi\Ndengan kemampuan kalian.
Dialogue: 0,0:09:24.68,0:09:27.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pastikan patroli minimal berdua.{\i0}
Dialogue: 0,0:09:27.35,0:09:30.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jangan sampai sendirian.{\i0}
Dialogue: 0,0:09:59.26,0:10:02.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf membuat kalian jadi Tsugai liar.
Dialogue: 0,0:10:02.76,0:10:05.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Toh, mereka akan segera menemukan kalian.
Dialogue: 0,0:10:33.79,0:10:38.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pendarahannya sudah berhenti,\Ntinggal tunggu lukanya sembuh.
Dialogue: 0,0:10:38.55,0:10:40.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Vaksin tetanusnya?
Dialogue: 0,0:10:40.05,0:10:43.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua orang di Desa Higashi\Nsudah divaksin si Dukun.
Dialogue: 0,0:10:44.81,0:10:46.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bawa kompres es.
Dialogue: 0,0:10:46.89,0:10:47.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:10:51.06,0:10:52.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Istirahatlah yang cukup.
Dialogue: 0,0:10:52.61,0:10:54.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu kedinginan?
Dialogue: 0,0:10:55.07,0:10:58.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, aku malah merepotkan kalian.
Dialogue: 0,0:10:58.49,0:11:01.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau lagi sakit, tidak usah sungkan.
Dialogue: 0,0:11:01.82,0:11:04.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus saling tolong-menolong.
Dialogue: 0,0:11:04.58,0:11:08.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alie—\NTsugai berjas hitam juga bilang begitu.
Dialogue: 0,0:11:08.83,0:11:12.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tsugai dan manusia\Ntidak bisa hidup sendiri.
Dialogue: 0,0:11:14.59,0:11:16.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Ken.
Dialogue: 0,0:11:17.00,0:11:21.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu sakit nanti, aku akan berburu\Nbabi hutan lalu dijadikan rebusan.
Dialogue: 0,0:11:21.68,0:11:24.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asal jangan melanggar hukum, ya!
Dialogue: 0,0:11:24.60,0:11:26.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sakitnya tidak mengancam nyawa, kan?
Dialogue: 0,0:11:27.47,0:11:30.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku rasa baik-baik saja\Nkarena masih bisa diajak mengobrol.
Dialogue: 0,0:11:30.94,0:11:34.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf membuat kalian khawatir,\NPenjaga Ilahi Sayuu.
Dialogue: 0,0:11:35.77,0:11:38.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu minta maaf.
Dialogue: 0,0:11:38.61,0:11:43.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat sembuh dan ayo kita tangkap\Npengguna Tsugai katana itu.
Dialogue: 0,0:11:44.41,0:11:47.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanganmu dingin dan nyaman, Migi.
Dialogue: 0,0:11:49.25,0:11:50.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa?
Dialogue: 0,0:11:50.33,0:11:51.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya dia batu.
Dialogue: 0,0:11:51.79,0:11:54.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ambil saja ini buat mendinginkanmu.
Dialogue: 0,0:11:57.59,0:11:59.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku terima niat baikmu saja.
Dialogue: 0,0:12:02.34,0:12:04.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Istirahatlah yang cukup, Yuru.
Dialogue: 0,0:12:06.22,0:12:08.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah…
Dialogue: 0,0:12:09.06,0:12:12.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minta penjelasan dari mana dulu, ya?
Dialogue: 0,0:12:12.64,0:12:14.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada anak haram baru.
Dialogue: 0,0:12:14.35,0:12:16.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia anak Desa Higashi yang diculik.
Dialogue: 0,0:12:17.40,0:12:21.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan memungut anjing sembarangan.\NDi sini dilarang pelihara hewan.
Dialogue: 0,0:12:21.28,0:12:23.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pengguna Tsugai.
Dialogue: 0,0:12:23.32,0:12:24.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu anjing ini
Dialogue: 0,0:12:25.74,0:12:28.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah tuan kami!
Dialogue: 0,0:12:28.03,0:12:29.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pulanglah ke planet kalian.
Dialogue: 0,0:12:29.91,0:12:33.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rumah yang dihuni oleh Zashiki Warashi\Nbisa mendapatkan kemakmuran,
Dialogue: 0,0:12:33.66,0:12:35.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi bersantailah di sini.
Dialogue: 0,0:12:35.71,0:12:37.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan bantalnya.
Dialogue: 0,0:12:37.13,0:12:38.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pilih kasih!{\i0}
Dialogue: 0,0:12:39.55,0:12:41.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pulang!
Dialogue: 0,0:12:41.63,0:12:43.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, ramai sekali.
Dialogue: 0,0:12:43.42,0:12:44.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Nambah lagi!{\i0}
Dialogue: 0,0:12:44.51,0:12:48.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi kayak tempat nongkrong Tsugai, ya.
Dialogue: 0,0:12:48.05,0:12:51.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya Anda sudah pulang ke desa,\NOshirasama?
Dialogue: 0,0:12:53.68,0:12:55.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku habis wisata ke Tokyo.
Dialogue: 0,0:12:55.90,0:12:58.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menikmati hidup banget…
Dialogue: 0,0:12:58.48,0:13:01.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nih, oleh-oleh Tokyo Tower buat Danno.
Dialogue: 0,0:13:01.73,0:13:04.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anda punya uang?
Dialogue: 0,0:13:04.78,0:13:07.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus Anda belanja\Ndengan menampakkan diri?
Dialogue: 0,0:13:07.91,0:13:11.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak orang-orang kuil\Nyang bisa melihatku.
Dialogue: 0,0:13:11.79,0:13:14.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami pun cepat akrab\Nterus dikasih banyak hadiah.
Dialogue: 0,0:13:15.00,0:13:16.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, pendatang baru?
Dialogue: 0,0:13:16.96,0:13:19.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang di sana pasangannya Danji, ya?
Dialogue: 0,0:13:19.63,0:13:20.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beliau Oshirasama.
Dialogue: 0,0:13:21.25,0:13:22.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat malam.
Dialogue: 0,0:13:22.38,0:13:25.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang ini anak dari Desa Higashi?
Dialogue: 0,0:13:25.51,0:13:29.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Imutnya! Aku suka anak-anak!
Dialogue: 0,0:13:29.35,0:13:32.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, dia tidak bisa melihatku, ya?
Dialogue: 0,0:13:33.43,0:13:36.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo! Aku Oshirasama!
Dialogue: 0,0:13:36.77,0:13:38.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Gawat, dia bisa pingsan lagi!{\i0}
Dialogue: 0,0:13:39.94,0:13:42.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini ada oleh-oleh untukmu juga.
Dialogue: 0,0:13:48.28,0:13:49.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:13:49.57,0:13:50.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Langsung kalem!{\i0}
Dialogue: 0,0:13:51.37,0:13:55.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, desaku diserang…
Dialogue: 0,0:13:55.08,0:13:59.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibuku sampai meninggal, jadi…
Dialogue: 0,0:13:59.04,0:14:02.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, pasti berat untukmu.
Dialogue: 0,0:14:02.00,0:14:06.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kamu pasti syok. Kamu sudah berjuang.\N- Pencinta anak-anak memang hebat.
Dialogue: 0,0:14:06.47,0:14:09.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu gadis berkepang dengan kimono merah
Dialogue: 0,0:14:09.13,0:14:11.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan tatapan mata\Nseram itu memberi isyarat,
Dialogue: 0,0:14:12.05,0:14:15.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}orang-orang dewasa langsung terbelah dua…
Dialogue: 0,0:14:15.27,0:14:16.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Ibu juga…
Dialogue: 0,0:14:16.89,0:14:20.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tsugai gigi palsu\Nyang kamu bilang waktu itu?
Dialogue: 0,0:14:20.77,0:14:24.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, tuannya gadis bernama Gabuchan.
Dialogue: 0,0:14:26.19,0:14:30.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asa kelihatannya dirawat baik\Ndi wisma Kagemori…
Dialogue: 0,0:14:30.07,0:14:34.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Azami punya target balas dendam di sana,\Njadi mustahil dititipkan ke Kagemori.
Dialogue: 0,0:14:34.70,0:14:39.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tahu terlalu banyak,\Npulang ke desa pun bisa dikurung, kan?
Dialogue: 0,0:14:39.25,0:14:42.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon! Lindungi Azami di sini!
Dialogue: 0,0:14:43.46,0:14:50.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Duh, kenapa kamu selalu bawa anak baru\Ntiap kali pulang ke rumah, Dera?
Dialogue: 0,0:14:50.09,0:14:54.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Keselamatan Azami lebih terjamin\Nkalau tinggal di dekatku dan Yuru.
Dialogue: 0,0:14:55.47,0:14:57.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari mana duitnya?
Dialogue: 0,0:14:58.43,0:15:00.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena ribut sama bandit gunung,
Dialogue: 0,0:15:00.60,0:15:02.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita mungkin enggak\Nakan dapat kerjaan lagi
Dialogue: 0,0:15:02.23,0:15:04.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di sekitar Desa Higashi, tahu!
Dialogue: 0,0:15:04.69,0:15:06.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Lomba G1 berikutnya kapan, ya?
Dialogue: 0,0:15:08.49,0:15:10.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Jangan judi!
Dialogue: 0,0:15:10.28,0:15:14.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kali ini aku akan menang!\NAku pasti menang!
Dialogue: 0,0:15:15.95,0:15:17.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan menangis!
Dialogue: 0,0:15:17.04,0:15:18.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada aku di sini!
Dialogue: 0,0:15:18.66,0:15:20.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau pulang!
Dialogue: 0,0:15:20.25,0:15:23.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau naik kereta cepat, lewat jalan tol,\Natau naik kuda?
Dialogue: 0,0:15:26.34,0:15:28.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berjuanglah, tuanku!
Dialogue: 0,0:15:28.13,0:15:29.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sampai kalah, tuanku!
Dialogue: 0,0:15:29.67,0:15:31.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semangat, tuanku!
Dialogue: 0,0:15:32.09,0:15:35.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ribut sekali padahal ada orang sakit!{\i0}
Dialogue: 0,0:15:35.85,0:15:40.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ternyata yang waras di sini cuma aku.{\i0}
Dialogue: 0,0:15:41.77,0:15:44.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yuru, maaf kalau berisik…
Dialogue: 0,0:15:47.15,0:15:48.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tidak ada?
Dialogue: 0,0:15:49.07,0:15:52.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penjaga Ilahi Sayuu, Yuru pergi ke mana?
Dialogue: 0,0:15:52.74,0:15:54.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ke mana-mana.
Dialogue: 0,0:15:57.62,0:15:58.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sini.
Dialogue: 0,0:16:00.50,0:16:02.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu ada di sini?
Dialogue: 0,0:16:02.62,0:16:04.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidur di kasur sana!
Dialogue: 0,0:16:04.54,0:16:06.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku lebih suka di sini.
Dialogue: 0,0:16:07.13,0:16:10.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku lebih tenang\Ndi tempat gelap dan sempit.
Dialogue: 0,0:16:10.71,0:16:12.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya kamu binatang liar?
Dialogue: 0,0:16:12.84,0:16:14.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kebalikan dari Asa, ya?
Dialogue: 0,0:16:15.22,0:16:17.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yuru, kamu ada tenaga untuk makan?
Dialogue: 0,0:16:19.10,0:16:20.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nasi kepal garam?
Dialogue: 0,0:16:20.72,0:16:21.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau.
Dialogue: 0,0:16:22.14,0:16:23.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke!
Dialogue: 0,0:16:30.48,0:16:33.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak! Nasi kepal garam buatanmu\Nmemang terbaik!
Dialogue: 0,0:16:34.49,0:16:35.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makasih.
Dialogue: 0,0:16:35.95,0:16:37.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Habis makan itu…
Dialogue: 0,0:16:37.07,0:16:38.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diminum setelah makan, ya.
Dialogue: 0,0:16:39.79,0:16:41.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Batu apaan ini?
Dialogue: 0,0:16:41.08,0:16:42.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pereda nyeri dan penurun demam.
Dialogue: 0,0:16:43.37,0:16:47.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau memasukkan batu aneh\Nke tubuh yang lagi sakit.
Dialogue: 0,0:16:47.04,0:16:48.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja.
Dialogue: 0,0:16:48.59,0:16:51.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang-orang Desa Higashi\Nbiasa meminum itu.
Dialogue: 0,0:16:52.13,0:16:55.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bubuk pereda nyeri\Nyang biasa kubawa ke desa.
Dialogue: 0,0:16:56.09,0:17:00.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu cuma pil pasaran\Nyang kuhancurkan jadi bubuk.
Dialogue: 0,0:17:00.18,0:17:01.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pil pasaran?
Dialogue: 0,0:17:02.60,0:17:05.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Produksi massal\Nyang gampang dibeli di toko.
Dialogue: 0,0:17:05.89,0:17:09.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang-orang di desa bilang manjur banget,
Dialogue: 0,0:17:09.11,0:17:12.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi kukira racikan tabib ternama.
Dialogue: 0,0:17:13.44,0:17:14.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi memang manjur.
Dialogue: 0,0:17:33.84,0:17:36.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dibilang itu obat setelah makan.
Dialogue: 0,0:17:36.97,0:17:39.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah kamu nafsu makan.
Dialogue: 0,0:17:55.11,0:17:58.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemandangan malam yang indah, ya, Darling.
Dialogue: 0,0:17:58.82,0:18:01.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pendapat Dera menurun,{\i0}
Dialogue: 0,0:18:01.99,0:18:05.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}tapi tanggungannya malah bertambah.{\i0}
Dialogue: 0,0:18:05.25,0:18:08.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ditambah lagi, salah duanya\Ntidak punya akta kelahiran.
Dialogue: 0,0:18:09.83,0:18:12.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bikin repot saja!
Dialogue: 0,0:18:12.13,0:18:14.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti ada jalan, kok.
Dialogue: 0,0:18:14.00,0:18:16.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu terlalu santai.
Dialogue: 0,0:18:16.42,0:18:18.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok bisa pede begitu, sih?
Dialogue: 0,0:18:18.59,0:18:21.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, kehadiranmu di sini
Dialogue: 0,0:18:21.68,0:18:24.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}membuatku merasa jauh lebih tenang.
Dialogue: 0,0:18:27.31,0:18:29.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu ingin Yuru mati?
Dialogue: 0,0:18:30.44,0:18:32.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memang benci anak-anak,
Dialogue: 0,0:18:32.06,0:18:36.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}tapi orang dewasa yang memanfaatkan\Nmereka mending mati saja!
Dialogue: 0,0:18:44.08,0:18:47.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, terima kasih banyak untuk hari ini!
Dialogue: 0,0:18:47.62,0:18:49.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan lupa mandi sebelum tidur, ya!
Dialogue: 0,0:18:50.04,0:18:52.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takutnya tertular demamnya Yuru.
Dialogue: 0,0:18:53.21,0:18:55.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidur di kamarku, Ken.
Dialogue: 0,0:18:55.17,0:18:56.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:18:56.38,0:18:57.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Azami tidur di kamarku, ya.
Dialogue: 0,0:19:00.55,0:19:02.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja, Azami.
Dialogue: 0,0:19:02.14,0:19:04.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kakak ini tidak menakutkan, kok.{\i0}
Dialogue: 0,0:19:24.58,0:19:27.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamarnya seram banget!
Dialogue: 0,0:19:38.05,0:19:39.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah menunggumu.
Dialogue: 0,0:19:44.14,0:19:46.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang, Akio.
Dialogue: 0,0:19:48.47,0:19:50.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pulang, Bu.
Dialogue: 0,0:19:51.85,0:19:53.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu terluka?
Dialogue: 0,0:19:53.69,0:19:54.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baik-baik saja.
Dialogue: 0,0:19:54.94,0:19:59.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik-baik saja dari mana?\NWajahmu pucat sekali.
Dialogue: 0,0:19:59.15,0:20:03.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kehabisan darah, jadi ingin istirahat.
Dialogue: 0,0:20:03.82,0:20:05.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Akio.
Dialogue: 0,0:20:06.62,0:20:12.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku datang menolongmu,\Nkamu tidak akan sampai begini.
Dialogue: 0,0:20:13.04,0:20:15.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Bu.
Dialogue: 0,0:20:16.00,0:20:18.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai sekarang, kita akan terus bersama.
Dialogue: 0,0:20:19.21,0:20:20.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akio.
Dialogue: 0,0:20:21.76,0:20:22.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:20:25.72,0:20:28.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ikatan darah adalah kutukan.{\i0}
Dialogue: 0,0:20:29.47,0:20:34.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimanapun, kamu tidak bisa lepas\Ndari kenyataan itu.
Dialogue: 0,0:20:35.65,0:20:37.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang terjadi?
Dialogue: 0,0:20:37.06,0:20:39.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kabarnya Akio berhasil diamankan.
Dialogue: 0,0:20:39.15,0:20:42.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Amankan, amankan, amankan!
Dialogue: 0,0:20:42.40,0:20:45.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bocah itu belum mati?
Dialogue: 0,0:20:45.32,0:20:48.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, aku gagal menghabisinya.
Dialogue: 0,0:20:48.16,0:20:51.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudahlah, pasti masih ada gunanya.
Dialogue: 0,0:20:52.00,0:20:52.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah…
Dialogue: 0,0:20:53.79,0:20:56.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berapa banyak info kita yang bocor\Nke Jin dan yang lain?
Dialogue: 0,0:20:57.67,0:21:02.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal enak kalau orang Desa Higashi\Nsaling bantai seperti biasa.
Dialogue: 0,0:21:02.84,0:21:06.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ivan sudah menghabisi banyak prajurit\NDesa Higashi buat kita, kan?
Dialogue: 0,0:21:06.97,0:21:10.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saling bantai,\Nsaling bantai, saling bantai!
Dialogue: 0,0:21:11.35,0:21:13.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, aku ingat!
Dialogue: 0,0:21:13.02,0:21:16.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makhluk itu! Yang mirip jamur lendir itu!
Dialogue: 0,0:21:16.31,0:21:18.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayaknya pernah kudengar di kampungku!
Dialogue: 0,0:21:18.77,0:21:20.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di kampungmu?
Dialogue: 0,0:21:20.52,0:21:23.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Leluhurku dari Prefektur Tottori.
Dialogue: 0,0:21:23.65,0:21:28.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya di barat ada yang diam-diam\Nmenempelkan spora ke relik
Dialogue: 0,0:21:28.70,0:21:31.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tsugai orang lain biar bertunas…
Dialogue: 0,0:21:31.79,0:21:32.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar…
Dialogue: 0,0:21:33.41,0:21:36.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makhluk itu pasti Tsugai dari barat…
Dialogue: 0,0:21:37.08,0:21:39.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Empat ratus tahun kami menunggu.
Dialogue: 0,0:21:40.00,0:21:43.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peluang emas ini tidak boleh disia-siakan.
Dialogue: 0,0:21:46.17,0:21:49.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kali ini, pihak barat yang akan menang!
Dialogue: 0,0:23:28.99,0:23:31.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Padahal aku tidak pernah\Nmendoakan kematian siapa pun.{\i0}
Dialogue: 0,0:23:32.11,0:23:34.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku hanya ingin hidup normal…{\i0}
Dialogue: 0,0:23:35.16,0:23:37.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Perlu kubantai mereka semua sekarang?{\i0}
