Dialogue: 0,0:19:44.85,0:19:45.55,sign,,0000,0000,0000,,{\an8}STUDIO HAGURE, SEDANG BEKERJA,\NDILARANG MASUK
Dialogue: 0,0:23:27.57,0:23:28.94,sign,,0000,0000,0000,,EPISODE SELANJUTNYA
Dialogue: 0,0:01:32.63,0:01:36.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal tidak perlu ada yang mati\Nkalau Yuru datang sendirian.
Dialogue: 0,0:01:37.09,0:01:40.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian berdua Penjaga Ilahi Sayuu, kan?\NTsugai milik Yuru?
Dialogue: 0,0:01:41.39,0:01:45.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok musuh alami Kai dan Fuu\Nmalah jadi Tsugai-nya si kembar?
Dialogue: 0,0:01:46.60,0:01:47.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terutama Hidari.
Dialogue: 0,0:01:48.27,0:01:50.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu dan Fuu sangat tidak cocok.
Dialogue: 0,0:01:51.48,0:01:56.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama ada kamu, mungkin Fuu\Ntidak akan mau kontrak dengan Yuru.
Dialogue: 0,0:01:57.36,0:01:58.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maka dari itu…
Dialogue: 0,0:02:01.07,0:02:03.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu adalah pengganggu, enyahlah.
Dialogue: 0,0:02:05.12,0:02:07.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu diajak duel, Hidari.
Dialogue: 0,0:02:09.25,0:02:11.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku terima.
Dialogue: 0,0:02:11.13,0:02:16.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dipikir-pikir, pengguna katana\Nnyaris tidak ada di zaman ini.
Dialogue: 0,0:02:16.76,0:02:19.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal 400 tahun lalu ada banyak.
Dialogue: 0,0:02:20.80,0:02:23.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia berbeda dari katana pada umumnya.
Dialogue: 0,0:02:23.81,0:02:25.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya begitu.
Dialogue: 0,0:02:25.56,0:02:27.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya, akan langsung kupatahkan!
Dialogue: 0,0:02:56.42,0:02:57.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hidari!
Dialogue: 0,0:02:58.21,0:02:59.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja.
Dialogue: 0,0:02:59.92,0:03:02.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti bawa aku ke toko peralatan.
Dialogue: 0,0:03:02.39,0:03:05.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Toko peralatan? Buat apa?
Dialogue: 0,0:03:05.56,0:03:09.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sana ada lem perekat buat batu, kan?
Dialogue: 0,0:03:09.27,0:03:11.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, bisa pakai itu?
Dialogue: 0,0:03:11.39,0:03:12.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami terbuat dari batu.
Dialogue: 0,0:03:13.69,0:03:16.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski butuh waktu untuk pulih,
Dialogue: 0,0:03:16.11,0:03:18.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tangan dan kaki putus\Ntidak bikin kami mati.
Dialogue: 0,0:03:18.44,0:03:19.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ngawur.{\i0}
Dialogue: 0,0:03:19.94,0:03:21.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, merepotkan.
Dialogue: 0,0:03:21.95,0:03:23.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harus apa biar kalian mati?
Dialogue: 0,0:03:24.16,0:03:26.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang merepotkan itu Tsugai-mu!
Dialogue: 0,0:03:26.03,0:03:28.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dipatahkan malah tumbuh lagi.
Dialogue: 0,0:03:31.79,0:03:33.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hidari.
Dialogue: 0,0:03:34.04,0:03:35.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katana itu
Dialogue: 0,0:03:36.00,0:03:39.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bau darahnya sangat pekat.
Dialogue: 0,0:03:39.59,0:03:40.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajar.
Dialogue: 0,0:03:41.42,0:03:42.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat saja mayat-mayat…
Dialogue: 0,0:03:46.30,0:03:50.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu telah\Nmembunuh banyak sekali orang, ya.
Dialogue: 0,0:03:51.02,0:03:53.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, itulah pekerjaanku.
Dialogue: 0,0:03:53.65,0:03:59.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asalkan dibayar,\NAku siap menebas manusia maupun Tsugai.
Dialogue: 0,0:04:01.03,0:04:02.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baunya masih baru.
Dialogue: 0,0:04:03.61,0:04:07.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bau darah orang di belakangnya\Ndan darah warga Desa Higashi.
Dialogue: 0,0:04:08.28,0:04:12.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, ada yang tercium lagi.
Dialogue: 0,0:04:13.41,0:04:15.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami kenal betul aroma itu.
Dialogue: 0,0:04:16.54,0:04:20.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aroma darah orang tua Yuru,\NMine dan Nagisa!
Dialogue: 0,0:04:28.10,0:04:29.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana, Yuru?
Dialogue: 0,0:04:29.97,0:04:32.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau mencoba mati sekali?
Dialogue: 0,0:04:33.10,0:04:34.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mau membunuhku?
Dialogue: 0,0:04:35.35,0:04:39.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kupikir akan lebih elok\Nkalau kamu yang memilih sendiri.
Dialogue: 0,0:04:40.65,0:04:42.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini perintah Kepala Klan Kagemori?
Dialogue: 0,0:04:42.74,0:04:46.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, Ayah dan aku berbeda pendapat.
Dialogue: 0,0:04:46.99,0:04:50.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Metode mereka terlalu lembek.
Dialogue: 0,0:04:50.37,0:04:52.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang ini adalah Shingo.
Dialogue: 0,0:04:52.87,0:04:54.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak dari ibuku.
Dialogue: 0,0:04:58.50,0:05:01.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah tidak bisa pulang kampung, kan?
Dialogue: 0,0:05:02.80,0:05:06.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang tuamu kabur dari desa, adikmu juga.
Dialogue: 0,0:05:06.63,0:05:10.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan dia sempat dibunuh\Npihak Desa Higashi.
Dialogue: 0,0:05:10.68,0:05:13.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyawamu juga sering diincar.
Dialogue: 0,0:05:14.06,0:05:18.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Desa Higashi sudah bukan lagi tempatmu.
Dialogue: 0,0:05:19.77,0:05:22.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sini, gabung Klan Shingo saja.
Dialogue: 0,0:05:23.07,0:05:24.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kami tidak akan jahat padamu.
Dialogue: 0,0:05:25.57,0:05:30.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Habis menyandera anak desa dan berharap\Naku mati, masih minta dipercaya?
Dialogue: 0,0:05:30.78,0:05:33.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami butuh sandera\Nbiar kamu tidak berontak!
Dialogue: 0,0:05:34.87,0:05:36.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jangan khawatir.{\i0}
Dialogue: 0,0:05:37.00,0:05:40.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Asa palsu\Ndan anak desa itu memang diawasi.{\i0}
Dialogue: 0,0:05:40.21,0:05:43.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tapi kami tidak menyakiti mereka.{\i0}
Dialogue: 0,0:05:43.71,0:05:46.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memang ingin kamu mati.
Dialogue: 0,0:05:46.76,0:05:48.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi tetap saja…
Dialogue: 0,0:05:48.68,0:05:50.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paman, jaga bahasamu.
Dialogue: 0,0:05:51.51,0:05:54.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami butuh persetujuanmu, oke?
Dialogue: 0,0:05:54.43,0:05:55.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke gundulmu!
Dialogue: 0,0:05:56.35,0:06:00.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya, kamu kenal dukun gemuk itu, kan?
Dialogue: 0,0:06:00.23,0:06:01.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudmu, Yama?
Dialogue: 0,0:06:02.48,0:06:04.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kadang dia ke desa dan mengobati warga.
Dialogue: 0,0:06:05.57,0:06:09.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dialah yang mengirim para bandit\Nuntuk membunuhmu.
Dialogue: 0,0:06:11.07,0:06:16.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Tadera yang jadi walimu pun\Nsering mampir ke tokonya.
Dialogue: 0,0:06:16.58,0:06:18.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Sulit dipercaya, kan?
Dialogue: 0,0:06:19.50,0:06:23.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang dewasa di Desa Higashi\Nmerahasiakan soal Fuu
Dialogue: 0,0:06:23.25,0:06:26.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sambil diam-diam mengincar nyawamu.
Dialogue: 0,0:06:26.51,0:06:29.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Percuma peduli sama mereka.
Dialogue: 0,0:06:29.38,0:06:31.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tinggalkan saja semuanya!
Dialogue: 0,0:06:31.39,0:06:33.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak butuh desa itu!
Dialogue: 0,0:06:35.60,0:06:40.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bilang begitu, Paman.
Dialogue: 0,0:06:41.19,0:06:44.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada yang percuma di dunia ini.
Dialogue: 0,0:06:46.32,0:06:50.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}"Dunia tidak membutuhkanmu."{\i0}
Dialogue: 0,0:06:50.07,0:06:54.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul, Kai dan Fuu\Nmemang dihasilkan Desa Higashi.
Dialogue: 0,0:06:55.83,0:06:58.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan harus tetap begitu.
Dialogue: 0,0:06:58.75,0:07:03.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski satu klan, kalian tidak sepemikiran?
Dialogue: 0,0:07:03.71,0:07:08.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Desa Higashi dan Klan Kagemori saja\Ntidak semuanya sejalan,
Dialogue: 0,0:07:08.59,0:07:11.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Klan Shingo juga sama saja.
Dialogue: 0,0:07:11.97,0:07:17.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa bahaya kalau semuanya sependapat.
Dialogue: 0,0:07:17.27,0:07:21.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Pemilik kekuatan\Nistimewa harus mengerahkan
Dialogue: 0,0:07:21.39,0:07:23.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kemampuannya di bawah pihak yang tepat".
Dialogue: 0,0:07:23.90,0:07:27.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Klan Shingo sepakat di gagasan itu.
Dialogue: 0,0:07:27.86,0:07:32.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mau bergabung, sebisa mungkin\Nakan kukabulkan semua keinginanmu.
Dialogue: 0,0:07:33.36,0:07:37.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau uang atau apa pun tinggal bilang.
Dialogue: 0,0:07:39.58,0:07:43.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum ada yang berubah\Nsejak di wisma Kagemori.
Dialogue: 0,0:07:44.00,0:07:47.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma ingin hidup normal.
Dialogue: 0,0:07:47.88,0:07:51.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berburu,\Nbercocok tanam, dan membuat arang.
Dialogue: 0,0:07:51.55,0:07:53.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hidup seperti biasanya.
Dialogue: 0,0:07:54.64,0:07:58.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin segera menemukan Ayah dan Ibu.
Dialogue: 0,0:08:01.60,0:08:02.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asa juga…
Dialogue: 0,0:08:04.10,0:08:05.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asa juga
Dialogue: 0,0:08:05.81,0:08:09.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ingin kubebaskan dari hidup\Nyang bagaikan dalam sangkar.
Dialogue: 0,0:08:11.78,0:08:16.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku cuma ingin hidup damai sekeluarga.
Dialogue: 0,0:08:17.95,0:08:21.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu membunuh orang tua Yuru, ya?
Dialogue: 0,0:08:21.83,0:08:27.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah pelakunya kamu\Natau pemilik terdahulu Tsugai itu.
Dialogue: 0,0:08:28.21,0:08:31.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Intinya darah Mine dan Nagisa\Ntercium dari situ.
Dialogue: 0,0:08:35.18,0:08:38.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ingat, korbanku kebanyakan, sih.
Dialogue: 0,0:08:39.43,0:08:40.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jawab yang benar!
Dialogue: 0,0:08:42.23,0:08:44.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanya saja Tsugai-ku.
Dialogue: 0,0:08:44.98,0:08:46.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dera, carilah Yuru.
Dialogue: 0,0:08:48.06,0:08:51.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka akan kami tangkap hidup-hidup.
Dialogue: 0,0:08:51.94,0:08:53.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai hadiah buat Yuru.
Dialogue: 0,0:08:55.61,0:08:56.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:08:58.91,0:08:59.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asal banget…
Dialogue: 0,0:08:59.95,0:09:02.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dadah, si cabul di tengah malam!
Dialogue: 0,0:09:04.66,0:09:06.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Sialan!{\i0}
Dialogue: 0,0:09:06.42,0:09:10.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Setelah memancing ke tempat silau\Nmalah mematikan lampu.{\i0}
Dialogue: 0,0:09:12.63,0:09:17.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Penjaga Ilahi Sayuu bisa melihat\Ndalam gelap lewat penciumannya.{\i0}
Dialogue: 0,0:09:17.09,0:09:19.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ah, merepotkan.{\i0}
Dialogue: 0,0:09:23.35,0:09:26.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Meski setuju buat mencari Yuru,{\i0}
Dialogue: 0,0:09:26.10,0:09:28.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}aku harus cari ke mana?{\i0}
Dialogue: 0,0:09:29.77,0:09:32.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bahkan belum tentu dia di area ini.{\i0}
Dialogue: 0,0:09:36.07,0:09:36.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadera, ya?
Dialogue: 0,0:09:37.66,0:09:39.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, kamu si Bandit?
Dialogue: 0,0:09:40.37,0:09:41.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak mati?
Dialogue: 0,0:09:41.41,0:09:44.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak! Tapi bandit yang lain mati.
Dialogue: 0,0:09:45.08,0:09:47.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bertemu pengguna Tsugai katana?
Dialogue: 0,0:09:47.25,0:09:49.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, dia kuat banget.
Dialogue: 0,0:09:50.42,0:09:52.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu ada di sini?
Dialogue: 0,0:09:52.71,0:09:55.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya kamu tidak tahu soal ini.
Dialogue: 0,0:09:55.84,0:09:58.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si Penggali Kubur bilang-bilang, ya?
Dialogue: 0,0:09:58.22,0:10:00.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, Hana? Dia kenapa?
Dialogue: 0,0:10:01.68,0:10:05.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Salah satu bandit telah memberitahuku.{\i0}
Dialogue: 0,0:10:06.35,0:10:08.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sayangnya dia mati di gudang.{\i0}
Dialogue: 0,0:10:09.10,0:10:12.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Sial, mulutnya ember banget, sih!
Dialogue: 0,0:10:12.65,0:10:14.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mayat tidak bisa klarifikasi.{\i0}
Dialogue: 0,0:10:15.07,0:10:19.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yuru juga datang untuk menolong\NAsa palsu dan anak desa.
Dialogue: 0,0:10:19.03,0:10:20.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi dia diculik Tsugai yang mirip gagak.
Dialogue: 0,0:10:20.99,0:10:21.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dicul--
Dialogue: 0,0:10:21.95,0:10:24.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sinting, ya? Kenapa Yuru dibawa?
Dialogue: 0,0:10:25.58,0:10:28.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua pihak ingin Yuru mati.
Dialogue: 0,0:10:28.66,0:10:32.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yuru juga mati-matian\Nmencari hal yang bisa percaya.
Dialogue: 0,0:10:32.79,0:10:36.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia juga sudah tahu soal kalian\Npara bandit
Dialogue: 0,0:10:36.09,0:10:38.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang mengincar nyawanya.
Dialogue: 0,0:10:38.17,0:10:40.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu juga pihak kami, Tadera!
Dialogue: 0,0:10:41.64,0:10:44.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang malah mau memihak Yuru?
Dialogue: 0,0:10:44.06,0:10:45.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:10:45.39,0:10:48.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah merahasiakan ini itu darinya,
Dialogue: 0,0:10:48.85,0:10:52.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yuru pasti tidak akan\Nmemercayaiku sepenuhnya.
Dialogue: 0,0:10:52.81,0:10:54.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, ceritanya panjang.
Dialogue: 0,0:10:55.52,0:10:58.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski awalnya mematuhi tugas,
Dialogue: 0,0:10:58.28,0:11:00.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sekarang aku berubah pikiran.
Dialogue: 0,0:11:00.82,0:11:03.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mengkhianati Desa Higashi?
Dialogue: 0,0:11:03.20,0:11:04.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan begitu.
Dialogue: 0,0:11:05.41,0:11:07.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama kalian tidak mengusik Yuru,
Dialogue: 0,0:11:08.00,0:11:10.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan tetap duduk manis.
Dialogue: 0,0:11:10.29,0:11:12.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah 400 tahun kita menunggu!
Dialogue: 0,0:11:12.75,0:11:16.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ada Kai dan Fuu,\NDesa Higashi bisa menaklukkan dunia!
Dialogue: 0,0:11:18.30,0:11:21.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau jadi pria tua\Nyang mengorbankan
Dialogue: 0,0:11:21.13,0:11:24.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}nyawa dua bocah demi kekuasaan, tahu!
Dialogue: 0,0:11:35.40,0:11:38.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita lanjut nanti saja,\Nayo cari Yuru dulu.
Dialogue: 0,0:11:41.53,0:11:45.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebelum kemari,\Nkami menelusuri pemilik gudang ini.
Dialogue: 0,0:11:45.87,0:11:46.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu bagaimana?
Dialogue: 0,0:11:47.49,0:11:51.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemiliknya TT Logistik,\Nanak perusahaan Shingo Kargo.
Dialogue: 0,0:11:52.67,0:11:56.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Klan Kagemori\Nmasih kerabatnya Klan Shingo.
Dialogue: 0,0:11:56.34,0:12:00.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari jalur ibunya putra kedua, Asuma.
Dialogue: 0,0:12:00.34,0:12:03.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami punya semua daftar properti\Natas nama Shingo.
Dialogue: 0,0:12:04.14,0:12:07.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}TT Logistik, Kibushi Industri, dll.
Dialogue: 0,0:12:07.81,0:12:09.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, banyak juga.
Dialogue: 0,0:12:10.22,0:12:12.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo cek satu-satu.
Dialogue: 0,0:12:12.06,0:12:16.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Yuru diculik Tsugai,\Nkemungkinan mereka berdekatan.
Dialogue: 0,0:12:17.31,0:12:19.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Mencari Tsugai, ya, pakai Tsugai.
Dialogue: 0,0:12:20.90,0:12:22.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini Tsugai-ku, Gagak Mini.
Dialogue: 0,0:12:22.99,0:12:24.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Kanimata.
Dialogue: 0,0:12:24.70,0:12:26.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Uchimata.
Dialogue: 0,0:12:26.66,0:12:27.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sip, salam kenal.
Dialogue: 0,0:12:28.58,0:12:31.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian, bantu aku mencari Tsugai.
Dialogue: 0,0:12:31.87,0:12:33.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap!
Dialogue: 0,0:12:34.71,0:12:36.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak punya Tsugai?
Dialogue: 0,0:12:36.79,0:12:38.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, aku kurang berguna.
Dialogue: 0,0:12:39.59,0:12:44.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bisa melihat mereka,\Nkamu pernah punya Tsugai, kan?
Dialogue: 0,0:12:44.22,0:12:46.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa tidak cari yang baru?
Dialogue: 0,0:12:46.97,0:12:48.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:12:51.31,0:12:53.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti saja kalau ada yang cocok.
Dialogue: 0,0:13:17.17,0:13:19.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mulai terbiasa dalam gelap.
Dialogue: 0,0:13:19.21,0:13:21.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan malah diam, Nyet!
Dialogue: 0,0:13:21.88,0:13:25.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masalahnya mereka\Ntidak berniat membunuhku.
Dialogue: 0,0:13:25.84,0:13:29.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ada niat membunuhnya\Nakan lebih mudah kubaca.
Dialogue: 0,0:13:30.55,0:13:33.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma menantang Hidari, lo.
Dialogue: 0,0:13:33.27,0:13:35.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok Migi ikut-ikutan?
Dialogue: 0,0:13:35.73,0:13:40.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak berperikemanusiaan!\NBikin malu tuan kalian!
Dialogue: 0,0:13:40.27,0:13:41.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang bukan manusia.
Dialogue: 0,0:13:41.94,0:13:43.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yuru juga tidak akan keberatan.
Dialogue: 0,0:13:44.78,0:13:45.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dasar barbar.{\i0}
Dialogue: 0,0:13:46.49,0:13:52.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku ingin bertarung di luar,\Ntapi kedua jalan keluarnya dijaga.{\i0}
Dialogue: 0,0:13:52.70,0:13:55.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mereka mau mengurungku di sini, ya.{\i0}
Dialogue: 0,0:13:56.33,0:14:01.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sial,\Ntahu begini mayatnya kusingkirkan dulu.{\i0}
Dialogue: 0,0:14:01.00,0:14:03.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mayat dan kegelapan ini bikin repot.{\i0}
Dialogue: 0,0:14:04.26,0:14:05.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus keluar.
Dialogue: 0,0:14:11.76,0:14:13.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hargailah orang mati.
Dialogue: 0,0:14:26.61,0:14:27.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah.
Dialogue: 0,0:14:28.49,0:14:30.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bulannya indah, ya.
Dialogue: 0,0:14:32.03,0:14:35.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa saja ini purnama terakhirmu.
Dialogue: 0,0:14:35.95,0:14:36.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nikmatilah.
Dialogue: 0,0:14:38.41,0:14:41.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu juga, nikmatilah selagi bisa.
Dialogue: 0,0:14:48.88,0:14:50.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awas! Hidari!
Dialogue: 0,0:14:57.31,0:14:59.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Migi.
Dialogue: 0,0:14:59.64,0:15:01.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama-sama.
Dialogue: 0,0:15:02.35,0:15:06.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mau nyawa Hidari,\Nlangkahi dulu mayatku.
Dialogue: 0,0:15:06.03,0:15:07.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Okelah kalau begitu.
Dialogue: 0,0:15:17.87,0:15:20.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rela ditebas demi serangan balik, ya?
Dialogue: 0,0:15:31.43,0:15:34.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihai sekali menghindarnya.
Dialogue: 0,0:15:34.68,0:15:36.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jarak serang kita sudah terbaca.
Dialogue: 0,0:15:39.52,0:15:44.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pukulan kiri, Hidari tidak akan sampai\Nkalau aku mundur sedikit.{\i0}
Dialogue: 0,0:15:44.86,0:15:46.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Lalu tangan kirinya akan kutebas.{\i0}
Dialogue: 0,0:15:52.61,0:15:56.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bisa-bisanya pakai tangan putus\Nbuat memperluas jangkauan.{\i0}
Dialogue: 0,0:16:00.75,0:16:03.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mulai kelelahan.
Dialogue: 0,0:16:04.29,0:16:06.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar lemah, jangan cupu!
Dialogue: 0,0:16:06.79,0:16:11.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kaki kananku yang kamu tusuk\Nmasih sakit, tahu, Shokyo.
Dialogue: 0,0:16:11.30,0:16:13.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luka kecil saja cengeng, Nyet!
Dialogue: 0,0:16:14.30,0:16:15.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ivan.
Dialogue: 0,0:16:15.22,0:16:18.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lah, dia bicara! Ada apa, Daikyo?
Dialogue: 0,0:16:18.76,0:16:20.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang datang.
Dialogue: 0,0:16:22.56,0:16:24.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesuatu yang berbahaya.
Dialogue: 0,0:16:26.02,0:16:27.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu ceritanya.
Dialogue: 0,0:16:29.23,0:16:30.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa, sih?
Dialogue: 0,0:16:30.73,0:16:33.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benaran, soalnya…
Dialogue: 0,0:16:33.24,0:16:34.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:16:38.24,0:16:42.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Izin bertanya,\Nini kantor Shingo Kargo, ya?
Dialogue: 0,0:16:43.41,0:16:44.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan.
Dialogue: 0,0:16:44.96,0:16:47.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Ini Kibushi Industri.
Dialogue: 0,0:16:47.84,0:16:50.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian anak perusahaan Shingo Kargo, kan?
Dialogue: 0,0:16:50.92,0:16:55.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah, paruh waktu sepertiku\Nkurang tahu soal itu.
Dialogue: 0,0:16:55.59,0:16:59.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Hei, kumpulkan orang, ada Kagemori…\N- Jangan pura-pura bodoh.
Dialogue: 0,0:17:02.14,0:17:03.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:17:05.10,0:17:07.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lanjutkan teleponnya.
Dialogue: 0,0:17:14.65,0:17:18.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Panggil semua temanmu,\Nakan kulayani sekaligus!
Dialogue: 0,0:17:21.16,0:17:22.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian kenapa?
Dialogue: 0,0:17:22.91,0:17:25.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gagak Mini merinding, tuh.
Dialogue: 0,0:17:29.08,0:17:32.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya ada bahaya mendekat.
Dialogue: 0,0:17:41.56,0:17:43.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan pak tua ini?
Dialogue: 0,0:17:44.56,0:17:46.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minggir! Dia pengguna Tsugai!
Dialogue: 0,0:17:46.98,0:17:48.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bang Hebota!
Dialogue: 0,0:17:48.52,0:17:50.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia Hebota si Pengguna Tsugai!
Dialogue: 0,0:17:50.65,0:17:52.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian bukan tandingannya.
Dialogue: 0,0:17:52.61,0:17:55.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tsugai harus dilawan pakai Tsugai!
Dialogue: 0,0:17:55.44,0:17:57.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maju, Tsugai-ku!
Dialogue: 0,0:17:59.07,0:18:00.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:18:05.04,0:18:07.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bang Hebota!
Dialogue: 0,0:18:07.71,0:18:08.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa ini?
Dialogue: 0,0:18:08.75,0:18:10.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang terjadi?
Dialogue: 0,0:18:10.58,0:18:13.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang punya Tsugai, habisi pak tua itu!
Dialogue: 0,0:18:13.25,0:18:15.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Itu mustahil!
Dialogue: 0,0:18:17.38,0:18:20.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tsugai-nya tidak terhitung!
Dialogue: 0,0:18:35.61,0:18:37.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bunyi apa…
Dialogue: 0,0:18:44.28,0:18:45.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hup!
Dialogue: 0,0:18:50.42,0:18:53.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pria tua asing sedang latihan tinju,{\i0}
Dialogue: 0,0:18:53.25,0:18:57.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}tiap pukulannya merusak bangunan.{\i0}
Dialogue: 0,0:18:59.51,0:19:01.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo, kantor pusat.
Dialogue: 0,0:19:01.18,0:19:03.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku minta libur\Nkarena mulai berhalusinasi.
Dialogue: 0,0:19:03.55,0:19:07.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Hah? Enak saja minta libur.{\i0}
Dialogue: 0,0:19:08.89,0:19:10.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar jahat!
Dialogue: 0,0:19:18.53,0:19:21.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, Kepala Klan Kagemori datang!
Dialogue: 0,0:19:21.32,0:19:22.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada Kagemori Gonzou?
Dialogue: 0,0:19:23.49,0:19:27.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kacau, Gagak Mini-ku jadi bingung\Nsaking banyaknya Tsugai!
Dialogue: 0,0:19:28.12,0:19:31.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bakal susah melacak Yuru, nih.
Dialogue: 0,0:19:33.58,0:19:35.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini?
Dialogue: 0,0:19:36.50,0:19:40.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya kayak wisma Kagemori\Nberjalan kemari.
Dialogue: 0,0:19:45.55,0:19:48.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Betul, hitamkan bagian yang bertanda X.
Dialogue: 0,0:19:49.39,0:19:50.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini?
Dialogue: 0,0:19:50.73,0:19:53.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, kamu sangat terampil.
Dialogue: 0,0:19:54.10,0:19:58.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski bilang tidak bisa menggambar,\Nternyata kamu berbakat.
Dialogue: 0,0:19:58.98,0:20:01.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, masa, sih?
Dialogue: 0,0:20:01.45,0:20:05.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mandi dulu,\Ntolong lanjutkan seperti tadi.
Dialogue: 0,0:20:05.16,0:20:06.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:20:14.08,0:20:16.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, ada yang aneh.
Dialogue: 0,0:20:16.00,0:20:19.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok aku malah jadi asisten komikus?
Dialogue: 0,0:20:19.42,0:20:20.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kangen Kakak.
Dialogue: 0,0:20:21.55,0:20:26.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke depannya, kamu mau mencari nafkah\Nsebagai asisten Hagure Sensei?
Dialogue: 0,0:20:26.64,0:20:28.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Punya cita-cita lain, tidak?
Dialogue: 0,0:20:28.72,0:20:30.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kangen Kakak.
Dialogue: 0,0:20:30.35,0:20:31.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, oke.
Dialogue: 0,0:20:36.06,0:20:37.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo.
Dialogue: 0,0:20:37.36,0:20:39.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kangen Kakak.
Dialogue: 0,0:20:39.73,0:20:42.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pindah tempat dulu,\Ndi sini agak berisik.
Dialogue: 0,0:20:43.49,0:20:45.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Iya, ini di tempat kerja.
Dialogue: 0,0:20:46.41,0:20:48.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Iya, tenang saja.
Dialogue: 0,0:20:48.62,0:20:51.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Sudah ada solusi\Nsoal biaya rumah sakit Ibu.
Dialogue: 0,0:20:51.41,0:20:52.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Percayakan pada Kakak.
Dialogue: 0,0:20:59.25,0:21:01.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gabuchan, ayo istirahat…
Dialogue: 0,0:21:02.38,0:21:05.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Oh, iya, dia sedang pergi.
Dialogue: 0,0:21:07.09,0:21:09.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo? Kok sendirian?
Dialogue: 0,0:21:09.93,0:21:13.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biasanya bareng Gabuchan terus,
Dialogue: 0,0:21:13.10,0:21:15.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tumben kamu sendirian.
Dialogue: 0,0:21:16.06,0:21:17.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:21:17.65,0:21:20.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akibat kecolongan tempo hari,
Dialogue: 0,0:21:20.77,0:21:23.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di dalam wisma pun kita harus waspada.
Dialogue: 0,0:21:24.15,0:21:26.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau aku temani?
Dialogue: 0,0:21:27.32,0:21:28.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akio.
Dialogue: 0,0:21:29.37,0:21:32.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benda apa yang kamu sembunyikan?
Dialogue: 0,0:21:34.71,0:21:36.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akio?
Dialogue: 0,0:21:38.25,0:21:41.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eng, aku mau sendirian saja.
Dialogue: 0,0:21:42.00,0:21:43.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa, kok!
Dialogue: 0,0:21:43.63,0:21:45.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhenti, jangan lanjut!
Dialogue: 0,0:21:46.51,0:21:48.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menjauhlah, Akio!
Dialogue: 0,0:21:51.60,0:21:54.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kalau mendekat…{\i0}
Dialogue: 0,0:23:28.94,0:23:30.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tangkapan besar.{\i0}
Dialogue: 0,0:23:30.45,0:23:35.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dulu sudah terbukti\Nsiapa yang lebih kuat, kan?{\i0}
Dialogue: 0,0:23:35.20,0:23:37.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tidak bagus kalau perempuan\Npandai berbohong.{\i0}
