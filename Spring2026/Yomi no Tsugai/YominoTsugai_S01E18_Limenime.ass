Dialogue: 0,0:08:17.66,0:08:19.91,sign,,0000,0000,0000,,RUANG KHUSUS STAF
Dialogue: 0,0:21:46.26,0:21:48.43,sign,,0000,0000,0000,,DECAKAN YANG MENGGELEGAR
Dialogue: 0,0:23:27.65,0:23:28.94,sign,,0000,0000,0000,,EPISODE SELANJUTNYA
Dialogue: 0,0:00:26.94,0:00:31.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asap panjang dan asap pendek ini\Nbisa dipakai menyampaikan pesan.
Dialogue: 0,0:00:34.07,0:00:34.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Datanglah.
Dialogue: 0,0:00:36.45,0:00:37.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kabur.
Dialogue: 0,0:00:38.91,0:00:40.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong.
Dialogue: 0,0:00:40.91,0:00:42.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu ada di mana?
Dialogue: 0,0:00:43.41,0:00:44.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada musuh.
Dialogue: 0,0:00:46.92,0:00:50.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan! Cepat matikan asapnya!
Dialogue: 0,0:00:50.38,0:00:51.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:00:52.42,0:00:56.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengajarkan Asa sinyal asap\Nsemisal kita terpisah nanti.
Dialogue: 0,0:00:56.43,0:00:57.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlalu mencolok!
Dialogue: 0,0:00:57.76,0:01:03.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya, bagaimana cara orang\Ndataran rendah saling mengabari dari jauh?
Dialogue: 0,0:01:06.10,0:01:08.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pakai benda bernama ponsel.
Dialogue: 0,0:01:08.98,0:01:13.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, mungkin tidak akan menyala\Nmeski dayanya aku isi.
Dialogue: 0,0:01:15.07,0:01:17.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu, apa ini?
Dialogue: 0,0:01:17.20,0:01:21.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini benda yang kubawa\Nwaktu tersasar ke Desa Higashi.
Dialogue: 0,0:01:21.95,0:01:27.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Meski ingin menelepon layanan darurat,\Ntidak ada telepon umum sama sekali.{\i0}
Dialogue: 0,0:01:27.54,0:01:31.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Selagi aku terkurung di desa,\Ndunia malah makin ribet.{\i0}
Dialogue: 0,0:01:32.05,0:01:34.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kartu transportasiku\Npun kayaknya diblokir.
Dialogue: 0,0:01:35.47,0:01:38.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Setidaknya mata uang masih sama, kan?
Dialogue: 0,0:01:39.84,0:01:42.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami harus secepatnya\Nminta perlindungan ke pos polisi.
Dialogue: 0,0:01:43.39,0:01:46.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tapi ini masih kawasan Desa Higashi.{\i0}
Dialogue: 0,0:01:47.44,0:01:51.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Antek Desa Higashi bisa muncul kapan saja.{\i0}
Dialogue: 0,0:01:51.73,0:01:54.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan juga, Yuru masih…
Dialogue: 0,0:01:56.78,0:01:58.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah, Ibu.
Dialogue: 0,0:01:59.49,0:02:01.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tidak pergi menjemput Kakak?
Dialogue: 0,0:02:02.62,0:02:06.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah mengajari Yuru\Ncara bertahan hidup.
Dialogue: 0,0:02:07.33,0:02:09.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Percayalah pada kemampuannya.
Dialogue: 0,0:02:12.50,0:02:14.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana ini?
Dialogue: 0,0:02:14.13,0:02:17.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku takut dia malah dikurung seperti Asa.
Dialogue: 0,0:02:19.84,0:02:21.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lah, ada orang.
Dialogue: 0,0:02:23.76,0:02:25.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajah mereka asing.
Dialogue: 0,0:02:25.39,0:02:27.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tumben ada orang pakai kimono.
Dialogue: 0,0:02:27.68,0:02:29.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian orang mana?
Dialogue: 0,0:02:29.31,0:02:31.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}O-Orang Tokyo.
Dialogue: 0,0:02:31.60,0:02:34.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami sedang cosplay.
Dialogue: 0,0:02:34.23,0:02:35.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Koprek?
Dialogue: 0,0:02:35.40,0:02:40.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Niatnya mau foto pakai baju tradisional\Ndi tempat yang latarnya kuno,
Dialogue: 0,0:02:40.78,0:02:42.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi barang kami hilang.
Dialogue: 0,0:02:42.95,0:02:43.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nagisa.
Dialogue: 0,0:02:44.45,0:02:49.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di dataran rendah, kita dilarang\Npakai kekerasan apa pun alasannya, kan?
Dialogue: 0,0:02:53.59,0:02:57.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asal kalian menyerahkan Asa,\Nkami tidak akan main kasar.
Dialogue: 0,0:02:58.84,0:03:00.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kembalilah ke Desa Higashi.
Dialogue: 0,0:03:01.34,0:03:05.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya, cuma\Nkekerasan jalan keluarnya.
Dialogue: 0,0:03:05.85,0:03:06.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setuju.
Dialogue: 0,0:03:20.40,0:03:24.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Andaikan aku minta pertolongan sekarang.{\i0}
Dialogue: 0,0:03:25.12,0:03:29.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dunia akan heboh karena orang\Nyang sudah lama hilang di gunung{\i0}
Dialogue: 0,0:03:29.58,0:03:31.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}tiba-tiba muncul kembali.{\i0}
Dialogue: 0,0:03:32.25,0:03:34.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Semua mata pasti tertuju padaku.{\i0}
Dialogue: 0,0:03:35.46,0:03:40.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Itu sama saja seperti memberi tahu\Nlokasi Asa ke pihak Desa Higashi.{\i0}
Dialogue: 0,0:03:40.92,0:03:42.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Di mana tempat yang aman?{\i0}
Dialogue: 0,0:03:43.43,0:03:48.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Adakah cara melindungi Asa yang rapuh ini\Ndan Yuru yang kami tinggal di desa?{\i0}
Dialogue: 0,0:05:23.57,0:05:24.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah,
Dialogue: 0,0:05:25.07,0:05:28.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ponselku jadi korslet, deh.
Dialogue: 0,0:05:28.32,0:05:32.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Karena inilah aku tidak mau\Nasal memakai Raijin.
Dialogue: 0,0:05:33.87,0:05:36.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka Tsugai-ku, Fuujin dan Raijin.
Dialogue: 0,0:05:37.67,0:05:41.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Sesuai namanya,\NFuujin mengendalikan angin.
Dialogue: 0,0:05:41.25,0:05:43.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Dan Raijin mengendalikan petir.
Dialogue: 0,0:05:43.80,0:05:46.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salam kenal, Yuru.
Dialogue: 0,0:05:49.55,0:05:52.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bos Shingo jadi tidak bisa dihubungi!
Dialogue: 0,0:05:52.56,0:05:54.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana bisa?
Dialogue: 0,0:05:54.18,0:05:57.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya ini ulah bocah itu!
Dialogue: 0,0:05:57.31,0:06:01.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia menyuruhku melepaskan sanderanya\Nkalau mau Bos selamat.
Dialogue: 0,0:06:01.86,0:06:05.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu ada suara batuk-batuk\Ndan teleponnya putus.
Dialogue: 0,0:06:05.11,0:06:07.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Panggilanku juga tidak terhubung.
Dialogue: 0,0:06:08.61,0:06:11.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat kirim beberapa orang ke lokasi Bos!
Dialogue: 0,0:06:11.66,0:06:13.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hubungi juga penjaga para sandera!
Dialogue: 0,0:06:15.54,0:06:17.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya? Ada apa?
Dialogue: 0,0:06:17.58,0:06:18.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Kamu ada di mana?{\i0}
Dialogue: 0,0:06:18.92,0:06:20.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Di dekat gerbang kedua.
Dialogue: 0,0:06:20.71,0:06:23.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bagus, itu dekat lokasi Bos.{\i0}
Dialogue: 0,0:06:23.50,0:06:26.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Cepat cek keadaannya!\NKami juga akan menyusul!{\i0}
Dialogue: 0,0:06:26.51,0:06:29.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengecek keadaan Bos Shingo?
Dialogue: 0,0:06:29.22,0:06:30.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia di mana?
Dialogue: 0,0:06:31.64,0:06:34.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, itu sangat dekat. Aku akan ke sana.
Dialogue: 0,0:06:35.18,0:06:38.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, memangnya apa yang terjadi?
Dialogue: 0,0:06:38.48,0:06:40.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia anak buah Shingo?
Dialogue: 0,0:06:40.23,0:06:41.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayaknya, sih.
Dialogue: 0,0:06:41.81,0:06:43.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, si kembar yang laki-laki?
Dialogue: 0,0:06:44.07,0:06:47.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar dia sangat liar.
Dialogue: 0,0:06:47.40,0:06:49.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau aku diserang?
Dialogue: 0,0:06:49.15,0:06:52.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, dia pasti ke tempatnya Yuru.
Dialogue: 0,0:06:53.62,0:06:54.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian bisa melakukannya?
Dialogue: 0,0:06:54.58,0:06:57.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang itu tidak punya Tsugai.
Dialogue: 0,0:06:57.45,0:06:59.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tidak akan ketahuan.
Dialogue: 0,0:06:59.83,0:07:02.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal baru mau makan.
Dialogue: 0,0:07:02.67,0:07:05.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jangan mengeluh!\NKamu bisa makan berkat Bos, tahu!{\i0}
Dialogue: 0,0:07:05.75,0:07:08.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, aku segera ke sana.
Dialogue: 0,0:07:18.68,0:07:21.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ada apa? Kok suaramu aneh? Woi!{\i0}
Dialogue: 0,0:07:22.35,0:07:26.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa, tadi ponselku cuma jatuh.
Dialogue: 0,0:07:26.27,0:07:28.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk memastikan,
Dialogue: 0,0:07:28.78,0:07:32.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tolong sebutkan lagi lokasinya Bos Shingo.
Dialogue: 0,0:07:32.61,0:07:37.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di lantai dua kantor TT Logistik, ya.
Dialogue: 0,0:07:37.62,0:07:40.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong sebutkan juga lokasi sanderanya.
Dialogue: 0,0:07:40.87,0:07:46.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sandera berada di ruang tamu\Nkantor Oedo Transport, ya.
Dialogue: 0,0:07:46.13,0:07:48.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, sampai nanti.
Dialogue: 0,0:07:50.17,0:07:53.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, ayo ke tempatnya Yuru dulu.
Dialogue: 0,0:07:53.22,0:07:54.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:07:54.64,0:07:58.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tsugai-mu menyeramkan sekali,\Npadahal bentuknya lucu.
Dialogue: 0,0:08:00.85,0:08:02.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu.
Dialogue: 0,0:08:02.10,0:08:04.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bisa mengendalikan si kembar
Dialogue: 0,0:08:04.31,0:08:06.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau mereka membangkang, ya?
Dialogue: 0,0:08:08.57,0:08:10.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pikiranmu berlebihan.
Dialogue: 0,0:08:10.36,0:08:13.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fokus saja dulu pada penyelamatan Yuru.
Dialogue: 0,0:08:22.04,0:08:24.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, Yozakura?
Dialogue: 0,0:08:24.17,0:08:25.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:08:26.21,0:08:27.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang datang.
Dialogue: 0,0:08:43.31,0:08:44.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi.
Dialogue: 0,0:08:47.48,0:08:48.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Ada perlu apa?
Dialogue: 0,0:08:48.73,0:08:53.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini. Aku disuruh mengecek kemari\Nkarena Bos tidak bisa dihubungi.
Dialogue: 0,0:08:54.07,0:08:56.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takutnya terjadi sesuatu.
Dialogue: 0,0:08:57.03,0:09:01.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untungnya tidak…
Dialogue: 0,0:09:07.25,0:09:08.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Yuru ketemu!{\i0}
Dialogue: 0,0:09:09.17,0:09:11.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ada Kagemori Asuma dan Tsugai tengkorak?{\i0}
Dialogue: 0,0:09:13.55,0:09:14.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Orang itu juga pengguna Tsugai!{\i0}
Dialogue: 0,0:09:14.72,0:09:17.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tsugai om ini pengendali petir dan angin!
Dialogue: 0,0:09:17.89,0:09:19.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fuujin!
Dialogue: 0,0:09:23.43,0:09:26.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia melepaskan tebasan angin!
Dialogue: 0,0:09:26.52,0:09:27.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Raijin!
Dialogue: 0,0:09:44.91,0:09:46.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:09:48.08,0:09:49.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yuru?
Dialogue: 0,0:09:49.79,0:09:51.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asuma, apa-apaan kamu?
Dialogue: 0,0:09:51.88,0:09:54.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Evakuasi darurat.
Dialogue: 0,0:09:54.67,0:09:59.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita susah payah menculik Yuru,\Nsayang kalau direbut kembali.
Dialogue: 0,0:09:59.64,0:10:01.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi aku memindahkannya.
Dialogue: 0,0:10:04.39,0:10:05.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}E-Eng…
Dialogue: 0,0:10:06.48,0:10:08.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami pergi saja kalau tidak ada Yuru.
Dialogue: 0,0:10:08.98,0:10:11.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf mengganggu, ya.
Dialogue: 0,0:10:13.15,0:10:14.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fuujin.
Dialogue: 0,0:10:18.40,0:10:19.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eits!
Dialogue: 0,0:10:20.99,0:10:21.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Tadera, kamu baik-baik saja?
Dialogue: 0,0:10:23.03,0:10:24.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lah, kok hilang?
Dialogue: 0,0:10:26.75,0:10:29.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial, bedebah itu kabur duluan!
Dialogue: 0,0:10:39.59,0:10:41.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Lajunya tidak secepat sebelumnya.{\i0}
Dialogue: 0,0:10:42.55,0:10:44.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Untung jadi gampang dikejar.{\i0}
Dialogue: 0,0:10:48.73,0:10:50.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku disuruh mengikutinya?{\i0}
Dialogue: 0,0:11:02.99,0:11:05.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Yuru, kamu baik-baik saja?\N- Dera.
Dialogue: 0,0:11:05.20,0:11:08.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, tadi aku kena petir.
Dialogue: 0,0:11:08.95,0:11:11.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baru bisa bergerak sekarang.
Dialogue: 0,0:11:11.08,0:11:12.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, apa tujuan dia?
Dialogue: 0,0:11:13.04,0:11:15.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, turunkan pistolmu.
Dialogue: 0,0:11:15.84,0:11:19.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia Yozakura, Tsugai milik Asuma.
Dialogue: 0,0:11:19.38,0:11:22.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia baik… Yah, anggap saja begitu.
Dialogue: 0,0:11:24.64,0:11:28.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu diculik,\Naku sempat berbicara dengannya.
Dialogue: 0,0:11:31.14,0:11:33.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini? Kumpulan ngengat?
Dialogue: 0,0:11:34.69,0:11:36.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf telah bertindak kasar.
Dialogue: 0,0:11:37.02,0:11:37.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bicara?
Dialogue: 0,0:11:38.07,0:11:41.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bicara,\Ntakutnya tingkat kecerdasanku ketahuan.
Dialogue: 0,0:11:42.07,0:11:45.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sengaja diam dan pura-pura bodoh.
Dialogue: 0,0:11:45.83,0:11:48.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Supaya Shingo Hayato tetap lengah.
Dialogue: 0,0:11:48.91,0:11:49.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shingo?
Dialogue: 0,0:11:50.04,0:11:51.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pamannya Asuma.
Dialogue: 0,0:11:51.83,0:11:54.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kutegaskan, Yuru.
Dialogue: 0,0:11:54.54,0:11:57.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuanku, Asuma bukanlah musuhmu.
Dialogue: 0,0:11:57.84,0:12:02.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asuma punya dendam kesumat\Npada Shingo Hayato.
Dialogue: 0,0:12:04.76,0:12:08.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kagemori Gonzou berniat\Nmengumpulkan bukti dari momen ini{\i0}
Dialogue: 0,0:12:08.89,0:12:13.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}untuk membasmi Shingo\Ndan para pengkhianat di dalam klan.{\i0}
Dialogue: 0,0:12:13.39,0:12:16.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Asuma ikut terlibat\Ndemi menjatuhkan Shingo.{\i0}
Dialogue: 0,0:12:18.02,0:12:21.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa Asuma sebenci itu pada Shingo?
Dialogue: 0,0:12:21.86,0:12:23.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal itu pamannya.
Dialogue: 0,0:12:23.65,0:12:28.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak masih kecil, Iori alias ibunya Asuma
Dialogue: 0,0:12:28.16,0:12:32.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}selalu dicap sebagai beban klan\Noleh Klan Shingo.
Dialogue: 0,0:12:32.75,0:12:35.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat Kepala Klan Kagemori yang\Nsangat berkuasa jatuh
Dialogue: 0,0:12:35.92,0:12:38.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}cinta pada wanita beban itu,
Dialogue: 0,0:12:38.25,0:12:41.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hebohnya luar biasa.
Dialogue: 0,0:12:42.51,0:12:48.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Shingo yang tamak memanfaatkan\Nhubungan dengan Kagemori{\i0}
Dialogue: 0,0:12:48.14,0:12:51.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}untuk mengembangkan usaha\Ndan memperkaya diri.{\i0}
Dialogue: 0,0:12:52.56,0:12:57.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Meski begitu dia sama sekali\Ntidak berterima kasih ke ibunya Asuma.{\i0}
Dialogue: 0,0:13:00.61,0:13:03.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Ketamakannya tidak terbatas.{\i0}
Dialogue: 0,0:13:04.61,0:13:08.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah tahu soal Kai dan Fuu\Nmelalui orang Kagemori,
Dialogue: 0,0:13:09.03,0:13:11.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia berusaha menguasainya juga.
Dialogue: 0,0:13:12.54,0:13:15.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaikan serangga yang mengerumuni cahaya.
Dialogue: 0,0:13:16.08,0:13:19.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, mirip dengan pihak Desa Higashi.
Dialogue: 0,0:13:19.92,0:13:21.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, deh.
Dialogue: 0,0:13:22.21,0:13:24.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski selalu di dekatnya,
Dialogue: 0,0:13:24.09,0:13:28.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kenapa kalian tidak mencoba\Nmembunuh Shingo?
Dialogue: 0,0:13:30.93,0:13:36.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kami Matahari dan Bulan\Nbukan tandingan Fuujin dan Raijin.{\i0}
Dialogue: 0,0:13:37.02,0:13:41.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kami bisa terbakar oleh petirnya\Ndan dilibas oleh anginnya.{\i0}
Dialogue: 0,0:13:42.07,0:13:44.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mustahil menang dari mereka.{\i0}
Dialogue: 0,0:13:45.44,0:13:47.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asuma tahu akan hal itu.
Dialogue: 0,0:13:48.07,0:13:50.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi dia pura-pura mematuhi Shingo.
Dialogue: 0,0:13:51.49,0:13:53.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asuma anak baik.
Dialogue: 0,0:13:53.29,0:13:57.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia terus menahan diri\Ndemi Asagiri dan aku.
Dialogue: 0,0:13:59.58,0:14:04.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski dibilang baik,\Nsenyumnya terlalu mencurigakan.
Dialogue: 0,0:14:04.38,0:14:09.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak itu.\NKenapa senyumannya kayak penjahat, ya.
Dialogue: 0,0:14:10.01,0:14:12.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Wajahnya bikin salah paham.{\i0}
Dialogue: 0,0:14:14.39,0:14:15.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu serius?
Dialogue: 0,0:14:15.93,0:14:18.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, baiklah.
Dialogue: 0,0:14:18.81,0:14:21.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kepala Klan Kagemori\Ndan Asa menuju kemari.
Dialogue: 0,0:14:21.36,0:14:22.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:14:22.65,0:14:25.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bos Shingo juga tidak bisa dihubungi.
Dialogue: 0,0:14:25.90,0:14:27.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa begini?
Dialogue: 0,0:14:27.24,0:14:28.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya…
Dialogue: 0,0:14:29.57,0:14:31.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bocah kembar itu…
Dialogue: 0,0:14:31.62,0:14:33.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menangkap Bos Shingo?
Dialogue: 0,0:14:33.49,0:14:35.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita disuruh membebaskan sandera.
Dialogue: 0,0:14:35.62,0:14:37.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lokasi kita belum ketahuan, kan?
Dialogue: 0,0:14:37.50,0:14:39.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya belum.
Dialogue: 0,0:15:20.50,0:15:21.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasanganku di dekat sini!
Dialogue: 0,0:15:21.75,0:15:23.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah!
Dialogue: 0,0:15:23.96,0:15:27.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, dia ditawan bersama anak dari desa.
Dialogue: 0,0:15:27.50,0:15:30.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia dijaga para pengguna Tsugai,\Nakan sulit untuk kabur.
Dialogue: 0,0:15:30.93,0:15:34.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waduh, mereka yang menyerang desamu?
Dialogue: 0,0:15:34.30,0:15:39.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya. Dia diculik dan dijadikan sandera\Nuntuk bernegosiasi dengan Yuru.
Dialogue: 0,0:15:39.43,0:15:43.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pantas saja dia tidak datang\Nmeski kita tunggu-tunggu.
Dialogue: 0,0:15:43.52,0:15:47.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan katanya, si kembar juga\Nkeduanya ada di dekat sini.
Dialogue: 0,0:15:47.27,0:15:49.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yuru dan Asa yang asli?
Dialogue: 0,0:15:50.19,0:15:51.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pas banget!
Dialogue: 0,0:15:51.78,0:15:53.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo minta tolong ke Penjaga Ilahi Sayuu!
Dialogue: 0,0:15:54.03,0:15:57.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya Penjaga Ilahi Sayuu\Nadalah teman kami!
Dialogue: 0,0:15:59.12,0:16:02.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin Asa membenci pasanganku.
Dialogue: 0,0:16:03.37,0:16:06.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan Yuru telah aku kecewakan.
Dialogue: 0,0:16:07.29,0:16:10.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mungkin minta tolong.
Dialogue: 0,0:16:10.21,0:16:12.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba saja dulu.
Dialogue: 0,0:16:12.22,0:16:16.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yuru pernah bilang ingin\Ncerita banyak hal kalau bertemu kamu.
Dialogue: 0,0:16:19.60,0:16:21.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pasti datang walau sedang marah.
Dialogue: 0,0:16:22.56,0:16:26.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, bagaimana cara mencari Yuru\Ntanpa ketahuan musuh?
Dialogue: 0,0:16:28.57,0:16:32.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Sejak tadi, banyak hawa Tsugai\Ndi sekitar sini.{\i0}
Dialogue: 0,0:16:32.70,0:16:34.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sulit membedakan kawan dan lawan.{\i0}
Dialogue: 0,0:16:34.61,0:16:38.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dan aku tidak tahu di mana\NPenjaga Ilahi Sayuu berada.{\i0}
Dialogue: 0,0:16:49.42,0:16:54.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf. Aku melibatkan kalian\Ntanpa penjelasan yang layak.
Dialogue: 0,0:16:54.80,0:16:58.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, setidaknya beri tahu kami lebih awal.
Dialogue: 0,0:16:59.14,0:17:03.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kami akan bekerja sama\Nkalau ada untungnya.
Dialogue: 0,0:17:03.23,0:17:06.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kita sering kontak,\Nbisa-bisa ketahuan Shingo.
Dialogue: 0,0:17:07.65,0:17:11.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin meminimalisasi informasi\Ndemi melindungi Asuma.
Dialogue: 0,0:17:12.07,0:17:16.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya lagi, Kagemori Jin juga bilang begitu.
Dialogue: 0,0:17:16.78,0:17:18.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku mengerti.
Dialogue: 0,0:17:18.78,0:17:22.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Musuh tahu Yuru ada\Ndi dataran rendah dan mengincarnya.
Dialogue: 0,0:17:22.66,0:17:26.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, dia cukup\Nkuat untuk menyandera
Dialogue: 0,0:17:26.33,0:17:29.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asa palsu dan anak dari Desa Higashi.
Dialogue: 0,0:17:30.00,0:17:33.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang tamak yang mempekerjakan\Nbanyak pengguna Tsugai.
Dialogue: 0,0:17:34.34,0:17:35.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti dia.
Dialogue: 0,0:17:35.38,0:17:36.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti.
Dialogue: 0,0:17:37.09,0:17:41.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kebetulan karena target kita sama,\Nkami akan membantu.
Dialogue: 0,0:17:43.27,0:17:45.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai jumpa di TKP.
Dialogue: 0,0:17:46.10,0:17:47.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pulanglah, Tadera.
Dialogue: 0,0:17:47.60,0:17:48.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei!
Dialogue: 0,0:17:49.23,0:17:52.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tidak menyusun rencana dulu?
Dialogue: 0,0:17:52.40,0:17:55.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya kita tidak sering kontak\Nbiar tidak ketahuan musuh.
Dialogue: 0,0:17:56.57,0:17:58.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesuaikan saja sama situasi nanti.
Dialogue: 0,0:17:59.32,0:18:00.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesuaikan?
Dialogue: 0,0:18:01.37,0:18:02.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada satu hal penting.
Dialogue: 0,0:18:02.99,0:18:05.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin kamu akan bertemu Asuma,
Dialogue: 0,0:18:05.79,0:18:07.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pura-puralah jadi musuhnya.
Dialogue: 0,0:18:07.66,0:18:11.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bukan musuh kita,\Njangan diserang kalau bertemu.
Dialogue: 0,0:18:13.05,0:18:15.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan ini dari Asa.
Dialogue: 0,0:18:15.21,0:18:16.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Foto.
Dialogue: 0,0:18:16.80,0:18:19.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong sampaikan pada si Abang.
Dialogue: 0,0:18:19.89,0:18:21.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitulah katanya.
Dialogue: 0,0:18:22.01,0:18:24.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Asal banget.\N- Berkaca sana.
Dialogue: 0,0:18:24.97,0:18:28.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baru-baru ini Shingo merekrut\Npengguna Tsugai yang hebat.
Dialogue: 0,0:18:29.98,0:18:33.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku makin hati-hati\Nkarena takut ketahuan olehnya.
Dialogue: 0,0:18:34.57,0:18:37.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pria pengguna Tsugai katana\Npanjang dan pendek.
Dialogue: 0,0:18:37.65,0:18:39.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhati-hatilah.
Dialogue: 0,0:18:39.40,0:18:40.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia…
Dialogue: 0,0:18:40.36,0:18:43.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Si cabul di tengah malam!\N- Yosano Ivan.
Dialogue: 0,0:18:43.28,0:18:44.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cabul?
Dialogue: 0,0:18:44.54,0:18:47.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lelaki yang berbuat mesum ke perempuan.
Dialogue: 0,0:18:48.12,0:18:51.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa diampuni, dia layak mati!
Dialogue: 0,0:18:51.46,0:18:53.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia wajib melakukan seppuku!
Dialogue: 0,0:18:53.25,0:18:57.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku masih belum paham kompas moralmu.
Dialogue: 0,0:18:57.80,0:18:59.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Si cabul itu…\N- Ivan!
Dialogue: 0,0:19:00.88,0:19:04.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sempat bertarung melawan si Ivan itu.
Dialogue: 0,0:19:04.43,0:19:06.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya dia tahu tentang orang tuamu.
Dialogue: 0,0:19:08.52,0:19:10.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Tapi dia mengelak dengan menyebalkan.
Dialogue: 0,0:19:13.73,0:19:17.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Penjaga Ilahi Sayuu sedang mencoba\Nmenangkapnya hidup-hidup.{\i0}
Dialogue: 0,0:19:22.41,0:19:23.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:19:23.82,0:19:26.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo bantu Penjaga Ilahi Sayuu, Dera.
Dialogue: 0,0:19:26.24,0:19:28.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke. Aku ambil senapan dulu.
Dialogue: 0,0:19:28.33,0:19:30.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yozakura bisa bantu…
Dialogue: 0,0:19:30.50,0:19:33.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma mematuhi perintah Asuma.
Dialogue: 0,0:19:33.38,0:19:35.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga.
Dialogue: 0,0:19:40.72,0:19:41.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sinyal asap.
Dialogue: 0,0:19:41.63,0:19:42.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:19:43.09,0:19:45.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu. Di sana.
Dialogue: 0,0:19:45.43,0:19:46.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana?
Dialogue: 0,0:19:48.35,0:19:49.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan kebakaran?
Dialogue: 0,0:19:49.81,0:19:53.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, aku yakin.\NDesa Higashi suka memakainya.
Dialogue: 0,0:19:53.73,0:19:57.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Danji dan aku sering bertukar pesan\Nantara gunung dan desa.
Dialogue: 0,0:19:58.78,0:20:01.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Butuh". "Bantuan".
Dialogue: 0,0:20:04.36,0:20:06.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Danji butuh bantuan.
Dialogue: 0,0:20:06.49,0:20:10.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bilang mau\Nmencari pasangannya di sini.
Dialogue: 0,0:20:10.41,0:20:13.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti, kalau dia ada di sini…
Dialogue: 0,0:20:13.71,0:20:14.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau ke mana duluan?
Dialogue: 0,0:20:17.38,0:20:21.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Menolong sandera?\NAtau petunjuk orang tuamu?{\i0}
Dialogue: 0,0:20:23.13,0:20:25.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku minta bantuan Yuru.{\i0}
Dialogue: 0,0:20:25.51,0:20:26.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bantuan Kakak?{\i0}
Dialogue: 0,0:20:26.89,0:20:30.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kuharap dia\Nmenyadarinya dan datang kemari.{\i0}
Dialogue: 0,0:20:30.31,0:20:32.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Akankah dia datang?{\i0}
Dialogue: 0,0:20:32.89,0:20:37.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Entahlah. Habisnya kita sudah menipu Yuru.{\i0}
Dialogue: 0,0:20:40.32,0:20:42.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Tenang saja, Azami.
Dialogue: 0,0:20:44.32,0:20:46.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kita pasti diselamatkan.
Dialogue: 0,0:20:46.45,0:20:48.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}- Sama siapa?\N- Kakakku.
Dialogue: 0,0:20:49.66,0:20:52.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak tidak akan mengabaikanmu.
Dialogue: 0,0:20:53.66,0:20:55.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Yuru…
Dialogue: 0,0:21:02.01,0:21:04.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kakak, hati-hati.{\i0}
Dialogue: 0,0:21:04.68,0:21:07.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mereka semua pengguna Tsugai.{\i0}
Dialogue: 0,0:21:09.60,0:21:11.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kamu!
Dialogue: 0,0:21:22.78,0:21:23.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seseorang!
Dialogue: 0,0:21:29.83,0:21:30.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak!
Dialogue: 0,0:21:30.99,0:21:32.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Yuru!
Dialogue: 0,0:21:32.83,0:21:36.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada sinyal asap yang minta bantuan.
Dialogue: 0,0:21:37.54,0:21:40.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma sedikit yang\Ntahu sinyal asap di sini.
Dialogue: 0,0:21:40.92,0:21:43.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kira Kakak yang mengirimnya.
Dialogue: 0,0:21:44.26,0:21:45.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cih!
Dialogue: 0,0:21:50.05,0:21:51.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Maaf.{\i0}
Dialogue: 0,0:21:53.06,0:21:54.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Yang datang malah yang seram.{\i0}
Dialogue: 0,0:23:29.57,0:23:30.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tangkap mereka.
Dialogue: 0,0:23:30.53,0:23:33.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Kenapa kamu tidak ke sana lebih dulu!{\i0}
Dialogue: 0,0:23:33.28,0:23:36.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Lengan mana yang kamu pakai\Nmenebas Ayah dan Ibu?{\i0}
Dialogue: 0,0:23:36.12,0:23:37.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Biar aku lubangi!{\i0}
