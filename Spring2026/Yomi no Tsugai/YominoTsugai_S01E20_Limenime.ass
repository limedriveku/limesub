Dialogue: 0,0:15:53.49,0:15:54.53,sign,,0000,0000,0000,,DILARANG BERISIK DI TAMAN
Dialogue: 0,0:21:22.48,0:21:24.07,sign,,0000,0000,0000,,BAKTI
Dialogue: 0,0:23:27.48,0:23:28.90,sign,,0000,0000,0000,,EPISODE SELANJUTNYA
Dialogue: 0,0:01:45.52,0:01:47.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Migi…\N- Hidari!
Dialogue: 0,0:01:48.35,0:01:49.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini gawat.
Dialogue: 0,0:01:50.44,0:01:52.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awas, Migi!
Dialogue: 0,0:01:52.19,0:01:54.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hidari adalah mangsaku!
Dialogue: 0,0:02:12.46,0:02:13.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial!
Dialogue: 0,0:02:14.34,0:02:17.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lincah sekali! Bukankah kakinya cedera?
Dialogue: 0,0:02:23.76,0:02:25.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dera, tembak dia!
Dialogue: 0,0:02:40.91,0:02:41.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yuru!
Dialogue: 0,0:02:50.04,0:02:51.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yuru!
Dialogue: 0,0:02:51.00,0:02:53.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma keserempet, tanganku aman.
Dialogue: 0,0:02:53.33,0:02:55.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bangun dulu!
Dialogue: 0,0:02:55.00,0:02:56.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyaris saja.
Dialogue: 0,0:02:58.72,0:03:02.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelurunya bisa dia tangkis dan arahkan?
Dialogue: 0,0:03:03.34,0:03:04.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial!
Dialogue: 0,0:03:05.31,0:03:07.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia kabur.
Dialogue: 0,0:03:10.52,0:03:15.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Iya, benar! Gudangnya bersimbah darah!
Dialogue: 0,0:03:15.15,0:03:19.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada lima atau tujuh… Aku juga tidak tahu!
Dialogue: 0,0:03:19.15,0:03:20.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya banyak mayat!
Dialogue: 0,0:03:20.95,0:03:23.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Segeralah datang!
Dialogue: 0,0:03:23.11,0:03:24.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo?
Dialogue: 0,0:03:25.41,0:03:28.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mayatnya belum dibersihkan?
Dialogue: 0,0:03:29.83,0:03:30.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu siapa?
Dialogue: 0,0:03:31.37,0:03:34.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tu-Tunggu, jangan masuk!
Dialogue: 0,0:03:34.13,0:03:36.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah panggil polisi!
Dialogue: 0,0:03:36.63,0:03:38.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pihak terlibat?
Dialogue: 0,0:03:43.72,0:03:48.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Eng… Orangnya hilang.
Dialogue: 0,0:03:48.26,0:03:52.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Lah? Pak Satpam aman? Tenangkan dirimu!{\i0}
Dialogue: 0,0:03:57.48,0:03:58.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong!
Dialogue: 0,0:03:59.57,0:04:01.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tsugai yang mengendalikan orang?
Dialogue: 0,0:04:01.90,0:04:03.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berbahaya sekali.
Dialogue: 0,0:04:04.61,0:04:09.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Datang untuk mengambil Yuru,\Nartinya kamu antek Desa Higashi?
Dialogue: 0,0:04:12.25,0:04:15.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tahan yang erat, Fuujin, Raijin.
Dialogue: 0,0:04:15.67,0:04:17.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ngeri juga kalau aku dikendalikan.
Dialogue: 0,0:04:18.71,0:04:21.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada banyak orang datang, Paman.
Dialogue: 0,0:04:21.80,0:04:26.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, paling para bawahan yang panik\Nkarena aku susah dihubungi.
Dialogue: 0,0:04:26.97,0:04:29.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo pergi sebelum Tsugai kita diambil.
Dialogue: 0,0:04:29.97,0:04:31.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya Kagemori membawa Asa.
Dialogue: 0,0:04:33.06,0:04:34.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:04:35.23,0:04:39.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ketahuan membelot,\Naku akan dibunuh Ayah.
Dialogue: 0,0:04:39.77,0:04:43.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita singkirkan saksi mata.
Dialogue: 0,0:04:45.41,0:04:46.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gas.
Dialogue: 0,0:04:48.99,0:04:50.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan! Hentikan!
Dialogue: 0,0:04:50.99,0:04:54.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu! Jangan!
Dialogue: 0,0:04:55.42,0:04:57.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lakukan yang bersih, Asuma.
Dialogue: 0,0:04:57.67,0:04:58.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan kotori kantorku.
Dialogue: 0,0:04:58.92,0:05:02.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sabar, ayo rundingkan dulu!
Dialogue: 0,0:05:02.21,0:05:03.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mau.
Dialogue: 0,0:05:03.21,0:05:04.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon!
Dialogue: 0,0:05:04.67,0:05:07.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, kamu pernah membunuh?
Dialogue: 0,0:05:08.68,0:05:10.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:05:10.76,0:05:12.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi ada orang yang ingin kubunuh.
Dialogue: 0,0:05:18.02,0:05:19.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bergerak, Fuujin dan Raijin.
Dialogue: 0,0:05:20.32,0:05:24.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kalian selalu di samping Paman,
Dialogue: 0,0:05:24.19,0:05:25.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}niatku jadi terhambat.
Dialogue: 0,0:05:26.53,0:05:33.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya aku bisa membunuhmu\Ndengan kedua tangan ini, Paman.
Dialogue: 0,0:05:33.12,0:05:33.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Membunuh?
Dialogue: 0,0:05:34.54,0:05:38.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fuujin, Raijin,\Nkalian tidak sadar ada Tsugai ini?
Dialogue: 0,0:05:38.71,0:05:43.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yozakura sangat ahli menyembunyikan\Nkeberadaan dan niat membunuh.
Dialogue: 0,0:05:43.88,0:05:47.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gonzou, Asa, dan Fuyuki menuju kemari.
Dialogue: 0,0:05:47.34,0:05:49.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka sudah dekat.
Dialogue: 0,0:05:49.01,0:05:50.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bisa bicara?
Dialogue: 0,0:05:51.22,0:05:55.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paman harus buka mulut\Nsebelum kubuat tutup usia.
Dialogue: 0,0:05:56.73,0:05:59.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fuujin, empaskan Yozakura!
Dialogue: 0,0:05:59.31,0:06:03.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lehermu akan kupelintir\Nsebelum anginnya sampai.
Dialogue: 0,0:06:03.86,0:06:07.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Petir juga akan mengenai Paman.
Dialogue: 0,0:06:08.11,0:06:09.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fuujin, Raijin.
Dialogue: 0,0:06:09.86,0:06:13.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yozakura juga akan memelintir tuan kalian
Dialogue: 0,0:06:13.45,0:06:16.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau mencoba menyerangku.
Dialogue: 0,0:06:16.62,0:06:18.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka bertikai?
Dialogue: 0,0:06:18.50,0:06:19.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan ini, Asuma?
Dialogue: 0,0:06:20.58,0:06:23.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah banyak berinvestasi padamu!
Dialogue: 0,0:06:23.75,0:06:26.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inventasi? Pantas saja.
Dialogue: 0,0:06:26.38,0:06:31.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu masih membahas uang\Nmeski ajal menjelang?
Dialogue: 0,0:06:32.60,0:06:38.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paman, Klan Kagemori dan para pekerjanya\Nberisi orang-orang buangan.
Dialogue: 0,0:06:38.18,0:06:41.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyimpang, anomali, tidak wajar.
Dialogue: 0,0:06:41.40,0:06:44.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitulah masyarakat mencibir kami.
Dialogue: 0,0:06:45.19,0:06:49.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bagi ibuku yang diperlakukan\Nsemena-mena oleh Klan Shingo,{\i0}
Dialogue: 0,0:06:49.99,0:06:52.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Klan Kagemori adalah surga.{\i0}
Dialogue: 0,0:06:52.95,0:06:54.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu penyelamatnya.
Dialogue: 0,0:06:55.16,0:07:00.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Secara pribadi, aku tidak sudi\Nkamu merebut Klan Kagemori
Dialogue: 0,0:07:00.21,0:07:03.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan memanfaatkan si kembar.
Dialogue: 0,0:07:03.46,0:07:09.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan,\Nkurasa bukan cuma kamu biang keroknya.
Dialogue: 0,0:07:11.05,0:07:15.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil Klan Kagemori ditekuk\Nsatu orang picik dan bodoh.
Dialogue: 0,0:07:15.35,0:07:17.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pun tahu itu, kan?
Dialogue: 0,0:07:18.10,0:07:21.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa yang menghasutmu?
Dialogue: 0,0:07:23.77,0:07:25.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katakan.
Dialogue: 0,0:07:34.70,0:07:35.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo?
Dialogue: 0,0:07:35.62,0:07:38.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ivan, untung kamu datang! Tebas dia!
Dialogue: 0,0:07:39.54,0:07:41.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, aku mengerti.
Dialogue: 0,0:07:41.87,0:07:44.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang, Shingo.
Dialogue: 0,0:07:44.29,0:07:46.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan lengah sama keponakanmu.
Dialogue: 0,0:07:46.42,0:07:50.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bawel!\NGonzou, Asa, dan Fuyuki sedang kemari!
Dialogue: 0,0:07:50.17,0:07:52.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahaya kalau tertangkap!
Dialogue: 0,0:07:53.05,0:07:54.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul.
Dialogue: 0,0:07:57.60,0:07:58.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yozakura!
Dialogue: 0,0:08:02.64,0:08:07.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kalian ditangkap Tsugai Fuyuki,\Nbisa-bisa informasinya bocor.
Dialogue: 0,0:08:07.44,0:08:09.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Matilah di sini.
Dialogue: 0,0:08:17.33,0:08:19.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asuma.
Dialogue: 0,0:08:20.91,0:08:23.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shingo bilang apa saja padamu?
Dialogue: 0,0:08:29.92,0:08:32.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, keserempet apanya!
Dialogue: 0,0:08:32.80,0:08:34.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Robeknya dalam!
Dialogue: 0,0:08:34.97,0:08:39.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luka tembak pasti ditanya ini itu\Nkalau di rumah sakit.
Dialogue: 0,0:08:39.31,0:08:41.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bakal dimarahi Hana.
Dialogue: 0,0:08:41.35,0:08:42.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh!
Dialogue: 0,0:08:42.56,0:08:47.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, tidak kusangka dia bisa\Nmemantulkan peluru pakai katana.
Dialogue: 0,0:08:47.48,0:08:50.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, itu wajar.
Dialogue: 0,0:08:50.23,0:08:51.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bukan salahmu.
Dialogue: 0,0:08:52.36,0:08:55.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah itu kemampuan Tsugai katananya.
Dialogue: 0,0:08:55.61,0:08:58.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau memang kemampuan penggunanya.
Dialogue: 0,0:08:59.08,0:09:03.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin itu gabungan keduanya.
Dialogue: 0,0:09:03.25,0:09:06.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti mereka sangat cocok, ya.
Dialogue: 0,0:09:06.42,0:09:08.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang jelas, dia berbahaya.
Dialogue: 0,0:09:08.67,0:09:11.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penjaga Ilahi Sayuu saja bisa diimbangi.
Dialogue: 0,0:09:12.51,0:09:13.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya!
Dialogue: 0,0:09:15.17,0:09:17.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Danji!
Dialogue: 0,0:09:17.93,0:09:19.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Hei!
Dialogue: 0,0:09:20.47,0:09:23.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}- Lo? Mana musuhnya?\N- Sudah kabur.
Dialogue: 0,0:09:24.52,0:09:26.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong ambilkan kakiku.
Dialogue: 0,0:09:27.02,0:09:30.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya, kakimu bagaimana?
Dialogue: 0,0:09:31.11,0:09:33.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan khawatir.
Dialogue: 0,0:09:33.61,0:09:35.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama kayak lengan Hidari.
Dialogue: 0,0:09:35.99,0:09:40.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong belikan bahan perekat\Ndi toko peralatan.
Dialogue: 0,0:09:40.83,0:09:44.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hidari, jantungmu aman meski ditusuk?
Dialogue: 0,0:09:44.04,0:09:48.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami tidak punya jantung,\Nbeda sama manusia.
Dialogue: 0,0:09:48.21,0:09:52.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Berarti…\NKepalamu pecah pun tetap hidup?
Dialogue: 0,0:09:52.96,0:09:54.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin.
Dialogue: 0,0:09:54.05,0:09:56.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus cara matinya bagaimana?
Dialogue: 0,0:09:56.76,0:09:58.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Caranya?
Dialogue: 0,0:10:00.14,0:10:02.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami belum pernah mati, entahlah.
Dialogue: 0,0:10:02.64,0:10:04.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, sih…
Dialogue: 0,0:10:04.89,0:10:09.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak tahu rasanya mati,\Ntapi serangan tadi terasa mengancam.
Dialogue: 0,0:10:09.90,0:10:12.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenagaku menghilang sekejap.
Dialogue: 0,0:10:12.82,0:10:14.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu apa, ya?
Dialogue: 0,0:10:14.48,0:10:18.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Hidari kolaps\Ndan si Cabul jadi kuat,
Dialogue: 0,0:10:18.32,0:10:20.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin pertukaran energi.
Dialogue: 0,0:10:20.87,0:10:22.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kolaps? Energi?
Dialogue: 0,0:10:22.66,0:10:23.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tukang cabul.
Dialogue: 0,0:10:25.12,0:10:28.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi tukang cabut tenaga.
Dialogue: 0,0:10:28.54,0:10:31.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Intinya, aku tidak bisa bergerak dulu.
Dialogue: 0,0:10:31.96,0:10:35.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senapan tidak mempan,\NPenjaga Ilahi Sayuu pun begini.
Dialogue: 0,0:10:35.84,0:10:38.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita mundur saja dulu.
Dialogue: 0,0:10:38.22,0:10:39.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan sisanya ke Kagemori.
Dialogue: 0,0:10:40.84,0:10:42.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Maaf, Yuru.
Dialogue: 0,0:10:42.51,0:10:46.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Petunjuk ke Mine dan Nagisa\Nmalah kami biarkan lolos.
Dialogue: 0,0:10:47.27,0:10:49.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru aku yang minta maaf.
Dialogue: 0,0:10:49.44,0:10:52.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian sampai babak belur begini.
Dialogue: 0,0:10:53.77,0:10:58.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan baru kita benar-benar baik, Hidari.
Dialogue: 0,0:10:58.24,0:11:02.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan lama kalian separah apa, sih?
Dialogue: 0,0:11:03.70,0:11:05.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski kali ini lolos,
Dialogue: 0,0:11:06.49,0:11:08.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bau darahnya sudah kami ingat.
Dialogue: 0,0:11:08.95,0:11:10.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lain kali pasti tertangkap.
Dialogue: 0,0:11:11.42,0:11:13.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian masih mau membantuku?
Dialogue: 0,0:11:14.25,0:11:15.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja!
Dialogue: 0,0:11:15.67,0:11:20.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Yuru, kami akan selalu bersamamu!
Dialogue: 0,0:11:21.68,0:11:23.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kejam sekali.
Dialogue: 0,0:11:24.22,0:11:27.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku yang mau membunuhnya.
Dialogue: 0,0:11:28.35,0:11:32.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf soal itu, tapi kamu\Njadi hemat tenaga, kan?
Dialogue: 0,0:11:32.85,0:11:38.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membunuh memang terlihat mudah,\Ntapi urusan setelahnya ribet.
Dialogue: 0,0:11:38.19,0:11:42.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya orang sepertimu\Npakai jasa kami para pro.
Dialogue: 0,0:11:43.57,0:11:49.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, menghabisi bosmu sendiri\Nrasanya kurang etis.
Dialogue: 0,0:11:49.12,0:11:54.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shingo cuma menyewaku pakai uang,\Ntidak ada ikatan khusus.
Dialogue: 0,0:11:54.38,0:11:57.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan yang kukerjakan sudah sesuai upah.
Dialogue: 0,0:11:58.05,0:11:59.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu membungkamnya?
Dialogue: 0,0:12:00.88,0:12:03.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, Shingo memberitahumu sesuatu?
Dialogue: 0,0:12:04.55,0:12:07.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak sama sekali.
Dialogue: 0,0:12:07.68,0:12:12.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kurasa dia dihasut seseorang.
Dialogue: 0,0:12:12.94,0:12:17.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya dibanding Paman,\Nkamu lebih tahu banyak.
Dialogue: 0,0:12:37.84,0:12:38.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mati aku!
Dialogue: 0,0:13:01.44,0:13:05.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenaga Hidari luar biasa.
Dialogue: 0,0:13:06.03,0:13:08.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Efek sampingnya gila.
Dialogue: 0,0:13:09.07,0:13:11.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ivan. Gawat.
Dialogue: 0,0:13:12.95,0:13:15.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bahaya telah tiba.{\i0}
Dialogue: 0,0:13:16.92,0:13:18.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa pak tua ini?
Dialogue: 0,0:13:18.50,0:13:20.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah! Kagemori!
Dialogue: 0,0:13:23.05,0:13:26.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku merasakan banyak sekali Tsugai!
Dialogue: 0,0:13:26.38,0:13:30.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo ambil tenaga mereka dan mengamuk lagi!
Dialogue: 0,0:13:30.01,0:13:32.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, kaki kananku sudah parah.
Dialogue: 0,0:13:32.31,0:13:33.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang dipanah bocah itu?
Dialogue: 0,0:13:33.93,0:13:36.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok belum sembuh juga?
Dialogue: 0,0:13:36.69,0:13:41.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kena panah selagi luka tusukanmu\Nbelum sembuh total, Bodoh!
Dialogue: 0,0:13:41.94,0:13:44.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, aku punya ide.
Dialogue: 0,0:13:44.69,0:13:49.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tusuk saja kaki yang satunya,\Nbiar gerakanmu seimbang lagi!
Dialogue: 0,0:13:50.95,0:13:54.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makhluk ini tidak tahu\Nbetapa rapuhnya manusia.
Dialogue: 0,0:13:55.50,0:13:58.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu beruntung, Asuma.
Dialogue: 0,0:14:01.17,0:14:04.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena belum mau mati,\Naku mau pulang dulu.
Dialogue: 0,0:14:05.30,0:14:10.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takutnya Yozakura berbuat sesuatu\Nselagi aku meladenimu.
Dialogue: 0,0:14:11.39,0:14:12.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai jumpa.
Dialogue: 0,0:14:38.66,0:14:41.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang telah terjadi?
Dialogue: 0,0:14:42.17,0:14:43.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asuma, lenganmu!
Dialogue: 0,0:14:43.67,0:14:45.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu terluka?
Dialogue: 0,0:14:45.75,0:14:47.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Ayah.
Dialogue: 0,0:14:47.80,0:14:50.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku gagal menangkap Paman hidup-hidup.
Dialogue: 0,0:14:50.97,0:14:52.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shingo…
Dialogue: 0,0:14:53.01,0:14:54.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini perbuatanmu?
Dialogue: 0,0:14:54.76,0:14:59.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, pengkhianatan…\NLebih ke pembungkaman.
Dialogue: 0,0:15:00.27,0:15:02.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yosano Ivan yang menebasnya.
Dialogue: 0,0:15:03.15,0:15:04.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yosano?
Dialogue: 0,0:15:04.69,0:15:09.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengguna Tsugai katana\Nyang baru Shingo rekrut, ya?
Dialogue: 0,0:15:09.82,0:15:11.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katana?
Dialogue: 0,0:15:11.16,0:15:13.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, orang yang kabur tadi?
Dialogue: 0,0:15:14.24,0:15:16.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya tadi kutangkap dengan Kai.
Dialogue: 0,0:15:17.54,0:15:19.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Fuyuki.
Dialogue: 0,0:15:19.41,0:15:24.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fuujin dan Raijin reliknya rusak,\Ntidak bisa diinterogasi.
Dialogue: 0,0:15:25.71,0:15:30.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu ada yang menghasut Paman,
Dialogue: 0,0:15:30.05,0:15:32.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi dia dibunuh sebelum menjawab.
Dialogue: 0,0:15:32.55,0:15:33.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:15:34.39,0:15:36.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Khawatirkan dirimu sendiri dulu.
Dialogue: 0,0:15:37.64,0:15:39.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar aku balut.
Dialogue: 0,0:15:40.81,0:15:44.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pria Desa Higashi itu juga kabur.
Dialogue: 0,0:16:01.71,0:16:04.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Halo Mas Ivan, ada apa?{\i0}
Dialogue: 0,0:16:06.92,0:16:09.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mineyama, di mana kamu?
Dialogue: 0,0:16:09.38,0:16:10.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Di gudang.{\i0}
Dialogue: 0,0:16:11.42,0:16:15.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mayatnya masih ada, cepat bersihkan.{\i0}
Dialogue: 0,0:16:15.14,0:16:17.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf telat!
Dialogue: 0,0:16:17.43,0:16:19.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saking luasnya aku kesasar!
Dialogue: 0,0:16:20.60,0:16:23.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang sedang kubersihkan.
Dialogue: 0,0:16:23.81,0:16:27.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah dibilang, maaf telat.
Dialogue: 0,0:16:27.02,0:16:30.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Habisnya aku juga harus sekolah\Ndan bimbel.
Dialogue: 0,0:16:30.48,0:16:35.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi-lagi korbanmu banyak,\Nmembersihkannya butuh waktu.
Dialogue: 0,0:16:35.28,0:16:38.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi Tsugai-ku senang, sih.
Dialogue: 0,0:16:40.54,0:16:43.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua ini pihak Desa Higashi?
Dialogue: 0,0:16:43.71,0:16:46.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tsugai-ku akan suka, tidak, ya?
Dialogue: 0,0:16:46.79,0:16:49.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketemuan di mana kalau selesai?
Dialogue: 0,0:17:03.18,0:17:05.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, selesai.
Dialogue: 0,0:17:09.82,0:17:14.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paman, kamu pasti halu karena kelelahan.
Dialogue: 0,0:17:14.65,0:17:15.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pulang dan tidurlah.
Dialogue: 0,0:17:20.99,0:17:24.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Gudang bersimbah darah dan penuh mayat?
Dialogue: 0,0:17:26.04,0:17:29.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangankan mayat, darah pun tidak ada.
Dialogue: 0,0:17:29.84,0:17:31.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:17:32.59,0:17:34.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atapnya berlubang.
Dialogue: 0,0:17:34.30,0:17:35.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa coba?
Dialogue: 0,0:17:41.01,0:17:42.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku melihatnya.
Dialogue: 0,0:17:42.31,0:17:45.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pak Satpam, tenanglah.
Dialogue: 0,0:17:45.10,0:17:49.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku melihatnya dengan mata kepalaku!
Dialogue: 0,0:17:49.40,0:17:52.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada tumpukan mayat,\Nlalu seorang gadis datang.
Dialogue: 0,0:17:52.98,0:17:56.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mayat-mayatnya digulung\Njadi bola lalu hilang.
Dialogue: 0,0:17:59.70,0:18:04.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Atau aku memang jadi gila?
Dialogue: 0,0:18:07.29,0:18:09.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Mas Ivan.
Dialogue: 0,0:18:09.42,0:18:11.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mas Ivan.
Dialogue: 0,0:18:12.92,0:18:14.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketemu!
Dialogue: 0,0:18:14.84,0:18:16.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mas Ivan!
Dialogue: 0,0:18:16.42,0:18:18.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan teriak, bikin pusing.
Dialogue: 0,0:18:18.80,0:18:21.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, Mas Ivan yang lemas seksi banget!
Dialogue: 0,0:18:21.93,0:18:24.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ivan, ayo bunuh dia.
Dialogue: 0,0:18:24.06,0:18:26.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tumben kita sependapat, Shokyo.
Dialogue: 0,0:18:27.77,0:18:30.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pakai penukar tenaga?
Dialogue: 0,0:18:30.06,0:18:33.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, ke Hidari dari Penjaga Ilahi Sayuu.
Dialogue: 0,0:18:33.15,0:18:35.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, sama dewa!
Dialogue: 0,0:18:35.57,0:18:37.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Efeknya gila, ya?
Dialogue: 0,0:18:37.11,0:18:38.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:18:38.70,0:18:42.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayak minum satu ember\Nminuman energi sekaligus.
Dialogue: 0,0:18:42.95,0:18:46.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat, ini membebani jantung.
Dialogue: 0,0:18:48.04,0:18:49.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sulit buat bergerak.
Dialogue: 0,0:18:49.96,0:18:52.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waduh, ini kesempatan!
Dialogue: 0,0:18:52.63,0:18:55.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau jantungmu berhenti,\Nakan kuberi napas buatan!
Dialogue: 0,0:18:57.05,0:18:58.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan, Gadis Cabul!
Dialogue: 0,0:19:00.13,0:19:04.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, gagal mengalahkan Hidari\Ndan gagal membunuh Yuru?
Dialogue: 0,0:19:04.76,0:19:07.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gagal total, dong?
Dialogue: 0,0:19:08.35,0:19:12.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja, Yuru akan mengejarku.
Dialogue: 0,0:19:12.35,0:19:14.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami pasti bertemu lagi.
Dialogue: 0,0:19:14.27,0:19:17.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saling mencari, dong?
Dialogue: 0,0:19:17.23,0:19:19.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, jadi cemburu.
Dialogue: 0,0:19:19.53,0:19:21.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semangat, ya!
Dialogue: 0,0:19:21.53,0:19:26.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau membawamu\Nke Desa Nishino sebagai bola daging.
Dialogue: 0,0:19:27.95,0:19:28.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak…
Dialogue: 0,0:19:31.04,0:19:32.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak terluka!
Dialogue: 0,0:19:32.79,0:19:35.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, kena peluru senapan Dera.
Dialogue: 0,0:19:36.59,0:19:37.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dera!
Dialogue: 0,0:19:37.92,0:19:40.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yuru, jelaskan yang benar!
Dialogue: 0,0:19:40.47,0:19:43.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya kamu berjanji\Nakan melindungi Kakak?
Dialogue: 0,0:19:43.97,0:19:46.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku!
Dialogue: 0,0:19:46.39,0:19:50.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal Penjaga Ilahi Sayuu juga\Nsudah bilang "Siap laksanakan!"
Dialogue: 0,0:19:50.77,0:19:51.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waduh.
Dialogue: 0,0:19:51.94,0:19:52.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:19:52.90,0:19:56.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak memang harus dijaga Klan Kagemori!
Dialogue: 0,0:19:56.32,0:19:58.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Desa Higashi tidak bisa dipercaya!
Dialogue: 0,0:19:58.40,0:20:02.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ramai-ramai saja Kakak masih terluka!
Dialogue: 0,0:20:02.65,0:20:04.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu juga!
Dialogue: 0,0:20:05.16,0:20:06.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:20:17.54,0:20:20.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian akan kulepaskan\Nkalau misinya selesai.
Dialogue: 0,0:20:22.17,0:20:24.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah berapa lama berlalu, ya?
Dialogue: 0,0:20:28.81,0:20:29.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Azami?
Dialogue: 0,0:20:31.56,0:20:35.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Oh, mungkin kami akan dilepaskan.{\i0}
Dialogue: 0,0:20:40.28,0:20:42.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak?
Dialogue: 0,0:20:47.66,0:20:48.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa kalian?
Dialogue: 0,0:20:49.28,0:20:50.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hai, Azami.
Dialogue: 0,0:20:50.99,0:20:52.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah kamu aman.
Dialogue: 0,0:20:54.21,0:20:58.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dera, mana berewokmu?
Dialogue: 0,0:20:59.13,0:21:02.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di mana ini? Aku bingung!
Dialogue: 0,0:21:02.34,0:21:04.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin pulang!
Dialogue: 0,0:21:05.18,0:21:07.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenanglah, Nak.
Dialogue: 0,0:21:07.64,0:21:09.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang jahatnya sudah pergi.
Dialogue: 0,0:21:09.81,0:21:14.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ih, senyum orang ini mencurigakan!
Dialogue: 0,0:21:16.69,0:21:19.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah dibilang, tenang saja.
Dialogue: 0,0:21:19.02,0:21:21.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada yang akan menyakitimu.
Dialogue: 0,0:21:24.07,0:21:27.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga, kamu tidak bisa melihatku, ya?
Dialogue: 0,0:21:28.62,0:21:30.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Ini aku.
Dialogue: 0,0:21:30.03,0:21:31.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kita pernah bertemu di Desa Higashi.
Dialogue: 0,0:21:36.16,0:21:39.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, lagi-lagi pingsan.
Dialogue: 0,0:21:39.17,0:21:40.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sakit hati aku, wak!
Dialogue: 0,0:21:40.84,0:21:44.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo? Kalau di sini cuma Azami…
Dialogue: 0,0:21:44.80,0:21:48.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Di dalam tinggal Yuru, Danji,{\i0}
Dialogue: 0,0:21:48.30,0:21:50.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Asa asli dan Asa palsu?{\i0}
Dialogue: 0,0:21:51.97,0:21:53.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bakal ricuh, deh.{\i0}
Dialogue: 0,0:23:28.90,0:23:29.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Maafkan aku.{\i0}
Dialogue: 0,0:23:30.53,0:23:34.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku tahu tidak bisa menipumu selamanya.{\i0}
Dialogue: 0,0:23:34.20,0:23:37.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kekuatan yang besar membuat\Norang-orang jadi gila.{\i0}
