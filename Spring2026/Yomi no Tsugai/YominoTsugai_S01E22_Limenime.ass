Dialogue: 0,0:07:23.31,0:07:24.06,sign,,0000,0000,0000,,BIAYA DITANGGUNG SENDIRI
Dialogue: 0,0:23:27.57,0:23:28.94,sign,,0000,0000,0000,,EPISODE SELANJUTNYA
Dialogue: 0,0:01:53.82,0:01:55.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Barusan ada Tsugai.
Dialogue: 0,0:01:55.19,0:01:57.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, ada.
Dialogue: 0,0:01:57.78,0:02:00.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Berhenti, biar kuperiksa.\N- Baik.
Dialogue: 0,0:02:07.96,0:02:10.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat malam, Nona.
Dialogue: 0,0:02:10.83,0:02:13.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tsugai-mu luar biasa, ya.
Dialogue: 0,0:02:16.46,0:02:18.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bisa melihatnya?
Dialogue: 0,0:02:20.18,0:02:23.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tengkorak bertanduk dengan sayap hitam.
Dialogue: 0,0:02:24.47,0:02:26.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keren banget.
Dialogue: 0,0:02:26.64,0:02:27.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa namanya?
Dialogue: 0,0:02:35.69,0:02:40.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Baru pertama ada yang memahamiku!
Dialogue: 0,0:02:45.58,0:02:48.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja, kita sama.
Dialogue: 0,0:03:02.68,0:03:05.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami adalah Matahari dan Bulan.
Dialogue: 0,0:03:05.26,0:03:08.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namanya Yozakura.
Dialogue: 0,0:03:08.22,0:03:10.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasangannya mana?
Dialogue: 0,0:03:10.77,0:03:12.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang satunya bernama Asagiri.
Dialogue: 0,0:03:13.10,0:03:15.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sembunyi karena lemah di malam hari.
Dialogue: 0,0:03:17.44,0:03:22.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, sedang apa kamu di sini selarut ini?
Dialogue: 0,0:03:25.20,0:03:28.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau bunuh diri dengan melompat.
Dialogue: 0,0:03:29.45,0:03:32.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena aku tidak dibutuhkan.
Dialogue: 0,0:03:33.46,0:03:36.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu lompat akan langsung kutangkap.
Dialogue: 0,0:03:36.21,0:03:38.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan mati.
Dialogue: 0,0:03:38.46,0:03:41.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, ya. Maafkan aku!
Dialogue: 0,0:03:43.09,0:03:46.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, padahal kita baru bertemu.
Dialogue: 0,0:03:46.43,0:03:47.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.
Dialogue: 0,0:03:48.51,0:03:50.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertemuan kita sudah takdir.
Dialogue: 0,0:03:50.89,0:03:53.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mau, kamu boleh curhat padaku.
Dialogue: 0,0:03:54.77,0:03:57.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Kagemori Gonzou.
Dialogue: 0,0:03:57.77,0:04:00.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Shingo Iori.
Dialogue: 0,0:04:01.19,0:04:03.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya tidak dibutuhkan?
Dialogue: 0,0:04:04.66,0:04:09.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak kecil, aku bodoh dan lamban.
Dialogue: 0,0:04:09.87,0:04:12.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masuk sekolah yang diinginkan\Norang tuaku pun tidak bisa.
Dialogue: 0,0:04:12.79,0:04:15.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak becus dalam apa pun,
Dialogue: 0,0:04:15.63,0:04:17.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak bisa diharapkan,
Dialogue: 0,0:04:17.75,0:04:19.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan selalu dicemooh kakakku.
Dialogue: 0,0:04:20.51,0:04:23.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku diperlakukan seakan tidak pernah ada.
Dialogue: 0,0:04:24.68,0:04:29.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin, aku orang yang tidak dibutuhkan.
Dialogue: 0,0:04:32.14,0:04:37.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Dulu juga,\Naku pernah mencoba mengakhiri hidup.
Dialogue: 0,0:04:40.90,0:04:44.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Saat mencari tempat bunuh diri,{\i0}
Dialogue: 0,0:04:44.03,0:04:46.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}aku menemukan mereka.{\i0}
Dialogue: 0,0:04:46.66,0:04:49.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Relik Matahari dan Bulan.{\i0}
Dialogue: 0,0:04:51.91,0:04:54.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Meski tanpa kepala dan tangan,{\i0}
Dialogue: 0,0:04:54.29,0:04:57.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}menurutku itu indah.{\i0}
Dialogue: 0,0:04:58.25,0:05:02.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku kurang paham soal Tuhan dan Buddha.{\i0}
Dialogue: 0,0:05:03.30,0:05:08.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tapi mungkin saja,\Ndia akan menuntunku ke surga.{\i0}
Dialogue: 0,0:05:09.93,0:05:13.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu saat mengiris nadiku…
Dialogue: 0,0:05:13.98,0:05:15.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Mereka muncul, ya?
Dialogue: 0,0:05:15.94,0:05:17.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Iya.
Dialogue: 0,0:05:17.23,0:05:20.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka berdua sangat baik
Dialogue: 0,0:05:20.27,0:05:22.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan mau mendengarkan curhatku.
Dialogue: 0,0:05:22.98,0:05:26.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi tiap mengobrol dengan mereka,
Dialogue: 0,0:05:26.61,0:05:30.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku dianggap gila oleh keluargaku.
Dialogue: 0,0:05:31.16,0:05:33.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Meski menjelaskan soal Tsugai,{\i0}
Dialogue: 0,0:05:33.49,0:05:36.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}aku dibilang tukang halu{\i0}
Dialogue: 0,0:05:36.16,0:05:39.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dan dikatai sakit jiwa.{\i0}
Dialogue: 0,0:05:39.88,0:05:43.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tapi saat menunjukkan wujudnya,{\i0}
Dialogue: 0,0:05:43.76,0:05:46.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}mereka malah bilang aku kesurupan{\i0}
Dialogue: 0,0:05:46.72,0:05:51.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dan dikendalikan roh jahat.\NUjungnya aku makin dikucilkan.{\i0}
Dialogue: 0,0:05:52.97,0:05:56.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma kakakku yang tampak tertarik.
Dialogue: 0,0:05:56.23,0:05:58.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tidak bisa dipercaya!
Dialogue: 0,0:05:59.23,0:06:04.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia cuma akan memperbudak Tsugai\Nlayaknya sapi perah!
Dialogue: 0,0:06:04.19,0:06:06.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu cuma mau dimanfaatkan.
Dialogue: 0,0:06:06.74,0:06:09.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putuskan hubunganmu dengan Shingo!
Dialogue: 0,0:06:10.36,0:06:15.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang sepertiku tidak punya tempat.
Dialogue: 0,0:06:18.50,0:06:21.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iori, maukah kamu tinggal di wismaku?
Dialogue: 0,0:06:22.59,0:06:23.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:06:23.50,0:06:27.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wisma Kagemori cukup luas, kok.
Dialogue: 0,0:06:27.22,0:06:30.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami butuh banyak pekerja\Nuntuk memperluas bisnis.
Dialogue: 0,0:06:30.64,0:06:34.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetapi, kamu baru saja mengenalku, lo?
Dialogue: 0,0:06:34.43,0:06:38.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak pekerja yang senasib denganmu.
Dialogue: 0,0:06:38.98,0:06:41.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengguna Tsugai pun ada banyak.
Dialogue: 0,0:06:41.48,0:06:44.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bisa hidup tanpa sungkan di sana.
Dialogue: 0,0:06:46.15,0:06:49.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemilik Tsugai sangat disambut.
Dialogue: 0,0:06:56.62,0:07:00.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak, luka bahumu aman?
Dialogue: 0,0:07:01.00,0:07:03.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aman, tanganku masih bisa bergerak.
Dialogue: 0,0:07:03.96,0:07:07.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tertembak senapan!\NButuh pengobatan intens!
Dialogue: 0,0:07:08.26,0:07:10.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau periksa luka tembak ke dokter umum,
Dialogue: 0,0:07:10.84,0:07:14.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mereka pasti menginterogasi kami\Ndan memanggil polisi.
Dialogue: 0,0:07:14.39,0:07:15.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:07:15.47,0:07:19.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak juga tidak punya asuransi,\Nbiayanya pasti besar.
Dialogue: 0,0:07:19.10,0:07:20.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat!
Dialogue: 0,0:07:20.85,0:07:23.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Hana akan makin kurepotkan!{\i0}
Dialogue: 0,0:07:24.06,0:07:26.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya…
Dialogue: 0,0:07:26.69,0:07:28.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo ke wisma Kagemori!
Dialogue: 0,0:07:28.15,0:07:29.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar apa?
Dialogue: 0,0:07:29.24,0:07:32.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada Dokter Sakurazawa\Ndi ruang medis Kagemori.
Dialogue: 0,0:07:32.36,0:07:34.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang itu bukan dokter biasa, pasti aman.
Dialogue: 0,0:07:34.74,0:07:37.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dokter yang mengambil darah segar itu?
Dialogue: 0,0:07:37.70,0:07:41.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya meragukan\Nkalau dia bukan dokter biasa?
Dialogue: 0,0:07:41.58,0:07:43.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula!
Dialogue: 0,0:07:43.67,0:07:47.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak memercayai Kagemori sepenuhnya!
Dialogue: 0,0:07:47.34,0:07:49.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mau aku ke sana!
Dialogue: 0,0:07:49.59,0:07:52.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak kejam!
Dialogue: 0,0:07:52.18,0:07:55.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu yakin mau memercayai mereka?
Dialogue: 0,0:07:57.18,0:07:58.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yakin.
Dialogue: 0,0:07:59.43,0:08:04.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu mereka\Nbukan terhitung orang biasa.
Dialogue: 0,0:08:04.10,0:08:08.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kalau bertingkah seperti orang biasa,\Naku akan cepat mati.
Dialogue: 0,0:08:10.23,0:08:11.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pernah bilang, kan?
Dialogue: 0,0:08:11.74,0:08:16.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang menolongku dari kejaran Desa Higashi\Nadalah Master, Jin, dan lainnya.
Dialogue: 0,0:08:16.70,0:08:17.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Jin, ya.{\i0}
Dialogue: 0,0:08:17.99,0:08:20.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Meski aku todong parang,{\i0}
Dialogue: 0,0:08:20.62,0:08:25.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dia tetap mengaku bertanggung jawab\Natas penyerangan Desa Higashi.{\i0}
Dialogue: 0,0:08:25.25,0:08:28.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Iya, kadang dia kelewat serius.{\i0}
Dialogue: 0,0:08:29.80,0:08:33.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi melindungi Klan Kagemori,\Ndari tiga bersaudara itu,
Dialogue: 0,0:08:33.05,0:08:37.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia rela mengorbankan diri\Nmelakukan pekerjaan kotor.
Dialogue: 0,0:08:38.14,0:08:42.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia berusaha tidak melibatkan emosi\Npada kawan maupun lawan,
Dialogue: 0,0:08:42.18,0:08:46.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan menyelesaikan tugas\Ndengan kepala dingin.
Dialogue: 0,0:08:47.56,0:08:49.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu dua sisanya?
Dialogue: 0,0:08:49.65,0:08:55.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Hagure Sensei mengajariku keterampilan\Nsupaya suatu saat bisa hidup normal.{\i0}
Dialogue: 0,0:08:55.66,0:08:59.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku membantunya membuat komik,{\i0}
Dialogue: 0,0:08:59.12,0:09:01.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}sebuah seni gambar modern.{\i0}
Dialogue: 0,0:09:01.91,0:09:06.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku bisa menghasilkan uang dengan aman\Ntanpa harus keluar wisma.{\i0}
Dialogue: 0,0:09:06.96,0:09:09.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Oh, baguslah.{\i0}
Dialogue: 0,0:09:09.17,0:09:11.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Asuma…
Dialogue: 0,0:09:11.80,0:09:13.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senyumnya mencurigakan.
Dialogue: 0,0:09:13.26,0:09:15.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia paling tidak bisa dipercaya.
Dialogue: 0,0:09:15.68,0:09:20.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia pernah memintamu untuk mati, kan?{\i0}
Dialogue: 0,0:09:20.26,0:09:21.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Pernah!{\i0}
Dialogue: 0,0:09:21.43,0:09:25.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}"Daripada diincar terus,\Nlebih baik kamu mati,
Dialogue: 0,0:09:25.81,0:09:29.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}mendapat kekuatan agar\Nbisa melindungi diri."
Dialogue: 0,0:09:29.94,0:09:35.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Dan klan sekuat Kagemori akan melindungi\Ndan mengurusmu."
Dialogue: 0,0:09:35.78,0:09:37.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah pemikiran Asuma.
Dialogue: 0,0:09:37.99,0:09:43.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski berlidah tajam,\Ndia tidak pernah membohongi kami.
Dialogue: 0,0:09:45.37,0:09:47.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mau diapakan?
Dialogue: 0,0:09:47.37,0:09:49.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dipulangkan ke Desa Higashi?
Dialogue: 0,0:09:50.84,0:09:53.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Dia sudah menyaksikan banyak hal di sini.
Dialogue: 0,0:09:54.38,0:09:57.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mau dipulangkan,\Ndia harus dibuat tutup mulut.
Dialogue: 0,0:09:57.47,0:09:59.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau dikurung saja?
Dialogue: 0,0:10:03.18,0:10:05.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tidak bisa dibiarkan bebas?
Dialogue: 0,0:10:06.18,0:10:09.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Dia tidak tahu kembar Asa dan Yuru
Dialogue: 0,0:10:09.19,0:10:12.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}harus mati supaya mendapatkan kekuatan.
Dialogue: 0,0:10:12.69,0:10:15.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah dianggap dewasa oleh warga desa,
Dialogue: 0,0:10:15.82,0:10:18.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}barulah dia diberi tahu soal itu.
Dialogue: 0,0:10:18.49,0:10:21.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Azami belum tahu apa-apa!
Dialogue: 0,0:10:21.37,0:10:23.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berbagi rahasia, ya.
Dialogue: 0,0:10:23.70,0:10:28.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti terpaksa gabung\Nkalau sudah dewasa, ya.
Dialogue: 0,0:10:28.21,0:10:32.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hal ini memperkuat ikatan mereka\Ndengan memberi perasaan istimewa.
Dialogue: 0,0:10:33.84,0:10:38.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana nasib orang yang tahu\Nrahasia si kembar dan malah curiga?
Dialogue: 0,0:10:38.47,0:10:43.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang tidak setuju turun gunung\Nuntuk merantau.
Dialogue: 0,0:10:44.18,0:10:49.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka akan bekerja lewat koneksi\Norang desa di dataran rendah.
Dialogue: 0,0:10:49.94,0:10:51.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan,
Dialogue: 0,0:10:51.31,0:10:55.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}alasan mereka yang merantau\Ntapi tidak pernah kembali…
Dialogue: 0,0:10:55.36,0:10:58.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau pulang, mereka takut membocorkan\Nrahasianya ke Yuru.
Dialogue: 0,0:10:59.49,0:11:04.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, ada juga yang memang merantau\Nmurni buat kerja.
Dialogue: 0,0:11:07.62,0:11:10.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi mereka dihabisi Klan Kagemori.
Dialogue: 0,0:11:11.21,0:11:14.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian juga sering menyerang kami, kan?
Dialogue: 0,0:11:14.71,0:11:18.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terutama, oleh Klan Tadera.
Dialogue: 0,0:11:34.02,0:11:36.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Hei, selamat datang.\N- Kami kembali.
Dialogue: 0,0:11:36.82,0:11:39.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus. Terima kasih.
Dialogue: 0,0:11:42.28,0:11:43.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master.
Dialogue: 0,0:11:43.74,0:11:47.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin membawa Kakak ke wisma\Nuntuk mengobatinya.
Dialogue: 0,0:11:47.16,0:11:49.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belum setuju, woi!
Dialogue: 0,0:11:49.20,0:11:53.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Maaf, Asa, sepulang ini kita\Nharus mengurus Akio.
Dialogue: 0,0:11:53.50,0:11:56.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Akan memalukan kalau Yuru melihatnya.
Dialogue: 0,0:11:56.46,0:11:59.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}O-Oh, iya, Akio.
Dialogue: 0,0:11:59.21,0:12:02.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Akio itu si botak yang berniat\Nmembunuhku, kan?{\i0}
Dialogue: 0,0:12:02.97,0:12:07.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada pengkhianat yang tertangkap di wisma,\Nternyata memang Akio.
Dialogue: 0,0:12:07.97,0:12:10.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, sesuai dugaan Jin, ya.
Dialogue: 0,0:12:11.81,0:12:18.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, Paman tidak pernah\Nmenyebut Akio sekali pun.
Dialogue: 0,0:12:19.36,0:12:21.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di malam saat Yuru datang ke wisma,
Dialogue: 0,0:12:21.49,0:12:26.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pamanlah yang membocorkan\Nkedatangan si kembar.
Dialogue: 0,0:12:26.37,0:12:29.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia dapat infonya dari Ivan.
Dialogue: 0,0:12:29.45,0:12:32.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paman mengumpulkan grup dadakan
Dialogue: 0,0:12:32.50,0:12:35.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan menyuruhku menangkap\Nsi kembar diam-diam.
Dialogue: 0,0:12:36.46,0:12:40.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku mengabaikan pesannya\Ndan pura-pura tidur.
Dialogue: 0,0:12:40.34,0:12:41.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diabaikan?
Dialogue: 0,0:12:42.13,0:12:46.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti, yang berhubungan\Ndengan Akio adalah Ivan?
Dialogue: 0,0:12:46.93,0:12:48.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ivan?
Dialogue: 0,0:12:48.39,0:12:52.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Orang itu\Ntahu sesuatu tentang Ibu dan Ayah.
Dialogue: 0,0:12:52.68,0:12:55.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin saja Akio juga tahu.
Dialogue: 0,0:12:57.23,0:12:58.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master.
Dialogue: 0,0:13:00.02,0:13:01.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo segera kembali ke wisma.
Dialogue: 0,0:13:02.44,0:13:05.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita peras informasi dari Akio\Ndan Dewa Gunung.
Dialogue: 0,0:13:22.80,0:13:24.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempat kerjaku!
Dialogue: 0,0:13:25.47,0:13:27.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Komputerku! Dataku! Drafku!
Dialogue: 0,0:13:27.97,0:13:32.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Sensei, tadi ada bentrok sedikit.
Dialogue: 0,0:13:33.22,0:13:34.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi banyak yang hancur, deh.
Dialogue: 0,0:13:34.89,0:13:37.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi mesin kopinya aman, kok.
Dialogue: 0,0:13:38.60,0:13:39.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sensei mau minum juga?
Dialogue: 0,0:13:39.81,0:13:41.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sumpahi kopimu
Dialogue: 0,0:13:41.36,0:13:44.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berubah jadi tinta hitam seumur hidup!
Dialogue: 0,0:13:45.49,0:13:46.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dataku mana?
Dialogue: 0,0:13:47.28,0:13:48.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aman, sip!
Dialogue: 0,0:13:49.41,0:13:52.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Datanya hilang pun, Hitam Putih bisa\Nmenggambarnya ulang, kan?
Dialogue: 0,0:13:53.99,0:13:55.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak mengerti.
Dialogue: 0,0:13:56.08,0:13:59.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru ketidakstabilan\Nitu yang bikin estetik.
Dialogue: 0,0:13:59.12,0:14:01.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:14:01.04,0:14:03.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayaknya lebih indah kalau semuanya rapi.
Dialogue: 0,0:14:04.42,0:14:06.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hati manusia pun sama.
Dialogue: 0,0:14:06.80,0:14:10.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu caraku dalam membuat karakter komik.
Dialogue: 0,0:14:10.80,0:14:14.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka lebih manusiawi\Nkalau bimbang dan goyah.
Dialogue: 0,0:14:15.39,0:14:18.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jin, kumohon!
Dialogue: 0,0:14:18.19,0:14:20.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolonglah Akio!
Dialogue: 0,0:14:20.77,0:14:24.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa.\NBos tidak akan mengampuni pengkhianat.
Dialogue: 0,0:14:24.98,0:14:26.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akio akan disingkirkan.
Dialogue: 0,0:14:26.65,0:14:28.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami bersama sejak kecil!
Dialogue: 0,0:14:28.99,0:14:31.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia saudaraku meski tidak sedarah!
Dialogue: 0,0:14:31.53,0:14:34.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permohonanku tidak akan didengar!
Dialogue: 0,0:14:34.41,0:14:37.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tapi kamu adalah anaknya!\N- Haruo.
Dialogue: 0,0:14:38.37,0:14:40.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bahaya tidak diatasi,
Dialogue: 0,0:14:40.42,0:14:42.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}nyawa kalian juga akan terancam.
Dialogue: 0,0:14:44.80,0:14:47.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akio tidak bisa dibiarkan hidup.
Dialogue: 0,0:14:51.72,0:14:54.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tangan yang putus mustahil dikembalikan.
Dialogue: 0,0:14:55.60,0:15:00.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pendarahannya sudah reda, bawa saja\Nke rumah sakit kalau mau dia selamat.
Dialogue: 0,0:15:03.86,0:15:07.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak disangka adikku jadi pengkhianat.
Dialogue: 0,0:15:09.24,0:15:10.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedih banget.
Dialogue: 0,0:15:11.82,0:15:15.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa saja ada\Npengkhianat selain aku di sini.
Dialogue: 0,0:15:15.49,0:15:20.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penduduk wisma sudah diperiksa\NDaftar Hitam-nya Fuyuki.
Dialogue: 0,0:15:20.75,0:15:23.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak kecurigaan padamu meningkat,
Dialogue: 0,0:15:23.42,0:15:28.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}semua pekerja di sini sudah\Ndicek oleh Daftar Hitam.
Dialogue: 0,0:15:29.51,0:15:33.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sisanya cuma kamu, Akio.
Dialogue: 0,0:15:34.89,0:15:37.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dokter Sakurazawa juga dicek?
Dialogue: 0,0:15:37.06,0:15:39.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah, tidak ada yang mencurigakan.
Dialogue: 0,0:15:42.69,0:15:44.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kenapa kamu berkhianat?
Dialogue: 0,0:15:45.11,0:15:49.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tahu bahwa Master tiada ampun\Nsoal pengkhianat dan musuh, kan?
Dialogue: 0,0:15:49.74,0:15:52.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepulangnya Master,\Nkamu akan diinterogasi dan dibunuh.
Dialogue: 0,0:15:53.49,0:15:55.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami tidak bisa melindungimu.
Dialogue: 0,0:15:55.74,0:15:58.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu benci kerja di Kagemori?
Dialogue: 0,0:15:58.45,0:16:01.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga benci pekerjaan kotor, kok.
Dialogue: 0,0:16:01.62,0:16:04.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan aku ingin segera pensiun.
Dialogue: 0,0:16:04.75,0:16:08.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi!\NBukan berarti aku ingin menjual rekanku!
Dialogue: 0,0:16:12.76,0:16:15.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa, sih, Akio?
Dialogue: 0,0:16:21.06,0:16:23.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tahu kondisiku, kan?
Dialogue: 0,0:16:23.98,0:16:28.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa merasakan\Nsakit sejak dilahirkan.
Dialogue: 0,0:16:29.07,0:16:31.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu kecil aku jadi tidak terkalahkan.
Dialogue: 0,0:16:33.03,0:16:37.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Karena tidak tahu batas tubuh ini,\Naku selalu menang berkelahi.{\i0}
Dialogue: 0,0:16:38.37,0:16:42.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku tidak memahami rasa sakit sendiri,\Nbegitu pun rasa sakit orang lain.{\i0}
Dialogue: 0,0:16:43.50,0:16:48.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku bersyukur dipungut oleh Klan Kagemori.{\i0}
Dialogue: 0,0:16:48.67,0:16:54.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kalau tetap di dunia luar,\Nmungkin aku sudah dihukum mati.{\i0}
Dialogue: 0,0:16:55.59,0:16:59.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyaknya orang aneh di klan ini\Nmembuatku betah.
Dialogue: 0,0:17:00.47,0:17:03.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyaknya Tsugai aneh pun bikin seru.
Dialogue: 0,0:17:05.48,0:17:09.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami sesama anak panti jadi saudara\Ndan jadi keluarga.
Dialogue: 0,0:17:10.82,0:17:13.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itu memang menyenangkan.{\i0}
Dialogue: 0,0:17:14.65,0:17:17.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tapi masih ada lubang di hatiku.{\i0}
Dialogue: 0,0:17:18.62,0:17:24.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Hal yang kosong\Nitu menumpuk di sol sepatuku.{\i0}
Dialogue: 0,0:17:24.04,0:17:25.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sangat lekat.{\i0}
Dialogue: 0,0:17:26.96,0:17:30.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku pun mulai mencari\Nsesamaku di internet.{\i0}
Dialogue: 0,0:17:30.67,0:17:35.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku pun menemukan komunitas orang-orang\Nyang tidak merasakan sakit sepertiku.{\i0}
Dialogue: 0,0:17:37.55,0:17:38.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan di situ,
Dialogue: 0,0:17:38.89,0:17:42.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ada orang yang kemungkinan\Nadalah orang tuaku.
Dialogue: 0,0:17:43.64,0:17:46.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perasaan yang belum pernah\Nkurasakan pun meluap.
Dialogue: 0,0:17:48.85,0:17:51.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu menghubunginya?
Dialogue: 0,0:17:53.57,0:17:56.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Jadi orang itu yang menghasutmu?
Dialogue: 0,0:17:57.82,0:18:00.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akio, dia sudah membuangmu!
Dialogue: 0,0:18:00.99,0:18:03.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketemu juga buat apa?
Dialogue: 0,0:18:03.83,0:18:06.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa saja dia cuma memanfaatkanmu!
Dialogue: 0,0:18:06.41,0:18:09.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Natsuki, aku minta tolong.
Dialogue: 0,0:18:09.79,0:18:12.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lepaskan Dewa Gunung sekarang juga.
Dialogue: 0,0:18:12.46,0:18:14.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Mana bisa?
Dialogue: 0,0:18:14.92,0:18:16.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fuyuki akan mengambil info mereka.
Dialogue: 0,0:18:17.01,0:18:18.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon.
Dialogue: 0,0:18:18.34,0:18:21.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa-bisa Dewa Gunung mati dihancurkan.
Dialogue: 0,0:18:21.93,0:18:24.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dihancurkan? Oleh siapa?
Dialogue: 0,0:18:24.64,0:18:27.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kontrakmu dan mereka sudah putus.
Dialogue: 0,0:18:27.06,0:18:29.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada yang akan melukai mereka.
Dialogue: 0,0:18:30.15,0:18:32.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudmu, Akio?
Dialogue: 0,0:18:37.28,0:18:38.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketemu!
Dialogue: 0,0:18:42.28,0:18:46.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untung kalian tidak hancur.
Dialogue: 0,0:18:47.70,0:18:52.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, kalian akan kubawa ke Fuyuki\Nuntuk diambil infonya, ya.
Dialogue: 0,0:18:53.00,0:18:54.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktunya bekerja.
Dialogue: 0,0:19:07.85,0:19:09.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia!
Dialogue: 0,0:19:50.10,0:19:52.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sakit sekali, Hup-Ha.
Dialogue: 0,0:19:54.23,0:19:56.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian baik-baik saja?
Dialogue: 0,0:19:57.77,0:20:00.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah.
Dialogue: 0,0:20:00.28,0:20:01.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh.
Dialogue: 0,0:20:02.61,0:20:05.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat, aku tidak bisa berjalan.
Dialogue: 0,0:20:08.20,0:20:11.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yamakaze hancur.
Dialogue: 0,0:20:13.96,0:20:16.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Tanikaze hilang!
Dialogue: 0,0:21:00.05,0:21:01.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami sedang menuju TKP.
Dialogue: 0,0:21:02.13,0:21:04.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada ledakan di dekat gerbang utama.
Dialogue: 0,0:21:04.88,0:21:05.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang terjadi di sana?
Dialogue: 0,0:21:06.72,0:21:08.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum.
Dialogue: 0,0:21:08.89,0:21:11.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami akan menunggu di ruang medis.
Dialogue: 0,0:21:11.85,0:21:13.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada serangan Tsugai?
Dialogue: 0,0:21:13.73,0:21:14.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum diketahui.
Dialogue: 0,0:21:15.39,0:21:18.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inilah kelemahan wisma ini.
Dialogue: 0,0:21:18.19,0:21:23.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena punya banyak Tsugai,\NTsugai asing yang masuk sulit dideteksi.
Dialogue: 0,0:21:28.70,0:21:30.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanikaze?
Dialogue: 0,0:21:31.08,0:21:34.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam bentuk relik? Mau apa kemari?
Dialogue: 0,0:21:48.55,0:21:52.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya tiarap!
Dialogue: 0,0:23:28.94,0:23:31.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mereka melindungi tuannya.{\i0}
Dialogue: 0,0:23:31.45,0:23:34.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tsugai dan manusia\Ntidak bisa hidup sendiri.{\i0}
Dialogue: 0,0:23:34.91,0:23:37.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dikhianati orang terdekat itu menyakitkan.{\i0}
