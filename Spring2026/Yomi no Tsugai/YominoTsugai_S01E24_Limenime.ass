Dialogue: 0,0:12:37.67,0:12:38.67,sign,,0000,0000,0000,,{\an8}MATEMATIKA SEDERHANA I
Dialogue: 0,0:12:59.52,0:13:00.44,sign,,0000,0000,0000,,{\an8}SAKE KAGEMORI
Dialogue: 0,0:16:18.51,0:16:19.93,sign,,0000,0000,0000,,{\an8}DANNO
Dialogue: 0,0:18:35.94,0:18:36.65,sign,,0000,0000,0000,,TSUGAI MILIK PRESDIR SEHAT WALAFIAT
Dialogue: 0,0:20:16.38,0:20:17.46,sign,,0000,0000,0000,,DIA INGIN JADI PEMIMPIN DESA HIGASHI
Dialogue: 0,0:23:32.78,0:23:37.91,sign,,0000,0000,0000,,DESA NISHINO
Dialogue: 0,0:01:32.34,0:01:34.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akio berkhianat?
Dialogue: 0,0:01:34.01,0:01:38.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, Akio mengincar Asa.
Dialogue: 0,0:01:39.26,0:01:42.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin ada yang menghasutnya dari luar.
Dialogue: 0,0:01:43.06,0:01:45.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rencananya kalau Master pulang,
Dialogue: 0,0:01:45.64,0:01:47.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akio akan diinterogasi lalu dibunuh.
Dialogue: 0,0:01:47.94,0:01:52.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa Ayah membunuh seenteng itu, sih?
Dialogue: 0,0:01:52.11,0:01:54.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal Akio rekan kita.
Dialogue: 0,0:01:54.69,0:01:57.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa tidak ada solusi agar\Ndia tetap hidup?
Dialogue: 0,0:02:00.41,0:02:01.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu mustahil!
Dialogue: 0,0:02:02.66,0:02:04.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begini kamu masih ingin dia hidup?
Dialogue: 0,0:02:07.33,0:02:09.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia Kawai, tukang kebun.
Dialogue: 0,0:02:10.29,0:02:14.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena tuannya terbunuh,\NTsugai-nya jadi liar.
Dialogue: 0,0:02:18.76,0:02:21.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Adakah yang mau mengontrak mereka?
Dialogue: 0,0:02:23.64,0:02:26.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, biar aku saja.
Dialogue: 0,0:02:27.48,0:02:30.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka akrab dengan Hup-Ha milikku.
Dialogue: 0,0:02:30.31,0:02:32.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin bisa akur.
Dialogue: 0,0:02:50.04,0:02:51.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi.
Dialogue: 0,0:02:51.88,0:02:53.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nama Tsugai, Musang Jadi-jadian.
Dialogue: 0,0:02:54.29,0:02:56.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Saat ini belum punya nama baru.
Dialogue: 0,0:02:56.88,0:02:59.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Tuan lamanya, Kawai Sanosuke.
Dialogue: 0,0:02:59.47,0:03:05.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Dibunuh ketika mencoba\Nmenghentikan pelarian Akio.
Dialogue: 0,0:03:05.10,0:03:06.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terbukti, deh.
Dialogue: 0,0:03:07.77,0:03:11.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita sudah seperti keluarga.
Dialogue: 0,0:03:11.31,0:03:12.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa…
Dialogue: 0,0:03:12.81,0:03:16.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dilaporkan, bisa-bisa polisi\Nmasuk ke wisma kita.
Dialogue: 0,0:03:17.07,0:03:20.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia harus dibuat\Nseolah hilang tanpa jejak.
Dialogue: 0,0:03:21.40,0:03:26.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang merekrut Kawai.\NKarena sebatang kara,
Dialogue: 0,0:03:26.33,0:03:28.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jejaknya mudah dihilangkan.
Dialogue: 0,0:03:29.37,0:03:30.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jin!
Dialogue: 0,0:03:32.17,0:03:33.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana boleh begini!
Dialogue: 0,0:03:34.17,0:03:36.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sudah lama bekerja untuk kita!
Dialogue: 0,0:03:36.46,0:03:39.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa tidak dimakamkan dengan layak?
Dialogue: 0,0:03:39.13,0:03:41.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini terlalu miris, Ayah!
Dialogue: 0,0:03:42.97,0:03:43.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah!
Dialogue: 0,0:03:45.35,0:03:50.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan sikap intoleran itu\Nyang membuat Akio menutup hati!
Dialogue: 0,0:03:50.77,0:03:52.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah seperti keluarga,
Dialogue: 0,0:03:52.85,0:03:56.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi siapa pun bisa dibuang dengan tega!
Dialogue: 0,0:03:56.56,0:03:58.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau melawan sedikit malah dibunuh!
Dialogue: 0,0:03:59.53,0:04:03.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau saja Ayah lebih luwes\Ndan bermurah hati,
Dialogue: 0,0:04:03.49,0:04:07.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin saja Akio menjelaskan\Nalasannya berkhianat!
Dialogue: 0,0:04:08.45,0:04:11.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Mungkin dia tidak akan\Nmengambil jalan akhir!
Dialogue: 0,0:04:12.96,0:04:15.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin saja Kawai masih hidup!
Dialogue: 0,0:04:15.63,0:04:16.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hikaru!
Dialogue: 0,0:04:19.00,0:04:22.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat menyukai komik Hikaru Sensei.
Dialogue: 0,0:04:22.97,0:04:24.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya tidak ada peran jahatnya.
Dialogue: 0,0:04:25.89,0:04:32.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenyataan itu kejam.\NMakanya hatiku damai saat membaca komikmu.
Dialogue: 0,0:04:32.18,0:04:37.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, rasanya orang-orang di dunia itu\Ntidak akan menyingkirkanku.
Dialogue: 0,0:04:37.94,0:04:41.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi dunia nyata memang kejam.
Dialogue: 0,0:04:41.32,0:04:46.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak orang yang kejinya\Nbahkan di luar nalar.
Dialogue: 0,0:04:46.45,0:04:48.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Termasuk aku.
Dialogue: 0,0:04:48.70,0:04:49.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi,
Dialogue: 0,0:04:49.78,0:04:54.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}penjahat sepertiku pun ingin melindungi\NKlan Kagemori sebisa mungkin.
Dialogue: 0,0:04:55.04,0:04:59.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin Sensei punya tempat aman\Nuntuk terus membuat komik bahagia.
Dialogue: 0,0:05:00.42,0:05:04.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin Asa bisa hidup damai.
Dialogue: 0,0:05:05.30,0:05:07.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi orang tua yang membuangnya,
Dialogue: 0,0:05:07.43,0:05:11.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akio rela mengkhianati kita,\Nkeluarganya di Kagemori.
Dialogue: 0,0:05:11.85,0:05:14.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah sepenting apa sosok orang tua,
Dialogue: 0,0:05:14.48,0:05:18.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi siapa pun yang merusak tempat kita\Ntidak bisa diampuni!
Dialogue: 0,0:05:19.02,0:05:24.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan meski itu orang tuaku sendiri!\NAkan kubunuh mereka!
Dialogue: 0,0:05:24.94,0:05:28.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mau diampuni\Nkarena siapa tahu bertobat?
Dialogue: 0,0:05:28.53,0:05:31.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penjahat tidak akan berubah secepat itu!
Dialogue: 0,0:05:31.03,0:05:34.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih baik dihabisi\Nsebelum akibatnya fatal!
Dialogue: 0,0:05:34.95,0:05:36.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma itu solusinya.
Dialogue: 0,0:05:39.04,0:05:39.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:05:41.21,0:05:42.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asa!
Dialogue: 0,0:05:42.30,0:05:44.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan biarkan Asa sendirian.
Dialogue: 0,0:05:44.42,0:05:45.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga tahu!
Dialogue: 0,0:05:45.92,0:05:47.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asa, tunggu!
Dialogue: 0,0:05:48.01,0:05:49.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Haruo.
Dialogue: 0,0:05:50.47,0:05:53.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa manusia mengkhianati rekannya?
Dialogue: 0,0:05:53.77,0:05:57.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal Tsugai tidak akan pernah\Nsaling berkhianat.
Dialogue: 0,0:05:59.27,0:06:02.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asa, jangan sendirian!
Dialogue: 0,0:06:02.07,0:06:04.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akio bisa saja masih di sini!
Dialogue: 0,0:06:05.36,0:06:06.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asa!
Dialogue: 0,0:06:07.49,0:06:13.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akio, kenapa dia melukai yang lain juga?
Dialogue: 0,0:06:13.99,0:06:16.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal Kawai bukan petarung.
Dialogue: 0,0:06:17.29,0:06:20.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia cuma tukang kebun yang tidak berdosa.
Dialogue: 0,0:06:21.13,0:06:23.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tidak mengharapkan kematian siapa pun.
Dialogue: 0,0:06:23.96,0:06:26.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia cuma hidup seperti biasa.
Dialogue: 0,0:06:27.72,0:06:29.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini salahku.
Dialogue: 0,0:06:29.80,0:06:30.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Idiot!
Dialogue: 0,0:06:33.05,0:06:34.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong kosong!
Dialogue: 0,0:06:34.72,0:06:37.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini ulah mereka yang mengincar kekuatanmu!
Dialogue: 0,0:06:38.31,0:06:39.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bukan salahmu!
Dialogue: 0,0:06:39.81,0:06:43.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yuru sudah bilang\Njangan asal minta maaf, kan?
Dialogue: 0,0:06:43.15,0:06:45.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kamu akan kutendang\Nkalau mengulanginya lagi!
Dialogue: 0,0:06:45.90,0:06:47.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski sudah, sih!
Dialogue: 0,0:06:52.12,0:06:53.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Gabuchan.
Dialogue: 0,0:06:55.58,0:06:57.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kenapa diulangi?{\i0}
Dialogue: 0,0:07:34.28,0:07:36.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah tidak ada.
Dialogue: 0,0:07:38.08,0:07:39.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sendirian.
Dialogue: 0,0:07:39.87,0:07:44.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku harus membereskannya sendiri!
Dialogue: 0,0:07:45.08,0:07:48.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bandit ini
Dialogue: 0,0:07:48.00,0:07:51.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berniat membunuhku!
Dialogue: 0,0:08:01.85,0:08:05.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Jangan bimbang. Jangan ragu.
Dialogue: 0,0:08:05.77,0:08:09.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada Ayah maupun orang lain.
Dialogue: 0,0:08:09.65,0:08:11.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harus kubereskan sendiri!
Dialogue: 0,0:08:15.53,0:08:16.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama di gunung,
Dialogue: 0,0:08:19.87,0:08:21.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}aku sendirian.{\i0}
Dialogue: 0,0:08:27.08,0:08:30.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo? Ini di mana?
Dialogue: 0,0:08:32.05,0:08:37.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya,\Naku ketiduran waktu menyimpan futon.
Dialogue: 0,0:08:38.26,0:08:41.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, kamu sudah bangun?
Dialogue: 0,0:08:42.39,0:08:44.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bikin kaget, Hidari!
Dialogue: 0,0:08:45.23,0:08:46.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedang apa kamu di sini?
Dialogue: 0,0:08:46.85,0:08:47.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengawasimu.
Dialogue: 0,0:08:48.73,0:08:51.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Meski belum bisa bergerak,\N- Hup.
Dialogue: 0,0:08:51.11,0:08:54.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}aku bisa mengawasimu dengan posisi ini.
Dialogue: 0,0:08:54.65,0:08:56.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, terima kasih.
Dialogue: 0,0:08:58.57,0:09:00.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya bangun, bagaimana kondisimu?
Dialogue: 0,0:09:02.25,0:09:05.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tubuhku kembali ringan.\NSekarang jam berapa?
Dialogue: 0,0:09:05.25,0:09:07.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah tengah hari.
Dialogue: 0,0:09:09.09,0:09:10.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat pagi.
Dialogue: 0,0:09:10.29,0:09:12.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi sudah siang, sih.
Dialogue: 0,0:09:12.80,0:09:14.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah terlihat sehat.
Dialogue: 0,0:09:14.88,0:09:16.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Yuru baik-baik saja?
Dialogue: 0,0:09:16.97,0:09:18.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Lukamu bagaimana?
Dialogue: 0,0:09:18.34,0:09:19.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Masih demam?
Dialogue: 0,0:09:19.76,0:09:22.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Sudah sehat? Syukurlah!
Dialogue: 0,0:09:33.90,0:09:35.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok aku dicakar?
Dialogue: 0,0:09:35.32,0:09:36.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidurmu nyenyak?
Dialogue: 0,0:09:38.20,0:09:39.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bermimpi buruk.
Dialogue: 0,0:09:39.74,0:09:43.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh. Lupakanlah dengan makanan enak.
Dialogue: 0,0:09:43.87,0:09:46.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, waktunya bikin makan siang.
Dialogue: 0,0:09:47.75,0:09:50.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo makan sama-sama.
Dialogue: 0,0:10:05.22,0:10:08.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu terlambat, Jin. Tolong bereskan ini.
Dialogue: 0,0:10:11.86,0:10:13.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka orang Desa Higashi?
Dialogue: 0,0:10:13.65,0:10:17.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya begitu. Asa sudah mereka bunuh.
Dialogue: 0,0:10:21.03,0:10:23.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mendapatkan kekuatan Kai.
Dialogue: 0,0:10:26.00,0:10:30.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf. Jin.
Dialogue: 0,0:10:31.42,0:10:35.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf membuatmu membereskan semua ini.
Dialogue: 0,0:10:36.09,0:10:37.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:10:38.26,0:10:39.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:10:40.26,0:10:41.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:10:42.60,0:10:44.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Maaf.
Dialogue: 0,0:10:50.02,0:10:54.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja, beres-beres adalah tugasku.
Dialogue: 0,0:10:54.40,0:10:56.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak perlu minta maaf.
Dialogue: 0,0:10:57.44,0:11:01.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan sisanya padaku\Ndan tenangkanlah dirimu.
Dialogue: 0,0:11:11.83,0:11:13.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gabuchan, kamu berat.
Dialogue: 0,0:11:15.96,0:11:18.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidurmu nyenyak?
Dialogue: 0,0:11:21.26,0:11:24.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bermimpi buruk.
Dialogue: 0,0:11:25.39,0:11:29.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh. Ayo makan dan lupakan.
Dialogue: 0,0:11:29.73,0:11:32.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di dapur ada makanan apa, ya?
Dialogue: 0,0:11:34.94,0:11:37.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat pagi, meski sudah siang.
Dialogue: 0,0:11:37.44,0:11:41.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Natsuki? Kamu menjaga kami?
Dialogue: 0,0:11:41.57,0:11:46.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat situasi mereda,\Nmungkin saja kamu diincar lagi.
Dialogue: 0,0:11:46.87,0:11:49.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Untungnya aman.\N- Kamu bergadang?
Dialogue: 0,0:11:49.29,0:11:50.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:11:51.12,0:11:54.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau mandi dulu.\NKuserahkan padamu, Gabuchan.
Dialogue: 0,0:11:54.33,0:11:55.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap.
Dialogue: 0,0:11:55.54,0:11:56.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Natsuki!
Dialogue: 0,0:11:58.55,0:11:59.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf…
Dialogue: 0,0:12:04.34,0:12:05.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:12:07.72,0:12:09.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah aku selesai mandi,
Dialogue: 0,0:12:09.85,0:12:12.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita belajar matematika lagi.
Dialogue: 0,0:12:14.02,0:12:15.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di situasi begini\Nkenapa enggak libur, sih?
Dialogue: 0,0:12:16.48,0:12:19.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bergadang tidak baik buat kulit, lo.
Dialogue: 0,0:12:19.53,0:12:21.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidurlah sebentar, Natsuki.
Dialogue: 0,0:12:21.28,0:12:23.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul, Kak Natsuki tidur saja!
Dialogue: 0,0:12:27.41,0:12:28.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke.
Dialogue: 0,0:12:28.66,0:12:32.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan tidur pulas\Nsehabis PR kalian selesai.
Dialogue: 0,0:12:32.91,0:12:36.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Cepat selesaikan biar aku tidur.
Dialogue: 0,0:12:36.21,0:12:37.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kejam!
Dialogue: 0,0:12:38.67,0:12:42.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Apa soal ini bisa kupecahkan pakai Kai?
Dialogue: 0,0:12:42.09,0:12:45.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Masa Tsugai legendaris\Ndipakai buat begituan!
Dialogue: 0,0:12:55.73,0:12:56.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Natsuki.
Dialogue: 0,0:13:00.44,0:13:03.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Ini dari Jin, kamu disuruh istirahat.
Dialogue: 0,0:13:08.12,0:13:10.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Haruo, ayo minum-minum.
Dialogue: 0,0:13:10.49,0:13:12.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Ayo minum lalu tidur.
Dialogue: 0,0:13:13.37,0:13:15.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita pikirkan soal Akio lagi nanti.
Dialogue: 0,0:13:16.79,0:13:20.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bergadang dan minum alkohol?\NNanti kulitmu tambah rusak, Natsuki.
Dialogue: 0,0:13:22.84,0:13:25.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu akan kubuat tidur selamanya, Haruo!
Dialogue: 0,0:13:25.13,0:13:25.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan.
Dialogue: 0,0:13:32.31,0:13:33.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sip!
Dialogue: 0,0:13:33.85,0:13:35.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:13:35.02,0:13:35.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamus elektronik.
Dialogue: 0,0:13:36.56,0:13:40.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belikan biar dia bisa\Nmencari tahu kata baru.
Dialogue: 0,0:13:40.31,0:13:45.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di dataran rendah banyak kata\Nyang bisa kubaca tapi entah apa artinya.
Dialogue: 0,0:13:45.32,0:13:47.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi tidak perlu banyak tanya.
Dialogue: 0,0:13:47.82,0:13:50.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Oh, tinggal ketik saja, ya.
Dialogue: 0,0:13:50.78,0:13:51.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Sip.
Dialogue: 0,0:13:52.49,0:13:56.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yuru,\Nbagaimana caramu belajar waktu di desa?
Dialogue: 0,0:13:56.41,0:13:59.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku membaca buku-buku yang Dera bawakan.
Dialogue: 0,0:14:00.04,0:14:01.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Contohnya buku Sun Tzu.
Dialogue: 0,0:14:01.13,0:14:04.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luar biasa! Orang barbar terpelajar!
Dialogue: 0,0:14:04.76,0:14:07.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Meski aku tidak paham isinya, sih.{\i0}
Dialogue: 0,0:14:08.05,0:14:11.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eng… Eh, bagaimana ini?
Dialogue: 0,0:14:11.80,0:14:15.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya aku juga masih coba-coba.
Dialogue: 0,0:14:18.56,0:14:21.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Nih.\N- Terima kasih.
Dialogue: 0,0:14:21.06,0:14:25.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Azami, mendadak tinggal di dataran rendah\Nmembuatmu bingung, kan?
Dialogue: 0,0:14:25.40,0:14:27.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kamu tidak apa-apa?\N- Iya.
Dialogue: 0,0:14:28.20,0:14:33.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlalu banyak hal aneh\Ndan tidak masuk akal.
Dialogue: 0,0:14:33.03,0:14:37.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi akhirnya aku terbiasa.
Dialogue: 0,0:14:37.29,0:14:38.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita senasib!
Dialogue: 0,0:14:39.37,0:14:41.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Terus, nasinya enak.\N- Iya, kan?
Dialogue: 0,0:14:42.59,0:14:45.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah Azami mulai ceria lagi.
Dialogue: 0,0:14:45.88,0:14:46.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:14:46.88,0:14:50.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi… Pasti dia ingin pulang ke desa.
Dialogue: 0,0:14:50.47,0:14:51.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}- Hebat!\N- Iya.
Dialogue: 0,0:14:51.55,0:14:54.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Bagaimana kabar Ibu, ya?
Dialogue: 0,0:14:56.06,0:14:57.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cerialah!
Dialogue: 0,0:14:57.43,0:15:00.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau murung nanti nasib baik pergi.
Dialogue: 0,0:15:00.23,0:15:01.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penjaga Ilahi Sayuu!
Dialogue: 0,0:15:01.85,0:15:04.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, tubuh kalian sudah dilem?
Dialogue: 0,0:15:04.98,0:15:07.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya! Seperti semula.
Dialogue: 0,0:15:07.65,0:15:09.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski belum sepenuhnya, sih.
Dialogue: 0,0:15:10.11,0:15:13.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Lem batu yang Dera beli sangat manjur.
Dialogue: 0,0:15:13.57,0:15:15.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Ditebas jutaan kali pun\Naman selama ada ini.
Dialogue: 0,0:15:16.79,0:15:19.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sampai ditebas, dong.
Dialogue: 0,0:15:20.92,0:15:22.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo?
Dialogue: 0,0:15:22.92,0:15:25.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, di mana Dera?
Dialogue: 0,0:15:44.15,0:15:47.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Abang kalah, kan?\N- Kamu juga?
Dialogue: 0,0:15:47.15,0:15:51.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku mau cari nafkah buat anak.
Dialogue: 0,0:15:51.61,0:15:54.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku buat melunasi utang.
Dialogue: 0,0:15:54.62,0:15:57.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan aku sampai\Npinjam uang buat judi ini.
Dialogue: 0,0:15:58.41,0:16:02.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu harus menang demi nafkah anakmu!
Dialogue: 0,0:16:02.75,0:16:03.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepakat!
Dialogue: 0,0:16:05.50,0:16:06.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sampah.{\i0}
Dialogue: 0,0:16:06.42,0:16:09.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, saatnya utang lagi!
Dialogue: 0,0:16:16.01,0:16:17.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah.
Dialogue: 0,0:16:17.35,0:16:18.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waduh.
Dialogue: 0,0:16:19.93,0:16:23.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Ada panggilan dari pihak Desa Higashi.
Dialogue: 0,0:16:23.06,0:16:25.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para petinggi disuruh berkumpul.
Dialogue: 0,0:16:26.61,0:16:29.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengirim emailnya si Bandit.
Dialogue: 0,0:16:29.23,0:16:30.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Mereka?
Dialogue: 0,0:16:31.11,0:16:34.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti mau bahas gudang Fujimurayama\Nbuat memojokkan Dera
Dialogue: 0,0:16:34.61,0:16:37.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}agar menyerahkan Yuru.
Dialogue: 0,0:16:37.62,0:16:39.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti begitu.
Dialogue: 0,0:16:39.62,0:16:42.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar aku habisi mereka semua.
Dialogue: 0,0:16:42.62,0:16:43.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan.
Dialogue: 0,0:16:43.96,0:16:46.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, Hidari benar!
Dialogue: 0,0:16:47.21,0:16:50.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya kami belum sepenuhnya pulih.
Dialogue: 0,0:16:50.38,0:16:53.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak adil kalau kamu memburu\Nmereka sendirian.
Dialogue: 0,0:16:53.97,0:16:54.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:16:55.63,0:16:58.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar berburu sama-sama,\Nharus menunggu kalian pulih, ya?
Dialogue: 0,0:16:59.47,0:17:01.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mereka pikir ini rekreasi!{\i0}
Dialogue: 0,0:17:01.81,0:17:05.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Petinggi Desa Higashi sebagian besar\Npunya Tsugai, hati-hati.
Dialogue: 0,0:17:06.48,0:17:08.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya, aku mau bolos.
Dialogue: 0,0:17:08.73,0:17:10.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Curang banget!
Dialogue: 0,0:17:10.27,0:17:14.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku juga bolos nanti mereka curiga!
Dialogue: 0,0:17:19.87,0:17:23.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo semuanya.
Dialogue: 0,0:17:23.70,0:17:25.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Penggali Kubur.
Dialogue: 0,0:17:25.33,0:17:27.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hana, lama tidak berjumpa.
Dialogue: 0,0:17:27.12,0:17:28.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu masih hidup?
Dialogue: 0,0:17:28.79,0:17:31.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak itu, Tadera tidak berkabar?
Dialogue: 0,0:17:31.38,0:17:34.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, memangnya Dera tidak datang?
Dialogue: 0,0:17:34.13,0:17:38.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, emailku bahkan tidak dibalas.
Dialogue: 0,0:17:38.09,0:17:41.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo? Kok aneh?
Dialogue: 0,0:17:41.56,0:17:44.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami bertemu di gudang Fujimurayama.
Dialogue: 0,0:17:44.93,0:17:49.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi dia tidak mau menyerahkan Yuru\Ndan menolak membantu Desa Higashi.
Dialogue: 0,0:17:49.06,0:17:51.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mengkhianati desa?
Dialogue: 0,0:17:51.48,0:17:55.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti dia berniat mengambil Fuu\Nuntuk kepentingan pribadi!
Dialogue: 0,0:17:55.78,0:17:57.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh bengis!
Dialogue: 0,0:17:57.28,0:18:00.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senior sialan itu harus diberi pelajaran!
Dialogue: 0,0:18:00.99,0:18:03.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia sangat benci Tadera.{\i0}
Dialogue: 0,0:18:07.16,0:18:08.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Presdir datang.
Dialogue: 0,0:18:23.60,0:18:25.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya sudah berkumpul?
Dialogue: 0,0:18:26.10,0:18:27.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadera tidak datang.
Dialogue: 0,0:18:28.27,0:18:29.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga.
Dialogue: 0,0:18:30.15,0:18:31.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo.
Dialogue: 0,0:18:31.94,0:18:33.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lama tidak berjumpa.
Dialogue: 0,0:18:34.02,0:18:35.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, ada pesan dari Jiro.
Dialogue: 0,0:18:36.65,0:18:37.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Presdir?
Dialogue: 0,0:18:38.20,0:18:41.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pengurus pihak Desa Higashi\Ndi dataran rendah.
Dialogue: 0,0:18:41.53,0:18:45.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ogah cari ribut dengannya,\Nkarena kami diberi pekerjaan olehnya.
Dialogue: 0,0:18:46.20,0:18:48.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayangnya dia juga ingin Fuu dan Kai
Dialogue: 0,0:18:48.58,0:18:51.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}agar Desa Higashi menguasai dunia.
Dialogue: 0,0:18:52.38,0:18:55.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar Tadera Ryuu sang Abdi
Dialogue: 0,0:18:55.09,0:18:59.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}membawa Yuru bersembunyi, Penggali Kubur.
Dialogue: 0,0:18:59.13,0:19:01.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Parah banget, ya.
Dialogue: 0,0:19:01.89,0:19:04.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadera tidak menghubungimu?
Dialogue: 0,0:19:04.26,0:19:06.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti yang kujelaskan ke si Bandit.
Dialogue: 0,0:19:06.64,0:19:11.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah aku mengantar mereka\Nke dekat markasnya Dera.
Dialogue: 0,0:19:11.15,0:19:12.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami hilang kontak.
Dialogue: 0,0:19:13.06,0:19:15.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu tidak mengabari kami
Dialogue: 0,0:19:15.52,0:19:18.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau telah membawa Yuru keluar desa?
Dialogue: 0,0:19:18.65,0:19:21.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untung kami diberi tahu si Dukun.
Dialogue: 0,0:19:21.70,0:19:26.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak, bahkan kami tidak akan tahu\Nbahwa desa telah diserang.
Dialogue: 0,0:19:26.12,0:19:27.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan salahkan aku, lah!
Dialogue: 0,0:19:28.37,0:19:31.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dera juga tidak memberitahuku apa-apa!
Dialogue: 0,0:19:31.12,0:19:32.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:19:32.75,0:19:37.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Desa Higashi berantakan\Nsetelah diserang Klan Kagemori.
Dialogue: 0,0:19:37.71,0:19:42.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asa di pihak Kagemori dan sudah dapat Kai.
Dialogue: 0,0:19:42.68,0:19:45.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yuru ada di dataran rendah.
Dialogue: 0,0:19:45.01,0:19:49.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para bandit dibantai,\NDukun dan Tadera tidak ada.
Dialogue: 0,0:19:49.77,0:19:53.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang tahu jalan keluar dari Desa Higashi
Dialogue: 0,0:19:53.27,0:19:55.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}nyaris tidak ada.
Dialogue: 0,0:19:55.77,0:19:59.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau harus terus menunggu\Ninstruksi Nenek Yamaha,
Dialogue: 0,0:19:59.78,0:20:01.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa-bisa kita ketinggalan.
Dialogue: 0,0:20:03.95,0:20:09.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini tugasku yang menetap di sini\Nuntuk ambil alih komando.
Dialogue: 0,0:20:10.04,0:20:11.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Niat busuk?
Dialogue: 0,0:20:11.29,0:20:14.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Dia berniat busuk ke Hana?
Dialogue: 0,0:20:14.37,0:20:16.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si Tua Cabul itu cari mati, ya?
Dialogue: 0,0:20:18.46,0:20:21.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Niat busuknya ke situ? Syukurlah.
Dialogue: 0,0:20:21.80,0:20:24.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lacaklah lokasi Tadera
Dialogue: 0,0:20:24.59,0:20:26.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan temukan Yuru.
Dialogue: 0,0:20:26.72,0:20:27.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dia melawan?
Dialogue: 0,0:20:28.35,0:20:32.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dera tidak punya Tsugai,\Nkita bawa Tsugai petarung saja.
Dialogue: 0,0:20:33.44,0:20:34.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jiro?
Dialogue: 0,0:20:35.19,0:20:36.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:20:42.53,0:20:45.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Bukan barang mencurigakan.
Dialogue: 0,0:20:45.70,0:20:48.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Relik Tsugai?
Dialogue: 0,0:20:48.45,0:20:51.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tsugai itu masih hidup.
Dialogue: 0,0:20:51.79,0:20:54.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami bisa merasakan jiwanya.
Dialogue: 0,0:20:55.17,0:20:56.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tsugai punya siapa?
Dialogue: 0,0:20:56.96,0:20:59.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa ada di sini?
Dialogue: 0,0:20:59.38,0:21:00.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah.
Dialogue: 0,0:21:00.46,0:21:02.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba buat kontrak dengan mereka.
Dialogue: 0,0:22:46.99,0:22:51.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tsugai yang menempel pada relik\Ndan meledakkannya?
Dialogue: 0,0:22:51.28,0:22:53.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya ada?
Dialogue: 0,0:22:53.28,0:22:54.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mengetahuinya?
Dialogue: 0,0:22:54.58,0:22:58.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak punya informasi soal itu.
Dialogue: 0,0:22:58.08,0:23:00.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tsugai yang asing bagi kita, ya.
Dialogue: 0,0:23:01.25,0:23:05.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari cek Tsugai penduduk wisma,\Ntakutnya ada yang ditempeli.
Dialogue: 0,0:23:06.42,0:23:09.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Usa bilang, mungkin itu Tsugai dari Barat.
Dialogue: 0,0:23:10.38,0:23:11.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Barat?
Dialogue: 0,0:23:12.43,0:23:14.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Barat, jangan-jangan…
Dialogue: 0,0:23:14.93,0:23:17.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, tidak mungkin.
Dialogue: 0,0:23:18.52,0:23:23.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Desa Nishino sudah hancur\Ndan tenggelam di dasar waduk.{\i0}
