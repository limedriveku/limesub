Dialogue: 0,0:01:36.80,0:01:37.51,sign,,0000,0000,0000,,{\an8}SEDANG BEKERJA
Dialogue: 0,0:11:01.66,0:11:02.57,sign,,0000,0000,0000,,{\an8}DALAM PANGGILAN NAKAI
Dialogue: 0,0:15:00.31,0:15:01.65,sign,,0000,0000,0000,,SEDANG MANDI
Dialogue: 0,0:23:27.61,0:23:28.90,sign,,0000,0000,0000,,EPISODE SELANJUTNYA
Dialogue: 0,0:01:35.84,0:01:36.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo.
Dialogue: 0,0:01:37.51,0:01:39.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Iya, ini di tempat kerja.
Dialogue: 0,0:01:40.05,0:01:41.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, tenang saja.
Dialogue: 0,0:01:44.31,0:01:46.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gabuchan, ayo istirahat…
Dialogue: 0,0:01:47.48,0:01:50.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Oh, iya, dia sedang pergi.
Dialogue: 0,0:01:52.11,0:01:54.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo? Kok sendirian?
Dialogue: 0,0:01:55.03,0:01:58.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biasanya bareng Gabuchan terus,
Dialogue: 0,0:01:58.11,0:02:00.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tumben kamu sendirian.
Dialogue: 0,0:02:00.91,0:02:02.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau aku temani?
Dialogue: 0,0:02:03.87,0:02:04.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akio.
Dialogue: 0,0:02:05.87,0:02:08.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benda apa yang kamu sembunyikan?
Dialogue: 0,0:02:09.67,0:02:10.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akio?
Dialogue: 0,0:02:13.67,0:02:16.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eng, aku mau sendirian saja.
Dialogue: 0,0:02:16.76,0:02:17.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa, kok!
Dialogue: 0,0:02:18.55,0:02:20.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhenti, jangan lanjut!
Dialogue: 0,0:02:21.59,0:02:23.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kalau mendekat…{\i0}
Dialogue: 0,0:02:35.44,0:02:36.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat, gawat, gawat!
Dialogue: 0,0:02:37.44,0:02:40.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kabar buruk!\NKepala Klan Kagemori datang kemari!
Dialogue: 0,0:02:41.07,0:02:42.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa?
Dialogue: 0,0:02:42.41,0:02:46.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, dia menghancurkan kantor-kantor\Nyang dinaungi nama Shingo.
Dialogue: 0,0:02:46.74,0:02:47.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sendirian!
Dialogue: 0,0:02:47.75,0:02:49.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sendirian?
Dialogue: 0,0:02:49.71,0:02:52.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tidak, mustahil dia sendirian.{\i0}
Dialogue: 0,0:02:52.13,0:02:55.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kacungnya, Fuyuki dan Natsuki pasti ikut.{\i0}
Dialogue: 0,0:02:55.21,0:02:57.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mereka pasti di sekitar sini!{\i0}
Dialogue: 0,0:02:57.46,0:02:59.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Gonzou si kepala klan memang ngeri.{\i0}
Dialogue: 0,0:02:59.72,0:03:02.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Daftar Hitam milik Fuyuki juga bahaya.{\i0}
Dialogue: 0,0:03:02.64,0:03:05.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tertangkap,\Ninformasi kita bisa bocor semua.
Dialogue: 0,0:03:07.52,0:03:10.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Tapi kalau bisa merampas Tsugai itu,
Dialogue: 0,0:03:12.02,0:03:14.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Bisikan" si lumbung informasi\Nakan jadi milik kita!
Dialogue: 0,0:03:15.23,0:03:18.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di catatan buronan Bos Shingo,
Dialogue: 0,0:03:18.15,0:03:21.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}imbalan membunuh Fuyuki\Ndan merampas Daftar hitam…
Dialogue: 0,0:03:21.36,0:03:22.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senilai 100 juta yen?
Dialogue: 0,0:03:22.61,0:03:23.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}100 juta?
Dialogue: 0,0:03:23.70,0:03:25.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bos kita memang dermawan!
Dialogue: 0,0:03:26.53,0:03:29.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tsugai Fuyuki bukan tipe petarung, kan?
Dialogue: 0,0:03:29.20,0:03:30.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih ada peluang.
Dialogue: 0,0:03:31.12,0:03:34.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, Tsugai Natsuki itu tipe petarung.
Dialogue: 0,0:03:34.71,0:03:38.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tinggal keroyok saja pakai Tsugai kita.
Dialogue: 0,0:03:38.38,0:03:39.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo!
Dialogue: 0,0:03:39.46,0:03:40.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sikat!
Dialogue: 0,0:03:46.47,0:03:50.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Natsuki dan Fuyuki\Nada di atap pusat distribusi kita.{\i0}
Dialogue: 0,0:03:52.94,0:03:54.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Menyusuplah lewat belakang.{\i0}
Dialogue: 0,0:04:01.86,0:04:02.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Incar Fuyuki dulu!{\i0}
Dialogue: 0,0:04:03.82,0:04:05.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Rampas Daftar Hitam-nya!{\i0}
Dialogue: 0,0:04:37.23,0:04:38.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yin-Yang.
Dialogue: 0,0:04:39.40,0:04:42.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian sudah boleh keluar.
Dialogue: 0,0:04:58.42,0:05:01.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang menjauhlah, Akio.
Dialogue: 0,0:05:02.30,0:05:05.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu memasuki wilayahku.
Dialogue: 0,0:05:15.60,0:05:19.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ai. Jangan melahap Akio lebih dari itu.
Dialogue: 0,0:05:19.69,0:05:21.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia harus diinterogasi.
Dialogue: 0,0:05:25.28,0:05:27.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari kapan kamu menyadarinya?
Dialogue: 0,0:05:29.49,0:05:31.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu bertarung dengan Yuru.
Dialogue: 0,0:05:32.24,0:05:36.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku yang seorang pimpinan, tidak diincar.{\i0}
Dialogue: 0,0:05:36.12,0:05:39.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Haruo yang Tsugai-nya bikin repot\Njuga tidak diincar.{\i0}
Dialogue: 0,0:05:40.17,0:05:45.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Yuru justru mengincar kepalamu,\Norang yang tidak memanggil Tsugai.{\i0}
Dialogue: 0,0:05:47.13,0:05:51.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia cuma mengincar nyawa orang\Nyang berniat membunuhnya.
Dialogue: 0,0:05:53.51,0:05:56.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu ingin Yuru mati.
Dialogue: 0,0:05:56.68,0:05:59.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Koordinator penyerangan wisma pun\Nkamu bunuh
Dialogue: 0,0:05:59.90,0:06:02.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin untuk membungkamnya.
Dialogue: 0,0:06:02.32,0:06:04.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah alasanku memasang jebakan ini.
Dialogue: 0,0:06:05.86,0:06:06.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau minum kopi?
Dialogue: 0,0:06:07.28,0:06:09.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, mataku masih melek.
Dialogue: 0,0:06:10.07,0:06:12.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan pihak Desa Higashi
Dialogue: 0,0:06:12.20,0:06:15.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}memberitahumu soal gudang Fujimurayama?
Dialogue: 0,0:06:16.33,0:06:20.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Tidak kusangka kamu\Nakan berkawan dengan mereka.
Dialogue: 0,0:06:20.50,0:06:22.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami tidak berkawan!
Dialogue: 0,0:06:23.46,0:06:24.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayang sekali, Akio.
Dialogue: 0,0:06:25.80,0:06:28.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asa tidak ada di sini.
Dialogue: 0,0:06:29.26,0:06:33.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski tidak sedarah,\Naku memercayaimu karena kita saudara.
Dialogue: 0,0:06:34.76,0:06:37.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyerahlah baik-baik, Akio.
Dialogue: 0,0:06:37.64,0:06:39.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau melukaimu.
Dialogue: 0,0:06:39.77,0:06:42.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mintalah ampunan dari Master.
Dialogue: 0,0:06:43.73,0:06:45.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kutemani agar nyawamu diampuni.
Dialogue: 0,0:06:46.28,0:06:47.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Percuma.
Dialogue: 0,0:06:47.78,0:06:49.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tidak akan mengampuniku.
Dialogue: 0,0:06:55.83,0:06:59.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, ternyata bukan cuma Master.
Dialogue: 0,0:06:59.46,0:07:01.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asa juga tidak di sini, ya.
Dialogue: 0,0:07:03.42,0:07:09.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kuratakan saja tempat ini\Nagar Asa tidak punya tempat sembunyi.
Dialogue: 0,0:07:11.63,0:07:15.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dewa Gunung-ku terlalu besar\Nuntuk dilahap Ai.
Dialogue: 0,0:07:16.43,0:07:19.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kura-kura Haruo pun mustahil menindihnya.
Dialogue: 0,0:07:20.60,0:07:23.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski kelincinya cepat,
Dialogue: 0,0:07:23.19,0:07:25.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}serangannya tidak akan mempan.
Dialogue: 0,0:07:26.48,0:07:29.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian yakin mau bertarung?
Dialogue: 0,0:07:31.74,0:07:32.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh juga.
Dialogue: 0,0:07:33.41,0:07:36.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga ikut, dong.
Dialogue: 0,0:07:38.66,0:07:39.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ga…
Dialogue: 0,0:07:40.20,0:07:43.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tidak, Gabuchan sedang pergi ke luar.{\i0}
Dialogue: 0,0:07:44.58,0:07:47.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Oh, pasti dia palsu!{\i0}
Dialogue: 0,0:07:47.88,0:07:49.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia Tsugai!{\i0}
Dialogue: 0,0:07:49.30,0:07:53.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tsugai Tachikawa Makoto\Nbisa berubah bentuk.{\i0}
Dialogue: 0,0:07:53.55,0:07:56.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dia di tempat gelap\Nbiar bayangannya tersembunyi.{\i0}
Dialogue: 0,0:08:00.77,0:08:05.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti kamu mengira aku palsu, kan?
Dialogue: 0,0:08:06.11,0:08:07.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja.
Dialogue: 0,0:08:08.36,0:08:11.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ini asli. Akio sialan!
Dialogue: 0,0:08:14.53,0:08:16.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, tangkapan besar.
Dialogue: 0,0:08:16.91,0:08:18.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master.
Dialogue: 0,0:08:18.83,0:08:20.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang kembali.
Dialogue: 0,0:08:20.29,0:08:21.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hup.
Dialogue: 0,0:08:22.25,0:08:25.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka semua boleh aku ambil alih?
Dialogue: 0,0:08:25.37,0:08:26.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:08:26.83,0:08:30.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kalian, saatnya ganti tuan.
Dialogue: 0,0:08:44.44,0:08:48.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai sekarang, akulah tuan kalian.
Dialogue: 0,0:09:03.75,0:09:07.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, anak-anak pintar.
Dialogue: 0,0:09:09.21,0:09:10.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Curang banget!
Dialogue: 0,0:09:10.59,0:09:12.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tsugai-ku diambil!
Dialogue: 0,0:09:12.46,0:09:14.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya Tsugai itu perlu kecocokan?
Dialogue: 0,0:09:14.84,0:09:20.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok Tsugai sebanyak itu\Nbisa akur di bawah satu tuan?
Dialogue: 0,0:09:23.72,0:09:26.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tsugai Kagemori Gonzou\Nadalah Parade Monster.{\i0}
Dialogue: 0,0:09:27.77,0:09:32.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Masalah kalau mau punya\Nbanyak Tsugai adalah "kecocokan".{\i0}
Dialogue: 0,0:09:32.86,0:09:34.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tsugai juga punya perasaan.{\i0}
Dialogue: 0,0:09:34.65,0:09:40.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mereka bisa saling merasa cocok\Ndan tidak cocok antara sesamanya.{\i0}
Dialogue: 0,0:09:41.16,0:09:45.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mengontrak dua Tsugai yang tidak cocok\Nbisa memicu perpecahan,{\i0}
Dialogue: 0,0:09:45.08,0:09:48.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}bahkan bisa membahayakan sang tuan.{\i0}
Dialogue: 0,0:09:48.25,0:09:50.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tapi, ada Tsugai yang bisa merukunkan{\i0}
Dialogue: 0,0:09:50.88,0:09:53.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}dan membuat para Tsugai jadi cocok.{\i0}
Dialogue: 0,0:09:54.05,0:09:56.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Itulah kemampuan Parade Monster ini.{\i0}
Dialogue: 0,0:09:57.34,0:10:01.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Dengan kemampuan itu, Kagemori Gonzou bisa{\i0}
Dialogue: 0,0:10:01.72,0:10:05.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}mengontrak Tsugai terus-menerus\Nsesuka hatinya.{\i0}
Dialogue: 0,0:10:06.60,0:10:11.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para Tsugai dibuat liar oleh Kai,\Ndan dipungut oleh Kagemori Gonzou.
Dialogue: 0,0:10:11.61,0:10:15.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu Kuroya Fuyuki tinggal memanen\Ninformasi dari mereka.
Dialogue: 0,0:10:16.53,0:10:19.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mereka trio paling mengerikan!{\i0}
Dialogue: 0,0:10:19.99,0:10:21.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Kai?
Dialogue: 0,0:10:22.41,0:10:25.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu Kepala Klan,\NKuroya bersaudara, dan Gabu di sana.
Dialogue: 0,0:10:25.83,0:10:28.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok ada Asa juga?
Dialogue: 0,0:10:28.12,0:10:30.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asuma, kamu sudah tahu?
Dialogue: 0,0:10:30.75,0:10:33.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, aku bersumpah.
Dialogue: 0,0:10:35.30,0:10:36.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ivan di mana?
Dialogue: 0,0:10:36.51,0:10:37.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suruh dia ke Gonzou!
Dialogue: 0,0:10:38.05,0:10:39.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Asa juga ikut, ya.{\i0}
Dialogue: 0,0:10:39.38,0:10:41.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Dia tidak di situ?
Dialogue: 0,0:10:41.72,0:10:43.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bedebah itu!
Dialogue: 0,0:10:43.14,0:10:46.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Percuma dibayar mahal!
Dialogue: 0,0:10:50.73,0:10:52.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan ada yang bergerak.
Dialogue: 0,0:10:54.69,0:10:57.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bergerak sedikit, dia aku cekik.
Dialogue: 0,0:10:57.78,0:10:59.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Bos, ada apa?{\i0}
Dialogue: 0,0:10:59.49,0:11:01.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini namanya ponsel, kan?
Dialogue: 0,0:11:02.57,0:11:04.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku pinjam benda ini.
Dialogue: 0,0:11:14.88,0:11:15.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:11:16.46,0:11:19.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang pergi justru Tsugai\Nmilik Tachikawa Makoto, ya.
Dialogue: 0,0:11:20.51,0:11:24.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan adanya Tsugai penyamar,\Nskema kami makin beragam.
Dialogue: 0,0:11:25.76,0:11:29.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pura-pura jadi keluarga\Nyang menelepon,
Dialogue: 0,0:11:29.06,0:11:31.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}supaya Tachikawa keluar ruangan.
Dialogue: 0,0:11:32.31,0:11:34.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata dia pandai berakting.
Dialogue: 0,0:11:34.69,0:11:38.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asa dibuat kebetulan seorang diri
Dialogue: 0,0:11:38.28,0:11:40.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}agar aku terpancing, ya.
Dialogue: 0,0:11:41.95,0:11:45.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bagus kalau perempuan\Npandai berbohong.
Dialogue: 0,0:11:46.70,0:11:48.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat tanduk Tsugai-mu!
Dialogue: 0,0:11:48.87,0:11:55.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah lupa\Nsiapa yang mematahkannya, Akio?
Dialogue: 0,0:12:00.30,0:12:04.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dulu sudah terbukti\Nsiapa yang lebih kuat, kan?
Dialogue: 0,0:12:13.94,0:12:16.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cabik dia perlahan-lahan, Gabriel.
Dialogue: 0,0:12:18.23,0:12:20.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jin, tolong bersihkan, ya.
Dialogue: 0,0:12:21.61,0:12:23.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan padaku.
Dialogue: 0,0:12:23.86,0:12:26.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi jangan sampai Akio\Ndan Dewa Gunung mati.
Dialogue: 0,0:12:31.33,0:12:33.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak yakin bisa!
Dialogue: 0,0:12:47.47,0:12:48.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gempa bumi?
Dialogue: 0,0:12:50.35,0:12:51.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hup?
Dialogue: 0,0:12:51.47,0:12:52.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ha.
Dialogue: 0,0:12:52.93,0:12:55.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua orang, cepat kabur!
Dialogue: 0,0:12:55.35,0:12:56.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tachikawa?
Dialogue: 0,0:12:56.77,0:12:57.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kenapa?
Dialogue: 0,0:12:57.94,0:12:59.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jin berpesan,
Dialogue: 0,0:12:59.52,0:13:02.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jauhi ruangan Hagure Sensei.
Dialogue: 0,0:13:02.19,0:13:04.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampaikan ke semua penghuni wisma!
Dialogue: 0,0:13:04.65,0:13:05.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:13:12.87,0:13:14.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu…
Dialogue: 0,0:13:14.16,0:13:16.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akio mengeluarkan Dewa Gunung-nya!
Dialogue: 0,0:13:16.67,0:13:19.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Musuh dari luar masuk lagi?
Dialogue: 0,0:13:19.54,0:13:21.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan dari luar.
Dialogue: 0,0:13:21.92,0:13:23.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi dari dalam.
Dialogue: 0,0:13:25.97,0:13:27.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah sejak lama.
Dialogue: 0,0:13:49.45,0:13:52.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayaknya Gabriel lawan yang buruk.
Dialogue: 0,0:13:52.58,0:13:56.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yamakaze, habisi Gabuchan lebih dulu.
Dialogue: 0,0:14:06.17,0:14:07.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Woi, Gabriel!
Dialogue: 0,0:14:07.88,0:14:12.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan keasyikan sama musuh!\NLindungi tuanmu!
Dialogue: 0,0:14:12.05,0:14:15.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tsugai sama tuannya sesama sumbu pendek!
Dialogue: 0,0:14:17.81,0:14:19.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Haruo…{\i0}
Dialogue: 0,0:14:22.57,0:14:23.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanikaze!
Dialogue: 0,0:14:32.62,0:14:33.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kame!
Dialogue: 0,0:14:33.58,0:14:35.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tidak berdaya!
Dialogue: 0,0:14:38.50,0:14:40.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu saja!
Dialogue: 0,0:14:40.17,0:14:42.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah mengunyah mereka,\Nselanjutnya kamu, Akio!
Dialogue: 0,0:14:43.34,0:14:46.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gabuchan, jangan membunuh\NAkio dan Tsugai-nya!
Dialogue: 0,0:14:46.13,0:14:49.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagian Master juga akan membunuh mereka!
Dialogue: 0,0:14:56.43,0:14:58.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sebelum Bos pulang,{\i0}
Dialogue: 0,0:14:58.23,0:15:00.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}bisa-bisa kita dibunuh\NHagure Sensei duluan.{\i0}
Dialogue: 0,0:15:05.36,0:15:08.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bilang apa kamu tadi, Akio sialan?
Dialogue: 0,0:15:09.19,0:15:13.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau meratakan saja tempat ini\Nagar Asa tidak punya tempat sembunyi?
Dialogue: 0,0:15:15.70,0:15:17.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa diampuni.
Dialogue: 0,0:15:18.08,0:15:21.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Dia diharapkan mati sejak lahir\Noleh para orang dewasa!
Dialogue: 0,0:15:21.87,0:15:23.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Hidup di dalam kurungan!
Dialogue: 0,0:15:24.42,0:15:27.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Dijauhkan dari hidup bebas\Ndi dataran rendah!
Dialogue: 0,0:15:29.01,0:15:32.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat akhirnya bisa kabur\Ndengan orang tuanya,
Dialogue: 0,0:15:33.05,0:15:35.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}nyawanya masih diincar!
Dialogue: 0,0:15:35.35,0:15:39.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat sedikit aman setelah pelarian\Nbertahun-tahun, orang tuanya diculik!
Dialogue: 0,0:15:39.10,0:15:42.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Neneknya saja tidak bisa dipercaya lagi!
Dialogue: 0,0:15:42.85,0:15:46.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asa tidak tahu lagi harus ke mana!
Dialogue: 0,0:15:46.69,0:15:51.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya di wisma Kagemori,\Ndia bisa sedikit bebas.
Dialogue: 0,0:15:51.53,0:15:55.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meskipun kecil,\Nakhirnya Asa punya tempat aman.
Dialogue: 0,0:15:56.28,0:15:58.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan itu mau dirampas juga?
Dialogue: 0,0:15:59.95,0:16:02.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana bisa kuampuni!
Dialogue: 0,0:16:28.48,0:16:29.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah cukup.
Dialogue: 0,0:16:33.24,0:16:35.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yamakaze, Tanikaze.
Dialogue: 0,0:16:36.66,0:16:39.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu menemaniku hingga akhir.
Dialogue: 0,0:16:40.54,0:16:42.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kontrak kita berakhir.
Dialogue: 0,0:16:43.04,0:16:44.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pulanglah ke tempat asalmu.
Dialogue: 0,0:16:49.50,0:16:50.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka kabur!
Dialogue: 0,0:16:51.55,0:16:53.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu lupa, ya, Akio?
Dialogue: 0,0:16:54.09,0:16:56.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wisma Kagemori dipasangi pelindung.
Dialogue: 0,0:17:07.77,0:17:09.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka akan kami ambil nanti.
Dialogue: 0,0:17:12.36,0:17:13.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akio…
Dialogue: 0,0:17:21.41,0:17:23.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Hentikan!\N- Gabuchan!
Dialogue: 0,0:17:23.16,0:17:24.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Dasar bodoh!\N- Krauk.
Dialogue: 0,0:17:47.56,0:17:50.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ada anak nakal?
Dialogue: 0,0:17:51.07,0:17:53.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ada anak cengeng?
Dialogue: 0,0:17:58.16,0:18:00.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gabuchan, jangan membunuhnya.
Dialogue: 0,0:18:03.87,0:18:05.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan menahanku, Kak Natsuki.
Dialogue: 0,0:18:06.83,0:18:07.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak boleh.
Dialogue: 0,0:18:08.62,0:18:13.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan seenaknya mewakili perasaan Asa.
Dialogue: 0,0:18:14.80,0:18:17.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ada anak cengeng?
Dialogue: 0,0:18:19.26,0:18:22.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Iya, iya, baiklah.
Dialogue: 0,0:18:23.26,0:18:25.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menahan diri dulu.
Dialogue: 0,0:18:28.23,0:18:30.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ada anak nakal?
Dialogue: 0,0:18:31.23,0:18:34.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Natsuki dan Namomihagi juga ada di sini, ya.{\i0}
Dialogue: 0,0:18:36.57,0:18:39.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jin, Haruo, Gabuchan, bahkan Natsuki.
Dialogue: 0,0:18:40.20,0:18:43.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang butuh seramai ini buat melawanku?
Dialogue: 0,0:18:43.62,0:18:47.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru karena kami tidak meremehkanmu.
Dialogue: 0,0:18:47.20,0:18:51.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Target kami adalah\Nmenangkapmu hidup-hidup.
Dialogue: 0,0:18:52.00,0:18:56.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahaya kalau tanggung-tanggung.\NBisa-bisa ada yang mati.
Dialogue: 0,0:18:57.01,0:19:01.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku merasa terhormat dinilai setinggi itu.
Dialogue: 0,0:19:06.10,0:19:08.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, Akio! Akio!
Dialogue: 0,0:19:09.85,0:19:11.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tidak dikejar?
Dialogue: 0,0:19:11.98,0:19:12.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:19:13.52,0:19:18.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Dia akan berjumpa akhir yang mengenaskan.
Dialogue: 0,0:19:22.57,0:19:24.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aku tidak dikejar?{\i0}
Dialogue: 0,0:19:24.49,0:19:25.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Aneh sekali.{\i0}
Dialogue: 0,0:19:35.04,0:19:36.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tachikawa Makoto dan…{\i0}
Dialogue: 0,0:19:48.31,0:19:50.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Kantung peli…{\i0}
Dialogue: 0,0:19:53.52,0:19:55.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Sial banget.{\i0}
Dialogue: 0,0:19:56.23,0:19:59.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}{\i1}Halo? Halo, Bos Shingo?{\i0}
Dialogue: 0,0:19:59.86,0:20:02.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Eng, jadi…\N{\i1}- Bos?{\i0}
Dialogue: 0,0:20:02.57,0:20:04.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tinggal bicara saja, kan?\N{\i1}- Hei.{\i0}
Dialogue: 0,0:20:04.53,0:20:08.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul, jangan menyentuh layar\Nkalau tidak perlu.
Dialogue: 0,0:20:08.91,0:20:12.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bergerak, nanti dia aku cekik.
Dialogue: 0,0:20:12.21,0:20:13.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, iya.
Dialogue: 0,0:20:14.25,0:20:17.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dibunuh juga tidak apa-apa, kok.
Dialogue: 0,0:20:18.34,0:20:19.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bilang apa tadi?
Dialogue: 0,0:20:19.80,0:20:20.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada.
Dialogue: 0,0:20:21.47,0:20:25.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kamu. Bawahan Shingo, kan?
Dialogue: 0,0:20:25.05,0:20:26.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Siapa ini?{\i0}
Dialogue: 0,0:20:26.39,0:20:28.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ini aku.\N{\i1}- Ya, siapa?{\i0}
Dialogue: 0,0:20:28.81,0:20:30.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si anak kembar.
Dialogue: 0,0:20:30.85,0:20:32.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia Yuru dari Desa Higashi!
Dialogue: 0,0:20:32.31,0:20:35.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lah, kok dia pakai ponsel Bos Shingo?
Dialogue: 0,0:20:35.23,0:20:38.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Om-om ini sudah disandera.
Dialogue: 0,0:20:38.52,0:20:40.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyawanya ada di tanganku!
Dialogue: 0,0:20:40.57,0:20:41.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Hah?{\i0}
Dialogue: 0,0:20:41.57,0:20:43.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bicaranya kayak penjahat.
Dialogue: 0,0:20:43.61,0:20:48.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mau dia selamat,\Nbebaskan anak-anak yang kalian sandera.
Dialogue: 0,0:20:48.03,0:20:48.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Apa?{\i0}
Dialogue: 0,0:20:50.79,0:20:51.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bos Shingo!
Dialogue: 0,0:20:51.91,0:20:53.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu minta aku habisi?
Dialogue: 0,0:20:54.54,0:20:57.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, datanglah kalau mau membunuhku.
Dialogue: 0,0:20:59.59,0:21:02.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu benar-benar bocah liar.
Dialogue: 0,0:21:03.13,0:21:03.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fuujin.
Dialogue: 0,0:21:14.52,0:21:15.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Raijin.
Dialogue: 0,0:21:26.20,0:21:30.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata kamu lebih barbar\Ndari yang digosipkan.
Dialogue: 0,0:21:30.70,0:21:33.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Ada sandera saja masih berani melawan.
Dialogue: 0,0:21:34.41,0:21:36.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Yuru.
Dialogue: 0,0:21:36.96,0:21:38.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo bicara dengan damai.
Dialogue: 0,0:21:39.84,0:21:44.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Orang di sini beradab,\Nbeda sama di desamu.
Dialogue: 0,0:21:44.42,0:21:46.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua bisa dibicarakan.
Dialogue: 0,0:21:49.18,0:21:53.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini-begini, aku cinta damai, lo.
Dialogue: 0,0:23:29.49,0:23:31.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Tsugai om ini pengendali petir dan angin!{\i0}
Dialogue: 0,0:23:31.99,0:23:34.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Mereka Tsugai-ku, Fuujin dan Raijin.{\i0}
Dialogue: 0,0:23:35.08,0:23:37.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\i1}Salam kenal, Yuru.{\i0}
