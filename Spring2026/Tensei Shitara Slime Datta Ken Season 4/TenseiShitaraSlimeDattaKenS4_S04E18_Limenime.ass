Dialogue: 0,0:03:06.25,0:03:09.42,sign,,0000,0000,0000,,"KERAJAAN INGRASSIA, DEKAT PERBATASAN UTARA"
Dialogue: 0,0:03:26.39,0:03:28.65,sign,,0000,0000,0000,,KERAJAAN INGRASSIA\NIBU KOTA LURA
Dialogue: 0,0:03:36.86,0:03:39.07,sign,,0000,0000,0000,,KERAJAAN INGRASSIA\NMARKAS BESAR DEWAN NEGARA-NEGARA BARAT
Dialogue: 0,0:05:26.22,0:05:31.02,sign,,0000,0000,0000,,EPISODE 90: GEJOLAK DI BARAT
Dialogue: 0,0:24:08.80,0:24:10.92,sign,,0000,0000,0000,,KEMATIAN DAN KEHILANGAN
Dialogue: 0,0:00:11.85,0:00:14.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata kamu juga ada di sini,
Dialogue: 0,0:00:14.36,0:00:15.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rouge.
Dialogue: 0,0:00:15.45,0:00:16.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan.
Dialogue: 0,0:00:16.16,0:00:18.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang namamu Guy Crimson.
Dialogue: 0,0:00:18.93,0:00:22.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yo, lama tidak berjumpa, Noir.
Dialogue: 0,0:00:22.83,0:00:24.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa ada di sini?
Dialogue: 0,0:00:24.56,0:00:25.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada kerjaan, ya?
Dialogue: 0,0:00:25.80,0:00:28.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, sapaan macam apa itu?
Dialogue: 0,0:00:28.71,0:00:30.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daripada itu,
Dialogue: 0,0:00:30.53,0:00:34.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dari awal kamu tahu lawanmu\Nadalah tubuh bayangan Rain, Mist,
Dialogue: 0,0:00:35.04,0:00:38.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kenapa sampai mengeluarkan\Njurus pemungkas?
Dialogue: 0,0:00:38.02,0:00:40.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bercanda.
Dialogue: 0,0:00:40.05,0:00:44.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin tipuan murahan semacam itu\Nbisa mengalahkan Primordial seperti kita?
Dialogue: 0,0:00:44.27,0:00:48.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sampai terkena serangan langsung,\Nbahkan aku pun bisa terluka, lo.
Dialogue: 0,0:00:48.15,0:00:50.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga bisa musnah.
Dialogue: 0,0:00:50.76,0:00:53.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau terkena serangan langsung.
Dialogue: 0,0:01:04.92,0:01:08.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata kamu benaran berevolusi.
Dialogue: 0,0:01:08.87,0:01:11.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru, kenapa tidak dari dulu?
Dialogue: 0,0:01:11.68,0:01:16.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guy, apa ada sosok yang lebih kuat\Ndari kita di dunia ini?
Dialogue: 0,0:01:16.43,0:01:18.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada.
Dialogue: 0,0:01:18.17,0:01:22.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paling Naga Sejati, tapi mereka\Nlebih seperti fenomena alam.
Dialogue: 0,0:01:23.27,0:01:26.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, kita yang terkuat.
Dialogue: 0,0:01:26.20,0:01:28.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya kalau berevolusi,
Dialogue: 0,0:01:28.31,0:01:32.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pertarungan akan berat sebelah\Ndan membosankan, bukan?
Dialogue: 0,0:01:32.57,0:01:34.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:01:34.47,0:01:37.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyebabmu berevolusi adalah
Dialogue: 0,0:01:37.24,0:01:38.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pengaruh dari slime itu...
Dialogue: 0,0:01:38.87,0:01:40.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Rimuru.
Dialogue: 0,0:01:41.66,0:01:47.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, penyebabmu berevolusi\Nadalah si Rimuru itu, kan?
Dialogue: 0,0:01:47.69,0:01:49.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:01:49.55,0:01:51.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alasannya adalah...
Dialogue: 0,0:01:51.22,0:01:54.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perkembangan Tuan Rimuru\Nsungguh menakjubkan!
Dialogue: 0,0:01:54.28,0:01:57.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan pantas disebut evolusi sejati!
Dialogue: 0,0:01:57.17,0:02:00.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sosoknya begitu imut,\Ndan jiwanya sangat mulia...
Dialogue: 0,0:02:00.85,0:02:02.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bakal lama?
Dialogue: 0,0:02:02.77,0:02:03.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cih.
Dialogue: 0,0:02:03.48,0:02:04.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:02:05.23,0:02:10.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, rekan-rekan Tuan Rimuru pun\Nmakin kuat tiap harinya.
Dialogue: 0,0:02:11.27,0:02:15.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan mereka bisa melampauiku\Nkalau aku bermalas-malasan.
Dialogue: 0,0:02:15.11,0:02:17.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena berada di lingkungan sehebat itu,
Dialogue: 0,0:02:17.85,0:02:21.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku sudah tidak punya alasan\Nmembatasi perkembangan.
Dialogue: 0,0:02:23.05,0:02:26.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu yang bisa mengimbangiku bilang begitu?
Dialogue: 0,0:02:26.13,0:02:28.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, sayang sekali.
Dialogue: 0,0:02:28.03,0:02:32.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hal buruk akan terjadi pada si Rimuru itu.
Dialogue: 0,0:02:33.76,0:02:36.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak buahku akan membuat kekacauan
Dialogue: 0,0:02:36.91,0:02:39.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di Negara-Negara Barat yang dikuasainya.
Dialogue: 0,0:02:41.12,0:02:43.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata memang tidak ada kerjaan.
Dialogue: 0,0:02:43.43,0:02:45.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa tujuanmu?
Dialogue: 0,0:02:45.39,0:02:49.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya ingin sedikit\Nmengusili umat manusia.
Dialogue: 0,0:02:49.65,0:02:50.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh.
Dialogue: 0,0:02:50.65,0:02:54.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagi Rimuru yang ingin hidup berdampingan\Ndengan manusia,
Dialogue: 0,0:02:54.35,0:02:56.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jelas akan menjadi urusannya.
Dialogue: 0,0:02:58.91,0:03:01.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata sindiran makin mempan\Nkalau bawa-bawa Rimuru.
Dialogue: 0,0:03:02.97,0:03:06.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, tanpa kita turun tangan pun,
Dialogue: 0,0:03:06.25,0:03:09.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}para manusia itu akan bertindak sesuka hati.
Dialogue: 0,0:03:12.36,0:03:13.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau terus begini...
Dialogue: 0,0:03:17.76,0:03:18.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial.
Dialogue: 0,0:03:18.76,0:03:21.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang dilakukan Margrave Cidre?
Dialogue: 0,0:03:31.52,0:03:33.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa iblis sampai ada di sini?
Dialogue: 0,0:03:34.33,0:03:36.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertahankan penghalangnya!
Dialogue: 0,0:03:39.07,0:03:41.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dibiarkan, mereka bisa masuk ibu kota!
Dialogue: 0,0:03:41.49,0:03:43.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana bala bantuannya?
Dialogue: 0,0:03:43.33,0:03:46.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertahankan penghalangnya\Nbagaimanapun caranya!
Dialogue: 0,0:03:46.55,0:03:50.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Negara-Negara Barat pasti sedang kacau.
Dialogue: 0,0:03:50.75,0:03:54.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan berubah\Nmenjadi neraka dunia dalam sekejap.
Dialogue: 0,0:05:24.72,0:05:25.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}(Tensura) Bereinkarnasi Malah Menjadi Slime
Dialogue: 0,0:05:34.31,0:05:35.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ikuti aku.
Dialogue: 0,0:05:35.13,0:05:35.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:05:39.99,0:05:42.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa sangka akan jadi begini...
Dialogue: 0,0:05:42.17,0:05:44.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa sudah ada yang punya solusi?
Dialogue: 0,0:05:44.77,0:05:46.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak segera bertindak,\Nsemua akan terlambat!
Dialogue: 0,0:05:47.45,0:05:49.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya.
Dialogue: 0,0:05:49.08,0:05:50.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya sudah siap.
Dialogue: 0,0:05:51.37,0:05:54.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekalipun takdir Rozzo telah berakhir,\Nkehormatan kami tidak akan hilang!
Dialogue: 0,0:05:54.95,0:05:58.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus menuntaskan tugas\Ndemi Tuan Granville!
Dialogue: 0,0:06:00.48,0:06:02.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hadirin, harap tenang!
Dialogue: 0,0:06:02.93,0:06:08.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Prioritas kita adalah mengumpulkan pasukan\Ntiap negara untuk membentuk Pasukan Sekutu!
Dialogue: 0,0:06:08.85,0:06:11.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Testarossa, wakil resmi Tuan Rimuru,
Dialogue: 0,0:06:11.97,0:06:14.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sangat ahli dalam strategi militer.
Dialogue: 0,0:06:14.67,0:06:17.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu meragukan kemampuannya\Nmemimpin Pasukan Sekutu!
Dialogue: 0,0:06:18.39,0:06:19.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa akan baik-baik saja?
Dialogue: 0,0:06:19.88,0:06:22.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia benaran paham soal militer?
Dialogue: 0,0:06:22.53,0:06:24.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan khawatir.
Dialogue: 0,0:06:26.03,0:06:29.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya sudah menempatkan bawahan saya\Ndi berbagai tempat.
Dialogue: 0,0:06:29.68,0:06:30.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Moss.
Dialogue: 0,0:06:30.41,0:06:31.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:06:33.20,0:06:34.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan lihat ini.
Dialogue: 0,0:06:39.41,0:06:42.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami baru saja menempatkan\Nbawahan Nona Testarossa
Dialogue: 0,0:06:42.38,0:06:44.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di sekeliling penghalang ibu kota.
Dialogue: 0,0:06:46.26,0:06:48.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ditambah lagi, pasukan Magus dari Sarion
Dialogue: 0,0:06:48.65,0:06:52.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dilaporkan sedang menuju kawasan perbatasan.
Dialogue: 0,0:06:52.35,0:06:55.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk iblis yang mengamuk di medan perang,\Npasukan Cien
Dialogue: 0,0:06:56.15,0:07:00.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan para bawahan High Elf itu sudah lebih\Ndari cukup untuk membasminya.
Dialogue: 0,0:07:01.02,0:07:02.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Moss.
Dialogue: 0,0:07:02.46,0:07:05.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku keberatan kamu menyebut\Nsekutu Tuan Rimuru,
Dialogue: 0,0:07:05.29,0:07:08.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Mulia Elmesia, sebagai High Elf.
Dialogue: 0,0:07:08.64,0:07:11.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maaf atas ketidaksopananku.
Dialogue: 0,0:07:11.32,0:07:12.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan masalah.
Dialogue: 0,0:07:13.43,0:07:15.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat, segera hancurkan penghalang...
Dialogue: 0,0:07:16.75,0:07:18.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Johann Rostia.
Dialogue: 0,0:07:19.33,0:07:21.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Ada apa?
Dialogue: 0,0:07:21.52,0:07:25.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan siapa Anda berbicara melalui
Dialogue: 0,0:07:26.04,0:07:27.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}telepon sihir?
Dialogue: 0,0:07:27.05,0:07:27.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:07:28.41,0:07:31.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa memberi perintah\Nmenghancurkan penghalang negeri ini?
Dialogue: 0,0:07:32.43,0:07:33.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya?
Dialogue: 0,0:07:33.49,0:07:34.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Johann!
Dialogue: 0,0:07:34.41,0:07:36.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jelaskan!
Dialogue: 0,0:07:53.27,0:07:54.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penghalangnya...
Dialogue: 0,0:07:59.46,0:08:01.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa ada Vert di sini?
Dialogue: 0,0:08:01.04,0:08:02.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang terjadi?
Dialogue: 0,0:08:02.50,0:08:05.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Johann, Anda mengkhianati kami?
Dialogue: 0,0:08:05.51,0:08:07.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengkhianati?
Dialogue: 0,0:08:07.65,0:08:09.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah kalian yang mengkhianati Rozzo
Dialogue: 0,0:08:09.83,0:08:14.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}demi bertekuk lutut pada negeri monster?
Dialogue: 0,0:08:15.47,0:08:17.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saatnya pembalasan!
Dialogue: 0,0:08:18.16,0:08:21.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dewan yang mengaku sebagai\Npelindung umat manusia ini
Dialogue: 0,0:08:21.07,0:08:23.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah tempat terbaik untuk memulai neraka!
Dialogue: 0,0:08:23.98,0:08:28.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Girard, wujudkanlah\Nambisi kalian sekarang.
Dialogue: 0,0:08:29.36,0:08:30.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih atas kerja samanya.
Dialogue: 0,0:08:33.37,0:08:35.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan ini kupanggil sang Dewa!
Dialogue: 0,0:08:35.57,0:08:40.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua akan binasa dan kita akan\Nterseret ke dalam peperangan!
Dialogue: 0,0:08:43.36,0:08:44.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayn.
Dialogue: 0,0:08:44.09,0:08:48.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, akan kulakukan.\NEra kita telah tiba.
Dialogue: 0,0:08:48.21,0:08:50.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wahai Dewa Hijau, sang pencipta kami,
Dialogue: 0,0:08:50.72,0:08:53.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kupersembahkan doa abadi ini.
Dialogue: 0,0:08:53.53,0:08:56.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Muncul dan wujudkanlah kekuatan penghancur
Dialogue: 0,0:08:56.39,0:08:58.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang kuhasratkan di sini!
Dialogue: 0,0:09:15.45,0:09:17.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Misery!
Dialogue: 0,0:09:17.47,0:09:20.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dewa kami, Iblis Primordial.
Dialogue: 0,0:09:20.24,0:09:21.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Misery!
Dialogue: 0,0:09:21.87,0:09:23.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iblis Primordial, katamu?
Dialogue: 0,0:09:27.03,0:09:28.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini...
Dialogue: 0,0:09:29.28,0:09:33.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa sangka di momen seperti ini.\NKebetulan sekali.
Dialogue: 0,0:09:33.09,0:09:37.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dewaku, kami persembahkan\Nseluruh penduduk negeri ini.
Dialogue: 0,0:09:37.64,0:09:40.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Izinkan kami menempati\Ntempat terendah di sisimu!
Dialogue: 0,0:09:40.48,0:09:42.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku telah menuntaskan tugas terakhirku.
Dialogue: 0,0:09:42.65,0:09:46.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan ini,\Naku bisa menghadap Tuan Granville.
Dialogue: 0,0:09:46.48,0:09:49.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski kerajaanku, Rostia,\Njuga akan dilanda kehancuran,
Dialogue: 0,0:09:49.88,0:09:52.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan memohon ampun\Npada mereka di alam baka.
Dialogue: 0,0:09:52.61,0:09:56.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Testarossa, negeri ini bisa lenyap!
Dialogue: 0,0:09:56.10,0:09:58.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong segera laporkan kepada Tuan Rimuru!
Dialogue: 0,0:09:58.84,0:10:02.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pak Ketua Sidang, bukannya masih ada saya?
Dialogue: 0,0:10:03.47,0:10:05.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya itu?
Dialogue: 0,0:10:05.57,0:10:09.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya sendiri bisa mengatasi semuanya.
Dialogue: 0,0:10:10.35,0:10:14.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Blanc? Kenapa dia menekan auranya\Ndan berbaur dengan manusia?
Dialogue: 0,0:10:16.04,0:10:17.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sudah bermanifestasi?
Dialogue: 0,0:10:17.87,0:10:20.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Blanc, kenapa kamu ada di sini?
Dialogue: 0,0:10:20.51,0:10:23.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan panggil aku dengan nama itu.
Dialogue: 0,0:10:23.02,0:10:28.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah menerima nama\NTestarossa yang indah ini.
Dialogue: 0,0:10:28.02,0:10:29.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diberi nama?
Dialogue: 0,0:10:29.61,0:10:34.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, meski kamu sudah\Njauh-jauh datang menyapa,
Dialogue: 0,0:10:35.75,0:10:37.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau niatmu mengganggu,
Dialogue: 0,0:10:37.37,0:10:41.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan memberimu hadiah tidur seribu tahun,
Dialogue: 0,0:10:41.19,0:10:42.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misery.
Dialogue: 0,0:10:43.44,0:10:46.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untung aku berhasil dipanggil\Npada waktu yang tepat,
Dialogue: 0,0:10:46.50,0:10:48.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi si Putih yang merepotkan ini...
Dialogue: 0,0:10:49.25,0:10:52.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada gunanya bertarung\Ndengannya sekarang.
Dialogue: 0,0:10:52.79,0:10:54.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Prioritasku adalah...
Dialogue: 0,0:10:55.13,0:10:58.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu memprovokasiku, Testarossa.
Dialogue: 0,0:10:58.40,0:11:01.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tujuanku bukan kamu.
Dialogue: 0,0:11:01.12,0:11:03.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, sungguh membosankan.
Dialogue: 0,0:11:03.57,0:11:07.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu hanya ingin cepat pergi\Nlalu lapor ke Rouge, kan?
Dialogue: 0,0:11:08.90,0:11:13.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata, memiliki Tuan memang menyenangkan.
Dialogue: 0,0:11:13.35,0:11:16.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang aku sangat mengerti perasaanmu.
Dialogue: 0,0:11:16.41,0:11:18.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, kamu pasti paham.
Dialogue: 0,0:11:18.39,0:11:21.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menjadi berguna bagi Tuan Guy\Nadalah segalanya bagiku.
Dialogue: 0,0:11:24.01,0:11:27.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Segera biasakan diri dengan tubuh barumu.
Dialogue: 0,0:11:27.09,0:11:30.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau kamu banyak alasan\Nketika kalah nanti.
Dialogue: 0,0:11:32.00,0:11:36.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pergi?\NApa kita selamat?
Dialogue: 0,0:11:36.01,0:11:38.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dewa kami pergi?
Dialogue: 0,0:11:38.08,0:11:41.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?\NSelain itu, beliau menyebut nama Blanc...
Dialogue: 0,0:11:41.08,0:11:42.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bilang, Primordial itu?
Dialogue: 0,0:11:42.95,0:11:45.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tidak mungkin!
Dialogue: 0,0:11:46.25,0:11:50.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, ancaman utamanya telah pergi.
Dialogue: 0,0:11:50.76,0:11:52.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak percaya...
Dialogue: 0,0:11:52.64,0:11:54.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak percaya ini!
Dialogue: 0,0:11:59.78,0:12:01.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:12:05.17,0:12:07.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang terjadi?
Dialogue: 0,0:12:09.33,0:12:11.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan dibunuh.
Dialogue: 0,0:12:11.57,0:12:14.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Johann yang di sana juga.
Dialogue: 0,0:12:14.17,0:12:17.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetapi, mereka terus bersikap\Ntidak sopan kepada Anda...
Dialogue: 0,0:12:18.76,0:12:22.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Moss, kamu ingin membantah perintahku?
Dialogue: 0,0:12:22.05,0:12:24.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama sekali tidak!
Dialogue: 0,0:12:24.00,0:12:27.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya benar-benar sudah lupa diri\Nsampai berani menasihati Anda.
Dialogue: 0,0:12:27.81,0:12:31.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sudah paham, kali ini kuampuni.
Dialogue: 0,0:12:31.43,0:12:35.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, betapa murah hatinya diriku.
Dialogue: 0,0:12:35.85,0:12:42.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu benaran Nona Blanc sang Primordial?
Dialogue: 0,0:12:44.11,0:12:47.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa aku telah gagal?
Dialogue: 0,0:12:47.70,0:12:51.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu benar, pada akhirnya\Nkamu tidak bisa apa-apa.
Dialogue: 0,0:12:52.52,0:12:55.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal semuanya akan berhasil\Nkalau tidak ada kamu!
Dialogue: 0,0:12:55.55,0:12:59.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lepaskan!\NTanah airku tidak akan tinggal diam!
Dialogue: 0,0:12:59.32,0:13:01.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan jadi masalah internasional!
Dialogue: 0,0:13:01.13,0:13:04.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga, apa Anda lupa\Nakan hukum internasional?
Dialogue: 0,0:13:05.40,0:13:09.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tindak pidana makar\Nyang mengancam eksistensi negara
Dialogue: 0,0:13:10.43,0:13:14.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan kejahatan agresi asing\Ndengan memicu keterlibatan militer luar.
Dialogue: 0,0:13:15.53,0:13:21.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelanggaran di Dewan yang dilakukan\NTuan Johann Rostia ini
Dialogue: 0,0:13:21.53,0:13:25.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}wajib diadili di bawah hukum\NKerajaan Ingrassia.
Dialogue: 0,0:13:25.28,0:13:27.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa pun pembelaan dari tanah airmu,
Dialogue: 0,0:13:27.99,0:13:30.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hukum internasionallah yang tetap berlaku.
Dialogue: 0,0:13:30.49,0:13:31.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayang sekali.
Dialogue: 0,0:13:31.79,0:13:33.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah.
Dialogue: 0,0:13:33.09,0:13:34.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sangat bisa diandalkan.
Dialogue: 0,0:13:36.09,0:13:41.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkatmu, aku bisa mendapatkan hati\Npara anggota Dewan.
Dialogue: 0,0:13:41.28,0:13:42.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:13:42.13,0:13:43.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berengsek!
Dialogue: 0,0:13:43.47,0:13:46.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iblis sialan!\NTerkutuklah kamu!
Dialogue: 0,0:13:46.93,0:13:49.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Berteriak dan menjerit pun percuma.\N- Iblis sialan!
Dialogue: 0,0:13:49.77,0:13:52.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tebuslah dosa-dosamu.
Dialogue: 0,0:13:52.28,0:13:54.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Testarossa, apa Anda terluka?
Dialogue: 0,0:13:54.69,0:13:56.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya baik-baik saja.
Dialogue: 0,0:13:56.51,0:13:59.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa yang menyangka situasinya akan begini.
Dialogue: 0,0:13:59.82,0:14:01.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, tepat sekali.
Dialogue: 0,0:14:01.77,0:14:05.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah bagaimana jadinya\Nkalau Anda tidak ada.
Dialogue: 0,0:14:05.33,0:14:07.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kami harus berterima kasih?
Dialogue: 0,0:14:08.15,0:14:10.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu berterima kasih.
Dialogue: 0,0:14:10.27,0:14:14.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menjaga keamanan negara anggota\Nadalah amanat penting dari Tuan Rimuru.
Dialogue: 0,0:14:15.33,0:14:20.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ancaman sebesar apa pun\Nbukanlah tandingan bagi Tempest!
Dialogue: 0,0:14:31.15,0:14:32.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Guy.
Dialogue: 0,0:14:33.67,0:14:36.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Apa maksudnya?
Dialogue: 0,0:14:36.04,0:14:39.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Blanc sudah bermanifestasi dan diberi nama?
Dialogue: 0,0:14:39.00,0:14:41.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah tahu, ya?
Dialogue: 0,0:14:41.23,0:14:42.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jelas.
Dialogue: 0,0:14:42.88,0:14:45.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua sesuai rencana Tuan Rimuru.
Dialogue: 0,0:14:45.61,0:14:49.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guy, kamu salah satu\Nyang dimanfaatkan olehnya.
Dialogue: 0,0:14:50.12,0:14:52.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu.
Dialogue: 0,0:14:52.29,0:14:58.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dia lepas dari persaingan tiga\Narah itu, bagaimana dengan dua sisanya?
Dialogue: 0,0:14:58.15,0:15:00.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ultima dan Carrera?
Dialogue: 0,0:15:00.04,0:15:00.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:15:02.01,0:15:05.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Rimuru memberi mereka tugas lain.
Dialogue: 0,0:15:05.27,0:15:07.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan kedua wanita itu senang mendapat...
Dialogue: 0,0:15:07.76,0:15:09.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu sebentar!
Dialogue: 0,0:15:09.83,0:15:12.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ultima dan Carrera...
Dialogue: 0,0:15:12.18,0:15:15.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, Violet dan Jaune.
Dialogue: 0,0:15:15.37,0:15:18.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bilang, yang memberi\Nnama mereka bertiga...
Dialogue: 0,0:15:18.47,0:15:20.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja, Tuan Rimuru.
Dialogue: 0,0:15:21.27,0:15:23.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya apa yang terjadi?
Dialogue: 0,0:15:23.23,0:15:27.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Raja Iblis biasa mana bisa\Nmemberi nama pada Primordial.
Dialogue: 0,0:15:27.44,0:15:31.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, mana mau Primordial tunduk\Nkalau tidak mengakui kemampuannya.
Dialogue: 0,0:15:31.95,0:15:34.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, akulah yang mengajak mereka.
Dialogue: 0,0:15:34.96,0:15:36.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata kamu penyebabnya!
Dialogue: 0,0:15:36.96,0:15:40.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal sudah diberi kehormatan\Nmengabdi pada Tuan Rimuru,
Dialogue: 0,0:15:40.31,0:15:45.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mereka bertiga malah lancang saat bertemu.
Dialogue: 0,0:15:45.34,0:15:46.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadinya mau kubunuh saja.
Dialogue: 0,0:15:46.65,0:15:51.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Noir itu aneh, jadi wajar kalau\Ndia patuh karena iseng.
Dialogue: 0,0:15:51.12,0:15:54.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kalau Violet dan Jaune juga,\Nini sudah tidak lucu!
Dialogue: 0,0:15:55.08,0:16:00.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan Blanc, yang paling tinggi\Nharga dirinya, juga ikut tunduk?
Dialogue: 0,0:16:00.23,0:16:03.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang dipikirkan si Rimuru itu?
Dialogue: 0,0:16:04.27,0:16:07.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cih, mau tidak mau aku harus\Nmenanyakannya langsung.
Dialogue: 0,0:16:07.61,0:16:09.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:16:09.45,0:16:12.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lain kali aku mau mampir\Nke tempatnya Rimuru.
Dialogue: 0,0:16:12.11,0:16:13.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:16:13.17,0:16:15.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya jangan\Nkalau hanya ingin berbuat ulah.
Dialogue: 0,0:16:16.63,0:16:18.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar kurang ajar.
Dialogue: 0,0:16:19.24,0:16:20.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan begitu.
Dialogue: 0,0:16:20.96,0:16:25.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dengar wilayah Rimuru\Nsedang berkembang pesat.
Dialogue: 0,0:16:25.57,0:16:29.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi ingin mampir sebentar.\NBoleh, kan, Diablo?
Dialogue: 0,0:16:30.87,0:16:32.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa boleh buat.
Dialogue: 0,0:16:32.44,0:16:34.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, kami akan menyambutmu.
Dialogue: 0,0:16:34.96,0:16:37.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin Tuan Rimuru pasti senang.
Dialogue: 0,0:16:37.65,0:16:41.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, karena kalian ada di sini,\Naku akan mundur.
Dialogue: 0,0:16:41.69,0:16:46.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan, apa pun yang terjadi di sini,\NTuan Rimuru bisa membereskannya.
Dialogue: 0,0:16:46.69,0:16:49.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya?\NAku titip salam buat Rimuru.
Dialogue: 0,0:16:49.82,0:16:52.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, sampai jumpa.
Dialogue: 0,0:16:56.58,0:16:59.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untungnya dia mundur.
Dialogue: 0,0:16:59.36,0:17:04.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Guy sampai turun tangan langsung,\Naku pun tidak tahu akan jadi seperti apa.
Dialogue: 0,0:17:06.72,0:17:10.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan aku pun akan kesulitan menghadapinya.
Dialogue: 0,0:17:10.32,0:17:13.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus bertambah kuat lagi.
Dialogue: 0,0:17:14.00,0:17:17.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, Tuan Rimuru memang hebat.
Dialogue: 0,0:17:17.89,0:17:22.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beliau pasti sudah memprediksi hal ini\Ndan mengutusku ke sini.
Dialogue: 0,0:17:23.10,0:17:26.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya berada dalam genggamannya.
Dialogue: 0,0:17:26.81,0:17:29.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai sekarang, aku harus memupuk\Nlebih banyak kekuatan
Dialogue: 0,0:17:29.96,0:17:31.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}agar bisa memenuhi harapan Tuan Rimuru.
Dialogue: 0,0:17:33.16,0:17:34.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Rimuru,
Dialogue: 0,0:17:35.05,0:17:38.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sepertinya di Ruberios juga\Nsedang terjadi hal besar.
Dialogue: 0,0:17:38.88,0:17:41.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan tempat ini pada kami,
Dialogue: 0,0:17:41.33,0:17:43.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan pamerkan
Dialogue: 0,0:17:43.29,0:17:45.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kekuatan Anda tanpa rasa cemas.
Dialogue: 0,0:17:53.37,0:17:55.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai orang dunia lain,\Nmereka terlalu lemah.
Dialogue: 0,0:17:55.89,0:18:00.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa mereka hanya diperintah untuk menahanku?
Dialogue: 0,0:18:00.02,0:18:03.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti, tujuannya bukan\Nuntuk membalaskan dendam Maribel.
Dialogue: 0,0:18:04.89,0:18:07.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa tujuan Granville?
Dialogue: 0,0:18:10.61,0:18:12.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa ada Leon?
Dialogue: 0,0:18:12.74,0:18:16.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah menunggumu, Raja Iblis Leon.
Dialogue: 0,0:18:17.74,0:18:21.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sok akrab sekali.\NSiapa kamu?
Dialogue: 0,0:18:21.08,0:18:24.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini pertama kalinya kita bertemu.
Dialogue: 0,0:18:24.00,0:18:27.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf membuatmu datang jauh-jauh.
Dialogue: 0,0:18:27.00,0:18:30.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kamu katakan?\NAlasanku ke sini...
Dialogue: 0,0:18:30.00,0:18:31.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak-anak
Dialogue: 0,0:18:31.26,0:18:34.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang kamu istimewakan melalui\Npara pedagang itu
Dialogue: 0,0:18:34.48,0:18:37.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah anak-anak yang aku kumpulkan.
Dialogue: 0,0:18:38.76,0:18:41.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan formula sihir darimu,
Dialogue: 0,0:18:41.27,0:18:45.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku memanggil anak-anak itu, lalu menjual\Nmereka sebagai barang dagangan.
Dialogue: 0,0:18:46.05,0:18:49.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tujuanmu menambah bawahan Elementaler, kan?
Dialogue: 0,0:18:49.17,0:18:52.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Prajurit kuat seperti Shizue Izawa...
Dialogue: 0,0:18:54.23,0:18:56.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lapor. Ini berbahaya.
Dialogue: 0,0:18:56.23,0:18:58.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Individu Granville Rozzo
Dialogue: 0,0:18:58.04,0:19:01.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sedang membuat narasi untuk\Nmengadu domba Master dengan Leon.
Dialogue: 0,0:19:01.47,0:19:03.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, aku tahu.
Dialogue: 0,0:19:03.75,0:19:05.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tahu berapa kali aku gagal
Dialogue: 0,0:19:05.95,0:19:08.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}demi memanggil orang yang kamu minta?
Dialogue: 0,0:19:09.19,0:19:12.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak-anak itu hanya sisa\Ndari kegagalan tersebut.
Dialogue: 0,0:19:13.19,0:19:14.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lapor.
Dialogue: 0,0:19:14.23,0:19:15.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini provokasi yang sangat jelas.
Dialogue: 0,0:19:15.95,0:19:18.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu, tapi...
Dialogue: 0,0:19:18.34,0:19:19.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei!
Dialogue: 0,0:19:20.44,0:19:22.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa benar yang kamu katakan itu?
Dialogue: 0,0:19:22.28,0:19:23.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu benar.
Dialogue: 0,0:19:23.87,0:19:28.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami para pedagang siap menyediakan\Napa pun permintaannya.
Dialogue: 0,0:19:28.72,0:19:30.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bertanya padamu!
Dialogue: 0,0:19:31.48,0:19:36.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan hanya Shizu,\Nkamu memanggil yang lain juga?
Dialogue: 0,0:19:36.52,0:19:37.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:19:37.36,0:19:42.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sadar anak-anak yang dipanggil\Ntidak akan berumur panjang?
Dialogue: 0,0:19:42.37,0:19:43.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu...
Dialogue: 0,0:19:43.01,0:19:45.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan pura-pura tidak tahu.
Dialogue: 0,0:19:45.59,0:19:47.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permintaanmu waktu itu adalah
Dialogue: 0,0:19:47.32,0:19:50.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}orang dunia lain\Ndi bawah sepuluh tahun, kan?
Dialogue: 0,0:19:50.65,0:19:56.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Intinya, kamu menyelamatkan mereka\Nuntuk dijadikan senjata, kan?
Dialogue: 0,0:19:57.26,0:20:01.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pantas bawahan Leon memancarkan\Nhawa keberadaan roh...
Dialogue: 0,0:20:02.24,0:20:04.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lapor. Ini jebakan.
Dialogue: 0,0:20:04.52,0:20:10.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan saat ini pun,\Nkami masih melakukan ritual pemanggilan.
Dialogue: 0,0:20:11.48,0:20:14.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa semua itu benar?
Dialogue: 0,0:20:14.69,0:20:17.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, tapi aku punya alasan...
Dialogue: 0,0:20:17.57,0:20:19.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berisik!
Dialogue: 0,0:20:19.07,0:20:22.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata kamu memang penyebabnya!
Dialogue: 0,0:20:30.77,0:20:33.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, seperti yang kuduga.
Dialogue: 0,0:20:33.97,0:20:36.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awalnya kukira dia orang yang dingin,
Dialogue: 0,0:20:36.75,0:20:38.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi ternyata bukan.
Dialogue: 0,0:20:38.59,0:20:41.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alasan dia menanamkan Ifrit ke tubuh Shizu,
Dialogue: 0,0:20:41.97,0:20:43.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}melatihnya jadi kuat,
Dialogue: 0,0:20:44.37,0:20:46.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hingga meninggalkannya di kastel...
Dialogue: 0,0:20:46.92,0:20:49.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua itu cara Leon untuk...
Dialogue: 0,0:20:50.93,0:20:53.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada hal yang ingin kupastikan\Nsaat bertemu dengannya.
Dialogue: 0,0:20:56.03,0:20:58.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyampaikan perasaan\Nyang ditinggalkan Shizu,
Dialogue: 0,0:20:58.95,0:21:00.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}janji terakhir itu...
Dialogue: 0,0:21:01.25,0:21:02.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya bisa kutepati.
Dialogue: 0,0:21:10.50,0:21:12.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Leon bukan musuh.
Dialogue: 0,0:21:12.71,0:21:16.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, apa alasan Granville
Dialogue: 0,0:21:16.12,0:21:18.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}membuatku bermusuhan dengan Leon?
Dialogue: 0,0:21:19.01,0:21:25.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lapor. Informasi belum cukup untuk memastikan\Ntujuan sebenarnya individu Granville Rozzo.
Dialogue: 0,0:21:25.95,0:21:27.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:21:27.39,0:21:29.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah puas?
Dialogue: 0,0:21:29.04,0:21:30.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum.
Dialogue: 0,0:21:30.55,0:21:34.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perasaan Shizu sudah tersampaikan,\Ntapi perasaanku belum.
Dialogue: 0,0:21:34.87,0:21:37.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga Leon sadar akan rencanaku.
Dialogue: 0,0:21:38.56,0:21:41.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau kita "berdiskusi" sebentar?
Dialogue: 0,0:21:41.65,0:21:43.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:21:43.17,0:21:46.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melihat rentetan tindakannya,\NRimuru memang bersih.
Dialogue: 0,0:21:46.93,0:21:49.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalangnya adalah Granville...
Dialogue: 0,0:21:49.51,0:21:50.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:21:59.68,0:22:01.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya niatku tersampaikan.
Dialogue: 0,0:22:02.37,0:22:06.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Percaya pada orang yang tidak terlalu\Ndia kenal, nekat juga dia.
Dialogue: 0,0:22:07.11,0:22:08.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita mulai.
Dialogue: 0,0:22:12.12,0:22:14.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sengaja masuk ke jebakan Granville...
Dialogue: 0,0:22:14.90,0:22:17.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu membongkar tujuannya!
Dialogue: 0,0:22:19.13,0:22:23.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tahu tujuannya,\Nkita bisa menjebaknya balik.
Dialogue: 0,0:22:23.91,0:22:27.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, rasanya ada hal yang terlewat...
Dialogue: 0,0:22:32.24,0:22:35.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya apa tujuan Granville?
Dialogue: 0,0:24:05.84,0:24:08.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya, "Kematian dan Kehilangan".
