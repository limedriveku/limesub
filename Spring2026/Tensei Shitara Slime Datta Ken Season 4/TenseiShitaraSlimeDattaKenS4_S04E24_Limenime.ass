Dialogue: 0,0:07:31.49,0:07:33.53,sign,,0,0,0,,PENJARA TANPA BATAS\NEKSTRAK
Dialogue: 0,0:07:33.53,0:07:35.49,sign,,0,0,0,,PEMUTUSAN MUTLAK\NEKSTRAK
Dialogue: 0,0:07:35.49,0:07:37.45,sign,,0,0,0,,PEREBUT\NEKSTRAK
Dialogue: 0,0:23:53.97,0:23:57.29,sign,,0,0,0,,KEKAISARAN BERSATU PERSERIKATAN TIMUR\NNASEA NAMRIUM ULMERIA
Dialogue: 0,0:24:07.47,0:24:10.97,sign,,0,0,0,,BERSAMBUNG
Dialogue: 0,0:00:13.08,0:00:15.58,Default,,0,0,0,,{\blur3}{\fad(00,40)}Hinata sudah mati?
Dialogue: 0,0:00:15.58,0:00:16.98,Default,,0,0,0,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:00:16.98,0:00:21.92,Default,,0,0,0,,{\blur3}{\fad(00,40)}Saat melindungiku...\NMelindungi Chloe dari serangan Granville...
Dialogue: 0,0:00:23.21,0:00:26.84,Default,,0,0,0,,{\blur3}{\fad(00,40)}Jiwanya hancur sampai menewaskannya.
Dialogue: 0,0:00:26.84,0:00:28.41,Default,,0,0,0,,{\blur3}{\fad(00,40)}Astaga.
Dialogue: 0,0:00:28.98,0:00:30.34,Default,,0,0,0,,{\blur3}{\fad(00,40)}Masa Hinata...
Dialogue: 0,0:00:30.34,0:00:35.05,Default,,0,0,0,,{\blur3}{\fad(00,40)}Katanya Chloe juga sedang tersesat\Ndi Penjara Tanpa Batas.
Dialogue: 0,0:00:35.85,0:00:38.41,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tidak, sekarang bukan waktunya bingung.
Dialogue: 0,0:00:38.87,0:00:43.61,Default,,0,0,0,,{\blur3}{\fad(00,40)}Chronoa, bisa ceritakan semua\Nsecara kronologis?
Dialogue: 0,0:00:43.61,0:00:46.23,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tentang Hinata dan Chloe.
Dialogue: 0,0:00:46.23,0:00:47.86,Default,,0,0,0,,{\blur3}{\fad(00,40)}Selain itu, Chronoa,
Dialogue: 0,0:00:47.86,0:00:49.48,Default,,0,0,0,,{\blur3}{\fad(00,40)}tentangmu juga.
Dialogue: 0,0:02:22.15,0:02:25.27,Default,,0,0,0,,{\blur3}{\fad(00,40)}Chronoa bisa dianggap\Nsebagai kepribadian lain Chloe,
Dialogue: 0,0:02:25.27,0:02:28.12,Default,,0,0,0,,{\blur3}{\fad(00,40)}juga sebagai perwujudan kehancuran, kan?
Dialogue: 0,0:02:28.12,0:02:30.02,Default,,0,0,0,,{\blur3}{\fad(00,40)}Apa yang membuatmu mengamuk?
Dialogue: 0,0:02:30.50,0:02:35.02,Default,,0,0,0,,{\blur3}{\fad(00,40)}Karena kamu mengorbankan diri\Nuntuk melindungiku!
Dialogue: 0,0:02:35.02,0:02:36.03,Default,,0,0,0,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:02:36.03,0:02:39.78,Default,,0,0,0,,{\blur3}{\fad(00,40)}Demi menyelamatkanku, di dunia masa depan.
Dialogue: 0,0:02:41.03,0:02:43.86,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tu-Tunggu dulu!\NMengorbankan diri?
Dialogue: 0,0:02:44.28,0:02:47.54,Default,,0,0,0,,{\blur3}{\fad(00,40)}Jadi ada yang membunuhku di masa depan?
Dialogue: 0,0:02:47.54,0:02:50.21,Default,,0,0,0,,{\blur3}{\fad(00,40)}Benar, kamu terbunuh.
Dialogue: 0,0:02:50.68,0:02:52.00,Default,,0,0,0,,{\blur3}{\fad(00,40)}Saat Chloe menghilang,
Dialogue: 0,0:02:52.00,0:02:56.78,Default,,0,0,0,,{\blur3}{\fad(00,40)}kamulah yang menyelamatkanku\Nketika aku mengamuk.
Dialogue: 0,0:02:56.78,0:02:57.92,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:03:08.63,0:03:10.73,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku sangat terpukul.
Dialogue: 0,0:03:13.44,0:03:15.54,Default,,0,0,0,,{\blur3}{\fad(00,40)}Dunia masa depan, ya?
Dialogue: 0,0:03:16.07,0:03:18.69,Default,,0,0,0,,{\blur3}{\fad(00,40)}Apa benar akan terjadi hal semacam itu?
Dialogue: 0,0:03:18.69,0:03:22.15,Default,,0,0,0,,{\blur3}{\fad(00,40)}Lebih baik syukuri saja\Naku sudah mendengar ceritanya.
Dialogue: 0,0:03:24.12,0:03:25.26,Default,,0,0,0,,{\blur3}{\fad(00,40)}Chronoa.
Dialogue: 0,0:03:25.94,0:03:29.83,Default,,0,0,0,,{\blur3}{\fad(00,40)}Eng, apa kamu masih ingin\Nmenghancurkan dunia?
Dialogue: 0,0:03:29.83,0:03:31.33,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sudah tidak.
Dialogue: 0,0:03:32.83,0:03:35.67,Default,,0,0,0,,{\blur3}{\fad(00,40)}Soalnya kamu baik-baik saja.
Dialogue: 0,0:03:35.67,0:03:39.05,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tapi jangan mengorbankan diri lagi\Nuntuk menyelamatkanku, ya?
Dialogue: 0,0:03:40.04,0:03:44.10,Default,,0,0,0,,{\blur3}{\fad(00,40)}Maaf, aku akan lebih berhati-hati.
Dialogue: 0,0:03:44.10,0:03:46.93,Default,,0,0,0,,{\blur3}{\fad(00,40)}Janji, ya?
Dialogue: 0,0:03:47.42,0:03:50.93,Default,,0,0,0,,{\blur3}{\fad(00,40)}Syukurlah Chronoa sudah baik-baik saja.
Dialogue: 0,0:03:52.41,0:03:55.32,Default,,0,0,0,,{\blur3}{\fad(00,40)}Jadi, soal Chloe dan Hinata...
Dialogue: 0,0:03:56.07,0:04:00.94,Default,,0,0,0,,{\blur3}{\fad(00,40)}Seperti yang kubilang tadi, Chloe berada\Ndi dalam Penjara Tanpa Batas milikku.
Dialogue: 0,0:04:01.56,0:04:04.82,Default,,0,0,0,,{\blur3}{\fad(00,40)}Karena ada dua Chloe\Ndi alur waktu yang sama,
Dialogue: 0,0:04:04.82,0:04:08.76,Default,,0,0,0,,{\blur3}{\fad(00,40)}dia pun bertukar tempat denganku\Nyang awalnya ada di dalam.
Dialogue: 0,0:04:08.76,0:04:11.93,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kejadiannya waktu Chloe\Npindah ke dunia ini, ya?
Dialogue: 0,0:04:11.93,0:04:12.94,Default,,0,0,0,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:04:13.59,0:04:17.58,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kamu bilang jiwa Hinata hancur\Nkarena serangan Granville, kan?
Dialogue: 0,0:04:17.58,0:04:18.66,Default,,0,0,0,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:04:18.66,0:04:22.72,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tapi, kamu diberi nama sama Hinata, kan?
Dialogue: 0,0:04:22.72,0:04:28.22,Default,,0,0,0,,{\blur3}{\fad(00,40)}Bukankah artinya jiwa Hinata ikut terlempar\Nke masa lalu bersama Chloe?
Dialogue: 0,0:04:28.72,0:04:31.90,Default,,0,0,0,,{\blur3}{\fad(00,40)}Jiwa Hinata yang hancur
Dialogue: 0,0:04:31.90,0:04:34.69,Default,,0,0,0,,{\blur3}{\fad(00,40)}memang diserap Chloe\Nlalu terlempar ke masa lalu.
Dialogue: 0,0:04:34.69,0:04:38.41,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tapi, jiwanya tidak mampu\Nmenahan lompatan waktu.
Dialogue: 0,0:04:38.94,0:04:44.43,Default,,0,0,0,,{\blur3}{\fad(00,40)}Karenanya, aku hanya menyimpan\Nego yang berasal dari sisa jiwanya.
Dialogue: 0,0:04:44.98,0:04:48.45,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tersimpan di Skill Unik\Nmilik Hinata, Matematikawan.
Dialogue: 0,0:04:48.45,0:04:53.05,Default,,0,0,0,,{\blur3}{\fad(00,40)}Benar juga, Skill Unik itu berakar dari jiwa.
Dialogue: 0,0:04:53.05,0:04:57.08,Default,,0,0,0,,{\blur3}{\fad(00,40)}Berarti kalau Matematikawan\Ndikembalikan ke tubuh Hinata...
Dialogue: 0,0:04:57.61,0:05:00.30,Default,,0,0,0,,{\blur3}{\fad(00,40)}Chloe juga berpikiran sama.
Dialogue: 0,0:05:00.30,0:05:02.62,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tapi, itu mustahil.
Dialogue: 0,0:05:03.14,0:05:07.47,Default,,0,0,0,,{\blur3}{\fad(00,40)}Itu karena Matematikawan milik Hinata\Njuga ikut terenggut ke Penjara Tanpa Batas.
Dialogue: 0,0:05:07.98,0:05:08.97,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:05:09.46,0:05:13.00,Default,,0,0,0,,{\blur3}{\fad(00,40)}Di dalam sana,\Nsegalanya bercampur menjadi satu.
Dialogue: 0,0:05:13.00,0:05:17.23,Default,,0,0,0,,{\blur3}{\fad(00,40)}Matematikawan milik Hinata pun\Nsudah ikut menyatu.
Dialogue: 0,0:05:17.67,0:05:19.40,Default,,0,0,0,,{\blur3}{\fad(00,40)}Menyelamatkan hal itu saja...
Dialogue: 0,0:05:20.26,0:05:21.40,Default,,0,0,0,,{\blur3}{\fad(00,40)}Rasanya mustahil.
Dialogue: 0,0:05:22.09,0:05:23.74,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:05:23.74,0:05:25.07,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tenang saja.
Dialogue: 0,0:05:25.96,0:05:28.45,Default,,0,0,0,,{\blur3}{\fad(00,40)}Hinata itu anak yang kuat.
Dialogue: 0,0:05:28.45,0:05:30.18,Default,,0,0,0,,{\blur3}{\fad(00,40)}Shizu.
Dialogue: 0,0:05:30.18,0:05:32.79,Default,,0,0,0,,{\blur3}{\fad(00,40)}Bukan hanya Hinata.
Dialogue: 0,0:05:32.79,0:05:34.87,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kita harus menyelamatkan Chloe juga.
Dialogue: 0,0:05:36.79,0:05:39.26,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku juga ingin mengembalikan\Ntubuh ini padanya.
Dialogue: 0,0:05:39.26,0:05:41.04,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku ingin dia kembali.
Dialogue: 0,0:05:41.04,0:05:43.56,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kamu mengkhawatirkan Chloe juga, ya?
Dialogue: 0,0:05:43.56,0:05:45.05,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tentu saja.
Dialogue: 0,0:05:45.05,0:05:49.30,Default,,0,0,0,,{\blur3}{\fad(00,40)}Karena aku terlahir untuk menyelamatkannya.
Dialogue: 0,0:05:49.78,0:05:51.18,Default,,0,0,0,,{\blur3}{\fad(00,40)}Chronoa...
Dialogue: 0,0:05:52.18,0:05:53.92,Default,,0,0,0,,{\blur3}{\fad(00,40)}Oke!
Dialogue: 0,0:05:53.92,0:05:57.48,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ayo kita selamatkan Chloe dan Hinata\Ndari Penjara Tanpa Batas!
Dialogue: 0,0:05:57.48,0:06:00.02,Default,,0,0,0,,{\blur3}{\fad(00,40)}Bersedihnya nanti saja kalau sudah ada hasil!
Dialogue: 0,0:06:00.02,0:06:02.90,Default,,0,0,0,,{\blur3}{\fad(00,40)}Iya, benar seperti katamu!
Dialogue: 0,0:06:02.90,0:06:05.15,Default,,0,0,0,,{\blur3}{\fad(00,40)}Pertahankan semangat kalian berdua.
Dialogue: 0,0:06:05.66,0:06:09.10,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kalau begitu, kita harus cari petunjuk\Nuntuk memulainya.
Dialogue: 0,0:06:09.66,0:06:12.91,Default,,0,0,0,,{\blur3}{\fad(00,40)}Oh, iya, apa kamu bisa memanggil\Nmereka berdua?
Dialogue: 0,0:06:12.91,0:06:15.16,Default,,0,0,0,,{\blur3}{\fad(00,40)}Baiklah, aku coba dulu.
Dialogue: 0,0:06:19.48,0:06:21.90,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kurasa dia sedang tenang.
Dialogue: 0,0:06:21.90,0:06:25.92,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku bisa merasakan keberadaan Chloe\Ndi dalam Penjara Tanpa Batas.
Dialogue: 0,0:06:26.55,0:06:29.22,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ini hanya dugaanku.
Dialogue: 0,0:06:29.22,0:06:33.47,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kalau dilepaskan, tubuhnya bisa hancur.
Dialogue: 0,0:06:35.10,0:06:36.62,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku harus bagaimana?
Dialogue: 0,0:06:36.62,0:06:40.85,Default,,0,0,0,,{\blur3}{\fad(00,40)}Mengendalikan energi Penjara Tanpa Batas\Nsambil menyelidiki bagian dalamnya?
Dialogue: 0,0:06:40.85,0:06:42.06,Default,,0,0,0,,{\blur3}{\fad(00,40)}Oh, iya!
Dialogue: 0,0:06:42.06,0:06:45.44,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kak Raphael, bisa mengintervensi\NPenjara Tanpa Batas?
Dialogue: 0,0:06:45.44,0:06:46.26,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:06:46.26,0:06:48.65,Default,,0,0,0,,{\blur3}{\fad(00,40)}Mustahil untuk kondisi saat ini.
Dialogue: 0,0:06:48.65,0:06:52.57,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tidak ada wewenang untuk mencampuri\Nunit terkecil, yaitu partikel data.
Dialogue: 0,0:06:52.57,0:06:54.10,Default,,0,0,0,,{\blur3}{\fad(00,40)}Partikel data?
Dialogue: 0,0:06:54.10,0:06:58.86,Default,,0,0,0,,{\blur3}{\fad(00,40)}Materi yang lebih kecil dari partikel roh\Ndengan massa nyaris mendekati nol.
Dialogue: 0,0:06:58.86,0:07:02.69,Default,,0,0,0,,{\blur3}{\fad(00,40)}Semua materi di dunia ini\Npasti mengandung partikel data.
Dialogue: 0,0:07:03.46,0:07:05.46,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ruangnya memang terbatas,
Dialogue: 0,0:07:05.46,0:07:07.64,Default,,0,0,0,,{\blur3}{\fad(00,40)}tapi kalau pengamatan\Npartikel data bisa dilakukan,
Dialogue: 0,0:07:07.64,0:07:10.20,Default,,0,0,0,,{\blur3}{\fad(00,40)}intervensi pun menjadi mungkin.
Dialogue: 0,0:07:10.20,0:07:14.25,Default,,0,0,0,,{\blur3}{\fad(00,40)}Berarti, asalkan ada wewenang intervensi\Npartikel data dari Chronoa...
Dialogue: 0,0:07:14.25,0:07:15.18,Default,,0,0,0,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:07:15.18,0:07:16.14,Default,,0,0,0,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:07:16.14,0:07:18.17,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kamu butuh, kan?
Dialogue: 0,0:07:18.17,0:07:20.43,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku akan memberikan wewenang itu.
Dialogue: 0,0:07:20.43,0:07:23.42,Default,,0,0,0,,{\blur3}{\fad(00,40)}Be-Benaran?\NAku belum menjelaskan apa...
Dialogue: 0,0:07:23.42,0:07:24.15,Default,,0,0,0,,{\blur3}{\fad(00,40)}Lapor.
Dialogue: 0,0:07:24.15,0:07:25.70,Default,,0,0,0,,{\blur3}{\fad(00,40)}Persetujuan dikonfirmasi.
Dialogue: 0,0:07:25.70,0:07:26.44,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tunggu!
Dialogue: 0,0:07:26.44,0:07:29.43,Default,,0,0,0,,{\blur3}{\fad(00,40)}Intervensi akan dimulai.
Dialogue: 0,0:07:37.45,0:07:38.52,Default,,0,0,0,,{\blur3}{\fad(00,40)}Selesai.
Dialogue: 0,0:07:38.52,0:07:42.63,Default,,0,0,0,,{\blur3}{\fad(00,40)}Dengan menambahkan Skill Unik:\N"Penjara Tanpa Batas", "Pemutusan Mutlak"
Dialogue: 0,0:07:42.63,0:07:44.07,Default,,0,0,0,,{\blur3}{\fad(00,40)}dan "Perebut",
Dialogue: 0,0:07:44.07,0:07:48.63,Default,,0,0,0,,{\blur3}{\fad(00,40)}lalu mencurahkan magi dalam jumlah besar,\Nakan dievolusikan menjadi Skill Ultima.
Dialogue: 0,0:07:49.16,0:07:51.88,Default,,0,0,0,,{\blur3}{\fad(00,40)}Skill yang menyatu\Nberhasil berevolusi menjadi Skill Ultima,
Dialogue: 0,0:07:51.88,0:07:54.47,Default,,0,0,0,,{\blur3}{\fad(00,40)}Yog Sothoth.
Dialogue: 0,0:07:54.47,0:07:57.22,Default,,0,0,0,,{\blur3}{\fad(00,40)}Dia bahkan tidak meminta izin dulu.
Dialogue: 0,0:07:57.22,0:08:01.18,Default,,0,0,0,,{\blur3}{\fad(00,40)}Lapor. Kepribadian lain\Ndari individu Chloe Aubert,
Dialogue: 0,0:08:01.18,0:08:03.00,Default,,0,0,0,,{\blur3}{\fad(00,40)}entitas kesadaran bernama Chronoa,
Dialogue: 0,0:08:03.00,0:08:05.40,Default,,0,0,0,,{\blur3}{\fad(00,40)}telah dioptimalkan menjadi entitas informasi,
Dialogue: 0,0:08:05.40,0:08:07.98,Default,,0,0,0,,{\blur3}{\fad(00,40)}Manas.
Dialogue: 0,0:08:08.54,0:08:09.57,Default,,0,0,0,,{\blur3}{\fad(00,40)}Mulai sekarang,
Dialogue: 0,0:08:09.57,0:08:14.12,Default,,0,0,0,,{\blur3}{\fad(00,40)}pergantian dengan kepribadian utama,\NChloe Aubert, bisa dilakukan kapan saja.
Dialogue: 0,0:08:15.19,0:08:18.24,Default,,0,0,0,,{\blur3}{\fad(00,40)}Bu-Bukannya ini berlebihan?
Dialogue: 0,0:08:20.24,0:08:21.70,Default,,0,0,0,,{\blur3}{\fad(00,40)}Rimuru!
Dialogue: 0,0:08:22.54,0:08:26.50,Default,,0,0,0,,{\blur3}{\fad(00,40)}Hebat!\NBagaimana caramu melakukannya?
Dialogue: 0,0:08:26.50,0:08:29.50,Default,,0,0,0,,{\blur3}{\fad(00,40)}Eh? Yah, begitulah.
Dialogue: 0,0:08:29.50,0:08:33.47,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku tidak bisa bilang kalau skill-ku\Nyang bertindak seenaknya.
Dialogue: 0,0:08:33.47,0:08:37.34,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kamu selalu saja nekat, tapi aku suka!
Dialogue: 0,0:08:38.22,0:08:39.47,Default,,0,0,0,,{\blur3}{\fad(00,40)}Hei!
Dialogue: 0,0:08:39.47,0:08:42.39,Default,,0,0,0,,{\blur3}{\fad(00,40)}Chronoa, jangan merebutnya dariku, dong!
Dialogue: 0,0:08:42.90,0:08:45.09,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kamu Chloe?
Dialogue: 0,0:08:45.09,0:08:46.22,Default,,0,0,0,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:08:48.38,0:08:50.52,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ih, aku lagi enak memeluknya!
Dialogue: 0,0:08:50.52,0:08:52.65,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kamu sudah dari tadi, kan?
Dialogue: 0,0:08:52.65,0:08:56.14,Default,,0,0,0,,{\blur3}{\fad(00,40)}Dunia spiritual ini memang praktis banget.
Dialogue: 0,0:08:56.14,0:08:57.82,Default,,0,0,0,,{\blur3}{\fad(00,40)}Asyik sekali, ya.
Dialogue: 0,0:08:57.82,0:08:59.32,Default,,0,0,0,,{\blur3}{\fad(00,40)}Glek!
Dialogue: 0,0:08:59.32,0:09:02.25,Default,,0,0,0,,{\blur3}{\fad(00,40)}Padahal belum tahu apa aku sudah\Nhidup kembali atau belum,
Dialogue: 0,0:09:02.25,0:09:04.04,Default,,0,0,0,,{\blur3}{\fad(00,40)}kalian sudah kelihatan senang.
Dialogue: 0,0:09:04.04,0:09:08.04,Default,,0,0,0,,{\blur3}{\fad(00,40)}Bi-Bicara apa, sih, Kak Hinata?\NKamu cantik seperti biasa...
Dialogue: 0,0:09:08.04,0:09:09.52,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tidak perlu memuji.
Dialogue: 0,0:09:09.52,0:09:10.88,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ah, iya.
Dialogue: 0,0:09:12.98,0:09:14.32,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:09:14.87,0:09:17.01,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kalau dibilang selamat rasanya kurang pas,
Dialogue: 0,0:09:17.45,0:09:20.35,Default,,0,0,0,,{\blur3}{\fad(00,40)}tapi aku senang bisa bertemu denganmu lagi.
Dialogue: 0,0:09:21.54,0:09:22.95,Default,,0,0,0,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:09:29.32,0:09:30.57,Default,,0,0,0,,{\blur3}{\fad(00,40)}Bu Guru.
Dialogue: 0,0:09:36.70,0:09:39.16,Default,,0,0,0,,{\blur3}{\fad(00,40)}Bu Guru, maafkan aku.
Dialogue: 0,0:09:39.66,0:09:42.87,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku hanya tidak ingin merepotkanmu.
Dialogue: 0,0:09:43.58,0:09:45.83,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku sudah tahu, Hinata.
Dialogue: 0,0:09:45.83,0:09:49.94,Default,,0,0,0,,{\blur3}{\fad(00,40)}Maaf aku juga tidak menyadarinya waktu itu.
Dialogue: 0,0:09:49.94,0:09:51.88,Default,,0,0,0,,{\blur3}{\fad(00,40)}Dan juga, terima kasih.
Dialogue: 0,0:09:57.35,0:10:02.81,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ternyata kamu pahlawan yang menolongku\Ndan bertualang denganku.
Dialogue: 0,0:10:04.25,0:10:07.14,Default,,0,0,0,,{\blur3}{\fad(00,40)}Iya, Bu Guru.
Dialogue: 0,0:10:09.59,0:10:10.56,Default,,0,0,0,,{\blur3}{\fad(00,40)}Chloe juga.
Dialogue: 0,0:10:10.56,0:10:14.57,Default,,0,0,0,,{\blur3}{\fad(00,40)}Padahal dulu masih sekecil itu,\Nsekarang sudah dewasa.
Dialogue: 0,0:10:15.32,0:10:16.46,Default,,0,0,0,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:10:34.23,0:10:35.48,Default,,0,0,0,,{\blur3}{\fad(00,40)}Bu Guru!
Dialogue: 0,0:10:38.28,0:10:39.80,Default,,0,0,0,,{\blur3}{\fad(00,40)}Shizu!
Dialogue: 0,0:10:40.65,0:10:42.49,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku harus pergi.
Dialogue: 0,0:10:42.49,0:10:44.41,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kalian sudah tahu, kan?
Dialogue: 0,0:10:44.41,0:10:47.18,Default,,0,0,0,,{\blur3}{\fad(00,40)}Keberadaanku di sini hanya ilusi.
Dialogue: 0,0:10:48.04,0:10:49.69,Default,,0,0,0,,{\blur3}{\fad(00,40)}Bu Guru...
Dialogue: 0,0:10:51.18,0:10:53.42,Default,,0,0,0,,{\blur3}{\fad(00,40)}Suatu saat, mimpi akan berakhir.
Dialogue: 0,0:10:54.74,0:10:57.38,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku senang bisa bertemu kalian.
Dialogue: 0,0:10:57.38,0:10:59.93,Default,,0,0,0,,{\blur3}{\fad(00,40)}Anak-anak yang lain juga\Nsepertinya masih sehat.
Dialogue: 0,0:11:02.41,0:11:05.34,Default,,0,0,0,,{\blur3}{\fad(00,40)}Rimuru, aku serahkan Hinata padamu.
Dialogue: 0,0:11:05.74,0:11:07.59,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kamu pasti bisa, kan?
Dialogue: 0,0:11:07.59,0:11:09.05,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku mengandalkanmu.
Dialogue: 0,0:11:09.05,0:11:11.25,Default,,0,0,0,,{\blur3}{\fad(00,40)}Be-Bebannya...
Dialogue: 0,0:11:12.57,0:11:16.00,Default,,0,0,0,,{\blur3}{\fad(00,40)}Serahkan padaku!\NHinata, aku akan segera menyelamatkanmu!
Dialogue: 0,0:11:33.77,0:11:35.34,Default,,0,0,0,,{\blur3}{\fad(00,40)}Chronoa.
Dialogue: 0,0:11:35.34,0:11:37.34,Default,,0,0,0,,{\blur3}{\fad(00,40)}Oh, kamu baik-baik saja, Rimuru?
Dialogue: 0,0:11:37.34,0:11:38.36,Default,,0,0,0,,{\blur3}{\fad(00,40)}Berhasil?
Dialogue: 0,0:11:38.36,0:11:40.57,Default,,0,0,0,,{\blur3}{\fad(00,40)}Saat ini dia sedang tertidur.
Dialogue: 0,0:11:40.57,0:11:44.20,Default,,0,0,0,,{\blur3}{\fad(00,40)}Bisakah kalian berdua tetap waspada\Nsupaya tidak ada yang mengganggu?
Dialogue: 0,0:11:44.20,0:11:45.03,Default,,0,0,0,,{\blur3}{\fad(00,40)}Siap!
Dialogue: 0,0:11:45.03,0:11:47.14,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku minta penjelasan nanti.
Dialogue: 0,0:11:57.32,0:12:00.98,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kesadaran Hinata sudah kubawa naik,\Ntapi yang paling penting, jiwanya.
Dialogue: 0,0:12:00.98,0:12:05.30,Default,,0,0,0,,{\blur3}{\fad(00,40)}Matematikawan masih tertinggal\Ndi dalam Yog Sothoth milik Chloe.
Dialogue: 0,0:12:05.72,0:12:10.22,Default,,0,0,0,,{\blur3}{\fad(00,40)}Dia belum lenyap karena menyatu,\Ntapi memisahkannya itu sulit.
Dialogue: 0,0:12:10.22,0:12:11.40,Default,,0,0,0,,{\blur3}{\fad(00,40)}Jawab.
Dialogue: 0,0:12:11.40,0:12:14.50,Default,,0,0,0,,{\blur3}{\fad(00,40)}Perlu disiapkan energi pengganti\Nuntuk Matematikawan,
Dialogue: 0,0:12:14.50,0:12:16.98,Default,,0,0,0,,{\blur3}{\fad(00,40)}lalu ditukar.
Dialogue: 0,0:12:16.98,0:12:21.59,Default,,0,0,0,,{\blur3}{\fad(00,40)}Selain itu, penyelamatan lewat sihir\Nkebangkitan juga perlu dilakukan bersamaan.
Dialogue: 0,0:12:21.59,0:12:25.03,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sulit kalau harus\Nmembangkitkan Hinata sendirian.
Dialogue: 0,0:12:30.73,0:12:33.44,Default,,0,0,0,,{\blur3}{\fad(00,40)}Di dunia tanpa belas kasih ini,
Dialogue: 0,0:12:34.91,0:12:38.68,Default,,0,0,0,,{\blur3}{\fad(00,40)}keadilan tanpa kekuatan tidak ada artinya.
Dialogue: 0,0:12:40.36,0:12:43.20,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kalau tidak bisa mengatasi
Dialogue: 0,0:12:43.20,0:12:45.66,Default,,0,0,0,,{\blur3}{\fad(00,40)}kesulitan yang menghadang,
Dialogue: 0,0:12:46.84,0:12:52.21,Default,,0,0,0,,{\blur3}{\fad(00,40)}melindungi umat manusia pun akan mustahil.
Dialogue: 0,0:12:55.28,0:12:57.32,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kalau begitu, biarlah
Dialogue: 0,0:12:57.32,0:13:03.47,Default,,0,0,0,,{\blur3}{\fad(00,40)}dunia ini hancur di tangan sang pelindung,\Nyaitu Pahlawan.
Dialogue: 0,0:13:04.33,0:13:08.72,Default,,0,0,0,,{\blur3}{\fad(00,40)}Rupanya kamu bertaruh\Nuntuk terakhir kalinya.
Dialogue: 0,0:13:08.72,0:13:12.98,Default,,0,0,0,,{\blur3}{\fad(00,40)}Keinginanmu bukan membuat Chronoa mengamuk,
Dialogue: 0,0:13:13.47,0:13:16.44,Default,,0,0,0,,{\blur3}{\fad(00,40)}tapi membangkitkan pahlawan
Dialogue: 0,0:13:16.44,0:13:19.24,Default,,0,0,0,,{\blur3}{\fad(00,40)}untuk dijadikan harapan umat manusia.
Dialogue: 0,0:13:19.95,0:13:25.29,Default,,0,0,0,,{\blur3}{\fad(00,40)}Harapanmu melindungi umat manusia\Ntidak berubah sampai sekarang.
Dialogue: 0,0:13:27.16,0:13:32.00,Default,,0,0,0,,{\blur3}{\fad(00,40)}Dasar pria canggung,\Npadahal sudah diberi umur panjang.
Dialogue: 0,0:13:34.92,0:13:37.40,Default,,0,0,0,,{\blur3}{\fad(00,40)}Cita-citaku sendiri
Dialogue: 0,0:13:37.40,0:13:39.08,Default,,0,0,0,,{\blur3}{\fad(00,40)}terasa ringan
Dialogue: 0,0:13:39.08,0:13:43.01,Default,,0,0,0,,{\blur3}{\fad(00,40)}di hadapan beban waktu yang ditanggungnya.
Dialogue: 0,0:13:43.01,0:13:46.76,Default,,0,0,0,,{\blur3}{\fad(00,40)}Anda, Raja Iblis Rimuru,
Dialogue: 0,0:13:47.37,0:13:49.52,Default,,0,0,0,,{\blur3}{\fad(00,40)}dan kalau dia juga bergabung...
Dialogue: 0,0:13:50.87,0:13:54.16,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kamu sudah menuntaskan peranmu.
Dialogue: 0,0:13:54.16,0:13:57.85,Default,,0,0,0,,{\blur3}{\fad(00,40)}Serahkan sisanya padaku dan beristirahatlah.
Dialogue: 0,0:13:57.85,0:13:59.78,Default,,0,0,0,,{\blur3}{\fad(00,40)}Nona Luminus.
Dialogue: 0,0:14:00.32,0:14:03.32,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku punya satu permintaan.
Dialogue: 0,0:14:03.87,0:14:05.16,Default,,0,0,0,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:14:06.78,0:14:08.81,Default,,0,0,0,,{\blur3}{\fad(00,40)}Percayakan
Dialogue: 0,0:14:09.68,0:14:11.21,Default,,0,0,0,,{\blur3}{\fad(00,40)}harapanku
Dialogue: 0,0:14:11.74,0:14:13.10,Default,,0,0,0,,{\blur3}{\fad(00,40)}pada gadis itu.
Dialogue: 0,0:14:16.91,0:14:18.46,Default,,0,0,0,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:14:38.96,0:14:41.49,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kamu sudah terbebas dari takdir ini, ya?
Dialogue: 0,0:14:42.35,0:14:44.70,Default,,0,0,0,,{\blur3}{\fad(00,40)}Beristirahatlah dengan tenang.
Dialogue: 0,0:14:52.01,0:14:53.50,Default,,0,0,0,,{\blur3}{\fad(00,40)}Maaf membuatmu menunggu.
Dialogue: 0,0:14:53.50,0:14:57.24,Default,,0,0,0,,{\blur3}{\fad(00,40)}Luminus, aku akan mengintervensi\NSkill milik Chloe,
Dialogue: 0,0:14:57.24,0:15:00.88,Default,,0,0,0,,{\blur3}{\fad(00,40)}manfaatkan itu untuk mengambil\Nkembali jiwa Hinata.
Dialogue: 0,0:15:00.88,0:15:04.40,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku butuh energi pengganti\Nuntuk memasukkannya.
Dialogue: 0,0:15:04.40,0:15:06.01,Default,,0,0,0,,{\blur3}{\fad(00,40)}Jangan khawatir.
Dialogue: 0,0:15:06.01,0:15:08.26,Default,,0,0,0,,{\blur3}{\fad(00,40)}Biar aku yang mengurusnya.
Dialogue: 0,0:15:08.26,0:15:09.12,Default,,0,0,0,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:15:10.01,0:15:11.22,Default,,0,0,0,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:15:22.49,0:15:25.26,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ketemu!\NJiwa Hinata!
Dialogue: 0,0:15:25.65,0:15:26.70,Default,,0,0,0,,{\blur3}{\fad(00,40)}Luminus.
Dialogue: 0,0:15:26.70,0:15:27.80,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:15:29.16,0:15:30.95,Default,,0,0,0,,{\blur3}{\fad(00,40)}Rebirth!
Dialogue: 0,0:15:34.20,0:15:37.21,Default,,0,0,0,,{\blur3}{\fad(00,40)}Teknik tingkat tinggi apa ini?
Dialogue: 0,0:15:37.66,0:15:40.11,Default,,0,0,0,,{\blur3}{\fad(00,40)}Analisis Penilaian gagal.
Dialogue: 0,0:15:40.11,0:15:43.12,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kekuatannya setara dengan Skill Ultima.
Dialogue: 0,0:15:43.12,0:15:45.38,Default,,0,0,0,,{\blur3}{\fad(00,40)}Wajar Luminus bisa melakukannya.
Dialogue: 0,0:15:45.38,0:15:48.32,Default,,0,0,0,,{\blur3}{\fad(00,40)}Justru aku bisa menyerahkannya dengan tenang.
Dialogue: 0,0:15:50.46,0:15:55.29,Default,,0,0,0,,{\blur3}{\fad(00,40)}Serpihan Hinata menyatu dengan Skill Unik\NMatematikawan miliknya.
Dialogue: 0,0:16:01.15,0:16:04.15,Default,,0,0,0,,{\blur3}{\fad(00,40)}Oke, pemisahan berhasil.
Dialogue: 0,0:16:04.15,0:16:05.66,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sisanya...
Dialogue: 0,0:16:07.91,0:16:08.97,Default,,0,0,0,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:16:08.97,0:16:12.81,Default,,0,0,0,,{\blur3}{\fad(00,40)}Energinya jauh melebihi jiwa\Nyang akan ditukarkan.
Dialogue: 0,0:16:23.53,0:16:26.55,Default,,0,0,0,,{\blur3}{\fad(00,40)}Chloe, Hinata.
Dialogue: 0,0:16:26.99,0:16:29.57,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kali ini, kembalilah
Dialogue: 0,0:16:29.57,0:16:31.61,Default,,0,0,0,,{\blur3}{\fad(00,40)}padaku.
Dialogue: 0,0:16:54.45,0:16:55.74,Default,,0,0,0,,{\blur3}{\fad(00,40)}Rimuru!
Dialogue: 0,0:16:59.87,0:17:03.80,Default,,0,0,0,,{\blur3}{\fad(00,40)}Eh? Kok rasanya beda dari bayanganku?
Dialogue: 0,0:17:03.80,0:17:05.38,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tapi reaksi ini...
Dialogue: 0,0:17:06.06,0:17:07.84,Default,,0,0,0,,{\blur3}{\fad(00,40)}Selamat datang, Chloe.
Dialogue: 0,0:17:08.41,0:17:11.13,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku pulang, Rimuru.
Dialogue: 0,0:17:11.64,0:17:13.45,Default,,0,0,0,,{\blur3}{\fad(00,40)}Dia memang Chloe.
Dialogue: 0,0:17:15.26,0:17:18.16,Default,,0,0,0,,{\blur3}{\fad(00,40)}Apa maksudnya ini, Rimuru?
Dialogue: 0,0:17:18.16,0:17:19.14,Default,,0,0,0,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:17:19.14,0:17:20.99,Default,,0,0,0,,{\blur3}{\fad(00,40)}Jelaskan dengan detail.
Dialogue: 0,0:17:20.99,0:17:21.84,Default,,0,0,0,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:17:21.84,0:17:24.56,Default,,0,0,0,,{\blur3}{\fad(00,40)}Bagaimana kalau tenangkan diri kalian dulu?
Dialogue: 0,0:17:24.56,0:17:27.79,Default,,0,0,0,,{\blur3}{\fad(00,40)}Terus kenapa Leon marah juga?
Dialogue: 0,0:17:28.31,0:17:31.32,Default,,0,0,0,,{\blur3}{\fad(00,40)}Syukurlah kalian berdua baik-baik saja.
Dialogue: 0,0:17:32.22,0:17:33.45,Default,,0,0,0,,{\blur3}{\fad(00,40)}Luminus!
Dialogue: 0,0:17:33.45,0:17:35.95,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sudah, duduk saja dulu.
Dialogue: 0,0:17:35.95,0:17:38.59,Default,,0,0,0,,{\blur3}{\fad(00,40)}Izinkan aku berterima kasih.
Dialogue: 0,0:17:39.13,0:17:41.42,Default,,0,0,0,,{\blur3}{\fad(00,40)}Terima kasih, Luminus.
Dialogue: 0,0:17:41.42,0:17:43.71,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kamu sudah menepati janjimu.
Dialogue: 0,0:17:43.71,0:17:46.46,Default,,0,0,0,,{\blur3}{\fad(00,40)}Iya, aku benar-benar berterima kasih.
Dialogue: 0,0:17:46.46,0:17:48.24,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kita bisa berkumpul lagi.
Dialogue: 0,0:17:48.24,0:17:52.34,Default,,0,0,0,,{\blur3}{\fad(00,40)}Bukan, aku senang bisa bertemu\Ndengan Luminus di masa depan.
Dialogue: 0,0:17:52.97,0:17:56.11,Default,,0,0,0,,{\blur3}{\fad(00,40)}Dasar, tidak perlu berterima kasih.
Dialogue: 0,0:17:57.63,0:18:00.48,Default,,0,0,0,,{\blur3}{\fad(00,40)}Baru juga beberapa ratus tahun lalu.
Dialogue: 0,0:18:29.79,0:18:31.34,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sudah bangun?
Dialogue: 0,0:18:33.39,0:18:34.84,Default,,0,0,0,,{\blur3}{\fad(00,40)}Gran.
Dialogue: 0,0:18:35.44,0:18:38.70,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku memimpikan hal yang luar biasa.
Dialogue: 0,0:18:38.70,0:18:39.81,Default,,0,0,0,,{\blur3}{\fad(00,40)}Mimpi?
Dialogue: 0,0:18:40.24,0:18:44.08,Default,,0,0,0,,{\blur3}{\fad(00,40)}Di sana aku jadi wanita yang egois.
Dialogue: 0,0:18:44.08,0:18:45.81,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kamu?
Dialogue: 0,0:18:46.27,0:18:50.25,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kenapa aku tidak memercayai Slime itu, ya?
Dialogue: 0,0:18:50.25,0:18:53.69,Default,,0,0,0,,{\blur3}{\fad(00,40)}Mungkin karena itu mimpi?\NTapi rasanya kurang bijak.
Dialogue: 0,0:18:53.69,0:18:56.55,Default,,0,0,0,,{\blur3}{\fad(00,40)}Jawab yang serius, dong.
Dialogue: 0,0:18:58.97,0:19:01.12,Default,,0,0,0,,{\blur3}{\fad(00,40)}Manusia itu penakut.
Dialogue: 0,0:19:01.66,0:19:05.12,Default,,0,0,0,,{\blur3}{\fad(00,40)}Hati orang yang tidak curiga\Npada orang lain itu indah.
Dialogue: 0,0:19:05.68,0:19:11.18,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tapi menurutku, seorang penguasa\Nharus lebih waspada daripada siapa pun.
Dialogue: 0,0:19:11.18,0:19:16.01,Default,,0,0,0,,{\blur3}{\fad(00,40)}Berarti, manusia tidak akan bisa saling\Nmemahami sampai kapan pun?
Dialogue: 0,0:19:16.01,0:19:17.87,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kita lagi bahas mimpi, kan?
Dialogue: 0,0:19:17.87,0:19:19.72,Default,,0,0,0,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:19:19.72,0:19:22.77,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tapi, kalau memimpikan hal yang sama lagi,
Dialogue: 0,0:19:22.77,0:19:26.00,Default,,0,0,0,,{\blur3}{\fad(00,40)}aku memutuskan akan memercayai Slime itu.
Dialogue: 0,0:19:26.40,0:19:30.77,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku rasa, setelahnya kami bisa akrab.
Dialogue: 0,0:19:31.23,0:19:33.55,Default,,0,0,0,,{\blur3}{\fad(00,40)}Begitu, ya?\NSemoga bisa terwujud.
Dialogue: 0,0:19:34.32,0:19:37.85,Default,,0,0,0,,{\blur3}{\fad(00,40)}Jadi, bagaimana mimpimu?
Dialogue: 0,0:19:38.28,0:19:39.64,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku?
Dialogue: 0,0:19:40.72,0:19:42.08,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku...
Dialogue: 0,0:19:58.06,0:20:01.04,Default,,0,0,0,,{\blur3}{\fad(00,40)}Mimpi yang sangat indah.
Dialogue: 0,0:20:05.00,0:20:08.23,Default,,0,0,0,,{\blur3}{\fad(00,40)}Nah, jangan membuat Razul menunggu.
Dialogue: 0,0:20:08.23,0:20:10.06,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ayo kita berangkat.
Dialogue: 0,0:20:10.06,0:20:11.52,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ada yang ketinggalan?
Dialogue: 0,0:20:12.12,0:20:14.25,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tidak ada.
Dialogue: 0,0:20:15.82,0:20:19.32,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku tidak butuh apa pun selain dirimu.
Dialogue: 0,0:20:20.91,0:20:22.08,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ayo.
Dialogue: 0,0:20:23.12,0:20:24.60,Default,,0,0,0,,{\blur3}{\fad(00,40)}Semuanya sudah menunggu
Dialogue: 0,0:20:25.10,0:20:26.80,Default,,0,0,0,,{\blur3}{\fad(00,40)}di Tanah yang Dijanjikan.
Dialogue: 0,0:20:52.11,0:20:57.07,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sepertinya Gran menjadi gila\Nsetelah kehilangan istrinya.
Dialogue: 0,0:20:57.07,0:21:01.07,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kemudian, harapannya, Maribel juga mati.
Dialogue: 0,0:21:01.07,0:21:03.87,Default,,0,0,0,,{\blur3}{\fad(00,40)}Dia gila lagi dan berbalik arah.
Dialogue: 0,0:21:04.33,0:21:09.16,Default,,0,0,0,,{\blur3}{\fad(00,40)}Jadi yang dia pikirkan adalah rencana\Nuntuk membangkitkan Pahlawan Sejati
Dialogue: 0,0:21:09.16,0:21:12.21,Default,,0,0,0,,{\blur3}{\fad(00,40)}padahal ada risiko dunia bisa hancur?
Dialogue: 0,0:21:12.72,0:21:16.05,Default,,0,0,0,,{\blur3}{\fad(00,40)}Karena dia pria yang kaku dan canggung.
Dialogue: 0,0:21:16.05,0:21:20.18,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sebegitu besarnya cintanya\Npada umat manusia, ya?
Dialogue: 0,0:21:20.72,0:21:23.28,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku tidak bisa mengatakan dia dungu.
Dialogue: 0,0:21:23.79,0:21:25.06,Default,,0,0,0,,{\blur3}{\fad(00,40)}Rimuru!
Dialogue: 0,0:21:25.06,0:21:27.31,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ada yang ingin kubicarakan!
Dialogue: 0,0:21:27.31,0:21:28.68,Default,,0,0,0,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:21:29.31,0:21:31.34,Default,,0,0,0,,{\blur3}{\fad(00,40)}Mau bicara apa?
Dialogue: 0,0:21:31.34,0:21:35.08,Default,,0,0,0,,{\blur3}{\fad(00,40)}Daripada itu, auramu lebih kuat\Ndari sebelumnya, ya?
Dialogue: 0,0:21:35.08,0:21:36.65,Default,,0,0,0,,{\blur3}{\fad(00,40)}Perasaanmu saja.
Dialogue: 0,0:21:36.65,0:21:39.65,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tidak, seperti kata Rimuru...
Dialogue: 0,0:21:39.65,0:21:43.16,Default,,0,0,0,,{\blur3}{\fad(00,40)}Diam! Siapa juga yang peduli\Ndengan pendapat kadal.
Dialogue: 0,0:21:44.16,0:21:47.95,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kayaknya ini topik ranjau.\NMending diam, deh.
Dialogue: 0,0:21:47.95,0:21:49.37,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tidak, Luminus.
Dialogue: 0,0:21:49.37,0:21:53.04,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sekilas Chloe memang hanya terlihat\Nseperti gadis super cantik,
Dialogue: 0,0:21:53.04,0:21:56.02,Default,,0,0,0,,{\blur3}{\fad(00,40)}tapi esensinya justru lebih hebat\Ndaripada Chronoa, kan?
Dialogue: 0,0:21:56.75,0:21:58.76,Default,,0,0,0,,{\blur3}{\fad(00,40)}Peka, dong, Mantan Pahlawan!
Dialogue: 0,0:21:58.76,0:22:03.15,Default,,0,0,0,,{\blur3}{\fad(00,40)}Terus dia bilang gadis super cantik?\NSudah tidak jaga imej lagi rupanya!
Dialogue: 0,0:22:03.15,0:22:04.30,Default,,0,0,0,,{\blur3}{\fad(00,40)}Daripada itu, Chloe.
Dialogue: 0,0:22:04.30,0:22:06.84,Default,,0,0,0,,{\blur3}{\fad(00,40)}Bukankah kamu terlalu menempel sama Rimuru?
Dialogue: 0,0:22:06.84,0:22:08.38,Default,,0,0,0,,{\blur3}{\fad(00,40)}Eh? Masa?
Dialogue: 0,0:22:08.38,0:22:11.16,Default,,0,0,0,,{\blur3}{\fad(00,40)}Iya, sebaiknya jauh-jauh.
Dialogue: 0,0:22:11.60,0:22:15.86,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ih, Kak Leon,\Nkamu terlalu terobsesi sama aku!
Dialogue: 0,0:22:15.86,0:22:16.32,Default,,0,0,0,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:22:16.32,0:22:20.36,Default,,0,0,0,,{\blur3}{\fad(00,40)}Makanya kamu belum dapat pacar\Nsampai sekarang, kan?
Dialogue: 0,0:22:20.36,0:22:22.36,Default,,0,0,0,,{\blur3}{\fad(00,40)}Rimuru, sini.
Dialogue: 0,0:22:24.86,0:22:29.04,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku akan sedikit berbaik hati\Npada Leon nanti, deh.
Dialogue: 0,0:22:32.75,0:22:37.60,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sepertinya aku sudah benar-benar\Nbangkit menjadi Pahlawan.
Dialogue: 0,0:22:37.60,0:22:38.38,Default,,0,0,0,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:22:38.38,0:22:41.77,Default,,0,0,0,,{\blur3}{\fad(00,40)}"Telur pahlawan" yang tumbuh di dalam diriku
Dialogue: 0,0:22:41.77,0:22:45.51,Default,,0,0,0,,{\blur3}{\fad(00,40)}sama telur yang dirawat Hinata menyatu.
Dialogue: 0,0:22:45.51,0:22:47.92,Default,,0,0,0,,{\blur3}{\fad(00,40)}Chloe! Hal sepenting itu...
Dialogue: 0,0:22:47.92,0:22:51.27,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tenang saja,\Ntidak ada yang melihat kita, kok.
Dialogue: 0,0:22:51.85,0:22:56.19,Default,,0,0,0,,{\blur3}{\fad(00,40)}Benar juga, Chloe bukan anak kecil\Nseperti penampilannya.
Dialogue: 0,0:22:56.65,0:23:00.57,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ada dua telur di dalam satu tubuh, ya?
Dialogue: 0,0:23:00.57,0:23:03.12,Default,,0,0,0,,{\blur3}{\fad(00,40)}Keajaiban semacam itu...
Dialogue: 0,0:23:03.80,0:23:05.95,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ah, bukan.
Dialogue: 0,0:23:06.55,0:23:09.18,Default,,0,0,0,,{\blur3}{\fad(00,40)}Chloe mampu melampaui reinkarnasi\Nberulang tidak terhingga
Dialogue: 0,0:23:09.18,0:23:12.33,Default,,0,0,0,,{\blur3}{\fad(00,40)}dengan jiwa yang tetap murni.
Dialogue: 0,0:23:12.33,0:23:15.33,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kehendak pantang menyerahnya\Nyang menepis keputusasaan
Dialogue: 0,0:23:15.33,0:23:19.34,Default,,0,0,0,,{\blur3}{\fad(00,40)}telah membangkitkan Pahlawan Sejati,\NChloe Aubert.
Dialogue: 0,0:23:20.99,0:23:22.65,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kamu sudah berjuang.
Dialogue: 0,0:23:23.59,0:23:28.39,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku bersumpah akan menirumu,\Ntidak akan menyerah apa pun yang terjadi.
Dialogue: 0,0:23:29.26,0:23:30.67,Default,,0,0,0,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:23:31.14,0:23:33.39,Default,,0,0,0,,{\blur3}{\fad(00,40)}Hei, Chloe!
Dialogue: 0,0:23:33.92,0:23:35.40,Default,,0,0,0,,{\blur3}{\fad(00,40)}Iya!
