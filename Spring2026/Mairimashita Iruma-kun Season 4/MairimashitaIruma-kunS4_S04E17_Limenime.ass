Dialogue: 0,0:23:57.54,0:23:59.17,sign,,0,0,0,,(Tambahan)
Dialogue: 0,0:24:29.99,0:24:55.01,sign,,0,0,0,,(Cuplikan)
Dialogue: 0,0:00:00.77,0:00:05.36,Default,,0,0,0,,{\blur3}{\fad(00,40)}dalam lingkungan formal.\NSikap yang bermartabat diperlukan
Dialogue: 0,0:00:05.69,0:00:08.86,Default,,0,0,0,,{\blur3}{\fad(00,40)}Cucu dari keluarga Sullivan, Tuan Iruma.
Dialogue: 0,0:00:12.66,0:00:18.73,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ini undangan Anda untuk hadir\Ndi Thirteen's Dinner.
Dialogue: 0,0:00:21.00,0:00:24.13,Default,,0,0,0,,{\blur3}{\fad(00,40)}Satu-satunya manusia\Nyang tinggal di dunia para iblis.
Dialogue: 0,0:00:24.21,0:00:26.51,Default,,0,0,0,,{\blur3}{\fad(00,40)}Suzuki Iruma, 15 tahun.
Dialogue: 0,0:00:26.88,0:00:30.72,Default,,0,0,0,,{\blur3}{\fad(00,40)}Selagi Iruma menikmati\Nkehidupan sekolahnya di Babyls,
Dialogue: 0,0:00:30.80,0:00:34.02,Default,,0,0,0,,{\blur3}{\fad(00,40)}dia punya ambisi,\Natau lebih tepatnya tujuan.
Dialogue: 0,0:00:34.10,0:00:37.18,Default,,0,0,0,,{\blur3}{\fad(00,40)}Yakni menaikkan peringkatnya.
Dialogue: 0,0:00:37.43,0:00:43.19,Default,,0,0,0,,{\blur3}{\fad(00,40)}Lantas, apakah yang menanti\Ndi akhir perjalanannya?
Dialogue: 0,0:00:49.74,0:00:51.53,Default,,0,0,0,,{\blur3}{\fad(00,40)}Bangkit! Bangkit! Bangkit! Bangkit!♪
Dialogue: 0,0:00:51.61,0:00:53.49,Default,,0,0,0,,{\blur3}{\fad(00,40)}dan egois hingga fajar♪\NMari buat keributan
Dialogue: 0,0:01:00.79,0:01:02.50,Default,,0,0,0,,{\blur3}{\fad(00,40)}Murid berprestasi,\Nkau tahu maksudku?♪
Dialogue: 0,0:01:02.58,0:01:05.05,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kutak tahu apa-apa sejak awal♪
Dialogue: 0,0:01:05.13,0:01:08.51,Default,,0,0,0,,{\blur3}{\fad(00,40)}Abaikan saja perdamaian dan keadilan♪
Dialogue: 0,0:01:09.05,0:01:10.55,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ah, lelah rasanya♪
Dialogue: 0,0:01:10.63,0:01:12.89,Default,,0,0,0,,{\blur3}{\fad(00,40)}Saat ingin menangis,♪
Dialogue: 0,0:01:12.97,0:01:15.02,Default,,0,0,0,,{\blur3}{\fad(00,40)}tujulah panggung nan megah♪
Dialogue: 0,0:01:15.10,0:01:16.85,Default,,0,0,0,,{\blur3}{\fad(00,40)}Bangkit! Bangkit! Bangkit! Bangkit!♪
Dialogue: 0,0:01:16.93,0:01:17.81,Default,,0,0,0,,{\blur3}{\fad(00,40)}Egois hingga akhir♪
Dialogue: 0,0:01:17.89,0:01:21.65,Default,,0,0,0,,{\blur3}{\fad(00,40)}Deru seketika jadi anggun♪
Dialogue: 0,0:01:21.73,0:01:26.40,Default,,0,0,0,,{\blur3}{\fad(00,40)}semuanya dimulai♪\NSaat menggenggam tangan itu,
Dialogue: 0,0:01:26.48,0:01:28.32,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kala lampu menyala lagi,\Nmahatahu dan mahakuasa♪
Dialogue: 0,0:01:28.40,0:01:29.91,Default,,0,0,0,,{\blur3}{\fad(00,40)}akan buat keributan♪
Dialogue: 0,0:01:29.99,0:01:33.53,Default,,0,0,0,,{\blur3}{\fad(00,40)}Jadi ayo kita meriahkan♪
Dialogue: 0,0:01:35.32,0:01:36.25,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tiketnya habis ludes♪
Dialogue: 0,0:01:36.33,0:01:39.71,Default,,0,0,0,,{\blur3}{\fad(00,40)}Pestanya dimulai dalam\Nhitungan satu, dua, dan tiga♪
Dialogue: 0,0:01:39.79,0:01:41.88,Default,,0,0,0,,{\blur3}{\fad(00,40)}Mari berkumpul dan bersorak meriah♪
Dialogue: 0,0:01:43.96,0:01:47.59,Default,,0,0,0,,{\blur3}{\fad(00,40)}Dua, tiga, empat!\NMari bermimpi bersama, Sayang♪
Dialogue: 0,0:01:47.84,0:01:49.68,Default,,0,0,0,,{\blur3}{\fad(00,40)}Buang jauh-jauh rasa khawatir itu♪
Dialogue: 0,0:02:03.73,0:02:07.52,Default,,0,0,0,,{\blur3}{\fad(00,40)}Pestanya dimulai dalam\Nhitungan satu, dua, dan tiga♪
Dialogue: 0,0:02:15.95,0:02:18.27,Default,,0,0,0,,{\blur3}{\fad(00,40)}"Pertemuan Para Pahlawan".
Dialogue: 0,0:02:21.03,0:02:24.06,Default,,0,0,0,,{\blur3}{\fad(00,40)}Di suatu tempat di dunia iblis,\NMenara Babel.
Dialogue: 0,0:02:25.00,0:02:28.80,Default,,0,0,0,,{\blur3}{\fad(00,40)}di lantai 665 adalah\NYang tengah berlangsung
Dialogue: 0,0:02:28.88,0:02:33.49,Default,,0,0,0,,{\blur3}{\fad(00,40)}sebuah jamuan agung tempat\Npara pahlawan dunia iblis berkumpul.
Dialogue: 0,0:02:33.75,0:02:35.80,Default,,0,0,0,,{\blur3}{\fad(00,40)}Thirteen's Dinner.
Dialogue: 0,0:02:55.53,0:02:58.45,Default,,0,0,0,,{\blur3}{\fad(00,40)}yang tidak hadir, ya.\NSeperti biasa, banyak
Dialogue: 0,0:02:58.53,0:03:00.02,Default,,0,0,0,,{\blur3}{\fad(00,40)}Jangan dikatakan.
Dialogue: 0,0:03:00.66,0:03:04.29,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kesampingkan itu, tamu iblis kita\Nperlu memperkenalkan diri.
Dialogue: 0,0:03:12.59,0:03:15.51,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sayap Keputusasaan,\NDari keluarga Barbatos,
Dialogue: 0,0:03:15.59,0:03:18.89,Default,,0,0,0,,{\blur3}{\fad(00,40)}pemanah mayat hidup,\Nsaya Barbatos Bachiko.
Dialogue: 0,0:03:19.68,0:03:23.14,Default,,0,0,0,,{\blur3}{\fad(00,40)}Saya datang atas undangannya.
Dialogue: 0,0:03:29.69,0:03:32.19,Default,,0,0,0,,{\blur3}{\fad(00,40)}Terima kasih telah mengundang saya.
Dialogue: 0,0:03:33.36,0:03:38.12,Default,,0,0,0,,{\blur3}{\fad(00,40)}Oh, pantas saja ada aroma manis\Nyang bikin mual.
Dialogue: 0,0:03:38.20,0:03:42.31,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kenapa kamu ada di sini, Semut Kasar?
Dialogue: 0,0:03:42.79,0:03:46.92,Default,,0,0,0,,{\blur3}{\fad(00,40)}Hah? Kamu sendiri bau daun!
Dialogue: 0,0:03:47.00,0:03:51.84,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kamu minum air rumput liar, ya,\NPutri Gadungan?!
Dialogue: 0,0:03:51.92,0:03:53.88,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kamu makan manis melulu,
Dialogue: 0,0:03:53.96,0:03:57.09,Default,,0,0,0,,{\blur3}{\fad(00,40)}jadi peternak gigi berlubang?!\Nmemangnya mau
Dialogue: 0,0:03:57.17,0:04:02.91,Default,,0,0,0,,{\blur3}{\fad(00,40)}sampai noda tehnya nempel di otakmu!\NKamu sendiri kebanyakan ngeteh
Dialogue: 0,0:04:04.56,0:04:07.48,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kurang ajar! Dasar tak tahu santun!
Dialogue: 0,0:04:07.56,0:04:09.61,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kamu barusan mengejekku bodoh, 'kan?!
Dialogue: 0,0:04:09.69,0:04:12.19,Default,,0,0,0,,{\blur3}{\fad(00,40)}Yang teriak bodoh itu yang bodoh, tahu!
Dialogue: 0,0:04:12.27,0:04:13.44,Default,,0,0,0,,{\blur3}{\fad(00,40)}Berisik!
Dialogue: 0,0:04:13.52,0:04:14.15,Default,,0,0,0,,{\blur3}{\fad(00,40)}Dasar bocah!
Dialogue: 0,0:04:14.23,0:04:15.38,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tak tahu santun!
Dialogue: 0,0:04:16.98,0:04:20.49,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ah, mereka masih saja tidak akrab, ya.
Dialogue: 0,0:04:20.57,0:04:21.87,Default,,0,0,0,,{\blur3}{\fad(00,40)}Apa tak masalah dibiarkan?
Dialogue: 0,0:04:21.95,0:04:25.66,Default,,0,0,0,,{\blur3}{\fad(00,40)}perkataan Paimon,\NTerkadang aku tak paham
Dialogue: 0,0:04:25.74,0:04:28.21,Default,,0,0,0,,{\blur3}{\fad(00,40)}tapi tampaknya Barbatos mengerti.
Dialogue: 0,0:04:28.29,0:04:31.30,Default,,0,0,0,,{\blur3}{\fad(00,40)}Paimon! Dia tamu kita, lo!
Dialogue: 0,0:04:31.38,0:04:33.17,Default,,0,0,0,,{\blur3}{\fad(00,40)}Hayo!
Dialogue: 0,0:04:33.25,0:04:37.72,Default,,0,0,0,,{\blur3}{\fad(00,40)}Padahal para cewek sudah ngumpul!\NMari adakan pesta teh dengan akrab!
Dialogue: 0,0:04:37.80,0:04:39.64,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ra-Ratu Godaan.
Dialogue: 0,0:04:37.80,0:04:42.09,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ah, aku dikerumuni cewek-cewek imut!\NSenangnya!
Dialogue: 0,0:04:39.72,0:04:42.01,Default,,0,0,0,,{\blur3}{\fad(00,40)}Se-Sesak.
Dialogue: 0,0:04:42.09,0:04:44.26,Default,,0,0,0,,{\blur3}{\fad(00,40)}Yuk, peyuk, peyuk, peyuk~
Dialogue: 0,0:04:44.64,0:04:46.52,Default,,0,0,0,,{\blur3}{\fad(00,40)}Meriah sekali, ya.
Dialogue: 0,0:04:47.85,0:04:49.77,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tidak perlu dihentikan?
Dialogue: 0,0:04:49.85,0:04:51.46,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kau saja yang hentikan.
Dialogue: 0,0:04:55.60,0:04:59.65,Default,,0,0,0,,{\blur3}{\fad(00,40)}kekosongan pada 13 Mahkota.\NHari ini, kita akan bahas tentang
Dialogue: 0,0:05:00.23,0:05:04.66,Default,,0,0,0,,{\blur3}{\fad(00,40)}Hilangnya iblis kelas atas\Nadalah hal lumrah di dunia iblis.
Dialogue: 0,0:05:04.74,0:05:08.16,Default,,0,0,0,,{\blur3}{\fad(00,40)}hubungannya atau tidak...\NAku tak yakin ini ada
Dialogue: 0,0:05:08.99,0:05:14.23,Default,,0,0,0,,{\blur3}{\fad(00,40)}sang Raja Kerakusan telah menghilang.\NAnggota 13 Mahkota, Behemolt
Dialogue: 0,0:05:14.75,0:05:19.26,Default,,0,0,0,,{\blur3}{\fad(00,40)}sedang berusaha mencarinya.\NAstaroh sang Pengamat
Dialogue: 0,0:05:19.45,0:05:23.64,Default,,0,0,0,,{\blur3}{\fad(00,40)}Dengan kekosongan pada 13 Mahkota,\Nyang merupakan jantung dunia iblis,
Dialogue: 0,0:05:23.72,0:05:26.26,Default,,0,0,0,,{\blur3}{\fad(00,40)}hal ini dapat menyebabkan kekacauan.
Dialogue: 0,0:05:26.64,0:05:31.98,Default,,0,0,0,,{\blur3}{\fad(00,40)}Oleh karena itu, aku meminta Barbatos hadir\Nsebagai "kandidat baru 13 Mahkota".
Dialogue: 0,0:05:32.06,0:05:33.42,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tunggu.
Dialogue: 0,0:05:34.02,0:05:36.44,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kalau begitu, sang pemanah terkuat,
Dialogue: 0,0:05:36.52,0:05:39.59,Default,,0,0,0,,{\blur3}{\fad(00,40)}sang kakek tua, pemimpin agung,\Njauh lebih pantas, 'kan?
Dialogue: 0,0:05:40.15,0:05:43.20,Default,,0,0,0,,{\blur3}{\fad(00,40)}bukan pemimpin yang malah hadir?\NKenapa gadis cilik yang
Dialogue: 0,0:05:43.28,0:05:47.03,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kau ini... Kau sendiri masih muda\Ndan belum berpengalaman.
Dialogue: 0,0:05:47.19,0:05:50.50,Default,,0,0,0,,{\blur3}{\fad(00,40)}Pemimpin agung tidak akan bergerak\Nkecuali dalam peperangan.
Dialogue: 0,0:05:50.58,0:05:51.98,Default,,0,0,0,,{\blur3}{\fad(00,40)}Selain itu...
Dialogue: 0,0:05:52.29,0:05:54.78,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kami yang memilihnya.
Dialogue: 0,0:05:55.37,0:05:59.30,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kemampuannya pantas untuk 13 Mahkota.
Dialogue: 0,0:06:10.31,0:06:16.09,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tiga Agung sekalian!\NTak kusangka kalian akan turun kemari.
Dialogue: 0,0:06:16.56,0:06:19.24,Default,,0,0,0,,{\blur3}{\fad(00,40)}Apakah sesuatu telah terjadi?
Dialogue: 0,0:06:19.32,0:06:24.60,Default,,0,0,0,,{\blur3}{\fad(00,40)}Eng, aku sudah bicara\Ndengan Levi dan Belyan.
Dialogue: 0,0:06:25.78,0:06:29.14,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kami memutuskan sudah waktunya\Nmemilih Raja Iblis selanjutnya.
Dialogue: 0,0:06:30.20,0:06:32.04,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ra-Raja Iblis?!
Dialogue: 0,0:06:32.12,0:06:32.96,Default,,0,0,0,,{\blur3}{\fad(00,40)}Akhirnya?!
Dialogue: 0,0:06:33.04,0:06:34.48,Default,,0,0,0,,{\blur3}{\fad(00,40)}Wah!
Dialogue: 0,0:06:36.04,0:06:37.69,Default,,0,0,0,,{\blur3}{\fad(00,40)}Akhirnya...
Dialogue: 0,0:06:39.09,0:06:43.80,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku paham betapa sulitnya\Nuntuk memutuskan sosok yang pantas
Dialogue: 0,0:06:43.88,0:06:47.34,Default,,0,0,0,,{\blur3}{\fad(00,40)}menopang dan memimpin\Ndunia iblis saat ini.
Dialogue: 0,0:06:47.58,0:06:51.35,Default,,0,0,0,,{\blur3}{\fad(00,40)}Namun, kami telah lama menunggu.
Dialogue: 0,0:06:51.51,0:06:54.23,Default,,0,0,0,,{\blur3}{\fad(00,40)}Jadi, siapakah sosok itu?!
Dialogue: 0,0:06:54.31,0:06:56.73,Default,,0,0,0,,{\blur3}{\fad(00,40)}Cepat! Cepat beri tahu kami!
Dialogue: 0,0:06:56.81,0:06:59.86,Default,,0,0,0,,{\blur3}{\fad(00,40)}Duh, kau terlalu buru-buru.
Dialogue: 0,0:07:00.27,0:07:04.86,Default,,0,0,0,,{\blur3}{\fad(00,40)}Biar kuberi tahu di awal.\NAku, Levi, dan Belyan tidak termasuk, lo.
Dialogue: 0,0:07:06.53,0:07:09.29,Default,,0,0,0,,{\blur3}{\fad(00,40)}Dunia iblis saat ini sangat tidak stabil.
Dialogue: 0,0:07:09.37,0:07:12.31,Default,,0,0,0,,{\blur3}{\fad(00,40)}Jadi, kita harus fokus pada...
Dialogue: 0,0:07:12.78,0:07:14.69,Default,,0,0,0,,{\blur3}{\fad(00,40)}masa depan dunia iblis.
Dialogue: 0,0:07:17.91,0:07:22.88,Default,,0,0,0,,{\blur3}{\fad(00,40)}yang akan membuka jalan menuju masa depan.\NYang kita butuhkan adalah iblis muda
Dialogue: 0,0:07:24.05,0:07:26.55,Default,,0,0,0,,{\blur3}{\fad(00,40)}kita yang ada di sini\NOleh karena itu,
Dialogue: 0,0:07:26.63,0:07:30.89,Default,,0,0,0,,{\blur3}{\fad(00,40)}sebagai kandidat Raja Iblis selanjutnya!\Nakan mengajukan tiga iblis
Dialogue: 0,0:07:31.51,0:07:33.14,Default,,0,0,0,,{\blur3}{\fad(00,40)}Apa?!
Dialogue: 0,0:07:33.60,0:07:34.98,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tiga...
Dialogue: 0,0:07:35.06,0:07:37.88,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kandidat Raja Iblis selanjutnya?
Dialogue: 0,0:07:38.65,0:07:40.30,Default,,0,0,0,,{\blur3}{\fad(00,40)}Astaga!
Dialogue: 0,0:07:41.48,0:07:45.57,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ya, generasi muda yang berbakat.
Dialogue: 0,0:07:45.65,0:07:47.65,Default,,0,0,0,,{\blur3}{\fad(00,40)}- Yaitu cucuku!
Dialogue: 0,0:07:50.99,0:07:52.64,Default,,0,0,0,,{\blur3}{\fad(00,40)}Leiji!
Dialogue: 0,0:07:56.20,0:07:58.36,Default,,0,0,0,,{\blur3}{\fad(00,40)}Razberry!
Dialogue: 0,0:08:02.83,0:08:05.33,Default,,0,0,0,,{\blur3}{\fad(00,40)}Halo! Salam kenal!
Dialogue: 0,0:08:05.41,0:08:08.28,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku Razberry! Salam kenal, ya!
Dialogue: 0,0:08:08.36,0:08:09.87,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kau...
Dialogue: 0,0:08:11.43,0:08:13.73,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kenapa penampilanmu\Nberantakan begitu?
Dialogue: 0,0:08:13.81,0:08:16.93,Default,,0,0,0,,{\blur3}{\fad(00,40)}untuk memakai pakaian formal.\NHarusnya tertulis di undangan
Dialogue: 0,0:08:18.06,0:08:21.82,Default,,0,0,0,,{\blur3}{\fad(00,40)}Habisnya, moto sekolah kami\Nadalah "kebebasan".
Dialogue: 0,0:08:21.90,0:08:26.32,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tapi sebenarnya, semua ini\Nproduk bermerek! Mahal banget!
Dialogue: 0,0:08:26.40,0:08:28.10,Default,,0,0,0,,{\blur3}{\fad(00,40)}Coba lihat!
Dialogue: 0,0:08:28.48,0:08:34.56,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tak kusangka monyet sepertinya diundang\Nke Thirteen's Dinner yang bermartabat.
Dialogue: 0,0:08:35.74,0:08:37.50,Default,,0,0,0,,{\blur3}{\fad(00,40)}Jelas diundang, dong.
Dialogue: 0,0:08:37.58,0:08:40.50,Default,,0,0,0,,{\blur3}{\fad(00,40)}Habisnya, aku Raja Iblis selanjutnya.
Dialogue: 0,0:08:40.58,0:08:44.04,Default,,0,0,0,,{\blur3}{\fad(00,40)}Jangan bercanda!\NAkulah Raja Iblis selanjutnya.
Dialogue: 0,0:09:02.14,0:09:04.06,Default,,0,0,0,,{\blur3}{\fad(00,40)}Anu...
Dialogue: 0,0:09:05.15,0:09:09.01,Default,,0,0,0,,{\blur3}{\fad(00,40)}Siapa? Pelayan kah?\NOrang luar dilarang masuk.
Dialogue: 0,0:09:09.48,0:09:12.28,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tidak, ini pas banget.\NAyo coba tanya dia.
Dialogue: 0,0:09:12.36,0:09:14.15,Default,,0,0,0,,{\blur3}{\fad(00,40)}Siapa yang kelihatan Raja Iblis banget.
Dialogue: 0,0:09:14.23,0:09:17.20,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kau boleh masuk, kok.
Dialogue: 0,0:09:17.36,0:09:21.63,Default,,0,0,0,,{\blur3}{\fad(00,40)}mengajukan kandidatku.\NNah, tentunya aku juga akan
Dialogue: 0,0:09:21.71,0:09:24.23,Default,,0,0,0,,{\blur3}{\fad(00,40)}Dia tak terduga dan menarik.
Dialogue: 0,0:09:24.31,0:09:27.21,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku menaruh harapanku pada iblis ini.
Dialogue: 0,0:09:30.88,0:09:32.22,Default,,0,0,0,,{\blur3}{\fad(00,40)}Jangan-jangan...!
Dialogue: 0,0:09:33.05,0:09:37.47,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku sangat ingin melihat dunia iblis\Nyang kelak dia ciptakan.
Dialogue: 0,0:09:37.89,0:09:41.40,Default,,0,0,0,,{\blur3}{\fad(00,40)}Eng, aku harus apa?
Dialogue: 0,0:09:41.48,0:09:44.98,Default,,0,0,0,,{\blur3}{\fad(00,40)}yang kelihatan Raja Iblis banget!\NTolong jadi juri! Katakan siapa
Dialogue: 0,0:09:45.39,0:09:46.92,Default,,0,0,0,,{\blur3}{\fad(00,40)}Eh?!
Dialogue: 0,0:09:55.11,0:10:00.56,Default,,0,0,0,,{\blur3}{\fad(00,40)}Lantai 333 menara Babel,\Nrapat cucu Tiga Agung.
Dialogue: 0,0:10:01.12,0:10:04.48,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kalau begitu,\Nkita akan mulai rapatnya.
Dialogue: 0,0:10:05.66,0:10:08.65,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ya! Mohon bantuannya!
Dialogue: 0,0:10:09.63,0:10:13.01,Default,,0,0,0,,{\blur3}{\fad(00,40)}yang cocok jadi Raja Iblis?\NTopiknya, siapakah
Dialogue: 0,0:10:13.20,0:10:15.01,Default,,0,0,0,,{\blur3}{\fad(00,40)}Siapa yang mulai duluan?
Dialogue: 0,0:10:15.38,0:10:17.93,Default,,0,0,0,,{\blur3}{\fad(00,40)}Akulah yang harusnya jadi Raja Iblis.
Dialogue: 0,0:10:18.01,0:10:19.73,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tunggu dulu!
Dialogue: 0,0:10:19.81,0:10:21.19,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kalau begitu, yang pertama...
Dialogue: 0,0:10:21.27,0:10:23.89,Default,,0,0,0,,{\blur3}{\fad(00,40)}Eng, namamu...
Dialogue: 0,0:10:24.10,0:10:26.30,Default,,0,0,0,,{\blur3}{\fad(00,40)}Akademiku...
Dialogue: 0,0:10:26.65,0:10:29.63,Default,,0,0,0,,{\blur3}{\fad(00,40)}Akademi Dunia Iblis, Levialon.
Dialogue: 0,0:10:32.86,0:10:35.53,Default,,0,0,0,,{\blur3}{\fad(00,40)}Akademi bawah laut dengan Nona Levi,\Nsalah satu dari Tiga Agung,
Dialogue: 0,0:10:35.61,0:10:37.41,Default,,0,0,0,,{\blur3}{\fad(00,40)}sebagai kepala sekolahnya.
Dialogue: 0,0:10:37.49,0:10:42.66,Default,,0,0,0,,{\blur3}{\fad(00,40)}pembinaan murid bermoral baik.\NMenjunjung disiplin dan mengutamakan
Dialogue: 0,0:10:42.93,0:10:47.17,Default,,0,0,0,,{\blur3}{\fad(00,40)}Pada upacara penerimaan\Nakademi Levialon yang bergengsi,
Dialogue: 0,0:10:47.40,0:10:52.17,Default,,0,0,0,,{\blur3}{\fad(00,40)}cucu sang kepala sekolah telah melakukan\Nhal yang belum pernah terjadi sebelumnya.
Dialogue: 0,0:10:54.67,0:10:58.43,Default,,0,0,0,,{\blur3}{\fad(00,40)}yang berpidato, Leviathan Leiji.\NPerwakilan murid baru
Dialogue: 0,0:10:58.51,0:11:01.75,Default,,0,0,0,,{\blur3}{\fad(00,40)}Dia bangun kesiangan\Ndan terlambat dua jam!
Dialogue: 0,0:11:03.64,0:11:04.61,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:11:04.69,0:11:10.03,Default,,0,0,0,,{\blur3}{\fad(00,40)}Di hari cerah dengan ombak nan lembut,\Nserta cahaya gemilang dari permukaan laut.
Dialogue: 0,0:11:10.11,0:11:12.86,Default,,0,0,0,,{\blur3}{\fad(00,40)}Dia memulai pidatonya\Nseperti tak terjadi apa-apa.
Dialogue: 0,0:11:10.11,0:11:12.94,Default,,0,0,0,,{\blur3}{\fad(00,40)}telah berkumpul di Levialon ini.\NKami, para murid baru,
Dialogue: 0,0:11:12.94,0:11:14.87,Default,,0,0,0,,{\blur3}{\fad(00,40)}Dibaca seperti tak terjadi apa-apa!
Dialogue: 0,0:11:13.65,0:11:16.07,Default,,0,0,0,,{\blur3}{\fad(00,40)}Akademi bergengsi ini\Nbagaikan samudra yang luas.
Dialogue: 0,0:11:14.95,0:11:16.66,Default,,0,0,0,,{\blur3}{\fad(00,40)}Hah? Apa yang terjadi?
Dialogue: 0,0:11:16.15,0:11:20.83,Default,,0,0,0,,{\blur3}{\fad(00,40)}Di samudra yang luas ini,\Nsembari menentang setiap arus...
Dialogue: 0,0:11:16.74,0:11:18.37,Default,,0,0,0,,{\blur3}{\fad(00,40)}Dia bukan iblis biasa.
Dialogue: 0,0:11:18.45,0:11:20.31,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sungguh iblis yang gila.
Dialogue: 0,0:11:20.83,0:11:23.25,Default,,0,0,0,,{\blur3}{\fad(00,40)}Pidato yang sangat brilian!
Dialogue: 0,0:11:23.33,0:11:27.58,Default,,0,0,0,,{\blur3}{\fad(00,40)}Dia sangat memukau di atas panggung!\NAh, cucuku bersinar terang!
Dialogue: 0,0:11:27.91,0:11:30.51,Default,,0,0,0,,{\blur3}{\fad(00,40)}karena sudah terlambat?!\NKau! Kau tidak minta maaf
Dialogue: 0,0:11:30.59,0:11:32.13,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kenapa kau terlambat?!
Dialogue: 0,0:11:32.21,0:11:34.97,Default,,0,0,0,,{\blur3}{\fad(00,40)}memprotes dengan keras!\NTentu saja para guru
Dialogue: 0,0:11:35.05,0:11:35.84,Default,,0,0,0,,{\blur3}{\fad(00,40)}Namun...
Dialogue: 0,0:11:36.17,0:11:39.24,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku bertindak sesuai aturanku sendiri!
Dialogue: 0,0:11:39.76,0:11:45.67,Default,,0,0,0,,{\blur3}{\fad(00,40)}daripada murid yang tak kukenal.\NDalam aturanku, tidurku jauh lebih penting
Dialogue: 0,0:11:47.68,0:11:49.15,Default,,0,0,0,,{\blur3}{\fad(00,40)}Setelah itu...
Dialogue: 0,0:11:50.06,0:11:52.11,Default,,0,0,0,,{\blur3}{\fad(00,40)}Penembak Meriam Tanpa Izin.
Dialogue: 0,0:11:53.27,0:11:55.11,Default,,0,0,0,,{\blur3}{\fad(00,40)}Pembunuh Penjaga Gerbang.
Dialogue: 0,0:11:57.69,0:11:59.68,Default,,0,0,0,,{\blur3}{\fad(00,40)}Pemahat Gerilya.
Dialogue: 0,0:12:00.15,0:12:03.41,Default,,0,0,0,,{\blur3}{\fad(00,40)}dan perilaku arogannya,\NDengan disiplin otokratis
Dialogue: 0,0:12:03.49,0:12:05.87,Default,,0,0,0,,{\blur3}{\fad(00,40)}dia mendapat banyak julukan.
Dialogue: 0,0:12:07.41,0:12:08.90,Default,,0,0,0,,{\blur3}{\fad(00,40)}Saat ini...
Dialogue: 0,0:12:09.33,0:12:12.25,Default,,0,0,0,,{\blur3}{\fad(00,40)}Hormat kepada Komandan!
Dialogue: 0,0:12:12.42,0:12:13.95,Default,,0,0,0,,{\blur3}{\fad(00,40)}Siap!
Dialogue: 0,0:12:15.63,0:12:20.93,Default,,0,0,0,,{\blur3}{\fad(00,40)}- Leviathan Leiji)\N(Kapten Murid Levialon Saat ini
Dialogue: 0,0:12:15.71,0:12:20.49,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kapten Murid Levialon,\NKomandan, Leviathan Leiji.
Dialogue: 0,0:12:20.93,0:12:24.00,Default,,0,0,0,,{\blur3}{\fad(00,40)}Semua memanggilnya komandan.
Dialogue: 0,0:12:26.18,0:12:29.21,Default,,0,0,0,,{\blur3}{\fad(00,40)}Komandan, apa tugas hari ini?
Dialogue: 0,0:12:31.18,0:12:33.11,Default,,0,0,0,,{\blur3}{\fad(00,40)}Suasana hatiku sedang buruk,\Njadi aku mau pulang.
Dialogue: 0,0:12:33.19,0:12:34.94,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ba-Baik!
Dialogue: 0,0:12:38.99,0:12:42.33,Default,,0,0,0,,{\blur3}{\fad(00,40)}mendengarkan orang lain.\NDengan kata lain, aku tak akan
Dialogue: 0,0:12:42.41,0:12:47.04,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kuputuskan kalau akulah yang harus\Nmembuat aturan dunia iblis ke depannya.
Dialogue: 0,0:12:47.12,0:12:50.00,Default,,0,0,0,,{\blur3}{\fad(00,40)}Wah, tiran banget!
Dialogue: 0,0:12:50.08,0:12:52.05,Default,,0,0,0,,{\blur3}{\fad(00,40)}Berisik, serangga laut!
Dialogue: 0,0:12:52.13,0:12:53.61,Default,,0,0,0,,{\blur3}{\fad(00,40)}Serangga laut?
Dialogue: 0,0:12:54.25,0:12:58.01,Default,,0,0,0,,{\blur3}{\fad(00,40)}Dijuluki komandan itu luar biasa!\NNamamu Leiji, ya?
Dialogue: 0,0:12:58.09,0:12:59.43,Default,,0,0,0,,{\blur3}{\fad(00,40)}Rasanya cocok denganmu!
Dialogue: 0,0:12:59.51,0:13:00.47,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tentu saja.
Dialogue: 0,0:13:00.70,0:13:03.27,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kalau begitu, selanjutnya giliranku, ya.
Dialogue: 0,0:13:03.35,0:13:05.77,Default,,0,0,0,,{\blur3}{\fad(00,40)}Yak, yang kedua, silakan!
Dialogue: 0,0:13:05.85,0:13:08.85,Default,,0,0,0,,{\blur3}{\fad(00,40)}Eng, sekolahku...
Dialogue: 0,0:13:09.60,0:13:11.82,Default,,0,0,0,,{\blur3}{\fad(00,40)}Dunia Iblis, Dunia Bawah Tanah di Barat,
Dialogue: 0,0:13:11.90,0:13:15.69,Default,,0,0,0,,{\blur3}{\fad(00,40)}gedung 66 lantai yang dikelilingi\Nsungai magma yang sangat panas,
Dialogue: 0,0:13:15.77,0:13:18.13,Default,,0,0,0,,{\blur3}{\fad(00,40)}Institut Penguasa Tanah, Jackapo.
Dialogue: 0,0:13:18.69,0:13:21.41,Default,,0,0,0,,{\blur3}{\fad(00,40)}Dengan Belial, salah satu dari Tiga Agung,\Nsebagai kepala sekolahnya.
Dialogue: 0,0:13:21.49,0:13:25.58,Default,,0,0,0,,{\blur3}{\fad(00,40)}Berbagai kompetisi, mulai dari bertarung,\Nbelajar, hingga debat,
Dialogue: 0,0:13:25.66,0:13:28.33,Default,,0,0,0,,{\blur3}{\fad(00,40)}berlangsung tiap hari di tiap lantai.
Dialogue: 0,0:13:28.41,0:13:33.34,Default,,0,0,0,,{\blur3}{\fad(00,40)}dan hanya yang menanglah\NMurid baru akan dikirim ke lantai terendah
Dialogue: 0,0:13:33.42,0:13:37.28,Default,,0,0,0,,{\blur3}{\fad(00,40)}yang diizinkan naik ke lantai atas,\Ntanpa memandang tahun ajaran.
Dialogue: 0,0:13:38.50,0:13:42.12,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sungguh sebuah menara\Npertarungan tanpa hukum.
Dialogue: 0,0:13:46.43,0:13:50.40,Default,,0,0,0,,{\blur3}{\fad(00,40)}Murid yang berkuasa di puncak\Nlantai 60 hingga 66
Dialogue: 0,0:13:50.48,0:13:55.13,Default,,0,0,0,,{\blur3}{\fad(00,40)}akan diberi hak istimewa oleh Belial,\Nsalah satu dari Tiga Agung.
Dialogue: 0,0:13:56.31,0:14:00.28,Default,,0,0,0,,{\blur3}{\fad(00,40)}Masterpool, enam iblis terkuat Jackapo.
Dialogue: 0,0:14:00.36,0:14:01.76,Default,,0,0,0,,{\blur3}{\fad(00,40)}Yey!
Dialogue: 0,0:14:02.03,0:14:05.49,Default,,0,0,0,,{\blur3}{\fad(00,40)}Met siang!\NAku datang untuk menyapa!
Dialogue: 0,0:14:07.99,0:14:12.19,Default,,0,0,0,,{\blur3}{\fad(00,40)}Yah, upacara penerimaannya\Nmembosankan, jadi aku pergi.
Dialogue: 0,0:14:12.62,0:14:15.67,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku disuruh berpidato\Nsebagai perwakilan murid baru,
Dialogue: 0,0:14:15.75,0:14:20.16,Default,,0,0,0,,{\blur3}{\fad(00,40)}tapi aku hanya punya pidato untuk\Npara senior sekalian, jadi langsung saja, ya.
Dialogue: 0,0:14:20.38,0:14:22.03,Default,,0,0,0,,{\blur3}{\fad(00,40)}Eng...
Dialogue: 0,0:14:22.22,0:14:24.85,Default,,0,0,0,,{\blur3}{\fad(00,40)}Begitu masuk, aku akan\Nmenghajar kalian semua
Dialogue: 0,0:14:24.93,0:14:28.93,Default,,0,0,0,,{\blur3}{\fad(00,40)}untuk diriku sendiri.\Ndan menguasai lantai 60 sampai 66
Dialogue: 0,0:14:29.01,0:14:32.52,Default,,0,0,0,,{\blur3}{\fad(00,40)}Perwakilan murid baru,\NBelial Berry Razberry.
Dialogue: 0,0:14:32.60,0:14:35.27,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tambahan, tolong bantu\Npersiapan pindahannya!
Dialogue: 0,0:14:35.35,0:14:36.19,Default,,0,0,0,,{\blur3}{\fad(00,40)}Selesai!
Dialogue: 0,0:14:36.27,0:14:39.32,Default,,0,0,0,,{\blur3}{\fad(00,40)}Karena kalian akan marah banget,\Njadi aku kabur dulu!
Dialogue: 0,0:14:39.40,0:14:40.68,Default,,0,0,0,,{\blur3}{\fad(00,40)}Selamat tinggal!
Dialogue: 0,0:14:40.98,0:14:43.57,Default,,0,0,0,,{\blur3}{\fad(00,40)}Jangan kabur!
Dialogue: 0,0:14:46.65,0:14:48.03,Default,,0,0,0,,{\blur3}{\fad(00,40)}Mereka marah!
Dialogue: 0,0:14:48.45,0:14:53.79,Default,,0,0,0,,{\blur3}{\fad(00,40)}Di hari upacara penerimaan, tak hanya\Nmembuat para Masterpool murka,
Dialogue: 0,0:14:53.87,0:14:57.57,Default,,0,0,0,,{\blur3}{\fad(00,40)}dia malah menantang mereka.
Dialogue: 0,0:14:58.50,0:15:03.78,Default,,0,0,0,,{\blur3}{\fad(00,40)}Setelah itu, dia pun melakukan berbagai\Nperbuatan jahat, aksi brutal, dan keributan.
Dialogue: 0,0:15:04.17,0:15:07.76,Default,,0,0,0,,{\blur3}{\fad(00,40)}Saat ini, ia memegang\Nlantai 60 hingga 62.
Dialogue: 0,0:15:04.67,0:15:14.56,Default,,0,0,0,,{\blur3}{\fad(00,40)}- Belial Berry Razberry)\N(Masterpool Termuda dalam Sejarah Jackapo
Dialogue: 0,0:15:07.84,0:15:11.30,Default,,0,0,0,,{\blur3}{\fad(00,40)}Dia pun jadi Masterpool termuda\Ndalam sejarah Jackapo.
Dialogue: 0,0:15:11.38,0:15:14.56,Default,,0,0,0,,{\blur3}{\fad(00,40)}Belial Berry Razberry.
Dialogue: 0,0:15:16.89,0:15:20.98,Default,,0,0,0,,{\blur3}{\fad(00,40)}Seorang gangster\Ndengan 1200 bawahan.
Dialogue: 0,0:15:21.11,0:15:24.36,Default,,0,0,0,,{\blur3}{\fad(00,40)}Para senior sangat menakutkan,\Ntapi tinggal empat lantai lagi.
Dialogue: 0,0:15:24.44,0:15:25.53,Default,,0,0,0,,{\blur3}{\fad(00,40)}Semangat!
Dialogue: 0,0:15:25.61,0:15:29.20,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kau bos dari organisasi besar, toh!\NKeren, ya!
Dialogue: 0,0:15:29.28,0:15:30.45,Default,,0,0,0,,{\blur3}{\fad(00,40)}Begitulah.
Dialogue: 0,0:15:30.53,0:15:34.54,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kau pria barbar, vulgar,\Ndan rendahan, ya.
Dialogue: 0,0:15:34.62,0:15:36.54,Default,,0,0,0,,{\blur3}{\fad(00,40)}Yo! Si jago muji!
Dialogue: 0,0:15:36.62,0:15:40.05,Default,,0,0,0,,{\blur3}{\fad(00,40)}Serangga sialan,\Nkau bahkan tak bisa mengobrol?
Dialogue: 0,0:15:40.13,0:15:41.55,Default,,0,0,0,,{\blur3}{\fad(00,40)}Serangga sialan...
Dialogue: 0,0:15:41.63,0:15:45.30,Default,,0,0,0,,{\blur3}{\fad(00,40)}mempromosikan diri kami.\NJadi, kami sudah selesai
Dialogue: 0,0:15:45.38,0:15:50.64,Default,,0,0,0,,{\blur3}{\fad(00,40)}Cepat beri pendapatmu, Mas Pelayan.\NSiapa yang Raja Iblis banget?
Dialogue: 0,0:15:52.34,0:15:53.96,Default,,0,0,0,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:15:58.68,0:16:00.65,Default,,0,0,0,,{\blur3}{\fad(00,40)}Eng, kalau begitu...
Dialogue: 0,0:16:01.77,0:16:02.90,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku!
Dialogue: 0,0:16:03.90,0:16:06.15,Default,,0,0,0,,{\blur3}{\fad(00,40)}Di kantin Sekolah Iblis Babyls,
Dialogue: 0,0:16:06.40,0:16:08.91,Default,,0,0,0,,{\blur3}{\fad(00,40)}dalam kompetisi makan!\Naku menang enam kali beruntun
Dialogue: 0,0:16:09.32,0:16:12.54,Default,,0,0,0,,{\blur3}{\fad(00,40)}Saat ini, baik jumlah makanan yang dihabiskan\Nmaupun rekor menang beruntun,
Dialogue: 0,0:16:12.62,0:16:15.35,Default,,0,0,0,,{\blur3}{\fad(00,40)}keduanya sama-sama rekor!
Dialogue: 0,0:16:15.95,0:16:17.46,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tambah!
Dialogue: 0,0:16:17.46,0:16:21.38,Default,,0,0,0,,{\blur3}{\fad(00,40)}lima kali kemenangan beruntun)\N(Saat ini sedang dalam
Dialogue: 0,0:16:18.08,0:16:19.67,Default,,0,0,0,,{\blur3}{\fad(00,40)}Rekor baru lagi!
Dialogue: 0,0:16:19.75,0:16:21.46,Default,,0,0,0,,{\blur3}{\fad(00,40)}Hebat banget!
Dialogue: 0,0:16:28.71,0:16:32.01,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sejujurnya, aku masih\Nbisa lebih dari itu!
Dialogue: 0,0:16:33.39,0:16:35.52,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tidak, bukan soal itu...
Dialogue: 0,0:16:35.68,0:16:38.98,Default,,0,0,0,,{\blur3}{\fad(00,40)}karena baca mantra terlarang.\NSaat awal masuk, aku kena marah
Dialogue: 0,0:16:39.06,0:16:42.11,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku melakukan German Suplex\Nke Azz— ke murid teladan.
Dialogue: 0,0:16:42.19,0:16:42.90,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tunggu.
Dialogue: 0,0:16:42.98,0:16:46.95,Default,,0,0,0,,{\blur3}{\fad(00,40)}Jadi Batra terunyam saat Pesta Batra,\Ndapat nilai 100 di Biologi Fantasi,
Dialogue: 0,0:16:47.03,0:16:48.78,Default,,0,0,0,,{\blur3}{\fad(00,40)}terus, di Makubari Dome—
Dialogue: 0,0:16:48.86,0:16:50.99,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ah, aku tak boleh bilang yang ini.
Dialogue: 0,0:16:51.07,0:16:53.68,Default,,0,0,0,,{\blur3}{\fad(00,40)}Hei, aku bilang tunggu!
Dialogue: 0,0:16:53.76,0:16:56.31,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kenapa kau juga jadi ikutan?
Dialogue: 0,0:16:56.78,0:16:58.58,Default,,0,0,0,,{\blur3}{\fad(00,40)}Karena kalian sudah selesai,
Dialogue: 0,0:16:58.85,0:17:01.57,Default,,0,0,0,,{\blur3}{\fad(00,40)}jadi kupikir aku selanjutnya.
Dialogue: 0,0:17:02.21,0:17:04.67,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tidak, mana bisa begitu.
Dialogue: 0,0:17:04.75,0:17:07.84,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku tahu!\NKau pasti anak aneh!
Dialogue: 0,0:17:08.11,0:17:10.39,Default,,0,0,0,,{\blur3}{\fad(00,40)}Bisa repot kalau kau salah paham.
Dialogue: 0,0:17:10.47,0:17:14.33,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ini diskusi antara kandidat Raja Iblis.
Dialogue: 0,0:17:17.64,0:17:18.98,Default,,0,0,0,,{\blur3}{\fad(00,40)}Permisi.
Dialogue: 0,0:17:19.72,0:17:20.85,Default,,0,0,0,,{\blur3}{\fad(00,40)}Opera!
Dialogue: 0,0:17:21.09,0:17:25.81,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tuan Iruma, padahal saya sudah\Nmenyuruh Anda menunggu di kamar.
Dialogue: 0,0:17:25.89,0:17:30.36,Default,,0,0,0,,{\blur3}{\fad(00,40)}Maaf, kupikir ada yang bertengkar,\Njadi aku penasaran.
Dialogue: 0,0:17:30.63,0:17:31.86,Default,,0,0,0,,{\blur3}{\fad(00,40)}- Iruma?
Dialogue: 0,0:17:32.13,0:17:33.36,Default,,0,0,0,,{\blur3}{\fad(00,40)}Beliau...
Dialogue: 0,0:17:34.15,0:17:39.00,Default,,0,0,0,,{\blur3}{\fad(00,40)}sama seperti kalian berdua.\NBeliau diundang ke Thirteen's Dinner.
Dialogue: 0,0:17:39.08,0:17:41.81,Default,,0,0,0,,{\blur3}{\fad(00,40)}Cucu dari Tuan Sullivan,\Nsalah satu dari Tiga Agung.
Dialogue: 0,0:17:46.17,0:17:47.47,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku Iruma.
Dialogue: 0,0:17:46.59,0:17:50.47,Default,,0,0,0,,{\blur3}{\fad(00,40)}dari Tiga Agung - Iruma)\N(Cucu dari Sullivan, salah satu
Dialogue: 0,0:17:47.55,0:17:48.95,Default,,0,0,0,,{\blur3}{\fad(00,40)}Salam kenal.
Dialogue: 0,0:17:50.47,0:17:55.14,Default,,0,0,0,,{\blur3}{\fad(00,40)}Cucu dari Tiga Agung\Njadi kandidat Raja Iblis, ya?
Dialogue: 0,0:17:55.43,0:17:57.00,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku keberatan!
Dialogue: 0,0:17:57.93,0:18:01.27,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku tidak setuju, lo.
Dialogue: 0,0:18:03.27,0:18:04.94,Default,,0,0,0,,{\blur3}{\fad(00,40)}Baal, berengsek!
Dialogue: 0,0:18:05.02,0:18:07.19,Default,,0,0,0,,{\blur3}{\fad(00,40)}Beraninya kau bersikap\Ntidak sopan kepada Tuan Sullivan!
Dialogue: 0,0:18:07.27,0:18:10.28,Default,,0,0,0,,{\blur3}{\fad(00,40)}Jelas aku keberatan, dong.
Dialogue: 0,0:18:10.44,0:18:16.78,Default,,0,0,0,,{\blur3}{\fad(00,40)}Mana bisa bocah peringkat rendah\Ntiba-tiba jadi bos baru kita.
Dialogue: 0,0:18:17.57,0:18:21.29,Default,,0,0,0,,{\blur3}{\fad(00,40)}Itu jelas tidak bisa diterima, 'kan?
Dialogue: 0,0:18:22.75,0:18:25.71,Default,,0,0,0,,{\blur3}{\fad(00,40)}Jangan buru-buru begitu, Dik Petir.
Dialogue: 0,0:18:26.87,0:18:31.30,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kami tidak mencoba memaksa kalian\Nuntuk setuju begitu saja.
Dialogue: 0,0:18:31.38,0:18:33.20,Default,,0,0,0,,{\blur3}{\fad(00,40)}Iya, 'kan, Sully?
Dialogue: 0,0:18:34.67,0:18:38.47,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kami pikir kita harus fokus\Npada "potensi".
Dialogue: 0,0:18:39.26,0:18:42.60,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kalian adalah "13 Mahkota",\Niblis yang sangat berbakat.
Dialogue: 0,0:18:42.68,0:18:47.46,Default,,0,0,0,,{\blur3}{\fad(00,40)}Normalnya, kita akan memilih salah satu\Ndari kalian untuk jadi Raja Iblis selanjutnya.
Dialogue: 0,0:18:48.19,0:18:54.01,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tapi, justru karena berbakat, akan sia-sia\Nkalau kalian saling menjatuhkan.
Dialogue: 0,0:18:55.32,0:19:00.77,Default,,0,0,0,,{\blur3}{\fad(00,40)}Dunia iblis yang saat ini tidak stabil\Nmembutuhkan Raja Iblis yang tiada duanya.
Dialogue: 0,0:19:01.49,0:19:06.20,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tuan Delkira adalah\NRaja Iblis yang tiada tanding.
Dialogue: 0,0:19:06.28,0:19:10.01,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kita telah dipandu dan terpesona\Noleh kebesaran beliau.
Dialogue: 0,0:19:10.09,0:19:13.66,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tak seorang pun dari kita\Nyang bisa menggantikan dirinya.
Dialogue: 0,0:19:14.50,0:19:17.06,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kalau begitu,\Nbukan memilih dari 13 Mahkota,
Dialogue: 0,0:19:17.14,0:19:21.46,Default,,0,0,0,,{\blur3}{\fad(00,40)}bagaimana kalau 13 Mahkota\Nyang membesarkan Raja Iblis?
Dialogue: 0,0:19:22.85,0:19:29.52,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ini adalah pembicaraan tentang "mendidik"\Ndemi membawa harapan bagi masa depan.
Dialogue: 0,0:19:34.65,0:19:38.62,Default,,0,0,0,,{\blur3}{\fad(00,40)}Makan malam ini jadi membosankan\Nkarena menunya sama terus.
Dialogue: 0,0:19:38.70,0:19:41.12,Default,,0,0,0,,{\blur3}{\fad(00,40)}Anggap saja itu bumbu dari kami.
Dialogue: 0,0:19:41.20,0:19:43.54,Default,,0,0,0,,{\blur3}{\fad(00,40)}Apa kalian menyukainya?
Dialogue: 0,0:19:44.70,0:19:45.83,Default,,0,0,0,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:19:45.91,0:19:50.00,Default,,0,0,0,,{\blur3}{\fad(00,40)}13 Mahkota memilih kandidat\NRaja Iblis secara pribadi.
Dialogue: 0,0:19:50.08,0:19:51.69,Default,,0,0,0,,{\blur3}{\fad(00,40)}Mendidik...
Dialogue: 0,0:19:52.17,0:19:54.51,Default,,0,0,0,,{\blur3}{\fad(00,40)}"Mendidik anak berbakat", ya?
Dialogue: 0,0:19:54.59,0:19:57.63,Default,,0,0,0,,{\blur3}{\fad(00,40)}Boleh, jadi kedengaran menarik!
Dialogue: 0,0:19:57.71,0:20:03.60,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kalau begitu, izinkan aku mengajukan\Nkandidat Raja Iblis juga.
Dialogue: 0,0:20:03.68,0:20:05.18,Default,,0,0,0,,{\blur3}{\fad(00,40)}Apa?!
Dialogue: 0,0:20:06.68,0:20:08.31,Default,,0,0,0,,{\blur3}{\fad(00,40)}Boleh!
Dialogue: 0,0:20:08.39,0:20:09.61,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tuan Sullivan?!
Dialogue: 0,0:20:09.69,0:20:14.69,Default,,0,0,0,,{\blur3}{\fad(00,40)}Karena akan dididik oleh 13 Mahkota,\Njadi harus berdasar keinginan kalian juga.
Dialogue: 0,0:20:14.85,0:20:18.47,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku sangat menyambut\Npotensi yang makin luas.
Dialogue: 0,0:20:18.65,0:20:22.70,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kalau kalian punya kandidat,\Nsilakan ajukan saja.
Dialogue: 0,0:20:23.03,0:20:24.83,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kandidat Raja Iblis...
Dialogue: 0,0:20:24.91,0:20:26.70,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kami juga bisa mengajukan kandidat?
Dialogue: 0,0:20:27.16,0:20:28.29,Default,,0,0,0,,{\blur3}{\fad(00,40)}Wah.
Dialogue: 0,0:20:28.37,0:20:29.96,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:20:30.75,0:20:34.46,Default,,0,0,0,,{\blur3}{\fad(00,40)}Bawahanku banyak yang emosian,\Ntapi ada yang layak diajukan.
Dialogue: 0,0:20:34.83,0:20:38.95,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku juga punya banyak\Niblis muda yang berbakat.
Dialogue: 0,0:20:39.71,0:20:42.89,Default,,0,0,0,,{\blur3}{\fad(00,40)}Batas mudanya dari umur berapa?
Dialogue: 0,0:20:42.97,0:20:44.64,Default,,0,0,0,,{\blur3}{\fad(00,40)}Berbakat...
Dialogue: 0,0:20:44.72,0:20:46.08,Default,,0,0,0,,{\blur3}{\fad(00,40)}Muda...
Dialogue: 0,0:20:46.47,0:20:47.73,Default,,0,0,0,,{\blur3}{\fad(00,40)}Artinya!
Dialogue: 0,0:20:48.06,0:20:50.77,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ameri bisa jadi Ratu Iblis?!
Dialogue: 0,0:20:50.94,0:20:53.78,Default,,0,0,0,,{\blur3}{\fad(00,40)}Alice bisa jadi Raja Iblis?!
Dialogue: 0,0:20:53.86,0:20:55.61,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ah, tapi...
Dialogue: 0,0:20:55.69,0:20:58.70,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tidak, mungkin cocok.
Dialogue: 0,0:20:58.78,0:21:00.28,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tidak, tapi...
Dialogue: 0,0:21:00.36,0:21:04.37,Default,,0,0,0,,{\blur3}{\fad(00,40)}Dia bakal menanggung\Nbeban yang amat berat!
Dialogue: 0,0:21:05.74,0:21:08.54,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tapi sepertinya anakku tidak cocok.
Dialogue: 0,0:21:08.62,0:21:11.79,Default,,0,0,0,,{\blur3}{\fad(00,40)}Dia pasti bakal bilang "Mari jadikan\NTuan Iruma jadi Raja Iblis Agung".
Dialogue: 0,0:21:11.87,0:21:14.49,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sepertinya akan jadi sengit, ya.
Dialogue: 0,0:21:14.87,0:21:19.55,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ada satu iblis yang kupikir\Nakan menarik kalau dia jadi Raja Iblis.
Dialogue: 0,0:21:19.63,0:21:22.91,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tidak, ada dua orang.
Dialogue: 0,0:21:23.59,0:21:27.06,Default,,0,0,0,,{\blur3}{\fad(00,40)}Jadi tidak sabar melihat\Nsemuanya saling bersaing.
Dialogue: 0,0:21:27.14,0:21:30.44,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ya, aku sangat menantikannya.
Dialogue: 0,0:21:30.52,0:21:33.52,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kalau begitu, mari kita cicipi sedikit.
Dialogue: 0,0:21:34.77,0:21:39.47,Default,,0,0,0,,{\blur3}{\fad(00,40)}Mereka datang, 'kan?\NTamu yang jadi bumbu makan malam kita.
Dialogue: 0,0:21:39.65,0:21:43.03,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kalau begitu, mari kita\Nnikmati sebaik mungkin.
Dialogue: 0,0:21:43.53,0:21:47.56,Default,,0,0,0,,{\blur3}{\fad(00,40)}Wawancara dengan 13 Mahkota.
Dialogue: 0,0:22:03.13,0:22:05.10,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sip, ayo mulai!♪
Dialogue: 0,0:22:05.18,0:22:06.47,Default,,0,0,0,,{\blur3}{\fad(00,40)}Menang! Menang!♪
Dialogue: 0,0:22:06.55,0:22:07.60,Default,,0,0,0,,{\blur3}{\fad(00,40)}Pasti menang!♪
Dialogue: 0,0:22:07.68,0:22:08.85,Default,,0,0,0,,{\blur3}{\fad(00,40)}Menang! Menang!♪
Dialogue: 0,0:22:08.93,0:22:10.10,Default,,0,0,0,,{\blur3}{\fad(00,40)}Menang dengan gemilang♪
Dialogue: 0,0:22:10.18,0:22:11.35,Default,,0,0,0,,{\blur3}{\fad(00,40)}Menang! Menang!♪
Dialogue: 0,0:22:11.43,0:22:12.61,Default,,0,0,0,,{\blur3}{\fad(00,40)}Menang dengan iseng♪
Dialogue: 0,0:22:12.69,0:22:13.94,Default,,0,0,0,,{\blur3}{\fad(00,40)}Menang! Menang!♪
Dialogue: 0,0:22:14.02,0:22:15.65,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kamilah pemenangnya!♪
Dialogue: 0,0:22:15.73,0:22:17.86,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kemenangan luar biasa!♪
Dialogue: 0,0:22:17.94,0:22:20.41,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ya! Ya! Ya! Menang lagi hari ini!♪
Dialogue: 0,0:22:20.49,0:22:22.82,Default,,0,0,0,,{\blur3}{\fad(00,40)}Senang! Senang! Duar! Terbaik!♪
Dialogue: 0,0:22:22.90,0:22:25.49,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ya! Ya! Ya! Kemenangan sempurna!♪
Dialogue: 0,0:22:25.57,0:22:27.66,Default,,0,0,0,,{\blur3}{\fad(00,40)}Senang! Senang! Duar! Jempolan!♪
Dialogue: 0,0:22:27.74,0:22:30.50,Default,,0,0,0,,{\blur3}{\fad(00,40)}Bukannya enggak bakal kalah,\Ntapi mustahil kalah♪
Dialogue: 0,0:22:30.58,0:22:33.04,Default,,0,0,0,,{\blur3}{\fad(00,40)}Berjuang tuh rasanya mengasyikkan♪
Dialogue: 0,0:22:33.12,0:22:35.55,Default,,0,0,0,,{\blur3}{\fad(00,40)}Makanan enak pun\Nbuat kualitas hidup naik♪
Dialogue: 0,0:22:35.63,0:22:38.34,Default,,0,0,0,,{\blur3}{\fad(00,40)}Pertumbuhan pesat tak terbendung!\NMantap! Kawan!♪
Dialogue: 0,0:22:38.42,0:22:39.34,Default,,0,0,0,,{\blur3}{\fad(00,40)}Hei! Yo!♪
Dialogue: 0,0:22:39.42,0:22:42.14,Default,,0,0,0,,{\blur3}{\fad(00,40)}Punya teman 'tuk berlomba tuh terbaik!♪
Dialogue: 0,0:22:42.22,0:22:44.85,Default,,0,0,0,,{\blur3}{\fad(00,40)}Bisa melampaui batasan\Ndiri sendiri tuh terkuat!♪
Dialogue: 0,0:22:44.93,0:22:47.43,Default,,0,0,0,,{\blur3}{\fad(00,40)}Imutnya bukan main! Bodoh!♪
Dialogue: 0,0:22:47.51,0:22:50.56,Default,,0,0,0,,{\blur3}{\fad(00,40)}Itu sudah pasti aku!♪
Dialogue: 0,0:22:50.64,0:22:51.48,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tentu, dong!♪
Dialogue: 0,0:22:51.56,0:22:54.15,Default,,0,0,0,,{\blur3}{\fad(00,40)}Raih kemenangan dengan\Nsegenap kekuatan♪
Dialogue: 0,0:22:54.23,0:22:56.44,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kami 'kan tokoh utama,\Njadi pasti memimpin!♪
Dialogue: 0,0:22:56.69,0:22:59.24,Default,,0,0,0,,{\blur3}{\fad(00,40)}Hidup bersama jadi pusat perhatian♪
Dialogue: 0,0:22:59.32,0:23:00.70,Default,,0,0,0,,{\blur3}{\fad(00,40)}Heroine dijamin menang!♪
Dialogue: 0,0:23:00.78,0:23:01.70,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kami menang!♪
Dialogue: 0,0:23:01.78,0:23:02.91,Default,,0,0,0,,{\blur3}{\fad(00,40)}Duk, duk, tok, tok♪
Dialogue: 0,0:23:02.99,0:23:03.87,Default,,0,0,0,,{\blur3}{\fad(00,40)}La, la, la, la, yey♪
Dialogue: 0,0:23:03.95,0:23:05.74,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kisah kita berempat!!♪
Dialogue: 0,0:23:05.82,0:23:06.74,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sip, menang!♪
Dialogue: 0,0:23:06.82,0:23:07.33,Default,,0,0,0,,{\blur3}{\fad(00,40)}Wus, wus, dor, dor♪
Dialogue: 0,0:23:07.41,0:23:07.95,Default,,0,0,0,,{\blur3}{\fad(00,40)}Buk, buk, blar, blar♪
Dialogue: 0,0:23:08.03,0:23:09.04,Default,,0,0,0,,{\blur3}{\fad(00,40)}Berdebar dengan kencangnya♪
Dialogue: 0,0:23:09.12,0:23:11.62,Default,,0,0,0,,{\blur3}{\fad(00,40)}Motivasiku melambung tinggi!!♪
Dialogue: 0,0:23:11.70,0:23:13.67,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tu, wa, lalu maju♪
Dialogue: 0,0:23:13.75,0:23:14.13,Default,,0,0,0,,{\blur3}{\fad(00,40)}Demi aku♪
Dialogue: 0,0:23:14.21,0:23:16.17,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ditambah lagi, runaway♪
Dialogue: 0,0:23:16.25,0:23:16.63,Default,,0,0,0,,{\blur3}{\fad(00,40)}Demi aku♪
Dialogue: 0,0:23:16.71,0:23:18.00,Default,,0,0,0,,{\blur3}{\fad(00,40)}Menang! Menang!♪
Dialogue: 0,0:23:18.08,0:23:19.09,Default,,0,0,0,,{\blur3}{\fad(00,40)}Pasti menang!♪
Dialogue: 0,0:23:19.17,0:23:20.42,Default,,0,0,0,,{\blur3}{\fad(00,40)}Menang! Menang!♪
Dialogue: 0,0:23:20.50,0:23:21.55,Default,,0,0,0,,{\blur3}{\fad(00,40)}Menang dengan gemilang♪
Dialogue: 0,0:23:21.63,0:23:23.01,Default,,0,0,0,,{\blur3}{\fad(00,40)}Menang! Menang!♪
Dialogue: 0,0:23:23.09,0:23:24.01,Default,,0,0,0,,{\blur3}{\fad(00,40)}Menang dengan iseng♪
Dialogue: 0,0:23:24.09,0:23:25.47,Default,,0,0,0,,{\blur3}{\fad(00,40)}Menang! Menang!♪
Dialogue: 0,0:23:25.55,0:23:29.05,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kamilah pemenangnya!♪
Dialogue: 0,0:23:29.34,0:23:33.14,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tambahan!
Dialogue: 0,0:23:33.64,0:23:36.39,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ini digunakan untuk apa, ya?
Dialogue: 0,0:23:38.77,0:23:40.17,Default,,0,0,0,,{\blur3}{\fad(00,40)}Cakram terbang?
Dialogue: 0,0:23:43.15,0:23:44.72,Default,,0,0,0,,{\blur3}{\fad(00,40)}Memutar piring?
Dialogue: 0,0:23:45.03,0:23:47.41,Default,,0,0,0,,{\blur3}{\fad(00,40)}Bagaimana ini?!\NAku belum latihan!
Dialogue: 0,0:23:47.49,0:23:48.99,Default,,0,0,0,,{\blur3}{\fad(00,40)}Itu tidak akan terjadi!
Dialogue: 0,0:23:49.07,0:23:51.16,Default,,0,0,0,,{\blur3}{\fad(00,40)}Dia beneran anak aneh!
Dialogue: 0,0:23:51.33,0:23:54.17,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kali ini, ada dua tambahan sekaligus!
Dialogue: 0,0:23:54.25,0:23:55.15,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:23:55.37,0:23:59.17,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tambahan sekali lagi!
Dialogue: 0,0:23:59.54,0:24:03.17,Default,,0,0,0,,{\blur3}{\fad(00,40)}Hei, aku juga mau coba\Nmantra terlarang yang tadi kau bilang.
Dialogue: 0,0:24:03.25,0:24:04.13,Default,,0,0,0,,{\blur3}{\fad(00,40)}- Eh?!\N- Apa?!
Dialogue: 0,0:24:04.13,0:24:07.38,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ayam!
Dialogue: 0,0:24:04.42,0:24:07.38,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kalau gagal,\Ntubuhmu bakal meledak?!
Dialogue: 0,0:24:07.63,0:24:09.64,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kalau tidak salah, Aberu—
Dialogue: 0,0:24:10.64,0:24:12.10,Default,,0,0,0,,{\blur3}{\fad(00,40)}Leiji?!
Dialogue: 0,0:24:12.18,0:24:15.68,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ba-Barusan, kau menghentikan dia?
Dialogue: 0,0:24:16.47,0:24:19.23,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tidak, aku cuma ingin\Nmenghancurkannya saja.
Dialogue: 0,0:24:19.60,0:24:22.51,Default,,0,0,0,,{\blur3}{\fad(00,40)}Wah, kayaknya asyik!\NAku juga mau melakukannya!
Dialogue: 0,0:24:22.59,0:24:24.95,Default,,0,0,0,,{\blur3}{\fad(00,40)}Krisisnya berhasil dihindari\Nuntuk sementara,
Dialogue: 0,0:24:25.03,0:24:29.51,Default,,0,0,0,,{\blur3}{\fad(00,40)}tapi sudah lama sejak Iruma diingatkan\Ndengan kengerian dunia iblis.
Dialogue: 0,0:24:30.19,0:24:33.50,Default,,0,0,0,,{\blur3}{\fad(00,40)}Bagaimana kalau Alice jadi Raja Iblis, ya?
Dialogue: 0,0:24:33.58,0:24:36.46,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tapi, "Kalau aku Raja Iblis,\NTuan Iruma adalah Raja Iblis Agung."
Dialogue: 0,0:24:36.54,0:24:39.09,Default,,0,0,0,,{\blur3}{\fad(00,40)}"Nah, mari buat patung Tuan Iruma\Ndi seluruh penjuru dunia iblis."
Dialogue: 0,0:24:39.17,0:24:41.25,Default,,0,0,0,,{\blur3}{\fad(00,40)}"Akan kupersembahkan segalanya\Nuntuk Tuan Iruma!"
Dialogue: 0,0:24:41.33,0:24:42.84,Default,,0,0,0,,{\blur3}{\fad(00,40)}Dia pasti bakal bilang begitu.
Dialogue: 0,0:24:42.92,0:24:45.93,Default,,0,0,0,,{\blur3}{\fad(00,40)}Alice mungkin tidak cocok\Njadi Raja Iblis, ya.
Dialogue: 0,0:24:46.01,0:24:47.89,Default,,0,0,0,,{\blur3}{\fad(00,40)}Selanjutnya, Selamat Datang\Ndi Sekolah Iblis, Iruma.
Dialogue: 0,0:24:47.97,0:24:50.81,Default,,0,0,0,,{\blur3}{\fad(00,40)}"Bekal untuk Generasi Muda"\Ndan "Di Bawah Sinar Matahari".
Dialogue: 0,0:24:50.89,0:24:53.14,Default,,0,0,0,,{\blur3}{\fad(00,40)}Wah, Iruma, makanmu lahap sekali!
Dialogue: 0,0:24:53.22,0:24:55.01,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kamu boleh makan\Nlebih banyak lagi, kok!
