Dialogue: 0,0:00:06.57,0:00:09.28,Default,,0,0,0,,Suzuki Iruma, umur 15 tahun.
Dialogue: 0,0:00:09.28,0:00:11.45,Default,,0,0,0,,Peringkat He.
Dialogue: 0,0:00:13.91,0:00:17.75,Default,,0,0,0,,Wah, kamu tampak bersemangat, Irubo.
Dialogue: 0,0:00:17.75,0:00:18.75,Default,,0,0,0,,Bang Ali!
Dialogue: 0,0:00:18.75,0:00:23.17,Default,,0,0,0,,Yah, kamu sudah genap 15 tahun\Ndan sebentar lagi naik kelas dua.
Dialogue: 0,0:00:23.17,0:00:24.13,Default,,0,0,0,,Iya!
Dialogue: 0,0:00:24.13,0:00:27.13,Default,,0,0,0,,Saat semuanya merayakan ulang tahunku,
Dialogue: 0,0:00:27.13,0:00:30.30,Default,,0,0,0,,baru terasa kalau aku sudah 15 tahun.
Dialogue: 0,0:00:30.30,0:00:35.22,Default,,0,0,0,,Aku juga sudah bilang ke Clara dan Azz\Nkalau ingin punya tujuan yang lebih tinggi.
Dialogue: 0,0:00:35.22,0:00:39.14,Default,,0,0,0,,Pak Kalego pun bilang ada\Nkewajiban yang menantiku.
Dialogue: 0,0:00:40.06,0:00:43.94,Default,,0,0,0,,Jujur saja, bukan berarti\Naku tidak merasa cemas.
Dialogue: 0,0:00:44.37,0:00:45.57,Default,,0,0,0,,Tapi...
Dialogue: 0,0:00:45.57,0:00:50.53,Default,,0,0,0,,Di saat yang bersamaan,\Naku merasa deg-degan.
Dialogue: 0,0:00:51.57,0:00:55.49,Default,,0,0,0,,Kamu sudah makin mirip iblis, ya, Irubo.
Dialogue: 0,0:00:55.49,0:00:58.75,Default,,0,0,0,,Seorang iblis wajarnya\Nmemang menikmati tekanan!
Dialogue: 0,0:00:58.75,0:01:01.33,Default,,0,0,0,,Ya! Jadi awasi aku terus, ya, Bang Ali!
Dialogue: 0,0:01:02.04,0:01:03.13,Default,,0,0,0,,Aku...
Dialogue: 0,0:01:04.46,0:01:07.96,Default,,0,0,0,,akan jadi pria tangguh yang layak\Nmenyandang peringkat He!
Dialogue: 0,0:01:10.47,0:01:11.88,Default,,0,0,0,,Selamat pagi.
Dialogue: 0,0:01:11.88,0:01:15.97,Default,,0,0,0,,Tolong pakai ini dan jadi Idola Iblis\Npaling imut di dunia iblis.
Dialogue: 0,0:01:15.97,0:01:17.14,Default,,0,0,0,,Bersama dengan Lied.
Dialogue: 0,0:01:17.14,0:01:18.77,Default,,0,0,0,,Kenapa?
Dialogue: 0,0:02:50.86,0:02:53.32,Default,,0,0,0,,"Turnamen Olahraga Idola Iblis".
Dialogue: 0,0:02:55.49,0:02:58.24,Default,,0,0,0,,Ke-Kenapa tiba-tiba?
Dialogue: 0,0:02:58.24,0:02:59.58,Default,,0,0,0,,Tidak tiba-tiba, kok.
Dialogue: 0,0:02:59.58,0:03:01.66,Default,,0,0,0,,Aku sudah bilang\Nsaat Festival Panen, kan?
Dialogue: 0,0:03:02.19,0:03:06.37,Default,,0,0,0,,Selanjutnya, kalian harus menari\Ndi panggung resmi! Bersiaplah!
Dialogue: 0,0:03:07.00,0:03:11.00,Default,,0,0,0,,Lalu, kalian malah bergantung padaku\Ndan berutang budi.
Dialogue: 0,0:03:11.55,0:03:14.17,Default,,0,0,0,,Ini bukan permintaan.
Dialogue: 0,0:03:14.17,0:03:17.80,Default,,0,0,0,,Tapi, janji antara kalian denganku.
Dialogue: 0,0:03:17.80,0:03:19.76,Default,,0,0,0,,Wah, senyum yang indah.
Dialogue: 0,0:03:19.76,0:03:22.72,Default,,0,0,0,,Bentar! Iruma, kamu janji padanya begitu?
Dialogue: 0,0:03:22.72,0:03:24.43,Default,,0,0,0,,Eh? Anu, iya.
Dialogue: 0,0:03:24.43,0:03:26.19,Default,,0,0,0,,Hah? Aku tidak tahu soal itu!
Dialogue: 0,0:03:28.40,0:03:32.57,Default,,0,0,0,,Aku paham perasaan bimbang kalian.\NSemua orang pasti merasa begitu.
Dialogue: 0,0:03:32.57,0:03:37.03,Default,,0,0,0,,Debut itu bagai terjun\Nke ombak yang mengamuk.
Dialogue: 0,0:03:37.03,0:03:38.07,Default,,0,0,0,,Tapi!
Dialogue: 0,0:03:38.07,0:03:41.66,Default,,0,0,0,,Percayalah pada potensi\NLindy dan Illuminati!
Dialogue: 0,0:03:41.66,0:03:42.54,Default,,0,0,0,,Eh?
Dialogue: 0,0:03:42.54,0:03:46.91,Default,,0,0,0,,Dengan bantuanku dan agensiku,\Nkalian pasti akan berkilau!
Dialogue: 0,0:03:46.91,0:03:50.17,Default,,0,0,0,,Tunggu! Dari tadi aku tidak paham!
Dialogue: 0,0:03:50.17,0:03:51.54,Default,,0,0,0,,Agensi apa?
Dialogue: 0,0:03:51.96,0:03:56.47,Default,,0,0,0,,Benar juga, lebih baik kuperlihatkan langsung.
Dialogue: 0,0:04:10.35,0:04:14.32,Default,,0,0,0,,Halo! Kami Idola Iblis,\NKuromu dan Irumi!
Dialogue: 0,0:04:14.32,0:04:16.57,Default,,0,0,0,,Eh?
Dialogue: 0,0:04:17.32,0:04:20.70,Default,,0,0,0,,Eh?
Dialogue: 0,0:04:21.78,0:04:25.37,Default,,0,0,0,,Tidak kusangka Kerori adalah Kuromu.
Dialogue: 0,0:04:25.37,0:04:29.00,Default,,0,0,0,,Terlebih lagi, Idola Iblis misterius\Nyang tiba-tiba muncul,
Dialogue: 0,0:04:29.00,0:04:31.38,Default,,0,0,0,,Irumi, ternyata adalah Iruma.
Dialogue: 0,0:04:31.38,0:04:35.88,Default,,0,0,0,,Kalau dipikir-pikir, memang masuk akal.
Dialogue: 0,0:04:35.88,0:04:38.09,Default,,0,0,0,,Kamu cukup bersemangat, tuh.
Dialogue: 0,0:04:38.09,0:04:41.55,Default,,0,0,0,,Maaf.\NTerima kasih untuk jabat tangannya.
Dialogue: 0,0:04:41.55,0:04:44.89,Default,,0,0,0,,Tapi tidak kusangka Iruma\Nakan mengenakan pakaian seperti itu.
Dialogue: 0,0:04:44.89,0:04:47.06,Default,,0,0,0,,Eh, aku hanya membantu sedikit.
Dialogue: 0,0:04:49.81,0:04:54.15,Default,,0,0,0,,Itu artinya aku harus bernyanyi dan menari\Ndi atas panggung seperti Iruma?
Dialogue: 0,0:04:54.15,0:04:55.48,Default,,0,0,0,,Tentu saja.
Dialogue: 0,0:04:57.07,0:04:59.49,Default,,0,0,0,,Meski permintaan dari Kuromu sekalipun,
Dialogue: 0,0:04:59.49,0:05:03.16,Default,,0,0,0,,pakai baju berenda-renda\Ndi depan orang lain itu...
Dialogue: 0,0:05:04.49,0:05:06.91,Default,,0,0,0,,Ini bukan panggung biasa, lo.
Dialogue: 0,0:05:06.91,0:05:14.04,Default,,0,0,0,,♪ Memasuki bulan ketiga belas ♪
Dialogue: 0,0:05:14.04,0:05:17.63,Default,,0,0,0,,♪ Cowok dan cewek berkumpul ♪
Dialogue: 0,0:05:17.63,0:05:25.56,Default,,0,0,0,,♪ Menyambut dan memeriahkan festival ♪
Dialogue: 0,0:05:25.56,0:05:28.02,Default,,0,0,0,,Ja-Jangan-jangan...
Dialogue: 0,0:05:28.02,0:05:33.10,Default,,0,0,0,,Ya! Festival besar Idola Iblis,\Noleh Idola Iblis, untuk Idola Iblis!
Dialogue: 0,0:05:33.10,0:05:35.86,Default,,0,0,0,,Tradisi tiap akhir tahun\Nyang dipenuhi tawa dan air mata!
Dialogue: 0,0:05:35.86,0:05:37.19,Default,,0,0,0,,Membuat semangat bergejolak!
Dialogue: 0,0:05:37.19,0:05:39.90,Default,,0,0,0,,Turnamen Akbar Olahraga Idola Iblis.
Dialogue: 0,0:05:39.90,0:05:41.78,Default,,0,0,0,,Eh?
Dialogue: 0,0:05:42.20,0:05:45.91,Default,,0,0,0,,Tiap tahunnya, para Idola Iblis\Nmencurahkan keringat dan air mata
Dialogue: 0,0:05:45.91,0:05:48.41,Default,,0,0,0,,pada festival untuk memamerkan\Npertumbuhan gemilangnya.
Dialogue: 0,0:05:48.41,0:05:51.21,Default,,0,0,0,,Idola Iblis papan atas\Nmeraih ketenaran di sini!
Dialogue: 0,0:05:51.21,0:05:54.38,Default,,0,0,0,,Inilah panggung gemilang\Npara Idola Iblis!
Dialogue: 0,0:05:56.29,0:06:00.67,Default,,0,0,0,,Tapi, anak-anak di agensiku\Npayah dalam aktivitas fisik.
Dialogue: 0,0:06:00.67,0:06:02.05,Default,,0,0,0,,Tidak! Tidak! Tidak! Tidak!
Dialogue: 0,0:06:02.05,0:06:05.64,Default,,0,0,0,,Mustahil! Mana bisa kami berpartisipasi\Ndi acara sebesar itu!
Dialogue: 0,0:06:05.64,0:06:07.05,Default,,0,0,0,,Kenapa?
Dialogue: 0,0:06:07.05,0:06:09.89,Default,,0,0,0,,Itu disiarkan langsung\Ndi seluruh dunia iblis, lo!
Dialogue: 0,0:06:09.89,0:06:13.81,Default,,0,0,0,,Kalau kamu ingin kami tampil di sana\Ndengan baju berenda-renda dan lembut...
Dialogue: 0,0:06:13.81,0:06:15.96,Default,,0,0,0,,Meski Iruma bisa, mustahil bagiku!
Dialogue: 0,0:06:17.40,0:06:19.78,Default,,0,0,0,,Bagaimanapun tetap mustahil?
Dialogue: 0,0:06:19.78,0:06:21.69,Default,,0,0,0,,Ah! Imut banget!
Dialogue: 0,0:06:21.69,0:06:25.53,Default,,0,0,0,,Me-Meski Kuromu yang minta,\Nini terlalu berlebihan.
Dialogue: 0,0:06:26.41,0:06:28.53,Default,,0,0,0,,Gyari juga bakal datang, lo!
Dialogue: 0,0:06:35.88,0:06:38.25,Default,,0,0,0,,Idola Iblis Rock, Gyari.
Dialogue: 0,0:06:38.25,0:06:40.92,Default,,0,0,0,,Dengan suara lantang\Ndan penampilan mencolok,
Dialogue: 0,0:06:40.92,0:06:46.09,Default,,0,0,0,,dia adalah harapan Idola Iblis muda\Nyang sepopuler Kuromu.
Dialogue: 0,0:06:46.09,0:06:47.09,Default,,0,0,0,,Lanjutkan.
Dialogue: 0,0:06:47.09,0:06:48.10,Default,,0,0,0,,Lied?
Dialogue: 0,0:06:48.10,0:06:51.14,Default,,0,0,0,,Aku penggemar berat Gyari!
Dialogue: 0,0:06:51.72,0:06:54.52,Default,,0,0,0,,Kamu selalu mendengar lagunya\Nsaat festival panen, kan?
Dialogue: 0,0:06:54.52,0:06:56.23,Default,,0,0,0,,Aku bisa bertemu dengannya?
Dialogue: 0,0:06:56.23,0:06:57.10,Default,,0,0,0,,Bisa.
Dialogue: 0,0:06:58.61,0:07:01.48,Default,,0,0,0,,♪ Memasuki bulan ketiga belas ♪
Dialogue: 0,0:07:01.48,0:07:02.86,Default,,0,0,0,,Iruma.
Dialogue: 0,0:07:02.86,0:07:07.37,Default,,0,0,0,,Turnamen olahraga ini\Nsangat penting bagi Idola Iblis.
Dialogue: 0,0:07:09.12,0:07:12.08,Default,,0,0,0,,Kalau tidak mampu,\Ntidak akan kujadikan partner.
Dialogue: 0,0:07:12.70,0:07:16.21,Default,,0,0,0,,Idola Iblis peringkat He!\NAku mengandalkanmu!
Dialogue: 0,0:07:17.17,0:07:19.67,Default,,0,0,0,,Begitu, ya.\NIni...
Dialogue: 0,0:07:21.30,0:07:24.17,Default,,0,0,0,,Ini kewajiban yang Pak Kalego bilang, ya!
Dialogue: 0,0:07:24.17,0:07:26.55,Default,,0,0,0,,Kurasa bukan ini.
Dialogue: 0,0:07:27.05,0:07:31.64,Default,,0,0,0,,Waktu yang tersisa tidak banyak!\NAyo tuntaskan dengan latihan keras!
Dialogue: 0,0:07:31.64,0:07:33.31,Default,,0,0,0,,Semangat!
Dialogue: 0,0:07:33.31,0:07:35.64,Default,,0,0,0,,Yuk!
Dialogue: 0,0:07:42.61,0:07:45.40,Default,,0,0,0,,Ini daftar anggota tim Kuromu.
Dialogue: 0,0:07:45.40,0:07:48.86,Default,,0,0,0,,Sepertinya ada beberapa\Npendatang baru, Gyari.
Dialogue: 0,0:07:55.62,0:07:57.24,Default,,0,0,0,,Nona Gyari!
Dialogue: 0,0:07:57.24,0:08:00.42,Default,,0,0,0,,Tidak peduli sebanyak apa pun\Nanak buah yang kamu kumpulkan,
Dialogue: 0,0:08:01.42,0:08:06.42,Default,,0,0,0,,aku akan mengakhiri karir Idola Iblismu.
Dialogue: 0,0:08:06.42,0:08:08.26,Default,,0,0,0,,Kuromu!
Dialogue: 0,0:08:18.60,0:08:20.48,Default,,0,0,0,,Bulan ketiga belas.
Dialogue: 0,0:08:20.48,0:08:23.73,Default,,0,0,0,,Itu adalah bulan perayaan\Nbagi para iblis.
Dialogue: 0,0:08:24.98,0:08:29.49,Default,,0,0,0,,Di bulan yang hanya punya 13 hari itu,\NRaja Iblis libur dari tugasnya
Dialogue: 0,0:08:29.49,0:08:34.62,Default,,0,0,0,,dan merayakan kegembiraan tahun baru\Nbersama rakyatnya.
Dialogue: 0,0:08:35.20,0:08:41.17,Default,,0,0,0,,Lalu, hari pergantian menuju bulan ke-13,\Ntanggal 31 Desember,
Dialogue: 0,0:08:41.17,0:08:45.76,Default,,0,0,0,,merupakan hari istimewa\Nyang dirayakan meriah di seluruh dunia iblis.
Dialogue: 0,0:08:46.76,0:08:51.43,Default Above,,0,0,0,,Acara besar yang berlangsung\Npada 31 Desember
Dialogue: 0,0:08:51.43,0:08:53.30,Default Above,,0,0,0,,yang penuh keseruan adalah...
Dialogue: 0,0:08:53.30,0:08:54.51,Default,,0,0,0,,Mau dukung siapa?
Dialogue: 0,0:08:54.51,0:08:55.77,Default,,0,0,0,,- Jelas Kuromu, dong!\N- Aku dukung Tuan Bee!
Dialogue: 0,0:08:55.77,0:08:58.23,Default,,0,0,0,,- Pernak-pernik Gyari dari ujung ke ujung!\N- Sepuluh figur akrilik Saja!
Dialogue: 0,0:08:58.73,0:09:02.06,Default Above,,0,0,0,,Turnamen Olahraga Idola Iblis.
Dialogue: 0,0:09:06.61,0:09:08.90,Default,,0,0,0,,Lu-Luas!
Dialogue: 0,0:09:10.36,0:09:12.24,Default,,0,0,0,,Kameranya juga ada banyak!
Dialogue: 0,0:09:12.24,0:09:14.74,Default,,0,0,0,,Penontonnya juga banyak!
Dialogue: 0,0:09:14.74,0:09:16.29,Default,,0,0,0,,- Aku sangat senang bisa dapat tempat bagus!\N- Idola Iblis ditambah pergantian tahun,
Dialogue: 0,0:09:16.29,0:09:17.70,Default,,0,0,0,,- Aku sangat senang bisa dapat tempat bagus!\N- mantap banget, ya!
Dialogue: 0,0:09:17.70,0:09:19.91,Default,,0,0,0,,Ditambah lagi...
Dialogue: 0,0:09:19.91,0:09:23.38,Default,,0,0,0,,Banyak Idola Iblis terkenal!
Dialogue: 0,0:09:23.88,0:09:28.34,Default,,0,0,0,,Ah, aku pernah lihat dia di TV!\NDia juga!
Dialogue: 0,0:09:29.22,0:09:30.93,Default,,0,0,0,,Bisa dapat tanda tangan tidak, ya?
Dialogue: 0,0:09:30.93,0:09:32.22,Default,,0,0,0,,Hei!
Dialogue: 0,0:09:32.22,0:09:34.30,Default,,0,0,0,,Tenang sedikit, dong.
Dialogue: 0,0:09:34.30,0:09:35.18,Default,,0,0,0,,Kuromu.
Dialogue: 0,0:09:36.18,0:09:37.64,Default,,0,0,0,,Ah, ada Kuromu!
Dialogue: 0,0:09:37.64,0:09:39.06,Default,,0,0,0,,Eh? Mana?
Dialogue: 0,0:09:39.06,0:09:41.69,Default,,0,0,0,,Wah, Kuromu sungguhan!
Dialogue: 0,0:09:41.69,0:09:44.61,Default,,0,0,0,,Jangan-jangan\Nyang di sebelahnya itu Irumi?
Dialogue: 0,0:09:44.61,0:09:47.69,Default,,0,0,0,,Ku-Kuromu dan Irumi memang hebat.
Dialogue: 0,0:09:47.69,0:09:51.32,Default,,0,0,0,,Jangan terbawa suasana!\NKita sudah latihan, kan?
Dialogue: 0,0:09:51.32,0:09:52.86,Default,,0,0,0,,Siap, ya!
Dialogue: 0,0:09:52.86,0:09:54.99,Default,,0,0,0,,Tu, wa!
Dialogue: 0,0:09:54.99,0:09:58.20,Default,,0,0,0,,Aku imut!
Dialogue: 0,0:10:00.04,0:10:01.83,Default,,0,0,0,,- Imut banget!\N- Devimuse memang beda level!
Dialogue: 0,0:10:01.83,0:10:03.33,Default,,0,0,0,,- Cantiknya!\N- Devimuse memang beda level!
Dialogue: 0,0:10:03.33,0:10:05.42,Default,,0,0,0,,Be-Berhasil!
Dialogue: 0,0:10:05.42,0:10:07.67,Default,,0,0,0,,Latihan kita berbuah hasil, ya!
Dialogue: 0,0:10:10.05,0:10:13.88,Default Above,,0,0,0,,Terima kasih sudah datang!\NKami benar-benar tertolong!
Dialogue: 0,0:10:13.88,0:10:16.60,Default,,0,0,0,,Aku Mar, manajer di sini.\NSalam kenal, ya.
Dialogue: 0,0:10:16.60,0:10:17.64,Default,,0,0,0,,Salam kenal.
Dialogue: 0,0:10:17.64,0:10:21.73,Default,,0,0,0,,Irumi pasti jadi topik pembicaraan\Ndan Lindy pun imut.
Dialogue: 0,0:10:21.73,0:10:23.60,Default,,0,0,0,,Kalian pasti berhasil!
Dialogue: 0,0:10:23.60,0:10:25.65,Default,,0,0,0,,Timnya berisi empat orang, kan?
Dialogue: 0,0:10:25.65,0:10:28.15,Default,,0,0,0,,Iya, kalian dan satu orang lagi.
Dialogue: 0,0:10:29.65,0:10:32.49,Default,,0,0,0,,Dia anggota keempatnya?
Dialogue: 0,0:10:32.49,0:10:34.15,Default,,0,0,0,,Bukan.
Dialogue: 0,0:10:34.15,0:10:37.62,Default,,0,0,0,,Dia adalah Chima, adikku.
Dialogue: 0,0:10:37.62,0:10:40.16,Default,,0,0,0,,Dia datang untuk mendukung kalian.
Dialogue: 0,0:10:40.16,0:10:42.16,Default,,0,0,0,,Wah, imutnya.
Dialogue: 0,0:10:42.16,0:10:43.21,Default,,0,0,0,,Iya, kan?
Dialogue: 0,0:10:43.21,0:10:45.08,Default,,0,0,0,,Salam kenal, ya, Chima.
Dialogue: 0,0:10:48.46,0:10:50.00,Default,,0,0,0,,Wah, wah.
Dialogue: 0,0:10:51.46,0:10:53.63,Default,,0,0,0,,Terus, sayur-sayuran ini?
Dialogue: 0,0:10:53.63,0:10:55.43,Default,,0,0,0,,Ah, bagus-bagus, kan?
Dialogue: 0,0:10:55.43,0:10:58.18,Default Above,,0,0,0,,Ini dari anggota tim keempat kita!
Dialogue: 0,0:10:58.18,0:11:03.52,Default Above,,0,0,0,,Ini dari Merun, Idola Iblis baru yang lahir\Ndi pedesaan dan tumbuh dengan alam!
Dialogue: 0,0:11:04.56,0:11:05.64,Default,,0,0,0,,Merun.
Dialogue: 0,0:11:05.64,0:11:08.69,Default,,0,0,0,,Energinya tidak ada habisnya\Ndan sifatnya yang riang
Dialogue: 0,0:11:08.69,0:11:10.98,Default,,0,0,0,,membuat popularitasnya meroket.
Dialogue: 0,0:11:10.98,0:11:13.49,Default,,0,0,0,,Dia salah satu dari\Nsedikit Idola Iblis di Devimuse
Dialogue: 0,0:11:13.49,0:11:16.53,Default,,0,0,0,,yang mahir dalam aktivitas fisik.
Dialogue: 0,0:11:16.53,0:11:18.62,Default,,0,0,0,,Wah, melegakan!
Dialogue: 0,0:11:18.62,0:11:21.24,Default,,0,0,0,,Dia anaknya ramah,\Njadi kalian pasti cepat akrab.
Dialogue: 0,0:11:21.70,0:11:23.66,Default,,0,0,0,,Baru juga dibicarakan...
Dialogue: 0,0:11:23.66,0:11:25.04,Default,,0,0,0,,Ya!
Dialogue: 0,0:11:25.04,0:11:26.21,Default,,0,0,0,,Ciat!
Dialogue: 0,0:11:28.79,0:11:29.96,Default,,0,0,0,,Yo!
Dialogue: 0,0:11:29.96,0:11:32.84,Default,,0,0,0,,Aku datang untuk menemuimu, Kuromu!
Dialogue: 0,0:11:32.84,0:11:34.47,Default,,0,0,0,,Ah, Nona Gyari.
Dialogue: 0,0:11:34.47,0:11:35.93,Default,,0,0,0,,Cantik banget.
Dialogue: 0,0:11:37.64,0:11:39.68,Default,,0,0,0,,Gya-Gya-Gyari?
Dialogue: 0,0:11:39.68,0:11:44.64,Default,,0,0,0,,Gyari, aku sudah selalu bilang, kan?\NBuka pintunya biasa saja.
Dialogue: 0,0:11:44.64,0:11:48.94,Default,,0,0,0,,Hah? Biasa itu tidak rock, tahu.
Dialogue: 0,0:11:48.94,0:11:50.94,Default,,0,0,0,,Kenapa kamu datang ke sini?
Dialogue: 0,0:11:52.86,0:11:56.15,Default,,0,0,0,,Sudah jelas, kan?\NAku datang untuk menyapa.
Dialogue: 0,0:11:57.57,0:11:59.95,Default,,0,0,0,,Lebih tepatnya mendeklarasikan perang.
Dialogue: 0,0:12:02.28,0:12:05.79,Default,,0,0,0,,Gya-Gyari sungguhan!
Dialogue: 0,0:12:05.79,0:12:08.37,Default,,0,0,0,,Mendeklarasikan perang dengan Kuromu?
Dialogue: 0,0:12:08.37,0:12:13.21,Default,,0,0,0,,Iya! Aku akan menangkan\Nturnamen olahraga ini
Dialogue: 0,0:12:13.21,0:12:16.84,Default,,0,0,0,,dan membuatmu pensiun, Kuromu!
Dialogue: 0,0:12:16.84,0:12:18.80,Default,,0,0,0,,Pe-Pensiun?
Dialogue: 0,0:12:23.56,0:12:26.06,Default,,0,0,0,,Rumor itu ternyata benar, ya.
Dialogue: 0,0:12:26.06,0:12:27.10,Default,,0,0,0,,Rumor?
Dialogue: 0,0:12:27.10,0:12:28.48,Default,,0,0,0,,Kalau mereka tidak akur.
Dialogue: 0,0:12:29.14,0:12:32.44,Default,,0,0,0,,Pada mulanya, Gyari juga ada di Devimuse
Dialogue: 0,0:12:32.44,0:12:34.82,Default,,0,0,0,,dan membentuk unit dengan Kuromu.
Dialogue: 0,0:12:34.82,0:12:38.40,Default,,0,0,0,,Tapi, karena Gyari pindah agensi,
Dialogue: 0,0:12:38.40,0:12:40.70,Default,,0,0,0,,sekarang mereka jadi musuh bebuyutan.
Dialogue: 0,0:12:41.74,0:12:45.33,Default,,0,0,0,,Itu alasannya yang ingin membuat\NKuromu pensiun.
Dialogue: 0,0:12:48.37,0:12:52.63,Default,,0,0,0,,Kuromu, akulah yang akan berdiri\Ndi puncak Idola Iblis.
Dialogue: 0,0:12:52.63,0:12:54.38,Default,,0,0,0,,Nona Gyari!
Dialogue: 0,0:12:54.38,0:12:56.42,Default,,0,0,0,,Jadi, akan kukatakan ini berulang kali.
Dialogue: 0,0:12:59.13,0:13:02.14,Default,,0,0,0,,Cepatlah pensiun dari dunia Idola Iblis
Dialogue: 0,0:13:02.14,0:13:04.93,Default,,0,0,0,,dan menikahlah denganku!
Dialogue: 0,0:13:04.93,0:13:05.64,Default,,0,0,0,,Aku menolak!
Dialogue: 0,0:13:05.64,0:13:06.60,Default,,0,0,0,,Kenapa coba?
Dialogue: 0,0:13:06.60,0:13:08.31,Default,,0,0,0,,Lepaskan tanganku!
Dialogue: 0,0:13:08.64,0:13:12.60,Default,,0,0,0,,Dilamar?
Dialogue: 0,0:13:14.77,0:13:17.23,Default,,0,0,0,,Sudah berapa kali kamu bilang begitu...
Dialogue: 0,0:13:17.23,0:13:19.90,Default,,0,0,0,,Inilah kenapa aku menolak\Ntampil bersamamu.
Dialogue: 0,0:13:19.90,0:13:23.74,Default,,0,0,0,,Dengar! Hanya kamulah\Nyang pantas untukku!
Dialogue: 0,0:13:24.33,0:13:28.00,Default,,0,0,0,,Kamu punya sisi imut, cantik,\Ndan keren sekaligus.
Dialogue: 0,0:13:28.00,0:13:32.04,Default,,0,0,0,,Kamu satu-satunya\Nwanita terbaik yang kuakui!
Dialogue: 0,0:13:32.04,0:13:34.59,Default,,0,0,0,,Aku sudah memutuskan\Nuntuk menjadikanmu istriku!
Dialogue: 0,0:13:34.59,0:13:40.30,Default,,0,0,0,,Aku yang nembak di sini, lo! Aku, lo!
Dialogue: 0,0:13:40.30,0:13:42.47,Default,,0,0,0,,Hei, Kuromu.
Dialogue: 0,0:13:42.47,0:13:44.34,Default,,0,0,0,,Aku, lo!
Dialogue: 0,0:13:44.72,0:13:46.18,Default,,0,0,0,,Mau kamu ulang berapa kali?
Dialogue: 0,0:13:46.18,0:13:47.97,Default,,0,0,0,,Anu...
Dialogue: 0,0:13:48.77,0:13:52.48,Default,,0,0,0,,Ta-Tapi, Gyari, mereka berdua...
Dialogue: 0,0:13:52.48,0:13:55.65,Default,,0,0,0,,Ah! Nona Gyari!
Dialogue: 0,0:13:55.65,0:13:59.23,Default,,0,0,0,,Apa boleh buat kalau mereka\Njatuh hati padaku, kan?
Dialogue: 0,0:13:59.23,0:14:00.94,Default,,0,0,0,,Soalnya aku, sih.
Dialogue: 0,0:14:00.94,0:14:03.49,Default,,0,0,0,,Ya! Betul apa kata Nona Gyari!
Dialogue: 0,0:14:03.49,0:14:05.37,Default,,0,0,0,,Merun?
Dialogue: 0,0:14:06.20,0:14:08.87,Default,,0,0,0,,Merun kan anggota tim kita?
Dialogue: 0,0:14:12.21,0:14:14.67,Default,,0,0,0,,Aku menggodanya tadi.
Dialogue: 0,0:14:14.67,0:14:16.42,Default,,0,0,0,,Menggoda...
Dialogue: 0,0:14:18.71,0:14:20.76,Default,,0,0,0,,Merun, balik ke sini!
Dialogue: 0,0:14:20.76,0:14:22.22,Default,,0,0,0,,Ah, aku pindah tim.
Dialogue: 0,0:14:22.22,0:14:23.13,Default,,0,0,0,,Kamu bercanda, kan?
Dialogue: 0,0:14:23.13,0:14:27.64,Default,,0,0,0,,Timmu mulai runtuh, ya.\NBukankah ini masalah?
Dialogue: 0,0:14:28.89,0:14:30.97,Default,,0,0,0,,Yah, jangan khawatir.
Dialogue: 0,0:14:32.18,0:14:37.86,Default,,0,0,0,,Meski kamu mundur dari turnamen,\Npopularitasmu turun, dan pensiun,
Dialogue: 0,0:14:37.86,0:14:40.69,Default,,0,0,0,,aku pasti akan menikahimu,\Nmemanjakanmu,
Dialogue: 0,0:14:40.69,0:14:42.82,Default,,0,0,0,,dan membahagiakanmu.
Dialogue: 0,0:14:45.41,0:14:46.78,Default,,0,0,0,,Dia tak akan pensiun!
Dialogue: 0,0:14:47.74,0:14:49.49,Default,,0,0,0,,Kuromu...
Dialogue: 0,0:14:49.49,0:14:54.12,Default,,0,0,0,,Dia adalah Idola Iblis sungguhan\Nyang berkilauan!
Dialogue: 0,0:14:57.63,0:15:00.34,Default,,0,0,0,,Ah, maaf, aku kelepasan!
Dialogue: 0,0:15:00.34,0:15:02.05,Default,,0,0,0,,Kamu...
Dialogue: 0,0:15:02.05,0:15:04.84,Default,,0,0,0,,Aku tahu kamu.\NIrumi, kan?
Dialogue: 0,0:15:07.64,0:15:10.22,Default,,0,0,0,,Aku benci kamu!
Dialogue: 0,0:15:10.22,0:15:13.39,Default,,0,0,0,,Kuromu meninggalkanku,\Npasangannya di masa depan,
Dialogue: 0,0:15:13.39,0:15:15.73,Default,,0,0,0,,tapi malah bernyanyi mesra denganmu.
Dialogue: 0,0:15:15.73,0:15:17.44,Default,,0,0,0,,Tidak bisa kumaafkan!
Dialogue: 0,0:15:17.44,0:15:22.44,Default,,0,0,0,,Jadi, izinkan aku mengatakan ini padamu.
Dialogue: 0,0:15:25.45,0:15:26.41,Default,,0,0,0,,Jelek!
Dialogue: 0,0:15:27.45,0:15:28.45,Default,,0,0,0,,Jelek!
Dialogue: 0,0:15:29.45,0:15:30.45,Default,,0,0,0,,Jelek!
Dialogue: 0,0:15:35.83,0:15:38.96,Default,,0,0,0,,Kalau begitu, aku akan pulang\Nkarena sudah merasa lega.
Dialogue: 0,0:15:41.55,0:15:45.88,Default,,0,0,0,,Aku pasti akan mendapatkan\Napa yang kuinginkan.
Dialogue: 0,0:15:45.88,0:15:49.30,Default,,0,0,0,,Jangan harap bisa lari\Ndari "Gyari si Rakus".
Dialogue: 0,0:15:49.30,0:15:50.60,Default,,0,0,0,,Kuromu.
Dialogue: 0,0:15:51.97,0:15:53.47,Default,,0,0,0,,Ups.
Dialogue: 0,0:15:55.31,0:16:00.11,Default,,0,0,0,,Dik, kamu penggemarku, kan?\NAku bisa tahu dari tatapanmu.
Dialogue: 0,0:16:00.11,0:16:01.40,Default,,0,0,0,,Ini.
Dialogue: 0,0:16:04.19,0:16:05.36,Default,,0,0,0,,Sampai jumpa!
Dialogue: 0,0:16:05.36,0:16:06.36,Default,,0,0,0,,Nona Gyari!
Dialogue: 0,0:16:06.36,0:16:08.70,Default,,0,0,0,,Hei! Perbaiki pintunya, dong!
Dialogue: 0,0:16:08.70,0:16:10.91,Default,,0,0,0,,Nona Gyari!
Dialogue: 0,0:16:14.79,0:16:17.12,Default,,0,0,0,,Banyak hal yang terjadi\Nsecara mendadak...
Dialogue: 0,0:16:17.12,0:16:19.79,Default,,0,0,0,,Pertama, mari tenangkan diri\Ndan berpikir secara rasional.
Dialogue: 0,0:16:19.79,0:16:21.38,Default,,0,0,0,,Kuromu.
Dialogue: 0,0:16:22.38,0:16:27.09,Default,,0,0,0,,Ayo menangkan turnamen ini!\NKita pasti menang!
Dialogue: 0,0:16:27.09,0:16:29.30,Default,,0,0,0,,Dia sekesal itu...
Dialogue: 0,0:16:29.30,0:16:31.43,Default,,0,0,0,,Itulah yang namanya Idola Iblis!
Dialogue: 0,0:16:31.43,0:16:32.60,Default,,0,0,0,,Tapi...
Dialogue: 0,0:16:32.60,0:16:35.81,Default,,0,0,0,,Bagaimana dengan anggota kita?
Dialogue: 0,0:16:35.81,0:16:39.10,Default,,0,0,0,,Jumlah anggotanya wajib empat orang.
Dialogue: 0,0:16:39.10,0:16:42.77,Default,,0,0,0,,Kalau begini, kita tidak bisa\Nikut turnamen.
Dialogue: 0,0:16:43.19,0:16:44.61,Default,,0,0,0,,Terus, kita harus bagaimana?
Dialogue: 0,0:16:45.69,0:16:47.86,Default,,0,0,0,,Ini bukan waktunya nyantai\Nsambil makan sayur!
Dialogue: 0,0:16:47.86,0:16:50.53,Default,,0,0,0,,Kalau begini, tidak ada cara lain.
Dialogue: 0,0:16:50.53,0:16:51.87,Default,,0,0,0,,Ini waktunya kamu tampil.
Dialogue: 0,0:16:51.87,0:16:52.82,Default,,0,0,0,,Chima.
Dialogue: 0,0:16:52.82,0:16:54.37,Default,,0,0,0,,Sebentar!
Dialogue: 0,0:16:54.37,0:16:56.50,Default,,0,0,0,,Mustahil kalau tiba-tiba begitu!
Dialogue: 0,0:16:56.50,0:16:59.87,Default,,0,0,0,,Tenang saja, dia itu adikku.\NDia imut.
Dialogue: 0,0:16:59.87,0:17:02.88,Default,,0,0,0,,Dia memang imut, tapi lihat itu.
Dialogue: 0,0:17:02.88,0:17:06.88,Default,,0,0,0,,Wajahnya memelas dan dia gemetaran!\NJadi, ampuni dia!
Dialogue: 0,0:17:06.88,0:17:08.13,Default,,0,0,0,,Kalau begitu, biar aku...
Dialogue: 0,0:17:08.13,0:17:09.88,Default,,0,0,0,,Mar, tenang dulu!
Dialogue: 0,0:17:09.88,0:17:12.80,Default,,0,0,0,,Apa tidak ada anak lain di agensi ini?
Dialogue: 0,0:17:12.80,0:17:14.51,Default,,0,0,0,,Semuanya punya pekerjaan masing-masing.
Dialogue: 0,0:17:14.51,0:17:16.39,Default,,0,0,0,,Bulan ke-13 selalu sibuk, sih.
Dialogue: 0,0:17:16.89,0:17:20.64,Default,,0,0,0,,Lagi pula, Idola Iblis biasa\Ntidak akan banyak membantu.
Dialogue: 0,0:17:20.64,0:17:24.94,Default,,0,0,0,,Setiap tim mengumpulkan\NIdola Iblis yang terampil.
Dialogue: 0,0:17:24.94,0:17:27.73,Default,,0,0,0,,Tim yang dibentuk dadakan pasti...
Dialogue: 0,0:17:28.24,0:17:29.99,Default,,0,0,0,,tidak akan bisa mengalahkan Gyari.
Dialogue: 0,0:17:30.99,0:17:33.45,Default,,0,0,0,,Tentu saja aku tidak berniat untuk menyerah.
Dialogue: 0,0:17:33.45,0:17:34.99,Default,,0,0,0,,Tapi...
Dialogue: 0,0:17:34.99,0:17:39.62,Default,,0,0,0,,Kita butuh orang yang kuat, imut, lincah,\Nmampu bekerja sama dengan baik,
Dialogue: 0,0:17:39.62,0:17:42.04,Default,,0,0,0,,dan paham situasi kita!
Dialogue: 0,0:17:42.04,0:17:44.67,Default,,0,0,0,,Mana bisa menemukan—
Dialogue: 0,0:17:46.34,0:17:47.71,Default,,0,0,0,,Permisi.
Dialogue: 0,0:17:48.51,0:17:50.30,Default,,0,0,0,,Aku sukarelawan.
Dialogue: 0,0:17:50.30,0:17:53.59,Default,,0,0,0,,Kami menerima laporan\Nkalau ada keributan di sekitar sini.
Dialogue: 0,0:17:58.97,0:18:01.64,Default,,0,0,0,,I-I-Iru—
Dialogue: 0,0:18:02.81,0:18:05.61,Default,,0,0,0,,Petugas, jangan-jangan\Nkamu penggemarnya Irumi?
Dialogue: 0,0:18:05.61,0:18:10.49,Default,,0,0,0,,Eh? Tidak salah, sih.\NTidak! Eh? Eh?
Dialogue: 0,0:18:10.49,0:18:12.45,Default,,0,0,0,,Ah, tidak, ada alasan di balik ini.
Dialogue: 0,0:18:12.45,0:18:15.49,Default,,0,0,0,,I-Itu benar!\NCepat jelaskan! Jelaskan!
Dialogue: 0,0:18:16.33,0:18:18.12,Default,,0,0,0,,Bicaranya nanti saja.
Dialogue: 0,0:18:18.12,0:18:20.37,Default,,0,0,0,,A-Apa?
Dialogue: 0,0:18:20.87,0:18:22.62,Default,,0,0,0,,Ambilkan kostumnya! Cepat!
Dialogue: 0,0:18:22.62,0:18:23.62,Default,,0,0,0,,Ah, baik!
Dialogue: 0,0:18:23.62,0:18:24.96,Default,,0,0,0,,Rias seminim mungkin!
Dialogue: 0,0:18:24.96,0:18:25.88,Default,,0,0,0,,Serahkan padaku!
Dialogue: 0,0:18:25.88,0:18:28.67,Default,,0,0,0,,Eh?
Dialogue: 0,0:18:33.63,0:18:35.87,Default,,0,0,0,,♪ Memasuki bulan ♪
Dialogue: 0,0:18:35.87,0:18:37.23,Default,,0,0,0,,Hup!
Dialogue: 0,0:18:37.23,0:18:39.40,Default,,0,0,0,,♪ Ketiga belas ♪
Dialogue: 0,0:18:39.40,0:18:40.81,Default,,0,0,0,,Idola Iblis!
Dialogue: 0,0:18:40.81,0:18:44.35,Default,,0,0,0,,♪ Cowok dan cewek berkumpul ♪
Dialogue: 0,0:18:44.35,0:18:46.23,Default,,0,0,0,,Membuat semangat bergejolak!
Dialogue: 0,0:18:46.23,0:18:49.78,Default,,0,0,0,,Inilah Turnamen Olahraga Idola Iblis!
Dialogue: 0,0:18:49.78,0:18:51.40,Default,,0,0,0,,Nah, pemirsa sekalian,
Dialogue: 0,0:18:51.40,0:18:54.78,Default,,0,0,0,,bagaimana kabar kalian\Npada akhir bulan yang sibuk ini?
Dialogue: 0,0:18:54.78,0:18:56.78,Default,,0,0,0,,Tahun ini acaranya kembali lagi!
Dialogue: 0,0:18:56.78,0:18:59.58,Default,,0,0,0,,Festival Idola Iblis yang membuat\Nsemangat bergejolak!
Dialogue: 0,0:18:59.58,0:19:01.79,Default,,0,0,0,,Turnamen Olahraga Idola Iblis!
Dialogue: 0,0:19:02.25,0:19:04.37,Default Above,,0,0,0,,Pembawa acara kalian adalah saya, Machara.
Dialogue: 0,0:19:04.37,0:19:07.67,Default Above,,0,0,0,,Komentatornya adalah\Nspesialis Idola Iblis, Pak Gontetsu.
Dialogue: 0,0:19:07.67,0:19:10.88,Default,,0,0,0,,Kalau begitu, langsung saja kita mulai!
Dialogue: 0,0:19:11.71,0:19:14.51,Default,,0,0,0,,Para peserta telah tiba!
Dialogue: 0,0:19:14.51,0:19:18.01,Default Above,,0,0,0,,Dari agensi Moonpro, tim Nenette!
Dialogue: 0,0:19:18.01,0:19:21.52,Default Above,,0,0,0,,Dari agensi Hellsky, tim Beeber!
Dialogue: 0,0:19:21.52,0:19:23.48,Default,,0,0,0,,Meriah sekali, ya?
Dialogue: 0,0:19:23.48,0:19:25.94,Default,,0,0,0,,Pak Gontetsu, siapakah\Nyang menarik perhatian Anda?
Dialogue: 0,0:19:25.94,0:19:28.27,Default,,0,0,0,,Aku dukung semua kecuali cowok.
Dialogue: 0,0:19:28.27,0:19:29.19,Default,,0,0,0,,Begitu, ya.
Dialogue: 0,0:19:29.19,0:19:33.07,Default,,0,0,0,,Omong-omong, karena alasan sponsor,\Naku mendukung Nenette.
Dialogue: 0,0:19:33.07,0:19:34.74,Default,,0,0,0,,Jujur sekali, ya.
Dialogue: 0,0:19:34.74,0:19:39.62,Default,,0,0,0,,Tidak hanya itu, Idola Iblis unggulan\Ndari tiap agensi pun turut hadir.
Dialogue: 0,0:19:39.62,0:19:44.12,Default,,0,0,0,,Tiap tim punya daya tarik masing-masing\Nsehingga layak ditonton.
Dialogue: 0,0:19:44.12,0:19:45.83,Default,,0,0,0,,Wah, itu...
Dialogue: 0,0:19:46.50,0:19:49.63,Default Above,,0,0,0,,Dari agensi Bell-Lab, tim Saja!
Dialogue: 0,0:19:49.63,0:19:51.46,Default,,0,0,0,,Dia luar biasa, lo!
Dialogue: 0,0:19:51.46,0:19:54.38,Default,,0,0,0,,Di usia semuda itu,\Ndia sudah peringkat Gimmel!
Dialogue: 0,0:19:54.38,0:19:56.30,Default,,0,0,0,,Oh? Itu luar biasa.
Dialogue: 0,0:19:56.30,0:19:57.88,Default,,0,0,0,,Cantiknya!
Dialogue: 0,0:19:57.88,0:20:01.05,Default,,0,0,0,,Aku mengharapkan gerakan berani\Nselayaknya iblis peringkat Gimmel.
Dialogue: 0,0:20:01.05,0:20:04.89,Default,,0,0,0,,Tapi mantap juga, ya.\NTerutama kostumnya—
Dialogue: 0,0:20:04.89,0:20:06.18,Default,,0,0,0,,Tolong diam!
Dialogue: 0,0:20:06.18,0:20:08.35,Default,,0,0,0,,Tapi kalau bahas berani...
Dialogue: 0,0:20:09.35,0:20:11.36,Default,,0,0,0,,Su-Suara ini...
Dialogue: 0,0:20:14.36,0:20:16.36,Default,,0,0,0,,Dia datang!
Dialogue: 0,0:20:18.36,0:20:22.03,Default,,0,0,0,,Dari agensi Idola Iblis Killertune!
Dialogue: 0,0:20:25.50,0:20:27.54,Default,,0,0,0,,Aku telah menunggu!
Dialogue: 0,0:20:27.54,0:20:30.63,Default Above,,0,0,0,,Idola Iblis rock! Tim Gyari!
Dialogue: 0,0:20:30.63,0:20:32.34,Default Above,,0,0,0,,Nona Gyari!
Dialogue: 0,0:20:32.34,0:20:33.67,Default Above,,0,0,0,,Cantiknya!
Dialogue: 0,0:20:33.67,0:20:37.22,Default,,0,0,0,,Reaksi yang luar biasa!\NBintang muda memang luar biasa!
Dialogue: 0,0:20:37.22,0:20:41.18,Default,,0,0,0,,- Nona Gyari! Curi aku!\N- Pak Gontetsu, sadari posisi Anda.
Dialogue: 0,0:20:41.18,0:20:44.47,Default,,0,0,0,,Nona Gyari bergabung bersama\Ndengan haremnya!
Dialogue: 0,0:20:44.47,0:20:46.68,Default,,0,0,0,,Bikin iri banget, ya.
Dialogue: 0,0:20:46.68,0:20:49.77,Default,,0,0,0,,Dia adalah bintang turnamen\Nhari ini, iya, kan?
Dialogue: 0,0:20:49.77,0:20:51.19,Default,,0,0,0,,Iya.
Dialogue: 0,0:20:51.81,0:20:54.98,Default,,0,0,0,,Keserakahan melawan kesombongan.
Dialogue: 0,0:20:54.98,0:20:57.74,Default,,0,0,0,,Dengan penampilannya yang mencolok
Dialogue: 0,0:20:57.74,0:21:01.57,Default,,0,0,0,,dan kemampuan untuk mendapatkan\Napa yang dia inginkan,
Dialogue: 0,0:21:01.57,0:21:06.08,Default,,0,0,0,,dia dijuluki "Si Diva Rakus".
Dialogue: 0,0:21:06.08,0:21:08.58,Default,,0,0,0,,Dan di sisi seberangnya...
Dialogue: 0,0:21:09.46,0:21:14.54,Default,,0,0,0,,Seberapa sombong dan egois dirinya,\Nkita selalu bisa memaafkannya!
Dialogue: 0,0:21:14.54,0:21:17.84,Default,,0,0,0,,Dengan keimutan dan kecantikan\Nyang luar biasa,
Dialogue: 0,0:21:17.84,0:21:20.80,Default,,0,0,0,,dia terkenal sebagai\NIdola Iblis muda nomor satu!
Dialogue: 0,0:21:21.55,0:21:25.56,Default,,0,0,0,,Dari agensi Devimuse,\NSi Diva Sombong!
Dialogue: 0,0:21:27.39,0:21:30.23,Default Above,,0,0,0,,Tim Devimuse!
Dialogue: 0,0:21:30.64,0:21:34.15,Default,,0,0,0,,Dan lagi, Idola Iblis misterius,\NIrumi, juga ikut serta!
Dialogue: 0,0:21:35.65,0:21:39.04,Default,,0,0,0,,- Semuanya imut, terutama Kuromu, ya!\N- Imut! Imut!
Dialogue: 0,0:21:39.04,0:21:41.15,Default,,0,0,0,,- Pak Gontetsu, tolong lebih serius lagi.\N- Imut! Imut!
Dialogue: 0,0:21:41.15,0:21:43.66,Default,,0,0,0,,Lihat ke sini, dong!
Dialogue: 0,0:21:43.66,0:21:47.70,Default,,0,0,0,,Tapi, semua anggotanya\Npendatang baru yang tak dikenal, ya.
Dialogue: 0,0:21:47.70,0:21:50.41,Default,,0,0,0,,Sepertinya ada pergantian anggota\Ndi menit-menit akhir.
Dialogue: 0,0:21:50.87,0:21:52.08,Default,,0,0,0,,Mengkhawatirkan, ya.
Dialogue: 0,0:21:52.08,0:21:54.92,Default,,0,0,0,,Devimuse dikenal tidak punya\Nbanyak anggota yang lincah.
Dialogue: 0,0:21:55.54,0:21:57.32,Default,,0,0,0,,Keserakahan melawan kesombongan.
Dialogue: 0,0:21:57.32,0:22:00.42,Default,,0,0,0,,Apakah hasil pertandingan ini sudah terlihat\Ndari perbedaan tim keduanya?
Dialogue: 0,0:22:00.42,0:22:05.64,Default,,0,0,0,,Yah, meski hasilnya mengecewakan\Nbagi anak-anak Devimuse,
Dialogue: 0,0:22:05.64,0:22:09.18,Default,,0,0,0,,aku harap mereka bisa menciptakan\Nkenangan yang indah.
Dialogue: 0,0:22:09.89,0:22:12.52,Default,,0,0,0,,Nah, ayo kita hajar mereka!
Dialogue: 0,0:22:18.57,0:22:20.86,Default,,0,0,0,,Ayo hajar dengan serangan berkilau kita!
Dialogue: 0,0:23:52.54,0:23:54.54,Default,,0,0,0,,Imut banget!
Dialogue: 0,0:23:54.54,0:23:56.08,Default,,0,0,0,,Tambahan!
Dialogue: 0,0:23:56.08,0:23:58.63,Default,,0,0,0,,Yak, latihannya dimulai!
Dialogue: 0,0:23:58.63,0:24:00.25,Default,,0,0,0,,Aku imut.
Dialogue: 0,0:24:00.25,0:24:02.05,Default,,0,0,0,,Aku imut banget.
Dialogue: 0,0:24:02.05,0:24:03.55,Default,,0,0,0,,- Aku imut.\N- Ekspresi kalian jadi bagus, tuh.
Dialogue: 0,0:24:03.55,0:24:04.67,Default,,0,0,0,,- Aku imut banget.\N- Ekspresi kalian jadi bagus, tuh.
Dialogue: 0,0:24:04.67,0:24:07.09,Default,,0,0,0,,- Pertama, kamu harus percaya kalau kamu imut!\N- Aku imut.
Dialogue: 0,0:24:07.09,0:24:08.51,Default,,0,0,0,,- Itu akan menumbuhkan rasa percaya diri!\N- Aku imut banget.
Dialogue: 0,0:24:08.51,0:24:09.55,Default,,0,0,0,,- Itu akan menumbuhkan rasa percaya diri!\N- Aku imut.
Dialogue: 0,0:24:09.55,0:24:19.31,Default,,0,0,0,,Aku imut.
Dialogue: 0,0:24:19.31,0:24:22.32,Default,,0,0,0,,Aku imut!
Dialogue: 0,0:24:22.32,0:24:24.90,Default,,0,0,0,,Aku semangat banget!
Dialogue: 0,0:24:24.90,0:24:29.28,Default,,0,0,0,,Di sini juga terlahir seorang idola\Ntanpa disadari siapa pun.
Dialogue: 0,0:24:30.32,0:24:33.24,Default,,0,0,0,,Nah, Turnamen Olahraga\NIdola Iblis telah dimulai.
Dialogue: 0,0:24:33.24,0:24:36.75,Default,,0,0,0,,Irumi, Lindy, Merie, ayo hajar\Ndengan serangan berkilau kita!
Dialogue: 0,0:24:36.75,0:24:40.29,Default,,0,0,0,,Aku, Kuromu, tidak mau kalah\Ndari Idola Iblis lainnya.
Dialogue: 0,0:24:40.29,0:24:43.00,Default,,0,0,0,,Tentu saja juga dari\NIdola Iblis rock, Gyari.
Dialogue: 0,0:24:43.00,0:24:44.63,Default,,0,0,0,,Selanjutnya, Selamat Datang\Ndi Sekolah Iblis, Iruma.
Dialogue: 0,0:24:44.63,0:24:46.05,Default,,0,0,0,,"Tim Devimuse".
Dialogue: 0,0:24:46.05,0:24:49.76,Default,,0,0,0,,Dengar, Gyari, aku akan menang\Ndengan tim luar biasa ini.
Dialogue: 0,0:24:49.76,0:24:51.30,Default,,0,0,0,,Aku tidak akan pensiun dari\Ndunia Idola Iblis!
Dialogue: 0,0:24:51.30,0:24:52.89,Default,,0,0,0,,Aku juga tidak akan\Nmenikah denganmu!
Dialogue: 0,0:24:52.89,0:24:55.01,Default,,0,0,0,,Keimutan akan mengalahkan segalanya!
