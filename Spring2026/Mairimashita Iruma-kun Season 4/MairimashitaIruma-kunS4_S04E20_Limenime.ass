Dialogue: 0,0:00:01.52,0:00:05.53,sign,,0000,0000,0000,,31 DESEMBER - PAGI
Dialogue: 0,0:01:16.43,0:01:23.73,sign,,0000,0000,0000,,WELCOME TO DEMON SCHOOL! IRUMA-KUN SEASON 4
Dialogue: 0,0:02:38.01,0:02:38.64,sign,,0000,0000,0000,,TIM DEVIMUSE
Dialogue: 0,0:05:56.63,0:05:59.09,sign,,0000,0000,0000,,HIDUP IRUMI
Dialogue: 0,0:06:21.69,0:06:25.16,sign,,0000,0000,0000,,KOTAN
Dialogue: 0,0:06:40.71,0:06:42.09,sign,,0000,0000,0000,,IRUMI IMUT BANGET
Dialogue: 0,0:06:42.09,0:06:43.47,sign,,0000,0000,0000,,DEVIMUSE
Dialogue: 0,0:06:44.84,0:06:46.34,sign,,0000,0000,0000,,IRUMI IMUT BANGET
Dialogue: 0,0:07:13.37,0:07:15.79,sign,,0000,0000,0000,,TURNAMEN OLAHRAGA IDOLA IBLIS
Dialogue: 0,0:11:17.07,0:11:19.99,sign,,0000,0000,0000,,PERTANDINGAN PERTAMA - LARI 66 METER
Dialogue: 0,0:13:39.17,0:13:41.72,sign,,0000,0000,0000,,A—
Dialogue: 0,0:14:22.63,0:14:24.16,sign,,0000,0000,0000,,KALAU JATUH, BELEPOTAN LUMPUR
Dialogue: 0,0:14:24.16,0:14:26.39,sign,,0000,0000,0000,,PERTANDINGAN PANJAT TEBING
Dialogue: 0,0:14:26.64,0:14:28.51,sign,,0000,0000,0000,,UJI KEKUATAN LENGAN
Dialogue: 0,0:14:28.51,0:14:30.14,sign,,0000,0000,0000,,PERTANDINGAN LEMPAR BOLA RAKSASA
Dialogue: 0,0:14:30.39,0:14:31.64,sign,,0000,0000,0000,,TANGKAP HAMA\NPERTANDINGAN BERBURU
Dialogue: 0,0:14:48.41,0:14:57.17,sign,,0000,0000,0000,,IRUMI IMUT BANGET
Dialogue: 0,0:15:31.95,0:15:33.83,sign,,0000,0000,0000,,SATU LAYAR!
Dialogue: 0,0:17:41.54,0:17:43.21,sign,,0000,0000,0000,,TARIK TAMBANG EKOR
Dialogue: 0,0:20:48.69,0:20:51.19,sign,,0000,0000,0000,,IRUMI IMUT BANGET - SUKA BANGET
Dialogue: 0,0:22:15.98,0:22:18.98,sign,,0000,0000,0000,,PERTANDINGAN JATUHKAN TARGET BERPUTAR
Dialogue: 0,0:23:49.87,0:23:53.16,sign,,0000,0000,0000,,TAMBAHAN
Dialogue: 0,0:24:17.85,0:24:21.19,sign,,0000,0000,0000,,TAMBAHAN
Dialogue: 0,0:24:29.99,0:24:31.00,sign,,0000,0000,0000,,CUPLIKAN
Dialogue: 0,0:00:05.53,0:00:09.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, kita tidak bisa menghabiskan waktu\Nbersama saat pergantian bulan.
Dialogue: 0,0:00:10.28,0:00:13.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.\NTemanmu juga dalam masalah, kan?
Dialogue: 0,0:00:13.79,0:00:15.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semangat, ya.
Dialogue: 0,0:00:15.25,0:00:16.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:00:16.20,0:00:18.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku pergi dulu!
Dialogue: 0,0:00:18.75,0:00:21.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat jalan!
Dialogue: 0,0:00:21.25,0:00:22.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat jalan.
Dialogue: 0,0:00:22.50,0:00:25.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, jangan tonton TV hari ini.
Dialogue: 0,0:00:25.26,0:00:27.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ya.\N- Ya.
Dialogue: 0,0:00:29.38,0:00:31.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya jangan, lo!
Dialogue: 0,0:00:31.14,0:00:34.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terutama saat sore,\Njangan nyalakan TV, ya!
Dialogue: 0,0:00:34.51,0:00:36.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ya.\N- Ya.
Dialogue: 0,0:00:37.02,0:00:39.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya jangan!\NJangan, lo!
Dialogue: 0,0:00:39.98,0:00:42.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya jangan!\NJangan! Jangan!
Dialogue: 0,0:00:43.94,0:00:47.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu-satunya manusia\Nyang tinggal di dunia para iblis.
Dialogue: 0,0:00:47.24,0:00:49.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suzuki Iruma, 15 tahun.
Dialogue: 0,0:00:49.82,0:00:53.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selagi Iruma menikmati\Nkehidupan sekolahnya di Babyls,
Dialogue: 0,0:00:53.74,0:00:56.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia punya ambisi,\Natau lebih tepatnya tujuan.
Dialogue: 0,0:00:56.99,0:01:00.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yakni menaikkan peringkatnya.
Dialogue: 0,0:01:00.12,0:01:06.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lantas, apakah yang menanti\Ndi akhir perjalanannya?
Dialogue: 0,0:02:38.64,0:02:40.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Tim Devimuse".
Dialogue: 0,0:02:47.02,0:02:48.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:02:50.82,0:02:52.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aroma apa ini?
Dialogue: 0,0:02:53.74,0:02:55.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Matca baru.
Dialogue: 0,0:02:55.91,0:02:58.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk meredakan kelelahan\Ndan membuat sayap hangat.
Dialogue: 0,0:02:58.74,0:03:01.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cocok untuk mengatasi kelelahan kerja.
Dialogue: 0,0:03:01.12,0:03:02.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nih, silakan.
Dialogue: 0,0:03:02.75,0:03:04.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada sake juga, lo.
Dialogue: 0,0:03:04.66,0:03:06.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ambil camilan dulu, ya.
Dialogue: 0,0:03:06.60,0:03:10.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita juga bekerja saat pergantian bulan,\Njadi kenapa tidak santai sebentar?
Dialogue: 0,0:03:10.25,0:03:12.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari bersantai dan nonton TV.
Dialogue: 0,0:03:14.63,0:03:16.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini masih jam kerja, lo.
Dialogue: 0,0:03:17.59,0:03:19.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kecilkan suaranya.
Dialogue: 0,0:03:19.68,0:03:23.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, di pertengahan,\Nganti acaranya ke Orkestra Iblis.
Dialogue: 0,0:03:23.56,0:03:24.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:03:24.85,0:03:28.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, sambil menunggu,\Naku putar Turnamen Olahraga Idola Iblis, ya.
Dialogue: 0,0:03:28.65,0:03:30.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Idola Iblis?
Dialogue: 0,0:03:30.23,0:03:32.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu suka tontonan seperti itu, ya?
Dialogue: 0,0:03:32.19,0:03:35.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Crocell akan tampil hari ini, kan?
Dialogue: 0,0:03:35.61,0:03:38.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika ini hari besar murid kita,\Nkita harus mendukungnya.
Dialogue: 0,0:03:40.45,0:03:42.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah mendaki gunung\Ndan meditasi di air terjun.
Dialogue: 0,0:03:42.79,0:03:45.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari bersantai selagi pergantian bulan.
Dialogue: 0,0:03:47.25,0:03:51.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski dilarang nonton TV saat sore...
Dialogue: 0,0:03:51.38,0:03:55.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iblis suka hal yang menarik, sih.
Dialogue: 0,0:03:58.89,0:04:01.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tim Devimuse!
Dialogue: 0,0:04:11.31,0:04:13.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ope-Opera, rekam!
Dialogue: 0,0:04:13.07,0:04:13.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah.
Dialogue: 0,0:04:13.94,0:04:16.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belikan TV yang lebih bagus!
Dialogue: 0,0:04:16.39,0:04:17.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:04:18.02,0:04:21.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, Idola Iblis Irumi,\Njuga ikut serta!
Dialogue: 0,0:04:22.62,0:04:24.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalego...
Dialogue: 0,0:04:24.12,0:04:24.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak kenal.
Dialogue: 0,0:04:24.79,0:04:27.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, dia rasanya...
Dialogue: 0,0:04:27.33,0:04:29.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya tidak kenal!
Dialogue: 0,0:04:29.50,0:04:31.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau terlibat hal merepotkan!
Dialogue: 0,0:04:31.71,0:04:33.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi ini sudah jelas, kan?
Dialogue: 0,0:04:33.84,0:04:36.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kita harus bagaimana?
Dialogue: 0,0:04:36.13,0:04:38.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ganti acaranya!
Dialogue: 0,0:04:38.72,0:04:40.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari dukung mereka!
Dialogue: 0,0:04:40.18,0:04:41.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:04:45.35,0:04:50.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, ayo hajar\Ndengan serangan berkilau kita!
Dialogue: 0,0:04:50.10,0:04:53.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biarkan aku pergi!
Dialogue: 0,0:04:53.11,0:04:58.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus bergegas ke tempat Tuan Iruma—\NMaksudku Nona Irumi!
Dialogue: 0,0:05:00.03,0:05:01.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak boleh.
Dialogue: 0,0:05:01.16,0:05:05.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal Nona Irumi sedang menanggung\Nrasa malu dan tampil di depan umum,
Dialogue: 0,0:05:05.91,0:05:08.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku malah tidak ada di sisinya!
Dialogue: 0,0:05:12.12,0:05:16.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu janji akan menghabiskan waktu denganku\Nsaat pergantian bulan, kan?
Dialogue: 0,0:05:16.13,0:05:18.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, Nona Irumi...
Dialogue: 0,0:05:18.09,0:05:19.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alice.
Dialogue: 0,0:05:20.47,0:05:25.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu ingkar janji,\NMama bakal marah, lo.
Dialogue: 0,0:05:32.10,0:05:36.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yo, Azz-Azz!\NAyo dukung Irumichi!
Dialogue: 0,0:05:36.11,0:05:38.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga bawa banyak\Nhidangan Tahun Baru!
Dialogue: 0,0:05:38.32,0:05:39.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hidangan Tahun Baru?
Dialogue: 0,0:05:40.11,0:05:41.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perlengkapan mendukung juga banyak!
Dialogue: 0,0:05:41.82,0:05:44.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Persiapannya sudah matang!\NKamu bakal ikut, kan?
Dialogue: 0,0:05:44.37,0:05:47.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, ada Dik Bayi, toh!
Dialogue: 0,0:05:47.95,0:05:48.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guru besar!
Dialogue: 0,0:05:48.87,0:05:50.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang!
Dialogue: 0,0:05:50.58,0:05:54.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, silakan masuk!\NMari kita dukung bersama!
Dialogue: 0,0:05:54.17,0:05:55.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bent— Ibu!
Dialogue: 0,0:05:55.54,0:05:56.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap!
Dialogue: 0,0:05:56.63,0:05:59.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jreng!
Dialogue: 0,0:05:59.63,0:06:01.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, imutnya!
Dialogue: 0,0:06:01.38,0:06:03.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini?
Dialogue: 0,0:06:03.13,0:06:05.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pakaian sorak yang hangat!
Dialogue: 0,0:06:05.55,0:06:07.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Pakaian sorak!\N- Kalau membicarakan Idola Iblis
Dialogue: 0,0:06:07.31,0:06:09.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}memang harus pakai pakaian sorak, ya.
Dialogue: 0,0:06:10.39,0:06:13.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah hidangan Tahun Baru\Ncocok dengan teh?
Dialogue: 0,0:06:13.89,0:06:16.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku! Aku punya saran!
Dialogue: 0,0:06:16.15,0:06:18.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ada hidangan Tahun Baru\Ndi pergantian bulan
Dialogue: 0,0:06:18.15,0:06:20.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}harus ada...
Dialogue: 0,0:06:21.69,0:06:25.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kotan...
Dialogue: 0,0:06:25.16,0:06:27.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini hebat, ya.
Dialogue: 0,0:06:27.16,0:06:31.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Panasnya sungguh pas!\NTidak kusangka ada benda seperti ini!
Dialogue: 0,0:06:31.16,0:06:33.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan ini, persiapan\Nuntuk mendukungnya sudah lengkap!
Dialogue: 0,0:06:33.79,0:06:36.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo lantangkan sorakan kita!
Dialogue: 0,0:06:36.17,0:06:38.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ya!\N- Ya!
Dialogue: 0,0:06:44.84,0:06:46.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hore!
Dialogue: 0,0:06:46.34,0:06:48.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hore! Hore! Hore!
Dialogue: 0,0:06:48.85,0:06:53.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Irumi! Hore! Hore!\NIrumi! Hore!
Dialogue: 0,0:06:54.35,0:06:58.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf membuat Anda menunggu.\NIni TV model terbaru dan terbaik.
Dialogue: 0,0:06:58.06,0:07:00.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, putar di situ juga.
Dialogue: 0,0:07:00.02,0:07:00.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:07:04.36,0:07:08.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya bermula\Nsaat beberapa hari yang lalu...
Dialogue: 0,0:07:09.16,0:07:13.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin kamu jadi relawan petugas\Nkeamanan di Turnamen Olahraga.
Dialogue: 0,0:07:13.37,0:07:15.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengalaman adalah guru terbaik.
Dialogue: 0,0:07:15.79,0:07:18.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada yang bisa menandingi\Npengalaman langsung terjun ke lapangan.
Dialogue: 0,0:07:19.17,0:07:22.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu masih terlalu awal\Nuntuk menghadiri Deviculum.
Dialogue: 0,0:07:22.34,0:07:24.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau di lapangan, Iru—
Dialogue: 0,0:07:24.17,0:07:27.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak akan ada gangguan dari iblis lain.
Dialogue: 0,0:07:27.34,0:07:29.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pergilah dan penuhi tugasmu!
Dialogue: 0,0:07:29.76,0:07:30.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:07:33.85,0:07:36.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memenuhi tugasku.
Dialogue: 0,0:07:36.10,0:07:40.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, sebagai relawan, aku...
Dialogue: 0,0:07:42.86,0:07:45.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senam Idola Iblis pertama dimulai.
Dialogue: 0,0:07:45.82,0:07:49.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Angkat kedua tangan tinggi-tinggi\Ndan tunjukkan pose gemilang!
Dialogue: 0,0:07:49.78,0:07:52.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ngapain, sih?
Dialogue: 0,0:07:53.70,0:07:55.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Devi!
Dialogue: 0,0:07:56.66,0:07:58.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya ini?
Dialogue: 0,0:07:58.58,0:08:01.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian tiba-tiba memaksaku menari\Ndengan kostum begini!
Dialogue: 0,0:08:01.84,0:08:03.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat jelaskan!
Dialogue: 0,0:08:03.34,0:08:06.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kamu berpose dengan baik.
Dialogue: 0,0:08:06.22,0:08:08.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketua memang hebat!\NBisa baca situasi!
Dialogue: 0,0:08:08.84,0:08:11.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Ameri, anu...
Dialogue: 0,0:08:11.18,0:08:12.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang akan jelaskan.
Dialogue: 0,0:08:12.85,0:08:14.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuromu?
Dialogue: 0,0:08:14.22,0:08:18.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini hal yang penting,\Njadi tolong didengarkan, Kak Ameri.
Dialogue: 0,0:08:20.60,0:08:24.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo! Aku Idola Iblis yang terkenal, Kuromu!
Dialogue: 0,0:08:24.28,0:08:28.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, identitas asliku adalah\NCrocell Kerori dari kelas abnormal!
Dialogue: 0,0:08:28.82,0:08:30.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa katamu?
Dialogue: 0,0:08:30.11,0:08:34.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang ingin berkilau\Ndi Turnamen Olahraga Idola Iblis
Dialogue: 0,0:08:34.70,0:08:38.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mengajak Irumi, Lindy, dan Merun\Nuntuk ikut berpartisipasi!
Dialogue: 0,0:08:39.12,0:08:42.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kami menerima gangguan\Ndari Gyari sang Idola Iblis Rock
Dialogue: 0,0:08:42.50,0:08:45.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan kehilangan satu anggota kami!\NKami pun dalam masalah!
Dialogue: 0,0:08:45.05,0:08:48.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begini, kami tidak bisa tampil\Ndi Turnamen Olahraga!
Dialogue: 0,0:08:49.30,0:08:53.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di saat itu, sang penyelamat muncul!\NDialah Ketua Ameri!
Dialogue: 0,0:08:53.47,0:08:58.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita berempat pun berkumpul\Ndan menyatukan kekuatan...
Dialogue: 0,0:08:58.98,0:09:00.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari berkilau!
Dialogue: 0,0:09:00.94,0:09:02.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan malah teriak "Berkilau!"
Dialogue: 0,0:09:02.77,0:09:06.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sketsa pendek apa itu tadi?\NYah, itu mudah dimengerti, sih!
Dialogue: 0,0:09:06.44,0:09:10.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu perkenalan.\NSemua Idola Iblis bisa melakukannya.
Dialogue: 0,0:09:10.24,0:09:11.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu kemampuan dasar.
Dialogue: 0,0:09:11.32,0:09:12.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya?
Dialogue: 0,0:09:12.82,0:09:16.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya, kami butuh bantuanmu!
Dialogue: 0,0:09:16.70,0:09:18.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami mohon, Penyelamat!
Dialogue: 0,0:09:18.58,0:09:22.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ta-Tapi, kali ini,\Naku datang sebagai relawan...
Dialogue: 0,0:09:22.96,0:09:24.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini juga dihitung sebagai relawan!
Dialogue: 0,0:09:24.42,0:09:26.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan hubungi pihak keamanan!
Dialogue: 0,0:09:26.71,0:09:30.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku pemula yang tidak punya\Npengetahuan tentang Idola Iblis.
Dialogue: 0,0:09:30.17,0:09:31.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami akan ajari sekuat tenaga!
Dialogue: 0,0:09:31.76,0:09:33.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami siap mendukungmu!
Dialogue: 0,0:09:33.47,0:09:36.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, pakaian ini memalukan!
Dialogue: 0,0:09:36.22,0:09:38.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami lebih malu lagi!
Dialogue: 0,0:09:38.22,0:09:38.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf!
Dialogue: 0,0:09:38.97,0:09:42.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kalian cocok pakai itu,\Nsedangkan aku...
Dialogue: 0,0:09:42.94,0:09:43.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja.
Dialogue: 0,0:09:43.98,0:09:47.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya Kak Ameri imut banget!
Dialogue: 0,0:09:50.49,0:09:53.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iruma bilang aku imut...
Dialogue: 0,0:09:56.83,0:09:58.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mohon.
Dialogue: 0,0:09:58.33,0:10:01.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pinjamkan aku kekuatanmu, Kak Ameri.
Dialogue: 0,0:10:05.42,0:10:08.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat ingin memenangkan
Dialogue: 0,0:10:09.21,0:10:10.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Turnamen Olahraga ini.
Dialogue: 0,0:10:11.92,0:10:14.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalah dalam belajar itu bukan masalah.
Dialogue: 0,0:10:14.68,0:10:16.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalah dalam urusan sihir pun tidak apa.
Dialogue: 0,0:10:17.30,0:10:18.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:10:19.77,0:10:24.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau soal menjadi Idola Iblis,\Naku tidak ingin kalah!
Dialogue: 0,0:10:24.52,0:10:30.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah harga diri Idola Iblis imut terkuat\Nyang tak terkalahkan, Kuromu!
Dialogue: 0,0:10:34.20,0:10:36.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku mohon\Npinjamkan aku kekuatanmu!
Dialogue: 0,0:10:36.62,0:10:37.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cukup.
Dialogue: 0,0:10:39.29,0:10:40.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau diingat kembali...
Dialogue: 0,0:10:40.49,0:10:45.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berutang budi karena lagu-lagu Kuromu\Ntelah memberiku semangat.
Dialogue: 0,0:10:46.17,0:10:48.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika ada murid yang mengejar ambisinya,
Dialogue: 0,0:10:49.30,0:10:51.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan kubantu sekuat tenaga.
Dialogue: 0,0:10:53.80,0:10:58.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena aku adalah Ketua OSIS Babyls.
Dialogue: 0,0:11:00.31,0:11:01.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Ameri!
Dialogue: 0,0:11:02.31,0:11:04.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan saja padaku!
Dialogue: 0,0:11:06.06,0:11:08.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bilang begitu, sih.
Dialogue: 0,0:11:08.56,0:11:11.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pakaian minim macam apa ini?
Dialogue: 0,0:11:12.57,0:11:17.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertandingan pertama dari Turnamen\NOlahraga Idola Iblis akan dimulai!
Dialogue: 0,0:11:28.04,0:11:32.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, akhirnya dimulai juga!\NPertandingan pertama, lari 66 meter!
Dialogue: 0,0:11:32.96,0:11:37.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di blok A, tentu saja Karam\Ndari Tim Karam jadi pusat perhatian!
Dialogue: 0,0:11:37.84,0:11:41.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akankah Trind dari Tim Saja\Njadi pesaing tak terduga?
Dialogue: 0,0:11:42.35,0:11:45.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Ame— Merie, semangat!
Dialogue: 0,0:11:45.52,0:11:47.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalahkan mereka!
Dialogue: 0,0:11:47.60,0:11:48.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iruma...
Dialogue: 0,0:11:49.48,0:11:51.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Irumi!
Dialogue: 0,0:11:51.69,0:11:54.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sosoknya yang jadi\Npendukung pun berkilauan!
Dialogue: 0,0:11:54.65,0:11:56.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Irumichi kelihatan senang!
Dialogue: 0,0:11:56.57,0:12:00.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, imutnya!\NJadi ingin kulahap.
Dialogue: 0,0:12:00.37,0:12:01.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan!
Dialogue: 0,0:12:04.41,0:12:06.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tinggi sekali, ya!
Dialogue: 0,0:12:07.58,0:12:11.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enaknya.\NBerdiri saja sudah mencolok.
Dialogue: 0,0:12:11.84,0:12:13.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Aku pendek, sih, jadi iri banget.\N- Begitu, ya?
Dialogue: 0,0:12:13.00,0:12:15.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Aku pendek, sih, jadi iri banget.\N- A-Aku diputari...
Dialogue: 0,0:12:15.05,0:12:18.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Idola Iblis memang harus mencolok, kan?
Dialogue: 0,0:12:18.43,0:12:21.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nilai hiburan juga sangat penting, sih.
Dialogue: 0,0:12:21.43,0:12:24.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Se-Sekadar lari saja tidak cukup, ya?
Dialogue: 0,0:12:24.60,0:12:27.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jelas, dong!\NKita kan Idola Iblis!
Dialogue: 0,0:12:28.23,0:12:32.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya, larilah dengan imut!\NJangan lupa berpose juga saat lari!
Dialogue: 0,0:12:32.15,0:12:34.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be-Begitu, toh.
Dialogue: 0,0:12:34.23,0:12:37.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pemula, kan?\NKamu cukup melakukan itu saja!
Dialogue: 0,0:12:37.99,0:12:42.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, kita tidak berlari serius\Ndi pertandingan ini.
Dialogue: 0,0:12:43.70,0:12:46.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku pura-pura jatuh\Ndi tengah jalan, ya?
Dialogue: 0,0:12:46.37,0:12:48.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lari pelan-pelan itu sulit, ya.
Dialogue: 0,0:12:49.54,0:12:52.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi ini pertandingan, kan?\NApa boleh begitu?
Dialogue: 0,0:12:52.96,0:12:54.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya...
Dialogue: 0,0:12:54.21,0:12:57.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak mau wajahku jadi aneh\Nkarena berlari serius.
Dialogue: 0,0:12:57.72,0:12:59.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu ingin terlihat imut, kan?
Dialogue: 0,0:12:59.93,0:13:02.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau lari serius malah tidak berdampak.
Dialogue: 0,0:13:02.97,0:13:06.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malu kalau sampai kalah\Nkarena lari serius, ya.
Dialogue: 0,0:13:06.06,0:13:08.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesaat lagi, pertandingannya akan dimulai!
Dialogue: 0,0:13:09.81,0:13:12.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peserta blok A harap berbaris!
Dialogue: 0,0:13:12.98,0:13:14.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ya!\N- Ya!
Dialogue: 0,0:13:14.94,0:13:16.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:13:16.32,0:13:18.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu juga salah satu strategi.
Dialogue: 0,0:13:19.49,0:13:21.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersiap di tempat.
Dialogue: 0,0:13:21.49,0:13:22.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:13:23.12,0:13:27.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak berpikir iblis yang serius\Nitu memalukan.
Dialogue: 0,0:13:29.29,0:13:31.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siaga.
Dialogue: 0,0:13:42.76,0:13:45.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:13:46.18,0:13:49.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menang telak! Menang telak!
Dialogue: 0,0:13:49.27,0:13:52.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat sekali! Secepat kilat!
Dialogue: 0,0:13:52.77,0:13:55.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelari lain tidak bisa melanjutkan?
Dialogue: 0,0:13:55.77,0:13:59.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sosok yang tiba-tiba muncul,\Neng, dia...
Dialogue: 0,0:13:59.69,0:14:04.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yap, seperti kata mereka,\Naku mencoba berlari dengan berpose imut.
Dialogue: 0,0:14:06.08,0:14:08.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, sepertinya aku terlalu imut.
Dialogue: 0,0:14:12.25,0:14:15.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Ame— Merie! Kamu hebat!
Dialogue: 0,0:14:15.50,0:14:17.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keren banget!
Dialogue: 0,0:14:17.71,0:14:21.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti lancar!\NDengan potensi tersembunyi Kak Ameri!
Dialogue: 0,0:14:22.63,0:14:24.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau jatuh, belepotan lumpur!
Dialogue: 0,0:14:24.16,0:14:26.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertandingan panjat tebing!
Dialogue: 0,0:14:26.64,0:14:28.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Uji kekuatan lengan!
Dialogue: 0,0:14:28.51,0:14:30.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertandingan lempar bola raksasa!
Dialogue: 0,0:14:31.64,0:14:34.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuat! Kuat! Kuat\NKuat sekali!
Dialogue: 0,0:14:34.56,0:14:38.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa sebenarnya Merie?
Dialogue: 0,0:14:39.65,0:14:41.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu Ketua OSIS, ya.
Dialogue: 0,0:14:41.28,0:14:43.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makka curang!
Dialogue: 0,0:14:43.65,0:14:46.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pencapaian yang luar biasa, ya.
Dialogue: 0,0:14:48.41,0:14:50.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Idola Iblis biasa
Dialogue: 0,0:14:50.49,0:14:53.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bukan tandingan ketua OSIS kita!
Dialogue: 0,0:14:53.96,0:14:57.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, sepertinya dia sudah berlatih keras.
Dialogue: 0,0:14:57.17,0:14:58.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia kuat banget!
Dialogue: 0,0:14:58.79,0:14:59.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cantik!
Dialogue: 0,0:14:59.67,0:15:01.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia dari agensi mana?
Dialogue: 0,0:15:01.13,0:15:04.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Devimuse? Serius?\N- Merie menyapu bersih semua posisi teratas!
Dialogue: 0,0:15:04.97,0:15:09.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihatlah bangku pemain Devimuse!\NMereka tampak sangat bangga!
Dialogue: 0,0:15:09.18,0:15:11.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana, Pak Gontetsu?
Dialogue: 0,0:15:11.47,0:15:12.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suka.
Dialogue: 0,0:15:12.39,0:15:13.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya dia menyukainya!
Dialogue: 0,0:15:13.93,0:15:17.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Devimuse telah mencuri perhatian!
Dialogue: 0,0:15:20.94,0:15:23.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tahun ini juga meriah, ya.
Dialogue: 0,0:15:23.99,0:15:27.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski cuma relawan, kalau ter—
Dialogue: 0,0:15:27.07,0:15:29.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, itu tidak mungkin.
Dialogue: 0,0:15:31.95,0:15:33.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu layar?
Dialogue: 0,0:15:39.75,0:15:42.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Merie, terima kasih\Natas kerja kerasnya!
Dialogue: 0,0:15:42.30,0:15:45.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu hebat sekali!\NSungguh luar biasa!
Dialogue: 0,0:15:45.17,0:15:49.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang pantas Kuromu\Nmenyebutmu penyelamat!
Dialogue: 0,0:15:49.30,0:15:52.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para penonton sampai terkejut, lo!
Dialogue: 0,0:15:52.22,0:15:57.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya?\NAku berjuang agar tetap imut, tapi...
Dialogue: 0,0:15:57.19,0:15:58.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Imut?
Dialogue: 0,0:15:58.56,0:16:00.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya! Imut banget!
Dialogue: 0,0:16:00.77,0:16:04.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak salah lagi,\NKak Ameri yang paling berkilau!
Dialogue: 0,0:16:06.32,0:16:08.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu imut, ya.
Dialogue: 0,0:16:09.87,0:16:13.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, tidak kusangka\Nbisa sampai selancar ini.
Dialogue: 0,0:16:13.79,0:16:15.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh? Kamu cemas?
Dialogue: 0,0:16:15.54,0:16:17.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, aku akan berjuang.
Dialogue: 0,0:16:17.21,0:16:18.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau kugantikan?
Dialogue: 0,0:16:18.96,0:16:19.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau aku?
Dialogue: 0,0:16:20.42,0:16:22.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja.
Dialogue: 0,0:16:22.09,0:16:24.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tidak bisa sepenuhnya\Nbergantung pada Ketua.
Dialogue: 0,0:16:24.92,0:16:27.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuromu juga harus tampil maksimal\Ndi paruh kedua.
Dialogue: 0,0:16:27.88,0:16:30.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga bagian dari Tim Devimuse.
Dialogue: 0,0:16:30.64,0:16:35.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agar Kuromu bisa berkilau,\Npasti akan kumenangkan.
Dialogue: 0,0:16:35.77,0:16:37.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong dukungannya!
Dialogue: 0,0:16:37.85,0:16:38.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:16:42.19,0:16:43.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lied.
Dialogue: 0,0:16:45.86,0:16:49.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih\Nsudah mau ikut sampai sejauh ini.
Dialogue: 0,0:16:49.36,0:16:51.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benar-benar bersyukur.
Dialogue: 0,0:16:51.74,0:16:52.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi...
Dialogue: 0,0:16:53.41,0:16:54.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih!
Dialogue: 0,0:16:56.54,0:16:59.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa tiba-tiba jadi formal begitu?
Dialogue: 0,0:16:59.54,0:17:03.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan, kamu merasa sedikit bersalah?
Dialogue: 0,0:17:04.17,0:17:06.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja.
Dialogue: 0,0:17:06.05,0:17:12.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah tahu kalau terlibat denganmu\Npasti akan menyenangkan.
Dialogue: 0,0:17:14.05,0:17:20.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan berjuang\Ndemi adikku yang imut, Irumi!
Dialogue: 0,0:17:20.56,0:17:22.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lied...
Dialogue: 0,0:17:23.56,0:17:27.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak butuh ucapan terima kasih, Iruma.
Dialogue: 0,0:17:27.31,0:17:31.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru aku yang harus\Nberterima kasih padamu.
Dialogue: 0,0:17:31.24,0:17:32.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya...
Dialogue: 0,0:17:33.03,0:17:35.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, pertandingan selanjutnya...
Dialogue: 0,0:17:35.83,0:17:37.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Favorit para fans!
Dialogue: 0,0:17:37.54,0:17:41.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inilah "Tarik tambang ekor"\Nyang dipenuhi dorong, tarik, dan lilit!
Dialogue: 0,0:17:48.09,0:17:49.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih belum!
Dialogue: 0,0:17:53.09,0:17:57.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang bisa hidup!
Dialogue: 0,0:17:57.85,0:18:00.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, ya!\NSoalnya ini pertandingan!
Dialogue: 0,0:18:00.64,0:18:04.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak!\NMohon bantuannya!
Dialogue: 0,0:18:07.15,0:18:09.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, Dik pemula.
Dialogue: 0,0:18:10.28,0:18:11.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu imut, ya.
Dialogue: 0,0:18:11.65,0:18:15.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kalau sudah tanding,\Nakan kuserang tanpa ampun.
Dialogue: 0,0:18:15.87,0:18:17.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lanjutkan!
Dialogue: 0,0:18:17.37,0:18:18.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:18:18.24,0:18:21.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, aku tiba-tiba bersemangat!
Dialogue: 0,0:18:21.12,0:18:25.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah kenapa Lindy dari Devimuse\Ntersenyum sendiri!
Dialogue: 0,0:18:25.21,0:18:29.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah kenapa aku merasa\Nakan akrab dengannya.
Dialogue: 0,0:18:30.26,0:18:34.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, lawannya di babak pertama\Nsangat tangguh, lo!
Dialogue: 0,0:18:34.09,0:18:38.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gerakan ekornya yang lihai\Nmampu membuat lawannya tersiksa!
Dialogue: 0,0:18:39.06,0:18:40.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tersiksa?
Dialogue: 0,0:18:41.56,0:18:44.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan senyumannya yang mematikan!
Dialogue: 0,0:18:44.48,0:18:46.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Beeber!\N- Beeber!
Dialogue: 0,0:18:46.56,0:18:48.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Bee sungguh tampan!
Dialogue: 0,0:18:48.90,0:18:50.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sangat menyilaukan!
Dialogue: 0,0:18:50.69,0:18:53.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakinya panjang banget!
Dialogue: 0,0:18:53.15,0:18:55.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Pangeran gemilang memang beda!\N- Sedikit saja!
Dialogue: 0,0:18:55.16,0:18:56.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Senyumnya menyilaukan!\N- Sedikit saja!
Dialogue: 0,0:18:56.74,0:18:57.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kakinya panjang, ya!\N- Ya!
Dialogue: 0,0:18:57.91,0:18:59.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beeber!
Dialogue: 0,0:19:02.91,0:19:06.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senyumnya itu yang membuat\Nlawannya terpesona dan kalah!
Dialogue: 0,0:19:06.92,0:19:08.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlalu pendek, ya.
Dialogue: 0,0:19:08.42,0:19:12.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pak Gontetsu, aku tahu Anda tidak tertarik,\Ntapi tolong komentarnya!
Dialogue: 0,0:19:12.84,0:19:15.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yo! Kamu lawanku, ya, Dik Iblis!
Dialogue: 0,0:19:15.93,0:19:18.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari bertanding dengan sportif!
Dialogue: 0,0:19:19.93,0:19:23.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, meski ekor kita bersentuhan,
Dialogue: 0,0:19:23.31,0:19:28.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jangan jatuh hati padaku!
Dialogue: 0,0:19:28.31,0:19:31.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Aku tidak butuh perhatianmu!\N- Beeber!
Dialogue: 0,0:19:36.86,0:19:39.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di-Dikalahkan dalam sekejap!
Dialogue: 0,0:19:39.91,0:19:43.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi-lagi Tim Devimuse\Nmenang dengan gemilang!
Dialogue: 0,0:19:44.79,0:19:48.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di babak kedua, Lindy akan melawan\NReijin yang juga dari Tim Beeber!
Dialogue: 0,0:19:48.79,0:19:50.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan balaskan dendammu.
Dialogue: 0,0:19:50.42,0:19:54.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oi! Tabel pertandingannya aneh, nih!\NDi mana ceweknya?
Dialogue: 0,0:19:57.38,0:19:59.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}He-Hei...
Dialogue: 0,0:19:59.93,0:20:03.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan,\Nsemua anggota timnya Iruma...
Dialogue: 0,0:20:04.89,0:20:06.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan minum.
Dialogue: 0,0:20:06.02,0:20:08.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu berusaha menghapus ingatanmu?
Dialogue: 0,0:20:11.02,0:20:12.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ekornya kuat banget!
Dialogue: 0,0:20:13.44,0:20:16.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah dia juga teman sekelas kalian?
Dialogue: 0,0:20:16.11,0:20:19.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak kenal, tapi akan kubakar dia\Nkalau ketemu lain waktu.
Dialogue: 0,0:20:19.57,0:20:20.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal tidak kenal?
Dialogue: 0,0:20:20.62,0:20:23.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lindy juga luar biasa!
Dialogue: 0,0:20:23.29,0:20:25.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia menang dengan mencolok, ya.
Dialogue: 0,0:20:25.33,0:20:27.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak ada pilihan selain ikut mencolok!
Dialogue: 0,0:20:28.21,0:20:29.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami mengandalkanmu.
Dialogue: 0,0:20:34.63,0:20:40.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertandingan selanjutnya yang berlangsung\Nbersamaan dengan tarik tambang ekor...
Dialogue: 0,0:20:40.18,0:20:43.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimanapun caranya,\Nkamu menang kalau mengenai target!
Dialogue: 0,0:20:43.01,0:20:45.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertandingan jatuhkan target berputar!
Dialogue: 0,0:20:48.69,0:20:51.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Imut banget!
Dialogue: 0,0:20:51.19,0:20:54.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Irumi!
Dialogue: 0,0:20:54.15,0:20:55.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yo! Terbaik sedunia iblis!
Dialogue: 0,0:20:59.65,0:21:03.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalego, itu Iruma!\NPertandingan jatuhkan target berputar, tuh!
Dialogue: 0,0:21:03.66,0:21:04.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bodo amat!
Dialogue: 0,0:21:04.58,0:21:07.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, bukan Iruma, tapi Irumi, ya.
Dialogue: 0,0:21:07.29,0:21:08.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terserah mau yang mana!
Dialogue: 0,0:21:08.91,0:21:13.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hidangan Tahun Baru! Dibagi-bagi!
Dialogue: 0,0:21:13.04,0:21:15.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Irumichi muncul! Irumichi muncul!
Dialogue: 0,0:21:15.88,0:21:18.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh sosok yang berani!
Dialogue: 0,0:21:18.55,0:21:19.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Kamera!
Dialogue: 0,0:21:19.38,0:21:22.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tampilkan Tuan Iruma saja!\N- Meriah sekali, ya.
Dialogue: 0,0:21:22.84,0:21:25.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga senang!
Dialogue: 0,0:21:25.56,0:21:30.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang karena bisa melihat\Nberbagai macam ekspresi Alice!
Dialogue: 0,0:21:30.14,0:21:34.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, Anda harus berterima kasih\Npada kedua temannya, ya.
Dialogue: 0,0:21:34.02,0:21:35.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:21:41.95,0:21:44.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan berpaling, Chima.
Dialogue: 0,0:21:45.91,0:21:50.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua yang ada di sini akan terpukau,\Njadi perhatikan baik-baik.
Dialogue: 0,0:21:50.71,0:21:52.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia...
Dialogue: 0,0:21:52.54,0:21:56.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau berharap tinggi padanya,\Npasti akan dibalas setimpal!
Dialogue: 0,0:22:03.39,0:22:05.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, Bang Ali.
Dialogue: 0,0:22:13.48,0:22:15.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktunya kita tampil!
Dialogue: 0,0:23:49.87,0:23:53.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tambahan!
Dialogue: 0,0:23:57.25,0:23:59.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Apa? Aku sedang sibuk—\N- Sobat!
Dialogue: 0,0:23:59.45,0:24:02.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, ada hal hebat terjadi\Ndi Turnamen Olahraga Idola Iblis!
Dialogue: 0,0:24:02.50,0:24:05.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar aku ini!\NKenapa aku menelponnya?
Dialogue: 0,0:24:05.51,0:24:08.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin Sobat\Ntertarik pada Idola Iblis!
Dialogue: 0,0:24:08.72,0:24:10.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal Irumi, kan!
Dialogue: 0,0:24:10.47,0:24:12.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Juga soal Merie!
Dialogue: 0,0:24:12.47,0:24:14.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Keduanya melo banget\N- Sobat memang hebat.
Dialogue: 0,0:24:14.10,0:24:17.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- sampai aku langsung jadi fans!\N- Sobat memang hebat.
Dialogue: 0,0:24:17.85,0:24:21.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekali lagi!
Dialogue: 0,0:24:21.19,0:24:23.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertandingan makan manju!
Dialogue: 0,0:24:23.27,0:24:26.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eits! Irumi, jangan makan\Nbagian peserta lain!
Dialogue: 0,0:24:26.86,0:24:28.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diskualifikasi!
Dialogue: 0,0:24:29.99,0:24:31.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Eiko.
Dialogue: 0,0:24:31.00,0:24:34.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini, hatiku tak berhenti berdebar\Nmelihat Irumi dan Merie.
Dialogue: 0,0:24:34.87,0:24:38.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tengah merekam Turnamen Olahraga\Ndan memotret layar TV.
Dialogue: 0,0:24:38.75,0:24:42.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begini, aku mungkin bakal buat\Nbuku kenangan Irumi dan Merie.
Dialogue: 0,0:24:42.25,0:24:45.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terjerumus.\NInikah yang disebut terjerumus.
Dialogue: 0,0:24:45.00,0:24:47.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya, "Eiko yang Tenggelam".
Dialogue: 0,0:24:47.17,0:24:49.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudku, Selamat Datang\Ndi Sekolah Iblis, Iruma.
Dialogue: 0,0:24:49.38,0:24:50.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Miliarder dan Permata".
Dialogue: 0,0:24:50.64,0:24:53.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Kalau akan tenggelam,\Naku ingin terjerumus ke rawa tak berujung."
Dialogue: 0,0:24:53.97,0:24:55.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Puisi buatan Eiko.
