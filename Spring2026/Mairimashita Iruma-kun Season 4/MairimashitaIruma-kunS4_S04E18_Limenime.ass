Dialogue: 0,0:00:08.95,0:00:16.25,sign,,0000,0000,0000,,WELCOME TO DEMON SCHOOL! IRUMA-KUN SEASON 4
Dialogue: 0,0:01:29.99,0:01:30.53,sign,,0000,0000,0000,,BEKAL UNTUK GENERASI MUDA
Dialogue: 0,0:01:34.49,0:01:38.49,sign,,0000,0000,0000,,MENARA BABEL
Dialogue: 0,0:01:58.14,0:02:00.48,sign,,0000,0000,0000,,AKADEMI LAUT IBLIS - LEVIALON
Dialogue: 0,0:02:00.48,0:02:03.39,sign,,0000,0000,0000,,LEVIATHAN LEIJI
Dialogue: 0,0:02:04.35,0:02:06.73,sign,,0000,0000,0000,,INSTITUT PENGUASA TANAH - JACKAPO
Dialogue: 0,0:02:06.73,0:02:10.19,sign,,0000,0000,0000,,BELIAL BERRY RAZBERRY
Dialogue: 0,0:02:11.24,0:02:13.57,sign,,0000,0000,0000,,SEKOLAH IBLIS - BABYLS
Dialogue: 0,0:02:13.57,0:02:15.45,sign,,0000,0000,0000,,IRUMA
Dialogue: 0,0:07:05.70,0:07:07.24,sign,,0000,0000,0000,,DIBANTU!
Dialogue: 0,0:13:11.44,0:13:14.19,sign,,0000,0000,0000,,MAKAN MALAM - PERTEMUAN
Dialogue: 0,0:14:29.72,0:14:30.47,sign,,0000,0000,0000,,DI BAWAH SINAR MATAHARI
Dialogue: 0,0:14:52.79,0:14:54.12,sign,,0000,0000,0000,,SOAL KANDIDAT RAJA IBLIS
Dialogue: 0,0:14:54.12,0:14:55.92,sign,,0000,0000,0000,,BERIKUTNYA ITU RAHASIA, LO!
Dialogue: 0,0:17:04.96,0:17:06.30,sign,,0000,0000,0000,,KAKAK KELAS
Dialogue: 0,0:17:21.23,0:17:23.94,sign,,0000,0000,0000,,KAKAK KELAS
Dialogue: 0,0:17:28.06,0:17:31.53,sign,,0000,0000,0000,,KAKAK KELAS
Dialogue: 0,0:17:41.12,0:17:43.33,sign,,0000,0000,0000,,KAKAK KELAS
Dialogue: 0,0:18:13.36,0:18:13.75,sign,,0000,0000,0000,,KAKAK KELAS
Dialogue: 0,0:18:45.35,0:18:48.27,sign,,0000,0000,0000,,ABERUHAUKE
Dialogue: 0,0:19:19.64,0:19:21.97,sign,,0000,0000,0000,,PERTEMUAN AWAL DENGAN MEREKA BERDUA
Dialogue: 0,0:19:37.03,0:19:39.66,sign,,0000,0000,0000,,AJARI KAMI, KAK CLARA!
Dialogue: 0,0:19:40.45,0:19:41.08,sign,,0000,0000,0000,,KAKAK KELAS!
Dialogue: 0,0:19:45.96,0:19:48.29,sign,,0000,0000,0000,,AJARI KAMI, KAK CLARA!
Dialogue: 0,0:19:48.29,0:19:49.92,sign,,0000,0000,0000,,ADIK KELAS
Dialogue: 0,0:19:50.79,0:19:53.05,sign,,0000,0000,0000,,KAKAK KELAS!
Dialogue: 0,0:20:03.56,0:20:07.60,sign,,0000,0000,0000,,ADIK KELAS
Dialogue: 0,0:20:22.58,0:20:25.91,sign,,0000,0000,0000,,KAKAK KELAS!
Dialogue: 0,0:20:40.72,0:20:41.85,sign,,0000,0000,0000,,BERWIBAWA
Dialogue: 0,0:20:58.28,0:20:58.99,sign,,0000,0000,0000,,GAYA KETUA GENG BANGSAWAN YANG BERWIBAWA
Dialogue: 0,0:24:08.05,0:24:09.01,sign,,0000,0000,0000,,TAMBAHAN
Dialogue: 0,0:24:14.72,0:24:17.10,sign,,0000,0000,0000,,KERAKUSAN
Dialogue: 0,0:24:19.35,0:24:21.73,sign,,0000,0000,0000,,MAKAN BESAR
Dialogue: 0,0:24:24.73,0:24:26.15,sign,,0000,0000,0000,,MAKAN SEDIKIT
Dialogue: 0,0:24:29.99,0:24:30.99,sign,,0000,0000,0000,,CUPLIKAN
Dialogue: 0,0:01:30.53,0:01:33.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Bekal untuk Generasi Muda".
Dialogue: 0,0:01:48.42,0:01:52.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang,\Nanak-anak calon raja iblis.
Dialogue: 0,0:01:58.14,0:02:00.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Murid kelas 2 Akademi Laut Iblis Levialon,
Dialogue: 0,0:02:00.48,0:02:03.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}peringkat Vav, Leviathan Leiji.
Dialogue: 0,0:02:04.35,0:02:06.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Murid kelas 1 Institut Penguasa Tanah Jackapo,
Dialogue: 0,0:02:06.73,0:02:10.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}peringkat He, Belial Berry Razberry.
Dialogue: 0,0:02:11.24,0:02:13.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Murid kelas 1 Sekolah Iblis Babyls,
Dialogue: 0,0:02:13.57,0:02:15.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}peringkat He, Iruma.
Dialogue: 0,0:02:15.87,0:02:21.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh kehormatan besar\Nbisa bertemu dengan 13 Mahkota.
Dialogue: 0,0:02:22.41,0:02:24.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu basa-basi.
Dialogue: 0,0:02:24.42,0:02:28.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami hanya ingin menanyakan\Nsatu hal pada kalian.
Dialogue: 0,0:02:28.88,0:02:31.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kalian menjadi Raja Iblis,
Dialogue: 0,0:02:31.88,0:02:35.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}seperti apa cara kalian\Nmemerintah dunia iblis?
Dialogue: 0,0:02:36.72,0:02:41.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan membuat aturanku sendiri\Ndan memaksa seluruh iblis mematuhinya.
Dialogue: 0,0:02:41.85,0:02:46.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dunia iblis yang "teratur dan bebas".
Dialogue: 0,0:02:50.73,0:02:53.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia langsung angkat tangan\Ndan memberi jawaban singkat dan jelas.
Dialogue: 0,0:02:53.57,0:02:54.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia genius?
Dialogue: 0,0:02:54.65,0:02:56.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cucuku memang juara!
Dialogue: 0,0:02:56.57,0:03:00.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Levi, mohon jangan\Nambil foto selama wawancara.
Dialogue: 0,0:03:01.87,0:03:03.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana denganmu?
Dialogue: 0,0:03:03.29,0:03:04.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya! Aku...
Dialogue: 0,0:03:05.33,0:03:08.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kuciptakan tempat bagi yang kuat berkuasa\Ndan yang lemah menderita.
Dialogue: 0,0:03:08.96,0:03:12.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dunia iblis menyenangkan yang bahkan\Norang bodoh pun bisa mengerti!
Dialogue: 0,0:03:12.17,0:03:15.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia jujur dan berkarisma layaknya iblis.
Dialogue: 0,0:03:15.17,0:03:16.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia berbakat.
Dialogue: 0,0:03:16.43,0:03:18.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cucuku adalah legenda terhebat!
Dialogue: 0,0:03:18.01,0:03:21.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Belial, mohon jangan memberinya\Nuang saku selama wawancara.
Dialogue: 0,0:03:21.85,0:03:24.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Masih belum cukup!\N- Kalau begitu, bagaimana denganmu?
Dialogue: 0,0:03:27.27,0:03:32.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dunia iblis seperti apa\Nyang akan kamu ciptakan?
Dialogue: 0,0:03:41.62,0:03:42.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku...
Dialogue: 0,0:03:43.62,0:03:45.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku...
Dialogue: 0,0:03:47.33,0:03:53.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutku, dunia iblis saat ini\Nsudah cukup baik.
Dialogue: 0,0:04:01.76,0:04:06.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudmu, dunia iblis\Nyang tidak stabil ini sudah bagus?
Dialogue: 0,0:04:07.48,0:04:10.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dunia iblis saat ini sedang tidak stabil?
Dialogue: 0,0:04:12.32,0:04:16.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya, kamu kurang paham\Nkeadaan dunia iblis saat ini, ya.
Dialogue: 0,0:04:16.82,0:04:20.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maafkan aku.\NAku kurang tahu keadaan di luar Babyls.
Dialogue: 0,0:04:20.82,0:04:24.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.\NKamu... Tidak.
Dialogue: 0,0:04:27.21,0:04:28.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi...
Dialogue: 0,0:04:28.66,0:04:33.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mungkin ingin menjadikan\Ndunia iblis seperti Babyls.
Dialogue: 0,0:04:38.26,0:04:41.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, kenapa tidak Tuan Sullivan\Nyang jadi Raja Iblis?
Dialogue: 0,0:04:42.39,0:04:45.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.\NItu juga menyenangkan, sih.
Dialogue: 0,0:04:45.43,0:04:48.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin aku jadi Raja Iblis saja, deh.
Dialogue: 0,0:04:48.18,0:04:48.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei!
Dialogue: 0,0:04:48.81,0:04:50.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu melanggar perjanjian kita, Sully!
Dialogue: 0,0:04:51.52,0:04:54.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, kami terima pendapatmu.
Dialogue: 0,0:04:54.73,0:04:57.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekian pertanyaannya.
Dialogue: 0,0:04:57.57,0:05:01.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami harap kalian bertiga\Ntetap menyimpan ambisi itu,
Dialogue: 0,0:05:01.41,0:05:04.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bersaing, dan saling membantu\Nuntuk berkembang.
Dialogue: 0,0:05:04.37,0:05:05.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:05:05.71,0:05:06.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:05:14.50,0:05:15.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang
Dialogue: 0,0:05:15.84,0:05:18.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di Thirteen's Dinner!
Dialogue: 0,0:05:20.47,0:05:22.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada banyak makanan!
Dialogue: 0,0:05:22.89,0:05:24.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelihatannya enak!
Dialogue: 0,0:05:24.22,0:05:29.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mewah sekali!\NJamuan untuk 13 Mahkota memang beda!
Dialogue: 0,0:05:31.56,0:05:33.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo cepat makan!
Dialogue: 0,0:05:33.10,0:05:34.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan! Silakan!
Dialogue: 0,0:05:38.86,0:05:40.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hap!
Dialogue: 0,0:05:52.96,0:05:55.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian akrab sekali, ya.
Dialogue: 0,0:05:59.55,0:06:01.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kantor polisi dunia iblis\Nmasih seperti biasa?
Dialogue: 0,0:06:02.63,0:06:03.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baal.
Dialogue: 0,0:06:04.47,0:06:05.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:06:05.85,0:06:09.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini, kami sedang bekerja sama\Nuntuk menyelidiki kasus Behemolt.
Dialogue: 0,0:06:09.85,0:06:11.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Repot juga, ya.
Dialogue: 0,0:06:11.73,0:06:15.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa tidak ada insiden besar lain\Nyang mengguncang dunia iblis?
Dialogue: 0,0:06:15.61,0:06:18.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini masih belum ada.
Dialogue: 0,0:06:19.03,0:06:21.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih atas tempo hari lalu.
Dialogue: 0,0:06:21.24,0:06:25.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan masalah,\Nkita bisa berdandan lagi lain kali.
Dialogue: 0,0:06:25.62,0:06:26.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya.
Dialogue: 0,0:06:26.45,0:06:27.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mau, ya!
Dialogue: 0,0:06:28.03,0:06:32.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia kemungkinan adalah manusia\Nyang dibawa oleh Tuan Sullivan.
Dialogue: 0,0:06:32.16,0:06:37.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia diundang ke Thirteen's Dinner,\Npusat dari dunia iblis...
Dialogue: 0,0:06:37.88,0:06:41.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang sebenarnya dipikirkan\NTuan Sullivan?
Dialogue: 0,0:06:43.01,0:06:46.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajahmu seperti bilang ada sesuatu, ya?
Dialogue: 0,0:06:46.05,0:06:47.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada.
Dialogue: 0,0:06:47.26,0:06:49.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, jelas ada.
Dialogue: 0,0:06:49.26,0:06:50.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada.
Dialogue: 0,0:06:52.06,0:06:54.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, terserahlah.
Dialogue: 0,0:06:58.98,0:07:01.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pak Henry, lama tidak berjumpa.
Dialogue: 0,0:07:01.19,0:07:02.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, Iruma.
Dialogue: 0,0:07:02.90,0:07:05.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku selalu banyak dibantu Kak Ameri!
Dialogue: 0,0:07:05.70,0:07:07.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dibantu!
Dialogue: 0,0:07:07.24,0:07:09.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya.
Dialogue: 0,0:07:14.71,0:07:20.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal kamu sudah repot-repot datang,\Nmaaf aku sangat sibuk hari ini.
Dialogue: 0,0:07:20.34,0:07:22.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, tidak perlu dipikirkan.
Dialogue: 0,0:07:22.67,0:07:23.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:07:23.92,0:07:27.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak kusangka Iruma\Nakan jadi calon Raja Iblis.
Dialogue: 0,0:07:27.84,0:07:34.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku merasa sangat terhormat karena\NAnda menganggapku sebagai guru Iruma.
Dialogue: 0,0:07:35.77,0:07:40.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini, kamu hanya\Nkandidat 13 Mahkota, sih.
Dialogue: 0,0:07:40.65,0:07:46.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin kamu memikul tanggung jawab\Nmemimpin dunia iblis di masa depan, lo.
Dialogue: 0,0:07:46.70,0:07:48.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Sullivan...
Dialogue: 0,0:07:48.16,0:07:51.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menaruh harapan besar\Npadamu, Bachiko.
Dialogue: 0,0:07:52.91,0:07:57.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku, Barbatos Bachiko,\Nakan terus bekerja keras
Dialogue: 0,0:07:57.58,0:08:00.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}demi memenuhi harapan\NTuan Sullivan.
Dialogue: 0,0:08:00.13,0:08:01.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master!
Dialogue: 0,0:08:02.21,0:08:06.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya Master ketemu!\NSelamat sudah jadi kandidat 13 Mahkota!
Dialogue: 0,0:08:06.42,0:08:08.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma jadi kandidat!
Dialogue: 0,0:08:08.97,0:08:11.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlalu cepat untuk kasih selamat, tahu!\NDasar murid bodoh.
Dialogue: 0,0:08:11.80,0:08:16.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bachiko, barusan kamu bilang Iruma bodoh?
Dialogue: 0,0:08:22.57,0:08:24.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iruma.
Dialogue: 0,0:08:26.44,0:08:30.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya aku telah salah paham,\Njadi aku mohon maaf.
Dialogue: 0,0:08:30.66,0:08:32.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa, jangan dipikirkan.
Dialogue: 0,0:08:32.40,0:08:36.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pernah mendengar tentangmu sebelumnya.
Dialogue: 0,0:08:38.28,0:08:44.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keributan di Walter Park\Ndan pembuka Royal One di Babyls...
Dialogue: 0,0:08:45.13,0:08:46.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu ulahmu, kan?
Dialogue: 0,0:08:46.76,0:08:48.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya.
Dialogue: 0,0:08:48.05,0:08:51.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu ulahmu?\NTernyata begitu, ya?
Dialogue: 0,0:08:53.01,0:08:54.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemungkinan...
Dialogue: 0,0:08:55.01,0:08:57.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai cucu dari Tiga Agung...
Dialogue: 0,0:08:57.68,0:09:01.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akan sering bertemu\Ndi masa mendatang.
Dialogue: 0,0:09:04.61,0:09:07.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan kalah dari kalian!
Dialogue: 0,0:09:11.28,0:09:13.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hore! Aku juga!
Dialogue: 0,0:09:13.62,0:09:17.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kerahkan segalanya, Leiji! Iruma!
Dialogue: 0,0:09:17.45,0:09:20.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? I-Iya.
Dialogue: 0,0:09:22.04,0:09:23.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa menyentuh jariku?
Dialogue: 0,0:09:23.33,0:09:25.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Karena kamu menunjuk duluan.
Dialogue: 0,0:09:25.42,0:09:27.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya!
Dialogue: 0,0:09:27.34,0:09:31.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mumpung bersama,\Nbiar kuambil foto kalian bertiga.
Dialogue: 0,0:09:32.09,0:09:34.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yak, lebih dekat lagi!
Dialogue: 0,0:09:35.47,0:09:39.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sip! Kalau begitu,\Nsemuanya berpose angka tiga, ya!
Dialogue: 0,0:09:39.35,0:09:41.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiga?
Dialogue: 0,0:09:41.19,0:09:42.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini!
Dialogue: 0,0:09:42.10,0:09:43.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini?
Dialogue: 0,0:09:43.06,0:09:45.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah! Biar aku yang tentukan posenya!
Dialogue: 0,0:09:45.44,0:09:46.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kufoto, ya?
Dialogue: 0,0:09:47.44,0:09:49.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yak, devi!
Dialogue: 0,0:09:51.36,0:09:52.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus!
Dialogue: 0,0:09:52.99,0:09:54.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Mana?
Dialogue: 0,0:09:55.74,0:09:58.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, Iruma kok kecil?
Dialogue: 0,0:09:58.24,0:10:00.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Raz harusnya lebih tengah lagi!
Dialogue: 0,0:10:00.00,0:10:02.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sudah bagus, tahu!
Dialogue: 0,0:10:02.37,0:10:04.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, ayo foto sekali lagi!
Dialogue: 0,0:10:05.50,0:10:07.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, berikan kameranya!
Dialogue: 0,0:10:07.13,0:10:08.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga mau pinjam!
Dialogue: 0,0:10:08.21,0:10:10.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Aku ingin foto Iruma lebih banyak!\N- Tidak mau! Serahkan saja padaku!
Dialogue: 0,0:10:10.01,0:10:12.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pasti akan memperlakukan\Nkhusus untuk cucumu, kan?
Dialogue: 0,0:10:12.59,0:10:13.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bentar!
Dialogue: 0,0:10:13.09,0:10:15.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belyan, kamu pasti juga begitu!
Dialogue: 0,0:10:15.01,0:10:15.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian ini!
Dialogue: 0,0:10:15.76,0:10:17.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar aku yang foto!
Dialogue: 0,0:10:18.26,0:10:19.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau terlalu maksa,
Dialogue: 0,0:10:19.14,0:10:21.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- tidak akan kukasih foto yang tadi, lo!\N- Nenek, sebelah sana! Serang terus!
Dialogue: 0,0:10:21.98,0:10:23.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Apa? Itu curang!\N- Kakek, semangat!
Dialogue: 0,0:10:23.52,0:10:24.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Levi jahat, deh!
Dialogue: 0,0:10:31.69,0:10:35.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, menyenangkan, ya.
Dialogue: 0,0:10:35.03,0:10:36.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, ya!
Dialogue: 0,0:10:36.24,0:10:39.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu gugup?
Dialogue: 0,0:10:39.24,0:10:40.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:10:42.25,0:10:46.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari ketiga cucu Tiga Agung,\NIruma memang yang paling imut!
Dialogue: 0,0:10:46.67,0:10:49.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakek bangga sekali, lo!
Dialogue: 0,0:10:49.13,0:10:51.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakek dapat banyak fotomu.
Dialogue: 0,0:10:51.13,0:10:54.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti Kakek minta Opera\Nuntuk buat kain hias, poster—
Dialogue: 0,0:10:54.26,0:10:55.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakek.
Dialogue: 0,0:11:02.35,0:11:04.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakek...
Dialogue: 0,0:11:06.27,0:11:09.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ingin menjadikanku Raja Iblis?
Dialogue: 0,0:11:17.57,0:11:19.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Raja Iblis adalah...
Dialogue: 0,0:11:19.62,0:11:24.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Posisi paling berat sekaligus\Npaling agung di dunia iblis ini.
Dialogue: 0,0:11:24.37,0:11:29.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin menyiapkan jalan\Nuntukmu jadi Raja Iblis,
Dialogue: 0,0:11:29.59,0:11:33.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}agar kelak kamu bisa memilih.
Dialogue: 0,0:11:35.22,0:11:38.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi hal itu, dibutuhkan banyak persiapan.
Dialogue: 0,0:11:38.68,0:11:41.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Acara hari ini adalah salah satunya.
Dialogue: 0,0:11:42.35,0:11:46.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja kalau kamu tidak mau\Njadi Raja Iblis juga boleh.
Dialogue: 0,0:11:46.27,0:11:50.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gampangnya, Kakek cuma\Nikut campur seperti biasa.
Dialogue: 0,0:11:50.19,0:11:52.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.\NTerima kasih!
Dialogue: 0,0:11:52.94,0:11:56.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, sepertinya aku kurang cocok.
Dialogue: 0,0:11:56.28,0:11:59.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga tidak bisa\Nmenjawab dengan benar.
Dialogue: 0,0:11:59.49,0:12:03.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, bukan masalah!\NPertanyaan itu tidak ada gunanya!
Dialogue: 0,0:12:03.08,0:12:03.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:12:06.21,0:12:09.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka bertiga sungguh menarik, ya!
Dialogue: 0,0:12:09.21,0:12:09.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:12:09.96,0:12:13.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku suka cara Leiji makan.
Dialogue: 0,0:12:14.59,0:12:16.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berbeda dengan penampilannya,\Ndia cukup berani.
Dialogue: 0,0:12:16.88,0:12:19.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu yang kumaksud dengan garang.
Dialogue: 0,0:12:19.39,0:12:22.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ditambah lagi, saat aku menyinggung\Nsoal tata kramanya...
Dialogue: 0,0:12:22.14,0:12:26.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berdasarkan aturanku,\Nini cara makan yang benar!
Dialogue: 0,0:12:26.06,0:12:28.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia membalas begitu.
Dialogue: 0,0:12:28.19,0:12:32.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aturan dia mutlak!\NRasanya enak karena dia apa adanya!
Dialogue: 0,0:12:32.65,0:12:34.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh berani!
Dialogue: 0,0:12:34.82,0:12:36.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau soal tidak disangka...
Dialogue: 0,0:12:36.44,0:12:38.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Razberry.
Dialogue: 0,0:12:41.99,0:12:44.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski cara dia pakai\Nperalatan makan berantakan,
Dialogue: 0,0:12:45.33,0:12:48.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia yang makan paling rapi.
Dialogue: 0,0:12:48.54,0:12:52.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski dia asal campur makanan\Ndan membuat makanannya jadi aneh.
Dialogue: 0,0:12:53.88,0:12:56.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, dia juga pilih-pilih makan.
Dialogue: 0,0:12:56.38,0:12:59.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia memindahkan makanan\Nyang tidak disukai ke piring lain.
Dialogue: 0,0:12:59.84,0:13:02.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diam-diam ditaruh ke piring Leiji, ya.
Dialogue: 0,0:13:03.97,0:13:09.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iblis memang kelihatan dari cara makannya.\NSifat aslinya langsung keluar.
Dialogue: 0,0:13:09.94,0:13:11.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah kenapa kita mengadakan
Dialogue: 0,0:13:11.44,0:13:14.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}rapat sambil makan malam.
Dialogue: 0,0:13:15.65,0:13:19.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sifat asli mereka kelihatan jelas\Ndibanding acara curhat anak remaja.
Dialogue: 0,0:13:19.49,0:13:21.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hasrat mereka jadi kelihatan, ya.
Dialogue: 0,0:13:21.95,0:13:24.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar serakah, ya.
Dialogue: 0,0:13:24.95,0:13:27.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, calon yang paling menonjol...
Dialogue: 0,0:13:27.45,0:13:32.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah! Enak banget! Enak banget!\NEnak banget!
Dialogue: 0,0:13:32.67,0:13:35.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, apa aku boleh minta tambah?
Dialogue: 0,0:13:39.01,0:13:43.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baru kali ini ada tamu iblis\Nyang minta tambah di Thirteen's Dinner.
Dialogue: 0,0:13:43.84,0:13:48.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlebih lagi, dia makan\Ndengan lahap dan bahagia.
Dialogue: 0,0:13:49.52,0:13:51.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia makan sampai bersih, ya.
Dialogue: 0,0:13:51.94,0:13:55.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika bahas kapasitas perutnya,\Ndia bisa menyaingi Behemolt.
Dialogue: 0,0:13:56.82,0:13:59.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dipikir-pikir, dia menakutkan.
Dialogue: 0,0:14:00.28,0:14:02.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa tidak?
Dialogue: 0,0:14:07.53,0:14:08.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu artinya...
Dialogue: 0,0:14:10.33,0:14:12.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerakusannya tidak terbatas, kan?
Dialogue: 0,0:14:13.67,0:14:15.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya jadi merinding.
Dialogue: 0,0:14:15.79,0:14:16.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika...
Dialogue: 0,0:14:16.96,0:14:20.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sampai jadi Raja Iblis.
Dialogue: 0,0:14:30.47,0:14:32.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Di Bawah Sinar Matahari".
Dialogue: 0,0:14:34.23,0:14:35.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Iruma!
Dialogue: 0,0:14:35.94,0:14:40.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah dengar dari Ibunda!\NAnda diundang ke Thirteen's Dinner!
Dialogue: 0,0:14:40.86,0:14:42.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya.
Dialogue: 0,0:14:42.53,0:14:43.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tart in Dinner?
Dialogue: 0,0:14:43.78,0:14:49.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlebih lagi, Anda diperkenalkan\Nsebagai iblis muda berbakat pada 13 Mahkota!
Dialogue: 0,0:14:49.37,0:14:52.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anda sudah jelas bisa\Ndisebut Raja Iblis berikutnya!
Dialogue: 0,0:14:52.79,0:14:54.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu berlebihan!
Dialogue: 0,0:14:54.12,0:14:55.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, lagi bahas apa?
Dialogue: 0,0:14:55.92,0:14:58.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma pergi menemani kakekku.
Dialogue: 0,0:14:58.63,0:15:00.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tetap luar biasa!
Dialogue: 0,0:15:00.80,0:15:05.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga sibuk mempersiapkan diri,\Ntapi tetap saja tidak sebanding dengan Anda!
Dialogue: 0,0:15:05.38,0:15:06.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anda memang hebat!
Dialogue: 0,0:15:06.59,0:15:07.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mempersiapkan diri?
Dialogue: 0,0:15:07.89,0:15:09.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang begitu, kan?
Dialogue: 0,0:15:09.18,0:15:14.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya! Setelah tahun baru dan semester tiga\Nberakhir, tahun ajaran baru dimulai!
Dialogue: 0,0:15:15.94,0:15:19.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan kata lain,\Npersiapan untuk kelas dua!
Dialogue: 0,0:15:20.36,0:15:21.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ke...\N- Kelas dua?
Dialogue: 0,0:15:21.94,0:15:26.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada pindah kelas bagi kelas abnormal,\Njadi kita satu kelas lagi, ya!
Dialogue: 0,0:15:26.57,0:15:29.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya! Azz, Clara, mohon bantuannya, ya!
Dialogue: 0,0:15:29.24,0:15:31.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Irumachi, Azz-Azz, mohon bantuannya!
Dialogue: 0,0:15:34.37,0:15:38.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kabarnya, lebih banyak praktik\Ndi kelas dua, lo!
Dialogue: 0,0:15:38.00,0:15:40.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, praktik, ya.\NKelihatannya sulit.
Dialogue: 0,0:15:40.67,0:15:43.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mantra yang kita pelajari\Nakan bertambah!
Dialogue: 0,0:15:43.01,0:15:46.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelajarannya pun bertambah!\NLalu, yang lainnya adalah...
Dialogue: 0,0:15:46.47,0:15:49.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Adik kelas!
Dialogue: 0,0:15:49.39,0:15:54.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya! Benar juga!\NMurid kelas satu yang baru bakal masuk, ya!
Dialogue: 0,0:15:54.52,0:15:58.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Murid baru!\NKita perlu perlihatkan kehebatanmu, ya!
Dialogue: 0,0:15:58.81,0:16:01.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bakal dipanggil\N"Kak Irumachi", lo.
Dialogue: 0,0:16:01.90,0:16:02.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:16:02.65,0:16:04.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Irumachi?
Dialogue: 0,0:16:04.40,0:16:09.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kak...\N- Kak Iruma!
Dialogue: 0,0:16:09.41,0:16:11.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo makan bersama!
Dialogue: 0,0:16:11.12,0:16:12.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa Kakak suka onigiri?
Dialogue: 0,0:16:12.91,0:16:14.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak, ini kukis!
Dialogue: 0,0:16:14.70,0:16:16.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat, Irumachi jadi halu.
Dialogue: 0,0:16:16.96,0:16:20.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Iruma! Kurasa Anda salah paham!\NTuan Iruma!
Dialogue: 0,0:16:20.42,0:16:21.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak boleh, Irumachi!
Dialogue: 0,0:16:21.79,0:16:24.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu harus bersikap seperti kakak kelas\Nagar tidak diremehkan!
Dialogue: 0,0:16:25.38,0:16:28.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat belikan kami roti, Kak.
Dialogue: 0,0:16:30.39,0:16:32.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini!
Dialogue: 0,0:16:34.47,0:16:38.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan membakar\Nbocah-bocah kurang ajar seperti itu!
Dialogue: 0,0:16:38.31,0:16:40.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah! Azz, tidak perlu!
Dialogue: 0,0:16:40.77,0:16:42.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sip! Ayo latihan!
Dialogue: 0,0:16:45.15,0:16:47.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma pura-pura, sih!
Dialogue: 0,0:16:47.89,0:16:51.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami akan jadi adik kelas,\NIrumachi jadi kakak kelas yang keren, ya!
Dialogue: 0,0:16:51.87,0:16:54.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku bisa?
Dialogue: 0,0:16:55.29,0:16:58.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Persiapannya selesai!
Dialogue: 0,0:16:58.08,0:17:01.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari mulai dengan salam yang ceria,\NKak Irumachi!
Dialogue: 0,0:17:01.29,0:17:03.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tu— Kak Iruma!
Dialogue: 0,0:17:03.38,0:17:04.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Met pagi!
Dialogue: 0,0:17:06.30,0:17:08.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pa-Pagi!
Dialogue: 0,0:17:08.01,0:17:09.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duh! Kaku! Kaku!
Dialogue: 0,0:17:09.97,0:17:13.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kaku banget, Irumachi!\N"Pagi"-nya kok begitu?
Dialogue: 0,0:17:13.72,0:17:15.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, iya.
Dialogue: 0,0:17:15.18,0:17:19.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anda tidak perlu terlalu sopan\Npada adik kelas, Tuan Iruma!
Dialogue: 0,0:17:21.23,0:17:23.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belum terbiasa, jadi rasanya agak sulit.
Dialogue: 0,0:17:23.94,0:17:26.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, Azz-Azz,\Ntolong beri contoh.
Dialogue: 0,0:17:26.44,0:17:28.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Contoh?
Dialogue: 0,0:17:28.06,0:17:31.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami akan buat keributan, jadi marahi kami!
Dialogue: 0,0:17:31.53,0:17:33.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu jago memarahi, kan?
Dialogue: 0,0:17:33.45,0:17:35.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar, aneh-aneh saja.
Dialogue: 0,0:17:35.49,0:17:38.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sip! Action!
Dialogue: 0,0:17:38.00,0:17:39.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Asmodeus!
Dialogue: 0,0:17:41.12,0:17:43.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat pagi, Kak!
Dialogue: 0,0:17:43.33,0:17:44.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tu—
Dialogue: 0,0:17:44.54,0:17:46.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak tampak murung!\NMau coba main marakas?
Dialogue: 0,0:17:46.88,0:17:49.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau mau joget?
Dialogue: 0,0:17:49.09,0:17:52.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo! Ayo! Marahi kami, Kak! Ayo!
Dialogue: 0,0:17:52.09,0:17:57.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Marahi? Tapi, memarahi Tuan Iruma...\NMeski cuma pura-pura...
Dialogue: 0,0:17:57.10,0:18:00.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak! Kak Asmodeus! Hei! Hei!
Dialogue: 0,0:18:00.60,0:18:03.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Latihan! Ini cuma latihan!
Dialogue: 0,0:18:03.27,0:18:07.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, mana bisa aku, sahabat Tuan Iruma,\Nbicara kasar padanya!
Dialogue: 0,0:18:07.82,0:18:09.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:18:10.69,0:18:13.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo? Azz? Ada apa?
Dialogue: 0,0:18:13.75,0:18:16.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?\NDia sama sekali tidak bergerak!
Dialogue: 0,0:18:16.78,0:18:20.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Colek! Colek!\NKamu takut sama adik kelasmu, ya, Kak!
Dialogue: 0,0:18:20.45,0:18:22.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berisik, Valac.
Dialogue: 0,0:18:22.20,0:18:25.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhenti mencolekku.\NDuduk dan kerjakan PR-mu dengan tenang.
Dialogue: 0,0:18:25.17,0:18:27.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak banyak bicara padaku!
Dialogue: 0,0:18:27.63,0:18:30.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Azz, kamu boleh marah padaku, kok.
Dialogue: 0,0:18:30.71,0:18:33.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti saat kita pertama bertemu.
Dialogue: 0,0:18:33.13,0:18:36.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat kita bertemu?\NItu artinya...
Dialogue: 0,0:18:37.47,0:18:42.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Iruma! Ketua kelas,\Nbiar aku yang memberi sambutan!
Dialogue: 0,0:18:43.06,0:18:45.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berwibawa sekali!
Dialogue: 0,0:18:45.35,0:18:47.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aberuhauke.
Dialogue: 0,0:18:47.19,0:18:48.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silau!
Dialogue: 0,0:18:48.27,0:18:50.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tapi aku ingin lihat kilauan ini selamanya!\N- Cling! Cling!
Dialogue: 0,0:18:50.78,0:18:52.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo berduel!
Dialogue: 0,0:18:52.07,0:18:52.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:18:54.61,0:18:55.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lambat.
Dialogue: 0,0:18:55.57,0:18:58.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu terlalu lambat, Asmodeus.
Dialogue: 0,0:18:58.53,0:19:00.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Iruma memang hebat!
Dialogue: 0,0:19:00.83,0:19:03.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong jadikan aku bawahanmu!
Dialogue: 0,0:19:03.62,0:19:04.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh!
Dialogue: 0,0:19:06.12,0:19:08.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak jauh beda dengan yang sekarang, ya.
Dialogue: 0,0:19:08.71,0:19:10.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salah! Salah! Salah!
Dialogue: 0,0:19:10.13,0:19:12.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama sekali tidak begitu, lo!
Dialogue: 0,0:19:12.55,0:19:15.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dan Azz jauh beda!\NEh? Ini bohong, kan?
Dialogue: 0,0:19:15.05,0:19:17.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Azz yang waktu itu tidak dianggap?
Dialogue: 0,0:19:17.76,0:19:19.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mengerti\Napa yang Anda maksud.
Dialogue: 0,0:19:19.64,0:19:21.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertemuan awal dengan mereka berdua...
Dialogue: 0,0:19:21.97,0:19:25.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hore! Hore! Hore!
Dialogue: 0,0:19:25.52,0:19:29.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Clara! Itu juga salah!\NIngatan dari mana itu?
Dialogue: 0,0:19:29.61,0:19:32.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duh, Azz-Azz tidak bisa diandalkan!
Dialogue: 0,0:19:32.03,0:19:35.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mau kumarahi dengan sekuat tenaga?
Dialogue: 0,0:19:35.07,0:19:37.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa boleh buat.
Dialogue: 0,0:19:37.03,0:19:39.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ajari kami, Kak Clara!
Dialogue: 0,0:19:41.08,0:19:45.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yak! Adik-adik manis sekalian!\NKakak Clara bakal ajarin macam-macam,
Dialogue: 0,0:19:45.96,0:19:48.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi pastikan kalian menyimak, ya!
Dialogue: 0,0:19:48.29,0:19:49.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, Kak!
Dialogue: 0,0:19:50.79,0:19:53.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan lari di lorong!
Dialogue: 0,0:19:53.51,0:19:55.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak boleh terbang juga!
Dialogue: 0,0:19:56.01,0:20:00.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tisu, saputangan, dan permen\Nadalah barang wajib dibawa, lo!
Dialogue: 0,0:20:00.21,0:20:03.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat kembali dari luar, jangan lupa\Ncuci tangan dan tanduk kalian!
Dialogue: 0,0:20:03.56,0:20:05.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beri salam kalau ketemu kakak kelas!
Dialogue: 0,0:20:05.77,0:20:07.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pastikan kalian menyapa dengan sopan!
Dialogue: 0,0:20:07.60,0:20:08.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Baik!\N- Baik.
Dialogue: 0,0:20:08.44,0:20:09.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo?
Dialogue: 0,0:20:09.40,0:20:14.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para guru seram kalau sedang marah,\Njadi usilnya diam-diam!
Dialogue: 0,0:20:14.07,0:20:16.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hati-hati dengan Pak Eggy!
Dialogue: 0,0:20:16.03,0:20:18.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hukuman dari beliau paling berat!\NIngat itu baik-baik!
Dialogue: 0,0:20:18.91,0:20:19.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Baik.
Dialogue: 0,0:20:19.82,0:20:22.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya...
Dialogue: 0,0:20:22.58,0:20:25.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia jadi contoh kakak kelas yang baik.
Dialogue: 0,0:20:25.91,0:20:28.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kerepotan,\Nsegera temui kakak kelasmu ini.
Dialogue: 0,0:20:28.96,0:20:30.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Baik.
Dialogue: 0,0:20:31.33,0:20:33.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengajarkan mereka tentang sekolah\Njuga menyenangkan.
Dialogue: 0,0:20:33.80,0:20:35.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, kan?
Dialogue: 0,0:20:35.09,0:20:37.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, kita harus ramah pada mereka.
Dialogue: 0,0:20:37.76,0:20:40.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sisanya tinggal memperlihatkan\Naura berwibawa lebih saja.
Dialogue: 0,0:20:40.72,0:20:41.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berwibawa?
Dialogue: 0,0:20:41.85,0:20:45.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, ayo pamer kekuatan\Ndengan gaya ketua geng!
Dialogue: 0,0:20:45.35,0:20:46.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah! Boleh, tuh!
Dialogue: 0,0:20:46.81,0:20:47.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu!
Dialogue: 0,0:20:47.85,0:20:52.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan lupa keanggunan!\NMerek berkelas wajib ada!
Dialogue: 0,0:20:55.03,0:20:58.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gaya ketua geng bangsawan yang berwibawa!
Dialogue: 0,0:20:58.99,0:21:01.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan ragu curhat padaku, ya!
Dialogue: 0,0:21:01.70,0:21:02.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei!
Dialogue: 0,0:21:03.07,0:21:04.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon maaf—
Dialogue: 0,0:21:04.33,0:21:07.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Irumachi kocak banget!
Dialogue: 0,0:21:07.12,0:21:10.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duh, jadi kacau balau, tahu.
Dialogue: 0,0:21:10.21,0:21:12.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau tanya ke Kak Nell-Nell?
Dialogue: 0,0:21:12.00,0:21:13.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Schnell, ya?
Dialogue: 0,0:21:15.34,0:21:16.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya tidak usah.
Dialogue: 0,0:21:18.26,0:21:19.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:21:20.22,0:21:24.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti apa pun adik kelas kita,\Nmeski kita sudah kelas dua...
Dialogue: 0,0:21:25.89,0:21:31.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama kita bertiga bersama, pasti akan\Njadi setahun yang menyenangkan, ya!
Dialogue: 0,0:21:34.77,0:21:36.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja!
Dialogue: 0,0:21:36.48,0:21:40.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya! Itu pasti!\NPasti sangat menyenangkan!
Dialogue: 0,0:21:41.20,0:21:43.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita juga harus banyak belajar, ya!
Dialogue: 0,0:21:43.41,0:21:45.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo latihan bersama!
Dialogue: 0,0:21:45.70,0:21:48.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski iblis berkacamata, ramah,\Ndan punya gaya bicara aneh menyerang,
Dialogue: 0,0:21:48.62,0:21:50.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku pasti akan melindungi Anda!
Dialogue: 0,0:21:50.54,0:21:51.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baiklah...
Dialogue: 0,0:21:51.67,0:21:53.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo berjuang!
Dialogue: 0,0:21:53.54,0:21:55.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:22:01.09,0:22:03.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajah yang tampak bahagia\Ndan sehelai rambut imut yang mencuat.
Dialogue: 0,0:22:04.97,0:22:06.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:22:15.81,0:22:17.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Pasukan Iruma sedang tidur.\N- Imutnya!
Dialogue: 0,0:22:17.86,0:22:19.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Pulas sekali.\N- Pasukan empuk.
Dialogue: 0,0:22:21.78,0:22:24.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bangun, dasar bodoh!
Dialogue: 0,0:22:24.20,0:22:27.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian sadar kalau sudah kelas dua, kan?
Dialogue: 0,0:22:30.16,0:22:33.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keesokan paginya,\Nmereka masuk di koran sekolah.
Dialogue: 0,0:24:05.97,0:24:08.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tambahan!
Dialogue: 0,0:24:08.05,0:24:09.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo?
Dialogue: 0,0:24:09.80,0:24:11.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo makan yang banyak!
Dialogue: 0,0:24:14.72,0:24:17.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerakusan yang luar biasa!
Dialogue: 0,0:24:17.10,0:24:18.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senangnya!
Dialogue: 0,0:24:19.35,0:24:21.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makan besar yang luar biasa!
Dialogue: 0,0:24:21.73,0:24:24.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanku termasuk sedikit, ya?
Dialogue: 0,0:24:24.73,0:24:26.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makan sedikit?
Dialogue: 0,0:24:26.15,0:24:27.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entahlah.
Dialogue: 0,0:24:27.65,0:24:29.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakek juga takut.
Dialogue: 0,0:24:29.99,0:24:30.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iruma.
Dialogue: 0,0:24:30.99,0:24:34.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia kemungkinan adalah manusia\Nyang dibawa oleh Tuan Sullivan.
Dialogue: 0,0:24:34.24,0:24:36.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang sebenarnya dipikirkan\NTuan Sullivan?
Dialogue: 0,0:24:36.83,0:24:39.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga harus memperingatkan Ameri.
Dialogue: 0,0:24:39.12,0:24:40.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan terlalu dekat dengan Iruma!
Dialogue: 0,0:24:40.63,0:24:43.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah jelas, hubungan asmara dilarang!
Dialogue: 0,0:24:43.46,0:24:45.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama kacamata ini masih hitam,
Dialogue: 0,0:24:45.26,0:24:47.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}selama aku masih hidup,\Ntidak akan kumaafkan!
Dialogue: 0,0:24:47.97,0:24:49.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya, Selamat Datang\Ndi Sekolah Iblis, Iruma.
Dialogue: 0,0:24:49.84,0:24:51.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Turnamen Olahraga Idola Iblis".
Dialogue: 0,0:24:51.76,0:24:54.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke-Kenapa Ameri ada\Ndi antara para idola iblis?
Dialogue: 0,0:24:54.06,0:24:55.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ameri!
