Dialogue: 0,0:00:08.95,0:00:16.25,sign,,0000,0000,0000,,WELCOME TO DEMON SCHOOL! IRUMA-KUN SEASON 4
Dialogue: 0,0:01:29.99,0:01:30.61,sign,,0000,0000,0000,,MILIARDER DAN PERMATA
Dialogue: 0,0:01:42.00,0:01:45.00,sign,,0000,0000,0000,,PERTANDINGAN JATUHKAN TARGET BERPUTAR
Dialogue: 0,0:01:50.92,0:01:54.05,sign,,0000,0000,0000,,TARGET BERKECEPATAN TINGGI
Dialogue: 0,0:12:15.84,0:12:18.13,sign,,0000,0000,0000,,PERTANDINGAN BERKUDA IDOLA IBLIS
Dialogue: 0,0:15:07.43,0:15:10.26,sign,,0000,0000,0000,,MENGINGINKAN
Dialogue: 0,0:24:28.28,0:24:29.70,sign,,0000,0000,0000,,TAMBAHAN
Dialogue: 0,0:24:29.99,0:24:30.57,sign,,0000,0000,0000,,CUPLIKAN
Dialogue: 0,0:01:30.61,0:01:32.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Miliarder dan Permata".
Dialogue: 0,0:01:34.99,0:01:38.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertandingan selanjutnya yang\Nakan berlangsung adalah...
Dialogue: 0,0:01:38.95,0:01:42.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimanapun caranya,\Nkamu menang kalau mengenai target!
Dialogue: 0,0:01:42.00,0:01:45.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertandingan Jatuhkan Target Berputar!
Dialogue: 0,0:01:45.00,0:01:47.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian bisa dapat poin sangat tinggi...
Dialogue: 0,0:01:48.80,0:01:50.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku adalah "Target Berkecepatan Tinggi".
Dialogue: 0,0:01:50.92,0:01:54.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akulah yang tercepat dan punya poin tertinggi!
Dialogue: 0,0:01:54.05,0:01:55.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jatuhkan aku jika bisa!
Dialogue: 0,0:01:59.93,0:02:01.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kena kamu, sialan!
Dialogue: 0,0:02:01.02,0:02:03.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Jangan menghindari, oi!\N- Pada seluruh Idola Iblis,
Dialogue: 0,0:02:03.10,0:02:05.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}meski kesal,\Ntolong jangan berkata kasar!
Dialogue: 0,0:02:05.94,0:02:09.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senjata jarak jauh mana yang paling\Nmenarik perhatianmu, Pak Gontetsu?
Dialogue: 0,0:02:09.32,0:02:13.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah! Pak Gontetsu juga pegang senjata!
Dialogue: 0,0:02:13.15,0:02:14.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bawa senjata pribadinya!
Dialogue: 0,0:02:15.91,0:02:17.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Target terus menghindar!
Dialogue: 0,0:02:19.04,0:02:21.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, Targetnya mulai sombong!
Dialogue: 0,0:02:29.00,0:02:30.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:02:30.05,0:02:31.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peluru? Sihir?
Dialogue: 0,0:02:33.30,0:02:36.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak! I-Itu...
Dialogue: 0,0:02:37.64,0:02:40.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Partnerku
Dialogue: 0,0:02:40.52,0:02:44.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang terbaik dan terkuat\Nadalah dia yang imut ini!
Dialogue: 0,0:02:44.52,0:02:47.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Itu anak panah!
Dialogue: 0,0:02:49.02,0:02:51.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bang Ali, ayo teruskan!
Dialogue: 0,0:02:51.48,0:02:53.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:02:53.65,0:02:56.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap! Serahkan saja pada Aliko!
Dialogue: 0,0:03:01.41,0:03:02.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Imut!
Dialogue: 0,0:03:02.58,0:03:04.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, reaksi yang tidak terduga.
Dialogue: 0,0:03:04.75,0:03:07.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bang Ali! Kamu bisa buat\Nberapa anak panah lagi?
Dialogue: 0,0:03:07.96,0:03:10.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih banyak dari sebelumnya.
Dialogue: 0,0:03:10.59,0:03:13.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang ingin kucoba.
Dialogue: 0,0:03:14.76,0:03:17.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu semangat sekali.
Dialogue: 0,0:03:18.64,0:03:23.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, aku yang sudah tumbuh\Nakan mewujudkan harapanmu itu.
Dialogue: 0,0:03:23.81,0:03:25.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fractal!
Dialogue: 0,0:03:27.90,0:03:29.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:03:41.83,0:03:43.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu dulu!
Dialogue: 0,0:03:43.04,0:03:44.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bohong, kan?
Dialogue: 0,0:03:46.75,0:03:49.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kubuat kamu keluar arena!
Dialogue: 0,0:03:59.30,0:04:01.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahaya, tahu.
Dialogue: 0,0:04:04.64,0:04:09.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master mungkin akan marah karena\Naku menirunya, tapi mari kita coba.
Dialogue: 0,0:04:09.31,0:04:11.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ja-Jangan-jangan...
Dialogue: 0,0:04:11.44,0:04:13.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Empat Panah Beruntun!
Dialogue: 0,0:04:13.86,0:04:16.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bachikon!
Dialogue: 0,0:04:22.62,0:04:26.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pe-Pemenang pertandingan\NJatuhkan Target Berputar...
Dialogue: 0,0:04:28.58,0:04:31.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tim Devimuse, Irumi!
Dialogue: 0,0:04:33.13,0:04:35.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh teknik memanah\Nyang luar biasa!
Dialogue: 0,0:04:35.63,0:04:37.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemandangan yang sangat indah!
Dialogue: 0,0:04:37.84,0:04:41.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, kan, Pak Gonte—\NWaduh, beliau pingsan!
Dialogue: 0,0:04:41.18,0:04:44.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi tombolnya tidak berhenti ditekan!
Dialogue: 0,0:04:44.14,0:04:47.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Idola Iblis pendatang baru\Nyang misterius, Irumi!
Dialogue: 0,0:04:47.14,0:04:52.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak hanya imut, tapi tidak kusangka\Ndia juga menyimpan jurus seperti itu!
Dialogue: 0,0:04:52.15,0:04:54.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat! Hebat! Irumichi nomor satu!
Dialogue: 0,0:04:54.69,0:04:58.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kamu nomor satu! Juara satu!\N- Sungguh kemampuan memanah yang luar biasa!
Dialogue: 0,0:04:58.99,0:05:00.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kamerawan! Sorot lebih lagi!\N- Tu, tu! Jreng, jreng, jreng!
Dialogue: 0,0:05:00.86,0:05:01.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Bisa sorot lebih lagi, kan?\N- Nomor satu!
Dialogue: 0,0:05:01.99,0:05:04.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penampilan yang luar biasa!
Dialogue: 0,0:05:04.66,0:05:07.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah jauh berkembang, ya!
Dialogue: 0,0:05:07.50,0:05:09.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak!
Dialogue: 0,0:05:10.50,0:05:12.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chima! Terima kasih.
Dialogue: 0,0:05:13.58,0:05:16.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sangat berkilauan\Ndan sangat luar biasa, lo.
Dialogue: 0,0:05:16.21,0:05:18.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:05:19.97,0:05:21.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}La-Lah?
Dialogue: 0,0:05:21.51,0:05:24.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu memang pertandingan\Nyang luar biasa, sih.
Dialogue: 0,0:05:24.51,0:05:27.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang luar biasa, tapi...
Dialogue: 0,0:05:27.27,0:05:29.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah kamu terlalu mencolok?
Dialogue: 0,0:05:29.31,0:05:33.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, maafkan aku!\NAku agak keasyikan.
Dialogue: 0,0:05:33.77,0:05:35.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh saja keasyikan, tapi...
Dialogue: 0,0:05:48.29,0:05:51.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemenang pertandingan\NTarik Tambang Ekor...
Dialogue: 0,0:05:51.58,0:05:54.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Gyari!
Dialogue: 0,0:05:55.59,0:05:58.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oi, Lindy! Apa yang terjadi?
Dialogue: 0,0:05:59.30,0:06:00.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Se...
Dialogue: 0,0:06:00.59,0:06:03.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Secepat kilat.
Dialogue: 0,0:06:03.13,0:06:06.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat sadar, aku sudah di langit.
Dialogue: 0,0:06:06.14,0:06:08.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat! Aku akan dihajar...
Dialogue: 0,0:06:14.19,0:06:16.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku seperti dipeluk olehnya.
Dialogue: 0,0:06:16.15,0:06:17.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti dipeluk?
Dialogue: 0,0:06:17.44,0:06:20.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aromanya seperti bunga mawar.
Dialogue: 0,0:06:20.86,0:06:23.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lindy!
Dialogue: 0,0:06:23.70,0:06:27.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, Nona Gyari.\NPendapat Anda tentang kemenangan...
Dialogue: 0,0:06:27.33,0:06:31.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yo! Ayo bicara berdua denganku.
Dialogue: 0,0:06:31.25,0:06:35.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Jelek!
Dialogue: 0,0:06:47.85,0:06:51.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai Idola Iblis,\Nkamu harus percaya diri!
Dialogue: 0,0:06:51.06,0:06:53.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Imut banget! Paling imut sedunia!
Dialogue: 0,0:06:53.81,0:06:55.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mantap! Imut mantap!
Dialogue: 0,0:06:55.85,0:06:59.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Cling!\N- Idola Iblis semua orang, Irumi!
Dialogue: 0,0:07:02.90,0:07:05.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan cewek lancang itu?
Dialogue: 0,0:07:05.91,0:07:07.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Irumichi imut, kan?
Dialogue: 0,0:07:07.24,0:07:09.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja! Paling imut!
Dialogue: 0,0:07:09.66,0:07:14.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah! Irumi dan Gyari\Nakan saling berhadapan!
Dialogue: 0,0:07:17.67,0:07:22.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sombong karena berhasil\Nmenang permainan bocah, Jelek!
Dialogue: 0,0:07:22.92,0:07:24.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak jelek!
Dialogue: 0,0:07:24.17,0:07:25.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Dibandingkan itu,\N- Aku tidak jelek!
Dialogue: 0,0:07:25.84,0:07:28.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- pertandingan Tarik Tambang Ekorku jempolan!\N- Aku tidak jelek!
Dialogue: 0,0:07:28.30,0:07:31.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Habisnya aku adalah aku, sih!\N- Aku tidak jelek!
Dialogue: 0,0:07:31.60,0:07:35.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya, buka telinga kalian\Ndan dengarkan ini baik-baik!
Dialogue: 0,0:07:35.85,0:07:39.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan memenangkan\NTurnamen Olahraga Idola Iblis ini
Dialogue: 0,0:07:39.44,0:07:42.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan menikah dengan Kuromu!
Dialogue: 0,0:07:45.40,0:07:46.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menikah?
Dialogue: 0,0:07:46.11,0:07:47.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka tidak akur, kan?
Dialogue: 0,0:07:47.11,0:07:48.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya?
Dialogue: 0,0:07:48.41,0:07:49.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu.
Dialogue: 0,0:07:52.16,0:07:53.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu Kuromu!
Dialogue: 0,0:07:53.04,0:07:54.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Imut banget!\N- Apa yang bakal terjadi?
Dialogue: 0,0:07:54.66,0:07:56.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, Kuromu—
Dialogue: 0,0:07:56.66,0:07:57.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pinjam.
Dialogue: 0,0:07:58.50,0:08:01.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga harus meluruskan sesuatu.
Dialogue: 0,0:08:01.92,0:08:03.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gyari.
Dialogue: 0,0:08:03.80,0:08:06.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan menikah denganmu.
Dialogue: 0,0:08:07.76,0:08:09.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu karena...
Dialogue: 0,0:08:20.31,0:08:23.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menikah dengannya!
Dialogue: 0,0:08:39.33,0:08:42.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuromu membalas dengan\Nmengumumkan pernikahan?
Dialogue: 0,0:08:42.78,0:08:43.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo.
Dialogue: 0,0:08:43.53,0:08:46.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Ini kejadian terbesar sejak
Dialogue: 0,0:08:46.24,0:08:48.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Turnamen Olahraga Idola Iblis dimulai!\N- Kuromu!
Dialogue: 0,0:08:48.34,0:08:50.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Nona Irumi!\N- Guru besar!
Dialogue: 0,0:08:50.26,0:08:53.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ajari aku sihir\Nmemikat orang sekarang juga!
Dialogue: 0,0:08:54.31,0:08:57.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tu-Tunggu! Kuromu!
Dialogue: 0,0:08:59.85,0:09:02.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke-Kenapa kamu tiba-tiba mengata—
Dialogue: 0,0:09:02.35,0:09:05.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:09:06.69,0:09:07.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf!
Dialogue: 0,0:09:07.99,0:09:10.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan klarifikasi nanti!\NMaafkan aku!
Dialogue: 0,0:09:12.91,0:09:14.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa...
Dialogue: 0,0:09:18.41,0:09:22.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dan Gyari dulunya\Nberada di agensi yang sama.
Dialogue: 0,0:09:23.63,0:09:26.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami membentuk tim dengan yang lain
Dialogue: 0,0:09:26.38,0:09:30.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan mencoba melakukan\NHell Dance, tapi gagal.
Dialogue: 0,0:09:30.26,0:09:33.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya aku dan Gyari yang berhasil.
Dialogue: 0,0:09:34.68,0:09:38.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi muncul usulan agar aku\Ndan Gyari membentuk unit duo.
Dialogue: 0,0:09:39.56,0:09:40.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:09:40.89,0:09:43.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menolaknya mentah-mentah.
Dialogue: 0,0:09:43.90,0:09:46.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iruma, aku...
Dialogue: 0,0:09:46.90,0:09:49.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa bersama dengan Gyari.
Dialogue: 0,0:09:50.19,0:09:51.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil.
Dialogue: 0,0:09:54.24,0:09:57.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu ingat cerita tentang\Nsang Miliarder dalam lagu Karpet Lilith?
Dialogue: 0,0:09:58.29,0:10:00.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gyari adalah sosok miliarder itu.
Dialogue: 0,0:10:00.83,0:10:02.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Status dan kehormatan...
Dialogue: 0,0:10:02.54,0:10:05.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Segala yang ia inginkan\Npasti akan ia dapatkan.
Dialogue: 0,0:10:05.88,0:10:08.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia adalah miliarder yang rakus.
Dialogue: 0,0:10:11.67,0:10:16.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, aku adalah permata\Nyang ia inginkan.
Dialogue: 0,0:10:16.68,0:10:18.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Objek yang ia dambakan.
Dialogue: 0,0:10:19.35,0:10:21.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru karena itu...
Dialogue: 0,0:10:22.73,0:10:26.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak boleh jatuh\Nke genggamannya.
Dialogue: 0,0:10:26.23,0:10:30.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesaat setelah mendapatkanku,\Ncintanya akan memudar.
Dialogue: 0,0:10:33.99,0:10:36.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makin terang aku bersinar,
Dialogue: 0,0:10:36.99,0:10:40.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gyari pun makin mencoba meraihku.
Dialogue: 0,0:10:42.71,0:10:44.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iruma.
Dialogue: 0,0:10:44.71,0:10:46.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku...
Dialogue: 0,0:10:48.67,0:10:52.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi dapat melihat\Nsosoknya yang berkilauan.
Dialogue: 0,0:10:53.22,0:10:56.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak ingin orang lain merebut\Nkursi terdepan untuk melihatnya.
Dialogue: 0,0:10:59.64,0:11:01.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan pengumuman pernikahanku,
Dialogue: 0,0:11:01.64,0:11:05.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gyari pasti kehilangan kendali\Ndan akan menyerang sekuat tenaga.
Dialogue: 0,0:11:06.15,0:11:10.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru karena dia punya potensi\Nuntuk makin bersinar,
Dialogue: 0,0:11:10.48,0:11:12.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku harus menghajarnya habis-habisan.
Dialogue: 0,0:11:14.65,0:11:15.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira...
Dialogue: 0,0:11:16.45,0:11:20.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nama kedua Kuromu tidak cocok dengannya.
Dialogue: 0,0:11:20.99,0:11:24.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku paham betul sekarang.
Dialogue: 0,0:11:24.33,0:11:27.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia adalah Idola Iblis yang berkilauan
Dialogue: 0,0:11:27.50,0:11:29.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan tidak salah lagi...
Dialogue: 0,0:11:31.00,0:11:33.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia adalah iblis yang egois!
Dialogue: 0,0:11:34.05,0:11:37.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, ini saatnya pertandingan\Nyang sesungguhnya!
Dialogue: 0,0:11:46.94,0:11:50.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duh! Kuromu berhasil mengelabui kami!
Dialogue: 0,0:11:50.11,0:11:52.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga terkejut, tahu!
Dialogue: 0,0:11:52.57,0:11:54.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, berkat itu...
Dialogue: 0,0:12:00.16,0:12:04.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada yang bisa\Nmenghentikan Gyari saat ini.
Dialogue: 0,0:12:05.16,0:12:09.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena pengumuman pernikahan tadi,\Nseluruh stadion jadi meriah.
Dialogue: 0,0:12:09.38,0:12:12.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari biarkan mereka\Nmenyalurkan hasratnya di sini!
Dialogue: 0,0:12:12.17,0:12:15.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hadiahnya adalah aku!\NRaihlah tangan itu!
Dialogue: 0,0:12:15.84,0:12:18.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertandingan Berkuda Idola Iblis!
Dialogue: 0,0:12:18.13,0:12:21.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka semua akan saling berebut pita!
Dialogue: 0,0:12:21.60,0:12:25.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pita para kuda bernilai 20 poin!\NPita sang jenderal bernilai 100 poin!
Dialogue: 0,0:12:25.89,0:12:28.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terbang dan sihir dilarang!
Dialogue: 0,0:12:28.14,0:12:30.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senjata kalian hanya tubuh kalian!
Dialogue: 0,0:12:30.10,0:12:32.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Benar-benar pertandingan sesungguhnya!\N- Dengan kata lain,
Dialogue: 0,0:12:32.15,0:12:34.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- mereka mungkin saling merobek baju—\N- Pak Gontetsu, sudah waktunya mematikan mik!
Dialogue: 0,0:12:34.90,0:12:36.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo! Ayo!
Dialogue: 0,0:12:36.36,0:12:38.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hajar mereka, Kuromu!
Dialogue: 0,0:12:40.91,0:12:43.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kalau begitu, bersiap...\N- Nah!
Dialogue: 0,0:12:43.28,0:12:44.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Maju!\N- Mulai!
Dialogue: 0,0:12:44.41,0:12:49.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat! Cepat! Cepat!\NTim Devimuse bergerak secepat kilat!
Dialogue: 0,0:12:49.12,0:12:51.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah dengar situasinya dari Iruma.
Dialogue: 0,0:12:51.96,0:12:55.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengumuman pernikahan itu adalah\Nkebohongan untuk menyulut Gyari.
Dialogue: 0,0:12:55.59,0:12:58.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesalahpahaman itu akan berakhir\Nsetelah turnamen ini selesai.
Dialogue: 0,0:12:58.55,0:12:59.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,
Dialogue: 0,0:12:59.88,0:13:02.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan kuakhiri secepat mungkin!
Dialogue: 0,0:13:07.31,0:13:08.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu...
Dialogue: 0,0:13:12.73,0:13:15.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tim Gyari!
Dialogue: 0,0:13:15.61,0:13:17.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaikan tank perang!
Dialogue: 0,0:13:17.86,0:13:20.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka merebut satu per satu pita lawan!
Dialogue: 0,0:13:20.11,0:13:22.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keduanya pun saling berhadapan!
Dialogue: 0,0:13:22.82,0:13:24.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tim drama pernikahan!
Dialogue: 0,0:13:27.54,0:13:29.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuromu!
Dialogue: 0,0:13:31.67,0:13:34.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku selalu...
Dialogue: 0,0:13:35.42,0:13:38.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku selalu mengira diriku tokoh utama.
Dialogue: 0,0:13:39.63,0:13:41.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gyari.
Dialogue: 0,0:13:42.18,0:13:45.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mainan dan wahana bermain\Nmilik semuanya, jadi...
Dialogue: 0,0:13:46.18,0:13:49.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Segala yang kuingin adalah milikku.
Dialogue: 0,0:13:49.43,0:13:51.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu betul!
Dialogue: 0,0:13:51.31,0:13:52.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu juga mau ikut?
Dialogue: 0,0:13:52.77,0:13:54.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh, nih?
Dialogue: 0,0:13:54.77,0:13:59.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bintang sejak lahir.\NAku juga diberkahi harta berlimpah.
Dialogue: 0,0:13:59.53,0:14:03.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Segala yang kuinginkan selalu kudapat.\NPengikutku pun banyak.
Dialogue: 0,0:14:03.53,0:14:05.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berapa satu tambah satu?
Dialogue: 0,0:14:05.03,0:14:05.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sembilan!
Dialogue: 0,0:14:05.74,0:14:06.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salah.
Dialogue: 0,0:14:06.74,0:14:08.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lumayan pandai belajar juga.
Dialogue: 0,0:14:08.91,0:14:11.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku adalah pusat dari dunia.
Dialogue: 0,0:14:11.29,0:14:14.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar tokoh utama terbaik!
Dialogue: 0,0:14:15.21,0:14:17.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harusnya seperti itu.
Dialogue: 0,0:14:20.55,0:14:24.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku terkena serangan berkilaunya\Nsaat berjalan di tengah musim dingin.
Dialogue: 0,0:14:42.11,0:14:43.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku terkejut.
Dialogue: 0,0:14:43.82,0:14:47.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada tokoh utama lain berdiri di sana.
Dialogue: 0,0:14:47.62,0:14:49.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada dua tokoh utama?
Dialogue: 0,0:14:49.99,0:14:52.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku tokoh utama?
Dialogue: 0,0:14:53.54,0:14:55.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu...
Dialogue: 0,0:14:55.12,0:14:59.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuromu, dia adalah Gyari,\Npeserta pelatihan baru di tempat kita.
Dialogue: 0,0:15:00.42,0:15:02.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon bantuannya, ya.
Dialogue: 0,0:15:02.59,0:15:04.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu, jadilah milikku.
Dialogue: 0,0:15:04.55,0:15:05.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu...
Dialogue: 0,0:15:06.55,0:15:10.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membuatku sangat menginginkannya!
Dialogue: 0,0:15:10.26,0:15:13.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Telah kuputuskan kalau kamulah\Nyang akan berada di sisiku!
Dialogue: 0,0:15:13.43,0:15:16.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menginginkanmu!
Dialogue: 0,0:15:16.90,0:15:18.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:15:23.40,0:15:25.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti akan kudapatkan!
Dialogue: 0,0:15:28.03,0:15:32.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang hanya kamu\Nyang pantas untukku.
Dialogue: 0,0:15:32.41,0:15:34.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya aku seorang...
Dialogue: 0,0:15:34.91,0:15:37.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya aku yang pantas mendapatkanmu!
Dialogue: 0,0:15:37.81,0:15:39.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:15:39.42,0:15:42.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu menolak\Nmembuat unit duo denganku?
Dialogue: 0,0:15:42.38,0:15:45.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya aku seorang\Nyang mampu mengimbangimu!
Dialogue: 0,0:15:45.42,0:15:46.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, kan?
Dialogue: 0,0:15:46.72,0:15:48.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru karena itu.
Dialogue: 0,0:15:48.76,0:15:52.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gyari, keluarlah dari agensi ini.
Dialogue: 0,0:15:54.68,0:15:57.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tak bisa melampauiku\Nkalau tetap di sini.
Dialogue: 0,0:15:58.27,0:16:04.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu menginginkanku,\Nberkilaulah lebih lagi dan lampaui aku!
Dialogue: 0,0:16:17.12,0:16:19.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Janji.
Dialogue: 0,0:16:25.88,0:16:28.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku berhasil melampauimu,
Dialogue: 0,0:16:28.83,0:16:30.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita akan menikah!
Dialogue: 0,0:16:32.05,0:16:35.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita berdua sudah berjanji, kan?\NKuromu?
Dialogue: 0,0:16:35.81,0:16:39.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku terus menjulurkan tanganku\Ndan sedikit lagi bisa meraihmu.
Dialogue: 0,0:16:39.52,0:16:42.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di saat akhirnya\Naku hampir menggapaimu,
Dialogue: 0,0:16:42.31,0:16:45.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu akan pergi menjauh lagi?
Dialogue: 0,0:16:46.28,0:16:52.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika itu jawabanmu, aku...
Dialogue: 0,0:16:55.99,0:16:59.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makin menginginkanmu, lo!
Dialogue: 0,0:17:02.96,0:17:06.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memang diberkati!
Dialogue: 0,0:17:06.21,0:17:10.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sampai bisa menemukan\Nsesuatu yang sangat kuinginkan!
Dialogue: 0,0:17:10.72,0:17:14.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat membara saat ini!
Dialogue: 0,0:17:14.72,0:17:20.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan iblis kalau tidak bersemangat\Nsaat hal yang diinginkan makin menjauh!
Dialogue: 0,0:17:20.23,0:17:25.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oleh karena itu, tenang saja, Kuromu!\NLarilah sekuat tenaga!
Dialogue: 0,0:17:26.06,0:17:28.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pasti akan menangkapmu!
Dialogue: 0,0:17:31.74,0:17:35.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena aku adalah tokoh utama!
Dialogue: 0,0:17:41.25,0:17:44.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia itu cukup bodoh, ya.
Dialogue: 0,0:17:46.00,0:17:47.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beeber!
Dialogue: 0,0:17:47.50,0:17:51.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hai, semuanya!\NApa kalian terpikat oleh kilauanku?
Dialogue: 0,0:17:51.51,0:17:53.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada yang melihatmu.
Dialogue: 0,0:17:53.22,0:17:55.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku sudah berkilau seperti ini?
Dialogue: 0,0:17:55.18,0:17:59.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai Idola Iblis, aku kesal\Nkarena seluruh perhatian telah dicuri.
Dialogue: 0,0:17:59.60,0:18:01.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, jujur saja...
Dialogue: 0,0:18:06.40,0:18:09.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak ingin berada\Ndi tengah-tengah mereka.
Dialogue: 0,0:18:18.66,0:18:21.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertandingan sengit yang terus tarik-ulur!
Dialogue: 0,0:18:23.58,0:18:25.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menghindar, Irumi!
Dialogue: 0,0:18:25.79,0:18:27.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia langsung sadar akan bahaya!
Dialogue: 0,0:18:31.80,0:18:34.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kuhancurkan\Nkalau kamu menyentuh Irumi.
Dialogue: 0,0:18:34.43,0:18:37.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Merie, Idola Iblis tidak boleh\Nberekspresi begitu!
Dialogue: 0,0:18:37.05,0:18:38.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga di sini!
Dialogue: 0,0:18:38.06,0:18:41.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Nona Gyari!\N- Semangat!
Dialogue: 0,0:18:41.06,0:18:44.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ka-Kak Kuromu...\N- Maju terus, Nona Gyari!
Dialogue: 0,0:18:44.06,0:18:45.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chima.
Dialogue: 0,0:18:46.06,0:18:47.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perhatikan baik-baik.
Dialogue: 0,0:18:54.95,0:18:58.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Kuromu, semangat!
Dialogue: 0,0:18:59.70,0:19:00.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak-anak?
Dialogue: 0,0:19:00.45,0:19:01.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chima?
Dialogue: 0,0:19:06.79,0:19:09.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Itu...
Dialogue: 0,0:19:22.68,0:19:24.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu baik-baik saja?
Dialogue: 0,0:19:27.90,0:19:29.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah.
Dialogue: 0,0:19:29.61,0:19:32.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktunya habis!
Dialogue: 0,0:19:32.19,0:19:35.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tim Gyari memperoleh poin terbanyak!
Dialogue: 0,0:19:35.32,0:19:38.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini kemenangan Nona Gyari!
Dialogue: 0,0:19:43.20,0:19:45.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya.
Dialogue: 0,0:19:46.46,0:19:49.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya aku dapat menggapaimu.
Dialogue: 0,0:19:55.22,0:19:57.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chima, ayo periksakan dirimu\Nke tenda medis.
Dialogue: 0,0:19:57.88,0:19:59.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita segera rapat.
Dialogue: 0,0:20:00.89,0:20:02.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kak Kerori...
Dialogue: 0,0:20:07.23,0:20:08.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja.
Dialogue: 0,0:20:09.73,0:20:15.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini, Kuromu pasti\Nsedang banyak pikiran.
Dialogue: 0,0:20:15.56,0:20:19.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, semua akan baik-baik saja\Nkalau dibicarakan dengan tenang.
Dialogue: 0,0:20:21.99,0:20:23.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo.
Dialogue: 0,0:20:31.25,0:20:33.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, masih ada satu pertandingan lagi.
Dialogue: 0,0:20:33.75,0:20:37.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja!\NKita bisa balikkan keadaan!
Dialogue: 0,0:20:37.45,0:20:41.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kalah,\Nsoal menikah dan berhenti...
Dialogue: 0,0:20:41.22,0:20:45.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua itu tidak benar, kan?\NItu hanya akting, kan?
Dialogue: 0,0:20:47.39,0:20:52.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dan Gyari tidak berdiri di sini\Ndengan keyakinan selemah itu.
Dialogue: 0,0:20:52.90,0:20:56.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kalah, aku akan jadi miliknya.
Dialogue: 0,0:20:56.40,0:21:00.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harusnya tidak boleh kalah\Ndi pertandingan sebelumnya.
Dialogue: 0,0:21:01.41,0:21:04.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena pertandingan selanjutnya\Nadalah pertandingan penampilan.
Dialogue: 0,0:21:04.76,0:21:08.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemenang dari pertandingan sebelumnya\Nbisa memilih jenis aliran musiknya.
Dialogue: 0,0:21:08.54,0:21:11.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gyari pasti akan memilih genre...
Dialogue: 0,0:21:12.29,0:21:13.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rock.
Dialogue: 0,0:21:14.54,0:21:17.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rock adalah keahlian Gyari.
Dialogue: 0,0:21:17.05,0:21:20.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gyari dapat banyak momentum\Ndari pertandingan berkuda tadi.
Dialogue: 0,0:21:20.01,0:21:22.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kalau mencoba bersaing dengan musik rock,\N- Kuromu.
Dialogue: 0,0:21:22.43,0:21:23.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita perlu melakukan sesuatu
Dialogue: 0,0:21:23.72,0:21:25.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- yang sedikit berbeda dari Gyari...\N- Kuromu.
Dialogue: 0,0:21:25.68,0:21:27.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tapi, kita tidak boleh melenceng\N- Kuromu.
Dialogue: 0,0:21:27.47,0:21:29.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dari tema musik Rock.
Dialogue: 0,0:21:29.14,0:21:29.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini mustahil.
Dialogue: 0,0:21:29.94,0:21:33.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kostum kita hitam... Maksudku ungu.\N- Kuromu.
Dialogue: 0,0:21:33.15,0:21:35.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya! Kalau bisa buat—
Dialogue: 0,0:21:38.49,0:21:41.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu bisa dengar suaraku?
Dialogue: 0,0:21:43.11,0:21:45.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dari tadi berulang kali memanggilmu.
Dialogue: 0,0:21:46.14,0:21:47.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu...
Dialogue: 0,0:21:47.87,0:21:49.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chima!
Dialogue: 0,0:21:50.12,0:21:55.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku, Kak.
Dialogue: 0,0:21:57.00,0:22:00.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak marah, kok, Chima.
Dialogue: 0,0:22:00.26,0:22:01.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuh, dia tidak marah.
Dialogue: 0,0:22:01.51,0:22:03.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah, ya, Chima.
Dialogue: 0,0:22:03.22,0:22:06.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakakmu sedang memikirkan banyak hal.
Dialogue: 0,0:22:06.60,0:22:09.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya dia ketua Tim Devimuse\Nyang bisa diandalkan.
Dialogue: 0,0:22:09.52,0:22:12.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, tenang saja.\NTidak perlu khawatir.
Dialogue: 0,0:22:12.52,0:22:14.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Pertandingannya baru dimulai, kok.\N- Benar juga.
Dialogue: 0,0:22:14.23,0:22:16.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Aku tidak sendirian saat ini,\N- Itu benar.
Dialogue: 0,0:22:16.61,0:22:19.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Semua pasti baik-baik saja.\N- tapi bersama timku.
Dialogue: 0,0:22:19.53,0:22:21.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku, semuanya!
Dialogue: 0,0:22:21.90,0:22:25.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gyari memengaruhiku\Nsampai aku jadi terbebani.
Dialogue: 0,0:22:25.78,0:22:31.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Idola Iblis harusnya bersinar terang\Ndan membuat semua orang tersenyum!
Dialogue: 0,0:22:31.96,0:22:33.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya, terima kasih.
Dialogue: 0,0:22:33.58,0:22:35.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah baik-baik saja.
Dialogue: 0,0:22:37.50,0:22:41.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akan kalahkan Gyari dengan musik rock\Ndan membuat semua orang tersenyum!
Dialogue: 0,0:22:42.01,0:22:45.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu jelas akan jadi penampilan terbaik!
Dialogue: 0,0:22:46.18,0:22:48.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya, kita ini...
Dialogue: 0,0:22:49.51,0:22:52.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Imut sekali!
Dialogue: 0,0:24:25.49,0:24:28.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tambahan!
Dialogue: 0,0:24:28.28,0:24:29.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat malam.
Dialogue: 0,0:24:30.57,0:24:33.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya pertandingan terakhir\NTurnamen Olahraga Idola Iblis tiba!
Dialogue: 0,0:24:33.38,0:24:34.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktunya tampil!
Dialogue: 0,0:24:34.49,0:24:37.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku adalah Idola Iblis Rock!\NKalau tampil, jelas dengan musik rock!
Dialogue: 0,0:24:37.75,0:24:42.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuromu, akan kubuktikan!\NKeren lebih unggul daripada imut!
Dialogue: 0,0:24:42.59,0:24:46.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo! Rock 'n Roll! Devi Watcher!
Dialogue: 0,0:24:46.46,0:24:48.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya, Selamat Datang\Ndi Sekolah Iblis, Iruma.
Dialogue: 0,0:24:48.51,0:24:50.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Diva Sombong".
Dialogue: 0,0:24:50.01,0:24:53.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menggapai segala\Nyang kuingin dengan tangan ini!
Dialogue: 0,0:24:53.14,0:24:55.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gyari!
