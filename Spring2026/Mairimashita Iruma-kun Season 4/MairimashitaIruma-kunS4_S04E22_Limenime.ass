Dialogue: 0,0:00:00.00,0:00:00.65,sign,,0000,0000,0000,,RUANG GANTI DEVIMUSE
Dialogue: 0,0:01:08.51,0:01:15.81,sign,,0000,0000,0000,,WELCOME TO DEMON SCHOOL! IRUMA-KUN SEASON 4
Dialogue: 0,0:02:30.00,0:02:30.88,sign,,0000,0000,0000,,DIVA SOMBONG
Dialogue: 0,0:02:50.07,0:02:52.28,sign,,0000,0000,0000,,DEVIMUSE
Dialogue: 0,0:04:21.32,0:04:23.91,sign,,0000,0000,0000,,ROCK 'N ROLL DEVI WATCHER
Dialogue: 0,0:07:32.01,0:07:32.64,sign,,0000,0000,0000,,DEVIMUSE
Dialogue: 0,0:09:45.02,0:09:48.03,sign,,0000,0000,0000,,APOKALIPS IBLIS KECILMU ~VERSI MUSIK ROCK~
Dialogue: 0,0:12:36.07,0:12:36.74,sign,,0000,0000,0000,,UNICORN YANG BERSINAR
Dialogue: 0,0:14:26.10,0:14:27.60,sign,,0000,0000,0000,,IDOLA IBLIS?
Dialogue: 0,0:17:50.30,0:17:54.18,sign,,0000,0000,0000,,DEVIMUSE
Dialogue: 0,0:19:10.13,0:19:12.13,sign,,0000,0000,0000,,BEEBER
Dialogue: 0,0:19:19.12,0:19:21.89,sign,,0000,0000,0000,,BEEBER
Dialogue: 0,0:19:23.77,0:19:24.68,sign,,0000,0000,0000,,BEEBER
Dialogue: 0,0:21:36.69,0:21:39.15,sign,,0000,0000,0000,,SELAMAT PERAYAAN BULAN TIGA BELAS
Dialogue: 0,0:22:16.19,0:22:18.94,sign,,0000,0000,0000,,TURNAMEN OLAHRAGA IDOLA IBLIS
Dialogue: 0,0:22:18.94,0:22:21.03,sign,,0000,0000,0000,,PEMENANG - TIM DEVIMUSE
Dialogue: 0,0:24:02.84,0:24:03.21,sign,,0000,0000,0000,,TAMBAHAN
Dialogue: 0,0:24:29.99,0:24:30.49,sign,,0000,0000,0000,,CUPLIKAN
Dialogue: 0,0:00:00.65,0:00:01.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sip!
Dialogue: 0,0:00:01.98,0:00:03.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo lakukan!
Dialogue: 0,0:00:03.40,0:00:05.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:00:05.24,0:00:07.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Aku imut banget!\N- Imut!
Dialogue: 0,0:00:07.99,0:00:12.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukur, ya, Chima.\NKamu bisa bicara dengan kakakmu—
Dialogue: 0,0:00:12.74,0:00:16.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu merasa lega, ya.\NSyukurlah, ya.
Dialogue: 0,0:00:18.41,0:00:21.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Indah sekali.
Dialogue: 0,0:00:21.92,0:00:23.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti es.
Dialogue: 0,0:00:25.55,0:00:28.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak bisa melihatnya dengan jelas\Nkarena tertutup poni.
Dialogue: 0,0:00:28.63,0:00:32.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, matamu seperti air\Ndengan lapisan es tipis di atasnya.
Dialogue: 0,0:00:32.64,0:00:34.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sangat cantik.
Dialogue: 0,0:00:34.93,0:00:39.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mata Kuromu juga biru, tapi warna\Nmata Chima lebih dekat dengan warna air.
Dialogue: 0,0:00:39.89,0:00:41.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak tahu soal itu.
Dialogue: 0,0:00:46.23,0:00:47.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chima.
Dialogue: 0,0:00:48.99,0:00:50.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu berkilauan, ya.
Dialogue: 0,0:02:30.88,0:02:32.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Diva Sombong".
Dialogue: 0,0:02:38.93,0:02:41.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Turnamen Olahraga Idola Iblis!
Dialogue: 0,0:02:41.14,0:02:45.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Acara puncaknya adalah penampilan\Nlangsung dari empat tim terbaik!
Dialogue: 0,0:02:45.69,0:02:47.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tim Beeber!
Dialogue: 0,0:02:48.15,0:02:50.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tim Nenette!
Dialogue: 0,0:02:50.07,0:02:52.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tim Devimuse!
Dialogue: 0,0:02:52.86,0:02:55.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tim Gyari!
Dialogue: 0,0:02:55.07,0:02:56.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Temanya adalah
Dialogue: 0,0:02:56.95,0:02:58.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}musik rock!
Dialogue: 0,0:03:00.37,0:03:03.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul! Aku masih berkilau\Nmeski temanya musik rock!
Dialogue: 0,0:03:03.37,0:03:05.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tuan Bee!\N- Mantap!
Dialogue: 0,0:03:05.87,0:03:08.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkilau banget!
Dialogue: 0,0:03:08.00,0:03:10.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke! Ayo pergi bersama!
Dialogue: 0,0:03:10.50,0:03:13.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menuju dunia Bee yang rock dan berkilau!
Dialogue: 0,0:03:25.14,0:03:26.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, miknya...
Dialogue: 0,0:03:28.15,0:03:30.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sip!
Dialogue: 0,0:03:31.90,0:03:34.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, semuanya!
Dialogue: 0,0:03:34.61,0:03:35.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:03:35.65,0:03:39.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tu-Tunggu dulu!\NSekarang masih giliran—
Dialogue: 0,0:03:39.03,0:03:40.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:03:40.16,0:03:41.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus, kenapa?
Dialogue: 0,0:03:42.16,0:03:44.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bernyanyi saat ingin bernyanyi!
Dialogue: 0,0:03:44.70,0:03:47.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menunggu giliran sama sekali tidak rock.
Dialogue: 0,0:03:47.17,0:03:49.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baik.
Dialogue: 0,0:03:49.42,0:03:50.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:03:50.21,0:03:51.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gyari menerobos!
Dialogue: 0,0:03:51.04,0:03:52.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya ini giliran Tuan Bee?
Dialogue: 0,0:03:52.42,0:03:54.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, bukannya itu curang?
Dialogue: 0,0:04:00.68,0:04:04.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gyari!
Dialogue: 0,0:04:06.93,0:04:12.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rock 'n Roll Devi Watcher!
Dialogue: 0,0:04:13.27,0:04:16.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gyari hanya punya satu lagu andalan.
Dialogue: 0,0:04:16.02,0:04:20.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau lebih tepatnya,\Nsemua lagunya punya judul yang sama.
Dialogue: 0,0:04:23.91,0:04:30.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Gyari! Gyari! Gyari! Gyari!\NGyari! Gyari! Gyari the Rock! ♪
Dialogue: 0,0:04:30.67,0:04:36.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Gyari! Gyari! Gyari! Gyari!\NGyari! Gyari! Gyari the Rock! ♪
Dialogue: 0,0:04:37.47,0:04:40.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Minggir dari situ, aku mau lewat ♪
Dialogue: 0,0:04:40.97,0:04:44.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Jangan lambat-lambat\Natau kutendang ♪
Dialogue: 0,0:04:44.60,0:04:48.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Pegang dan seret ekormu ♪
Dialogue: 0,0:04:48.06,0:04:51.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Patahkan tanduk dan sayapmu ♪
Dialogue: 0,0:04:51.15,0:04:56.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Ayo lakukan sesuka hati\Ndan mengamuk ♪
Dialogue: 0,0:04:58.24,0:05:00.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gyari mengubah total lagu\Nyang telah disiapkan
Dialogue: 0,0:05:00.82,0:05:04.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk dinyanyikan\Ndi acara perilisan single debutnya.
Dialogue: 0,0:05:04.62,0:05:06.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duh! Kami jadi kerepotan, tahu!
Dialogue: 0,0:05:06.87,0:05:09.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mengabaikan seluruh kesepakatan kita!
Dialogue: 0,0:05:11.79,0:05:13.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:05:13.96,0:05:16.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gyari berbeda dengan\NIdola Iblis lainnya.
Dialogue: 0,0:05:16.92,0:05:19.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia Idola Iblis yang keren.
Dialogue: 0,0:05:19.84,0:05:22.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, lebih baik begini.
Dialogue: 0,0:05:23.55,0:05:27.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kepekaan musik yang ditempa lewat latihan\Ndan pesona alami miliknya.
Dialogue: 0,0:05:29.85,0:05:33.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, tidak pernah menyanyikan\Nlagu yang sama.
Dialogue: 0,0:05:33.56,0:05:35.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inilah improvisasi musik rock.
Dialogue: 0,0:05:35.57,0:05:37.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyanyiannya
Dialogue: 0,0:05:39.15,0:05:40.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menembus hati para iblis!
Dialogue: 0,0:05:40.65,0:05:44.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Tak ada gunanya punya akal sehat ♪
Dialogue: 0,0:05:44.45,0:05:47.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Kejarlah apa yang kamu inginkan ♪
Dialogue: 0,0:05:47.70,0:05:50.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Nah, berteriaklah,\Npara iblis yang mendamba ♪
Dialogue: 0,0:05:51.25,0:05:54.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Enam, lima, empat, tiga, dua, satu ♪
Dialogue: 0,0:05:54.46,0:05:57.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Rock 'n Roll Devi Watcher ♪
Dialogue: 0,0:05:57.84,0:06:01.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Cukup saksikan aku yang hebat ini ♪
Dialogue: 0,0:06:01.72,0:06:06.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Rock 'n Roll Devi Watcher ♪
Dialogue: 0,0:06:06.35,0:06:10.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Dengan hasrat ini, kita berdua\Nmelaju dengan kecepatan penuh ♪
Dialogue: 0,0:06:10.64,0:06:14.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Rock 'n Roll Devi Watcher ♪
Dialogue: 0,0:06:14.10,0:06:17.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Nah, aku datang untuk merebutmu ♪
Dialogue: 0,0:06:17.32,0:06:20.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Rock 'n Roll Devi Watcher ♪
Dialogue: 0,0:06:22.36,0:06:26.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Pastikan kamu sudah siap ♪
Dialogue: 0,0:06:26.41,0:06:27.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuromu.
Dialogue: 0,0:06:27.28,0:06:30.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Aku akan membuktikan padamu.\N- Gyari!
Dialogue: 0,0:06:30.58,0:06:35.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Keren lebih unggul daripada imut!\N- Gyari!
Dialogue: 0,0:06:39.09,0:06:41.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sorak sorai yang luar biasa!
Dialogue: 0,0:06:41.42,0:06:43.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seisi dome—\NPak Gontetsu, tolong duduk!
Dialogue: 0,0:06:44.30,0:06:46.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Giliran Tuan Bee diserobot, tapi...
Dialogue: 0,0:06:46.68,0:06:47.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada urutan dalam musik rock!
Dialogue: 0,0:06:47.97,0:06:49.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sangat terpengaruh!
Dialogue: 0,0:06:49.43,0:06:52.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei! Apa Tim Nenette\Nmau duluan juga?
Dialogue: 0,0:06:52.98,0:06:55.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jelas akan mundur.
Dialogue: 0,0:06:55.23,0:06:59.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah diserobot penampilan begitu,\Nmana mungkin kita bisa menang.
Dialogue: 0,0:06:59.94,0:07:01.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah selesai.
Dialogue: 0,0:07:01.23,0:07:04.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Turnamen ini akan dimenangkan oleh Gyari.\N- Hei!
Dialogue: 0,0:07:05.66,0:07:08.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak mau nyanyi,\Nkami akan tampil duluan.
Dialogue: 0,0:07:08.99,0:07:14.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Encore! Encore! Encore!
Dialogue: 0,0:07:14.75,0:07:17.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sip! Kalau begitu, satu lagu lagi—
Dialogue: 0,0:07:19.13,0:07:21.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, ada apa ini?
Dialogue: 0,0:07:22.63,0:07:24.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyerobot baru muncul!
Dialogue: 0,0:07:24.76,0:07:26.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu...
Dialogue: 0,0:07:28.76,0:07:31.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tim Devimuse!
Dialogue: 0,0:07:32.64,0:07:34.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penampilan mereka berubah!
Dialogue: 0,0:07:34.02,0:07:35.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hitam!
Dialogue: 0,0:07:36.31,0:07:40.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Devimuse selalu tampil dengan imej imut,\Ntapi ini sungguh mengejutkan!
Dialogue: 0,0:07:40.40,0:07:44.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka terlihat seperti sedang\Ndalam mode siklus jahat!
Dialogue: 0,0:07:44.03,0:07:48.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski tampil bergaya rock, kamu tetap\Ntak akan bisa mengalahkanku, Iru—
Dialogue: 0,0:07:48.36,0:07:49.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oi, oi.
Dialogue: 0,0:07:53.24,0:07:55.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa yang kamu panggil jelek?
Dialogue: 0,0:08:04.05,0:08:08.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa iblis menawan itu?
Dialogue: 0,0:08:08.05,0:08:12.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kuperdengarkan kalian\Nlagu rock paling imut!
Dialogue: 0,0:08:14.14,0:08:15.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengar.
Dialogue: 0,0:08:16.06,0:08:20.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus membuang karisma\Nkeimutan kita untuk menang.
Dialogue: 0,0:08:20.19,0:08:21.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:08:21.61,0:08:24.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi bisa mengalahkan Gyari\Ndalam musik rock,
Dialogue: 0,0:08:24.36,0:08:28.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita harus perlihatkan keimutan\Nyang tidak pernah dilihat!
Dialogue: 0,0:08:30.87,0:08:34.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama, kita akan tampil keren\Nsecara habis-habisan!
Dialogue: 0,0:08:34.95,0:08:36.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah rencana kita!
Dialogue: 0,0:08:36.37,0:08:38.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan beri ide kalian juga!
Dialogue: 0,0:08:38.87,0:08:42.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik peralatan, koneksi, uang,\Ndan penampilan...
Dialogue: 0,0:08:42.59,0:08:44.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akan melakukan semua\Nyang bisa dilakukan!
Dialogue: 0,0:08:44.63,0:08:48.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duet kita sebelumnya\Nsaat di Makubari Dome, ya?
Dialogue: 0,0:08:48.88,0:08:53.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat menantikan nyanyianmu\Nyang sangat keren dan jahat!
Dialogue: 0,0:08:57.14,0:08:58.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian bisa main alat musik apa?
Dialogue: 0,0:08:58.64,0:08:59.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gitar!
Dialogue: 0,0:08:59.64,0:09:01.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau diajari,\Nakan kulakukan yang terbaik.
Dialogue: 0,0:09:01.85,0:09:04.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,\Napa kamu bisa main drum?
Dialogue: 0,0:09:04.11,0:09:06.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Baiklah, serahkan saja padaku.\N- Bang Ali.
Dialogue: 0,0:09:06.61,0:09:09.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga ingin melakukan\Nsegala yang kubisa!
Dialogue: 0,0:09:09.86,0:09:11.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi...
Dialogue: 0,0:09:13.70,0:09:15.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bantu aku!
Dialogue: 0,0:09:15.91,0:09:18.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iblis menawan misterius tiba-tiba muncul!
Dialogue: 0,0:09:18.66,0:09:22.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata dia adalah Irumi!
Dialogue: 0,0:09:22.17,0:09:23.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Irumi?
Dialogue: 0,0:09:23.25,0:09:24.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Bohong!\N- Dia seperti orang yang beda!
Dialogue: 0,0:09:25.13,0:09:26.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, Kuromu!
Dialogue: 0,0:09:31.13,0:09:34.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penampilan terakhir\Ndari Turnamen Olahraga Idola Iblis!
Dialogue: 0,0:09:34.18,0:09:36.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tim Devimuse mengubah\Npenampilan mereka!
Dialogue: 0,0:09:36.89,0:09:39.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja lagu ini yang akan\Nmereka persembahkan!
Dialogue: 0,0:09:39.89,0:09:41.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ayo!\N- Ayo!
Dialogue: 0,0:09:41.27,0:09:48.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Apokalips Iblis Kecilmu" versi musik rock!
Dialogue: 0,0:09:59.66,0:10:02.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Para Iblis sekalian,\Njangan sampai lengah ♪
Dialogue: 0,0:10:02.41,0:10:06.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Atau kelak,\Nhatimu akan kami curi ♪
Dialogue: 0,0:10:06.00,0:10:07.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Dor!♪
Dialogue: 0,0:10:08.67,0:10:13.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Ah, meski tampak imut,\Ngadis itu adalah iblis kecil ♪
Dialogue: 0,0:10:13.55,0:10:15.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Coba saja sentuh rambut ini ♪
Dialogue: 0,0:10:15.93,0:10:19.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Pelarianmu memang mulus,\Ntapi sayang sekali ♪
Dialogue: 0,0:10:19.85,0:10:22.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Ingin sentuh? Lebih dari ini? ♪
Dialogue: 0,0:10:22.35,0:10:27.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Kalau memaksa begitu,\Nakan kuladeni ♪
Dialogue: 0,0:10:27.19,0:10:32.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Suka? Lancang sekali!\NBerlututlah ♪
Dialogue: 0,0:10:32.61,0:10:38.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Jika rela demi aku,\Npersembahkanlah jiwamu ♪
Dialogue: 0,0:10:38.12,0:10:40.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Iblis kecil! Iblis kecil! ♪
Dialogue: 0,0:10:41.37,0:10:42.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuromu...
Dialogue: 0,0:10:43.50,0:10:46.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memujimu karena berani\Nmenghadapiku dengan musik rock.
Dialogue: 0,0:10:46.71,0:10:50.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, jangan remehkan aku!
Dialogue: 0,0:10:50.25,0:10:53.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau hanya begitu,\Nkamu tidak akan bisa melampauiku!
Dialogue: 0,0:10:58.14,0:11:08.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Suka? Aku sudah tahu itu, kok ♪
Dialogue: 0,0:11:09.11,0:11:20.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Jika demi aku, kamu bahkan\Nrela persembahkan hatimu, kan? ♪
Dialogue: 0,0:11:20.74,0:11:27.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Iblis kecil! Akulah iblis kecil ♪
Dialogue: 0,0:11:27.54,0:11:33.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Kan kubuat kalian berpaling padaku ♪
Dialogue: 0,0:11:34.34,0:11:37.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Sang iblis kecil ♪
Dialogue: 0,0:11:37.30,0:11:39.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Iblis kecil! Iblis kecil! ♪
Dialogue: 0,0:11:39.05,0:11:41.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gyari, kamu memang keren.
Dialogue: 0,0:11:41.76,0:11:44.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku ini rakus.
Dialogue: 0,0:11:44.60,0:11:46.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin semuanya!
Dialogue: 0,0:11:46.31,0:11:48.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Iblis kecil ♪
Dialogue: 0,0:11:48.31,0:11:52.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Imut dan keren...\NMari menari bersama!
Dialogue: 0,0:11:57.45,0:11:58.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makasih!
Dialogue: 0,0:12:13.30,0:12:15.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Turnamen Olahraga Idola Iblis!
Dialogue: 0,0:12:15.13,0:12:18.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertandingan panjang dan sengit\Nantara para Idola Iblis!
Dialogue: 0,0:12:18.72,0:12:22.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tim manakah yang akan\Nmenjadi pemenang?
Dialogue: 0,0:12:22.05,0:12:23.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saatnya mengumumkan hasilnya!
Dialogue: 0,0:12:25.98,0:12:28.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pembawa acaranya\Ntentu saja adalah beliau!
Dialogue: 0,0:12:28.73,0:12:33.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Komentator yang dulunya juga\Naktif sebagai Idola Iblis!
Dialogue: 0,0:12:33.07,0:12:36.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dialah Pak Gontetsu\Nsang Unicorn yang Bersinar.
Dialogue: 0,0:12:36.74,0:12:39.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gongon!
Dialogue: 0,0:12:40.07,0:12:45.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Turnamen Olahraga kali ini\Nsangat sengit dan luar biasa.
Dialogue: 0,0:12:45.24,0:12:51.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya melakukan yang terbaik\Ndan menunjukkan pesonanya.
Dialogue: 0,0:12:51.50,0:12:53.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oleh karena itu...
Dialogue: 0,0:12:56.38,0:13:01.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dua Idola Iblis yang memeriahkan turnamen ini\Nlayak mendapat penghargaan MVA.
Dialogue: 0,0:13:01.80,0:13:04.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kepada Most Valuable Akudol,\NIdola Iblis Paling Berharga,
Dialogue: 0,0:13:04.47,0:13:08.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami ingin memberikan penghargaan\Nterpisah dari pemenang turnamen ini!
Dialogue: 0,0:13:09.31,0:13:14.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Turnamen ini seakan\Ndigelar khusus untuk mereka!
Dialogue: 0,0:13:14.90,0:13:17.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong beri tepuk tangan yang meriah!
Dialogue: 0,0:13:17.40,0:13:20.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inilah Diva Rakus dan Diva Sombong!
Dialogue: 0,0:13:21.16,0:13:25.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gyari dan Kuromu!
Dialogue: 0,0:13:25.70,0:13:27.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Lo?\N- Nona Gyari tidak ada?
Dialogue: 0,0:13:28.45,0:13:32.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah ada masalah?\NGyari tidak menampakkan dirinya!
Dialogue: 0,0:13:34.21,0:13:37.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Po-Pokoknya!\NSelamat, Kuromu!
Dialogue: 0,0:13:37.71,0:13:38.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini.
Dialogue: 0,0:13:44.22,0:13:48.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, mari kembali ke topik utama!\NWaktunya mengumumkan tim yang menang!
Dialogue: 0,0:13:50.48,0:13:53.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pencapaian luar biasa\Ndi tiap pertandingan!
Dialogue: 0,0:13:53.23,0:13:57.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka memikat kita dengan\Nkejutan dan kemampuan nyata!
Dialogue: 0,0:13:57.61,0:14:01.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tim Idola Iblis terbaik\Nyang tidak terbantahkan!
Dialogue: 0,0:14:01.11,0:14:03.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemenangnya adalah...
Dialogue: 0,0:14:03.61,0:14:06.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tim Devimuse!
Dialogue: 0,0:14:06.99,0:14:08.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Devimuse!
Dialogue: 0,0:14:08.62,0:14:11.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kuromu!\N- Selamat!
Dialogue: 0,0:14:12.58,0:14:14.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Irumichi menang! Hore!
Dialogue: 0,0:14:14.54,0:14:17.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Beliau bahkan ada di puncak dunia Idola Iblis!\N- Hore! Hebat! Hebat!
Dialogue: 0,0:14:17.54,0:14:19.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Nona Irumi memang hebat!\N- Hore! Hebat! Hebat!
Dialogue: 0,0:14:19.59,0:14:24.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iruma luar biasa!\NKakek terharu!
Dialogue: 0,0:14:30.06,0:14:32.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita berhasil menang.
Dialogue: 0,0:14:32.14,0:14:34.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus bilang apa ke Ayah...
Dialogue: 0,0:14:34.60,0:14:36.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kita berhasil, ya, Kuromu!
Dialogue: 0,0:14:36.73,0:14:38.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita menang, lo!
Dialogue: 0,0:14:38.69,0:14:41.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya! Kita berhasil!
Dialogue: 0,0:14:41.19,0:14:43.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini berkat kalian semua!
Dialogue: 0,0:14:43.11,0:14:44.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini berkat kita semua!
Dialogue: 0,0:14:44.91,0:14:46.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih atas kerja kerasnya!
Dialogue: 0,0:14:46.91,0:14:51.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, mari dengarkan sepatah kata\Ndari Kuromu sebagai perwakilan tim!
Dialogue: 0,0:14:52.50,0:14:53.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:14:57.96,0:14:58.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku—
Dialogue: 0,0:15:20.11,0:15:21.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuromu.
Dialogue: 0,0:15:25.07,0:15:29.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya fokus\Nmengembangkan diriku sendiri
Dialogue: 0,0:15:29.58,0:15:33.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan mengabaikan perkembanganmu.
Dialogue: 0,0:15:33.45,0:15:37.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sungguh bodoh.
Dialogue: 0,0:15:38.17,0:15:41.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu memang wanita terbaik.
Dialogue: 0,0:15:42.67,0:15:45.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku pasti akan membuatmu\Nberpaling padaku.
Dialogue: 0,0:15:50.80,0:15:52.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku suka kamu.
Dialogue: 0,0:16:01.19,0:16:02.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu itu.
Dialogue: 0,0:16:13.70,0:16:16.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tepuk tangan ucapan selamat, ya?\NAku pasti akan membahagiakannya!
Dialogue: 0,0:16:16.87,0:16:20.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei! Kenapa kamu\Nmalah datang terlambat?
Dialogue: 0,0:16:20.00,0:16:22.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah jelas, kan?
Dialogue: 0,0:16:29.59,0:16:32.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus menyiapkan\Nperayaan untuk kemenanganmu.
Dialogue: 0,0:16:35.81,0:16:38.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, cepat beri sepatah kata!
Dialogue: 0,0:16:42.27,0:16:43.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya.
Dialogue: 0,0:16:44.32,0:16:50.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat berterima kasih karena\Ntelah mendukung kami hari ini.
Dialogue: 0,0:16:50.11,0:16:53.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Idola Iblis berjuang untuk membuat\Nsemua orang tersenyum.
Dialogue: 0,0:16:53.83,0:16:57.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka sangat berkilauan\Ndan merupakan sosok yang dikagumi.
Dialogue: 0,0:16:57.70,0:17:00.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat kalian merasa sedih,
Dialogue: 0,0:17:00.96,0:17:03.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}saat serasa tak bisa bergerak\Ndi tempat yang gelap,
Dialogue: 0,0:17:03.75,0:17:07.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}saat merasa bimbang,\Naku ingin jadi cahaya harapan kalian.
Dialogue: 0,0:17:08.33,0:17:12.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah tugasku!\NKarena itulah ambisiku!
Dialogue: 0,0:17:13.76,0:17:19.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan kalah dari siapa pun\Ndan jadi Idola Iblis terbaik yang berkilauan!
Dialogue: 0,0:17:30.28,0:17:31.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita berhasil, ya.
Dialogue: 0,0:17:31.74,0:17:33.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita menang!
Dialogue: 0,0:17:33.49,0:17:34.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hore!
Dialogue: 0,0:17:34.28,0:17:36.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar.
Dialogue: 0,0:17:36.79,0:17:39.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu pernyataan yang luar biasa.
Dialogue: 0,0:17:41.79,0:17:44.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tahun depan, tim ini juga akan tampil!
Dialogue: 0,0:17:44.08,0:17:45.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:17:45.04,0:17:47.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemenang Turnamen Olahraga Idola Iblis,
Dialogue: 0,0:17:47.71,0:17:49.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tim Devimuse.
Dialogue: 0,0:17:55.72,0:18:00.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tujuan utama turnamen\Nolahraga ini diadakan adalah
Dialogue: 0,0:18:00.48,0:18:03.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk merayakan pergantian\Nke bulan ketiga belas!
Dialogue: 0,0:18:04.06,0:18:06.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai hitungan mundur\Nmenuju bulan ketiga belas dimulai,
Dialogue: 0,0:18:06.94,0:18:09.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}para Idola Iblis memulihkan diri\Ndari kelelahan pertandingan sengit,
Dialogue: 0,0:18:09.78,0:18:13.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}para penonton pun menyaksikan\Nmomen santai mereka.
Dialogue: 0,0:18:13.82,0:18:15.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, maju sana.
Dialogue: 0,0:18:15.74,0:18:17.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya.
Dialogue: 0,0:18:17.16,0:18:17.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu...
Dialogue: 0,0:18:17.95,0:18:20.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat atas kemenangannya!
Dialogue: 0,0:18:20.33,0:18:22.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Irumi.
Dialogue: 0,0:18:22.50,0:18:23.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:18:23.75,0:18:24.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, ya.
Dialogue: 0,0:18:26.34,0:18:27.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ke-Kerennya!\N- Hei, aku mau tambah.
Dialogue: 0,0:18:27.67,0:18:28.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Keren banget!\N- Hei, aku mau tambah.
Dialogue: 0,0:18:28.88,0:18:29.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tapi, auranya membuat kita sulit mendekat!\N- Hei, aku mau tambah.
Dialogue: 0,0:18:29.92,0:18:31.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tapi, auranya membuat kita sulit mendekat!\N- Kamu ini!
Dialogue: 0,0:18:31.09,0:18:33.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan berkeliaran seenaknya.
Dialogue: 0,0:18:33.59,0:18:37.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sendiri saja\Nsudah sangat menarik perhatian.
Dialogue: 0,0:18:37.85,0:18:41.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, Irumi mode siklus jahat\Npenuh percaya diri dan luar biasa, ya!
Dialogue: 0,0:18:41.77,0:18:43.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku masih malu-malu.
Dialogue: 0,0:18:43.64,0:18:45.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oi, oi.
Dialogue: 0,0:18:45.10,0:18:47.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga malu banget, tahu!
Dialogue: 0,0:18:47.52,0:18:48.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serius?
Dialogue: 0,0:18:48.40,0:18:50.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin sembunyi dalam selimut\Ndan duduk di pojokan!
Dialogue: 0,0:18:50.86,0:18:53.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Telingamu benaran agak memerah!
Dialogue: 0,0:18:53.36,0:18:55.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal kamu semangat banget\Nwaktu tampil!
Dialogue: 0,0:18:55.53,0:18:57.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku terbawa suasana...
Dialogue: 0,0:18:57.16,0:18:58.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah...
Dialogue: 0,0:18:58.37,0:19:03.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan berusaha sebaik mungkin\Nuntuk memahami hobimu!
Dialogue: 0,0:19:04.12,0:19:06.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tapi, enak banget, ya.\N- Tunggu dulu, Kak Merie.
Dialogue: 0,0:19:06.00,0:19:07.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Penggemarmu banyak.\N- Kamu salah paham.
Dialogue: 0,0:19:07.13,0:19:10.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ada yang ngobrol denganmu juga, lo.\N- Ja-Jangan waspada begitu.
Dialogue: 0,0:19:10.13,0:19:12.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beeber!
Dialogue: 0,0:19:13.13,0:19:15.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo makan bersama, Lindy.
Dialogue: 0,0:19:15.63,0:19:19.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski kalah saat Tarik Tambang Ekor,\Naku tidak akan kalah tahun depan!
Dialogue: 0,0:19:19.12,0:19:20.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silau!
Dialogue: 0,0:19:20.01,0:19:21.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baru pertama bertemu iblis sepertimu!
Dialogue: 0,0:19:21.89,0:19:23.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bisa, aku ingin\Nmengobrol lebih denganmu!
Dialogue: 0,0:19:23.77,0:19:24.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, terima kasih!
Dialogue: 0,0:19:24.68,0:19:27.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu menolak ajakanku?\NKamu anak yang unik, ya.
Dialogue: 0,0:19:27.52,0:19:28.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oi.
Dialogue: 0,0:19:28.52,0:19:30.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tidak nyaman, tuh.
Dialogue: 0,0:19:31.07,0:19:35.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jarang sekali kamu ikut campur begini.
Dialogue: 0,0:19:35.99,0:19:37.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak juga.
Dialogue: 0,0:19:37.07,0:19:40.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suasana macam apa ini?\NOgah banget!
Dialogue: 0,0:19:40.03,0:19:41.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan mundur kali ini.
Dialogue: 0,0:19:41.91,0:19:43.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya menyuruhmu berhenti
Dialogue: 0,0:19:43.20,0:19:44.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- membuatnya tidak nyaman.\N- Hei, Irumi.
Dialogue: 0,0:19:44.37,0:19:46.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kehadiranmu membuatnya tidak nyaman!\N- Hei, Irumi.
Dialogue: 0,0:19:46.04,0:19:51.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik saat insiden Chima maupun saat tampil,\Naku banyak dibantu olehmu, ya.
Dialogue: 0,0:19:52.42,0:19:56.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang bisa bergantung padamu.
Dialogue: 0,0:19:56.80,0:19:58.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:20:00.97,0:20:02.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:20:02.56,0:20:06.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf seenaknya menyentuhmu.\NKupikir kamu tampak imut.
Dialogue: 0,0:20:06.69,0:20:08.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Imut?
Dialogue: 0,0:20:08.06,0:20:10.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhenti!
Dialogue: 0,0:20:10.94,0:20:14.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kenapa kalian bermesraan tanpa seizinku?\N- Gya-Gyari?
Dialogue: 0,0:20:14.86,0:20:16.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duh, jangan seenaknya—
Dialogue: 0,0:20:16.32,0:20:20.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu, kok.\NIrumi itu wanita yang cantik.
Dialogue: 0,0:20:20.20,0:20:23.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku paham kenapa Kuromu\Nmemutuskan menikahimu.
Dialogue: 0,0:20:23.03,0:20:24.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, itu...
Dialogue: 0,0:20:24.49,0:20:25.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi...
Dialogue: 0,0:20:26.96,0:20:30.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan jadikan kamu istriku juga.
Dialogue: 0,0:20:33.00,0:20:35.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku telah menyadari sesuatu.
Dialogue: 0,0:20:35.80,0:20:39.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Kuromu akan menikahimu,\Naku cukup rebut saja dirimu!
Dialogue: 0,0:20:39.97,0:20:41.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja istri asliku tetap Kuromu!
Dialogue: 0,0:20:42.43,0:20:45.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat! Sisi sebelahku kosong!
Dialogue: 0,0:20:45.47,0:20:47.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memang genius!
Dialogue: 0,0:20:47.64,0:20:49.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan ini, masalahnya—
Dialogue: 0,0:20:50.48,0:20:52.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Ada apa, Kuromu?
Dialogue: 0,0:20:52.61,0:20:53.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada.
Dialogue: 0,0:20:53.69,0:20:55.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu marah?
Dialogue: 0,0:20:55.15,0:20:56.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak marah.
Dialogue: 0,0:20:56.53,0:20:57.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa sikapmu berubah?
Dialogue: 0,0:20:57.86,0:20:59.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dari dulu juga begini.
Dialogue: 0,0:20:59.78,0:21:02.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Sepertinya situasinya tambah rumit.\N- Me-Menikah itu cuma bohongan, kan?
Dialogue: 0,0:21:02.20,0:21:03.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Semuanya!\N- Me-Menikah itu cuma bohongan, kan?
Dialogue: 0,0:21:03.49,0:21:06.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hitungan mundurnya segera dimulai, lo!
Dialogue: 0,0:21:06.75,0:21:10.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Turnamen Olahraga tempat\Nbunga-bunga berjatuhan dan berkilauan!
Dialogue: 0,0:21:10.75,0:21:16.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perayaan ini akan terlahir kembali\Nmenjadi perayaan yang lebih besar!
Dialogue: 0,0:21:16.51,0:21:19.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, semuanya, mari hitung bersama!
Dialogue: 0,0:21:19.26,0:21:22.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menuju bulan baru! Lima!
Dialogue: 0,0:21:22.64,0:21:23.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Empat!
Dialogue: 0,0:21:23.89,0:21:25.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiga!
Dialogue: 0,0:21:25.14,0:21:26.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dua!
Dialogue: 0,0:21:27.39,0:21:29.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu!
Dialogue: 0,0:21:32.90,0:21:35.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat bulan tiga belas!
Dialogue: 0,0:21:44.16,0:21:45.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah pagi.
Dialogue: 0,0:21:45.91,0:21:49.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya mimpiku luar biasa sekali.
Dialogue: 0,0:21:49.45,0:21:52.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi Idola Iblis dan menang.
Dialogue: 0,0:21:52.50,0:21:55.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat tahun baru iblis, Iruma!
Dialogue: 0,0:21:55.92,0:21:59.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat ini! Aku coba perbesar!
Dialogue: 0,0:21:59.30,0:22:00.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Poster?
Dialogue: 0,0:22:00.42,0:22:04.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus, kami juga punya kipas, handuk,\Ndan rekaman! Pokoknya sempurna!
Dialogue: 0,0:22:04.51,0:22:05.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, kan?
Dialogue: 0,0:22:05.85,0:22:06.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:22:07.68,0:22:09.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bentar— Tunggu, itu...
Dialogue: 0,0:22:09.77,0:22:13.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Iruma,\Nselamat tahun baru iblis! Permisi!
Dialogue: 0,0:22:13.21,0:22:15.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat tahun baru iblis!\NWaktunya interogasi!
Dialogue: 0,0:22:15.28,0:22:16.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:22:16.19,0:22:18.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama, selamat atas kemenangannya!
Dialogue: 0,0:22:18.94,0:22:21.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, apa maksudnya Anda akan menikah?
Dialogue: 0,0:22:21.03,0:22:21.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tu-Tunggu! Tunggu!
Dialogue: 0,0:22:21.86,0:22:24.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mau! Cepat katakan!\NMakan hidangan Tahun Barunya!
Dialogue: 0,0:22:24.99,0:22:25.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat makan!
Dialogue: 0,0:22:25.87,0:22:28.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nafsu makan yang luar biasa!
Dialogue: 0,0:23:59.75,0:24:02.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tambahan!
Dialogue: 0,0:24:03.63,0:24:06.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga akan tampil\Ndi turnamen olahraga selanjutnya!
Dialogue: 0,0:24:06.51,0:24:07.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga!
Dialogue: 0,0:24:07.43,0:24:08.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:24:08.13,0:24:11.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, anggotanya jadi kebanyakan, ya.
Dialogue: 0,0:24:11.10,0:24:14.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Irumi, Kerori, terus Makka.
Dialogue: 0,0:24:14.93,0:24:20.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku memang harus bakar\NIdola Iblis bernama Lindy itu.
Dialogue: 0,0:24:20.19,0:24:21.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:24:21.19,0:24:22.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu dulu!
Dialogue: 0,0:24:22.44,0:24:26.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya kamu lebih baik kabur\Ndi pergantian bulan tahun ini, Lindy.
Dialogue: 0,0:24:30.49,0:24:33.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang Turnamen Olahraga\NIdola Iblis berakhir tanpa masalah.
Dialogue: 0,0:24:33.28,0:24:35.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak tahu berakhir\Ntanpa masalah atau tidak, sih.
Dialogue: 0,0:24:35.62,0:24:39.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kurasa masalah antara\NKuromu dan Gyari sudah mereda,
Dialogue: 0,0:24:39.25,0:24:40.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi semuanya berakhir baik-baik saja.
Dialogue: 0,0:24:40.88,0:24:43.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, Sabnock,\Nbisa minta waktumu sebentar?
Dialogue: 0,0:24:43.59,0:24:46.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin belajar sedikit\Ntentang Raja Iblis.
Dialogue: 0,0:24:46.88,0:24:49.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya, Selamat Datang\Ndi Sekolah Iblis, Iruma.
Dialogue: 0,0:24:49.01,0:24:50.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Jalan Menuju Raja Iblis".
Dialogue: 0,0:24:50.39,0:24:52.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sabnock, kamu mau pulang ke rumahmu?
Dialogue: 0,0:24:52.72,0:24:54.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kira-kira rumahmu seperti apa, ya?
