Dialogue: 0,0:00:08.95,0:00:16.25,sign,,0000,0000,0000,,WELCOME TO DEMON SCHOOL! IRUMA-KUN SEASON 4
Dialogue: 0,0:01:29.99,0:01:30.82,sign,,0000,0000,0000,,KENANGAN PALING MEWAH
Dialogue: 0,0:01:36.24,0:01:39.50,sign,,0000,0000,0000,,DEATH SQUARE
Dialogue: 0,0:01:55.80,0:01:58.85,sign,,0000,0000,0000,,PEMIMPIN AGUNG KLAN BACHIKO
Dialogue: 0,0:06:08.85,0:06:11.85,sign,,0000,0000,0000,,ACARA JABAT TANGAN KUROMU
Dialogue: 0,0:06:51.14,0:06:53.64,sign,,0000,0000,0000,,AKU MENYUKAI SCHNEIDER\NDI ANTARA SEMUA PRIA DI SEKOLAH
Dialogue: 0,0:07:08.20,0:07:10.49,sign,,0000,0000,0000,,PENANGKAPAN SERENTAK
Dialogue: 0,0:10:39.58,0:10:40.58,sign,,0000,0000,0000,,NONA LEVI DARI TIGA AGUNG
Dialogue: 0,0:10:51.55,0:10:53.14,sign,,0000,0000,0000,,PROGRAM PELATIHAN LEI
Dialogue: 0,0:11:15.07,0:11:18.07,sign,,0000,0000,0000,,AMAYMON DARI 13 MAHKOTA
Dialogue: 0,0:11:32.34,0:11:35.67,sign,,0000,0000,0000,,FURFUR SAAT MASIH SEKOLAH
Dialogue: 0,0:12:02.41,0:12:04.91,sign,,0000,0000,0000,,PAIMON DARI 13 MAHKOTA
Dialogue: 0,0:12:16.42,0:12:20.93,sign,,0000,0000,0000,,KUROMU, UNTUK TUAN HAT
Dialogue: 0,0:14:19.17,0:14:21.67,sign,,0000,0000,0000,,SELAMAT TELAH NAIK KE KELAS 2, IRUMA
Dialogue: 0,0:14:22.55,0:14:24.84,sign,,0000,0000,0000,,SELAMAT TELAH NAIK KE KELAS 2, IRUMA
Dialogue: 0,0:16:05.53,0:16:07.49,sign,,0000,0000,0000,,ERAT
Dialogue: 0,0:16:24.34,0:16:26.59,sign,,0000,0000,0000,,UPACARA PENERIMAAN
Dialogue: 0,0:16:34.93,0:16:36.60,sign,,0000,0000,0000,,EITA
Dialogue: 0,0:17:43.33,0:17:46.88,sign,,0000,0000,0000,,HE HE HE HE
Dialogue: 0,0:01:30.82,0:01:33.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Kenangan Paling Mewah".
Dialogue: 0,0:01:34.87,0:01:38.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di tebing curam yang menjulang tinggi,
Dialogue: 0,0:01:38.04,0:01:39.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Death Square.
Dialogue: 0,0:01:39.50,0:01:43.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tepat di hutan di utara,\Nterdapat kediaman klan pemanah.
Dialogue: 0,0:01:43.50,0:01:46.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kediaman klan Barbatos.
Dialogue: 0,0:01:46.63,0:01:47.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekian.
Dialogue: 0,0:01:47.50,0:01:50.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Barbatos Bachiko\Ntelah menghadiri Thirteen's Dinner
Dialogue: 0,0:01:50.97,0:01:53.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan berhasil menyelesaikan tugasnya.
Dialogue: 0,0:01:55.80,0:01:58.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus, Bachiko.
Dialogue: 0,0:01:58.85,0:02:01.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rencana Trickster.
Dialogue: 0,0:02:01.48,0:02:05.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rencana untuk memilih dan melatih\Nkandidat Raja Iblis selanjutnya.
Dialogue: 0,0:02:05.48,0:02:09.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dunia iblis akan mengalami\Nbeberapa perubahan besar, ya.
Dialogue: 0,0:02:09.86,0:02:12.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai bagian dari klan Barbatos,
Dialogue: 0,0:02:12.78,0:02:17.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita harus mengasah diri\Nuntuk menghadapi segala yang akan terjadi.
Dialogue: 0,0:02:17.83,0:02:18.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:02:18.62,0:02:23.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, sesuatu yang menarik\Nterjadi tempo hari lalu.
Dialogue: 0,0:02:23.12,0:02:24.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh?
Dialogue: 0,0:02:24.50,0:02:29.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu mungkin jadi kunci penting\Nbagi masa depan klan kita.
Dialogue: 0,0:02:32.42,0:02:35.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tim Devimuse, Irumi!
Dialogue: 0,0:02:36.18,0:02:37.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu belum lihat, Bachiko?
Dialogue: 0,0:02:37.80,0:02:40.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, itu, aku sibuk dengan\Nperihal Thirteen's Dinner...
Dialogue: 0,0:02:40.26,0:02:42.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kata anak muda zaman sekarang...
Dialogue: 0,0:02:42.18,0:02:44.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia imut banget!
Dialogue: 0,0:02:44.14,0:02:45.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemimpin Agung?
Dialogue: 0,0:02:45.69,0:02:48.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terutama, gadis bernama Irumi ini.
Dialogue: 0,0:02:48.67,0:02:50.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata dia seorang pemanah!
Dialogue: 0,0:02:50.78,0:02:54.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemampuan mengendalikan anak panah\Nyang mengesankan untuk anak muda!
Dialogue: 0,0:02:54.65,0:02:59.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bukan orang dari klan Barbatos,\Ntapi kamu tahu sesuatu, Bachiko?
Dialogue: 0,0:03:00.37,0:03:03.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.\NApa pun yang terjadi...
Dialogue: 0,0:03:03.04,0:03:06.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin gadis itu menikah\Ndengan seseorang dari klan kita.
Dialogue: 0,0:03:07.04,0:03:10.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tidak bisa mengabaikan\Norang sepertinya!
Dialogue: 0,0:03:10.42,0:03:14.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah bagaimana,\Naku ingin dia jadi anggota klan Barbatos.
Dialogue: 0,0:03:16.01,0:03:19.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau dengan Robin\Ndari keluarga cabang?
Dialogue: 0,0:03:19.30,0:03:20.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon tunggu dulu!
Dialogue: 0,0:03:20.35,0:03:22.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan saja soal itu pada saya!
Dialogue: 0,0:03:22.72,0:03:25.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya. Segera bawa dia ke sini\Nsetelah menemukannya.
Dialogue: 0,0:03:25.81,0:03:26.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap!
Dialogue: 0,0:03:26.81,0:03:29.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya pergi dulu!
Dialogue: 0,0:03:31.44,0:03:34.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oi, murid bodoh.
Dialogue: 0,0:03:36.36,0:03:38.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak hanya tampil mencolok\Ndi hadapan seluruh negeri!
Dialogue: 0,0:03:38.87,0:03:41.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bahkan menggunakan\Npanah sebagai Irumi!
Dialogue: 0,0:03:41.12,0:03:43.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu lupa kalau kamu manusia?
Dialogue: 0,0:03:43.62,0:03:45.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagian, apa-apaan teknik itu?
Dialogue: 0,0:03:45.54,0:03:47.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mencoba meniru lagi!
Dialogue: 0,0:03:47.67,0:03:49.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku.
Dialogue: 0,0:03:49.25,0:03:52.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya, kalau pakai\Nbaju berenda-renda dan lembut,
Dialogue: 0,0:03:52.46,0:03:54.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jangan pernah pakai panah!\NDemi kebaikanmu!
Dialogue: 0,0:03:54.92,0:03:55.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengerti?
Dialogue: 0,0:03:55.72,0:03:57.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baik!
Dialogue: 0,0:03:58.84,0:04:02.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duh, ditinggal sebentar,\Nkamu langsung buat masalah!
Dialogue: 0,0:04:02.39,0:04:03.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku.
Dialogue: 0,0:04:03.35,0:04:06.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pikirkan juga perasaan gurumu\Nyang punya murid liar sepertimu!
Dialogue: 0,0:04:08.35,0:04:13.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar, aku jadi tidak bisa\Nmemberimu hadiah dengan tenang!
Dialogue: 0,0:04:13.65,0:04:14.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:04:15.99,0:04:17.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:04:17.74,0:04:21.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master! Kamu punya hadiah untukku?
Dialogue: 0,0:04:21.52,0:04:22.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Du-Duduk!
Dialogue: 0,0:04:22.78,0:04:23.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:04:34.21,0:04:35.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu...
Dialogue: 0,0:04:36.26,0:04:40.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu memang liar\Ndan banyak membuat masalah.
Dialogue: 0,0:04:40.59,0:04:43.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kamu berhasil berprestasi\Nsaat Festival Panen.
Dialogue: 0,0:04:43.85,0:04:48.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu juga menang di Festival Musik\Ndan naik jadi peringkat He!
Dialogue: 0,0:04:48.27,0:04:51.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oleh karena itu...
Dialogue: 0,0:04:52.77,0:04:55.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai tanda apresiasi...
Dialogue: 0,0:04:57.40,0:04:59.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudku!
Dialogue: 0,0:05:00.66,0:05:02.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat muridnya berhasil,
Dialogue: 0,0:05:02.82,0:05:06.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mustahil ada guru yang tidak bahagia!
Dialogue: 0,0:05:18.30,0:05:20.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lelah sekali.
Dialogue: 0,0:05:20.13,0:05:23.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita sudah banyak bergerak seharian ini, ya.
Dialogue: 0,0:05:30.23,0:05:32.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang Master lakukan?
Dialogue: 0,0:05:35.61,0:05:37.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ketemu!\N- Ada apa, sih?
Dialogue: 0,0:05:37.32,0:05:39.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ketemu!\N- Apa Master sedang tersesat?
Dialogue: 0,0:05:39.36,0:05:41.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, lama tidak jumpa!
Dialogue: 0,0:05:41.86,0:05:43.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada urusan apa Master ke sini?
Dialogue: 0,0:05:43.99,0:05:47.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu...
Dialogue: 0,0:05:47.12,0:05:50.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belum pernah mengatakannya langsung,
Dialogue: 0,0:05:50.91,0:05:53.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi aku berpikir harus\Nmengatakannya langsung.
Dialogue: 0,0:05:54.04,0:05:59.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bersyukur murid pertamaku\Nadalah kalian berdua.
Dialogue: 0,0:06:03.18,0:06:07.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu...
Dialogue: 0,0:06:08.85,0:06:11.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Anu, Kuromu.
Dialogue: 0,0:06:11.85,0:06:15.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu akan tampil bersama Irumi lagi?
Dialogue: 0,0:06:17.32,0:06:21.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal ada aku di hadapanmu,\Nkamu malah membicarakan gadis lain?
Dialogue: 0,0:06:22.15,0:06:25.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku! Imut banget!
Dialogue: 0,0:06:25.32,0:06:26.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak!
Dialogue: 0,0:06:26.74,0:06:28.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Sampai jumpa.\N- Boleh minta tanda tangannya?
Dialogue: 0,0:06:28.78,0:06:29.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:06:29.74,0:06:32.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong tulis untuk "Tuan Hat".
Dialogue: 0,0:06:33.66,0:06:35.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, tarian yang unik.
Dialogue: 0,0:06:36.21,0:06:40.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maukah kamu mengobrol dengan\Npenggemarmu ini?
Dialogue: 0,0:06:40.38,0:06:42.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ratu Kuromu.
Dialogue: 0,0:06:43.38,0:06:45.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya punya teh biasa...
Dialogue: 0,0:06:45.84,0:06:46.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan...
Dialogue: 0,0:06:46.89,0:06:50.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}suvenir saja.
Dialogue: 0,0:06:54.14,0:06:55.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sulit.
Dialogue: 0,0:06:57.69,0:07:01.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa tidak?\NKalau suka, langsung saja!
Dialogue: 0,0:07:01.11,0:07:02.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu?
Dialogue: 0,0:07:02.23,0:07:03.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:07:08.20,0:07:10.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duh, kenapa kalian langsung kabur?
Dialogue: 0,0:07:10.49,0:07:13.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kita bakal dijual!\N- Reaksi kalian sama, ya!
Dialogue: 0,0:07:13.16,0:07:15.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong kami!
Dialogue: 0,0:07:15.08,0:07:16.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Darurat!
Dialogue: 0,0:07:19.67,0:07:22.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuis Dua Pilihan yang Mendebarkan!
Dialogue: 0,0:07:22.67,0:07:25.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada hadiah di salah satu kotaknya, lo!
Dialogue: 0,0:07:25.05,0:07:26.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Hadiah?\N- Hadiah?
Dialogue: 0,0:07:26.72,0:07:28.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau berhasil menebak,\Nkalian dapat hadiah!
Dialogue: 0,0:07:28.59,0:07:31.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, aku akan menuruti\Napa pun permintaan kalian!
Dialogue: 0,0:07:31.81,0:07:32.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Apa pun?\N- Apa pun?
Dialogue: 0,0:07:34.06,0:07:39.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kalau salah, kalian harus beli\Nhadiah ini dengan harga tinggi.
Dialogue: 0,0:07:39.61,0:07:40.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau coba?
Dialogue: 0,0:07:40.31,0:07:41.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja!
Dialogue: 0,0:07:41.90,0:07:43.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesuai permintaanmu!
Dialogue: 0,0:07:43.44,0:07:45.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ayo!\N- Ayo!
Dialogue: 0,0:07:45.49,0:07:47.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami adalah master kalian.
Dialogue: 0,0:07:47.78,0:07:51.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat muridnya berprestasi,\Nsebagai seorang guru,
Dialogue: 0,0:07:51.91,0:07:55.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami wajib memuji kalian.
Dialogue: 0,0:07:55.41,0:07:57.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu...
Dialogue: 0,0:07:59.88,0:08:02.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu terlihat cocok untukmu.
Dialogue: 0,0:08:02.92,0:08:06.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat atas kenaikan peringkatmu.
Dialogue: 0,0:08:06.05,0:08:07.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iruma.
Dialogue: 0,0:08:08.01,0:08:10.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak, Master.
Dialogue: 0,0:08:20.52,0:08:22.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya, pagi!
Dialogue: 0,0:08:22.90,0:08:24.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pagi!
Dialogue: 0,0:08:24.53,0:08:26.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Pagi.\N- Selamat pagi.
Dialogue: 0,0:08:26.86,0:08:27.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat pagi.
Dialogue: 0,0:08:27.95,0:08:29.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Selamat pagi.\N- Pagi.
Dialogue: 0,0:08:29.53,0:08:31.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo?
Dialogue: 0,0:08:31.03,0:08:34.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya kalian semua terlihat beda.
Dialogue: 0,0:08:34.03,0:08:36.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini hadiah dari master kami.
Dialogue: 0,0:08:36.53,0:08:38.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master bisa menangis\Nkalau tidak kami pakai.
Dialogue: 0,0:08:38.50,0:08:40.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Bandana! Bandana!\N- Indahnya!
Dialogue: 0,0:08:40.71,0:08:43.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anting Tuan Iruma juga tidak kalah indah!
Dialogue: 0,0:08:43.34,0:08:44.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlihat sangat luar biasa!
Dialogue: 0,0:08:44.71,0:08:47.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian berdua, terima kasih...
Dialogue: 0,0:08:47.67,0:08:49.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo?
Dialogue: 0,0:08:49.01,0:08:50.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, Clara Bodoh!
Dialogue: 0,0:08:50.89,0:08:53.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kenapa kamu pakai cincin yang sama denganku?\N- Azz-Azz, kamu kembaran sama aku!
Dialogue: 0,0:08:53.76,0:08:55.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah!
Dialogue: 0,0:08:55.01,0:09:00.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu juga dapat cincin itu\Ndari Master Raim, Asmodeus?
Dialogue: 0,0:09:00.02,0:09:03.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dapat dari ibuku.\NKatanya aku harus dipakai.
Dialogue: 0,0:09:04.77,0:09:07.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hadiahmu juga bagus, ya, Saburo.\NMengilap, gitu.
Dialogue: 0,0:09:07.44,0:09:09.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini oleh-oleh dari pamanku.
Dialogue: 0,0:09:10.99,0:09:12.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa dengan kalian berdua?
Dialogue: 0,0:09:12.99,0:09:16.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia membuat kami membelinya.\NSi jenderal sialan itu.
Dialogue: 0,0:09:16.04,0:09:18.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}60.000 vils...\NUang sakuku ludes...
Dialogue: 0,0:09:18.62,0:09:21.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita juga kembaran, ya!
Dialogue: 0,0:09:21.08,0:09:22.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya.
Dialogue: 0,0:09:22.08,0:09:25.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana denganmu, Soisoi?\NItu dari orang tuamu?
Dialogue: 0,0:09:25.00,0:09:27.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi pagi...
Dialogue: 0,0:09:37.39,0:09:41.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Terimalah hadiah kenaikan kelasmu\Ndengan senang hati."
Dialogue: 0,0:09:41.56,0:09:44.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Dari anonim,\Nsang Venus Cinta dan Musik."
Dialogue: 0,0:09:44.73,0:09:46.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be-Begitu rupanya.
Dialogue: 0,0:09:46.15,0:09:50.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enaknya!\NAku tadi tiba-tiba dilempari ini!
Dialogue: 0,0:09:50.61,0:09:52.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oi!
Dialogue: 0,0:09:52.70,0:09:53.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oper!
Dialogue: 0,0:09:53.86,0:09:55.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:09:55.24,0:09:56.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}O-Oh...
Dialogue: 0,0:09:56.91,0:09:58.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lempar...
Dialogue: 0,0:09:58.12,0:09:59.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tangkap?
Dialogue: 0,0:09:59.25,0:10:02.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya dapat hadiah dari master\Ndan keluarganya, ya!
Dialogue: 0,0:10:02.50,0:10:03.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa tiba-tiba?
Dialogue: 0,0:10:03.62,0:10:06.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Secara bersamaan pula!\NAda yang aneh.
Dialogue: 0,0:10:06.88,0:10:08.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:10:08.50,0:10:09.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:10:10.05,0:10:11.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:10:11.76,0:10:14.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetap saja bikin senang, ya!
Dialogue: 0,0:10:20.27,0:10:24.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, wajar seorang murid dipuji\Nkalau berprestasi!
Dialogue: 0,0:10:24.35,0:10:27.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski tingkahnya begitu,\Nmereka mengakui kita, ya?
Dialogue: 0,0:10:27.98,0:10:30.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar! Mereka tidak bisa jujur, ya!
Dialogue: 0,0:10:30.53,0:10:34.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka pasti percaya dan menaruh\Nharapan besar pada kita!
Dialogue: 0,0:10:37.58,0:10:40.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu benar menolak?
Dialogue: 0,0:10:40.58,0:10:41.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Vepar?
Dialogue: 0,0:10:42.58,0:10:43.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:10:43.54,0:10:45.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayang sekali.
Dialogue: 0,0:10:45.62,0:10:48.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal kamu sangat berbakat!
Dialogue: 0,0:10:48.84,0:10:51.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu juga salah satu murid terbaikku!
Dialogue: 0,0:10:51.55,0:10:53.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal kupikir kamu adalah
Dialogue: 0,0:10:53.14,0:10:55.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}master yang tepat untuk Leiji.
Dialogue: 0,0:10:55.80,0:10:59.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maafkan aku.\NTa-Tapi...
Dialogue: 0,0:10:59.56,0:11:02.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengajar juga penting,
Dialogue: 0,0:11:02.35,0:11:05.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi yang paling dibutuhkan\Nadalah lawan bersaing!
Dialogue: 0,0:11:06.06,0:11:07.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi...
Dialogue: 0,0:11:07.73,0:11:13.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bolehkah aku menyarankan muridku\Nsebagai kandidat rival Leiji?
Dialogue: 0,0:11:13.57,0:11:15.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:11:15.07,0:11:18.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu menolak mengajar cucunya?
Dialogue: 0,0:11:18.07,0:11:19.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:11:19.07,0:11:20.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Ya"?
Dialogue: 0,0:11:20.58,0:11:22.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa tidak jadi masalah?
Dialogue: 0,0:11:22.22,0:11:24.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah itu perintah langsung\Ndari Tuan Belial?
Dialogue: 0,0:11:24.79,0:11:27.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benci bocah itu, sih.
Dialogue: 0,0:11:27.92,0:11:30.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bisa apa saja.\NSama sekali tidak imut.
Dialogue: 0,0:11:30.67,0:11:31.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu ini...
Dialogue: 0,0:11:32.34,0:11:33.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu berutang padanya karena
Dialogue: 0,0:11:33.96,0:11:35.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}telah merawatmu di Jackapo, kan?
Dialogue: 0,0:11:36.22,0:11:42.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil! Si kakek sialan itu menguras\Nuangku dengan bilang itu hukuman!
Dialogue: 0,0:11:42.81,0:11:44.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu...
Dialogue: 0,0:11:45.06,0:11:48.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sibuk mencari mainan baru.
Dialogue: 0,0:11:48.69,0:11:51.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan tentukan mainanku sendiri.
Dialogue: 0,0:11:59.74,0:12:02.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sekarang sedang sibuk, ya?
Dialogue: 0,0:12:04.91,0:12:08.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu benar-benar pelayan yang egois, ya.
Dialogue: 0,0:12:08.92,0:12:10.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hat.
Dialogue: 0,0:12:10.33,0:12:14.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya sangat ingin menuruti\Nperintah dari Anda.
Dialogue: 0,0:12:14.99,0:12:16.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:12:16.42,0:12:20.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah terlibat dalam hal yang serupa.
Dialogue: 0,0:12:35.65,0:12:37.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:12:38.11,0:12:42.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menaikkan murid sekelas\Nke peringkat Daleth di Babyls...
Dialogue: 0,0:12:42.03,0:12:44.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh percobaan yang menarik.
Dialogue: 0,0:12:45.12,0:12:46.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi...
Dialogue: 0,0:12:49.29,0:12:52.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah mereka layak?
Dialogue: 0,0:12:53.38,0:12:56.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa "semangat"\Ndan "kemampuan" mereka layak
Dialogue: 0,0:12:57.84,0:13:00.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk mengemban masa depan dunia iblis?
Dialogue: 0,0:13:06.43,0:13:08.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka...
Dialogue: 0,0:13:08.93,0:13:12.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Punya bakat untuk menikmati kesulitan.
Dialogue: 0,0:13:12.31,0:13:16.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makin kulihat sisi liar mereka,
Dialogue: 0,0:13:17.11,0:13:21.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}makin ingin kudidik mereka.
Dialogue: 0,0:13:22.91,0:13:28.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guru macam apa yang tidak\Nberharap tinggi pada muridnya?
Dialogue: 0,0:13:29.33,0:13:33.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus tahu seberapa jauh\Nmereka bisa melampaui batas mereka.
Dialogue: 0,0:13:33.21,0:13:35.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memikirkannya saja\Nsudah membuatku bersemangat.
Dialogue: 0,0:13:35.88,0:13:37.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kedengaran menyenangkan.
Dialogue: 0,0:13:37.38,0:13:42.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena telah jadi murid kami,\Nmereka tidak akan bisa hidup damai.
Dialogue: 0,0:13:43.68,0:13:49.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi ingin melihat wajah para iblis\Nyang membuat kalian begitu terobsesi.
Dialogue: 0,0:13:49.02,0:13:51.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja.
Dialogue: 0,0:13:51.64,0:13:56.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sip! Ayo adakan pesta\Nuntuk kenaikan kelas kita!
Dialogue: 0,0:13:56.15,0:14:01.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agar bisa langsung dikenali\Ndi mana pun mereka berada,
Dialogue: 0,0:14:01.70,0:14:05.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami memberi mereka "tanda".
Dialogue: 0,0:14:09.58,0:14:12.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menuju ke tahun kedua!
Dialogue: 0,0:14:12.00,0:14:14.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:14:24.84,0:14:27.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya besok kamu naik kelas 2, ya!
Dialogue: 0,0:14:27.76,0:14:28.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita rayakan hari ini!
Dialogue: 0,0:14:28.93,0:14:31.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya menggunakan kemampuan saya\Nlebih dari biasanya.
Dialogue: 0,0:14:31.56,0:14:34.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Opera! Kakek!
Dialogue: 0,0:14:36.31,0:14:38.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu...
Dialogue: 0,0:14:39.32,0:14:44.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat berterima kasih atas segalanya\Nselama setahun jadi cucu kakek.
Dialogue: 0,0:14:44.36,0:14:47.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon bantuannya ke depannya!
Dialogue: 0,0:14:47.32,0:14:50.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iruma!
Dialogue: 0,0:14:50.33,0:14:54.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja!\NKakek juga mohon bantuannya!
Dialogue: 0,0:14:54.37,0:14:54.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:14:54.87,0:14:55.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon bantuannya!
Dialogue: 0,0:14:55.83,0:14:58.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Opera juga, terima kasih\Nuntuk setahun kemarin!
Dialogue: 0,0:14:58.54,0:14:59.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon bantuan ke depannya, ya!
Dialogue: 0,0:14:59.84,0:15:03.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya! Saya juga mohon bantuannya.
Dialogue: 0,0:15:03.47,0:15:04.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:15:05.22,0:15:07.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Selamat makan!\N- Selamat makan!
Dialogue: 0,0:15:13.23,0:15:17.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benar-benar bahagia.
Dialogue: 0,0:15:18.23,0:15:19.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setahun...
Dialogue: 0,0:15:20.23,0:15:25.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.\NAku baru setahun berada di sini, ya.
Dialogue: 0,0:15:25.74,0:15:29.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak hal yang telah terjadi, ya.
Dialogue: 0,0:15:29.03,0:15:33.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya sangat menyenangkan...
Dialogue: 0,0:15:54.64,0:15:56.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iruma!
Dialogue: 0,0:15:56.52,0:15:58.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai hari ini, kamu murid kelas dua, ya!
Dialogue: 0,0:15:58.94,0:16:01.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seragam barunya sangat cocok\Ndengan Anda.
Dialogue: 0,0:16:01.52,0:16:04.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini kacamata antideteksi.
Dialogue: 0,0:16:04.40,0:16:05.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih!
Dialogue: 0,0:16:05.53,0:16:07.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelukan pengantar!
Dialogue: 0,0:16:07.49,0:16:09.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Irumachi!\N- Peluk!
Dialogue: 0,0:16:09.87,0:16:11.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami datang menjemput Anda!
Dialogue: 0,0:16:11.49,0:16:13.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hati-hati di jalan.
Dialogue: 0,0:16:13.54,0:16:15.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, iya!
Dialogue: 0,0:16:18.04,0:16:19.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berangkat!
Dialogue: 0,0:16:33.60,0:16:36.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah! Jadi ini Babyls!
Dialogue: 0,0:16:36.60,0:16:39.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Besar! Luas!
Dialogue: 0,0:16:39.10,0:16:42.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat banget sampai bikin gugup!
Dialogue: 0,0:16:42.11,0:16:44.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duh, aku harus mengirim pesan!
Dialogue: 0,0:16:44.52,0:16:46.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak, aku baru sampai—
Dialogue: 0,0:16:46.86,0:16:47.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat pagi!
Dialogue: 0,0:16:48.36,0:16:50.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Semuanya, pagi!\N- Selamat pagi!
Dialogue: 0,0:16:50.36,0:16:52.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Murid kelas satu harap segera ke auditorium!\N- Keren!
Dialogue: 0,0:16:52.24,0:16:54.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Murid kelas satu harap segera ke auditorium!\N- Auditorium, ya?
Dialogue: 0,0:16:54.95,0:16:57.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lautan iblis!
Dialogue: 0,0:16:57.12,0:17:00.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin aku bisa mengikuti mereka saja.
Dialogue: 0,0:17:01.12,0:17:04.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kupikir begitu, sih.
Dialogue: 0,0:17:04.96,0:17:07.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku malah makin menjauh!
Dialogue: 0,0:17:07.83,0:17:10.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka semua mau ke mana?
Dialogue: 0,0:17:12.68,0:17:13.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat!
Dialogue: 0,0:17:13.84,0:17:15.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Indah!\N- Mewah banget!
Dialogue: 0,0:17:15.56,0:17:17.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu Royal One!
Dialogue: 0,0:17:17.56,0:17:19.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ro-Royal One?
Dialogue: 0,0:17:19.81,0:17:21.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Royal One.
Dialogue: 0,0:17:21.44,0:17:26.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu adalah wilayah tidak terjamah\Ndi Babyls dan warisan Raja Iblis.
Dialogue: 0,0:17:26.60,0:17:30.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, pintu itu saat ini terbuka lebar.
Dialogue: 0,0:17:31.36,0:17:37.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dibuka oleh kelas abnormal yang dipimpin\Ncucu kepsek berperingkat He, Iruma.
Dialogue: 0,0:17:37.87,0:17:39.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kak Iruma...\N- Keren!
Dialogue: 0,0:17:39.04,0:17:40.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kak Iruma...\N- Apa mereka ada di dalam?
Dialogue: 0,0:17:40.62,0:17:43.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia iblis seperti apa, ya?
Dialogue: 0,0:17:43.33,0:17:46.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pasti iblis mengerikan yang penuh wibawa!
Dialogue: 0,0:17:46.88,0:17:52.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Murid kelas abnormal pasti berprestasi,\Ncerdas, dan berperilaku—
Dialogue: 0,0:17:58.52,0:18:00.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ramai juga, ya!
Dialogue: 0,0:18:00.98,0:18:04.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, caramu mendarat kasar banget, Saburo.
Dialogue: 0,0:18:05.52,0:18:06.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu para murid kelas abnormal!
Dialogue: 0,0:18:06.90,0:18:08.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat banget!
Dialogue: 0,0:18:08.03,0:18:09.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Sabnock gede banget!
Dialogue: 0,0:18:09.44,0:18:10.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada Kak Allocer!
Dialogue: 0,0:18:10.86,0:18:12.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Raja Pengetahuan!
Dialogue: 0,0:18:12.53,0:18:13.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu Kak Andro!
Dialogue: 0,0:18:13.57,0:18:14.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keren!
Dialogue: 0,0:18:14.66,0:18:16.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, dompetku hilang?
Dialogue: 0,0:18:16.28,0:18:17.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pixie!
Dialogue: 0,0:18:17.41,0:18:18.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menghilang?
Dialogue: 0,0:18:18.41,0:18:20.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada Raja Muda juga, lo!
Dialogue: 0,0:18:20.04,0:18:21.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kebanyakan nyengir.
Dialogue: 0,0:18:21.54,0:18:23.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kebanyakan mencuri.
Dialogue: 0,0:18:23.04,0:18:25.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat! Aku mau lihat—
Dialogue: 0,0:18:25.92,0:18:27.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yak, minggir.
Dialogue: 0,0:18:27.79,0:18:29.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ta-Tanahnya?
Dialogue: 0,0:18:29.50,0:18:30.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Agares?
Dialogue: 0,0:18:30.96,0:18:33.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, jangan kasar dengan anak kelas satu!
Dialogue: 0,0:18:38.56,0:18:39.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Aku tiba-tiba pusing...\N- Cantik sekali.
Dialogue: 0,0:18:39.89,0:18:41.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Aku tiba-tiba pusing...\N- Aromanya harum.
Dialogue: 0,0:18:43.19,0:18:46.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong hentikan.
Dialogue: 0,0:18:46.19,0:18:48.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Aku hanya ingin mengenal para murid baru...\N- Sihir es yang indah!
Dialogue: 0,0:18:48.15,0:18:49.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Aku hanya ingin mengenal para murid baru...\N- Ra-Ratu...
Dialogue: 0,0:18:49.69,0:18:51.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ta-Tapi, dingin sekali.
Dialogue: 0,0:18:51.57,0:18:53.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yo, murid kelas satu!
Dialogue: 0,0:18:53.74,0:18:56.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian bakal kena flu\Nkalau diam saja, lo!
Dialogue: 0,0:18:56.11,0:18:57.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini!
Dialogue: 0,0:18:58.24,0:19:01.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penghangat perut dan topi pompom!
Dialogue: 0,0:19:01.16,0:19:03.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian bawa sapu tangan dan tisu, kan?
Dialogue: 0,0:19:03.41,0:19:06.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ada yang tidak dimengerti,\Ntanyakan saja pada kakak kelas kalian!
Dialogue: 0,0:19:06.67,0:19:07.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baik!
Dialogue: 0,0:19:07.96,0:19:08.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat!
Dialogue: 0,0:19:08.88,0:19:11.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kelas abnormal isinya cewek cantik semua!\N- Serut, serut.
Dialogue: 0,0:19:11.30,0:19:12.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Dia buat es serut.\N- Serut, serut.
Dialogue: 0,0:19:14.93,0:19:16.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Api?
Dialogue: 0,0:19:16.55,0:19:17.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu...
Dialogue: 0,0:19:17.93,0:19:20.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian semua heboh sekali.
Dialogue: 0,0:19:20.93,0:19:22.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kak Asmodeus!\N- Asmodeus yang asli!
Dialogue: 0,0:19:22.93,0:19:24.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau es serut?
Dialogue: 0,0:19:24.27,0:19:24.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak butuh.
Dialogue: 0,0:19:24.98,0:19:25.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Dia sensi banget, ya? Seram.\N- Eh? Mau?
Dialogue: 0,0:19:25.81,0:19:27.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Dia sensi banget, ya? Seram.\N- Tidak!
Dialogue: 0,0:19:27.98,0:19:29.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:19:29.19,0:19:31.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh aura yang luar biasa!
Dialogue: 0,0:19:31.98,0:19:33.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat!
Dialogue: 0,0:19:34.19,0:19:37.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi ini kelas abnormal!
Dialogue: 0,0:19:40.58,0:19:41.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo?
Dialogue: 0,0:19:42.16,0:19:45.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku merasa pusing.
Dialogue: 0,0:19:45.66,0:19:47.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat... Aku bakal—
Dialogue: 0,0:19:48.17,0:19:49.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu baik-baik saja?
Dialogue: 0,0:19:55.63,0:19:57.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin karena terlalu ramai, ya.
Dialogue: 0,0:19:57.51,0:19:59.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini, minumlah air.
Dialogue: 0,0:19:59.72,0:20:01.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Te-Terima kasih.
Dialogue: 0,0:20:01.97,0:20:06.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, aku juga tidak menyangka seramai itu.
Dialogue: 0,0:20:07.27,0:20:10.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelas abnormal luar biasa, ya.
Dialogue: 0,0:20:12.73,0:20:16.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tanpa sadar merasa kewalahan.
Dialogue: 0,0:20:16.15,0:20:18.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Ini menyedihkan, sih.
Dialogue: 0,0:20:19.24,0:20:25.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi nilai ujian masukku pas-pasan,\Njadi masuk ke sini juga kebetulan.
Dialogue: 0,0:20:25.25,0:20:29.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, saat melihat kakak kelas\Nyang menakjubkan dari dekat,
Dialogue: 0,0:20:29.33,0:20:33.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku jadi ragu iblis sepertiku\Nbisa bertahan.
Dialogue: 0,0:20:37.09,0:20:41.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga sangat cemas\Nsaat awal masuk.
Dialogue: 0,0:20:41.82,0:20:43.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:20:43.64,0:20:48.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah bertemu dan menghabiskan waktu\Nbersama berbagai macam iblis di Babyls,
Dialogue: 0,0:20:48.64,0:20:51.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tempat ini jadi sangat penting bagiku.
Dialogue: 0,0:20:52.19,0:20:53.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku...
Dialogue: 0,0:20:54.40,0:20:58.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sangat bersyukur\Nbisa masuk ke sekolah ini!
Dialogue: 0,0:21:00.61,0:21:02.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kamu pasti baik-baik saja.
Dialogue: 0,0:21:03.41,0:21:07.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutku, kamu juga akan\Nmenyukai sekolah ini.
Dialogue: 0,0:21:07.95,0:21:12.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Dua garis! Dia murid kelas dua!\N- Aku mungkin terdengar sedikit sok, ya.
Dialogue: 0,0:21:12.71,0:21:14.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak, Kak!
Dialogue: 0,0:21:14.92,0:21:18.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka—\NOh, iya, aku sekarang kakak kelas!
Dialogue: 0,0:21:18.22,0:21:22.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah, aku merasa kewalahan\Noleh lingkungan baru ini, tapi...
Dialogue: 0,0:21:23.64,0:21:27.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata ada kakak kelas yang hangat\Ndan baik sepertinya.
Dialogue: 0,0:21:27.85,0:21:29.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, nama—
Dialogue: 0,0:21:29.31,0:21:30.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya ketemu!
Dialogue: 0,0:21:30.85,0:21:33.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata Anda ada di sini, ya!
Dialogue: 0,0:21:34.48,0:21:35.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, itu dia!
Dialogue: 0,0:21:39.49,0:21:41.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sini sejuk, ya!
Dialogue: 0,0:21:41.53,0:21:42.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pagi!
Dialogue: 0,0:21:42.74,0:21:44.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa sesuatu terjadi?
Dialogue: 0,0:21:44.24,0:21:46.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelajarannya sudah mau mulai, lo.
Dialogue: 0,0:21:46.12,0:21:48.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang dirimu lakukan\Ndi tempat seperti ini?
Dialogue: 0,0:21:48.83,0:21:50.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu adalah uang.
Dialogue: 0,0:21:50.25,0:21:52.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan semangat belajar!
Dialogue: 0,0:21:52.46,0:21:54.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo cepat masuk.
Dialogue: 0,0:21:54.00,0:21:56.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tidak boleh terlambat di hari pertama!
Dialogue: 0,0:21:56.96,0:21:59.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bakal kena marah besar\Nsi guru licik, lo.
Dialogue: 0,0:21:59.51,0:22:01.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita cepat masuk!
Dialogue: 0,0:22:01.63,0:22:03.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, ayo masuk bersama!
Dialogue: 0,0:22:03.51,0:22:05.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Iruma!
Dialogue: 0,0:22:05.01,0:22:06.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iru—
Dialogue: 0,0:22:07.01,0:22:09.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku lepas kacamata antideteksinya, ya!
Dialogue: 0,0:22:10.49,0:22:12.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku pergi dulu, ya.
Dialogue: 0,0:22:12.52,0:22:16.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ada apa-apa, silakan curhat\Nke guru atau kakak kelasmu.
Dialogue: 0,0:22:16.15,0:22:20.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya sekolah ini penuh\Ndengan iblis yang ramah.
Dialogue: 0,0:22:22.36,0:22:25.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang di Babyls!
Dialogue: 0,0:22:29.04,0:22:32.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Kak Eiko! Aku ngobrol dengan Kak Iruma!"
Dialogue: 0,0:22:32.96,0:22:33.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Eita."
Dialogue: 0,0:22:33.79,0:22:35.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:22:35.42,0:22:38.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tahun ajaran baru dimulai!
Dialogue: 0,0:22:45.80,0:22:53.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Daging segar manusia\Nialah makanan kita ♪
Dialogue: 0,0:22:53.77,0:23:01.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Kita harus nikmati jiwa, darah,\Nserta daging mereka tanpa sisa ♪
Dialogue: 0,0:23:01.78,0:23:09.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Takutlah pada suara\Nsayap hitam kami saat terbang ♪
Dialogue: 0,0:23:09.87,0:23:18.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Karena kamilah\Npara iblis menyeramkan ♪
Dialogue: 0,0:23:18.04,0:23:25.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Lagu ini dinyanyikan\Ndari bibir merah kami ♪
Dialogue: 0,0:23:25.84,0:23:33.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Berteriaklah, karena kamilah para iblis ♪
Dialogue: 0,0:23:33.98,0:23:41.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Naungan kami terasa\Nsangat menyeramkan ♪
Dialogue: 0,0:23:41.86,0:23:50.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Namanya adalah Babyls!\NInilah sekolah kami ♪
Dialogue: 0,0:23:50.16,0:23:54.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Kami persembahkan jiwa, darah,\Nserta daging tanpa sisa ♪
Dialogue: 0,0:23:54.83,0:24:05.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♪ Karena kami ingin\Nmenjadi santapan para iblis ♪
Dialogue: 0,0:24:13.39,0:24:18.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kegelapan mulai bergejolak.\NIblis kejam pun bebas merajalela.
Dialogue: 0,0:24:19.02,0:24:23.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Babak kekacauan\Nyang tak seorang pun duga kini terbuka.
Dialogue: 0,0:24:30.16,0:24:31.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu...
Dialogue: 0,0:24:31.91,0:24:36.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iruma, Asmodeus, Clara,
Dialogue: 0,0:24:36.91,0:24:39.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan teman-teman kelas abnormal...
Dialogue: 0,0:24:39.37,0:24:44.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ujian kejam yang belum pernah\Nterjadi sebelumnya menanti mereka.
Dialogue: 0,0:24:45.05,0:24:51.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kisah itu akan kami bawakan di lain waktu.
