Dialogue: 0,0:00:47.49,0:00:54.78,sign,,0000,0000,0000,,WELCOME TO DEMON SCHOOL! IRUMA-KUN SEASON 4
Dialogue: 0,0:02:08.97,0:02:09.58,sign,,0000,0000,0000,,JALAN MENUJU RAJA IBLIS
Dialogue: 0,0:02:16.99,0:02:21.75,sign,,0000,0000,0000,,BATRA RAJA IBLIS
Dialogue: 0,0:02:50.15,0:02:54.40,sign,,0000,0000,0000,,SAMBUTAN HANGAT
Dialogue: 0,0:03:24.23,0:03:28.23,sign,,0000,0000,0000,,PERPUSTAKAAN PRIBADI
Dialogue: 0,0:03:39.27,0:03:41.62,sign,,0000,0000,0000,,KRONOLOGI ILUSTRASI BERWARNA RAJA IBLIS
Dialogue: 0,0:03:41.62,0:03:42.41,sign,,0000,0000,0000,,666 LAGU POPULER YANG DISUKAI RAJA IBLIS
Dialogue: 0,0:03:42.41,0:03:43.66,sign,,0000,0000,0000,,LADANG BUNGA YOKAKURI
Dialogue: 0,0:03:45.04,0:03:48.54,sign,,0000,0000,0000,,LEGENDA DELKIRA
Dialogue: 0,0:04:42.85,0:04:44.31,sign,,0000,0000,0000,,LEGENDA GUNUNG JARUM\N~PERTARUNGAN DEATH SQUARE~
Dialogue: 0,0:10:45.62,0:10:50.13,sign,,0000,0000,0000,,SABNOCK SYLVIA - ADIK PEREMPUAN SABURO
Dialogue: 0,0:12:14.67,0:12:19.26,sign,,0000,0000,0000,,SOALNYA KEREN!
Dialogue: 0,0:12:45.37,0:12:50.42,sign,,0000,0000,0000,,AHLI STRATEGI PERBATASAN SELATAN
Dialogue: 0,0:22:11.31,0:22:16.31,sign,,0000,0000,0000,,GEROMBOLAN ENAM JARI
Dialogue: 0,0:24:07.59,0:24:08.13,sign,,0000,0000,0000,,TAMBAHAN
Dialogue: 0,0:24:16.27,0:24:19.02,sign,,0000,0000,0000,,KECERDASAN - WAWASAN LUAS
Dialogue: 0,0:24:27.99,0:24:29.49,sign,,0000,0000,0000,,DAYA TAHAN
Dialogue: 0,0:24:29.99,0:24:32.20,sign,,0000,0000,0000,,CUPLIKAN
Dialogue: 0,0:00:04.61,0:00:08.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang,\Nanak-anak calon raja iblis.
Dialogue: 0,0:00:08.24,0:00:11.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kalian jadi Raja Iblis,
Dialogue: 0,0:00:11.07,0:00:15.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}seperti apa cara kalian\Nakan memerintah dunia iblis?
Dialogue: 0,0:00:15.12,0:00:17.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakek...
Dialogue: 0,0:00:19.00,0:00:22.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ingin menjadikanku Raja Iblis?
Dialogue: 0,0:00:22.21,0:00:28.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Raja Iblis adalah posisi paling berat\Nsekaligus paling agung di dunia iblis ini.
Dialogue: 0,0:00:28.09,0:00:33.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin menyiapkan jalan\Nuntukmu jadi Raja Iblis,
Dialogue: 0,0:00:33.26,0:00:37.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}agar kelak kamu bisa memilih.
Dialogue: 0,0:02:09.58,0:02:11.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Jalan Menuju Raja Iblis".
Dialogue: 0,0:02:21.75,0:02:24.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pe-Permisi!
Dialogue: 0,0:02:26.04,0:02:29.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Batra Raja Iblis.\NAda yang ingin kutanyakan...
Dialogue: 0,0:02:30.46,0:02:31.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada tamu!
Dialogue: 0,0:02:31.63,0:02:33.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tumben banget!\N- Sobat!
Dialogue: 0,0:02:36.80,0:02:39.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Batra Raja Iblis Babyls.
Dialogue: 0,0:02:39.22,0:02:41.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Batra yang mengumpulkan\Nliteratur tentang Raja Iblis,
Dialogue: 0,0:02:41.72,0:02:44.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}meneliti tentang Raja Iblis,\Nserta mendiskusikannya.
Dialogue: 0,0:02:44.89,0:02:47.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Batra pencinta Raja Iblis.
Dialogue: 0,0:02:47.52,0:02:49.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, Iruma.
Dialogue: 0,0:02:50.15,0:02:52.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kamu lakukan di sini?
Dialogue: 0,0:02:52.61,0:02:54.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Ah...
Dialogue: 0,0:02:54.40,0:02:57.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, tahu-tahu aku sudah disambut.
Dialogue: 0,0:02:57.49,0:02:59.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf aku tiba-tiba datang, ya.
Dialogue: 0,0:02:59.62,0:03:03.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu datang untuk makan camilan?
Dialogue: 0,0:03:03.12,0:03:07.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, aku ingin mengobrol\Ndenganmu, Sabnock.
Dialogue: 0,0:03:07.29,0:03:08.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengobrol?
Dialogue: 0,0:03:08.46,0:03:10.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, ada yang ingin kutanyakan.
Dialogue: 0,0:03:10.04,0:03:11.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih atas makanannya.
Dialogue: 0,0:03:11.38,0:03:12.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nih.
Dialogue: 0,0:03:12.17,0:03:13.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentang Raja Iblis.
Dialogue: 0,0:03:13.80,0:03:15.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:03:15.05,0:03:17.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harusnya dirimu bilang dari awal,\Nwahai rivalku!
Dialogue: 0,0:03:17.68,0:03:19.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bicarakan sepuasnya di sebelah sini!
Dialogue: 0,0:03:19.97,0:03:22.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Sobat!\N- Sobat!
Dialogue: 0,0:03:22.47,0:03:24.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih atas tehnya!
Dialogue: 0,0:03:28.23,0:03:30.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini perpustakaan pribadi.
Dialogue: 0,0:03:30.36,0:03:34.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dokumen penting mengenai\NRaja Iblis terkumpul di sini.
Dialogue: 0,0:03:35.32,0:03:37.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah ada yang menarik perhatianmu?
Dialogue: 0,0:03:37.66,0:03:39.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada macam-macam, lo!
Dialogue: 0,0:03:39.27,0:03:41.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Kronologi Ilustrasi Berwarna Raja Iblis".
Dialogue: 0,0:03:41.62,0:03:43.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"666 Lagu Populer
Dialogue: 0,0:03:43.66,0:03:45.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang Disukai oleh Raja Iblis".
Dialogue: 0,0:03:49.25,0:03:51.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Delkira...
Dialogue: 0,0:03:51.04,0:03:54.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, Legenda Delkira, ya?\NPaten, ya!
Dialogue: 0,0:03:54.51,0:03:57.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan aku pun tahu nama beliau.
Dialogue: 0,0:03:57.22,0:04:02.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu karena Tuan Delkira adalah salah satu\NRaja Iblis terpopuler sepanjang masa!
Dialogue: 0,0:04:03.76,0:04:06.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Raja Iblis yang Menghilang, Delkira!
Dialogue: 0,0:04:06.52,0:04:11.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cahaya kebesaran beliau menyinari\Ndunia iblis dengan gemerlap!
Dialogue: 0,0:04:11.36,0:04:14.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Delkira tiba-tiba menghilang,
Dialogue: 0,0:04:14.32,0:04:16.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}makanya takhta Raja Iblis\Njadi kosong, kan?
Dialogue: 0,0:04:16.94,0:04:18.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tepat sekali!
Dialogue: 0,0:04:18.52,0:04:21.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiada yang tahu alasannya, sih.
Dialogue: 0,0:04:22.33,0:04:27.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan dan karismanya tiada tanding\Ndi antara semua Raja Iblis sepanjang sejarah.
Dialogue: 0,0:04:27.16,0:04:31.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beliau disebut-sebut sebagai Raja Iblis\Nyang paling banyak mereformasi dunia iblis.
Dialogue: 0,0:04:31.79,0:04:35.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak kisah dan legenda\Ntentang Tuan Delkira,
Dialogue: 0,0:04:35.46,0:04:38.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi inilah cerita favoritku!
Dialogue: 0,0:04:38.67,0:04:42.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Legenda Gunung Jarum"\Ndari Perang Utara!
Dialogue: 0,0:04:45.22,0:04:49.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dahulu, terjadi sengketa wilayah\Ndi daerah barat laut.
Dialogue: 0,0:04:49.19,0:04:53.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kedua pihak saling bertarung\Nmemperebutkan "Death Square".
Dialogue: 0,0:04:55.90,0:04:59.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tepat sebelum keduanya bertarung\Ndi padang tandus bawah tebing,
Dialogue: 0,0:04:59.45,0:05:02.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}beliau turun dengan anggunnya.
Dialogue: 0,0:05:05.41,0:05:06.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu...
Dialogue: 0,0:05:07.66,0:05:11.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beliau menghentikan semua senjata\Ndengan tubuhnya sendiri.
Dialogue: 0,0:05:11.75,0:05:16.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yak, sudah selesai.\NAyo berbaikan.
Dialogue: 0,0:05:16.71,0:05:19.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada korban jiwa\Ndan hanya satu orang terluka.
Dialogue: 0,0:05:19.72,0:05:23.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sosok beliau kala itu\Nseperti gunung jarum.
Dialogue: 0,0:05:26.85,0:05:31.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berulang kali membacanya semasa kecil\Ndan mengagumi keberanian beliau!
Dialogue: 0,0:05:33.15,0:05:34.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oleh karena itu...
Dialogue: 0,0:05:34.94,0:05:38.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memutuskan untuk siap\Nmenerima segala serangan!
Dialogue: 0,0:05:38.94,0:05:44.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin menunjukkan bahwa tubuhku\Njuga kuat seperti Tuan Delkira!
Dialogue: 0,0:05:44.78,0:05:46.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitulah!
Dialogue: 0,0:05:48.29,0:05:53.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, aku melihat dari perspektif\Nyang berbeda akhir-akhir ini.
Dialogue: 0,0:05:53.83,0:05:57.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin alasan Tuan Delkira\Nmenerima semua senjata itu
Dialogue: 0,0:05:57.46,0:06:02.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena beliau ingin tahu rasa sakit\Nyang menciptakan peperangan.
Dialogue: 0,0:06:02.97,0:06:07.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin beliau berpikir\Ndengan tahu rasa sakit itu,
Dialogue: 0,0:06:07.14,0:06:12.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}beliau bisa jadi Raja Iblis yang layak\Nuntuk hentikan peperangan.
Dialogue: 0,0:06:12.64,0:06:16.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pak Buer juga bilang penting\Nuntuk tahu apa itu "rasa sakit".
Dialogue: 0,0:06:16.90,0:06:18.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:06:18.77,0:06:20.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dilihat dari perspektif itu,
Dialogue: 0,0:06:21.15,0:06:23.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}beliau tampak seperti iblis yang baik.
Dialogue: 0,0:06:25.16,0:06:28.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, kudengar beliau memusnahkan\Npasukan yang tidak disukai dalam semalam.
Dialogue: 0,0:06:28.58,0:06:29.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:06:29.70,0:06:32.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membangun sebuah negeri\Nsaat tengah jalan-jalan.
Dialogue: 0,0:06:33.12,0:06:36.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beliau mencoba membawa pulang\Nsungai yang disukai ke kastel
Dialogue: 0,0:06:36.29,0:06:38.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan dimarahi oleh para pengawalnya.
Dialogue: 0,0:06:38.96,0:06:43.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, rumah keluargaku\Nmenyimpan dokumen rinci tentang senjata
Dialogue: 0,0:06:43.01,0:06:44.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang sebenarnya digunakan Tuan Delkira.
Dialogue: 0,0:06:44.80,0:06:46.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senjata?\NAku jadi penasaran!
Dialogue: 0,0:06:46.55,0:06:49.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bentuknya unik-unik, lo!
Dialogue: 0,0:06:49.43,0:06:50.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah!
Dialogue: 0,0:07:02.57,0:07:04.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memesona, kan?
Dialogue: 0,0:07:04.32,0:07:06.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ucapan dan gaya hidupnya.
Dialogue: 0,0:07:06.53,0:07:07.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:07:07.32,0:07:09.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua iblis terpesona.
Dialogue: 0,0:07:09.83,0:07:13.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Simbol yang amat dicintai di dunia iblis.
Dialogue: 0,0:07:13.66,0:07:16.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alasanku ingin jadi Raja Iblis
Dialogue: 0,0:07:18.25,0:07:22.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena Raja Iblis sangatlah keren.
Dialogue: 0,0:07:25.22,0:07:26.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang barusan itu
Dialogue: 0,0:07:26.59,0:07:29.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}rasanya seperti Raja Iblis!
Dialogue: 0,0:07:31.72,0:07:34.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah suasananya...\NAtmosfernya... Berasa auranya!
Dialogue: 0,0:07:34.98,0:07:37.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Bagian mananya?\NLebih rincinya?
Dialogue: 0,0:07:37.73,0:07:40.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sosok Raja Iblis mana\Nyang paling mirip denganku?
Dialogue: 0,0:07:40.69,0:07:41.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini?
Dialogue: 0,0:07:41.98,0:07:45.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu...
Dialogue: 0,0:07:55.91,0:07:58.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Raja Iblis itu luar biasa!
Dialogue: 0,0:07:58.17,0:07:59.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, kan?
Dialogue: 0,0:07:59.50,0:08:03.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku suka cerita\NLadang Bunga Yokakuri!
Dialogue: 0,0:08:03.50,0:08:06.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, itu juga keren!
Dialogue: 0,0:08:08.30,0:08:11.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jujur saja, aku terkejut.
Dialogue: 0,0:08:11.76,0:08:16.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak menyangka dirimu\Ntertarik pada Raja Iblis.
Dialogue: 0,0:08:16.39,0:08:20.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memang senang, tapi apa\Nada sesuatu yang terjadi?
Dialogue: 0,0:08:20.31,0:08:24.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa memberitahu detailnya.
Dialogue: 0,0:08:25.07,0:08:27.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dapat kesempatan\Nuntuk memikirkannya
Dialogue: 0,0:08:28.07,0:08:33.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan kuputuskan untuk menghadapi\Nhal yang sebelumnya kuabaikan.
Dialogue: 0,0:08:36.03,0:08:39.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah kenapa aku ingin\Nmempelajari tentang Raja Iblis.
Dialogue: 0,0:08:39.77,0:08:44.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, ilmuku yang masih dangkal\Nyang jadi masalahnya.
Dialogue: 0,0:08:45.80,0:08:47.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:08:47.55,0:08:48.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:08:48.55,0:08:52.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku senang kalau\Nkita bisa mengobrol seperti ini lagi!
Dialogue: 0,0:08:54.01,0:08:55.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:09:04.40,0:09:07.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah\Nmeminjamkan banyak buku!
Dialogue: 0,0:09:07.28,0:09:10.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin akan makan waktu,\Ntapi pasti akan kubaca semua!
Dialogue: 0,0:09:15.37,0:09:19.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menghadapi hal yang sebelumnya diabaikan...
Dialogue: 0,0:09:28.59,0:09:30.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sylvia, ya?
Dialogue: 0,0:09:30.88,0:09:33.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, aku ingin pulang.
Dialogue: 0,0:09:34.43,0:09:36.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suaranya keras sekali.\NAda apa?
Dialogue: 0,0:09:36.89,0:09:40.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Dirimu jatuh dari kursi?
Dialogue: 0,0:10:22.60,0:10:25.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang kembali, Tuan Saburo.
Dialogue: 0,0:10:25.06,0:10:27.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yamanda, ya!\NLama tidak jumpa.
Dialogue: 0,0:10:28.23,0:10:29.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:10:29.48,0:10:31.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya senang Anda kembali.
Dialogue: 0,0:10:31.69,0:10:33.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ada yang berubah?
Dialogue: 0,0:10:33.28,0:10:36.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya rasa sudah saatnya\Nmemperbaiki atap.
Dialogue: 0,0:10:36.16,0:10:38.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa perlu kuperbaiki?
Dialogue: 0,0:10:38.20,0:10:39.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya sangat terbantu.
Dialogue: 0,0:10:42.62,0:10:45.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang kembali, Kakak!
Dialogue: 0,0:10:45.62,0:10:48.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sylvia! Kamu sehat?
Dialogue: 0,0:10:48.59,0:10:50.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sehat banget, kok!
Dialogue: 0,0:10:50.13,0:10:52.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, kan, Yamanda?
Dialogue: 0,0:10:52.13,0:10:54.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:10:54.22,0:10:57.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau tinggal berapa hari?\NTiga hari? Mau tinggal tiga hari?
Dialogue: 0,0:10:57.89,0:11:02.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya datang untuk mengambil buku,\Ntapi akan tinggal semalaman di sini.
Dialogue: 0,0:11:02.22,0:11:04.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma semalam?
Dialogue: 0,0:11:04.48,0:11:05.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:11:05.44,0:11:08.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Hore!\N- Buku tentang Raja Iblis?
Dialogue: 0,0:11:08.02,0:11:10.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berjanji\Nuntuk meminjamkannya pada Iruma.
Dialogue: 0,0:11:10.82,0:11:13.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Iruma!\NRivalnya Kakak!
Dialogue: 0,0:11:13.69,0:11:15.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus, dia sangat populer di Babyls!
Dialogue: 0,0:11:15.78,0:11:18.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi tidak sabar ingin menemuinya!
Dialogue: 0,0:11:18.57,0:11:19.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menemuinya?
Dialogue: 0,0:11:22.29,0:11:25.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah menahan diri\Nsampai Kakak pulang.
Dialogue: 0,0:11:25.96,0:11:28.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya...
Dialogue: 0,0:11:29.38,0:11:35.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sabnock Sylvia telah lulus\Nujian masuk Babyls!
Dialogue: 0,0:11:37.97,0:11:40.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dirimu lulus, ya!\NKerja bagus!
Dialogue: 0,0:11:40.43,0:11:43.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hampir gagal di ujian tulis,\Ntapi sangat sukses di ujian praktik!
Dialogue: 0,0:11:43.97,0:11:46.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sip! Kita rayakan hari ini!
Dialogue: 0,0:11:46.06,0:11:47.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yamanda! Kita pesta!
Dialogue: 0,0:11:47.81,0:11:49.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Persiapannya sudah beres!
Dialogue: 0,0:11:50.98,0:11:55.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya ada satu kejutan lagi, Kakak.
Dialogue: 0,0:11:56.95,0:12:01.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tamu spesial untuk merayakan\Nkelulusanku dan kedatanganmu!
Dialogue: 0,0:12:04.70,0:12:08.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yo, lama tidak jumpa.\NSaburo.
Dialogue: 0,0:12:24.97,0:12:27.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paman! Lama tidak jumpa!
Dialogue: 0,0:12:27.60,0:12:29.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anda sedang berkunjung, ya?
Dialogue: 0,0:12:29.35,0:12:30.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana pekerjaan paman?
Dialogue: 0,0:12:30.81,0:12:33.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sekarang sedang senggang.
Dialogue: 0,0:12:34.19,0:12:36.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin dengar rincinya!
Dialogue: 0,0:12:36.11,0:12:40.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anggota 13 Mahkota!\NJenderal pemimpin para iblis dari selatan!
Dialogue: 0,0:12:40.57,0:12:42.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ahli Strategi Perbatasan Selatan!
Dialogue: 0,0:12:42.91,0:12:45.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dengar nama Baal sang Raja Petir,
Dialogue: 0,0:12:45.37,0:12:47.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}musuh pasti akan kabur terbirit-birit!
Dialogue: 0,0:12:47.83,0:12:50.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kisah kepahlawananmu tidak terhitung!
Dialogue: 0,0:12:50.42,0:12:54.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu masih saja suka cerita begitu, ya.
Dialogue: 0,0:12:54.92,0:12:58.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu cerita penting bagiku\Nyang ingin jadi Raja Iblis!
Dialogue: 0,0:13:00.80,0:13:02.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yo, Yamanda.
Dialogue: 0,0:13:02.59,0:13:04.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lama tidak jumpa.
Dialogue: 0,0:13:04.43,0:13:09.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Adiknya ayah ternyata\Nsalah satu dari 13 Mahkota!
Dialogue: 0,0:13:09.23,0:13:10.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:13:10.77,0:13:13.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya mereka bukan saudara kandung.
Dialogue: 0,0:13:14.27,0:13:15.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitukah?
Dialogue: 0,0:13:15.44,0:13:16.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:13:16.69,0:13:18.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka sama sekali tidak mirip.
Dialogue: 0,0:13:20.45,0:13:21.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, Saburo.
Dialogue: 0,0:13:21.99,0:13:25.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu masih belum bertemu Kakak, ya.
Dialogue: 0,0:13:26.20,0:13:28.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul! Kakak harus segera\Nmenemui Ayah!
Dialogue: 0,0:13:28.33,0:13:29.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pas sekali.
Dialogue: 0,0:13:29.58,0:13:31.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menemuinya, ikutlah denganku.
Dialogue: 0,0:13:31.33,0:13:33.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, aku...
Dialogue: 0,0:13:33.33,0:13:35.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu benar!\NAyo, Kakak!
Dialogue: 0,0:13:35.34,0:13:37.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Mumpung kita sekeluarga sedang berkumpul!\N- Ah! Paman!
Dialogue: 0,0:13:37.67,0:13:39.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, Kakak!
Dialogue: 0,0:13:52.06,0:13:53.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sabzan.
Dialogue: 0,0:13:54.86,0:13:57.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu di dalam, kan?\NBuka pintunya, dong.
Dialogue: 0,0:14:00.61,0:14:02.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada Saburo juga, lo.
Dialogue: 0,0:14:09.20,0:14:10.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saburo?
Dialogue: 0,0:14:12.04,0:14:15.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pulang.
Dialogue: 0,0:14:17.75,0:14:19.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:14:22.51,0:14:24.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?\NCuma itu?
Dialogue: 0,0:14:24.76,0:14:28.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal Kakak sudah lama\Ntak pulang, kenapa tidak—
Dialogue: 0,0:14:29.52,0:14:32.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.\NAyo, Sylvia.
Dialogue: 0,0:14:34.23,0:14:35.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saburo.
Dialogue: 0,0:14:37.82,0:14:40.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak bisa jadi Raja Iblis.
Dialogue: 0,0:14:55.92,0:15:00.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya itu yang kamu ingin katakan?
Dialogue: 0,0:15:07.05,0:15:08.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi.
Dialogue: 0,0:15:08.47,0:15:09.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak!
Dialogue: 0,0:15:09.56,0:15:10.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Saburo!
Dialogue: 0,0:15:12.39,0:15:13.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baal.
Dialogue: 0,0:15:14.39,0:15:16.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Datanglah lagi nanti.
Dialogue: 0,0:15:16.56,0:15:18.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:15:33.16,0:15:38.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sosok itu memerintah segala ras\Ndi bawah kekuasaannya.
Dialogue: 0,0:15:38.75,0:15:43.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menjalin perjanjian darah\Ndan menyembuhkan jiwa-jiwa.
Dialogue: 0,0:15:48.22,0:15:50.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti dirinya...
Dialogue: 0,0:15:51.14,0:15:54.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan jadi iblis menyedihkan
Dialogue: 0,0:15:54.47,0:15:56.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang tak punya tekad untuk menggapai
Dialogue: 0,0:15:56.14,0:15:57.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lebih tinggi!
Dialogue: 0,0:16:12.45,0:16:14.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih sama, ya.
Dialogue: 0,0:16:14.70,0:16:17.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hubunganmu dengan Kakak.
Dialogue: 0,0:16:17.96,0:16:20.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf telah menunjukkan hal memalukan.
Dialogue: 0,0:16:20.21,0:16:21.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saburo.
Dialogue: 0,0:16:21.96,0:16:24.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mendukungmu.
Dialogue: 0,0:16:26.97,0:16:29.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak salah.
Dialogue: 0,0:16:33.01,0:16:36.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku bilang bisa\Nmenjadikanmu Raja Iblis,
Dialogue: 0,0:16:36.98,0:16:39.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu mau bagaimana, Saburo?
Dialogue: 0,0:16:54.03,0:16:57.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu punya kesiapan akan itu,
Dialogue: 0,0:16:57.83,0:17:00.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}keluarlah dari Babyls\Ndan ikutlah denganku.
Dialogue: 0,0:17:02.50,0:17:05.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada Thirteen's Dinner kemarin,
Dialogue: 0,0:17:05.30,0:17:11.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Rencana Trickster" untuk melatih\NRaja Iblis selanjutnya telah diusulkan.
Dialogue: 0,0:17:11.51,0:17:14.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini, ada tiga kandidat.
Dialogue: 0,0:17:14.30,0:17:18.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cucu Belial, Belial Berry Razberry.
Dialogue: 0,0:17:18.14,0:17:21.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cucu Levi, Leviathan Leiji.
Dialogue: 0,0:17:22.34,0:17:24.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu...
Dialogue: 0,0:17:24.15,0:17:27.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cucu Sullivan, Iruma.
Dialogue: 0,0:17:29.24,0:17:31.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya kamu tidak tahu, ya.
Dialogue: 0,0:17:33.74,0:17:36.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa beri tahu detailnya, sih.
Dialogue: 0,0:17:36.24,0:17:38.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dapat kesempatan\Nuntuk memikirkannya.
Dialogue: 0,0:17:39.71,0:17:42.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagian menarik dari\N"Rencana Trickster" adalah
Dialogue: 0,0:17:42.96,0:17:48.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tiap anggota 13 Mahkota berhak\Nmemilih kandidatnya masing-masing.
Dialogue: 0,0:17:48.88,0:17:54.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai sekarang, kandidat yang dipilih\N13 Mahkota akan saling unjuk gigi.
Dialogue: 0,0:17:56.43,0:18:00.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku akan mendukungmu.
Dialogue: 0,0:18:00.60,0:18:03.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Ahli Strategi Perbatasan Selatan"\Nbukan sekadar pajangan.
Dialogue: 0,0:18:03.27,0:18:06.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita singkirkan kandidat lainnya.
Dialogue: 0,0:18:07.15,0:18:09.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan begitu...
Dialogue: 0,0:18:09.11,0:18:13.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bisa jadi Raja Iblis.
Dialogue: 0,0:18:16.24,0:18:17.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana?
Dialogue: 0,0:18:26.00,0:18:27.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu...
Dialogue: 0,0:18:30.26,0:18:31.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah itu
Dialogue: 0,0:18:32.13,0:18:34.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}keren?
Dialogue: 0,0:18:36.72,0:18:41.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, bukan masalah kalau itu keren, tapi...
Dialogue: 0,0:18:42.52,0:18:48.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku jadi Raja Iblis dengan cara itu,\Nbiografiku akan tertulis begini, kan?
Dialogue: 0,0:18:48.32,0:18:52.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Pria yang jadi Raja Iblis\Nberkat rekomendasi pamannya."
Dialogue: 0,0:18:52.74,0:18:56.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak tahu itu keren atau tidak...
Dialogue: 0,0:18:59.08,0:19:05.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saburo, menurutmu ada berapa iblis di dunia ini\Nyang dapat rekomendasi dari 13 Mahkota?
Dialogue: 0,0:19:06.75,0:19:12.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat mengejar ambisimu, mana ada waktu\Nmemikirkan itu keren atau tidak.
Dialogue: 0,0:19:13.80,0:19:17.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Faktanya, mereka menggunakan\Nkekuatan nenek moyang mereka
Dialogue: 0,0:19:17.18,0:19:19.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk mengincar takhta Raja Iblis, kan?
Dialogue: 0,0:19:20.64,0:19:22.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iruma pun juga begitu.
Dialogue: 0,0:19:23.06,0:19:27.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selagi kamu diam di tempat,\Ndia terus naik ke atas.
Dialogue: 0,0:19:29.06,0:19:31.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak keberatan dilewati Iruma?
Dialogue: 0,0:19:32.28,0:19:34.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jaraknya akan fatal, lo.
Dialogue: 0,0:19:35.86,0:19:36.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:19:37.95,0:19:39.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anda keliru.
Dialogue: 0,0:19:39.37,0:19:41.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iruma bukan orang yang seperti itu.
Dialogue: 0,0:19:42.62,0:19:45.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku selalu melihatnya dari dekat.
Dialogue: 0,0:19:46.04,0:19:49.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga paham bahwa rekomendasi itu\Nadalah kesempatan emas.
Dialogue: 0,0:19:50.09,0:19:54.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jalan itu mungkin adalah jalan pintas\Nmenuju takhta Raja Iblis.
Dialogue: 0,0:19:54.59,0:19:55.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun...
Dialogue: 0,0:19:56.59,0:20:00.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sama sekali\Ntidak tertarik dengan jalan itu.
Dialogue: 0,0:20:01.22,0:20:02.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu karena...
Dialogue: 0,0:20:06.18,0:20:09.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di Babyls, aku punya rival\Nyang membuatku berkembang
Dialogue: 0,0:20:10.27,0:20:12.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan juga teman-teman!
Dialogue: 0,0:20:12.44,0:20:16.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, aku belum\Nmencapai apa-apa di Babyls!
Dialogue: 0,0:20:16.45,0:20:18.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berada di sekolah yang sama\Ndengan rivalku!
Dialogue: 0,0:20:18.99,0:20:22.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus menang secara jujur dan adil!
Dialogue: 0,0:20:25.20,0:20:30.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan kata lain, kamu ingin jadi Raja Iblis\Ndengan caramu sendiri, ya.
Dialogue: 0,0:20:30.71,0:20:32.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:20:32.46,0:20:36.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu harus bertemu dengan\Npara anggota 13 Mahkota.
Dialogue: 0,0:20:38.72,0:20:41.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku boleh setidaknya\Nmemperkenalkanmu, kan?
Dialogue: 0,0:20:41.22,0:20:43.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya! Mohon bantuannya!
Dialogue: 0,0:20:43.72,0:20:46.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak! Makanannya sudah siap, lo!
Dialogue: 0,0:20:46.56,0:20:47.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat menikmati!
Dialogue: 0,0:20:47.73,0:20:50.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya makanan favorit Kakak!
Dialogue: 0,0:20:50.10,0:20:51.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo dimakan!
Dialogue: 0,0:20:51.61,0:20:53.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Aku juga ikut bantu!\N- Paman juga...
Dialogue: 0,0:20:53.81,0:20:56.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanannya ada banyak,\Njadi makan yang banyak, ya!
Dialogue: 0,0:21:04.87,0:21:07.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Urusanmu sudah selesai, kan?
Dialogue: 0,0:21:08.08,0:21:10.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tugasku juga sudah selesai.
Dialogue: 0,0:21:11.37,0:21:15.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, selama bisa dapat ini,\Naku sudah puas.
Dialogue: 0,0:21:18.38,0:21:22.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih atas kerja kerasnya, Kakak.
Dialogue: 0,0:21:23.09,0:21:26.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menjauhlah dari keluargaku...
Dialogue: 0,0:21:26.10,0:21:28.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menjauhlah dari Saburo.
Dialogue: 0,0:21:29.73,0:21:31.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baal.
Dialogue: 0,0:21:46.03,0:21:47.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar.
Dialogue: 0,0:21:47.83,0:21:50.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah dan anak sama saja.
Dialogue: 0,0:21:51.62,0:21:54.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak, Kak?
Dialogue: 0,0:21:55.09,0:21:58.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah bilang enak seratus kali!
Dialogue: 0,0:22:16.86,0:22:20.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tombak yang nyentrik, ya, Kak.
Dialogue: 0,0:22:20.28,0:22:23.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mau memburu\Nmonster seperti apa?
Dialogue: 0,0:22:24.24,0:22:27.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akan merombak tatanan dunia iblis.
Dialogue: 0,0:22:28.29,0:22:29.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo.
Dialogue: 0,0:22:29.70,0:22:31.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktunya berburu!
Dialogue: 0,0:24:04.76,0:24:07.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tambahan!
Dialogue: 0,0:24:08.76,0:24:12.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Security Devil keluarga Sabnock, Yamanda.
Dialogue: 0,0:24:13.01,0:24:16.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam melayani keluarga Sabnock,\Nyang diperlukan adalah
Dialogue: 0,0:24:16.27,0:24:19.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kecerdasan, wawasan luas...
Dialogue: 0,0:24:19.02,0:24:21.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat pagi, Yamanda!
Dialogue: 0,0:24:22.98,0:24:24.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sehat?
Dialogue: 0,0:24:24.69,0:24:26.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya sehat.
Dialogue: 0,0:24:26.40,0:24:27.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}...dan daya tahan.
Dialogue: 0,0:24:29.99,0:24:32.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya tahun kedua tiba.
Dialogue: 0,0:24:32.20,0:24:34.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak aku masuk ke Babyls...
Dialogue: 0,0:24:34.12,0:24:37.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, sejak aku datang ke dunia iblis,\Nsudah setahun berlalu, ya.
Dialogue: 0,0:24:37.37,0:24:39.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak hal yang sudah terjadi.
Dialogue: 0,0:24:39.37,0:24:42.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Azz, Clara, Kakek, Opera.
Dialogue: 0,0:24:42.13,0:24:44.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bahagia, lo.
Dialogue: 0,0:24:44.00,0:24:45.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya, Selamat Datang\Ndi Sekolah Iblis, Iruma.
Dialogue: 0,0:24:45.97,0:24:47.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Kenang-Kenangan Paling Mewah".
Dialogue: 0,0:24:47.51,0:24:49.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya, aku benar-benar\Nberterima kasih.
Dialogue: 0,0:24:49.88,0:24:51.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon bantuannya.
Dialogue: 0,0:24:51.01,0:24:55.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan terus tinggal di dunia iblis\Nbersama kalian semua.
