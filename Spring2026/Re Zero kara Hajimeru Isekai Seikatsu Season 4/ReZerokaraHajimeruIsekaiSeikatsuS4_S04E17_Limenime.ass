Dialogue: 0,0:22:33.44,0:22:36.08,5-normal,,0,0,0,,{\bord3\fs80\shad0\c&H3A697A&\3c&H0B3848&\frz353\move(918.667,718,921.333,670.667,26,2737)}Good\NLoser
Dialogue: 0,0:00:01.67,0:00:03.96,Default,,0,0,0,,{\blur3}{\fad(00,40)}Namaku adalah Natsuki Subaru.
Dialogue: 0,0:00:04.62,0:00:07.66,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kesatria nomor satu Emilia!
Dialogue: 0,0:00:09.54,0:00:12.38,Default,,0,0,0,,{\blur3}{\fad(00,40)}Bukankah tindakan seperti itu
Dialogue: 0,0:00:12.38,0:00:14.91,Default,,0,0,0,,{\blur3}{\fad(00,40)}sudah kelewat ceroboh?!
Dialogue: 0,0:00:16.55,0:00:19.27,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku sama sekali tidak ceroboh!
Dialogue: 0,0:00:24.51,0:00:25.56,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sialan.
Dialogue: 0,0:00:25.56,0:00:26.93,Default,,0,0,0,,{\blur3}{\fad(00,40)}- Dia malah kabur...\N- Subaru!
Dialogue: 0,0:00:26.93,0:00:30.09,Default,,0,0,0,,{\blur3}{\fad(00,40)}A-Apa ini? E-Emilia?
Dialogue: 0,0:00:30.69,0:00:33.51,Default,,0,0,0,,{\blur3}{\fad(00,40)}Lembut dan wangi banget.
Dialogue: 0,0:00:33.51,0:00:35.57,Default,,0,0,0,,{\blur3}{\fad(00,40)}- Kau ganti sampo?\N- Subaru bodoh!
Dialogue: 0,0:00:35.57,0:00:37.15,Default,,0,0,0,,{\blur3}{\fad(00,40)}Pokoknya bodoh!
Dialogue: 0,0:00:37.44,0:00:39.07,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku khawatir banget.
Dialogue: 0,0:00:39.07,0:00:40.70,Default,,0,0,0,,{\blur3}{\fad(00,40)}Bodoh! Bodoh, bodoh!
Dialogue: 0,0:00:40.70,0:00:43.13,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku benar-benar dikatai bodoh.
Dialogue: 0,0:00:43.13,0:00:45.42,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tapi aku tak bisa menyangkal juga, sih.
Dialogue: 0,0:00:49.78,0:00:51.96,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kalian sudah bersama?
Dialogue: 0,0:00:53.09,0:00:56.00,Default,,0,0,0,,{\blur3}{\fad(00,40)}Subaru yang kehilangan ingatan\Njuga termasuk Subaru.
Dialogue: 0,0:00:56.00,0:00:59.00,Default,,0,0,0,,{\blur3}{\fad(00,40)}Jadi, meski hanya sesaat,\Ndia tetap sudah berusaha keras.
Dialogue: 0,0:00:59.00,0:01:00.84,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ya, aku baik-baik saja, kok.
Dialogue: 0,0:01:01.29,0:01:03.64,Default,,0,0,0,,{\blur3}{\fad(00,40)}Baik di dalam diriku maupun dirimu,
Dialogue: 0,0:01:03.64,0:01:05.64,Default,,0,0,0,,{\blur3}{\fad(00,40)}kenangan akan diriku masih tersisa.
Dialogue: 0,0:01:06.11,0:01:08.93,Default,,0,0,0,,{\blur3}{\fad(00,40)}Karena itu, aku sudah baik-baik saja, Emilia.
Dialogue: 0,0:01:09.20,0:01:10.09,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:01:21.11,0:01:22.49,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ketemu.
Dialogue: 0,0:01:24.38,0:01:27.51,Default,,0,0,0,,{\blur3}{\fad(00,40)}Pertama, kita jemput dulu partner imutku.
Dialogue: 0,0:02:58.38,0:02:59.36,Default,,0,0,0,,{\blur3}{\fad(00,40)}Beako!
Dialogue: 0,0:02:59.36,0:03:00.53,Default,,0,0,0,,{\blur3}{\fad(00,40)}Beatrice!
Dialogue: 0,0:03:01.36,0:03:04.91,Default,,0,0,0,,{\blur3}{\fad(00,40)}A-Ada Subaru dan gadis\Nyang entah siapa datang ke sini?
Dialogue: 0,0:03:04.91,0:03:06.56,Default,,0,0,0,,{\blur3}{\fad(00,40)}Angkat!
Dialogue: 0,0:03:06.56,0:03:10.27,Default,,0,0,0,,{\blur3}{\fad(00,40)}Beako, kau ringan banget!\NImut banget!
Dialogue: 0,0:03:10.27,0:03:14.30,Default,,0,0,0,,{\blur3}{\fad(00,40)}- Nih, tinggi! Tinggi!\N- Lihat, Beatrice. Subaru sudah ingat semuanya.
Dialogue: 0,0:03:14.31,0:03:17.20,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tunggu! Tunggu dulu!
Dialogue: 0,0:03:17.73,0:03:21.16,Default,,0,0,0,,{\blur3}{\fad(00,40)}Subaru, apa kau benar-benar\Nsudah ingat semuanya?
Dialogue: 0,0:03:21.33,0:03:25.76,Default,,0,0,0,,{\blur3}{\fad(00,40)}Semua tentang Beti, tentang bagaimana\Nkita menghabiskan waktu bersama?
Dialogue: 0,0:03:25.76,0:03:27.26,Default,,0,0,0,,{\blur3}{\fad(00,40)}Iya, semuanya.
Dialogue: 0,0:03:27.42,0:03:29.76,Default,,0,0,0,,{\blur3}{\fad(00,40)}Jadi, jangan pasang wajah cemas begitu.
Dialogue: 0,0:03:30.31,0:03:31.39,Default,,0,0,0,,{\blur3}{\fad(00,40)}Selain itu...
Dialogue: 0,0:03:34.05,0:03:35.06,Default,,0,0,0,,{\blur3}{\fad(00,40)}Eng...
Dialogue: 0,0:03:35.06,0:03:36.52,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kakak?
Dialogue: 0,0:03:37.84,0:03:40.35,Default,,0,0,0,,{\blur3}{\fad(00,40)}Cepat sekali saljunya mencair.
Dialogue: 0,0:03:40.64,0:03:43.02,Default,,0,0,0,,{\blur3}{\fad(00,40)}Hebohnya benar-benar Barusu banget.
Dialogue: 0,0:03:43.62,0:03:45.73,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku sudah kembali.
Dialogue: 0,0:03:45.73,0:03:47.80,Default,,0,0,0,,{\blur3}{\fad(00,40)}Pria salju yang membawa musim semi.
Dialogue: 0,0:03:47.80,0:03:49.90,Default,,0,0,0,,{\blur3}{\fad(00,40)}Inilah aku, Natsuki Subaru!
Dialogue: 0,0:03:49.90,0:03:51.82,Default,,0,0,0,,{\blur3}{\fad(00,40)}Waduh, buset!
Dialogue: 0,0:03:52.91,0:03:56.83,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sepertinya Patrasche juga senang banget\Nmelihatmu kembali, Subaru.
Dialogue: 0,0:03:56.83,0:03:59.93,Default,,0,0,0,,{\blur3}{\fad(00,40)}Dasar, sudah seperti\Norang-orang yang tsundere saja.
Dialogue: 0,0:04:00.20,0:04:03.54,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tapi, aku benar-benar minta maaf\Nsudah membuatmu khawatir.
Dialogue: 0,0:04:05.76,0:04:08.91,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tapi, kangen-kangenannya kita tunda dulu.
Dialogue: 0,0:04:09.22,0:04:11.01,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sekarang waktunya bereskan situasi ini.
Dialogue: 0,0:04:11.18,0:04:13.29,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sebelum itu, ada yang ingin aku tanyakan.
Dialogue: 0,0:04:14.24,0:04:15.67,Default,,0,0,0,,{\blur3}{\fad(00,40)}Oh, aku?
Dialogue: 0,0:04:15.96,0:04:17.95,Default,,0,0,0,,{\blur3}{\fad(00,40)}Baik, namaku Emilia.
Dialogue: 0,0:04:17.95,0:04:19.26,Default,,0,0,0,,{\blur3}{\fad(00,40)}Hanya Emilia.
Dialogue: 0,0:04:19.76,0:04:21.44,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ada banyak yang ingin aku katakan,
Dialogue: 0,0:04:21.70,0:04:26.00,Default,,0,0,0,,{\blur3}{\fad(00,40)}tapi aku, Beatrice, dan Ram,\Nadalah keluarga dengan tujuan yang sama.
Dialogue: 0,0:04:27.16,0:04:30.28,Default,,0,0,0,,{\blur3}{\fad(00,40)}Eh? Apa aku bicara hal yang aneh?
Dialogue: 0,0:04:30.67,0:04:32.84,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ada banyak hal yang ingin aku pastikan.
Dialogue: 0,0:04:32.84,0:04:33.82,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tapi, sudahlah.
Dialogue: 0,0:04:33.99,0:04:35.53,Default,,0,0,0,,{\blur3}{\fad(00,40)}Pasti karena si Rakus, 'kan?
Dialogue: 0,0:04:35.70,0:04:37.66,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku benci dipermainkan olehnya.
Dialogue: 0,0:04:38.22,0:04:40.00,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku juga sama.
Dialogue: 0,0:04:40.16,0:04:42.58,Default,,0,0,0,,{\blur3}{\fad(00,40)}Pokoknya pasti akan kubalas balik!
Dialogue: 0,0:04:42.58,0:04:43.53,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sama!
Dialogue: 0,0:04:43.53,0:04:46.38,Default,,0,0,0,,{\blur3}{\fad(00,40)}Si Rakus itu harus\Ndibalas berkali-kali lipat!
Dialogue: 0,0:04:47.07,0:04:49.56,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ini, nih! Terasa seperti di rumah!
Dialogue: 0,0:04:50.98,0:04:53.55,Default,,0,0,0,,{\blur3}{\fad(00,40)}Seperti itulah situasi di menara sekarang.
Dialogue: 0,0:04:53.98,0:04:56.91,Default,,0,0,0,,{\blur3}{\fad(00,40)}Dengan kata lain,\Nrintangan yang sebenarnya adalah...
Dialogue: 0,0:04:57.22,0:04:58.64,Default,,0,0,0,,{\blur3}{\fad(00,40)}Dua Rakus.
Dialogue: 0,0:04:58.81,0:05:02.04,Default,,0,0,0,,{\blur3}{\fad(00,40)}Serangan binatang iblis\Nyang datang dari luar, lalu...
Dialogue: 0,0:05:02.04,0:05:03.80,Default,,0,0,0,,{\blur3}{\fad(00,40)}Shaula yang menyerang kita.
Dialogue: 0,0:05:03.80,0:05:05.31,Default,,0,0,0,,{\blur3}{\fad(00,40)}Totalnya jadi empat.
Dialogue: 0,0:05:05.48,0:05:06.31,Default,,0,0,0,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:05:08.29,0:05:11.53,Default,,0,0,0,,{\blur3}{\fad(00,40)}Mereka datang ke sini\Npasti sama seperti saat di Suaka.
Dialogue: 0,0:05:11.53,0:05:14.41,Default,,0,0,0,,{\blur3}{\fad(00,40)}Karena Rui tahu\Ntentang Kembali dari Kematian.
Dialogue: 0,0:05:14.76,0:05:18.58,Default,,0,0,0,,{\blur3}{\fad(00,40)}Selama dia sudah mundur,\Nharusnya mereka takkan muncul lagi.
Dialogue: 0,0:05:19.28,0:05:20.16,Default,,0,0,0,,{\blur3}{\fad(00,40)}Subaru?
Dialogue: 0,0:05:20.44,0:05:21.87,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ah, maaf.
Dialogue: 0,0:05:21.87,0:05:25.16,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kamu tidak apa-apa?\NTidak merasa kelabakan karena semua ini?
Dialogue: 0,0:05:25.16,0:05:27.96,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kelabakan? Jadul banget, deh.
Dialogue: 0,0:05:29.13,0:05:31.21,Default,,0,0,0,,{\blur3}{\fad(00,40)}Subaru, coba katakan itu sekali lagi!
Dialogue: 0,0:05:31.51,0:05:33.42,Default,,0,0,0,,{\blur3}{\fad(00,40)}Nanti saja, nanti.
Dialogue: 0,0:05:35.76,0:05:38.18,Default,,0,0,0,,{\blur3}{\fad(00,40)}Yang jelas, rintangannya ada empat.
Dialogue: 0,0:05:38.35,0:05:40.67,Default,,0,0,0,,{\blur3}{\fad(00,40)}Dan kita akan menghadapinya bersama.
Dialogue: 0,0:05:40.67,0:05:41.93,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kita kerahkan semuanya.
Dialogue: 0,0:05:42.10,0:05:44.35,Default,,0,0,0,,{\blur3}{\fad(00,40)}Untuk itu, Ram...
Dialogue: 0,0:05:54.69,0:05:55.49,Default,,0,0,0,,{\blur3}{\fad(00,40)}Shaula!
Dialogue: 0,0:05:55.89,0:05:57.00,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ada orang...
Dialogue: 0,0:05:57.33,0:05:59.64,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ada orang yang melanggar aturan.
Dialogue: 0,0:06:01.44,0:06:03.80,Default,,0,0,0,,{\blur3}{\fad(00,40)}Gawat, dia sudah mencapai batasnya.
Dialogue: 0,0:06:04.33,0:06:06.13,Default,,0,0,0,,{\blur3}{\fad(00,40)}Meili, bagaimana denganmu?
Dialogue: 0,0:06:06.13,0:06:09.04,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sepertinya yang terlihat,\Naku sudah kewalahan!
Dialogue: 0,0:06:10.09,0:06:11.24,Default,,0,0,0,,{\blur3}{\fad(00,40)}Shaula!
Dialogue: 0,0:06:16.76,0:06:17.89,Default,,0,0,0,,{\blur3}{\fad(00,40)}Master...
Dialogue: 0,0:06:21.87,0:06:24.24,Default,,0,0,0,,{\blur3}{\fad(00,40)}Master, tolong...
Dialogue: 0,0:06:24.41,0:06:27.73,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tolong... berikan aku perintah!
Dialogue: 0,0:06:31.71,0:06:33.98,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kalau terus begini, aku...
Dialogue: 0,0:06:35.49,0:06:37.16,Default,,0,0,0,,{\blur3}{\fad(00,40)}bisa membunuh Master...
Dialogue: 0,0:06:38.31,0:06:39.87,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sudah kukatakan berkali-kali,
Dialogue: 0,0:06:40.03,0:06:44.04,Default,,0,0,0,,{\blur3}{\fad(00,40)}aku tidak merasa punya alasan\Nuntuk dipanggil Master olehmu.
Dialogue: 0,0:06:47.18,0:06:49.93,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku takkan memerintahkanmu untuk mati.
Dialogue: 0,0:06:50.47,0:06:54.59,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku takkan membiarkan empat ratus tahunmu\Nberakhir dengan tangisan.
Dialogue: 0,0:06:55.87,0:06:59.05,Default,,0,0,0,,{\blur3}{\fad(00,40)}Master, aku mencintaimu.
Dialogue: 0,0:07:16.47,0:07:18.20,Default,,0,0,0,,{\blur3}{\fad(00,40)}Meili, Echidna!
Dialogue: 0,0:07:18.20,0:07:19.91,Default,,0,0,0,,{\blur3}{\fad(00,40)}Natsuki, kau sudah pulih...
Dialogue: 0,0:07:19.91,0:07:20.49,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tunggu.
Dialogue: 0,0:07:21.04,0:07:22.37,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ingatanmu sudah kembali?
Dialogue: 0,0:07:22.37,0:07:23.89,Default,,0,0,0,,{\blur3}{\fad(00,40)}Langsung paham juga.
Dialogue: 0,0:07:23.89,0:07:25.49,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tapi, kok bisa tahu?
Dialogue: 0,0:07:25.49,0:07:27.96,Default,,0,0,0,,{\blur3}{\fad(00,40)}Melihat wajah Beatrice saja\Naku langsung paham.
Dialogue: 0,0:07:28.91,0:07:30.07,Default,,0,0,0,,{\blur3}{\fad(00,40)}Dia siapa?
Dialogue: 0,0:07:30.07,0:07:31.71,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kena Otoritas sang Rakus.
Dialogue: 0,0:07:31.71,0:07:33.18,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sama seperti Julius.
Dialogue: 0,0:07:33.18,0:07:34.64,Default,,0,0,0,,{\blur3}{\fad(00,40)}Namanya Emilia.
Dialogue: 0,0:07:37.71,0:07:40.59,Default,,0,0,0,,{\blur3}{\fad(00,40)}Echidna, kau pergilah temui Julius.
Dialogue: 0,0:07:40.76,0:07:43.64,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku sudah jelaskan ke Emilia\Napa yang harus dilakukan nanti.
Dialogue: 0,0:07:43.93,0:07:45.60,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kalian sendiri bagaimana?
Dialogue: 0,0:07:45.76,0:07:50.52,Default,,0,0,0,,{\blur3}{\fad(00,40)}Beti dan Subaru akan mengurus\Nkalajengking besar itu.
Dialogue: 0,0:07:50.82,0:07:53.31,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sekarang aku takkan meragukan rencanamu.
Dialogue: 0,0:07:53.31,0:07:54.67,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku patuh saja.
Dialogue: 0,0:07:54.96,0:07:56.40,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kau punya pesan untuk Julius?
Dialogue: 0,0:07:56.40,0:07:58.32,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tidak, tidak ada.
Dialogue: 0,0:07:58.32,0:08:00.99,Default,,0,0,0,,{\blur3}{\fad(00,40)}Lagi pula, dia itu Julius Juukulius.
Dialogue: 0,0:08:02.45,0:08:04.37,Default,,0,0,0,,{\blur3}{\fad(00,40)}Oh, kayaknya ada, deh.
Dialogue: 0,0:08:04.93,0:08:06.99,Default,,0,0,0,,{\blur3}{\fad(00,40)}Yang lain juga sedang kewalahan,
Dialogue: 0,0:08:06.99,0:08:10.12,Default,,0,0,0,,{\blur3}{\fad(00,40)}jadi cepat bereskan dan bantulah yang lain.
Dialogue: 0,0:08:10.12,0:08:13.33,Default,,0,0,0,,{\blur3}{\fad(00,40)}Baiklah, akan kusampaikan langsung begitu.
Dialogue: 0,0:08:15.84,0:08:17.30,Default,,0,0,0,,{\blur3}{\fad(00,40)}Seperti yang direncanakan.
Dialogue: 0,0:08:17.46,0:08:18.88,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kami mengandalkanmu, Emilia.
Dialogue: 0,0:08:19.05,0:08:20.51,Default,,0,0,0,,{\blur3}{\fad(00,40)}Iya, serahkan padaku.
Dialogue: 0,0:08:20.93,0:08:22.88,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kamu juga, jangan sampai mati, ya.
Dialogue: 0,0:08:23.13,0:08:24.60,Default,,0,0,0,,{\blur3}{\fad(00,40)}Siap.
Dialogue: 0,0:08:26.43,0:08:29.71,Default,,0,0,0,,{\blur3}{\fad(00,40)}Terus, aku sendiri harus apa?
Dialogue: 0,0:08:29.71,0:08:32.14,Default,,0,0,0,,{\blur3}{\fad(00,40)}Maaf, tapi kau harus bantu kami, Meili.
Dialogue: 0,0:08:32.53,0:08:34.71,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku, Beako, dan kau, kita bertiga,
Dialogue: 0,0:08:34.71,0:08:38.61,Default,,0,0,0,,{\blur3}{\fad(00,40)}akan menahan serbuan binatang iblis\Ndan kalajengking besar itu.
Dialogue: 0,0:08:39.79,0:08:40.69,Default,,0,0,0,,{\blur3}{\fad(00,40)}Dia datang!
Dialogue: 0,0:08:44.84,0:08:46.45,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tangkap!
Dialogue: 0,0:08:54.80,0:08:57.75,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aduh, duh, duh, duh, kurasa!
Dialogue: 0,0:08:58.64,0:09:03.20,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku tak pernah menyangka\Nakan bertarung bersama seperti ini!
Dialogue: 0,0:09:08.87,0:09:09.72,Default,,0,0,0,,{\blur3}{\fad(00,40)}Menghindar!
Dialogue: 0,0:09:10.71,0:09:12.36,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aduh, duh, duh, duh!
Dialogue: 0,0:09:12.44,0:09:14.10,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aduh, duh, duh, duh!
Dialogue: 0,0:09:19.87,0:09:21.78,Default,,0,0,0,,{\blur3}{\fad(00,40)}Rasanya seperti mau mati.
Dialogue: 0,0:09:21.78,0:09:23.96,Default,,0,0,0,,{\blur3}{\fad(00,40)}Pengalaman yang benar-benar mengerikan.
Dialogue: 0,0:09:23.96,0:09:26.04,Default,,0,0,0,,{\blur3}{\fad(00,40)}Justru mengerikannya baru dimulai.
Dialogue: 0,0:09:29.89,0:09:31.87,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ayo kita hancurkan takdir...
Dialogue: 0,0:09:31.87,0:09:35.18,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tidak, kita hancurkan sistem menara ini!
Dialogue: 0,0:09:36.46,0:09:38.34,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ayo! Ayo! Ayo! Ayo!
Dialogue: 0,0:09:38.34,0:09:41.84,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kau pikir gerakan seperti itu\Nbisa mengalahkanku?
Dialogue: 0,0:09:48.69,0:09:49.80,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sudah cukup.
Dialogue: 0,0:09:59.78,0:10:02.56,Default,,0,0,0,,{\blur3}{\fad(00,40)}Siapa kau? Bening juga kau.
Dialogue: 0,0:10:02.56,0:10:04.15,Default,,0,0,0,,{\blur3}{\fad(00,40)}Wajahmu bening banget.
Dialogue: 0,0:10:04.15,0:10:06.66,Default,,0,0,0,,{\blur3}{\fad(00,40)}Mending kau saja yang temani aku, dah.
Dialogue: 0,0:10:07.07,0:10:08.73,Default,,0,0,0,,{\blur3}{\fad(00,40)}Maaf sudah mengganggu.
Dialogue: 0,0:10:09.02,0:10:12.41,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tapi, aku harus membuat\NJulius mengalahkanmu.
Dialogue: 0,0:10:12.58,0:10:14.04,Default,,0,0,0,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:10:14.31,0:10:16.53,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku tahu aku terselamatkan,
Dialogue: 0,0:10:16.53,0:10:19.79,Default,,0,0,0,,{\blur3}{\fad(00,40)}tapi, Echidna, dia ini siapa?
Dialogue: 0,0:10:19.79,0:10:21.36,Default,,0,0,0,,{\blur3}{\fad(00,40)}Menurut Natsuki,
Dialogue: 0,0:10:21.36,0:10:24.76,Default,,0,0,0,,{\blur3}{\fad(00,40)}dia berada dalam kondisi\Nyang sama sepertimu, Julius.
Dialogue: 0,0:10:24.76,0:10:25.51,Default,,0,0,0,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:10:25.96,0:10:27.04,Default,,0,0,0,,{\blur3}{\fad(00,40)}Benar, Julius.
Dialogue: 0,0:10:27.33,0:10:30.97,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sekarang aku benar-benar mengerti\Napa yang kamu rasakan.
Dialogue: 0,0:10:31.22,0:10:33.71,Default,,0,0,0,,{\blur3}{\fad(00,40)}Jadi, kau juga sama?
Dialogue: 0,0:10:33.71,0:10:34.99,Default,,0,0,0,,{\blur3}{\fad(00,40)}Hei, hei, hei.
Dialogue: 0,0:10:35.16,0:10:37.23,Default,,0,0,0,,{\blur3}{\fad(00,40)}Siapa kau ini, wajah bening?
Dialogue: 0,0:10:37.23,0:10:40.07,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kenapa tanganku tak mau bergerak\Nuntuk menghentikanmu.
Dialogue: 0,0:10:40.56,0:10:44.36,Default,,0,0,0,,{\blur3}{\fad(00,40)}Jangan-jangan,\Nkau berhasil melewati ujiannya?
Dialogue: 0,0:10:44.36,0:10:45.47,Default,,0,0,0,,{\blur3}{\fad(00,40)}Iya, benar.
Dialogue: 0,0:10:45.47,0:10:48.32,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kamu kalah karena menyentuh\Ndadaku dengan sumpit.
Dialogue: 0,0:10:48.32,0:10:52.04,Default,,0,0,0,,{\blur3}{\fad(00,40)}Hah! Kenapa cara kalahnya memuaskan banget.
Dialogue: 0,0:10:52.04,0:10:54.08,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sayang banget aku tidak ingat.
Dialogue: 0,0:10:54.73,0:10:56.66,Default,,0,0,0,,{\blur3}{\fad(00,40)}Julius, aku...
Dialogue: 0,0:10:56.83,0:10:58.04,Default,,0,0,0,,{\blur3}{\fad(00,40)}Pergilah,
Dialogue: 0,0:10:58.29,0:11:02.04,Default,,0,0,0,,{\blur3}{\fad(00,40)}Nona Cantik yang dalam kondisi sepertiku\Ndan tak kuketahui namanya.
Dialogue: 0,0:11:02.60,0:11:04.00,Default,,0,0,0,,{\blur3}{\fad(00,40)}Semoga berhasil.
Dialogue: 0,0:11:04.98,0:11:06.62,Default,,0,0,0,,{\blur3}{\fad(00,40)}Iya, kamu juga.
Dialogue: 0,0:11:13.82,0:11:18.23,Default,,0,0,0,,{\blur3}{\fad(00,40)}Apakah kau tidak pergi dan akan menyaksikan\Npertarunganku hingga akhir?
Dialogue: 0,0:11:18.23,0:11:21.36,Default,,0,0,0,,{\blur3}{\fad(00,40)}Jika kau memang mengizinkan.
Dialogue: 0,0:11:21.82,0:11:23.47,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tidak, bukan begitu.
Dialogue: 0,0:11:24.02,0:11:27.62,Default,,0,0,0,,{\blur3}{\fad(00,40)}Akulah yang memutuskan\Nbahwa memang harus begitu.
Dialogue: 0,0:11:28.13,0:11:29.04,Default,,0,0,0,,{\blur3}{\fad(00,40)}Itu karena...
Dialogue: 0,0:11:30.02,0:11:33.70,Default,,0,0,0,,{\blur3}{\fad(00,40)}Karena kau adalah kesatria Anastasia Hoshin.
Dialogue: 0,0:11:33.87,0:11:34.93,Default,,0,0,0,,{\blur3}{\fad(00,40)}Iya, 'kan?
Dialogue: 0,0:11:36.82,0:11:39.29,Default,,0,0,0,,{\blur3}{\fad(00,40)}Entah kenapa kata-kata itu\Nmemberikanku kekuatan.
Dialogue: 0,0:11:39.84,0:11:41.64,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kekuatan dari seseorang
Dialogue: 0,0:11:42.18,0:11:45.21,Default,,0,0,0,,{\blur3}{\fad(00,40)}yang memberikan keberanian\Ndan kepercayaannya kepadaku
Dialogue: 0,0:11:45.50,0:11:47.44,Default,,0,0,0,,{\blur3}{\fad(00,40)}yang mungkin sudah bukan siapa-siapa lagi.
Dialogue: 0,0:11:47.96,0:11:50.55,Default,,0,0,0,,{\blur3}{\fad(00,40)}Julius, ada pesan untukmu.
Dialogue: 0,0:11:51.51,0:11:55.36,Default,,0,0,0,,{\blur3}{\fad(00,40)}"Cepat bereskan dan bantulah yang lain."
Dialogue: 0,0:11:55.36,0:11:56.14,Default,,0,0,0,,{\blur3}{\fad(00,40)}Begitu katanya.
Dialogue: 0,0:11:57.56,0:11:59.56,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kalau dia berhasil keluar dari cangkangnya,
Dialogue: 0,0:11:59.73,0:12:02.19,Default,,0,0,0,,{\blur3}{\fad(00,40)}berarti aku juga tidak boleh kalah.
Dialogue: 0,0:12:05.87,0:12:07.61,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku Reid si pengayun tongkat.
Dialogue: 0,0:12:07.89,0:12:10.73,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ingatlah nama ini sebelum kau mati.
Dialogue: 0,0:12:12.27,0:12:13.78,Default,,0,0,0,,{\blur3}{\fad(00,40)}Izinkan aku memperkenalkan lagi.
Dialogue: 0,0:12:14.24,0:12:16.41,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku adalah Julius Juukulius.
Dialogue: 0,0:12:16.74,0:12:19.44,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kesatria nomor satu Nona Anastasia Hoshin.
Dialogue: 0,0:12:20.27,0:12:22.33,Default,,0,0,0,,{\blur3}{\fad(00,40)}Peranku sebagai kesatria tanpa nama
Dialogue: 0,0:12:23.11,0:12:24.24,Default,,0,0,0,,{\blur3}{\fad(00,40)}berakhir di sini.
Dialogue: 0,0:12:28.49,0:12:33.13,Default,,0,0,0,,{\blur3}{\fad(00,40)}Si imut Rui dan Roy tidak bisa diajak bicara.
Dialogue: 0,0:12:33.13,0:12:35.04,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ah, apa boleh buat.
Dialogue: 0,0:12:35.21,0:12:36.49,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kalau mereka tidak bisa,
Dialogue: 0,0:12:36.49,0:12:39.96,Default,,0,0,0,,{\blur3}{\fad(00,40)}berarti kami boleh melahapnya sampai habis.
Dialogue: 0,0:12:39.96,0:12:41.24,Default,,0,0,0,,{\blur3}{\fad(00,40)}Enak sekali hidupmu.
Dialogue: 0,0:12:42.40,0:12:45.27,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kau pikir punya hak untuk melakukan itu?
Dialogue: 0,0:12:46.31,0:12:47.55,Default,,0,0,0,,{\blur3}{\fad(00,40)}Dari yang kudengar,
Dialogue: 0,0:12:47.80,0:12:51.31,Default,,0,0,0,,{\blur3}{\fad(00,40)}kau telah merusak tali persaudaraan\Nantara aku dan Rem.
Dialogue: 0,0:12:54.24,0:12:56.64,Default,,0,0,0,,{\blur3}{\fad(00,40)}Matilah menjerit seperti babi.
Dialogue: 0,0:12:57.16,0:12:58.36,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:12:58.36,0:13:00.90,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kau sedang main-main, hah?
Dialogue: 0,0:13:01.03,0:13:01.65,Default,,0,0,0,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:13:01.74,0:13:03.24,Default,,0,0,0,,{\blur3}{\fad(00,40)}Hah?!
Dialogue: 0,0:13:05.31,0:13:07.91,Default,,0,0,0,,{\blur3}{\fad(00,40)}Suasana hatimu berubah,\Ngaya pedangmu juga berubah.
Dialogue: 0,0:13:08.11,0:13:12.69,Default,,0,0,0,,{\blur3}{\fad(00,40)}Padahal aku berharap ada\Nsuatu ledakan darimu.
Dialogue: 0,0:13:12.87,0:13:16.58,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kau kalah cuma gara-gara sibuk\Nmenjaga tata krama, hah?
Dialogue: 0,0:13:16.58,0:13:19.46,Default,,0,0,0,,{\blur3}{\fad(00,40)}Apa kau sudah puas cuma karena itu?
Dialogue: 0,0:13:19.46,0:13:21.89,Default,,0,0,0,,{\blur3}{\fad(00,40)}Semua kata-katamu terdengar tidak asing.
Dialogue: 0,0:13:21.89,0:13:24.11,Default,,0,0,0,,{\blur3}{\fad(00,40)}Benar-benar seenaknya bicara.
Dialogue: 0,0:13:24.11,0:13:25.93,Default,,0,0,0,,{\blur3}{\fad(00,40)}Hah! Tidak heran!
Dialogue: 0,0:13:25.93,0:13:28.55,Default,,0,0,0,,{\blur3}{\fad(00,40)}Pedangmu itu tak ada artinya\Nselain keputusasaan!
Dialogue: 0,0:13:31.40,0:13:34.49,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kau sok-sokan jadi seorang kesatria.
Dialogue: 0,0:13:34.49,0:13:38.02,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tapi, pada dasarnya kau sama sepertiku,\Ntukang pengayun tongkat.
Dialogue: 0,0:13:38.40,0:13:42.23,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku sampai enek melihatmu sok-sokan begitu.
Dialogue: 0,0:13:44.53,0:13:45.80,Default,,0,0,0,,{\blur3}{\fad(00,40)}Begitu.
Dialogue: 0,0:13:47.07,0:13:49.07,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kurasa akhirnya aku mengerti.
Dialogue: 0,0:13:49.36,0:13:50.28,Default,,0,0,0,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:13:50.98,0:13:54.45,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kenapa kau sangat terobsesi denganku...
Dialogue: 0,0:13:54.62,0:13:58.33,Default,,0,0,0,,{\blur3}{\fad(00,40)}Apakah kau melihat sesuatu\Nyang sama sepertimu dalam diriku?
Dialogue: 0,0:13:58.33,0:14:00.87,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku tak tahu hal bertele-tele begitu.
Dialogue: 0,0:14:00.87,0:14:03.36,Default,,0,0,0,,{\blur3}{\fad(00,40)}Firasatku cuma mengatakan,
Dialogue: 0,0:14:03.62,0:14:07.51,Default,,0,0,0,,{\blur3}{\fad(00,40)}kalau kau lebih menarik tanpa topengmu itu!
Dialogue: 0,0:14:07.80,0:14:09.96,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kau juga paham, 'kan?
Dialogue: 0,0:14:09.96,0:14:12.60,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kalau seperti itu,\Nkau takkan bisa menjangkauku.
Dialogue: 0,0:14:12.60,0:14:16.23,Default,,0,0,0,,{\blur3}{\fad(00,40)}Dan kau tak bisa sok keren di depan\Nsi bening yang di belakangmu itu!
Dialogue: 0,0:14:18.82,0:14:20.31,Default,,0,0,0,,{\blur3}{\fad(00,40)}Benar sekali.
Dialogue: 0,0:14:20.76,0:14:24.48,Default,,0,0,0,,{\blur3}{\fad(00,40)}Karena itulah aku tetap pada pendirianku!
Dialogue: 0,0:14:26.70,0:14:28.82,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kata-katamu memang benar.
Dialogue: 0,0:14:29.24,0:14:31.24,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ada banyak tebakanmu yang benar.
Dialogue: 0,0:14:31.96,0:14:35.08,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku bukanlah pewaris sah keluarga Juukulius.
Dialogue: 0,0:14:35.87,0:14:38.04,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku berasal dari rakyat biasa.
Dialogue: 0,0:14:38.42,0:14:40.31,Default,,0,0,0,,{\blur3}{\fad(00,40)}Hingga diangkat oleh ayahku yang sekarang.
Dialogue: 0,0:14:40.73,0:14:42.76,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tak mengenal pendidikan sebagai bangsawan,
Dialogue: 0,0:14:43.33,0:14:47.05,Default,,0,0,0,,{\blur3}{\fad(00,40)}dan aku terbentuk dari cara hidupku sendiri.
Dialogue: 0,0:14:47.05,0:14:49.63,Default,,0,0,0,,{\blur3}{\fad(00,40)}Berarti itu hanya topeng palsu.
Dialogue: 0,0:14:49.80,0:14:51.16,Default,,0,0,0,,{\blur3}{\fad(00,40)}Mungkin benar.
Dialogue: 0,0:14:51.44,0:14:56.35,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sejatinya aku mungkin hanya seorang bocah\Nyang tak mengenal ideal.
Dialogue: 0,0:14:57.02,0:14:58.31,Default,,0,0,0,,{\blur3}{\fad(00,40)}Namun, aku
Dialogue: 0,0:14:58.91,0:15:01.06,Default,,0,0,0,,{\blur3}{\fad(00,40)}telah bertemu dengan ideal tersebut.
Dialogue: 0,0:15:14.44,0:15:15.60,Default,,0,0,0,,{\blur3}{\fad(00,40)}Karena itulah,
Dialogue: 0,0:15:15.60,0:15:19.20,Default,,0,0,0,,{\blur3}{\fad(00,40)}aku tetap pada pendirianku\Ndan berpura-pura menjadi kesatria.
Dialogue: 0,0:15:19.58,0:15:23.17,Default,,0,0,0,,{\blur3}{\fad(00,40)}Mempertahankan penampilan\Ndan mengurung jati diriku dalam diri ini.
Dialogue: 0,0:15:24.31,0:15:27.29,Default,,0,0,0,,{\blur3}{\fad(00,40)}Berpostur yang baik, menjaga penampilan,
Dialogue: 0,0:15:27.71,0:15:32.18,Default,,0,0,0,,{\blur3}{\fad(00,40)}menjadikannya sosok yang aku dambakan\Ndan tongkat untuk meneguhkan tekad.
Dialogue: 0,0:15:32.82,0:15:35.64,Default,,0,0,0,,{\blur3}{\fad(00,40)}Itulah topeng palsu yang aku abdikan
Dialogue: 0,0:15:35.81,0:15:37.11,Default,,0,0,0,,{\blur3}{\fad(00,40)}untuk kupakai selamanya!
Dialogue: 0,0:15:37.91,0:15:40.13,Default,,0,0,0,,{\blur3}{\fad(00,40)}Pasti ada yang menganggap\Nremeh penampilanku.
Dialogue: 0,0:15:40.69,0:15:43.06,Default,,0,0,0,,{\blur3}{\fad(00,40)}Namun, aku percaya
Dialogue: 0,0:15:43.23,0:15:46.40,Default,,0,0,0,,{\blur3}{\fad(00,40)}ada yang menganggap penampilanku\Nsebagai sesuatu yang dikagumi.
Dialogue: 0,0:15:47.15,0:15:50.95,Default,,0,0,0,,{\blur3}{\fad(00,40)}Seperti diriku yang terus mendambakan\Nsosok seorang kesatria.
Dialogue: 0,0:15:58.36,0:16:01.58,Default,,0,0,0,,{\blur3}{\fad(00,40)}Maafkan aku, kuncup-kuncupku.
Dialogue: 0,0:16:07.71,0:16:10.36,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ada bagian dari diriku\Nyang takut untuk berubah.
Dialogue: 0,0:16:11.17,0:16:14.05,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku tinggalkan diriku yang lemah,
Dialogue: 0,0:16:14.33,0:16:16.60,Default,,0,0,0,,{\blur3}{\fad(00,40)}menyedihkan, dan tak layak dibanggakan itu.
Dialogue: 0,0:16:17.73,0:16:19.02,Default,,0,0,0,,{\blur3}{\fad(00,40)}Wahai kuncup-kuncupku.
Dialogue: 0,0:16:19.51,0:16:21.11,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku akan membebaskan kalian.
Dialogue: 0,0:16:22.04,0:16:25.33,Default,,0,0,0,,{\blur3}{\fad(00,40)}Maaf karena aku terus berpegang\Npada ikatan yang telah lama putus.
Dialogue: 0,0:16:29.78,0:16:33.74,Default,,0,0,0,,{\blur3}{\fad(00,40)}Meski begitu, aku akan\Nmemanggil kalian sekali lagi!
Dialogue: 0,0:16:34.56,0:16:36.20,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku mencintai kalian.
Dialogue: 0,0:16:36.78,0:16:39.73,Default,,0,0,0,,{\blur3}{\fad(00,40)}Jika kalian menerima\Nsosok kepura-puraanku ini,
Dialogue: 0,0:16:40.09,0:16:41.45,Default,,0,0,0,,{\blur3}{\fad(00,40)}mari kita ikat kembali!
Dialogue: 0,0:16:42.02,0:16:45.71,Default,,0,0,0,,{\blur3}{\fad(00,40)}Dengan menjalin kontrak baru\Nantara aku dan kalian!
Dialogue: 0,0:16:52.58,0:16:53.60,Default,,0,0,0,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:16:54.38,0:16:55.78,Default,,0,0,0,,{\blur3}{\fad(00,40)}Mulai sekarang,
Dialogue: 0,0:16:55.78,0:16:59.71,Default,,0,0,0,,{\blur3}{\fad(00,40)}dengan lebih dalam, lembut,\Ndan meski saling melukai,
Dialogue: 0,0:17:00.04,0:17:02.02,Default,,0,0,0,,{\blur3}{\fad(00,40)}aku akan terus melangkah di jalan ini.
Dialogue: 0,0:17:03.73,0:17:07.91,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kau jadi lebih kuat\Nsetelah melepas cangkangmu.
Dialogue: 0,0:17:11.06,0:17:12.94,Default,,0,0,0,,{\blur3}{\fad(00,40)}Akan kubuat kau menangis!
Dialogue: 0,0:17:20.24,0:17:22.16,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kenapa kau tertawa?
Dialogue: 0,0:17:22.36,0:17:25.32,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tidak, aku hanya terpikirkan sesuatu.
Dialogue: 0,0:17:25.73,0:17:27.63,Default,,0,0,0,,{\blur3}{\fad(00,40)}Begitu kembali dari tempat ini,
Dialogue: 0,0:17:27.79,0:17:30.38,Default,,0,0,0,,{\blur3}{\fad(00,40)}aku ingin menantang temanku, Reinhard.
Dialogue: 0,0:17:31.53,0:17:33.84,Default,,0,0,0,,{\blur3}{\fad(00,40)}Siapa tadi namamu?
Dialogue: 0,0:17:34.82,0:17:36.53,Default,,0,0,0,,{\blur3}{\fad(00,40)}Julius Juukulius.
Dialogue: 0,0:17:36.96,0:17:40.22,Default,,0,0,0,,{\blur3}{\fad(00,40)}Namaku mudah dilupakan,\Njadi kuharap kau mengingatnya.
Dialogue: 0,0:17:49.47,0:17:51.22,Default,,0,0,0,,{\blur3}{\fad(00,40)}Al Cranvel!
Dialogue: 0,0:17:54.00,0:17:54.94,Default,,0,0,0,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:17:55.29,0:17:56.71,Default,,0,0,0,,{\blur3}{\fad(00,40)}Terserah kau saja.
Dialogue: 0,0:17:57.24,0:17:57.98,Default,,0,0,0,,{\blur3}{\fad(00,40)}Serang!
Dialogue: 0,0:17:58.96,0:17:59.87,Default,,0,0,0,,{\blur3}{\fad(00,40)}Rasakan!
Dialogue: 0,0:18:12.89,0:18:13.59,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ia!
Dialogue: 0,0:18:18.16,0:18:18.98,Default,,0,0,0,,{\blur3}{\fad(00,40)}Iku!
Dialogue: 0,0:18:29.62,0:18:30.31,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kua!
Dialogue: 0,0:18:30.47,0:18:31.48,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ia!
Dialogue: 0,0:18:37.28,0:18:38.56,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ia! Aro!
Dialogue: 0,0:18:51.50,0:18:54.87,Default,,0,0,0,,{\blur3}{\fad(00,40)}Al Clarista!
Dialogue: 0,0:19:10.40,0:19:14.22,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku dilahirkan ke dunia ini tanpa tujuan.
Dialogue: 0,0:19:15.04,0:19:18.00,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku tidak tahu untuk apa aku dilahirkan.
Dialogue: 0,0:19:19.38,0:19:20.15,Default,,0,0,0,,{\blur3}{\fad(00,40)}Namun...
Dialogue: 0,0:19:24.91,0:19:26.96,Default,,0,0,0,,{\blur3}{\fad(00,40)}Apa kau ingat, Ana?
Dialogue: 0,0:19:28.29,0:19:30.78,Default,,0,0,0,,{\blur3}{\fad(00,40)}Di sinilah aku bertemu denganmu.
Dialogue: 0,0:19:32.58,0:19:35.60,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kau menyebut dirimu serakah
Dialogue: 0,0:19:35.98,0:19:38.84,Default,,0,0,0,,{\blur3}{\fad(00,40)}dan mengatakan ingin mendapatkan segalanya.
Dialogue: 0,0:19:39.58,0:19:43.20,Default,,0,0,0,,{\blur3}{\fad(00,40)}Lantas kenapa kau malah mengurung diri\Ndan tidak mau keluar?
Dialogue: 0,0:19:45.00,0:19:47.14,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kau yang bersembunyi di dalam Odo,
Dialogue: 0,0:19:47.40,0:19:50.24,Default,,0,0,0,,{\blur3}{\fad(00,40)}berada dalam kondisi\Nyang tak tersentuh dunia luar.
Dialogue: 0,0:19:50.80,0:19:54.82,Default,,0,0,0,,{\blur3}{\fad(00,40)}Jika keluar, kau akan terkena\Npengaruh Otoritas sang Rakus.
Dialogue: 0,0:19:54.98,0:19:55.89,Default,,0,0,0,,{\blur3}{\fad(00,40)}Dengan kata lain,
Dialogue: 0,0:19:56.64,0:19:59.94,Default,,0,0,0,,{\blur3}{\fad(00,40)}kau akan melupakan Julius Juukulius.
Dialogue: 0,0:20:01.07,0:20:03.84,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kau takut akan hal itu.
Dialogue: 0,0:20:04.37,0:20:06.60,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kau yang menginginkan segalanya,
Dialogue: 0,0:20:06.60,0:20:09.04,Default,,0,0,0,,{\blur3}{\fad(00,40)}malah sangat takut kehilangan sesuatu.
Dialogue: 0,0:20:09.73,0:20:13.18,Default,,0,0,0,,{\blur3}{\fad(00,40)}Namun, apa kau yakin tidak apa-apa?
Dialogue: 0,0:20:19.07,0:20:22.69,Default,,0,0,0,,{\blur3}{\fad(00,40)}Masa tidak mau melihat\Nsisi keren kesatriamu?
Dialogue: 0,0:20:23.24,0:20:25.18,Default,,0,0,0,,{\blur3}{\fad(00,40)}Hal yang disia-siakan begitu
Dialogue: 0,0:20:25.80,0:20:28.27,Default,,0,0,0,,{\blur3}{\fad(00,40)}sangat tidak cocok dengan dirimu yang pelit.
Dialogue: 0,0:20:51.29,0:20:52.12,Default,,0,0,0,,{\blur3}{\fad(00,40)}Julius!
Dialogue: 0,0:20:52.80,0:20:55.20,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kalahkan dia, Kesatriaku!
Dialogue: 0,0:21:17.52,0:21:18.22,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sialan.
Dialogue: 0,0:21:18.82,0:21:20.18,Default,,0,0,0,,{\blur3}{\fad(00,40)}Halah.
Dialogue: 0,0:21:20.18,0:21:24.29,Default,,0,0,0,,{\blur3}{\fad(00,40)}Malah berakhir dengan membosankan begini.
Dialogue: 0,0:21:31.56,0:21:34.02,Default,,0,0,0,,{\blur3}{\fad(00,40)}Pada akhirnya, ya seperti inilah.
Dialogue: 0,0:21:34.27,0:21:39.42,Default,,0,0,0,,{\blur3}{\fad(00,40)}Manusia sepertiku terlalu besar untuk\Nditampung pada wadah yang bukan diriku.
Dialogue: 0,0:21:42.73,0:21:47.09,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tubuh Roy Alphard tidak mampu\Nmenahan kekuatanmu.
Dialogue: 0,0:21:47.26,0:21:49.76,Default,,0,0,0,,{\blur3}{\fad(00,40)}Hei, jangan salah paham dulu.
Dialogue: 0,0:21:50.31,0:21:52.16,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kalau ini tubuhku sendiri,
Dialogue: 0,0:21:52.16,0:21:54.98,Default,,0,0,0,,{\blur3}{\fad(00,40)}kau takkan mungkin bisa\Nmenyentuhku sedikit pun.
Dialogue: 0,0:21:55.20,0:21:57.20,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sejak awal aku memang tidak berniat begitu.
Dialogue: 0,0:21:57.35,0:21:59.60,Default,,0,0,0,,{\blur3}{\fad(00,40)}Halah, tidak asyik.
Dialogue: 0,0:22:02.84,0:22:06.65,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku sangat menghormati kekuatanmu itu.
Dialogue: 0,0:22:06.95,0:22:10.07,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku tidak butuh dikagumi sesama cowok.
Dialogue: 0,0:22:10.80,0:22:13.31,Default,,0,0,0,,{\blur3}{\fad(00,40)}Yang menang tetaplah aku, Julius.
Dialogue: 0,0:22:17.96,0:22:18.60,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:22:18.93,0:22:21.80,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sampai akhir pun, ini adalah kemenanganmu,
Dialogue: 0,0:22:22.16,0:22:23.42,Default,,0,0,0,,{\blur3}{\fad(00,40)}Reid Astrea.
Dialogue: 0,0:22:23.67,0:22:24.40,Default,,0,0,0,,{\blur3}{\fad(00,40)}Hah!
Dialogue: 0,0:22:25.22,0:22:27.22,Default,,0,0,0,,{\blur3}{\fad(00,40)}Boleh juga penampilanmu,
Dialogue: 0,0:22:31.56,0:22:33.44,Default,,0,0,0,,{\blur3}{\fad(00,40)}pecundang.
Dialogue: 0,0:22:52.41,0:22:54.07,Default,,0,0,0,,{\blur3}{\fad(00,40)}Suatu kehormatan bertemu denganmu.
Dialogue: 0,0:22:54.36,0:22:55.37,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku...
Dialogue: 0,0:22:55.89,0:22:58.07,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku Anastasia Hoshin.
Dialogue: 0,0:22:58.38,0:23:00.67,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku menginginkan segala\Nyang ada di dunia ini.
Dialogue: 0,0:23:01.51,0:23:04.36,Default,,0,0,0,,{\blur3}{\fad(00,40)}Jadi, Kakak ganteng yang keren.
Dialogue: 0,0:23:04.36,0:23:05.47,Default,,0,0,0,,{\blur3}{\fad(00,40)}Siapa namamu?
Dialogue: 0,0:23:05.63,0:23:06.47,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:23:09.33,0:23:11.58,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku Julius Juukulius.
Dialogue: 0,0:23:12.29,0:23:13.96,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kesatria nomor satumu.
Dialogue: 0,0:23:14.93,0:23:16.29,Default,,0,0,0,,{\blur3}{\fad(00,40)}Mungkin kau melupakanku,
Dialogue: 0,0:23:16.71,0:23:19.98,Default,,0,0,0,,{\blur3}{\fad(00,40)}tetapi, aku adalah orang\Nyang mendedikasikan pedangku padamu,
Dialogue: 0,0:23:20.87,0:23:24.33,Default,,0,0,0,,{\blur3}{\fad(00,40)}yang memberikan seluruh kekuatanku untukmu,
Dialogue: 0,0:23:24.69,0:23:27.33,Default,,0,0,0,,{\blur3}{\fad(00,40)}dan yang mendukung ambisimu.
Dialogue: 0,0:23:27.33,0:23:28.53,Default,,0,0,0,,{\blur3}{\fad(00,40)}Masa?
Dialogue: 0,0:23:28.53,0:23:30.86,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku tidak begitu ingat, sih.
Dialogue: 0,0:23:31.03,0:23:31.87,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tapi,
Dialogue: 0,0:23:32.84,0:23:34.87,Default,,0,0,0,,{\blur3}{\fad(00,40)}begitu melihatmu, aku langsung terpikir,
Dialogue: 0,0:23:35.60,0:23:39.13,Default,,0,0,0,,{\blur3}{\fad(00,40)}bahwa Kakak ini harus menjadi milikku.
Dialogue: 0,0:23:47.33,0:23:48.11,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sampai!
Dialogue: 0,0:23:48.71,0:23:49.42,Default,,0,0,0,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:23:49.98,0:23:53.29,Default,,0,0,0,,{\blur3}{\fad(00,40)}Lantai satu itu maksudnya di luar ruangan?
Dialogue: 0,0:23:54.60,0:23:56.84,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tempat ini lebih tinggi dari awan.
Dialogue: 0,0:24:06.80,0:24:07.82,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kamu siapa?
Dialogue: 0,0:24:09.65,0:24:13.71,Default,,0,0,0,,{\blur3}{\fad(00,40)}Engkau, yang telah mencapai puncak menara.
Dialogue: 0,0:24:14.44,0:24:18.33,Default,,0,0,0,,{\blur3}{\fad(00,40)}Pemohon kemahakuasaan\Nyang menapakkan kaki di lantai pertama.
Dialogue: 0,0:24:19.80,0:24:21.73,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku adalah Volcanica.
Dialogue: 0,0:24:22.16,0:24:24.42,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sesuai dengan perjanjian kuno,
Dialogue: 0,0:24:24.58,0:24:28.51,Default,,0,0,0,,{\blur3}{\fad(00,40)}aku akan menanyakan keinginan\Nsiapa pun yang mencapai puncak.
