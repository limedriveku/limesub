Dialogue: 0,0:21:27.47,0:21:28.63,5-normal,,0,0,0,,{\fs100\bord0\shad0\pos(960,304)\c&H000000&}Ram
Dialogue: 0,0:00:06.78,0:00:09.58,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku adalah Volcanica.
Dialogue: 0,0:00:09.91,0:00:12.20,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sesuai dengan perjanjian kuno,
Dialogue: 0,0:00:12.89,0:00:16.58,Default,,0,0,0,,{\blur3}{\fad(00,40)}aku akan menanyakan keinginan\Nsiapa pun yang mencapai puncak.
Dialogue: 0,0:00:18.60,0:00:21.38,Default,,0,0,0,,{\blur3}{\fad(00,40)}Naga Suci Volcanica.
Dialogue: 0,0:00:24.93,0:00:26.91,Default,,0,0,0,,{\blur3}{\fad(00,40)}Be-Begini, Volcanica.
Dialogue: 0,0:00:27.47,0:00:29.76,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku ingin menyelesaikan ujian lantai satu.
Dialogue: 0,0:00:32.64,0:00:35.20,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku tidak tahu seberapa berat ujiannya.
Dialogue: 0,0:00:35.71,0:00:40.13,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tapi, kalau aku tidak berusaha,\NSubaru dan lainnya akan dalam masalah.
Dialogue: 0,0:00:40.44,0:00:42.96,Default,,0,0,0,,{\blur3}{\fad(00,40)}Karena itu, ayo berikan apa pun ujiannya.
Dialogue: 0,0:00:47.64,0:00:51.89,Default,,0,0,0,,{\blur3}{\fad(00,40)}Engkau, yang telah mencapai puncak menara.
Dialogue: 0,0:00:52.53,0:00:56.37,Default,,0,0,0,,{\blur3}{\fad(00,40)}Pemohon kemahakuasaan\Nyang menapakkan kaki di lantai pertama.
Dialogue: 0,0:01:00.60,0:01:02.71,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku adalah Volcanica.
Dialogue: 0,0:01:03.51,0:01:05.80,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sesuai dengan perjanjian kuno,
Dialogue: 0,0:01:05.96,0:01:09.64,Default,,0,0,0,,{\blur3}{\fad(00,40)}aku akan menanyakan keinginan\Nsiapa pun yang mencapai puncak.
Dialogue: 0,0:01:10.82,0:01:15.02,Default,,0,0,0,,{\blur3}{\fad(00,40)}Lo? Apa karena aku belum\Nmemperkenalkan diri?
Dialogue: 0,0:01:15.38,0:01:16.33,Default,,0,0,0,,{\blur3}{\fad(00,40)}Maafkan aku.
Dialogue: 0,0:01:16.82,0:01:18.20,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku Emilia.
Dialogue: 0,0:01:18.20,0:01:19.62,Default,,0,0,0,,{\blur3}{\fad(00,40)}Hanya Emilia.
Dialogue: 0,0:01:20.04,0:01:23.98,Default,,0,0,0,,{\blur3}{\fad(00,40)}Saat ini, banyak orang\Nyang tidak ingat padaku,
Dialogue: 0,0:01:23.98,0:01:26.78,Default,,0,0,0,,{\blur3}{\fad(00,40)}jadi aku bingung kalau harus membuktikannya.
Dialogue: 0,0:01:27.02,0:01:27.78,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tapi,
Dialogue: 0,0:01:28.02,0:01:29.36,Default,,0,0,0,,{\blur3}{\fad(00,40)}aku sungguh Emilia!
Dialogue: 0,0:01:37.91,0:01:38.83,Default,,0,0,0,,{\blur3}{\fad(00,40)}Dingin.
Dialogue: 0,0:01:40.56,0:01:44.50,Default,,0,0,0,,{\blur3}{\fad(00,40)}Engkau, yang telah mencapai puncak menara.
Dialogue: 0,0:01:45.33,0:01:48.71,Default,,0,0,0,,{\blur3}{\fad(00,40)}Pemohon kemahakuasaan\Nyang menapakkan kaki di lantai pertama.
Dialogue: 0,0:01:49.71,0:01:51.96,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku adalah Volcanica.
Dialogue: 0,0:01:52.76,0:01:54.80,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sesuai dengan perjanjian kuno,
Dialogue: 0,0:01:55.13,0:01:58.84,Default,,0,0,0,,{\blur3}{\fad(00,40)}aku akan menanyakan keinginan\Nsiapa pun yang mencapai puncak.
Dialogue: 0,0:02:00.29,0:02:04.69,Default,,0,0,0,,{\blur3}{\fad(00,40)}Jangan-jangan,\Nsaking tuanya dia jadi lupa soal ujian?
Dialogue: 0,0:02:07.11,0:02:08.52,Default,,0,0,0,,{\blur3}{\fad(00,40)}Hei, Volcanica.
Dialogue: 0,0:02:09.27,0:02:13.32,Default,,0,0,0,,{\blur3}{\fad(00,40)}Engkau, yang telah mencapai puncak menara.
Dialogue: 0,0:02:13.87,0:02:17.58,Default,,0,0,0,,{\blur3}{\fad(00,40)}Pemohon kemahakuasaan\Nyang menapakkan kaki di lantai pertama.
Dialogue: 0,0:02:18.27,0:02:20.11,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku adalah Volcanica.
Dialogue: 0,0:02:20.11,0:02:21.86,Default,,0,0,0,,{\blur3}{\fad(00,40)}- Sesuai dengan perjanjian kuno,\N- Duh, percuma!
Dialogue: 0,0:02:21.87,0:02:24.00,Default,,0,0,0,,{\blur3}{\fad(00,40)}Padahal aku ingin mendengar kelanjutannya.
Dialogue: 0,0:02:24.00,0:02:26.42,Default,,0,0,0,,{\blur3}{\fad(00,40)}aku akan menanyakan keinginan\Nsiapa pun yang mencapai puncak.
Dialogue: 0,0:02:32.33,0:02:33.55,Default,,0,0,0,,{\blur3}{\fad(00,40)}Jangan-jangan,
Dialogue: 0,0:02:33.88,0:02:35.38,Default,,0,0,0,,{\blur3}{\fad(00,40)}di sana ada sesuatu?
Dialogue: 0,0:02:39.62,0:02:41.97,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tuh, 'kan?\NPasti ada sesuatu, 'kan?
Dialogue: 0,0:02:47.07,0:02:49.40,Default,,0,0,0,,{\blur3}{\fad(00,40)}Niatku memang tak boleh setengah-setengah.
Dialogue: 0,0:02:50.11,0:02:51.98,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku juga akan bersungguh-sungguh.
Dialogue: 0,0:02:55.38,0:02:56.86,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ice Brand Arts
Dialogue: 0,0:02:57.74,0:02:59.70,Default,,0,0,0,,{\blur3}{\fad(00,40)}dan para prajurit es!
Dialogue: 0,0:03:00.18,0:03:01.31,Default,,0,0,0,,{\blur3}{\fad(00,40)}Bantulah aku!
Dialogue: 0,0:03:03.00,0:03:04.60,Default,,0,0,0,,{\blur3}{\fad(00,40)}Bersiaplah, Tukang Tidur!
Dialogue: 0,0:03:05.24,0:03:07.27,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kalau mau bangun, sebaiknya cepatlah bangun!
Dialogue: 0,0:03:07.31,0:03:07.96,Default,,0,0,0,,{\blur3}{\fad(00,40)}Re:ZERO -Starting Life in Another World-\NSeason 4
Dialogue: 0,0:03:26.67,0:03:28.58,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sungguh tak tertahankan!
Dialogue: 0,0:03:28.58,0:03:33.57,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kakak memang hidangan\Nyang sangat cocok dengan selera kami!
Dialogue: 0,0:03:37.86,0:03:39.28,Default,,0,0,0,,{\blur3}{\fad(00,40)}Bagus.
Dialogue: 0,0:03:39.28,0:03:41.20,Default,,0,0,0,,{\blur3}{\fad(00,40)}Bagus, bagus juga.
Dialogue: 0,0:03:41.20,0:03:44.31,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sungguh bagus, sangat bagus, amat bagus.
Dialogue: 0,0:03:44.31,0:03:46.58,Default,,0,0,0,,{\blur3}{\fad(00,40)}Memang bagus, tentu bagus.
Dialogue: 0,0:03:46.58,0:03:48.50,Default,,0,0,0,,{\blur3}{\fad(00,40)}Karena bagus inilah,
Dialogue: 0,0:03:48.84,0:03:51.38,Default,,0,0,0,,{\blur3}{\fad(00,40)}kami makan dengan rakus.
Dialogue: 0,0:03:56.55,0:03:58.47,Default,,0,0,0,,{\blur3}{\fad(00,40)}Meskipun masih jauh dari sempurna,
Dialogue: 0,0:03:59.98,0:04:01.51,Default,,0,0,0,,{\blur3}{\fad(00,40)}tapi benar kata Barusu.
Dialogue: 0,0:04:02.18,0:04:03.51,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kita kerahkan semuanya.
Dialogue: 0,0:04:04.18,0:04:05.47,Default,,0,0,0,,{\blur3}{\fad(00,40)}Untuk itu, Ram...
Dialogue: 0,0:04:07.27,0:04:09.53,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku yang akan menanggung bebanmu.
Dialogue: 0,0:04:13.49,0:04:16.01,Default,,0,0,0,,{\blur3}{\fad(00,40)}Cor Leonis adalah Otoritas.
Dialogue: 0,0:04:20.24,0:04:21.24,Default,,0,0,0,,{\blur3}{\fad(00,40)}Dengan kata lain,
Dialogue: 0,0:04:21.24,0:04:25.70,Default,,0,0,0,,{\blur3}{\fad(00,40)}makin prima kondisiku,\Nmakin menderita kondisimu?
Dialogue: 0,0:04:25.70,0:04:29.50,Default,,0,0,0,,{\blur3}{\fad(00,40)}Rasanya seperti menyerahkan tombol nuklir\Npada orang yang harusnya tidak memegangnya.
Dialogue: 0,0:04:30.36,0:04:31.21,Default,,0,0,0,,{\blur3}{\fad(00,40)}Jangan bodoh.
Dialogue: 0,0:04:31.93,0:04:33.67,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku tidak akan menahan diri.
Dialogue: 0,0:04:33.67,0:04:35.11,Default,,0,0,0,,{\blur3}{\fad(00,40)}Baguslah.
Dialogue: 0,0:04:35.11,0:04:37.17,Default,,0,0,0,,{\blur3}{\fad(00,40)}Habisi si Rakus itu.
Dialogue: 0,0:04:38.60,0:04:41.47,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kalau terlalu lama, Barusu bisa mati.
Dialogue: 0,0:04:44.22,0:04:46.42,Default,,0,0,0,,{\blur3}{\fad(00,40)}Bertahanlah sekuat tenaga, Barusu.
Dialogue: 0,0:04:47.20,0:04:48.39,Default,,0,0,0,,{\blur3}{\fad(00,40)}Atau Rem akan menangis.
Dialogue: 0,0:04:51.65,0:04:52.44,Default,,0,0,0,,{\blur3}{\fad(00,40)}Subaru!
Dialogue: 0,0:04:52.96,0:04:55.16,Default,,0,0,0,,{\blur3}{\fad(00,40)}Efek dari Ram sudah terasa, ya?
Dialogue: 0,0:04:55.16,0:04:57.09,Default,,0,0,0,,{\blur3}{\fad(00,40)}Masih bisa kutahan.
Dialogue: 0,0:04:57.42,0:05:00.32,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ini adalah perjuangan kami berdua!
Dialogue: 0,0:05:00.32,0:05:01.91,Default,,0,0,0,,{\blur3}{\fad(00,40)}Semuanya, satukan kekuatan!
Dialogue: 0,0:05:09.69,0:05:12.20,Default,,0,0,0,,{\blur3}{\fad(00,40)}Abang masih fokus?
Dialogue: 0,0:05:12.20,0:05:14.76,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kalau Abang dan Beatrice tumbang,
Dialogue: 0,0:05:14.76,0:05:16.58,Default,,0,0,0,,{\blur3}{\fad(00,40)}kita langsung tamat, lo!
Dialogue: 0,0:05:16.58,0:05:17.92,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku tahu.
Dialogue: 0,0:05:19.31,0:05:23.20,Default,,0,0,0,,{\blur3}{\fad(00,40)}Hei, Meili, kalau semua ini selesai,\Nkau mau jadi bagian keluarga kami?
Dialogue: 0,0:05:24.04,0:05:26.47,Default,,0,0,0,,{\blur3}{\fad(00,40)}Baru juga dibilang!\NFokus, dong!
Dialogue: 0,0:05:27.31,0:05:28.93,Default,,0,0,0,,{\blur3}{\fad(00,40)}Dasar aneh.
Dialogue: 0,0:05:28.93,0:05:32.60,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku jadi ikut-ikutan seperti orang bodoh.
Dialogue: 0,0:05:36.02,0:05:36.98,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sekarang!
Dialogue: 0,0:05:47.03,0:05:47.99,Default,,0,0,0,,{\blur3}{\fad(00,40)}Meili!
Dialogue: 0,0:06:13.31,0:06:14.33,Default,,0,0,0,,{\blur3}{\fad(00,40)}Yang seperti ini...
Dialogue: 0,0:06:14.33,0:06:16.51,Default,,0,0,0,,{\blur3}{\fad(00,40)}Mau diempas pakai angin?
Dialogue: 0,0:06:16.51,0:06:18.29,Default,,0,0,0,,{\blur3}{\fad(00,40)}Percuma saja.
Dialogue: 0,0:06:18.29,0:06:20.56,Default,,0,0,0,,{\blur3}{\fad(00,40)}Soalnya sudah terikat dengan ruang.
Dialogue: 0,0:06:20.56,0:06:23.73,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kau pun takkan bisa menyingkirkannya.
Dialogue: 0,0:06:23.73,0:06:26.04,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sayang sekali.
Dialogue: 0,0:06:41.51,0:06:43.71,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kakak yakin?
Dialogue: 0,0:06:43.71,0:06:44.84,Default,,0,0,0,,{\blur3}{\fad(00,40)}Serius?
Dialogue: 0,0:06:44.84,0:06:47.00,Default,,0,0,0,,{\blur3}{\fad(00,40)}Bicaramu seperti Barusu.
Dialogue: 0,0:06:47.00,0:06:49.10,Default,,0,0,0,,{\blur3}{\fad(00,40)}Baguslah, aku jadi tak ragu menghajarmu.
Dialogue: 0,0:06:58.78,0:07:00.69,Default,,0,0,0,,{\blur3}{\fad(00,40)}Bagaimana? Kau menyesal?
Dialogue: 0,0:07:04.38,0:07:06.61,Default,,0,0,0,,{\blur3}{\fad(00,40)}Bagaimana? Kau menyesal?
Dialogue: 0,0:07:08.32,0:07:10.91,Default,,0,0,0,,{\blur3}{\fad(00,40)}Bagaimana? Kau menyesal?
Dialogue: 0,0:07:11.79,0:07:12.74,Default,,0,0,0,,{\blur3}{\fad(00,40)}Gerhana Matahari!
Dialogue: 0,0:07:23.24,0:07:25.72,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku dengar berubah wujud itu\Ntriknya si Nafsu,
Dialogue: 0,0:07:26.51,0:07:28.68,Default,,0,0,0,,{\blur3}{\fad(00,40)}tapi aku tak punya waktu meladenimu.
Dialogue: 0,0:07:29.60,0:07:32.93,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kembalikan semua\Nyang kau makan sebagai Rakus.
Dialogue: 0,0:07:33.56,0:07:35.89,Default,,0,0,0,,{\blur3}{\fad(00,40)}- Dengan begitu...\N- Dengan begitu apa?
Dialogue: 0,0:07:36.27,0:07:38.77,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kau akan membiarkan kami pergi?
Dialogue: 0,0:07:38.77,0:07:41.82,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tidak, dengan begitu\Naku akan langsung membunuhmu.
Dialogue: 0,0:07:41.98,0:07:43.40,Default,,0,0,0,,{\blur3}{\fad(00,40)}Penawaran yang bagus, 'kan?
Dialogue: 0,0:07:43.40,0:07:46.15,Default,,0,0,0,,{\blur3}{\fad(00,40)}Hukuman mati berkali-kali\Naku ampuni dengan satu kematian.
Dialogue: 0,0:07:47.62,0:07:48.82,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tapi, aneh.
Dialogue: 0,0:07:48.99,0:07:52.91,Default,,0,0,0,,{\blur3}{\fad(00,40)}Jika kau punya jurus seperti itu,\Nharusnya kau gunakan sejak tadi.
Dialogue: 0,0:07:53.49,0:07:55.24,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kenapa kau sembunyikan?
Dialogue: 0,0:07:58.02,0:08:00.00,Default,,0,0,0,,{\blur3}{\fad(00,40)}Apa ada alasan kenapa tidak digunakan?
Dialogue: 0,0:08:01.07,0:08:02.96,Default,,0,0,0,,{\blur3}{\fad(00,40)}Seperti membebani tubuhmu?
Dialogue: 0,0:08:04.09,0:08:05.60,Default,,0,0,0,,{\blur3}{\fad(00,40)}Astaga.
Dialogue: 0,0:08:05.60,0:08:09.68,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku belum pernah bertemu gadis\Nyang mengerikan seperti ini.
Dialogue: 0,0:08:10.07,0:08:10.97,Default,,0,0,0,,{\blur3}{\fad(00,40)}Namun...
Dialogue: 0,0:08:15.27,0:08:17.23,Default,,0,0,0,,{\blur3}{\fad(00,40)}Bukan hanya kau
Dialogue: 0,0:08:17.39,0:08:20.27,Default,,0,0,0,,{\blur3}{\fad(00,40)}yang sedang mengamati pergerakanmu!
Dialogue: 0,0:08:23.31,0:08:26.24,Default,,0,0,0,,{\blur3}{\fad(00,40)}Dimulai dengan pendekatan kami...
Dialogue: 0,0:08:26.56,0:08:29.64,Default,,0,0,0,,{\blur3}{\fad(00,40)}Lalu diikuti dengan pukulan telak kami!
Dialogue: 0,0:08:33.96,0:08:36.15,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kami sudah tahu.
Dialogue: 0,0:08:36.60,0:08:41.22,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kakaknya Rem tidak bisa terus-terusan\Nbergerak seperti ini tanpa suatu trik.
Dialogue: 0,0:08:41.91,0:08:47.84,Default,,0,0,0,,{\blur3}{\fad(00,40)}Lagi pula, kami tidak bermaksud\Nuntuk adu kekuatan denganmu.
Dialogue: 0,0:08:50.24,0:08:52.02,Default,,0,0,0,,{\blur3}{\fad(00,40)}Cepat sekali dia memutuskan untuk kabur.
Dialogue: 0,0:08:52.39,0:08:54.27,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tidak, daripada itu...
Dialogue: 0,0:08:56.60,0:08:58.60,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kalau dia tahu penglihatan jauhku,
Dialogue: 0,0:08:58.77,0:09:01.31,Default,,0,0,0,,{\blur3}{\fad(00,40)}harusnya tahu tidak mungkin\Nbisa kabur begitu saja.
Dialogue: 0,0:09:03.24,0:09:04.13,Default,,0,0,0,,{\blur3}{\fad(00,40)}Rem.
Dialogue: 0,0:09:24.78,0:09:27.67,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ram, kaburlah dari kepungan ini!
Dialogue: 0,0:09:28.20,0:09:30.69,Default,,0,0,0,,{\blur3}{\fad(00,40)}Yang penting kau tetap hidup!
Dialogue: 0,0:09:31.84,0:09:33.64,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kehormatan ras setan itu
Dialogue: 0,0:09:34.44,0:09:35.49,Default,,0,0,0,,{\blur3}{\fad(00,40)}tidak ada gunanya.
Dialogue: 0,0:09:36.73,0:09:37.64,Default,,0,0,0,,{\blur3}{\fad(00,40)}Namun,
Dialogue: 0,0:09:37.89,0:09:40.56,Default,,0,0,0,,{\blur3}{\fad(00,40)}bukan berarti\Naku membiarkannya tanpa balasan.
Dialogue: 0,0:09:58.73,0:10:00.00,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kakak!
Dialogue: 0,0:10:10.56,0:10:13.04,Default,,0,0,0,,{\blur3}{\fad(00,40)}Rem, syukurlah kau tak apa-apa.
Dialogue: 0,0:10:25.31,0:10:26.44,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ah.
Dialogue: 0,0:10:27.67,0:10:29.60,Default,,0,0,0,,{\blur3}{\fad(00,40)}Akhirnya patah juga.
Dialogue: 0,0:10:37.04,0:10:38.00,Default,,0,0,0,,{\blur3}{\fad(00,40)}Rem.
Dialogue: 0,0:10:40.49,0:10:41.73,Default,,0,0,0,,{\blur3}{\fad(00,40)}Dia mempermainkanku, ya.
Dialogue: 0,0:10:42.25,0:10:44.91,Default,,0,0,0,,{\blur3}{\fad(00,40)}Untuk membekaskan pemandangan ini padaku.
Dialogue: 0,0:10:45.91,0:10:47.38,Default,,0,0,0,,{\blur3}{\fad(00,40)}Takkan kubiarkan dia...
Dialogue: 0,0:10:50.42,0:10:53.04,Default,,0,0,0,,{\blur3}{\fad(00,40)}Jangan-jangan Barusu mati?
Dialogue: 0,0:10:54.73,0:10:56.39,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tidak, bukan.
Dialogue: 0,0:10:57.04,0:10:59.27,Default,,0,0,0,,{\blur3}{\fad(00,40)}Dia sedang menanggung\Nbeban yang sangat besar.
Dialogue: 0,0:10:59.56,0:11:01.85,Default,,0,0,0,,{\blur3}{\fad(00,40)}Entah Nona Beatrice atau Meili.
Dialogue: 0,0:11:04.27,0:11:06.42,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kenapa kau jadi lemah begini, diriku?
Dialogue: 0,0:11:06.84,0:11:08.80,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kau adalah kakaknya Rem, lo!
Dialogue: 0,0:11:19.41,0:11:21.53,Default,,0,0,0,,{\blur3}{\fad(00,40)}Naga darat ini boleh juga.
Dialogue: 0,0:11:21.53,0:11:25.16,Default,,0,0,0,,{\blur3}{\fad(00,40)}Pekerja keras dan setia pada tuannya.
Dialogue: 0,0:11:25.33,0:11:26.33,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:11:26.33,0:11:28.96,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tapi, tapi, tapi, tapi, tapi
Dialogue: 0,0:11:28.96,0:11:31.02,Default,,0,0,0,,{\blur3}{\fad(00,40)}tapi, tapi, tapi, tapi, tapi...
Dialogue: 0,0:11:31.17,0:11:35.24,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sayangnya, naga darat tak bisa\Nmengenyangkan perut kami.
Dialogue: 0,0:11:35.62,0:11:38.09,Default,,0,0,0,,{\blur3}{\fad(00,40)}Membunuh diri sendiri\Nsebagai dirinya sendiri
Dialogue: 0,0:11:38.09,0:11:43.20,Default,,0,0,0,,{\blur3}{\fad(00,40)}mungkin akan menjadi sesuatu yang menarik?
Dialogue: 0,0:11:47.84,0:11:49.27,Default,,0,0,0,,{\blur3}{\fad(00,40)}Bagus, bagus.
Dialogue: 0,0:11:49.27,0:11:51.57,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kau sudah bekerja dengan bagus!
Dialogue: 0,0:11:54.64,0:11:57.18,Default,,0,0,0,,{\blur3}{\fad(00,40)}Gerhana bulan yang memanfaatkan ingatan,
Dialogue: 0,0:11:57.18,0:12:00.18,Default,,0,0,0,,{\blur3}{\fad(00,40)}dan gerhana matahari\Nyang memanfaatkan eksistensi itu sendiri.
Dialogue: 0,0:12:01.69,0:12:05.09,Default,,0,0,0,,{\blur3}{\fad(00,40)}Selama ini kami tak pernah\Nmemakai gerhana matahari.
Dialogue: 0,0:12:05.25,0:12:08.84,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tak disangka bisa berkembang\Ndi tengah pertarungan.
Dialogue: 0,0:12:09.83,0:12:13.17,Default,,0,0,0,,{\blur3}{\fad(00,40)}Seharusnya, orang tua renta seperti kami
Dialogue: 0,0:12:13.60,0:12:17.13,Default,,0,0,0,,{\blur3}{\fad(00,40)}tidak bisa melakukan hal seperti ini.
Dialogue: 0,0:12:18.93,0:12:20.58,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ini luar biasa!
Dialogue: 0,0:12:22.47,0:12:24.47,Default,,0,0,0,,{\blur3}{\fad(00,40)}Demi Kakak...
Dialogue: 0,0:12:24.89,0:12:28.18,Default,,0,0,0,,{\blur3}{\fad(00,40)}Akan kubunuh kesayangan Kakak
Dialogue: 0,0:12:28.18,0:12:29.94,Default,,0,0,0,,{\blur3}{\fad(00,40)}dengan tanganku sendiri.
Dialogue: 0,0:12:29.94,0:12:32.29,Default,,0,0,0,,{\blur3}{\fad(00,40)}Jangan mengatakan hal menjijikkan begitu.
Dialogue: 0,0:12:43.53,0:12:48.00,Default,,0,0,0,,{\blur3}{\fad(00,40)}Akhirnya Kakak bisa menyusul juga.
Dialogue: 0,0:12:48.40,0:12:52.46,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kami... tunggu, kami bersaudari...?
Dialogue: 0,0:12:52.93,0:12:54.73,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kami saudari kembar?
Dialogue: 0,0:12:55.42,0:12:59.38,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kami, Rem, sudah menunggumu.
Dialogue: 0,0:13:01.56,0:13:04.26,Default,,0,0,0,,{\blur3}{\fad(00,40)}Dalam waktu sesingkat ini\Nwujudmu jadi jelek sekali, ya.
Dialogue: 0,0:13:06.29,0:13:08.56,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kau sudah bekerja dengan bagus, Patrasche.
Dialogue: 0,0:13:08.73,0:13:10.47,Default,,0,0,0,,{\blur3}{\fad(00,40)}Bawa Rem dan mundurlah.
Dialogue: 0,0:13:11.90,0:13:14.77,Default,,0,0,0,,{\blur3}{\fad(00,40)}Jangan begitu, Kakak.
Dialogue: 0,0:13:15.31,0:13:19.07,Default,,0,0,0,,{\blur3}{\fad(00,40)}Itu adalah hidangan pembuka.
Dialogue: 0,0:13:19.07,0:13:22.31,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sebelum menyantap hidangan utama,
Dialogue: 0,0:13:22.82,0:13:24.48,Default,,0,0,0,,{\blur3}{\fad(00,40)}nikmati dulu
Dialogue: 0,0:13:24.49,0:13:26.08,Default,,0,0,0,,{\blur3}{\fad(00,40)}- hidangan pelengkapnya.\N- Matilah.
Dialogue: 0,0:13:28.87,0:13:30.07,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kakak.
Dialogue: 0,0:13:35.92,0:13:38.17,Default,,0,0,0,,{\blur3}{\fad(00,40)}Menangislah, Kakak.
Dialogue: 0,0:13:39.49,0:13:41.72,Default,,0,0,0,,{\blur3}{\fad(00,40)}Marahlah, Kakak.
Dialogue: 0,0:13:42.42,0:13:44.51,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tertawalah, Kakak.
Dialogue: 0,0:13:44.82,0:13:45.80,Default,,0,0,0,,{\blur3}{\fad(00,40)}Menangislah.
Dialogue: 0,0:13:45.80,0:13:46.81,Default,,0,0,0,,{\blur3}{\fad(00,40)}Marahlah.
Dialogue: 0,0:13:46.81,0:13:47.72,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tertawalah.
Dialogue: 0,0:13:47.72,0:13:48.91,Default,,0,0,0,,{\blur3}{\fad(00,40)}Menderitalah.
Dialogue: 0,0:13:48.91,0:13:49.77,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tersenyumlah.
Dialogue: 0,0:13:49.77,0:13:50.77,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tersakitilah.
Dialogue: 0,0:13:50.77,0:13:51.64,Default,,0,0,0,,{\blur3}{\fad(00,40)}Merajuklah.
Dialogue: 0,0:13:51.81,0:13:52.67,Default,,0,0,0,,{\blur3}{\fad(00,40)}Menggebulah.
Dialogue: 0,0:13:52.67,0:13:53.73,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tersipulah.
Dialogue: 0,0:13:53.73,0:13:54.52,Default,,0,0,0,,{\blur3}{\fad(00,40)}Terbuailah.
Dialogue: 0,0:13:54.52,0:13:55.42,Default,,0,0,0,,{\blur3}{\fad(00,40)}Gelisahlah.
Dialogue: 0,0:13:55.42,0:13:56.36,Default,,0,0,0,,{\blur3}{\fad(00,40)}Terkejutlah.
Dialogue: 0,0:13:56.36,0:13:57.67,Default,,0,0,0,,{\blur3}{\fad(00,40)}Rayakanlah.
Dialogue: 0,0:13:58.22,0:13:59.28,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kakak!
Dialogue: 0,0:14:01.74,0:14:03.96,Default,,0,0,0,,{\blur3}{\fad(00,40)}Jangan panggil aku begitu!
Dialogue: 0,0:14:03.96,0:14:05.58,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kak, Kak,
Dialogue: 0,0:14:05.58,0:14:08.56,Default,,0,0,0,,{\blur3}{\fad(00,40)}wajah seperti itu tidak mencerminkan Kakak.
Dialogue: 0,0:14:28.53,0:14:29.51,Default,,0,0,0,,{\blur3}{\fad(00,40)}Itu...
Dialogue: 0,0:14:32.82,0:14:34.13,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tandukku.
Dialogue: 0,0:14:41.07,0:14:43.78,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kak, Kak, apa Kakak baik-baik saja?
Dialogue: 0,0:14:46.31,0:14:47.27,Default,,0,0,0,,{\blur3}{\fad(00,40)}Lo?
Dialogue: 0,0:14:49.31,0:14:53.42,Default,,0,0,0,,{\blur3}{\fad(00,40)}Oh, ketemu juga.
Dialogue: 0,0:14:56.36,0:14:57.60,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku tarik ucapanku.
Dialogue: 0,0:14:59.00,0:15:00.25,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kakak?
Dialogue: 0,0:15:01.42,0:15:03.31,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tadinya kupikir sedang tidak beruntung.
Dialogue: 0,0:15:03.93,0:15:05.98,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tapi, ternyata tidak.
Dialogue: 0,0:15:16.93,0:15:18.07,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tampaknya,
Dialogue: 0,0:15:18.69,0:15:22.09,Default,,0,0,0,,{\blur3}{\fad(00,40)}langit pun terpikat\Ndengan keimutanku dan Rem.
Dialogue: 0,0:16:04.24,0:16:05.73,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kakak.
Dialogue: 0,0:16:07.86,0:16:10.56,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sayangnya, adikku itu sedang tidur.
Dialogue: 0,0:16:11.31,0:16:13.24,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku tahu karena kami berbagi indra.
Dialogue: 0,0:16:13.24,0:16:15.00,Default,,0,0,0,,{\blur3}{\fad(00,40)}Berbagi?
Dialogue: 0,0:16:17.58,0:16:18.60,Default,,0,0,0,,{\blur3}{\fad(00,40)}Berbagi indra.
Dialogue: 0,0:16:19.22,0:16:21.62,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kami adalah kakak beradik yang sangat akrab.
Dialogue: 0,0:16:22.40,0:16:23.88,Default,,0,0,0,,{\blur3}{\fad(00,40)}Berbagi bahagia dan marah.
Dialogue: 0,0:16:24.05,0:16:25.67,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kesedihan dan rasa sakit.
Dialogue: 0,0:16:25.84,0:16:27.62,Default,,0,0,0,,{\blur3}{\fad(00,40)}Dan berbagai hal semacamnya.
Dialogue: 0,0:16:28.11,0:16:31.53,Default,,0,0,0,,{\blur3}{\fad(00,40)}Termasuk berbagi kekuatan\Ndan beban sebagai ras setan.
Dialogue: 0,0:16:32.40,0:16:33.71,Default,,0,0,0,,{\blur3}{\fad(00,40)}Maafkan aku.
Dialogue: 0,0:16:34.04,0:16:38.18,Default,,0,0,0,,{\blur3}{\fad(00,40)}Di saat seperti ini, aku malah\Nmembebankan sesuatu kepadamu.
Dialogue: 0,0:16:39.49,0:16:42.22,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku sebal karena rencana Barusu\Nadalah petunjuknya.
Dialogue: 0,0:16:42.69,0:16:43.36,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tapi tak apa.
Dialogue: 0,0:16:43.36,0:16:45.60,Default,,0,0,0,,{\blur3}{\fad(00,40)}Subaru apa?
Dialogue: 0,0:16:49.93,0:16:52.58,Default,,0,0,0,,{\blur3}{\fad(00,40)}Jangan sebut nama Barusu\Ndengan wajah dan suara itu.
Dialogue: 0,0:16:55.42,0:16:57.29,Default,,0,0,0,,{\blur3}{\fad(00,40)}Mereka yang lahir di tempat yang gelap,
Dialogue: 0,0:16:57.73,0:16:59.37,Default,,0,0,0,,{\blur3}{\fad(00,40)}kembalilah ke tempat yang gelap.
Dialogue: 0,0:17:11.32,0:17:13.32,Default,,0,0,0,,{\blur3}{\fad(00,40)}Jika kau terlahir dengan menangis,
Dialogue: 0,0:17:14.02,0:17:16.09,Default,,0,0,0,,{\blur3}{\fad(00,40)}maka matilah bersama tangisanmu!
Dialogue: 0,0:17:21.73,0:17:23.73,Default,,0,0,0,,{\blur3}{\fad(00,40)}Suasana hatiku sekarang sedang sangat bagus.
Dialogue: 0,0:17:29.90,0:17:31.40,Default,,0,0,0,,{\blur3}{\fad(00,40)}Lamban sekali kau.
Dialogue: 0,0:17:31.91,0:17:33.71,Default,,0,0,0,,{\blur3}{\fad(00,40)}Keburu aku jadi nenek-nenek duluan.
Dialogue: 0,0:17:41.91,0:17:45.13,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tapi, jadi tua pun aku tetap imut.
Dialogue: 0,0:17:46.38,0:17:48.20,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tak bisa terus-terusan melompat, 'kan?
Dialogue: 0,0:17:48.76,0:17:50.11,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku sudah bosan dengan trikmu.
Dialogue: 0,0:17:50.40,0:17:51.38,Default,,0,0,0,,{\blur3}{\fad(00,40)}Begitu pun wajahmu.
Dialogue: 0,0:17:51.38,0:17:52.56,Default,,0,0,0,,{\blur3}{\fad(00,40)}- Tunggu.\N- Takkan kutunggu.
Dialogue: 0,0:18:04.87,0:18:06.98,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tanggung jawablah atas perbuatanmu sendiri.
Dialogue: 0,0:18:19.08,0:18:22.62,Default,,0,0,0,,{\blur3}{\fad(00,40)}Oh iya, kau punya\Nadik laki-laki dan perempuan, ya.
Dialogue: 0,0:18:23.27,0:18:25.38,Default,,0,0,0,,{\blur3}{\fad(00,40)}Coba tunjukkan harga dirimu demi mereka.
Dialogue: 0,0:18:25.54,0:18:27.71,Default,,0,0,0,,{\blur3}{\fad(00,40)}Adik laki-laki kami...
Dialogue: 0,0:18:27.71,0:18:31.40,Default,,0,0,0,,{\blur3}{\fad(00,40)}Adik perempuan kami...
Dialogue: 0,0:18:31.69,0:18:33.58,Default,,0,0,0,,{\blur3}{\fad(00,40)}"Jangan kau sentuh," begitu?
Dialogue: 0,0:18:34.20,0:18:36.38,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kau pikir siapa bisa memohon seperti itu?
Dialogue: 0,0:18:37.05,0:18:39.85,Default,,0,0,0,,{\blur3}{\fad(00,40)}Memangnya kau pernah mendengarkan\Npermohonan orang lain?
Dialogue: 0,0:18:40.36,0:18:42.56,Default,,0,0,0,,{\blur3}{\fad(00,40)}Meski begitu...
Dialogue: 0,0:18:47.44,0:18:48.19,Default,,0,0,0,,{\blur3}{\fad(00,40)}Pikirkanlah.
Dialogue: 0,0:18:48.19,0:18:50.19,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kakak memang terlalu baik.
Dialogue: 0,0:18:57.60,0:18:59.11,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ah, sial!
Dialogue: 0,0:18:59.11,0:19:00.99,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sial! Sial! Sial!
Dialogue: 0,0:19:00.99,0:19:04.46,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ternyata ada orang yang seperti itu!
Dialogue: 0,0:19:04.62,0:19:06.96,Default,,0,0,0,,{\blur3}{\fad(00,40)}Harusnya kami tidak pernah tahu.
Dialogue: 0,0:19:06.96,0:19:08.38,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kami ingin itu.
Dialogue: 0,0:19:08.38,0:19:10.31,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kami tidak butuh itu.
Dialogue: 0,0:19:13.00,0:19:14.42,Default,,0,0,0,,{\blur3}{\fad(00,40)}Hanya itu...
Dialogue: 0,0:19:15.02,0:19:16.34,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ya, benar.
Dialogue: 0,0:19:16.89,0:19:19.22,Default,,0,0,0,,{\blur3}{\fad(00,40)}Benar, benar sekali.
Dialogue: 0,0:19:20.27,0:19:22.53,Default,,0,0,0,,{\blur3}{\fad(00,40)}Benar, 'kan? Memang benar!
Dialogue: 0,0:19:22.98,0:19:24.80,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sangat benar!
Dialogue: 0,0:19:25.02,0:19:26.91,Default,,0,0,0,,{\blur3}{\fad(00,40)}Karena itulah!
Dialogue: 0,0:19:27.42,0:19:30.40,Default,,0,0,0,,{\blur3}{\fad(00,40)}Karena memang seperti itulah...
Dialogue: 0,0:19:30.40,0:19:33.11,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kami makan dengan rakus!
Dialogue: 0,0:19:33.11,0:19:35.29,Default,,0,0,0,,{\blur3}{\fad(00,40)}Benar, kami mencintaimu.
Dialogue: 0,0:19:35.29,0:19:36.28,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kakak...
Dialogue: 0,0:19:36.28,0:19:37.40,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tidak, Ram.
Dialogue: 0,0:19:37.40,0:19:39.87,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kami mencintaimu.
Dialogue: 0,0:19:49.29,0:19:50.13,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tidak mungkin.
Dialogue: 0,0:19:57.07,0:19:58.30,Default,,0,0,0,,{\blur3}{\fad(00,40)}Serius?
Dialogue: 0,0:20:01.58,0:20:03.22,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tunggu! Tunggu dulu!
Dialogue: 0,0:20:03.22,0:20:05.71,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tunggu! Tunggu! Sebentar saja!
Dialogue: 0,0:20:05.71,0:20:08.06,Default,,0,0,0,,{\blur3}{\fad(00,40)}Hanya sebentar saja!
Dialogue: 0,0:20:08.06,0:20:11.31,Default,,0,0,0,,{\blur3}{\fad(00,40)}Tunggu kami sebentar saja.
Dialogue: 0,0:20:11.31,0:20:15.15,Default,,0,0,0,,{\blur3}{\fad(00,40)}Terimalah perasaan kami!
Dialogue: 0,0:20:15.15,0:20:18.36,Default,,0,0,0,,{\blur3}{\fad(00,40)}Lihatlah permintaan kami!
Dialogue: 0,0:20:26.13,0:20:26.96,Default,,0,0,0,,{\blur3}{\fad(00,40)}Fulla.
Dialogue: 0,0:20:28.18,0:20:29.93,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kami mencintaimu.
Dialogue: 0,0:20:38.84,0:20:40.64,Default,,0,0,0,,{\blur3}{\fad(00,40)}Yang hidup dengan pedang mati dengan pedang.
Dialogue: 0,0:20:41.29,0:20:43.18,Default,,0,0,0,,{\blur3}{\fad(00,40)}Yang berteguh sihir mati dengan sihir.
Dialogue: 0,0:20:43.58,0:20:45.78,Default,,0,0,0,,{\blur3}{\fad(00,40)}Yang mengandalkan api mati dengan api.
Dialogue: 0,0:20:46.35,0:20:49.85,Default,,0,0,0,,{\blur3}{\fad(00,40)}Lalu, yang berharap pada setan\Nmati dengan setan.
Dialogue: 0,0:20:50.52,0:20:52.78,Default,,0,0,0,,{\blur3}{\fad(00,40)}Binasa oleh sesuatu yang mereka andalkan.
Dialogue: 0,0:20:54.84,0:20:58.07,Default,,0,0,0,,{\blur3}{\fad(00,40)}Apa kau juga ingin melindungi Rem?
Dialogue: 0,0:20:59.53,0:21:00.41,Default,,0,0,0,,{\blur3}{\fad(00,40)}Begitu.
Dialogue: 0,0:21:00.57,0:21:02.33,Default,,0,0,0,,{\blur3}{\fad(00,40)}Anak pintar, Patrasche.
Dialogue: 0,0:21:09.96,0:21:13.22,Default,,0,0,0,,{\blur3}{\fad(00,40)}Hari itu, saat tandukku patah,
Dialogue: 0,0:21:13.98,0:21:15.20,Default,,0,0,0,,{\blur3}{\fad(00,40)}ternyata agar hari ini,
Dialogue: 0,0:21:15.76,0:21:19.07,Default,,0,0,0,,{\blur3}{\fad(00,40)}aku bisa menyadari bahwa aku adalah kakakmu.
Dialogue: 0,0:21:21.51,0:21:22.51,Default,,0,0,0,,{\blur3}{\fad(00,40)}Sungguh bodoh.
Dialogue: 0,0:21:26.31,0:21:27.47,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku mencintaimu,
Dialogue: 0,0:21:28.67,0:21:29.64,Default,,0,0,0,,{\blur3}{\fad(00,40)}Rem.
Dialogue: 0,0:23:09.18,0:23:11.20,Default,,0,0,0,,{\blur3}{\fad(00,40)}Kalau ekor dan kakinya masih normal...
Dialogue: 0,0:23:12.78,0:23:15.89,Default,,0,0,0,,{\blur3}{\fad(00,40)}Duh, kenapa cuma kepalanya yang kosong, sih!
Dialogue: 0,0:23:17.82,0:23:19.09,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ujung puncak itu!
Dialogue: 0,0:23:19.09,0:23:19.71,Default,,0,0,0,,{\blur3}{\fad(00,40)}Ke sana!
Dialogue: 0,0:23:25.56,0:23:26.84,Default,,0,0,0,,{\blur3}{\fad(00,40)}Subaru, maaf!
Dialogue: 0,0:23:30.89,0:23:32.58,Default,,0,0,0,,{\blur3}{\fad(00,40)}Aku harus temukan ujiannya.
Dialogue: 0,0:23:37.04,0:23:39.44,Default,,0,0,0,,{\blur3}{\fad(00,40)}Telapak tangan... seseorang?
