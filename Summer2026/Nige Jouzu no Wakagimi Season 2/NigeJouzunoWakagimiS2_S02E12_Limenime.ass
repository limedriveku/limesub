Dialogue: 0,0:00:00.28,0:00:03.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teruslah hidup dan tunggu waktunya♪
Dialogue: 0,0:00:03.24,0:00:08.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jinjing nyawamu dan tembus takdir♪
Dialogue: 0,0:00:08.08,0:00:11.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hiduplah dalam malu\Ndan kejar mimpimu♪
Dialogue: 0,0:00:11.29,0:00:16.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi orang-orang\Nyang percaya padamu♪
Dialogue: 0,0:00:30.02,0:00:33.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagian besar takkan tercatat\Ndalam sejarah♪
Dialogue: 0,0:00:33.27,0:00:36.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua hal konyol itu♪
Dialogue: 0,0:00:36.78,0:00:40.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membelit dan terurai, lagi dan lagi♪
Dialogue: 0,0:00:40.57,0:00:43.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tarik napas♪
Dialogue: 0,0:00:43.62,0:00:47.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk apa hidup ini dipersembahkan?♪
Dialogue: 0,0:00:47.16,0:00:50.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takdir apa yang menanti?♪
Dialogue: 0,0:00:50.58,0:00:53.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bila rasa bak kutukan♪
Dialogue: 0,0:00:53.46,0:00:57.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan bisa mengikatku♪
Dialogue: 0,0:00:57.80,0:01:00.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teruslah hidup dan tunggu waktunya♪
Dialogue: 0,0:01:00.59,0:01:05.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jinjing nyawamu dan lawan takdir♪
Dialogue: 0,0:01:05.47,0:01:08.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hiduplah dalam malu\Ndan kejar mimpimu♪
Dialogue: 0,0:01:08.64,0:01:12.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi orang-orang\Nyang percaya padamu♪
Dialogue: 0,0:01:12.98,0:01:16.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Iblis, sini,\Nikuti suara tepuk tanganku♪
Dialogue: 0,0:01:16.15,0:01:19.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}(Hei, Iblis, sini,\Nikuti suara tepuk tanganku)♪
Dialogue: 0,0:01:19.73,0:01:23.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hidup itu singkat,\Nmenyanyi dan menarilah♪
Dialogue: 0,0:01:23.11,0:01:27.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bunga akan mekar\Nbagi yang jago kabur♪
Dialogue: 0,0:01:36.83,0:01:41.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini, kita sedang mengalami\Ntitik balik penting dalam sejarah.
Dialogue: 0,0:01:41.38,0:01:45.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Norma-norma lama runtuh,\Nnilai-nilai yang kita junjung telah hilang,
Dialogue: 0,0:01:45.13,0:01:48.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan era yang seharusnya datang\Nselanjutnya masih belum terlihat.
Dialogue: 0,0:01:49.14,0:01:53.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekitar 700 tahun, Jepang juga\Nberada dalam masa ketidakpastian.
Dialogue: 0,0:01:54.60,0:01:57.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seiring berakhirnya era samurai\Ndan mulai goyahnya definisi kebenaran,
Dialogue: 0,0:01:57.94,0:02:01.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}para samurai pergi berperang\Ndengan membela tujuan masing-masing.
Dialogue: 0,0:02:02.48,0:02:06.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di pintu masuk yang tenang\Nmenuju pergolakan yang menanti...
Dialogue: 0,0:02:08.57,0:02:09.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yasaburo!
Dialogue: 0,0:02:09.82,0:02:11.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya sampai juga!
Dialogue: 0,0:02:11.41,0:02:12.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:02:12.58,0:02:16.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Myojin akan bangkit\Ndan menjatuhi hukuman mereka!
Dialogue: 0,0:02:16.79,0:02:18.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Utusan benar.
Dialogue: 0,0:02:18.79,0:02:21.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada hikmahnya bertahan hidup\Ndengan kabur.
Dialogue: 0,0:02:21.21,0:02:22.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu...
Dialogue: 0,0:02:22.38,0:02:24.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita yang jadi garda depan!
Dialogue: 0,0:02:25.05,0:02:27.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita diperintah menyerang\NGubernur Kiyohara
Dialogue: 0,0:02:27.26,0:02:29.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan memantik perang besar!
Dialogue: 0,0:02:30.01,0:02:32.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tinggi sekali ekspektasi mereka.
Dialogue: 0,0:02:32.39,0:02:35.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan membalaskan\Ndendam keluargaku, rakyatku,
Dialogue: 0,0:02:35.93,0:02:38.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan orang yang menjadi korban\Nselama dua tahun ini!
Dialogue: 0,0:02:39.48,0:02:41.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Kiyohara baik-baik saja?
Dialogue: 0,0:02:41.02,0:02:43.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak dia pulang secepat kilat dari Kyo,
Dialogue: 0,0:02:43.61,0:02:46.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia menciptakan sesuatu\Nseolah sedang kerasukan.
Dialogue: 0,0:02:46.78,0:02:49.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kekurangan pasukan.
Dialogue: 0,0:02:49.78,0:02:54.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di Shinano, pasukan pengawal Kokuga Konoe\Nkehilangan Yonemaru sehingga melemah.
Dialogue: 0,0:02:54.74,0:02:57.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada tanda-tanda merekrut\Npetarung tangguh baru juga.
Dialogue: 0,0:02:58.00,0:03:01.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Motivasi dan aksinya\Nmemang hebat, tapi...
Dialogue: 0,0:03:01.46,0:03:04.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Denah dan persiapan\Nmaterialnya juga sempurna.
Dialogue: 0,0:03:05.46,0:03:09.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bila dia lahir di zaman yang damai,\Npasti dia bisa lebih bersinar...
Dialogue: 0,0:03:13.89,0:03:18.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita cuma bisa berharap motivasinya\Nmengarah pada hal baik.
Dialogue: 0,0:03:20.77,0:03:22.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak terima, Ayahanda!
Dialogue: 0,0:03:22.94,0:03:24.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma demi Hojo Tokiyuki...
Dialogue: 0,0:03:24.94,0:03:28.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa Ayahanda dan Kakek harus\Nberperang mempertaruhkan nyawa?
Dialogue: 0,0:03:29.15,0:03:30.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yoritsugu.
Dialogue: 0,0:03:30.69,0:03:35.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keluarga Hojo telah memperlakukan\Nkeluarga Suwa dengan baik dan hormat.
Dialogue: 0,0:03:36.37,0:03:38.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan menjadikan Kaisar\Nsebagai dewa hidup bagi bangsawan
Dialogue: 0,0:03:38.79,0:03:41.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan Suwa Myojin sebagai\Ndewa hidup bagi samurai,
Dialogue: 0,0:03:41.71,0:03:45.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kaum samurai dapat mandiri\Nsecara spiritual dari kaum bangsawan.
Dialogue: 0,0:03:46.04,0:03:49.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bisa menjadi dewa\Nberkat Tuan Hojo.
Dialogue: 0,0:03:49.92,0:03:52.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tak boleh melupakan kebaikan itu.
Dialogue: 0,0:03:53.18,0:03:56.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, untuk menyelamatkan\Nrakyat Shinano,
Dialogue: 0,0:03:56.05,0:03:58.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk masa depan keluarga\NSuwa sebagai klan samurai,
Dialogue: 0,0:03:58.47,0:04:00.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan demi keadilan untuk membantu\Npangeran yang malang,
Dialogue: 0,0:04:01.39,0:04:04.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak ada alasan\Nuntuk tidak pergi berperang.
Dialogue: 0,0:04:04.98,0:04:07.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku titip semuanya padamu\Njika terjadi sesuatu.
Dialogue: 0,0:04:07.86,0:04:10.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tumbuh jadi anak\Nyang sedikit egois,
Dialogue: 0,0:04:10.36,0:04:13.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi sifat aslimu adalah anak\Nyang setia dan baik hati.
Dialogue: 0,0:04:14.15,0:04:17.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jalani hidupmu agar tidak\Nmenyesali isi hati nuranimu.
Dialogue: 0,0:04:24.33,0:04:27.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, hari ini bangun, ya, Pewaris.
Dialogue: 0,0:04:27.63,0:04:28.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kojirou.
Dialogue: 0,0:04:28.96,0:04:33.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari keberangkatan sudah ditentukan,\Njadi aku menyempatkan diri menemuimu.
Dialogue: 0,0:04:33.17,0:04:37.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, ya, Kojirou.\NSelalu kamu yang terlibat bahaya.
Dialogue: 0,0:04:38.10,0:04:41.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Andai kemampuan bela diriku\Nmirip kau juga, bukan cuma wajah.
Dialogue: 0,0:04:41.43,0:04:45.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ngomong apa, sih?\NAku suka bertarung!
Dialogue: 0,0:04:45.44,0:04:48.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan membuat nama Nezu Kojirou
Dialogue: 0,0:04:48.44,0:04:50.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi terkenal di bawah naungan\NTuan Muda Hojo.
Dialogue: 0,0:04:52.78,0:04:55.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak pulang dari Kyo, Hojo Yasuie
Dialogue: 0,0:04:56.20,0:05:00.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kubu Suwa menyelesaikan persiapan\Nperang hanya dalam beberapa hari.
Dialogue: 0,0:05:01.70,0:05:04.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masing-masing memegang\Nteguh tujuan mereka.
Dialogue: 0,0:05:06.33,0:05:08.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ogasawara Sadamune.
Dialogue: 0,0:05:08.29,0:05:11.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kinerjamu kuakui sebagai\Nkehormatan bagi kaum samurai.
Dialogue: 0,0:05:11.84,0:05:15.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terimalah pedang ini\Ndan tingkatkan lagi reputasimu.
Dialogue: 0,0:05:16.01,0:05:17.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya terima dengan senang hati.
Dialogue: 0,0:05:18.34,0:05:20.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya pasti mewujudkannya!
Dialogue: 0,0:05:37.57,0:05:39.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Matamu terbuka saat tidur, lo.
Dialogue: 0,0:05:40.78,0:05:43.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa benar Suwa\Nmengumpulkan pasukan?
Dialogue: 0,0:05:43.79,0:05:45.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak salah lagi.
Dialogue: 0,0:05:45.54,0:05:47.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sampai lengah.
Dialogue: 0,0:05:47.87,0:05:51.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang, aku sudah mengirim pengintai,\Ntidak ada pergerakan sama sekali!
Dialogue: 0,0:05:51.17,0:05:52.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ngelunjak?!
Dialogue: 0,0:05:53.21,0:05:57.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, apa gunanya setia\Npada Hojo sekarang?
Dialogue: 0,0:05:57.34,0:06:00.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai samurai, kita harus\Nmenentukan kubu mana
Dialogue: 0,0:06:00.14,0:06:03.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang kita ikuti untuk\Nmelindungi wilayah, bukan?
Dialogue: 0,0:06:03.39,0:06:08.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamakura adalah tempat\Nyang memiliki arti penting bagi samurai.
Dialogue: 0,0:06:08.85,0:06:13.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu adalah tempat masa samurai dimulai\Ndan mereka berjalan penuh kebanggaan di sana.
Dialogue: 0,0:06:13.73,0:06:17.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesetiaan harus berdasar\Npada nalar, 'kan?
Dialogue: 0,0:06:17.15,0:06:18.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin saja.
Dialogue: 0,0:06:19.36,0:06:19.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:06:21.53,0:06:22.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Ayo ke Kamakura."
Dialogue: 0,0:06:23.53,0:06:26.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kata-kata itu masih digunakan.
Dialogue: 0,0:06:27.04,0:06:29.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan di antara mereka.
Dialogue: 0,0:06:29.79,0:06:33.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kulewatkan?
Dialogue: 0,0:06:37.88,0:06:40.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Muda, cocok banget pakai zirah!
Dialogue: 0,0:06:40.76,0:06:42.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, sebagai jenderal,
Dialogue: 0,0:06:42.72,0:06:46.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}harus pakai zirah lengkap\Ndan helm kabuto.
Dialogue: 0,0:06:47.85,0:06:50.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Je-Jenderal kami memang hebat!
Dialogue: 0,0:06:50.44,0:06:53.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai sekarang pun tidak gentar!
Dialogue: 0,0:06:53.40,0:06:55.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berdiri saja sudah intimidatif!
Dialogue: 0,0:06:55.73,0:06:57.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inilah dia jenderal yang sebenarnya!
Dialogue: 0,0:07:05.95,0:07:10.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihatlah! Aura yang mencekam\Ntanpa gerak sama sekali!
Dialogue: 0,0:07:10.46,0:07:15.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuda-kuda ini, jangan-jangan...\NPedang Tak Goyah: Pembelah Bumi?!
Dialogue: 0,0:07:17.75,0:07:20.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat! Ada retakan di tanah!
Dialogue: 0,0:07:22.68,0:07:23.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah!
Dialogue: 0,0:07:25.72,0:07:26.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Muda...
Dialogue: 0,0:07:30.73,0:07:32.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Muda!
Dialogue: 0,0:07:33.31,0:07:34.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlalu maksa, ya.
Dialogue: 0,0:07:34.90,0:07:36.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlalu berat, nih.
Dialogue: 0,0:07:37.07,0:07:38.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mau pakai zirah?
Dialogue: 0,0:07:38.98,0:07:40.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah tidak kuat.
Dialogue: 0,0:07:40.53,0:07:43.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah mau mati kecapekan\Nwalau baru kupakai satu jam.
Dialogue: 0,0:07:43.24,0:07:44.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Muda memang letoi, sih.
Dialogue: 0,0:07:45.82,0:07:49.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu set perlengkapan samurai\Nberatnya lebih dari 30 kilogram,
Dialogue: 0,0:07:49.29,0:07:52.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sehingga melompat pun menjadi sulit,\Nbahkan bagi anak-anak.
Dialogue: 0,0:07:52.71,0:07:54.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada masalah lain.
Dialogue: 0,0:07:56.79,0:07:58.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka sama sekali tidak niat.
Dialogue: 0,0:07:58.46,0:07:59.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kondisi apa ini?!
Dialogue: 0,0:08:00.09,0:08:04.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, kami bakal patuh\Nkarena ini perintah Tuan Yorishige...
Dialogue: 0,0:08:04.26,0:08:08.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malah memilih komandan anak-anak\Ndi perang pembalasan penting begini...
Dialogue: 0,0:08:08.06,0:08:10.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak itu juga sama sekali\Ntidak semangat.
Dialogue: 0,0:08:11.06,0:08:12.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana ini, Tuan Yorishige?
Dialogue: 0,0:08:12.73,0:08:15.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah lebih baik mengungkap\Nidentitas Tuan Tokiyuki?
Dialogue: 0,0:08:17.23,0:08:20.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyesuaian dengan zirah dan latihan\Nkoordinasi dengan pasukan Kamakura,
Dialogue: 0,0:08:20.48,0:08:23.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}rencananya akan kami lakukan\Ndi bulan terakhir.
Dialogue: 0,0:08:24.40,0:08:27.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Strategi tengu dari Ashikaga\Nterbukti efektif.
Dialogue: 0,0:08:27.82,0:08:30.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami terlalu waspada\Ndengan pengawasan mereka
Dialogue: 0,0:08:30.08,0:08:32.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sehingga banyak persiapan tertunda.
Dialogue: 0,0:08:32.83,0:08:36.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duh, tapi jelas-jelas berbahaya\Nkalau melepas zirah...
Dialogue: 0,0:08:36.00,0:08:38.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wibawa jenderal juga berkurang...
Dialogue: 0,0:08:38.21,0:08:40.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah muncul di lagu pembuka juga...
Dialogue: 0,0:08:41.30,0:08:42.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Yorishige!
Dialogue: 0,0:08:43.05,0:08:46.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin diakui mereka dengan menang,
Dialogue: 0,0:08:46.39,0:08:49.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi aku ingin melepas zirah untuk itu!
Dialogue: 0,0:08:49.89,0:08:54.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Operasi kali ini dan teknik baru tidak bisa\Ndilakukan kalau tidak lincah.
Dialogue: 0,0:08:54.56,0:08:56.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebegitunya ingin dilepas?
Dialogue: 0,0:08:56.85,0:08:58.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, mau!
Dialogue: 0,0:08:58.94,0:09:02.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin melepas semuanya\Ndan kabur dengan nikmat!
Dialogue: 0,0:09:02.86,0:09:06.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ja-Jadi, dia bocah mesum kabur telanjang\Nyang terkenal itu, ya?
Dialogue: 0,0:09:06.82,0:09:08.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bocah mesum yang kabur\Nsambil telanjang.
Dialogue: 0,0:09:08.99,0:09:09.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayahanda.
Dialogue: 0,0:09:10.83,0:09:12.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah menduga ini akan terjadi.
Dialogue: 0,0:09:12.41,0:09:16.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebelum pergi ke Kyo, aku minta\Npembuat zirah untuk membuat purwarupa.
Dialogue: 0,0:09:16.58,0:09:20.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zirah yang dirancang khusus\Nuntuk Kakanda kabur.
Dialogue: 0,0:09:20.88,0:09:24.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sumber beratnya berasal\Ndari pelat penyusun zirah.
Dialogue: 0,0:09:24.63,0:09:26.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan menggunakan\Nteknik pembungkus sutra,
Dialogue: 0,0:09:26.72,0:09:30.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami menempatkan pelat\Npelindung seperlunya saja,
Dialogue: 0,0:09:30.55,0:09:32.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mengintegrasikan pakaian\Ndan zirah menjadi satu.
Dialogue: 0,0:09:32.72,0:09:35.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami juga mengejar desain\Nyang sangat ramping,
Dialogue: 0,0:09:35.77,0:09:39.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ringan, mudah bergerak,\Ndan tahan terhadap benturan.
Dialogue: 0,0:09:41.57,0:09:42.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai dari zaman ini,
Dialogue: 0,0:09:42.90,0:09:46.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}zirah samurai menjadi\Nlebih ramping dan ringan.
Dialogue: 0,0:09:46.61,0:09:49.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seiring dengan makin\Npentingnya kemudahan bergerak,
Dialogue: 0,0:09:49.16,0:09:53.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}para samurai menciptakan zirah baru\Nmereka sendiri di zaman modern.
Dialogue: 0,0:09:53.08,0:09:55.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, aku bisa bergerak dengan ini!
Dialogue: 0,0:09:57.00,0:09:58.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Miura!
Dialogue: 0,0:09:59.79,0:10:02.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akulah jenderal kalian.
Dialogue: 0,0:10:02.59,0:10:04.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akan melakukan\Noperasi berbahaya,
Dialogue: 0,0:10:04.55,0:10:06.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi tolong ikuti aku.
Dialogue: 0,0:10:06.80,0:10:08.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat meraih kemenangan pertama,
Dialogue: 0,0:10:08.84,0:10:11.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jari itu pasti takkan masuk hidung lagi.
Dialogue: 0,0:10:13.64,0:10:18.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini? Tiba-tiba auranya muncul\Nbegitu ganti baju.
Dialogue: 0,0:10:24.57,0:10:25.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Yorishige.
Dialogue: 0,0:10:26.69,0:10:30.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebentar lagi rusa muda\Nakan turun dari gunung.
Dialogue: 0,0:10:30.70,0:10:34.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Panggang, taburi garam,\Ndan tambahkan sejumput lada sansho...
Dialogue: 0,0:10:35.45,0:10:37.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memikirkannya saja membuatku lapar.
Dialogue: 0,0:10:39.04,0:10:42.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biasanya, sekarang sedang sibuk\Ndengan persiapan Festival Misayama."
Dialogue: 0,0:10:43.92,0:10:46.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf sudah melibatkanmu.
Dialogue: 0,0:10:46.76,0:10:48.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau melihat masa depan?
Dialogue: 0,0:10:48.55,0:10:49.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:10:50.18,0:10:54.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku merasakan embusan angin\Ndari balik puncak itu.
Dialogue: 0,0:10:55.22,0:10:59.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Angin yang membawa hal-hal muda,\Nringan, dan bergerak maju.
Dialogue: 0,0:11:00.85,0:11:04.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita cuma bisa mendorong mereka.
Dialogue: 0,0:11:04.86,0:11:08.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa depan setelah itu\Nharus mereka lihat sendiri
Dialogue: 0,0:11:08.65,0:11:10.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan arungi sendiri.
Dialogue: 0,0:11:12.86,0:11:16.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kutemani.\NApa pun takdir yang menanti.
Dialogue: 0,0:11:16.62,0:11:17.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Yorishige!
Dialogue: 0,0:11:18.91,0:11:21.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gampang banget gerak pakai zirah ini!
Dialogue: 0,0:11:21.92,0:11:24.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Muda, kamu terlalu heboh.
Dialogue: 0,0:11:24.50,0:11:27.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, syukurlah!
Dialogue: 0,0:11:32.26,0:11:34.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, ada apa?
Dialogue: 0,0:11:34.14,0:11:35.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Tokiyuki.
Dialogue: 0,0:11:35.43,0:11:39.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anda bilang bertemu dengan\Nputri Sasaki Doyo di Kyo, 'kan?
Dialogue: 0,0:11:39.56,0:11:41.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, namanya Nona Mima...
Dialogue: 0,0:11:49.65,0:11:53.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak!
Dialogue: 0,0:11:54.24,0:11:55.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiga Jenderal.
Dialogue: 0,0:11:55.62,0:11:56.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:11:57.24,0:11:59.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Yorishige aneh sejak tadi.
Dialogue: 0,0:12:00.00,0:12:03.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai menggelar futon segala,\Njangan bilang mau tidur di sini?
Dialogue: 0,0:12:03.71,0:12:07.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dewa sepertiku mau di mana pun berada,\Nitu kehendak ilahi!
Dialogue: 0,0:12:07.54,0:12:10.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa repot kalau ada yang menyelinap\Nke tempat Tuan Tokiyuki malam-malam.
Dialogue: 0,0:12:11.21,0:12:12.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisik-bisik apa, sih?
Dialogue: 0,0:12:12.97,0:12:13.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kena, deh!
Dialogue: 0,0:12:14.84,0:12:16.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aneh...
Dialogue: 0,0:12:16.34,0:12:19.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal di masa depan\Nada permainan lempar bantal.
Dialogue: 0,0:12:19.35,0:12:21.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti bukan pakai bantal kayu!
Dialogue: 0,0:12:21.89,0:12:25.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bantal yang bukan pakai kayu?\NMemang ada?
Dialogue: 0,0:12:30.48,0:12:32.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keluarlah.
Dialogue: 0,0:12:32.53,0:12:34.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akan berperang besok.
Dialogue: 0,0:12:36.57,0:12:40.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itulah, saya rasa tak ada waktu untuk\Nbicara dengan tenang untuk sementara waktu.
Dialogue: 0,0:12:42.41,0:12:44.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini kesempatan bagus!
Dialogue: 0,0:12:44.21,0:12:46.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo tidur di futon yang sama!
Dialogue: 0,0:12:46.17,0:12:46.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:12:47.13,0:12:51.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anda menghabiskan masa manja\Ntanpa seorang ayah, 'kan?
Dialogue: 0,0:12:51.09,0:12:54.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya Anda ingin tidur bareng\Ndan gandengan tangan, 'kan?
Dialogue: 0,0:12:54.80,0:12:56.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ogah, najis!
Dialogue: 0,0:12:56.51,0:12:59.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa salahnya gandengan doang?
Dialogue: 0,0:12:59.47,0:13:03.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo masuk ke selimut Yorishige!
Dialogue: 0,0:13:03.02,0:13:04.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mau!
Dialogue: 0,0:13:04.23,0:13:06.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar Om Bersinar tidak tahu jarak!
Dialogue: 0,0:13:08.23,0:13:12.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di malam sebelum perang,\Nkonyol banget...
Dialogue: 0,0:13:14.07,0:13:17.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau bisa melihat masa depan\Nkita sampai ke Kamakura?
Dialogue: 0,0:13:17.74,0:13:19.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:13:19.03,0:13:21.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu perang terjadi di luar Shinano,
Dialogue: 0,0:13:21.54,0:13:24.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebagian besar penglihatan saya\Ntak berfungsi lagi.
Dialogue: 0,0:13:27.33,0:13:29.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak masalah walau saya\Ntak bisa melihat masa depan.
Dialogue: 0,0:13:30.84,0:13:32.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam dua tahun ini,
Dialogue: 0,0:13:32.80,0:13:35.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}saya yakin setelah melihat Anda.
Dialogue: 0,0:13:36.51,0:13:40.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anda pasti menjadi pahlawan.
Dialogue: 0,0:13:41.56,0:13:42.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan sebagai dewa,
Dialogue: 0,0:13:43.72,0:13:47.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi Yorishige sebagai manusia\Nmenjamin itu.
Dialogue: 0,0:13:54.11,0:13:57.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan hanya memberiku kesempatan\Nberperang untuk memulihkan Keshogunan,
Dialogue: 0,0:13:57.57,0:13:59.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ia juga menjadi keluarga\Nyang telah hilang dariku.
Dialogue: 0,0:14:00.91,0:14:02.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berutang banyak pada orang ini.
Dialogue: 0,0:14:06.45,0:14:10.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tangan doang, kok. Dasar pelit.
Dialogue: 0,0:14:18.84,0:14:19.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku...
Dialogue: 0,0:14:20.39,0:14:22.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pasti akan merebut takhta.
Dialogue: 0,0:14:28.85,0:14:30.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eng...
Dialogue: 0,0:14:30.60,0:14:32.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Shokan, ya?
Dialogue: 0,0:14:32.52,0:14:35.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cara bacanya "Shogen", Tuan Kusunoki.
Dialogue: 0,0:14:35.32,0:14:37.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak usah ribet soal cara bacanya.
Dialogue: 0,0:14:38.45,0:14:42.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita cuma keroco yang baru saja\Nmengangkat senjata dan tanpa nama.
Dialogue: 0,0:14:42.74,0:14:47.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketika kau menjadi samurai yang tangguh\Ndan menghadapi musuh tangguh,
Dialogue: 0,0:14:47.16,0:14:50.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau boleh dengan bangga\Nmenyatakan namamu yang benar.
Dialogue: 0,0:14:59.76,0:15:03.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}1335. Awal Juli.
Dialogue: 0,0:15:04.10,0:15:07.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dewa Shinano yang terlelap\Nmulai bergerak.
Dialogue: 0,0:15:07.97,0:15:10.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nama Tokiyuki masih dirahasiakan,
Dialogue: 0,0:15:10.48,0:15:14.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yorishige memimpin sendiri\Npasukan dan mulai bergerak.
Dialogue: 0,0:15:15.48,0:15:18.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seorang anak laki-laki\Nmengguncang seluruh Jepang.
Dialogue: 0,0:15:18.90,0:15:21.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini menandai awal dari\NPemberontakan Nakasendai.
Dialogue: 0,0:15:25.49,0:15:26.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo!
Dialogue: 0,0:15:27.20,0:15:30.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktunya balaskan dendam kita!
Dialogue: 0,0:15:32.71,0:15:34.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perang besar yang telah lama dinantikan
Dialogue: 0,0:15:34.46,0:15:38.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dimulai ketika pasukan\NHoshina menyerang Gubernur.
Dialogue: 0,0:15:39.17,0:15:43.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, Ogasawara Sadamune\Nmemprediksi serangan ini
Dialogue: 0,0:15:43.22,0:15:47.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan bersama Ichikawa Sukefusa, mereka\Nmembantu gubernur dari utara dan selatan.
Dialogue: 0,0:15:47.68,0:15:52.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasukan Yorishige mengejar Sadamune.
Dialogue: 0,0:15:53.85,0:15:58.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kubu Hoshina tidak akan berperang\Njika tak bisa mereka menangkan sendiri.
Dialogue: 0,0:15:59.32,0:16:02.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang berarti, pasukan utama\NSuwa pasti akan muncul.
Dialogue: 0,0:16:03.03,0:16:06.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka menggunakan Hoshina sebagai umpan\Nuntuk menyerang Sadamune dari belakang.
Dialogue: 0,0:16:09.20,0:16:11.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Naif sekali, Suwa Myojin.
Dialogue: 0,0:16:11.54,0:16:15.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kuhancurkan strategi\Nremehmu itu dengan strategiku.
Dialogue: 0,0:16:16.88,0:16:20.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat pasukan utama Suwa\Nmenyerang pasukan Tuan Sadamune,
Dialogue: 0,0:16:20.59,0:16:24.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pasukan kita akan menyerang\Ndari pegunungan di belakang mereka.
Dialogue: 0,0:16:25.09,0:16:28.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Burung pipit memangsa belalang sembah\Nyang sedang memburu jangkrik.
Dialogue: 0,0:16:29.22,0:16:31.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengincar pemburu yang lengah.
Dialogue: 0,0:16:33.98,0:16:35.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beri perintah ke seluruh pasukan.
Dialogue: 0,0:16:35.73,0:16:38.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai dari sini, lewati dengan cepat.
Dialogue: 0,0:16:38.27,0:16:39.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:16:40.32,0:16:44.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di kanan atas terdapat tebing terbuka\Ndan di kiri bawah ada sungai yang dalam.
Dialogue: 0,0:16:44.36,0:16:47.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika ada pemanah di tebing,\Nmereka akan menjadi sasaran empuk.
Dialogue: 0,0:16:47.99,0:16:49.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh...
Dialogue: 0,0:16:49.45,0:16:51.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku terlalu waspada?
Dialogue: 0,0:16:51.49,0:16:55.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan medan yang bisa dilewati dengan cepat,\Nmereka butuh 300 prajurit berkuda
Dialogue: 0,0:16:55.87,0:16:57.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk memusnahkan pasukan\Nkita dengan hujan panah.
Dialogue: 0,0:16:58.54,0:17:01.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berdasarkan jumlah pasukan\NYorishige yang dilihat pengintai,
Dialogue: 0,0:17:01.46,0:17:05.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}seharusnya tidak ada tempat untuk\Nmenyembunyikan 300 pasukan di pegunungan ini.
Dialogue: 0,0:17:06.05,0:17:07.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:17:08.76,0:17:13.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekalipun terjadi serangan,\Njangan panik dan lewati dengan tenang.
Dialogue: 0,0:17:14.68,0:17:16.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bos ini jahat.
Dialogue: 0,0:17:17.10,0:17:21.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa harus bersabar membunuh\Nsebelum melewati tebing?
Dialogue: 0,0:17:23.23,0:17:25.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal kita tidak pernah bersabar!
Dialogue: 0,0:17:25.53,0:17:27.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan mengamuk terus jatuh, lo!
Dialogue: 0,0:17:27.24,0:17:29.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalaupun jatuh, bakal ditinggal juga.
Dialogue: 0,0:17:29.91,0:17:31.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, benar.
Dialogue: 0,0:17:31.53,0:17:33.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo bantai-bantai setelah melewati itu.
Dialogue: 0,0:17:33.54,0:17:35.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:17:39.29,0:17:41.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah masih sempat.
Dialogue: 0,0:17:41.75,0:17:45.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oi, Chojumaru! Kau yakin\Nmau melakukan aksi bunuh diri ini?
Dialogue: 0,0:17:45.88,0:17:47.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja!
Dialogue: 0,0:17:47.01,0:17:50.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita sudah belajar cara naiknya\Ndari orang Shinano semalam, 'kan?
Dialogue: 0,0:17:55.89,0:17:57.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tinggi banget.
Dialogue: 0,0:17:57.19,0:17:58.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku takut.
Dialogue: 0,0:17:58.69,0:18:01.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa malah birahi, Bocah Tengik?!
Dialogue: 0,0:18:01.02,0:18:03.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bulatkan tekad kalian.
Dialogue: 0,0:18:03.65,0:18:05.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inilah perang Tuan Muda.
Dialogue: 0,0:18:05.44,0:18:07.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seru banget kalau sudah terbiasa.
Dialogue: 0,0:18:07.74,0:18:08.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:18:09.36,0:18:12.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat menggunakannya sebagai penanda\Nsaat main kejar-kejaran dengan Tuan Yoritsugu,
Dialogue: 0,0:18:12.53,0:18:15.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku sempat bertanya-tanya\Nbenda itu digunakan untuk apa...
Dialogue: 0,0:18:16.12,0:18:20.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, penduduk Shinano terobsesi\Ndengan benda itu setiap enam tahun sekali.
Dialogue: 0,0:18:20.83,0:18:22.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nekat banget!
Dialogue: 0,0:18:22.88,0:18:26.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata ada festival\Nseberbahaya itu di Shinano!
Dialogue: 0,0:18:26.09,0:18:28.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo maju, Semuanya!
Dialogue: 0,0:18:39.77,0:18:40.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suara apa itu?
Dialogue: 0,0:18:41.48,0:18:43.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bukan suara anak panah\Nataupun pasukan berkuda.
Dialogue: 0,0:18:45.23,0:18:47.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini?!
Dialogue: 0,0:18:50.45,0:18:53.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cihuy! Maju!
Dialogue: 0,0:18:53.53,0:18:56.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kita harus bagaimana\Nsetelah ini, Tuan Muda?
Dialogue: 0,0:18:57.33,0:18:58.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana, ya...
Dialogue: 0,0:18:59.29,0:19:01.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tidak bisa turun kalau begini...
Dialogue: 0,0:19:01.96,0:19:02.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:19:03.17,0:19:04.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo lanjut terus!
Dialogue: 0,0:19:04.67,0:19:06.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lari!
Dialogue: 0,0:19:06.88,0:19:08.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Strategi banteng api?
Dialogue: 0,0:19:08.42,0:19:11.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, mustahil naik banteng\Nbisa mendaki tebing itu!
Dialogue: 0,0:19:15.97,0:19:18.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersiaplah, Shokan!
Dialogue: 0,0:19:31.99,0:19:34.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira bakal mati!
Dialogue: 0,0:19:34.32,0:19:36.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gila sekali idenya.
Dialogue: 0,0:19:36.99,0:19:38.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Muda tidak apa-apa?
Dialogue: 0,0:19:41.16,0:19:42.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Muda!
Dialogue: 0,0:19:42.96,0:19:44.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jenderal musuh juga tidak ada!
Dialogue: 0,0:19:50.55,0:19:52.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak Hojo!
Dialogue: 0,0:20:02.35,0:20:05.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita turun juga.\NKemungkinan, Fubuki juga di bawah.
Dialogue: 0,0:20:05.27,0:20:06.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:20:07.73,0:20:11.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya ampun. Tidak bisa berakhir\Ndengan mudah, ya.
Dialogue: 0,0:20:11.32,0:20:14.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo cepat kita bereskan\Ndan cari Tuan Muda.
Dialogue: 0,0:20:14.57,0:20:15.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:20:17.66,0:20:19.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Muda!
Dialogue: 0,0:20:19.08,0:20:20.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong jawab!
Dialogue: 0,0:20:23.29,0:20:26.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tahun 1335 Masehi.
Dialogue: 0,0:20:27.38,0:20:31.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejarah sedang berubah drastis.
Dialogue: 0,0:20:44.77,0:20:47.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan di wilayah yang jauh di utara pun,
Dialogue: 0,0:20:47.19,0:20:50.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ada seorang ahli strategi cerdik yang\Nmembayangkan masa depan dengan tenang.
Dialogue: 0,0:20:51.82,0:20:52.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada akhirnya...
Dialogue: 0,0:20:52.90,0:20:56.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nama Hojo Tokiyuki muncul\Ndi tengah kekacauan itu.
Dialogue: 0,0:20:57.07,0:21:00.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dipandu pertemuan, memikul perpisahan,
Dialogue: 0,0:21:00.08,0:21:02.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pemuda itu pun pergi\Nke zaman penuh gejolak.
Dialogue: 0,0:21:03.37,0:21:06.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisakah ia bertahan hidup?
Dialogue: 0,0:21:07.83,0:21:10.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu, 'kan, jago kabur.
Dialogue: 0,0:21:10.42,0:21:12.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti tidak apa-apa.
Dialogue: 0,0:21:12.59,0:21:14.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Tokiyuki, semangat!
Dialogue: 0,0:21:23.10,0:21:24.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seru banget!
Dialogue: 0,0:21:25.02,0:21:26.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi sudah berakhir.
Dialogue: 0,0:21:27.85,0:21:28.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shokan!
Dialogue: 0,0:21:29.19,0:21:33.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku datang hari ini sebagai jenderal\Nuntuk mengalahkanmu.
Dialogue: 0,0:21:34.65,0:21:36.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Muda!
Dialogue: 0,0:21:36.11,0:21:37.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fubuki!
Dialogue: 0,0:21:41.24,0:21:42.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo!
Dialogue: 0,0:22:03.69,0:22:08.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bila ingin romantis♪
Dialogue: 0,0:22:08.57,0:22:11.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cintai aku lebih dari siapa pun♪
Dialogue: 0,0:22:17.16,0:22:20.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kamu orang yang baik♪
Dialogue: 0,0:22:20.54,0:22:24.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bakal baik ke gadis itu juga, 'kan?♪
Dialogue: 0,0:22:24.29,0:22:27.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa, tidak masalah♪
Dialogue: 0,0:22:27.63,0:22:31.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong bawakan\Nsemua barang beratnya, ya♪
Dialogue: 0,0:22:31.34,0:22:34.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu keren di depan orang-orang♪
Dialogue: 0,0:22:34.51,0:22:38.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kamu imut saat kita berduaan♪
Dialogue: 0,0:22:38.30,0:22:41.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setia seperti anjing♪
Dialogue: 0,0:22:41.64,0:22:47.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan menghilang seperti kucing, ya♪
Dialogue: 0,0:22:48.31,0:22:51.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terkadang aku sedih♪
Dialogue: 0,0:22:51.82,0:22:55.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi sentimental\Nsaat menatap bintang♪
Dialogue: 0,0:22:55.40,0:23:02.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini, kamu dengan siapa\Ndan sedang apa?♪
Dialogue: 0,0:23:02.54,0:23:06.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, jika kamu mau\Nmencintai dan dicintai♪
Dialogue: 0,0:23:06.50,0:23:09.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan selalu membuatmu berdebar♪
Dialogue: 0,0:23:09.96,0:23:13.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika tidak memilihku♪
Dialogue: 0,0:23:13.55,0:23:17.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menjatuhkanmu ke neraka♪
Dialogue: 0,0:23:17.22,0:23:20.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mendengarmu♪
Dialogue: 0,0:23:20.68,0:23:24.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau tahu lagi♪
Dialogue: 0,0:23:24.43,0:23:28.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bila ingin romantis♪
Dialogue: 0,0:23:28.06,0:23:30.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cintai aku lebih dari siapa pun♪
Dialogue: 0,0:23:32.23,0:23:33.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku melihat masa depan.
Dialogue: 0,0:23:33.10,0:23:34.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:23:33.90,0:23:36.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa depan di mana orang\Nyang menonton hidup bahagia.
