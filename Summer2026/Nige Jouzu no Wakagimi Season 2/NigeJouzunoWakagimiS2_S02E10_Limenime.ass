Dialogue: 0,0:23:38.94,0:23:39.94,sign,,0000,0000,0000,,(Episode 23 [Tahun 1335]\NLanjutan - Buddhaku)
Dialogue: 0,0:00:09.08,0:00:12.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakanda... Ayahanda...
Dialogue: 0,0:00:12.46,0:00:14.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:00:14.67,0:00:17.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bukan tempat anak kecil.
Dialogue: 0,0:00:17.84,0:00:20.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku main petak umpet, terus tersesat.
Dialogue: 0,0:00:21.55,0:00:24.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jauh sekali larimu.
Dialogue: 0,0:00:27.22,0:00:31.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Vila ayah Anda masih jauh di sana.
Dialogue: 0,0:00:32.89,0:00:33.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa?
Dialogue: 0,0:00:35.73,0:00:37.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya pengawal dari Provinsi Shimotsuke.
Dialogue: 0,0:00:37.56,0:00:39.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nama saya Ashikaga Takauji.
Dialogue: 0,0:00:40.52,0:00:45.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya dengar ada keributan besar\Nkarena putra Tuan Takatoki hilang,
Dialogue: 0,0:00:45.74,0:00:47.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}firasat saya bilang ada di sekitar sini.
Dialogue: 0,0:00:49.08,0:00:51.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Firasat?
Dialogue: 0,0:00:52.20,0:00:55.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari, kembalilah ke keluarga Anda.
Dialogue: 0,0:00:56.92,0:00:57.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mau.
Dialogue: 0,0:00:58.04,0:01:00.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku nanti dimarahi\Ndan dilarang petak umpet.
Dialogue: 0,0:01:00.42,0:01:02.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih baik mati daripada tidak bisa kabur.
Dialogue: 0,0:01:02.63,0:01:05.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa terobsesi sekali dengan kabur?
Dialogue: 0,0:01:08.97,0:01:09.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sip!
Dialogue: 0,0:01:10.47,0:01:13.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, jika dilarang petak umpet,
Dialogue: 0,0:01:13.72,0:01:18.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}saya akan menjadi iblis\Ntanpa memberi tahu ayah Anda.
Dialogue: 0,0:01:18.52,0:01:20.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Intuisi saya bagus.
Dialogue: 0,0:01:20.98,0:01:23.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau lari ke mana pun,\Npasti saya temukan.
Dialogue: 0,0:01:26.95,0:01:28.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh?
Dialogue: 0,0:01:28.41,0:01:29.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:01:30.37,0:01:31.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai neraka juga?
Dialogue: 0,0:01:32.79,0:01:33.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Neraka?
Dialogue: 0,0:01:33.95,0:01:37.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mimpiku adalah bermain\Npetak umpet dengan iblis sungguhan!
Dialogue: 0,0:01:37.41,0:01:38.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo main bareng!
Dialogue: 0,0:01:39.13,0:01:41.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih muda, tapi mimpi\NAnda berbahaya sekali.
Dialogue: 0,0:01:42.46,0:01:44.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau, 'kan? Janji, ya!
Dialogue: 0,0:01:49.34,0:01:52.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teruslah hidup dan tunggu waktunya♪
Dialogue: 0,0:01:52.30,0:01:57.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jinjing nyawamu dan tembus takdir♪
Dialogue: 0,0:01:57.14,0:02:00.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hiduplah dalam malu\Ndan kejar mimpimu♪
Dialogue: 0,0:02:00.35,0:02:05.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi orang-orang\Nyang percaya padamu♪
Dialogue: 0,0:02:19.08,0:02:22.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagian besar takkan tercatat\Ndalam sejarah♪
Dialogue: 0,0:02:22.33,0:02:25.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua hal konyol itu♪
Dialogue: 0,0:02:25.84,0:02:29.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membelit dan terurai, lagi dan lagi♪
Dialogue: 0,0:02:29.63,0:02:32.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tarik napas♪
Dialogue: 0,0:02:32.68,0:02:36.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk apa hidup ini dipersembahkan?♪
Dialogue: 0,0:02:36.27,0:02:39.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takdir apa yang menanti?♪
Dialogue: 0,0:02:39.64,0:02:42.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bila rasa bak kutukan♪
Dialogue: 0,0:02:42.52,0:02:46.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan bisa mengikatku♪
Dialogue: 0,0:02:46.86,0:02:49.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teruslah hidup dan tunggu waktunya♪
Dialogue: 0,0:02:49.65,0:02:54.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jinjing nyawamu dan lawan takdir♪
Dialogue: 0,0:02:54.53,0:02:57.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hiduplah dalam malu\Ndan kejar mimpimu♪
Dialogue: 0,0:02:57.70,0:03:02.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi orang-orang\Nyang percaya padamu♪
Dialogue: 0,0:03:02.04,0:03:05.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Iblis, sini,\Nikuti suara tepuk tanganku♪
Dialogue: 0,0:03:05.21,0:03:08.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}(Hei, Iblis, sini,\Nikuti suara tepuk tanganku)♪
Dialogue: 0,0:03:08.80,0:03:12.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hidup itu singkat,\Nmenyanyi dan menarilah♪
Dialogue: 0,0:03:12.18,0:03:16.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bunga akan mekar\Nbagi yang jago kabur♪
Dialogue: 0,0:03:23.19,0:03:27.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lusa, dua jamuan besar akan diadakan\Nbersamaan di dua lokasi berbeda.
Dialogue: 0,0:03:28.44,0:03:30.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama, di Kediaman Saionji.
Dialogue: 0,0:03:30.53,0:03:33.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perjamuan tempat Tuan Yasuie\Nberencana membunuh Kaisar.
Dialogue: 0,0:03:34.32,0:03:36.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kedua, di Kediaman Kusunoki.
Dialogue: 0,0:03:36.45,0:03:39.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perjamuan yang pasti\Ndihadiri oleh Ashikaga Takauji.
Dialogue: 0,0:03:40.79,0:03:46.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersamaan dengan rencana Tuan Yasuie\Nmembunuh Kaisar, kita bunuh Takauji.
Dialogue: 0,0:03:46.63,0:03:48.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah rencana saya.
Dialogue: 0,0:03:48.63,0:03:50.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalaupun keduanya gagal,
Dialogue: 0,0:03:50.88,0:03:53.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}itu akan menimbulkan kekacauan\Nbesar di pemerintahan saat ini.
Dialogue: 0,0:03:53.72,0:03:56.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku rasa ini layak dicoba.
Dialogue: 0,0:03:56.14,0:04:00.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membunuh Takauji yang memimpin samurai\Njauh lebih efektif daripada membunuh Kaisar.
Dialogue: 0,0:04:00.85,0:04:05.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayahanda bilang pembunuhan\Ntakkan berhasil ke Takauji.
Dialogue: 0,0:04:05.81,0:04:08.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya jangan mengambil\Nrisiko yang tidak perlu.
Dialogue: 0,0:04:09.69,0:04:13.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutku, prioritas utama kita adalah\NTuan Muda pulang ke Shinano dengan selamat.
Dialogue: 0,0:04:13.53,0:04:15.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana menurutmu, Bos?
Dialogue: 0,0:04:15.24,0:04:18.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau siap membunuh Takauji\Nmeski tahu risikonya?
Dialogue: 0,0:04:22.29,0:04:26.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika bisa bertemu, banyak yang ingin\Nkutanyakan daripada membunuh dia.
Dialogue: 0,0:04:26.71,0:04:29.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa dia mengkhianati Hojo?
Dialogue: 0,0:04:30.21,0:04:35.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bila aku mengungkap identitasku,\Ndia akan melihatku seperti apa?
Dialogue: 0,0:04:36.18,0:04:37.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:04:39.76,0:04:41.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita coba saja.
Dialogue: 0,0:04:41.60,0:04:45.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meskipun gagal, kita sudah\Nmenyelidiki jalur pelarian.
Dialogue: 0,0:04:45.23,0:04:46.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bagi jadi dua tim.
Dialogue: 0,0:04:46.81,0:04:50.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kojirou, Fubuki, dan Genba\Nbertugas membunuh Takauji.
Dialogue: 0,0:04:51.11,0:04:53.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shizuku dan Ayako\Nbertugas melarikan Paman.
Dialogue: 0,0:04:55.61,0:04:59.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menjelaskan\Nrute pelarian ke Paman.
Dialogue: 0,0:05:01.54,0:05:05.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rencanaku membunuh Kaisar bakal gagal?
Dialogue: 0,0:05:05.71,0:05:08.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yorishige diam saja, ya.
Dialogue: 0,0:05:08.54,0:05:11.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti, ramalan Yorishige\Ntidak bisa dipercaya.
Dialogue: 0,0:05:11.75,0:05:15.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pernah apes karena memercayainya.
Dialogue: 0,0:05:17.59,0:05:20.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana tahu kalau belum dicoba.
Dialogue: 0,0:05:20.18,0:05:21.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu.
Dialogue: 0,0:05:21.76,0:05:24.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paman tidak akan berhenti\Nkalau sudah memutuskan sesuatu.
Dialogue: 0,0:05:25.60,0:05:29.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku sudah menyiapkan kuda\Nuntuk Paman dan Tuan Saionji.
Dialogue: 0,0:05:30.06,0:05:34.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika gagal, ikuti petunjuk Shizuku\Ndan Ayako, lalu kabur.
Dialogue: 0,0:05:35.57,0:05:37.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:05:38.95,0:05:40.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Tokiyuki mau apa?
Dialogue: 0,0:05:43.04,0:05:45.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ada urusan\Nyang tak bisa kutinggalkan.
Dialogue: 0,0:05:46.66,0:05:51.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu khawatir. Mari bertemu\Ndi lokasi yang ditentukan begitu selesai.
Dialogue: 0,0:06:00.59,0:06:03.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Persiapannya harus matang.
Dialogue: 0,0:06:04.22,0:06:06.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agar mendapat hasil sebagus mungkin.
Dialogue: 0,0:06:08.06,0:06:10.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agar semuanya bisa kabur ke Shinano.
Dialogue: 0,0:06:22.03,0:06:25.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan terjadi sesuatu di ibu kota hari ini.
Dialogue: 0,0:06:25.08,0:06:27.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Firasatku bilang begitu.
Dialogue: 0,0:06:27.83,0:06:31.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Muda berbeda dengan basara\Nyang cuma meniru tampak luar.
Dialogue: 0,0:06:32.00,0:06:35.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia dari desa, tapi memendam\Nsesuatu dalam dirinya.
Dialogue: 0,0:06:50.52,0:06:52.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kenapa?
Dialogue: 0,0:06:52.98,0:06:55.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gelisah yang menyesakkan ini...
Dialogue: 0,0:06:59.24,0:07:00.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai jumpa, Tuan Yoshisada.
Dialogue: 0,0:07:01.32,0:07:04.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempat ini tidak aman, jadi mohon\Nhati-hati terhadap pembunuh bayaran.
Dialogue: 0,0:07:05.37,0:07:07.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bercanda, Tuan Takauji!
Dialogue: 0,0:07:07.49,0:07:11.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada orang yang punya nyali\Nuntuk membunuh Nitta Yoshisada!
Dialogue: 0,0:07:13.04,0:07:17.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ashikaga selalu saja memerintah Nitta.
Dialogue: 0,0:07:17.88,0:07:22.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Yoshisada, ini seolah\NAnda suruhannya Takauji!
Dialogue: 0,0:07:22.89,0:07:28.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Prestasi Anda menjatuhkan Kamakura\Njauh lebih hebat daripada Takauji!
Dialogue: 0,0:07:28.02,0:07:29.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan khawatir!
Dialogue: 0,0:07:29.60,0:07:31.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika menjadi musuh,\Ntinggal kita kalahkan saja!
Dialogue: 0,0:07:32.81,0:07:37.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo makan! Memikirkan masa depan\Ntakkan mengisi perut kosongmu!
Dialogue: 0,0:07:38.11,0:07:39.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan kita...
Dialogue: 0,0:07:40.19,0:07:43.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ia terkenal mampu menebas\Nhujan anak panah.
Dialogue: 0,0:07:43.78,0:07:47.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kepemimpinannya yang tegas dalam\Nmenjatuhkan Kamakura tercatat dalam sejarah.
Dialogue: 0,0:07:47.49,0:07:51.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sosok samurai teladan, penuh semangat\Njuang dengan wajah gagah dan tegas.
Dialogue: 0,0:07:51.91,0:07:53.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, yah...
Dialogue: 0,0:07:54.75,0:07:58.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selalu ada sesuatu di samping kepalanya...
Dialogue: 0,0:07:58.50,0:08:00.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa, ya? Rasanya...
Dialogue: 0,0:08:01.72,0:08:05.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku merasa dia tidak mengerti apa-apa.
Dialogue: 0,0:08:08.06,0:08:10.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebentar lagi kita tiba\Ndi kediaman Tuan Kusunoki.
Dialogue: 0,0:08:10.72,0:08:11.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:08:12.27,0:08:16.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutku si rakun Kusunoki itu berbahaya.
Dialogue: 0,0:08:16.36,0:08:20.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia lebih kuat dari Nitta,\Ntapi pura-pura lemah.
Dialogue: 0,0:08:20.03,0:08:22.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan mencurigai orang lain, Moroyasu.
Dialogue: 0,0:08:22.57,0:08:25.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia adalah sekutu kuat\Nyang melayani kaisar yang sama.
Dialogue: 0,0:08:25.53,0:08:28.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih kerja kerasnya\Nsampai lembur malam-malam.
Dialogue: 0,0:08:30.29,0:08:32.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, Tuan Kusunoki!
Dialogue: 0,0:08:33.46,0:08:35.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau menjemput kami, ya?
Dialogue: 0,0:08:36.17,0:08:40.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa Tuan Kusunoki langsung\Nyang menjemput kami?
Dialogue: 0,0:08:40.63,0:08:43.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini permintaan maaf\Natas kelalaian saya.
Dialogue: 0,0:08:43.26,0:08:45.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jumlah tamu yang dibawa\Nternyata lebih banyak,
Dialogue: 0,0:08:45.68,0:08:48.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sudah tidak ada tempat\Nuntuk mengikat kuda.
Dialogue: 0,0:08:48.93,0:08:52.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami sudah sisakan tempat\Nuntuk Tuan Takauji,
Dialogue: 0,0:08:52.68,0:08:56.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi pengikut Tuan harus dipandu\Nmereka mengikat kuda di sana.
Dialogue: 0,0:08:58.27,0:08:59.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kalau begitu...
Dialogue: 0,0:08:59.82,0:09:01.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kediaman saya sudah di depan sana.
Dialogue: 0,0:09:01.82,0:09:05.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya akan bertanggung jawab\Nmenjaga Tuan Takauji.
Dialogue: 0,0:09:05.45,0:09:06.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Woi!
Dialogue: 0,0:09:06.57,0:09:08.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enteng sekali menyebut—
Dialogue: 0,0:09:08.07,0:09:09.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cukup, Moroyasu.
Dialogue: 0,0:09:10.95,0:09:13.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami yang salah karena terlambat\Ndatang ke perjamuan.
Dialogue: 0,0:09:13.37,0:09:15.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari, Tuan Kusunoki.
Dialogue: 0,0:09:15.54,0:09:17.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih. Mari lewat sini.
Dialogue: 0,0:09:20.54,0:09:23.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si Kusunoki ternyata jauh lebih bodoh.
Dialogue: 0,0:09:23.67,0:09:26.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pasti tidak terbiasa\Nmenggelar jamuan besar.
Dialogue: 0,0:09:27.38,0:09:30.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajar saja untuk samurai pendatang\Nyang latar belakangnya tidak jelas.
Dialogue: 0,0:09:41.27,0:09:43.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oi, kita jalan sampai mana?
Dialogue: 0,0:09:43.48,0:09:46.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jauh sekali hanya untuk mengikat kuda.
Dialogue: 0,0:09:48.32,0:09:51.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Kusunoki bilang\Nkita hanya perlu mengantar,
Dialogue: 0,0:09:51.45,0:09:54.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}katanya Tuan Moronao\Nsudah tahu tempatnya.
Dialogue: 0,0:09:59.88,0:10:04.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, apa maumu,\NTuan Kusunoki Palsu?
Dialogue: 0,0:10:06.38,0:10:08.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau yang bersembunyi\Ndi bayangan pohon pinus di situ!
Dialogue: 0,0:10:09.01,0:10:10.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak bisa membidikku\Nkalau tidak keluar!
Dialogue: 0,0:10:20.10,0:10:22.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ashikaga Takauji, serahkan nyawamu!
Dialogue: 0,0:10:27.19,0:10:28.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kena!
Dialogue: 0,0:10:41.75,0:10:42.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hilang...
Dialogue: 0,0:10:43.71,0:10:45.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau jenderalnya, ya?
Dialogue: 0,0:10:46.88,0:10:48.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Celaka! Wajahku!
Dialogue: 0,0:10:48.38,0:10:52.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pasti putra samurai\Nyang tewas di sekitar Kyo.
Dialogue: 0,0:10:52.72,0:10:56.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajar kau dendam pada Takauji\Nkarena menjadi tunawisma.
Dialogue: 0,0:10:56.89,0:10:59.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi jangan sia-siakan nyawamu.
Dialogue: 0,0:11:00.14,0:11:01.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melihat wajahmu...
Dialogue: 0,0:11:03.23,0:11:05.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau belum 10 tahun, 'kan?
Dialogue: 0,0:11:07.61,0:11:09.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak hal menyenangkan!
Dialogue: 0,0:11:10.28,0:11:13.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lupakan dendammu\Ndan pelajarilah dunia ini!
Dialogue: 0,0:11:14.70,0:11:17.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat kau mengenal kebahagiaan\Nbesar di duniamu nanti,
Dialogue: 0,0:11:17.62,0:11:20.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}warna dendam dalam wajahmu\Npasti akan lenyap!
Dialogue: 0,0:11:26.75,0:11:31.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak ingat wajah ini?
Dialogue: 0,0:11:31.38,0:11:34.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kita pernah bertemu?
Dialogue: 0,0:11:34.80,0:11:36.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon maaf!
Dialogue: 0,0:11:36.51,0:11:40.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku gampang lupa wajah orang\Nyang tidak terlalu dekat denganku.
Dialogue: 0,0:11:40.85,0:11:42.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lupa?
Dialogue: 0,0:11:43.27,0:11:46.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma memikirkan masa depan.
Dialogue: 0,0:11:46.02,0:11:50.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku biarkan para pengikutku\Nyang mengingat hal-hal yang sudah lalu.
Dialogue: 0,0:11:51.11,0:11:54.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh! Aku sungguh minta maaf!\NAku tidak berniat buruk!
Dialogue: 0,0:11:55.20,0:11:59.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suara ini... Wajah ini... Sentuhan ini...
Dialogue: 0,0:11:59.04,0:12:01.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengingat semuanya!
Dialogue: 0,0:12:01.96,0:12:04.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi pria ini...
Dialogue: 0,0:12:06.29,0:12:07.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:12:07.42,0:12:10.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa harus menghancurkan Kamakura?
Dialogue: 0,0:12:10.88,0:12:11.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Kenapa?"
Dialogue: 0,0:12:12.38,0:12:14.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga tidak tahu.
Dialogue: 0,0:12:14.18,0:12:17.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma bisa bilang,\NKamakura sudah hancur.
Dialogue: 0,0:12:24.06,0:12:25.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamakura hancur
Dialogue: 0,0:12:26.61,0:12:28.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena alasan yang tidak jelas?
Dialogue: 0,0:12:32.74,0:12:34.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, aku tahu, Nak!
Dialogue: 0,0:12:34.86,0:12:37.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bisa menyanyi?\NKau bisa main seruling?
Dialogue: 0,0:12:37.57,0:12:39.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bisa menari?
Dialogue: 0,0:12:40.87,0:12:42.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa tiba-tiba tanya itu?
Dialogue: 0,0:12:42.75,0:12:46.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kau mau mengabdi padaku,\Naku akan mengurusmu.
Dialogue: 0,0:12:47.21,0:12:51.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau hidup berkecukupan di bawah Takauji,\Nmendiang keluargamu pasti senang, 'kan?
Dialogue: 0,0:12:52.17,0:12:54.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, itu pilihan terbaik.
Dialogue: 0,0:12:54.26,0:12:58.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada banyak kimono indah\Ndan camilan enak, lo!
Dialogue: 0,0:13:00.39,0:13:02.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurang ajar!
Dialogue: 0,0:13:02.52,0:13:05.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya juga.
Dialogue: 0,0:13:05.56,0:13:09.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, kalau kau datang\Nuntuk membunuhku,
Dialogue: 0,0:13:10.27,0:13:13.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berarti aku harus membunuhmu, ya?
Dialogue: 0,0:13:26.00,0:13:27.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Muda!
Dialogue: 0,0:13:27.71,0:13:30.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak menyangka dia\Nmonster semengerikan ini!
Dialogue: 0,0:13:30.79,0:13:32.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang jahat tak sadar diri!
Dialogue: 0,0:13:32.46,0:13:35.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pria tanpa rasa bersalah membuat\Norang gila dan membunuhnya!
Dialogue: 0,0:13:36.38,0:13:38.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus menyelamatkan Tuan Muda!
Dialogue: 0,0:13:44.64,0:13:45.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fubuki!
Dialogue: 0,0:13:49.15,0:13:52.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa! Kita tidak sebanding!\NAyo mundur sesuai rencana!
Dialogue: 0,0:14:03.91,0:14:05.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ce-Cepat sekali!
Dialogue: 0,0:14:06.08,0:14:09.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bakal terkejar.\NKita bakal mati kalau terkejar.
Dialogue: 0,0:14:15.88,0:14:18.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau ke mana, Tuan Takauji?
Dialogue: 0,0:14:18.76,0:14:21.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hidangannya keburu dingin, lo.
Dialogue: 0,0:14:23.68,0:14:26.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Kusunoki? Kenapa di sini?
Dialogue: 0,0:14:26.52,0:14:29.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya menjemput Anda\Nkarena datang terlambat.
Dialogue: 0,0:14:29.81,0:14:32.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Istri saya rewel, katanya tidak sopan
Dialogue: 0,0:14:32.61,0:14:35.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau tidak menghidangkan\Nmakanan hangat ke Tuan Takauji.
Dialogue: 0,0:14:35.94,0:14:39.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika saya tidak cepat mengantar Tuan,\Nnanti saya bakal dimarahi lagi.
Dialogue: 0,0:14:39.91,0:14:42.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon lindungi rumah tangga saya.
Dialogue: 0,0:14:46.45,0:14:48.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya kali ini orang asli.
Dialogue: 0,0:14:49.87,0:14:53.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga sudah lapar.\NAyo kita cicipi masakan istrimu.
Dialogue: 0,0:14:55.88,0:14:59.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku khawatir dia mendengar\Npercakapan tadi,
Dialogue: 0,0:14:59.63,0:15:01.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu mencoba memeriksa keadaan...
Dialogue: 0,0:15:04.43,0:15:07.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma membantumu sekali, Nak.
Dialogue: 0,0:15:11.02,0:15:14.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mendapat posisi ini dari Kaisar.
Dialogue: 0,0:15:15.15,0:15:17.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika menjadi musuh Kaisar\Nyang telah berjasa besar kepadaku,
Dialogue: 0,0:15:17.65,0:15:21.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}entah anak-anak ataupun pahlawan,\Naku harus mengalahkannya.
Dialogue: 0,0:15:26.53,0:15:28.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan! Bagaimana keadaan Anda?
Dialogue: 0,0:15:28.41,0:15:29.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik-baik saja!
Dialogue: 0,0:15:29.70,0:15:32.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak-anak yang lari itu siapa?
Dialogue: 0,0:15:32.50,0:15:33.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pembunuh bayaran.
Dialogue: 0,0:15:33.75,0:15:36.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teknik yang cerdik,\Ntidak seperti anak-anak.
Dialogue: 0,0:15:36.96,0:15:40.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Kita harus mengirim pengejar!
Dialogue: 0,0:15:40.22,0:15:43.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu.\NToh, sudah berlalu.
Dialogue: 0,0:15:43.26,0:15:46.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daripada mengirim pengejar,\Nsiapkan saja alkohol dan makanan.
Dialogue: 0,0:15:46.72,0:15:50.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Takauji benar-benar lapang dada.
Dialogue: 0,0:15:50.10,0:15:53.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masalah pembunuh bayaran cuma\Njadi bahan obrolan minum-minum.
Dialogue: 0,0:15:53.56,0:15:56.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rakun biadab, dalangnya, 'kan, kau.
Dialogue: 0,0:15:56.90,0:16:00.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia yang bersumpah setia\Npada Kaisar cukup merepotkan.
Dialogue: 0,0:16:01.49,0:16:03.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus menyingkirkannya\Ncepat atau lambat.
Dialogue: 0,0:16:04.11,0:16:07.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, menu hari ini apa?
Dialogue: 0,0:16:07.08,0:16:10.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada udon kesukaan Tuan Takauji, lo!
Dialogue: 0,0:16:10.50,0:16:11.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asyik!
Dialogue: 0,0:16:11.83,0:16:15.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Udon adalah makanan khas\Nkota kami, Shimotsuke.
Dialogue: 0,0:16:15.58,0:16:19.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ada orang di Kyo yang bisa\Nmemasaknya lebih enak dariku?
Dialogue: 0,0:16:20.96,0:16:23.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan dibanding-bandingkan, Moronao.
Dialogue: 0,0:16:24.43,0:16:29.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Saionji! Anda ditangkap atas dugaan\Npembunuhan terhadap Kaisar!
Dialogue: 0,0:16:34.31,0:16:38.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang datang ke jamuan bukan Kaisar,\Ntapi regu penangkapan.
Dialogue: 0,0:16:39.40,0:16:43.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rencana pembunuhan\NHojo Yasuie dan Saionji Kinmune
Dialogue: 0,0:16:43.32,0:16:47.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}gagal karena pengkhianatan\Nadik laki-laki Kinmune.
Dialogue: 0,0:16:47.87,0:16:51.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duh, gagal, ya!\NCuma bisa sampai sini!
Dialogue: 0,0:16:51.95,0:16:54.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kabur, Tuan Kinmune!
Dialogue: 0,0:16:56.50,0:16:58.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku takkan kabur!
Dialogue: 0,0:16:59.50,0:17:01.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bilang begitu! Ayo cepat!
Dialogue: 0,0:17:01.88,0:17:05.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Persiapan kabur dan sembunyi\Nsudah sempurna!
Dialogue: 0,0:17:05.30,0:17:06.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lepaskan!
Dialogue: 0,0:17:07.05,0:17:11.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keluarga terhormat Saionji tidak sudi\Ndibantu orang-orang barbar!
Dialogue: 0,0:17:17.02,0:17:19.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah kalah taruhan.
Dialogue: 0,0:17:19.44,0:17:23.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harga taruhan harus dibayar,\Napa pun status sosialnya.
Dialogue: 0,0:17:25.20,0:17:29.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah membantu\Nambisiku, Tuan Yasuie.
Dialogue: 0,0:17:29.70,0:17:34.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lanjutkan pertarunganmu\Nsebagai prajurit barbar.
Dialogue: 0,0:17:38.50,0:17:41.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat tinggal, Tuan Saionji.
Dialogue: 0,0:17:49.26,0:17:50.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Saionji.
Dialogue: 0,0:17:50.85,0:17:53.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya kau sudah siap.
Dialogue: 0,0:17:58.31,0:18:02.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nawa, Yuuki, Chikusa, Kusunoki...
Dialogue: 0,0:18:02.48,0:18:06.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para pendatang yang\Nasal-usulnya tidak jelas.
Dialogue: 0,0:18:07.28,0:18:11.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kejayaan kalian yang bergantung\Npada Kaisar takkan bertahan lama.
Dialogue: 0,0:18:19.83,0:18:25.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuil keemasan, ya.\NAku ingin melihatnya.
Dialogue: 0,0:18:28.80,0:18:32.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saionji Kinmune ditangkap dan dieksekusi.
Dialogue: 0,0:18:32.35,0:18:35.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wilayahnya disita oleh istana kekaisaran.
Dialogue: 0,0:18:35.77,0:18:39.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di kemudian hari, keluarga Ashikaga\Nmembeli bekas lokasi rencana ini,
Dialogue: 0,0:18:39.69,0:18:43.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan di sanalah dibangun Kinkaku,\NPaviliun Emas Kuil Rokuonji.
Dialogue: 0,0:18:55.70,0:18:56.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Muda!
Dialogue: 0,0:18:59.79,0:19:00.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Mima...
Dialogue: 0,0:19:01.96,0:19:03.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah mau pergi?
Dialogue: 0,0:19:04.09,0:19:06.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf tidak sempat pamitan.
Dialogue: 0,0:19:07.17,0:19:10.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktuku di Kyo bersamamu\Nsungguh menyenangkan.
Dialogue: 0,0:19:13.97,0:19:16.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, kita bisa bertemu lagi, 'kan?
Dialogue: 0,0:19:22.31,0:19:23.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suatu saat nanti.
Dialogue: 0,0:19:34.24,0:19:37.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kesal! Aku kesal! Aku kesal!
Dialogue: 0,0:19:38.20,0:19:41.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menanggung penghinaan\Ndemi penghinaan,
Dialogue: 0,0:19:41.58,0:19:43.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tidak berkutik.
Dialogue: 0,0:19:44.29,0:19:46.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin mengalahkan pria itu.
Dialogue: 0,0:19:46.75,0:19:48.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin jadi lebih kuat!
Dialogue: 0,0:19:55.85,0:19:59.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak ingin mendekati dia lagi.
Dialogue: 0,0:19:59.60,0:20:01.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini kesalahan saya.
Dialogue: 0,0:20:01.89,0:20:04.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak menyangka\NTakauji setangguh itu.
Dialogue: 0,0:20:05.98,0:20:08.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan merajuk, Fubuki!
Dialogue: 0,0:20:09.28,0:20:13.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Upaya pembunuhan terhadap Takauji\Nakan memperparah kekacauan di Kyo.
Dialogue: 0,0:20:13.57,0:20:17.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rencanamu sudah berhasil\Ndengan melaksanakan pembunuhan itu!
Dialogue: 0,0:20:19.41,0:20:22.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajar kita kalah di umur segini.
Dialogue: 0,0:20:22.46,0:20:25.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi bukan samurai namanya\Nkalau takut hanya karena kalah sekali!
Dialogue: 0,0:20:25.79,0:20:29.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pasti akan mempersembahkan\Nkepalanya pada Tuan Muda kelak!
Dialogue: 0,0:20:31.34,0:20:32.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kojirou...
Dialogue: 0,0:20:33.13,0:20:37.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bersyukur ada kau\Nsaat kalah perang.
Dialogue: 0,0:20:33.13,0:20:38.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Woi, ayo bangun! Ayo kemas barangnya!
Dialogue: 0,0:20:38.55,0:20:40.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oi!
Dialogue: 0,0:20:42.18,0:20:44.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami berhasil bertemu dengan Paman.
Dialogue: 0,0:20:44.31,0:20:47.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami pun mulai kabur menuju Shinano.
Dialogue: 0,0:20:50.40,0:20:53.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin main di Kyo selamanya.\NAsal tidak ada Takauji.
Dialogue: 0,0:20:54.53,0:20:57.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mima harum sekali, wangi\Nyang belum pernah kucium.
Dialogue: 0,0:20:57.95,0:21:00.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harusnya aku tanya dia pakai dupa apa.
Dialogue: 0,0:21:00.66,0:21:03.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkilauan, ada apa saja di sana...
Dialogue: 0,0:21:03.25,0:21:05.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyenangkan, ya, main ke Kyo.
Dialogue: 0,0:21:09.84,0:21:12.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesenangan, kekesalan.
Dialogue: 0,0:21:12.96,0:21:15.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belajar banyak hal\Nyang tak terhitung jumlahnya.
Dialogue: 0,0:21:16.30,0:21:19.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan lupa\Ndengan kejadian di ibu kota ini.
Dialogue: 0,0:21:32.44,0:21:33.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami pulang.
Dialogue: 0,0:21:41.20,0:21:45.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah mengalami banyak hal di Kyo,\Nwajah Anda menjadi seperti samurai
Dialogue: 0,0:21:45.16,0:21:47.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang penuh semangat juang.
Dialogue: 0,0:21:50.46,0:21:53.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasukan sudah siap selama Anda pergi.
Dialogue: 0,0:21:53.88,0:21:55.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari rapat strategi dulu.
Dialogue: 0,0:21:57.80,0:21:59.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktunya telah tiba.
Dialogue: 0,0:22:00.60,0:22:03.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo mulai perang merebut takhta.
Dialogue: 0,0:22:06.64,0:22:11.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bila ingin romantis♪
Dialogue: 0,0:22:11.52,0:22:14.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cintai aku lebih dari siapa pun♪
Dialogue: 0,0:22:20.11,0:22:23.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kamu orang yang baik♪
Dialogue: 0,0:22:23.49,0:22:27.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bakal baik ke gadis itu juga, 'kan?♪
Dialogue: 0,0:22:27.25,0:22:30.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa, tidak masalah♪
Dialogue: 0,0:22:30.58,0:22:34.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong bawakan\Nsemua barang beratnya, ya♪
Dialogue: 0,0:22:34.30,0:22:37.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu keren di depan orang-orang♪
Dialogue: 0,0:22:37.47,0:22:41.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kamu imut saat kita berduaan♪
Dialogue: 0,0:22:41.26,0:22:44.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setia seperti anjing♪
Dialogue: 0,0:22:44.60,0:22:50.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan menghilang seperti kucing, ya♪
Dialogue: 0,0:22:51.27,0:22:54.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terkadang aku sedih♪
Dialogue: 0,0:22:54.77,0:22:58.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi sentimental\Nsaat menatap bintang♪
Dialogue: 0,0:22:58.36,0:23:05.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini, kamu dengan siapa\Ndan sedang apa?♪
Dialogue: 0,0:23:05.49,0:23:09.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, jika kamu mau\Nmencintai dan dicintai♪
Dialogue: 0,0:23:09.46,0:23:12.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan selalu membuatmu berdebar♪
Dialogue: 0,0:23:12.92,0:23:16.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika tidak memilihku♪
Dialogue: 0,0:23:16.50,0:23:20.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menjatuhkanmu ke neraka♪
Dialogue: 0,0:23:20.17,0:23:23.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mendengarmu♪
Dialogue: 0,0:23:23.64,0:23:27.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau tahu lagi♪
Dialogue: 0,0:23:27.39,0:23:31.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bila ingin romantis♪
Dialogue: 0,0:23:31.02,0:23:33.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cintai aku lebih dari siapa pun♪
Dialogue: 0,0:23:38.61,0:23:39.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo!
