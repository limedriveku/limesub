Dialogue: 0,0:02:06.15,0:02:11.57,sign,,0000,0000,0000,,(Tuan Muda Jago Kabur)
Dialogue: 0,0:03:19.48,0:03:22.73,sign,,0000,0000,0000,,(Kediaman Saionji Kinmune)
Dialogue: 0,0:05:15.88,0:05:20.18,sign,,0000,0000,0000,,(Semangat)
Dialogue: 0,0:06:12.27,0:06:14.48,sign,,0000,0000,0000,,(Hari Pelaksanaan - Jam Monyet)
Dialogue: 0,0:06:56.98,0:06:59.24,sign,,0000,0000,0000,,(Markas Samurai - Jam Ayam Jantan)
Dialogue: 0,0:08:07.35,0:08:11.85,sign,,0000,0000,0000,,(Jam Anjing)
Dialogue: 0,0:16:30.18,0:16:32.02,sign,,0000,0000,0000,,(Vila Saionji - Jam Anjing)
Dialogue: 0,0:17:51.51,0:17:53.77,sign,,0000,0000,0000,,(Orang Kepercayaan Kaisar Go-Daigo\NYuuki Chikamitsu - Nawa Nagatoshi)
Dialogue: 0,0:18:45.23,0:18:47.19,sign,,0000,0000,0000,,(Jam Anjing Ketiga)
