Dialogue: 0,0:00:05.28,0:00:08.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teruslah hidup dan tunggu waktunya ♪
Dialogue: 0,0:00:08.24,0:00:13.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jinjing nyawamu dan tembus takdir ♪
Dialogue: 0,0:00:13.08,0:00:16.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hiduplah dalam malu\Ndan kejar mimpimu ♪
Dialogue: 0,0:00:16.29,0:00:21.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi orang-orang\Nyang percaya padamu ♪
Dialogue: 0,0:00:35.01,0:00:38.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagian besar takkan tercatat\Ndalam sejarah ♪
Dialogue: 0,0:00:38.27,0:00:41.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua hal konyol itu ♪
Dialogue: 0,0:00:41.77,0:00:45.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membelit dan terurai, lagi dan lagi ♪
Dialogue: 0,0:00:45.57,0:00:48.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tarik napas ♪
Dialogue: 0,0:00:48.61,0:00:52.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk apa hidup ini dipersembahkan?♪
Dialogue: 0,0:00:52.20,0:00:55.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takdir apa yang menanti?♪
Dialogue: 0,0:00:55.58,0:00:58.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bila rasa bak kutukan ♪
Dialogue: 0,0:00:58.45,0:01:02.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan bisa mengikatku ♪
Dialogue: 0,0:01:02.79,0:01:05.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teruslah hidup dan tunggu waktunya ♪
Dialogue: 0,0:01:05.59,0:01:10.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jinjing nyawamu dan lawan takdir ♪
Dialogue: 0,0:01:10.47,0:01:13.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hiduplah dalam malu\Ndan kejar mimpimu ♪
Dialogue: 0,0:01:13.64,0:01:17.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi orang-orang\Nyang percaya padamu ♪
Dialogue: 0,0:01:17.97,0:01:21.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Iblis, sini,\Nikuti suara tepuk tanganku ♪
Dialogue: 0,0:01:21.14,0:01:24.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}(Hei, Iblis, sini,\Nikuti suara tepuk tanganku)♪
Dialogue: 0,0:01:24.73,0:01:28.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hidup itu singkat,\Nmenyanyi dan menarilah ♪
Dialogue: 0,0:01:28.11,0:01:32.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bunga akan mekar\Nbagi yang jago kabur ♪
Dialogue: 0,0:01:35.91,0:01:37.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayahanda...
Dialogue: 0,0:01:38.20,0:01:39.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayako...
Dialogue: 0,0:01:39.25,0:01:40.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayahanda...
Dialogue: 0,0:01:42.45,0:01:45.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayahnya tewas dan kalah perang,
Dialogue: 0,0:01:46.17,0:01:48.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pedihnya tak terkira.
Dialogue: 0,0:01:55.34,0:01:57.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyedihkan!
Dialogue: 0,0:01:57.56,0:02:01.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Mochizuki yang keren telah mati!
Dialogue: 0,0:02:02.01,0:02:03.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Mochizuki?!
Dialogue: 0,0:02:03.85,0:02:05.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yo, Chojumaru!
Dialogue: 0,0:02:06.31,0:02:09.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Ayahanda!
Dialogue: 0,0:02:09.53,0:02:12.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kupikir sudah mati!
Dialogue: 0,0:02:14.24,0:02:16.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayahmu abadi, Ayako!
Dialogue: 0,0:02:16.28,0:02:18.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau hebat bisa datang kemari!
Dialogue: 0,0:02:18.07,0:02:20.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak menyangka baik-baik saja—
Dialogue: 0,0:02:21.00,0:02:22.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh!
Dialogue: 0,0:02:22.50,0:02:25.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayahanda, tulang rusukku bisa patah!
Dialogue: 0,0:02:25.16,0:02:26.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lemah sekali.
Dialogue: 0,0:02:27.00,0:02:30.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di keluarga Mochizuki, kita harus\Npatahkan rusuk supaya lebih kuat.
Dialogue: 0,0:02:30.13,0:02:33.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau juga harus patah! Sini!
Dialogue: 0,0:02:34.38,0:02:36.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bapak anak...
Dialogue: 0,0:02:36.09,0:02:39.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tu-Tunggu sebentar, Tuan Mochizuki.
Dialogue: 0,0:02:40.39,0:02:44.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana bisa Anda, Tuan Tokoiwa,\Nbahkan pasukan kalian tak terluka?
Dialogue: 0,0:02:44.68,0:02:48.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kalian meninggalkan\Nbenteng itu tanpa bertarung?
Dialogue: 0,0:02:48.39,0:02:50.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, benar!
Dialogue: 0,0:02:50.02,0:02:53.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak suka bertarung\Nsambil sembunyi-sembunyi!
Dialogue: 0,0:02:53.15,0:02:56.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berikan saja benteng itu untuk mereka!
Dialogue: 0,0:02:57.28,0:02:59.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serius?!
Dialogue: 0,0:03:00.20,0:03:02.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahaya kalau benteng ini tumbang!
Dialogue: 0,0:03:02.83,0:03:05.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika begini, pasukan Ichikawa\Nakan pergi ke selatan,
Dialogue: 0,0:03:06.00,0:03:09.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}medan perang tengah dan selatan\Nakan sangat dirugikan!
Dialogue: 0,0:03:11.25,0:03:12.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu!
Dialogue: 0,0:03:13.21,0:03:15.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami berterima kasih.
Dialogue: 0,0:03:17.76,0:03:20.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertahanan benteng kami lemah.
Dialogue: 0,0:03:20.30,0:03:22.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami tak bisa menampung\Nbanyak pasukan,
Dialogue: 0,0:03:22.39,0:03:24.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bertahan dua hari\Nmelawan Ichikawa itu mustahil.
Dialogue: 0,0:03:26.85,0:03:30.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika Tuan Mochizuki tidak membuka celah\Ndan membantu kami kabur,
Dialogue: 0,0:03:30.31,0:03:33.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak cuma benteng,\Nbahkan kami pun pasti musnah.
Dialogue: 0,0:03:34.48,0:03:36.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, Bocah.
Dialogue: 0,0:03:36.70,0:03:41.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami bakal lebih mengancam jika bersembunyi\Ndi pegunungan tanpa terluka.
Dialogue: 0,0:03:42.16,0:03:46.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami bisa menyerang Ichikawa kapan saja\Nsaat mereka menuju medan perang tengah.
Dialogue: 0,0:03:46.91,0:03:50.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terutama saat mereka menyeberangi sungai,\Nitu sasaran empuk!
Dialogue: 0,0:03:50.82,0:03:52.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu!
Dialogue: 0,0:03:52.17,0:03:54.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika mengepung mereka bersama\Npasukan Shinomiya di seberang sungai,
Dialogue: 0,0:03:54.59,0:03:56.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita bisa berikan pukulan telak!
Dialogue: 0,0:03:57.21,0:03:59.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rencana yang luar biasa!
Dialogue: 0,0:03:59.30,0:04:03.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti Anda sudah berkoordinasi\Ndengan Tuan Shinomiya, ya?
Dialogue: 0,0:04:06.14,0:04:08.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shinomiya?
Dialogue: 0,0:04:08.06,0:04:10.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata tidak koordinasi!
Dialogue: 0,0:04:10.96,0:04:14.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, Ichikawa bisa\Nmenyeberangi sungai, Ayahanda!
Dialogue: 0,0:04:14.69,0:04:17.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru Tuan Shinomiya\Nterkepung dari belakang!
Dialogue: 0,0:04:16.14,0:04:17.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Sudah, sudah.
Dialogue: 0,0:04:17.89,0:04:19.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, maaf, maaf!
Dialogue: 0,0:04:19.45,0:04:22.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami baru saja meninggalkan benteng,\Ntidak sempat memikirkan itu!
Dialogue: 0,0:04:22.49,0:04:24.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}- Ayahanda!\N- Maaf, maaf!
Dialogue: 0,0:04:23.11,0:04:25.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus cepat beri tahu Tuan Shinomiya.
Dialogue: 0,0:04:24.12,0:04:25.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}- Ayahanda!\N- Maaf!
Dialogue: 0,0:04:25.24,0:04:27.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}- Ayahanda!\N- Maaf, maaf!
Dialogue: 0,0:04:25.57,0:04:29.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, pasukan Ichikawa\Nakan bergerak besok pagi.
Dialogue: 0,0:04:27.04,0:04:29.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}- Ayahanda...\N- Maaf!
Dialogue: 0,0:04:30.87,0:04:34.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayako, kau lindungi ayahmu di sini.
Dialogue: 0,0:04:35.17,0:04:36.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:04:36.46,0:04:40.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai besok, aku serahkan penyampaian pesan\Nantara utara dan tengah padamu.
Dialogue: 0,0:04:41.34,0:04:44.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini kesempatanmu\Nbertarung bersama ayahmu.
Dialogue: 0,0:04:44.46,0:04:46.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berbaktilah kepadanya.
Dialogue: 0,0:04:49.81,0:04:51.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:04:52.18,0:04:54.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia cungkring dan tak bisa diandalkan,
Dialogue: 0,0:04:54.90,0:04:59.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi tuanmu lumayan\Nberpotensi jadi pemimpin.
Dialogue: 0,0:05:00.61,0:05:04.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhir-akhir ini, loyalitasku melonjak tinggi,\Naku jadi bingung.
Dialogue: 0,0:05:17.59,0:05:19.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, Tuan Shinomiya...
Dialogue: 0,0:05:19.95,0:05:23.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa tolong tempatkan pasukan\Ndi jalan keluar pegunungan utara?
Dialogue: 0,0:05:23.63,0:05:25.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tolong.\N- Baik!
Dialogue: 0,0:05:25.01,0:05:26.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasukan kecil sudah cukup.
Dialogue: 0,0:05:26.60,0:05:28.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, Utusan.
Dialogue: 0,0:05:28.72,0:05:31.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, ada banyak\Nyang ingin kubicarakan.
Dialogue: 0,0:05:31.10,0:05:33.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian istirahat yang nyenyak\Ndi perkemahan Hoshina sana.
Dialogue: 0,0:05:36.10,0:05:39.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia makin tangguh lagi dalam setahun.
Dialogue: 0,0:05:39.05,0:05:41.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak sabar melihat dia di masa depan.
Dialogue: 0,0:05:52.20,0:05:55.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah enggak kuat makan lagi...
Dialogue: 0,0:06:08.80,0:06:10.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maju!
Dialogue: 0,0:06:20.15,0:06:22.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mochizuki tak pernah berubah.
Dialogue: 0,0:06:22.64,0:06:26.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bergerak sembrono, tapi entah\Nbagaimana berakhir ke arah yang baik.
Dialogue: 0,0:06:27.40,0:06:31.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini rapat perang menentukan langkah\Nselanjutnya dengan melihat gerakan di utara.
Dialogue: 0,0:06:32.28,0:06:36.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Prioritas kita adalah mengalahkan Gubernur\Ndi medan pertempuran tengah.
Dialogue: 0,0:06:36.83,0:06:39.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bisa diselesaikan secepat mungkin...
Dialogue: 0,0:06:40.38,0:06:44.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Situasi pertempuran melawan pasukan\NGubernur masih berimbang, kondisinya buntu.
Dialogue: 0,0:06:45.71,0:06:48.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Adakah cara memecahkan kebuntuan ini?
Dialogue: 0,0:06:52.47,0:06:53.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Nezu.
Dialogue: 0,0:06:54.89,0:06:58.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bolehkah saya memberikan saran\Nsebagai seorang utusan?
Dialogue: 0,0:07:02.48,0:07:06.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fubuki, tolong katakan hal janggal\Nyang kamu bahas kemarin.
Dialogue: 0,0:07:06.57,0:07:07.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh...
Dialogue: 0,0:07:09.82,0:07:10.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemarin,
Dialogue: 0,0:07:10.87,0:07:13.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}saya pergi melihat benteng selatan.
Dialogue: 0,0:07:13.66,0:07:16.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya rasa kekuatan pasukan mereka\Nagak berlebihan.
Dialogue: 0,0:07:16.75,0:07:18.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berlebihan?
Dialogue: 0,0:07:18.37,0:07:21.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Struktur benteng ini cukup kokoh.
Dialogue: 0,0:07:21.03,0:07:24.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kita dapat memprediksi lebih dulu\Ndari arah mana serangan akan datang,
Dialogue: 0,0:07:24.38,0:07:27.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}benteng itu bisa dipertahankan dengan\Nkekuatan militer Tuan Unno dan pasukan kecil.
Dialogue: 0,0:07:28.59,0:07:32.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cara ini butuh banyak pengintai,
Dialogue: 0,0:07:32.55,0:07:36.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi saya pikir\N80% pasukan kita sudah cukup.
Dialogue: 0,0:07:36.52,0:07:41.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu, dua, tiga, empat, lima...
Dialogue: 0,0:07:41.77,0:07:43.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu!
Dialogue: 0,0:07:43.30,0:07:46.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika sekitar 50 pasukan yang menganggur\Ndipindahkan ke tengah,
Dialogue: 0,0:07:46.28,0:07:48.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa jadi kekuatan tempur yang cukup.
Dialogue: 0,0:07:51.99,0:07:53.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fubuki.
Dialogue: 0,0:07:53.57,0:07:57.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau menggunakan elang\Nmilik Tuan Nezu untuk mengawasi benteng?
Dialogue: 0,0:07:59.46,0:08:00.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga!
Dialogue: 0,0:08:00.67,0:08:03.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan begitu,\Nkita tak butuh pasukan pengintai.
Dialogue: 0,0:08:03.33,0:08:06.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika meninggalkan 100 pasukan di selatan,\Nkita bisa bertahan 10 hari!
Dialogue: 0,0:08:07.88,0:08:09.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika pertarungan singkat,
Dialogue: 0,0:08:09.62,0:08:12.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita hampir tidak butuh\Npasukan cadangan di benteng.
Dialogue: 0,0:08:12.76,0:08:14.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi...
Dialogue: 0,0:08:14.08,0:08:16.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai ganti Tuan Nezu pergi ke selatan,
Dialogue: 0,0:08:16.93,0:08:19.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita tarik 200 pasukan\Ndari medan perang selatan
Dialogue: 0,0:08:19.85,0:08:21.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan memusatkannya di tengah.
Dialogue: 0,0:08:23.02,0:08:25.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya rasa itu bisa jadi pilihan.
Dialogue: 0,0:08:29.53,0:08:31.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shizuku.
Dialogue: 0,0:08:32.70,0:08:34.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ide bagus!
Dialogue: 0,0:08:34.40,0:08:39.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkat Tuan Nezu, kita hampir sepenuhnya\Ntahu titik yang perlu diwaspadai!
Dialogue: 0,0:08:40.00,0:08:43.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bisa menghadapi pertempuran\Nyang akan datang sendirian!
Dialogue: 0,0:08:44.25,0:08:46.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu masuk akal.
Dialogue: 0,0:08:46.33,0:08:49.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi agak menyebalkan juga\Ndisetir siasat anak kecil.
Dialogue: 0,0:08:50.51,0:08:51.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shizuku.
Dialogue: 0,0:08:51.91,0:08:55.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini adalah saranmu, seseorang\Nyang sangat dipercaya Tuan Yorishige.
Dialogue: 0,0:08:56.47,0:08:57.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah!
Dialogue: 0,0:08:58.64,0:09:01.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita jepit musuh di utara\Nuntuk menghentikan mereka!
Dialogue: 0,0:09:01.64,0:09:05.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di medan selatan, tukar aku\Ndengan dua ratus prajurit!
Dialogue: 0,0:09:05.65,0:09:09.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelompok Hoshina akan\Nmengakhiri pertempuran ini di tengah!
Dialogue: 0,0:09:09.40,0:09:11.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Secara perhitungan, lebih dari 500.
Dialogue: 0,0:09:11.32,0:09:12.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chojumaru.
Dialogue: 0,0:09:12.60,0:09:15.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Utusan pasti tahu jalan pintas.
Dialogue: 0,0:09:15.15,0:09:17.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat antar kami ke selatan.
Dialogue: 0,0:09:17.16,0:09:18.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:09:19.99,0:09:24.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shizuku mewakili Tuan Yorishige.
Dialogue: 0,0:09:24.15,0:09:26.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ia punya pengaruh\Ndi kalangan pejabat senior.
Dialogue: 0,0:09:30.09,0:09:31.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma dia yang bisa melakukannya.
Dialogue: 0,0:09:32.17,0:09:36.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ide begitu berani untuk\Nmemindahkan seorang jenderal...
Dialogue: 0,0:09:52.40,0:09:56.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}200 pasukan sudah kukirim diam-diam\Nke medan tengah tadi malam.
Dialogue: 0,0:09:56.61,0:10:00.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dan Tuan Nezu juga\Nsudah siap melindungi benteng.
Dialogue: 0,0:10:00.87,0:10:04.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah melihat medan perang lewat elang,\Nkita tak bisa bertahan lama.
Dialogue: 0,0:10:05.04,0:10:06.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampaikan ke Hoshina,
Dialogue: 0,0:10:06.63,0:10:09.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pertempuran penentuan di tengah\Nharus selesai dalam tiga hari.
Dialogue: 0,0:10:09.73,0:10:10.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:10:13.22,0:10:16.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga kalian beruntung!
Dialogue: 0,0:10:20.89,0:10:24.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan muda yang menarik, 'kan,\NTuan Nezu?
Dialogue: 0,0:10:24.42,0:10:25.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:10:25.60,0:10:29.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa-bisanya dia bekerja keliling\Ndengan bahagia begitu.
Dialogue: 0,0:10:30.11,0:10:32.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, meski kinerjanya bagus,
Dialogue: 0,0:10:32.61,0:10:35.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apakah kita harus melanjutkan\Nrencana yang disusun anak-anak?
Dialogue: 0,0:10:37.99,0:10:39.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudmu?
Dialogue: 0,0:10:40.45,0:10:44.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasukan Gubernur cuma menang jumlah,\Ntapi Sadamune adalah veteran ulung.
Dialogue: 0,0:10:45.50,0:10:47.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama seperti kita...
Dialogue: 0,0:10:47.21,0:10:50.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pasti juga punya rencana.
Dialogue: 0,0:10:51.63,0:10:53.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengin pulang.
Dialogue: 0,0:10:53.26,0:10:56.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita sudah bepergian sejauh apa\Ndalam beberapa hari ini?
Dialogue: 0,0:10:56.67,0:10:59.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong ditahan dan temani aku terus.
Dialogue: 0,0:10:59.47,0:11:02.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada saatnya kami butuh bantuanmu.
Dialogue: 0,0:11:02.50,0:11:05.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia benar.\NKita bekerja terlalu keras.
Dialogue: 0,0:11:05.72,0:11:09.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Muda agak memaksakan diri kali ini.
Dialogue: 0,0:11:14.53,0:11:15.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Unno.
Dialogue: 0,0:11:15.97,0:11:19.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada pasukan utama musuh yang berjumlah\Nsekitar 100 orang di utara benteng, 'kan?
Dialogue: 0,0:11:19.69,0:11:22.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, belum bergerak sejak perang dimulai.
Dialogue: 0,0:11:23.20,0:11:24.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada!
Dialogue: 0,0:11:24.50,0:11:26.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada tanda-tanda\Npasukan utama musuh!
Dialogue: 0,0:11:37.59,0:11:39.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka...
Dialogue: 0,0:11:39.30,0:11:40.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak kapan?!
Dialogue: 0,0:11:42.81,0:11:47.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kalian utusan yang berlarian\Nke sana-kemari!
Dialogue: 0,0:11:48.18,0:11:52.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah bilang takkan segan-segan\Ndi medan perang, 'kan?
Dialogue: 0,0:11:53.15,0:11:56.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menangkapmu,\Nmenginterogasimu,
Dialogue: 0,0:11:56.11,0:12:00.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}membuatmu mengakui perintah Suwa\Ndan keterlibatannya dalam perang.
Dialogue: 0,0:12:00.87,0:12:03.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan hanya untuk memenangkan perang ini.
Dialogue: 0,0:12:03.99,0:12:09.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu akan memberi kita dalih sah\Nuntuk menghancurkan Yorishige!
Dialogue: 0,0:12:09.39,0:12:12.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seratus orang!
Dialogue: 0,0:12:12.04,0:12:15.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maju!
Dialogue: 0,0:12:17.63,0:12:20.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan beri ampun\Nmeski mereka anak-anak!
Dialogue: 0,0:12:20.51,0:12:24.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua orang yang pegang pedang\Ndan berdiri di medan perang itu setara!
Dialogue: 0,0:12:24.76,0:12:27.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian boleh memotong\Nsatu tangan atau kakinya!
Dialogue: 0,0:12:27.35,0:12:30.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang penting tangkap mereka\Ndalam kondisi bisa bicara!
Dialogue: 0,0:12:31.35,0:12:34.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bos, Kojirou! Turun dari kuda!
Dialogue: 0,0:12:39.19,0:12:41.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kepungan di sisi kanan belum rapi.
Dialogue: 0,0:12:41.70,0:12:43.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo lari ke atas bukit!
Dialogue: 0,0:12:43.41,0:12:44.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:12:49.58,0:12:51.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Aduh!\N- Apa ini?
Dialogue: 0,0:12:51.96,0:12:53.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keparat!
Dialogue: 0,0:12:55.54,0:12:58.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tabir asap si rubah, ya?
Dialogue: 0,0:12:58.63,0:13:03.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah pernah lihat\Njarak asapnya terbatas.
Dialogue: 0,0:13:03.43,0:13:07.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempat mereka muncul dari tepi asap.
Dialogue: 0,0:13:07.60,0:13:08.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sana!
Dialogue: 0,0:13:13.02,0:13:17.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tertangkap!
Dialogue: 0,0:13:18.49,0:13:20.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ga-Gawat!
Dialogue: 0,0:13:20.90,0:13:22.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tertangkap!
Dialogue: 0,0:13:24.66,0:13:26.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah berakhir!
Dialogue: 0,0:13:32.96,0:13:34.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si-Siapa?!
Dialogue: 0,0:13:35.00,0:13:39.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bila ditanya aku siapa,\Nmaka aku harus menjawabnya.
Dialogue: 0,0:13:39.24,0:13:42.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jaring langit tampak renggang,\Ntapi tak ada yang bisa lolos!
Dialogue: 0,0:13:42.26,0:13:45.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akulah dewa pelindung penjuru Shinano\Nyang bisa melihat segalanya!
Dialogue: 0,0:13:45.97,0:13:48.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shinano Bertopeng!
Dialogue: 0,0:13:54.10,0:13:56.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Telah tiba!
Dialogue: 0,0:13:58.73,0:14:00.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yorishige.
Dialogue: 0,0:14:00.40,0:14:01.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yorishige.
Dialogue: 0,0:14:02.11,0:14:03.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Izin menjelaskan!
Dialogue: 0,0:14:03.45,0:14:06.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shinano Bertopeng adalah inkarnasi dewa\Nyang muncul saat krisis di Shinano.
Dialogue: 0,0:14:06.99,0:14:09.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terkadang keras, terkadang baik.
Dialogue: 0,0:14:09.04,0:14:12.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sosok mulia yang menyelimuti seluruh\NShinano dengan kasih yang agung.
Dialogue: 0,0:14:12.91,0:14:15.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pahlawan ajaib yang dikagumi orang-orang!
Dialogue: 0,0:14:15.21,0:14:17.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Yang ada di sampingnya adalah
Dialogue: 0,0:14:15.71,0:14:19.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama sekali bukan orang mencurigakan!
Dialogue: 0,0:14:17.25,0:14:19.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}komentator ulung, Tuan Moritaka!
Dialogue: 0,0:14:21.13,0:14:24.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dilihat bagaimana pun, itu Suwa Yorishige!
Dialogue: 0,0:14:24.13,0:14:26.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malah bikin makin mencurigakan!
Dialogue: 0,0:14:26.89,0:14:28.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu-Bukan.
Dialogue: 0,0:14:28.85,0:14:31.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Suwa Bertopeng.
Dialogue: 0,0:14:31.59,0:14:33.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau baru saja bilang Suwa!
Dialogue: 0,0:14:33.98,0:14:35.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar nggak konsisten!
Dialogue: 0,0:14:35.56,0:14:39.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau curiga,\Nkau harus pastikan sendiri.
Dialogue: 0,0:14:39.60,0:14:42.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu-satunya cara mendapatkan\Nbukti di perang ini
Dialogue: 0,0:14:42.07,0:14:44.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}cuma dengan menangkap di TKP.
Dialogue: 0,0:14:45.11,0:14:48.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau coba, Tuan Sadamune?
Dialogue: 0,0:14:54.45,0:14:55.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cih.
Dialogue: 0,0:14:55.62,0:14:56.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo mundur!
Dialogue: 0,0:14:56.63,0:14:57.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Sadamune!
Dialogue: 0,0:14:57.88,0:15:00.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jumlahnya seimbang,\Ntapi kita ada di posisi lebih rendah.
Dialogue: 0,0:15:00.96,0:15:02.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita rugi!
Dialogue: 0,0:15:02.55,0:15:05.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mundur! Mundur!
Dialogue: 0,0:15:07.13,0:15:08.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka menyerah?
Dialogue: 0,0:15:08.80,0:15:10.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semudah itu?
Dialogue: 0,0:15:10.84,0:15:13.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesuai dugaan, mereka pergi ke timur.
Dialogue: 0,0:15:13.62,0:15:15.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sadamune memang cerdik.
Dialogue: 0,0:15:15.56,0:15:19.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengerahkan 100 pasukan adalah strategi\Nmembunuh dua burung dengan satu batu.
Dialogue: 0,0:15:21.44,0:15:23.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}100 pasukan yang dipimpin Sadamune...
Dialogue: 0,0:15:23.53,0:15:26.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tujuan utamanya adalah\Nmengirim bantuan ke medan tengah.
Dialogue: 0,0:15:27.07,0:15:29.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melihat medan perang selatan\Nmengalami kebuntuan,
Dialogue: 0,0:15:29.70,0:15:33.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia memindahkan sementara 100 pasukan\Nutama yang tak digunakan ke tengah
Dialogue: 0,0:15:33.12,0:15:35.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan memakai strategi\Nyang sama dengan kita.
Dialogue: 0,0:15:36.33,0:15:38.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, tujuan keduanya...
Dialogue: 0,0:15:38.40,0:15:41.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu adalah Anda.
Dialogue: 0,0:15:42.29,0:15:46.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelayan Kuil Suwa yang menjalankan misi\Nsambil berpindah-pindah di medan perang.
Dialogue: 0,0:15:46.46,0:15:49.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika dia menangkap dan membuat\NAnda membongkar rahasia,
Dialogue: 0,0:15:49.14,0:15:52.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}itu akan menjadi alasan\Nyang sempurna untuk menyerangku.
Dialogue: 0,0:15:52.84,0:15:56.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sambil mengirim 100 pasukan itu\Nke medan tengah,
Dialogue: 0,0:15:56.64,0:15:59.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ia menggunakannya sebagai jaring\Nuntuk menangkap Anda.
Dialogue: 0,0:16:00.14,0:16:04.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya melihat masa depan itu tiba-tiba,\Njadi saya langsung bergegas menyusul...
Dialogue: 0,0:16:04.73,0:16:06.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dilanjutkan lagi bakal berbahaya.
Dialogue: 0,0:16:07.15,0:16:09.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah cukup, Tuan Tokiyuki.
Dialogue: 0,0:16:09.74,0:16:12.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita serahkan tugas membawa pesan\Nke orang lain, lalu kita pulang.
Dialogue: 0,0:16:13.20,0:16:14.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pulang?
Dialogue: 0,0:16:14.61,0:16:16.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makin jauh dari Suwa,
Dialogue: 0,0:16:16.91,0:16:19.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan makin banyak orang\Nyang terlibat dalam perang,
Dialogue: 0,0:16:19.92,0:16:22.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}makin berkurang ketepatan ramalan saya.
Dialogue: 0,0:16:23.88,0:16:27.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena Sadamune sudah\Nmenyadari nilai taktis Anda,
Dialogue: 0,0:16:27.96,0:16:30.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}melanjutkan membawa pesan\Nterlalu berbahaya.
Dialogue: 0,0:16:31.55,0:16:32.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau.
Dialogue: 0,0:16:33.39,0:16:35.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga setuju kita harus pulang.
Dialogue: 0,0:16:35.81,0:16:38.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bekerja terlalu keras kali ini,\NTuan Muda.
Dialogue: 0,0:16:38.64,0:16:39.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:16:39.73,0:16:43.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi tidak sadar penyergapan musuh\Ngara-gara kelelahan.
Dialogue: 0,0:16:43.52,0:16:44.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mau.
Dialogue: 0,0:16:45.06,0:16:47.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau pulang sekarang.
Dialogue: 0,0:16:49.73,0:16:51.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Tokiyuki.
Dialogue: 0,0:16:51.19,0:16:54.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejumlah kecil bala bantuan\Nyang dipimpin tiga jenderal,
Dialogue: 0,0:16:54.12,0:16:56.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa Anda tahu seperti apa mereka?
Dialogue: 0,0:16:57.45,0:17:01.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka percaya suatu hari nanti, Suwa Myojin\Nakan bangkit sebagai wakil rakyat Shinano
Dialogue: 0,0:17:01.96,0:17:05.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang hidup dalam penderitaan berat.
Dialogue: 0,0:17:05.29,0:17:09.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka adalah orang-orang\Nyang siap bertaruh nyawa di perang ini.
Dialogue: 0,0:17:09.88,0:17:13.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, Anda tak perlu berkorban juga.
Dialogue: 0,0:17:13.84,0:17:17.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tubuh Anda penting untuk\Nmemulihkan kembali keshogunan.
Dialogue: 0,0:17:17.29,0:17:20.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada alasan untuk\Nmengambil risiko sekarang.
Dialogue: 0,0:17:20.09,0:17:20.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biarkan mereka—
Dialogue: 0,0:17:20.84,0:17:22.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak mengerti?!
Dialogue: 0,0:17:24.27,0:17:27.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin berguna untukmu!
Dialogue: 0,0:17:28.15,0:17:32.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau juga memikul takdir yang besar,
Dialogue: 0,0:17:32.32,0:17:35.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku cuma bisa menerima\Ndan tak membalas apa-apa!
Dialogue: 0,0:17:37.03,0:17:41.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan mempersatukan banyak rekan\Nyang memercayaimu,
Dialogue: 0,0:17:41.29,0:17:45.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}rasanya aku berhasil balas budi padamu
Dialogue: 0,0:17:45.15,0:17:46.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan itu membuatku bahagia.
Dialogue: 0,0:17:48.88,0:17:52.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu,\Napa aku tetap harus pulang?
Dialogue: 0,0:17:57.09,0:17:58.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru aku.
Dialogue: 0,0:17:59.39,0:18:00.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Yorishige?
Dialogue: 0,0:18:00.93,0:18:02.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah!
Dialogue: 0,0:18:02.52,0:18:05.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Anda sengotot itu,\Nmisinya berlanjut!
Dialogue: 0,0:18:05.97,0:18:08.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetapi tidak boleh\Nbertarung sama sekali!
Dialogue: 0,0:18:08.32,0:18:12.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anda harus fokus membawakan pesan\Ndan mengamati perang dari belakang!
Dialogue: 0,0:18:13.03,0:18:14.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:18:14.24,0:18:15.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar.
Dialogue: 0,0:18:16.53,0:18:20.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bawalah 100 prajurit elite Kuil Suwa ini\Ndan pergilah ke medan perang tengah.
Dialogue: 0,0:18:21.33,0:18:23.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan begini, situasi perang\Nakan sepenuhnya seimbang.
Dialogue: 0,0:18:23.87,0:18:28.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bila merasakan bahaya sedikit saja,\Njangan lupa langsung kabur!
Dialogue: 0,0:18:31.59,0:18:34.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak, Tuan Yorishige!
Dialogue: 0,0:18:34.42,0:18:35.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pergi!
Dialogue: 0,0:18:40.43,0:18:42.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beliau sudah pergi.
Dialogue: 0,0:18:54.90,0:18:57.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia menunjukkan perkembangannya
Dialogue: 0,0:18:58.11,0:19:00.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bahkan memberikan kata-kata\Nyang begitu manis.
Dialogue: 0,0:19:01.20,0:19:03.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru aku
Dialogue: 0,0:19:03.95,0:19:05.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang menerima terlalu banyak.
Dialogue: 0,0:19:21.56,0:19:24.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maju!
Dialogue: 0,0:19:41.61,0:19:43.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ichikawa di utara bagaimana?
Dialogue: 0,0:19:43.54,0:19:46.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa ditahan sepanjang hari ini!
Dialogue: 0,0:19:46.62,0:19:50.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku om misterius!
Dialogue: 0,0:19:46.91,0:19:51.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu karena pasukan Mochizuki diam-diam\Nmenyerang Ichikawa dari belakang!
Dialogue: 0,0:19:50.42,0:19:53.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Apa-apaan dia?!
Dialogue: 0,0:19:51.21,0:19:53.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah? Senang mendengarnya.
Dialogue: 0,0:19:53.46,0:19:57.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku akan berperang\Nbersama ayahku dulu!
Dialogue: 0,0:19:57.84,0:20:02.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sip! Sekarang kita bisa fokus\Ndi medan perang tengah!
Dialogue: 0,0:20:02.76,0:20:06.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurut laporan Utusan,\NHoshina juga unggul.
Dialogue: 0,0:20:06.52,0:20:09.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita akhiri hari ini!
Dialogue: 0,0:20:11.10,0:20:14.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, mereka menekan musuh.
Dialogue: 0,0:20:14.03,0:20:15.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:20:15.15,0:20:19.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah melihat-lihat, pasukan Hoshina\Ndan Shinomiya penuh semangat.
Dialogue: 0,0:20:20.53,0:20:22.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam pertarungan kacau ini,
Dialogue: 0,0:20:22.41,0:20:25.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}100 pasukan Sadamune pun\Ntak bisa mengubah arah perang.
Dialogue: 0,0:20:25.61,0:20:27.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bisa menang di perang ini.
Dialogue: 0,0:20:52.10,0:20:54.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?!
Dialogue: 0,0:20:59.03,0:21:00.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?!
Dialogue: 0,0:21:01.15,0:21:03.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu apa?
Dialogue: 0,0:21:03.57,0:21:04.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mikoshi?
Dialogue: 0,0:21:10.04,0:21:13.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ratakan semuanya!
Dialogue: 0,0:21:13.92,0:21:16.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bandit-bandit!
Dialogue: 0,0:21:39.98,0:21:43.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Hoshina,\Nkita mundur dulu sekarang...
Dialogue: 0,0:21:46.49,0:21:49.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bedebah!
Dialogue: 0,0:21:50.29,0:21:55.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Petarung tangguh yang direkrut dengan uang\Nmenjadi pemikul tandu sekaligus pengawal.
Dialogue: 0,0:21:56.12,0:22:01.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menembak mereka\Ndari dalam ruangan dengan aman.
Dialogue: 0,0:22:01.97,0:22:07.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inilah Mikoshi Perang dari gagasanku!
Dialogue: 0,0:22:07.35,0:22:10.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Huryah!
Dialogue: 0,0:22:11.73,0:22:16.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bila ingin romantis ♪
Dialogue: 0,0:22:16.61,0:22:19.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cintai aku lebih dari siapa pun ♪
Dialogue: 0,0:22:25.20,0:22:28.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kamu orang yang baik ♪
Dialogue: 0,0:22:28.58,0:22:32.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bakal baik ke gadis itu juga, 'kan?♪
Dialogue: 0,0:22:32.33,0:22:35.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa, tidak masalah ♪
Dialogue: 0,0:22:35.67,0:22:39.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong bawakan\Nsemua barang beratnya, ya ♪
Dialogue: 0,0:22:39.38,0:22:42.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu keren di depan orang-orang ♪
Dialogue: 0,0:22:42.55,0:22:46.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kamu imut saat kita berduaan ♪
Dialogue: 0,0:22:46.34,0:22:49.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setia seperti anjing ♪
Dialogue: 0,0:22:49.68,0:22:55.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan menghilang seperti kucing, ya ♪
Dialogue: 0,0:22:56.35,0:22:59.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terkadang aku sedih ♪
Dialogue: 0,0:22:59.86,0:23:03.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi sentimental\Nsaat menatap bintang ♪
Dialogue: 0,0:23:03.44,0:23:10.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini, kamu dengan siapa\Ndan sedang apa?♪
Dialogue: 0,0:23:10.58,0:23:14.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, jika kamu mau\Nmencintai dan dicintai ♪
Dialogue: 0,0:23:14.54,0:23:17.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan selalu membuatmu berdebar ♪
Dialogue: 0,0:23:18.00,0:23:21.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika tidak memilihku ♪
Dialogue: 0,0:23:21.59,0:23:25.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menjatuhkanmu ke neraka ♪
Dialogue: 0,0:23:25.26,0:23:28.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mendengarmu ♪
Dialogue: 0,0:23:28.72,0:23:32.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau tahu lagi ♪
Dialogue: 0,0:23:32.47,0:23:36.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bila ingin romantis ♪
Dialogue: 0,0:23:36.10,0:23:39.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cintai aku lebih dari siapa pun ♪
Dialogue: 0,0:23:43.53,0:23:45.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo!
