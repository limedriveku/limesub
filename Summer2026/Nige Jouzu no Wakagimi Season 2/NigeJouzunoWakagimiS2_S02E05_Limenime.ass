Dialogue: 0,0:00:33.51,0:00:47.78,sign,,0000,0000,0000,,{\an8}(Mengamuk! Mikoshi Perang)
Dialogue: 0,0:04:21.12,0:04:26.54,sign,,0000,0000,0000,,{\an8}(Tuan Muda Jago Kabur)
Dialogue: 0,0:09:01.90,0:09:07.78,sign,,0000,0000,0000,,{\an8}(Markas Pasukan Shinomiya)
Dialogue: 0,0:11:11.65,0:11:22.54,sign,,0000,0000,0000,,{\an8}(Selatan - Tengah - Utara)
Dialogue: 0,0:16:59.37,0:17:04.33,sign,,0000,0000,0000,,{\an8}(Markas Pasukan Hoshina)
Dialogue: 0,0:17:27.15,0:17:29.69,sign,,0000,0000,0000,,{\an8}(Mayoritas Vegan)
Dialogue: 0,0:19:52.84,0:19:55.59,sign,,0000,0000,0000,,{\an8}(Kuil Suwa)
Dialogue: 0,0:23:25.17,0:23:28.63,sign,,0000,0000,0000,,L-O-V-E
Dialogue: 0,0:23:28.64,0:23:32.38,sign,,0000,0000,0000,,L-O-V-E
Dialogue: 0,0:23:37.85,0:23:39.94,sign,,0000,0000,0000,,{\an8}(Kazama Genba - Yuuki Aoi)
Dialogue: 0,0:23:43.94,0:23:44.94,sign,,0000,0000,0000,,{\an8}(Episode 18 [Tahun 1335]\NAnak Laki-laki yang Menjadi Dewa)
Dialogue: 0,0:00:05.73,0:00:11.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Petarung tangguh yang direkrut dengan uang\Nmenjadi pemikul tandu sekaligus pengawal.
Dialogue: 0,0:00:11.57,0:00:17.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menembak mereka\Ndari dalam ruangan dengan aman.
Dialogue: 0,0:00:17.16,0:00:22.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inilah Mikoshi Perang dari gagasanku!
Dialogue: 0,0:00:23.33,0:00:24.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu cuma gertakan!
Dialogue: 0,0:00:24.84,0:00:27.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benda sebesar itu gampang\Njadi sasaran, habislah dia!
Dialogue: 0,0:00:27.72,0:00:29.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, mungkin tidak juga.
Dialogue: 0,0:00:30.59,0:00:33.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau semencolok itu, dia pasti\Nakan diincar, suka atau tidak.
Dialogue: 0,0:00:34.14,0:00:38.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penandu mengenakan zirah berat membentuk\Nformasi rapat diperkuat dengan tongkat.
Dialogue: 0,0:00:39.31,0:00:42.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam pertarungan jarak dekat pun\Ntak mudah dikalahkan.
Dialogue: 0,0:00:42.85,0:00:47.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekalipun salah satu penandu jatuh,\Nprajurit lain akan segera mengambil alih.
Dialogue: 0,0:00:48.86,0:00:50.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalaupun kita bisa mencapai Mikoshi itu...
Dialogue: 0,0:01:00.45,0:01:01.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat!
Dialogue: 0,0:01:01.73,0:01:03.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka makin merapat...
Dialogue: 0,0:01:04.17,0:01:07.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau merapat begitu, pasukan Sadamune\Nbisa masuk dari belakang.
Dialogue: 0,0:01:08.55,0:01:10.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bisa terpecah dan musnah.
Dialogue: 0,0:01:11.46,0:01:13.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fubuki, jangan gegabah!
Dialogue: 0,0:01:13.58,0:01:14.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan khawatir!
Dialogue: 0,0:01:14.93,0:01:17.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya ada pesan!\NCuma menyampaikan informasi!
Dialogue: 0,0:01:18.64,0:01:21.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inilah mengerikannya bangsawan istana\Nyang tak paham perang.
Dialogue: 0,0:01:21.19,0:01:25.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taktik perang di luar pemahaman\Nsamurai bisa sangat berbahaya!
Dialogue: 0,0:01:27.36,0:01:32.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Injak sampai mati!\NTebas sampai mati!
Dialogue: 0,0:01:32.15,0:01:35.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga akan menembak\Nsampai mereka mati!
Dialogue: 0,0:01:35.41,0:01:38.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya demi duniaku...
Dialogue: 0,0:01:40.74,0:01:42.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan.
Dialogue: 0,0:01:43.00,0:01:46.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi dunia Yang Mulia Kaisar!
Dialogue: 0,0:01:46.21,0:01:49.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya tidak mampu!
Dialogue: 0,0:01:49.17,0:01:52.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para binatang buas yang tak malu-malu\Nmencoba membunuh gubernur,
Dialogue: 0,0:01:52.55,0:01:54.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mereka tidak bisa diperintah!
Dialogue: 0,0:01:55.30,0:01:57.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan jika itu perintahku?
Dialogue: 0,0:01:58.75,0:02:02.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keluarga Kiyohara kami awalnya\Nhanyalah bangsawan rendahan.
Dialogue: 0,0:02:02.31,0:02:06.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keluarga kami tidak punya garis keturunan\Nmaupun kapasitas menjadi gubernur!
Dialogue: 0,0:02:06.61,0:02:11.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, mengapa Yang Mulia\Nmenunjuk saya menjadi gubernur?
Dialogue: 0,0:02:12.94,0:02:14.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kiyohara.
Dialogue: 0,0:02:14.49,0:02:18.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang paling kusukai\Nbukanlah garis keturunan.
Dialogue: 0,0:02:18.66,0:02:20.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melainkan semangat!
Dialogue: 0,0:02:20.16,0:02:24.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang dengan semangat\Nuntuk mengubah zaman!
Dialogue: 0,0:02:24.54,0:02:28.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pasti sudah memikirkannya\Nsejak zaman Kamakura.
Dialogue: 0,0:02:29.00,0:02:31.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para bangsawan malas\Nyang menjilat Keshogunan
Dialogue: 0,0:02:31.59,0:02:35.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan hanya memikirkan\Nkepentingan mereka sendiri.
Dialogue: 0,0:02:35.38,0:02:39.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pasti bertanya mengapa mereka\Ndengan santainya menduduki jabatan itu.
Dialogue: 0,0:02:39.47,0:02:44.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pasti berpikir bisa\Nmengubah dunia jadi lebih baik.
Dialogue: 0,0:02:44.85,0:02:49.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gairah, ambisi, tekad\Nyang tersembunyi di matamu.
Dialogue: 0,0:02:49.43,0:02:52.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah mengagumimu sejak saat itu.
Dialogue: 0,0:02:54.23,0:02:57.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Mulia mengagumi saya sejak dulu?
Dialogue: 0,0:02:57.20,0:02:59.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang hanya seorang bangsawan rendahan?
Dialogue: 0,0:03:00.91,0:03:03.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak punya kedudukan.
Dialogue: 0,0:03:03.04,0:03:05.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak punya rekam jejak\Ndi panggung besar juga.
Dialogue: 0,0:03:05.54,0:03:08.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, kau punya tekad\Nyang mampu menembus langit.
Dialogue: 0,0:03:08.71,0:03:10.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itulah aku serahkan\NShinano kepadamu!
Dialogue: 0,0:03:11.54,0:03:13.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pergilah, Kiyohara.
Dialogue: 0,0:03:13.59,0:03:16.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pimpinlah Shinano dengan semangat itu.
Dialogue: 0,0:03:16.26,0:03:18.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi dunia yang akan kuciptakan.
Dialogue: 0,0:03:19.60,0:03:22.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kaisar telah memerintahkanmu pergi!
Dialogue: 0,0:03:25.52,0:03:27.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kaisar Go-Daigo
Dialogue: 0,0:03:27.65,0:03:31.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah pahlawan dengan ambisi\Ndan karisma tiada tanding.
Dialogue: 0,0:03:31.85,0:03:34.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seolah aura Kaisar merasukinya,
Dialogue: 0,0:03:34.49,0:03:37.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}banyak bangsawan memegang\Nsenjata yang tak biasa mereka pakai.
Dialogue: 0,0:03:37.15,0:03:39.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu berdiri mempertaruhkan\Nnyawa di medan perang.
Dialogue: 0,0:03:40.07,0:03:43.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keunikan yang tidak biasa di zaman ini.
Dialogue: 0,0:03:44.12,0:03:45.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Hoshina!
Dialogue: 0,0:03:46.45,0:03:47.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kirim pasukan ke sisi kiri!
Dialogue: 0,0:03:48.87,0:03:52.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerahkan pasukan dari kanan\Nke kiri sebanyak mungkin!
Dialogue: 0,0:03:54.17,0:03:58.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya demi pemerintahan Kaisar!
Dialogue: 0,0:03:58.01,0:04:03.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menciptakan\Ndunia Kaisar di Shinano!
Dialogue: 0,0:04:04.31,0:04:07.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teruslah hidup dan tunggu waktunya ♪
Dialogue: 0,0:04:07.27,0:04:12.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jinjing nyawamu dan tembus takdir ♪
Dialogue: 0,0:04:12.11,0:04:15.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hiduplah dalam malu\Ndan kejar mimpimu ♪
Dialogue: 0,0:04:15.32,0:04:20.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi orang-orang\Nyang percaya padamu ♪
Dialogue: 0,0:04:34.04,0:04:37.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagian besar takkan tercatat\Ndalam sejarah ♪
Dialogue: 0,0:04:37.30,0:04:40.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua hal konyol itu ♪
Dialogue: 0,0:04:40.80,0:04:44.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membelit dan terurai, lagi dan lagi ♪
Dialogue: 0,0:04:44.60,0:04:47.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tarik napas ♪
Dialogue: 0,0:04:47.64,0:04:51.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk apa hidup ini dipersembahkan?♪
Dialogue: 0,0:04:51.23,0:04:54.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takdir apa yang menanti?♪
Dialogue: 0,0:04:54.61,0:04:57.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bila rasa bak kutukan ♪
Dialogue: 0,0:04:57.48,0:05:01.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan bisa mengikatku ♪
Dialogue: 0,0:05:01.82,0:05:04.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teruslah hidup dan tunggu waktunya ♪
Dialogue: 0,0:05:04.62,0:05:09.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jinjing nyawamu dan lawan takdir ♪
Dialogue: 0,0:05:09.50,0:05:12.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hiduplah dalam malu\Ndan kejar mimpimu ♪
Dialogue: 0,0:05:12.67,0:05:16.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi orang-orang\Nyang percaya padamu ♪
Dialogue: 0,0:05:17.00,0:05:20.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Iblis, sini,\Nikuti suara tepuk tanganku ♪
Dialogue: 0,0:05:20.17,0:05:23.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}(Hei, Iblis, sini,\Nikuti suara tepuk tanganku)♪
Dialogue: 0,0:05:23.76,0:05:27.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hidup itu singkat,\Nmenyanyi dan menarilah ♪
Dialogue: 0,0:05:27.14,0:05:31.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bunga akan mekar\Nbagi yang jago kabur ♪
Dialogue: 0,0:05:40.23,0:05:42.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teriaklah, orang-orang dungu.
Dialogue: 0,0:05:42.40,0:05:46.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suara itu adalah lonceng era baru!
Dialogue: 0,0:05:46.27,0:05:51.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk membangun dunia yang baik,\Nkita harus membersihkan kotoran dulu.
Dialogue: 0,0:05:51.79,0:05:56.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuasaan Kaisar akan mekar\Ndi atas darah ini!
Dialogue: 0,0:06:05.05,0:06:08.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Mulia Kaisar, lihatlah.
Dialogue: 0,0:06:08.18,0:06:13.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Darah ini adalah simbol kesetiaan saya.
Dialogue: 0,0:06:14.35,0:06:17.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah mengumpulkan pasukan\Nseperti yang kau minta...
Dialogue: 0,0:06:17.27,0:06:19.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tembak!
Dialogue: 0,0:06:19.11,0:06:21.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jumlahnya terlalu banyak!
Dialogue: 0,0:06:21.28,0:06:25.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah dikalahkan lagi dan lagi,\Ntapi mereka seolah bangkit dari kubur.
Dialogue: 0,0:06:25.41,0:06:27.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja. Lanjutkan terus.
Dialogue: 0,0:06:29.66,0:06:32.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebentar lagi waktunya tiba.
Dialogue: 0,0:06:37.33,0:06:40.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa? Pegang yang tegak!
Dialogue: 0,0:06:41.17,0:06:44.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, mana prajurit penggantinya?!
Dialogue: 0,0:06:52.55,0:06:56.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa malah berlama-lama?\NCepat tegakkan lagi!
Dialogue: 0,0:06:57.77,0:07:01.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak banyak yang bisa menggunakan\Npedang dengan tangan kiri.
Dialogue: 0,0:07:01.48,0:07:05.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan mengincar itu, kita bisa\Nmerusak formasi penandu.
Dialogue: 0,0:07:05.94,0:07:10.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kiri! Fokus ke kiri dan terus serang!
Dialogue: 0,0:07:10.11,0:07:13.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ikut aku, Shinomiya!\NHabisi jenderal musuh!
Dialogue: 0,0:07:14.83,0:07:17.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Goyang! Tandunya goyang!
Dialogue: 0,0:07:17.62,0:07:19.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi tidak bisa memanah.
Dialogue: 0,0:07:36.68,0:07:38.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah berakhir.
Dialogue: 0,0:07:38.43,0:07:41.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu cuma hiburan bangsawan.
Dialogue: 0,0:07:41.98,0:07:44.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo cepat pulang dan ambil hadiahnya!
Dialogue: 0,0:07:44.65,0:07:47.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita berhasil mengalahkan gubernur itu!
Dialogue: 0,0:07:47.20,0:07:49.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bicara seolah itu usahamu.
Dialogue: 0,0:07:49.36,0:07:51.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Memang bukan?
Dialogue: 0,0:07:54.40,0:07:56.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, Bos?
Dialogue: 0,0:07:56.74,0:07:57.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak...
Dialogue: 0,0:07:58.90,0:08:01.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gunung di belakang markas Shinomiya...
Dialogue: 0,0:08:02.12,0:08:03.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti ada sesuatu.
Dialogue: 0,0:08:06.30,0:08:07.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cahaya.
Dialogue: 0,0:08:10.76,0:08:12.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perlengkapan tempur?
Dialogue: 0,0:08:16.81,0:08:18.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gunung...
Dialogue: 0,0:08:20.23,0:08:21.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Muda?
Dialogue: 0,0:08:22.39,0:08:25.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus peringatkan\Npasukan Shinomiya untuk kabur!
Dialogue: 0,0:08:25.15,0:08:27.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skenario terburuknya,\Nada serangan dari belakang!
Dialogue: 0,0:08:28.14,0:08:29.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:08:29.32,0:08:31.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tidak mungkin!
Dialogue: 0,0:08:31.16,0:08:34.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di belakang pasukan Shinomiya itu\Npegunungan yang dalam!
Dialogue: 0,0:08:34.40,0:08:37.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin ada\Ngerombolan pasukan di sana...
Dialogue: 0,0:08:41.38,0:08:46.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, Tuan Muda!\NSemua jenderal musuh sudah muncul!
Dialogue: 0,0:08:50.42,0:08:53.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada seorang yang terlintas\Ndalam pikiranku.
Dialogue: 0,0:08:54.89,0:08:57.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cerdik dan teliti.
Dialogue: 0,0:08:57.46,0:09:01.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jenderal ahli strategi serangan kejutan\Ndengan menyusuri pegunungan...
Dialogue: 0,0:09:02.14,0:09:05.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan ada serangan kejutan\Ndari balik gunung?
Dialogue: 0,0:09:08.19,0:09:10.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada tanda apa-apa.
Dialogue: 0,0:09:11.45,0:09:13.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa buktinya?
Dialogue: 0,0:09:13.20,0:09:14.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak punya bukti,
Dialogue: 0,0:09:14.78,0:09:16.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi pokoknya cepat mundur!
Dialogue: 0,0:09:16.83,0:09:19.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita sudah hampir menang\Ndengan mengalahkan Gubernur, lo.
Dialogue: 0,0:09:19.58,0:09:21.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tidak bisa memindahkan\Nmarkas utama sekarang.
Dialogue: 0,0:09:24.08,0:09:28.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di tanah kami yang percaya dewa,\Nmembawa Mikoshi sungguh menggelikan.
Dialogue: 0,0:09:28.88,0:09:30.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang berhak naik Mikoshi adalah dewa.
Dialogue: 0,0:09:30.97,0:09:32.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma ada satu orang
Dialogue: 0,0:09:32.30,0:09:34.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang berhak di Shinano.
Dialogue: 0,0:09:37.39,0:09:40.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kami pertimbangkan\Nbegitu Tuan Shinomiya kembali.
Dialogue: 0,0:09:40.56,0:09:43.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti terlambat!\NItu intuisiku yang suka kabur!
Dialogue: 0,0:09:43.48,0:09:44.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong cepat!
Dialogue: 0,0:09:46.40,0:09:49.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Musuh...
Dialogue: 0,0:09:49.48,0:09:50.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Musuh?
Dialogue: 0,0:09:57.03,0:09:59.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Se-Serangan musuh!
Dialogue: 0,0:09:59.75,0:10:00.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:10:03.04,0:10:04.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yasaburo!
Dialogue: 0,0:10:04.37,0:10:05.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Celaka!
Dialogue: 0,0:10:08.25,0:10:09.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang akan mengejar dia!
Dialogue: 0,0:10:09.80,0:10:12.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shinomiya, kau pergi ke markas utama!
Dialogue: 0,0:10:18.59,0:10:20.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lari!
Dialogue: 0,0:10:22.85,0:10:24.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Muda!
Dialogue: 0,0:10:24.10,0:10:26.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kojirou! Genba!
Dialogue: 0,0:10:45.62,0:10:47.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shokan...
Dialogue: 0,0:11:00.80,0:11:02.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Tokiyuki...
Dialogue: 0,0:11:11.65,0:11:14.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perang yang dimulai\Ndi tiga medan perang,
Dialogue: 0,0:11:14.40,0:11:18.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dalam beberapa hari, kekuatan Utara\Ndan Selatan dioptimalkan.
Dialogue: 0,0:11:18.03,0:11:22.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasukan kedua pihak akan terkonsentrasi\Ndi tengah, dan perang penentuan pecah.
Dialogue: 0,0:11:22.91,0:11:26.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah menganalisis kekuatan\Npasukan masing-masing faksi,
Dialogue: 0,0:11:26.37,0:11:28.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku prediksi pertempuran penentu\Nterjadi di hari keempat,
Dialogue: 0,0:11:28.71,0:11:31.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan kami menggerakkan pasukan melalui\Npegunungan sesuai dengan perkiraan.
Dialogue: 0,0:11:32.25,0:11:37.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami kumpulkan informasi senjata rahasia\NGubernur dan memasukkannya dalam rencana.
Dialogue: 0,0:11:37.59,0:11:41.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu mainan yang sempurna\Nuntuk menarik perhatian di medan perang.
Dialogue: 0,0:11:41.80,0:11:45.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selagi perhatian semua orang\Ntertuju pada Mikoshi...
Dialogue: 0,0:11:46.35,0:11:50.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami dekati markas utama Shinomiya\Ndengan cepat dan lancarkan serangan kejutan.
Dialogue: 0,0:11:52.81,0:11:56.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini yang namanya strategi militer,\NTuan Chojumaru.
Dialogue: 0,0:11:57.23,0:11:58.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Strategi militer...
Dialogue: 0,0:12:00.24,0:12:03.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekalipun kau berhasil memburu\Npemimpin rendahan yang kabur terus
Dialogue: 0,0:12:03.58,0:12:05.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan melindungi desa-desa kecil...
Dialogue: 0,0:12:06.18,0:12:09.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak bisa membaca\Nalur perang besar,
Dialogue: 0,0:12:09.21,0:12:14.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau takkan bisa meraih\Nhal besar di masa depan nanti.
Dialogue: 0,0:12:14.33,0:12:19.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harusnya minta diajari\Nsoal perang oleh Tuan Kusunoki...
Dialogue: 0,0:12:19.55,0:12:21.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi sayang sekali!
Dialogue: 0,0:12:21.34,0:12:23.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah waktunya anak baik mati!
Dialogue: 0,0:12:23.31,0:12:24.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Muda!
Dialogue: 0,0:12:25.02,0:12:28.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka jalan kaki,\Ntidak akan bisa mengejar kuda!
Dialogue: 0,0:12:31.85,0:12:34.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau memang hebat, Shokan.
Dialogue: 0,0:12:34.78,0:12:38.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Strategimu berhasil dengan sempurna.
Dialogue: 0,0:12:38.32,0:12:39.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan...
Dialogue: 0,0:12:40.65,0:12:44.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berhasil menembus\Ngaris pertahanan di celah ini.
Dialogue: 0,0:12:44.52,0:12:48.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita bantai pasukan Shinomiya!
Dialogue: 0,0:12:51.63,0:12:54.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya dengan satu gerakan\Nseorang prajurit,
Dialogue: 0,0:12:54.50,0:12:57.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}seluruh jalan perang berbalik total.
Dialogue: 0,0:12:58.46,0:13:00.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, ini perang...
Dialogue: 0,0:13:00.96,0:13:03.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini strategi militer...
Dialogue: 0,0:13:03.89,0:13:07.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial! Saat aku tidak ada di markas utama!
Dialogue: 0,0:13:08.14,0:13:12.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini gawat. Pasukan yang sudah\Ntumbang tak bisa bangkit lagi.
Dialogue: 0,0:13:12.10,0:13:13.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Shinomiya!
Dialogue: 0,0:13:14.15,0:13:18.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf! Andai aku sadar lebih cepat!
Dialogue: 0,0:13:18.69,0:13:20.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan ngawur.
Dialogue: 0,0:13:20.07,0:13:23.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bergantung pada anak-anak sejauh itu,\Nmartabat samurai bisa jatuh.
Dialogue: 0,0:13:23.84,0:13:28.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang sedang kupikirkan adalah\Nbagaimana cara menerima kekalahan ini.
Dialogue: 0,0:13:28.23,0:13:30.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama seperti saat Hoshina,
Dialogue: 0,0:13:30.21,0:13:33.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku juga takkan semudah itu\Nmembuang wilayahku.
Dialogue: 0,0:13:34.00,0:13:37.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi jika berdiam diri\Ndi tengah kekacauan ini,
Dialogue: 0,0:13:37.17,0:13:38.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kehancuran total pasti terjadi.
Dialogue: 0,0:13:48.14,0:13:50.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tu-Tuan Mochizuki!
Dialogue: 0,0:13:51.18,0:13:55.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf! Rekan kita ikut terlempar,\Nmohon tolong mereka!
Dialogue: 0,0:13:57.27,0:14:01.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari tiga jenderal utama Pasukan Shinto Suwa,\Nkami sampaikan pesan ke Pasukan Shinomiya!
Dialogue: 0,0:14:01.94,0:14:05.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pahamilah untuk menang perang ini\Nadalah dengan kabur!
Dialogue: 0,0:14:05.48,0:14:07.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menjaga bagian belakang\Ndan mengulur waktu.
Dialogue: 0,0:14:07.91,0:14:11.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bawa keluarga kalian\Ndan pergilah ke wilayah Hoshina!
Dialogue: 0,0:14:11.87,0:14:15.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suwa Myojin pasti\Nakan bangkit suatu saat nanti.
Dialogue: 0,0:14:15.83,0:14:19.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teruslah hidup dan tunggu saat itu tiba!
Dialogue: 0,0:14:22.42,0:14:24.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suwa Myojin!
Dialogue: 0,0:14:24.05,0:14:25.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih!
Dialogue: 0,0:14:25.30,0:14:28.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku rela menanggung penghinaan\Napa pun sekarang demi momen itu!
Dialogue: 0,0:14:29.59,0:14:31.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah.
Dialogue: 0,0:14:31.18,0:14:34.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kata-kata tiga jenderal besar\Nsangat meyakinkan.
Dialogue: 0,0:14:35.10,0:14:40.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, serahkan musuh pada\NTuan Mochizuki dan bersiap mundur!
Dialogue: 0,0:14:40.19,0:14:41.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:14:42.48,0:14:45.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Mochizuki harusnya ada di utara...
Dialogue: 0,0:14:45.45,0:14:47.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa datang ke medan perang ini?
Dialogue: 0,0:14:47.57,0:14:52.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah itu, aku menceritakan situasi\Nmedan perang tengah ke Ayahanda.
Dialogue: 0,0:14:52.37,0:14:55.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu mendengar laporanku,
Dialogue: 0,0:14:55.54,0:14:58.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayahanda bilang ini membosankan\Ndan langsung berangkat.
Dialogue: 0,0:14:58.67,0:14:59.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membosankan?
Dialogue: 0,0:14:59.79,0:15:00.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:15:01.21,0:15:05.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gerakan musuh di medan perang ini\Nterlalu membosankan!
Dialogue: 0,0:15:05.33,0:15:10.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku mulai khawatir karena\Nmerasa bakal terjadi kejutan menarik.
Dialogue: 0,0:15:10.26,0:15:11.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Re-Remeh banget...
Dialogue: 0,0:15:11.85,0:15:13.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kami jadi tertolong.
Dialogue: 0,0:15:14.06,0:15:17.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak awal, peluang kita menang\Ndi perang ini kecil.
Dialogue: 0,0:15:17.35,0:15:21.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau bagaimana lagi karena Tuan Yorishige\Nbelum bisa bergerak secara terbuka.
Dialogue: 0,0:15:22.40,0:15:24.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inukai dan Tokoiwa
Dialogue: 0,0:15:24.95,0:15:28.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sudah diperintah untuk bersembunyi\Ndi pegunungan jika kalah,
Dialogue: 0,0:15:28.41,0:15:32.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Yorishige juga sudah menyiapkan\Nperlengkapan dan tempat tinggal untuk itu.
Dialogue: 0,0:15:33.53,0:15:35.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini cuma perang pendahuluan.
Dialogue: 0,0:15:35.91,0:15:38.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tujuan Tuan Yorishige\Nmeminimalkan korban jiwa
Dialogue: 0,0:15:38.21,0:15:42.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan memperkuat persatuan Suwa Shinto.
Dialogue: 0,0:15:43.25,0:15:46.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Yorishige sudah\Nmemperhitungkan sampai sejauh itu.
Dialogue: 0,0:15:46.53,0:15:50.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Strategi militer yang jauh\Nlebih mendalam dari Shokan...
Dialogue: 0,0:15:50.58,0:15:52.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, Tuan Muda.
Dialogue: 0,0:15:52.97,0:15:56.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dirimu yang berlarian siang malam
Dialogue: 0,0:15:56.14,0:15:58.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mempertaruhkan nyawa demi Suwa Shinto
Dialogue: 0,0:15:58.85,0:16:03.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dihormati oleh semua rekan kita.
Dialogue: 0,0:16:03.90,0:16:07.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di perang besar berikutnya,\Nkami, rakyat Shinano,
Dialogue: 0,0:16:07.40,0:16:10.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berjanji akan membantu Anda.
Dialogue: 0,0:16:14.87,0:16:17.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misi terakhir Regu Tumujaka
Dialogue: 0,0:16:17.71,0:16:21.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah mengabarkan kekalahan\Nmedan perang tengah ke utara.
Dialogue: 0,0:16:22.46,0:16:27.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu mendengar pesan, Tuan Unno\Ndan Tuan Nezu bergegas ke tengah.
Dialogue: 0,0:16:28.51,0:16:30.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkat perjuangan tiga jenderal,
Dialogue: 0,0:16:30.43,0:16:32.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pasukan Shinomiya yang terdesak\Nberhasil diselamatkan.
Dialogue: 0,0:16:32.88,0:16:36.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Korban jiwa berhasil diminimalkan.
Dialogue: 0,0:16:36.72,0:16:39.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena peluang menang telah sirna,
Dialogue: 0,0:16:39.48,0:16:42.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Tokoiwa dari Utara dan Tuan Inukai\Ndari selatan kabur ke pegunungan...
Dialogue: 0,0:16:42.64,0:16:46.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gubernur Kiyohara berhasil\Nkabur dalam kekacauan.
Dialogue: 0,0:16:47.90,0:16:51.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasukan Shokan dan Ogasawara\Nberhasil dihentikan karena kelelahan,
Dialogue: 0,0:16:51.41,0:16:54.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi sebagian besar wilayah direbut.
Dialogue: 0,0:16:55.66,0:16:59.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang sangat disayangkan,\Ntapi mohon tumpangannya, Yasaburo.
Dialogue: 0,0:16:59.37,0:17:00.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:17:00.70,0:17:04.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga terkecoh siasat musuh\Ndan gagal menghabisi Kiyohara.
Dialogue: 0,0:17:04.79,0:17:07.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang bertanggung jawab\Natas kekalahan kali ini.
Dialogue: 0,0:17:08.04,0:17:10.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengurus kehidupan pasukan Shinomiya
Dialogue: 0,0:17:10.30,0:17:11.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan mendoakan para prajurit yang gugur.
Dialogue: 0,0:17:11.89,0:17:14.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hoshina akan mengurus itu semua.
Dialogue: 0,0:17:14.42,0:17:15.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:17:15.89,0:17:18.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan ada Tuan Shinomiya,\Nkita takkan terkalahkan!
Dialogue: 0,0:17:18.84,0:17:21.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita bantai mereka selanjutnya!
Dialogue: 0,0:17:21.56,0:17:23.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya...
Dialogue: 0,0:17:23.34,0:17:27.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka jauh berbeda dengan kita.
Dialogue: 0,0:17:32.78,0:17:36.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau gabungkan saja\Ndua kelompok kita?
Dialogue: 0,0:17:36.08,0:17:37.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi masa depan.
Dialogue: 0,0:17:40.49,0:17:42.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu mungkin ide bagus.
Dialogue: 0,0:17:42.75,0:17:46.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah dengar Suwa Myojin\Nakan bangkit kembali.
Dialogue: 0,0:17:46.79,0:17:50.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku rela melakukan apa saja\Ndemi hidup untuk menjemput hari itu.
Dialogue: 0,0:17:51.17,0:17:53.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasukan Shinto Suwa dicap\Nsebagai musuh negara
Dialogue: 0,0:17:53.89,0:17:57.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan mengalami kekalahan dalam perang.
Dialogue: 0,0:17:57.10,0:18:01.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika keadaan ini terus berlanjut,\Nsemua wilayah mereka akan direbut.
Dialogue: 0,0:18:01.02,0:18:04.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka harus mempertaruhkan semuanya\Ndalam pemberontakan besar.
Dialogue: 0,0:18:04.30,0:18:08.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesadaran dan tekad itu\Ndirasakan mereka bersama.
Dialogue: 0,0:18:41.18,0:18:44.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kepala Rumah Tangga Kekaisaran,\NMinamoto Mitsunori.
Dialogue: 0,0:18:45.39,0:18:48.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penasihat, Tachibana Noritaka.
Dialogue: 0,0:18:49.15,0:18:53.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wakil Penasihat, Fujiwara Kinhira.
Dialogue: 0,0:18:54.78,0:18:58.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekian promosi kali ini.
Dialogue: 0,0:19:00.91,0:19:06.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa promosi karena garis\Nketurunan meski punya bakat
Dialogue: 0,0:19:06.29,0:19:07.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pasti menyakitkan.
Dialogue: 0,0:19:07.67,0:19:10.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa promosi memang menyakitkan,
Dialogue: 0,0:19:10.91,0:19:15.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menyedihkan juga tak bisa promosi\Nkalau tidak ke Kamakura.
Dialogue: 0,0:19:16.92,0:19:21.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Kiyohara, tidak ada gunanya\Nbersedih karena gagal promosi.
Dialogue: 0,0:19:21.76,0:19:25.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus ikhlas karena hidup\Ndi zaman seperti sekarang.
Dialogue: 0,0:19:26.73,0:19:28.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu...
Dialogue: 0,0:19:28.56,0:19:33.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya bisa menunggu hari di mana\Norang tanpa garis keturunan bisa promosi.
Dialogue: 0,0:19:55.75,0:19:59.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yoritsugu! Yoritsugu!
Dialogue: 0,0:19:59.63,0:20:02.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yoritsugu pergi ke mana?
Dialogue: 0,0:20:03.14,0:20:05.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yoritsugu!
Dialogue: 0,0:20:08.68,0:20:12.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hatiku terasa berat harus\Nmelaporkan kalah perang.
Dialogue: 0,0:20:16.11,0:20:20.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Yorishige senang Anda selamat.
Dialogue: 0,0:20:21.32,0:20:23.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat itu.
Dialogue: 0,0:20:23.70,0:20:29.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat Anda pergi ke medan perang,\NTuan Yorishige selalu membangun gubuk di sana
Dialogue: 0,0:20:29.62,0:20:34.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan lakukan ritual tanpa ada yang boleh masuk\Nuntuk mendoakan keselamatan Anda.
Dialogue: 0,0:20:35.21,0:20:36.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ritual...
Dialogue: 0,0:20:37.21,0:20:40.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyiramkan air dingin di musim ini...
Dialogue: 0,0:20:40.36,0:20:42.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sepeduli itu padaku...
Dialogue: 0,0:20:43.55,0:20:46.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menyadarinya dengan jelas kali ini.
Dialogue: 0,0:20:46.43,0:20:50.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tujuanku sama dengan Tuan Yorishige.
Dialogue: 0,0:20:51.15,0:20:55.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemulihan Hojo berarti\Nmenolong rakyat Shinano.
Dialogue: 0,0:20:56.61,0:20:59.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan waktunya bersedih!
Dialogue: 0,0:20:59.48,0:21:03.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menguasai dunia\Nbersama orang itu!
Dialogue: 0,0:21:04.36,0:21:07.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pulang, Tuan Yorishige!
Dialogue: 0,0:21:12.16,0:21:14.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yorishige
Dialogue: 0,0:21:14.63,0:21:17.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sedang mandi di onsen...
Dialogue: 0,0:21:17.67,0:21:20.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Onsen yang ditemukan\Ndengan kekuatan ilahi!
Dialogue: 0,0:21:20.92,0:21:24.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia membawa alkohol dan makanan!
Dialogue: 0,0:21:24.97,0:21:29.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau malah main-main\Nsaat orang bertaruh nyawa, Myojin Bodoh?!
Dialogue: 0,0:21:29.98,0:21:33.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak, aku tadi ritual, kok...
Dialogue: 0,0:21:33.02,0:21:35.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau disiram air panas ya pasti enak!
Dialogue: 0,0:21:35.82,0:21:37.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang kenapa?!
Dialogue: 0,0:21:37.03,0:21:39.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada aturan harus pakai air dingin!
Dialogue: 0,0:21:39.90,0:21:42.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayaknya aku memang\Ntidak bisa akur dengan orang ini.
Dialogue: 0,0:21:42.99,0:21:45.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beri dia pelajaran!
Dialogue: 0,0:21:48.95,0:21:53.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di perang kali ini, pihak Suwa\Nkehilangan wilayah
Dialogue: 0,0:21:53.25,0:21:55.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan sebagai gantinya\Nmendapatkan ikatan.
Dialogue: 0,0:21:55.79,0:22:01.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih dari itu, Tokiyuki dan Yorishige\Nmakin solid mencapai tujuan mereka.
Dialogue: 0,0:22:01.09,0:22:05.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kubu Suwa bersatu dalam persiapan\Nmenghadapi perang besar.
Dialogue: 0,0:22:07.05,0:22:08.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitulah kelihatannya.
Dialogue: 0,0:22:11.64,0:22:16.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bila ingin romantis ♪
Dialogue: 0,0:22:16.52,0:22:19.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cintai aku lebih dari siapa pun ♪
Dialogue: 0,0:22:25.11,0:22:28.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kamu orang yang baik ♪
Dialogue: 0,0:22:28.49,0:22:32.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bakal baik ke gadis itu juga, 'kan?♪
Dialogue: 0,0:22:32.25,0:22:35.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa, tidak masalah ♪
Dialogue: 0,0:22:35.58,0:22:39.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong bawakan\Nsemua barang beratnya, ya ♪
Dialogue: 0,0:22:39.30,0:22:42.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu keren di depan orang-orang ♪
Dialogue: 0,0:22:42.47,0:22:46.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kamu imut saat kita berduaan ♪
Dialogue: 0,0:22:46.26,0:22:49.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setia seperti anjing ♪
Dialogue: 0,0:22:49.60,0:22:55.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan menghilang seperti kucing, ya ♪
Dialogue: 0,0:22:56.27,0:22:59.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terkadang aku sedih ♪
Dialogue: 0,0:22:59.77,0:23:03.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi sentimental\Nsaat menatap bintang ♪
Dialogue: 0,0:23:03.36,0:23:10.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini, kamu dengan siapa\Ndan sedang apa?♪
Dialogue: 0,0:23:10.49,0:23:14.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, jika kamu mau\Nmencintai dan dicintai ♪
Dialogue: 0,0:23:14.46,0:23:17.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan selalu membuatmu berdebar ♪
Dialogue: 0,0:23:17.92,0:23:21.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika tidak memilihku ♪
Dialogue: 0,0:23:21.50,0:23:25.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menjatuhkanmu ke neraka ♪
Dialogue: 0,0:23:25.17,0:23:28.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mendengarmu ♪
Dialogue: 0,0:23:28.64,0:23:32.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau tahu lagi ♪
Dialogue: 0,0:23:32.39,0:23:36.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bila ingin romantis ♪
Dialogue: 0,0:23:36.02,0:23:38.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cintai aku lebih dari siapa pun ♪
Dialogue: 0,0:23:43.44,0:23:44.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo!
