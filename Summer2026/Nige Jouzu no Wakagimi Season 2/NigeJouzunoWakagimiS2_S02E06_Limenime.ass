Dialogue: 0,0:03:16.13,0:03:20.05,sign,,0000,0000,0000,,{\an8}(Anak Suwa Yorishige\NSuwa Tokitsugu)
Dialogue: 0,0:04:03.80,0:04:10.94,sign,,0000,0000,0000,,{\an8}(Cucu Suwa Yorishige\NSuwa Yoritsugu)
Dialogue: 0,0:04:35.04,0:04:40.46,sign,,0000,0000,0000,,{\an8}(Tuan Muda Jago Kabur)
Dialogue: 0,0:05:47.95,0:05:54.20,sign,,0000,0000,0000,,{\an8}(Dua Tahun yang Lalu)
Dialogue: 0,0:11:43.47,0:11:44.97,sign,,0000,0000,0000,,{\an8}(Besoknya)
Dialogue: 0,0:11:45.06,0:11:47.39,sign,,0000,0000,0000,,{\an8}(Tuan Yoritsugu semangat)
Dialogue: 0,0:19:54.96,0:20:01.38,sign,,0000,0000,0000,,{\an8}(Sruk sruk sruk sruk sruk)
