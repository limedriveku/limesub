Dialogue: 0,0:00:08.98,0:00:11.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah pagi, Kakanda.\NAyo bangun.
Dialogue: 0,0:00:14.11,0:00:19.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku capek dan ngantuk\Nkarena perang.
Dialogue: 0,0:00:19.83,0:00:23.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak boleh.\NRambutmu harus disisir dan diikat.
Dialogue: 0,0:00:24.16,0:00:27.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak bangun, Ayah\Nakan mengusap pipimu terus, lo.
Dialogue: 0,0:00:27.88,0:00:29.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya...
Dialogue: 0,0:00:32.55,0:00:33.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Indah.
Dialogue: 0,0:00:33.84,0:00:37.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak kusut setelah perang sengit.
Dialogue: 0,0:00:37.34,0:00:40.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Tokiyuki sudah\Nmendapatkan nama dewasa,
Dialogue: 0,0:00:40.18,0:00:43.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi rambutnya tidak dipotong\Ndan tidak ditata seperti orang dewasa, ya.
Dialogue: 0,0:00:43.81,0:00:47.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para pengawal menyuruhku\Ntidak memotong rambut dulu.
Dialogue: 0,0:00:47.79,0:00:50.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakakku tidak menggubrisnya\Ndan tetap dipotong, sih.
Dialogue: 0,0:00:50.65,0:00:52.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Merawatnya susah.
Dialogue: 0,0:00:52.19,0:00:54.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang tidak boleh?
Dialogue: 0,0:00:54.03,0:00:56.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu adalah\Njimat keberuntungan, Shizuku.
Dialogue: 0,0:00:57.49,0:00:58.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jimat keberuntungan?
Dialogue: 0,0:00:59.57,0:01:04.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rambut yang belum pernah dipotong\Nadalah simbol kesucian.
Dialogue: 0,0:01:04.40,0:01:07.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak-anak diyakini\Nmemiliki kekuatan suci.
Dialogue: 0,0:01:07.75,0:01:12.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak yang belum pernah potong rambut\Nmakin jadi simbol keberuntungan.
Dialogue: 0,0:01:13.30,0:01:17.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itulah saya\Ntidak memotong rambut Tuan.
Dialogue: 0,0:01:18.05,0:01:20.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Samurai mementingkan\Nkeberuntungan dalam pertempuran.
Dialogue: 0,0:01:20.96,0:01:24.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika anak dengan rambut panjang\Nseindah ini memimpin pasukan,
Dialogue: 0,0:01:24.52,0:01:27.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}semuanya akan bertarung\Ndengan percaya diri.
Dialogue: 0,0:01:27.73,0:01:31.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi jika menjadi penguasa negeri ini...
Dialogue: 0,0:01:31.28,0:01:34.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan tak boleh punya rambut panjang\Nseperti anak-anak selamanya.
Dialogue: 0,0:01:34.86,0:01:36.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Tokiyuki.
Dialogue: 0,0:01:37.40,0:01:39.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika Anda berhasil\Nmerebut kembali kekuasaan...
Dialogue: 0,0:01:41.41,0:01:42.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu...
Dialogue: 0,0:01:43.45,0:01:47.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bolehkah saya memotong rambut Anda?
Dialogue: 0,0:01:52.75,0:01:54.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan.
Dialogue: 0,0:02:05.60,0:02:10.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memotong rambut berarti\Nakan menjadi ayah angkat.
Dialogue: 0,0:02:10.90,0:02:13.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pun merasa\Ntak keberatan soal itu.
Dialogue: 0,0:02:15.11,0:02:18.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terkadang dia mempermainkanku\Ndi atas telapak tangannya.
Dialogue: 0,0:02:18.44,0:02:21.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terkadang dia egois dan diktator.
Dialogue: 0,0:02:22.07,0:02:25.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terkadang rewel menyuruhku belajar.
Dialogue: 0,0:02:25.66,0:02:28.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terkadang memelukku dengan erat.
Dialogue: 0,0:02:29.00,0:02:31.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terkadang dia datang menolong\Ndengan wajah panik.
Dialogue: 0,0:02:45.72,0:02:46.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu.
Dialogue: 0,0:02:50.27,0:02:52.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanpa kusadari, aku sudah...
Dialogue: 0,0:02:56.53,0:02:57.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh!
Dialogue: 0,0:02:57.60,0:02:59.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oi, kau.
Dialogue: 0,0:02:59.24,0:03:03.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan terbawa suasana\Nhanya karena kau putra Hojo.
Dialogue: 0,0:03:03.86,0:03:06.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah menjadi dewa.
Dialogue: 0,0:03:06.31,0:03:08.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku lebih hebat.
Dialogue: 0,0:03:09.58,0:03:11.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo, Tuan Tokiyuki.
Dialogue: 0,0:03:12.29,0:03:15.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon maaf saya jarang menemui Anda.
Dialogue: 0,0:03:16.59,0:03:19.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Tokitsugu, lama tak bertemu.
Dialogue: 0,0:03:20.42,0:03:22.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Izin memperkenalkan anak ini.
Dialogue: 0,0:03:22.85,0:03:24.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia anak saya, Yoritsugu.
Dialogue: 0,0:03:26.39,0:03:27.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, Yoritsugu?
Dialogue: 0,0:03:27.85,0:03:29.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah beri salam?
Dialogue: 0,0:03:31.69,0:03:34.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah, Ayahanda!
Dialogue: 0,0:03:34.48,0:03:38.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku grogi karena bertemu\NTuan Tokiyuki yang kukagumi!
Dialogue: 0,0:03:38.57,0:03:42.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku agak kaget karena\Ntiba-tiba bicara padanya.
Dialogue: 0,0:03:42.49,0:03:43.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurang ajar!
Dialogue: 0,0:03:43.57,0:03:45.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon maaf, Tuan Tokiyuki!
Dialogue: 0,0:03:46.02,0:03:49.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari, ayo temui Kakek bersama!
Dialogue: 0,0:03:50.29,0:03:54.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kaget saat mendengar\NYorishige punya cucu.
Dialogue: 0,0:03:55.29,0:03:58.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya dia sudah jadi dewa?
Dialogue: 0,0:03:58.29,0:04:00.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, yang lebih membingungkan...
Dialogue: 0,0:04:04.18,0:04:07.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita buktikan.
Dialogue: 0,0:04:07.47,0:04:10.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dewa dan Hojo...\NMana yang lebih hebat?
Dialogue: 0,0:04:10.94,0:04:12.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sableng!
Dialogue: 0,0:04:12.60,0:04:17.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak ini sableng parah!
Dialogue: 0,0:04:18.23,0:04:21.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teruslah hidup dan tunggu waktunya ♪
Dialogue: 0,0:04:21.20,0:04:26.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jinjing nyawamu dan tembus takdir ♪
Dialogue: 0,0:04:26.03,0:04:29.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hiduplah dalam malu\Ndan kejar mimpimu ♪
Dialogue: 0,0:04:29.25,0:04:34.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi orang-orang\Nyang percaya padamu ♪
Dialogue: 0,0:04:47.97,0:04:51.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagian besar takkan tercatat\Ndalam sejarah ♪
Dialogue: 0,0:04:51.23,0:04:54.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua hal konyol itu ♪
Dialogue: 0,0:04:54.73,0:04:58.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membelit dan terurai, lagi dan lagi ♪
Dialogue: 0,0:04:58.52,0:05:01.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tarik napas ♪
Dialogue: 0,0:05:01.57,0:05:05.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk apa hidup ini dipersembahkan?♪
Dialogue: 0,0:05:05.16,0:05:08.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takdir apa yang menanti?♪
Dialogue: 0,0:05:08.53,0:05:11.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bila rasa bak kutukan ♪
Dialogue: 0,0:05:11.41,0:05:15.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan bisa mengikatku ♪
Dialogue: 0,0:05:15.75,0:05:18.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teruslah hidup dan tunggu waktunya ♪
Dialogue: 0,0:05:18.54,0:05:23.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jinjing nyawamu dan lawan takdir ♪
Dialogue: 0,0:05:23.42,0:05:26.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hiduplah dalam malu\Ndan kejar mimpimu ♪
Dialogue: 0,0:05:26.59,0:05:30.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi orang-orang\Nyang percaya padamu ♪
Dialogue: 0,0:05:30.93,0:05:34.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Iblis, sini,\Nikuti suara tepuk tanganku ♪
Dialogue: 0,0:05:34.10,0:05:37.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}(Hei, Iblis, sini,\Nikuti suara tepuk tanganku)♪
Dialogue: 0,0:05:37.69,0:05:41.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hidup itu singkat,\Nmenyanyi dan menarilah ♪
Dialogue: 0,0:05:41.07,0:05:45.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bunga akan mekar\Nbagi yang jago kabur ♪
Dialogue: 0,0:05:48.24,0:05:50.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yoritsugu imut banget!
Dialogue: 0,0:05:50.74,0:05:54.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelak kau akan mewarisi Suwa\Ndan jadi dewa yang baik!
Dialogue: 0,0:05:54.54,0:05:56.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dua tahun yang lalu,
Dialogue: 0,0:05:56.71,0:06:00.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku, Suwa Yoritsugu, masih jadi\Ntokoh utama Suwa masa depan.
Dialogue: 0,0:06:01.09,0:06:02.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hojo!
Dialogue: 0,0:06:02.50,0:06:05.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan muda Hojo melarikan diri ke sini!
Dialogue: 0,0:06:06.42,0:06:08.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan muda, sungguh menyedihkan!
Dialogue: 0,0:06:08.34,0:06:11.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita sambut beliau, Tuan Yoritsugu!
Dialogue: 0,0:06:12.64,0:06:13.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku...
Dialogue: 0,0:06:14.18,0:06:15.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak usah.
Dialogue: 0,0:06:16.64,0:06:18.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang!
Dialogue: 0,0:06:18.73,0:06:22.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anda pasti kelelahan\Ndi perjalanan panjang!
Dialogue: 0,0:06:22.01,0:06:24.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan saya siapkan makanan.
Dialogue: 0,0:06:24.03,0:06:25.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari, silakan masuk.
Dialogue: 0,0:06:25.49,0:06:28.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Muda, ayo cepat kemari!
Dialogue: 0,0:06:30.53,0:06:32.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyerahkan takhta dewa?
Dialogue: 0,0:06:32.49,0:06:33.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:06:33.77,0:06:38.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, saya sudah mempercayakan\Nsebagian besar pekerjaan dewa ke Tokitsugu.
Dialogue: 0,0:06:39.12,0:06:43.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya ingin mempercayakan\Nsemuanya ke cucu saya, Yoritsugu.
Dialogue: 0,0:06:43.55,0:06:46.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi begitu maksudnya menjadi dewa.
Dialogue: 0,0:06:46.42,0:06:48.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak semuda ini mewarisi itu...
Dialogue: 0,0:06:48.80,0:06:51.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eits, kesempatan!
Dialogue: 0,0:06:51.38,0:06:53.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Usapan pipi nggak berguna!
Dialogue: 0,0:06:53.81,0:06:57.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Usapan pipinya lebih besar\Ndibanding aku dulu!
Dialogue: 0,0:06:58.39,0:07:01.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, kenapa kau duduk\Ndi samping Kakek?
Dialogue: 0,0:07:01.89,0:07:04.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya itu tempat dudukku!
Dialogue: 0,0:07:05.65,0:07:08.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Yorishige, aku pamit dulu!
Dialogue: 0,0:07:08.24,0:07:10.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya jadi kesepian\Nkalau Tuan buru-buru!
Dialogue: 0,0:07:10.86,0:07:13.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih ada waktu, 'kan?
Dialogue: 0,0:07:14.49,0:07:17.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan ganggu aku terus!
Dialogue: 0,0:07:18.00,0:07:22.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia menggelitik lebih akurat\Ndaripada aku dulu!
Dialogue: 0,0:07:22.17,0:07:26.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang sepertimu memonopoli\Nkasih sayang Kakek!
Dialogue: 0,0:07:26.17,0:07:29.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama, aku harus\Nmenyadarkan Kakek dulu.
Dialogue: 0,0:07:31.34,0:07:33.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Tuan Tokiyuki.
Dialogue: 0,0:07:33.14,0:07:36.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin lebih akrab\Ndengan Tuan Tokiyuki!
Dialogue: 0,0:07:37.02,0:07:39.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong manjakan aku!
Dialogue: 0,0:07:43.81,0:07:46.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tu-Tuan Tokiyuki,\Napa yang Tuan lakukan?
Dialogue: 0,0:07:47.19,0:07:49.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, tidak, dia sendiri...
Dialogue: 0,0:07:50.57,0:07:53.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat pertama kali\Nbertemu tadi juga begini.
Dialogue: 0,0:07:54.07,0:07:58.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya Tuan Tokiyuki membenciku.
Dialogue: 0,0:07:59.03,0:08:02.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat perkenalan,\Ndia mencengkeram kerah baju...
Dialogue: 0,0:08:02.29,0:08:04.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Hojo.
Dialogue: 0,0:08:04.84,0:08:08.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada yang lebih mulia\Ndari aku di Suwa.
Dialogue: 0,0:08:08.17,0:08:10.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo bertanding besok.
Dialogue: 0,0:08:10.62,0:08:13.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang kalah diusir.
Dialogue: 0,0:08:13.25,0:08:17.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mengatakan itu dan aku menerima\Ntantangan itu dengan berat hati.
Dialogue: 0,0:08:17.43,0:08:22.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Tokiyuki, ternyata Anda\Nsekasar itu di belakang!
Dialogue: 0,0:08:22.23,0:08:25.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Tokiyuki, minta maaf!
Dialogue: 0,0:08:25.40,0:08:29.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin aku mengatakan itu!
Dialogue: 0,0:08:29.60,0:08:31.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu...
Dialogue: 0,0:08:31.28,0:08:34.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan membunuh\NYorishige suatu saat.
Dialogue: 0,0:08:34.70,0:08:37.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mengganggu\Nkarena bersinar tidak jelas.
Dialogue: 0,0:08:37.87,0:08:38.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu katanya.
Dialogue: 0,0:08:38.79,0:08:41.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu keterlaluan, Tuan Tokiyuki.
Dialogue: 0,0:08:41.25,0:08:42.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minta maaflah pada saya.
Dialogue: 0,0:08:42.96,0:08:44.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku enggak bilang begitu!
Dialogue: 0,0:08:44.92,0:08:46.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagian, itu tadi siapa?!
Dialogue: 0,0:08:46.95,0:08:48.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi tidak apa-apa.
Dialogue: 0,0:08:48.59,0:08:51.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Tokiyuki adalah harapan Hojo.
Dialogue: 0,0:08:51.50,0:08:55.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika diusir orang ini, aku ikhlas!
Dialogue: 0,0:08:56.22,0:08:59.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai jumpa\Ndi pertandingan besok, Tuan Tokiyuki!
Dialogue: 0,0:08:59.72,0:09:01.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan kabur.
Dialogue: 0,0:09:01.68,0:09:05.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pasti akan mengusirmu.
Dialogue: 0,0:09:11.19,0:09:12.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya ampun.
Dialogue: 0,0:09:12.78,0:09:16.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan kasar begitu\Nke anak yang lebih muda!
Dialogue: 0,0:09:16.99,0:09:20.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon maaf, Tuan Tokiyuki!
Dialogue: 0,0:09:20.12,0:09:22.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yoritsugu juga ada salah!
Dialogue: 0,0:09:22.90,0:09:27.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, anak itu juga kurang bersosialisasi...
Dialogue: 0,0:09:27.54,0:09:28.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, iya.
Dialogue: 0,0:09:28.88,0:09:31.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anggap saja sudah impas!
Dialogue: 0,0:09:32.25,0:09:35.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian berdua, duduk di situ.
Dialogue: 0,0:09:37.97,0:09:41.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian paham itu tadi\Nkebohongan anak-anak, 'kan?
Dialogue: 0,0:09:42.18,0:09:43.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya...
Dialogue: 0,0:09:43.85,0:09:48.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana dengan aku\Nyang sering jadi korban?
Dialogue: 0,0:09:48.85,0:09:51.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami pura-pura tidak melihat.
Dialogue: 0,0:09:54.11,0:09:57.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku paham dia menganggapku mengganggu\Nkarena menumpang di sini.
Dialogue: 0,0:09:57.99,0:10:01.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru aku merasa tidak enak\Npada Tuan Yoritsugu.
Dialogue: 0,0:10:01.51,0:10:02.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:10:03.41,0:10:05.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin ini terlalu lancang.
Dialogue: 0,0:10:06.12,0:10:09.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika ayah dan kakek\Nyang ia sayangi membiarkan itu,
Dialogue: 0,0:10:09.48,0:10:13.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bukankah dia bisa menjadi dewa\Nyang menjebak orang dengan entengnya?
Dialogue: 0,0:10:16.05,0:10:20.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan banyaknya kesalahan kami.\NKami sungguh menyesal.
Dialogue: 0,0:10:21.26,0:10:24.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami merasa rendah diri.
Dialogue: 0,0:10:25.01,0:10:26.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rendah diri?
Dialogue: 0,0:10:26.93,0:10:29.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena pekerjaan ayah dan kakeknya,
Dialogue: 0,0:10:29.15,0:10:33.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia yang masih muda harus\Nmenanggung tanggung jawab besar.
Dialogue: 0,0:10:33.86,0:10:37.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika dewa hidup mati di medan perang,
Dialogue: 0,0:10:37.03,0:10:39.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}seluruh Kuil Suwa akan lenyap.
Dialogue: 0,0:10:40.07,0:10:42.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lantaran saya dan Ayah ikut perang,
Dialogue: 0,0:10:42.99,0:10:47.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami harus menyerahkan tugas dewa\Nkepada Yoritsugu yang tak terikat perang.
Dialogue: 0,0:10:48.62,0:10:51.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya. Jadi itu alasannya.
Dialogue: 0,0:10:51.37,0:10:54.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak semuda itu mewarisi takhta dewa.
Dialogue: 0,0:10:55.09,0:10:58.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, Anda benar, Tuan Tokiyuki.
Dialogue: 0,0:10:58.57,0:11:01.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bila dibiarkan, itu akan buruk\Nbagi masa depannya.
Dialogue: 0,0:11:02.47,0:11:05.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin karena terlalu terbebani\Ntugasnya menjadi dewa,
Dialogue: 0,0:11:06.22,0:11:10.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia bersikap baik di hadapan kami,\Ntapi tak mau jujur di depan orang lain.
Dialogue: 0,0:11:11.31,0:11:12.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak itu
Dialogue: 0,0:11:12.90,0:11:16.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menunjukkan isi hatinya pada Anda.
Dialogue: 0,0:11:16.65,0:11:18.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini mungkin sebuah kesempatan.
Dialogue: 0,0:11:19.36,0:11:23.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong selesaikan baik-baik\Npertandingan dengan Yoritsugu!
Dialogue: 0,0:11:23.12,0:11:26.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong jadi temannya untuk bisa jujur!
Dialogue: 0,0:11:26.91,0:11:29.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang tua tidak tanggung jawab!
Dialogue: 0,0:11:30.54,0:11:34.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu, aku juga penyebabnya.
Dialogue: 0,0:11:34.41,0:11:36.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku usahakan agar kami bisa akrab.
Dialogue: 0,0:11:37.42,0:11:40.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertandingan yang dimaksud\Npaling cuma permainan anak-anak.
Dialogue: 0,0:11:40.96,0:11:43.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti ada momen\Nuntuk mencairkan suasana.
Dialogue: 0,0:11:45.97,0:11:47.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lah, kok serius?!
Dialogue: 0,0:11:47.89,0:11:50.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena aku sudah menjadi dewa!
Dialogue: 0,0:11:50.81,0:11:54.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika aku minta, seluruh orang\Ndi Kuil Suwa akan patuh.
Dialogue: 0,0:11:55.73,0:11:58.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berani juga kau datang, Tokiyuki.
Dialogue: 0,0:11:59.24,0:12:01.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertandingannya adalah kejar-kejaran.
Dialogue: 0,0:12:01.15,0:12:03.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau yang jadi iblis.
Dialogue: 0,0:12:03.74,0:12:07.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan pergi\Ndan menyentuh pilar suci di sana.
Dialogue: 0,0:12:07.12,0:12:10.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau tidak bisa\Nmenyentuhku sebelum itu,
Dialogue: 0,0:12:10.37,0:12:11.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku yang menang.
Dialogue: 0,0:12:11.75,0:12:14.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau harus berkemas dan pergi dari sini.
Dialogue: 0,0:12:15.42,0:12:20.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Yoritsugu, aku cuma ingin\Nberteman denganmu.
Dialogue: 0,0:12:20.34,0:12:22.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, kalau kejar-kejaran
Dialogue: 0,0:12:22.88,0:12:26.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sudah pasti lariku lebih kencang.
Dialogue: 0,0:12:26.47,0:12:28.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa takut! Mulai!
Dialogue: 0,0:12:29.43,0:12:32.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar. Apa boleh buat, deh.
Dialogue: 0,0:12:36.57,0:12:38.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Moritaka?!
Dialogue: 0,0:12:39.02,0:12:42.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya tidak tahu permasalahan kalian,\Ntapi mohon maafkan saya, Tuan Tokiyuki.
Dialogue: 0,0:12:42.77,0:12:47.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika tidak menghentikan Anda, saya akan\Ndijatuhi hukuman ilahi oleh Tuan Yoritsugu!
Dialogue: 0,0:12:49.28,0:12:51.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inilah kekuatan dewa hidup!
Dialogue: 0,0:12:52.20,0:12:55.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka semua menuruti kehendakku!
Dialogue: 0,0:12:55.38,0:12:57.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manusia tidak bisa menggapai dewa!
Dialogue: 0,0:12:58.17,0:13:00.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tokiyuki!
Dialogue: 0,0:13:00.88,0:13:02.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dewa...
Dialogue: 0,0:13:03.13,0:13:06.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin sebaiknya\Naku beri pelajaran sedikit.
Dialogue: 0,0:13:28.57,0:13:31.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Muda, bersiaplah!
Dialogue: 0,0:13:45.13,0:13:47.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia kabur ke sana! Hentikan dia!
Dialogue: 0,0:13:58.86,0:14:01.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menghadapi 100 orang itu
Dialogue: 0,0:14:01.86,0:14:03.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bukan masalah!
Dialogue: 0,0:14:04.53,0:14:09.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ingin menghentikan Tokiyuki,\Nkeluarkan panah dan Sadamune!
Dialogue: 0,0:14:12.49,0:14:14.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya memang mustahil.
Dialogue: 0,0:14:15.49,0:14:20.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu-begitu, Tuan Tokiyuki sudah\Nmelewati beberapa perang.
Dialogue: 0,0:14:21.67,0:14:25.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sisi lain, Tuan Yoritsugu\Nbaru sebentar menjadi dewa.
Dialogue: 0,0:14:23.71,0:14:25.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}A-Apa?!
Dialogue: 0,0:14:25.30,0:14:28.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mayoritas yang menuruti perkataannya\Nadalah warga sipil!
Dialogue: 0,0:14:28.63,0:14:30.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin bisa hentikan dia!
Dialogue: 0,0:14:33.93,0:14:36.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin semudah itu!
Dialogue: 0,0:14:36.35,0:14:39.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia menerobos semuanya?!
Dialogue: 0,0:14:41.86,0:14:45.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, tinggal kita berdua, Tuan Yoritsugu!
Dialogue: 0,0:14:45.65,0:14:49.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Seram, seram.\NKenapa malah beringas?
Dialogue: 0,0:14:55.16,0:14:56.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:14:56.41,0:15:00.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak lahir, aku sudah keliling Kuil Suwa.
Dialogue: 0,0:15:00.79,0:15:03.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dibanding kau yang tinggal\Nbelum genap dua tahun,
Dialogue: 0,0:15:03.96,0:15:06.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku lebih paham medan!
Dialogue: 0,0:15:10.01,0:15:11.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan begini...
Dialogue: 0,0:15:11.51,0:15:14.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pasti ambil jalan memutar yang jauh!
Dialogue: 0,0:15:14.14,0:15:17.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pasti sampai ke pilar itu lebih cepat
Dialogue: 0,0:15:17.18,0:15:19.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang menjadi syarat kemenangan!
Dialogue: 0,0:15:30.36,0:15:32.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih jauh dari pilar suci,
Dialogue: 0,0:15:33.49,0:15:36.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa mau dilanjut, Tuan Yoritsugu?
Dialogue: 0,0:15:37.41,0:15:40.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apaan kau ini?
Dialogue: 0,0:15:40.75,0:15:45.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu kau jago kabur,\Ntapi aku tidak tahu kau jago mengejar juga!
Dialogue: 0,0:15:46.67,0:15:50.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatanku seolah bangkit\Nsaat mengejar sambil kabur.
Dialogue: 0,0:15:50.63,0:15:51.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu...
Dialogue: 0,0:15:52.26,0:15:55.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kali ini tidak perlu menyakiti siapa pun,
Dialogue: 0,0:15:55.18,0:15:57.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi aku bisa bergerak bebas\Ndengan senang!
Dialogue: 0,0:15:59.18,0:16:03.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi setelah ini,\Naku akan jadi simbol perang
Dialogue: 0,0:16:03.94,0:16:06.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan asumsi harus melukai orang.
Dialogue: 0,0:16:08.82,0:16:12.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau mengusirku, mungkin peran itu\Nakan dilimpahkan padamu.
Dialogue: 0,0:16:13.28,0:16:17.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita ditakdirkan menjadi\Nsimbol di usia muda,
Dialogue: 0,0:16:17.16,0:16:22.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi menurutku kau boleh menunggu\Nlebih lama untuk melukai orang.
Dialogue: 0,0:16:26.00,0:16:28.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sok!
Dialogue: 0,0:16:28.09,0:16:30.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertandingannya belum berakhir!
Dialogue: 0,0:16:47.90,0:16:49.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Yoritsugu!
Dialogue: 0,0:16:49.86,0:16:51.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesuatu untuk pegangan...
Dialogue: 0,0:16:51.86,0:16:54.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku mencari sekarang,\Nnanti terlambat!
Dialogue: 0,0:16:56.11,0:16:57.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pegang ini!
Dialogue: 0,0:17:05.75,0:17:08.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh!
Dialogue: 0,0:17:08.50,0:17:11.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bodoh! Rambutmu bisa tercabut!
Dialogue: 0,0:17:11.51,0:17:15.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak apa-apa, cepat naik saja!
Dialogue: 0,0:17:15.51,0:17:18.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau rambutmu terpotong,\Nkeilahianmu bisa hilang!
Dialogue: 0,0:17:18.67,0:17:21.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang-orang tidak akan menghormatimu lagi, tahu!
Dialogue: 0,0:17:21.89,0:17:25.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau juga memanjangkan rambut\Ndengan alasan yang sama!
Dialogue: 0,0:17:25.98,0:17:30.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Simbol keilahian cukup dari kamu saja!
Dialogue: 0,0:17:30.40,0:17:33.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu Suwa! Aku Hojo!
Dialogue: 0,0:17:33.74,0:17:40.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada akhirnya, tugasku cuma bertarung!
Dialogue: 0,0:17:40.08,0:17:43.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mohon, cepat!\NLeherku keburu patah!
Dialogue: 0,0:18:00.18,0:18:01.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang bodoh.
Dialogue: 0,0:18:02.14,0:18:05.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau membiarkanku mati,\Ntidak akan ada lagi pengganggu.
Dialogue: 0,0:18:06.35,0:18:09.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin menjadi temanmu.
Dialogue: 0,0:18:09.23,0:18:11.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, Tuan Yorishige bakal sedih.
Dialogue: 0,0:18:16.40,0:18:20.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menganggap\NTuan Yorishige seperti ayahku.
Dialogue: 0,0:18:21.57,0:18:25.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi itu tidak seberapa dibanding\Nikatan darah yang kau miliki.
Dialogue: 0,0:18:29.41,0:18:31.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak kau datang,
Dialogue: 0,0:18:31.83,0:18:36.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakek sering bertemu\Nsamurai Shinano yang tak kukenal.
Dialogue: 0,0:18:37.21,0:18:40.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia makin jarang menemuiku.
Dialogue: 0,0:18:44.39,0:18:47.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, aku tak peduli jadi dewa.
Dialogue: 0,0:18:47.85,0:18:53.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma tak ingin\Nkakekku direbut siapa pun.
Dialogue: 0,0:18:54.86,0:18:56.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:18:56.38,0:18:59.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena dia sibuk dengan\Npersiapan perang besar...
Dialogue: 0,0:19:01.91,0:19:02.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sip!
Dialogue: 0,0:19:02.99,0:19:05.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan padaku, Tuan Yoritsugu!
Dialogue: 0,0:19:07.79,0:19:12.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini-begini, aku tuan\Ndari ayah dan kakekmu.
Dialogue: 0,0:19:12.09,0:19:14.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan egois sesekali!
Dialogue: 0,0:19:16.59,0:19:18.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oleh karena itu, Tuan Yorishige!
Dialogue: 0,0:19:19.09,0:19:22.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama tiga hari ke depan,\Naku perintahkan
Dialogue: 0,0:19:22.76,0:19:25.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tugas memimpin Suwa dikerjakan\Nsendirian oleh Tuan Tokitsugu.
Dialogue: 0,0:19:26.85,0:19:31.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama tiga hari ke depan, aku perintahkan\NTuan Yorishige memanjakan cucumu.
Dialogue: 0,0:19:32.02,0:19:34.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan membuatnya kesepian lagi!
Dialogue: 0,0:19:37.15,0:19:41.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan begini, Tuan Yorishige\Nakan menjadi milikmu selama tiga hari.
Dialogue: 0,0:19:41.02,0:19:43.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minta dimanjakan dia sesukamu.
Dialogue: 0,0:19:44.57,0:19:46.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tokiyuki...
Dialogue: 0,0:19:48.12,0:19:51.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya! Kau kesepian, ya, Yoritsugu!
Dialogue: 0,0:19:51.54,0:19:54.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhir-akhir ini, aku memang\Ntidak memperhatikanmu.
Dialogue: 0,0:19:55.12,0:19:57.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bilang saja dari awal!
Dialogue: 0,0:19:57.59,0:20:01.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menyayangimu\Nsepenuh jiwa dan ragaku!
Dialogue: 0,0:20:01.38,0:20:03.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sruk, sruk.
Dialogue: 0,0:20:04.10,0:20:07.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sruk, sruk, sruk sruk.
Dialogue: 0,0:20:07.02,0:20:08.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sruk, sruk, sruk sruk, sruk, sruk.
Dialogue: 0,0:20:08.98,0:20:10.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sruk, sruk, sruk sruk!
Dialogue: 0,0:20:10.19,0:20:12.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sa-Sakit!
Dialogue: 0,0:20:12.01,0:20:14.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kulit orang tua, tapi sakit.
Dialogue: 0,0:20:15.19,0:20:17.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kulit tua Yorishige
Dialogue: 0,0:20:17.36,0:20:21.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}setara dengan kurang lebih\Nampelas grit 1500.
Dialogue: 0,0:20:21.02,0:20:23.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengusap pipi beberapa menit\Nmemang tidak masalah,
Dialogue: 0,0:20:23.62,0:20:25.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi jika dilanjutkan 3 hari 3 malam,
Dialogue: 0,0:20:25.37,0:20:29.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kulit terkelupas, daging robek,\Ndan tulang terkikis.
Dialogue: 0,0:20:29.33,0:20:33.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yorishige menerima semacam berkat dewa,\Njadi tidak terluka sama sekali.
Dialogue: 0,0:20:34.25,0:20:38.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, aku cuma tidak mau Kakek direbut,
Dialogue: 0,0:20:38.13,0:20:41.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bukan berarti aku suka diusap pipinya!
Dialogue: 0,0:20:41.30,0:20:45.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jujur, aku malah capek\Nkalau harus terus bersamanya!
Dialogue: 0,0:20:46.68,0:20:49.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Ini berlanjut tiga hari?
Dialogue: 0,0:20:50.64,0:20:52.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini perintah Tuan Tokiyuki!
Dialogue: 0,0:20:52.98,0:20:55.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku usap pipimu sejuta kali\Nselama tiga hari!
Dialogue: 0,0:20:55.06,0:20:56.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo!
Dialogue: 0,0:20:56.40,0:20:59.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak!
Dialogue: 0,0:21:05.11,0:21:08.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, Tuan Muda?\NKok terlihat bahagia begitu?
Dialogue: 0,0:21:09.91,0:21:15.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kojirou, rasanya menyenangkan\Nsetelah melakukan hal baik!
Dialogue: 0,0:21:18.71,0:21:22.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tokiyuki, awas kau!
Dialogue: 0,0:21:22.75,0:21:26.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suwa Yoritsugu.\NDia berumur tujuh tahun saat ini.
Dialogue: 0,0:21:26.97,0:21:30.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia menjadi teman baik\NTokiyuki di kemudian hari.
Dialogue: 0,0:21:42.65,0:21:45.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Samurai itu kenapa?
Dialogue: 0,0:21:45.52,0:21:48.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, terlihat sangat termotivasi.
Dialogue: 0,0:21:51.41,0:21:57.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana menjelaskannya, ya?\NSeolah motivasinya tertulis di wajahnya.
Dialogue: 0,0:21:58.25,0:21:59.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah...
Dialogue: 0,0:21:59.96,0:22:03.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa Tokiyuki baik-baik saja?
Dialogue: 0,0:22:06.59,0:22:11.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bila ingin romantis ♪
Dialogue: 0,0:22:11.47,0:22:13.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cintai aku lebih dari siapa pun ♪
Dialogue: 0,0:22:20.06,0:22:23.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kamu orang yang baik ♪
Dialogue: 0,0:22:23.44,0:22:27.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bakal baik ke gadis itu juga, 'kan?♪
Dialogue: 0,0:22:27.20,0:22:30.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa, tidak masalah ♪
Dialogue: 0,0:22:30.53,0:22:34.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong bawakan\Nsemua barang beratnya, ya ♪
Dialogue: 0,0:22:34.25,0:22:37.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu keren di depan orang-orang ♪
Dialogue: 0,0:22:37.42,0:22:41.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kamu imut saat kita berduaan ♪
Dialogue: 0,0:22:41.21,0:22:44.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setia seperti anjing ♪
Dialogue: 0,0:22:44.55,0:22:50.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan menghilang seperti kucing, ya ♪
Dialogue: 0,0:22:51.22,0:22:54.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terkadang aku sedih ♪
Dialogue: 0,0:22:54.72,0:22:58.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi sentimental\Nsaat menatap bintang ♪
Dialogue: 0,0:22:58.31,0:23:05.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini, kamu dengan siapa\Ndan sedang apa?♪
Dialogue: 0,0:23:05.44,0:23:09.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, jika kamu mau\Nmencintai dan dicintai ♪
Dialogue: 0,0:23:09.41,0:23:12.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan selalu membuatmu berdebar ♪
Dialogue: 0,0:23:12.87,0:23:16.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika tidak memilihku ♪
Dialogue: 0,0:23:16.45,0:23:20.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menjatuhkanmu ke neraka ♪
Dialogue: 0,0:23:20.12,0:23:23.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mendengarmu ♪
Dialogue: 0,0:23:23.59,0:23:27.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau tahu lagi ♪
Dialogue: 0,0:23:27.34,0:23:30.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bila ingin romantis ♪
Dialogue: 0,0:23:30.97,0:23:33.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cintai aku lebih dari siapa pun ♪
Dialogue: 0,0:23:38.39,0:23:38.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo!
