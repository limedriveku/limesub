Dialogue: 0,0:23:32.90,0:23:34.98,sign,,0000,0000,0000,,(Tema Lagu Penutup - Bocchiboromaru)
Dialogue: 0,0:23:38.99,0:23:39.99,sign,,0000,0000,0000,,(Episode 20 [Tahun 1335]\NHal yang Tak Tergantikan)
Dialogue: 0,0:00:05.15,0:00:09.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paman Tokiyuki, Hojo Yasuie.
Dialogue: 0,0:00:09.02,0:00:13.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia adalah pria yang akan\Nsegera mendatangkan badai.
Dialogue: 0,0:00:14.33,0:00:18.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paman! Syukurlah kau baik-baik saja!
Dialogue: 0,0:00:18.38,0:00:19.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Tokiyuki juga!
Dialogue: 0,0:00:19.96,0:00:22.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yasuie terharu!
Dialogue: 0,0:00:23.00,0:00:25.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah! Syukurlah!
Dialogue: 0,0:00:23.00,0:00:26.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kaget paman kandungnya masih hidup.
Dialogue: 0,0:00:26.51,0:00:27.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:00:27.76,0:00:31.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Adik kandung Tuan Takatoki,\Npenguasa tertinggi Keshogunan.
Dialogue: 0,0:00:31.89,0:00:36.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ia benar-benar tokoh yang berada\Ndi jantung pemerintahan Keshogunan.
Dialogue: 0,0:00:36.98,0:00:38.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat Kamakura jatuh,
Dialogue: 0,0:00:38.90,0:00:42.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}orang yang mengatur agar\NTuan Tokiyuki dititipkan kepadaku
Dialogue: 0,0:00:42.98,0:00:44.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah Tuan Yasuie.
Dialogue: 0,0:00:46.40,0:00:50.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh iya, bagaimana Paman\Nbisa keluar dari kekacauan itu?
Dialogue: 0,0:00:50.95,0:00:53.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, aku pura-pura jadi prajurit Nitta.
Dialogue: 0,0:00:53.58,0:00:54.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:01:09.30,0:01:10.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Prajurit terluka!
Dialogue: 0,0:01:10.68,0:01:12.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Izin lewat!
Dialogue: 0,0:01:12.43,0:01:14.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Sakit...
Dialogue: 0,0:01:13.43,0:01:15.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pura-pura menjadi prajurit\Nterluka dari pihak musuh
Dialogue: 0,0:01:15.98,0:01:18.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk keluar dari Kamakura.
Dialogue: 0,0:01:18.60,0:01:20.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan hebat sekali.
Dialogue: 0,0:01:20.44,0:01:22.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di tengah gugurnya keluarga\Nsatu per satu,
Dialogue: 0,0:01:22.86,0:01:25.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa-bisanya kabur tanpa malu.
Dialogue: 0,0:01:25.82,0:01:29.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja aku diminta mati\Nbersama mereka juga.
Dialogue: 0,0:01:29.11,0:01:31.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo ikut juga, Tuan Yasuie.
Dialogue: 0,0:01:31.91,0:01:34.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku bilang begini...
Dialogue: 0,0:01:34.78,0:01:37.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak peduli dengan nyawaku,
Dialogue: 0,0:01:37.12,0:01:42.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku pasti akan membalaskan dendam\Nkalian dengan merebut kembali kekuasaan.
Dialogue: 0,0:01:42.34,0:01:43.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jidat...
Dialogue: 0,0:01:43.42,0:01:45.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jidatnya kelihatan.
Dialogue: 0,0:01:45.80,0:01:46.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paman.
Dialogue: 0,0:01:47.17,0:01:50.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terpampang jelas di wajahmu\Nkalau kau tidak mau mati, lo.
Dialogue: 0,0:01:50.18,0:01:53.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ups, Tuan Tokiyuki jeli sekali!
Dialogue: 0,0:01:55.43,0:01:57.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dua tahun ini, aku berkeliling Tohoku,
Dialogue: 0,0:01:57.94,0:02:00.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu mengumpulkan\Nsisa pasukan Hojo dan melawan...
Dialogue: 0,0:02:01.27,0:02:03.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kalah terus, jadi aku kabur.
Dialogue: 0,0:02:04.98,0:02:07.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau adalah harapan terakhir kami.
Dialogue: 0,0:02:07.98,0:02:09.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suwa Yorishige.
Dialogue: 0,0:02:09.74,0:02:12.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah siap untuk menang?
Dialogue: 0,0:02:14.12,0:02:17.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, semuanya berjalan lancar.
Dialogue: 0,0:02:19.95,0:02:22.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku melihat masa depan\Nyang sedikit menarik.
Dialogue: 0,0:02:22.95,0:02:25.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bila tidak keberatan,\Nmari bicarakan di sebelah sana.
Dialogue: 0,0:02:25.92,0:02:28.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, baiklah. Ayo!
Dialogue: 0,0:02:37.31,0:02:39.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berisik! Cepat pergi!
Dialogue: 0,0:02:40.77,0:02:43.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang berisik sampai-sampai\Nterpampang jelas di wajahnya.
Dialogue: 0,0:02:44.32,0:02:48.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari cara kaburnya, sulit dipercaya\Nkalau dia pejabat tinggi Keshogunan.
Dialogue: 0,0:02:48.44,0:02:51.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paman memang licik sejak dulu.
Dialogue: 0,0:02:52.32,0:02:55.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksud tersembunyinya tampak jelas\Nia merencanakan macam-macam,
Dialogue: 0,0:02:56.03,0:02:58.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}terobsesi pada kekuasaan\Ndan nyawanya sendiri,
Dialogue: 0,0:02:58.73,0:03:01.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi semua itu terlihat jelas di wajahnya.
Dialogue: 0,0:03:02.37,0:03:07.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku suka dirinya yang jujur,\Nyang tak ia tutupi di balik topeng samurai.
Dialogue: 0,0:03:03.08,0:03:05.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Main, yuk.
Dialogue: 0,0:03:15.26,0:03:18.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teruslah hidup dan tunggu waktunya♪
Dialogue: 0,0:03:18.22,0:03:23.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jinjing nyawamu dan tembus takdir♪
Dialogue: 0,0:03:23.06,0:03:26.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hiduplah dalam malu\Ndan kejar mimpimu♪
Dialogue: 0,0:03:26.27,0:03:31.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi orang-orang\Nyang percaya padamu♪
Dialogue: 0,0:03:45.00,0:03:48.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagian besar takkan tercatat\Ndalam sejarah♪
Dialogue: 0,0:03:48.25,0:03:51.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua hal konyol itu♪
Dialogue: 0,0:03:51.76,0:03:55.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membelit dan terurai, lagi dan lagi♪
Dialogue: 0,0:03:55.55,0:03:58.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tarik napas♪
Dialogue: 0,0:03:58.60,0:04:02.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk apa hidup ini dipersembahkan?♪
Dialogue: 0,0:04:02.18,0:04:05.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takdir apa yang menanti?♪
Dialogue: 0,0:04:05.56,0:04:08.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bila rasa bak kutukan♪
Dialogue: 0,0:04:08.44,0:04:12.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan bisa mengikatku♪
Dialogue: 0,0:04:12.78,0:04:15.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teruslah hidup dan tunggu waktunya♪
Dialogue: 0,0:04:15.57,0:04:20.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jinjing nyawamu dan lawan takdir♪
Dialogue: 0,0:04:20.45,0:04:23.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hiduplah dalam malu\Ndan kejar mimpimu♪
Dialogue: 0,0:04:23.62,0:04:27.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi orang-orang\Nyang percaya padamu♪
Dialogue: 0,0:04:27.96,0:04:31.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Iblis, sini,\Nikuti suara tepuk tanganku♪
Dialogue: 0,0:04:31.13,0:04:34.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}(Hei, Iblis, sini,\Nikuti suara tepuk tanganku)♪
Dialogue: 0,0:04:34.72,0:04:38.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hidup itu singkat,\Nmenyanyi dan menarilah♪
Dialogue: 0,0:04:38.10,0:04:42.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bunga akan mekar\Nbagi yang jago kabur♪
Dialogue: 0,0:04:47.31,0:04:50.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua aktornya sudah berkumpul.
Dialogue: 0,0:04:50.86,0:04:53.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perang besar sudah di depan mata.
Dialogue: 0,0:04:53.90,0:04:56.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami akan menghadapi bahaya\Nyang lebih besar dari sebelumnya.
Dialogue: 0,0:04:57.11,0:04:59.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bos memang tidak membosankan,
Dialogue: 0,0:04:59.12,0:05:02.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seolah aku tidak bisa bertarung saja!
Dialogue: 0,0:04:59.74,0:05:03.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi memangnya ada alasan sepadan\Nuntuk mempertaruhkan nyawa demi dia?
Dialogue: 0,0:05:03.45,0:05:07.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak seperti Bos, aku tidak punya\Nmusuh untuk balas dendam
Dialogue: 0,0:05:07.46,0:05:08.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau keluarga untuk diselamatkan.
Dialogue: 0,0:05:09.04,0:05:12.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menarik diri sekarang juga pilihan...
Dialogue: 0,0:05:13.46,0:05:16.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, aku pikirkan lagi nanti, deh.
Dialogue: 0,0:05:24.68,0:05:26.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada sesuatu.
Dialogue: 0,0:05:26.35,0:05:27.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa cuma perasaanku?
Dialogue: 0,0:05:27.85,0:05:31.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yorishige melakukan penjagaan\Nketat di area Kuil Suwa.
Dialogue: 0,0:05:31.94,0:05:34.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin ada orang\Nyang bisa masuk dengan mudah.
Dialogue: 0,0:05:36.99,0:05:38.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Se-Senjata lempar?!
Dialogue: 0,0:05:44.70,0:05:45.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh...
Dialogue: 0,0:05:46.45,0:05:48.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemampuan deteksimu lumayan juga.
Dialogue: 0,0:05:48.82,0:05:51.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Topeng... tengu?
Dialogue: 0,0:05:51.87,0:05:54.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Walau tidak ada apa-apanya,\Ntapi tetap layak disebut ninja.
Dialogue: 0,0:05:54.75,0:05:58.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Topeng rubah dari Shinano, Kazama Genba,\Nyang disebut-sebut intel, ya.
Dialogue: 0,0:05:58.75,0:06:01.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, penerusnya?
Dialogue: 0,0:06:01.68,0:06:05.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, terserah yang mana,\Ntoh bakal mati juga.
Dialogue: 0,0:06:05.85,0:06:08.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu! Tenang dulu!
Dialogue: 0,0:06:08.89,0:06:10.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bawa apa-apa sekarang!
Dialogue: 0,0:06:11.13,0:06:13.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, siapa itu Genba?
Dialogue: 0,0:06:13.82,0:06:16.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini cuma topeng untuk festival, tahu.
Dialogue: 0,0:06:16.99,0:06:19.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nih, coba lihat.
Dialogue: 0,0:06:24.53,0:06:26.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bukan teknik, tapi trik.
Dialogue: 0,0:06:27.74,0:06:30.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sana hibur iblis di alam baka.
Dialogue: 0,0:06:35.29,0:06:37.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang bertarung di sana.
Dialogue: 0,0:06:38.21,0:06:40.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memanggil orang lain\Nuntuk melindungi diri, ya?
Dialogue: 0,0:06:41.38,0:06:46.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil kau bisa melindungi\Ntuanmu jika begitu.
Dialogue: 0,0:06:51.35,0:06:53.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kazama Genba.
Dialogue: 0,0:06:53.23,0:06:55.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak sehebat rumor.
Dialogue: 0,0:06:57.90,0:06:58.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Genba!
Dialogue: 0,0:06:58.78,0:07:00.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi suara apa?
Dialogue: 0,0:07:03.20,0:07:05.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus bicara dengan Yorishige.
Dialogue: 0,0:07:05.41,0:07:07.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin situasinya cukup gawat.
Dialogue: 0,0:07:09.16,0:07:11.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah menempatkan penjaga\Ndi tempat yang kau minta.
Dialogue: 0,0:07:11.37,0:07:13.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu khawatir\Nterhadap serangan dan penyadapan.
Dialogue: 0,0:07:14.71,0:07:18.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katakanlah, Genba.\NSiapa yang menyerangmu?
Dialogue: 0,0:07:19.55,0:07:21.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pernah dengar dari Ayah.
Dialogue: 0,0:07:23.34,0:07:25.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelompok ninja langsung dari Ashikaga.
Dialogue: 0,0:07:26.84,0:07:28.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Grup Tengu.
Dialogue: 0,0:07:28.55,0:07:31.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan bela diri secepat kilat\Ndan teknik penyusupan,
Dialogue: 0,0:07:31.23,0:07:33.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mereka bisa mengungkap semua rahasia.
Dialogue: 0,0:07:34.69,0:07:39.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ashikaga Takauji memusnahkan\Npasukan Keshogunan di Kyo
Dialogue: 0,0:07:39.11,0:07:42.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pada tanggal 7 Mei 1333.
Dialogue: 0,0:07:42.94,0:07:46.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keesokan harinya,\Ntanggal 8 Mei, di Provinsi Kozuke.
Dialogue: 0,0:07:47.32,0:07:51.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rekan Takauji, Nitta Yoshisada,\Nmerasa bimbang.
Dialogue: 0,0:07:51.95,0:07:54.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rencananya aku akan\Nmenyerang Kamakura
Dialogue: 0,0:07:54.50,0:07:57.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bersamaan dengan saat\NTuan Takauji merebut Kyo...
Dialogue: 0,0:07:57.70,0:08:00.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku sama sekali tidak tahu\Nsituasi perang di Kyo.
Dialogue: 0,0:08:01.13,0:08:05.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nitta Yoshisada masih belum\Nmengetahui jatuhnya Kyo.
Dialogue: 0,0:08:05.12,0:08:09.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada masa itu, mengirimkan informasi\Ndari Kyo ke Gunma dalam satu hari
Dialogue: 0,0:08:09.01,0:08:10.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah hal mustahil.
Dialogue: 0,0:08:10.93,0:08:13.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika Tuan Takauji dikalahkan,
Dialogue: 0,0:08:13.56,0:08:16.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pasukan kecilku tidak bisa menang\Nmelawan Keshogunan.
Dialogue: 0,0:08:16.48,0:08:18.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa sebaiknya hentikan\Npemberontakan sekarang?
Dialogue: 0,0:08:18.86,0:08:19.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan!
Dialogue: 0,0:08:23.19,0:08:25.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bala bantuan! Sekitar 2.000!
Dialogue: 0,0:08:25.70,0:08:29.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka adalah klan kita\Nyang tinggal di Echigo!
Dialogue: 0,0:08:29.45,0:08:31.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa datang kemari?
Dialogue: 0,0:08:31.20,0:08:34.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku masih merahasiakan\Npemberontakanku dari keluarga...
Dialogue: 0,0:08:34.46,0:08:36.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tengu yang mengabari kami.
Dialogue: 0,0:08:37.41,0:08:38.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tengu?
Dialogue: 0,0:08:38.92,0:08:43.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seorang tengu menjelajahi Echigo\Ndalam satu hari,
Dialogue: 0,0:08:43.01,0:08:47.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ia menyebarkan kabar bahwa Tuan Nitta\Nakan menyerang Kamakura.
Dialogue: 0,0:08:48.30,0:08:51.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh misterius.
Dialogue: 0,0:08:52.51,0:08:56.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biarlah! 2.000 orang cukup untukku!
Dialogue: 0,0:08:57.73,0:09:00.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu ragu lagi\Nmenyerang Kamakura!
Dialogue: 0,0:09:00.61,0:09:02.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maju, Semuanya!
Dialogue: 0,0:09:02.86,0:09:04.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:09:05.36,0:09:12.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitulah Nitta Yoshisada berhasil\Nmenghancurkan Keshogunan Kamakura
Dialogue: 0,0:09:12.16,0:09:15.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang teralihkan perhatiannya\Noleh Takauji.
Dialogue: 0,0:09:16.45,0:09:19.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Episode "Pesan Tengu" inilah
Dialogue: 0,0:09:19.79,0:09:23.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang tercatat dalam "Taiheiki",\Nbuku yang ditulis orang-orang pada masa itu.
Dialogue: 0,0:09:24.09,0:09:27.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mudah saja menganggapnya cerita fiktif,
Dialogue: 0,0:09:27.13,0:09:30.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kudeta serentak Timur-Barat\Npertama dalam sejarah Jepang
Dialogue: 0,0:09:30.80,0:09:34.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak dapat dijelaskan\Nkecuali melibatkan Tengu
Dialogue: 0,0:09:34.84,0:09:38.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan ini menunjukkan peristiwa itu\Nmerupakan misteri bahkan sejak dulu.
Dialogue: 0,0:09:40.10,0:09:43.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Konon, mereka bisa berlari\Nsejauh 100 ri dalam sehari.
Dialogue: 0,0:09:43.86,0:09:47.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka jadi kekuatan besar dalam penggulingan\NKeshogunan melalui perang informasi.
Dialogue: 0,0:09:47.99,0:09:51.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga pernah mendengar\Ncerita tentang topeng tengu.
Dialogue: 0,0:09:51.95,0:09:55.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada sebuah lembaga pendidikan tua\Nbernama Sekolah Ashikaga,
Dialogue: 0,0:09:55.95,0:10:00.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ada desas-desus bahwa di sana ada\Ndepartemen yang melatih ninja terampil.
Dialogue: 0,0:10:00.87,0:10:04.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurut catatan sejarah, orang pertama\Nyang menggunakan istilah "ninja"
Dialogue: 0,0:10:04.46,0:10:08.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah Kou no Moronao,\Npengurus keluarga Ashikaga.
Dialogue: 0,0:10:09.51,0:10:13.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Intinya, perang besar harus dibatalkan.
Dialogue: 0,0:10:13.30,0:10:16.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika tidak, bukti\Npemberontakan akan disita,
Dialogue: 0,0:10:16.31,0:10:19.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}identitas Bos akan terungkap,\Ndan semuanya berakhir.
Dialogue: 0,0:10:22.23,0:10:24.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus melindungi Tuan Tokiyuki.
Dialogue: 0,0:10:27.48,0:10:30.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempo hari, saya melihat\Nmasa depan yang buruk.
Dialogue: 0,0:10:30.91,0:10:35.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Tokiyuki akan mati\Njika tetap tinggal di Suwa.
Dialogue: 0,0:10:35.57,0:10:38.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya melarikan diri sejauh mungkin.
Dialogue: 0,0:10:38.66,0:10:43.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar kata Genba, kita butuh\Nperubahan besar dalam rencana.
Dialogue: 0,0:10:44.67,0:10:48.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anda berkenan dengan\Nusulan itu, Tuan Yasuie?
Dialogue: 0,0:10:49.42,0:10:50.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku terima.
Dialogue: 0,0:10:54.55,0:10:56.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Tokiyuki.
Dialogue: 0,0:10:57.72,0:11:03.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tinggalkan Shinano dan pergilah\Nke Kyo bersama Tuan Yasuie.
Dialogue: 0,0:11:04.06,0:11:05.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kyo?
Dialogue: 0,0:11:05.32,0:11:08.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perang besar dijadwalkan\Nuntuk bulan depan,
Dialogue: 0,0:11:09.00,0:11:11.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku berencana bekerja sama\Ndengan rekanku di Kyo
Dialogue: 0,0:11:11.78,0:11:14.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk melakukan pemberontakan.
Dialogue: 0,0:11:14.40,0:11:16.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bila ikut aku,
Dialogue: 0,0:11:16.58,0:11:20.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita bisa menghindari sepenuhnya\Nkejaran para tengu itu.
Dialogue: 0,0:11:20.37,0:11:22.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pihak musuh pasti tak menyangka
Dialogue: 0,0:11:22.29,0:11:26.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bahwa dua anggota keluarga\Nutama Hojo berada di Kyo.
Dialogue: 0,0:11:26.09,0:11:28.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti mudah membaur\Nkarena banyak orang di sana.
Dialogue: 0,0:11:29.80,0:11:30.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu...
Dialogue: 0,0:11:31.09,0:11:33.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika Tuan Tokiyuki\Ningin menguasai Jepang,
Dialogue: 0,0:11:33.14,0:11:36.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebaiknya Tuan mengunjungi Kyo\Nsetidaknya sekali.
Dialogue: 0,0:11:37.68,0:11:40.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kyo adalah garda terdepan\Ndari beragam budaya.
Dialogue: 0,0:11:41.06,0:11:46.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}SDM berbakat ada di sana, termasuk Kaisar,\NTakauji, Nitta, dan Kusunoki,
Dialogue: 0,0:11:46.15,0:11:49.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}walau mereka adalah musuh kita.
Dialogue: 0,0:11:50.19,0:11:51.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kusunoki?
Dialogue: 0,0:11:52.48,0:11:57.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harusnya minta diajari\Nsoal perang oleh Tuan Kusunoki...
Dialogue: 0,0:11:57.77,0:11:59.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja,
Dialogue: 0,0:11:59.04,0:12:01.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anda tidak boleh bertemu mereka.
Dialogue: 0,0:12:02.04,0:12:05.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manfaat dari atmosfer Kyo\Nyang dipenuhi orang berbakat
Dialogue: 0,0:12:05.13,0:12:06.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pasti tak terhitung nilainya.
Dialogue: 0,0:12:11.13,0:12:13.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin ke Kyo!
Dialogue: 0,0:12:14.88,0:12:18.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, langsung saja\Nberangkat malam ini!
Dialogue: 0,0:12:18.72,0:12:19.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malam ini?!
Dialogue: 0,0:12:19.39,0:12:20.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mendadak sekali!
Dialogue: 0,0:12:20.56,0:12:24.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, kami sudah\Nmengantisipasi situasi seperti ini.
Dialogue: 0,0:12:24.56,0:12:27.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suwa Shinto menggunakan kode rahasia\Nuntuk keadaan darurat
Dialogue: 0,0:12:27.19,0:12:29.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan sudah menjalankan rencana.
Dialogue: 0,0:12:29.98,0:12:31.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa lauk akhir-akhir ini?
Dialogue: 0,0:12:31.97,0:12:33.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Acar nozawana.
Dialogue: 0,0:12:33.65,0:12:36.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Acar nozawana, ya...\NPasti merepotkan.
Dialogue: 0,0:12:36.65,0:12:40.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia adalah pencuri makanan.\NHati-hati jangan sampai gemuk.
Dialogue: 0,0:12:41.20,0:12:44.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ditambah salmon asin juga,\Nnanti tidak bisa berhenti makan.
Dialogue: 0,0:12:47.71,0:12:51.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi bagaimana caranya melarikan\NTuan Muda keluar Shinano?
Dialogue: 0,0:12:51.33,0:12:55.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin Grup Tengu\Nsedang mengawasi Kuil Suwa.
Dialogue: 0,0:12:55.76,0:12:58.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka akan curiga\Nkalau ada anak-anak pergi.
Dialogue: 0,0:12:58.55,0:13:03.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal itu... Kita akan manfaatkan kondisi\Nkacau karena penyusup misterius ini
Dialogue: 0,0:13:03.52,0:13:07.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk melarikan Tuan Muda\Ndan menghancurkan bukti bersamaan.
Dialogue: 0,0:13:07.60,0:13:09.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekurangan dari rencana ini
Dialogue: 0,0:13:09.90,0:13:12.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah tidak ada waktu berpamitan.
Dialogue: 0,0:13:13.15,0:13:14.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kebakaran!
Dialogue: 0,0:13:14.44,0:13:17.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kediaman Tuan Yorishige terbakar!
Dialogue: 0,0:13:17.86,0:13:18.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sumber apinya mana?
Dialogue: 0,0:13:18.95,0:13:21.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya ada sebuah obor jatuh!
Dialogue: 0,0:13:21.32,0:13:22.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial!
Dialogue: 0,0:13:22.45,0:13:26.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menambah obor malam untuk\Nmewaspadai bandit malah jadi petaka?
Dialogue: 0,0:13:27.20,0:13:29.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kirim utusan ke Suwa Shinto tetangga!
Dialogue: 0,0:13:29.79,0:13:32.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita butuh orang untuk\Nmenghentikan apinya menyebar!
Dialogue: 0,0:13:32.34,0:13:33.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:13:35.17,0:13:36.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana menurutmu?
Dialogue: 0,0:13:37.17,0:13:38.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma kecelakaan biasa?
Dialogue: 0,0:13:38.84,0:13:42.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau dibuat seolah kecelakaan untuk\Nmembakar bukti pemberontakan?
Dialogue: 0,0:13:42.81,0:13:44.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum bisa kupastikan sekarang.
Dialogue: 0,0:13:45.18,0:13:47.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan alihkan pandanganmu\Ndari gerakan orang.
Dialogue: 0,0:13:47.35,0:13:48.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:13:48.98,0:13:52.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika disengaja,\Nmaka gerakannya akan cepat.
Dialogue: 0,0:13:53.36,0:13:56.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bila rubah itu tidak mendeteksi kita...
Dialogue: 0,0:14:00.86,0:14:02.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa mengikuti?
Dialogue: 0,0:14:02.24,0:14:02.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa!
Dialogue: 0,0:14:03.19,0:14:07.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akan bertemu pengikutku di depan\Nyang berangkat secara terpisah!
Dialogue: 0,0:14:08.75,0:14:11.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada banyak bahaya juga di Kyo.
Dialogue: 0,0:14:11.46,0:14:15.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengantar pergi dengan masa depan\Nyang tidak pasti selalu buat hatiku sakit.
Dialogue: 0,0:14:16.29,0:14:18.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, di perjalanan ini,
Dialogue: 0,0:14:19.05,0:14:21.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anda pasti akan berkembang lagi.
Dialogue: 0,0:14:22.72,0:14:26.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin melihat anakku tumbuh besar\Ndengan melalui bahaya.
Dialogue: 0,0:14:27.26,0:14:29.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai pengganti orang tua,
Dialogue: 0,0:14:29.10,0:14:32.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}terkadang tegas dan membiarkannya\Nmandiri pun adalah cinta.
Dialogue: 0,0:14:33.06,0:14:35.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pergilah!
Dialogue: 0,0:14:35.36,0:14:38.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan menoleh ke belakang,\NTuan Tokiyuki!
Dialogue: 0,0:14:42.45,0:14:46.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yorishige mengikuti!
Dialogue: 0,0:14:46.45,0:14:48.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau malah ikut juga?!
Dialogue: 0,0:14:48.66,0:14:51.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, aku khawatir\Ndengan Tuan Tokiyuki...
Dialogue: 0,0:14:51.17,0:14:54.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dilihat tengu,\Ntipu muslihat kita jadi terbongkar.
Dialogue: 0,0:14:54.63,0:14:56.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat kembali!
Dialogue: 0,0:14:57.46,0:14:58.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan ekspresi itu!
Dialogue: 0,0:14:58.92,0:15:00.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah, memalukan!
Dialogue: 0,0:15:00.76,0:15:02.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pulang! Cepat!
Dialogue: 0,0:15:03.59,0:15:08.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pulang! Pulang! Pulang!
Dialogue: 0,0:15:08.89,0:15:11.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hiks!
Dialogue: 0,0:15:14.02,0:15:19.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tokiyuki pergi ke Kyo penuh harapan\Npada bulan Juni.
Dialogue: 0,0:15:25.53,0:15:28.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini pos pemeriksaan yang dibangun\Noleh Istana Kekaisaran atau pihak Ashikaga.
Dialogue: 0,0:15:29.03,0:15:31.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemeriksaannya lumayan ketat.
Dialogue: 0,0:15:33.08,0:15:34.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula...
Dialogue: 0,0:15:34.50,0:15:39.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Hojo" tertulis di wajah Tuan Yasuie,\Njadi pasti ketahuan.
Dialogue: 0,0:15:42.01,0:15:43.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ada jalan lain?
Dialogue: 0,0:15:44.24,0:15:47.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang agak memutar,\Ntapi kita harus melewati gunung.
Dialogue: 0,0:15:47.56,0:15:52.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi lerengnya curam, jadi sulit\Nkalau kita tidak meninggalkan kuda.
Dialogue: 0,0:15:53.06,0:15:54.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:15:54.06,0:15:58.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak sudi meninggalkan kuda\Ndan muatanku demi mereka!
Dialogue: 0,0:15:59.19,0:16:03.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku punya ide, tapi butuh\Npersiapan selama setengah hari.
Dialogue: 0,0:16:04.61,0:16:06.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada kota penginapan di depan sana, 'kan?
Dialogue: 0,0:16:06.91,0:16:09.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian habiskan waktu saja di sana.
Dialogue: 0,0:16:09.94,0:16:11.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu kata dia...
Dialogue: 0,0:16:11.69,0:16:13.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau coba ke restoran?
Dialogue: 0,0:16:13.54,0:16:16.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, aku tidak mau\Nbuang-buang uang di sini.
Dialogue: 0,0:16:17.67,0:16:20.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya butuh banyak uang di Kyo!
Dialogue: 0,0:16:20.59,0:16:24.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, 'kan? Katanya ada pakaian\Ndan makanan yang belum pernah kulihat!
Dialogue: 0,0:16:24.72,0:16:28.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama di sana, aku ingin terus\Nmengucapkan "dosue".
Dialogue: 0,0:16:28.68,0:16:32.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Uang saku pemberian Ayah tidak banyak,
Dialogue: 0,0:16:32.06,0:16:34.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi aku harus hati-hati memakainya.
Dialogue: 0,0:16:37.10,0:16:41.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ups, maaf. Ini pasti terlalu\Nmenggiurkan untuk orang miskin.
Dialogue: 0,0:16:41.48,0:16:45.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ge-Ge-Genba, kamu dapat\Nuang sebanyak itu dari mana?
Dialogue: 0,0:16:46.40,0:16:48.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memeras Yorishige.
Dialogue: 0,0:16:48.76,0:16:51.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menemukan ninja musuh\Nadalah sebuah pencapaian besar.
Dialogue: 0,0:16:51.70,0:16:55.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bilang, "Suwa pasti sudah hancur\Nkalau tidak ada aku."
Dialogue: 0,0:16:55.45,0:16:56.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar!
Dialogue: 0,0:16:56.92,0:17:00.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkat kau, rencana perang besar\Ntidak bocor ke musuh
Dialogue: 0,0:17:00.25,0:17:02.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan tuan kita bisa kabur.
Dialogue: 0,0:17:02.42,0:17:04.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pencapaianmu layak\Ndihargai uang sebanyak itu!
Dialogue: 0,0:17:05.05,0:17:07.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku mau tanya sesuatu...
Dialogue: 0,0:17:07.22,0:17:09.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh pinjam uangnya dulu?
Dialogue: 0,0:17:09.10,0:17:11.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Uangku sudah habis sejak lama.
Dialogue: 0,0:17:11.97,0:17:15.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu karena kamu beli camilan remeh\Ndi penginapan sepanjang jalan.
Dialogue: 0,0:17:16.02,0:17:20.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu juga habiskan sendiri\Nbahan makanan yang kita bawa.
Dialogue: 0,0:17:23.73,0:17:26.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, karma.
Dialogue: 0,0:17:27.69,0:17:30.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, kenyang!
Dialogue: 0,0:17:30.56,0:17:35.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak juga foya-foya sementara\Norang miskin cuma bisa melihat.
Dialogue: 0,0:17:36.37,0:17:38.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kasihan si Fubuki.
Dialogue: 0,0:17:38.83,0:17:41.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin tidak cukup,\Ntapi biar kuberikan ke dia.
Dialogue: 0,0:17:41.54,0:17:43.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biarkan saja si dungu itu!
Dialogue: 0,0:17:43.80,0:17:45.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, Fubuki mana?
Dialogue: 0,0:17:45.80,0:17:47.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di hutan bambu sana.
Dialogue: 0,0:17:47.63,0:17:50.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sedang latihan\Nuntuk mengalihkan rasa lapar.
Dialogue: 0,0:17:58.27,0:18:01.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku lapar!
Dialogue: 0,0:18:03.36,0:18:06.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mata kelaparan yang mengerikan\Npadahal cuma melewatkan sekali makan.
Dialogue: 0,0:18:06.78,0:18:09.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia masih menyimpan banyak rahasia.
Dialogue: 0,0:18:14.24,0:18:15.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oi.
Dialogue: 0,0:18:19.25,0:18:21.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ajari aku sebagai ganti makanan itu.
Dialogue: 0,0:18:23.79,0:18:25.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku diberi tahu tengu itu.
Dialogue: 0,0:18:25.92,0:18:29.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemampuan perangku bukan teknik,\Ntapi cuma trik.
Dialogue: 0,0:18:30.80,0:18:32.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku merasa tidak bisa menandinginya.
Dialogue: 0,0:18:32.95,0:18:35.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku merasa ada perbedaan yang signifikan.
Dialogue: 0,0:18:35.89,0:18:38.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutmu, apa perbedaanku dengannya?
Dialogue: 0,0:18:39.89,0:18:43.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, teknik ninja bukanlah keahlianku.
Dialogue: 0,0:18:44.02,0:18:49.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku rasa harus mengembangkan teknik\Nyang mengutamakan daya hancur.
Dialogue: 0,0:18:49.44,0:18:52.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika tidak, kau tidak mengintimidasi.
Dialogue: 0,0:18:52.66,0:18:54.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengintimidasi?
Dialogue: 0,0:18:54.28,0:18:58.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teknikmu memanfaatkan keisengan\Nuntuk mengikat musuh memang ciri khasmu,
Dialogue: 0,0:18:58.53,0:19:00.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi di medan perang\Nyang semuanya siap mati,
Dialogue: 0,0:19:00.96,0:19:03.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}musuh takkan berhenti\Nhanya karena keisengan.
Dialogue: 0,0:19:04.08,0:19:06.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Aku bisa membunuhmu kalau serius."
Dialogue: 0,0:19:06.00,0:19:09.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika intimidasi tersampaikan,\Nkau bisa benar-benar mengikat musuh.
Dialogue: 0,0:19:09.95,0:19:13.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku rasa perbedaan\Nantara teknik dan trik ada di situ.
Dialogue: 0,0:19:13.97,0:19:15.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu.
Dialogue: 0,0:19:15.38,0:19:18.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika aku bisa mengembangkan alat\Nyang mematikan,
Dialogue: 0,0:19:18.81,0:19:21.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku bisa menggertak lawan\Nwalau kusembunyikan, ya?
Dialogue: 0,0:19:21.93,0:19:23.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tepat sekali!
Dialogue: 0,0:19:25.77,0:19:29.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, apa rencana\NTuan Yasuie benar-benar ampuh?
Dialogue: 0,0:19:29.94,0:19:34.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutku tidak mungkin\Nkalau di wajahnya saja tertulis "Hojo".
Dialogue: 0,0:19:34.03,0:19:35.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti bisa!
Dialogue: 0,0:19:35.62,0:19:37.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo berkumpul sekarang.
Dialogue: 0,0:19:37.78,0:19:41.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paman menyuruhku mengotori badan.
Dialogue: 0,0:19:41.12,0:19:44.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Genba, kau pasti dicurigai kalau pakai\Ntopeng rubah. Gantilah ke wajah acak.
Dialogue: 0,0:19:44.58,0:19:47.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong soal intimidasi,\NPaman juga hebat, lo.
Dialogue: 0,0:19:47.55,0:19:50.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak peduli meski isi hatinya\Nterpampang di wajahnya.
Dialogue: 0,0:19:51.38,0:19:54.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akan menerobos paksa\Ndengan intimidasinya!
Dialogue: 0,0:19:54.89,0:19:57.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mohon!
Dialogue: 0,0:19:57.31,0:20:01.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak sampai ke Kyo besok,\Naku bisa mati menyedihkan!
Dialogue: 0,0:20:01.55,0:20:04.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dijanjikan akan dipekerjakan
Dialogue: 0,0:20:04.27,0:20:07.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebagai pelayan Tuan Saionji Kinmune!
Dialogue: 0,0:20:07.23,0:20:09.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak-anak ini sudah kehilangan ibunya,
Dialogue: 0,0:20:09.19,0:20:11.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akhirnya mereka bisa\Nmenikmati hidup enak!
Dialogue: 0,0:20:11.90,0:20:17.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini pekerjaan bagus pertama yang diterima\Noleh samurai desa lusuh seperti aku!
Dialogue: 0,0:20:17.70,0:20:21.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bahkan berutang\Nuntuk beli kuda dan hadiah!
Dialogue: 0,0:20:21.37,0:20:24.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mohon! Aku mohon!
Dialogue: 0,0:20:25.83,0:20:27.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, sudah cukup!
Dialogue: 0,0:20:27.59,0:20:28.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biarkan lewat!
Dialogue: 0,0:20:27.92,0:20:30.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh!
Dialogue: 0,0:20:28.80,0:20:31.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saking menyedihkannya,\Naku jadi ikutan sedih juga!
Dialogue: 0,0:20:31.75,0:20:35.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan mati di jalanan, ya!\NNanti merepotkan!
Dialogue: 0,0:20:35.92,0:20:39.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak!
Dialogue: 0,0:20:41.64,0:20:43.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, beginilah kira-kira.
Dialogue: 0,0:20:44.68,0:20:48.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak makan setengah hari,\Nberkeliling pelosok gunung,
Dialogue: 0,0:20:48.44,0:20:50.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan berubah menjadi\Nsamurai menyedihkan.
Dialogue: 0,0:20:54.78,0:20:57.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa pura-pura\Nmenyedihkan sesaat
Dialogue: 0,0:20:57.62,0:20:59.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk menyembunyikan identitas,\NTuan Tokiyuki.
Dialogue: 0,0:20:59.99,0:21:01.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu karena...
Dialogue: 0,0:21:01.60,0:21:04.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita adalah Hojo penguasa negeri ini!
Dialogue: 0,0:21:08.25,0:21:11.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Konon, Hojo Yasuie, adik penguasa negeri,\Nmenyusup ke Kyo dengan menyamar
Dialogue: 0,0:21:11.75,0:21:16.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebagai samurai kampungan\Nyang pertama kali datang ke ibu kota.
Dialogue: 0,0:21:17.30,0:21:21.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di pusat Keshogunan,\Nada perebutan kekuasaan yang kotor.
Dialogue: 0,0:21:21.47,0:21:24.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat Keshogunan jatuh,\Nia menyelinap kabur.
Dialogue: 0,0:21:24.48,0:21:27.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia memicu pemberontakan\Nke mana pun dia melarikan diri.
Dialogue: 0,0:21:27.31,0:21:32.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, ia menyusup Kyo dan menyusun\Nrencana yang belum pernah ada sebelumnya.
Dialogue: 0,0:21:32.52,0:21:35.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia adalah salah satu ahli\Nstrategi terbaik di zaman ini.
Dialogue: 0,0:21:36.19,0:21:42.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesehatan fisik Tokiyuki lebih mirip\Npamannya daripada ayahnya
Dialogue: 0,0:21:42.04,0:21:45.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang sakit-sakitan dan lesu.
Dialogue: 0,0:21:45.23,0:21:49.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bos dan Tuan makin menarik\Ndi saat genting.
Dialogue: 0,0:21:49.36,0:21:51.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Intimidasi, ya?
Dialogue: 0,0:21:52.46,0:21:55.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kembangkan hal keren juga, deh.
Dialogue: 0,0:21:55.37,0:21:58.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk mempecundangi si tengu itu juga.
Dialogue: 0,0:21:58.38,0:21:59.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo!
Dialogue: 0,0:21:59.30,0:22:01.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kyo sudah di depan mata, Tuan Tokiyuki!
Dialogue: 0,0:22:01.64,0:22:04.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau butuh sosok menyedihkan,\Nserahkan saja padaku!
Dialogue: 0,0:22:06.68,0:22:11.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bila ingin romantis♪
Dialogue: 0,0:22:11.56,0:22:14.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cintai aku lebih dari siapa pun♪
Dialogue: 0,0:22:20.16,0:22:23.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kamu orang yang baik♪
Dialogue: 0,0:22:23.53,0:22:27.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bakal baik ke gadis itu juga, 'kan?♪
Dialogue: 0,0:22:27.29,0:22:30.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa, tidak masalah♪
Dialogue: 0,0:22:30.63,0:22:34.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong bawakan\Nsemua barang beratnya, ya♪
Dialogue: 0,0:22:34.34,0:22:37.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu keren di depan orang-orang♪
Dialogue: 0,0:22:37.51,0:22:41.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kamu imut saat kita berduaan♪
Dialogue: 0,0:22:41.30,0:22:44.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setia seperti anjing♪
Dialogue: 0,0:22:44.64,0:22:50.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan menghilang seperti kucing, ya♪
Dialogue: 0,0:22:51.31,0:22:54.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terkadang aku sedih♪
Dialogue: 0,0:22:54.82,0:22:58.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi sentimental\Nsaat menatap bintang♪
Dialogue: 0,0:22:58.40,0:23:05.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini, kamu dengan siapa\Ndan sedang apa?♪
Dialogue: 0,0:23:05.54,0:23:09.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, jika kamu mau\Nmencintai dan dicintai♪
Dialogue: 0,0:23:09.50,0:23:12.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan selalu membuatmu berdebar♪
Dialogue: 0,0:23:12.96,0:23:16.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika tidak memilihku♪
Dialogue: 0,0:23:16.55,0:23:20.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menjatuhkanmu ke neraka♪
Dialogue: 0,0:23:20.22,0:23:23.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mendengarmu♪
Dialogue: 0,0:23:23.68,0:23:27.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau tahu lagi♪
Dialogue: 0,0:23:27.43,0:23:31.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bila ingin romantis♪
Dialogue: 0,0:23:31.06,0:23:33.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cintai aku lebih dari siapa pun♪
