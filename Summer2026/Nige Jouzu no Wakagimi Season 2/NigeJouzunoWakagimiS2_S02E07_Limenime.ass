Dialogue: 0,0:02:36.81,0:02:39.19,sign,,0000,0000,0000,,(Semangat)
Dialogue: 0,0:02:59.46,0:03:01.87,sign,,0000,0000,0000,,(Berteman dengan bocah figuran itu\Ndan manfaatkan dia)
Dialogue: 0,0:03:01.87,0:03:08.30,sign,,0000,0000,0000,,(Aku lagi bosan. Main, yuk.)
Dialogue: 0,0:03:32.07,0:03:37.49,sign,,0000,0000,0000,,(Tuan Muda Jago Kabur)
Dialogue: 0,0:07:33.52,0:07:37.52,sign,,0000,0000,0000,,(Kyo, 2 tahun yang lalu)
Dialogue: 0,0:07:37.52,0:07:42.45,sign,,0000,0000,0000,,(7 Mei 1333)
Dialogue: 0,0:07:42.45,0:07:47.08,sign,,0000,0000,0000,,(Keesokan harinya, 8 Mei, Provinsi Kozuke)
Dialogue: 0,0:07:57.46,0:08:00.46,sign,,0000,0000,0000,,(Nitta Yoshisada)
Dialogue: 0,0:09:21.63,0:09:23.67,sign,,0000,0000,0000,,(Tengu)
Dialogue: 0,0:11:08.74,0:11:14.24,sign,,0000,0000,0000,,(Semangat)
Dialogue: 0,0:11:28.96,0:11:30.67,sign,,0000,0000,0000,,(Semangat)
Dialogue: 0,0:12:44.16,0:12:47.54,sign,,0000,0000,0000,,(Sadamune mengumpulkan pasukan.\NHarus waspada jika Ichikawa bergabung juga.)
Dialogue: 0,0:15:04.18,0:15:08.89,sign,,0000,0000,0000,,(Pulang!)
Dialogue: 0,0:15:34.38,0:15:40.84,sign,,0000,0000,0000,,(Hojo)
Dialogue: 0,0:16:20.30,0:16:28.10,sign,,0000,0000,0000,,(Sudah dalam mode turis Kyo)
Dialogue: 0,0:19:54.89,0:20:01.39,sign,,0000,0000,0000,,(Kasihan)
Dialogue: 0,0:20:11.90,0:20:20.66,sign,,0000,0000,0000,,(Kasihan)
Dialogue: 0,0:20:38.18,0:20:39.64,sign,,0000,0000,0000,,(Berhasil)
