Dialogue: 0,0:00:05.27,0:00:08.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teruslah hidup dan tunggu waktunya ♪
Dialogue: 0,0:00:08.24,0:00:13.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jinjing nyawamu dan tembus takdir ♪
Dialogue: 0,0:00:13.08,0:00:16.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hiduplah dalam malu\Ndan kejar mimpimu ♪
Dialogue: 0,0:00:16.29,0:00:21.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi orang-orang\Nyang percaya padamu ♪
Dialogue: 0,0:00:35.01,0:00:38.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagian besar takkan tercatat\Ndalam sejarah ♪
Dialogue: 0,0:00:38.27,0:00:41.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua hal konyol itu ♪
Dialogue: 0,0:00:41.77,0:00:45.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membelit dan terurai, lagi dan lagi ♪
Dialogue: 0,0:00:45.57,0:00:48.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tarik napas ♪
Dialogue: 0,0:00:48.86,0:00:52.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk apa hidup ini dipersembahkan?♪
Dialogue: 0,0:00:52.20,0:00:55.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takdir apa yang menanti?♪
Dialogue: 0,0:00:55.58,0:00:58.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bila rasa bak kutukan ♪
Dialogue: 0,0:00:58.45,0:01:02.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan bisa mengikatku ♪
Dialogue: 0,0:01:02.79,0:01:05.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teruslah hidup dan tunggu waktunya ♪
Dialogue: 0,0:01:05.67,0:01:10.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jinjing nyawamu dan tembus takdir ♪
Dialogue: 0,0:01:10.47,0:01:13.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hiduplah dalam malu\Ndan kejar mimpimu ♪
Dialogue: 0,0:01:13.64,0:01:17.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi orang-orang\Nyang percaya padamu ♪
Dialogue: 0,0:01:17.97,0:01:21.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei Iblis sini, ikuti suara tepuk tanganku ♪
Dialogue: 0,0:01:21.31,0:01:24.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}(Hei Iblis sini, ikuti suara tepuk tanganku)♪
Dialogue: 0,0:01:24.73,0:01:28.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hidup itu singkat,\Nmenyanyi dan menarilah ♪
Dialogue: 0,0:01:28.11,0:01:32.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bunga akan mekar\Nbagi yang jago kabur ♪
Dialogue: 0,0:01:36.91,0:01:38.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemirsa.
Dialogue: 0,0:01:38.37,0:01:40.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini kami persembahkan
Dialogue: 0,0:01:40.94,0:01:46.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}cerita tentang tuan muda\Nyang jago kabur.
Dialogue: 0,0:01:48.83,0:01:52.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini cerita dari tahun 1333 Masehi.
Dialogue: 0,0:01:53.05,0:01:56.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keshogunan Kamakura yang menetapkan\Nsistem pemerintahan samurai,
Dialogue: 0,0:01:56.25,0:02:00.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}telah dihancurkan oleh pemberontak\Nyang dipimpin Ashikaga Takauji.
Dialogue: 0,0:02:00.56,0:02:03.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pewaris sah yang kehilangan semuanya,
Dialogue: 0,0:02:03.35,0:02:08.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hojo Tokiyuki dipandu pendeta bernama\NSuwa Yorishige melarikan diri ke Suwa.
Dialogue: 0,0:02:08.82,0:02:13.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersama rekan-rekannya, mereka membangun\Nkekuatan untuk merebut kembali Kamakura.
Dialogue: 0,0:02:15.19,0:02:17.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu tahun pun berlalu.
Dialogue: 0,0:02:18.20,0:02:22.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ia terjun ke pertarungan pertamanya\Ndi Shinano Utara, Kawanakajima.
Dialogue: 0,0:02:22.87,0:02:27.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tokiyuki membulatkan tekadnya\Nmenghadapi zaman penuh gejolak ini
Dialogue: 0,0:02:27.17,0:02:29.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan kabur dan bertahan hidup.
Dialogue: 0,0:02:30.88,0:02:35.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kejar-kejaran untuk merebut\Nkembali kekuasaan
Dialogue: 0,0:02:35.13,0:02:36.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan berakhir seperti apa?
Dialogue: 0,0:02:36.84,0:02:38.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takdir apa yang menanti Tokiyuki?
Dialogue: 0,0:02:38.85,0:02:41.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemirsa, jangan lewatkan\Ncerita selanjutnya!
Dialogue: 0,0:02:44.06,0:02:47.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berjaga itu membosankan.
Dialogue: 0,0:02:47.06,0:02:49.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya, sisa pasukan Hojo\Nyang melarikan diri dari Kamakura
Dialogue: 0,0:02:49.94,0:02:52.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}memberontak di berbagai tempat.
Dialogue: 0,0:02:52.23,0:02:54.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin mereka sembunyi\Ndi sekitar sini juga.
Dialogue: 0,0:02:54.94,0:02:59.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kabarnya mereka nyaris terbantai\Nkarena tidak berkoordinasi dengan baik.
Dialogue: 0,0:02:59.62,0:03:03.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin orang Hojo\Nmasih hidup di dunia ini.
Dialogue: 0,0:03:04.66,0:03:06.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka!
Dialogue: 0,0:03:06.29,0:03:08.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kembali lagi!
Dialogue: 0,0:03:10.75,0:03:13.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakanda, belalangnya enak?
Dialogue: 0,0:03:13.28,0:03:14.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah terbiasa.
Dialogue: 0,0:03:14.59,0:03:17.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bikin ingat udang sakura\Ndari Teluk Suruga.
Dialogue: 0,0:03:20.14,0:03:24.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, saya ingin tahu seperti apa\Nmakanan Tuan di Kamakura.
Dialogue: 0,0:03:24.51,0:03:27.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pastinya sangat mewah.
Dialogue: 0,0:03:27.35,0:03:31.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sajian mewah yang\Nbelum pernah kulihat...
Dialogue: 0,0:03:31.31,0:03:32.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak juga, kok.
Dialogue: 0,0:03:32.90,0:03:35.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biasanya kurang lebih\Nsama dengan yang lain.
Dialogue: 0,0:03:36.65,0:03:37.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya saja...
Dialogue: 0,0:03:37.94,0:03:40.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang aku suka itu... kakap merah.
Dialogue: 0,0:03:40.45,0:03:41.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakap merah?
Dialogue: 0,0:03:41.49,0:03:43.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamakura dekat dengan laut,
Dialogue: 0,0:03:43.66,0:03:47.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ikan yang ditangkap di Yuigahama pagi hari\Nakan disajikan saat makan siang.
Dialogue: 0,0:03:47.50,0:03:52.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami makan kakap merah yang diiris tipis\Ndengan wasabi Izu dan siraman pasta hishio.
Dialogue: 0,0:03:52.54,0:03:56.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dagingnya yang segar\Ndan renyah bikin ketagihan.
Dialogue: 0,0:03:57.00,0:03:59.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau makan itu lagi.
Dialogue: 0,0:04:01.63,0:04:04.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si Bos enggak semangat, ya.
Dialogue: 0,0:04:04.89,0:04:07.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pasti rindu dengan Kamakura.
Dialogue: 0,0:04:07.76,0:04:11.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Andai ada yang bisa\Nkita lakukan untuknya.
Dialogue: 0,0:04:13.35,0:04:15.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau makan kakap merah!
Dialogue: 0,0:04:17.64,0:04:20.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakap merah...
Dialogue: 0,0:04:21.45,0:04:24.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang renyah!
Dialogue: 0,0:04:24.99,0:04:27.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini Shinano, tahu!
Dialogue: 0,0:04:27.08,0:04:30.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana bisa bawa\Nkakap merah segar ke sini...
Dialogue: 0,0:04:30.96,0:04:32.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Muda?
Dialogue: 0,0:04:39.34,0:04:42.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Musim panas kedua\Nsetelah Kamakura hancur.
Dialogue: 0,0:04:42.39,0:04:44.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dilihat dari Suwa, rumah keduaku,
Dialogue: 0,0:04:44.59,0:04:48.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}rumah pertamaku ada\Ndi seberang kiri Gunung Fuji.
Dialogue: 0,0:04:48.68,0:04:52.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin pulang ke Kamakura.
Dialogue: 0,0:04:54.73,0:04:56.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakap merah...
Dialogue: 0,0:04:57.90,0:05:00.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maju!
Dialogue: 0,0:05:00.86,0:05:03.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhenti! Ini wilayah keluarga Takeda!
Dialogue: 0,0:05:03.44,0:05:06.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berisik! Tidak ada waktu lagi!\NMinggir!
Dialogue: 0,0:05:06.74,0:05:08.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lautnya kelihatan!
Dialogue: 0,0:05:09.74,0:05:12.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Genba dan aku ke timur.
Dialogue: 0,0:05:12.03,0:05:14.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayako tolong ke barat!
Dialogue: 0,0:05:14.29,0:05:15.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke!
Dialogue: 0,0:05:15.71,0:05:18.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kojirou dan Fubuki ambil es!
Dialogue: 0,0:05:18.13,0:05:21.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Segera kubur esnya untuk\Nmemperlambat esnya mencair!
Dialogue: 0,0:05:21.01,0:05:22.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, siap!
Dialogue: 0,0:05:22.13,0:05:24.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bertemu di sini lagi!
Dialogue: 0,0:05:24.68,0:05:28.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka akan kembali ke sini lagi\Nbesok setelah matahari terbit.
Dialogue: 0,0:05:28.30,0:05:32.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus berlatih agar bisa membunuh\Nmangsa pada waktu yang tepat.
Dialogue: 0,0:05:34.48,0:05:37.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kojirou, ayo main berkuda jauh!
Dialogue: 0,0:05:38.23,0:05:40.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon maaf, Tuan Muda.
Dialogue: 0,0:05:40.82,0:05:44.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kojirou tidak di rumah untuk\Nbeberapa hari karena ada urusan.
Dialogue: 0,0:05:44.20,0:05:45.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:05:46.78,0:05:48.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shizuku!
Dialogue: 0,0:05:49.99,0:05:51.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayako!
Dialogue: 0,0:05:53.04,0:05:55.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cih, tidak ada siapa-siapa.
Dialogue: 0,0:05:56.87,0:05:59.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada Yorishige!
Dialogue: 0,0:05:59.59,0:06:02.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini kita berlatih seruling!
Dialogue: 0,0:06:14.43,0:06:15.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kena!
Dialogue: 0,0:06:16.56,0:06:18.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang lain masih belum datang?
Dialogue: 0,0:06:20.65,0:06:21.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu mereka!
Dialogue: 0,0:06:21.57,0:06:22.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang!
Dialogue: 0,0:06:24.11,0:06:25.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia ke sana, Kojirou!
Dialogue: 0,0:06:25.32,0:06:25.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:06:25.82,0:06:28.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesegaran ikan akan turun\Nkalau meronta-ronta di tanah.
Dialogue: 0,0:06:29.16,0:06:32.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku potong otak\Ndan arterinya di udara!
Dialogue: 0,0:06:35.33,0:06:37.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tangkapan bagus!
Dialogue: 0,0:06:37.75,0:06:39.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wasabi Izu-nya?
Dialogue: 0,0:06:39.13,0:06:40.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah beli yang baru dipetik!
Dialogue: 0,0:06:40.50,0:06:41.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sip, ayo pulang!
Dialogue: 0,0:06:41.80,0:06:43.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tak boleh\Nbuang-buang waktu di sini!
Dialogue: 0,0:06:44.08,0:06:46.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keluarkan darah, insang,\Ndan organ dalamnya.
Dialogue: 0,0:06:46.39,0:06:49.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bungkus dengan kain dan masukkan\Nke dalam es agar tidak basah.
Dialogue: 0,0:06:50.97,0:06:53.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oi, tidak ada jalannya!
Dialogue: 0,0:06:57.31,0:06:59.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat! Sekarang malah sungainya!
Dialogue: 0,0:06:59.23,0:07:01.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Uwargh!
Dialogue: 0,0:07:02.56,0:07:03.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ciat!
Dialogue: 0,0:07:03.99,0:07:07.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita buat jalan!\NPokoknya cari jalan pintas!
Dialogue: 0,0:07:07.36,0:07:09.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di zaman tidak ada kereta dan mobil,
Dialogue: 0,0:07:09.78,0:07:13.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jalur darat untuk mengangkut\Nikan laut segar tanpa membusuk
Dialogue: 0,0:07:13.54,0:07:15.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}disebut "Jalur Uojiri".
Dialogue: 0,0:07:15.21,0:07:18.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari Samudra Pasifik, jalur menuju\NKofu adalah Jalur Uojiri.
Dialogue: 0,0:07:18.83,0:07:22.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika dibawa sampai ke Suwa,\Nikan laut akan busuk dan tak bisa dimakan.
Dialogue: 0,0:07:22.59,0:07:23.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan kata lain...
Dialogue: 0,0:07:23.42,0:07:24.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka!
Dialogue: 0,0:07:24.58,0:07:26.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kembali lagi!
Dialogue: 0,0:07:26.55,0:07:29.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka harus membawa kakap merah segar\Njauh-jauh ke Suwa di musim panas yang terik.
Dialogue: 0,0:07:30.12,0:07:31.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kali ini akan kubunuh!
Dialogue: 0,0:07:35.89,0:07:38.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini misi yang nyaris mustahil.
Dialogue: 0,0:07:45.48,0:07:48.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami pulang.\NKami pergi memancing sebentar.
Dialogue: 0,0:07:48.99,0:07:51.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serunya!
Dialogue: 0,0:07:51.24,0:07:52.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian baik-baik saja?!
Dialogue: 0,0:07:52.74,0:07:55.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bukan memancing,\Ntapi habis berperang!
Dialogue: 0,0:07:55.20,0:07:57.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ikan zaman sekarang\Nbisa menembakkan panah?
Dialogue: 0,0:07:57.92,0:07:59.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakanda.
Dialogue: 0,0:07:59.58,0:08:03.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku buatkan makan malam,\Nwalau agak terlalu cepat.
Dialogue: 0,0:08:03.58,0:08:04.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan.
Dialogue: 0,0:08:04.96,0:08:06.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo masuk ke dalam.
Dialogue: 0,0:08:19.48,0:08:23.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa asal comot?\NItu jatahku!
Dialogue: 0,0:08:23.35,0:08:26.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, maaf.\NSoalnya makanmu lama.
Dialogue: 0,0:08:26.90,0:08:28.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku simpan untuk nanti!
Dialogue: 0,0:08:28.99,0:08:31.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kan tahu aku suka kakap merah!
Dialogue: 0,0:08:31.49,0:08:34.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iyakah? Kalau begitu...
Dialogue: 0,0:08:34.40,0:08:35.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nih.
Dialogue: 0,0:08:35.95,0:08:37.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Umbi teratai?
Dialogue: 0,0:08:37.33,0:08:39.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu saja yang tidak suka!
Dialogue: 0,0:08:39.37,0:08:43.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kembalikan kakap merahku!
Dialogue: 0,0:08:44.46,0:08:46.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bercanda.
Dialogue: 0,0:08:46.69,0:08:47.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nih.
Dialogue: 0,0:08:47.80,0:08:49.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah, 'kan?
Dialogue: 0,0:08:49.46,0:08:51.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Sebanyak ini?
Dialogue: 0,0:08:51.34,0:08:53.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah kenyang.
Dialogue: 0,0:08:57.39,0:09:00.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebai banget sampai nangis.
Dialogue: 0,0:09:05.81,0:09:09.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si Bos sampai nangis bahagia.
Dialogue: 0,0:09:09.28,0:09:12.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakap merah seenak itu, ya.
Dialogue: 0,0:09:12.66,0:09:13.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian...
Dialogue: 0,0:09:16.70,0:09:21.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih. Kalian sampai jauh-jauh\Nke laut untuk memancingnya, ya.
Dialogue: 0,0:09:21.15,0:09:23.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus balas apa?
Dialogue: 0,0:09:23.96,0:09:26.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, berapa waktu tempuh ke Kamakura?
Dialogue: 0,0:09:27.63,0:09:30.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cukup satu hari\Ndengan kelompok kecil ini.
Dialogue: 0,0:09:30.47,0:09:34.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Klan Takeda yang bersekutu dengan Takauji\Ntelah membangun banyak benteng baru.
Dialogue: 0,0:09:35.18,0:09:38.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk menembus pasukan sebesar itu\Nbutuh waktu 20 kali lebih lama
Dialogue: 0,0:09:38.31,0:09:40.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan banyak pengorbanan.
Dialogue: 0,0:09:41.02,0:09:43.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus dalam pengintaianmu.
Dialogue: 0,0:09:43.63,0:09:47.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya menyerang Kamakura\Nlewat rute terpendek memang sulit.
Dialogue: 0,0:09:47.98,0:09:49.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamakura...
Dialogue: 0,0:09:50.73,0:09:52.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian ke sana?
Dialogue: 0,0:09:52.20,0:09:54.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perebutan kembali Kamakura.
Dialogue: 0,0:09:54.32,0:09:57.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah waktunya merancang\Nrencana yang detail.
Dialogue: 0,0:10:00.87,0:10:03.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shizuku, bagaimana kondisi Kamakura?
Dialogue: 0,0:10:03.87,0:10:07.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempat itu berubah mengerikan.
Dialogue: 0,0:10:08.38,0:10:12.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lewat tangan penguasa baru\Ndan pasukan elite yang ia kumpulkan...
Dialogue: 0,0:10:13.13,0:10:17.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamakura sedang ramai\Nmembicarakan para pendekar muda ini.
Dialogue: 0,0:10:17.05,0:10:22.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka pasti menjadi penghalang dalam\Npertempuran merebut kembali wilayah itu.
Dialogue: 0,0:10:22.27,0:10:23.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menarik.
Dialogue: 0,0:10:23.76,0:10:27.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lawan kita om-om melulu,\Njadi itu tampak menyegarkan, ya.
Dialogue: 0,0:10:27.11,0:10:30.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita adakan pertarungan megah\Nantara generasi penerus!
Dialogue: 0,0:10:30.56,0:10:32.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kira-kira begitu.
Dialogue: 0,0:10:32.49,0:10:35.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana menurut Anda,\NTuan Tokiyuki?
Dialogue: 0,0:10:35.36,0:10:39.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal muda, aku takkan kalah.\NAku saja masih sembilan tahun.
Dialogue: 0,0:10:40.28,0:10:41.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu...
Dialogue: 0,0:10:42.45,0:10:46.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perasaan cintaku ke Kamakura\Ntakkan kalah dari orang kuat mana pun.
Dialogue: 0,0:10:47.16,0:10:51.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pasti akan\Nmerebut kembali Kamakura!
Dialogue: 0,0:10:52.80,0:10:58.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penguasa Kamakura jauh lebih muda\Ndibanding saat era Hojo.
Dialogue: 0,0:10:58.35,0:11:02.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ashikaga Tadayoshi ditugaskan\Nke Kamakura yang bobrok
Dialogue: 0,0:11:02.18,0:11:05.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk memajukan rekonstruksi kota\Nsekaligus menjaga ketertiban umum.
Dialogue: 0,0:11:05.23,0:11:10.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Organisasi yang dibentuk sebagai kaki tangan\Nmereka bernama Pelindung Kanto.
Dialogue: 0,0:11:10.19,0:11:12.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Rawr!
Dialogue: 0,0:11:10.44,0:11:14.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengikut setia yang berpengalaman tinggal\Ndi sisi Takauji yang berada di Kyoto,
Dialogue: 0,0:11:12.15,0:11:14.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Tidak!
Dialogue: 0,0:11:14.19,0:11:16.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kelompok ini terdiri dari\Nanak-anak muda berprestasi
Dialogue: 0,0:11:15.48,0:11:17.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Rawr!
Dialogue: 0,0:11:16.45,0:11:19.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang menopang masa depan\Nkeluarga Ashikaga.
Dialogue: 0,0:11:17.66,0:11:19.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Tidak!
Dialogue: 0,0:11:19.57,0:11:26.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}(Shibukawa Yoshisue [20]\NPelindung Kanto - Pemimpin Kelompok 1)
Dialogue: 0,0:11:19.77,0:11:21.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memuakkan.
Dialogue: 0,0:11:21.70,0:11:24.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti ada juga\Nyang berutang budi ke Hojo.
Dialogue: 0,0:11:24.27,0:11:26.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teriak-teriak tidak tahu malu.
Dialogue: 0,0:11:26.25,0:11:32.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}(Iwamatsu Tsuneie [?]\NPelindung Kanto - Pemimpin Kelompok 2)
Dialogue: 0,0:11:26.41,0:11:29.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan mengatakan hal menyedihkan begitu,\NTuan Shibukawa.
Dialogue: 0,0:11:29.58,0:11:32.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ombak bagus dan wanita cantik\Nharus dimanfaatkan baik-baik.
Dialogue: 0,0:11:32.96,0:11:39.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}(Uesugi Noriaki [28]\NPelindung Kanto - Wakil Pemimpin Kelompok 2)
Dialogue: 0,0:11:33.12,0:11:36.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, menakutkan sekali, Tuan Iwamatsu.
Dialogue: 0,0:11:36.09,0:11:39.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bicara soal wanita di hadapan Tuan Tadayoshi\Nyang rewel soal moralitas.
Dialogue: 0,0:11:39.97,0:11:46.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}(Shiba Magojiro [13]\NPelindung Kanto - Yoriki)
Dialogue: 0,0:11:40.26,0:11:43.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Tadayoshi\Nsudah tidak kaku lagi, kok.
Dialogue: 0,0:11:43.81,0:11:46.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia membebaskanku pakai apa saja.
Dialogue: 0,0:11:46.30,0:11:48.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, dia masih kaku.
Dialogue: 0,0:11:48.31,0:11:49.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih, toh?
Dialogue: 0,0:11:50.02,0:11:53.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika ini Kyoto, kita harus lebih ketat\Nsoal perilaku dan pakaian.
Dialogue: 0,0:11:54.31,0:11:56.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi Kamakura saat ini berbeda.
Dialogue: 0,0:11:56.89,0:12:00.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hojo telah musnah dan pemerintahan\NNitta setelahnya juga gagal.
Dialogue: 0,0:12:00.70,0:12:04.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rakyat tidak lagi tahu\Npenguasa mana yang benar.
Dialogue: 0,0:12:04.79,0:12:08.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang dibutuhkan Kamakura saat ini\Nadalah kaum muda dan semangat juang.
Dialogue: 0,0:12:09.41,0:12:11.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bawakan angin segar baru
Dialogue: 0,0:12:11.92,0:12:14.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk menggaet hati rakyat\Nyang hatinya lelah.
Dialogue: 0,0:12:15.67,0:12:17.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rakyat Kamakura!
Dialogue: 0,0:12:17.49,0:12:22.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kedamaian kalian akan dilindungi\Noleh Ashikaga dan Pelindung Kanto!
Dialogue: 0,0:12:22.84,0:12:26.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jayalah Kamakura!
Dialogue: 0,0:12:27.56,0:12:30.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, antusiasmenya luar biasa!
Dialogue: 0,0:12:30.19,0:12:33.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Handuk Ashikaga juga sedang laku keras.
Dialogue: 0,0:12:33.65,0:12:35.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di stan Pelindung Kanto.
Dialogue: 0,0:12:37.36,0:12:41.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, menakutkan sekali.\NDua bersaudara yang menakutkan.
Dialogue: 0,0:12:41.86,0:12:45.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Takauji memikat orang\Ndengan pesonanya,
Dialogue: 0,0:12:45.12,0:12:48.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sementara Tuan Tadayoshi menarik\Nperhatian melalui perhitungan.
Dialogue: 0,0:12:48.25,0:12:53.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka dapat mencapai hasil yang sama persis\Ndengan cara yang sepenuhnya berbeda.
Dialogue: 0,0:12:53.54,0:12:55.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ashikaga Tadayoshi!
Dialogue: 0,0:12:56.92,0:12:59.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku penggal kepalamu!
Dialogue: 0,0:13:00.55,0:13:02.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Honma dan Shibuya, ya?
Dialogue: 0,0:13:02.84,0:13:07.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak lupa dengan kesetiaan pada Hojo\Ndan maju balas dendam, sungguh mulia.
Dialogue: 0,0:13:13.06,0:13:15.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, ada yang datang lagi.
Dialogue: 0,0:13:15.31,0:13:16.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya...
Dialogue: 0,0:13:16.73,0:13:18.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alah, cuma 50 orang.
Dialogue: 0,0:13:18.86,0:13:21.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, mungkin bala bantuan akan datang.
Dialogue: 0,0:13:21.55,0:13:23.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia membunyikan lonceng di awal, 'kan?
Dialogue: 0,0:13:23.87,0:13:27.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak butuh suara sebesar itu\Nuntuk jumlah sebanyak ini.
Dialogue: 0,0:13:28.03,0:13:31.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka menyembunyikan samurai berzirah\Ndi pinggiran kota yang agak jauh,
Dialogue: 0,0:13:31.41,0:13:34.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu mereka akan dipanggil\Nkalau percobaan pembunuhannya gagal.
Dialogue: 0,0:13:34.45,0:13:38.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bunyi lonceng terdengar ke Kobukurozaka,\Ntempat menyembunyikan pasukan.
Dialogue: 0,0:13:38.71,0:13:42.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah menduga ini akan terjadi,\Njadi aku gali parit agar bisa mencegat di sana.
Dialogue: 0,0:13:43.13,0:13:44.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:13:44.63,0:13:48.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dan Tuan Iwamatsu\Nyang akan menghabisi musuh di sana.
Dialogue: 0,0:13:48.01,0:13:49.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yey, yey.
Dialogue: 0,0:13:49.41,0:13:52.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, biar kuurus\Nmusuh yang ada di depan.
Dialogue: 0,0:13:52.98,0:13:56.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena berasal dari keluarga bangsawan\Nistana hingga zaman kakeknya,
Dialogue: 0,0:13:56.06,0:13:59.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia selalu ketakutan jadi dia selalu\Nmembawa banyak pengikut bersenjata.
Dialogue: 0,0:13:59.81,0:14:03.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, menakutkan.
Dialogue: 0,0:14:03.61,0:14:05.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus.
Dialogue: 0,0:14:05.24,0:14:08.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menyelesaikan urusan\Npemerintahan di sini.
Dialogue: 0,0:14:08.03,0:14:10.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan terlalu berisik.
Dialogue: 0,0:14:10.37,0:14:11.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:14:12.33,0:14:15.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak kapan mereka membuat ini?
Dialogue: 0,0:14:15.08,0:14:18.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumpulkan pasukan! Kita memutar\Ndan menyeberang jembatan!
Dialogue: 0,0:14:19.00,0:14:20.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu...
Dialogue: 0,0:14:23.88,0:14:26.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shibukawa dan Iwamatsu!
Dialogue: 0,0:14:26.05,0:14:28.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa malah mereka\Nyang ada di sini?!
Dialogue: 0,0:14:30.72,0:14:34.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenanglah! Menyerang\Ndari jarak sejauh ini...
Dialogue: 0,0:14:38.23,0:14:42.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana bisa kena dari sejauh itu...
Dialogue: 0,0:14:42.24,0:14:44.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini terlalu berat sebelah.\NMembosankan!
Dialogue: 0,0:14:44.82,0:14:47.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo menyeberang jembatan,\NTuan Iwamatsu.
Dialogue: 0,0:14:47.07,0:14:48.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap.
Dialogue: 0,0:14:50.99,0:14:52.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, menakutkan.
Dialogue: 0,0:14:53.00,0:14:57.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kasihan pada lawan\Ndari Tuan Shibukawa dan Tuan Iwamatsu.
Dialogue: 0,0:14:57.04,0:14:59.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya mereka berdua monster.
Dialogue: 0,0:15:00.00,0:15:04.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi menurutku, Tuan Tadayoshi\Nyang paling mengerikan.
Dialogue: 0,0:15:04.65,0:15:05.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat itu.
Dialogue: 0,0:15:08.59,0:15:11.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia duduk di tempat\Nyang tidak terjangkau panah.
Dialogue: 0,0:15:12.22,0:15:14.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerusuhan di Otawa-sho\Nmasih belum terselesaikan?
Dialogue: 0,0:15:14.94,0:15:17.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengaruh Tuan Yoshiyuki\Nsangat kuat...
Dialogue: 0,0:15:17.69,0:15:21.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rokuzaemon adalah penjilat.\NKirim pasukan dan intimidasi dia.
Dialogue: 0,0:15:22.48,0:15:25.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hak kepemilikan dan pengelolaan tanah\Nmilik Tujuh Klan Musashi sedang kacau.
Dialogue: 0,0:15:25.49,0:15:28.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada banyak rawa, jadi itu bukan\Ntempat yang cocok untuk ditinggali...
Dialogue: 0,0:15:28.57,0:15:31.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampaikan ke mereka kalau kita akan\Nambil keputusan setelah cek lokasi.
Dialogue: 0,0:15:31.79,0:15:32.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik...
Dialogue: 0,0:15:32.79,0:15:35.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana denah rancangan kediaman baru\NYang Mulia Pangeran Nariyoshi?
Dialogue: 0,0:15:35.54,0:15:36.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini.
Dialogue: 0,0:15:36.46,0:15:39.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Sesuaikan gaya Kyoto.\NAku beri instruksi besok.
Dialogue: 0,0:15:38.16,0:15:42.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan cuma modal nyali atau gertakan,\Ntapi semuanya diperhitungkan dengan matang.
Dialogue: 0,0:15:40.00,0:15:42.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Sudah membuat warna baru untuk handuk?
Dialogue: 0,0:15:42.38,0:15:44.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Saya tambahkan sedikit pigmen\Nmerah terang dan putih...
Dialogue: 0,0:15:42.67,0:15:44.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal masih 27 tahun.
Dialogue: 0,0:15:44.76,0:15:48.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Jual satu set berisi 55 warna\Ndengan diskon 10%. Pasti untung.
Dialogue: 0,0:15:44.92,0:15:48.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bakat mengelola pemerintahan\Nitu menyeramkan.
Dialogue: 0,0:15:49.17,0:15:51.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Magojiro, lihat ke kirimu.\NKita terpojok.
Dialogue: 0,0:15:51.76,0:15:52.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:15:53.43,0:15:55.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang mengerikan lain...
Dialogue: 0,0:15:55.73,0:15:57.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Imagawa.
Dialogue: 0,0:15:55.73,0:16:05.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}(Pelindung Kanto - Yoriki\NImagawa Norimitsu)
Dialogue: 0,0:15:58.64,0:16:01.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa komentar\Nsoal kepalanya itu.
Dialogue: 0,0:16:01.31,0:16:02.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti perasaanmu.
Dialogue: 0,0:16:02.73,0:16:05.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang tidak bisa\Ndikomentari itu mengerikan.
Dialogue: 0,0:16:05.78,0:16:06.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:16:06.72,0:16:08.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pekerjaanku sudah selesai.
Dialogue: 0,0:16:08.95,0:16:10.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo pergi makan, Semuanya.
Dialogue: 0,0:16:10.81,0:16:12.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan senang hati.
Dialogue: 0,0:16:12.24,0:16:14.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku lapar!
Dialogue: 0,0:16:14.54,0:16:17.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, kalian sudah kembali, ya?
Dialogue: 0,0:16:17.37,0:16:19.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sudah masuk perhitunganmu juga, 'kan?
Dialogue: 0,0:16:20.41,0:16:23.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Niatnya mau kutinggal\Nkalau belum selesai.
Dialogue: 0,0:16:23.25,0:16:26.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Pasti bercanda.\NMau makan apa?
Dialogue: 0,0:16:23.25,0:16:27.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ashikaga Tadayoshi, orang yang membentuk\Npondasi Keshogunan Muromachi.
Dialogue: 0,0:16:26.30,0:16:28.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Katanya banyak tangkapan\Nikan kakap hari ini.
Dialogue: 0,0:16:27.17,0:16:31.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkat pengelolaannya yang cerdas,\NKamakura bertransformasi
Dialogue: 0,0:16:28.43,0:16:32.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku bosan makan ikan laut!
Dialogue: 0,0:16:31.26,0:16:33.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menjadi Kamakura\Nyang dikendalikan oleh Ashikaga.
Dialogue: 0,0:16:33.59,0:16:35.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan hari ini...
Dialogue: 0,0:16:35.22,0:16:39.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanah kami yang sudah dijamin\Ntelah diduduki orang luar!
Dialogue: 0,0:16:35.22,0:16:42.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}(Pengadilan Sengketa - [Pengadilan perdata\Nyang didirikan Kaisar Go-Daigo])
Dialogue: 0,0:16:39.69,0:16:42.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami jadi tidak punya tempat tinggal!\NBagaimana ini?
Dialogue: 0,0:16:42.90,0:16:45.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cari solusi sendiri!
Dialogue: 0,0:16:45.15,0:16:47.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku muak mendengar\Nkeluhan yang sama berkali-kali!
Dialogue: 0,0:16:47.69,0:16:54.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemerintahan reformasi Kaisar Go-Daigo,\NRestorasi Kenmu, mulai retak.
Dialogue: 0,0:16:49.95,0:16:54.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}(Pengurus Keluarga Ashikaga\NKou no Moronao)
Dialogue: 0,0:16:54.36,0:16:59.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kaisar memberi hadiah besar kepada\Npara bangsawan dan samurai kesayangannya,
Dialogue: 0,0:16:59.66,0:17:02.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi sebagian besar samurai\Ndiperlakukan buruk atau diabaikan.
Dialogue: 0,0:17:02.50,0:17:05.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekecewaan rakyat muncul dengan cepat.
Dialogue: 0,0:17:05.80,0:17:08.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sistem peradilan itu sampah.
Dialogue: 0,0:17:08.30,0:17:12.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Prosedurnya rumit dan tidak ada\Nyang mengikuti putusan tersebut.
Dialogue: 0,0:17:12.42,0:17:15.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang tidak patuh\Nlangsung dibunuh saja.
Dialogue: 0,0:17:15.84,0:17:19.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada yang patuh\Nkecuali ada ancaman kekerasan.
Dialogue: 0,0:17:20.21,0:17:24.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, hanya petarung terkuat\Nyang berhak menghakimi, ya?
Dialogue: 0,0:17:24.27,0:17:27.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti, dia bukan seorang Kaisar!
Dialogue: 0,0:17:27.40,0:17:29.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kaisar tampaknya menaikkan pajak
Dialogue: 0,0:17:29.69,0:17:31.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk membiayai pembangunan\NIstana Kekaisaran baru.
Dialogue: 0,0:17:31.78,0:17:33.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lelucon yang menarik.
Dialogue: 0,0:17:33.82,0:17:37.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada ketidakpuasan yang meluas\Ndi seluruh negeri atas imbalan tidak adil,
Dialogue: 0,0:17:37.54,0:17:39.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi malah menaikkan pajak?
Dialogue: 0,0:17:39.74,0:17:43.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meskipun kebijakan baru Kaisar\Nmencakup beberapa hal yang progresif,
Dialogue: 0,0:17:43.12,0:17:45.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebagian besar kebijakan tersebut\Njuga boros dan tidak praktis.
Dialogue: 0,0:17:46.13,0:17:50.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sisi lain, sistem pemerintahan\NKeshogunan Kamakura bersifat praktis,
Dialogue: 0,0:17:50.34,0:17:53.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi tidak bisa mengimbangi\Nperkembangan zaman.
Dialogue: 0,0:17:53.51,0:17:58.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami, klan Ashikaga, akan mengambil\Nkelebihan dari kedua pihak.
Dialogue: 0,0:17:58.45,0:18:01.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini, Tuan Tadayoshi di Kamakura
Dialogue: 0,0:18:01.10,0:18:05.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sedang mempelajari semua kekuatan itu\Ndari para pejabat Keshogunan Kamakura.
Dialogue: 0,0:18:05.43,0:18:09.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika menambahkan pengalaman dan\Npelajaran dari kerja pemerintahan di Kyo,
Dialogue: 0,0:18:09.94,0:18:13.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}maka sistem pemerintahan\Nuntuk era baru akan sempurna.
Dialogue: 0,0:18:13.32,0:18:17.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya demi tuanku, Tuan Takauji.
Dialogue: 0,0:18:17.16,0:18:18.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:18:18.83,0:18:24.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat para pengikut Ashikaga sedang\Nmemantapkan visi mereka untuk era baru...
Dialogue: 0,0:18:28.04,0:18:29.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat tangkap dia!
Dialogue: 0,0:18:34.30,0:18:37.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan oposisi terkuat terhadap Takauji
Dialogue: 0,0:18:37.18,0:18:41.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pangeran Moriyoshi dituduh\Nmelakukan pengkhianatan
Dialogue: 0,0:18:41.31,0:18:44.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan ditangkap atas perintah Kaisar.
Dialogue: 0,0:18:50.19,0:18:53.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dengar aku akan dikirim\Nke penjara di Kamakura.
Dialogue: 0,0:18:54.32,0:18:56.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya berada\Ndalam genggaman adikmu.
Dialogue: 0,0:18:56.99,0:19:00.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari awal sampai akhir\Nberjalan persis sesuai keinginanmu.
Dialogue: 0,0:19:00.49,0:19:04.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya sedih karena harus\Nberakhir seperti ini.
Dialogue: 0,0:19:04.49,0:19:09.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takauji, ada cara menerapkan reformasi\Ndengan cara paling aman.
Dialogue: 0,0:19:09.60,0:19:12.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yaitu menjadi reformator kedua.
Dialogue: 0,0:19:14.05,0:19:17.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biarkan reformator pertama\Nmenghancurkan dunia lama.
Dialogue: 0,0:19:18.09,0:19:22.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika reformator pertama yang diliputi\Nrasa dendam digulingkan oleh revolusi,
Dialogue: 0,0:19:22.39,0:19:26.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}maka keluhan rakyat akan terselesaikan,\Ndan dunia lama hancur.
Dialogue: 0,0:19:26.98,0:19:30.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bisa menciptakan dunia baru,\Nbebas dari segala batasan.
Dialogue: 0,0:19:31.69,0:19:34.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat kau mengalahkan Keshogunan
Dialogue: 0,0:19:34.03,0:19:37.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}harusnya kau bisa langsung jadi penguasa\NKeshogunan Kamakura tanpa keributan.
Dialogue: 0,0:19:38.03,0:19:42.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, kau malah menyerahkan\Nsemuanya kepada reformator pertama.
Dialogue: 0,0:19:42.99,0:19:47.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai reformator kedua,\Nseharusnya kau raih segalanya!
Dialogue: 0,0:19:47.50,0:19:49.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku salah, Takauji?!
Dialogue: 0,0:19:49.75,0:19:52.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan semuanya.
Dialogue: 0,0:19:53.21,0:19:56.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Haruskah kusebut iblis serakah?
Dialogue: 0,0:19:57.05,0:20:00.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mengerang\Ndalam tubuhku seperti itu.
Dialogue: 0,0:20:00.93,0:20:02.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi tenang saja.
Dialogue: 0,0:20:03.39,0:20:07.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesetiaan Takauji tidaklah palsu,\Nselama tidak ada pergolakan besar,
Dialogue: 0,0:20:07.89,0:20:10.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan hidup sebagai abdi setia\NKaisar selamanya.
Dialogue: 0,0:20:11.64,0:20:14.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama tidak ada pergolakan besar.
Dialogue: 0,0:20:17.94,0:20:20.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tatapan penuh keyakinan.
Dialogue: 0,0:20:20.49,0:20:25.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di bawah pemerintahan Kaisar,\Npergolakan besar pasti akan terjadi.
Dialogue: 0,0:20:25.66,0:20:30.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat itulah, iblis itu akan\Nmenampakkan wujud aslinya.
Dialogue: 0,0:20:32.75,0:20:36.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan bahkan di bagian barat laut\NShinano, di wilayah Ogasawara,
Dialogue: 0,0:20:36.88,0:20:39.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}rencana selanjutnya sedang dirancang.
Dialogue: 0,0:20:39.13,0:20:43.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tugas yang diberikan Tuan Takauji\Npadaku sebagai gubernur militer
Dialogue: 0,0:20:43.64,0:20:47.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah membangun kekuatan\Ndi Shinano sebagai pengikut klan Ashikaga.
Dialogue: 0,0:20:47.81,0:20:48.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu...
Dialogue: 0,0:20:48.81,0:20:53.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mencari sisa-sisa klan Hojo\Nyang bersembunyi di Provinsi Shinano.
Dialogue: 0,0:20:53.73,0:20:56.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai sekarang belum dapat bukti.
Dialogue: 0,0:20:56.40,0:21:00.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi mataku punya petunjuk.
Dialogue: 0,0:21:00.32,0:21:02.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak kalah dari bocah itu tahun lalu,
Dialogue: 0,0:21:02.99,0:21:06.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bocah itu selalu ada\Ndi setiap kejadian penting.
Dialogue: 0,0:21:06.83,0:21:11.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betul. Pertempuran gubernur juga\Ndiganggu oleh kelompok anak itu.
Dialogue: 0,0:21:11.37,0:21:14.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurut para tentara, mereka\Nmenyebut diri mereka sebagai Tumujaka.
Dialogue: 0,0:21:15.25,0:21:18.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tumujaka?
Dialogue: 0,0:21:18.80,0:21:21.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namanya jelas banget!\NKurang ajar!
Dialogue: 0,0:21:21.72,0:21:23.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurut laporan mata-mataku,
Dialogue: 0,0:21:23.97,0:21:27.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bocah itu masuk Kuil Suwa tahun lalu.
Dialogue: 0,0:21:27.68,0:21:30.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengingat waktunya,\Nini makin mencurigakan!
Dialogue: 0,0:21:30.69,0:21:34.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampilan elegannya tampak tidak cocok\Ndengan pedalaman Shinano.
Dialogue: 0,0:21:34.22,0:21:39.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dugaanku, bocah itu adalah anggota\Nkeluarga Hojo atau putra pejabat tinggi!
Dialogue: 0,0:21:39.31,0:21:41.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagi Yorishige yang melindunginya,
Dialogue: 0,0:21:41.24,0:21:44.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}anak terdidik dari keluarga terpandang\Nadalah mata-mata sempurna.
Dialogue: 0,0:21:44.37,0:21:48.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutku, dia memanfaatkan anak itu sekaligus\Nmemberinya kesempatan cari pengalaman.
Dialogue: 0,0:22:01.09,0:22:03.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Panggil dia ke sini dan interogasi.
Dialogue: 0,0:22:03.26,0:22:06.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan mata tajamku,\Naku akan menguak jati dirinya!
Dialogue: 0,0:22:11.68,0:22:16.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bila ingin romantis ♪
Dialogue: 0,0:22:16.56,0:22:19.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cintai aku lebih dari siapa pun ♪
Dialogue: 0,0:22:25.15,0:22:28.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kamu orang yang baik ♪
Dialogue: 0,0:22:28.53,0:22:32.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bakal baik ke gadis itu juga, 'kan?♪
Dialogue: 0,0:22:32.29,0:22:35.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa, tidak masalah ♪
Dialogue: 0,0:22:35.63,0:22:39.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong bawakan\Nsemua barang beratnya, ya ♪
Dialogue: 0,0:22:39.34,0:22:42.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu keren di depan orang-orang ♪
Dialogue: 0,0:22:42.51,0:22:46.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kamu imut saat kita berduaan ♪
Dialogue: 0,0:22:46.30,0:22:49.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setia seperti anjing ♪
Dialogue: 0,0:22:49.64,0:22:55.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan menghilang seperti kucing, ya ♪
Dialogue: 0,0:22:56.31,0:22:59.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terkadang aku sedih ♪
Dialogue: 0,0:22:59.82,0:23:03.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi sentimental\Nsaat menatap bintang ♪
Dialogue: 0,0:23:03.40,0:23:10.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini, kamu dengan siapa\Ndan sedang apa?♪
Dialogue: 0,0:23:10.54,0:23:14.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, jika kamu mau\Nmencintai dan dicintai ♪
Dialogue: 0,0:23:14.50,0:23:17.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan selalu membuatmu berdebar ♪
Dialogue: 0,0:23:17.96,0:23:21.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika tidak memilihku ♪
Dialogue: 0,0:23:21.55,0:23:25.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menjatuhkanmu ke neraka ♪
Dialogue: 0,0:23:25.22,0:23:28.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mendengarmu ♪
Dialogue: 0,0:23:28.68,0:23:32.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau tahu lagi ♪
Dialogue: 0,0:23:32.43,0:23:36.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bila ingin romantis ♪
Dialogue: 0,0:23:36.06,0:23:38.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cintai aku lebih dari siapa pun ♪
Dialogue: 0,0:23:43.99,0:23:44.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo!
