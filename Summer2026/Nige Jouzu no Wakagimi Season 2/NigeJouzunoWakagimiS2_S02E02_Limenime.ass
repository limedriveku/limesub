Dialogue: 0,0:00:05.27,0:00:08.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teruslah hidup dan tunggu waktunya ♪
Dialogue: 0,0:00:08.24,0:00:13.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jinjing nyawamu dan lawan takdir ♪
Dialogue: 0,0:00:13.08,0:00:16.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hiduplah dalam malu\Ndan kejar mimpimu ♪
Dialogue: 0,0:00:16.29,0:00:21.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi orang-orang\Nyang percaya padamu ♪
Dialogue: 0,0:00:35.01,0:00:38.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagian besar takkan tercatat\Ndalam sejarah ♪
Dialogue: 0,0:00:38.27,0:00:41.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua hal konyol itu ♪
Dialogue: 0,0:00:41.77,0:00:45.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membelit dan terurai, lagi dan lagi ♪
Dialogue: 0,0:00:45.57,0:00:48.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tarik napas ♪
Dialogue: 0,0:00:48.61,0:00:52.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk apa hidup ini dipersembahkan?♪
Dialogue: 0,0:00:52.20,0:00:55.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takdir apa yang menanti?♪
Dialogue: 0,0:00:55.58,0:00:58.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bila rasa bak kutukan ♪
Dialogue: 0,0:00:58.45,0:01:02.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan bisa mengikatku ♪
Dialogue: 0,0:01:02.79,0:01:05.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teruslah hidup dan tunggu waktunya ♪
Dialogue: 0,0:01:05.59,0:01:10.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jinjing nyawamu dan lawan takdir ♪
Dialogue: 0,0:01:10.47,0:01:13.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hiduplah dalam malu\Ndan kejar mimpimu ♪
Dialogue: 0,0:01:13.64,0:01:17.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi orang-orang\Nyang percaya padamu ♪
Dialogue: 0,0:01:17.97,0:01:21.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iblis, ikuti suara tepuk tanganku ♪
Dialogue: 0,0:01:21.14,0:01:24.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}(Iblis, ikuti suara tepuk tanganku)♪
Dialogue: 0,0:01:24.73,0:01:28.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hidup itu singkat,\Nmenyanyi dan menarilah ♪
Dialogue: 0,0:01:28.11,0:01:32.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bunga akan mekar\Nbagi yang jago kabur ♪
Dialogue: 0,0:01:40.24,0:01:42.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya berterima kasih atas\Npersembahan yang kami terima
Dialogue: 0,0:01:42.78,0:01:45.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dari gubernur Provinsi Shinano pada\NFestival Misayama Kuil Suwa tempo hari.
Dialogue: 0,0:01:46.21,0:01:47.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini ucapan terima kasih kami.
Dialogue: 0,0:01:47.84,0:01:50.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon sampaikan ke Tuan Sadamune.
Dialogue: 0,0:01:51.09,0:01:53.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan saya pasti senang.
Dialogue: 0,0:01:55.59,0:01:57.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}(Utusan Keluarga Ogasawara\NAkazawa Shinzaburo)
Dialogue: 0,0:01:56.88,0:02:00.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Barang itu lumayan mahal, lo!
Dialogue: 0,0:02:01.60,0:02:03.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami terima dengan senang hati.
Dialogue: 0,0:02:03.83,0:02:07.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan saya juga mengatakan,\Njika itu akan jadi persembahan
Dialogue: 0,0:02:07.36,0:02:10.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pada Festival Misayama,\Nkami harus melakukan yang terbaik.
Dialogue: 0,0:02:11.86,0:02:16.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Walau saling memperebutkan wilayah,\Nmereka tetap menjaga sopan santun.
Dialogue: 0,0:02:16.20,0:02:20.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Petinggi Kuil Suwa dan\NGubernur Shinano memang hebat.
Dialogue: 0,0:02:20.49,0:02:25.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami selalu berterima kasih pada\NTuan Sadamune atas kepeduliannya.
Dialogue: 0,0:02:25.57,0:02:27.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, tidak apa-apa.
Dialogue: 0,0:02:27.75,0:02:32.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi ada permintaan kecil\Ndari tuan saya...
Dialogue: 0,0:02:32.71,0:02:34.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sungkan-sungkan.
Dialogue: 0,0:02:34.26,0:02:36.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai utusan balasan,
Dialogue: 0,0:02:36.59,0:02:39.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}beliau ingin Tuan Chojumaru\Nyang datang langsung.
Dialogue: 0,0:02:39.76,0:02:41.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu! Itu—
Dialogue: 0,0:02:41.14,0:02:45.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami akan menyiapkan pengawal,\Ntolong biarkan dia pergi sendiri.
Dialogue: 0,0:02:45.87,0:02:51.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau ada masalah bagi keluarga Suwa\Nuntuk mengirim satu anak kecil?
Dialogue: 0,0:02:51.26,0:02:52.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Identitasku ketahuan!
Dialogue: 0,0:02:52.99,0:02:56.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, manipulasi informasi untuk\Nmenyembunyikan identitasnya sudah sempurna.
Dialogue: 0,0:02:56.98,0:02:59.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, Sadamune adalah orang cerdik.
Dialogue: 0,0:02:59.20,0:03:01.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah dia mendapat semacam validasi
Dialogue: 0,0:03:01.16,0:03:03.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau mau mengonfirmasinya\Ndengan bertemu langsung.
Dialogue: 0,0:03:04.33,0:03:06.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ditolak makin dicurigai.
Dialogue: 0,0:03:07.00,0:03:08.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana ini?
Dialogue: 0,0:03:09.21,0:03:10.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, maaf!
Dialogue: 0,0:03:10.92,0:03:14.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya sendiri boleh ikut menemani, 'kan?
Dialogue: 0,0:03:14.01,0:03:17.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kasihan menyuruh\Nanak-anak pergi sendirian!
Dialogue: 0,0:03:17.09,0:03:18.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak! Itu...
Dialogue: 0,0:03:18.72,0:03:20.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau...
Dialogue: 0,0:03:20.51,0:03:24.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keluarga Ogasawara punya masalah\Ndiikuti seorang anak perempuan?
Dialogue: 0,0:03:26.97,0:03:30.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bolehkah berangkat besok pagi?
Dialogue: 0,0:03:31.19,0:03:32.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:03:34.69,0:03:37.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti aman selama ada Ayako.
Dialogue: 0,0:03:37.91,0:03:39.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Su-Sungguh?
Dialogue: 0,0:03:39.53,0:03:42.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemampuan bela diri Ayako\Nmemang bisa diandalkan, tapi...
Dialogue: 0,0:03:42.82,0:03:46.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak usah khawatir.\NBegitu-begitu, dia lumayan cerdas, lo.
Dialogue: 0,0:03:47.95,0:03:49.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja!
Dialogue: 0,0:03:49.79,0:03:52.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak bisa melindungi Tuan Muda\Nuntuk urusan kecil begini,
Dialogue: 0,0:03:52.13,0:03:53.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tak bisa jadi Tomoe Gozen!
Dialogue: 0,0:03:54.09,0:03:55.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tomoe Gozen?
Dialogue: 0,0:03:55.67,0:03:59.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dahulu, ada seorang samurai\Nbernama Kiso Yoshinaka di Shinano.
Dialogue: 0,0:03:59.88,0:04:03.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah kehilangan keluarga di masa kecilnya,\Nia melarikan diri ke Shinano.
Dialogue: 0,0:04:03.64,0:04:07.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ia tumbuh besar di tanah ini,\Nmendapat kekuatan, dan meraih kekuasaan.
Dialogue: 0,0:04:07.94,0:04:11.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Situasi dan tujuan\Nyang sama persis denganku.
Dialogue: 0,0:04:11.77,0:04:15.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perempuan perkasa yang tumbuh\Nbersama Tuan Yoshinaka
Dialogue: 0,0:04:15.19,0:04:19.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebagai pengikutnya dan senantiasa\Nmelindungi beliau, namanya Tomoe Gozen.
Dialogue: 0,0:04:19.39,0:04:23.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagi dirinya yang lahir di Shinano\Ndan bercita-cita menekuni jalan bela diri,
Dialogue: 0,0:04:23.08,0:04:26.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tomoe Gozen adalah sosok\Npanutan sekaligus idolanya.
Dialogue: 0,0:04:26.47,0:04:27.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu.
Dialogue: 0,0:04:28.24,0:04:32.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus, latihan apa itu sampai harus\Nmemegang dua boneka dari kantong kulit?
Dialogue: 0,0:04:33.07,0:04:35.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tomoe Gozen itu super kuat.
Dialogue: 0,0:04:35.96,0:04:38.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya, dia menjepit\Ndua prajurit di kedua sisinya,
Dialogue: 0,0:04:38.51,0:04:42.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu mencabut kepala mereka\Nuntuk dipamerkan.
Dialogue: 0,0:04:42.34,0:04:47.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga ingin mencoba\Nmencopot kepala ini!
Dialogue: 0,0:04:51.35,0:04:54.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masalahnya adalah\Ndialog dengan Sadamune.
Dialogue: 0,0:04:55.73,0:04:57.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya jelaskan lewat gim.
Dialogue: 0,0:04:57.99,0:05:00.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mo-Mohon bimbingannya...
Dialogue: 0,0:05:00.74,0:05:03.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf! Sudah nunggu lama?
Dialogue: 0,0:05:03.20,0:05:05.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jawaban atas pertanyaan Sadamune.
Dialogue: 0,0:05:06.91,0:05:08.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:05:08.66,0:05:10.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketemu!
Dialogue: 0,0:05:11.29,0:05:15.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau salah menjawab, saya melihat\Nnyawa Tuan akan terancam.
Dialogue: 0,0:05:15.29,0:05:17.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, tidak... Aku harus apa?
Dialogue: 0,0:05:17.84,0:05:21.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan itu juga berlaku\Nuntuk Tuan Yoshinaka.
Dialogue: 0,0:05:21.59,0:05:24.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia kuat di medan perang,\Ntapi kurang terdidik dan tidak peka.
Dialogue: 0,0:05:24.80,0:05:27.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akibat berulang kali\Nmelakukan perilaku keliru,
Dialogue: 0,0:05:27.47,0:05:30.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ia kehilangan\Ndukungan rakyat dan hancur.
Dialogue: 0,0:05:31.39,0:05:34.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, agar itu tidak terjadi\Npada Anda juga...
Dialogue: 0,0:05:35.94,0:05:37.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belajar, belajar!
Dialogue: 0,0:05:37.44,0:05:42.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelajari berbagai macam ilmu\Nagar tidak dicurigai Sadamune besok!
Dialogue: 0,0:05:42.48,0:05:45.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku bakal baik-baik saja?
Dialogue: 0,0:05:56.12,0:05:59.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan, saya membawa Tuan Chojumaru.
Dialogue: 0,0:05:59.17,0:06:01.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Persilakan masuk.
Dialogue: 0,0:06:05.97,0:06:09.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi, kami akan menunggu\Ndi luar ruangan.
Dialogue: 0,0:06:18.06,0:06:21.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Auranya mencekam\Nsaat melihatnya dari dekat.
Dialogue: 0,0:06:21.90,0:06:23.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku takkan kalah!
Dialogue: 0,0:06:23.78,0:06:26.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia orang yang selalu\Nmelakukan tindakan licik!
Dialogue: 0,0:06:26.74,0:06:31.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku putra Hojo dan aku juga\Nmemikul nama Kuil Suwa.
Dialogue: 0,0:06:32.58,0:06:34.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak boleh sampai diremehkan!
Dialogue: 0,0:06:34.54,0:06:35.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perbaiki sikap dudukmu!
Dialogue: 0,0:06:37.37,0:06:41.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beginilah sikap duduk untuk menunjukkan\Nhormat pada lawan bicaramu.
Dialogue: 0,0:06:41.38,0:06:46.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau duduk dengan gagah agar terlihat\Nberwibawa di depan musuh, 'kan?
Dialogue: 0,0:06:46.21,0:06:47.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemikiran itu terbalik!
Dialogue: 0,0:06:47.68,0:06:54.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru karena kau akan merenggut\Nnyawa musuh, hormatilah nyawa itu!
Dialogue: 0,0:06:54.89,0:07:00.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di zaman ini, sebagian besar pria\Ndan wanita duduk bersila atau berlutut.
Dialogue: 0,0:07:00.48,0:07:05.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Posisi berlutut yang menjadi umum\Nselama Zaman Edo didasarkan pada etiket
Dialogue: 0,0:07:05.11,0:07:07.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang disusun Ogasawara Sadamune.
Dialogue: 0,0:07:07.74,0:07:10.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru aku yang meremehkan.
Dialogue: 0,0:07:10.44,0:07:13.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang akan dimulai sekarang\Nadalah pertarungan kata-kata.
Dialogue: 0,0:07:14.66,0:07:16.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus kabur dengan kata-kata.
Dialogue: 0,0:07:17.66,0:07:19.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau kata-katanya akan menghunjamku!
Dialogue: 0,0:07:28.47,0:07:31.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon maaf, berapa umurmu?
Dialogue: 0,0:07:32.51,0:07:33.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sembilan tahun.
Dialogue: 0,0:07:33.93,0:07:37.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, tidak terlihat\Nseperti sembilan tahun!
Dialogue: 0,0:07:37.18,0:07:40.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hampir saja kurayu\Nmenjadi selirku.
Dialogue: 0,0:07:40.40,0:07:44.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tubuhmu sudah matang\Nseperti orang dewasa.
Dialogue: 0,0:07:47.15,0:07:49.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak yang bilang begitu.
Dialogue: 0,0:07:49.65,0:07:51.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku terima hadiah balasannya.
Dialogue: 0,0:07:51.99,0:07:54.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Titip salam untuk Tuan Yorishige.
Dialogue: 0,0:07:54.87,0:07:56.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, akan saya sampaikan.
Dialogue: 0,0:07:56.71,0:08:00.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bocah ini Hojo atau keroco?
Dialogue: 0,0:08:00.83,0:08:04.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ajukan pertanyaan, lalu nilai jawabannya\Nuntuk mengetahui kebenarannya!
Dialogue: 0,0:08:06.34,0:08:10.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, Bocah.\NKau duduk rapi sekali.
Dialogue: 0,0:08:11.00,0:08:14.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak wajar bagi samurai dari Suwa\Nyang tak mengerti tata krama.
Dialogue: 0,0:08:14.63,0:08:18.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutku, kamu juga kurang ajar\Nkarena menembak telinga gadis kuil.
Dialogue: 0,0:08:19.60,0:08:22.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia langsung membalas ucapanku\Ndan mengalihkan topik, ya.
Dialogue: 0,0:08:23.27,0:08:25.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bagian dari perang.
Dialogue: 0,0:08:25.57,0:08:29.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu lebih dari siapa pun kalau\Ntak bisa menang di perang dengan tata krama.
Dialogue: 0,0:08:29.49,0:08:34.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mengganggu terus dalam perang\Nsejak kompetisi berburu anjing itu.
Dialogue: 0,0:08:34.69,0:08:39.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar anak nakal.\NKau pasti putra samurai terkenal.
Dialogue: 0,0:08:39.50,0:08:42.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebutkan nama dan silsilahmu!
Dialogue: 0,0:08:42.50,0:08:44.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti saat di medan perang!
Dialogue: 0,0:08:45.88,0:08:49.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Leluhurku adalah Koizumi Gengoro,\Npenduduk Okaya-sho
Dialogue: 0,0:08:49.38,0:08:52.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang diangkat menjadi\Nkepala penjaga Kuil Suwa.
Dialogue: 0,0:08:52.88,0:08:55.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada generasi kelima,\Nkepala penjaga diwarisi
Dialogue: 0,0:08:55.26,0:08:58.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}oleh Koizumi Gorosaburo yang mengajarkan\Nilmu pengetahuan kepada para penjaga.
Dialogue: 0,0:08:58.85,0:09:01.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salah satu keturunannya\Nadalah aku, Chojumaru.
Dialogue: 0,0:09:03.65,0:09:07.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tutur katanya lancar\Ndan sekujur tubuhnya tenang.
Dialogue: 0,0:09:07.07,0:09:11.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika itu bohong, itu pasti\Nsudah direncanakan Yorishige.
Dialogue: 0,0:09:11.24,0:09:15.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah memastikan orang tuamu memang ada\Ndan meninggal dalam kebakaran tahun lalu.
Dialogue: 0,0:09:15.58,0:09:17.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Termasuk bahwa mereka\Npunya anak laki-laki.
Dialogue: 0,0:09:17.74,0:09:22.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi itu aneh.\NOrang tua dan anak mati dalam kebakaran.
Dialogue: 0,0:09:22.83,0:09:26.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada penduduk yang bersaksi demikian.
Dialogue: 0,0:09:28.21,0:09:31.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku meninggalkan orang tuaku\Ndan kabur sendirian dari rumah yang terbakar.
Dialogue: 0,0:09:31.92,0:09:34.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena malu oleh itu,\Naku kabur ke Kuil Suwa
Dialogue: 0,0:09:32.55,0:09:35.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Maaf, Tuan Koizimu yang tak kukenal.
Dialogue: 0,0:09:34.68,0:09:37.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku belum pulang ke rumah\Nsejak saat itu.
Dialogue: 0,0:09:35.68,0:09:38.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku manfaatkan kematianmu\Nsebagai tameng.
Dialogue: 0,0:09:37.39,0:09:40.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kebakarannya sangat besar\Nbahkan mayat pun hangus,
Dialogue: 0,0:09:40.18,0:09:42.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pasti ada yang mengira aku ikut mati.
Dialogue: 0,0:09:42.92,0:09:45.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada hal yang lebih aneh lagi.
Dialogue: 0,0:09:45.86,0:09:48.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para pengikut yang setia padamu.
Dialogue: 0,0:09:48.90,0:09:52.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kojirou adalah anggota klan Nezu.
Dialogue: 0,0:09:52.15,0:09:57.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami sudah memastikan Ayako yang berdiri\Ndi sana adalah anak haram Tuan Mochizuki.
Dialogue: 0,0:09:58.99,0:10:03.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keduanya berasal dari keluarga terhormat\Nyang telah lama berjaya di Shinano.
Dialogue: 0,0:10:03.96,0:10:07.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin menjadi bawahan\Nputra seorang penjaga biasa!
Dialogue: 0,0:10:07.71,0:10:09.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja aku paham itu.
Dialogue: 0,0:10:09.62,0:10:13.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat kami bertemu di Kuil Suwa,\Nkami bertanding kejar-kejaran.
Dialogue: 0,0:10:13.63,0:10:16.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka memanggilku "Tuan"\Nkarena aku yang menang.
Dialogue: 0,0:10:17.55,0:10:20.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini cuma kelompok main anak-anak.
Dialogue: 0,0:10:21.10,0:10:25.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini untuk latihan melayani\Ntuan kami sebenarnya kelak.
Dialogue: 0,0:10:26.27,0:10:31.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seorang gubernur Shinano\Nmemusingkan permainan anak-anak?
Dialogue: 0,0:10:32.90,0:10:37.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh juga dia. Tiap kali bertanya,\Njawabannya jadi makin mulus.
Dialogue: 0,0:10:37.45,0:10:40.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketakutan dan kepura-puraan\Nsaat masuk kemari sudah hilang.
Dialogue: 0,0:10:40.41,0:10:43.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ia bahkan tampak\Nmenikmati perdebatan ini.
Dialogue: 0,0:10:43.62,0:10:47.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bocah aneh yang tampak\Nsenang melarikan diri...
Dialogue: 0,0:10:47.54,0:10:51.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah dia bakal menunjukkan\Nsosok aslinya saat cari-cari alasan?
Dialogue: 0,0:10:53.92,0:10:56.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shinzaburo, masuk!
Dialogue: 0,0:10:57.76,0:11:01.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bocah, apakah kau bertemu dia\Npertama kali kemarin?
Dialogue: 0,0:11:02.35,0:11:05.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya dia ada\Nsaat berburu anjing juga...
Dialogue: 0,0:11:05.02,0:11:08.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan sebelum itu, aku sudah\Nbertugas lama di Kamakura.
Dialogue: 0,0:11:09.27,0:11:14.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku familier dengan Kamakura dan sering\Nke tempat tinggal Hojo dan pengikutnya.
Dialogue: 0,0:11:15.05,0:11:18.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah melihat dari dekat hari ini,\Naku jadi yakin.
Dialogue: 0,0:11:18.53,0:11:22.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, aku sudah melihat anak ini\Nbeberapa kali di sana.
Dialogue: 0,0:11:22.16,0:11:24.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana dia mengelak dari ini?
Dialogue: 0,0:11:24.37,0:11:28.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau menyangkal,\Ndia pasti bereaksi tidak wajar.
Dialogue: 0,0:11:28.75,0:11:31.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Di mana?", "Itu tidak mungkin."
Dialogue: 0,0:11:31.71,0:11:36.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku takkan melewatkan perubahan sekecil\Napa pun pada ekspresimu saat menjawab!
Dialogue: 0,0:11:37.59,0:11:40.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa gunanya berbohong soal itu?
Dialogue: 0,0:11:41.84,0:11:44.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin putra penjaga di Kuil Suwa
Dialogue: 0,0:11:44.22,0:11:47.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berada di kediaman\Norang-orang penting Kamakura.
Dialogue: 0,0:11:48.81,0:11:53.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu gertakan. Saat acara resmi\Ndi luar biasanya pakai tandu.
Dialogue: 0,0:11:53.32,0:11:55.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalaupun itu saat aku kabur dari latihan,
Dialogue: 0,0:11:55.65,0:11:59.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}samurai rendahan seharusnya\Ntidak tahu siapa aku.
Dialogue: 0,0:11:59.74,0:12:04.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, aku juga menemukan banyak\Njalan rahasia agar tidak terlihat orang.
Dialogue: 0,0:12:06.03,0:12:09.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan remehkan pewaris\Nyang jago kabur!
Dialogue: 0,0:12:09.50,0:12:11.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Mana mungkin aku bohong!
Dialogue: 0,0:12:11.63,0:12:13.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tinggal di Kamakura\Nselama lima tahun!
Dialogue: 0,0:12:13.88,0:12:15.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu Kamakura...
Dialogue: 0,0:12:15.17,0:12:17.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terserah kalau kamu mau bohong.
Dialogue: 0,0:12:17.96,0:12:21.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gertakan buruk sama saja\Ndengan serangan balik yang buruk.
Dialogue: 0,0:12:21.34,0:12:23.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa membalasnya sambil kabur.
Dialogue: 0,0:12:27.14,0:12:30.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keluarga Ogasawara mengirim pembohong\Nsebagai utusan ke Suwa?
Dialogue: 0,0:12:33.27,0:12:37.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shinzaburo, sudah cukup.\NKembalilah.
Dialogue: 0,0:12:42.65,0:12:45.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bocah ini masih menyembunyikan ekornya.
Dialogue: 0,0:12:45.29,0:12:48.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa dia selihai itu menyembunyikannya?
Dialogue: 0,0:12:48.12,0:12:51.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau dia memang tak ada\Nkaitannya dengan Hojo?
Dialogue: 0,0:12:51.24,0:12:54.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, maaf terlambat!
Dialogue: 0,0:12:54.96,0:12:57.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau lama sekali, Tuan Ichikawa.
Dialogue: 0,0:12:57.55,0:13:01.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon maaf, perjalanan terhambat\Nakibat tebing longsor.
Dialogue: 0,0:13:02.76,0:13:04.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf...
Dialogue: 0,0:13:05.51,0:13:09.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau ke toilet.\NAku sudah tidak tahan.
Dialogue: 0,0:13:13.52,0:13:16.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Isi otaknya masih\Nseperti anak sembilan tahun.
Dialogue: 0,0:13:16.47,0:13:20.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia malah pergi di saat tuannya\Nberada di krisis terbesar.
Dialogue: 0,0:13:20.32,0:13:23.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, Bocah.\NIni baru dimulai.
Dialogue: 0,0:13:23.82,0:13:26.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perlakuan kami tadi bukanlah\Ntindakan tidak sopan.
Dialogue: 0,0:13:26.33,0:13:29.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu karena kami mencurigaimu\Nsisa-sisa klan Hojo.
Dialogue: 0,0:13:29.62,0:13:33.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajar saja kami menghalalkan\Nsegala cara untuk menangkapmu.
Dialogue: 0,0:13:33.29,0:13:36.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cara terakhir adalah melihat\Nekspresi dari jarak dekat.
Dialogue: 0,0:13:36.46,0:13:39.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengarkan detak jantung\Ndan ungkap kebenarannya.
Dialogue: 0,0:13:39.26,0:13:40.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana tata kramanya?!
Dialogue: 0,0:13:40.97,0:13:43.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang, ada pemisah\Nantara tata krama dan perang.
Dialogue: 0,0:13:43.84,0:13:45.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini adalah perang!
Dialogue: 0,0:13:45.18,0:13:47.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berubah seenak sendiri!
Dialogue: 0,0:13:47.14,0:13:51.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asal kau tahu saja, tidak ada orang\Nyang bisa lolos berbohong dalam kondisi ini.
Dialogue: 0,0:13:51.48,0:13:55.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mulai pertanyaan utamanya.
Dialogue: 0,0:13:55.11,0:13:57.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tanya padamu.
Dialogue: 0,0:13:57.44,0:14:01.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah kau Hojo?
Dialogue: 0,0:14:16.92,0:14:19.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kau menggangguku\Nmendengarkan detak jantung!
Dialogue: 0,0:14:31.77,0:14:33.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ogasawara sekalian!
Dialogue: 0,0:14:33.81,0:14:36.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang jago menari,\Nayo tantang Ayako!
Dialogue: 0,0:14:37.06,0:14:39.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tarianmu bagus sekali, Nak!
Dialogue: 0,0:14:40.77,0:14:43.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau main berapa alat musik? Keren!
Dialogue: 0,0:14:49.49,0:14:53.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengaku. Itu sejenis musik klub\Nyang populer pada masa itu.
Dialogue: 0,0:14:53.87,0:15:00.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menggugah naluri, membuat orang-orang\Ndari segala kalangan larut dalam keseruan.
Dialogue: 0,0:15:00.06,0:15:00.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oi!
Dialogue: 0,0:15:01.17,0:15:03.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kalian menari dengan gadis itu?!
Dialogue: 0,0:15:03.91,0:15:08.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, gadis itu tiba-tiba\Nmemainkan instrumen musik...
Dialogue: 0,0:15:08.60,0:15:14.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Tuan Sadamune sedang mengobrol asyik\Ndengan anak-anak, ayo ikut meriahkan."
Dialogue: 0,0:15:17.10,0:15:20.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tahan Ichikawa\Ndengan meruntuhkan tebing.
Dialogue: 0,0:15:20.23,0:15:22.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi jika Ichikawa masih tetap datang...
Dialogue: 0,0:15:22.82,0:15:25.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayako, langsung tinggalkan posisimu.
Dialogue: 0,0:15:26.06,0:15:29.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika Sadamune dan Ichikawa bersatu\Ndengan mata dan telinga mereka yang hebat,
Dialogue: 0,0:15:29.70,0:15:32.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Tokiyuki sekalipun pasti\Nidentitasnya akan terbongkar.
Dialogue: 0,0:15:33.16,0:15:36.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau harus menutup salah satunya,\Nmata atau telinga.
Dialogue: 0,0:15:36.12,0:15:40.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, berhenti!\NSedang ada pembicaraan penting!
Dialogue: 0,0:15:40.38,0:15:42.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, benarkah?
Dialogue: 0,0:15:42.84,0:15:46.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kupikir tidak mungkin membicarakan\Nhal penting dengan anak-anak.
Dialogue: 0,0:15:46.68,0:15:49.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, kami berencana\Nlangsung pulang,
Dialogue: 0,0:15:49.47,0:15:53.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}samurai Suwa sedang\Ndatang menjemput.
Dialogue: 0,0:15:54.64,0:15:59.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau anak-anak pulang terlambat,\Nmungkin akan jadi masalah besar.
Dialogue: 0,0:15:59.19,0:16:01.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berisik! Sedikit lagi!
Dialogue: 0,0:16:01.56,0:16:02.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Muda.
Dialogue: 0,0:16:03.94,0:16:06.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja.\NAku ada di sisimu.
Dialogue: 0,0:16:14.32,0:16:16.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mata dan telingaku direnggut.
Dialogue: 0,0:16:18.37,0:16:20.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak cuma dengan alat musik dan tarian.
Dialogue: 0,0:16:20.66,0:16:24.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lengan dan kaki yang jenjang,\Nserta wajah yang ekspresif...
Dialogue: 0,0:16:26.42,0:16:29.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betapa beruntungnya hidupku.
Dialogue: 0,0:16:30.22,0:16:34.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di dunia yang damai, dia pasti menjadi\Nwanita berbakat yang dikagumi orang.
Dialogue: 0,0:16:34.97,0:16:37.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia menjadi pengikutku.
Dialogue: 0,0:16:46.57,0:16:51.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tanya sekali lagi.\NApa kau Hojo?
Dialogue: 0,0:16:51.28,0:16:56.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa. Tarian dengaku tadi\Nmenguasai pikiran bocah ini.
Dialogue: 0,0:16:56.20,0:16:58.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jantungnya berdebar-debar karena itu.
Dialogue: 0,0:16:58.79,0:17:01.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sudah begini, kami tidak bisa\Nmencari jawaban sebenarnya!
Dialogue: 0,0:17:02.15,0:17:04.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah cukup. Pulanglah.
Dialogue: 0,0:17:05.38,0:17:09.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau mengganggu di pertarungan lagi,\Nakan kubunuh tanpa ampun.
Dialogue: 0,0:17:09.55,0:17:10.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ingat itu.
Dialogue: 0,0:17:11.76,0:17:15.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik. Saya pamit, Tuan Sadamune.
Dialogue: 0,0:17:20.56,0:17:24.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan yakin? Kenapa tidak bunuh saja\Norang yang mencurigakan?
Dialogue: 0,0:17:24.02,0:17:27.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bocah itu sudah seperti itu\Nsejak berburu anjing.
Dialogue: 0,0:17:27.28,0:17:31.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tulus mengakui hal baik\Ndan memujinya sepenuh hati.
Dialogue: 0,0:17:31.45,0:17:34.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia langsung menurut\Nsaat kuminta memperbaiki sikap duduk.
Dialogue: 0,0:17:34.95,0:17:38.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sikap duduknya tidak rusak\Nwalau terpojok.
Dialogue: 0,0:17:38.45,0:17:43.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di masa penuh kecurigaan ini,\Nkepolosannya justru terlalu mencurigakan.
Dialogue: 0,0:17:43.73,0:17:48.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kalau orangnya sejujur itu,\Njustru bodoh kalau kita curiga.
Dialogue: 0,0:17:51.13,0:17:52.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayako.
Dialogue: 0,0:17:52.42,0:17:54.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak kapan kau belajar\Nketerampilan itu?
Dialogue: 0,0:17:55.88,0:17:57.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penasaran?
Dialogue: 0,0:17:58.06,0:18:01.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sampai lupa dengan\Ninterogasi Tuan Sadamune.
Dialogue: 0,0:18:01.50,0:18:04.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hatiku berdebar-debar karena kamu.
Dialogue: 0,0:18:05.98,0:18:09.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jujur itu seram!\NItu senjata mematikan!
Dialogue: 0,0:18:15.65,0:18:18.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Muda.
Dialogue: 0,0:18:23.29,0:18:26.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berani-beraninya...
Dialogue: 0,0:18:26.04,0:18:28.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berani-beraninya!
Dialogue: 0,0:18:28.09,0:18:30.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berani-beraninya kalian!
Dialogue: 0,0:18:30.09,0:18:34.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berani-beraninya kalian merusak\Nreputasiku di hadapan tuanku!
Dialogue: 0,0:18:34.30,0:18:37.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar bocah yang cuma jago ngomong\Ndan menghibur orang!
Dialogue: 0,0:18:37.76,0:18:41.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan ilmu bela diriku, kalian\Nakan kembali ke tanah, bukan Suwa!
Dialogue: 0,0:18:42.68,0:18:44.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Muda, menyingkir!
Dialogue: 0,0:18:44.39,0:18:45.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lambat!
Dialogue: 0,0:18:47.65,0:18:49.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menari, menari, menari!
Dialogue: 0,0:18:52.61,0:18:54.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasakan langsung dengan tubuhmu!
Dialogue: 0,0:18:54.20,0:18:58.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Naginata yang telah kutempa\Nlebih lama dari umurmu!
Dialogue: 0,0:18:59.45,0:19:02.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang dengan kepercayaan diri\Nmutlak pada naginata.
Dialogue: 0,0:19:05.12,0:19:06.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan pikir bisa kabur!
Dialogue: 0,0:19:06.24,0:19:08.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama dengan pedang Kojirou.
Dialogue: 0,0:19:08.48,0:19:11.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak punya senjata keahlianku.
Dialogue: 0,0:19:13.05,0:19:14.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai gantinya...
Dialogue: 0,0:19:22.18,0:19:25.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ciat!
Dialogue: 0,0:19:32.52,0:19:37.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oi, apa yang kau lakukan?\NHentikan! Lepaskan!
Dialogue: 0,0:19:37.99,0:19:42.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, Bedebah!\NJangan pikir bisa lolos!
Dialogue: 0,0:19:42.08,0:19:46.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Walau pakai tendangan, batu,\Nsenjata musuh, alat musik...
Dialogue: 0,0:19:48.00,0:19:51.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu! Iya, iya!\NAyo bicara baik-baik!
Dialogue: 0,0:19:54.09,0:19:58.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku manfaatkan tubuh yang kupunya!\NAku pakai semua yang ada!
Dialogue: 0,0:19:58.84,0:20:02.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katakan keinginanmu!\NUang? Pedang?
Dialogue: 0,0:20:03.89,0:20:07.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial! Wanita super!
Dialogue: 0,0:20:10.31,0:20:12.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tu-Tunggu!
Dialogue: 0,0:20:12.40,0:20:14.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak pilih-pilih senjata.
Dialogue: 0,0:20:18.28,0:20:21.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang penting lindungi tuanku!
Dialogue: 0,0:20:24.49,0:20:27.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tomoe Gozen, pengawal setia dari Shinano.
Dialogue: 0,0:20:27.65,0:20:31.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hangaku Gozen, jenderal\Ndalam pemberontakan Echigo.
Dialogue: 0,0:20:31.33,0:20:34.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ii Jiro, penguasa wanita Provinsi Totomi.
Dialogue: 0,0:20:35.09,0:20:40.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak catatan perempuan yang berperang\Ndi berbagai wilayah sejak zaman kuno.
Dialogue: 0,0:20:41.09,0:20:45.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sip. Aku akhiri dengan\Nmencopot kepalanya!
Dialogue: 0,0:20:45.01,0:20:46.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu!
Dialogue: 0,0:20:47.14,0:20:49.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini, kita datang sebagai utusan,\Nbukan untuk perang.
Dialogue: 0,0:20:49.85,0:20:51.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membunuhnya cuma memperkeruh keadaan.
Dialogue: 0,0:20:51.65,0:20:53.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lain kali saja copot kepala orangnya.
Dialogue: 0,0:20:53.23,0:20:54.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Sungguh?
Dialogue: 0,0:20:53.23,0:20:59.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kelak aku pasti jadi pengikutmu seorang ♪
Dialogue: 0,0:20:54.52,0:20:56.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, tidak apa-apa!
Dialogue: 0,0:20:56.07,0:20:57.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:20:57.24,0:20:59.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Muda baik banget!
Dialogue: 0,0:20:59.36,0:21:05.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Menggunakan seluruh kemampuan,\Nberlari lintasi dataran luas, kapan pun itu ♪
Dialogue: 0,0:21:05.32,0:21:07.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat Tuan Muda datang ke Shinano,
Dialogue: 0,0:21:05.32,0:21:11.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Lubuk hatiku sadar,\Ntatapanmu menyadarkanku ♪
Dialogue: 0,0:21:08.45,0:21:10.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku merasa ini adalah takdir.
Dialogue: 0,0:21:10.83,0:21:14.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Calon pemimpin negeri ini\Ndatang memberiku kesempatan
Dialogue: 0,0:21:11.96,0:21:16.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}bahwa aku mencintaimu ♪
Dialogue: 0,0:21:14.88,0:21:16.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menjadi Tomoe Gozen yang kuimpikan.
Dialogue: 0,0:21:17.34,0:21:20.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Kalau tidak bisa lari, bawalah ♪
Dialogue: 0,0:21:17.63,0:21:19.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu berkat Tuan Muda, lo!
Dialogue: 0,0:21:19.72,0:21:23.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mulai menekuni seni bela diri\Ndan seni pertunjukan dengan serius.
Dialogue: 0,0:21:20.59,0:21:24.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku akan melindungi di sampingmu ♪
Dialogue: 0,0:21:23.51,0:21:27.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kugunakan semua keterampilan\Nyang kupunya untuk melindungi Tuan Muda.
Dialogue: 0,0:21:24.01,0:21:30.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Tapi sebenarnya aku ingin cuma aku saja ♪
Dialogue: 0,0:21:27.68,0:21:28.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu...
Dialogue: 0,0:21:29.64,0:21:33.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah melindungi Tuan Muda,\Naku akan melahirkan banyak anakmu!
Dialogue: 0,0:21:30.06,0:21:32.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Pilih aku, pilih aku ♪
Dialogue: 0,0:21:32.94,0:21:36.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Jangan ragu, pilih aku ♪
Dialogue: 0,0:21:34.52,0:21:36.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, Tuan Muda...
Dialogue: 0,0:21:36.40,0:21:42.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku ingin meraih banyak masa depan\Nbersamamu (Kuingin dipilih)♪
Dialogue: 0,0:21:37.94,0:21:40.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pilih aku kapan saja, ya.
Dialogue: 0,0:21:42.16,0:21:44.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Pilih aku, pilih aku ♪
Dialogue: 0,0:21:43.66,0:21:46.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia paham maksudnya tidak, ya?
Dialogue: 0,0:21:44.95,0:21:48.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Aku ingin kau memilihku ♪
Dialogue: 0,0:21:48.04,0:21:49.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malu, ih!
Dialogue: 0,0:21:48.04,0:21:56.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Semoga harapan tulusku ini terwujud ♪
Dialogue: 0,0:21:49.91,0:21:53.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua yang ia katakan dan lakukan\Nsangat ekstrem dan berani.
Dialogue: 0,0:21:53.16,0:21:57.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hakikat dirinya adalah kesetiaan\Nyang murni serta hati yang ceria.
Dialogue: 0,0:21:57.58,0:22:01.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pasti akan menjadi\Nsamurai yang kuat dan cantik.
Dialogue: 0,0:22:02.17,0:22:06.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisakah aku menjadi tuan\Nyang layak untuknya?
Dialogue: 0,0:22:11.73,0:22:16.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bila ingin romantis ♪
Dialogue: 0,0:22:16.61,0:22:19.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cintai aku lebih dari siapa pun ♪
Dialogue: 0,0:22:25.20,0:22:28.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kamu orang yang baik ♪
Dialogue: 0,0:22:28.58,0:22:32.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bakal baik ke gadis itu juga, 'kan?♪
Dialogue: 0,0:22:32.33,0:22:35.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa, tidak masalah ♪
Dialogue: 0,0:22:35.67,0:22:39.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong bawakan\Nsemua barang beratnya, ya ♪
Dialogue: 0,0:22:39.38,0:22:42.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu keren di depan orang-orang ♪
Dialogue: 0,0:22:42.55,0:22:46.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kamu imut saat kita berduaan ♪
Dialogue: 0,0:22:46.34,0:22:49.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setia seperti anjing ♪
Dialogue: 0,0:22:49.68,0:22:55.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan menghilang seperti kucing, ya ♪
Dialogue: 0,0:22:56.35,0:22:59.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terkadang aku sedih ♪
Dialogue: 0,0:22:59.86,0:23:03.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi sentimental\Nsaat menatap bintang ♪
Dialogue: 0,0:23:03.44,0:23:10.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini, kamu dengan siapa\Ndan sedang apa?♪
Dialogue: 0,0:23:10.58,0:23:14.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, jika kamu mau\Nmencintai dan dicintai ♪
Dialogue: 0,0:23:14.54,0:23:17.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan selalu membuatmu berdebar ♪
Dialogue: 0,0:23:18.00,0:23:21.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika tidak memilihku ♪
Dialogue: 0,0:23:21.59,0:23:25.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menjatuhkanmu ke neraka ♪
Dialogue: 0,0:23:25.26,0:23:28.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mendengarmu ♪
Dialogue: 0,0:23:28.72,0:23:32.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau tahu lagi ♪
Dialogue: 0,0:23:32.47,0:23:36.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bila ingin romantis ♪
Dialogue: 0,0:23:36.10,0:23:39.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cintai aku lebih dari siapa pun ♪
Dialogue: 0,0:23:43.69,0:23:45.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo!
Dialogue: 0,0:23:44.03,0:23:45.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tokiyuki dan Tiga Jenderal Besar)
