Dialogue: 0,0:00:15.92,0:00:17.29,sign,,0000,0000,0000,,(Kuil Kinkaku belum ada)
Dialogue: 0,0:01:24.11,0:01:29.53,sign,,0000,0000,0000,,(Tuan Muda Jago Kabur)
Dialogue: 0,0:04:18.33,0:04:20.58,sign,,0000,0000,0000,,(Kediaman Saionji Kinmune)
Dialogue: 0,0:04:20.58,0:04:23.75,sign,,0000,0000,0000,,(Geng Jidat)
Dialogue: 0,0:04:49.86,0:04:52.36,sign,,0000,0000,0000,,(Vila Saionji)
Dialogue: 0,0:06:08.56,0:06:14.19,sign,,0000,0000,0000,,(Waras)
Dialogue: 0,0:08:45.84,0:08:48.85,sign,,0000,0000,0000,,(Aku dapat belalang besar,\Nsilakan dimakan)
Dialogue: 0,0:09:57.54,0:10:00.54,sign,,0000,0000,0000,,(Kluk Kluk)
Dialogue: 0,0:11:12.28,0:11:18.79,sign,,0000,0000,0000,,(Kusunoki Masashige)
Dialogue: 0,0:11:22.04,0:11:25.88,sign,,0000,0000,0000,,(Dewa Perang - Kusunoki Masashige)
Dialogue: 0,0:13:27.42,0:13:34.71,sign,,0000,0000,0000,,(Kediaman Kusunoki Masashige)
Dialogue: 0,0:18:26.97,0:18:28.80,sign,,0000,0000,0000,,(Kabur adalah hidup)
Dialogue: 0,0:18:51.20,0:18:53.49,sign,,0000,0000,0000,,(Kapal Pecah)
Dialogue: 0,0:23:20.26,0:23:27.47,sign,,0000,0000,0000,,L-O-V-E
Dialogue: 0,0:23:32.94,0:23:35.02,sign,,0000,0000,0000,,(Hinatazaka46 - Fujishima Kaho)
Dialogue: 0,0:23:39.03,0:23:40.03,sign,,0000,0000,0000,,(Episode 22 [Tahun 1335]\NMalam Pembunuhan)
Dialogue: 0,0:00:06.20,0:00:10.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Firasatku bilang kuil emas akan dibangun\Ndi suatu tempat dalam pandanganku saat ini.
Dialogue: 0,0:00:10.54,0:00:13.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, aku paham.\NAda auranya.
Dialogue: 0,0:00:13.58,0:00:15.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin.
Dialogue: 0,0:00:17.29,0:00:19.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita jadi merepotkan.
Dialogue: 0,0:00:19.83,0:00:22.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus berterima kasih ke Nona Mima.
Dialogue: 0,0:00:22.55,0:00:26.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi tak kusangka ayahnya\Nadalah Sasaki Doyo.
Dialogue: 0,0:00:27.72,0:00:32.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sasaki Doyo mengkhianati\NKamakura bersama Takauji.
Dialogue: 0,0:00:32.02,0:00:35.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini, dia menjadi\Nsemacam mentornya Takauji.
Dialogue: 0,0:00:37.44,0:00:38.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Muda.
Dialogue: 0,0:00:38.77,0:00:43.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika Anda memberi perintah, saya bisa\Nmemanfaatkan dia untuk mendekati Doyo
Dialogue: 0,0:00:43.90,0:00:47.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan merencanakan\Npemenggalan kepala Takauji.
Dialogue: 0,0:00:49.11,0:00:51.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak usah.\NKau nanti terancam.
Dialogue: 0,0:00:51.49,0:00:54.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga tak mau mengkhianati\Ndia yang ingin berteman.
Dialogue: 0,0:00:54.91,0:00:58.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin kita berakhir sebagai teman baik\Nyang hanya bertemu sekali seumur hidup.
Dialogue: 0,0:00:59.46,0:01:01.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon maaf atas saran saya\Nyang kurang pantas.
Dialogue: 0,0:01:02.84,0:01:05.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah dia Tuan Muda junjungan saya.
Dialogue: 0,0:01:07.30,0:01:10.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teruslah hidup dan tunggu waktunya♪
Dialogue: 0,0:01:10.26,0:01:15.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jinjing nyawamu dan tembus takdir♪
Dialogue: 0,0:01:15.10,0:01:18.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hiduplah dalam malu\Ndan kejar mimpimu♪
Dialogue: 0,0:01:18.31,0:01:23.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi orang-orang\Nyang percaya padamu♪
Dialogue: 0,0:01:37.04,0:01:40.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagian besar takkan tercatat\Ndalam sejarah♪
Dialogue: 0,0:01:40.29,0:01:43.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua hal konyol itu♪
Dialogue: 0,0:01:43.80,0:01:47.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membelit dan terurai, lagi dan lagi♪
Dialogue: 0,0:01:47.59,0:01:50.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tarik napas♪
Dialogue: 0,0:01:50.64,0:01:54.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk apa hidup ini dipersembahkan?♪
Dialogue: 0,0:01:54.22,0:01:57.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takdir apa yang menanti?♪
Dialogue: 0,0:01:57.60,0:02:00.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bila rasa bak kutukan♪
Dialogue: 0,0:02:00.48,0:02:04.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan bisa mengikatku♪
Dialogue: 0,0:02:04.82,0:02:07.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teruslah hidup dan tunggu waktunya♪
Dialogue: 0,0:02:07.61,0:02:12.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jinjing nyawamu dan lawan takdir♪
Dialogue: 0,0:02:12.49,0:02:15.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hiduplah dalam malu\Ndan kejar mimpimu♪
Dialogue: 0,0:02:15.66,0:02:20.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi orang-orang\Nyang percaya padamu♪
Dialogue: 0,0:02:20.00,0:02:23.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Iblis, sini,\Nikuti suara tepuk tanganku♪
Dialogue: 0,0:02:23.17,0:02:26.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}(Hei, Iblis, sini,\Nikuti suara tepuk tanganku)♪
Dialogue: 0,0:02:26.76,0:02:30.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hidup itu singkat,\Nmenyanyi dan menarilah♪
Dialogue: 0,0:02:30.13,0:02:34.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bunga akan mekar\Nbagi yang jago kabur♪
Dialogue: 0,0:02:37.68,0:02:40.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, kalian suka apa\Ndari Tuan Muda?
Dialogue: 0,0:02:40.73,0:02:42.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Baik hati!\N- Baik hati!
Dialogue: 0,0:02:43.48,0:02:47.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis desa selalu saja luluh\Nkarena baik hati.
Dialogue: 0,0:02:47.55,0:02:48.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengar, ya.
Dialogue: 0,0:02:48.40,0:02:51.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cowok tanpa gairah itu tak menarik.
Dialogue: 0,0:02:51.45,0:02:55.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pasti pernah merasakan momen\Nmenggairahkan dengan Tuan Muda juga, 'kan?
Dialogue: 0,0:02:58.91,0:03:03.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuh, 'kan! Yang bikin kalian tertarik\Nadalah sisi menggairahkan itu!
Dialogue: 0,0:03:03.21,0:03:04.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mima!
Dialogue: 0,0:03:04.04,0:03:05.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suaramu kencang banget!
Dialogue: 0,0:03:05.25,0:03:07.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Muda!
Dialogue: 0,0:03:07.09,0:03:08.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu dulu!
Dialogue: 0,0:03:08.42,0:03:11.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah kenapa jadi akur juga.
Dialogue: 0,0:03:11.34,0:03:13.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Santai banget.
Dialogue: 0,0:03:13.76,0:03:15.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:03:15.17,0:03:19.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski sudah keliling Kyo berhari-hari,\Nnama Kaisar tetap saja buruk.
Dialogue: 0,0:03:19.95,0:03:23.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, terutama para samurai,\Nbanyak keluhan.
Dialogue: 0,0:03:23.35,0:03:25.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayahanda pernah bilang.
Dialogue: 0,0:03:25.27,0:03:28.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kaisar terlalu pintar.
Dialogue: 0,0:03:29.52,0:03:33.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, dia tidak mengerti perasaan\Norang biasa dan orang tak kompeten.
Dialogue: 0,0:03:33.53,0:03:35.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia putuskan semuanya sendiri.
Dialogue: 0,0:03:35.82,0:03:40.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Andai setidaknya ada seorang menteri\Nyang memahami Kaisar dan rakyat,
Dialogue: 0,0:03:40.62,0:03:44.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kaisar pasti bisa jadi pahlawan sejati.
Dialogue: 0,0:03:46.87,0:03:48.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai jumpa, Tuan Muda.
Dialogue: 0,0:03:48.25,0:03:51.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, terima kasih.\NHari ini menyenangkan.
Dialogue: 0,0:03:55.93,0:03:57.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei.
Dialogue: 0,0:03:58.68,0:04:00.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu di Kyo sampai kapan?
Dialogue: 0,0:04:02.69,0:04:06.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak tahu.\NKurasa sudah tidak lama lagi.
Dialogue: 0,0:04:07.48,0:04:09.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu...
Dialogue: 0,0:04:09.18,0:04:11.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau mengabdi ke Ayahanda?
Dialogue: 0,0:04:11.82,0:04:16.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bisa lebih berkembang\Ndaripada jadi penjaga Suwa.
Dialogue: 0,0:04:20.58,0:04:23.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, Chojumaru! Pas banget!
Dialogue: 0,0:04:23.75,0:04:26.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paman, kenapa berpenampilan\Nseperti tukang kayu?
Dialogue: 0,0:04:26.38,0:04:28.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah, sudah.
Dialogue: 0,0:04:29.13,0:04:34.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Persiapan pemberontakan sudah siap.\NSekarang akan kuungkapkan rencanaku.
Dialogue: 0,0:04:34.51,0:04:37.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Walau masih muda, tapi mereka\Nadalah pengikut setiaku.
Dialogue: 0,0:04:37.87,0:04:41.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh kutunjukkan bersama mereka,\NTuan Kinmune?
Dialogue: 0,0:04:42.47,0:04:45.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika mereka membocorkannya,\Nkau akan mati.
Dialogue: 0,0:04:46.05,0:04:49.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak keberatan\Nselama kepercayaanmu sekuat itu.
Dialogue: 0,0:04:51.44,0:04:54.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini vila baru Tuan Saionji.
Dialogue: 0,0:04:54.65,0:04:59.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bekerja sendiri\Nmerenovasi pemandian ini.
Dialogue: 0,0:05:00.20,0:05:05.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan mengadakan jamuan makan\Ndi vila ini dan mengundang Kaisar.
Dialogue: 0,0:05:05.21,0:05:09.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita sarankan beliau menikmati mandi pertama\Nyang penuh berkah di gedung baru
Dialogue: 0,0:05:09.63,0:05:12.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan saat beliau memasuki\Nruang ganti ini...
Dialogue: 0,0:05:22.26,0:05:26.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lantainya terbuka, Kaisar jatuh\Nterbalik di atas pedang.
Dialogue: 0,0:05:26.64,0:05:29.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bunuh Kaisar di sini.
Dialogue: 0,0:05:29.36,0:05:32.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah sinyal memulai perang dari kami.
Dialogue: 0,0:05:34.77,0:05:37.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah jatuhnya Keshogunan Kamakura,
Dialogue: 0,0:05:37.57,0:05:41.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kaisar terang-terangan mendiskriminasi\Nkeluarga Saionji yang dekat dengan Hojo.
Dialogue: 0,0:05:42.24,0:05:46.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika tidak merenggut nyawa Kaisar\Ndan mengembalikan Hojo ke takhta,
Dialogue: 0,0:05:46.08,0:05:49.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tidak akan pernah bisa naik pangkat.
Dialogue: 0,0:05:49.91,0:05:52.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian sudah gila?
Dialogue: 0,0:05:52.59,0:05:55.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sekalipun tahu\Nkalau membunuh Kaisar
Dialogue: 0,0:05:55.55,0:05:57.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah dosa besar\Nyang tak bisa dianggap remeh.
Dialogue: 0,0:05:58.92,0:06:04.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami dari Kamakura tidak mengakui\NKaisar saat ini secara resmi.
Dialogue: 0,0:06:04.26,0:06:08.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membunuh kaisar palsu\Nbukanlah pengkhianatan.
Dialogue: 0,0:06:08.56,0:06:11.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang hanyalah\Nmasa kediktatoran Kaisar.
Dialogue: 0,0:06:11.69,0:06:15.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan hilangnya pemimpin,\NKyo bakal kacau balau.
Dialogue: 0,0:06:15.11,0:06:17.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita manfaatkan kesempatan itu\Nbentuk pasukan di penjuru negeri
Dialogue: 0,0:06:17.65,0:06:19.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan merebut kembali takhta!
Dialogue: 0,0:06:25.07,0:06:30.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika melanjutkan rencana itu,\Nkuil keemasan akan berdiri di sini.
Dialogue: 0,0:06:30.79,0:06:33.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu pertanda baik, Miko!
Dialogue: 0,0:06:33.41,0:06:37.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Artinya keluargaku sangat makmur\Nsampai bisa membangun itu!
Dialogue: 0,0:06:37.55,0:06:40.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, Tuan Kinmune!\NKita laksanakan rencana tiga hari lagi.
Dialogue: 0,0:06:40.72,0:06:43.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo minum dan rayakan dulu!
Dialogue: 0,0:06:46.60,0:06:48.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya kita hentikan mereka!
Dialogue: 0,0:06:48.81,0:06:51.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membunuh Kaisar\Nadalah tindakan terburuk!
Dialogue: 0,0:06:51.23,0:06:53.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan hanya tak bisa\Nmengumpulkan sekutu,
Dialogue: 0,0:06:53.86,0:06:56.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}nama Hojo akan tercoreng\Nribuan tahun mendatang.
Dialogue: 0,0:06:56.73,0:06:58.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Muda!
Dialogue: 0,0:06:59.07,0:07:00.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syu...
Dialogue: 0,0:07:00.61,0:07:02.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah!
Dialogue: 0,0:07:03.28,0:07:07.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, tidak. Aku sempat diberi tahu\NTuan Yorishige sebelum berangkat.
Dialogue: 0,0:07:08.53,0:07:14.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Yasuie belum memberi tahu rencananya\Npada Tuan, tapi itu pasti gagal.
Dialogue: 0,0:07:14.42,0:07:16.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya melihat masa depan itu.
Dialogue: 0,0:07:16.87,0:07:23.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, meski berakhir gagal,\Ntapi tidak salah lagi Kyo bakal kacau.
Dialogue: 0,0:07:23.18,0:07:27.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekacauan itu juga pas\Nuntuk memulai perang besar.
Dialogue: 0,0:07:27.64,0:07:31.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah rencana itu gagal,\Nmisi Regu Tumujaka di Kyo
Dialogue: 0,0:07:31.14,0:07:35.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah melarikan Tuan Yasuie\Nke Shinano secepat mungkin.
Dialogue: 0,0:07:35.06,0:07:37.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah itu tinggal adu kecepatan.
Dialogue: 0,0:07:37.77,0:07:41.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu tiba di Shinano,\Noperasi tempur langsung dimulai.
Dialogue: 0,0:07:41.98,0:07:43.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu katanya.
Dialogue: 0,0:07:44.45,0:07:45.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata begitu.
Dialogue: 0,0:07:45.89,0:07:49.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus melarikan Paman\Ndengan selamat.
Dialogue: 0,0:07:49.74,0:07:52.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita butuh persiapan yang matang\Nsebelum rencana dilaksanakan.
Dialogue: 0,0:07:53.29,0:07:56.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masalahnya adalah bagaimana\Nkita kabur dari Kyo?
Dialogue: 0,0:07:56.73,0:07:59.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita telusuri jalur pelarian mulai besok.
Dialogue: 0,0:07:59.55,0:08:03.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana dengan Mima?\NKita janjian bermain dengannya besok.
Dialogue: 0,0:08:03.68,0:08:05.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar aku tolak ajakannya.
Dialogue: 0,0:08:05.72,0:08:10.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika Kakanda yang jujur yang bicara,\NMima yang peka pasti sadar.
Dialogue: 0,0:08:14.10,0:08:18.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakanda tepar karena demam.\NMaaf, ya.
Dialogue: 0,0:08:18.19,0:08:21.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waduh, apa aku berlebihan\Nmengajaknya keliling?
Dialogue: 0,0:08:21.40,0:08:23.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya sudah, deh.
Dialogue: 0,0:08:23.48,0:08:27.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Shizuku. Tuan Muda itu\Nsebenarnya siapa?
Dialogue: 0,0:08:27.69,0:08:31.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti yang kubilang,\Ndia anak penjaga Kuil Suwa.
Dialogue: 0,0:08:31.08,0:08:34.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Urusan kami sudah selesai,\Njadi sebentar lagi kami bakal pergi dari Kyo.
Dialogue: 0,0:08:35.20,0:08:37.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa membaca isi pikiranmu.
Dialogue: 0,0:08:37.71,0:08:41.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus, ini ucapan terima kasih dari Kakanda\Nkarena Mima sudah mengajak keliling.
Dialogue: 0,0:08:41.55,0:08:43.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Serius? Apa itu?
Dialogue: 0,0:08:43.59,0:08:45.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sisir? Cermin?
Dialogue: 0,0:08:46.97,0:08:48.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Samurai desa!
Dialogue: 0,0:08:50.60,0:08:52.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jalan ini bagus banget!
Dialogue: 0,0:08:52.93,0:08:55.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepi siang dan malam!
Dialogue: 0,0:08:55.06,0:08:58.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak tembok rusak\Nuntuk sembunyi juga!
Dialogue: 0,0:08:58.27,0:09:01.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jalan seperti ini di Kamakura\Njuga sempurna untuk kabur!
Dialogue: 0,0:09:02.36,0:09:04.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Muda heboh banget.
Dialogue: 0,0:09:04.40,0:09:06.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia memang ahli soal kabur.
Dialogue: 0,0:09:06.74,0:09:10.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, kau suka jalan kabur ini, ya?
Dialogue: 0,0:09:10.58,0:09:13.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seleramu bagus.\NAku juga suka.
Dialogue: 0,0:09:13.45,0:09:18.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Samurai harus selalu mengingat\Njalan pelarian seperti ini.
Dialogue: 0,0:09:18.62,0:09:22.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agar bisa melarikan Kaisar\Nsaat bandit menyerang Kyo.
Dialogue: 0,0:09:25.46,0:09:27.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf tiba-tiba mengajak bicara.
Dialogue: 0,0:09:30.22,0:09:32.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau anak samurai di area sini?
Dialogue: 0,0:09:32.39,0:09:34.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, bukan, kami juga berwisata.
Dialogue: 0,0:09:34.56,0:09:36.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, rupanya begitu.
Dialogue: 0,0:09:37.43,0:09:39.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo pergi, Tuan Muda.
Dialogue: 0,0:09:39.29,0:09:42.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia terlihat linglung dan lemah,\Ntapi sepertinya dia memihak Kaisar.
Dialogue: 0,0:09:42.98,0:09:44.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa repot kalau dicurigai.
Dialogue: 0,0:09:45.07,0:09:46.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya...
Dialogue: 0,0:09:46.61,0:09:48.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shizuku, lihat petanya.
Dialogue: 0,0:09:48.11,0:09:49.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:09:49.19,0:09:51.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempat yang kita kunjungi selanjutnya...
Dialogue: 0,0:10:01.00,0:10:04.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ngeri. Dia linglung\Ndan mencurigakan sejak tadi.
Dialogue: 0,0:10:04.55,0:10:05.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan.
Dialogue: 0,0:10:05.83,0:10:08.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bukan sekadar\Norang mencurigakan.
Dialogue: 0,0:10:11.35,0:10:14.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan menganggukkan kepala\Ndan menoleh ke sana kemari,
Dialogue: 0,0:10:14.51,0:10:17.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia menilai dari segala arah!
Dialogue: 0,0:10:17.89,0:10:22.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Postur tubuh, sikap,\Npanjang langkah, dan jarak kita!
Dialogue: 0,0:10:22.36,0:10:26.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski lawannya anak-anak, dia tetap\Nmemastikan cara untuk kabur!
Dialogue: 0,0:10:26.60,0:10:29.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu kuda-kuda jago kabur!
Dialogue: 0,0:10:30.49,0:10:35.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa menyadari teknik rahasiaku\Nuntuk kabur di usia semuda itu.
Dialogue: 0,0:10:36.58,0:10:38.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kuat!\N- Kuat!
Dialogue: 0,0:10:41.33,0:10:42.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika aku
Dialogue: 0,0:10:42.63,0:10:44.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bertarung serius melawannya,
Dialogue: 0,0:10:44.29,0:10:46.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- mungkin aku bisa kalah kabur!\N- mungkin aku bisa kalah kabur!
Dialogue: 0,0:10:47.67,0:10:51.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke-Ketegangan aneh apa ini?!
Dialogue: 0,0:10:51.34,0:10:56.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini? Rasanya seperti melihat\Npertarungan tingkat tinggi yang konyol.
Dialogue: 0,0:10:59.01,0:11:00.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau memperkenalkan diri?
Dialogue: 0,0:11:01.60,0:11:03.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, kau tidak perlu.
Dialogue: 0,0:11:03.77,0:11:07.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak sopan menanyakan nama anak-anak\Nyang menyelidiki jalan kabur.
Dialogue: 0,0:11:09.48,0:11:12.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namaku Kusunoki Masashige.
Dialogue: 0,0:11:13.61,0:11:17.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hamba hanyalah pejabat rendahan\Nyang berasal dari keluarga tuan tanah kaya.
Dialogue: 0,0:11:22.66,0:11:25.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dewa Perang, Kusunoki Masashige.
Dialogue: 0,0:11:25.88,0:11:28.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya dengan pasukan kecil,
Dialogue: 0,0:11:28.30,0:11:31.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ia terus mempermainkan dan mengalahkan\Npasukan besar Keshogunan Kamakura.
Dialogue: 0,0:11:31.55,0:11:35.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bakat militernya jadi kekuatan utama dalam\Nupaya Kaisar Go-Daigo merebut takhta.
Dialogue: 0,0:11:35.43,0:11:38.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kehebatannya dalam strategi perang\Nsangat menonjol dalam sejarah Jepang.
Dialogue: 0,0:11:38.89,0:11:42.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ia adalah pahlawan besar yang namanya\Ndihiasi oleh berbagai legenda.
Dialogue: 0,0:11:43.10,0:11:45.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo pergi, Tuan Muda.\NDia berbahaya.
Dialogue: 0,0:11:45.56,0:11:48.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika identitas kita terungkap,\Nsemuanya berakhir.
Dialogue: 0,0:11:49.52,0:11:53.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pria bernama Shokan\Nmemuji strategi militermu.
Dialogue: 0,0:11:53.49,0:11:55.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shokan?
Dialogue: 0,0:11:57.20,0:12:02.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Shokan bejat berkepala plontos\Ndan bermata keruh itu, ya?
Dialogue: 0,0:12:02.04,0:12:05.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami membuatnya seolah-olah mati\Ndengan menggunakan mayat pengganti.
Dialogue: 0,0:12:05.00,0:12:06.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi kangen.
Dialogue: 0,0:12:06.46,0:12:08.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kabarnya sekarang?
Dialogue: 0,0:12:08.30,0:12:10.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kupikir sudah membunuhnya,\Ntapi ternyata masih hidup.
Dialogue: 0,0:12:10.71,0:12:11.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakanda!
Dialogue: 0,0:12:15.14,0:12:17.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak-anak yang menarik!
Dialogue: 0,0:12:17.80,0:12:22.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia memang penjahat\Nyang pantas dibunuh,
Dialogue: 0,0:12:22.10,0:12:25.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku syukuri saja\Ndia masih hidup di suatu tempat.
Dialogue: 0,0:12:26.23,0:12:27.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi...
Dialogue: 0,0:12:28.31,0:12:30.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kau inginkan dariku?
Dialogue: 0,0:12:34.07,0:12:38.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau baru saja mengungkap informasi\Nyang dapat membahayakan dirimu.
Dialogue: 0,0:12:38.86,0:12:43.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal kau sama sepertiku,\Norang yang paling utamakan keselamatan.
Dialogue: 0,0:12:44.08,0:12:47.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Artinya, ada sesuatu\Nyang kau inginkan dariku
Dialogue: 0,0:12:47.04,0:12:50.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sampai berani membuka diri kepadaku.
Dialogue: 0,0:12:51.51,0:12:53.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa menahan\Nrasa keterikatan kami.
Dialogue: 0,0:12:54.50,0:12:58.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlepas dari kawan atau lawan,\Nada yang harus kupelajari dari pria ini.
Dialogue: 0,0:12:59.14,0:13:00.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo? Apa aku salah?
Dialogue: 0,0:13:00.93,0:13:02.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Kusunoki.
Dialogue: 0,0:13:03.60,0:13:05.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada musuh yang ingin kukalahkan.
Dialogue: 0,0:13:06.02,0:13:10.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Musuh-musuhku unggul dalam strategi militer,\Nketerampilan, dan kekuatan pasukan,
Dialogue: 0,0:13:10.27,0:13:13.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi aku tidak yakin bisa menang\Nhanya dengan terus melarikan diri.
Dialogue: 0,0:13:13.82,0:13:18.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau ingin tahu cara orang lemah\Nmengalahkan orang kuat, ya.
Dialogue: 0,0:13:19.70,0:13:21.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, Pemuda Mencurigakan!
Dialogue: 0,0:13:21.91,0:13:25.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau berani datang\Nsendirian ke kediamanku?
Dialogue: 0,0:13:27.58,0:13:29.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa Tuan Muda baik-baik saja?
Dialogue: 0,0:13:29.92,0:13:31.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin tidak apa-apa.
Dialogue: 0,0:13:31.29,0:13:34.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku rasa dia bukan tipe orang\Nyang akan menjebak anak-anak.
Dialogue: 0,0:13:36.46,0:13:38.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi ini di luar dugaan.
Dialogue: 0,0:13:38.26,0:13:42.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kusunoki Masashige yang kehebatan\Nmiliternya terkenal di seluruh Jepang...
Dialogue: 0,0:13:42.72,0:13:47.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata orangnya\Nterkadang merendah begitu.
Dialogue: 0,0:13:47.35,0:13:48.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayang!
Dialogue: 0,0:13:48.85,0:13:51.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu nyomot makanan pegawai lagi!
Dialogue: 0,0:13:51.40,0:13:54.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, maaf. Aku agak lapar.
Dialogue: 0,0:13:58.91,0:14:00.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa anak ini?!
Dialogue: 0,0:14:00.32,0:14:01.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lari!
Dialogue: 0,0:14:01.32,0:14:02.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu!
Dialogue: 0,0:14:03.57,0:14:06.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu juga kabur dari istrimu?
Dialogue: 0,0:14:07.04,0:14:09.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah seenaknya mengangkat pasukan\Ndan membuatnya menderita,
Dialogue: 0,0:14:09.46,0:14:11.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku jadi tidak enak.
Dialogue: 0,0:14:11.58,0:14:16.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teknik Kusunoki adalah melarikan diri\Nsementara lalu menghiburnya saat tenang.
Dialogue: 0,0:14:18.13,0:14:19.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, Nak.
Dialogue: 0,0:14:19.93,0:14:23.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau ingin tahu cara orang lemah\Nmenang melawan orang kuat, 'kan?
Dialogue: 0,0:14:24.18,0:14:27.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, mau coba latihan tanding?
Dialogue: 0,0:14:27.18,0:14:30.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gunakan teknik yang menurutmu\Nberpeluang besar untuk menang.
Dialogue: 0,0:14:31.81,0:14:34.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma akan membalas\Ndengan satu serangan.
Dialogue: 0,0:14:34.27,0:14:37.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan melihat itu, aku bisa\Nmemberikan nasihat yang diperlukan.
Dialogue: 0,0:14:38.36,0:14:41.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau... kau takut?
Dialogue: 0,0:14:41.41,0:14:45.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan kekuatanku yang berhasil\Nmengalahkan pasukan Hojo?
Dialogue: 0,0:14:48.16,0:14:49.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak takut.
Dialogue: 0,0:14:58.71,0:15:00.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau belajar teknik itu dari siapa?
Dialogue: 0,0:15:00.70,0:15:03.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengikutku yang kehilangan satu matanya.
Dialogue: 0,0:15:03.76,0:15:07.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mengajariku berbagai teknik\Nyang cocok untukku.
Dialogue: 0,0:15:07.47,0:15:09.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia guru yang baik.
Dialogue: 0,0:15:10.22,0:15:11.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat mengumpulkan pasukan
Dialogue: 0,0:15:11.77,0:15:14.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan berhadapan dengan pasukan Kamakura\Nyang jumlahnya 100 kali lipat,
Dialogue: 0,0:15:14.44,0:15:17.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pasukan di pihakku hanyalah\Nkumpulan orang-orang amatir.
Dialogue: 0,0:15:17.69,0:15:20.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan guru untuk mengajarkan\Nilmu pedang pun sulit ditemukan.
Dialogue: 0,0:15:21.45,0:15:23.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Bagaimana caranya menang?"
Dialogue: 0,0:15:24.20,0:15:26.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kutunjukkan teknik Kusunoki.
Dialogue: 0,0:15:43.55,0:15:45.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ditangkis dengan onigiri?!
Dialogue: 0,0:15:45.76,0:15:50.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melihat posturmu, aku tahu kau mau\Nmenebas arteriku sambil kabur.
Dialogue: 0,0:15:50.14,0:15:53.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan kata lain, tebasan presisi\Nberdaya serang rendah.
Dialogue: 0,0:15:53.30,0:15:56.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cukup mencegahnya\Nmenembus arteriku.
Dialogue: 0,0:15:56.61,0:16:00.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bola nasi keras ini pun\Ncukup berfungsi sebagai tameng.
Dialogue: 0,0:16:02.94,0:16:07.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak menyangka dia menggunakan\Nbola nasi dalam pertarungan pedang.
Dialogue: 0,0:16:09.49,0:16:12.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak pandai kabur\Nkarena berpikir begitu.
Dialogue: 0,0:16:12.87,0:16:15.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau terpaku untuk menang\Nmenggunakan pedang.
Dialogue: 0,0:16:17.63,0:16:22.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau terobsesi menang dengan pedang,\Ncuma yang jago berpedang yang akan menang.
Dialogue: 0,0:16:22.55,0:16:27.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau terobsesi menang dengan panah,\Nhanya pemanah terampil yang akan menang.
Dialogue: 0,0:16:34.64,0:16:37.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rahasia agar orang lemah menang\Nmelawan orang kuat
Dialogue: 0,0:16:37.02,0:16:41.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah melepaskan diri\Ndari sangkar prasangka.
Dialogue: 0,0:16:41.99,0:16:43.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Kusunoki!
Dialogue: 0,0:16:43.74,0:16:46.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang terperangkap sangkar\Ntidak akan bisa kabur
Dialogue: 0,0:16:46.91,0:16:49.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan takkan menemukan pilihan\Nselain yang ada di hadapannya.
Dialogue: 0,0:16:49.99,0:16:53.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski tidak bisa menggunakan pedang\Ndengan baik, kita bisa melubangi batang kayu
Dialogue: 0,0:16:53.91,0:16:57.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk menampung air hujan\Nsebagai persediaan saat terkepung.
Dialogue: 0,0:16:57.56,0:16:59.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski tidak bisa menggunakan panah,
Dialogue: 0,0:16:59.09,0:17:02.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita bisa menuangkan minyak\Nuntuk membakar tangga.
Dialogue: 0,0:17:02.63,0:17:06.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bayi pun bisa BAB lalu melemparnya.
Dialogue: 0,0:17:07.30,0:17:09.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasukan dan senjata untuk perang.
Dialogue: 0,0:17:09.76,0:17:14.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama bisa menunjukkan kekuatan otot\Ndan teknik walau hanya sesaat,
Dialogue: 0,0:17:14.23,0:17:16.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}itu bisa membuat kita menang\Nmelawan musuh yang 100 kali lebih kuat.
Dialogue: 0,0:17:17.81,0:17:22.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengetahuan, tradisi, estetika,\Nkeberhasilan masa lalu, kekuatan militer besar...
Dialogue: 0,0:17:22.57,0:17:26.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang terkurung dalam\Nsangkar semacam itu memang kuat.
Dialogue: 0,0:17:26.07,0:17:30.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi jika celah sangkarnya ditusuk,\Nmereka jadi rapuh karena tak bisa kabur.
Dialogue: 0,0:17:30.74,0:17:32.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lantas aku harus apa?
Dialogue: 0,0:17:32.45,0:17:33.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mudah saja.
Dialogue: 0,0:17:34.45,0:17:37.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gagasan kokoh hanyalah\Nilusi dalam pikiran.
Dialogue: 0,0:17:37.96,0:17:41.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maka, memecahkannya juga\Ndengan pikiran manusia.
Dialogue: 0,0:17:55.10,0:17:58.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang lemah tidak sepatutnya\Nterkurung dalam sangkar.
Dialogue: 0,0:17:58.93,0:18:03.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau disebut penakut atau pengecut,\Nkau harus kabur dengan percaya diri.
Dialogue: 0,0:18:06.44,0:18:09.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa burung tampak\Nbegitu bebas dan keren?
Dialogue: 0,0:18:09.82,0:18:13.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu karena seluruh langit ini\Nadalah tempat kaburnya.
Dialogue: 0,0:18:14.49,0:18:16.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak terikat, tidak terkurung.
Dialogue: 0,0:18:16.83,0:18:20.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pilihlah selalu jalan kabur\Nyang luas, tinggi, dan indah!
Dialogue: 0,0:18:21.12,0:18:23.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kabur adalah hidup.
Dialogue: 0,0:18:23.50,0:18:26.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah keyakinanku.
Dialogue: 0,0:18:31.51,0:18:34.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak, Tuan Kusunoki!
Dialogue: 0,0:18:34.18,0:18:37.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi percaya diri untuk kabur\Nberkat kata-katamu!
Dialogue: 0,0:18:37.43,0:18:42.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena aku sakit hati disebut\Nkemampuan bertarungku
Dialogue: 0,0:18:42.56,0:18:44.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}setara kelinci dan bocah kabur telanjang!
Dialogue: 0,0:18:44.36,0:18:46.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jahat sekali hinaannya.
Dialogue: 0,0:18:46.86,0:18:48.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nak!
Dialogue: 0,0:18:48.74,0:18:51.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kuberi satu hal bagus.
Dialogue: 0,0:18:53.49,0:18:54.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berantakan.
Dialogue: 0,0:18:55.12,0:18:59.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini karena aku mencoba banyak benda\Nyang mungkin berguna di medan perang.
Dialogue: 0,0:19:00.79,0:19:01.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketemu.
Dialogue: 0,0:19:01.96,0:19:02.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:19:03.23,0:19:07.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini catatan sejarah yang kutulis\Natas perintah Kaisar.
Dialogue: 0,0:19:07.21,0:19:11.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Strategi militer apa yang kugunakan\Ndalam pertempuran terakhir...
Dialogue: 0,0:19:11.51,0:19:13.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya tertulis di situ.
Dialogue: 0,0:19:13.96,0:19:16.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu draf dari yang kukirimkan ke Kaisar.
Dialogue: 0,0:19:18.97,0:19:20.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tulisan ceker ayam!
Dialogue: 0,0:19:20.31,0:19:23.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya cuma draf, jadi kubiarkan begitu saja\Nkarena tidak ada yang bakal baca.
Dialogue: 0,0:19:23.90,0:19:27.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, pelan-pelan saja dalami itu.
Dialogue: 0,0:19:27.48,0:19:28.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya...
Dialogue: 0,0:19:28.78,0:19:32.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi jangan tunjukkan itu pada siapa pun.
Dialogue: 0,0:19:32.03,0:19:34.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya itu cuma boleh\Nkutunjukkan ke Kaisar.
Dialogue: 0,0:19:34.78,0:19:36.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu...
Dialogue: 0,0:19:37.82,0:19:40.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini strategi militer bagi yang suka kabur.
Dialogue: 0,0:19:40.82,0:19:43.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika orang yang tak mengerti\Nkabur membaca ini,
Dialogue: 0,0:19:43.08,0:19:44.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}nanti bisa disalahgunakan.
Dialogue: 0,0:19:45.79,0:19:50.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku serahkan itu padamu sebagai\Nsesama orang yang suka kabur.
Dialogue: 0,0:19:50.59,0:19:52.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengerti, Nak?
Dialogue: 0,0:19:53.67,0:19:57.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya! Terima kasih, Tuan Masashige!
Dialogue: 0,0:19:58.09,0:20:00.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Muda keluar! Syukurlah!
Dialogue: 0,0:20:00.89,0:20:03.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih atas waktu bermanfaatnya.
Dialogue: 0,0:20:03.39,0:20:06.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mendapat banyak\Npengalaman berharga di Kyo.
Dialogue: 0,0:20:06.44,0:20:08.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, pengalaman kali ini\Nsungguh istimewa.
Dialogue: 0,0:20:09.90,0:20:11.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hidup itu singkat.
Dialogue: 0,0:20:11.74,0:20:14.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nikmatilah kabur sepuasmu.
Dialogue: 0,0:20:16.15,0:20:19.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di usia semuda itu, matanya\Nmemancarkan takdir yang berat.
Dialogue: 0,0:20:20.24,0:20:23.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permusuhan yang sangat jelas\Nterhadap pemerintahan saat ini.
Dialogue: 0,0:20:24.75,0:20:26.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin, ah.
Dialogue: 0,0:20:27.12,0:20:28.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayahanda!
Dialogue: 0,0:20:29.79,0:20:31.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, ada apa, Tamonmaru?
Dialogue: 0,0:20:31.80,0:20:34.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada utusan Tuan Takauji datang\Nsaat Ayahanda pergi.
Dialogue: 0,0:20:36.22,0:20:41.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya, dia bakal datang terlambat sekitar\Njam anjing untuk jamuan dua hari lagi.
Dialogue: 0,0:20:41.04,0:20:42.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang ada apa?
Dialogue: 0,0:20:42.81,0:20:44.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya ada urusan di markas prajurit,
Dialogue: 0,0:20:44.85,0:20:48.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia akan langsung\Ndatang kemari setelah selesai.
Dialogue: 0,0:20:48.31,0:20:49.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:20:49.57,0:20:52.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, Ibunda mencari Ayahanda.
Dialogue: 0,0:20:52.40,0:20:54.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih belum tenang juga?
Dialogue: 0,0:20:54.45,0:20:56.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya sulit untuk sementara waktu.
Dialogue: 0,0:20:57.40,0:21:00.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menu makan malam ini\Nmungkin cuma acar.
Dialogue: 0,0:21:00.29,0:21:03.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan berbagi sepotong\Ndengan Ayahanda.
Dialogue: 0,0:21:38.78,0:21:40.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Muda.
Dialogue: 0,0:21:40.40,0:21:43.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya harap saran saya kali ini diterima.
Dialogue: 0,0:21:44.66,0:21:47.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita sudah tahu waktu\Ndan rute yang akan dia lalui.
Dialogue: 0,0:21:54.54,0:21:58.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini kesempatan sekali seumur hidup\Nuntuk membunuh Takauji.
Dialogue: 0,0:21:58.72,0:22:00.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika ingin merebut takhta,
Dialogue: 0,0:22:00.79,0:22:02.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita tak boleh melewatkannya.
Dialogue: 0,0:22:06.73,0:22:11.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bila ingin romantis♪
Dialogue: 0,0:22:11.61,0:22:14.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cintai aku lebih dari siapa pun♪
Dialogue: 0,0:22:20.20,0:22:23.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kamu orang yang baik♪
Dialogue: 0,0:22:23.58,0:22:27.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bakal baik ke gadis itu juga, 'kan?♪
Dialogue: 0,0:22:27.33,0:22:30.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa, tidak masalah♪
Dialogue: 0,0:22:30.67,0:22:34.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong bawakan\Nsemua barang beratnya, ya♪
Dialogue: 0,0:22:34.38,0:22:37.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu keren di depan orang-orang♪
Dialogue: 0,0:22:37.55,0:22:41.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kamu imut saat kita berduaan♪
Dialogue: 0,0:22:41.34,0:22:44.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setia seperti anjing♪
Dialogue: 0,0:22:44.68,0:22:50.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan menghilang seperti kucing, ya♪
Dialogue: 0,0:22:51.35,0:22:54.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terkadang aku sedih♪
Dialogue: 0,0:22:54.86,0:22:58.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi sentimental\Nsaat menatap bintang♪
Dialogue: 0,0:22:58.44,0:23:05.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini, kamu dengan siapa\Ndan sedang apa?♪
Dialogue: 0,0:23:05.58,0:23:09.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, jika kamu mau\Nmencintai dan dicintai♪
Dialogue: 0,0:23:09.54,0:23:13.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan selalu membuatmu berdebar♪
Dialogue: 0,0:23:13.00,0:23:16.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika tidak memilihku♪
Dialogue: 0,0:23:16.59,0:23:20.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menjatuhkanmu ke neraka♪
Dialogue: 0,0:23:20.26,0:23:23.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mendengarmu♪
Dialogue: 0,0:23:23.72,0:23:27.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau tahu lagi♪
Dialogue: 0,0:23:27.47,0:23:31.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bila ingin romantis♪
Dialogue: 0,0:23:31.10,0:23:34.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cintai aku lebih dari siapa pun♪
Dialogue: 0,0:23:38.69,0:23:40.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo!
