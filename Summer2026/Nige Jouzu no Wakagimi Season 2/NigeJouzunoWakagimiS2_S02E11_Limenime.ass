Dialogue: 0,0:00:05.40,0:00:09.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dua tahun lalu,\NKeshogunan Kamakura hancur
Dialogue: 0,0:00:09.07,0:00:11.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena pengkhianatan\NAshikaga Takauji.
Dialogue: 0,0:00:11.82,0:00:17.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pewaris keshogunan, Hojo Tokiyuki,\Ndi bawah perlindungan Suwa Yorishige,
Dialogue: 0,0:00:17.20,0:00:22.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}membentuk kekuatan di Shinano sambil\Nmenunggu kesempatan merebut Kamakura.
Dialogue: 0,0:00:22.54,0:00:26.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan militer. Moral.\NMomen. Kesiapan mental.
Dialogue: 0,0:00:26.88,0:00:29.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua yang diperlukan sudah ada!
Dialogue: 0,0:00:31.80,0:00:33.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktunya telah tiba.
Dialogue: 0,0:00:34.64,0:00:37.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo mulai perang merebut takhta.
Dialogue: 0,0:00:39.31,0:00:42.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teruslah hidup dan tunggu waktunya ♪
Dialogue: 0,0:00:42.27,0:00:47.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jinjing nyawamu dan tembus takdir ♪
Dialogue: 0,0:00:47.11,0:00:50.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hiduplah dalam malu\Ndan kejar mimpimu ♪
Dialogue: 0,0:00:50.32,0:00:55.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi orang-orang\Nyang percaya padamu ♪
Dialogue: 0,0:01:09.05,0:01:12.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagian besar takkan tercatat\Ndalam sejarah ♪
Dialogue: 0,0:01:12.30,0:01:15.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua hal konyol itu ♪
Dialogue: 0,0:01:15.81,0:01:19.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membelit dan terurai, lagi dan lagi ♪
Dialogue: 0,0:01:19.60,0:01:22.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tarik napas ♪
Dialogue: 0,0:01:22.65,0:01:26.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk apa hidup ini dipersembahkan?♪
Dialogue: 0,0:01:26.23,0:01:29.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takdir apa yang menanti?♪
Dialogue: 0,0:01:29.61,0:01:32.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bila rasa bak kutukan ♪
Dialogue: 0,0:01:32.49,0:01:36.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan bisa mengikatku ♪
Dialogue: 0,0:01:36.83,0:01:39.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teruslah hidup dan tunggu waktunya ♪
Dialogue: 0,0:01:39.62,0:01:44.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jinjing nyawamu dan lawan takdir ♪
Dialogue: 0,0:01:44.50,0:01:47.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hiduplah dalam malu\Ndan kejar mimpimu ♪
Dialogue: 0,0:01:47.67,0:01:52.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi orang-orang\Nyang percaya padamu ♪
Dialogue: 0,0:01:52.00,0:01:55.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Iblis, sini,\Nikuti suara tepuk tanganku ♪
Dialogue: 0,0:01:55.18,0:01:58.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}(Hei, Iblis, sini,\Nikuti suara tepuk tanganku)♪
Dialogue: 0,0:01:58.75,0:02:02.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hidup itu singkat,\Nmenyanyi dan menarilah ♪
Dialogue: 0,0:02:02.14,0:02:06.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bunga akan mekar\Nbagi yang jago kabur ♪
Dialogue: 0,0:02:09.72,0:02:11.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kaisar baik-baik saja?
Dialogue: 0,0:02:11.99,0:02:14.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ulah siapa?!
Dialogue: 0,0:02:14.78,0:02:18.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sementara itu, Kyo jatuh dalam kekacauan
Dialogue: 0,0:02:18.91,0:02:20.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena percobaan pembunuhan Kaisar.
Dialogue: 0,0:02:21.19,0:02:24.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kabarnya, Takauji diserang\Ndi hari yang sama!
Dialogue: 0,0:02:25.20,0:02:27.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa lagi yang bersekongkol dengannya?!
Dialogue: 0,0:02:27.42,0:02:29.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin dia melakukannya sendirian!
Dialogue: 0,0:02:29.63,0:02:34.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masalahnya, Tuan Saionji\Ntidak mau buka mulut.
Dialogue: 0,0:02:34.22,0:02:36.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perketat pertahanan.
Dialogue: 0,0:02:36.63,0:02:40.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Percobaan pembunuhan atas aku\Ndan Takauji bersamaan.
Dialogue: 0,0:02:40.74,0:02:44.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada kemungkinan mereka\Nakan menyerang Kyo selanjutnya.
Dialogue: 0,0:02:44.85,0:02:49.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perintahkan Ashikaga\Npanggil samurai dari Kanto
Dialogue: 0,0:02:49.44,0:02:51.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan lindungi Kyo.
Dialogue: 0,0:02:51.52,0:02:52.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:02:53.73,0:02:55.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Takauji!
Dialogue: 0,0:02:56.03,0:02:58.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berikut dekret dari Kaisar.
Dialogue: 0,0:02:58.70,0:03:02.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para bangsawan istana sudah\Ntidak mampu menanganinya sendiri.
Dialogue: 0,0:03:02.05,0:03:04.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Barangkali mereka berpikir sekarang\Ncuma bisa bergantung pada samurai.
Dialogue: 0,0:03:04.96,0:03:08.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa yang memulai kerusuhan ini?
Dialogue: 0,0:03:08.75,0:03:12.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak-anak itu, intuisiku\Nbilang mereka tidak penting,
Dialogue: 0,0:03:13.25,0:03:15.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi seharusnya tidak kubiarkan kabur.
Dialogue: 0,0:03:16.55,0:03:19.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa sangka intuisiku keliru.
Dialogue: 0,0:03:20.68,0:03:24.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bertemu putri Sasaki Doyo,\Nbertemu Kusunoki Masashige,
Dialogue: 0,0:03:24.14,0:03:26.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan gagal membunuh Ashikaga Takauji?!
Dialogue: 0,0:03:26.98,0:03:30.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak bisa melihat sejauh itu?
Dialogue: 0,0:03:30.06,0:03:33.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma punya firasat Tuan Tokiyuki\Nbakal pulang dengan selamat.
Dialogue: 0,0:03:33.82,0:03:38.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak menyangka Tuan\Nmengalami itu semua sekaligus.
Dialogue: 0,0:03:38.35,0:03:43.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, aku sudah membahayakan diri\Ndan tidak sadar posisi.
Dialogue: 0,0:03:43.07,0:03:44.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.
Dialogue: 0,0:03:44.45,0:03:47.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hasilnya jauh lebih bagus.
Dialogue: 0,0:03:47.48,0:03:50.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekacauan di Kyo saat ini\Npasti sedang tinggi-tingginya.
Dialogue: 0,0:03:51.71,0:03:55.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekaranglah waktu terbaik\Nuntuk memulai perang besar.
Dialogue: 0,0:03:57.25,0:03:59.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami sudah menghindari\Npengawasan Regu Tengu
Dialogue: 0,0:03:59.72,0:04:03.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan sudah menyelesaikan\Npersiapan perang.
Dialogue: 0,0:04:03.43,0:04:04.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hal yang harus ditentukan terakhir
Dialogue: 0,0:04:04.97,0:04:07.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah mau menyerang Kamakura\Ndari jalan mana.
Dialogue: 0,0:04:07.96,0:04:11.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami ingin Tuan Tokiyuki sebagai\NPanglima Tertinggi untuk memilih.
Dialogue: 0,0:04:12.60,0:04:16.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurut pengikut saya, rute paling kuat\Nadalah jalur selatan yang terpendek.
Dialogue: 0,0:04:17.23,0:04:21.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu jalur tercepat untuk menerobos Takeda\Ndari Kai yang pertahanannya kuat.
Dialogue: 0,0:04:22.20,0:04:25.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satunya lagi adalah jalan panjang di utara.
Dialogue: 0,0:04:25.11,0:04:29.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jalurnya memang datar, tapi kita harus\Nmenerobos markas utama Ashikaga dan Nitta.
Dialogue: 0,0:04:29.71,0:04:34.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurut kami, sebaiknya menyerang mendadak\NKamakura secepat dan seefisien mungkin!
Dialogue: 0,0:04:34.63,0:04:35.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar!
Dialogue: 0,0:04:35.34,0:04:38.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan kekuatan kita sekarang,\NTakeda bisa dikalahkan dalam sekejap!
Dialogue: 0,0:04:41.97,0:04:43.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutku...
Dialogue: 0,0:04:44.55,0:04:48.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebaiknya kita memilih\Njalur utara yang memutar.
Dialogue: 0,0:04:49.06,0:04:52.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jalur utara itu jalan berduri, Tuan Muda...
Dialogue: 0,0:04:53.09,0:04:55.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takauji dan Yoshisada memang di Kyo,
Dialogue: 0,0:04:55.77,0:04:58.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi pengikutnya\Ndi markas utama juga kuat.
Dialogue: 0,0:04:58.40,0:05:02.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jalan panjang setelahnya\Njuga penuh musuh!
Dialogue: 0,0:05:03.24,0:05:04.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Tokiyuki.
Dialogue: 0,0:05:05.11,0:05:07.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa jelaskan alasannya?
Dialogue: 0,0:05:08.20,0:05:12.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mendengar suara para samurai\Nsaat berkeliling di Kyo.
Dialogue: 0,0:05:13.21,0:05:17.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak samurai yang\Ntidak setia pada Kaisar.
Dialogue: 0,0:05:17.63,0:05:20.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terutama kelompok Nitta,\Nbanyak yang tidak puas.
Dialogue: 0,0:05:20.92,0:05:24.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita serang sekarang pun,\Nmusuh takkan bersatu.
Dialogue: 0,0:05:25.13,0:05:28.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelaku penyerangan Kamakura,\NNitta Yoshisada,
Dialogue: 0,0:05:28.88,0:05:33.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ketika mengumpulkan pasukan di markas,\Nkabarnya jumlahnya cuma sedikit.
Dialogue: 0,0:05:33.85,0:05:37.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, begitu Takauji\Nmenitipkan anaknya,
Dialogue: 0,0:05:37.78,0:05:41.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}banyak sekutu berdatangan\Nkarena terpikat reputasi Ashikaga,
Dialogue: 0,0:05:41.65,0:05:45.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat tiba di Kamakura, jumlah mereka\Nmembludak sampai puluhan ribu.
Dialogue: 0,0:05:48.28,0:05:53.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku rasa hal yang bisa dilakukan anak\NAshikaga bisa dilakukan anak Hojo juga.
Dialogue: 0,0:05:54.96,0:05:56.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalaupun bisa melewati jalur selatan
Dialogue: 0,0:05:56.84,0:05:59.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan menyerbu Kamakura melalui\Nrute tercepat dan terpendek,
Dialogue: 0,0:05:59.71,0:06:04.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kemungkinan terburuknya, cuma jadi\Nperlawanan kecil pasukan dari Shinano saja.
Dialogue: 0,0:06:04.92,0:06:09.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, bagaimana kalau kita\Nkabur dulu dari Kamakura?
Dialogue: 0,0:06:09.72,0:06:14.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengikuti cara Nitta, membawa anak kecil\Nsebagai simbol yang mudah dikenali,
Dialogue: 0,0:06:14.60,0:06:19.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu ke Kamakura sembari mengumpulkan\Nsamurai yang tak puas dengan rezim.
Dialogue: 0,0:06:20.02,0:06:22.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan menggunakan Hojo Tokiyuki,
Dialogue: 0,0:06:22.28,0:06:26.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita bisa melakukan hal\Nyang sama seperti musuh.
Dialogue: 0,0:06:27.24,0:06:28.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengejutkan.
Dialogue: 0,0:06:28.45,0:06:30.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Tokiyuki memang pintar!
Dialogue: 0,0:06:30.36,0:06:33.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Tokiyuki, dapat strategi itu dari mana?
Dialogue: 0,0:06:33.82,0:06:36.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam perjalanan pulang dari Kyo.
Dialogue: 0,0:06:36.31,0:06:39.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi bagian detailnya dipikirkan\NFubuki dan Shizuku.
Dialogue: 0,0:06:40.23,0:06:43.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma memberikan arahan\Ngaris besarnya saja.
Dialogue: 0,0:06:43.96,0:06:48.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak ingin pasukan Shinano menumpahkan\Ndarah sia-sia karena serangan frontal.
Dialogue: 0,0:06:49.13,0:06:54.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru, mungkin jalan yang sekilas tampak\Ndi luar nalar itulah yang benar.
Dialogue: 0,0:06:55.72,0:07:00.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengalaman di Kyo sudah memberi\Nbanyak pengalaman untuk Tokiyuki.
Dialogue: 0,0:07:00.69,0:07:02.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak cuma memikirkan hal di depan mata,
Dialogue: 0,0:07:02.90,0:07:06.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia belajar memikirkan negeri\Nsecara menyeluruh.
Dialogue: 0,0:07:08.82,0:07:12.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah ditentukan, Tokitsugu. Dari utara.
Dialogue: 0,0:07:12.12,0:07:13.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, Ayahanda.
Dialogue: 0,0:07:15.04,0:07:18.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, sebelum menuju Kamakura,
Dialogue: 0,0:07:18.32,0:07:21.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ada rintangan besar di Shinano.
Dialogue: 0,0:07:22.58,0:07:25.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gubernur militer Shinano,\NOgasawara Sadamune.
Dialogue: 0,0:07:26.13,0:07:29.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pria yang paling cepat meninggalkan\NKamakura dan memihak Takauji,
Dialogue: 0,0:07:29.34,0:07:33.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu dalam dua tahun ini berhasil naik\Nmenjadi kekuatan terbesar di Shinano.
Dialogue: 0,0:07:34.35,0:07:39.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika meninggalkan Shinano untuk ke Kamakura,\Ndia pasti akan mengejar dari belakang.
Dialogue: 0,0:07:39.81,0:07:43.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk menghilangkan kekhawatiran\Nyang ada di belakang,
Dialogue: 0,0:07:43.19,0:07:45.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita harus mengalahkan dia lebih dulu.
Dialogue: 0,0:07:47.69,0:07:52.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku, Yorishige, akan menghadapi dia\Nyang berpengalaman di medan perang itu.
Dialogue: 0,0:07:52.57,0:07:54.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, di pihak Sadamune\Nada seorang jenderal
Dialogue: 0,0:07:54.65,0:07:58.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang menjadi faktor tak terduga\Nyang bahkan tidak bisa kubaca.
Dialogue: 0,0:07:58.54,0:08:03.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Tokiyuki, saya ingin Anda\Nmengalahkan kartu as Sadamune,
Dialogue: 0,0:08:03.33,0:08:06.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shokan.
Dialogue: 0,0:08:09.42,0:08:12.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seorang ahli strategi misterius\Ndan cerdik entah dari mana.
Dialogue: 0,0:08:13.10,0:08:17.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari semua orang di kubu Suwa,\Nyang paling mengenalnya
Dialogue: 0,0:08:18.19,0:08:19.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hanyalah Anda.
Dialogue: 0,0:08:20.77,0:08:23.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hal paling menakutkan adalah\Nsiasat liciknya
Dialogue: 0,0:08:23.23,0:08:25.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang membalikkan keadaan\Nseperti sebelumnya.
Dialogue: 0,0:08:25.65,0:08:28.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya ingin Tuan mencegahnya sejak awal.
Dialogue: 0,0:08:32.65,0:08:35.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya memutuskannya setelah\Nmelihat strategi Tuan tadi.
Dialogue: 0,0:08:36.40,0:08:39.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anda yang sekarang pasti bisa.
Dialogue: 0,0:08:43.88,0:08:45.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan sedang melihat!
Dialogue: 0,0:08:45.71,0:08:47.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan loyo!
Dialogue: 0,0:08:47.71,0:08:51.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurut laporan dari tengu\Nyang diutus Tuan Takauji,
Dialogue: 0,0:08:51.34,0:08:56.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kemungkinannya kecil Suwa\Nmelancarkan serangan...
Dialogue: 0,0:08:57.05,0:08:59.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang luar tahu apa?
Dialogue: 0,0:08:59.81,0:09:02.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yorishige pasti mengumpulkan pasukan.
Dialogue: 0,0:09:02.52,0:09:05.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu itu lebih dari siapa pun\Nkarena sudah mengenalnya lama.
Dialogue: 0,0:09:06.18,0:09:08.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan, izin melapor.
Dialogue: 0,0:09:09.27,0:09:13.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inukai dan Tokoiwa yang seharusnya\Nsudah kita kalahkan sebelumnya,
Dialogue: 0,0:09:13.74,0:09:16.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ternyata bersembunyi di pegunungan\Ndan terus menyerang pasukan kita.
Dialogue: 0,0:09:16.95,0:09:21.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika begini terus, kekuatan pasukan\Nakan terus berkurang.
Dialogue: 0,0:09:22.20,0:09:25.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengandalkan penilaianmu, Shokan.
Dialogue: 0,0:09:25.87,0:09:28.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bawakan kepala Yorishige kepadaku!
Dialogue: 0,0:09:31.88,0:09:33.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan padaku.
Dialogue: 0,0:09:34.84,0:09:37.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah berutang nyawa kepada Tuan.
Dialogue: 0,0:09:37.76,0:09:42.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan membantai pasukan Suwa.
Dialogue: 0,0:09:47.56,0:09:50.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semangatnya luar biasa.
Dialogue: 0,0:09:50.30,0:09:53.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka semua rekan kita, ya?
Dialogue: 0,0:09:53.82,0:09:57.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kubu Kamakura yang dibentuk\Ndari pengikut Hojo.
Dialogue: 0,0:09:57.61,0:10:01.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka yang menjadi prajurit\Nbawahan langsungku.
Dialogue: 0,0:10:01.49,0:10:04.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana, Chojumaru dan kawan-kawan?
Dialogue: 0,0:10:05.71,0:10:10.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami terus mengasah keterampilan\Ndi pegunungan terpencil.
Dialogue: 0,0:10:11.09,0:10:14.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Yorishige sudah mengirim utusan,
Dialogue: 0,0:10:14.72,0:10:17.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}itu berarti pertarungan\Npenentuan akhirnya tiba!
Dialogue: 0,0:10:17.97,0:10:22.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagi kami yang setia\Npada Tuan Hojo hingga akhir,
Dialogue: 0,0:10:22.10,0:10:24.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dua tahun ini seperti neraka.
Dialogue: 0,0:10:25.48,0:10:29.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dieksekusi sebagai kriminal\Noleh para pemberontak.
Dialogue: 0,0:10:29.22,0:10:32.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diusir oleh klan yang telah\Nmeninggalkan tuannya.
Dialogue: 0,0:10:32.53,0:10:33.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu,
Dialogue: 0,0:10:33.95,0:10:36.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kesetiaan kami tak pernah goyah.
Dialogue: 0,0:10:36.82,0:10:41.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya demi saat ini!\NPerang pembalasan tuan kami!
Dialogue: 0,0:10:45.20,0:10:46.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bersyukur.
Dialogue: 0,0:10:48.84,0:10:50.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, Chojumaru.
Dialogue: 0,0:10:50.67,0:10:54.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Yorishige akan\Nmemasukkan kami ke pasukan siapa?
Dialogue: 0,0:10:54.93,0:10:56.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:10:56.26,0:10:58.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah Tuan Unno yang garang?!
Dialogue: 0,0:11:00.05,0:11:02.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Nezu dengan mata surgawinya?!
Dialogue: 0,0:11:03.47,0:11:06.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Mochizuki yang ahli berubah?!
Dialogue: 0,0:11:07.85,0:11:09.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak sabar!
Dialogue: 0,0:11:09.40,0:11:12.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka bertiga adalah jenderal\Nyang namanya terkenal di medan perang!
Dialogue: 0,0:11:12.98,0:11:16.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka orang yang layak\Nuntuk mempersembahkan nyawa!
Dialogue: 0,0:11:16.15,0:11:21.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bisa masuk ke pasukan\NUnno, Nezu, dan Mochizuki!
Dialogue: 0,0:11:21.49,0:11:27.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dua tahun hari-hariku dicap\Nsebagai pengkhianat akhirnya terbalaskan!
Dialogue: 0,0:11:27.29,0:11:29.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Miura!
Dialogue: 0,0:11:29.16,0:11:33.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah merepotkan kalian,\Ntapi akhirnya kita...
Dialogue: 0,0:11:33.79,0:11:36.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, itu...
Dialogue: 0,0:11:37.97,0:11:39.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku.
Dialogue: 0,0:11:41.43,0:11:44.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang akan memimpin kalian.
Dialogue: 0,0:11:52.65,0:11:56.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka kecewa seolah-olah dunia kiamat.
Dialogue: 0,0:11:56.65,0:12:00.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa boleh buat, mereka tidak\Ntahu identitas Tuan Muda!
Dialogue: 0,0:12:00.88,0:12:03.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelihatannya mereka bakal senang\Nkalau diberi tahu.
Dialogue: 0,0:12:04.83,0:12:08.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan gunakan nama Hojo dulu.
Dialogue: 0,0:12:08.87,0:12:12.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya ingin merahasiakan itu\Nhingga saat-saat terakhir.
Dialogue: 0,0:12:12.87,0:12:15.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau menyuruh mereka\Npercaya karena nama,
Dialogue: 0,0:12:15.84,0:12:18.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anda tak bisa mendapatkan\Nkepercayaan sejati.
Dialogue: 0,0:12:18.59,0:12:22.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketika pahlawan Shinano,\NKiso Yoshinaka, mengangkat senjata,
Dialogue: 0,0:12:22.64,0:12:24.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ia berhasil memenangkan hati\Npasukan Shinano
Dialogue: 0,0:12:24.81,0:12:27.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan kemenangan\Npertempuran pertamanya.
Dialogue: 0,0:12:28.06,0:12:31.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan mengalahkan Shokan,
Dialogue: 0,0:12:31.90,0:12:35.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anda juga akan memperoleh kesetiaan\Nyang tak tergoyahkan dari kubu Kamakura.
Dialogue: 0,0:12:41.87,0:12:43.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pasti bisa!
Dialogue: 0,0:12:43.37,0:12:46.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menjadi jenderal yang pantas dijunjung!
Dialogue: 0,0:12:46.41,0:12:48.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sempurna, Tuan Muda!
Dialogue: 0,0:12:49.62,0:12:53.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang Buddha Iblis tidak mempan\Nuntuk kedua kalinya.
Dialogue: 0,0:12:53.29,0:12:57.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, Shokan itu hati-hati\Ndan pertahanannya sempurna.
Dialogue: 0,0:12:57.63,0:13:01.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Prajurit kelas satu pun pasti kesulitan\Nmengalahkannya dengan pedang.
Dialogue: 0,0:13:02.30,0:13:06.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teknik baru untuk menusuk tenggorokan\Nmusuh yang sangat tangguh.
Dialogue: 0,0:13:06.43,0:13:07.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namanya...
Dialogue: 0,0:13:09.35,0:13:11.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pedang Putih Taring Ganda.
Dialogue: 0,0:13:14.02,0:13:16.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau juga punya teknik rahasia, 'kan?
Dialogue: 0,0:13:16.85,0:13:21.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, aku cuma pakai sedikit\Nbahan yang kudapat di Kyo.
Dialogue: 0,0:13:22.03,0:13:25.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata bukan cuma ditelanjangi, ya.
Dialogue: 0,0:13:25.24,0:13:27.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?! Ngajak gelut?!
Dialogue: 0,0:13:31.37,0:13:34.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Persiapan menangani Shokan sudah selesai.
Dialogue: 0,0:13:34.56,0:13:38.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang tinggal memikirkan strategi\Nmengalahkan pasukan yang dia pimpin.
Dialogue: 0,0:13:38.67,0:13:41.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Strategi Shizuku bagus.
Dialogue: 0,0:13:42.09,0:13:44.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan strategi dia yang\Nsangat mengenal Shinano,
Dialogue: 0,0:13:44.89,0:13:47.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mari kita tumpas pasukan Shokan\Nyang berasal dari luar.
Dialogue: 0,0:13:47.39,0:13:50.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi ada satu masalah dengan strategiku.
Dialogue: 0,0:13:51.81,0:13:54.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk sepenuhnya melenyapkan\Nancaman dari musuh,
Dialogue: 0,0:13:54.23,0:13:55.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita butuh 300 pasukan berkuda.
Dialogue: 0,0:13:55.94,0:13:59.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seratus prajurit Kamakura\Ntidak cukup untuk menghancurkan lawan.
Dialogue: 0,0:13:59.48,0:14:01.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan militer, ya...
Dialogue: 0,0:14:05.03,0:14:06.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu!
Dialogue: 0,0:14:06.12,0:14:07.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayano?
Dialogue: 0,0:14:07.12,0:14:08.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau punya ide?
Dialogue: 0,0:14:08.49,0:14:09.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan disimpan sendiri!
Dialogue: 0,0:14:10.00,0:14:11.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beri tahu kami!
Dialogue: 0,0:14:11.25,0:14:14.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu orang mengamuk untuk tiga orang!
Dialogue: 0,0:14:16.25,0:14:20.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan kekuatan Ayako, kau mungkin\Nbisa melawan lebih dari itu!
Dialogue: 0,0:14:21.04,0:14:24.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika bisa memecah formasi musuh...
Dialogue: 0,0:14:24.16,0:14:27.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita hantam pasukan utama\Ndan akhiri dengan cepat?
Dialogue: 0,0:14:27.26,0:14:30.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih realistis kalau memutus\Njalur pasokan mereka.
Dialogue: 0,0:14:32.97,0:14:35.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, teman-teman!
Dialogue: 0,0:14:37.19,0:14:39.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar coba kupikirkan.
Dialogue: 0,0:14:47.32,0:14:49.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu...
Dialogue: 0,0:14:50.24,0:14:53.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Strategi untuk mengimbangi\Nkekurangan pasukan, ya.
Dialogue: 0,0:14:57.75,0:14:59.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di saat seperti ini,
Dialogue: 0,0:14:59.67,0:15:02.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Kusunoki akan melakukan apa?
Dialogue: 0,0:15:06.80,0:15:10.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tulisannya jelek banget,\Naku tidak bisa baca!
Dialogue: 0,0:15:10.31,0:15:13.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebentar, dia menulis hal\Nyang tidak ada hubungannya?
Dialogue: 0,0:15:31.70,0:15:35.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa membaca bagian awalnya\Nsetelah menghabiskan satu malam...
Dialogue: 0,0:15:36.62,0:15:39.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagiku, strategi militer
Dialogue: 0,0:15:39.49,0:15:43.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah sesuatu yang hanya ada\Ndalam pengalaman hidup.
Dialogue: 0,0:15:43.59,0:15:46.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bertemu dengan siapa, melihat apa,
Dialogue: 0,0:15:46.13,0:15:48.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan merasakan apa dalam hidup kita.
Dialogue: 0,0:15:48.76,0:15:51.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pastikan tidak melupakan hal-hal itu.
Dialogue: 0,0:15:52.22,0:15:55.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ingatan tak terduga\Ndi waktu tak terduga
Dialogue: 0,0:15:55.49,0:15:58.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa menjadi alat\Nuntuk menghancurkan musuh.
Dialogue: 0,0:15:58.89,0:16:00.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bertemu dengan siapa...
Dialogue: 0,0:16:00.65,0:16:02.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Merasakan apa...
Dialogue: 0,0:16:04.86,0:16:08.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dua tahun intens yang\Nkuhabiskan di Shinano...
Dialogue: 0,0:16:08.90,0:16:11.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ingatanku...
Dialogue: 0,0:16:12.07,0:16:17.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rencana A, tanpa ragu,\Nlangit cerah dan berwarna ♪
Dialogue: 0,0:16:17.37,0:16:23.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Landasan pacu kita\Nyang saling menyerahkan punggung ♪
Dialogue: 0,0:16:23.63,0:16:29.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rencana A, tanpa ragu,\Nkarena hidup itu penting ♪
Dialogue: 0,0:16:29.05,0:16:35.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Walau ditertawakan dan menyedihkan,\Ntidak masalah ♪
Dialogue: 0,0:16:35.22,0:16:38.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rencana A, Rencana A ♪
Dialogue: 0,0:16:38.14,0:16:41.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kabur itu menang ♪
Dialogue: 0,0:16:41.73,0:16:43.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma ingatan orang-orang sableng!
Dialogue: 0,0:16:43.94,0:16:45.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak! Itu tidak sopan.
Dialogue: 0,0:16:45.90,0:16:49.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa aku menyebut orang Shinano\Nyang merawatku sableng?
Dialogue: 0,0:16:49.65,0:16:51.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti ada orang normal juga.
Dialogue: 0,0:16:51.94,0:16:54.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba ingat.
Dialogue: 0,0:16:54.05,0:16:58.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ingatan yang berguna...\NBerguna...
Dialogue: 0,0:16:58.66,0:17:00.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dih, bukan...
Dialogue: 0,0:17:01.54,0:17:03.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah nekat kalau aku pakai itu?
Dialogue: 0,0:17:04.25,0:17:07.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, semua orang\Ndi Shinano melakukan itu.
Dialogue: 0,0:17:07.67,0:17:09.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika mengubah sedikit strategi Shizuku,
Dialogue: 0,0:17:09.88,0:17:11.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}nanti bisa cocok.
Dialogue: 0,0:17:11.92,0:17:13.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menemukan bala bantuan.
Dialogue: 0,0:17:13.89,0:17:16.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang aku bisa menang\Nmelawan Shokan.
Dialogue: 0,0:17:20.81,0:17:23.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayahanda. Kakanda.
Dialogue: 0,0:17:23.32,0:17:27.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saksikanlah pertarungan\Nnyata pertama Tokiyuki!
Dialogue: 0,0:17:28.98,0:17:30.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mati kau!
Dialogue: 0,0:17:30.28,0:17:32.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau saja yang mati!
Dialogue: 0,0:17:35.11,0:17:36.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau muntah.
Dialogue: 0,0:17:36.83,0:17:41.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terakhir kali berkeringat sebanyak ini\Nsejak aku mencuri lonceng kuil dan kabur.
Dialogue: 0,0:17:42.66,0:17:44.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, tuh.
Dialogue: 0,0:17:44.17,0:17:46.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi kangen.
Dialogue: 0,0:17:46.12,0:17:49.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tubuh jadi kaku gara-gara latihan terus.
Dialogue: 0,0:17:49.26,0:17:53.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, bagaimana kalau kita\Nbersihkan karat pedang sekarang?
Dialogue: 0,0:17:54.84,0:17:56.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh juga.
Dialogue: 0,0:17:56.68,0:17:59.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wilayah ini sudah milik Bos, 'kan?
Dialogue: 0,0:18:00.01,0:18:02.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Merampok sedikit\Nuntuk cari suasana baru,
Dialogue: 0,0:18:02.94,0:18:04.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pasti boleh, 'kan?
Dialogue: 0,0:18:04.35,0:18:07.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, itu pasti diizinkan.
Dialogue: 0,0:18:07.23,0:18:09.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau melawan, aku bunuh saja.
Dialogue: 0,0:18:12.48,0:18:15.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang seksi di sebelah barat.
Dialogue: 0,0:18:15.65,0:18:17.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh.
Dialogue: 0,0:18:17.24,0:18:19.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo sapa sebentar.
Dialogue: 0,0:18:20.04,0:18:22.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pas malam...
Dialogue: 0,0:18:25.89,0:18:28.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tu-Tuan...
Dialogue: 0,0:18:28.25,0:18:30.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tamatlah kau kalau kembali jadi bandit.
Dialogue: 0,0:18:31.17,0:18:34.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak bisa mati\Nsebagai samurai lagi.
Dialogue: 0,0:18:35.26,0:18:38.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mau, coba lakukan tanpa kepala.
Dialogue: 0,0:18:38.07,0:18:41.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan begitu, wajah pelaku\Ntakkan ketahuan.
Dialogue: 0,0:18:41.39,0:18:43.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, tidak...
Dialogue: 0,0:18:43.27,0:18:45.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami mau kembali latihan!
Dialogue: 0,0:18:45.27,0:18:48.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan menakutkan akhir-akhir ini...
Dialogue: 0,0:18:52.57,0:18:56.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Delapan petani yang kabur\Nkarena menunggak pajak,
Dialogue: 0,0:18:57.15,0:18:59.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akhirnya berhasil ditangkap, ya?
Dialogue: 0,0:18:59.45,0:19:01.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus.
Dialogue: 0,0:19:02.12,0:19:04.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini hadiah dari Tuan Sadamune.
Dialogue: 0,0:19:05.23,0:19:08.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Sadamune juga memujimu, lo.
Dialogue: 0,0:19:10.67,0:19:13.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak berhak menerima hadiah.
Dialogue: 0,0:19:13.34,0:19:17.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya bekerja\Ndemi tanah air dan rakyat.
Dialogue: 0,0:19:17.72,0:19:20.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh mulia, Shokan.
Dialogue: 0,0:19:20.68,0:19:24.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bicara seperti Buddha saja.
Dialogue: 0,0:19:25.14,0:19:27.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong bekerja dengan baik.
Dialogue: 0,0:19:27.68,0:19:31.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena semuanya\Ntergantung pada kinerjamu.
Dialogue: 0,0:19:34.73,0:19:36.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Jito.
Dialogue: 0,0:19:38.19,0:19:39.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan!
Dialogue: 0,0:19:40.78,0:19:44.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh! Acar labunya kelihatan enak!
Dialogue: 0,0:19:45.00,0:19:47.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih selalu, Nak.
Dialogue: 0,0:19:48.79,0:19:53.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nenek menyuruhku mengantarkan ini\Nselagi masih dingin.
Dialogue: 0,0:19:53.96,0:19:55.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:19:55.09,0:19:59.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika itu perintah, berarti\Ntidak boleh aku tunda-tunda!
Dialogue: 0,0:19:59.26,0:20:01.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku makan dulu.
Dialogue: 0,0:20:06.06,0:20:07.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya bilang begini, lo.
Dialogue: 0,0:20:07.98,0:20:12.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jito selanjutnya kinerjanya bagus\Ndan peduli dengan rakyatnya.
Dialogue: 0,0:20:15.27,0:20:17.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau ke medan perang?
Dialogue: 0,0:20:17.40,0:20:19.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin.
Dialogue: 0,0:20:19.40,0:20:21.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa berperang?
Dialogue: 0,0:20:21.91,0:20:25.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perang itu bunuh-bunuhan\Ndengan musuh, 'kan?
Dialogue: 0,0:20:26.58,0:20:30.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau Tuan Jito mati.
Dialogue: 0,0:20:32.42,0:20:34.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa, Tuan Jito?
Dialogue: 0,0:20:34.59,0:20:35.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei.
Dialogue: 0,0:20:35.67,0:20:38.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak apa-apa, Tuan Jito?
Dialogue: 0,0:20:38.51,0:20:41.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cabut gigi dan lidahnya pelan-pelan.
Dialogue: 0,0:20:41.80,0:20:46.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Potong tendon kaki kanannya,\Nlalu jadikan budak.
Dialogue: 0,0:20:47.64,0:20:50.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka akan hidup bagai di neraka.
Dialogue: 0,0:20:50.94,0:20:55.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hidup damai dan bebas bersama\Norang tuanya takkan kembali lagi!
Dialogue: 0,0:20:53.14,0:20:59.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}{\an8}Mati... Mati...
Dialogue: 0,0:20:59.65,0:21:02.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, sungguh malang.
Dialogue: 0,0:21:02.32,0:21:05.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malangnya hidup dalam keputusasaan.
Dialogue: 0,0:21:09.95,0:21:12.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Jito? Kamu tidak apa-apa?
Dialogue: 0,0:21:13.58,0:21:16.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bila berada dalam kegelapan,\Nkau akan tersesat dan menderita.
Dialogue: 0,0:21:16.80,0:21:19.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bila cahaya bersinar,
Dialogue: 0,0:21:19.42,0:21:21.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dosa-dosa masa lalu akan terungkap...
Dialogue: 0,0:21:22.72,0:21:24.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada akhirnya,
Dialogue: 0,0:21:24.05,0:21:27.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mau ke mana pun,\Ndunia ini tetaplah neraka.
Dialogue: 0,0:21:28.76,0:21:31.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nak, Paman ini...
Dialogue: 0,0:21:32.35,0:21:34.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hatinya sudah disucikan oleh Buddha
Dialogue: 0,0:21:35.08,0:21:38.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan nyawaku ini diselamatkan\Noleh Tuan Besar.
Dialogue: 0,0:21:39.15,0:21:42.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk membalas kebaikan Tuan Besar,
Dialogue: 0,0:21:42.13,0:21:45.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku harus membunuh Buddha.
Dialogue: 0,0:21:46.57,0:21:49.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mengerti...
Dialogue: 0,0:21:50.20,0:21:53.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Tuan Jito yang baik\Ndan pintar memutuskan itu,
Dialogue: 0,0:21:53.50,0:21:55.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berarti itu pasti benar!
Dialogue: 0,0:21:55.46,0:21:58.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pulang dengan selamat, ya!
Dialogue: 0,0:21:58.20,0:21:59.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Janji, ya!
Dialogue: 0,0:21:59.79,0:22:01.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja.
Dialogue: 0,0:22:04.38,0:22:08.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paman ini kuat bukan main.
Dialogue: 0,0:22:11.73,0:22:16.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bila ingin romantis ♪
Dialogue: 0,0:22:16.61,0:22:19.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cintai aku lebih dari siapa pun ♪
Dialogue: 0,0:22:25.20,0:22:28.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kamu orang yang baik ♪
Dialogue: 0,0:22:28.58,0:22:32.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bakal baik ke gadis itu juga, 'kan?♪
Dialogue: 0,0:22:32.33,0:22:35.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa, tidak masalah ♪
Dialogue: 0,0:22:35.67,0:22:39.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong bawakan\Nsemua barang beratnya, ya ♪
Dialogue: 0,0:22:39.38,0:22:42.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu keren di depan orang-orang ♪
Dialogue: 0,0:22:42.55,0:22:46.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kamu imut saat kita berduaan ♪
Dialogue: 0,0:22:46.34,0:22:49.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setia seperti anjing ♪
Dialogue: 0,0:22:49.68,0:22:55.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan menghilang seperti kucing, ya ♪
Dialogue: 0,0:22:56.35,0:22:59.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terkadang aku sedih ♪
Dialogue: 0,0:22:59.86,0:23:03.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi sentimental\Nsaat menatap bintang ♪
Dialogue: 0,0:23:03.44,0:23:10.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini, kamu dengan siapa\Ndan sedang apa?♪
Dialogue: 0,0:23:10.58,0:23:14.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, jika kamu mau\Nmencintai dan dicintai ♪
Dialogue: 0,0:23:14.54,0:23:17.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan selalu membuatmu berdebar ♪
Dialogue: 0,0:23:18.00,0:23:21.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika tidak memilihku ♪
Dialogue: 0,0:23:21.59,0:23:25.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menjatuhkanmu ke neraka ♪
Dialogue: 0,0:23:25.26,0:23:28.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mendengarmu ♪
Dialogue: 0,0:23:28.72,0:23:32.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau tahu lagi ♪
Dialogue: 0,0:23:32.47,0:23:36.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bila ingin romantis ♪
Dialogue: 0,0:23:36.10,0:23:39.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cintai aku lebih dari siapa pun ♪
Dialogue: 0,0:23:43.69,0:23:45.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo!
