Dialogue: 0,0:00:07.12,0:00:15.83,sign,,0000,0000,0000,,(Dainagon - Saionji Kinmune)
Dialogue: 0,0:00:27.64,0:00:31.14,sign,,0000,0000,0000,,(Tokiyuki)
Dialogue: 0,0:01:21.11,0:01:26.53,sign,,0000,0000,0000,,(Tuan Muda Jago Kabur)
Dialogue: 0,0:04:12.40,0:04:14.66,sign,,0000,0000,0000,,(Kuil Kiyomizu)
Dialogue: 0,0:23:20.17,0:23:27.39,sign,,0000,0000,0000,,L-O-V-E
Dialogue: 0,0:23:32.85,0:23:34.94,sign,,0000,0000,0000,,(Sasaki Mima - Hanamiya Nina)
Dialogue: 0,0:23:38.94,0:23:41.94,sign,,0000,0000,0000,,(Episode 21 [Tahun 1335]\NPria Itu adalah Kusunoki Masashige)
Dialogue: 0,0:00:01.02,0:00:03.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah menunggumu, Tuan Yasuie.
Dialogue: 0,0:00:03.90,0:00:07.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lama tak bersua, Tuan Kinmune.
Dialogue: 0,0:00:07.48,0:00:10.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dainagon, Saionji Kinmune.
Dialogue: 0,0:00:10.62,0:00:15.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keluarga bangsawan istana yang turun-temurun\Nberperan jadi penghubung Kamakura dan Kyo.
Dialogue: 0,0:00:15.83,0:00:19.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi merindukan masa-masa\NKeshogunan masih berkuasa.
Dialogue: 0,0:00:19.75,0:00:24.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat itu, semua bangsawan istana di Kyo\Nakan menuruti apa pun yang kukatakan.
Dialogue: 0,0:00:27.38,0:00:31.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chojumaru, aku akan membicarakan\Nhal penting dengan beliau.
Dialogue: 0,0:00:31.56,0:00:35.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian ingin melihat ibu kota Kyo, 'kan?
Dialogue: 0,0:00:35.64,0:00:40.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat muda dulu, aku juga sembunyikan\Nidentitasku dan bersenang-senang di Kyo.
Dialogue: 0,0:00:40.40,0:00:43.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hati-hati jangan sampai\Nidentitasmu ketahuan, ya.
Dialogue: 0,0:00:43.69,0:00:46.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka mau buat rencana apa, ya?
Dialogue: 0,0:00:46.78,0:00:47.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah.
Dialogue: 0,0:00:47.82,0:00:49.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya rencana pemberontakan,
Dialogue: 0,0:00:49.66,0:00:51.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kalau sampai bicara\Ndengan bangsawan tingkat tinggi,
Dialogue: 0,0:00:51.74,0:00:53.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}harusnya bukan pembahasan sepele.
Dialogue: 0,0:00:53.79,0:00:56.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kacau banget.
Dialogue: 0,0:00:56.20,0:00:58.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, biarkan saja dulu.
Dialogue: 0,0:01:00.96,0:01:03.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kyo!
Dialogue: 0,0:01:04.30,0:01:07.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teruslah hidup dan tunggu waktunya♪
Dialogue: 0,0:01:07.26,0:01:12.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jinjing nyawamu dan tembus takdir♪
Dialogue: 0,0:01:12.10,0:01:15.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hiduplah dalam malu\Ndan kejar mimpimu♪
Dialogue: 0,0:01:15.31,0:01:20.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi orang-orang\Nyang percaya padamu♪
Dialogue: 0,0:01:34.04,0:01:37.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagian besar takkan tercatat\Ndalam sejarah♪
Dialogue: 0,0:01:37.29,0:01:40.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua hal konyol itu♪
Dialogue: 0,0:01:40.79,0:01:44.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membelit dan terurai, lagi dan lagi♪
Dialogue: 0,0:01:44.59,0:01:47.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tarik napas♪
Dialogue: 0,0:01:47.63,0:01:51.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk apa hidup ini dipersembahkan?♪
Dialogue: 0,0:01:51.22,0:01:54.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takdir apa yang menanti?♪
Dialogue: 0,0:01:54.60,0:01:57.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bila rasa bak kutukan♪
Dialogue: 0,0:01:57.48,0:02:01.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan bisa mengikatku♪
Dialogue: 0,0:02:01.81,0:02:04.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teruslah hidup dan tunggu waktunya♪
Dialogue: 0,0:02:04.61,0:02:09.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jinjing nyawamu dan lawan takdir♪
Dialogue: 0,0:02:09.49,0:02:12.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hiduplah dalam malu\Ndan kejar mimpimu♪
Dialogue: 0,0:02:12.66,0:02:17.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi orang-orang\Nyang percaya padamu♪
Dialogue: 0,0:02:17.00,0:02:20.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Iblis, sini,\Nikuti suara tepuk tanganku♪
Dialogue: 0,0:02:20.17,0:02:23.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}(Hei, Iblis, sini,\Nikuti suara tepuk tanganku)♪
Dialogue: 0,0:02:23.75,0:02:27.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hidup itu singkat,\Nmenyanyi dan menarilah♪
Dialogue: 0,0:02:27.13,0:02:31.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bunga akan mekar\Nbagi yang jago kabur♪
Dialogue: 0,0:02:42.90,0:02:44.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minggir!
Dialogue: 0,0:02:44.06,0:02:46.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Putri sedang buru-buru!
Dialogue: 0,0:02:46.73,0:02:48.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Muda tidak apa-apa?
Dialogue: 0,0:02:51.57,0:02:52.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini?
Dialogue: 0,0:02:52.87,0:02:54.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sidat besar!
Dialogue: 0,0:02:55.03,0:02:56.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini malong.
Dialogue: 0,0:02:58.70,0:03:01.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tulangnya dipotong hati-hati banget.
Dialogue: 0,0:03:01.58,0:03:04.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang ikannya seenak itu\Nsampai harus totalitas begitu?
Dialogue: 0,0:03:14.55,0:03:17.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata memang seenak itu!
Dialogue: 0,0:03:19.26,0:03:21.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo? Mana Fubuki?
Dialogue: 0,0:03:21.27,0:03:23.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tidak punya uang,\Njadi mau cari uang dulu.
Dialogue: 0,0:03:23.85,0:03:28.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak konstruksi bangunan di sana-sini,\Njadi gampang dapat pekerjaan kasar.
Dialogue: 0,0:03:28.73,0:03:32.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya, upah jauh lebih tinggi\Ndaripada di Suwa dan Kamakura.
Dialogue: 0,0:03:40.20,0:03:41.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah...
Dialogue: 0,0:03:42.29,0:03:44.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Topeng rubahmu manis.
Dialogue: 0,0:03:44.88,0:03:47.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau main sama kakak?
Dialogue: 0,0:03:49.88,0:03:51.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dirayu wanita Kyo! Kenapa?
Dialogue: 0,0:03:51.92,0:03:55.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah pesonaku terpancar\Ndari balik topeng?!
Dialogue: 0,0:03:55.01,0:03:58.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau pria kaya memang lebih populer?
Dialogue: 0,0:03:58.59,0:04:00.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pergi sebentar, Bos.
Dialogue: 0,0:04:00.85,0:04:03.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan pulang sebelum malam... Tidak.
Dialogue: 0,0:04:03.70,0:04:06.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah besok pagi bisa pulang atau tidak.
Dialogue: 0,0:04:06.48,0:04:09.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak baik cepat tidur!
Dialogue: 0,0:04:10.03,0:04:12.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benci biji buah biwa!
Dialogue: 0,0:04:12.53,0:04:18.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biji sialan ini merusak tekstur\Nbuah yang nikmat ini!
Dialogue: 0,0:04:18.49,0:04:25.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, Buddha! Hilangkan biji\Ndari semua buah biwa di dunia ini!
Dialogue: 0,0:04:22.79,0:04:25.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan!
Dialogue: 0,0:04:25.71,0:04:27.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kyo memang gila.
Dialogue: 0,0:04:27.63,0:04:30.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang anehnya beda sekali dari Shinano.
Dialogue: 0,0:04:30.50,0:04:31.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:04:34.96,0:04:36.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membuatku kewalahan.
Dialogue: 0,0:04:38.01,0:04:42.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kota ini jauh lebih unggul\Ndalam luas wilayah dan perekonomiannya.
Dialogue: 0,0:04:42.81,0:04:46.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takauji memperebutkan kekuasaan\Ndi ibu kota seperti ini?
Dialogue: 0,0:04:47.77,0:04:48.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Muda!
Dialogue: 0,0:04:49.40,0:04:51.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo cepat pergi.
Dialogue: 0,0:04:51.06,0:04:52.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:04:52.43,0:04:54.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Genba di mana, ya?
Dialogue: 0,0:04:54.69,0:04:57.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau coba cari di sekitar tempat tadi?
Dialogue: 0,0:05:01.08,0:05:03.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, Nak Rubah?
Dialogue: 0,0:05:03.70,0:05:07.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak cuma kehabisan uang,\Ntapi sampai punya utang 20 kanmon!
Dialogue: 0,0:05:09.71,0:05:11.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keroco.
Dialogue: 0,0:05:11.67,0:05:15.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak pernah kalah main sugoroku.
Dialogue: 0,0:05:15.20,0:05:16.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Genba!
Dialogue: 0,0:05:16.30,0:05:17.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat!
Dialogue: 0,0:05:17.26,0:05:18.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sekarat!
Dialogue: 0,0:05:18.47,0:05:25.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat. Selamat. Terima kasih.
Dialogue: 0,0:05:18.93,0:05:22.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keputusasaan kalah judi sampai\Nsemua pakaian dan harta dirampas,
Dialogue: 0,0:05:22.26,0:05:25.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ditambah kegembiraan bermain sugoroku\Ntelanjang di bawah pengawasan wanita
Dialogue: 0,0:05:25.81,0:05:27.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}membuat pikirannya jadi rusak!
Dialogue: 0,0:05:28.13,0:05:29.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, temannya?
Dialogue: 0,0:05:29.86,0:05:32.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayang banget.\NDia sudah jadi milik kami.
Dialogue: 0,0:05:33.14,0:05:35.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebentar lagi kontraktor akan membawanya.
Dialogue: 0,0:05:35.49,0:05:40.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bakal kerja paksa di pelosok\NGunung Hiei sampai utang lunas.
Dialogue: 0,0:05:40.82,0:05:42.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teman-teman, siapkan uangnya.
Dialogue: 0,0:05:45.87,0:05:49.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami cuma orang kampung yang datang\Nke ibu kota dan tidak tahu apa-apa.
Dialogue: 0,0:05:49.21,0:05:52.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, bisa tolong bebaskan dia dengan ini?
Dialogue: 0,0:05:53.46,0:05:54.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mau.
Dialogue: 0,0:05:54.92,0:05:56.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalah perang dibalas dengan perang.
Dialogue: 0,0:05:56.84,0:05:59.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalah dalam taruhan\Ndibalas dengan taruhan.
Dialogue: 0,0:05:59.01,0:06:00.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah hukum dunia.
Dialogue: 0,0:06:00.62,0:06:03.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau saja yang duduk di sana.
Dialogue: 0,0:06:03.01,0:06:05.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan uang.\NPertaruhkan dirimu sendiri.
Dialogue: 0,0:06:06.85,0:06:10.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak terlalu paham sugoroku.\NKalau bisa sambil diajari.
Dialogue: 0,0:06:10.40,0:06:11.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakanda!
Dialogue: 0,0:06:13.48,0:06:16.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keberanian untuk langsung\Nberkorban demi pengikutnya.
Dialogue: 0,0:06:16.94,0:06:20.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengikutnya juga menuruti perintah\Ntanpa ragu dan memberikan uang.
Dialogue: 0,0:06:20.24,0:06:21.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Samurai dari timur?
Dialogue: 0,0:06:21.89,0:06:25.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelihatan dari keluarga terpandang\Nmeski berasal dari pedesaan.
Dialogue: 0,0:06:26.99,0:06:29.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enaknya...
Dialogue: 0,0:06:30.04,0:06:33.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesenangan menodai samurai desa\Nyang mulia dan sederhana
Dialogue: 0,0:06:36.59,0:06:41.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan lumpur kotor Kyo.
Dialogue: 0,0:06:41.09,0:06:42.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakanda, minggir.
Dialogue: 0,0:06:43.55,0:06:44.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar aku yang melawannya.
Dialogue: 0,0:06:44.89,0:06:46.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shizuku!
Dialogue: 0,0:06:48.31,0:06:50.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lawak! Lawak!
Dialogue: 0,0:06:50.56,0:06:52.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cinta antar tuan dan bawahan?\NCinta saudara?
Dialogue: 0,0:06:52.98,0:06:56.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, bagus!\NBiar kuladeni, Miko Desa!
Dialogue: 0,0:06:56.44,0:07:01.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bakal ternodai di umur belia\Nkalau kalah, tidak apa-apa, 'kan?
Dialogue: 0,0:07:01.24,0:07:02.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja.
Dialogue: 0,0:07:02.16,0:07:03.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oi, kurang ajar.
Dialogue: 0,0:07:04.62,0:07:07.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berpuaslah dengan uangmu itu.
Dialogue: 0,0:07:07.04,0:07:10.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tempat judi kacau, insiden penusukan itu\Nhal yang terjadi di mana-mana, kan?
Dialogue: 0,0:07:11.04,0:07:15.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis cilik tanpa jaminan militer\Njangan serakah.
Dialogue: 0,0:07:25.47,0:07:27.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Mima.
Dialogue: 0,0:07:27.47,0:07:32.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada seorang pun di Kyo\Nyang tidak mengenal putri Sasaki Doyo.
Dialogue: 0,0:07:34.18,0:07:36.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sasaki Doyo.
Dialogue: 0,0:07:36.23,0:07:38.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Samurai dari barat yang memegang\Nkekuasaan Kyo dari balik layar.
Dialogue: 0,0:07:38.98,0:07:42.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namanya bahkan terkenal jauh\Nsampai ke Suwa.
Dialogue: 0,0:07:43.19,0:07:45.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, ayo kita mulai.
Dialogue: 0,0:07:45.57,0:07:49.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Miko kampungan sepertimu tidak mungkin\Ntahu cara main yang benar, 'kan?
Dialogue: 0,0:07:49.70,0:07:52.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yanagi saja yang paling gampang.
Dialogue: 0,0:07:52.66,0:07:56.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tangannya yang memegang bidak tadi\Nmemancarkan kekuatan ilahi.
Dialogue: 0,0:07:56.65,0:07:59.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang berarti ini akan jadi sugoroku\Nyang tidak biasa.
Dialogue: 0,0:07:59.96,0:08:02.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nih, kocok.
Dialogue: 0,0:08:02.36,0:08:04.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini dadu yang akan membawamu
Dialogue: 0,0:08:05.00,0:08:06.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ke neraka dari Kyo.
Dialogue: 0,0:08:09.39,0:08:13.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yanagi ini sangat simpel\Ndi antara semua sugoroku.
Dialogue: 0,0:08:13.33,0:08:16.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemenangnya yang berhasil\Nmemindahkan semua bidak ke tepi
Dialogue: 0,0:08:16.69,0:08:18.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan melempar dadu bergiliran.
Dialogue: 0,0:08:18.65,0:08:21.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja, angka besar lebih bagus,
Dialogue: 0,0:08:21.40,0:08:25.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi ada aturan bidak bakal kembali\Njika angkanya kelebihan.
Dialogue: 0,0:08:26.20,0:08:27.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti...
Dialogue: 0,0:08:27.53,0:08:30.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua bergantung pada\Nkeberuntungan melempar dadu.
Dialogue: 0,0:08:32.37,0:08:35.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan ilahi, bahkan saat\Ndigunakan oleh orang biasa,
Dialogue: 0,0:08:35.46,0:08:39.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hanya buat mereka dapat lihat masa depan\Nsamar atau keberadaan yang tak terlihat,
Dialogue: 0,0:08:39.04,0:08:42.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}serta sedikit meningkatkan\Nkeberuntungan mereka.
Dialogue: 0,0:08:42.41,0:08:47.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan kecil itu bisa menentukan\Nhasil pertandingan judi.
Dialogue: 0,0:08:50.39,0:08:52.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, angka yang bagus, Shizuku!
Dialogue: 0,0:08:53.22,0:08:54.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh...
Dialogue: 0,0:08:54.55,0:08:57.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu juga bisa memakainya, ya.
Dialogue: 0,0:08:57.27,0:08:59.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terkadang memang ada.
Dialogue: 0,0:08:59.31,0:09:02.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang bisa sedikit menambahkan\Nkeberuntungan hasil dadu,
Dialogue: 0,0:09:02.57,0:09:05.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sesuatu yang bahkan Kaisar\Npun tidak bisa kendalikan.
Dialogue: 0,0:09:05.40,0:09:08.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, aku pengecualian, sih.
Dialogue: 0,0:09:10.70,0:09:11.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan...
Dialogue: 0,0:09:17.33,0:09:18.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhenti...
Dialogue: 0,0:09:19.33,0:09:22.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak bisa menang... darinya...
Dialogue: 0,0:09:23.30,0:09:25.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, Miko Desa.
Dialogue: 0,0:09:25.46,0:09:27.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Intuisiku tajam, tahu.
Dialogue: 0,0:09:27.71,0:09:29.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bilang "Kakanda" dari tadi,
Dialogue: 0,0:09:29.76,0:09:32.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi tuan muda di belakangmu itu\Nbukan kakakmu, 'kan?
Dialogue: 0,0:09:32.64,0:09:36.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu sampai mempertaruhkan diri\Nsebagai ganti dirinya...
Dialogue: 0,0:09:36.48,0:09:38.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Kamu suka dia sebagai laki-laki?
Dialogue: 0,0:09:41.52,0:09:43.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, sama sekali.
Dialogue: 0,0:09:44.11,0:09:47.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajar untuk menggantikan posisi tuan,
Dialogue: 0,0:09:47.40,0:09:49.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tetapi sebagai seorang pria,\Nitu sama sekali tidak benar.
Dialogue: 0,0:09:49.82,0:09:50.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sakit hatiku!
Dialogue: 0,0:09:51.74,0:09:53.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu.
Dialogue: 0,0:09:53.69,0:09:58.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau menang, aku akan membawa\NTuan Muda saja, bukan kamu.
Dialogue: 0,0:09:59.08,0:10:02.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajah dan sifatnya tipeku banget.
Dialogue: 0,0:10:04.42,0:10:08.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan ilahi juga dipengaruhi\Noleh keadaan pikiran seseorang.
Dialogue: 0,0:10:08.76,0:10:12.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika tetap tenang seperti dewa,\Nkekuatan ilahi akan melekat.
Dialogue: 0,0:10:12.35,0:10:15.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika gelisah seperti manusia,\Nkekuatan itu akan sirna.
Dialogue: 0,0:10:15.80,0:10:19.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam perjudian, menggertak adalah\Ntindakan mengganggu pikiran lawan
Dialogue: 0,0:10:19.94,0:10:22.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan mencuri kekuatan ilahinya.
Dialogue: 0,0:10:32.41,0:10:36.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat! Aku belum pernah lihat\Nsugoroku seperti ini!
Dialogue: 0,0:10:36.41,0:10:39.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hampir semua angka dadunya enam!
Dialogue: 0,0:10:41.96,0:10:46.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi angka Shizuku sedikit\Ndemi sedikit berkurang.
Dialogue: 0,0:10:47.25,0:10:49.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebentar lagi selesai...
Dialogue: 0,0:10:49.84,0:10:52.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa dia sebenarnya?
Dialogue: 0,0:10:56.10,0:10:57.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian kenapa?
Dialogue: 0,0:10:59.26,0:11:02.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, tidak punya tempat tujuan, ya.
Dialogue: 0,0:11:03.10,0:11:06.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada yang menghormati dewa\Natau Buddha di zaman ini.
Dialogue: 0,0:11:06.69,0:11:10.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan hakikat dewa dan Buddha\Nseperti kalian pun ikut mengembara.
Dialogue: 0,0:11:13.74,0:11:16.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau ke tempatku saja?
Dialogue: 0,0:11:16.12,0:11:18.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku biarkan kalian tinggal kalau berguna.
Dialogue: 0,0:11:25.21,0:11:29.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat itulah aku mendapatkan kekuatan.\NCuma kecil.
Dialogue: 0,0:11:29.55,0:11:33.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, itu kekuatan dahsyat\Ntergantung cara memakainya.
Dialogue: 0,0:11:33.97,0:11:39.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan kekuatan ini, aku akan\Nmembantu Ayahanda dan ambisi beliau!
Dialogue: 0,0:11:43.60,0:11:45.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakanda, tidurlah di pahaku.
Dialogue: 0,0:11:45.56,0:11:46.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke-Kenapa?
Dialogue: 0,0:11:47.23,0:11:51.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak tahu. Tapi sebaiknya mendengarkan\Nusulan Shizuku di situasi ini agar mujur.
Dialogue: 0,0:11:54.61,0:11:57.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mima, Kakanda itu
Dialogue: 0,0:11:57.41,0:12:00.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}punya alasan untuk dibantu
Dialogue: 0,0:12:00.66,0:12:04.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan punya prospek untuk dilayani...
Dialogue: 0,0:12:07.42,0:12:11.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di saat ada banyak yang harus melayani\Ntuan yang bodoh dan tidak kompeten,
Dialogue: 0,0:12:11.26,0:12:16.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku sungguh beruntung bisa dapat tuan\Nyang begitu baik dan peduli pada pengikutnya.
Dialogue: 0,0:12:17.22,0:12:22.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kami para pengikutnya akan lindungi\NKakanda meski nyawa taruhannya.
Dialogue: 0,0:12:23.68,0:12:26.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, aku berbohong akan satu hal.
Dialogue: 0,0:12:28.19,0:12:29.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:12:34.15,0:12:35.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mencintainya.
Dialogue: 0,0:12:36.57,0:12:38.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kamu lakukan, Miko Desa?!
Dialogue: 0,0:12:38.24,0:12:40.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mengutarakan perasaanmu\Nsaat main sugoroku?!
Dialogue: 0,0:12:40.49,0:12:42.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bentar...
Dialogue: 0,0:12:43.04,0:12:45.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih digas lagi?
Dialogue: 0,0:12:45.41,0:12:50.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau sampai bablas? Sungguh gairah\Nyang membara dengan ekspresi dingin...
Dialogue: 0,0:12:50.28,0:12:51.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Giliranmu.
Dialogue: 0,0:12:51.63,0:12:53.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu!
Dialogue: 0,0:12:55.09,0:12:58.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cih. Satu bidak gagal sampai finis.
Dialogue: 0,0:12:58.09,0:13:02.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biarlah. Aku bakal menang\Nasal dapat angka yang pas sekali lagi.
Dialogue: 0,0:13:03.52,0:13:05.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Disosor terus sambil main sugoroku!
Dialogue: 0,0:13:05.19,0:13:07.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami bahkan belum pernah\Nmain sugoroku begitu!
Dialogue: 0,0:13:07.73,0:13:09.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat teknik itu! Ilmu baru!
Dialogue: 0,0:13:11.61,0:13:15.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sialan! Tidak dapat-dapat angka yang pas!
Dialogue: 0,0:13:15.61,0:13:17.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan dia?!
Dialogue: 0,0:13:17.66,0:13:21.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belum pernah lihat orang segila ini\Nbahkan di Kyo!
Dialogue: 0,0:13:25.37,0:13:29.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selisihnya mengecil dengan cepat\Nbukan karena untung dan buntung belaka.
Dialogue: 0,0:13:30.21,0:13:33.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat semua perhatian orang\Ntertuju pada mulut Shizuku,
Dialogue: 0,0:13:33.67,0:13:36.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia memegang bidak lain\Ndan terus maju.
Dialogue: 0,0:13:36.28,0:13:40.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan curang pun\Nsudah masuk perhitungannya.
Dialogue: 0,0:13:40.71,0:13:44.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelayan kita memang hebat\Ndan mengerikan.
Dialogue: 0,0:13:44.64,0:13:47.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat! Pikiranku jadi kacau!
Dialogue: 0,0:13:47.39,0:13:49.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keberuntunganku kabur!
Dialogue: 0,0:13:51.52,0:13:52.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selesai.
Dialogue: 0,0:13:58.41,0:13:59.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hore! Menang!
Dialogue: 0,0:13:59.95,0:14:02.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhasil merebut Genba!
Dialogue: 0,0:14:02.28,0:14:05.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar, merepotkan orang saja.
Dialogue: 0,0:14:08.25,0:14:10.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat!
Dialogue: 0,0:14:10.38,0:14:11.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Introspeksi, kek!
Dialogue: 0,0:14:11.67,0:14:13.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik...
Dialogue: 0,0:14:19.21,0:14:21.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah tidak apa-apa, Kakanda.
Dialogue: 0,0:14:21.47,0:14:22.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menang.
Dialogue: 0,0:14:23.72,0:14:26.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betulan, dong!\NApa yang terjadi?
Dialogue: 0,0:14:26.06,0:14:27.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma memastikan.
Dialogue: 0,0:14:29.77,0:14:34.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak menyukai Kakanda.\NSama sekali.
Dialogue: 0,0:14:36.15,0:14:38.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku menyinggung perasaannya?
Dialogue: 0,0:14:40.11,0:14:41.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu.
Dialogue: 0,0:14:41.49,0:14:44.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa kubiarkan\Nkalian pergi begitu saja.
Dialogue: 0,0:14:44.91,0:14:46.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan, Mima!
Dialogue: 0,0:14:46.58,0:14:47.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kojirou.
Dialogue: 0,0:14:47.37,0:14:48.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak masalah.
Dialogue: 0,0:14:48.79,0:14:51.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dia mencabut pedang,\Naku penggal dia.
Dialogue: 0,0:14:51.46,0:14:54.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu punya bidak-bidak gila.
Dialogue: 0,0:14:54.46,0:14:56.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah, Tuan Muda?!
Dialogue: 0,0:14:58.04,0:15:00.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku suka! Bawalah!
Dialogue: 0,0:15:00.76,0:15:03.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian basara banget!
Dialogue: 0,0:15:03.55,0:15:05.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Basara?
Dialogue: 0,0:15:05.34,0:15:07.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jual itu di Kyo dan nikmati hidupmu.
Dialogue: 0,0:15:07.97,0:15:11.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika orang-orang yang mengalahkanku\Ndibiarkan berkeliaran dengan uang receh,
Dialogue: 0,0:15:11.65,0:15:14.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}itu akan mencoreng nama baik\Nkeluarga Kyogoku-Sasaki yang terhormat.
Dialogue: 0,0:15:15.02,0:15:17.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo main berdua, Tuan Muda!
Dialogue: 0,0:15:17.82,0:15:20.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar aku sendiri\Nyang mengajakmu keliling!
Dialogue: 0,0:15:20.95,0:15:21.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keliling?
Dialogue: 0,0:15:21.86,0:15:23.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, iya!
Dialogue: 0,0:15:23.41,0:15:26.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus, menginaplah\Ndi kediamanku malam nanti.
Dialogue: 0,0:15:29.16,0:15:32.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian ngapain, Miko-Miko Desa?!
Dialogue: 0,0:15:32.00,0:15:33.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyingkir, Serangga Jahat.
Dialogue: 0,0:15:33.54,0:15:35.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau apa berduaan?!
Dialogue: 0,0:15:35.71,0:15:37.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok tanya?
Dialogue: 0,0:15:37.44,0:15:39.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terserah aku, dong.
Dialogue: 0,0:15:39.88,0:15:41.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, aduh, aduh!
Dialogue: 0,0:15:41.72,0:15:46.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, iya, iya!
Dialogue: 0,0:15:46.26,0:15:50.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ajak keliling kalian semua, deh!
Dialogue: 0,0:15:52.72,0:15:55.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Koizumi Chojumaru.
Dialogue: 0,0:15:55.73,0:15:57.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putra penjaga Kuil Suwa?
Dialogue: 0,0:15:57.94,0:15:59.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya...
Dialogue: 0,0:15:59.56,0:16:03.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sedang berkeliling meminta sumbangan\Nkepada kuil-kuil Suwa di sekitar Kyo.
Dialogue: 0,0:16:04.65,0:16:07.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cabang Kuil Suwa memang\Nada di seluruh negeri, sih.
Dialogue: 0,0:16:07.99,0:16:11.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oalah, kukira anak dari keluarga\Nyang lebih terpandang.
Dialogue: 0,0:16:12.08,0:16:15.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada apa-apanya\Ndibanding ayahku.
Dialogue: 0,0:16:15.46,0:16:16.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:16:17.29,0:16:21.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oi, jika dia putri samurai di Kyo,\Nitu berarti dia musuh, 'kan?
Dialogue: 0,0:16:21.46,0:16:23.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya.
Dialogue: 0,0:16:23.01,0:16:25.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa mereka bareng begitu?
Dialogue: 0,0:16:25.55,0:16:26.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entahlah.
Dialogue: 0,0:16:26.76,0:16:30.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dicurigai sedikit saja,\Nkita bawa Tuan Muda dan langsung kabur...
Dialogue: 0,0:16:34.52,0:16:37.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hakama yang mencolok dan besar!
Dialogue: 0,0:16:37.14,0:16:40.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hakama model oguchi\Nyang sedang tren di Kyo.
Dialogue: 0,0:16:40.28,0:16:45.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang-orang yang berpakaian dan bertindak\Nnyentrik seperti itu disebut basara.
Dialogue: 0,0:16:45.32,0:16:48.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pakaian aneh yang kamu pakai juga basara?
Dialogue: 0,0:16:48.41,0:16:49.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:16:49.94,0:16:50.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ekshibisionis.
Dialogue: 0,0:16:50.99,0:16:53.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cerewet, komentarmu\Nmenyebalkan, Miko Desa!
Dialogue: 0,0:16:54.12,0:16:57.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Samurai yang menggulingkan Kamakura\Ndan masuk ke Kyo
Dialogue: 0,0:16:57.92,0:17:01.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mulai hidup dengan pakaian yang nyeleneh,
Dialogue: 0,0:17:01.50,0:17:04.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bahkan kaum bangsawan mulai menirunya.
Dialogue: 0,0:17:05.09,0:17:07.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang-orang menyebutnya "basara".
Dialogue: 0,0:17:07.29,0:17:11.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini adalah ledakan fesyen pertama di Jepang\Nyang dimulai oleh para samurai.
Dialogue: 0,0:17:11.76,0:17:15.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pencetusnya adalah ayahku.
Dialogue: 0,0:17:15.09,0:17:18.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buang saja pandangan samurai kunomu,\NTuan Muda.
Dialogue: 0,0:17:18.61,0:17:20.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Zaman dan norma sudah berubah.
Dialogue: 0,0:17:20.90,0:17:23.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini adalah zamannya kebebasan.
Dialogue: 0,0:17:24.98,0:17:28.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oi! Keroco! Samurai desa!
Dialogue: 0,0:17:28.70,0:17:30.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo pergi!
Dialogue: 0,0:17:30.47,0:17:33.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kyo tidak sekecil itu\Nuntuk dikelilingi sehari.
Dialogue: 0,0:17:33.62,0:17:36.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya butuh satu bulan,\Njadi bersiaplah.
Dialogue: 0,0:17:37.79,0:17:42.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu mengakui seseorang, dia tunjukkan\Nkasih sayangnya secara terbuka.
Dialogue: 0,0:17:42.71,0:17:45.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya berat harus\Nmerahasiakan identitasku,
Dialogue: 0,0:17:45.67,0:17:49.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku akan manfaatkan kesempatan ini\Nuntuk perdalam pemahamanku tentang Kyo.
Dialogue: 0,0:17:49.30,0:17:52.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah tidak kuat jalan lagi!\NAyo ke penginapan!
Dialogue: 0,0:17:52.51,0:17:54.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Staminamu keroco banget!
Dialogue: 0,0:17:54.97,0:17:57.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pesona Kyo baru—
Dialogue: 0,0:17:58.56,0:17:59.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oi!
Dialogue: 0,0:18:01.94,0:18:06.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minta maaflah, Gadis Cilik.\NMain sambil pakai baju tidak senonoh begitu.
Dialogue: 0,0:18:07.28,0:18:08.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ehe.
Dialogue: 0,0:18:13.91,0:18:17.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu kota Kyo benar-benar busuk.
Dialogue: 0,0:18:17.79,0:18:20.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa menjatuhkan putusan adil,
Dialogue: 0,0:18:20.42,0:18:23.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}samurai dan gadis kecil pun\Nberpakaian tak senonoh.
Dialogue: 0,0:18:26.29,0:18:30.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang desa minum alkohol siang bolong\Ndan mengoceh tidak jelas.
Dialogue: 0,0:18:31.88,0:18:36.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pasti samurai dari timur\Nyang tidak mendapat hadiah jasa, ya?
Dialogue: 0,0:18:36.47,0:18:40.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku melihat para pecundang\Nsepertimu tiap hari.
Dialogue: 0,0:18:41.02,0:18:42.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu...
Dialogue: 0,0:18:42.06,0:18:44.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, orang Nitta, ya?
Dialogue: 0,0:18:47.40,0:18:49.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nitta Yoshisada!
Dialogue: 0,0:18:49.34,0:18:51.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelaku serangan di Kamakura!
Dialogue: 0,0:18:54.61,0:18:59.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kasihan! Majikan kalian bego
Dialogue: 0,0:18:59.25,0:19:03.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}makanya para pengikutnya tidak menerima\Nbalas budi dari Kaisar.
Dialogue: 0,0:19:04.50,0:19:06.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis Cilik!
Dialogue: 0,0:19:06.75,0:19:08.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau ingin ditebas, ya.
Dialogue: 0,0:19:09.09,0:19:10.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mima!
Dialogue: 0,0:19:10.34,0:19:14.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biarkan, biarkan.\NTerserah mau pukul atau tebas aku.
Dialogue: 0,0:19:14.35,0:19:19.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putri samurai dari Kyo mana mungkin takut\Ndengan samurai pedesaan.
Dialogue: 0,0:19:19.14,0:19:22.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayahku akan membalas ribuan kali lipat.
Dialogue: 0,0:19:24.44,0:19:26.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kojirou, Ayako.
Dialogue: 0,0:19:26.27,0:19:29.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebelum terjadi keributan,\Napa kalian bisa menjatuhkan samurai ini?
Dialogue: 0,0:19:29.98,0:19:31.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja.
Dialogue: 0,0:19:31.15,0:19:32.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami bakal imbangi Tuan Muda.
Dialogue: 0,0:19:34.49,0:19:36.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berani-beraninya!
Dialogue: 0,0:19:36.49,0:19:40.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah memenggal tiga kepala\Ndi penyerangan ke Kamakura!
Dialogue: 0,0:19:56.47,0:19:59.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau putri dari keluarga baik-baik, 'kan?
Dialogue: 0,0:19:59.30,0:20:01.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa repot kalau ada luka di wajahmu.
Dialogue: 0,0:20:02.68,0:20:05.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemikiran semacam itu juga kuno, ya?
Dialogue: 0,0:20:05.98,0:20:09.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya aku tidak cocok dengan basara.
Dialogue: 0,0:20:10.48,0:20:12.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bau alkohol!
Dialogue: 0,0:20:12.20,0:20:15.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi orang ini tidak sehebat\Nomongannya, ya, Tuan Muda.
Dialogue: 0,0:20:16.99,0:20:20.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok alim banget?\NCewek bisa kelepek-kelepek, tahu!
Dialogue: 0,0:20:20.12,0:20:23.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malah jadi basara!
Dialogue: 0,0:20:24.04,0:20:27.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin perkenalkan dia ke Ayahanda.
Dialogue: 0,0:20:29.75,0:20:34.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, ternyata begitu.
Dialogue: 0,0:20:36.76,0:20:41.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah tidak kuat!\NAku hampir saja mati!
Dialogue: 0,0:20:41.22,0:20:42.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu.
Dialogue: 0,0:20:42.48,0:20:45.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu pasti sangat menakutkan.
Dialogue: 0,0:20:45.98,0:20:50.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tandu perang hancur,\Naset habis menyewa tokoh-tokoh kuat,
Dialogue: 0,0:20:50.82,0:20:53.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan Kaisar tak mau menemuiku!
Dialogue: 0,0:20:53.78,0:20:56.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah tidak mau turun\Nke medan perang!
Dialogue: 0,0:20:59.86,0:21:01.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betapa pun tidak kompetennya seseorang,
Dialogue: 0,0:21:01.95,0:21:06.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}nyawa manusia tetap berharga\Ndan tak tergantikan.
Dialogue: 0,0:21:06.24,0:21:12.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak dimanfaatkan sampai habis,\NBuddha pun akan murka.
Dialogue: 0,0:21:16.17,0:21:17.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Kiyohara.
Dialogue: 0,0:21:19.93,0:21:22.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu takut lagi.
Dialogue: 0,0:21:25.06,0:21:29.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan saja pada Takauji,\Nsemuanya akan baik-baik saja.
Dialogue: 0,0:21:29.81,0:21:33.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari, tutup matamu perlahan.
Dialogue: 0,0:21:37.82,0:21:40.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senyuman ini
Dialogue: 0,0:21:40.28,0:21:44.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sungguh menenangkan hatiku.
Dialogue: 0,0:21:47.20,0:21:51.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jauh lebih menenangkan dari Kaisar...
Dialogue: 0,0:22:06.64,0:22:11.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bila ingin romantis♪
Dialogue: 0,0:22:11.52,0:22:14.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cintai aku lebih dari siapa pun♪
Dialogue: 0,0:22:20.11,0:22:23.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kamu orang yang baik♪
Dialogue: 0,0:22:23.49,0:22:27.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bakal baik ke gadis itu juga, 'kan?♪
Dialogue: 0,0:22:27.25,0:22:30.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa, tidak masalah♪
Dialogue: 0,0:22:30.58,0:22:34.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong bawakan\Nsemua barang beratnya, ya♪
Dialogue: 0,0:22:34.30,0:22:37.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu keren di depan orang-orang♪
Dialogue: 0,0:22:37.47,0:22:41.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kamu imut saat kita berduaan♪
Dialogue: 0,0:22:41.26,0:22:44.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setia seperti anjing♪
Dialogue: 0,0:22:44.60,0:22:50.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan menghilang seperti kucing, ya♪
Dialogue: 0,0:22:51.27,0:22:54.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terkadang aku sedih♪
Dialogue: 0,0:22:54.77,0:22:58.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi sentimental\Nsaat menatap bintang♪
Dialogue: 0,0:22:58.36,0:23:05.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini, kamu dengan siapa\Ndan sedang apa?♪
Dialogue: 0,0:23:05.49,0:23:09.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, jika kamu mau\Nmencintai dan dicintai♪
Dialogue: 0,0:23:09.46,0:23:12.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan selalu membuatmu berdebar♪
Dialogue: 0,0:23:12.92,0:23:16.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika tidak memilihku♪
Dialogue: 0,0:23:16.50,0:23:20.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menjatuhkanmu ke neraka♪
Dialogue: 0,0:23:20.17,0:23:23.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mendengarmu♪
Dialogue: 0,0:23:23.64,0:23:27.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau tahu lagi♪
Dialogue: 0,0:23:27.39,0:23:31.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bila ingin romantis♪
Dialogue: 0,0:23:31.02,0:23:33.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cintai aku lebih dari siapa pun♪
Dialogue: 0,0:23:38.61,0:23:39.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo!
