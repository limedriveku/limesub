Dialogue: 0,0:00:43.36,0:00:48.03,sign,,0000,0000,0000,,VICTORIA OF MANY FACES
Dialogue: 0,0:02:01.98,0:02:07.52,sign,,0000,0000,0000,,EPISODE 7: KENANGAN INDAH YANG TERCIPTA
Dialogue: 0,0:08:39.71,0:08:40.91,sign,,0000,0000,0000,,MELOMPAT
Dialogue: 0,0:08:40.91,0:08:42.21,sign,,0000,0000,0000,,BERGULING
Dialogue: 0,0:08:42.21,0:08:43.21,sign,,0000,0000,0000,,BERHASIL
Dialogue: 0,0:16:29.34,0:16:31.26,sign,,0000,0000,0000,,ISTANA KERAJAAN ASHBURY
Dialogue: 0,0:16:37.27,0:16:39.52,sign,,0000,0000,0000,,DEPARTEMEN MANAJEMEN KEAMANAN SISTEM
Dialogue: 0,0:16:39.52,0:16:41.94,sign,,0000,0000,0000,,DIKENAL SEBAGAI PASUKAN KESATRIA KETIGA
Dialogue: 0,0:00:04.30,0:00:05.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu Guru.
Dialogue: 0,0:00:05.71,0:00:08.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa Nonna naik ke kereta kuda mereka?
Dialogue: 0,0:00:09.85,0:00:11.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Clark.
Dialogue: 0,0:00:12.10,0:00:14.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga ingin tahu.
Dialogue: 0,0:00:16.27,0:00:17.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu Guru?
Dialogue: 0,0:00:18.94,0:00:22.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon maaf, aku harus pulang.
Dialogue: 0,0:02:10.18,0:02:12.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Victoria, apa yang terjadi?
Dialogue: 0,0:02:13.85,0:02:17.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nonna sepertinya akan menjadi\Nputri angkat bangsawan.
Dialogue: 0,0:02:19.39,0:02:20.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya?
Dialogue: 0,0:02:20.70,0:02:22.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa Nonna juga setuju?
Dialogue: 0,0:02:22.75,0:02:23.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya begitu.
Dialogue: 0,0:02:30.41,0:02:31.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:02:31.91,0:02:33.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami sudah menjalin hubungan baik, kan?
Dialogue: 0,0:02:34.99,0:02:36.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah hidup senang bersama, kan?
Dialogue: 0,0:02:39.18,0:02:40.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Victoria, kamu di dalam?
Dialogue: 0,0:02:42.96,0:02:45.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak ingin\Ndia melihat wajahku yang lesu.
Dialogue: 0,0:02:46.05,0:02:47.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu ada di dalam, kan?
Dialogue: 0,0:02:47.38,0:02:49.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tak buka pintunya, aku dobrak, ya!
Dialogue: 0,0:02:49.84,0:02:51.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pintunya tidak kukunci.
Dialogue: 0,0:02:56.60,0:02:58.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya Yolana sudah memberitahuku.
Dialogue: 0,0:02:59.23,0:03:01.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar Nonna akan diangkat\Nmenjadi anak bangsawan.
Dialogue: 0,0:03:02.36,0:03:08.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku selalu mengira\NNonna akan selalu berada di sisiku.
Dialogue: 0,0:03:08.71,0:03:12.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi Nonna berhak\Nmenentukan hidupnya sendiri.
Dialogue: 0,0:03:12.51,0:03:13.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Victoria.
Dialogue: 0,0:03:16.28,0:03:19.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nonna pasti punya alasannya sendiri.
Dialogue: 0,0:03:19.36,0:03:22.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, aku juga berpikir begitu.
Dialogue: 0,0:03:22.45,0:03:25.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku merasa\Nitu juga baik untuk Nonna.
Dialogue: 0,0:03:26.21,0:03:28.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau menjadi putri angkat bangsawan,
Dialogue: 0,0:03:28.05,0:03:31.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}status dan kehidupannya\Nakan lebih terjamin,
Dialogue: 0,0:03:31.45,0:03:32.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}juga akan lebih aman.
Dialogue: 0,0:03:32.78,0:03:36.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan merendahkan dirimu sendiri\Ndengan ucapan seperti itu.
Dialogue: 0,0:03:37.05,0:03:40.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu itu wanita yang kuat dan hebat.
Dialogue: 0,0:03:40.64,0:03:42.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pasti akan kembali.
Dialogue: 0,0:03:44.29,0:03:46.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dia tidak kembali,
Dialogue: 0,0:03:47.11,0:03:50.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku merasa sakit karena itu justru\Nakan membuatnya lebih bahagia.
Dialogue: 0,0:03:53.78,0:03:55.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Victoria,
Dialogue: 0,0:03:55.15,0:03:58.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}biarkan Nonna sendiri\Nyang memutuskan kebahagiaannya.
Dialogue: 0,0:03:59.04,0:04:00.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pasti akan baik-baik saja.
Dialogue: 0,0:04:00.73,0:04:02.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pasti akan memilihmu\Ndan kembali pulang.
Dialogue: 0,0:04:05.43,0:04:06.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:04:08.00,0:04:10.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agar dia bisa kembali dengan gembira,
Dialogue: 0,0:04:10.76,0:04:14.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku harus menjahitkan\Nkancing kain pada bajunya dulu.
Dialogue: 0,0:04:17.05,0:04:18.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:04:18.99,0:04:20.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang aku baik-baik saja.
Dialogue: 0,0:04:21.22,0:04:22.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau kumasakkan sesuatu?
Dialogue: 0,0:04:22.99,0:04:24.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah makan malam?
Dialogue: 0,0:04:26.02,0:04:27.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf cuma seadanya.
Dialogue: 0,0:04:27.83,0:04:30.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sudah cukup.\NTerlihat enak juga.
Dialogue: 0,0:04:31.19,0:04:33.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin Nonna pasti akan kembali.
Dialogue: 0,0:04:34.17,0:04:36.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu tak ingin dia pergi,\Ntak perlu menahan diri.
Dialogue: 0,0:04:37.41,0:04:39.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Langsung pergi ke rumah Baron\Ndan bawa dia pulang.
Dialogue: 0,0:04:39.95,0:04:41.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau takut pergi sendiri,
Dialogue: 0,0:04:41.80,0:04:43.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan menemanimu!
Dialogue: 0,0:04:46.29,0:04:50.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin mengutamakan keinginan anak itu,\Njadi akan kutunggu.
Dialogue: 0,0:04:52.01,0:04:53.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu.
Dialogue: 0,0:05:02.39,0:05:06.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama Nonna tidak ada,\Naku akan mencoba hidup tanpa dia dulu.
Dialogue: 0,0:05:10.15,0:05:11.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:05:14.17,0:05:15.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Miles,
Dialogue: 0,0:05:15.65,0:05:18.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa bantu aku berlatih\Ndan jadi lawan bertarungku?
Dialogue: 0,0:05:18.63,0:05:21.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh, aku siap kapan saja.
Dialogue: 0,0:05:33.47,0:05:36.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kena.\NKedua matamu sudah kurobek.
Dialogue: 0,0:05:36.51,0:05:38.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku kalah.\NSekali lagi.
Dialogue: 0,0:05:39.43,0:05:40.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berapa kali lagi pun boleh.
Dialogue: 0,0:05:45.18,0:05:46.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa dengan anak itu?
Dialogue: 0,0:05:48.87,0:05:51.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tinggal di rumah orang lain.
Dialogue: 0,0:06:04.24,0:06:07.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah menghindari titik vital\Ndan hanya menyerang sendi pinggul.
Dialogue: 0,0:06:08.68,0:06:12.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sendi pinggul orang tua\Nsama saja dengan titik vital.
Dialogue: 0,0:06:13.67,0:06:16.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu belum tua.
Dialogue: 0,0:06:17.86,0:06:20.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu akhirnya semangat lagi, ya.
Dialogue: 0,0:06:20.21,0:06:21.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:06:22.39,0:06:24.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:06:24.03,0:06:24.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai jumpa.
Dialogue: 0,0:06:24.61,0:06:26.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bebas datang kapan pun.
Dialogue: 0,0:06:26.14,0:06:28.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini sangat seru.
Dialogue: 0,0:06:31.62,0:06:34.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Miles tidak banyak bertanya.
Dialogue: 0,0:06:35.61,0:06:38.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula,\Naku sudah dapat jawaban yang kucari.
Dialogue: 0,0:06:49.75,0:06:50.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Clark.
Dialogue: 0,0:06:51.12,0:06:53.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku paham apa yang akan kamu katakan,
Dialogue: 0,0:06:53.45,0:06:56.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku menghargai keputusan Nonna.
Dialogue: 0,0:06:57.96,0:07:00.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku, pasti tidak akan\Nmembiarkan Nonna pergi!
Dialogue: 0,0:07:58.86,0:08:00.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sedang apa?
Dialogue: 0,0:08:07.49,0:08:10.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jalan sendirian di luar\Ndengan pakaian seperti itu di tengah malam.
Dialogue: 0,0:08:10.89,0:08:13.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sama saja seperti mengundang\Npenjahat untuk menyerangmu.
Dialogue: 0,0:08:14.17,0:08:15.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu melakukan hal seperti ini?
Dialogue: 0,0:08:15.91,0:08:18.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesuai janji, aku sudah tinggal\Ndi sana enam hari.
Dialogue: 0,0:08:18.24,0:08:19.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini,
Dialogue: 0,0:08:19.02,0:08:21.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hari ini pintu kamarnya dikunci.
Dialogue: 0,0:08:21.52,0:08:24.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu mereka memanggilku Dolores.
Dialogue: 0,0:08:24.87,0:08:28.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan menyuruhku\Nmemanggil mereka Ayah dan Ibu.
Dialogue: 0,0:08:28.47,0:08:29.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau.
Dialogue: 0,0:08:29.53,0:08:30.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bukan Dolores.
Dialogue: 0,0:08:30.70,0:08:32.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka juga bukan orang tuaku.
Dialogue: 0,0:08:33.03,0:08:34.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, bagaimana caramu bisa kabur?
Dialogue: 0,0:08:35.48,0:08:38.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku lompat dari jendela lantai dua\Nsambil pegangan di kusen.
Dialogue: 0,0:08:39.71,0:08:40.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berguling saat mendarat
Dialogue: 0,0:08:40.91,0:08:43.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}seperti yang kamu ajarkan.
Dialogue: 0,0:08:44.46,0:08:47.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu hanya untuk situasi darurat.
Dialogue: 0,0:08:47.47,0:08:49.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Situasinya darurat karena pintunya dikunci.
Dialogue: 0,0:08:49.93,0:08:52.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Juga karena aku dianggap\Nsebagai anak yang sudah mati.
Dialogue: 0,0:08:53.72,0:08:54.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:08:54.91,0:08:57.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengunci pintu itu sudah keterlaluan.
Dialogue: 0,0:08:57.44,0:09:02.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kenapa kamu\Ntidak menolak dari awal saja?
Dialogue: 0,0:09:03.34,0:09:05.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat itu, Nyonya Eva tampak kebingungan.
Dialogue: 0,0:09:06.51,0:09:09.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat kebingungan,\Nbeliau akan menggenggam saputangannya.
Dialogue: 0,0:09:09.74,0:09:11.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sebabnya aku setuju untuk pergi.
Dialogue: 0,0:09:11.48,0:09:13.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka juga bilang aku boleh menolak.
Dialogue: 0,0:09:13.74,0:09:17.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa sebelumnya kamu pernah lihat\NNyonya Eva kebingungan?
Dialogue: 0,0:09:17.29,0:09:18.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pernah.
Dialogue: 0,0:09:18.19,0:09:21.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat aku menyerang Tuan Clark dengan lutut.
Dialogue: 0,0:09:21.25,0:09:25.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu menyerang Tuan Clark dengan lutut?
Dialogue: 0,0:09:25.13,0:09:26.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:09:26.00,0:09:28.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bilang ingin melihatku melakukannya.
Dialogue: 0,0:09:28.65,0:09:30.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin melihat demonstrasi serangan lutut.
Dialogue: 0,0:09:30.59,0:09:31.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh.
Dialogue: 0,0:09:31.51,0:09:32.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sakit!
Dialogue: 0,0:09:32.56,0:09:34.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian berdua sedang apa?
Dialogue: 0,0:09:35.12,0:09:39.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada saat aku tidak mengawasinya,\Nkamu sudah melakukan apa saja?
Dialogue: 0,0:09:40.79,0:09:43.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kabur dari rumah Baron tengah malam?
Dialogue: 0,0:09:44.17,0:09:46.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka pasti sangat khawatir.
Dialogue: 0,0:09:46.71,0:09:49.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi kami ingin ke sana untuk minta maaf.
Dialogue: 0,0:09:50.43,0:09:54.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, kalian sebaiknya jangan pergi.
Dialogue: 0,0:09:54.15,0:09:56.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan kirim orang untuk mereka.
Dialogue: 0,0:09:57.14,0:10:01.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Empat tahun lalu, ibu kota pernah\Ndilanda wabah flu demam tinggi.
Dialogue: 0,0:10:01.77,0:10:05.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak anak-anak dan orang tua\Nyang meninggal karenanya.
Dialogue: 0,0:10:05.04,0:10:08.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada saat itu, Clark juga tertular,\Nbahkan demam tinggi.
Dialogue: 0,0:10:08.96,0:10:11.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untungnya, dia akhirnya sembuh.
Dialogue: 0,0:10:12.41,0:10:16.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, karena suamiku seorang\NMenteri Luar Negeri,
Dialogue: 0,0:10:16.16,0:10:19.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ada rumor bahwa kami menggunakan\Nobat bagus dari luar negeri.
Dialogue: 0,0:10:20.17,0:10:21.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sebenarnya salah paham,
Dialogue: 0,0:10:21.68,0:10:24.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi bagaimanapun kami menyangkal,\Nrumor itu tak kunjung hilang.
Dialogue: 0,0:10:24.81,0:10:29.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, pada suatu hari,\NBaron Hanson datang ke rumahku.
Dialogue: 0,0:10:29.72,0:10:33.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sambil menangis, dia memohon\Nagar kami memberinya obat.
Dialogue: 0,0:10:33.49,0:10:36.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka bilang, kalau terus begini,\Nputrinya akan meninggal.
Dialogue: 0,0:10:36.77,0:10:38.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya Eva,
Dialogue: 0,0:10:38.00,0:10:41.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}itu sama sekali bukan tanggung jawab\NKeluarga Anderson.
Dialogue: 0,0:10:41.50,0:10:43.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Logikanya begitu.
Dialogue: 0,0:10:43.52,0:10:45.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi bagi mereka, itu tak bisa diterima.
Dialogue: 0,0:10:47.44,0:10:50.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf sudah menyeretmu ke perselisihan\Nantara keluarga kami dan Hanson.
Dialogue: 0,0:10:51.38,0:10:54.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah merepotkanmu dan Nonna.
Dialogue: 0,0:10:55.24,0:10:56.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keesokan harinya,
Dialogue: 0,0:10:56.39,0:11:00.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baron Hanson mengirimkan\Nbarang bawaan dan sepucuk surat.
Dialogue: 0,0:11:01.17,0:11:04.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Meski tidak lama,\Nkami senang telah diperbolehkan
Dialogue: 0,0:11:04.96,0:11:08.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}merasakan kehadiran Dolores kembali."
Dialogue: 0,0:11:10.22,0:11:13.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nonna, di sini ada gaun dan sepatu mahal,
Dialogue: 0,0:11:13.14,0:11:15.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}juga ada perhiasan dan tas.
Dialogue: 0,0:11:17.35,0:11:19.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perasaanku campur aduk.
Dialogue: 0,0:11:19.62,0:11:24.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat membuang barang-barang ini,\Nseperti apa perasaan pasutri itu?
Dialogue: 0,0:11:24.98,0:11:27.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Tidak ada yang bisa menggantikan anakku."
Dialogue: 0,0:11:27.79,0:11:30.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin inilah yang mereka pikirkan.
Dialogue: 0,0:11:30.71,0:11:31.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada waktu itu,
Dialogue: 0,0:11:32.17,0:11:34.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}saat membuangku yang baru delapan tahun,
Dialogue: 0,0:11:34.87,0:11:38.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa orang tuaku akan merasa kesepian?
Dialogue: 0,0:11:40.79,0:11:48.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakakku sepertinya sudah mengingatkan\NBaron Hanson bahwa kamulah wali Nonna.
Dialogue: 0,0:11:48.31,0:11:51.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan Tuan Edward juga ikut membantu.
Dialogue: 0,0:11:51.76,0:11:53.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan meluangkan waktu\Nuntuk berterima kasih.
Dialogue: 0,0:11:53.99,0:11:55.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu.
Dialogue: 0,0:11:55.55,0:11:58.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakakku juga berterima kasih\Nkarena sudah membantu Paman.
Dialogue: 0,0:11:58.88,0:12:01.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nonna, saat tinggal di rumah Baron,
Dialogue: 0,0:12:01.49,0:12:03.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa mereka memperlakukanmu dengan buruk?
Dialogue: 0,0:12:04.31,0:12:05.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:12:05.54,0:12:09.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi agak tidak nyaman\Nsaat hanya berdua dengan Nyonya.
Dialogue: 0,0:12:09.09,0:12:11.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beliau terus memanggilku Dolores.
Dialogue: 0,0:12:11.36,0:12:15.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan aku takut saat beliau menangis bilang\Nkeluarganya akhirnya lengkap.
Dialogue: 0,0:12:18.22,0:12:20.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku sudah tidak peduli lagi.
Dialogue: 0,0:12:22.04,0:12:25.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu benar-benar kuat,\Ndan juga sangat baik.
Dialogue: 0,0:12:25.39,0:12:27.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Vicky.
Dialogue: 0,0:12:27.01,0:12:28.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:12:28.14,0:12:30.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak tinggal bersama Jeff?
Dialogue: 0,0:12:31.34,0:12:32.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh.
Dialogue: 0,0:12:36.22,0:12:38.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bisa, itu sebenarnya bagus.
Dialogue: 0,0:12:38.69,0:12:40.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kami tidak bisa.
Dialogue: 0,0:12:46.69,0:12:49.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari awal, rencanaku\Ntidak tinggal lama di suatu tempat
Dialogue: 0,0:12:49.54,0:12:52.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan bepergian ke negara lain\Nsetiap sekitar setengah tahun.
Dialogue: 0,0:12:52.90,0:12:54.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, aku sudah siap!
Dialogue: 0,0:12:56.09,0:12:57.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Miles
Dialogue: 0,0:12:57.26,0:13:00.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bukan penghuni asli rumah itu.
Dialogue: 0,0:13:00.38,0:13:03.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penghuni aslinya kidal dan bertubuh kecil.
Dialogue: 0,0:13:04.97,0:13:06.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah berlatih bersamanya,
Dialogue: 0,0:13:07.18,0:13:10.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku menyadari bahwa Miles\Nsama sekali bukan kidal.
Dialogue: 0,0:13:10.94,0:13:13.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Posisi paku di dinding\Nuntuk menggantung barang relatif rendah.
Dialogue: 0,0:13:13.65,0:13:19.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kaus kaki bekas yang dijadikan kain lap\Nterlalu kecil untuk Miles.
Dialogue: 0,0:13:20.61,0:13:25.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seorang mantan tentara tinggal\Ndi dekat mantan agen rahasia.
Dialogue: 0,0:13:25.06,0:13:27.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, dia bukan\Npenghuni asli rumah itu,
Dialogue: 0,0:13:28.15,0:13:33.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}juga bertemu di rute lari pagiku\Nsetiap hari.
Dialogue: 0,0:13:33.75,0:13:35.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini tidak bisa disebut kebetulan lagi.
Dialogue: 0,0:13:36.34,0:13:39.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk mengetahui setiap gerakanku,
Dialogue: 0,0:13:39.05,0:13:41.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}seseorang menempatkan Miles\Nuntuk tinggal di sana.
Dialogue: 0,0:13:42.51,0:13:44.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sudah merasa berbahaya,\Nsebaiknya pindah.
Dialogue: 0,0:13:45.20,0:13:47.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Intuisiku mendesakku untuk pergi.
Dialogue: 0,0:13:49.77,0:13:50.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nonna?
Dialogue: 0,0:13:53.42,0:13:55.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu demam!
Dialogue: 0,0:13:58.90,0:14:00.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jeff.
Dialogue: 0,0:14:00.20,0:14:03.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang karena kamu\Nmencemaskan kesehatanku.
Dialogue: 0,0:14:04.18,0:14:08.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kalau sedang sibuk,\Nutamakan urusanmu dulu saja.
Dialogue: 0,0:14:08.09,0:14:09.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang aku bujangan bebas.
Dialogue: 0,0:14:09.89,0:14:12.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada urusan yang sepenting itu, Ibu.
Dialogue: 0,0:14:13.69,0:14:18.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dengar dari Edward bahwa kamu\Npunya teman wanita yang akrab.
Dialogue: 0,0:14:19.91,0:14:23.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapan akan perkenalkan dia padaku?
Dialogue: 0,0:14:23.63,0:14:25.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal itu...
Dialogue: 0,0:14:25.12,0:14:27.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa tunggu sebentar lagi?
Dialogue: 0,0:14:27.41,0:14:29.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami belum menjalin hubungan apa pun.
Dialogue: 0,0:14:30.71,0:14:34.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, kamu cukup berhati-hati, ya.
Dialogue: 0,0:14:35.17,0:14:36.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhati-hati, ya?
Dialogue: 0,0:14:37.36,0:14:40.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga merasa Victoria\Nseharusnya tidak membenciku.
Dialogue: 0,0:14:40.83,0:14:43.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, setiap kali aku ingin\Nmelangkah lebih jauh,
Dialogue: 0,0:14:43.70,0:14:45.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia akan mundur.
Dialogue: 0,0:14:45.86,0:14:47.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat jamuan malam,
Dialogue: 0,0:14:47.41,0:14:50.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia orang pertama yang menyadari\Ngerak-gerik mencurigakan pria itu.
Dialogue: 0,0:14:51.02,0:14:54.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pangeran Cedric yang ahli berpedang juga\Ndikalahkannya, bahkan patah tulang.
Dialogue: 0,0:14:54.54,0:14:56.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedangkan dia tidak terluka sedikit pun.
Dialogue: 0,0:14:56.97,0:14:58.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menguasai empat bahasa,
Dialogue: 0,0:14:58.75,0:15:00.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}juga ahli dalam mengurus rumah.
Dialogue: 0,0:15:01.09,0:15:03.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ilmu bela diri dan ilmu pedangnya\Njuga sangat kuat.
Dialogue: 0,0:15:03.28,0:15:06.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua ini mengarah pada satu jawaban.
Dialogue: 0,0:15:07.12,0:15:08.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agen rahasia yang melarikan diri.
Dialogue: 0,0:15:09.41,0:15:13.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin agen rahasia\Ndari negara musuh Ashbury.
Dialogue: 0,0:15:13.96,0:15:16.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak membahas pengalaman masa lalu.
Dialogue: 0,0:15:16.04,0:15:19.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alasan tidak bisa cerita\Nhal yang dia takutkan juga wajar.
Dialogue: 0,0:15:20.01,0:15:22.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Victoria Sellers juga nama palsu, kan?
Dialogue: 0,0:15:23.82,0:15:28.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, mendekati aku dan Paman\Ntidak akan memberi keuntungan apa pun.
Dialogue: 0,0:15:29.00,0:15:32.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menjadi guru privat Clark juga\Nkarena permintaan Eva.
Dialogue: 0,0:15:32.42,0:15:34.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Juga tak terlihat sedang menjalankan misi.
Dialogue: 0,0:15:34.23,0:15:36.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dilihat dari usianya,\Nmustahil sudah pensiun.
Dialogue: 0,0:15:36.90,0:15:40.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti, kemungkinannya dia\Nkabur dari organisasinya
Dialogue: 0,0:15:40.43,0:15:42.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan semuanya akan masuk akal.
Dialogue: 0,0:15:43.30,0:15:44.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya saja,
Dialogue: 0,0:15:44.52,0:15:45.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa yang harus kulakukan?
Dialogue: 0,0:15:47.18,0:15:49.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo, aku beli kastanya panggang.
Dialogue: 0,0:15:49.55,0:15:51.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten.
Dialogue: 0,0:15:51.06,0:15:52.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih selalu mampir kemari.
Dialogue: 0,0:15:52.56,0:15:54.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau memilih hidup bersamanya,
Dialogue: 0,0:15:54.56,0:15:56.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Silakan masuk.\N- agar tidak merepotkannya,
Dialogue: 0,0:15:56.31,0:15:58.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Bagaimana keadaan Nonna?\N- meninggalkan status keluarga,
Dialogue: 0,0:15:58.42,0:16:00.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Berkatmu, demamnya turun.\N- menjadi rakyat biasa adalah yang terbaik.
Dialogue: 0,0:16:01.72,0:16:04.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku merasa Victoria akan bilang,
Dialogue: 0,0:16:04.40,0:16:07.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Jangan terlalu ikut campur\Ndalam kehidupan kami."
Dialogue: 0,0:16:07.92,0:16:10.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku mengutarakan perasaanku\Nuntuk hidup bersama
Dialogue: 0,0:16:10.76,0:16:14.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia akan pergi bersama Nonna.
Dialogue: 0,0:16:15.03,0:16:17.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dia benar-benar ingin pergi,
Dialogue: 0,0:16:17.98,0:16:21.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tidak akan pernah menemukannya lagi.
Dialogue: 0,0:16:21.50,0:16:23.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih selalu membantu kami.
Dialogue: 0,0:16:31.26,0:16:36.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa wanita berambut merah yang membantu\Npelarian itu belum ditemukan?
Dialogue: 0,0:16:36.33,0:16:37.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum, Ketua.
Dialogue: 0,0:16:37.27,0:16:39.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena motif pelarian tidak jelas,
Dialogue: 0,0:16:39.52,0:16:40.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami sulit mempersempit area pencarian
Dialogue: 0,0:16:40.98,0:16:41.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan saat ini sedang buntu.
Dialogue: 0,0:16:41.94,0:16:43.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu.
Dialogue: 0,0:16:43.15,0:16:44.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu,
Dialogue: 0,0:16:44.23,0:16:46.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adik perempuan pelaku serangan\Njuga menghilang.
Dialogue: 0,0:16:46.84,0:16:49.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami sudah mencari di daerah kumuh,\Ntapi belum ada petunjuk.
Dialogue: 0,0:16:49.45,0:16:50.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku paham.
Dialogue: 0,0:16:51.27,0:16:54.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pria itu juga masih punya\Nkeringanan hukuman.
Dialogue: 0,0:17:01.48,0:17:04.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Laporan Investigasi Victoria Sellers".
Dialogue: 0,0:17:04.82,0:17:08.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Laporan Investigasi Wanita\Ndi Insiden Jamuan Malam".
Dialogue: 0,0:17:08.47,0:17:11.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, insiden pelarian kali ini.
Dialogue: 0,0:17:11.88,0:17:14.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya terkait\Ndengan seorang wanita muda.
Dialogue: 0,0:17:14.52,0:17:18.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, semuanya terjadi\Nsetelah dia masuk ke negara ini.
Dialogue: 0,0:17:18.57,0:17:22.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari laporan Jeffrey, kedua orang tuanya\Nmeninggal dalam kebakaran.
Dialogue: 0,0:17:22.68,0:17:24.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, menurut laporan investigasi,
Dialogue: 0,0:17:24.38,0:17:27.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}saat ini orang tua Victoria Sellers\N"tidak diketahui hidup atau mati".
Dialogue: 0,0:17:27.97,0:17:31.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, menurut laporan Miles,
Dialogue: 0,0:17:31.40,0:17:35.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia berkata kakak laki-lakinya yang seorang\Ntentara mengajarinya menunggang kuda.
Dialogue: 0,0:17:35.79,0:17:38.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi Victoria asli tak punya kakak laki-laki.
Dialogue: 0,0:17:40.61,0:17:42.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu ceroboh, Victoria.
Dialogue: 0,0:17:43.15,0:17:47.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alasan merekomendasikannya ke Count Anderson\Nuntuk menjadi guru privat Clark
Dialogue: 0,0:17:47.67,0:17:51.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah untuk mengendalikan keberadaannya.
Dialogue: 0,0:17:53.05,0:17:55.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia melarikan diri dari suatu tempat.
Dialogue: 0,0:17:55.56,0:17:57.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tahu alasannya, aku ingin membantunya.
Dialogue: 0,0:17:57.85,0:17:59.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya saja, alasan itu
Dialogue: 0,0:17:59.56,0:18:02.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin membuatku harus mengembalikannya\Nke negara asalnya.
Dialogue: 0,0:18:02.73,0:18:07.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi dia penyelamat yang membuat\NJeffrey keluar dari penjara batinnya.
Dialogue: 0,0:18:07.98,0:18:10.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dia orangnya,\Nkegelapan yang lebih dalam di hati adikku
Dialogue: 0,0:18:10.94,0:18:14.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin juga bisa diterangi oleh cahayanya.
Dialogue: 0,0:18:14.39,0:18:17.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bisa, aku juga ingin merestui mereka.
Dialogue: 0,0:18:17.74,0:18:19.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya saja,
Dialogue: 0,0:18:19.60,0:18:23.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jeffrey juga tidak tahu bahwa aku adalah\Nanggota Pasukan Kesatria Ketiga.
Dialogue: 0,0:18:24.19,0:18:28.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi Jeff pasti sudah sadar\Nbahwa dia bukan rakyat biasa.
Dialogue: 0,0:18:29.76,0:18:32.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga dia tidak bertindak gegabah\Nkarena terburu-buru.
Dialogue: 0,0:18:34.12,0:18:37.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Miles, aku ingin pinjam Aleg.
Dialogue: 0,0:18:39.33,0:18:41.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini Nonna tidak ada?
Dialogue: 0,0:18:41.79,0:18:42.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:18:44.00,0:18:46.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia terkena flu dan sedang istirahat.
Dialogue: 0,0:18:46.51,0:18:48.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu?\NJaga kesehatan, ya.
Dialogue: 0,0:18:49.09,0:18:49.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:18:50.72,0:18:52.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:18:57.16,0:18:58.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aneh.
Dialogue: 0,0:19:01.27,0:19:03.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa terjadi sesuatu?
Dialogue: 0,0:19:06.17,0:19:08.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf mengganggu saat sedang ada tamu.
Dialogue: 0,0:19:08.79,0:19:12.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Miles yang tinggal di belakang.
Dialogue: 0,0:19:14.41,0:19:16.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namaku Yolana Haynes.
Dialogue: 0,0:19:16.74,0:19:17.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:19:18.41,0:19:19.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, pagi ini
Dialogue: 0,0:19:19.51,0:19:23.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}setelah Victoria pergi dengan\Nmenunggang kuda yang dititipkan padaku,
Dialogue: 0,0:19:23.83,0:19:25.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia belum kembali sampai sekarang.
Dialogue: 0,0:19:25.29,0:19:27.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi aku sedikit khawatir.
Dialogue: 0,0:19:27.96,0:19:29.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:19:30.11,0:19:33.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Victoria sudah tidak ada di sini.
Dialogue: 0,0:19:33.59,0:19:35.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sepertinya pergi saat fajar.
Dialogue: 0,0:19:36.31,0:19:38.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia juga meninggalkan surat untukmu.
Dialogue: 0,0:19:42.06,0:19:45.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah merawat Aleg selama ini.
Dialogue: 0,0:19:45.71,0:19:48.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memetik kastanya sangat seru.
Dialogue: 0,0:19:50.46,0:19:53.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah tahu Victoria baik-baik saja,
Dialogue: 0,0:19:53.38,0:19:54.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku bisa tenang.
Dialogue: 0,0:19:54.92,0:19:57.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku permisi dulu.
Dialogue: 0,0:20:02.01,0:20:03.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan mengantarkan surat.
Dialogue: 0,0:20:05.39,0:20:08.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten, apa aku boleh tanya sesuatu?
Dialogue: 0,0:20:09.21,0:20:09.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan.
Dialogue: 0,0:20:09.98,0:20:12.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Victoria tidak bilang apa pun padamu?
Dialogue: 0,0:20:20.77,0:20:21.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:20:22.14,0:20:24.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayangnya, dia tidak cerita apa pun padaku.
Dialogue: 0,0:20:34.86,0:20:35.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar.
Dialogue: 0,0:20:35.96,0:20:39.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan menangis terus.
Dialogue: 0,0:20:39.13,0:20:41.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, Nyonya.
Dialogue: 0,0:20:41.95,0:20:43.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga
Dialogue: 0,0:20:43.83,0:20:44.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu baik-baik saja.
Dialogue: 0,0:20:45.62,0:20:47.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, suatu hari,
Dialogue: 0,0:20:48.38,0:20:49.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kembalilah ke sini.
Dialogue: 0,0:20:50.71,0:20:53.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya ini?
Dialogue: 0,0:20:54.47,0:20:55.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia menghilang?
Dialogue: 0,0:20:55.73,0:20:57.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Apa yang terjadi?\N- Clark.
Dialogue: 0,0:20:57.32,0:20:58.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paman Jeff!
Dialogue: 0,0:20:59.28,0:21:01.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan, Clark.
Dialogue: 0,0:21:01.39,0:21:02.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga tidak tahu kenapa.
Dialogue: 0,0:21:04.52,0:21:06.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk Tuan Jeffrey Asher,
Dialogue: 0,0:21:06.66,0:21:09.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}maaf karena aku tiba-tiba pergi\Ntanpa pamit.
Dialogue: 0,0:21:09.49,0:21:13.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena suatu alasan,\Naku tidak bisa terus tinggal di sini.
Dialogue: 0,0:21:14.71,0:21:16.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih karena selalu menyemangatiku,
Dialogue: 0,0:21:16.92,0:21:18.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}selalu bersikap lembut padaku.
Dialogue: 0,0:21:19.01,0:21:21.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selalu tertawa bersamaku,\Nbenar-benar terima kasih banyak.
Dialogue: 0,0:21:22.18,0:21:25.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini pertama kalinya aku menjalani\Nkehidupan yang begitu bahagia.
Dialogue: 0,0:21:26.35,0:21:28.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku seharusnya pergi lebih awal,
Dialogue: 0,0:21:28.88,0:21:30.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi karena terlalu gembira dan bahagia,
Dialogue: 0,0:21:31.23,0:21:33.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku malah menunda-nunda\Ndan tidak ingin pergi.
Dialogue: 0,0:21:34.55,0:21:36.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama kali pergi piknik bersama,
Dialogue: 0,0:21:36.94,0:21:39.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mengobrol sambil makan kastanya panggang,
Dialogue: 0,0:21:39.55,0:21:41.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}semuanya membuatku bahagia.
Dialogue: 0,0:21:41.68,0:21:43.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa memiliki kenangan indah ini
Dialogue: 0,0:21:43.76,0:21:45.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}semuanya berkat Kapten.
Dialogue: 0,0:21:46.45,0:21:48.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak untuk selama ini.
Dialogue: 0,0:21:49.54,0:21:50.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu,
Dialogue: 0,0:21:51.36,0:21:52.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}maafkan aku.
Dialogue: 0,0:21:55.36,0:21:57.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya piknik dan kastanya panggang,
Dialogue: 0,0:21:57.60,0:21:59.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak perlu berterima kasih.
Dialogue: 0,0:21:59.95,0:22:01.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku...
Dialogue: 0,0:22:01.74,0:22:03.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku sudah memohon
Dialogue: 0,0:22:03.62,0:22:05.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk jangan tiba-tiba
Dialogue: 0,0:22:05.84,0:22:07.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pergi menghilang!
