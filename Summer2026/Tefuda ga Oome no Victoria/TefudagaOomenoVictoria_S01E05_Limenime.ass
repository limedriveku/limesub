Dialogue: 0,0:01:26.32,0:01:30.99,sign,,0000,0000,0000,,VICTORIA OF MANY FACES
Dialogue: 0,0:02:45.02,0:02:45.59,sign,,0000,0000,0000,,EPISODE 5:
Dialogue: 0,0:02:45.59,0:02:49.56,sign,,0000,0000,0000,,SUATU HARI AKU AKAN MENERIMA BALASANNYA
Dialogue: 0,0:21:48.04,0:21:50.04,sign,,0000,0000,0000,,KERAJAAN HAGL
Dialogue: 0,0:00:04.68,0:00:05.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Vicky.
Dialogue: 0,0:00:09.85,0:00:12.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin minta tolong padamu, Nonna.
Dialogue: 0,0:00:12.68,0:00:13.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa?
Dialogue: 0,0:00:15.90,0:00:18.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada hal yang harus kulakukan.
Dialogue: 0,0:00:19.36,0:00:23.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin selama beberapa waktu ini,\Naku akan keluar setiap sore.
Dialogue: 0,0:00:26.84,0:00:28.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi...
Dialogue: 0,0:00:31.12,0:00:33.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Vicky, jelaskan.
Dialogue: 0,0:00:34.37,0:00:38.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya kamu harus jaga rumah.
Dialogue: 0,0:00:40.17,0:00:41.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan berusaha pulang lebih awal.
Dialogue: 0,0:00:42.73,0:00:44.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Percayalah padaku.
Dialogue: 0,0:00:44.51,0:00:45.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kalau tidak mau,
Dialogue: 0,0:00:46.19,0:00:49.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan minta bantuan Nona Susan\Nagar kamu bisa ke tempatnya.
Dialogue: 0,0:00:49.21,0:00:50.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana?
Dialogue: 0,0:00:52.31,0:00:53.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menunggumu di rumah.
Dialogue: 0,0:00:57.70,0:00:59.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Nonna.
Dialogue: 0,0:01:00.00,0:01:02.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku ingin makan bersamamu, Vicky.
Dialogue: 0,0:01:02.56,0:01:03.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:01:03.96,0:01:06.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga ingin\Nmakan malam bersamamu, Nonna.
Dialogue: 0,0:01:08.34,0:01:09.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Janji.
Dialogue: 0,0:02:45.59,0:02:48.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona, apa Anda bisa merawat kuda?
Dialogue: 0,0:02:48.49,0:02:49.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja.
Dialogue: 0,0:02:49.56,0:02:52.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kusarankan beri dia\Nwaktu yang cukup untuk istirahat.
Dialogue: 0,0:02:52.20,0:02:54.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan merawatnya dengan baik.
Dialogue: 0,0:02:54.15,0:02:56.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku perlu kuda ini\Nhanya untuk mengunjungi ibuku.
Dialogue: 0,0:02:56.99,0:02:58.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja.
Dialogue: 0,0:03:14.17,0:03:15.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu Hector?
Dialogue: 0,0:03:16.28,0:03:18.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu siapa?
Dialogue: 0,0:03:18.47,0:03:20.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namaku Kate.
Dialogue: 0,0:03:20.19,0:03:23.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar kamu menerima\Npekerjaan apa pun selama dibayar.
Dialogue: 0,0:03:24.00,0:03:25.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tergantung urusan apa dan berapa uangnya.
Dialogue: 0,0:03:26.38,0:03:28.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekasihku sudah menikah.
Dialogue: 0,0:03:28.34,0:03:30.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Niatku sebenarnya ingin kawin lari,
Dialogue: 0,0:03:30.06,0:03:33.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi istrinya setiap hari menunggu\Ndi luar tempat kerjanya.
Dialogue: 0,0:03:33.81,0:03:37.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya aku mau dia diam-diam\Nkabur di tengah jam kerja.
Dialogue: 0,0:03:39.14,0:03:42.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah lebih baik pura-pura sakit\Ndan pulang lebih awal?
Dialogue: 0,0:03:42.75,0:03:47.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami bertiga bekerja di tempat yang sama.
Dialogue: 0,0:03:47.94,0:03:48.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di mana?
Dialogue: 0,0:03:49.44,0:03:50.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kastel.
Dialogue: 0,0:03:50.31,0:03:51.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kastel, ya?
Dialogue: 0,0:03:51.52,0:03:53.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bayarannya akan lebih mahal.
Dialogue: 0,0:03:53.28,0:03:56.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin kamu membantu kami lari\Nsampai ke gerbang luar ibu kota.
Dialogue: 0,0:03:56.29,0:03:58.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini cukup?
Dialogue: 0,0:04:01.87,0:04:04.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, lusa datang ke sini lagi.
Dialogue: 0,0:04:04.85,0:04:07.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rincian alurnya akan kuberi tahu\Npada saat itu.
Dialogue: 0,0:04:07.69,0:04:08.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:04:09.30,0:04:10.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong,
Dialogue: 0,0:04:10.77,0:04:12.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dari mana kamu tahu tentangku?
Dialogue: 0,0:04:14.01,0:04:16.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari teman yang baru kukenal.
Dialogue: 0,0:04:20.62,0:04:23.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya, ini misi utama hari ini.
Dialogue: 0,0:04:31.04,0:04:32.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:04:32.50,0:04:35.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kekasih pria yang ditangkap\Ndi jamuan malam itu.
Dialogue: 0,0:04:35.30,0:04:37.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku boleh menemuinya?
Dialogue: 0,0:04:37.34,0:04:38.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namanya Carl?
Dialogue: 0,0:04:38.17,0:04:39.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar!
Dialogue: 0,0:04:40.80,0:04:43.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, kami harus melakukan\Npemeriksaan tubuh.
Dialogue: 0,0:04:44.47,0:04:46.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, maaf merepotkan kalian.
Dialogue: 0,0:04:50.02,0:04:52.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, angkat rokmu.
Dialogue: 0,0:04:52.27,0:04:55.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ada wanita yang ingin\Nbertemu terpidana mati,
Dialogue: 0,0:04:55.65,0:04:57.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan diperlakukan seperti ini, ya?
Dialogue: 0,0:05:01.26,0:05:02.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei!
Dialogue: 0,0:05:02.40,0:05:03.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekasihmu datang menemuimu.
Dialogue: 0,0:05:05.01,0:05:05.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Carl!
Dialogue: 0,0:05:06.52,0:05:08.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa bisa terjadi hal seperti ini?
Dialogue: 0,0:05:09.06,0:05:12.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar dia akan segera dihukum mati.
Dialogue: 0,0:05:12.21,0:05:13.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Sipir,
Dialogue: 0,0:05:13.04,0:05:16.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa biarkan kami berdua sebentar?
Dialogue: 0,0:05:16.30,0:05:18.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, itu...
Dialogue: 0,0:05:18.80,0:05:21.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga tidak bisa\Nmengeluarkannya dari sini, kan?
Dialogue: 0,0:05:22.37,0:05:24.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya biarkan aku berbicara dengannya!
Dialogue: 0,0:05:24.43,0:05:26.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asalkan kami bisa bicara berdua.
Dialogue: 0,0:05:29.46,0:05:30.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:05:30.89,0:05:32.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya bisa kuberikan satu jam.
Dialogue: 0,0:05:32.67,0:05:34.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu selesai, aku akan menjemputmu.
Dialogue: 0,0:05:34.56,0:05:36.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak!
Dialogue: 0,0:05:39.49,0:05:42.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu... siapa?
Dialogue: 0,0:05:42.36,0:05:45.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mau keluar, sebaiknya diam.
Dialogue: 0,0:05:56.01,0:05:58.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa yang kamu lakukan?
Dialogue: 0,0:05:58.44,0:05:59.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diam.
Dialogue: 0,0:06:11.96,0:06:13.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus.
Dialogue: 0,0:06:13.19,0:06:15.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah mengingat rute patroli penjara.
Dialogue: 0,0:06:15.51,0:06:17.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini cukup sampai di sini.
Dialogue: 0,0:06:17.01,0:06:18.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei!
Dialogue: 0,0:06:19.97,0:06:21.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya datang untuk memastikan.
Dialogue: 0,0:06:22.01,0:06:24.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini belum ada cara\Nagar kamu bisa kabur.
Dialogue: 0,0:06:24.59,0:06:26.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keluar pun kamu akan dibunuh prajurit.
Dialogue: 0,0:06:26.87,0:06:28.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan datang lagi besok.
Dialogue: 0,0:06:28.93,0:06:30.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong tetap pura-pura sebagai kekasihku.
Dialogue: 0,0:06:32.77,0:06:34.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih atas bantuannya.
Dialogue: 0,0:06:34.58,0:06:36.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan datang lagi besok.
Dialogue: 0,0:06:37.11,0:06:38.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pulang.
Dialogue: 0,0:06:38.75,0:06:40.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah pulang, Vicky.
Dialogue: 0,0:06:40.60,0:06:42.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah menjaga rumah.
Dialogue: 0,0:06:42.26,0:06:44.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sendirian juga bukan masalah.
Dialogue: 0,0:06:45.91,0:06:48.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Vicky, kamu berkeringat?
Dialogue: 0,0:06:50.04,0:06:52.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena ingin cepat bertemu Nonna,\Naku pulang sambil lari.
Dialogue: 0,0:06:53.64,0:06:56.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Vicky, tidak perlu lari,\Naku akan menunggumu.
Dialogue: 0,0:06:57.15,0:06:59.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu memang anak yang baik.
Dialogue: 0,0:07:00.15,0:07:01.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Juga anak yang kuat.
Dialogue: 0,0:07:02.93,0:07:04.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau berakting?
Dialogue: 0,0:07:04.28,0:07:05.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:07:05.75,0:07:09.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini, kita belajar bahasa asing\Nsambil mendalami peran.
Dialogue: 0,0:07:09.85,0:07:12.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akan memerankan "Tuan Putri\NBerambut Putih dan Kadal Biru".
Dialogue: 0,0:07:12.79,0:07:14.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu kisah itu.
Dialogue: 0,0:07:14.47,0:07:16.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pernah membacanya\Ndi rumah Tuan Bernard.
Dialogue: 0,0:07:17.36,0:07:19.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Clark juga pernah membacanya?
Dialogue: 0,0:07:19.46,0:07:20.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:07:20.42,0:07:23.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cerita tentang pria\Nyang dikutuk menjadi kadal
Dialogue: 0,0:07:23.46,0:07:27.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bekerja sama dengan Tuan Putri\Ndan mengalahkan penyihir, kan?
Dialogue: 0,0:07:27.80,0:07:29.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:07:29.05,0:07:32.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terakhir, kadal itu kembali menjadi manusia
Dialogue: 0,0:07:32.26,0:07:34.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan menikah dengan Tuan Putri.
Dialogue: 0,0:07:34.18,0:07:35.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini cerita dongeng yang terkenal.
Dialogue: 0,0:07:36.42,0:07:38.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang ingin memerankan kadal?
Dialogue: 0,0:07:38.71,0:07:39.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku.
Dialogue: 0,0:07:39.65,0:07:41.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Clark memerankan kadal.
Dialogue: 0,0:07:41.65,0:07:44.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, yang ingin memerankan Tuan Putri?
Dialogue: 0,0:07:47.85,0:07:49.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nonna tidak mau?
Dialogue: 0,0:07:49.57,0:07:50.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku maunya penyihir.
Dialogue: 0,0:07:50.89,0:07:52.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Vicky yang memerankan Tuan Putri.
Dialogue: 0,0:07:52.76,0:07:55.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyihir pada akhirnya akan dikalahkan.
Dialogue: 0,0:07:55.33,0:07:56.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak boleh menangis.
Dialogue: 0,0:07:56.58,0:07:57.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan menangis.
Dialogue: 0,0:07:58.42,0:08:00.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa boleh buat.
Dialogue: 0,0:08:00.04,0:08:02.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,\Naku yang memerankan Tuan Putri.
Dialogue: 0,0:08:02.61,0:08:04.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan membaca dialog\Ndalam bahasa Ashbury,
Dialogue: 0,0:08:04.96,0:08:06.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kalian dalam bahasa Randall, ya.
Dialogue: 0,0:08:06.92,0:08:08.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:08:10.33,0:08:12.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini dia datang lagi.
Dialogue: 0,0:08:12.04,0:08:13.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekasih yang sangat kamu cintai.
Dialogue: 0,0:08:14.46,0:08:16.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu selesai,\Naku akan memanggilmu lagi.
Dialogue: 0,0:08:16.68,0:08:17.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:08:25.01,0:08:27.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga butuh bantuanmu.
Dialogue: 0,0:08:27.21,0:08:29.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gergaji kawat di tumit sepatu?
Dialogue: 0,0:08:29.88,0:08:32.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari jadwal kunjungan dan patroli,
Dialogue: 0,0:08:32.74,0:08:34.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hanya ada satu yang bisa\Ndipotong per hari.
Dialogue: 0,0:08:34.79,0:08:36.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Total ada lima jeruji besi.
Dialogue: 0,0:08:36.90,0:08:40.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Butuh sepuluh hari kalau memotongnya\Nsatu dari atas dan satu dari bawah.
Dialogue: 0,0:08:40.98,0:08:42.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kabar adik perempuanmu?
Dialogue: 0,0:08:42.79,0:08:44.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia ada di rumah.
Dialogue: 0,0:08:44.40,0:08:47.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena sakit mental,\Ndia tidak bisa keluar rumah.
Dialogue: 0,0:08:47.49,0:08:51.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku khawatir apakah dia bisa makan\Ndengan baik sendirian.
Dialogue: 0,0:08:51.09,0:08:54.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu yang tak pernah\Nbertemu denganku
Dialogue: 0,0:08:54.39,0:08:55.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ingin membantuku keluar?
Dialogue: 0,0:08:55.85,0:08:58.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku melakukan ini demi diriku sendiri.
Dialogue: 0,0:08:58.51,0:08:59.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak perlu dipikirkan.
Dialogue: 0,0:09:09.24,0:09:10.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi.
Dialogue: 0,0:09:11.06,0:09:12.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo.
Dialogue: 0,0:09:14.27,0:09:15.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:09:16.06,0:09:18.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan membayar upah\Ndan biaya perawatan yang diperlukan.
Dialogue: 0,0:09:18.80,0:09:22.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisakah aku menitipkan kuda\Ndan kereta kuda di sini?
Dialogue: 0,0:09:22.96,0:09:24.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja bisa, tapi kenapa?
Dialogue: 0,0:09:24.75,0:09:29.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, ayahku tidak menyetujui\Npernikahan adik laki-lakiku.
Dialogue: 0,0:09:29.80,0:09:33.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Adikku bilang dia akan meninggalkan ibu kota\Ndengan berjalan kaki bersama tunangannya.
Dialogue: 0,0:09:33.57,0:09:35.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah mendengar tentang ini,
Dialogue: 0,0:09:35.35,0:09:39.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku ingin setidaknya memberikan kereta kuda\Nsebagai hadiah pernikahan mereka.
Dialogue: 0,0:09:39.03,0:09:42.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah yang keras kepala\Npasti membuat kalian kesulitan.
Dialogue: 0,0:09:42.16,0:09:44.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, serahkan padaku.
Dialogue: 0,0:09:44.61,0:09:46.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih atas bantuannya.
Dialogue: 0,0:09:46.19,0:09:47.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama-sama.
Dialogue: 0,0:09:51.76,0:09:52.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa?
Dialogue: 0,0:09:52.95,0:09:53.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bicara dulu.
Dialogue: 0,0:09:53.99,0:09:56.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menyampaikan pesan dari kakakmu.
Dialogue: 0,0:10:02.61,0:10:03.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengarkan baik-baik.
Dialogue: 0,0:10:03.71,0:10:05.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hal yang kukatakan sekarang
Dialogue: 0,0:10:05.50,0:10:07.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jangan ditulis atau diceritakan\Npada orang lain.
Dialogue: 0,0:10:07.88,0:10:09.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja.
Dialogue: 0,0:10:09.83,0:10:14.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Kate, apa kamu dikirim\Noleh Maria dan yang lainnya?
Dialogue: 0,0:10:14.77,0:10:15.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maria?
Dialogue: 0,0:10:16.50,0:10:19.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maria, Luna, Eliza.
Dialogue: 0,0:10:19.04,0:10:20.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka adalah orang-orang
Dialogue: 0,0:10:20.45,0:10:23.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang juga dipermalukan\Noleh Markis McKenna sebelum aku.
Dialogue: 0,0:10:24.09,0:10:26.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak ada hubungannya dengan mereka.
Dialogue: 0,0:10:26.04,0:10:27.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daripada bahas itu,
Dialogue: 0,0:10:27.47,0:10:29.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa kamu sudah makan?
Dialogue: 0,0:10:29.21,0:10:30.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Punya uang?
Dialogue: 0,0:10:31.49,0:10:32.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada.
Dialogue: 0,0:10:35.24,0:10:37.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini, meski tidak banyak,
Dialogue: 0,0:10:37.24,0:10:39.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tolong gunakan semuanya\Nuntuk membeli makanan.
Dialogue: 0,0:10:40.31,0:10:41.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk hari-hari selanjutnya,
Dialogue: 0,0:10:41.70,0:10:44.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau kamu tidak punya tenaga,\Nkamu tidak akan bisa bertahan.
Dialogue: 0,0:10:44.58,0:10:46.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makan yang baik, tidur,\Ndan gerakkan badanmu.
Dialogue: 0,0:10:46.79,0:10:48.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengerti?
Dialogue: 0,0:10:48.13,0:10:50.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baik.
Dialogue: 0,0:10:51.80,0:10:55.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Haha, dasar bocah!
Dialogue: 0,0:10:55.05,0:10:58.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Putri, tolong mundur dulu.
Dialogue: 0,0:10:58.05,0:11:00.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sebenarnya ingin melihat Nonna\Nmemerankan Tuan Putri,
Dialogue: 0,0:11:00.91,0:11:03.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi memerankan penyihir juga imut.
Dialogue: 0,0:11:03.06,0:11:04.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sialan.
Dialogue: 0,0:11:06.48,0:11:09.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kembali menjadi manusia.
Dialogue: 0,0:11:09.48,0:11:13.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Putri, maukah kamu menikah denganku?
Dialogue: 0,0:11:14.47,0:11:16.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Clark.
Dialogue: 0,0:11:16.03,0:11:20.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk pengucapan barusan,\Ncoba lebih tegas lagi.
Dialogue: 0,0:11:20.66,0:11:23.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maukah kamu menikah denganku?
Dialogue: 0,0:11:23.10,0:11:24.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedikit lebih bersuara lagi.
Dialogue: 0,0:11:24.46,0:11:26.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maukah kamu menikah denganku?
Dialogue: 0,0:11:26.76,0:11:28.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus!
Dialogue: 0,0:11:28.33,0:11:29.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita coba sekali lagi.
Dialogue: 0,0:11:30.25,0:11:33.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maukah kamu menikah denganku?
Dialogue: 0,0:11:34.37,0:11:35.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:11:35.99,0:11:37.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku malah membuatmu mengulang
Dialogue: 0,0:11:37.80,0:11:40.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dialog seperti ini pada orang\Nyang jauh lebih tua darimu.
Dialogue: 0,0:11:40.51,0:11:42.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak!
Dialogue: 0,0:11:42.01,0:11:43.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guru Victoria,
Dialogue: 0,0:11:43.52,0:11:45.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu orang yang hebat!
Dialogue: 0,0:11:45.02,0:11:46.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak boleh!
Dialogue: 0,0:11:46.06,0:11:48.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Vicky milik Nonna.
Dialogue: 0,0:11:48.31,0:11:50.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu, Nonna.
Dialogue: 0,0:11:52.26,0:11:55.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin mampir karena terlihat seru!
Dialogue: 0,0:11:55.34,0:11:56.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu.
Dialogue: 0,0:11:56.45,0:11:57.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya Eva.
Dialogue: 0,0:11:57.78,0:11:59.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kami terlalu berisik?
Dialogue: 0,0:11:59.66,0:12:01.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:12:01.03,0:12:03.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin lihat kalian sedang belajar apa.
Dialogue: 0,0:12:03.29,0:12:03.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, kan?
Dialogue: 0,0:12:03.95,0:12:06.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan ganggu kami, Kadal Arogan!
Dialogue: 0,0:12:06.96,0:12:11.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, masih kecil sudah pandai berakting, ya.
Dialogue: 0,0:12:13.05,0:12:16.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang akan melindungi Tuan Putri!
Dialogue: 0,0:12:16.05,0:12:18.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan membiarkanmu menyakitinya!
Dialogue: 0,0:12:18.59,0:12:20.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian berdua, hebat!
Dialogue: 0,0:12:20.34,0:12:22.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin suamiku juga melihatnya.
Dialogue: 0,0:12:22.93,0:12:24.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cedera kaki Paman juga sudah mulai pulih.
Dialogue: 0,0:12:24.89,0:12:28.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau kita mengadakan\Npertunjukan drama?
Dialogue: 0,0:12:31.04,0:12:32.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagian yang sudah dipotong
Dialogue: 0,0:12:32.61,0:12:36.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ditutupi dengan kulit kecil\Nagar tetap terlihat utuh.
Dialogue: 0,0:12:36.07,0:12:39.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan begitu, sekilas tidak akan\Nketahuan kalau sudah dipotong
Dialogue: 0,0:12:49.54,0:12:51.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini yang terakhir, ya?
Dialogue: 0,0:12:51.33,0:12:53.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Kate,
Dialogue: 0,0:12:53.00,0:12:55.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa adikku baik-baik saja?
Dialogue: 0,0:12:55.95,0:12:57.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia baik-baik saja.
Dialogue: 0,0:12:57.25,0:12:59.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bisa bertemu dengannya besok.
Dialogue: 0,0:12:59.70,0:13:00.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Vicky.
Dialogue: 0,0:13:02.26,0:13:04.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Vicky, ada Jeff!
Dialogue: 0,0:13:04.60,0:13:06.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf datang mendadak.
Dialogue: 0,0:13:06.31,0:13:09.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten, ada perlu apa?
Dialogue: 0,0:13:09.92,0:13:12.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau makan bersama malam ini?
Dialogue: 0,0:13:12.56,0:13:15.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jamuan malam waktu itu,\Naku belum ganti rugi, kan?
Dialogue: 0,0:13:15.69,0:13:17.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Restoran ini megah, ya.
Dialogue: 0,0:13:17.80,0:13:20.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti sulit untuk memesan tempat, kan?
Dialogue: 0,0:13:20.93,0:13:22.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bawahanku yang memberitahuku.
Dialogue: 0,0:13:22.74,0:13:25.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya ini restoran yang cocok\Nuntuk mengajak wanita.
Dialogue: 0,0:13:25.28,0:13:27.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, terima kasih banyak.
Dialogue: 0,0:13:34.69,0:13:38.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten, semua makanannya enak.
Dialogue: 0,0:13:39.61,0:13:40.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak, ya!
Dialogue: 0,0:13:41.87,0:13:43.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah mengobrol\Ndengan Pangeran Cedric.
Dialogue: 0,0:13:43.89,0:13:47.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bersikeras bahwa\Ntulang rusuknya patah karena jatuh.
Dialogue: 0,0:13:47.40,0:13:49.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak perlu khawatir.
Dialogue: 0,0:13:51.21,0:13:54.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pangeran itu sebenarnya orang seperti apa?
Dialogue: 0,0:13:54.10,0:13:56.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau itu,
Dialogue: 0,0:13:56.15,0:13:59.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin karena putra kedua,\Ndia tumbuh sangat bebas.
Dialogue: 0,0:14:00.22,0:14:02.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kepribadiannya agak sembrono\Ndan mengkhawatirkan,
Dialogue: 0,0:14:02.80,0:14:04.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi bawahannya tetap mengaguminya.
Dialogue: 0,0:14:05.16,0:14:06.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:14:06.76,0:14:08.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu bertanya tentang dia?
Dialogue: 0,0:14:08.76,0:14:10.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dia tiba-tiba berubah pikiran
Dialogue: 0,0:14:10.27,0:14:13.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan mengungkapkan bahwa aku\Nyang mengalahkannya, itu akan gawat.
Dialogue: 0,0:14:13.73,0:14:15.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tidak mungkin.
Dialogue: 0,0:14:16.32,0:14:19.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski cara bertindaknya yang unik\Nsering merepotkan sekitarnya,
Dialogue: 0,0:14:19.32,0:14:21.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia bukanlah orang yang licik.
Dialogue: 0,0:14:21.47,0:14:23.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu.
Dialogue: 0,0:14:23.66,0:14:25.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa tenang.
Dialogue: 0,0:14:26.85,0:14:28.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebentar lagi pertunjukan drama, ya?
Dialogue: 0,0:14:28.96,0:14:30.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:14:30.01,0:14:32.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa Kapten juga akan datang menonton?
Dialogue: 0,0:14:32.18,0:14:36.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, Eva bahkan cerita padaku,\Nbahkan sampai pesan kostum.
Dialogue: 0,0:14:37.30,0:14:39.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be-Begitu.
Dialogue: 0,0:14:43.60,0:14:45.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mengantuk, Nonna?
Dialogue: 0,0:14:46.47,0:14:47.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedikit.
Dialogue: 0,0:14:47.68,0:14:49.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, ayo pulang.
Dialogue: 0,0:14:49.27,0:14:50.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:14:52.90,0:14:54.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak!
Dialogue: 0,0:14:54.67,0:14:56.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, kan?\NEnak, ya?
Dialogue: 0,0:14:56.67,0:14:58.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Carol?
Dialogue: 0,0:14:59.95,0:15:01.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak untuk hari ini.
Dialogue: 0,0:15:02.95,0:15:04.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten?
Dialogue: 0,0:15:05.16,0:15:07.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang ingin kukatakan padamu.
Dialogue: 0,0:15:08.33,0:15:09.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat kamu sungkan pergi ke jamuan,
Dialogue: 0,0:15:09.89,0:15:11.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi karena aku mengundangmu,
Dialogue: 0,0:15:11.97,0:15:14.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku malah membuatmu mengalami\Nhal yang tidak menyenangkan.
Dialogue: 0,0:15:14.91,0:15:16.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benar-benar merasa bersalah.
Dialogue: 0,0:15:17.30,0:15:19.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku setidaknya ingin\Nmeminta maaf padamu.
Dialogue: 0,0:15:21.01,0:15:22.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten,
Dialogue: 0,0:15:22.07,0:15:25.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang akhirnya memutuskan\Nmenghadiri jamuan itu aku.
Dialogue: 0,0:15:25.28,0:15:28.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga yang menyadari\Npria itu mencurigakan.
Dialogue: 0,0:15:28.39,0:15:30.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hasil dari keputusan yang kubuat sendiri
Dialogue: 0,0:15:30.74,0:15:32.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan kutanggung sendiri.
Dialogue: 0,0:15:32.90,0:15:36.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, Kapten tidak perlu\Nmencemaskan apa pun.
Dialogue: 0,0:15:37.86,0:15:39.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:15:39.81,0:15:42.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu benar-benar orang yang kuat, ya.
Dialogue: 0,0:15:42.95,0:15:44.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sering dibilang begitu.
Dialogue: 0,0:15:49.75,0:15:53.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Momen bersamamu membuatku merasa lega.
Dialogue: 0,0:16:04.26,0:16:06.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya ucapkan selamat tidur.
Dialogue: 0,0:16:07.35,0:16:11.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sekarang paham\Nkenapa dulu organisasi menyuruh kami
Dialogue: 0,0:16:11.01,0:16:12.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}membuang nama asli.
Dialogue: 0,0:16:13.29,0:16:16.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk mencegah situasi\Nyang kualami belakangan ini, kan?
Dialogue: 0,0:16:17.66,0:16:20.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hubungan antarmanusia\Nyang terjalin di tempat penyusupan
Dialogue: 0,0:16:20.79,0:16:23.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan ditinggalkan bersama dengan nama.
Dialogue: 0,0:16:24.20,0:16:27.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kalau harus\Nmemutuskan hubungan ini sekarang,
Dialogue: 0,0:16:27.45,0:16:29.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}itu terlalu menyakitkan.
Dialogue: 0,0:16:29.84,0:16:32.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bertemu dengan memakai nama asli,
Dialogue: 0,0:16:32.01,0:16:34.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pasti akan lebih menyakitkan lagi.
Dialogue: 0,0:16:35.71,0:16:38.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah bukan anggota organisasi lagi.
Dialogue: 0,0:16:38.79,0:16:43.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah tak punya hubungan dengan rekan\Natau anggota cadangan yang masih di sana.
Dialogue: 0,0:16:44.30,0:16:48.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, saat aku mulai merasakan\N"kebahagiaan yang wajar",
Dialogue: 0,0:16:48.77,0:16:51.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku merasa bersalah pada mereka\Nyang masih di organisasi.
Dialogue: 0,0:16:51.53,0:16:52.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa, ya?
Dialogue: 0,0:17:03.63,0:17:05.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bohong!
Dialogue: 0,0:17:05.13,0:17:06.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Yang tadi itu...\N- Benar juga.
Dialogue: 0,0:17:14.76,0:17:17.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Carl...
Dialogue: 0,0:17:17.46,0:17:18.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:17:18.84,0:17:20.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan kamu mau mengintip?
Dialogue: 0,0:17:20.42,0:17:21.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hobimu jelek, ya?
Dialogue: 0,0:17:21.75,0:17:24.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan konyol,\Naku tidak punya waktu untuk itu.
Dialogue: 0,0:17:24.83,0:17:28.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oi, aku hanya bercanda, jangan marah!
Dialogue: 0,0:17:30.10,0:17:31.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, kita pergi.
Dialogue: 0,0:17:43.25,0:17:45.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ganti dengan pakaian itu.
Dialogue: 0,0:17:50.88,0:17:53.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini kereta kuda yang disiapkan Hector.
Dialogue: 0,0:18:03.32,0:18:04.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:18:05.34,0:18:06.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita sudah sampai.
Dialogue: 0,0:18:07.26,0:18:09.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ingin kawin lari, nyali kalian sangat besar.
Dialogue: 0,0:18:09.59,0:18:10.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian harus bahagia, ya!
Dialogue: 0,0:18:11.51,0:18:12.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih atas bantuannya.
Dialogue: 0,0:18:17.27,0:18:19.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pergi bicaralah dengan petani di sana.
Dialogue: 0,0:18:20.02,0:18:22.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan lupa berperan\Nsebagai tunangan adik perempuanmu.
Dialogue: 0,0:18:22.97,0:18:25.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pasti sudah menunggumu di sana.
Dialogue: 0,0:18:25.82,0:18:27.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kebaikanmu ini!
Dialogue: 0,0:18:27.48,0:18:29.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak akan kulupakan seumur hidupku!
Dialogue: 0,0:18:30.03,0:18:32.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu, lupakan saja.
Dialogue: 0,0:18:32.69,0:18:35.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini uang untukmu,\Nhati-hati, jangan sampai dicuri.
Dialogue: 0,0:18:37.30,0:18:38.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Kate.
Dialogue: 0,0:18:39.29,0:18:41.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan menangis, cepatlah pergi.
Dialogue: 0,0:18:41.92,0:18:44.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jalani dan nikmatilah hidupmu.
Dialogue: 0,0:18:57.10,0:18:58.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di usiaku sekarang,
Dialogue: 0,0:18:58.33,0:19:02.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku harus memakai gaun\Npenuh pita dan renda seperti ini?
Dialogue: 0,0:19:02.81,0:19:04.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini untuk Tuan Putri Berambut Putih.
Dialogue: 0,0:19:05.19,0:19:08.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf selalu membuatmu cemas.
Dialogue: 0,0:19:08.79,0:19:11.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pakaian dewasa seperti biasanya juga bagus,
Dialogue: 0,0:19:11.83,0:19:14.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi gaun merah muda juga imut, ya?
Dialogue: 0,0:19:16.03,0:19:20.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin memasukkan semua ini\Nke wadah bernama kesabaran,
Dialogue: 0,0:19:20.01,0:19:23.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tutup rapat, lalu buang ke api,\Ndan bakar sampai habis
Dialogue: 0,0:19:23.43,0:19:25.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}agar hilang semua dari ingatanku.
Dialogue: 0,0:19:38.95,0:19:44.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kadal yang berubah wujud menjadi manusia\Nakhirnya menikah dengan Tuan Putri.
Dialogue: 0,0:19:44.62,0:19:46.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat.
Dialogue: 0,0:19:51.03,0:19:53.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekitar dua minggu setelah pria itu\Nkabur dari penjara,
Dialogue: 0,0:19:53.42,0:19:56.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ibu kota melakukan pencarian besar-besaran.
Dialogue: 0,0:19:56.91,0:19:59.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, dia dan wanita berambut merah
Dialogue: 0,0:19:59.43,0:20:04.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang sering menjenguknya\Nmasih belum ditemukan.
Dialogue: 0,0:20:08.71,0:20:10.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten.
Dialogue: 0,0:20:14.76,0:20:15.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:20:15.97,0:20:17.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten.
Dialogue: 0,0:20:17.62,0:20:19.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu terlihat sangat lelah.
Dialogue: 0,0:20:21.58,0:20:25.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, pelaku penyerangan\Ndi jamuan malam kabur dari penjara.
Dialogue: 0,0:20:25.37,0:20:26.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:20:26.27,0:20:28.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di dalam istana terjadi kekacauan besar.
Dialogue: 0,0:20:28.81,0:20:31.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimanapun, ada tahanan\Nyang menghilang dari penjara.
Dialogue: 0,0:20:32.03,0:20:33.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus.
Dialogue: 0,0:20:33.49,0:20:35.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, bagaimana dengan pria itu?
Dialogue: 0,0:20:35.28,0:20:38.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mungkin menyelinap ke daerah kumuh.
Dialogue: 0,0:20:38.34,0:20:39.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sebenarnya masih amatir.
Dialogue: 0,0:20:40.41,0:20:43.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mengumumkan hadiah buronan,\Nsuatu hari pasti akan tertangkap.
Dialogue: 0,0:20:44.64,0:20:48.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memikirkan adiknya membuatku kasihan,\Ntapi apa boleh buat.
Dialogue: 0,0:20:49.52,0:20:51.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:20:54.19,0:20:55.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten.
Dialogue: 0,0:20:56.61,0:20:58.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Butuh waktu bertahun-tahun\Njuga tidak apa-apa.
Dialogue: 0,0:20:58.74,0:21:00.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau suatu hari nanti Kapten bisa cuti,
Dialogue: 0,0:21:00.74,0:21:03.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bagaimana kalau kita bertiga\Npergi ke Cadiz?
Dialogue: 0,0:21:03.70,0:21:06.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di Cadiz, pada malam pergantian musim panas,
Dialogue: 0,0:21:06.24,0:21:09.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}perahu-perahu kecil membawa lilin\Ndilepaskan ke laut.
Dialogue: 0,0:21:09.54,0:21:11.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tahu banyak hal, ya.
Dialogue: 0,0:21:11.35,0:21:13.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama lilin menyala,
Dialogue: 0,0:21:13.54,0:21:15.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}konon arwah orang meninggal
Dialogue: 0,0:21:15.00,0:21:17.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan kembali lagi ke dunia ini.
Dialogue: 0,0:21:18.59,0:21:21.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau arwah keluargaku kembali,
Dialogue: 0,0:21:21.76,0:21:24.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ada banyak hal yang ingin\Nkuceritakan pada mereka.
Dialogue: 0,0:21:27.08,0:21:28.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus pergi ke sana!
Dialogue: 0,0:21:28.77,0:21:29.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku janji.
Dialogue: 0,0:21:32.48,0:21:38.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski aku bersalah pada Kapten dan para anggota\NPasukan Kesatria yang berusaha keras mencari,
Dialogue: 0,0:21:39.03,0:21:41.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tetap tidak akan meminta maaf.
Dialogue: 0,0:21:41.76,0:21:44.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suatu hari nanti,\Naku akan menerima balasannya.
Dialogue: 0,0:21:44.41,0:21:46.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah siap dengan tekad ini.
Dialogue: 0,0:21:50.52,0:21:51.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jejak Chloe sudah ditemukan!
Dialogue: 0,0:21:53.11,0:21:57.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya koki rumah bangsawan yang pernah\Ndisusupi Chloe dulu pernah melihat sosoknya.
Dialogue: 0,0:21:57.55,0:21:59.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia menggunakan nama Carol
Dialogue: 0,0:21:59.07,0:22:01.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan bekerja bersama koki itu\Nselama lima bulan.
Dialogue: 0,0:22:01.84,0:22:03.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cocok dengan informasi kita.
Dialogue: 0,0:22:04.37,0:22:08.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang dia ada di Kerajaan Ashbury.
