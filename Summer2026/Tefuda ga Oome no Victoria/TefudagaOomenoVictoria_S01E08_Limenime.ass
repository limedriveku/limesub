Dialogue: 0,0:00:00.98,0:00:06.74,sign,,0000,0000,0000,,KERAJAAN RANDALL
Dialogue: 0,0:01:01.42,0:01:06.05,sign,,0000,0000,0000,,VICTORIA OF MANY FACES
Dialogue: 0,0:02:19.99,0:02:24.56,sign,,0000,0000,0000,,EPISODE 8: AKU SUNGGUH MERASA BERSYUKUR
Dialogue: 0,0:07:13.87,0:07:15.87,sign,,0000,0000,0000,,KERAJAAN ASHBURY, DUA BULAN YANG LALU
Dialogue: 0,0:07:16.37,0:07:20.13,sign,,0000,0000,0000,,TIGA HARI SETELAH VICTORIA MENGHILANG
Dialogue: 0,0:07:56.71,0:07:59.21,sign,,0000,0000,0000,,TIGA HARI KEMUDIAN
Dialogue: 0,0:13:53.31,0:13:55.81,sign,,0000,0000,0000,,SATU BULAN KEMUDIAN
Dialogue: 0,0:19:14.63,0:19:15.78,sign,,0000,0000,0000,,KERAJAAN ASHBURY, MUSIM SEMI
Dialogue: 0,0:20:38.43,0:20:40.68,sign,,0000,0000,0000,,KERAJAAN RANDALL, BEBERAPA HARI KEMUDIAN
Dialogue: 0,0:00:14.73,0:00:18.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maria, bagaimana kondisi kawanan dombanya?
Dialogue: 0,0:00:19.09,0:00:21.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada yang sakit atau terluka,
Dialogue: 0,0:00:21.13,0:00:23.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}semuanya sehat.
Dialogue: 0,0:00:23.61,0:00:25.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah.
Dialogue: 0,0:00:25.51,0:00:27.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu juga sebaiknya istirahat.
Dialogue: 0,0:00:27.45,0:00:29.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di mana anakmu?
Dialogue: 0,0:00:29.19,0:00:31.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sedang bermain dengan domba.
Dialogue: 0,0:00:32.10,0:00:33.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lyle!
Dialogue: 0,0:00:34.12,0:00:35.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sini!
Dialogue: 0,0:00:42.71,0:00:44.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempat ini tenang dan nyaman, ya.
Dialogue: 0,0:00:44.69,0:00:45.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, kan?
Dialogue: 0,0:00:45.86,0:00:47.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan hanya sampai musim semi,
Dialogue: 0,0:00:47.36,0:00:50.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tinggallah selama yang kamu mau.
Dialogue: 0,0:02:24.56,0:02:25.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beres.
Dialogue: 0,0:02:26.32,0:02:28.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita giring kawanan domba ke sini.
Dialogue: 0,0:02:28.40,0:02:29.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:02:38.76,0:02:40.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jeraminya sudah selesai diganti.
Dialogue: 0,0:02:40.93,0:02:42.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selesai secepat itu?
Dialogue: 0,0:02:42.56,0:02:44.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal baru lewat dua bulan.
Dialogue: 0,0:02:44.81,0:02:47.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu belajar sangat cepat, ya.
Dialogue: 0,0:02:47.38,0:02:50.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku suka pekerjaan yang banyak gerak.
Dialogue: 0,0:02:50.40,0:02:51.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berterima kasih,
Dialogue: 0,0:02:51.90,0:02:53.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi jangan memaksakan diri, ya.
Dialogue: 0,0:02:53.99,0:02:55.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sudah sewajarnya.
Dialogue: 0,0:02:55.91,0:02:58.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski baru pertama bertemu,
Dialogue: 0,0:02:58.24,0:03:00.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu sudah mempekerjakan\Ndan menampung kami.
Dialogue: 0,0:03:00.33,0:03:01.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu dipikirkan.
Dialogue: 0,0:03:01.74,0:03:05.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di dunia ini banyak juga suami\Nyang tega memukul istrinya.
Dialogue: 0,0:03:05.84,0:03:08.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya, tunggu sebentar.
Dialogue: 0,0:03:09.09,0:03:10.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini.
Dialogue: 0,0:03:10.32,0:03:11.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bagianmu.
Dialogue: 0,0:03:11.75,0:03:13.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu Mina.
Dialogue: 0,0:03:13.30,0:03:15.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah banyak membantu.
Dialogue: 0,0:03:15.20,0:03:19.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makan yang banyak agar cepat besar,\Nlalu bantu terus ibumu.
Dialogue: 0,0:03:34.36,0:03:38.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Vicky, apa benda berbulu itu\Nbetulan bisa menjadi benang wol?
Dialogue: 0,0:03:38.36,0:03:39.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa.
Dialogue: 0,0:03:39.77,0:03:41.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah dicukur, bulu domba dibersihkan,
Dialogue: 0,0:03:41.99,0:03:44.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dikeringkan, lalu dipintal jadi benang.
Dialogue: 0,0:03:47.08,0:03:49.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lain kali, kita minta Bu Mina\Nuntuk mengajarkanmu.
Dialogue: 0,0:03:49.43,0:03:50.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serius?
Dialogue: 0,0:03:50.99,0:03:54.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, jangan panggil aku Vicky\Ndi depan Bu Mina, ya.
Dialogue: 0,0:03:55.62,0:03:56.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:03:59.54,0:04:04.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari itu, Nonna mengikutiku pergi\Ntanpa sedikit mengeluh.
Dialogue: 0,0:04:05.12,0:04:07.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan soal mengganti nama
Dialogue: 0,0:04:07.39,0:04:09.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}juga mulai perlahan-lahan terbiasa.
Dialogue: 0,0:04:13.38,0:04:16.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak tahu\Nsiapa orang di belakang Miles,
Dialogue: 0,0:04:16.89,0:04:20.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin dia sebenarnya\Ntidak diperintah oleh siapa pun.
Dialogue: 0,0:04:21.76,0:04:25.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, selama ada kemungkinan\Ndia terkait dengan organisasi,
Dialogue: 0,0:04:26.02,0:04:28.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tak akan membiarkan Nonna\Nmendekati organisasi.
Dialogue: 0,0:04:29.36,0:04:31.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tempat yang mengkhianatiku.
Dialogue: 0,0:04:31.81,0:04:33.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak akan kubiarkan.
Dialogue: 0,0:04:34.57,0:04:37.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat berusia delapan tahun,\Naku terpisah dari keluargaku
Dialogue: 0,0:04:37.59,0:04:39.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan diadopsi oleh Lancome.
Dialogue: 0,0:04:39.83,0:04:41.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misi pertamaku saat usia 15 tahun.
Dialogue: 0,0:04:42.39,0:04:44.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah itu, aku hanya terus bekerja.
Dialogue: 0,0:04:45.29,0:04:46.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bekerja untuk keluargaku.
Dialogue: 0,0:04:48.00,0:04:50.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agen rahasia\Ndilarang menghubungi keluarganya.
Dialogue: 0,0:04:52.06,0:04:54.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku meminta tolong pada Lancome
Dialogue: 0,0:04:54.36,0:04:58.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk mengirimkan barang\Ndan uang setiap bulan.
Dialogue: 0,0:04:59.65,0:05:01.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Barang-barang yang kukirimkan,
Dialogue: 0,0:05:01.10,0:05:04.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}harusnya bisa membuat Ayah, Ibu,\Ndan adikku, Emily, senang.
Dialogue: 0,0:05:05.79,0:05:08.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah penopang hatiku.
Dialogue: 0,0:05:10.06,0:05:11.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepuluh tahun kemudian,
Dialogue: 0,0:05:11.84,0:05:14.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku kembali ke kampung halamanku\Nkarena urusan kerja.
Dialogue: 0,0:05:15.70,0:05:18.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski hanya melihat rumah dari kejauhan...
Dialogue: 0,0:05:18.31,0:05:20.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, aku ingin melihat keluargaku.
Dialogue: 0,0:05:22.59,0:05:24.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rumahku hangus terbakar.
Dialogue: 0,0:05:24.55,0:05:27.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah, Ibu, dan Emily meninggal dunia.
Dialogue: 0,0:05:27.42,0:05:29.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu pun sudah insiden dua tahun lalu.
Dialogue: 0,0:05:30.75,0:05:34.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sangat memahami\Nbetapa aku menghargai keluargaku.
Dialogue: 0,0:05:36.01,0:05:37.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski tak bisa menghubungi keluargaku,
Dialogue: 0,0:05:37.95,0:05:41.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami sepakat dia setidaknya\Nakan mengabariku kalau ada yang meninggal.
Dialogue: 0,0:06:00.01,0:06:02.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada saat itu, aku akhirnya sadar
Dialogue: 0,0:06:02.57,0:06:05.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bahwa selama ini aku telah ditipu olehnya.
Dialogue: 0,0:06:07.51,0:06:10.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kabar pernikahan Lancome dan Mary
Dialogue: 0,0:06:10.27,0:06:12.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah kesempatan terbaik.
Dialogue: 0,0:06:12.69,0:06:15.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sengaja mengungkapkan\Ncintaku pada Lancome,
Dialogue: 0,0:06:15.63,0:06:17.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berpura-pura terpukul\Nkarena dia akan menikah,
Dialogue: 0,0:06:17.80,0:06:20.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan berniat mengakhiri hidupku.
Dialogue: 0,0:06:23.40,0:06:25.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus bekerja sampai usia 40-an,
Dialogue: 0,0:06:26.31,0:06:28.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu pensiun dan mendidik para junior.
Dialogue: 0,0:06:28.78,0:06:31.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lancome berusaha membujukku\Nuntuk menempuh jalan ini.
Dialogue: 0,0:06:32.41,0:06:36.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi sekarang, aku tak berniat\Nmengabdi pada organisasi,
Dialogue: 0,0:06:36.90,0:06:38.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apalagi punya kewajiban untuk itu.
Dialogue: 0,0:06:43.41,0:06:48.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagi dia, aku hanya alat\Nyang mudah digunakan.
Dialogue: 0,0:07:22.01,0:07:25.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten, kamu membantu orang lain lagi?
Dialogue: 0,0:07:26.24,0:07:27.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudmu?
Dialogue: 0,0:07:27.70,0:07:31.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi di kedai arak,\Nada seorang wanita yang memberitahuku
Dialogue: 0,0:07:31.07,0:07:33.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bahwa dia telah dibantu oleh Kapten\Ndan ingin berterima kasih.
Dialogue: 0,0:07:33.93,0:07:35.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya dia suka padamu,
Dialogue: 0,0:07:35.87,0:07:39.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bahkan bertanya apa Kapten\Nsudah punya kekasih.
Dialogue: 0,0:07:41.01,0:07:44.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhir-akhir ini, ada orang\Nyang menyelidiki informasi terkait diriku.
Dialogue: 0,0:07:45.01,0:07:48.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa targetnya bukan aku,\Nmelainkan Victoria.
Dialogue: 0,0:07:49.10,0:07:53.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama periode ini, Pasukan Kesatria Kedua\Nakan bertugas jaga rumah Nyonya Yolana,
Dialogue: 0,0:07:53.03,0:07:54.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}terutama pada malam hari.
Dialogue: 0,0:07:54.76,0:07:55.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengerti?
Dialogue: 0,0:07:55.58,0:07:56.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:08:04.46,0:08:05.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa?
Dialogue: 0,0:08:05.95,0:08:07.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, wah.
Dialogue: 0,0:08:07.45,0:08:09.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah ini Pasukan Kesatria Kedua?
Dialogue: 0,0:08:09.39,0:08:11.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong turunkan pedangmu.
Dialogue: 0,0:08:11.57,0:08:13.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asher, Kapten Pasukan Kesatria Kedua.
Dialogue: 0,0:08:14.29,0:08:15.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian Pasukan Kesatria Ketiga?
Dialogue: 0,0:08:15.79,0:08:17.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:08:17.96,0:08:21.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak dengar ada kabar\Nbahwa kalian akan datang.
Dialogue: 0,0:08:22.01,0:08:24.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami dapatkan informasi\Nlewat jalur yang berbeda darimu.
Dialogue: 0,0:08:24.96,0:08:29.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya ada pasukan pembunuh dari Hagl\Nyang akan menyerang kediaman ini.
Dialogue: 0,0:08:30.35,0:08:32.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasukan pembunuh dari Hagl?
Dialogue: 0,0:08:32.40,0:08:35.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasukan Kesatria Kedua\Nlebih ahli dalam menjaga, kan?
Dialogue: 0,0:08:35.39,0:08:37.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan tempat ini pada kami.
Dialogue: 0,0:08:37.65,0:08:40.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, aku yang akan menghadapi\Npara pembunuh itu.
Dialogue: 0,0:08:42.86,0:08:44.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini akan merepotkan.
Dialogue: 0,0:08:44.78,0:08:47.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan salahkan kami\Nkalau kalian terluka atau gugur.
Dialogue: 0,0:08:48.62,0:08:49.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja.
Dialogue: 0,0:09:17.70,0:09:19.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bergerak, kamu akan kubunuh.
Dialogue: 0,0:09:19.75,0:09:21.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu juga kalau bersuara.
Dialogue: 0,0:09:23.08,0:09:25.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya, biar kami yang mengatasi mereka.
Dialogue: 0,0:09:25.37,0:09:26.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:09:27.03,0:09:29.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beri tahu Nyonya Yolana di asrama\NPasukan Kesatria Kedua
Dialogue: 0,0:09:29.70,0:09:32.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk tetap waspada dan tinggal\Ndi sana beberapa hari lagi.
Dialogue: 0,0:09:32.53,0:09:33.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:09:43.55,0:09:46.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo, kamu kaptennya, ya?
Dialogue: 0,0:09:52.96,0:09:54.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pasti kaget, kan?
Dialogue: 0,0:09:54.77,0:09:56.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski tidak terlalu mencolok,
Dialogue: 0,0:09:56.80,0:09:59.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di Ashbury juga ada organisasi\Nyang menangani misi khusus.
Dialogue: 0,0:10:00.33,0:10:01.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja,
Dialogue: 0,0:10:01.93,0:10:04.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami hanya akan menyuntikmu.
Dialogue: 0,0:10:05.78,0:10:08.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami berbeda dengan kalian,\Ntak akan melakukan hal yang berlebihan.
Dialogue: 0,0:10:09.61,0:10:12.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga tidak ingin melihat\Npemandangan seperti itu.
Dialogue: 0,0:10:13.11,0:10:14.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya sudah mulai bekerja.
Dialogue: 0,0:10:14.79,0:10:18.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Obat dari Negara Shen memang manjur.
Dialogue: 0,0:10:18.91,0:10:20.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,
Dialogue: 0,0:10:20.06,0:10:23.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalian datang ke sini demi siapa?
Dialogue: 0,0:10:23.27,0:10:25.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beri tahu aku nama targetnya.
Dialogue: 0,0:10:26.38,0:10:27.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chloe.
Dialogue: 0,0:10:28.26,0:10:30.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami datang untuk membunuh Chloe.
Dialogue: 0,0:10:30.25,0:10:31.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu.
Dialogue: 0,0:10:31.64,0:10:33.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa jelaskan orangnya seperti apa?
Dialogue: 0,0:10:33.45,0:10:35.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia agen rahasia terbaik kami.
Dialogue: 0,0:10:35.80,0:10:38.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rambut dan matanya\Nberwarna cokelat kemerahan.
Dialogue: 0,0:10:38.79,0:10:40.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Postur tubuhnya sedang.
Dialogue: 0,0:10:40.55,0:10:42.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Usianya 27 tahun.
Dialogue: 0,0:10:43.05,0:10:44.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi dia agen rahasia terbaik.
Dialogue: 0,0:10:45.07,0:10:48.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, kenapa kalian ingin membunuhnya?
Dialogue: 0,0:10:49.15,0:10:50.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia kabur.
Dialogue: 0,0:10:51.03,0:10:53.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa Chloe gagal menyelesaikan misinya?
Dialogue: 0,0:10:53.53,0:10:54.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:10:54.84,0:10:56.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tiba-tiba menghilang.
Dialogue: 0,0:10:56.51,0:11:00.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kaisar memerintahkan untuk membunuh\Nanjing yang kehilangan kesetiaan.
Dialogue: 0,0:11:00.43,0:11:03.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh kesetiaan yang luar biasa.
Dialogue: 0,0:11:03.19,0:11:05.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa tak ada yang ingin keluar\Ndi tengah jalan?
Dialogue: 0,0:11:05.64,0:11:06.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keluar?
Dialogue: 0,0:11:06.90,0:11:08.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada orang yang akan keluar.
Dialogue: 0,0:11:08.73,0:11:10.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama masih bisa bergerak,\Nakan terus bergerak.
Dialogue: 0,0:11:10.82,0:11:14.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menjadi pelatih, staf administrasi,\Npekerja serabutan.
Dialogue: 0,0:11:14.33,0:11:16.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak pekerjaan yang bisa dilakukan.
Dialogue: 0,0:11:16.56,0:11:18.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak akan ada\Nyang meninggalkan organisasi.
Dialogue: 0,0:11:18.99,0:11:22.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bisa disebut sebagai budak di Ashbury.
Dialogue: 0,0:11:25.86,0:11:28.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertanyaannya sudah hampir selesai.
Dialogue: 0,0:11:28.61,0:11:31.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia masih punya rekan lain\Nyang tinggal di negara kita.
Dialogue: 0,0:11:31.21,0:11:32.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tangkap mereka semua malam ini juga.
Dialogue: 0,0:11:32.84,0:11:33.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:11:34.20,0:11:35.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong,
Dialogue: 0,0:11:35.55,0:11:38.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jaringan komunikasi\Nyang kubangun sangat sukses.
Dialogue: 0,0:11:38.79,0:11:41.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa menyampaikan informasi dulu\Nsebelum para pembunuh bertindak.
Dialogue: 0,0:11:41.81,0:11:43.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat tersentuh.
Dialogue: 0,0:11:43.60,0:11:45.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kepala Bagian memang hebat.
Dialogue: 0,0:11:48.00,0:11:50.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agen rahasia dari Kerajaan Hagl?
Dialogue: 0,0:11:50.61,0:11:54.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar Victoria adalah\Nagen rahasia terbaik mereka.
Dialogue: 0,0:11:54.72,0:11:58.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena dia kabur dari organisasi,\Nmereka pun mengirim pembunuh.
Dialogue: 0,0:11:58.99,0:12:00.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurut pertimbangan Kaisar,
Dialogue: 0,0:12:00.85,0:12:06.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}diputuskan untuk menyatakan pada publik\Nbahwa dia sudah dibunuh oleh orang Hagl.
Dialogue: 0,0:12:06.86,0:12:08.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa seperti itu?
Dialogue: 0,0:12:08.12,0:12:10.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ada yang tahu Victoria masih hidup,
Dialogue: 0,0:12:10.79,0:12:14.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}orang-orang Hagl\Nakan terus mengirim pembunuh.
Dialogue: 0,0:12:14.84,0:12:16.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu akan sangat merepotkan.
Dialogue: 0,0:12:17.28,0:12:20.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk berjaga-jaga, kami juga bertanya\Npada Pasukan Kesatria Ketiga.
Dialogue: 0,0:12:20.41,0:12:23.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski sudah menangkap\Nempat pembunuh dari Hagl,
Dialogue: 0,0:12:23.69,0:12:25.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mereka sepertinya tak tertarik padanya.
Dialogue: 0,0:12:26.58,0:12:31.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kita pura-pura tak tahu\Nbahwa dia adalah agen rahasia.
Dialogue: 0,0:12:32.02,0:12:35.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesuai identitas palsu yang dia gunakan,
Dialogue: 0,0:12:35.77,0:12:39.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Victoria hanyalah orang Randall biasa,
Dialogue: 0,0:12:39.57,0:12:41.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena alasan yang tak diketahui,
Dialogue: 0,0:12:41.12,0:12:43.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia dibunuh oleh orang Hagl."
Dialogue: 0,0:12:47.40,0:12:51.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, sebelumnya kamu sudah\Nmenyadari identitas aslinya
Dialogue: 0,0:12:51.29,0:12:53.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau tidak menyadarinya?
Dialogue: 0,0:12:55.86,0:12:57.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku samar-samar menyadarinya.
Dialogue: 0,0:12:57.97,0:13:00.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benar-benar mohon maaf\Nkarena tak langsung lapor.
Dialogue: 0,0:13:02.66,0:13:04.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak dengar kamu bicara apa.
Dialogue: 0,0:13:05.29,0:13:07.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang tidak ada bukti pasti,
Dialogue: 0,0:13:07.00,0:13:08.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku samar-samar menyadarinya.
Dialogue: 0,0:13:13.21,0:13:15.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu bilang sebelumnya tidak tahu,
Dialogue: 0,0:13:15.19,0:13:17.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku bisa menganggap\Ninsiden ini tidak ada.
Dialogue: 0,0:13:17.32,0:13:19.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya, akan ada hukuman untukmu.
Dialogue: 0,0:13:19.99,0:13:22.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Introspeksi diri di rumah\Ndan tunggu pemberitahuan.
Dialogue: 0,0:13:22.33,0:13:25.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dilarang keras untuk menyebarkan\Nhal terkait Victoria.
Dialogue: 0,0:13:25.75,0:13:26.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:13:32.07,0:13:33.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten?
Dialogue: 0,0:13:33.90,0:13:35.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa bisa jadi begini?
Dialogue: 0,0:13:37.24,0:13:38.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semangatlah.
Dialogue: 0,0:13:42.66,0:13:44.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Victoria.
Dialogue: 0,0:13:44.30,0:13:47.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tidak tahu bahwa dia\Nsudah dianggap mati.
Dialogue: 0,0:13:47.01,0:13:49.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia juga akan terus bersembunyi\Ndengan nama samaran.
Dialogue: 0,0:13:49.31,0:13:52.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, hal ini membuatku\Ntidak bisa menerimanya.
Dialogue: 0,0:13:56.16,0:13:59.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak, aku benar-benar\Nminta maaf tentang masalah kali ini.
Dialogue: 0,0:13:59.82,0:14:01.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu memikirkannya.
Dialogue: 0,0:14:02.20,0:14:05.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Departemenku sudah seperti\Npekerja serabutan.
Dialogue: 0,0:14:05.64,0:14:08.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski kamu dipindahkan,\Nitu tidak akan berpengaruh padaku.
Dialogue: 0,0:14:09.31,0:14:11.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapan kamu akan pergi ke Haydn?
Dialogue: 0,0:14:11.73,0:14:14.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berencana menemui\Npengelola wilayah di musim semi.
Dialogue: 0,0:14:14.96,0:14:16.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu waktu yang tepat.
Dialogue: 0,0:14:16.65,0:14:18.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iklim di sana nyaman,
Dialogue: 0,0:14:18.59,0:14:20.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pemandangan lautnya juga indah.
Dialogue: 0,0:14:21.24,0:14:23.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetaplah bekerja keras\Nmeski sudah menjadi Kepala Keamanan.
Dialogue: 0,0:14:24.58,0:14:27.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong,\Nbukankah kamu sedikit kurusan?
Dialogue: 0,0:14:27.81,0:14:29.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, aku baik-baik saja.
Dialogue: 0,0:14:29.81,0:14:31.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:14:31.43,0:14:33.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beristirahatlah selama musim dingin ini.
Dialogue: 0,0:14:33.56,0:14:35.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:14:38.94,0:14:42.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baguslah kita memprotes kasus ini\Nsebagai perampokan
Dialogue: 0,0:14:42.24,0:14:44.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan pembunuhan oleh pihak Hagl,
Dialogue: 0,0:14:44.73,0:14:48.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}setidaknya membuat mereka\Nberutang budi pada kita.
Dialogue: 0,0:14:48.45,0:14:51.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keselamatan Victoria memang terjamin,
Dialogue: 0,0:14:52.56,0:14:54.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi bagaimana bisa menyampaikannya
Dialogue: 0,0:14:54.87,0:14:56.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau orangnya saja belum ditemukan.
Dialogue: 0,0:14:57.71,0:15:01.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, opsinya hanya membiarkannya.
Dialogue: 0,0:15:02.00,0:15:05.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus segera menyiapkan\Npenyedia informasi berikutnya.
Dialogue: 0,0:15:06.20,0:15:08.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih ada banyak hal yang harus dilakukan.
Dialogue: 0,0:15:09.25,0:15:11.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Vicky!
Dialogue: 0,0:15:12.29,0:15:13.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, ada apa?
Dialogue: 0,0:15:13.89,0:15:15.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah selesai.
Dialogue: 0,0:15:16.65,0:15:19.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus!
Dialogue: 0,0:15:19.01,0:15:20.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini bisa dijual?
Dialogue: 0,0:15:20.72,0:15:22.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mau menjualnya?
Dialogue: 0,0:15:22.72,0:15:23.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin mencari uang.
Dialogue: 0,0:15:24.44,0:15:25.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu.
Dialogue: 0,0:15:25.63,0:15:28.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,\Nbawa ke kota besar untuk dijual.
Dialogue: 0,0:15:28.12,0:15:29.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku boleh pergi ke kota besar?
Dialogue: 0,0:15:30.31,0:15:31.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa tidak jadi masalah?
Dialogue: 0,0:15:32.06,0:15:34.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang penting ditutupi\Ndengan topi dan syal saja.
Dialogue: 0,0:15:35.65,0:15:38.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nonna, setiap hari kamu hanya\Nberbicara denganku, kan?
Dialogue: 0,0:15:39.32,0:15:42.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesekali berinteraksi\Ndengan orang lain itu juga penting.
Dialogue: 0,0:15:42.09,0:15:43.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:15:43.09,0:15:45.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat di kota, panggil aku Maria juga.
Dialogue: 0,0:15:46.16,0:15:49.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke depannya, aku boleh memanggilmu Ibu?
Dialogue: 0,0:15:50.39,0:15:54.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau memanggil nama, aku khawatir\Nakan tanpa sengaja memanggil Vicky.
Dialogue: 0,0:15:56.52,0:15:58.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja boleh.
Dialogue: 0,0:15:59.05,0:16:01.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Panggil aku Ibu, ya.
Dialogue: 0,0:16:04.26,0:16:05.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa menangis?
Dialogue: 0,0:16:06.24,0:16:09.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa, terima kasih.
Dialogue: 0,0:16:10.81,0:16:14.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu selalu bilang terima kasih.
Dialogue: 0,0:16:14.45,0:16:16.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya?
Dialogue: 0,0:16:16.66,0:16:20.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu karena aku benar-benar\Nmerasa bersyukur.
Dialogue: 0,0:16:27.05,0:16:29.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh kubeli dengan harga\Ndelapan koin perak?
Dialogue: 0,0:16:29.51,0:16:31.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh, akan kujual dengan harga itu.
Dialogue: 0,0:16:31.50,0:16:33.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, ini ditenun oleh anakmu?
Dialogue: 0,0:16:33.56,0:16:36.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, dia yang merangkai\Nsemua kelopak bunga ini,
Dialogue: 0,0:16:36.55,0:16:38.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu kami berdua menghubungkannya bersama.
Dialogue: 0,0:16:39.04,0:16:41.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sangat pekerja keras, ya.
Dialogue: 0,0:16:41.48,0:16:43.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, aku sangat rajin.
Dialogue: 0,0:16:44.72,0:16:47.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harga jualnya cukup bagus.
Dialogue: 0,0:16:48.32,0:16:50.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Delapan koin perak.
Dialogue: 0,0:16:50.80,0:16:54.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam waktu cepat,\Nketerampilan Nonna juga bertambah banyak.
Dialogue: 0,0:16:55.12,0:16:57.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita beli makanan manis.
Dialogue: 0,0:16:57.48,0:17:00.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau kue yang banyak krimnya!
Dialogue: 0,0:17:00.03,0:17:01.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita cari toko kue.
Dialogue: 0,0:17:01.86,0:17:03.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu, di sana.
Dialogue: 0,0:17:11.51,0:17:15.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya dia akan melahirkan malam ini.
Dialogue: 0,0:17:15.04,0:17:19.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu, aku ingin melihat domba\Nmelahirkan bayi.
Dialogue: 0,0:17:20.64,0:17:22.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh.
Dialogue: 0,0:17:35.12,0:17:36.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Panggil Bu Mina ke sini.
Dialogue: 0,0:17:36.73,0:17:37.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:18:04.38,0:18:07.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bayi dombanya imut sekali.
Dialogue: 0,0:18:07.64,0:18:09.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih besar dari yang kubayangkan.
Dialogue: 0,0:18:09.82,0:18:13.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Induk domba terlihat sangat kesakitan.
Dialogue: 0,0:18:14.73,0:18:16.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlihat sangat kesakitan.
Dialogue: 0,0:18:22.52,0:18:26.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa Ibu yang menghilang\Njuga merasa sangat sakit?
Dialogue: 0,0:18:27.19,0:18:28.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin begitu.
Dialogue: 0,0:18:28.40,0:18:30.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Proses melahirkan pasti menyakitkan.
Dialogue: 0,0:18:30.48,0:18:33.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa harus berjuang keras seperti itu?
Dialogue: 0,0:18:33.85,0:18:36.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Proses melahirkan manusia\Nmungkin butuh waktu yang lebih lama.
Dialogue: 0,0:18:40.25,0:18:41.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu Nonna
Dialogue: 0,0:18:41.96,0:18:44.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}juga berusaha sangat keras\Nuntuk melahirkanmu.
Dialogue: 0,0:18:46.88,0:18:48.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, Nonna juga
Dialogue: 0,0:18:48.68,0:18:50.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berusaha sangat keras untuk dilahirkan.
Dialogue: 0,0:18:54.30,0:18:56.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah lahir ke dunia ini.
Dialogue: 0,0:18:56.77,0:18:59.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senang sekali bisa bertemu denganmu.
Dialogue: 0,0:19:01.28,0:19:05.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mungkin tidak menyukai ibu\Nyang menelantarkan Nonna,
Dialogue: 0,0:19:06.73,0:19:08.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi untuk pertama kalinya,\Naku bersyukur.
Dialogue: 0,0:19:10.03,0:19:12.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih karena telah melahirkan Nonna.
Dialogue: 0,0:19:15.78,0:19:16.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu.
Dialogue: 0,0:19:16.89,0:19:18.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan kesepian.
Dialogue: 0,0:19:19.15,0:19:20.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan pulang saat libur.
Dialogue: 0,0:19:21.37,0:19:23.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menjaga rumah itu\Nagar tetap seperti semula.
Dialogue: 0,0:19:23.91,0:19:27.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalaupun kembali,\Nmereka tetap punya tempat tinggal.
Dialogue: 0,0:19:30.38,0:19:31.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Victoria,
Dialogue: 0,0:19:32.26,0:19:34.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu di mana sekarang?
Dialogue: 0,0:19:35.26,0:19:37.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa di tempat yang jauh
Dialogue: 0,0:19:37.28,0:19:39.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan hidup dengan nama lain?
Dialogue: 0,0:19:57.30,0:19:58.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lacinya ada celah rahasia?
Dialogue: 0,0:20:00.25,0:20:01.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada apa-apa di dalamnya.
Dialogue: 0,0:20:02.50,0:20:04.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, ada sesuatu.
Dialogue: 0,0:20:04.18,0:20:06.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini...
Dialogue: 0,0:20:06.12,0:20:08.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rambut pendek berwarna hitam?
Dialogue: 0,0:20:11.19,0:20:12.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mencari ibu dan putri berambut hitam.
Dialogue: 0,0:20:12.94,0:20:16.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Umur ibunya sekitar 20-an,\Nputrinya enam tahun.
Dialogue: 0,0:20:18.68,0:20:20.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada di catatan kami.
Dialogue: 0,0:20:20.77,0:20:22.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu.
Dialogue: 0,0:20:22.03,0:20:24.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mencari ibu dan putra,
Dialogue: 0,0:20:24.16,0:20:27.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ada pasangan ibu dan putra\Nyang pergi ke Kerajaan Randall.
Dialogue: 0,0:20:28.59,0:20:29.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong beri tahu aku detailnya.
Dialogue: 0,0:20:29.92,0:20:32.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka melewati pos pemeriksaan selatan.
Dialogue: 0,0:20:33.57,0:20:35.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nama ibunya Maria.
Dialogue: 0,0:20:35.59,0:20:37.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nama putranya Lyle.
Dialogue: 0,0:20:42.93,0:20:45.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, aku tidak tahu.
Dialogue: 0,0:20:45.14,0:20:46.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak tahu.
Dialogue: 0,0:20:50.73,0:20:52.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu dan putra berambut hitam?
Dialogue: 0,0:20:53.57,0:20:55.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka pernah ke sini.
Dialogue: 0,0:20:55.72,0:20:56.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:20:56.99,0:21:00.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka datang ke sini\Nuntuk menjual selimut rajut ini.
Dialogue: 0,0:21:00.20,0:21:01.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kualitasnya bagus,
Dialogue: 0,0:21:01.53,0:21:04.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku harap mereka bisa menjualnya lagi padaku.
Dialogue: 0,0:21:04.24,0:21:07.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi setelah itu,\Nmereka belum pernah datang lagi.
Dialogue: 0,0:21:08.21,0:21:09.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Victoria.
Dialogue: 0,0:21:09.87,0:21:13.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah siap\Nuntuk membuang identitasku demi dirimu.
Dialogue: 0,0:21:13.38,0:21:16.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari awal aku sudah berniat\Nmeninggalkan Pasukan Kesatria.
Dialogue: 0,0:21:16.61,0:21:19.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi bisa hidup bertiga\Nbersamamu dan Nonna.
Dialogue: 0,0:21:20.38,0:21:21.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tak perlu kabur lagi.
Dialogue: 0,0:21:21.87,0:21:23.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak perlu menghadapi semuanya sendirian.
Dialogue: 0,0:21:24.64,0:21:26.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kumohon, sekali lagi,
Dialogue: 0,0:21:28.46,0:21:30.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}biarkan aku berada di sisimu.
Dialogue: 0,0:21:37.34,0:21:39.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Victoria, apa kamu di sini?
Dialogue: 0,0:21:40.05,0:21:41.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anda siapa?
Dialogue: 0,0:21:42.18,0:21:43.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa Maria dan Lyle tinggal di sini?
Dialogue: 0,0:21:43.91,0:21:46.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu suaminya?
Dialogue: 0,0:21:46.28,0:21:47.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka sudah pergi.
Dialogue: 0,0:21:48.79,0:21:50.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu!
Dialogue: 0,0:22:00.24,0:22:01.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang, mereka sudah pergi.
Dialogue: 0,0:22:02.30,0:22:04.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka pergi tiga hari yang lalu,
Dialogue: 0,0:22:04.34,0:22:06.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan tidak bilang pergi ke mana.
