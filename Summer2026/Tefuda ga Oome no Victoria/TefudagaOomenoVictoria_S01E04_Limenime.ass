Dialogue: 0,0:00:11.41,0:00:16.00,sign,,0000,0000,0000,,VICTORIA OF MANY FACES
Dialogue: 0,0:01:34.49,0:01:36.96,sign,,0000,0000,0000,,EPISODE 4:\NAPA KAMU BERMAKSUD MENANGKAPKU?
Dialogue: 0,0:20:44.06,0:20:46.06,sign,,0000,0000,0000,,LAPORAN PENYELIDIKAN\NTERKAIT VICTORIA SELLERS ASLI
Dialogue: 0,0:20:46.14,0:20:47.52,sign,,0000,0000,0000,,VICTORIA YANG ASLI,\NSAMPAI SEKARANG MASIH HILANG
Dialogue: 0,0:20:47.52,0:20:48.89,sign,,0000,0000,0000,,SECARA RESMI, SUDAH MENINGGALKAN NEGARA\NMENUJU ASHBURY
Dialogue: 0,0:01:31.99,0:01:33.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Vicky.
Dialogue: 0,0:01:33.28,0:01:34.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Vicky.
Dialogue: 0,0:01:36.96,0:01:38.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:01:39.45,0:01:41.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nonna, maaf.
Dialogue: 0,0:01:42.05,0:01:45.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah jamuan semalam,\Nperasaan itu masih ada sampai sekarang.
Dialogue: 0,0:01:46.24,0:01:47.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo.
Dialogue: 0,0:01:47.92,0:01:50.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Vicky, kamu seperti Ibu.
Dialogue: 0,0:01:52.26,0:01:53.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya?
Dialogue: 0,0:01:54.09,0:01:57.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu juga selalu diam.
Dialogue: 0,0:01:58.03,0:02:01.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa jelaskan apa maksudnya?
Dialogue: 0,0:02:02.75,0:02:04.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dulu,
Dialogue: 0,0:02:05.37,0:02:07.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu juga pulang larut malam
Dialogue: 0,0:02:07.19,0:02:08.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan tidur sampai siang hari.
Dialogue: 0,0:02:08.97,0:02:13.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu pergi keluar lagi setelah langit gelap.
Dialogue: 0,0:02:13.78,0:02:16.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu pulang larut malam lagi.
Dialogue: 0,0:02:16.01,0:02:18.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama seperti Vicky tadi.
Dialogue: 0,0:02:19.73,0:02:22.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beliau selalu terlihat melamun.
Dialogue: 0,0:02:23.04,0:02:24.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu...
Dialogue: 0,0:02:26.92,0:02:28.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:02:29.56,0:02:31.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan melamun lagi.
Dialogue: 0,0:02:34.67,0:02:35.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salah.
Dialogue: 0,0:02:35.93,0:02:37.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Vicky, bukan begitu!
Dialogue: 0,0:02:37.55,0:02:40.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu melamun?\NBeri tahu aku.
Dialogue: 0,0:02:40.75,0:02:42.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu ingin tahu, ya?
Dialogue: 0,0:02:42.53,0:02:46.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak tahu apa\Nyang dilamunkan ibumu dulu,
Dialogue: 0,0:02:47.48,0:02:48.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kalau tentang diriku,
Dialogue: 0,0:02:48.95,0:02:50.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan cerita apa adanya.
Dialogue: 0,0:02:51.04,0:02:52.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau mendengarkan?
Dialogue: 0,0:02:52.89,0:02:53.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:02:54.85,0:02:56.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebelum jamuan semalam...
Dialogue: 0,0:03:00.49,0:03:01.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat!
Dialogue: 0,0:03:01.37,0:03:03.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu hebat, Vicky!
Dialogue: 0,0:03:04.56,0:03:06.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, ke depannya,
Dialogue: 0,0:03:06.27,0:03:08.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebaiknya aku lari saja
Dialogue: 0,0:03:08.60,0:03:11.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}daripada melawan orang jahat.
Dialogue: 0,0:03:11.59,0:03:13.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga tak mau kamu terlibat.
Dialogue: 0,0:03:14.72,0:03:17.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi saat kita bersama,\Nkamu tidak akan melawan?
Dialogue: 0,0:03:17.72,0:03:18.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:03:18.69,0:03:20.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daripada mengalahkan orang jahat,
Dialogue: 0,0:03:20.85,0:03:24.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lebih baik aku melindungimu.
Dialogue: 0,0:03:28.80,0:03:30.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau!
Dialogue: 0,0:03:30.03,0:03:32.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau Vicky menahan diri!
Dialogue: 0,0:03:32.56,0:03:34.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kasihan Vicky!
Dialogue: 0,0:03:34.68,0:03:38.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nonna, kamulah yang terpenting bagiku.
Dialogue: 0,0:03:38.77,0:03:40.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bukan soal kasihan.
Dialogue: 0,0:03:42.19,0:03:45.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau menahan diri,\NVicky juga akan menghilang!
Dialogue: 0,0:03:45.54,0:03:48.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalahkan orang jahat saja!
Dialogue: 0,0:03:48.54,0:03:50.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan menahan diri!
Dialogue: 0,0:03:50.29,0:03:54.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai sekarang,\NNonna belum pernah menangis.
Dialogue: 0,0:03:54.61,0:03:55.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan dia berpikir,
Dialogue: 0,0:03:55.80,0:03:59.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Aku ditinggalkan karena\Nterlalu menahan diri,"
Dialogue: 0,0:03:59.16,0:04:01.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}makanya jadi tak bisa menangis\Nmeski ingin.
Dialogue: 0,0:04:01.91,0:04:03.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan cemas, Nonna.
Dialogue: 0,0:04:03.99,0:04:06.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu khawatir,\Naku baik-baik saja.
Dialogue: 0,0:04:06.06,0:04:09.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Vicky, kalau ada orang jahat muncul,\Nkalahkan dia.
Dialogue: 0,0:04:10.35,0:04:11.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:04:11.44,0:04:12.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau orang jahat muncul,
Dialogue: 0,0:04:12.73,0:04:14.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}saat bisa dikalahkan,\Npasti akan kukalahkan.
Dialogue: 0,0:04:15.49,0:04:17.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, melindungimu itu\Nyang paling penting,
Dialogue: 0,0:04:17.75,0:04:20.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}saat harus kabur, sebaiknya kabur.
Dialogue: 0,0:04:20.01,0:04:23.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, aku pasti tak akan meninggalkanmu.
Dialogue: 0,0:04:25.69,0:04:27.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Vicky,
Dialogue: 0,0:04:27.09,0:04:29.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peragakan cara mengalahkan\Norang jahat, dong.
Dialogue: 0,0:04:29.20,0:04:30.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin lihat!
Dialogue: 0,0:04:30.69,0:04:32.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang dan di sini?
Dialogue: 0,0:04:33.61,0:04:35.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon.
Dialogue: 0,0:04:35.13,0:04:37.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan beri tahu siapa pun, ya!
Dialogue: 0,0:04:37.63,0:04:38.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:04:38.34,0:04:39.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya jangan!
Dialogue: 0,0:04:39.47,0:04:41.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak akan kuberi tahu siapa pun!
Dialogue: 0,0:04:48.58,0:04:49.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tendangan berputar!
Dialogue: 0,0:04:49.95,0:04:51.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pegang bahunya,\Nserang perutnya dengan lutut.
Dialogue: 0,0:04:51.98,0:04:53.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu beri pukulan telak!
Dialogue: 0,0:05:01.66,0:05:06.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke depannya, kita harus berkomunikasi\Ndengan baik dan hidup bersama, Nonna.
Dialogue: 0,0:05:07.10,0:05:08.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Vicky, ini taruh di mana?
Dialogue: 0,0:05:08.83,0:05:10.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu yang ketiga dari kanan.
Dialogue: 0,0:05:14.75,0:05:15.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau yang ini?
Dialogue: 0,0:05:16.36,0:05:18.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang itu taruh di paling tepi.
Dialogue: 0,0:05:31.55,0:05:33.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu menyusunnya sesuai urutan pengarang?
Dialogue: 0,0:05:34.55,0:05:37.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mau disusun dengan cara lain,\Naku akan menyesuaikannya lagi.
Dialogue: 0,0:05:38.24,0:05:40.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu, seperti ini saja.
Dialogue: 0,0:05:40.19,0:05:41.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sempurna.
Dialogue: 0,0:05:41.36,0:05:42.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Merapikannya pasti melelahkan.
Dialogue: 0,0:05:42.82,0:05:45.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, aku suka merapikan barang.
Dialogue: 0,0:05:46.36,0:05:47.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Merapikan barang.
Dialogue: 0,0:05:53.36,0:05:56.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nonna, kamu baca buku apa?
Dialogue: 0,0:05:56.59,0:05:57.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa bukunya seru?
Dialogue: 0,0:05:58.99,0:06:01.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sangat seru.
Dialogue: 0,0:06:01.09,0:06:02.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya?
Dialogue: 0,0:06:02.30,0:06:05.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bebas baca semua buku di perpus ini.
Dialogue: 0,0:06:05.26,0:06:07.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bebas baca buku apa pun di sini?
Dialogue: 0,0:06:07.44,0:06:08.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja.
Dialogue: 0,0:06:08.75,0:06:11.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buku sejarah itu sangat seru.
Dialogue: 0,0:06:11.02,0:06:13.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serasa bisa mengobrol\Ndengan orang-orang zaman dulu.
Dialogue: 0,0:06:13.89,0:06:15.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengobrol?
Dialogue: 0,0:06:15.35,0:06:18.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, mari seduh teh.
Dialogue: 0,0:06:27.06,0:06:28.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Vicky.
Dialogue: 0,0:06:28.99,0:06:30.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jeff datang!
Dialogue: 0,0:06:32.00,0:06:33.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten.
Dialogue: 0,0:06:33.16,0:06:34.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo.
Dialogue: 0,0:06:34.51,0:06:36.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada perlu dengan Tuan Bernard?
Dialogue: 0,0:06:38.31,0:06:39.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, aku ingin menemuimu.
Dialogue: 0,0:06:41.34,0:06:44.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku boleh ajak kalian makan malam ini?
Dialogue: 0,0:06:46.44,0:06:47.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jeff.
Dialogue: 0,0:06:47.35,0:06:48.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo, Nonna.
Dialogue: 0,0:06:48.55,0:06:50.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, aku juga
Dialogue: 0,0:06:50.25,0:06:52.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ada hal yang ingin kubicarakan\Ndengan Kapten.
Dialogue: 0,0:06:53.50,0:06:55.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau makan di rumahku?
Dialogue: 0,0:06:58.09,0:07:00.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena hal ini tidak boleh\Nsampai ada orang lain tahu.
Dialogue: 0,0:07:04.67,0:07:05.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini enak!
Dialogue: 0,0:07:15.36,0:07:16.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu diikuti seseorang?
Dialogue: 0,0:07:17.61,0:07:18.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:07:18.92,0:07:22.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa Kapten perlu tahu tentang hal ini.
Dialogue: 0,0:07:30.00,0:07:33.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin itu orang yang diutus\NPutra Mahkota Conrad.
Dialogue: 0,0:07:33.39,0:07:35.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:07:38.88,0:07:42.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka menemukan siapa yang menjatuhkan\Npelaku serangan jamuan di taman.
Dialogue: 0,0:07:43.30,0:07:44.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu,
Dialogue: 0,0:07:44.64,0:07:46.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mereka curiga bahwa kamulah orangnya.
Dialogue: 0,0:07:46.97,0:07:48.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mencurigaiku?
Dialogue: 0,0:07:48.24,0:07:52.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada penjaga yang melihat seorang wanita\Nbergaun ungu muda atau biru muda
Dialogue: 0,0:07:52.99,0:07:57.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}melarikan diri dari taman.
Dialogue: 0,0:07:58.98,0:08:01.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa saja orang itu bukan aku.
Dialogue: 0,0:08:01.37,0:08:03.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku diikuti karena alasan ini...
Dialogue: 0,0:08:11.30,0:08:12.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan
Dialogue: 0,0:08:13.00,0:08:14.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bertanggung jawab.
Dialogue: 0,0:08:14.44,0:08:17.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan membujuk Putra Mahkota\Nmenghentikan pengintaian.
Dialogue: 0,0:08:18.89,0:08:20.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi,
Dialogue: 0,0:08:20.76,0:08:23.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kumohon jangan tiba-tiba menghilang.
Dialogue: 0,0:08:24.09,0:08:25.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menghilang?
Dialogue: 0,0:08:25.97,0:08:30.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku selalu merasa\Nkamu akan tiba-tiba menghilang.
Dialogue: 0,0:08:34.24,0:08:36.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan begitu.
Dialogue: 0,0:08:36.64,0:08:38.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekhawatiranmu berlebihan.
Dialogue: 0,0:08:45.11,0:08:46.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku boleh mampir ke sini lagi?
Dialogue: 0,0:08:47.77,0:08:49.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, boleh.
Dialogue: 0,0:09:01.50,0:09:02.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat malam.
Dialogue: 0,0:09:10.43,0:09:11.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nonna.
Dialogue: 0,0:09:11.36,0:09:14.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Vicky, aku sangat menantikan malam ini.
Dialogue: 0,0:09:14.74,0:09:16.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biskuitnya enak!
Dialogue: 0,0:09:16.37,0:09:20.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga mau makan biskuit\Nbuatan Nona Susan.
Dialogue: 0,0:09:20.87,0:09:23.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti aku akan tanya beliau\Nsediakan untukmu juga.
Dialogue: 0,0:09:24.40,0:09:26.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Nonna.
Dialogue: 0,0:09:32.01,0:09:34.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Vicky, cepat!
Dialogue: 0,0:09:41.04,0:09:44.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku sudah diawasi keluarga kerajaan,
Dialogue: 0,0:09:44.10,0:09:47.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku harusnya segera meninggalkan\Ntempat ini dan pergi ke negara lain.
Dialogue: 0,0:09:49.30,0:09:51.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi tak ada yang mengikutiku lagi.
Dialogue: 0,0:09:51.61,0:09:54.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya Kapten betulan sudah membujuknya.
Dialogue: 0,0:09:56.81,0:09:58.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak menjadi agen rahasia,
Dialogue: 0,0:09:59.27,0:10:00.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}orang yang bisa kupercaya
Dialogue: 0,0:10:00.79,0:10:02.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hanya satu orang.
Dialogue: 0,0:10:04.90,0:10:06.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, hanya satu orang itu
Dialogue: 0,0:10:06.97,0:10:10.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menginjak-injak kepercayaanku\Nyang membuatku pergi ke sini.
Dialogue: 0,0:10:10.78,0:10:13.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat memilih untuk memercayai seseorang,
Dialogue: 0,0:10:13.44,0:10:16.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku harus sadar\Nada kemungkinan akan dikhianati.
Dialogue: 0,0:10:16.79,0:10:17.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan begitu,
Dialogue: 0,0:10:18.23,0:10:20.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}meski berakhir ditinggalkan,
Dialogue: 0,0:10:20.52,0:10:22.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tak akan merasa sakit hati.
Dialogue: 0,0:10:23.96,0:10:25.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Ah, sudah kuduga."
Dialogue: 0,0:10:25.60,0:10:27.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cukup hadapi dengan senyuman.
Dialogue: 0,0:10:27.80,0:10:28.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kamu.
Dialogue: 0,0:10:28.94,0:10:29.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi sendirian, kan?
Dialogue: 0,0:10:29.90,0:10:31.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari minum bersamaku.
Dialogue: 0,0:10:33.97,0:10:35.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kamu dengar tidak?
Dialogue: 0,0:10:43.71,0:10:46.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, jangan sok jual mahal!
Dialogue: 0,0:10:46.83,0:10:48.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat.
Dialogue: 0,0:10:50.61,0:10:52.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wanita itu pergi ke mana?
Dialogue: 0,0:11:21.64,0:11:22.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Patah tulang?
Dialogue: 0,0:11:22.79,0:11:24.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:11:24.00,0:11:25.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia jatuh dari tangga.
Dialogue: 0,0:11:25.69,0:11:27.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlebih, tangan dominannya yang patah.
Dialogue: 0,0:11:27.69,0:11:29.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu.
Dialogue: 0,0:11:29.69,0:11:32.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kebetulan ada di sana dan melihatnya.
Dialogue: 0,0:11:32.39,0:11:35.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mungkin harus dirawat di rumahku\Nuntuk sementara waktu.
Dialogue: 0,0:11:38.41,0:11:39.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, ya,
Dialogue: 0,0:11:39.92,0:11:41.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}selagi aku merawatnya,
Dialogue: 0,0:11:41.10,0:11:43.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}maukah kamu menjadi guru les putraku?
Dialogue: 0,0:11:43.35,0:11:45.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan memberimu gaji\Nyang sama dengan di sini.
Dialogue: 0,0:11:47.09,0:11:49.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guru les?
Dialogue: 0,0:11:49.23,0:11:51.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia belum bisa berbahasa asing.
Dialogue: 0,0:11:51.44,0:11:54.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin kamu yang poliglot mengajarkannya.
Dialogue: 0,0:11:54.32,0:11:55.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu sanggup?
Dialogue: 0,0:11:56.51,0:11:59.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku bukan guru bahasa asing.
Dialogue: 0,0:11:59.32,0:12:01.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga tidak bisa meninggalkan Nonna.
Dialogue: 0,0:12:01.24,0:12:04.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nonna juga bisa ikut!
Dialogue: 0,0:12:04.81,0:12:06.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau kalau bersama Vicky.
Dialogue: 0,0:12:06.83,0:12:08.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah diputuskan, ya!
Dialogue: 0,0:12:14.66,0:12:15.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo.
Dialogue: 0,0:12:15.88,0:12:19.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namaku Clark Anderson.
Dialogue: 0,0:12:19.91,0:12:22.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo, namaku Victoria Sellers.
Dialogue: 0,0:12:22.80,0:12:24.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia Nonna.
Dialogue: 0,0:12:25.46,0:12:26.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namaku Nonna.
Dialogue: 0,0:12:27.14,0:12:30.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya Eva ingin aku mengajarimu\Nbahasa Hagl dan bahasa Randall.
Dialogue: 0,0:12:30.83,0:12:33.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Victoria, kamu bisa kedua bahasa itu?
Dialogue: 0,0:12:33.94,0:12:36.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, untuk percakapan sehari-hari.
Dialogue: 0,0:12:37.65,0:12:39.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sama sekali tidak bisa.
Dialogue: 0,0:12:39.72,0:12:41.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayahku seorang Menteri Luar Negeri,
Dialogue: 0,0:12:41.74,0:12:44.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}beliau menuntutku harus bisa menguasainya.
Dialogue: 0,0:12:44.74,0:12:46.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku kesulitan.
Dialogue: 0,0:12:46.87,0:12:49.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga kurang mahir olahraga.
Dialogue: 0,0:12:49.08,0:12:52.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga tidak punya keahlian.
Dialogue: 0,0:12:52.82,0:12:55.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, ada hal yang kamu sukai?
Dialogue: 0,0:12:56.96,0:12:58.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku suka buku.
Dialogue: 0,0:12:59.17,0:13:01.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, latihan fisik.
Dialogue: 0,0:13:01.18,0:13:02.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Latihan fisik?
Dialogue: 0,0:13:02.34,0:13:03.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:13:04.58,0:13:06.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memanjat tembok yang sangat tinggi,
Dialogue: 0,0:13:06.35,0:13:07.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu memanjat pohon.
Dialogue: 0,0:13:14.19,0:13:15.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}He-Hebat!
Dialogue: 0,0:13:15.73,0:13:17.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal kamu perempuan.
Dialogue: 0,0:13:17.19,0:13:19.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru karena perempuan.
Dialogue: 0,0:13:19.49,0:13:21.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau diserang orang jahat,
Dialogue: 0,0:13:21.84,0:13:25.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}harus bisa kabur dengan kekuatan sendiri.
Dialogue: 0,0:13:26.79,0:13:28.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bisa itu, kami tak akan cemas.
Dialogue: 0,0:13:29.31,0:13:32.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dengar itu dari guru bela diriku.
Dialogue: 0,0:13:33.19,0:13:34.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga...
Dialogue: 0,0:13:35.86,0:13:38.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga mau belajar latihan fisik!
Dialogue: 0,0:13:39.24,0:13:40.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:13:40.56,0:13:42.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, kita akan belajar bahasa Randall
Dialogue: 0,0:13:42.55,0:13:44.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sambil peregangan.
Dialogue: 0,0:13:44.87,0:13:46.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luruskan lenganmu!
Dialogue: 0,0:13:46.51,0:13:52.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taf, hank, alum.
Dialogue: 0,0:13:53.30,0:13:55.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah latihan fisik, kita akan menulis.
Dialogue: 0,0:13:55.65,0:13:57.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu langsung lakukan hafalan.
Dialogue: 0,0:13:57.48,0:14:00.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Clark, sempurna.
Dialogue: 0,0:14:00.19,0:14:01.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guru.
Dialogue: 0,0:14:01.45,0:14:05.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini pertama kalinya aku mengikuti\Nkelas bahasa asing yang seru begini.
Dialogue: 0,0:14:07.58,0:14:10.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini pekerjaan yang menarik.
Dialogue: 0,0:14:10.25,0:14:13.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untungnya Nonna juga tertarik\Npada bahasa asing.
Dialogue: 0,0:14:14.44,0:14:15.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Clark juga.
Dialogue: 0,0:14:15.67,0:14:17.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan adanya gadis yang lebih muda,
Dialogue: 0,0:14:18.01,0:14:20.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}itu memicu harga dirinya sebagai laki-laki.
Dialogue: 0,0:14:20.69,0:14:21.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Vicky.
Dialogue: 0,0:14:23.74,0:14:25.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin lebih banyak latihan fisik
Dialogue: 0,0:14:25.51,0:14:27.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan membuat Clark kaget.
Dialogue: 0,0:14:29.96,0:14:30.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah.
Dialogue: 0,0:14:30.91,0:14:33.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya harga diri\Ngadis kecil juga terpicu, ya?
Dialogue: 0,0:14:49.49,0:14:53.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Vicky, apa bahasa Randall memanjat tembok?
Dialogue: 0,0:15:03.62,0:15:06.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bisa pulang duluan?
Dialogue: 0,0:15:06.15,0:15:08.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lari sekuat tenaga ke rumah\Nlalu kunci pintunya.
Dialogue: 0,0:15:08.96,0:15:10.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa?
Dialogue: 0,0:15:24.30,0:15:25.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada perlu apa denganku?
Dialogue: 0,0:15:30.93,0:15:32.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh.
Dialogue: 0,0:15:34.40,0:15:36.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata ketahuan.
Dialogue: 0,0:15:36.04,0:15:41.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aura orang ini berbeda dengan pembunuh\Nyang terbiasa membunuh.
Dialogue: 0,0:15:55.71,0:15:56.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sebenarnya siapa?
Dialogue: 0,0:15:57.89,0:15:59.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entahlah.
Dialogue: 0,0:16:03.01,0:16:04.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin mengobrol.
Dialogue: 0,0:16:04.57,0:16:05.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Turunlah ke sini.
Dialogue: 0,0:16:06.56,0:16:07.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menolak.
Dialogue: 0,0:16:07.86,0:16:11.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku betulan hanya ingin mengobrol.
Dialogue: 0,0:16:20.63,0:16:23.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gerakan dia cukup lincah.
Dialogue: 0,0:16:23.63,0:16:25.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kebetulan.
Dialogue: 0,0:16:25.30,0:16:26.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, majulah.
Dialogue: 0,0:16:26.51,0:16:26.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku...
Dialogue: 0,0:16:47.09,0:16:49.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu menyembunyikan pisau\Ndi balik baju, kan?
Dialogue: 0,0:16:52.24,0:16:56.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku boleh menyerangmu\Ndengan pisau, kan?
Dialogue: 0,0:16:57.35,0:16:58.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu.
Dialogue: 0,0:16:58.41,0:16:59.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pisau ini untuk melindungi diri.
Dialogue: 0,0:16:59.75,0:17:01.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak berniat menyerangmu.
Dialogue: 0,0:17:01.21,0:17:03.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pikir aku akan percaya?
Dialogue: 0,0:17:05.99,0:17:10.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kutunjukkan padamu akibatnya\Nkalau mendekatiku dengan pisau.
Dialogue: 0,0:17:11.89,0:17:13.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku minta maaf!
Dialogue: 0,0:17:17.23,0:17:19.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malam ini aku harus siaga\Nkalau ada yang menyerang.
Dialogue: 0,0:17:29.34,0:17:32.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemarin, ada pria aneh muncul.
Dialogue: 0,0:17:32.97,0:17:35.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berhasil mengalahkannya.
Dialogue: 0,0:17:42.97,0:17:45.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi karena sebelumnya sudah diawasi,
Dialogue: 0,0:17:45.86,0:17:47.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku sebaiknya meninggalkan ibu kota ini.
Dialogue: 0,0:17:48.99,0:17:52.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak terluka saja\Nsudah membuatku lega.
Dialogue: 0,0:17:53.04,0:17:56.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kamu berhasil\Nmemukul mundur pria itu?
Dialogue: 0,0:17:56.72,0:18:00.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pernah berlatih sedikit ilmu pedang.
Dialogue: 0,0:18:00.15,0:18:02.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memukul mundur dia\Ndengan ranting pohon.
Dialogue: 0,0:18:02.23,0:18:03.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya?
Dialogue: 0,0:18:03.95,0:18:08.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pria itu mungkin Pangeran Kedua,\NPangeran Cedric.
Dialogue: 0,0:18:10.84,0:18:14.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemarin Pangeran diam-diam\Nmeninggalkan kastel.
Dialogue: 0,0:18:14.25,0:18:17.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat kembali, dua tulang rusuknya patah.
Dialogue: 0,0:18:17.66,0:18:19.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa bisa begini?
Dialogue: 0,0:18:19.69,0:18:22.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga bertanggung jawab\Nmengajarinya ilmu pedang,
Dialogue: 0,0:18:22.90,0:18:25.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi aku tahu bahwa dia cukup kuat.
Dialogue: 0,0:18:33.91,0:18:35.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten.
Dialogue: 0,0:18:35.79,0:18:37.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu bermaksud menangkapku?
Dialogue: 0,0:18:41.27,0:18:46.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau jawabannya tidak memuaskanku,\Naku akan langsung pergi bersama Nonna.
Dialogue: 0,0:18:47.05,0:18:50.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bermaksud menangkapmu.
Dialogue: 0,0:19:07.15,0:19:08.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi,
Dialogue: 0,0:19:08.36,0:19:09.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu masih gelisah, kan?
Dialogue: 0,0:19:15.28,0:19:18.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau untuk sementara\Npindah ke rumah lamaku?
Dialogue: 0,0:19:18.56,0:19:21.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lingkungan di rumah itu selalu sepi.
Dialogue: 0,0:19:21.98,0:19:23.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan posisi kakakku,
Dialogue: 0,0:19:23.35,0:19:25.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia juga lebih mampu\Nmelawan Istana dibandingkan aku.
Dialogue: 0,0:19:27.50,0:19:29.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan mempertimbangkannya.
Dialogue: 0,0:19:32.76,0:19:35.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benar-benar minta maaf, Kakak.
Dialogue: 0,0:19:35.47,0:19:37.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah berjanji pada Jeff
Dialogue: 0,0:19:38.52,0:19:40.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk tidak mengganggunya lagi.
Dialogue: 0,0:19:41.96,0:19:44.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu melakukan hal seperti itu
Dialogue: 0,0:19:44.27,0:19:47.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan dianggap telah mengingkari janji.
Dialogue: 0,0:19:47.04,0:19:48.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Carilah waktu yang tepat
Dialogue: 0,0:19:48.75,0:19:51.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan minta maaf secara langsung\Npada wanita itu.
Dialogue: 0,0:19:51.74,0:19:54.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, aku merasa sangat menyesal.
Dialogue: 0,0:20:03.83,0:20:05.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nonna.
Dialogue: 0,0:20:14.09,0:20:17.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau harus meninggalkan negara ini,
Dialogue: 0,0:20:17.20,0:20:20.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku harus memutuskan kontak\Ndengan orang-orang itu.
Dialogue: 0,0:20:23.20,0:20:26.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga tidak bisa bertemu Kapten lagi.
Dialogue: 0,0:20:26.01,0:20:28.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti dia akan sangat kesepian.
Dialogue: 0,0:20:30.48,0:20:32.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah sejak kapan,
Dialogue: 0,0:20:33.09,0:20:36.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku sudah terikat\Noleh perasaan-perasaan ini.
Dialogue: 0,0:20:40.83,0:20:43.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku punya rekan kerja\Nsaat masih menjadi agen rahasia.
Dialogue: 0,0:20:50.50,0:20:51.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,
Dialogue: 0,0:20:52.80,0:20:55.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tidak perlu kabur dulu, kan?
Dialogue: 0,0:21:00.47,0:21:02.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada urusan apa larut malam begini?
Dialogue: 0,0:21:03.27,0:21:07.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Motif pelaku penyerangan\Ndi jamuan malam sudah diketahui.
Dialogue: 0,0:21:07.48,0:21:10.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin memberitahumu lebih dulu,
Dialogue: 0,0:21:10.16,0:21:12.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi aku datang mengabarimu.
Dialogue: 0,0:21:12.82,0:21:14.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong beri tahu aku.
Dialogue: 0,0:21:15.40,0:21:17.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alasan pelaku melakukan kejahatan itu
Dialogue: 0,0:21:17.92,0:21:22.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena adik perempuannya dilecehkan\Noleh Markis McKenna.
Dialogue: 0,0:21:24.68,0:21:28.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dulu, adik pelaku\Nadalah pelayan di rumah Markis.
Dialogue: 0,0:21:28.91,0:21:31.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah mendengar dia akan menikah,
Dialogue: 0,0:21:31.44,0:21:33.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Markis menjadi tertarik padanya.
Dialogue: 0,0:21:33.73,0:21:35.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertunangannya juga batal karena itu.
Dialogue: 0,0:21:35.44,0:21:39.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia terpukul dan tak bisa keluar rumah.
Dialogue: 0,0:21:39.00,0:21:40.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu perbuatan yang memalukan.
Dialogue: 0,0:21:42.35,0:21:44.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa Markis akan dihukum?
Dialogue: 0,0:21:44.95,0:21:47.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gelarnya diwariskan pada putranya
Dialogue: 0,0:21:47.56,0:21:49.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan dia pergi mengasingkan diri.
Dialogue: 0,0:21:50.81,0:21:52.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana dengan pelakunya?
Dialogue: 0,0:21:54.36,0:21:55.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin akan dihukum mati.
Dialogue: 0,0:21:55.63,0:21:58.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu.
Dialogue: 0,0:22:00.37,0:22:03.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau di negara mana pun,\Nhukum sama saja.
Dialogue: 0,0:22:03.66,0:22:05.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nilai nyawa rakyat biasa dan bangsawan
Dialogue: 0,0:22:05.61,0:22:08.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sangat timpang.
