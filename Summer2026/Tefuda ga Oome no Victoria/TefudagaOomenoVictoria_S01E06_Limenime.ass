Dialogue: 0,0:01:09.34,0:01:14.05,sign,,0000,0000,0000,,VICTORIA OF MANY FACES
Dialogue: 0,0:02:28.00,0:02:30.13,sign,,0000,0000,0000,,KERAJAAN HAGL, LIMA TAHUN LALU
Dialogue: 0,0:03:55.92,0:04:00.51,sign,,0000,0000,0000,,EPISODE 6:\NHARUS MEMIKIRKAN KEBAHAGIAAN ANAK INI
Dialogue: 0,0:00:03.19,0:00:06.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hector sedang mencari wanita berambut merah\Nuntuk diajak menjadi rekan.
Dialogue: 0,0:00:10.95,0:00:11.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh.
Dialogue: 0,0:00:12.81,0:00:14.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu harus berhati-hati.
Dialogue: 0,0:00:14.13,0:00:15.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhati-hati tentang apa?
Dialogue: 0,0:00:20.50,0:00:22.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau butuh bantuan dari Hector lagi,
Dialogue: 0,0:00:22.78,0:00:24.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}biar aku saja yang mengurusnya.
Dialogue: 0,0:00:26.84,0:00:28.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tak akan mengkhianatiku?
Dialogue: 0,0:00:31.26,0:00:35.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu berkunjung lagi karena percaya\Naku tak akan mengkhianatimu, kan,
Dialogue: 0,0:00:35.00,0:00:36.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelanggan?
Dialogue: 0,0:00:36.24,0:00:39.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu mungkin benar, teman baik.
Dialogue: 0,0:00:40.50,0:00:43.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Intinya, jangan gegabah.
Dialogue: 0,0:00:43.48,0:00:46.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu tak berkunjung lagi,\Naku akan kesepian.
Dialogue: 0,0:00:53.73,0:00:55.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini traktir dariku.
Dialogue: 0,0:02:30.13,0:02:32.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten kali ini adalah Mary.
Dialogue: 0,0:02:33.38,0:02:35.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini pertama kali kamu menjadi kapten,\Njadi hati-hati.
Dialogue: 0,0:02:36.39,0:02:37.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, Ketua.
Dialogue: 0,0:02:38.30,0:02:40.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chloe, ikuti mereka dan beri dukungan.
Dialogue: 0,0:02:41.56,0:02:42.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:02:47.96,0:02:51.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chloe, aku dan Hans akan menyusup.
Dialogue: 0,0:02:51.36,0:02:53.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tetap di sini untuk berjaga.
Dialogue: 0,0:02:53.97,0:02:56.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, ini berbeda\Ndengan instruksi Lancome.
Dialogue: 0,0:02:56.49,0:02:58.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kaptennya.
Dialogue: 0,0:02:58.07,0:02:59.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengarkan aku!
Dialogue: 0,0:03:01.03,0:03:03.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, ini misi pertama Hans.
Dialogue: 0,0:03:03.98,0:03:06.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu ingin melanggar\Nperintah Kapten?
Dialogue: 0,0:03:07.04,0:03:08.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan pergi.
Dialogue: 0,0:03:09.21,0:03:11.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chloe, aku akan baik-baik saja.
Dialogue: 0,0:03:13.11,0:03:14.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:03:17.74,0:03:21.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kalau ada bahaya,\Nkamu harus langsung kabur.
Dialogue: 0,0:03:22.04,0:03:23.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paham?
Dialogue: 0,0:03:25.03,0:03:26.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada penyusup!
Dialogue: 0,0:04:00.51,0:04:02.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Vicky, kamu baik-baik saja?
Dialogue: 0,0:04:02.26,0:04:03.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi kamu berteriak keras.
Dialogue: 0,0:04:04.71,0:04:06.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kuteriakkan?
Dialogue: 0,0:04:06.67,0:04:08.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu berteriak, "Jangan!"
Dialogue: 0,0:04:09.75,0:04:12.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, mimpi itu lagi?
Dialogue: 0,0:04:16.68,0:04:17.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hans.
Dialogue: 0,0:04:20.36,0:04:24.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menyaksikan lebih banyak kematian\Ndaripada kebanyakan orang.
Dialogue: 0,0:04:26.35,0:04:28.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lupakan misi yang sudah berakhir.
Dialogue: 0,0:04:29.40,0:04:31.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyesalan hanya akan melukai dirimu.
Dialogue: 0,0:04:32.19,0:04:33.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada saat itu,
Dialogue: 0,0:04:33.59,0:04:35.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku sangat berterima kasih\Natas perkataan itu.
Dialogue: 0,0:04:37.88,0:04:40.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, sekarang sudah berbeda.
Dialogue: 0,0:04:41.26,0:04:43.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau melupakan kematian Hans begitu saja,
Dialogue: 0,0:04:43.18,0:04:47.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan kehilangan sesuatu yang penting\Nsebagai manusia.
Dialogue: 0,0:04:56.48,0:04:58.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Vicky, aku boleh beli ini?
Dialogue: 0,0:04:58.88,0:05:01.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh, mau pilih yang mana?
Dialogue: 0,0:05:01.45,0:05:03.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kupikirkan.
Dialogue: 0,0:05:05.24,0:05:06.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cantik!
Dialogue: 0,0:05:09.33,0:05:13.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga ingin mengajari Nonna\Nbergaul dengan gadis lain,
Dialogue: 0,0:05:13.65,0:05:15.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku sendiri juga tidak paham.
Dialogue: 0,0:05:16.59,0:05:17.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang ini.
Dialogue: 0,0:05:23.04,0:05:24.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, senangnya.
Dialogue: 0,0:05:24.89,0:05:26.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah, Nonna.
Dialogue: 0,0:05:26.72,0:05:29.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerajaan industri memang hebat.
Dialogue: 0,0:05:29.18,0:05:32.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga diam-diam membeli\Nbarang yang kuinginkan.
Dialogue: 0,0:05:32.07,0:05:34.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan ini, aku bisa membuat wig hitam.
Dialogue: 0,0:05:37.65,0:05:38.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Toko ini...
Dialogue: 0,0:05:42.56,0:05:45.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Master, ini enak sekali.
Dialogue: 0,0:05:45.37,0:05:46.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, enak.
Dialogue: 0,0:05:48.16,0:05:49.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan dinikmati.
Dialogue: 0,0:05:49.84,0:05:52.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan yang potongan juga habis?
Dialogue: 0,0:05:52.75,0:05:55.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, kami benar-benar minta maaf.
Dialogue: 0,0:06:00.46,0:06:01.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu.
Dialogue: 0,0:06:01.97,0:06:04.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tak keberatan,\Nmau ambil yang ini?
Dialogue: 0,0:06:05.26,0:06:07.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu yakin memberikannya padaku?
Dialogue: 0,0:06:07.10,0:06:08.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:06:08.01,0:06:10.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini kubeli untuk dijadikan oleh-oleh.
Dialogue: 0,0:06:10.40,0:06:10.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah.
Dialogue: 0,0:06:12.00,0:06:14.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, ada apa?
Dialogue: 0,0:06:14.31,0:06:17.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada.\NTerima kasih banyak.
Dialogue: 0,0:06:21.22,0:06:26.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuharap waktu yang tenang dan bahagia\Nseperti ini bisa terus berlanjut.
Dialogue: 0,0:06:39.67,0:06:41.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudanya tinggi dan besar.
Dialogue: 0,0:06:41.86,0:06:43.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sudah tua.
Dialogue: 0,0:06:44.66,0:06:46.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama sepertiku.
Dialogue: 0,0:06:50.31,0:06:52.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setiap hari lari pagi.\NKerja bagus.
Dialogue: 0,0:06:53.43,0:06:55.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata kamu mengingatku, ya?
Dialogue: 0,0:06:55.10,0:06:57.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, aku suka bangun pagi.
Dialogue: 0,0:06:57.38,0:07:01.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, apa pekerjaan sehari-harimu?
Dialogue: 0,0:07:01.88,0:07:04.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya rakyat biasa\Nyang bekerja sambil membesarkan anak.
Dialogue: 0,0:07:07.81,0:07:09.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu...
Dialogue: 0,0:07:10.24,0:07:12.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namaku Miles Grant.
Dialogue: 0,0:07:12.62,0:07:14.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namaku Victoria Sellers.
Dialogue: 0,0:07:15.29,0:07:17.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Miles, apa pekerjaanmu sehari-hari?
Dialogue: 0,0:07:17.45,0:07:18.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku?
Dialogue: 0,0:07:18.61,0:07:22.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya orang tua\Nyang menikmati waktu luangnya.
Dialogue: 0,0:07:23.59,0:07:25.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kelihatannya tidak begitu.
Dialogue: 0,0:07:25.82,0:07:28.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku seorang veteran militer.
Dialogue: 0,0:07:28.03,0:07:32.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang aku tinggal di belakang kediaman\NNyonya Yolana untuk menikmati masa tua.
Dialogue: 0,0:07:33.27,0:07:34.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rumah yang itu?
Dialogue: 0,0:07:36.10,0:07:38.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudanya sangat baik, ya.
Dialogue: 0,0:07:38.69,0:07:40.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga sebenarnya ingin punya kuda,
Dialogue: 0,0:07:40.51,0:07:43.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi karena tinggal di rumah sewa,\Nsulit untuk memeliharanya.
Dialogue: 0,0:07:43.51,0:07:45.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bisa menunggang kuda?
Dialogue: 0,0:07:45.61,0:07:46.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa.
Dialogue: 0,0:07:46.61,0:07:49.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para kakakku pernah menjadi tentara\Ndan mengajariku.
Dialogue: 0,0:07:52.24,0:07:54.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau aku yang merawat kudanya?
Dialogue: 0,0:07:54.94,0:07:56.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu yakin?
Dialogue: 0,0:07:56.33,0:07:58.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan memilih kuda yang bagus untukmu.
Dialogue: 0,0:07:58.79,0:08:00.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ingin kuda seperti apa?
Dialogue: 0,0:08:00.04,0:08:01.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu...
Dialogue: 0,0:08:01.29,0:08:05.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bisa, kuda yang bisa\Nmembawaku dan putriku
Dialogue: 0,0:08:05.05,0:08:06.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk perjalanan jauh.
Dialogue: 0,0:08:07.05,0:08:10.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja, aku akan membayar\Nbiaya perawatannya.
Dialogue: 0,0:08:10.16,0:08:11.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan segera menyiapkannya.
Dialogue: 0,0:08:14.81,0:08:18.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang aku punya tunggangan\Nuntuk kabur kalau diperlukan.
Dialogue: 0,0:08:20.09,0:08:21.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kondisi lukamu?
Dialogue: 0,0:08:22.31,0:08:24.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sakitnya sudah hampir tidak terasa.
Dialogue: 0,0:08:24.73,0:08:26.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf sudah membuat Anda khawatir.
Dialogue: 0,0:08:26.77,0:08:29.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Claudia sudah menanganinya.
Dialogue: 0,0:08:29.09,0:08:31.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak perlu khawatir tentang hal itu.
Dialogue: 0,0:08:31.47,0:08:33.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, Ayahanda.
Dialogue: 0,0:08:34.03,0:08:37.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, pendamping Jeffrey\Ndi jamuan malam itu,
Dialogue: 0,0:08:37.83,0:08:39.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa sudah selesai diselidiki?
Dialogue: 0,0:08:40.78,0:08:43.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah menyuruh orang\Nuntuk menyelidikinya.
Dialogue: 0,0:08:43.04,0:08:46.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia hanya warga biasa Kerajaan Randall.
Dialogue: 0,0:08:50.38,0:08:52.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi dia warga biasa?
Dialogue: 0,0:08:53.39,0:08:56.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyelidik Ayahanda tak bisa diandalkan, ya.
Dialogue: 0,0:09:12.26,0:09:13.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hai.
Dialogue: 0,0:09:13.49,0:09:15.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Sellers, lama tidak berjumpa.
Dialogue: 0,0:09:17.75,0:09:19.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata orang itu.
Dialogue: 0,0:09:20.73,0:09:23.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini aku ingin minta maaf padamu.
Dialogue: 0,0:09:25.04,0:09:26.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ilmu bela dirimu sungguh luar biasa.
Dialogue: 0,0:09:27.30,0:09:30.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pantas saja bisa menjatuhkan pria\Ndi jamuan malam.
Dialogue: 0,0:09:30.01,0:09:32.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mengerti\Nmaksud perkataan Pangeran.
Dialogue: 0,0:09:33.71,0:09:36.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan berbicara\Nseolah-olah aku berniat jahat.
Dialogue: 0,0:09:37.06,0:09:39.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini aku datang untuk meminta maaf\Npadamu dengan tulus.
Dialogue: 0,0:09:42.77,0:09:43.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benar-benar minta maaf.
Dialogue: 0,0:09:43.98,0:09:45.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pangeran, tolong hentikan!
Dialogue: 0,0:09:45.94,0:09:48.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya rakyat biasa dari negara lain.
Dialogue: 0,0:09:49.22,0:09:50.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu memaafkanku?
Dialogue: 0,0:09:50.71,0:09:52.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, tentu saja.
Dialogue: 0,0:09:52.66,0:09:54.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah.
Dialogue: 0,0:09:54.11,0:09:58.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jeffrey bahkan melarangku mendekatimu.
Dialogue: 0,0:09:58.70,0:10:01.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rahasiakan juga kedatanganku darinya, ya.
Dialogue: 0,0:10:02.31,0:10:04.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, aku ingin meminta bantuanmu.
Dialogue: 0,0:10:05.36,0:10:08.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu bisa mengajariku ilmu bela diri?
Dialogue: 0,0:10:08.45,0:10:10.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja, aku akan membayarmu.
Dialogue: 0,0:10:15.24,0:10:16.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini aku, Jeffrey.
Dialogue: 0,0:10:18.51,0:10:21.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar Pangeran Cedric datang menemuimu.
Dialogue: 0,0:10:22.64,0:10:25.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten sudah mengetahuinya, Pangeran.
Dialogue: 0,0:10:29.19,0:10:32.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pangeran bilang ingin aku\Nmengajarinya ilmu bela diri.
Dialogue: 0,0:10:33.32,0:10:34.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, bagaimana jawabanmu?
Dialogue: 0,0:10:35.45,0:10:36.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menolaknya.
Dialogue: 0,0:10:37.44,0:10:39.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku sudah memberitahunya.
Dialogue: 0,0:10:39.81,0:10:42.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan bicara dengannya lagi besok.
Dialogue: 0,0:10:44.44,0:10:45.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Victoria?
Dialogue: 0,0:10:48.50,0:10:51.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak memintamu melakukan itu.
Dialogue: 0,0:10:51.27,0:10:52.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku tetap ingin membantumu.
Dialogue: 0,0:10:55.53,0:10:58.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau terus bergantung pada seseorang\Nlalu suatu hari mereka pergi,
Dialogue: 0,0:10:58.37,0:10:59.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku pasti akan sangat sedih.
Dialogue: 0,0:11:00.44,0:11:02.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sendiri yang akan menolak Pangeran,
Dialogue: 0,0:11:02.68,0:11:04.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi jangan cemas
Dialogue: 0,0:11:04.96,0:11:07.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau hal seperti ini\Nharus minta bantuannya,
Dialogue: 0,0:11:07.61,0:11:10.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}suatu hari nanti\Nakan membuat masalah untuknya.
Dialogue: 0,0:11:11.36,0:11:13.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku tidak akan meninggalkanmu.
Dialogue: 0,0:11:14.35,0:11:15.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku...
Dialogue: 0,0:11:15.69,0:11:18.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ingin menangani masalahku sendiri.
Dialogue: 0,0:11:19.16,0:11:22.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama ini aku sudah menerima\Nberbagai bantuan dari Kapten,
Dialogue: 0,0:11:23.73,0:11:26.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku tetap ingin\Nmenyelesaikannya sendiri.
Dialogue: 0,0:11:26.65,0:11:28.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu pun masalah dengan Pangeran.
Dialogue: 0,0:11:28.54,0:11:29.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu khawatir.
Dialogue: 0,0:11:32.25,0:11:33.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Vicky.
Dialogue: 0,0:11:34.37,0:11:36.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sedang marah?
Dialogue: 0,0:11:37.84,0:11:40.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak marah pada siapa pun.
Dialogue: 0,0:11:40.05,0:11:41.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan cemas, Nonna.
Dialogue: 0,0:11:49.21,0:11:50.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:11:51.22,0:11:54.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, jangan tersenyum\Ndengan ekspresi sedih.
Dialogue: 0,0:11:56.76,0:12:01.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa ceritakan padaku\Nhal apa yang kamu takuti sekarang?
Dialogue: 0,0:12:12.07,0:12:14.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Nonna.
Dialogue: 0,0:12:14.00,0:12:15.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah saatnya istirahat.
Dialogue: 0,0:12:24.67,0:12:26.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten.
Dialogue: 0,0:12:28.92,0:12:31.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa cerita\Nhal yang kutakuti sekarang.
Dialogue: 0,0:12:32.30,0:12:33.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:12:34.76,0:12:35.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:12:36.97,0:12:39.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu juga punya masalahmu sendiri.
Dialogue: 0,0:12:39.51,0:12:42.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, aku harusnya\Ntak membuatmu banyak pikiran.
Dialogue: 0,0:12:42.80,0:12:43.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:12:44.40,0:12:46.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga merasa bersalah.
Dialogue: 0,0:12:49.50,0:12:50.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu...
Dialogue: 0,0:12:51.36,0:12:53.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau minum anggur?
Dialogue: 0,0:12:54.07,0:12:56.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, tentu.
Dialogue: 0,0:12:58.91,0:13:00.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dulu,
Dialogue: 0,0:13:00.78,0:13:04.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tidak bisa menjadi sandaran\Nuntuk tunanganku di momen penting.
Dialogue: 0,0:13:04.75,0:13:07.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin keinginanku melindungi\Norang yang berharga
Dialogue: 0,0:13:07.14,0:13:09.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menjadi terlalu kuat karenanya.
Dialogue: 0,0:13:10.14,0:13:11.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunangan?
Dialogue: 0,0:13:12.00,0:13:13.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi kamu punya tunangan?
Dialogue: 0,0:13:14.67,0:13:16.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ke sini tak akan jadi masalah?
Dialogue: 0,0:13:17.38,0:13:20.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sudah tidak ada di dunia ini lagi.
Dialogue: 0,0:13:21.03,0:13:23.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepuluh tahun lalu,\Ndia memilih untuk mengakhiri hidupnya.
Dialogue: 0,0:13:25.27,0:13:28.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku gagal menyelamatkan dia.
Dialogue: 0,0:13:28.60,0:13:32.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu... Begitu.
Dialogue: 0,0:13:32.82,0:13:34.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi pernah terjadi hal seperti itu.
Dialogue: 0,0:13:35.74,0:13:38.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf malah membuatmu cerita\Nhal yang menyakitkan begini.
Dialogue: 0,0:13:40.34,0:13:41.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya sudah berlalu.
Dialogue: 0,0:13:42.37,0:13:44.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak perlu merasa terbebani.
Dialogue: 0,0:13:50.64,0:13:53.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu ingin melatih ilmu bela diri,
Dialogue: 0,0:13:53.81,0:13:54.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku bisa menjadi lawanmu.
Dialogue: 0,0:13:55.86,0:13:58.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku lebih kuat dari Pangeran.
Dialogue: 0,0:13:59.44,0:14:01.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, aku tidak mau.
Dialogue: 0,0:14:01.69,0:14:02.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:14:03.51,0:14:06.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat latihan, rambutku berantakan\Ndan badanku penuh keringat.
Dialogue: 0,0:14:06.60,0:14:09.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tatapanku juga akan galak\Nsaat menjadi instruktur.
Dialogue: 0,0:14:10.25,0:14:13.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak ingin kamu\Nmelihat diriku yang seperti itu.
Dialogue: 0,0:14:14.07,0:14:17.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini berarti
Dialogue: 0,0:14:17.71,0:14:20.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu menganggapku sebagai pria?
Dialogue: 0,0:14:24.41,0:14:27.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malah tanya balik?\NCari tahu saja sendiri.
Dialogue: 0,0:14:27.24,0:14:28.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten.
Dialogue: 0,0:14:31.79,0:14:34.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana?\NKudanya besar, kan?
Dialogue: 0,0:14:34.67,0:14:36.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Besar! Cantik!
Dialogue: 0,0:14:37.20,0:14:38.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak takut?
Dialogue: 0,0:14:39.15,0:14:40.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak takut.
Dialogue: 0,0:14:40.48,0:14:41.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin segera menungganginya!
Dialogue: 0,0:14:41.97,0:14:44.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak ini pemberani, ya.
Dialogue: 0,0:14:46.20,0:14:48.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu bisa menunggang\Nsampai hutan di depan?
Dialogue: 0,0:14:48.65,0:14:49.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa?
Dialogue: 0,0:14:49.81,0:14:51.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, bisa.
Dialogue: 0,0:14:52.08,0:14:54.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah hampir musimnya juga.
Dialogue: 0,0:14:54.65,0:14:56.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan pergi memungut kastanya.
Dialogue: 0,0:14:56.29,0:14:57.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian lanjut jalan-jalannya.
Dialogue: 0,0:14:57.88,0:14:59.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga mau ikut memungut kastanya.
Dialogue: 0,0:15:01.55,0:15:03.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona, rileks.
Dialogue: 0,0:15:03.51,0:15:05.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aleg bisa ikut tegang juga.
Dialogue: 0,0:15:09.14,0:15:10.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita dapat banyak kastanya.
Dialogue: 0,0:15:10.81,0:15:11.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:15:11.92,0:15:14.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari pulang sebelum langit gelap.
Dialogue: 0,0:15:14.29,0:15:15.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:15:19.57,0:15:21.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aleg kenapa?
Dialogue: 0,0:15:21.23,0:15:23.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya dia ingin berlari kencang.
Dialogue: 0,0:15:23.86,0:15:26.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nonna, bisa tunggu sebentar\Nbersama Miles di sini?
Dialogue: 0,0:15:31.52,0:15:34.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aleg masih muda dan penuh energi.
Dialogue: 0,0:15:34.60,0:15:35.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hati-hati, ya.
Dialogue: 0,0:15:35.54,0:15:36.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:15:36.63,0:15:38.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita pergi, Aleg.
Dialogue: 0,0:15:56.10,0:15:59.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Vicky, kamu keren!
Dialogue: 0,0:16:00.52,0:16:01.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat malam.
Dialogue: 0,0:16:01.92,0:16:04.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pintunya tidak dikunci, silakan masuk.
Dialogue: 0,0:16:05.30,0:16:08.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku buat hidangan dari kastanya,\Ndan ingin berbagi sedikit.
Dialogue: 0,0:16:10.77,0:16:13.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya bisa merebus atau memanggang.
Dialogue: 0,0:16:14.01,0:16:16.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku merebusnya bersama daging perut.
Dialogue: 0,0:16:16.28,0:16:17.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cocok untuk camilan setelah minum.
Dialogue: 0,0:16:17.89,0:16:19.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:16:27.38,0:16:28.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mainan?
Dialogue: 0,0:16:30.45,0:16:33.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bilang hanya seorang rakyat biasa.
Dialogue: 0,0:16:33.51,0:16:37.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ucapan itu bisa menipu orang lain,\Ntapi tak bisa menipu mataku.
Dialogue: 0,0:16:38.48,0:16:42.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga sudah bilang teknik menunggang kudaku\Ndipelajari dari kakakku yang tentara.
Dialogue: 0,0:16:42.86,0:16:45.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini kamu menitipkan anak itu padaku.
Dialogue: 0,0:16:45.98,0:16:47.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu kelalaianmu.
Dialogue: 0,0:16:49.61,0:16:55.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sama sekali tidak bisa menyembunyikan\Nbahwa kamu ahli di bidang tertentu.
Dialogue: 0,0:16:56.25,0:16:59.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu selalu waspada agar tak ada\Nyang mendekat tanpa sepengetahuanmu.
Dialogue: 0,0:16:59.87,0:17:02.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sudah jadi kebiasaan, ya?
Dialogue: 0,0:17:02.57,0:17:06.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, apa yang akan kamu lakukan padaku?
Dialogue: 0,0:17:07.33,0:17:09.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak yang kamu bawa itu,
Dialogue: 0,0:17:10.13,0:17:11.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bukan anak kandungmu, kan?
Dialogue: 0,0:17:13.03,0:17:16.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepanjang hari ini, aku bisa melihat\Nkamu membesarkannya dengan serius.
Dialogue: 0,0:17:17.11,0:17:19.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, sampai mengadopsi anak...
Dialogue: 0,0:17:19.36,0:17:22.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tindakan yang terlalu gegabah.
Dialogue: 0,0:17:23.44,0:17:24.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan menyesal.
Dialogue: 0,0:17:25.67,0:17:27.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkat kehadiran anak itu,
Dialogue: 0,0:17:27.79,0:17:30.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku baru bisa menjalani kehidupan\Nseperti manusia.
Dialogue: 0,0:17:33.06,0:17:34.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, ya.
Dialogue: 0,0:17:34.63,0:17:38.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tipe orang yang membuatku\Nsangat penasaran.
Dialogue: 0,0:17:40.99,0:17:43.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan bilang dulu,
Dialogue: 0,0:17:43.79,0:17:47.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau butuh bantuan,\Ndatanglah padaku.
Dialogue: 0,0:17:47.88,0:17:50.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya aku bisa membantumu\Nmenahan musuh.
Dialogue: 0,0:17:52.37,0:17:53.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa mau membantuku?
Dialogue: 0,0:17:53.47,0:17:57.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum pensiun tapi malah berbaur\Ndengan orang biasa,
Dialogue: 0,0:17:57.35,0:17:59.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bahkan membesarkan seorang anak.
Dialogue: 0,0:18:00.17,0:18:02.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak akan tanya alasannya.
Dialogue: 0,0:18:02.44,0:18:06.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku yang pensiunan ini,\Nhanya ingin membantumu.
Dialogue: 0,0:18:24.07,0:18:26.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa memahami orang itu.
Dialogue: 0,0:18:29.34,0:18:33.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Victoria, kamu kenal Baron Hanson, ya?
Dialogue: 0,0:18:33.84,0:18:35.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baron Hanson?
Dialogue: 0,0:18:36.64,0:18:39.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bilang kamu memberikan\Npai apelmu padanya.
Dialogue: 0,0:18:39.56,0:18:41.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat kalian dan Clark pergi ke pasar, ya?
Dialogue: 0,0:18:43.56,0:18:45.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang dia datang menemuimu.
Dialogue: 0,0:18:45.98,0:18:48.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya ada yang ingin\Ndia bicarakan pada kalian.
Dialogue: 0,0:18:57.12,0:18:59.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya sangat mirip dengan Nonna,
Dialogue: 0,0:18:59.53,0:19:01.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jangan-jangan dia orang tuanya?
Dialogue: 0,0:19:03.69,0:19:05.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat mendengarnya dari pelayan,
Dialogue: 0,0:19:05.81,0:19:07.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku masih setengah percaya.
Dialogue: 0,0:19:07.96,0:19:09.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata betulan mirip.
Dialogue: 0,0:19:09.96,0:19:11.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya?
Dialogue: 0,0:19:11.84,0:19:13.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putriku meninggal
Dialogue: 0,0:19:13.38,0:19:15.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}saat berusia tiga tahun karena sakit.
Dialogue: 0,0:19:15.87,0:19:18.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau anak itu bisa hidup\Nsampai enam tahun...
Dialogue: 0,0:19:19.87,0:19:22.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Parasnya mungkin akan tumbuh seperti ini.
Dialogue: 0,0:19:22.31,0:19:23.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sangat mirip.
Dialogue: 0,0:19:24.06,0:19:25.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, Victoria,
Dialogue: 0,0:19:25.97,0:19:29.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baron Hanson ingin mengadopsi Nonna\Nsebagai putri angkat.
Dialogue: 0,0:19:37.64,0:19:39.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benar-benar minta maaf.
Dialogue: 0,0:19:39.31,0:19:41.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak berniat menyerahkan\Nanak ini pada siapa pun!
Dialogue: 0,0:19:43.65,0:19:46.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Victoria, kuharap kamu bisa\Nmempertimbangkannya lagi.
Dialogue: 0,0:19:46.83,0:19:48.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar saat ini kamu masih lajang
Dialogue: 0,0:19:48.75,0:19:51.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan bekerja sambil membesarkan anak ini.
Dialogue: 0,0:19:51.99,0:19:53.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dia menjadi putri angkat kami,
Dialogue: 0,0:19:53.86,0:19:57.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu tak perlu khawatir lagi soal keuangan.
Dialogue: 0,0:19:57.37,0:19:59.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Vicky, kalian sedang bahas apa?
Dialogue: 0,0:20:00.45,0:20:04.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka bertanya apa kamu bisa\Nmenjadi anak keluarga Baron.
Dialogue: 0,0:20:04.93,0:20:05.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:20:05.56,0:20:07.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau.
Dialogue: 0,0:20:07.02,0:20:11.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak kecil belum paham\Npentingnya keuangan.
Dialogue: 0,0:20:11.11,0:20:13.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja dia ingin bersama\Norang yang dikenalnya.
Dialogue: 0,0:20:14.47,0:20:18.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang dewasa harus memikirkan\Nkebahagiaan anak.
Dialogue: 0,0:20:18.03,0:20:19.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau terjadi sesuatu padamu,
Dialogue: 0,0:20:19.53,0:20:21.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}anak ini akan telantar di jalanan, kan?
Dialogue: 0,0:20:23.74,0:20:27.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku tidak bisa bekerja,\Nsituasi itu akan terjadi.
Dialogue: 0,0:20:29.29,0:20:30.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nonna.
Dialogue: 0,0:20:31.04,0:20:31.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana?
Dialogue: 0,0:20:31.92,0:20:35.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau coba tinggal di rumah kami\Nselama seminggu?
Dialogue: 0,0:20:35.05,0:20:36.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:20:36.30,0:20:38.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan memesankan gaun untukmu,
Dialogue: 0,0:20:38.63,0:20:42.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}juga akan membeli perhiasan\Nyang cocok dengan matamu yang indah itu.
Dialogue: 0,0:20:43.93,0:20:45.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baron Hanson.
Dialogue: 0,0:20:45.35,0:20:47.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nonna adalah anak yang sangat aktif.
Dialogue: 0,0:20:47.48,0:20:49.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa metode pendidikan\Ndan tata krama bangsawan
Dialogue: 0,0:20:49.85,0:20:51.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin tidak cocok untuknya.
Dialogue: 0,0:20:51.93,0:20:55.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan saja bagian itu pada kami.
Dialogue: 0,0:20:55.59,0:20:58.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asalkan tinggal di rumah kami\Nselama seminggu dulu,
Dialogue: 0,0:20:58.97,0:21:01.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}anak ini pasti akan berubah pikiran.
Dialogue: 0,0:21:02.45,0:21:04.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolaklah dengan tegas.
Dialogue: 0,0:21:05.95,0:21:07.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Izinkan aku mengatakannya lagi,
Dialogue: 0,0:21:07.87,0:21:09.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- aku...\N- Apa tinggal seminggu sudah cukup?
Dialogue: 0,0:21:13.11,0:21:14.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau enam hari saja?
Dialogue: 0,0:21:22.44,0:21:23.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enam hari sudah cukup.
Dialogue: 0,0:21:23.85,0:21:25.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seminggu juga tidak apa-apa.
Dialogue: 0,0:21:26.01,0:21:27.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu anak yang pintar, ya.
Dialogue: 0,0:21:27.56,0:21:29.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat senang, Nonna.
Dialogue: 0,0:21:29.85,0:21:31.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nonna?
Dialogue: 0,0:21:31.24,0:21:32.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:21:33.65,0:21:35.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku tidak ingin tinggal\Nsetelah enam hari,
Dialogue: 0,0:21:35.86,0:21:37.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku boleh menolak?
Dialogue: 0,0:21:37.11,0:21:38.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja.
Dialogue: 0,0:21:38.88,0:21:41.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, kalau sudah diputuskan,
Dialogue: 0,0:21:41.15,0:21:43.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa bisa mulai menginap malam ini?
Dialogue: 0,0:21:43.77,0:21:44.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa.
Dialogue: 0,0:21:45.91,0:21:48.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bisa membelikan gaun untuk anak ini.
Dialogue: 0,0:21:48.66,0:21:50.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayang, aku seperti sedang bermimpi.
Dialogue: 0,0:21:50.71,0:21:51.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar!
Dialogue: 0,0:21:51.96,0:21:54.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat perjalanan pulang,\Nkita bisa belanja sepuasnya.
