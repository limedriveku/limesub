Dialogue: 0,0:00:00.23,0:00:01.60,sign,,0000,0000,0000,,KERAJAAN ASHBURY
Dialogue: 0,0:00:01.60,0:00:04.03,sign,,0000,0000,0000,,WILAYAH ADIPATI DI DEKAT HAYDN
Dialogue: 0,0:01:24.31,0:01:28.99,sign,,0000,0000,0000,,VICTORIA OF MANY FACES
Dialogue: 0,0:02:43.31,0:02:46.77,sign,,0000,0000,0000,,KERAJAAN RANDALL, DESA NELAYAN ALDE
Dialogue: 0,0:02:59.03,0:03:01.04,sign,,0000,0000,0000,,EPISODE 9:\NTIDAK PEDULI APA YANG TERJADI NANTI
Dialogue: 0,0:05:11.04,0:05:15.29,sign,,0000,0000,0000,,HARI FESTIVAL CADIZ
Dialogue: 0,0:00:01.60,0:00:02.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pangeran Cedric,
Dialogue: 0,0:00:02.94,0:00:04.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anda tampak bersemangat.
Dialogue: 0,0:00:04.03,0:00:06.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah bukan pangeran lagi.
Dialogue: 0,0:00:06.00,0:00:09.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah waktunya aku bekerja\Ndengan serius untuk negara.
Dialogue: 0,0:00:10.49,0:00:11.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:00:11.41,0:00:13.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak memercayaiku?
Dialogue: 0,0:00:13.62,0:00:15.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini wilayah yang harus kukelola
Dialogue: 0,0:00:15.29,0:00:18.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebagai adipati setelah Kakak\Nmenduduki takhta.
Dialogue: 0,0:00:19.58,0:00:23.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi kupikir tak ada salahnya\Nuntuk menetap lebih awal.
Dialogue: 0,0:00:25.36,0:00:27.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kuperkenalkan tunanganku padamu.
Dialogue: 0,0:00:27.17,0:00:29.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Beatrice.
Dialogue: 0,0:00:30.58,0:00:32.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lama tidak jumpa.
Dialogue: 0,0:00:33.51,0:00:34.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Beatrice?
Dialogue: 0,0:00:34.72,0:00:37.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jeffrey, kamu pangling, kan?
Dialogue: 0,0:00:38.33,0:00:41.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah dengar aku ke sini sebagai adipati,\Ndia langsung datang menemuiku.
Dialogue: 0,0:00:41.73,0:00:44.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, Nona Beatrice...
Dialogue: 0,0:00:44.23,0:00:47.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, aku pernah membatalkan pertunangan.
Dialogue: 0,0:00:47.69,0:00:51.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, ternyata aku tetap tak bisa\Nmelupakan Pangeran.
Dialogue: 0,0:00:51.53,0:00:53.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu.
Dialogue: 0,0:00:53.56,0:00:54.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat.
Dialogue: 0,0:00:55.69,0:00:58.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai sekarang, aku akan bekerja\Ndengan serius dan penuh waspada.
Dialogue: 0,0:00:59.19,0:01:01.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada banyak orang\Nyang keluar masuk wilayah ini
Dialogue: 0,0:01:01.65,0:01:05.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan acara besar rutin yang diadakan\Nadalah Festival Musim Panas Cadiz.
Dialogue: 0,0:01:05.31,0:01:06.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luar biasa, Pangeran.
Dialogue: 0,0:01:06.96,0:01:10.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Sudah kubilang, aku bukan lagi Pangeran.\N- Festival Musim Panas Cadiz, ya?
Dialogue: 0,0:02:46.77,0:02:47.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf membuat kalian menunggu.
Dialogue: 0,0:02:47.98,0:02:49.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kuantar kalian berdua ke meja.
Dialogue: 0,0:02:50.78,0:02:52.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini untuk meja nomor tiga, ya.
Dialogue: 0,0:02:52.96,0:02:53.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meja yang itu?
Dialogue: 0,0:02:53.78,0:02:56.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Benar.\N- Nona, kami juga tambah.
Dialogue: 0,0:02:57.10,0:02:58.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:03:01.04,0:03:05.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kehadiran orang yang energik sepertimu\Nsangat membantu kami.
Dialogue: 0,0:03:05.86,0:03:07.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, aku yang harus berterima kasih.
Dialogue: 0,0:03:07.79,0:03:10.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anda bahkan menyediakan kamar\Nuntuk anakku juga.
Dialogue: 0,0:03:10.61,0:03:11.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya, Maria.
Dialogue: 0,0:03:11.96,0:03:15.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal selendang yang kamu berikan\Nuntukku sebelumnya,
Dialogue: 0,0:03:15.00,0:03:18.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisakah merajut satu lagi untuk putriku?\NAku akan membayarmu.
Dialogue: 0,0:03:18.30,0:03:19.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:03:19.64,0:03:21.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan senang hati kuterima pekerjaannya.
Dialogue: 0,0:03:21.56,0:03:24.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah Festival Musim Panas Cadiz\Nminggu depan berakhir,
Dialogue: 0,0:03:24.73,0:03:27.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}cuaca akan segera menjadi dingin.
Dialogue: 0,0:03:27.96,0:03:29.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cadiz?
Dialogue: 0,0:03:29.46,0:03:30.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu belum pernah ke sana?
Dialogue: 0,0:03:30.96,0:03:32.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan ada banyak orang yang hadir,
Dialogue: 0,0:03:32.78,0:03:34.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}juga akan ada banyak kios, sangat ramai.
Dialogue: 0,0:03:35.43,0:03:37.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, itu di negara lain.
Dialogue: 0,0:03:37.91,0:03:41.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya pada hari itu saja,\Nakan ada kapal dari sini menuju Cadiz.
Dialogue: 0,0:03:43.04,0:03:44.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena ini kapal dadakan,
Dialogue: 0,0:03:44.88,0:03:46.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tak perlu melewati pos pemeriksaan
Dialogue: 0,0:03:46.54,0:03:48.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan bisa ke Ashbury dengan mudah.
Dialogue: 0,0:03:48.90,0:03:50.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Festival?
Dialogue: 0,0:03:50.86,0:03:52.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:03:52.21,0:03:53.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin pergi.
Dialogue: 0,0:03:53.21,0:03:55.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu, aku ingin pergi!
Dialogue: 0,0:03:59.08,0:04:00.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:04:00.35,0:04:01.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita pergi bersama.
Dialogue: 0,0:04:01.40,0:04:02.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:04:03.47,0:04:05.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hore!
Dialogue: 0,0:04:08.04,0:04:09.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa Kapten
Dialogue: 0,0:04:09.59,0:04:12.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}masih ingat dengan janji hari itu?
Dialogue: 0,0:04:13.84,0:04:16.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski bertemu dengan Kapten sekarang,
Dialogue: 0,0:04:16.45,0:04:19.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku juga tak bisa kembali\Nke kehidupan semula lagi.
Dialogue: 0,0:04:22.01,0:04:27.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak kapan aku mulai memikirkan\Nhal tak masuk akal seperti ini?
Dialogue: 0,0:04:30.63,0:04:33.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pasti hanya kelelahan.
Dialogue: 0,0:04:33.00,0:04:35.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi sulit berpikir jernih.
Dialogue: 0,0:04:39.66,0:04:42.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal sudah terbebas dari organisasi,
Dialogue: 0,0:04:42.87,0:04:44.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}malah sangat kesepian dan menderita.
Dialogue: 0,0:04:45.71,0:04:48.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sudut hati kecilku,\Nyang seperti anak polos,
Dialogue: 0,0:04:48.20,0:04:52.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}terus berteriak, "Aku sangat kesepian."
Dialogue: 0,0:04:53.76,0:04:56.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku kembali ke organisasi,
Dialogue: 0,0:04:56.00,0:04:58.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa perasaan ini akan hilang?
Dialogue: 0,0:04:59.26,0:05:00.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi,
Dialogue: 0,0:05:02.56,0:05:05.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tak bisa membiarkan Nonna\Nmendekati tempat seperti itu.
Dialogue: 0,0:05:06.02,0:05:08.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya aku sadar itu.
Dialogue: 0,0:05:17.49,0:05:19.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa Kapten
Dialogue: 0,0:05:19.05,0:05:22.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}masih ingat dengan janji\Ntidak penting hari itu?
Dialogue: 0,0:05:24.66,0:05:25.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan.
Dialogue: 0,0:05:25.95,0:05:29.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah kabur tanpa kabar.\NJangan berharap hal egois.
Dialogue: 0,0:05:31.56,0:05:33.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu, lihat.
Dialogue: 0,0:05:34.63,0:05:36.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat menantikan festival Cadiz.
Dialogue: 0,0:05:50.86,0:05:53.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan orang sebanyak ini,\Nmustahil bisa menemukan seseorang.
Dialogue: 0,0:05:54.39,0:05:55.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:05:55.59,0:05:58.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa aku malah pasrah\Nberanggapan tak akan bertemu?
Dialogue: 0,0:06:02.51,0:06:03.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu, lihat.
Dialogue: 0,0:06:14.35,0:06:19.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misi kita adalah memastikan festival hari ini\Nberakhir dengan aman dan lancar.
Dialogue: 0,0:06:19.88,0:06:21.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetap harus lapor meski ada insiden kecil.
Dialogue: 0,0:06:21.93,0:06:22.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:06:27.31,0:06:30.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu, ini sangat manis dan enak!
Dialogue: 0,0:06:31.98,0:06:33.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:06:33.65,0:06:35.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada krim menempel di mulutmu.
Dialogue: 0,0:06:41.49,0:06:43.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nonna, terima kasih.
Dialogue: 0,0:06:43.67,0:06:45.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari sudah makin sore.
Dialogue: 0,0:06:45.72,0:06:47.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada kapal lagi yang datang.
Dialogue: 0,0:06:54.19,0:06:56.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemandangan dari atas jembatan\Nsepertinya bagus.
Dialogue: 0,0:06:57.51,0:06:58.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo ke sana.
Dialogue: 0,0:07:05.05,0:07:06.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak apa-apa?
Dialogue: 0,0:07:06.60,0:07:08.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak apa-apa.
Dialogue: 0,0:07:09.52,0:07:12.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih ramai dari yang kubayangkan.
Dialogue: 0,0:07:12.19,0:07:13.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:07:13.20,0:07:15.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keluarga, kekasih, ataupun teman,
Dialogue: 0,0:07:15.75,0:07:18.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}orang-orang yang merindukan\Nmereka yang telah tiada
Dialogue: 0,0:07:18.04,0:07:20.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan datang ke sini setiap tahun.
Dialogue: 0,0:07:21.11,0:07:22.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita patroli di seberang jembatan juga.
Dialogue: 0,0:07:28.80,0:07:30.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat.
Dialogue: 0,0:07:30.30,0:07:31.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hati-hati.
Dialogue: 0,0:07:51.29,0:07:52.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Indah...
Dialogue: 0,0:08:00.13,0:08:01.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hati-hati jalannya.
Dialogue: 0,0:08:20.44,0:08:23.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah, Ibu,
Dialogue: 0,0:08:23.23,0:08:24.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Emily,
Dialogue: 0,0:08:25.26,0:08:26.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku rindu kalian.
Dialogue: 0,0:08:27.18,0:08:28.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sangat rindu.
Dialogue: 0,0:08:30.26,0:08:32.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama ini aku terus berusaha,
Dialogue: 0,0:08:33.02,0:08:35.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku sudah mulai lelah.
Dialogue: 0,0:08:46.70,0:08:48.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu?
Dialogue: 0,0:08:51.15,0:08:53.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Nonna.
Dialogue: 0,0:08:54.71,0:08:56.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak apa-apa.
Dialogue: 0,0:08:58.67,0:09:02.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.\NIbu boleh menangis.
Dialogue: 0,0:09:13.28,0:09:15.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya kuserahkan pada kalian.
Dialogue: 0,0:09:15.10,0:09:17.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan bersiaga di markas.
Dialogue: 0,0:09:17.12,0:09:18.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:09:31.97,0:09:33.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kancing kain ini...
Dialogue: 0,0:09:49.30,0:09:51.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita beli oleh-oleh sebelum pulang.
Dialogue: 0,0:10:01.08,0:10:02.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jeff!
Dialogue: 0,0:10:02.57,0:10:03.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nonna.
Dialogue: 0,0:10:05.32,0:10:07.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah jadi anak baik?
Dialogue: 0,0:10:13.45,0:10:15.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai aku menemukanmu,
Dialogue: 0,0:10:15.16,0:10:18.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mau berapa kali pun,\Naku akan terus datang ke festival ini.
Dialogue: 0,0:10:18.44,0:10:20.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi tak kusangka\Nakan bertemu di tahun pertama.
Dialogue: 0,0:10:32.05,0:10:33.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini rumahku.
Dialogue: 0,0:10:33.90,0:10:36.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rumah Kapten?
Dialogue: 0,0:10:36.10,0:10:37.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah bukan kapten lagi.
Dialogue: 0,0:10:38.85,0:10:41.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang aku Kepala Keamanan di wilayah ini.
Dialogue: 0,0:10:44.01,0:10:45.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah kamu baik-baik saja.
Dialogue: 0,0:10:46.15,0:10:47.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat mencemaskanmu
Dialogue: 0,0:10:48.36,0:10:50.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sampai berpikir sesuatu terjadi padamu.
Dialogue: 0,0:10:51.70,0:10:53.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf.
Dialogue: 0,0:10:53.34,0:10:56.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, kamu tidak perlu minta maaf.
Dialogue: 0,0:10:56.28,0:10:57.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak ingin kamu minta maaf.
Dialogue: 0,0:11:00.57,0:11:04.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daripada itu, ada banyak hal\Nyang harus kukatakan padamu.
Dialogue: 0,0:11:13.30,0:11:14.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu.
Dialogue: 0,0:11:15.49,0:11:17.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada pasukan pembunuh dari Hagl.
Dialogue: 0,0:11:17.49,0:11:19.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keputusan istana adalah
Dialogue: 0,0:11:20.26,0:11:22.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mengumumkan kematianmu pada publik.
Dialogue: 0,0:11:22.24,0:11:23.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi para petinggi Ashbury
Dialogue: 0,0:11:23.95,0:11:26.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sudah tahu identitas aslimu.
Dialogue: 0,0:11:27.32,0:11:30.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah merepotkan semua orang.
Dialogue: 0,0:11:30.50,0:11:32.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan dipikirkan.
Dialogue: 0,0:11:32.23,0:11:34.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, kamu tak perlu kabur lagi.
Dialogue: 0,0:11:37.58,0:11:40.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke depannya, kamu bisa hidup dengan tenang.
Dialogue: 0,0:11:41.01,0:11:42.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hidup bersamaku di sini.
Dialogue: 0,0:11:45.67,0:11:46.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapten.
Dialogue: 0,0:11:46.92,0:11:48.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Panggil aku Jeff.
Dialogue: 0,0:11:49.30,0:11:51.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jeff, ada satu hal yang ingin\Nkukatakan padamu.
Dialogue: 0,0:11:52.78,0:11:55.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat usia delapan tahun,\Naku masuk pelatihan organisasi,
Dialogue: 0,0:11:55.51,0:11:57.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di sana aku dipaksa membuang nama asliku
Dialogue: 0,0:11:58.41,0:12:01.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan agen rahasia memberi nama aku Chloe.
Dialogue: 0,0:12:02.24,0:12:04.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak saat itu, aku tak pernah\Nmenyebut nama asliku lagi.
Dialogue: 0,0:12:06.79,0:12:09.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nama asliku
Dialogue: 0,0:12:09.03,0:12:10.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah Anna.
Dialogue: 0,0:12:11.84,0:12:12.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anna Dale.
Dialogue: 0,0:12:13.70,0:12:16.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu nama yang diberikan kedua orang tuaku.
Dialogue: 0,0:12:16.44,0:12:18.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nama yang berharga bagiku.
Dialogue: 0,0:12:21.50,0:12:22.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:12:26.12,0:12:29.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, aku juga punya satu rahasia.
Dialogue: 0,0:12:32.67,0:12:36.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena aku berniat\Nuntuk hidup bersamamu seumur hidup,
Dialogue: 0,0:12:36.71,0:12:38.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku harus memberitahumu sekarang.
Dialogue: 0,0:12:41.10,0:12:43.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini rahasia yang hanya diketahui\Noleh aku dan kakakku.
Dialogue: 0,0:12:43.51,0:12:46.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lingkungan tempat kami tumbuh besar\Nsedikit istimewa.
Dialogue: 0,0:12:46.65,0:12:47.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.
Dialogue: 0,0:12:47.90,0:12:51.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutku, aku tidak perlu\Nmengetahui semua masa lalumu.
Dialogue: 0,0:12:53.61,0:12:54.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:12:54.59,0:12:55.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suatu hari nanti,
Dialogue: 0,0:12:55.91,0:13:00.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu pasti akan bertanya-tanya\Nkenapa Kakak begitu mengkhawatirkanku.
Dialogue: 0,0:13:00.95,0:13:02.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan mendengarkan.
Dialogue: 0,0:13:02.87,0:13:04.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain kami, ayahku
Dialogue: 0,0:13:04.69,0:13:06.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}masih punya keluarga lain.
Dialogue: 0,0:13:06.97,0:13:09.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hal ini memang tidak aneh\Ndi kalangan bangsawan,
Dialogue: 0,0:13:09.45,0:13:13.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi sejak dia punya anak\Ndengan kekasihnya,
Dialogue: 0,0:13:15.07,0:13:17.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia mulai memukuli kami.
Dialogue: 0,0:13:18.35,0:13:21.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mental ibuku dengan cepat runtuh.
Dialogue: 0,0:13:22.64,0:13:26.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sementara untuk melindungi Ibu\Ndan aku yang masih kecil,
Dialogue: 0,0:13:26.85,0:13:29.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak pernah melawan Ayah sendirian.
Dialogue: 0,0:13:31.94,0:13:34.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk lari dari kenyataan\Nyang menyakitkan itu,
Dialogue: 0,0:13:34.36,0:13:36.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak belajar dengan gigih,
Dialogue: 0,0:13:36.07,0:13:38.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sedangkan aku mendalami ilmu pedang.
Dialogue: 0,0:13:38.99,0:13:41.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah bertahun-tahun berlalu,
Dialogue: 0,0:13:41.37,0:13:43.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pada suatu hari,
Dialogue: 0,0:13:43.05,0:13:45.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}seperti biasanya, Ayah
Dialogue: 0,0:13:45.11,0:13:47.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ingin mencambuk Kakak.
Dialogue: 0,0:13:56.73,0:13:57.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jeff!
Dialogue: 0,0:13:57.55,0:13:58.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak,
Dialogue: 0,0:13:58.92,0:14:00.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan membunuhnya.
Dialogue: 0,0:14:00.39,0:14:02.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah itu, tolong hapus namaku\Ndari daftar keluarga.
Dialogue: 0,0:14:04.01,0:14:06.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah\Nmelindungi kami selama ini.
Dialogue: 0,0:14:07.54,0:14:10.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat itu, aku benar-benar serius.
Dialogue: 0,0:14:10.54,0:14:13.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai hari ini, aku akan mewarisi
Dialogue: 0,0:14:13.04,0:14:16.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}posisi Kepala Keluarga Asher.
Dialogue: 0,0:14:17.15,0:14:19.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu akan\Nmenyerahkan posisi kepala keluarga
Dialogue: 0,0:14:19.21,0:14:20.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau dibunuh
Dialogue: 0,0:14:21.36,0:14:23.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}oleh kami di sini?
Dialogue: 0,0:14:23.60,0:14:24.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pilihlah sendiri.
Dialogue: 0,0:14:25.54,0:14:28.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak peduli bagaimana cara kematianmu,
Dialogue: 0,0:14:28.71,0:14:33.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku ada dokter yang bersedia menuliskan\Npenyebab kematianmu sebagai serangan jantung.
Dialogue: 0,0:14:37.76,0:14:39.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah sejak kapan, Kakak
Dialogue: 0,0:14:39.11,0:14:41.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sudah memprediksi situasi itu akan terjadi
Dialogue: 0,0:14:41.25,0:14:43.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan menyiapkan langkah penanganannya.
Dialogue: 0,0:14:43.70,0:14:45.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jeff.
Dialogue: 0,0:14:45.20,0:14:47.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah Ayah pergi dari rumah,
Dialogue: 0,0:14:47.18,0:14:48.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sambil menangis, dia bilang
Dialogue: 0,0:14:48.39,0:14:50.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Andai saja aku melakukan ini lebih awal.
Dialogue: 0,0:14:50.56,0:14:54.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku karena selama ini\Ntak punya keberanian."
Dialogue: 0,0:14:55.36,0:14:56.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah itu,
Dialogue: 0,0:14:56.46,0:14:58.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak selalu bertindak sebagai wali
Dialogue: 0,0:14:58.44,0:15:00.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk melindungiku dan Ibu.
Dialogue: 0,0:15:01.88,0:15:04.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dan Kakak tumbuh besar\Ndengan saling mendukung.
Dialogue: 0,0:15:06.08,0:15:09.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada saat itu, kami benar-benar bisa\Nmati dibunuh kapan saja.
Dialogue: 0,0:15:10.00,0:15:12.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi Ayah sudah meninggal\Ndua tahun yang lalu.
Dialogue: 0,0:15:15.42,0:15:17.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski hanya delapan tahun yang singkat,
Dialogue: 0,0:15:18.65,0:15:20.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tetap tahu apa itu kehangatan keluarga,
Dialogue: 0,0:15:21.48,0:15:24.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sementara kamu bahkan\Ntak pernah merasakannya.
Dialogue: 0,0:15:25.68,0:15:31.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Edward dan Jeffrey pernah hidup\Ndi neraka yang bernama keluarga.
Dialogue: 0,0:15:32.77,0:15:34.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jeff,
Dialogue: 0,0:15:34.12,0:15:38.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan mempertaruhkan nyawaku\Nuntuk melindungimu dan Nonna.
Dialogue: 0,0:15:39.11,0:15:41.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita ciptakan keluarga\Nyang bahagia bersama.
Dialogue: 0,0:15:43.24,0:15:46.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harusnya aku yang bilang begitu.
Dialogue: 0,0:15:46.31,0:15:48.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesekali, biarkan aku terlihat keren juga.
Dialogue: 0,0:15:53.64,0:15:54.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anna,
Dialogue: 0,0:15:54.81,0:15:56.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menikahlah denganku.
Dialogue: 0,0:15:58.84,0:16:00.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:16:05.55,0:16:06.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu.
Dialogue: 0,0:16:06.70,0:16:08.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya dia berhasil menemukannya.
Dialogue: 0,0:16:08.75,0:16:12.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama, pastikan keselamatannya dulu.
Dialogue: 0,0:16:12.01,0:16:14.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan lanjut mengurus prosedurnya.
Dialogue: 0,0:16:14.19,0:16:15.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:16:15.69,0:16:19.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sosok yang penting bagi Jeffrey.
Dialogue: 0,0:16:20.22,0:16:22.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benar-benar minta maaf\Nkarena tiba-tiba
Dialogue: 0,0:16:22.34,0:16:23.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}memutuskan untuk berhenti.
Dialogue: 0,0:16:24.56,0:16:27.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini selendang untuk putri Anda.
Dialogue: 0,0:16:27.40,0:16:28.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:16:29.35,0:16:30.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu memberiku upah.
Dialogue: 0,0:16:30.93,0:16:32.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon diterima.
Dialogue: 0,0:16:32.22,0:16:34.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa terjadi sesuatu yang baik?
Dialogue: 0,0:16:34.57,0:16:37.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu bisa bahagia,\Naku tak keberatan.
Dialogue: 0,0:16:38.17,0:16:39.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:16:39.84,0:16:41.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih atas bantuannya.
Dialogue: 0,0:16:44.55,0:16:48.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak memberi tahu\NPangeran Cedric tentang aku?
Dialogue: 0,0:16:48.36,0:16:49.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:16:49.67,0:16:52.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa repot kalau sampai\Nketahuan orang istana.
Dialogue: 0,0:16:53.37,0:16:55.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesuai keinginanmu,
Dialogue: 0,0:16:55.16,0:16:56.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sambil beternak domba,
Dialogue: 0,0:16:56.45,0:16:58.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mari kita jalani hidup yang tenang.
Dialogue: 0,0:17:03.31,0:17:05.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Asher, salam kenal.
Dialogue: 0,0:17:05.97,0:17:07.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namaku Mike.
Dialogue: 0,0:17:09.99,0:17:13.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasukan Kesatria Ketiga\Nsedang memantau pergerakanku, ya?
Dialogue: 0,0:17:13.18,0:17:16.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini untuk memastikan keselamatan Anda.
Dialogue: 0,0:17:16.93,0:17:18.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, apa misimu?
Dialogue: 0,0:17:18.40,0:17:19.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Victoria.
Dialogue: 0,0:17:20.33,0:17:25.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami akan kesulitan kalau ada\Nyang melihatmu ada di wilayah Adipati ini.
Dialogue: 0,0:17:26.33,0:17:30.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai situasinya mereda,\Nkamu harus menyembunyikan keberadaanmu.
Dialogue: 0,0:17:30.39,0:17:32.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah pendapat atasanku.
Dialogue: 0,0:17:33.72,0:17:36.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak tahu siapa atasanmu,
Dialogue: 0,0:17:36.33,0:17:38.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku tak berencana\Nuntuk berpisah dengan Anna.
Dialogue: 0,0:17:39.04,0:17:43.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, solusi terbaiknya adalah\Nkalian berdua pergi ke Negara Shen.
Dialogue: 0,0:17:43.98,0:17:45.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Negara Shen?
Dialogue: 0,0:17:45.74,0:17:50.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu juga tahu, obat-obatan dari Negara Shen\Ndi ujung dataran itu kualitasnya bagus, kan?
Dialogue: 0,0:17:50.95,0:17:52.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuharap Tuan Asher
Dialogue: 0,0:17:52.34,0:17:55.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa pergi ke sana\Nuntuk membantu ekspor obat-obatan.
Dialogue: 0,0:17:55.41,0:17:56.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Obat-obatan.
Dialogue: 0,0:17:57.15,0:17:58.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu.
Dialogue: 0,0:17:58.45,0:18:00.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anna, apa yang ingin kamu lakukan?
Dialogue: 0,0:18:00.97,0:18:02.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutku ini usul yang sangat bagus.
Dialogue: 0,0:18:03.71,0:18:06.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mike, kami bisa membawa Nonna juga, kan?
Dialogue: 0,0:18:06.65,0:18:08.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja.
Dialogue: 0,0:18:08.80,0:18:11.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biaya operasional\Nuntuk kalian bertiga di sana
Dialogue: 0,0:18:11.24,0:18:12.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan ditanggung negara.
Dialogue: 0,0:18:12.65,0:18:15.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Negara yang akan menanggung\Nbiaya kami bertiga?
Dialogue: 0,0:18:16.56,0:18:19.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keluarga Asher mengajukan diri\Nuntuk menanggung semuanya,
Dialogue: 0,0:18:20.40,0:18:22.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi hubungan dengan Negara Shen
Dialogue: 0,0:18:22.00,0:18:25.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebaiknya tidak sepenuhnya\Ndipegang keluarga Asher.
Dialogue: 0,0:18:27.65,0:18:29.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, sekitar dua minggu lagi,
Dialogue: 0,0:18:29.50,0:18:31.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kapal menuju Negara Shen\Nakan tiba di pelabuhan.
Dialogue: 0,0:18:33.91,0:18:35.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mike.
Dialogue: 0,0:18:35.03,0:18:39.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kalian mau membantu orang sepertiku\Nyang pernah jadi agen rahasia negara lain?
Dialogue: 0,0:18:39.36,0:18:40.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sebelumnya pernah...
Dialogue: 0,0:18:40.68,0:18:43.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kamu pernah membantu\Nnapi hukuman mati kabur
Dialogue: 0,0:18:43.42,0:18:46.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan membuat kehebohan di jamuan malam?
Dialogue: 0,0:18:46.93,0:18:47.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:18:48.88,0:18:51.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang seperti dugaan atasanku.
Dialogue: 0,0:18:52.12,0:18:56.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kalau harus menjawab pertanyaanmu,\Naku akan kehilangan pekerjaanku.
Dialogue: 0,0:18:58.28,0:19:03.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya kamu dibutuhkan oleh seseorang\Njauh lebih dari yang kamu bayangkan.
Dialogue: 0,0:19:05.86,0:19:07.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak tahu apa alasannya,
Dialogue: 0,0:19:07.69,0:19:11.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi Pasukan Kesatria Ketiga harusnya\Nmenilai ada untungnya membantuku.
Dialogue: 0,0:19:12.11,0:19:14.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akan pergi ke tempat\Nbernama Negara Shen?
Dialogue: 0,0:19:14.65,0:19:16.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersama Ibu dan Jeff?
Dialogue: 0,0:19:16.59,0:19:18.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, benar.
Dialogue: 0,0:19:18.64,0:19:21.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya saja, ada satu syarat.
Dialogue: 0,0:19:30.80,0:19:31.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nonna.
Dialogue: 0,0:19:32.80,0:19:34.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maukah kamu menjadi putriku?
Dialogue: 0,0:19:34.87,0:19:37.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jeff, kamu mau menjadi ayahku?
Dialogue: 0,0:19:37.57,0:19:39.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:19:39.07,0:19:40.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anna adalah istriku
Dialogue: 0,0:19:40.95,0:19:42.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan juga ibunya Nonna.
Dialogue: 0,0:19:43.35,0:19:44.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh.
Dialogue: 0,0:19:44.41,0:19:45.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus.
Dialogue: 0,0:19:45.97,0:19:48.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai hari ini, kita adalah keluarga.
Dialogue: 0,0:20:02.66,0:20:04.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, Nonna?
Dialogue: 0,0:20:06.29,0:20:07.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Indah, ya.
Dialogue: 0,0:20:07.86,0:20:09.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:20:09.81,0:20:13.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dulu, saat aku sendirian di alun-alun,
Dialogue: 0,0:20:16.85,0:20:19.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebenarnya aku tahu\Nbahwa aku telah ditelantarkan.
Dialogue: 0,0:20:20.06,0:20:21.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada saat itu,
Dialogue: 0,0:20:21.07,0:20:25.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu terus menemaniku\Ndi alun-alun sampai sore, kan?
Dialogue: 0,0:20:28.61,0:20:31.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belum pernah\Nmengucapkan terima kasih padamu.
Dialogue: 0,0:20:33.09,0:20:37.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu itu, aku belum paham\Nbagaimana cara mengungkapkan perasaanku.
Dialogue: 0,0:20:37.01,0:20:39.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski Ibu juga sedang dalam pelarian,
Dialogue: 0,0:20:39.36,0:20:42.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}terima kasih sudah menolongku.
Dialogue: 0,0:20:44.21,0:20:48.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah memanggang\Ndaging domba yang enak untukku.
Dialogue: 0,0:20:48.49,0:20:51.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah membelikanku pita biru.
Dialogue: 0,0:20:56.76,0:20:58.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu.
Dialogue: 0,0:20:58.24,0:21:01.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah menjadi ibuku.
Dialogue: 0,0:21:02.75,0:21:04.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nonna.
Dialogue: 0,0:21:05.39,0:21:07.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak ada anak ini,
Dialogue: 0,0:21:07.10,0:21:09.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin sekarang aku sudah\Nkembali ke organisasi,
Dialogue: 0,0:21:09.96,0:21:11.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan sudah terbunuh.
Dialogue: 0,0:21:15.22,0:21:17.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata kalian ada di sini.
Dialogue: 0,0:21:17.59,0:21:19.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah waktunya masuk.
Dialogue: 0,0:21:19.49,0:21:21.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktunya makan malam.
Dialogue: 0,0:21:21.74,0:21:22.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:21:22.89,0:21:25.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, Ayah.
Dialogue: 0,0:21:25.58,0:21:27.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian tadi mengobrol apa?
Dialogue: 0,0:21:27.68,0:21:28.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rahasia.
Dialogue: 0,0:21:28.68,0:21:30.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:21:30.29,0:21:31.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Merahasiakan sesuatu dariku?
Dialogue: 0,0:21:34.38,0:21:37.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menjalani hidup dengan menyayangi keluarga,
Dialogue: 0,0:21:37.80,0:21:41.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berhubungan baik dalam waktu lama\Ndengan orang-orang yang ditakdirkan,
Dialogue: 0,0:21:41.76,0:21:43.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}membantu orang lain mengatasi masalah,
Dialogue: 0,0:21:43.79,0:21:45.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan masih ada banyak hal lain.
Dialogue: 0,0:21:46.69,0:21:51.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kali ini, aku akhirnya bisa\Nmengisi kekosongan di dalam hidupku
Dialogue: 0,0:21:51.60,0:21:53.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan terus menjalani hidup.
Dialogue: 0,0:21:54.25,0:21:56.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak peduli apa yang akan terjadi nanti,
Dialogue: 0,0:21:56.30,0:21:59.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku sudah bertekad\Nuntuk melindungi keluargaku.
Dialogue: 0,0:22:01.35,0:22:02.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak perlu cemas.
Dialogue: 0,0:22:02.91,0:22:07.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena aku sudah menyiapkan banyak strategi.
