Dialogue: 0,0:01:32.25,0:01:35.92,sign,,0000,0000,0000,,EPISODE 4: PENCURI MASA DEPAN
Dialogue: 0,0:05:45.47,0:05:47.59,sign,,0000,0000,0000,,PENGHANCUR RELIK YANG KASAR. MENDAPATKAN TITEL.\NDAYA KENDALI MENINGKAT, DAYA SELARAS MENURUN
Dialogue: 0,0:05:47.59,0:05:49.55,sign,,0000,0000,0000,,KEMAMPUAN MENDETEKSI RELIK MENINGKAT PERINGKAT SKILL\NPENYELIDIKAN PIKIRAN MENINGKAT MENJADI PERINGKAT E
Dialogue: 0,0:05:49.55,0:05:50.24,sign,,0000,0000,0000,,MENDETEKSI PEMBURU RAKSASA
Dialogue: 0,0:05:50.24,0:05:52.16,sign,,0000,0000,0000,,"SETELAH MENGHANCURKAN RELIK LEVEL TINGGI"
Dialogue: 0,0:06:29.45,0:06:32.20,sign,,0000,0000,0000,,MOCI LEZAT YANG DIJUAL SEORANG ISTRI
Dialogue: 0,0:08:43.44,0:08:44.33,sign,,0000,0000,0000,,KEWARGANEGARAAN: DIPERKIRAKAN JEPANG
Dialogue: 0,0:14:16.79,0:14:18.62,sign,,0000,0000,0000,,MENDETEKSI AURA GANAS DARI PINTU.
Dialogue: 0,0:14:18.62,0:14:19.84,sign,,0000,0000,0000,,JUMLAH PENGGUNAAN YANG TERSISA\NDURABILITAS MULAI BERKURANG!
Dialogue: 0,0:14:32.91,0:14:33.41,sign,,0000,0000,0000,,ANDA TELAH TERJERAT OLEH\NAURA RELIK YANG GANAS
Dialogue: 0,0:14:33.41,0:14:34.87,sign,,0000,0000,0000,,AKIBAT AURA TERSEBUT, RELIK YANG\NANDA MILIKI MENGALAMI KERUSAKAN FATAL
Dialogue: 0,0:14:34.87,0:14:36.64,sign,,0000,0000,0000,,KEBERUNTUNGAN MENINGGALKAN ANDA
Dialogue: 0,0:16:37.70,0:16:38.53,sign,,0000,0000,0000,,PAPARAN BERKELANJUTAN TERHADAP AURA MEMATIKAN
Dialogue: 0,0:16:39.62,0:16:40.55,sign,,0000,0000,0000,,BERKAT EFEK RESISTANSI
Dialogue: 0,0:16:50.25,0:16:50.81,sign,,0000,0000,0000,,BERKAT EFEK RESISTANSI
Dialogue: 0,0:19:05.46,0:19:06.22,sign,,0000,0000,0000,,KEKUATAN RELIK LAWAN MELONJAK DRASTIS
Dialogue: 0,0:19:15.94,0:19:16.94,sign,,0000,0000,0000,,LEDAKAN AURA RELIK BERKEKUATAN TINGGI\NTERJADI DALAM RADIUS 1 KM
Dialogue: 0,0:19:16.94,0:19:18.74,sign,,0000,0000,0000,,GELOMBANG KEMALANGAN BESAR\NMELEDAK DAN MENYAPU AREA SEKITAR
Dialogue: 0,0:19:18.74,0:19:20.76,sign,,0000,0000,0000,,RELIK YANG ANDA MILIKI\NMENGALAMI KERUSAKAN FATAL
Dialogue: 0,0:19:44.05,0:19:46.60,sign,,0000,0000,0000,,SUASANA HATI LAWAN BERUBAH, DAYA SERANG\NRELIKNYA KEMBALI KE KEADAAN SEMULA.
Dialogue: 0,0:20:57.84,0:20:58.95,sign,,0000,0000,0000,,UNDANG-UNDANG HAMMURABI,\NPENA SHAKESPEARE, KALUNG MARIE ANTOINETTE
Dialogue: 0,0:23:38.56,0:23:41.62,sign,,0000,0000,0000,,EPISODE 5\NPEMILIK RUMPUT KEABADIAN
Dialogue: 0,0:01:40.80,0:01:43.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang-orang militer itu keterlaluan, ya.
Dialogue: 0,0:01:43.56,0:01:46.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tega sekali mereka mengirimmu ke garis depan.
Dialogue: 0,0:01:47.36,0:01:50.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau tahu soal itu?
Dialogue: 0,0:01:51.90,0:01:53.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada, deh.
Dialogue: 0,0:01:53.20,0:01:56.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, benar.\NMereka bahkan selalu mengawasiku.
Dialogue: 0,0:01:57.49,0:01:59.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, ayo pergi.
Dialogue: 0,0:02:04.66,0:02:08.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.\NAyo kita buat mereka dapat masalah.
Dialogue: 0,0:02:13.23,0:02:17.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba lihat itu.\NDia jauh sekali dari kata menyeramkan.
Dialogue: 0,0:02:17.03,0:02:19.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil dia orang\Nyang ingin mengutukku sampai mati.
Dialogue: 0,0:02:20.52,0:02:24.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlebih, kami sudah bertemu mata.\NAku sudah bisa baca masa depannya!
Dialogue: 0,0:02:25.11,0:02:28.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, aku meninggalkan\NCatatan Masa Depan di rumah.
Dialogue: 0,0:02:42.75,0:02:44.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa?!
Dialogue: 0,0:02:45.26,0:02:47.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya ini?
Dialogue: 0,0:02:51.40,0:02:53.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan ribut. Serahkan ponselmu.
Dialogue: 0,0:02:56.33,0:02:58.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pikir aku tidak mengenalmu?
Dialogue: 0,0:02:59.36,0:03:01.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kaulah pemilik Catatan Masa Depan.
Dialogue: 0,0:03:01.68,0:03:03.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, 'kan?
Dialogue: 0,0:03:04.05,0:03:07.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana ini?\NIdentitasku ketahuan.
Dialogue: 0,0:03:09.25,0:03:11.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan nikmati waktu kalian.
Dialogue: 0,0:03:15.30,0:03:18.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, mari kita mulai kencannya.
Dialogue: 0,0:03:21.03,0:03:22.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keluarkan Catatan Masa Depan.
Dialogue: 0,0:03:22.90,0:03:25.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salin semua ramalan yang kau lihat ke sini.
Dialogue: 0,0:03:25.76,0:03:27.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini kencan dari mana, coba?
Dialogue: 0,0:03:27.98,0:03:30.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlebih, Catatan Masa Depanku ada di rumah.
Dialogue: 0,0:03:30.35,0:03:31.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sedang melawak, ya?
Dialogue: 0,0:03:31.85,0:03:35.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sentuh tato yang ada di lenganmu,\Nlalu ucapkan "Catatan Masa Depan".
Dialogue: 0,0:03:35.26,0:03:37.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bisa memanggilnya ke sini.
Dialogue: 0,0:03:38.17,0:03:41.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bahkan tak tahu\Npengetahuan dasar seperti ini?
Dialogue: 0,0:03:44.60,0:03:46.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Catatan Masa Depan.
Dialogue: 0,0:03:50.74,0:03:52.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukunya benar-benar muncul.
Dialogue: 0,0:03:53.90,0:03:58.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya, ya. Semua.\NHati-hati, jangan sampai ada yang terlewat.
Dialogue: 0,0:04:12.56,0:04:14.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau makin lambat.
Dialogue: 0,0:04:14.55,0:04:16.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, tidak akan selesai-selesai.
Dialogue: 0,0:04:16.11,0:04:18.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lenganku sakit, tidak bisa tulis lagi.
Dialogue: 0,0:04:18.77,0:04:20.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mau Catatan Masa Depan,\Naku bisa berikan.
Dialogue: 0,0:04:21.25,0:04:23.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau bisa bebaskan aku?
Dialogue: 0,0:04:24.46,0:04:25.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa.
Dialogue: 0,0:04:25.19,0:04:27.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan, sih, orang ini?\NMentang-mentang ganteng.
Dialogue: 0,0:04:27.41,0:04:29.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tertipu karena dia sempat ramah padaku.
Dialogue: 0,0:04:29.76,0:04:32.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bisa direbut,\Nbenda itu sudah kurebut sejak lama.
Dialogue: 0,0:04:32.80,0:04:33.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Catatan Masa Depan adalah
Dialogue: 0,0:04:33.95,0:04:36.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tingkat Legenda Pahlawan, Peringkat S.
Dialogue: 0,0:04:36.71,0:04:40.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika aku memaksanya patuh,\Npenalti yang didapatkan juga besar.
Dialogue: 0,0:04:40.66,0:04:43.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini berbeda dengan Muramasa\Nyang peringkatnya rendah.
Dialogue: 0,0:04:43.41,0:04:45.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin bukan satu lenganku saja yang kena.
Dialogue: 0,0:04:45.90,0:04:47.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan, tolong jangan begitu.
Dialogue: 0,0:04:47.97,0:04:49.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami sedang bertugas.
Dialogue: 0,0:04:49.63,0:04:52.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Sebentar saja. Mohon kerja samanya.\N- Hm?
Dialogue: 0,0:04:52.40,0:04:54.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang-orang berisiknya sudah tiba.
Dialogue: 0,0:04:58.40,0:05:00.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salinannya sudah cukup banyak.
Dialogue: 0,0:05:00.29,0:05:02.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tu-Tunggu, jangan lakukan.
Dialogue: 0,0:05:02.57,0:05:06.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa kau akan lebih untung\Nkalau membiarkanku hidup...
Dialogue: 0,0:05:08.46,0:05:10.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan salah paham, ya.
Dialogue: 0,0:05:23.50,0:05:26.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kau lakukan, manusia rendahan?!
Dialogue: 0,0:05:41.67,0:05:43.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya demi kebaikanmu juga.
Dialogue: 0,0:05:50.24,0:05:52.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemburu Raksasa?
Dialogue: 0,0:05:56.16,0:05:57.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bergerak!
Dialogue: 0,0:05:57.30,0:05:58.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diam di tempat!
Dialogue: 0,0:06:09.69,0:06:12.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ca-Catatan Masa Depannya...\NApa yang sebenarnya terjadi?!
Dialogue: 0,0:06:12.99,0:06:14.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa masih tanya aku?
Dialogue: 0,0:06:14.61,0:06:15.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba pakai matamu itu.
Dialogue: 0,0:06:15.81,0:06:17.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pakai mata...?
Dialogue: 0,0:06:17.80,0:06:19.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kau lakukan?!
Dialogue: 0,0:06:19.01,0:06:21.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan mengeksekusimu di sini,\Nsekarang juga!
Dialogue: 0,0:06:23.33,0:06:24.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan membuatku tertawa.
Dialogue: 0,0:06:24.90,0:06:26.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa katamu?
Dialogue: 0,0:06:26.65,0:06:28.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makan ini saja, sana!
Dialogue: 0,0:06:32.36,0:06:34.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutku, sih, rasanya sangat lezat.
Dialogue: 0,0:06:37.21,0:06:39.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keparat, apa yang sebenarnya kau rencanakan?
Dialogue: 0,0:06:40.67,0:06:42.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Dia menghilang ke mana?!\N- Bau apa ini?
Dialogue: 0,0:06:53.65,0:06:55.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harum sekali.
Dialogue: 0,0:06:59.74,0:07:00.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mociku!
Dialogue: 0,0:07:01.78,0:07:02.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian ini, ya.
Dialogue: 0,0:07:03.47,0:07:06.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini mociku!\NLancang sekali kalian pada atasan sendiri!
Dialogue: 0,0:07:06.28,0:07:09.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau pistol, kami juga punya.
Dialogue: 0,0:07:13.32,0:07:14.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keparat!
Dialogue: 0,0:07:14.61,0:07:16.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan mociku!
Dialogue: 0,0:07:16.70,0:07:18.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini punyaku!
Dialogue: 0,0:07:18.70,0:07:22.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berengsek, sudah kubilang itu punyaku!
Dialogue: 0,0:07:22.28,0:07:24.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Hei, kalau kau tidak lepaskan itu,\N- Tuan-tuan sekalian...
Dialogue: 0,0:07:24.26,0:07:26.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- kau akan terima akibatnya nanti.\N- Bagaimana ini?
Dialogue: 0,0:07:26.21,0:07:28.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan menahan diri, ya!
Dialogue: 0,0:07:41.43,0:07:42.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm?
Dialogue: 0,0:07:42.83,0:07:43.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketemu.
Dialogue: 0,0:07:43.90,0:07:46.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kofunisasi Raksasa.
Dialogue: 0,0:07:46.00,0:07:49.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu adalah insiden mengerikan\Nketika seluruh dunia ditelan oleh makam.
Dialogue: 0,0:07:50.07,0:07:53.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak salah, sejak itu pula\Nbanyak relik yang mulai membanjiri dunia.
Dialogue: 0,0:07:54.36,0:07:58.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Januari, momen yang tepat terjadi\Ndi taman penuh nafsu di bawah tanah.
Dialogue: 0,0:08:01.86,0:08:06.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari sanalah dimulainya malapetaka\Nyang menyeret dunia ke dalam kekacauan.
Dialogue: 0,0:08:06.70,0:08:10.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, di sanalah Dewa\Nyang mengetahui nafsumu,
Dialogue: 0,0:08:10.41,0:08:12.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan mengajakmu bekerja sama.
Dialogue: 0,0:08:13.36,0:08:18.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kata-kata ini merujuk pada pelelangan\Nbawah tanah, Midas, di Las Vegas.
Dialogue: 0,0:08:18.06,0:08:19.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di antara para pesertanya,
Dialogue: 0,0:08:19.18,0:08:21.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}orang itu pasti ada di sana.
Dialogue: 0,0:08:29.56,0:08:34.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam pelelangan kali ini,\Nada tiga orang yang menggunakan inisial J.K.
Dialogue: 0,0:08:34.64,0:08:36.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Informasinya bagus juga.
Dialogue: 0,0:08:36.40,0:08:39.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana?\NAda orang yang kau cari?
Dialogue: 0,0:08:39.01,0:08:40.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, ada.
Dialogue: 0,0:08:40.40,0:08:43.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak salah lagi, dia pasti Ogawara Taisei.
Dialogue: 0,0:08:44.34,0:08:48.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dia datang, berarti ada relik\Nberkualitas tinggi yang dijual.
Dialogue: 0,0:08:54.90,0:08:58.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm? Tidak ada relik tingkat Dewa.
Dialogue: 0,0:08:58.15,0:09:00.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, apa maksud ramalan itu?
Dialogue: 0,0:09:00.43,0:09:03.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Undang-Undang Hammurabi\Ndan Pena Shakespeare, ya.
Dialogue: 0,0:09:04.66,0:09:07.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu,\Nada beberapa barang yang harus kubeli.
Dialogue: 0,0:09:07.71,0:09:09.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa katamu? Beli?
Dialogue: 0,0:09:09.78,0:09:15.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bilang kau mau ikut lelang Midas\Nyang harga terendahnya 1 miliar?
Dialogue: 0,0:09:15.77,0:09:18.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu. Tapi sekarang uangnya belum ada.
Dialogue: 0,0:09:22.77,0:09:25.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kau pikir kita sedang di mana?
Dialogue: 0,0:09:26.18,0:09:28.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, waktunya cari uang.
Dialogue: 0,0:09:29.15,0:09:31.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada banyak uang di sekeliling kita.
Dialogue: 0,0:09:31.60,0:09:34.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kita di Las Vegas.
Dialogue: 0,0:09:35.48,0:09:38.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami bisa pastikan\NCatatan Masa Depan telah dihancurkan.
Dialogue: 0,0:09:38.05,0:09:40.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kabarnya para tentara di TKP pun\Nberhasil dikalahkan.
Dialogue: 0,0:09:40.71,0:09:44.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bilang semua itu dilakukan\Noleh seorang individu?
Dialogue: 0,0:09:45.26,0:09:48.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar. Perlukah kita temukan dia dan habisi?
Dialogue: 0,0:09:48.27,0:09:49.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm...
Dialogue: 0,0:09:49.48,0:09:53.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak. Dia orang yang cukup kuat\Nuntuk hancurkan Catatan Masa Depan.
Dialogue: 0,0:09:53.57,0:09:57.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari jadikan dia sekutu.\NDia pasti berguna.
Dialogue: 0,0:09:57.23,0:09:58.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:10:04.75,0:10:07.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga. Dia menang lagi...?
Dialogue: 0,0:10:07.44,0:10:09.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sulit dipercaya.
Dialogue: 0,0:10:09.25,0:10:12.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia menang di seluruh mesin pilihannya.
Dialogue: 0,0:10:12.30,0:10:14.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Trik apa yang dia pakai?
Dialogue: 0,0:10:19.80,0:10:21.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang benar saja. Lagi?!
Dialogue: 0,0:10:22.16,0:10:24.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sip. Waktunya pindah ke mesin lain.
Dialogue: 0,0:10:24.31,0:10:26.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, aku iri.
Dialogue: 0,0:10:26.19,0:10:27.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon. Beri tahu aku trik rahasianya!
Dialogue: 0,0:10:27.26,0:10:30.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan, bolehkah aku memeriksa\Nsesuatu sebentar?
Dialogue: 0,0:10:31.35,0:10:34.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena ini pertama kalinya seseorang\Nmendapatkan jackpot berturut-turut.
Dialogue: 0,0:10:35.26,0:10:36.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Periksa sesukamu.
Dialogue: 0,0:10:41.17,0:10:42.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:10:43.56,0:10:45.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, itu.
Dialogue: 0,0:10:45.56,0:10:48.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gantungan kunci yang kubeli untuk oleh-oleh.
Dialogue: 0,0:10:48.56,0:10:51.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana?\NWarnanya cantik, 'kan?
Dialogue: 0,0:10:51.35,0:10:54.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tekan ini,\Nbisa dipakai sebagai pisau juga.
Dialogue: 0,0:10:56.98,0:10:58.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf mengganggu.
Dialogue: 0,0:10:59.66,0:11:02.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu adalah Kapak Emas yang bentuknya kuubah.
Dialogue: 0,0:11:02.91,0:11:06.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku manfaatkan kekuatannya\Nyang bisa mendekatkan harta.
Dialogue: 0,0:11:07.35,0:11:09.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini benar-benar memalukan!
Dialogue: 0,0:11:09.61,0:11:11.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, mau sampai kapan wujudku seperti...?!
Dialogue: 0,0:11:13.36,0:11:17.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan berhenti sampai di sini,\Ndan pindah ke tempat lain.
Dialogue: 0,0:11:20.00,0:11:23.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak sanggup lagi.\NTempat ini terlalu ramai.
Dialogue: 0,0:11:23.53,0:11:26.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, semuanya minggir, minggir!
Dialogue: 0,0:11:26.41,0:11:28.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan menghalangi jalan!
Dialogue: 0,0:11:29.24,0:11:32.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang-orang ini tidak sopan,\Npadahal ada orang VIP yang mau lewat.
Dialogue: 0,0:11:32.41,0:11:35.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ketemu. Ternyata dia memang di sini.\N- Benar-benar mengganggu.
Dialogue: 0,0:11:36.66,0:11:39.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia terlihat lebih muda dari yang kuingat,
Dialogue: 0,0:11:39.01,0:11:41.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi wajah menyebalkannya\Nmasih sama seperti dulu.
Dialogue: 0,0:11:41.53,0:11:45.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ito Takuya. Jika dia ada di sini...
Dialogue: 0,0:11:45.55,0:11:47.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minggir, minggir.
Dialogue: 0,0:11:55.36,0:11:58.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ogawara Taisei.
Dialogue: 0,0:12:02.36,0:12:04.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lewat sini, Ketua Besar.
Dialogue: 0,0:12:07.53,0:12:10.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini, dia masih belum mengenalku.
Dialogue: 0,0:12:10.54,0:12:12.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat saja nanti, Ogawara.
Dialogue: 0,0:12:12.85,0:12:17.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam lelang kali ini, aku akan merebut\Nseluruh relik berkualitas tinggi.
Dialogue: 0,0:12:17.11,0:12:18.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ryouga.
Dialogue: 0,0:12:18.05,0:12:20.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang aneh dengan tasnya.
Dialogue: 0,0:12:23.51,0:12:25.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia datang, dia datang!
Dialogue: 0,0:12:26.00,0:12:27.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang datang?
Dialogue: 0,0:12:27.20,0:12:28.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia akan datang!
Dialogue: 0,0:12:29.45,0:12:33.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapak Emas memiliki\Nkemampuan mendeteksi harta,
Dialogue: 0,0:12:33.11,0:12:37.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sedangkan Kapak Perak menemukan musuh\Nyang mengincar harta majikannya.
Dialogue: 0,0:12:37.20,0:12:38.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mendeteksi apa?
Dialogue: 0,0:12:38.40,0:12:41.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bajingan. Beraninya kau menipuku!
Dialogue: 0,0:12:41.21,0:12:43.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bicara apa kau?\NCepat serahkan!
Dialogue: 0,0:12:43.53,0:12:47.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana ini?\NAda yang mencuri uang itu.
Dialogue: 0,0:12:47.78,0:12:50.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harga sahamnya tiba-tiba terjun bebas!
Dialogue: 0,0:12:50.96,0:12:52.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang tidak beres.
Dialogue: 0,0:12:52.55,0:12:55.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa tiba-tiba ada keributan seperti ini?
Dialogue: 0,0:12:55.01,0:12:59.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ponselku tiba-tiba rusak,\Npadahal tadi baik-baik saja.
Dialogue: 0,0:12:59.76,0:13:01.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa hal seperti ini...
Dialogue: 0,0:13:15.36,0:13:17.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bilang perempuan itu...?
Dialogue: 0,0:13:23.86,0:13:28.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putri bungsu keluarga konglomerat Hilton,\NIrene Hilton.
Dialogue: 0,0:13:29.43,0:13:32.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebelum kembali ke masa lalu,\Npemilik relik tingkat Dewa memiliki julukan
Dialogue: 0,0:13:33.12,0:13:38.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Raja Takdir, Raja Penakluk,\Natau Raja Kekayaan.
Dialogue: 0,0:13:38.50,0:13:43.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di antara semuanya, Irene Hilton adalah\Npemilik kekuatan yang paling mengerikan.
Dialogue: 0,0:13:43.30,0:13:46.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak salah lagi, nama aliasnya adalah,\N"Raja Kebangkrutan".
Dialogue: 0,0:13:46.98,0:13:50.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berada di dekatnya saja membuatmu\Nterkena berbagai bencana.
Dialogue: 0,0:13:51.68,0:13:54.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang-orang akan kehilangan harta,\Nterkena penyakit,
Dialogue: 0,0:13:54.68,0:13:56.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan perusahaan akan bangkrut.
Dialogue: 0,0:13:57.20,0:13:58.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya aku tak berurusan dengannya.
Dialogue: 0,0:13:59.87,0:14:02.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita terima barangnya,\Nlalu segera pergi dari sini.
Dialogue: 0,0:14:02.23,0:14:02.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:14:04.82,0:14:06.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf!
Dialogue: 0,0:14:08.50,0:14:10.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu sebentar!
Dialogue: 0,0:14:19.85,0:14:21.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial. Yang benar saja!
Dialogue: 0,0:14:21.79,0:14:23.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi...
Dialogue: 0,0:14:25.81,0:14:28.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bolehkah aku bicara denganmu sebentar?
Dialogue: 0,0:14:36.64,0:14:38.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lepas!
Dialogue: 0,0:14:39.56,0:14:41.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, maafkan aku.
Dialogue: 0,0:14:41.65,0:14:43.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku terlalu senang, sampai tak sengaja...
Dialogue: 0,0:14:43.65,0:14:47.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bang, Ryouga sialan itu kenapa?
Dialogue: 0,0:14:47.71,0:14:48.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana kutahu.
Dialogue: 0,0:14:50.10,0:14:51.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan...
Dialogue: 0,0:14:52.43,0:14:54.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kaukah orangnya?
Dialogue: 0,0:14:54.23,0:14:57.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang menang jackpot berulang kali.
Dialogue: 0,0:14:59.41,0:15:01.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mencarimu ke mana-mana.
Dialogue: 0,0:15:01.60,0:15:04.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong beri tahu aku trik yang kau pakai.
Dialogue: 0,0:15:04.95,0:15:06.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya kau salah orang.
Dialogue: 0,0:15:08.06,0:15:09.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar bodoh!
Dialogue: 0,0:15:09.13,0:15:13.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang waras mana yang menolak obrolan\Nyang dimulai seorang wanita? Dasar.
Dialogue: 0,0:15:14.16,0:15:15.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat saja di sana.
Dialogue: 0,0:15:15.76,0:15:18.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang akan ladeni dia bicara.
Dialogue: 0,0:15:19.78,0:15:22.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kalau kau mau, aku bisa ajarkan triknya.
Dialogue: 0,0:15:22.95,0:15:26.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, tunggu. Mau makan bersama?
Dialogue: 0,0:15:26.31,0:15:28.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ka-Kau tahu tempat yang bagus di sekitar sini?\N- Ngapain, sih?
Dialogue: 0,0:15:30.22,0:15:31.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Duh, maaf. Bagaimana ini?\N- Ambulans...
Dialogue: 0,0:15:31.94,0:15:32.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perutku sakit.
Dialogue: 0,0:15:32.95,0:15:35.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ah, maafkan aku!\N- Ralat! Panggil polisi...!
Dialogue: 0,0:15:35.17,0:15:37.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong dengarkan ceritaku!
Dialogue: 0,0:15:40.12,0:15:42.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepuluh... Tidak, lima menit juga tidak apa.
Dialogue: 0,0:15:42.36,0:15:43.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku minta waktumu seben...
Dialogue: 0,0:15:50.46,0:15:52.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau baik-baik saja?
Dialogue: 0,0:15:53.50,0:15:55.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Kau baik-baik saja", katamu?
Dialogue: 0,0:15:55.22,0:15:56.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa-bisanya!
Dialogue: 0,0:15:56.65,0:15:58.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutmu gara-gara siapa aku begini?!
Dialogue: 0,0:15:58.56,0:16:01.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau benar. Itu masalahnya.
Dialogue: 0,0:16:01.56,0:16:04.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia malah membalas.
Dialogue: 0,0:16:04.23,0:16:08.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang-orang yang ada di sekitarku akan sial.
Dialogue: 0,0:16:08.30,0:16:13.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku ingin meningkatkan keberuntungan,\Nsupaya bisa membahagiakan mereka.
Dialogue: 0,0:16:15.51,0:16:16.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan ini?
Dialogue: 0,0:16:17.18,0:16:19.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang ini "Raja Kebangkrutan" yang membuat
Dialogue: 0,0:16:19.39,0:16:22.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}banyak orang bangkrut\Ndan mengacaukan dunia, 'kan?
Dialogue: 0,0:16:22.33,0:16:24.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa dia sedang akting?
Dialogue: 0,0:16:25.33,0:16:28.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisakah kau memberitahuku trik\Nuntuk dapat keberuntungan?
Dialogue: 0,0:16:28.95,0:16:32.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa bayar imbalannya,\Nsebesar apa pun itu. Mau, ya?
Dialogue: 0,0:16:33.23,0:16:35.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia berbeda dengan yang kubayangkan.
Dialogue: 0,0:16:38.86,0:16:39.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Resistansi?
Dialogue: 0,0:16:40.56,0:16:42.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan...
Dialogue: 0,0:16:42.18,0:16:45.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini kekuatan dari bola perak\Nyang kutelan waktu itu, ya?
Dialogue: 0,0:16:46.68,0:16:50.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu kembali aktif karena\Nserangan Raja Kebangkrutan?
Dialogue: 0,0:16:50.82,0:16:53.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf... Sudah kau pertimbangkan?
Dialogue: 0,0:16:53.40,0:16:58.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku tak perlu\Nsengaja menjauh dari wanita ini.
Dialogue: 0,0:16:58.20,0:17:01.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika angka resistansiku meningkat\Nhanya dengan berada di dekatnya,
Dialogue: 0,0:17:01.05,0:17:02.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}justru aku akan untung banyak.
Dialogue: 0,0:17:03.06,0:17:08.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlebih, jika dia bersamaku, peserta lelang\Nakan terkena kesialan satu per satu.
Dialogue: 0,0:17:08.21,0:17:10.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa itu ide yang bagus.
Dialogue: 0,0:17:10.51,0:17:12.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku sedang sibuk.
Dialogue: 0,0:17:12.34,0:17:15.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah punya rencana lain setelah ini.
Dialogue: 0,0:17:15.72,0:17:18.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, aku paham kau orang yang sibuk.
Dialogue: 0,0:17:18.91,0:17:22.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, aku ingin bicarakan syarat\Nuntuk transaksi kita,
Dialogue: 0,0:17:22.85,0:17:26.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku harus pergi ke lokasi lelang\Nsekarang juga.
Dialogue: 0,0:17:26.01,0:17:27.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, baiklah.
Dialogue: 0,0:17:27.31,0:17:30.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau berkenan ikut bersamaku?
Dialogue: 0,0:17:30.82,0:17:34.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh. Aku akan menemanimu!
Dialogue: 0,0:17:38.12,0:17:41.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seseorang, panggilkan ambulans...!
Dialogue: 0,0:17:42.90,0:17:46.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hadirin sekalian, selamat datang.
Dialogue: 0,0:17:46.33,0:17:51.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelelangan ke-74 kini resmi dimulai.
Dialogue: 0,0:17:51.83,0:17:54.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena aku membawa Irene ke sini,
Dialogue: 0,0:17:54.35,0:17:57.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dua per tiga peserta\Nmeninggalkan tempat acara.
Dialogue: 0,0:17:57.25,0:18:00.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka pasti pergi mengatasi bencana\Nyang tiba-tiba datang.
Dialogue: 0,0:18:01.50,0:18:07.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar pabrik perusahaan Ogawara Taisei\Ndi Republik Vent juga mengalami kebakaran.
Dialogue: 0,0:18:07.03,0:18:08.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kelihatannya dia tidak pergi.
Dialogue: 0,0:18:08.81,0:18:13.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga, dia mengincar sesuatu.
Dialogue: 0,0:18:13.26,0:18:16.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luar biasa. Katanya itu anggur keluarga\Nkerajaan Rusia yang berusia 100 tahun.
Dialogue: 0,0:18:16.82,0:18:20.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benda yang kucari\Nada di paruh kedua acaranya, lo.
Dialogue: 0,0:18:20.51,0:18:22.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu, ya.
Dialogue: 0,0:18:23.76,0:18:26.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Raja Kebangkrutan, Irene Hilton.
Dialogue: 0,0:18:26.46,0:18:29.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penampilannya sangat berbeda\Ndengan yang kukenal.
Dialogue: 0,0:18:29.56,0:18:33.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, dia tak tahu apa-apa soal relik.
Dialogue: 0,0:18:33.76,0:18:39.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, sebenarnya tidak aneh kalau ada relik\Nyang menempeli tanpa sepengetahuannya.
Dialogue: 0,0:18:39.81,0:18:43.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal Raja Kebangkrutan\Ndulunya orang yang sebaik ini.
Dialogue: 0,0:18:43.41,0:18:47.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin karena dihantui relik kemalangan,\Nhidupnya jadi berantakan,
Dialogue: 0,0:18:48.01,0:18:50.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan pada akhirnya\Nkepribadian pun ikut berubah.
Dialogue: 0,0:18:50.44,0:18:53.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini, aku ingin mengucapkan terima kasih.
Dialogue: 0,0:18:53.85,0:18:56.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau ingin mengabulkan permintaanku, 'kan?
Dialogue: 0,0:18:56.43,0:18:59.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa menceritakan masalah\Npada orang lain saja
Dialogue: 0,0:18:59.11,0:19:01.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sudah membuat hatiku jauh lebih ringan.
Dialogue: 0,0:19:02.00,0:19:04.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak melakukan hal khusus, kok.
Dialogue: 0,0:19:06.63,0:19:10.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tidak benar. Aku benar-benar senang.
Dialogue: 0,0:19:13.80,0:19:15.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial. Ini gawat!
Dialogue: 0,0:19:21.01,0:19:23.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya tubuhku seperti akan diremukkan.
Dialogue: 0,0:19:23.03,0:19:24.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuanku, lakukan sesuatu!
Dialogue: 0,0:19:25.14,0:19:29.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rupanya kekuatan kemalangannya meningkat\Nsaat majikannya bahagia.
Dialogue: 0,0:19:29.51,0:19:31.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Relik ini benar-benar seperti psikopat!
Dialogue: 0,0:19:31.90,0:19:34.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Irene, tenangkan dirimu.
Dialogue: 0,0:19:34.58,0:19:37.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Transaksi kita belum dimulai, lo.
Dialogue: 0,0:19:40.22,0:19:43.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maaf, aku sudah merepotkan lagi, ya.
Dialogue: 0,0:19:48.05,0:19:52.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, sepertinya tadi ada gempa sebentar.\NSekarang sudah baik-baik saja.
Dialogue: 0,0:19:52.01,0:19:55.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini, harganya mencapai 707 ribu.
Dialogue: 0,0:19:55.60,0:19:56.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ada yang ingin menawar?
Dialogue: 0,0:19:56.81,0:19:57.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu juta dolar!
Dialogue: 0,0:19:57.81,0:19:59.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, apa yang kau lakukan?
Dialogue: 0,0:19:59.25,0:20:01.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mau protes, naikkan lagi harganya.
Dialogue: 0,0:20:01.21,0:20:03.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Pokoknya, aku harus beli...\N- Kalian berdua yang di sana.
Dialogue: 0,0:20:03.78,0:20:05.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kau pikir aku tak bisa?!\N- Te-Tenang dulu.
Dialogue: 0,0:20:05.55,0:20:09.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang-orang mulai gila karena\NRaja Kebangkrutan ada di sini.
Dialogue: 0,0:20:09.76,0:20:13.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bisa manfaatkan ini,\Naku bisa singkirkan pesaing lain.
Dialogue: 0,0:20:15.23,0:20:18.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah, tidak perlu semurung itu.
Dialogue: 0,0:20:18.10,0:20:22.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mungkin bisa membahagiakan\Norang-orang di sekelilingmu.
Dialogue: 0,0:20:22.32,0:20:24.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari bicarakan transaksi kita.
Dialogue: 0,0:20:24.32,0:20:25.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:20:27.48,0:20:31.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menyesuaikan diri seolah mampu\Nselesaikan masalahnya sekarang juga.
Dialogue: 0,0:20:32.00,0:20:34.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makin bagus suasana hatinya,
Dialogue: 0,0:20:34.15,0:20:36.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}relik itu akan keluarkan kekuatan\Nyang lebih besar.
Dialogue: 0,0:20:36.84,0:20:40.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peserta lelang lainnya\Nakan kehilangan akal sehat,
Dialogue: 0,0:20:40.05,0:20:42.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan terobsesi pada setiap barang.
Dialogue: 0,0:20:43.23,0:20:45.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin karena kekuatan\Nkendali Ogawara yang tinggi,
Dialogue: 0,0:20:45.85,0:20:48.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia tak digoyahkan\Nkekuatan Raja Kebangkrutan,
Dialogue: 0,0:20:48.11,0:20:49.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan terus membeli barang.
Dialogue: 0,0:20:50.63,0:20:54.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja, saat dia menginginkan barang\Nyang setara sampah,
Dialogue: 0,0:20:54.41,0:20:56.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan meningkatkan harganya.
Dialogue: 0,0:20:58.96,0:21:00.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba kulihat.
Dialogue: 0,0:21:00.62,0:21:02.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Undang-Undang Hammurabi,
Dialogue: 0,0:21:02.11,0:21:03.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pena Shakespeare.
Dialogue: 0,0:21:03.50,0:21:05.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalung Marie Antoinette...
Dialogue: 0,0:21:06.25,0:21:09.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, tidak ada kelas Dewa\Nseperti yang disebutkan ramalan.
Dialogue: 0,0:21:09.47,0:21:10.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya ini?
Dialogue: 0,0:21:10.48,0:21:11.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:21:11.76,0:21:16.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan kenalkan barang spesial\Nyang tak ada di dalam katalog.
Dialogue: 0,0:21:16.33,0:21:18.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Barang satu ini
Dialogue: 0,0:21:18.45,0:21:20.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}benda yang pernah dibahas oleh awak media,
Dialogue: 0,0:21:20.65,0:21:24.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Anakan Pohon Almon yang Ajaib!\N- Itu, 'kan...
Dialogue: 0,0:21:24.80,0:21:26.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anakan pohon itu...
Dialogue: 0,0:21:26.76,0:21:28.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rumput Keabadian!
Dialogue: 0,0:23:04.61,0:23:06.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu, 'kan...!
Dialogue: 0,0:23:06.19,0:23:07.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:23:07.75,0:23:09.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rumput Keabadian milik Kaisar...
Dialogue: 0,0:23:09.66,0:23:11.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rumput Keabadian?
Dialogue: 0,0:23:11.20,0:23:13.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus dapatkan tanaman itu...
Dialogue: 0,0:23:13.66,0:23:16.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi Ogawara juga pasti akan bergerak.
Dialogue: 0,0:23:16.57,0:23:18.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pohon itu sangat berharga, ya?
Dialogue: 0,0:23:18.76,0:23:22.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Irene.\NKita perlu itu untuk selesaikan masalahmu.
Dialogue: 0,0:23:23.27,0:23:26.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku siap lakukan apa saja untuk membantu!
Dialogue: 0,0:23:26.40,0:23:28.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi tidak enak karena seperti menipunya,
Dialogue: 0,0:23:28.29,0:23:30.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi ini bukan waktunya\Nmemikirkan yang belum terjadi.
Dialogue: 0,0:23:31.27,0:23:33.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya, "Pemilik Rumput Keabadian".
Dialogue: 0,0:23:33.61,0:23:35.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa pun yang terjadi,
Dialogue: 0,0:23:35.18,0:23:38.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku harus hentikan relik itu\Njatuh ke tangan Ogawara lagi.
