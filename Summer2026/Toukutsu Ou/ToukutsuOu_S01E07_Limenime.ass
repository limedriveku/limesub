Dialogue: 0,0:01:33.51,0:01:37.07,sign,,0000,0000,0000,,EPISODE 7: RESTORASI RELIK
Dialogue: 0,0:05:44.55,0:05:46.53,sign,,0000,0000,0000,,IRENE
Dialogue: 0,0:07:48.38,0:07:50.22,sign,,0000,0000,0000,,RUMAH SAKIT UNIVERSITAS SEKIHYO
Dialogue: 0,0:15:45.57,0:15:47.02,sign,,0000,0000,0000,,KESABARAN
Dialogue: 0,0:16:17.45,0:16:20.45,sign,,0000,0000,0000,,PIHAK PERTAMA: GOURIKI RYOUGA\NPIHAK KEDUA: YANAGI KOUTAROU
Dialogue: 0,0:16:57.95,0:16:59.26,sign,,0000,0000,0000,,TKBM?
Dialogue: 0,0:23:36.90,0:23:41.62,sign,,0000,0000,0000,,EPISODE 8: RAHASIA GAGAK
Dialogue: 0,0:01:37.07,0:01:40.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai sekarang dunia akan berubah total.
Dialogue: 0,0:01:41.14,0:01:43.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai Ketua Perusahaan TKBM,
Dialogue: 0,0:01:43.14,0:01:47.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku berjanji akan memberi\Nsemua dukungan untukmu.
Dialogue: 0,0:01:47.80,0:01:50.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bergabunglah menjadi bawahanku.
Dialogue: 0,0:01:53.38,0:01:56.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengajak kerja sama, tapi bilang,\N"Bergabunglah menjadi bawahanku"?
Dialogue: 0,0:01:56.96,0:01:59.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Niat busukmu itu sudah sangat terbaca.
Dialogue: 0,0:01:59.46,0:02:01.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lucu sekali, membuatku ingin tertawa.
Dialogue: 0,0:02:02.16,0:02:04.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, tidak.\NTidak ada maksud terselubung.
Dialogue: 0,0:02:04.51,0:02:06.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak perlu sampai terbawa emosi begitu, 'kan?
Dialogue: 0,0:02:06.64,0:02:10.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bisa menggunakan relik milik TKBM kami
Dialogue: 0,0:02:10.91,0:02:13.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang tak terhitung jumlahnya sesuka hatimu.
Dialogue: 0,0:02:13.20,0:02:15.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja mulai dari tipe pertempuran\Nhingga tipe medis.
Dialogue: 0,0:02:20.62,0:02:23.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tipe medis sesuka hatiku, katamu?
Dialogue: 0,0:02:23.62,0:02:27.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diperbudak olehmu dengan umpan\NRumput Keabadian masih belum kulupakan.
Dialogue: 0,0:02:29.98,0:02:31.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan meremehkanku.
Dialogue: 0,0:02:31.24,0:02:34.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin aku mau terhasut\Nkata manis itu untuk kedua kalinya.
Dialogue: 0,0:02:35.73,0:02:38.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, ini benar-benar mengejutkan, ya.
Dialogue: 0,0:02:38.76,0:02:41.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemampuanmu memang hebat.
Dialogue: 0,0:02:41.31,0:02:43.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pandanganku terhadapmu\Ntak salah sama sekali.
Dialogue: 0,0:02:43.97,0:02:45.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan relik, ya?
Dialogue: 0,0:02:45.97,0:02:48.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, agak mengerikan, ya?
Dialogue: 0,0:02:50.36,0:02:53.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Tubuh Achilles\Nyang Direndam Air Sungai Styx".
Dialogue: 0,0:02:53.66,0:02:56.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Achilles adalah prajurit\Ndalam mitologi Yunani.
Dialogue: 0,0:02:56.96,0:03:00.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat kecil, tumitnya dipegang\Noleh sang ibu, Thetis,
Dialogue: 0,0:03:00.25,0:03:03.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu direndam di Sungai Styx sehingga\Nmemperoleh tubuh yang kebal dan kuat.
Dialogue: 0,0:03:04.49,0:03:08.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, tumit yang digenggam saat itu\Ntidak terendam,
Dialogue: 0,0:03:08.71,0:03:10.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sehingga menjadi titik kelemahannya.
Dialogue: 0,0:03:10.96,0:03:14.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan orang ini pun\Npasti punya kelemahan.
Dialogue: 0,0:03:14.40,0:03:17.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masalahnya, tidak ada yang tahu\Ndi mana letak kelemahan itu.
Dialogue: 0,0:03:17.50,0:03:19.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya kau sadar juga?
Dialogue: 0,0:03:19.15,0:03:21.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak akan bisa menang melawanku.
Dialogue: 0,0:03:21.48,0:03:25.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana? Apakah kau butuh\Nsedikit waktu lagi untuk berpikir?
Dialogue: 0,0:03:25.26,0:03:27.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu?\NYa, aku butuh waktu.
Dialogue: 0,0:03:29.77,0:03:34.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku butuh waktu untuk menebas leher\Nmenjijikkanmu itu sampai putus.
Dialogue: 0,0:03:36.94,0:03:40.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keluarkan seluruh kekuatanmu, Muramasa!
Dialogue: 0,0:03:40.57,0:03:43.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau apa kau, Manusia?!
Dialogue: 0,0:03:44.46,0:03:45.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar bajingan gila!
Dialogue: 0,0:03:47.70,0:03:49.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan!
Dialogue: 0,0:03:59.92,0:04:03.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sialan. Apa sudah tidak bisa bertahan lagi?
Dialogue: 0,0:04:08.11,0:04:09.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Abang!
Dialogue: 0,0:04:11.60,0:04:14.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekuatan ini, aktif sendiri, ya?
Dialogue: 0,0:04:18.12,0:04:19.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Undang-Undang Hammurabi!
Dialogue: 0,0:04:33.50,0:04:35.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau terus begini, akan bahaya.
Dialogue: 0,0:04:35.30,0:04:36.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus cepat menyelesaikannya.
Dialogue: 0,0:05:11.06,0:05:11.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang ini...
Dialogue: 0,0:05:12.83,0:05:15.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah dia masih hidup\Nberkat kekuatan relik?
Dialogue: 0,0:05:15.58,0:05:18.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar orang yang menyebalkan!
Dialogue: 0,0:05:22.51,0:05:24.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ogawara!
Dialogue: 0,0:05:27.01,0:05:30.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Benar-benar hancur total, ya?
Dialogue: 0,0:05:30.08,0:05:33.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya Undang-Undang Hammurabi\Njuga menerima dampaknya.
Dialogue: 0,0:05:33.02,0:05:39.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Relik Achilles maupun Relik Penakluk\Nmilik Ogawara pasti sudah rusak.
Dialogue: 0,0:05:39.02,0:05:41.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk sementara,\Ndia tak akan bisa macam-macam.
Dialogue: 0,0:05:47.26,0:05:50.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, halo, sudah lama tak berbincang.
Dialogue: 0,0:05:50.56,0:05:53.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada sedikit hal\Nyang ingin aku minta bantuan.
Dialogue: 0,0:05:53.04,0:05:56.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisakah kau membantu mencari seseorang?
Dialogue: 0,0:05:56.54,0:05:59.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yanagi Koutarou, dia orang Jepang.
Dialogue: 0,0:06:03.65,0:06:05.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa katamu barusan?
Dialogue: 0,0:06:05.13,0:06:08.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang bernama Yanagi Koutarou\Nkatanya sudah meninggal.
Dialogue: 0,0:06:11.39,0:06:16.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakakku memiliki hobi\Nmengoleksi karya seni...
Dialogue: 0,0:06:16.39,0:06:20.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beberapa bulan lalu, dia ditipu\Ndan dibelikan barang tiruan olehnya.
Dialogue: 0,0:06:21.06,0:06:24.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pernah diperkenalkan kakakku\Ndi kediaman utama keluarga kami,
Dialogue: 0,0:06:24.58,0:06:27.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan karena kesannya yang baik,\Naku masih mengingatnya.
Dialogue: 0,0:06:28.70,0:06:32.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi salah satu lukisan ternama\Nyang dibeli darinya
Dialogue: 0,0:06:32.33,0:06:34.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tingkatkan kecepatannya lagi!\N- ternyata adalah lukisan tiruan.
Dialogue: 0,0:06:34.70,0:06:38.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tempel ketat mobil di depan! Injak gasnya!\N- Lalu kakakku mengejarnya,
Dialogue: 0,0:06:38.33,0:06:39.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi sepertinya mobil orang itu
Dialogue: 0,0:06:39.81,0:06:42.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menerobos pagar pembatas jalan\Ndan jatuh ke jurang.
Dialogue: 0,0:06:44.09,0:06:47.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini benar-benar di luar dugaan.
Dialogue: 0,0:06:47.55,0:06:51.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yanagi Koutarou,\Nseorang spesialis restorasi relik.
Dialogue: 0,0:06:51.55,0:06:55.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena berbagai alasan,\Ndaya tahan relik bisa menurun atau rusak.
Dialogue: 0,0:06:56.30,0:07:01.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, ada relik restorator\Nyang mampu merestorasi relik yang rusak
Dialogue: 0,0:07:01.56,0:07:05.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan penggunanya disebut sebagai\N"Restorator Relik".
Dialogue: 0,0:07:06.46,0:07:08.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nama lain Yanagi adalah "Raja Penipu".
Dialogue: 0,0:07:08.90,0:07:12.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia anggota Kelompok Penjarah Makam\Nyang sama denganku.
Dialogue: 0,0:07:12.60,0:07:16.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benar-benar minta maaf\Nkarena tidak bisa membantu.
Dialogue: 0,0:07:16.62,0:07:19.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagian besar relik restorator\Nadalah relik tipe seni,
Dialogue: 0,0:07:19.81,0:07:21.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan untuk menggunakannya\Ndibutuhkan Daya Selaras.
Dialogue: 0,0:07:22.32,0:07:24.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itulah, relik itu tak cocok denganku.
Dialogue: 0,0:07:25.23,0:07:27.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini benar-benar masalah besar.
Dialogue: 0,0:07:27.86,0:07:29.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu dulu,
Dialogue: 0,0:07:29.23,0:07:32.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}saat ini usianya mungkin sekitar 26 tahun.
Dialogue: 0,0:07:33.06,0:07:37.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, pertama kali dia bertemu\Ndenganku seharusnya lima tahun dari sekarang.
Dialogue: 0,0:07:37.35,0:07:39.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah mati, katamu?
Dialogue: 0,0:07:40.26,0:07:43.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Irene, bolehkah aku\Nmeminta satu bantuan lagi?
Dialogue: 0,0:07:50.23,0:07:53.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kondisi di lokasi kejadian\Nberada dalam kekacauan luar biasa.
Dialogue: 0,0:07:53.21,0:07:57.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fenomena ini diduga berkaitan dengan\Nmakam kuno aneh yang bermunculan selama ini,
Dialogue: 0,0:07:57.50,0:07:59.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}para ahli tengah menganalisisnya.
Dialogue: 0,0:07:59.21,0:08:01.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah misteri ini akhirnya terpecahkan?
Dialogue: 0,0:08:02.08,0:08:03.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berita selanjutnya.
Dialogue: 0,0:08:03.45,0:08:05.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengenai relik berkekuatan luar biasa...
Dialogue: 0,0:08:07.30,0:08:10.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Usaha kita menyembunyikan\Nkeberadaan relik jadi sia-sia...
Dialogue: 0,0:08:13.70,0:08:17.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang memicu relik terang-terangan\Nhingga bangkitkan makam kuno,
Dialogue: 0,0:08:17.88,0:08:19.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mau bicara apa lagi sekarang?
Dialogue: 0,0:08:19.45,0:08:20.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini kecelakaan!
Dialogue: 0,0:08:20.91,0:08:23.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin ada yang menduga\Nkalau di bandara akan ada relik!
Dialogue: 0,0:08:23.94,0:08:28.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, kau seharusnya\Npunya relik keabadian, 'kan?
Dialogue: 0,0:08:28.69,0:08:32.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak disangka kau bisa dikalahkan\Nhanya oleh seorang bocah ingusan.
Dialogue: 0,0:08:33.95,0:08:36.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namanya Gouriki Ryouga, bukan?
Dialogue: 0,0:08:36.50,0:08:40.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh menarik\Ndia bisa melakukan sejauh ini.
Dialogue: 0,0:08:40.33,0:08:41.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diamlah!
Dialogue: 0,0:08:41.83,0:08:44.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimanapun juga,\Nrelik itu butuh direstorasi.
Dialogue: 0,0:08:44.55,0:08:46.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan coba bicara dengan\NRestorator Relik untukmu.
Dialogue: 0,0:08:46.83,0:08:50.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai saat itu tiba,\Nistirahat dan pulihkan dirimu baik-baik.
Dialogue: 0,0:08:50.65,0:08:54.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sampai kau dihajar lagi\Noleh si Gouriki Ryouga itu.
Dialogue: 0,0:09:01.63,0:09:05.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paman Edward, lama tidak berjumpa.
Dialogue: 0,0:09:05.46,0:09:07.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, mengejutkan sekali.
Dialogue: 0,0:09:07.65,0:09:10.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak kusangka kau\Nmengangkat telepon secepat ini.
Dialogue: 0,0:09:10.10,0:09:13.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya Tuan Restorator Relik\Nsedang sangat butuh uang, ya?
Dialogue: 0,0:09:15.66,0:09:18.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat, kau memang sangat memahamiku.
Dialogue: 0,0:09:18.23,0:09:23.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayang sekali situasinya jadi kacau,\Nuntuk sementara aku terpaksa pura-pura mati.
Dialogue: 0,0:09:23.36,0:09:26.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga menghabiskan banyak uang\Nuntuk uang tutup mulut,
Dialogue: 0,0:09:26.91,0:09:28.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}rasanya aku bisa gila.
Dialogue: 0,0:09:29.37,0:09:31.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah melakukan berbagai penipuan,
Dialogue: 0,0:09:31.85,0:09:34.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sampai-sampai kau\Nmerekayasa kematianmu sendiri, ya?
Dialogue: 0,0:09:34.43,0:09:36.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lupakan soal itu.
Dialogue: 0,0:09:36.36,0:09:40.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menghubungiku begini berarti ada pekerjaan\Nyang menghasilkan uang, 'kan?
Dialogue: 0,0:09:40.68,0:09:45.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm. Anggap saja ini permintaan\Ndari orang penting yang kau harapkan.
Dialogue: 0,0:09:47.30,0:09:51.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengenai Bursa Karya Seni\Nyang dikelola orang-orang terdekat Yanagi,
Dialogue: 0,0:09:51.05,0:09:53.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jumlahnya ada lebih dari 50 tempat\Ndi seluruh negeri.
Dialogue: 0,0:09:53.98,0:09:56.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan kau\Nberniat mendatangi semuanya?
Dialogue: 0,0:09:56.61,0:10:00.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Abang, ini sudah tempat terakhir, 'kan?
Dialogue: 0,0:10:01.60,0:10:03.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya aku mau mati saking lelahnya.
Dialogue: 0,0:10:03.80,0:10:05.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan banyak mengeluh, ikuti saja aku.
Dialogue: 0,0:10:07.65,0:10:09.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang.
Dialogue: 0,0:10:10.90,0:10:13.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah ada karya tertentu yang kau cari?
Dialogue: 0,0:10:13.41,0:10:15.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lukisan, patung, atau mungkin...
Dialogue: 0,0:10:15.38,0:10:18.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami datang untuk meminta restorasi relik.
Dialogue: 0,0:10:18.38,0:10:21.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Restorasi... relik?
Dialogue: 0,0:10:22.88,0:10:26.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, Tuan Pelanggan, tempat ini\Nadalah Galeri untuk jual beli karya seni...
Dialogue: 0,0:10:26.95,0:10:27.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diam kau!
Dialogue: 0,0:10:27.89,0:10:30.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya sudah ketahuan!\NBerani-beraninya berbohong!
Dialogue: 0,0:10:30.40,0:10:32.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau mati, ya?!
Dialogue: 0,0:10:34.10,0:10:37.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar bodoh!\NKau berniat mengacaukannya, ya?
Dialogue: 0,0:10:37.10,0:10:39.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hal seperti ini justru yang paling penting\Nkesan pertamanya!
Dialogue: 0,0:10:39.66,0:10:41.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diam kau!\NDasar preman kelas teri!
Dialogue: 0,0:10:41.15,0:10:43.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Preman kelas teri?\N- Kalau bukan, lalu apa?
Dialogue: 0,0:10:43.01,0:10:44.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bukan preman kelas teri!
Dialogue: 0,0:10:45.33,0:10:47.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada berapa banyak ini?
Dialogue: 0,0:10:47.41,0:10:49.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa bisa ada sebanyak ini?
Dialogue: 0,0:10:49.16,0:10:52.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlebih lagi, semuanya tampak memiliki\Ntingkat yang tinggi.
Dialogue: 0,0:10:55.80,0:10:59.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata kau benar-benar tahu\Napa benda-benda ini, ya.
Dialogue: 0,0:11:02.56,0:11:04.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong dibantu.
Dialogue: 0,0:11:05.06,0:11:07.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini adalah relik\Nyang sangat berharga bagiku,
Dialogue: 0,0:11:07.81,0:11:09.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi semuanya mengalami kerusakan.
Dialogue: 0,0:11:09.85,0:11:14.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku disarankan ke sini karena\Nkatanya di sini bisa merestorasinya.
Dialogue: 0,0:11:14.86,0:11:17.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, aku tidak akan membocorkan ini\Nkepada siapa pun,
Dialogue: 0,0:11:17.87,0:11:19.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi tolonglah sekali ini saja.
Dialogue: 0,0:11:21.66,0:11:24.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau memang situasinya seperti itu...
Dialogue: 0,0:11:24.37,0:11:27.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, bisakah kau menunggu sebentar?
Dialogue: 0,0:11:31.67,0:11:33.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bingo.
Dialogue: 0,0:11:33.03,0:11:35.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wanita ini adalah sekretarisnya Yanagi.
Dialogue: 0,0:11:35.65,0:11:38.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang sedang ia hubungi sekarang\Nsudah pasti Yanagi.
Dialogue: 0,0:11:38.17,0:11:43.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena hanya dia yang mampu\Nmerestorasi relik setingkat ini.
Dialogue: 0,0:11:43.18,0:11:46.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga, Yanagi masih hidup.
Dialogue: 0,0:11:47.18,0:11:49.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Relik Tingkat Dewa?
Dialogue: 0,0:11:49.43,0:11:52.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya dia orang yang polos,\Njadi sepertinya mudah ditipu.
Dialogue: 0,0:11:53.10,0:11:54.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana sebaiknya?
Dialogue: 0,0:11:55.80,0:11:58.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, kita harus menyambutnya\Ndengan sangat sopan.
Dialogue: 0,0:12:00.30,0:12:02.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf sudah menunggu.
Dialogue: 0,0:12:02.40,0:12:07.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya galeri ini beroperasi dengan\Nsistem keanggotaan sehingga perlu prosedur,
Dialogue: 0,0:12:07.18,0:12:10.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi karena kau tampak terburu-buru,\Nkami akan berikan pengecualian khusus.
Dialogue: 0,0:12:11.60,0:12:14.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?\NIni sangat membantu.
Dialogue: 0,0:12:14.21,0:12:16.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami akan membawanya ke Ruang Restorasi\Nuntuk memeriksa kondisinya,
Dialogue: 0,0:12:16.86,0:12:18.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi bisakah kau menunggu di sini?
Dialogue: 0,0:12:19.71,0:12:21.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang juga?
Dialogue: 0,0:12:21.56,0:12:24.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkinkah Yanagi ada di sini?
Dialogue: 0,0:12:25.38,0:12:26.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk sekarang aku amati dulu.
Dialogue: 0,0:12:26.72,0:12:29.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, tentu saja. Mohon bantuannya.
Dialogue: 0,0:12:31.30,0:12:33.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar luar biasa.
Dialogue: 0,0:12:33.35,0:12:35.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya ada berapa banyak ini?\NSiapa orang ini sebenarnya?
Dialogue: 0,0:12:35.98,0:12:38.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini benar keterlaluan hebatnya.
Dialogue: 0,0:12:38.50,0:12:40.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, apakah benar-benar tidak apa-apa?
Dialogue: 0,0:12:40.99,0:12:42.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang, tenang.
Dialogue: 0,0:12:42.76,0:12:44.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awasi saja dari meja resepsionis.
Dialogue: 0,0:12:44.58,0:12:46.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masalah sebegini enteng.
Dialogue: 0,0:12:47.43,0:12:51.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alasan dia disebut "Raja Penipu"\Nmeski berstatus sebagai Restorator Relik,
Dialogue: 0,0:12:52.46,0:12:55.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}itu karena dia memiliki\NRelik Replikasi Tingkat B
Dialogue: 0,0:12:55.85,0:12:58.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bernama "Tanda Tangan Rahasia Pelukis Palsu".
Dialogue: 0,0:12:58.34,0:13:02.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan dalih restorasi,\Ndia menerima titipan relik,
Dialogue: 0,0:13:02.18,0:13:04.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menyerahkan barang tiruan\Nkepada sang pemohon,
Dialogue: 0,0:13:04.58,0:13:06.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan menyimpan barang aslinya sendiri.
Dialogue: 0,0:13:08.22,0:13:11.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Barang tiruan itu bahkan\Nmemancarkan aura khas relik.
Dialogue: 0,0:13:11.60,0:13:13.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Auranya baru akan hilang\Nsetelah setengah hari,
Dialogue: 0,0:13:13.45,0:13:16.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi sampai saat itu tidak akan ada\Nyang menyadari kalau itu tiruan.
Dialogue: 0,0:13:24.01,0:13:25.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf sudah menunggu.
Dialogue: 0,0:13:26.26,0:13:27.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak masalah.
Dialogue: 0,0:13:27.44,0:13:29.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kondisi reliknya?
Dialogue: 0,0:13:29.03,0:13:33.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal itu, setelah diperiksa,\Ntampaknya kerusakannya sangat parah,
Dialogue: 0,0:13:33.91,0:13:37.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sehingga sepertinya\Nsulit dipulihkan di tempat kami...
Dialogue: 0,0:13:37.16,0:13:39.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, begitu, ya.
Dialogue: 0,0:13:40.26,0:13:41.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga.
Dialogue: 0,0:13:43.30,0:13:44.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:13:44.97,0:13:47.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan lapor ke kantor polisi, lo!
Dialogue: 0,0:13:48.46,0:13:51.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berisik amat!\NDiam dan jangan melawan!
Dialogue: 0,0:13:58.36,0:13:59.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa kau?
Dialogue: 0,0:14:02.48,0:14:04.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah lama, ya.
Dialogue: 0,0:14:05.46,0:14:06.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si-Siapa kau sebenarnya?
Dialogue: 0,0:14:06.99,0:14:09.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ikat dia, Tali Tambang!
Dialogue: 0,0:14:15.18,0:14:16.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, lepaskan aku!
Dialogue: 0,0:14:21.50,0:14:23.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar bajingan sialan!
Dialogue: 0,0:14:23.30,0:14:26.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau apa kau tiba-tiba begini?!\NHei, hei, hei!
Dialogue: 0,0:14:26.01,0:14:27.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau tidak tahu siapa aku?
Dialogue: 0,0:14:27.51,0:14:32.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Yanagi, jangan terbawa emosi begitu.\NBuatlah kontrak denganku.
Dialogue: 0,0:14:32.18,0:14:33.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kau mau, akan kulepaskan ikatannya.
Dialogue: 0,0:14:33.83,0:14:37.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sialan! Diam, lepaskan talinya!
Dialogue: 0,0:14:37.15,0:14:39.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat! Kontrak, katamu?
Dialogue: 0,0:14:39.02,0:14:40.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Jangan bercanda!\N- Dia ini...
Dialogue: 0,0:14:40.52,0:14:42.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Hei! Kau dengar tidak, sih?!\N- Tampaknya sudah benar-benar hancur.
Dialogue: 0,0:14:42.64,0:14:44.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kubilang cepat lepaskan aku!
Dialogue: 0,0:14:44.30,0:14:47.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Yanagi awalnya bukan orang seperti ini.\N- Mau sampai kapan kau cuma melihat saja, hah?!
Dialogue: 0,0:14:47.46,0:14:48.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa malah diam saja!
Dialogue: 0,0:14:49.06,0:14:52.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia adalah seniman pendatang baru\Nyang sempat mencuri perhatian,
Dialogue: 0,0:14:52.83,0:14:56.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bahkan sampai masuk universitas bergengsi\Ndi Amerika dengan beasiswa penuh.
Dialogue: 0,0:14:57.14,0:15:01.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, malangnya,\Ngaya melukis khas Yanagi malah dicuri.
Dialogue: 0,0:15:04.20,0:15:07.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelakunya adalah gurunya sendiri,\NJean Richard.
Dialogue: 0,0:15:07.58,0:15:12.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yanagi dituduh sebagai peniru Jean Richard
Dialogue: 0,0:15:12.47,0:15:15.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan disingkirkan dari dunia seni.
Dialogue: 0,0:15:15.76,0:15:18.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelukis genius muda\Nyang hancur masa depannya itu
Dialogue: 0,0:15:18.48,0:15:21.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mulai memanfaatkan\Nbakat hebatnya untuk menipu.
Dialogue: 0,0:15:22.68,0:15:24.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat berada di titik terendah hidupnya,
Dialogue: 0,0:15:24.52,0:15:27.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yanagi mendapatkan\Nrelik Tanda Tangan Rahasia
Dialogue: 0,0:15:27.36,0:15:30.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan mulai beraksi sebagai seorang penipu.
Dialogue: 0,0:15:31.08,0:15:34.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, mau sampai kapan\Nkau berdiri melamun di situ?
Dialogue: 0,0:15:34.61,0:15:35.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengar, tidak?
Dialogue: 0,0:15:35.20,0:15:37.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Jangan-jangan kau suka hal semacam ini?\N- Kalau dalam kondisi begini,
Dialogue: 0,0:15:37.20,0:15:39.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kata-kata apa pun untuk membujuknya\Ntidak mempan.
Dialogue: 0,0:15:39.45,0:15:41.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak tertarik sama sekali!
Dialogue: 0,0:15:41.96,0:15:45.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mati saja sana! Dasar psikopat!
Dialogue: 0,0:15:47.03,0:15:49.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudahlah, tidak perlu membujuknya lagi.
Dialogue: 0,0:15:49.86,0:15:51.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tahu ini apa?
Dialogue: 0,0:15:51.43,0:15:54.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini adalah "Pena Shakespeare Masa Kecil".
Dialogue: 0,0:15:54.93,0:15:58.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benda ini punya kekuatan mewujudkan\Napa yang ditulis menjadi kenyataan.
Dialogue: 0,0:15:58.43,0:16:01.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}He-Hei! Mau apa kau?!
Dialogue: 0,0:16:01.45,0:16:04.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yanagi Koutarou yang malang\Ndan tergantung terbalik akan tersiksa
Dialogue: 0,0:16:04.76,0:16:07.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}oleh rasa sakit luar biasa\Nhingga nyaris mati.
Dialogue: 0,0:16:08.08,0:16:10.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagian tubuh yang diserang\Nrasa sakit luar biasa itu...
Dialogue: 0,0:16:11.60,0:16:12.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di selangkangan.
Dialogue: 0,0:16:20.45,0:16:23.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begini namanya\Nbenar-benar Kontrak Perbudakan!
Dialogue: 0,0:16:23.96,0:16:26.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Kontrak Perbudakan"?
Dialogue: 0,0:16:26.15,0:16:28.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebut saja "Kontrak Eksklusif".
Dialogue: 0,0:16:28.12,0:16:30.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau ini, itu sama saja, tahu!
Dialogue: 0,0:16:30.59,0:16:34.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, kalau melanggar kontrak,\NUndang-Undang Hammurabi menghukum?
Dialogue: 0,0:16:34.82,0:16:36.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana maksudmu?
Dialogue: 0,0:16:38.60,0:16:41.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba lihat baik-baik,\Nberapa uang muka kontraknya?
Dialogue: 0,0:16:41.91,0:16:43.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enam ribu dolar, lo!
Dialogue: 0,0:16:43.48,0:16:46.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum lagi kau bakal dapat bonus\Nsesuai jumlah relik yang direstorasi.
Dialogue: 0,0:16:46.95,0:16:48.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini syarat yang sangat menguntungkan.
Dialogue: 0,0:16:48.98,0:16:49.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diam!
Dialogue: 0,0:16:49.95,0:16:53.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah memutuskan untuk\Nmembuat kontrak dengan Ketua TKBM.
Dialogue: 0,0:16:53.58,0:16:56.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tahu, 'kan? Ini TKBM, lo!
Dialogue: 0,0:16:56.28,0:16:57.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar karakter figuran keroco!
Dialogue: 0,0:16:59.80,0:17:02.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya. Lumayan menarik juga.
Dialogue: 0,0:17:02.80,0:17:06.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak kusangka Ogawara sudah tahu\Ntentang keberadaan Restorator Relik.
Dialogue: 0,0:17:07.26,0:17:09.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, sekarang bagaimana baiknya?
Dialogue: 0,0:17:09.59,0:17:13.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk sementara, sudah kuikat dengan\Nkontrak Undang-Undang Hammurabi, tapi...
Dialogue: 0,0:17:13.70,0:17:17.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yanagi yang nantinya bisa menangani\Nrelik Tingkat Dewa harus kutarik ke pihakku
Dialogue: 0,0:17:17.11,0:17:18.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}agar ia bergabung sepenuhnya.
Dialogue: 0,0:17:21.47,0:17:24.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita saling mengenal satu sama lain.
Dialogue: 0,0:17:24.98,0:17:28.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Gouriki Ryouga, datang dari Tokyo.
Dialogue: 0,0:17:28.30,0:17:32.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pekerjaanku adalah\Npemimpin Tim Ekskavasi Baru.
Dialogue: 0,0:17:32.21,0:17:34.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin merekrutmu.
Dialogue: 0,0:17:34.40,0:17:36.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, sekarang giliranmu.
Dialogue: 0,0:17:36.99,0:17:40.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perkenalan diri, katamu?\NOgah amat!
Dialogue: 0,0:17:40.46,0:17:41.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:17:42.58,0:17:44.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar aku saja yang mewakili?
Dialogue: 0,0:17:45.63,0:17:47.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yanagi Koutarou,
Dialogue: 0,0:17:47.25,0:17:49.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mahasiswa seni\Nyang sedang studi di luar negeri.
Dialogue: 0,0:17:49.38,0:17:52.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau punya kemampuan\Ndan semangat yang tinggi, tapi...
Dialogue: 0,0:17:52.46,0:17:56.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang kau melakukan penipuan\Ndi LA memakai karya tiruan.
Dialogue: 0,0:17:56.45,0:17:58.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peniru Jean Richard.
Dialogue: 0,0:17:59.70,0:18:01.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tahu apa soal aku?!
Dialogue: 0,0:18:01.61,0:18:03.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bajingan Jean Richard itu
Dialogue: 0,0:18:03.35,0:18:06.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang sudah mencuri gaya melukisku!
Dialogue: 0,0:18:07.43,0:18:09.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jean Richard yang melakukannya?
Dialogue: 0,0:18:09.73,0:18:13.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya gaya melukis\Nbisa ditiru semudah itu? Hah?
Dialogue: 0,0:18:13.83,0:18:17.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau lukisannya sudah selesai dibuat,\Nmungkin bisa ditiru.
Dialogue: 0,0:18:18.74,0:18:22.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi bajingan itu bahkan menggambar lukisan\Nyang baru ada di kepalaku!
Dialogue: 0,0:18:23.23,0:18:26.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seolah-olah dia bisa\Nmengintip langsung ke pikiranku...
Dialogue: 0,0:18:26.03,0:18:27.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya aku benar-benar bisa gila.
Dialogue: 0,0:18:29.55,0:18:31.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membaca sampai ke dalam pikiran, ya?
Dialogue: 0,0:18:32.90,0:18:34.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin ada caranya.
Dialogue: 0,0:18:36.08,0:18:38.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemungkinan besar Jean Richard\Nadalah Pengguna Relik.
Dialogue: 0,0:18:38.91,0:18:42.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena ada juga relik yang mampu\Nmenyalin sempurna kemampuan orang lain.
Dialogue: 0,0:18:44.54,0:18:47.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari mana kau tahu soal itu?\NApa kau yakin?
Dialogue: 0,0:18:47.23,0:18:49.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat paham soal hal semacam ini.
Dialogue: 0,0:18:49.30,0:18:50.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, bagaimana kalau begini?
Dialogue: 0,0:18:50.98,0:18:55.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kurebut kembali gaya melukis dan\Nreputasi yang telah dirampas Jean Richard.
Dialogue: 0,0:18:55.48,0:18:59.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai gantinya, bagaimana kalau kau\Njadi Restorator Relik eksklusifku?
Dialogue: 0,0:19:00.20,0:19:02.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jean Richard... adalah Pengguna Relik?
Dialogue: 0,0:19:06.24,0:19:08.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, tunggu!
Dialogue: 0,0:19:08.16,0:19:10.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Abang, orang itu kabur!
Dialogue: 0,0:19:11.06,0:19:14.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biarkan saja.\NAku sudah tahu dia akan pergi ke mana.
Dialogue: 0,0:19:16.51,0:19:20.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi karena itulah dia\Nbisa dengan mudah meniru lukisanku.
Dialogue: 0,0:19:20.01,0:19:22.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengguna Relik?
Dialogue: 0,0:19:22.01,0:19:25.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jean Richard, riwayatmu sudah tamat.
Dialogue: 0,0:19:26.56,0:19:29.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Restorator Relik\Nyang dibicarakan oleh Edward?
Dialogue: 0,0:19:30.02,0:19:32.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak kusangka kau akan\Ndatang berkunjung tiba-tiba begini.
Dialogue: 0,0:19:32.76,0:19:35.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah kau sedang bersembunyi?
Dialogue: 0,0:19:35.02,0:19:38.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menerima tawaran\Nrestorasi relik yang Anda ajukan.
Dialogue: 0,0:19:38.57,0:19:41.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu, ya. Kalau begitu,\Nkupercayakan padamu.
Dialogue: 0,0:19:41.35,0:19:43.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, ada syaratnya.
Dialogue: 0,0:19:43.25,0:19:44.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syarat?
Dialogue: 0,0:19:44.07,0:19:49.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah tahu kalau Ketua\Nsedang mengumpulkan relik-relik ternama.
Dialogue: 0,0:19:49.20,0:19:52.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika syaratnya sama,\Nberurusan dengan Ketua jauh lebih baik.
Dialogue: 0,0:19:52.34,0:19:55.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Anda kenal Jean Richard?
Dialogue: 0,0:19:55.02,0:19:56.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja aku tahu.
Dialogue: 0,0:19:56.14,0:19:59.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia adalah pelukis genius\Nyang terkenal di seluruh dunia.
Dialogue: 0,0:19:59.05,0:20:02.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bajingan itu menggunakan relik\Nuntuk meniru gaya melukisku
Dialogue: 0,0:20:02.51,0:20:04.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}demi mendapatkan ketenarannya sekarang.
Dialogue: 0,0:20:04.40,0:20:07.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong rebut relik itu darinya!
Dialogue: 0,0:20:07.25,0:20:11.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika berhasil, aku bersedia\Nmenandatangani Kontrak Eksklusif.
Dialogue: 0,0:20:15.83,0:20:17.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sungguh menarik.
Dialogue: 0,0:20:20.40,0:20:24.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo, Richard. Barusan aku\Nmendengar cerita yang sangat menarik.
Dialogue: 0,0:20:24.51,0:20:26.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau kenal Yanagi Koutarou?
Dialogue: 0,0:20:29.56,0:20:32.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yanagi, kau pikir tempat apa itu?
Dialogue: 0,0:20:33.00,0:20:35.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang\Ndiamlah kalau masih mau hidup.
Dialogue: 0,0:20:36.02,0:20:37.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana?
Dialogue: 0,0:20:37.23,0:20:40.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kali ini sebaiknya kukubur saja\Nkau hidup-hidup sampai mati?
Dialogue: 0,0:20:40.80,0:20:43.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang, tenanglah dulu Richard.
Dialogue: 0,0:20:43.51,0:20:45.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar aku yang mengurusnya.
Dialogue: 0,0:20:47.10,0:20:50.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, bagaimana sekarang?\NTampaknya kau kecewa, ya.
Dialogue: 0,0:20:50.78,0:20:54.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti yang kau lihat,\Nhubunganku dengan Richard cukup dekat.
Dialogue: 0,0:21:02.26,0:21:05.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan ini?\NTiba-tiba menyerang begini, maksudnya apa?
Dialogue: 0,0:21:07.91,0:21:10.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, hati-hati jangan sampai\Nmematahkan lengannya.
Dialogue: 0,0:21:10.70,0:21:11.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Baik.\N- Baik.
Dialogue: 0,0:21:12.22,0:21:13.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar orang-orang berengsek!
Dialogue: 0,0:21:23.13,0:21:24.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Strateginya berhasil, ya.
Dialogue: 0,0:21:27.23,0:21:30.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan cuma itu, jangan-jangan\Ndia jadi penggemar beratku?
Dialogue: 0,0:23:05.82,0:23:07.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuh, 'kan?\NTindakannya persis seperti dugaanku.
Dialogue: 0,0:23:07.93,0:23:09.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kau bisa tahu aku ada di sini?
Dialogue: 0,0:23:09.55,0:23:11.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada sedikit alasan.
Dialogue: 0,0:23:11.11,0:23:13.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang sedang kau pikirkan itu\Nsudah sangat terbaca.
Dialogue: 0,0:23:13.91,0:23:17.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, bukankah kita ini punya\Nhubungan Kontrak Eksklusif?
Dialogue: 0,0:23:17.35,0:23:19.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai sekarang, mari kita akur.
Dialogue: 0,0:23:19.96,0:23:21.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu namanya Kontrak Perbudakan!
Dialogue: 0,0:23:21.38,0:23:23.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana sudi aku akur denganmu!
Dialogue: 0,0:23:23.17,0:23:25.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, aku paham.
Dialogue: 0,0:23:25.18,0:23:27.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, informasi selanjutnya sudah didapatkan.
Dialogue: 0,0:23:27.63,0:23:29.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada waktu untuk berleha-leha.
Dialogue: 0,0:23:29.63,0:23:31.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus segera pergi mencari reliknya.
Dialogue: 0,0:23:32.06,0:23:34.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya, "Rahasia Gagak".
Dialogue: 0,0:23:34.28,0:23:36.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada banyak makhluk menjijikkan\Nyang datang kemari, tahu!
