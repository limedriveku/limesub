Dialogue: 0,0:01:38.09,0:01:41.72,sign,,0000,0000,0000,,EPISODE 11: RELIK TENPUKU
Dialogue: 0,0:07:09.30,0:07:11.07,sign,,0000,0000,0000,,KALI INI DIA MENDAMBAKAN BIBIR ANDA
Dialogue: 0,0:07:47.96,0:07:50.15,sign,,0000,0000,0000,,PERHATIAN: TELAH MEMASUKI AREA KOFUNISASI\NYANG HANYA BISA DIDEKATI OLEH ANAK-ANAK.
Dialogue: 0,0:07:55.72,0:07:56.10,sign,,0000,0000,0000,,PERHATIAN: TELAH MEMASUKI AREA KOFUNISASI\NYANG HANYA BISA DIDEKATI OLEH ANAK-ANAK.
Dialogue: 0,0:07:56.10,0:07:59.41,sign,,0000,0000,0000,,MAKAM KUNO INI TELAH DITAKLUKKAN.\NMAKAM KUNO RELIK YANG TELAH MEMILIKI PEMILIK.
Dialogue: 0,0:08:33.11,0:08:36.62,sign,,0000,0000,0000,,KARENA MAKAM KUNO INI TELAH DITAKLUKKAN,\NPERALATAN BUATAN MANUSIA DAPAT DIGUNAKAN DI SINI
Dialogue: 0,0:09:07.00,0:09:09.25,sign,,0000,0000,0000,,ANAK-ANAK SEDANG DIMANIPULASI\NOLEH RELIK TENPUKU
Dialogue: 0,0:09:09.25,0:09:11.36,sign,,0000,0000,0000,,MEREKA MEMANEN DAUN TEH\NATAS PERINTAH SANG RELIK
Dialogue: 0,0:09:14.05,0:09:17.59,sign,,0000,0000,0000,,PERKEBUNAN TEH YANG DISEMAYAMI KEKUATAN\NBERTUBUH MANUSIA BERKEPALA KERBAU.
Dialogue: 0,0:09:17.59,0:09:18.88,sign,,0000,0000,0000,,MEMANCARKAN AROMA YANG SANGGUP\NMEMBANGKITKAN ORANG MATI,
Dialogue: 0,0:09:18.88,0:09:20.49,sign,,0000,0000,0000,,MEMBERIKAN RASA BAHAGIA TAK TERLUPAKAN\NBEGITU DICICIPI SEKALI SAJA
Dialogue: 0,0:13:01.90,0:13:02.84,sign,,0000,0000,0000,,KONTRAK SELESAI
Dialogue: 0,0:19:25.16,0:19:26.54,sign,,0000,0000,0000,,GOURIKI RYOUGA
Dialogue: 0,0:19:40.63,0:19:41.84,sign,,0000,0000,0000,,GOURIKI RYOUGA
Dialogue: 0,0:20:18.98,0:20:20.40,sign,,0000,0000,0000,,KAPTEN PETANI
Dialogue: 0,0:23:37.36,0:23:41.22,sign,,0000,0000,0000,,EPISODE 12\NTOMB RAIDER KING
Dialogue: 0,0:01:44.11,0:01:46.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, mari kita coba bermain.
Dialogue: 0,0:01:50.96,0:01:52.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat jalan, dong.
Dialogue: 0,0:01:54.08,0:01:54.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sialan.
Dialogue: 0,0:01:54.90,0:01:55.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kalah telak.
Dialogue: 0,0:01:55.91,0:01:58.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Baiklah, giliranku.\N- Mana mungkin begitu!
Dialogue: 0,0:02:00.38,0:02:03.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apanya yang mana mungkin?\NKau cuma kurang jago saja.
Dialogue: 0,0:02:03.71,0:02:07.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimanapun juga, tidak mungkin\Nkartu sebagus itu keluar berturut-turut!
Dialogue: 0,0:02:07.11,0:02:08.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei.
Dialogue: 0,0:02:08.47,0:02:10.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau urusanmu sudah selesai,\Nangkat kaki, sana.
Dialogue: 0,0:02:10.78,0:02:13.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga mau bertanding\Nsatu putaran melawan mereka.
Dialogue: 0,0:02:13.15,0:02:14.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa katamu?
Dialogue: 0,0:02:18.25,0:02:19.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku apes sekali hari ini.
Dialogue: 0,0:02:19.97,0:02:22.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa kau?\NAku belum pernah melihat wajahmu.
Dialogue: 0,0:02:22.58,0:02:24.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai sekarang kau akan mengenalku.
Dialogue: 0,0:02:25.60,0:02:26.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Duduklah.
Dialogue: 0,0:02:29.88,0:02:30.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Straight.
Dialogue: 0,0:02:31.02,0:02:32.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Four of a Kind, angka dua.
Dialogue: 0,0:02:32.04,0:02:33.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Three of a Kind, kartu As.
Dialogue: 0,0:02:34.80,0:02:37.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Royal Straight Flush.
Dialogue: 0,0:02:37.05,0:02:38.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil.
Dialogue: 0,0:02:39.05,0:02:40.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin bisa begini?
Dialogue: 0,0:02:48.25,0:02:50.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebuah koin misterius\Nyang diberkati Dewi Keberuntungan.
Dialogue: 0,0:02:51.27,0:02:53.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Koin yang dilemparkan orang\Ndemi mengharapkan kebahagiaan
Dialogue: 0,0:02:53.60,0:02:55.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}telah termanifestasi jadi relik, ya?
Dialogue: 0,0:02:56.67,0:02:57.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari mana kau bisa tahu?
Dialogue: 0,0:02:57.81,0:03:00.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau memakai cara curang ini\Nuntuk memanipulasi kartu bagus, 'kan?
Dialogue: 0,0:03:01.00,0:03:02.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi sayangnya, koin ini cuma Tingkat C.
Dialogue: 0,0:03:03.78,0:03:05.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sementara yang kuhujankan ke arahmu ini
Dialogue: 0,0:03:05.47,0:03:07.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kesialan dari relik Tingkat SS\N"Tangan Kebangkrutan".
Dialogue: 0,0:03:10.42,0:03:11.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sudah aman, 'kan?
Dialogue: 0,0:03:13.54,0:03:14.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona.
Dialogue: 0,0:03:15.44,0:03:17.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus sekali,\Nkendalimu sudah jauh lebih baik.
Dialogue: 0,0:03:19.00,0:03:22.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkat kekuatan Irene, siapa pun selain kita\Nakan tertimpa kemalangan.
Dialogue: 0,0:03:22.71,0:03:25.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah sewajarnya kartu-kartu bagus\Nakan berpihak kepadaku.
Dialogue: 0,0:03:27.71,0:03:29.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bawa ini dan pergilah dari sini.
Dialogue: 0,0:03:29.25,0:03:30.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih kurang.
Dialogue: 0,0:03:30.45,0:03:32.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Jangan konyol!
Dialogue: 0,0:03:32.15,0:03:34.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Jumlah ini...\N- Kau juga harus bayar ganti rugi curangmu.
Dialogue: 0,0:03:34.55,0:03:36.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keringanannya satu juta dolar per orang.
Dialogue: 0,0:03:37.51,0:03:39.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa katamu?\NJangan main-main!
Dialogue: 0,0:03:42.95,0:03:46.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pikir aku akan maafkan begitu saja?
Dialogue: 0,0:03:46.15,0:03:47.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan harap bisa semudah itu.
Dialogue: 0,0:03:47.98,0:03:50.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak punya uang,\Nbisa diganti barang lain,
Dialogue: 0,0:03:50.07,0:03:51.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kebetulan aku orangnya cukup baik hati.
Dialogue: 0,0:03:52.45,0:03:55.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan Relik Tenpuku yang digunakan\Nuntuk mengumpulkan anak-anak itu.
Dialogue: 0,0:03:56.79,0:03:57.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:03:58.05,0:04:01.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, buka mulutmu dan katakan\Napa yang sebenarnya sedang direncanakan
Dialogue: 0,0:04:01.35,0:04:02.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}oleh Keira di sini.
Dialogue: 0,0:04:02.38,0:04:03.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurang ajar!
Dialogue: 0,0:04:04.25,0:04:07.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bicara apa kau?\NJadi itu alasanmu mendekatiku?
Dialogue: 0,0:04:07.31,0:04:09.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak ada informasi\Nyang sudi kuberikan padamu...
Dialogue: 0,0:04:10.98,0:04:11.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perutku...
Dialogue: 0,0:04:12.98,0:04:14.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa tiba-tiba begini?
Dialogue: 0,0:04:19.37,0:04:20.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah.
Dialogue: 0,0:04:20.85,0:04:22.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya ini agak kelewatan.
Dialogue: 0,0:04:25.91,0:04:28.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona, suara teriakan itu...
Dialogue: 0,0:04:31.55,0:04:32.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona.
Dialogue: 0,0:04:35.15,0:04:36.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan!
Dialogue: 0,0:04:36.65,0:04:38.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan bicara, tolong hentikan!
Dialogue: 0,0:04:39.61,0:04:42.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelihatannya cukup manjur, ya sudahlah.
Dialogue: 0,0:04:43.04,0:04:45.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katakan begitu dari tadi.\NDi mana informasinya?
Dialogue: 0,0:04:45.61,0:04:46.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Utara!
Dialogue: 0,0:04:46.57,0:04:49.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di hutan sebelah utara, a-ada makam kunonya.
Dialogue: 0,0:04:49.41,0:04:51.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Relik Tenpuku juga berada di sana.
Dialogue: 0,0:04:52.55,0:04:54.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku juga tidak tahu detailnya.
Dialogue: 0,0:04:55.77,0:04:57.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat, Nona tiba-tiba...
Dialogue: 0,0:04:57.71,0:04:58.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:05:03.95,0:05:05.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Irene, kau di mana?
Dialogue: 0,0:05:05.55,0:05:06.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong jawab!
Dialogue: 0,0:05:09.71,0:05:11.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga, ke mana dia pergi?
Dialogue: 0,0:05:11.74,0:05:13.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini jelas efek samping dari risikonya.
Dialogue: 0,0:05:13.41,0:05:15.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya aku tak memberi\Ntugas padanya saat dia
Dialogue: 0,0:05:15.55,0:05:17.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}belum terbiasa\Nmengendalikan relik, ini salahku.
Dialogue: 0,0:05:20.92,0:05:23.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mencarinya membabi buta begini\Ntak akan membuahkan hasil.
Dialogue: 0,0:05:23.82,0:05:24.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pikirkan baik-baik.
Dialogue: 0,0:05:26.79,0:05:29.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cukup lacak aura\Nyang dipancarkan relik Irene.
Dialogue: 0,0:05:40.98,0:05:41.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketemu!
Dialogue: 0,0:05:42.48,0:05:43.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Arah sana?
Dialogue: 0,0:05:43.61,0:05:44.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Posisinya sangat dekat.
Dialogue: 0,0:05:56.64,0:05:58.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal ada hotel yang bagus,
Dialogue: 0,0:05:58.58,0:06:00.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kenapa harus di tempat seperti ini?
Dialogue: 0,0:06:13.81,0:06:15.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ryouga...
Dialogue: 0,0:06:16.21,0:06:17.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, hei.
Dialogue: 0,0:06:19.58,0:06:22.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada Ryouga yang asli.
Dialogue: 0,0:06:22.75,0:06:24.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minum alkohol sebanyak ini...
Dialogue: 0,0:06:26.05,0:06:27.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kau lakukan?
Dialogue: 0,0:06:35.05,0:06:36.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini...
Dialogue: 0,0:06:36.04,0:06:37.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan, risikonya?
Dialogue: 0,0:07:11.60,0:07:13.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, hei! Terlambat, tahu!
Dialogue: 0,0:07:13.81,0:07:18.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beri tahu aku lebih cepat!\NDasar Gagak menyebalkan!
Dialogue: 0,0:07:22.48,0:07:24.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pesawat pribadi milik Keluarga Hilton?
Dialogue: 0,0:07:24.71,0:07:26.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar. Berdasarkan penyelidikan,
Dialogue: 0,0:07:26.51,0:07:29.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tampaknya ada anggota Keluarga Hilton\Nyang membantu mereka.
Dialogue: 0,0:07:30.05,0:07:33.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pesawat pribadi tersebut\Nsaat ini sedang menuju ke Vent.
Dialogue: 0,0:07:33.45,0:07:35.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keluarga Hilton lalu Republik Vent, ya.
Dialogue: 0,0:07:35.93,0:07:37.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menarik sekali.
Dialogue: 0,0:07:50.15,0:07:52.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rupanya hanya anak-anak\Nyang diizinkan mendekat, ya.
Dialogue: 0,0:07:52.98,0:07:55.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dugaanku benar,\NRelik Tenpuku memang berada di sini.
Dialogue: 0,0:07:59.41,0:08:03.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, apa alasan makam ini tidak langsung\Nditutup setelah reliknya dikuasai?
Dialogue: 0,0:08:03.78,0:08:05.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa Keira repot-repot membiarkannya?
Dialogue: 0,0:08:05.93,0:08:08.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat serahkan relik ubi jalar\Nberperingkat rendah itu padaku.
Dialogue: 0,0:08:08.95,0:08:10.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Relik ubi jalar?
Dialogue: 0,0:08:10.66,0:08:11.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan, kau mau...
Dialogue: 0,0:08:13.75,0:08:17.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mau! Mana mau!\NPokoknya tidak mau! Jahat sekali!
Dialogue: 0,0:08:24.08,0:08:29.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, duh. Ayolah pemimpin, sekali-kali kita\Nmasuk lewat pintu masuk yang normal, dong.
Dialogue: 0,0:08:29.28,0:08:31.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begini percuma punya banyak nyawa pun.
Dialogue: 0,0:08:38.62,0:08:39.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:08:40.15,0:08:41.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ponselnya mendapat sinyal.
Dialogue: 0,0:08:41.83,0:08:43.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemimpin,
Dialogue: 0,0:08:43.95,0:08:45.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}i-itu kan...
Dialogue: 0,0:08:50.65,0:08:52.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada perkebunan teh sebesar ini\Ndi bawah tanah?
Dialogue: 0,0:08:53.78,0:08:54.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan ada banyak anak-anak.
Dialogue: 0,0:08:55.60,0:08:57.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meskipun baru saja terjadi\Nledakan sedahsyat itu,
Dialogue: 0,0:08:58.00,0:09:00.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mereka sama sekali tak gentar\Ndan tetap bekerja tanpa henti.
Dialogue: 0,0:09:01.10,0:09:03.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Persis orang yang sedang berada\Ndi bawah pengaruh hipnosis.
Dialogue: 0,0:09:04.01,0:09:06.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemandangan yang benar-benar janggal.
Dialogue: 0,0:09:21.01,0:09:22.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga.
Dialogue: 0,0:09:22.38,0:09:25.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga,\N"tubuh manusia berkepala kerbau".
Dialogue: 0,0:09:25.31,0:09:29.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tokoh yang bertubuh manusia berkepala kerbau\Nserta erat kaitannya dengan teh.
Dialogue: 0,0:09:29.88,0:09:33.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perkebunan teh ini diciptakan\Noleh Relik "Shennong".
Dialogue: 0,0:09:33.61,0:09:35.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shennong?
Dialogue: 0,0:09:35.33,0:09:37.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shennong adalah sosok\Nyang pertama kali menciptakan alat tani
Dialogue: 0,0:09:37.85,0:09:39.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan mengajarkan cara bercocok tanam.
Dialogue: 0,0:09:41.01,0:09:43.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Konon kabarnya,\Ndia mencicipi segala tanaman liar
Dialogue: 0,0:09:43.23,0:09:45.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk membedakan herba obat dan racun,
Dialogue: 0,0:09:45.25,0:09:49.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu menetralkan racun di tubuhnya\Ndengan mengunyah daun teh.
Dialogue: 0,0:09:50.51,0:09:52.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, di mana Relik Tenpuku?
Dialogue: 0,0:09:53.35,0:09:55.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu pun pasti berada\Ndi suatu tempat di sekitar sini.
Dialogue: 0,0:09:56.15,0:09:58.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat menggali makam kuno ini dulu,
Dialogue: 0,0:09:58.23,0:10:00.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keira juga menemukan\Nkeberadaan perkebunan teh ini.
Dialogue: 0,0:10:01.01,0:10:02.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu tahu daun teh ini dihasilkan relik,
Dialogue: 0,0:10:02.99,0:10:04.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia pasti memutuskan memanennya\Nsecara berkala.
Dialogue: 0,0:10:06.11,0:10:10.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena ada batasan wilayah makam kuno\Nyang hanya bisa dimasuki anak-anak,
Dialogue: 0,0:10:10.15,0:10:11.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia memanfaatkan Relik Tenpuku
Dialogue: 0,0:10:11.51,0:10:14.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk menculik anak-anak\Ndan memperbudak mereka di sini.
Dialogue: 0,0:10:16.15,0:10:20.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, tanpa membuang waktu,\Nmari kita ambil kedua relik itu.
Dialogue: 0,0:10:21.37,0:10:23.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah! Ryouga, anak-anak itu...
Dialogue: 0,0:10:34.55,0:10:35.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona!
Dialogue: 0,0:10:38.01,0:10:39.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang giliranmu, Tali Tambang!\NIkat mereka!
Dialogue: 0,0:10:40.91,0:10:41.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap!
Dialogue: 0,0:10:43.41,0:10:45.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo main!
Dialogue: 0,0:10:46.08,0:10:49.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyenangkan, bukan?\NAyo kita main! Ayo main!
Dialogue: 0,0:10:51.06,0:10:52.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah, kita selamat.
Dialogue: 0,0:10:52.18,0:10:53.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian baik-baik saja di sana?
Dialogue: 0,0:10:53.85,0:10:55.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, kami baik-baik saja.
Dialogue: 0,0:10:56.01,0:10:59.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm. Rupanya relik sialan itu\Nsudah menampakkan diri.
Dialogue: 0,0:10:59.45,0:11:02.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baguslah kalau dia memancarkan auranya,\Nitu malah mempermudah urusanku.
Dialogue: 0,0:11:12.34,0:11:14.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, aduh, sakit!\NSingkirkan ini dariku!
Dialogue: 0,0:11:15.15,0:11:17.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lo? Dari mana asal suara ini?
Dialogue: 0,0:11:17.78,0:11:19.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, ternyata kau ada di sini.
Dialogue: 0,0:11:21.09,0:11:24.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Bagaimana kau bisa tahu keberadaanku?!\NSialan!
Dialogue: 0,0:11:24.12,0:11:27.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya siapa yang dari tadi\Nmemancarkan aura sebesar itu?
Dialogue: 0,0:11:27.69,0:11:28.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keparat!
Dialogue: 0,0:11:29.85,0:11:32.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa kau sebenarnya?
Dialogue: 0,0:11:33.41,0:11:34.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar manusia licik tak tahu diri!
Dialogue: 0,0:11:35.79,0:11:39.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang dulu, aku tidak akan menyakitimu,\Njadi tenangkan dirimu.
Dialogue: 0,0:11:41.25,0:11:42.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:11:42.38,0:11:43.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk apa aku berbohong padamu?
Dialogue: 0,0:11:43.98,0:11:46.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau kita berdua\Nmembuat kesepakatan?
Dialogue: 0,0:11:46.73,0:11:49.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu kalau kau\Nsangat tergila-gila pada uang.
Dialogue: 0,0:11:49.33,0:11:50.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katakan saja.
Dialogue: 0,0:11:50.55,0:11:52.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berapa yang harus kubayar untuk membelimu?
Dialogue: 0,0:11:52.90,0:11:54.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu sebentar, Pemimpin.
Dialogue: 0,0:11:54.16,0:11:56.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang sedang kau bicarakan\Ndengan relik cacing tanah itu?
Dialogue: 0,0:11:57.38,0:12:01.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama seperti Tenpuku, makhluk ini adalah\N"relik tipe pemeras".
Dialogue: 0,0:12:01.35,0:12:04.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Risikonya pun bisa diselesaikan\Ndengan memberikan sejumlah uang.
Dialogue: 0,0:12:04.41,0:12:05.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Diselesaikan dengan uang?
Dialogue: 0,0:12:06.31,0:12:09.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh! Ternyata kau manusia\Nyang cukup paham situasi juga, ya.
Dialogue: 0,0:12:09.51,0:12:13.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi apa pantas kau bermulut besar\Ntanpa tahu berapa nilaiku sebenarnya?
Dialogue: 0,0:12:13.82,0:12:14.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini, dua miliar.
Dialogue: 0,0:12:15.47,0:12:18.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Dua miliar? Sebanyak ini?
Dialogue: 0,0:12:19.42,0:12:22.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, bagus sekali.\NIni benar-benar uang asli.
Dialogue: 0,0:12:22.45,0:12:24.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi jumlah sebegini\Nsepertinya masih belum cukup.
Dialogue: 0,0:12:25.22,0:12:26.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kutambah dua miliar lagi.
Dialogue: 0,0:12:26.82,0:12:27.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana?
Dialogue: 0,0:12:30.15,0:12:32.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hujan uang benar-benar turun!
Dialogue: 0,0:12:32.11,0:12:34.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan begini,\Nkontrakmu denganku resmi terbentuk.
Dialogue: 0,0:12:35.31,0:12:37.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa tidak bisa naik sedikit lagi?
Dialogue: 0,0:12:38.32,0:12:41.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Uang kontrak dari majikanku\Nyang sekarang jauh lebih banyak dari ini, lo.
Dialogue: 0,0:12:42.71,0:12:43.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keira...
Dialogue: 0,0:12:43.70,0:12:46.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya seberapa banyak uang\Nyang sudah disetor wanita itu padamu?
Dialogue: 0,0:12:46.49,0:12:50.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada akhirnya, semua uang persiapan,\Ndana darurat, logam mulia,
Dialogue: 0,0:12:50.42,0:12:53.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hingga jam tangan, semua barang\Nyang bisa dijadikan uang kuberikan padanya.
Dialogue: 0,0:12:53.50,0:12:54.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini dia!
Dialogue: 0,0:12:54.24,0:12:56.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai sertifikat tanah\Nmilik Keluarga Hilton pun diserahkan.
Dialogue: 0,0:12:57.98,0:13:01.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rupanya Tuan Majikanku ini kaya raya juga,\Ntidak seperti tampangnya!
Dialogue: 0,0:13:03.47,0:13:05.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, apa yang harus kulakukan sekarang?
Dialogue: 0,0:13:06.78,0:13:08.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa-apaan kau ini?
Dialogue: 0,0:13:09.41,0:13:12.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersiaplah kau.\NAkan kuperas tenagamu habis-habisan.
Dialogue: 0,0:13:12.98,0:13:14.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini perintah pertamaku.
Dialogue: 0,0:13:14.51,0:13:16.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suruh anak-anak yang sudah bebas
Dialogue: 0,0:13:16.30,0:13:18.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dari hipnosis mengangkut daun teh\Ndan bibitnya.
Dialogue: 0,0:13:18.18,0:13:19.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bersiap keluar dari sini.
Dialogue: 0,0:13:19.85,0:13:22.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Kalau sampai berbuat begitu,\NRelik Shennong bakal murka.
Dialogue: 0,0:13:23.16,0:13:24.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Urusan itu biar aku yang tangani.
Dialogue: 0,0:13:25.11,0:13:25.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah kalau begitu.
Dialogue: 0,0:13:26.00,0:13:28.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biayanya tujuh puluh juta dolar, ya, Tuan.
Dialogue: 0,0:13:28.95,0:13:30.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau minta uang lagi?
Dialogue: 0,0:13:30.51,0:13:32.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang tadi itu kan cuma uang muka kontrak.
Dialogue: 0,0:13:32.65,0:13:34.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mau menyuruhku bekerja, bayar upahnya.
Dialogue: 0,0:13:35.05,0:13:38.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti kubayar begitu kita keluar dari sini,\Nsekarang tutup mulut, cepat kerjakan!
Dialogue: 0,0:13:39.26,0:13:40.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, aku mengerti Tuan Majikan!
Dialogue: 0,0:13:40.79,0:13:42.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku paham, jadi tolong hentikan!
Dialogue: 0,0:13:43.75,0:13:44.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian!
Dialogue: 0,0:13:45.30,0:13:47.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beraninya menelantarkan lahan pertanian ini
Dialogue: 0,0:13:47.02,0:13:48.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan mencoba melarikan diri?
Dialogue: 0,0:13:49.25,0:13:50.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya muncul juga, Shennong.
Dialogue: 0,0:13:51.21,0:13:53.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cacing, bimbing anak buahku\Ndan semua anak-anak
Dialogue: 0,0:13:53.94,0:13:54.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menuju pintu keluar makam.
Dialogue: 0,0:13:55.71,0:13:57.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kau benar-benar akan membayarku, 'kan?
Dialogue: 0,0:13:58.22,0:14:01.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau kau mau sekarang juga\Nkujadikan jus cacing kocok?
Dialogue: 0,0:14:02.21,0:14:05.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ampun, aku cuma bercanda.\NMari kutunjukkan jalan pintasnya.
Dialogue: 0,0:14:07.21,0:14:09.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian semua, pergilah duluan.
Dialogue: 0,0:14:09.61,0:14:10.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana denganmu, Ryouga?
Dialogue: 0,0:14:11.41,0:14:13.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu menangkap Relik Shennong ini,
Dialogue: 0,0:14:13.08,0:14:15.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan segera menyusul,\Njadi jangan khawatirkan aku.
Dialogue: 0,0:14:16.35,0:14:18.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau berniat menangkapku, katamu?
Dialogue: 0,0:14:26.16,0:14:27.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makhluk apa ini?
Dialogue: 0,0:14:29.43,0:14:31.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teruslah meronta sepuasmu!
Dialogue: 0,0:14:31.05,0:14:33.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasakan hukuman ini karena\Nlancang membawa kabur
Dialogue: 0,0:14:33.06,0:14:34.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}para petani dari ladang suciku!
Dialogue: 0,0:14:34.93,0:14:37.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kutelan kau ke dalam jurang neraka\Nyang paling dalam!
Dialogue: 0,0:14:41.01,0:14:42.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seranganmu cukup berlebihan juga, ya.
Dialogue: 0,0:14:42.56,0:14:43.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ryouga!
Dialogue: 0,0:15:06.30,0:15:07.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ryouga!\N- Pemimpin!
Dialogue: 0,0:15:09.81,0:15:11.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona, guncangannya makin kuat.
Dialogue: 0,0:15:11.93,0:15:13.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus segera keluar dari sini.
Dialogue: 0,0:15:30.71,0:15:32.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perlakukan aku dengan lebih terhormat!
Dialogue: 0,0:15:33.15,0:15:37.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak sudi mendengarnya dari orang\Nyang telah merusak ladang pertanianku!
Dialogue: 0,0:15:37.10,0:15:40.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pasti sudah menghasut cacing tanah itu\Nuntuk mengkhianatiku, 'kan?
Dialogue: 0,0:15:41.71,0:15:44.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga, kau menyamar menjadi pohon teh.
Dialogue: 0,0:15:45.45,0:15:47.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini berbahaya.
Dialogue: 0,0:15:47.01,0:15:50.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemungkinan besar Shennong\Nadalah relik Tingkat Dewa.
Dialogue: 0,0:15:50.36,0:15:52.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika Daya Kendali saja\Ntak mempan menekannya...
Dialogue: 0,0:15:54.80,0:15:57.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, menyimpan senjatamu,
Dialogue: 0,0:15:57.98,0:16:00.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa itu artinya kau sudah menyerah?
Dialogue: 0,0:16:00.08,0:16:02.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, aku hanya ingin menguji sesuatu.
Dialogue: 0,0:16:02.38,0:16:05.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Menguji"? Apa yang mau kau lakukan\Ndi saat-saat seperti ini?
Dialogue: 0,0:16:05.36,0:16:09.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kulihat-lihat, sepertinya\Ntidak ada jalan keluar dari tempat ini.
Dialogue: 0,0:16:09.51,0:16:12.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi kupikir,\Nkalau kau sebagai penguasa tempat ini mati,
Dialogue: 0,0:16:12.81,0:16:14.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin jalan keluarnya akan terbuka.
Dialogue: 0,0:16:15.51,0:16:16.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:16:16.92,0:16:19.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bara Api Pertama Umat Manusia\Nmilik Homo Erectus.
Dialogue: 0,0:16:19.71,0:16:22.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Relik Tingkat D yang kurebut dari agen CIA.
Dialogue: 0,0:16:23.55,0:16:26.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ja-Jangan bilang kau berniat\Nmeledakkan diri bersama tempat ini?
Dialogue: 0,0:16:26.75,0:16:30.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kebetulan di sini banyak kayu\Nyang bisa dijadikan kayu bakar.
Dialogue: 0,0:16:30.07,0:16:31.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kusulut sedikit saja,
Dialogue: 0,0:16:31.50,0:16:33.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tempat ini pasti langsung ludes terbakar.
Dialogue: 0,0:16:33.65,0:16:35.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bodoh! Kalau kau nekat melakukannya,
Dialogue: 0,0:16:35.68,0:16:36.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau juga...
Dialogue: 0,0:16:36.20,0:16:39.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayang sekali,\Ntapi aku tidak akan mati semudah itu.
Dialogue: 0,0:16:40.09,0:16:42.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keluarkan seluruh kekuatan yang kau punya!
Dialogue: 0,0:16:42.40,0:16:45.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sakit, sakit!\NNanti aku bisa hancur, hentikan!
Dialogue: 0,0:16:46.04,0:16:48.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau sudah gila?!
Dialogue: 0,0:16:49.26,0:16:51.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Takkan kubiarkan kau lolos!
Dialogue: 0,0:16:56.78,0:16:58.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bakar semuanya sampai habis!
Dialogue: 0,0:17:08.79,0:17:10.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat! Batunya mulai longsor!
Dialogue: 0,0:17:16.42,0:17:17.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ryouga!\N- Pemimpin!
Dialogue: 0,0:17:23.38,0:17:24.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin.
Dialogue: 0,0:17:28.35,0:17:29.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Ini bohong, 'kan?
Dialogue: 0,0:17:37.66,0:17:39.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm, penampilanku benar-benar menyedihkan.
Dialogue: 0,0:17:46.92,0:17:50.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa dengan wajah kalian itu?\NMemangnya ada yang mati?
Dialogue: 0,0:17:53.08,0:17:54.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ryouga.
Dialogue: 0,0:17:54.40,0:17:58.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Habisnya, kupikir Pemimpin sudah mati.
Dialogue: 0,0:17:59.15,0:18:00.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin aku mati.
Dialogue: 0,0:18:00.98,0:18:03.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makam itu aku sendiri yang meledakkannya.
Dialogue: 0,0:18:03.99,0:18:05.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga.
Dialogue: 0,0:18:07.25,0:18:09.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah kau benar-benar selamat.
Dialogue: 0,0:18:09.71,0:18:12.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Koutarou sangat mengkhawatirkanmu.
Dialogue: 0,0:18:12.18,0:18:12.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:18:13.21,0:18:16.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, ya jelas saja aku khawatir.
Dialogue: 0,0:18:16.07,0:18:18.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau kan bosku.
Dialogue: 0,0:18:18.15,0:18:21.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau terjadi sesuatu padamu,\Npekerjaanku bisa hilang.
Dialogue: 0,0:18:21.85,0:18:23.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kehilangan pekerjaan,\Naku bakal repot, 'kan?
Dialogue: 0,0:18:23.90,0:18:25.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Makanya...\N- Syukurlah kalau begitu.
Dialogue: 0,0:18:26.25,0:18:28.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi kau khawatir kehilangan pekerjaan, ya?
Dialogue: 0,0:18:28.54,0:18:32.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, kau pasti bakal sangat senang\Nkalau pekerjaan bertambah.
Dialogue: 0,0:18:32.19,0:18:35.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemimpin, sebenarnya apa ini?
Dialogue: 0,0:18:35.91,0:18:36.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan...
Dialogue: 0,0:18:36.93,0:18:40.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Relik Shennong.\NKarena merepotkan, jadi kubakar saja.
Dialogue: 0,0:18:40.65,0:18:44.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh ya, batu pemantik api itu juga rusak,\Nsekalian tolong perbaiki, ya.
Dialogue: 0,0:18:45.21,0:18:47.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Barang hancur begini tak bisa diperbaiki.
Dialogue: 0,0:18:47.11,0:18:48.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:18:48.84,0:18:51.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak bisa diperbaiki?\NApa barusan kau bilang tak bisa diperbaiki?
Dialogue: 0,0:18:51.35,0:18:54.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, aku akan memperbaikinya!\NAku sangat ingin memperbaikinya.
Dialogue: 0,0:18:55.36,0:18:57.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa sebaiknya aku bersyukur?
Dialogue: 0,0:19:07.60,0:19:10.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyaman sekali. Rasanya enak.
Dialogue: 0,0:19:13.88,0:19:16.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa-bisanya orang sepertiku\Ndisuruh merawat tanaman begini.
Dialogue: 0,0:19:17.01,0:19:19.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begini ceritanya\Naku malah jadi "Pelayan Petani".
Dialogue: 0,0:19:19.54,0:19:21.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai kapan aku harus melakukan ini?
Dialogue: 0,0:19:28.81,0:19:30.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo, Bang?
Dialogue: 0,0:19:30.31,0:19:31.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah lama tak dengar kabarmu.
Dialogue: 0,0:19:31.71,0:19:33.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada keperluan apa menghubungiku?
Dialogue: 0,0:19:33.56,0:19:34.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}New York?
Dialogue: 0,0:19:34.95,0:19:35.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:19:35.71,0:19:36.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:19:36.35,0:19:38.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Kalau begitu, besok...\NBaik, aku mengerti.
Dialogue: 0,0:19:38.95,0:19:40.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah itu Bang Ryouga?
Dialogue: 0,0:19:41.85,0:19:42.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersiaplah.
Dialogue: 0,0:19:44.28,0:19:45.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akan bepergian setelah sekian lama.
Dialogue: 0,0:19:48.25,0:19:49.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemimpin.
Dialogue: 0,0:19:49.81,0:19:50.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemimpin!
Dialogue: 0,0:19:51.96,0:19:53.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemimpin!
Dialogue: 0,0:19:56.29,0:19:57.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kita sudah sampai?
Dialogue: 0,0:19:57.96,0:20:00.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ryouga, maafkan aku.
Dialogue: 0,0:20:00.04,0:20:01.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita belum sampai, tapi...
Dialogue: 0,0:20:01.77,0:20:04.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah kenapa,\Naku masih belum bisa menghubungi rumah.
Dialogue: 0,0:20:05.45,0:20:09.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangankan sang sopir,\Nkakakku pun tak bisa dihubungi,
Dialogue: 0,0:20:09.25,0:20:10.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi aku agak cemas.
Dialogue: 0,0:20:12.11,0:20:13.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong jangan terlalu cemas.
Dialogue: 0,0:20:14.31,0:20:15.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita sudah hampir sampai.
Dialogue: 0,0:20:15.58,0:20:17.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah ini kita bisa segera\Nmengobati kedua orang tuamu.
Dialogue: 0,0:20:20.41,0:20:20.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Noboru?
Dialogue: 0,0:20:22.64,0:20:23.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya?
Dialogue: 0,0:20:23.35,0:20:25.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat, Bang!
Dialogue: 0,0:20:25.22,0:20:27.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang kami menuju ke arahmu,\Ntapi kami dikejar sekelompok orang!
Dialogue: 0,0:20:27.99,0:20:29.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dikejar?
Dialogue: 0,0:20:29.43,0:20:31.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya mereka mengincar\NPohon Almon itu...
Dialogue: 0,0:20:31.45,0:20:33.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keira?\NPantas saja dia tidak banyak bertindak,
Dialogue: 0,0:20:33.97,0:20:36.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}rupanya dia sedang menyelidiki\Nlatar belakangku.
Dialogue: 0,0:20:36.17,0:20:38.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita ganti lokasi pertemuan.
Dialogue: 0,0:20:38.13,0:20:39.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya kalian harus berhasil lolos.
Dialogue: 0,0:20:40.01,0:20:41.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sampai tertangkap.
Dialogue: 0,0:20:41.57,0:20:43.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sampai tertangkap, kalian akan kubunuh.
Dialogue: 0,0:20:43.70,0:20:45.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Teganya!
Dialogue: 0,0:20:46.21,0:20:49.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa rekan-rekanmu\Nsedang tertimpa suatu masalah?
Dialogue: 0,0:20:50.78,0:20:53.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan khawatir.\NMereka pasti bisa mengatasinya sendiri.
Dialogue: 0,0:20:54.27,0:20:56.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pak Sopir, tolong tambah kecepatannya.
Dialogue: 0,0:20:56.68,0:21:00.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemimpin, dari tadi jalanannya macet total.
Dialogue: 0,0:21:01.71,0:21:03.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini ada acara apa, ya?
Dialogue: 0,0:21:03.45,0:21:05.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biasanya tidak pernah semacet ini.
Dialogue: 0,0:21:06.82,0:21:07.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa? Kecelakaan?
Dialogue: 0,0:21:09.55,0:21:12.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ryouga, kalau rekan-rekanmu tertimpa masalah
Dialogue: 0,0:21:12.11,0:21:14.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan kita gagal mendapatkan\Nrelik penyembuh itu,
Dialogue: 0,0:21:14.50,0:21:16.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu bagaimana nasib kedua orang tuaku?
Dialogue: 0,0:21:17.30,0:21:19.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Irene! Bertahanlah!
Dialogue: 0,0:21:27.68,0:21:30.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bang, kami telah berhasil\Nmenuntaskan misi ini.
Dialogue: 0,0:23:04.51,0:23:08.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ryouga, terima kasih banyak\Nsudah menyelamatkan kakakku.
Dialogue: 0,0:23:08.32,0:23:10.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan masalah,\Nsyukurlah aku datang tepat waktu.
Dialogue: 0,0:23:10.66,0:23:12.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, Ayah dan Ibu masih...
Dialogue: 0,0:23:13.45,0:23:15.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja.\NMereka berdua juga pasti akan selamat.
Dialogue: 0,0:23:17.11,0:23:20.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi tindakan Keira\Nmakin lama makin menjadi-jadi.
Dialogue: 0,0:23:20.61,0:23:22.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa dia berniat menghancurkan\Nseluruh kota ini?
Dialogue: 0,0:23:22.58,0:23:25.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Irene, mulai dari sini,\Nkami membutuhkan kekuatanmu.
Dialogue: 0,0:23:26.34,0:23:27.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus bagaimana?
Dialogue: 0,0:23:28.05,0:23:31.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau hanya perlu meledakkan amarah\Nyang selama ini kau pendam.
Dialogue: 0,0:23:32.81,0:23:34.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya, "Tomb Raider King".
Dialogue: 0,0:23:35.22,0:23:37.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lepaskan seluruh emosimu!
