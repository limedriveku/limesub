Dialogue: 0,0:00:31.14,0:00:31.66,sign,,0000,0000,0000,,PEMANDIAN AIR PANAS SERIUS
Dialogue: 0,0:03:16.89,0:03:21.15,sign,,0000,0000,0000,,SABUN BADAN SERIUS
Dialogue: 0,0:04:01.92,0:04:03.42,sign,,0000,0000,0000,,BAK MANDI SEMBURAN JET SERIUS
Dialogue: 0,0:04:48.15,0:04:48.68,sign,,0000,0000,0000,,BAK JAKUZI SERIUS
Dialogue: 0,0:05:56.48,0:05:57.41,sign,,0000,0000,0000,,BOING
Dialogue: 0,0:07:26.10,0:07:28.31,sign,,0000,0000,0000,,BOING
Dialogue: 0,0:07:38.74,0:07:39.91,sign,,0000,0000,0000,,PANCURAN TERJUN SERIUS
Dialogue: 0,0:08:51.92,0:08:54.50,sign,,0000,0000,0000,,CENUT-CENUT\NDAG-DIG-DUG
Dialogue: 0,0:09:36.52,0:09:37.26,sign,,0000,0000,0000,,BAK MANDI DINGIN SERIUS
Dialogue: 0,0:11:45.10,0:11:46.85,sign,,0000,0000,0000,,SAUNA SERIUS
Dialogue: 0,0:11:53.86,0:11:54.32,sign,,0000,0000,0000,,YANG SALAH ADALAH GRUP SERIUS,\NBUKAN SAUNA ITU SENDIRI
Dialogue: 0,0:12:29.18,0:12:31.55,sign,,0000,0000,0000,,"PEMANDIAN NIKMAT SURGA SERIUS"
Dialogue: 0,0:12:58.21,0:12:59.54,sign,,0000,0000,0000,,SELAMAT DATANG DI SURGA
Dialogue: 0,0:14:31.62,0:14:36.35,sign,,0000,0000,0000,,KEJUTAN
Dialogue: 0,0:15:19.10,0:15:21.09,sign,,0000,0000,0000,,ANGGUR ITALIA DAN KAFE RESTORAN\NSAIZERIYA
Dialogue: 0,0:15:55.77,0:15:57.27,sign,,0000,0000,0000,,"ELUS, ELUS"
Dialogue: 0,0:17:29.69,0:17:31.95,sign,,0000,0000,0000,,"DOJO KENDO - BESOKNYA"
Dialogue: 0,0:21:11.87,0:21:12.74,sign,,0000,0000,0000,,LELEH, ELUS-ELUS
Dialogue: 0,0:21:26.04,0:21:27.55,sign,,0000,0000,0000,,TIGA MENIT KEMUDIAN
Dialogue: 0,0:00:11.20,0:00:13.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Grup Serius,
Dialogue: 0,0:00:13.38,0:00:15.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah sebuah grup perusahaan
Dialogue: 0,0:00:15.12,0:00:19.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang dikelola kerabat jauh Suto Iku\Nyang bahkan tidak dia kenal.
Dialogue: 0,0:00:19.54,0:00:23.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Moto mereka adalah,\N"Menyajikan kualitas terbaik dengan serius."
Dialogue: 0,0:00:23.93,0:00:25.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kubunuh kalau kau setengah hati!
Dialogue: 0,0:00:25.84,0:00:26.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Siap!\N- Siap!
Dialogue: 0,0:00:27.04,0:00:31.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka membuka pemandian air panas baru,\N"Pemandian Air Panas Serius."
Dialogue: 0,0:00:31.67,0:00:36.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keluarga Rentaro pun terpilih mendapat\Ntiket spesial sewa penuh uji pembukaannya.
Dialogue: 0,0:00:37.27,0:00:38.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita terpilih!
Dialogue: 0,0:00:38.76,0:00:40.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Hore!\N- Wow!
Dialogue: 0,0:00:54.91,0:01:00.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}100 Pacar yang Sungguh Sangat Amat\NBenar-benar Mencintaimu Musim Ketiga
Dialogue: 0,0:02:15.99,0:02:18.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bak mandinya banyak sekali, nanoda!
Dialogue: 0,0:02:18.31,0:02:20.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Puncak dari pemandian rahasia, ah!"
Dialogue: 0,0:02:21.82,0:02:25.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu-Bukan berarti aku merasa\Ntempat ini luas banget, ya!
Dialogue: 0,0:02:25.49,0:02:28.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa malu-malu kucing\Nsama pemandian air panas segala?
Dialogue: 0,0:02:28.57,0:02:29.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menu pemandian air panas...
Dialogue: 0,0:02:29.93,0:02:32.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, air liurmu sampai menetes, loh.
Dialogue: 0,0:02:34.72,0:02:36.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya, air liur Anda.
Dialogue: 0,0:02:36.33,0:02:38.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita coba semua pemandiannya!
Dialogue: 0,0:02:38.34,0:02:41.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bisa mendapat\Nsemua manfaatnya secara efisien.
Dialogue: 0,0:02:41.14,0:02:43.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari jadi lebih cantik bersama-sama!
Dialogue: 0,0:02:43.65,0:02:45.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, Meme!
Dialogue: 0,0:02:45.26,0:02:48.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?!\NTa-Tapi aku...!
Dialogue: 0,0:02:48.15,0:02:52.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini disewa penuh untuk kita, jadi diizinkan\Npakai baju renang dan mandi bersama.
Dialogue: 0,0:02:52.58,0:02:56.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Japanese Freedom Hot Pool!\NIni luar biasa!
Dialogue: 0,0:02:56.96,0:02:58.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini kesempatan langka,
Dialogue: 0,0:02:58.91,0:03:02.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi sayang kalau cuma Nak Rentaro\Nyang di pemandian pria.
Dialogue: 0,0:03:02.22,0:03:04.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rentaro juga hidup, dado!
Dialogue: 0,0:03:04.75,0:03:07.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru ini seperti pemandian keluarga.
Dialogue: 0,0:03:07.18,0:03:09.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang disebut pamili itu, ya.
Dialogue: 0,0:03:09.54,0:03:10.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, benar.
Dialogue: 0,0:03:10.33,0:03:12.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oleh karena itu, satu hari ini...
Dialogue: 0,0:03:12.87,0:03:14.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita nikmati pemandiannya sama-sama!
Dialogue: 0,0:03:14.97,0:03:16.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Iya!\N- Iya!
Dialogue: 0,0:03:21.57,0:03:24.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, busanya benar-benar serius!
Dialogue: 0,0:03:24.90,0:03:27.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh?!
Dialogue: 0,0:03:27.65,0:03:30.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, my god!
Dialogue: 0,0:03:32.50,0:03:34.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Uwah!
Dialogue: 0,0:03:34.86,0:03:37.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bi-Biar kubasuh busanya dengan pancuran!
Dialogue: 0,0:03:41.98,0:03:43.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sakit!
Dialogue: 0,0:03:43.45,0:03:45.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini mesin potong air tekanan tinggi?!
Dialogue: 0,0:03:45.23,0:03:45.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya!
Dialogue: 0,0:03:47.06,0:03:47.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dado!
Dialogue: 0,0:03:47.79,0:03:51.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Yamame memang hebat!\NSeperti menahan ular besar yang mengamuk!
Dialogue: 0,0:03:53.31,0:03:56.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan pakai pancuran air ini!\NTerlalu berbahaya!
Dialogue: 0,0:03:56.07,0:03:58.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, busanya terus bertambah...
Dialogue: 0,0:04:00.09,0:04:01.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Se-Semuanya!
Dialogue: 0,0:04:09.57,0:04:12.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira ini jatuh ke bak mandi\Nsetelah terseret busa,
Dialogue: 0,0:04:12.35,0:04:15.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi tekanan jet airnya terlalu kuat\Nmembuatku tidak bisa gerak!
Dialogue: 0,0:04:16.64,0:04:17.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sakit!
Dialogue: 0,0:04:17.70,0:04:20.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iku!\NSelamatkan aku, nanoda!
Dialogue: 0,0:04:20.57,0:04:22.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Kusuri?!
Dialogue: 0,0:04:29.47,0:04:30.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iku!
Dialogue: 0,0:04:31.34,0:04:35.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak segeralah keluar dari sini\Nselagi aku menahan tekanan airnya!
Dialogue: 0,0:04:45.23,0:04:48.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah keluar, jadi sudah cukup, nanoda.
Dialogue: 0,0:04:48.68,0:04:50.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yoshimoto Shizuka!
Dialogue: 0,0:04:51.60,0:04:53.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menyelamatkanmu!
Dialogue: 0,0:05:00.45,0:05:02.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tinggi sekali!
Dialogue: 0,0:05:03.95,0:05:05.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku takut!
Dialogue: 0,0:05:05.41,0:05:07.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nano!
Dialogue: 0,0:05:07.16,0:05:10.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga, di ketinggian ini\Nmembuat tubuhnya kaku.
Dialogue: 0,0:05:10.91,0:05:13.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana ini?!\NAku harus bagaimana?!
Dialogue: 0,0:05:13.74,0:05:16.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal dia datang untuk menyelamatkanku...
Dialogue: 0,0:05:16.55,0:05:20.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ada sesuatu yang bisa kulakukan...
Dialogue: 0,0:05:23.25,0:05:25.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yoshimoto Shizuka?
Dialogue: 0,0:05:26.06,0:05:28.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia ingin menenangkanku.
Dialogue: 0,0:05:32.85,0:05:36.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berpelukan membuat berat badan kami menyatu,
Dialogue: 0,0:05:36.10,0:05:39.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi tekanan air jakuzi\Ntidak kuat untuk mengangkatnya.
Dialogue: 0,0:05:42.45,0:05:44.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita cari yang lain.
Dialogue: 0,0:05:44.39,0:05:45.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:05:46.97,0:05:48.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini di mana?
Dialogue: 0,0:05:48.13,0:05:50.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hakari, kamu di situ?
Dialogue: 0,0:05:50.65,0:05:53.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suara ini? Karane...
Dialogue: 0,0:05:58.11,0:06:00.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, aku salah orang.
Dialogue: 0,0:06:00.15,0:06:01.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini aku!
Dialogue: 0,0:06:01.97,0:06:04.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Ta-Tapi...
Dialogue: 0,0:06:07.15,0:06:08.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya aku memang salah orang.
Dialogue: 0,0:06:08.91,0:06:10.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kubilang ini aku!
Dialogue: 0,0:06:10.99,0:06:12.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kamu kenapa itu?!
Dialogue: 0,0:06:12.95,0:06:14.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa dadamu terbentur sesuatu?!
Dialogue: 0,0:06:14.94,0:06:16.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bukan bengkak, tahu!
Dialogue: 0,0:06:16.65,0:06:21.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemandian air panas yang ini sepertinya\Npunya efek membesarkan payudara.
Dialogue: 0,0:06:21.85,0:06:24.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be-Benarkah itu?
Dialogue: 0,0:06:24.81,0:06:28.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah, ayo kita cari yang lain,\Nsekarang itu lebih penting.
Dialogue: 0,0:06:29.80,0:06:31.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sendiri saja yang cari.
Dialogue: 0,0:06:31.74,0:06:32.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:06:32.80,0:06:36.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Efeknya hanya jalan selama\Naku berendam di sini.
Dialogue: 0,0:06:37.13,0:06:39.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kembali normal kalau keluar.
Dialogue: 0,0:06:39.18,0:06:40.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi...
Dialogue: 0,0:06:40.85,0:06:44.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku selamanya tidak akan keluar\Ndari bak mandi ini!
Dialogue: 0,0:06:44.31,0:06:45.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan tinggal di sini!
Dialogue: 0,0:06:54.99,0:06:58.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihatlah kenyataan, Karane!
Dialogue: 0,0:06:59.83,0:07:01.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini hanya ilusi semata!
Dialogue: 0,0:07:02.44,0:07:04.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ingatlah kembali!
Dialogue: 0,0:07:04.09,0:07:08.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua kenangan indah yang kita lalui bersama\Ndi dunia luar!
Dialogue: 0,0:07:08.39,0:07:10.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mimpi yang ditampilkan\Npemandian air panas ini,
Dialogue: 0,0:07:10.78,0:07:13.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau masa depan\Nyang akan kita jalani bersama!
Dialogue: 0,0:07:13.34,0:07:17.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana yang nyata bagimu, Karane?!
Dialogue: 0,0:07:21.58,0:07:24.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hakari...
Dialogue: 0,0:07:30.59,0:07:33.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bedanya malah lebih besar dibanding di luar!
Dialogue: 0,0:07:33.01,0:07:36.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana bisa ini kuterima\Nsebagai kenyataan, sialan!
Dialogue: 0,0:07:36.23,0:07:38.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berlari di kamar mandi itu bahaya, loh!
Dialogue: 0,0:07:42.56,0:07:45.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tekanan airnya sangat kuat,\Naku tidak bisa bergerak!
Dialogue: 0,0:07:46.93,0:07:48.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Mimimi!
Dialogue: 0,0:07:49.51,0:07:53.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Posisiku dilindungi Kak Mimimi saja,\Ntekanan airnya sekuat ini.
Dialogue: 0,0:07:53.11,0:07:57.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apalagi Kak Mimimi yang terkena langsung\Nsemburan air panasnya pasti...
Dialogue: 0,0:07:59.62,0:08:02.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu baik-baik saja, Meme?
Dialogue: 0,0:08:02.06,0:08:04.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? I-Iya...!
Dialogue: 0,0:08:04.63,0:08:06.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah.
Dialogue: 0,0:08:06.01,0:08:08.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, sekarang harus bagaimana?
Dialogue: 0,0:08:08.29,0:08:11.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Mimimi, kenapa...?
Dialogue: 0,0:08:11.02,0:08:16.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal Kakak pasti lebih menderita,\Nkenapa malah mengkhawatirkanku?
Dialogue: 0,0:08:16.33,0:08:21.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesuatu!\NAku juga harus melakukan sesuatu!
Dialogue: 0,0:08:21.92,0:08:25.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk menyelamatkan Kak Mimimi!
Dialogue: 0,0:08:25.41,0:08:26.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah!
Dialogue: 0,0:08:27.16,0:08:29.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kak Mimimi!
Dialogue: 0,0:08:30.30,0:08:37.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bi-Bisakah Kakak me-mencium\Nte-tengkuk leherku dari posisi itu?
Dialogue: 0,0:08:37.41,0:08:39.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?!
Dialogue: 0,0:08:39.33,0:08:43.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, apa karena aku cantik sekali?
Dialogue: 0,0:08:44.69,0:08:46.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh saja.
Dialogue: 0,0:08:54.51,0:08:55.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya-Yang benar saja!
Dialogue: 0,0:08:55.54,0:08:58.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa yang sudah kuperbuat...
Dialogue: 0,0:08:58.02,0:09:01.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Astaga!
Dialogue: 0,0:09:01.69,0:09:02.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Mimimi!
Dialogue: 0,0:09:02.93,0:09:03.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meme!
Dialogue: 0,0:09:03.89,0:09:05.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meluncur!
Dialogue: 0,0:09:05.73,0:09:08.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Mimimi baik-baik saja?
Dialogue: 0,0:09:08.53,0:09:09.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meme...
Dialogue: 0,0:09:10.40,0:09:14.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meme yang sepemalu itu\Nberani melakukannya sendiri...
Dialogue: 0,0:09:17.22,0:09:21.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meme, ayo kita cari yang lain.
Dialogue: 0,0:09:21.40,0:09:22.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:09:22.88,0:09:26.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah bertambah dewasa, Meme.
Dialogue: 0,0:09:28.14,0:09:29.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meme...
Dialogue: 0,0:09:29.58,0:09:32.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kulitku terlalu mulus,\Nmembuatku tergelincir!
Dialogue: 0,0:09:32.67,0:09:34.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan telapak kakimu juga?!
Dialogue: 0,0:09:37.27,0:09:39.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anda tidak boleh masuk, Nyonya Hahari.
Dialogue: 0,0:09:40.33,0:09:43.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu jatuh kemari setelah terseret busa,
Dialogue: 0,0:09:43.41,0:09:46.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}badan saya langsung membeku dan kaku\Ntidak bisa digerakkan.
Dialogue: 0,0:09:46.91,0:09:49.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama persis seperti kelopak mata saya ini.
Dialogue: 0,0:09:49.81,0:09:52.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, kamu sedang melawak?\NAtau serius, mana yang benar?
Dialogue: 0,0:10:03.47,0:10:04.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya Hahari?!
Dialogue: 0,0:10:06.15,0:10:08.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dinginnya seperti sedang digigit!
Dialogue: 0,0:10:08.93,0:10:10.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong hentikan, Nyonya Hahari!
Dialogue: 0,0:10:10.89,0:10:14.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai majikan, Anda tidak perlu\Nsejauh ini hanya demi saya...
Dialogue: 0,0:10:14.69,0:10:18.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Majikan macam apa yang tidak bisa\Nmelindungi pembantunya yang berharga!
Dialogue: 0,0:10:19.52,0:10:20.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo...
Dialogue: 0,0:10:25.93,0:10:27.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hangat, bukan?
Dialogue: 0,0:10:32.21,0:10:33.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah bisa bergerak?
Dialogue: 0,0:10:35.98,0:10:39.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, Nyonya Hahari.
Dialogue: 0,0:10:40.46,0:10:44.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, itu Hahari Woman dan Mei Girl!
Dialogue: 0,0:10:44.46,0:10:45.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya sudah di sini?
Dialogue: 0,0:10:45.83,0:10:48.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chiyo, Momiji, dan Nek Yaku masih belum.
Dialogue: 0,0:10:48.28,0:10:50.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rentaro juga.
Dialogue: 0,0:10:50.04,0:10:53.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia masih di dalam busa\Nuntuk mencari kita semua, dado.
Dialogue: 0,0:10:53.48,0:10:54.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga!
Dialogue: 0,0:10:54.92,0:10:59.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di dalam busa yang sulit lihat ke depan ini,\Nnanti bisa jadi berbahaya!
Dialogue: 0,0:10:59.29,0:11:01.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan khawatir.
Dialogue: 0,0:11:01.02,0:11:03.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka bertiga tidak apa-apa.
Dialogue: 0,0:11:06.90,0:11:09.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma mereka bertiga yang tidak apa-apa!
Dialogue: 0,0:11:09.10,0:11:10.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu baik-baik saja?!
Dialogue: 0,0:11:10.84,0:11:13.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pendarahan dari kepala itu berbahaya.
Dialogue: 0,0:11:13.02,0:11:14.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada banyak yang terjadi.
Dialogue: 0,0:11:15.99,0:11:19.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dik Chiyo! Kacamatamu jatuh\Nke dalam bak mandi besar!
Dialogue: 0,0:11:22.45,0:11:24.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Basuh tubuhmu dulu sebelum masuk!
Dialogue: 0,0:11:24.51,0:11:26.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan di situasi seperti ini!
Dialogue: 0,0:11:26.27,0:11:27.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Rentaro?!
Dialogue: 0,0:11:29.84,0:11:32.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, yang di situ...
Dialogue: 0,0:11:32.71,0:11:33.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Momiji...
Dialogue: 0,0:11:33.59,0:11:35.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Donat Mon de Ring!
Dialogue: 0,0:11:37.84,0:11:41.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tekstur busanya yang kenyal sangat nikmat!
Dialogue: 0,0:11:41.41,0:11:43.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Donat Mon de Angel yang kenyal!
Dialogue: 0,0:11:43.08,0:11:44.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Rentaro?!
Dialogue: 0,0:11:48.78,0:11:51.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempat ini seperti hutan hujan tropis, nanoja.
Dialogue: 0,0:11:51.11,0:11:53.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perang parit yang bernama sauna!
Dialogue: 0,0:11:54.32,0:11:56.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nenek Yaku, Anda baik-baik saja?!
Dialogue: 0,0:11:56.47,0:11:57.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong bertahanlah!
Dialogue: 0,0:11:59.34,0:12:01.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, ya...
Dialogue: 0,0:12:01.57,0:12:06.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkat Nak Rentaro\Nsisa hidupku terasa indah.
Dialogue: 0,0:12:06.13,0:12:09.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kuberi hadiah, nanoja.
Dialogue: 0,0:12:12.38,0:12:14.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau soal hadiah, Momiji juga mau!
Dialogue: 0,0:12:14.60,0:12:15.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya juga!
Dialogue: 0,0:12:16.32,0:12:20.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serangan kecup tiga gadis bocil!
Dialogue: 0,0:12:20.54,0:12:22.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya ampun, pemandian air panas macam apa ini?
Dialogue: 0,0:12:22.73,0:12:25.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal ini kencan pertama kita\Ndi pemandian air panas.
Dialogue: 0,0:12:29.18,0:12:31.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tulisannya Pemandian Nikmat Surga Serius.
Dialogue: 0,0:12:31.55,0:12:33.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin yang ini aman.
Dialogue: 0,0:12:33.46,0:12:36.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari kelihatannya, ini bak mandi biasa.
Dialogue: 0,0:12:36.44,0:12:40.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mumpung di sini, setidaknya pengin\Nmandi bareng sama-sama, 'kan?
Dialogue: 0,0:12:44.95,0:12:47.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wa-Wah, ini...
Dialogue: 0,0:12:47.47,0:12:48.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Memang benar."
Dialogue: 0,0:12:50.00,0:12:54.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ini adalah Surga!\N- Ini adalah Surga!
Dialogue: 0,0:12:59.55,0:13:00.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan, jangan!
Dialogue: 0,0:13:00.66,0:13:02.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kembalikan mereka!
Dialogue: 0,0:13:02.14,0:13:03.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, deh.
Dialogue: 0,0:13:07.18,0:13:09.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, bocah!
Dialogue: 0,0:13:09.78,0:13:12.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu gantungan kunci edisi terbatas, 'kan?
Dialogue: 0,0:13:12.35,0:13:15.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pacar kami juga pengin punya.
Dialogue: 0,0:13:15.23,0:13:19.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak mau merasa sakit,\Nbagi dikit sini buat kami.
Dialogue: 0,0:13:20.23,0:13:24.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maaf, tapi sepanjang hari aku sudah\Nkeliling banyak toko mengumpulkan ini
Dialogue: 0,0:13:24.99,0:13:26.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk kuberikan ke pacarku.
Dialogue: 0,0:13:26.49,0:13:27.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bohong!
Dialogue: 0,0:13:27.54,0:13:29.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai cari sebanyak itu!
Dialogue: 0,0:13:29.28,0:13:30.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang berapa banyak pacarmu?!
Dialogue: 0,0:13:31.18,0:13:32.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, itu...
Dialogue: 0,0:13:32.52,0:13:34.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enam belas.
Dialogue: 0,0:13:34.00,0:13:36.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau kau jual lagi, 'kan?!
Dialogue: 0,0:13:36.03,0:13:37.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak begitu...
Dialogue: 0,0:13:37.05,0:13:39.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian semua apa tidak punya malu?!
Dialogue: 0,0:13:39.50,0:13:42.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pria-pria besar beraninya\Nmelawan satu orang.
Dialogue: 0,0:13:43.49,0:13:45.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maju sini kalau mau protes!
Dialogue: 0,0:13:47.75,0:13:49.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bahaya!\NSebaiknya kita lari!
Dialogue: 0,0:13:50.14,0:13:50.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:13:51.90,0:13:55.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa membalikkan tubuhku\Ndari hadapan musuh di pertarungan.
Dialogue: 0,0:13:55.27,0:13:56.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, lawan punya sajam...
Dialogue: 0,0:13:58.32,0:14:01.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melawan orang yang tidak punya harga diri\Nseperti mereka.
Dialogue: 0,0:14:01.37,0:14:04.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika prinsip keadilanku\Ntidak bisa kupertahankan,
Dialogue: 0,0:14:04.03,0:14:06.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berarti tidak ada gunanya diriku
Dialogue: 0,0:14:06.03,0:14:07.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berlatih setiap hari!
Dialogue: 0,0:14:09.18,0:14:10.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betapa...
Dialogue: 0,0:14:10.41,0:14:14.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betapa kuat, gagah berani,\Ndan penuh harga diri!
Dialogue: 0,0:14:14.54,0:14:17.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti "Kesatria Wanita"\Ndalam dunia dongeng!
Dialogue: 0,0:14:18.80,0:14:20.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami tunggu dijual lagi!
Dialogue: 0,0:14:21.80,0:14:23.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa dirimu terluka?
Dialogue: 0,0:14:23.94,0:14:24.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak!
Dialogue: 0,0:14:26.31,0:14:28.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia benar-benar...
Dialogue: 0,0:14:28.13,0:14:29.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}keren sekali!
Dialogue: 0,0:14:42.80,0:14:44.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku permisi dulu.
Dialogue: 0,0:14:44.68,0:14:46.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan belum mengenalkan nama...
Dialogue: 0,0:14:46.91,0:14:49.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Izinkan aku berterima kasih dengan sesuatu!
Dialogue: 0,0:14:50.28,0:14:53.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia benar-benar keren.
Dialogue: 0,0:14:53.74,0:14:56.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu, aku hanya melakukan\Nhal yang seharusnya.
Dialogue: 0,0:14:56.91,0:14:58.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia benar-benar keren!
Dialogue: 0,0:14:59.92,0:15:01.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya mohon, dengan sangat!
Dialogue: 0,0:15:01.10,0:15:02.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedang apa kamu ini?!
Dialogue: 0,0:15:02.47,0:15:03.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan!
Dialogue: 0,0:15:03.74,0:15:06.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu ini tidak punya harga diri?!
Dialogue: 0,0:15:06.11,0:15:06.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan begitu!
Dialogue: 0,0:15:06.97,0:15:09.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak bisa membalas budi yang kuterima,
Dialogue: 0,0:15:09.55,0:15:12.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tidak bisa menatap wajah\Norang-orang yang mencintaiku!
Dialogue: 0,0:15:14.00,0:15:15.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya?
Dialogue: 0,0:15:15.28,0:15:17.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi itu prinsip kesatriamu?
Dialogue: 0,0:15:17.54,0:15:19.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, biar kuterima.
Dialogue: 0,0:15:23.34,0:15:25.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini membuatku sedikit sungkan.
Dialogue: 0,0:15:25.46,0:15:29.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ditraktir oleh adik kelas dengan\Nseragam SMA yang sama denganku.
Dialogue: 0,0:15:29.22,0:15:31.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, kenapa tahu aku adik kelas...
Dialogue: 0,0:15:31.79,0:15:33.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, dari raut wajah, ya?
Dialogue: 0,0:15:33.53,0:15:38.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, sekadar aku tidak pernah melihatmu\Ndi antara angkatan kelas tiga.
Dialogue: 0,0:15:38.37,0:15:42.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana bisa aku sampai menebak\Ndari kelas berapa cuma dari penampilan.
Dialogue: 0,0:15:42.16,0:15:43.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ditambah lagi.
Dialogue: 0,0:15:43.13,0:15:47.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di kelasku ada yang penampilannya\Nseperti anak SD padahal sudah kelas 3 SMA.
Dialogue: 0,0:15:47.87,0:15:50.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti Kak Kusuri, ya?
Dialogue: 0,0:15:50.18,0:15:52.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia ketua ekskul kimia.
Dialogue: 0,0:15:52.23,0:15:53.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, itu Kak Kusuri.
Dialogue: 0,0:15:55.77,0:15:57.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kusuri imut sekali!
Dialogue: 0,0:15:57.27,0:15:58.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan pintar!
Dialogue: 0,0:16:00.52,0:16:05.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, Kakak malah sebaliknya,\Nterlihat sangat dewasa.
Dialogue: 0,0:16:05.31,0:16:09.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan dari penampilan,\Ntapi lebih secara mental.
Dialogue: 0,0:16:09.02,0:16:12.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski aku tidak menyadarinya,\Ntapi memang sering dibilang begitu.
Dialogue: 0,0:16:13.11,0:16:15.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin karena aku putri sulung\Ndari enam bersaudara
Dialogue: 0,0:16:15.75,0:16:21.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi sering menggantikan ibuku\Nuntuk mengurus adik-adikku.
Dialogue: 0,0:16:21.21,0:16:22.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya?
Dialogue: 0,0:16:24.34,0:16:26.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak, ada benang di kepala...
Dialogue: 0,0:16:26.62,0:16:28.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sentuh aku!
Dialogue: 0,0:16:32.82,0:16:34.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maafkan aku!
Dialogue: 0,0:16:34.96,0:16:38.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membiarkan orang menyentuh kepalaku\Nyang adalah titik vital itu penghinaan.
Dialogue: 0,0:16:38.65,0:16:40.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh seseorang dengan harga diri tinggi!
Dialogue: 0,0:16:41.02,0:16:45.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, maaf.\NJustru saya yang kurang hati-hati.
Dialogue: 0,0:16:46.23,0:16:47.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih untuk hidangannya.
Dialogue: 0,0:16:48.12,0:16:50.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih juga untukmu, makanannya enak.
Dialogue: 0,0:16:50.65,0:16:51.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus permisi dulu.
Dialogue: 0,0:16:51.73,0:16:53.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, maaf.
Dialogue: 0,0:16:54.15,0:16:57.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya Aijo Rentaro dari kelas satu.
Dialogue: 0,0:16:57.31,0:17:00.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa saya boleh menemui Kakak lagi?
Dialogue: 0,0:17:02.50,0:17:05.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Kishika dari kelas tiga,\Nanggota ekskul kendo putri.
Dialogue: 0,0:17:05.50,0:17:07.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku selalu berada di ekskul kendo.
Dialogue: 0,0:17:07.66,0:17:09.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bisa berkunjung sesukamu.
Dialogue: 0,0:17:17.39,0:17:18.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya?
Dialogue: 0,0:17:18.64,0:17:22.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa, datanglah padaku\Nkapan pun saat kamu butuh.
Dialogue: 0,0:17:22.94,0:17:25.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kishika kecilku yang manis.
Dialogue: 0,0:17:25.81,0:17:27.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Papa...
Dialogue: 0,0:17:29.69,0:17:31.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lima! Enam!
Dialogue: 0,0:17:31.95,0:17:34.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tujuh! Delapan!
Dialogue: 0,0:17:34.67,0:17:36.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sembilan! Sepuluh!
Dialogue: 0,0:17:36.94,0:17:37.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cukup!
Dialogue: 0,0:17:37.93,0:17:39.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketua, yang tadi bagaimana?!
Dialogue: 0,0:17:39.83,0:17:42.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tangan kananmu terlalu bertenaga.
Dialogue: 0,0:17:42.22,0:17:46.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selalu ingat pegang pedang bambu dengan\Njari manis dan kelingking tangan kiri.
Dialogue: 0,0:17:46.54,0:17:48.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tangan kanan sebagai penopang saja.
Dialogue: 0,0:17:48.46,0:17:49.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:17:49.22,0:17:51.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketua, bisa lihat gerakan saya juga?!
Dialogue: 0,0:17:51.79,0:17:53.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong saya juga!
Dialogue: 0,0:17:53.62,0:17:55.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata dia ketua ekskul.
Dialogue: 0,0:17:55.26,0:17:57.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelihatannya sangat disegani.
Dialogue: 0,0:17:57.51,0:18:01.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, bisa dimengerti kalau\Norang sekeren itu ketuanya...
Dialogue: 0,0:18:01.19,0:18:02.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ketua!\N- Ketua!
Dialogue: 0,0:18:02.58,0:18:04.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, aku mengerti!
Dialogue: 0,0:18:04.06,0:18:06.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kulihat bergantian.
Dialogue: 0,0:18:09.53,0:18:11.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, Aijo, kamu datang, ya.
Dialogue: 0,0:18:11.42,0:18:12.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, iya.
Dialogue: 0,0:18:20.45,0:18:21.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awas!
Dialogue: 0,0:18:25.54,0:18:27.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ja-Jangan!
Dialogue: 0,0:18:27.93,0:18:30.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sisanya kalian berlatih saja sendiri!
Dialogue: 0,0:18:30.24,0:18:31.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketua!
Dialogue: 0,0:18:31.93,0:18:33.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak...
Dialogue: 0,0:18:34.03,0:18:34.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kejadian lagi.
Dialogue: 0,0:18:34.99,0:18:35.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi?
Dialogue: 0,0:18:35.84,0:18:39.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, maaf, kamu kenalannya Ketua?
Dialogue: 0,0:18:39.79,0:18:40.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:18:41.12,0:18:43.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terkadang ada kejadian seperti ini.
Dialogue: 0,0:18:43.60,0:18:46.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketua pergi begitu saja seolah\Ntidak tahan akan sesuatu.
Dialogue: 0,0:18:46.98,0:18:50.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, dia tidak pernah mau\Nmenceritakannya pada kami.
Dialogue: 0,0:18:55.85,0:18:58.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku melakukannya lagi.
Dialogue: 0,0:18:58.27,0:19:02.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa,\Nsemua orang pernah membuat kesalahan.
Dialogue: 0,0:19:02.54,0:19:04.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bukan salahmu, Kishika.
Dialogue: 0,0:19:04.62,0:19:06.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kamu sudah berjuang keras.\N- Mama...
Dialogue: 0,0:19:06.29,0:19:07.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak?
Dialogue: 0,0:19:07.25,0:19:08.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu hebat, Kishika.
Dialogue: 0,0:19:08.83,0:19:10.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah selalu membantu.
Dialogue: 0,0:19:10.92,0:19:13.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini kamu boleh bermanja sepuas hati.
Dialogue: 0,0:19:13.17,0:19:16.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa, datanglah padaku\Nkapan pun saat kamu butuh.
Dialogue: 0,0:19:16.95,0:19:19.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kishika kecilku yang manis.
Dialogue: 0,0:19:21.47,0:19:24.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, saya malah mengikuti Kakak kemari.
Dialogue: 0,0:19:24.33,0:19:29.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, saya tidak bisa membiarkan kakak\Nmenanggung sesuatu sendirian.
Dialogue: 0,0:19:29.81,0:19:34.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin dia pasti kecewa setelah\Ntahu diriku yang seperti ini.
Dialogue: 0,0:19:35.46,0:19:38.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah karena sifatku yang penuh harga diri\Ndan pantang menyerah,
Dialogue: 0,0:19:38.78,0:19:41.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau tidak bisa membiarkan\Norang lain begitu saja.
Dialogue: 0,0:19:41.20,0:19:46.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak kecil aku selalu diandalkan\Noleh keluarga atau teman-temanku.
Dialogue: 0,0:19:47.16,0:19:50.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, sebenarnya aku juga ingin\Ndimanjakan orang lain.
Dialogue: 0,0:19:51.08,0:19:53.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diperlakukan seperti anak kecil.
Dialogue: 0,0:19:53.00,0:19:55.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dimanjakan seperti bayi.
Dialogue: 0,0:19:55.97,0:20:01.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak kecil aku terus menyimpan\Nperasaan itu hingga usiaku sekarang.
Dialogue: 0,0:20:02.90,0:20:04.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu akhirnya...
Dialogue: 0,0:20:04.60,0:20:06.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski usiaku 18 tahun,
Dialogue: 0,0:20:06.35,0:20:09.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi sembunyi dari keluarga\Ndan teman-teman di tempat ini.
Dialogue: 0,0:20:09.35,0:20:12.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampil memalukan bermanja pada\Nmama dan papa khayalan
Dialogue: 0,0:20:12.10,0:20:16.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}memakai editan suaraku dari pengubah suara\Ndan sarung tangan karet seperti ini.
Dialogue: 0,0:20:17.68,0:20:20.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak ingin ada yang mengetahui hal ini.
Dialogue: 0,0:20:20.10,0:20:22.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi tidak pernah kubiarkan\Nkepalaku dielus di hadapan orang,
Dialogue: 0,0:20:22.87,0:20:24.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}agar sisi manjaku tidak muncul.
Dialogue: 0,0:20:24.78,0:20:27.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal aku sudah sangat berhati-hati!
Dialogue: 0,0:20:29.21,0:20:30.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bunuh aku!
Dialogue: 0,0:20:30.25,0:20:34.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daripada hidup menanggung malu begini,\Nlebih baik diakhiri saja di sini!
Dialogue: 0,0:20:36.80,0:20:41.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan ada kalanya Kakak\Ningin dimanjakan orang lain, ya?
Dialogue: 0,0:20:41.26,0:20:45.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski tidak tahu apa orang seperti saya\Nbisa menjalankan tugas itu.
Dialogue: 0,0:20:46.27,0:20:50.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, jika berkenan, tolong izinkan saya\Nmelakukan ini pada Kakak.
Dialogue: 0,0:20:50.27,0:20:53.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Astaga...
Dialogue: 0,0:20:53.27,0:20:54.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Auh!
Dialogue: 0,0:20:54.91,0:20:55.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Auh?!
Dialogue: 0,0:20:56.79,0:20:58.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aijo...
Dialogue: 0,0:20:58.41,0:21:01.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, ada apa, Kak?
Dialogue: 0,0:21:01.03,0:21:06.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar? Kamu mau terus mengelusku?
Dialogue: 0,0:21:06.33,0:21:07.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia meleleh?!
Dialogue: 0,0:21:10.20,0:21:11.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elus, elus.
Dialogue: 0,0:21:12.75,0:21:15.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meleleh...
Dialogue: 0,0:21:15.78,0:21:17.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elus, elus.
Dialogue: 0,0:21:17.35,0:21:20.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meleleh...
Dialogue: 0,0:21:20.55,0:21:22.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elus, elus.
Dialogue: 0,0:21:22.01,0:21:26.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meleleh...
Dialogue: 0,0:21:29.71,0:21:30.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Papa...
Dialogue: 0,0:21:31.09,0:21:33.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia malah berubah jadi bayi.
Dialogue: 0,0:21:34.50,0:21:36.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cinta Papa.
Dialogue: 0,0:21:36.23,0:21:38.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selalu temani aku, ya.
Dialogue: 0,0:21:38.15,0:21:40.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi papa Kishika selamanya.
Dialogue: 0,0:21:41.15,0:21:45.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya tidak bisa menjadi papa Kakak.
Dialogue: 0,0:21:45.31,0:21:49.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku bisa selalu menemani\Ndan memanjakan Kakak setiap hari.
Dialogue: 0,0:21:49.99,0:21:54.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Kishika, apakah Kakak mau\Nmenjadi pacar saya?
Dialogue: 0,0:21:54.90,0:21:56.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Huwa!
Dialogue: 0,0:21:56.70,0:21:58.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cinta Papa!
Dialogue: 0,0:21:58.88,0:21:59.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan papa tapi pacar!
Dialogue: 0,0:21:59.84,0:22:00.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu...
Dialogue: 0,0:22:00.92,0:22:02.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan jadi papaku?
Dialogue: 0,0:22:02.23,0:22:03.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti Mama?
Dialogue: 0,0:22:03.81,0:22:04.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ingin jadi pacar Kakak.
Dialogue: 0,0:22:04.89,0:22:05.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi...
Dialogue: 0,0:22:08.46,0:22:11.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya sudah, kalau begitu...
Dialogue: 0,0:22:11.61,0:22:15.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon bantuanmu,\Naku Torotoro Kishika dari kelas tiga.
Dialogue: 0,0:22:15.89,0:22:17.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baik.
