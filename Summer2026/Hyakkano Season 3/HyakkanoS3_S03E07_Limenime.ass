Dialogue: 0,0:13:25.20,0:13:26.55,sign,,0000,0000,0000,,KELUARGA KUSURIVANIAN!!
Dialogue: 0,0:00:12.84,0:00:13.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Uh.
Dialogue: 0,0:00:14.07,0:00:15.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, Nano?
Dialogue: 0,0:00:17.49,0:00:19.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rotinya tersangkut di tenggorokan.
Dialogue: 0,0:00:19.98,0:00:22.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gara-gara kamu selalu bahas efisiensi, sih!
Dialogue: 0,0:00:22.25,0:00:24.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar, kalau makan\Ndikunyah yang benar, nanoda!
Dialogue: 0,0:00:24.90,0:00:25.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini, minum teh dulu!
Dialogue: 0,0:00:25.93,0:00:27.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih...
Dialogue: 0,0:00:30.01,0:00:32.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah...
Dialogue: 0,0:00:34.20,0:00:35.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?!
Dialogue: 0,0:00:35.18,0:00:36.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang terjadi?!
Dialogue: 0,0:00:40.03,0:00:41.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nano?!
Dialogue: 0,0:00:41.07,0:00:42.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Nano menghilang?"
Dialogue: 0,0:00:42.02,0:00:44.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa dia sedang main petak umpet?!
Dialogue: 0,0:00:44.00,0:00:46.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bilang itu obat peleleh tubuh?!
Dialogue: 0,0:00:46.41,0:00:48.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh my Gad!\NNano girl!
Dialogue: 0,0:00:48.54,0:00:50.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak...
Dialogue: 0,0:00:50.53,0:00:53.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang, aku ada di sini.
Dialogue: 0,0:00:56.87,0:00:59.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- ThumbeliNano!\N- ThumbeliNano!
Dialogue: 0,0:01:12.93,0:01:18.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}100 Pacar yang Sungguh Sangat Amat\NBenar-benar Mencintaimu Musim Ketiga
Dialogue: 0,0:02:31.45,0:02:33.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Imutnya!\N- Imutnya!
Dialogue: 0,0:02:33.39,0:02:35.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu adalah, Mini Nano!
Dialogue: 0,0:02:35.90,0:02:38.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak!\NItu Nano Nano, nanoda!
Dialogue: 0,0:02:38.56,0:02:40.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nano nano berisik, tahu.
Dialogue: 0,0:02:40.41,0:02:43.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa Kak Nano baik-baik saja itu?!
Dialogue: 0,0:02:43.20,0:02:45.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Kusuri, cepat berikan obat penetralnya!
Dialogue: 0,0:02:45.40,0:02:50.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, obat pengecil ini sangat\Nmembebani tubuh.
Dialogue: 0,0:02:50.65,0:02:52.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Efeknya harus ditunggu habis sendiri.
Dialogue: 0,0:02:52.65,0:02:54.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi bakal mati?
Dialogue: 0,0:02:54.28,0:02:55.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Noda!
Dialogue: 0,0:02:55.17,0:02:56.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Obat berbahaya!
Dialogue: 0,0:02:56.65,0:02:57.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan cuma "Noda".
Dialogue: 0,0:02:58.65,0:03:01.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya-Yang penting, harus kita beri baju dulu!
Dialogue: 0,0:03:01.83,0:03:04.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Yes.\N- Oh iya, bajunya tidak ikut mengecil.
Dialogue: 0,0:03:04.75,0:03:07.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senter pengecil Doraemon ternyata hebat, ya.
Dialogue: 0,0:03:07.52,0:03:12.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nano, kalau mau, silakan pakai\Nbaju boneka rajutku.
Dialogue: 0,0:03:12.67,0:03:14.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, bukankah itu...
Dialogue: 0,0:03:14.70,0:03:17.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa, masih ada banyak.
Dialogue: 0,0:03:18.40,0:03:20.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Kakure Meme.
Dialogue: 0,0:03:20.40,0:03:21.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini pas sekali.
Dialogue: 0,0:03:21.36,0:03:23.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boneka Rias Dik Nano!
Dialogue: 0,0:03:23.70,0:03:25.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wawawah, imutnya!
Dialogue: 0,0:03:25.55,0:03:29.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami menantikan peluncuran produk\Nboneka rias Dik Nano!
Dialogue: 0,0:03:29.49,0:03:31.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!\NAku mau beli 100!
Dialogue: 0,0:03:31.31,0:03:33.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boneka Nano mau kudandani,\Nlalu kutelanjangi!
Dialogue: 0,0:03:33.21,0:03:36.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh iya, aku punya bunga yang tadi\Ndiberikan Yamame.
Dialogue: 0,0:03:36.69,0:03:38.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini, cobalah.
Dialogue: 0,0:03:38.94,0:03:40.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, imutnya!
Dialogue: 0,0:03:40.83,0:03:42.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu jadi seperti peri!
Dialogue: 0,0:03:42.58,0:03:46.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski hanya sekali, anak gadis pasti\Npernah suka payung bunga seperti ini.
Dialogue: 0,0:03:46.46,0:03:49.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak suka.\NSelain banyak celah, juga tidak bisa dilipat.
Dialogue: 0,0:03:49.63,0:03:51.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Payung poliester lebih berguna.
Dialogue: 0,0:03:51.33,0:03:52.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, mimpiku...
Dialogue: 0,0:03:52.59,0:03:54.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti Ant-Man!
Dialogue: 0,0:03:54.89,0:03:58.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, Kak Yamame?\NKenapa malah naik egrang?
Dialogue: 0,0:03:58.35,0:04:02.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak boleh...\NTidak boleh sampai menginjaknya, do...
Dialogue: 0,0:04:02.02,0:04:03.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf kalau menyinggung traumamu.
Dialogue: 0,0:04:03.85,0:04:06.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku sedang makan siang.
Dialogue: 0,0:04:06.52,0:04:09.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau menyisakan makanan,\Nnanti dimarahi Iin Chiyo.
Dialogue: 0,0:04:09.66,0:04:11.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang Kakak kira saya iblis?
Dialogue: 0,0:04:11.84,0:04:15.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak minum suplemen sesuai dosis,\Nnanti nutrisiku tidak imbang.
Dialogue: 0,0:04:15.28,0:04:17.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti overdosis!
Dialogue: 0,0:04:17.38,0:04:19.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enaknya, makanan jadi raksasa...
Dialogue: 0,0:04:19.92,0:04:21.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti dumbel akan 100 kali lebih berat.
Dialogue: 0,0:04:21.92,0:04:24.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fotonya juga bakal 100 kali lebih imut...
Dialogue: 0,0:04:25.04,0:04:27.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat, Nano tertimpa payudara!
Dialogue: 0,0:04:27.16,0:04:28.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetek pembunuh!
Dialogue: 0,0:04:29.00,0:04:31.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, Dik Nano!
Dialogue: 0,0:04:32.20,0:04:35.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia selamat karena terjepit\Ndi belahan dadaku!
Dialogue: 0,0:04:35.26,0:04:37.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak bisa bernapas...
Dialogue: 0,0:04:37.60,0:04:39.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetap saja tetekmu mau membunuh!
Dialogue: 0,0:04:39.99,0:04:43.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di-Dik Nano Nano!
Dialogue: 0,0:04:43.37,0:04:45.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah, dia lahir dengan selamat.
Dialogue: 0,0:04:47.64,0:04:49.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tinggi sekali.
Dialogue: 0,0:04:49.58,0:04:51.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa Anda tidak apa-apa, Nona Nano?
Dialogue: 0,0:04:51.60,0:04:53.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan ke tangan saya.
Dialogue: 0,0:04:59.37,0:05:01.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Nano seukuran tapak tangan.
Dialogue: 0,0:05:02.79,0:05:05.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nano itu seharusnya cantik dan elegan!
Dialogue: 0,0:05:05.58,0:05:08.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kenapa dadaku berdebar\Nkarena keimutannya?!
Dialogue: 0,0:05:08.66,0:05:10.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Nano tidak bisa kuremas lagi...
Dialogue: 0,0:05:10.54,0:05:12.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Kalian sedang bertarung dengan apa?"
Dialogue: 0,0:05:15.90,0:05:18.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jam istirahat siang sudah selesai, do.
Dialogue: 0,0:05:18.06,0:05:19.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus kembali ke kelas.
Dialogue: 0,0:05:19.76,0:05:21.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}De-Dengan kondisi seperti itu?
Dialogue: 0,0:05:21.56,0:05:24.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bolos pelajaran itu buang-buang waktu.
Dialogue: 0,0:05:24.30,0:05:26.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, di kondisimu sekarang,
Dialogue: 0,0:05:26.26,0:05:28.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan bahaya saat lewat tangga\Natau berpapasan orang.
Dialogue: 0,0:05:28.82,0:05:31.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin akan membuat takut karena tinggi,
Dialogue: 0,0:05:31.19,0:05:33.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi boleh tidak kalau aku yang membawamu?
Dialogue: 0,0:05:33.46,0:05:34.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:05:34.56,0:05:36.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Betapa kecilnya hidup ini."
Dialogue: 0,0:05:36.68,0:05:38.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nano sangat imut!
Dialogue: 0,0:05:39.58,0:05:43.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ha-Hanya saja, ini tetap menakutkan.
Dialogue: 0,0:05:49.09,0:05:52.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di momen ini, Scissorshand Boy\Nyang jadi tokoh utama.
Dialogue: 0,0:05:52.86,0:05:55.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sangat angry dan berteriak "Oh my God!"
Dialogue: 0,0:05:55.58,0:05:58.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena father yang only family dia\Ntelah Monky destroy.
Dialogue: 0,0:05:58.86,0:06:02.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Boy pun made in heart untuk revenge.\N- Nano, apa perlu aku yang menuliskan catatanmu?
Dialogue: 0,0:06:02.35,0:06:05.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setiap orang punya kebiasaan\Nsaat mencatat pelajaran.
Dialogue: 0,0:06:05.85,0:06:09.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan tidak efisien kalau\Nhalaman ini saja yang tidak selaras.
Dialogue: 0,0:06:09.24,0:06:11.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, dia terlihat sangat kesusahan.
Dialogue: 0,0:06:22.50,0:06:23.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nano.
Dialogue: 0,0:06:38.13,0:06:42.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau pulang dengan wujud seperti itu,\Npasti membuat orang tuamu khawatir.
Dialogue: 0,0:06:42.76,0:06:45.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, kegiatan sehari-harimu\Npasti juga sulit.
Dialogue: 0,0:06:45.57,0:06:49.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak keberatan,\Nmaukah menginap di rumahku biar bisa kubantu?
Dialogue: 0,0:06:49.65,0:06:52.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diriku sekarang di luar dugaan\Ntidak bisa berbuat apa-apa.
Dialogue: 0,0:06:52.78,0:06:55.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan senang kalau boleh seperti itu.
Dialogue: 0,0:06:55.02,0:06:57.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kusampaikan itu pada orang tuaku.
Dialogue: 0,0:06:57.73,0:06:59.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Cenut!\N- Cenut!
Dialogue: 0,0:07:01.15,0:07:03.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Dadah, nanoda!\N- Hati-hati, ya!
Dialogue: 0,0:07:08.66,0:07:11.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiba-tiba anginnya jadi kencang!
Dialogue: 0,0:07:11.72,0:07:14.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, tenang saja.\NAku pasti melindungimu...
Dialogue: 0,0:07:14.58,0:07:17.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa lepas!
Dialogue: 0,0:07:17.10,0:07:20.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lepaskan pakai tanganmu,\Naku tidak akan apa-apa.
Dialogue: 0,0:07:20.21,0:07:24.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, anginnya seperti ini!\NLengah sedikit saja, nyawamu bisa bahaya!
Dialogue: 0,0:07:24.62,0:07:25.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanganku tidak akan kulepas!
Dialogue: 0,0:07:25.73,0:07:26.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:07:29.08,0:07:31.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aijo Rentaro!\NKamu akan mati jika tidak dilepas!
Dialogue: 0,0:07:33.72,0:07:35.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tundukkan kepalamu!
Dialogue: 0,0:07:40.56,0:07:41.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nano!
Dialogue: 0,0:07:42.05,0:07:43.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat!
Dialogue: 0,0:07:43.58,0:07:45.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lepaskan tanganmu, Nano!
Dialogue: 0,0:07:47.71,0:07:49.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tidak dengar karena ketakutan!
Dialogue: 0,0:07:51.28,0:07:54.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku terpisah dari Aijo Rentaro sejauh itu...
Dialogue: 0,0:07:54.21,0:07:55.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nano!
Dialogue: 0,0:07:58.42,0:08:00.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dik Rentaro!
Dialogue: 0,0:08:02.16,0:08:05.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami menyusul karena khawatir\Nanginnya mendadak jadi kencang!
Dialogue: 0,0:08:06.58,0:08:07.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetap seperti itu!
Dialogue: 0,0:08:07.56,0:08:09.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong tetap melaju seperti itu!
Dialogue: 0,0:08:18.63,0:08:19.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak!
Dialogue: 0,0:08:20.20,0:08:22.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peluangku untuk selamat sudah...
Dialogue: 0,0:08:22.48,0:08:24.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nano!
Dialogue: 0,0:08:33.61,0:08:34.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nano!
Dialogue: 0,0:08:35.03,0:08:38.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nano!
Dialogue: 0,0:08:56.70,0:08:57.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dik Rentaro!
Dialogue: 0,0:08:57.81,0:08:59.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Nano!
Dialogue: 0,0:09:22.24,0:09:25.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia langsung tertidur setelah\Nmembuat tempat tidur ini.
Dialogue: 0,0:09:25.60,0:09:26.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak kaget.
Dialogue: 0,0:09:26.84,0:09:31.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepanjang hari ini Aijo Rentaro\Nsudah fokus membantuku.
Dialogue: 0,0:10:04.37,0:10:07.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nano?\NEfek obatnya sudah habis, ya?
Dialogue: 0,0:10:11.68,0:10:16.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be-Benar juga, bajunya sobek\Nsaat dia kembali ke ukuran semula.
Dialogue: 0,0:10:17.53,0:10:21.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aijo Rentaro?\NAku sudah seperti semula, ya?
Dialogue: 0,0:10:21.90,0:10:23.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf sudah membangunkanmu!
Dialogue: 0,0:10:23.25,0:10:25.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang terpenting, pakaianmu sekarang...
Dialogue: 0,0:10:37.26,0:10:38.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku.
Dialogue: 0,0:10:38.56,0:10:43.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah menahan diri untuk memeluk\Ndan menciummu sejak tubuhku mengecil.
Dialogue: 0,0:10:48.04,0:10:51.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aijo Rentaro?\NKenapa kamu pingsan?
Dialogue: 0,0:10:51.64,0:10:54.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bajuku bagaimana...
Dialogue: 0,0:11:05.54,0:11:06.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak kusangka...
Dialogue: 0,0:11:06.98,0:11:10.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat pergi ke rumah Kak Kusuri\Nmalah berakhir seperti ini...
Dialogue: 0,0:11:13.75,0:11:15.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beberapa jam yang lalu.
Dialogue: 0,0:11:17.00,0:11:20.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi ini rumah Kak Kusuri?
Dialogue: 0,0:11:20.20,0:11:21.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, nanoda!
Dialogue: 0,0:11:21.25,0:11:25.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, silakan masuk!\NMeski rumahku kurang sopan.
Dialogue: 0,0:11:25.14,0:11:27.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya Kakak salah pakai ungkapan, deh.
Dialogue: 0,0:11:29.36,0:11:34.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat cerita soal keluarga kita,\NAyah bilang ingin ketemu, nanoda.
Dialogue: 0,0:11:34.19,0:11:35.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dipanggil datang ke rumah...
Dialogue: 0,0:11:35.77,0:11:40.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus menunjukkan ketulusan\Nagar cinta kami bisa diakui.
Dialogue: 0,0:11:40.77,0:11:42.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perasaanku yang tulus ini...
Dialogue: 0,0:11:43.76,0:11:48.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu, aku pulang!\NRentaro juga ikut, nanoda!
Dialogue: 0,0:11:48.11,0:11:50.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu dulu! Ibu?!
Dialogue: 0,0:11:50.53,0:11:52.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari pola kemunculan kerabat selama ini...
Dialogue: 0,0:11:53.40,0:11:56.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan kejadian\NBu Hahari dan Dik Chiyo...
Dialogue: 0,0:11:56.76,0:11:58.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:11:58.42,0:11:59.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan terulang lagi?!
Dialogue: 0,0:12:11.27,0:12:15.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, halo!\NSilakan masuk, nanoyo!
Dialogue: 0,0:12:16.64,0:12:19.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada kejutan.
Dialogue: 0,0:12:19.92,0:12:21.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, ada apa?
Dialogue: 0,0:12:21.97,0:12:24.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, anu, maaf.
Dialogue: 0,0:12:24.63,0:12:25.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senang bertemu dengan Anda!
Dialogue: 0,0:12:27.19,0:12:31.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi jedanya sangat pas buat kejutan,\Naku jadi waspada.
Dialogue: 0,0:12:31.18,0:12:35.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak perlu gugup begitu, nanoyo.
Dialogue: 0,0:12:35.20,0:12:37.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maaf...
Dialogue: 0,0:12:37.08,0:12:39.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anda terlihat muda sekali, ya!
Dialogue: 0,0:12:39.01,0:12:42.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, tidak perlu memuji begitu, nanoyo.
Dialogue: 0,0:12:42.97,0:12:45.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, nyatanya bisa dibilang begitu.
Dialogue: 0,0:12:45.24,0:12:48.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru daripada terlihat muda,\Nmalah bisa dibilang belia.
Dialogue: 0,0:12:48.32,0:12:53.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu juga ikut jadi delapan tahun karena\Nobat keabadianku yang gagal.
Dialogue: 0,0:12:53.34,0:12:54.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibumu juga?!
Dialogue: 0,0:12:54.51,0:12:57.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kau Aijo Rentaro yang\Nmemacari 15 orang itu, ya?
Dialogue: 0,0:12:58.96,0:13:02.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya!\NSenang bertemu Anda, Aya...
Dialogue: 0,0:13:02.48,0:13:05.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berani sekali menunjukkan\Nmukamu di sini, nanosa.
Dialogue: 0,0:13:07.83,0:13:09.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bapak bocil?!
Dialogue: 0,0:13:09.57,0:13:12.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan, Ayahmu juga...
Dialogue: 0,0:13:12.08,0:13:14.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf kalau membuatmu bingung, ya.
Dialogue: 0,0:13:14.83,0:13:18.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kuperkenalkan sekali lagi\Npada keluargaku, nanoda.
Dialogue: 0,0:13:18.45,0:13:19.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ibunya, nanoyo.
Dialogue: 0,0:13:19.82,0:13:21.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ayahnya, nanosa.
Dialogue: 0,0:13:21.32,0:13:22.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan Kusuri, nanoda!
Dialogue: 0,0:13:22.91,0:13:25.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keluarga Kusurivanian!
Dialogue: 0,0:13:27.41,0:13:30.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf ruang tamunya berantakan, nanoyo.
Dialogue: 0,0:13:30.84,0:13:32.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak apa-apa.
Dialogue: 0,0:13:36.98,0:13:38.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini ruang tamunya?
Dialogue: 0,0:13:39.63,0:13:42.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa benda yang mirip alat\Ndari ruangan bos terakhir itu?
Dialogue: 0,0:13:42.58,0:13:45.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu mesin pembuat massal\Nobat penetral, nanoda.
Dialogue: 0,0:13:45.26,0:13:50.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diperlukan karena banyak obat berbahaya\Nyang berserakan di rumah kami, nanoyo.
Dialogue: 0,0:13:50.06,0:13:52.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Contohnya obat di sampingmu itu.
Dialogue: 0,0:13:52.31,0:13:55.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tubuhmu akan meledak kalau meminumnya,\Njadi hati-hati, nanoda.
Dialogue: 0,0:13:55.37,0:13:57.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benda seperti itu ada di meja makan?!
Dialogue: 0,0:13:57.10,0:14:00.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keluarga kami sudah turun-temurun\Npunya hobi membuat obat.
Dialogue: 0,0:14:00.96,0:14:05.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga bertemu dengan suamiku\Ndi laboratorium obat, nanoyo.
Dialogue: 0,0:14:05.13,0:14:08.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat mata kami bertemu,\Nada kejutan yang mengalir, nanoyo!
Dialogue: 0,0:14:08.53,0:14:12.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bocah yang memacari 15 orang\Nmana mungkin mengerti, nanosa.
Dialogue: 0,0:14:13.72,0:14:16.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu Kusuri yang terlahir dari kami berdua.
Dialogue: 0,0:14:18.40,0:14:22.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak pernah melirik rumah boneka\Nyang disiapkan untuknya
Dialogue: 0,0:14:22.59,0:14:24.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan malah memainkan alat penyulingan.
Dialogue: 0,0:14:24.71,0:14:26.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putri kita memang hebat, nanosa.
Dialogue: 0,0:14:26.77,0:14:29.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cerita Kak Kusuri saat masih bayi!
Dialogue: 0,0:14:29.40,0:14:34.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, saat usianya baru 8 bulan,\Ndia berhasil membuat obat baru pertamanya.
Dialogue: 0,0:14:34.29,0:14:37.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak diragukan lagi Kusuri ahli\Npencipta obat genius yang penuh
Dialogue: 0,0:14:37.40,0:14:40.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan esensi ilmu farmasi\Nkeluarga Yakuzen, nanoyo.
Dialogue: 0,0:14:40.76,0:14:42.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia memang genius, nanosa.
Dialogue: 0,0:14:42.04,0:14:43.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Genius, nanoda.
Dialogue: 0,0:14:46.15,0:14:47.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, kau!
Dialogue: 0,0:14:47.71,0:14:48.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya?!
Dialogue: 0,0:14:48.62,0:14:53.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau benar-benar berpikir kalau Kusuri\Nadalah gadis paling berharga di dunia?!
Dialogue: 0,0:14:54.33,0:14:55.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:14:55.52,0:14:56.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bersumpah dari hati...
Dialogue: 0,0:14:56.84,0:15:00.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus kenapa kau tidak segera\Nputus dengan 14 pacarmu itu?!
Dialogue: 0,0:15:00.66,0:15:04.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Kusuri nomor satu di dunia,\Npacarilah Kusuri seorang saja, nanosa!
Dialogue: 0,0:15:04.85,0:15:07.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka semua nomor satu di dunia.
Dialogue: 0,0:15:07.98,0:15:09.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau meremehkanku, berengsek?!
Dialogue: 0,0:15:17.88,0:15:18.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Abebe?!
Dialogue: 0,0:15:21.31,0:15:22.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa yang terjadi?!
Dialogue: 0,0:15:22.74,0:15:23.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian baik-baik saja?!
Dialogue: 0,0:15:25.19,0:15:27.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bau ini...
Dialogue: 0,0:15:27.07,0:15:29.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tehnya sudah dicampur suatu obat, nanoda!
Dialogue: 0,0:15:34.84,0:15:36.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tepat sekali.
Dialogue: 0,0:15:36.33,0:15:39.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis ahli obat genius memanglah hebat.
Dialogue: 0,0:15:39.32,0:15:40.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yakuzen Kusuri.
Dialogue: 0,0:15:40.84,0:15:42.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maaf mengganggu.
Dialogue: 0,0:15:42.72,0:15:44.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, dia bukan keluargaku!
Dialogue: 0,0:15:44.60,0:15:47.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yakuzen Kusuri, aku ini...
Dialogue: 0,0:15:47.18,0:15:51.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}punya misi untuk membawamu kembali\Nke suatu laboratorium di luar negeri.
Dialogue: 0,0:15:52.11,0:15:55.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian bisa memanggilku mata-mata farmasi.
Dialogue: 0,0:15:59.17,0:16:00.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak kusangka...
Dialogue: 0,0:16:00.36,0:16:04.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat pergi ke rumah Kak Kusuri\Nmalah berakhir seperti ini...
Dialogue: 0,0:16:04.86,0:16:07.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Adegan kilas baliknya panjang sekali.
Dialogue: 0,0:16:07.06,0:16:09.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, sampai sini itu\Ncuma kilas balik, nanoda?!
Dialogue: 0,0:16:09.63,0:16:12.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata sampai dibuat menunggu lima menit.
Dialogue: 0,0:16:12.29,0:16:15.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tipe penjahat yang menunggu\Nsampai kilas balik selesai, nanoda!
Dialogue: 0,0:16:16.65,0:16:19.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian mengerti kenapa aku di sini, bukan?
Dialogue: 0,0:16:20.15,0:16:25.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemampuanmu membuat segala obat\Njelas akan diinginkan organisasi mana pun.
Dialogue: 0,0:16:25.64,0:16:30.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah menaruh racun mematikan\Nyang kuat di cangkir teh kalian.
Dialogue: 0,0:16:30.52,0:16:33.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dibiarkan, orang tuamu akan mati.
Dialogue: 0,0:16:34.23,0:16:38.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai ganti obat penawarnya,\Nkau harus patuh ikut ke laboratorium!
Dialogue: 0,0:16:39.17,0:16:41.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baiklah, nanoda.
Dialogue: 0,0:16:41.24,0:16:43.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke mana saja aku akan ikut,\Ncepat berikan penawarnya!
Dialogue: 0,0:16:43.41,0:16:45.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan, Kak Kusuri!
Dialogue: 0,0:16:45.16,0:16:46.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan menghalangi!
Dialogue: 0,0:16:46.12,0:16:47.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mau mati, ya?!
Dialogue: 0,0:16:50.14,0:16:51.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tembak saja kalau kau mau tembak!
Dialogue: 0,0:16:51.68,0:16:52.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?!
Dialogue: 0,0:16:52.69,0:16:56.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Kusuri mati, Kusuri tidak akan bisa\Nmenciptakan obat!
Dialogue: 0,0:16:59.57,0:17:01.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Kusuri.
Dialogue: 0,0:17:01.26,0:17:04.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mendekatlah perlahan\Nke meja makan seperti itu.
Dialogue: 0,0:17:05.25,0:17:07.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asal bisa mengambil obat itu...
Dialogue: 0,0:17:13.64,0:17:14.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bising!
Dialogue: 0,0:17:14.53,0:17:16.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan coba-coba melawan!\NMenyebalkan saja!
Dialogue: 0,0:17:16.84,0:17:17.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minggir!
Dialogue: 0,0:17:17.97,0:17:21.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski kau jadi tameng, aku masih bisa\Nmenembak titik aman seperti kaki!
Dialogue: 0,0:17:24.09,0:17:25.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan membiarkanmu!
Dialogue: 0,0:17:27.34,0:17:29.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau yang jadi tameng sekarang?!
Dialogue: 0,0:17:29.62,0:17:31.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, nanoda?!\NKau ini bodoh, ya?!
Dialogue: 0,0:17:31.88,0:17:33.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau bodoh atau apa, terserah!
Dialogue: 0,0:17:33.39,0:17:36.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku tidak akan membiarkan\NKakak terluka!
Dialogue: 0,0:17:40.41,0:17:43.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak apa-apa, kok, Rentaro.
Dialogue: 0,0:17:43.04,0:17:47.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kusuri yakin mengembangkan obat\Ndi lab mereka pasti akan menyenangkan.
Dialogue: 0,0:17:47.65,0:17:49.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Jadi...\N- Itu jelas tidak boleh!
Dialogue: 0,0:17:49.50,0:17:54.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski obat Kak Kusuri ada kalanya\Nmalah membuat masalah.
Dialogue: 0,0:17:54.43,0:18:00.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, sudah membuat banyak kenangan\Nyang tak tergantikan untuk kami.
Dialogue: 0,0:18:00.03,0:18:02.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu seru, menyenangkan,
Dialogue: 0,0:18:02.45,0:18:05.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}penuh perasaan, dan sangat berharga\Nbagi kami.
Dialogue: 0,0:18:06.86,0:18:10.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membiarkan obat Kak Kusuri yang kucinta\Ndisalahgunakan seperti itu,
Dialogue: 0,0:18:10.89,0:18:12.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku jelas tidak akan rela!
Dialogue: 0,0:18:14.63,0:18:16.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rentaro...
Dialogue: 0,0:18:24.06,0:18:26.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus Kusuri harus bagaimana?!
Dialogue: 0,0:18:26.46,0:18:30.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kusuri tidak mau ayah dan ibu mati!
Dialogue: 0,0:18:30.00,0:18:32.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kusuri juga tidak mau membuat\Nobat yang jahat!
Dialogue: 0,0:18:32.72,0:18:35.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, juga tidak mau kamu ditembak!
Dialogue: 0,0:18:35.44,0:18:38.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak tahu harus bagaimana!\NTidak tahu harus bagaimana, tapi...
Dialogue: 0,0:18:38.74,0:18:41.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rentaro, aku mencintaimu!
Dialogue: 0,0:18:41.73,0:18:43.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo ciuman, nanoda!
Dialogue: 0,0:18:44.52,0:18:50.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cium, cium, cium, cium, cium...
Dialogue: 0,0:18:50.58,0:18:52.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedang apa kalian ini?!
Dialogue: 0,0:18:52.84,0:18:55.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat, ini pistol, lho! Beceng!
Dialogue: 0,0:18:55.26,0:18:57.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kena tembak, nanti mati!\NTahu tidak?!
Dialogue: 0,0:18:59.00,0:19:01.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak TK juga tahu itu, nanoda.
Dialogue: 0,0:19:01.72,0:19:06.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak TK juga tahu kalau ini\Nbukan waktunya buat mesra-mesraan!
Dialogue: 0,0:19:06.46,0:19:09.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudahlah! Akan kubuat kau\Nmengerti dengan tubuhmu!
Dialogue: 0,0:19:19.32,0:19:20.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan, Rentaro...
Dialogue: 0,0:19:26.86,0:19:28.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak...
Dialogue: 0,0:19:28.71,0:19:31.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Rentaro...\N- Berani sekali kelakuanmu.
Dialogue: 0,0:19:31.73,0:19:35.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar bocah sialan dengan 15 pacar!
Dialogue: 0,0:19:35.07,0:19:37.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayahnya Kak Kusuri?!
Dialogue: 0,0:19:37.49,0:19:39.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anda baik-baik saja?
Dialogue: 0,0:19:39.00,0:19:42.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ha? Ini tidak akan mempan padaku, nanosa.
Dialogue: 0,0:19:42.76,0:19:46.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sendiri sudah banyak bereksperimen\Npada tubuhku hingga
Dialogue: 0,0:19:46.26,0:19:49.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}obat penetral tidak bisa menetralkannya!
Dialogue: 0,0:19:49.81,0:19:50.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Hulk?!\N- Hulk?!
Dialogue: 0,0:19:50.50,0:19:51.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah!
Dialogue: 0,0:19:53.28,0:19:55.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jawab aku, bocah sialan.
Dialogue: 0,0:19:55.01,0:19:57.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini semua sudah kau perhitungkan, nanosa?
Dialogue: 0,0:19:57.90,0:20:01.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pura-pura butuh obat yang di atas meja\Nuntuk memancing dia menembak.
Dialogue: 0,0:20:01.65,0:20:07.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk menghancurkan tangki obat penetral\Nyang sejajar dengan lintasan pelurunya.
Dialogue: 0,0:20:07.02,0:20:11.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agar obat penetral dari sana\Nmengalir ke kami yang terkapar.
Dialogue: 0,0:20:14.28,0:20:16.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berisik kau, bangsat!
Dialogue: 0,0:20:16.10,0:20:19.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mata-mata undur diri!
Dialogue: 0,0:20:20.16,0:20:21.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa dia mati?
Dialogue: 0,0:20:21.46,0:20:24.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Iya, benar.\N- Tidak, dia cuma jadi bintang di langit.
Dialogue: 0,0:20:24.42,0:20:26.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Racun juga termasuk obat.
Dialogue: 0,0:20:26.12,0:20:29.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku bertaruh mungkin bisa diatasi\Ndengan obat penetral.
Dialogue: 0,0:20:29.62,0:20:33.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau berjalan lancar, tidak butuh lagi\Nobat penawar dari mata-mata itu.
Dialogue: 0,0:20:33.82,0:20:37.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, Kak Kusuri tidak perlu\Nmenuruti perintahnya.
Dialogue: 0,0:20:46.30,0:20:50.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bocah sialan dengan 15 pacar,\Nbiar kuakui dirimu.
Dialogue: 0,0:20:50.54,0:20:55.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kau benar-benar menganggap Kusuri\Nyang paling berharga di dunia.
Dialogue: 0,0:20:55.99,0:20:57.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah mertua...
Dialogue: 0,0:20:57.46,0:21:00.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak mau dipanggil\Nayah mertua sama kau!
Dialogue: 0,0:21:00.44,0:21:01.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah, sudah, nanoyo.
Dialogue: 0,0:21:01.96,0:21:04.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sombong dulu, berengsek!
Dialogue: 0,0:21:04.03,0:21:06.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belum terima kalau kau punya 15 pacar!
Dialogue: 0,0:21:06.67,0:21:08.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak, Dik Rentaro.
Dialogue: 0,0:21:08.99,0:21:12.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah menyelamatkan\NKusuri dan kami berdua.
Dialogue: 0,0:21:12.41,0:21:14.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Ibu mertua...
Dialogue: 0,0:21:14.16,0:21:15.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak masalah...
Dialogue: 0,0:21:15.34,0:21:16.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rentaro!
Dialogue: 0,0:21:17.49,0:21:19.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rentaro, terima kasih, nanoda!
Dialogue: 0,0:21:19.92,0:21:24.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyelamatkan kekasihku itu\Nsudah jadi kewajibanku.
Dialogue: 0,0:21:24.14,0:21:27.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, soal itu...
Dialogue: 0,0:21:27.34,0:21:33.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena ayah dan ibu menyukai Rentaro\Nyang aku cintai sekarang.
Dialogue: 0,0:21:33.69,0:21:37.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kusuri rasanya jadi sangat senang.
Dialogue: 0,0:21:37.74,0:21:39.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Kusuri...
Dialogue: 0,0:21:39.74,0:21:41.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rentaro...
Dialogue: 0,0:21:47.88,0:21:50.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada ribut-ribut apa ini, nanoja?
Dialogue: 0,0:21:50.28,0:21:52.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada seseorang yang terbang, nanoja.
Dialogue: 0,0:21:52.50,0:21:53.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, selamat datang!
Dialogue: 0,0:21:53.86,0:21:55.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nenek, coba lihat!
Dialogue: 0,0:21:55.34,0:21:57.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini pacar Kusuri, Rentaro, nanoda!
Dialogue: 0,0:21:57.48,0:21:59.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, maaf mengganggu!
Dialogue: 0,0:21:59.48,0:22:01.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nama saya Aijo Rentaro.
Dialogue: 0,0:22:02.87,0:22:04.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inilah kejutannya!
Dialogue: 0,0:22:04.43,0:22:05.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kejutannya baru sekarang!
Dialogue: 0,0:22:05.78,0:22:07.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jodohmu adalah seorang nenek?!
Dialogue: 0,0:22:07.71,0:22:08.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi aku bilang nenek?!
Dialogue: 0,0:22:08.93,0:22:10.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pacar barunya seorang nenek, nih?!
Dialogue: 0,0:22:10.92,0:22:12.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang benar saja?!
Dialogue: 0,0:22:12.78,0:22:17.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah pacar baru Rentaro\Nbenar-benar seorang nenek atau tidak?!
Dialogue: 0,0:22:17.07,0:22:20.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah benar?!
