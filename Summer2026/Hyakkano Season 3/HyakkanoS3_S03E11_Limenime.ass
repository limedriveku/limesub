Dialogue: 0,0:04:26.08,0:04:27.79,sign,,0000,0000,0000,,KANTOR KETUA YAYASAN
Dialogue: 0,0:07:38.19,0:07:39.69,sign,,0000,0000,0000,,TANTANGAN KUIS
Dialogue: 0,0:15:41.63,0:15:44.88,sign,,0000,0000,0000,,IMUT SEKALI, MENGGEMASKAN\NINGIN KUELUS
Dialogue: 0,0:15:48.76,0:15:51.89,sign,,0000,0000,0000,,KISAH CINTA MAHKOTA
Dialogue: 0,0:16:33.18,0:16:33.59,sign,,0000,0000,0000,,KISAH CINTA MAHKOTA
Dialogue: 0,0:00:16.49,0:00:18.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai jumpa besok, Ibu Ketua Yayasan!
Dialogue: 0,0:00:18.65,0:00:19.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai jumpa besok!
Dialogue: 0,0:00:19.99,0:00:21.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai jumpa.
Dialogue: 0,0:00:21.45,0:00:23.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hati-hati saat pulang, ya.
Dialogue: 0,0:00:23.30,0:00:24.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, Bu!
Dialogue: 0,0:00:24.64,0:00:26.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak!
Dialogue: 0,0:00:26.85,0:00:29.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketua Yayasan hari ini juga terlihat cantik!
Dialogue: 0,0:00:29.25,0:00:31.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh cantik dan bikin terpesona, ya.
Dialogue: 0,0:00:31.76,0:00:34.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, murid-muridku yang manis...
Dialogue: 0,0:00:38.85,0:00:41.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manajer tempatku kerja paruh waktu,\Nkemarin menyatakan cinta padaku.
Dialogue: 0,0:00:41.65,0:00:42.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mantap, ya.
Dialogue: 0,0:00:42.90,0:00:44.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mantap dari mana?
Dialogue: 0,0:00:44.53,0:00:47.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manajerku umurnya 29,\Nsama sudah punya anak, lho.
Dialogue: 0,0:00:47.36,0:00:49.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, kalau lebih tua\Nhampir satu shio begitu...
Dialogue: 0,0:00:49.81,0:00:51.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayaknya enggak masuk, deh.
Dialogue: 0,0:00:51.81,0:00:54.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal tokonya enak, lho.
Dialogue: 0,0:00:54.54,0:00:58.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bikin canggung kalau tatap muka,\Nmana bisa kuteruskan kerja di sana.
Dialogue: 0,0:00:58.74,0:01:00.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyonya Hahari.
Dialogue: 0,0:01:01.53,0:01:03.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa perlu saya bereskan saja?
Dialogue: 0,0:01:03.00,0:01:05.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka itu murid, lho.
Dialogue: 0,0:01:18.93,0:01:24.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}100 Pacar yang Sungguh Sangat Amat\NBenar-benar Mencintaimu Musim Ketiga
Dialogue: 0,0:02:41.14,0:02:44.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menko Nyonya Yaku dapat satu poin.
Dialogue: 0,0:02:44.77,0:02:45.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuat sekali!
Dialogue: 0,0:02:45.98,0:02:48.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bermain menko membuatku merasa nostalgia.
Dialogue: 0,0:02:48.31,0:02:50.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dulu sering memainkannya.
Dialogue: 0,0:02:50.52,0:02:52.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang pantas disebut generasi aktif.
Dialogue: 0,0:02:52.57,0:02:55.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Benar-benar legenda hidup."
Dialogue: 0,0:02:55.07,0:02:57.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nenek Kusuri memang hebat, nanoda!
Dialogue: 0,0:02:57.45,0:02:59.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya I am!
Dialogue: 0,0:02:59.78,0:03:01.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I am menarik kartu!
Dialogue: 0,0:03:01.54,0:03:05.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Super America Dragon akan menyemburkan fire!
Dialogue: 0,0:03:05.66,0:03:07.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau soal kecantikan!
Dialogue: 0,0:03:07.79,0:03:10.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beauty Queen milikku juga tidak akan kalah!
Dialogue: 0,0:03:10.29,0:03:11.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Let's bertarung!
Dialogue: 0,0:03:12.88,0:03:17.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski selama ini sudah kusimpan\Nagar tidak membuat adik-adikku menangis,
Dialogue: 0,0:03:17.18,0:03:20.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi biar kutunjukkan\Nkesungguhan Kishidomaru milikku!
Dialogue: 0,0:03:20.55,0:03:22.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa sebenarnya yang terjadi di sini?
Dialogue: 0,0:03:22.93,0:03:26.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin, sebuah janji?
Dialogue: 0,0:03:27.69,0:03:29.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasakan ini!
Dialogue: 0,0:03:29.23,0:03:30.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah!
Dialogue: 0,0:03:30.19,0:03:33.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inilah tepukan kecantikan terakhirku!
Dialogue: 0,0:03:34.94,0:03:37.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kishidomaru!
Dialogue: 0,0:03:37.20,0:03:41.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Andai Momiji bisa menahan tetek yang\Nbergoyang saat mereka melempar kartu menko.
Dialogue: 0,0:03:41.49,0:03:42.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Glek.
Dialogue: 0,0:03:42.33,0:03:45.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I am yang rising!
Dialogue: 0,0:03:45.96,0:03:47.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin...
Dialogue: 0,0:03:47.41,0:03:52.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, memang pantas disebut Beauty Queen,\Nsaat kartunya terbalik pun terlihat cantik!
Dialogue: 0,0:03:52.17,0:03:53.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Naddy mendapat satu poin!
Dialogue: 0,0:03:54.80,0:03:56.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu Naddy juga kuat sekali, dado!
Dialogue: 0,0:03:56.84,0:03:59.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I am sudah digembleng sejak dulu.
Dialogue: 0,0:03:59.64,0:04:00.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu Naddy!
Dialogue: 0,0:04:01.72,0:04:04.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong beri saya gemblengan sekuat tenaga.
Dialogue: 0,0:04:05.31,0:04:06.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menma...
Dialogue: 0,0:04:06.98,0:04:09.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo nanti kita makan ramen lagi, ya?
Dialogue: 0,0:04:09.90,0:04:11.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I am akan rising!
Dialogue: 0,0:04:11.52,0:04:12.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh!
Dialogue: 0,0:04:12.56,0:04:13.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasakan!
Dialogue: 0,0:04:13.27,0:04:14.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh!
Dialogue: 0,0:04:14.48,0:04:15.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semburan fire!
Dialogue: 0,0:04:15.65,0:04:16.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Aduh!\N- Bu Hahari.
Dialogue: 0,0:04:17.27,0:04:20.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa setelah ini Anda ada acara?
Dialogue: 0,0:04:20.27,0:04:22.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Tidak ada, kok.
Dialogue: 0,0:04:22.83,0:04:24.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:04:24.45,0:04:26.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untunglah!
Dialogue: 0,0:04:29.25,0:04:33.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mau kencan denganku\Nsepulang sekolah memakai ini?!
Dialogue: 0,0:04:33.34,0:04:38.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah Bu Hahari tempo hari bilang\Ningin kembali menjadi anak SMA?
Dialogue: 0,0:04:38.92,0:04:42.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya saya jadi ingin berkencan\Ndengan Ibu sebagai anak SMA.
Dialogue: 0,0:04:42.89,0:04:46.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, mungkin nanti malu\Nkalau sama yang lain,
Dialogue: 0,0:04:46.77,0:04:49.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi kupikir saat bisa berduaan saja.
Dialogue: 0,0:04:50.27,0:04:52.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja saya tidak akan memaksa.
Dialogue: 0,0:04:52.48,0:04:54.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Anda tidak mau sendirian,
Dialogue: 0,0:04:54.77,0:04:56.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}saya juga akan jalan pakai ini!
Dialogue: 0,0:04:56.28,0:04:57.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, imutnya!
Dialogue: 0,0:04:58.24,0:05:03.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, mari kita simpan pakaian itu\Nuntuk kesempatan lain...
Dialogue: 0,0:05:14.79,0:05:19.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, sepertinya ini bakal segera ketahuan...
Dialogue: 0,0:05:20.01,0:05:22.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti tidak masalah,\Ntenang saja, Kak Hahari.
Dialogue: 0,0:05:22.89,0:05:25.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Hahari...
Dialogue: 0,0:05:27.89,0:05:31.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, 'kan...\NMereka memperhatikanku...
Dialogue: 0,0:05:31.39,0:05:33.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu lihat anak SMA Ohananomitsu tadi?
Dialogue: 0,0:05:33.81,0:05:36.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa murid kelas tiga, ya?\NCantik sekali!
Dialogue: 0,0:05:47.49,0:05:48.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini tempatnya!
Dialogue: 0,0:05:48.62,0:05:50.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita sudah sampai, Kak Hahari!
Dialogue: 0,0:05:51.83,0:05:53.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah tempat ini...
Dialogue: 0,0:05:57.71,0:05:59.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teddy Baby?!
Dialogue: 0,0:05:59.46,0:06:03.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu acara TV yang disukai Kak Hahari\Nketika masih kecil, 'kan?
Dialogue: 0,0:06:03.47,0:06:07.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya dengar baru dibuka museumnya,\Nlalu kepikiran buat kencan ke sini.
Dialogue: 0,0:06:10.35,0:06:13.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo!\NAyo kita masuk!
Dialogue: 0,0:06:14.40,0:06:15.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo cepat!
Dialogue: 0,0:06:15.85,0:06:17.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo cepat masuk!
Dialogue: 0,0:06:17.15,0:06:19.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu Hahari riang bersemangat...
Dialogue: 0,0:06:19.48,0:06:21.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Imut sekali!
Dialogue: 0,0:06:39.13,0:06:41.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pernah punya boneka ini!
Dialogue: 0,0:06:41.42,0:06:46.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perusahaan kami jadi sponsor saat tayang\Ndan Ibunda memberikannya padaku.
Dialogue: 0,0:06:46.93,0:06:49.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku selalu membawanya ke mana-mana,\Ndan juga merawatnya.
Dialogue: 0,0:06:49.76,0:06:52.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saking gemasnya,\Njadi tidak tahan untuk kucium.
Dialogue: 0,0:06:52.68,0:06:54.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, imutnya.
Dialogue: 0,0:06:57.15,0:06:59.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebelum tidur, selalu kuberi ciuman lidah.
Dialogue: 0,0:06:59.29,0:07:00.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi?!
Dialogue: 0,0:07:00.15,0:07:02.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan itu, Hahari!
Dialogue: 0,0:07:03.19,0:07:04.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Imut sekali, ya.
Dialogue: 0,0:07:06.28,0:07:08.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat ini, Dik Rentaro!
Dialogue: 0,0:07:08.37,0:07:09.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baby yang ini...
Dialogue: 0,0:07:09.49,0:07:11.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Dibuat terbatas hanya 10 buah saat\N- Bu Hahari terlihat sangat menikmatinya.
Dialogue: 0,0:07:11.66,0:07:13.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- ulang tahun ke-10 Teddy Baby!\N- Aku senang bisa lahir di dunia ini!
Dialogue: 0,0:07:28.34,0:07:32.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, ayo coba yang itu, Kak Hahari!
Dialogue: 0,0:07:35.98,0:07:38.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini seperti mimpi...
Dialogue: 0,0:07:39.69,0:07:44.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau menjawab semua pertanyaan dengan\Nbenar, akan dapat Teddy Baby premium?!
Dialogue: 0,0:07:45.49,0:07:46.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau!
Dialogue: 0,0:07:46.74,0:07:49.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya dua orang\Nbisa menantangnya sekaligus.
Dialogue: 0,0:07:49.45,0:07:51.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita tantang bersama-sama!
Dialogue: 0,0:07:51.87,0:07:52.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:07:53.33,0:07:55.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang di pojok kuis!
Dialogue: 0,0:07:57.25,0:07:59.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Langsung saja pertanyaan pertama!
Dialogue: 0,0:07:59.42,0:08:04.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hadiah yang diberikan pada episode 134\Nberjudul Ulang Tahun Ibu...
Dialogue: 0,0:08:04.88,0:08:06.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak salah, cermin tangan?
Dialogue: 0,0:08:06.84,0:08:10.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berapa jumlah totol-totol\Ndi bungkus kadonya?
Dialogue: 0,0:08:10.72,0:08:12.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin bisa tahu itu?!
Dialogue: 0,0:08:12.47,0:08:15.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan menyerah meski\Npertanyaannya terlalu susah.
Dialogue: 0,0:08:15.35,0:08:18.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau menonton episodenya\Nberulang kali, pasti tahu!
Dialogue: 0,0:08:18.73,0:08:22.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, paket boks Blu-Ray\Ndijual di pojok oleh-oleh, lho.
Dialogue: 0,0:08:22.86,0:08:26.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak ingin lihat Teddy Baby\Nyang lihai berbisnis begini!
Dialogue: 0,0:08:26.99,0:08:29.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm, totalnya 64 totol?
Dialogue: 0,0:08:29.82,0:08:30.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?!
Dialogue: 0,0:08:30.66,0:08:32.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be-Benar.
Dialogue: 0,0:08:32.49,0:08:33.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kok, kamu bisa tahu?!
Dialogue: 0,0:08:33.99,0:08:38.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya saya ingin menghadiahkan\NPremium Teddy Baby untuk Kak Hahari,
Dialogue: 0,0:08:38.71,0:08:41.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi kutonton semua lewat kanal berlangganan.
Dialogue: 0,0:08:41.00,0:08:41.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cenut!
Dialogue: 0,0:08:41.75,0:08:44.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kanal langganan berengsek...
Dialogue: 0,0:08:44.71,0:08:48.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kursi di baris ke-25 dari jendela\Ndan baris ke-37 dari belakang!
Dialogue: 0,0:08:48.38,0:08:50.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be-Benar!
Dialogue: 0,0:08:50.05,0:08:51.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu!
Dialogue: 0,0:08:51.34,0:08:54.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Adik laki-laki beda ibu teman anak ketiga
Dialogue: 0,0:08:54.01,0:08:57.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dari empat bersaudari anaknya\Nkakak laki-laki nenek pihak ibu!
Dialogue: 0,0:08:57.14,0:08:58.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar!
Dialogue: 0,0:08:58.02,0:08:59.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu yang lebih tua!
Dialogue: 0,0:08:59.31,0:09:00.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar!
Dialogue: 0,0:09:00.14,0:09:01.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berpisah!
Dialogue: 0,0:09:01.02,0:09:01.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar!
Dialogue: 0,0:09:01.77,0:09:02.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dadu!
Dialogue: 0,0:09:02.48,0:09:03.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar!
Dialogue: 0,0:09:03.06,0:09:03.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pohon!
Dialogue: 0,0:09:03.65,0:09:04.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar!
Dialogue: 0,0:09:05.69,0:09:07.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pe-Pertanyaan kesepuluh.
Dialogue: 0,0:09:09.70,0:09:13.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai episode ke-43 berjudul\N"Anak Baik Harus Makan Wortel, Ya" dan seterusnya,
Dialogue: 0,0:09:13.53,0:09:18.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa alasan sebenarnya mulut\NTeddy Baby tidak bisa dibuka lagi?
Dialogue: 0,0:09:18.41,0:09:21.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu karena tidak mau makan\Nwortel yang dibenci,
Dialogue: 0,0:09:21.21,0:09:23.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tolong, tunggu sebentar.\N- mulutnya dijahit...
Dialogue: 0,0:09:23.33,0:09:26.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini mendadak terlalu mudah\Nuntuk pertanyaan terakhir.
Dialogue: 0,0:09:26.88,0:09:29.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa jadi ini pertanyaan jebakan.
Dialogue: 0,0:09:30.01,0:09:31.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:09:31.13,0:09:33.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bilang "alasan sebenarnya", 'kan?
Dialogue: 0,0:09:33.18,0:09:37.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh iya, semua Teddy Baby\Nyang dijual setelah episode 43,
Dialogue: 0,0:09:37.60,0:09:42.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mulutnya tertutup seperti di dalam acaranya.
Dialogue: 0,0:09:42.35,0:09:47.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat Ibunda menukar punyaku\Ndengan yang baru karena kotor,
Dialogue: 0,0:09:47.23,0:09:51.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa kuingat jelas karena\Naku kecewa mulutnya tertutup.
Dialogue: 0,0:09:51.36,0:09:52.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu dia!
Dialogue: 0,0:09:52.45,0:09:55.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penyebab produknya diubah\Nadalah alasan sebenarnya!
Dialogue: 0,0:09:55.74,0:10:00.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, selain orang dalam, mana mungkin\Nbisa tahu urusan di balik layar seperti itu.
Dialogue: 0,0:10:00.20,0:10:02.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang dalam?
Dialogue: 0,0:10:07.09,0:10:08.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jawabannya karena ada keluhan
Dialogue: 0,0:10:08.96,0:10:13.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dari direktur perusahaan sponsor kalau\Nputrinya suka ciuman lidah dengan boneka itu?
Dialogue: 0,0:10:15.26,0:10:16.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?!
Dialogue: 0,0:10:16.39,0:10:18.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana bisa tahu hal itu?!
Dialogue: 0,0:10:18.93,0:10:19.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu benar.
Dialogue: 0,0:10:19.93,0:10:22.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Berhasil!\N- Berhasil!
Dialogue: 0,0:10:40.41,0:10:44.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, Kak Hahari.\NSudah waktunya kita pulang.
Dialogue: 0,0:10:54.84,0:10:57.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku, tidak mau pulang.
Dialogue: 0,0:10:59.35,0:11:03.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau pulang, nanti aku\Nkembali jadi "Bu Hahari".
Dialogue: 0,0:11:04.48,0:11:07.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu terbangun dari mimpi ini.
Dialogue: 0,0:11:16.03,0:11:17.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau saja...
Dialogue: 0,0:11:17.99,0:11:21.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau saja aku lahir di tahun\Nyang dekat denganmu.
Dialogue: 0,0:11:25.16,0:11:27.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, saya justru bersyukur.
Dialogue: 0,0:11:27.62,0:11:31.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena Bu Hahari lahir terpaut jauh dariku.
Dialogue: 0,0:11:33.00,0:11:37.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu Hahari saat SMA,\Nsaya rasa pasti sangat menawan.
Dialogue: 0,0:11:38.18,0:11:41.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, saya yakin tidak akan bisa\Nmenandingi Bu Hahari yang sekarang.
Dialogue: 0,0:11:44.18,0:11:46.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski takdir bisa diubah
Dialogue: 0,0:11:46.69,0:11:51.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan Bu Hahari ingin lahir dengan usia\Nyang lebih dekat denganku.
Dialogue: 0,0:11:51.69,0:11:56.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya sendiri akan memilih untuk\Ntetap lahir terpaut jauh.
Dialogue: 0,0:11:56.57,0:12:00.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena berapa kali pun itu,\Nsaya ingin bertemu Bu Hahari yang sekarang.
Dialogue: 0,0:12:00.66,0:12:02.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dik Rentaro...
Dialogue: 0,0:12:05.04,0:12:08.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bodohnya aku ini...
Dialogue: 0,0:12:11.46,0:12:13.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Hahari, lihat ini...
Dialogue: 0,0:12:13.71,0:12:15.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, ini!
Dialogue: 0,0:12:15.30,0:12:17.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boneka ini bisa berkedip!
Dialogue: 0,0:12:17.67,0:12:20.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kubelikan saja buat Hakari, ya?
Dialogue: 0,0:12:20.97,0:12:22.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, maaf.
Dialogue: 0,0:12:22.55,0:12:26.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal Dik Rentaro sudah\Nmembuat hari ini jadi kencan anak SMA.
Dialogue: 0,0:12:26.60,0:12:29.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku malah memikirkan hadiah untuk putriku.
Dialogue: 0,0:12:30.44,0:12:34.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ternyata memang seperti ini, ya...
Dialogue: 0,0:12:34.36,0:12:35.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.
Dialogue: 0,0:12:35.28,0:12:35.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:12:36.57,0:12:42.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, saya sendiri juga terpesona\Noleh sisi keibuan Bu Hahari...
Dialogue: 0,0:12:42.91,0:12:45.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya tidak bisa\Nmelihat Ibu sebagai anak SMA...
Dialogue: 0,0:12:45.91,0:12:47.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi...
Dialogue: 0,0:12:47.20,0:12:49.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya juga sama.
Dialogue: 0,0:12:50.33,0:12:52.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia memang paling imut sedunia...
Dialogue: 0,0:12:55.17,0:12:56.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu Hahari...
Dialogue: 0,0:13:22.41,0:13:23.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shizuka.
Dialogue: 0,0:13:32.04,0:13:32.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?!
Dialogue: 0,0:13:33.33,0:13:35.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ponselku...
Dialogue: 0,0:13:36.80,0:13:38.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rusak?
Dialogue: 0,0:13:38.76,0:13:41.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, akan memakan waktu untuk diperbaiki.
Dialogue: 0,0:13:41.63,0:13:46.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mau menempa ulang papan besi,\Naku kenal pandai besi yang bagus, nanoja.
Dialogue: 0,0:13:46.05,0:13:50.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya Kak Shizuka mau Anda suruh\Nbertualang ke mana?!
Dialogue: 0,0:13:50.06,0:13:52.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, jadi hard mode untuk talk.
Dialogue: 0,0:13:53.81,0:13:57.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Masih bisa pakai isyarat,\Njadi tidak masalah," ya?
Dialogue: 0,0:13:57.23,0:14:00.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, kemarin kamu nonton apa di TV?
Dialogue: 0,0:14:05.28,0:14:06.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Burung, dado?
Dialogue: 0,0:14:10.33,0:14:11.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penguin?
Dialogue: 0,0:14:11.62,0:14:14.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu!\NPentaro, nanoda!
Dialogue: 0,0:14:14.17,0:14:15.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ah, gawat ini!\N- Ah, gawat ini!
Dialogue: 0,0:14:19.92,0:14:21.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu juga menonton Spirited Away?
Dialogue: 0,0:14:21.80,0:14:24.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kaonashi diam-diam menculik Shizuka!\N- Kaonashi diam-diam menculik Shizuka!
Dialogue: 0,0:14:32.18,0:14:33.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yoshimoto Shizuka.
Dialogue: 0,0:14:34.94,0:14:38.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini janjinya mau bermain\Nsetelah mengerjakan PR di rumahku.
Dialogue: 0,0:14:38.82,0:14:41.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kalau kamu kerepotan,\Nlain kali juga tidak apa-apa.
Dialogue: 0,0:14:44.86,0:14:45.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu ya.
Dialogue: 0,0:14:45.82,0:14:46.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:14:49.16,0:14:50.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inilah kamarku.
Dialogue: 0,0:15:01.76,0:15:02.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:15:03.01,0:15:06.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu foto saat kencan pertamaku\Ndengan Aijo Rentaro.
Dialogue: 0,0:15:12.39,0:15:13.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Temanku...
Dialogue: 0,0:15:14.23,0:15:16.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yoshimoto Shizuka sedang\Nberada di dalam kamarku.
Dialogue: 0,0:15:17.81,0:15:19.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah kenapa terasa aneh.
Dialogue: 0,0:15:29.49,0:15:30.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:15:30.58,0:15:35.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama, cari nilai X,\Nbaru kemudian gunakan rumusnya.
Dialogue: 0,0:15:59.48,0:16:03.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di adegan ini, perasaan apa yang\Nsebenarnya dirasakan tokoh utama?
Dialogue: 0,0:16:06.40,0:16:07.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:16:08.61,0:16:09.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:16:12.53,0:16:16.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pasti merasakan\Nkeimutan yang luar biasa.
Dialogue: 0,0:16:16.45,0:16:20.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kenapa tiba-tiba seperti itu\Npada musuh bebuyutannya?
Dialogue: 0,0:16:20.79,0:16:24.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Emosi manusia sepertinya\Nmemang sangat mendalam.
Dialogue: 0,0:16:33.60,0:16:34.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini membuatku gelisah.
Dialogue: 0,0:16:35.43,0:16:36.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah...
Dialogue: 0,0:16:37.23,0:16:38.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak tahan!
Dialogue: 0,0:16:42.19,0:16:44.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yoshimoto Shizuka...
Dialogue: 0,0:16:45.94,0:16:47.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo...
Dialogue: 0,0:16:49.40,0:16:51.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita mandi bersama.
Dialogue: 0,0:17:03.04,0:17:05.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ingin bicara, pakai saja ponselku.
Dialogue: 0,0:17:06.58,0:17:09.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuatur agar membacakan\Nkalimat yang diketik.
Dialogue: 0,0:17:16.31,0:17:19.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Ke, na, pa, me, nga, jak, man, di,?"
Dialogue: 0,0:17:20.94,0:17:24.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manusia akan merasa terbebas\Ndengan menanggalkan pakaian.
Dialogue: 0,0:17:24.60,0:17:26.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih mudah untuk mengungkapkan isi hati.
Dialogue: 0,0:17:26.94,0:17:30.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Konsep yang biasa disebut,\N"hubungan jujur yang sepenuhnya terbuka."
Dialogue: 0,0:17:33.74,0:17:35.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yoshimoto Shizuka.
Dialogue: 0,0:17:36.49,0:17:38.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu menyembunyikan sesuatu?
Dialogue: 0,0:17:41.21,0:17:44.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah kenapa aku merasa seperti itu.
Dialogue: 0,0:17:44.00,0:17:46.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski sulit diungkapkan dengan kata-kata.
Dialogue: 0,0:17:46.96,0:17:48.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, dirimu hari ini...
Dialogue: 0,0:17:48.80,0:17:51.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}rasanya satu milimeter berbeda...
Dialogue: 0,0:17:51.67,0:17:55.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak, satu nanometer berbeda\Ndari yang biasa kulihat.
Dialogue: 0,0:17:55.55,0:17:58.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa, Aijo Rentaro juga menyadarinya.
Dialogue: 0,0:17:58.93,0:18:03.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski kelihatannya dia menghargai\Nperasaanmu untuk menyembunyikannya.
Dialogue: 0,0:18:03.60,0:18:07.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, dirimu di kondisi itu bagiku
Dialogue: 0,0:18:07.36,0:18:09.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}terlihat sedikit menderita.
Dialogue: 0,0:18:10.11,0:18:14.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika dibolehkan, aku ingin membantumu.
Dialogue: 0,0:18:18.41,0:18:20.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Se, be, nar, nya."
Dialogue: 0,0:18:24.96,0:18:26.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shizuka.
Dialogue: 0,0:18:28.55,0:18:30.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan ponselmu.
Dialogue: 0,0:18:31.76,0:18:34.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dengar dari tetangga.
Dialogue: 0,0:18:34.76,0:18:39.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya sekarang kamu bukannya\Nbicara pakai buku, tapi pakai ponsel.
Dialogue: 0,0:18:40.39,0:18:42.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kupikir kalau sudah ada\Nkeinginan menelepon orang,
Dialogue: 0,0:18:42.89,0:18:46.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}nanti kamu bisa bicara dengan benar.
Dialogue: 0,0:18:46.56,0:18:49.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Toh kamu cuma terus membaca buku.
Dialogue: 0,0:18:49.02,0:18:52.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memberimu benda seperti itu adalah kesalahan.
Dialogue: 0,0:18:52.28,0:18:54.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan segera kuhentikan langganan nomormu,
Dialogue: 0,0:18:54.74,0:18:56.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi serahkan ponselmu.
Dialogue: 0,0:19:00.95,0:19:05.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pa-pa-padahal, a-a-gar aku bi-bisa bicara...
Dialogue: 0,0:19:05.71,0:19:10.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Re-Rentaro sudah me-memasukkan...
Dialogue: 0,0:19:10.67,0:19:15.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Banyak kata-kata dari buku...
Dialogue: 0,0:19:15.80,0:19:19.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku ti-tidak bisa mengatakan...
Dialogue: 0,0:19:19.68,0:19:21.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Me-Mengatakan soal ini...
Dialogue: 0,0:19:22.14,0:19:24.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti, sudah cukup.
Dialogue: 0,0:19:25.14,0:19:28.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, ayo kita ceritakan ini ke Aijo Rentaro.
Dialogue: 0,0:19:29.69,0:19:33.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu yang paling efisien untuk\Nmenghilangkan beban di dalam dadamu.
Dialogue: 0,0:19:33.61,0:19:35.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti cuma itu jalannya.
Dialogue: 0,0:19:35.95,0:19:39.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin, bagimu itu adalah\Nhal yang sangat menakutkan.
Dialogue: 0,0:19:40.45,0:19:42.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku akan ada di sampingmu.
Dialogue: 0,0:19:43.20,0:19:44.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa tetap tidak boleh?
Dialogue: 0,0:19:53.13,0:19:53.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya?
Dialogue: 0,0:19:54.42,0:19:57.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo, Aijo Rentaro.
Dialogue: 0,0:19:57.01,0:19:59.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa datang ke rumahku sekarang juga?
Dialogue: 0,0:20:00.60,0:20:03.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski sedang dioperasi,\Naku akan tetap ke sana.
Dialogue: 0,0:20:03.22,0:20:05.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan ke sini kalau kamu sedang dioperasi.
Dialogue: 0,0:20:23.45,0:20:24.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, begitu.
Dialogue: 0,0:20:25.12,0:20:28.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah mau\Nmenceritakannya, Shizuka.
Dialogue: 0,0:20:28.75,0:20:30.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh tidak...
Dialogue: 0,0:20:30.96,0:20:32.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau aku menemui ibumu?
Dialogue: 0,0:20:36.88,0:20:42.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berjanji, hasilnya nanti\Ntidak akan membuatmu sedih.
Dialogue: 0,0:20:50.31,0:20:51.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nano mau bagaimana?
Dialogue: 0,0:20:54.65,0:20:57.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti akan jadi mengintimidasi\Nkalau ada banyak orang.
Dialogue: 0,0:20:57.65,0:21:00.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga kurang peka dan\Ntidak pandai memilih kata-kata.
Dialogue: 0,0:21:00.66,0:21:03.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya tidak ikut\Nagar situasinya tidak memburuk.
Dialogue: 0,0:21:03.78,0:21:05.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti.
Dialogue: 0,0:21:10.21,0:21:11.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, kami pergi dulu.
Dialogue: 0,0:21:12.21,0:21:14.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku serahkan padamu, Aijo Rentaro.
Dialogue: 0,0:21:31.73,0:21:36.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Te-te-terima kasih...
Dialogue: 0,0:21:40.95,0:21:44.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berjuanglah, Yoshimoto Shizuka.
Dialogue: 0,0:21:54.38,0:21:55.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shizuka?
Dialogue: 0,0:21:56.54,0:21:58.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa yang kamu ajak itu?
Dialogue: 0,0:22:01.47,0:22:04.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada kejutan!
Dialogue: 0,0:22:04.68,0:22:09.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, gawat, kukira bakal jadi\Njodoh mama yang kedua.
Dialogue: 0,0:22:09.22,0:22:14.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebentar, bukannya lebih mudah\Nkalau jadi jodohnya saja sekalian?!
Dialogue: 0,0:22:14.48,0:22:16.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana ini, Rentaro?!
Dialogue: 0,0:22:16.77,0:22:19.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah kamu bisa menyelamatkan Shizuka?!
