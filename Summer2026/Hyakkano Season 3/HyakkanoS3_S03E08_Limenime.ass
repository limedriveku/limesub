Dialogue: 0,0:00:35.53,0:00:39.02,sign,,0000,0000,0000,,"TERNYATA! KELUARGA KUSURIVANIAN!"
Dialogue: 0,0:07:48.62,0:07:49.80,sign,,0000,0000,0000,,"BENDA TIDAK DIKENAL"
Dialogue: 0,0:07:49.80,0:07:51.24,sign,,0000,0000,0000,,"PAPAN, BENDA TIDAK DIKENAL"
Dialogue: 0,0:09:27.58,0:09:30.64,sign,,0000,0000,0000,,"TOSERBA MART"
Dialogue: 0,0:09:57.62,0:10:00.62,sign,,0000,0000,0000,,"TAMAN LIAR"
Dialogue: 0,0:13:34.18,0:13:36.10,sign,,0000,0000,0000,,"BELUM TAHU KALAU UMURNYA LEBIH TUA"
Dialogue: 0,0:14:26.81,0:14:29.01,sign,,0000,0000,0000,,"KUNYAH, KUNYAH"
Dialogue: 0,0:14:47.16,0:14:48.76,sign,,0000,0000,0000,,KIPAS, KIPAS - PIJAT, PIJAT
Dialogue: 0,0:16:49.65,0:16:50.21,sign,,0000,0000,0000,,"AKHIRAT"
Dialogue: 0,0:17:08.80,0:17:09.79,sign,,0000,0000,0000,,AMERIKA SERIKAT
Dialogue: 0,0:17:09.80,0:17:10.84,sign,,0000,0000,0000,,"KRUYUK"
Dialogue: 0,0:19:42.46,0:19:43.48,sign,,0000,0000,0000,,MASOKHIS\NPANGGUNG KEGILAAN
Dialogue: 0,0:00:10.36,0:00:12.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi itu apa?
Dialogue: 0,0:00:12.43,0:00:14.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin aku cuma pusing, ya?
Dialogue: 0,0:00:14.10,0:00:15.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, aduh.
Dialogue: 0,0:00:15.24,0:00:19.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sudah 89 tahun, badan rasanya sakit\Ndi sana-sini, bikin tidak enak, nanoja.
Dialogue: 0,0:00:19.64,0:00:21.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}89 tahun?!
Dialogue: 0,0:00:22.01,0:00:25.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senang bertemu denganmu, pacarnya Kusuri.
Dialogue: 0,0:00:25.25,0:00:29.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, beliau ini?!\NTernyata salah satu jodohku adalah...
Dialogue: 0,0:00:29.70,0:00:32.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Neneknya Kak Kusuri?!
Dialogue: 0,0:00:33.16,0:00:35.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namaku Yakuzen Yaku, nanoja.
Dialogue: 0,0:00:35.53,0:00:39.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata memang keluarga Kusurivanian!
Dialogue: 0,0:00:52.91,0:00:58.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}100 Pacar yang Sungguh Sangat Amat\NBenar-benar Mencintaimu Musim Ketiga
Dialogue: 0,0:02:10.62,0:02:14.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nama nenek memang sangat pas\Ndan keren banget, nanoda!
Dialogue: 0,0:02:14.94,0:02:16.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah sudah Nenek bilang?
Dialogue: 0,0:02:16.94,0:02:21.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nama Nenek diambil dari Yakusugi,\Npohon kesukaan nenek buyutmu.
Dialogue: 0,0:02:21.95,0:02:25.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Oalah, ternyata dari pohon cedar, ya?\N- Seperti melihat anak kembar...
Dialogue: 0,0:02:25.34,0:02:28.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, Nenek juga terkena\Nefek obat keabadian?
Dialogue: 0,0:02:28.54,0:02:31.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, tubuhku berumur 8 tahun, nanoja.
Dialogue: 0,0:02:31.65,0:02:35.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu obat gagal yang sangat kuat\Ndan hampir mendekati sempurna,
Dialogue: 0,0:02:35.82,0:02:38.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}obat penetral\Ntidak bisa memulihkannya, nanoja.
Dialogue: 0,0:02:38.69,0:02:41.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sendiri tidak mempermasalahkannya.
Dialogue: 0,0:02:41.02,0:02:44.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula,\Nalasan Kusuri membuat obat keabadian
Dialogue: 0,0:02:44.33,0:02:47.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena tidak mau kalau nenek\Nyang kusayangi ini meninggal, nanoda.
Dialogue: 0,0:02:47.58,0:02:49.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cucu teladan!
Dialogue: 0,0:02:49.33,0:02:51.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nenek!
Dialogue: 0,0:02:51.96,0:02:54.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetap saja Nenek terkesan padamu, Kusuri.
Dialogue: 0,0:02:55.14,0:02:56.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan apa?
Dialogue: 0,0:02:56.30,0:02:59.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat sekali kamu bisa dapat\Nlaki-laki sehebat dia, nanoja.
Dialogue: 0,0:02:59.95,0:03:01.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja, nanoda!
Dialogue: 0,0:03:01.36,0:03:04.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rentaro adalah pria terbaik di dunia!
Dialogue: 0,0:03:05.47,0:03:10.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah lama sekali tidak merasa seperti ini,\Njadi teringat masa muda dulu, nanoja.
Dialogue: 0,0:03:10.49,0:03:14.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rentaro dan Kakek yang sudah mati,\Nsiapa yang lebih baik?
Dialogue: 0,0:03:14.05,0:03:15.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entahlah, bagaimana, ya.
Dialogue: 0,0:03:15.66,0:03:18.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah puluhan tahun berlalu juga.
Dialogue: 0,0:03:18.62,0:03:22.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia memang pria hebat\Nbagai jelmaan pria jantan,
Dialogue: 0,0:03:22.73,0:03:25.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi mungkin tidak akan tahu\Nkalau belum jadi pacarnya.
Dialogue: 0,0:03:25.74,0:03:29.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, Nenek gabung saja\Nke keluarga Rentaro, nanoda!
Dialogue: 0,0:03:29.66,0:03:31.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Toh Kakek juga sudah mati.
Dialogue: 0,0:03:31.73,0:03:33.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keluarga Rentaro?
Dialogue: 0,0:03:33.88,0:03:39.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelompok Nak Aijo dan para kekasihnya\Nyang pernah kamu ceritakan itu?
Dialogue: 0,0:03:39.37,0:03:40.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, nanoda!
Dialogue: 0,0:03:41.63,0:03:45.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, mungkin sekalian saja\Naku ikut bergabung.
Dialogue: 0,0:03:45.12,0:03:45.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?!
Dialogue: 0,0:03:45.88,0:03:46.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yay!
Dialogue: 0,0:03:46.86,0:03:48.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semudah itu?!
Dialogue: 0,0:03:48.89,0:03:52.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau sekarang kita\Njalan-jalan sambil cerita sebentar.
Dialogue: 0,0:03:52.01,0:03:54.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, Ba-Baik...
Dialogue: 0,0:03:54.44,0:03:56.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau ikut! Kusuri juga mau ikut!
Dialogue: 0,0:03:56.13,0:03:59.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kusuri, sudah mau mulai, lho.
Dialogue: 0,0:03:59.57,0:04:01.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pentaro sudah mau mulai!
Dialogue: 0,0:04:01.20,0:04:02.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak jadi ikut, nanoda!
Dialogue: 0,0:04:03.26,0:04:06.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♫ Dia datang dari negeri es, pe-pen-pen
Dialogue: 0,0:04:07.06,0:04:10.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♫ Mencari ikan, pe-pen-pen
Dialogue: 0,0:04:10.66,0:04:14.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♫ Ayo, waktunya berangkat!
Dialogue: 0,0:04:14.40,0:04:17.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♫ Pe-Pe-Pe-Pentaro
Dialogue: 0,0:04:21.27,0:04:23.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anda memang suka membuat obat, ya?
Dialogue: 0,0:04:23.96,0:04:25.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:04:25.17,0:04:28.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski bakat dan pengetahuanku\Ntidak sehebat Kusuri.
Dialogue: 0,0:04:29.10,0:04:30.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dulu...
Dialogue: 0,0:04:38.47,0:04:41.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membuat obat di medan perang, nanoja.
Dialogue: 0,0:04:41.55,0:04:43.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di medan perang?!
Dialogue: 0,0:04:45.06,0:04:47.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sanalah aku bertemu kakeknya Kusuri.
Dialogue: 0,0:04:48.37,0:04:53.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat itu pasukannya baru saja tiba dan\Nmenyelamatkan kami dari bahaya, nanoja.
Dialogue: 0,0:04:53.18,0:04:55.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar-benar jelmaan pria jantan sejati!
Dialogue: 0,0:04:56.56,0:04:58.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ta-Tapi, kalau di medan perang...
Dialogue: 0,0:04:58.94,0:05:02.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, detailnya rahasia, nanoja.
Dialogue: 0,0:05:02.24,0:05:02.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:05:03.43,0:05:07.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah wanita akan makin menawan\Njika punya banyak rahasia?
Dialogue: 0,0:05:09.46,0:05:10.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah!
Dialogue: 0,0:05:10.92,0:05:13.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada hia yang tumbuh di sana.
Dialogue: 0,0:05:13.30,0:05:16.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita ambil beberapa.
Dialogue: 0,0:05:18.25,0:05:21.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak muda zaman sekarang\Njarang melakukan ini, ya?
Dialogue: 0,0:05:21.18,0:05:22.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:05:22.36,0:05:24.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ingin membuat kusa mochi?
Dialogue: 0,0:05:24.34,0:05:25.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa saja.
Dialogue: 0,0:05:25.77,0:05:29.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dijadikan tempura, ohitashi,\Natau jadi isian sup juga bagus.
Dialogue: 0,0:05:30.61,0:05:34.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata hia bisa dijadikan\Nbanyak makanan, ya.
Dialogue: 0,0:05:35.84,0:05:38.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong lihat, ada yang sebesar ini!
Dialogue: 0,0:05:38.57,0:05:39.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu benar!
Dialogue: 0,0:05:39.97,0:05:40.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Besarnya!
Dialogue: 0,0:05:41.49,0:05:45.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya saja, hia akan jadi keras\Nkalau tumbuh terlalu lebat.
Dialogue: 0,0:05:45.05,0:05:49.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunas baru yang ukurannya sekitar\N15 sampai 18 senti itu lembut dan lezat, lho.
Dialogue: 0,0:05:49.22,0:05:51.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya?
Dialogue: 0,0:05:51.15,0:05:53.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anda benar-benar tahu banyak.
Dialogue: 0,0:05:54.42,0:05:57.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah hidup lama bukan tanpa alasan, lho.
Dialogue: 0,0:05:57.10,0:06:00.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apalagi zaman dulu tidak bisa\Npilih-pilih makanan, nanoja.
Dialogue: 0,0:06:00.41,0:06:01.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:06:01.93,0:06:03.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat bahagia.
Dialogue: 0,0:06:03.72,0:06:08.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena Kusuri yang manis dan kalian semua\Nbisa lahir di zaman ini.
Dialogue: 0,0:06:08.46,0:06:12.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, itu semua karena generasi Nenek\Nyang sudah berjuang
Dialogue: 0,0:06:12.26,0:06:14.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}membangun masyarakat dan budaya...
Dialogue: 0,0:06:16.77,0:06:18.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rumputnya melukai tanganmu, ya?
Dialogue: 0,0:06:19.57,0:06:21.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perlihatkan padaku.
Dialogue: 0,0:06:23.48,0:06:27.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau daun hia diremas halus begini,\Nbisa jadi obat luka, nanoja.
Dialogue: 0,0:06:34.08,0:06:35.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, tadi itu...
Dialogue: 0,0:06:35.87,0:06:37.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:06:38.42,0:06:40.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak ada apa-apa.
Dialogue: 0,0:06:40.73,0:06:44.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena aku sering melihat Kak Kusuri\Nyang wujudnya selalu berubah,
Dialogue: 0,0:06:44.02,0:06:45.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa jadi terasa tumpang tindih, ya?
Dialogue: 0,0:06:46.00,0:06:48.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, aku punya satu obat lagi.
Dialogue: 0,0:06:48.36,0:06:50.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semacam mantra agar merasa lebih baik.
Dialogue: 0,0:06:59.37,0:07:00.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana?
Dialogue: 0,0:07:00.38,0:07:01.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terasa lebih baik, 'kan?
Dialogue: 0,0:07:03.74,0:07:05.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!\NLukanya sudah sembuh!
Dialogue: 0,0:07:06.17,0:07:08.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetap saja itu rasanya terlalu cepat.
Dialogue: 0,0:07:10.72,0:07:13.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih untuk hari ini, Nak Aijo.
Dialogue: 0,0:07:13.94,0:07:16.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah lama aku tidak sesenang ini.
Dialogue: 0,0:07:16.24,0:07:19.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teruslah menjalin hubungan baik\Ndengan Kusuri, ya.
Dialogue: 0,0:07:19.52,0:07:20.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:07:20.35,0:07:22.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maaf.
Dialogue: 0,0:07:22.22,0:07:25.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saya akan menjaga hubungan\Ndengan Kak Kusuri.
Dialogue: 0,0:07:25.00,0:07:29.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi apa boleh kalau kita bertukar\Nkontak ponsel pintar?
Dialogue: 0,0:07:29.88,0:07:31.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ponsel?
Dialogue: 0,0:07:31.13,0:07:32.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?\NItu lho...
Dialogue: 0,0:07:32.86,0:07:35.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aplikasi di ponsel pintar misalnya.
Dialogue: 0,0:07:35.10,0:07:37.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ponsel pintar? Aplikasi?
Dialogue: 0,0:07:37.37,0:07:39.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?! Jangan-jangan Anda tidak tahu?
Dialogue: 0,0:07:40.50,0:07:42.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksud saya benda ini.
Dialogue: 0,0:07:44.13,0:07:48.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, yang sering diajak bicara sendiri\Ndan dimainkan Kusuri...
Dialogue: 0,0:07:48.62,0:07:49.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Papan itu, ya?
Dialogue: 0,0:07:49.80,0:07:51.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Papan?!
Dialogue: 0,0:07:51.24,0:07:53.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, ya, aku memang kuno.
Dialogue: 0,0:07:53.84,0:07:57.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sama sekali tidak paham\Nsoal mesin atau istilah asing.
Dialogue: 0,0:07:57.06,0:07:58.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.
Dialogue: 0,0:07:58.22,0:08:01.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pakai telepon kabel juga tidak masalah.
Dialogue: 0,0:08:01.50,0:08:03.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Telepon, ya...
Dialogue: 0,0:08:03.05,0:08:05.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau telepon benang,\Naku tahu cara pakainya, nanoja.
Dialogue: 0,0:08:05.74,0:08:08.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kabel yang benar-benar kabel!
Dialogue: 0,0:08:08.02,0:08:12.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Bagaimana dengan bertukar surat,\Natau nanti biar saya ke rumah lagi.
Dialogue: 0,0:08:12.15,0:08:14.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, jangan-jangan...
Dialogue: 0,0:08:14.49,0:08:19.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu menganggap serius aku ingin\Nbergabung ke Keluarga Rentaro?
Dialogue: 0,0:08:22.02,0:08:26.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, ya, tidak kukira\Nakan kamu anggap serius.
Dialogue: 0,0:08:26.59,0:08:31.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengatakannya karena kukira\Nakan membuat Kusuri senang, maafkan, ya.
Dialogue: 0,0:08:32.66,0:08:35.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Bagaimana kalau sekarang\Nkita benar-benar serius...
Dialogue: 0,0:08:35.91,0:08:39.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Umurku sudah 89 tahun, nanoja.
Dialogue: 0,0:08:39.12,0:08:40.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau untuk menjalin cinta,
Dialogue: 0,0:08:40.78,0:08:46.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apalagi dengan anak muda seusiamu,\Nrasanya aku sudah terlalu tua.
Dialogue: 0,0:08:46.89,0:08:49.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu lebih pantas bahagia bersama
Dialogue: 0,0:08:49.98,0:08:53.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan anak dari generasimu\Nseperti Kusuri dan lainnya.
Dialogue: 0,0:08:54.21,0:08:55.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya?
Dialogue: 0,0:08:55.91,0:09:01.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dipikir-pikir lagi seharian ini beliau hanya\Nmemperlakukanku seperti anak-anak.
Dialogue: 0,0:09:02.10,0:09:04.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski di mataku terlihat seperti gadis kecil,
Dialogue: 0,0:09:04.45,0:09:10.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi jiwa dan mentalnya tetaplah\Nseseorang yang sudah hidup 89 tahun.
Dialogue: 0,0:09:10.02,0:09:12.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baginya, seorang anak SMA sepertiku
Dialogue: 0,0:09:13.37,0:09:15.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hanyalah anak kecil.
Dialogue: 0,0:09:15.73,0:09:17.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus bagaimana?
Dialogue: 0,0:09:17.52,0:09:21.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang harus kulakukan agar\Ndianggap sebagai seorang pria?
Dialogue: 0,0:09:24.12,0:09:26.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa ikut saya sebentar?
Dialogue: 0,0:09:27.58,0:09:30.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nenek menyebut mendiang Kakek
Dialogue: 0,0:09:30.64,0:09:33.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah pria hebat yang seperti\Njelmaan pria jantan sejati!
Dialogue: 0,0:09:34.14,0:09:37.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti selera laki-laki kesukaan Nenek
Dialogue: 0,0:09:37.36,0:09:38.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah...
Dialogue: 0,0:09:43.24,0:09:45.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pria liar!
Dialogue: 0,0:09:48.20,0:09:50.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kenapa, Nak?
Dialogue: 0,0:09:50.11,0:09:51.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nenek!
Dialogue: 0,0:09:51.28,0:09:52.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, bukan...
Dialogue: 0,0:09:52.30,0:09:53.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu Yaku!
Dialogue: 0,0:09:53.40,0:09:56.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari main... ayo main dengan liar\Ndi taman malam-malam!
Dialogue: 0,0:09:56.41,0:09:57.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kenapa, Nak?
Dialogue: 0,0:09:57.62,0:10:00.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ciri-ciri pria liar adalah!
Dialogue: 0,0:10:00.62,0:10:02.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemampuan memimpin!
Dialogue: 0,0:10:02.13,0:10:04.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita main jungkat-jungkit!
Dialogue: 0,0:10:04.62,0:10:09.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ingin ditemani bermain karena\Ntidak bisa dimainkan sendiri, ya.
Dialogue: 0,0:10:09.26,0:10:11.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serahkan semuanya pada tenaga kakiku ini!
Dialogue: 0,0:10:11.77,0:10:12.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dapat diandalkan!
Dialogue: 0,0:10:12.88,0:10:14.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelihatannya senang sekali.
Dialogue: 0,0:10:14.27,0:10:15.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa mengambil keputusan!
Dialogue: 0,0:10:16.33,0:10:18.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuputuskan buat main di ayunan paling kanan!
Dialogue: 0,0:10:18.88,0:10:21.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh, naiki saja mana yang kamu mau.
Dialogue: 0,0:10:21.97,0:10:23.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keleluasaan!
Dialogue: 0,0:10:23.02,0:10:26.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Bu... Yaku mau naik yang ini,\Nakan kuberikan padamu!
Dialogue: 0,0:10:26.54,0:10:29.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, aku tidak masalah\Nnaik ayunan yang mana saja.
Dialogue: 0,0:10:29.66,0:10:31.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hidup mencari ketegangan!
Dialogue: 0,0:10:31.90,0:10:34.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aturannya yang jatuh nanti dimakan hiu!
Dialogue: 0,0:10:34.67,0:10:37.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku tidak takut, jadi bakal lompat!
Dialogue: 0,0:10:37.98,0:10:39.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keberanian!
Dialogue: 0,0:10:40.56,0:10:42.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sebenarnya mau apa?
Dialogue: 0,0:10:43.42,0:10:46.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pria liar itu, apa benar seperti ini?
Dialogue: 0,0:10:46.93,0:10:49.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, ini...
Dialogue: 0,0:10:49.61,0:10:54.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma cucu yang sedang riang gembira\Nsaat dibawa neneknya ke taman!
Dialogue: 0,0:10:54.82,0:10:56.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini salah!
Dialogue: 0,0:10:56.06,0:10:59.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pura-pura liar seperti ini tidak akan cukup!
Dialogue: 0,0:10:59.42,0:11:01.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agar bisa menggugah perasaan cinta Nenek...
Dialogue: 0,0:11:05.16,0:11:08.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yaku, jadilah wanitaku!
Dialogue: 0,0:11:20.20,0:11:23.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Mana bisa aku melakukannya...
Dialogue: 0,0:11:23.44,0:11:27.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mencium paksa bibir wanita\Nyang bahkan tidak menginginkannya...
Dialogue: 0,0:11:27.14,0:11:28.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hal seperti itu...
Dialogue: 0,0:11:28.80,0:11:29.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bisa!
Dialogue: 0,0:11:29.97,0:11:33.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak berbakat jadi pria liar...
Dialogue: 0,0:11:47.51,0:11:52.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mengira kalau bersikap seperti "dia",\Nmaka aku mau serius denganmu, ya?
Dialogue: 0,0:11:53.48,0:11:55.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sama sekali tidak mengerti.
Dialogue: 0,0:11:55.41,0:11:58.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah merasakan cinta\Ndengan pria jantan sejati.
Dialogue: 0,0:11:58.92,0:12:00.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mau jatuh cinta lagi,
Dialogue: 0,0:12:00.87,0:12:04.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bukankah jelas akan lebih seru kalau\Nmenikmati cinta dengan cara berbeda?
Dialogue: 0,0:12:05.81,0:12:07.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ta-Tapi...
Dialogue: 0,0:12:07.37,0:12:10.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, kenapa tiba-tiba seperti ini?
Dialogue: 0,0:12:10.04,0:12:11.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entahlah.
Dialogue: 0,0:12:11.42,0:12:14.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entah karena dirimu begitu imut\Nsaat berusaha dengan keras,
Dialogue: 0,0:12:14.91,0:12:18.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau sikapmu tadi begitu jantan\Nhingga membuatku terpesona.
Dialogue: 0,0:12:18.92,0:12:24.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melihatmu mencoba menebak isi pikiranku\Nyang sudah hidup lebih lama dari dirimu,
Dialogue: 0,0:12:24.29,0:12:28.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}membuatku ingin berbuat iseng padamu.
Dialogue: 0,0:12:31.18,0:12:34.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, anggap saja lelucon dari\Nnenek-nenek yang lupa umur.
Dialogue: 0,0:12:34.46,0:12:37.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan senang kalau kamu\Nmenanggapinya dengan serius.
Dialogue: 0,0:12:37.58,0:12:40.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Mana bisa disebut lelucon!
Dialogue: 0,0:12:40.13,0:12:41.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya benar-benar serius...
Dialogue: 0,0:12:41.49,0:12:42.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,
Dialogue: 0,0:12:43.09,0:12:46.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berusahalah agar suatu hari nanti\Naku juga akan serius denganmu.
Dialogue: 0,0:12:47.10,0:12:49.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menantikan itu.
Dialogue: 0,0:12:51.33,0:12:53.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sa-Saya akan berusaha!
Dialogue: 0,0:12:57.06,0:12:59.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oleh karena itu...
Dialogue: 0,0:12:59.34,0:13:05.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maukah kalian menerima\NNenek Yakuzen Yaku menjadi pacar baruku?
Dialogue: 0,0:13:05.34,0:13:08.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski wujudku seperti ini,\Ntapi umurku sudah 89 tahun, nanoja.
Dialogue: 0,0:13:08.56,0:13:09.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau kepala sembilan!
Dialogue: 0,0:13:09.48,0:13:11.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Karane!
Dialogue: 0,0:13:11.18,0:13:13.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Umur 89 tahun juga makhluk hidup!
Dialogue: 0,0:13:13.55,0:13:15.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bukan menyamakannya dengan mayat!
Dialogue: 0,0:13:15.36,0:13:18.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia nenekku yang sangat kusayangi, nanoda.
Dialogue: 0,0:13:18.17,0:13:19.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanoja.
Dialogue: 0,0:13:19.00,0:13:20.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Neneknya pacar?!
Dialogue: 0,0:13:20.94,0:13:23.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini tidak masalah?\NSecara etika.
Dialogue: 0,0:13:23.57,0:13:24.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tidak berhak bilang begitu!
Dialogue: 0,0:13:24.96,0:13:27.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kenapa bisa di sekolah\Npadahal bukan siswa?
Dialogue: 0,0:13:27.52,0:13:30.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja sudah kuberi izin.
Dialogue: 0,0:13:30.10,0:13:34.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis imut sepertimu akan selalu\Nkuterima kapan saja!
Dialogue: 0,0:13:34.18,0:13:36.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Muah, muah!
Dialogue: 0,0:13:38.21,0:13:41.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya benar-benar minta maaf\Natas kejadian tadi!
Dialogue: 0,0:13:41.39,0:13:43.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penampilanku seperti ini, sih.
Dialogue: 0,0:13:43.75,0:13:46.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat luang\Nkarena hidup dari dana pensiun,
Dialogue: 0,0:13:46.06,0:13:48.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi bisa main ke sini kapan saja.
Dialogue: 0,0:13:48.37,0:13:52.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, dengan tubuh berumur 8 tahun,\Nrasanya bisa hidup sampai 80 tahun lagi.
Dialogue: 0,0:13:52.89,0:13:55.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maling dana pensiun, dong!
Dialogue: 0,0:13:55.10,0:13:56.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan Kusuri kenalkan!
Dialogue: 0,0:13:56.61,0:14:01.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua anggota Keluarga Rentaro adalah\Nteman yang sangat akrab dengan Kusuri!
Dialogue: 0,0:14:01.87,0:14:03.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, benarkah?
Dialogue: 0,0:14:03.36,0:14:05.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke-Kenapa malah tanya ke aku?!
Dialogue: 0,0:14:05.38,0:14:06.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi itu tidak begitu?
Dialogue: 0,0:14:06.92,0:14:09.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi tidak begitu, nanoda?
Dialogue: 0,0:14:10.63,0:14:12.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Mana aku tahu!
Dialogue: 0,0:14:12.60,0:14:14.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mu-Mungkin kita memang akrab?!
Dialogue: 0,0:14:14.37,0:14:16.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karane!
Dialogue: 0,0:14:16.79,0:14:18.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, berisik!
Dialogue: 0,0:14:18.62,0:14:22.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah jadi teman Kusuri.
Dialogue: 0,0:14:22.48,0:14:24.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini, akan kuberi kalian permen.
Dialogue: 0,0:14:24.65,0:14:26.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eyang...
Dialogue: 0,0:14:26.81,0:14:29.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak!
Dialogue: 0,0:14:29.02,0:14:30.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini enak.
Dialogue: 0,0:14:30.41,0:14:32.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo sini, kamu ambil juga.
Dialogue: 0,0:14:32.72,0:14:36.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak usah, saya sudah dewasa...
Dialogue: 0,0:14:37.29,0:14:39.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I am sudah ambil.
Dialogue: 0,0:14:39.66,0:14:44.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah, bagiku kamu tetap anak gadis\Nsama seperti yang lain.
Dialogue: 0,0:14:44.92,0:14:47.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eyang!
Dialogue: 0,0:14:48.77,0:14:50.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:14:51.28,0:14:53.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, ya.
Dialogue: 0,0:14:53.56,0:14:56.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rentaro sudah mengenalkan kalian lewat papan,
Dialogue: 0,0:14:56.28,0:14:58.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku masih belum bisa\Nmengingat kalian semua.
Dialogue: 0,0:14:58.92,0:15:02.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jumlah kami memang sudah sulit\Nuntuk diingat semua.
Dialogue: 0,0:15:02.52,0:15:04.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan papan, tapi ponsel pintar, nanoda.
Dialogue: 0,0:15:04.68,0:15:08.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, biar Kusuri perkenalkan\Nciri khas mereka semua, nanoda!
Dialogue: 0,0:15:09.38,0:15:11.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pemalu, nanoda.
Dialogue: 0,0:15:11.32,0:15:12.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malu-malu kucing, nanoda.
Dialogue: 0,0:15:12.97,0:15:15.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ingin jadi orang tercantik di dunia, nanoda.
Dialogue: 0,0:15:15.66,0:15:17.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sangat pintar, nanoda.
Dialogue: 0,0:15:17.53,0:15:19.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maid yang sangat hebat, nanoda.
Dialogue: 0,0:15:19.42,0:15:21.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menangis kalau lepas kacamata, nanoda.
Dialogue: 0,0:15:21.55,0:15:23.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suka meremas tetek, nanoda.
Dialogue: 0,0:15:23.52,0:15:26.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak makan dia bakal kesal, nanoda.
Dialogue: 0,0:15:26.38,0:15:27.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masokhis, nanoda.
Dialogue: 0,0:15:27.78,0:15:29.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cabul natural, nanoda.
Dialogue: 0,0:15:29.45,0:15:31.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Besar dan kuat, nanoda.
Dialogue: 0,0:15:31.38,0:15:33.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kecil dan lemah, nanoda.
Dialogue: 0,0:15:33.37,0:15:35.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penggila Amerika, nanoda.
Dialogue: 0,0:15:35.24,0:15:37.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang mesum bertetek gede, nanoda.
Dialogue: 0,0:15:39.17,0:15:41.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa yang orang mesum bertetek gede?!
Dialogue: 0,0:15:41.73,0:15:42.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau.
Dialogue: 0,0:15:42.36,0:15:44.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa yang cabul natural?!
Dialogue: 0,0:15:44.12,0:15:44.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau.
Dialogue: 0,0:15:44.85,0:15:48.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I am penggila Amerika!
Dialogue: 0,0:15:48.01,0:15:51.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Aku memang kecil dan lemah, tapi..."
Dialogue: 0,0:15:51.12,0:15:53.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja,\Nsama seperti bayi dan hewan kecil.
Dialogue: 0,0:15:53.97,0:15:55.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kuremas!
Dialogue: 0,0:15:56.35,0:16:01.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya hanya pembantu biasa yang\Nmendedikasikan hidup untuk Nyonya Hahari.
Dialogue: 0,0:16:01.18,0:16:04.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pembantu biasa tidak akan\Nmendedikasikan hidup mereka.
Dialogue: 0,0:16:04.36,0:16:07.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Kusuri, aku juga\Nbukan seorang masokhis, lho.
Dialogue: 0,0:16:07.60,0:16:09.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi kamu tidak menyadarinya?
Dialogue: 0,0:16:09.78,0:16:11.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nenek sudah ingat semua?
Dialogue: 0,0:16:11.22,0:16:13.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin sudah, nanoja...
Dialogue: 0,0:16:13.74,0:16:17.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, Iku itu gadis yang bagaimana?
Dialogue: 0,0:16:17.78,0:16:19.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm...
Dialogue: 0,0:16:19.39,0:16:22.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak salah, kecil dan lemah?
Dialogue: 0,0:16:22.92,0:16:25.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru fisik dan mentalnya seperti monster!
Dialogue: 0,0:16:25.64,0:16:28.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan pukul saya,\Nsama sekali tidak masalah, kok.
Dialogue: 0,0:16:29.35,0:16:31.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, Hahari itu bagaimana?
Dialogue: 0,0:16:31.17,0:16:32.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak salah...
Dialogue: 0,0:16:33.08,0:16:34.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maid yang hebat?
Dialogue: 0,0:16:34.48,0:16:35.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah!
Dialogue: 0,0:16:35.05,0:16:37.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayangnya, justru dia majikannya!
Dialogue: 0,0:16:37.75,0:16:39.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Sayangnya?"
Dialogue: 0,0:16:40.00,0:16:42.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, maid itu apa?
Dialogue: 0,0:16:42.92,0:16:43.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai dari situ?!
Dialogue: 0,0:16:44.27,0:16:46.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, jangan-jangan yang itu, ya?
Dialogue: 0,0:16:46.83,0:16:49.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempat yang jadi tujuan saat kamu meninggal.
Dialogue: 0,0:16:49.65,0:16:50.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhi...
Dialogue: 0,0:16:50.21,0:16:52.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan akhirat, tapi pembantu.
Dialogue: 0,0:16:52.17,0:16:55.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana dengan putrinya, Hakari?
Dialogue: 0,0:16:55.16,0:16:56.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak salah...
Dialogue: 0,0:16:57.04,0:16:58.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penggila Amerika?
Dialogue: 0,0:16:59.74,0:17:02.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I am adalah freedom!
Dialogue: 0,0:17:02.56,0:17:04.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan menyalahartikan kebebasan, ya.
Dialogue: 0,0:17:04.29,0:17:06.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Lebih seksi kalau pakai ukuran lebih kecil?\N- Omong-omong, amerika itu apa ya?
Dialogue: 0,0:17:06.83,0:17:08.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Aku tidak bahas celana dalam.\N- Bahkan tidak tahu itu?!
Dialogue: 0,0:17:09.80,0:17:10.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Amerika Serikat.
Dialogue: 0,0:17:10.84,0:17:12.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oalah, maksudnya Amerika Serikat.
Dialogue: 0,0:17:12.96,0:17:15.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak paham kalau tulisannya\Nistilah asing, ya.
Dialogue: 0,0:17:15.80,0:17:18.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Momiji?
Dialogue: 0,0:17:18.06,0:17:19.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak salah...
Dialogue: 0,0:17:21.43,0:17:23.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemalu?
Dialogue: 0,0:17:23.92,0:17:25.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru dia harus tahu malu sedikit!
Dialogue: 0,0:17:25.95,0:17:32.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurumi, izinkan aku meremas dadamu\Nyang lembut dalam masa pertumbuhan itu.
Dialogue: 0,0:17:32.46,0:17:33.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berisik.
Dialogue: 0,0:17:33.79,0:17:35.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Sini biar Mama peluk.\N- Kalau Mimimi?
Dialogue: 0,0:17:35.65,0:17:37.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak salah...
Dialogue: 0,0:17:37.30,0:17:40.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang yang kesal kalau tidak makan?
Dialogue: 0,0:17:40.02,0:17:42.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu paket kombinasi musuh kecantikan!
Dialogue: 0,0:17:42.26,0:17:45.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bicara seolah aku punya\Nselera kecantikan yang rendah...
Dialogue: 0,0:17:46.54,0:17:48.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kamu katakan?!
Dialogue: 0,0:17:48.44,0:17:51.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nafsu dan pola makanmu seperti itu,\Ntapi bisa secantik ini!
Dialogue: 0,0:17:51.25,0:17:52.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kamu menjaganya?!
Dialogue: 0,0:17:52.46,0:17:54.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaliknya, justru ajarilah aku!
Dialogue: 0,0:17:54.21,0:17:56.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malah balik tanya ke aku?!
Dialogue: 0,0:17:56.63,0:17:57.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kalau Naddy?\N- Lewat, metabolisme?
Dialogue: 0,0:17:57.97,0:17:59.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Curang sekali!\N- Kalau tidak salah...
Dialogue: 0,0:17:59.95,0:18:01.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Pesona fajar musim semi.\N- Sangat pintar?
Dialogue: 0,0:18:01.82,0:18:04.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah makhluk yang beda kalau itu.
Dialogue: 0,0:18:04.01,0:18:05.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku head sangat OK!
Dialogue: 0,0:18:05.95,0:18:09.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, Naddy adalah nickname.
Dialogue: 0,0:18:09.74,0:18:11.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa kuingat meski itu istilah asing.
Dialogue: 0,0:18:11.96,0:18:13.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nak Nade, 'kan?
Dialogue: 0,0:18:13.71,0:18:16.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, yang benar Naddy.
Dialogue: 0,0:18:16.09,0:18:17.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nade?
Dialogue: 0,0:18:17.15,0:18:18.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Naddy!
Dialogue: 0,0:18:18.59,0:18:19.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nade?
Dialogue: 0,0:18:19.40,0:18:20.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Naddy!
Dialogue: 0,0:18:20.37,0:18:21.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nade?
Dialogue: 0,0:18:21.07,0:18:22.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Naddy!
Dialogue: 0,0:18:22.13,0:18:22.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nade?
Dialogue: 0,0:18:22.72,0:18:23.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Naddy!
Dialogue: 0,0:18:23.73,0:18:24.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nade?
Dialogue: 0,0:18:24.84,0:18:28.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}OK! Itu juga bentuk freedom!
Dialogue: 0,0:18:28.35,0:18:30.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Kurumi?
Dialogue: 0,0:18:30.05,0:18:31.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak salah...
Dialogue: 0,0:18:31.34,0:18:33.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menangis kalau lepas kacamata?
Dialogue: 0,0:18:34.17,0:18:37.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Lebih tepat kalau perutnya akan bunyi\Nkalau makanannya diambil."
Dialogue: 0,0:18:37.33,0:18:38.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Tapi, saat itu terjadi..."
Dialogue: 0,0:18:38.86,0:18:42.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Tenang saja, lihat ini! Aku bawa biskuit!"
Dialogue: 0,0:18:43.87,0:18:46.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Nona, menangislah saja di dadaku."
Dialogue: 0,0:18:50.12,0:18:51.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Mei?
Dialogue: 0,0:18:51.81,0:18:52.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak salah...
Dialogue: 0,0:18:52.86,0:18:54.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suka meremas tetek?
Dialogue: 0,0:18:54.85,0:18:57.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Mei tidak akan melakukan itu!
Dialogue: 0,0:18:57.38,0:18:58.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika itu perintahnya...
Dialogue: 0,0:18:58.90,0:19:01.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menyesal sudah membelamu!
Dialogue: 0,0:19:02.82,0:19:03.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kuperintah.
Dialogue: 0,0:19:03.73,0:19:05.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan.
Dialogue: 0,0:19:05.12,0:19:06.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Yamame?
Dialogue: 0,0:19:06.72,0:19:07.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak salah...
Dialogue: 0,0:19:07.89,0:19:08.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Dado!\N- Malu-malu kucing?
Dialogue: 0,0:19:08.83,0:19:10.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti akan ada korban jiwa!
Dialogue: 0,0:19:10.76,0:19:15.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}U-Untung saja daku tidak malu-malu kucing...
Dialogue: 0,0:19:15.30,0:19:17.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa, Yamame.\NAku ada di sini untukmu.
Dialogue: 0,0:19:18.63,0:19:21.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iku, orang bisa mati, do.
Dialogue: 0,0:19:21.40,0:19:22.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:19:22.14,0:19:24.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus, kalau Nano?
Dialogue: 0,0:19:24.52,0:19:25.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak salah...
Dialogue: 0,0:19:25.97,0:19:28.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ingin jadi orang tercantik di dunia?
Dialogue: 0,0:19:28.25,0:19:31.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dia jadi lebih cantik lagi,\Nmataku bisa jadi buta!
Dialogue: 0,0:19:31.81,0:19:35.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Utsukushisugi Mimimi,\Nsanggahanmu malah seperti lelucon.
Dialogue: 0,0:19:35.16,0:19:36.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Chiyo?
Dialogue: 0,0:19:36.99,0:19:38.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak salah...
Dialogue: 0,0:19:41.25,0:19:42.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masokhis?
Dialogue: 0,0:19:43.49,0:19:45.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Panggung kegilaan!
Dialogue: 0,0:19:45.47,0:19:47.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan terlalu keras seperti itu...
Dialogue: 0,0:19:47.97,0:19:50.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Chiyo itu bukan Ibunda ataupun Iku!
Dialogue: 0,0:19:50.81,0:19:53.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu menganggap kami ini apa?
Dialogue: 0,0:19:53.15,0:19:55.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian pikir kalian sendiri itu apa?
Dialogue: 0,0:19:57.23,0:20:01.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat! Geraman Chiyo lolita\Nsudah hampir happy birthday!
Dialogue: 0,0:20:01.34,0:20:03.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan I am ikat sebelum dia mengamuk!
Dialogue: 0,0:20:03.65,0:20:05.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan ikat dia!
Dialogue: 0,0:20:05.24,0:20:06.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Meme?
Dialogue: 0,0:20:06.89,0:20:08.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak salah...
Dialogue: 0,0:20:08.11,0:20:09.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si cabul natural?
Dialogue: 0,0:20:09.95,0:20:12.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang cabul cuma badannya.
Dialogue: 0,0:20:12.12,0:20:13.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tidak benar.
Dialogue: 0,0:20:13.98,0:20:15.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Momiji!
Dialogue: 0,0:20:15.32,0:20:19.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Kusuri, badan Kak Meme tidaklah cabul.
Dialogue: 0,0:20:19.59,0:20:22.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Meme hanya punya payudara besar
Dialogue: 0,0:20:22.42,0:20:27.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan lekuk bawah yang indah dan empuk,\Nsangat nikmat saat diremas!
Dialogue: 0,0:20:27.26,0:20:29.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bukanlah orang cabul!
Dialogue: 0,0:20:29.30,0:20:30.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Momiji?!
Dialogue: 0,0:20:30.62,0:20:32.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu? Maaf, ya.
Dialogue: 0,0:20:32.90,0:20:35.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetek Meme cuma sangat besar,\Nbentuknya indah,
Dialogue: 0,0:20:35.46,0:20:38.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- A-Aku paham! Tolong hentikan!\N- empuk dan nikmat kalau dipegang, ya.
Dialogue: 0,0:20:38.51,0:20:39.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar sekali!
Dialogue: 0,0:20:39.80,0:20:42.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kak Mimimi!\N- Selain itu kecantikan Meme sangat luar biasa.
Dialogue: 0,0:20:42.90,0:20:44.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang, kalau Shizuka?
Dialogue: 0,0:20:44.86,0:20:47.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang tersisa itu...
Dialogue: 0,0:20:48.21,0:20:52.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Besar dan kuat?\N- Kenapa jadi seperti ini?
Dialogue: 0,0:20:52.41,0:20:55.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu Shizuka dari Little Star Wars!
Dialogue: 0,0:20:55.90,0:20:58.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shizuka raksasa mau lewat!
Dialogue: 0,0:20:58.86,0:21:00.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Tunduklah kalian, rakyat bodoh!"
Dialogue: 0,0:21:02.13,0:21:03.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Aku cuma bercanda."
Dialogue: 0,0:21:03.80,0:21:05.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Karane?
Dialogue: 0,0:21:05.69,0:21:06.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm...
Dialogue: 0,0:21:06.70,0:21:09.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak salah sisanya cuma...
Dialogue: 0,0:21:10.30,0:21:12.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang mesum bertetek gede?
Dialogue: 0,0:21:12.27,0:21:14.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beli kacamata sana!
Dialogue: 0,0:21:15.08,0:21:17.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada akhirnya,\Ndia berhasil mengingat mereka semua.
Dialogue: 0,0:21:17.81,0:21:20.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang tubuhnya paling besar itu Nak Yamame.
Dialogue: 0,0:21:20.90,0:21:22.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dado!
Dialogue: 0,0:21:22.02,0:21:25.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang paling berisik itu Nak Karane, ya?
Dialogue: 0,0:21:25.15,0:21:26.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa yang berisik?!
Dialogue: 0,0:21:26.28,0:21:28.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, benar Karane.
Dialogue: 0,0:21:28.28,0:21:29.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa yang berisik?!
Dialogue: 0,0:21:29.53,0:21:31.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, aku jadi capek, nanoja.
Dialogue: 0,0:21:31.50,0:21:32.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anda telah berjuang keras.
Dialogue: 0,0:21:32.77,0:21:36.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, apa kalian ingat nama Nenekku?
Dialogue: 0,0:21:36.49,0:21:37.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Eh?!\N- Eh?!
Dialogue: 0,0:21:37.18,0:21:37.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:21:37.89,0:21:39.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja.
Dialogue: 0,0:21:39.53,0:21:41.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah mengingatnya.
Dialogue: 0,0:21:41.41,0:21:43.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namanya siapa, ya?
Dialogue: 0,0:21:43.29,0:21:46.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma sempat dengar di awal bagian kedua.
Dialogue: 0,0:21:46.12,0:21:48.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kusuri lolita juga cuma memanggil\Ndengan "Nenek"...
Dialogue: 0,0:21:48.81,0:21:51.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak salah,\Nlafalnya cuma dua huruf, 'kan?
Dialogue: 0,0:21:51.55,0:21:54.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ditulis dengan katakana,\Nsama seperti nenek daku, do.
Dialogue: 0,0:21:54.93,0:21:57.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, terdengar seperti sebuah obat...
Dialogue: 0,0:22:00.10,0:22:01.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lafalnya dua huruf...
Dialogue: 0,0:22:01.74,0:22:02.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katakana...
Dialogue: 0,0:22:02.74,0:22:03.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Obat...
Dialogue: 0,0:22:03.70,0:22:05.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti...
Dialogue: 0,0:22:05.28,0:22:07.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Namanya Yakuzen...\N- Namanya Yakuzen...
Dialogue: 0,0:22:12.80,0:22:14.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu, dua!
Dialogue: 0,0:22:14.32,0:22:15.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Sabu!\N- Sabu!
Dialogue: 0,0:22:15.67,0:22:17.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namaku Yaku, nanoja.
