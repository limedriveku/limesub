Dialogue: 0,0:00:11.50,0:00:12.74,sign,,0000,0000,0000,,KEJUTAN
Dialogue: 0,0:00:15.24,0:00:15.65,sign,,0000,0000,0000,,KEJUTAN
Dialogue: 0,0:03:07.77,0:03:08.59,sign,,0000,0000,0000,,SEDOT
Dialogue: 0,0:04:22.92,0:04:25.93,sign,,0000,0000,0000,,BUKAN PRAJURIT ROBOT LAPUTA?
Dialogue: 0,0:04:26.41,0:04:27.84,sign,,0000,0000,0000,,BUKAN PRAJURIT ROBOT LAPUTA?
Dialogue: 0,0:05:23.67,0:05:24.45,sign,,0000,0000,0000,,TAMAN
Dialogue: 0,0:06:39.52,0:06:41.50,sign,,0000,0000,0000,,"MONSTER: WAKIL KEPALA SEKOLAH, DAYA SERANG: 4000"
Dialogue: 0,0:09:17.57,0:09:19.50,sign,,0000,0000,0000,,"WAKIL KEPALA TERBAKAR"
Dialogue: 0,0:00:15.66,0:00:18.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dibuka dengan kejutan?!
Dialogue: 0,0:00:38.89,0:00:44.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}100 Pacar yang Sungguh Sangat Amat\NBenar-benar Mencintaimu Musim Ketiga
Dialogue: 0,0:01:59.44,0:02:03.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak kusangka ini akan terjadi...
Dialogue: 0,0:02:04.26,0:02:07.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, burung!
Dialogue: 0,0:02:07.16,0:02:09.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bird.
Dialogue: 0,0:02:09.02,0:02:09.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus, bukan?
Dialogue: 0,0:02:09.97,0:02:10.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya bagus.
Dialogue: 0,0:02:10.90,0:02:13.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, 'kan?\NCoba kamu pakai lagi.
Dialogue: 0,0:02:15.01,0:02:19.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau pakai tiara bunga, rasanya aku\Nbisa mati dari keimutan mereka.
Dialogue: 0,0:02:19.34,0:02:21.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa bahas bunga, Rentaro?
Dialogue: 0,0:02:21.45,0:02:22.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau soal bunga,
Dialogue: 0,0:02:22.87,0:02:27.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tanya saja teman sekelasku bernama Yasashiki\Nyang anggota ekskul berkebun.
Dialogue: 0,0:02:27.17,0:02:29.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, anu...
Dialogue: 0,0:02:29.17,0:02:33.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, aku ingin memberi pacarku tiara bunga.
Dialogue: 0,0:02:33.01,0:02:35.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar bisa minta bunga\Nke ekskul berkebun.
Dialogue: 0,0:02:35.80,0:02:37.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh, ido.
Dialogue: 0,0:02:37.89,0:02:38.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Do?!
Dialogue: 0,0:02:38.43,0:02:43.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi syaratnya, kamu harus membantu\Ndaku mengurus kebun, ya.
Dialogue: 0,0:02:43.44,0:02:44.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daku?!
Dialogue: 0,0:02:44.19,0:02:45.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Imut sekali!
Dialogue: 0,0:02:45.82,0:02:47.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baiklah!
Dialogue: 0,0:02:47.44,0:02:48.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh iya.
Dialogue: 0,0:02:48.62,0:02:52.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daku Yasashiki Yamame dari kelas 1-3, do.
Dialogue: 0,0:02:52.03,0:02:53.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senang bertemu denganmu.
Dialogue: 0,0:02:53.28,0:02:56.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Aijo Rentaro dari kelas 1-4.
Dialogue: 0,0:02:56.05,0:02:57.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senang bertemu denganmu juga!
Dialogue: 0,0:02:59.18,0:03:01.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hiasan rambut yang imut.
Dialogue: 0,0:03:06.33,0:03:07.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka hidup?!
Dialogue: 0,0:03:08.59,0:03:12.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya-Yasashiki, di kepalamu\Nada bunga dan kupu-kupu.
Dialogue: 0,0:03:12.93,0:03:16.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanpa sadar mereka sudah\Ntinggal di kepala daku.
Dialogue: 0,0:03:16.67,0:03:18.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kasihan, jadi daku rawat saja.
Dialogue: 0,0:03:18.92,0:03:20.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu merawat mereka di kepalamu?!
Dialogue: 0,0:03:20.78,0:03:23.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuncinya, waktu keramas\Nharus pelan-pelan, do.
Dialogue: 0,0:03:23.24,0:03:25.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be-Begitu, ya?
Dialogue: 0,0:03:25.10,0:03:27.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia orang yang sangat baik hati...
Dialogue: 0,0:03:27.62,0:03:30.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, ayo ikut sini.
Dialogue: 0,0:03:30.35,0:03:31.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:03:34.61,0:03:36.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, kenapa pakai egrang?
Dialogue: 0,0:03:36.85,0:03:39.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kaki daku besar.
Dialogue: 0,0:03:39.54,0:03:45.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di alam terbuka, daku jalan seperti ini\Nagar tidak menginjak tanaman dan serangga.
Dialogue: 0,0:03:45.60,0:03:47.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betapa baik hati dia ini!
Dialogue: 0,0:03:49.20,0:03:51.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aijo, kamu terampil sekali.
Dialogue: 0,0:03:51.38,0:03:52.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:03:52.59,0:03:54.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mencabutnya sampai ke akar\Ndengan benar.
Dialogue: 0,0:03:54.89,0:03:56.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yasashiki.
Dialogue: 0,0:03:56.32,0:03:58.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gulma yang dicabut\Nsebaiknya kubuang ke mana?
Dialogue: 0,0:03:58.73,0:04:01.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, jangan dibuang, do!
Dialogue: 0,0:04:01.24,0:04:01.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:04:01.64,0:04:04.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gulma juga makhluk hidup!
Dialogue: 0,0:04:04.04,0:04:06.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betapa baik hati dia ini!
Dialogue: 0,0:04:06.43,0:04:09.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gulmanya ditanam saja\Ndi petak khusus gulma ini.
Dialogue: 0,0:04:09.45,0:04:11.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Petak ladang yang dipenuhi kebaikan!
Dialogue: 0,0:04:13.96,0:04:15.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Burung hinggap di bahunya.
Dialogue: 0,0:04:17.51,0:04:18.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tupai juga!
Dialogue: 0,0:04:21.13,0:04:22.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa dia ini Nausicaä?
Dialogue: 0,0:04:32.04,0:04:36.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seolah-olah dia orang yang\Nmencintai dan dicintai oleh alam.
Dialogue: 0,0:04:39.61,0:04:41.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tumbuhlah yang besar, do.
Dialogue: 0,0:04:41.85,0:04:45.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu hebat sekali, serangga dan hewan\Nbisa jinak padamu.
Dialogue: 0,0:04:45.21,0:04:49.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata hewan bisa tahu kalau seseorang\Nmemperlakukan mereka dengan lembut.
Dialogue: 0,0:04:49.82,0:04:53.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aduh, bikin malu, do.
Dialogue: 0,0:04:53.01,0:04:56.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daku cuma menyukai mereka saja.
Dialogue: 0,0:04:57.74,0:05:01.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu sangat menyukai\Ntanaman dan hewan?
Dialogue: 0,0:05:01.36,0:05:06.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tubuh daku besar, jadi dulu sering diejek.
Dialogue: 0,0:05:06.78,0:05:08.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, cewek gede!
Dialogue: 0,0:05:08.76,0:05:10.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cewek raksasa!
Dialogue: 0,0:05:10.33,0:05:12.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Lihat!
Dialogue: 0,0:05:12.18,0:05:13.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada alien raksasa!
Dialogue: 0,0:05:13.25,0:05:14.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lari!
Dialogue: 0,0:05:15.34,0:05:19.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa daku beda dengan anak-anak lain?
Dialogue: 0,0:05:19.79,0:05:23.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, daku jadi benci\Ndiri daku sendiri.
Dialogue: 0,0:05:24.46,0:05:26.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, suatu hari...
Dialogue: 0,0:05:50.02,0:05:53.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Oh, anakku!\N- Ibuku!
Dialogue: 0,0:05:53.14,0:05:56.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah mengembalikan anak burung\Nyang jatuh dari sarang.
Dialogue: 0,0:06:09.60,0:06:12.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau melindungi bunga yang hampir layu\Ndari badai hujan.
Dialogue: 0,0:06:12.96,0:06:14.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah melakukan itu semua,
Dialogue: 0,0:06:14.90,0:06:19.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}perlahan daku jadi bangga pada tubuh\Nyang besar dan tangguh ini.
Dialogue: 0,0:06:21.23,0:06:24.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daku hanya berterima kasih\Npada para makhluk alam
Dialogue: 0,0:06:24.74,0:06:28.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang membuat daku jadi\Nmenyukai diri sendiri.
Dialogue: 0,0:06:28.01,0:06:30.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berterima kasih pada alam...
Dialogue: 0,0:06:31.05,0:06:32.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asap?
Dialogue: 0,0:06:33.34,0:06:35.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Itu...
Dialogue: 0,0:06:35.39,0:06:37.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada sesuatu yang datang lagi, ya?!
Dialogue: 0,0:06:37.12,0:06:38.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hewan?
Dialogue: 0,0:06:39.52,0:06:41.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, namanya monster!
Dialogue: 0,0:06:41.90,0:06:44.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Anda sedang apa, Bu Wakasek?!
Dialogue: 0,0:06:44.59,0:06:48.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pinggangku encok gara-gara host\Nwaktu perjalanan dinas kemarin.
Dialogue: 0,0:06:48.09,0:06:49.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku tidak boleh bolos patroli!
Dialogue: 0,0:06:49.82,0:06:53.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada yang tahu kapan cowok nakal\Natau barang pribadinya tergeletak di tanah!
Dialogue: 0,0:06:55.91,0:06:57.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yasashiki?!
Dialogue: 0,0:06:57.41,0:07:00.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja,\Nitu cuma Ibu Wakil Kepala Sekolah!
Dialogue: 0,0:07:00.53,0:07:02.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu-Bukan itu...
Dialogue: 0,0:07:02.52,0:07:04.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Ada api!
Dialogue: 0,0:07:04.94,0:07:05.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Api?
Dialogue: 0,0:07:06.39,0:07:07.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daku...
Dialogue: 0,0:07:07.40,0:07:10.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dulu pernah lihat kebakaran hutan.
Dialogue: 0,0:07:11.24,0:07:14.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanaman dan tumbuhan
Dialogue: 0,0:07:14.68,0:07:17.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}semuanya terbunuh oleh api...
Dialogue: 0,0:07:19.29,0:07:21.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma api...
Dialogue: 0,0:07:21.89,0:07:24.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang membuat daku takut...
Dialogue: 0,0:07:24.46,0:07:25.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yasashiki...
Dialogue: 0,0:07:25.74,0:07:28.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi begitu, dia takut dengan api.
Dialogue: 0,0:07:29.25,0:07:32.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, cuma gara-gara hia yang dibakar?!
Dialogue: 0,0:07:33.26,0:07:36.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aroma segar cowok berondong!
Dialogue: 0,0:07:37.18,0:07:41.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, dewa Mithras! Dewa Mithras!\NDi mana kamu, Mithras!
Dialogue: 0,0:07:42.38,0:07:43.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tidak apa-apa?
Dialogue: 0,0:07:43.97,0:07:45.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dado...
Dialogue: 0,0:07:45.12,0:07:47.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu Wakasek sudah pergi, kok.
Dialogue: 0,0:07:47.25,0:07:49.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah, do.
Dialogue: 0,0:07:50.69,0:07:52.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, bibit-bibit yang baru ditanam ini.
Dialogue: 0,0:07:54.04,0:07:56.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka pasti juga kaget, ya?
Dialogue: 0,0:08:18.50,0:08:20.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah membantu, do.
Dialogue: 0,0:08:20.49,0:08:22.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu juga sudah bekerja keras.
Dialogue: 0,0:08:22.44,0:08:24.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Merawat tanaman ternyata menyenangkan.
Dialogue: 0,0:08:25.75,0:08:28.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasa berdebar menantikan mereka tumbuh.
Dialogue: 0,0:08:28.62,0:08:31.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kepuasan karena merasa\Ndibutuhkan makhluk lain.
Dialogue: 0,0:08:31.24,0:08:35.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Momen bersentuhan dengan tanah\Ndan tanaman sambil terkena angin di luar.
Dialogue: 0,0:08:35.45,0:08:37.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak kusangka begitu tenang seperti ini.
Dialogue: 0,0:08:37.85,0:08:40.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah kalau kamu menyukainya, do.
Dialogue: 0,0:08:40.65,0:08:43.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daku juga senang bisa berkebun denganmu.
Dialogue: 0,0:08:43.97,0:08:46.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daku sudah pernah berkebun\Ndengan banyak orang,
Dialogue: 0,0:08:46.76,0:08:50.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi baru kali ini ada\Nyang setekun dirimu, Aijo!
Dialogue: 0,0:08:50.73,0:08:55.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka pasti sangat senang\Nkalau diberikan padamu, do.
Dialogue: 0,0:08:56.71,0:08:58.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu...
Dialogue: 0,0:08:58.98,0:09:03.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga pacar yang kamu beri tiara bunga\Njuga ikut senang.
Dialogue: 0,0:09:04.50,0:09:06.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yasashiki?
Dialogue: 0,0:09:10.71,0:09:11.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf!
Dialogue: 0,0:09:13.16,0:09:17.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat bersin, hia ini jatuh ke rambutku\Ndan membuatnya terbakar!
Dialogue: 0,0:09:17.57,0:09:19.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu Waka Terbakar?!
Dialogue: 0,0:09:21.01,0:09:22.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada iblis api, do!
Dialogue: 0,0:09:22.39,0:09:23.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yasashiki!
Dialogue: 0,0:09:23.50,0:09:25.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Api sialan!
Dialogue: 0,0:09:25.12,0:09:27.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padamlah!
Dialogue: 0,0:09:27.11,0:09:28.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malah jadi ben rock garis keras?!
Dialogue: 0,0:09:28.42,0:09:29.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Api sialan!
Dialogue: 0,0:09:30.18,0:09:32.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jurus spora api?!
Dialogue: 0,0:09:40.98,0:09:46.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daku selama ini selalu melindungi.
Dialogue: 0,0:09:48.90,0:09:52.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, ini pertama kalinya daku\Ndilindungi seseorang.
Dialogue: 0,0:09:54.91,0:09:58.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak ekskul atletik di situ! Siramkan padaku\Nminuman olahraga yang baru kau minum itu!
Dialogue: 0,0:09:59.62,0:10:01.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada Dewa Kutukan!
Dialogue: 0,0:10:02.79,0:10:05.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebelah sana sepertinya sudah tidak apa-apa.
Dialogue: 0,0:10:05.72,0:10:07.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yasashiki juga tidak apa-apa?
Dialogue: 0,0:10:07.80,0:10:09.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aijo.
Dialogue: 0,0:10:10.29,0:10:12.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Da-Daku...
Dialogue: 0,0:10:12.79,0:10:15.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyukaimu, Aijo!
Dialogue: 0,0:10:21.62,0:10:22.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dado?!
Dialogue: 0,0:10:22.68,0:10:24.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maaf, do!
Dialogue: 0,0:10:24.36,0:10:26.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal kamu sudah punya pacar!
Dialogue: 0,0:10:26.36,0:10:28.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Da-Daku bilang apa, sih?!
Dialogue: 0,0:10:28.80,0:10:29.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yasashiki.
Dialogue: 0,0:10:30.69,0:10:34.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dirimu yang mencintai alam\Ndan makhluk hidup dari lubuk hatimu.
Dialogue: 0,0:10:34.94,0:10:37.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mencintai Yasashiki yang\Nberhati lembut seperti itu.
Dialogue: 0,0:10:39.45,0:10:40.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aduh!
Dialogue: 0,0:10:40.85,0:10:43.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Da-Daku tidak bermaksud seperti itu!
Dialogue: 0,0:10:43.42,0:10:44.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan begitu, do!
Dialogue: 0,0:10:44.76,0:10:45.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu, itu...
Dialogue: 0,0:10:45.93,0:10:49.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Da-Daku malu dengan pacarmu\Natau dengan sang dewa, do!
Dialogue: 0,0:10:49.71,0:10:51.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan khawatir, Yasashiki.
Dialogue: 0,0:10:52.45,0:10:55.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah punya 13 pacar.
Dialogue: 0,0:10:55.28,0:10:57.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku bersumpah akan\Nmembuat mereka semua bahagia.
Dialogue: 0,0:10:57.97,0:10:59.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dado?!
Dialogue: 0,0:10:59.05,0:11:02.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, apa itu tidak masalah?
Dialogue: 0,0:11:02.19,0:11:03.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik hewan dan serangga.
Dialogue: 0,0:11:03.61,0:11:07.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tergantung penyebutannya,\Ntumbuhan pun banyak yang berpoligami.
Dialogue: 0,0:11:08.33,0:11:12.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah menurut Yasashiki,\Ncinta mereka tidaklah nyata?
Dialogue: 0,0:11:12.95,0:11:15.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak berpikir begitu, do.
Dialogue: 0,0:11:15.56,0:11:16.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan...
Dialogue: 0,0:11:16.61,0:11:19.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, dengan kata lain...
Dialogue: 0,0:11:19.12,0:11:20.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aijo itu
Dialogue: 0,0:11:21.20,0:11:24.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hewan dan tumbuhan yang selama ini\Nsudah daku tolong!
Dialogue: 0,0:11:24.18,0:11:26.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bukan semacam Balas Budi Burung Bangau!
Dialogue: 0,0:11:30.00,0:11:32.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oleh karena itu...
Dialogue: 0,0:11:32.21,0:11:37.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maukah kalian menerima\NYasashiki Yamame menjadi pacar baruku?
Dialogue: 0,0:11:37.85,0:11:39.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senang bertemu kalian, do!
Dialogue: 0,0:11:39.76,0:11:41.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dado itu apa, nanoda?
Dialogue: 0,0:11:41.46,0:11:43.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus nanoda sendiri itu apa coba?
Dialogue: 0,0:11:44.85,0:11:47.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daku anggota ekskul berkebun,
Dialogue: 0,0:11:47.04,0:11:50.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi berniat membawakan bunga\Nsebagai tanda perkenalan.
Dialogue: 0,0:11:50.74,0:11:54.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rentaro pun membuatnya jadi\Ntiara bunga yang imut.
Dialogue: 0,0:11:55.12,0:11:56.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bunganya cantik sekali!
Dialogue: 0,0:11:56.62,0:11:59.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, aku punya sesuatu\Nyang cocok dengan tiara itu!
Dialogue: 0,0:11:59.64,0:12:04.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dibuat dari tirai baru yang menumpuk\Ndi sekolah karena aku salah pesan.
Dialogue: 0,0:12:04.18,0:12:06.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anda ini sudah dewasa, tolong yang teliti!
Dialogue: 0,0:12:06.38,0:12:10.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, itu gara-gara rekaman\Npenampilan kalian terlalu imut.
Dialogue: 0,0:12:10.21,0:12:12.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan nonton begituan saat kerja!
Dialogue: 0,0:12:12.32,0:12:14.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga dia merekamnya diam-diam!
Dialogue: 0,0:12:14.90,0:12:18.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya!\NKubuka kartu yang kututup!
Dialogue: 0,0:12:18.16,0:12:20.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kartu Sihir Perlengkapan: Gaun Putih!
Dialogue: 0,0:12:28.65,0:12:31.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Poin nyawaku kena 4000 kerusakan!
Dialogue: 0,0:12:32.52,0:12:35.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau pakai tiara bunga,\Nmemang cocoknya sama ini.
Dialogue: 0,0:12:35.82,0:12:36.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aromanya harum.
Dialogue: 0,0:12:36.92,0:12:39.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tropical flavor!
Dialogue: 0,0:12:39.16,0:12:40.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu memakannya?
Dialogue: 0,0:12:40.40,0:12:42.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Tidak, pasti salah pakai kata."
Dialogue: 0,0:12:42.16,0:12:44.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Yasashiki.
Dialogue: 0,0:12:44.86,0:12:47.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah kalau kalian suka, do.
Dialogue: 0,0:12:56.06,0:12:57.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu ide yang bagus.
Dialogue: 0,0:12:57.91,0:13:02.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong berikan beberapa bunga\Ndari tiara kalian.
Dialogue: 0,0:13:02.03,0:13:03.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dimengerti.
Dialogue: 0,0:13:03.42,0:13:07.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baru kali ini kulihat bunga kerisih\Nsebesar dan mekar seindah ini.
Dialogue: 0,0:13:08.30,0:13:10.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanazono tahu banyak soal bunga?
Dialogue: 0,0:13:10.88,0:13:13.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, sejak kecil aku memang menyukainya.
Dialogue: 0,0:13:15.44,0:13:19.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah dilihat lagi, ternyata kamu juga\Nmenanam bunga di rambut.
Dialogue: 0,0:13:19.41,0:13:21.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bukan kutanam...
Dialogue: 0,0:13:21.25,0:13:23.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebentar, jadi punyamu itu ditanam?
Dialogue: 0,0:13:23.18,0:13:24.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yamame!
Dialogue: 0,0:13:26.52,0:13:28.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini tiara bunga untukmu!
Dialogue: 0,0:13:28.02,0:13:30.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu juga harus pakai, nanoda!
Dialogue: 0,0:13:31.48,0:13:32.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daku juga?
Dialogue: 0,0:13:32.59,0:13:34.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh, do?
Dialogue: 0,0:13:34.68,0:13:38.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kepalamu saja ditumbuhi bunga,\Npasti cocok pakai tiara bunga, nanoda.
Dialogue: 0,0:13:38.30,0:13:41.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gaun putihnya juga masih ada, loh.
Dialogue: 0,0:13:41.02,0:13:43.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang salah ukur gara-gara\Nrekaman kemarin terlalu imut.
Dialogue: 0,0:13:43.63,0:13:46.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak pernah belajar dari kesalahan, ya?!
Dialogue: 0,0:13:49.17,0:13:51.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, do.
Dialogue: 0,0:13:52.86,0:13:54.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Venus!
Dialogue: 0,0:13:54.85,0:13:58.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar daku gendong kalian di pundak\Nsebagai tanda terima kasih.
Dialogue: 0,0:13:58.86,0:14:01.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dewi-Dewi sedang bermain!
Dialogue: 0,0:14:02.86,0:14:04.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak kuat sekali!
Dialogue: 0,0:14:04.26,0:14:06.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Betapa tingginya."
Dialogue: 0,0:14:06.01,0:14:06.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa lihat!
Dialogue: 0,0:14:06.96,0:14:08.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bahkan bisa melihat Brasil!
Dialogue: 0,0:14:08.92,0:14:10.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eiai juga mau naik?
Dialogue: 0,0:14:10.83,0:14:12.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, terima kasih.
Dialogue: 0,0:14:12.61,0:14:13.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menakutkan.
Dialogue: 0,0:14:14.63,0:14:16.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya.
Dialogue: 0,0:14:16.48,0:14:19.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ekskul berkebun juga menanam sayur.
Dialogue: 0,0:14:19.15,0:14:22.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya enak saat baru dipetik,\Nmau coba ke kebun?
Dialogue: 0,0:14:22.10,0:14:23.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau!
Dialogue: 0,0:14:23.06,0:14:26.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tur ekskul berkebun pun dimulai.
Dialogue: 0,0:14:27.97,0:14:30.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Tanaman dikonfirmasi."
Dialogue: 0,0:14:32.22,0:14:36.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Timunnya begitu bagus\Nseperti yang dijual di toko.
Dialogue: 0,0:14:36.30,0:14:38.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tomatnya juga besar, merah,\Ndan kelihatan enak!
Dialogue: 0,0:14:38.64,0:14:42.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mencari yang besar buat dipetik\Nserasa cari harta karun, seru sekali!
Dialogue: 0,0:14:42.44,0:14:44.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tomat adalah sahabat sejati kulit!
Dialogue: 0,0:14:46.99,0:14:51.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I am dan lainnya tidak masalah\Njadi vegetable destroyer begini?
Dialogue: 0,0:14:51.58,0:14:56.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daku terlalu semangat menanam mereka,\Ntidak akan habis untuk anggota ekskul.
Dialogue: 0,0:14:56.47,0:14:57.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:14:57.56,0:14:59.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Selamat makan!
Dialogue: 0,0:14:59.50,0:15:02.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak sekali, ya!
Dialogue: 0,0:15:04.23,0:15:06.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sangat segar berair, nanoda!
Dialogue: 0,0:15:06.05,0:15:07.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sangat enak.
Dialogue: 0,0:15:07.58,0:15:09.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya bisa dapat banyak nutrisi.
Dialogue: 0,0:15:09.61,0:15:11.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makan yang banyak, do.
Dialogue: 0,0:15:12.08,0:15:13.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah ini lukisan klasik?
Dialogue: 0,0:15:14.10,0:15:16.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya stroberi, do!
Dialogue: 0,0:15:17.08,0:15:19.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Banyak sekali stroberinya, nanoda!
Dialogue: 0,0:15:19.75,0:15:21.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harum sekali.
Dialogue: 0,0:15:21.36,0:15:22.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ingin kunikahi!
Dialogue: 0,0:15:22.64,0:15:25.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, berry, berry, strawberry!
Dialogue: 0,0:15:25.41,0:15:27.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Merah merona, dan besar...!
Dialogue: 0,0:15:27.24,0:15:30.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Juga sangat berkilau seperti permata."
Dialogue: 0,0:15:30.66,0:15:32.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan juga manis!
Dialogue: 0,0:15:32.28,0:15:33.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sudah memakannya!
Dialogue: 0,0:16:05.32,0:16:07.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Ada apa?\NBikin kaget saja.
Dialogue: 0,0:16:07.74,0:16:09.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maaf...
Dialogue: 0,0:16:09.46,0:16:11.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kenapa, Dik Rentaro?
Dialogue: 0,0:16:11.20,0:16:15.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma kaget ternyata pacar yang\Nsedang makan stroberi itu seimut ini.
Dialogue: 0,0:16:15.29,0:16:16.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai teriak sekencang itu?!
Dialogue: 0,0:16:16.96,0:16:18.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, serius.
Dialogue: 0,0:16:18.82,0:16:21.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pacar-pacarku makan stroberi\Ndengan tiara bunga dan gaun putih
Dialogue: 0,0:16:21.75,0:16:23.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sudah seperti sebuah senjata!
Dialogue: 0,0:16:23.45,0:16:26.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau semanis ini, tidak perlu\Nsusu kental manis lagi, ya.
Dialogue: 0,0:16:26.05,0:16:29.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Stroberi semanis ini diberi susu kental manis\Nnanti kena petaka!
Dialogue: 0,0:16:30.34,0:16:32.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semangatmu jadi aneh, loh.
Dialogue: 0,0:16:32.60,0:16:33.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aneh sekali.
Dialogue: 0,0:16:33.82,0:16:37.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buah dan sayuran tidak mungkin tumbuh\Ndengan kualitas setinggi ini di sini.
Dialogue: 0,0:16:37.92,0:16:42.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tanaman dirawat dengan cinta,\Nmereka akan membalasnya, do.
Dialogue: 0,0:16:42.85,0:16:44.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanaman tidak punya fungsi seperti itu.
Dialogue: 0,0:16:44.65,0:16:45.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dado?
Dialogue: 0,0:16:45.77,0:16:47.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, begitu? Berarti soal nyali, ya?
Dialogue: 0,0:16:51.22,0:16:53.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rentaro...
Dialogue: 0,0:16:57.80,0:16:59.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ha-Hakari?!
Dialogue: 0,0:16:59.64,0:17:01.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada suatu teori bilang kalau stroberi
Dialogue: 0,0:17:01.63,0:17:05.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa merangsang indra yang bertugas\Nmendeteksi rasa manis.
Dialogue: 0,0:17:05.25,0:17:08.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, meningkatkan sensasi ciuman\Ndan semacamnya...
Dialogue: 0,0:17:08.28,0:17:09.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hakari?!
Dialogue: 0,0:17:09.07,0:17:10.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ga-Gawat!
Dialogue: 0,0:17:10.24,0:17:12.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hakari kena efek peningkat\Nkenikmatan stroberi!
Dialogue: 0,0:17:12.43,0:17:14.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perasaan setelan pabriknya juga begitu.
Dialogue: 0,0:17:14.51,0:17:16.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Curang kalau cuma Hakari!
Dialogue: 0,0:17:16.17,0:17:18.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kusuri juga mau!
Dialogue: 0,0:17:18.61,0:17:19.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga...
Dialogue: 0,0:17:19.65,0:17:22.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku bukannya tertarik, ya!
Dialogue: 0,0:17:26.09,0:17:28.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Chiyo tidak mau ikut?
Dialogue: 0,0:17:28.53,0:17:30.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga mau!
Dialogue: 0,0:17:33.72,0:17:35.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mentalnya kenapa itu?!
Dialogue: 0,0:17:35.29,0:17:37.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dado?!
Dialogue: 0,0:17:42.53,0:17:45.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau Yasashiki\Njuga ikut coba sekali.
Dialogue: 0,0:17:45.48,0:17:47.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan ditawari seperti mengajak mabuk!
Dialogue: 0,0:17:48.50,0:17:51.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Destroy saja sungkanmu!
Dialogue: 0,0:17:55.51,0:17:57.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Da-Dado.
Dialogue: 0,0:18:06.52,0:18:08.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daku tidak usah saja.
Dialogue: 0,0:18:08.41,0:18:10.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya masih malu.
Dialogue: 0,0:18:13.98,0:18:19.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bolehkah kami membantu pekerjaan kebun\Nsebagai bentuk terima kasih atas hari ini?
Dialogue: 0,0:18:19.32,0:18:20.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Itu ide yang bagus."
Dialogue: 0,0:18:20.82,0:18:21.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar!
Dialogue: 0,0:18:21.66,0:18:24.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Kak Yasashiki!\NTerima kasih, Bumi!
Dialogue: 0,0:18:25.24,0:18:26.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berat sekali!
Dialogue: 0,0:18:33.15,0:18:35.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tumbuhlah dengan cantik!
Dialogue: 0,0:18:35.14,0:18:36.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti diriku!
Dialogue: 0,0:18:36.64,0:18:39.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku bukannya merasa kalian cantik, ya!
Dialogue: 0,0:18:39.69,0:18:41.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa tidak kalian siram dengan tenang?
Dialogue: 0,0:18:41.65,0:18:44.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mencintaimu.
Dialogue: 0,0:18:44.64,0:18:46.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa benar seperti ini?
Dialogue: 0,0:18:46.22,0:18:47.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dado?
Dialogue: 0,0:18:47.66,0:18:50.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shizuka lolita menghilang!
Dialogue: 0,0:18:56.21,0:19:01.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal cuma rumput begini,\Nternyata bisa jadi sayur selezat itu!
Dialogue: 0,0:19:01.46,0:19:02.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hayat memang penuh misteri!
Dialogue: 0,0:19:02.82,0:19:05.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rumput, kalian luar biasa!
Dialogue: 0,0:19:05.42,0:19:08.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin Tuan Rumput akan\Nmengerti perasaan kalian.
Dialogue: 0,0:19:08.34,0:19:10.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bibit, ya.\NBukan rumput.
Dialogue: 0,0:19:10.93,0:19:13.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus semuanya, do!
Dialogue: 0,0:19:13.05,0:19:15.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benar-benar berterima kasih, do.
Dialogue: 0,0:19:15.32,0:19:20.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daku akan patroli kebun sekali lagi,\Nkalian pulang duluan saja, do.
Dialogue: 0,0:19:35.11,0:19:38.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana bisa pacaran sama cewek\Nyang lebih tinggi!
Dialogue: 0,0:19:38.43,0:19:40.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba bayangkan saja!
Dialogue: 0,0:19:40.37,0:19:42.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat mau ciuman, dia harus membungkuk dulu!
Dialogue: 0,0:19:42.84,0:19:46.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harga dirimu sebagai pacar pasti hancur!
Dialogue: 0,0:19:46.10,0:19:48.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Acara sampah macam apa ini, do?!
Dialogue: 0,0:19:50.16,0:19:51.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yamame.
Dialogue: 0,0:19:52.26,0:19:53.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rentaro?
Dialogue: 0,0:19:53.93,0:19:55.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah selesai patroli?
Dialogue: 0,0:19:55.25,0:19:56.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya...
Dialogue: 0,0:19:56.49,0:19:58.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baru saja selesai, do.
Dialogue: 0,0:19:58.46,0:20:01.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, sini ikut aku sebentar.
Dialogue: 0,0:20:06.08,0:20:08.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di situ kebun yang tidak terpakai, loh.
Dialogue: 0,0:20:19.81,0:20:21.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dado?
Dialogue: 0,0:20:21.09,0:20:22.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kalian semua...
Dialogue: 0,0:20:22.86,0:20:24.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah tumbuh secepat ini?!
Dialogue: 0,0:20:24.70,0:20:26.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dipikir lonjakan pertumbuhan?!
Dialogue: 0,0:20:26.42,0:20:28.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma pakai tumpukan tanah buat pijakan
Dialogue: 0,0:20:28.42,0:20:32.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu ujung kaki mereka ditutup\Ndengan digulung tirai.
Dialogue: 0,0:20:32.42,0:20:35.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih banyak sisa tirai\Nyang belum terpakai, kok!
Dialogue: 0,0:20:35.25,0:20:37.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan berlagak seolah\Nkau siapkan untuk ini.
Dialogue: 0,0:20:37.55,0:20:40.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ta-Tapi, kenapa melakukan itu?
Dialogue: 0,0:20:40.43,0:20:45.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena aku ingin coba mencium mereka\Ndengan terpaut tinggi badan yang berbeda.
Dialogue: 0,0:20:45.18,0:20:46.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dado?
Dialogue: 0,0:20:47.16,0:20:51.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kalau seperti itu,\Nharus membungkuk dulu, do.
Dialogue: 0,0:20:51.46,0:20:52.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Justru itu.
Dialogue: 0,0:20:52.94,0:20:54.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Situasi yang menggairahkan!
Dialogue: 0,0:20:54.85,0:20:56.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Situasi menggairahkan?
Dialogue: 0,0:20:56.99,0:20:57.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dado?!
Dialogue: 0,0:20:58.61,0:20:59.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:21:00.44,0:21:04.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daku tidak usah saja.\NRasanya masih malu.
Dialogue: 0,0:21:06.41,0:21:09.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yamame, barusan melirik bayangannya, ya?
Dialogue: 0,0:21:09.92,0:21:13.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan dia khawatir\Ndengan perbedaan tinggi kami?
Dialogue: 0,0:21:13.50,0:21:16.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada orang yang terpikat\Ndengan wanita mungil.
Dialogue: 0,0:21:16.48,0:21:18.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada juga yang terpikat\Ndengan wanita bertubuh besar.
Dialogue: 0,0:21:19.37,0:21:20.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan setidaknya aku...
Dialogue: 0,0:21:21.53,0:21:23.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terpikat oleh semuanya!
Dialogue: 0,0:21:25.22,0:21:29.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, maukah Yamame\Njuga berciuman denganku?
Dialogue: 0,0:21:29.90,0:21:31.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Da-Dado?
Dialogue: 0,0:21:50.64,0:21:52.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berikutnya giliran Kusuri, nanoda!
Dialogue: 0,0:21:52.72,0:21:53.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga mau!
Dialogue: 0,0:21:53.57,0:21:56.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pe-Perbedaan tinggi badan itu\Ntidak ada hubungannya, ya!
Dialogue: 0,0:21:57.37,0:22:00.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitulah cerita Rentaro\Ndan para pacar tercintanya
Dialogue: 0,0:22:00.68,0:22:04.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berciuman dengan perbedaan tinggi badan\Nyang membahagiakan.
Dialogue: 0,0:22:04.54,0:22:05.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu Dewa Kutukan!
Dialogue: 0,0:22:05.76,0:22:07.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dewa Kutukan berwarna putih!
Dialogue: 0,0:23:41.44,0:23:43.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kusuri betulan tumbuh tinggi, nanoda!
Dialogue: 0,0:23:43.77,0:23:45.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, kenapa bisa begitu?!
Dialogue: 0,0:23:45.86,0:23:48.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu kaki Dik Chiyo, 'kan?
Dialogue: 0,0:23:48.06,0:23:49.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau bisa tahu?
