Dialogue: 0,0:04:09.17,0:04:12.56,sign,,0000,0000,0000,,"REMAS, REMAS"
Dialogue: 0,0:06:22.70,0:06:24.94,sign,,0000,0000,0000,,BESOKNYA
Dialogue: 0,0:07:10.86,0:07:12.36,sign,,0000,0000,0000,,BESOKNYA
Dialogue: 0,0:07:19.62,0:07:20.58,sign,,0000,0000,0000,,KLANG!
Dialogue: 0,0:07:52.91,0:07:55.16,sign,,0000,0000,0000,,TELAH DISAMARKAN DEMI MELINDUNGI PRIVASI
Dialogue: 0,0:08:25.42,0:08:27.41,sign,,0000,0000,0000,,PICHAN - KUROCHAN
Dialogue: 0,0:10:19.14,0:10:21.02,sign,,0000,0000,0000,,REMAS, REMAS
Dialogue: 0,0:10:48.04,0:10:50.29,sign,,0000,0000,0000,,MALAMNYA DI TEMPAT KERJA NOZAWA-SENSEI
Dialogue: 0,0:11:45.63,0:11:46.94,sign,,0000,0000,0000,,JEGLEK!
Dialogue: 0,0:11:58.59,0:11:59.98,sign,,0000,0000,0000,,ELUS, ELUS
Dialogue: 0,0:12:19.34,0:12:20.14,sign,,0000,0000,0000,,REMAS, REMAS
