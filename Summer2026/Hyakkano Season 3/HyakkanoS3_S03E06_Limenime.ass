Dialogue: 0,0:14:43.87,0:14:45.35,sign,,0000,0000,0000,,CENUT!! CENUT!!
Dialogue: 0,0:15:57.32,0:15:58.41,sign,,0000,0000,0000,,100 PACAR YANG SUNGGUH SANGAT\NAMAT BENAR-BENAR MENCINTAIMU
Dialogue: 0,0:16:30.60,0:16:32.01,sign,,0000,0000,0000,,REMAS, CUBIT, TARIK
Dialogue: 0,0:16:37.28,0:16:37.97,sign,,0000,0000,0000,,KRUYUK
Dialogue: 0,0:17:18.34,0:17:20.06,sign,,0000,0000,0000,,EMPUK, EMPUK
Dialogue: 0,0:18:58.74,0:18:59.71,sign,,0000,0000,0000,,SOMBONG
Dialogue: 0,0:19:59.61,0:20:01.61,sign,,0000,0000,0000,,"MENDIDIH"
Dialogue: 0,0:21:52.50,0:21:53.63,sign,,0000,0000,0000,,"KECUP, KECUP"
Dialogue: 0,0:22:03.50,0:22:03.98,sign,,0000,0000,0000,,KECUP, KECUP
Dialogue: 0,0:00:12.08,0:00:14.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di ekskul sepak bola putri\Njuga tidak ada, ya.
Dialogue: 0,0:00:15.29,0:00:17.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa memang sungguhan ada?
Dialogue: 0,0:00:17.87,0:00:20.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis misterius yang tiba-tiba
Dialogue: 0,0:00:20.04,0:00:23.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}muncul di ekskul olahraga putri dan memijat\Ndengan kenikmatan luar biasa
Dialogue: 0,0:00:23.50,0:00:24.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu pergi begitu saja.
Dialogue: 0,0:00:25.54,0:00:26.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misalkan itu benar.
Dialogue: 0,0:00:26.88,0:00:31.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin dia memijat badan semua orang\Nyang lelah memenuhi tuntutan anime ini.
Dialogue: 0,0:00:32.97,0:00:33.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teriakan?!
Dialogue: 0,0:00:35.03,0:00:36.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa ini?!
Dialogue: 0,0:00:54.62,0:00:56.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kalian tidak apa-apa?!
Dialogue: 0,0:00:56.23,0:00:58.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa bisa begini?
Dialogue: 0,0:00:58.18,0:01:01.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ga-Gadis itu memijat kami...
Dialogue: 0,0:01:01.65,0:01:02.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gara-gara dipijat?!
Dialogue: 0,0:01:02.87,0:01:04.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya...
Dialogue: 0,0:01:04.19,0:01:06.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baru sekarang aku merasa senikmat ini...
Dialogue: 0,0:01:06.05,0:01:08.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian semua cuma lemas keenakan?!
Dialogue: 0,0:01:09.59,0:01:14.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kamu gadis misterius\Nyang berkeliaran di ekskul olahraga putri?
Dialogue: 0,0:01:14.39,0:01:15.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya begitu.
Dialogue: 0,0:01:15.89,0:01:20.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namaku Momi Momiji,\Ndari kelas 3-2 SMP Ohananomitsu.
Dialogue: 0,0:01:20.68,0:01:23.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu, Momi Momiji...
Dialogue: 0,0:01:23.23,0:01:25.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mirip seperti Nobi Nobita, 'kan?
Dialogue: 0,0:01:25.68,0:01:27.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malah disebut sendiri!
Dialogue: 0,0:01:41.87,0:01:47.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}100 Pacar yang Sungguh Sangat Amat\NBenar-benar Mencintaimu Musim Ketiga
Dialogue: 0,0:02:58.32,0:03:02.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Aijo Rentaro,\Nkelas 1-4 SMA Ohananomitsu.
Dialogue: 0,0:03:02.82,0:03:06.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata, kamu mau memberi tahu namamu, ya.
Dialogue: 0,0:03:06.67,0:03:09.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Momiji sebenarnya\Nselalu memperkenalkan diri.
Dialogue: 0,0:03:10.01,0:03:12.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, karena terlalu keenakan dipijat,
Dialogue: 0,0:03:12.50,0:03:15.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ingatan mereka sepertinya jadi kabur.
Dialogue: 0,0:03:15.59,0:03:17.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Efek sampingnya betulan gila!
Dialogue: 0,0:03:17.38,0:03:21.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, Momiji akan membopong\Nmereka ke ruang ekskul.
Dialogue: 0,0:03:21.58,0:03:23.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, semuanya?
Dialogue: 0,0:03:23.14,0:03:24.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bi-Biar ikut kubantu.
Dialogue: 0,0:03:25.14,0:03:26.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu, dua!
Dialogue: 0,0:03:28.90,0:03:30.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedang apa kamu?!
Dialogue: 0,0:03:30.90,0:03:33.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Momiji suka sensasi sentuhan.
Dialogue: 0,0:03:33.11,0:03:36.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terutama sensasi empuk badan wanita,\NMomiji sangat menyukainya.
Dialogue: 0,0:03:36.90,0:03:39.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo ditahan dulu!\NKita di ruang publik, lho!
Dialogue: 0,0:03:39.78,0:03:45.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Momiji tidak punya niat buruk,\Nsekadar menikmati sensasi sentuhan.
Dialogue: 0,0:03:45.53,0:03:47.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong jangan meremehkan.
Dialogue: 0,0:03:47.17,0:03:50.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebelum pasang muka serius begitu,\Nhentikan dulu remasanmu itu!
Dialogue: 0,0:03:50.79,0:03:54.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, betapa kenyal dan lembutnya...
Dialogue: 0,0:03:54.46,0:03:56.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keajaiban dari ciptaan Dewa.
Dialogue: 0,0:03:56.54,0:03:57.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Niat kamu bopong tidak?!
Dialogue: 0,0:03:57.67,0:04:00.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bilang alasanmu memberi pijatan...
Dialogue: 0,0:04:01.83,0:04:02.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar!
Dialogue: 0,0:04:02.60,0:04:06.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi menikmati sensasi sentuhan\Ndari badan wanita yang lembut.
Dialogue: 0,0:04:06.22,0:04:08.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti dimarahi ahli pijat satu negeri, lho!
Dialogue: 0,0:04:09.17,0:04:12.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetapi, tentu bukan cuma itu.
Dialogue: 0,0:04:12.56,0:04:14.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekakuan dan kelelahan otot
Dialogue: 0,0:04:14.65,0:04:19.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa mengganggu pertumbuhan normal\Ndan sensasi sentuhan badan wanita.
Dialogue: 0,0:04:19.02,0:04:24.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Momiji hanya ingin memijat demi menolong\Nkeempukan badan wanita yang luar biasa!
Dialogue: 0,0:04:25.91,0:04:28.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bila bisa menolong sesuatu yang disukai
Dialogue: 0,0:04:28.71,0:04:32.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah pekerjaan yang sangat\Nmembahagiakan dan membuat puas!
Dialogue: 0,0:04:33.46,0:04:35.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ucapanmu jadi tidak ada artinya, tahu!
Dialogue: 0,0:04:38.05,0:04:40.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:04:40.30,0:04:42.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Momiji akan kesulitan kalau seorang diri.
Dialogue: 0,0:04:42.59,0:04:44.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, sangat terbantu.
Dialogue: 0,0:04:44.47,0:04:46.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah, jangan dipikirkan.
Dialogue: 0,0:04:46.97,0:04:48.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekadar bentuk terima kasih.
Dialogue: 0,0:04:48.97,0:04:52.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh tidak kalau Momiji\Njuga memijit badan Kakak?
Dialogue: 0,0:04:52.36,0:04:52.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:04:52.81,0:04:56.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari yang Momiji lihat,\Nkelihatannya otot Kakak lumayan lelah.
Dialogue: 0,0:04:57.01,0:04:59.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski masih terhalang baju,\Ntapi bisa tahu sampai situ?
Dialogue: 0,0:05:00.16,0:05:00.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:05:00.90,0:05:03.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Secara alami dipelajari\Ndari pengalaman memijat.
Dialogue: 0,0:05:03.99,0:05:08.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin konsepnya sama seperti Goku yang\Nbisa menilai kekuatan musuh cuma dari melihat.
Dialogue: 0,0:05:08.78,0:05:10.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Scouter alami?!
Dialogue: 0,0:05:13.75,0:05:16.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ni-Nikmat sekali...
Dialogue: 0,0:05:16.14,0:05:18.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Otot Bapak kaku sekali.
Dialogue: 0,0:05:18.34,0:05:22.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini justru terlalu kaku!\NRasanya seperti memijat Astro Boy!
Dialogue: 0,0:05:22.51,0:05:26.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekeras apa keseharian yang Kakak lalui?
Dialogue: 0,0:05:26.34,0:05:29.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, rasanya tidak ada yang seserius itu.
Dialogue: 0,0:05:29.46,0:05:32.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan khawatir, serahkan saja pada Momiji!
Dialogue: 0,0:05:36.59,0:05:37.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih!
Dialogue: 0,0:05:37.94,0:05:40.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Badanku jadi sangat ringan\Nsampai sulit dipercaya!
Dialogue: 0,0:05:40.78,0:05:44.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pijatan Momi benar-benar luar biasa.
Dialogue: 0,0:05:44.69,0:05:47.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, ini masih belum cukup...
Dialogue: 0,0:05:47.03,0:05:50.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Momiji harus mengumpulkan\Nlebih banyak pengalaman,
Dialogue: 0,0:05:50.04,0:05:54.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena ingin menjadi ahli pijat terhebat yang\Nbisa menyembuhkan badan wanita mana pun.
Dialogue: 0,0:05:55.87,0:05:57.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu jadi terkenal...
Dialogue: 0,0:05:57.42,0:05:59.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dapat banyak pasien...
Dialogue: 0,0:05:59.17,0:06:01.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti idola gravure...
Dialogue: 0,0:06:01.47,0:06:04.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau remas yang tidak-tidak,\Nnanti dimarahi, lho!
Dialogue: 0,0:06:04.52,0:06:07.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, badan Kakak yang sekaku Astro Boy itu
Dialogue: 0,0:06:07.85,0:06:10.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah pengalaman berharga bagiku.
Dialogue: 0,0:06:11.73,0:06:13.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu...
Dialogue: 0,0:06:14.29,0:06:16.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapan pun badan Kakak terasa pegal lagi,
Dialogue: 0,0:06:16.94,0:06:21.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Momiji akan senang kalau Kakak\Ndatang untuk dipijat lagi.
Dialogue: 0,0:06:26.70,0:06:27.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini aneh.
Dialogue: 0,0:06:27.99,0:06:33.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya yang Momiji suka adalah\Nsensasi kelembutan dari badan wanita.
Dialogue: 0,0:06:34.16,0:06:36.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini baru pertama terjadi...
Dialogue: 0,0:06:37.69,0:06:40.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah ini cinta?
Dialogue: 0,0:06:40.46,0:06:45.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kemarin otot Kak Rentaro\Nyang kaku sudah kulemaskan.
Dialogue: 0,0:06:45.67,0:06:48.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk sementara pasti tidak akan bertemu.
Dialogue: 0,0:06:52.09,0:06:55.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Remas, remas, remas...
Dialogue: 0,0:06:58.48,0:07:00.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pulang nanti, biar kuremas adonan roti...
Dialogue: 0,0:07:00.36,0:07:02.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, Momi!
Dialogue: 0,0:07:02.48,0:07:04.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Aijo?!
Dialogue: 0,0:07:05.98,0:07:07.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi Astro Boy lagi!
Dialogue: 0,0:07:07.73,0:07:10.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi inilah cinta!
Dialogue: 0,0:07:12.37,0:07:14.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin memijatnya lagi...
Dialogue: 0,0:07:14.91,0:07:19.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, Kak Aijo sekalipun tidak akan mungkin\Nbadannya kaku tiga hari beruntun...
Dialogue: 0,0:07:20.62,0:07:22.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi Astro Boy lagi!
Dialogue: 0,0:07:23.37,0:07:25.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia terbang ke lalangit.
Dialogue: 0,0:07:26.42,0:07:28.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pijatan hari ini pun sangat memuaskan.
Dialogue: 0,0:07:29.00,0:07:30.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga.
Dialogue: 0,0:07:30.43,0:07:33.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenikmatan pijatan hari ini\Nserasa mengirimku ke surga lagi.
Dialogue: 0,0:07:33.39,0:07:36.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, setiap hari selalu jadi kaku\Nseperti Astro Boy.
Dialogue: 0,0:07:37.02,0:07:37.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan?!
Dialogue: 0,0:07:37.89,0:07:42.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa Kakak dipaksa kerja rodi\Ndi suatu fasilitas bawah tanah?!
Dialogue: 0,0:07:42.01,0:07:44.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bukan Kaiji, ya.
Dialogue: 0,0:07:44.15,0:07:46.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, jadi sebenarnya,
Dialogue: 0,0:07:46.56,0:07:49.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}selama dua hari ini, demi membuat\Nbadanku sekaku Astro Boy
Dialogue: 0,0:07:49.40,0:07:52.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku pergi membantu pekerjaan seseorang.
Dialogue: 0,0:07:57.27,0:07:58.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya?
Dialogue: 0,0:07:58.53,0:08:02.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maaf kalau saya tiba-tiba datang\Ntanpa memberi tahu.
Dialogue: 0,0:08:02.54,0:08:04.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Debut Pertama!
Dialogue: 0,0:08:06.63,0:08:07.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemunculan pertama di TV!
Dialogue: 0,0:08:07.95,0:08:12.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inilah sosok Nozawa-sensei\Nselaku ilustrator komik 100 Pacar!
Dialogue: 0,0:08:12.65,0:08:15.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}E-Eh? Re-Rentaro?!
Dialogue: 0,0:08:15.88,0:08:17.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini mimpi? Atau halusinasi?
Dialogue: 0,0:08:17.89,0:08:22.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi memang, pekerjaan Anda begitu berat\Nhingga membuat halusinasi.
Dialogue: 0,0:08:22.27,0:08:23.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau halusinasinya.
Dialogue: 0,0:08:27.41,0:08:31.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, aku sudah diizinkan membantu,\Njadi harus semangat!
Dialogue: 0,0:08:32.66,0:08:34.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, imut sekali!
Dialogue: 0,0:08:34.37,0:08:36.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Panel yang ini, sama yang ini, imut sekali!
Dialogue: 0,0:08:37.76,0:08:39.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Nozawa-sensei.
Dialogue: 0,0:08:39.95,0:08:41.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk bagian ini.
Dialogue: 0,0:08:41.33,0:08:46.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di draf karya asli, gambarnya ada lima karakter,\Ntapi di sini jadi empat belas, lho.
Dialogue: 0,0:08:46.46,0:08:51.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah halaman ini adalah cara karya asli\Nuntuk sedikit mengurangi beban ilustrasi?
Dialogue: 0,0:08:51.21,0:08:52.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, tidak.
Dialogue: 0,0:08:52.68,0:08:55.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka semua adalah anak-anakku\Nyang berharga.
Dialogue: 0,0:08:55.30,0:08:56.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perwujudan cinta!
Dialogue: 0,0:08:57.88,0:09:02.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu dulu, baju karakter sampingan ini\Npakai blok hitam atau tekstur bergradasi, ya?!
Dialogue: 0,0:09:02.46,0:09:04.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, kalau yang ini?!
Dialogue: 0,0:09:04.08,0:09:05.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau karakter ini?!
Dialogue: 0,0:09:05.25,0:09:07.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, yang ini dan ini juga!
Dialogue: 0,0:09:07.53,0:09:10.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karakter terus muncul satu per satu!
Dialogue: 0,0:09:10.07,0:09:13.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guwah!
Dialogue: 0,0:09:13.82,0:09:16.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang ada kepuasan dan kesenangannya.
Dialogue: 0,0:09:16.21,0:09:18.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, secara fisik benar-benar menyiksa badan.
Dialogue: 0,0:09:18.81,0:09:21.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, aku yang mewarnai blok hitam itu!
Dialogue: 0,0:09:21.34,0:09:23.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sangat mengharukan, ya.
Dialogue: 0,0:09:25.37,0:09:29.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetapi, kenapa Kakak sengaja\Njadi kaku seperti Astro Boy?
Dialogue: 0,0:09:29.21,0:09:30.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu karena...
Dialogue: 0,0:09:30.80,0:09:34.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin membantumu yang bilang\Nmau mengumpulkan pengalaman
Dialogue: 0,0:09:34.55,0:09:36.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}demi jadi ahli pijat terhebat.
Dialogue: 0,0:09:37.90,0:09:41.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah kamu memberiku pijatan senikmat itu,
Dialogue: 0,0:09:41.82,0:09:44.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tidak tenang\Nkalau tidak membalas sesuatu.
Dialogue: 0,0:09:44.48,0:09:46.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu demi Momiji?
Dialogue: 0,0:09:49.11,0:09:52.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Momiji menyukai Kak Aijo!
Dialogue: 0,0:09:53.42,0:09:55.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak peduli meski otot Kakak\Nbukan seperti Astro Boy.
Dialogue: 0,0:09:55.99,0:09:57.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Momiji mohon...
Dialogue: 0,0:09:58.24,0:10:00.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bolehkah Momiji memijat Kakak setiap hari!
Dialogue: 0,0:10:05.19,0:10:06.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga.
Dialogue: 0,0:10:06.80,0:10:09.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pijatanmu yang bisa membuat orang bahagia.
Dialogue: 0,0:10:09.50,0:10:13.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serta dirimu yang tekun mengejar mimpi,\Naku menyukai dirimu yang seperti itu.
Dialogue: 0,0:10:14.58,0:10:17.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harap kita akan terus bersama!
Dialogue: 0,0:10:21.03,0:10:22.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bukan mimpi!
Dialogue: 0,0:10:22.38,0:10:23.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harusnya dicubit, dong.
Dialogue: 0,0:10:24.16,0:10:27.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya ini sangat membahagiakan,\Ntapi kesampingkan itu dulu.
Dialogue: 0,0:10:27.68,0:10:31.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada orang yang harus segera\NMomiji pijat dulu.
Dialogue: 0,0:10:31.41,0:10:33.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Momiji pamit dulu.
Dialogue: 0,0:10:33.52,0:10:35.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan ikut bersamamu!
Dialogue: 0,0:10:35.03,0:10:37.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baru kali ini aku menyadarinya sendiri.
Dialogue: 0,0:10:37.69,0:10:39.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dari awal seharusnya memang begini.
Dialogue: 0,0:10:39.79,0:10:42.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo cepat!\NSebelum terlambat!
Dialogue: 0,0:10:42.72,0:10:45.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar!\NAyo kita sembuhkan Beliau!
Dialogue: 0,0:10:45.42,0:10:48.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Nozawa-sensei yang sekaku Astro Boy!\N- Nozawa-sensei yang sekaku Astro Boy!
Dialogue: 0,0:10:50.29,0:10:52.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, kakunya pundakku...
Dialogue: 0,0:10:53.35,0:10:58.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Terima kasih atas semuanya, Nozawa-sensei!\N- "Terima kasih atas semuanya, Nozawa-sensei!"
Dialogue: 0,0:10:58.72,0:11:00.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oleh karena itu...
Dialogue: 0,0:11:00.81,0:11:06.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maukah kalian menerima\NMomi Momiji menjadi pacar baruku?
Dialogue: 0,0:11:06.50,0:11:09.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan diingat seperti ejaan Nobi Nobita.
Dialogue: 0,0:11:09.65,0:11:12.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayahku juga pakai sistem ejaan yang sama.
Dialogue: 0,0:11:12.11,0:11:13.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Momisuke, dong?!
Dialogue: 0,0:11:13.19,0:11:15.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kau bukannya?!
Dialogue: 0,0:11:15.01,0:11:16.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Kalian saling kenal?"
Dialogue: 0,0:11:17.02,0:11:19.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, Haraga yang duduk di sebelahku.
Dialogue: 0,0:11:19.00,0:11:21.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini pertama kalinya kita bicara.
Dialogue: 0,0:11:21.12,0:11:24.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu selalu makan bekal sebelum waktunya,\NMomiji kira anak berandal.
Dialogue: 0,0:11:24.66,0:11:27.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau juga selalu meremas benda aneh.
Dialogue: 0,0:11:27.73,0:11:30.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai sekarang kita adalah teman.
Dialogue: 0,0:11:30.00,0:11:32.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senang berkenalan denganmu.
Dialogue: 0,0:11:32.60,0:11:34.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.\NJangan diremas, hei.
Dialogue: 0,0:11:34.77,0:11:37.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai tanda pertemanan,\Nbiar Momiji pijat kalian!
Dialogue: 0,0:11:37.73,0:11:40.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahuku begitu ringan\Nseperti tumbuh sayapnya...
Dialogue: 0,0:11:40.81,0:11:43.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga merasakannya!\NSeperti mau terbang!
Dialogue: 0,0:11:43.72,0:11:45.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka terbang betulan!
Dialogue: 0,0:11:48.23,0:11:49.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh...
Dialogue: 0,0:11:49.84,0:11:53.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekujur tubuh Kak Mei kaku sekali.
Dialogue: 0,0:11:53.94,0:11:56.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya sudah terlalu banyak bekerja.
Dialogue: 0,0:11:56.28,0:11:58.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan cuma di punggung,\Nsampai ke depan juga.
Dialogue: 0,0:11:59.99,0:12:01.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bukan anjing, lho.
Dialogue: 0,0:12:01.82,0:12:04.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kusuri juga mau dipijat, nanoda!
Dialogue: 0,0:12:04.50,0:12:06.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berapa umur Kak Yakuzen?
Dialogue: 0,0:12:06.88,0:12:10.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}18 tahun, tapi sekarang balik mundur\Nke 8 tahun, nanoda.
Dialogue: 0,0:12:10.12,0:12:11.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pantas saja.
Dialogue: 0,0:12:11.58,0:12:13.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Badanmu sama sekali tidak ada yang kaku.
Dialogue: 0,0:12:15.29,0:12:17.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kusuri juga mau jadi kaku.
Dialogue: 0,0:12:17.34,0:12:19.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dahi di antara alismu kaku.
Dialogue: 0,0:12:20.15,0:12:22.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya seperti\Nkena jurus Cakar Besi, nanoda!
Dialogue: 0,0:12:23.25,0:12:24.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lirik!
Dialogue: 0,0:12:24.47,0:12:27.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal Iin masih muda,\Ntapi cukup kaku juga.
Dialogue: 0,0:12:27.69,0:12:29.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlalu stres itu tidak baik\Nuntuk pertumbuhan.
Dialogue: 0,0:12:29.90,0:12:31.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baik...
Dialogue: 0,0:12:31.98,0:12:34.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Yoshimoto hobi membaca buku, ya?
Dialogue: 0,0:12:34.66,0:12:36.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terasa dari kekakuan ototmu.
Dialogue: 0,0:12:36.15,0:12:38.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Kenikmatan yang tak bisa\Ndiungkapkan kata-kata."
Dialogue: 0,0:12:39.00,0:12:41.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Eiai sepertinya selalu duduk\Nbagai android
Dialogue: 0,0:12:41.36,0:12:44.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tanpa mengubah postur satu mili pun.
Dialogue: 0,0:12:44.42,0:12:47.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama belajar, postur yang benar\Nadalah pilihan paling efisien.
Dialogue: 0,0:12:47.63,0:12:49.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nano, kamu itu makhluk hidup, dado!
Dialogue: 0,0:12:51.49,0:12:54.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedangkan Haraga terlalu banyak\Nmenggerakkan rahang.
Dialogue: 0,0:12:54.46,0:12:56.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Yasashiki kebanyakan kerja berat.
Dialogue: 0,0:12:56.70,0:12:59.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setiap hari daku memang kerja\Ndi kebun, dado.
Dialogue: 0,0:12:59.39,0:13:02.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betapa susah dan memuaskannya saat dipijat.
Dialogue: 0,0:13:02.70,0:13:05.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Punggung yang luasnya tidak terkira.
Dialogue: 0,0:13:05.14,0:13:08.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tangan kecil Momiji tidak akan cukup\Nuntuk memijatnya!
Dialogue: 0,0:13:08.66,0:13:12.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau tidak harus dikerahkan,\Ntenaga penuh Momiji!
Dialogue: 0,0:13:12.14,0:13:14.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teknik Pemungkas: Pijatan Dahi!
Dialogue: 0,0:13:14.77,0:13:17.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Badan Kak Utsukushisugi\Nsama sekali tidak ada yang kaku, ya.
Dialogue: 0,0:13:17.90,0:13:20.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelihatannya sudah dirawat dengan teliti.
Dialogue: 0,0:13:20.53,0:13:22.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ehem, tentu saja!
Dialogue: 0,0:13:22.99,0:13:26.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekakuan otot itu musuh kecantikan,\Ntentu sudah kurawat.
Dialogue: 0,0:13:26.28,0:13:29.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau pijat refleksi kaki\Nyang bermanfaat bagi kecantikan?
Dialogue: 0,0:13:29.93,0:13:32.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja aku mau!
Dialogue: 0,0:13:32.11,0:13:34.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau sakit, tolong bilang, ya.
Dialogue: 0,0:13:35.42,0:13:37.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sa-Sama sekali tidak sakit...
Dialogue: 0,0:13:37.94,0:13:39.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan kamu lanjutkan saja...
Dialogue: 0,0:13:39.92,0:13:42.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Mimimi memang luar biasa!
Dialogue: 0,0:13:42.18,0:13:46.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jelas sekali kalau kesakitan,\Ntapi pura-pura kuat demi kecantikan!
Dialogue: 0,0:13:46.44,0:13:48.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal jelas kalau dia kesakitan sekali!
Dialogue: 0,0:13:48.69,0:13:51.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berjuanglah, Kak Mimimi!
Dialogue: 0,0:13:51.33,0:13:53.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, segini masih tahan, ya?
Dialogue: 0,0:13:53.32,0:13:54.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar Momiji tekan lebih kuat.
Dialogue: 0,0:13:54.81,0:13:56.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Te-Tentu saja, aduh!
Dialogue: 0,0:13:57.37,0:13:59.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Glek!
Dialogue: 0,0:13:59.19,0:14:00.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kecantikan...
Dialogue: 0,0:14:00.36,0:14:01.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Kak Inda?
Dialogue: 0,0:14:01.44,0:14:05.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu-Bukannya aku tertarik dengan\Npijatan atau semacamnya, ya!
Dialogue: 0,0:14:05.78,0:14:07.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kaku karena malu-malu kucing, ya?
Dialogue: 0,0:14:07.23,0:14:09.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum pernah kudengar\Nada otot kaku macam itu!
Dialogue: 0,0:14:09.47,0:14:13.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Otot orang yang malu-malu kucing\Nselalu kaku karena terus menolak jujur.
Dialogue: 0,0:14:13.85,0:14:17.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semakin parah kekakuan orangnya,\Nkalau titik refleksi ini ditekan...
Dialogue: 0,0:14:20.08,0:14:23.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}nanti akan menjerit nikmat dengan jujur.
Dialogue: 0,0:14:23.07,0:14:24.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Barusan itu apa?!
Dialogue: 0,0:14:24.73,0:14:26.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba kamu tekan beruntun.
Dialogue: 0,0:14:28.43,0:14:29.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tekan yang lama.
Dialogue: 0,0:14:31.32,0:14:32.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tekan beruntun dengan cepat.
Dialogue: 0,0:14:36.46,0:14:38.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, sudah lama tidak melihatnya.
Dialogue: 0,0:14:38.25,0:14:43.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senyumnya seolah menemukan cara baru\Nmemainkan mainan kesukaannya itu.
Dialogue: 0,0:14:45.36,0:14:48.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedangkan otot Kak Rentaro kaku\Nkarena sering cenat-cenut.
Dialogue: 0,0:14:48.80,0:14:51.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Otot I am kaku dari Amerika!
Dialogue: 0,0:14:51.46,0:14:53.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong jangan Ibu diagnosis asal begitu.
Dialogue: 0,0:14:53.79,0:14:57.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Badan Bu Naddy tidak ada yang kaku.
Dialogue: 0,0:14:58.04,0:15:00.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena I am setiap hari freedom!
Dialogue: 0,0:15:00.62,0:15:02.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}No menahan diri, itulah justice!
Dialogue: 0,0:15:02.52,0:15:04.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yakin orang dewasa mau begitu, nanoda?
Dialogue: 0,0:15:04.76,0:15:07.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kusuri saja bisa menahan pipis, nanoda.
Dialogue: 0,0:15:07.74,0:15:09.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I am mau kencing.
Dialogue: 0,0:15:09.26,0:15:13.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya sudah, Bu Naddy akan Momiji beri\Npijat refleksi kaki untuk kecantikan.
Dialogue: 0,0:15:13.14,0:15:14.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, sakit!
Dialogue: 0,0:15:14.05,0:15:17.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Momi, apa aku juga boleh\Nminta dipijat seperti itu?
Dialogue: 0,0:15:19.09,0:15:24.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, daripada pijat refleksi kaki,\NKak Suto harus segera dipijat untuk nyeri otot!
Dialogue: 0,0:15:24.64,0:15:26.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ototmu sedang menangis kesakitan!
Dialogue: 0,0:15:26.96,0:15:27.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?!
Dialogue: 0,0:15:27.40,0:15:30.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa Kakak bisa tenang saja begitu?
Dialogue: 0,0:15:30.41,0:15:34.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan otot hancur lebur seperti itu,\Nharusnya terasa sangat menyakitkan.
Dialogue: 0,0:15:35.28,0:15:37.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyeri ototku tidak usah diobati...
Dialogue: 0,0:15:37.33,0:15:37.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:15:37.93,0:15:42.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai seorang pemijat, tidak boleh\Nmembiarkan otot yang meminta tolong!
Dialogue: 0,0:15:43.17,0:15:44.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tu-Tunggu dulu!
Dialogue: 0,0:15:47.08,0:15:49.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyeri ototku hilang!
Dialogue: 0,0:15:49.17,0:15:51.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masokhis tiada tanding itu\Nternyata punya kelemahan ini?!
Dialogue: 0,0:15:51.80,0:15:54.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Jadi dia ini mayat hidup?"
Dialogue: 0,0:15:54.00,0:15:57.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tipe monster yang kena dampak\Ndari sihir penyembuhan.
Dialogue: 0,0:15:58.42,0:16:01.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar Momiji beri pijat refleksi kaki\Nyang Kakak mau, ya.
Dialogue: 0,0:16:01.04,0:16:03.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sakit!
Dialogue: 0,0:16:03.40,0:16:05.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, puas sekali memijat.
Dialogue: 0,0:16:05.57,0:16:08.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sensasi memijat kalian sangatlah lembut.
Dialogue: 0,0:16:08.43,0:16:10.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Momi, terima kasih, dado.
Dialogue: 0,0:16:10.44,0:16:12.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biarkan aku memanggilmu juru selamat!
Dialogue: 0,0:16:12.59,0:16:15.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong biarkan kami membalas dengan sesuatu.
Dialogue: 0,0:16:15.31,0:16:17.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:16:17.08,0:16:20.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau itu ceritanya,\NMomiji sangat menyukai sensasi sentuhan.
Dialogue: 0,0:16:20.65,0:16:25.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan senang kalau diperbolehkan meremas\Nbagian badan kalian yang tidak kena pijatan.
Dialogue: 0,0:16:25.65,0:16:27.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenyal sekali.
Dialogue: 0,0:16:27.49,0:16:29.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kencang sekali.
Dialogue: 0,0:16:29.07,0:16:30.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenyal sekali.
Dialogue: 0,0:16:32.02,0:16:34.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gonta-ganti meremas\Ntiga pipi bocil loli sesuka hati!
Dialogue: 0,0:16:34.73,0:16:36.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan disebut mirip permen loli begitu.
Dialogue: 0,0:16:37.97,0:16:39.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu suka sama mama?
Dialogue: 0,0:16:39.78,0:16:40.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:16:40.47,0:16:41.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau diajak nikah?
Dialogue: 0,0:16:41.80,0:16:42.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak.
Dialogue: 0,0:16:45.51,0:16:47.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau berkenan, silakan cubit pipiku.
Dialogue: 0,0:16:47.68,0:16:51.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tangan Kak Meido begitu kencang dan mulus.
Dialogue: 0,0:16:55.84,0:16:57.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Teknik kuncian siku judo?!
Dialogue: 0,0:16:57.88,0:17:00.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enyak, enyak...
Dialogue: 0,0:17:00.37,0:17:03.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perut yang anehnya tidak gendut\Nmeski makan sebanyak apa pun.
Dialogue: 0,0:17:03.42,0:17:05.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sensasi sentuhannya seperti Kirby.
Dialogue: 0,0:17:05.77,0:17:07.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang pernah menyentuh Kirby?
Dialogue: 0,0:17:07.74,0:17:11.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Momiji sebenarnya sangat penasaran\Ndengan dada Yasashiki yang berisi.
Dialogue: 0,0:17:11.25,0:17:12.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Da-Dado?!
Dialogue: 0,0:17:12.51,0:17:17.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulusnya lengan atas yang mengintip dari\Nlengan baju itu sangat membuat penasaran.
Dialogue: 0,0:17:17.08,0:17:18.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dado?
Dialogue: 0,0:17:20.06,0:17:22.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan tetek saja yang besar,\Nlengannya juga besar!
Dialogue: 0,0:17:23.50,0:17:27.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Utsukushisugi dan Kak Eiai\Npunya kaki yang ramping dan panjang.
Dialogue: 0,0:17:27.28,0:17:29.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Area absolut paha yang bercahaya
Dialogue: 0,0:17:29.90,0:17:32.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan stoking hitam legam\Nseolah melahap segalanya.
Dialogue: 0,0:17:32.85,0:17:35.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paha yang bagaikan cahaya dan kegelapan.
Dialogue: 0,0:17:35.42,0:17:38.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Izinkan Momiji merasakannya sekaligus.
Dialogue: 0,0:17:38.17,0:17:41.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perang suci cahaya dan kegelapan!
Dialogue: 0,0:17:41.49,0:17:43.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nikmatilah sesukamu.
Dialogue: 0,0:17:44.08,0:17:46.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedangkan Kak Inda dan Kak Suto.
Dialogue: 0,0:17:46.18,0:17:49.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak ada yang bisa kamu\Nremas dariku, lho.
Dialogue: 0,0:17:49.93,0:17:52.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa bilang tidak ada yang bisa\Nkau remas dariku?!
Dialogue: 0,0:17:52.30,0:17:54.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Momiji tidak bilang apa-apa, lho.
Dialogue: 0,0:17:54.55,0:17:57.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong izinkan pantat kalian\Nyang montok itu...
Dialogue: 0,0:17:58.80,0:18:03.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski sikap Kakak kasar dan malu-malu kucing,\Ntapi pantatmu sangat jujur dan lembut.
Dialogue: 0,0:18:03.56,0:18:05.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be-Berisik kamu!
Dialogue: 0,0:18:06.17,0:18:08.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pantatku jujur?
Dialogue: 0,0:18:08.26,0:18:10.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin Rentaro ikut tahu soal ini!
Dialogue: 0,0:18:11.13,0:18:12.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak ekskul olahraga memang hebat.
Dialogue: 0,0:18:12.94,0:18:15.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pantat indah yang kencang dan montok.
Dialogue: 0,0:18:15.07,0:18:18.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sudah kulatih, diremas kuat-kuat\Nsampai robek pun boleh, kok.
Dialogue: 0,0:18:18.05,0:18:19.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu, terima kasih.
Dialogue: 0,0:18:19.82,0:18:21.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Come on!
Dialogue: 0,0:18:21.71,0:18:25.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baju gadis koboi Bu Naddy membuat\Nbagian bawah jadi menggoda.
Dialogue: 0,0:18:25.72,0:18:30.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bolehkah Momiji menyentuh\Ncelah antara pantat dan paha Ibu?!
Dialogue: 0,0:18:30.46,0:18:33.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ok, ok, lakukan saja dengan freedom!
Dialogue: 0,0:18:33.98,0:18:36.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perjanjian Perdamaian Pantat dan Paha!
Dialogue: 0,0:18:36.72,0:18:41.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Inikah perpaduan pantat dan paha\Nyang telah diakui dunia?
Dialogue: 0,0:18:41.47,0:18:43.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}You teruskan saja seperti itu...
Dialogue: 0,0:18:43.42,0:18:45.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Free, lakukanlah lebih freedom lagi!
Dialogue: 0,0:18:45.98,0:18:49.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Amerika tidak pernah menolak come on!
Dialogue: 0,0:18:49.39,0:18:51.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau benar-benar malu, lho.
Dialogue: 0,0:18:52.16,0:18:53.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang...
Dialogue: 0,0:18:55.62,0:18:58.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saatnya masuk ke hidangan utama.
Dialogue: 0,0:18:59.72,0:19:02.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sensasi remasan yang begitu luar biasa!
Dialogue: 0,0:19:02.46,0:19:04.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seberapa luar biasa?
Dialogue: 0,0:19:04.51,0:19:06.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelembutannya begitu mengejutkan.
Dialogue: 0,0:19:06.94,0:19:09.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ditambah sensasi kenyalnya ini...
Dialogue: 0,0:19:09.14,0:19:09.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jariku...
Dialogue: 0,0:19:09.82,0:19:12.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, saking besarnya,\Ntanganku sampai terbenam!
Dialogue: 0,0:19:12.54,0:19:17.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu dengar itu, Rentaro?!\NPenilaian bintang 5 dari dadaku!
Dialogue: 0,0:19:17.31,0:19:19.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti kamu jadi ingin merasakannya sendiri!
Dialogue: 0,0:19:19.89,0:19:23.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang Momiji bisa akrab dengan\NHakari dan yang lainnya.
Dialogue: 0,0:19:23.56,0:19:25.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perasaan yang tidak sampai.
Dialogue: 0,0:19:26.82,0:19:28.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Itu...
Dialogue: 0,0:19:29.53,0:19:32.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gerbang dari surga, heaven's gate!
Dialogue: 0,0:19:36.94,0:19:41.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Su-Sungguh dunia yang begitu hangat,\Nnyaman, lembut dan empuk...
Dialogue: 0,0:19:41.62,0:19:43.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini pasti adalah surga!
Dialogue: 0,0:19:43.45,0:19:45.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau kamu cium juga boleh, lho!
Dialogue: 0,0:19:45.57,0:19:48.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Momiji cuma ingin\Nmerasakan sensasi sentuhannya.
Dialogue: 0,0:19:53.96,0:19:57.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedangkan sensasi milik Kak Kakure\Nberbeda dari kedua Hanazono.
Dialogue: 0,0:19:57.16,0:19:59.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu besar dan empuk.
Dialogue: 0,0:19:59.61,0:20:01.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak!
Dialogue: 0,0:20:03.34,0:20:05.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maafkan aku...
Dialogue: 0,0:20:05.48,0:20:10.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya aku ingin membiarkanmu\Nmenyentuhku sebagai balasan sudah dipijat.
Dialogue: 0,0:20:10.81,0:20:13.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, saat merasa malu,\Naku pasti bersembunyi.
Dialogue: 0,0:20:13.89,0:20:15.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa, jangan dipikirkan.
Dialogue: 0,0:20:15.86,0:20:18.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di mana pun Kakak sembunyi.
Dialogue: 0,0:20:18.07,0:20:21.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti akan Momiji kejar dan remas\Nmeski hingga ke ujung dunia.
Dialogue: 0,0:20:23.58,0:20:25.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mominator!
Dialogue: 0,0:20:28.09,0:20:29.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kali ini sembunyi ke mana?!
Dialogue: 0,0:20:29.80,0:20:32.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daku akan ikut bantu mencari Meme.
Dialogue: 0,0:20:32.61,0:20:34.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Sialan, hilang ke mana dia."
Dialogue: 0,0:20:34.84,0:20:38.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah, mereka semua kelihatan\Nsudah bisa akrab.
Dialogue: 0,0:20:38.35,0:20:41.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kak Momi, di sebelah sana!
Dialogue: 0,0:20:41.09,0:20:43.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}La-Lagi-lagi aku malah sembunyi...
Dialogue: 0,0:20:43.90,0:20:46.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kupinjamkan pantatku kapan pun kau mau.
Dialogue: 0,0:20:48.77,0:20:53.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak boleh bersembunyi!
Dialogue: 0,0:20:53.58,0:20:57.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sudah menyembuhkan bahuku\Nyang kaku separah itu!
Dialogue: 0,0:20:57.72,0:21:00.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak boleh bersembunyi!
Dialogue: 0,0:21:00.12,0:21:01.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan Momiji remas!
Dialogue: 0,0:21:04.82,0:21:06.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, tetap saja aku malu!
Dialogue: 0,0:21:09.78,0:21:12.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kamu tidak apa-apa, Momiji?
Dialogue: 0,0:21:12.19,0:21:12.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh?
Dialogue: 0,0:21:15.46,0:21:17.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:21:17.05,0:21:22.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Momiji belum menyentuh Kak Rentaro\Nsebagai balasan telah memijat.
Dialogue: 0,0:21:23.76,0:21:25.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku ini cowok.
Dialogue: 0,0:21:25.71,0:21:29.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya tidak ada bagian lembut\Nyang bisa disukai Momiji...
Dialogue: 0,0:21:29.98,0:21:33.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan seorang cowok\Nakan tetap lembut di bagian sini.
Dialogue: 0,0:21:44.42,0:21:45.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini...
Dialogue: 0,0:21:45.95,0:21:50.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan Momiji yang menyukai sensasi sentuhan\Nbelum pernah merasakan
Dialogue: 0,0:21:50.33,0:21:52.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan tidak bisa menjelaskan sensasi ini...
Dialogue: 0,0:21:52.50,0:21:53.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak tahan!
Dialogue: 0,0:21:53.63,0:21:56.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kenapa malah kau cium ganas begitu?!
Dialogue: 0,0:21:56.54,0:21:59.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kusuri juga mau mencium\Ndengan ganas, nanoda!
Dialogue: 0,0:21:59.13,0:22:01.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I am juga mau kiss yang ganas!
Dialogue: 0,0:22:01.89,0:22:03.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Aku juga!\N- Aku juga!
Dialogue: 0,0:22:03.99,0:22:06.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemudian mereka semua\Nberciuman dengan ganas.
Dialogue: 0,0:23:37.02,0:23:39.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, sudah jam segini!
Dialogue: 0,0:23:39.11,0:23:40.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita semua harus pulang!
Dialogue: 0,0:23:40.24,0:23:41.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu benar...
Dialogue: 0,0:23:41.49,0:23:45.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, ayo kita lakukan sekali lagi\Nuntuk mengakhiri episode ini.
Dialogue: 0,0:23:45.02,0:23:46.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Iya!\N- Iya!
