Dialogue: 0,0:01:07.71,0:01:08.99,sign,,0000,0000,0000,,"SEKITAR SEPEKAN SEBELUM ACARA DIGELAR"
Dialogue: 0,0:01:13.77,0:01:15.73,sign,,0000,0000,0000,,"TKG48 SEMUANYA PATAH TULANG!!"
Dialogue: 0,0:04:26.87,0:04:29.00,sign,,0000,0000,0000,,STUDIO DANSA
Dialogue: 0,0:07:03.99,0:07:05.90,sign,,0000,0000,0000,,KELUARGA RENTARO
Dialogue: 0,0:11:12.98,0:11:15.24,sign,,0000,0000,0000,,HARI FESTIVAL SEKOLAH
Dialogue: 0,0:00:11.99,0:00:13.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam hidup!
Dialogue: 0,0:00:13.36,0:00:16.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makin banyak kesenangannya...
Dialogue: 0,0:00:16.50,0:00:18.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}makin bagus!
Dialogue: 0,0:00:18.00,0:00:19.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jesus!
Dialogue: 0,0:00:23.42,0:00:25.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kehidupan yang abadi!
Dialogue: 0,0:00:25.71,0:00:27.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:00:28.04,0:00:29.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oleh karena itu!
Dialogue: 0,0:00:29.67,0:00:33.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Universitas Yayasan Ohananomitsu\Ndan sekolah-sekolah yang terafiliasi
Dialogue: 0,0:00:33.55,0:00:35.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan mengadakan Festival Sekolah Musim Semi!
Dialogue: 0,0:00:35.80,0:00:39.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Festival sekolah musim semi katamu?!\NMau diadakan tiap musim apa?!
Dialogue: 0,0:00:39.46,0:00:42.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, memang ini masih musim semi?
Dialogue: 0,0:00:42.90,0:00:44.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Di komiknya juga masih musim semi."
Dialogue: 0,0:00:44.70,0:00:46.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan coba tebak!
Dialogue: 0,0:00:46.04,0:00:49.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah mengundang banyak\Nartis ternama untuk tampil!
Dialogue: 0,0:00:49.59,0:00:51.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa Yonezu akan datang?!
Dialogue: 0,0:00:51.46,0:00:52.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yonezu enggak datang.
Dialogue: 0,0:00:52.57,0:00:55.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, songman dengan soul Amerika...
Dialogue: 0,0:00:55.76,0:00:58.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kanji "Yone" punya Yonezu\Nbukan diambil dari kanji Amerika.
Dialogue: 0,0:00:58.71,0:01:01.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya Ibunda mengundang siapa?
Dialogue: 0,0:01:01.20,0:01:05.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Grup idola terkenal, TKG48!
Dialogue: 0,0:01:07.71,0:01:08.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon maaf!
Dialogue: 0,0:01:08.99,0:01:13.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}TKG48 ada yang tersandung saat latihan tari,\Nlalu semuanya ikut jatuh dan patah tulang!
Dialogue: 0,0:01:13.77,0:01:15.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin bisa begitu?!
Dialogue: 0,0:01:16.05,0:01:17.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oleh karena itu...
Dialogue: 0,0:01:17.73,0:01:20.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian mau coba jadi idola, tidak?
Dialogue: 0,0:01:20.36,0:01:21.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?!
Dialogue: 0,0:01:35.87,0:01:41.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}100 Pacar yang Sungguh Sangat Amat\NBenar-benar Mencintaimu Musim Ketiga
Dialogue: 0,0:02:52.48,0:02:54.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah tidak ada waktu\Nsampai acaranya digelar,
Dialogue: 0,0:02:54.82,0:02:57.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi sulit kalau mau undang grup idola lain.
Dialogue: 0,0:02:57.07,0:03:00.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kupikir untuk mengisi kekosongan.\NMau, ya?
Dialogue: 0,0:03:00.12,0:03:02.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kenapa harus kami yang jadi idola?!
Dialogue: 0,0:03:02.79,0:03:04.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Naskahnya terlalu asal!
Dialogue: 0,0:03:05.08,0:03:08.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kubuat semuanya terpesona\Ndengan kecantikanku!
Dialogue: 0,0:03:08.42,0:03:10.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bernyanyi dan menari kedengarannya seru!
Dialogue: 0,0:03:10.71,0:03:12.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika itu perintah Nyonya Hahari.
Dialogue: 0,0:03:12.34,0:03:17.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau orang awam atau teacher boleh jadi idola,\Ndream itu freedom!
Dialogue: 0,0:03:17.18,0:03:19.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo sampaikan itu pada school people!
Dialogue: 0,0:03:19.93,0:03:22.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian ini, pikir dulu baik-baik...
Dialogue: 0,0:03:22.51,0:03:25.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menari dan menyanyi katanya\Ncukup menguras stamina.
Dialogue: 0,0:03:25.06,0:03:26.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya latihan yang bagus!
Dialogue: 0,0:03:26.69,0:03:28.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bisa mendapat kenangan baru.
Dialogue: 0,0:03:28.98,0:03:31.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau butuh bantuan,\Nsaya juga akan membantu!
Dialogue: 0,0:03:31.65,0:03:32.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, tunggu!
Dialogue: 0,0:03:32.44,0:03:35.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ini terlalu mendadak, jelas tidak akan sempat!\N- Kalian bernyanyi dan menari, pasti akan sangat imut!
Dialogue: 0,0:03:35.82,0:03:38.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bu-Bukannya aku tertarik, tapi biar kucoba!
Dialogue: 0,0:03:38.36,0:03:40.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, Japanese memang mudah dirayu.
Dialogue: 0,0:03:40.32,0:03:41.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga ikut!
Dialogue: 0,0:03:41.74,0:03:44.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kalau semuanya mau, aku juga...
Dialogue: 0,0:03:45.00,0:03:47.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelihatannya ini akan sangat menyenangkan!
Dialogue: 0,0:03:47.79,0:03:50.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hahari Woman juga akan ikut, bukan?
Dialogue: 0,0:03:51.04,0:03:56.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak, aku cuma senang karena\Nmungkin bisa lihat kalian pakai baju idola.
Dialogue: 0,0:03:56.59,0:03:58.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata memang itu rencananya!
Dialogue: 0,0:03:58.26,0:04:00.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti sekarang kamu wajib\Nmuncul di panggung.
Dialogue: 0,0:04:00.72,0:04:04.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Bila tidak mengganggu,\Naku juga ingin ikut serta."
Dialogue: 0,0:04:04.14,0:04:07.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kalau bisa, aku juga ingin ikut...
Dialogue: 0,0:04:07.89,0:04:10.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kalau bisa di paling belakang...
Dialogue: 0,0:04:10.98,0:04:12.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian semua...
Dialogue: 0,0:04:12.19,0:04:14.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin kalian pasti...
Dialogue: 0,0:04:14.07,0:04:16.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti akan jadi pertunjukan yang terbaik!
Dialogue: 0,0:04:16.39,0:04:18.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasa harumu itu harusnya buat hari-H.
Dialogue: 0,0:04:18.61,0:04:22.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kubantu kalian sekuat tenaga!
Dialogue: 0,0:04:22.12,0:04:24.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keluarga Rentaro!\NAyo berjuang!
Dialogue: 0,0:04:24.87,0:04:26.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Iya!
Dialogue: 0,0:04:29.00,0:04:32.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini Pelatih Kuori Tina yang akan\Nmemberi kita kursus teknis.
Dialogue: 0,0:04:32.54,0:04:33.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salam kenal.
Dialogue: 0,0:04:33.25,0:04:35.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mantan idola top yang itu?!
Dialogue: 0,0:04:35.55,0:04:39.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang katanya kalau dilatih beliau,\Npasti akan sukses itu?!
Dialogue: 0,0:04:39.26,0:04:43.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian tahu apa yang paling penting\Nbagi seorang idola?
Dialogue: 0,0:04:43.26,0:04:43.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja ke...
Dialogue: 0,0:04:43.72,0:04:45.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kualitas dari performa!
Dialogue: 0,0:04:45.76,0:04:51.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pernah meraih puncak dunia idola\Nmenggunakan kualitas tinggi sebagai senjata.
Dialogue: 0,0:04:51.02,0:04:51.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang!
Dialogue: 0,0:04:51.77,0:04:53.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo mulai latihan yang keras-keras!
Dialogue: 0,0:04:53.86,0:04:55.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:04:55.15,0:04:56.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baik.
Dialogue: 0,0:04:56.53,0:05:02.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kualitas!
Dialogue: 0,0:05:02.78,0:05:04.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka berdua berbakat.
Dialogue: 0,0:05:04.58,0:05:08.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baru mencoba sebentar, bisa meniru\Npersis contoh dengan kualitas tinggi.
Dialogue: 0,0:05:08.16,0:05:10.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini perintah Nyonya Hahari.
Dialogue: 0,0:05:10.41,0:05:15.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, yang ini gerakannya terasa\Nbegitu teliti hingga ke ujung jari.
Dialogue: 0,0:05:15.34,0:05:16.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kualitas yang cantik.
Dialogue: 0,0:05:16.67,0:05:19.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka berdua juga makin bagus\Nseiring jalannya latihan,
Dialogue: 0,0:05:19.63,0:05:21.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}selain itu staminanya luar biasa.
Dialogue: 0,0:05:21.43,0:05:22.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kualitas stamina.
Dialogue: 0,0:05:22.93,0:05:24.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, dibanding mereka...
Dialogue: 0,0:05:24.68,0:05:26.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kualitas taman kanak-kanak!
Dialogue: 0,0:05:26.93,0:05:29.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu kursus teknis?!\NMemangnya kismis?!
Dialogue: 0,0:05:29.68,0:05:31.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kualitas tenaganya ampas!\N- Sekalian roti isi mentega!
Dialogue: 0,0:05:31.44,0:05:32.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, berat.
Dialogue: 0,0:05:32.39,0:05:34.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayunannya bikin sakit!
Dialogue: 0,0:05:34.19,0:05:35.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau copot rasanya!
Dialogue: 0,0:05:35.15,0:05:37.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kualitasnya di payudara!
Dialogue: 0,0:05:37.07,0:05:39.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kualitas tarian Jepang!
Dialogue: 0,0:05:40.36,0:05:41.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih kurang...
Dialogue: 0,0:05:41.53,0:05:43.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih sangat kurang!
Dialogue: 0,0:05:43.32,0:05:45.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yes...
Dialogue: 0,0:05:45.20,0:05:46.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus, kalian semua!
Dialogue: 0,0:05:46.74,0:05:48.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini, aku bawa handuk dan minum.
Dialogue: 0,0:05:48.91,0:05:50.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya latihan menyanyi.
Dialogue: 0,0:05:50.91,0:05:52.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo teruskan dengan keras!
Dialogue: 0,0:05:52.46,0:05:55.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♫ Love love, aku akan selalu
Dialogue: 0,0:05:55.79,0:05:58.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- ♫ Cenat-cenut, mencintaimu\N- Kalian yang di sana, jangan berisik!
Dialogue: 0,0:05:58.59,0:06:02.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♫ Kuberkhayal
Dialogue: 0,0:06:02.09,0:06:04.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu yang lebih keras lagi!
Dialogue: 0,0:06:04.59,0:06:07.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♫ Love love, karena aku sangat mencintaimu!
Dialogue: 0,0:06:07.76,0:06:09.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bukan opera!
Dialogue: 0,0:06:10.72,0:06:12.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini juga bukan musik Enka!
Dialogue: 0,0:06:12.35,0:06:13.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu ini kenapa, sih?
Dialogue: 0,0:06:13.89,0:06:17.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal orang Amerika, tapi tarian, nyanyian,\Ndan semua kelakuanmu bergaya Jepang?!
Dialogue: 0,0:06:17.73,0:06:19.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}So-Sorry!
Dialogue: 0,0:06:19.53,0:06:22.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak child, I am sudah dilatih...
Dialogue: 0,0:06:22.24,0:06:26.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal orang Amerika...
Dialogue: 0,0:06:26.57,0:06:27.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa malah tersipu?!
Dialogue: 0,0:06:27.74,0:06:32.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kualitas!
Dialogue: 0,0:06:32.16,0:06:33.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau copot!
Dialogue: 0,0:06:33.37,0:06:34.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bakal copot!
Dialogue: 0,0:06:34.21,0:06:36.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah copot!
Dialogue: 0,0:06:36.38,0:06:37.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah tidak kuat...
Dialogue: 0,0:06:37.71,0:06:41.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ini bukan budak payuda...
Dialogue: 0,0:06:43.26,0:06:44.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo berdiri!
Dialogue: 0,0:06:45.72,0:06:47.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kak Mei?!
Dialogue: 0,0:06:47.05,0:06:48.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}He-Hentikan, Mei!
Dialogue: 0,0:06:48.85,0:06:50.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku masih kuat lanjut, Pelatih!
Dialogue: 0,0:07:22.42,0:07:24.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang berbakat.
Dialogue: 0,0:07:24.17,0:07:25.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang punya stamina.
Dialogue: 0,0:07:25.92,0:07:27.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang mampu asal diberi makan.
Dialogue: 0,0:07:27.68,0:07:29.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang tipe kutu buku.
Dialogue: 0,0:07:29.43,0:07:31.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang tipe sapi perah.
Dialogue: 0,0:07:31.18,0:07:32.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berjiwa orang Jepang.
Dialogue: 0,0:07:32.93,0:07:35.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kualitas adalah segalanya bagi idola.
Dialogue: 0,0:07:35.56,0:07:36.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo berjuang sama-sama!
Dialogue: 0,0:07:36.94,0:07:38.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:07:40.56,0:07:42.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Segalanya harus berkualitas.
Dialogue: 0,0:07:42.86,0:07:44.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo berdiri!
Dialogue: 0,0:07:44.07,0:07:46.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimanapun kualitas harus terjaga.
Dialogue: 0,0:07:47.70,0:07:49.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah cukup, pulang sana!
Dialogue: 0,0:07:49.57,0:07:52.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuori, raihlah yang lebih tinggi lagi!
Dialogue: 0,0:07:53.08,0:07:54.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik...
Dialogue: 0,0:07:54.33,0:07:58.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti itulah caraku naik ke puncak.
Dialogue: 0,0:07:58.54,0:08:02.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agar mereka bisa lebih bersinar lagi...
Dialogue: 0,0:08:02.21,0:08:04.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian berenam, beristirahatlah.
Dialogue: 0,0:08:10.43,0:08:14.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita masih belum bisa\Nmelakukannya dengan benar, ya?
Dialogue: 0,0:08:14.22,0:08:17.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal sudah tidak ada day\Nsampai school festival.
Dialogue: 0,0:08:17.77,0:08:21.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maaf, gara-gara aku menghambat semuanya.
Dialogue: 0,0:08:21.40,0:08:23.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, saya juga minta maaf.
Dialogue: 0,0:08:23.48,0:08:27.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Kalau begini, mana mungkin\Nkita bisa melakukannya di hari-H."
Dialogue: 0,0:08:27.86,0:08:30.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tampil jelek di depan orang-orang...
Dialogue: 0,0:08:30.03,0:08:33.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti mereka yang sudah bisa\Nakan ikut jadi tertawaan.
Dialogue: 0,0:08:34.15,0:08:37.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin sebaiknya kita tidak ikut tampil.
Dialogue: 0,0:08:37.75,0:08:42.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo coba diskusikan ini\Ndengan Pelatih Kuori dan lainnya.
Dialogue: 0,0:08:42.00,0:08:46.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ingin pertunjukannya sukses,\Nkalian harus tampil bertujuh saja.
Dialogue: 0,0:08:46.26,0:08:51.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kualitas kemampuan kalian sudah cukup\Nuntuk memesona para penonton.
Dialogue: 0,0:08:51.01,0:08:55.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kalau ada mereka berenam,\Nusaha dan bakat kalian akan sia-sia.
Dialogue: 0,0:08:55.31,0:08:59.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian tampil bertujuh adalah satu-satunya\Ncara untuk menyempurnakan pertunjukan.
Dialogue: 0,0:09:00.14,0:09:01.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paham, ya.
Dialogue: 0,0:09:03.86,0:09:05.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kami tidak mau!
Dialogue: 0,0:09:06.98,0:09:10.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asal berjuang mati-matian,\Ntidak ada yang mustahil!
Dialogue: 0,0:09:10.24,0:09:12.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampil bersama semuanya\Npasti lebih menyenangkan!
Dialogue: 0,0:09:12.82,0:09:16.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ingin membuat kenangan,\Nharus dilakukan bersama semuanya.
Dialogue: 0,0:09:16.37,0:09:20.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keberadaan Nyonya Hahari saja\Nsudah membuat bersyukur.
Dialogue: 0,0:09:20.25,0:09:22.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja keras dengan bakat\Nakan membuahkan hasil,
Dialogue: 0,0:09:22.87,0:09:24.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}juga berlaku untuk mereka berenam.
Dialogue: 0,0:09:25.00,0:09:26.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian ini paham, tidak?!
Dialogue: 0,0:09:26.34,0:09:29.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka bukan hanya akan\Nmembuat kualitas kalian sia-sia,
Dialogue: 0,0:09:29.34,0:09:31.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kalian juga akan jadi tertawaan!
Dialogue: 0,0:09:31.51,0:09:34.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kami juga melakukan kesalahan.
Dialogue: 0,0:09:34.09,0:09:36.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, mereka tidak menyalahkan kami.
Dialogue: 0,0:09:36.10,0:09:40.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin bisa menyalahkan mereka\Nyang justru malah menyemangati kami.
Dialogue: 0,0:09:40.52,0:09:46.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya kami bisa sampai di sini,\Nkarena semuanya sudah berjuang?
Dialogue: 0,0:09:47.27,0:09:48.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan itu yang kupikirkan, ya!
Dialogue: 0,0:09:48.82,0:09:50.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enggak ada habisnya.
Dialogue: 0,0:09:50.40,0:09:51.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kalian mau tampil
Dialogue: 0,0:09:51.53,0:09:55.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan kualitas asal-asalan begitu,\Naku berhenti jadi pelatih!
Dialogue: 0,0:09:55.28,0:09:56.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dimengerti.
Dialogue: 0,0:09:56.49,0:09:58.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bimbang dulu, kek!
Dialogue: 0,0:09:58.04,0:10:01.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudahlah, sesuka kalian saja!
Dialogue: 0,0:10:01.29,0:10:02.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bikin kaget saja!
Dialogue: 0,0:10:02.75,0:10:04.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian dari tadi di sini?!
Dialogue: 0,0:10:07.59,0:10:09.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian semua?!
Dialogue: 0,0:10:09.42,0:10:12.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan kalian dengar\Nsemua obrolan tadi?!
Dialogue: 0,0:10:12.30,0:10:16.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Kami bisa sampai di sini karena\Nsemuanya sudah berjuang."
Dialogue: 0,0:10:16.30,0:10:17.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya begitu?
Dialogue: 0,0:10:17.30,0:10:18.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan, sialan!
Dialogue: 0,0:10:18.68,0:10:20.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, sekarang bagaimana?
Dialogue: 0,0:10:20.35,0:10:21.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tanpa pelatih...
Dialogue: 0,0:10:21.39,0:10:25.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kalian tidak keberatan,\Nboleh tidak kalau aku yang melatih saja?
Dialogue: 0,0:10:27.19,0:10:31.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menonton video latihan kalian\Nsampai pemutar DVD-ku terbakar.
Dialogue: 0,0:10:31.69,0:10:33.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belum pernah dengar kejadian begitu.
Dialogue: 0,0:10:33.82,0:10:35.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi dapat ide koreografi
Dialogue: 0,0:10:35.49,0:10:39.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang lebih cocok dan membuat kalian bersinar.
Dialogue: 0,0:10:39.58,0:10:42.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Grup yang mahir menari\Nmembantu gerakan seluruh anggota,
Dialogue: 0,0:10:42.54,0:10:45.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bagian menyanyi diberi\Nke yang kurang jago menari.
Dialogue: 0,0:10:45.08,0:10:49.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya saja beban grup yang mahir\Nakan meningkat.
Dialogue: 0,0:10:49.09,0:10:50.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian bisa melakukannya?
Dialogue: 0,0:10:50.59,0:10:52.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tentu saja!
Dialogue: 0,0:10:52.17,0:10:55.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kami juga akan berjuang lebih keras!\N- Kami juga akan berjuang more keras!
Dialogue: 0,0:10:55.59,0:10:58.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami juga ingin berdiri di panggung\Nbersama semuanya!
Dialogue: 0,0:10:58.47,0:11:01.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kami pasti tidak akan menyerah!
Dialogue: 0,0:11:02.56,0:11:03.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baguslah!
Dialogue: 0,0:11:03.60,0:11:06.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keluarga Rentaro, ayo berjuang!
Dialogue: 0,0:11:06.48,0:11:07.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Iya!
Dialogue: 0,0:11:09.23,0:11:12.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kualitas!
Dialogue: 0,0:11:15.24,0:11:19.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih atas penampilan kalian,\NMomoirozaka46Z!
Dialogue: 0,0:11:19.37,0:11:22.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang, bintang tamu kejutan\Nselanjutnya adalah...
Dialogue: 0,0:11:22.24,0:11:23.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian semuanya...
Dialogue: 0,0:11:23.37,0:11:26.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian bekerja sangat keras\Nuntuk sampai di sini!
Dialogue: 0,0:11:26.00,0:11:28.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian semua adalah idola yang terbaik!
Dialogue: 0,0:11:28.42,0:11:30.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasa harumu itu harusnya habis tampil.
Dialogue: 0,0:11:30.38,0:11:32.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berjuanglah!\NBerjuang, kalian semua!
Dialogue: 0,0:11:32.55,0:11:35.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berikan sambutan hangat kepada\NKeluarga Rentaro!
Dialogue: 0,0:11:35.76,0:11:36.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa?
Dialogue: 0,0:11:36.47,0:11:37.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Murid dari sekolah?
Dialogue: 0,0:11:42.56,0:11:46.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♫ Love love, aku akan selalu
Dialogue: 0,0:11:46.10,0:11:48.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♫ Cenat-cenut, mencintaimu
Dialogue: 0,0:11:48.81,0:11:51.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♫ Setiap malam aku bermimpi
Dialogue: 0,0:11:51.98,0:11:53.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♫ Yay!
Dialogue: 0,0:11:53.44,0:11:55.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♫ Tentang dirimu
Dialogue: 0,0:11:56.40,0:11:58.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Imutnya!
Dialogue: 0,0:11:58.11,0:11:59.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian bersinar!
Dialogue: 0,0:11:59.87,0:12:01.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wooo!
Dialogue: 0,0:12:09.21,0:12:10.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♫ Rutinitas pagi
Dialogue: 0,0:12:10.50,0:12:15.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♫ Pertama, aku memikirkan\Ntentang dirimu, cenut
Dialogue: 0,0:12:15.17,0:12:18.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♫ Sambil makan sarapan, cenut
Dialogue: 0,0:12:18.38,0:12:20.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♫ Saat ganti baju pun, cenut
Dialogue: 0,0:12:21.39,0:12:23.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♫ Saat memakai sepatu, cenut
Dialogue: 0,0:12:23.22,0:12:24.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♫ Sambil berjalan, cenut
Dialogue: 0,0:12:24.60,0:12:27.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}♫ Perlahan kian menguat debaran cenut ini
Dialogue: 0,0:12:29.06,0:12:30.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pindah ke yang lain, yuk.
Dialogue: 0,0:12:30.73,0:12:31.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yuk.
Dialogue: 0,0:12:32.61,0:12:36.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis rambut pink, gadis yang tertutup poni,\Nsama kakak mata sipit manis sekali!
Dialogue: 0,0:12:36.36,0:12:41.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis pirang, gadis tomboi, sama yang\Nrambut hitam pendek keren banget!
Dialogue: 0,0:12:41.36,0:12:43.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis kecil seperti hewan mungil,\Nyang mulutnya seperti kucing,
Dialogue: 0,0:12:43.99,0:12:46.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sama yang berkacamata menggemaskan sekali!
Dialogue: 0,0:12:46.20,0:12:47.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini cenat-cenut!
Dialogue: 0,0:12:47.58,0:12:50.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah! Kakak cantik sekali!
Dialogue: 0,0:12:50.71,0:12:53.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis rambut perak dan kalem\Nitu keren sekali!
Dialogue: 0,0:12:53.54,0:12:56.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak rambut pink itu seksinya kebangetan!
Dialogue: 0,0:12:56.71,0:13:00.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak rambut pirang bergaya Barat itu\Ncantiknya keterlaluan!
Dialogue: 0,0:13:00.26,0:13:04.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian semua, semangat!
Dialogue: 0,0:13:06.26,0:13:09.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga, mereka cuma pemula\Ndengan persiapan seadanya.
Dialogue: 0,0:13:09.35,0:13:14.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski ada kekuatan misterius yang membuat\Nkeluarga mereka semua tidak bisa datang.
Dialogue: 0,0:13:14.06,0:13:18.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, apa mungkin sampai\Ntidak ada yang nonton begini?!
Dialogue: 0,0:13:18.03,0:13:21.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, di sana katanya ada TKG48!
Dialogue: 0,0:13:21.24,0:13:24.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada tanda tangan, salaman,\Nsampai foto berdua juga!
Dialogue: 0,0:13:24.20,0:13:26.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buruan ke sana, yuk!
Dialogue: 0,0:13:26.03,0:13:26.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon tanda tangannya!
Dialogue: 0,0:13:26.99,0:13:28.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin salaman!
Dialogue: 0,0:13:30.04,0:13:33.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya! Semua bakal dapat,\Njangan dorong-dorong, ya!
Dialogue: 0,0:13:33.79,0:13:35.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, ya.
Dialogue: 0,0:13:35.04,0:13:37.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian kupanggil padahal sedang patah tulang.
Dialogue: 0,0:13:37.50,0:13:40.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.\NPelatih Kuori, kan, mentor kami.
Dialogue: 0,0:13:41.38,0:13:46.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kuajari kalian yang bodoh, tidak tahu\Napa-apa dan sudah menolak kualitasku ini
Dialogue: 0,0:13:46.93,0:13:49.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tentang betapa kerasnya dunia idola!
Dialogue: 0,0:13:49.18,0:13:51.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak akan ada satu pun yang mau melirik
Dialogue: 0,0:13:51.48,0:13:53.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pertunjukan berkualitas rendah seperti itu.
Dialogue: 0,0:13:53.81,0:13:57.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, luar biasa!\NKalian sangat bersinar!
Dialogue: 0,0:13:57.40,0:13:59.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial, cuma beliau harapan yang tersisa!
Dialogue: 0,0:13:59.69,0:14:01.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa masih belum datang?!
Dialogue: 0,0:14:01.15,0:14:04.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin pergi mencari,\Ntapi mereka tidak bisa kutinggal!
Dialogue: 0,0:14:04.24,0:14:05.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang ada di mana, sih?!
Dialogue: 0,0:14:05.57,0:14:07.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf aku terlambat!
Dialogue: 0,0:14:07.95,0:14:09.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah?!
Dialogue: 0,0:14:09.20,0:14:10.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paman Hiro!
Dialogue: 0,0:14:10.62,0:14:13.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa Paman terluka begitu?!
Dialogue: 0,0:14:14.42,0:14:17.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ke sini, aku ditabrak truk tangki...
Dialogue: 0,0:14:17.42,0:14:20.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa Paman selalu saja\Npapasan sama truk tangki?!
Dialogue: 0,0:14:20.17,0:14:24.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untung saja ini bisa untuk bantalan,\Njadi tidak ada yang luka parah.
Dialogue: 0,0:14:24.47,0:14:26.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, Paman itu sudah terluka cukup parah.
Dialogue: 0,0:14:26.68,0:14:30.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini cuma luka lecet kalau dibanding\Nmelewatkan penampilan Chiyo!
Dialogue: 0,0:14:30.52,0:14:31.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setuju!
Dialogue: 0,0:14:31.68,0:14:33.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Langsung saja kita mulai!
Dialogue: 0,0:14:33.31,0:14:34.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke!
Dialogue: 0,0:14:34.19,0:14:37.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memeriahkan panggung bukan cuma\Ntugas para idola,
Dialogue: 0,0:14:37.48,0:14:39.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi juga tugas kami sebagai penonton.
Dialogue: 0,0:14:39.65,0:14:45.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, aku dan Paman Hiro sudah\Nberlatih menyiapkannya untuk hari ini.
Dialogue: 0,0:14:46.66,0:14:48.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Trik pesta?!
Dialogue: 0,0:14:49.16,0:14:50.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keluarga Rentaro yang terbaik!
Dialogue: 0,0:14:50.95,0:14:53.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis kacamata dan rambut kepang, semangat!
Dialogue: 0,0:14:53.75,0:14:55.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya bakal terbawa mimpi...
Dialogue: 0,0:14:55.17,0:14:56.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah!
Dialogue: 0,0:14:56.58,0:14:58.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rentaro ada banyak sekali!
Dialogue: 0,0:14:58.42,0:15:00.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan!\NTubuhku hanya ada satu!
Dialogue: 0,0:15:00.96,0:15:01.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak...
Dialogue: 0,0:15:01.96,0:15:05.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, aku dikelilingi Rentaro sebanyak ini...
Dialogue: 0,0:15:05.05,0:15:08.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang-orang akan tertarik dan\Nberkumpul pada keramaian.
Dialogue: 0,0:15:08.22,0:15:10.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Artinya, kami cukup buat keramaian!
Dialogue: 0,0:15:10.31,0:15:13.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku dan Paman Hiro masing-masing\Nberteriak dengan sepuluh orang...
Dialogue: 0,0:15:13.81,0:15:16.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}totalnya sudah terkumpul 22 orang!
Dialogue: 0,0:15:16.90,0:15:20.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka semua sudah berlatih sekeras itu.
Dialogue: 0,0:15:20.27,0:15:22.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin kubiarkan\Npertunjukan ini gagal...
Dialogue: 0,0:15:22.82,0:15:26.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mana mungkin kubiarkan ini\Ngagal jadi kenangan terindah mereka!
Dialogue: 0,0:15:26.53,0:15:29.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berjuanglah!
Dialogue: 0,0:15:37.25,0:15:38.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, sial.
Dialogue: 0,0:15:38.58,0:15:40.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah dimulai, tuh!
Dialogue: 0,0:15:40.21,0:15:42.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gara-gara kamu terlalu fokus main,\Nmalah strikeout!
Dialogue: 0,0:15:42.59,0:15:44.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf...
Dialogue: 0,0:15:44.09,0:15:47.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga Keluarga Rentaro itu\Nadalah mereka!
Dialogue: 0,0:15:47.05,0:15:50.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, gara-gara kami enggak bisa baca peta...
Dialogue: 0,0:15:50.26,0:15:53.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bisa sampai ke sini\Nkarena sorakan keras itu.
Dialogue: 0,0:15:57.98,0:16:01.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami akan menyanyikan\Nlagu kedua berjudul, "Bahtera."
Dialogue: 0,0:16:02.11,0:16:04.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selebaran?\NTapi, siapa?
Dialogue: 0,0:16:04.78,0:16:05.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa ini?
Dialogue: 0,0:16:05.86,0:16:07.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan...
Dialogue: 0,0:16:07.53,0:16:09.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rentaro...
Dialogue: 0,0:16:09.07,0:16:11.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan cuma membantu kami...
Dialogue: 0,0:16:11.83,0:16:14.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia juga menyiapkan dan\Nberlatih dengan boneka itu...
Dialogue: 0,0:16:14.41,0:16:17.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal dia sudah jadi pelatih kami...
Dialogue: 0,0:16:17.21,0:16:19.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dik Rentaro, kamu ini...
Dialogue: 0,0:16:19.83,0:16:22.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berapa yang kamu curahkan\Nuntuk pertunjukan ini?!
Dialogue: 0,0:16:22.42,0:16:25.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kami juga tidak boleh kalah!
Dialogue: 0,0:16:26.42,0:16:31.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Chiican, berjuanglah!\N- Keluarga Rentaro terbaik!
Dialogue: 0,0:16:32.64,0:16:33.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau ikut lihat?
Dialogue: 0,0:16:33.72,0:16:34.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:16:41.60,0:16:45.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kelihatannya orang-orang\Nberkumpul di panggung, lho.
Dialogue: 0,0:16:45.28,0:16:47.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah dapat tanda tangan, ke sana, yuk.
Dialogue: 0,0:16:47.28,0:16:49.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pergi sebentar.
Dialogue: 0,0:16:50.03,0:16:51.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang-orang berkumpul?
Dialogue: 0,0:16:51.66,0:16:52.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu mustahil!
Dialogue: 0,0:16:52.99,0:16:55.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kualitas penampilan mereka seperti apa?!
Dialogue: 0,0:17:52.59,0:17:55.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kualitas pemula yang benar-benar payah.
Dialogue: 0,0:17:55.43,0:17:59.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kenapa mereka terlihat sangat bersinar?
Dialogue: 0,0:18:01.02,0:18:02.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya?
Dialogue: 0,0:18:14.82,0:18:17.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inilah panggung yang sebenarnya\Ningin kunaiki...
Dialogue: 0,0:18:39.60,0:18:42.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak!
Dialogue: 0,0:18:46.65,0:18:48.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelatih? Ada apa?
Dialogue: 0,0:18:48.40,0:18:53.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Acara tanda tangannya nanti saja,\Nsekarang kalian segeralah ke panggung.
Dialogue: 0,0:18:54.07,0:18:57.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian tidak boleh jadi sepertiku.
Dialogue: 0,0:19:02.58,0:19:04.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak kapan orangnya sebanyak ini?
Dialogue: 0,0:19:04.50,0:19:06.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keimutan Chiyo memang mengerikan.
Dialogue: 0,0:19:06.21,0:19:08.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wow, Jesus!
Dialogue: 0,0:19:19.85,0:19:22.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa? Padahal aku ingin\Nmelihat mereka dengan jelas...
Dialogue: 0,0:19:22.89,0:19:24.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, air mataku tidak mau berhenti...
Dialogue: 0,0:19:24.89,0:19:27.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa mereka bersinar seterang itu...
Dialogue: 0,0:19:28.81,0:19:33.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mencintai kalian!
Dialogue: 0,0:19:52.09,0:19:53.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Huh, huh, huh, huh!\N- Yay!
Dialogue: 0,0:19:53.84,0:19:59.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yay!
Dialogue: 0,0:20:10.06,0:20:11.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus juga, ya.
Dialogue: 0,0:20:11.44,0:20:13.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, aku kaget banget.
Dialogue: 0,0:20:16.82,0:20:18.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei!
Dialogue: 0,0:20:18.70,0:20:20.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus kalian semua!
Dialogue: 0,0:20:20.20,0:20:22.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi itu sangat luar biasa!
Dialogue: 0,0:20:27.91,0:20:29.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian semua...
Dialogue: 0,0:20:44.60,0:20:46.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Eh?!
Dialogue: 0,0:20:46.18,0:20:50.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jesus Nakai, produser bertangan dingin itu\Ningin merekrut kita?!
Dialogue: 0,0:20:50.94,0:20:54.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, sepertinya beliau datang\Nke festival sekolah kemarin.
Dialogue: 0,0:20:54.82,0:20:56.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian memang luar biasa!
Dialogue: 0,0:20:58.86,0:21:01.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wow! Kalian memang Jesus!
Dialogue: 0,0:21:01.99,0:21:08.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang di kantor Jesus, di mana\Nhanya orang terpilih yang diundang masuk.
Dialogue: 0,0:21:08.12,0:21:10.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mataku tidak pernah salah.
Dialogue: 0,0:21:10.50,0:21:12.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin kalian akan...
Dialogue: 0,0:21:12.17,0:21:13.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:21:13.21,0:21:16.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian pasti bisa menjadi idola\Nyang menaklukkan dunia!
Dialogue: 0,0:21:16.46,0:21:17.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja.
Dialogue: 0,0:21:17.84,0:21:20.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian tidak masalah tetap bersekolah\Nseperti selama ini.
Dialogue: 0,0:21:21.51,0:21:25.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}100 Pacar yang Sungguh Sangat\NAmat Benar-benar Mencintaimu.
Dialogue: 0,0:21:25.35,0:21:27.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Babak "Kisah Asmara di Sekolah"
Dialogue: 0,0:21:27.56,0:21:28.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selesai.
Dialogue: 0,0:21:28.47,0:21:32.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karat kalian akan bersinar terang\Ndalam kondisi apa adanya.
Dialogue: 0,0:21:32.85,0:21:35.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aturan yang harus kalian ikuti\Nhanya ada satu!
Dialogue: 0,0:21:35.73,0:21:39.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asal bisa mematuhinya,\Nkalian akan dicintai seluruh orang di dunia,
Dialogue: 0,0:21:39.69,0:21:43.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mendapat segala yang dimau dan hidup\Nakan berjalan sesuai keinginan kalian.
Dialogue: 0,0:21:43.87,0:21:44.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya.
Dialogue: 0,0:21:44.87,0:21:47.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masuk ke babak baru, "Jalan Idola".
Dialogue: 0,0:21:47.87,0:21:49.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Kamu tidak bohong?"
Dialogue: 0,0:21:50.37,0:21:51.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serius?!
Dialogue: 0,0:21:51.62,0:21:52.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Wow!\N- Aku juga?
Dialogue: 0,0:21:54.88,0:21:56.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peraturannya adalah...
Dialogue: 0,0:21:57.25,0:21:59.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak boleh jatuh cinta!
Dialogue: 0,0:21:59.38,0:22:00.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:22:02.13,0:22:04.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih atas undangannya!
Dialogue: 0,0:22:05.55,0:22:08.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tu-Tunggu dulu!
Dialogue: 0,0:22:08.97,0:22:12.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Kami memilih kembali jadi gadis normal!
Dialogue: 0,0:22:12.69,0:22:14.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Babak "Jalan Idola" selesai.
Dialogue: 0,0:22:14.94,0:22:19.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya akan masuk ke babak baru,\N"Kisah Asmara di Sekolah"!
