Dialogue: 0,0:02:57.29,0:03:00.79,sign,,0000,0000,0000,,EPISODE 6: USUL TENNOJI MIREI
Dialogue: 0,0:12:02.47,0:12:05.79,sign,,0000,0000,0000,,"ES KRIM - BELI SAAT SEMPAT DAN SIMPAN"
Dialogue: 0,0:12:05.79,0:12:06.58,sign,,0000,0000,0000,,"DI KULKAS KAMAR"
Dialogue: 0,0:00:09.98,0:00:11.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hinako, sudah pagi.
Dialogue: 0,0:00:13.35,0:00:14.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itsuki?
Dialogue: 0,0:00:15.03,0:00:15.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:00:18.48,0:00:20.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pagi.
Dialogue: 0,0:00:20.09,0:00:21.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat pagi.
Dialogue: 0,0:00:21.33,0:00:23.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak mau ke sekolah.
Dialogue: 0,0:00:23.65,0:00:25.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiap pagi selalu begitu.
Dialogue: 0,0:00:27.19,0:00:29.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hinako, angkat kepalamu sedikit.
Dialogue: 0,0:00:30.45,0:00:31.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kuseka ilermu.
Dialogue: 0,0:00:32.43,0:00:34.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iler...
Dialogue: 0,0:00:35.05,0:00:37.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?\NAngkat kepalamu.
Dialogue: 0,0:00:37.82,0:00:39.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku bisa menyekanya sendiri.
Dialogue: 0,0:00:39.94,0:00:40.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sini.
Dialogue: 0,0:00:40.88,0:00:42.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan lihat aku.
Dialogue: 0,0:00:43.33,0:00:45.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau kenapa hari ini?
Dialogue: 0,0:00:46.42,0:00:48.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, ayo ganti baju.
Dialogue: 0,0:00:48.45,0:00:49.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keluar.
Dialogue: 0,0:00:49.85,0:00:50.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:00:50.44,0:00:52.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat keluar!
Dialogue: 0,0:00:56.18,0:00:59.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Itsuki, apa terjadi sesuatu pada Nona?
Dialogue: 0,0:00:59.32,0:01:00.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:01:00.56,0:01:04.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona bilang mulai besok\Nkau tak perlu membangunkannya.
Dialogue: 0,0:01:04.11,0:01:05.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?!
Dialogue: 0,0:01:06.48,0:01:07.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:01:07.66,0:01:11.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eum, apa aku berbuat kesalahan\Nsampai Hinako membenciku?
Dialogue: 0,0:01:11.92,0:01:14.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, sepertinya bukan itu masalahnya.
Dialogue: 0,0:01:14.40,0:01:16.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan terus mengawasinya.
Dialogue: 0,0:01:16.26,0:01:17.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:01:18.86,0:01:21.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia seperti biasa, 'kan?
Dialogue: 0,0:01:21.59,0:01:26.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semenjak pesta malam itu,\Nsikap Hinako jadi agak aneh.
Dialogue: 0,0:02:45.62,0:02:47.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Rich Girl Caretaker:"
Dialogue: 0,0:02:47.95,0:02:53.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"'m Secretly the Caregiver of the\NMost Popular Girl in This Rich Kid School"
Dialogue: 0,0:03:00.79,0:03:02.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat pagi.
Dialogue: 0,0:03:02.30,0:03:04.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa ini?
Dialogue: 0,0:03:04.29,0:03:05.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pagi!
Dialogue: 0,0:03:05.46,0:03:07.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya ini hal baru buatmu, Tomonari.
Dialogue: 0,0:03:07.85,0:03:10.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melihat pengumuman hasil UTS.
Dialogue: 0,0:03:10.12,0:03:13.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Hasil UTS – PERNGKAT 50 Besar OVJ"\NTapi yang diumumkan cuma 50 besar,
Dialogue: 0,0:03:13.15,0:03:14.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi namaku takkan ada.
Dialogue: 0,0:03:14.60,0:03:18.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, kau peringkat pertama lagi, Konohana.
Dialogue: 0,0:03:18.38,0:03:19.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang hebat!
Dialogue: 0,0:03:19.69,0:03:21.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:03:21.30,0:03:24.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, Konohana.\NSelamat atas peringkat pertamanya.
Dialogue: 0,0:03:24.54,0:03:25.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat.
Dialogue: 0,0:03:25.90,0:03:28.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia memang luar biasa.
Dialogue: 0,0:03:30.16,0:03:32.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Te-Tennoji?
Dialogue: 0,0:03:32.75,0:03:34.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, Tomonari.
Dialogue: 0,0:03:34.98,0:03:37.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat atas peringkat keduanya.
Dialogue: 0,0:03:37.14,0:03:42.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak ada yang perlu dirayakan\Nkalau bukan peringkat pertama.
Dialogue: 0,0:03:43.07,0:03:46.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu,\Nhasil kali ini cukup memuaskan.
Dialogue: 0,0:03:46.40,0:03:47.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:03:47.33,0:03:51.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skorku makin mendekati\Nskor Konohana Hinako dibanding sebelumnya!
Dialogue: 0,0:03:51.82,0:03:54.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemenanganku sudah di depan mata!
Dialogue: 0,0:03:55.16,0:03:57.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, kau peringkat berapa?
Dialogue: 0,0:03:57.70,0:03:59.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak masuk daftar.
Dialogue: 0,0:03:59.52,0:04:03.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin nilaiku rata-rata\Natau sedikit di bawah rata-rata.
Dialogue: 0,0:04:03.02,0:04:04.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Apa itu?!
Dialogue: 0,0:04:04.81,0:04:05.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:04:05.64,0:04:10.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah kuberi bimbingan,\Nnilaimu cuma segitu?
Dialogue: 0,0:04:10.56,0:04:14.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku cukup yakin dengan ujian matematikaku\Nsetelah kau mengajariku...
Dialogue: 0,0:04:14.46,0:04:15.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diam!
Dialogue: 0,0:04:15.65,0:04:18.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau menyerah sedari awal?
Dialogue: 0,0:04:18.67,0:04:22.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski serius, kau takkan berkembang\Njika targetmu terlalu rendah!
Dialogue: 0,0:04:23.68,0:04:24.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perbaiki postur tubuhmu!
Dialogue: 0,0:04:24.41,0:04:25.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap!
Dialogue: 0,0:04:25.08,0:04:26.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga...
Dialogue: 0,0:04:28.39,0:04:30.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku punya ide.
Dialogue: 0,0:04:30.34,0:04:34.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk sementara ini, bagaimana kalau kau\Nbelajar denganku sepulang sekolah?
Dialogue: 0,0:04:34.46,0:04:35.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:04:35.00,0:04:38.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan mengajarimu.
Dialogue: 0,0:04:39.37,0:04:41.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat kita belajar bersama tempo hari...
Dialogue: 0,0:04:41.39,0:04:45.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejujurnya, itu pertama kalinya\Naku mengajari seseorang.
Dialogue: 0,0:04:45.09,0:04:50.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata, mengajari orang lain\Nitu juga membantuku belajar.
Dialogue: 0,0:04:51.10,0:04:54.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkat itu juga, aku bisa memangkas\Njarak skorku dengan Konohana Hinako.
Dialogue: 0,0:04:54.78,0:04:55.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu ya.
Dialogue: 0,0:04:56.19,0:04:59.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi apa tidak apa-apa aku jadi muridmu?
Dialogue: 0,0:04:59.13,0:05:04.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, karena di antara kenalanku,\Nnilaimu yang paling jelek.
Dialogue: 0,0:05:05.23,0:05:06.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu...
Dialogue: 0,0:05:06.40,0:05:08.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jawablah dengan jujur.
Dialogue: 0,0:05:08.52,0:05:12.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau merasa minder di akademi kita, 'kan?
Dialogue: 0,0:05:13.54,0:05:17.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja, karena ini dunia\Nyang sangat berbeda denganku.
Dialogue: 0,0:05:17.04,0:05:19.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih dari sekadar minder.
Dialogue: 0,0:05:19.75,0:05:23.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, akhir-akhir ini\Naku mulai menyadarinya.
Dialogue: 0,0:05:23.50,0:05:26.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahwa aku masih punya banyak kekurangan.
Dialogue: 0,0:05:27.32,0:05:31.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tennoji, kau punya bakat\Nuntuk memahami orang lain, ya.
Dialogue: 0,0:05:31.04,0:05:33.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa tidak sehebat itu.
Dialogue: 0,0:05:33.20,0:05:34.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya saja, aku juga...
Dialogue: 0,0:05:35.33,0:05:36.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudahlah.
Dialogue: 0,0:05:36.46,0:05:38.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau hanya butuh rasa percaya diri,
Dialogue: 0,0:05:38.53,0:05:42.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}maka kau akan bisa\Nberjalan dengan kepala tegak.
Dialogue: 0,0:05:42.03,0:05:43.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutmu begitu?
Dialogue: 0,0:05:44.38,0:05:46.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tennoji selalu bisa\Nberjalan dengan kepala tegak.
Dialogue: 0,0:05:46.84,0:05:49.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kagum, tapi aku\Ntakkan bisa melakukan hal serupa.
Dialogue: 0,0:05:49.62,0:05:51.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan berarti itu mustahil.
Dialogue: 0,0:05:51.36,0:05:55.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu semua akan tecermin\Ndari raut wajah dan sikapmu.
Dialogue: 0,0:05:55.70,0:05:57.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Benarkah?
Dialogue: 0,0:05:58.67,0:06:02.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, sebenarnya aku membantumu\Njuga demi diriku sendiri,
Dialogue: 0,0:06:02.00,0:06:06.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi alangkah baiknya jika ada hal\Nyang bisa kulakukan sebagai balasan...
Dialogue: 0,0:06:06.20,0:06:09.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengajariku pelajaran sekolah saja\Nsudah lebih dari cukup.
Dialogue: 0,0:06:09.25,0:06:11.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa begitu.
Dialogue: 0,0:06:11.78,0:06:15.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ada hal yang mengganggumu,\Natau hal yang tak kau kuasai?
Dialogue: 0,0:06:17.23,0:06:20.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kau memintanya mengajarimu tata krama?
Dialogue: 0,0:06:20.09,0:06:21.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:06:21.14,0:06:23.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Tennoji adalah orang\Nyang sangat anggun.
Dialogue: 0,0:06:23.78,0:06:25.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sangat menjaga etika.
Dialogue: 0,0:06:25.44,0:06:30.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eum, bolehkah aku menghabiskan waktu\Nbersamanya sepulang sekolah untuk sementara?
Dialogue: 0,0:06:30.94,0:06:32.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa keinginanmu, Tuan Itsuki?
Dialogue: 0,0:06:32.97,0:06:35.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin menerimanya kalau boleh.
Dialogue: 0,0:06:35.00,0:06:37.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin bimbingan dari Tennoji
Dialogue: 0,0:06:37.34,0:06:41.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan membantuku jadi pengurus\Nyang lebih baik untuk Hinako.
Dialogue: 0,0:06:41.42,0:06:42.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti.
Dialogue: 0,0:06:42.66,0:06:44.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak melihat ada masalah.
Dialogue: 0,0:06:44.79,0:06:49.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin Nona Tennoji bisa\Nmengajarimu tata krama lebih baik dariku.
Dialogue: 0,0:06:49.69,0:06:53.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga punya pesan untukmu\Ndari Tuan Kagen.
Dialogue: 0,0:06:53.27,0:06:54.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:06:54.13,0:06:58.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beliau ingin kau terus mendukung Nona,
Dialogue: 0,0:06:58.08,0:07:02.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}serta proaktif dalam memperluas\Nkoneksi Keluarga Konohana.
Dialogue: 0,0:07:02.33,0:07:03.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Kagen bilang begitu?
Dialogue: 0,0:07:04.42,0:07:07.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu berarti beliau mulai memercayaiku?
Dialogue: 0,0:07:08.26,0:07:11.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan beri tahu Nona dulu.
Dialogue: 0,0:07:11.06,0:07:12.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, baiklah.
Dialogue: 0,0:07:13.22,0:07:18.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah dengar dari Shizune,\Nsuasana hati Hinako jadi buruk, tapi...
Dialogue: 0,0:07:18.73,0:07:19.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak.
Dialogue: 0,0:07:20.31,0:07:22.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Es krim saat berendam memang yang terbaik.
Dialogue: 0,0:07:23.21,0:07:25.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah memaafkanku?
Dialogue: 0,0:07:26.42,0:07:28.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau melakukannya demi aku, 'kan?
Dialogue: 0,0:07:30.04,0:07:31.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya aku tak suka idenya,
Dialogue: 0,0:07:31.75,0:07:34.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi akan kumaafkan\Nkarena kau lakukan demi aku.
Dialogue: 0,0:07:34.08,0:07:38.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagian memang demi kau, tapi aku juga\Ningin jadi pengurus yang kompeten.
Dialogue: 0,0:07:39.08,0:07:41.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, ini demi kebaikanku juga.
Dialogue: 0,0:07:42.84,0:07:45.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau tak setuju, aku bisa menolaknya.
Dialogue: 0,0:07:45.53,0:07:48.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak mau menghalangi jalanmu, Itsuki.
Dialogue: 0,0:07:48.38,0:07:49.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:07:49.68,0:07:51.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejujurnya, aku agak lega.
Dialogue: 0,0:07:51.88,0:07:52.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lega?
Dialogue: 0,0:07:53.12,0:07:56.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhir-akhir ini kau menghindariku.
Dialogue: 0,0:07:56.30,0:07:59.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menghindarimu?\NKenapa kau berpikir begitu?
Dialogue: 0,0:07:59.35,0:08:03.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudku, kau tak mau\Nkubangunkan lagi tiap pagi,
Dialogue: 0,0:08:03.65,0:08:07.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan kadang kau seolah menjaga jarak dariku.
Dialogue: 0,0:08:07.84,0:08:10.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya aku ingin menjaga jarak.
Dialogue: 0,0:08:10.34,0:08:11.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, kenapa?
Dialogue: 0,0:08:13.14,0:08:14.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak mau mengatakannya.
Dialogue: 0,0:08:16.18,0:08:17.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya kenapa?
Dialogue: 0,0:08:17.70,0:08:23.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah bersamanya lebih dari sebulan,\Nkupikir aku sudah memahaminya...
Dialogue: 0,0:08:23.72,0:08:25.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sini, kucuci rambutmu.
Dialogue: 0,0:08:26.43,0:08:27.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, Hinako...
Dialogue: 0,0:08:27.57,0:08:28.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:08:28.83,0:08:30.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa pakai baju renang itu?
Dialogue: 0,0:08:32.01,0:08:33.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan apa-apa.
Dialogue: 0,0:08:33.57,0:08:36.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah kau bilang baju renang itu gerah?\NKau tidak apa-apa?
Dialogue: 0,0:08:36.40,0:08:38.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat cuci saja rambutku.
Dialogue: 0,0:08:42.53,0:08:44.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kuturunkan tali bahumu sebentar.
Dialogue: 0,0:08:46.29,0:08:47.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rambutmu...
Dialogue: 0,0:08:47.78,0:08:49.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, sudah selesai.
Dialogue: 0,0:08:52.42,0:08:53.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hinako?!
Dialogue: 0,0:08:54.07,0:08:54.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau...
Dialogue: 0,0:08:54.95,0:08:55.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau?
Dialogue: 0,0:08:56.25,0:08:57.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sangat tidak peka!
Dialogue: 0,0:08:57.98,0:09:00.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak peka?!
Dialogue: 0,0:09:00.71,0:09:03.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benar-benar tak mengerti\Njalan pikiran Hinako.
Dialogue: 0,0:09:05.63,0:09:10.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demikianlah, pelajaran sepulang sekolah\Nbersama Tennoji pun dimulai.
Dialogue: 0,0:09:10.23,0:09:12.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita mulai dengan menentukan target.
Dialogue: 0,0:09:12.58,0:09:17.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tujuanku adalah mengalahkan Konohana Hinako\Ndi ujian berikutnya.
Dialogue: 0,0:09:18.07,0:09:20.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapan ujiannya diadakan?
Dialogue: 0,0:09:20.24,0:09:22.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu bulan lagi.
Dialogue: 0,0:09:22.31,0:09:26.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tomonari, aku akan membimbingmu\Nagar masuk 50 besar di ujian itu.
Dialogue: 0,0:09:26.87,0:09:29.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Da-Dalam satu bulan?!
Dialogue: 0,0:09:30.91,0:09:34.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya kau memang rajin belajar\Nsetiap hari, ya.
Dialogue: 0,0:09:34.32,0:09:36.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:09:36.26,0:09:42.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eum, kenapa kau punya rasa saing\Nyang begitu kuat terhadap Konohana?
Dialogue: 0,0:09:42.52,0:09:49.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asal kau tahu, aku tak punya dendam pribadi\Nterhadap Konohana Hinako.
Dialogue: 0,0:09:49.42,0:09:53.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya saja,\Nsebagai putri dari Keluarga Tennoji,
Dialogue: 0,0:09:53.25,0:09:55.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tak bisa membiarkan diriku\Nkalah dari orang lain.
Dialogue: 0,0:09:55.89,0:09:59.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah itu semacam prinsip keluargamu?
Dialogue: 0,0:09:59.01,0:10:03.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, itu adalah aturan\Nyang kubuat untuk diriku sendiri.
Dialogue: 0,0:10:03.44,0:10:04.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk dirimu sendiri?
Dialogue: 0,0:10:05.40,0:10:09.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah ada kalanya\Nkau merasa itu membebani?
Dialogue: 0,0:10:09.96,0:10:11.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak sama sekali.
Dialogue: 0,0:10:12.20,0:10:16.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai putri dari Keluarga Tennoji,\Naku harus berkontribusi pada keluargaku.
Dialogue: 0,0:10:16.05,0:10:20.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah kewajibanku sekaligus kebahagiaanku.
Dialogue: 0,0:10:21.79,0:10:24.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang mari kita lanjutkan\Nke pelajaran tata krama.
Dialogue: 0,0:10:24.81,0:10:27.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, aku punya satu permintaan.
Dialogue: 0,0:10:27.45,0:10:28.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:10:28.67,0:10:32.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisakah kita memulainya\Ndengan etika di meja makan?
Dialogue: 0,0:10:32.74,0:10:35.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ada alasan tertentu?
Dialogue: 0,0:10:35.17,0:10:38.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, eum, ada alasan pribadi.
Dialogue: 0,0:10:38.70,0:10:40.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku paham.
Dialogue: 0,0:10:40.44,0:10:41.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:10:42.31,0:10:47.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya kami menggelar pelajaran etika\Nsambil makan malam di kafe ini.
Dialogue: 0,0:10:48.18,0:10:51.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shizune langsung menyetujuinya\Nsaat kuberi tahu lewat telepon.
Dialogue: 0,0:10:56.82,0:10:58.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau masih belajar?
Dialogue: 0,0:10:58.91,0:10:59.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah bangun?
Dialogue: 0,0:11:00.26,0:11:03.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau menikmati belajar bersama Tennoji?
Dialogue: 0,0:11:03.55,0:11:04.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya...
Dialogue: 0,0:11:04.92,0:11:08.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tennoji itu tak kenal kompromi\Npada dirinya sendiri maupun orang lain,
Dialogue: 0,0:11:08.46,0:11:11.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi mau tak mau\Naku pun mengerahkan seluruh kemampuanku.
Dialogue: 0,0:11:12.58,0:11:14.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan mengantarmu ke kamar.
Dialogue: 0,0:11:14.38,0:11:15.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malam ini aku mau tidur di sini.
Dialogue: 0,0:11:15.98,0:11:16.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu takkan terjadi.
Dialogue: 0,0:11:17.64,0:11:18.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tepuk kepalaku.
Dialogue: 0,0:11:18.81,0:11:22.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di malam pesta itu, kau tak suka\Nsaat aku menepuk kepalamu.
Dialogue: 0,0:11:22.66,0:11:24.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang tak apa-apa?
Dialogue: 0,0:11:24.35,0:11:26.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukannya aku tak suka...
Dialogue: 0,0:11:51.51,0:11:54.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya ini pertama kalinya\Nkulihat dia tidur.
Dialogue: 0,0:11:54.65,0:11:56.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pasti sangat lelah.
Dialogue: 0,0:12:02.47,0:12:05.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini isi buku panduan pengurus.
Dialogue: 0,0:12:09.29,0:12:11.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona, Anda di sini?
Dialogue: 0,0:12:15.89,0:12:17.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga.
Dialogue: 0,0:12:17.18,0:12:21.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidur di depan Nona\Nmenunjukkan dia tidak layak jadi pengurus.
Dialogue: 0,0:12:21.74,0:12:24.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa mengantar Anda ke kamar\Njika Anda mau.
Dialogue: 0,0:12:24.24,0:12:25.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:12:26.27,0:12:27.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shizune.
Dialogue: 0,0:12:27.66,0:12:28.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya?
Dialogue: 0,0:12:28.44,0:12:30.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perasaanku aneh.
Dialogue: 0,0:12:30.47,0:12:33.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang Itsuki jadi pengurusku lagi,
Dialogue: 0,0:12:33.79,0:12:38.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kadang aku merasa sedih\Nsaat memikirkan dia mengurusku.
Dialogue: 0,0:12:39.83,0:12:44.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa Itsuki menuruti keinginanku\Nhanya karena ini pekerjaannya?
Dialogue: 0,0:12:45.19,0:12:46.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenanglah.
Dialogue: 0,0:12:46.98,0:12:51.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Itsuki mendampingi Anda\Nbukan semata-mata karena itu tugasnya.
Dialogue: 0,0:12:52.29,0:12:53.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:12:53.45,0:12:54.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:12:54.63,0:12:58.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu saja sebentar lagi,\Ndan aku yakin Anda akan memahaminya.
Dialogue: 0,0:13:01.71,0:13:03.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetap saja, ini hal baru bagiku.
Dialogue: 0,0:13:04.27,0:13:08.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anda mencurahkan\Nisi hati Anda padaku seperti ini.
Dialogue: 0,0:13:08.30,0:13:10.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:13:10.58,0:13:11.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:13:13.56,0:13:14.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya aku tak begini.
Dialogue: 0,0:13:15.60,0:13:19.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih terlalu dini bagiku untuk memiliki\Nnaluri keibuan seperti itu.
Dialogue: 0,0:13:21.32,0:13:25.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah sepekan berlalu sejak aku\Nmulai belajar bersama Tennoji.
Dialogue: 0,0:13:25.33,0:13:27.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini kafenya tutup,
Dialogue: 0,0:13:27.71,0:13:30.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi kami akan belajar di rumah Tennoji.
Dialogue: 0,0:13:32.34,0:13:36.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mewah sekali,\Natau mungkin harus kubilang glamor...
Dialogue: 0,0:13:36.52,0:13:38.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memancarkan keglamoran dengan bangga.
Dialogue: 0,0:13:38.78,0:13:41.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah pedoman hidup Keluarga Tennoji.
Dialogue: 0,0:13:41.41,0:13:47.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taman ini juga dirancang sedemikian rupa\Nagar terlihat indah dari luar gerbang.
Dialogue: 0,0:13:47.04,0:13:49.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutku, memang terlihat indah kok.
Dialogue: 0,0:13:53.55,0:13:56.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya seperti berada\Ndi lokasi syuting film.
Dialogue: 0,0:13:56.04,0:13:58.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, kau sudah pulang, Mirei?
Dialogue: 0,0:14:01.03,0:14:04.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baru saja pulang, Ayah.
Dialogue: 0,0:14:04.26,0:14:06.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Ayahmu?!
Dialogue: 0,0:14:06.21,0:14:10.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, beliau memaksa ingin menemuimu\Nsaat kubilang kau akan datang.
Dialogue: 0,0:14:11.44,0:14:13.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Su-Suatu kehormatan bisa bertemu dengan Anda.
Dialogue: 0,0:14:13.45,0:14:15.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namaku Tomonari Itsuki.
Dialogue: 0,0:14:15.28,0:14:18.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, aku Tennoji Masatsugu.
Dialogue: 0,0:14:18.40,0:14:20.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuharap kau bersenang-senang\Ndi sini hari ini.
Dialogue: 0,0:14:20.67,0:14:25.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah, dia datang ke sini untuk belajar.
Dialogue: 0,0:14:25.10,0:14:26.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya.
Dialogue: 0,0:14:26.71,0:14:28.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, belajarlah yang rajin.
Dialogue: 0,0:14:29.71,0:14:31.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, Tomonari...
Dialogue: 0,0:14:31.30,0:14:33.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa hubunganmu dengan putriku?
Dialogue: 0,0:14:33.99,0:14:35.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Eum...
Dialogue: 0,0:14:35.73,0:14:38.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami adalah murid di sekolah yang sama.
Dialogue: 0,0:14:38.04,0:14:39.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma itu?
Dialogue: 0,0:14:39.67,0:14:43.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak ada hubungan khusus\Ndi antara kalian berdua?
Dialogue: 0,0:14:43.01,0:14:44.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pria dan wanita seusia kalian...
Dialogue: 0,0:14:44.46,0:14:45.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah!
Dialogue: 0,0:14:45.59,0:14:49.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami tidak berbuat hal yang tak pantas!
Dialogue: 0,0:14:49.06,0:14:52.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau bilang begitu,\NAyah percaya padamu, Mirei.
Dialogue: 0,0:14:52.90,0:14:55.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar kau ingin belajar\Netika di meja makan.
Dialogue: 0,0:14:55.77,0:14:58.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau aku ikut bergabung\Ndengan kalian?
Dialogue: 0,0:14:58.13,0:14:58.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?!
Dialogue: 0,0:14:59.31,0:15:00.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mustahil...
Dialogue: 0,0:15:00.46,0:15:04.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan makan bareng petinggi\Ndari perusahaan raksasa di negara ini?!
Dialogue: 0,0:15:06.84,0:15:08.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih atas hidangannya.
Dialogue: 0,0:15:08.49,0:15:12.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, tata kramamu kelihatannya cukup bagus.
Dialogue: 0,0:15:12.33,0:15:16.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setidaknya tak ada hal mencolok bagiku.
Dialogue: 0,0:15:16.65,0:15:18.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Te-Terima kasih banyak.
Dialogue: 0,0:15:18.75,0:15:22.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah Ayah terlalu menoleransi?
Dialogue: 0,0:15:22.54,0:15:25.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Caranya meminum sup tadi\Ntampak tidak elegan menurutku.
Dialogue: 0,0:15:25.77,0:15:28.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang benar dia kelihatan sedikit tegang.
Dialogue: 0,0:15:28.98,0:15:32.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, wajar saja\Nmengingat aku ada di meja ini.
Dialogue: 0,0:15:34.25,0:15:37.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eum, apa yang harus kulakukan\Nagar tak terlalu gugup?
Dialogue: 0,0:15:38.18,0:15:42.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua orang pasti gugup di awal-awal.
Dialogue: 0,0:15:42.15,0:15:44.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan aku juga sempat mengalaminya\Nwaktu masih muda.
Dialogue: 0,0:15:45.28,0:15:47.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baru bisa sampai ke titik ini
Dialogue: 0,0:15:47.12,0:15:50.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}setelah mengumpulkan berbagai pencapaian\Ndalam waktu yang lama.
Dialogue: 0,0:15:51.30,0:15:54.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat harus mengambil langkah maju,\Nhal yang bisa menguatkan kita...
Dialogue: 0,0:15:54.44,0:15:56.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah jejak langkah kita sendiri\Ndi masa lalu.
Dialogue: 0,0:15:56.95,0:15:58.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak masalah meski itu berupa kegagalan.
Dialogue: 0,0:15:58.94,0:16:01.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Percayalah pada dirimu sendiri\Nsaat mengambil tindakan.
Dialogue: 0,0:16:01.48,0:16:02.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:16:02.47,0:16:04.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku suka raut wajahmu itu.
Dialogue: 0,0:16:09.13,0:16:12.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, tiba-tiba hujan turun.
Dialogue: 0,0:16:12.14,0:16:15.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tomonari, menginaplah di rumahku.
Dialogue: 0,0:16:15.17,0:16:15.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:16:15.91,0:16:17.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku setuju dengan Ayah.
Dialogue: 0,0:16:17.64,0:16:21.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tak mungkin membiarkan tamu pulang\Ndi tengah badai seperti ini.
Dialogue: 0,0:16:21.84,0:16:24.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus membicarakannya\Ndengan keluargaku dulu.
Dialogue: 0,0:16:25.12,0:16:27.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Besok akhir pekan, jadi tak masalah.
Dialogue: 0,0:16:27.85,0:16:33.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetapi, aku bisa membayangkan\NNona bakal ngambek soal ini.
Dialogue: 0,0:16:33.85,0:16:35.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eum, aku tak yakin
Dialogue: 0,0:16:35.64,0:16:38.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa ini bisa membuat\Nsuasana hati Hinako membaik,
Dialogue: 0,0:16:38.14,0:16:40.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi ada yang ingin kupinta untuk besok...
Dialogue: 0,0:16:43.49,0:16:45.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan gunakan kamar ini.
Dialogue: 0,0:16:47.79,0:16:49.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:16:49.61,0:16:51.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada baju ganti di dalam lemari,
Dialogue: 0,0:16:52.13,0:16:55.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi jangan lupa membawanya\Nke pemandian umum.
Dialogue: 0,0:16:55.11,0:16:57.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rumahmu punya pemandian umum?
Dialogue: 0,0:16:57.07,0:16:57.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:16:57.87,0:17:00.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemandian itu\Nadalah kebanggaan keluarga kami.
Dialogue: 0,0:17:08.57,0:17:09.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh?
Dialogue: 0,0:17:11.48,0:17:13.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ja-Jangan bilang...
Dialogue: 0,0:17:13.74,0:17:15.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tennoji?
Dialogue: 0,0:17:15.52,0:17:17.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, aku Tennoji.
Dialogue: 0,0:17:18.33,0:17:19.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?! Oh, eum...
Dialogue: 0,0:17:19.78,0:17:23.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alamak, kebetulan sekali\Nkita bertemu di sini.
Dialogue: 0,0:17:24.76,0:17:27.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertemuan pertama yang sangat menarik.
Dialogue: 0,0:17:27.79,0:17:29.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pasti Tomonari.
Dialogue: 0,0:17:30.07,0:17:31.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Izinkan aku memperkenalkan diri.
Dialogue: 0,0:17:31.25,0:17:35.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Tennoji Hanami, ibunda Mirei.
Dialogue: 0,0:17:35.94,0:17:38.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih karena selalu menjaga putriku.
Dialogue: 0,0:17:39.01,0:17:41.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}De-Dengan senang hati.
Dialogue: 0,0:17:41.01,0:17:43.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kabar Mirei di sekolah?
Dialogue: 0,0:17:43.46,0:17:45.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa dia tampak menikmati harinya?
Dialogue: 0,0:17:45.64,0:17:51.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, Tennoji selalu menjaga kepalanya\Ntetap tegak dan selalu jujur apa adanya.
Dialogue: 0,0:17:51.38,0:17:53.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, syukurlah.
Dialogue: 0,0:17:53.99,0:17:57.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang lebih penting,\Naku yakin ini pemandian pria!
Dialogue: 0,0:17:57.86,0:17:59.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, benarkah?
Dialogue: 0,0:17:59.65,0:18:02.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa Nyonya terlihat sangat santai\Nsoal ini?!
Dialogue: 0,0:18:02.78,0:18:05.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tomonari, ada apa?
Dialogue: 0,0:18:05.18,0:18:07.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa itu Tennoji yang kukenal?!
Dialogue: 0,0:18:07.68,0:18:09.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, ini aku.
Dialogue: 0,0:18:09.62,0:18:12.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah. Sebenarnya, saat ini...
Dialogue: 0,0:18:12.10,0:18:14.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, Mirei, kau ada di sebelah sana?
Dialogue: 0,0:18:14.85,0:18:16.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Ibu?!
Dialogue: 0,0:18:16.37,0:18:20.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, sepertinya aku salah masuk lagi.
Dialogue: 0,0:18:20.26,0:18:22.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi jadinya aku bisa mengobrol\Ndengan Tomonari...
Dialogue: 0,0:18:22.81,0:18:24.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu!
Dialogue: 0,0:18:29.29,0:18:31.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Ibu, ikut aku!
Dialogue: 0,0:18:31.86,0:18:35.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu harus jaga sikap!
Dialogue: 0,0:18:35.24,0:18:36.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja.
Dialogue: 0,0:18:42.25,0:18:44.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baju renang?
Dialogue: 0,0:18:45.16,0:18:47.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu tadi berenang di kolam\Nsampai beberapa waktu lalu.
Dialogue: 0,0:18:47.95,0:18:50.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan Ibu juga bakal malu kalau telanjang.
Dialogue: 0,0:18:50.97,0:18:52.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, Mirei...
Dialogue: 0,0:18:52.55,0:18:55.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya kaulah yang harus\Nbelajar sedikit lebih sopan.
Dialogue: 0,0:19:05.23,0:19:06.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, silakan masuk.
Dialogue: 0,0:19:07.47,0:19:09.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi.
Dialogue: 0,0:19:09.38,0:19:13.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku membuat teh herbal,\Ndan kupikir kita bisa meminumnya bersama.
Dialogue: 0,0:19:13.79,0:19:15.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau rajin sekali.
Dialogue: 0,0:19:15.69,0:19:18.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya mengikuti jadwal keseharianku.
Dialogue: 0,0:19:18.20,0:19:20.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak bisa bersantai\Nkalau jadwalnya belum tuntas.
Dialogue: 0,0:19:23.49,0:19:24.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:19:24.78,0:19:28.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, hanya saja gaya rambutmu\Nsedikit berbeda dari biasanya.
Dialogue: 0,0:19:28.90,0:19:33.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh? Jangan-jangan\Nkau mulai jatuh cinta padaku?
Dialogue: 0,0:19:33.17,0:19:35.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, eum, itu...
Dialogue: 0,0:19:36.00,0:19:36.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh!
Dialogue: 0,0:19:36.75,0:19:38.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tak apa-apa?
Dialogue: 0,0:19:38.19,0:19:40.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, maaf.
Dialogue: 0,0:19:44.27,0:19:46.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya aku berterima kasih padamu.
Dialogue: 0,0:19:46.68,0:19:48.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkat pesta teh dan bimbingan belajarmu,
Dialogue: 0,0:19:48.56,0:19:53.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kehidupan sekolahku jadi sangat menyenangkan\Nsejak aku bertemu denganmu.
Dialogue: 0,0:19:54.49,0:19:58.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, ternyata tekadmu jauh lebih kuat\Ndari kelihatannya,
Dialogue: 0,0:19:58.58,0:20:01.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi saat aku bersamamu,\Naku pun merasa lebih bersemangat.
Dialogue: 0,0:20:02.12,0:20:06.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau berhasil menembus\Nperingkat 10 besar di ujian berikutnya,
Dialogue: 0,0:20:06.87,0:20:11.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku akan merekrutmu\Nsebagai tangan kananku setelah kita lulus.
Dialogue: 0,0:20:11.24,0:20:13.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak berani membayangkan\Nbisa mendapat posisi setinggi itu.
Dialogue: 0,0:20:13.99,0:20:19.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau terus meragukan dirimu sendiri,\Npeluangmu memang kecil.
Dialogue: 0,0:20:19.26,0:20:23.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski begitu, aku yakin\Naku akan senang bekerja untukmu.
Dialogue: 0,0:20:23.74,0:20:25.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be-Benarkah begitu?
Dialogue: 0,0:20:25.63,0:20:26.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:20:26.63,0:20:30.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkatmu, aku jadi menikmati belajar,
Dialogue: 0,0:20:30.50,0:20:33.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi pasti menyenangkan kalau aku bisa\Nmerasakan hal yang sama di dunia kerja.
Dialogue: 0,0:20:35.39,0:20:37.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, itu benar!
Dialogue: 0,0:20:37.80,0:20:39.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:20:40.99,0:20:43.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi sebelum itu...
Dialogue: 0,0:20:43.63,0:20:45.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, aku lebih suka kita...
Dialogue: 0,0:20:45.77,0:20:47.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya ampun!
Dialogue: 0,0:20:48.47,0:20:49.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tennoji?
Dialogue: 0,0:20:50.52,0:20:53.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ja-Jangan pedulikan aku!
Dialogue: 0,0:20:53.35,0:20:55.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus segera tidur malam ini.
Dialogue: 0,0:20:56.67,0:21:00.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau kita sudahi hari ini\Ndengan meneriakkan slogan kita?
Dialogue: 0,0:21:00.18,0:21:02.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Slogan?
Dialogue: 0,0:21:02.08,0:21:03.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:21:03.02,0:21:04.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak zaman dahulu,
Dialogue: 0,0:21:04.95,0:21:08.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}orang akan lebih bersemangat jika meneriakkan\Nsorak-sorai sebelum maju ke medan perang.
Dialogue: 0,0:21:08.77,0:21:12.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesuatu seperti, "Hip, hip, hore!"
Dialogue: 0,0:21:13.28,0:21:15.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi itu menggemaskan sekali.
Dialogue: 0,0:21:15.59,0:21:18.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, ikuti ucapanku.
Dialogue: 0,0:21:19.21,0:21:22.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tumbangkan Konohana Hinako!
Dialogue: 0,0:21:22.40,0:21:24.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tumbangkan Hinako...
Dialogue: 0,0:21:24.09,0:21:24.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?!
Dialogue: 0,0:21:24.84,0:21:26.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada yang salah?
Dialogue: 0,0:21:26.35,0:21:27.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, maksudku...
Dialogue: 0,0:21:27.28,0:21:29.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu slogan kita?
Dialogue: 0,0:21:29.69,0:21:31.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, itu bagus untuk membakar semangat.
Dialogue: 0,0:21:32.32,0:21:33.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, mulai!
Dialogue: 0,0:21:33.83,0:21:34.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Y-Ya!
Dialogue: 0,0:21:34.85,0:21:37.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tumbangkan Konohana Hinako!
Dialogue: 0,0:21:37.92,0:21:40.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tumbangkan Konohana Hinako...
Dialogue: 0,0:21:40.00,0:21:41.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih keras lagi!
Dialogue: 0,0:21:41.40,0:21:44.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tumbangkan Konohana Hinako!\N- Maafkan aku, Hinako.
Dialogue: 0,0:21:46.27,0:21:48.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak atas jamuannya.
Dialogue: 0,0:21:48.76,0:21:51.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau boleh datang kapan saja.
Dialogue: 0,0:21:51.31,0:21:53.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, kami akan menunggu.
Dialogue: 0,0:21:54.53,0:21:56.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian berdua tampak sangat serasi.
Dialogue: 0,0:21:56.76,0:21:57.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:21:58.18,0:22:01.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin aku akan senang bekerja untukmu.
Dialogue: 0,0:22:02.09,0:22:07.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga merasa akan sangat nyaman\Nbekerja bersama Tomonari.
Dialogue: 0,0:22:07.47,0:22:10.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ada sesuatu di antara kalian?
Dialogue: 0,0:22:10.78,0:22:11.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:22:11.81,0:22:15.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}'Kan sudah kubilang, tak ada yang tak pantas\Ndalam hubungan kami!
Dialogue: 0,0:22:17.27,0:22:20.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada sesuatu yang ingin\NAyah bicarakan denganmu.
Dialogue: 0,0:22:21.72,0:22:25.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah rasa sudah saatnya\Nkau memilih tunangan.
Dialogue: 0,0:22:26.66,0:22:28.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunangan?
Dialogue: 0,0:22:29.33,0:22:32.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke depannya,\Nakan banyak pihak yang mendekatimu
Dialogue: 0,0:22:32.36,0:22:35.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}demi mengincar kekuatan Keluarga Tennoji.
Dialogue: 0,0:22:35.61,0:22:38.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beberapa dari mereka pasti punya niat buruk.
Dialogue: 0,0:22:39.27,0:22:41.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menentukan tunangan secepatnya\Nmungkin adalah pilihan terbaik
Dialogue: 0,0:22:41.95,0:22:44.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk menghalangi mereka mendekat.
Dialogue: 0,0:22:44.59,0:22:47.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja, itu jika kau tidak keberatan.
Dialogue: 0,0:22:47.82,0:22:52.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah ini demi Keluarga Tennoji?
Dialogue: 0,0:22:54.92,0:22:59.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan bertunangan, apakah aku telah\Nberkontribusi pada Keluarga Tennoji?
Dialogue: 0,0:23:01.28,0:23:04.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu jelas akan membuat perencanaan\Nke depannya jauh lebih mudah.
Dialogue: 0,0:23:04.24,0:23:07.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,\Ntentu saja aku akan menerimanya.
