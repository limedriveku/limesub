Dialogue: 0,0:00:57.44,0:00:58.36,sign,,0000,0000,0000,,MIYAKOJIMA SI IBLIS
Dialogue: 0,0:03:19.52,0:03:21.38,sign,,0000,0000,0000,,"EPISODE 10"
Dialogue: 0,0:03:21.38,0:03:22.90,sign,,0000,0000,0000,,"RENCANA MELARIKAN DIRI NARIKA SI PENYENDIRI"
Dialogue: 0,0:03:58.59,0:03:59.54,sign,,0000,0000,0000,,TENIS
Dialogue: 0,0:07:20.92,0:07:23.14,sign,,0000,0000,0000,,NOL TEMAN, NARIKA
Dialogue: 0,0:07:30.90,0:07:32.77,sign,,0000,0000,0000,,AWAS ANJING GALAK
Dialogue: 0,0:12:00.75,0:12:02.50,sign,,0000,0000,0000,,SELESAI JAM PERTAMA
Dialogue: 0,0:00:06.23,0:00:08.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau takut sama turnamen olahraga?
Dialogue: 0,0:00:08.28,0:00:12.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kupikir kau jago olahraga, Miyakojima.
Dialogue: 0,0:00:13.60,0:00:14.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, itu...
Dialogue: 0,0:00:14.69,0:00:16.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Itu benar, sih...
Dialogue: 0,0:00:16.74,0:00:18.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Santai saja, Narika.
Dialogue: 0,0:00:18.71,0:00:21.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak perlu terlalu gugup begitu.
Dialogue: 0,0:00:21.16,0:00:24.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa yang tidak gugup\Nsaat mengobrol dengan Konohana?
Dialogue: 0,0:00:24.83,0:00:27.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia kan nona besar\Npaling top di akademi ini!
Dialogue: 0,0:00:27.66,0:00:29.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang sih, tapi tetap saja...
Dialogue: 0,0:00:30.25,0:00:31.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus?
Dialogue: 0,0:00:31.33,0:00:34.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya ada apa\Ndengan turnamen olahraganya?
Dialogue: 0,0:00:34.73,0:00:38.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tahun lalu, aku ikut cabang kendo.
Dialogue: 0,0:00:38.47,0:00:42.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kendo, ya?\NAku tahu kau giat berlatih sejak masih kecil.
Dialogue: 0,0:00:42.22,0:00:43.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau menang, 'kan?
Dialogue: 0,0:00:43.97,0:00:46.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, aku menang.
Dialogue: 0,0:00:46.61,0:00:49.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi setelah menang telak,
Dialogue: 0,0:00:49.48,0:00:51.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}semua orang malah jadi takut padaku.
Dialogue: 0,0:00:51.99,0:00:53.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, pantas saja...
Dialogue: 0,0:00:58.36,0:01:03.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dipikir-pikir lagi,\Nmungkin gara-gara itu aku jadi dijauhi.
Dialogue: 0,0:01:03.60,0:01:05.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutku bukan karena itu, sih.
Dialogue: 0,0:01:05.81,0:01:08.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Narika, dari dulu kau memang penyendiri.
Dialogue: 0,0:01:08.19,0:01:10.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Itu tidak benar!
Dialogue: 0,0:01:10.85,0:01:17.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dulu, paling tidak aku punya\Nsatu atau dua orang teman...
Dialogue: 0,0:01:17.54,0:01:19.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti kau memang tak punya teman...
Dialogue: 0,0:01:19.14,0:01:21.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma orang yang tak punya\Nteman yang bilang begitu.
Dialogue: 0,0:01:21.13,0:01:24.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan menatapku seperti itu, kalian berdua!
Dialogue: 0,0:01:24.42,0:01:28.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Intinya, aku takut kejadian yang sama\Nbakal terulang!
Dialogue: 0,0:01:28.73,0:01:31.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata selama ini\Ndia mengkhawatirkan hal itu...
Dialogue: 0,0:01:31.95,0:01:33.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, Narika.
Dialogue: 0,0:01:33.36,0:01:35.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita carikan teman untukmu\Nsebelum turnamen dimulai.
Dialogue: 0,0:01:35.92,0:01:37.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan membantumu.
Dialogue: 0,0:01:39.31,0:01:41.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be-Benarkah?
Dialogue: 0,0:01:41.10,0:01:41.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:01:42.18,0:01:47.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai gantinya, maukah kau\Nmelatih aku dan Konohana main tenis?
Dialogue: 0,0:01:47.35,0:01:48.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melatih kalian?
Dialogue: 0,0:03:07.64,0:03:09.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rich Girl Caretaker:
Dialogue: 0,0:03:09.86,0:03:15.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I'm Secretly the Caregiver of the Most\NPopular Girl in This Rich Kid School
Dialogue: 0,0:03:19.52,0:03:21.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti.
Dialogue: 0,0:03:21.38,0:03:22.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ide yang bagus.
Dialogue: 0,0:03:23.19,0:03:27.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Kagen pasti akan menyetujuinya\Njika itu Nona Miyakojima.
Dialogue: 0,0:03:27.05,0:03:30.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, jujur aku juga agak ragu, sih.
Dialogue: 0,0:03:30.03,0:03:31.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ragu?
Dialogue: 0,0:03:31.39,0:03:35.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemampuan Nona Miyakojima Narika\Ndalam bidang olahraga,
Dialogue: 0,0:03:35.37,0:03:37.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kebetulan melampaui Nona Hinako.
Dialogue: 0,0:03:37.82,0:03:42.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagi Keluarga Konohana, dia adalah\Nsaingan berat yang menghalangi jalan.
Dialogue: 0,0:03:42.68,0:03:44.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu ya.
Dialogue: 0,0:03:45.01,0:03:48.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Kagen menganggapnya sebagai ancaman?
Dialogue: 0,0:03:48.25,0:03:51.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika Narika tahu soal ini,\Ndia pasti langsung pingsan.
Dialogue: 0,0:03:51.14,0:03:53.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah masalah pelatih\Nsudah terselesaikan.
Dialogue: 0,0:03:53.66,0:03:56.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan segera saya siapkan lapangannya.
Dialogue: 0,0:03:59.54,0:04:02.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, kau ikut tenis, Tomonari?
Dialogue: 0,0:04:02.32,0:04:04.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana dengan kalian berdua?
Dialogue: 0,0:04:04.79,0:04:06.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ikut ski.
Dialogue: 0,0:04:06.23,0:04:08.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ikut dansa.
Dialogue: 0,0:04:08.20,0:04:11.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya bisa main ski\Ndi bulan-bulan begini?
Dialogue: 0,0:04:11.02,0:04:13.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sini ada fasilitas\Nyang namanya lereng ski kering.
Dialogue: 0,0:04:13.52,0:04:17.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dilengkapi dengan karpet khusus\Nyang bisa dipakai untuk main ski.
Dialogue: 0,0:04:17.57,0:04:21.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau jatuh rasanya lumayan sakit,\Njadi tak bisa meluncur terlalu cepat.
Dialogue: 0,0:04:21.19,0:04:22.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baru tahu ada yang seperti itu.
Dialogue: 0,0:04:22.87,0:04:26.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para peserta dansa akan tampil\Nsaat upacara pembukaan turnamen,
Dialogue: 0,0:04:26.95,0:04:29.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi jangan lupa tonton penampilan kami!
Dialogue: 0,0:04:29.00,0:04:30.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti kutonton!
Dialogue: 0,0:04:33.13,0:04:34.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu Konohana!
Dialogue: 0,0:04:34.36,0:04:36.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia cantik seperti biasanya!
Dialogue: 0,0:04:40.43,0:04:42.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, Hinako?
Dialogue: 0,0:04:42.84,0:04:45.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau merundingkan taktik bersama Narika.
Dialogue: 0,0:04:45.91,0:04:47.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kuantar.
Dialogue: 0,0:04:47.62,0:04:50.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak ingin insiden Tennoji\Nterulang kembali.
Dialogue: 0,0:04:50.83,0:04:53.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terutama jika itu menyangkut Miyakojima.
Dialogue: 0,0:04:53.49,0:04:54.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya kenapa?
Dialogue: 0,0:04:55.32,0:04:59.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itsuki, sikapmu sedikit berbeda\Nsaat berada di dekat Miyakojima.
Dialogue: 0,0:04:59.64,0:05:01.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berbeda? Aku?
Dialogue: 0,0:05:01.62,0:05:02.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:05:02.63,0:05:05.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau terlihat bersikap lebih natural.
Dialogue: 0,0:05:05.44,0:05:07.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Natural?
Dialogue: 0,0:05:07.90,0:05:10.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, Tomonari. Konohana.
Dialogue: 0,0:05:10.94,0:05:12.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tennoji.
Dialogue: 0,0:05:12.16,0:05:15.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian sudah tentukan\Nmau ikut cabang olahraga apa?
Dialogue: 0,0:05:16.24,0:05:18.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami berdua akan ikut tenis.
Dialogue: 0,0:05:18.50,0:05:19.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kau ikut apa, Tennoji?
Dialogue: 0,0:05:19.89,0:05:22.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ikut polo.
Dialogue: 0,0:05:22.16,0:05:23.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, polo?
Dialogue: 0,0:05:23.79,0:05:26.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah itu olahraga berkuda, ya?
Dialogue: 0,0:05:26.04,0:05:27.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:05:27.26,0:05:33.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena butuh pergerakan di area yang luas,\Nsetiap pemain harus sedia beberapa ekor kuda.
Dialogue: 0,0:05:33.22,0:05:35.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Olahraga berskala besar, ya...
Dialogue: 0,0:05:35.58,0:05:37.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sangat cocok untuk Tennoji.
Dialogue: 0,0:05:37.35,0:05:40.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu adalah olahraga\Nyang cukup indah dan memukau.
Dialogue: 0,0:05:40.66,0:05:43.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kalian berdua berminat untuk ikut?
Dialogue: 0,0:05:43.58,0:05:45.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, terima kasih.
Dialogue: 0,0:05:45.52,0:05:48.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Naik kuda saja belum pernah.
Dialogue: 0,0:05:48.38,0:05:49.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:05:50.09,0:05:54.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku bersedia untuk mengajarimu sekali lagi.
Dialogue: 0,0:05:54.54,0:05:58.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin hari-hari kita\Nbakal sangat menyenangkan.
Dialogue: 0,0:05:58.33,0:06:00.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan segala hormat, aku menolak tawaranmu.
Dialogue: 0,0:06:01.15,0:06:02.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya?
Dialogue: 0,0:06:02.84,0:06:04.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana denganmu, Tomonari?
Dialogue: 0,0:06:04.70,0:06:07.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan segala hormat,\Naku juga menolak tawaranmu.
Dialogue: 0,0:06:07.91,0:06:11.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bertanya pada Tomonari!
Dialogue: 0,0:06:11.16,0:06:15.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tomonari akan ikut cabang tenis bersamaku.
Dialogue: 0,0:06:17.09,0:06:18.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersamamu?
Dialogue: 0,0:06:18.88,0:06:21.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, bersama.
Dialogue: 0,0:06:21.02,0:06:22.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami sudah sepakat untuk berpasangan.
Dialogue: 0,0:06:26.12,0:06:31.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya urusanku denganmu\Nbelum benar-benar selesai.
Dialogue: 0,0:06:32.22,0:06:34.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, prioritasku sekarang adalah
Dialogue: 0,0:06:34.90,0:06:38.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mengantarkan timku meraih juara\Ndi cabang polo.
Dialogue: 0,0:06:38.45,0:06:40.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai jumpa, Konohana Hinako!
Dialogue: 0,0:06:43.87,0:06:45.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh!
Dialogue: 0,0:06:47.16,0:06:48.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, tanpa perlu berlama-lama lagi...
Dialogue: 0,0:06:49.37,0:06:52.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita jalankan\NRencana Melarikan Diri Narika si Penyendiri!
Dialogue: 0,0:06:52.45,0:06:53.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Si-Siap!
Dialogue: 0,0:06:54.38,0:06:56.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya kau jawab "Ya"!
Dialogue: 0,0:06:59.80,0:07:01.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sikapnya itu menggemaskan sekali...
Dialogue: 0,0:07:01.21,0:07:04.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata begini pesona dari gadis\Npaling tenar di akademi ini...
Dialogue: 0,0:07:06.67,0:07:10.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Mari kita awali\Ndengan menganalisis masalah Narika.
Dialogue: 0,0:07:11.13,0:07:12.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana menurutmu, Narika?
Dialogue: 0,0:07:12.57,0:07:13.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Te-Tentu.
Dialogue: 0,0:07:13.88,0:07:19.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama, kecuali dengan Itsuki...\NMaksudku Itsuki dan kawan-kawannya,
Dialogue: 0,0:07:19.17,0:07:20.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku ini tak punya teman.
Dialogue: 0,0:07:23.14,0:07:24.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:07:24.46,0:07:28.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kedua, tiap kali aku mencoba berinteraksi,\Nmereka langsung menjauh.
Dialogue: 0,0:07:32.77,0:07:34.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya...
Dialogue: 0,0:07:34.12,0:07:37.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Faktanya, orang-orang sudah ngeri\Nmeski aku diam saja.
Dialogue: 0,0:07:38.21,0:07:42.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiap kali aku lewat, mereka langsung minggir\Nseolah aku ini sedang membelah lautan.
Dialogue: 0,0:07:43.88,0:07:45.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah.
Dialogue: 0,0:07:45.42,0:07:47.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cukup, Narika.
Dialogue: 0,0:07:47.01,0:07:48.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemaparanmu sudah cukup jelas.
Dialogue: 0,0:07:50.09,0:07:54.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akar masalahnya adalah\Nkenapa mereka sebegitu takutnya padamu.
Dialogue: 0,0:07:54.14,0:07:57.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya semua orang\Ntelah salah sangka kepadamu.
Dialogue: 0,0:07:57.71,0:08:01.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Konohana, apa kesanmu terhadap Narika?
Dialogue: 0,0:08:01.77,0:08:03.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba kupikirkan.
Dialogue: 0,0:08:03.47,0:08:07.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dilihat-lihat, ekspresi Miyakojima\Njadi tegang saat dia sedang grogi,
Dialogue: 0,0:08:07.94,0:08:10.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan itu malah membuatnya terlihat menakutkan.
Dialogue: 0,0:08:10.50,0:08:11.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu benar.
Dialogue: 0,0:08:13.01,0:08:14.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, aku harus bagaimana?
Dialogue: 0,0:08:15.22,0:08:20.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Solusi utamanya adalah kau harus\Nbisa mengobrol santai seperti ini.
Dialogue: 0,0:08:20.78,0:08:25.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau kita buat skenario agar\Nkau bisa berteman dengan yang lain?
Dialogue: 0,0:08:26.49,0:08:29.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, kita sudah merumuskan\Ntiga taktik jitu.
Dialogue: 0,0:08:30.30,0:08:32.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita praktikkan mulai besok.
Dialogue: 0,0:08:32.46,0:08:34.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be-Besok?
Dialogue: 0,0:08:34.03,0:08:37.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu dulu! Aku masih belum siap mental.
Dialogue: 0,0:08:38.15,0:08:40.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Turnamennya tinggal tiga minggu lagi,
Dialogue: 0,0:08:40.87,0:08:43.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi tak ada waktu buat santai-santai.
Dialogue: 0,0:08:45.21,0:08:46.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Narika.
Dialogue: 0,0:08:46.64,0:08:48.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita berjuang sama-sama.
Dialogue: 0,0:08:49.51,0:08:50.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama-sama...
Dialogue: 0,0:08:51.63,0:08:54.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar. Aku punya Itsuki.
Dialogue: 0,0:08:58.23,0:09:00.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan memberikan yang terbaik!
Dialogue: 0,0:09:01.18,0:09:02.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taktik pertama.
Dialogue: 0,0:09:03.13,0:09:05.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bergabunglah dengan kelompok belajar.
Dialogue: 0,0:09:05.26,0:09:07.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tak perlu pintar ngobrol\Nuntuk ikut belajar bareng,
Dialogue: 0,0:09:07.85,0:09:09.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan karena kau sudah\Npernah belajar bareng kami,
Dialogue: 0,0:09:09.57,0:09:11.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}harusnya kau lebih mudah beradaptasi.
Dialogue: 0,0:09:12.96,0:09:17.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kebetulan sekali ada beberapa teman sekelasmu\Nyang sedang belajar kelompok.
Dialogue: 0,0:09:18.64,0:09:19.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu mereka, 'kan?
Dialogue: 0,0:09:19.59,0:09:22.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Aku jadi gugup, nih.
Dialogue: 0,0:09:22.50,0:09:24.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan begitu. Tarik napas yang dalam.
Dialogue: 0,0:09:24.73,0:09:27.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajahmu jadi seram kalau sedang gugup.
Dialogue: 0,0:09:31.03,0:09:32.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Ini dia!
Dialogue: 0,0:09:33.55,0:09:34.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pe-Permisi!
Dialogue: 0,0:09:38.83,0:09:41.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nada bicaranya berantakan...
Dialogue: 0,0:09:41.18,0:09:44.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan itu malah bikin dia makin gugup.
Dialogue: 0,0:09:44.38,0:09:47.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Ada apa, Miyakojima?
Dialogue: 0,0:09:47.20,0:09:48.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei...
Dialogue: 0,0:09:48.88,0:09:50.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eum...
Dialogue: 0,0:09:50.80,0:09:51.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pasti bisa!
Dialogue: 0,0:09:51.89,0:09:54.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eum, kulihat kalian sedang belajar.
Dialogue: 0,0:09:54.66,0:09:58.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Ya, kami sedang belajar...
Dialogue: 0,0:09:58.77,0:10:01.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bo-Bolehkah aku ikut gabung?
Dialogue: 0,0:10:01.48,0:10:02.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sip!
Dialogue: 0,0:10:03.61,0:10:05.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Bagaimana ini?
Dialogue: 0,0:10:05.69,0:10:09.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa tidak apa-apa\Nkita satu kelompok dengan Miyakojima?
Dialogue: 0,0:10:09.30,0:10:12.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, tapi mungkin dia mau mengajari kita...
Dialogue: 0,0:10:12.11,0:10:13.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya juga, ya.
Dialogue: 0,0:10:13.66,0:10:15.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, eum, itu...
Dialogue: 0,0:10:15.33,0:10:19.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nilaiku tidak cukup bagus\Nuntuk mengajari siapa pun...
Dialogue: 0,0:10:19.74,0:10:20.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:10:21.12,0:10:24.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}E-Eum, sebenarnya kami belajar
Dialogue: 0,0:10:24.12,0:10:27.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk dapat nilai tertinggi\Ndi ujian berikutnya...
Dialogue: 0,0:10:28.99,0:10:31.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maafkan aku!
Dialogue: 0,0:10:31.38,0:10:33.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itsuki!
Dialogue: 0,0:10:33.30,0:10:37.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa mereka mengira aku ini pintar?
Dialogue: 0,0:10:37.96,0:10:42.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baru ingat, dulu kami juga tak tahu\Nseberapa bagus nilaimu.
Dialogue: 0,0:10:43.14,0:10:44.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan dipikirkan.
Dialogue: 0,0:10:44.82,0:10:47.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Besok, kita coba taktik selanjutnya!
Dialogue: 0,0:10:47.99,0:10:50.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taktik pertama berujung gagal.
Dialogue: 0,0:10:52.20,0:10:55.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini kami berkumpul\Nsebelum jam masuk kelas...
Dialogue: 0,0:10:55.07,0:10:57.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taktik kedua, ubah penampilan!
Dialogue: 0,0:10:59.39,0:11:02.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Konohana, terima kasih sudah mau bantu.
Dialogue: 0,0:11:02.49,0:11:03.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama-sama.
Dialogue: 0,0:11:03.62,0:11:07.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Miyakojima memancarkan aura\Nyang mengintimidasi,
Dialogue: 0,0:11:07.93,0:11:10.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}makanya aku ingin memberinya kesan\Nyang lebih lembut.
Dialogue: 0,0:11:10.64,0:11:12.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuserahkan semuanya padamu!
Dialogue: 0,0:11:12.51,0:11:15.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku terinspirasi taktik ini\Ndari melihat Hinako.
Dialogue: 0,0:11:15.60,0:11:18.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena dia sangat jago\Ndalam hal mengubah penampilan.
Dialogue: 0,0:11:19.63,0:11:21.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada masalah?
Dialogue: 0,0:11:21.06,0:11:22.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak!
Dialogue: 0,0:11:22.99,0:11:24.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana menurutmu, Narika?
Dialogue: 0,0:11:25.17,0:11:29.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jantungku rasanya mau copot,\Ntapi kurasa aku bisa melewatinya.
Dialogue: 0,0:11:36.60,0:11:40.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetap saja, bukankah ini terlalu longgar, ya?
Dialogue: 0,0:11:40.35,0:11:42.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi merasa agak risih...
Dialogue: 0,0:11:42.73,0:11:43.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei!
Dialogue: 0,0:11:44.49,0:11:47.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tak boleh mengancingkan kerahnya.
Dialogue: 0,0:11:52.28,0:11:53.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh!
Dialogue: 0,0:11:54.65,0:11:58.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Po-Pokoknya, aku tinggal masuk kelas\Ndengan gaya begini?
Dialogue: 0,0:11:58.62,0:12:00.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Masuklah.
Dialogue: 0,0:12:05.80,0:12:07.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Dia tidak ada di sini.
Dialogue: 0,0:12:07.96,0:12:09.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itsuki!
Dialogue: 0,0:12:11.59,0:12:14.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Narika! Ada apa dengan penampilanmu?
Dialogue: 0,0:12:14.58,0:12:18.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah berpisah dengan kalian,\Ndi tengah jalan menuju kelasku,
Dialogue: 0,0:12:18.43,0:12:20.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku terlalu gugup sampai-sampai\Ntersandung dan jatuh.
Dialogue: 0,0:12:20.93,0:12:25.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak menyadarinya,\Ntahu-tahu penampilanku sudah jadi begini.
Dialogue: 0,0:12:25.60,0:12:27.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kayak preman habis tawuran...
Dialogue: 0,0:12:28.06,0:12:31.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seorang guru memergokiku,\Ndan aku disidang di ruang BK sampai sekarang.
Dialogue: 0,0:12:31.67,0:12:33.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau dimarahi?
Dialogue: 0,0:12:33.24,0:12:34.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:12:34.33,0:12:38.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan sangat hati-hati,\Naku ditanya dengan siapa aku berkelahi.
Dialogue: 0,0:12:38.52,0:12:40.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Guna menaksir biaya pengobatan korban,
Dialogue: 0,0:12:40.82,0:12:44.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mereka ingin tahu\Nseberapa parah luka yang kuberikan.
Dialogue: 0,0:12:44.37,0:12:47.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan guru pun takut padamu?
Dialogue: 0,0:12:47.24,0:12:51.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biarpun mereka berasumsi aku habis berkelahi,
Dialogue: 0,0:12:51.10,0:12:55.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kenapa tak terlintas di pikiran mereka\Nkalau aku bisa saja pihak yang babak belur?
Dialogue: 0,0:12:55.98,0:12:57.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita lanjut.
Dialogue: 0,0:12:58.22,0:13:01.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taktik kedua gagal total.
Dialogue: 0,0:13:06.14,0:13:07.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taktik ketiga.
Dialogue: 0,0:13:08.01,0:13:10.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berikan citra yang sesantai mungkin,
Dialogue: 0,0:13:10.30,0:13:12.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk membuatnya terlihat ramah.
Dialogue: 0,0:13:12.76,0:13:17.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai putri Miyakojima, orang menganggapnya\Nsebagai jagoan bela diri yang angkuh,
Dialogue: 0,0:13:18.29,0:13:22.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi ini akan membuka mata mereka bahwa\NNarika itu seperti orang pada umumnya.
Dialogue: 0,0:13:22.42,0:13:24.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kenapa harus permen?
Dialogue: 0,0:13:24.42,0:13:29.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Narika menyarankannya supaya orang-orang\Nbisa bernostalgia dan memicu obrolan.
Dialogue: 0,0:13:29.67,0:13:32.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia hobi makan jajanan warung\Nsejak masih kecil.
Dialogue: 0,0:13:40.06,0:13:42.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak ada yang mengajaknya bicara.
Dialogue: 0,0:13:42.94,0:13:44.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau benar.
Dialogue: 0,0:13:44.46,0:13:48.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka memperhatikannya, jadi kalau\Npersepsi mereka tentangnya sedikit berubah,
Dialogue: 0,0:13:48.26,0:13:50.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}itu sudah jadi pertanda bagus...
Dialogue: 0,0:13:52.40,0:13:54.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mi-Miyakojima.
Dialogue: 0,0:13:54.68,0:13:57.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu rokok?
Dialogue: 0,0:14:00.68,0:14:03.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tu-Tunggu! Kalian salah paham!
Dialogue: 0,0:14:03.49,0:14:06.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat! Ini permen lolipop!
Dialogue: 0,0:14:06.35,0:14:09.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku mana paham soal merek rokok!
Dialogue: 0,0:14:09.06,0:14:11.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya kubilang ini bukan rokok!
Dialogue: 0,0:14:11.73,0:14:13.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan rokok?
Dialogue: 0,0:14:13.91,0:14:15.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu narkoba?!
Dialogue: 0,0:14:15.78,0:14:18.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Imajinasi mereka kelewat batas!
Dialogue: 0,0:14:18.39,0:14:22.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Murid di akademi kita\Nmemang jarang makan jajanan begitu.
Dialogue: 0,0:14:22.63,0:14:26.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku tak melihat apa-apa!
Dialogue: 0,0:14:27.59,0:14:28.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu!
Dialogue: 0,0:14:28.83,0:14:31.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat! Aku bakal jelaskan semuanya!
Dialogue: 0,0:14:34.69,0:14:37.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini juga gara-garaku?
Dialogue: 0,0:14:38.27,0:14:41.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejujurnya, aku terlalu meremehkan situasi.
Dialogue: 0,0:14:41.24,0:14:44.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak kusangka reputasinya seburuk itu.
Dialogue: 0,0:14:44.77,0:14:47.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taktik ketiga berujung bencana!
Dialogue: 0,0:14:48.96,0:14:53.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti, ketiga taktik telah gagal total...
Dialogue: 0,0:14:54.10,0:14:55.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu bagaimana?
Dialogue: 0,0:14:55.58,0:14:58.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yang butuh bantuan, jadi mungkin\Ntak sepantasnya aku bilang begini...
Dialogue: 0,0:14:59.11,0:15:01.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi tak usah terlalu dipusingkan.
Dialogue: 0,0:15:02.33,0:15:05.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kubalas budi kalian besok.
Dialogue: 0,0:15:05.21,0:15:06.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Balas budi?
Dialogue: 0,0:15:06.53,0:15:09.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita kan belum membuahkan hasil apa pun.
Dialogue: 0,0:15:09.14,0:15:11.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, aku takkan bisa\Nmelakukan semua ini sendirian.
Dialogue: 0,0:15:11.86,0:15:15.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian berdua sangat membantuku.
Dialogue: 0,0:15:17.71,0:15:22.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seandainya orang lain bisa melihat senyumnya\Nyang seperti ini, itu sudah cukup...
Dialogue: 0,0:15:23.42,0:15:28.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keesokan harinya adalah hari Sabtu,\Njadwal perdana latihan tenis bersama Narika.
Dialogue: 0,0:15:40.47,0:15:43.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka berdua jago banget!
Dialogue: 0,0:15:46.20,0:15:48.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itsuki, giliranmu.
Dialogue: 0,0:15:48.18,0:15:52.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hinako, kau ini hebat olahraga\Nselain pintar pelajaran, ya?
Dialogue: 0,0:15:52.18,0:15:55.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Olahraga itu bikin capek,\Njadi aku kurang suka.
Dialogue: 0,0:15:55.48,0:15:57.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi saat ini, aku butuh bakar lemak...
Dialogue: 0,0:15:57.37,0:15:58.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:15:58.30,0:15:59.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lupakan saja.
Dialogue: 0,0:16:07.41,0:16:11.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya kau belum pernah tanding sungguhan,\Ntapi permainanmu lumayan juga.
Dialogue: 0,0:16:11.70,0:16:12.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:16:12.99,0:16:14.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:16:14.05,0:16:17.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau rajin latihan,\Nkau bisa meraih hasil bagus di turnamen.
Dialogue: 0,0:16:17.30,0:16:18.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah kalau begitu.
Dialogue: 0,0:16:18.84,0:16:21.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ada yang harus kuperbaiki?
Dialogue: 0,0:16:21.99,0:16:25.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kusimpan saranku\Nsampai kita selesai berlatih.
Dialogue: 0,0:16:25.33,0:16:27.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu akan lebih efektif.
Dialogue: 0,0:16:27.61,0:16:29.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa diandalkan sekali.
Dialogue: 0,0:16:29.98,0:16:33.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belum pernah bilang pada Narika,\Ntapi saat pertama kali bertemu dengannya,
Dialogue: 0,0:16:33.72,0:16:36.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku sangat kagum melihat betapa fokusnya\Ndia mengayunkan pedang kendo.
Dialogue: 0,0:16:37.91,0:16:39.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesan itu masih kurasakan sampai sekarang.
Dialogue: 0,0:16:39.43,0:16:41.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sungguh keren dan berkharisma.
Dialogue: 0,0:16:42.53,0:16:44.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, ayo kita rehat sejenak.
Dialogue: 0,0:16:46.44,0:16:49.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah bergerak tanpa henti\Nselama 90 menit...
Dialogue: 0,0:16:50.03,0:16:53.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Staminanya jauh lebih gila\Ndaripada staminaku...
Dialogue: 0,0:16:53.05,0:16:54.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau masih kuat, Itsuki?
Dialogue: 0,0:16:54.86,0:16:57.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, sedikit lagi.
Dialogue: 0,0:16:57.31,0:17:00.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itsuki, kau harus fokus\Npada variasi tembakan dan targetmu.
Dialogue: 0,0:17:00.95,0:17:04.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Secara refleks, kau memukul bola\Nke arah tengah lapangan lawan.
Dialogue: 0,0:17:04.65,0:17:07.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau harus sebar arah pukulanmu\Nke kiri dan ke kanan.
Dialogue: 0,0:17:07.28,0:17:08.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:17:08.82,0:17:12.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Adapun Konohana, kau luar biasa,\Njujur aku tak perlu mengajarimu apa pun.
Dialogue: 0,0:17:12.78,0:17:15.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belum sehebat dirimu, Miyakojima.
Dialogue: 0,0:17:15.69,0:17:17.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan terlalu merendah.
Dialogue: 0,0:17:17.61,0:17:20.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pukulan servis dan pengembalianmu\Nsangat stabil,
Dialogue: 0,0:17:20.00,0:17:21.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bahkan kau juga bisa\Nmelakukan voli dengan mulus.
Dialogue: 0,0:17:21.96,0:17:24.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat tanpa kelemahan berarti,\Nmemang layak disandang Konohana.
Dialogue: 0,0:17:25.84,0:17:30.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, kelemahanmu ada\Nsaat mengembalikan bola tinggi.
Dialogue: 0,0:17:30.41,0:17:31.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terutama pukulan backhand.
Dialogue: 0,0:17:32.21,0:17:35.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kau jago voli,\Nkau jadi terlalu sering maju ke depan net...
Dialogue: 0,0:17:36.14,0:17:40.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dalam urusan olahraga,\NNarika benar-benar ahli.
Dialogue: 0,0:17:40.51,0:17:44.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mungkin tak menyadarinya,\Ntapi dia bisa ngobrol santai dengan Hinako.
Dialogue: 0,0:17:48.14,0:17:49.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Taktik baru?
Dialogue: 0,0:17:49.79,0:17:50.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:17:50.71,0:17:54.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau kau coba obrolin soal\Nturnamen olahraga ini dengan yang lain?
Dialogue: 0,0:17:54.05,0:17:56.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meskipun aku trauma soal itu?
Dialogue: 0,0:17:56.46,0:18:01.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bahas soal olahraga, keahlianmu,\Nkurasa kau bisa lebih luwes bicara.
Dialogue: 0,0:18:01.03,0:18:04.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aura bahagiamu memancar waktu\Nmengajari kami tenis tadi.
Dialogue: 0,0:18:05.03,0:18:06.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa, sih?
Dialogue: 0,0:18:06.05,0:18:08.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ucapanmu terdengar sangat meyakinkan.
Dialogue: 0,0:18:08.47,0:18:10.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be-Begitu ya.
Dialogue: 0,0:18:10.14,0:18:12.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bahkan sudah bisa ngobrol normal\Ndengan Konohana.
Dialogue: 0,0:18:13.71,0:18:15.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kau mengungkitnya, iya juga, ya...
Dialogue: 0,0:18:16.19,0:18:20.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuyakin membahas turnamen ini bakal\Njadi pembuka obrolan yang pas.
Dialogue: 0,0:18:21.85,0:18:23.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kucoba.
Dialogue: 0,0:18:24.46,0:18:28.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf sudah banyak merepotkanmu, Hinako.
Dialogue: 0,0:18:29.35,0:18:32.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi sedikit bersimpati\Nterhadap Miyakojima.
Dialogue: 0,0:18:32.45,0:18:38.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cara orang menilai kami berdua jauh\Nberbeda dari sifat asli kami.
Dialogue: 0,0:18:40.66,0:18:42.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ka-Kalian!
Dialogue: 0,0:18:42.96,0:18:47.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ta-Tahun lalu, kalian ambil bagian kendo\Nuntuk turnamen olahraga, 'kan?
Dialogue: 0,0:18:47.10,0:18:48.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:18:48.82,0:18:50.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kalian ikut lagi tahun ini?
Dialogue: 0,0:18:50.63,0:18:52.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya...
Dialogue: 0,0:18:53.07,0:18:56.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga takkan membiarkan\Ndiriku kalah tahun ini.
Dialogue: 0,0:18:58.10,0:18:59.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ampun!
Dialogue: 0,0:18:59.14,0:19:00.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengaku kalah!
Dialogue: 0,0:19:01.11,0:19:02.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau menakut-nakuti mereka?
Dialogue: 0,0:19:03.71,0:19:06.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya kau memang benar-benar grogi.
Dialogue: 0,0:19:06.70,0:19:08.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Haruskah kita rombak ulang strategi kita?
Dialogue: 0,0:19:08.79,0:19:11.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, akan kucoba sekali lagi.
Dialogue: 0,0:19:11.52,0:19:16.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisakah kau bicara dengan orang lain\Nlayaknya kau bicara denganku sekarang?
Dialogue: 0,0:19:16.73,0:19:19.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ku-Kurasa itu agak sulit.
Dialogue: 0,0:19:19.65,0:19:23.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau orang itu mirip denganku?
Dialogue: 0,0:19:23.37,0:19:26.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, percuma kalau mirip denganmu juga.
Dialogue: 0,0:19:26.91,0:19:30.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagiku, cuma kau satu-satunya, Itsuki.
Dialogue: 0,0:19:32.87,0:19:34.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada orang yang lewat.
Dialogue: 0,0:19:35.68,0:19:40.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, dia teman sekelasku,\Ndan kebetulan jago olahraga.
Dialogue: 0,0:19:40.40,0:19:43.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baguslah. Siapa tahu kalian berdua nyambung.
Dialogue: 0,0:19:43.69,0:19:46.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, bagaimana kalau kau coba\Nmengobrol dengannya?
Dialogue: 0,0:19:47.50,0:19:48.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}E-Eum...
Dialogue: 0,0:19:49.74,0:19:52.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tahun kemarin, kau ikut cabang kendo\Nuntuk turnamen olahraga, 'kan?
Dialogue: 0,0:19:53.22,0:19:54.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, benar.
Dialogue: 0,0:19:54.53,0:19:57.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eum, kau pakai perlengkapan apa?
Dialogue: 0,0:19:58.47,0:20:00.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa urusannya denganmu?
Dialogue: 0,0:20:00.44,0:20:03.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Iya juga, ya...
Dialogue: 0,0:20:05.32,0:20:07.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, aku lagi sibuk.
Dialogue: 0,0:20:11.07,0:20:13.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa gara-gara wajahku?
Dialogue: 0,0:20:13.87,0:20:15.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ada yang salah dengan wajahku?
Dialogue: 0,0:20:15.67,0:20:18.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, tak ada yang salah denganmu, Narika.
Dialogue: 0,0:20:19.43,0:20:21.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu di sini sebentar.
Dialogue: 0,0:20:25.17,0:20:26.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa minta waktumu sebentar?
Dialogue: 0,0:20:28.55,0:20:29.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:20:29.78,0:20:31.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi aku melihatnya.
Dialogue: 0,0:20:31.79,0:20:34.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sikapmu tadi tak pantas.
Dialogue: 0,0:20:36.05,0:20:37.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini tak ada urusannya denganmu.
Dialogue: 0,0:20:37.76,0:20:39.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada urusannya.
Dialogue: 0,0:20:39.49,0:20:41.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku teman Narika.
Dialogue: 0,0:20:41.58,0:20:44.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Narika itu tak seperti\Nyang kalian pikirkan selama ini.
Dialogue: 0,0:20:45.18,0:20:48.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak memaksamu untuk akrab dengannya\Nkalau memang tak sejalan.
Dialogue: 0,0:20:48.72,0:20:51.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, tak perlu juga bersikap sejutek itu.
Dialogue: 0,0:20:51.61,0:20:55.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gimana kalau rumor seram tentangnya itu\Nternyata benar?
Dialogue: 0,0:20:56.89,0:20:59.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang tuaku mewanti-wanti berulang kali.
Dialogue: 0,0:21:00.33,0:21:02.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Jangan cari gara-gara sama keluarga kaya."
Dialogue: 0,0:21:02.86,0:21:06.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Bikin mereka kesal sedikit saja,\Nkeluarga kita bisa dibikin hancur lebur."
Dialogue: 0,0:21:08.73,0:21:13.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata siswa di sini juga memikirkan\Nhal-hal memusingkan seperti itu?
Dialogue: 0,0:21:13.50,0:21:15.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau Tomonari dari kelas A, 'kan?
Dialogue: 0,0:21:15.91,0:21:16.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pernah dengar gosipmu.
Dialogue: 0,0:21:18.17,0:21:22.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa jadi penjilat andal sepertimu itu\Nbutuh keahlian khusus.
Dialogue: 0,0:21:23.09,0:21:24.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pe-Penjilat?
Dialogue: 0,0:21:25.79,0:21:28.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inikah yang dipikirkan semua orang tentangku?
Dialogue: 0,0:21:29.17,0:21:30.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu sebentar.
Dialogue: 0,0:21:30.79,0:21:35.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah ini artinya masalahku juga\Nsama besarnya dengan masalah Narika?
Dialogue: 0,0:21:38.67,0:21:41.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tindak-tandukku memang pantas\Ndisebut penjilat, sih...
Dialogue: 0,0:21:42.88,0:21:48.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hinako, Tennoji, dan Narika,\Nsemuanya adalah siswi elite di sini...
Dialogue: 0,0:21:48.71,0:21:52.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ikut serta dalam acara pesta teh\Nserta belajar bareng mereka.
Dialogue: 0,0:21:53.38,0:21:55.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja aku jadi pusat perhatian.
Dialogue: 0,0:21:55.56,0:21:59.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meskipun kami beda kelas,\Ndia tahu identitasku.
Dialogue: 0,0:22:00.28,0:22:05.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan kata lain, aku tak pantas\Nmendampingi Hinako dan yang lainnya.
Dialogue: 0,0:22:08.80,0:22:11.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lantas, apakah keberadaanku\Ndi sisi mereka ini keliru?
Dialogue: 0,0:22:11.30,0:22:12.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itsuki...
Dialogue: 0,0:22:14.87,0:22:16.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hinako?
Dialogue: 0,0:22:16.33,0:22:18.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak kapan kau di situ?
Dialogue: 0,0:22:18.26,0:22:20.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lumayan lama.
Dialogue: 0,0:22:20.14,0:22:22.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku minta Shizune untuk mengantarku ke sini.
Dialogue: 0,0:22:22.69,0:22:25.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sama sekali tak menyadarinya.
Dialogue: 0,0:22:25.03,0:22:28.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itsuki, keningmu sampai berkerut begitu.
Dialogue: 0,0:22:30.18,0:22:31.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku lagi banyak pikiran.
Dialogue: 0,0:22:33.68,0:22:34.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, Hinako.
Dialogue: 0,0:22:34.98,0:22:38.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau sungguh ingin terus bersamaku,\Nbahkan di sekolah sekalipun?
Dialogue: 0,0:22:38.75,0:22:39.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:22:39.67,0:22:42.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin selalu bersamamu, Itsuki.
Dialogue: 0,0:22:44.16,0:22:46.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selalu, ya?
Dialogue: 0,0:22:47.60,0:22:50.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah. Aku akan berusaha sekuat tenaga.
Dialogue: 0,0:22:50.08,0:22:52.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus mendapatkan\Nrestu dari banyak orang.
Dialogue: 0,0:22:54.23,0:22:57.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, kuantar kau kembali\Nke kamarmu sekarang.
Dialogue: 0,0:22:57.07,0:22:58.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:23:03.84,0:23:06.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku masih bingung dengan\Napa yang harus kulakukan.
Dialogue: 0,0:23:07.17,0:23:09.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu hal yang pasti,\Naku takkan pernah mundur lagi.
