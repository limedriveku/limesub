Dialogue: 0,0:00:36.89,0:00:38.11,sign,,0000,0000,0000,,ILMU INFORMASI I
Dialogue: 0,0:01:17.50,0:01:19.20,sign,,0000,0000,0000,,KITA YUSUKE
Dialogue: 0,0:04:12.54,0:04:16.14,sign,,0000,0000,0000,,"EPISODE 11: PERTARUNGAN PARA NONA"
Dialogue: 0,0:00:06.79,0:00:13.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sembari membantu Narika mencari teman,\Naku perlahan menyadari kekuranganku.
Dialogue: 0,0:00:16.99,0:00:19.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau Kita, 'kan?
Dialogue: 0,0:00:20.51,0:00:23.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, ya. Ada apa?
Dialogue: 0,0:00:23.79,0:00:26.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namaku Tomonari.
Dialogue: 0,0:00:26.13,0:00:29.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, ada sesuatu yang mau kutanyakan.
Dialogue: 0,0:00:29.00,0:00:31.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Kepadaku?
Dialogue: 0,0:00:31.09,0:00:35.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita, kudengar kau ahli\Ndi bidang ilmu informasi.
Dialogue: 0,0:00:35.11,0:00:36.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau bersedia\Nmengajariku tentang hal itu?
Dialogue: 0,0:00:38.12,0:00:41.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semalam, aku mengobrol dengan Shizune.
Dialogue: 0,0:00:41.38,0:00:42.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:00:42.94,0:00:45.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sudah melangkah cukup jauh.
Dialogue: 0,0:00:45.36,0:00:46.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:00:46.34,0:00:49.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua pengurus Nona sebelumnya\Nmundur dalam hitungan hari.
Dialogue: 0,0:00:49.90,0:00:53.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau adalah orang pertama yang peduli\Ndengan pergaulan Nona di sekolah.
Dialogue: 0,0:00:54.99,0:00:57.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita rencanakan masa depanmu\Nbersama-sama.
Dialogue: 0,0:00:57.81,0:01:02.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana caranya agar kau bisa membaur\Nsebagai murid Akademi Kiou?
Dialogue: 0,0:01:03.25,0:01:04.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:01:04.53,0:01:06.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutku, langkah pertamanya\Nadalah memperluas pergaulan.
Dialogue: 0,0:01:06.98,0:01:11.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita jadikan mencari teman baru\Nsebagai target awalmu.
Dialogue: 0,0:01:11.14,0:01:12.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masuk akal.
Dialogue: 0,0:01:12.76,0:01:15.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pernah memberimu\Ndaftar teman sekelas, bukan?
Dialogue: 0,0:01:15.98,0:01:17.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, ya.
Dialogue: 0,0:01:19.21,0:01:23.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau kau coba berbaur dengannya?
Dialogue: 0,0:01:23.47,0:01:28.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita Yusuke,\Nputra direktur utama perusahaan IT.
Dialogue: 0,0:01:28.57,0:01:30.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Latar belakang kalian serupa, Tuan Itsuki.
Dialogue: 0,0:01:30.97,0:01:33.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau ada belajar topik seputar IT, 'kan?
Dialogue: 0,0:01:33.65,0:01:37.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi pengetahuanku masih sangat dangkal.
Dialogue: 0,0:01:37.02,0:01:40.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin pembohong sepertiku\Nberani ngobrol dengannya.
Dialogue: 0,0:01:41.43,0:01:43.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pembohong?
Dialogue: 0,0:01:44.59,0:01:49.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau kau serius belajar\Ndengan tekad terjun ke bisnis IT?
Dialogue: 0,0:01:49.85,0:01:51.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudmu, aku?
Dialogue: 0,0:01:51.60,0:01:53.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, tentu saja.
Dialogue: 0,0:01:54.13,0:01:55.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya...
Dialogue: 0,0:01:55.53,0:01:57.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku paham sekarang.
Dialogue: 0,0:01:57.74,0:02:01.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesuai dugaanku,\Nkemampuannya jauh di atasku.
Dialogue: 0,0:02:01.08,0:02:03.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa aku bisa mengejar ketertinggalan ini?
Dialogue: 0,0:02:03.55,0:02:05.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jujur, aku agak kaget, lo.
Dialogue: 0,0:02:06.18,0:02:09.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak kusangka kau bakal\Nmengajakku ngobrol duluan, Tomonari.
Dialogue: 0,0:02:11.17,0:02:14.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eum, apa diriku terkesan aneh?
Dialogue: 0,0:02:15.51,0:02:17.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eum, itu...
Dialogue: 0,0:02:17.42,0:02:19.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak bisa menyangkalnya, sih...
Dialogue: 0,0:02:21.29,0:02:22.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga.
Dialogue: 0,0:02:22.74,0:02:25.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya, sejak awal kepindahanmu,
Dialogue: 0,0:02:25.23,0:02:27.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau selalu bareng Konohana,
Dialogue: 0,0:02:27.38,0:02:31.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi kukira kau tak sudi\Nbergaul dengan kaum biasa seperti kami.
Dialogue: 0,0:02:31.24,0:02:33.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, sama sekali tak begitu.
Dialogue: 0,0:02:33.38,0:02:37.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dan asal kau tahu,\Nkalian itu bukan "kaum biasa".
Dialogue: 0,0:02:38.98,0:02:42.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, Kita...
Dialogue: 0,0:04:00.60,0:04:03.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rich Girl Caretaker
Dialogue: 0,0:04:03.27,0:04:08.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I'm Secretly the Caregiver of the\NMost Popular Girl in This Rich Kid School
Dialogue: 0,0:04:12.54,0:04:16.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya aku berhasil melangkah maju.
Dialogue: 0,0:04:16.55,0:04:20.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa ini sudah merangkum semua materi\Nyang perlu kau pelajari ke depannya.
Dialogue: 0,0:04:20.74,0:04:24.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah mengajariku banyak hal.
Dialogue: 0,0:04:24.84,0:04:29.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh ya, apa kau sudah terpikir\Ningin jadi direktur yang seperti apa kelak?
Dialogue: 0,0:04:29.94,0:04:32.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum, sih...
Dialogue: 0,0:04:32.46,0:04:36.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku ingin membekali diriku\Ndengan wawasan teknologi yang mumpuni.
Dialogue: 0,0:04:36.62,0:04:39.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak ingin dicap\Nhanya mendompleng kesuksesan orang tuaku.
Dialogue: 0,0:04:39.95,0:04:41.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sesi belajar ini bikin aku termotivasi.
Dialogue: 0,0:04:41.99,0:04:45.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melihat semangatmu, Tomonari,\Naku juga jadi ingin berusaha lebih keras.
Dialogue: 0,0:04:45.60,0:04:47.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senang mendengarnya.
Dialogue: 0,0:04:47.57,0:04:50.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, turnamen olahraga\Nsudah di depan mata, ya.
Dialogue: 0,0:04:51.29,0:04:53.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejujurnya, aku jadi agak suntuk.
Dialogue: 0,0:04:54.26,0:04:57.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harusnya itu menyenangkan.\NKau kelihatan cukup gesit, lo.
Dialogue: 0,0:04:57.53,0:05:03.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, lawan-lawanku jago semua.\NAku ragu bisa mengimbangi mereka.
Dialogue: 0,0:05:03.62,0:05:08.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, kalau kau bilang begitu,\Nberarti aku tak punya harapan sama sekali...
Dialogue: 0,0:05:09.04,0:05:11.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itsuki! Ternyata benar kau, Itsuki!
Dialogue: 0,0:05:11.78,0:05:13.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Narika, kau masih di sini?
Dialogue: 0,0:05:13.93,0:05:17.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ke sini buat mengecek perlengkapan senam\Nsebagai bagian dari urusan keluargaku...
Dialogue: 0,0:05:18.79,0:05:20.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah! H-Halo.
Dialogue: 0,0:05:20.66,0:05:23.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namaku... Miyakojima Narika.
Dialogue: 0,0:05:24.19,0:05:26.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita Yusuke.
Dialogue: 0,0:05:28.06,0:05:29.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh ya, Narika.
Dialogue: 0,0:05:29.48,0:05:33.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutmu, apa kunci\Nagar bisa mencetak hasil bagus di turnamen?
Dialogue: 0,0:05:34.61,0:05:38.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}U-Untuk itu, tak ada jalan pintas\Nselain latihan dengan giat...
Dialogue: 0,0:05:38.54,0:05:42.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi menurutku pribadi,\Nkau tak perlu terlalu memikirkan soal hasil.
Dialogue: 0,0:05:42.53,0:05:45.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutku, memprioritaskan hasil\Ndalam olahraga bukan hal yang wajib.
Dialogue: 0,0:05:45.81,0:05:48.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya segelintir orang\Nyang akan menjadikannya sebagai profesi.
Dialogue: 0,0:05:48.58,0:05:52.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, membiasakan diri melatih fisik\Ntentu tak ada ruginya.
Dialogue: 0,0:05:52.60,0:05:57.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anggap saja turnamen ini kayak gim,\Ndan tubuhmu adalah konsolnya.
Dialogue: 0,0:05:58.34,0:06:00.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makin tinggi performa konsolmu,
Dialogue: 0,0:06:00.36,0:06:02.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}makin banyak jenis gim\Nyang bisa kau taklukkan.
Dialogue: 0,0:06:04.42,0:06:06.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maaf.
Dialogue: 0,0:06:06.12,0:06:08.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku biasa mengajar anak-anak\Ndi dojo milik keluargaku,
Dialogue: 0,0:06:09.07,0:06:12.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan saat mereka bertanya,\Nbeginilah cara bicaraku...
Dialogue: 0,0:06:13.85,0:06:17.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku masih ada kerjaan.\NPermisi dulu!
Dialogue: 0,0:06:19.22,0:06:21.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keren sekali...
Dialogue: 0,0:06:22.15,0:06:24.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, maaf...
Dialogue: 0,0:06:24.63,0:06:27.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau memanggilnya\Ndengan nama depannya, Tomonari?
Dialogue: 0,0:06:27.88,0:06:30.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, sebenarnya kami itu kerabat jauh.
Dialogue: 0,0:06:30.59,0:06:31.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, ya?
Dialogue: 0,0:06:32.37,0:06:37.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata, ngobrol dengan Miyakojima\Ntak seseram yang kubayangkan.
Dialogue: 0,0:06:39.95,0:06:43.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Langkah kecil itu\Nperlahan mulai membuahkan hasil.
Dialogue: 0,0:06:45.62,0:06:47.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, Tomonari.
Dialogue: 0,0:06:47.57,0:06:49.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita, terima kasih\Natas bantuanmu kemarin, ya.
Dialogue: 0,0:06:49.87,0:06:51.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kebetulan sekali kita bertemu.\NBiar aku kenalkan kalian berdua.
Dialogue: 0,0:06:51.91,0:06:53.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini Suma dari kelas B.
Dialogue: 0,0:06:53.78,0:06:57.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama sepertiku,\Nkeluarganya juga bergerak di bisnis IT.
Dialogue: 0,0:06:57.15,0:06:59.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia ingin merintis bisnisnya sendiri,
Dialogue: 0,0:06:59.04,0:07:02.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}siapa tahu dia bisa memberimu\Nperspektif yang berbeda dariku.
Dialogue: 0,0:07:02.02,0:07:04.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salam kenal. Namaku Tomonari.
Dialogue: 0,0:07:04.61,0:07:05.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salam kenal juga.
Dialogue: 0,0:07:05.74,0:07:11.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tomonari, maksudnya murid yang diisukan\Npunya kedekatan dengan Miyakojima?
Dialogue: 0,0:07:11.17,0:07:13.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, mungkin aku orangnya.
Dialogue: 0,0:07:13.42,0:07:17.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Miyakojima tak seseram yang digosipkan, kok.
Dialogue: 0,0:07:17.56,0:07:19.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mana mungkin, kau bercanda, 'kan?
Dialogue: 0,0:07:19.66,0:07:21.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku serius.
Dialogue: 0,0:07:21.11,0:07:24.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kata Tomonari,\Ndia hobi jajan, sama kayak orang biasa.
Dialogue: 0,0:07:24.83,0:07:27.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Miyakojima? Suka jajan?
Dialogue: 0,0:07:27.26,0:07:27.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:07:28.30,0:07:30.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia juga punya sisi yang suportif.
Dialogue: 0,0:07:30.42,0:07:31.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutku, dia orang yang hebat.
Dialogue: 0,0:07:31.88,0:07:33.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya...
Dialogue: 0,0:07:33.69,0:07:37.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Persepsi terhadap Narika pun mulai bergeser,\Nsedikit demi sedikit.
Dialogue: 0,0:07:39.15,0:07:41.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itsuki! Konohana!
Dialogue: 0,0:07:44.28,0:07:45.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, Narika?
Dialogue: 0,0:07:45.74,0:07:47.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba tebak!
Dialogue: 0,0:07:47.36,0:07:50.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi, ada salah satu teman sekelas\Nyang nyapa aku duluan!
Dialogue: 0,0:07:52.70,0:07:57.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa dia itu teman yang kemarin belajar\Nbareng Itsuki sepulang sekolah.
Dialogue: 0,0:07:57.74,0:07:59.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, selamat ya.
Dialogue: 0,0:07:59.17,0:08:01.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, aku senang sekali.
Dialogue: 0,0:08:01.70,0:08:04.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa merasakan\Nkehangatan hubungan antarmanusia...
Dialogue: 0,0:08:06.67,0:08:08.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedikit demi sedikit...
Dialogue: 0,0:08:08.63,0:08:12.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Miyakojima sepertinya\Nmulai berubah akhir-akhir ini.
Dialogue: 0,0:08:12.51,0:08:13.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:08:13.19,0:08:17.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia lebih asyik daripada bayanganku.\NSama sekali tak menakutkan.
Dialogue: 0,0:08:17.22,0:08:18.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perlahan tapi pasti...
Dialogue: 0,0:08:19.35,0:08:20.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itsuki!
Dialogue: 0,0:08:21.81,0:08:24.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau kelihatan senang sekali, Narika.
Dialogue: 0,0:08:24.14,0:08:25.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:08:25.11,0:08:27.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asal kau tahu, ada teman sekelas lain\Nyang ngobrol denganku hari ini.
Dialogue: 0,0:08:29.51,0:08:33.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah merasakan indahnya persahabatan,\Naku merasa tak terkalahkan!
Dialogue: 0,0:08:33.46,0:08:37.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, bagaimana kalau berikutnya\Nkau yang mencoba menyapa duluan?
Dialogue: 0,0:08:37.37,0:08:41.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan anak dari kelas lain pun,\Nkayaknya kau bakal lancar sekarang.
Dialogue: 0,0:08:41.99,0:08:43.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bo-Boleh juga.
Dialogue: 0,0:08:43.78,0:08:45.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, akan kucoba!
Dialogue: 0,0:08:45.80,0:08:47.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari awal pun sepertinya ide ini\Nbakal berujung gagal...
Dialogue: 0,0:08:48.58,0:08:51.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}He-Hei, kau!
Dialogue: 0,0:08:51.02,0:08:51.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ampun!
Dialogue: 0,0:08:53.19,0:08:55.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maafkan aku!
Dialogue: 0,0:08:57.86,0:08:59.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa jadinya begini?
Dialogue: 0,0:08:59.22,0:09:01.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tampaknya sulit untuk langsung mengubah rumor
Dialogue: 0,0:09:01.79,0:09:04.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang sudah telanjur menyebar\Nke seluruh sekolah...
Dialogue: 0,0:09:05.59,0:09:08.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Turnamen olahraga tinggal\Nsekitar seminggu lagi.
Dialogue: 0,0:09:08.84,0:09:12.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin kau butuh kesempatan memperlihatkan\Nsisi dirimu yang sebenarnya di depan umum.
Dialogue: 0,0:09:12.94,0:09:17.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudmu, melakukan sebuah aksi\Ndi tempat yang jadi sorotan semua orang?
Dialogue: 0,0:09:18.15,0:09:20.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak suka jadi pusat perhatian...
Dialogue: 0,0:09:20.09,0:09:21.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga...
Dialogue: 0,0:09:21.83,0:09:24.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus memutar otak mencari ide brilian.
Dialogue: 0,0:09:25.81,0:09:28.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak usah, kau sudah\Nmelakukan banyak hal untukku.
Dialogue: 0,0:09:29.09,0:09:32.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada akhirnya, aku sendirilah\Nyang harus melangkah secara perlahan.
Dialogue: 0,0:09:33.81,0:09:36.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, ayo kita berjuang bersama\Nsampai akhir.
Dialogue: 0,0:09:36.30,0:09:37.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pantang menyerah.
Dialogue: 0,0:09:38.08,0:09:40.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong,\Nmentalmu kuat banget ya, Narika.
Dialogue: 0,0:09:40.42,0:09:43.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau terus bangkit mencoba\Nmeski sudah jatuh berkali-kali.
Dialogue: 0,0:09:43.17,0:09:46.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ini tak kuat.\NJustru aslinya aku ini lemah banget.
Dialogue: 0,0:09:46.63,0:09:50.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi waktu aku kecil,\Nada seseorang yang pernah bilang padaku...
Dialogue: 0,0:09:51.19,0:09:55.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menerima kelemahan diri sendiri\Nadalah langkah awal untuk jadi lebih kuat.
Dialogue: 0,0:09:56.13,0:09:58.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku selalu ceroboh dalam banyak hal.
Dialogue: 0,0:09:58.30,0:10:02.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin bisa dibilang,\Nolahraga itu satu-satunya kelebihanku,
Dialogue: 0,0:10:02.44,0:10:05.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi awalnya aku juga payah di bidang ini.
Dialogue: 0,0:10:05.05,0:10:07.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang benar saja?
Dialogue: 0,0:10:07.02,0:10:07.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, sungguh.
Dialogue: 0,0:10:08.13,0:10:11.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku berlatih keras sampai tenagaku terkuras,\Ntapi perkembanganku lambat sekali,
Dialogue: 0,0:10:11.22,0:10:13.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan akhirnya malah mempermalukan diri sendiri\Nberkali-kali.
Dialogue: 0,0:10:14.10,0:10:19.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya aku jadi sangat mahir dalam urusan\Nberlapang dada menerima kelemahanku.
Dialogue: 0,0:10:19.47,0:10:20.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu ya...
Dialogue: 0,0:10:20.99,0:10:25.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pengalaman itulah yang membuatmu\Njago mengajari orang lain.
Dialogue: 0,0:10:26.12,0:10:28.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga ingin teman-teman\Nmelihat sisi dirimu yang itu...
Dialogue: 0,0:10:30.15,0:10:31.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:10:33.17,0:10:34.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan apa-apa.
Dialogue: 0,0:10:38.94,0:10:40.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tennoji.
Dialogue: 0,0:10:40.22,0:10:41.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, Tomonari...
Dialogue: 0,0:10:42.86,0:10:44.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hmph!
Dialogue: 0,0:10:44.10,0:10:44.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:10:44.68,0:10:46.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eum, apa aku berbuat salah?
Dialogue: 0,0:10:47.22,0:10:50.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tomonari, sepertinya kau sering\Nmenghindar dariku belakangan ini.
Dialogue: 0,0:10:50.55,0:10:52.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanya aku sebal, hmph!
Dialogue: 0,0:10:52.34,0:10:54.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menghindar katamu?
Dialogue: 0,0:10:54.55,0:11:00.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau asyik bikin perkumpulan rahasia\Nbareng Konohana dan Miyakojima.
Dialogue: 0,0:11:00.60,0:11:02.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus aku dicuekin, hmph!
Dialogue: 0,0:11:02.61,0:11:04.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih ada "hmph" lagi...
Dialogue: 0,0:11:04.18,0:11:06.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia gampang banget ngambek ya.
Dialogue: 0,0:11:06.39,0:11:09.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, aku justru\Nmau minta bantuanmu soal itu.
Dialogue: 0,0:11:09.33,0:11:11.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hmph...
Dialogue: 0,0:11:11.61,0:11:13.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi sulit, nih.
Dialogue: 0,0:11:14.05,0:11:15.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sogok dengan pesta teh...
Dialogue: 0,0:11:16.14,0:11:18.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kau setuju datang\Nke pesta teh bersamaku,
Dialogue: 0,0:11:18.44,0:11:20.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}suasana hatiku mungkin bakal membaik.
Dialogue: 0,0:11:20.66,0:11:21.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:11:21.92,0:11:24.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti kita jadwalkan. Kapan pun boleh.
Dialogue: 0,0:11:24.67,0:11:26.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku bersedia membantumu.
Dialogue: 0,0:11:27.15,0:11:29.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanyakan apa pun yang ingin kau tanyakan.
Dialogue: 0,0:11:30.35,0:11:34.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu ya, jadi selama ini\Nkau sedang sibuk dengan hal itu.
Dialogue: 0,0:11:34.52,0:11:37.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tennoji, apa kau punya ide cemerlang\Nbuat menyelesaikan masalah ini?
Dialogue: 0,0:11:37.88,0:11:39.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba kupikirkan...
Dialogue: 0,0:11:40.02,0:11:42.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengingat sifatnya yang tak suka pamer,
Dialogue: 0,0:11:42.13,0:11:45.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita bisa memutarbalikkan kelemahannya\Nitu menjadi kekuatan.
Dialogue: 0,0:11:46.52,0:11:48.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alih-alih menyuruhnya\Ntampil mencolok sendirian,
Dialogue: 0,0:11:48.98,0:11:51.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}biarkan dia yang membuat\Nteman-temannya bersinar.
Dialogue: 0,0:11:52.52,0:11:57.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebut saja ini Rencana Relawan Mulia!
Dialogue: 0,0:11:58.17,0:12:00.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pukulannya jangan persis di atas kepala, ya.
Dialogue: 0,0:12:00.41,0:12:02.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu sampai bolanya sedikit ke belakang.
Dialogue: 0,0:12:02.70,0:12:05.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu posisikan raket menghadap ke atas,
Dialogue: 0,0:12:05.67,0:12:08.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}nanti bolanya akan terbang\Nmelambung dengan sendirinya.
Dialogue: 0,0:12:08.75,0:12:10.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baik! Terima kasih banyak!
Dialogue: 0,0:12:11.23,0:12:13.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ingat, jangan keluarkan semua tenagamu\Ndi awal.
Dialogue: 0,0:12:15.31,0:12:17.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelihatannya berjalan dengan lancar.
Dialogue: 0,0:12:18.21,0:12:20.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, apa sebenarnya\Nmaksud Relawan Mulia ini?
Dialogue: 0,0:12:20.64,0:12:22.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Intinya adalah seseorang
Dialogue: 0,0:12:22.10,0:12:26.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dengan bakat luar biasa wajib membagikan\Nkemampuannya dengan sesama.
Dialogue: 0,0:12:27.06,0:12:32.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurut Tennoji, karena murid-murid lain\Ningin dapat nilai bagus di kelas olahraga,
Dialogue: 0,0:12:32.23,0:12:34.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tumbuhkan keinginan dalam diri mereka\Nagar mau dilatih oleh orang yang jago...
Dialogue: 0,0:12:34.45,0:12:36.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku setuju.
Dialogue: 0,0:12:36.50,0:12:38.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mi-Miyakojima.
Dialogue: 0,0:12:39.15,0:12:42.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eum, boleh minta tolong ajari aku juga?
Dialogue: 0,0:12:43.90,0:12:46.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga, Miyakojima. Aku habis dia, ya.
Dialogue: 0,0:12:46.54,0:12:48.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ikutan, ya.
Dialogue: 0,0:12:48.54,0:12:50.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Te-Tentu, boleh saja!
Dialogue: 0,0:13:00.31,0:13:04.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beradaptasi dengan pelajaran kelasku saja\Nsudah sangat menguras tenaga...
Dialogue: 0,0:13:05.07,0:13:08.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau belajarnya setengah-setengah,\Naku bakal tertinggal.
Dialogue: 0,0:13:10.81,0:13:13.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku bisa memetik banyak pelajaran...
Dialogue: 0,0:13:14.69,0:13:18.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seandainya masa laluku bisa melihat diriku\Nyang sekarang, pasti dia akan terkagum-kagum.
Dialogue: 0,0:13:20.02,0:13:24.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengingat betapa malasnya aku\Nwaktu bersekolah di SMA dulu...
Dialogue: 0,0:13:24.58,0:13:29.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana caramu agar pantas diakui sebagai\Nmurid unggulan Akademi Kiou?
Dialogue: 0,0:13:30.25,0:13:33.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku takkan lagi mendambakan\Nkeberhasilan instan,
Dialogue: 0,0:13:33.13,0:13:35.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku bakal berproses setahap demi setahap.
Dialogue: 0,0:13:35.87,0:13:37.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelajaran ini kudapat dari Narika...
Dialogue: 0,0:13:39.81,0:13:41.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itsuki...
Dialogue: 0,0:13:41.98,0:13:43.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih belajar?
Dialogue: 0,0:13:44.22,0:13:46.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kau capek, tidur di kamarmu saja.
Dialogue: 0,0:13:46.71,0:13:47.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kuantar.
Dialogue: 0,0:13:47.92,0:13:50.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sendiri tak ngantuk, Itsuki?
Dialogue: 0,0:13:50.03,0:13:52.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak kok, oh,\Ntapi tunggu, sekarang aku mulai ngantuk...
Dialogue: 0,0:13:54.23,0:13:55.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:13:55.58,0:13:56.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo tidur bareng.
Dialogue: 0,0:13:59.22,0:14:01.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk tawaran yang satu ini,\Naku terpaksa menolak.
Dialogue: 0,0:14:03.33,0:14:08.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, baru juga kemarin kau bilang tak suka\Nkubangunkan tiap pagi.
Dialogue: 0,0:14:08.63,0:14:12.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terus kenapa kau malah keseringan\Nnyelonong masuk dan ketiduran di kamarku?
Dialogue: 0,0:14:12.08,0:14:13.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eum, itu...
Dialogue: 0,0:14:13.59,0:14:16.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya waktu itu aku sempat merasa aneh...
Dialogue: 0,0:14:16.36,0:14:18.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu itu?
Dialogue: 0,0:14:18.11,0:14:19.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti sekarang sudah tak aneh lagi?
Dialogue: 0,0:14:24.94,0:14:27.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sini cepat.
Dialogue: 0,0:14:27.77,0:14:30.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sungguh tidak bisa...
Dialogue: 0,0:14:41.22,0:14:42.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hinako.
Dialogue: 0,0:14:43.89,0:14:48.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hinako, sebenarnya apa perasaanmu terhadapku?
Dialogue: 0,0:14:50.23,0:14:52.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku...
Dialogue: 0,0:14:53.49,0:14:57.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itsuki, sebenarnya aku su...
Dialogue: 0,0:14:59.27,0:15:00.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Su..."?
Dialogue: 0,0:15:06.82,0:15:07.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia ketiduran?!
Dialogue: 0,0:15:09.25,0:15:11.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa-bisanya kau ketiduran di saat begini?
Dialogue: 0,0:15:12.27,0:15:16.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hinako ini sepertinya bisa tertidur\Ndi situasi apa pun...
Dialogue: 0,0:15:18.04,0:15:19.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hinako...
Dialogue: 0,0:15:19.41,0:15:23.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan terus berproses\Nsampai aku merasa pantas bersanding denganmu.
Dialogue: 0,0:15:26.64,0:15:29.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, akan kubiarkan dia terlelap sebentar\Nsebelum kugendong kembali ke kamarnya.
Dialogue: 0,0:15:41.67,0:15:44.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemahiranku dalam berakting\Nternyata berguna juga di saat terdesak...
Dialogue: 0,0:15:44.96,0:15:47.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untung dia tidak tahu\Naku cuma pura-pura tidur.
Dialogue: 0,0:15:47.71,0:15:49.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi itu hampir saja kelepasan!
Dialogue: 0,0:15:52.80,0:15:57.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan terus berproses\Nsampai aku merasa pantas bersanding denganmu.
Dialogue: 0,0:15:59.48,0:16:03.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aneh... Perasaanku kacau balau sekarang...
Dialogue: 0,0:16:03.64,0:16:06.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa aku jadi begini? Ada apa ini?
Dialogue: 0,0:16:06.25,0:16:08.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perasaan ini terasa asing...\NAku sampai mati gaya...
Dialogue: 0,0:16:11.51,0:16:15.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memangnya bagaimana perasaanku pada Itsuki?
Dialogue: 0,0:16:19.32,0:16:22.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itsuki itu pengurus kesayanganku.
Dialogue: 0,0:16:22.70,0:16:24.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bahagia jika dia selalu ada.
Dialogue: 0,0:16:25.57,0:16:28.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, apakah cuma sebatas itu?
Dialogue: 0,0:16:29.26,0:16:32.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apakah jawaban itu memuaskanku?
Dialogue: 0,0:16:46.08,0:16:48.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, kalian berdua\Nmainnya makin jago, ya!
Dialogue: 0,0:16:49.13,0:16:53.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itsuki, kau sudah bisa\Nmengayunkan raket sambil menganalisis.
Dialogue: 0,0:16:53.54,0:16:54.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Langkah selanjutnya...
Dialogue: 0,0:16:54.41,0:16:58.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mau tembakan yang lebih terarah,\Nrutinlah berlatih pantulan bola di dinding.
Dialogue: 0,0:16:58.91,0:17:01.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sempatkan berlatih setiap hari,\Nsedikit pun tak masalah,
Dialogue: 0,0:17:01.40,0:17:03.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sampai turnamen tiba.
Dialogue: 0,0:17:03.16,0:17:04.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:17:04.52,0:17:08.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Konohana, bakatmu sangat mengagumkan.
Dialogue: 0,0:17:08.45,0:17:12.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau berhasil memperbaiki kelemahanmu\Nyang kusebutkan di awal dengan sangat baik.
Dialogue: 0,0:17:12.07,0:17:13.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:17:13.94,0:17:17.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Konohana, kau sudah siap\Nmasuk ke materi tahap lanjut.
Dialogue: 0,0:17:17.38,0:17:21.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah istirahat nanti,\Nbagaimana kalau kita bertanding sungguhan?
Dialogue: 0,0:17:21.07,0:17:22.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tunggu tantanganmu.
Dialogue: 0,0:17:25.64,0:17:26.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Narika?!
Dialogue: 0,0:17:28.43,0:17:30.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itsuki...
Dialogue: 0,0:17:31.39,0:17:32.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini.
Dialogue: 0,0:17:34.58,0:17:35.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini?
Dialogue: 0,0:17:35.87,0:17:38.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerannya sedikit rewel kayaknya.
Dialogue: 0,0:17:38.78,0:17:40.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itsuki...
Dialogue: 0,0:17:41.07,0:17:42.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong lap rambutku...
Dialogue: 0,0:17:42.97,0:17:44.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, iya.
Dialogue: 0,0:17:47.93,0:17:51.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dulu kau juga pernah\Nmelakukan hal yang sama padaku, 'kan?
Dialogue: 0,0:17:51.21,0:17:53.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Masa, sih?
Dialogue: 0,0:17:53.22,0:17:54.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:17:54.38,0:17:58.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pernah suatu hari, aku asyik main lari-larian\Ndi taman habis hujan,
Dialogue: 0,0:17:59.14,0:18:01.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}terus aku kesandung\Nsampai jatuh ke kubangan lumpur...
Dialogue: 0,0:18:03.30,0:18:04.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bikin nostalgia saja...
Dialogue: 0,0:18:05.47,0:18:09.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiap kali kau mengusap rambutku,\Nrasanya nyaman dan tenang...
Dialogue: 0,0:18:10.45,0:18:12.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi ngapain kalian?
Dialogue: 0,0:18:14.80,0:18:17.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, ini kerannya lagi macet...
Dialogue: 0,0:18:24.73,0:18:27.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, aku tidak sengaja.
Dialogue: 0,0:18:27.32,0:18:30.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?\NKau tak dengar apa yang kuucapkan tadi?!
Dialogue: 0,0:18:30.13,0:18:34.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak kusangka ternyata\NKonohana bisa berbuat sembrono begitu...
Dialogue: 0,0:18:34.15,0:18:36.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lap rambutku juga.
Dialogue: 0,0:18:36.49,0:18:38.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siap laksanakan.
Dialogue: 0,0:18:41.46,0:18:43.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sentuhanmu lembut sekali.
Dialogue: 0,0:18:43.60,0:18:45.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tu-Tumben-tumbenan kau begini...
Dialogue: 0,0:18:45.82,0:18:49.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gara-gara kau aku jadi harus menjalankan\Ntugasku sekaligus berakting pura-pura...
Dialogue: 0,0:18:51.07,0:18:53.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baiklah, waktunya kembali latihan!
Dialogue: 0,0:18:53.75,0:18:56.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itsuki, tolong jadi wasit, ya.
Dialogue: 0,0:18:56.10,0:18:57.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Y-Ya.
Dialogue: 0,0:18:59.86,0:19:03.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar lebih seru,\Nbagaimana kalau ada hukumannya?
Dialogue: 0,0:19:03.52,0:19:04.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hukuman?
Dialogue: 0,0:19:04.85,0:19:08.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, yang kalah\Nharus menuruti satu permintaan pemenang.
Dialogue: 0,0:19:08.45,0:19:09.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}K-Kalau begitu...
Dialogue: 0,0:19:09.65,0:19:12.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hukumannya, sang pemenang berhak\Nmengajak Itsuki jalan berduaan. Setuju?
Dialogue: 0,0:19:12.98,0:19:14.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Kok aku dibawa-bawa?
Dialogue: 0,0:19:14.74,0:19:16.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ide bagus.
Dialogue: 0,0:19:17.72,0:19:18.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:19:19.04,0:19:21.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang satu nona muda\Nyang genius di bidang akademik...
Dialogue: 0,0:19:21.78,0:19:24.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang satunya nona muda yang super berbakat\Ndi segala bidang olahraga...
Dialogue: 0,0:19:25.32,0:19:29.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertandingan ini pasti mengundang\Nperhatian seluruh akademi.
Dialogue: 0,0:19:32.10,0:19:33.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}15-0.
Dialogue: 0,0:19:44.59,0:19:45.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}30-0.
Dialogue: 0,0:19:46.08,0:19:48.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang sudah bisa ditebak\Nkalau Hinako yang bakal kewalahan...
Dialogue: 0,0:19:49.04,0:19:51.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gim pertama dimenangkan Narika.
Dialogue: 0,0:19:51.74,0:19:53.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pindah lapangan.
Dialogue: 0,0:19:54.69,0:19:58.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Miyakojima, kenapa kau sangat antusias\Ningin jalan berduaan dengan Tomonari?
Dialogue: 0,0:19:58.64,0:20:01.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke-Kenapa, ya? Eum...
Dialogue: 0,0:20:01.70,0:20:03.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, aku bisa memakluminya, kok.
Dialogue: 0,0:20:03.42,0:20:06.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berada di dekat Tomonari\Nmemang cukup menghibur.
Dialogue: 0,0:20:07.61,0:20:09.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau punya pendapat yang sama, Konohana?
Dialogue: 0,0:20:09.99,0:20:10.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:20:11.01,0:20:14.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kapan hari kami sempat pergi jalan bareng,\Ndan aku benar-benar menikmatinya.
Dialogue: 0,0:20:14.87,0:20:16.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian pernah jalan berdua?!
Dialogue: 0,0:20:17.14,0:20:18.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu itu juga, Itsuki...
Dialogue: 0,0:20:18.82,0:20:23.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Astaga. Tomonari, maksudku...
Dialogue: 0,0:20:23.84,0:20:26.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau panggil dia apa tadi?
Dialogue: 0,0:20:26.38,0:20:28.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba ulangi apa panggilanmu tadi?!
Dialogue: 0,0:20:33.50,0:20:35.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga...
Dialogue: 0,0:20:36.11,0:20:40.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa Itsuki memanggil Konohana\Nhanya dengan nama depannya!
Dialogue: 0,0:20:42.42,0:20:46.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian berdua ada hubungan apa?!
Dialogue: 0,0:20:49.45,0:20:50.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}30-15.
Dialogue: 0,0:20:53.94,0:20:55.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}40-15.
Dialogue: 0,0:20:55.66,0:20:56.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:20:56.51,0:20:59.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permainan Narika tiba-tiba jadi kacau balau.
Dialogue: 0,0:20:59.63,0:21:02.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hinako berhasil merebut gim kedua dan ketiga.
Dialogue: 0,0:21:03.30,0:21:04.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pindah lapangan.
Dialogue: 0,0:21:05.27,0:21:09.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Konohana, tadi kau santai saja\Nmenyuruh Itsuki mengusap rambutmu.
Dialogue: 0,0:21:09.62,0:21:11.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, kenapa memangnya?
Dialogue: 0,0:21:11.81,0:21:14.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gosipnya Itsuki menumpang tinggal\Ndi rumah Keluarga Konohana
Dialogue: 0,0:21:14.63,0:21:16.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk belajar tata krama pergaulan.
Dialogue: 0,0:21:16.18,0:21:20.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, hal yang biasa kalau dia sering\Nmerapikan rambutmu?
Dialogue: 0,0:21:21.77,0:21:23.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entahlah.
Dialogue: 0,0:21:23.11,0:21:25.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kadang-kadang saja, kok...
Dialogue: 0,0:21:25.86,0:21:28.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata Itsuki ahli\Ndalam merapikan rambut, ya?
Dialogue: 0,0:21:28.68,0:21:30.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula,\Ndia sudah pernah berlatih sebelumnya.
Dialogue: 0,0:21:32.17,0:21:33.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudmu?
Dialogue: 0,0:21:34.08,0:21:38.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dulu waktu kecil, aku payah menata rambutku.
Dialogue: 0,0:21:38.40,0:21:41.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saking payahnya, rambutku sering\Ndibiarkan terurai saat di dojo.
Dialogue: 0,0:21:41.41,0:21:43.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, Itsuki mengikatnya seraya ngomel,
Dialogue: 0,0:21:43.32,0:21:45.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Memangnya bisa leluasa gerak\Ndengan gaya rambut gitu?"
Dialogue: 0,0:21:45.55,0:21:48.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semenjak itu, Itsuki jadi\Npenata rambut pribadiku.
Dialogue: 0,0:21:48.65,0:21:52.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gaya rambutku yang sekarang juga\Nhasil mahakarya Itsuki.
Dialogue: 0,0:21:56.73,0:21:57.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Fault.
Dialogue: 0,0:21:57.98,0:22:01.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gantian, permainan Hinako\Nyang jadi serampangan.
Dialogue: 0,0:22:04.63,0:22:06.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada akhirnya Narika\Nyang keluar sebagai pemenang, ya?
Dialogue: 0,0:22:06.96,0:22:09.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sempat goyah,\Ntapi dia bisa menutupi kekurangannya itu.
Dialogue: 0,0:22:09.37,0:22:10.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku menang!
Dialogue: 0,0:22:12.80,0:22:15.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itsuki! Ingat kesepakatannya!
Dialogue: 0,0:22:15.01,0:22:16.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita berdua bakal pergi jalan-jalan!
Dialogue: 0,0:22:16.71,0:22:18.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Y-Ya.
Dialogue: 0,0:22:18.54,0:22:20.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tomonari kan punya segudang kesibukan.
Dialogue: 0,0:22:20.97,0:22:24.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi kapan dia bisa\Nmerealisasikan kesepakatan itu?
Dialogue: 0,0:22:25.50,0:22:28.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cu-Curang kau, Konohana!
Dialogue: 0,0:22:28.07,0:22:30.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kupikir tak ada aturan soal hari\Ndan jamnya, tuh.
Dialogue: 0,0:22:43.14,0:22:45.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang mereka sudah berteman rupanya...
Dialogue: 0,0:22:48.26,0:22:50.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa dua orang ini menatapku sinis?!
Dialogue: 0,0:22:52.76,0:22:53.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itsuki.
Dialogue: 0,0:22:54.26,0:22:57.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buatkan aku gaya rambut yang baru juga.
Dialogue: 0,0:22:57.34,0:22:58.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:23:01.87,0:23:03.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau seperti ini, bagaimana?
Dialogue: 0,0:23:08.28,0:23:09.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lumayan.
