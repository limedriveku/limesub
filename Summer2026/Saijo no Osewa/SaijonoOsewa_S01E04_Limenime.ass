Dialogue: 0,0:02:16.47,0:02:19.40,sign,,0000,0000,0000,,"EPISODE 4: KEBOHONGAN DAN RAHASIA"
Dialogue: 0,0:12:46.37,0:12:47.12,sign,,0000,0000,0000,,MATEMATIKA II
Dialogue: 0,0:13:17.16,0:13:20.10,sign,,0000,0000,0000,,"NILAI TERBAIK"
Dialogue: 0,0:00:05.53,0:00:07.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih atas makanannya.
Dialogue: 0,0:00:08.31,0:00:10.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya kau sudah menguasai\Ndasar-dasarnya.
Dialogue: 0,0:00:11.18,0:00:12.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:00:12.67,0:00:14.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini semua berkatmu, Shizune.
Dialogue: 0,0:00:14.58,0:00:20.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanpa etiket yang baik,\Nkau tak pantas makan bersama Nona.
Dialogue: 0,0:00:20.30,0:00:23.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh ya, apa yang Hinako lakukan\Nuntuk makan malamnya?
Dialogue: 0,0:00:23.82,0:00:25.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia makan di ruang makan.
Dialogue: 0,0:00:25.80,0:00:27.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sendirian?
Dialogue: 0,0:00:27.70,0:00:30.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, dilayani oleh para staf.
Dialogue: 0,0:00:30.00,0:00:33.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rencananya, beban kerjamu\Nakan ditambah secara bertahap, Itsuki.
Dialogue: 0,0:00:33.86,0:00:40.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai pengurus, pada akhirnya\Nkau harus mendampinginya setiap saat.
Dialogue: 0,0:00:40.89,0:00:42.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti.
Dialogue: 0,0:00:42.16,0:00:44.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong soal Nona...
Dialogue: 0,0:02:04.87,0:02:07.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rich Girl Caretaker:
Dialogue: 0,0:02:07.08,0:02:12.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I'm Secretly the Caregiver of the\NMost Popular Girl in This Rich Kid School
Dialogue: 0,0:02:16.47,0:02:19.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ada yang gatal?
Dialogue: 0,0:02:19.40,0:02:20.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak sama sekali.
Dialogue: 0,0:02:22.67,0:02:24.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, sudah selesai.
Dialogue: 0,0:02:24.09,0:02:25.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa pergi ke ruang bilas sendiri?
Dialogue: 0,0:02:25.61,0:02:26.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa.
Dialogue: 0,0:02:26.69,0:02:30.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shizune benar-benar membangun\Nsesuatu yang luar biasa.
Dialogue: 0,0:02:31.23,0:02:36.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ruang bilas ini dibuat\Nagar orang bisa melepas baju renang.
Dialogue: 0,0:02:36.06,0:02:39.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja, tak ada yang boleh masuk\Nselain Nona.
Dialogue: 0,0:02:41.31,0:02:44.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hinako, tolong ambilkan gayung itu.
Dialogue: 0,0:02:44.77,0:02:45.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:02:48.87,0:02:50.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke.
Dialogue: 0,0:02:50.39,0:02:52.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa tadi itu pelesetan\Ndari kata "oke" dan "oke" ember kayu?
Dialogue: 0,0:02:58.92,0:03:00.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aturan belum tiga detik.
Dialogue: 0,0:03:00.25,0:03:03.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah kau suka saat aku menunjukkannya.
Dialogue: 0,0:03:04.09,0:03:05.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi usahakan jangan
Dialogue: 0,0:03:05.75,0:03:07.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Ini seru.\N- melakukannya di tempat umum.
Dialogue: 0,0:03:07.86,0:03:12.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah pesta teh tadi,\Nkau berduaan saja dengan Miyakojima.
Dialogue: 0,0:03:12.41,0:03:14.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa yang kalian bicarakan?
Dialogue: 0,0:03:14.10,0:03:15.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bicara soal apa, ya?
Dialogue: 0,0:03:15.23,0:03:19.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal betapa serunya pesta teh tadi,\Ndan semacamnya.
Dialogue: 0,0:03:22.48,0:03:23.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}He-Hei!
Dialogue: 0,0:03:23.91,0:03:27.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itsuki, kau itu pengurusku.
Dialogue: 0,0:03:27.90,0:03:29.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan tinggalkan aku...
Dialogue: 0,0:03:30.02,0:03:30.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:03:34.39,0:03:35.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}He-Hei!
Dialogue: 0,0:03:36.03,0:03:37.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hinako?
Dialogue: 0,0:03:38.50,0:03:39.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hinako!
Dialogue: 0,0:03:40.75,0:03:42.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia demam ringan.
Dialogue: 0,0:03:43.75,0:03:47.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pasti panik jika kau\Ntak memperingatkanku sebelumnya.
Dialogue: 0,0:03:47.84,0:03:52.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga Nona akan segera jatuh sakit.
Dialogue: 0,0:03:52.54,0:03:54.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong waspadalah, Itsuki.
Dialogue: 0,0:03:55.59,0:03:58.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, bagaimana kau bisa tahu?
Dialogue: 0,0:03:58.05,0:04:00.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sudah sering terjadi.
Dialogue: 0,0:04:01.07,0:04:04.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona tumbang karena terus\Nberakting setiap hari.
Dialogue: 0,0:04:04.64,0:04:05.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:04:05.65,0:04:09.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia harus bersikap jauh berbeda\Ndari sifat aslinya.
Dialogue: 0,0:04:09.62,0:04:11.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja itu membuatnya stres.
Dialogue: 0,0:04:11.98,0:04:13.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tu-Tunggu dulu.
Dialogue: 0,0:04:14.19,0:04:16.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kau bisa setenang itu?
Dialogue: 0,0:04:16.95,0:04:19.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demamnya akan turun\Ndalam dua atau tiga hari.
Dialogue: 0,0:04:19.38,0:04:21.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak perlu terlalu khawatir.
Dialogue: 0,0:04:21.74,0:04:25.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, jika dia akan terus tumbang begini,
Dialogue: 0,0:04:25.25,0:04:26.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bukankah sebaiknya dia berhenti...
Dialogue: 0,0:04:26.42,0:04:27.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sadarilah posisimu.
Dialogue: 0,0:04:29.00,0:04:32.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akting Nona adalah\Nkeputusan Keluarga Konohana.
Dialogue: 0,0:04:32.26,0:04:34.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sendiri juga sudah menyetujuinya.
Dialogue: 0,0:04:34.75,0:04:36.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyetujuinya...
Dialogue: 0,0:04:37.75,0:04:39.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan istirahat, Itsuki.
Dialogue: 0,0:04:40.12,0:04:41.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sampai ini mengganggu sekolahmu besok.
Dialogue: 0,0:04:41.90,0:04:45.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tetap sekolah padahal\NHinako terbaring sakit?
Dialogue: 0,0:04:45.84,0:04:48.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah berpengalaman merawatnya\Nsampai sembuh.
Dialogue: 0,0:04:48.23,0:04:51.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan kemampuan akademismu,\Nkau tak boleh bolos.
Dialogue: 0,0:04:54.31,0:04:57.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, Tomonari?\NKau tampak murung.
Dialogue: 0,0:04:57.16,0:04:59.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, bukan apa-apa.
Dialogue: 0,0:04:59.76,0:05:03.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kita harus gelar pesta teh lagi\Ndengan orang-orang yang sama!
Dialogue: 0,0:05:03.14,0:05:07.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asahi, mengumpulkan orang-orang\Nsehebat mereka itu tak mudah.
Dialogue: 0,0:05:08.39,0:05:09.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:05:09.81,0:05:13.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, Konohana absen hari ini.
Dialogue: 0,0:05:13.12,0:05:15.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin karena urusan biasa.
Dialogue: 0,0:05:15.46,0:05:16.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Urusan biasa?
Dialogue: 0,0:05:16.73,0:05:19.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terkadang dia harus pergi\Nuntuk mengurus bisnis keluarganya.
Dialogue: 0,0:05:19.86,0:05:22.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Konohana memang sangat sibuk.
Dialogue: 0,0:05:22.12,0:05:24.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, alasan itu yang dipakai?
Dialogue: 0,0:05:24.94,0:05:29.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Artinya, tak ada\Nyang mengkhawatirkannya di sini.
Dialogue: 0,0:05:29.71,0:05:33.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat Hinako menderita,\Nsiapa yang akan menolongnya?
Dialogue: 0,0:05:35.56,0:05:37.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa yang akan mendampinginya?
Dialogue: 0,0:05:42.62,0:05:44.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang.
Dialogue: 0,0:05:44.13,0:05:45.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana keadaan Hinako?
Dialogue: 0,0:05:45.94,0:05:48.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia masih istirahat di tempat tidur.
Dialogue: 0,0:05:48.05,0:05:49.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untung saja ini akhir pekan.
Dialogue: 0,0:05:49.52,0:05:52.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pasti sudah bisa sekolah hari Senin\Nsetelah dua hari istirahat.
Dialogue: 0,0:05:53.87,0:05:56.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eum, apa Tuan Kagen akan menjenguknya?
Dialogue: 0,0:05:56.31,0:05:58.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Kagen sedang sibuk bekerja\Ndi rumah utama.
Dialogue: 0,0:05:58.85,0:06:00.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di saat seperti ini?
Dialogue: 0,0:06:00.70,0:06:03.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Kagen adalah pemimpin Grup Konohana.
Dialogue: 0,0:06:03.64,0:06:05.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak mudah baginya untuk mengambil cuti.
Dialogue: 0,0:06:05.66,0:06:07.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, bagaimana dengan ibu Hinako?
Dialogue: 0,0:06:08.18,0:06:09.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beliau sudah meninggal.
Dialogue: 0,0:06:11.12,0:06:13.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak tahu soal itu...
Dialogue: 0,0:06:13.68,0:06:15.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada banyak hal yang tak kuketahui.
Dialogue: 0,0:06:15.89,0:06:17.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu wajar.
Dialogue: 0,0:06:17.21,0:06:19.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kan baru saja bekerja\Nsebagai pengurusnya.
Dialogue: 0,0:06:20.21,0:06:24.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bolehkah aku menyelesaikan\Npelajaran hari ini lebih cepat?
Dialogue: 0,0:06:24.26,0:06:26.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan bekerja lebih keras\Nuntuk menebusnya.
Dialogue: 0,0:06:28.00,0:06:29.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah.
Dialogue: 0,0:06:29.01,0:06:32.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan mempercepat\Nmateri hari ini 1,5 kali lipat.
Dialogue: 0,0:06:32.14,0:06:33.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau bisa mengikutinya?
Dialogue: 0,0:06:33.54,0:06:34.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:06:35.27,0:06:37.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisakah aku menjadi sosok itu?
Dialogue: 0,0:06:39.02,0:06:40.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak!
Dialogue: 0,0:06:40.77,0:06:44.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seseorang yang selalu ada di sisinya?
Dialogue: 0,0:06:48.82,0:06:51.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, Itsuki.
Dialogue: 0,0:06:51.31,0:06:53.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, aku membangunkanmu, ya?
Dialogue: 0,0:06:53.29,0:06:54.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.
Dialogue: 0,0:06:54.45,0:06:57.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma sedang melamun.
Dialogue: 0,0:06:58.07,0:07:00.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itsuki, terima kasih.
Dialogue: 0,0:07:00.79,0:07:03.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang kau ada di sini.
Dialogue: 0,0:07:04.38,0:07:05.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja aku di sini.
Dialogue: 0,0:07:05.90,0:07:07.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kan pengurusmu.
Dialogue: 0,0:07:09.76,0:07:12.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau butuh sesuatu, bilang saja padaku.
Dialogue: 0,0:07:12.47,0:07:13.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:07:13.76,0:07:16.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Genggam tanganku.
Dialogue: 0,0:07:18.20,0:07:19.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja.
Dialogue: 0,0:07:22.55,0:07:24.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tangannya kecil sekali.
Dialogue: 0,0:07:28.92,0:07:30.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia tertidur?
Dialogue: 0,0:07:31.35,0:07:34.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hinako, semuanya akan baik-baik saja.
Dialogue: 0,0:07:35.73,0:07:37.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah...
Dialogue: 0,0:07:38.54,0:07:41.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu rupanya, keluarga.
Dialogue: 0,0:07:41.66,0:07:45.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa sosok keluarga yang Hinako\Nharapkan dari pengurusnya?
Dialogue: 0,0:07:47.82,0:07:49.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti perasaanmu.
Dialogue: 0,0:07:49.70,0:07:51.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Punya keluarga itu menyenangkan, bukan?
Dialogue: 0,0:07:59.89,0:08:00.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itsuki.
Dialogue: 0,0:08:01.21,0:08:04.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus. Dia baru saja tidur.
Dialogue: 0,0:08:04.58,0:08:06.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, ayo keluar sebentar.
Dialogue: 0,0:08:06.34,0:08:08.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada hal penting yang harus kita bicarakan.
Dialogue: 0,0:08:08.74,0:08:09.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mengerti.
Dialogue: 0,0:08:13.47,0:08:15.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya kita tak punya pilihan.
Dialogue: 0,0:08:15.05,0:08:16.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari bicara di sini saja.
Dialogue: 0,0:08:16.70,0:08:17.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon bantuannya.
Dialogue: 0,0:08:18.23,0:08:22.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa Tuan Kagen sudah memberitahumu\Nalasan Nona berakting?
Dialogue: 0,0:08:22.17,0:08:23.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:08:23.04,0:08:27.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Demi mencari keluarga terbaik\Nuntuk dijodohkan dengannya, 'kan?
Dialogue: 0,0:08:27.26,0:08:30.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, tapi itu hanya tujuan kedua.
Dialogue: 0,0:08:30.65,0:08:32.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada alasan yang jauh lebih besar.
Dialogue: 0,0:08:32.74,0:08:35.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tujuan utamanya mencari pria untuk diadopsi\Nsebagai menantu di Keluarga Konohana.
Dialogue: 0,0:08:35.80,0:08:37.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menantu?
Dialogue: 0,0:08:37.50,0:08:41.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keluarga Konohana memiliki putra sulung\NTuan Kagen sekaligus kakak Nona,
Dialogue: 0,0:08:41.28,0:08:43.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Konohana Takuma.
Dialogue: 0,0:08:43.34,0:08:45.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia punya kakak laki-laki?
Dialogue: 0,0:08:45.00,0:08:50.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, tapi karena usianya jauh lebih tua\Ndan tinggal terpisah,
Dialogue: 0,0:08:50.28,0:08:53.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona jarang punya waktu bersamanya.
Dialogue: 0,0:08:53.83,0:08:57.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Normalnya, Tuan Takuma\Nyang menjadi penerus keluarga,
Dialogue: 0,0:08:57.55,0:09:03.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi Tuan Kagen ragu apakah dia\Npantas memimpin Grup Konohana.
Dialogue: 0,0:09:03.84,0:09:06.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, menantu laki-lakilah\Nyang akan jadi kepala keluarga kelak.
Dialogue: 0,0:09:06.97,0:09:11.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat itu tiba, Nona akan memimpin\Nmasa depan Grup Konohana bersamanya.
Dialogue: 0,0:09:12.39,0:09:16.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona tak hanya butuh\Nkecerdasan bisnis, tapi juga karisma.
Dialogue: 0,0:09:16.23,0:09:21.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika Nona punya reputasi buruk,\Nakan timbul konflik internal di dalam Grup.
Dialogue: 0,0:09:21.12,0:09:25.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skenario terburuknya,\Nakan jatuh banyak korban.
Dialogue: 0,0:09:26.20,0:09:29.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitulah nasib putri seorang konglomerat...
Dialogue: 0,0:09:29.02,0:09:30.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau mengerti sekarang?
Dialogue: 0,0:09:31.08,0:09:33.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beban yang harus dipikul oleh Nona?
Dialogue: 0,0:09:33.51,0:09:34.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:09:34.82,0:09:38.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bukan sosok\Nyang bisa didampingi sembarangan orang.
Dialogue: 0,0:09:39.99,0:09:42.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, apa salah kalau aku\Ningin melakukan sesuatu untuknya?
Dialogue: 0,0:09:42.56,0:09:44.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, aku tidak pernah bilang begitu.
Dialogue: 0,0:09:44.73,0:09:47.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kemarin,\Nkau menyuruhku untuk sadar diri.
Dialogue: 0,0:09:47.43,0:09:52.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, maka sadarilah posisimu\Nsaat mendukung Nona.
Dialogue: 0,0:09:52.65,0:09:55.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah tugas seorang pengurus.
Dialogue: 0,0:10:00.91,0:10:05.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang bisa kulakukan hanyalah menemaninya\Nsaat dia butuh bersantai.
Dialogue: 0,0:10:05.84,0:10:08.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mendukungnya saat dia jatuh sakit\Nkarena kelelahan.
Dialogue: 0,0:10:08.85,0:10:11.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memberikan kehangatan layaknya keluarga...
Dialogue: 0,0:10:11.74,0:10:15.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hinako, aku akan melakukan yang terbaik.
Dialogue: 0,0:10:16.06,0:10:20.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar kata Shizune,\NHinako sudah bisa sekolah hari Senin.
Dialogue: 0,0:10:23.18,0:10:26.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasakan, hanya hal ini yang agak\Nberbeda dari suasana keluarga.
Dialogue: 0,0:10:26.32,0:10:27.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itsuki.
Dialogue: 0,0:10:27.93,0:10:29.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau saja yang makan ini.
Dialogue: 0,0:10:29.13,0:10:32.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, makanlah sayuranmu\Ndan jangan pilih-pilih.
Dialogue: 0,0:10:32.20,0:10:33.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Huh...
Dialogue: 0,0:10:33.26,0:10:37.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tak makan makanan bergizi,\Nkau bisa jatuh sakit.
Dialogue: 0,0:10:37.82,0:10:40.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Walau sakit, aku tinggal tidur saja.
Dialogue: 0,0:10:40.82,0:10:42.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin itu pilihan yang lebih baik.
Dialogue: 0,0:10:42.99,0:10:44.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bicara begitu.
Dialogue: 0,0:10:45.03,0:10:48.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku lebih senang kalau kau sehat.
Dialogue: 0,0:10:50.67,0:10:51.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan memakannya.
Dialogue: 0,0:10:57.37,0:11:01.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, Shizune memberiku\Nsatu lagi tanggung jawab pekerjaan.
Dialogue: 0,0:11:02.31,0:11:05.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai hari ini,\Naku bertugas membangunkan Hinako.
Dialogue: 0,0:11:07.65,0:11:09.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hinako, sudah pagi.
Dialogue: 0,0:11:10.54,0:11:12.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiga jam lagi...
Dialogue: 0,0:11:12.46,0:11:14.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo bangun, nanti terlambat.
Dialogue: 0,0:11:14.27,0:11:16.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biarkan aku terlambat.
Dialogue: 0,0:11:16.13,0:11:17.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak boleh.
Dialogue: 0,0:11:20.60,0:11:21.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, cepat bangun.
Dialogue: 0,0:11:24.44,0:11:26.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Itsuki?
Dialogue: 0,0:11:26.50,0:11:27.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Selamat pagi.
Dialogue: 0,0:11:30.95,0:11:32.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bantu aku berdiri.
Dialogue: 0,0:11:32.18,0:11:33.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, iya.
Dialogue: 0,0:11:34.41,0:11:35.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sini.
Dialogue: 0,0:11:36.07,0:11:38.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itsuki, pagi.
Dialogue: 0,0:11:38.11,0:11:38.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat pagi.
Dialogue: 0,0:11:39.22,0:11:40.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pakaianmu sudah kusiapkan.
Dialogue: 0,0:11:40.87,0:11:42.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menunggu di luar.
Dialogue: 0,0:11:42.69,0:11:43.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bantu aku.
Dialogue: 0,0:11:43.94,0:11:44.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:11:45.42,0:11:47.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bantu aku ganti baju.
Dialogue: 0,0:11:48.59,0:11:50.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, membantumu?!
Dialogue: 0,0:11:50.84,0:11:53.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, cepat.
Dialogue: 0,0:11:57.24,0:11:59.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang. Tenanglah, Itsuki!
Dialogue: 0,0:11:59.82,0:12:04.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Hinako butuhkan adalah sosok keluarga\Nyang bisa ia percaya!
Dialogue: 0,0:12:04.55,0:12:06.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itsuki, kau di dalam?
Dialogue: 0,0:12:06.29,0:12:07.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:12:07.50,0:12:09.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku lupa memberi tahu kalau
Dialogue: 0,0:12:09.24,0:12:11.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona suka meracau\Nsaat nyawanya belum terkumpul penuh.
Dialogue: 0,0:12:11.44,0:12:14.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mungkin memintamu\Nmembantunya ganti baju,
Dialogue: 0,0:12:14.34,0:12:16.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kuharap kau tak menanggapinya serius.
Dialogue: 0,0:12:16.78,0:12:18.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku nyaris menganggapnya serius!
Dialogue: 0,0:12:18.72,0:12:21.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eum, tentu saja tidak!
Dialogue: 0,0:12:21.24,0:12:22.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baguslah.
Dialogue: 0,0:12:22.60,0:12:25.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah melihat kerja kerasmu\Nbeberapa hari ini.
Dialogue: 0,0:12:25.77,0:12:29.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat memercayaimu, sama seperti Nona.
Dialogue: 0,0:12:29.98,0:12:32.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh! Kepercayaan ini rasanya menyakitkan!
Dialogue: 0,0:12:32.65,0:12:33.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itsuki.
Dialogue: 0,0:12:34.50,0:12:37.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bantu urus aku tiap pagi mulai sekarang.
Dialogue: 0,0:12:38.75,0:12:40.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Sudah UTS saja?
Dialogue: 0,0:12:40.74,0:12:43.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, jadwal akademi ini\Nsedikit lebih cepat dari sekolah lain.
Dialogue: 0,0:12:43.60,0:12:45.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini kumpulan soal\Ndari tahun-tahun sebelumnya.
Dialogue: 0,0:12:47.12,0:12:50.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bisa gawat...
Dialogue: 0,0:12:53.84,0:12:56.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ifuhi. Awa aha?
Dialogue: 0,0:12:56.67,0:12:59.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Telan dulu makananmu sebelum bicara.
Dialogue: 0,0:12:59.55,0:13:00.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:13:01.63,0:13:05.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan masalah besar, tapi ternyata UTS\Ndi sini lebih sulit dari dugaanku.
Dialogue: 0,0:13:05.88,0:13:08.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu masalah besar, tahu.
Dialogue: 0,0:13:08.33,0:13:11.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau nilaimu jelek,\Nkau bisa dipecat jadi pengurus.
Dialogue: 0,0:13:11.18,0:13:13.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu tak boleh terjadi!
Dialogue: 0,0:13:13.79,0:13:15.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau kuajari?
Dialogue: 0,0:13:15.89,0:13:17.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin tak kelihatan,
Dialogue: 0,0:13:17.16,0:13:20.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi nilaiku peringkat satu, satu angkatan.
Dialogue: 0,0:13:20.10,0:13:21.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitulah.
Dialogue: 0,0:13:22.45,0:13:23.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu akan sangat membantu.
Dialogue: 0,0:13:23.88,0:13:27.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kudengar kau khawatir soal UTS, ya?
Dialogue: 0,0:13:27.40,0:13:28.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:13:28.53,0:13:33.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kalian punya trik belajar khusus?
Dialogue: 0,0:13:34.13,0:13:36.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada yang spesial.
Dialogue: 0,0:13:36.07,0:13:38.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma belajar\Nsedikit lebih giat dari biasanya.
Dialogue: 0,0:13:38.83,0:13:41.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku lebih banyak meluangkan waktu\Nuntuk mengulas materi.
Dialogue: 0,0:13:41.83,0:13:46.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Tomonari, bagaimana cara belajarmu\Ndi sekolah lama?
Dialogue: 0,0:13:46.56,0:13:47.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba kupikir-pikir...
Dialogue: 0,0:13:47.92,0:13:49.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kadang aku bergadang...
Dialogue: 0,0:13:49.80,0:13:51.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Juga mengadakan belajar kelompok.
Dialogue: 0,0:13:51.83,0:13:53.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belajar kelompok?
Dialogue: 0,0:13:53.05,0:13:55.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, kita kumpul untuk belajar bersama.
Dialogue: 0,0:13:55.94,0:13:57.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belajar bersama bisa meningkatkan motivasi,
Dialogue: 0,0:13:58.29,0:14:00.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan kita bisa menebak-nebak\Nmateri apa yang akan keluar di ujian.
Dialogue: 0,0:14:00.85,0:14:03.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau kita coba cara itu?
Dialogue: 0,0:14:03.09,0:14:03.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:14:03.60,0:14:07.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita adakan belajar kelompok!\NKedengarannya seru!
Dialogue: 0,0:14:07.28,0:14:10.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau kita ajak\Nteman-teman pesta teh kemarin?
Dialogue: 0,0:14:10.71,0:14:12.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ide bagus!
Dialogue: 0,0:14:12.36,0:14:13.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:14:13.22,0:14:15.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tomonari, kapan kau punya waktu luang?
Dialogue: 0,0:14:16.86,0:14:19.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita mulai belajar kelompok kita.
Dialogue: 0,0:14:19.87,0:14:21.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hore!
Dialogue: 0,0:14:22.82,0:14:28.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dipikir-pikir, lega rasanya\Nada dua murid terpintar angkatan kita.
Dialogue: 0,0:14:28.02,0:14:31.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Konohana peringkat pertama, 'kan?\NSiapa peringkat keduanya?
Dialogue: 0,0:14:31.43,0:14:33.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu aku.
Dialogue: 0,0:14:34.21,0:14:35.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, maaf.
Dialogue: 0,0:14:36.10,0:14:38.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asahi, nilaimu lumayan bagus, 'kan?
Dialogue: 0,0:14:38.17,0:14:40.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bandingkan aku dengan si juara...
Dialogue: 0,0:14:40.56,0:14:42.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah nilai Miyakojima\Nlebih bagus dariku?
Dialogue: 0,0:14:42.58,0:14:43.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:14:43.09,0:14:47.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ni-Nilaiku yang bagus\Ncuma pelajaran olahraga dan sejarah.
Dialogue: 0,0:14:47.18,0:14:48.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejarah?
Dialogue: 0,0:14:48.42,0:14:52.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keluarga Miyakojima\Nsangat menjunjung tradisi samurai.
Dialogue: 0,0:14:52.37,0:14:55.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak kecil,\Naku cuma disuruh belajar sejarah.
Dialogue: 0,0:14:56.20,0:15:00.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelajaran sisanya nilaiku hancur.
Dialogue: 0,0:15:00.76,0:15:02.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eum, aku harus bilang apa, ya?
Dialogue: 0,0:15:02.94,0:15:04.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan aku.
Dialogue: 0,0:15:04.18,0:15:06.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, tidak apa-apa.\NJangan dipikirkan.
Dialogue: 0,0:15:06.69,0:15:11.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tomonari, apa kau punya ide\Nuntuk belajar kelompok ini?
Dialogue: 0,0:15:11.47,0:15:12.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, tidak ada.
Dialogue: 0,0:15:12.69,0:15:17.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau kita membagi kelompok\Njadi tutor dan murid?
Dialogue: 0,0:15:17.08,0:15:19.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cara itu rasanya paling efektif.
Dialogue: 0,0:15:19.61,0:15:23.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Konohana, Asahi, dan aku akan jadi tutornya.
Dialogue: 0,0:15:23.62,0:15:26.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh juga, kau yakin?
Dialogue: 0,0:15:26.53,0:15:28.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja tak masalah.
Dialogue: 0,0:15:28.17,0:15:30.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengajari orang lain juga bisa\Nmembantu kita lebih paham materinya.
Dialogue: 0,0:15:30.91,0:15:32.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kau bilang begitu...
Dialogue: 0,0:15:32.51,0:15:35.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tomonari, pelajaran apa yang menurutmu\Npaling sulit?
Dialogue: 0,0:15:35.79,0:15:37.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa, ya?
Dialogue: 0,0:15:37.38,0:15:39.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Khususnya, aku kesulitan di Matematika.
Dialogue: 0,0:15:40.06,0:15:41.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku bisa...
Dialogue: 0,0:15:41.03,0:15:43.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,\Nbiar aku yang mengajarimu, Tomonari.
Dialogue: 0,0:15:43.85,0:15:46.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Matematika adalah keahlianku.
Dialogue: 0,0:15:46.46,0:15:49.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,\Nbiar aku yang mengajari Miyakojima, ya?
Dialogue: 0,0:15:49.30,0:15:50.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mo-Mohon bantuannya!
Dialogue: 0,0:15:50.86,0:15:53.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu artinya aku diajari Konohana?
Dialogue: 0,0:15:53.74,0:15:56.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Dengan senang hati\Naku akan mengajarimu, Taisho.
Dialogue: 0,0:15:56.91,0:15:58.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini suatu kehormatan!
Dialogue: 0,0:15:58.06,0:15:59.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, sakit.
Dialogue: 0,0:15:59.98,0:16:02.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suasana hati Hinako memburuk sejak kemarin.
Dialogue: 0,0:16:02.74,0:16:05.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena awalnya kami berencana\Ncuma belajar berdua.
Dialogue: 0,0:16:06.05,0:16:07.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, aduh!
Dialogue: 0,0:16:07.41,0:16:09.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhentilah menginjak kakiku seperti itu!
Dialogue: 0,0:16:10.20,0:16:12.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Bagaimana kalau kita mulai sekarang?
Dialogue: 0,0:16:15.31,0:16:16.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sungguh mengejutkan.
Dialogue: 0,0:16:16.97,0:16:20.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkat ajaran Tennoji,\Naku bisa paham dengan cepat.
Dialogue: 0,0:16:22.15,0:16:24.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tak apa-apa, Miyakojima?
Dialogue: 0,0:16:24.38,0:16:26.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau kita istirahat dulu?
Dialogue: 0,0:16:26.37,0:16:27.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh juga.
Dialogue: 0,0:16:27.85,0:16:30.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kepalaku rasanya mau pecah.
Dialogue: 0,0:16:30.54,0:16:33.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau kita istirahat semuanya?
Dialogue: 0,0:16:36.58,0:16:37.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tomonari.
Dialogue: 0,0:16:39.56,0:16:41.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, kerja bagus.
Dialogue: 0,0:16:41.97,0:16:44.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada waktu sebentar?
Dialogue: 0,0:16:44.20,0:16:46.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada hal yang ingin kutanyakan.
Dialogue: 0,0:16:46.65,0:16:47.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kepadaku?
Dialogue: 0,0:16:48.06,0:16:52.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau benar-benar\Npewaris perusahaan kelas menengah?
Dialogue: 0,0:16:53.39,0:16:55.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ketahuan? Bagaimana bisa?
Dialogue: 0,0:16:55.53,0:16:57.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau tanya begitu?
Dialogue: 0,0:16:57.82,0:16:59.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal tata kramamu di meja makan tadi.
Dialogue: 0,0:17:00.40,0:17:02.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ada yang kurang?
Dialogue: 0,0:17:02.11,0:17:04.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, semuanya hampir sempurna.
Dialogue: 0,0:17:05.17,0:17:08.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya saja, gerakanmu terlihat terburu-buru.
Dialogue: 0,0:17:08.84,0:17:13.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seakan-akan kau baru dijejali\Ntata krama dalam waktu singkat.
Dialogue: 0,0:17:13.49,0:17:16.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau harus memaksakan diri seperti itu?
Dialogue: 0,0:17:16.90,0:17:21.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin latar belakangmu bisa menjawabnya.
Dialogue: 0,0:17:21.70,0:17:25.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau tak mau cerita,\Naku tak akan memaksa.
Dialogue: 0,0:17:25.85,0:17:28.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau tak curiga padaku?
Dialogue: 0,0:17:28.30,0:17:31.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akademi ini tak menerima sembarang\Norang mencurigakan.
Dialogue: 0,0:17:31.35,0:17:34.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau pasti sudah melewati\Npemeriksaan latar belakang yang ketat.
Dialogue: 0,0:17:34.38,0:17:36.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma penasaran saja.
Dialogue: 0,0:17:37.40,0:17:39.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa jangan-jangan kau juga...
Dialogue: 0,0:17:41.75,0:17:43.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, lupakan saja.
Dialogue: 0,0:17:44.28,0:17:45.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus kembali.
Dialogue: 0,0:17:46.34,0:17:48.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti seru banget!
Dialogue: 0,0:17:48.02,0:17:50.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Baguslah, aku ingin sekali ke sana!\N- Kalian tampak bersemangat sekali.
Dialogue: 0,0:17:50.96,0:17:55.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, kami baru saja membicarakan\Npesta di kediaman Konohana.
Dialogue: 0,0:17:55.92,0:18:01.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, maksud kalian\Njamuan makan malam rutin tiap musim semi itu?
Dialogue: 0,0:18:01.52,0:18:03.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jamuan makan malam?
Dialogue: 0,0:18:03.67,0:18:07.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, tentu saja.\NKau sudah pernah menghadirinya, Tennoji?
Dialogue: 0,0:18:07.42,0:18:08.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum.
Dialogue: 0,0:18:08.18,0:18:10.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayahku memang pernah ke sana beberapa kali,
Dialogue: 0,0:18:10.90,0:18:14.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi Keluarga Tennoji dan Konohana\Npunya hubungan yang rumit,
Dialogue: 0,0:18:14.50,0:18:16.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi aku selalu menolak hadir.
Dialogue: 0,0:18:18.03,0:18:20.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kau pernah hadir, Miyakojima?
Dialogue: 0,0:18:20.60,0:18:23.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak, aku tak suka pesta.
Dialogue: 0,0:18:23.57,0:18:26.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kurang luwes bergaul di depan umum.
Dialogue: 0,0:18:26.03,0:18:28.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi sepertinya keluargaku dapat undangannya.
Dialogue: 0,0:18:28.72,0:18:32.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dapat undangan saja sudah hebat.
Dialogue: 0,0:18:33.15,0:18:37.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku suka pakai gaun,\Njadi aku lumayan sering ikut pesta.
Dialogue: 0,0:18:37.74,0:18:39.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku yakin pesta Keluarga Konohana
Dialogue: 0,0:18:39.84,0:18:41.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pasti adalah puncak kemewahan.
Dialogue: 0,0:18:41.29,0:18:45.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asahi, kau mau kuberikan undangan?
Dialogue: 0,0:18:45.25,0:18:47.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Boleh, nih?
Dialogue: 0,0:18:47.01,0:18:49.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu.\NAku juga akan mengirimi Taisho undangan.
Dialogue: 0,0:18:49.59,0:18:51.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}O-Oh, astaga!
Dialogue: 0,0:18:51.74,0:18:53.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi ikutan gugup!
Dialogue: 0,0:18:53.38,0:18:54.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa benar tak apa-apa?
Dialogue: 0,0:18:54.94,0:18:58.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka bilang aku boleh\Nmengundang teman kalau mau.
Dialogue: 0,0:18:58.31,0:18:59.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski belum pernah kulakukan sebelumnya.
Dialogue: 0,0:18:59.85,0:19:04.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Konohana, aku juga mau ikut pestamu nanti.
Dialogue: 0,0:19:04.60,0:19:07.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita akan kumpul satu meja seperti ini lagi.
Dialogue: 0,0:19:07.48,0:19:10.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa aku bisa menerima undanganmu,
Dialogue: 0,0:19:10.74,0:19:14.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bukan sebagai putri Keluarga Tennoji,\Ntapi sebagai teman.
Dialogue: 0,0:19:14.58,0:19:16.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, aku menantikan kehadiranmu.
Dialogue: 0,0:19:16.92,0:19:18.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau juga akan hadir, 'kan, Tomonari?
Dialogue: 0,0:19:18.98,0:19:21.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, ya. Aku takkan melewatkan kesempatan ini.
Dialogue: 0,0:19:22.16,0:19:24.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus berangkat bareng nanti,\NMiyakojima.
Dialogue: 0,0:19:24.89,0:19:27.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Akan kupertimbangkan.
Dialogue: 0,0:19:29.15,0:19:31.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya, hari UTS tiba.
Dialogue: 0,0:19:31.50,0:19:33.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktunya 90 menit per mata pelajaran,
Dialogue: 0,0:19:33.66,0:19:36.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}termasuk yang tidak ada di sekolah lain,\Nseperti Ekonomi,
Dialogue: 0,0:19:37.20,0:19:39.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}selama tiga hari.
Dialogue: 0,0:19:42.62,0:19:46.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini benar-benar tak main-main untukku,\Ntapi aku sudah melakukan yang terbaik.
Dialogue: 0,0:19:50.82,0:19:53.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itsuki, lagi apa?
Dialogue: 0,0:19:54.21,0:19:56.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma belajar sedikit.
Dialogue: 0,0:19:56.36,0:19:58.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal UTS kita baru saja selesai?
Dialogue: 0,0:19:58.06,0:20:00.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, aku lumayan puas dengan hasilnya.
Dialogue: 0,0:20:00.75,0:20:05.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bimbingan dari Tennoji,\Njuga ujian latihan dari Shizune...
Dialogue: 0,0:20:05.82,0:20:07.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat bersyukur atas bantuan mereka.
Dialogue: 0,0:20:07.82,0:20:09.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Murid yang rajin.
Dialogue: 0,0:20:09.77,0:20:13.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tahu-tahu kau sudah terlelap di kasurku.
Dialogue: 0,0:20:13.08,0:20:16.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kuantar,\Njadi tidurlah di kamarmu sendiri.
Dialogue: 0,0:20:16.72,0:20:18.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah tidak mengantuk.
Dialogue: 0,0:20:18.43,0:20:19.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya?
Dialogue: 0,0:20:19.94,0:20:21.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau kita jalan-jalan?
Dialogue: 0,0:20:21.92,0:20:23.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Jalan-jalan?
Dialogue: 0,0:20:23.37,0:20:27.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ada tempat yang kau suka di rumah ini?
Dialogue: 0,0:20:28.12,0:20:28.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada.
Dialogue: 0,0:20:29.24,0:20:30.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kutunjukkan.
Dialogue: 0,0:20:32.22,0:20:35.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, apa kita tersesat?
Dialogue: 0,0:20:35.66,0:20:37.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seharusnya jalannya benar.
Dialogue: 0,0:20:38.50,0:20:40.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah ini cuma pintu pelayan?
Dialogue: 0,0:20:40.86,0:20:43.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kadang aku menggunakan pintu ini\Nuntuk menyelinap ke taman.
Dialogue: 0,0:20:44.17,0:20:47.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, kita bisa dimarahi kalau ketahuan.
Dialogue: 0,0:20:47.72,0:20:49.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Petugas keamanan tidak berpatroli\Ndi area ini.
Dialogue: 0,0:20:49.78,0:20:52.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya. Syukurlah kalau begitu.
Dialogue: 0,0:20:54.21,0:20:55.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau?
Dialogue: 0,0:20:55.92,0:20:58.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pantas saja dari tadi aku penasaran\Napa yang kau bawa.
Dialogue: 0,0:20:58.30,0:21:00.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan beri tahu Shizune soal ini.
Dialogue: 0,0:21:00.33,0:21:01.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:21:06.78,0:21:07.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, enak!
Dialogue: 0,0:21:08.43,0:21:10.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak sekali!
Dialogue: 0,0:21:11.69,0:21:16.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, apa belajar kelompok kemarin\Nmembuatmu kelelahan?
Dialogue: 0,0:21:16.02,0:21:17.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, tapi aku sudah lebih baik sekarang.
Dialogue: 0,0:21:17.79,0:21:19.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat kau pingsan,
Dialogue: 0,0:21:19.76,0:21:23.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa itu juga gara-gara kau ikut\Npesta teh demi aku?
Dialogue: 0,0:21:23.39,0:21:25.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan.
Dialogue: 0,0:21:25.44,0:21:27.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti akan lebih buruk\Njika aku tak ikut denganmu.
Dialogue: 0,0:21:28.99,0:21:30.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:21:30.14,0:21:32.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau sedang tidak menahan sakit sekarang?
Dialogue: 0,0:21:32.57,0:21:35.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, kok.
Dialogue: 0,0:21:35.04,0:21:36.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau merasa lebih nyaman\Ntanpa dikelilingi orang-orang,
Dialogue: 0,0:21:36.81,0:21:39.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kau tak perlu memaksakan diri\Nuntuk selalu ikut acara.
Dialogue: 0,0:21:41.18,0:21:44.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semenjak kau ada di sini,\Nada satu hal yang baru kusadari.
Dialogue: 0,0:21:44.81,0:21:45.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:21:46.00,0:21:47.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menghindar dari keramaian\Ntak selamanya membuatku lebih baik.
Dialogue: 0,0:21:49.78,0:21:50.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:21:53.78,0:21:55.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aturan belum tiga detik...
Dialogue: 0,0:21:55.29,0:21:56.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan dimakan!
