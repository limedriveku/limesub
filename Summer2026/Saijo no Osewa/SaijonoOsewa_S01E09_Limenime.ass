Dialogue: 0,0:02:31.52,0:02:34.07,sign,,0000,0000,0000,,EPISODE 9: HARI LIBUR SANG NONA MUDA
Dialogue: 0,0:05:54.27,0:05:55.39,sign,,0000,0000,0000,,KALAH, MENANG
Dialogue: 0,0:14:36.11,0:14:40.34,sign,,0000,0000,0000,,"PERINGKAT 1: KONOHANA HINAKO, TENNOJI MIREI"
Dialogue: 0,0:00:09.65,0:00:11.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dipikir-pikir...
Dialogue: 0,0:00:11.61,0:00:14.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini hari pertama\Naku keluar bukan untuk urusan pekerjaan
Dialogue: 0,0:00:14.35,0:00:15.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sejak aku menjadi pengurusnya.
Dialogue: 0,0:00:18.98,0:00:22.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat aku mengajak Tennoji kemarin...
Dialogue: 0,0:00:22.44,0:00:24.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin kau benar.
Dialogue: 0,0:00:24.36,0:00:27.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan senang hati aku terima ajakanmu.
Dialogue: 0,0:00:28.62,0:00:32.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nada bicaranya terdengar seolah dia sedang\Nberusaha membuat satu kenangan terakhir
Dialogue: 0,0:00:32.32,0:00:35.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebelum meninggalkan Akademi Kiou.
Dialogue: 0,0:00:36.02,0:00:39.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus berjuang keras\Nagar semua ini tidak berakhir begitu saja.
Dialogue: 0,0:00:39.88,0:00:41.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah menunggu.
Dialogue: 0,0:00:55.74,0:00:57.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tennoji...
Dialogue: 0,0:02:19.64,0:02:22.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rich Girl Caretaker:
Dialogue: 0,0:02:22.20,0:02:27.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I'm Secretly the Caregiver of the\NMost Popular Girl in This Rich Kid School
Dialogue: 0,0:02:34.07,0:02:36.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau terkejut?
Dialogue: 0,0:02:36.11,0:02:37.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini penyamaranku.
Dialogue: 0,0:02:38.60,0:02:44.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau akan mengajakku ke tempat\Nyang belum pernah kudatangi, 'kan?
Dialogue: 0,0:02:44.38,0:02:47.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak mau terlalu mencolok di tempat umum.
Dialogue: 0,0:02:47.91,0:02:49.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:02:49.08,0:02:52.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, jangan-jangan kau mulai\Njatuh cinta padaku lagi?
Dialogue: 0,0:02:52.41,0:02:54.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Tidak, itu...
Dialogue: 0,0:02:54.68,0:02:57.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau lebih suka yang mana,
Dialogue: 0,0:02:57.06,0:02:59.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}penampilanku yang sekarang\Natau yang biasanya?
Dialogue: 0,0:02:59.05,0:03:00.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?!
Dialogue: 0,0:03:03.23,0:03:05.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini kau sangat menawan,
Dialogue: 0,0:03:05.52,0:03:09.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi jika disuruh memilih,\Naku lebih suka yang biasanya.
Dialogue: 0,0:03:09.33,0:03:10.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:03:11.22,0:03:14.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, penampilanku ini bukan seleramu, ya.
Dialogue: 0,0:03:14.47,0:03:16.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, bukan begitu.
Dialogue: 0,0:03:17.01,0:03:20.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dirimu yang biasanya itu\Njauh lebih memancarkan aura Tennoji...
Dialogue: 0,0:03:20.53,0:03:22.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seolah-olah itu adalah\Ndirimu yang sebenarnya.
Dialogue: 0,0:03:25.60,0:03:27.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, Itsuki...
Dialogue: 0,0:03:27.54,0:03:31.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bolehkah aku, eum,\Nmenganggap ini sebagai sebuah kencan?
Dialogue: 0,0:03:34.29,0:03:36.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Y-Yah, kurasa begitu.
Dialogue: 0,0:03:38.45,0:03:42.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini akan jadi pengalaman pertamaku\Npergi berkencan dengan seorang pria.
Dialogue: 0,0:03:43.83,0:03:45.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oleh karena itu...
Dialogue: 0,0:03:46.36,0:03:48.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat menantikannya.
Dialogue: 0,0:03:49.15,0:03:50.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Y-Ya.
Dialogue: 0,0:03:51.27,0:03:54.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan menunjukkan padamu\Ncara kami bersenang-senang.
Dialogue: 0,0:03:55.01,0:03:58.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, kau memang benar-benar\Nmewarnai rambutmu, ya?
Dialogue: 0,0:03:59.39,0:04:01.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa kok tiba-tiba menanyakan itu?
Dialogue: 0,0:04:01.49,0:04:04.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah tidak ada kebohongan lagi\Ndi antara kita, 'kan?
Dialogue: 0,0:04:06.83,0:04:08.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku...
Dialogue: 0,0:04:09.95,0:04:11.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memang aku mewarnai rambutku!
Dialogue: 0,0:04:14.51,0:04:16.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu aku masih kecil,
Dialogue: 0,0:04:16.10,0:04:19.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku mencari cara agar pantas menyandang\Nstatusku sebagai putri Tennoji,
Dialogue: 0,0:04:19.95,0:04:21.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan aku mulai mewarnai rambutku.
Dialogue: 0,0:04:21.75,0:04:23.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama halnya dengan gaya bicaraku itu.
Dialogue: 0,0:04:24.01,0:04:25.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga.
Dialogue: 0,0:04:25.53,0:04:27.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau merasa keberatan?
Dialogue: 0,0:04:29.99,0:04:34.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau selalu saja mengejekku,\Njadi aku mau sedikit membalas.
Dialogue: 0,0:04:34.15,0:04:35.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak merasa keberatan.
Dialogue: 0,0:04:36.80,0:04:38.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti yang baru saja kubilang.
Dialogue: 0,0:04:38.61,0:04:41.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku lebih suka\Nsaat kau menjadi dirimu sendiri, Tennoji.
Dialogue: 0,0:04:43.85,0:04:46.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau benar-benar pandai merayu, ya.
Dialogue: 0,0:04:46.12,0:04:49.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tutup mulutmu itu, dasar perayu!
Dialogue: 0,0:04:53.51,0:04:55.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak memberi tahu Tennoji,
Dialogue: 0,0:04:56.56,0:05:00.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi ini juga kencan pertamaku.
Dialogue: 0,0:05:05.55,0:05:07.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa ini?
Dialogue: 0,0:05:08.07,0:05:11.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempat apa ini? Tempat apa ini?
Dialogue: 0,0:05:11.05,0:05:12.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini?!
Dialogue: 0,0:05:27.26,0:05:29.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah! Peringkat pertama!
Dialogue: 0,0:05:29.11,0:05:30.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana denganmu?
Dialogue: 0,0:05:31.17,0:05:33.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Peringkat terakhir...
Dialogue: 0,0:05:34.63,0:05:36.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak usah sesedih itu.
Dialogue: 0,0:05:36.63,0:05:39.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan menertawakanku!
Dialogue: 0,0:05:39.01,0:05:41.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah berjuang keras!
Dialogue: 0,0:05:41.81,0:05:44.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, masih banyak permainan lain.
Dialogue: 0,0:05:55.39,0:05:57.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, aku menang lagi.
Dialogue: 0,0:06:00.03,0:06:04.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seandainya ini drum taiko sungguhan,\Naku pasti bisa mengalahkanmu!
Dialogue: 0,0:06:04.65,0:06:07.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu alasan kekalahan yang cukup kreatif.
Dialogue: 0,0:06:07.80,0:06:09.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo lanjut ke permainan berikutnya!
Dialogue: 0,0:06:22.16,0:06:26.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itsuki, apa kau sering bermain\Ndi sini dulunya?
Dialogue: 0,0:06:26.85,0:06:28.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dulu aku bekerja paruh waktu di sini.
Dialogue: 0,0:06:28.98,0:06:30.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ada kenalanku yang datang berkunjung,
Dialogue: 0,0:06:30.93,0:06:35.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}manajerku mengizinkanku\Nuntuk ikut bermain sebentar.
Dialogue: 0,0:06:35.34,0:06:37.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya?
Dialogue: 0,0:06:37.29,0:06:39.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagiku ini adalah pengalaman pertama.
Dialogue: 0,0:06:39.88,0:06:42.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempat yang sangat membangkitkan semangat.
Dialogue: 0,0:06:46.99,0:06:48.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat! Itu Yuri!
Dialogue: 0,0:06:49.60,0:06:52.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia pasti marah\Nkarena aku jarang meneleponnya lagi.
Dialogue: 0,0:06:52.52,0:06:55.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, bagaimana caraku\Nmenjelaskan semua ini?
Dialogue: 0,0:06:59.90,0:07:01.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:07:01.38,0:07:04.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi ada teman sekelasku dari SMA lamaku.
Dialogue: 0,0:07:04.93,0:07:06.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau membiarkannya pergi?
Dialogue: 0,0:07:06.32,0:07:07.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:07:08.03,0:07:10.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa kita sudah cukup bermain arkade.
Dialogue: 0,0:07:10.02,0:07:12.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau kita bertanding\Ndi permainan boling berikutnya?
Dialogue: 0,0:07:12.42,0:07:14.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau kau lebih memilih karaoke?
Dialogue: 0,0:07:14.49,0:07:16.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keduanya.
Dialogue: 0,0:07:17.46,0:07:19.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo lakukan keduanya!
Dialogue: 0,0:07:19.52,0:07:22.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku takkan membiarkanmu pulang\Nsampai aku bisa menang!
Dialogue: 0,0:07:24.31,0:07:27.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah lama aku tak bermain selelah ini.
Dialogue: 0,0:07:27.27,0:07:29.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana rasanya\Nbersantai seperti orang biasa?
Dialogue: 0,0:07:29.53,0:07:32.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya sangat buruk!
Dialogue: 0,0:07:32.37,0:07:34.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak bisa mengalahkanmu\Ndi satu pun permainan arkade,
Dialogue: 0,0:07:34.78,0:07:37.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan aku kalah telak saat main boling!
Dialogue: 0,0:07:37.09,0:07:39.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertarungan kita cukup sengit saat karaoke.
Dialogue: 0,0:07:39.84,0:07:44.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak bisa bangga meski mendapat\Nskor tinggi dari lagu anak-anak!
Dialogue: 0,0:07:44.64,0:07:46.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, hal ini sudah kuduga.
Dialogue: 0,0:07:47.13,0:07:48.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:07:48.75,0:07:53.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kupikir kau akan sangat menikmatinya\Njika ada unsur kompetisinya.
Dialogue: 0,0:07:53.14,0:07:54.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:07:54.21,0:07:58.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah lama aku tak merasa sebersemangat ini.
Dialogue: 0,0:08:00.54,0:08:01.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi bagaimana sekarang?
Dialogue: 0,0:08:01.71,0:08:04.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau menghabiskan waktu di tempat lain?
Dialogue: 0,0:08:04.06,0:08:09.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sih, mau saja,\Ntapi aku harus segera pulang.
Dialogue: 0,0:08:10.47,0:08:13.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, mari kita akhiri hari ini.
Dialogue: 0,0:08:15.09,0:08:17.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cara bicaramu itu sangat menusuk.
Dialogue: 0,0:08:19.03,0:08:22.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kau membatalkan pertunanganmu,\Nkita bisa jalan-jalan seperti ini lagi.
Dialogue: 0,0:08:23.01,0:08:27.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa pun yang kau bilang,\Naku takkan berubah pikiran.
Dialogue: 0,0:08:28.86,0:08:34.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kebetulan saja aku sangat menikmati\Nwaktu luang kita hari ini.
Dialogue: 0,0:08:34.28,0:08:40.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namun, pertunangan ini menyangkut\Nmasa depan Keluarga Tennoji.
Dialogue: 0,0:08:40.25,0:08:42.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, bersenang-senang saja tak cukup?
Dialogue: 0,0:08:44.31,0:08:48.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bukan alasan yang kuat\Nuntuk menolak pertunanganku?
Dialogue: 0,0:08:48.61,0:08:51.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Te-Tentu saja bukan!
Dialogue: 0,0:08:51.89,0:08:54.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau harus meninggalkan sekolah ini\Ndemi pertunanganmu.
Dialogue: 0,0:08:54.54,0:08:56.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau sungguh rela melakukan itu semua?
Dialogue: 0,0:08:56.82,0:09:01.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau rela mengorbankan segalanya\Ndemi Keluarga Tennoji?
Dialogue: 0,0:09:03.15,0:09:08.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak bisa membayangkan seberapa\Nberatnya beban yang harus kau pikul.
Dialogue: 0,0:09:08.79,0:09:11.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi setelah bertemu\Ndengan kedua orang tuamu,
Dialogue: 0,0:09:11.50,0:09:13.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ada satu hal yang kupahami.
Dialogue: 0,0:09:14.37,0:09:17.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin hal yang paling berharga\Nbagi mereka adalah Tennoji Mirei,
Dialogue: 0,0:09:17.79,0:09:20.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bukan Keluarga Tennoji.
Dialogue: 0,0:09:21.52,0:09:24.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau keliru.
Dialogue: 0,0:09:24.58,0:09:29.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu dan Ayah hanya bersikap terlalu baik\Nsampai tak tega memaksaku.
Dialogue: 0,0:09:29.57,0:09:33.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jauh di lubuk hati mereka,\Nmereka ingin aku mengabdi pada keluarga ini.
Dialogue: 0,0:09:33.54,0:09:35.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau juga tahu itu tak benar!
Dialogue: 0,0:09:36.01,0:09:39.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mewarnai rambutmu jadi pirang\Ndan bicara dengan nada aneh!
Dialogue: 0,0:09:39.93,0:09:43.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau sungguh yakin\Nitu akan menguntungkan Keluarga Tennoji?!
Dialogue: 0,0:09:44.73,0:09:46.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-A-Apa?
Dialogue: 0,0:09:46.45,0:09:51.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meskipun begitu, kedua orang tuamu\Ntak pernah mengeluh sedikit pun, 'kan?
Dialogue: 0,0:09:52.69,0:09:57.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih dari segalanya, yang mereka inginkan\Nadalah melihatmu bahagia.
Dialogue: 0,0:10:00.44,0:10:04.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pernahkah kau menghadapi perasaan mereka\Nsecara langsung, Tennoji?
Dialogue: 0,0:10:08.88,0:10:10.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu.
Dialogue: 0,0:10:10.24,0:10:14.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika aku rajin belajar, apakah itu\Nakan menguntungkan Keluarga Tennoji?
Dialogue: 0,0:10:15.39,0:10:17.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, tentu saja.
Dialogue: 0,0:10:17.54,0:10:18.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah.
Dialogue: 0,0:10:18.83,0:10:23.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika aku jadi orang terpandang, apa itu\Njuga akan menguntungkan Keluarga Tennoji?
Dialogue: 0,0:10:24.67,0:10:25.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu benar.
Dialogue: 0,0:10:26.74,0:10:31.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat aku masih kecil, yang kuinginkan\Nhanyalah melihat Ibu dan Ayah bahagia...
Dialogue: 0,0:10:32.87,0:10:34.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku kerahkan seluruh kemampuanku.
Dialogue: 0,0:10:36.03,0:10:37.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mirei.
Dialogue: 0,0:10:37.17,0:10:41.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau selalu belajar dengan tekun\Nsampai larut malam.
Dialogue: 0,0:10:41.07,0:10:44.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau berhak menjalani hidup lebih bebas...
Dialogue: 0,0:10:44.19,0:10:46.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak perlu cemas.
Dialogue: 0,0:10:46.63,0:10:50.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini adalah jalan hidup yang kupilih\Nuntuk diriku sendiri.
Dialogue: 0,0:10:51.78,0:10:52.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mirei.
Dialogue: 0,0:10:53.12,0:10:58.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paham tata krama memang hal yang bagus,\Ntapi kau juga butuh bersantai sesekali.
Dialogue: 0,0:10:58.36,0:10:59.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saya tak masalah sama sekali.
Dialogue: 0,0:11:00.16,0:11:02.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa mengatasi ini dengan baik.
Dialogue: 0,0:11:02.77,0:11:06.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada satu titik,\Naku mulai mengalihkan pandanganku.
Dialogue: 0,0:11:07.99,0:11:09.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku melarikan diri.
Dialogue: 0,0:11:12.12,0:11:15.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak cukup percaya diri\Nuntuk menjadi anak mereka.
Dialogue: 0,0:11:15.67,0:11:19.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jalan yang aku tempuh\Nadalah menjadi putri Tennoji.
Dialogue: 0,0:11:20.47,0:11:22.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu jauh lebih mudah.
Dialogue: 0,0:11:23.13,0:11:27.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meraih nilai memuaskan dalam ujian\Ndan paham sopan santun...
Dialogue: 0,0:11:27.56,0:11:30.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu jauh lebih gampang ketimbang\Nmencoba membalas kasih sayang mereka.
Dialogue: 0,0:11:31.92,0:11:35.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ucapanmu akhirnya berhasil menyadarkanku.
Dialogue: 0,0:11:36.35,0:11:37.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kenapa?
Dialogue: 0,0:11:38.58,0:11:42.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kau peduli sejauh ini\Nsampai mau mengatakan semua itu kepadaku?
Dialogue: 0,0:11:42.66,0:11:47.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena aku juga ingin kau menjalani hidup\Nsebahagia mungkin.
Dialogue: 0,0:11:49.39,0:11:54.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meskipun kebersamaan kita saat ini\Ntakkan menguntungkan Keluarga Tennoji,
Dialogue: 0,0:11:54.39,0:11:56.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jika itu sangat berarti bagimu...
Dialogue: 0,0:11:57.42,0:11:59.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tak ingin kau menyia-nyiakannya.
Dialogue: 0,0:12:03.86,0:12:05.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar penipu...
Dialogue: 0,0:12:05.56,0:12:09.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penipu, penipu, penipu...
Dialogue: 0,0:12:12.75,0:12:15.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kubiarkan diriku jatuh\Ndalam tipu dayamu.
Dialogue: 0,0:12:23.32,0:12:25.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan membatalkan perjodohanku.
Dialogue: 0,0:12:26.45,0:12:30.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak sanggup\Nmelepaskan sesuatu yang amat berharga.
Dialogue: 0,0:12:32.43,0:12:35.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.\NSyukurlah kalau begitu...
Dialogue: 0,0:12:37.63,0:12:44.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejujurnya, aku tidak begitu yakin waktu\Nkebersamaan kita hari ini seberharga itu...
Dialogue: 0,0:12:44.26,0:12:46.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau keliru.
Dialogue: 0,0:12:47.61,0:12:50.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang berharga bagiku itu adalah kau.
Dialogue: 0,0:12:52.08,0:12:54.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah Tennoji membatalkan pertunangannya,
Dialogue: 0,0:12:55.06,0:12:58.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sesi belajar kami sepulang sekolah\Nberakhir setelah beberapa hari,
Dialogue: 0,0:12:58.26,0:13:00.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan ujian kecakapan pun tiba.
Dialogue: 0,0:13:01.23,0:13:03.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu minggu kemudian...
Dialogue: 0,0:13:04.58,0:13:06.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tomonari. Konohana.
Dialogue: 0,0:13:06.77,0:13:07.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sini!
Dialogue: 0,0:13:09.63,0:13:11.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita cek hasilnya bersama.
Dialogue: 0,0:13:15.58,0:13:18.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namaku tidak ada di sini...
Dialogue: 0,0:13:18.01,0:13:19.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wajar saja.
Dialogue: 0,0:13:20.10,0:13:26.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siswa di akademi ini telah menempuh\Npendidikan bergengsi sejak usia dini.
Dialogue: 0,0:13:26.05,0:13:30.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedangkan kau baru mencoba mengejar\Nketertinggalan dalam waktu sebulan.
Dialogue: 0,0:13:31.38,0:13:34.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku gagal mencapai target\Nyang kau tetapkan untukku...
Dialogue: 0,0:13:35.27,0:13:38.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau tak mencoba\Nmenghitung skormu sendiri?
Dialogue: 0,0:13:38.32,0:13:39.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:13:39.98,0:13:43.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa saja nilaimu hanya selisih tipis.
Dialogue: 0,0:13:44.21,0:13:46.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin kau akan menyabet peringkat pertama\Nuntuk peningkatan skor terbanyak.
Dialogue: 0,0:13:47.37,0:13:51.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang kau cuma perlu\Npertahankan semangatmu.
Dialogue: 0,0:13:53.01,0:13:54.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa kau benar...
Dialogue: 0,0:13:54.96,0:13:57.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau benar. Aku akan terus berusaha.
Dialogue: 0,0:13:57.45,0:14:01.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, Tennoji\Nmasih akan terus bersekolah di sini.
Dialogue: 0,0:14:03.09,0:14:05.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namaku juga tak ada di sana.
Dialogue: 0,0:14:05.59,0:14:08.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja aku juga tidak ada.
Dialogue: 0,0:14:08.39,0:14:10.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, aku juga tak ada.
Dialogue: 0,0:14:11.77,0:14:14.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah, skor sempurna.
Dialogue: 0,0:14:14.41,0:14:15.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga.
Dialogue: 0,0:14:15.93,0:14:17.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skornya sempurna.
Dialogue: 0,0:14:24.26,0:14:26.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa skor sempurna itu langka?
Dialogue: 0,0:14:26.57,0:14:31.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, karena ujian di akademi kita\Nmemang kelewat susah.
Dialogue: 0,0:14:31.26,0:14:32.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sangat jarang terjadi.
Dialogue: 0,0:14:34.36,0:14:36.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu dulu...
Dialogue: 0,0:14:36.11,0:14:40.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Ada dua peraih skor sempurna?
Dialogue: 0,0:14:46.95,0:14:49.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja yang bagus, Hinako.
Dialogue: 0,0:14:49.03,0:14:50.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:14:50.46,0:14:53.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak ingin kalah dari kalian berdua.
Dialogue: 0,0:15:02.98,0:15:05.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sainganku memang tak bisa diremehkan!
Dialogue: 0,0:15:07.22,0:15:10.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Konohana Hinako.\NAda yang ingin kutanyakan padamu.
Dialogue: 0,0:15:11.41,0:15:13.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Malam ini...
Dialogue: 0,0:15:13.07,0:15:16.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bersediakah kau datang ke rumahku?
Dialogue: 0,0:15:23.13,0:15:24.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah menantikan kalian.
Dialogue: 0,0:15:25.21,0:15:27.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Konohana. Tomonari.
Dialogue: 0,0:15:27.59,0:15:31.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak atas undanganmu.
Dialogue: 0,0:15:31.71,0:15:35.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini pertama kalinya aku menerima\Nundangan secara pribadi.
Dialogue: 0,0:15:35.59,0:15:38.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ada motif tertentu di balik ini?
Dialogue: 0,0:15:38.18,0:15:41.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak ada motif terselubung apa pun.
Dialogue: 0,0:15:41.07,0:15:42.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika harus beralasan...
Dialogue: 0,0:15:42.31,0:15:47.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin mengenalmu lebih dekat,
Dialogue: 0,0:15:47.41,0:15:51.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bukan sebagai putri Tennoji,\Nmelainkan sebagai seorang teman.
Dialogue: 0,0:15:53.23,0:15:56.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga sangat ingin\Njadi lebih akrab denganmu.
Dialogue: 0,0:15:57.23,0:16:01.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}K-Kalau kau bilang terang-terangan begitu,\Naku jadi sedikit malu.
Dialogue: 0,0:16:01.56,0:16:04.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bunga untuk menghiasi kamarmu.
Dialogue: 0,0:16:05.11,0:16:08.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memilih bunga yang menurutku\Npaling melambangkan dirimu.
Dialogue: 0,0:16:08.23,0:16:10.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Wah! Terima kasih banyak.
Dialogue: 0,0:16:15.99,0:16:16.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mirei...
Dialogue: 0,0:16:16.95,0:16:19.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mirei kita sudah makin dewasa, ya!
Dialogue: 0,0:16:20.31,0:16:22.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia memang sudah dewasa, Sayang.
Dialogue: 0,0:16:22.22,0:16:25.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Auranya terlihat lebih bersinar\Ndari biasanya!
Dialogue: 0,0:16:27.92,0:16:33.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat, amat menantikan hari ini.
Dialogue: 0,0:16:33.02,0:16:37.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami akan menghidangkan menu istimewa\Nuntuk jamuan makan malam nanti.
Dialogue: 0,0:16:37.16,0:16:39.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mencurahkan segenap kemampuanku\Nuntuk meracik hidangannya.
Dialogue: 0,0:16:39.64,0:16:41.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tomonari.
Dialogue: 0,0:16:42.47,0:16:43.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sini.
Dialogue: 0,0:16:44.19,0:16:44.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:16:46.60,0:16:49.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, Tuan Masatsugu?
Dialogue: 0,0:16:49.49,0:16:51.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tomonari.
Dialogue: 0,0:16:51.08,0:16:52.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, Itsuki.
Dialogue: 0,0:16:53.07,0:16:55.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah dengar semuanya dari Mirei.
Dialogue: 0,0:16:55.61,0:16:59.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkatmu, dia akhirnya mau\Nmengungkapkan perasaan aslinya.
Dialogue: 0,0:16:59.27,0:17:01.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan begitu...
Dialogue: 0,0:17:01.14,0:17:03.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mirei mendapat teman yang sangat luar biasa.
Dialogue: 0,0:17:03.57,0:17:06.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah kita tak sampai membiarkannya\Nkeluar dari akademi.
Dialogue: 0,0:17:07.91,0:17:09.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, Itsuki...
Dialogue: 0,0:17:09.86,0:17:12.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau tertarik masuk Grup Tennoji?
Dialogue: 0,0:17:12.39,0:17:14.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Ada apa kok tiba-tiba?
Dialogue: 0,0:17:14.72,0:17:17.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin pertanyaanku terlalu bertele-tele.
Dialogue: 0,0:17:17.81,0:17:20.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kuperjelas sekali lagi.
Dialogue: 0,0:17:20.09,0:17:22.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kau berniat menikahi Mirei\Ndan bergabung dengan keluarga kami?!
Dialogue: 0,0:17:22.56,0:17:24.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah? Tunggu, apa?!
Dialogue: 0,0:17:24.66,0:17:28.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelihatannya Mirei mendambakan\Npernikahan yang didasari cinta.
Dialogue: 0,0:17:28.60,0:17:29.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana dengan perasaanmu...
Dialogue: 0,0:17:29.92,0:17:31.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah!
Dialogue: 0,0:17:33.70,0:17:35.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa ini?
Dialogue: 0,0:17:35.69,0:17:37.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksud Ayah bilang begitu?
Dialogue: 0,0:17:37.70,0:17:40.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih cepat kan lebih baik.
Dialogue: 0,0:17:40.07,0:17:43.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika kelak Itsuki menikah\Ndan menjadi bagian dari keluarga kita...
Dialogue: 0,0:17:44.72,0:17:46.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayah terlalu terburu-buru!
Dialogue: 0,0:17:46.99,0:17:48.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masa, sih?
Dialogue: 0,0:17:48.74,0:17:51.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya sudah, kalau maumu begitu, Mirei...
Dialogue: 0,0:17:51.23,0:17:53.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, nanti kita ngobrol lagi, ya, Itsuki.
Dialogue: 0,0:17:54.66,0:17:56.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya ampun!
Dialogue: 0,0:17:56.42,0:17:59.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maafkan kelakuan ayahku, Tomonari...
Dialogue: 0,0:18:03.03,0:18:04.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itsuki.
Dialogue: 0,0:18:04.53,0:18:07.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu itu cuma gurauan,\Ntapi dia benar-benar bikin aku jantungan.
Dialogue: 0,0:18:07.04,0:18:10.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa jadi itu bukan sekadar gurauan, lo.
Dialogue: 0,0:18:10.11,0:18:10.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:18:11.17,0:18:18.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kau itu pria yang paling dekat denganku\Nuntuk saat ini.
Dialogue: 0,0:18:18.10,0:18:22.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, tapi jujur saja,\Naku ini cuma orang awam biasa...
Dialogue: 0,0:18:23.10,0:18:28.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, kau kira orang tuaku\Nterlalu mementingkan status sosial?
Dialogue: 0,0:18:29.27,0:18:34.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seandainya wacana pertunangan denganku\Nbenar-benar terjadi, apa reaksimu?
Dialogue: 0,0:18:34.26,0:18:36.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Reaksiku?
Dialogue: 0,0:18:36.39,0:18:39.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama-tama, aku perlu tahu dulu\Nbagaimana perasaanmu.
Dialogue: 0,0:18:39.99,0:18:44.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu berarti, kau akan menerimanya\Nkalau aku juga setuju, begitu?
Dialogue: 0,0:18:44.30,0:18:45.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eum, itu...
Dialogue: 0,0:18:46.61,0:18:47.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cuma bercanda, kok.
Dialogue: 0,0:18:48.38,0:18:51.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, seandainya hari itu benar-benar tiba...
Dialogue: 0,0:18:53.95,0:18:57.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan pastikan\Nbahwa akulah yang kau pilih.
Dialogue: 0,0:19:21.90,0:19:24.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tennoji sudah berubah, ya.
Dialogue: 0,0:19:24.81,0:19:27.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang auranya terasa lebih lembut.
Dialogue: 0,0:19:27.00,0:19:28.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:19:28.04,0:19:32.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, kau ngapain saja\Nsama Tennoji waktu itu?
Dialogue: 0,0:19:32.39,0:19:33.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Waktu itu?
Dialogue: 0,0:19:34.06,0:19:35.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pas kalian berdua pergi main.
Dialogue: 0,0:19:35.88,0:19:37.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan apa-apa.
Dialogue: 0,0:19:37.30,0:19:43.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami pergi ke tempat arkade,\Nterus main boling, habis itu lanjut karaoke.
Dialogue: 0,0:19:43.18,0:19:45.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelihatannya kalian seru banget.
Dialogue: 0,0:19:45.98,0:19:47.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudku, itu...
Dialogue: 0,0:19:48.34,0:19:51.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bohong kalau aku bilang\Naku tak menikmati waktuku bersamanya, tapi...
Dialogue: 0,0:19:51.58,0:19:53.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga mau pergi.
Dialogue: 0,0:19:53.23,0:19:53.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:19:53.97,0:19:58.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga mau pergi ke tempat-tempat itu!
Dialogue: 0,0:19:58.05,0:19:59.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah! Aku paham!
Dialogue: 0,0:19:59.70,0:20:02.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh! Kakiku! Jangan injak kakiku!
Dialogue: 0,0:20:06.58,0:20:08.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanlah saat kau sudah bangun.
Dialogue: 0,0:20:08.23,0:20:09.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti makananmu tumpah.
Dialogue: 0,0:20:10.60,0:20:13.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Habis ini aku mau yang rasa cokelat.
Dialogue: 0,0:20:13.93,0:20:15.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, iya.
Dialogue: 0,0:20:19.55,0:20:20.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, Hinako...
Dialogue: 0,0:20:21.32,0:20:26.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Brosur kompetisi olahraga yang dibagikan\Ndi kelas kemarin ini...
Dialogue: 0,0:20:26.72,0:20:31.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Katanya kita bisa pilih cabang olahraganya,\Ntapi sistemnya bagaimana, sih?
Dialogue: 0,0:20:31.59,0:20:35.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di SMA lamamu\Ntak ada kompetisi semacam ini, ya?
Dialogue: 0,0:20:35.55,0:20:38.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biasanya tidak sebesar ini skalanya.
Dialogue: 0,0:20:38.18,0:20:41.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lokasinya saja\Nbanyak yang di luar lingkungan akademi,
Dialogue: 0,0:20:41.50,0:20:45.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}terus ada cabang olahraga seperti golf,\Nberkuda, dan seluncur es pula...
Dialogue: 0,0:20:45.94,0:20:49.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itsuki, kau tak perlu cemas berlebihan.
Dialogue: 0,0:20:49.29,0:20:49.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:20:49.94,0:20:53.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kompetisi olahraga takkan\Nmemengaruhi nilaimu,
Dialogue: 0,0:20:53.48,0:20:55.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}makanya banyak murid yang tak niat ikut.
Dialogue: 0,0:20:55.69,0:20:56.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu.
Dialogue: 0,0:20:57.18,0:21:00.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti kau juga cuma bakal\Nmain asal-asalan, 'kan?
Dialogue: 0,0:21:00.49,0:21:04.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inginnya begitu,\Ntapi aku harus jadi juara pertama.
Dialogue: 0,0:21:04.88,0:21:07.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu kemauan Tuan Kagen?
Dialogue: 0,0:21:07.37,0:21:10.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya. Menyebalkan banget...
Dialogue: 0,0:21:11.71,0:21:14.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terkait kompetisi olahraga tiga minggu lagi,
Dialogue: 0,0:21:14.29,0:21:16.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena tenis adalah cabang populer\Nyang banyak peminatnya,
Dialogue: 0,0:21:16.99,0:21:19.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan juaranya akan jadi pusat perhatian,
Dialogue: 0,0:21:19.65,0:21:22.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa Anda tak keberatan\Nikut tenis lagi tahun ini, Nona?
Dialogue: 0,0:21:23.18,0:21:24.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hm...
Dialogue: 0,0:21:24.32,0:21:27.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, pelatih tahun lalu\Nyang rencananya mau kita sewa lagi
Dialogue: 0,0:21:28.12,0:21:31.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}baru saja terkilir beberapa hari lalu,
Dialogue: 0,0:21:31.12,0:21:33.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan meskipun kita sudah berusaha mencari\Npengganti dalam waktu singkat,
Dialogue: 0,0:21:33.54,0:21:37.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita belum menemukan satu pun\Nyang memenuhi standar Tuan Kagen.
Dialogue: 0,0:21:38.11,0:21:39.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti aku boleh absen ikut kompetisi?!
Dialogue: 0,0:21:39.96,0:21:40.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak bisa.
Dialogue: 0,0:21:42.42,0:21:43.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kompetisi ini adalah
Dialogue: 0,0:21:43.71,0:21:46.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ajang pembuktian yang tepat bahwa\NAnda tak hanya unggul di bidang akademis,
Dialogue: 0,0:21:46.97,0:21:48.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi juga punya fisik yang prima.
Dialogue: 0,0:21:48.86,0:21:52.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya mustahil untuk\Nmengubah pendirian Tuan Kagen.
Dialogue: 0,0:21:52.38,0:21:53.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:21:53.78,0:21:59.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, berolahraga itu\Njuga bagus buat kesehatan.
Dialogue: 0,0:21:59.06,0:22:02.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin karena akhir-akhir ini Anda selalu\Nmenikmati makan bersama Tuan Itsuki,
Dialogue: 0,0:22:03.06,0:22:05.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi sepertinya berat badan Anda\Nsedikit naik...
Dialogue: 0,0:22:06.36,0:22:09.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Itsuki, cabang olahraga apa\Nyang akan kau ikuti?
Dialogue: 0,0:22:09.51,0:22:12.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kupikir aku akan pilih\Nyang sama dengan Hinako saja.
Dialogue: 0,0:22:12.30,0:22:15.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti tenis, ya. Baik, akan saya catat.
Dialogue: 0,0:22:15.33,0:22:17.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, Anda juga butuh pelatih, 'kan?
Dialogue: 0,0:22:17.95,0:22:19.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Itsuki...
Dialogue: 0,0:22:20.66,0:22:23.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa menurutmu penampilanku\Nbelakangan ini berubah?
Dialogue: 0,0:22:23.62,0:22:24.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berubah apanya?
Dialogue: 0,0:22:24.98,0:22:28.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa badanku jadi kelihatan lebih bulat?
Dialogue: 0,0:22:30.51,0:22:31.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kau menyinggungnya...
Dialogue: 0,0:22:33.76,0:22:36.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku harus sabet juara pertama...
Dialogue: 0,0:22:38.87,0:22:41.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan buktikan\Nkalau aku bisa merebut juara pertama!
Dialogue: 0,0:22:42.58,0:22:44.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Y-Ya!
Dialogue: 0,0:22:47.54,0:22:50.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Itsuki!
Dialogue: 0,0:22:51.85,0:22:55.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Narika. Ada apa kok panik begitu?
Dialogue: 0,0:22:55.22,0:22:56.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong aku, Itsuki!
Dialogue: 0,0:22:56.40,0:22:58.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bantu aku!
Dialogue: 0,0:22:58.07,0:22:59.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa, Narika?
Dialogue: 0,0:22:59.50,0:23:01.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ko-Kompetisi olahraganya...
Dialogue: 0,0:23:02.92,0:23:05.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ketakutan!
