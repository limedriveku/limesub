Dialogue: 0,0:01:50.80,0:02:02.35,sign,,0000,0000,0000,,THE FORSAKEN SAINTESS\NAND HER FOODIE ROADTRIP IN ANOTHER WORLD
Dialogue: 0,0:03:02.95,0:03:03.95,sign,,0000,0000,0000,,EPISODE 6: BELUT LAUT MEMANG ENAK,\NTAPI AKU JUGA SUKA BELUT AIR TAWAR!
Dialogue: 0,0:07:21.17,0:07:21.84,sign,,0000,0000,0000,,BELUT BADAI - BISA DIMAKAN: SANGAT LEZAT
Dialogue: 0,0:08:27.24,0:08:30.20,sign,,0000,0000,0000,,INDRA PENCIUMAN TAJAM
Dialogue: 0,0:14:10.66,0:14:13.42,sign,,0000,0000,0000,,GOMAMITSU, GOMAMISO
Dialogue: 0,0:14:13.42,0:14:15.04,sign,,0000,0000,0000,,GOMAMISO
Dialogue: 0,0:23:34.93,0:23:39.23,sign,,0000,0000,0000,,EPISODE 7: MOCHI DANGO DI PINGGANGMU ITU,\NAKU BOLEH MINTA SEMUANYA?
Dialogue: 0,0:00:05.59,0:00:07.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di dalam sangat sunyi.
Dialogue: 0,0:00:07.45,0:00:09.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gelap dan tidak ada apa pun.
Dialogue: 0,0:00:09.57,0:00:12.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Juga tidak ada yang tahu\Nfungsi bangunan ini.
Dialogue: 0,0:00:12.03,0:00:14.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya sangat janggal, ya?
Dialogue: 0,0:00:14.99,0:00:17.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rin, kamu takut?
Dialogue: 0,0:00:17.04,0:00:19.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak takut!
Dialogue: 0,0:00:19.46,0:00:20.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serius?
Dialogue: 0,0:00:20.58,0:00:21.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:00:21.45,0:00:24.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena tatapan Ed lebih menakutkan.
Dialogue: 0,0:00:24.71,0:00:27.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau terjadi sesuatu,\Nlangsung bilang padaku, ya.
Dialogue: 0,0:00:27.51,0:00:29.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:00:29.01,0:00:30.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga mau dielus!
Dialogue: 0,0:00:32.47,0:00:34.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Goma, kamu lucu.
Dialogue: 0,0:00:35.54,0:00:39.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Miso terlalu santai, ya.
Dialogue: 0,0:00:39.14,0:00:41.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, tidak ada satu pun monster terlihat.
Dialogue: 0,0:00:41.67,0:00:43.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini memang terasa janggal.
Dialogue: 0,0:00:43.82,0:00:46.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bangunan ini juga terkesan sangat penting.
Dialogue: 0,0:00:46.82,0:00:48.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dilihat dari arsitekturnya,
Dialogue: 0,0:00:48.70,0:00:51.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tempat ini mirip Kuil Hephaestus kuno.
Dialogue: 0,0:00:51.16,0:00:53.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senon, wawasanmu luas sekali!
Dialogue: 0,0:00:53.62,0:00:55.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami ras berumur panjang.
Dialogue: 0,0:00:55.33,0:00:58.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi cukup mendalami\Nlegenda kuno seperti ini.
Dialogue: 0,0:00:58.50,0:01:01.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pilar yang bagian tengahnya\Nagak menggembung ini
Dialogue: 0,0:01:01.04,0:01:03.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah ciri khas arsitektur era tersebut.
Dialogue: 0,0:01:04.03,0:01:06.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagian tengahnya memang lebih menggembung.
Dialogue: 0,0:01:06.09,0:01:07.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sana...
Dialogue: 0,0:01:07.63,0:01:09.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada pintu.
Dialogue: 0,0:01:15.58,0:01:17.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya tidak ada jebakan.
Dialogue: 0,0:01:17.68,0:01:20.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, ayo kita masuk.
Dialogue: 0,0:01:30.99,0:01:32.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, luas sekali!
Dialogue: 0,0:03:03.95,0:03:07.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski benar tidak ada jebakan\Nseperti yang Aria bilang...
Dialogue: 0,0:03:07.33,0:03:10.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya tidak ada petunjuk\Nmenuju lantai berikutnya.
Dialogue: 0,0:03:11.70,0:03:15.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempat ini... sebenarnya ruangan apa?
Dialogue: 0,0:03:15.72,0:03:19.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di depan kami terbentang kolam hias\Ndari pepohonan putih dan marmer.
Dialogue: 0,0:03:19.79,0:03:22.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ingin dapat informasi lebih lanjut,
Dialogue: 0,0:03:22.22,0:03:24.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lakukan pemeriksaan dan penilaian...
Dialogue: 0,0:03:25.23,0:03:27.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat, aku malah halu.
Dialogue: 0,0:03:27.23,0:03:31.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan di tempat begini pun\Nbisa terpengaruh gim cerita.
Dialogue: 0,0:03:31.90,0:03:34.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, dilihat dari situasinya,
Dialogue: 0,0:03:34.24,0:03:37.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin kami memang\Nharus mengatasi teka-teki ini.
Dialogue: 0,0:03:38.06,0:03:40.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya ada tulisan di dalam kolam itu.
Dialogue: 0,0:03:41.66,0:03:43.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pohon raksasa?
Dialogue: 0,0:03:43.45,0:03:47.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini terbuat dari marmer!\NPantas terlihat indah.
Dialogue: 0,0:03:47.04,0:03:49.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Survival juga belum bereaksi.
Dialogue: 0,0:03:49.75,0:03:51.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga mau lihat-lihat!
Dialogue: 0,0:03:51.46,0:03:52.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Miso!
Dialogue: 0,0:03:53.20,0:03:55.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar kucing.
Dialogue: 0,0:03:57.76,0:03:59.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei!
Dialogue: 0,0:03:59.39,0:04:01.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lubang ini untuk apa?
Dialogue: 0,0:04:03.60,0:04:06.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daripada disebut lubang,\Nlebih mirip lekukan.
Dialogue: 0,0:04:06.23,0:04:09.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pohon ini terbentuk dari dua\Nbatang pohon yang menyatu.
Dialogue: 0,0:04:09.06,0:04:12.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa di sisi lain ada lekukan\Nyang sama juga?
Dialogue: 0,0:04:12.19,0:04:16.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ukiran di dinding itu menampilkan\Nberbagai jenis hewan.
Dialogue: 0,0:04:16.74,0:04:19.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada makhluk yang belum dikenal juga.
Dialogue: 0,0:04:19.02,0:04:22.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya tidak terlihat\Nada ruangan tersembunyi juga.
Dialogue: 0,0:04:22.24,0:04:24.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tulisan yang terukir di sini mengutip
Dialogue: 0,0:04:24.20,0:04:27.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tentang sumpah untuk melanjutkan\Ntakdir cinta di kehidupan berikutnya.
Dialogue: 0,0:04:27.62,0:04:32.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di dekat cabang pohon ada lekukan\Nuntuk meletakkan sesuatu.
Dialogue: 0,0:04:32.11,0:04:35.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku tidak tahu harus meletakkan apa.
Dialogue: 0,0:04:37.01,0:04:38.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita buntu, ya?
Dialogue: 0,0:04:38.59,0:04:41.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah sejauh ini,\Nkita belum menemukan apa pun.
Dialogue: 0,0:04:42.37,0:04:45.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Naluri bermain gim ceritaku memberitahuku.
Dialogue: 0,0:04:45.99,0:04:50.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin kita harus meletakkan\Nsesuatu ke dalam lekukan itu.
Dialogue: 0,0:04:50.00,0:04:52.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ukiran berbentuk hewan...
Dialogue: 0,0:04:52.48,0:04:55.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Puisi sumpah cinta tentang melanjutkan\Ntakdirnya di kehidupan berikutnya...
Dialogue: 0,0:04:56.19,0:04:58.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu pohon kembar yang saling bertautan.
Dialogue: 0,0:05:00.01,0:05:01.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rin, ada apa?
Dialogue: 0,0:05:01.20,0:05:02.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mukamu terlihat serius.
Dialogue: 0,0:05:02.81,0:05:06.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pikiranku terasa aneh dan penasaran.
Dialogue: 0,0:05:07.31,0:05:08.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Materi jurusan?
Dialogue: 0,0:05:08.60,0:05:11.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, itu ujian hafalan\Nsastra Tiongkok kuno saat SMA.
Dialogue: 0,0:05:11.44,0:05:13.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Puisi "Lagu Penyesalan Abadi" karya Bai Juyi?
Dialogue: 0,0:05:16.03,0:05:17.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu baik-baik saja?
Dialogue: 0,0:05:18.03,0:05:22.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}"Jika di langit, kuingin jadi sepasang burung\Nyang terbang bersama.
Dialogue: 0,0:05:22.19,0:05:25.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jika di bumi, kuingin jadi dahan pohon\Nyang saling bertautan."
Dialogue: 0,0:05:25.96,0:05:27.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau petunjuknya memang ada...
Dialogue: 0,0:05:28.46,0:05:30.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin dari ukiran burung!
Dialogue: 0,0:05:30.56,0:05:33.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu pun ukiran yang sayapnya cuma satu!
Dialogue: 0,0:05:37.09,0:05:40.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa petunjuk "dahan pohon\Nyang bertautan" langsung membantu?
Dialogue: 0,0:05:40.93,0:05:44.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, ini pengetahuan\Ndari dunia asalku.
Dialogue: 0,0:05:45.45,0:05:46.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketemu!
Dialogue: 0,0:05:46.45,0:05:47.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ketemu, Ville!
Dialogue: 0,0:05:47.91,0:05:49.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini burung yang cuma punya sayap kanan!
Dialogue: 0,0:05:49.95,0:05:53.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sini aku juga menemukan ukiran burung\Nyang cuma punya sayap kiri.
Dialogue: 0,0:05:53.92,0:05:55.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya, kita harus bagaimana?
Dialogue: 0,0:05:56.69,0:05:58.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba kupikir dulu.
Dialogue: 0,0:05:58.13,0:06:01.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena tidak ada jebakan,\Napa sebaiknya kita tekan saja?
Dialogue: 0,0:06:01.22,0:06:02.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kubantu.
Dialogue: 0,0:06:02.59,0:06:04.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak, Senon.
Dialogue: 0,0:06:04.93,0:06:07.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau gagal, maafkan aku.
Dialogue: 0,0:06:07.05,0:06:08.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.
Dialogue: 0,0:06:08.47,0:06:12.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat memecahkan mekanisme,\Nmencoba dan gagal itu harus.
Dialogue: 0,0:06:15.15,0:06:16.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serius, nih?
Dialogue: 0,0:06:21.32,0:06:23.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus, Rin.
Dialogue: 0,0:06:23.28,0:06:25.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya tebakanmu benar.
Dialogue: 0,0:06:25.56,0:06:29.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serius?\NSiapa sangka tebakanku benar.
Dialogue: 0,0:06:31.73,0:06:34.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Miso, dari tadi kamu di sini?
Dialogue: 0,0:06:34.04,0:06:36.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, aku dari tadi mengawasi di sini.
Dialogue: 0,0:06:36.58,0:06:38.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:06:41.92,0:06:44.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya, tinggal memasukkan ini.
Dialogue: 0,0:06:44.30,0:06:45.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berat.
Dialogue: 0,0:06:45.80,0:06:47.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti yang kamu duga,
Dialogue: 0,0:06:47.37,0:06:49.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di sisi lain juga ada lekukan\Ndan sekalian kutaruh.
Dialogue: 0,0:06:49.97,0:06:51.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biar kutaruh juga yang di sini.
Dialogue: 0,0:06:51.47,0:06:53.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, maaf merepotkan.
Dialogue: 0,0:07:03.18,0:07:04.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari mana air ini muncul?
Dialogue: 0,0:07:04.72,0:07:07.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi pohon ini juga bagian dari mekanisme?
Dialogue: 0,0:07:19.03,0:07:21.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu?
Dialogue: 0,0:07:21.84,0:07:23.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belut Badai?
Dialogue: 0,0:07:23.57,0:07:25.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa? Serius?
Dialogue: 0,0:07:25.63,0:07:29.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia monster pengendali cuaca\Nyang bisa memanggil badai dan petir.
Dialogue: 0,0:07:29.80,0:07:32.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak kusangka monster seperti ini\Nbenar-benar ada.
Dialogue: 0,0:07:34.81,0:07:36.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita tidak tahu dari mana asalnya.
Dialogue: 0,0:07:36.94,0:07:38.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana cara mengalahkannya?
Dialogue: 0,0:07:41.09,0:07:41.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di atas?
Dialogue: 0,0:07:43.23,0:07:44.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hati-hati!
Dialogue: 0,0:07:48.11,0:07:49.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya baik-baik saja?
Dialogue: 0,0:07:49.37,0:07:50.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:07:50.78,0:07:52.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini merepotkan.
Dialogue: 0,0:07:52.24,0:07:55.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa tidak ada petunjuk mengalahkannya?
Dialogue: 0,0:07:55.33,0:07:57.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada kata "belut" di namanya,\Nberarti benaran belut, kan?
Dialogue: 0,0:07:58.54,0:07:59.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belut?
Dialogue: 0,0:07:59.46,0:08:03.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau menyerangnya dengan sihir es,\Nkita bisa memperlambat gerakannya.
Dialogue: 0,0:08:03.76,0:08:04.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir es?
Dialogue: 0,0:08:04.92,0:08:08.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di dunia asalku juga ada makhluk serupa.
Dialogue: 0,0:08:08.49,0:08:12.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Biasanya kami membatasi gerakannya\Ndengan es lalu mengolahnya.
Dialogue: 0,0:08:12.39,0:08:13.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu.
Dialogue: 0,0:08:13.50,0:08:16.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, di kondisi seperti ini,\Nsihir sulit mengenainya!
Dialogue: 0,0:08:16.18,0:08:18.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia langsung sembunyi ke dalam air.
Dialogue: 0,0:08:18.44,0:08:19.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bisa tahu lokasinya,
Dialogue: 0,0:08:19.73,0:08:22.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita bisa memisahkan ruang sekitarnya\Ndan menangkapnya.
Dialogue: 0,0:08:22.80,0:08:24.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau menggiringnya\Nke suatu tempat?
Dialogue: 0,0:08:24.90,0:08:26.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menggiringnya?
Dialogue: 0,0:08:27.24,0:08:30.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Survival bilang hidungnya sangat peka.
Dialogue: 0,0:08:30.20,0:08:31.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aria.
Dialogue: 0,0:08:31.24,0:08:33.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Bisa gendong Gomamiso sebentar?\N- Tidak mau!
Dialogue: 0,0:08:33.58,0:08:36.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Jangan tinggalkan aku di sini!\N- Tapi Goma keberatan.
Dialogue: 0,0:08:36.03,0:08:37.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku segera kembali.
Dialogue: 0,0:08:37.71,0:08:39.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mo.
Dialogue: 0,0:08:44.88,0:08:45.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ed!
Dialogue: 0,0:08:45.71,0:08:47.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan melempar umpan!
Dialogue: 0,0:08:47.42,0:08:49.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong tangkap dia dengan sihir!
Dialogue: 0,0:08:49.30,0:08:51.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cumi Suruika Asin ini
Dialogue: 0,0:08:51.43,0:08:54.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}awalnya ingin kujadikan camilan untuk sake.
Dialogue: 0,0:08:56.22,0:08:58.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lempar!
Dialogue: 0,0:09:00.77,0:09:02.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih, Rin.
Dialogue: 0,0:09:03.02,0:09:04.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita jadi bisa menangkapnya!
Dialogue: 0,0:09:07.99,0:09:08.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhasil.
Dialogue: 0,0:09:08.82,0:09:10.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ed, lepaskan kurungannya.
Dialogue: 0,0:09:23.17,0:09:24.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ville!
Dialogue: 0,0:09:24.71,0:09:26.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rin, bahaya!\NJangan ke sana.
Dialogue: 0,0:09:26.42,0:09:28.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, Ville butuh bantuan!
Dialogue: 0,0:09:28.21,0:09:32.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan cemas, kalau kamu ke garis depan,\Nitu lebih berbahaya.
Dialogue: 0,0:09:32.09,0:09:34.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ville itu kuat.
Dialogue: 0,0:09:34.30,0:09:36.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski terlilit, dia akan baik-baik saja.
Dialogue: 0,0:09:41.23,0:09:42.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ville...
Dialogue: 0,0:09:42.23,0:09:43.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus.
Dialogue: 0,0:09:43.48,0:09:44.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu terluka?
Dialogue: 0,0:09:44.96,0:09:45.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sedikit.
Dialogue: 0,0:09:45.98,0:09:49.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak kusangka tubuhnya sangat berlendir.
Dialogue: 0,0:09:53.41,0:09:55.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu baik-baik saja, Rin?
Dialogue: 0,0:09:55.28,0:09:57.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kumohon, jangan bertindak gegabah.
Dialogue: 0,0:09:57.95,0:10:00.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu juga sama.
Dialogue: 0,0:10:00.91,0:10:02.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku takut kamu nyaris mati…
Dialogue: 0,0:10:02.71,0:10:04.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baunya asinnya menyengat!
Dialogue: 0,0:10:05.57,0:10:07.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maaf.
Dialogue: 0,0:10:07.50,0:10:08.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah...
Dialogue: 0,0:10:08.25,0:10:10.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita semua jadi kotor.
Dialogue: 0,0:10:18.18,0:10:19.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar bodoh!
Dialogue: 0,0:10:21.85,0:10:23.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beraninya...
Dialogue: 0,0:10:23.06,0:10:25.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beraninya kamu meninggalkanku.\NDasar bodoh!
Dialogue: 0,0:10:25.27,0:10:27.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dadaku sakit...
Dialogue: 0,0:10:31.15,0:10:34.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daging Belut Badai.\NKita dapat belut!
Dialogue: 0,0:10:34.78,0:10:37.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jiwa Jepang-ku langsung kegirangan!
Dialogue: 0,0:10:37.70,0:10:41.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sepertinya pintu masuk\Nmenuju lantai berikutnya.
Dialogue: 0,0:10:41.70,0:10:43.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih ada lantai berikutnya, ya?
Dialogue: 0,0:10:45.71,0:10:47.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, ayo kita pergi, Rin.
Dialogue: 0,0:10:47.67,0:10:48.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:10:48.81,0:10:50.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Miso.
Dialogue: 0,0:10:52.01,0:10:53.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Miso, kamu kenapa?
Dialogue: 0,0:10:53.62,0:10:54.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami akan meninggalkanmu.
Dialogue: 0,0:10:55.85,0:10:59.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sekarang ingat...
Dialogue: 0,0:11:04.00,0:11:07.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penampilan luar bangunan ini\Nsangat berbeda dengan ukuran aslinya, ya?
Dialogue: 0,0:11:08.40,0:11:10.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dungeon memang di luar nalar.
Dialogue: 0,0:11:10.81,0:11:13.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak merasakan ada aura apa pun.
Dialogue: 0,0:11:13.59,0:11:15.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak ada reaksi apa pun.
Dialogue: 0,0:11:15.24,0:11:18.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.\NSurvival juga tak bereaksi.
Dialogue: 0,0:11:20.58,0:11:22.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Goma?
Dialogue: 0,0:11:27.92,0:11:31.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ja-Jangan-jangan, ini inti dungeon?
Dialogue: 0,0:11:31.27,0:11:33.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tahu, Ville?
Dialogue: 0,0:11:33.30,0:11:35.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu fondasi dungeon.
Dialogue: 0,0:11:35.03,0:11:37.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanpa inti, dungeon tak bisa terbentuk.
Dialogue: 0,0:11:37.93,0:11:40.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa benda seperti ini\Nbisa tiba-tiba muncul?
Dialogue: 0,0:11:40.51,0:11:41.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengar, ya!
Dialogue: 0,0:11:41.51,0:11:43.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dulu aku hanya tersesat.
Dialogue: 0,0:11:43.60,0:11:46.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, ini rumahku!
Dialogue: 0,0:11:46.23,0:11:48.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini suara Gomamiso!
Dialogue: 0,0:11:48.46,0:11:49.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:11:49.34,0:11:52.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, aku sudah ingat semuanya.
Dialogue: 0,0:11:52.08,0:11:57.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tugasku adalah melindungi benda ini!
Dialogue: 0,0:12:03.66,0:12:05.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi begitu.
Dialogue: 0,0:12:06.48,0:12:07.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti...
Dialogue: 0,0:12:07.77,0:12:09.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gomamiso musuh kita?
Dialogue: 0,0:12:09.63,0:12:11.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlebih, dia Bos di sini?
Dialogue: 0,0:12:16.99,0:12:19.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pantas saja dia terlihat santai.
Dialogue: 0,0:12:21.14,0:12:24.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Kenapa kamu mengarahkan senjata padaku?
Dialogue: 0,0:12:24.52,0:12:26.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu musuh,\Nkami terpaksa harus melawanmu!
Dialogue: 0,0:12:27.94,0:12:29.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa pilihan kami harus mengalahkannya?
Dialogue: 0,0:12:41.32,0:12:42.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku...
Dialogue: 0,0:12:42.32,0:12:45.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah bukan yang dulu\Ndan sekarang namaku Gomamiso.
Dialogue: 0,0:12:45.45,0:12:48.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi aku tidak perlu lagi\Nmelindungi benda ini!
Dialogue: 0,0:12:57.09,0:13:00.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena sudah menjadi Gomamiso,
Dialogue: 0,0:13:00.01,0:13:01.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku bisa pergi dari sini!
Dialogue: 0,0:13:01.55,0:13:03.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan ikut bersama kalian!
Dialogue: 0,0:13:04.64,0:13:06.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oi, serius?
Dialogue: 0,0:13:06.64,0:13:09.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Artinya kita sudah menaklukkan dungeon ini?
Dialogue: 0,0:13:09.39,0:13:11.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Inti dungeon-nya sudah hancur.
Dialogue: 0,0:13:11.56,0:13:14.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Tu-Tunggu, ini terlalu aneh!\N- Peluk, aku mau dipeluk!
Dialogue: 0,0:13:16.01,0:13:17.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu pintu keluarnya?
Dialogue: 0,0:13:17.48,0:13:20.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat masuk!\NKita bisa tertimpa reruntuhan!
Dialogue: 0,0:13:20.20,0:13:21.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rin, ayo.
Dialogue: 0,0:13:21.51,0:13:22.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baik.
Dialogue: 0,0:13:31.83,0:13:33.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku benci disuntik!
Dialogue: 0,0:13:33.33,0:13:35.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan disuntik, kamu hanya dicap.
Dialogue: 0,0:13:35.29,0:13:38.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rin, kamu paham bahasa binatang buas?
Dialogue: 0,0:13:40.63,0:13:44.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rin, kamu mungkin bisa menjadi tamer hebat.
Dialogue: 0,0:13:44.60,0:13:46.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk sementara,
Dialogue: 0,0:13:46.06,0:13:49.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku masih ingin menjadi porter\Ndan koki saja.
Dialogue: 0,0:13:49.81,0:13:51.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon bantuannya.
Dialogue: 0,0:13:51.23,0:13:52.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:13:59.89,0:14:02.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah membawa Rin kemari.
Dialogue: 0,0:14:02.11,0:14:03.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, Nona, ya?
Dialogue: 0,0:14:04.39,0:14:06.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menjinakkan bos dungeon,
Dialogue: 0,0:14:06.41,0:14:08.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu lagi-lagi melakukan hal\Nyang di luar dugaan.
Dialogue: 0,0:14:08.87,0:14:10.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski kamu bilang begitu...
Dialogue: 0,0:14:10.66,0:14:13.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awalnya aku hanya merasa dia mirip kucingku
Dialogue: 0,0:14:13.42,0:14:15.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan tak sengaja memberinya nama.
Dialogue: 0,0:14:15.04,0:14:18.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bilang ingin ikut bersama kami\Ndan menghancurkan inti dungeon-nya sendiri.
Dialogue: 0,0:14:18.55,0:14:21.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan aku pun merasa\Nsemua ini sangat tidak masuk akal.
Dialogue: 0,0:14:21.38,0:14:23.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana aku harus menulis laporannya?
Dialogue: 0,0:14:23.97,0:14:26.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini situasi yang belum pernah\Nterjadi sebelumnya.
Dialogue: 0,0:14:27.30,0:14:32.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma memberimu makan\Ndan berujung lengket padaku.
Dialogue: 0,0:14:32.20,0:14:34.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya aromamu enak.
Dialogue: 0,0:14:34.69,0:14:36.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aromanya enak?\NAku?
Dialogue: 0,0:14:36.56,0:14:38.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, ada aroma yang lembut.
Dialogue: 0,0:14:38.94,0:14:40.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Be-Begitu, ya?
Dialogue: 0,0:14:40.91,0:14:43.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka betulan bisa berkomunikasi.
Dialogue: 0,0:14:43.28,0:14:46.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang kudengar hanya suara mengeong saja.
Dialogue: 0,0:14:46.45,0:14:48.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tenang saja, Tori.
Dialogue: 0,0:14:48.27,0:14:50.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga hanya mendengarnya mengeong.
Dialogue: 0,0:14:50.66,0:14:53.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, kamu sudah tidak bisa\Nmendengarnya lagi?
Dialogue: 0,0:14:53.21,0:14:53.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:14:53.75,0:14:57.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya waktu itu\Nkarena inti dungeon ada di dekat kita,
Dialogue: 0,0:14:57.92,0:15:01.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan kita bisa paham\Napa yang dikatakan Gomamiso.
Dialogue: 0,0:15:01.00,0:15:03.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, tadi dia bilang apa?
Dialogue: 0,0:15:03.72,0:15:07.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bilang suka padaku\Nkarena aku punya aroma yang enak.
Dialogue: 0,0:15:07.68,0:15:10.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan ada bau aneh di tubuhku?
Dialogue: 0,0:15:11.64,0:15:13.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya aku bisa memahami maksudnya.
Dialogue: 0,0:15:14.43,0:15:16.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan.\NMungkin ini terdengar agak aneh.
Dialogue: 0,0:15:16.52,0:15:18.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kurasa ini mungkin aroma jiwamu
Dialogue: 0,0:15:18.44,0:15:20.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau semacam karakteristik gelombang mana
Dialogue: 0,0:15:20.65,0:15:23.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang selaras dengannya?
Dialogue: 0,0:15:24.93,0:15:29.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Artinya kami sangat cocok atau serasi?
Dialogue: 0,0:15:29.45,0:15:31.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kira-kira seperti itu.
Dialogue: 0,0:15:31.45,0:15:35.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Singkatnya, seperti belahan jiwa, ya?
Dialogue: 0,0:15:35.35,0:15:39.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, aku tidak boleh\Nmeninggalkan bola itu.
Dialogue: 0,0:15:39.33,0:15:41.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah itu hal yang wajar?
Dialogue: 0,0:15:41.13,0:15:44.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belum pernah dengar ada bos\Nyang menelantarkan tugasnya
Dialogue: 0,0:15:44.21,0:15:46.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}menjaga inti dungeon\Nlalu pergi bersenang-senang.
Dialogue: 0,0:15:47.79,0:15:50.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin pergi bertualang.
Dialogue: 0,0:15:50.68,0:15:54.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku lapar.
Dialogue: 0,0:15:54.10,0:15:57.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah Rin memberiku makan,\Ntenagaku pulih kembali.
Dialogue: 0,0:15:57.52,0:15:59.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia sebenarnya keras kepala,
Dialogue: 0,0:15:59.69,0:16:01.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku tak bisa membencinya.
Dialogue: 0,0:16:05.11,0:16:07.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bulunya lembut dan halus!
Dialogue: 0,0:16:08.39,0:16:11.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi ini sudah di luar wewenangku\Nsebagai ketua serikat kecil.
Dialogue: 0,0:16:11.91,0:16:13.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soal hal itu.
Dialogue: 0,0:16:13.91,0:16:17.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena sudah telanjur,\Nini juga menyangkut situasi Rin.
Dialogue: 0,0:16:17.12,0:16:21.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin kembali ke ibu kota\Nuntuk minta pendapat orang itu.
Dialogue: 0,0:16:21.74,0:16:22.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu serius?
Dialogue: 0,0:16:22.99,0:16:25.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, sekarang bukan saatnya untuk gengsi.
Dialogue: 0,0:16:26.28,0:16:28.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau itu saranmu,
Dialogue: 0,0:16:28.11,0:16:30.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin ini cara yang paling aman.
Dialogue: 0,0:16:30.13,0:16:33.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, kamu punya kenalan di ibu kota?
Dialogue: 0,0:16:34.71,0:16:35.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya…
Dialogue: 0,0:16:35.68,0:16:37.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku punya kakak.
Dialogue: 0,0:16:37.48,0:16:38.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakak?
Dialogue: 0,0:16:38.81,0:16:40.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:16:41.13,0:16:42.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami beda ibu.
Dialogue: 0,0:16:46.22,0:16:49.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa hubunganmu\Ndengan kakakmu tidak baik?
Dialogue: 0,0:16:49.11,0:16:52.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, hubungan kami\Nseharusnya lumayan baik.
Dialogue: 0,0:16:52.41,0:16:54.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakakku orang yang sangat dewasa.
Dialogue: 0,0:16:54.99,0:16:56.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat aku masih bocah nakal,
Dialogue: 0,0:16:56.90,0:16:58.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia tetap baik padaku.
Dialogue: 0,0:16:58.54,0:17:01.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya dia kakak yang baik, ya.
Dialogue: 0,0:17:01.13,0:17:04.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah itu,\Nkakakku terpilih sebagai pewaris.
Dialogue: 0,0:17:04.25,0:17:07.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi masih banyak orang yang ingin\Nmendukungku menjadi pewaris.
Dialogue: 0,0:17:07.28,0:17:08.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mendukungmu?
Dialogue: 0,0:17:08.97,0:17:10.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu putra kedua, kan?
Dialogue: 0,0:17:10.51,0:17:11.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:17:11.30,0:17:13.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku tahu alasannya.
Dialogue: 0,0:17:13.05,0:17:14.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena aku anak sah.
Dialogue: 0,0:17:14.39,0:17:16.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sementara kakakku lahir\Ndari wanita simpanan.
Dialogue: 0,0:17:17.59,0:17:20.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada akhirnya, aku tak tahan\Ndengan semua kerumitan itu,
Dialogue: 0,0:17:20.09,0:17:22.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu memutuskan pergi dari rumah.
Dialogue: 0,0:17:22.58,0:17:25.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai sekarang, aku tak tahu\Nharus bagaimana menghadapinya.
Dialogue: 0,0:17:26.85,0:17:28.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak berniat memaksamu.
Dialogue: 0,0:17:28.79,0:17:31.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.\NAku sadar tak harus bilang begitu.
Dialogue: 0,0:17:31.32,0:17:34.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau bukan karena situasi ini,\Nmungkin aku tak akan pulang.
Dialogue: 0,0:17:34.28,0:17:36.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, ini saranku sendiri.
Dialogue: 0,0:17:37.06,0:17:38.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rin.
Dialogue: 0,0:17:38.37,0:17:40.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebelum pergi ke ibu kota,
Dialogue: 0,0:17:40.04,0:17:42.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku ingin menjelaskan situasimu\Npada semuanya.
Dialogue: 0,0:17:43.88,0:17:45.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja!
Dialogue: 0,0:17:48.13,0:17:49.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana menjelaskannya, ya?
Dialogue: 0,0:17:49.38,0:17:51.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rin juga sudah susah payah.
Dialogue: 0,0:17:51.84,0:17:54.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak diperas di negara itu\Njuga sudah untung.
Dialogue: 0,0:17:54.51,0:18:00.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku malah senang mereka salah paham\Nmengira Rin tidak berguna.
Dialogue: 0,0:18:00.73,0:18:02.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi bagi Rin, ini seperti nasib sial, kan?
Dialogue: 0,0:18:02.94,0:18:04.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah berjuang keras.
Dialogue: 0,0:18:06.15,0:18:08.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, Gadis Suci, ya?
Dialogue: 0,0:18:08.16,0:18:10.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di catatan sejarah memang tercatat bahwa
Dialogue: 0,0:18:10.03,0:18:12.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}suatu negara pernah memanggil\NGadis Suci dari dunia lain.
Dialogue: 0,0:18:12.61,0:18:15.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kemudian dia membasmi\Nsemua monster dengan kekuatan suci
Dialogue: 0,0:18:15.20,0:18:19.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk memulihkan kedamaian dunia\Ndan menciptakan era kemakmuran.
Dialogue: 0,0:18:19.58,0:18:23.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang para monster juga\Nsedang membuat kekacauan.
Dialogue: 0,0:18:23.01,0:18:26.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin itu alasan mereka bergantung\Npada pemanggilan Gadis Suci kuno?
Dialogue: 0,0:18:26.54,0:18:29.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bergantung pada Gadis Suci?
Dialogue: 0,0:18:29.09,0:18:30.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rin, ada apa?
Dialogue: 0,0:18:30.38,0:18:31.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:18:32.34,0:18:34.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Urutannya terbalik.
Dialogue: 0,0:18:34.05,0:18:35.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kekacauan monster belum terjadi!
Dialogue: 0,0:18:35.43,0:18:37.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka memanggil Gadis Suci duluan!
Dialogue: 0,0:18:37.76,0:18:39.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serangkaian kekacauan ini,
Dialogue: 0,0:18:39.77,0:18:44.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bukankah lebih logis kalau semua ini dipicu
Dialogue: 0,0:18:44.27,0:18:46.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}karena pemanggilan Gadis Suci?
Dialogue: 0,0:18:46.06,0:18:47.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu bilang?
Dialogue: 0,0:18:47.81,0:18:49.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dipikir-pikir, itu benar.
Dialogue: 0,0:18:49.80,0:18:52.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Para monster aneh itu
Dialogue: 0,0:18:52.00,0:18:54.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}juga mulai muncul setelah Rin dipanggil.
Dialogue: 0,0:18:54.73,0:18:57.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya apa yang terjadi?
Dialogue: 0,0:19:00.12,0:19:03.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, aku lapar!
Dialogue: 0,0:19:03.12,0:19:06.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami sedang membahas hal serius\Ndan itu yang kamu pikirkan?
Dialogue: 0,0:19:06.12,0:19:08.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Miso, coba peka sedikit.
Dialogue: 0,0:19:08.71,0:19:11.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Udara itu untuk dihirup!
Dialogue: 0,0:19:11.42,0:19:13.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malah pintar cari alasan!
Dialogue: 0,0:19:14.01,0:19:16.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya aku ingin segera\Nmenyelidiki masalah ini.
Dialogue: 0,0:19:16.47,0:19:17.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi sekarang,
Dialogue: 0,0:19:17.62,0:19:19.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita perlu istirahat dulu.
Dialogue: 0,0:19:19.35,0:19:20.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:19:20.36,0:19:21.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku lapar.
Dialogue: 0,0:19:21.68,0:19:23.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:19:25.35,0:19:28.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi ini skill kotak besar\Nyang sering mereka bahas, ya?
Dialogue: 0,0:19:28.40,0:19:32.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata bisa bergerak cepat,\Nbahkan bisa tinggal di dalamnya!
Dialogue: 0,0:19:32.69,0:19:35.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pantas saja tidak boleh\Nsembarangan diungkapkan.
Dialogue: 0,0:19:35.07,0:19:36.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitulah ceritanya.
Dialogue: 0,0:19:36.57,0:19:38.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga banyak dibantu kalian berdua.
Dialogue: 0,0:19:39.06,0:19:41.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sate daging orc!
Dialogue: 0,0:19:42.79,0:19:44.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Nona.
Dialogue: 0,0:19:44.37,0:19:46.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sampai membuatmu mentraktir kami makan.
Dialogue: 0,0:19:46.50,0:19:48.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku selalu ingin mencoba masakan Rin!
Dialogue: 0,0:19:48.58,0:19:49.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senangnya.
Dialogue: 0,0:19:49.71,0:19:52.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah aku bisa membalas budi pada kalian!
Dialogue: 0,0:19:52.38,0:19:55.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belut Badainya juga sebentar lagi matang.
Dialogue: 0,0:19:55.22,0:19:58.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belut Badai?\NBagaimana cara memakannya?
Dialogue: 0,0:19:59.66,0:20:02.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja, siram dengan saus\Nrebusan kecap asin,
Dialogue: 0,0:20:02.68,0:20:05.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sake, dan mirin ke atas nasi putih.
Dialogue: 0,0:20:05.73,0:20:08.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu letakkan Belut Badai Kabayaki di atasnya
Dialogue: 0,0:20:08.31,0:20:11.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan Donburi Belut Badai Kabayaki pun\Nselesai dibuat!
Dialogue: 0,0:20:14.28,0:20:16.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nasi putih berkilau yang disiram saus,
Dialogue: 0,0:20:16.30,0:20:18.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}memancarkan aroma manis dan gurih!
Dialogue: 0,0:20:18.82,0:20:20.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan hanya penuh lemak,
Dialogue: 0,0:20:20.07,0:20:22.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kulit luarnya juga dipanggang sangat renyah!
Dialogue: 0,0:20:22.85,0:20:25.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sate daging orc-nya juga enak.
Dialogue: 0,0:20:25.16,0:20:27.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak ikut,\Nkami akan menghabiskannya.
Dialogue: 0,0:20:28.65,0:20:29.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gomamiso.
Dialogue: 0,0:20:29.88,0:20:31.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau coba makan Belut Badai?
Dialogue: 0,0:20:31.71,0:20:35.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di kamusku tidak ada kata\Ntidak bisa makan.
Dialogue: 0,0:20:35.46,0:20:38.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu seperti Napoleon yang rakus, ya.
Dialogue: 0,0:20:39.72,0:20:42.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sake!\NAku ingin minum sake!
Dialogue: 0,0:20:42.01,0:20:43.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seteguk saja juga boleh!
Dialogue: 0,0:20:43.10,0:20:46.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan, Ketua Serikat!\NKamu masih harus bekerja!
Dialogue: 0,0:20:46.18,0:20:48.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak akan minum sampai mabuk!
Dialogue: 0,0:20:48.39,0:20:49.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau beli dulu!
Dialogue: 0,0:20:52.94,0:20:53.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh.
Dialogue: 0,0:20:53.57,0:20:58.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak kusangka di dunia ini juga\Nbisa makan belut panggang.
Dialogue: 0,0:20:59.45,0:21:02.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di ibu kota juga banyak makanan khas.
Dialogue: 0,0:21:02.14,0:21:04.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu boleh menantikannya.
Dialogue: 0,0:21:04.58,0:21:08.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, di Surbrun ada banyak hasil alam.
Dialogue: 0,0:21:09.33,0:21:10.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:21:11.94,0:21:12.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ibu kota...
Dialogue: 0,0:21:12.94,0:21:14.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski sangat menantikannya,
Dialogue: 0,0:21:14.13,0:21:16.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku juga agak khawatir.
Dialogue: 0,0:21:16.42,0:21:18.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan hanya soal Pemanggilan Gadis Suci,
Dialogue: 0,0:21:19.16,0:21:20.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi juga tentang Ville.
Dialogue: 0,0:21:22.76,0:21:24.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kenapa?
Dialogue: 0,0:21:24.18,0:21:25.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa terjadi sesuatu?
Dialogue: 0,0:21:25.72,0:21:28.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rin, aku tidak berhak bilang begini,
Dialogue: 0,0:21:28.77,0:21:30.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi jangan terlalu memikirkannya.
Dialogue: 0,0:21:31.14,0:21:32.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:21:32.56,0:21:33.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini pesta kemenangan.
Dialogue: 0,0:21:33.94,0:21:36.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Merayakan keberhasilanmu\Nmenaklukkan dungeon pertama.
Dialogue: 0,0:21:38.15,0:21:40.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak!
Dialogue: 0,0:21:40.13,0:21:41.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:21:41.61,0:21:43.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski banyak hal terjadi,
Dialogue: 0,0:21:58.26,0:22:00.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku berhasil menaklukkan dungeon pertama!
Dialogue: 0,0:22:00.38,0:22:02.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Selamat.\N- Selamat.
