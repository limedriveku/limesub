Dialogue: 0,0:00:07.90,0:00:10.62,Default,,0,0,0,,Keliling pasar di pagi hari\Nmembakar semangat!
Dialogue: 0,0:00:10.62,0:00:13.45,Default,,0,0,0,,Aku boleh makan semua ini?
Dialogue: 0,0:00:13.45,0:00:14.95,Default,,0,0,0,,Tidak boleh.
Dialogue: 0,0:00:14.95,0:00:15.58,Default,,0,0,0,,Tapi,
Dialogue: 0,0:00:15.58,0:00:18.67,Default,,0,0,0,,aku paham kenapa kamu\Ningin makan semuanya.
Dialogue: 0,0:00:18.67,0:00:20.21,Default,,0,0,0,,Kamu juga?
Dialogue: 0,0:00:20.21,0:00:21.63,Default,,0,0,0,,Kamu tak merasa begitu?
Dialogue: 0,0:00:21.63,0:00:24.38,Default,,0,0,0,,Aku selalu berpikir,\Nsemua bahan ini bagusnya kuolah
Dialogue: 0,0:00:24.38,0:00:26.05,Default,,0,0,0,,dan ditambah apa agar makin enak.
Dialogue: 0,0:00:26.05,0:00:30.51,Default,,0,0,0,,Makin dipikirkan, rasanya semua bahan\Nterlihat sangat enak.
Dialogue: 0,0:00:30.51,0:00:32.43,Default,,0,0,0,,Sekalipun harganya mahal,
Dialogue: 0,0:00:32.43,0:00:34.35,Default,,0,0,0,,tetap penasaran ingin makan setengahnya.
Dialogue: 0,0:00:34.35,0:00:35.60,Default,,0,0,0,,Seru.
Dialogue: 0,0:00:35.60,0:00:36.87,Default,,0,0,0,,Begitu.
Dialogue: 0,0:00:36.87,0:00:39.06,Default,,0,0,0,,Jadi begitu cara berpikir ahli memasak?
Dialogue: 0,0:00:39.06,0:00:41.94,Default,,0,0,0,,Aku tidak mau cuma makan setengahnya.
Dialogue: 0,0:00:41.94,0:00:45.40,Default,,0,0,0,,Kalau sudah tahu hal dasarnya,\Ncara pandangmu nanti berbeda.
Dialogue: 0,0:00:45.40,0:00:47.21,Default,,0,0,0,,Mau kuajarkan?
Dialogue: 0,0:00:47.21,0:00:50.78,Default,,0,0,0,,Hal itu sudah seharusnya\Ndiurus oleh pakarnya.
Dialogue: 0,0:00:50.78,0:00:55.87,Default,,0,0,0,,Bagiku, bertarung melawan Beruang Api\Ndengan tusuk gigi masih lebih mudah.
Dialogue: 0,0:00:55.87,0:00:57.45,Default,,0,0,0,,Semudah itu?
Dialogue: 0,0:02:28.80,0:02:31.24,Default Above,,0,0,0,,Sudah ketemu ingin beli apa?
Dialogue: 0,0:02:31.24,0:02:33.81,Default Above,,0,0,0,,Aku ingin beli rempah-rempah,
Dialogue: 0,0:02:33.81,0:02:36.76,Default,,0,0,0,,tapi aku ingin lihat dulu\Npasar pagi di isekai seperti apa.
Dialogue: 0,0:02:36.76,0:02:38.81,Default,,0,0,0,,Kalaupun tidak ada, bukan masalah.
Dialogue: 0,0:02:38.81,0:02:42.12,Default,,0,0,0,,Perjalanan ke ibu kota kali ini\Nmungkin menginap beberapa hari.
Dialogue: 0,0:02:42.12,0:02:44.48,Default,,0,0,0,,Lebih baik siapkan semua yang dibutuhkan.
Dialogue: 0,0:02:44.48,0:02:48.11,Default,,0,0,0,,Untuk bahan, masih bisa diganti\Ndengan rempah seadanya.
Dialogue: 0,0:02:48.11,0:02:49.01,Default,,0,0,0,,Jangan begitu.
Dialogue: 0,0:02:49.01,0:02:51.57,Default,,0,0,0,,Kalau di sini tidak ada,\Nbesok kita cari di pasar lain.
Dialogue: 0,0:02:51.57,0:02:52.93,Default,,0,0,0,,Tidak perlu serepot itu.
Dialogue: 0,0:02:52.93,0:02:53.74,Default,,0,0,0,,Benar juga.
Dialogue: 0,0:02:53.74,0:02:58.63,Default,,0,0,0,,Di pasar timur sepertinya\Nada toko rempah yang lengkap.
Dialogue: 0,0:02:58.63,0:02:59.91,Default,,0,0,0,,Kamu sebenarnya
Dialogue: 0,0:02:59.91,0:03:02.58,Default,,0,0,0,,tidak ingin pergi ke ibu kota, ya?
Dialogue: 0,0:03:03.20,0:03:05.58,Default,,0,0,0,,Tidak, bukan begitu.
Dialogue: 0,0:03:05.58,0:03:07.92,Default,,0,0,0,,Aku hanya ingin semua persiapan matang.
Dialogue: 0,0:03:07.92,0:03:10.21,Default,,0,0,0,,Kalau terjadi sesuatu,
Dialogue: 0,0:03:10.21,0:03:13.57,Default,,0,0,0,,sebagai ketua, sudah tanggung jawabku\Nuntuk melindungi semua anggota.
Dialogue: 0,0:03:14.97,0:03:16.34,Default,,0,0,0,,Anak itu...
Dialogue: 0,0:03:17.01,0:03:19.55,Default,,0,0,0,,Dia Rento dari Semanggi Keberuntungan?
Dialogue: 0,0:03:19.55,0:03:20.51,Default,,0,0,0,,Rento.
Dialogue: 0,0:03:21.50,0:03:23.36,Default,,0,0,0,,Ville dari Meja Rakus.
Dialogue: 0,0:03:23.71,0:03:24.98,Default,,0,0,0,,Lalu Rin juga!
Dialogue: 0,0:03:25.63,0:03:28.38,Default,,0,0,0,,Terima kasih untuk biskuitnya waktu itu.
Dialogue: 0,0:03:28.38,0:03:30.37,Default,,0,0,0,,Teman-teman di gereja juga\Nbilang sangat enak!
Dialogue: 0,0:03:30.37,0:03:32.19,Default,,0,0,0,,Semuanya sampai berebut!
Dialogue: 0,0:03:32.19,0:03:34.32,Default,,0,0,0,,Benarkah?\NSenang mendengarnya.
Dialogue: 0,0:03:34.32,0:03:37.53,Default,,0,0,0,,Apa itu biskuit?\NAku juga mau makan.
Dialogue: 0,0:03:37.53,0:03:39.13,Default,,0,0,0,,Sedang bantu-bantu gereja?
Dialogue: 0,0:03:39.13,0:03:40.87,Default,,0,0,0,,Mungkin bukan bantu-bantu,
Dialogue: 0,0:03:41.28,0:03:44.41,Default,,0,0,0,,aku pikir akan dapat ide bagus\Nkalau pergi ke pasar.
Dialogue: 0,0:03:45.00,0:03:48.03,Default,,0,0,0,,Rin, bisa beri aku saran?
Dialogue: 0,0:03:48.83,0:03:51.09,Default,,0,0,0,,Tolong ikut denganku ke gereja sebentar.
Dialogue: 0,0:03:51.60,0:03:55.59,Default,,0,0,0,,Tapi, besok kami akan pergi ke ibu kota,
Dialogue: 0,0:03:55.59,0:03:57.09,Default,,0,0,0,,mungkin tidak ada waktu...
Dialogue: 0,0:03:57.09,0:03:58.97,Default,,0,0,0,,Kita sudah saling kenal.
Dialogue: 0,0:03:58.97,0:04:01.44,Default,,0,0,0,,Bukankah bagus kalau kita\Nbisa bantu mereka?
Dialogue: 0,0:04:01.44,0:04:03.06,Default,,0,0,0,,Ville, kamu memang tidak niat...
Dialogue: 0,0:04:03.06,0:04:05.56,Default,,0,0,0,,Bukan, sudah kubilang bukan karena itu.
Dialogue: 0,0:04:05.56,0:04:07.87,Default,,0,0,0,,Kalaupun bergegas ke ibu kota sekarang,
Dialogue: 0,0:04:07.87,0:04:10.86,Default,,0,0,0,,belum tentu masalahnya bisa kita selesaikan.
Dialogue: 0,0:04:10.86,0:04:11.86,Default,,0,0,0,,Selain itu,
Dialogue: 0,0:04:11.86,0:04:15.78,Default,,0,0,0,,kita harus prioritaskan bantu orang\Nyang sedang kesulitan.
Dialogue: 0,0:04:15.78,0:04:18.24,Default,,0,0,0,,Terima kasih.
Dialogue: 0,0:04:18.81,0:04:23.24,Default,,0,0,0,,Aku terus kepikiran harus buat\Nmakanan enak apa di acara amal.
Dialogue: 0,0:04:23.24,0:04:24.37,Default,,0,0,0,,Awalnya
Dialogue: 0,0:04:24.37,0:04:27.91,Default,,0,0,0,,mau kuolah buah Mucci yang lagi musim\Ndi halaman jadi tepung buat dango.
Dialogue: 0,0:04:27.91,0:04:29.21,Default,,0,0,0,,Tapi ternyata sulit...
Dialogue: 0,0:04:29.21,0:04:32.13,Default,,0,0,0,,Itu sulit ditelan karena teksturnya\Nyang sangat kenyal.
Dialogue: 0,0:04:32.13,0:04:34.25,Default,,0,0,0,,Rasanya juga sangat kuat.
Dialogue: 0,0:04:34.25,0:04:36.67,Default,,0,0,0,,Warnanya yang putih polos\Nmembuat orang tak berselera.
Dialogue: 0,0:04:36.67,0:04:38.30,Default,,0,0,0,,Saat dimakan juga lengket.
Dialogue: 0,0:04:38.30,0:04:40.43,Default,,0,0,0,,Lalu langsung mengeras kalau tak dimakan.
Dialogue: 0,0:04:40.43,0:04:42.43,Default,,0,0,0,,Aku tidak mau makan yang kenyal.
Dialogue: 0,0:04:42.43,0:04:44.51,Default,,0,0,0,,Kedengarannya ulasannya sangat buruk, ya.
Dialogue: 0,0:04:44.51,0:04:47.52,Default,,0,0,0,,Dango Mucci masih jadi menu tetap kami.
Dialogue: 0,0:04:47.52,0:04:49.94,Default,,0,0,0,,Setidaknya aku ingin semua orang bilang enak.
Dialogue: 0,0:04:49.94,0:04:51.77,Default,,0,0,0,,Pasti sedih kalau makanan
Dialogue: 0,0:04:51.77,0:04:55.23,Default,,0,0,0,,yang sudah susah payah dibuat berujung\Ndiberi komentar "biasa saja".
Dialogue: 0,0:04:55.23,0:04:56.73,Default,,0,0,0,,Itu benar!
Dialogue: 0,0:04:56.73,0:04:59.78,Default,,0,0,0,,Jadi, aku berpikir, apa Rin\Nyang bisa membuat biskuit enak
Dialogue: 0,0:04:59.78,0:05:01.91,Default,,0,0,0,,punya cara yang bagus?
Dialogue: 0,0:05:01.91,0:05:04.58,Default,,0,0,0,,Kalau sudah dipuji begitu,
Dialogue: 0,0:05:04.58,0:05:07.29,Default,,0,0,0,,aku jadi ingin bantu, tapi...
Dialogue: 0,0:05:07.29,0:05:09.04,Default,,0,0,0,,Ah, Rento!
Dialogue: 0,0:05:09.58,0:05:12.49,Default,,0,0,0,,Kamu sedang apa?\NKenapa malah mangkir bersih-bersih?
Dialogue: 0,0:05:12.49,0:05:14.28,Default,,0,0,0,,Tunggu, siapa mereka?
Dialogue: 0,0:05:14.28,0:05:15.84,Default,,0,0,0,,Jangan bilang kamu dengar rumor aneh
Dialogue: 0,0:05:15.84,0:05:18.34,Default,,0,0,0,,dan membawa dua orang\Nmencurigakan ini lagi?
Dialogue: 0,0:05:18.34,0:05:19.74,Default,,0,0,0,,Tentu saja bukan.
Dialogue: 0,0:05:19.74,0:05:22.93,Default,,0,0,0,,Mereka anggota Meja Rakus yang sudah\Nmenyelamatkan kita tempo hari!
Dialogue: 0,0:05:24.91,0:05:26.64,Default,,0,0,0,,Aku benar-benar minta maaf!
Dialogue: 0,0:05:26.64,0:05:30.56,Default,,0,0,0,,Aku malah berkata buruk pada anggota tim\Nyang sudah menyelamatkan rekan kami.
Dialogue: 0,0:05:30.56,0:05:31.23,Default,,0,0,0,,Tidak apa-apa.
Dialogue: 0,0:05:31.23,0:05:35.02,Default,,0,0,0,,Curiga pada orang asing itu hal wajar.
Dialogue: 0,0:05:35.02,0:05:37.61,Default,,0,0,0,,Apalagi di sini ada banyak anak-anak.
Dialogue: 0,0:05:40.11,0:05:41.83,Default,,0,0,0,,Aku akan perkenalkan diriku lagi.
Dialogue: 0,0:05:41.83,0:05:45.00,Default,,0,0,0,,Namaku Rin, porter\Nsekaligus koki di Meja Rakus.
Dialogue: 0,0:05:45.83,0:05:47.99,Default,,0,0,0,,Aku Manusia Singa, Rion.
Dialogue: 0,0:05:47.99,0:05:50.58,Default,,0,0,0,,Bertugas sebagai barisan depan\Ndi Semanggi Keberuntungan.
Dialogue: 0,0:05:50.58,0:05:53.25,Default,,0,0,0,,Aku petarung berat dari Meja Rakus, Ville.
Dialogue: 0,0:05:54.79,0:05:58.71,Default,,0,0,0,,Omong-omong, apa kami boleh\Nmenggunakan dapur ini?
Dialogue: 0,0:05:58.71,0:05:59.61,Default,,0,0,0,,Benar juga.
Dialogue: 0,0:05:59.61,0:06:02.97,Default,,0,0,0,,Seharusnya kita menyapa\Npengurus gereja dulu.
Dialogue: 0,0:06:02.97,0:06:04.34,Default,,0,0,0,,Tenang saja.
Dialogue: 0,0:06:04.34,0:06:07.81,Default,,0,0,0,,Rento bilang dia sudah dapat izin\Ndari Guru Leia.
Dialogue: 0,0:06:07.81,0:06:10.07,Default,,0,0,0,,Ini buah Mucci yang sudah\Nditumbuk terigu.
Dialogue: 0,0:06:10.07,0:06:12.02,Default,,0,0,0,,Aku akan membuatnya menjadi dango.
Dialogue: 0,0:06:12.93,0:06:15.27,Default,,0,0,0,,Kamu membawa anggota Meja Rakus kemari
Dialogue: 0,0:06:15.27,0:06:17.27,Default,,0,0,0,,hanya untuk mentraktir mereka dango Mucci?
Dialogue: 0,0:06:17.27,0:06:18.86,Default,,0,0,0,,Bukan!
Dialogue: 0,0:06:18.86,0:06:21.57,Default,,0,0,0,,Aku minta saran soal camilan\Nyang cocok dibagikan di acara amal.
Dialogue: 0,0:06:21.57,0:06:23.61,Default,,0,0,0,,Malah bertindak seenaknya lagi!
Dialogue: 0,0:06:23.61,0:06:25.41,Default,,0,0,0,,Bagaimana dengan balas budi pada mereka?
Dialogue: 0,0:06:25.41,0:06:28.37,Default,,0,0,0,,Kamu mau menyuruh Guru Leia\Nmenjual barang gereja lagi?
Dialogue: 0,0:06:28.37,0:06:30.87,Default,,0,0,0,,Rin bilang dia tidak butuh balas budi!
Dialogue: 0,0:06:30.87,0:06:32.08,Default,,0,0,0,,Yang kutahu itu
Dialogue: 0,0:06:32.08,0:06:34.33,Default,,0,0,0,,cuma sedikit lebih banyak dari orang biasa.
Dialogue: 0,0:06:35.42,0:06:37.63,Default,,0,0,0,,Tapi resepnya bisa dijual\Ndengan harga mahal!
Dialogue: 0,0:06:37.63,0:06:39.75,Default,,0,0,0,,Rin, kamu terlalu baik.
Dialogue: 0,0:06:39.75,0:06:42.21,Default,,0,0,0,,Be-Begitu, ya?
Dialogue: 0,0:06:42.21,0:06:44.18,Default,,0,0,0,,Campur terigu Mucci dengan air
Dialogue: 0,0:06:44.18,0:06:45.51,Default,,0,0,0,,sampai jadi adonan, lalu bentuk
Dialogue: 0,0:06:45.51,0:06:46.84,Default,,0,0,0,,jadi dango dan rebus.
Dialogue: 0,0:06:46.84,0:06:48.85,Default,,0,0,0,,Nah, selesai.
Dialogue: 0,0:06:48.85,0:06:51.95,Default,,0,0,0,,Karena akan cepat mengeras,\Nsebaiknya langsung dimakan.
Dialogue: 0,0:06:51.95,0:06:54.89,Default,,0,0,0,,Terima kasih, selamat mencicipi.
Dialogue: 0,0:06:56.44,0:06:57.86,Default,,0,0,0,,Kenyal sekali.
Dialogue: 0,0:06:58.55,0:07:02.53,Default,,0,0,0,,Meski ada aroma kacangnya,\Nrasanya agak berbeda.
Dialogue: 0,0:07:02.53,0:07:06.20,Default,,0,0,0,,Setelah dimakan pun masih menyisakan\Nsedikit rasa sepat.
Dialogue: 0,0:07:06.20,0:07:08.04,Default,,0,0,0,,Biasanya kami celupkan ke madu,
Dialogue: 0,0:07:08.04,0:07:10.37,Default,,0,0,0,,lalu dibungkus dengan\Ndaun Zeram sebelum dibagikan.
Dialogue: 0,0:07:10.37,0:07:12.58,Default,,0,0,0,,Apa ada cara memasak lainnya\Nyang lebih umum?
Dialogue: 0,0:07:12.58,0:07:14.63,Default,,0,0,0,,Bisa digoreng atau dipanggang juga,
Dialogue: 0,0:07:14.63,0:07:18.46,Default,,0,0,0,,tapi karena ada banyak anak kecil di sini,\NGuru melarang pakai banyak minyak.
Dialogue: 0,0:07:18.46,0:07:22.41,Default,,0,0,0,,Mereka juga suka bermain di sekitar kami,\Njadi tidak bisa pakai panggangan.
Dialogue: 0,0:07:22.41,0:07:24.03,Default,,0,0,0,,Begitu.
Dialogue: 0,0:07:24.03,0:07:28.09,Default,,0,0,0,,Butuh proses pembuatan yang aman\Ndan bisa dibuat dalam jumlah banyak,
Dialogue: 0,0:07:28.09,0:07:30.55,Default,,0,0,0,,juga camilan yang praktis\Nuntuk di acara amal?
Dialogue: 0,0:07:30.55,0:07:32.56,Default,,0,0,0,,Memangnya ada masakan seperti itu?
Dialogue: 0,0:07:36.19,0:07:40.09,Default,,0,0,0,,Kalau begini, mungkin yang paling\Nmendekati dango Shiratama, ya?
Dialogue: 0,0:07:40.09,0:07:43.44,Default,,0,0,0,,Meski sudah dicelup madu,\Nkalau harus dikunyah lama,
Dialogue: 0,0:07:43.44,0:07:45.80,Default,,0,0,0,,mungkin di pertengahan\Nakan hilang rasanya.
Dialogue: 0,0:07:47.91,0:07:48.95,Default,,0,0,0,,Kalau begitu,
Dialogue: 0,0:07:48.95,0:07:51.33,Default,,0,0,0,,bagaimana kalau dango-nya\Nlangsung diberi rasa?
Dialogue: 0,0:07:52.12,0:07:54.75,Default,,0,0,0,,Dengan begitu,\Nkita bisa pakai resep Shiratama
Dialogue: 0,0:07:54.75,0:07:59.13,Default,,0,0,0,,sekaligus bisa membuat adonan\Nberasa dalam jumlah banyak...
Dialogue: 0,0:08:00.58,0:08:03.30,Default,,0,0,0,,Pao de Queijo versi praktis!
Dialogue: 0,0:08:04.28,0:08:05.17,Default,,0,0,0,,Apa?
Dialogue: 0,0:08:05.17,0:08:07.22,Default,,0,0,0,,Singkatnya "bola keju".
Dialogue: 0,0:08:07.22,0:08:10.48,Default,,0,0,0,,Ini jenis camilan yang lembut,\Nkenyal, dan mirip roti!
Dialogue: 0,0:08:10.48,0:08:12.04,Default,,0,0,0,,Aku boleh pakai tepung terigunya?
Dialogue: 0,0:08:12.04,0:08:14.37,Default,,0,0,0,,Kalau boleh, aku juga butuh keju dan susu.
Dialogue: 0,0:08:14.37,0:08:16.43,Default,,0,0,0,,Boleh.
Dialogue: 0,0:08:17.00,0:08:18.35,Default,,0,0,0,,Baiklah.
Dialogue: 0,0:08:18.35,0:08:20.02,Default,,0,0,0,,Akan kucontohkan!
Dialogue: 0,0:08:20.02,0:08:22.02,Default,,0,0,0,,Rento, lihat langkah-langkahnya, ya.
Dialogue: 0,0:08:22.02,0:08:22.86,Default,,0,0,0,,Baik.
Dialogue: 0,0:08:22.86,0:08:25.11,Default,,0,0,0,,Pertama, ayak perlahan terigu Mucci-nya,
Dialogue: 0,0:08:25.11,0:08:27.11,Default,,0,0,0,,lalu campurkan dengan tepung terigu.
Dialogue: 0,0:08:27.11,0:08:28.53,Default,,0,0,0,,Selama ini didahulukan,
Dialogue: 0,0:08:28.53,0:08:30.60,Default,,0,0,0,,saat mengaduk nanti tak akan menggumpal.
Dialogue: 0,0:08:30.60,0:08:31.70,Default,,0,0,0,,Begitu.
Dialogue: 0,0:08:31.70,0:08:36.00,Default,,0,0,0,,Selanjutnya, tambahkan keju parut,\Ngaram, dan minyak sayur.
Dialogue: 0,0:08:36.00,0:08:39.75,Default,,0,0,0,,Sambil diaduk dengan spatula,\Ntuangkan susu perlahan-lahan.
Dialogue: 0,0:08:39.75,0:08:42.84,Default,,0,0,0,,Setelah permukaannya halus,\Nadonannya pun selesai.
Dialogue: 0,0:08:43.19,0:08:45.05,Default,,0,0,0,,Selanjutnya bentuk adonan menjadi bola,
Dialogue: 0,0:08:45.49,0:08:46.55,Default,,0,0,0,,lalu dipanggang.
Dialogue: 0,0:08:50.76,0:08:52.80,Default,,0,0,0,,Bola keju sudah jadi!
Dialogue: 0,0:08:53.97,0:08:55.10,Default,,0,0,0,,Terlihat mudah.
Dialogue: 0,0:08:55.10,0:08:56.02,Default,,0,0,0,,Iya, kan?
Dialogue: 0,0:08:56.02,0:09:00.90,Default,,0,0,0,,Bola keju ini bisa dibuat dengan mudah\Noleh anak-anak yang masih kecil.
Dialogue: 0,0:09:00.90,0:09:04.11,Default,,0,0,0,,Membuat jumlah banyak pun\Ntidak akan merepotkan.
Dialogue: 0,0:09:04.11,0:09:05.44,Default,,0,0,0,,Kelihatannya enak.
Dialogue: 0,0:09:05.44,0:09:07.53,Default,,0,0,0,,Kalau begitu, ayo segera kita cicipi.
Dialogue: 0,0:09:07.53,0:09:08.74,Default,,0,0,0,,Aku juga mau makan!
Dialogue: 0,0:09:08.74,0:09:10.61,Default,,0,0,0,,Tunggu sebentar sampai agak dingin dulu!
Dialogue: 0,0:09:10.61,0:09:14.16,Default,,0,0,0,,Makanan seperti ini enak dimakan\Nsaat masih panas!
Dialogue: 0,0:09:15.41,0:09:16.77,Default,,0,0,0,,- Panas!\N- Panas!
Dialogue: 0,0:09:16.77,0:09:18.12,Default,,0,0,0,,Tentu saja.
Dialogue: 0,0:09:18.12,0:09:19.62,Default,,0,0,0,,Tapi ini enak!
Dialogue: 0,0:09:19.62,0:09:21.25,Default,,0,0,0,,Iya, enak!
Dialogue: 0,0:09:21.25,0:09:23.33,Default,,0,0,0,,Aku masih mau makan beberapa lagi.
Dialogue: 0,0:09:24.11,0:09:25.37,Default,,0,0,0,,Panas.
Dialogue: 0,0:09:27.03,0:09:28.38,Default,,0,0,0,,Enak!
Dialogue: 0,0:09:28.38,0:09:32.05,Default,,0,0,0,,Aroma kacang dari buah Mucci\Ndan kejunya sangat cocok, ya.
Dialogue: 0,0:09:32.05,0:09:35.22,Default,,0,0,0,,Karena ditambah tepung terigu,\Nkekenyalannya juga pas.
Dialogue: 0,0:09:36.31,0:09:38.04,Default,,0,0,0,,Kakak, kalian siapa?
Dialogue: 0,0:09:38.04,0:09:39.48,Default,,0,0,0,,Kalian sedang makan apa?
Dialogue: 0,0:09:39.48,0:09:41.02,Default,,0,0,0,,Aku juga mau.
Dialogue: 0,0:09:42.48,0:09:45.31,Default,,0,0,0,,- Hati-hati, semuanya tenang dulu.\N- Kalian sedang makan apa?
Dialogue: 0,0:09:45.31,0:09:47.61,Default,,0,0,0,,Aku boleh bagikan ini ke mereka?
Dialogue: 0,0:09:47.61,0:09:49.03,Default,,0,0,0,,Boleh.
Dialogue: 0,0:09:49.03,0:09:52.22,Default,,0,0,0,,Ayo!\NSemuanya baris yang rapi.
Dialogue: 0,0:09:52.22,0:09:54.64,Default,,0,0,0,,Harus baris dengan tertib\Nbaru bisa dapat camilan.
Dialogue: 0,0:09:54.64,0:09:55.62,Default,,0,0,0,,Hore!
Dialogue: 0,0:09:55.62,0:09:56.58,Default,,0,0,0,,Aku mau camilan.
Dialogue: 0,0:09:56.58,0:09:58.66,Default,,0,0,0,,Ditiup dulu baru dimakan ya.
Dialogue: 0,0:09:58.66,0:10:00.50,Default,,0,0,0,,- Terampil sekali, ya.\N- Baik!
Dialogue: 0,0:10:00.50,0:10:01.91,Default,,0,0,0,,Hebat, ya.
Dialogue: 0,0:10:02.65,0:10:04.29,Default,,0,0,0,,Aku sudah biasa merawat mereka.
Dialogue: 0,0:10:04.29,0:10:05.87,Default,,0,0,0,,Kamu juga suka ikut ribut.
Dialogue: 0,0:10:05.87,0:10:07.29,Default,,0,0,0,,Mana ada!
Dialogue: 0,0:10:07.29,0:10:08.57,Default,,0,0,0,,Enak!
Dialogue: 0,0:10:08.57,0:10:11.13,Default,,0,0,0,,Senang mendengar mereka bilang enak.
Dialogue: 0,0:10:11.13,0:10:13.72,Default,,0,0,0,,Wah, di sini ramai sekali, ya.
Dialogue: 0,0:10:14.16,0:10:16.60,Default,,0,0,0,,Kalian anggota Meja Rakus, ya?
Dialogue: 0,0:10:16.60,0:10:19.93,Default,,0,0,0,,Aku Leia, pendeta di sini.
Dialogue: 0,0:10:19.93,0:10:24.31,Default,,0,0,0,,Tempo hari, kami Semanggi Keberuntungan\Ntelah banyak dibantu oleh kalian.
Dialogue: 0,0:10:24.31,0:10:26.48,Default,,0,0,0,,Sekali lagi, aku berterima kasih pada kalian.
Dialogue: 0,0:10:26.48,0:10:29.32,Default,,0,0,0,,Tidak, aku tidak melakukan apa pun.
Dialogue: 0,0:10:29.32,0:10:32.44,Default,,0,0,0,,Saat menghadapi bahaya\Nsudah sepantasnya saling membantu.
Dialogue: 0,0:10:32.44,0:10:34.03,Default,,0,0,0,,Tolong jangan dipikirkan.
Dialogue: 0,0:10:34.03,0:10:35.07,Default,,0,0,0,,Omong-omong,
Dialogue: 0,0:10:35.07,0:10:37.12,Default,,0,0,0,,kenapa anggota Meja Rakus
Dialogue: 0,0:10:37.12,0:10:40.04,Default,,0,0,0,,memasak di dapur gereja kami?
Dialogue: 0,0:10:40.04,0:10:40.79,Default,,0,0,0,,Eh?
Dialogue: 0,0:10:40.79,0:10:43.23,Default,,0,0,0,,Rento, tadi kamu bilang Guru sudah setuju!
Dialogue: 0,0:10:43.23,0:10:45.62,Default,,0,0,0,,Begini, Guru sedang memimpin ritual.
Dialogue: 0,0:10:45.62,0:10:48.09,Default,,0,0,0,,Jadi bilangnya setelah beliau selesai.
Dialogue: 0,0:10:56.83,0:10:58.72,Default,,0,0,0,,Ini sangat enak.
Dialogue: 0,0:10:58.72,0:11:00.47,Default,,0,0,0,,Teksturnya juga terasa baru.
Dialogue: 0,0:11:02.06,0:11:04.73,Default,,0,0,0,,Para tamu pasti akan suka kalau\Nkita dibagikan di acara amal!
Dialogue: 0,0:11:04.73,0:11:07.69,Default,,0,0,0,,Kami tadi ikut bantu,\Ncara pembuatannya juga sangat mudah.
Dialogue: 0,0:11:07.69,0:11:10.15,Default,,0,0,0,,Kita bisa menyuruh semuanya\Nuntuk membantu membuat ini.
Dialogue: 0,0:11:10.15,0:11:12.57,Default,,0,0,0,,Baru kali ini aku mencicipi\Ncamilan seperti ini.
Dialogue: 0,0:11:12.57,0:11:14.28,Default,,0,0,0,,Resepnya pasti sangat langka, kan?
Dialogue: 0,0:11:14.28,0:11:17.49,Default,,0,0,0,,Oh, tidak serumit itu.
Dialogue: 0,0:11:17.49,0:11:23.08,Default,,0,0,0,,Terima kasih telah memberikan kebijaksanaan\Ndan inspirasi pada anak-anak.
Dialogue: 0,0:11:23.08,0:11:24.62,Default,,0,0,0,,Ini jasamu, Rin.
Dialogue: 0,0:11:24.62,0:11:25.41,Default,,0,0,0,,Tidak...
Dialogue: 0,0:11:25.41,0:11:28.63,Default,,0,0,0,,Aku hanya mengganti sedikit\Nresep yang sudah ada.
Dialogue: 0,0:11:29.07,0:11:30.04,Default,,0,0,0,,Oh, iya!
Dialogue: 0,0:11:30.04,0:11:31.61,Default,,0,0,0,,Bicara soal ganti resep,
Dialogue: 0,0:11:31.61,0:11:34.36,Default,,0,0,0,,kurangi sedikit kejunya lalu ganti\Ndengan tambahan madu
Dialogue: 0,0:11:34.36,0:11:36.09,Default,,0,0,0,,dan masukkan kacang tumbuk,
Dialogue: 0,0:11:36.09,0:11:38.43,Default,,0,0,0,,maka akan rasanya akan jadi manis gurih.
Dialogue: 0,0:11:38.43,0:11:40.05,Default,,0,0,0,,Kedengarannya enak!
Dialogue: 0,0:11:40.05,0:11:41.93,Default,,0,0,0,,Kamu tahu banyak hal, ya!
Dialogue: 0,0:11:41.93,0:11:44.95,Default,,0,0,0,,Rin, kenapa kamu bocorkan\Nbanyak hal semudah itu?
Dialogue: 0,0:11:44.95,0:11:48.23,Default,,0,0,0,,Tidak, ini cuma mengganti rasanya saja.
Dialogue: 0,0:11:48.63,0:11:52.65,Default,,0,0,0,,Karena kami sudah dibantu banyak,\Nizinkan aku membalas budi.
Dialogue: 0,0:11:52.65,0:11:54.78,Default,,0,0,0,,Tidak, jangan begitu.
Dialogue: 0,0:11:54.78,0:11:57.45,Default,,0,0,0,,Aku membantu karena ingin.
Dialogue: 0,0:11:57.45,0:12:00.87,Default,,0,0,0,,Gereja kami memuja Dewi Lishia,\Ndan ajarannya
Dialogue: 0,0:12:00.87,0:12:04.87,Default,,0,0,0,,"Cinta tanpa pamrih\Nharus dibalas dengan cinta."
Dialogue: 0,0:12:04.87,0:12:06.71,Default,,0,0,0,,Kalau kami tak balas budi,
Dialogue: 0,0:12:06.71,0:12:09.16,Default,,0,0,0,,itu akan mencoreng nama baik Gereja Lishia!
Dialogue: 0,0:12:09.16,0:12:14.13,Default,,0,0,0,,Kalau begitu, aku boleh\Nminta sedikit terigu Mucci kalian?
Dialogue: 0,0:12:16.59,0:12:20.48,Default,,0,0,0,,Pada akhirnya,\Ndia tetap memberikan barang lain.
Dialogue: 0,0:12:21.95,0:12:26.37,Default,,0,0,0,,Ini jimat yang kudapatkan\Nsaat masih bekerja di kuil utama dulu.
Dialogue: 0,0:12:26.37,0:12:30.02,Default,,0,0,0,,Konon terdapat perlindungan\Ndari Dewi Air Lishia di dalamnya.
Dialogue: 0,0:12:30.71,0:12:33.61,Default,,0,0,0,,Aku tidak bisa menerima\Nbarang seberharga ini!
Dialogue: 0,0:12:33.61,0:12:36.24,Default,,0,0,0,,Ini bukan barang berharga.
Dialogue: 0,0:12:36.24,0:12:39.99,Default,,0,0,0,,Budi besar kalian berdua, mustahil bisa\Ndibalas dengan terigu Mucci saja.
Dialogue: 0,0:12:39.99,0:12:41.74,Default,,0,0,0,,Terima saja, Rin.
Dialogue: 0,0:12:41.74,0:12:44.59,Default,,0,0,0,,Resep lezat seperti itu\Naslinya memang bernilai mahal.
Dialogue: 0,0:12:44.59,0:12:45.83,Default,,0,0,0,,Tidak bisa...
Dialogue: 0,0:12:46.15,0:12:48.62,Default,,0,0,0,,Ini sungguhan bukan barang berharga, kan?
Dialogue: 0,0:12:48.62,0:12:51.03,Default,,0,0,0,,Aku bisa bersumpah atas nama Dewi Lishia.
Dialogue: 0,0:12:52.21,0:12:54.42,Default,,0,0,0,,Apa ini betulan tidak apa-apa?
Dialogue: 0,0:12:54.42,0:12:56.65,Default,,0,0,0,,Leia sudah bersikeras seperti itu.
Dialogue: 0,0:12:56.65,0:12:59.68,Default,,0,0,0,,Kamu tidak punya pelindung,\Njadi lebih baik bawa jimat.
Dialogue: 0,0:13:00.09,0:13:01.85,Default,,0,0,0,,Benar juga.
Dialogue: 0,0:13:01.85,0:13:05.31,Default,,0,0,0,,Lagi pula, bisa dibilang,\Naku juga anggota Meja Rakus.
Dialogue: 0,0:13:05.31,0:13:07.71,Default,,0,0,0,,Kamu masih bilang "bisa dibilang"?
Dialogue: 0,0:13:07.71,0:13:11.10,Default,,0,0,0,,Aku malah merasa perut kami\Nsudah lama kamu taklukkan
Dialogue: 0,0:13:11.10,0:13:13.11,Default,,0,0,0,,dan tak bisa bertahan tanpa dirimu.
Dialogue: 0,0:13:13.63,0:13:14.73,Default,,0,0,0,,Kalian merasa begitu?
Dialogue: 0,0:13:14.73,0:13:15.69,Default,,0,0,0,,Memang begitu adanya.
Dialogue: 0,0:13:15.69,0:13:19.53,Default,,0,0,0,,Kalau begitu, aku harus cepat-cepat pulang\Nuntuk membuat sarapan buat semuanya.
Dialogue: 0,0:13:19.53,0:13:21.88,Default,,0,0,0,,Nanti setelah makan kenyang\Nbaru keluar belanja lagi.
Dialogue: 0,0:13:21.88,0:13:24.03,Default,,0,0,0,,Aku juga sudah lapar.
Dialogue: 0,0:13:24.03,0:13:25.78,Default,,0,0,0,,Tidak, tidak usah pulang.
Dialogue: 0,0:13:25.78,0:13:28.33,Default,,0,0,0,,Sebenarnya kemarin\Nsetelah kamu beristirahat,
Dialogue: 0,0:13:28.33,0:13:31.83,Default,,0,0,0,,kami sudah sepakat kalau pagi ini\Nmasing-masing sarapan di luar.
Dialogue: 0,0:13:32.15,0:13:34.32,Default,,0,0,0,,Jadi ayo kita sarapan di pasar juga.
Dialogue: 0,0:13:34.96,0:13:36.05,Default,,0,0,0,,Boleh juga.
Dialogue: 0,0:13:36.05,0:13:37.36,Default,,0,0,0,,Kamu mau makan apa?
Dialogue: 0,0:13:37.36,0:13:40.38,Default,,0,0,0,,Aku sebelumnya selalu makan di luar,\Njadi sangat paham soal ini.
Dialogue: 0,0:13:41.20,0:13:42.59,Default,,0,0,0,,Benar-benar bisa diandalkan.
Dialogue: 0,0:13:42.59,0:13:46.01,Default,,0,0,0,,Aku makan apa saja.
Dialogue: 0,0:13:50.93,0:13:53.27,Default,,0,0,0,,Jadi tidak sabar.
Dialogue: 0,0:13:53.27,0:13:55.01,Default,,0,0,0,,Tidak sabar, ya.
Dialogue: 0,0:13:55.01,0:13:58.11,Default,,0,0,0,,Tapi, apa aku tidak sengaja\Nmemesan terlalu banyak?
Dialogue: 0,0:13:58.11,0:13:59.43,Default,,0,0,0,,Saat sedang bersama yang lain,
Dialogue: 0,0:13:59.43,0:14:01.95,Default,,0,0,0,,porsi kami setidaknya\Ndua kali lebih banyak darimu.
Dialogue: 0,0:14:01.95,0:14:04.82,Default,,0,0,0,,Eh? Memang sesuai julukannya,\NMeja Rakus.
Dialogue: 0,0:14:04.82,0:14:09.24,Default,,0,0,0,,Tapi, setiap kali datang ke pasar,\Naku merasa kota ini sangat damai.
Dialogue: 0,0:14:09.24,0:14:13.29,Default,,0,0,0,,Benar, sama sekali tidak ada\Nnuansa kekacauan.
Dialogue: 0,0:14:13.29,0:14:17.64,Default,,0,0,0,,Lalu kenapa orang dari negara tetangga\Nharus memanggil Gadis Suci?
Dialogue: 0,0:14:17.64,0:14:20.59,Default,,0,0,0,,Ini, maaf membuat kalian menunggu!
Dialogue: 0,0:14:21.59,0:14:23.84,Default,,0,0,0,,Ini Aoinazuma dingin\Ndan tumis Aoinazuma,
Dialogue: 0,0:14:23.84,0:14:26.10,Default,,0,0,0,,lalu kakap sirip panjang goreng\Npanggang aburi.
Dialogue: 0,0:14:26.10,0:14:29.43,Default,,0,0,0,,Lalu ini makanan untuk si kucing.
Dialogue: 0,0:14:31.13,0:14:34.73,Default,,0,0,0,,Pokoknya, hal-hal rumitnya dipikirkan\Nsetelah selesai makan.
Dialogue: 0,0:14:34.73,0:14:37.27,Default,,0,0,0,,Benar juga.\NAyo kita makan.
Dialogue: 0,0:14:39.26,0:14:41.49,Default,,0,0,0,,Aoinazuma dingin ini!
Dialogue: 0,0:14:41.49,0:14:44.24,Default,,0,0,0,,Sangat kenyal, tapi mudah dikunyah!
Dialogue: 0,0:14:44.24,0:14:47.49,Default,,0,0,0,,Ditambah aroma amis atau bau lautnya hilang.
Dialogue: 0,0:14:47.49,0:14:50.08,Default,,0,0,0,,Makin dikunyah, makin terasa rasa gurihnya!
Dialogue: 0,0:14:50.08,0:14:53.41,Default,,0,0,0,,Daging yang ditumis teksturnya\Njadi lebih padat dan elastis.
Dialogue: 0,0:14:53.41,0:14:56.13,Default,,0,0,0,,Sangat cocok dengan saus krim\Nyang kaya rasa ini.
Dialogue: 0,0:14:56.13,0:14:57.88,Default,,0,0,0,,Makan sebanyak apa pun tak terasa bosan!
Dialogue: 0,0:14:57.88,0:15:01.84,Default,,0,0,0,,Kakap sirip panjang ini\Njuga gemuk dan enak.
Dialogue: 0,0:15:01.84,0:15:04.63,Default,,0,0,0,,Bahkan setelah digoreng pun,\Ntulangnya harum dan bisa dimakan.
Dialogue: 0,0:15:07.68,0:15:08.43,Default,,0,0,0,,Wah.
Dialogue: 0,0:15:08.43,0:15:10.39,Default,,0,0,0,,Kalian makan sangat lahap, ya.
Dialogue: 0,0:15:10.39,0:15:12.91,Default,,0,0,0,,Masakan di toko ini semuanya enak.
Dialogue: 0,0:15:15.36,0:15:17.31,Default,,0,0,0,,Sepertinya cocok dengan seleramu.
Dialogue: 0,0:15:17.31,0:15:18.32,Default,,0,0,0,,Anu.
Dialogue: 0,0:15:18.86,0:15:22.53,Default,,0,0,0,,Aku boleh beli ikan\Nyang dipakai di toko kalian?
Dialogue: 0,0:15:22.53,0:15:23.24,Default,,0,0,0,,Eh?
Dialogue: 0,0:15:23.24,0:15:25.07,Default,,0,0,0,,Karena rasanya sangat enak,
Dialogue: 0,0:15:25.07,0:15:27.61,Default,,0,0,0,,aku ingin memasakkannya\Nuntuk semua orang di tim kami.
Dialogue: 0,0:15:28.12,0:15:29.53,Default,,0,0,0,,Aku tahu ini tidak sopan...
Dialogue: 0,0:15:29.53,0:15:30.99,Default,,0,0,0,,Aku senang mendengarnya!
Dialogue: 0,0:15:30.99,0:15:33.45,Default,,0,0,0,,Sudah lama tak ada orang\Nyang bertanya padaku seperti itu.
Dialogue: 0,0:15:33.45,0:15:36.92,Default,,0,0,0,,Orang-orang di sini\Nsudah bosan makan ikan.
Dialogue: 0,0:15:36.92,0:15:38.98,Default,,0,0,0,,Bos kami pasti juga akan sangat senang.
Dialogue: 0,0:15:38.98,0:15:40.84,Default,,0,0,0,,Kenapa berisik?
Dialogue: 0,0:15:40.84,0:15:42.67,Default,,0,0,0,,Pesanannya sudah selesai disiapkan.
Dialogue: 0,0:15:42.67,0:15:47.93,Default,,0,0,0,,Pelanggan bilang ikan tangkapanmu\Nsangat enak dan dia mau membelinya.
Dialogue: 0,0:15:47.93,0:15:49.58,Default,,0,0,0,,Harusnya kamu senang!
Dialogue: 0,0:15:49.58,0:15:52.07,Default,,0,0,0,,Berhenti mengobrol,\Ncepat kembali antarkan pesanan.
Dialogue: 0,0:15:52.07,0:15:53.81,Default,,0,0,0,,Iya, iya.
Dialogue: 0,0:15:57.44,0:15:59.44,Default,,0,0,0,,Kamu bebas pilih mau beli yang mana.
Dialogue: 0,0:16:01.63,0:16:02.86,Default,,0,0,0,,Maaf,
Dialogue: 0,0:16:02.86,0:16:06.07,Default,,0,0,0,,kita malah harus pulang dulu\Nmenaruh ikannya.
Dialogue: 0,0:16:06.07,0:16:09.24,Default,,0,0,0,,Begitu memikirkan akan\Nmakan masakan enak,
Dialogue: 0,0:16:09.24,0:16:11.53,Default,,0,0,0,,aku jadi ingin belanja lebih banyak lagi.
Dialogue: 0,0:16:12.58,0:16:14.03,Default,,0,0,0,,Aku akan buat banyak hidangan!
Dialogue: 0,0:16:14.66,0:16:15.83,Default,,0,0,0,,Kalau kamu buat gorengan,
Dialogue: 0,0:16:15.83,0:16:18.01,Default,,0,0,0,,tolong tambah saus tartar yang waktu itu.
Dialogue: 0,0:16:18.01,0:16:21.29,Default,,0,0,0,,Saat tadi makan ikan goreng,\Naku merasa ada yang kurang.
Dialogue: 0,0:16:22.40,0:16:25.38,Default,,0,0,0,,Sepertinya ada satu orang lagi\Nyang jadi tawanan saus tartar.
Dialogue: 0,0:16:25.38,0:16:26.78,Default,,0,0,0,,Itu sangat berbahaya!
Dialogue: 0,0:16:26.78,0:16:28.13,Default,,0,0,0,,Iya, kan?
Dialogue: 0,0:16:28.13,0:16:29.97,Default,,0,0,0,,Mayonesnya saja sudah berbahaya.
Dialogue: 0,0:16:29.97,0:16:32.81,Default,,0,0,0,,Ditambah aroma telur rebus\Ndan tekstur renyah dari bawang bombai!
Dialogue: 0,0:16:32.81,0:16:35.10,Default,,0,0,0,,Hentikan, jangan diteruskan lagi.
Dialogue: 0,0:16:35.10,0:16:37.73,Default,,0,0,0,,Aku jadi ingin memakannya\Nsampai membuat kepalaku pening.
Dialogue: 0,0:16:38.75,0:16:40.35,Default,,0,0,0,,Oh, ada Rin.
Dialogue: 0,0:16:40.35,0:16:41.36,Default,,0,0,0,,Pagi.
Dialogue: 0,0:16:41.36,0:16:44.86,Default,,0,0,0,,Aria, Ed, selamat pagi!
Dialogue: 0,0:16:45.72,0:16:47.65,Default,,0,0,0,,Kalian mencariku?
Dialogue: 0,0:16:47.65,0:16:51.82,Default,,0,0,0,,Kami bawa bekal dan tadinya\Nmau cari tempat buat makan.
Dialogue: 0,0:16:51.82,0:16:54.20,Default,,0,0,0,,Tapi tak dapat tempat yang nyaman.
Dialogue: 0,0:16:54.20,0:16:56.41,Default,,0,0,0,,Lalu saat kami diskusi...
Dialogue: 0,0:16:56.41,0:16:59.09,Default,,0,0,0,,Makan di dalam Mo terlalu nyaman.
Dialogue: 0,0:16:59.09,0:17:00.50,Default,,0,0,0,,Itu kesimpulan kami.
Dialogue: 0,0:17:00.50,0:17:04.32,Default,,0,0,0,,Beruntungnya kami melihat kamu\Nlalu ingin menyapamu!
Dialogue: 0,0:17:04.32,0:17:05.80,Default,,0,0,0,,Aku mengerti.
Dialogue: 0,0:17:05.80,0:17:09.59,Default,,0,0,0,,Sekarang aku jadi agak malas\Nkalau harus duduk makan di lantai.
Dialogue: 0,0:17:09.59,0:17:12.34,Default,,0,0,0,,Standar kita sekarang sudah tinggi.
Dialogue: 0,0:17:12.34,0:17:15.06,Default,,0,0,0,,Ini salahmu yang membuat kami seperti ini.
Dialogue: 0,0:17:15.71,0:17:16.93,Default,,0,0,0,,Maaf.
Dialogue: 0,0:17:16.93,0:17:21.23,Default,,0,0,0,,Ke depannya kalian bebas di dalam Mo.
Dialogue: 0,0:17:22.02,0:17:24.44,Default,,0,0,0,,Hiasan rambut ini indah, ya!
Dialogue: 0,0:17:25.13,0:17:26.98,Default,,0,0,0,,Ed yang membelikannya.
Dialogue: 0,0:17:26.98,0:17:28.39,Default,,0,0,0,,Aku melihatnya di pasar.
Dialogue: 0,0:17:28.39,0:17:30.45,Default,,0,0,0,,Kupikir ini sangat cocok untuk Aria.
Dialogue: 0,0:17:30.89,0:17:32.78,Default,,0,0,0,,Aku sudah bilang tidak perlu.
Dialogue: 0,0:17:32.78,0:17:35.91,Default,,0,0,0,,Aku ingin melihat Aria\Nmenjadi lebih imut!
Dialogue: 0,0:17:35.91,0:17:38.04,Default,,0,0,0,,Tentu saja setiap hari kamu sudah imut.
Dialogue: 0,0:17:38.04,0:17:40.79,Default,,0,0,0,,Tapi kamu yang berias beda cerita!
Dialogue: 0,0:17:40.79,0:17:45.39,Default,,0,0,0,,Oh, iya, penjual hiasan rambut itu\Ncerita padaku.
Dialogue: 0,0:17:45.39,0:17:47.92,Default,,0,0,0,,Sekitar sebulan lalu saat dia\Nbuka lapaknya di sini,
Dialogue: 0,0:17:47.92,0:17:51.63,Default,,0,0,0,,dia belum pernah diserang\Nmakhluk semacam monster.
Dialogue: 0,0:17:51.63,0:17:55.43,Default,,0,0,0,,Tapi, kali ini dia bertemu monster\Ndi tengah perjalanan kemari.
Dialogue: 0,0:17:55.43,0:17:57.85,Default,,0,0,0,,Urutannya memang terbalik.
Dialogue: 0,0:17:57.85,0:18:01.25,Default,,0,0,0,,Monster mulai muncul setelah\Npemanggilan Gadis Suci.
Dialogue: 0,0:18:01.25,0:18:04.16,Default,,0,0,0,,Sudah, jangan memikirkan\Nyang aneh-aneh dulu.
Dialogue: 0,0:18:04.57,0:18:05.27,Default,,0,0,0,,Apa?
Dialogue: 0,0:18:05.27,0:18:09.37,Default,,0,0,0,,Kita ke ibu kota untuk mengumpulkan\Ninformasi dan mencari kebenaran.
Dialogue: 0,0:18:09.37,0:18:12.45,Default,,0,0,0,,Bukankah lebih baik kita bahas lagi\Nsetelah informasinya terkumpul?
Dialogue: 0,0:18:12.45,0:18:14.00,Default,,0,0,0,,Setuju.
Dialogue: 0,0:18:14.00,0:18:15.57,Default,,0,0,0,,Kita akan tahu setelah ke sana.
Dialogue: 0,0:18:16.06,0:18:17.64,Default,,0,0,0,,Benar juga.
Dialogue: 0,0:18:20.37,0:18:21.96,Default,,0,0,0,,Oh, Senon!
Dialogue: 0,0:18:21.96,0:18:24.58,Default,,0,0,0,,Oh, kebetulan kita bertemu di sini.
Dialogue: 0,0:18:24.58,0:18:26.79,Default,,0,0,0,,Aku sudah bawa bekal sarapan.
Dialogue: 0,0:18:27.74,0:18:30.38,Default,,0,0,0,,Jangan bilang kamu kangen Mo juga?
Dialogue: 0,0:18:30.38,0:18:33.34,Default,,0,0,0,,Kalian juga berpikiran sama, ya?
Dialogue: 0,0:18:35.55,0:18:37.33,Default,,0,0,0,,Kamu belanja banyak, ya.
Dialogue: 0,0:18:37.33,0:18:39.05,Default,,0,0,0,,Ini semua untuk sarapan?
Dialogue: 0,0:18:39.05,0:18:41.85,Default,,0,0,0,,Iya, tapi aku akan menghabiskannya.
Dialogue: 0,0:18:41.85,0:18:43.27,Default,,0,0,0,,Serius?
Dialogue: 0,0:18:43.27,0:18:45.97,Default,,0,0,0,,Kita kan Meja Rakus.
Dialogue: 0,0:18:45.97,0:18:48.61,Default,,0,0,0,,Nama timnya sangat cocok\Nuntuk kita, kan?
Dialogue: 0,0:18:48.61,0:18:51.82,Default,,0,0,0,,Benar-benar nama yang cocok.
Dialogue: 0,0:18:54.28,0:18:56.32,Default,,0,0,0,,Halo, belanjanya sudah beres?
Dialogue: 0,0:18:56.32,0:18:58.16,Default,,0,0,0,,Tori?
Dialogue: 0,0:18:58.16,0:19:00.04,Default,,0,0,0,,Jangan ketus begitu.
Dialogue: 0,0:19:00.04,0:19:03.46,Default,,0,0,0,,Orang super sibuk sampai\Nmenyempatkan diri mencari kita.
Dialogue: 0,0:19:03.46,0:19:05.50,Default,,0,0,0,,Pasti akan bahas hal yang merepotkan.
Dialogue: 0,0:19:05.50,0:19:09.88,Default,,0,0,0,,Aku tahu kalian sedang persiapan,\Ntapi aku butuh bantuan kalian.
Dialogue: 0,0:19:09.88,0:19:11.28,Default,,0,0,0,,Lihat.
Dialogue: 0,0:19:11.28,0:19:13.34,Default,,0,0,0,,Kamu ingin mengutus kami\Nke serikat di Merlova?
Dialogue: 0,0:19:13.34,0:19:14.87,Default,,0,0,0,,Tebakanmu cukup akurat juga.
Dialogue: 0,0:19:14.87,0:19:16.62,Default,,0,0,0,,Yah, membahasnya di sini kurang nyaman.
Dialogue: 0,0:19:16.62,0:19:18.76,Default,,0,0,0,,Hal detailnya kita teruskan di dalam...
Dialogue: 0,0:19:20.60,0:19:23.31,Default,,0,0,0,,Tentu saja kita akan membahasnya\Nsambil makan.
Dialogue: 0,0:19:28.52,0:19:29.98,Default,,0,0,0,,Tebakanmu benar.
Dialogue: 0,0:19:29.98,0:19:32.61,Default,,0,0,0,,Aku ingin kalian mampir ke serikat\Ndi Merlova saat ke ibu kota
Dialogue: 0,0:19:32.61,0:19:34.78,Default,,0,0,0,,lalu menyerahkan dokumen ini pada mereka.
Dialogue: 0,0:19:34.78,0:19:35.90,Default,,0,0,0,,Sudah kuduga.
Dialogue: 0,0:19:35.90,0:19:39.37,Default,,0,0,0,,Skill Rin jauh lebih praktis\Ndaripada familiar pembawa pesan.
Dialogue: 0,0:19:39.37,0:19:42.12,Default,,0,0,0,,Tapi, aku tidak mau memanfaatkannya\Nseperti alat praktis.
Dialogue: 0,0:19:42.12,0:19:43.79,Default,,0,0,0,,Kalian akan dapat upah.
Dialogue: 0,0:19:43.79,0:19:46.29,Default,,0,0,0,,Saat ini aku juga sedang sangat sibuk.
Dialogue: 0,0:19:46.29,0:19:48.00,Default,,0,0,0,,Bisa bantu kami mengirimkannya?
Dialogue: 0,0:19:49.03,0:19:51.46,Default,,0,0,0,,Ville, aku tidak keberatan.
Dialogue: 0,0:19:51.46,0:19:53.13,Default,,0,0,0,,Rute yang kalian bicarakan kemarin,
Dialogue: 0,0:19:53.13,0:19:55.51,Default,,0,0,0,,akan melewati area sekitar Merlova juga.
Dialogue: 0,0:19:55.51,0:19:57.35,Default,,0,0,0,,Mampir ke sana tidak jadi masalah.
Dialogue: 0,0:19:58.77,0:20:01.22,Default,,0,0,0,,Tapi, bisa repot kalau\Ntelat beberapa hari di ibu kota...
Dialogue: 0,0:20:01.22,0:20:03.68,Default,,0,0,0,,Baiklah, kami terima misi ini!
Dialogue: 0,0:20:04.68,0:20:06.77,Default,,0,0,0,,Tunggu, jangan salah paham!
Dialogue: 0,0:20:06.77,0:20:08.60,Default,,0,0,0,,Aku tahu.
Dialogue: 0,0:20:08.60,0:20:10.77,Default,,0,0,0,,Mempertimbangkan situasi Tori saat ini,
Dialogue: 0,0:20:10.77,0:20:13.28,Default,,0,0,0,,telat beberapa hari ke ibu kota pun\Ntidak jadi masalah
Dialogue: 0,0:20:13.28,0:20:17.15,Default,,0,0,0,,dan sebaiknya bantu serikat\Nmenyelesaikan masalahnya dulu, kan?
Dialogue: 0,0:20:17.15,0:20:19.28,Default,,0,0,0,,I-Itu benar.
Dialogue: 0,0:20:19.28,0:20:20.60,Default,,0,0,0,,Terima kasih.
Dialogue: 0,0:20:20.60,0:20:23.25,Default,,0,0,0,,Aku sudah menduga\Nkamu pasti akan setuju.
Dialogue: 0,0:20:23.25,0:20:25.87,Default,,0,0,0,,Jadi, berapa upahnya?
Dialogue: 0,0:20:25.87,0:20:27.33,Default,,0,0,0,,Benar juga.
Dialogue: 0,0:20:27.33,0:20:29.33,Default,,0,0,0,,Mempertimbangkan skill Nona,
Dialogue: 0,0:20:29.33,0:20:32.12,Default,,0,0,0,,jumlahnya akan kutambah dari upah umum.
Dialogue: 0,0:20:32.12,0:20:34.51,Default,,0,0,0,,Rin, ayo ikut makan bersama.
Dialogue: 0,0:20:35.17,0:20:38.51,Default,,0,0,0,,Negosiasi upah itu tugasnya ketua.
Dialogue: 0,0:20:38.51,0:20:39.65,Default,,0,0,0,,Ayo.
Dialogue: 0,0:20:39.65,0:20:41.01,Default,,0,0,0,,Terima kasih.
Dialogue: 0,0:20:41.01,0:20:43.59,Default,,0,0,0,,Tapi, aku sudah sarapan...
Dialogue: 0,0:20:44.43,0:20:46.42,Default,,0,0,0,,Makanan penutup itu untuk perut samping.
Dialogue: 0,0:20:46.42,0:20:48.27,Default,,0,0,0,,Sepertinya begitu, ya.
Dialogue: 0,0:20:51.21,0:20:53.02,Default,,0,0,0,,Ini enak!
Dialogue: 0,0:20:53.02,0:20:55.82,Default,,0,0,0,,Rin, ini juga enak.
Dialogue: 0,0:20:55.82,0:20:57.69,Default,,0,0,0,,Itu bukan makanan penutup...
Dialogue: 0,0:21:00.66,0:21:02.66,Default,,0,0,0,,Kebab ini enak!
Dialogue: 0,0:21:02.66,0:21:04.23,Default,,0,0,0,,Iya, kan?
Dialogue: 0,0:21:04.23,0:21:05.91,Default,,0,0,0,,Mereka memanggangnya di depan toko.
Dialogue: 0,0:21:05.91,0:21:07.25,Default,,0,0,0,,Kami beli karena tertarik.
Dialogue: 0,0:21:07.25,0:21:09.96,Default,,0,0,0,,Bola keju ini juga enak.
Dialogue: 0,0:21:09.96,0:21:12.50,Default,,0,0,0,,Ini betulan dibuat dari terigu Mucci?
Dialogue: 0,0:21:12.50,0:21:15.25,Default,,0,0,0,,Iya, bahkan anak kecil pun bisa membuatnya.
Dialogue: 0,0:21:15.25,0:21:16.21,Default,,0,0,0,,Mau tahu caranya?
Dialogue: 0,0:21:16.21,0:21:17.51,Default,,0,0,0,,Jangan.
Dialogue: 0,0:21:17.51,0:21:19.80,Default,,0,0,0,,Di antara kita semua,\Ncuma dia yang tak bakat masak.
Dialogue: 0,0:21:19.80,0:21:22.04,Default,,0,0,0,,Kalian juga sama, kan?
Dialogue: 0,0:21:22.76,0:21:27.68,Default,,0,0,0,,Karena itu, aku tidak bisa membayangkan\Nhidup tanpa Rin lagi.
Dialogue: 0,0:21:29.79,0:21:32.48,Default,,0,0,0,,Intinya, pada perjalanan\Nke ibu kota kali ini,
Dialogue: 0,0:21:32.48,0:21:34.56,Default,,0,0,0,,kita akan mampir sebentar di Merlova.
Dialogue: 0,0:21:34.56,0:21:35.77,Default,,0,0,0,,Oke.
Dialogue: 0,0:21:35.77,0:21:37.40,Default,,0,0,0,,Itu ide bagus.
Dialogue: 0,0:21:37.40,0:21:39.82,Default,,0,0,0,,Merlova itu kotanya seperti apa?
Dialogue: 0,0:21:39.82,0:21:41.35,Default,,0,0,0,,Kota pegunungan berapi.
Dialogue: 0,0:21:41.35,0:21:44.07,Default,,0,0,0,,Terkenal akan masakan kukus\Ndan toko pandai besinya.
Dialogue: 0,0:21:44.07,0:21:45.62,Default,,0,0,0,,Di sana juga ada pemandian air panas.
Dialogue: 0,0:21:45.62,0:21:47.08,Default,,0,0,0,,Pemandian air panas.
Dialogue: 0,0:21:47.08,0:21:51.96,Default,,0,0,0,,Berendam sambil menikmati pemandangan malam!\NPasti nyaman!
Dialogue: 0,0:21:51.96,0:21:53.85,Default,,0,0,0,,Bagaimana kalau menginap dua atau tiga hari?
Dialogue: 0,0:21:53.85,0:21:55.67,Default,,0,0,0,,Itu tidak bisa.
Dialogue: 0,0:21:55.67,0:21:58.13,Default,,0,0,0,,Kita harus ke ibu kota\Nuntuk mengumpulkan informasi.
Dialogue: 0,0:21:58.13,0:22:00.92,Default,,0,0,0,,Jangan cari alasan saat menjalankan misi.
Dialogue: 0,0:22:00.92,0:22:02.15,Default,,0,0,0,,Baiklah.
Dialogue: 0,0:22:02.15,0:22:05.01,Default,,0,0,0,,Setelah menyerahkan dokumennya,\Nkita akan langsung ke ibu kota.
Dialogue: 0,0:22:09.03,0:22:12.34,Default,,0,0,0,,Nah, aku memulai perjalanan\Npanjang pertamaku.
Dialogue: 0,0:22:12.34,0:22:15.06,Default,,0,0,0,,Semoga tidak terjadi insiden di perjalanan.
Dialogue: 0,0:22:15.06,0:22:17.32,Default,,0,0,0,,Lalu, kalau sempat,
Dialogue: 0,0:22:17.32,0:22:21.15,Default,,0,0,0,,aku juga bisa mencicipi banyak\Nmakanan khas dan kuliner yang enak.
