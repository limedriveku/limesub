Dialogue: 0,0:00:18.83,0:00:24.30,sign,,0000,0000,0000,,WILD OX - BISA DIMAKAN: SANGAT LEZAT
Dialogue: 0,0:01:05.50,0:01:12.76,sign,,0000,0000,0000,,THE FORSAKEN SAINTESS\NAND HER FOODIE ROADTRIP IN ANOTHER WORLD
Dialogue: 0,0:02:12.99,0:02:14.89,sign,,0000,0000,0000,,EPISODE 5: KALIAN SEMUA!\NWAKTUNYA PESTA DAGING DUNGEON!
Dialogue: 0,0:23:35.02,0:23:39.36,sign,,0000,0000,0000,,EPISODE 6: BELUT LAUT MEMANG ENAK,\NTAPI AKU JUGA SUKA BELUT AIR TAWAR!
Dialogue: 0,0:00:01.19,0:00:05.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dungeon itu seperti isekai\Nyang terisolasi dari kenyataan.
Dialogue: 0,0:00:05.32,0:00:09.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hukum dunia nyata\Nsama sekali tidak berlaku di sini.
Dialogue: 0,0:00:09.81,0:00:14.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, wajar padang rumput\Nbisa ada di dungeon.
Dialogue: 0,0:00:14.37,0:00:15.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini tetap aneh, kan?
Dialogue: 0,0:00:15.87,0:00:18.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa bisa ada padang rumput\Ndi dalam gua?
Dialogue: 0,0:00:18.83,0:00:21.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, sapi itu terlalu besar!
Dialogue: 0,0:00:21.50,0:00:24.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan, itu Wild Ox!
Dialogue: 0,0:00:24.30,0:00:25.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sapi!
Dialogue: 0,0:00:25.42,0:00:27.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bisa mengalahkannya\Nhanya dengan mendesis!
Dialogue: 0,0:00:27.92,0:00:28.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hiss.
Dialogue: 0,0:00:28.93,0:00:31.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, begitu, ya?
Dialogue: 0,0:00:35.80,0:00:37.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhasil dikalahkan!
Dialogue: 0,0:00:37.10,0:00:38.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah.
Dialogue: 0,0:00:38.39,0:00:42.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa pun bisa terjadi di dalam dungeon, ya?
Dialogue: 0,0:02:14.89,0:02:17.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sirloin dan tulang T Wild Ox!
Dialogue: 0,0:02:17.95,0:02:20.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Komposisi daging dan lemaknya seimbang!
Dialogue: 0,0:02:20.66,0:02:23.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini memang daging sapi!
Dialogue: 0,0:02:23.79,0:02:25.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, eh!
Dialogue: 0,0:02:25.29,0:02:27.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa daging itu untukku?
Dialogue: 0,0:02:27.36,0:02:28.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini untuk semuanya.
Dialogue: 0,0:02:28.81,0:02:30.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau mengolahnya dulu.
Dialogue: 0,0:02:30.13,0:02:33.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nanti kita makan daging enak,\Njadi tunggu, ya.
Dialogue: 0,0:02:33.13,0:02:35.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku anak baik, bisa menunggu.
Dialogue: 0,0:02:35.51,0:02:36.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah.
Dialogue: 0,0:02:36.41,0:02:39.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untung saja drop item-nya\Nlangsung jadi potongan daging.
Dialogue: 0,0:02:39.76,0:02:41.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi tak perlu repot.
Dialogue: 0,0:02:41.27,0:02:45.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau satu ekor utuh tergeletak di sana,\Naku tidak yakin bisa memotongnya.
Dialogue: 0,0:02:45.14,0:02:48.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau cuma potong daging,\Naku juga bisa bantu.
Dialogue: 0,0:02:48.20,0:02:49.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:02:49.07,0:02:51.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau cuma potong daging.
Dialogue: 0,0:02:52.69,0:02:56.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa yang bilang kalau lihat orang tampan\Nbisa bosan setelah tiga hari?
Dialogue: 0,0:02:56.26,0:02:59.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tahan godaan kedipnya\Ndan balas obrolannya!
Dialogue: 0,0:03:01.04,0:03:01.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Airnya sudah matang.
Dialogue: 0,0:03:05.92,0:03:08.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu serius mau bantu potong?
Dialogue: 0,0:03:08.44,0:03:10.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari mana kamu tahu\Nteknik memotong daging?
Dialogue: 0,0:03:10.34,0:03:13.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami para elf juga disebut\Nsebagai penjaga hutan.
Dialogue: 0,0:03:13.46,0:03:16.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keseharian kami diharuskan\Nuntuk mahir berburu.
Dialogue: 0,0:03:16.43,0:03:17.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu.
Dialogue: 0,0:03:17.59,0:03:20.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, tapi kalau bisa potong daging,
Dialogue: 0,0:03:20.47,0:03:22.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}harusnya juga bisa sedikit memasak, kan?
Dialogue: 0,0:03:22.40,0:03:23.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hentikan.
Dialogue: 0,0:03:23.47,0:03:27.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Elf ini bisa membuat\Ndaging gosong tapi mentah.
Dialogue: 0,0:03:27.52,0:03:29.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gosong tapi mentah?
Dialogue: 0,0:03:29.19,0:03:32.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Situasi kontradiktif macam apa itu?
Dialogue: 0,0:03:32.02,0:03:35.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ed dan Aria juga,\Nlalu kamu yang pura-pura tenang juga
Dialogue: 0,0:03:35.64,0:03:39.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pernah membuat daging gosong tapi mentah.
Dialogue: 0,0:03:40.24,0:03:42.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daging mentah bukan masalah.
Dialogue: 0,0:03:42.16,0:03:43.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan tetap kumakan.
Dialogue: 0,0:03:43.70,0:03:48.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kamu pasti akan membuang\Nbagian gosongnya dulu.
Dialogue: 0,0:03:48.25,0:03:50.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu ini bicara apa, Rin?
Dialogue: 0,0:03:50.54,0:03:54.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami juga memotong bagian yang gosongnya\Nlalu menghabiskan semua daging sisanya.
Dialogue: 0,0:03:55.11,0:03:57.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memakan... daging mentah?
Dialogue: 0,0:03:57.84,0:03:58.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daging apa?
Dialogue: 0,0:03:58.89,0:04:01.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tergantung jenisnya, bisa bahaya!
Dialogue: 0,0:04:01.37,0:04:03.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baiklah, aku akan hati-hati.
Dialogue: 0,0:04:03.47,0:04:05.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, sekarang kita dibantu Rin.
Dialogue: 0,0:04:05.77,0:04:06.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:04:06.43,0:04:08.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masakan buatanmu\Nbisa kami makan dengan tenang.
Dialogue: 0,0:04:09.77,0:04:14.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya sejarah kelam makanan grup ini\Nlebih banyak dari yang kubayangkan.
Dialogue: 0,0:04:14.17,0:04:15.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami pulang.
Dialogue: 0,0:04:16.77,0:04:18.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang kembali.
Dialogue: 0,0:04:18.20,0:04:20.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kerja bagus atas eksplorasinya!
Dialogue: 0,0:04:20.32,0:04:22.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian bawa barang banyak, ya.
Dialogue: 0,0:04:22.91,0:04:25.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami sudah lama tidak kencan,
Dialogue: 0,0:04:25.20,0:04:28.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}saking serunya kami sampai lupa waktu.
Dialogue: 0,0:04:28.60,0:04:30.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami dapat banyak.
Dialogue: 0,0:04:30.37,0:04:33.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada banyak makanan enak.
Dialogue: 0,0:04:33.13,0:04:34.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untung besar.
Dialogue: 0,0:04:41.70,0:04:45.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan makan diam-diam,\Nnanti dimarahi Rin.
Dialogue: 0,0:04:47.42,0:04:50.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah kalian eksplorasi\Nsambil melawan banyak monster?
Dialogue: 0,0:04:50.33,0:04:51.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian tidak terluka?
Dialogue: 0,0:04:51.99,0:04:53.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami baik-baik saja.
Dialogue: 0,0:04:53.76,0:04:56.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah perhatian, ya, Rin.
Dialogue: 0,0:04:56.93,0:04:58.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah.
Dialogue: 0,0:04:58.19,0:04:59.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, Ville.
Dialogue: 0,0:04:59.49,0:05:01.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Monster yang muncul di tingkat ini
Dialogue: 0,0:05:01.73,0:05:04.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ternyata sama seperti Beruang Api itu.
Dialogue: 0,0:05:16.03,0:05:18.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penampilannya saja yang kuat?
Dialogue: 0,0:05:18.05,0:05:22.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak, kami berdua saja\Nmustahil bisa mengalahkan sebanyak ini.
Dialogue: 0,0:05:22.76,0:05:23.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:05:24.37,0:05:28.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua monster ini lemahnya tidak wajar\Ndan masih misteri.
Dialogue: 0,0:05:28.18,0:05:30.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau saja kita tahu penyebabnya.
Dialogue: 0,0:05:38.99,0:05:41.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, tempat ini luas, ya.
Dialogue: 0,0:05:41.95,0:05:44.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sulit membayangkan ini di dalam gua.
Dialogue: 0,0:05:44.66,0:05:48.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harusnya tidak sebesar ini.
Dialogue: 0,0:05:48.64,0:05:49.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:05:49.54,0:05:54.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harusnya tempat ini\Ndiberi sihir ilusi dan sihir ruang.
Dialogue: 0,0:05:54.50,0:05:57.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi tempat ini ilusi?
Dialogue: 0,0:05:57.00,0:05:58.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi bisa kita sentuh.
Dialogue: 0,0:05:58.71,0:06:01.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terlihat nyata juga.
Dialogue: 0,0:06:01.05,0:06:06.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin sihir ilusinya\Nsudah aktif lebih dulu
Dialogue: 0,0:06:06.37,0:06:09.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu sihir ruang mengubah tempat ini\Nmenjadi koridor tanpa ujung.
Dialogue: 0,0:06:09.56,0:06:11.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tebakanku begitu.
Dialogue: 0,0:06:12.06,0:06:16.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Artinya, tempat ini awalnya hanya\Nseukuran selembar kertas,
Dialogue: 0,0:06:16.61,0:06:18.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi ada yang menyambungkan\Nkedua ujung ruang ini,
Dialogue: 0,0:06:18.77,0:06:20.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan jadi seperti sebuah cincin atau bola.
Dialogue: 0,0:06:20.88,0:06:22.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kira-kira seperti itu.
Dialogue: 0,0:06:23.43,0:06:25.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, ke mana pun kita berjalan,
Dialogue: 0,0:06:25.99,0:06:28.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita akan kembali ke tempat semula?
Dialogue: 0,0:06:28.91,0:06:32.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena ada Aria,\Nkita tidak akan tersesat.
Dialogue: 0,0:06:32.58,0:06:35.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi bagi yang pertama kali ke sini\Npasti akan kebingungan.
Dialogue: 0,0:06:35.29,0:06:38.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aria, di sekitar sini ada tempat\Nyang jadi pusat mana?
Dialogue: 0,0:06:39.36,0:06:41.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada di beberapa tempat.
Dialogue: 0,0:06:41.17,0:06:43.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dihancurkan semuanya,\Nmungkin sihirnya bisa dibatalkan.
Dialogue: 0,0:06:47.26,0:06:49.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dihancurkan di tiap titik,
Dialogue: 0,0:06:49.29,0:06:52.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita bisa menemukan\Ntangga menuju lantai berikutnya?
Dialogue: 0,0:06:52.60,0:06:54.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serasa bermain RPG.
Dialogue: 0,0:06:56.88,0:06:58.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sana ada pusat mana.
Dialogue: 0,0:06:58.61,0:06:59.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rin.
Dialogue: 0,0:06:59.42,0:07:01.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tiba-tiba ada sesuatu langsung sembunyi
Dialogue: 0,0:07:01.24,0:07:03.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan persiapkan skill-mu.
Dialogue: 0,0:07:03.19,0:07:04.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!\NMiso.
Dialogue: 0,0:07:07.99,0:07:09.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gawat, cepat lari!
Dialogue: 0,0:07:11.79,0:07:12.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sial!
Dialogue: 0,0:07:17.42,0:07:19.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boneka sihir, ya?
Dialogue: 0,0:07:19.09,0:07:21.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang diutus malah makhluk merepotkan.
Dialogue: 0,0:07:21.30,0:07:22.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ro-Robot?
Dialogue: 0,0:07:27.51,0:07:30.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nya-Nyaris saja.
Dialogue: 0,0:07:30.22,0:07:31.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Barusan itu apa?
Dialogue: 0,0:07:31.79,0:07:34.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau kena, aku pasti sudah mati.
Dialogue: 0,0:07:34.31,0:07:35.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gomamiso, kamu tidak apa-apa?
Dialogue: 0,0:07:35.89,0:07:36.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu terluka?
Dialogue: 0,0:07:36.77,0:07:38.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak.
Dialogue: 0,0:07:38.27,0:07:41.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, aku kuat dan baik-baik saja.
Dialogue: 0,0:07:41.23,0:07:44.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya, kamu memang kuat, ya.
Dialogue: 0,0:07:46.43,0:07:47.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu,
Dialogue: 0,0:07:47.70,0:07:50.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}beraninya menyerang juru masak grup kami!
Dialogue: 0,0:07:50.95,0:07:52.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kubuat kalian menyesal!
Dialogue: 0,0:07:52.97,0:07:55.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tebuslah dengan kematian kalian!
Dialogue: 0,0:08:01.36,0:08:03.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ville, kamu lawan yang putih.
Dialogue: 0,0:08:03.42,0:08:06.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya sendi mereka kelemahannya.
Dialogue: 0,0:08:06.01,0:08:07.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ed, Aria.
Dialogue: 0,0:08:07.23,0:08:09.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jaring yang merah pakai benang.\NSerang dengan sihir petir.
Dialogue: 0,0:08:09.97,0:08:12.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa pun yang menginjak\Nharapan pangan kita,
Dialogue: 0,0:08:12.76,0:08:14.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}harus menerima akibatnya!
Dialogue: 0,0:08:14.22,0:08:15.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Benar!
Dialogue: 0,0:08:25.23,0:08:27.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ville mengayunkan pedangnya\Ndengan satu tangan,
Dialogue: 0,0:08:27.93,0:08:29.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi itu pedang dua tangan, kan?
Dialogue: 0,0:08:30.35,0:08:31.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang Aria lakukan itu...
Dialogue: 0,0:08:31.91,0:08:34.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan menjaring,\Ntapi menjadikannya kepompong.
Dialogue: 0,0:08:43.50,0:08:46.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ed melancarkan serangan petir\Ntegangan tinggi.
Dialogue: 0,0:08:46.67,0:08:52.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa dia pernah ikut latihan khusus\Noperator listrik tegangan tinggi?
Dialogue: 0,0:08:52.90,0:08:56.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senon malah tersenyum,\Ndan tubuhnya memancarkan aura biru gelap.
Dialogue: 0,0:08:56.64,0:08:58.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini hanya perasaanku saja?
Dialogue: 0,0:09:00.42,0:09:01.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesimpulannya,
Dialogue: 0,0:09:01.40,0:09:04.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mengusik makanan milik orang lain\Nbisa berakibat fatal.
Dialogue: 0,0:09:08.57,0:09:10.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rin, kamu tidak terluka?
Dialogue: 0,0:09:10.40,0:09:13.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak apa-apa,\Nuntung saja tadi aku sempat masuk.
Dialogue: 0,0:09:13.74,0:09:15.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pasti takut, ya?
Dialogue: 0,0:09:15.33,0:09:16.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah...
Dialogue: 0,0:09:16.45,0:09:18.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka tiba-tiba muncul dan menyerang,
Dialogue: 0,0:09:18.12,0:09:20.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi aku agak terkejut.
Dialogue: 0,0:09:20.00,0:09:22.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang tampan membantuku turun dari mobil.
Dialogue: 0,0:09:23.54,0:09:26.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih.
Dialogue: 0,0:09:26.42,0:09:28.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rin, kamu baik-baik saja?
Dialogue: 0,0:09:30.30,0:09:33.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, aku kurang teliti memeriksanya.
Dialogue: 0,0:09:33.01,0:09:34.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa, aku tidak terluka.
Dialogue: 0,0:09:35.71,0:09:38.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah, Aria, Rin hampir gepeng.
Dialogue: 0,0:09:38.31,0:09:40.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebaiknya lepaskan dia.
Dialogue: 0,0:09:40.60,0:09:43.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rin, aku terlalu meremehkan dungeon ini.
Dialogue: 0,0:09:43.73,0:09:46.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf sudah membuatmu takut.
Dialogue: 0,0:09:47.29,0:09:48.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan begitu.
Dialogue: 0,0:09:48.40,0:09:50.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pada akhirnya, aku tidak terluka.
Dialogue: 0,0:09:50.84,0:09:53.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selama semuanya baik-baik saja,\Nitu sudah cukup.
Dialogue: 0,0:09:53.51,0:09:54.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga ikut salah.
Dialogue: 0,0:09:54.72,0:09:59.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian sedang sibuk menaklukkan dungeon\Ndan malah mencemaskanku.
Dialogue: 0,0:10:01.67,0:10:04.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana cara mencairkan suasana ini, ya?
Dialogue: 0,0:10:05.90,0:10:08.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, karena kita sudah\Nmenangani pusat mana-nya,
Dialogue: 0,0:10:08.56,0:10:10.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}harusnya area ini sudah aman, kan?
Dialogue: 0,0:10:10.92,0:10:13.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau kita makan siang?
Dialogue: 0,0:10:13.01,0:10:15.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan memasak hidangan besar
Dialogue: 0,0:10:15.05,0:10:16.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan membantu memulihkan tenaga kalian!
Dialogue: 0,0:10:16.76,0:10:18.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Makan siang?
Dialogue: 0,0:10:21.56,0:10:24.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang rakus tak kuat\Nmenahan godaan makanan enak.
Dialogue: 0,0:10:24.00,0:10:26.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kali ini aku, Iblis Makanan, menang lagi!
Dialogue: 0,0:10:27.92,0:10:31.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Steik dan daging panggang yang dibuat\Ndari daging tulang T Wild Ox.
Dialogue: 0,0:10:31.78,0:10:33.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini festival daging!
Dialogue: 0,0:10:36.00,0:10:39.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih pada dunia ini\Nkarena hari ini aku masih bisa makan.
Dialogue: 0,0:10:39.24,0:10:41.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat makan!
Dialogue: 0,0:10:44.90,0:10:46.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Empuk!
Dialogue: 0,0:10:46.33,0:10:48.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tingkat kematangannya pas sekali.
Dialogue: 0,0:10:48.79,0:10:50.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagian luarnya dipanggang sampai renyah,
Dialogue: 0,0:10:50.61,0:10:52.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi bagian dalamnya masih terasa empuk.
Dialogue: 0,0:10:52.62,0:10:56.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kira daging bagian seperti tenderloin\Nkalau dipanggang akan alot.
Dialogue: 0,0:10:56.14,0:10:59.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata bisa jadi empuk dan berair begini.
Dialogue: 0,0:10:59.18,0:11:02.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aroma menteganya sampai meresap\Nke dalam daging, ya.
Dialogue: 0,0:11:02.73,0:11:04.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sirloinnya juga sangat enak.
Dialogue: 0,0:11:04.64,0:11:07.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lemak manisnya meleleh di ujung lidah!
Dialogue: 0,0:11:14.03,0:11:15.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aria selalu bilang
Dialogue: 0,0:11:15.20,0:11:18.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalau makan makanan enak\Nsambil membuka mulut,
Dialogue: 0,0:11:18.16,0:11:19.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aromanya akan hilang.
Dialogue: 0,0:11:19.85,0:11:21.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu dia jarang makan sambil mengobrol!
Dialogue: 0,0:11:21.79,0:11:23.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia juga pernah bilang
Dialogue: 0,0:11:23.16,0:11:27.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak mau makanan enaknya dihabiskan\Norang lain karena sibuk mengobrol.
Dialogue: 0,0:11:27.04,0:11:29.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia juga pernah bilang,\Ndaripada mengobrol,
Dialogue: 0,0:11:29.04,0:11:30.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lebih baik makan yang banyak.
Dialogue: 0,0:11:30.92,0:11:32.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, kan?
Dialogue: 0,0:11:32.77,0:11:35.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak bilang begitu!
Dialogue: 0,0:11:39.29,0:11:42.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik Rin maupun masakan yang dia buat,\Naku sangat menyukainya!
Dialogue: 0,0:11:42.35,0:11:43.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih sudah bergabung.
Dialogue: 0,0:11:44.58,0:11:48.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga senang\Nbisa menjadi bagian dari kalian!
Dialogue: 0,0:11:51.34,0:11:54.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daging panggangnya juga enak!
Dialogue: 0,0:11:54.03,0:11:56.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Empuk dan berair.
Dialogue: 0,0:11:58.64,0:12:02.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sensasi menggigit lapisan daging\Nyang tipis membuat ketagihan.
Dialogue: 0,0:12:02.33,0:12:05.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku, lebih suka menggulung dagingnya.
Dialogue: 0,0:12:05.65,0:12:08.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Digulung tebal lalu memakannya sekaligus.
Dialogue: 0,0:12:08.62,0:12:10.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu bagus!
Dialogue: 0,0:12:17.93,0:12:19.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, tinggal satu lagi.
Dialogue: 0,0:12:24.67,0:12:27.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemandangan di sekitarnya\Nsudah banyak berubah, ya?
Dialogue: 0,0:12:27.48,0:12:28.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi berantakan.
Dialogue: 0,0:12:28.81,0:12:30.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa karena kita menghancurkan pusat mana-nya
Dialogue: 0,0:12:30.98,0:12:33.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan ilusinya tak bisa bertahan lagi?
Dialogue: 0,0:12:34.13,0:12:35.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sana.
Dialogue: 0,0:12:40.10,0:12:42.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak terasa tinggal satu masalah lagi, ya?
Dialogue: 0,0:12:43.41,0:12:46.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Grup kami memang kuat.
Dialogue: 0,0:12:49.48,0:12:52.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ngantuk.
Dialogue: 0,0:12:52.04,0:12:54.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Miso, kamu terlalu santai.
Dialogue: 0,0:12:55.07,0:12:56.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aria.
Dialogue: 0,0:12:56.27,0:12:59.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seberapa jauh pusat mana\Nyang terakhir itu dari sini?
Dialogue: 0,0:12:59.71,0:13:01.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekitar satu jam.
Dialogue: 0,0:13:01.80,0:13:04.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu pun kalau tidak salah rute.
Dialogue: 0,0:13:04.72,0:13:07.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski kita sudah cukup memahami\Naturan di tempat ini,
Dialogue: 0,0:13:07.63,0:13:09.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}teleportasi paksa ini tetap merepotkan.
Dialogue: 0,0:13:09.98,0:13:12.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa karena kita tak menyadarinya
Dialogue: 0,0:13:12.98,0:13:15.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan tiba-tiba diteleportasi ke tempat lain?
Dialogue: 0,0:13:15.94,0:13:18.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, jebakan seperti ini merepotkan.
Dialogue: 0,0:13:18.03,0:13:23.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau di gim, momen seperti ini\Nbiasanya akan ada serangan, kan?
Dialogue: 0,0:13:24.56,0:13:26.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi teringat trauma di gim dulu.
Dialogue: 0,0:13:26.87,0:13:28.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rin, kamu tidak apa-apa?
Dialogue: 0,0:13:28.70,0:13:30.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kelihatan pucat.
Dialogue: 0,0:13:31.98,0:13:33.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak apa-apa.
Dialogue: 0,0:13:33.13,0:13:35.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya teringat beberapa hal\Nyang tidak menyenangkan.
Dialogue: 0,0:13:35.54,0:13:37.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita sudah dapat petunjuk.
Dialogue: 0,0:13:37.59,0:13:38.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu khawatir.
Dialogue: 0,0:13:38.71,0:13:39.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:13:39.92,0:13:42.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, sepertinya tak akan ada\Nmonster kuat yang muncul.
Dialogue: 0,0:13:42.55,0:13:45.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu benar, tapi tetap tak boleh lengah.
Dialogue: 0,0:13:45.76,0:13:48.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harus teliti dan pastikan\Ntidak ada jebakan lagi.
Dialogue: 0,0:13:48.88,0:13:49.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:13:49.56,0:13:50.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita pergi.
Dialogue: 0,0:13:52.17,0:13:55.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya sangat perhatian\Ndan membuatku tak enak!
Dialogue: 0,0:13:55.15,0:13:58.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf malah selalu memikirkan\Nhal yang aneh-aneh.
Dialogue: 0,0:13:59.51,0:14:01.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hal yang bisa kulakukan di situasi ini
Dialogue: 0,0:14:02.39,0:14:06.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}adalah mengolah semua monster yang kutemui\Nmenjadi makanan lezat!
Dialogue: 0,0:14:07.94,0:14:10.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu Prajurit Goblin dan Penyihir Goblin.
Dialogue: 0,0:14:10.66,0:14:13.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah sampai sejauh ini,\Nternyata muncul ras fantasi baru, ya?
Dialogue: 0,0:14:13.87,0:14:16.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi tadi aku bilang akan mengolahnya\Njadi makanan lezat...
Dialogue: 0,0:14:16.94,0:14:18.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kalau jenisnya begini...
Dialogue: 0,0:14:19.25,0:14:21.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, mereka harusnya tak bisa dimakan.
Dialogue: 0,0:14:22.34,0:14:25.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Matilah!
Dialogue: 0,0:14:28.64,0:14:30.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Minggir!
Dialogue: 0,0:14:30.08,0:14:31.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisakah jangan menghalangi kami?
Dialogue: 0,0:14:51.60,0:14:53.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini pusat mana terakhir?
Dialogue: 0,0:15:03.72,0:15:04.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luas!
Dialogue: 0,0:15:04.88,0:15:07.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata tempat ini malah kosong\Ntak ada apa pun!
Dialogue: 0,0:15:07.43,0:15:09.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu ilusinya hilang,\Nsemuanya kembali seperti semula.
Dialogue: 0,0:15:09.81,0:15:10.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ruangan seluas ini,
Dialogue: 0,0:15:10.91,0:15:14.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bahkan untuk berkeliling sekali saja\Nakan memakan waktu yang lama.
Dialogue: 0,0:15:14.28,0:15:16.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini belum waktunya untuk istirahat,
Dialogue: 0,0:15:16.63,0:15:18.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi kita sudah eksplorasi cukup lama.
Dialogue: 0,0:15:25.20,0:15:26.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lantai satu, gua.
Dialogue: 0,0:15:26.83,0:15:28.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lantai dua, padang rumput,
Dialogue: 0,0:15:28.10,0:15:29.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lebih tepatnya, ruangan di dalam ruangan.
Dialogue: 0,0:15:29.99,0:15:32.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kira-kira seperti apa lantai berikutnya?
Dialogue: 0,0:15:32.62,0:15:33.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Entahlah.
Dialogue: 0,0:15:33.88,0:15:35.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejujurnya,
Dialogue: 0,0:15:35.33,0:15:39.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dungeon yang lingkungannya berubah acak\Ndi setiap lantai itu cukup langka.
Dialogue: 0,0:15:39.17,0:15:41.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sulit untuk bisa memastikannya.
Dialogue: 0,0:15:42.29,0:15:45.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dungeon ini aneh, ya.
Dialogue: 0,0:15:45.04,0:15:47.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jebakannya merepotkan,
Dialogue: 0,0:15:47.58,0:15:50.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi monsternya tidak begitu kuat.
Dialogue: 0,0:15:50.40,0:15:54.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah dungeon ini\Ntidak masuk kategori mematikan?
Dialogue: 0,0:15:56.89,0:15:58.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Miso, kamu kenapa?
Dialogue: 0,0:15:58.52,0:16:00.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya dingin.
Dialogue: 0,0:16:00.31,0:16:01.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dingin?
Dialogue: 0,0:16:08.95,0:16:10.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tingkatkan kewaspadaan saat turun.
Dialogue: 0,0:16:10.44,0:16:11.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:16:25.07,0:16:26.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Penuh salju!
Dialogue: 0,0:16:28.73,0:16:30.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sebelah sana ada bangunan.
Dialogue: 0,0:16:35.89,0:16:37.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Betulan ada.
Dialogue: 0,0:16:37.10,0:16:38.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa sebaiknya kita ke sana?
Dialogue: 0,0:16:38.49,0:16:39.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dingin.
Dialogue: 0,0:16:40.17,0:16:43.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, tubuhmu sangat hangat.
Dialogue: 0,0:16:43.27,0:16:44.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makin tinggi suhu tubuhnya,
Dialogue: 0,0:16:44.81,0:16:47.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}anginnya makin terasa dingin.
Dialogue: 0,0:16:47.61,0:16:49.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu.
Dialogue: 0,0:16:49.03,0:16:52.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pantas saja kucing suka meringkuk\Ndi bawah meja penghangat.
Dialogue: 0,0:16:52.60,0:16:53.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aria?
Dialogue: 0,0:16:54.08,0:16:55.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aria!
Dialogue: 0,0:16:55.08,0:16:56.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aria, kamu tidak apa-apa?
Dialogue: 0,0:16:57.89,0:16:59.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dingin.
Dialogue: 0,0:17:00.12,0:17:02.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita istirahat dulu di dalam Mo!
Dialogue: 0,0:17:09.03,0:17:11.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aria, boleh sentuh tanganmu sebentar?
Dialogue: 0,0:17:16.95,0:17:18.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa tangannya begini?
Dialogue: 0,0:17:18.14,0:17:19.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dingin seperti es.
Dialogue: 0,0:17:22.41,0:17:25.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tangan Rin hangat sekali.
Dialogue: 0,0:17:25.27,0:17:29.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suhu tubuhku selalu seperti musim panas.
Dialogue: 0,0:17:29.04,0:17:33.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suhu tanganku kurang cocok untuk membuat\Nadonan seperti pai atau scone.
Dialogue: 0,0:17:34.32,0:17:37.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, saat kamu memijatnya\Ndengan lembut begini,
Dialogue: 0,0:17:37.59,0:17:39.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tubuhku jadi tenang.
Dialogue: 0,0:17:43.67,0:17:45.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rin, terima kasih.
Dialogue: 0,0:17:45.64,0:17:47.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aria memang tak kuat terhadap dingin,
Dialogue: 0,0:17:47.67,0:17:49.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku tidak menyangka separah ini.
Dialogue: 0,0:17:49.44,0:17:50.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.
Dialogue: 0,0:17:50.37,0:17:52.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku senang teknik pijat\Nyang kupelajari dulu
Dialogue: 0,0:17:52.47,0:17:53.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa membantu.
Dialogue: 0,0:17:54.29,0:17:57.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, situasi ini\Nsepertinya agak tidak biasa.
Dialogue: 0,0:17:57.73,0:18:00.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sebenarnya tak ada prasangka buruk,
Dialogue: 0,0:18:00.18,0:18:02.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}konon serangga\Ntidak tahan terhadap dingin.
Dialogue: 0,0:18:02.93,0:18:05.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa manusia laba-laba\Njuga lemah terhadap dingin?
Dialogue: 0,0:18:07.26,0:18:09.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya salju ini tidak akan berhenti, ya?
Dialogue: 0,0:18:09.83,0:18:11.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita amati saja dulu.
Dialogue: 0,0:18:13.32,0:18:15.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, semuanya,
Dialogue: 0,0:18:15.25,0:18:17.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa tunggu sebentar di sini?
Dialogue: 0,0:18:17.74,0:18:20.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari kita buat beberapa alat penghangat!
Dialogue: 0,0:18:21.38,0:18:22.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini?
Dialogue: 0,0:18:22.35,0:18:23.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini hia hitam.
Dialogue: 0,0:18:23.79,0:18:26.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memetiknya di hutan dulu.
Dialogue: 0,0:18:26.50,0:18:29.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awalnya kupikir ini bisa dipakai\Nuntuk membuat moxa.
Dialogue: 0,0:18:29.49,0:18:32.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Moxa?\NApa itu?
Dialogue: 0,0:18:32.48,0:18:36.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alat medis yang bisa menghangatkan tubuh.
Dialogue: 0,0:18:36.26,0:18:38.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Juga termasuk bahan terapi pijat.
Dialogue: 0,0:18:40.04,0:18:44.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belum pernah dengar nama itu\Ndi desa elf maupun di kota.
Dialogue: 0,0:18:44.35,0:18:47.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan Senon\Nyang berumur panjang pun tidak tahu?
Dialogue: 0,0:18:48.80,0:18:52.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya di dunia ini tidak ada moxa.
Dialogue: 0,0:18:53.60,0:18:55.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Moxa dibuat dari serat halus ini,
Dialogue: 0,0:18:55.64,0:18:58.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yaitu bagian serat halusnya.
Dialogue: 0,0:18:58.03,0:18:59.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya dari serat halusnya?
Dialogue: 0,0:18:59.45,0:19:00.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:19:00.27,0:19:04.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, buatan orang awam tak akan sehalus\Ndan serapi yang dijual di toko.
Dialogue: 0,0:19:04.83,0:19:06.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Alat medis yang tidak dikenal.
Dialogue: 0,0:19:06.17,0:19:08.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sangat menarik!
Dialogue: 0,0:19:08.00,0:19:10.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau tidak keberatan,\Nbisa bantu aku membuatnya?
Dialogue: 0,0:19:10.80,0:19:13.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin bisa dibuat menjadi\Nkantong kompres panas.
Dialogue: 0,0:19:16.66,0:19:18.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama, hancurkan daunnya.
Dialogue: 0,0:19:19.50,0:19:22.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, tuangkan ke saringan untuk disaring.
Dialogue: 0,0:19:23.08,0:19:24.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buang bagian yang kotor,
Dialogue: 0,0:19:26.10,0:19:27.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu tuang ke atas kain.
Dialogue: 0,0:19:29.09,0:19:30.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selesai!
Dialogue: 0,0:19:32.13,0:19:34.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi ini moxa?
Dialogue: 0,0:19:34.11,0:19:36.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hasil olahan tumpukan hia hitam\Nyang banyak tadi
Dialogue: 0,0:19:36.28,0:19:38.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadinya hanya sekecil ini.
Dialogue: 0,0:19:38.16,0:19:41.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, kalau dari hasil\Nterlihat tidak sebanding.
Dialogue: 0,0:19:41.98,0:19:44.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya, campurkan lagi\Ngaram batu, kulit jeruk,
Dialogue: 0,0:19:44.96,0:19:47.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan rumput liar.
Dialogue: 0,0:19:47.17,0:19:49.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita masukkan ke oven untuk dipanaskan.
Dialogue: 0,0:19:52.78,0:19:54.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Panas...
Dialogue: 0,0:19:54.84,0:19:57.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, bungkus dengan kain tebal.
Dialogue: 0,0:19:58.30,0:19:59.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah jadi!
Dialogue: 0,0:20:00.39,0:20:03.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hangatkan di bagian yang tadi dipijat.
Dialogue: 0,0:20:05.33,0:20:08.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini hangat dan wangi.
Dialogue: 0,0:20:08.52,0:20:10.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyaman.
Dialogue: 0,0:20:13.18,0:20:15.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hidup kembali.
Dialogue: 0,0:20:17.86,0:20:19.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah!
Dialogue: 0,0:20:19.49,0:20:21.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aria!
Dialogue: 0,0:20:21.31,0:20:24.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ed, kamu berlebihan.
Dialogue: 0,0:20:24.24,0:20:26.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya...
Dialogue: 0,0:20:27.15,0:20:28.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Sebelum berangkat\N- Syukurlah.
Dialogue: 0,0:20:28.12,0:20:30.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- kusiapkan satu hal lagi untuk kalian.\N- Syukurlah.
Dialogue: 0,0:20:30.86,0:20:32.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Susu karamel hangat!
Dialogue: 0,0:20:34.78,0:20:36.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kelihatannya enak!
Dialogue: 0,0:20:36.47,0:20:40.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mari hangatkan dulu tubuh kita\Nlalu lawan hawa dingin!
Dialogue: 0,0:20:40.70,0:20:41.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya!
Dialogue: 0,0:20:48.71,0:20:49.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salju semua!
Dialogue: 0,0:20:50.67,0:20:52.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sampai terpisah.
Dialogue: 0,0:20:52.36,0:20:54.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:21:16.57,0:21:17.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempat ini...
Dialogue: 0,0:21:17.63,0:21:19.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini?
Dialogue: 0,0:21:24.14,0:21:25.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu kuil?
Dialogue: 0,0:21:25.85,0:21:28.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bangunannya terlihat megah,
Dialogue: 0,0:21:28.85,0:21:30.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi di tengah salju begini
Dialogue: 0,0:21:30.10,0:21:31.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kesannya agak menakutkan.
Dialogue: 0,0:21:31.55,0:21:34.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekilas lihat saja sudah mencurigakan.
Dialogue: 0,0:21:36.38,0:21:37.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita masuk dengan hati-hati.
