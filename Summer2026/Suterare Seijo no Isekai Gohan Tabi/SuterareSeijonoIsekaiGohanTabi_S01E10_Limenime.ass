Dialogue: 0,0:00:57.12,0:01:03.71,sign,,0000,0000,0000,,THE FORSAKEN SAINTESS\NAND HER FOODIE ROADTRIP IN ANOTHER WORLD
Dialogue: 0,0:02:02.98,0:02:05.98,sign,,0000,0000,0000,,EPISODE 10: HAHA, SAATNYA SAUS TARTAR LAGI\N(YANG KEDUA KALINYA SETELAH LIMA EPISODE)
Dialogue: 0,0:14:38.36,0:14:39.65,sign,,0000,0000,0000,,DISTRIK ADMINISTRATIF, PERUMAHAN ELITE
Dialogue: 0,0:14:39.65,0:14:42.44,sign,,0000,0000,0000,,DISTRIK BAWAH KOTA
Dialogue: 0,0:21:10.96,0:21:22.30,sign,,0000,0000,0000,,NOBARA NO OTOME
Dialogue: 0,0:23:34.98,0:23:39.90,sign,,0000,0000,0000,,EPISODE 11: ROTI LAPIS KUBA TENGAH MALAM\NADALAH RASA DOSA
Dialogue: 0,0:00:00.61,0:00:04.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak hanya dapat berkat\Ndari Roh Usil Pembawa Berkah.
Dialogue: 0,0:00:04.86,0:00:08.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menaklukkan dungeon di perjalanan\Nsekaligus menjinakkan penjaga labirin,
Dialogue: 0,0:00:08.40,0:00:12.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bahkan berteman dengan naga purba.
Dialogue: 0,0:00:12.95,0:00:14.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal dia baru tiba di sini,
Dialogue: 0,0:00:14.91,0:00:17.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pengalamannya sudah mengesankan.
Dialogue: 0,0:00:17.37,0:00:19.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selalu menuruti keinginan orang,\Ngadis itu pasti lelah.
Dialogue: 0,0:00:19.87,0:00:21.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.
Dialogue: 0,0:00:21.00,0:00:22.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin dia menikmatinya.
Dialogue: 0,0:00:24.38,0:00:26.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga jadi tidak sabar.
Dialogue: 0,0:00:26.17,0:00:28.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ingin segera bertemu denganmu.
Dialogue: 0,0:00:29.59,0:00:31.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Gadis Suci yang ditelantarkan.
Dialogue: 0,0:02:05.98,0:02:06.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar.
Dialogue: 0,0:02:06.90,0:02:08.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tujuan awal kita hanya mengantarkan pesan,
Dialogue: 0,0:02:08.90,0:02:11.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tidak disangka malah terjadi\Nbanyak hal di Merlova.
Dialogue: 0,0:02:11.28,0:02:13.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan anggap enteng begitu.
Dialogue: 0,0:02:13.49,0:02:16.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat kamu diculik naga,\Nkami sangat terkejut.
Dialogue: 0,0:02:16.66,0:02:18.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami sampai panik.
Dialogue: 0,0:02:18.45,0:02:21.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan pernah tinggalkan aku lagi!
Dialogue: 0,0:02:21.83,0:02:23.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, aku akan lebih berhati-hati.
Dialogue: 0,0:02:23.75,0:02:25.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, sebentar lagi kita sampai di ibu kota.
Dialogue: 0,0:02:25.88,0:02:28.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin terjadi masalah lagi, kan?
Dialogue: 0,0:02:28.09,0:02:29.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rin, ini gawat!
Dialogue: 0,0:02:29.71,0:02:30.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ville?
Dialogue: 0,0:02:30.71,0:02:32.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini situasi darurat!
Dialogue: 0,0:02:32.05,0:02:33.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa berhenti sebentar?
Dialogue: 0,0:02:33.55,0:02:34.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:02:36.34,0:02:38.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu...
Dialogue: 0,0:02:38.14,0:02:41.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Singkatnya, dari jendela mobil\Nkamu melihat gerombolan monster
Dialogue: 0,0:02:41.47,0:02:43.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yang disebut Burung Kabut
Dialogue: 0,0:02:43.68,0:02:45.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan ingin menangkap beberapa ekor?
Dialogue: 0,0:02:45.56,0:02:46.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:02:46.48,0:02:49.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa pun bisa terjadi\Nsebelum kita tiba ke ibu kota.
Dialogue: 0,0:02:49.44,0:02:52.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus siaga perbekalan makanan.
Dialogue: 0,0:02:53.03,0:02:53.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu...
Dialogue: 0,0:02:53.90,0:02:57.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi Aria bilang hari ini harusnya\Nkita bisa sampai di ibu kota.
Dialogue: 0,0:02:57.99,0:02:59.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti sampai.
Dialogue: 0,0:03:00.45,0:03:01.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ville,
Dialogue: 0,0:03:01.74,0:03:06.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kenapa setelah bertekad pergi ke ibu kota,\Nkamu malah ragu dan enggan?
Dialogue: 0,0:03:06.00,0:03:08.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berhenti bersikap seperti ini.
Dialogue: 0,0:03:09.21,0:03:12.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong, seperti apa\Nmonster Burung Kabut itu?
Dialogue: 0,0:03:12.84,0:03:14.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu pernah lihat jamur, kan?
Dialogue: 0,0:03:14.72,0:03:17.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka bulat seperti jamur
Dialogue: 0,0:03:17.64,0:03:20.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi punya kaki dan paruh burung.
Dialogue: 0,0:03:20.64,0:03:22.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka burung yang tak bisa terbang.
Dialogue: 0,0:03:22.77,0:03:24.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi gerakannya gesit.
Dialogue: 0,0:03:24.77,0:03:28.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bulat dan tidak bisa terbang,\Ntapi larinya cepat...
Dialogue: 0,0:03:28.19,0:03:30.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kedengarannya cukup menarik.
Dialogue: 0,0:03:30.61,0:03:33.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namanya Burung Jamur,
Dialogue: 0,0:03:33.19,0:03:35.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi dagingnya segar, tidak enek,\Ndan rasa gurihnya kuat.
Dialogue: 0,0:03:35.61,0:03:36.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak.
Dialogue: 0,0:03:38.87,0:03:43.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya juru masak Meja Rakus kita\Ntertarik pada Burung Kabut.
Dialogue: 0,0:03:43.08,0:03:45.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, aku akan\Nmenangkap beberapa ekor.
Dialogue: 0,0:03:48.42,0:03:51.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia kabur.
Dialogue: 0,0:03:52.34,0:03:55.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, barusan kalian bahas daging, ya?
Dialogue: 0,0:03:55.59,0:03:57.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hei, aku mau makan daging!
Dialogue: 0,0:03:57.38,0:04:01.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia selalu kabur\Nbegitu situasi sedang genting.
Dialogue: 0,0:04:03.31,0:04:04.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi,
Dialogue: 0,0:04:04.68,0:04:07.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kenapa Ville enggan pergi ke ibu kota?
Dialogue: 0,0:04:07.27,0:04:10.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa alasannya sampai tak mau\Nmenemui kakaknya sendiri?
Dialogue: 0,0:04:10.48,0:04:12.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Rin.
Dialogue: 0,0:04:12.11,0:04:14.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ville juga punya masalahnya sendiri.
Dialogue: 0,0:04:14.03,0:04:16.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa, tak perlu minta maaf.
Dialogue: 0,0:04:16.39,0:04:19.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, sekarang sudah terlambat\Nuntuk berangkat.
Dialogue: 0,0:04:19.11,0:04:21.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini kita makan malam di sini saja.
Dialogue: 0,0:04:21.68,0:04:22.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yakin tidak apa-apa?
Dialogue: 0,0:04:22.74,0:04:28.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di ibu kota seharusnya ada\Ninformasi baru tentang Gadis Suci.
Dialogue: 0,0:04:28.37,0:04:31.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya aku juga ingin tahu soal itu,
Dialogue: 0,0:04:31.21,0:04:34.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku juru masak Meja Rakus!
Dialogue: 0,0:04:34.67,0:04:36.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rin memang hebat.
Dialogue: 0,0:04:36.63,0:04:38.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selalu positif.
Dialogue: 0,0:04:39.05,0:04:41.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku suka sikapmu yang begitu.
Dialogue: 0,0:04:41.30,0:04:43.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menempel di dada.
Dialogue: 0,0:04:43.14,0:04:45.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga mau.\NAku juga mau dipeluk!
Dialogue: 0,0:04:45.39,0:04:48.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serangan ganda dari wanita cantik\Ndan makhluk berbulu.
Dialogue: 0,0:04:48.23,0:04:52.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rin, untuk hal ini, kita harus diskusi\Nuntuk menyelesaikannya.
Dialogue: 0,0:04:52.65,0:04:53.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya,
Dialogue: 0,0:04:53.98,0:04:57.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}malam ini aku akan buat\Nbanyak saus tartar.
Dialogue: 0,0:04:57.03,0:04:58.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Saus tartar?\N- Saus tartar?
Dialogue: 0,0:05:00.99,0:05:03.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saus tartar... sungguh mengerikan.
Dialogue: 0,0:05:04.99,0:05:07.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat, aku panen besar.
Dialogue: 0,0:05:09.04,0:05:11.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata benar ada gerombolan Burung Kabut.
Dialogue: 0,0:05:11.87,0:05:14.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kukira kamu hanya cari alasan.
Dialogue: 0,0:05:14.29,0:05:16.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian tidak percaya padaku, ya?
Dialogue: 0,0:05:16.13,0:05:18.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku terkadang kabur dari masalah,
Dialogue: 0,0:05:18.63,0:05:20.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi aku tak pernah bohong.
Dialogue: 0,0:05:20.83,0:05:23.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia mengaku kalau dia kabur.
Dialogue: 0,0:05:23.14,0:05:25.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu hebat, Ville.
Dialogue: 0,0:05:25.26,0:05:28.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan ini, kita bisa bebas melakukan itu.
Dialogue: 0,0:05:28.08,0:05:29.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang mana?
Dialogue: 0,0:05:29.48,0:05:31.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pesta gorengan.
Dialogue: 0,0:05:32.35,0:05:35.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Me-Mendengarnya saja sudah menggugah hati.
Dialogue: 0,0:05:36.02,0:05:38.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu, kalau buat gorengan...
Dialogue: 0,0:05:38.73,0:05:41.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita bisa menikmati saus tartar sepuasnya.
Dialogue: 0,0:05:42.03,0:05:43.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:05:43.07,0:05:45.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Daging hidangan utama juga sudah siap.
Dialogue: 0,0:05:45.53,0:05:47.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita mulai memasak.
Dialogue: 0,0:05:51.41,0:05:54.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi ini daging Burung Kabut?
Dialogue: 0,0:05:54.38,0:05:57.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tekstur dagingnya kenyal, ya.
Dialogue: 0,0:05:57.00,0:05:59.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu juga menyiapkan\Nbanyak bahan makanan, ya.
Dialogue: 0,0:05:59.59,0:06:01.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini ikan trout susu sisa sebelumnya,
Dialogue: 0,0:06:01.67,0:06:04.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu jamur dan kentang\Nyang dibeli di Merlova.
Dialogue: 0,0:06:04.80,0:06:07.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau digoreng, ini akan lembut dan enak.
Dialogue: 0,0:06:07.97,0:06:10.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya, kita siapkan hidangan utama.
Dialogue: 0,0:06:10.56,0:06:13.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini yang tempo hari kita makan di Merlova?
Dialogue: 0,0:06:13.02,0:06:14.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:06:14.02,0:06:17.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, rasanya agak berbeda\Ndari kabayaki kemarin.
Dialogue: 0,0:06:17.48,0:06:20.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang kita pakai saus mentega\Ndan kecap asin.
Dialogue: 0,0:06:22.40,0:06:24.82,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aromanya membuat kami tak sabar.
Dialogue: 0,0:06:24.82,0:06:26.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, kan?
Dialogue: 0,0:06:26.24,0:06:29.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perbedaan terbesar dari sebelumnya adalah
Dialogue: 0,0:06:30.20,0:06:33.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku mengisinya dengan banyak keju!
Dialogue: 0,0:06:33.37,0:06:35.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mentega dengan keju?
Dialogue: 0,0:06:35.21,0:06:38.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kecapnya perlahan meresap\Nke campuran karbo dan lemak ini.
Dialogue: 0,0:06:38.94,0:06:42.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kalian bisa menahan\Naroma terlarang ini?
Dialogue: 0,0:06:43.17,0:06:46.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aromanya sangat menodai kesucian...\NDewa, tolong aku.
Dialogue: 0,0:06:46.51,0:06:49.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rin itu iblis, tapi aku suka padanya!
Dialogue: 0,0:06:51.68,0:06:56.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selagi onigiri masih dipanggang,
Dialogue: 0,0:06:56.40,0:06:59.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mari siapkan gorengan andalan hari ini.
Dialogue: 0,0:07:01.15,0:07:03.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aroma dan suaranya membuatku lapar.
Dialogue: 0,0:07:03.65,0:07:04.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku paham itu.
Dialogue: 0,0:07:05.36,0:07:09.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya gorengan saja rasanya sudah enak.
Dialogue: 0,0:07:09.33,0:07:11.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, gorengannya akan kubuat banyak.
Dialogue: 0,0:07:11.45,0:07:13.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya, tolong siapkan yang lain.
Dialogue: 0,0:07:17.21,0:07:20.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, pesta gorengan dan onigiri panggang
Dialogue: 0,0:07:20.46,0:07:21.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}resmi dimulai!
Dialogue: 0,0:07:24.03,0:07:26.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asyik, gorengannya banyak.
Dialogue: 0,0:07:26.43,0:07:28.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Goma.
Dialogue: 0,0:07:28.34,0:07:32.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa? Mana yang lebih penting?\NAku atau gorengan?
Dialogue: 0,0:07:32.31,0:07:36.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dibandingkan dengan gorengan\Nyang baru matang, harusnya gorengan...
Dialogue: 0,0:07:36.73,0:07:38.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan memukulku, Gomamiso.
Dialogue: 0,0:07:40.40,0:07:41.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Panas!
Dialogue: 0,0:07:41.98,0:07:43.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagian dalamnya panas!
Dialogue: 0,0:07:49.45,0:07:51.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Enak.\N- Hebat!
Dialogue: 0,0:07:51.08,0:07:53.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aroma gurih mentega\Ndan kecap di permukaannya,
Dialogue: 0,0:07:53.95,0:07:57.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dipadukan dengan keju leleh\Nyang kaya rasa dan nasi hangat!
Dialogue: 0,0:07:57.37,0:08:00.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya sangat enak\Nmeski panas di mulut!
Dialogue: 0,0:08:00.71,0:08:03.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keju panasnya hampir membakar bibirku!
Dialogue: 0,0:08:03.55,0:08:06.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, luka kecil ini tak akan\Nmenghentikanku untuk makan.
Dialogue: 0,0:08:06.80,0:08:08.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak!
Dialogue: 0,0:08:08.34,0:08:11.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lidahku sakit karena terbakar,
Dialogue: 0,0:08:11.30,0:08:12.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi rasanya sangat enak.
Dialogue: 0,0:08:12.81,0:08:14.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kecap asin, mentega, keju.
Dialogue: 0,0:08:14.85,0:08:16.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasa asinnya jelas berbeda,
Dialogue: 0,0:08:16.81,0:08:20.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi semuanya menyatu sempurna\Ndengan manisnya nasi putih.
Dialogue: 0,0:08:20.06,0:08:23.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi ini potensi nasi putih\Nyang tak terbatas?
Dialogue: 0,0:08:23.07,0:08:25.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengar!
Dialogue: 0,0:08:25.07,0:08:28.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga suka onigiri yang banyak keju.
Dialogue: 0,0:08:28.40,0:08:31.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, makan gorengannya selagi panas!
Dialogue: 0,0:08:31.49,0:08:32.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk bumbunya,
Dialogue: 0,0:08:32.45,0:08:34.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ada saus gorengan, kecap asin,\Nlemon, garam,
Dialogue: 0,0:08:34.70,0:08:37.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan juga saus tartar.
Dialogue: 0,0:08:38.40,0:08:40.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua kondimennya sangat menggoda,
Dialogue: 0,0:08:40.62,0:08:42.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi suapan pertama tetap harus...
Dialogue: 0,0:08:42.25,0:08:43.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Dicocol dengan ini!\N- Aku pilih ini!
Dialogue: 0,0:08:51.34,0:08:54.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak.
Dialogue: 0,0:08:56.10,0:08:58.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Renyah dan garing seperti inilah\Nesensi dari gorengan!
Dialogue: 0,0:08:58.73,0:09:02.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, Daging Burung Kabut-nya juga enak!
Dialogue: 0,0:09:02.31,0:09:04.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasa dagingnya cukup ringan,
Dialogue: 0,0:09:04.23,0:09:07.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi itu sangat cocok dicocol\Ndengan saus tartar!
Dialogue: 0,0:09:07.99,0:09:10.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga mau makan!
Dialogue: 0,0:09:10.28,0:09:13.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya sangat mirip jamur mewah.
Dialogue: 0,0:09:13.28,0:09:17.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat dikunyah, rasa gurihnya terus\Nkeluar dari dalam serat daging.
Dialogue: 0,0:09:17.24,0:09:18.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain Burung Kabut,
Dialogue: 0,0:09:18.95,0:09:23.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ikan trout susu goreng juga cocok\Ndicocol dengan saus tartar.
Dialogue: 0,0:09:23.21,0:09:25.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak hanya itu,
Dialogue: 0,0:09:25.42,0:09:29.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sayuran seperti jamur dan kentang juga\Nsangat cocok dengan saus tartar.
Dialogue: 0,0:09:29.13,0:09:32.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asalkan sayurannya digoreng\Ndan dicocol saus tartar,
Dialogue: 0,0:09:32.30,0:09:34.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebanyak apa pun pasti bisa kumakan.
Dialogue: 0,0:09:42.31,0:09:43.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak!
Dialogue: 0,0:09:43.73,0:09:44.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi,
Dialogue: 0,0:09:44.52,0:09:45.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}panas!
Dialogue: 0,0:09:45.90,0:09:48.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya sangat enak,\Ntapi lidahku terbakar di dalam!
Dialogue: 0,0:09:49.69,0:09:51.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah pelan-pelan mengunyahnya,
Dialogue: 0,0:09:51.57,0:09:54.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi sekarang mulutku perih\Ndan sudah tidak kuat lagi...
Dialogue: 0,0:09:54.66,0:09:56.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebal!
Dialogue: 0,0:09:56.08,0:09:58.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal masih bisa makan banyak...
Dialogue: 0,0:09:58.87,0:10:01.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aria, jangan menangis!
Dialogue: 0,0:10:01.25,0:10:03.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita Meja Rakus,
Dialogue: 0,0:10:03.04,0:10:06.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bagaimana bisa kalah\Ncuma karena kepedasan?
Dialogue: 0,0:10:07.59,0:10:09.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cure Up.
Dialogue: 0,0:10:10.97,0:10:14.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lidahku sudah tidak sakit lagi.
Dialogue: 0,0:10:15.01,0:10:16.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:10:16.39,0:10:17.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak perlu cemas.
Dialogue: 0,0:10:17.64,0:10:19.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atas nama dewaku,
Dialogue: 0,0:10:19.47,0:10:22.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}selama sihir dan makanannya belum habis,\Nkalian akan terus kusembuhkan.
Dialogue: 0,0:10:22.52,0:10:25.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sihir penyembuh cuma\Nuntuk luka bakar di dalam mulut?
Dialogue: 0,0:10:25.23,0:10:26.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senon memang hebat.
Dialogue: 0,0:10:26.56,0:10:29.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selalu bisa menggunakan sihir\Ndi saat yang tepat.
Dialogue: 0,0:10:29.11,0:10:32.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan alkemis sihir sepertiku\Nharus mengakui kehebatannya!
Dialogue: 0,0:10:32.57,0:10:35.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang, kita bisa terus makan.
Dialogue: 0,0:10:35.16,0:10:36.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak.
Dialogue: 0,0:10:36.03,0:10:38.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini juga berkat dewa.
Dialogue: 0,0:10:42.41,0:10:44.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata bisa menyembuhkan sambil makan,
Dialogue: 0,0:10:44.92,0:10:47.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}isekai memang hebat.
Dialogue: 0,0:10:47.54,0:10:51.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hari ini, lupakan soal kalori dan karbo.
Dialogue: 0,0:10:51.63,0:10:53.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nasi panggang kecap harum menggoda,
Dialogue: 0,0:10:53.36,0:10:54.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}keju kaya rasa dan meleleh,
Dialogue: 0,0:10:54.80,0:10:56.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}serta gorengan\Nyang dicocol penuh saus tartar.
Dialogue: 0,0:10:57.20,0:10:59.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa yang bisa tetap tenang\Nmenghadapi kombinasi sehebat ini?
Dialogue: 0,0:11:00.26,0:11:01.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan terus menggoreng.
Dialogue: 0,0:11:01.89,0:11:03.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya, makanlah sepuasnya.
Dialogue: 0,0:11:03.73,0:11:05.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Baik.\N- Hore!
Dialogue: 0,0:11:10.94,0:11:13.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Usai pesta gorengan, badan jadi hangat.
Dialogue: 0,0:11:13.61,0:11:16.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Angin malam begini juga bikin sejuk, ya.
Dialogue: 0,0:11:16.16,0:11:17.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:11:17.24,0:11:20.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kamu ingin bicara berdua denganku?
Dialogue: 0,0:11:20.37,0:11:23.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya ingin bilang,\Nmaaf sudah merepotkanmu.
Dialogue: 0,0:11:24.37,0:11:26.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa tiba-tiba bicara begitu?
Dialogue: 0,0:11:26.46,0:11:28.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makan malam tadi
Dialogue: 0,0:11:28.33,0:11:32.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebenarnya untuk menyemangatiku\Nyang ragu-ragu, kan?
Dialogue: 0,0:11:33.71,0:11:37.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimanapun, aku hanya bisa memasak.
Dialogue: 0,0:11:38.01,0:11:40.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rin, kamu punya saudara?
Dialogue: 0,0:11:40.97,0:11:44.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Punya, satu adik laki-laki\Ndan satu adik perempuan.
Dialogue: 0,0:11:44.52,0:11:47.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, jadi kamu anak pertama.
Dialogue: 0,0:11:47.60,0:11:51.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begini...\NKalau adik laki-lakimu kabur dari rumah,
Dialogue: 0,0:11:51.52,0:11:53.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu suatu hari tiba-tiba pulang,
Dialogue: 0,0:11:53.36,0:11:55.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa kamu akan marah?
Dialogue: 0,0:11:55.40,0:11:58.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, jadi itu yang kamu cemaskan?
Dialogue: 0,0:11:58.16,0:12:00.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kira dia tidak ingin bertemu\Ndengan kakak tirinya.
Dialogue: 0,0:12:00.53,0:12:05.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hubungan antarpribadi yang rumit\Ndan masalah soal pewaris.
Dialogue: 0,0:12:05.00,0:12:08.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata dia hanya merasa\Nsudah membuat kakaknya khawatir,
Dialogue: 0,0:12:08.04,0:12:10.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan merasa tidak enak hati padanya.
Dialogue: 0,0:12:12.25,0:12:14.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau aku, pasti masih marah pada adikku.
Dialogue: 0,0:12:14.80,0:12:16.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin akan memarahinya habis-habisan
Dialogue: 0,0:12:16.42,0:12:19.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan menanyainya\Nke mana saja dia selama ini.
Dialogue: 0,0:12:19.01,0:12:20.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pikir juga begitu.
Dialogue: 0,0:12:20.30,0:12:24.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kalau dia ingin pulang,\Naku akan tetap senang.
Dialogue: 0,0:12:24.01,0:12:25.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:12:25.43,0:12:27.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga.
Dialogue: 0,0:12:27.31,0:12:28.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti begitu.
Dialogue: 0,0:12:30.42,0:12:32.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena kamu bilang bertemu\Nkeluarga akan senang,
Dialogue: 0,0:12:32.77,0:12:35.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}apa kamu tidak ingin kembali\Nke dunia asalmu?
Dialogue: 0,0:12:35.99,0:12:37.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga...
Dialogue: 0,0:12:37.99,0:12:42.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejujurnya, saat ini aku belum\Nmemikirkan ingin kembali.
Dialogue: 0,0:12:42.28,0:12:43.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu.
Dialogue: 0,0:12:43.62,0:12:46.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja aku rindu keluargaku,
Dialogue: 0,0:12:46.70,0:12:50.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi prioritasku saat ini mengungkap\Nmisteri Pemanggilan Gadis Suci.
Dialogue: 0,0:12:51.42,0:12:52.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rin, kamu...
Dialogue: 0,0:12:52.67,0:12:56.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Intinya, itu juga salah satu alasannya.
Dialogue: 0,0:12:56.09,0:12:58.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, aku juga perlahan\Nmulai menyukai dunia ini.
Dialogue: 0,0:12:59.05,0:13:00.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena telanjur bertemu kalian semua,
Dialogue: 0,0:13:00.88,0:13:03.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku jadi ingin menikmati dunia ini\Nbersama kalian.
Dialogue: 0,0:13:04.85,0:13:06.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kesannya yang kupikirkan\Ncuma bersenang-senang.
Dialogue: 0,0:13:06.91,0:13:08.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi malu.
Dialogue: 0,0:13:09.44,0:13:11.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu memang begitu.
Dialogue: 0,0:13:11.06,0:13:12.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,
Dialogue: 0,0:13:12.44,0:13:15.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}agar kamu bisa bebas menikmati dunia ini,
Dialogue: 0,0:13:15.69,0:13:18.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kali ini aku harus membulatkan tekad.
Dialogue: 0,0:13:18.69,0:13:21.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malam ini aku akan kirim merpati pos.
Dialogue: 0,0:13:21.41,0:13:24.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mengabari dia bahwa kita\Nakan tiba di ibu kota besok.
Dialogue: 0,0:13:24.20,0:13:25.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kakakku orangnya sangat sibuk,
Dialogue: 0,0:13:25.78,0:13:28.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}paling telat dua hari lagi\Nkita bisa menemuinya.
Dialogue: 0,0:13:28.54,0:13:29.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu.
Dialogue: 0,0:13:30.21,0:13:33.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bertemu saudara saja harus janjian dulu.
Dialogue: 0,0:13:33.21,0:13:35.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan kakaknya orang penting?
Dialogue: 0,0:13:35.71,0:13:38.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, mereka saudara tiri\Ndan ada masalah warisan yang rumit.
Dialogue: 0,0:13:39.54,0:13:43.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau hal seperti ini muncul di cerita fantasi,\Nbiasanya kakaknya Ville orangnya...
Dialogue: 0,0:13:44.34,0:13:46.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, jangan asal menebak.
Dialogue: 0,0:13:54.61,0:13:56.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tembok kotanya tinggi sekali.
Dialogue: 0,0:13:56.57,0:13:58.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rin, selamat datang
Dialogue: 0,0:13:58.65,0:14:02.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di Surbrun, ibu kota Kerajaan Risfield.
Dialogue: 0,0:14:09.83,0:14:12.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sini ramai sekali, ya.
Dialogue: 0,0:14:12.16,0:14:13.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, ada banyak bunga.
Dialogue: 0,0:14:13.42,0:14:14.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aromanya manis.
Dialogue: 0,0:14:14.83,0:14:15.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:14:15.96,0:14:18.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau Elrage kota bata dan plester,
Dialogue: 0,0:14:18.38,0:14:21.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Surbrun kota yang dibangun\Ndari batu dan bunga.
Dialogue: 0,0:14:22.30,0:14:23.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rin, ke sini.
Dialogue: 0,0:14:23.93,0:14:25.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, maaf.
Dialogue: 0,0:14:25.55,0:14:27.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berdiri di tengah jalan itu\Nmengganggu orang.
Dialogue: 0,0:14:27.97,0:14:29.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain pusat kota,
Dialogue: 0,0:14:29.81,0:14:32.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}daerah pusat kota bagian bawah sana\Nagak mirip dengan Elrage.
Dialogue: 0,0:14:32.81,0:14:35.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada banyak restoran dan stan makanan enak.
Dialogue: 0,0:14:35.69,0:14:37.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Surbrun berpusat di istana,
Dialogue: 0,0:14:37.52,0:14:38.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ke arah luar adalah
Dialogue: 0,0:14:38.36,0:14:39.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}distrik administratif,
Dialogue: 0,0:14:39.65,0:14:42.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}perumahan elite, dan distrik bawah kota.
Dialogue: 0,0:14:42.44,0:14:44.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian tahu banyak hal, ya.
Dialogue: 0,0:14:44.99,0:14:49.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kalian familier dengan ibu kota?
Dialogue: 0,0:14:49.49,0:14:51.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, aku belum cerita, ya.
Dialogue: 0,0:14:51.45,0:14:55.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami, Meja Rakus,\Nawalnya bermarkas di Surbrun.
Dialogue: 0,0:14:55.50,0:14:56.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:14:56.83,0:14:58.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, banyak hal terjadi.
Dialogue: 0,0:14:58.79,0:15:01.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Suatu hari,\NVille memutuskan kabur dari rumah.
Dialogue: 0,0:15:01.50,0:15:03.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sebabnya kami memindahkan\Nmarkas ke Elrage.
Dialogue: 0,0:15:03.67,0:15:06.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perjalanan pindahan itu sangat melelahkan.
Dialogue: 0,0:15:06.64,0:15:09.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk kebutuhan makanan, kami kesulitan.
Dialogue: 0,0:15:09.81,0:15:12.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, saat itu kami\Ntidak punya skill memasakmu.
Dialogue: 0,0:15:12.60,0:15:13.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh.
Dialogue: 0,0:15:13.56,0:15:16.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti kalian semua\Nsudah kenal dari dulu, ya?
Dialogue: 0,0:15:16.19,0:15:20.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sebabnya meski Ville ragu-ragu,\Nmereka tidak tega menegurnya?
Dialogue: 0,0:15:21.20,0:15:22.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Intinya begitu.
Dialogue: 0,0:15:22.61,0:15:26.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kami tahu beberapa restoran enak\Nyang mungkin kamu suka.
Dialogue: 0,0:15:27.66,0:15:28.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serius?
Dialogue: 0,0:15:28.78,0:15:30.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga mau makan!
Dialogue: 0,0:15:30.66,0:15:34.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rekomendasi terbaikku adalah sate\Ndi Penginapan Treant Berjalan.
Dialogue: 0,0:15:34.29,0:15:37.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku suka ayam panggang utuh\Ndi Gadis Zamrud.
Dialogue: 0,0:15:37.70,0:15:41.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau rekomendasiku,\Nrebusan di Debu Bintang Perak.
Dialogue: 0,0:15:41.25,0:15:43.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak.\NKalau mau makan rebusan,
Dialogue: 0,0:15:43.80,0:15:45.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ekor Beruang Besar lebih cocok.
Dialogue: 0,0:15:47.43,0:15:48.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ville?
Dialogue: 0,0:15:48.43,0:15:50.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, rencana perjalanan harus diubah.
Dialogue: 0,0:15:50.97,0:15:53.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya dia sudah tak sabar menunggu.
Dialogue: 0,0:15:53.93,0:15:56.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, ini baru hari pertama.
Dialogue: 0,0:15:56.56,0:15:58.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rencana perjalanan sudah diubah secepat ini?
Dialogue: 0,0:15:58.85,0:16:01.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti dia sangat ingin bertemu denganmu.
Dialogue: 0,0:16:01.40,0:16:02.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar populer.
Dialogue: 0,0:16:02.61,0:16:04.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sangat dicintai, ya.
Dialogue: 0,0:16:31.01,0:16:34.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini terhubung dengan jalur rahasia menuju\Ntoko-toko di distrik bawah kota.
Dialogue: 0,0:16:34.56,0:16:36.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan, ini...
Dialogue: 0,0:16:36.48,0:16:40.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, belum waktunya untuk menyimpulkan.
Dialogue: 0,0:16:40.10,0:16:42.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tiba-tiba memelukku sangat erat.
Dialogue: 0,0:16:42.19,0:16:45.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau mau memeluk\Nlebih erat lagi juga boleh.
Dialogue: 0,0:16:45.98,0:16:47.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan gugup.
Dialogue: 0,0:16:47.53,0:16:50.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Intinya, minta maaf dengan patuh,\Ndan masalahnya selesai.
Dialogue: 0,0:16:51.03,0:16:54.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, yang penting jujur saja.
Dialogue: 0,0:16:54.24,0:16:57.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, sebenarnya dia sangat ramah.
Dialogue: 0,0:16:57.37,0:17:01.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan dibahas lagi,\Nnanti malah bertolak belakang.
Dialogue: 0,0:17:01.08,0:17:03.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selanjutnya kita naik tangga.
Dialogue: 0,0:17:03.42,0:17:05.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hati-hati saat melangkah.
Dialogue: 0,0:17:05.42,0:17:06.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baik.
Dialogue: 0,0:17:08.22,0:17:10.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rin, kamu baik-baik saja?
Dialogue: 0,0:17:10.26,0:17:12.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku masih sanggup.
Dialogue: 0,0:17:12.97,0:17:14.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Petualang memang hebat.
Dialogue: 0,0:17:14.93,0:17:17.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Usia kami sebaya 30-an,\Ntapi aku sudah lelah duluan.
Dialogue: 0,0:17:23.98,0:17:25.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku buka pintunya.
Dialogue: 0,0:17:35.41,0:17:38.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah lama menunggu kalian.
Dialogue: 0,0:17:38.37,0:17:40.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Halo.
Dialogue: 0,0:17:40.12,0:17:42.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak kusangka kamu akan\Nkhusus menyambut kami,
Dialogue: 0,0:17:42.79,0:17:43.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gwen.
Dialogue: 0,0:17:43.71,0:17:44.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:17:44.58,0:17:48.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimanapun,\NAnda sudah lama tidak pulang.
Dialogue: 0,0:17:48.17,0:17:50.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Ed, Nona Aria, Tuan Senon,
Dialogue: 0,0:17:50.94,0:17:52.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kalian bertiga juga baik-baik saja,\Nsyukurlah.
Dialogue: 0,0:17:52.93,0:17:55.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Muda Ville telah banyak\Nmerepotkan kalian.
Dialogue: 0,0:17:55.55,0:17:57.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan memanggilku Tuan Muda.
Dialogue: 0,0:17:57.56,0:18:01.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih juga sudah datang, Nona Rin.
Dialogue: 0,0:18:01.94,0:18:03.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanpa membuang waktu,
Dialogue: 0,0:18:03.15,0:18:06.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisakah Anda bertemu dulu\Ndengan Tuan Noah?
Dialogue: 0,0:18:07.32,0:18:08.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:18:08.57,0:18:10.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, silakan masuk.
Dialogue: 0,0:18:10.11,0:18:12.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Rin dipersilakan masuk sendiri.
Dialogue: 0,0:18:12.86,0:18:14.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa hanya Rin yang boleh masuk?
Dialogue: 0,0:18:14.87,0:18:18.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tuan Noah ingin berbicara langsung\Ndengan Nona Rin
Dialogue: 0,0:18:18.87,0:18:21.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sebagai orang yang terlibat\Ndalam Pemanggilan Gadis Suci.
Dialogue: 0,0:18:21.79,0:18:22.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:18:22.62,0:18:27.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa Anda mengira Tuan Noah\Nakan menyakiti Nona Rin?
Dialogue: 0,0:18:27.29,0:18:28.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau itu...
Dialogue: 0,0:18:28.30,0:18:29.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu,
Dialogue: 0,0:18:29.25,0:18:33.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mohon tinggalkan kucing familiar Anda\Ndi ruang tunggu.
Dialogue: 0,0:18:33.63,0:18:35.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, dia tidak boleh ikut masuk?
Dialogue: 0,0:18:35.72,0:18:37.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meskipun dia familiar,
Dialogue: 0,0:18:37.01,0:18:39.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ada beberapa hal yang sebaiknya\Ntidak boleh dia ketahui.
Dialogue: 0,0:18:39.97,0:18:41.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mohon kerja samanya.
Dialogue: 0,0:18:43.44,0:18:44.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:18:44.56,0:18:47.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Miso, tunggu aku di sini, ya.
Dialogue: 0,0:18:47.44,0:18:48.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa?
Dialogue: 0,0:18:48.44,0:18:51.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa tidak mengajakku?
Dialogue: 0,0:18:51.61,0:18:52.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gomamiso.
Dialogue: 0,0:18:52.99,0:18:54.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, bersabarlah.
Dialogue: 0,0:18:54.57,0:18:56.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rin, kuserahkan padamu.
Dialogue: 0,0:18:56.87,0:18:57.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:18:59.12,0:19:02.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Permisi, namaku Rin.
Dialogue: 0,0:19:02.00,0:19:04.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan, langsung masuk saja.
Dialogue: 0,0:19:10.92,0:19:15.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya adikku tersayang\Nsudah banyak merepotkanmu.
Dialogue: 0,0:19:15.01,0:19:17.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, aku juga merepotkannya.
Dialogue: 0,0:19:17.76,0:19:20.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, wajar kalau kamu gugup.
Dialogue: 0,0:19:20.43,0:19:22.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiba-tiba dipanggil ke kota kerajaan.
Dialogue: 0,0:19:22.85,0:19:24.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kota kerajaan?
Dialogue: 0,0:19:24.48,0:19:27.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, Ville tidak memberitahumu?
Dialogue: 0,0:19:27.81,0:19:30.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini ibu kota kerajaan, Surbrun,
Dialogue: 0,0:19:30.07,0:19:32.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan juga pusat politik Risfield,
Dialogue: 0,0:19:32.98,0:19:34.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kota Surbrun.
Dialogue: 0,0:19:36.03,0:19:37.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan kata lain...
Dialogue: 0,0:19:37.53,0:19:40.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senang bertemu denganmu, Nona Gadis Suci.
Dialogue: 0,0:19:40.28,0:19:42.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namaku Noah Surbrun.
Dialogue: 0,0:19:42.54,0:19:44.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kakak tiri Ville
Dialogue: 0,0:19:44.45,0:19:46.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan juga raja negeri ini.
Dialogue: 0,0:19:47.50,0:19:50.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku cuma asal menduga,\Ntapi dugaanku malah benar!
Dialogue: 0,0:19:50.71,0:19:53.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu kaget begitu.
Dialogue: 0,0:19:53.21,0:19:56.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya pekerja kantoran biasa.
Dialogue: 0,0:19:56.01,0:19:58.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, meski pekerja kantoran...
Dialogue: 0,0:19:58.01,0:19:59.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pekerja kantoran?
Dialogue: 0,0:19:59.01,0:20:00.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Barusan Anda bilang pekerja kantoran?
Dialogue: 0,0:20:02.26,0:20:04.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lebih baik aku perkenalkan diri lagi.
Dialogue: 0,0:20:04.18,0:20:07.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senang bertemu denganmu,\NNona Pelintas Dunia Lain.
Dialogue: 0,0:20:07.10,0:20:09.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku adalah reinkarnator dunia lain.
Dialogue: 0,0:20:13.44,0:20:15.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Re-Reinkarnator?
Dialogue: 0,0:20:15.11,0:20:17.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi Anda seorang reinkarnator?
Dialogue: 0,0:20:17.03,0:20:19.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nama asliku Yamamoto Takumi.
Dialogue: 0,0:20:19.74,0:20:21.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku meninggal di usia 34 tahun,
Dialogue: 0,0:20:21.87,0:20:23.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mantan pekerja kantoran biasa.
Dialogue: 0,0:20:23.91,0:20:25.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat itu aku sedang lembur,
Dialogue: 0,0:20:25.37,0:20:27.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kelelahan, dan tiba-tiba pingsan...
Dialogue: 0,0:20:27.83,0:20:30.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu setelah sadar,\Naku sudah lahir di dunia ini.
Dialogue: 0,0:20:30.21,0:20:31.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sampai kaget!
Dialogue: 0,0:20:31.84,0:20:34.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Rin juga harus hati-hati,\Njangan terlalu lelah.
Dialogue: 0,0:20:34.84,0:20:39.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Te-Terima kasih atas sarannya.\NAku sangat tersentuh.
Dialogue: 0,0:20:39.05,0:20:41.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf memanggilmu sendirian kemari.
Dialogue: 0,0:20:41.80,0:20:45.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena aku belum mengaku\Npada Ville dan yang lainnya.
Dialogue: 0,0:20:45.18,0:20:45.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa.
Dialogue: 0,0:20:45.97,0:20:48.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalaupun mengaku,\Nmereka pasti akan bingung.
Dialogue: 0,0:20:50.77,0:20:52.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya aku bisa tenang...
Dialogue: 0,0:20:52.65,0:20:55.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah? Kalau begitu,\Naku akan langsung ke intinya.
Dialogue: 0,0:20:55.78,0:20:57.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Rin.
Dialogue: 0,0:20:57.24,0:21:00.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu tahu gim otome berjudul\NNobara No Otome?
Dialogue: 0,0:21:00.49,0:21:02.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nobara No?
Dialogue: 0,0:21:02.28,0:21:06.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, aku tidak begitu paham\Ndengan gim genre otome.
Dialogue: 0,0:21:06.62,0:21:10.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebenarnya, Nobara No Otome adalah\Ngim otome buatan perusahaan kami.
Dialogue: 0,0:21:10.96,0:21:12.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ceritanya tentang
Dialogue: 0,0:21:12.14,0:21:13.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemanggilan Gadis Suci ke isekai
Dialogue: 0,0:21:13.75,0:21:15.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan berkelana bersama berbagai pria tampan
Dialogue: 0,0:21:15.84,0:21:17.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk mengalahkan monster
Dialogue: 0,0:21:17.16,0:21:18.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan menjalin hubungan.
Dialogue: 0,0:21:18.88,0:21:21.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gim simulasi cinta yang sangat klasik.
Dialogue: 0,0:21:22.30,0:21:23.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu.
Dialogue: 0,0:21:23.47,0:21:25.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, Gadis Suci?
Dialogue: 0,0:21:25.10,0:21:27.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, soal petualangan yang dialami...
Dialogue: 0,0:21:27.81,0:21:30.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misalnya menyelamatkan\NPembawa Keberuntungan di laut.
Dialogue: 0,0:21:30.98,0:21:33.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menjinakkan bos labirin,
Dialogue: 0,0:21:33.98,0:21:38.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}atau menyelesaikan misteri\Ndari naga kuno, dan sebagainya.
Dialogue: 0,0:21:39.57,0:21:42.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, jangan-jangan, maksudmu...
Dialogue: 0,0:21:42.66,0:21:45.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa terdengar familier bagimu?
Dialogue: 0,0:21:45.41,0:21:47.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, tunggu dulu.
Dialogue: 0,0:21:47.33,0:21:49.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana mengatakannya, ya?
Dialogue: 0,0:21:49.29,0:21:53.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya aku akan menyadari\Nhal yang harusnya tidak kusadari.
Dialogue: 0,0:21:53.04,0:21:54.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Singkatnya,
Dialogue: 0,0:21:54.25,0:21:56.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ini adalah dunia gim.
Dialogue: 0,0:21:56.50,0:21:58.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, semua yang kamu alami
Dialogue: 0,0:21:58.46,0:22:01.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bagian dari alur cerita.
Dialogue: 0,0:22:02.56,0:22:04.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah kuduga alurnya ke sana!
