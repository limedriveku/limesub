Dialogue: 0,0:01:11.34,0:01:18.31,sign,,0000,0000,0000,,THE FORSAKEN SAINTESS\NAND HER FOODIE ROADTRIP IN ANOTHER WORLD
Dialogue: 0,0:02:18.08,0:02:23.62,sign,,0000,0000,0000,,EPISODE 4: IBLIS KULINER DATANG!\NHARUS PAKAI SAUS TARTAR
Dialogue: 0,0:08:38.08,0:08:41.63,sign,,0000,0000,0000,,KADAL BUNGA - BISA DIMAKAN
Dialogue: 0,0:10:43.79,0:10:45.15,sign,,0000,0000,0000,,LYNX BERSAYAP - BISA DIMAKAN
Dialogue: 0,0:10:45.15,0:10:45.83,sign,,0000,0000,0000,,MONSTER KUCING GUNUNG
Dialogue: 0,0:10:49.55,0:10:52.01,sign,,0000,0000,0000,,TIDAK DIREKOMENDASIKAN UNTUK DIMAKAN
Dialogue: 0,0:15:25.90,0:15:31.37,sign,,0000,0000,0000,,COCKATRICE - BISA DIMAKAN: SANGAT LEZAT
Dialogue: 0,0:23:34.98,0:23:40.21,sign,,0000,0000,0000,,EPISODE 5: KALIAN SEMUA!\NWAKTUNYA PESTA DAGING DUNGEON!
Dialogue: 0,0:00:06.15,0:00:08.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pagi hari yang cerah.
Dialogue: 0,0:00:09.60,0:00:11.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aria kenapa?
Dialogue: 0,0:00:11.53,0:00:14.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini karena kemarin kita pulang malam.
Dialogue: 0,0:00:14.08,0:00:16.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan memaksakan diri.\NLanjut istirahat saja.
Dialogue: 0,0:00:17.83,0:00:20.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak bisa melewatkan\Nsarapan buatan Rin!
Dialogue: 0,0:00:20.17,0:00:22.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Padahal kemarin kita sudah makan banyak.
Dialogue: 0,0:00:23.67,0:00:26.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena memang layak dimasak!
Dialogue: 0,0:00:26.05,0:00:27.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan segera menyiapkan sarapan!
Dialogue: 0,0:00:27.93,0:00:29.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong, ya.
Dialogue: 0,0:00:29.08,0:00:33.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selesai sarapan, aku mau ke serikat\Nuntuk lapor kejadian kemarin.
Dialogue: 0,0:00:33.64,0:00:35.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga mau ikut.
Dialogue: 0,0:00:36.00,0:00:38.10,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semua anggota Meja Rakus!
Dialogue: 0,0:00:38.10,0:00:39.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shira?
Dialogue: 0,0:00:39.44,0:00:41.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa buru-buru begitu?
Dialogue: 0,0:00:41.35,0:00:43.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau soal laporan, aku akan ke sana.
Dialogue: 0,0:00:43.02,0:00:44.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan itu!
Dialogue: 0,0:00:44.52,0:00:46.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Situasi darurat!
Dialogue: 0,0:02:24.46,0:02:25.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dungeon liar?
Dialogue: 0,0:02:25.96,0:02:27.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:02:27.04,0:02:30.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tiba-tiba muncul di tempat\Nyang tidak memiliki distorsi mana.
Dialogue: 0,0:02:30.84,0:02:33.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa hal sekonyol ini\Nbenar-benar bisa terjadi?
Dialogue: 0,0:02:33.26,0:02:34.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi memang muncul!
Dialogue: 0,0:02:34.80,0:02:36.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Muncul... maksudmu dungeon?
Dialogue: 0,0:02:37.51,0:02:40.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rin, kamu tahu apa itu dungeon?
Dialogue: 0,0:02:40.68,0:02:43.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, kurang lebih tahu.
Dialogue: 0,0:02:43.81,0:02:49.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum pernah ada kasus dungeon\Nyang mendadak muncul,
Dialogue: 0,0:02:49.07,0:02:53.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}biasanya ada pertanda dulu.
Dialogue: 0,0:02:53.07,0:02:54.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertanda?
Dialogue: 0,0:02:54.03,0:02:56.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti tempat-tempat\Nyang banyak kematian massal,
Dialogue: 0,0:02:56.57,0:02:58.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}energi jahat akan berkumpul di sana.
Dialogue: 0,0:02:58.24,0:03:00.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat aliran mana dan jalur bumi terganggu,
Dialogue: 0,0:03:00.79,0:03:03.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}maka ruang bisa mengalami distorsi.
Dialogue: 0,0:03:03.37,0:03:08.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Normalnya, hanya fenomena seperti itu\Nyang bisa melahirkan inti dungeon.
Dialogue: 0,0:03:08.01,0:03:09.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi sampai kemarin,
Dialogue: 0,0:03:09.21,0:03:10.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}harusnya mustahil dungeon muncul
Dialogue: 0,0:03:10.95,0:03:14.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}di tempat yang tidak menunjukkan\Ntanda-tanda apa pun.
Dialogue: 0,0:03:14.47,0:03:17.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami tak tahu kenapa dungeon\Nbisa muncul tiba-tiba,
Dialogue: 0,0:03:17.16,0:03:19.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bisa saja suatu hari nanti
Dialogue: 0,0:03:19.03,0:03:22.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}akan muncul banyak monster\Ndan menghancurkan kota.
Dialogue: 0,0:03:23.08,0:03:25.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah itu bisa sangat berbahaya?
Dialogue: 0,0:03:25.49,0:03:27.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:03:27.12,0:03:30.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk menghindari kekacauan,\Nkami menginstruksikan semuanya untuk diam.
Dialogue: 0,0:03:30.69,0:03:33.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gara-gara kejadian ini,\Nstaf senior di serikat sangat sibuk.
Dialogue: 0,0:03:34.65,0:03:35.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian pasti kewalahan.
Dialogue: 0,0:03:35.93,0:03:37.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitulah situasinya.
Dialogue: 0,0:03:37.52,0:03:39.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu kekuatan kalian,
Dialogue: 0,0:03:39.70,0:03:41.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi tolong selidiki dungeon-nya.
Dialogue: 0,0:03:41.99,0:03:43.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kalian mau membantu kami?
Dialogue: 0,0:03:43.41,0:03:45.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai dari Beruang Api beberapa hari lalu,
Dialogue: 0,0:03:45.76,0:03:47.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu kemarin Baby Plup,
Dialogue: 0,0:03:47.99,0:03:51.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin memang ada yang tidak beres.
Dialogue: 0,0:03:51.88,0:03:54.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baiklah, kami akan membantu.
Dialogue: 0,0:03:54.23,0:03:55.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih!
Dialogue: 0,0:03:55.16,0:03:56.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak!
Dialogue: 0,0:03:56.92,0:03:57.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rin.
Dialogue: 0,0:03:57.84,0:04:00.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Misi ini kemungkinan bisa jangka panjang.
Dialogue: 0,0:04:00.05,0:04:02.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa tolong siapkan persediaan bahan makanan?
Dialogue: 0,0:04:02.60,0:04:04.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku pulang dulu menjelaskan\Nsituasinya pada yang lain.
Dialogue: 0,0:04:04.97,0:04:08.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, aku akan pergi beli dulu.
Dialogue: 0,0:04:08.20,0:04:10.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tolong, ya.\NNanti kita kumpul di gerbang utama.
Dialogue: 0,0:04:10.72,0:04:11.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:04:11.71,0:04:14.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku ikut denganmu!
Dialogue: 0,0:04:14.65,0:04:17.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekalian kurekomendasikan\Ntoko favorit rahasiaku.
Dialogue: 0,0:04:17.14,0:04:20.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serius?\NTerima kasih banyak.
Dialogue: 0,0:04:20.27,0:04:22.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kebetulan aku juga ingin\Nmenyegarkan pikiran.
Dialogue: 0,0:04:22.62,0:04:23.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu.
Dialogue: 0,0:04:23.80,0:04:28.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shira, aku masih butuh bantuanmu\Nuntuk pekerjaan lain!
Dialogue: 0,0:04:33.55,0:04:35.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belanja banyak.
Dialogue: 0,0:04:35.41,0:04:36.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi,
Dialogue: 0,0:04:36.63,0:04:38.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shira sudah membantu banyak
Dialogue: 0,0:04:38.80,0:04:40.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan dia terlihat sangat senang.
Dialogue: 0,0:04:40.76,0:04:42.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa stres dia menumpuk?
Dialogue: 0,0:04:42.97,0:04:44.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rin.
Dialogue: 0,0:04:44.32,0:04:46.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aria, Ed.
Dialogue: 0,0:04:46.62,0:04:48.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bajumu imut.
Dialogue: 0,0:04:49.13,0:04:51.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Shira yang memilihkannya untukku.
Dialogue: 0,0:04:51.44,0:04:53.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahan persediaannya sudah dibeli semua?
Dialogue: 0,0:04:53.12,0:04:56.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, aku sudah memindahkan\Nsemua barang bawaan ke dalam Mo.
Dialogue: 0,0:04:56.28,0:04:59.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untungnya Shira membolehkan kita\Nmemakai halaman tengah serikat.
Dialogue: 0,0:04:59.78,0:05:03.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah, di sana tidak akan mencolok.
Dialogue: 0,0:05:04.83,0:05:05.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aria.
Dialogue: 0,0:05:05.87,0:05:07.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa itu aksesori?
Dialogue: 0,0:05:07.33,0:05:08.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan.
Dialogue: 0,0:05:08.63,0:05:10.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini semacam mata serangga.
Dialogue: 0,0:05:11.37,0:05:13.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Seperti batu rubi, indah!
Dialogue: 0,0:05:13.33,0:05:16.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dengan ini, aku bisa\Nlebih peka keadaan sekitar.
Dialogue: 0,0:05:16.45,0:05:19.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Contohnya Ville dan Senon,\Nsekarang mereka sedang kemari.
Dialogue: 0,0:05:21.12,0:05:22.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tebakanmu benar!
Dialogue: 0,0:05:23.84,0:05:25.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya sudah kumpul?
Dialogue: 0,0:05:25.68,0:05:26.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah siap?
Dialogue: 0,0:05:26.80,0:05:27.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah.
Dialogue: 0,0:05:27.49,0:05:30.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, kalau begitu kita berangkat.
Dialogue: 0,0:05:33.92,0:05:35.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akhirnya berangkat juga.
Dialogue: 0,0:05:35.94,0:05:39.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya sudah dipersiapkan,\Napa kami akan baik-baik saja?
Dialogue: 0,0:05:39.07,0:05:40.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dungeon misterius.
Dialogue: 0,0:05:40.47,0:05:43.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa saja membuat para monster\Nmasuk ke kota.
Dialogue: 0,0:05:44.06,0:05:45.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini misi yang berat.
Dialogue: 0,0:05:47.20,0:05:49.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rin, jangan terlalu tegang.
Dialogue: 0,0:05:49.43,0:05:51.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita menyelidiki dungeon itu
Dialogue: 0,0:05:51.44,0:05:53.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}agar semua orang tak cemas.
Dialogue: 0,0:05:53.17,0:05:54.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:05:54.52,0:05:55.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu benar.
Dialogue: 0,0:05:55.99,0:06:00.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, aku dan Mo juga harus berusaha!
Dialogue: 0,0:06:00.32,0:06:01.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kali ini, kita harus jalan kaki.
Dialogue: 0,0:06:02.33,0:06:03.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:06:08.41,0:06:09.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harusnya ada di sekitar sini.
Dialogue: 0,0:06:09.89,0:06:12.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata lokasinya dekat kota, ya?
Dialogue: 0,0:06:12.69,0:06:15.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita baru jalan kaki sekitar 15 menit.
Dialogue: 0,0:06:15.56,0:06:20.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sebabnya orang-orang\Ndi serikat sangat waspada.
Dialogue: 0,0:06:33.62,0:06:36.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah menyingkirkan ilusi\Nyang dipasang serikat.
Dialogue: 0,0:06:36.83,0:06:39.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rin, jangan terlalu dekat.
Dialogue: 0,0:06:39.23,0:06:41.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan selidiki dulu situasi di dalamnya.
Dialogue: 0,0:06:41.32,0:06:42.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:06:53.10,0:06:54.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya cukup luas.
Dialogue: 0,0:06:55.19,0:06:56.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ville.
Dialogue: 0,0:06:56.65,0:06:58.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jalannya terlihat cukup lebar.
Dialogue: 0,0:06:58.36,0:07:01.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah lebih cepat kalau pakai\Nskill Rin untuk masuk?
Dialogue: 0,0:07:01.56,0:07:03.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu kalau untuk menaklukkan dungeon saja.
Dialogue: 0,0:07:03.52,0:07:06.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Prioritas kita sekarang mengumpulkan informasi.
Dialogue: 0,0:07:06.61,0:07:09.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus teliti mengecek semua area.
Dialogue: 0,0:07:09.41,0:07:12.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, itu sebabnya kita jalan kaki.
Dialogue: 0,0:07:12.60,0:07:14.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini tidak terlihat ada musuh.
Dialogue: 0,0:07:14.91,0:07:16.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:07:16.13,0:07:18.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku dan Aria akan memimpin di depan.
Dialogue: 0,0:07:18.09,0:07:19.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rin di tengah.
Dialogue: 0,0:07:19.31,0:07:21.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ed dan Senon menjaga di belakang.
Dialogue: 0,0:07:21.63,0:07:24.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi aku hanya perlu menjaga Rin, ya?
Dialogue: 0,0:07:24.22,0:07:25.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oke, oke!
Dialogue: 0,0:07:25.35,0:07:27.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, peranku bukan untuk bertarung.
Dialogue: 0,0:07:27.85,0:07:30.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Grup yang punya porter selalu seperti ini.
Dialogue: 0,0:07:30.39,0:07:31.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak perlu khawatir.
Dialogue: 0,0:07:31.89,0:07:33.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ville benar.
Dialogue: 0,0:07:33.85,0:07:35.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, saat istirahat,
Dialogue: 0,0:07:35.48,0:07:37.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kami akan menggunakan kotak besarmu itu.
Dialogue: 0,0:07:37.92,0:07:39.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanpa Rin,
Dialogue: 0,0:07:39.36,0:07:42.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}mungkin kami akan membatalkan\Nmisi ini di tengah jalan.
Dialogue: 0,0:07:42.00,0:07:43.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makan itu prioritas.
Dialogue: 0,0:07:43.57,0:07:44.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya!
Dialogue: 0,0:07:44.71,0:07:47.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untuk petualangan seperti ini,\Nadaptasi dengan perlahan saja.
Dialogue: 0,0:07:47.78,0:07:48.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baik!
Dialogue: 0,0:07:49.62,0:07:52.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka semua perhatian,\Naku jadi terharu.
Dialogue: 0,0:08:19.00,0:08:21.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bau seperti aroma bunga ini,
Dialogue: 0,0:08:21.65,0:08:24.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kemungkinan besar itu Kadal Bunga.
Dialogue: 0,0:08:24.65,0:08:26.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kadal Bunga?
Dialogue: 0,0:08:26.20,0:08:29.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Monster kadal yang bisa\Nmenyamar sebagai tanaman.
Dialogue: 0,0:08:31.77,0:08:33.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lihat, dia datang.
Dialogue: 0,0:08:35.88,0:08:37.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia menyeramkan, ya!
Dialogue: 0,0:08:38.08,0:08:41.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari informasi Survival, dia bisa dimakan.
Dialogue: 0,0:08:41.63,0:08:43.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan cemas, Rin.
Dialogue: 0,0:08:55.54,0:08:57.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nah, sudah beres!
Dialogue: 0,0:08:57.31,0:09:00.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh, barusan kamu memanggangnya?
Dialogue: 0,0:09:01.09,0:09:02.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka lemah terhadap api.
Dialogue: 0,0:09:02.98,0:09:05.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku hanya mengisolasinya,\Nmemadatkannya, lalu membakarnya.
Dialogue: 0,0:09:05.98,0:09:07.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mudah, kan?
Dialogue: 0,0:09:07.99,0:09:09.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, aku tidak paham.
Dialogue: 0,0:09:11.49,0:09:13.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada barang jatuhan.
Dialogue: 0,0:09:13.57,0:09:15.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rin, bagaimana dengan daging ini?
Dialogue: 0,0:09:16.56,0:09:18.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sementara akan kusimpan dulu.
Dialogue: 0,0:09:19.47,0:09:20.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuning?
Dialogue: 0,0:09:26.05,0:09:27.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nyaris saja.
Dialogue: 0,0:09:27.39,0:09:28.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ke-Kenapa?
Dialogue: 0,0:09:30.80,0:09:31.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kucing?
Dialogue: 0,0:09:35.93,0:09:37.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini...
Dialogue: 0,0:09:37.13,0:09:38.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan sembarangan menyentuhnya, Rin.
Dialogue: 0,0:09:39.87,0:09:42.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, aku refleks menangkapnya karena panik.
Dialogue: 0,0:09:42.73,0:09:45.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untungnya dia tidak ada niat menyerang.
Dialogue: 0,0:09:45.56,0:09:46.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi tetap harus berhati-hati.
Dialogue: 0,0:09:46.94,0:09:47.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:09:48.36,0:09:50.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak Lynx Bersayap?
Dialogue: 0,0:09:50.93,0:09:52.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa dia muncul di tempat seperti ini?
Dialogue: 0,0:09:52.83,0:09:55.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia anak kucing?\NBesar sekali.
Dialogue: 0,0:09:55.57,0:09:58.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Induknya tidak ada.\NApa dia tersesat?
Dialogue: 0,0:09:58.83,0:10:00.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Atau ditinggalkan?
Dialogue: 0,0:10:03.54,0:10:05.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia jinak sekali!
Dialogue: 0,0:10:05.74,0:10:08.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa anak monster ini berbahaya?
Dialogue: 0,0:10:08.48,0:10:11.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lynx Bersayap sekecil ini belum berbahaya.
Dialogue: 0,0:10:15.94,0:10:19.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kenapa?\NApa kamu lapar?
Dialogue: 0,0:10:19.72,0:10:22.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia belum makan?\NKasihan.
Dialogue: 0,0:10:24.15,0:10:26.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana, ya?
Dialogue: 0,0:10:26.11,0:10:29.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kucing itu karnivora, kan?
Dialogue: 0,0:10:29.03,0:10:31.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, kalau diberi makan daging kadal...
Dialogue: 0,0:10:34.32,0:10:35.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu mau makan?
Dialogue: 0,0:10:36.62,0:10:39.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Serius?\NDia bisa makan daging kadal?
Dialogue: 0,0:10:39.58,0:10:42.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mereka kucing gunung,\Ntidak akan pilih-pilih makanan.
Dialogue: 0,0:10:43.79,0:10:45.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berubah jadi biru.
Dialogue: 0,0:10:46.32,0:10:49.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu kotak kuning barusan\Nitu maksudnya apa?
Dialogue: 0,0:10:52.01,0:10:54.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimanapun,\Naku juga tidak akan memakannya!
Dialogue: 0,0:10:58.05,0:11:00.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anak ini akan kita apakan?
Dialogue: 0,0:11:00.39,0:11:03.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ditanya begitu...
Dialogue: 0,0:11:03.02,0:11:05.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu santai sekali, ya.
Dialogue: 0,0:11:05.75,0:11:07.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mirip sekali dengan Gomamitsu.
Dialogue: 0,0:11:07.99,0:11:09.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gomamitsu?
Dialogue: 0,0:11:09.27,0:11:11.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu nama kucing yang kupelihara dulu.
Dialogue: 0,0:11:11.97,0:11:15.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bulunya hitam semua,\Njadi kupanggil dia Gomamitsu.
Dialogue: 0,0:11:15.11,0:11:18.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bulu anak kucing ini lebih mirip Gomamiso.
Dialogue: 0,0:11:20.73,0:11:23.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, kan?\NKamu Gomamiso, ya?
Dialogue: 0,0:11:23.33,0:11:26.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mirip Gomamiso?\NMirip Gomamiso?
Dialogue: 0,0:11:26.29,0:11:28.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, mirip.
Dialogue: 0,0:11:28.67,0:11:29.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gomami—
Dialogue: 0,0:11:29.71,0:11:30.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:11:30.59,0:11:33.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu boleh memanggilku Gomamiso.
Dialogue: 0,0:11:37.70,0:11:40.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kucingnya bicara!
Dialogue: 0,0:11:43.10,0:11:45.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di-Dia barusan bicara?
Dialogue: 0,0:11:45.37,0:11:45.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:11:46.84,0:11:47.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:11:47.90,0:11:49.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Gomamiso.
Dialogue: 0,0:11:49.86,0:11:51.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian tidak mendengarnya?
Dialogue: 0,0:11:51.52,0:11:53.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia dari tadi terus bicara.
Dialogue: 0,0:11:53.90,0:11:54.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:11:54.48,0:11:56.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, aku hanya mendengar dia mengeong.
Dialogue: 0,0:12:04.94,0:12:09.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rin, Lynx Bersayap ini\Nsepertinya sudah diberi nama.
Dialogue: 0,0:12:09.58,0:12:11.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu melakukan sesuatu?
Dialogue: 0,0:12:11.44,0:12:12.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Memberi nama?
Dialogue: 0,0:12:12.59,0:12:14.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan, Gomamiso jadi namanya?
Dialogue: 0,0:12:14.84,0:12:17.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu aku, itu namaku.
Dialogue: 0,0:12:17.09,0:12:18.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Unik sekali.
Dialogue: 0,0:12:19.05,0:12:21.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti dia sudah dijinakkan?
Dialogue: 0,0:12:21.97,0:12:24.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sebabnya hanya kamu\Nyang bisa dengar suaranya.
Dialogue: 0,0:12:24.64,0:12:27.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa monster bisa dijinakkan semudah ini?
Dialogue: 0,0:12:27.60,0:12:28.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak mungkin.
Dialogue: 0,0:12:28.64,0:12:30.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini situasi langka.
Dialogue: 0,0:12:30.52,0:12:32.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh? Kenapa?
Dialogue: 0,0:12:32.40,0:12:34.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf! Maaf!
Dialogue: 0,0:12:34.11,0:12:36.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini bukan salahmu.
Dialogue: 0,0:12:36.05,0:12:38.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lagi pula, kamu bukan penjinak hewan.
Dialogue: 0,0:12:38.85,0:12:40.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu benar.
Dialogue: 0,0:12:40.11,0:12:42.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu hebat, Rin!
Dialogue: 0,0:12:42.20,0:12:44.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kali ini bisa menjinakkan Lynx Bersayap!
Dialogue: 0,0:12:44.45,0:12:46.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini sangat di luar dugaan, ya.
Dialogue: 0,0:12:46.87,0:12:48.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kucingnya imut.
Dialogue: 0,0:12:48.62,0:12:52.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, aku malah merepotkan semuanya.
Dialogue: 0,0:12:55.07,0:13:01.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku malah merepotkan ketua grup\Nyang sedang menjelajahi dungeon misterius.
Dialogue: 0,0:13:04.39,0:13:07.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan daftarkan Rin\Nke serikat sebagai tamer
Dialogue: 0,0:13:07.47,0:13:09.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan kucing ini sebagai peliharaannya.
Dialogue: 0,0:13:10.21,0:13:12.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudku, karena situasinya seperti ini,
Dialogue: 0,0:13:12.77,0:13:15.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tak bisa kejam menyuruhmu\Nuntuk menelantarkannya.
Dialogue: 0,0:13:15.90,0:13:17.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu ide bagus.
Dialogue: 0,0:13:17.87,0:13:20.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kucingnya lucu, jadi aku setuju.
Dialogue: 0,0:13:20.74,0:13:24.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau dipelihara dari kecil,\Nbesarnya juga akan jinak.
Dialogue: 0,0:13:24.74,0:13:28.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dunia ini sangat baik.
Dialogue: 0,0:13:30.23,0:13:32.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu beruntung, Gomamiso.
Dialogue: 0,0:13:47.54,0:13:50.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia akan jadi hewan hebat.
Dialogue: 0,0:14:01.53,0:14:04.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tempat ini luas sekali, ya!
Dialogue: 0,0:14:05.49,0:14:09.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Langit-langitnya tinggi!
Dialogue: 0,0:14:09.04,0:14:11.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku bisa melewatinya\Ndengan sekali lompat!
Dialogue: 0,0:14:11.33,0:14:14.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, punya mimpi besar itu hal bagus.
Dialogue: 0,0:14:16.04,0:14:17.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bingkai merah?
Dialogue: 0,0:14:17.25,0:14:18.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ada apa?
Dialogue: 0,0:14:18.19,0:14:20.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya ada sesuatu di sana.
Dialogue: 0,0:14:20.13,0:14:23.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu jebakan tipe tanah.
Dialogue: 0,0:14:39.23,0:14:41.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang kita bisa melewatinya dengan aman.
Dialogue: 0,0:14:41.74,0:14:44.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hebat!\NLangsung bisa diatasi dengan cepat, ya!
Dialogue: 0,0:14:44.99,0:14:46.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rin, kenapa kamu tahu ada jebakan di sini?
Dialogue: 0,0:14:46.96,0:14:49.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Survival memberiku peringatan.
Dialogue: 0,0:14:49.58,0:14:51.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak kusangka skill ini\Nbisa memberi tahu ada jebakan!
Dialogue: 0,0:14:56.23,0:14:57.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rin, mundur!
Dialogue: 0,0:14:57.50,0:14:58.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik!
Dialogue: 0,0:15:02.51,0:15:03.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senon.
Dialogue: 0,0:15:03.28,0:15:04.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:15:04.25,0:15:05.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yurila Veil!
Dialogue: 0,0:15:12.89,0:15:14.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dilihat dari reaksi mereka,
Dialogue: 0,0:15:14.81,0:15:16.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sepertinya itu monster berbahaya.
Dialogue: 0,0:15:16.85,0:15:19.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rin, pokoknya jangan buka jendelanya!
Dialogue: 0,0:15:19.40,0:15:20.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tetap di dalam bersama Goma.
Dialogue: 0,0:15:20.98,0:15:23.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makhluk ini bernama Cockatrice!\NDia beracun!
Dialogue: 0,0:15:24.36,0:15:25.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia beracun?
Dialogue: 0,0:15:25.90,0:15:28.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukankah Cockatrice itu
Dialogue: 0,0:15:28.45,0:15:31.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}monster beracun yang sangat terkenal?
Dialogue: 0,0:15:40.63,0:15:41.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya...
Dialogue: 0,0:15:47.69,0:15:48.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?
Dialogue: 0,0:15:51.43,0:15:53.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asalkan sudah bersiap dari awal,
Dialogue: 0,0:15:53.67,0:15:56.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}serangan napas beracun ini\Nbisa kita netralkan.
Dialogue: 0,0:15:56.91,0:15:58.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi jangan meremehkannya.
Dialogue: 0,0:16:02.52,0:16:04.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Horizontal.
Dialogue: 0,0:16:13.99,0:16:17.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa barusan aku melihat\Nhal yang luar biasa?
Dialogue: 0,0:16:17.53,0:16:21.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Monster itu dibantai\Nsampai dagingnya tercabik-cabik!
Dialogue: 0,0:16:21.54,0:16:22.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh.
Dialogue: 0,0:16:23.53,0:16:25.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cockatrice-nya hilang?
Dialogue: 0,0:16:25.84,0:16:27.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hilang?
Dialogue: 0,0:16:27.49,0:16:28.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya, dia sudah hilang.
Dialogue: 0,0:16:30.09,0:16:33.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku ini tangguh!
Dialogue: 0,0:16:33.06,0:16:37.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku sama sekali\Ntidak takut ekor Cockatrice.
Dialogue: 0,0:16:37.56,0:16:39.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama sekali tidak takut!
Dialogue: 0,0:16:39.56,0:16:40.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ekor?
Dialogue: 0,0:16:40.45,0:16:41.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, maksudmu ular—
Dialogue: 0,0:16:41.61,0:16:43.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan diucapkan!
Dialogue: 0,0:16:43.36,0:16:44.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh.
Dialogue: 0,0:16:44.42,0:16:46.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kenapa, Gomamiso?
Dialogue: 0,0:16:46.49,0:16:48.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu ini cuma miso,
Dialogue: 0,0:16:48.57,0:16:50.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jangan arogan!
Dialogue: 0,0:16:54.18,0:16:57.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku jadi monster pengisap kucing.
Dialogue: 0,0:16:58.16,0:16:59.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ville!
Dialogue: 0,0:16:59.29,0:17:01.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya kalian baik-baik saja, ya.
Dialogue: 0,0:17:01.29,0:17:03.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ma-Maaf aku memperlihatkan hal memalukan.
Dialogue: 0,0:17:03.46,0:17:05.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, aku senang kalian baik-baik saja.
Dialogue: 0,0:17:06.56,0:17:09.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu karena aku hebat!
Dialogue: 0,0:17:09.30,0:17:10.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sama sekali tidak takut!
Dialogue: 0,0:17:13.26,0:17:14.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:17:14.55,0:17:16.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tak tahu dia bicara apa.
Dialogue: 0,0:17:16.14,0:17:17.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya, ini untukmu.
Dialogue: 0,0:17:17.93,0:17:20.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini barang jatuhan, ya?
Dialogue: 0,0:17:21.42,0:17:23.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini daging permata dari dungeon!
Dialogue: 0,0:17:23.52,0:17:28.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Melihatnya saja, daging ini sudah pasti enak!
Dialogue: 0,0:17:28.03,0:17:30.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah kalau kamu suka.
Dialogue: 0,0:17:30.11,0:17:31.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat antusias!
Dialogue: 0,0:17:31.85,0:17:35.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sama sekali tidak terlihat\Nkalau ini daging monster mengerikan tadi.
Dialogue: 0,0:17:35.48,0:17:37.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini bisa diolah jadi masakan?
Dialogue: 0,0:17:38.20,0:17:39.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja!
Dialogue: 0,0:17:39.58,0:17:41.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini makanan pertama kita di dungeon!
Dialogue: 0,0:17:41.46,0:17:43.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Akan kuolah spesial daging ini\Nmirip Namban Ayam:
Dialogue: 0,0:17:43.96,0:17:46.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Namban Cockatrice!
Dialogue: 0,0:17:52.26,0:17:53.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf, Rin.
Dialogue: 0,0:17:53.96,0:17:56.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku malah menghancurkan telurnya.
Dialogue: 0,0:17:56.51,0:18:00.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak apa-apa,\Nterima kasih sudah mau membantu.
Dialogue: 0,0:18:00.32,0:18:03.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau hal seperti ini bukan masalah.
Dialogue: 0,0:18:03.20,0:18:06.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat bisa membantu, aku tidak keberatan.
Dialogue: 0,0:18:07.13,0:18:10.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya, Gomamiso akhirnya bisa diam.
Dialogue: 0,0:18:10.13,0:18:12.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mungkin karena situasinya sudah tenang.
Dialogue: 0,0:18:12.74,0:18:15.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita buat saus tartar sekarang.
Dialogue: 0,0:18:15.78,0:18:17.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saus tartar?
Dialogue: 0,0:18:17.58,0:18:21.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pertama, hancurkan telur rebus\Ndengan bagian belakang garpu.
Dialogue: 0,0:18:21.49,0:18:25.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu, tambahkan bawang bombai\Ndan acar timun yang sudah dipotong tadi.
Dialogue: 0,0:18:25.52,0:18:29.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sisanya serahkan pada Senior Mayones.
Dialogue: 0,0:18:29.25,0:18:31.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Senior Mayones?
Dialogue: 0,0:18:31.17,0:18:32.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau coba rasanya?
Dialogue: 0,0:18:32.67,0:18:33.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh?
Dialogue: 0,0:18:34.09,0:18:35.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini.
Dialogue: 0,0:18:36.72,0:18:39.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa ini?
Dialogue: 0,0:18:39.18,0:18:42.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harusnya ini cocok dicampur\Ndengan daging Cockatrice.
Dialogue: 0,0:18:42.39,0:18:44.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya menghantam lidah.
Dialogue: 0,0:18:44.52,0:18:46.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ternyata ada saus cocol seenak ini.
Dialogue: 0,0:18:46.73,0:18:49.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rin, apa kamu iblis?
Dialogue: 0,0:18:51.76,0:18:56.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku Iblis Makanan, Shokuma!
Dialogue: 0,0:18:56.93,0:18:58.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami kembali.
Dialogue: 0,0:19:00.10,0:19:02.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selamat datang kembali.
Dialogue: 0,0:19:02.50,0:19:04.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Barusan kami patroli,
Dialogue: 0,0:19:04.37,0:19:06.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tempat ini memang tidak beres.
Dialogue: 0,0:19:06.25,0:19:09.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Monster di sini hanya penampilannya saja\Nyang menakutkan.
Dialogue: 0,0:19:09.42,0:19:12.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Agak mirip dengan Beruang Api dulu.
Dialogue: 0,0:19:12.89,0:19:14.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya.
Dialogue: 0,0:19:14.01,0:19:16.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cockatrice tadi memang lebih lemah\Ndari Cockatrice biasa.
Dialogue: 0,0:19:16.56,0:19:18.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku merasa ada yang tidak beres.
Dialogue: 0,0:19:18.30,0:19:21.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga sudah menemukan\Nrute ke lantai berikutnya.
Dialogue: 0,0:19:21.21,0:19:22.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang aku lelah.
Dialogue: 0,0:19:25.28,0:19:28.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aria, aku juga ingin mengelus Goma.
Dialogue: 0,0:19:29.38,0:19:31.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski monster di sini lemah,
Dialogue: 0,0:19:31.60,0:19:34.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}semuanya kelelahan\Nkarena situasi yang tidak stabil ini.
Dialogue: 0,0:19:36.91,0:19:38.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nasinya sudah matang!
Dialogue: 0,0:19:39.12,0:19:42.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat lapar, pikiran jadi cenderung negatif.
Dialogue: 0,0:19:42.87,0:19:44.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita makan dulu!
Dialogue: 0,0:19:44.00,0:19:45.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu benar.
Dialogue: 0,0:19:45.16,0:19:46.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setuju!
Dialogue: 0,0:19:46.29,0:19:47.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah lapar.
Dialogue: 0,0:19:48.73,0:19:50.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makan?
Dialogue: 0,0:19:50.34,0:19:51.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah waktunya makan?
Dialogue: 0,0:19:51.81,0:19:53.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga mau makan!
Dialogue: 0,0:19:53.34,0:19:55.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tahu, akan kusiapkan untukmu.
Dialogue: 0,0:20:04.81,0:20:06.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf sudah menunggu!
Dialogue: 0,0:20:06.31,0:20:09.65,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nasi Namban Cockatrice sudah siap!
Dialogue: 0,0:20:12.32,0:20:13.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luar biasa!
Dialogue: 0,0:20:13.78,0:20:17.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa membuat masakan\Nseenak ini dari daging Cockatrice!
Dialogue: 0,0:20:17.15,0:20:21.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rin, apa yang sebenarnya kamu lakukan?
Dialogue: 0,0:20:21.53,0:20:22.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kejam!
Dialogue: 0,0:20:22.53,0:20:23.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu kejam!
Dialogue: 0,0:20:23.91,0:20:27.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa-bisanya membuat kami makan\Nmakanan seenak ini!
Dialogue: 0,0:20:27.21,0:20:29.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rin, dasar iblis.
Dialogue: 0,0:20:29.54,0:20:31.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ville juga bilang begitu.
Dialogue: 0,0:20:31.50,0:20:34.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku bukan iblis makanan, aku Shokuma.
Dialogue: 0,0:20:34.25,0:20:35.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, kamu memang iblis!
Dialogue: 0,0:20:35.84,0:20:38.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saus cocol yang disebut\Nsaus tartar ini sebenarnya apa?
Dialogue: 0,0:20:38.76,0:20:40.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku merasa bisa makan daging sepuasnya!
Dialogue: 0,0:20:40.97,0:20:43.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saus cocolnya kaya rasa,
Dialogue: 0,0:20:43.43,0:20:45.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi bumbu asam manisnya terasa segar,
Dialogue: 0,0:20:45.39,0:20:47.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jadi sama sekali tidak membuat enek.
Dialogue: 0,0:20:47.04,0:20:50.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ditambah tekstur sayur yang renyah,
Dialogue: 0,0:20:50.06,0:20:52.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku masih bisa menghabiskan\Nsatu porsi lagi.
Dialogue: 0,0:20:52.73,0:20:55.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dagingnya empuk dan enak!
Dialogue: 0,0:20:59.49,0:21:01.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Awalnya aku heran kenapa ada sayuran.
Dialogue: 0,0:21:01.43,0:21:03.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:21:03.00,0:21:04.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak, kan?
Dialogue: 0,0:21:04.53,0:21:05.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:21:05.37,0:21:08.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dicocol dengan saus asam manis,\Nrasanya membuat ketagihan.
Dialogue: 0,0:21:08.62,0:21:10.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya?
Dialogue: 0,0:21:10.56,0:21:13.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu belum pernah makan Kubis Hargiro, ya?
Dialogue: 0,0:21:13.17,0:21:15.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku anak yang baik.
Dialogue: 0,0:21:15.80,0:21:18.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sayuran pun kumakan!
Dialogue: 0,0:21:18.15,0:21:20.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gomamiso bilang dia bisa makan sayuran.
Dialogue: 0,0:21:22.26,0:21:23.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Goma.
Dialogue: 0,0:21:37.72,0:21:39.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak!
Dialogue: 0,0:21:39.11,0:21:40.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benarkah?
Dialogue: 0,0:21:40.22,0:21:41.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah.
Dialogue: 0,0:21:41.45,0:21:44.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makan sayur?\NKamu juga anak baik, ya.
Dialogue: 0,0:21:44.28,0:21:47.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aria, Gomamiso memujimu.
Dialogue: 0,0:21:47.64,0:21:50.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Curang, aku juga ingin memuji Aria.
Dialogue: 0,0:21:50.62,0:21:53.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kesal dengan kucing?
Dialogue: 0,0:21:53.58,0:21:55.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Soalnya...
Dialogue: 0,0:21:57.17,0:21:57.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi...
Dialogue: 0,0:21:57.92,0:22:00.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aria yang dipuji juga imut.
Dialogue: 0,0:22:00.01,0:22:02.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dasar Ed.
Dialogue: 0,0:22:02.08,0:22:04.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan memuji kalian juga lain kali.
