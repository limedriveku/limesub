Dialogue: 0,0:01:00.96,0:01:08.13,sign,,0000,0000,0000,,THE FORSAKEN SAINTESS\NAND HER FOODIE ROADTRIP IN ANOTHER WORLD
Dialogue: 0,0:02:08.11,0:02:13.31,sign,,0000,0000,0000,,EPISODE 9: SELESAI DENGAN RENYAH,\NDIAKHIRI DENGAN KRIUK! PERSIS SEPERTI TEMPURA!
Dialogue: 0,0:15:02.21,0:15:05.68,sign,,0000,0000,0000,,IKAN LELE NERAKA - BISA DIMAKAN: LEZAT
Dialogue: 0,0:23:34.98,0:23:36.19,sign,,0000,0000,0000,,EPISODE 10:
Dialogue: 0,0:23:36.19,0:23:40.20,sign,,0000,0000,0000,,HAHA, SAATNYA SAUS TARTAR LAGI!\N(YANG KEDUA KALINYA SETELAH LIMA EPISODE)
Dialogue: 0,0:00:05.63,0:00:07.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini semua salahku.
Dialogue: 0,0:00:07.15,0:00:11.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita masih menjalankan misi,\Ntapi aku malah lengah.
Dialogue: 0,0:00:11.16,0:00:13.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini salah kita semua.
Dialogue: 0,0:00:13.66,0:00:16.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyalahkan diri sendiri itu kebiasaan buruk.
Dialogue: 0,0:00:16.45,0:00:18.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masih terlalu dini untuk menyerah.
Dialogue: 0,0:00:23.25,0:00:25.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu melilitkan benang ke makhluk itu?
Dialogue: 0,0:00:25.34,0:00:26.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aria memang hebat.
Dialogue: 0,0:00:29.01,0:00:30.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan khawatir.
Dialogue: 0,0:00:30.72,0:00:34.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami pasti akan menyelamatkan majikanmu.
Dialogue: 0,0:02:13.31,0:02:14.70,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu...
Dialogue: 0,0:02:14.70,0:02:17.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu bilang aku itu pelayanmu?
Dialogue: 0,0:02:17.43,0:02:18.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:02:18.79,0:02:22.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah memanggilmu\Nsesuai dengan perjanjian aliansi, kan?
Dialogue: 0,0:02:22.75,0:02:24.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang aku akan istirahat\Ndan memulihkan diri
Dialogue: 0,0:02:24.94,0:02:26.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan butuh seseorang untuk melayaniku.
Dialogue: 0,0:02:26.88,0:02:28.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Eh?\NTempat ini...
Dialogue: 0,0:02:29.71,0:02:31.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sumber mata air?
Dialogue: 0,0:02:32.07,0:02:36.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan, Naga ini Bos yang tinggal\Ndi sumber mata air?
Dialogue: 0,0:02:37.85,0:02:39.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Konon, pada zaman kuno,
Dialogue: 0,0:02:39.68,0:02:42.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hiduplah seekor naga di gunung itu.
Dialogue: 0,0:02:42.00,0:02:45.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan, naga legendaris itu\Nadalah Naga ini?
Dialogue: 0,0:02:45.35,0:02:48.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, gadis tersebut menjadi miko.
Dialogue: 0,0:02:48.27,0:02:51.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan miko, tapi hanya pelayan.
Dialogue: 0,0:02:51.11,0:02:53.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Malah bergerak mencurigakan begitu!
Dialogue: 0,0:02:53.64,0:02:55.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu bukan pelayanku?
Dialogue: 0,0:02:55.99,0:03:00.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu juga akan\Nmenghunuskan pedangmu padaku?
Dialogue: 0,0:03:00.66,0:03:02.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}To-Tolong tunggu sebentar!
Dialogue: 0,0:03:02.04,0:03:04.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Aku bisa memasak.
Dialogue: 0,0:03:04.77,0:03:07.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,\Ncepat siapkan makanan untukku.
Dialogue: 0,0:03:08.63,0:03:12.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tubuhku yang lelah ini\Nharus diberi asupan yang baik.
Dialogue: 0,0:03:12.60,0:03:14.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ba-Baik.
Dialogue: 0,0:03:14.30,0:03:16.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, iya, anu...
Dialogue: 0,0:03:16.97,0:03:18.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:03:18.01,0:03:21.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana aku harus memanggilmu?
Dialogue: 0,0:03:21.77,0:03:23.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga...
Dialogue: 0,0:03:23.39,0:03:26.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga baru kali ini memanggil\Npelayan lagi setelah 500 tahun.
Dialogue: 0,0:03:26.50,0:03:27.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lima ratus tahun?
Dialogue: 0,0:03:27.85,0:03:30.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rentang waktunya terlalu lama.
Dialogue: 0,0:03:30.23,0:03:32.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pantas saja jauh berbeda\Ndari yang ada dalam legenda.
Dialogue: 0,0:03:32.94,0:03:36.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimanapun, sudah lama aku\Ntidak memiliki pelayan.
Dialogue: 0,0:03:36.18,0:03:40.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, aku mengizinkanmu\Nuntuk memanggil namaku saja.
Dialogue: 0,0:03:40.18,0:03:43.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mulai sekarang,\Nkamu boleh memanggilku Miru.
Dialogue: 0,0:03:43.16,0:03:44.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, Nona Miru,
Dialogue: 0,0:03:44.98,0:03:47.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hidangan seperti apa\Nyang ingin kamu makan sekarang?
Dialogue: 0,0:03:47.83,0:03:49.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asam atau yang manis?
Dialogue: 0,0:03:49.75,0:03:51.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kaya rasa atau yang ringan?
Dialogue: 0,0:03:51.59,0:03:53.38,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dingin atau panas?
Dialogue: 0,0:03:53.38,0:03:54.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:03:54.66,0:03:56.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asalkan kubilang seleraku padamu,
Dialogue: 0,0:03:56.53,0:03:59.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu bisa langsung membuat\Nhidangan yang sesuai?
Dialogue: 0,0:03:59.26,0:04:01.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak disangka kamu punya\Nkemampuan seperti ini.
Dialogue: 0,0:04:01.96,0:04:02.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh.
Dialogue: 0,0:04:02.72,0:04:05.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya dia juga suka makan.
Dialogue: 0,0:04:05.56,0:04:08.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu,\Naku yang tak bisa tempur ini,
Dialogue: 0,0:04:08.14,0:04:11.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}hanya punya satu cara kalau ingin selamat\Ndari situasi seperti ini,
Dialogue: 0,0:04:11.44,0:04:14.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}yaitu memikat Putri Naga ini lewat masakan
Dialogue: 0,0:04:14.40,0:04:16.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan membuatnya makan sepuasnya.
Dialogue: 0,0:04:21.16,0:04:22.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sini.
Dialogue: 0,0:04:22.33,0:04:24.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semoga masih sempat.
Dialogue: 0,0:04:24.33,0:04:26.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harusnya masih ada waktu.
Dialogue: 0,0:04:26.37,0:04:28.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau naga itu berniat memakan Rin,
Dialogue: 0,0:04:28.33,0:04:30.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia bisa memakannya saat itu juga.
Dialogue: 0,0:04:30.12,0:04:31.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi dia malah membawanya pergi.
Dialogue: 0,0:04:31.83,0:04:33.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu artinya dia punya tujuan lain.
Dialogue: 0,0:04:33.53,0:04:35.05,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa dia bosnya?
Dialogue: 0,0:04:35.05,0:04:35.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya begitu.
Dialogue: 0,0:04:35.88,0:04:38.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia Mirage Dragon.
Dialogue: 0,0:04:39.51,0:04:41.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berarti sesuai dengan laporan.
Dialogue: 0,0:04:41.09,0:04:43.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Membuat musuh melihat ilusi\Nyang mengerikan
Dialogue: 0,0:04:43.55,0:04:45.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}untuk menghilangkan\Nsemangat bertarung mereka.
Dialogue: 0,0:04:45.68,0:04:48.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itulah cara bertarung Mirage Dragon.
Dialogue: 0,0:04:50.69,0:04:51.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebagai ahli ilusi,
Dialogue: 0,0:04:51.81,0:04:53.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dia termasuk yang terkuat.
Dialogue: 0,0:04:53.13,0:04:55.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ditanya apa aku bisa\Nmemecahkan ilusinya,
Dialogue: 0,0:04:55.15,0:04:57.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sejujurnya aku juga tidak yakin.
Dialogue: 0,0:04:57.90,0:05:00.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi kita tak punya pilihan selain bertaruh.
Dialogue: 0,0:05:02.95,0:05:05.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena Rin teman kita yang berharga.
Dialogue: 0,0:05:05.16,0:05:07.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sudah tidak bisa\Nmembayangkan petualangan tanpanya.
Dialogue: 0,0:05:07.91,0:05:10.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau ada jalan atau tidak,
Dialogue: 0,0:05:10.04,0:05:12.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita langsung lewat jalan pintas tercepat!
Dialogue: 0,0:05:15.04,0:05:17.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}I-Itu kotak besi apa?
Dialogue: 0,0:05:17.63,0:05:19.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari mana asalnya?
Dialogue: 0,0:05:19.51,0:05:23.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kotak ini hanya terlihat\Noleh orang-orang yang kuizinkan.
Dialogue: 0,0:05:23.55,0:05:26.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di dalamnya tak hanya ada\Nbahan makanan dan alat masak,
Dialogue: 0,0:05:26.01,0:05:28.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi juga bisa memuat banyak barang.
Dialogue: 0,0:05:29.71,0:05:33.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Skill ini benar-benar cocok untuk pelayanku.
Dialogue: 0,0:05:33.46,0:05:36.07,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, cepatlah mulai memasak.
Dialogue: 0,0:05:36.07,0:05:37.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:05:37.90,0:05:40.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kali ini masak di luar saja.
Dialogue: 0,0:05:40.15,0:05:43.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau langsung masak di depanmu,\Nkamu juga pasti akan tenang.
Dialogue: 0,0:05:43.86,0:05:46.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gerakanmu cukup gesit juga.
Dialogue: 0,0:05:46.78,0:05:50.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski agak ceroboh, pelayanku harus punya\Nkemampuan seperti ini.
Dialogue: 0,0:05:51.40,0:05:58.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, soal itu, kenapa kamu bisa tahu\Nbahwa aku adalah pelayanmu?
Dialogue: 0,0:05:58.42,0:06:01.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena aku merasakan\NBerkah Dewi pada dirimu.
Dialogue: 0,0:06:01.63,0:06:03.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berkah Dewi?
Dialogue: 0,0:06:09.96,0:06:17.25,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sejak dulu kala, selalu diutus orang yang memiliki\Nberkah dewa saat menyambut ras naga.
Dialogue: 0,0:06:17.25,0:06:21.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apalagi kamu punya dua berkah sekaligus,\Ntentu saja aku bisa langsung melihatnya.
Dialogue: 0,0:06:21.03,0:06:22.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar juga,
Dialogue: 0,0:06:22.58,0:06:24.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}paus pembunuh yang genit itu\Njuga pernah bilang
Dialogue: 0,0:06:24.74,0:06:28.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ini adalah Berkah Dewi Laut.
Dialogue: 0,0:06:28.64,0:06:30.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tanganmu malah berhenti.
Dialogue: 0,0:06:30.02,0:06:31.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ah, baik!
Dialogue: 0,0:06:33.71,0:06:35.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aroma bumbunya wangi.
Dialogue: 0,0:06:35.67,0:06:39.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asalkan bisa menaklukkan\NPutri Naga ini dengan masakan,
Dialogue: 0,0:06:39.34,0:06:41.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku bisa bernegosiasi dengannya
Dialogue: 0,0:06:41.01,0:06:43.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}agar warga kota bisa mengambil air\Ndari sumber mata air.
Dialogue: 0,0:06:44.68,0:06:46.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, untuk mencapai tujuan itu,
Dialogue: 0,0:06:46.51,0:06:49.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku harus pulang dengan selamat dulu.
Dialogue: 0,0:06:49.68,0:06:51.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Miru.
Dialogue: 0,0:06:51.39,0:06:53.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?\NSudah matang?
Dialogue: 0,0:06:53.77,0:06:55.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum, makanannya belum matang.
Dialogue: 0,0:06:55.73,0:06:57.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi baru sadar sekarang,
Dialogue: 0,0:06:57.52,0:07:02.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tidak punya piring\Nyang cocok untuk Nona Miru.
Dialogue: 0,0:07:03.59,0:07:07.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku izinkan\Nkamu melayani di samping.
Dialogue: 0,0:07:07.57,0:07:11.48,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu suapi aku makan saja.
Dialogue: 0,0:07:13.04,0:07:18.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menyuapi naga makan,\Naku tidak tahu caranya.
Dialogue: 0,0:07:24.17,0:07:26.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maaf membuatmu menunggu.
Dialogue: 0,0:07:26.18,0:07:29.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini Burito Kadal Air Hangat Pedas Ringan.
Dialogue: 0,0:07:30.37,0:07:32.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bentuk makanan ini aneh sekali.
Dialogue: 0,0:07:33.18,0:07:34.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu...
Dialogue: 0,0:07:35.60,0:07:39.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}A-Apa ini?
Dialogue: 0,0:07:39.27,0:07:42.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak kusangka kadal biasa bisa seenak ini.
Dialogue: 0,0:07:42.43,0:07:43.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, kan?
Dialogue: 0,0:07:44.43,0:07:45.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku juga sudah mencoba sedikit.
Dialogue: 0,0:07:45.95,0:07:47.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dagingnya lembut dan kenyal saat dimakan.
Dialogue: 0,0:07:47.95,0:07:51.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena lemaknya tidak terlalu banyak,
Dialogue: 0,0:07:51.06,0:07:54.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}rasa gurih alami dagingnya\Njustru makin terasa.
Dialogue: 0,0:07:54.58,0:07:56.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar!
Dialogue: 0,0:07:56.41,0:07:58.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya benar-benar luar biasa.
Dialogue: 0,0:07:58.87,0:08:00.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah.
Dialogue: 0,0:08:00.63,0:08:02.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, hidangan berikutnya
Dialogue: 0,0:08:02.36,0:08:04.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}enak dimakan saat baru selesai dipanggang.
Dialogue: 0,0:08:04.24,0:08:06.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sambil menunggu matang,\Nkamu bisa habiskan buritonya dulu.
Dialogue: 0,0:08:06.76,0:08:08.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh, aku izinkan.
Dialogue: 0,0:08:08.55,0:08:12.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buatkan hidangan yang lebih lezat untukku.
Dialogue: 0,0:08:20.88,0:08:23.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis Kecil, ini aroma apa?
Dialogue: 0,0:08:23.53,0:08:25.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini Belut Badai Kabayaki.
Dialogue: 0,0:08:25.74,0:08:27.90,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Masakan ini dibuat\Ndengan membelah Belut Badai,
Dialogue: 0,0:08:27.90,0:08:31.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu dipanggang perlahan dengan api kecil\Nsambil diolesi saus asin manis.
Dialogue: 0,0:08:34.03,0:08:37.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Harusnya tidak ada\Nyang bisa menahan wangi ini.
Dialogue: 0,0:08:37.33,0:08:40.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aroma kecap asin dan gula\Nyang menguap saat dipanaskan
Dialogue: 0,0:08:40.69,0:08:43.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}pasti membuat siapa pun\Ntak sabar untuk menyantapnya.
Dialogue: 0,0:08:43.28,0:08:47.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belut Badai Kabayaki yang sudah matang\Ndipotong kecil dan ditaruh di nasi bersaus,
Dialogue: 0,0:08:47.13,0:08:48.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}lalu dibentuk menjadi onigiri.
Dialogue: 0,0:08:48.97,0:08:50.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah selesai?
Dialogue: 0,0:08:50.80,0:08:52.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum.
Dialogue: 0,0:08:52.18,0:08:54.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini juga harus... begini.
Dialogue: 0,0:08:54.71,0:08:55.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:08:55.72,0:08:57.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau dipanggang lagi?
Dialogue: 0,0:08:57.31,0:08:58.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa tidak akan gosong?
Dialogue: 0,0:08:58.88,0:09:01.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menurutku tanpa dipanggang pun sudah enak!
Dialogue: 0,0:09:01.44,0:09:04.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar, begini saja sudah enak,
Dialogue: 0,0:09:04.27,0:09:06.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi bagian luarnya harus renyah
Dialogue: 0,0:09:06.57,0:09:08.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan bagian dalamnya harus lembut
Dialogue: 0,0:09:08.28,0:09:10.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}agar rasanya lebih nikmat!
Dialogue: 0,0:09:10.36,0:09:13.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aromanya sangat wangi,\Naku tak sabar menunggu!
Dialogue: 0,0:09:13.56,0:09:15.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan memanggangnya dengan sempurna.
Dialogue: 0,0:09:15.33,0:09:18.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aduh, tanpa sadar aku menyentuhnya.
Dialogue: 0,0:09:18.09,0:09:19.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh?
Dialogue: 0,0:09:19.92,0:09:21.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan Putri Naga ini
Dialogue: 0,0:09:21.75,0:09:24.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}ternyata ramah pada manusia?
Dialogue: 0,0:09:25.07,0:09:28.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, sebelumnya dia mengusir para petualang.
Dialogue: 0,0:09:28.96,0:09:31.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski dia pasti punya alasannya sendiri,
Dialogue: 0,0:09:31.20,0:09:33.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku harap dia membuka akses\Nke sumber mata air itu.
Dialogue: 0,0:09:34.20,0:09:36.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu, Nona Miru...
Dialogue: 0,0:09:36.77,0:09:39.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kenapa kamu bersikeras tinggal di sini?
Dialogue: 0,0:09:39.09,0:09:40.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa maksudnya?
Dialogue: 0,0:09:40.85,0:09:41.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ti-Tidak.
Dialogue: 0,0:09:41.92,0:09:46.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pasti ada tempat lain yang lebih nyaman\Ndan bebas manusia, kan?
Dialogue: 0,0:09:46.44,0:09:49.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dari awal, tempat ini adalah\Ntanah kelahiranku!
Dialogue: 0,0:09:50.59,0:09:52.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi begitu!
Dialogue: 0,0:09:52.15,0:09:56.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pemandian air panas itu adalah tempat\Npertama kali aku mandi setelah lahir.
Dialogue: 0,0:09:56.24,0:09:59.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena itu, aku akan ke sini setiap kali\Ningin memulihkan kondisi tubuhku.
Dialogue: 0,0:09:59.58,0:10:04.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Manusia biasa tidak layak\Nmendekati wilayah suciku.
Dialogue: 0,0:10:04.90,0:10:08.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalianlah yang bersikeras tinggal di sini!
Dialogue: 0,0:10:08.09,0:10:11.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitu, ya, aku minta maaf.
Dialogue: 0,0:10:11.83,0:10:13.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baguslah kalau paham.
Dialogue: 0,0:10:13.68,0:10:15.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong,
Dialogue: 0,0:10:15.43,0:10:19.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku bisa menggunakan air dari mata air itu\Nuntuk membuat hidangan yang sangat lezat.
Dialogue: 0,0:10:19.77,0:10:22.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menggunakan air\Ndari wilayah suciku untuk memasak?
Dialogue: 0,0:10:22.43,0:10:25.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat ini aku sudah memikirkan\Nsekitar dua hidangan.
Dialogue: 0,0:10:26.84,0:10:29.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Salah satunya bisa selesai dengan cepat.
Dialogue: 0,0:10:33.04,0:10:35.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, aku izinkan.
Dialogue: 0,0:10:35.74,0:10:40.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Buat hidangan lezat yang kamu ceritakan\Ndengan air itu, biarkan aku mencicipinya!
Dialogue: 0,0:10:40.41,0:10:41.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, dengan senang hati.
Dialogue: 0,0:10:42.31,0:10:44.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, kamu mau membuat hidangan apa?
Dialogue: 0,0:10:44.62,0:10:46.08,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Telur onsen.
Dialogue: 0,0:10:46.08,0:10:47.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putih telurnya kenyal dan lembut.
Dialogue: 0,0:10:47.74,0:10:50.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kuning telurnya juga kental dan lumer.\NPasti enak!
Dialogue: 0,0:10:51.06,0:10:53.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beraninya kamu menggoyahkan hatiku.
Dialogue: 0,0:10:53.63,0:10:55.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan pergi menyiapkannya dulu.
Dialogue: 0,0:10:56.05,0:11:00.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Putih telurnya kenyal dan lembut,\Nlalu kuning telurnya kental dan lumer?
Dialogue: 0,0:11:04.03,0:11:06.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kembalikan Rin pada kami!
Dialogue: 0,0:11:08.53,0:11:10.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa kalian?
Dialogue: 0,0:11:11.19,0:11:12.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di mana Rin?
Dialogue: 0,0:11:12.68,0:11:14.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kembalikan juru masak kami.
Dialogue: 0,0:11:14.53,0:11:16.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan-jangan, sudah dimakan?
Dialogue: 0,0:11:17.22,0:11:18.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak akan kumaafkan!
Dialogue: 0,0:11:18.28,0:11:21.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berani sekali kalian\Nmenerobos wilayah suciku!
Dialogue: 0,0:11:21.14,0:11:23.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan masih berani bicara\Nsembarangan di sini!
Dialogue: 0,0:11:23.75,0:11:26.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya kalian sudah bosan hidup.
Dialogue: 0,0:11:27.83,0:11:29.21,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tunggu!
Dialogue: 0,0:11:29.21,0:11:30.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rin.
Dialogue: 0,0:11:33.55,0:11:35.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bodoh!
Dialogue: 0,0:11:36.47,0:11:37.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beraninya...
Dialogue: 0,0:11:37.55,0:11:39.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Beraninya meninggalkanku sendirian di sana.
Dialogue: 0,0:11:39.55,0:11:41.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah.\NKamu baik-baik saja?
Dialogue: 0,0:11:41.89,0:11:43.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rin, syukurlah.
Dialogue: 0,0:11:43.29,0:11:46.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Siapa orang-orang kurang ajar ini?
Dialogue: 0,0:11:46.31,0:11:49.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Anu...
Dialogue: 0,0:11:49.01,0:11:50.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita makan dulu saja.
Dialogue: 0,0:11:54.09,0:11:55.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitulah kejadiannya.
Dialogue: 0,0:11:55.40,0:11:59.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untung Nona Miru sangat suka makan,\Njadi aku bisa selamat.
Dialogue: 0,0:11:59.11,0:12:01.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pokoknya, syukurlah kamu baik-baik saja.
Dialogue: 0,0:12:01.89,0:12:03.13,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:12:03.13,0:12:05.84,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku sangat mengkhawatirkanmu\Nselama perjalanan.
Dialogue: 0,0:12:05.84,0:12:08.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku yakin kamu baik-baik saja\Ndan bersyukur kamu selamat.
Dialogue: 0,0:12:08.46,0:12:11.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian bahkan memakan\Nmakananku tanpa izin.
Dialogue: 0,0:12:11.80,0:12:14.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena pelayanku yang imut\Nmenyuruhku menunggu,
Dialogue: 0,0:12:14.55,0:12:15.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku rela menunggunya!
Dialogue: 0,0:12:15.97,0:12:17.22,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pelayan?
Dialogue: 0,0:12:17.22,0:12:20.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya dia mengira aku pelayannya\Ndan membawaku ke sini.
Dialogue: 0,0:12:20.47,0:12:21.97,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan bercanda!
Dialogue: 0,0:12:21.97,0:12:24.72,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rin adalah juru masak kami!
Dialogue: 0,0:12:24.72,0:12:28.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku memanggilnya sesuai\Ndengan perjanjian aliansi.
Dialogue: 0,0:12:28.11,0:12:30.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Selain itu, dia juga memiliki Berkah Dewi.
Dialogue: 0,0:12:30.77,0:12:32.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tentu saja dia adalah pelayanku.
Dialogue: 0,0:12:32.75,0:12:33.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hah?
Dialogue: 0,0:12:33.94,0:12:37.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia bertugas merawatku!
Dialogue: 0,0:12:38.95,0:12:41.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Semuanya, tolong lihat ke sini.
Dialogue: 0,0:12:41.42,0:12:44.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yang sedang kupegang ini adalah\Ntelur ayam segar yang baru direbus!
Dialogue: 0,0:12:44.58,0:12:48.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski telur, ini bukan telur biasa.
Dialogue: 0,0:12:48.33,0:12:52.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini telur onsen yang direbus\Nmemakai sumber air panas Gunung Merlova.
Dialogue: 0,0:12:52.88,0:12:54.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudku yang ini.
Dialogue: 0,0:12:54.59,0:12:56.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di dalamnya ada kuning telur.
Dialogue: 0,0:12:56.70,0:12:59.88,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan kereta bangsawan pun\Nkalah bersinar di hadapan telur onsen ini.
Dialogue: 0,0:12:59.88,0:13:02.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah kuning telur mengental\Ndan putihnya lembut,
Dialogue: 0,0:13:02.64,0:13:05.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}berikan tepuk tangan yang meriah!
Dialogue: 0,0:13:06.93,0:13:10.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku baru pertama kali melihat telur\Ndengan bentuk seperti ini!
Dialogue: 0,0:13:10.77,0:13:14.98,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lalu siram dengan saus yang dibuat\Ndari kaldu putih sebagai bahan dasarnya.
Dialogue: 0,0:13:14.98,0:13:17.18,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cepat, biarkan padaku.
Dialogue: 0,0:13:17.18,0:13:18.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini.
Dialogue: 0,0:13:19.85,0:13:21.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak!
Dialogue: 0,0:13:21.80,0:13:24.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, kalian juga coba.
Dialogue: 0,0:13:25.27,0:13:28.00,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Miru ingin berendam\Ndi sumber mata air
Dialogue: 0,0:13:28.00,0:13:30.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dan makan sesuatu\Nuntuk memulihkan tubuhnya.
Dialogue: 0,0:13:30.29,0:13:33.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sementara kami menginginkan air\Ndari sumber air panas.
Dialogue: 0,0:13:33.42,0:13:34.54,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi...
Dialogue: 0,0:13:34.54,0:13:38.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau ada yang rutin mengantarkan\Nmakanan untuk Nona Miru,
Dialogue: 0,0:13:38.15,0:13:40.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita diizinkan mengambil airnya.
Dialogue: 0,0:13:40.30,0:13:43.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Perselisihan ini bisa diselesaikan dengan baik!
Dialogue: 0,0:13:43.39,0:13:45.14,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku paham alasannya.
Dialogue: 0,0:13:45.14,0:13:47.01,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku tidak terima!
Dialogue: 0,0:13:47.01,0:13:48.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Miru.
Dialogue: 0,0:13:48.43,0:13:49.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau terus begini,
Dialogue: 0,0:13:49.31,0:13:52.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}para petualang akan terus datang\Nuntuk menaklukkanmu.
Dialogue: 0,0:13:52.20,0:13:55.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Orang-orang seperti itu\Ntinggal kutendang saja.
Dialogue: 0,0:13:55.27,0:13:59.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Meski aku terus di sini,\Nkalau bahan makanannya habis,
Dialogue: 0,0:13:59.11,0:14:03.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu tak akan bisa makan burito,\Nonigiri panggang, dan telur onsen lagi.
Dialogue: 0,0:14:04.77,0:14:06.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu malah menyudutkanku.
Dialogue: 0,0:14:06.83,0:14:11.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, makanan yang dikirim kemari\Nbukan buatanmu, kan?
Dialogue: 0,0:14:11.31,0:14:14.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu karena aku juru masak tim ini.
Dialogue: 0,0:14:14.71,0:14:19.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, hidangan yang dibuat restoran\Ndi kaki gunung juga sangat enak.
Dialogue: 0,0:14:21.66,0:14:25.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa boleh buat,\Naku akan mengabulkan permintaanmu.
Dialogue: 0,0:14:25.47,0:14:26.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak!
Dialogue: 0,0:14:26.83,0:14:29.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi, aku punya satu syarat.
Dialogue: 0,0:14:30.00,0:14:31.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa syaratnya?
Dialogue: 0,0:14:31.64,0:14:35.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di rawa depan sana ada\Nsejenis ikan lele yang sangat besar.
Dialogue: 0,0:14:35.40,0:14:38.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gunakan lele itu untuk membuat\Nhidangan yang sesuai seleraku.
Dialogue: 0,0:14:38.59,0:14:40.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu syaratku.
Dialogue: 0,0:14:40.28,0:14:41.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syarat diterima!
Dialogue: 0,0:14:41.53,0:14:43.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rin itu milik kami.
Dialogue: 0,0:14:43.40,0:14:47.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Maksudmu, Ikan Lele Neraka\Ndari Rawa Neraka, ya?
Dialogue: 0,0:14:47.12,0:14:49.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami akan membuatmu makan sepuasnya.
Dialogue: 0,0:14:49.37,0:14:50.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo kita cepat buru!
Dialogue: 0,0:14:50.99,0:14:51.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik.
Dialogue: 0,0:14:52.44,0:14:54.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami akan segera kembali.
Dialogue: 0,0:14:57.32,0:15:00.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jadi, di mana ikan lelenya?
Dialogue: 0,0:15:00.34,0:15:01.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Di sana.
Dialogue: 0,0:15:02.21,0:15:05.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana cara menangkapnya?
Dialogue: 0,0:15:05.68,0:15:07.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rin, kita pancing saja.
Dialogue: 0,0:15:07.93,0:15:09.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dipancing?
Dialogue: 0,0:15:09.90,0:15:12.57,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ikan sebesar itu tenaganya pasti besar.
Dialogue: 0,0:15:12.57,0:15:13.92,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian harus berhati-hati.
Dialogue: 0,0:15:13.92,0:15:15.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya, baik.
Dialogue: 0,0:15:17.13,0:15:19.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kailnya tidak akan putus, kan?
Dialogue: 0,0:15:19.17,0:15:20.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, aman.
Dialogue: 0,0:15:20.73,0:15:23.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau umpannya terasa dimakan,
Dialogue: 0,0:15:23.49,0:15:26.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}jangan langsung menariknya.
Dialogue: 0,0:15:27.22,0:15:28.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah terpancing?
Dialogue: 0,0:15:28.27,0:15:29.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Belum.
Dialogue: 0,0:15:29.41,0:15:31.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Diamkan terus seperti ini...
Dialogue: 0,0:15:31.47,0:15:33.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Saat kailnya tertarik,
Dialogue: 0,0:15:33.29,0:15:35.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}langsung tarik pancingannya!
Dialogue: 0,0:15:36.96,0:15:37.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sekarang!
Dialogue: 0,0:15:40.63,0:15:41.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aria.
Dialogue: 0,0:15:41.80,0:15:42.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Jangan khawatir.
Dialogue: 0,0:15:42.59,0:15:45.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Intinya mengendalikan gravitasi, kan?
Dialogue: 0,0:15:45.32,0:15:48.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau langsung terpancing,\Nitu tak akan seru.
Dialogue: 0,0:15:50.97,0:15:52.39,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tarikannya melemah?
Dialogue: 0,0:15:52.39,0:15:54.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ikannya juga jadi lebih ringan.
Dialogue: 0,0:15:54.71,0:15:56.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sebentar lagi bisa terpancing.
Dialogue: 0,0:15:56.85,0:15:58.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Secepat itu?
Dialogue: 0,0:15:58.60,0:16:00.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kita harus bunuh dengan cara apa?
Dialogue: 0,0:16:00.19,0:16:03.44,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Cukup potong kepalanya saja.
Dialogue: 0,0:16:03.44,0:16:06.28,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau begitu, aku akan bantu di samping.
Dialogue: 0,0:16:12.74,0:16:14.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Paralys Stagea!
Dialogue: 0,0:16:15.91,0:16:19.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kami akan memakanmu sampai habis.\NJangan dendam pada kami, ya.
Dialogue: 0,0:16:23.25,0:16:24.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sudah matang!
Dialogue: 0,0:16:24.96,0:16:29.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menu hari ini tempura Ikan Lele Neraka\Ndengan sup kental yang agak pedas.
Dialogue: 0,0:16:29.47,0:16:31.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Silakan dimakan selagi hangat.
Dialogue: 0,0:16:31.90,0:16:33.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Enak!
Dialogue: 0,0:16:34.71,0:16:36.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sup ikan lelenya enak!
Dialogue: 0,0:16:36.93,0:16:38.89,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanan yang namanya tempura ini
Dialogue: 0,0:16:38.89,0:16:40.77,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}garing dan renyah.\NEnak sekali!
Dialogue: 0,0:16:40.77,0:16:43.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ayo, Nona Miru juga coba.
Dialogue: 0,0:16:43.24,0:16:46.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa pun yang mereka bilang,\Nkalau tak cocok dengan seleraku,
Dialogue: 0,0:16:46.59,0:16:48.61,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku tak akan menyetujui permintaanmu.
Dialogue: 0,0:16:48.61,0:16:49.60,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Iya.
Dialogue: 0,0:16:49.60,0:16:52.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena memang itu kesepakatan kita.
Dialogue: 0,0:16:55.74,0:16:57.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa ini?
Dialogue: 0,0:16:57.45,0:16:59.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya memang rasa Ikan Lele Neraka,
Dialogue: 0,0:16:59.75,0:17:02.96,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi mustahil teksturnya bisa sekaya ini.
Dialogue: 0,0:17:02.96,0:17:06.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena ikan daging putih\Nsangat cocok dengan minyak.
Dialogue: 0,0:17:06.83,0:17:08.80,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya jadi unik, kan?
Dialogue: 0,0:17:08.80,0:17:11.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bukan hanya punya cita rasa unik.
Dialogue: 0,0:17:11.26,0:17:14.26,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena adonan pelapis luarnya agak pedas,
Dialogue: 0,0:17:14.26,0:17:19.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}rasa manis lembut dari daging lelenya\Njustru makin terasa.
Dialogue: 0,0:17:20.06,0:17:22.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Reaksinya seperti yang kubayangkan.
Dialogue: 0,0:17:22.83,0:17:25.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sepertinya dia benar-benar\Nsudah masuk perangkap.
Dialogue: 0,0:17:25.81,0:17:29.03,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini... coba juga supnya.
Dialogue: 0,0:17:32.51,0:17:35.20,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Dia gadis kecil yang mengerikan.
Dialogue: 0,0:17:35.20,0:17:37.95,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tak kusangka kamu bisa\Nmembuat hidangan selezat ini.
Dialogue: 0,0:17:39.23,0:17:41.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa sudah sesuai selera?
Dialogue: 0,0:17:41.79,0:17:44.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makanan ajaib apa ini?
Dialogue: 0,0:17:44.33,0:17:47.30,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau berapa ember pun,\Nbisa kuhabiskan semuanya.
Dialogue: 0,0:17:47.30,0:17:49.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu pujian terbaik untuk juru masak!
Dialogue: 0,0:17:51.12,0:17:52.66,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Miru.
Dialogue: 0,0:17:52.66,0:17:54.24,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa rasanya enak?
Dialogue: 0,0:17:54.79,0:17:56.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu sudah tahu jawabannya, kan?
Dialogue: 0,0:17:57.58,0:17:58.64,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kalah.
Dialogue: 0,0:17:58.64,0:18:01.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak, pertarungan sebenarnya baru dimulai!
Dialogue: 0,0:18:01.53,0:18:02.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa?
Dialogue: 0,0:18:02.92,0:18:04.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu tahu?
Dialogue: 0,0:18:04.15,0:18:06.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kota di kaki gunung memakai air
Dialogue: 0,0:18:06.15,0:18:09.37,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dari sumber air panas\Nuntuk membuat garam yang sangat lezat.
Dialogue: 0,0:18:09.37,0:18:10.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Garam?
Dialogue: 0,0:18:10.68,0:18:13.35,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu jenis garam yang rasanya\Nberkali-kali lebih lezat
Dialogue: 0,0:18:13.35,0:18:15.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}dari garam yang tadi kamu cicipi\Nuntuk mencelupkan tempura.
Dialogue: 0,0:18:15.91,0:18:18.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Pakai garam itu bisa jadi lebih enak lagi?
Dialogue: 0,0:18:18.41,0:18:19.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ya.
Dialogue: 0,0:18:19.31,0:18:21.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tadi supnya juga enak, kan?
Dialogue: 0,0:18:21.87,0:18:22.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:18:22.93,0:18:26.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasa pedas rempah dan gurihnya\NIkan Lele Neraka tidak saling mengalahkan,
Dialogue: 0,0:18:26.71,0:18:28.71,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}malah berpadu dengan sempurna.
Dialogue: 0,0:18:28.71,0:18:30.32,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kota di kaki gunung
Dialogue: 0,0:18:30.32,0:18:33.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}terkenal dengan masakan pedas ringan\Nyang memakai rempah-rempah.
Dialogue: 0,0:18:33.85,0:18:36.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Asalkan mau bekerja sama,\Nkamu bisa sering memakannya.
Dialogue: 0,0:18:36.55,0:18:38.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu ini bicara apa?
Dialogue: 0,0:18:38.52,0:18:41.02,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Karena aku sudah mengaku kalah,
Dialogue: 0,0:18:41.02,0:18:43.81,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu tidak perlu membujukku lagi, kan?
Dialogue: 0,0:18:43.81,0:18:47.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tapi aku tetap berharap kamu bisa\Nmenerima usulan kami
Dialogue: 0,0:18:47.94,0:18:49.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}agar masalah ini bisa selesai!
Dialogue: 0,0:18:50.80,0:18:52.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku kalah telak.
Dialogue: 0,0:18:52.94,0:18:56.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gara-gara kamu membuatku\Nmencicipi hidangan itu,
Dialogue: 0,0:18:56.49,0:19:00.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}aku sudah tidak sabar ingin\Nmencoba berbagai hidangan pedas.
Dialogue: 0,0:19:00.45,0:19:04.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Keinginanmu juga\Nsudah menjadi keinginanku sekarang.
Dialogue: 0,0:19:06.17,0:19:08.94,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Terima kasih banyak, Nona Miru!
Dialogue: 0,0:19:08.94,0:19:12.76,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Negosiasi selesai.\NBawa satu ember sup lagi.
Dialogue: 0,0:19:12.76,0:19:14.45,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, dengan senang hati.
Dialogue: 0,0:19:15.01,0:19:16.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Begitulah ceritanya.
Dialogue: 0,0:19:16.41,0:19:18.43,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Nona Miru menyetujui permintaanku.
Dialogue: 0,0:19:18.43,0:19:19.62,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagus!
Dialogue: 0,0:19:19.62,0:19:20.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Syukurlah.
Dialogue: 0,0:19:20.69,0:19:21.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rin.
Dialogue: 0,0:19:21.63,0:19:26.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu benar-benar ahli menyelesaikan masalah\Ndengan cara-cara yang aneh.
Dialogue: 0,0:19:26.19,0:19:29.29,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Untung saja Nona Miru suka makan!
Dialogue: 0,0:19:29.29,0:19:32.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Menghadapi yang suka makan itu\Nsudah keahlianku.
Dialogue: 0,0:19:32.15,0:19:34.63,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Apa kamu sedang membicarakan kami?
Dialogue: 0,0:19:34.63,0:19:36.93,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Oh, kalian tidak sadar?
Dialogue: 0,0:19:36.93,0:19:38.53,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Gadis Kecil.
Dialogue: 0,0:19:38.53,0:19:40.91,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, aku akan bawakan supnya sekarang.
Dialogue: 0,0:19:40.91,0:19:42.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Sup juga penting,
Dialogue: 0,0:19:42.74,0:19:46.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}tapi mulai sekarang aku akan makan\Nhidangan buatan orang lain.
Dialogue: 0,0:19:46.69,0:19:50.75,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bisa buatkan satu hidangan lagi untukku?
Dialogue: 0,0:19:50.75,0:19:52.67,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Mau dibuatkan satu hidangan lagi?
Dialogue: 0,0:19:52.67,0:19:53.34,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Boleh juga.
Dialogue: 0,0:19:53.34,0:19:54.74,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Satu lagi?
Dialogue: 0,0:19:54.74,0:19:57.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian benar-benar suka makan, ya.
Dialogue: 0,0:19:57.59,0:19:59.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Coba kupikirkan.
Dialogue: 0,0:19:59.16,0:20:02.31,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ikan yang dibeli di Elrage\Njuga masih ada sisa.
Dialogue: 0,0:20:02.31,0:20:05.68,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bagaimana kalau kita buat\Nhidangan ala susyi kepal?
Dialogue: 0,0:20:05.68,0:20:07.41,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Susyi kepal?
Dialogue: 0,0:20:07.41,0:20:09.69,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku belum pernah dengar\Nhidangan seperti itu.
Dialogue: 0,0:20:09.69,0:20:11.40,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hidangan seperti apa itu?
Dialogue: 0,0:20:11.82,0:20:16.19,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hidangan ini terdiri dari ikan mentah\Nberbumbu di atas nasi putih yang agak manis.
Dialogue: 0,0:20:16.19,0:20:17.86,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah dikeringkan secukupnya,
Dialogue: 0,0:20:17.86,0:20:22.83,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}daging ikan yang kenyal dan penuh saus\Nakan menyatu dengan manisnya nasi.
Dialogue: 0,0:20:22.83,0:20:24.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Rasanya sangat enak!
Dialogue: 0,0:20:24.33,0:20:26.56,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kedengarannya enak, ya.
Dialogue: 0,0:20:45.51,0:20:47.17,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Luar biasa.
Dialogue: 0,0:20:47.17,0:20:50.87,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini... sihir ilusi milik Mirage Dragon.
Dialogue: 0,0:20:50.87,0:20:52.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Tidak kusangka sehebat ini.
Dialogue: 0,0:20:54.49,0:20:57.11,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Baik, aku sudah kembali semangat!
Dialogue: 0,0:20:57.11,0:20:59.78,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kali ini biar semuanya makan sepuasnya.
Dialogue: 0,0:20:59.78,0:21:02.99,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku akan buat berbagai hidangan\Ndari bahan yang tersisa.
Dialogue: 0,0:21:02.99,0:21:05.23,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalian makanlah sepuasnya.
Dialogue: 0,0:21:06.41,0:21:07.58,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kamu serius?
Dialogue: 0,0:21:07.58,0:21:10.04,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Makan di tengah pemandangan seindah ini,
Dialogue: 0,0:21:10.04,0:21:12.46,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}bahkan bangsawan pun\Nbelum pernah merasakannya.
Dialogue: 0,0:21:12.46,0:21:13.59,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau makan.
Dialogue: 0,0:21:15.01,0:21:17.49,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Lelah!
Dialogue: 0,0:21:17.49,0:21:19.51,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Hanya untuk mengurus administrasi saja,
Dialogue: 0,0:21:19.51,0:21:23.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kita harus tinggal di sini\Nselama seminggu.
Dialogue: 0,0:21:23.16,0:21:24.55,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Yah, tidak apa-apa.
Dialogue: 0,0:21:24.55,0:21:28.27,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Bahkan kita juga sempat makan Ayam Kukus\NEkor Pelangi dengan Garam Mata Air.
Dialogue: 0,0:21:28.27,0:21:30.52,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Itu sangat enak, ya.
Dialogue: 0,0:21:30.52,0:21:32.06,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Omong-omong,
Dialogue: 0,0:21:32.06,0:21:34.73,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}sepertinya naga itu sangat menyukaimu.
Dialogue: 0,0:21:34.73,0:21:36.36,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Benar.
Dialogue: 0,0:21:37.69,0:21:40.15,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Ini kuberikan padamu.
Dialogue: 0,0:21:40.15,0:21:42.85,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Kalau nanti kamu datang lagi\Nke sekitar sini,
Dialogue: 0,0:21:42.85,0:21:46.12,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}kamu harus mampir menemuiku, ya.
Dialogue: 0,0:21:47.14,0:21:50.33,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Setelah kembali dari ibu kota,\Nkita bisa mampir lagi ke sini?
Dialogue: 0,0:21:50.33,0:21:51.79,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku setuju.
Dialogue: 0,0:21:51.79,0:21:55.50,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Berendam di air panas sambil menikmati\Ncahaya bulan juga pengalaman bagus.
Dialogue: 0,0:21:55.50,0:21:58.16,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}Aku mau datang lagi\Nuntuk makan Ekor Pelangi.
Dialogue: 0,0:21:58.16,0:22:00.09,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Asalkan bisa melihat senyum Aria,\N- Setelah selesai berendam
Dialogue: 0,0:22:00.09,0:22:01.42,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- aku juga setuju.\N- ayo cari minuman
Dialogue: 0,0:22:01.42,0:22:04.47,Default,,0000,0000,0000,,{\blur3}{\fad(00,40)}- Malam ini kita harus istirahat.\N- seperti susu buah.
